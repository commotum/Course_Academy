94-0c72-519b-a4ec-7d06c770e678" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-06eedefb-fb96-5dde-9684-40c6c4325db0" :answer/id #uuid "06eedefb-fb96-5dde-9684-40c6c4325db0" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-8e935e56-662c-5787-8720-746446dd4696" :answer/id #uuid "8e935e56-662c-5787-8720-746446dd4696" :answer/type :answer.type/math :answer/value "\\frac{1}{9}" :db/ensure [:answer/validate]} {:db/id "answer-f19d42fe-9a65-5f21-85be-c431c988f8d2" :answer/id #uuid "f19d42fe-9a65-5f21-85be-c431c988f8d2" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}}{3}" :db/ensure [:answer/validate]} {:db/id "answer-87eb2fe2-6fca-5ada-88d8-dfb168d5ed24" :answer/id #uuid "87eb2fe2-6fca-5ada-88d8-dfb168d5ed24" :answer/type :answer.type/math :answer/value "\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "question-3ab14871-8f29-5705-a194-c2697a586708" :question/id #uuid "3ab14871-8f29-5705-a194-c2697a586708" :question/math-academy-id "q-132624" :question/problem "The time $X,$ in seconds, between two students arriving at a canteen can be modeled as an exponential random variable $X∼\\text{Exp}(0.05).$ If a student has just arrived at the canteen, what is the average time until the next student arrives there?" :question/worked-solution "Recall that if $X∼\\text{Exp}(\\lambda )$ is an exponential random variable, then\n\n$$\n\\text{E}[X]=\\frac{1}{\\lambda }.\n$$\n\nWe're given that $X∼\\text{Exp}(0.05).$ Therefore, $\\lambda =0.05,$ and\n\n$$\n\\text{E}[X]=\\frac{1}{0.05}\\,\\text{sec}=20\\,\\text{sec}.\n$$\n\nTherefore, the average time until the next student arrives is $20$ seconds." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-88193472-deab-50d5-9747-54d755c2e666"] :db/ensure [:question/validate]} {:db/id "answer-field-88193472-deab-50d5-9747-54d755c2e666" :answer-field/id #uuid "88193472-deab-50d5-9747-54d755c2e666" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-88be2ac4-5f9b-51dd-a35c-cbbade9f3869" :answer-field/choices ["answer-5b9d27fd-aabb-592a-970d-6cb3e65e217d" "answer-b0a9ea69-78b7-59f7-8bab-a664fd5bb220" "answer-88be2ac4-5f9b-51dd-a35c-cbbade9f3869" "answer-87116a0e-b0fd-589f-b0b6-86b60598d758" "answer-44ec7415-7a27-5243-9607-5b175f42433e"] :db/ensure [:answer-field/validate]} {:db/id "answer-5b9d27fd-aabb-592a-970d-6cb3e65e217d" :answer/id #uuid "5b9d27fd-aabb-592a-970d-6cb3e65e217d" :answer/type :answer.type/text :answer/value "$10$ seconds" :db/ensure [:answer/validate]} {:db/id "answer-b0a9ea69-78b7-59f7-8bab-a664fd5bb220" :answer/id #uuid "b0a9ea69-78b7-59f7-8bab-a664fd5bb220" :answer/type :answer.type/text :answer/value "$2$ minutes" :db/ensure [:answer/validate]} {:db/id "answer-88be2ac4-5f9b-51dd-a35c-cbbade9f3869" :answer/id #uuid "88be2ac4-5f9b-51dd-a35c-cbbade9f3869" :answer/type :answer.type/text :answer/value "$20$ seconds" :db/ensure [:answer/validate]} {:db/id "answer-87116a0e-b0fd-589f-b0b6-86b60598d758" :answer/id #uuid "87116a0e-b0fd-589f-b0b6-86b60598d758" :answer/type :answer.type/text :answer/value "$5$ minutes" :db/ensure [:answer/validate]} {:db/id "answer-44ec7415-7a27-5243-9607-5b175f42433e" :answer/id #uuid "44ec7415-7a27-5243-9607-5b175f42433e" :answer/type :answer.type/text :answer/value "$50$ seconds" :db/ensure [:answer/validate]} {:db/id 17592186167076 :question/problem "The time $X,$ in minutes, between two customers arriving at a bank can be modeled as an exponential random variable $X∼\\text{Exp}(5).$ If a customer has just arrived at the bank, what is the average time until the next customer arrives at the bank?" :question/worked-solution "Recall that if $X∼\\text{Exp}(\\lambda )$ is an exponential random variable, then\n\n$$\n\\text{E}[X]=\\frac{1}{\\lambda }.\n$$\n\nWe're given that $X∼\\text{Exp}(5).$ Therefore, $\\lambda =5,$ which means that $5$ customers arrive each minute. Hence,\n\n$$\n\\text{E}[X]=\\frac{1}{5}\\,\\text{min}=12\\,\\text{s}.\n$$\n\nTherefore, the average time until the next customer is $12$ seconds." :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186163534 :answer-field/correct 17592186163539 :db/ensure [:answer-field/validate]} {:db/id "question-906813e4-c59b-59ab-b35c-7a3a5c47ebad" :question/id #uuid "906813e4-c59b-59ab-b35c-7a3a5c47ebad" :question/math-academy-id "q-132438" :question/problem "Given that $X∼\\text{Exp}(\\frac{11}{23}),$ what is $\\text{SD}[X]?$" :question/worked-solution "If $X∼\\text{Exp}(\\lambda )$ is an exponential random variable, then\n\n$$\n\\text{SD}[X]=\\sqrt{\\text{Var}[X]}=\\frac{1}{\\lambda }.\n$$\n\nTherefore, for our random variable $X∼\\text{Exp}(\\frac{11}{23}),$ we have the following standard deviation:\n\n$$\n\\begin{aligned}\\text{SD}[X] & =\\frac{1}{(\\frac{11}{23})} \\\\  & =\\frac{23}{11}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-4a706a80-5de1-59dc-a5cd-a1ab263128d3"] :db/ensure [:question/validate]} {:db/id "answer-field-4a706a80-5de1-59dc-a5cd-a1ab263128d3" :answer-field/id #uuid "4a706a80-5de1-59dc-a5cd-a1ab263128d3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-486c46ba-79d7-5c83-a0d0-d5c2f86df67f" :answer-field/choices ["answer-066b0a68-c03d-5252-a03f-d5dd1754583e" "answer-e2271e40-5412-5ffe-a6c0-117c3cb78016" "answer-175f00cd-4983-5040-b101-e05b60df4667" "answer-486c46ba-79d7-5c83-a0d0-d5c2f86df67f" "answer-db423d37-dc10-52d6-8943-139d912272ca"] :db/ensure [:answer-field/validate]} {:db/id "answer-066b0a68-c03d-5252-a03f-d5dd1754583e" :answer/id #uuid "066b0a68-c03d-5252-a03f-d5dd1754583e" :answer/type :answer.type/math :answer/value "\\frac{11}{23}" :db/ensure [:answer/validate]} {:db/id "answer-e2271e40-5412-5ffe-a6c0-117c3cb78016" :answer/id #uuid "e2271e40-5412-5ffe-a6c0-117c3cb78016" :answer/type :answer.type/math :answer/value "\\frac{1}{11}" :db/ensure [:answer/validate]} {:db/id "answer-175f00cd-4983-5040-b101-e05b60df4667" :answer/id #uuid "175f00cd-4983-5040-b101-e05b60df4667" :answer/type :answer.type/math :answer/value "\\frac{1}{23}" :db/ensure [:answer/validate]} {:db/id "answer-486c46ba-79d7-5c83-a0d0-d5c2f86df67f" :answer/id #uuid "486c46ba-79d7-5c83-a0d0-d5c2f86df67f" :answer/type :answer.type/math :answer/value "\\frac{23}{11}" :db/ensure [:answer/validate]} {:db/id "answer-db423d37-dc10-52d6-8943-139d912272ca" :answer/id #uuid "db423d37-dc10-52d6-8943-139d912272ca" :answer/type :answer.type/math :answer/value "\\frac{2}{11}" :db/ensure [:answer/validate]} {:db/id "question-5e5fad29-e988-5832-87d5-889a9c3d0b32" :question/id #uuid "5e5fad29-e988-5832-87d5-889a9c3d0b32" :question/math-academy-id "q-132440" :question/problem "Given that $X∼\\text{Exp}(\\frac{5}{12}),$ what is $\\text{SD}[X]?$" :question/worked-solution "If $X∼\\text{Exp}(\\lambda )$ is an exponential random variable, then\n\n$$\n\\text{SD}[X]=\\sqrt{\\text{Var}[X]}=\\frac{1}{\\lambda }.\n$$\n\nTherefore, for our random variable $X∼\\text{Exp}(\\frac{5}{12}),$ we have the following standard deviation:\n\n$$\n\\begin{aligned}\\text{SD}[X] & =\\frac{1}{(\\frac{5}{12})} \\\\  & =\\frac{12}{5}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d783f8fb-1189-5732-8ecf-f5e33d4cb9ba"] :db/ensure [:question/validate]} {:db/id "answer-field-d783f8fb-1189-5732-8ecf-f5e33d4cb9ba" :answer-field/id #uuid "d783f8fb-1189-5732-8ecf-f5e33d4cb9ba" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-cc2fd87e-1387-5790-9a23-44aec6dbd0bd" :answer-field/choices ["answer-cc2fd87e-1387-5790-9a23-44aec6dbd0bd" "answer-1733ba90-7a75-500a-9f67-81328a7b2bd3" "answer-c2c272ba-fbf8-56c8-83ab-774608b39901" "answer-fda31041-af37-56fa-96cc-bf022686bc76" "answer-aa4c96d9-6142-5eea-bb7d-cc2a65027b7a"] :db/ensure [:answer-field/validate]} {:db/id "answer-cc2fd87e-1387-5790-9a23-44aec6dbd0bd" :answer/id #uuid "cc2fd87e-1387-5790-9a23-44aec6dbd0bd" :answer/type :answer.type/math :answer/value "\\frac{12}{5}" :db/ensure [:answer/validate]} {:db/id "answer-1733ba90-7a75-500a-9f67-81328a7b2bd3" :answer/id #uuid "1733ba90-7a75-500a-9f67-81328a7b2bd3" :answer/type :answer.type/math :answer/value "\\frac{25}{144}" :db/ensure [:answer/validate]} {:db/id "answer-c2c272ba-fbf8-56c8-83ab-774608b39901" :answer/id #uuid "c2c272ba-fbf8-56c8-83ab-774608b39901" :answer/type :answer.type/math :answer/value "\\frac{5}{12}" :db/ensure [:answer/validate]} {:db/id "answer-fda31041-af37-56fa-96cc-bf022686bc76" :answer/id #uuid "fda31041-af37-56fa-96cc-bf022686bc76" :answer/type :answer.type/math :answer/value "\\frac{5}{6}" :db/ensure [:answer/validate]} {:db/id "answer-aa4c96d9-6142-5eea-bb7d-cc2a65027b7a" :answer/id #uuid "aa4c96d9-6142-5eea-bb7d-cc2a65027b7a" :answer/type :answer.type/math :answer/value "\\frac{6}{5}" :db/ensure [:answer/validate]} {:db/id 17592186168121 :tutorial/content "Suppose that $X$ is an exponential random variable with rate parameter $\\lambda > 0.$ \n\n$$\nX\\sim \\textrm{Exp}(\\lambda)\n$$\n\n \n\nThe mean (expected value) of $X$ is given by\n\n$$\n\\textrm E[X] = \\dfrac{1}{\\lambda}.\n$$\n\nTo prove this, first recall that the PDF of $X$ is given by\n\n![](images/8c/8cdd482110e21d62a33d7d1e988d6420ab72e4b0a051ce1afea756214d217f63.svg) \n\nBy definition, \n\n$$\n\\textrm E[X] = \\int_{-\\infty}^\\infty x f(x)\\,\\textrm d x,\n$$\n\nand since $f(x) = 0$ for $x < 0,$ we have\n\n$$\n\\textrm E[X] = \\int_{0}^\\infty  \\lambda xe^{-\\lambda x}\\,\\textrm d x.\n$$\n\nWe can evaluate this integral using integration by parts. First, we set\n\n$$\nu = x, \\qquad v' = \\lambda e^{-\\lambda x},\n$$\n\nwhich gives\n\n$$\nu' = 1  \\qquad v = -e^{-\\lambda x}.\n$$\n\nFinally, applying the by-parts formula, we get\n\n$$\n\\begin{aligned}\\text{E}[X] & ={\\int }_{0}^{\\infty }\\lambda x{e}^{-\\lambda x}\\,\\text{d}x \\\\  & ={[-x{e}^{-\\lambda x}]}_{0}^{\\infty }+{\\int }_{0}^{\\infty }{e}^{-\\lambda x}\\,\\text{d}x \\\\  & ={[-x{e}^{-\\lambda x}]}_{0}^{\\infty }-{[\\frac{{e}^{-\\lambda x}}{\\lambda }]}_{0}^{\\infty } \\\\  & =\\frac{1}{\\lambda }.\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186168122 :tutorial/content "If the random variable $X\\sim \\textrm{Exp}(\\lambda),$ then the variance of $X$ is given by\n\n$$\n\\textrm {Var}[X] = \\dfrac{1}{\\lambda^2}.\n$$\n\nTo prove this, we first recall that\n\n$$\n\\textrm{Var}[X] = \\textrm E[X^2] - \\left(\\textrm E[X]\\right)^2.\n$$\n\nAs we saw previously,\n\n$$\n\\textrm E[X] = \\int_0^\\infty \\lambda xe^{-\\lambda x}\\textrm d x = \\dfrac1\\lambda,\n$$\n\nand therefore,\n\n$$\n\\left(\\textrm E[X]\\right)^2  = \\dfrac{1}{\\lambda^2}.\n$$\n\nNow, we calculate $\\textrm E[X^2].$ First, note that\n\n$$\n\\textrm E[X^2] = \\int_0^\\infty \\lambda x^2e^{-\\lambda x}\\textrm d x.\n$$\n\nWe can evaluate this integral using integration by-parts. First, we set\n\n$$\nu = x^2, \\qquad v' =\\lambda e^{-\\lambda x},\n$$\n\nand therefore\n\n$$\nu' = 2x, \\qquad v = -e^{-\\lambda x}.\n$$\n\nApplying the by-parts formula, we get\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{0}^{\\infty }\\lambda {x}^{2}{e}^{-\\lambda x}\\,\\text{d}x \\\\  & ={[-{x}^{2}{e}^{-\\lambda x}]}_{0}^{\\infty }+2{\\int }_{0}^{\\infty }x{e}^{-\\lambda x} \\\\  & =0+2{\\int }_{0}^{\\infty }x{e}^{-\\lambda x} \\\\  & =2{\\int }_{0}^{\\infty }x{e}^{-\\lambda x}.\\end{aligned}\n$$\n\nNotice that we can express this integral in terms of $\\textrm E[X]$ (and therefore $\\lambda$) as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & =2{\\int }_{0}^{\\infty }x{e}^{-\\lambda x} \\\\  & =\\frac{2}{\\lambda }{\\int }_{0}^{\\infty }\\lambda x{e}^{-\\lambda x} \\\\  & =\\frac{2}{\\lambda }\\cdot \\text{E}[X] \\\\  & =\\frac{2}{\\lambda }\\cdot \\frac{1}{\\lambda } \\\\  & =\\frac{2}{{\\lambda }^{2}}\\end{aligned}\n$$\n\nFinally, we have\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{2}{{\\lambda }^{2}}-\\frac{1}{{\\lambda }^{2}} \\\\  & =\\frac{1}{{\\lambda }^{2}}\\end{aligned}\n$$\n\nas required." :db/ensure [:tutorial/validate]} {:db/id 17592186167038 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]}]
