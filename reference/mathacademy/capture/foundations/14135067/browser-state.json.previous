      "source_url": "https://mathacademy.com/tasks/14135067/topics/6720/lesson",
      "captured_at": 1791807204.0286753,
      "math_academy_id": "q-343685",
      "topic_id": "6720",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q343685",
        "placement_id": null,
        "content_id": null,
