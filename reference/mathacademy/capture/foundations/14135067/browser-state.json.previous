      "source_url": "https://mathacademy.com/tasks/14135067/topics/6720/lesson",
      "captured_at": 1791806976.9637172,
      "math_academy_id": "q-94234",
      "topic_id": "6720",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q94234",
        "placement_id": null,
        "content_id": null,
        "type": null
