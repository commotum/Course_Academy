#{[{:db/id #edb/ref 17592186243948 :knowledge-point/_questions [{:db/id #edb/ref 17592186119792 :knowledge-point/id #uuid "9279d979-74ba-5504-b98a-63692db3af72" :knowledge-point/title "Finding the LU Factorization of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e37e6cc-fad6-5510-9620-2cbac7ce22f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-25" :db/id #edb/ref 17592186241439} {:answer/id #uuid "8ba5c239-540d-5f86-ac6d-97caed8a3faf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-30" :db/id #edb/ref 17592186242416} {:answer/id #uuid "8bab7e05-3097-50f9-97ae-0da4430bb726" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186242417} {:answer/id #uuid "8eefa27a-e9ae-567c-9c88-944a22b88b15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-35" :db/id #edb/ref 17592186242437} {:answer/id #uuid "a2d916f4-e1c3-59c3-b962-73fcbf193360" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186242604}] :answer-field/correct {:answer/id #uuid "8ba5c239-540d-5f86-ac6d-97caed8a3faf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-30" :db/id #edb/ref 17592186242416} :answer-field/id #uuid "e7fbcc62-56cc-5358-9e7d-035227d1830e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243840}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3e43d37a-2ce4-531c-9855-25d3d30a5758" :question/math-academy-id "q-106762" :question/problem "Given that\n$A=[\\begin{aligned}-3 & 2 \\\\ 15 & -4\\end{aligned}]$ \nhas the LU decomposition $A=LU$, then ${l}_{21}\\cdot {u}_{22}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}-3 & 2 \\\\ 15 & -4\\end{aligned}] & {R}_{2} & :={R}_{2}+5{R}_{1}\\,⟺\\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 \\\\ 5 & 1\\end{aligned}]}}\\cdot A \\\\  & ∼[\\begin{aligned}-3 & 2 \\\\ 0 & 6\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 \\\\ 5 & 1\\end{aligned}]}^{-1}U \\\\ A & ={{[\\begin{aligned}1 & 0 \\\\ -5 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}-3 & 2 \\\\ 0 & 6\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{21}=-5,{u}_{22}=6,$ and ${l}_{21}\\cdot {u}_{12}=-30.$"}] [{:db/id #edb/ref 17592186243949 :knowledge-point/_questions [{:db/id #edb/ref 17592186119792 :knowledge-point/id #uuid "9279d979-74ba-5504-b98a-63692db3af72" :knowledge-point/title "Finding the LU Factorization of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03ddb432-c159-51bd-87f7-46377395435b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ -4 & 1\\end{aligned}]" :db/id #edb/ref 17592186241213} {:answer/id #uuid "797c91c1-9cd0-58dd-9630-d65ae8a82a3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ -3 & 1\\end{aligned}]" :db/id #edb/ref 17592186242251} {:answer/id #uuid "95236878-0d84-5730-9210-7d52e16f2f34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 3 & 1\\end{aligned}]" :db/id #edb/ref 17592186242488} {:answer/id #uuid "abfe08e7-1a8e-53cd-a0cc-09d44eab6540" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ -5 & 1\\end{aligned}]" :db/id #edb/ref 17592186242683} {:answer/id #uuid "e313faa3-97f4-5d01-bd42-efbcd8a6d8df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 4 & 1\\end{aligned}]" :db/id #edb/ref 17592186243200}] :answer-field/correct {:answer/id #uuid "797c91c1-9cd0-58dd-9630-d65ae8a82a3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ -3 & 1\\end{aligned}]" :db/id #edb/ref 17592186242251} :answer-field/id #uuid "491415e0-0ac3-5791-b266-069f3eb88034" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243576}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bd4d8bf8-4a33-530d-bc80-05a910fd04f1" :question/math-academy-id "q-106763" :question/problem "Given that \n$A=[\\begin{aligned}4 & -7 \\\\ -12 & 18\\end{aligned}]$ \nhas the LU decomposition $A=LU,$ then $L=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}4 & -7 \\\\ -12 & 18\\end{aligned}] & \\,{R}_{2} & :={R}_{2}+3{R}_{1}\\,⟺\\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 \\\\ 3 & 1\\end{aligned}]}}\\cdot A \\\\  & ∼[\\begin{aligned}4 & -7 \\\\ 0 & -3\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 \\\\ 3 & 1\\end{aligned}]}^{-1}U \\\\ A & ={{[\\begin{aligned}1 & 0 \\\\ -3 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}4 & -7 \\\\ 0 & -3\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186399037 :knowledge-point/_questions [{:db/id #edb/ref 17592186119793 :knowledge-point/id #uuid "6093e24d-14bb-5e3b-a0b4-7a562a12f6a2" :knowledge-point/title "Finding the LU Factorization of a Singular 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ba58499f-83c5-5590-b067-5c72d5b139a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186399039} {:answer/id #uuid "61a41175-cafd-5d7f-88b5-4b344125cf85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186399040} {:answer/id #uuid "991289dd-6e89-58ad-98ec-431b03eb6134" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186399041} {:answer/id #uuid "46a45cff-fcc3-53f3-b793-ae6574c91421" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186399042} {:answer/id #uuid "ff494868-b717-56d0-b9b8-ba8b8cadd615" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186399043}] :answer-field/correct {:answer/id #uuid "ba58499f-83c5-5590-b067-5c72d5b139a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186399039} :answer-field/id #uuid "63a6c2d7-95e4-53da-98cc-2de47ce76700" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399038}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "30a5731c-2a02-53f9-9c62-2c24fdfa7142" :question/math-academy-id "q-75177" :question/problem "Given that\n$A=[\\begin{aligned}-2 & 3 \\\\ 1 & \\,\\,\\,-\\frac{3}{2}\\end{aligned}]$\nhas the LU decomposition $A=LU$, then ${l}_{21}+{u}_{22}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}-2 & 3 \\\\ 1 & \\,\\,\\,-\\frac{3}{2}\\end{aligned}] & {R}_{2} & :={R}_{2}+\\frac{1}{2}{R}_{1}\\,⟺\\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 \\\\ \\frac{1}{2} & 1\\end{aligned}]}}\\cdot A \\\\  & ∼[\\begin{aligned}-2 & 3 \\\\ 0 & 0\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 \\\\ \\frac{1}{2} & 1\\end{aligned}]}^{-1}U \\\\ A & ={{[\\begin{aligned}1 & 0 \\\\ -\\frac{1}{2} & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}-2 & 3 \\\\ 0 & 0\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{21}=-\\frac{1}{2},$ ${u}_{22}=0,$ and ${l}_{21}+{u}_{22}=-\\frac{1}{2}.$"}]}
