gned}1 & 0 \\\\ -3 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}4 & -7 \\\\ 0 & -3\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$"} :step/id #uuid "5eb03b7b-af1e-525c-805a-a7fc08f84329" :step/next {:db/id #edb/ref 17592186478495}} {:db/id #edb/ref 17592186478487 :step/content {:db/id #edb/ref 17592186399037 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ba58499f-83c5-5590-b067-5c72d5b139a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186399039} {:answer/id #uuid "61a41175-cafd-5d7f-88b5-4b344125cf85" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186399040} {:answer/id #uuid "991289dd-6e89-58ad-98ec-431b03eb6134" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186399041} {:answer/id #uuid "46a45cff-fcc3-53f3-b793-ae6574c91421" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186399042} {:answer/id #uuid "ff494868-b717-56d0-b9b8-ba8b8cadd615" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186399043}] :answer-field/correct {:db/id #edb/ref 17592186399039} :answer-field/id #uuid "63a6c2d7-95e4-53da-98cc-2de47ce76700" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186399038}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "30a5731c-2a02-53f9-9c62-2c24fdfa7142" :question/math-academy-id "q-75177" :question/problem "Given that\n$A=[\\begin{aligned}-2 & 3 \\\\ 1 & \\,\\,\\,-\\frac{3}{2}\\end{aligned}]$\nhas the LU decomposition $A=LU$, then ${l}_{21}+{u}_{22}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}-2 & 3 \\\\ 1 & \\,\\,\\,-\\frac{3}{2}\\end{aligned}] & {R}_{2} & :={R}_{2}+\\frac{1}{2}{R}_{1}\\,⟺\\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 \\\\ \\frac{1}{2} & 1\\end{aligned}]}}\\cdot A \\\\  & ∼[\\begin{aligned}-2 & 3 \\\\ 0 & 0\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 \\\\ \\frac{1}{2} & 1\\end{aligned}]}^{-1}U \\\\ A & ={{[\\begin{aligned}1 & 0 \\\\ -\\frac{1}{2} & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}-2 & 3 \\\\ 0 & 0\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{21}=-\\frac{1}{2},$ ${u}_{22}=0,$ and ${l}_{21}+{u}_{22}=-\\frac{1}{2}.$"} :step/id #uuid "b49cc272-671e-59d4-b2ca-4c2b37016619" :step/next {:db/id #edb/ref 17592186478472}} {:db/id #edb/ref 17592186478495 :step/content {:db/id #edb/ref 17592186478418 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55a4dac3-2c33-5d58-aaa2-125e694888fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186477913} {:answer/id #uuid "6500c57c-c609-50e3-acfa-96edb3d0cc4d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186477941} {:answer/id #uuid "de08e829-7d86-5d17-a65c-17f17f9ad7cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186478170} {:answer/id #uuid "f44e7b1e-79e3-5325-be32-3303f3918e95" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186478218} {:answer/id #uuid "fe1b79e5-9189-58f5-bacb-bfc122c496e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186478242}] :answer-field/correct {:db/id #edb/ref 17592186478242} :answer-field/id #uuid "d178ac13-c211-5fc3-94f5-4e3a59d84b42" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186478341}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7301bd89-49bc-52af-80e0-064f8b80e2ca" :question/math-academy-id "q-106770" :question/problem "Given that\n$A=[\\begin{aligned}-3 & 5 \\\\ 9 & -15\\end{aligned}]$\nhas the LU decomposition $A=LU$, then ${l}_{21}+{u}_{22}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}-3 & 5 \\\\ 9 & -15\\end{aligned}] & {R}_{2} & :={R}_{2}+3{R}_{1}\\,⟺\\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 \\\\ 3 & 1\\end{aligned}]}}\\cdot A \\\\  & ∼[\\begin{aligned}-3 & 5 \\\\ 0 & 0\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 \\\\ 3 & 1\\end{aligned}]}^{-1}U \\\\ A & ={{[\\begin{aligned}1 & 0 \\\\ -3 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}-3 & 5 \\\\ 0 & 0\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{21}=-3,$ ${u}_{22}=0,$ and ${l}_{21}+{u}_{22}=-3.$"} :step/id #uuid "ee4afbcd-af83-5653-a77b-3dd934feb1aa"}] :activity/title "LU Factorization of 2x2 Matrices" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186477727}]}
