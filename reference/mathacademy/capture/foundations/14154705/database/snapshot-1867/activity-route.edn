#{[{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186478487} :activity/id #uuid "02e797f8-1f67-50ff-98e9-d7a3cb69a62e" :activity/scope {:db/id #edb/ref 17592186048743 :topic/id #uuid "ba8c9515-59e3-55c9-9d86-1de6e55c5474" :topic/math-academy-id 1779} :activity/steps [{:db/id #edb/ref 17592186478472 :step/content {:db/id #edb/ref 17592186478379 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00e42c85-3d13-5dc9-8c6a-51fceeb48bb9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186477735} {:answer/id #uuid "222b38e9-e578-5db3-93ad-1ff77650be2e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186477801} {:answer/id #uuid "7e25a537-589e-562b-bddb-6c4194092e4a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186477995} {:answer/id #uuid "93fc37f5-fd4a-5125-b65a-32406a3c5c68" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186478026} {:answer/id #uuid "ad849afa-6638-5c60-a521-993d97e99b25" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186478071}] :answer-field/correct {:db/id #edb/ref 17592186478026} :answer-field/id #uuid "dca5f516-eb3b-5960-a63b-792e2d33df63" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186478345}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "17c26653-7b83-5324-906b-245647d63511" :question/math-academy-id "q-75178" :question/problem "Given that \n$A=[\\begin{aligned}2 & 6 \\\\ 4 & 12\\end{aligned}],$\nhas the LU decomposition $A=LU$, then ${l}_{21}+{u}_{22}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}2 & 6 \\\\ 4 & 12\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1}\\,⟺\\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 \\\\ -2 & 1\\end{aligned}]}}\\cdot A \\\\  & ∼[\\begin{aligned}2 & 6 \\\\ 0 & 0\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 \\\\ -2 & 1\\end{aligned}]}^{-1}U \\\\ A & ={{[\\begin{aligned}1 & 0 \\\\ 2 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}2 & 6 \\\\ 0 & 0\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{21}=2,{u}_{22}=0,$ and ${l}_{21}+{u}_{22}=2.$"} :step/id #uuid "1c48dd59-271b-57ac-b2ac-f6dcf7b5845b" :step/next {:db/id #edb/ref 17592186478478}} {:db/id #edb/ref 17592186478478 :step/content {:db/id #edb/ref 17592186243948 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e37e6cc-fad6-5510-9620-2cbac7ce22f7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-25" :db/id #edb/ref 17592186241439} {:answer/id #uuid "8ba5c239-540d-5f86-ac6d-97caed8a3faf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-30" :db/id #edb/ref 17592186242416} {:answer/id #uuid "8bab7e05-3097-50f9-97ae-0da4430bb726" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-24" :db/id #edb/ref 17592186242417} {:answer/id #uuid "8eefa27a-e9ae-567c-9c88-944a22b88b15" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-35" :db/id #edb/ref 17592186242437} {:answer/id #uuid "a2d916f4-e1c3-59c3-b962-73fcbf193360" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-18" :db/id #edb/ref 17592186242604}] :answer-field/correct {:db/id #edb/ref 17592186242416} :answer-field/id #uuid "e7fbcc62-56cc-5358-9e7d-035227d1830e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186243840}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3e43d37a-2ce4-531c-9855-25d3d30a5758" :question/math-academy-id "q-106762" :question/problem "Given that\n$A=[\\begin{aligned}-3 & 2 \\\\ 15 & -4\\end{aligned}]$ \nhas the LU decomposition $A=LU$, then ${l}_{21}\\cdot {u}_{22}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}-3 & 2 \\\\ 15 & -4\\end{aligned}] & {R}_{2} & :={R}_{2}+5{R}_{1}\\,⟺\\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 \\\\ 5 & 1\\end{aligned}]}}\\cdot A \\\\  & ∼[\\begin{aligned}-3 & 2 \\\\ 0 & 6\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 \\\\ 5 & 1\\end{aligned}]}^{-1}U \\\\ A & ={{[\\begin{aligned}1 & 0 \\\\ -5 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}-3 & 2 \\\\ 0 & 6\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{21}=-5,{u}_{22}=6,$ and ${l}_{21}\\cdot {u}_{12}=-30.$"} :step/id #uuid "58e0c1e2-70f8-57d5-86d1-9e1ecca5166a" :step/next {:db/id #edb/ref 17592186478479}} {:db/id #edb/ref 17592186478479 :step/content {:db/id #edb/ref 17592186243949 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03ddb432-c159-51bd-87f7-46377395435b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}1 & 0 \\\\ -4 & 1\\end{aligned}]" :db/id #edb/ref 17592186241213} {:answer/id #uuid "797c91c1-9cd0-58dd-9630-d65ae8a82a3f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}1 & 0 \\\\ -3 & 1\\end{aligned}]" :db/id #edb/r