[{"source" ":org/Math-Academy" "forms" [{:db/id 17592186133885 :knowledge-point/questions ["question-f11ffdfd-619b-56d9-be79-9ad5a11a6df9"] :db/ensure [:knowledge-point/validate]} {:db/id "question-f11ffdfd-619b-56d9-be79-9ad5a11a6df9" :question/id #uuid "f11ffdfd-619b-56d9-be79-9ad5a11a6df9" :question/math-academy-id "q-109851" :question/problem "Which of the following subspaces must be orthogonal to $\\text{Null}(B)$ for every matrix $B?$\n\nI. $\\text{Null}({B}^{T})$\n\nII. $\\text{Col}(B)$\n\nIII. $\\text{Col}({B}^{T})$" :question/worked-solution "Recall that $\\text{Null}(B)$ contains all vectors that, when pre-multiplied by $B,$ result in the zero-vector $0.$ \n\nWhen pre-multiplying a vector by $B,$ we actually multiply each row of $B$ by that vector. So, $\\text{Null}(B)$ must be orthogonal to the row space of $B,$ which is $\\text{Col}({A}^{T}).$\n\nTherefore, the correct answer is \"III only.\"\n\n**Note:** In general, the four fundamental subspaces of a matrix $B$ can be schematically visualized, as shown below.\n\n![](images/18/18713ed3d103ca0a02d74cede1e6448012e0aa28a2df804d41cfb277589a0158.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-24c992c9-8052-5ffe-8e34-a8bb4e14e451"] :db/ensure [:question/validate]} {:db/id "answer-field-24c992c9-8052-5ffe-8e34-a8bb4e14e451" :answer-field/id #uuid "24c992c9-8052-5ffe-8e34-a8bb4e14e451" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7aced2dd-2260-5a76-91a1-48cb49a84605" :answer-field/choices ["answer-768b47d4-ad9c-5a4c-818c-2d77de8a37b0" "answer-fb4475e7-9df7-5f01-8da5-2b4f45ddcbb7" "answer-c36cab80-11fb-53dd-8c1f-1830080636ad" "answer-48b52c8d-5a6d-57b6-b139-de7e62153564" "answer-7aced2dd-2260-5a76-91a1-48cb49a84605"] :db/ensure [:answer-field/validate]} {:db/id "answer-768b47d4-ad9c-5a4c-818c-2d77de8a37b0" :answer/id #uuid "768b47d4-ad9c-5a4c-818c-2d77de8a37b0" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-fb4475e7-9df7-5f01-8da5-2b4f45ddcbb7" :answer/id #uuid "fb4475e7-9df7-5f01-8da5-2b4f45ddcbb7" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-c36cab80-11fb-53dd-8c1f-1830080636ad" :answer/id #uuid "c36cab80-11fb-53dd-8c1f-1830080636ad" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-48b52c8d-5a6d-57b6-b139-de7e62153564" :answer/id #uuid "48b52c8d-5a6d-57b6-b139-de7e62153564" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-7aced2dd-2260-5a76-91a1-48cb49a84605" :answer/id #uuid "7aced2dd-2260-5a76-91a1-48cb49a84605" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]}] "assertions" [["question-f11ffdfd-619b-56d9-be79-9ad5a11a6df9" :question/id #uuid "f11ffdfd-619b-56d9-be79-9ad5a11a6df9"] ["question-f11ffdfd-619b-56d9-be79-9ad5a11a6df9" :question/math-academy-id "q-109851"] ["question-f11ffdfd-619b-56d9-be79-9ad5a11a6df9" :question/problem "Which of the following subspaces must be orthogonal to $\\text{Null}(B)$ for every matrix $B?$\n\nI. $\\text{Null}({B}^{T})$\n\nII. $\\text{Col}(B)$\n\nIII. $\\text{Col}({B}^{T})$"] ["question-f11ffdfd-619b-56d9-be79-9ad5a11a6df9" :question/worked-solution "Recall that $\\text{Null}(B)$ contains all vectors that, when pre-multiplied by $B,$ result in the zero-vector $0.$ \n\nWhen pre-multiplying a vector by $B,$ we actually multiply each row of $B$ by that vector. So, $\\text{Null}(B)$ must be orthogonal to the row space of $B,$ which is $\\text{Col}({A}^{T}).$\n\nTherefore, the correct answer is \"III only.\"\n\n**Note:** In general, the four fundamental subspaces of a matrix $B$ can be schematically visualized, as shown below.\n\n![](images/18/18713ed3d103ca0a02d74cede1e6448012e0aa28a2df804d41cfb277589a0158.png)"] ["question-f11ffdfd-619b-56d9-be79-9ad5a11a6df9" :question/di