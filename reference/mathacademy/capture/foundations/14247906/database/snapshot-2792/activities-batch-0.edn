 #edb/ref 17592186380585} {:answer/id #uuid "338e4081-fca8-5da7-8139-868e68982d73" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186380586}] :answer-field/correct {:db/id #edb/ref 17592186380584} :answer-field/id #uuid "091a11e0-779c-5adc-8846-339cc5d8f182" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186380581}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "95eda20f-4166-5e69-9b5a-dd4b026bbb36" :question/math-academy-id "q-109874" :question/problem "Consider a $2\\times 4$ matrix $A.$ If $\\text{dim}(\\text{Null}({A}^{T}))=1,$ then $\\text{dim}(\\text{Col}(A))=$" :question/worked-solution "The four fundamental subspaces of a matrix $A$ can be schematically visualized, as shown below.\n\n![](images/88/889b83fadd26b377c4dd34143c9b16541630c04e90de3d9b005e7147ead75ad5.png)\n\nIn our case, we are given that $m=2,$ $n=4,$ and $m-r=1.$ \n\nSubstituting $m=2$ into $m-r=1,$ we can find the rank of $A:$\n\n$$\n(2)-r=1\\,⟹\\,r=1\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{dim}(\\text{Col}(A)) & =r=1.\\end{aligned}\n$$"} :step/id #uuid "a1794f0c-c435-5d32-9d3f-3acd3b837de1" :step/next {:db/id #edb/ref 17592186495273}} {:db/id #edb/ref 17592186495262 :step/content {:db/id #edb/ref 17592186134072 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07509797-308b-5e51-8c0b-7ce937096e54" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{Null}(A)" :db/id #edb/ref 17592186380519} {:answer/id #uuid "5d46aa8d-aee6-5949-9319-7a6d7d0087f3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{Col}(A)" :db/id #edb/ref 17592186380520} {:answer/id #uuid "3c7884a2-0ad2-55ac-be08-5ec6f1269e25" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{Null}({A}^{T})" :db/id #edb/ref 17592186380521} {:answer/id #uuid "072d89d9-d407-530a-8155-7168cdaab68b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{Col}({A}^{T})" :db/id #edb/ref 17592186380522} {:answer/id #uuid "726d2de0-3519-5e23-aed7-7964192a471f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186380523}] :answer-field/correct {:db/id #edb/ref 17592186380522} :answer-field/id #uuid "3f23184f-d234-52a0-baf0-4d7dec1d4f26" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186380518}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f6e9167d-9cc2-5340-981b-f78b8d297972" :question/math-academy-id "q-108917" :question/problem "Let $A$ be a $m\\times n$ matrix. What is the image of $\\text{Col}(A)$ under the action of ${A}^{T}?$" :question/worked-solution "First,  notice that ${A}^{T}$ is a $n\\times m$ matrix.\n\nNow, pre-multiplying a vector $x\\in {R}^{m}$ by ${A}^{T}$ gives a linear combination of the columns of ${A}^{T}:$\n\n$$\n{{\\begin{bmatrix}| & | & ⋯ & | \\\\ {a}_{1}^{T} & {a}_{2}^{T} & ⋯ & {a}_{m}^{T} \\\\ | & | & ⋯ & |\\end{bmatrix}}_{⏟}}_{{A}^{T}}\\cdot {{\\begin{bmatrix}{x}_{1} \\\\ ⋮ \\\\ {x}_{m}\\end{bmatrix}}_{⏟}}_{x}={x}_{1}\\begin{bmatrix}| \\\\ {a}_{1}^{T} \\\\ |\\end{bmatrix}+{x}_{2}\\begin{bmatrix}| \\\\ {a}_{2}^{T} \\\\ |\\end{bmatrix}+⋯+{x}_{m}\\begin{bmatrix}| \\\\ {a}_{m}^{T} \\\\ |\\end{bmatrix}\n$$\n\nTherefore, the image of ${R}^{m}$ under the action of ${A}^{T}$ must be $\\text{Col}({A}^{T}),$ the column space of ${A}^{T},$ or equivalently, the row space of $A.$\n\nFurthermore, since $\\text{Null}({A}^{T})$ is mapped to the zero vector $0$ by the definition of the null subspace, the image of its orthogonal complement $\\text{Col}(({A}^{T})^{T})=\\text{Col}(A)$ must be $\\text{Col}({A}^{T}).$\n\nThis can be schematically visualized, as shown below.\n\n![](images/8c/8ca8508d05e28e4c91b5a7f3c65826ce68b5dacd382bfb1a76f09c09d1d004bf.png)"} :step/id #uuid "e1b380f9-a0f5-5846-b099-eca54ee4d1fe" :step/next {:db/id #edb/ref 17592186495229}} {:db/id #edb/ref 17592186495273 :step/content {:db/id #edb/ref 17592186362784 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29c8b328-6e43-5c3b-8a74-f5fb46485859" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186362786} {:answer/id #uuid "1b5037d9-2aed-5c31-90dd-13749f1173f7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186362787} {:answer/id #uuid "7121c77f-ff14-5b7a-a45e-f13b7d7f0e4b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186362788} {:answer/id #uuid "92b47738-a4c5-5222-b666-47b27f0b1d15" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186362789} {:answer/id #uuid "6dd3b88d-bd0d-5848-9ec4-09ca27570803" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186362790}] :answer-field/correct {:db/id #edb/ref 17592186362788} :answer-field/id #uuid "a13963a1-5122-5b42-936d-18e7d8414e4f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186362785}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3bb522f3-4dc5-5f07-a21d-cf9bb7dbc721" :question/math-academy-id "q-109875" :question/problem "Consider a $4\\times 5$ matrix $A.$ If $\\text{dim}(\\text{Null}(A))=1,$ then $\\text{dim}(\\text{Col}({A}^{T}))=$" :question/worked-solution "The four fundamental subspaces of a matrix $A$ can be schematically visualized, as shown below.\n\n![](images/88/889b83fadd26b377c4dd34143c9b16541630c04e90de3d9b005e7147ead75ad5.png)\n\nIn our case, we are given that $m=4,$ $n=5,$ and $n-r=1.$ \n\nSubstituting $n=5$ into $n-r=1,$ we can find the rank of $A:$\n\n$$\n(5)-r=1\\,⟹\\,r=4\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{dim}(\\text{Col}({A}^{T})) & =r=4.\\end{aligned}\n$$"} :step/id #uuid "fdb62714-5e6a-5d9d-a318-b5c03ffa46c2"}] :activity/title "The Four Fundamental Subspaces of a Matrix" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186494311}] [{:activity/course {:db/id #edb/ref 17592186046644} :activity/first-step {:db/id #edb/ref 17592186514490} :activity/id #uuid "ddb5d27f-6cfa-5d9a-8baa-a423632644e2" :activity/scope {:db/id #edb/ref 17592186049881 :topic/id #uuid "1aba1eae-fe85-559f-b4fb-b8896b64623f" :topic/math-academy-id 2200} :activity/steps [{:db/id #edb/ref 17592186514490 :step/content {:db/id #edb/ref 17592186407245 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ad86372-161b-56b5-b9b3-67cb9855544f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186407216} {:answer/id #uuid "3e4b4700-8836-57b3-a254-6685beac57ed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{Null}({A}^{T})" :db/id #edb/ref 17592186407217} {:answer/id #uuid "65001b28-0435-5b9d-91ec-614c84c822e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}^{n}" :db/id #edb/ref 17592186407221} {:answer/id #uuid "bf467989-30ff-5c80-94cc-972d1936e437" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{Col}({A}^{T})" :db/id #edb/ref 17592186407228} {:answer/id #uuid "d63461e1-95f1-5efd-aec4-a9f50c64386c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}^{m}" :db/id #edb/ref 17592186407232}] :answer-field/correct {:db/id #edb/ref 17592186407228} :answer-field/id #uuid "32cd5975-d7c1-5dd8-91de-4834a553c50c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186407239}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b9c49e80-5070-56aa-b070-99b1fa2fdff3" :question/math-academy-id "q-109848" :question/problem "Let $A$ be a $m\\times n$ matrix. What is the image of ${R}^{m}$ under the action of ${A}^{T}?$" :question/worked-solution "First, notice that ${A}^{T}$ is a $n\\times m$ matrix.\n\nPre-multiplying a vector $x\\in {R}^{m}$ by ${A}^{T}$ gives a linear combination of the columns of ${A}^{T}:$\n\n$$\n{{\\begin{bmatrix}| & | & ⋯ & | \\\\ {a}_{1}^{T} & {a}_{2}^{T} & ⋯ & {a}_{m}^{T} \\\\ | & | & ⋯ & |\\end{bmatrix}}_{⏟}}_{{A}^{T}}\\cdot {{\\begin{bmatrix}{x}_{1} \\\\ ⋮ \\\\ {x}_{m}\\end{bmatrix}}_{⏟}}_{x}={x}_{1}\\begin{bmatrix}| \\\\ {a}_{1}^{T} \\\\ |\\end{bmatrix}+{x}_{2}\\begin{bmatrix}| \\\\ {a}_{2}^{T} \\\\ |\\end{bmatrix}+⋯+{x}_{m}\\begin{bmatrix}| \\\\ {a}_{m}^{T} \\\\ |\\end{bmatrix}\n$$\n\nTherefore, the image of ${R}^{m}$ under the action of ${A}^{T}$ must be $\\text{Col}({A}^{T}),$ the row space of $A.$"} :step/id #uuid "14c1aa12-7e87-5b1e-9c66-6bd7f1359f4f" :step/next {:db/id #edb/ref 17592186514504}} {:db/id #edb/ref 17592186514495 :step/content {:db/id #edb/ref 17592186362770 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ab280a44-737b-5327-b8b9-37dc6ef7b3be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}^{6}" :db/id #edb/ref 17592186362772} {:answer/id #uuid "d5d452ec-369b-54d1-8357-79ad02025a07" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}^{4}" :db/id #edb/ref 17592186362773} {:answer/id #uuid "99ca8573-a2e6-558c-b3c7-031132e63ac3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{Null}({A}^{T})" :db/id #edb/ref 17592186362774} {:answer/id #uuid "f3e2aca3-e8c2-5d00-b0bc-0cf40e3489e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{Col}({A}^{T})" :db/id #edb/ref 17592186362775} {:answer/id #uuid "887d2b50-662a-542d-9779-a9834c4a9b0e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186362776}] :answer-field/correct {:db/id #edb/ref 17592186362775} :answer-field/id #uuid "bb6ed2ff-8856-5c19-ae37-a59672f92f3b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186362771}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1f5df99f-1d28-5975-9513-4422bec5dfb5" :question/math-academy-id "q-109860" :question/problem "Let $A$ be a $4\\times 6$ matrix. What is the image of ${R}^{4}$ under the action of ${A}^{T}?$" :question/worked-solution "First, notice that ${A}^{T}$ is a $6\\times 4$ matrix.\n\nPre-multiplying a vector $x\\in {R}^{4}$ by ${A}^{T}$ gives a linear combination of the columns of ${A}^{T}:$\n\n$$\n{{\\begin{bmatrix}| & | & | & | \\\\ {a}_{1}^{T} & {a}_{2}^{T} & {a}_{3}^{T} & {a}_{4}^{T} \\\\ | & | & | & |\\end{bmatrix}}_{⏟}}_{{A}^{T}}\\cdot {{\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3} \\\\ {x}_{4}\\end{bmatrix}}_{⏟}}_{x}={x}_{1}\\begin{bmatrix}| \\\\ {a}_{1}^{T} \\\\ |\\end{bmatrix}+{x}_{2}\\begin{bmatrix}| \\\\ {a}_{2}^{T} \\\\ |\\end{bmatrix}+{x}_{3}\\begin{bmatrix}| \\\\ {a}_{3}^{T} \\\\ |\\end{bmatrix}+{x}_{4}\\begin{bmatrix}| \\\\ {a}_{4}^{T} \\\\ |\\end{bmatrix}\n$$\n\nTherefore, the image of ${R}^{4}$ under the action of ${A}^{T}$ must be $\\text{Col}({A}^{T}),$ the row space of $A.$"} :step/id #uuid "2df8d215-4169-5ff0-96f8-b514b08b3eb0" :step/next {:db/id #edb/ref 17592186514513}} {:db/id #edb/ref 17592186514504 :step/content {:db/id #edb/ref 17592186514442 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48ab1b2f-ec6e-507b-9701-7686776d5ac6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186513728} {:answer/id #uuid "4b89e055-2ad7-5945-ba06-41fd9a844ae2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186513736} {:answer/id #uuid "5279f1a0-7964-5e07-bb5f-5a1cc2249ed2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186513759} {:answer/id #uuid "a13c9b82-7a72-5392-b4b2-9e4a90902573" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186513947} {:answer/id #uuid "dd1d87ab-3668-53ac-951d-faeb38987ac2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186514112}] :answer-field/correct {:db/id #edb/ref 17592186514112} :answer-field/id #uuid "ea9559f3-a3c8-59ae-9017-a04ed616a025" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186514336}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9d632f6e-3556-5d97-834c-4e1de9c56681" :question/math-academy-id "q-109858" :question/problem "Which of the following subspaces must be orthogonal to $\\text{Col}({A}^{T}+{B}^{T})$ for all compatible matrices $A$ and $B?$\n\nI. $\\text{Null}(A+B)$\n\nII. $\\text{Col}(A+B)$\n\nIII. $\\text{Null}({A}^{T}+{B}^{T})$" :question/worked-solution "Recall that $\\text{Col}({A}^{T}+{B}^{T})$ is the row space of $({A}^{T}+{B}^{T})^{T}=A+B.$ This consists of all linear combinations of the rows of $A+B.$\n\nIf a vector is orthogonal to every linear combination of the rows of $A+B,$ it must be orthogonal to each row of $A+B.$\nBut notice that when pre-multiplying a vector by $A+B,$ we actually multiply each row of $A+B$ by that vector.\nSo, $\\text{Col}({A}^{T}+{B}^{T})$ must be orthogonal to the null space of $A+B,$ which is $\\text{Null}(A+B).$\n\nTherefore, the correct answer is \"I only.\"\n\n**Note:** In general, the four fundamental subspaces of a matrix $A$ can be schematically visualized, as shown below.\n\n![](images/de/de22dd5b352e1d5be48f4b6ed3b2a4657ae623c1bd288d3464559758ea334af7.png)"} :step/id #uuid "56314e20-2366-500d-aee8-f1badacd2314" :step/next {:db/id #edb/ref 17592186514495}} {:db/id #edb/ref 17592186514513 :step/content {:db/id #edb/ref 17592186407244 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e0fd37b-833c-5581-bf94-abc93beffe65" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186407214} {:answer/id #uuid "6203c04e-a6ad-568e-b086-f63c9a0600d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186407220} {:answer/id #uuid "a5ba999d-5dc0-5e42-af53-78dc73ee4de4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186407224} {:answer/id #uuid "ba9ba337-a858-55b1-bf28-9f915ba4dcc2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186407226} {:answer/id #uuid "e18de25a-171d-5acb-88a3-6812297610fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186407234}] :answer-field/correct {:db/id #edb/ref 17592186407226} :answer-field/id #uuid "e82e089a-caba-5439-8d15-a646e7c8e9fa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186407242}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "66ca173a-d952-58d1-b484-502590c17693" :question/math-academy-id "q-109873" :question/problem "Consider a $5\\times 6$ matrix $A.$ If $\\text{dim}(\\text{Col}({A}^{T}))=3,$ then $\\text{dim}(\\text{Null}({A}^{T}))=$" :question/worked-solution "The four fundamental subspaces of a matrix $A$ can be schematically visualized, as shown below.\n\n![](images/88/889b83fadd26b377c4dd34143c9b16541630c04e90de3d9b005e7147ead75ad5.png)\n\nIn our case, we are given that $m=5,$ $n=6,$ and $r=3.$ \n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{dim}(\\text{Null}({A}^{T})) & =m-r=5-3=2.\\end{aligned}\n$$"} :step/id #uuid "78d36b97-fb9f-562b-a664-3f90af4e59df" :step/next {:db/id #edb/ref 17592186514528}} {:db/id #edb/ref 17592186514528 :step/content {:db/id #edb/ref 17592186514400 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ffd03e5-d22d-5766-a803-65f19cfd5c3b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186513571} {:answer/id #uuid "407da24d-3379-5bc7-b2ac-f9a5576feabc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186513702} {:answer/id #uuid "568a861a-1250-5245-9ac3-b13ddd599d76" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186513766} {:answer/id #uuid "afc78170-0f40-51ef-9a2e-a8c37ba5fad6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186513995} {:answer/id #uuid "e4975b80-f61d-5eb9-898f-fe70609d075c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186514134}] :answer-field/correct {:db/id #edb/ref 17592186513571} :answer-field/id #uuid "27448a27-2ab1-5f66-ac78-eb27dc883118" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186514238}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5241b6a1-96aa-5720-ba1b-4d884df832da" :question/math-academy-id "q-109877" :question/problem "Consider a $3\\times 2$ matrix $A.$ If $\\text{dim}(\\text{Col}({A}^{T}))=2,$ then $\\text{dim}(\\text{Null}(A))=$" :question/worked-solution "The four fundamental subspaces of a matrix $A$ can be schematically visualized, as shown below.\n\n![](images/88/889b83fadd26b377c4dd34143c9b16541630c04e90de3d9b005e7147ead75ad5.png)\n\nIn our case, we are given that $m=3,$ $n=2,$ and $r=2.$ \n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{dim}(\\text{Null}(A)) & =n-r=2-2=0.\\end{aligned}\n$$"} :step/id #uuid "bc095201-9245-5703-95d0-69f9cc120dd7"}] :activity/title "The Four Fundamental Subspaces of a Matrix" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186513523}] [{:activity/course {:db/id #edb/ref 17592186046645} :activity/first-step {:db/id #edb/ref 17592186543650} :activity/id #uuid "dcac007b-4160-5c57-b3fa-73790e770eac" :activity/scope {:db/id #edb/ref 17592186049881 :topic/id #uuid "1aba1eae-fe85-559f-b4fb-b8896b64623f" :topic/math-academy-id 2200} :activity/steps [{:db/id #edb/ref 17592186543596 :step/content {:db/id #edb/ref 17592186134077 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fac33087-90a9-5374-bb9b-89306309caf6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186477109} {:answer/id #uuid "1cb234b8-e70d-5436-816b-c72569cefcc6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186477110}] :answer-field/correct {:db/id #edb/ref 17592186477109} :answer-field/id #uuid "f5195686-7398-592f-a034-c46b06f34fab" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186477524} {:answer-field/choices [{:answer/id #uuid "b51fbdcf-5bea-512d-8ea2-0767a22863a5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186477111} {:answer/id #uuid "4e912cb8-5633-51bd-a892-7203a2451c74" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186477112}] :answer-field/correct {:db/id #edb/ref 17592186477111} :answer-field/id #uuid "5c026345-d4f5-55cd-a8b5-b6a688019eae" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186477525} {:answer-field/choices [{:answer/id #uuid "aa16ff18-2df7-5ce8-a4c4-8312d682551a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186477113} {:answer/id #uuid "70d44836-3172-59de-bfac-3e6678ca53bc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186477114}] :answer-field/correct {:db/id #edb/ref 17592186477114} :answer-field/id #uuid "a69cc77a-87f4-5f19-9bae-02259b9be70b" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186477526}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1f81e62d-c183-546b-b986-59beb21560d1" :question/math-academy-id "q-109854" :question/problem "Which of the following subspaces must be orthogonal to $\\text{Null}(XY)$ for all compatible matrices $X$ and $Y?$\n- **I.** $\\text{Null}({Y}^{T}\\,{X}^{T})$\n- **II.** $\\text{Col}(XY)$\n- **III.** $\\text{Col}({Y}^{T}\\,{X}^{T})$\n\nSelect all that apply." :question/worked-solution "Recall that $\\text{Null}(XY)$ contains all vectors that, when pre-multiplied by $XY,$ result in the zero-vector $0.$ \n\nWhen pre-multiplying a vector by $XY,$ we actually multiply each row of $XY$ by that vector. So, $\\text{Null}(XY)$ must be orthogonal to the row space of $XY,$ which is $\\text{Col}((XY)^{T})=\\text{Col}({Y}^{T}\\,{X}^{T}).$\n\nTherefore, the correct answer is \"III only.\"\n\n**Note:** In general, the four fundamental subspaces of a matrix $A$ can be schematically visualized, as shown below.\n\n![](images/de/de22dd5b352e1d5be48f4b6ed3b2a4657ae623c1bd288d3464559758ea334af7.png)"} :step/id #uuid "03787068-e65a-5894-ac0f-70677b84b503" :step/next {:db/id #edb/ref 17592186543659}} {:db/id #edb/ref 17592186543605 :step/content {:db/id #edb/ref 17592186362743 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ed2e2bd4-fa9e-5c29-9fde-5b640f207da7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{Null}(A)" :db/id #edb/ref 17592186362745} {:answer/id #uuid "b42b2193-b9c4-5e0c-aafb-563bb246ff36" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{Col}(A)" :db/id #edb/ref 17592186362746} {:answer/id #uuid "d28bf949-da52-5d09-b5ad-42160431f00c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{Col}({A}^{T})" :db/id #edb/ref 17592186362747} {:answer/id #uuid "455a70da-1199-5679-aa6a-6757392650df" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186362748} {:answer/id #uuid "8522f512-49e6-5a4c-b597-44a8def8386e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}^{n}" :db/id #edb/ref 17592186362749}] :answer-field/correct {:db/id #edb/ref 17592186362748} :answer-field/id #uuid "6b75f144-2c87-55fa-ae37-c2b10ecef350" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186362744}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "462ca0a9-fbe9-5641-92d4-faed2ef0803e" :question/math-academy-id "q-109849" :question/problem "Let $A$ be a $m\\times n$ matrix. What is the image of $\\text{Null}(A)$ under the action of $A?$" :question/worked-solution "By definition of the null subspace, $\\text{Null}(A)$ is mapped to the zero vector $0$ under the action of $A.$"} :step/id #uuid "12ea7b05-1139-5991-9ab8-d66b18daabf2" :step/next {:db/id #edb/ref 17592186543616}} {:db/id #edb/ref 17592186543616 :step/content {:db/id #edb/ref 17592186362750 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ed2ea04-17c5-525d-bb8b-a73bdb48fa90" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{Null}({B}^{T})" :db/id #edb/ref 17592186362752} {:answer/id #uuid "81d7a34a-2311-5d45-891e-5cd69b89006d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{Col}(B)" :db/id #edb/ref 17592186362753} {:answer/id #uuid "1ed9ddc3-ffd8-53ba-802f-ad779bcf8c3e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{Col}({B}^{T})" :db/id #edb/ref 17592186362754} {:answer/id #uuid "7b88adee-5c88-5a21-99be-baee1cf260db" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186362755} {:answer/id #uuid "7aed3ab2-0476-5b02-8570-9d68a6779e1a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{Null}(B)" :db/id #edb/ref 17592186362756}] :answer-field/correct {:db/id #edb/ref 17592186362753} :answer-field/id #uuid "4b3fad67-e441-547e-bcca-af1012111f8e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186362751}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "63c0c3aa-6cd0-5913-9f45-9198721d3066" :question/math-academy-id "q-109850" :question/problem "Let $B$ be a $m\\times n$ matrix. What is the image of $\\text{Col}({B}^{T})$ under the action of $B?$" :question/worked-solution "Pre-multiplying a vector $x\\in {R}^{n}$ by $B$ gives a linear combination of the columns of $B:$\n\n$$\n{{\\begin{bmatrix}| & | & ⋯ & | \\\\ {b}_{1} & {b}_{2} & ⋯ & {b}_{n} \\\\ | & | & ⋯ & |\\end{bmatrix}}_{⏟}}_{B}\\cdot {{\\begin{bmatrix}{x}_{1} \\\\ ⋮ \\\\ {x}_{n}\\end{bmatrix}}_{⏟}}_{x}={x}_{1}\\begin{bmatrix}| \\\\ {b}_{1} \\\\ |\\end{bmatrix}+{x}_{2}\\begin{bmatrix}| \\\\ {b}_{2} \\\\ |\\end{bmatrix}+⋯+{x}_{n}\\begin{bmatrix}| \\\\ {b}_{n} \\\\ |\\end{bmatrix}\n$$\n\nTherefore, the image of ${R}^{n}$ under the action of $B$ must be $\\text{Col}(B),$ the column space of $B.$\n\nFurthermore, since $\\text{Null}(B)$ is mapped to the zero vector $0$ by the definition of the null subspace, the image of its orthogonal complement $\\text{Col}({B}^{T})$ must be $\\text{Col}(B).$\n\nThis can be schematically visualized, as shown below.\n\n![](images/ad/ad1557fbd48206baf7239046ada69f60d8cd9ee4916b4f8e37741903ef7d1e9b.png)"} :step/id #uuid "32720668-2e01-58f0-9e8c-cb68020bcffd" :step/next {:db/id #edb/ref 17592186543596}} {:db/id #edb/ref 17592186543650 :step/content {:db/id #edb/ref 17592186134071 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f20cbbab-e838-5cc3-9bc0-309fc77b0b95" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186477097} {:answer/id #uuid "56ed48d0-e778-5305-b095-810cb0318a7c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186477098}] :answer-field/correct {:db/id #edb/ref 17592186477097} :answer-field/id #uuid "ecbb62c7-2dda-5a03-840d-d5922c38c749" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186477518} {:answer-field/choices [{:answer/id #uuid "080c9074-8477-5142-a998-302831331617" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186477099} {:answer/id #uuid "2adbcb29-ae60-5a02-a7a4-ad81cc23bd1d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186477100}] :answer-field/correct {:db/id #edb/ref 17592186477100} :answer-field/id #uuid "d6babc65-b40a-5bbb-a637-5cba3fe592bd" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186477519} {:answer-field/choices [{:answer/id #uuid "9c831444-2313-518a-a561-b0194ffe8ba6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186477101} {:answer/id #uuid "ea4d407d-7ce7-52d8-af97-f359e9fd20bc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186477102}] :answer-field/correct {:db/id #edb/ref 17592186477101} :answer-field/id #uuid "1800ad63-0f0b-509e-9e17-fed976eb45e8" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186477520}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "304499af-cb5d-5e3b-8108-be3a9fa9519f" :question/math-academy-id "q-108907" :question/problem "Which of the following subspaces must be orthogonal to $\\text{Null}(A)$ for every matrix $A?$\n- **I.** $\\text{Null}({A}^{T})$\n- **II.** $\\text{Col}({A}^{T})$\n- **III.** $\\text{Col}(A)$\n\nSelect all that apply." :question/worked-solution "Recall that $\\text{Null}(A)$ contains all vectors that, when pre-multiplied by $A,$ result in the zero-vector $0.$ \n\nWhen pre-multiplying a vector by $A,$ we actually multiply each row of $A$ by that vector. So, $\\text{Null}(A)$ must be orthogonal to the row space of $A,$ which is $\\text{Col}({A}^{T}).$\n\nTherefore, the correct answer is \"II only.\"\n\n**Note:** In general, the four fundamental subspaces of a matrix $A$ can be schematically visualized, as shown below.\n\n![](images/de/de22dd5b352e1d5be48f4b6ed3b2a4657ae623c1bd288d3464559758ea334af7.png)"} :step/id #uuid "a47247ac-314d-5bb2-ba6f-fdd8d1f684d7" :step/next {:db/id #edb/ref 17592186543605}} {:db/id #edb/ref 17592186543659 :step/content {:db/id #edb/ref 17592186362777 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d02fe1b-cc17-5f82-9b2a-b4e46bf1f308" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186362779} {:answer/id #uuid "3ced5acd-cca0-55c2-ba8d-f6afaf38adc5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186362780} {:answer/id #uuid "c56c69d3-7c0c-55ae-8047-91c125d12c2d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186362781} {:answer/id #uuid "9abee5d9-9e49-55dd-8103-58f4e5cfba37" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186362782} {:answer/id #uuid "785f4b33-ec9e-5e15-b22e-c297f48f6d38" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186362783}] :answer-field/correct {:db/id #edb/ref 17592186362782} :answer-field/id #uuid "cfbba52c-655b-5de4-989a-7c3965af0883" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186362778}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "debbebbb-8895-508b-8192-3a839f7cbe92" :question/math-academy-id "q-109870" :question/problem "Consider a $7\\times 9$ matrix $A.$ If $\\text{dim}(\\text{Null}(A))=3,$ then $\\text{dim}(\\text{Col}({A}^{T}))=$" :question/worked-solution "The four fundamental subspaces of a matrix $A$ can be schematically visualized, as shown below.\n\n![](images/88/889b83fadd26b377c4dd34143c9b16541630c04e90de3d9b005e7147ead75ad5.png)\n\nIn our case, we are given that $m=7,$ $n=9,$ and $n-r=3.$ \n\nSubstituting $n=9$ into $n-r=3,$ we can find the rank of $A:$\n\n$$\n(9)-r=3\\,⟹\\,r=6\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{dim}(\\text{Col}({A}^{T})) & =r=6.\\end{aligned}\n$$"} :step/id #uuid "b86b6c6f-57d1-5201-a6cd-714b57d1a7ce"}] :activity/title "The Four Fundamental Subspaces of a Matrix" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186542628}]}
