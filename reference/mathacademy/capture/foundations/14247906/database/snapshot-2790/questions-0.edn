e "Identifying an Orthogonal Fundamental Subspaces of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e37cdb6-c2f8-5f2d-b68e-1ab7dae2c068" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472502} {:answer/id #uuid "ac8ee36b-6930-5033-bbff-c6e5831b6de6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472503}] :answer-field/correct {:answer/id #uuid "6e37cdb6-c2f8-5f2d-b68e-1ab7dae2c068" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472502} :answer-field/id #uuid "48015e6d-6aef-53c6-aa13-f63167aef2d9" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473646} {:answer-field/choices [{:answer/id #uuid "c132e320-a78b-5003-a32b-1274e70dff6b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472504} {:answer/id #uuid "2c9107f0-649f-5e5e-8c94-d1089de849cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472505}] :answer-field/correct {:answer/id #uuid "2c9107f0-649f-5e5e-8c94-d1089de849cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472505} :answer-field/id #uuid "ff283957-040e-592b-8540-faef6177d2d1" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473647} {:answer-field/choices [{:answer/id #uuid "49c7e552-c7ec-5bd5-9721-98ed03dbe1c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472506} {:answer/id #uuid "bce36cf7-e320-5e6d-97a5-94061b6e55fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472507}] :answer-field/correct {:answer/id #uuid "49c7e552-c7ec-5bd5-9721-98ed03dbe1c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472506} :answer-field/id #uuid "0d2b47b3-71ab-5d28-ac5e-96cdddfab7f6" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473648}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b9f78c95-881f-537a-b5e6-305264553498" :question/math-academy-id "q-109777" :question/problem "Which of the following subspaces must be orthogonal to $\\text{Col}(A)$ for every matrix $A?$\n- **I.** $\\text{Col}({A}^{T})$\n- **II.** $\\text{Null}({A}^{T})$\n- **III.** $\\text{Null}(A)$\n\nSelect all that apply." :question/worked-solution "Recall that $\\text{Col}(A)$ consists of all linear combinations of the columns of $A$, that is, the rows of ${A}^{T}.$\n\nIf a vector is orthogonal to every linear combination of the rows of ${A}^{T},$ it must be orthogonal to each row of ${A}^{T}.$\nBut notice that when pre-multiplying a vector by ${A}^{T},$ we actually multiply each row of ${A}^{T}$ by that vector.\nSo, $\\text{Col}(A)$ must be orthogonal to the left null space of $A,$ which is $\\text{Null}({A}^{T}).$\n\nTherefore, the correct answer is \"II only.\"\n\n**Note:** In general, the four fundamental subspaces of a matrix $A$ can be schematically visualized, as shown below.\n\n![](images/de/de22dd5b352e1d5be48f4b6ed3b2a4657ae623c1bd288d3464559758ea334af7.png)"}] [{:db/id #edb/ref 17592186362730 :knowledge-point/_questions [{:db/id #edb/ref 17592186133887 :knowledge-point/id #uuid "1a36c7f7-4287-562b-94ea-047b38ede70f" :knowledge-point/title "Finding the Dimensions of the Four Fundamental Subspaces of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35f644fb-8086-555f-b786-602d1979ce61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186362732} {:answer/id #uuid "bea4a0b0-d1b5-5839-b044-8108d6b9ddd2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186362733} {:answer/id #uuid "5565d328-aa38-5f70-98e1-4235e6b2083d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186362734} {:answer/id #uuid "ddf71678-271a-5c3f-81ec-cb9596b621d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186362735} {:answer/id #uuid "9d8d1290-ea1d-567f-8d0b-a0f233dca5dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186362736}] :answer-field/correct {:answer/id #uuid "bea4a0b0-d1b5-5839-b044-8108d6b9ddd2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186362733} :answer-field/id #uuid "ff003ae2-5c05-524e-9932-2c06214cec61" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186362731}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "aa262e05-5582-5f00-bdc8-007681456bff" :question/math-academy-id "q-109845" :question/problem "Consider a $4\\times 3$ matrix $A.$ If $\\text{dim}(\\text{Null}(A))=1,$ then $\\text{dim}(\\text{Col}({A}^{T}))=$" :question/worked-solution "The four fundamental subspaces of a matrix $A$ can be schematically visualized, as shown below.\n\n![](images/88/889b83fadd26b377c4dd34143c9b16541630c04e90de3d9b005e7147ead75ad5.png)\n\nIn our case, we are given that $m=4,$ $n=3,$ and $n-r=1.$ \n\nSubstituting $n=3$ into $n-r=1,$ we can find the rank of $A:$\n\n$$\n(3)-r=1\\,⟹\\,r=2\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{dim}(\\text{Col}({A}^{T})) & =r=2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186407243 :knowledge-point/_questions [{:db/id #edb/ref 17592186133887 :knowledge-point/id #uuid "1a36c7f7-4287-562b-94ea-047b38ede70f" :knowledge-point/title "Finding the Dimensions of the Four Fundamental Subspaces of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "166f24b3-2b33-5589-9ba5-efd73efdf696" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186407215} {:answer/id #uuid "794d7c6a-4727-5c98-8506-efa641e24334" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186407222} {:answer/id #uuid "c4f31e2f-2172-581c-b46f-338027d98c9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186407229} {:answer/id #uuid "de4a68e5-c938-5191-8ef4-522e158bedb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186407233} {:answer/id #uuid "f4d32fbe-6d2e-5aca-9070-ed1ab0efc4fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186407235}] :answer-field/correct {:answer/id #uuid "c4f31e2f-2172-581c-b46f-338027d98c9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186407229} :answer-field/id #uuid "077cd26a-5956-5d07-8539-e101ab53d7f4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186407238}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5d75070f-88dd-5b20-8fec-c1f3c6de013c" :question/math-academy-id "q-109846" :question/problem "Consider a $5\\times 4$ matrix $A.$ If $\\text{dim}(\\text{Col}({A}^{T}))=3,$ then $\\text{dim}(\\text{Null}(A))=$" :question/worked-solution "The four fundamental subspaces of a matrix $A$ can be schematically visualized, as shown below.\n\n![](images/88/889b83fadd26b377c4dd34143c9b16541630c04e90de3d9b005e7147ead75ad5.png)\n\nIn our case, we are given that $m=5,$ $n=4,$ and $r=3.$ \n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{dim}(\\text{Null}(A)) & =n-r=4-3=1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186134076 :knowledge-point/_questions [{:db/id #edb/ref 17592186133887 :knowledge-point/id #uuid "1a36c7f7-4287-562b-94ea-047b38ede70f" :knowledge-point/title "Finding the Dimensions of the Four Fundamental Subspaces of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a1abcc03-91d1-552b-9d4d-9a115b7162b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186362738} {:answer/id #uuid "c60509e5-818a-5e5e-b197-6af69774dd36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186362739} {:answer/id #uuid "f75117f4-5157-5a16-8cc6-ba4f53bf01b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186362740} {:answer/id #uuid "12667677-285f-5967-a229-9a31385011dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186362741} {:answer/id #uuid "74b909d7-4810-52a5-b17e-ba23c831d0b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186362742}] :answer-field/correct {:answer/id #uuid "a1abcc03-91d1-552b-9d4d-9a115b7162b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186362738} :answer-field/id #uuid "9c5d07ae-1027-53fa-a3de-70f4fa5a1296" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186362737}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "485e3060-5691-5e86-bcb1-ec2efd550199" :question/math-academy-id "q-109847" :question/problem "Consider a $7\\times 5$ matrix $A.$ If $\\text{dim}(\\text{Col}(A))=4,$ then $\\text{dim}(\\text{Null}({A}^{T}))=$" :question/worked-solution "The four fundamental subspaces of a matrix $A$ can be schematically visualized, as shown below.\n\n![](images/88/889b83fadd26b377c4dd34143c9b16541630c04e90de3d9b005e7147ead75ad5.png)\n\nIn our case, we are given that $m=7,$ $n=5,$ and $r=4.$ \n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{dim}(\\text{Null}({A}^{T})) & =m-r=7-4=3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186362743 :knowledge-point/_questions [{:db/id #edb/ref 17592186133888 :knowledge-point/id #uuid "75e1da77-a5dc-5f78-977e-0d6dae99c97e" :knowledge-point/title "Identifying the Images of the Four Fundamental Subspaces of the Matrix Under Its Action"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ed2e2bd4-fa9e-5c29-9fde-5b640f207da7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Null}(A)" :db/id #edb/ref 17592186362745} {:answer/id #uuid "b42b2193-b9c4-5e0c-aafb-563bb246ff36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Col}(A)" :db/id #edb/ref 17592186362746} {:answer/id #uuid "d28bf949-da52-5d09-b5ad-42160431f00c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Col}({A}^{T})" :db/id #edb/ref 17592186362747} {:answer/id #uuid "455a70da-1199-5679-aa6a-6757392650df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186362748} {:answer/id #uuid "8522f512-49e6-5a4c-b597-44a8def8386e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{n}" :db/id #edb/ref 17592186362749}] :answer-field/correct {:answer/id #uuid "455a70da-1199-5679-aa6a-6757392650df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186362748} :answer-field/id #uuid "6b75f144-2c87-55fa-ae37-c2b10ecef350" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186362744}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "462ca0a9-fbe9-5641-92d4-faed2ef0803e" :question/math-academy-id "q-109849" :question/problem "Let $A$ be a $m\\times n$ matrix. What is the image of $\\text{Null}(A)$ under the action of $A?$" :question/worked-solution "By definition of the null subspace, $\\text{Null}(A)$ is mapped to the zero vector $0$ under the action of $A.$"}] [{:db/id #edb/ref 17592186362757 :knowledge-point/_questions [{:db/id #edb/ref 17592186133885 :knowledge-point/id #uuid "5ada5d20-89d8-5bc9-9b10-172356be0eb4" :knowledge-point/title "Identifying an Orthogonal Fundamental Subspaces of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a086316-7979-5489-80d1-53acc4d24abc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468900} {:answer/id #uuid "b99411da-dd65-540c-baac-33222e1d3119" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468901}] :answer-field/correct {:answer/id #uuid "b99411da-dd65-540c-baac-33222e1d3119" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468901} :answer-field/id #uuid "fbddedc3-e46b-5894-a531-254e9b2af1f7" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470062} {:answer-field/choices [{:answer/id #uuid "03dbe6ba-2210-5d10-b9dc-7784b2974743" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468902} {:answer/id #uuid "175690fb-4a79-5f7a-9ebf-d563a8b6c20d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468903}] :answer-field/correct {:answer/id #uuid "03dbe6ba-2210-5d10-b9dc-7784b2974743" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468902} :answer-field/id #uuid "2e51fd03-ef62-5d86-b235-8ff005960dca" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470063} {:answer-field/choices [{:answer/id #uuid "f3b55218-0017-54d5-844f-7cadc727ad3d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468904} {:answer/id #uuid "659815a3-3997-5a2d-8572-21b4da63ec85" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468905}] :answer-field/correct {:answer/id #uuid "f3b55218-0017-54d5-844f-7cadc727ad3d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468904} :answer-field/id #uuid "8fd6a5f6-5f26-5807-8c29-f09159124c60" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470064}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4c3520bf-5736-51de-a6b7-f6ed37ab8f1a" :question/math-academy-id "q-109852" :question/problem "Which of the following subspaces must be orthogonal to $\\text{Col}(B)$ for every matrix $B?$\n- **I.** $\\text{Null}({B}^{T})$\n- **II.** $\\text{Col}({B}^{T})$\n- **III.** $\\text{Null}(B)$\n\nSelect all that apply." :question/worked-solution "Recall that $\\text{Col}(B)$ consists of all linear combinations of the columns of $B$, that is, the rows of ${B}^{T}.$\n\nIf a vector is orthogonal to every linear combination of the rows of ${B}^{T},$ it must be orthogonal to each row of ${B}^{T}.$\nBut notice that when pre-multiplying a vector by ${B}^{T},$ we actually multiply each row of ${B}^{T}$ by that vector.\nSo, $\\text{Col}(B)$ must be orthogonal to the left null space of $B,$ which is $\\text{Null}({B}^{T}).$\n\nTherefore, the correct answer is \"I only.\"\n\n**Note:** In general, the four fundamental subspaces of a matrix $B$ can be schematically visualized, as shown below.\n\n![](images/18/18713ed3d103ca0a02d74cede1e6448012e0aa28a2df804d41cfb277589a0158.png)"}] [{:db/id #edb/ref 17592186476888 :knowledge-point/_questions [{:db/id #edb/ref 17592186133885 :knowledge-point/id #uuid "5ada5d20-89d8-5bc9-9b10-172356be0eb4" :knowledge-point/title "Identifying an Orthogonal Fundamental Subspaces of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18841c85-4169-5e21-aa60-7f9429a69ea9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186476243} {:answer/id #uuid "32eb844c-ce40-54f8-8182-8bdb52ef41a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186476316} {:answer/id #uuid "be8b7e98-b032-5486-9065-1ba9e55cd64e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186476636} {:answer/id #uuid "c719959b-438d-5216-87e0-1e590c4937dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186476652} {:answer/id #uuid "e3f9aeac-42a7-57b9-961a-8f9b80d6c9b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186476709}] :answer-field/correct {:answer/id #uuid "32eb844c-ce40-54f8-8182-8bdb52ef41a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186476316} :answer-field/id #uuid "ef854973-f40e-54d0-8398-b5ed45b6afdd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186476861}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3930016a-7426-5deb-b0f0-c2074d3a1ffd" :question/math-academy-id "q-109856" :question/problem "Which of the following subspaces must be orthogonal to $\\text{Null}(A+B)$ for all compatible matrices $A$ and $B?$\n\nI. $\\text{Null}({A}^{T}+{B}^{T})$\n\nII. $\\text{Col}({A}^{T}+{B}^{T})$\n\nIII. $\\text{Col}(A+B)$" :question/worked-solution "Recall that $\\text{Null}(A+B)$ contains all vectors that, when pre-multiplied by $A+B,$ result in the zero-vector $0.$ \n\nWhen pre-multiplying a vector by $A+B,$ we actually multiply each row of $A+B$ by that vector. So, $\\text{Null}(A+B)$ must be orthogonal to the row space of $A+B,$ which is $\\text{Col}((A+B)^{T})=\\text{Col}({A}^{T}+{B}^{T}).$\n\nTherefore, the correct answer is \"II only.\"\n\n**Note:** In general, the four fundamental subspaces of a matrix $A$ can be schematically visualized, as shown below.\n\n![](images/de/de22dd5b352e1d5be48f4b6ed3b2a4657ae623c1bd288d3464559758ea334af7.png)"}] [{:db/id #edb/ref 17592186476895 :knowledge-point/_questions [{:db/id #edb/ref 17592186133885 :knowledge-point/id #uuid "5ada5d20-89d8-5bc9-9b10-172356be0eb4" :knowledge-point/title "Identifying an Orthogonal Fundamental Subspaces of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c6d4e70-0448-5ab5-9f2d-ce038f339c40" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186476265} {:answer/id #uuid "7cd9368f-9feb-504f-a71d-cd5bb34f56ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186476479} {:answer/id #uuid "ae6f1a68-607c-5b44-a425-625c20d52a6a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186476589} {:answer/id #uuid "e41a1e37-3b17-5fc8-8508-7b738b3b3074" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186476710} {:answer/id #uuid "f85e9333-5d0e-542b-837b-a916ca56e2ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186476749}] :answer-field/correct {:answer/id #uuid "ae6f1a68-607c-5b44-a425-625c20d52a6a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186476589} :answer-field/id #uuid "2f9bb4ab-702b-5516-8021-d3e236ee68e9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186476778}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4d68ce86-72b3-53d7-b424-c8c3717fc180" :question/math-academy-id "q-109857" :question/problem "Which of the following subspaces must be orthogonal to $\\text{Null}({X}^{T}{Y}^{T})$ for all compatible matrices $X$ and $Y?$\n\nI. $\\text{Null}(YX)$\n\nII. $\\text{Col}({X}^{T}{Y}^{T})$\n\nIII. $\\text{Col}(YX)$" :question/worked-solution "Recall that $\\text{Null}({X}^{T}{Y}^{T})$ contains all vectors that, when pre-multiplied by ${X}^{T}{Y}^{T},$ result in the zero-vector $0.$ \n\nWhen pre-multiplying a vector by ${X}^{T}{Y}^{T},$ we actually multiply each row of ${X}^{T}{Y}^{T}$ by that vector. So, $\\text{Null}({X}^{T}{Y}^{T})$ must be orthogonal to the row space of ${X}^{T}{Y}^{T},$ which is $\\text{Col}(({X}^{T}{Y}^{T})^{T})=\\text{Col}(YX).$\n\nTherefore, the correct answer is \"III only.\"\n\n**Note:** In general, the four fundamental subspaces of a matrix $A$ can be schematically visualized, as shown below.\n\n![](images/de/de22dd5b352e1d5be48f4b6ed3b2a4657ae623c1bd288d3464559758ea334af7.png)"}] [{:db/id #edb/ref 17592186362770 :knowledge-point/_questions [{:db/id #edb/ref 17592186133888 :knowledge-point/id #uuid "75e1da77-a5dc-5f78-977e-0d6dae99c97e" :knowledge-point/title "Identifying the Images of the Four Fundamental Subspaces of the Matrix Under Its Action"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ab280a44-737b-5327-b8b9-37dc6ef7b3be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{6}" :db/id #edb/ref 17592186362772} {:answer/id #uuid "d5d452ec-369b-54d1-8357-79ad02025a07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{4}" :db/id #edb/ref 17592186362773} {:answer/id #uuid "99ca8573-a2e6-558c-b3c7-031132e63ac3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Null}({A}^{T})" :db/id #edb/ref 17592186362774} {:answer/id #uuid "f3e2aca3-e8c2-5d00-b0bc-0cf40e3489e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Col}({A}^{T})" :db/id #edb/ref 17592186362775} {:answer/id #uuid "887d2b50-662a-542d-9779-a9834c4a9b0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186362776}] :answer-field/correct {:answer/id #uuid "f3e2aca3-e8c2-5d00-b0bc-0cf40e3489e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Col}({A}^{T})" :db/id #edb/ref 17592186362775} :answer-field/id #uuid "bb6ed2ff-8856-5c19-ae37-a59672f92f3b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186362771}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1f5df99f-1d28-5975-9513-4422bec5dfb5" :question/math-academy-id "q-109860" :question/problem "Let $A$ be a $4\\times 6$ matrix. What is the image of ${R}^{4}$ under the action of ${A}^{T}?$" :question/worked-solution "First, notice that ${A}^{T}$ is a $6\\times 4$ matrix.\n\nPre-multiplying a vector $x\\in {R}^{4}$ by ${A}^{T}$ gives a linear combination of the columns of ${A}^{T}:$\n\n$$\n{{\\begin{bmatrix}| & | & | & | \\\\ {a}_{1}^{T} & {a}_{2}^{T} & {a}_{3}^{T} & {a}_{4}^{T} \\\\ | & | & | & |\\end{bmatrix}}_{⏟}}_{{A}^{T}}\\cdot {{\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3} \\\\ {x}_{4}\\end{bmatrix}}_{⏟}}_{x}={x}_{1}\\begin{bmatrix}| \\\\ {a}_{1}^{T} \\\\ |\\end{bmatrix}+{x}_{2}\\begin{bmatrix}| \\\\ {a}_{2}^{T} \\\\ |\\end{bmatrix}+{x}_{3}\\begin{bmatrix}| \\\\ {a}_{3}^{T} \\\\ |\\end{bmatrix}+{x}_{4}\\begin{bmatrix}| \\\\ {a}_{4}^{T} \\\\ |\\end{bmatrix}\n$$\n\nTherefore, the image of ${R}^{4}$ under the action of ${A}^{T}$ must be $\\text{Col}({A}^{T}),$ the row space of $A.$"}] [{:db/id #edb/ref 17592186476920 :knowledge-point/_questions [{:db/id #edb/ref 17592186133888 :knowledge-point/id #uuid "75e1da77-a5dc-5f78-977e-0d6dae99c97e" :knowledge-point/title "Identifying the Images of the Four Fundamental Subspaces of the Matrix Under Its Action"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31717965-8188-5614-b5bd-dd4dd34c9a60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{n}" :db/id #edb/ref 17592186476312} {:answer/id #uuid "403bca0a-677d-50cb-b10a-cd4b757641d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Col}({A}^{T}+{B}^{T})" :db/id #edb/ref 17592186476344} {:answer/id #uuid "5d1065b6-e4be-5ce4-9c44-479b99525728" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{m}" :db/id #edb/ref 17592186476411} {:answer/id #uuid "727a6de3-6a1e-54e5-a473-aa66302930e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Null}({A}^{T}+{B}^{T})" :db/id #edb/ref 17592186476464} {:answer/id #uuid "a6f3fa59-0a17-562e-a0aa-5241c84a1cc1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186476570}] :answer-field/correct {:answer/id #uuid "403bca0a-677d-50cb-b10a-cd4b757641d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Col}({A}^{T}+{B}^{T})" :db/id #edb/ref 17592186476344} :answer-field/id #uuid "eeeef6de-d8de-527e-81b4-5538bfa583c5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186476860}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "814b73ba-57d5-52a9-8c36-0c9f156faa4a" :question/math-academy-id "q-109863" :question/problem "Let $A$ and $B$ be $m\\times n$ matrices. What is the image of ${R}^{m}$ under the action of ${A}^{T}+{B}^{T}?$" :question/worked-solution "First, notice that ${A}^{T}+{B}^{T}$ is a $n\\times m$ matrix.\n\nNow, pre-multiplying a vector $x\\in {R}^{m}$ by ${A}^{T}+{B}^{T}$ gives a linear combination of the columns of ${A}^{T}+{B}^{T}:$\n\n$$\n{{\\begin{bmatrix}| & | & ⋯ & | \\\\ ({a}^{T}+{b}^{T})_{1} & ({a}^{T}+{b}^{T})_{2} & ⋯ & ({a}^{T}+{b}^{T})_{m} \\\\ | & | & ⋯ & |\\end{bmatrix}}_{⏟}}_{{A}^{T}+{B}^{T}}\\cdot {{\\begin{bmatrix}{x}_{1} \\\\ ⋮ \\\\ {x}_{m}\\end{bmatrix}}_{⏟}}_{x}={x}_{1}\\begin{bmatrix}| \\\\ ({a}^{T}+{b}^{T})_{1} \\\\ |\\end{bmatrix}+{x}_{2}\\begin{bmatrix}| \\\\ ({a}^{T}+{b}^{T})_{2} \\\\ |\\end{bmatrix}+⋯+{x}_{m}\\begin{bmatrix}| \\\\ ({a}^{T}+{b}^{T})_{m} \\\\ |\\end{bmatrix}\n$$\n\nTherefore, the image of ${R}^{m}$ under the action of ${A}^{T}+{B}^{T}$ must be $\\text{Col}({A}^{T}+{B}^{T}),$ the row space of $A+B.$"}] [{:db/id #edb/ref 17592186476871 :knowledge-point/_questions [{:db/id #edb/ref 17592186133887 :knowledge-point/id #uuid "1a36c7f7-4287-562b-94ea-047b38ede70f" :knowledge-point/title "Finding the Dimensions of the Four Fundamental Subspaces of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0da496da-39d4-5467-8ef4-2d29819ae5dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186476225} {:answer/id #uuid "49072a3f-f9fa-5790-946c-8dd612dd63c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186476357} {:answer/id #uuid "5a37659d-ffc5-541b-9c9c-a62a346075cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186476402} {:answer/id #uuid "62e07be3-aeb6-5604-a439-fca42c4eb3c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186476426} {:answer/id #uuid "ecd87db2-d45d-51ab-9b08-3ac6a96d531d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186476732}] :answer-field/correct {:answer/id #uuid "49072a3f-f9fa-5790-946c-8dd612dd63c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186476357} :answer-field/id #uuid "19162954-e902-549b-b60d-14561c8bf06c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186476769}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0027448d-1eb1-5ed1-bd4f-f6f90763ed8e" :question/math-academy-id "q-109872" :question/problem "Consider a $7\\times 8$ matrix $A.$ If $\\text{dim}(\\text{Col}(A))=4,$ then $\\text{dim}(\\text{Null}(A))=$" :question/worked-solution "The four fundamental subspaces of a matrix $A$ can be schematically visualized, as shown below.\n\n![](images/88/889b83fadd26b377c4dd34143c9b16541630c04e90de3d9b005e7147ead75ad5.png)\n\nIn our case, we are given that $m=7,$ $n=8,$ and $r=4.$ \n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{dim}(\\text{Null}(A)) & =n-r=8-4=4.\\end{aligned}\n$$"}]}
