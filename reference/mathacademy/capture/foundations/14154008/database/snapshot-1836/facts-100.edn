#{[17592186475634 #edb/ref 1080 "{\\int }_{{y}^{2}}^{2-{y}^{2}}{\\int }_{0}^{1}f(x,y)\\,\\text{d}x\\,\\text{d}y" #edb/ref 17592186045417] [17592186475634 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186475634 #edb/ref 1083 #uuid "80e58883-b2bd-5526-aaab-81ed5508956f" #edb/ref 17592186045417] [17592186475649 #edb/ref 1080 "\\operatorname{cos}⁡(\\frac{1}{2})-1" #edb/ref 17592186045417] [17592186475649 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186475649 #edb/ref 1083 #uuid "8a2dc93b-07d2-5d02-9f1c-9af81857b7f7" #edb/ref 17592186045417] [17592186475650 #edb/ref 1080 "\\operatorname{cos}⁡2-\\operatorname{cos}⁡(3\\operatorname{ln}⁡3-3)" #edb/ref 17592186045417] [17592186475650 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186475650 #edb/ref 1083 #uuid "8a9f9754-8306-5ac4-b4ad-620d9f3a59d6" #edb/ref 17592186045417] [17592186475661 #edb/ref 1080 "1-\\operatorname{cos}⁡(\\frac{1}{4})" #edb/ref 17592186045417] [17592186475661 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186475661 #edb/ref 1083 #uuid "923eb37f-43b5-5b42-9f6f-7c5f6423cc9c" #edb/ref 17592186045417] [17592186475683 #edb/ref 1080 "\\operatorname{cos}⁡2-\\operatorname{cos}⁡(8\\operatorname{ln}⁡2-4)" #edb/ref 17592186045417] [17592186475683 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186475683 #edb/ref 1083 #uuid "a28f7432-b412-5573-afe3-367aec0ba7b7" #edb/ref 17592186045417] [17592186475684 #edb/ref 1080 "\\operatorname{cos}⁡1-\\operatorname{cos}⁡(5\\operatorname{ln}⁡5-5)" #edb/ref 17592186045417] [17592186475684 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186475684 #edb/ref 1083 #uuid "a4ebc04f-9119-59a3-af0b-d5a0399f055f" #edb/ref 17592186045417] [17592186475691 #edb/ref 1080 "\\operatorname{cos}⁡(\\frac{1}{4})" #edb/ref 17592186045417] [17592186475691 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186475691 #edb/ref 1083 #uuid "a9e5f989-9f92-570