      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14154008/observations/step-q82196-22ebe3baf95b88b9f2b6.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14154008/observations/step-q82196-22ebe3baf95b88b9f2b6.png",
