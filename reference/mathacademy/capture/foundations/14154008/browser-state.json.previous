      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14154008/observations/step-q132573-a6da5c30ffed2eb89ee7.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14154008/observations/step-q132573-a6da5c30ffed2eb89ee7.png",
