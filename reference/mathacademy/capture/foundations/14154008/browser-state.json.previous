            {
              "option": "a",
              "dom_id": "questionWidget-choiceLetterCircle-132646-a",
              "type": "math",
              "value": "\\operatorname{cos}⁡2-\\operatorname{cos}⁡(3\\operatorname{ln}⁡3-3)",
