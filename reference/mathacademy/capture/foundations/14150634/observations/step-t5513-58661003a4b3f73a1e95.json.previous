002\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMATHI-72\" x=\"3780\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMAIN-28\" x=\"4232\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMATHI-50\" x=\"4621\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMAIN-2212\" x=\"5595\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMATHI-61\" x=\"6596\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMAIN-29\" x=\"7125\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMAIN-2C\" x=\"7515\" y=\"0\"></use>\n</g>\n</svg></span>\nand an inhibited decay initial value problem has the form\n<span class=\"mjpage mjpage__block\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"33.496ex\" height=\"5.509ex\" style=\"vertical-align: -2.005ex;\" viewBox=\"0 -1508.9 14421.6 2372\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-4-Title\">\n<title id=\"MathJax-SVG-4-Title\">\n\\dfrac{\\mathrm{d}P}{\\mathrm{d}t} = -r(P-a), \\qquad P(0) = P_0\n</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E4-MJMAIN-64\" d=\"M376 495Q376 511 376 535T377 568Q377 613 367 624T316 637H298V660Q298 683 300 683L310 684Q320 685 339 686T376 688Q393 689 413 690T443 693T454 694H457V390Q457 84 458 81Q461 61 472 55T517 46H535V0Q533 0 459 -5T380 -11H373V44L365 37Q307 -11 235 -11Q158 -11 96 50T34 215Q34 315 97 378T244 442Q319 442 376 393V495ZM373 342Q328 405 260 405Q211 405 173 369Q146 341 139 305T131 211Q131 155 138 120T173 59Q203 26 251 26Q322 26 373 103V342Z\"></path>\n<path stroke-width=\"1\" id=\"E4-MJMATHI-50\" d=\"M287 628Q287 635 230 637Q206 637 199 638T192 648Q192 649 194 659Q200 679 203 681T397 683Q587 682 600 680Q664 669 707 631T751 530Q751 453 685 389Q616 321 507 303Q500 302 402 301H307L277 182Q247 66 247 59Q247 55 248 54T255 50T272 48T305 46H336Q342 37 342 35Q342 19 335 5Q330 0 319 0Q316 0 282 1T182 2Q120 2 87 2T51 1Q33 1 33 11Q33 13 36 25Q40 41 44 43T67 46Q94 46 127 49Q141 52 146 61Q149 65 218 339T287 628ZM645 554Q645 567 643 575T634 597T609 619T560 635Q553 636 480 63