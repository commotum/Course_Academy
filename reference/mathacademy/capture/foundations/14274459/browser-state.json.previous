ce width=\"0.167em\"></mspace></mstyle><msub><mi>x</mi><mn>3</mn></msub><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mn>2</mn><mo>+</mo><mn>2</mn><mo>+</mo><mn>3</mn><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mn>12</mn><msub><mi>x</mi><mn>2</mn></msub><mo>+</mo><mn>6</mn><msqrt><mi>t</mi></msqrt><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><msub><mi>x</mi><mn>3</mn></msub><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>3</mn><mo stretchy=\"false\">(</mo><mo>−</mo><mn>6</mn><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><mn>2</mn><msub><mi>x</mi><mn>2</mn></msub><mo>−</mo><msqrt><mi>t</mi></msqrt><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><msub><mi>x</mi><mn>3</mn></msub><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mn>18</mn><mo stretchy=\"false\">(</mo><mn>2</mn><msub><mi>x</mi><mn>2</mn></msub><mo>−</mo><msqrt><mi>t</mi></msqrt><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><msub><mi>x</mi><mn>3</mn></msub><mo stretchy=\"false\">)</mo><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
