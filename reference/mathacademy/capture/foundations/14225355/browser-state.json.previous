      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14225355/observations/step-q139554-5f68a212f4e21153f903.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14225355/observations/step-q139554-5f68a212f4e21153f903.png",
      "source_url": "https://mathacademy.com/tasks/14225355/topics/3131/lesson",
      "captured_at": 1792048853.2325625,
      "math_academy_id": "q-139554",
