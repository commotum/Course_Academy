72f-dc506b7dc1e0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186549868} {:answer-field/choices [{:answer/id #uuid "0b080894-e225-574e-b611-6de778384829" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi }^{\\pi }{e}^{-{x}^{2}}\\,\\text{d}x" :db/id #edb/ref 17592186549333} {:answer/id #uuid "16362305-1448-5d7f-841f-42942c9f6ad0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi }^{\\pi }{e}^{-{x}^{2}}\\operatorname{cos}⁡(6x)\\,\\text{d}x" :db/id #edb/ref 17592186549358} {:answer/id #uuid "20a6260d-a64c-5771-b68c-fd4b972f15c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-5}^{5}{e}^{-{x}^{2}}\\operatorname{cos}⁡(\\frac{6\\pi }{5}x)\\,\\text{d}x" :db/id #edb/ref 17592186549382} {:answer/id #uuid "23121dd1-c0fc-5a11-a114-b71f188cf2bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-5}^{5}{e}^{-{x}^{2}}\\operatorname{sin}⁡(\\frac{6\\pi }{5}x)\\,\\text{d}x" :db/id #edb/ref 17592186549386} {:answer/id #uuid "84ff721d-5ea1-5783-b823-a370c88ce292" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi }^{\\pi }{e}^{-{x}^{2}}\\operatorname{sin}⁡(6x)\\,\\text{d}x" :db/id #edb/ref 17592186549562} {:answer/id #uuid "873e0942-50fd-5a7c-91e2-3b1957f1bed0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-5}^{5}{e}^{-{x}^{2}}\\,\\text{d}x" :db/id #edb/ref 17592186549569}] :answer-field/correct {:answer/id #uuid "20a6260d-a64c-5771-b68c-fd4b972f15c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-5}^{5}{e}^{-{x}^{2}}\\operatorname{cos}⁡(\\frac{6\\pi }{5}x)\\,\\text{d}x" :db/id #edb/ref 17592186549382} :answer-field/id #uuid "f064fef8-a113-5d06-b95a-f4c517e2b24e" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186549913}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fb364528-cf72-5941-b3b8-fc021ca9ace0" :question/math-academy-id "q-341777" :question/problem "Let $f(x)$ be the $2L$-periodic extension of a function $F(x)$ from $x\\in [-L,L)$ to $x\\in R.$\nSelect the correct options in the reasoning below.\n\nThe Fourier series of $f$ is given by\n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡({{field-1}})+{b}_{n}\\operatorname{sin}⁡({{field-2}}).\n$$\n\nThe $6$th cosine coefficient of the series is\n\n$$\n{a}_{6}={{field-3}}.\n$$\n\nGiven that $F(x)={e}^{-{x}^{2}}$ and $L=5,$ the $6$th cosine coefficient becomes\n\n$$\n{a}_{6}={{field-4}}\\,\\cdot \\,{{field-5}}.\n$$" :question/worked-solution "Recall that multiplying the argument of a function by $k\\ne 0$ represents the horizontal stretching of the corresponding graph by a factor of $\\frac{1}{k}.$\n\nNow, let $s=\\frac{\\pi }{L}x.$ Then, since $f(x)$ has a period of $2L,$ the function\n\n$$\ng(s)=f(\\frac{L}{\\pi }s)\n$$\n\nmust have a period of $2L\\cdot \\frac{\\pi }{L}=2\\pi .$ \n\nThe Fourier series of $g(s)$ is\n\n$$\ng(s)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(ns)+{b}_{n}\\operatorname{sin}⁡(ns),\n$$\n\nwhere:\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }g(s)\\,\\text{d}s \\\\ {a}_{n} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }g(s)\\operatorname{cos}⁡(ns)\\,\\text{d}s,\\,n\\ge 1 \\\\ {b}_{n} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }g(s)\\operatorname{sin}⁡(ns)\\,\\text{d}s,\\,n\\ge 1\\end{aligned}\n$$\n\nSubstituting $s=\\frac{\\pi }{L}x$ and using the fact that $g(s)=f(\\frac{L}{\\pi }s),$ we get the Fourier series of $f(x):$\n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi }{L}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi }{L}x)\n$$\n\nTherefore, $6$th cosine coefficient of $f(x)$ is \n\n$$\n\\begin{aligned}{a}_{6} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }g(s)\\operatorname{cos}⁡(6s)\\,\\text{d}s \\\\  & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }f(\\frac{L}{\\pi }s)\\operatorname{cos}⁡(6s)\\,\\text{d}s \\\\  & =\\frac{1}{\\pi }{\\int }_{-L}^{L}f(\\frac{L}{\\pi }\\cdot \\frac{\\pi }{L}x)\\operatorname{cos}⁡(6\\cdot \\frac{\\pi }{L}x)\\,\\text{d}(\\frac{\\pi }{L}x) \\\\  & =\\frac{1}{\\pi }\\cdot \\frac{\\pi }{L}{\\int }_{-L}^{L}f(x)\\operatorname{cos}⁡(\\frac{6\\pi }{L}x)\\,\\text{d}x \\\\  & =\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\operatorname{cos}⁡(\\frac{6\\pi }{L}x)\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, substituting $L=5$ and $f(x)={e}^{-{x}^{2}},$ we get\n\n$$\n\\begin{aligned}{a}_{6} & =\\frac{1}{5}\\cdot {\\int }_{-5}^{5}{e}^{-{x}^{2}}\\operatorname{cos}⁡(\\frac{6\\pi }{5}x)\\,\\text{d}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186549980 :knowledge-point/_questions [{:db/id #edb/ref 17592186221443 :knowledge-point/id #uuid "12ff3452-19b6-566a-8b39-ad880dee8858" :knowledge-point/title "Identifying Effects of the Horizontal Scaling on Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15b65751-5861-527d-bc09-9b006f1be127" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi " :db/id #edb/ref 17592186549353} {:answer/id #uuid "1a28eb50-b541-56ea-95a2-94fb36b7667a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2\\pi }" :db/id #edb/ref 17592186549368} {:answer/id #uuid "87c51d20-54d4-5d38-ad70-48e324bd3f64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186549571} {:answer/id #uuid "efb64615-ad15-5206-89a7-d8638df10b16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :a