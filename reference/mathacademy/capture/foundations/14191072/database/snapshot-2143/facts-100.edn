-c4a9-54ce-be0a-26a5043158cf" #edb/ref 17592186045417] [17592186505603 #edb/ref 1080 "\\frac{4}{5}" #edb/ref 17592186045417] [17592186505603 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186505603 #edb/ref 1083 #uuid "ff4aa7f4-8cb5-5cc7-8654-d178bd47988c" #edb/ref 17592186045417] [17592186505635 #edb/ref 1075 #edb/ref 17592186505158 #edb/ref 17592186045417] [17592186505635 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186505635 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186505635 #edb/ref 1078 #edb/ref 17592186505158 #edb/ref 17592186045417] [17592186505635 #edb/ref 1079 #uuid "3719cd77-cf8e-5efe-870f-d9b67a741f79" #edb/ref 17592186045417] [17592186505640 #edb/ref 1075 #edb/ref 17592186505268 #edb/ref 17592186045417] [17592186505640 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186505640 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186505640 #edb/ref 1078 #edb/ref 17592186505268 #edb/ref 17592186045417] [17592186505640 #edb/ref 1079 #uuid "3dc0e4ad-a39d-502a-8eb5-af62880a7035" #edb/ref 17592186045417] [17592186505700 #edb/ref 1075 #edb/ref 17592186505603 #edb/ref 17592186045417] [17592186505700 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186505700 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186505700 #edb/ref 1078 #edb/ref 17592186505603 #edb/ref 17592186045417] [17592186505700 #edb/ref 1079 #uuid "be729943-ac78-5a58-a4af-33ce85ae0d28" #edb/ref 17592186045417] [17592186505744 #edb/ref 1068 #edb/ref 17592186505635 #edb/ref 17592186045417] [17592186505744 #edb/ref 1069 "q-342578" #edb/ref 17592186045417] [17592186505744 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186505744 #edb/ref 1071 "Consider the function $f(x)=8x-{x}^{4}$ and the point $P(1,7)$ that lies on $y=f(x).$ Given that $f(x)$ is invertible in the vicinity of $P,$ the slope of $y={f}^{-1}(x)$ at the point $(7,1)$ is$\\,${{field-1}}." #edb/ref 17592186045417] [17592186505744 #edb/ref 1072 #uuid "1fb55561-256d-590b-a263-00ef7bf01b04" #edb/ref 17592186045417] [17592186505744 #edb/ref 1074 "We start by calculating the derivative of $f$ at the point $(1,7).$\n\n$$\n\\begin{aligned}\\begin{aligned}f(x) & =8x-{x}^{4} \\\\ {f}^{′}(x) & =8-4{x}^{3} \\\\ {f}^{′}(1) & =4\\end{aligned}\\end{aligned}\n$$\n\nSince $(1,7)$ lies on $y=f(x),$ we know that the corresponding point $(7,1)$ lies on $y={f}^{-1}(x).$\n\nFurthermore, the slopes of the tangents to the two respective points are reciprocals. Therefore,\n\n$$\n\\begin{aligned}\\begin{aligned}{({f}^{-1})}^{′}(7) & =\\frac{1}{{f}^{′}({f}^{-1}(7))} \\\\  & =\\frac{1}{{f}^{′}(1)} \\\\  & =\\frac{1}{4}.\\end{aligned}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186505765 #edb/ref 1068 #edb/ref 17592186505700 #edb/ref 17592186045417] [17592186505765 #edb/ref 1069 "q-342598" #edb/ref 17592186045417] [17592186505765 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186505765 #edb/ref 1071 "Find ${(g\\cdot {f}^{-1})}^{′}(4)$ of the product of functions, given the following table of values of $f(x),{f}^{′}(x),g(x),$ and ${g}^{′}(x)$ at some points.\n\n| **$x$** | $f(x)$ | ${f}^{′}(x)$ | $g(x)$ | ${g}^{′}(x)$ |\n| --- | --- | --- | --- | --- |\n| $4$ | $1$ | $2$ | $-1$ | $\\frac{1}{2}$ |\n| $2$ | $4$ | $5$ | $3$ | $-2$ |\n\n${(g\\cdot {f}^{-1})}^{′}(4)=$\n{{field-1}}" #edb/ref 17592186045417] [17592186505765 #edb/ref 1072 #uuid "513e391c-326d-528e-9c7c-38c97cf324b3" #edb/ref 17592186045417] [17592186505765 #edb/ref 1074 "The formula for the derivative of the inverse ${f}^{-1}(x)$ is\n\n$$\n({f}^{-1})^{′}(x)=\\frac{1}{{f}^{′}({f}^{-1}(x))}.\n$$\n\nUsing this, and the product rule, the derivative of the function $g(x){f}^{-1}(x)$ is\n\n$$\n(g\\cdot {f}^{-1})^{′}(x)={g}^{′}(x){f}^{-1}(x)+\\frac{g(x)}{{f}^{′}({f}^{-1}(x))}.\n$$\n\nSubstituting $x=4,$ we have\n\n$$\n(g\\cdot {f}^{-1})^{′}(4)={g}^{′}(4){f}^{-1}(4)+\\frac{g(4)}{{f}^{′}({f}^{-1}(4))}.\n$$\n\nFrom the table, we obtain ${f}^{-1}(4)=2,$ $g(4)=-1,$ ${g}^{′}(4)=\\frac{1}{2},$ and ${f}^{′}(2)=5.$ Therefore,\n\n$$\n\\begin{aligned}(g\\cdot {f}^{-1})^{′}(4) & ={g}^{′}(4){f}^{-1}(4)+\\frac{g(4)}{{f}^{′}({f}^{-1}(4))} \\\\  & =\\frac{1}{2}\\cdot 2+\\frac{(-1)}{{f}^{′}(2)} \\\\  & =1+\\frac{(-1)}{5} \\\\  & =1-\\frac{1}{5} \\\\  & =\\frac{4}{5}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186505782 #edb/ref 1068 #edb/ref 17592186505640 #edb/ref 17592186045417] [17592186505782 #edb/ref 1069 "q-342615" #edb/ref 17592186045417] [17592186505782 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186505782 #edb/ref 1071 "Consider the function $f(x)=\\sqrt{x}.$ Given that $y=f(x)$ is invertible throughout its domain, determine $({f}^{-1})^{′}(2).$\n\n$({f}^{-1})^{′}(2)=$\n{{field-1}}" #edb/ref 17592186045417] [17592186505782 #edb/ref 1072 #uuid "70bc61eb-58b7-5349-9bef-f900f312799d" #edb/ref 17592186045417] [17592186505782 #edb/ref 1074 "To determine $({f}^{-1})^{′}(2),$ we use the following formula:\n\n$$\n{({f}^{-1})}^{′}(2)=\\frac{1}{{f}^{′}({f}^{-1}(2))}\n$$\n\nFirst, we calculate the value of ${f}^{-1}(2).$ To do this, we solve the equation ${f}^{-1}(2)=x.$ This gives\n\n$$\n\\begin{aligned}{f}^{-1}(2) & =x \\\\ f(x) & =2 \\\\ \\sqrt{x} & =2 \\\\ x & ={2}^{2} \\\\ x & =4.\\end{aligned}\n$$\n\nTherefore, we have ${f}^{-1}(2)=4.$\n\nNow, we calculate ${f}^{′}(4),$ as follows:\n\n$$\n\\begin{aligned}f(x) & =\\sqrt{x} \\\\ {f}^{′}(x) & =\\frac{1}{2\\sqrt{x}} \\\\ {f}^{′}(4) & =\\frac{1}{2\\sqrt{4}} \\\\ {f}^{′}(4) & =\\frac{1}{4}\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}{({f}^{-1})}^{′}(2) & =\\frac{1}{{f}^{′}({f}^{-1}(2))} \\\\  & =\\frac{1}{{f}^{′}(4)} \\\\  & =\\frac{1}{(\\frac{1}{4})} \\\\  & =4.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186505862 #edb/ref 1058 #edb/ref 17592186505880 #edb/ref 17592186045417] [17592186505862 #edb/ref 1062 #uuid "455e56d5-f225-535e-825f-94cbf70b48fc" #edb/ref 17592186045417] [17592186505862 #edb/r