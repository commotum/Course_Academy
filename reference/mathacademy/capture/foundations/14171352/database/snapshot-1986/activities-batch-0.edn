ef 17592186272286} {:db/id #edb/ref 17592186335905} {:db/id #edb/ref 17592186369133} {:db/id #edb/ref 17592186369140} {:db/id #edb/ref 17592186371160} {:db/id #edb/ref 17592186395918} {:db/id #edb/ref 17592186399774} {:db/id #edb/ref 17592186433673} {:db/id #edb/ref 17592186433676}] :knowledge-point/title "Identifying Possible Roots of a Polynomial Using the Rational Roots Theorem"} :step/id #uuid "0b52b9e4-cd28-50db-a889-bf6f2fd5e07e" :step/math-academy-id 27362 :step/next {:db/id #edb/ref 17592186084240}} {:db/id #edb/ref 17592186084245 :step/content {:db/id #edb/ref 17592186083310 :knowledge-point/canonical-example {:db/id #edb/ref 17592186083110 :question/id #uuid "e7c9c0d2-6af5-520a-8b56-4930780bc6df" :question/math-academy-id "e-7413"} :knowledge-point/id #uuid "001262b8-82b7-5421-80ac-8608b20d4be1" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048497}] :knowledge-point/questions [{:db/id #edb/ref 17592186083681} {:db/id #edb/ref 17592186083682} {:db/id #edb/ref 17592186233828} {:db/id #edb/ref 17592186233829} {:db/id #edb/ref 17592186234452} {:db/id #edb/ref 17592186247321} {:db/id #edb/ref 17592186247322} {:db/id #edb/ref 17592186292903} {:db/id #edb/ref 17592186302144} {:db/id #edb/ref 17592186302145} {:db/id #edb/ref 17592186326676} {:db/id #edb/ref 17592186326679} {:db/id #edb/ref 17592186326739} {:db/id #edb/ref 17592186351526} {:db/id #edb/ref 17592186351559} {:db/id #edb/ref 17592186369168} {:db/id #edb/ref 17592186369175} {:db/id #edb/ref 17592186370038} {:db/id #edb/ref 17592186370866} {:db/id #edb/ref 17592186433675}] :knowledge-point/title "Factoring a Cubic Polynomial Using the Rational Roots Theorem"} :step/id #uuid "1548a389-5cb1-572b-abf2-33279abef94e" :step/math-academy-id 27497}] :activity/title "The Rational Roots Theorem" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186083447}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186436918} :activity/id #uuid "1f7d750a-49b8-5dec-8954-584295b47047" :activity/scope {:db/id #edb/ref 17592186050429 :topic/id #uuid "486a09f3-45ae-5574-b216-0a329beb1dea" :topic/math-academy-id 757} :activity/steps [{:db/id #edb/ref 17592186436917 :step/content {:db/id #edb/ref 17592186234451 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34bfc3ba-449c-528d-88b0-6f1a8ead8ad2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186348923} {:answer/id #uuid "af6b758e-a4f3-5184-8f82-847476a988d7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186349996} {:answer/id #uuid "b0c900ac-0efe-5fde-9ee8-9f8185818850" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186350007} {:answer/id #uuid "b791b1f1-6e46-536c-99de-2068be805c17" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186350072} {:answer/id #uuid "f76f16cd-5491-5f45-a011-0e4b32a84811" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186350615}] :answer-field/correct {:db/id #edb/ref 17592186350007} :answer-field/id #uuid "bbdb52c0-0282-5bdb-8a53-fe9c6f8974e7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186351033}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d24742b9-e0e3-539d-a243-8418f31d72e5" :question/math-academy-id "q-83815" :question/problem "According to the rational roots theorem, which of the following **cannot** be a root of the polynomial $f(x)=2{x}^{3}+5{x}^{2}+x-3?$" :question/worked-solution "Given a polynomial with integer coefficients, the rational roots theorem states that any rational roots of the polynomial must take the form\n\n$$\n\\pm \\frac{\\text{factor of the constant term}}{\\text{factor of the leading coefficient}}.\n$$\n\nFor the given polynomial $f(x),$ the constant term is $-3$ and the leading coefficient is $2.$ So, any rational roots of $f(x)$ must take the form\n\n$$\n\\pm \\frac{\\text{factor of }-3}{\\text{factor of }2}.\n$$\n\nOf the given answer choices, only $2$ does not take the above form. The value $2$ can be interpreted as a fraction $\\frac{2}{1},$ and the numerator $(2)$ is not a factor of $-3.$"} :step/id #uuid "58e58414-042e-556c-946f-9319d6217a9e"} {:db/id #edb/ref 17592186436918 :step/content {:db/id #edb/ref 17592186233456 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "273c6dd0-67fe-528d-98c1-8dad19a58e5f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186436911} {:answer/id #uuid "4a0177fe-6f1f-5c81-84de-6277949370ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "24" :db/id #edb/ref 17592186436912} {:answer/id #uuid "8a571250-310b-5aff-b6f3-4de1c0dc69f2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186436913} {:answer/id #uuid "ad17155f-b4cd-54ec-8be4-28ea64a81659" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186436914} {:answer/id #uuid "b2275ff8-fe98-5084-bd82-ea5aaba7e949" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186436915}] :answer-field/correct {:db/id #edb/ref 17592186436912} :answer-field/id #uuid "6eafbdc9-1f3b-58eb-b092-b6276d35ea08" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186436916}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "66ae1650-566a-5bce-8d4c-8b63d98b0a02" :question/math-academy-id "q-14140" :question/problem "For the polynomial $f(x)=5{x}^{3}+2{x}^{2}-x+12,$ how many *potential* roots are given by the rational roots theorem?" :question/worked-solution "Given a polynomial with integer coefficients, the rational roots theorem states that any rational roots of the polynomial must take the form\n\n$$\n\\pm \\frac{\\text{factor of the constant term}}{\\text{factor of the leading coefficient}}.\n$$\n\nFor the given polynomial:\n\n- The constant term is $12,$ and its factors are $\\pm 1,\\,\\pm 2,\\,\\pm 3,\\,\\pm 4,\\,\\pm 6$ and $\\pm 12.$\n\n- The leading coefficient is $5,$ and its factors are $\\pm 1$ and $\\pm 5.$\n\nFirst, we list out all the possibilities for the numerator and denominator:\n\n$$\n\\begin{aligned}\\pm \\frac{1}{1}, & \\pm \\frac{1}{5}, \\\\ \\pm \\frac{2}{1}, & \\pm \\frac{2}{5}, \\\\ \\pm \\frac{3}{1}, & \\pm \\frac{3}{5}, \\\\ \\pm \\frac{4}{1}, & \\pm \\frac{4}{5}, \\\\ \\pm \\frac{6}{1}, & \\pm \\frac{6}{5}, \\\\ \\pm \\frac{12}{1}, & \\pm \\frac{12}{5}.\\end{aligned}\n$$\n\nNext, we reduce the fractions to lowest terms:\n\n$$\n\\begin{aligned}\\pm 1, & \\pm \\frac{1}{5}, \\\\ \\pm 2, & \\pm \\frac{2}{5}, \\\\ \\pm 3, & \\pm \\frac{3}{5}, \\\\ \\pm 4, & \\pm \\frac{4}{5}, \\\\ \\pm 6, & \\pm \\frac{6}{5}, \\\\ \\pm 12, & \\pm \\frac{12}{5}.\\end{aligned}\n$$\n\nNotice that none of these potential roots are duplicates. Listing those potential roots in order from least to greatest in absolute value, we have\n\n$$\n\\pm \\frac{1}{5},\\,\\pm \\frac{2}{5},\\,\\pm \\frac{3}{5},\\,\\pm \\frac{4}{5},\\,\\pm 1\\,\\pm \\frac{6}{5},\\,\\pm 2,\\,\\pm \\frac{12}{5},\\,\\pm 3,\\,\\pm 4,\\,\\pm 6,\\,\\pm 12.\n$$\n\nThis makes a total of $24$ potential roots. (Remember that each $\\pm $ sign accounts for $2$ roots, and $2\\cdot 12=24.$)"} :step/id #uuid "74fc6fe2-50c7-5458-827e-99d2e1df0a79" :step/next {:db/id #edb/ref 17592186436919}} {:db/id #edb/ref 17592186436919 :step/content {:db/id #edb/ref 17592186083681 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "135f42a4-d1ee-5f2c-af3a-0c8aa0176bf9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3}{5}" :db/id #edb/ref 17592186324143} {:answer/id #uuid "268df909-c8fb-563f-af2f-c08134584f25" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\sqrt{5}" :db/id #edb/ref 17592186324283} {:answer/id #uuid "69e770f2-5fac-5581-b92a-b1b948231e35" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{5}{3}" :db/id #edb/ref 17592186324857} {:answer/id #uuid "8b3c6363-b72d-5a0d-9eec-918fa9888a08" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186325152} {:answer/id #uuid "fc9d3f67-6d9d-5067-8456-4fe529f4d545" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186326194}] :answer-field/correct {:db/id #edb/ref 17592186324857} :answer-field/id #uuid "4f2953d1-fb0d-5e3e-8ec9-21bd1672c52d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186326351}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f572c08e-edf8-5f9d-9827-c106bc98ece4" :question/math-academy-id "q-39033" :question/problem "Given that the polynomial $f(x)=3{x}^{3}+5{x}^{2}-15x-25$ has one of its roots in the interval $(-2,-\\frac{1}{2}),$ find the sum of the distinct real roots of $f(x).$" :question/worked-solution "Given a polynomial with integer coefficients, the rational roots theorem states that any rational roots of the polynomial must take the form\n\n$$\n\\pm \\frac{\\text{factor of the constant term}}{\\text{factor of the leading coefficient}}.\n$$\n\nFor the given polynomial $f(x),$ the constant term is $-25$ and the leading coefficient is $3.$ So, any rational roots of $f(x)$ must take the form\n\n$$\n\\pm \\frac{\\text{factor of }-25}{\\text{factor of }3}.\n$$\n\nTherefore, the possible rational roots are as follows:\n\n$$\n\\pm 1,\\,\\pm 5,\\,\\pm 25,\\,\\pm \\frac{1}{3},\\,\\pm \\frac{5}{3},\\,\\pm \\frac{25}{3}\n$$\n\nOf these roots, the only roots in the interval $(-2,-\\frac{1}{2}),$ are $-1$ and $-\\frac{5}{3}.$\n\nNow, let's use synthetic division to test whether $(x+\\frac{5}{3})$ is a factor of $f(x).$ We get the following:\n\n|  | ${x}^{3}$ | ${x}^{2}$ | ${x}^{1}$ | ${x}^{0}$ |\n| --- | --- | --- | --- | --- |\n| $-\\frac{5}{3}$ | $3$ | $5$ | $-15$ | $-25$ |\n|  | $↓$ | $-5$ | $0$ | $25$ |\n|  | $3$ | $0$ | $-15$ | $0$ |\n\nSince the remainder is $0,$ we conclude that $(x+\\frac{5}{3})$ is indeed a factor of $f(x).$ Moreover, we have\n\n$$\nf(x)=(x+\\frac{5}{3})(3{x}^{2}-15).\n$$\n\nSince the highest-degree factor is now a quadratic, we can continue factoring using the usual methods:\n\n$$\n\\begin{aligned}f(x) & =(x+\\frac{5}{3})(3{x}^{2}-15) \\\\  & =3(x+\\frac{5}{3})({x}^{2}-5) \\\\  & =3(x+\\frac{5}{3})(x+\\sqrt{5})(x-\\sqrt{5})\\end{aligned}\n$$\n\nSetting the factors equal to $0,$ we find the roots $x=-\\frac{5}{3},-\\sqrt{5},\\sqrt{5}.$ Summing these roots, we get\n\n$$\n-\\frac{5}{3}-\\sqrt{5}+\\sqrt{5}=-\\frac{5}{3}.\n$$"} :step/id #uuid "7ff2104b-6a5b-5774-95cc-77db99183716" :step/next {:db/id #edb/ref 17592186436917}}] :activity/title "The Rational Roots Theorem" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186436910}]}
