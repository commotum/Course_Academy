6045417] [17592186485473 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186485473 #edb/ref 1078 #edb/ref 17592186484964 #edb/ref 17592186045417] [17592186485473 #edb/ref 1079 #uuid "f8b85cb0-51f8-5559-bd88-b78ed4af2dbf" #edb/ref 17592186045417] [17592186485506 #edb/ref 1068 #edb/ref 17592186485473 #edb/ref 17592186045417] [17592186485506 #edb/ref 1069 "q-177845" #edb/ref 17592186045417] [17592186485506 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186485506 #edb/ref 1071 "Let $Q$ be an orthogonal linear transformation. Find $‖Q(x)‖$, where $x=\\begin{bmatrix}-1 \\\\ 2 \\\\ -2\\end{bmatrix}.$" #edb/ref 17592186045443] [17592186485506 #edb/ref 1072 #uuid "222e2ed5-e7e4-55fe-9d04-24be2fce81e6" #edb/ref 17592186045417] [17592186485506 #edb/ref 1074 "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nThe linear transformation $Q$ being orthogonal is equivalent to the following:\n\n- The matrix $Q$ of transformation $Q$ relative to any orthonormal basis (including the standard basis) of ${R}^{n}$ is orthogonal.\n\n- $||Q(x)||=||x||.$\n\n- If $x⊥y$ then $Q(x)⊥Q(y)$ for any $x,y\\in {R}^{n}.$ In general, $Q$ preserves the angle between any two vectors.\n\n- $Q$ maps any orthogonal (orthonormal) set into an orthogonal (orthonormal) set.\n\nIn this case, since $Q$ is orthogonal, we have \n\n$$\n\\begin{aligned}‖Q(x)‖ & =‖x‖ \\\\  & =\\sqrt{{x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2}} \\\\  & =\\sqrt{(-1)^{2}+{2}^{2}+(-2)^{2}} \\\\  & =3.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186485518 #edb/ref 1068 #edb/ref 17592186485393 #edb/ref 17592186045417] [17592186485518 #edb/ref 1069 "q-40515" #edb/ref 17592186045417] [17592186485518 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186485518 #edb/ref 1071 "Let $Q$ be an orthogonal linear transformation. Which of the following are orthogonal sets?\n\nI. $U=\\{Q(\\begin{bmatrix}4 \\\\ 3\\end{bmatrix}),Q(\\begin{bmatrix}5 \\\\ -1\\end{bmatrix})\\}$\n\nII. $V=\\{Q(\\begin{bmatrix}1 \\\\ 2 \\\\ 3\\end{bmatrix}),Q(\\begin{bmatrix}3 \\\\ -2 \\\\ \\frac{1}{3}\\end{bmatrix}),Q(\\begin{bmatrix}2 \\\\ 4 \\\\ 6\\end{bmatrix})\\}$\n\nIII. $W=\\{Q(\\begin{bmatrix}5 \\\\ -3\\end{bmatrix}),Q(\\begin{bmatrix}-3 \\\\ -5\\end{bmatrix})\\}$" #edb/ref 17592186045443] [17592186485518 #edb/ref 1072 #uuid "3a3b6415-46fa-5ac6-8f1e-cce0985c5f71" #edb/ref 17592186045417] [17592186485518 #edb/ref 1074 "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nLet's denote the elements of $U,W,$ and $V$ respectively as \n\n$\\,$ $\\{Q({u}_{1}),Q({u}_{2})\\},\\,$ $\\{Q({v}_{1}),Q({v}_{2}),Q({v}_{3})\\},\\,$ and $\\,\\{Q({w}_{1}),Q({w}_{2})\\}.$\n\nThe sets $U,V,$ and $W$ are orthogonal if the following conditions on each set hold:\n\n- $Q({u}_{1})\\cdot Q({u}_{2})=0.$\n\n- $Q({v}_{1})\\cdot Q({v}_{2})=0,\\,Q({v}_{1})\\cdot Q({v}_{3})=0,\\,Q({v}_{2})\\cdot Q({v}_{3})=0.$\n\n- $Q({w}_{1})\\cdot Q({w}_{2})=0.$\n\nWith that in mind, let's examine our sets in turn.\n\n- For the set $U,$ we get \n\n$$\n\\begin{aligned}Q({u}_{1})\\cdot Q({u}_{2}) & ={u}_{1}\\cdot {u}_{2}=\\begin{bmatrix}4 \\\\ 3\\end{bmatrix}\\cdot \\begin{bmatrix}5 \\\\ -1\\end{bmatrix}=20-3=17\\ne 0.\\,\\times \\end{aligned}\n$$\n\nSo, $U$ is not and orthogonal set.\n\n- For the Set $V,$ notice that \n\n$$\n\\begin{aligned}Q({v}_{1})\\cdot Q({v}_{2}) & ={v}_{1}\\cdot {v}_{2}=\\begin{bmatrix}1 \\\\ 2 \\\\ 3\\end{bmatrix}\\cdot \\begin{bmatrix}3 \\\\ -2 \\\\ \\frac{1}{3}\\end{bmatrix}=3-4+1=0,\\,✓ \\\\ Q({v}_{1})\\cdot Q({v}_{3}) & ={v}_{1}\\cdot {v}_{3}=\\begin{bmatrix}1 \\\\ 2 \\\\ 3\\end{bmatrix}\\cdot \\begin{bmatrix}2 \\\\ 4 \\\\ 6\\end{bmatrix}=2+8+18=28\\ne 0.\\,\\times \\end{aligned}\n$$\n\nSo, $V$ is not an orthogonal set.\n\n- For the set $W,$ we get \n\n$$\n\\begin{aligned}Q({w}_{1})\\cdot Q({w}_{2}) & ={w}_{1}\\cdot {w}_{2}=\\begin{bmatrix}5 \\\\ -3\\end{bmatrix}\\cdot \\begin{bmatrix}-3 \\\\ -5\\end{bmatrix}=-15+15=0.\\,✓\\end{aligned}\n$$\n\nSo, the set $W$ is orthogonal.\n\nTherefore, the correct answer is \"$W$ only\"." #edb/ref 17592186045443] [17592186485595 #edb/ref 1068 #edb/ref 17592186485448 #edb/ref 17592186045417] [17592186485595 #edb/ref 1069 "q-140567" #edb/ref 17592186045417] [17592186485595 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186485595 #edb/ref 1071 "Let $Q$ be an orthogonal linear transformation. Which of the following are orthogonal sets?\n\nI. $U=\\{Q(\\begin{bmatrix}2 \\\\ 5\\end{bmatrix}),Q(\\begin{bmatrix}-2 \\\\ 5\\end{bmatrix})\\}$\n\nII. $V=\\{Q(\\begin{bmatrix}-1 \\\\ \\sqrt{5} \\\\ -2\\end{bmatrix}),Q(\\begin{bmatrix}0 \\\\ 2 \\\\ \\sqrt{5}\\end{bmatrix}),Q(\\begin{bmatrix}2 \\\\ 0 \\\\ 1\\end{bmatrix})\\}$\n\nIII. $W=\\{Q(\\begin{bmatrix}2 \\\\ 5\\end{bmatrix}),Q(\\begin{bmatrix}-5 \\\\ 2\\end{bmatrix})\\}$" #edb/ref 17592186045443] [17592186485595 #edb/ref 1072 #uuid "fd59782d-c853-5fe4-812d-f8b2814488a9" #edb/ref 17592186045417] [17592186485595 #edb/ref 1074 "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nLet's denote the elements of $U,W,$ and $V$ respectively as \n\n$\\,$ $\\{Q({u}_{1}),Q({u}_{2})\\},\\,$ $\\{Q({v}_{1}),Q({v}_{2}),Q({v}_{3})\\},\\,$ and $\\,\\{Q({w}_{1}),Q({w}_{2})\\}.$\n\nThe sets $U,V,$ and $W$ are orthogonal if the following conditions on each set hold:\n\n- $Q({u}_{1})\\cdot Q({u}_{2})=0.$\n\n- $Q({v}_{1})\\cdot Q({v}_{2})=0,\\,Q({v}_{1})\\cdot Q({v}_{3})=0,\\,Q({v}_{2})\\cdot Q({v}_{3})=0.$\n\n- $Q({w}_{1})\\cdot Q({w}_{2})=0.$\n\nWith that in mind, let's examine our sets in turn.\n\n- For the set $U,$ we get \n\n$$\n\\begin{aligned}Q({u}_{1})\\cdot Q({u}_{2}) & ={u}_{1}\\cdot {u}_{2}=\\begin{bmatrix}2 \\\\ 5\\end{bmatrix}\\cdot \\begin{bmatrix}-2 \\\\ 5\\end{bmatrix}=-4+25=21\\ne 0.\\,\\times \\end{aligned}\n$$\n\nSo, $U$ is not an orthogonal set.\n\n- For the Set $V,$ notice that \n\n$$\n\\begin{aligned}Q({v}_{1})\\cdot Q({v}_{2}) & ={v}_{1}\\cdot {v}_{2}=\\begin{bmatrix}-1 \\\\ \\sqrt{5} \\\\ -2\\end{bmatrix}\\cdot \\begin{bmatrix}0 \\\\ 2 \\\\ \\sqrt{5}\\end{bmatrix}=0+2\\sqrt{5}-2\\sqrt{5}=0,\\,✓ \\\\ Q({v}_{1})\\cdot Q({v}_{3}) & ={v}_{1}\\cdot {v}_{3}=\\begin{bmatrix}-1 \\\\ \\sqrt{5} \\\\ -2\\end{bmatrix}\\cdot \\begin{bmatrix}2 \\\\ 0 \\\\ 1\\end{bmatrix}=-2+0-2=-4.\\,\\times  \\\\ {v}_{2}\\cdot {v}_{3} & =\\begin{bmatrix}0 \\\\ 2 \\\\ \\sqrt{5}\\end{bmatrix}\\cdot \\begin{bmatrix}2 \\\\ 0 \\\\ 1\\end{bmatrix}=0+0+\\sqrt{5}=\\sqrt{5}\\ne 0.\\,\\times \\end{aligned}\n$$\n\nSo, $V$ is not an orthogonal set.\n\n- For the set $W,$ we get \n\n$$\n\\begin{aligned}Q({w}_{1})\\cdot Q({w}_{2}) & ={w}_{1}\\cdot {w}_{2}=\\begin{bmatrix}2 \\\\ 5\\end{bmatrix}\\cdot \\begin{bmatrix}-5 \\\\ 2\\end{bmatrix}=-10+10=0.\\,✓\\end{aligned}\n$$\n\nSo, the set $W$ is orthogonal.\n\nTherefore, the correct answer is \"$W$ only\"." #edb/ref 17592186045443] [17592186525204 #edb/ref 1043 #edb/ref 17592186526116 #edb/ref 17592186045417] [17592186525204 #edb/ref 1043 #edb/ref 17592186526134 #edb/ref 17592186045417] [17592186525204 #edb/ref 1043 #edb/ref 17592186526141 #edb/ref 17592186045417] [17592186525204 #edb/ref 1043 #edb/ref 17592186526149 #edb/ref 17592186045417] [17592186525204 #edb/ref 1043 #edb/ref 17592186526152 #edb/ref 17592186045417] [17592186525204 #edb/ref 1044 #edb/ref 17592186045464 #edb/ref 17592186045417] [17592186525204 #edb/ref 1045 "Orthogonal Linear Transformations" #edb/ref 17592186045417] [17592186525204 #edb/ref 1046 #edb/ref 17592186526141 #edb/ref 17592186045417] [17592186525204 #edb/ref 1048 #edb/ref 17592186046658 #edb/ref 17592186045417] [17592186525204 #edb/ref 1049 #edb/ref 17592186050910 #edb/ref 17592186045417] [17592186525204 #edb/ref 1053 #uuid "b5fdd510-3d9c-5c69-b136-99b69b48095e" #edb/ref 17592186045417] [17592186525269 #edb/ref 1080 "None of the statements are true." #edb/ref 17592186045417] [17592186525269 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592