#{[{:db/id #edb/ref 17592186088223 :knowledge-point/_questions [{:db/id #edb/ref 17592186087875 :knowledge-point/id #uuid "41bccbd5-3d0c-5f00-b506-97b8f83c5472" :knowledge-point/title "Solving a Second-Order Inhomogeneous ODE with Quadratic Forcing"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81cc546e-6ee9-581c-a55e-9944c5ff8e2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y_{p} =-x^{2} + 2x + 3" :db/id #edb/ref 17592186085993} {:answer/id #uuid "bf6efea9-2618-568a-8b66-4b1178d563cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y_{p} = 2x^{2} - x + 6" :db/id #edb/ref 17592186085994} {:answer/id #uuid "1e978853-3633-5fe0-98f4-32dfa6beba5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y_{p} =-x^{2} + 3x - 6" :db/id #edb/ref 17592186085995} {:answer/id #uuid "24085b70-9d5a-5784-8a9c-0af91c78a5fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y_{p} = x^{2} + x + 6" :db/id #edb/ref 17592186085996} {:answer/id #uuid "7da978a5-3be4-5434-988a-7dd5d8829a4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y_{p} = x^{2} - 3x - 2" :db/id #edb/ref 17592186085997}] :answer-field/id #uuid "9dac09d1-080f-56f1-a3f4-362ae1f4d608" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186085992} {:answer-field/choices [{:answer/id #uuid "6e4b1bd9-a788-5338-b6a3-0321efca35f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{p}=-{x}^{2}+3x-6" :db/id #edb/ref 17592186403107} {:answer/id #uuid "7b3a8c12-b522-5cd4-80bc-d4e5e857d33f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{p}={x}^{2}+x+6" :db/id #edb/ref 17592186403108} {:answer/id #uuid "56190e71-ba59-515b-a03d-ccc2b7e5bdcb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{p}=2{x}^{2}-x+6" :db/id #edb/ref 17592186403109} {:answer/id #uuid "ff1d2035-a1c4-5242-b59f-70997c2bf914" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{p}={x}^{2}-3x-2" :db/id #edb/ref 17592186403110} {:answer/id #uuid "dfb4f8b5-aafd-5f68-a0c9-e62da167d11f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{p}=-{x}^{2}+2x+3" :db/id #edb/ref 17592186403111}] :answer-field/correct {:answer/id #uuid "dfb4f8b5-aafd-5f68-a0c9-e62da167d11f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{p}=-{x}^{2}+2x+3" :db/id #edb/ref 17592186403111} :answer-field/id #uuid "62409f98-64c5-5617-a551-69fb536c4027" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403106}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "43efe1d0-c638-55a1-8bd9-f43f26e2bc24" :question/math-academy-id "q-64206" :question/problem "Given that the differential equation \n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+4\\frac{\\text{d}y}{\\text{d}x}-12y=12{x}^{2}-32x-30\n$$\n\nhas the complementary function ${y}_{c}(x)=A{e}^{2x}+B{e}^{-6x}$, find the particular solution ${y}_{p}(x)$ to this equation." :question/worked-solution "The right-hand side of the inhomogeneous equation is a polynomial of degree $2.$ Therefore, we assume that the particular solution is also a polynomial of degree $2,$ i.e.\n\n$$\n{y}_{p}(x)=\\alpha {x}^{2}+\\beta x+\\gamma \n$$\n\nwhere $\\alpha ,$ $\\beta ,$ and $\\gamma $ are constants that are to be determined. \n\nCalculating the first and second derivatives of ${y}_{p}$ gives:\n\n$$\n\\frac{\\text{d}{y}_{p}}{\\text{d}x}=2\\alpha x+\\beta ,\\,\\frac{{\\text{d}}^{2}{y}_{p}}{\\text{d}{x}^{2}}=2\\alpha \n$$\n\nTo find the values of $\\alpha ,$ $\\beta $ and $\\gamma ,$ we substitute the derivatives into the differential equation:\n\n$$\n2\\alpha +4(2\\alpha x+\\beta )-12(\\alpha {x}^{2}+\\beta x+\\gamma )=12{x}^{2}-32x-30\n$$\n\nGrouping the terms on the left-hand side gives:\n\n$$\n-12\\alpha {x}^{2}+(8\\alpha -12\\beta )x+(2\\alpha +4\\beta -12\\gamma )=12{x}^{2}-32x-30\n$$\n\nEquating the coefficients, we get the following system of equations:\n\n$$\n\\begin{aligned}{\\begin{aligned}-12\\alpha =12\\, & (\\text{equating the coefficients of}\\,\\,{x}^{2}) \\\\ 8\\alpha -12\\beta =-32\\, & (\\text{equating the coefficients of}\\,\\,x) \\\\ 2\\alpha +4\\beta -12\\gamma =-30\\, & (\\text{equating the constants})\\end{aligned}\\end{aligned}\n$$\n\nSolving this system gives $\\alpha =-1,\\beta =2,\\gamma =3.$\n\nTherefore, the particular integral ${y}_{p}(x)$ is\n\n$$\n{y}_{p}(x)=-{x}^{2}+2x+3.\n$$"}] [{:db/id #edb/ref 17592186371091 :knowledge-point/_questions [{:db/id #edb/ref 17592186087876 :knowledge-point/id #uuid "13078271-6d31-5476-8a81-d4fd714a2644" :knowledge-point/title "Solving an Initial Value Problem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c99d53a9-e3cd-5940-92bd-1ac167fee043" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-{e}^{-2x}+2{e}^{4x}-2x+1" :db/id #edb/ref 17592186371093} {:answer/id #uuid "0194c198-f1ba-5188-a3b2-8be3db8cc0cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-3{e}^{-2x}-{e}^{4x}+3x+2" :db/id #edb/ref 17592186371094} {:answer/id #uuid "e9322655-e73f-5cbe-9415-3c468c5fccf7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2{e}^{-x}+{e}^{-3x}-2x+1" :db/id #edb/ref 17592186371095} {:answer/id #uuid "d28e37d2-b4e2-571c-994c-728cba570d9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{-x}+4{e}^{-3x}+3x+2" :db/id #edb/ref 17592186371096} {:answer/id #uuid "0219f8c0-8746-5f02-a66a-b7d3eee1308d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2{e}^{-2x}+3{e}^{4x}-2x+1" :db/id #edb/ref 17592186371097}] :answer-field/correct {:answer/id #uuid "c99d53a9-e3cd-5940-92bd-1ac167fee043" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-{e}^{-2x}+2{e}^{4x}-2x+1" :db/id #edb/ref 17592186371093} :answer-field/id #uuid "ca78cc66-c01e-58dd-9a61-3727fb6f5bbd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186371092}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7eb42f98-90c1-5eda-85e2-0c63eff353a9" :question/math-academy-id "q-7900" :question/problem "Solve the initial value problem\n\n$$\n{y}^{″}-2{y}^{′}-8y=16x-4,\\,y(0)=2,\\text{ }\\text{ }{y}^{′}(0)=8.\n$$" :question/worked-solution "First, we need to find the complementary function ${y}_{c}(x),$ which is the solution to the homogeneous equation\n\n$$\n{y}^{″}-2{y}^{′}-8y=0.\n$$\n\nWriting down and solving the auxiliary equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}-2\\lambda -8 & =0 \\\\ (\\lambda -4)(\\lambda +2) & =0.\\end{aligned}\n$$\n\nSo $\\lambda =-2$ or $\\lambda =4$, and therefore the complementary function ${y}_{c}$ is\n\n$$\ny=A{e}^{-2x}+B{e}^{4x}.\n$$\n\nWe now need to find the particular integral ${y}_{p}(x).$\n\nThe right-hand side of the inhomogeneous equation is a polynomial of degree $1.$ Therefore, we assume that the particular integral is also a polynomial of degree $1,$ i.e.\n\n$$\n{y}_{p}(x)=\\alpha x+\\beta \n$$\n\nwhere $\\alpha $ and $\\beta $ are constants that are to be determined. \n\nCalculating the first and second derivatives of ${y}_{p}$ gives\n\n$$\n{y}_{p}^{′}=\\alpha ,\\,{y}_{p}^{″}=0.\n$$\n\nTo find the values of $\\alpha $ and $\\beta ,$ we substitute the derivatives into the differential equation:\n\n$$\n0-2\\alpha -8(\\alpha x+\\beta )=16x-4\n$$\n\nGrouping the terms on the left-hand side gives\n\n$$\n-8\\alpha x-(2\\alpha +8\\beta )=16x-4.\n$$\n\nEquating the coefficients, we get the following system of equations:\n\n$$\n\\begin{aligned}{\\begin{aligned}-8\\alpha =16\\, & (\\text{equating the coefficients of}\\,\\,x) \\\\ 2\\alpha +8\\beta =4\\, & (\\text{equating the constants})\\end{aligned}\\end{aligned}\n$$\n\nSolving this system gives $\\alpha =-2,\\beta =1.$\n\nTherefore, the particular integral ${y}_{p}(x)$ is\n\n$$\n{y}_{p}(x)=-2x+1.\n$$\n\nThe general solution is given by\n\n$$\ny(x)={y}_{c}(x)+{y}_{p}(x),\n$$\n\nand therefore, the general solution in our case is\n\n$$\ny=A{e}^{-2x}+B{e}^{4x}-2x+1.\n$$\n\nNow let's find the constants $A$ and $B.$ \n\nSubstituting $y(0)=2$ into the general solution gives\n\n$$\nA+B=1.\n$$\n\nWe now need to apply the condition ${y}^{′}(0)=8.$ First, we differentiate $y$ to find ${y}^{′}:$\n\n$$\n{y}^{′}=-2A{e}^{-2x}+4B{e}^{4x}-2\n$$\n\nSubstituting ${y}^{′}(0)=8$ into the above gives\n\n$$\n-2A+4B=10.\n$$\n\nTherefore, we have the following system of equations for $A$ and $B:$\n\n$$\n{\\begin{aligned}A+B=1 \\\\ -2A+4B=10\\end{aligned}\n$$\n\nSolving this system gives $A=-1,B=2.$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=-{e}^{-2x}+2{e}^{4x}-2x+1.\n$$"}] [{:db/id #edb/ref 17592186371112 :knowledge-point/_questions [{:db/id #edb/ref 17592186087874 :knowledge-point/id #uuid "d86b46c0-e30d-525b-b84e-f8296c78aa8b" :knowledge-point/title "Solving a Second-Order Inhomogeneous ODE with Affine Forcing"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44ea37fc-b3b6-5e0f-b118-0785b2b7a35a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{-x}(P\\operatorname{cos}⁡2x+Q\\operatorname{sin}⁡2x)+3x+1" :db/id #edb/ref 17592186371114} {:answer/id #uuid "e49653a9-dd2d-51bf-bd9d-5842cb840b4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{2x}(P\\operatorname{cos}⁡3x+Q\\operatorname{sin}⁡3x)+3x+1" :db/id #edb/ref 17592186371115} {:answer/id #uuid "ba043dd9-87a7-5698-8627-c0ea7930279c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{-x}(P\\operatorname{cos}⁡2x+Q\\operatorname{sin}⁡2x)+2x-3" :db/id #edb/ref 17592186371116} {:answer/id #uuid "e4ee0dc8-6c03-5f38-91c3-4560dc41ea14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{2x}(P\\operatorname{cos}⁡3x+Q\\operatorname{sin}⁡3x)+x+3" :db/id #edb/ref 17592186371117} {:answer/id #uuid "ffe728d0-4e52-55b2-a24a-c60915ca9413" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{2x}(P\\operatorname{cos}⁡3x+Q\\operatorname{sin}⁡3x)+2x-3" :db/id #edb/ref 17592186371118}] :answer-field/correct {:answer/id #uuid "e49653a9-dd2d-51bf-bd9d-5842cb840b4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{2x}(P\\operatorname{cos}⁡3x+Q\\operatorname{sin}⁡3x)+3x+1" :db/id #edb/ref 17592186371115} :answer-field/id #uuid "f595e04a-614b-5d7a-9cbf-9e5ecfb07f11" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186371113}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "21fd8f0b-3109-5022-9a47-313751ce31ce" :question/math-academy-id "q-8033" :question/problem "Find the general solution to the equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}-4\\frac{\\text{d}y}{\\text{d}x}+13y=39x+1.\n$$" :question/worked-solution "First, we need to find the complementary function ${y}_{c}(x),$ which is the solution to the homogeneous equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}-4\\frac{\\text{d}y}{\\text{d}x}+13y=0.\n$$\n\nWriting down and solving the auxiliary equation gives:\n\n$$\n\\begin{aligned}{\\lambda }^{2}-4\\lambda +13 & =0 \\\\ ({\\lambda }^{2}-4\\lambda +4)-4+13 & =0 \\\\ (\\lambda -2)^{2}+9 & =0 \\\\ (\\lambda -2)^{2} & =-9 \\\\ \\lambda -2 & =\\pm 3\\text{i} \\\\ \\lambda  & =2\\pm 3\\text{i}\\end{aligned}\n$$\n\nSo $\\lambda =2\\pm 3\\text{i}$, and therefore the complementary function ${y}_{c}(x)$ is\n\n$$\n{y}_{c}(x)={e}^{2x}(P\\operatorname{cos}⁡3x+Q\\operatorname{sin}⁡3x).\n$$\n\nWe now need to find the particular solution ${y}_{p}(x).$\n\nThe right-hand side of the inhomogeneous equation is a polynomial of degree $1.$ Therefore, we assume that the particular integral is also a polynomial of degree $1,$ i.e.\n\n$$\n{y}_{p}(x)=\\alpha x+\\beta \n$$\n\nwhere $\\alpha $ and $\\beta $ are constants that are to be determined. \n\nCalculating the first and second derivatives of ${y}_{p}$ gives:\n\n$$\n\\frac{\\text{d}{y}_{p}}{\\text{d}x}=\\alpha ,\\,\\frac{{\\text{d}}^{2}{y}_{p}}{\\text{d}{x}^{2}}=0\n$$\n\nTo find the values of $\\alpha $ and $\\beta ,$ we substitute the derivatives into the differential equation:\n\n$$\n0-4\\alpha +13(\\alpha x+\\beta )=39x+1\n$$\n\nGrouping the terms on the left-hand side gives\n\n$$\n13\\alpha x+(13\\beta -4\\alpha )=39x+1.\n$$\n\nEquating the coefficients, we get the following system of equations:\n\n$$\n\\begin{aligned}{\\begin{aligned}13\\alpha =39\\, & (\\text{equating the coefficients of}\\,\\,x) \\\\ 13\\beta -4\\alpha =1\\, & (\\text{equating the constants})\\end{aligned}\\end{aligned}\n$$\n\nSolving this system gives $\\alpha =3,\\beta =1.$\n\nTherefore, the particular solution ${y}_{p}(x)$ is\n\n$$\n{y}_{p}(x)=3x+1.\n$$\n\nThe general solution is given by\n\n$$\ny(x)={y}_{c}(x)+{y}_{p}(x),\n$$\n\nand therefore, the general solution in our case is\n\n$$\ny={e}^{2x}(P\\operatorname{cos}⁡3x+Q\\operatorname{sin}⁡3x)+3x+1.\n$$"}] [{:db/id #edb/ref 17592186357708 :knowledge-point/_questions [{:db/id #edb/ref 17592186087876 :knowledge-point/id #uuid "13078271-6d31-5476-8a81-d4fd714a2644" :knowledge-point/title "Solving an Initial Value Problem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ccfb431-8d63-5996-b9dd-56c7e2c91897" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2{e}^{-4x}-4x{e}^{-4x}-\\frac{1}{2}" :db/id #edb/ref 17592186355349} {:answer/id #uuid "672cae62-2b06-5798-accf-018bb4098775" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{-4x}-\\frac{1}{2}x{e}^{-4x}-\\frac{1}{2}" :db/id #edb/ref 17592186355579} {:answer/id #uuid "7351ba0a-f089-5b15-b307-93d1dafbe5f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{-4x}+2x{e}^{-4x}-\\frac{1}{2}" :db/id #edb/ref 17592186355680} {:answer/id #uuid "a207c9a6-bd25-52b5-a6bd-0bf7d6fcfcfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2{e}^{-4x}+\\frac{1}{3}x{e}^{-4x}-\\frac{1}{2}" :db/id #edb/ref 17592186356106} {:answer/id #uuid "a9b88408-feae-5731-87a6-b3bb0bdd717f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{-4x}+4x{e}^{-4x}-\\frac{1}{2}" :db/id #edb/ref 17592186356165}] :answer-field/correct {:answer/id #uuid "a9b88408-feae-5731-87a6-b3bb0bdd717f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{-4x}+4x{e}^{-4x}-\\frac{1}{2}" :db/id #edb/ref 17592186356165} :answer-field/id #uuid "5fc8e124-28b9-5e53-895c-b00b093ac14b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357079}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0975d216-0aaa-5035-b1c0-1872bde3d271" :question/math-academy-id "q-94258" :question/problem "Given that the differential equation \n\n$$\n{y}^{″}+8{y}^{′}+16y=-8\n$$\n\nhas the general solution\n\n$$\ny=A{e}^{-4x}+Bx{e}^{-4x}-\\frac{1}{2},\n$$\n\nsolve the initial value problem\n\n$$\n{y}^{″}+8{y}^{′}+16y=-8,\\,y(0)=\\frac{1}{2},\\,{y}^{′}(0)=0.\n$$" :question/worked-solution "We find the constants $A$ and $B$ using the initial conditions.\n\n- Substituting $y(0)=\\frac{1}{2}$ into the general solution gives\n\n$$\n\\begin{aligned}A-\\frac{1}{2} & =\\frac{1}{2} \\\\ A & =1.\\end{aligned}\n$$\n\n- To apply the condition ${y}^{′}(0)=0,$ we first differentiate $y$ to get\n\n$$\n{y}^{′}=-4A{e}^{-4x}+B{e}^{-4x}-4Bx{e}^{-4x},\n$$\n\nand then we substitute ${y}^{′}(0)=0$ into the above to get\n\n$$\n\\begin{aligned}-4A+B & =0 \\\\ -4(1)+B & =0 \\\\ B & =4.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny={e}^{-4x}+4x{e}^{-4x}-\\frac{1}{2}.\n$$"}]}
