#{[{:db/id #edb/ref 17592186360586 :knowledge-point/_questions [{:db/id #edb/ref 17592186152222 :knowledge-point/id #uuid "b61a755f-23e8-5039-b2f5-b5984fdb420c" :knowledge-point/title "Determining the Dimension of a Matrix Vector Space Given Its Standard Basis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21209143-d6f3-527a-95fc-698f6fe33a0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186358043} {:answer/id #uuid "5bddb206-b7cb-5ec9-a288-f2949be70a2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186358550} {:answer/id #uuid "8a3475b2-1900-543b-9144-6a374fa7f5a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186358956} {:answer/id #uuid "b011e497-97d8-5a66-bc41-ff74a3cf84e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186359280} {:answer/id #uuid "d0d5201c-0d42-5c30-b6c4-c732698b84a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186359580}] :answer-field/correct {:answer/id #uuid "b011e497-97d8-5a66-bc41-ff74a3cf84e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186359280} :answer-field/id #uuid "c2fb2713-16be-554b-924a-e6711ddefc4d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360329}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "aa93d1d7-d70a-58d2-9a8d-2974756902aa" :question/math-academy-id "q-95221" :question/problem "What is the dimension of ${\\text{M}}_{4}(R),$ the vector space of all $4\\times 4$ matrices over $R?$" :question/worked-solution "The standard basis of ${\\text{M}}_{n}(R)$ contains a total of ${n}^{2}$ matrices, each with one nonzero entry that is equal to $1.$ \n\nFor example, the standard basis of ${\\text{M}}_{2}(R)$ contains ${2}^{2}=4$ elements, and is given by\n\n$$\n{[\\begin{aligned}1 & 0 \\\\ 0 & 0\\end{aligned}],\\,[\\begin{aligned}0 & 1 \\\\ 0 & 0\\end{aligned}],\\,[\\begin{aligned}0 & 0 \\\\ 1 & 0\\end{aligned}],\\,[\\begin{aligned}0 & 0 \\\\ 0 & 1\\end{aligned}]}.\n$$\n\nTherefore, for ${\\text{M}}_{4}(R),$ we have\n\n$$\n\\text{dim}({\\text{M}}_{4}(R))={4}^{2}=16.\n$$\n\nIn general, \n\n$$\n\\text{dim}({\\text{M}}_{n}(R))={n}^{2}.\n$$"}]}
