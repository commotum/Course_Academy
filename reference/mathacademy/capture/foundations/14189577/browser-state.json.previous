      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14189577/observations/step-q339403-f57e6dd2e82045efb0c1.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14189577/observations/step-q339403-f57e6dd2e82045efb0c1.png",
      "source_url": "https://mathacademy.com/tasks/14189577/topics/6700/lesson",
      "captured_at": 1791930209.9119728,
      "math_academy_id": "q-339403",
