      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14189577/observations/step-q336746-856282bfa4fd7e71a333.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14189577/observations/step-q336746-856282bfa4fd7e71a333.png",
      "source_url": "https://mathacademy.com/tasks/14189577/topics/6700/lesson",
      "captured_at": 1791930185.7327666,
      "math_academy_id": "q-336746",
