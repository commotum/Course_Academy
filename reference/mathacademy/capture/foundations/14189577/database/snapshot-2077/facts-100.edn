#{[17592186501861 #edb/ref 1080 "99.6\\,\\text{lb}" #edb/ref 17592186045417] [17592186501861 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186501861 #edb/ref 1083 #uuid "c69e4261-0557-5f97-9e81-25b3bb4c21af" #edb/ref 17592186045417] [17592186501874 #edb/ref 1080 "190.5\\,\\text{lb}" #edb/ref 17592186045417] [17592186501874 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186501874 #edb/ref 1083 #uuid "cc782d2e-ff11-5ac5-a0c7-6ccf48af546c" #edb/ref 17592186045417] [17592186501890 #edb/ref 1080 "11.32\\,\\text{kg}" #edb/ref 17592186045417] [17592186501890 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186501890 #edb/ref 1083 #uuid "d5adba53-2823-56b8-b86a-d86b90f0927a" #edb/ref 17592186045417] [17592186501903 #edb/ref 1080 "12.18\\,\\text{kg}" #edb/ref 17592186045417] [17592186501903 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186501903 #edb/ref 1083 #uuid "da3ec5e9-ce8a-5063-b326-988d95b5ddd3" #edb/ref 17592186045417] [17592186501910 #edb/ref 1080 "Q(t)=22.5-16.5{e}^{-t/25}" #edb/ref 17592186045417] [17592186501910 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186501910 #edb/ref 1083 #uuid "dd85ac5a-dd49-59af-aa19-5e740d5694bc" #edb/ref 17592186045417] [17592186501913 #edb/ref 1080 "8.63\\,\\text{kg}" #edb/ref 17592186045417] [17592186501913 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186501913 #edb/ref 1083 #uuid "df01cbb2-ff59-5cab-a987-8313d051432e" #edb/ref 17592186045417] [17592186501928 #edb/ref 1080 "190.9\\,\\text{lb}" #edb/ref 17592186045417] [17592186501928 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186501928 #edb/ref 1083 #uuid "e50bcdd8-481a-5a75-a0f4-6d4a10f0bb53" #edb/ref 17592186045417] [17592186501930 #edb/ref 1080 "3" #edb/ref 17592186045417] [17592186501930 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186501930 #edb/ref 1083 #uuid "e5345499-fd39-5582-a566-851fc68ed