36,…\\}-\\{4,8,12,16,20,24,28,32,36,…\\} \\\\  & =\\{6,18,30,42,54,…\\}.\\end{aligned}\n$$" 13194139534785 17592186045417 true] [17592186435968 1068 #edb/ref 17592186435966 13194139534785 17592186045417 true] [17592186435968 1069 "q-105225" 13194139534785 17592186045417 true] [17592186435968 1070 #edb/ref 17592186045485 13194139534785 17592186045417 true] [17592186435968 1071 "If $A=\\{10,20,30,40\\}$ and $B=\\{5,10,15,20,25,30,35,40\\},$ then $A∖B=$" 13194139534785 17592186045417 true] [17592186435968 1072 #uuid "4c3c70ee-1d92-5844-ac72-dec994a61cf8" 13194139534785 17592186045417 true] [17592186435968 1074 "The set $A∖B$ is the set of all elements belonging to $A$ but *not* $B.$ Note that the elements $10,20,30,40\\in B$ are also in $A,$ so we must remove them. Therefore, we have\n\n$$\n\\begin{aligned}A∖B & =A-B \\\\  & =\\{10,20,30,40\\}-\\{5,10,15,20,25,30,35,40\\} \\\\  & =∅.\\end{aligned}\n$$" 13194139534785 17592186045417 true] [17592186435969 1058 #edb/ref 17592186435973 13194139534785 17592186045417 true] [17592186435969 1062 #uuid "1027d02c-0636-540f-93cd-5d017fa6f5ef" 13194139534785 17592186045417 true] [17592186435969 1063 #edb/ref 17592186157789 13194139534785 17592186045417 true] [17592186435970 1062 #uuid "12b37427-ab27-5dc9-97aa-afad8b49dce5" 13194139534785 17592186045417 true] [17592186435970 1063 #edb/ref 17592186435967 13194139534785 17592186045417 true] [17592186435971 1058 #edb/ref 17592186435972 13194139534785 17592186045417 true] [17592186435971 1062 #uuid "2829e46f-848c-572e-8425-ea6cc5d2f217" 13194139534785 17592186045417 true] [17592186435971 1063 #edb/ref 17592186435968 13194139534785 17592186045417 true] [17592186435972 1058 #edb/ref 17592186435970 13194139534785 17592186045417 true] [17592186435972 1062 #uuid "d0badef5-73d2-5f08-9941-d833564ed595" 13194139534785 17592186045417 true] [17592186435972 1063 #edb/ref 17592186241015 13194139534785 17592186045417 true] [17592186435973 1058 #edb/ref 17592186435971 13194139534785 17592186045417 t