" :answer-field/id #uuid "e47018be-dbef-5622-9c8b-226a7e87ecf9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d9d10555-c960-5be8-abde-c1c5d2b8b353" :answer-field/choices ["answer-64d15fd0-d4a8-5abb-b69c-95dc7e736daa" "answer-8ef87da0-d327-5ccd-ab6b-f10514ea8029" "answer-ebab9636-5984-53e3-86d7-a3edab3253c9" "answer-2dbb1fdd-c14d-51c4-8382-2051a90c6b6a" "answer-d9d10555-c960-5be8-abde-c1c5d2b8b353"] :db/ensure [:answer-field/validate]} {:db/id "answer-64d15fd0-d4a8-5abb-b69c-95dc7e736daa" :answer/id #uuid "64d15fd0-d4a8-5abb-b69c-95dc7e736daa" :answer/type :answer.type/math :answer/value "\\{0,10,20,30,40\\}" :db/ensure [:answer/validate]} {:db/id "answer-8ef87da0-d327-5ccd-ab6b-f10514ea8029" :answer/id #uuid "8ef87da0-d327-5ccd-ab6b-f10514ea8029" :answer/type :answer.type/math :answer/value "\\{0\\}" :db/ensure [:answer/validate]} {:db/id "answer-ebab9636-5984-53e3-86d7-a3edab3253c9" :answer/id #uuid "ebab9636-5984-53e3-86d7-a3edab3253c9" :answer/type :answer.type/math :answer/value "\\{10,20,30,40\\}" :db/ensure [:answer/validate]} {:db/id "answer-2dbb1fdd-c14d-51c4-8382-2051a90c6b6a" :answer/id #uuid "2dbb1fdd-c14d-51c4-8382-2051a90c6b6a" :answer/type :answer.type/math :answer/value "\\{5,15,25,35\\}" :db/ensure [:answer/validate]} {:db/id "answer-d9d10555-c960-5be8-abde-c1c5d2b8b353" :answer/id #uuid "d9d10555-c960-5be8-abde-c1c5d2b8b353" :answer/type :answer.type/math :answer/value "∅" :db/ensure [:answer/validate]} {:db/id 17592186241015 :question/problem "If $A=\\{1,3,5,7,9\\}$ and $B=\\{2,4,6,8,10\\},$ then $B∖A=$" :question/worked-solution "The set $B∖A$ is the set of all elements belonging to $B$ but *not* $A.$ Note that no elements of $A$ are also in $B.$  Therefore, we have\n\n$$\n\\begin{aligned}B∖A & =B-A \\\\  & =\\{2,4,6,8,10\\}-\\{1,3,5,7,9\\} \\\\  & =\\{2,4,6,8,10\\}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186240617 :answer-field/correct "answer-2eddfe83-62c0-53ea-a832-213c43cacf6f" :answer-field/choices ["answer-40bb7110-f068-5ce6-9829-f4ff85e9358c" "answer-93bca919-ac75-5da4-a2b6-62b3b37b3351" "answer-2eddfe83-62c0-53ea-a832-213c43cacf6f" "answer-0f322d6f-195d-533d-9a58-f32fa6a0a62a"] :db/ensure [:answer-field/validate]} {:db/id "answer-40bb7110-f068-5ce6-9829-f4ff85e9358c" :answer/id #uuid "40bb7110-f068-5ce6-9829-f4ff85e9358c" :answer/type :answer.type/math :answer/value "\\{1,3,5,7,9\\}" :db/ensure [:answer/validate]} {:db/id "answer-93bca919-ac75-5da4-a2b6-62b3b37b3351" :answer/id #uuid "93bca919-ac75-5da4-a2b6-62b3b37b3351" :answer/type :answer.type/math :answer/value "\\{1,5,7\\}" :db/ensure [:answer/validate]} {:db/id "answer-2eddfe83-62c0-53ea-a832-213c43cacf6f" :answer/id #uuid "2eddfe83-62c0-53ea-a832-213c43cacf6f" :answer/type :answer.type/math :answer/value "\\{2,4,6,8,10\\}" :db/ensure [:answer/validate]} {:db/id "answer-0f322d6f-195d-533d-9a58-f32fa6a0a62a" :answer/id #uuid "0f322d6f-195d-533d-9a58-f32fa6a0a62a" :answer/type :answer.type/math :answer/value "\\{2,4,8\\}" :db/ensure [:answer/validate]} {:db/id "question-1022b5ba-ea30-5954-b103-a049288207e8" :question/id #uuid "1022b5ba-ea30-5954-b103-a049288207e8" :question/math-academy-id "q-105229" :question/problem "Let $A$  be the set of all multiples of $4$ that are greater than $0$ and let $B$  be the set of all multiples of $6$ that are greater than $0.$  What is $B∖A?$" :question/worked-solution "The multiples of $4$ that are greater than $0$ are\n\n$$\nA=\\{4,8,12,16,20,24,28,32,36,…\\}.\n$$\n\nLikewise, the multiples of $6$ that are greater than $0$ are\n\n$$\nB=\\{6,12,18,24,30,36,…\\}.\n$$\n\nNow, $B∖A$ is the *difference* of $B$ and $A,$ which means that we want to find the elements that are in $B$ but *not* in $A.$\n\nThe elements of $B$ that are also in $A$ are $12,24,36,$ and so on (i.e. multiples of $12$). So, we must remove these elements from $B.$ Therefore, we have\n\n$$\n\\begin{aligned}B∖A & =B-A \\\\  & =\\{6,12,18,24,30,36,…\\}-\\{4,8,12,16,20,24,28,32,36,…\\} \\\\  & =\\{6,18,30,42,54,…\\}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c57f3f13-7814-5cdb-a8b8-f7a9f632dd10"] :db/ensure [:question/validate]} {:db/id "answer-field-c57f3f13-7814-5cdb-a8b8-f7a9f632dd10" :answer-field/id #uuid "c57f3f13-7814-5cdb-a8b8-f7a9f632dd10" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8484a3b2-f3d1-5859-a3c0-5a4c83552b1e" :answer-field/choices ["answer-7c0588c5-87a5-5daa-9ec4-772c66bae28f" "answer-58ad6fe4-542f-5e5c-952f-c733e98d4145" "answer-6d81ebd7-b487-5e60-9084-e1efa8b08416" "answer-8484a3b2-f3d1-5859-a3c0-5a4c83552b1e" "answer-8fd97ef9-84af-51dc-a69e-47938dc358d1"] :db/ensure [:answer-field/validate]} {:db/id "answer-7c0588c5-87a5-5daa-9ec4-772c66bae28f" :answer/id #uuid "7c0588c5-87a5-5daa-9ec4-772c66bae28f" :answer/type :answer.type/math :answer/value "\\{12,24,36,48,60,…\\}" :db/ensure [:answer/validate]} {:db/id "answer-58ad6fe4-542f-5e5c-952f-c733e98d4145" :answer/id #uuid "58ad6fe4-542f-5e5c-952f-c733e98d4145" :answer/type :answer.type/math :answer/value "\\{18,30,42,54,66,…\\}" :db/ensure [:answer/validate]} {:db/id "answer-6d81ebd7-b487-5e60-9084-e1efa8b08416" :answer/id #uuid "6d81ebd7-b487-5e60-9084-e1efa8b08416" :answer/type :answer.type/math :answer/value "\\{4,8,16,20,28,…\\}" :db/ensure [:answer/validate]} {:db/id "answer-8484a3b2-f3d1-5859-a3c0-5a4c83552b1e" :answer/id #uuid "8484a3b2-f3d1-5859-a3c0-5a4c83552b1e" :answer/type :answer.type/math :answer/value "\\{6,18,30,42,54,…\\}" :db/ensure [:answer/validate]} {:db/id "answer-8fd97ef9-84af-51dc-a69e-47938dc358d1" :answer/id #uuid "8fd97ef9-84af-51dc-a69e-47938dc358d1" :answer/type :answer.type/math :answer/value "∅" :db/ensure [:answer/validate]} {:db/id "activity-f1f46228-cfbb-5019-b37b-9ea63f47c600" :activity/id #uuid "f1f46228-cfbb-5019-b37b-9ea63f47c600" :activity/title "The Difference of Sets" :activity/type :activity