#{[{:activity/first-step {:db/id #edb/ref 17592186158117} :activity/id #uuid "93123186-af04-50ed-9f1a-970323c9acfd" :activity/scope {:db/id #edb/ref 17592186048681 :topic/id #uuid "b45261a2-56f4-554a-ba13-6946f5dc3f8c" :topic/math-academy-id 2828} :activity/steps [{:db/id #edb/ref 17592186158113 :step/content {:db/id #edb/ref 17592186157284 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157088 :question/id #uuid "35acfa60-3395-5f11-94f9-627499386932" :question/math-academy-id "e-7159"} :knowledge-point/id #uuid "d9a9b6de-b0dd-5b38-a32b-378d2b1d86a2" :knowledge-point/questions [{:db/id #edb/ref 17592186157764} {:db/id #edb/ref 17592186157786} {:db/id #edb/ref 17592186241012} {:db/id #edb/ref 17592186241013} {:db/id #edb/ref 17592186241015} {:db/id #edb/ref 17592186241129} {:db/id #edb/ref 17592186241130} {:db/id #edb/ref 17592186256652} {:db/id #edb/ref 17592186256677} {:db/id #edb/ref 17592186256702} {:db/id #edb/ref 17592186351174} {:db/id #edb/ref 17592186367198} {:db/id #edb/ref 17592186368561}] :knowledge-point/title "Finding a Difference of Sets Without a Venn Diagram"} :step/id #uuid "ca424c53-0556-5e18-9bc0-d39fdd10d96b" :step/math-academy-id 26359 :step/next {:db/id #edb/ref 17592186158114}} {:db/id #edb/ref 17592186158114 :step/content {:db/id #edb/ref 17592186157285 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157089 :question/id #uuid "89c94a89-21de-5a4f-a365-85701b2e4ef2" :question/math-academy-id "e-7160"} :knowledge-point/id #uuid "67e90c94-5018-582f-8692-a1155f41f7c7" :knowledge-point/questions [{:db/id #edb/ref 17592186157767} {:db/id #edb/ref 17592186157789} {:db/id #edb/ref 17592186241016} {:db/id #edb/ref 17592186241018} {:db/id #edb/ref 17592186241020} {:db/id #edb/ref 17592186323767} {:db/id #edb/ref 17592186351176} {:db/id #edb/ref 17592186351367} {:db/id #edb/ref 17592186354499} {:db/id #edb/ref 17592186354500} {:db/id #edb/ref 17592186366857} {:db/id #edb/ref 17592186368798}] :knowledge-point/title "Finding Differences of Sets Given Verbally"} :step/id #uuid "94c5e547-ed98-5f00-a17f-fb87e8db7939" :step/math-academy-id 26360} {:db/id #edb/ref 17592186158117 :step/content {:db/id #edb/ref 17592186158474 :tutorial/content "The **difference** of two sets $A$ and $B,$ denoted by $A \\setminus B$ or $A - B,$ is the set of all elements belonging to $A$ and *not* belonging to $B.$\n\nFor example, consider the sets $A = \\{ a,b,c \\}$ and $B = \\{ b, d, e \\}.$ We can represent these sets using a Venn diagram, as follows:\n\n![](images/4a/4a2d3be8c64b5527dcb37ac68d99cd1e36009725d0847597c5bbd417bbd5f7ad.png)\n\nThe difference $A \\setminus B$ consists of all the elements that are in $A$ but not $B.$ To represent $A \\setminus B,$ we will shade in all the area that is contained within $A$ but not $B.$\n\n![](images/49/49743d4647817294c2287bc15a496fb5d6c73070ed52cfd8934d1babe93c1b25.png)\n\nThe elements $a$ and $c$ are contained in $A$ but not $B.$ Therefore,\n\n$$\nA \\setminus B = A - B = \\{ a,c \\}.\n$$\n\n**Note:** The difference can be defined using set-builder notation as follows:\n\n$$\nA \\setminus B = A - B = \\{ x \\mid x \\in A \\text { and } x \\notin B \\}\n$$\n\nThe condition \"$x \\in A \\text { and } x \\notin B$\" means that $x$ must belong to $A$ but $x$ must *not* belong to $B.$" :tutorial/id #uuid "48529a2b-cc59-57e8-8624-78fd4339f88c" :tutorial/math-academy-id 4333 :tutorial/title "Introduction"} :step/id #uuid "1e4b9023-ad62-55c8-950f-2d1e0371a65e" :step/math-academy-id 26364 :step/next {:db/id #edb/ref 17592186158122}} {:db/id #edb/ref 17592186158122 :step/content {:db/id #edb/ref 17592186157289 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157093 :question/id #uuid "9e0d2770-a884-558f-becb-a38fe709b2a5" :question/math-academy-id "e-7167"} :knowledge-point/id #uuid "4687dcd7-a5ab-5dc6-be6d-89d806a61a02" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049065}] :knowledge-point/questions [{:db/id #edb/ref 17592186157808} {:db/id #edb/ref 17592186157809} {:db/id #edb/ref 17592186241008} {:db/id #edb/ref 17592186241010} {:db/id #edb/ref 17592186241128} {:db/id #edb/ref 17592186351317} {:db/id #edb/ref 17592186351340} {:db/id #edb/ref 17592186351347} {:db/id #edb/ref 17592186351366} {:db/id #edb/ref 17592186354497} {:db/id #edb/ref 17592186354498}] :knowledge-point/title "Finding a Difference of Sets Using a Venn Diagram"} :step/id #uuid "46adbc13-f6f2-55a5-861d-63519ad07f7b" :step/math-academy-id 26372 :step/next {:db/id #edb/ref 17592186158129}} {:db/id #edb/ref 17592186158129 :step/content {:db/id #edb/ref 17592186158480 :tutorial/content "Although Venn diagrams can be useful to visualize differences, we do not have to draw a Venn diagram every time we wish to compute a difference.\n\nFor example, let's again consider the sets $A = \\{ a,b,c \\}$ and $B = \\{ b, d, e \\}.$ This time, we will compute the difference $A \\setminus B$ without using a Venn diagram. We just need to find all the elements that are in $A$ but not $B.$\n\nSo, we will go through the elements of $A$ and check if each element is also in $B.$ Remember that we are looking for elements that are *not* in $B.$\n\n- For the element $a \\in A,$ we have $a \\not\\in B. \\quad \\color{green}\\checkmark$\n\n- For the element $b \\in A,$ we have $b \\in B. \\quad \\color{red}\\times$\n\n- For the element $c \\in A,$ we have $c \\not\\in B. \\quad \\color{green}\\checkmark$\n\nThe elements of $A$ that are not in $B$ are $a$ and $c.$\n\nTherefore, the difference is\n\n$$\nA \\setminus B = A - B = \\{ a,c \\}.\n$$" :tutorial/id #uuid "14afef0e-fec6-5cdf-82c4-98391973df49" :tutorial/math-academy-id 4342 :tutorial/title "Differences Without Venn Diagrams"} :step/id #uuid "2ef8179b-8279-55d0-b781-5afd8ba23248" :step/math-academy-id 26397 :step/next {:db/id #edb/ref 17592186158113}}] :activity/title "The Difference of Sets" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186157485}]}
