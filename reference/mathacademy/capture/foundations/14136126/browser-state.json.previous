    "q-105225": {
      "dom_id": "step-q105225",
      "name": "Question 3",
      "problem": "If $A=\\{10,20,30,40\\}$ and $B=\\{5,10,15,20,25,30,35,40\\},$ then $A∖B=$",
      "worked_solution": "The set $A∖B$ is the set of all elements belonging to $A$ but *not* $B.$ Note that the elements $10,20,30,40\\in B$ are also in $A,$ so we must remove them. Therefore, we have\n\n$$\n\\begin{aligned}A∖B & =A-B \\\\  & =\\{10,20,30,40\\}-\\{5,10,15,20,25,30,35,40\\} \\\\  & =∅.\\end{aligned}\n$$",
      "calculator_instructions": "",
      "fields": [
        {
          "key": "selection",
          "type": "radio",
          "choices": [
            {
              "option": "a",
              "dom_id": "questionWidget-choiceLetterCircle-105225-a",
