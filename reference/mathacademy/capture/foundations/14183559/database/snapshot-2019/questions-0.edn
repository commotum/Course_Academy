#{[{:db/id #edb/ref 17592186265960 :knowledge-point/_questions [{:db/id #edb/ref 17592186124462 :knowledge-point/id #uuid "3b2f7fab-cebe-519a-83e3-a0831cac289d" :knowledge-point/title "Finding the Equation of the Normal Line to a Plane Curve Using the Gradient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "076ccae2-d102-5ad8-b1c2-ac28978e3e97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-3y=0" :db/id #edb/ref 17592186263068} {:answer/id #uuid "1b3882de-2108-52bf-b5e1-4c3304b9a5c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-y-2=0" :db/id #edb/ref 17592186263257} {:answer/id #uuid "a00ce4f7-3888-5dba-a972-b715615f1421" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+y-4=0" :db/id #edb/ref 17592186264362} {:answer/id #uuid "cf2a0770-0459-500c-aa32-352ae1667e03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+3y-6=0" :db/id #edb/ref 17592186264813} {:answer/id #uuid "d493ac59-d9ae-5896-bd9e-006d111d56b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+y-7=0" :db/id #edb/ref 17592186264850}] :answer-field/correct {:answer/id #uuid "a00ce4f7-3888-5dba-a972-b715615f1421" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+y-4=0" :db/id #edb/ref 17592186264362} :answer-field/id #uuid "cb7e101e-fe81-5db4-a578-c892744685d7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265605}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c80428ab-daca-506e-aca7-d4e40b0d604c" :question/math-academy-id "q-130718" :question/problem "Consider the plane curve ${x}^{2}-3{y}^{2}=6.$  Find the equation of the normal line to the curve at the point $(3,1).$" :question/worked-solution "If we set $f(x,y)={x}^{2}-3{y}^{2},$ our curve can be viewed as the level curve $f(x,y)=6.$  \n\nA normal vector to the level curve that passes through the point $(3,1)$ can be found by computing $∇f(3,1).$ \n\nSo, we find the gradient and evaluate it at $(3,1):$\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}({x}^{2}-3{y}^{2})\\,i+\\frac{∂}{∂y}({x}^{2}-3{y}^{2})\\,j \\\\  & =2x\\,i-6y\\,j \\\\ ∇f(3,1) & =2(3)\\,i-6(1)\\,j \\\\  & =6\\,i-6\\,j \\\\  & =⟨6,-6⟩\\end{aligned}\n$$\n\nHence, $∇f(3,1)=⟨6,-6⟩$ is a normal vector to the curve at $(3,1).$\n\nFinally, the Cartesian equation of the line that is parallel to $v=⟨{v}_{x},{v}_{y}⟩$ and passes through the point $({x}_{0},{y}_{0})$ can be written as:\n\n$$\n\\begin{aligned}\\frac{x-{x}_{0}}{{v}_{x}} & =\\frac{y-{y}_{0}}{{v}_{y}} \\\\ \\frac{x-3}{6} & =\\frac{y-1}{(-6)} \\\\ -6(x-3) & =6(y-1) \\\\ -(x-3) & =y-1 \\\\ -x+3 & =y-1 \\\\ x+y-4 & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186266050 :knowledge-point/_questions [{:db/id #edb/ref 17592186124464 :knowledge-point/id #uuid "ce7d6557-ec20-5a40-b799-1a6a36cbe9e6" :knowledge-point/title "Finding the Equation of the Normal Line to a Surface Using the Gradient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4345e16b-0df8-59b8-ad37-650db4ac210e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨2,3,-5⟩+t\\,⟨1,-1,2⟩,\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186263593} {:answer/id #uuid "58520017-6d75-5711-9c4c-279ff100c302" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨1,-1,2⟩+t\\,⟨-2,5,-3⟩,\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186263761} {:answer/id #uuid "8e8b5e1d-96ce-502e-ac9c-14b8cdee3daf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-2,5,-3⟩+t\\,⟨1,-1,2⟩,\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186264220} {:answer/id #uuid "a89fe459-90af-559f-b732-4d06764bcb9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨1,-1,2⟩+t\\,⟨2,-3,5⟩,\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186264441} {:answer/id #uuid "e315f8f8-9238-56c6-b08f-3a589b1dff97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨1,-1,2⟩+t\\,⟨4,5,-5⟩,\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186264971}] :answer-field/correct {:answer/id #uuid "a89fe459-90af-559f-b732-4d06764bcb9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨1,-1,2⟩+t\\,⟨2,-3,5⟩,\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186264441} :answer-field/id #uuid "c90461b1-1149-54d3-9d43-9942adac1495" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265600}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5b9d3e0c-64e0-51a4-97be-e5302f43c4c3" :question/math-academy-id "q-131126" :question/problem "Find a vector equation of the normal line to the surface ${x}^{2}y+{y}^{2}z+{z}^{2}x=5$ at the point $(1,-1,2).$" :question/worked-solution "Let's set $f(x,y,z)={x}^{2}y+{y}^{2}z+{z}^{2}x.$ Then, our surface can be viewed as the level surface $f(x,y,z)=5.$ \n\nA normal vector to the level surface that passes through the point $(1,-1,2)$ can be found by computing $∇f(1,-1,2).$ \n\nSo, we find the gradient and evaluate it at $(1,-1,2):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\text{ }j+{f}_{z}(x,y,z)\\text{ }k \\\\  & =\\frac{∂}{∂x}({x}^{2}y+{y}^{2}z+{z}^{2}x)i+\\frac{∂}{∂y}({x}^{2}y+{y}^{2}z+{z}^{2}x)j+\\frac{∂}{∂z}({x}^{2}y+{y}^{2}z+{z}^{2}x)k \\\\  & =(2xy+{z}^{2})\\,i+({x}^{2}+2yz)\\,j+({y}^{2}+2zx)\\,k \\\\ ∇f(1,-1,2) & =(2(1)(-1)+(2)^{2})\\text{ }i+((1)^{2}+2(-1)(2))\\text{ }j+((-1)^{2}+2(2)(1))\\text{ }k \\\\  & =2\\,i-3\\,j+5\\,k \\\\  & =⟨2,-3,5⟩\\end{aligned}\n$$\n\nFinally, the vector equation of the line that is parallel to $∇f(1,-1,2)$ and passes through the point $(1,-1,2)$ can be written as\n\n$$\n\\begin{aligned}r & =⟨1,-1,2⟩+t\\,∇f(1,-1,2)=⟨1,-1,2⟩+t\\,⟨2,-3,5⟩,\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$"}] [{:db/id #edb/ref 17592186125190 :knowledge-point/_questions [{:db/id #edb/ref 17592186124462 :knowledge-point/id #uuid "3b2f7fab-cebe-519a-83e3-a0831cac289d" :knowledge-point/title "Finding the Equation of the Normal Line to a Plane Curve Using the Gradient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d7e42f80-fb7f-5b14-bafa-151d9661671a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4x + 5y - 3 = 0" :db/id #edb/ref 17592186123741} {:answer/id #uuid "dfbd747b-c83c-5643-8fc1-99aebcf0ce8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-x - 3y + 5 = 0" :db/id #edb/ref 17592186123742} {:answer/id #uuid "299fbc9a-5132-5d78-9c97-8f32aa21e331" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5x - 4y + 1 = 0" :db/id #edb/ref 17592186123743} {:answer/id #uuid "4cb61ba3-eaf6-5a0b-aaa2-16d77d246f59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x - 5y + 1 = 0" :db/id #edb/ref 17592186123744} {:answer/id #uuid "76a8435c-542c-5a71-bac9-045158819127" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2x - 2y + 3 = 0" :db/id #edb/ref 17592186123745}] :answer-field/id #uuid "22b9919e-c058-55c4-a73e-14ca053dbdce" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186123740}] :question/id #uuid "cb219d72-040d-55dd-90ca-3f831acb4d64" :question/math-academy-id "q-65173" :question/problem "Consider the plane curve $xy = x^{2} + y^{2} - 7$. Find the equation of the normal line to the curve at the point $(2,-1)$."}] [{:db/id #edb/ref 17592186398954 :knowledge-point/_questions [{:db/id #edb/ref 17592186124463 :knowledge-point/id #uuid "4516cb28-0fc0-5c15-b9b2-747c3827e189" :knowledge-point/title "Finding a Normal Vector to a Level Surface"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4643060a-8d1d-5789-a362-102d70382db9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,i+2\\,j+2\\,k" :db/id #edb/ref 17592186398956} {:answer/id #uuid "8070bb66-d16c-505c-85ee-2a417bc81d72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,i+2\\,j+k" :db/id #edb/ref 17592186398957} {:answer/id #uuid "0bdcaf70-4358-5973-a594-026557c83288" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,i+j+2\\,k" :db/id #edb/ref 17592186398958} {:answer/id #uuid "61e68fe8-0332-53d0-b214-d38a39b52899" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "i+2\\,j+2\\,k" :db/id #edb/ref 17592186398959} {:answer/id #uuid "b9c9c882-083f-5978-8947-be71bba2f10e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,i+j+k" :db/id #edb/ref 17592186398960}] :answer-field/correct {:answer/id #uuid "4643060a-8d1d-5789-a362-102d70382db9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,i+2\\,j+2\\,k" :db/id #edb/ref 17592186398956} :answer-field/id #uuid "91095769-6695-5735-bdf7-d8d4bfdca38b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398955}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "58a67c4a-aa8b-5b64-8268-56928e2716de" :question/math-academy-id "q-71399" :question/problem "For the function $f(x,y,z)={e}^{x+y+z}+x+y+z$, find a vector that's perpendicular to the level surface that passes through the point where $(x,y,z)=(0,0,0).$" :question/worked-solution "A normal vector to the level surface that passes through the point where $(x,y,z)=(0,0,0)$ can be found by computing \n$∇f(0,0,0).$ \n\nSo, we first find the gradient and evaluate it at $(x,y,z)=(0,0,0):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\text{ }j+{f}_{z}(x,y,z)\\text{ }k \\\\  & =\\frac{∂}{∂x}({e}^{x+y+z}+x+y+z)\\,i+\\frac{∂}{∂y}({e}^{x+y+z}+x+y+z)\\,j+\\frac{∂}{∂z}({e}^{x+y+z}+x+y+z)\\,k \\\\  & =({e}^{x+y+z}+1)\\text{ }i+({e}^{x+y+z}+1)\\text{ }j+({e}^{x+y+z}+1)\\text{ }k \\\\ ∇f(0,0,0) & =({e}^{0+0+0}+1)\\,i+({e}^{0+0+0}+1)\\,j+({e}^{0+0+0}+1)\\,k \\\\  & =2\\,i+2\\,j+2\\,k\\end{aligned}\n$$\n\nTherefore, $2\\,i+2\\,j+2\\,k$ is perpendicular to the level surface that passes through the point where $(x,y,z)=(0,0,0).$"}]}
