yle=\"true\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"0.8em 1em 0.8em 0.3em\"><mtr><mtd><mo>−</mo><mi mathvariant=\"normal\">∇</mi><mi>f</mi><mo stretchy=\"false\">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy=\"false\">)</mo></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mi>∂</mi><mrow><mi>∂</mi><mi>x</mi></mrow></mfrac></mstyle><mo stretchy=\"false\">(</mo><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>y</mi><mo>+</mo><msup><mi>x</mi><mn>2</mn></msup><mi>y</mi><mo stretchy=\"false\">)</mo><mtext>&nbsp;</mtext><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">i</mi></mrow><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mi>∂</mi><mrow><mi>∂</mi><mi>y</mi></mrow></mfrac></mstyle><mo stretchy=\"false\">(</mo><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>y</mi><mo>+</mo><msup><mi>x</mi><mn>2</mn></msup><mi>y</mi><mo stretchy=\"false\">)</mo><mtext>&nbsp;</mtext><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">j</mi></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mo stretchy=\"false\">(</mo><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>y</mi><mo>+</mo><mn>2</mn><mi>x</mi><mi>y</mi><mo stretchy=\"false\">)</mo><mtext>&nbsp;</mtext><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">i</mi></mrow><mo>−</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>y</mi><mo>+</mo><msup><mi>x</mi><mn>2</mn></msup><mo stretchy=\"false\">)</mo><mtext>&nbsp;</mtext><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">j</mi></mrow></mtd></mtr><mtr><mtd><mo>−</mo><mi mathvariant=\"normal\">∇</mi><mi>f</mi><mo stretchy=\"false\">(</mo><mi>π</mi><mo>,</mo><mn>0</mn><mo stretchy=\"false\">)</mo></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mo stretchy=\"false\">(</mo><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>π</mi><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mn>0</mn><mo>+</mo><mn>2</mn><mo>⋅</mo><mi>π</mi><mo>⋅</mo><mn>0</mn><mo stretchy=\"false\">)</mo><mtext>&nbsp;</mtext><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">i</mi></mrow><mo>+</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>π</mi><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mn>0</mn><mo>+</mo><msup><mi>π</mi><mn>2</mn></msup><mo stretchy=\"false\">)</mo><mtext>&nbsp;</mtext><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">j</mi></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">i</mi></mrow><mo>−</mo><msup><mi>π</mi><mn>2</mn></msup><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">j</mi></mrow></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>Therefore, the function decreases most rapidly in the direction of <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"27\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-texatom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D422 TEX-B\"></mjx-c></mjx-mi></mjx-texatom><mjx-mo class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c2212\"></mjx-c></mjx-mo><mjx-msup space=\"3\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D70B TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: 0.363em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-script></mjx-msup><mjx-mstyle><mjx-mspace style=\"width: 0.167em;\"></mjx-mspace></mjx-mstyle><mjx-texatom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D423 TEX-B\"></mjx-c></mjx-mi></mjx-texatom><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">i</mi></mrow><mo>−</mo><msup><mi>π</mi><mn>2</mn></msup><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">j</mi></mrow><mo>.</mo></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
