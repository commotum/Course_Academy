      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14284071/observations/step-q106058-5683f5269087ed4859fb.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14284071/observations/step-q106058-5683f5269087ed4859fb.png",
      "source_url": "https://mathacademy.com/tasks/14284071/topics/3372/lesson",
