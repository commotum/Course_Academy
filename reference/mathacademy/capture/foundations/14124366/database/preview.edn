45417 true] [17592186421900 1075 #edb/ref 17592186421891 13194139534449 17592186045417 true] [17592186421900 1075 #edb/ref 17592186421892 13194139534449 17592186045417 true] [17592186421900 1075 #edb/ref 17592186421893 13194139534449 17592186045417 true] [17592186421900 1075 #edb/ref 17592186421896 13194139534449 17592186045417 true] [17592186421900 1076 #edb/ref 17592186045493 13194139534449 17592186045417 true] [17592186421900 1077 "selection" 13194139534449 17592186045417 true] [17592186421900 1078 #edb/ref 17592186421896 13194139534449 17592186045417 true] [17592186421900 1079 #uuid "ee9b9e23-e285-51ba-8f2e-0f93320571fc" 13194139534449 17592186045417 true] [17592186421901 1068 #edb/ref 17592186421900 13194139534449 17592186045417 true] [17592186421901 1069 "q-71349" 13194139534449 17592186045417 true] [17592186421901 1070 #edb/ref 17592186045485 13194139534449 17592186045417 true] [17592186421901 1071 "The intersection of the planes $x+y-1=0$ and $x+z+1=0$ is given by the line\n\n$$\nr(t)=⟨0,{a}_{2},{a}_{3}⟩+tb,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nCalculate ${a}_{2}+{a}_{3},$ and find a possible direction vector $b.$" 13194139534449 17592186045417 true] [17592186421901 1072 #uuid "3582cc5d-9e46-5e0a-8d0c-b0e74f8f5924" 13194139534449 17592186045417 true] [17592186421901 1074 "We're given that there exists a point on the line where $x=0.$ Substituting this to the first equation gives\n\n$$\n0+y-1=0\\,⟹\\,y=1,\n$$\n\nand substituting $x=0$ into the second equation gives\n\n$$\n0+z+1=0\\,⟹\\,z=-1.\n$$\n\nTherefore, $a=⟨0,1,-1⟩$ is a position vector of a point on the line.\n\nNext, we notice:\n\n- For the plane $x+y-1=0,$ a normal vector to the plane is ${n}_{1}=⟨1,1,0⟩.$\n\n- For the plane $x+z+1=0,$ a normal vector to the plane is ${n}_{2}=⟨1,0,1⟩.$\n\nTo find a direction vector for the line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}b & ={n}_{1}\\times {n}_{2} \\\\  & =⟨1,1,0⟩\\times ⟨1,0,1⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 1 & 1 & 0 \\\\ 1 & 0 & 1\\end{aligned}\\right| \\\\  & =i-j-k \\\\  & =⟨1,-1,-1⟩\\end{aligned}\n$$\n\nThe equation of the line is:\n\n$$\n\\begin{aligned}r(t) & =a+tb \\\\ r(t) & =⟨0,1,-1⟩+t⟨1,-1,-1⟩\\end{aligned}\n$$\n\nFinally then, ${a}_{2}+{a}_{3}=1+(-1)=0,$ and $b=⟨1,-1,-1⟩.$" 13194139534449 17592186045417 true] [17592186421902 1068 #edb/ref 17592186421899 13194139534449 17592186045417 true] [17592186421902 1069 "q-129208" 13194139534449 17592186045417 true] [17592186421902 1070 #edb/ref 17592186045485 13194139534449 17592186045417 true] [17592186421902 1071 "The intersection of the planes $2x+3y-3=0$ and $3x+z+19=0$ is given by the line\n\n$$\nr(t)=⟨0,{a}_{2},{a}_{3}⟩+tb,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nCalculate ${a}_{2}-{a}_{3},$ and find a possible direction vector $b.$" 13194139534449 17592186045417 true] [17592186421902 1072 #uuid "caefbcdd-6450-5b4b-b965-772f5b87b02a" 13194139534449 17592186045417 true] [17592186421902 1074 "We're given that there exists a point on the line where $x=0.$ Substituting this to the first equation gives\n\n$$\n0+3y-3=0\\,⟹\\,y=1,\n$$\n\nand substituting $x=0$ into the second equation gives\n\n$$\n0+z+19=0\\,⟹\\,z=-19.\n$$\n\nTherefore, $a=⟨0,1,-19⟩$ is a position vector of a point on the line.\n\nNext, we notice:\n\n- For the plane $2x+3y-3=0,$ a normal vector to the plane is ${n}_{1}=⟨2,3,0⟩.$\n\n- For the plane $3x+z+19=0,$ a normal vector to the plane is ${n}_{2}=⟨3,0,1⟩.$\n\nTo find a direction vector for the line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}b & ={n}_{1}\\times {n}_{2} \\\\  & =⟨2,3,0⟩\\times ⟨3,0,1⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 2 & 3 & 0 \\\\ 3 & 0 & 1\\end{aligned}\\right| \\\\  & =3i-2j-9k \\\\  & =⟨3,-2,-9⟩\\end{aligned}\n$$\n\nThe equation of the line is:\n\n$$\n\\begin{aligned}r(t) & =a+tb \\\\ r(t) & =⟨0,1,-19⟩+t⟨3,-2,-9⟩\\end{aligned}\n$$\n\nFinally then, ${a}_{2}-{a}_{3}=1-(-19)=20,$ and $b=⟨3,-2,-9⟩.$" 13194139534449 17592186045417 true] [17592186421903 1058 #edb/ref 17592186421907 13194139534449 17592186045417 true] [17592186421903 1062 #uuid "0311a340-7168-5cea-821e-a5c70f05f78d" 13194139534449 17592186045417 true] [17592186421903 1063 #edb/ref 17592186413744 13194139534449 17592186045417 true] [17592186421904 1062 #uuid "4b62f78b-d432-5341-a2aa-4388a4c716e4" 13194139534449 17592186045417 true] [17592186421904 1063 #edb/ref 17592186262998 13194139534449 17592186045417 true] [17592186421905 1058 #edb/ref 17592186421903 13194139534449 17592186045417 true] [17592186421905 1062 #uuid "8993a320-0fa1-5bea-8343-47ddcfb4405b" 13194139534449 17592186045417 true] [17592186421905 1063 #edb/ref 17592186338949 13194139534449 17592186045417 true] [17592186421906 1058 #edb/ref 17592186421905 13194139534449 17592186045417 true] [17592186421906 1062 #uuid "b2250ab1-dcbf-5807-a3a8-ee6a40866bf6" 13194139534449 17592186045417 true] [17592186421906 1063 #edb/ref 17592186421901 13194139534449 17592186045417 true] [17592186421907 1058 #edb/ref 17592186421904 13194139534449 17592186045417 true] [17592186421907 1062 #uuid "c6d8b30b-6627-55c2-a300-1bd06da939e9" 13194139534449 17592186045417 true] [17592186421907 1063 #edb/ref 17592186421902 13194139534449 17592186045417 true]] :edb/tempids {"activity-39b191e6-3a28-55d0-8f36-ad23b66bbcd4" 17592186421888 "answer-0bc5a66d-b1b1-585a-b0bc-21d19ca71687" 17592186421889 "answer-5a5b51a0-3005-5ddd-b5ab-b8d3b530fe56" 17592186421890 "answer-77d58298-86f5-5da7-a6f5-5aadeb1af6ca" 17592186421891 "answer-782abb1a-40ca-50f3-9eb2-460b14bea776" 17592186421892 "answer-8b4a733d-fbda-5f24-ba39-11bd9f15b6aa" 17592186421893 "answer-9c3c1355-587b-53a6-a6d7-2db08ae599af" 17592186421894 "answer-d155552d-65e9-593d-bf4d-41010a2e061a" 17592186421895 "answer-d67766c9-e639-50ae-a0fa-fe37c24c18e0" 17592186421896 "answer-e23fcb96-7207-5675-97d0-1ce03137e6ec" 17592186421897 "answer-f9b80375-370c-5de5-b724-efe10f25c766" 17592186421898 "answer-field-1ea7962c-6925-55c2-86b0-52523c308e6b" 175921864