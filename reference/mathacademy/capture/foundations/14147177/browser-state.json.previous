      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14147177/observations/step-q161026-e22a1ee2267a427dd850.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14147177/observations/step-q161026-e22a1ee2267a427dd850.png",
      "source_url": "https://mathacademy.com/tasks/14147177/topics/4135/review",
      "captured_at": 1791832489.1969914,
      "math_academy_id": "q-161026",
