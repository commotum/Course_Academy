9 :db/ident :answer.type/text} :answer/value "unbounded" :db/id #edb/ref 17592186426995} :answer-field/id #uuid "cc7d7adc-da21-5b0a-b06f-29905afb7481" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186427131} {:answer-field/choices [{:answer/id #uuid "67fd2133-a571-5259-9522-c28a81812363" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "counterclockwise" :db/id #edb/ref 17592186427026} {:answer/id #uuid "ce4a9498-32a7-5177-8205-99e870284e50" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "clockwise" :db/id #edb/ref 17592186427069}] :answer-field/correct {:answer/id #uuid "67fd2133-a571-5259-9522-c28a81812363" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "counterclockwise" :db/id #edb/ref 17592186427026} :answer-field/id #uuid "d6e8f631-d521-567f-9b3b-b798b0a68214" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186427132}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ebe81c2c-e569-5caa-b8cf-61d49127e527" :question/math-academy-id "q-334282" :question/problem "![](images/0b/0b711a3785b5d7f6cdf70ac7d1e056518253982a50f46a4d34c6dd6919423d61.png)\n\nThe phase portrait for a system of linear differential equations whose matrix has two complex eigenvalues $\\lambda =a\\pm b\\text{i}$ is shown above. Select the correct options in the reasoning below.\n\nThe given curve is \n{{field-1}},\nrepresenting\n{{field-2}}\nthat is traversed \n{{field-3}}.\nThus, we must have \n{{field-4}}.\n\nThe spiral is traversed toward \n{{field-5}}\nas $t\\to \\infty .$\nHence, \n{{field-6}}." :question/worked-solution "Let $v=p+q\\text{i},$ where $p,q\\in {R}^{2},$ be an eigenvector corresponding to the eigenvalue $\\lambda =a+b\\text{i}.$\n\nThen, a complex solution of the system is given by\n\n$$\n{x}_{\\text{complex}}(t)=v{e}^{\\lambda t}.\n$$\n\nUsing Euler's formula, we obtain\n\n$$\n\\begin{aligned}{x}_{\\text{complex}}(t) & =v{e}^{(a+b\\text{i})t} \\\\  & ={e}^{at}(\\operatorname{cos}⁡(bt)+\\text{i}\\operatorname{sin}⁡(bt))(p+q\\text{i}) \\\\  & ={e}^{at}(\\operatorname{cos}⁡(bt)p-\\operatorname{sin}⁡(bt)q)+\\text{i}{e}^{at}(\\operatorname{sin}⁡(bt)p+\\operatorname{cos}⁡(bt)q).\\end{aligned}\n$$\n\nTherefore, the general solution of the system is\n\n$$\n\\text{x}(t)={c}_{1}{e}^{at}(\\operatorname{cos}⁡(bt)p-\\operatorname{sin}⁡(bt)q)+{c}_{2}{e}^{at}(\\operatorname{sin}⁡(bt)p+\\operatorname{cos}⁡(bt)q),\n$$\n\nwhere the parts $(\\operatorname{cos}⁡(bt)p-\\operatorname{sin}⁡(bt)q)$ and $(\\operatorname{sin}⁡(bt)p+\\operatorname{cos}⁡(bt)q)$ are bounded.\n\nNow notice that the given curve is $\\text{unbounded},$ representing $\\text{a spiral}$ that is traversed $\\text{counterclockwise}.$ Thus, we must have $a\\ne 0.$\n\nAlso, notice that the spiral is traversed toward $\\text{the origin}.$\n\nHence, to insure that ${e}^{at}\\to 0,$ we require $a<0.$"}] [{:db/id #edb/ref 17592186427138 :knowledge-point/_questions [{:db/id #edb/ref 17592186166943 :knowledge-point/id #uuid "9f0b176c-c802-5b3b-85d0-dede602c9bf3" :knowledge-point/title "Classifying Systems of Linear Differential Equations With Complex Eigenvalues"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ff6c010-8e48-535b-9136-268227d29260" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Re}(\\lambda )=0" :db/id #edb/ref 17592186426994} {:answer/id #uuid "27487e30-31ea-50af-a8c0-369003f86c25" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Re}(\\lambda )>0" :db/id #edb/ref 17592186426998} {:answer/id #uuid "399a21cc-bc57-5c1a-9a89-23ec395241bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Re}(\\lambda )<0" :db/id #edb/ref 17592186427008} {:answer/id #uuid "97963b55-7857-5df3-9428-7365708b725e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Im}(\\lambda )=0" :db/id #edb/ref 17592186427051} {:answer/id #uuid "d366cefc-ae48-57cd-a166-9dd335e20168" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Im}(\\lambda )>0" :db/id #edb/ref 17592186427071} {:answer/id #uuid "ef940da5-c338-5f7f-aa63-314ee88020a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Im}(\\lambda )<0" :db/id #edb/ref 17592186427089}] :answer-field/correct {:answer/id #uuid "27487e30-31ea-50af-a8c0-369003f86c25" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Re}(\\lambda )>0" :db/id #edb/ref 17592186426998} :answer-field/id #uuid "20886724-3f12-5b6c-9a63-b9c046281dea" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186427101} {:answer-field/choices [{:answer/id #uuid "12bc1217-c220-572d-b0d7-d2d34eb5554c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "an unstable spiral (source)" :db/id #edb/ref 17592186426987} {:answer/id #uuid "35ef119c-118a-5078-8edf-efc97fc9d855" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "a center" :db/id #edb/ref 17592186427006} {:answer/id #uuid "e30c39a5-ee5b-5079-97f3-cad9d3c0704d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "a stable spiral (sink)" :db/id #edb/ref 17592186427084}] :answer-field/correct {:answer/id #uuid "12bc1217-c220-572d-b0d7-d2d34eb5554c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "an unstable spiral (source)" :db/id #edb/ref 17592186426987} :answer-field/id #uuid "8da7c3d7-9510-5b7c-9e96-9e1ee09eb078" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186427125}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "49d51940-1d42-5a6c-821f-8629f9249cb2" :question/math-academy-id "q-334301" :question/problem "$$\n\\left\\{\\begin{aligned}{x}^{′}(t) &=3x(t)-4y(t) \\\\ {y}^{′}(t) &=4x(t)+3y(t)\\end{aligned}\\right.\n$$\n\nConsider the system of linear differential equations above. The eigenvalues of the system's matrix are $\\lambda =3\\pm 4\\text{i}.$ Select the correct options in the reasoning below.\n\n$\\,$\nSince \n{{field-1}},\nthe equilibrium point (origin) is {{field-2}}." :question/worked-solution "Let $v=p+q\\text{i},$ where $p,q\\in {R}^{2},$ be an eigenvector corresponding to the eigenvalue $\\lambda =a+b\\text{i}.$\n\nThen, a complex solution of the system is given by\n\n$$\n{x}_{\\text{complex}}(t)=v{e}^{\\lambda t}.\n$$\n\nUsing Euler's formula, we obtain\n\n$$\n\\begin{aligned}{x}_{\\text{complex}}(t) & =v{e}^{(a+b\\text{i})t} \\\\  & ={e}^{at}(\\operatorname{cos}⁡(bt)+\\text{i}\\operatorname{sin}⁡(bt))(p+q\\text{i}) \\\\  & ={e}^{at}(\\operatorname{cos}⁡(bt)p-\\operatorname{sin}⁡(bt)q)+\\text{i}{e}^{at}(\\operatorname{sin}⁡(bt)p+\\operatorname{cos}⁡(bt)q).\\end{aligned}\n$$\n\nTherefore, the general solution of the system is\n\n$$\n\\text{x}(t)={c}_{1}{e}^{at}(\\operatorname{cos}⁡(bt)p-\\operatorname{sin}⁡(bt)q)+{c}_{2}{e}^{at}(\\operatorname{sin}⁡(bt)p+\\operatorname{cos}⁡(bt)q),\n$$\n\nwhere the parts $(\\operatorname{cos}⁡(bt)p-\\operatorname{sin}⁡(bt)q)$ and $(\\operatorname{sin}⁡(bt)p+\\operatorname{cos}⁡(bt)q)$ are bounded.\n\nNow, notice that $a=\\text{Re}(\\lambda )=3>0$ and ${e}^{at}={e}^{3t}\\to \\infty $ as $t\\to \\infty .$ Thus, we have a spiral that is traversed toward infinity as $t\\to \\infty .$ \n\nTherefore, since $\\text{Re}(\\lambda )>0,$ the equilibrium point (origin) is $\\text{an unstable spiral (source)}.$"}] [{:db/id #edb/ref 17592186427139 :knowledge-point/_questions [{:db/id #edb/ref 17592186166943 :knowledge-point/id #uuid "9f0b176c-c802-5b3b-85d0-dede602c9bf3" :knowledge-point/title "Classifying Systems of Linear Differential Equations With Complex Eigenvalues"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "010b3e6a-b894-5000-a218-c0e18a932b08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Im}(\\lambda )=0" :db/id #edb/ref 17592186426982} {:answer/id #uuid "26cdebaa-402e-5206-b419-de102d6efa8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Re}(\\lambda )=0" :db/id #edb/ref 17592186426997} {:answer/id #uuid "4ee678fd-56a0-5e33-a7c3-4084c2657ca8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Im}(\\lambda )<0" :db/id #edb/ref 17592186427012} {:answer/id #uuid "607896b3-839c-5e51-ac55-d41b15fa7f2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Im}(\\lambda )>0" :db/id #edb/ref 17592186427019} {:answer/id #uuid "a9a75b17-8edb-54a3-a586-17cb8d3b09bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Re}(\\lambda )<0" :db/id #edb/ref 17592186427057} {:answer/id #uuid "dfc2bca0-32a3-55c2-9f6d-6acff395796b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Re}(\\lambda )>0" :db/id #edb/ref 17592186427081}] :answer-field/correct {:answer/id #uuid "dfc2bca0-32a3-55c2-9f6d-6acff395796b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Re}(\\lambda )>0" :db/id #edb/ref 17592186427081} :answer-field/id #uuid "5e5db6f9-3975-5145-a0d1-b564d7a77d9c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #