#{[{:db/id #edb/ref 17592186124831 :knowledge-point/_questions [{:db/id #edb/ref 17592186124652 :knowledge-point/id #uuid "89fbf42b-d171-5772-87ce-cf622b720963" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders With Alternative Orientations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34a585bb-74c5-510e-a245-f4082f4c3979" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cone whose axis of symmetry is the $x$-axis." :db/id #edb/ref 17592186282158} {:answer/id #uuid "44a458c1-9084-54b2-b8ff-98063908189d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet whose axis of symmetry is the $z$-axis" :db/id #edb/ref 17592186282270} {:answer/id #uuid "b1022887-6bfe-52a6-a0a8-8e1ab06354d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186283222} {:answer/id #uuid "b3c4e925-9bac-5dc9-a77e-70b58c292a9e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets whose axis of symmetry is the $z$-axis" :db/id #edb/ref 17592186283248} {:answer/id #uuid "cc208067-f320-5874-a23a-5da28c9ea960" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186283473}] :answer-field/correct {:answer/id #uuid "cc208067-f320-5874-a23a-5da28c9ea960" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186283473} :answer-field/id #uuid "d3fd279c-bf2c-5eeb-b5e8-70142503f169" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284303}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a4c96dde-6df8-575b-bdd9-f49e9283853d" :question/math-academy-id "q-164373" :question/problem "Identify the surface ${z}^{2}+{y}^{2}-{x}^{2}=1.$" :question/worked-solution "Recall that the equation of a hyperboloid of one sheet centered at $O$ whose axis of symmetry is the $z$-axis is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}-\\frac{{z}^{2}}{{c}^{2}}=-1.\n$$\n\nThus, a hyperboloid of one sheet centered at $O$ whose axis of symmetry is the $x$**-axis** is given by\n\n$$\n-\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}+\\frac{{z}^{2}}{{c}^{2}}=-1.\n$$\n\nTherefore, our equation is a hyperboloid of one sheet whose axis of symmetry is the $x$-axis and $a=b=c=1.$"}] [{:db/id #edb/ref 17592186323754 :knowledge-point/_questions [{:db/id #edb/ref 17592186124597 :knowledge-point/id #uuid "549870ce-a18a-5a94-a9ea-f3de72aaac1f" :knowledge-point/title "Identifying Quadric Surfaces by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e2cc085-a59d-56dd-81bb-d07371a2a8a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets centered at $(1,0,5)$" :db/id #edb/ref 17592186321763} {:answer/id #uuid "9f341fa3-f683-52a6-b968-2e33e82139a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets centered at $(-2,0,1)$" :db/id #edb/ref 17592186322401} {:answer/id #uuid "a2aefb17-f02a-54e5-8595-b45603b4b42b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cone centered at $(-2,0,1)$" :db/id #edb/ref 17592186322431} {:answer/id #uuid "e4541fbb-55e3-509e-9780-1f3f16ce74e6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet centered at $(-2,0,1)$" :db/id #edb/ref 17592186322935} {:answer/id #uuid "f0ba0df8-5f49-5933-bd23-7a1a9d327e7f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet centered at $(2,0,-1)$" :db/id #edb/ref 17592186323041}] :answer-field/correct {:answer/id #uuid "9f341fa3-f683-52a6-b968-2e33e82139a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets centered at $(-2,0,1)$" :db/id #edb/ref 17592186322401} :answer-field/id #uuid "3aeb3d56-ad05-5134-a623-f1ab028e5a1a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323285}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e8b7d35e-9f56-5494-bc85-89ac721410ae" :question/math-academy-id "q-36110" :question/problem "Identify the surface $4{x}^{2}+{y}^{2}-25{z}^{2}+16x+50z+91=0.$" :question/worked-solution "First, we complete the square in the $x$ and $z$ terms:\n\n$$\n\\begin{aligned}4{x}^{2}+{y}^{2}-25{z}^{2}+16x+50z+91 & =0 \\\\ 4({x}^{2}+4x)+{y}^{2}-25({z}^{2}-2z)+91 & =0 \\\\ 4[(x+2)^{2}-4]+{y}^{2}-25[(z-1)^{2}-1]+91 & =0 \\\\ 4(x+2)^{2}-16+{y}^{2}-25(z-1)^{2}+25+91 & =0 \\\\ 4(x+2)^{2}+{y}^{2}-25(z-1)^{2}+100 & =0\\end{aligned}\n$$\n\nNow, by rearranging, we get the equation\n\n$$\n\\begin{aligned}4(x+2)^{2}+{y}^{2}-25(z-1)^{2}+100 & =0 \\\\ 4(x+2)^{2}+{y}^{2}-25(z-1)^{2} & =-100 \\\\ \\frac{(x+2)^{2}}{25}+\\frac{{y}^{2}}{100}-\\frac{(z-1)^{2}}{4} & =-1.\\end{aligned}\n$$\n\nThis is the equation of a hyperboloid of two sheets centered at $(-2,0,1).$"}] [{:db/id #edb/ref 17592186323841 :knowledge-point/_questions [{:db/id #edb/ref 17592186124597 :knowledge-point/id #uuid "549870ce-a18a-5a94-a9ea-f3de72aaac1f" :knowledge-point/title "Identifying Quadric Surfaces by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "085048d0-926b-5cca-8dfa-e564cb57a41d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet centered at $(1,1,0)$" :db/id #edb/ref 17592186321212} {:answer/id #uuid "59e40a15-5394-58c4-b924-308e77435252" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A ellipsoid centered at $(1,1,0)$" :db/id #edb/ref 17592186321857} {:answer/id #uuid "8b3ddbd9-4ea0-5b22-a0c5-e552e87f5792" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets centered at $(-1,-1,0)$" :db/id #edb/ref 17592186322257} {:answer/id #uuid "9970b56a-c70b-5b74-8a21-fe6b144df410" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet centered at $(1,-1,0)$" :db/id #edb/ref 17592186322366} {:answer/id #uuid "d89ab1f0-2498-5ec5-92c0-660bf25388b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets centered at $(1,1,0)$" :db/id #edb/ref 17592186322844}] :answer-field/correct {:answer/id #uuid "d89ab1f0-2498-5ec5-92c0-660bf25388b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets centered at $(1,1,0)$" :db/id #edb/ref 17592186322844} :answer-field/id #uuid "0ddf6d6f-5de6-54dd-86ec-e6eca647c352" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323193}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9efad2cb-65ec-5d4c-8ad1-c965cc267177" :question/math-academy-id "q-36666" :question/problem "Identify the surface $6{x}^{2}-4{y}^{2}-6{z}^{2}-12x+8y-10=0.$" :question/worked-solution "First, we complete the square in the $x$ and $y$ terms:\n\n$$\n\\begin{aligned}6{x}^{2}-4{y}^{2}-6{z}^{2}-12x+8y-10 & =0 \\\\ 6({x}^{2}-2x)-4({y}^{2}-2y)-6{z}^{2}-10 & =0 \\\\ 6[(x-1)^{2}-1]-4[(y-1)^{2}-1]-6{z}^{2}-10 & =0 \\\\ 6(x-1)^{2}-6-4(y-1)^{2}+4-6{z}^{2}-10 & =0 \\\\ 6(x-1)^{2}-4(y-1)^{2}-6{z}^{2}-12 & =0\\end{aligned}\n$$\n\nNow, by rearranging, we get the equation\n\n$$\n\\begin{aligned}6(x-1)^{2}-4(y-1)^{2}-6{z}^{2}-12 & =0 \\\\ 6(x-1)^{2}-4(y-1)^{2}-6{z}^{2} & =12 \\\\ \\frac{(x-1)^{2}}{2}-\\frac{(y-1)^{2}}{3}-\\frac{{z}^{2}}{2} & =1 \\\\ \\frac{(y-1)^{2}}{3}+\\frac{{z}^{2}}{2}-\\frac{(x-1)^{2}}{2} & =-1.\\end{aligned}\n$$\n\nThis is the equation of a hyperboloid of two sheets centered at $(1,1,0).$"}]}
