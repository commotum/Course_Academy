#{[{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186499589} :activity/id #uuid "36149860-d4ac-5977-bb67-7aa72386654c" :activity/scope {:db/id #edb/ref 17592186050005 :topic/id #uuid "25b1fb2e-aa54-5955-88cd-263118f65faa" :topic/math-academy-id 1898} :activity/steps [{:db/id #edb/ref 17592186499575 :step/content {:db/id #edb/ref 17592186499518 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "021522e8-a9df-59e6-b84b-91834f2968d3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A cylinder" :db/id #edb/ref 17592186498735} {:answer/id #uuid "1c777e07-effa-5159-bdca-6498cfc63f89" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A paraboloid" :db/id #edb/ref 17592186498790} {:answer/id #uuid "a63234ad-3ec9-5fca-ae38-85b9a41f3dfa" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An ellipsoid" :db/id #edb/ref 17592186499093} {:answer/id #uuid "d7b37c1b-e271-50f4-b1c0-d70da4980e40" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid of two sheets" :db/id #edb/ref 17592186499213} {:answer/id #uuid "fa72b501-4cb3-5f6c-8dfe-1efa05d79c7d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid of one sheet" :db/id #edb/ref 17592186499291}] :answer-field/correct {:db/id #edb/ref 17592186499093} :answer-field/id #uuid "ea6e680c-b0bb-5dbd-a194-b67f3d2e815c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186499419}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a43bb9df-6cd4-59cd-9e78-40afc4cecca9" :question/math-academy-id "q-164396" :question/problem "Identify the surface $4{x}^{2}+\\frac{{y}^{2}}{9}+{z}^{2}=1.$" :question/worked-solution "Recall that the equation of an ellipsoid centered at $O$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}+\\frac{{z}^{2}}{{c}^{2}}=1.\n$$\n\nThus, our equation is an ellipsoid with $a=\\frac{1}{2},\\,b=3,\\,c=1.$"} :step/id #uuid "2899eb8d-728e-5caa-a932-24666f3bf8fd" :step/next {:db/id #edb/ref 17592186499604}} {:db/id #edb/ref 17592186499589 :step/content {:db/id #edb/ref 17592186323754 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e2cc085-a59d-56dd-81bb-d07371a2a8a7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid of two sheets centered at $(1,0,5)$" :db/id #edb/ref 17592186321763} {:answer/id #uuid "9f341fa3-f683-52a6-b968-2e33e82139a1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid of two sheets centered at $(-2,0,1)$" :db/id #edb/ref 17592186322401} {:answer/id #uuid "a2aefb17-f02a-54e5-8595-b45603b4b42b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An elliptic cone centered at $(-2,0,1)$" :db/id #edb/ref 17592186322431} {:answer/id #uuid "e4541fbb-55e3-509e-9780-1f3f16ce74e6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid of one sheet centered at $(-2,0,1)$" :db/id #edb/ref 17592186322935} {:answer/id #uuid "f0ba0df8-5f49-5933-bd23-7a1a9d327e7f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid of one sheet centered at $(2,0,-1)$" :db/id #edb/ref 17592186323041}] :answer-field/correct {:db/id #edb/ref 17592186322401} :answer-field/id #uuid "3aeb3d56-ad05-5134-a623-f1ab028e5a1a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186323285}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e8b7d35e-9f56-5494-bc85-89ac721410ae" :question/math-academy-id "q-36110" :question/problem "Identify the surface $4{x}^{2}+{y}^{2}-25{z}^{2}+16x+50z+91=0.$" :question/worked-solution "First, we complete the square in the $x$ and $z$ terms:\n\n$$\n\\begin{aligned}4{x}^{2}+{y}^{2}-25{z}^{2}+16x+50z+91 & =0 \\\\ 4({x}^{2}+4x)+{y}^{2}-25({z}^{2}-2z)+91 & =0 \\\\ 4[(x+2)^{2}-4]+{y}^{2}-25[(z-1)^{2}-1]+91 & =0 \\\\ 4(x+2)^{2}-16+{y}^{2}-25(z-1)^{2}+25+91 & =0 \\\\ 4(x+2)^{2}+{y}^{2}-25(z-1)^{2}+100 & =0\\end{aligned}\n$$\n\nNow, by rearranging, we get the equation\n\n$$\n\\begin{aligned}4(x+2)^{2}+{y}^{2}-25(z-1)^{2}+100 & =0 \\\\ 4(x+2)^{2}+{y}^{2}-25(z-1)^{2} & =-100 \\\\ \\frac{(x+2)^{2}}{25}+\\frac{{y}^{2}}{100}-\\frac{(z-1)^{2}}{4} & =-1.\\end{aligned}\n$$\n\nThis is the equation of a hyperboloid of two sheets centered at $(-2,0,1).$"} :step/id #uuid "5c548eb8-9df3-51c7-a5ac-8d8c6f9aee14" :step/next {:db/id #edb/ref 17592186499599}} {:db/id #edb/ref 17592186499599 :step/content {:db/id #edb/ref 17592186323841 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "085048d0-926b-5cca-8dfa-e564cb57a41d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid of one sheet centered at $(1,1,0)$" :db/id #edb/ref 17592186321212} {:answer/id #uuid "59e40a15-5394-58c4-b924-308e77435252" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A ellipsoid centered at $(1,1,0)$" :db/id #edb/ref 17592186321857} {:answer/id #uuid "8b3ddbd9-4ea0-5b22-a0c5-e552e87f5792" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid of two sheets centered at $(-1,-1,0)$" :db/id #edb/ref 17592186322257} {:answer/id #uuid "9970b56a-c70b-5b74-8a21-fe6b144df410" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid of one sheet centered at $(1,-1,0)$" :db/id #edb/ref 17592186322366} {:answer/id #uuid "d89ab1f0-2498-5ec5-92c0-660bf25388b7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid of two sheets centered at $(1,1,0)$" :db/id #edb/ref 17592186322844}] :answer-field/correct {:db/id #edb/ref 17592186322844} :answer-field/id #uuid "0ddf6d6f-5de6-54dd-86ec-e6eca647c352" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186323193}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9efad2cb-65ec-5d4c-8ad1-c965cc267177" :question/math-academy-id "q-36666" :question/problem "Identify the surface $6{x}^{2}-4{y}^{2}-6{z}^{2}-12x+8y-10=0.$" :question/worked-solution "First, we complete the square in the $x$ and $y$ terms:\n\n$$\n\\begin{aligned}6{x}^{2}-4{y}^{2}-6{z}^{2}-12x+8y-10 & =0 \\\\ 6({x}^{2}-2x)-4({y}^{2}-2y)-6{z}^{2}-10 & =0 \\\\ 6[(x-1)^{2}-1]-4[(y-1)^{2}-1]-6{z}^{2}-10 & =0 \\\\ 6(x-1)^{2}-6-4(y-1)^{2}+4-6{z}^{2}-10 & =0 \\\\ 6(x-1)^{2}-4(y-1)^{2}-6{z}^{2}-12 & =0\\end{aligned}\n$$\n\nNow, by rearranging, we get the equation\n\n$$\n\\begin{aligned}6(x-1)^{2}-4(y-1)^{2}-6{z}^{2}-12 & =0 \\\\ 6(x-1)^{2}-4(y-1)^{2}-6{z}^{2} & =12 \\\\ \\frac{(x-1)^{2}}{2}-\\frac{(y-1)^{2}}{3}-\\frac{{z}^{2}}{2} & =1 \\\\ \\frac{(y-1)^{2}}{3}+\\frac{{z}^{2}}{2}-\\frac{(x-1)^{2}}{2} & =-1.\\end{aligned}\n$$\n\nThis is the equation of a hyperboloid of two sheets centered at $(1,1,0).$"} :step/id #uuid "89ae8bd8-6821-50c2-ae85-b282e63cacb4" :step/next {:db/id #edb/ref 17592186499601}} {:db/id #edb/ref 17592186499601 :step/content {:db/id #edb/ref 17592186124831 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34a585bb-74c5-510e-a245-f4082f4c3979" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An elliptic cone whose axis of symmetry is the $x$-axis." :db/id #edb/ref 17592186282158} {:answer/id #uuid "44a458c1-9084-54b2-b8ff-98063908189d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid of one sheet whose axis of symmetry is the $z$-axis" :db/id #edb/ref 17592186282270} {:answer/id #uuid "b1022887-6bfe-52a6-a0a8-8e1ab06354d9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid of two sheets whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186283222} {:answer/id #uuid "b3c4e925-9bac-5dc9-a77e-70b58c292a9e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid of two sheets whose axis of symmetry is the $z$-axis" :db/id #edb/ref 17592186283248} {:answer/id #uuid "cc208067-f320-5874-a23a-5da28c9ea960" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid of one sheet whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186283473}] :answer-field/correct {:db/id #edb/ref 17592186283473} :answer-field/id #uuid "d3fd279c-bf2c-5eeb-b5e8-70142503f169" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186284303}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a4c96dde-6df8-575b-bdd9-f49e9283853d" :question/math-academy-id "q-164373" :question/problem "Identify the surface ${z}^{2}+{y}^{2}-{x}^{2}=1.$" :question/worked-solution "Recall that the equation of a hyperboloid of one sheet centered at $O$ whose axis of symmetry is the $z$-axis is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}-\\frac{{z}^{2}}{{c}^{2}}=-1.\n$$\n\nThus, a hyperboloid of one sheet centered at $O$ whose axis of symmetry is the $x$**-axis** is given by\n\n$$\n-\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}+\\frac{{z}^{2}}{{c}^{2}}=-1.\n$$\n\nTherefore, our equation is a hyperboloid of one sheet whose axis of symmetry is the $x$-axis and $a=b=c=1.$"} :step/id #uuid "922bfb7c-f62a-573a-8240-5f30e75ef4b9" :step/next {:db/id #edb/ref 17592186499575}} {:db/id #edb/ref 17592186499604 :step/content {:db/id #edb/ref 17592186499521 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "389ea0f9-8a1f-5cb1-ad91-524b12efbd32" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An elliptic cone whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186498854} {:answer/id #uuid "6ff2e8e7-86f1-53c7-b6c0-8eaa30d0d9e8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperbolic paraboloid whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186498980} {:answer/id #uuid "750ac996-47c9-5708-8786-361c28fa8bcb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperbolic paraboloid whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186498989} {:answer/id #uuid "c9c9013c-3150-59d3-828f-685becb59007" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid with one sheet whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186499171} {:answer/id #uuid "df499b4c-c6a3-5ad4-a3fc-438688b9685f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid with one sheet whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186499227}] :answer-field/correct {:db/id #edb/ref 17592186498980} :answer-field/id #uuid "ef272bc8-d53b-5b80-88af-a0c05c5cfeb7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186499423}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "aac5719a-7a14-5fc9-ab07-f4320aad4083" :question/math-academy-id "q-164513" :question/problem "Identify the surface $y={x}^{2}-\\frac{{z}^{2}}{4}.$" :question/worked-solution "Recall that the equation of a hyperbolic paraboloid centered at $O$ whose axis of symmetry is the $z$-axis is given by\n\n$$\nz=\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}.\n$$\n\nThus, a hyperbolic paraboloid centered at $O$ whose axis of symmetry is the $y$**-axis** is given by\n\n$$\ny=\\frac{{x}^{2}}{{a}^{2}}-\\frac{{z}^{2}}{{c}^{2}}.\n$$\n\nTherefore, our equation is a hyperbolic paraboloid whose axis of symmetry is the $y$-axis and $a=1,\\,c=2.$"} :step/id #uuid "98a0cfb3-88e2-53f4-9c05-0b0a0c14511d"}] :activity/title "Identifying Quadric Surfaces" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186498719}]}
