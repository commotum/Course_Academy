  "live_records": {
    "q-38324": {
      "dom_id": "step-q38324",
      "name": "Question 1",
      "problem": "The size of a bush growing in a schoolyard is being monitored. The area $A\\,{\\text{m}}^{2}$ of the bush at any given moment grows at a rate that's directly proportional to the area at that moment. Additionally, $2\\,{\\text{m}}^{2}$ of the bush is cut away every month.\nWhat is the differential equation that describes the rate of change in the area of the schoolyard bush at time $t,$ where $t$ is the time in months since it started growing?",
      "worked_solution": "The rate of change in the area of the bush per month increases in proportion to $A$ and decreases by $2.$ The differential equation that describes this is\n\n$$\n\\frac{\\text{d}A}{\\text{d}t}=kA-2,\n$$\n\nwhere $k$ is the (positive) constant of proportionality.",
      "calculator_instructions": "",
      "fields": [
        {
          "key": "selection",
          "type": "radio",
          "choices": [
