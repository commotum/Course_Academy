c-6369-5240-8c7d-81a21205d86b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.4547" :db/id #edb/ref 17592186161413}] :answer-field/id #uuid "4c6446dd-0d6b-587e-84bc-bb6e7b4beb50" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186161408}] :question/id #uuid "bac13043-3683-5332-9a90-e9dca4fb305d" :question/math-academy-id "q-96346" :question/problem "Given that the random variable $X∼Exp(\\frac{1}{2})$, calculate $P(1 < X < 4)$. Round your final answer to four decimal places.\n\n> A scientific calculator is required to answer this question." :question/requires-calculator true}]}
