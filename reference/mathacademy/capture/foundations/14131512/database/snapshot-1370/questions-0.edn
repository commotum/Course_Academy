9906-8c4d81c74c3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(x+2)" :db/id #edb/ref 17592186307095}] :answer-field/correct {:answer/id #uuid "d1a73cc5-5dc5-51a3-9906-8c4d81c74c3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(x+2)" :db/id #edb/ref 17592186307095} :answer-field/id #uuid "9248dce7-b98e-5ff4-bda2-e01c8b11790b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186307983} {:answer-field/choices [{:answer/id #uuid "10fea060-278f-50a3-9b56-183bdf163c45" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "dependent" :db/id #edb/ref 17592186305306} {:answer/id #uuid "2d9748a2-a84d-59c1-b804-d05e6d2cff85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "independent" :db/id #edb/ref 17592186305585} {:answer/id #uuid "d556e851-090a-5509-bf2f-41c8241ee8df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "independent" :db/id #edb/ref 17592186307130}] :answer-field/correct {:answer/id #uuid "2d9748a2-a84d-59c1-b804-d05e6d2cff85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "independent" :db/id #edb/ref 17592186305585} :answer-field/id #uuid "d2c59f88-c92c-51fe-84a6-89edef0e2468" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186308178}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b67df1a9-5674-599d-941a-796b1c85ba70" :question/math-academy-id "q-334118" :question/problem "$$\n{y}_{1}(x)=x+1,\\,{y}_{2}(x)={x}^{2},\\,x\\in R\n$$\n\nConsider the functions ${y}_{1}(x)$ and ${y}_{2}(x)$ above. Given that ${y}_{1}$ and ${y}_{2}$ are solutions of the same second-order linear differential equation, select the correct options in the reasoning below.$\\,$ The Wronskian is $W({y}_{1},{y}_{2})=$ \n{{field-1}},  \nwhich is\n{{field-2}}.\n\n$\\,$ Therefore, the set ${{y}_{1}(x),{y}_{2}(x)}$ is linearly \n{{field-3}} \non $R.$" :question/worked-solution "Suppose the functions ${y}_{1}(x)$ and ${y}_{2}(x)$ are defined on some interval $I.$\nThe Wronskian $W({y}_{1},{y}_{2})$ of these functions is defined as\n\n$$\nW({y}_{1},{y}_{2})=|\\begin{aligned}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{aligned}|={y}_{1}{y}_{2}^{′}-{y}_{2}{y}_{1}^{′}.\n$$\n\nRecall the following:\n\n- If $W\\ne 0$ for at least one $x\\in I,$ then ${y}_{1}$ and ${y}_{2}$ are linearly independent.\n\n- If $W=0$ and it’s known that ${y}_{1}$ and ${y}_{2}$ are solutions to the same second-order linear differential equation, then ${y}_{1}$ and ${y}_{2}$ are linearly dependent.\n\nIn our case, the Wronskian is given by\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =|\\begin{aligned}x+1 & {x}^{2} \\\\ (x+1)^{′} & ({x}^{2})^{′}\\end{aligned}| \\\\  & =|\\begin{aligned}x+1 & {x}^{2} \\\\ 1 & 2x\\end{aligned}| \\\\  & =(x+1)\\cdot (2x)-{x}^{2}\\cdot 1 \\\\  & =2x(x+1)-{x}^{2} \\\\  & =2{x}^{2}+2x-{x}^{2} \\\\  & ={x}^{2}+2x \\\\  & =x(x+2)\\end{aligned}\n$$\n\nwhich is $\\text{nonzero for at least one }x\\in R.$\n\nTherefore, the set ${{y}_{1}(x),{y}_{2}(x)}$ is linearly $\\text{independent}$ on $R.$"}] [{:db/id #edb/ref 17592186335741 :knowledge-point/_questions [{:db/id #edb/ref 17592186152278 :knowledge-point/id #uuid "4ca68460-f3fe-5ae8-b5f4-85742c0ef46b" :knowledge-point/title "Calculating the Wronskian of Two Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b8de8f1-0aa5-5597-8f2a-04314cbb183e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x{e}^{x}" :db/id #edb/ref 17592186333095} {:answer/id #uuid "15516e59-127e-5585-b223-c41ec895f21c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186333176} {:answer/id #uuid "852d9dce-fad7-5d6d-9d52-31ed637d34a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186334173} {:answer/id #uuid "8936b9da-7dc8-5edc-ba5b-5f96a52fcf44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{e}^{x}" :db/id #edb/ref 17592186334208} {:answer/id #uuid "e05757f5-0bd3-5d05-a456-6e255ec4d863" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2x}" :db/id #edb/ref 17592186334942}] :answer-field/correct {:answer/id #uuid "e05757f5-0bd3-5d05-a456-6e255ec4d863" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2x}" :db/id #edb/ref 17592186334942} :answer-field/id #uuid "7b23fc9c-30a6-50f5-8daf-56d713fe0638" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335475}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e41bd3a2-77cd-50f9-af0d-7902e2113a96" :question/math-academy-id "q-64747" :question/problem "Compute the Wronskian $W({y}_{1},{y}_{2})$ for ${y}_{1}(x)={e}^{x}$ and ${y}_{2}(x)=x{e}^{x}.$" :question/worked-solution "The Wronskian $W({y}_{1},{y}_{2})$ of two functions ${y}_{1}(x)$ and ${y}_{2}(x)$ is defined as:\n\n$$\nW({y}_{1},{y}_{2})=|\\begin{aligned}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{aligned}|={y}_{1}{y}_{2}^{′}-{y}_{2}{y}_{1}^{′}\n$$\n\nIn our case, we have ${y}_{1}(x)={e}^{x}$ and ${y}_{2}(x)=x{e}^{x}.$ Therefore:\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =({e}^{x}){(x{e}^{x})}^{′}-(x{e}^{x}){({e}^{x})}^{′} \\\\  & =({e}^{x})({e}^{x}+x{e}^{x})-(x{e}^{x})({e}^{x}) \\\\  & ={e}^{x}({e}^{x}+x{e}^{x}-x{e}^{x}) \\\\  & ={e}^{x}({e}^{x}) \\\\  & ={e}^{2x}\\end{aligned}\n$$"}]}
