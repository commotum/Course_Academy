nd{aligned}\n$$\n\nSince $L\\{\\operatorname{cos}⁡(\\omega t)\\}=\\frac{s}{{s}^{2}+{\\omega }^{2}}$ for $s>0,$ we have\n\n$$\n\\begin{aligned}L\\{g(t+4)\\} & =L\\{\\operatorname{cos}⁡(7\\pi t)\\} \\\\  & =\\frac{s}{{s}^{2}+49{\\pi }^{2}}.\\end{aligned}\n$$\n\nTherefore, applying the second shifting theorem, we get\n\n$$\n\\begin{aligned}L\\{u(t-4)\\,g(t)\\} & ={e}^{-4s}\\,L\\{g(t+4)\\} \\\\  & ={e}^{-4s}\\cdot \\frac{s}{{s}^{2}+49{\\pi }^{2}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186552437 :knowledge-point/_questions [{:db/id #edb/ref 17592186221441 :knowledge-point/id #uuid "57cca080-3b0b-57b9-a7f8-6b1038ebd686" :knowledge-point/title "Laplace Transforms of Trig Functions Using the Second Shifting Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36544b1f-ed1f-5228-bfdd-95c70bf71cf8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{e}^{-5s}\\cdot \\frac{s}{{s}^{2}+5{\\pi }^{2}}" :db/id #edb/ref 17592186551795} {:answer/id #uuid "5c2c216d-9a55-54c2-8aec-49a2057c26fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{5s}\\cdot \\frac{s}{{s}^{2}+25{\\pi }^{2}}" :db/id #edb/ref 17592186551889} {:answer/id #uuid "9cd0388d-e707-52e7-8585-ee8372fb55ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{e}^{-5s}\\cdot \\frac{5\\pi }{{s}^{2}+25{\\pi }^{2}}" :db/id #edb/ref 17592186552044} {:answer/id #uuid "b1d117f7-b4fc-5576-a08c-e3c7a0e4929b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-5s}\\cdot \\frac{s}{{s}^{2}+25{\\pi }^{2}}" :db/id #edb/ref 17592186552097} {:answer/id #uuid "d0808cb3-7001-52b5-822d-c54d5c0d7e17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{e}^{-5s}\\cdot \\frac{s}{{s}^{2}+25{\\pi }^{2}}" :db/id #edb/ref 17592186552161}] :answer-field/correct {:answer/id #uuid "d0808cb3-7001-52b5-822d-c54d5c0d7e17"