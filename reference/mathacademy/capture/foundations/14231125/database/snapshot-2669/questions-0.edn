name{cos}⁡(5\\pi t)\\} \\\\  & =-\\frac{s}{{s}^{2}+25{\\pi }^{2}}.\\end{aligned}\n$$\n\nTherefore, applying the second shifting theorem, we get\n\n$$\n\\begin{aligned}L\\{u(t-5)\\,g(t)\\} & ={e}^{-5s}\\,L\\{g(t+5)\\} \\\\  & =-{e}^{-5s}\\cdot \\frac{s}{{s}^{2}+25{\\pi }^{2}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186552515 :knowledge-point/_questions [{:db/id #edb/ref 17592186221441 :knowledge-point/id #uuid "57cca080-3b0b-57b9-a7f8-6b1038ebd686" :knowledge-point/title "Laplace Transforms of Trig Functions Using the Second Shifting Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1431c8a7-6d23-5843-93d6-1ae0863912f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-6s}\\cdot \\frac{7\\pi }{{s}^{2}+49{\\pi }^{2}}" :db/id #edb/ref 17592186551705} {:answer/id #uuid "68d5e509-3b05-5a34-92bc-218e3dd394b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{e}^{-6s}\\cdot \\frac{7\\pi }{{s}^{2}+49{\\pi }^{2}}" :db/id #edb/ref 17592186551909} {:answer/id #uuid "805ca495-9055-5de2-a7d3-3c03c200aef7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-6s}\\cdot \\frac{7\\pi }{{s}^{2}+9{\\pi }^{2}}" :db/id #edb/ref 17592186551971} {:answer/id #uuid "81a72c19-ece4-5385-9101-12fd47e64e58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-6s}\\cdot \\frac{s}{{s}^{2}+49{\\pi }^{2}}" :db/id #edb/ref 17592186551972} {:answer/id #uuid "90807bdb-5e8d-5fa7-8889-4afcf3cf6c37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{6s}\\cdot \\frac{7\\pi }{{s}^{2}+49{\\pi }^{2}}" :db/id #edb/ref 17592186552017}] :answer-field/correct {:answer/id #uuid "1431c8a7-6d23-5843-93d6-1ae0863912f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-6s}\\cdot \\frac{7\\pi }{{s}^{2}+49{\\pi }^{2}}" :db/id #edb/ref 17592186551705} :answer-field/id #uuid "2185e5bf-53f2-5796-ac66-47397494aab5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552273}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e53e0594-6789-5dbd-80fa-9b6693e796fe" :question/math-academy-id "q-331046" :question/problem "Given that\n\n$$\n\\begin{aligned}L\\{\\operatorname{sin}⁡\\omega t\\} & =\\frac{\\omega }{{s}^{2}+{\\omega }^{2}}, &  & s>0, \\\\ L\\{\\operatorname{cos}⁡\\omega t\\} & =\\frac{s}{{s}^{2}+{\\omega }^{2}}, &  & s>0,\\end{aligned}\n$$\n\nfind $L\\{u(t-6)\\,\\operatorname{sin}⁡(7\\pi t)\\},$ where $u(t)$ is the unit step function." :question/worked-solution "The second shifting theorem states that if $a\\ge 0$ and $L\\{u(t-a)\\,g(t)\\}$ exists for $s>{s}_{0},$ then\n\n$$\nL\\{u(t-a)\\,g(t)\\}={e}^{-as}\\,L\\{g(t+a)\\},\\,\\text{for}\\,s>{s}_{0},\n$$\n\nwhere $u(t)$ is the unit step function.\n\nIn our case, we wish to find\n\n$$\nL\\{u(t-6)\\,\\operatorname{sin}⁡(7\\pi t)\\}.\n$$\n\nTherefore, $a=6,$ and we have \n\n$$\nL\\{u(t-6)\\,g(t)\\}={e}^{-6s}\\,L\\{g(t+6)\\},\n$$\n\nwhere $g(t)=\\operatorname{sin}⁡(7\\pi t).$\n\nNotice that\n\n$$\n\\begin{aligned}g(t+6) & =sin\\,(7\\pi (t+6)) \\\\  & =\\operatorname{sin}⁡(7\\pi t+42\\pi ) \\\\  & =\\operatorname{sin}⁡7\\pi t\\operatorname{cos}⁡42\\pi +\\operatorname{cos}⁡7\\pi t\\operatorname{sin}⁡42\\pi  \\\\  & =\\operatorname{sin}⁡7\\pi t\\cdot 1+\\operatorname{cos}⁡7\\pi t\\cdot 0 \\\\  & =\\operatorname{sin}⁡7\\pi t.\\end{aligned}\n$$\n\nSince $L\\{\\operatorname{sin}⁡(\\omega t)\\}=\\frac{\\omega }{{s}^{2}+{\\omega }^{2}}$ for $s>0,$ we have\n\n$$\n\\begin{aligned}L\\{g(t+6)\\} & =L\\{\\operatorname{sin}⁡(7\\pi t)\\} \\\\  & =\\frac{7\\pi }{{s}^{2}+49{\\pi }^{2}}.\\end{aligned}\n$$\n\nTherefore, applying the second shifting theorem, we get\n\n$$\n\\begin{aligned}L\\{u(t-6)\\,g(t)\\} & ={e}^{-6s}\\,L\\{g(t+6)\\} \\\\  & ={e}^{-6s}\\cdot \\frac{7\\pi }{{s}^{2}+49{\\pi }^{2}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186372811 :knowledge-point/_questions [{:db/id #edb/ref 17592186221442 :knowledge-point/id #uuid "d22ba3ca-cf7a-5a77-abf6-8620076552bb" :knowledge-point/title "Using the Alternative Form of the Second Shifting Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22d89e94-064e-5669-b5bf-e3534cd8b285" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-6s}\\cdot \\frac{2}{(s+6)^{3}}" :db/id #edb/ref 17592186372813} {:answer/id #uuid "73d40c5e-bc2a-55d1-b719-c45456a9d2ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{6s}\\cdot \\frac{2}{{s}^{3}}" :db/id #edb/ref 17592186372814} {:answer/id #uuid "87ee9220-0e8c-5f9f-ae75-fa6bd2cf811c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-6s}\\cdot \\frac{1}{{s}^{3}}" :db/id #edb/ref 17592186372815} {:answer/id #uuid "45bac146-b7c0-5338-82b3-d46eb2b99ce8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-6s}\\cdot \\frac{2}{{s}^{2}}" :db/id #edb/ref 17592186372816} {:answer/id #uuid "d308ca5c-57fe-5c15-87b8-9ffa535f3003" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-6s}\\cdot \\frac{2}{{s}^{3}}" :db/id #edb/ref 17592186372817}] :answer-field/correct {:answer/id #uuid "d308ca5c-57fe-5c15-87b8-9ffa535f3003" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-6s}\\cdot \\frac{2}{{s}^{3}}" :db/id #edb/ref 17592186372817} :answer-field/id #uuid "5e5323ed-8b42-56d0-8b57-d91970958a6d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186372812}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "beac4237-0318-557d-ae12-fae80095f2b6" :question/math-academy-id "q-342384" :question/problem "Find $L\\{u(t-6)(t-6)^{2}\\},$ where $u(t)$ is the unit step function." :question/worked-solution "The second shifting theorem states that if $a\\ge 0,$ then\n\n$$\nL\\{u(t-a)\\,f(t-a)\\}={e}^{-as}F(s),\n$$\n\nwhere $F(s)=L\\{f(t)\\}.$\n\nIn our case, we wish to find the transform of\n\n$$\nu(t-6)(t-6)^{2}.\n$$\n\nBy comparing this expression to the form in the theorem, we can identify the following:\n\n- The shift is $a=6.$\n\n- The shifted function is $f(t-6)=(t-6)^{2}.$\n\nFrom the shifted function, we can deduce the original unshifted function $f(t)$ by simply replacing $(t-6)$ with $t:$\n\n$$\nf(t)={t}^{2}.\n$$\n\nNow, we calculate the Laplace transform $F(s)$ of the unshifted function using the rule $L\\{{t}^{n}\\}=\\frac{n!}{{s}^{n+1}}:$\n\n$$\nF(s)=L\\{{t}^{2}\\}=\\frac{2!}{{s}^{2+1}}=\\frac{2}{{s}^{3}}.\n$$\n\nFinally, we apply the shifting theorem formula $L\\{u(t-a)\\,f(t-a)\\}={e}^{-as}F(s)$ by multiplying $F(s)$ by the exponential delay factor ${e}^{-6s}:$\n\n$$\n\\begin{aligned}L\\{u(t-6)(t-6)^{2}\\} & ={e}^{-6s}\\cdot F(s) \\\\  & ={e}^{-6s}\\cdot \\frac{2}{{s}^{3}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186552457 :knowledge-point/_questions [{:db/id #edb/ref 17592186221442 :knowledge-point/id #uuid "d22ba3ca-cf7a-5a77-abf6-8620076552bb" :knowledge-point/title "Using the Alternative Form of the Second Shifting Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "045ac196-eefe-52d1-9b56-6df8bfdc157e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-s}\\cdot \\frac{1}{s-6}" :db/id #edb/ref 17592186551672} {:answer/id #uuid "442f7d1c-41d0-58a7-b119-707bf7ffd0a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-s}\\cdot \\frac{1}{s+6}" :db/id #edb/ref 17592186551831} {:answer/id #uuid "570a2d6a-4a25-5a52-82a5-4114008c8c67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-6s}\\cdot \\frac{1}{s+1}" :db/id #edb/ref 17592186551873} {:answer/id #uuid "5b6bdf1d-286a-57a4-b41f-089faf409832" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-s}\\cdot \\frac{1}{s+1}" :db/id #edb/ref 17592186551884} {:answer/id #uuid "8b68cf10-a1c6-5cd2-af9b-57a36793bc78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-6s}\\cdot \\frac{1}{s+6}" :db/id #edb/ref 17592186552005}] :answer-field/correct {:answer/id #uuid "442f7d1c-41d0-58a7-b119-707bf7ffd0a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-s}\\cdot \\frac{1}{s+6}" :db/id #edb/ref 17592186551831} :answer-field/id #uuid "53390e98-d9c6-51f8-97e9-8fa25f07c2ef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552302}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7459efdc-2436-5537-949c-53e76f0f388b" :question/math-academy-id "q-342627" :question/problem "Find $L\\{u(t-1){e}^{-6(t-1)}\\},$ where $u(t)$ is the unit step function." :question/worked-solution "The second shifting theorem states that if $a\\ge 0,$ then\n\n$$\nL\\{u(t-a)\\,f(t-a)\\}={e}^{-as}F(s),\n$$\n\nwhere $F(s)=L\\{f(t)\\}.$\n\nIn our case, we wish to find the transform of\n\n$$\nu(t-1){e}^{-6(t-1)}.\n$$\n\nBy comparing this expression to the form in the theorem, we can identify the following:\n\n- The shift is $a=1.$\n\n- The shifted function is $f(t-1)={e}^{-6(t-1)}.$\n\nFrom the shifted function, we can deduce the original unshifted function $f(t)$ by simply replacing $(t-1)$ with $t:$\n\n$$\nf(t)={e}^{-6t}.\n$$\n\nNow, we calculate the Laplace transform $F(s)$ of the unshifted function:\n\n$$\nF(s)=L\\{{e}^{-6t}\\}=\\frac{1}{s-(-6)}=\\frac{1}{s+6}.\n$$\n\nFinally, we apply the shifting theorem formula $L\\{u(t-a)\\,f(t-a)\\}={e}^{-as}F(s)$ by multiplying $F(s)$ by the exponential delay factor ${e}^{-s}:$\n\n$$\n\\begin{aligned}L\\{u(t-1){e}^{-6(t-1)}\\} & ={e}^{-s}\\cdot F(s) \\\\  & ={e}^{-s}\\cdot \\frac{1}{s+6}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186552526 :knowledge-point/_questions [{:db/id #edb/ref 17592186221442 :knowledge-point/id #uuid "d22ba3ca-cf7a-5a77-abf6-8620076552bb" :knowledge-point/title "Using the Alternative Form of the Second Shifting Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d7bbee9-9ab4-5e9d-8b60-6611bd545b5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-5s}\\cdot \\frac{1}{s+4}" :db/id #edb/ref 17592186551776} {:answer/id #uuid "9a5223f3-2902-50fd-b91a-ffe18273edec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-5s}\\cdot \\frac{1}{s-4}" :db/id #edb/ref 17592186552039} {:answer/id #uuid "d7aac2c5-9e3c-5e53-9c83-7e95cfdf9f04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-4s}\\cdot \\frac{1}{s+4}" :db/id #edb/ref 17592186552174} {:answer/id #uuid "f430344e-55d7-5ca3-b110-a9fe090e2f70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-4s}\\cdot \\frac{1}{s+5}" :db/id #edb/ref 17592186552236} {:answer/id #uuid "fe81f860-b473-5931-9f08-595353ab02e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-5s}\\cdot \\frac{1}{s+5}" :db/id #edb/ref 17592186552253}] :answer-field/correct {:answer/id #uuid "2d7bbee9-9ab4-5e9d-8b60-6611bd545b5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-5s}\\cdot \\frac{1}{s+4}" :db/id #edb/ref 17592186551776} :answer-field/id #uuid "02622de9-5ec7-509e-aeaf-23dccc7046e0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552258}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fe74ebec-be9d-5552-b1e8-03aece81d137" :question/math-academy-id "q-342628" :question/problem "Find $L\\{u(t-5){e}^{-4(t-5)}\\},$ where $u(t)$ is the unit step function." :question/worked-solution "The second shifting theorem states that if $a\\ge 0,$ then\n\n$$\nL\\{u(t-a)\\,f(t-a)\\}={e}^{-as}F(s),\n$$\n\nwhere $F(s)=L\\{f(t)\\}.$\n\nIn our case, we wish to find the transform of\n\n$$\nu(t-5){e}^{-4(t-5)}.\n$$\n\nBy comparing this expression to the form in the theorem, we can identify the following:\n\n- The shift is $a=5.$\n\n- The shifted function is $f(t-5)={e}^{-4(t-5)}.$\n\nFrom the shifted function, we can deduce the original unshifted function $f(t)$ by simply replacing $(t-5)$ with $t:$\n\n$$\nf(t)={e}^{-4t}.\n$$\n\nNow, we calculate the Laplace transform $F(s)$ of the unshifted function:\n\n$$\nF(s)=L\\{{e}^{-4t}\\}=\\frac{1}{s-(-4)}=\\frac{1}{s+4}.\n$$\n\nFinally, we apply the shifting theorem formula $L\\{u(t-a)\\,f(t-a)\\}={e}^{-as}F(s)$ by multiplying $F(s)$ by the exponential delay factor ${e}^{-5s}:$\n\n$$\n\\begin{aligned}L\\{u(t-5){e}^{-4(t-5)}\\} & ={e}^{-5s}\\cdot F(s) \\\\  & ={e}^{-5s}\\cdot \\frac{1}{s+4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186552445 :knowledge-point/_questions [{:db/id #edb/ref 17592186221442 :knowledge-point/id #uuid "d22ba3ca-cf7a-5a77-abf6-8620076552bb" :knowledge-point/title "Using the Alternative Form of the Second Shifting Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5b267702-7b91-5685-a1de-2fb45f2e77c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{3s}\\cdot \\frac{2}{{s}^{2}+4}" :db/id #edb/ref 17592186551882} {:answer/id #uuid "6a956bbc-d525-56bf-9c7a-afa83a985bc5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-3s}\\cdot \\frac{2}{{s}^{2}+9}" :db/id #edb/ref 17592186551912} {:answer/id #uuid "844250c0-ee16-5b65-8f7d-e4e28c5aa166" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-3s}\\cdot \\frac{2}{{s}^{2}+4}" :db/id #edb/ref 17592186551981} {:answer/id #uuid "895d4c73-bd70-55be-9fae-56d5b12e2262" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-3s}\\cdot \\frac{s}{{s}^{2}+4}" :db/id #edb/ref 17592186551999} {:answer/id #uuid "d639534f-b363-5652-be39-0437a15b65f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-2s}\\cdot \\frac{2}{{s}^{2}+4}" :db/id #edb/ref 17592186552169}] :answer-field/correct {:answer/id #uuid "844250c0-ee16-5b65-8f7d-e4e28c5aa166" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-3s}\\cdot \\frac{2}{{s}^{2}+4}" :db/id #edb/ref 17592186551981} :answer-field/id #uuid "d302d8d0-a52c-5d96-af0e-a8aba2fe7b7f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552375}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "669dd3eb-164c-527e-a5e3-447099f637bc" :question/math-academy-id "q-342636" :question/problem "Given that\n\n$$\n\\begin{aligned}L\\{\\operatorname{sin}⁡\\omega t\\}=\\frac{\\omega }{{s}^{2}+{\\omega }^{2}},\\,L\\{\\operatorname{cos}⁡\\omega t\\}=\\frac{s}{{s}^{2}+{\\omega }^{2}},\\,s>0,\\end{aligned}\n$$\n\nfind $L\\{u(t-3)sin\\,(2(t-3))\\},$ where $u(t)$ is the unit step function." :question/worked-solution "The second shifting theorem states that if $a\\ge 0,$ then\n\n$$\nL\\{u(t-a)\\,f(t-a)\\}={e}^{-as}F(s),\n$$\n\nwhere $F(s)=L\\{f(t)\\}.$\n\nIn our case, we wish to find the transform of\n\n$$\nu(t-3)sin\\,(2(t-3)).\n$$\n\nBy comparing this expression to the form in the theorem, we can identify the following:\n\n- The shift is $a=3.$\n\n- The shifted function is $f(t-3)=sin\\,(2(t-3)).$\n\nFrom the shifted function, we can deduce the original unshifted function $f(t)$ by simply replacing $(t-3)$ with $t:$\n\n$$\nf(t)=\\operatorname{sin}⁡(2t).\n$$\n\nNow, we calculate the Laplace transform $F(s)$ of the unshifted function:\n\n$$\nF(s)=L\\{\\operatorname{sin}⁡(2t)\\}=\\frac{2}{{s}^{2}+4}.\n$$\n\nFinally, we apply the shifting theorem formula $L\\{u(t-a)\\,f(t-a)\\}={e}^{-as}F(s)$ by multiplying $F(s)$ by the exponential delay factor ${e}^{-3s}:$\n\n$$\n\\begin{aligned}L\\{u(t-3)sin\\,(2(t-3))\\} & ={e}^{-3s}\\cdot F(s) \\\\  & ={e}^{-3s}\\cdot \\frac{2}{{s}^{2}+4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186317303 :knowledge-point/_questions [{:db/id #edb/ref 17592186221442 :knowledge-point/id #uuid "d22ba3ca-cf7a-5a77-abf6-8620076552bb" :knowledge-point/title "Using the Alternative Form of the Second Shifting Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5b441a05-7dcd-500c-b5f3-1f8f7266d9bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-3s}\\cdot \\frac{s}{{s}^{2}+25}" :db/id #edb/ref 17592186315636} {:answer/id #uuid "66830cd9-77af-55ac-be6b-2d513c622c27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{3s}\\cdot \\frac{5}{{s}^{2}+25}" :db/id #edb/ref 17592186315689} {:answer/id #uuid "a94dcaee-6be9-5b91-beb8-a7cf73427afb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-5s}\\cdot \\frac{5}{{s}^{2}+25}" :db/id #edb/ref 17592186316070} {:answer/id #uuid "cfa82261-c35f-53b2-824a-017ff4374f78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-3s}\\cdot \\frac{5}{{s}^{2}+25}" :db/id #edb/ref 17592186316291} {:answer/id #uuid "f50aa82b-f49c-5cc4-bb7a-ff4be251ca13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :an