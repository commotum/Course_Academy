 17592186045417] [17592186304284 #edb/ref 1075 #edb/ref 17592186303321 #edb/ref 17592186045417] [17592186304284 #edb/ref 1075 #edb/ref 17592186303354 #edb/ref 17592186045417] [17592186304284 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186304284 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186304284 #edb/ref 1078 #edb/ref 17592186303354 #edb/ref 17592186045417] [17592186304284 #edb/ref 1079 #uuid "4bd4e453-e8db-56ba-b356-f272dfe52e18" #edb/ref 17592186045417] [17592186304412 #edb/ref 1075 #edb/ref 17592186302738 #edb/ref 17592186045417] [17592186304412 #edb/ref 1075 #edb/ref 17592186302757 #edb/ref 17592186045417] [17592186304412 #edb/ref 1075 #edb/ref 17592186302905 #edb/ref 17592186045417] [17592186304412 #edb/ref 1075 #edb/ref 17592186303471 #edb/ref 17592186045417] [17592186304412 #edb/ref 1075 #edb/ref 17592186303911 #edb/ref 17592186045417] [17592186304412 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186304412 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186304412 #edb/ref 1078 #edb/ref 17592186302757 #edb/ref 17592186045417] [17592186304412 #edb/ref 1079 #uuid "7d5ff6dd-95cc-5416-ae98-7823d1849772" #edb/ref 17592186045417] [17592186304589 #edb/ref 1075 #edb/ref 17592186302729 #edb/ref 17592186045417] [17592186304589 #edb/ref 1075 #edb/ref 17592186302915 #edb/ref 17592186045417] [17592186304589 #edb/ref 1075 #edb/ref 17592186303248 #edb/ref 17592186045417] [17592186304589 #edb/ref 1075 #edb/ref 17592186303395 #edb/ref 17592186045417] [17592186304589 #edb/ref 1075 #edb/ref 17592186304045 #edb/ref 17592186045417] [17592186304589 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186304589 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186304589 #edb/ref 1078 #edb/ref 17592186302729 #edb/ref 17592186045417] [17592186304589 #edb/ref 1079 #uuid "bc980550-ee73-5cb8-8125-19a252a97e29" #edb/ref 17592186045417] [17592186304873 #edb/ref 1068 #edb/ref 17592186304412 #edb/ref 17592186045417] [17592186304873 #edb/ref 1069 "q-331017" #edb/ref 17592186045417] [17592186304873 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186304873 #edb/ref 1071 "Given that $L\\{{t}^{n}\\}=\\frac{n!}{{s}^{n+1}}$ for $s>0$, find $L\\{u(t-6)({t}^{2}-t+3)\\},$ where $u(t)$ is the unit step function." #edb/ref 17592186045417] [17592186304873 #edb/ref 1072 #uuid "0f92e95f-43ab-59a9-949c-e31e679c7c82" #edb/ref 17592186045417] [17592186304873 #edb/ref 1074 "The second shifting theorem states that if $a\\ge 0$ and $L\\{u(t-a)\\,g(t)\\}$ exists for $s>{s}_{0},$ then\n\n$$\nL\\{u(t-a)\\,g(t)\\}={e}^{-as}\\,L\\{g(t+a)\\},\\,\\text{for}\\,s>{s}_{0},\n$$\n\nwhere $u(t)$ is the unit step function.\n\nIn our case, we wish to find\n\n$$\nL\\{u(t-6)({t}^{2}-t+3)\\}.\n$$\n\nTherefore, $a=6,$ and we have \n\n$$\nL\\{u(t-6)\\,g(t)\\}={e}^{-6s}\\,L\\{g(t+6)\\},\n$$\n\nwhere $g(t)={t}^{2}-t+3.$\n\nNotice that\n\n$$\n\\begin{aligned}g(t+6) & =(t+6)^{2}-(t+6)+3 \\\\  & ={t}^{2}+12t+36\\,-\\,t-6\\,+\\,3 \\\\  & ={t}^{2}+11t+33.\\end{aligned}\n$$\n\nSince $L\\{{t}^{n}\\}=\\frac{n!}{{s}^{n+1}}$ and $L\\{1\\}=\\frac{1}{s}$ for $s>0,$ we have\n\n$$\n\\begin{aligned}L\\{g(t+6)\\} & =L\\{{t}^{2}+11t+33\\} \\\\  & =L\\{{t}^{2}\\}+11L\\{t\\}+33L\\{1\\} \\\\  & =\\frac{2}{{s}^{3}}+11\\cdot \\frac{1}{{s}^{2}}+33\\cdot \\frac{1}{s} \\\\  & =\\frac{2}{{s}^{3}}+\\frac{11}{{s}^{2}}+\\frac{33}{s}.\\end{aligned}\n$$\n\nTherefore, applying the second shifting theorem, we get\n\n$$\n\\begin{aligned}L\\{u(t-6)\\,g(t)\\} & ={e}^{-6s}\\,L\\{g(t+6)\\} \\\\  & ={e}^{-6s}(\\frac{2}{{s}^{3}}+\\frac{11}{{s}^{2}}+\\frac{33}{s}).\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186304875 #edb/ref 1068 #edb/ref 17592186304589 #edb/ref 17592186045417] [17592186304875 #edb/ref 1069 "q-331025" #edb/ref 17592186045417] [17592186304875 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186304875 #edb/ref 1071 "Given that $L\\{{t}^{n}\\}=\\frac{n!}{{s}^{n+1}}$ for $s>0$, find $L\\{u(t-11)({t}^{2}-2t+5)\\},$ where $u(t)$ is the unit step function." #edb/ref 17592186045417] [17592186304875 #edb/ref 1072 #uuid "b2f62fcb-3c2f-57e7-b9f2-f62f3e2f0d4d" #edb/ref 17592186045417] [17592186304875 #edb/ref 1074 "The second shifting theorem states that if $a\\ge 0$ and $L\\{u(t-a)\\,g(t)\\}$ exists for $s>{s}_{0},$ then\n\n$$\nL\\{u(t-a)\\,g(t)\\}={e}^{-as}\\,L\\{g(t+a)\\},\\,\\text{for}\\,s>{s}_{0},\n$$\n\nwhere $u(t)$ is the unit step function.\n\nIn our case, we wish to find\n\n$$\nL\\{u(t-11)({t}^{2}-2t+5)\\}.\n$$\n\nTherefore, $a=11,$ and we have \n\n$$\nL\\{u(t-11)\\,g(t)\\}={e}^{-11s}\\,L\\{g(t+11)\\},\n$$\n\nwhere $g(t)={t}^{2}-2t+5.$\n\nNotice that\n\n$$\n\\begin{aligned}g(t+11) & =(t+11)^{2}-2(t+11)+5 \\\\  & ={t}^{2}+22t+121\\,-\\,2t-22\\,+\\,5 \\\\  & ={t}^{2}+20t+104.\\end{aligned}\n$$\n\nSince $L\\{{t}^{n}\\}=\\frac{n!}{{s}^{n+1}}$ and $L\\{1\\}=\\frac{1}{s}$ for $s>0,$ we have\n\n$$\n\\begin{aligned}L\\{g(t+11)\\} & =L\\{{t}^{2}+20t+104\\} \\\\  & =L\\{{t}^{2}\\}+20L\\{t\\}+104L\\{1\\} \\\\  & =\\frac{2}{{s}^{3}}+20\\cdot \\frac{1}{{s}^{2}}+104\\cdot \\frac{1}{s} \\\\  & =\\frac{2}{{s}^{3}}+\\frac{20}{{s}^{2}}+\\frac{104}{s}.\\end{aligned}\n$$\n\nTherefore, applying the second shifting theorem, we get\n\n$$\n\\begin{aligned}L\\{u(t-11)\\,g(t)\\} & ={e}^{-11s}\\,L\\{g(t+11)\\} \\\\  & ={e}^{-11s}(\\frac{2}{{s}^{3}}+\\frac{20}{{s}^{2}}+\\frac{104}{s}).\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186304879 #edb/ref 1068 #edb/ref 17592186304244 #edb/ref 17592186045417] [17592186304879 #edb/ref 1069 "q-331040" #edb/ref 17592186045417] [17592186304879 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186304879 #edb/ref 1071 "Given that\n\n$$\n\\begin{aligned}L\\{\\operatorname{sin}⁡\\omega t\\} & =\\frac{\\omega }{{s}^{2}+{\\omega }^{2}}, &  & s>0, \\\\ L\\{\\operatorname{cos}⁡\\omega t\\} & =\\frac{s}{{s}^{2}+{\\omega }^{2}}, &  & s>0,\\end{aligned}\n$$\n\nfind $L\\{u(t-2)\\,\\operatorname{sin}⁡(\\pi t)\\},$ where $u(t)$ is the unit step function." #edb/ref 17592186045417] [17592186304879 #edb/ref 1072 #uuid "477fdf0a-8165-5144-ad0b-72ada4a489e8" #edb/ref 17592186045417] [17592186304879 #edb/ref 1074 "The second shifting theorem states that if $a\\ge 0$ and $L\\{u(t-a)\\,g(t)\\}$ exists for $s>{s}_{0},$ then\n\n$$\nL\\{u(t-a)\\,g(t)\\}={e}^{-as}\\,L\\{g(t+a)\\},\\,\\text{for}\\,s>{s}_{0},\n$$\n\nwhere $u(t)$ is the unit step function.\n\nIn our case, we wish to find\n\n$$\nL\\{u(t-2)\\,\\operatorname{sin}⁡(\\pi t)\\}.\n$$\n\nTherefore, $a=2,$ and we have \n\n$$\nL\\{u(t-2)\\,g(t)\\}={e}^{-2s}\\,L\\{g(t+2)\\},\n$$\n\nwhere $g(t)=\\operatorname{sin}⁡(\\pi t).$\n\nNotice that\n\n$$\n\\begin{aligned}g(t+2) & =sin\\,(\\pi (t+2)) \\\\  & =\\operatorname{sin}⁡(\\pi t+2\\pi ) \\\\  & =\\operatorname{sin}⁡\\pi t\\operatorname{cos}⁡2\\pi +\\operatorname{cos}⁡\\pi t\\operatorname{sin}⁡2\\pi  \\\\  & =\\operatorname{sin}⁡\\pi t\\cdot 1+\\operatorname{cos}⁡\\pi t\\cdot 0 \\\\  & =\\operatorname{sin}⁡\\pi t.\\end{aligned}\n$$\n\nSince $L\\{\\operatorname{sin}⁡(\\omega t)\\}=\\frac{\\omega }{{s}^{2}+{\\omega }^{2}}$ for $s>0,$ we have\n\n$$\n\\begin{aligned}L\\{g(t+2)\\} & =L\\{\\operatorname{sin}⁡(\\pi t)\\} \\\\  & =\\frac{\\pi }{{s}^{2}+{\\pi }^{2}}.\\end{aligned}\n$$\n\nTherefore, applying the second shifting theorem, we get\n\n$$\n\\begin{aligned}L\\{u(t-2)\\,g(t)\\} & ={e}^{-2s}\\,L\\{g(t+2)\\} \\\\  & ={e}^{-2s}\\cdot \\frac{\\pi }{{s}^{2}+{\\pi }^{2}}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186304880 #edb/ref 1068 #edb/ref 17592186304284 #edb/ref 17592186045417] [17592186304880 #edb/ref 1069 "q-331042" #edb/ref 17592186045417] [17592186304880 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186304880 #edb/ref 1071 "Given that\n\n$$\n\\begin{aligned}L\\{\\operatorname{sin}⁡\\omega t\\} & =\\frac{\\omega }{{s}^{2}+{\\omega }^{2}}, &  & s>0, \\\\ L\\{\\operatorname{cos}⁡\\omega t\\} & =\\frac{s}{{s}^{2}+{\\omega }^{2}}, &  & s>0,\\end{aligned}\n$$\n\nfi