 #uuid "31b49dd0-7130-505e-8975-5b6b86b0fd97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186421256} :answer-field/id #uuid "cb37fa92-34ce-5da3-9cc2-7439e9823eb3" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186421305} {:answer-field/choices [{:answer/id #uuid "2197f3d2-6e07-5ebe-bd6c-f3c30c3e35f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186421252} {:answer/id #uuid "8e130257-ffbb-5f17-ab93-5d676d75e801" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1)" :db/id #edb/ref 17592186421276} {:answer/id #uuid "a63475ff-0ba5-51bf-a4b7-d1c5078139e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186421279}] :answer-field/correct {:answer/id #uuid "8e130257-ffbb-5f17-ab93-5d676d75e801" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1)" :db/id #edb/ref 17592186421276} :answer-field/id #uuid "e75553da-6c04-50a4-a94c-aab86bb8cabd" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186421306}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "47c9e11d-3763-56a1-a6fd-21b1255f236b" :question/math-academy-id "q-334011" :question/problem "Given the set of functions ${\\operatorname{sin}⁡x,\\,{e}^{x},\\,3\\operatorname{sin}⁡x}$ defined on $x\\in R,$ select the correct options in the following reasoning.\n\nFor all $x\\in R,$ we have that\n\n$$\n{{field-1}}\\cdot \\operatorname{sin}⁡x+{{field-2}}\\cdot {e}^{x}+{{field-3}}\\cdot 3\\operatorname{sin}⁡x=0.\n$$\n\nSince \n{{field-4}} \nthe scalar coefficients in the linear combination are zero, the given set of functions is linearly \n{{field-5}}." :question/worked-solution "Recall that the set of functions ${{f}_{1}(x),{f}_{2}(x),…,{f}_{n}(x)},$ which are defined on some interval $I,$ is *linearly dependent* if there exist real scalars ${k}_{1},{k}_{2},…,{k}_{n}$ not all zero such that the linear combination ${k}_{1}\\cdot {f}_{1}+{k}_{2}\\cdot {f}_{2}+…+{k}_{n}\\cdot {f}_{n}$ is identically zero, i.e, \n\n$$\n{k}_{1}\\cdot {f}_{1}(x)+{k}_{2}\\cdot {f}_{2}(x)+…+{k}_{n}\\cdot {f}_{n}(x)=0\n$$\n\nfor all $x\\in I.$ Otherwise, if ${k}_{1}={k}_{2}=⋯={k}_{n}=0$ is the only solution, the set is *linearly independent*.\n\nNow, for all $x\\in R,$ we have that \n\n$$\n3\\cdot \\operatorname{sin}⁡x+0\\cdot {e}^{x}+(-1)\\cdot 3\\operatorname{sin}⁡x=0.\n$$\n\n  \n\nTherefore, since $\\text{not all}$ the scalar coefficients in the linear combination are zero, the given set of functions is linearly $\\text{dependent}.$"}] [{:db/id #edb/ref 17592186421313 :knowledge-point/_questions [{:db/id #edb/ref 17592186152277 :knowledge-point/id #uuid "fe4c8bb4-b7c0-5afc-86fd-40c20df9b953" :knowledge-point/title "Identifying Pairs of Linearly Dependent and Linearly Independent Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10ba94b5-d5f6-561b-b2e2-a78ef02bf1f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{k}_{1}+{k}_{2}=0" :db/id #edb/ref 17592186421246} {:answer/id #uuid "b048ca70-d1f0-56c3-a28c-d0e5a258697c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{k}_{1}-{k}_{2}=0" :db/id #edb/ref 17592186421280} {:answer/id #uuid "b1b7e62e-b69d-5648-8b53-98d08560d756" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{k}_{2}=0" :db/id #edb/ref 17592186421281} {:answer/id #uuid "e36b9598-f179-5762-9811-35f0a0c1da39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{k}_{1}=0" :db/id #edb/ref 17592186421291}] :ans