139534820 17592186045417 true] [17592186437062 1076 #edb/ref 17592186045493 13194139534820 17592186045417 true] [17592186437062 1077 "selection" 13194139534820 17592186045417 true] [17592186437062 1078 #edb/ref 17592186437059 13194139534820 17592186045417 true] [17592186437062 1079 #uuid "c70a1919-efd3-511f-9ea6-f55df071b113" 13194139534820 17592186045417 true] [17592186437063 1068 #edb/ref 17592186437061 13194139534820 17592186045417 true] [17592186437063 1069 "q-80817" 13194139534820 17592186045417 true] [17592186437063 1070 #edb/ref 17592186045487 13194139534820 17592186045417 true] [17592186437063 1071 "Let $B=\\{{b}_{1},{b}_{2},{b}_{3}\\}$ be a basis of ${R}^{3}$ and $[x]_{B}=[\\begin{aligned}8 \\\\ -2 \\\\ 3\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C=\\{{c}_{1},{c}_{2},{c}_{3}\\},$ where ${c}_{1}=-4{b}_{3}$, ${c}_{2}=5{b}_{1}$ and ${c}_{3}=-3{b}_{2}?$" 13194139534820 17592186045417 true] [17592186437063 1072 #uuid "52843c58-6ada-5ce6-8fe3-a0a1c897ac6d" 13194139534820 17592186045417 true] [17592186437063 1074 "Since $[x]_{B}=[\\begin{aligned}8 \\\\ -2 \\\\ 3\\end{aligned}]$, we can write $x$ as follows:\n\n$$\n\\begin{aligned}x & =8{b}_{1}-2{b}_{2}+3{b}_{3} \\\\  & =3{b}_{3}+8{b}_{1}-2{b}_{2} \\\\  & =-\\frac{3}{4}(-4{b}_{3})+\\frac{8}{5}(5{b}_{1})+\\frac{2}{3}(-3{b}_{2}) \\\\  & =-\\frac{3}{4}{c}_{1}+\\frac{8}{5}{c}_{2}+\\frac{2}{3}{c}_{3}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}-\\frac{3}{4} \\\\ \\frac{8}{5} \\\\ \\frac{2}{3}\\end{aligned}].$" 13194139534820 17592186045417 true] [17592186437064 1068 #edb/ref 17592186437062 13194139534820 17592186045417 true] [17592186437064 1069 "q-112862" 13194139534820 17592186045417 true] [17592186437064 1070 #edb/ref 17592186045487 13194139534820 17592186045417 true] [17592186437064 1071 "Let $B=\\{{b}_{1},{b}_{2}\\}$ be a basis of ${R}^{2}$ and $[x]_{B}=[\\begin{aligned}1 \\\\ -5\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C=\\{{c}_{1},{c}_{2}\\},$ where ${c}_{1}=2{b}_{2}$ and ${c}_{2}={b}_{1}+{b}_{2}?$" 13194139534820 17592186045417 true] [17592186437064 1072 #uuid "b0e4cc3b-3144-5373-932e-12723fa2aecf" 13194139534820 17592186045417 true] [17592186437064 1074 "We are given that\n\n$$\n\\{\\begin{aligned}{c}_{1}=2{b}_{2} \\\\ {c}_{2}={b}_{1}+{b}_{2}.\\end{aligned}\n$$\n\nFirst, we express the $b$'s in terms of $c$'s. From the first equation, we get \n\n$$\n{b}_{2}=\\frac{1}{2}{c}_{1}.\n$$\n\nSubstituting this into the second equation, we obtain\n\n$$\n{c}_{2}={b}_{1}+(\\frac{1}{2}{c}_{1})\\,⟹\\,{b}_{1}=-\\frac{1}{2}{c}_{1}+{c}_{2}.\n$$\n\n \n\nSince $[x]_{B}=[\\begin{aligned}1 \\\\ -5\\end{aligned}]$, we can write the vector $x$ as follows:\n\n$$\n\\begin{aligned}x & ={b}_{1}-5{b}_{2} \\\\  & =-\\frac{1}{2}{c}_{1}+{c}_{2}-5(\\frac{1}{2}{c}_{1}) \\\\  & =-\\frac{6}{2}{c}_{1}+{c}_{2} \\\\  & =-3{c}_{1}+{c}_{2}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}-3 \\\\ 1\\end{aligned}].$" 13194139534820 17592186045417 true] [17592186437065 1058 #edb/ref 17592186437067 13194139534820 17592186045417 true] [17592186437065 1062 #uuid "0e41dcfd-ebac-5aca-b944-04ffca0796dd" 13194139534820 17592186045417 true] [17592186437065 1063 #edb/ref 17592186351269 13194139534820 17592186045417 true] [17592186437066 1058 #edb/ref 17592186437065 13194139534820 17592186045417 true] [17592186437066 1062 #uuid "59637308-9cf1-5b00-baa5-bb0d666676d8" 13194139534820 17592186045417 true] [17592186437066 1063 #edb/ref 17592186437063 13194139534820 17592186045417 true] [17592186437067 1058 #edb/ref 17592186437069 13194139534820 17592186045417 true] [17592186437067 1062 #uuid "97825df6-b0ae-5545-b8e4-947e68d7f416" 13194139534820 17592186045417 true] [17592186437067 1063 #edb/ref 17592186437064 13194139534820 17592186045417 true] [17592186437068 1058 #edb/ref 17592186437066 13194139534820 17592186045417 true] [17592186437068 1062 #uuid "c00bf068-2766-50a6-930e-60ed75e6af41" 13194139534820 17592186045417 true] [17592186437068 1063 