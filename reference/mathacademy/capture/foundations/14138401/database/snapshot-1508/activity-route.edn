#{[{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186437068} :activity/id #uuid "0c84172f-333c-5d02-8355-912cd7cfa911" :activity/scope {:db/id #edb/ref 17592186048762 :topic/id #uuid "bc92d9a7-3663-5495-a1b9-4cf735034158" :topic/math-academy-id 1865} :activity/steps [{:db/id #edb/ref 17592186437065 :step/content {:db/id #edb/ref 17592186351269 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "278b95ec-9543-5b30-8694-705447b2953b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}-5 \\\\ 8 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186348788} {:answer/id #uuid "29c427aa-c438-59b7-8563-b8b32e5248b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}5 \\\\ 4 \\\\ 6\\end{aligned}]" :db/id #edb/ref 17592186348814} {:answer/id #uuid "db1f2b2a-d728-5c5c-9080-4a279744ceb1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}-8 \\\\ -3 \\\\ 5\\end{aligned}]" :db/id #edb/ref 17592186350368} {:answer/id #uuid "dfb90321-e3c6-5d76-9f86-67160a3d6885" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}3 \\\\ -6 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186350406} {:answer/id #uuid "e4d32b6e-0307-52a7-92e6-dc39f86df2b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}-3 \\\\ 5 \\\\ -8\\end{aligned}]" :db/id #edb/ref 17592186350452}] :answer-field/correct {:db/id #edb/ref 17592186350368} :answer-field/id #uuid "3435a83d-541e-550d-b30c-5b4a35d85a6b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186350797}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a06d0486-59a2-551d-a3de-4b2482e5c06f" :question/math-academy-id "q-81228" :question/problem "Let $B=\\{{b}_{1},{b}_{2},{b}_{3}\\}$ be a basis of ${R}^{3}$ and $[x]_{B}=[\\begin{aligned}15 \\\\ -24 \\\\ 18\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C=\\{{c}_{1},{c}_{2},{c}_{3}\\},$ where ${c}_{1}=3{b}_{2}$, ${c}_{2}=-6{b}_{3}$ and ${c}_{3}=3{b}_{1}?$" :question/worked-solution "Since $[x]_{B}=[\\begin{aligned}15 \\\\ -24 \\\\ 18\\end{aligned}]$, we can write $x$ as follows:\n\n$$\n\\begin{aligned}x & =15{b}_{1}-24{b}_{2}+18{b}_{3} \\\\  & =-24{b}_{2}+18{b}_{3}+15{b}_{1} \\\\  & =-8(3{b}_{2})-3(-6{b}_{3})+5(3{b}_{1}) \\\\  & =-8{c}_{1}-3{c}_{2}+5{c}_{3}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}-8 \\\\ -3 \\\\ 5\\end{aligned}].$"} :step/id #uuid "0e41dcfd-ebac-5aca-b944-04ffca0796dd" :step/next {:db/id #edb/ref 17592186437067}} {:db/id #edb/ref 17592186437066 :step/content {:db/id #edb/ref 17592186437063 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a201169-6127-5146-ac33-370dbaeb9fed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}-\\frac{3}{4} \\\\ \\frac{8}{5} \\\\ \\frac{2}{3}\\end{aligned}]" :db/id #edb/ref 17592186437052} {:answer/id #uuid "6d16febb-185e-5f02-b767-d0d169b5dbfe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}4 \\\\ 5 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186437053} {:answer/id #uuid "7cf45f1d-e7fe-5ad3-af94-a089a9eeec5f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}-3 \\\\ 8 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186437054} {:answer/id #uuid "e664d5e6-21e0-5873-967f-9bc8ff95c930" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}\\frac{8}{5} \\\\ \\frac{2}{3} \\\\ -\\frac{3}{4}\\end{aligned}]" :db/id #edb/ref 17592186437057} {:answer/id #uuid "eb796ee2-fa6f-5226-9fdb-c601791894cc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}\\frac{3}{4} \\\\ \\frac{8}{5} \\\\ \\frac{2}{3}\\end{aligned}]" :db/id #edb/ref 17592186437060}] :answer-field/correct {:db/id #edb/ref 17592186437052} :answer-field/id #uuid "5dfb7050-a4fe-5646-9ebf-d0c4cc689423" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186437061}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "52843c58-6ada-5ce6-8fe3-a0a1c897ac6d" :question/math-academy-id "q-80817" :question/problem "Let $B=\\{{b}_{1},{b}_{2},{b}_{3}\\}$ be a basis of ${R}^{3}$ and $[x]_{B}=[\\begin{aligned}8 \\\\ -2 \\\\ 3\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C=\\{{c}_{1},{c}_{2},{c}_{3}\\},$ where ${c}_{1}=-4{b}_{3}$, ${c}_{2}=5{b}_{1}$ and ${c}_{3}=-3{b}_{2}?$" :question/worked-solution "Since $[x]_{B}=[\\begin{aligned}8 \\\\ -2 \\\\ 3\\end{aligned}]$, we can write $x$ as follows:\n\n$$\n\\begin{aligned}x & =8{b}_{1}-2{b}_{2}+3{b}_{3} \\\\  & =3{b}_{3}+8{b}_{1}-2{b}_{2} \\\\  & =-\\frac{3}{4}(-4{b}_{3})+\\frac{8}{5}(5{b}_{1})+\\frac{2}{3}(-3{b}_{2}) \\\\  & =-\\frac{3}{4}{c}_{1}+\\frac{8}{5}{c}_{2}+\\frac{2}{3}{c}_{3}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}-\\frac{3}{4} \\\\ \\frac{8}{5} \\\\ \\frac{2}{3}\\end{aligned}].$"} :step/id #uuid "59637308-9cf1-5b00-baa5-bb0d666676d8" :step/next {:db/id #edb/ref 17592186437065}} {:db/id #edb/ref 17592186437067 :step/content {:db/id #edb/ref 17592186437064 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e4d1efa-0b11-5604-b83d-1cafc0e12e97" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}6 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186437051} {:answer/id #uuid "c9b65cef-3b11-5aa5-8c39-6a1bd856ef09" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}-3 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186437055} {:answer/id #uuid "cb6a6cb4-14b9-5dc8-a71d-66abf40eedf6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}3 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186437056} {:answer/id #uuid "e6f678ca-51ca-5faa-80f3-6687002731fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}\\frac{1}{2} \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186437058} {:answer/id #uuid "e97d3d12-325a-5425-988a-d90f7923ca9c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}-3 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186437059}] :answer-field/correct {:db/id #edb/ref 17592186437059} :answer-field/id #uuid "c70a1919-efd3-511f-9ea6-f55df071b113" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186437062}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b0e4cc3b-3144-5373-932e-12723fa2aecf" :question/math-academy-id "q-112862" :question/problem "Let $B=\\{{b}_{1},{b}_{2}\\}$ be a basis of ${R}^{2}$ and $[x]_{B}=[\\begin{aligned}1 \\\\ -5\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C=\\{{c}_{1},{c}_{2}\\},$ where ${c}_{1}=2{b}_{2}$ and ${c}_{2}={b}_{1}+{b}_{2}?$" :question/worked-solution "We are given that\n\n$$\n\\{\\begin{aligned}{c}_{1}=2{b}_{2} \\\\ {c}_{2}={b}_{1}+{b}_{2}.\\end{aligned}\n$$\n\nFirst, we express the $b$'s in terms of $c$'s. From the first equation, we get \n\n$$\n{b}_{2}=\\frac{1}{2}{c}_{1}.\n$$\n\nSubstituting this into the second equation, we obtain\n\n$$\n{c}_{2}={b}_{1}+(\\frac{1}{2}{c}_{1})\\,⟹\\,{b}_{1}=-\\frac{1}{2}{c}_{1}+{c}_{2}.\n$$\n\n \n\nSince $[x]_{B}=[\\begin{aligned}1 \\\\ -5\\end{aligned}]$, we can write the vector $x$ as follows:\n\n$$\n\\begin{aligned}x & ={b}_{1}-5{b}_{2} \\\\  & =-\\frac{1}{2}{c}_{1}+{c}_{2}-5(\\frac{1}{2}{c}_{1}) \\\\  & =-\\frac{6}{2}{c}_{1}+{c}_{2} \\\\  & =-3{c}_{1}+{c}_{2}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}-3 \\\\ 1\\end{aligned}].$"} :step/id #uuid "97825df6-b0ae-5545-b8e4-947e68d7f416" :step/next {:db/id #edb/ref 17592186437069}} {:db/id #edb/ref 17592186437068 :step/content {:db/id #edb/ref 17592186321001 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c1f3a69-7740-5aa2-925c-53c1ce3286b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}-1 \\\\ -4\\end{aligned}]" :db/id #edb/ref 17592186319532} {:answer/id #uuid "66b1a873-459f-552e-a7e5-027c42c7521c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}-\\frac{5}{2} \\\\ -3\\end{aligned}]" :db/id #edb/ref 17592186319705} {:answer/id #uuid "8891e75e-27cb-5964-9e25-018084c2ca28" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}2 \\\\ -\\frac{3}{2}\\end{aligned}]" :db/id #edb/ref 17592186319799} {:answer/id #uuid "9d0ae0bb-3fdb-536c-87d0-6e5d6c437047" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}-\\frac{6}{5} \\\\ -\\frac{3}{2}\\end{aligned}]" :db/id #edb/ref 17592186319862} {:answer/id #uuid "c86c86a5-b326-5d1c-b7a9-87d860ce9998" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}\\frac{3}{2} \\\\ \\frac{3}{5}\\end{aligned}]" :db/id #edb/ref 17592186320002}] :answer-field/correct {:db/id #edb/ref 17592186319862} :answer-field/id #uuid "4da19070-3706-599c-9a4c-66595b84535c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186320333}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c8522320-65f1-531f-bee8-8f3ee0c26cf8" :question/math-academy-id "q-35257" :question/problem "Let $B=\\{{b}_{1},{b}_{2}\\}$ be a basis of ${R}^{2}$ and $[x]_{B}=[\\begin{aligned}3 \\\\ -6\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C=\\{{c}_{1},{c}_{2}\\},$ where ${c}_{1}=5{b}_{2}$ and ${c}_{2}=-2{b}_{1}?$" :question/worked-solution "Since $[x]_{B}=[\\begin{aligned}3 \\\\ -6\\end{aligned}]$, we can write $x$ as follows:\n\n$$\n\\begin{aligned}x & =3{b}_{1}-6{b}_{2} \\\\  & =-6{b}_{2}+3{b}_{1} \\\\  & =-\\frac{6}{5}(5{b}_{2})-\\frac{3}{2}(-2{b}_{1}) \\\\  & =-\\frac{6}{5}{c}_{1}-\\frac{3}{2}{c}_{2}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}-\\frac{6}{5} \\\\ -\\frac{3}{2}\\end{aligned}].$"} :step/id #uuid "c00bf068-2766-50a6-930e-60ed75e6af41" :step/next {:db/id #edb/ref 17592186437066}} {:db/id #edb/ref 17592186437069 :step/content {:db/id #edb/ref 17592186432499 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06929580-b4ba-53af-ac69-8bc84360d71e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}-5 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186432469} {:answer/id #uuid "6599960a-b761-54ae-800a-4099e8dc6454" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}3 \\\\ 7\\end{aligned}]" :db/id #edb/ref 17592186432480} {:answer/id #uuid "7238f33a-029e-5920-a373-cb968bcc10aa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}7 \\\\ -3\\end{aligned}]" :db/id #edb/ref 17592186432481} {:answer/id #uuid "7960b759-a049-517f-91ce-8f3d3d4ab81c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}-3 \\\\ 5\\end{aligned}]" :db/id #edb/ref 17592186432482} {:answer/id #uuid "8d5905dd-9d56-563e-ab3a-014628903d88" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}7 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186432484}] :answer-field/correct {:db/id #edb/ref 17592186432480} :answer-field/id #uuid "4c066721-df4d-58dc-9748-1ef1119a9c18" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186432494}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1f3bd7e4-e9ee-5ec1-b495-697d442c712e" :question/math-academy-id "q-113070" :question/problem "Let $B=\\{{b}_{1},{b}_{2}\\}$ be a basis of ${R}^{2}$ and $[x]_{B}=[\\begin{aligned}-1 \\\\ 3\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C=\\{{c}_{1},{c}_{2}\\},$ where ${c}_{1}=2{b}_{1}+{b}_{2}$ and ${c}_{2}=-{b}_{1}?$" :question/worked-solution "We are given that\n\n$$\n\\{\\begin{aligned}{c}_{1}=2{b}_{1}+{b}_{2} \\\\ {c}_{2}=-{b}_{1}.\\end{aligned}\n$$\n\nFirst, we express the $b$'s in terms of $c$'s. From the second equation, we get \n\n$$\n{b}_{1}=-{c}_{2}.\n$$\n\nSubstituting this into the first equation, we obtain\n\n$$\n{c}_{1}=2(-{c}_{2})+{b}_{2}\\,⟹\\,{b}_{2}={c}_{1}+2{c}_{2}.\n$$\n\nSince $[x]_{B}=[\\begin{aligned}-1 \\\\ 3\\end{aligned}]$, we can write the vector $x$ as follows: \n\n$$\n\\begin{aligned}x & =-{b}_{1}+3{b}_{2} \\\\  & =-(-{c}_{2})+3({c}_{1}+2{c}_{2}) \\\\  & ={c}_{2}+3{c}_{1}+6{c}_{2} \\\\  & =7{c}_{2}+3{c}_{1}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}3 \\\\ 7\\end{aligned}].$"} :step/id #uuid "edd9f346-183f-5c36-8e34-bd14bd1d6d98"}] :activity/title "Writing Vectors in Different Bases" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186437050}]}
