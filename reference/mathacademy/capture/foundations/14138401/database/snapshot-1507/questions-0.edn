difficulty/moderate} :question/id #uuid "1f3bd7e4-e9ee-5ec1-b495-697d442c712e" :question/math-academy-id "q-113070" :question/problem "Let $B=\\{{b}_{1},{b}_{2}\\}$ be a basis of ${R}^{2}$ and $[x]_{B}=[\\begin{aligned}-1 \\\\ 3\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C=\\{{c}_{1},{c}_{2}\\},$ where ${c}_{1}=2{b}_{1}+{b}_{2}$ and ${c}_{2}=-{b}_{1}?$" :question/worked-solution "We are given that\n\n$$\n\\{\\begin{aligned}{c}_{1}=2{b}_{1}+{b}_{2} \\\\ {c}_{2}=-{b}_{1}.\\end{aligned}\n$$\n\nFirst, we express the $b$'s in terms of $c$'s. From the second equation, we get \n\n$$\n{b}_{1}=-{c}_{2}.\n$$\n\nSubstituting this into the first equation, we obtain\n\n$$\n{c}_{1}=2(-{c}_{2})+{b}_{2}\\,⟹\\,{b}_{2}={c}_{1}+2{c}_{2}.\n$$\n\nSince $[x]_{B}=[\\begin{aligned}-1 \\\\ 3\\end{aligned}]$, we can write the vector $x$ as follows: \n\n$$\n\\begin{aligned}x & =-{b}_{1}+3{b}_{2} \\\\  & =-(-{c}_{2})+3({c}_{1}+2{c}_{2}) \\\\  & ={c}_{2}+3{c}_{1}+6{c}_{2} \\\\  & =7{c}_{2}+3{c}_{1}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}3 \\\\ 7\\end{aligned}].$"}] [{:db/id #edb/ref 17592186321001 :knowledge-point/_questions [{:db/id #edb/ref 17592186119823 :knowledge-point/id #uuid "29b27833-e930-5339-89b3-c5651d791dcd" :knowledge-point/title "Writing a Two-Dimensional Vector in a Different Basis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c1f3a69-7740-5aa2-925c-53c1ce3286b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}-1 \\\\ -4\\end{aligned}]" :db/id #edb/ref 17592186319532} {:answer/id #uuid "66b1a873-459f-552e-a7e5-027c42c7521c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}-\\frac{5}{2} \\\\ -3\\end{aligned}]" :db/id #edb/ref 17592186319705} {:answer/id #uuid "8891e75e-27cb-5964-9e25-018084c2ca28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}2 \\\\ -\\frac{3}{2}\\end{aligned}]" :db/id #edb/ref 17592186319799} {:answer/id #uuid "9d0ae0bb-3fdb-536c-87d0-6e5d6c437047" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}-\\frac{6}{5} \\\\ -\\frac{3}{2}\\end{aligned}]" :db/id #edb/ref 17592186319862} {:answer/id #uuid "c86c86a5-b326-5d1c-b7a9-87d860ce9998" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}\\frac{3}{2} \\\\ \\frac{3}{5}\\end{aligned}]" :db/id #edb/ref 17592186320002}] :answer-field/correct {:answer/id #uuid "9d0ae0bb-3fdb-536c-87d0-6e5d6c437047" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}-\\frac{6}{5} \\\\ -\\frac{3}{2}\\end{aligned}]" :db/id #edb/ref 17592186319862} :answer-field/id #uuid "4da19070-3706-599c-9a4c-66595b84535c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186320333}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c8522320-65f1-531f-bee8-8f3ee0c26cf8" :question/math-academy-id "q-35257" :question/problem "Let $B={{b}_{1},{b}_{2}}$ be a basis of ${R}^{2}$ and $[x]_{B}=[\\begin{aligned}3 \\\\ -6\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C={{c}_{1},{c}_{2}},$ where ${c}_{1}=5{b}_{2}$ and ${c}_{2}=-2{b}_{1}?$" :question/worked-solution "Since $[x]_{B}=[\\begin{aligned}3 \\\\ -6\\end{aligned}]$, we can write $x$ as follows:\n\n$$\n\\begin{aligned}x & =3{b}_{1}-6{b}_{2} \\\\  & =-6{b}_{2}+3{b}_{1} \\\\  & =-\\frac{6}{5}(5{b}_{2})-\\frac{3}{2}(-2{b}_{1}) \\\\  & =-\\frac{6}{5}{c}_{1}-\\frac{3}{2}{c}_{2}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}-\\frac{6}{5} \\\\ -\\frac{3}{2}\\end{aligned}].$"}] [{:db/id #edb/ref 17592186351269 :knowledge-point/_questions [{:db/id #edb/ref 17592186119824 :knowledge-point/id #uuid "df96d21a-e1bc-5a9b-b528-d6e7b30d8451" :knowledge-point/title "Writing a Three-Dimensional Vector in a Different Basis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "278b95ec-9543-5b30-8694-705447b2953b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}-5 \\\\ 8 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186348788} {:answer/id #uuid "29c427aa-c438-59b7-8563-b8b32e5248b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}5 \\\\ 4 \\\\ 6\\end{aligned}]" :db/id #edb/ref 17592186348814} {:answer/id #uuid "db1f2b2a-d728-5c5c-9080-4a279744ceb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}-8 \\\\ -3 \\\\ 5\\end{aligned}]" :db/id #edb/ref 17592186350368} {:answer/id #uuid "dfb90321-e3c6-5d76-9f86-67160a3d6885" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}3 \\\\ -6 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186350406} {:answer/id #uuid "e4d32b6e-0307-52a7-92e6-dc39f86df2b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}-3 \\\\ 5 \\\\ -8\\end{aligned}]" :db/id #edb/ref 17592186350452}] :answer-field/correct {:answer/id #uuid "db1f2b2a-d728-5c5c-9080-4a279744ceb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}-8 \\\\ -3 \\\\ 5\\end{aligned}]" :db/id #edb/ref 17592186350368} :answer-field/id #uuid "3435a83d-541e-550d-b30c-5b4a35d85a6b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350797}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a06d0486-59a2-551d-a3de-4b2482e5c06f" :question/math-academy-id "q-81228" :question/problem "Let $B=\\{{b}_{1},{b}_{2},{b}_{3}\\}$ be a basis of ${R}^{3}$ and $[x]_{B}=[\\begin{aligned}15 \\\\ -24 \\\\ 18\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C=\\{{c}_{1},{c}_{2},{c}_{3}\\},$ where ${c}_{1}=3{b}_{2}$, ${c}_{2}=-6{b}_{3}$ and ${c}_{3}=3{b}_{1}?$" :question/worked-solution "Since $[x]_{B}=[\\begin{aligned}15 \\\\ -24 \\\\ 18\\end{aligned}]$, we can write $x$ as follows:\n\n$$\n\\begin{aligned}x & =15{b}_{1}-24{b}_{2}+18{b}_{3} \\\\  & =-24{b}_{2}+18{b}_{3}+15{b}_{1} \\\\  & =-8(3{b}_{2})-3(-6{b}_{3})+5(3{b}_{1}) \\\\  & =-8{c}_{1}-3{c}_{2}+5{c}_{3}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}-8 \\\\ -3 \\\\ 5\\end{aligned}].$"}]}
