 0 \\\\ -8 & 5 & -4 & 2 \\\\ -9 & 11 & -6 & 0 \\\\ 3- & 7 & -1 & 0\\end{aligned}| \\\\  & =2\\cdot (-1)^{2+4}|\\begin{aligned}10 & -4 & 5 \\\\ -9 & 11 & -6 \\\\ -3 & 7 & -1\\end{aligned}| \\\\  & =2|\\begin{aligned}10 & -4 & 5 \\\\ -9 & 11 & -6 \\\\ -3 & 7 & -1\\end{aligned}|.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-141d1b86-0b32-5f20-8147-385eaa555e9b"] :db/ensure [:question/validate]} {:db/id "answer-field-141d1b86-0b32-5f20-8147-385eaa555e9b" :answer-field/id #uuid "141d1b86-0b32-5f20-8147-385eaa555e9b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9c7107f6-6d20-53e7-a059-e9e42ec6f1f8" :answer-field/choices ["answer-333b186d-9fdb-5337-9547-777d95fd43a9" "answer-7185b2cd-fbd5-52c7-a5b6-e9ad08779e58" "answer-9c7107f6-6d20-53e7-a059-e9e42ec6f1f8" "answer-dd499585-0d01-5837-9bcd-40b9e212df40" "answer-fae70d9d-10fb-588c-adfb-03fcba2ffb5d"] :db/ensure [:answer-field/validate]} {:db/id "answer-333b186d-9fdb-5337-9547-777d95fd43a9" :answer/id #uuid "333b186d-9fdb-5337-9547-777d95fd43a9" :answer/type :answer.type/math :answer/value "-2|\\begin{aligned}10 & -2 & 5 \\\\ -9 & 10 & -6 \\\\ -3 & 7 & 1\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "answer-7185b2cd-fbd5-52c7-a5b6-e9ad08779e58" :answer/id #uuid "7185b2cd-fbd5-52c7-a5b6-e9ad08779e58" :answer/type :answer.type/math :answer/value "-3|\\begin{aligned}11 & -4 & 5 \\\\ -9 & 10 & -3 \\\\ 5 & 7 & -1\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "answer-9c7107f6-6d20-53e7-a059-e9e42ec6f1f8" :answer/id #uuid "9c7107f6-6d20-53e7-a059-e9e42ec6f1f8" :answer/type :answer.type/math :answer/value "2|\\begin{aligned}10 & -4 & 5 \\\\ -9 & 11 & -6 \\\\ -3 & 7 & -1\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "answer-dd499585-0d01-5837-9bcd-40b9e212df40" :answer/id #uuid "dd499585-0d01-5837-9bcd-40b9e212df40" :answer/type :answer.type/math :answer/value "4|\\begin{aligned}10 & -4 & 7 \\\\ 6 & 11 & -6 \\\\ -3 & -1 & -7\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "answer-fae70d9d-10fb-588c-adfb-03fcba2ffb5d" :answer/id #uuid "fae70d9d-10fb-588c-adfb-03fcba2ffb5d" :answer/type :answer.type/math :answer/value "|\\begin{aligned}10 & -4 & 5 \\\\ 3 & 11 & -9 \\\\ 8 & 2 & -1\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "question-005f69e9-1456-54e0-a1fd-e854c7360e54" :question/id #uuid "005f69e9-1456-54e0-a1fd-e854c7360e54" :question/math-academy-id "q-130879" :question/problem "$$\n|\\begin{aligned}-6 & -3 & 13 & 13 \\\\ 1 & 1 & 2 & -4 \\\\ 3 & 1 & -2 & -5 \\\\ 19 & 2 & -7 & -5\\end{aligned}|\n$$\n\nConsider the above $4\\times 4$ determinant. Which of the following $3\\times 3$ determinants has the same value?\n\n*Hint: Use elementary row operations to make the entries above and below ${a}_{32}$ equal to zero.*" :question/worked-solution "Let's make entries above and below ${a}_{32}=1$ equal to zero using elementary row operations.\n\nSince adding a multiple of one row (or column) to another row (column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}-6 & -3 & 13 & 13 \\\\ 1 & 1 & 2 & -4 \\\\ 3 & 1 & -2 & -5 \\\\ 19 & 2 & -7 & -5\\end{aligned}| &  & \\,\\begin{aligned}{R}_{1}:={R}_{1}+3{R}_{3} \\\\ {R}_{2}:={R}_{2}-{R}_{3} \\\\ {R}_{4}:={R}_{4}+(-2){R}_{3}\\end{aligned} \\\\  & =|\\begin{aligned}3 & 0 & 7 & -2 \\\\ -2 & 0 & 4 & 1 \\\\ 3 & 1 & -2 & -5 \\\\ 13 & 0 & -3 & 5\\end{aligned}|.\\end{aligned}\n$$\n\nExpanding the result along the $2$nd column, we get\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}3 & 0 & 7 & -2 \\\\ -2 & 0 & 4 & 1 \\\\ 3 & 1 & -2 & -5 \\\\ 13 & 0 & -3 & 5\\end{aligned}| \\\\  & =1\\cdot (-1)^{3+2}|\\begin{aligned}3 & 7 & -2 \\\\ -2 & 4 & 1 \\\\ 13 & -3 & 5\\end{aligned}| \\\\  & =-|\\begin{aligned}3 & 7 & -2 \\\\ -2 & 4 & 1 \\\\ 13 & -3 & 5\\end{aligned}|.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-30c67f7d-b9fb-5337-ad56-2ae0b842b7c8"] :db/ensure [:question/validate]} {:db/id "answer-field-30c67f7d-b9fb-5337-ad56-2ae0b842b7c8" :answer-field/id #uuid "30c67f7d-b9fb-5337-ad56-2ae0b842b7c8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-45d716cf-9dbc-5925-a952-39f8a779d625" :answer-field/choices ["answer-46166285-4cc3-5c29-a51d-90795072a94d" "answer-a76a29ba-6ba2-57b4-97e1-483f343e9c75" "answer-45d716cf-9dbc-5925-a952-39f8a779d625" "answer-4a3113ad-7d59-5808-9038-62f58375aabd" "answer-4807c645-f441-5adc-9241-eb994ff662ae"] :db/ensure [:answer-field/validate]} {:db/id "answer-46166285-4cc3-5c29-a51d-90795072a94d" :answer/id #uuid "46166285-4cc3-5c29-a51d-90795072a94d" :answer/type :answer.type/math :answer/value "-|\\begin{aligned}-2 & 5 & -2 \\\\ -2 & 4 & 7 \\\\ -3 & 13 & 1\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "answer-a76a29ba-6ba2-57b4-97e1-483f343e9c75" :answer/id #uuid "a76a29ba-6ba2-57b4-97e1-483f343e9c75" :answer/type :answer.type/math :answer/value "-|\\begin{aligned}-2 & 7 & 3 \\\\ -2 & 1 & 4 \\\\ 13 & -5 & 3\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "answer-45d716cf-9dbc-5925-a952-39f8a779d625" :answer/id #uuid "45d716cf-9dbc-5925-a952-39f8a779d625" :answer/type :answer.type/math :answer/value "-|\\begin{aligned}3 & 7 & -2 \\\\ -2 & 4 & 1 \\\\ 13 & -3 & 5\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "answer-4a3113ad-7d59-5808-9038-62f58375aabd" :answer/id #uuid "4a3113ad-7d59-5808-9038-62f58375aabd" :answer/type :answer.type/math :answer/value "-|\\begin{aligned}3 & 7 & -2 \\\\ 2 & 1 & 4 \\\\ 13 & -5 & 3\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "answer-4807c645-f441-5adc-9241-eb994ff662ae" :answer/id #uuid "4807c645-f441-5adc-9241-eb994ff662ae" :answer/type :answer.type/math :answer/value "-|\\begin{aligned}4 & 2 & -2 \\\\ -7 & 3 & 1 \\\\ 11 & -3 & 4\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "question-f1c17071-3f38-5e15-9f1d-979ec9d512e0" :question/id #uuid "f1c17071-3f38-5e15-9f1d-979ec9d512e0" :question/math-academy-id "q-131226" :question/problem "$$\n|\\begin{aligned}4 & -3 & 2 & 5 \\\\ -2 & -1 & 4 & 3 \\\\ 5 & 3 & -7 & 6 \\\\ 3 & 1 & 3 & -5\\end{aligned}|\n$$\n\nConsider the above $4\\times 4$ determinant. Which of the following $3\\times 3$ determinants has the same value?\n\n*Hint: Use elementary row operations to make the entries above ${a}_{42}$ equal to zero.*" :question/worked-solution "Let's make entries above ${a}_{42}=1$ equal to zero using elementary row operations.\n\nSince adding a multiple of one row (or column) to another row (column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}4 & -3 & 2 & 5 \\\\ -2 & -1 & 4 & 3 \\\\ 5 & 3 & -7 & 6 \\\\ 3 & 1 & 3 & -5\\end{aligned}| &  & \\,\\begin{aligned}{R}_{1}:={R}_{1}+3{R}_{4} \\\\ {R}_{2}:={R}_{2}+{R}_{4} \\\\ {R}_{3}:={R}_{3}+(-3){R}_{4}\\end{aligned} \\\\  & =|\\begin{aligned}13 & 0 & 11 & -10 \\\\ 1 & 0 & 7 & -2 \\\\ -4 & 0 & -16 & 21 \\\\ 3 & 1 & 3 & -5\\end{aligned}|.\\end{aligned}\n$$\n\nExpanding the result along the $2$nd column, we get\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}13 & 0 & 11 & -10 \\\\ 1 & 0 & 7 & -2 \\\\ -4 & 0 & -16 & 21 \\\\ 3 & 1 & 3 & -5\\end{aligned}| \\\\  & =1\\cdot (-1)^{4+2}|\\begin{aligned}13 & 11 & -10 \\\\ 1 & 7 & -2 \\\\ -4 & -16 & 21\\end{aligned}| \\\\  & =|\\begin{aligned}13 & 11 & -10 \\\\ 1 & 7 & -2 \\\\ -4 & -16 & 21\\end{aligned}|.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-5017e5ab-f540-5f24-b47d-7ab195cf9ff0"] :db/ensure [:question/validate]} {:db/id "answer-field-5017e5ab-f540-5f24-b47d-7ab195cf9ff0" :answer-field/id #uuid "5017e5ab-f540-5f24-b47d-7ab195cf9ff0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f439f4fb-9730-5674-820b-040ca58a4b57" :answer-field/choices ["