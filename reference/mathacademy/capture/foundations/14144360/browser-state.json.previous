nspacing=\"1em\" rowspacing=\"4pt\"><mtr><mtd><mn>6</mn></mtd><mtd><mn>4</mn></mtd><mtd><mn>5</mn></mtd></mtr><mtr><mtd><mstyle mathcolor=\"red\"><mn>0</mn></mstyle></mtd><mtd><mstyle mathcolor=\"blue\"><mstyle mathbackground=\"lightgray\"><mpadded height=\"+2pt\" depth=\"+2pt\" lspace=\"2pt\" width=\"+4pt\"><mn>3</mn></mpadded></mstyle></mstyle></mtd><mtd><mstyle mathcolor=\"red\"><mn>0</mn></mstyle></mtd></mtr><mtr><mtd><mo>−</mo><mn>5</mn></mtd><mtd><mn>1</mn></mtd><mtd><mo>−</mo><mn>4</mn></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">|</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mn>2</mn><mo stretchy=\"false\">)</mo><mo>⋅</mo><mo stretchy=\"false\">(</mo><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"blue\"><mstyle mathbackground=\"lightgray\"><mpadded height=\"+2pt\" depth=\"+2pt\" lspace=\"2pt\" width=\"+4pt\"><mn>3</mn></mpadded></mstyle></mstyle></mrow><mo stretchy=\"false\">)</mo><mo>⋅</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mn>1</mn><msup><mo stretchy=\"false\">)</mo><mrow data-mjx-texclass=\"ORD\"><mn>2</mn><mo>+</mo><mn>2</mn></mrow></msup><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">|</mo><mtable columnalign=\"center\" columnspacing=\"1em\" rowspacing=\"4pt\"><mtr><mtd><mn>6</mn></mtd><mtd><mn>5</mn></mtd></mtr><mtr><mtd><mo>−</mo><mn>5</mn></mtd><mtd><mo>−</mo><mn>4</mn></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">|</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mn>6</mn><mo stretchy=\"false\">(</mo><mo>−</mo><mn>24</mn><mo>+</mo><mn>25</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mn>6.</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
