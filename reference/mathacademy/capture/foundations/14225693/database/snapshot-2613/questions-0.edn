edb/ref 17592186428015 :knowledge-point/_questions [{:db/id #edb/ref 17592186162018 :knowledge-point/id #uuid "02dfe937-e604-5985-af6f-cdfa1a574ccd" :knowledge-point/title "Finding the Columns of the Third Matrix Given Part of a Singular Value Decomposition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "089ec07a-5e86-5e2c-9ee0-7a59f0e9ce6e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{10}}" :db/id #edb/ref 17592186428009} {:answer/id #uuid "7011776a-f74f-5038-88b7-bd75d4a9eff4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{\\sqrt{10}}" :db/id #edb/ref 17592186428010} {:answer/id #uuid "7450dd95-1930-5564-96d4-6c9e274f1579" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{5}}" :db/id #edb/ref 17592186428011} {:answer/id #uuid "a9766852-3203-5031-bf4e-845ae1f644cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186428012} {:answer/id #uuid "da310c2d-2eb6-5830-855e-93aa19083cd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{\\sqrt{5}}" :db/id #edb/ref 17592186428013}] :answer-field/correct {:answer/id #uuid "7011776a-f74f-5038-88b7-bd75d4a9eff4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{\\sqrt{10}}" :db/id #edb/ref 17592186428010} :answer-field/id #uuid "01f21526-a5f6-5403-8d94-60d82378f21e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186428014}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "39a1a8bd-f69f-5f36-99bc-5bd95f9b782d" :question/math-academy-id "q-96238" :question/problem "$$\n{A}^{T}\\,A=\\begin{bmatrix}73 & 24 \\\\ 24 & 9\\end{bmatrix},\\,Σ=\\begin{bmatrix}9 & 0 \\\\ 0 & 1\\end{bmatrix},\\,V=\\begin{bmatrix}{v}_{11} & {v}_{12} \\\\ {v}_{21} & {v}_{22}\\end{bmatrix}\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ what is the value of $|{v}_{11}|+|{v}_{21}|?$" :question/worked-solution "If $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ the columns of $V$ must be the right singular vectors of $A,$ i.e., the unit eigenvectors of the matrix ${A}^{T}\\,A.$\n\nFrom the matrix $Σ,$ we deduce that the singular values are ${\\sigma }_{1}=9$ and ${\\sigma }_{2}=1.$ So, the first column of $V$ corresponds to the singular value ${\\sigma }_{1}=9.$\n\nHence, we need to find a unit eigenvector of ${A}^{T}\\,A$ that corresponds to ${\\lambda }_{1}={\\sigma }_{1}^{2}=81.$ Computing ${A}^{T}\\,A-81I,$ we get\n\n$$\n{A}^{T}\\,A-81I=\\begin{bmatrix}73 & 24 \\\\ 24 & 9\\end{bmatrix}-81\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}-8 & 24 \\\\ 24 & -72\\end{bmatrix}\n$$\n\nSeeking a non-zero solution of $({A}^{T}\\,A-81I)v=0$ gives the eigenvector $v=\\begin{bmatrix}3 \\\\ 1\\end{bmatrix}.$ Dividing $v$ by its norm, we get \n\n$$\n\\frac{v}{‖v‖}=\\frac{1}{\\sqrt{10}}\\begin{bmatrix}3 \\\\ 1\\end{bmatrix}=\\begin{bmatrix}\\frac{3}{\\sqrt{10}} \\\\ \\frac{1}{\\sqrt{10}}\\end{bmatrix}.\n$$\n\nTherefore,\n\n$$\n|{v}_{11}|+|{v}_{21}|=|\\frac{3}{\\sqrt{10}}|+|\\frac{1}{\\sqrt{10}}|=\\frac{4}{\\sqrt{10}}.\n$$"}] [{:db/id #edb/ref 17592186385872 :knowledge-point/_questions [{:db/id #edb/ref 17592186162018 :knowledge-point/id #uuid "02dfe937-e604-5985-af6f-cdfa1a574ccd" :knowledge-point/title "Finding the Columns of the Third Matrix Given Part of a Singular Value Decomposition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e37dfd1-4a21-5be4-90b0-f4412f73f3b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{\\sqrt{10}}" :db/id #edb/ref 17592186385874} {:answer/id #uuid "470ca91e-ccd2-5bab-b6e6-0b891e317ed6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{\\sqrt{5}}" :db/id #edb/ref 17592186385875} {:answer/id #uuid "25d8dd8d-a310-5086-ae03-c1bf4fc8cac0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{10}}" :db/id #edb/ref 17592186385876} {:answer/id #uuid "816a57c5-a4c6-5bd4-837f-df34295e5485" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{\\sqrt{13}}" :db/id #edb/ref 17592186385877} {:answer/id #uuid "7cba45f1-f7ac-5129-91d4-822862ce8124" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{13}}" :db/id #edb/ref 17592186385878}] :answer-field/correct {:answer/id #uuid "6e37dfd1-4a21-5be4-90b0-f4412f73f3b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{\\sqrt{10}}" :db/id #edb/ref 17592186385874} :answer-field/id #uuid "c1bf4fdb-0a57-56b5-94be-a8b5225f60c1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186385873}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a3b433b7-383a-5380-9fae-9ee33c84e8d3" :question/math-academy-id "q-96239" :question/problem "$$\n{A}^{T}\\,A=\\begin{bmatrix}9 & -24 \\\\ -24 & 73\\end{bmatrix},\\,Σ=\\begin{bmatrix}9 & 0 \\\\ 0 & 1\\end{bmatrix},\\,V=\\begin{bmatrix}{v}_{11} & {v}_{12} \\\\ {v}_{21} & {v}_{22}\\end{bmatrix}\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ what is the value of $|{v}_{12}|+|{v}_{22}|?$" :question/worked-solution "If $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ the columns of $V$ must be the right singular vectors of $A,$ i.e., the unit eigenvectors of the matrix ${A}^{T}\\,A.$\n\nFrom the matrix $Σ,$ we deduce that the singular values are ${\\sigma }_{1}=9$ and ${\\sigma }_{2}=1.$ So, the second column of $V$ corresponds to the singular value ${\\sigma }_{2}=1.$\n\nHence, we need to find a unit eigenvector of ${A}^{T}\\,A$ that corresponds to ${\\lambda }_{2}={\\sigma }_{2}^{2}=1.$ Computing ${A}^{T}\\,A-I,$ we get\n\n$$\n{A}^{T}\\,A-I=\\begin{bmatrix}9 & -24 \\\\ -24 & 73\\end{bmatrix}-\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}8 & -24 \\\\ -24 & 72\\end{bmatrix}\n$$\n\nSeeking a non-zero solution of $({A}^{T}\\,A-I)v=0$ gives the eigenvector $v=\\begin{bmatrix}3 \\\\ 1\\end{bmatrix}.$ Dividing $v$ by its norm, we get \n\n$$\n\\frac{v}{‖v‖}=\\frac{1}{\\sqrt{10}}\\begin{bmatrix}3 \\\\ 1\\end{bmatrix}=\\begin{bmatrix}\\frac{3}{\\sqrt{10}} \\\\ \\frac{1}{\\sqrt{10}}\\end{bmatrix}.\n$$\n\nTherefore,\n\n$$\n|{v}_{12}|+|{v}_{22}|=|\\frac{3}{\\sqrt{10}}|+|\\frac{1}{\\sqrt{10}}|=\\frac{4}{\\sqrt{10}}.\n$$"}] [{:db/id #edb/ref 17592186371339 :knowledge-point/_questions [{:db/id #edb/ref 17592186162017 :knowledge-point/id #uuid "f0d7f5df-a1f9-5242-9386-446313ec0178" :knowledge-point/title "Determining the Columns of the First Matrix Given Part of a Singular Value Decomposition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a2341d5-b784-5b8f-9211-d6b85b4af6c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186371341} {:answer/id #uuid "25ab1870-4638-54e0-9094-16451a668a37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186371342} {:answer/id #uuid "16abdedc-49bb-563f-9129-05be11225d5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2}{\\sqrt{5}} \\\\ -\\frac{1}{\\sqrt{