alues are ${\\sigma }_{1}=4$ and ${\\sigma }_{2}=1.$ Therefore, the first column of $U$ is\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{4}\\begin{bmatrix}0 & -2 \\\\ 2 & -3\\end{bmatrix}\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{bmatrix} \\\\  & =\\frac{1}{4}\\begin{bmatrix}-\\frac{4}{\\sqrt{5}} \\\\ -\\frac{8}{\\sqrt{5}}\\end{bmatrix} \\\\  \\\\  & =\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} \\\\ -\\frac{2}{\\sqrt{5}}\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186371360 :knowledge-point/_questions [{:db/id #edb/ref 17592186162017 :knowledge-point/id #uuid "f0d7f5df-a1f9-5242-9386-446313ec0178" :knowledge-point/title "Determining the Columns of the First Matrix Given Part of a Singular Value Decomposition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b340a6b9-2150-5d09-b212-4169a2e45650" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}}\\end{bmatrix}" :db/id #edb/ref 17592186371362} {:answer/id #uuid "ed71c6ee-fc7e-5366-b928-3a0e8ac31c83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{bmatrix}" :db/id #edb/ref 17592186371363} {:answer/id #uuid "3decd7ef-d6cb-5d2c-a821-182982c2d6d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186371364} {:answer/id #uuid "f1659e51-bced-5253-9862-0e84267f1efe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{1}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}}\\end{bmatrix}" :db/id #edb/ref 17592186371365} {:answer/id #uuid "4a7eb61e-6225-5628-bd68-d73407f01588" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/