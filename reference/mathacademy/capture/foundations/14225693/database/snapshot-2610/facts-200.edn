6045417] [17592186496192 #edb/ref 1075 #edb/ref 17592186496009 #edb/ref 17592186045417] [17592186496192 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186496192 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186496192 #edb/ref 1078 #edb/ref 17592186495683 #edb/ref 17592186045417] [17592186496192 #edb/ref 1079 #uuid "d8e0de73-fab0-5dbe-bb6a-4caec9eea734" #edb/ref 17592186045417] [17592186496288 #edb/ref 1068 #edb/ref 17592186496088 #edb/ref 17592186045417] [17592186496288 #edb/ref 1069 "q-140646" #edb/ref 17592186045417] [17592186496288 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186496288 #edb/ref 1071 "$$\nA=\\begin{bmatrix}6 & -4 \\\\ 1 & 6\\end{bmatrix},\\,Σ=\\begin{bmatrix}8 & 0 \\\\ 0 & 5\\end{bmatrix}\n$$\n\nConsider the matrices $A$ and $Σ$ shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ which of the following could be the matrices $U$ and $V?$" #edb/ref 17592186045443] [17592186496288 #edb/ref 1072 #uuid "9582267b-adc4-536b-9335-9619155f3b19" #edb/ref 17592186045417] [17592186496288 #edb/ref 1074 "Let's find the singular value decomposition of $A$ using the usual algorithm.\n\n- **Step 1.** Compute ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}6 & -4 \\\\ 1 & 6\\end{bmatrix}}^{T}\\begin{bmatrix}6 & -4 \\\\ 1 & 6\\end{bmatrix} \\\\  & =\\begin{bmatrix}6 & 1 \\\\ -4 & 6\\end{bmatrix}\\begin{bmatrix}6 & -4 \\\\ 1 & 6\\end{bmatrix} \\\\  & =\\begin{bmatrix}37 & -18 \\\\ -18 & 52\\end{bmatrix}\\end{aligned}\n$$\n\n- **Step 2.** Find the singular values: From the matrix $Σ,$ we deduce that ${\\sigma }_{1}=8$ and ${\\sigma }_{2}=5.$\n\n- **Step 3.** Find the right singular vectors of $A$ (i.e., the unit eigenvectors of ${A}^{T}\\,A$):\n\n- For ${\\lambda }_{1}={\\sigma }_{1}^{2}=64,$ we have\n\n$$\n\\begin{aligned}{A}^{T}\\,A-64I & =\\begin{bmatrix}37 & -18 \\\\ -18 & 52\\end{bmatrix}-64\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}-27 & -18 \\\\ -18 & -12\\end{bmatrix}.\\end{aligned}\n$$\n\nSeeking a non-zero solution of $({A}^{T}\\,A-64I)x=0$ gives a unit eigenvector\n\n$$\n{v}_{1}=\\begin{bmatrix}-\\frac{2}{\\sqrt{13}} \\\\ \\frac{3}{\\sqrt{13}}\\end{bmatrix}.\n$$\n\n- For ${\\lambda }_{2}={\\sigma }_{2}^{2}=25,$ we have\n\n$$\n\\begin{aligned}{A}^{T}\\,A-25I & =\\begin{bmatrix}37 & -18 \\\\ -18 & 52\\end{bmatrix}-25\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}12 & -18 \\\\ -18 & 27\\end{bmatrix}.\\end{aligned}\n$$\n\nSeeking a non-zero solution of $({A}^{T}\\,A-25I)x=0$ gives a unit eigenvector\n\n$$\n{v}_{2}=\\begin{bmatrix}\\frac{3}{\\sqrt{13}} \\\\ \\frac{2}{\\sqrt{13}}\\end{bmatrix}.\n$$\n\n- **Step 4.** Find the left singular vectors of $A$: Since we know the singular values and right singular vectors, we can compute the columns of $U$ as follows:\n\n- First, we compute ${u}_{1}:$\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{8}\\begin{bmatrix}6 & -4 \\\\ 1 & 6\\end{bmatrix}\\begin{bmatrix}-\\frac{2}{\\sqrt{13}} \\\\ \\frac{3}{\\sqrt{13}}\\end{bmatrix} \\\\  & =\\frac{1}{8}\\begin{bmatrix}-\\frac{24}{\\sqrt{13}} \\\\ \\frac{16}{\\sqrt{13}}\\end{bmatrix} \\\\  & =\\begin{bmatrix}-\\frac{3}{\\sqrt{13}} \\\\ \\frac{2}{\\sqrt{13}}\\end{bmatrix}\\end{aligned}\n$$\n\n- Then, we compute ${u}_{2}:$\n\n$$\n\\begin{aligned}{u}_{2} & =\\frac{1}{{\\sigma }_{2}}A{v}_{2} \\\\  & =\\frac{1}{5}\\begin{bmatrix}6 & -4 \\\\ 1 & 6\\end{bmatrix}\\begin{bmatrix}\\frac{3}{\\sqrt{13}} \\\\ \\frac{2}{\\sqrt{13}}\\end{bmatrix} \\\\  & =\\frac{1}{5}\\begin{bmatrix}\\frac{10}{\\sqrt{13}} \\\\ \\frac{15}{\\sqrt{13}}\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{2}{\\sqrt{13}} \\\\ \\frac{3}{\\sqrt{13}}\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, we construct the matrices $U$ and $V:$\n\n$$\nU=\\begin{bmatrix}-\\frac{3}{\\sqrt{13}} & \\frac{2}{\\sqrt{13}} \\\\ \\frac{2}{\\sqrt{13}} & \\frac{3}{\\sqrt{13}}\\end{bmatrix},\\,V=\\begin{bmatrix}-\\frac{2}{\\sqrt{13}} & \\frac{3}{\\sqrt{13}} \\\\ \\frac{3}{\\sqrt{13}} & \\frac{2}{\\sqrt{13}}\\end{bmatrix}\n$$" #edb/ref 17592186045443] [17592186496292 #edb/ref 1068 #edb/ref 17592186496186 #edb/ref 17592186045417] [17592186496292 #edb/ref 1069 "q-96118" #edb/ref 17592186045417] [17592186496292 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186496292 #edb/ref 1071 "Given the singular value decomposition $A=UΣ{V}^{T},$ where $A$ is a $3\\times 5$ matrix, which of the following statements are true?\n\nI. $U$ is a $5\\times 5$ matrix\n\nII. $U$ is an orthogonal matrix\n\nIII. $Σ$ is an orthogonal matrix" #edb/ref 17592186045417] [17592186496292 #edb/ref 1072 #uuid "a0773915-2806-5187-a512-1daa0afdcd4e" #edb/ref 17592186045417] [17592186496292 #edb/ref 1074 "Recall that if  $A=UΣ{V}^{T}$ is a singular value decomposition of an $m\\times n$ matrix $A,$ then\n\n- $Σ$ is a $m\\times n$ matrix with nonnegative elements on the main diagonal and zeroes outside the main diagonal,\n\n- $U$ is an orthogonal $m\\times m$ matrix,\n\n- $V$ is an orthogonal $n\\times n$ matrix.\n\nWith that in mind, let's examine our statements.\n\n- Statement I is false. Since $A$ is a $3\\times 5$ matrix, $U$ must be a $3\\times 3$ matrix.\n\n- Statement II is true. Indeed, the matrix $U$ in the singular value decomposition $UΣ{V}^{T}$ must be orthogonal.\n\n- Statement III is false. The matrix $Σ$ must be diagonal but not necessarily orthogonal.\n\nTherefore, the correct answer is \"II only.\"" #edb/ref 17592186045417] [17592186496294 #edb/ref 1068 #edb/ref 17592186496192 #edb/ref 17592186045417] [17592186496294 #edb/ref 1069 "q-96232" #edb/ref 17592186045417] [17592186496294 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186496294 #edb/ref 1071 "$$\nV=\\begin{bmatrix}\\,∗\\, & -\\frac{3}{\\sqrt{10}} \\\\ \\,∗\\, & \\frac{1}{\\sqrt{10}}\\end{bmatrix}\n$$\n\nConsider the matrix $V$ shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of a $2\\times 2$ matrix $A,$ which of the following could be the first column of the matrix $V?$" #edb/ref 17592186045443] [17592186496294 #edb/ref 1072 #uuid "a6cc8412-6a80-579d-ba3c-43e9e90968b7" #edb/ref 17592186045417] [17592186496294 #edb/ref 1074 "Recall that since $A=UΣ{V}^{T}$ is a singular value decomposition of a $2\\times 2$ matrix $A,$ the matrix $V$ must be a $2\\times 2$ orthogonal matrix. This means that \n\n- the first column must be orthogonal to the second column, and\n\n- the norm of the first column must be equal to $1.$\n\nAmong the given options, only the vector $\\begin{bmatrix}\\frac{1}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}}\\end{bmatrix}$ has both properties." #edb/ref 17592186045443] [17592186509694 #edb/ref 1043 #edb/ref 17592186510478 #edb/ref 17592186045417] [17592186509694 #edb/ref 1043 #edb/ref 17592186510548 #edb/ref 17592186045417] [17592186509694 #edb/ref 1043 #edb/ref 17592186510549 #edb/ref 17592186045417] [17592186509694 #edb/ref 1043 #edb/ref 17592186510551 #edb/ref 17592186045417] [17592186509694 #edb/ref 1043 #edb/ref 17592186510552 #edb/ref 17592186045417] [17592186509694 #edb/ref 1044 #edb/ref 17592186045464 #edb/ref 17592186045417] [17592186509694 #edb/ref 1045 "Singular Value Decomposition of 2x2 Matrices" #edb/ref 17592186045417] [17592186509694 #edb/ref 1046 #edb/ref 17592186510552 #edb/ref 17592186045417] [17592186509694 #edb/ref 1048 #edb/ref 17592186046658 #edb/ref 17592186045417] [17592186509694 #edb/ref 1049 #edb/ref 17592186050726 #edb/ref 17592186045417] [17592186509694 #edb/ref 1053 #uuid "fb373261-4ba5-5be3-91b7-f2e6612a259f" #edb/ref 17592186045417] [17592186510478 #edb/ref 1062 #uuid "0469c5e1-c0ea-581f-bb24-0baa86ebe286" #edb/ref 17592186045417] [17592186510478 #edb/ref 1063 #edb/ref 17592186404891 #edb/ref 17592186045417] [17592186510548 #edb/ref 1058 #edb/ref 17592186510478 #edb/ref 17592186045417] [17592186510548 #edb/ref 1062 #uuid "da6be4fd-4bca-51c3-b899-c5876bd940c4" #edb/ref 17592186045417] [17592186510548 #edb/ref 