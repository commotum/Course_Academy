[{"source" ":org/Math-Academy" "forms" [{:db/id 17592186166955 :knowledge-point/questions ["question-c0b2f698-58d0-5aff-9d1c-cd41dc57daac"] :db/ensure [:knowledge-point/validate]} {:db/id "question-c0b2f698-58d0-5aff-9d1c-cd41dc57daac" :question/id #uuid "c0b2f698-58d0-5aff-9d1c-cd41dc57daac" :question/math-academy-id "q-341226" :question/problem "Let $F(x)=x{e}^{3(x-1)}$ for $x\\in [0,5),$ and let $f(x)$ be the **odd** extension of $F(x)$ to $x\\in (-5,5).$ What is the value of $f(-1)?$\n\n$f(-1)=$\n{{field-1}}" :question/worked-solution "If $F(x)$ is defined on $x\\in [0,5),$ the odd extension of $F$ is the function $f$ such that\n\n$$\nf(x)=\\{\\begin{aligned}F(x), & x\\in [0,5), \\\\ -F(-x), & x\\in (-5,0).\\end{aligned}\n$$\n\nIn our cases, for $x\\in (-5,0),$ we get\n\n$$\n\\begin{aligned}f(x) & =-F(-x) \\\\  & =-(-x){e}^{3(-x-1)} \\\\  & =x{e}^{3(-x-1)}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f(-1) & =(-1){e}^{3(-(-1)-1)}=-{e}^{3(0)}=-1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-175c2fdb-c390-5385-bb9c-f23c3bd1dd27"] :db/ensure [:question/validate]} {:db/id "answer-field-175c2fdb-c390-5385-bb9c-f23c3bd1dd27" :answer-field/id #uuid "175c2fdb-c390-5385-bb9c-f23c3bd1dd27" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-19797644-81c9-5edc-8c9f-6d1f16ca9e89" :answer-field/choices ["answer-19797644-81c9-5edc-8c9f-6d1f16ca9e89"] :db/ensure [:answer-field/validate]} {:db/id "answer-19797644-81c9-5edc-8c9f-6d1f16ca9e89" :answer/id #uuid "19797644-81c9-5edc-8c9f-6d1f16ca9e89" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id 17592186315064 :question/worked-solution "If $F(x)$ is defined on $x\\in [0,8),$ the odd extension of $F$ is the function $f$ such that\n\n$$\nf(x)=\\{\\begin{aligned}F(x), & x\\in [0,8), \\\\ -F(-x), & x\\in (-8,0).\\end{aligned}\n$$\n\nIn our case, for $x\\in (-8,0),$ we get\n\n$$\n\\begin{aligned}f(x) & =-F(-x) \\\\  & =-(-(-x)^{2}+5(-x)) \\\\  & =-(-{x}^{2}-5x) \\\\  & ={x}^{2}+5x.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f(-3) & =(-3)^{2}+5(-3)=-6.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186315030 :question/worked-solution "If $F(x)$ is defined on $x\\in [0,\\pi ),$ the odd extension of $F$ is the function $f$ such that\n\n$$\nf(x)=\\{\\begin{aligned}F(x), & x\\in [0,\\pi ), \\\\ -F(-x), & x\\in (-\\pi ,0).\\end{aligned}\n$$\n\nIn our case, for $x\\in (-\\pi ,0),$ we get\n\n$$\n\\begin{aligned}f(x) & =-F(-x) \\\\  & =-(-2(-x)^{3}+3(-x)) \\\\  & =-(2{x}^{3}-3x) \\\\  & =-2{x}^{3}+3x.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186379589 :question/problem "$$\nf(x)∼{\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡(nx)\n$$\n\nLet $F(x)=6x$ for $x\\in [0,\\pi ).$ The Fourier sine series of the **odd** $2\\pi $-periodic extension $f(x)$ of $F(x)$ is shown above. Find the expression for ${b}_{n}.$\n\n$\\,{b}_{n}=$ {{field-1}}" :db/ensure [:question/validate]} {:db/id 17592186379575 :question/problem "$$\nf(x)∼{\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡(nx)\n$$\n\nLet $F(x)=3$ for $x\\in [0,\\pi ).$ The Fourier sine series of the **odd** $2\\pi $-periodic extension $f(x)$ of $F(x)$ is shown above. Find the expression for ${b}_{n}.$\n\n$\\,{b}_{n}=$ {{field-1}}" :db/ensure [:question/validate]}] "assertions" [["question-c0b2f698-58d0-5aff-9d1c-cd41dc57daac" :question/id #uuid "c0b2f698-58d0-5aff-9d1c-cd41dc57daac"] ["question-c0b2f698-58d0-5aff-9d1c-cd41dc57daac" :question/math-academy-id "q-341226"] ["question-c0b2f698-58d0-5aff-9d1c-cd41dc57daac" :question/problem "Let $F(x)=x{e}^{3(x-1)}$ for $x\\in [0,5),$ and let $f(x)$ be the **odd** extension of $F(x)$ to $x\\in (-5,5).$ What is the value of $f(-1)?$\n\n$f(-1)=$\n{{field-1}}"] ["question-c0b2f698-58d0-5aff-9d1c-cd41dc57daac" :question/worked-solution "If $F(x)$ is defined on $x\\in [0,5),$ the odd extension of $F$ is the function $f$ such that\n\n$$\nf(x)=\\{\\begin{aligned}F(x), & x\\in [0,5), \\\\ -F(-x), & x\\in (-5,0).\\end{aligned}\n$$\n\nIn our cases, for $x\\in (-5,0),$ we get\n\n$$\n\\begin{aligned}f(x) & =-F(-x) \\\\  & =-(-x){e}^{3(-x-1)} \\\\  & =x{e}^{3(-x-1)}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f(-1) & =(-1){e}^{3(-(-1)-1)}=-{e}^{3(0)}=-1.\\end{aligned}\n$$"] ["question-c0b2f698-58d0-5aff-9d1c-cd41dc57daac" :question/difficulty :question.difficulty/moderate] ["answer-field-175c2fdb-c390-5385-bb9c-f23c3bd1dd27" :answer-field/id #uuid "175c2fdb-c390-5385-bb9c-f23c3bd1dd27"] ["answer-19797644-81c9-5edc-8c9f-6d1f16ca9e89" :answer/id #uuid "19797644-81c9-5edc-8c9f-6d1f16ca9e89"] ["answer-19797644-81c9-5edc-8c9f-6d1f16ca9e89" :answer/type :answer.type/math] ["answer-19797644-81c9-5edc-8c9f-6d1f16ca9e89" :answer/value "-1"] ["answer-field-175c2fdb-c390-5385-bb9c-f23c3bd1dd27" :answer-field/key "field-1"] ["answer-field-175c2fdb-c390-5385-bb9c-f23c3bd1dd27" :answer-field/type :answer-field.type/blank] ["answer-field-175c2fdb-c390-5385-bb9c-f23c3bd1dd27" :answer-field/correct "answer-19797644-81c9-5edc-8c9f-6d1f16ca9e89"] ["answer-field-175c2fdb-c390-5385-bb9c-f23c3bd1dd27" :answer-field/choices "answer-19797644-81c9-5edc-8c9f-6d1f16ca9e89"] ["question-c0b2f698-58d0-5aff-9d1c-cd41dc57daac" :question/answer-fields "answer-field-175c2fdb-c390-5385-bb9c-f23c3bd1dd27"] [17592186166955 :knowledge-point/questions "question-c0b2f698-58d0-5aff-9d1c-cd41dc57daac"] [17592186315064 :question/worked-solution "If $F(x)$ is defined on $x\\in [0,8),$ the odd extension of $F$ is the function $f$ such that\n\n$$\nf(x)=\\{\\begin{aligned}F(x), & x\\in [0,8), \\\\ -F(-x), & x\\in (-8,0).\\end{aligned}\n$$\n\nIn our case, for $x\\in (-8,0),$ we get\n\n$$\n\\begin{aligned}f(x) & =-F(-x) \\\\  & =-(-(-x)^{2}+5(-x)) \\\\  & =-(-{x}^{2}-5x) \\\\  & ={x}^{2}+5x.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f(-3) & =(-3)^{2}+5(-3)=-6