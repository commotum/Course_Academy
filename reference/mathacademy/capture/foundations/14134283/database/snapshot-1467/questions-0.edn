#{[{:db/id #edb/ref 17592186435769 :knowledge-point/_questions [{:db/id #edb/ref 17592186119779 :knowledge-point/id #uuid "164c56ea-afbb-5ce4-800a-19002695db76" :knowledge-point/title "Calculating the Determinant of the Inverse of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d19261f-2d17-5ce6-a528-357db19c92fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{76}" :db/id #edb/ref 17592186435743} {:answer/id #uuid "44e2e6b4-ad39-5370-b46a-da247adce9ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{82}" :db/id #edb/ref 17592186435745} {:answer/id #uuid "4bc3f9d6-53b9-5b49-91f9-095f7560a365" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{84}" :db/id #edb/ref 17592186435748} {:answer/id #uuid "505a34ac-ba5d-5a72-8645-7ed3b579499e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{64}" :db/id #edb/ref 17592186435750} {:answer/id #uuid "ce24b16c-5b82-5027-a711-29aa725ec9c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{48}" :db/id #edb/ref 17592186435760}] :answer-field/correct {:answer/id #uuid "4bc3f9d6-53b9-5b49-91f9-095f7560a365" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{84}" :db/id #edb/ref 17592186435748} :answer-field/id #uuid "a2f79099-495d-5b97-91da-18a1c01e2ef1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186435764}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8501cdd8-7879-5e81-a6ba-962c1d7f9129" :question/math-academy-id "q-130532" :question/problem "Find $|{A}^{-1}|,$ if $A=[\\begin{aligned}-5 & -3 & 4 \\\\ -2 & 1 & 2 \\\\ 1 & -4 & 6\\end{aligned}].$" :question/worked-solution "Given an invertible $n\\times n$ matrix $A,$ we have\n\n$$\n|{A}^{-1}|=\\frac{1}{|A|}.\n$$\n\nFirst, we find $|A|$ using a Laplace expansion across the $2$nd row:\n\n$$\n\\begin{aligned}|A| & =|\\begin{aligned}-5 & -3 & 4 \\\\ -2 & 1 & 2 \\\\ 1 & -4 & 6\\end{aligned}| \\\\  & =-2(-1)^{2+1}|\\begin{aligned}-3 & 4 \\\\ -4 & 6\\end{aligned}|+1(-1)^{2+2}|\\begin{aligned}-5 & 4 \\\\ 1 & 6\\end{aligned}|+2(-1)^{2+3}|\\begin{aligned}-5 & -3 \\\\ 1 & -4\\end{aligned}| \\\\  & =2(-18+16)+(-30-4)-2(20+3) \\\\  & =-4-34-46 \\\\  & =-84\\end{aligned}\n$$\n\nTherefore, we obtain \n\n$$\n|{A}^{-1}|=\\frac{1}{|A|}=-\\frac{1}{84}.\n$$"}] [{:db/id #edb/ref 17592186435767 :knowledge-point/_questions [{:db/id #edb/ref 17592186119780 :knowledge-point/id #uuid "6e4dd07e-475b-5c89-883b-0e4adcf6a723" :knowledge-point/title "Calculating a Determinant Using the Linearity of the Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2fd88020-b9de-5670-bbb4-d000faac032e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "176" :db/id #edb/ref 17592186435744} {:answer/id #uuid "4e375b53-cb2c-56d7-a604-46a74124343b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "214" :db/id #edb/ref 17592186435749} {:answer/id #uuid "82e7b3e3-84d8-5737-a5f1-d3862a09a444" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "186" :db/id #edb/ref 17592186435753} {:answer/id #uuid "ac3611ee-496d-5cec-8534-0299f1c2f846" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "260" :db/id #edb/ref 17592186435756} {:answer/id #uuid "f62fda4e-f88c-56fa-9e53-1860b2a19543" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "244" :db/id #edb/ref 17592186435762}] :answer-field/correct {:answer/id #uuid "ac3611ee-496d-5cec-8534-0299f1c2f846" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "260" :db/id #edb/ref 17592186435756} :answer-field/id #uuid "0e7b949d-cbe6-5045-bf34-26b00edf4f82" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186435763}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3797960f-4f46-583b-afe6-1bb724ee5f4b" :question/math-academy-id "q-130641" :question/problem "Find\n$|\\begin{aligned}2 & 4 & -7 \\\\ 144 & 158 & 103 \\\\ 144 & 158 & 102\\end{aligned}|=$" :question/worked-solution "First, notice that the $2$nd row of our determinant is almost equal to the $3$rd row. So, we can rewrite the given determinant, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}2 & 4 & -7 \\\\ 144 & 158 & 103 \\\\ 144 & 158 & 102\\end{aligned}| & =|\\begin{aligned}2 & 4 & -7 \\\\ 144+0 & 158+0 & 102+1 \\\\ 144 & 158 & 102\\end{aligned}|\\end{aligned}\n$$\n\nNext, using the linearity property of determinants, we obtain\n\n$$\n\\begin{aligned}|\\begin{aligned}2 & 4 & -7 \\\\ 144+0 & 158+0 & 102+1 \\\\ 144 & 158 & 102\\end{aligned}| & =|\\begin{aligned}2 & 4 & -7 \\\\ 144 & 158 & 102 \\\\ 144 & 158 & 102\\end{aligned}|+|\\begin{aligned}2 & 4 & -7 \\\\ 0 & 0 & 1 \\\\ 144 & 158 & 102\\end{aligned}|.\\end{aligned}\n$$\n\nThe first determinant must be zero since it has two identical rows, while the second determinant can be expanded across the $2$nd row, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}2 & 4 & -7 \\\\ 144 & 158 & 102 \\\\ 144 & 158 & 102\\end{aligned}|+|\\begin{aligned}2 & 4 & -7 \\\\ 0 & 0 & 1 \\\\ 144 & 158 & 102\\end{aligned}| & =0+1(-1)^{2+3}|\\begin{aligned}2 & 4 \\\\ 144 & 158\\end{aligned}| \\\\  & =-(2\\cdot 158-4\\cdot 144) \\\\  & =-(316-576) \\\\  & =260\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186435768 :knowledge-point/_questions [{:db/id #edb/ref 17592186119780 :knowledge-point/id #uuid "6e4dd07e-475b-5c89-883b-0e4adcf6a723" :knowledge-point/title "Calculating a Determinant Using the Linearity of the Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "74feda84-0372-5ba8-a03f-6504fdd43cb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186435751} {:answer/id #uuid "81e999d9-b74a-531e-b396-75bcda8940a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186435752} {:answer/id #uuid "a5465cc4-707e-5513-9c9b-2c4ccb77d7a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186435754} {:answer/id #uuid "aee93a59-f631-5538-b707-3dbdac3a5bb0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186435757} {:answer/id #uuid "c2c0bd69-0ae8-5c67-b00c-53d8d88f988d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186435758}] :answer-field/correct {:answer/id #uuid "81e999d9-b74a-531e-b396-75bcda8940a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186435752} :answer-field/id #uuid "ea1881ff-14ad-5797-8c35-e1990ea0829e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186435766}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "788f9347-638e-5e07-bc97-727179291d72" :question/math-academy-id "q-130780" :question/problem "Given that \n$|\\begin{aligned}a & b & c \\\\ -3 & 5 & -1 \\\\ 0 & 1 & 1\\end{aligned}|=3,$\nfind \n$|\\begin{aligned}a-2 & b & c \\\\ -3 & 5 & -1 \\\\ 0 & 1 & 1\\end{aligned}|.$" :question/worked-solution "We \"factor out\" the given determinant from the determinant we would like to find:\n\n$$\n\\begin{aligned}|\\begin{aligned}a-2 & b & c \\\\ -3 & 5 & -1 \\\\ 0 & 1 & 1\\end{aligned}| & =|\\begin{aligned}a-2 & b+0 & c+0 \\\\ -3 & 5 & -1 \\\\ 0 & 1 & 1\\end{aligned}|\\end{aligned}\n$$\n\nNow, using the linearity property of determinants and expanding the second determinant across the $1$st row, we obtain\n\n$$\n\\begin{aligned}|\\begin{aligned}a-2 & b+0 & c+0 \\\\ -3 & 5 & -1 \\\\ 0 & 1 & 1\\end{aligned}| & ={{|\\begin{aligned}a & b & c \\\\ -3 & 5 & -1 \\\\ 0 & 1 & 1\\end{aligned}|}_{⏟}}_{3}+|\\begin{aligned}-2 & 0 & 0 \\\\ -3 & 5 & -1 \\\\ 0 & 1 & 1\\end{aligned}| \\\\  & =3-2(-1)^{1+1}|\\begin{aligned}5 & -1 \\\\ 1 & 1\\end{aligned}| \\\\  & =3-2\\cdot (5+1) \\\\  & =-9.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186435770 :knowledge-point/_questions [{:db/id #edb/ref 17592186119779 :knowledge-point/id #uuid "164c56ea-afbb-5ce4-800a-19002695db76" :knowledge-point/title "Calculating the Determinant of the Inverse of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44f82cc2-edfd-5f43-b0c8-b4fb5bfe4f97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186435746} {:answer/id #uuid "48f7dc16-cbeb-5e5b-b98b-3d2a1113c52c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186435747} {:answer/id #uuid "a7ea38b1-c61b-5047-b0ee-8b524e948890" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{81}" :db/id #edb/ref 17592186435755} {:answer/id #uuid "ca3a92c4-d4e6-5591-8bf1-5151ac26a42e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{27}" :db/id #edb/ref 17592186435759} {:answer/id #uuid "d6f0546b-c6ef-592b-ad4b-1acba6597c58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{17}" :db/id #edb/ref 17592186435761}] :answer-field/correct {:answer/id #uuid "48f7dc16-cbeb-5e5b-b98b-3d2a1113c52c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186435747} :answer-field/id #uuid "b9759cd8-4862-5dd3-9edc-5966b55e2eb1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186435765}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "eee0d247-b841-57bb-b4de-7b3606da042f" :question/math-academy-id "q-42583" :question/problem "Find $|{A}^{-1}|,$ if $A=[\\begin{aligned}7 & 6 & -3 \\\\ 1 & 2 & -1 \\\\ 5 & -5 & 2\\end{aligned}].$" :question/worked-solution "Given an invertible $n\\times n$ matrix $A,$ we have\n\n$$\n|{A}^{-1}|=\\frac{1}{|A|}.\n$$\n\nFirst, we find $|A|$ using a Laplace expansion across the $2$nd row:\n\n$$\n\\begin{aligned}|A| & =|\\begin{aligned}7 & 6 & -3 \\\\ 1 & 2 & -1 \\\\ 5 & -5 & 2\\end{aligned}| \\\\  & =1(-1)^{2+1}|\\begin{aligned}6 & -3 \\\\ -5 & 2\\end{aligned}|+2(-1)^{2+2}|\\begin{aligned}7 & -3 \\\\ 5 & 2\\end{aligned}|-1(-1)^{2+3}|\\begin{aligned}7 & 6 \\\\ 5 & -5\\end{aligned}| \\\\  & =-(12-15)+2(14+15)+(-35-30) \\\\  & =3+58-65 \\\\  & =-4\\end{aligned}\n$$\n\nTherefore, we obtain \n\n$$\n|{A}^{-1}|=\\frac{1}{|A|}=-\\frac{1}{4}.\n$$"}] [{:db/id #edb/ref 17592186354637 :knowledge-point/_questions [{:db/id #edb/ref 17592186119780 :knowledge-point/id #uuid "6e4dd07e-475b-5c89-883b-0e4adcf6a723" :knowledge-point/title "Calculating a Determinant Using the Linearity of the Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59a4042a-f605-574f-a228-ff4ae6d308e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186352358} {:answer/id #uuid "73d447eb-1e81-51dc-b291-5725cee52d82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186352581} {:answer/id #uuid "74558c61-b294-5a8c-be71-44c0d3822c23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186352586} {:answer/id #uuid "b27eb1ec-b060-5c68-b2a6-225457f0de0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186353093} {:answer/id #uuid "b5c62a94-26b3-5bea-ae7b-f2fbef1384ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186353125}] :answer-field/correct {:answer/id #uuid "74558c61-b294-5a8c-be71-44c0d3822c23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186352586} :answer-field/id #uuid "607dd21d-aeb7-5920-91bc-f439f202ce2d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186353991}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "27889ca3-5f85-5eb8-aee5-93c6c3d6c2ad" :question/math-academy-id "q-88298" :question/problem "Given that \n$|\\begin{aligned}a+2 & -2 & 2 \\\\ b+3 & 4 & 2 \\\\ c & 0 & 1\\end{aligned}|=5,$\nfind \n$|\\begin{aligned}a+1 & -2 & 2 \\\\ b & 4 & 2 \\\\ c & 0 & 1\\end{aligned}|.$" :question/worked-solution "We \"factor out\" the given determinant from the determinant we would like to find:\n\n$$\n\\begin{aligned}|\\begin{aligned}a+1 & -2 & 2 \\\\ b & 4 & 2 \\\\ c & 0 & 1\\end{aligned}| & =|\\begin{aligned}(a+2)-1 & -2 & 2 \\\\ (b+3)-3 & 4 & 2 \\\\ c+0 & 0 & 1\\end{aligned}|\\end{aligned}\n$$\n\n  \n\nNow, using the linearity property of determinants and expanding the second determinant across the $3$rd row, we obtain\n\n$$\n\\begin{aligned}|\\begin{aligned}(a+2)-1 & -2 & 2 \\\\ (b+3)-3 & 4 & 2 \\\\ c+0 & 0 & 1\\end{aligned}| & ={{|\\begin{aligned}(a+2) & -2 & 2 \\\\ (b+3) & 4 & 2 \\\\ c & 0 & 1\\end{aligned}|}_{⏟}}_{5}+|\\begin{aligned}-1 & -2 & 2 \\\\ -3 & 4 & 2 \\\\ 0 & 0 & 1\\end{aligned}| \\\\  & =5+1\\cdot (-1)^{3+3}|\\begin{aligned}-1 & -2 \\\\ -3 & 4\\end{aligned}| \\\\  & =5+(-10) \\\\  & =-5.\\end{aligned}\n$$"}]}
