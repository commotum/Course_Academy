-aee2-f32cf13014aa" 13194139534957 17592186045417 true] [17592186445677 1068 #edb/ref 17592186445675 13194139534957 17592186045417 true] [17592186445677 1069 "q-65864" 13194139534957 17592186045417 true] [17592186445677 1070 #edb/ref 17592186045485 13194139534957 17592186045417 true] [17592186445677 1071 "Evaluate $\\frac{\\text{d}}{\\text{d}t}[f(r(t))]$ at $t=\\frac{\\pi }{4}$ given that $∇f(x,y)=\\frac{2x}{{x}^{2}+{y}^{2}}\\,i+\\frac{2y}{{x}^{2}+{y}^{2}}\\,j$ and $r(t)=\\operatorname{sin}⁡t\\text{ }i+\\operatorname{cos}⁡t\\text{ }j.$" 13194139534957 17592186045417 true] [17592186445677 1072 #uuid "021b7b63-3816-5a7a-9f77-baf36bf193bb" 13194139534957 17592186045417 true] [17592186445677 1074 "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nIn addition, we've been given that\n\n$$\n∇f(x,y)=\\frac{2x}{{x}^{2}+{y}^{2}}\\,i+\\frac{2y}{{x}^{2}+{y}^{2}}\\,j.\n$$\n\nFirst, we substitute $x=\\operatorname{sin}⁡t$ and $y=\\operatorname{cos}⁡t$ into $∇f(x,y)$ to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =\\frac{2\\operatorname{sin}⁡t}{{sin}^{2}⁡t+{cos}^{2}⁡t}\\,i+\\frac{2\\operatorname{cos}⁡t}{{sin}^{2}⁡t+{cos}^{2}⁡t}\\,j \\\\  & =2\\operatorname{sin}⁡t\\,i+2\\operatorname{cos}⁡t\\,j\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)\\,j \\\\  & =\\operatorname{cos}⁡t\\,i+(-\\operatorname{sin}⁡t)\\,j.\\end{aligned}\n$$\n\nApplying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =(2\\operatorname{sin}⁡t\\,i+2\\operatorname{cos}⁡t\\,j)\\cdot (\\operatorname{cos}⁡t\\,i+(-\\operatorname{sin}⁡t)\\,j) \\\\  & =2\\operatorname{sin}⁡t\\cdot \\operatorname{cos}⁡t+2\\operatorname{cos}⁡t\\cdot (-\\operatorname{sin}⁡t) \\\\  & =2\\operatorname{sin}⁡t\\operatorname{cos}⁡t-2\\operatorname{sin}⁡t\\operatorname{cos}⁡t \\\\  & =0.\\end{aligned}\n$$\n\nFinally, evaluating the above at $t=\\frac{\\pi }{4},$ we obtain\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(\\frac{\\pi }{4}))] & =0.\\end{aligned}\n$$" 13194139534957 17592186045417 true] [17592186445678 1068 #edb/ref 17592186445673 13194139534957 17592186045417 true] [17592186445678 1069 "q-95051" 13194139534957 17592186045417 true] [17592186445678 1070 #edb/ref 17592186045485 13194139534957 17592186045417 true] [17592186445678 1071 "If $f(x,y)={x}^{4}-{y}^{4}$ and $r(t)=\\operatorname{cos}⁡t\\,i+\\operatorname{sin}⁡t\\,j,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" 13194139534957 17592186045417 true] [17592186445678 1072 #uuid "240fc49a-d022-5d2c-b6ad-58058500b98b" 13194139534957 17592186045417 true] [17592186445678 1074 "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y):$\n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂}{∂x}({x}^{4}-{y}^{4})\\,i+\\frac{∂}{∂y}({x}^{4}-{y}^{4})\\,j \\\\  & =4{x}^{3}\\,i-4{y}^{3}\\,j\\end{aligned}\n$$\n\nNext, we substitute $x=\\operatorname{cos}⁡t$ and $y=\\operatorname{sin}⁡t$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =4{cos}^{3}⁡t\\,i-4{sin}^{3}⁡t\\,j\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)\\,j \\\\  & =-\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =(4{cos}^{3}⁡t\\,i-4{sin}^{3}⁡t\\,j)\\cdot (-\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j) \\\\  & =-4\\operatorname{sin}⁡t{cos}^{3}⁡t-4{sin}^{3}⁡t\\operatorname{cos}⁡t \\\\  & =-4\\operatorname{sin}⁡t\\operatorname{cos}⁡t({cos}^{2}⁡t+{sin}^{2}⁡t) \\\\  & =-4\\operatorname{sin}⁡t\\operatorname{cos}⁡t \\\\  & =-2\\operatorname{sin}⁡(2t).\\end{aligned}\n$$" 13194139534957 17592186045417 true] [17592186445679 1068 #edb/ref 17592186445674 13194139534957 17592186045417 true] [17592186445679 1069 "q-167463" 13194139534957 17592186045417 true] [17592186445679 1070 #edb/ref 17592186045487 13194139534957 17592186045417 true] [17592186445679 1071 "If $f(x,y,z)=\\operatorname{sin}⁡(xyz)$ and $r(t)=t\\,i+2t\\,j+\\frac{1}{t}\\,k,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" 13194139534957 17592186045417 true] [17592186445679 1072 #uuid "430b6986-f30c-500a-b5e9-219dd0f3ace5" 13194139534957 17592186045417 true] [17592186445679 1074 "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y,z):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\frac{∂}{∂x}(\\operatorname{sin}⁡(xyz))\\,i+\\frac{∂}{∂y}(\\operatorname{sin}⁡(xyz))\\,j+\\frac{∂}{∂z}(\\operatorname{sin}⁡(xyz))\\,k \\\\  & =yz\\operatorname{cos}⁡(xyz)\\,i+xz\\operatorname{cos}⁡(xyz)\\,j+xy\\operatorname{cos}⁡(xyz)\\,k\\end{aligned}\n$$\n\nNext, we substitute $x=t,$ $y=2t$ and $z=\\frac{1}{t}$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =2\\operatorname{cos}⁡(2t)\\,i+\\operatorname{cos}⁡(2t)\\,j+2{t}^{2}\\operatorname{cos}⁡(2t)\\,k\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(t)\\,i+\\frac{\\text{d}}{\\text{d}t}(2t)\\,j+\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{t})\\,k \\\\  & =\\,i+2\\,j-\\frac{1}{{t}^{2}}\\,k.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =(2\\operatorname{cos}⁡(2t)\\,i+\\operatorname{cos}⁡(2t)\\,j+2{t}^{2}\\operatorname{cos}⁡(2t)\\,k)\\cdot (\\,i+2\\,j-\\frac{1}{{t}^{2}}\\,k) \\\\  & =2\\operatorname{cos}⁡(2t)\\cdot 1+\\operatorname{cos}⁡(2t)\\cdot 2+2{t}^{2}\\operatorname{cos}⁡(2t)\\cdot (-\\frac{1}{{t}^{2}}) \\\\  & =2\\operatorname{cos}⁡(2t)+2\\operatorname{cos}⁡(2t)-2\\operatorname{cos}⁡(2t) \\\\  & =2\\operatorname{cos}⁡(2t).\\end{aligned}\n$$" 13194139534957 17592186045417 true] [17592186445680 1068 #edb/ref 17592186445676 13194139534957 17592186045417 true] [17592186445680 1069 "q-36234" 13194139534957 17592186045417 true] [17592186445680 1070 #edb/ref 17592186045487 13194139534957 17592186045417 true] [17592186445680 1071 "Compute the rate of change of the function $f(x,y)={x}^{2}\\operatorname{sin}⁡y$ with respect to $t$ along the curve $r(t)=⟨\\operatorname{ln}⁡t,2t⟩$ at the point $t=\\pi .$" 13194139534957 17592186045417 true] [17592186445680 1072 #uuid "b98d6bad-fbc9-5978-8040-a1a35d995f54" 13194139534957 17592186045417 true] [17592186445680 1074 "The rate of change of $f(x,y,z)$ with respect to $t$ along the curve $r(t)$ is given by $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$ To calculate this, we can use the chain rule.\n\nThe chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y):$\n\n$$\n\\begin{aligned}∇f(x,y) & =⟨\\frac{∂}{∂x}({x}^{2}\\operatorname{sin}⁡y),\\frac{∂}{∂y}({x}^{2}\\operatorname{sin}⁡y)⟩ \\\\  & =⟨2x\\operatorname{sin}⁡y,{x}^{2}\\operatorname{cos}⁡y⟩\\end{aligned}\n$$\n\nNext, we substitute $x=\\operatorname{ln}⁡t$ and $y=2t$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =⟨2\\operatorname{ln}⁡t\\operatorname{sin}⁡2t,{ln}^{2}⁡t\\operatorname{cos}⁡2t⟩\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡t),\\frac{\\text{d}}{\\text{d}t}(2t)⟩ \\\\  & =⟨\\frac{1}{t},2⟩.\\end{aligned}\n$$\n\nApplying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =⟨2\\operatorname{ln}⁡t\\operatorname{sin}⁡2t,{ln}^{2}⁡t\\operatorname{cos}⁡2t⟩\\cdot ⟨\\frac{1}{t},2⟩ \\\\  & =2\\operatorname{ln}⁡t\\operatorname{sin}⁡2t\\cdot \\frac{1}{t}+{ln}^{2}⁡t\\operatorname{cos}⁡2t\\cdot 2 \\\\  & =\\frac{2\\operatorname{ln}⁡t\\operatorname{sin}⁡2t}{t}+2{ln}^{2}⁡t\\operatorname{cos}⁡2t.\\end{aligned}\n$$\n\nTherefore, the rate of change of $f$ along the curve $r(t)$ at $t=\\pi $ is\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(\\pi ))] & =\\frac{2\\operatorname{ln}⁡\\pi \\operatorname{sin}⁡2\\pi }{\\pi }+2{ln}^{2}⁡\\pi \\operatorname{cos}⁡2\\pi  \\\\  & =2{ln}^{2}⁡\\pi .\\end{aligned}\n$$" 13194139534957 17592186045417 true]] :edb/tempids {"answer-05ab9250-28af-5908-8d6f-09833d521f51" 17592186445643 "answer-0c059460-c4c2-55a2-8585-7e51d8edae78" 17592186445644 "answer-21d33325-0f7c-59d5-9622-3be484ea7f04" 17592186445645 "answer-28207432-84ed-53b8-96d3-f43fe1450b2c" 17592186445646 "answer-2d6b5248-8092-5223-a861-76c990d98151" 17592186445647 "answer-3a36a033-d9b0-5aa7-a7f4-b5451390ac7a" 17592186445648 "answer-3f8c2a6a-498f-5431-bf0a-f09364aeca5b" 17592186445649 "answer-47522fd9-62bd-5474-804d-67ac7a770b4b" 17592186445650 "answer-4b40ea9e-cf34-5238-9134-0581b982e962" 17592186445651 "answer-4bc8881d-ce79-5fa4-94b3-93194df95932" 17592186445652 "answer-55795f5b-54c2-5a78-8f3f-d7bc330a0c55" 17592186445653 "answer-60dab585-b4f4-59ea-8d98-9a5182b158eb" 17592186445654 "answer-67d5968e-4c9e-5d9b-9b55-ddaa5793f241" 17592186445655 "answer-683e544e-ffb7-547d-87ef-b5301c6dac41" 17592186445656 "answer-76ff76d1-a44d-5785-aeb6-f49cd08b8d01" 17592186445657 "answer-869d2a2c-eca1-5a81-9c8c-bd38ea652d36" 17592186445658 "answer-88d607c8-fe3c-5a8f-95e2-26b4560aaab5" 17592186445659 "answer-8d6d49e7-278c-5501-995f-670dd3f19484" 17592186445660 "answer-99330b27-129d-50df-97de-421d0fe9607b" 17592186445661 "answer-9980bb90-a6ef-51f4-88b3-4812a2e11e8e" 17592186445662 "answer-9a2dcd24-b4f5-5abd-afe6-bb8c91b06230" 17592186445663 "answer-b