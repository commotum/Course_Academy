#{[{:activity/expected-seconds 600.0 :activity/first-step {:db/id #edb/ref 17592186148287} :activity/id #uuid "6cd22d89-74ae-5514-8d31-658810158855" :activity/scope {:db/id #edb/ref 17592186048291 :topic/id #uuid "91890390-2801-5fd4-8f87-a9c37f742926" :topic/math-academy-id 2525} :activity/steps [{:db/id #edb/ref 17592186148287 :step/content {:db/id #edb/ref 17592186148746 :tutorial/content "**Damped harmonic motion** is a form of harmonic motion where there is an additional damping force proportional to the object's velocity, $y',$ and acts in the opposite direction to that of the motion. This damping force acts to decrease the object's amplitude over time.\n\nIf the **damping coefficient** is $b,$ then the equation of damped harmonic motion is\n\n$$\ny'' = - by' - \\omega^2 y \\quad \\Longrightarrow \\quad y'' + by' + \\omega^2 y = 0.\n$$\n\nConcretely, if you take a simple harmonic oscillator and place it in a viscous fluid (e.g., air), the result will be a damped harmonic oscillator." :tutorial/id #uuid "92725021-d224-5ce8-927f-8e97c66ade9a" :tutorial/math-academy-id 4068 :tutorial/title "Introduction"} :step/id #uuid "f76ac548-c4d6-58a9-a7ff-c011a4e7386c" :step/math-academy-id 24278 :step/next {:db/id #edb/ref 17592186148303}} {:db/id #edb/ref 17592186148303 :step/content {:db/id #edb/ref 17592186147444 :knowledge-point/canonical-example {:db/id #edb/ref 17592186147372 :question/id #uuid "18371fa9-696a-5a3a-b7e6-400f14d2fe62" :question/math-academy-id "e-6724"} :knowledge-point/id #uuid "aad85367-37ea-500f-8405-f9464bf4f773" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050824}] :knowledge-point/questions [{:db/id #edb/ref 17592186148163} {:db/id #edb/ref 17592186148176} {:db/id #edb/ref 17592186335717} {:db/id #edb/ref 17592186348232} {:db/id #edb/ref 17592186357719} {:db/id #edb/ref 17592186357720} {:db/id #edb/ref 17592186432827}] :knowledge-point/title "Identifying Equations that Represent Damped Harmonic Motion"} :step/id #uuid "6fe421a6-8381-535b-acdf-27529fb1c5b2" :step/math-academy-id 24686 :step/next {:db/id #edb/ref 17592186148315}} {:db/id #edb/ref 17592186148304 :step/content {:db/id #edb/ref 17592186147445 :knowledge-point/canonical-example {:db/id #edb/ref 17592186147373 :question/id #uuid "365ec1d4-0301-5dfe-a731-35f12ea4d3a5" :question/math-academy-id "e-6725"} :knowledge-point/id #uuid "089c1139-6e3a-5240-be03-fb7e54ecbd7c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050334}] :knowledge-point/questions [{:db/id #edb/ref 17592186148175} {:db/id #edb/ref 17592186148179} {:db/id #edb/ref 17592186335725} {:db/id #edb/ref 17592186335726} {:db/id #edb/ref 17592186357722} {:db/id #edb/ref 17592186357723} {:db/id #edb/ref 17592186357725} {:db/id #edb/ref 17592186432828} {:db/id #edb/ref 17592186565427} {:db/id #edb/ref 17592186565433}] :knowledge-point/title "Identifying Types of Damped Oscillations"} :step/id #uuid "84eb5ffa-7746-5e86-a7b2-576422ad0e72" :step/math-academy-id 24687 :step/next {:db/id #edb/ref 17592186148316}} {:db/id #edb/ref 17592186148305 :step/content {:db/id #edb/ref 17592186147446 :knowledge-point/canonical-example {:db/id #edb/ref 17592186147374 :question/id #uuid "0458947c-70c8-5f88-9e52-68c8950afd7c" :question/math-academy-id "e-6726"} :knowledge-point/id #uuid "dfa8f9b2-1628-5f9f-8f0e-0fd6c01c70d4" :knowledge-point/questions [{:db/id #edb/ref 17592186148165} {:db/id #edb/ref 17592186148177} {:db/id #edb/ref 17592186335718} {:db/id #edb/ref 17592186335719} {:db/id #edb/ref 17592186348240} {:db/id #edb/ref 17592186357727} {:db/id #edb/ref 17592186357728} {:db/id #edb/ref 17592186432829} {:db/id #edb/ref 17592186492860} {:db/id #edb/ref 17592186565431}] :knowledge-point/title "Constructing a Differential Equation Governing a Damped Harmonic Motion"} :step/id #uuid "f9fd238a-cae7-5cac-b54a-a6e5205541ba" :step/math-academy-id 24688 :step/next {:db/id #edb/ref 17592186148306}} {:db/id #edb/ref 17592186148306 :step/content {:db/id #edb/ref 17592186147447 :knowledge-point/canonical-example {:db/id #edb/ref 17592186147375 :question/id #uuid "c93a18f3-6d09-5d88-8a90-434fc08d3874" :question/math-academy-id "e-6727"} :knowledge-point/id #uuid "48a64312-22d5-57ed-b83b-254aff2ca870" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048289}] :knowledge-point/questions [{:db/id #edb/ref 17592186148166} {:db/id #edb/ref 17592186148180} {:db/id #edb/ref 17592186357733} {:db/id #edb/ref 17592186357734} {:db/id #edb/ref 17592186357735} {:db/id #edb/ref 17592186392870} {:db/id #edb/ref 17592186393940} {:db/id #edb/ref 17592186432826}] :knowledge-point/title "Calculating the Period of a Damped Oscillation"} :step/id #uuid "876d7761-31c7-56a1-a2bc-f3e0e05e03c5" :step/math-academy-id 24692} {:db/id #edb/ref 17592186148315 :step/content {:db/id #edb/ref 17592186148764 :tutorial/content "There are three types of damped harmonic motion:\n\n- **Heavy damping** occurs when the damping force is so large that the object returns to the equilibrium position very slowly, without any oscillation.\n\n- **Critical damping** occurs when the damping force is just sufficient to allow the object to return to the equilibrium position in the shortest amount of time. There are no oscillations.\n\n- **Light damping** occurs when the damping force is light enough that the object passes beyond the equilibrium position. The object oscillates back and forth about the equilibrium position, but the amplitude of oscillation is gradually reduced over time.\n\n![](images/79/79991a25e69629a10f69389be85537f058f66b187f9241a28a5f892ada4b0d2d.png)\n\nGiven an equation that describes damped motion, we can determine the type of damping by computing the discriminant $\\mathcal{D}$ of the characteristic equation:\n\n- $\\mathcal{D} < 0$ leads to light damping.\n\n- $\\mathcal{D} > 0$ leads to heavy damping.\n\n- $\\mathcal{D} = 0$ leads to critical damping.\n\nIntuitively, $\\mathcal{D} < 0$ leads to light damping because the characteristic equation has two complex solutions, meaning that the general solution contains sinusoidal terms that are multiplied by an exponential decay term. This results in oscillations that decay in amplitude as $t$ increases.\n\nOn the other hand, $\\mathcal{D} > 0$ leads to heavy damping because the characteristic equation has two real solutions. In practice, both of these real solutions will be negative, leading to exponential decay in the amplitude of the oscillator as $t$ increases.\n\nFinally, the case $\\mathcal{D} = 0$ leads to critical damping because the characteristic equation has exactly one real solution, meaning that the general solution can be written in terms of as a single exponential decay term $y(t) = (c_1 + c_2 t)e^{\\lambda t}.$" :tutorial/id #uuid "cb17cc59-7cc0-5c34-87ac-7663dbb08c95" :tutorial/math-academy-id 4166 :tutorial/title "Light, Critical, and Heavy Damping"} :step/id #uuid "3cedcfab-cfca-5783-a755-b96fcbd7b336" :step/math-academy-id 25337 :step/next {:db/id #edb/ref 17592186148304}} {:db/id #edb/ref 17592186148316 :step/content {:db/id #edb/ref 17592186148765 :tutorial/content "Remember that, if an object of mass $m$ is attached to a spring with spring constant $k,$ then the equation of motion is\n\n$$\nmy'' = -ky.\n$$\n\nIf there is an additional damping force with damping coefficient $c,$ then we have\n\n$$\nmy'' = -cy'-ky.\n$$" :tutorial/id #uuid "9ba41777-f1f4-5722-b629-eb8be1f7e53d" :tutorial/math-academy-id 4167 :tutorial/title "The Equation of Motion for a Mass-Spring System with Damping"} :step/id #uuid "6e244fad-d7c8-5529-acf3-f465d0566799" :step/math-academy-id 25338 :step/next {:db/id #edb/ref 17592186148305}}] :activity/title "Damped Oscillators" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186147704}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186492930} :activity/id #uuid "e105eddc-8c82-5367-8da3-802f4df0bb5b" :activity/scope {:db/id #edb/ref 17592186048291 :topic/id #uuid "91890390-2801-5fd4-8f87-a9c37f742926" :topic/math-academy-id 2525} :activity/steps [{:db/id #edb/ref 17592186492930 :step/content {:db/id #edb/ref 17592186148165 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a8cce54-8d1b-5552-8013-ecc91a4ca4d7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{″}+2{y}^{′}+\\sqrt{5}y=0" :db/id #edb/ref 17592186333085} {:answer/id #uuid "27aad3bf-b0f4-5a87-99db-444aae8d77be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{″}+2{y}^{′}+5y=0" :db/id #edb/ref 17592186333353} {:answer/id #uuid "8567aa7e-ea4a-5013-9a78-d111c421b739" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{″}+4{y}^{′}+\\sqrt{5}y=0" :db/id #edb/ref 17592186334176} {:answer/id #uuid "c7a03806-83d4-5e14-86fa-53eac968e9de" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{″}+4{y}^{′}+5y=0" :db/id #edb/ref 17592186334724} {:answer/id #uuid "fddbde14-0a61-5c46-b4ec-42db0bc313c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{″}+4{y}^{′}+10y=0" :db/id #edb/ref 17592186335222}] :answer-field/correct {:db/id #edb/ref 17592186333353} :answer-field/id #uuid "8a0d3c34-b28e-527f-9cd6-b4c78c62ebfe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335502}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "39f1ef46-09c9-5bbf-b30f-92ddff3f269a" :question/math-academy-id "q-64544" :question/problem "A particle of mass $2\\,\\text{kg}$ is attached to a massless spring. The spring constant associated with the spring is $k=10\\,{\\text{kg/s}}^{2}.$  The particle is also subject to a resistive force that's proportional to the particle's velocity, and has a damping coefficient $c=4\\,\\text{kg/s}.$  The position of the particle is $y(t)$ (measured in meters), and $t>0$ is the time in seconds.  If the particle moves with damped harmonic motion, what is the governing equation?" :question/worked-solution "The equation of damped harmonic motion is\n\n$$\nm{y}^{″}=-c{y}^{′}-ky.\n$$\n\nSubstituting our values for $m,$ $k$ and $c$ gives\n\n$$\n2{y}^{″}=-4{y}^{′}-10y.\n$$\n\nRearranging the above equation, we get:\n\n$$\n{y}^{″}+2{y}^{′}+5y=0\n$$"} :step/id #uuid "06acec39-d327-51ec-a3a9-8ca37dc49d61" :step/next {:db/id #edb/ref 17592186492992}} {:db/id #edb/ref 17592186492958 :step/content {:db/id #edb/ref 17592186357735 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ae5ca6c-b6ab-5388-877b-d5ca6d9eb62b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{2}\\,\\text{s}" :db/id #edb/ref 17592186354765} {:answer/id #uuid "5d972e39-e927-56e2-b99d-4e46df052c83" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi \\,\\text{s}" :db/id #edb/ref 17592186355493} {:answer/id #uuid "81c20bc1-e47f-5c2e-9a46-0acdaacc1125" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\pi \\,\\text{s}" :db/id #edb/ref 17592186355805} {:answer/id #uuid "90f39a76-999a-5f5e-af3a-84399b5b4654" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{3}\\,\\text{s}" :db/id #edb/ref 17592186355944} {:answer/id #uuid "e250ca5b-a5c5-5fac-99d7-b0a98c858d62" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi \\,\\text{s}" :db/id #edb/ref 17592186356645}] :answer-field/correct {:db/id #edb/ref 17592186354765} :answer-field/id #uuid "85e1d4a0-4f40-5e9a-ab7c-ce32e079e4e3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186357156}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5422f95b-90d3-50c4-8d3e-e9b726ff2915" :question/math-academy-id "q-94363" :question/problem "The position $y(t)$ of a particle oscillating with light damped harmonic motion is governed by the equation\n\n$$\n{y}^{″}+12{y}^{′}+52y=0,\n$$\n\nwhere $t>0$ is the time, in seconds. What is the period of the damped oscillation?" :question/worked-solution "The given equation represents the equation of damped harmonic motion. We are looking for solutions of the form $y={e}^{\\lambda t}.$\n\nThe auxiliary equation for $\\lambda $ is\n\n$$\n{\\lambda }^{2}+12\\lambda +52=0.\n$$\n\nThe auxiliary equation can be solved by completing the square:\n\n$$\n\\begin{aligned}{\\lambda }^{2}+12\\lambda +52 & =0 \\\\ ({\\lambda }^{2}+12\\lambda +36)-36+52 & =0 \\\\ (\\lambda +6)^{2}+16 & =0 \\\\ (\\lambda +6)^{2} & =-16 \\\\ \\lambda +6 & =\\pm 4\\text{i} \\\\ \\lambda  & =-6\\pm 4\\text{i}\\end{aligned}\n$$\n\nSo, the general solution is\n\n$$\n{y}_{c}={e}^{-6t}(A\\operatorname{cos}⁡4t+B\\operatorname{sin}⁡4t).\n$$\n\nFrom the solution, the value of the angular frequency is $Ω=4\\,{\\text{s}}^{-1}.$\n\nThe period of the damped oscillation $T$ is related to the angular frequency as follows:\n\n$$\nT=\\frac{2\\pi }{Ω}\n$$\n\nSo the period is\n\n$$\nT=\\frac{2\\pi }{4}=\\frac{\\pi }{2}\\,\\text{s}.\n$$"} :step/id #uuid "726cd511-7178-5415-bb9a-cffdf46b0c76"} {:db/id #edb/ref 17592186492983 :step/content {:db/id #edb/ref 17592186335725 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f631397-1fc5-5f73-8f1c-6752ba962aca" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186451465} {:answer/id #uuid "bdd4b1af-69f4-5724-900e-69d4836fcf5f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186451466}] :answer-field/correct {:db/id #edb/ref 17592186451466} :answer-field/id #uuid "6374e92f-3ad0-501c-9e81-fde082964406" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186452580} {:answer-field/choices [{:answer/id #uuid "9fca6602-54be-566a-94ca-51a24f960139" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186451467} {:answer/id #uuid "7ef9320d-e4ac-5a81-bcca-b06cac9ffce1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186451468}] :answer-field/correct {:db/id #edb/ref 17592186451467} :answer-field/id #uuid "f4230243-b999-5225-8057-f0e153de4518" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186452581} {:answer-field/choices [{:answer/id #uuid "e7875532-f5c7-5be9-bb70-9565d2e57d53" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186451469} {:answer/id #uuid "10d8e653-fcc4-5468-9d5b-1c81e9786209" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186451470}] :answer-field/correct {:db/id #edb/ref 17592186451469} :answer-field/id #uuid "b08c2525-28fa-502f-a408-27b29f00cddd" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186452582}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0dca080f-586e-56e2-9297-7dcd4b704b21" :question/math-academy-id "q-64615" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** ${y}^{″}+4{y}^{′}+8y=0$ represents an oscillator undergoing light damping.\n- **II.** ${y}^{″}+6{y}^{′}+9y=0$ represents an oscillator undergoing heavy damping.\n- **III.** ${y}^{″}+3{y}^{′}+2y=0$ represents an oscillator undergoing critical damping." :question/worked-solution "Remember that, given the equation of a damped harmonic oscillator, the type of damping depends on the discriminant of the characteristic equation:\n\n- $D>0$ leads to heavy damping,\n\n- $D=0$ leads to critical damping, and\n\n- $D<0$ leads to light damping.\n\nWith that in mind, let's inspect each equation.\n\n- The differential equation ${y}^{″}+4{y}^{′}+8y=0$ represents the equation of damped harmonic motion. \nThe auxiliary equation for $\\lambda $ is\n\n$$\n{\\lambda }^{2}+4\\lambda +8=0\n$$\n\nThe discriminant of this quadratic equation is:\n\n$$\n\\begin{aligned}D={4}^{2}-4(1)(8) & =-16<0\\end{aligned}\n$$\n\nThus, the given equation represents light damping, and so statement I is correct.\n\n- The differential equation ${y}^{″}+6{y}^{′}+9y=0$ represents the equation of damped harmonic motion. \nThe auxiliary equation for $\\lambda $ is:\n\n$$\n{\\lambda }^{2}+6\\lambda +9=0\n$$\n\nThe discriminant of this quadratic equation is\n\n$$\n\\begin{aligned}D={6}^{2}-4(1)(9) & =0\\end{aligned}\n$$\n\nThus, the given equation represents critical damping, and so statement II is false.\n\n- The differential equation ${y}^{″}+3{y}^{′}+2y=0$ represents the equation of damped harmonic motion. \nThe auxiliary equation for $\\lambda $ is:\n\n$$\n{\\lambda }^{2}+3\\lambda +2=0\n$$\n\nThe discriminant of this quadratic equation is\n\n$$\n\\begin{aligned}D={3}^{2}-4(1)(2) & =1>0\\end{aligned}\n$$\n\nThus, the given equation represents heavy damping, and so statement III is false.\n\nIn conclusion, the correct answer is \"I only\"."} :step/id #uuid "a6a5f833-dfc1-55ac-aacc-8293896b4d29" :step/next {:db/id #edb/ref 17592186492994}} {:db/id #edb/ref 17592186492992 :step/content {:db/id #edb/ref 17592186148176 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5898a6ac-6276-53c2-8174-421d58a64302" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{″}+6{y}^{′}-36y=0" :db/id #edb/ref 17592186492387} {:answer/id #uuid "98baa58c-cc87-572a-a2cc-76a2b22b2949" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{″}+6y=t{e}^{2t}" :db/id #edb/ref 17592186492512} {:answer/id #uuid "cf48a76b-b34b-52d6-9b6c-82a901119ce7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{″}+4y=\\operatorname{sin}⁡2t" :db/id #edb/ref 17592186492627} {:answer/id #uuid "e1ec7c0c-764a-586c-b9c0-5e640d3e5d0e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{″}+14y=0" :db/id #edb/ref 17592186492656} {:answer/id #uuid "edb22a88-3dee-5ab3-9eab-16b36a52cc88" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{″}+5{y}^{′}+4y=0" :db/id #edb/ref 17592186492676}] :answer-field/correct {:db/id #edb/ref 17592186492676} :answer-field/id #uuid "5b280057-4b77-5222-8500-d6db2864a327" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186146810}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "33cf3153-c27d-5bbc-907b-c204e6c3dd74" :question/math-academy-id "q-64589" :question/problem "The function $y(t)$ gives the position of a particle at time $t.$ Which of the following equations represents a situation in which the particle is undergoing damped harmonic motion?" :question/worked-solution "The equation of damped harmonic motion is\n\n$$\n{y}^{″}+b{y}^{′}+{\\omega }^{2}y=0.\n$$\n\nComparing our equation with the above, we can see that the only equation that represents damped harmonic motion is\n\n$$\n{y}^{″}+5{y}^{′}+4y=0.\n$$"} :step/id #uuid "c9344b76-01c4-51a8-93d4-484fc5c517c0" :step/next {:db/id #edb/ref 17592186492983}} {:db/id #edb/ref 17592186492994 :step/content {:db/id #edb/ref 17592186492860 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "57c78e60-9652-56b2-b93f-2476d1e583aa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{″}+{y}^{′}+2y=0" :db/id #edb/ref 17592186492384} {:answer/id #uuid "616b6e13-f025-52ac-b464-e1464f7dc509" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{″}+{y}^{′}+y=0" :db/id #edb/ref 17592186492414} {:answer/id #uuid "98f9ec65-c855-5e81-b0cc-f12a6f566426" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{″}+2{y}^{′}+6y=0" :db/id #edb/ref 17592186492513} {:answer/id #uuid "9cf8994c-214a-592c-b261-82613704efbd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{″}+6{y}^{′}+6y=0" :db/id #edb/ref 17592186492522} {:answer/id #uuid "f1855cab-b3bd-5fe3-b443-b54786bc6c68" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{″}+2{y}^{′}+2y=0" :db/id #edb/ref 17592186492685}] :answer-field/correct {:db/id #edb/ref 17592186492685} :answer-field/id #uuid "75bd61b2-2c49-5cb8-900c-1fc581123b01" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186492753}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "53714f34-122d-5a8f-aba0-bbac28e356b1" :question/math-academy-id "q-94323" :question/problem "A particle of mass $6\\,\\text{kg}$ is attached to a massless spring. The spring constant associated with the spring is $k=12\\,{\\text{kg/s}}^{2}.$  The particle is also subject to a resistive force that's proportional to the particle's velocity, and has a damping coefficient $c=12\\,\\text{kg/s}.$  The position of the particle is $y(t)$ (measured in meters), and $t>0$ is the time in seconds.  If the particle moves with damped harmonic motion, what is the governing equation?" :question/worked-solution "The equation of damped harmonic motion is\n\n$$\nm{y}^{″}=-c{y}^{′}-ky.\n$$\n\nSubstituting our values for $m,$ $k$ and $c$ gives\n\n$$\n6{y}^{″}=-12{y}^{′}-12y.\n$$\n\nRearranging the above equation, we get\n\n$$\n{y}^{″}+2{y}^{′}+2y=0.\n$$"} :step/id #uuid "cdb1bdda-cf85-56bf-adf8-d73b83603d02" :step/next {:db/id #edb/ref 17592186492958}}] :activity/title "Damped Oscillators" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186492219}] [{:activity/course {:db/id #edb/ref 17592186046660} :activity/first-step {:db/id #edb/ref 17592186565522} :activity/id #uuid "7aac9d9a-80dd-50d1-aa8b-32026d2b7b98" :activity/scope {:db/id #edb/ref 17592186048291 :topic/id #uuid "91890390-2801-5fd4-8f87-a9c37f742926" :topic/math-academy-id 2525} :activity/steps [{:db/id #edb/ref 17592186565491 :step/content {:db/id #edb/ref 17592186357733 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "098be5a2-3449-53d3-8787-924e2faef4a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{4}\\,\\text{s}" :db/id #edb/ref 17592186354753} {:answer/id #uuid "2421dbf5-639c-51c5-ac36-217830997498" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi \\,\\text{s}" :db/id #edb/ref 17592186354967} {:answer/id #uuid "6270f4fe-39cc-52dd-b48b-61d7726bfe56" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi \\,\\text{s}" :db/id #edb/ref 17592186355542} {:answer/id #uuid "a7e5122d-2e0c-509c-9441-9e8006224500" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{2}\\,\\text{s}" :db/id #edb/ref 17592186356151} {:answer/id #uuid "bd86b034-29fe-5df6-87e7-b0ee1467bc14" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{3}\\,\\text{s}" :db/id #edb/ref 17592186356324}] :answer-field/correct {:db/id #edb/ref 17592186355542} :answer-field/id #uuid "e17dd377-3bf3-56a9-b857-336a7a07eb77" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186357319}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2fac86fa-e6ef-53c4-af18-2a5008f32591" :question/math-academy-id "q-94359" :question/problem "The position $y(t)$ of a particle oscillating with light damped harmonic motion is governed by the equation\n\n$$\n{y}^{″}+6{y}^{′}+10y=0,\n$$\n\nwhere $t>0$ is the time, in seconds. What is the period of the damped oscillation?" :question/worked-solution "The given equation represents the equation of damped harmonic motion. We are looking for solutions of the form $y={e}^{\\lambda t}.$\n\nThe auxiliary equation for $\\lambda $ is\n\n$$\n{\\lambda }^{2}+6\\lambda +10=0.\n$$\n\nThe auxiliary equation can be solved by completing the square:\n\n$$\n\\begin{aligned}{\\lambda }^{2}+6\\lambda +10 & =0 \\\\ ({\\lambda }^{2}+6\\lambda +9)-9+10 & =0 \\\\ (\\lambda +3)^{2}+1 & =0 \\\\ (\\lambda +3)^{2} & =-1 \\\\ \\lambda +3 & =\\pm \\text{i} \\\\ \\lambda  & =-3\\pm \\text{i}\\end{aligned}\n$$\n\nSo, the general solution is\n\n$$\n{y}_{c}={e}^{-3t}(A\\operatorname{cos}⁡t+B\\operatorname{sin}⁡t).\n$$\n\nFrom the solution, the value of the angular frequency is $Ω=1\\,{\\text{s}}^{-1}.$\n\nThe period of the damped oscillation $T$ is related to the angular frequency as follows:\n\n$$\nT=\\frac{2\\pi }{Ω}\n$$\n\nSo the period is\n\n$$\nT=2\\pi \\,\\text{s}.\n$$"} :step/id #uuid "1a0b64b5-8ad7-595a-ad6a-e5e032ce3417"} {:db/id #edb/ref 17592186565498 :step/content {:db/id #edb/ref 17592186348240 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1cd3d61e-5e89-5ddc-bcdc-87f62383fd6a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{″}+2{y}^{′}+y=0" :db/id #edb/ref 17592186345602} {:answer/id #uuid "58cf864b-6770-5e72-b202-fd28bbbb6d99" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{″}+{y}^{′}+9y=0" :db/id #edb/ref 17592186346115} {:answer/id #uuid "79f1bef8-dbf7-5280-a2c5-34d0d0aed87a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{″}+4{y}^{′}+3y=0" :db/id #edb/ref 17592186346418} {:answer/id #uuid "9a17ce4e-69bb-5af9-83a6-038d419f7c9c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{″}+4{y}^{′}+9y=0" :db/id #edb/ref 17592186346698} {:answer/id #uuid "bca46b4e-aa82-5aed-a629-97d9de59788b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{″}+2{y}^{′}+3y=0" :db/id #edb/ref 17592186346990}] :answer-field/correct {:db/id #edb/ref 17592186346698} :answer-field/id #uuid "bcca5e50-34f9-509a-ae72-dfeccfa1ac60" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186347936}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "935f78ae-2339-577c-affb-d269b5e06297" :question/math-academy-id "q-79570" :question/problem "A particle of mass $5\\,\\text{kg}$ is attached to a massless spring. The spring constant associated with the spring is $k=45\\,{\\text{kg/s}}^{2}.$  The particle is also subject to a resistive force that's proportional to the particle's speed and has a damping coefficient $c=20\\,\\text{kg/s}.$  The position of the particle is $y(t)$ (measured in meters) and $t>0$ is the time in seconds.  If the particle moves with damped harmonic motion, what is the governing equation?" :question/worked-solution "The equation of damped harmonic motion is\n\n$$\nm{y}^{″}=-c{y}^{′}-ky.\n$$\n\nSubstituting our values for $m,$ $k$ and $c$ gives\n\n$$\n5{y}^{″}=-20{y}^{′}-45y.\n$$\n\nRearranging the above equation, we get:\n\n$$\n{y}^{″}+4{y}^{′}+9y=0\n$$"} :step/id #uuid "32206203-4ed0-5734-9397-48990a5beafb" :step/next {:db/id #edb/ref 17592186565514}} {:db/id #edb/ref 17592186565514 :step/content {:db/id #edb/ref 17592186357720 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "621d742e-f728-5f26-9472-650812b545df" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{″}+{y}^{′}+5y=0" :db/id #edb/ref 17592186355539} {:answer/id #uuid "622e3d04-ce37-5b67-948b-0d1a4383b214" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{″}-4{y}^{′}=1" :db/id #edb/ref 17592186355540} {:answer/id #uuid "63b59801-873a-5f5d-a87f-16bd7d2a9ae9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{″}+15y=\\operatorname{cos}⁡t+4\\operatorname{sin}⁡t" :db/id #edb/ref 17592186355551} {:answer/id #uuid "6d47828d-a881-5996-ae3f-c43c517328aa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{″}+{y}^{′}-5y=2{t}^{3}" :db/id #edb/ref 17592186355629} {:answer/id #uuid "81497a81-6450-5f76-b40c-c1ffd0dda77e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{″}+5{y}^{′}-25y=0" :db/id #edb/ref 17592186355799}] :answer-field/correct {:db/id #edb/ref 17592186355539} :answer-field/id #uuid "a2d61bdf-0830-5815-acac-de8fc3d86ff9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186357211}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fb97ba47-964f-5f2d-8d82-4fa760cb4511" :question/math-academy-id "q-94298" :question/problem "The function $y(t)$ gives the position of a particle at time $t.$ Which of the following equations represents a situation in which the particle is undergoing damped harmonic motion?" :question/worked-solution "The equation of damped harmonic motion is\n\n$$\n{y}^{″}+b{y}^{′}+{\\omega }^{2}y=0.\n$$\n\nComparing our equation with the above, we can see that the only equation that represents damped harmonic motion is\n\n$$\n{y}^{″}+{y}^{′}+5y=0.\n$$"} :step/id #uuid "772a7d55-73b7-505c-b338-1e17c49bf086" :step/next {:db/id #edb/ref 17592186565533}} {:db/id #edb/ref 17592186565522 :step/content {:db/id #edb/ref 17592186565427 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ed39c37-4e3c-50bf-85ad-851a0f5c1fe8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186565029} {:answer/id #uuid "5d6ab486-85e0-5bdd-a914-3a2eb53a0b0e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186565081} {:answer/id #uuid "d55e1983-523e-5bc6-a345-3a7a2d7950ba" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186565254} {:answer/id #uuid "f6590b43-8596-5be6-bc68-9a3582197ad7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186565310} {:answer/id #uuid "f7d207a9-c89e-548b-9f38-b94e8ddd223f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186565314}] :answer-field/correct {:db/id #edb/ref 17592186565310} :answer-field/id #uuid "127665a7-bfc2-524d-a3d5-c84c27346085" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186565333}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4be05fa7-5d88-5239-abf6-50f8cd96f574" :question/math-academy-id "q-79501" :question/problem "Which of the following statements are true?\n\nI. ${y}^{″}+3{y}^{′}+7y=0$ represents an oscillator undergoing light damping.\n\nII. ${y}^{″}+6{y}^{′}+3y=0$ represents an oscillator undergoing critical damping.\n\nIII. ${y}^{″}+4{y}^{′}+12y=0$ represents an oscillator undergoing heavy damping." :question/worked-solution "Remember that, given the equation of a damped harmonic oscillator, the type of damping depends on the discriminant of the characteristic equation:\n\n- $D>0$ leads to heavy damping,\n\n- $D=0$ leads to critical damping, and\n\n- $D<0$ leads to light damping.\n\nWith that in mind, let's inspect each equation.\n\n- The differential equation ${y}^{″}+3{y}^{′}+7y=0$ represents the equation of damped harmonic motion. \nThe auxiliary equation for $\\lambda $ is\n\n$$\n{\\lambda }^{2}+3\\lambda +7=0\n$$\n\nThe discriminant of this quadratic equation is:\n\n$$\n\\begin{aligned}D={3}^{2}-4(1)(7) & =-19<0\\end{aligned}\n$$\n\nThus, the given equation represents light damping, and so statement I is correct.\n\n- The differential equation ${y}^{″}+6{y}^{′}+3y=0$ represents the equation of damped harmonic motion. \nThe auxiliary equation for $\\lambda $ is:\n\n$$\n{\\lambda }^{2}+6\\lambda +3=0\n$$\n\nThe discriminant of this quadratic equation is\n\n$$\n\\begin{aligned}D={6}^{2}-4(1)(3) & =24>0\\end{aligned}\n$$\n\nThus, the given equation represents heavy damping, and so statement II is false.\n\n- The differential equation ${y}^{″}+4{y}^{′}+12y=0$ represents the equation of damped harmonic motion. \nThe auxiliary equation for $\\lambda $ is:\n\n$$\n{\\lambda }^{2}+4\\lambda +12=0.\n$$\n\nThe discriminant of this quadratic equation is\n\n$$\n\\begin{aligned}D={4}^{2}-4(1)(12) & =-32<0\\end{aligned}\n$$\n\nThus, the given equation represents light damping, and so statement III is false.\n\nIn conclusion, the correct answer is \"I only\"."} :step/id #uuid "99ee008c-724b-5795-b199-dd045f6be029" :step/next {:db/id #edb/ref 17592186565498}} {:db/id #edb/ref 17592186565533 :step/content {:db/id #edb/ref 17592186565431 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b62aaa4-07cf-5e1f-9d53-d1d21bd1d7ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{″}+{y}^{′}+\\frac{1}{2}y=0" :db/id #edb/ref 17592186565023} {:answer/id #uuid "5b2ee954-a441-5a13-b989-1132dca26282" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{″}+{y}^{′}+2y=0" :db/id #edb/ref 17592186565077} {:answer/id #uuid "6b61a7ea-dcb2-546d-9bdf-b3c1217dba3a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{″}+\\frac{1}{2}{y}^{′}+y=0" :db/id #edb/ref 17592186565102} {:answer/id #uuid "d4eec167-2a30-5587-9ff2-9ff119e2f727" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{″}+\\frac{1}{2}{y}^{′}+2y=0" :db/id #edb/ref 17592186565252} {:answer/id #uuid "d5da7789-f128-5d0d-9c57-cb303ce4e6e9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{″}+2{y}^{′}+y=0" :db/id #edb/ref 17592186565256}] :answer-field/correct {:db/id #edb/ref 17592186565102} :answer-field/id #uuid "41f2e569-8706-5300-b37e-a72c9b91421e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186565346}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "56b1314a-ceaf-5db3-a203-e533e79bae7a" :question/math-academy-id "q-94322" :question/problem "A particle of mass $4\\,\\text{kg}$ is attached to a massless spring. The spring constant associated with the spring is $k=4\\,{\\text{kg/s}}^{2}.$  The particle is also subject to a resistive force that's proportional to the particle's velocity, and has a damping coefficient $c=2\\,\\text{kg/s}.$  The position of the particle is $y(t)$ (measured in meters), and $t>0$ is the time in seconds.  If the particle moves with damped harmonic motion, what is the governing equation?" :question/worked-solution "The equation of damped harmonic motion is\n\n$$\nm{y}^{″}=-c{y}^{′}-ky.\n$$\n\nSubstituting our values for $m,$ $k$ and $c$ gives\n\n$$\n4{y}^{″}=-2{y}^{′}-4y.\n$$\n\nRearranging the above equation, we get\n\n$$\n{y}^{″}+\\frac{1}{2}{y}^{′}+y=0.\n$$"} :step/id #uuid "ce9b1e3d-07cc-56da-b3a1-2106d7f4b4f0" :step/next {:db/id #edb/ref 17592186565491}}] :activity/title "Damped Oscillators" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186564932}]}
