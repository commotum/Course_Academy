#{[{:db/id #edb/ref 17592186348240 :knowledge-point/_questions [{:db/id #edb/ref 17592186147446 :knowledge-point/id #uuid "dfa8f9b2-1628-5f9f-8f0e-0fd6c01c70d4" :knowledge-point/title "Constructing a Differential Equation Governing a Damped Harmonic Motion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1cd3d61e-5e89-5ddc-bcdc-87f62383fd6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{″}+2{y}^{′}+y=0" :db/id #edb/ref 17592186345602} {:answer/id #uuid "58cf864b-6770-5e72-b202-fd28bbbb6d99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{″}+{y}^{′}+9y=0" :db/id #edb/ref 17592186346115} {:answer/id #uuid "79f1bef8-dbf7-5280-a2c5-34d0d0aed87a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{″}+4{y}^{′}+3y=0" :db/id #edb/ref 17592186346418} {:answer/id #uuid "9a17ce4e-69bb-5af9-83a6-038d419f7c9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{″}+4{y}^{′}+9y=0" :db/id #edb/ref 17592186346698} {:answer/id #uuid "bca46b4e-aa82-5aed-a629-97d9de59788b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{″}+2{y}^{′}+3y=0" :db/id #edb/ref 17592186346990}] :answer-field/correct {:answer/id #uuid "9a17ce4e-69bb-5af9-83a6-038d419f7c9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{″}+4{y}^{′}+9y=0" :db/id #edb/ref 17592186346698} :answer-field/id #uuid "bcca5e50-34f9-509a-ae72-dfeccfa1ac60" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347936}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "935f78ae-2339-577c-affb-d269b5e06297" :question/math-academy-id "q-79570" :question/problem "A particle of mass $5\\,\\text{kg}$ is attached to a massless spring. The spring constant associated with the spring is $k=45\\,{\\text{kg/s}}^{2}.$  The particle is also subject to a resistive force that's proportional to the particle's speed and has a damping coefficient $c=20\\,\\text{kg/s}.$  The position of the particle is $y(t)$ (measured in meters) and $t>0$ is the time in seconds.  If the particle moves with damped harmonic motion, what is the governing equation?" :question/worked-solution "The equation of damped harmonic motion is\n\n$$\nm{y}^{″}=-c{y}^{′}-ky.\n$$\n\nSubstituting our values for $m,$ $k$ and $c$ gives\n\n$$\n5{y}^{″}=-20{y}^{′}-45y.\n$$\n\nRearranging the above equation, we get:\n\n$$\n{y}^{″}+4{y}^{′}+9y=0\n$$"}] [{:db/id #edb/ref 17592186357720 :knowledge-point/_questions [{:db/id #edb/ref 17592186147444 :knowledge-point/id #uuid "aad85367-37ea-500f-8405-f9464bf4f773" :knowledge-point/title "Identifying Equations that Represent Damped Harmonic Motion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "621d742e-f728-5f26-9472-650812b545df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{″}+{y}^{′}+5y=0" :db/id #edb/ref 17592186355539} {:answer/id #uuid "622e3d04-ce37-5b67-948b-0d1a4383b214" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{″}-4{y}^{′}=1" :db/id #edb/ref 17592186355540} {:answer/id #uuid "63b59801-873a-5f5d-a87f-16bd7d2a9ae9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{″}+15y=\\operatorname{cos}⁡t+4\\operatorname{sin}⁡t" :db/id #edb/ref 17592186355551} {:answer/id #uuid "6d47828d-a881-5996-ae3f-c43c517328aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{″}+{y}^{′}-5y=2{t}^{3}" :db/id #edb/ref 17592186355629} {:answer/id #uuid "81497a81-6450-5f76-b40c-c1ffd0dda77e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{″}+5{y}^{′}-25y=0" :db/id #edb/ref 17592186355799}] :answer-field/correct {:answer/id #uuid "621d742e-f728-5f26-9472-650812b545df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{″}+{y}^{′}+5y=0" :db/id #edb/ref 17592186355539} :answer-field/id #uuid "a2d61bdf-0830-5815-acac-de8fc3d86ff9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357211}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fb97ba47-964f-5f2d-8d82-4fa760cb4511" :question/math-academy-id "q-94298" :question/problem "The function $y(t)$ gives the position of a particle at time $t.$ Which of the following equations represents a situation in which the particle is undergoing damped harmonic motion?" :question/worked-solution "The equation of damped harmonic motion is\n\n$$\n{y}^{″}+b{y}^{′}+{\\omega }^{2}y=0.\n$$\n\nComparing our equation with the above, we can see that the only equation that represents damped harmonic motion is\n\n$$\n{y}^{″}+{y}^{′}+5y=0.\n$$"}] [{:db/id #edb/ref 17592186357733 :knowledge-point/_questions [{:db/id #edb/ref 17592186147447 :knowledge-point/id #uuid "48a64312-22d5-57ed-b83b-254aff2ca870" :knowledge-point/title "Calculating the Period of a Damped Oscillation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "098be5a2-3449-53d3-8787-924e2faef4a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}\\,\\text{s}" :db/id #edb/ref 17592186354753} {:answer/id #uuid "2421dbf5-639c-51c5-ac36-217830997498" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi \\,\\text{s}" :db/id #edb/ref 17592186354967} {:answer/id #uuid "6270f4fe-39cc-52dd-b48b-61d7726bfe56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi \\,\\text{s}" :db/id #edb/ref 17592186355542} {:answer/id #uuid "a7e5122d-2e0c-509c-9441-9e8006224500" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}\\,\\text{s}" :db/id #edb/ref 17592186356151} {:answer/id #uuid "bd86b034-29fe-5df6-87e7-b0ee1467bc14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}\\,\\text{s}" :db/id #edb/ref 17592186356324}] :answer-field/correct {:answer/id #uuid "6270f4fe-39cc-52dd-b48b-61d7726bfe56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi \\,\\text{s}" :db/id #edb/ref 17592186355542} :answer-field/id #uuid "e17dd377-3bf3-56a9-b857-336a7a07eb77" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357319}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2fac86fa-e6ef-53c4-af18-2a5008f32591" :question/math-academy-id "q-94359" :question/problem "The position $y(t)$ of a particle oscillating with light damped harmonic motion is governed by the equation\n\n$$\n{y}^{″}+6{y}^{′}+10y=0,\n$$\n\nwhere $t>0$ is the time, in seconds. What is the period of the damped oscillation?" :question/worked-solution "The given equation represents the equation of damped harmonic motion. We are looking for solutions of the form $y={e}^{\\lambda t}.$\n\nThe auxiliary equation for $\\lambda $ is\n\n$$\n{\\lambda }^{2}+6\\lambda +10=0.\n$$\n\nThe auxiliary equation can be solved by completing the square:\n\n$$\n\\begin{aligned}{\\lambda }^{2}+6\\lambda +10 & =0 \\\\ ({\\lambda }^{2}+6\\lambda +9)-9+10 & =0 \\\\ (\\lambda +3)^{2}+1 & =0 \\\\ (\\lambda +3)^{2} & =-1 \\\\ \\lambda +3 & =\\pm \\text{i} \\\\ \\lambda  & =-3\\pm \\text{i}\\end{aligned}\n$$\n\nSo, the general solution is\n\n$$\n{y}_{c}={e}^{-3t}(A\\operatorname{cos}⁡t+B\\operatorname{sin}⁡t).\n$$\n\nFrom the solution, the value of the angular frequency is $Ω=1\\,{\\text{s}}^{-1}.$\n\nThe period of the damped oscillation $T$ is related to the angular frequency as follows:\n\n$$\nT=\\frac{2\\pi }{Ω}\n$$\n\nSo the period is\n\n$$\nT=2\\pi \\,\\text{s}.\n$$"}]}
