#{[{:activity/course {:db/id #edb/ref 17592186046660} :activity/first-step {:db/id #edb/ref 17592186565506} :activity/id #uuid "6ab65a62-0180-5c83-b482-911736032d72" :activity/scope {:db/id #edb/ref 17592186050343 :topic/id #uuid "412fa5f9-c876-59a3-911a-6d7386c4f3f7" :topic/math-academy-id 2059} :activity/steps [{:db/id #edb/ref 17592186565495 :step/content {:db/id #edb/ref 17592186367701 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "414072e0-1148-5168-96a6-11ffceca75b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{10}" :db/id #edb/ref 17592186367703} {:answer/id #uuid "5b6a336b-706c-5271-bea3-af543482e55d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186367704} {:answer/id #uuid "e323b78c-c8f5-5407-aa4c-c6f8ca71ca46" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\pi " :db/id #edb/ref 17592186367705} {:answer/id #uuid "9e58224d-5306-5bd6-bd6f-477dd4c4803f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi " :db/id #edb/ref 17592186367706} {:answer/id #uuid "bd911543-a08f-5fe3-9053-de56b1052391" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5\\pi }{2}" :db/id #edb/ref 17592186367707}] :answer-field/correct {:db/id #edb/ref 17592186367703} :answer-field/id #uuid "698124ee-79ce-58d1-b542-2529ea23bae8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186367702}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f2e3ad27-f613-58e0-9134-a9162e7320ba" :question/math-academy-id "q-161618" :question/problem "Evaluate the triple integral \n\n$$\n{∭}_{R}{x}^{2}+{y}^{2}\\,\\text{d}V\n$$\n\nover the region $R$ enclosed inside the cylinder ${x}^{2}+{y}^{2}=1$ and between the surfaces $z=\\sqrt{{x}^{2}+{y}^{2}}$ and $z=1.$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/f4/f4c6f3acefa5d89fd5064de469952da3d68d379559bb4a6a4990a2ea24e4f861.png)\n\nThe region $R$ is a right vertical cylinder of radius $1$ whose axis passes through the point $(0,0)$ in the $xy$-plane, and is\n\n- bounded below by  $z=\\sqrt{{x}^{2}+{y}^{2}}=\\sqrt{{r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta }=r,$  and\n\n- bounded above by $z=1.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le 1,\\,0\\le \\theta <2\\pi ,\\,r\\le z\\le 1\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}{x}^{2}+{y}^{2}\\,\\text{d}V & ={∭}_{Δ}({(r\\operatorname{cos}⁡\\theta )}^{2}+{(r\\operatorname{sin}⁡\\theta )}^{2})\\,r\\,dz\\,dr\\,d\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{1}{\\int }_{r}^{1}{r}^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{1}{r}^{3}[z]_{z=r}^{z=1}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{1}{r}^{3}(1-r)\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{1}{r}^{3}-{r}^{4}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{[\\frac{1}{4}{r}^{4}-\\frac{1}{5}{r}^{5}]}_{r=0}^{r=1}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }\\frac{1}{4}-\\frac{1}{5}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }\\frac{1}{20}\\,\\text{d}\\theta  \\\\  & ={[\\frac{1}{20}\\theta ]}_{\\theta =0}^{\\theta =2\\pi } \\\\  & =\\frac{1}{20}(2\\pi -0) \\\\  & =\\frac{\\pi }{10}.\\end{aligned}\n$$"} :step/id #uuid "22b7656d-019a-56b7-926b-93a46d02e49e" :step/next {:db/id #edb/ref 17592186565500}} {:db/id #edb/ref 17592186565500 :step/content {:db/id #edb/ref 17592186565439 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "137dcd13-d6dd-5100-aa1a-4ef83376e70e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{3\\pi /2}^{2\\pi }{\\int }_{0}^{-4\\operatorname{sin}⁡\\theta }{\\int }_{0}^{r}{r}^{2}z\\operatorname{cos}⁡2\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186564970} {:answer/id #uuid "6a7ada78-9c1e-53ce-bfd6-73c9704db4ca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{3\\pi /2}^{2\\pi }{\\int }_{0}^{-4\\operatorname{sin}⁡\\theta }{\\int }_{0}^{r}{r}^{3}z\\operatorname{cos}⁡2\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186565100} {:answer/id #uuid "8156f8ac-e493-504e-aade-245eb369fa1a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{\\pi }^{2\\pi }{\\int }_{0}^{4\\operatorname{cos}⁡\\theta }{\\int }_{0}^{r}{r}^{3}z\\operatorname{cos}⁡2\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186565139} {:answer/id #uuid "9b6bc81a-88bf-5b77-b8c7-6ed75d98d631" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{3\\pi /2}^{2\\pi }{\\int }_{0}^{4\\operatorname{cos}⁡\\theta }{\\int }_{0}^{r}{r}^{2}z\\operatorname{cos}⁡2\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186565174} {:answer/id #uuid "dd82ed50-ec04-508c-a578-c8dd2bbd72c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{\\pi }^{2\\pi }{\\int }_{0}^{-4\\operatorname{sin}⁡\\theta }{\\int }_{0}^{r}{r}^{3}z\\operatorname{cos}⁡2\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186565268}] :answer-field/correct {:db/id #edb/ref 17592186565100} :answer-field/id #uuid "c3d4b2ef-ed57-5651-8502-b9160bd5e70c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186565381}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "66285a95-784c-5363-bee3-101afc12cafb" :question/math-academy-id "q-161635" :question/problem "If the solid region $R$ is given by \n\n$$\nR=\\{(x,y,z)\\,:\\,{x}^{2}+(y+2)^{2}\\le 4,\\,x\\ge 0,\\,0\\le z\\le \\sqrt{{x}^{2}+{y}^{2}}\\},\n$$\n\nthen ${∭}_{R}z({x}^{2}-{y}^{2})\\,\\text{d}V=$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/2f/2f36451290eda3db5221e1a5fdbc1647bbedafa97cd47e22d5523d457c4cb83e.png)\n\nThe region $R$ is one-half of a right vertical cylinder of radius $2$ whose axis passes through the point $(0,-2)$ in the $xy$-plane, and is\n\n- bounded below by $z=0,$ and\n\n- bounded above by $z=\\sqrt{{x}^{2}+{y}^{2}}=r.$\n\nWith that in mind, let's now write the ${x}^{2}+(y+2)^{2}=4$ in polar coordinates:\n\n$$\n\\begin{aligned}{x}^{2}+(y+2)^{2} & =4 \\\\ (r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta +2)^{2} & =4 \\\\ {r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta +4r\\operatorname{sin}⁡\\theta +4 & =4 \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )+4r\\operatorname{sin}⁡\\theta  & =0 \\\\ {r}^{2}+4r\\operatorname{sin}⁡\\theta  & =0 \\\\ r(r+4\\operatorname{sin}⁡\\theta ) & =0\\end{aligned}\n$$\n\n \n\nSince $r$ cannot be identical to zero on the entire semicircle, we must have $r=-4\\operatorname{sin}⁡\\theta .$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le -4\\operatorname{sin}⁡\\theta ,\\,\\frac{3\\pi }{2}\\le \\theta \\le 2\\pi ,\\,0\\le z\\le r\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain\n\n$$\n\\begin{aligned}{∭}_{R}z({x}^{2}-{y}^{2})\\,\\text{d}V & ={∭}_{Δ}z({(r\\operatorname{cos}⁡\\theta )}^{2}-{(r\\operatorname{sin}⁡\\theta )}^{2})\\cdot r\\,dz\\,dr\\,d\\theta  \\\\  & ={∭}_{Δ}{r}^{3}z({cos}^{2}⁡\\theta -{sin}^{2}⁡\\theta )\\,dz\\,dr\\,d\\theta  \\\\  & ={\\int }_{3\\pi /2}^{2\\pi }{\\int }_{0}^{-4\\operatorname{sin}⁡\\theta }{\\int }_{0}^{r}{r}^{3}z\\operatorname{cos}⁡2\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$"} :step/id #uuid "367406bd-b7b5-5676-8915-81cb9f329432"} {:db/id #edb/ref 17592186565506 :step/content {:db/id #edb/ref 17592186129519 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17bc181a-8974-5f88-9734-198cc3d71ac0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi /2}{\\int }_{0}^{\\operatorname{cos}⁡\\theta }{\\int }_{1}^{2}{r}^{2}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186564976} {:answer/id #uuid "26efd65d-e4b0-5765-a52f-7e5570d50b21" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi /2}{\\int }_{0}^{-2\\operatorname{sin}⁡\\theta }{\\int }_{1}^{2}{r}^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186565000} {:answer/id #uuid "3049d143-915e-5318-81f0-56825c644df0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi /2}{\\int }_{0}^{2\\operatorname{cos}⁡\\theta }{\\int }_{1}^{2}{r}^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186565010} {:answer/id #uuid "7ee7a4ae-58f1-55dc-93b1-0b065f6a2752" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi }{\\int }_{0}^{2\\operatorname{cos}⁡\\theta }{\\int }_{1}^{2}{r}^{2}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186565131} {:answer/id #uuid "b5c377e8-f5a2-5500-8cd7-722a46d1c396" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi }{\\int }_{0}^{-\\operatorname{cos}⁡\\theta }{\\int }_{1}^{2}{r}^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186565211}] :answer-field/correct {:db/id #edb/ref 17592186565010} :answer-field/id #uuid "5de2e9ed-6a8e-5e65-b0f4-c004ab1d9bd0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186126614}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "cc7985de-f7b8-5b62-b788-d731ea9f3ce6" :question/math-academy-id "q-161523" :question/problem "If the solid region $R$ is given by \n\n$$\nR=\\{(x,y,z)\\,:\\,(x-1)^{2}+{y}^{2}\\le 1,\\,y\\ge 0,\\,1\\le z\\le 2\\},\n$$\n\nthen ${∭}_{R}{x}^{2}+{y}^{2}\\,\\text{d}V=$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/60/603dc3142d8329fd9ff9fe8d09b131fe09497405f761918d59261fde314772c6.png)\n\nThe region $R$ is one-half of a right vertical cylinder of radius $1$ whose axis passes through the point $(1,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=1,$ and\n\n- bounded above by $z=2.$\n\nWith that in mind, let's now write the $(x-1)^{2}+{y}^{2}=1$ in polar coordinates:\n\n$$\n\\begin{aligned}(x-1)^{2}+{y}^{2} & =1 \\\\ (r\\operatorname{cos}⁡\\theta -1)^{2}+(r\\operatorname{sin}⁡\\theta )^{2} & =1 \\\\ {r}^{2}{cos}^{2}⁡\\theta -2r\\operatorname{cos}⁡\\theta +1+{r}^{2}{sin}^{2}⁡\\theta  & =1 \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )-2r\\operatorname{cos}⁡\\theta  & =0 \\\\ {r}^{2}-2r\\operatorname{cos}⁡\\theta  & =0 \\\\ r(r-2\\operatorname{cos}⁡\\theta ) & =0\\end{aligned}\n$$\n\n \n\nSince $r$ cannot be identical to zero on the entire semicircle, we must have $r=2\\operatorname{cos}⁡\\theta .$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le 2\\operatorname{cos}⁡\\theta ,\\,0\\le \\theta \\le \\frac{\\pi }{2},\\,1\\le z\\le 2\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}{x}^{2}+{y}^{2}\\,\\text{d}V & ={∭}_{Δ}((r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2})\\,r\\,dz\\,dr\\,d\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{2\\operatorname{cos}⁡\\theta }{\\int }_{1}^{2}{r}^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$"} :step/id #uuid "5648bad5-7e32-562e-bd70-bbba5c57e146" :step/next {:db/id #edb/ref 17592186565536}} {:db/id #edb/ref 17592186565528 :step/content {:db/id #edb/ref 17592186565440 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1210b916-b4ea-5cba-9d0b-88ffd8db5b52" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{\\pi }^{2\\pi }{\\int }_{0}^{2}{\\int }_{0}^{{r}^{2}+9}\\frac{r}{\\sqrt{{r}^{2}+1}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186564968} {:answer/id #uuid "609ff4b7-e3e7-59dc-bd1a-628643aa1eef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{3\\pi /2}^{2\\pi }{\\int }_{0}^{2}{\\int }_{0}^{r+9}\\frac{1}{\\sqrt{{r}^{2}+1}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186565086} {:answer/id #uuid "8405bbf3-f8ff-5256-911f-3b037174a5a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{\\pi }^{2\\pi }{\\int }_{0}^{2}{\\int }_{0}^{r+9}\\frac{r}{\\sqrt{{r}^{2}+1}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186565143} {:answer/id #uuid "b198dc59-a572-58ee-95d9-e619f5217eeb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{3\\pi /2}^{2\\pi }{\\int }_{0}^{2}{\\int }_{0}^{{r}^{2}+9}\\frac{r}{\\sqrt{{r}^{2}+1}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186565202} {:answer/id #uuid "b3bf8739-96ec-51ef-aae4-6adf4a13a184" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{\\pi }^{2\\pi }{\\int }_{0}^{2}{\\int }_{0}^{{r}^{2}+9}\\frac{1}{\\sqrt{{r}^{2}+1}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186565207}] :answer-field/correct {:db/id #edb/ref 17592186564968} :answer-field/id #uuid "b54ca112-ae75-5f34-8db6-6d52d5ea414f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186565376}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6699d568-4112-5bd7-abf4-a27c0cbde6ce" :question/math-academy-id "q-161614" :question/problem "The region $R$ is enclosed inside the cylinder ${x}^{2}+{y}^{2}=4$ for $y\\le 0,$ between the surfaces $z=0$ and $z={x}^{2}+{y}^{2}+9.$ Express the following triple integral in cylindrical polar coordinates. \n\n$$\n{∭}_{R}\\frac{1}{\\sqrt{{x}^{2}+{y}^{2}+1}}\\,\\text{d}V\n$$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/35/350b2dc98a09957c17f1ab629e21021c30fcccd9443068c722fe7565f04dcbfe.png)\n\nThe region $R$ is one-half of a right vertical cylinder of radius $2$ whose axis passes through the point $(0,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=0,$ and\n\n- bounded above by $z={x}^{2}+{y}^{2}+9={r}^{2}+9.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le 2,\\,\\pi \\le \\theta \\le 2\\pi ,\\,0\\le z\\le {r}^{2}+9\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}\\frac{1}{\\sqrt{{x}^{2}+{y}^{2}+1}}\\,\\text{d}V & ={∭}_{Δ}\\frac{1}{\\sqrt{(r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2}+1}}\\cdot r\\,dz\\,dr\\,d\\theta  \\\\  & ={∭}_{Δ}\\frac{r}{\\sqrt{{r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta +1}}\\,dz\\,dr\\,d\\theta  \\\\  & ={∭}_{Δ}\\frac{r}{\\sqrt{{r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )+1}}\\,dz\\,dr\\,d\\theta  \\\\  & ={\\int }_{\\pi }^{2\\pi }{\\int }_{0}^{2}{\\int }_{0}^{{r}^{2}+9}\\frac{r}{\\sqrt{{r}^{2}+1}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$"} :step/id #uuid "be70a3f8-c406-5a9b-891c-02059ad17049" :step/next {:db/id #edb/ref 17592186565495}} {:db/id #edb/ref 17592186565536 :step/content {:db/id #edb/ref 17592186411857 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "012fa540-5e42-507c-b4d7-4be584a8a37c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "20" :db/id #edb/ref 17592186411681} {:answer/id #uuid "6ca03990-4e3c-545a-89cf-a853738bd60a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8\\pi " :db/id #edb/ref 17592186411736} {:answer/id #uuid "74f3c49e-b5f3-5c5e-b0db-c523644cd561" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "40" :db/id #edb/ref 17592186411740} {:answer/id #uuid "d2fa903f-cfe5-50db-9712-2e6a3f05be62" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "32" :db/id #edb/ref 17592186411796} {:answer/id #uuid "de2d26a9-566a-53ef-8878-c12a27c0ec9d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "26\\pi " :db/id #edb/ref 17592186411802}] :answer-field/correct {:db/id #edb/ref 17592186411740} :answer-field/id #uuid "f69e9c6d-9eea-5554-8872-d044f41b5762" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186411849}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "47812564-3d50-5e9e-a030-d910fa667ee9" :question/math-academy-id "q-161606" :question/problem "Evaluate the triple integral \n\n$$\n{∭}_{R}4x\\,\\text{d}V\n$$\n\nover the region $R$ enclosed inside the cylinder ${x}^{2}+{y}^{2}=4$ for $x\\ge 0,$ $y\\ge 0$ and between the surfaces $z=0$ and $z=y+3.$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/02/021047e8d472a91eeeb7b45d239a1577cb7b03c873e0cb7f20ddd5ca0b69b1a3.png)\n\nThe region $R$ is a right vertical cylinder of radius $2$ whose axis passes through the point $(0,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=0,$ and\n\n- bounded above by $z=y+3=r\\operatorname{sin}⁡\\theta +3.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le 2,\\,0\\le \\theta <\\frac{\\pi }{2},\\,0\\le z\\le r\\operatorname{sin}⁡\\theta +3\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}4x\\,\\text{d}V & ={∭}_{Δ}4r\\operatorname{cos}⁡\\theta \\cdot r\\,dz\\,dr\\,d\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{2}{\\int }_{0}^{r\\operatorname{sin}⁡\\theta +3}4{r}^{2}\\operatorname{cos}⁡\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{2}4{r}^{2}\\operatorname{cos}⁡\\theta [z]_{z=0}^{z=r\\operatorname{sin}⁡\\theta +3}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{2}4{r}^{2}\\operatorname{cos}⁡\\theta (r\\operatorname{sin}⁡\\theta +3)\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{2}4{r}^{3}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta +12{r}^{2}\\operatorname{cos}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{2}2{r}^{3}\\operatorname{sin}⁡2\\theta +12{r}^{2}\\operatorname{cos}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}{[\\frac{1}{2}{r}^{4}\\operatorname{sin}⁡2\\theta +4{r}^{3}\\operatorname{cos}⁡\\theta ]}_{r=0}^{r=2}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\frac{1}{2}(2)^{4}\\operatorname{sin}⁡2\\theta +4(2)^{3}\\operatorname{cos}⁡\\theta \\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}8\\operatorname{sin}⁡2\\theta +32\\operatorname{cos}⁡\\theta \\,\\text{d}\\theta  \\\\  & =[-4\\operatorname{cos}⁡2\\theta +32\\operatorname{sin}⁡\\theta ]_{\\theta =0}^{\\theta =\\pi /2} \\\\  & =-4(-1-1)+32(1-0)) \\\\  & =40.\\end{aligned}\n$$"} :step/id #uuid "d7e28ed7-cdc1-5df8-ab7d-eefe1d5ae7d4" :step/next {:db/id #edb/ref 17592186565528}}] :activity/title "Triple Integrals in Cylindrical Polar Coordinates" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186564929}]}
