#{[{:db/id #edb/ref 17592186281473 :knowledge-point/_questions [{:db/id #edb/ref 17592186119761 :knowledge-point/id #uuid "36986a18-172c-5983-8f6f-3211b6e8f89d" :knowledge-point/title "Finding the Radius of Curvature of a Plane Curve Given in Parametric Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41d1b705-7f9e-5fc0-b8a3-f2ec630dec22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186279177} {:answer/id #uuid "62dc1fd8-4359-5dfe-8e43-f5d26808e6c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186279489} {:answer/id #uuid "b079896f-a2ab-52d8-960e-3fcea974815a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186280156} {:answer/id #uuid "b772997e-b578-5476-85da-375092d1f621" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{2}" :db/id #edb/ref 17592186280203} {:answer/id #uuid "e2cd2225-4e85-578e-9f9b-33c02aa80b66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{8}" :db/id #edb/ref 17592186280595}] :answer-field/correct {:answer/id #uuid "b772997e-b578-5476-85da-375092d1f621" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{2}" :db/id #edb/ref 17592186280203} :answer-field/id #uuid "d136c6b3-3d9c-5690-a6fb-a9cb6fc2517a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281203}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c9434c2d-4cb6-586b-bed8-8562887abbb6" :question/math-academy-id "q-162424" :question/problem "Find the radius of curvature for the curve $r(t)=2{e}^{t}\\,i+{e}^{2t}\\,j$ at $t=0.$" :question/worked-solution "The curvature $κ(t)$ of a plane curve $r(t)=x(t)\\,i+y(t)\\,j$ is given by\n\n$$\nκ(t)=\\frac{|{x}^{′}(t){y}^{″}(t)-{y}^{′}(t){x}^{″}(t)|}{([{x}^{′}(t)]^{2}+[{y}^{′}(t)]^{2})^{3/2}}.\n$$\n\nThe radius of curvature $R$ is defined as\n$R(t)=\\frac{1}{κ(t)}.$\n\nAlong our curve, we have\n\n$$\nx(t)=2{e}^{t},\\,y(t)={e}^{2t}.\n$$\n\nFirst, we calculate the derivatives of the components:\n\n$$\n\\begin{aligned}{x}^{′}(t) & =2{e}^{t},\\, & {y}^{′}(t) & =2{e}^{2t} \\\\ {x}^{″}(t) & =2{e}^{t},\\, & {y}^{″}(t) & =4{e}^{2t}\\end{aligned}\n$$\n\nSubstituting these into the formula for the curvature, we get the following:\n\n$$\n\\begin{aligned}κ(t) & =\\frac{|2{e}^{t}\\cdot 4{e}^{2t}-2{e}^{2t}\\cdot 2{e}^{t}|}{{((2{e}^{t})^{2}+(2{e}^{2t})^{2})}^{3/2}} \\\\  & =\\frac{4{e}^{3t}}{{(4{e}^{2t}+4{e}^{4t})}^{3/2}} \\\\  & =\\frac{1}{2{(1+{e}^{2t})}^{3/2}}\\end{aligned}\n$$\n\nTherefore, the curvature at $t=0$ is\n\n$$\n\\begin{aligned}κ(0) & =\\frac{1}{2{(1+{e}^{2(0)})}^{3/2}} \\\\  & =\\frac{1}{2{(1+1)}^{3/2}} \\\\  & =\\frac{1}{4\\sqrt{2}}.\\end{aligned}\n$$\n\nFinally, the radius of curvature at $t=0$ is\n\n$$\n\\begin{aligned}R(0) & =\\frac{1}{κ(0)}=4\\sqrt{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186281490 :knowledge-point/_questions [{:db/id #edb/ref 17592186119762 :knowledge-point/id #uuid "384072a8-f008-5279-bb58-8086eb42b710" :knowledge-point/title "Finding the Curvature of a Plane Curve Given in Cartesian Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0990170c-4d1e-50a2-98e8-151e0ba11892" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{e}{({e}^{2}-e+2)^{3/2}}" :db/id #edb/ref 17592186278684} {:answer/id #uuid "4d60cb8a-dc24-56ef-af99-b175cf20b062" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{e}{({e}^{2}-2e+2)^{3/2}}" :db/id #edb/ref 17592186279289} {:answer/id #uuid "d83ba20e-641d-5922-b928-055d7e54093d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{e}{({e}^{2}-e+2)^{3/2}}" :db/id #edb/ref 17592186280502} {:answer/id #uuid "e3b8ebcb-d501-5c6a-8146-bd7048b4d0df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{e}{({e}^{2}-2e+2)^{3/2}}" :db/id #edb/ref 17592186280602} {:answer/id #uuid "e74cacf6-957c-5ea2-816a-02197cc75801" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{e}{({e}^{2}-e+1)^{3/2}}" :db/id #edb/ref 17592186280630}] :answer-field/correct {:answer/id #uuid "4d60cb8a-dc24-56ef-af99-b175cf20b062" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{e}{({e}^{2}-2e+2)^{3/2}}" :db/id #edb/ref 17592186279289} :answer-field/id #uuid "b0741ee1-638a-5f79-a6d9-00b3eb6de84c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281143}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7fbc67aa-6887-5c1b-ba6e-44712c2e9cc1" :question/math-academy-id "q-162535" :question/problem "Find the signed curvature of the curve $y=x-{e}^{x}$ at $x=1.$" :question/worked-solution "The signed curvature $k(x)$ of a plane curve $y=y(x)$ is given by\n\n$$\nk(x)=\\frac{{y}^{″}(x)}{(1+[{y}^{′}(x)]^{2})^{3/2}}.\n$$\n\nFirst, we calculate ${y}^{′}(x)$ and ${y}^{″}(x):$\n\n$$\n{y}^{′}(x)=1-{e}^{x},\\,{y}^{″}(x)=-{e}^{x}\n$$\n\nSubstituting these into the formula for the signed curvature, we get the following:\n\n$$\n\\begin{aligned}k(x) & =\\frac{-{e}^{x}}{{[1+{(1-{e}^{x})}^{2}]}^{3/2}} \\\\  & =-\\frac{{e}^{x}}{{(1+1+{e}^{2x}-2{e}^{x})}^{3/2}} \\\\  & =-\\frac{{e}^{x}}{{(2+{e}^{2x}-2{e}^{x})}^{3/2}}\\end{aligned}\n$$\n\nTherefore, the curvature at $x=1$ is\n\n$$\n\\begin{aligned}k(1) & =-\\frac{{e}^{(1)}}{{(2+{e}^{2(1)}-2{e}^{(1)})}^{3/2}} \\\\  & =-\\frac{e}{({e}^{2}-2e+2)^{3/2}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186120377 :knowledge-point/_questions [{:db/id #edb/ref 17592186119762 :knowledge-point/id #uuid "384072a8-f008-5279-bb58-8086eb42b710" :knowledge-point/title "Finding the Curvature of a Plane Curve Given in Cartesian Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "67eae735-49cf-5cfd-885a-9dcf6358fe9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186319710} {:answer/id #uuid "7ed4b8f4-ef8b-53cb-b447-80eb51ba9fa8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186319772} {:answer/id #uuid "898f8cb2-0234-5a1e-b3da-6232517cf135" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186319801} {:answer/id #uuid "af23b294-572a-5369-b57c-4a4d14558963" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186319924} {:answer/id #uuid "bd4e6d3d-d544-5c9e-bc7e-3b613641fec3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{3}}{5}" :db/id #edb/ref 17592186319968}] :answer-field/correct {:answer/id #uuid "7ed4b8f4-ef8b-53cb-b447-80eb51ba9fa8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186319772} :answer-field/id #uuid "b1eba548-5a1d-560c-8002-dd475d44f6ab" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186320520}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5c3279eb-5aad-5467-9349-e9a454f6c445" :question/math-academy-id "q-35190" :question/problem "Find the signed curvature of the curve $y=2{x}^{3}-{x}^{2}+1$ at $x=0.$" :question/worked-solution "The signed curvature $k(x)$ of a plane curve $y=y(x)$ is given by\n\n$$\nk(x)=\\frac{{y}^{″}(x)}{(1+[{y}^{′}(x)]^{2})^{3/2}}.\n$$\n\nFirst, we calculate ${y}^{′}(x)$ and ${y}^{″}(x):$\n\n$$\n{y}^{′}(x)=6{x}^{2}-2x,\\,{y}^{″}(x)=12x-2\n$$\n\nSubstituting these into the formula for the signed curvature, we get the following:\n\n$$\n\\begin{aligned}k(x) & =\\frac{12x-2}{{[1+{(6{x}^{2}-2x)}^{2}]}^{3/2}}\\end{aligned}\n$$\n\nTherefore, the curvature at $x=0$ is\n\n$$\n\\begin{aligned}k(0) & =\\frac{12(0)-2}{{[1+{(6\\cdot {0}^{2}-2\\cdot 0)}^{2}]}^{3/2}} \\\\  & =\\frac{-2}{{1}^{3/2}} \\\\  & =-2.\\end{aligned}\n$$"}]}
