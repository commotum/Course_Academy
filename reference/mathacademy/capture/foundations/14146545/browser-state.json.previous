      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14146545/observations/step-q336817-41699e9124a831e68c95.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14146545/observations/step-q336817-41699e9124a831e68c95.png",
      "source_url": "https://mathacademy.com/tasks/14146545/topics/1788/lesson",
      "captured_at": 1791830267.351487,
      "math_academy_id": "q-336817",
      "topic_id": "1788",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q336817",
        "placement_id": null,
        "content_id": null,
        "type": null
