          "input_html": "<div id=\"freeResponseTextbox-1\" class=\"matheditor-wrapper-answer\" ;=\"\" style=\"min-width:40px;\n                                        margin-left:2px;\n                                        margin-right:2px;\n                                        background:;\"><div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"41\"><span mathquill-command-id=\"43\">3</span><span mathquill-command-id=\"45\">.</span><span mathquill-command-id=\"47\">0</span><span mathquill-command-id=\"49\">0</span></span></div></div>",
