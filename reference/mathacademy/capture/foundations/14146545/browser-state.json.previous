          "input_html": "<div id=\"freeResponseTextbox-1\" class=\"matheditor-wrapper-answer\" ;=\"\" style=\"min-width:40px;\n                                        margin-left:4px;\n                                        margin-right:4px;\n                                        background:;\"><div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"61\"><span mathquill-command-id=\"63\">1</span><span mathquill-command-id=\"65\">.</span><span mathquill-command-id=\"67\">4</span><span mathquill-command-id=\"69\">9</span></span></div></div>",
