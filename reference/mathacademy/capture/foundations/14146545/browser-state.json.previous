      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14146545/observations/step-q336815-e044abeda53bd1f47029.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14146545/observations/step-q336815-e044abeda53bd1f47029.png",
      "source_url": "https://mathacademy.com/tasks/14146545/topics/1788/lesson",
      "captured_at": 1791830221.4255793,
