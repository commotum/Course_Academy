      "assets": [],
      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14146545/observations/step-q336642-13e139abebae66af2e15.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14146545/observations/step-q336642-13e139abebae66af2e15.png",
      "source_url": "https://mathacademy.com/tasks/14146545/topics/1788/lesson",
      "captured_at": 1791830124.2641785,
      "math_academy_id": "q-336642",
      "topic_id": "1788",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q336642",
        "placement_id": null,
        "content_id": null,
