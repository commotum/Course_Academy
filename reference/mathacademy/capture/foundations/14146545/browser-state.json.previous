      "assets": [],
      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14146545/observations/step-q336215-f0a8bac2a455b133eeed.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14146545/observations/step-q336215-f0a8bac2a455b133eeed.png",
      "source_url": "https://mathacademy.com/tasks/14146545/topics/1788/lesson",
      "captured_at": 1791830187.6130261,
      "math_academy_id": "q-336215",
      "topic_id": "1788",
      "sequence_position": null,
      "source_step": {
