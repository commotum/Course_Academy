      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14146545/observations/step-q336658-fa513dd4da3d8bd67b08.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14146545/observations/step-q336658-fa513dd4da3d8bd67b08.png",
      "source_url": "https://mathacademy.com/tasks/14146545/topics/1788/lesson",
      "captured_at": 1791830292.339413,
      "math_academy_id": "q-336658",
