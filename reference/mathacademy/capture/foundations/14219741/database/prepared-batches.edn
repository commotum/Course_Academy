76f1-5a1a-81ae-abc4bc467c3f" :question/id #uuid "56f780de-76f1-5a1a-81ae-abc4bc467c3f"] ["question-56f780de-76f1-5a1a-81ae-abc4bc467c3f" :question/math-academy-id "q-332576"] ["question-56f780de-76f1-5a1a-81ae-abc4bc467c3f" :question/problem "$$\n\\{\\begin{aligned}{x}_{1}^{′}(t)=-2{x}_{1}(t)+3{x}_{2}(t)+5{e}^{4t} \\\\ {x}_{2}^{′}(t)=7{x}_{1}(t)+{x}_{2}(t)+6{e}^{5t}\\end{aligned}\n$$\n\nThe system of linear ODEs above can be written in matrix form as follows:\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">${x}^{′}(t)=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"40px\">{{field-1}}</td>\n<td align=\"center\" width=\"40px\">{{field-2}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">$\\,\\,x(t)+{e}^{4t}\\,\\,$</td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">$\\,\\,+\\,{e}^{5t}\\,\\,$</td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-4}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-5}}</td>\n<td align=\"center\" width=\"30px\">{{field-6}}</td>\n<td align=\"center\"></td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-7}}</td>\n<td align=\"center\"></td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-8}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>"] ["question-56f780de-76f1-5a1a-81ae-abc4bc467c3f" :question/worked-solution "First, let's rewrite our system, highlighting the coefficients:\n\n$$\n\\{\\begin{aligned}{x}_{1}^{′}(t)=(-2)\\cdot {x}_{1}(t)+3\\cdot {x}_{2}(t)+{e}^{4t}\\cdot 5+{e}^{5t}\\cdot 0 \\\\ {x}_{2}^{′}(t)=7\\cdot {x}_{1}(t)+1\\cdot {x}_{2}(t)+{e}^{4t}\\cdot 0+{e}^{5t}\\cdot 6\\end{aligned}\n$$\n\nNow, we can write the system in matrix form:\n\n$$\n{x}^{′}(t)=[\\begin{aligned}-2 & 3 \\\\ 7 & 1\\end{aligned}]x(t)+{e}^{4t}[\\begin{aligned}5 \\\\ 0\\end{aligned}]+{e}^{5t}[\\begin{aligned}0 \\\\ 6\\end{aligned}]\n$$\n\nwhere $x(t)=[\\begin{aligned}{x}_{1}(t) \\\\ {x}_{2}(t)\\end{aligned}].$"] ["question-56f780de-76f1-5a1a-81ae-abc4bc467c3f" :question/difficulty :question.difficulty/easy] ["answer-field-1cadcc96-5961-586a-8a05-aa4c6a2de9f4" :answer-field/id #uuid "1cadcc96-5961-586a-8a05-aa4c6a2de9f4"] ["answer-92982e2f-61eb-50b9-809b-23ee5a048d58" :answer/id #uuid "92982e2f-61eb-50b9-809b-23ee5a048d58"] ["answer-92982e2f-61eb-50b9-809b-23ee5a048d58" :answer/type :answer.type/math] ["answer-92982e2f-61eb-50b9-809b-23ee5a048d58" :answer/value "-2"] ["answer-field-1cadcc96-5961-586a-8a05-aa4c6a2de9f4" :answer-field/key "field-1"] ["answer-field-1cadcc96-5961-586a-8a05-aa4c6a2de9f4" :answer-field/type :answer-field.type/blank] ["answer-field-1cadcc96-5961-586a-8a05-aa4c6a2de9f4" :answer-field/correct "answer-92982e2f-61eb-50b9-809b-23ee5a048d58"] ["answer-field-1cadcc96-5961-586a-8a05-aa4c6a2de9f4" :answer-field/choices "answer-92982e2f-61eb-50b9-809b-23ee5a048d58"] ["answer-field-0cbb24e4-e2ab-54ec-bf66-effde280b307" :answer-field/id #uuid "0cbb24e4-e2ab-54ec-bf66-effde280b307"] ["answer-ae3f5928-02ba-596c-85cb-7d15890d6276" :answer/id #uuid "ae3f5928-02ba-596c-85cb-7d15890d6276"] ["answer-ae3f5928-02ba-596c-85cb-7d15890d6276" :answer/type :answer.type/math] ["answer-ae3f5928-02ba-596c-85cb-7d15890d6276" :answer/value "3"] ["answer-field-0cbb24e4-e2ab-54ec-bf66-effde280b307" :answer-field/key "field-2"] ["answer-field-0cbb24e4-e2ab-54ec-bf66-effde280b307" :answer-field/type :answer-field.type/blank] ["answer-field-0cbb24e4-e2ab-54ec-bf66-effde280b307" :answer-field/correct "answer-ae3f5928-02ba-596c-85cb-7d15890d6276"] ["answer-field-0cbb24e4-e2ab-