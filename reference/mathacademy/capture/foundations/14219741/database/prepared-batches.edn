2b8cc0988ab" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "question-48e63c6e-e110-5f2f-9c73-cb4374b7c6c6" :question/id #uuid "48e63c6e-e110-5f2f-9c73-cb4374b7c6c6" :question/math-academy-id "q-332587" :question/problem "$$\n\\{\\begin{aligned}{x}_{1}^{′}(t)={x}_{1}(t)-4{x}_{2}(t)+2\\operatorname{sin}⁡(2t)+\\operatorname{cos}⁡(5t) \\\\ {x}_{2}^{′}(t)=3{x}_{1}(t)+2{x}_{2}(t)+4\\operatorname{cos}⁡(5t)\\end{aligned}\n$$\n\nThe systems of linear ODEs above can be written in matrix form as follows:\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">${x}^{′}(t)=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"40px\">{{field-1}}</td>\n<td align=\"center\" width=\"40px\">{{field-2}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">$\\,\\,x(t)+\\,\\,$</td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">$\\,\\,\\operatorname{sin}⁡(2t)+\\,\\,$</td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-4}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">$\\,\\,\\operatorname{cos}⁡(5t)$</td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-5}}</td>\n<td align=\"center\" width=\"30px\">{{field-6}}</td>\n<td align=\"center\"></td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-7}}</td>\n<td align=\"center\"></td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-8}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "First, let's rewrite our system, highlighting the coefficients:\n\n$$\n\\{\\begin{aligned}{x}_{1}^{′}(t)=1\\cdot {x}_{1}(t)+(-4)\\cdot {x}_{2}(t)+2\\cdot \\operatorname{sin}⁡(2t)+1\\cdot \\operatorname{cos}⁡(5t) \\\\ {x}_{2}^{′}(t)=3\\cdot {x}_{1}(t)+2\\cdot {x}_{2}(t)+0\\cdot \\operatorname{sin}⁡(2t)+4\\cdot \\operatorname{cos}⁡(5t)\\end{aligned}\n$$\n\nNow, we can write the system in matrix form:\n\n$$\n{x}^{′}(t)=[\\begin{aligned}1 & -4 \\\\ 3 & 2\\end{aligned}]x(t)+[\\begin{aligned}2 \\\\ 0\\end{aligned}]\\operatorname{sin}⁡(2t)+[\\begin{aligned}1 \\\\ 4\\end{aligned}]\\operatorname{cos}⁡(5t)\n$$\n\nwhere $x(t)=[\\begin{aligned}{x}_{1}(t) \\\\ {x}_{2}(t)\\end{aligned}].$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-be99c1cf-9606-5cac-85ca-8bcf7bfdd5d0" "answer-field-6ad21e9c-b394-53e0-abac-39126c2eaed6" "answer-field-0975e181-89ef-5188-9ed5-faa802b35aa0" "answer-field-ed1cb951-e683-519c-9741-c07df8a9e235" "answer-field-38b786bc-2f8e-50dc-9e4a-f05c7bbe489c" "answer-field-eedf4d51-ddf3-5e05-8956-364b54b00bc4" "answer-field-bf969b04-1973-578a-b415-7226b4cb20bd" "answer-field-304765d0-077d-5553-8e0b-02a9e5acf013"] :db/ensure [:question/validate]} {:db/id "answer-field-be99c1cf-9606-5cac-85ca-8bcf7bfdd5d0" :answer-field/id #uuid "be99c1cf-9606-5cac-85ca-8bcf7bfdd5d0" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-858cb189-c87b-5c12-8cae-08db96e24407" :answer-field/choices ["answer-858cb189-c87b-5c12-8cae-08db96e24407"] :db/ensure [:answer-field/validate]} {:db/id "answer-858cb189-c87b-5c12-8cae-08db96e24407" :answer/id #uuid "858cb189-c87b-5c12-8cae-08db96e24407" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-field-6ad21e9c-b394-53e0-abac-39126c2eaed6" :answer-field/id #uuid "6ad21e9c-b394-53e0-abac-39126c2eaed6" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-f2b5958f-36f6-5197-b67d-199edfefbc79" :answer-field/choices ["answer-f2b5958f-36f6-5197-b67d-199edfefbc79"] :db/en