6c7eee" :answer-field/choices ["answer-d3086aa8-bdb0-5979-96ad-3d44946c7eee"] :db/ensure [:answer-field/validate]} {:db/id "answer-d3086aa8-bdb0-5979-96ad-3d44946c7eee" :answer/id #uuid "d3086aa8-bdb0-5979-96ad-3d44946c7eee" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-field-d86cd08e-2e74-5dfa-8aed-573414a8abcf" :answer-field/id #uuid "d86cd08e-2e74-5dfa-8aed-573414a8abcf" :answer-field/key "field-8" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-4c0fe51c-df57-5055-a519-b8b8b55b9733" :answer-field/choices ["answer-4c0fe51c-df57-5055-a519-b8b8b55b9733"] :db/ensure [:answer-field/validate]} {:db/id "answer-4c0fe51c-df57-5055-a519-b8b8b55b9733" :answer/id #uuid "4c0fe51c-df57-5055-a519-b8b8b55b9733" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "question-86e2d08a-1bef-5ead-ab02-f3370f825b7b" :question/id #uuid "86e2d08a-1bef-5ead-ab02-f3370f825b7b" :question/math-academy-id "q-332746" :question/problem "Consider the following inhomogeneous system of linear differential equations:\n\n$$\n{x}^{′}(t)=[\\begin{aligned}\\frac{5}{2} & -\\frac{1}{2} \\\\ \\frac{1}{2} & \\frac{3}{2}\\end{aligned}]x(t)+[\\begin{aligned}3 \\\\ 1\\end{aligned}]\n$$\n\nA complementary solution to this system is given by\n\n$$\n{x}_{c}(t)={c}_{1}[\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{2t}+{c}_{2}(t[\\begin{aligned}1 \\\\ 1\\end{aligned}]+[\\begin{aligned}1 \\\\ -1\\end{aligned}]){e}^{2t},\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nThen, the general solution of the system can be written as \n$x(t)={x}_{c}(t)+{x}_{p}(t),$\nwhere ${x}_{p}(t)$ is a particular solution. Determine the form of the particular solution ${x}_{p}(t).$" :question/worked-solution "Recall that the general solution of an inhomogeneous system can be written as \n\n$$\nx(t)={x}_{c}(t)+{x}_{p}(t)\n$$\n\nwhere ${x}_{c}(t)$ is the complementary solution (solution of the corresponding homogeneous system) and ${x}_{p}(t)$ is a particular solution.\n\nThe forcing term\n\n$$\n[\\begin{aligned}3 \\\\ 1\\end{aligned}]\n$$\n\nof the inhomogeneous system of ODEs is constant. Therefore, we assume that the particular solution is also constant, i.e.\n\n$$\n{x}_{p}(t)=[\\begin{aligned}{a}_{1} \\\\ {a}_{2}\\end{aligned}],\n$$\n\nwhere ${a}_{1},{a}_{2}$ are constants that are to be determined." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-9383c075-7b49-5325-9b5c-cd8dcad979f2"] :db/ensure [:question/validate]} {:db/id "answer-field-9383c075-7b49-5325-9b5c-cd8dcad979f2" :answer-field/id #uuid "9383c075-7b49-5325-9b5c-cd8dcad979f2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d84b77cd-445d-5e7b-9943-f6360adafe74" :answer-field/choices ["answer-d84b77cd-445d-5e7b-9943-f6360adafe74" "answer-30691a01-55c3-533b-a424-d0de797b3387" "answer-ed85ca35-f4b8-573e-9682-f6097ad63ec4" "answer-ad567f45-3261-519b-a4aa-9cc323a653cf" "answer-c3ea5e39-e5d4-50ce-9738-582058e97aaa"] :db/ensure [:answer-field/validate]} {:db/id "answer-d84b77cd-445d-5e7b-9943-f6360adafe74" :answer/id #uuid "d84b77cd-445d-5e7b-9943-f6360adafe74" :answer/type :answer.type/math :answer/value "[\\begin{aligned}{a}_{1} \\\\ {a}_{2}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-30691a01-55c3-533b-a424-d0de797b3387" :answer/id #uuid "30691a01-55c3-533b-a424-d0de797b3387" :answer/type :answer.type/math :answer/value "t[\\begin{aligned}{a}_{1} \\\\ {a}_{2}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-ed85ca35-f4b8-573e-9682-f6097ad63ec4" :answer/id #uuid "ed85ca35-f4b8-573e-9682-f6097ad63ec4" :answer/type :answer.type/math :answer/value "{e}^{-2t}[\\begin{aligned}{a}_{1} \\\\ {a}_{2}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-ad567f45-3261-519b-a4aa-9cc323a653cf" :answer/id #uuid "ad567f45-3261-519b-a4aa-9cc323a653cf" :answer/type :answer.type/math :answer/value "{e}^{2t}(t[\\begin{aligned}{a}_{1} \\\\ {a}_{2}\\end{aligned}])" :db/ensure [:answer/validate]} {:db/id "answer-c3ea5e39-e5d4-50ce-9738-582058e97aaa" :answer/id #uuid "c3ea5e39-e5d4-50ce-9738-582058e97aaa" :answer/type :answer.type/math :answer/value "{e}^{2t}[\\begin{aligned}{a}_{1} \\\\ {a}_{2}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-38450a0f-4d09-5bde-a910-db2e5f9dab01" :question/id #uuid "38450a0f-4d09-5bde-a910-db2e5f9dab01" :question/math-academy-id "q-332750" :question/problem "Consider the following inhomogeneous system of linear differential equations:\n\n$$\n{x}^{′}(t)=[\\begin{aligned}2/5 & -6/5 \\\\ -6/5 & -7/5\\end{aligned}]x(t)+[\\begin{aligned}1 \\\\ 4\\end{aligned}]\n$$\n\nThe complementary solution to this system is given by\n\n$$\n{x}_{c}(t)={c}_{1}[\\begin{aligned}1 \\\\ 2\\end{aligned}]{e}^{-2t}+{c}_{2}[\\begin{aligned}2 \\\\ -1\\end{aligned}]{e}^{t},\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nThen, the general solution of the system can be written as \n$x(t)={x}_{c}(t)+{x}_{p}(t),$\nwhere ${x}_{p}(t)$ is a particular solution. Determine the form of the particular solution ${x}_{p}(t).$" :question/worked-solution "Recall that the general solution of an inhomogeneous system can be written as \n\n$$\nx(t)={x}_{c}(t)+{x}_{p}(t)\n$$\n\nwhere ${x}_{c}(t)$ is the complementary solution (solution of the corresponding homogeneous system) and ${x}_{p}(t)$ is a particular solution.\n\nThe forcing term\n\n$$\n[\\begin{aligned}1 \\\\ 4\\end{aligned}]\n$$\n\nof the inhomogeneous system of ODEs is constant. Therefore, we assume that the particular solution is also constant, i.e.\n\n$$\n{x}_{p}(t)=[\\begin{aligned}{a}_{1} \\\\ {a}_{2}\\end{aligned}],\n$$\n\nwhere ${a}_{1},{a}_{2}$ are constants that are to be determined." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d744d908-cf4d-5235-b951-02b4eba533c9"] :db/ensure [:question/validate]} {:db/id "answer-field-d744d908-cf4d-5235-b951-02b4eba533c9" :answer-field/id #uuid "d744d908-cf4d-5235-b951-02b4eba533c9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a7132385-7803-53ed-9e7a-bd0a73aaedda" :answer-field/choices ["answer-a7132385-7803-53ed-9e7a-bd0a73aaedda" "answer-2d2844d1-123e-55fc-a158-f0c5eb9a88be" "answer-15b6db1c-6da1-5535-8303-f77afc11a0fa" "answer-16e3c069-4d0f-571b-998d-795c4aedc752" "answer-b1172b23-ff5e-5a59-9d03-1f3f1510fae5"] :db/ensure [:answer-field/validate]} {:db/id "answer-a7132385-7803-53ed-9e7a-bd0a73aaedda" :answer/id #uuid "a7132385-7803-53ed-9e7a-bd0a73aaedda" :answer/type :answer.type/math :answer/value "[\\begin{aligned}{a}_{1} \\\\ {a}_{2}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-2d2844d1-123e-55fc-a158-f0c5eb9a88be" :answer/id #uuid "2d2844d1-123e-55fc-a158-f0c5eb9a88be" :answer/type :answer.type/math :answer/value "t[\\begin{aligned}{a}_{1} \\\\ {a}_{2}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-15b6db1c-6da1-5535-8303-f77afc11a0fa" :answer/id #uuid "15b6db1c-6da1-5535-8303-f77afc11a0fa" :answer/type :answer.type/math :answer/value "{e}^{-2t}[\\begin{aligned}{a}_{1} \\\\ {a}_{2}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-16e3c069-4d0f-571b-998d-795c4aedc752" :answer/id #uuid "16e3c069-4d0f-571b-998d-795c4aedc752" :answer/type :answer.type/math :answer/value "{e}^{t}(t[\\begin{aligned}{a}_{1} \\\\ {a}_{2}\\end{aligned}])" :db/ensure [:answer/validate]} {:db/id "answer-b1172b23-ff5e-5a59-9d03-1f3f1510fae5" :answer/id #uuid "b1172b23-ff5e-5a59-9d03-1f3f1510fae5" :answer/type :answer.type/math :answer/value "{e}^{t}[\\begin{aligned}{a}_{1} \\\\ {a}_{2}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id 17592186166904 :knowledge-point/questions ["question-3234de52-8801-51a2-806f-23f965c5de2f" "question-2e73d348-8d9b-5a9f-8dbf-5305290f7f53"] :db/ensure [:knowledge-point/validate]} {:db/id "question-3234de52-8801-51a2-806f-23f965c5de2f" :question/id #uuid "3234de52-8801-51a2-806f-23f965c5de2f" :question/math-academy-id "q-333012" :question/problem "Consider the following inhomogeneous system of linear differential equations:\n\n$$\n{x}^{′}(t)=[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}]x(t)+[\\begin{aligned}2{t}^{2}+t+3 \\\\ -{t}^{2}+2t\\end{aligned}]\n$$\n\nThe complementary solution to this system is given by\n\n$$\n{x}_{c}(t)={c}_{1}[\\begin{aligned}\\operatorname{cos}⁡t \\\\ \\operatorname{sin}⁡t\\end{aligned}]+{c}_{2}[\\begin{aligned}-\\operatorname{sin}⁡t \\\\ \\operatorname{cos}⁡t\\end{aligned}],\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nThen, the general solution of the system is\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">\n    $x(t)={x}_{c}(t)+\\,\\,$\n  </td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">$1$</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">\n    $\\,\\,{t}^{2}+\\,\\,$\n  </td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">\n    $2$\n  </td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">\n    $\\,\\,t+\\,\\,$\n  </td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">\n    .\n  </td>\n</tr>\n<tr>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\"></td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">\n    $1$\n  </td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Recall that the general solution of an inhomogeneous system can be written as \n\n$$\nx(t)={x}_{c}(t)+{x}_{p}(t)\n$$\n\nwhere ${x}_{c}(t)$ is the complementary solution (solution of the corresponding homogeneous system) and ${x}_{p}(t)$ is a particular solution.\n\nThe forcing term\n\n$$\n[\\begin{aligned}2{t}^{2}+t+3 \\\\ -{t}^{2}+2t\\end{aligned}]\n$$\n\nof the inhomogeneous system of ODEs is polynomial of degree $2.$ Therefore, we assume that the particular solution is also polynomial of degree $2,$ i.e.\n\n$$\n{x}_{p}(t)=[\\begin{aligned}{a}_{1}{t}^{2}+{b}_{1}t+{c}_{1} \\\\ {a}_{2}{t}^{2}+{b}_{2}t+{c}_{2}\\end{aligned}]=[\\begin{aligned}{a}_{1} \\\\ {a}_{2}\\end{aligned}]{t}^{2}+[\\begin{aligned}{b}_{1} \\\\ {b}_{2}\\end{aligned}]t+[\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}],\n$$\n\nwhere ${a}_{1},{a}_{2},{b}_{1},{b}_{2},{c}_{1},{c}_{2}$ are constants that are to be determined. \n\nCalculating the derivative of ${x}_{p}$ with respect to $t$ gives\n\n$$\n{x}_{p}^{′}(t)=[\\begin{aligned}2{a}_{1}t+{b}_{1} \\\\ 2{a}_{2}t+{b}_{2}\\end{aligned}].\n$$\n\nTo find the unknown constants, we substitute ${x}_{p}$ and ${x}_{p}^{′}$ into our system:\n\n$$\n\\begin{aligned}[\\begin{aligned}2{a}_{1}t+{b}_{1} \\\\ 2{a}_{2}t+{b}_{2}\\end{aligned}] & =[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}{a}_{1}{t}^{2}+{b}_{1}t+{c}_{1} \\\\ {a}_{2}{t}^{2}+{b}_{2}t+{c}_{2}\\end{aligned}]+[\\begin{aligned}2{t}^{2}+t+3 \\\\ -{t}^{2}+2t\\end{aligned}] \\\\ [\\begin{aligned}2{a}_{1}t+{b}_{1} \\\\ 2{a}_{2}t+{b}_{2}\\end{aligned}] & =[\\begin{aligned}-({a}_{2}{t}^{2}+{b}_{2}t+{c}_{2}) \\\\ {a}_{1}{t}^{2}+{b}_{1}t+{c}_{1}\\end{aligned}]+[\\begin{aligned}2{t}^{2}+t+3 \\\\ -{t}^{2}+2t\\end{aligned}] \\\\ [\\begin{aligned}0{t}^{2}+2{a}_{1}t+{b}_{1} \\\\ 0{t}^{2}+2{a}_{2}t+{b}_{2}\\end{aligned}] & =[\\begin{aligned}(-{a}_{2}+2){t}^{2}+(-{b}_{2}+1)t+(-{c}_{2}+3) \\\\ ({a}_{1}-1){t}^{2}+({b}_{1}+2)t+{c}_{1}\\end{aligned}]\\end{aligned}\n$$\n\nEquating the corresponding coefficients of like powers of $t,$ we get the following system:\n\n$$\n\\{\\begin{aligned}-{a}_{2}+2=0 \\\\ -\\,{b}_{2}+1=2{a}_{1} \\\\ -\\,{c}_{2}+3={b}_{1} \\\\ {a}_{1}-1=0 \\\\ {b}_{1}+2=2{a}_{2} \\\\ {c}_{1}={b}_{2}\\end{aligned}\n$$\n\nSolving the first and fourth equations, we get\n\n$$\n{a}_{2}=2,\\,{a}_{1}=1.\n$$\n\nSubstituting these into the second and fifth equations, and solving for ${b}_{1}$ and ${b}_{2},$ we get\n\n$$\n{b}_{2}=-1,\\,{b}_{1}=2.\n$$\n\nFinally, substituting these last values into the third and sixth equations, and solving for ${c}_{1}$ and ${c}_{2},$ we have\n\n$$\n{c}_{2}=1,\\,{c}_{1}=-1.\n$$\n\nTherefore, the particular solution is\n\n$$\n{x}_{p}(t)=[\\begin{aligned}{t}^{2}+2t-1 \\\\ 2{t}^{2}-t+1\\end{aligned}]=[\\begin{aligned}1 \\\\ 2\\end{aligned}]{t}^{2}+[\\begin{aligned}2 \\\\ -1\\end{aligned}]t+[\\begin{aligned}-1 \\\\ 1\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-2933141c-2169-5b87-8fb5-b8ed2e025c9c" "answer-field-f3dc74ec-4f14-5ce0-aef2-9920a7e3da3c" "answer-field-9f12c9a5-b2a0-5f55-8200-bc2b6ab50775"] :db/ensure [:question/validate]} {:db/id "answer-field-2933141c-2169-5b87-8fb5-b8ed2e025c9c" :answer-field/id #uuid "2933141c-2169-5b87-8fb5-b8ed2e025c9c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-76419d8d-c305-5619-a8a2-c0287e5dda0d" :answer-field/choices ["answer-76419d8d-c305-5619-a8a2-c0287e5dda0d"] :db/ensure [:answer-field/validate]} {:db/id "answer-76419d8d-c305-5619-a8a2-c0287e5dda0d" :answer/id #uuid "76419d8d-c305-5619-a8a2-c0287e5dda0d" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-field-f3dc74ec-4f14-5ce0-aef2-9920a7e3da3c" :answer-field/id #uuid "f3dc74ec-4f14-5ce0-aef2-9920a7e3da3c" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-9d157cb9-9968-5484-a3c7-ab43310ab864" :answer-field/choices ["answer-9d157cb9-9968-5484-a3c7-ab43310ab864"] :db/ensure [:answer-field/validate]} {:db/id "answer-9d157cb9-9968-5484-a3c7-ab43310ab864" :answer/id #uuid "9d157cb9-9968-5484-a3c7-ab43310ab864" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-field-9f12c9a5-b2a0-5f55-8200-bc2b6ab50775" :answer-field/id #uuid "9f12c9a5-b2a0-5f55-8200-bc2b6ab50775" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-cafae102-8ddc-57ce-b89b-eb060527e40e" :answer-field/choices ["answer-cafae102-8ddc-57ce-b89b-eb060527e40e"] :db/ensure [:answer-field/validate]} {:db/id "answer-cafae102-8ddc-57ce-b89b-eb060527e40e" :answer/id #uuid "cafae102-8ddc-57ce-b89b-eb060527e40e" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "question-2e73d348-8d9b-5a9f-8dbf-5305290f7f53" :question/id #uuid "2e73d348-8d9b-5a9f-8dbf-5305290f7f53" :question/math-academy-id "q-332913" :question/problem "Consider the following inhomogeneous system of linear differential equations:\n\n$$\n{x}^{′}(t)=[\\begin{aligned}0 & -2 \\\\ 2 & 0\\end{aligned}]x(t)+{e}^{-3t}[\\begin{aligned}1 \\\\ 5\\end{aligned}].\n$$\n\nThe complementary solution to this system is given by\n\n$$\n{x}_{c}(t)={c}_{1}[\\begin{aligned}\\operatorname{cos}⁡(2t) \\\\ \\operatorname{sin}⁡(2t)\\end{aligned}]+{c}_{2}[\\begin{aligned}-\\operatorname{sin}⁡(2t) \\\\ \\operatorname{cos}⁡(2t)\\end{aligned}],\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nThen, the general solution of the system is\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">$x(t)={x}_{c}(t)+$ {{field-1}} $\\cdot \\,\\,$</td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">$-1$</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Recall that the general solution of an inhomogeneous system can be written as \n\n$$\nx(t)={x}_{c}(t)+{x}_{p}(t)\n$$\n\nwhere ${x}_{c}(t)$ is the complementary solution (solution of the corresponding homogeneous system) and ${x}_{p}(t)$ is a particular solution.\n\nThe forcing term\n\n$$\n{e}^{-3t}[\\begin{aligned}1 \\\\ 5\\end{aligned}]\n$$\n\nof the inhomogeneous system of ODEs is exponential. Therefore, we assume that the particular solution is also exponential, i.e.\n\n$$\n{x}_{p}(t)={e}^{-3t}[\\begin{aligned}a \\\\ b\\end{aligned}],\n$$\n\nwhere $a,b$  are constants that are to be determined. \n\nCalculating the derivative of ${x}_{p}$ with respect to $t$ gives\n\n$$\n{x}_{p}^{′}(t)=-3{e}^{-3t}[\\begin{aligned}a \\\\ b\\end{aligned}].\n$$\n\nTo find the unknown constants, we substitute ${x}_{p}$ and ${x}_{p}^{′}$ into our system:\n\n$$\n\\begin{aligned}-3{e}^{-3t}[\\begin{aligned}a \\\\ b\\end{aligned}] & =[\\begin{aligned}0 & -2 \\\\ 2 & 0\\end{aligned}]\\cdot {e}^{-3t}[\\begin{aligned}a \\\\ b\\end{aligned}]+{e}^{-3t}[\\begin{aligned}1 \\\\ 5\\end{aligned}] \\\\ -3[\\begin{aligned}a \\\\ b\\end{aligned}] & =[\\begin{aligned}0 & -2 \\\\ 2 & 0\\end{aligned}]\\cdot [\\begin{aligned}a \\\\ b\\end{aligned}]+[\\begin{aligned}1 \\\\ 5\\end{aligned}] \\\\ [\\begin{aligned}-3a \\\\ -3b\\end{aligned}] & =[\\begin{aligned}-2b \\\\ 2a\\end{aligned}]+[\\begin{aligned}1 \\\\ 5\\end{aligned}] \\\\ [\\begin{aligned}-3a \\\\ -3b\\end{aligned}] & =[\\begin{aligned}-2b+1 \\\\ 2a+5\\end{aligned}]\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\{\\begin{aligned}-2b+1=-3a \\\\ 2a+5=-3b\\end{aligned}\n$$\n\nFrom the first equation, we get \n\n$$\n-2b+1=-3a\\,⇒\\,a=\\frac{2b-1}{3}.\n$$\n\n \nSubstituting this into the second equation and solving for $b,$ we have\n\n$$\n2(\\frac{2b-1}{3})+5=-3b\\,⇒\\,4b-2+15=-9b\\,⇒\\,b=-1.\n$$\n\nSo,\n\n$$\na=\\frac{2(-1)-1}{3}=\\frac{-2-1}{3}=-1.\n$$\n\nTherefore, the particular solution is\n\n$$\n{x}_{p}(t)={e}^{-3t}[\\begin{aligned}-1 \\\\ -1\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-6c17466c-b8ca-50c3-9f75-a6a53610a6c3" "answer-field-79975f54-a6ab-5d67-8f15-fd4af267d146"] :db/ensure [:question/validate]} {:db/id "answer-field-6c17466c-b8ca-50c3-9f75-a6a53610a6c3" :answer-field/id #uuid "6c17466c-b8ca-50c3-9f75-a6a53610a6c3" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-731aa6f4-9b42-511b-99eb-f375784ef6ae" :answer-field/choices ["answer-731aa6f4-9b42-511b-99eb-f375784ef6ae"] :db/ensure [:answer-field/validate]} {:db/id "answer-731aa6f4-9b42-511b-99eb-f375784ef6ae" :answer/id #uuid "731aa6f4-9b42-511b-99eb-f375784ef6ae" :answer/type :answer.type/math :answer/value "e^{-3t}" :db/ensure [:answer/validate]} {:db/id "answer-field-79975f54-a6ab-5d67-8f15-fd4af267d146" :answer-field/id #uuid "79975f54-a6ab-5d67-8f15-fd4af267d146" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-26d00d5e-9f6b-5691-9183-ca640417b15f" :answer-field/choices ["answer-26d00d5e-9f6b-5691-9183-ca640417b15f"] :db/ensure [:answer-field/validate]} {:db/id "answer-26d00d5e-9f6b-5691-9183-ca640417b15f" :answer/id #uuid "26d00d5e-9f6b-5691-9183-ca640417b15f" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id 17592186167169 :question/problem "Consider the following inhomogeneous system of linear differential equations:\n\n$$\n{x}^{′}(t)=[\\begin{aligned}1 & 3 \\\\ 1 & -1\\end{aligned}]x(t)+[\\begin{aligned}1 \\\\ -2t+1\\end{aligned}]\n$$\n\nThe complementary solution to this system is given by\n\n$$\n{x}_{c}(t)={c}_{1}[\\begin{aligned}-1 \\\\ 1\\end{aligned}]{e}^{-2t}+{c}_{2}[\\begin{aligned}3 \\\\ 1\\end{aligned}]{e}^{2t},\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nThen, the general solution of the system is\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">$x(t)={x}_{c}(t)+\\,\\,$</td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">$3/2$</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">$\\,\\,t+\\,\\,$</td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">.</td>\n</tr>\n<tr>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">$1/2$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Recall that the general solution of an inhomogeneous system can be written as \n\n$$\nx(t)={x}_{c}(t)+{x}_{p}(t)\n$$\n\nwhere ${x}_{c}(t)$ is the complementary solution (solution of the corresponding homogeneous system) and ${x}_{p}(t)$ is a particular solution.\n\nThe forcing term\n\n$$\n[\\begin{aligned}1 \\\\ -2t+1\\end{aligned}]\n$$\n\nof the inhomogeneous system of ODEs is polynomial of degree $1.$ Therefore, we assume that the particular solution is also polynomial of degree $1,$ i.e.\n\n$$\n{x}_{p}(t)=[\\begin{aligned}{a}_{1}t+{b}_{1} \\\\ {a}_{2}t+{b}_{2}\\end{aligned}]=[\\begin{aligned}{a}_{1} \\\\ {a}_{2}\\end{aligned}]t+[\\begin{aligned}{b}_{1} \\\\ {b}_{2}\\end{aligned}],\n$$\n\nwhere ${a}_{1},{a}_{2},{b}_{1},{b}_{2}$  are constants that are to be determined. \n\nCalculating the derivative of ${x}_{p}$ with respect to $t$ gives\n\n$$\n{x}_{p}^{′}(t)=[\\begin{aligned}{a}_{1} \\\\ {a}_{2}\\end{aligned}].\n$$\n\nTo find the unknown constants, we substitute ${x}_{p}$ and ${x}_{p}^{′}$ into our system:\n\n$$\n\\begin{aligned}[\\begin{aligned}{a}_{1} \\\\ {a}_{2}\\end{aligned}] & =[\\begin{aligned}1 & 3 \\\\ 1 & -1\\end{aligned}]([\\begin{aligned}{a}_{1} \\\\ {a}_{2}\\end{aligned}]t+[\\begin{aligned}{b}_{1} \\\\ {b}_{2}\\end{aligned}])+[\\begin{aligned}1 \\\\ -2t+1\\end{aligned}] \\\\ [\\begin{aligned}{a}_{1} \\\\ {a}_{2}\\end{aligned}] & =[\\begin{aligned}{a}_{1}+3{a}_{2} \\\\ {a}_{1}-{a}_{2}\\end{aligned}]t+[\\begin{aligned}{b}_{1}+3{b}_{2} \\\\ {b}_{1}-{b}_{2}\\end{aligned}]+[\\begin{aligned}1 \\\\ -2t+1\\end{aligned}] \\\\ [\\begin{aligned}0t+{a}_{1} \\\\ 0t+{a}_{2}\\end{aligned}] & =[\\begin{aligned}({a}_{1}+3{a}_{2})t+({b}_{1}+3{b}_{2}+1) \\\\ ({a}_{1}-{a}_{2}-2)t+({b}_{1}-{b}_{2}+1)\\end{aligned}]\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\{\\begin{aligned}{a}_{1}+3{a}_{2}=0 \\\\ {a}_{1}-{a}_{2}-2=0 \\\\ {b}_{1}+3{b}_{2}+1={a}_{1} \\\\ {b}_{1}-{b}_{2}+1={a}_{2}\\end{aligned}\n$$\n\nSolving the first two equations, we get \n\n$$\n{a}_{1}=\\frac{3}{2},\\,{a}_{2}=-\\frac{1}{2}.\n$$\n\n \nSubstituting these into the third and fourth equations, and solving for ${b}_{1}$ and ${b}_{2},$ we have\n\n$$\n{b}_{1}=-1,\\,{b}_{2}=\\frac{1}{2}.\n$$\n\n \n\nTherefore, the particular solution is\n\n$$\n{x}_{p}(t)=[\\begin{aligned}3/2 \\\\ -1/2\\end{aligned}]t+[\\begin{aligned}-1 \\\\ 1/2\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186164048 :answer-field/correct "answer-68397710-f20c-5389-86e2-ff7174f9153b" :answer-field/choices ["answer-68397710-f20c-5389-86e2-ff7174f9153b"] :db/ensure [:answer-field/validate]} {:db/id "answer-68397710-f20c-5389-86e2-ff7174f9153b" :answer/id #uuid "68397710-f20c-5389-86e2-ff7174f9153b" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id 17592186164047 :answer-field/correct "answer-168093fa-9a63-55ce-a515-83e652a3a0ce" :answer-field/choices ["answer-168093fa-9a63-55ce-a515-83e652a3a0ce"] :db/ensure [:answer-field/validate]} {:db/id "answer-168093fa-9a63-55ce-a515-83e652a3a0ce" :answer/id #uuid "168093fa-9a63-55ce-a515-83e652a3a0ce" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id 17592186167990 :tutorial/content "Consider an **inhomogeneous** linear system of ordinary differential equations in component form:\n\n$$\n\\{\\begin{aligned}{x}_{1}^{′}(t)={a}_{11}{x}_{1}(t)+{a}_{12}{x}_{2}(t)+{f}_{1}(t) \\\\ {x}_{2}^{′}(t)={a}_{21}{x}_{1}(t)+{a}_{22}{x}_{2}(t)+{f}_{2}(t)\\end{aligned}\n$$\n\nHere, we can package the unknown functions into vectors\n![](images/03/037289f6f3a779d750cef23dc18d149786604bd477565e3708d6470f2e3c2f7a.svg)\n\nThen, the system can be written as\n![](images/77/77fc846681e1f0a98675b06f962e42f4491fd07d9bb2eab291e69cd49e4dd5f9.svg)\n\nOften, the **forcing functions** $f_1(t), f_2(t)$ are linear combinations of a few basic functions (such as $e^{3t},$ $t^2,$ or $\\sin t$).\nIn that case, it is useful to write $\\mathbf{g}(t)$ as a sum of those basic functions times constant vectors.\n\nFor example, let's write down the system of linear ODEs below in matrix form.\n\n$$\n\\{\\begin{aligned}{x}_{1}^{′}(t)=4{x}_{1}(t)+2{x}_{2}(t)+8{e}^{3t} \\\\ {x}_{2}^{′}(t)=-3{x}_{1}(t)+5{x}_{2}(t)+10{e}^{4t}\\end{aligned}\n$$\n\nFirst, let's rewrite our system, highlighting the coefficients:\n\n$$\n\\{\\begin{aligned}{x}_{1}^{′}(t)=4\\cdot {x}_{1}(t)+2\\cdot {x}_{2}(t)+{e}^{3t}\\cdot 8+{e}^{4t}\\cdot 0 \\\\ {x}_{2}^{′}(t)=(-3)\\cdot {x}_{1}(t)+5\\cdot {x}_{2}(t)+{e}^{3t}\\cdot 0+{e}^{4t}\\cdot 10\\end{aligned}\n$$\n\nNow, we can write the system in matrix form:\n![](images/47/47fb751641455ab4cf85756166fa8811bd8fe3ddc6bcb6005c8e6be8c31b6fe1.svg)\nwhere ![](images/f4/f47e1272123fb8f4a5f54931929b9492f54e9d78d590b2ee28394bf29976ce44.svg)" :db/ensure [:tutorial/validate]}] "assertions" [["question-eadcb6eb-28e0-561c-baf8-c3576858d2b7" :question/id #uuid "eadcb6eb-28e0-561c-baf8-c3576858d2b7"] ["question-eadcb6eb-28e0-561c-baf8-c3576858d2b7" :question/math-academy-id "q-332585"] ["question-eadcb6eb-28e0-561c-baf8-c3576858d2b7" :question/problem "$$\n\\{\\begin{aligned}{x}_{1}^{′}(t)=-3{x}_{1}(t)+2{x}_{2}(t)+5\\operatorname{sin}⁡(4t)+7\\operatorname{cos}⁡(t) \\\\ {x}_{2}^{′}(t)=4{x}_{1}(t)-{x}_{2}(t)+3\\operatorname{sin}⁡(4t)-2\\operatorname{cos}⁡(t)\\end{aligned}\n$$\n\nThe systems of linear ODEs above can be written in matrix form as follows:\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">${x}^{′}(t)=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"40px\">{{field-1}}</td>\n<td align=\"center\" width=\"40px\">{{field-2}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">$\\,\\,x(t)+\\,\\,$</td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">$\\,\\,\\operatorname{sin}⁡(4t)+\\,\\,$</td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-4}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">$\\,\\,\\operatorname{cos}⁡(t)$</td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-5}}</td>\n<td align=\"center\" width=\"30px\">{{field-6}}</td>\n<td align=\"center\"></td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-7}}</td>\n<td align=\"center\"></td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-8}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>"] ["question-eadcb6eb-28e0-561c-baf8-c3576858d2b7" :question/worked-solution "First, let's rewrite our system, highlighting the coefficients:\n\n$$\n\\{\\begin{aligned}{x}_{1}^{′}(t)=(-3)\\cdot {x}_{1}(t)+2\\cdot {x}_{2}(t)+5\\cdot \\operatorname{sin}⁡(4t)+7\\cdot \\operatorname{cos}⁡(t) \\\\ {x}_{2}^{′}(t)=4\\cdot {x}_{1}(t)+(-1)\\cdot {x}_{2}(t)+3\\cdot \\operatorname{sin}⁡(4t)+(-2)\\cdot \\operatorname{cos}⁡(t)\\end{aligned}\n$$\n\nNow, we can write the system in matrix form:\n\n$$\n{x}^{′}(t)=[\\begin{aligned}-3 & 2 \\\\ 4 & -1\\end{aligned}]x(t)+[\\begin{aligned}5 \\\\ 3\\end{aligned}]\\operatorname{sin}⁡(4t)+[\\begin{aligned}7 \\\\ -2\\end{aligned}]\\operatorname{cos}⁡(t)\n$$\n\nwhere $x(t)=[\\begin{aligned}{x}_{1}(t) \\\\ {x}_{2}(t)\\end{aligned}].$"] ["question-eadcb6eb-28e0-561c-baf8-c3576858d2b7" :question/difficulty :question.difficulty/moderate] ["answer-field-1be54abc-d2f8-5e71-86b4-95e3ede8e8b9" :answer-field/id #uuid "1be54abc-d2f8-5e71-86b4-95e3ede8e8b9"] ["answer-95276f1c-36f0-5f08-904e-b3c36535d237" :answer/id #uuid "95276f1c-36f0-5f08-904e-b3c36535d237"] ["answer-95276f1c-36f0-5f08-904e-b3c36535d237" :answer/type :answer.type/math] ["answer-95276f1c-36f0-5f08-904e-b3c36535d237" :answer/value "-3"] ["answer-field-1be54abc-d2f8-5e71-86b4-95e3ede8e8b9" :answer-field/key "field-1"] ["answer-field-1be54abc-d2f8-5e71-86b4-95e3ede8e8b9" :answer-field/type :answer-field.type/blank] ["answer-field-1be54abc-d2f8-5e71-86b4-95e3ede8e8b9" :answer-field/correct "answer-95276f1c-36f0-5f08-904e-b3c36535d237"] ["answer-field-1be54abc-d2f8-5e71-86b4-95e3ede8e8b9" :answer-field/choices "answer-95276f1c-36f0-5f08-904e-b3c36535d237"] ["answer-field-5aed8437-ee45-5890-83bb-09c9f9e1bcc8" :answer-field/id #uuid "5aed8437-ee45-5890-83bb-09c9f9e1bcc8"] ["answer-9f2a7653-2cc3-5d49-8385-0aabe06fc0eb" :answer/id #uuid "9f2a7653-2cc3-5d49-8385-0aabe06fc0eb"] ["answer-9f2a7653-2cc3-5d49-8385-0aabe06fc0eb" :answer/type :answer.type/math] ["answer-9f2a7653-2cc3-5d49-8385-0aabe06fc0eb" :answer/value "2"] ["answer-field-5aed8437-ee45-5890-83bb-09c9f9e1bcc8" :answer-field/key "field-2"] ["answer-field-5aed8437-ee45-5890-83bb-09c9f9e1bcc8" :answer-field/type :answer-field.type/blank] ["answer-field-5aed8437-ee45-5890-83bb-09c9f9e1bcc8" :answer-field/correct "answer-9f2a7653-2cc3-5d49-8385-0aabe06fc0eb"] ["answer-field-5aed8437-ee45-5890-83bb-09c9f9e1bcc8" :answer-field/choices "answer-9f2a7653-2cc3-5d49-8385-0aabe06fc0eb"] ["answer-field-a5d80446-5433-569c-ad43-d2633b905967" :answer-field/id #uuid "a5d80446-5433-569c-ad43-d2633b905967"] ["answer-6e52aaec-6699-5c73-9493-b586f9420d4a" :answer/id #uuid "6e52aaec-6699-5c73-9493-b586f9420d4a"] ["answer-6e52aaec-6699-5c73-9493-b586f9420d4a" :answer/type :answer.type/m