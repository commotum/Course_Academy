edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186531546}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "48e63c6e-e110-5f2f-9c73-cb4374b7c6c6" :question/math-academy-id "q-332587" :question/problem "$$\n\\{\\begin{aligned}{x}_{1}^{′}(t)={x}_{1}(t)-4{x}_{2}(t)+2\\operatorname{sin}⁡(2t)+\\operatorname{cos}⁡(5t) \\\\ {x}_{2}^{′}(t)=3{x}_{1}(t)+2{x}_{2}(t)+4\\operatorname{cos}⁡(5t)\\end{aligned}\n$$\n\nThe systems of linear ODEs above can be written in matrix form as follows:\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">${x}^{′}(t)=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"40px\">{{field-1}}</td>\n<td align=\"center\" width=\"40px\">{{field-2}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">$\\,\\,x(t)+\\,\\,$</td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">$\\,\\,\\operatorname{sin}⁡(2t)+\\,\\,$</td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-4}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">$\\,\\,\\operatorname{cos}⁡(5t)$</td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-5}}</td>\n<td align=\"center\" width=\"30px\">{{field-6}}</td>\n<td align=\"center\"></td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-7}}</td>\n<td align=\"center\"></td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-8}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "First, let's rewrite our system, highlighting the coefficients:\n\n$$\n\\{\\begin{aligned}{x}_{1}^{′}(t)=1\\cdot {x}_{1}(t)+(-4)\\cdot {x}_{2}(t)+2\\cdot \\operatorname{sin}⁡(2t)+1\\cdot \\operatorname{cos}⁡(5t) \\\\ {x}_{2}^{′}(t)=3\\cdot {x}_{1}(t)+2\\cdot {x}_{2}(t)+0\\cdot \\operatorname{sin}⁡(2t)+4\\cdot \\operatorname{cos}⁡(5t)\\end{aligned}\n$$\n\nNow, we can write the system in matrix form:\n\n$$\n{x}^{′}(t)=[\\begin{aligned}1 & -4 \\\\ 3 & 2\\end{aligned}]x(t)+[\\begin{aligned}2 \\\\ 0\\end{aligned}]\\operatorname{sin}⁡(2t)+[\\begin{aligned}1 \\\\ 4\\end{aligned}]\\operatorname{cos}⁡(5t)\n$$\n\nwhere $x(t)=[\\begin{aligned}{x}_{1}(t) \\\\ {x}_{2}(t)\\end{aligned}].$"}] [{:db/id #edb/ref 17592186305063 :knowledge-point/_questions [{:db/id #edb/ref 17592186166902 :knowledge-point/id #uuid "51834713-edc2-5af3-a0dc-fb54ea4040c6" :knowledge-point/title "Writing Down an Inhomogeneous System of Linear ODEs in Matrix Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a2c098d-4c8c-5c2f-8d92-78ef543ce372" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186303006}] :answer-field/correct {:answer/id #uuid "5a2c098d-4c8c-5c2f-8d92-78ef543ce372" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186303006} :answer-field/id #uuid "09bb67ec-31bd-589b-9fab-c0db01ae03b5" :answer-field/key "field-6" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186304090} {:answer-field/choices [{:answer/id #uuid "d1127f2a-bb01-56b8-aa71-e2a72a9ab5dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186303746}] :answer-field/correct {:answer/id #uuid "d1127f2a-bb01-56b8-aa71-e2a72a9ab5dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186303746} :answer-field/id #uuid "3a5c5b7e-4f68-5bc9-a7f3-65915ed71fc4" :answer-field/ke