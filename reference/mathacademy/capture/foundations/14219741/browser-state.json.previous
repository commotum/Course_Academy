      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14219741/observations/step-q329074-d8b829a8b5e76d568c2b.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14219741/observations/step-q329074-d8b829a8b5e76d568c2b.png",
