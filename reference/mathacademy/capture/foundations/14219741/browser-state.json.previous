elative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mstyle><mjx-mspace style=\"width: 0.222em;\"></mjx-mspace></mjx-mstyle><mjx-mstyle><mjx-mspace style=\"width: 0.222em;\"></mjx-mspace></mjx-mstyle><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D461 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c2B\"></mjx-c></mjx-mo><mjx-mstyle><mjx-mspace style=\"width: 0.222em;\"></mjx-mspace></mjx-mstyle><mjx-mstyle><mjx-mspace style=\"width: 0.222em;\"></mjx-mspace></mjx-mstyle></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mi>t</mi><mo>+</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle></math></mjx-assistive-mml></mjx-container></td>\n<td width=\"5px\" height=\"30px\" style=\"text-align:top; border:1px solid black;\"></td>\n<td style=\"text-align:center; border:hidden;\">\n<div id=\"freeResponseTextbox-1\" class=\"matheditor-wrapper-answer\" ;=\"\" style=\"min-width:30px;\n                                        margin-left:2px;\n                                        margin-right:2px;\n                                        background:;\"><div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"231\"><span mathquill-command-id=\"235\" class=\"\">−</span><span mathquill-command-id=\"237\">1</span></span></div></div>\n</td>\n<td width=\"5px\" style=\"text-align:center; border:1px solid black;\"></td>\n<td rowspan=\"2\" height=\"40px\" style=\"text-align:ce