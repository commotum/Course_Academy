e72d4-e5ec-5e8d-a454-39ca5f817a72" #edb/ref 17592186045417] [17592186310531 #edb/ref 1080 "\\frac{7}{15}" #edb/ref 17592186045417] [17592186310531 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186310531 #edb/ref 1083 #uuid "de4bd802-c89d-5919-bee4-6cbe13e84831" #edb/ref 17592186045417] [17592186310582 #edb/ref 1080 "\\frac{1}{15}" #edb/ref 17592186045417] [17592186310582 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186310582 #edb/ref 1083 #uuid "e6d5c2bc-9894-547b-9710-238479ebe005" #edb/ref 17592186045417] [17592186310974 #edb/ref 1075 #edb/ref 17592186310228 #edb/ref 17592186045417] [17592186310974 #edb/ref 1075 #edb/ref 17592186485818 #edb/ref 17592186045417] [17592186310974 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186310974 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186310974 #edb/ref 1078 #edb/ref 17592186485818 #edb/ref 17592186045417] [17592186310974 #edb/ref 1079 #uuid "43600dac-6d25-5682-8937-5005846b9935" #edb/ref 17592186045417] [17592186311061 #edb/ref 1075 #edb/ref 17592186308790 #edb/ref 17592186045417] [17592186311061 #edb/ref 1075 #edb/ref 17592186308849 #edb/ref 17592186045417] [17592186311061 #edb/ref 1075 #edb/ref 17592186310410 #edb/ref 17592186045417] [17592186311061 #edb/ref 1075 #edb/ref 17592186310531 #edb/ref 17592186045417] [17592186311061 #edb/ref 1075 #edb/ref 17592186310582 #edb/ref 17592186045417] [17592186311061 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186311061 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186311061 #edb/ref 1078 #edb/ref 17592186308849 #edb/ref 17592186045417] [17592186311061 #edb/ref 1079 #uuid "66524e78-f254-500a-8d22-7a05143b8c39" #edb/ref 17592186045417] [17592186311085 #edb/ref 1075 #edb/ref 17592186308796 #edb/ref 17592186045417] [17592186311085 #edb/ref 1075 #edb/ref 17592186309579 #edb/ref 17592186045417] [17592186311085 #edb/ref 1075 #edb/ref 17592186309676 #edb/ref 17592186045417] [17592186311085 #edb/ref 1075 #edb/ref 17592186310320 #edb/ref 17592186045417] [17592186311085 #edb/ref 1075 #edb/ref 17592186310503 #edb/ref 17592186045417] [17592186311085 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186311085 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186311085 #edb/ref 1078 #edb/ref 17592186310503 #edb/ref 17592186045417] [17592186311085 #edb/ref 1079 #uuid "6ea618d5-3a70-51f3-bce5-1d4b0166d37f" #edb/ref 17592186045417] [17592186311742 #edb/ref 1068 #edb/ref 17592186311061 #edb/ref 17592186045417] [17592186311742 #edb/ref 1069 "q-336740" #edb/ref 17592186045417] [17592186311742 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186311742 #edb/ref 1071 "![](images/7f/7f997f7647886e1eea24d292ddd66b2d331d6f7d4c7ffe47b6a52b52dd029a44.png)\n\nConsider the RL circuit shown above. Given that the current $I(t)$ at time $t$ seconds is given by\n\n$$\nI(t)=A{e}^{-6t}+\\alpha \\operatorname{cos}⁡(3t)+\\beta \\operatorname{sin}⁡(3t),\n$$\n\nwhere $A,$ $\\alpha ,$ and $\\beta $ are constants, find the value of $\\alpha +\\beta .$" #edb/ref 17592186045417] [17592186311742 #edb/ref 1072 #uuid "7180d4ef-44aa-537f-8256-f62f77cfe5b5" #edb/ref 17592186045417] [17592186311742 #edb/ref 1074 "The diagram shows a series RL circuit with a source electromotive force (EMF) of $4\\operatorname{sin}⁡(3t)\\,\\text{V},$ a resistor of resistance $12\\,Ω,$ and an inductor of inductance $2\\,\\text{H}.$\n\nKirchhoff's voltage law states that in a series circuit, the source voltage (EMF) equals the sum of the voltage drops.\n\nIn an RL circuit, there are two voltage drops:\n\n- The voltage drop across the resistor is proportional to the current, with a constant of proportionality $R=12\\,Ω.$\n\n$$\n{V}_{R}=12I\n$$\n\n- The voltage drop across the inductor is proportional to the rate of change of current, with a constant of proportionality $L=2\\,\\text{H}.$\n\n$$\n{V}_{L}=2\\cdot \\frac{dI}{dt}\n$$\n\nTherefore, by Kirchhoff's voltage law, the differential equation governing the amount of current $I$ in the circuit is\n\n$$\n4\\operatorname{sin}⁡(3t)=12I+2\\cdot \\frac{dI}{dt}\n$$\n\nwhich gives the equation\n\n$$\n\\frac{dI}{dt}+6I=2\\operatorname{sin}⁡(3t).\n$$\n\nThis is a first-order linear equation with constant coefficients. So, to find the general solution, we must find the sum of the complementary and particular solutions.\n\n- To find the complementary solution ${I}_{c},$ we solve the corresponding homogeneous equation, given by\n\n$$\n\\frac{d{I}_{c}}{dt}+6{I}_{c}=0.\n$$\n\nSolving using an integration technique, such as separation of variables, we obtain the complementary solution\n\n$$\n{I}_{c}(t)=A{e}^{-6t},\n$$\n\nwhere $A$ is a constant of integration.\n\n- Next, we find the particular solution. Note that the right-hand side of the inhomogeneous equation is sinusoidal with argument $3t.$ So, we assume that the particular solution is also sinusoidal with argument $3t,$ i.e.,\n\n$$\n{I}_{p}(t)=\\alpha \\operatorname{cos}⁡(3t)+\\beta \\operatorname{sin}⁡(3t).\n$$\n\nTo find the values of $\\alpha $ and $\\beta ,$ we substitute\n\n$$\n\\begin{aligned}{I}_{p} & =\\alpha \\operatorname{cos}⁡(3t)+\\beta \\operatorname{sin}⁡(3t), \\\\ \\frac{d{I}_{p}}{dt} & =-3\\alpha \\operatorname{sin}⁡(3t)+3\\beta \\operatorname{cos}⁡(3t),\\end{aligned}\n$$\n\ninto the inhomogeneous equation and group like terms on the left-hand side:\n\n$$\n\\begin{aligned}(-3\\alpha \\operatorname{sin}⁡(3t)+3\\beta \\operatorname{cos}⁡(3t))+6(\\alpha \\operatorname{cos}⁡(3t)+\\beta \\operatorname{sin}⁡(3t)) & =2\\operatorname{sin}⁡(3t) \\\\ (-3\\alpha +6\\beta )\\operatorname{sin}⁡(3t)+(6\\alpha +3\\beta )\\operatorname{cos}⁡(3t) & =2\\operatorname{sin}⁡(3t)\\end{aligned}\n$$\n\nEquating the coefficients, we get the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}-3\\alpha +6\\beta &=2\\, && (\\text{equating the coefficients of}\\,\\operatorname{sin}⁡(3t)) \\\\ 6\\alpha +3\\beta &=0\\, && (\\text{equating the coefficients of}\\,\\operatorname{cos}⁡(3t))\\end{aligned}\\right.\n$$\n\nSolving this system gives $\\alpha =-\\frac{2}{15},$ $\\beta =\\frac{4}{15}.$ Therefore, the particular solution is\n\n$$\n{I}_{p}(t)=-\\frac{2}{15}\\operatorname{cos}⁡(3t)+\\frac{4}{15}\\operatorname{sin}⁡(3t).\n$$\n\nNow, since the general solution is given by the sum of the complementary solution and the particular solution, the general solution in our case is\n\n$$\nI(t)={I}_{c}(t)+{I}_{p}(t)=A{e}^{-6t}-\\frac{2}{15}\\operatorname{cos}⁡(3t)+\\frac{4}{15}\\operatorname{sin}⁡(3t).\n$$\n\nTherefore, we have\n\n$$\n\\alpha =-\\frac{2}{15},\\,\\beta =\\frac{4}{15}\n$$\n\nwhich gives\n\n$$\n\\begin{aligned}\\alpha +\\beta  & =-\\frac{2}{15}+\\frac{4}{15} \\\\  & =\\frac{2}{15}.\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186321179 #edb/ref 1080 "-1" #edb/ref 17592186045417] [17592186321179 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186321179 #edb/ref 1083 #uuid "033fe036-222d-5d10-957e-6471d19dc5f0" #edb/ref 17592186045417] [17592186321489 #edb/ref 1080 "-2" #edb/ref 17592186045417] [17592186321489 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186321489 #edb/ref 1083 #uuid "2c482aed-cfdd-5bf4-acda-648b685f18fe" #edb/ref 17592186045417] [17592186321500 #edb/ref 1080 "1" #edb/ref 17592186045417] [17592186321500 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186321500 #edb/ref 1083 #uuid "2d64e163-f5c4-5413-9570-dd5493a5c5ac" #edb/ref 17592186045417] [17592186321853 #edb/ref 1080 "0" #edb/ref 17592186045417] [17592186321853 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186321853 #edb/ref 1083 #uuid "5988b748-db6c-5b36-9840-e6478cabbb51" #edb/ref 17592186045417] [17592186322125 #edb/ref 1080 "\\frac{1}{2}" #edb/ref 17592186045417] [17592186322125 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186322125 #edb/ref 1083 #uuid "7c472c58-699c-5782-89ce-b06e067314de" #e