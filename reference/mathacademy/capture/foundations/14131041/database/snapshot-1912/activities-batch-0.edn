e-point/title "Domains of Functions With Trigonometric Components"} :step/id #uuid "3947d2bf-1e5f-5028-8a1b-43cfaacc4546" :step/math-academy-id 44801}] :activity/title "The Domain of a Vector-Valued Function" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186115482}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186411595} :activity/id #uuid "96cfc23a-e860-5cec-be62-9f9b3c48eb57" :activity/scope {:db/id #edb/ref 17592186049186 :topic/id #uuid "e1c10e80-3811-5fcd-98a3-8118c49347e4" :topic/math-academy-id 1737} :activity/steps [{:db/id #edb/ref 17592186411591 :step/content {:db/id #edb/ref 17592186398576 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bfa1654c-e948-5fc3-a89a-4fe52cc8fccf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{6}+\\frac{\\pi n}{3}" :db/id #edb/ref 17592186398578} {:answer/id #uuid "8d1b7514-50b8-5ddd-9dc3-5b90007cd7cf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi n}{6}" :db/id #edb/ref 17592186398579} {:answer/id #uuid "61124a49-e750-5eed-9f63-4fab70f48c25" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\pi n" :db/id #edb/ref 17592186398580} {:answer/id #uuid "282a04d7-5121-553a-8c70-66602f8c83db" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi n}{3}" :db/id #edb/ref 17592186398581} {:answer/id #uuid "4a1c8270-8fd2-50fc-8447-30acc60e9312" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{2}+\\frac{\\pi n}{3}" :db/id #edb/ref 17592186398582}] :answer-field/correct {:db/id #edb/ref 17592186398578} :answer-field/id #uuid "4112b8f8-a1d3-5ca1-a272-50f00bc81e5d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186398577}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b2987e81-f85b-5262-9ea2-835ea44d86e0" :question/math-academy-id "q-162644" :question/problem "The domain of the vector-valued function $f(t)=(t+1)\\,i+\\operatorname{tan}⁡(3t)\\,j+{e}^{-t}\\,k$ is \n\n$$\nt\\in (-\\infty ,\\infty ),\\,t\\ne \\bbox[5pt,border:1pt solid black]{\\phantom{AAAAA}}.\n$$\n\nWhat is the missing expression? You may assume that $n$ is an integer." :question/worked-solution "To find the domain of $f$, we need the intersection of the domains of the individual components.\n\n- The domain of the 1st component $t+1$ is $t\\in (-\\infty ,\\infty ).$\n\n- The domain of the 2nd component $\\operatorname{tan}⁡(3t)$ is $t\\in (-\\infty ,\\infty ),$ except for the values of $t$ for which\n\n$$\n3t=\\frac{\\pi }{2}+\\pi n\\,⟹\\,t=\\frac{\\pi }{6}+\\frac{\\pi n}{3},\n$$\n\nwhere $n$ is an integer.\n\n- The domain of the 3rd component ${e}^{-t}$ is $t\\in (-\\infty ,\\infty ).$\n\nTherefore, the domain of the vector-valued function $f(t)$ is \n\n$$\nt\\in (-\\infty ,\\infty ),\\,t\\ne \\frac{\\pi }{6}+\\frac{\\pi n}{3},\n$$\n\nwhere $n$ is an integer."} :step/id #uuid "3ce5a87f-f4ad-59bf-8bf7-3a76cd4d166e" :step/next {:db/id #edb/ref 17592186411594}} {:db/id #edb/ref 17592186411592 :step/content {:db/id #edb/ref 17592186281524 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d759664-71cf-5524-8292-b4f9f56698b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t\\in (-1,\\infty )" :db/id #edb/ref 17592186279292} {:answer/id #uuid "839d4983-b3e1-5df2-929b-e864ccf4fcda" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t\\in (-1,0)\\cup (0,\\infty )" :db/id #edb/ref 17592186279769} {:answer/id #uuid "8ed76513-0186-5831-b557-a4f08af7383f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t\\in (-1,0]" :db/id #edb/ref 17592186279863} {:answer/id #uuid "ad393dc1-dc55-547e-b037-d30e59fc192b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t\\in (0,\\infty )" :db/id #edb/ref 17592186280126} {:answer/id #uuid "b43b6b14-c660-5371-ab23-f23367846209" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t\\in [0,\\infty )" :db/id #edb/ref 17592186280178}] :answer-field/correct {:db/id #edb/ref 17592186280126} :answer-field/id #uuid "685912e0-327e-5f2f-962f-61ee3eb96008" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186281014}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "0b92442b-8b2c-57b7-8241-452f363996f5" :question/math-academy-id "q-162662" :question/problem "Find the domain of the vector-valued function $f(t)=⟨\\sqrt{t},\\,\\operatorname{ln}⁡(t+1),\\,\\frac{1}{t}⟩.$" :question/worked-solution "To find the domain of $f$, we need the intersection of the domains of the individual components. \n\n- The domain of $\\sqrt{t}$ is $t\\in [0,\\infty ).$\n\n- The domain of $\\operatorname{ln}⁡(t+1)$ is $s\\in (-1,\\infty ).$\n\n- The domain of $\\frac{1}{t}$ is  $t\\in (-\\infty ,0)\\cup (0,\\infty ).$\n\nThe intersection is illustrated in the diagram below.\n\n![](images/97/971a65619088884002784f5abb3c4f3dc9b2e17e6b905f171b8106219a139557.png)\n\nTherefore, the domain of the vector-valued function $f(t)$ is $t\\in (0,\\infty ).$"} :step/id #uuid "3f69fac6-c791-5076-b0cb-1df861e3f01d" :step/next {:db/id #edb/ref 17592186411593}} {:db/id #edb/ref 17592186411593 :step/content {:db/id #edb/ref 17592186363458 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b740762-045e-5820-a736-1fe5651b59de" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in (-2,0)\\cup (0,\\infty )" :db/id #edb/ref 17592186363460} {:answer/id #uuid "a0f05f0a-6614-5d5d-9df5-da7e78375081" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in (-2,1]" :db/id #edb/ref 17592186363461} {:answer/id #uuid "43be1e1f-d373-53b1-afef-1ef4c39e04b0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in (-2,\\infty )" :db/id #edb/ref 17592186363462} {:answer/id #uuid "aef37efd-8619-5880-9e33-8cc7399e16db" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in (-2,0)" :db/id #edb/ref 17592186363463} {:answer/id #uuid "3bcc0512-6302-5ee0-b419-66a663e9083e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in (-\\infty ,-2)\\cup (-2,1]" :db/id #edb/ref 17592186363464}] :answer-field/correct {:db/id #edb/ref 17592186363463} :answer-field/id #uuid "6e9a1fab-e156-581f-bef9-19ac8957daa2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186363459}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "7f5ab3ef-ae4b-58ea-a096-4f661af5c41f" :question/math-academy-id "q-162663" :question/problem "Find the domain of the vector-valued function $f(s)=\\sqrt{1-s}\\,i+\\operatorname{ln}⁡(s+2)\\,j+\\operatorname{ln}⁡(-s)\\,k.$" :question/worked-solution "To find the domain of $f,$ we need the intersection of the domains of the individual components.\n\n- The domain of $\\sqrt{1-s}$ is $s\\in (-\\infty ,1].$\n\n- The domain of $\\operatorname{ln}⁡(s+2)$ is $s\\in (-2,\\infty ).$\n\n- The domain of $\\operatorname{ln}⁡(-s)$ is $s\\in (-\\infty ,0).$\n\nThe intersection is illustrated in the diagram below.\n\n![](images/6a/6a2d170c22a544335735e859dd080d74964a4d5b5053789a557b5ea406f9d3a9.png)\n\nTherefore, the domain of the vector-valued function $f(s)$ is $s\\in (-2,0).$"} :step/id #uuid "649a877d-0747-58ab-aefc-0fc49ca6326f"} {:db/id #edb/ref 17592186411594 :step/content {:db/id #edb/ref 17592186281516 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5826ca19-6daa-5fae-a51f-ca9bd88aa67c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\pi n" :db/id #edb/ref 17592186279403} {:answer/id #uuid "5f4eec8a-dc19-556b-aef1-89da49e75d6a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi n}{6}" :db/id #edb/ref 17592186279466} {:answer/id #uuid "b0252ebd-3528-5293-87d9-bd4c3a5eac03" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi n}{3}" :db/id #edb/ref 17592186280152} {:answer/id #uuid "c2dc73e9-c351-5c0a-b627-1ba7b9ce1e18" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{3}+\\pi n" :db/id #edb/ref 17592186280303} {:answer/id #uuid "d106d3f2-6dbf-539d-b0e1-363e4e8caf2b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{6}+\\frac{\\pi n}{3}" :db/id #edb/ref 17592186280434}] :answer-field/correct {:db/id #edb/ref 17592186280152} :answer-field/id #uuid "e58ed6b3-82ba-5b40-8a75-2b63a00c7ed1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186281236}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9d16926a-5957-5fb2-9fde-8f7ccb3e0a44" :question/math-academy-id "q-162650" :question/problem "The domain of the vector-valued function $f(t)=(1-\\operatorname{csc}⁡(3t))\\,i+3t\\,j+(2-{t}^{2})\\,k$ is \n\n$$\nt\\in (-\\infty ,\\infty ),\\,t\\ne .\n$$\n\nWhat is the missing expression? You may assume that $n$ is an integer." :question/worked-solution "To find the domain of $f$, we need the intersection of the domains of the individual components.\n\n- The domain of the 1st component $1-\\operatorname{csc}⁡(3t)$ is $t\\in (-\\infty ,\\infty ),$ except for the values of $t$ for which\n\n$$\n3t=\\pi n\\,⟹\\,t=\\frac{\\pi n}{3},\n$$\n\nwhere $n$ is an integer.\n\n- The domain of the 2nd component $3t$ is $t\\in (-\\infty ,\\infty ).$\n\n- The domain of the 3rd component $2-{t}^{2}$ is $t\\in (-\\infty ,\\infty ).$\n\nTherefore, the domain of the vector-valued function $f(t)$ is \n\n$$\nt\\in (-\\infty ,\\infty ),\\,t\\ne \\frac{\\pi n}{3},\n$$\n\nwhere $n$ is an integer."} :step/id #uuid "70d11093-23ab-55b7-88e4-81ad27b59786" :step/next {:db/id #edb/ref 17592186411592}} {:db/id #edb/ref 17592186411595 :step/content {:db/id #edb/ref 17592186115510 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d4e7ea98-c99e-5e1a-b0a7-704c7552fe2b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{n\\pi }{2}" :db/id #edb/ref 17592186363420} {:answer/id #uuid "516f0376-d461-50f1-9446-88d42e4dd246" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "n\\pi " :db/id #edb/ref 17592186363421} {:answer/id #uuid "606a6900-ad5d-54ed-92c9-7c9c48c4ff11" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{2}+2n\\pi " :db/id #edb/ref 17592186363422} {:answer/id #uuid "df8725b2-1bdf-5492-bb7d-22cf79b754fb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186363423} {:answer/id #uuid "a6b51453-7d1a-5d7d-92fc-c5d50c4ca073" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{2}+n\\pi " :db/id #edb/ref 17592186363424}] :answer-field/correct {:db/id #edb/ref 17592186363424} :answer-field/id #uuid "669d7279-38d4-5150-94a0-6a97a679c0f2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186363419}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b7cf4d71-17d1-5d39-bf9c-739bde65f8a8" :question/math-academy-id "q-160767" :question/problem "The domain of the vector-valued function $f(t)=\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j+\\operatorname{tan}⁡t\\,k$ is \n\n$$\nt\\in (-\\infty ,\\infty ),\\,t\\ne .\n$$\n\nWhat is the missing expression? You may assume that $n$ is an integer." :question/worked-solution "To find the domain of $f$, we need the intersection of the domains of the individual components.\n\n- The domain of the 1st component $\\operatorname{sin}⁡t$ is $t\\in (-\\infty ,\\infty ).$\n\n- The domain of the 2nd component $\\operatorname{cos}⁡t$ is $t\\in (-\\infty ,\\infty ).$\n\n- The domain of the 3rd component $\\operatorname{tan}⁡t$ is $t\\in (-\\infty ,\\infty )$, $t\\ne \\frac{\\pi }{2}+n\\pi ,$ where $n$ is an integer.\n\nTherefore, the domain of the vector-valued function $f(t)$ is \n\n$$\nt\\in (-\\infty ,\\infty ),\\,t\\ne \\frac{\\pi }{2}+n\\pi ,\n$$\n\nwhere $n$ is an integer."} :step/id #uuid "afc5168b-5251-58d8-8fc1-8965074ea6cd" :step/next {:db/id #edb/ref 17592186411591}}] :activity/title "The Domain of a Vector-Valued Function" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186411590}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186420096} :activity/id #uuid "d63840d2-3609-5c32-bdc9-4fe9ce0a42cd" :activity/scope {:db/id #edb/ref 17592186049186 :topic/id #uuid "e1c10e80-3811-5fcd-98a3-8118c49347e4" :topic/math-academy-id 1737} :activity/steps [{:db/id #edb/ref 17592186420094 :step/content {:db/id #edb/ref 17592186420093 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "54811e57-5329-5901-9031-55945bdb3aaf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{4}+\\pi n" :db/id #edb/ref 17592186420082} {:answer/id #uuid "656b42d3-126c-5abb-9880-9e0fc6a9e621" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{2}+2\\pi n" :db/id #edb/ref 17592186420083} {:answer/id #uuid "6d5d9399-1eaf-57c4-b24e-dd1b89bcd1e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi n}{4}" :db/id #edb/ref 17592186420085} {:answer/id #uuid "976cc8f2-04f3-53c2-a86c-c645ed2fbec5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi n}{2}" :db/id #edb/ref 17592186420087} {:answer/id #uuid "da650f9b-762e-5944-b6e9-28cdf4865151" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{4}+\\frac{\\pi n}{2}" :db/id #edb/ref 17592186420089}] :answer-field/correct {:db/id #edb/ref 17592186420082} :answer-field/id #uuid "02673689-46fa-584e-88ff-1a1c967a1b0b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186420091}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b8302ddf-29cf-570b-b7dd-dab545b3b824" :question/math-academy-id "q-162647" :question/problem "The domain of the vector-valued function $f(t)=\\operatorname{sec}⁡(t+\\frac{\\pi }{4})\\,i+{e}^{t-1}\\,j+{t}^{2}\\,k$ is \n\n$$\nt\\in (-\\infty ,\\infty ),\\,t\\ne .\n$$\n\nWhat is the missing expression? You may assume that $n$ is an integer." :question/worked-solution "To find the domain of $f$, we need the intersection of the domains of the individual components.\n\n- The domain of the 1st component $\\operatorname{sec}⁡(t+\\frac{\\pi }{4})$ is $t\\in (-\\infty ,\\infty ),$ except for the values of $t$ for which\n\n$$\nt+\\frac{\\pi }{4}=\\frac{\\pi }{2}+\\pi n\\,⟹\\,t=\\frac{\\pi }{4}+\\pi n,\n$$\n\nwhere $n$ is an integer.\n\n- The domain of the 2nd component ${e}^{t-1}$ is $t\\in (-\\infty ,\\infty ).$\n\n- The domain of the 3rd component ${t}^{2}$ is $t\\in (-\\infty ,\\infty ).$\n\nTherefore, the domain of the vector-valued function $f(t)$ is \n\n$$\nt\\in (-\\infty ,\\infty ),\\,t\\ne \\frac{\\pi }{4}+\\pi n,\n$$\n\nwhere $n$ is an integer."} :step/id #uuid "0dbe3293-2708-527b-b605-9fe12b6e37f9" :step/next {:db/id #edb/ref 17592186420098}} {:db/id #edb/ref 17592186420095 :step/content {:db/id #edb/ref 17592186420092 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1000e325-da05-5f3a-9e1d-24312518777d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t\\in (-1,0)\\cup (0,\\infty )" :db/id #edb/ref 17592186420080} {:answer/id #uuid "2478ad2d-b6eb-59d1-b76b-abe7a69ec247" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t\\in (-\\infty ,0)" :db/id #edb/ref 17592186420081} {:answer/id #uuid "691ebfd7-4000-5575-996f-d102ad66730b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t\\in (-1,\\infty )" :db/id #edb/ref 17592186420084} {:answer/id #uuid "94b764b3-edc6-585d-9049-19b093287871" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t\\in (-1,0)" :db/id #edb/ref 17592186420086} {:answer/id #uuid "b312f764-3451-5f4e-9cfb-871263b18b8d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t\\in (0,1)\\cup (1,\\infty )" :db/id #edb/ref 17592186420088}] :answer-field/correct {:db/id #edb/ref 17592186420080} :answer-field/id #uuid "02381afc-745d-58f1-8f0d-9b55ea92ca31" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186420090}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7a104075-f533-58ab-b79b-2a5e66b667e2" :question/math-academy-id "q-162660" :question/problem "Find the domain of the vector-valued function $f(t)=⟨{e}^{-t},\\,\\frac{1}{t},\\,\\operatorname{ln}⁡(t+1)⟩.$" :question/worked-solution "To find the domain of $f$, we need the intersection of the domains of the individual components.\n\n- The domain of the 1st component ${e}^{-t}$ is $t\\in (-\\infty ,\\infty ).$\n\n- The domain of the 2nd component $\\frac{1}{t}$ is $t\\in (-\\infty ,0)\\cup (0,\\infty ).$\n\n- The domain of the 3rd component $\\operatorname{ln}⁡(t+1)$ is $t\\in (-1,\\infty ).$\n\nThe intersection is illustrated in the diagram below.\n\n![](images/a5/a55ef2c927b26c9beba9b44f669c817cf749b79de163b4bf0505d15c6ec31630.png)\n\nTherefore, the domain of the vector-valued function $f(t)$ is $t\\in (-1,0)\\cup (0,\\infty ).$"} :step/id #uuid "69b7e384-7af7-55ae-bcb8-73eecb04e14a"} {:db/id #edb/ref 17592186420096 :step/content {:db/id #edb/ref 17592186115513 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "590ce956-fa57-52c8-b676-c7a081a32b28" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in (-1,1)" :db/id #edb/ref 17592186276280} {:answer/id #uuid "8d377bcc-370f-51f9-b994-f8649f51617b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in (-\\infty ,1)" :db/id #edb/ref 17592186276755} {:answer/id #uuid "928012b6-5d37-57e3-ab1c-585b2c67c370" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in (0,1)" :db/id #edb/ref 17592186276802} {:answer/id #uuid "c07039d3-aec7-5e92-9950-c14bc1351f86" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in (-1,0)" :db/id #edb/ref 17592186277186} {:answer/id #uuid "eee05247-e752-5968-abb0-796894121233" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in (-1,\\infty )" :db/id #edb/ref 17592186277576}] :answer-field/correct {:db/id #edb/ref 17592186276280} :answer-field/id #uuid "2c4c6d8a-57de-5558-ae04-0e3791190f90" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186277797}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "56023ec9-5ce1-5f4b-8f47-3c4d6d6b2dd7" :question/math-academy-id "q-160789" :question/problem "Find the domain of the vector-valued function $f(s)=⟨\\operatorname{ln}⁡(1+s),\\,\\operatorname{ln}⁡(1-s),\\,\\frac{1}{1+s}⟩.$" :question/worked-solution "To find the domain of $f$, we need the intersection of the domains of the individual components. \n\n- The domain of $\\operatorname{ln}⁡(1+s)$ is $s\\in (-1,\\infty )$ .\n\n- The domain of $\\operatorname{ln}⁡(1-s)$ is $s\\in (-\\infty ,1).$\n\n- The domain of $\\frac{1}{1+s}$ is  $s\\in (-\\infty ,-1)\\cup (-1,\\infty ).$\n\nThe intersection is illustrated in the diagram below.\n\n![](images/3a/3ac2933afc460e42ad5bffb8b01b9fc3ff9275ab3bcf2ac3ab710a8094b36637.png)\n\nTherefore, the domain of the vector-valued function $f(s)$ is\n\n$\\,$ $s\\in (-1,1).$"} :step/id #uuid "743b0666-1b94-5795-b0db-227efb4df31d" :step/next {:db/id #edb/ref 17592186420097}} {:db/id #edb/ref 17592186420097 :step/content {:db/id #edb/ref 17592186281514 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "138b2176-ecc6-57f2-bc6d-f1652a33636a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{6}+\\pi n" :db/id #edb/ref 17592186278767} {:answer/id #uuid "2444e896-56b2-5fe6-9c12-ded17b4df5eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{2}+\\frac{\\pi n}{3}" :db/id #edb/ref 17592186278916} {:answer/id #uuid "5fb99ab6-2b20-5f51-ac07-2107a5729fb6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{3}+\\frac{\\pi n}{2}" :db/id #edb/ref 17592186279469} {:answer/id #uuid "9484619f-2ead-592d-844c-a164a8fc5f1f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2\\pi n}{3}" :db/id #edb/ref 17592186279912} {:answer/id #uuid "d1436dab-1fe3-50c6-a9d0-651b17cd161f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi n}{6}" :db/id #edb/ref 17592186280437}] :answer-field/correct {:db/id #edb/ref 17592186278767} :answer-field/id #uuid "064586b1-f0a2-55e9-ab4f-1edb28541b5f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186280841}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "355588e1-74ab-5c1c-9491-56bf772d1b60" :question/math-academy-id "q-162645" :question/problem "The domain of the vector-valued function $f(t)={t}^{3}\\,i+\\operatorname{sec}⁡(t+\\frac{\\pi }{3})\\,j+\\sqrt{2{t}^{2}+1}\\,k$ is \n\n$$\nt\\in (-\\infty ,\\infty ),\\,t\\ne \\bbox[5pt,border:1pt solid black]{\\phantom{AAAAA}}.\n$$\n\nWhat is the missing expression? You may assume that $n$ is an integer." :question/worked-solution "To find the domain of $f$, we need the intersection of the domains of the individual components.\n\n- The domain of the 1st component ${t}^{3}$ is $t\\in (-\\infty ,\\infty ).$\n\n- The domain of the 2nd component $\\operatorname{sec}⁡(t+\\frac{\\pi }{3})$ is $t\\in (-\\infty ,\\infty ),$ except for the values of $t$ for which\n\n$$\nt+\\frac{\\pi }{3}=\\frac{\\pi }{2}+\\pi n\\,⟹\\,t=\\frac{\\pi }{6}+\\pi n,\n$$\n\nwhere $n$ is an integer.\n\n- The domain of the 3rd component $\\sqrt{2{t}^{2}+1}$ is $t\\in (-\\infty ,\\infty ).$\n\nTherefore, the domain of the vector-valued function $f(t)$ is \n\n$$\nt\\in (-\\infty ,\\infty ),\\,t\\ne \\frac{\\pi }{6}+\\pi n,\n$$\n\nwhere $n$ is an integer."} :step/id #uuid "85c58b22-fe0d-57c2-b692-2346cf29a3ec" :step/next {:db/id #edb/ref 17592186420094}} {:db/id #edb/ref 17592186420098 :step/content {:db/id #edb/ref 17592186281522 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "172da4c2-2750-5a8d-a86a-b97c9604fbad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in (1,2)" :db/id #edb/ref 17592186278799} {:answer/id #uuid "7684847d-5d27-5cac-b143-1ec0db86e152" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in [0,\\infty )" :db/id #edb/ref 17592186279647} {:answer/id #uuid "9ea5e2b2-027e-5a73-b7b3-004b4999d8bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in [0,2)\\cup (2,\\infty )" :db/id #edb/ref 17592186279999} {:answer/id #uuid "9fec719b-cb40-5f1c-9f1f-fe5c3833e5f9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in (-\\infty ,2)" :db/id #edb/ref 17592186280014} {:answer/id #uuid "f1ac898a-8049-5e2b-8b24-531f56c455b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in [0,2)" :db/id #edb/ref 17592186280697}] :answer-field/correct {:db/id #edb/ref 17592186280697} :answer-field/id #uuid "951bda09-c9a0-55cd-9b45-dcd0ac3017cf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186281101}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "86e56d87-8f7f-5aac-9c51-653244b0266e" :question/math-academy-id "q-162659" :question/problem "Find the domain of the vector-valued function $f(s)=⟨\\sqrt{s},\\,\\operatorname{ln}⁡(2-s),\\,\\sqrt{3}⟩.$" :question/worked-solution "To find the domain of $f$, we need the intersection of the domains of the individual components.\n\n- The domain of the 1st component $\\sqrt{s}$ is $s\\in [0,\\infty ).$\n\n- The domain of the 2nd component $\\operatorname{ln}⁡(2-s)$ is $s\\in (-\\infty ,2).$\n\n- The domain of the 3rd component $\\sqrt{3}$ is $s\\in (-\\infty ,\\infty ).$\n\nThe intersection is illustrated in the diagram below.\n\n![](images/80/808abeaa59d7bcea3b24e741fde5296791de32b4170d60f05f2a5af203c20ba2.png)\n\nTherefore, the domain of the vector-valued function $f(s)$ is $s\\in [0,2).$"} :step/id #uuid "e7ce2d54-5c14-540f-93a3-4a8f924d9288" :step/next {:db/id #edb/ref 17592186420095}}] :activity/title "The Domain of a Vector-Valued Function" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186420079}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186434609} :activity/id #uuid "a877ccc4-a857-576d-8fb3-5ca0090834d7" :activity/scope {:db/id #edb/ref 17592186049186 :topic/id #uuid "e1c10e80-3811-5fcd-98a3-8118c49347e4" :topic/math-academy-id 1737} :activity/steps [{:db/id #edb/ref 17592186434609 :step/content {:db/id #edb/ref 17592186434608 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6073d65a-c468-5d8e-889f-60c5cdb14578" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t\\in (-\\infty ,1)\\cup (1,2)" :db/id #edb/ref 17592186434602} {:answer/id #uuid "6a8722bb-9e6f-55ec-ab0e-abad8cdaebc2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t\\in (-1,1)" :db/id #edb/ref 17592186434603} {:answer/id #uuid "7057b034-c64c-5f7b-a593-a2b44e4f0f7a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t\\in (-\\infty ,-1)" :db/id #edb/ref 17592186434604} {:answer/id #uuid "bec2ac23-2bb3-5a04-b2f4-16915124308c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t\\in (-\\infty ,-1)\\cup (-1,1)" :db/id #edb/ref 17592186434605} {:answer/id #uuid "ea5be08c-d061-5bc5-a2e5-aad2e687d34f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t\\in (-\\infty ,2)" :db/id #edb/ref 17592186434606}] :answer-field/correct {:db/id #edb/ref 17592186434605} :answer-field/id #uuid "be942fb8-f73d-5f54-94c5-d09755cd0c13" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186434607}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7d25096e-7480-5615-8abf-2ab27b49c2cd" :question/math-academy-id "q-160770" :question/problem "Find the domain of the vector-valued function $f(t)=\\operatorname{ln}⁡(1-t)\\,i+\\frac{2}{1+t}\\,j+(2-t)\\,k.$" :question/worked-solution "To find the domain of $f$, we need the intersection of the domains of the individual components.\n\n- The domain of $\\operatorname{ln}⁡(1-t)$ is $t\\in (-\\infty ,1).$\n\n- The domain of $\\frac{2}{1+t}$ is $t\\in (-\\infty ,-1)\\cup (-1,\\infty ).$\n\n- The domain of $(2-t)$ is $t\\in (-\\infty ,\\infty ).$\n\nThe intersection is illustrated in the diagram below.\n\n![](images/4e/4e69cafc31992d97922f7074a5fc211edfca1efe5b4d61f70e946134d52052fb.png)\n\nTherefore, the domain of the vector-valued function $f(t)$ is $t\\in (-\\infty ,-1)\\cup (-1,1).$"} :step/id #uuid "5cc1f657-7b45-509a-a40c-65669163d0fd" :step/next {:db/id #edb/ref 17592186434613}} {:db/id #edb/ref 17592186434610 :step/content {:db/id #edb/ref 17592186281514 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "138b2176-ecc6-57f2-bc6d-f1652a33636a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{6}+\\pi n" :db/id #edb/ref 17592186278767} {:answer/id #uuid "2444e896-56b2-5fe6-9c12-ded17b4df5eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{2}+\\frac{\\pi n}{3}" :db/id #edb/ref 17592186278916} {:answer/id #uuid "5fb99ab6-2b20-5f51-ac07-2107a5729fb6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{3}+\\frac{\\pi n}{2}" :db/id #edb/ref 17592186279469} {:answer/id #uuid "9484619f-2ead-592d-844c-a164a8fc5f1f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2\\pi n}{3}" :db/id #edb/ref 17592186279912} {:answer/id #uuid "d1436dab-1fe3-50c6-a9d0-651b17cd161f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi n}{6}" :db/id #edb/ref 17592186280437}] :answer-field/correct {:db/id #edb/ref 17592186278767} :answer-field/id #uuid "064586b1-f0a2-55e9-ab4f-1edb28541b5f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186280841}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "355588e1-74ab-5c1c-9491-56bf772d1b60" :question/math-academy-id "q-162645" :question/problem "The domain of the vector-valued function $f(t)={t}^{3}\\,i+\\operatorname{sec}⁡(t+\\frac{\\pi }{3})\\,j+\\sqrt{2{t}^{2}+1}\\,k$ is \n\n$$\nt\\in (-\\infty ,\\infty ),\\,t\\ne \\bbox[5pt,border:1pt solid black]{\\phantom{AAAAA}}.\n$$\n\nWhat is the missing expression? You may assume that $n$ is an integer." :question/worked-solution "To find the domain of $f$, we need the intersection of the domains of the individual components.\n\n- The domain of the 1st component ${t}^{3}$ is $t\\in (-\\infty ,\\infty ).$\n\n- The domain of the 2nd component $\\operatorname{sec}⁡(t+\\frac{\\pi }{3})$ is $t\\in (-\\infty ,\\infty ),$ except for the values of $t$ for which\n\n$$\nt+\\frac{\\pi }{3}=\\frac{\\pi }{2}+\\pi n\\,⟹\\,t=\\frac{\\pi }{6}+\\pi n,\n$$\n\nwhere $n$ is an integer.\n\n- The domain of the 3rd component $\\sqrt{2{t}^{2}+1}$ is $t\\in (-\\infty ,\\infty ).$\n\nTherefore, the domain of the vector-valued function $f(t)$ is \n\n$$\nt\\in (-\\infty ,\\infty ),\\,t\\ne \\frac{\\pi }{6}+\\pi n,\n$$\n\nwhere $n$ is an integer."} :step/id #uuid "6d974a30-5451-563e-af63-d68f97380132" :step/next {:db/id #edb/ref 17592186434611}} {:db/id #edb/ref 17592186434611 :step/content {:db/id #edb/ref 17592186281520 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d3e7eb8-45ba-5620-af85-ac5459d2a94c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in (-\\infty ,2)" :db/id #edb/ref 17592186278861} {:answer/id #uuid "5a2158ce-c480-54c2-8ea8-acecce6dfc8a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in (-2,0)\\cup (0,2)" :db/id #edb/ref 17592186279418} {:answer/id #uuid "71d38630-309a-5223-824d-664f60203b0d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in (-\\infty ,-2)" :db/id #edb/ref 17592186279626} {:answer/id #uuid "c363e0ef-c9c8-5006-b261-de03549e33b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in (-2,0)\\cup (0,\\infty )" :db/id #edb/ref 17592186280310} {:answer/id #uuid "fbe76885-9ce8-5403-9f7c-698744d8b32f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in (-2,\\infty )" :db/id #edb/ref 17592186280798}] :answer-field/correct {:db/id #edb/ref 17592186280310} :answer-field/id #uuid "5a212da2-a5f2-57a1-8e82-96959276aaf8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186280987}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0197513a-e58d-59e7-b31b-641cf93f0c11" :question/math-academy-id "q-162657" :question/problem "Find the domain of the vector-valued function $f(s)=\\operatorname{ln}⁡(s+2)\\,i+{e}^{2s}\\,j+\\frac{3}{{s}^{2}}\\,k.$" :question/worked-solution "To find the domain of $f$, we need the intersection of the domains of the individual components.\n\n- The domain of the 1st component $\\operatorname{ln}⁡(s+2)$ is $s\\in (-2,\\infty ).$\n\n- The domain of the 2nd component ${e}^{2s}$ is $s\\in (-\\infty ,\\infty ).$\n\n- The domain of the 3rd component $\\frac{3}{{s}^{2}}$ is $s\\in (-\\infty ,0)\\cup (0,\\infty ).$\n\nThe intersection is illustrated in the diagram below.\n\n![](images/7a/7aacfa509e2e642fd90ef989e4dec3a2f9f5ad1e8def55f894b88d97bcabb971.png)\n\nTherefore, the domain of the vector-valued function $f(s)$ is $s\\in (-2,0)\\cup (0,\\infty ).$"} :step/id #uuid "8fb273d6-8594-5f60-8d7f-4364fd17bdf4" :step/next {:db/id #edb/ref 17592186434612}} {:db/id #edb/ref 17592186434612 :step/content {:db/id #edb/ref 17592186281523 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d70cc6b-bd49-5fad-80dd-107c44a59a26" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in (1,2)" :db/id #edb/ref 17592186278991} {:answer/id #uuid "39fdb5cd-6cc3-529f-b505-53703b5e20d0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in (-\\infty ,1)\\cup (1,\\infty )" :db/id #edb/ref 17592186279104} {:answer/id #uuid "4e468aef-35d1-5ca8-9435-b946edd08ff7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in (2,\\infty )" :db/id #edb/ref 17592186279302} {:answer/id #uuid "7d3e9b8a-bee0-59ae-acb6-e94db4a1db28" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in (1,2)\\cup (2,\\infty )" :db/id #edb/ref 17592186279711} {:answer/id #uuid "91a8bb4c-3e02-54c8-ba2f-ada2f9a6fe60" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in (0,\\infty )" :db/id #edb/ref 17592186279890}] :answer-field/correct {:db/id #edb/ref 17592186279302} :answer-field/id #uuid "7b67c2d1-20af-5e46-8732-2ab3a65c3c67" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186281058}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "7c1f4ba8-733f-52ec-ba54-2cc86581e097" :question/math-academy-id "q-162661" :question/problem "Find the domain of the vector-valued function $f(s)=⟨\\frac{1}{s-1},\\,\\operatorname{ln}⁡s,\\,\\operatorname{ln}⁡(s-2)⟩.$" :question/worked-solution "To find the domain of $f$, we need the intersection of the domains of the individual components. \n\n- The domain of $\\frac{1}{s-1}$ is $s\\in (-\\infty ,1)\\cup (1,\\infty ).$\n\n- The domain of $\\operatorname{ln}⁡s$ is $s\\in (0,\\infty ).$\n\n- The domain of $\\operatorname{ln}⁡(s-2)$ is  $s\\in (2,\\infty ).$\n\nThe intersection is illustrated in the diagram below.\n\n![](images/ac/ac5fed5129673869c7b9e0da3bd46f224aedbfda11b3a26e507b533d66c4e4e9.png)\n\nTherefore, the domain of the vector-valued function $f(s)$ is $s\\in (2,\\infty ).$"} :step/id #uuid "ab7de720-165e-5d5d-a64a-1a64ae913cfe"} {:db/id #edb/ref 17592186434613 :step/content {:db/id #edb/ref 17592186281512 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11188107-8128-5947-9d14-6b2ff56a2513" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186278748} {:answer/id #uuid "792a4a98-c522-5228-85fc-5aac6d5cff61" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{n\\pi }{2}" :db/id #edb/ref 17592186279673} {:answer/id #uuid "bffccb23-963c-523b-b10b-709940b33bf2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2n\\pi " :db/id #edb/ref 17592186280281} {:answer/id #uuid "cdf765d7-ed5e-524a-a27b-5d8678c4f142" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "n\\pi " :db/id #edb/ref 17592186280409} {:answer/id #uuid "f639275c-6781-5bf6-8ee3-3e36faf90d6b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{2}+n\\pi " :db/id #edb/ref 17592186280749}] :answer-field/correct {:db/id #edb/ref 17592186280409} :answer-field/id #uuid "5306462d-65c3-5c3f-b61d-973703c8ad19" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186280970}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "540767cb-cd6f-5ce4-bc0f-7ec2c2e165a4" :question/math-academy-id "q-162636" :question/problem "The domain of the vector-valued function $f(t)=\\operatorname{cot}⁡t\\,i+(t+1)^{2}\\,j+\\operatorname{cos}⁡t\\,k$ is \n\n$$\nt\\in (-\\infty ,\\infty ),\\,t\\ne \\bbox[5pt,border:1pt solid black]{\\phantom{AAAAA}}.\n$$\n\nWhat is the missing expression? You may assume that $n$ is an integer." :question/worked-solution "To find the domain of $f$, we need the intersection of the domains of the individual components.\n\n- The domain of the 1st component $\\operatorname{cot}⁡t$ is $t\\in (-\\infty ,\\infty )$, $t\\ne n\\pi ,$ where $n$ is an integer.\n\n- The domain of the 2nd component $(t+1)^{2}$ is $t\\in (-\\infty ,\\infty ).$\n\n- The domain of the 3rd component $\\operatorname{cos}⁡t$ is $t\\in (-\\infty ,\\infty ).$\n\nTherefore, the domain of the vector-valued function $f(t)$ is \n\n$$\nt\\in (-\\infty ,\\infty ),\\,t\\ne n\\pi ,\n$$\n\nwhere $n$ is an integer."} :step/id #uuid "d102d3e6-4a8f-5810-a213-fcf495285bef" :step/next {:db/id #edb/ref 17592186434610}}] :activity/title "The Domain of a Vector-Valued Function" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186434601}] [{:activity/expected-seconds 660.0 :activity/first-step {:db/id #edb/ref 17592186120897} :activity/id #uuid "4a64e93c-7c38-5a2c-bcd0-c1efea32558e" :activity/scope {:db/id #edb/ref 17592186050308 :topic/id #uuid "3ec7e468-923a-5188-be34-311799abe7bd" :topic/math-academy-id 1806} :activity/steps [{:db/id #edb/ref 17592186120897 :step/content {:db/id #edb/ref 17592186121051 :tutorial/content "Any plane can be uniquely determined by a point and two non-parallel direction vectors. For example, let $\\Pi$ be the plane that passes through the point $P(1,0,2)$ and is parallel to the vectors $\\mathbf{b}= \\langle 0,3,0 \\rangle$  and $\\mathbf{c}= \\langle -1,1,1 \\rangle.$\n\n![](images/ea/ea4ce822abec2b68d2471a2787f4e045493ca43c1c6795a7e0069de80cb5adee.png)\n\nUsing the vectors $\\mathbf{b}$ and $\\mathbf{c},$ we can construct a **parametric equation** of the plane.\n\nFirst, let $R$ be any general point in the plane, with position vector $\\mathbf{r}.$ Notice that we can get from $P$ to $R$ using a linear combination of $\\mathbf{b}$ and $\\mathbf{c}$ with some (unknown for us) coefficients $s$ and $t$, as shown below.\n\n![](images/b4/b40f91c3d75f092c7b29f19770364e7518d37b64ba594a311a762ad79a950e4f.png)\n\nSo, we can write the **parametric equation** of the plane as\n\n$$\n{\\color{red}\\mathbf{r}} = \\mathbf{p}+s{\\color{blue}\\,\\mathbf{b}}+t\\,{\\color{blue}\\mathbf{c}},\n\t\\qquad s,t \\in (-\\infty,\\infty).\n$$\n\nThis formula works whenever $\\mathbf{b}$ and $\\mathbf{c}$ are not parallel.\n\nIn our case, $\\mathbf{b}$ and $\\mathbf{c}$ are indeed not parallel to each other. So, using column vector notation, the parametric equation for the plane $\\Pi$ is given by\n![](images/0d/0d40f8f87e1ed3f3bf5040e925e545169f5528f32cf8dd0052375aa560cc1381.svg)" :tutorial/id #uuid "2828346e-3bca-51a8-a6ef-a86ca7034a62" :tutorial/math-academy-id 3257 :tutorial/title "Introduction"} :step/id #uuid "9e58d46a-ae91-5ee2-88e7-83dddd91cd81" :step/math-academy-id 421992 :step/next {:db/id #edb/ref 17592186120898}} {:db/id #edb/ref 17592186120898 :step/content {:db/id #edb/ref 17592186119933 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119647 :question/id #uuid "a6fded96-287a-53ee-8b1c-dd618562b2c2" :question/math-academy-id "e-4940"} :knowledge-point/id #uuid "b02f02f1-f270-55e0-a7a9-0b729c4d82c0" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049485}] :knowledge-point/questions [{:db/id #edb/ref 17592186120234} {:db/id #edb/ref 17592186120235} {:db/id #edb/ref 17592186262902} {:db/id #edb/ref 17592186262903} {:db/id #edb/ref 17592186262904} {:db/id #edb/ref 17592186304903} {:db/id #edb/ref 17592186338858} {:db/id #edb/ref 17592186338859} {:db/id #edb/ref 17592186338860} {:db/id #edb/ref 17592186338861} {:db/id #edb/ref 17592186410898} {:db/id #edb/ref 17592186410901} {:db/id #edb/ref 17592186410902}] :knowledge-point/title "Finding the Parametric Equation of the Plane Parallel To Two Given Vectors"} :step/id #uuid "9f747cb6-7704-53df-bc68-9a201f538aa3" :step/math-academy-id 421993 :step/next {:db/id #edb/ref 17592186120899}} {:db/id #edb/ref 17592186120899 :step/content {:db/id #edb/ref 17592186119934 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119664 :question/id #uuid "b86eace4-01cb-5601-8e9b-2658e81fc656" :question/math-academy-id "e-5884"} :knowledge-point/id #uuid "62196ae9-df2e-5a3a-bc0a-1c0f4c40af3e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049132}] :knowledge-point/questions [{:db/id #edb/ref 17592186120277} {:db/id #edb/ref 17592186120278} {:db/id #edb/ref 17592186262915} {:db/id #edb/ref 17592186262916} {:db/id #edb/ref 17592186311921} {:db/id #edb/ref 17592186311922} {:db/id #edb/ref 17592186311923} {:db/id #edb/ref 17592186338862} {:db/id #edb/ref 17592186338863} {:db/id #edb/ref 17592186391682} {:db/id #edb/ref 17592186410899} {:db/id #edb/ref 17592186429817}] :knowledge-point/title "Finding a Normal Vector To a Plane Given by Parametric Equation"} :step/id #uuid "aa340a23-a5f7-53c0-a279-cfaa2cb34f68" :step/math-academy-id 421996 :step/next {:db/id #edb/ref 17592186120900}} {:db/id #edb/ref 17592186120900 :step/content {:db/id #edb/ref 17592186119935 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119648 :question/id #uuid "297bda8f-6e33-5cc2-a2e1-5ab6186fa9d0" :question/math-academy-id "e-4941"} :knowledge-point/id #uuid "3061cb06-f57f-57c8-8821-dbd962b1e78e" :knowledge-point/questions [{:db/id #edb/ref 17592186120225} {:db/id #edb/ref 17592186120236} {:db/id #edb/ref 17592186262922} {:db/id #edb/ref 17592186338864} {:db/id #edb/ref 17592186338865} {:db/id #edb/ref 17592186338866} {:db/id #edb/ref 17592186364961} {:db/id #edb/ref 17592186387887} {:db/id #edb/ref 17592186393057} {:db/id #edb/ref 17592186398347}] :knowledge-point/title "Finding the Parametric Equation of the Plane Parallel To Two Lines"} :step/id #uuid "0b7d4f28-8841-5518-ad36-74e1aa0d9163" :step/math-academy-id 421999 :step/next {:db/id #edb/ref 17592186120901}} {:db/id #edb/ref 17592186120901 :step/content {:db/id #edb/ref 17592186121052 :tutorial/content "Any plane can be uniquely determined by three non-collinear points. \n\n![](images/08/08e65c4e3465a4bf155dfed6bc0dc2a35bf2eb9326d9bff0c0aa75b86e97d76b.png)\n\nTo write down a parametric equation of the plane, the trick is to use the three non-collinear points to construct two displacement vectors that are parallel to the plane.\n\n![](images/16/1613ea9df76b637b93e0e4b38b70b87892140398eaa7aaccb74f2a5642124dfd.png)\n\nThen we can proceed as usual to find the equation of the plane. Let's practice this technique in the following example." :tutorial/id #uuid "e32f2dc4-38f6-541d-9dc6-9cfd1ac079eb" :tutorial/math-academy-id 3258 :tutorial/title "Finding the Equation of a Plane Passing Through Three Points"} :step/id #uuid "43769a60-5b42-5a2c-82fa-0054a159b437" :step/math-academy-id 422002 :step/next {:db/id #edb/ref 17592186120902}} {:db/id #edb/ref 17592186120902 :step/content {:db/id #edb/ref 17592186119936 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119649 :question/id #uuid "9c36ddd5-fcf1-5c4d-a350-aa8ef3a3ca9e" :question/math-academy-id "e-4942"} :knowledge-point/id #uuid "d11f13f0-1cfa-59ec-a04a-9483d942b1aa" :knowledge-point/questions [{:db/id #edb/ref 17592186120218} {:db/id #edb/ref 17592186120219} {:db/id #edb/ref 17592186262927} {:db/id #edb/ref 17592186262928} {:db/id #edb/ref 17592186262929} {:db/id #edb/ref 17592186304926} {:db/id #edb/ref 17592186338879} {:db/id #edb/ref 17592186338881} {:db/id #edb/ref 17592186366205} {:db/id #edb/ref 17592186387957} {:db/id #edb/ref 17592186387964} {:db/id #edb/ref 17592186393064} {:db/id #edb/ref 17592186410900} {:db/id #edb/ref 17592186429941}] :knowledge-point/title "Finding the Parametric Equation of the Plane Passing Through Three Given Points"} :step/id #uuid "a2d3f79a-dc28-5d90-9d1f-404334ec9529" :step/math-academy-id 422003}] :activity/title "The Parametric Equations of a Plane" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186120017}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186423364} :activity/id #uuid "3089dbbe-cc2f-5f60-8b4c-786b3272c8cf" :activity/scope {:db/id #edb/ref 17592186050308 :topic/id #uuid "3ec7e468-923a-5188-be34-311799abe7bd" :topic/math-academy-id 1806} :activity/steps [{:db/id #edb/ref 17592186423364 :step/content {:db/id #edb/ref 17592186120225 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bd010f61-f497-566f-ac0f-c50c695f2870" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The plane is undefined" :db/id #edb/ref 17592186390876} {:answer/id #uuid "e4fe09e5-ac83-5e62-97ff-7cc91f6b67c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨0,6,2⟩+s⟨3,2,5⟩+t⟨6,-5,10⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186390877} {:answer/id #uuid "5b991d71-53b1-55cf-8e90-ebe111f71f38" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨5,-3,1⟩+s⟨8,1,0⟩+t⟨0,6,2⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186390878} {:answer/id #uuid "c86fee90-6ade-5c0b-9714-4278894c742b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨5,-3,1⟩+s⟨8,1,0⟩+t⟨6,-5,10⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186390879} {:answer/id #uuid "db01346f-8d56-5827-aa82-3725170f51a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨5,-3,1⟩+s⟨3,2,5⟩+t⟨0,6,2⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186390880}] :answer-field/correct {:db/id #edb/ref 17592186390880} :answer-field/id #uuid "cf886e4d-3534-5b42-92f4-88d2e9d1dbe7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186390875}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0602f3f6-acc2-53ef-a72e-b71caa5d5289" :question/math-academy-id "q-33066" :question/problem "Find a parametric equation of the plane that passes through the point $A(5,-3,1)$ and is parallel to the lines $r=⟨8,1,0⟩+s⟨3,2,5⟩$ and $r=⟨6,-5,10⟩+t⟨0,6,2⟩.$" :question/worked-solution "The direction vectors of the lines are ${v}_{1}=⟨3,2,5⟩$ and ${v}_{2}=⟨0,6,2⟩$, respectively. These vectors are parallel to the plane but not to each other.\n\nWe also know that the point $A(5,-3,1)$ lies on the plane and its position vector is $a=⟨5,-3,1⟩.$  \n\nSo, the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =a+s{v}_{1}+t{v}_{2} \\\\ r & =⟨5,-3,1⟩+s⟨3,2,5⟩+t⟨0,6,2⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"} :step/id #uuid "2f9f2ed5-353f-52bf-a2a3-853d4a9582d6" :step/next {:db/id #edb/ref 17592186423365}} {:db/id #edb/ref 17592186423365 :step/content {:db/id #edb/ref 17592186338862 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "027279ba-c86b-5b53-9b4f-d91a6c95b4d9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨1,2,-1⟩" :db/id #edb/ref 17592186336052} {:answer/id #uuid "2b335037-3eda-5eb1-a665-40e27aacca2d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-5,3,1⟩" :db/id #edb/ref 17592186336439} {:answer/id #uuid "3cc9ad4f-0956-53af-9375-a4dc1247e499" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-5,3,0⟩" :db/id #edb/ref 17592186336605} {:answer/id #uuid "924674c9-4ac4-5fac-bce9-febfcdbeeeee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨7,-3,1⟩" :db/id #edb/ref 17592186337359} {:answer/id #uuid "faf5ff12-8cff-5606-9806-8c51dfe352b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨0,-1,3⟩" :db/id #edb/ref 17592186338232}] :answer-field/correct {:db/id #edb/ref 17592186336439} :answer-field/id #uuid "0006422d-58d9-51c7-8d8f-f4fd7450f036" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186338278}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b2e1c378-a183-516b-92fd-1753dcbc375f" :question/math-academy-id "q-70972" :question/problem "Find a normal vector to the plane\n\n$$\nr=[\\begin{aligned}\\frac{1}{2} \\\\ -1 \\\\ 13\\end{aligned}]+t[\\begin{aligned}0 \\\\ -1 \\\\ 3\\end{aligned}]+s[\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}],\\,t,\\,s\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "From the parametric equation, we have that $v=⟨0,-1,3⟩$ and $w=⟨1,2,-1⟩$ are parallel to the plane.\n\nNow, we need to find a normal vector of the plane. To do that, we use the cross product of $v$ and $w$ as follows:\n\n$$\n\\begin{aligned}n & =v\\times w \\\\  & =[\\begin{aligned}0 \\\\ -1 \\\\ 3\\end{aligned}]\\times [\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}] \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 0 & -1 & 3 \\\\ 1 & 2 & -1\\end{aligned}\\right| \\\\  & =-5i+3j+k \\\\  & =⟨-5,3,1⟩.\\end{aligned}\n$$\n\nTherefore, a normal vector to the plane is $n=⟨-5,3,1⟩.$"} :step/id #uuid "43654397-35b1-5e26-a4f3-f83c5d045414" :step/next {:db/id #edb/ref 17592186423366}} {:db/id #edb/ref 17592186423366 :step/content {:db/id #edb/ref 17592186338865 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7586c1e4-84f3-5128-898b-c5e464276c0d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨6,2,1⟩+s⟨4,-1,5⟩+t⟨0,2,3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186337090} {:answer/id #uuid "82d1d2de-9e64-5f24-9d44-872a4f4b17ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨4,-1,5⟩+s⟨6,2,1⟩+t⟨0,2,3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186337221} {:answer/id #uuid "85ed694c-09f9-5528-8f94-aa3dcea698e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨0,2,3⟩+s⟨4,-1,5⟩+t⟨6,2,1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186337243} {:answer/id #uuid "9294f976-ff7c-58c2-93a2-681c99675cba" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The plane is undefined" :db/id #edb/ref 17592186337366} {:answer/id #uuid "d0355145-d653-5b7e-b879-a79de4840c7a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨6,2,1⟩+s⟨\\frac{1}{2},1,9⟩+t⟨3,10,-1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186337854}] :answer-field/correct {:db/id #edb/ref 17592186337090} :answer-field/id #uuid "cb6f8717-8af1-5d47-bcaf-6f6357145f42" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186338642}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "63af645f-746e-5e92-b7a0-0217edd376c0" :question/math-academy-id "q-70977" :question/problem "Find a parametric equation of the plane that passes through the point $D(6,2,1)$ and is parallel to the lines $r=⟨\\frac{1}{2},1,9⟩+s⟨4,-1,5⟩$ and $r=⟨\\sqrt{3},10,-1⟩+t⟨0,2,3⟩.$" :question/worked-solution "The direction vectors of the lines are ${v}_{1}=⟨4,-1,5⟩$ and ${v}_{2}=⟨0,2,3⟩$, respectively. These vectors are parallel to the plane but not to each other.\n\nWe also know that the point $D(6,2,1)$ lies on the plane and its position vector is $d=⟨6,2,1⟩.$  \n\nSo, the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =d+s{v}_{1}+t{v}_{2} \\\\ r & =⟨6,2,1⟩+s⟨4,-1,5⟩+t⟨0,2,3⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"} :step/id #uuid "f22fda97-7410-513e-bdd3-694b01fc4928"}] :activity/title "The Parametric Equations of a Plane" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186423363}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186429946} :activity/id #uuid "f1f3e620-4475-5a3a-a265-6ab29906aca2" :activity/scope {:db/id #edb/ref 17592186050308 :topic/id #uuid "3ec7e468-923a-5188-be34-311799abe7bd" :topic/math-academy-id 1806} :activity/steps [{:db/id #edb/ref 17592186429942 :step/content {:db/id #edb/ref 17592186393057 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "840901d2-388a-56b4-b2ed-4aa835792fb2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨2,1,-\\frac{1}{5}⟩+s⟨-3,0,1⟩+t⟨-3,2,7⟩,\\,s,t\\in (-\\infty ,\\infty )." :db/id #edb/ref 17592186393059} {:answer/id #uuid "3a999e63-69bc-5b5b-ba4a-b3d5b35bdaf5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨-3,2,7⟩+s⟨-3,0,1⟩+t⟨2,1,-\\frac{1}{5}⟩,\\,s,t\\in (-\\infty ,\\infty )." :db/id #edb/ref 17592186393060} {:answer/id #uuid "a9567360-7eeb-5790-a68a-54789a38c8f2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The plane is undefined" :db/id #edb/ref 17592186393061} {:answer/id #uuid "0abc7499-ef02-5049-b4d5-92446ade1dde" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨-3,2,7⟩+s⟨3,-1,20⟩+t⟨0,3,-4⟩,\\,s,t\\in (-\\infty ,\\infty )." :db/id #edb/ref 17592186393062} {:answer/id #uuid "d56ba868-cc5e-5eb8-8190-756b44636c16" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨-3,0,1⟩+s⟨-3,2,7⟩+t⟨2,1,-\\frac{1}{5}⟩,\\,s,t\\in (-\\infty ,\\infty )." :db/id #edb/ref 17592186393063}] :answer-field/correct {:db/id #edb/ref 17592186393060} :answer-field/id #uuid "74bd7e12-82f3-5b83-88f9-1acb2c12ad74" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186393058}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a1e3ae2d-0bf0-5679-8209-36898e366f4e" :question/math-academy-id "q-70981" :question/problem "Find a parametric equation of the plane that passes through the point $H(-3,2,7)$ and is parallel to the lines $r=⟨3,-1,20⟩+s⟨-3,0,1⟩$ and $r=⟨0,3,-4⟩+t⟨2,1,-\\frac{1}{5}⟩.$" :question/worked-solution "The direction vectors of the lines are ${v}_{1}=⟨-3,0,1⟩$ and ${v}_{2}=⟨2,1,-\\frac{1}{5}⟩$, respectively. These vectors are parallel to the plane but not to each other.\n\nWe also know that the point $H(-3,2,7)$ lies on the plane and its position vector is $h=⟨-3,2,7⟩.$  \n\nSo, the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =h+s{v}_{1}+t{v}_{2} \\\\ r & =⟨-3,2,7⟩+s⟨-3,0,1⟩+t⟨2,1,-\\frac{1}{5}⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"} :step/id #uuid "6962e54d-afff-5346-b8ad-2f0747169762" :step/next {:db/id #edb/ref 17592186429943}} {:db/id #edb/ref 17592186429943 :step/content {:db/id #edb/ref 17592186429941 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "076c0841-49e0-5efa-932b-cea12451f354" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨1,0,-2⟩+s⟨-2,-2,5⟩+t⟨-3,4,5⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186429935} {:answer/id #uuid "36f17219-1319-57b9-b736-3daca3fe9f64" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨1,0,-2⟩+s⟨-2,-2,5⟩+t⟨-2,4,3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186429936} {:answer/id #uuid "42182090-ca90-5aff-919b-f97f28d17f45" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨1,0,-2⟩+s⟨-3,-2,7⟩+t⟨-3,4,5⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186429937} {:answer/id #uuid "a639639c-9709-5ea4-b9d7-eed8e4f97ee2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The plane is undefined" :db/id #edb/ref 17592186429938} {:answer/id #uuid "dd4f3967-0094-5670-b34b-c4d617495978" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨1,0,-2⟩+s⟨-2,4,3⟩+t⟨-3,4,5⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186429939}] :answer-field/correct {:db/id #edb/ref 17592186429937} :answer-field/id #uuid "918bca49-2085-5b3c-9bbd-1ed60948277f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186429940}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e59ecbbf-3ac2-51fb-8da8-83763d787a9a" :question/math-academy-id "q-71033" :question/problem "Find a parametric equation of the plane that passes through the points $D(1,0,-2),\\,E(-2,-2,5)$, and $F(-2,4,3).$" :question/worked-solution "First, we need to find two vectors that are parallel to the plane (but not to each other). Let's use the displacement vectors $\\overset{\\to }{DE}$ and $\\overset{\\to }{DF},$ as follows:\n\n$$\n\\begin{aligned}\\overset{\\to }{DE} & =⟨-2,-2,5⟩-⟨1,0,-2⟩ \\\\  & =⟨-3,-2,7⟩ \\\\ \\overset{\\to }{DF} & =⟨-2,4,3⟩-⟨1,0,-2⟩ \\\\  & =⟨-3,4,5⟩\\end{aligned}\n$$\n\nNow, if we consider the position vector $d=⟨1,0,-2⟩$ of the point $D,$ then the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =d+s\\overset{\\to }{DE}+t\\overset{\\to }{DF} \\\\ r & =⟨1,0,-2⟩+s⟨-3,-2,7⟩+t⟨-3,4,5⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"} :step/id #uuid "80c6a6f7-a534-55d9-a6a9-83c73859670a" :step/next {:db/id #edb/ref 17592186429944}} {:db/id #edb/ref 17592186429944 :step/content {:db/id #edb/ref 17592186262916 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b4a3c41-2d3e-5406-a2cd-cbab49cb529e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨6,-4,-26⟩" :db/id #edb/ref 17592186260257} {:answer/id #uuid "63d710f5-99cb-53b4-8290-6299023ee722" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨8,-2,17⟩" :db/id #edb/ref 17592186260737} {:answer/id #uuid "95c11743-7580-55cc-a7f1-587f795b6ee6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-8,-2,-22⟩" :db/id #edb/ref 17592186261175} {:answer/id #uuid "9e1ed729-7d24-5fef-a919-3b87d20a7b2c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-8,2,-11⟩" :db/id #edb/ref 17592186261244} {:answer/id #uuid "da606c57-af3e-52fa-9552-99fdba561ef0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-2,-8,-7⟩" :db/id #edb/ref 17592186261803}] :answer-field/correct {:db/id #edb/ref 17592186261175} :answer-field/id #uuid "e859b94c-82b3-57fc-b159-f1a0791b5216" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186262532}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "58d7da64-39e5-5263-82e1-d46d43bc9c9d" :question/math-academy-id "q-128497" :question/problem "Find a normal vector to the plane\n\n$$\nr=⟨3,\\sqrt{7},-2⟩+t⟨-2,8,0⟩+s⟨3,-1,-1⟩,\\,t,\\,s\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "From the parametric equation, we have that $v=⟨-2,8,0⟩$ and $w=⟨3,-1,-1⟩$ are parallel to the plane.\n\nNow, we need to find a normal vector of the plane. To do that, we use the cross product of $v$ and $w$ as follows:\n\n$$\n\\begin{aligned}n & =v\\times w \\\\  & =[\\begin{aligned}-2 \\\\ 8 \\\\ 0\\end{aligned}]\\times [\\begin{aligned}3 \\\\ -1 \\\\ -1\\end{aligned}] \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ -2 & 8 & 0 \\\\ 3 & -1 & -1\\end{aligned}\\right| \\\\  & =-8i-2j-22k \\\\  & =⟨-8,-2,-22⟩.\\end{aligned}\n$$\n\nTherefore, a normal vector to the plane is $n=⟨-8,-2,-22⟩.$"} :step/id #uuid "87cee5fb-f33c-5202-a9b9-1f5b449bede4" :step/next {:db/id #edb/ref 17592186429945}} {:db/id #edb/ref 17592186429945 :step/content {:db/id #edb/ref 17592186262922 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "259294bf-42a6-5b1f-a914-2eeba4786e4b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨-3,12,-7⟩+s⟨1,3,-5⟩+t⟨1,6,5⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186260203} {:answer/id #uuid "3660d937-cc87-5a73-a31f-13375df8d401" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨-7,12,-3⟩+s⟨-5,3,1⟩+t⟨1,5,6⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186260360} {:answer/id #uuid "586437d1-d3c1-5c04-82a5-9e97897d0755" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨-7,-3,12⟩+s⟨-3,4,2⟩+t⟨1,5,5⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186260630} {:answer/id #uuid "5a80a400-edf2-5ed4-95ef-bc093dec6a28" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨-7,-3,12⟩+s⟨3,3,1⟩+t⟨1,5,7⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186260648} {:answer/id #uuid "a8a3a0fb-37c8-5001-bfec-42aa7883b3d8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨-7,12,-3⟩+s⟨-3,5,1⟩+t⟨1,6,5⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186261347}] :answer-field/correct {:db/id #edb/ref 17592186260360} :answer-field/id #uuid "991622fb-4bb5-597a-a633-df7720b54e4a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186262397}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "75465043-c7d7-54b7-b914-8b78a961bb97" :question/math-academy-id "q-128536" :question/problem "Find a parametric equation of the plane that passes through the point $B(-7,12,-3)$ and is parallel to the lines $r=⟨-7,2,4⟩+s⟨-5,3,1⟩$ and $r=⟨-22,17,13⟩+t⟨1,5,6⟩.$" :question/worked-solution "The direction vectors of the lines are ${v}_{1}=⟨-5,3,1⟩$ and ${v}_{2}=⟨1,5,6⟩$, respectively. These vectors are parallel to the plane but not to each other.\n\nWe also know that the point $B(-7,12,-3)$ lies on the plane and its position vector is $b=⟨-7,12,-3⟩.$  \n\nSo, the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =b+s{v}_{1}+t{v}_{2} \\\\ r & =⟨-7,12,-3⟩+s⟨-5,3,1⟩+t⟨1,5,6⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$\n\n$$\n\n$$"} :step/id #uuid "a96d0f38-f22e-54d6-9800-3b945209e167"} {:db/id #edb/ref 17592186429946 :step/content {:db/id #edb/ref 17592186391682 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23e02ac0-3e89-5c73-aee7-9f2de3148d7a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨0,2,-2⟩" :db/id #edb/ref 17592186391684} {:answer/id #uuid "8ffc566d-8d4c-53c3-af4b-b2d7a4d35946" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨1,1,0⟩" :db/id #edb/ref 17592186391685} {:answer/id #uuid "efc39529-4f0f-5e00-b796-0c632007c03e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-2,0,2⟩" :db/id #edb/ref 17592186391686} {:answer/id #uuid "f83846d5-42d7-540e-ad5c-05350b13e9fe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨0,-2,-2⟩" :db/id #edb/ref 17592186391687} {:answer/id #uuid "0693f405-c3d1-5022-a785-4b3d44119374" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-1,1,1⟩" :db/id #edb/ref 17592186391688}] :answer-field/correct {:db/id #edb/ref 17592186391684} :answer-field/id #uuid "8aebbae6-4b97-5e3f-9a17-15682100023d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186391683}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3b07ac22-3309-5bc0-ac4b-6e1be0e5a45e" :question/math-academy-id "q-33823" :question/problem "Find a normal vector to the plane\n\n$$\nr=⟨1,1,0⟩+t⟨-1,1,1⟩+s⟨0,2,2⟩,\\,t,\\,s\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "From the parametric equation, we have that $v=⟨-1,1,1⟩$ and $w=⟨0,2,2⟩$ are parallel to the plane.\n\nNow, we need to find a normal vector of the plane. To do that, we use the cross product of $v$ and $w$ as follows:\n\n$$\n\\begin{aligned}n & =v\\times w \\\\  & =[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}]\\times [\\begin{aligned}0 \\\\ 2 \\\\ 2\\end{aligned}] \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ -1 & 1 & 1 \\\\ 0 & 2 & 2\\end{aligned}\\right| \\\\  & =2j-2k \\\\  & =⟨0,2,-2⟩.\\end{aligned}\n$$\n\nTherefore, a normal vector to the plane is $n=⟨0,2,-2⟩.$"} :step/id #uuid "b87c320e-e438-5e5e-b4bc-c722b9da8264" :step/next {:db/id #edb/ref 17592186429942}}] :activity/title "The Parametric Equations of a Plane" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186429934}] [{:activity/expected-seconds 600.0 :activity/first-step {:db/id #edb/ref 17592186163156} :activity/id #uuid "4373edc4-1d40-5e9a-bfe9-ecc0845c2651" :activity/scope {:db/id #edb/ref 17592186050835 :topic/id #uuid "6a5936fb-0bab-5b84-a342-e13ec8019ebc" :topic/math-academy-id 3048} :activity/steps [{:db/id #edb/ref 17592186163156 :step/content {:db/id #edb/ref 17592186163365 :tutorial/content "Let $X$ and $Y$ be discrete random variables with supports $S_X$ and $S_Y,$ respectively. We say that $X$ and $Y$ are **independent** if, for all $x\\in S_X$ and $y\\in S_Y,$ we have \n\n$$\nP(X=x, Y=y)=P(X=x)\\cdot P(Y=y).\n$$\n\nMoreover, if $X$ and $Y$ have the joint probability mass function $f(x,y),$ and $f_X(x)$ and $f_Y(y)$ are the marginal mass functions of $X$ and $Y,$ respectively, then\n\n$$\nf(x, y) = f_X(x)\\cdot f_Y (y)\n$$\n\n \n\nfor all $x\\in S_X$ and $y\\in S_Y.$\n\nIf the random variables are not independent, they are **dependent**." :tutorial/id #uuid "ab3a2705-ec4d-5e72-b6dd-553e9cbb6884" :tutorial/math-academy-id 7746 :tutorial/title "Introduction"} :step/id #uuid "b566ab50-5b2d-5693-aaa2-b74aeb985d53" :step/math-academy-id 44847 :step/next {:db/id #edb/ref 17592186163159}} {:db/id #edb/ref 17592186163157 :step/content {:db/id #edb/ref 17592186162153 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161713 :question/id #uuid "1fdcc887-4c52-5d91-ab28-63a7dce9fe5a" :question/math-academy-id "e-12462"} :knowledge-point/id #uuid "196e7d31-5af8-5c82-b2bd-0cf1ed7415e2" :knowledge-point/questions [{:db/id #edb/ref 17592186162343} {:db/id #edb/ref 17592186162388} {:db/id #edb/ref 17592186275114} {:db/id #edb/ref 17592186275115} {:db/id #edb/ref 17592186275116} {:db/id #edb/ref 17592186275117} {:db/id #edb/ref 17592186275118} {:db/id #edb/ref 17592186383466} {:db/id #edb/ref 17592186383473} {:db/id #edb/ref 17592186426030}] :knowledge-point/title "Determining Whether Two Random Variables are Independent Given the Joint PMF Only"} :step/id #uuid "85e8d07f-ff5e-5a08-b15e-b9682157622a" :step/math-academy-id 44848 :step/next {:db/id #edb/ref 17592186163158}} {:db/id #edb/ref 17592186163158 :step/content {:db/id #edb/ref 17592186162154 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161714 :question/id #uuid "4e12d6b6-5771-5e54-8f16-7899f82d90bc" :question/math-academy-id "e-12463"} :knowledge-point/id #uuid "900dcaf8-da39-5654-96cd-6aec89e379c9" :knowledge-point/questions [{:db/id #edb/ref 17592186162304} {:db/id #edb/ref 17592186162305} {:db/id #edb/ref 17592186275113} {:db/id #edb/ref 17592186275221} {:db/id #edb/ref 17592186281557} {:db/id #edb/ref 17592186281558} {:db/id #edb/ref 17592186383459} {:db/id #edb/ref 17592186383582} {:db/id #edb/ref 17592186410436} {:db/id #edb/ref 17592186426031} {:db/id #edb/ref 17592186426032}] :knowledge-point/title "Calculating Joint Probabilities"} :step/id #uuid "3bf9c7bd-4281-5c38-aa27-271d95010465" :step/math-academy-id 44851} {:db/id #edb/ref 17592186163159 :step/content {:db/id #edb/ref 17592186162155 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161715 :question/id #uuid "1875d098-95f6-50a7-b069-56865207b3dc" :question/math-academy-id "e-12464"} :knowledge-point/id #uuid "35de7257-8d35-5f81-89be-c7faa73d6bc3" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048325} {:db/id #edb/ref 17592186048945}] :knowledge-point/questions [{:db/id #edb/ref 17592186162457} {:db/id #edb/ref 17592186162458} {:db/id #edb/ref 17592186281533} {:db/id #edb/ref 17592186281553} {:db/id #edb/ref 17592186281683} {:db/id #edb/ref 17592186284383} {:db/id #edb/ref 17592186481664}] :knowledge-point/title "Determining Whether Two Random Variables are Independent"} :step/id #uuid "b0b7073a-7020-52ef-b9e8-f169d03cd0f4" :step/math-academy-id 44854 :step/next {:db/id #edb/ref 17592186163157}}] :activity/title "Independence of Discrete Random Variables" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186162186}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186116110} :activity/id #uuid "d07d2d5c-d3e0-595b-84ff-e18597a3d040" :activity/scope {:db/id #edb/ref 17592186050906 :topic/id #uuid "70425962-eba3-5483-950c-6e00e8bba0c0" :topic/math-academy-id 1730} :activity/steps [{:db/id #edb/ref 17592186116110 :step/content {:db/id #edb/ref 17592186116491 :tutorial/content "Consider a system of two linear equations with two variables \n\n$$\n{\\begin{aligned}{a}_{11}x+{a}_{12}y={b}_{1} \\\\ {a}_{21}x+{a}_{22}y={b}_{2},\\end{aligned}\n$$\n\nand let\n![](images/73/73c4f1122f53beb4bea2619922226e641d7ac1dd2bb611106d8a33dc13a7abbd.svg)\n\nRecall that we can write the system as $A \\mathbf{x} = \\mathbf{b}.$ The **invertible matrix theorem** says the following statements are equivalent:\n\n- $A$ is invertible (that is, $A^{-1}$ exists).\n\n- The system $A\\mathbf{x}=\\mathbf{b}$ has exactly one solution for any $2 \\times 1$ column vector $\\mathbf{b}$ (we call such systems consistent independent).\n\n- The system $A\\mathbf{x}=\\mathbf{0}$ has the unique solution ![](images/9f/9f196772fa8ca5829a00c8f4378f2a51f423cf6e27fdc8470e245be0c4005f2c.svg)\n\n- The lines ${\\color{red}{a_{11}}}x+{\\color{red}{a_{12}}}y={\\color{blue}{b_1}}$ and ${\\color{red}{a_{21}}}x+{\\color{red}{a_{22}}}y={\\color{blue}{b_2}}$ intersect at one point.\n\n- The  determinant of $A$ is nonzero (that is, $\\det(A) \\neq 0$)." :tutorial/id #uuid "5a0ce34c-f39a-5c24-bab3-840ff974402c" :tutorial/math-academy-id 3050 :tutorial/title "Introduction"} :step/id #uuid "836cc4ee-5cd5-58a8-8fc6-487e670dc062" :step/math-academy-id 16471 :step/next {:db/id #edb/ref 17592186116111}} {:db/id #edb/ref 17592186116111 :step/content {:db/id #edb/ref 17592186115234 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115065 :question/id #uuid "c0c08150-98f9-5677-a7a8-390cffc0c5b0" :question/math-academy-id "e-4511"} :knowledge-point/id #uuid "d49a7b78-bea1-54e5-8232-3fea0d4eb5a3" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050944}] :knowledge-point/questions [{:db/id #edb/ref 17592186115744} {:db/id #edb/ref 17592186115811} {:db/id #edb/ref 17592186262850} {:db/id #edb/ref 17592186262851} {:db/id #edb/ref 17592186262852} {:db/id #edb/ref 17592186299715} {:db/id #edb/ref 17592186342014} {:db/id #edb/ref 17592186342015}] :knowledge-point/title "Identifying a True Statement Concerning a 2x2 System of Equations"} :step/id #uuid "33db29bf-42ca-5174-b04b-c5529dc2bc98" :step/math-academy-id 16472 :step/next {:db/id #edb/ref 17592186116112}} {:db/id #edb/ref 17592186116112 :step/content {:db/id #edb/ref 17592186115235 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115066 :question/id #uuid "8c1e5afa-0afa-56ee-bbfa-4e84c64093ad" :question/math-academy-id "e-4512"} :knowledge-point/id #uuid "9923c6c3-e425-54ae-a533-09421d5578cb" :knowledge-point/questions [{:db/id #edb/ref 17592186115743} {:db/id #edb/ref 17592186115884} {:db/id #edb/ref 17592186262854} {:db/id #edb/ref 17592186262856} {:db/id #edb/ref 17592186262876} {:db/id #edb/ref 17592186262877} {:db/id #edb/ref 17592186323750} {:db/id #edb/ref 17592186329821} {:db/id #edb/ref 17592186342016} {:db/id #edb/ref 17592186342017} {:db/id #edb/ref 17592186342018} {:db/id #edb/ref 17592186377668} {:db/id #edb/ref 17592186412421}] :knowledge-point/title "Identifying a True Statement Given a 2x2 Matrix"} :step/id #uuid "2a71d8e7-c420-59a3-927f-619b1fbcc37e" :step/math-academy-id 16473 :step/next {:db/id #edb/ref 17592186116113}} {:db/id #edb/ref 17592186116113 :step/content {:db/id #edb/ref 17592186115236 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115067 :question/id #uuid "cb19dcff-bb9d-55dc-941b-48153ca62e7a" :question/math-academy-id "e-4513"} :knowledge-point/id #uuid "64b2036f-da0f-59de-8a39-6b33e6cbdd04" :knowledge-point/questions [{:db/id #edb/ref 17592186115734} {:db/id #edb/ref 17592186115749} {:db/id #edb/ref 17592186262879} {:db/id #edb/ref 17592186262880} {:db/id #edb/ref 17592186262881} {:db/id #edb/ref 17592186329822} {:db/id #edb/ref 17592186342026} {:db/id #edb/ref 17592186342029} {:db/id #edb/ref 17592186377575} {:db/id #edb/ref 17592186398700} {:db/id #edb/ref 17592186400331} {:db/id #edb/ref 17592186401988} {:db/id #edb/ref 17592186412420}] :knowledge-point/title "Completing a True Statement"} :step/id #uuid "72cfa9ea-e123-5f2c-bad3-38a7904ca9f0" :step/math-academy-id 16474}] :activity/title "The Invertible Matrix Theorem in Terms of 2x2 Systems of Equations" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186115476}]}
