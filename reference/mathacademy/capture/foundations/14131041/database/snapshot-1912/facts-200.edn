4963 #edb/ref 17592186045417] [17592186287570 #edb/ref 1075 #edb/ref 17592186285222 #edb/ref 17592186045417] [17592186287570 #edb/ref 1075 #edb/ref 17592186286146 #edb/ref 17592186045417] [17592186287570 #edb/ref 1075 #edb/ref 17592186286456 #edb/ref 17592186045417] [17592186287570 #edb/ref 1075 #edb/ref 17592186286962 #edb/ref 17592186045417] [17592186287570 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186287570 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186287570 #edb/ref 1078 #edb/ref 17592186284963 #edb/ref 17592186045417] [17592186287570 #edb/ref 1079 #uuid "cc5ac333-7088-55b5-8dff-47ad3124a244" #edb/ref 17592186045417] [17592186287749 #edb/ref 1068 #edb/ref 17592186287173 #edb/ref 17592186045417] [17592186287749 #edb/ref 1069 "q-181770" #edb/ref 17592186045417] [17592186287749 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186287749 #edb/ref 1071 "Which of the following is a representation of the set $S=Z\\times R$ in the Cartesian plane?" #edb/ref 17592186045417] [17592186287749 #edb/ref 1072 #uuid "5558c8b0-025f-54bf-b54a-ad58d686884f" #edb/ref 17592186045417] [17592186287749 #edb/ref 1074 "The Cartesian product $A\\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\n$$\nA\\times B=\\{(a,b)\\,:\\,a\\in A,\\,b\\in B\\}\n$$\n\nIn this case, the set \n\n$$\nS=Z\\times R\n$$\n\n \ncontains every point in ${R}^{2}$ whose $x$-coordinate is an integer number and whose $y$-coordinate is any real number.\n\n$$\nS=\\{(x,y)\\,:\\,x\\in Z,\\,y\\in R\\}\n$$\n\nTo visualize $S,$ consider ${S}_{-1}⊂S$ containing all points whose $x$-coordinate equals $-1$ and whose $y$-coordinate is any real number.\n\n$$\n{S}_{-1}=\\{(-1,y)\\,:\\,y\\in R\\}\n$$\n\nWe can represent ${S}_{-1}$ in the plane as follows:\n\n![](images/3f/3fdfed680e3fb46adbe8a70aac86682aacb85d43e0675923f87658635fc89a1e.png)\n\nNext, consider ${S}_{1}⊂S$ containing all points whose $x$-coordinate equals $1$ and whose $y$-coordinate is any real number.\n\n$$\n{S}_{1}=\\{(1,y)\\,:\\,y\\in R\\}.\n$$\n\nWe can represent ${S}_{1}$ in the plane as follows:\n\n![](images/7f/7fbda500ecca7e18c9db9939ad78d4dcc6bf488bc7fc4de1137e764ce21a0254.png)\n\nWe can create the subsets $…,{S}_{-3},{S}_{-2},{S}_{0},{S}_{2},{S}_{3},…$ similarly. Our Cartesian product consists of the *union* of these subsets:\n\n$$\n\\begin{aligned}R\\times N & =…{S}_{-2}\\cup {S}_{-1}\\cup {S}_{0}\\cup {S}_{1}\\cup {S}_{2}… \\\\  & ={⋃}_{i\\in Z}{S}_{i}\\end{aligned}\n$$\n\nTherefore, we can visualize $Z\\times R$ as the set of vertical lines shown in the diagram below.\n\n![](images/45/4535a7c6aa7fe8f358d3463b4654c735e53df373d1001916dc035290ca54f969.png)" #edb/ref 17592186045417] [17592186336052 #edb/ref 1080 "⟨1,2,-1⟩" #edb/ref 17592186045417] [17592186336052 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186336052 #edb/ref 1083 #uuid "027279ba-c86b-5b53-9b4f-d91a6c95b4d9" #edb/ref 17592186045417] [17592186336121 #edb/ref 1080 "12" #edb/ref 17592186045417] [17592186336121 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186336121 #edb/ref 1083 #uuid "09ea4053-49e8-5168-b098-82430469625d" #edb/ref 17592186045417] [17592186336321 #edb/ref 1080 "-9" #edb/ref 17592186045417] [17592186336321 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186336321 #edb/ref 1083 #uuid "1f526be7-ec90-5c66-9047-fe096403b260" #edb/ref 17592186045417] [17592186336439 #edb/ref 1080 "⟨-5,3,1⟩" #edb/ref 17592186045417] [17592186336439 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186336439 #edb/ref 1083 #uuid "2b335037-3eda-5eb1-a665-40e27aacca2d" #edb/ref 17592186045417] [17592186336605 #edb/ref 1080 "⟨-5,3,0⟩" #edb/ref 17592186045417] [17592186336605 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186336605 #edb/ref 1083 #uuid "3cc9ad4f-0956-53af-9375-a4dc1247e499" #edb/ref 17592186045417] [175921863369