=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">[</mo><mn>1</mn><mo>+</mo><mn>0.6</mn><mo>+</mo><mo stretchy=\"false\">(</mo><mn>0.6</mn><msup><mo stretchy=\"false\">)</mo><mrow data-mjx-texclass=\"ORD\"><mn>2</mn></mrow></msup><mo>+</mo><mo stretchy=\"false\">(</mo><mn>0.6</mn><msup><mo stretchy=\"false\">)</mo><mrow data-mjx-texclass=\"ORD\"><mn>3</mn></mrow></msup><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow><mo stretchy=\"false\">(</mo><mn>0.4</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>≈</mo><mn>0.870</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>rounded to <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"169\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c33\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn></math></mjx-assistive-mml></mjx-container> decimal places.</p>\n</div></div>",
