 17592186045585] [17592186336345 #edb/ref 1083 #edb/ref 17592186045499 #edb/ref 17592186045585] [17592186336345 #edb/ref 1084 #uuid "208d69f2-61c9-5cef-ae67-df4b82077458" #edb/ref 17592186045585] [17592186336579 #edb/ref 1081 "{\\begin{aligned}y=1 \\\\ z=x+2\\end{aligned}" #edb/ref 17592186045585] [17592186336579 #edb/ref 1083 #edb/ref 17592186045499 #edb/ref 17592186045585] [17592186336579 #edb/ref 1084 #uuid "3998953b-84b0-5889-81f7-4dc1224db93d" #edb/ref 17592186045585] [17592186336687 #edb/ref 1081 "{\\begin{aligned}y=1 \\\\ z=2\\end{aligned}" #edb/ref 17592186045585] [17592186336687 #edb/ref 1083 #edb/ref 17592186045499 #edb/ref 17592186045585] [17592186336687 #edb/ref 1084 #uuid "4603346d-02b6-5575-9939-64549e4f33fc" #edb/ref 17592186045585] [17592186336698 #edb/ref 1081 "⟨0,6,1⟩" #edb/ref 17592186045585] [17592186336698 #edb/ref 1083 #edb/ref 17592186045499 #edb/ref 17592186045585] [17592186336698 #edb/ref 1084 #uuid "4733129a-0c72-56e1-9873-d6951efbe108" #edb/ref 17592186045585] [17592186336820 #edb/ref 1081 "⟨0,-6,1⟩" #edb/ref 17592186045585] [17592186336820 #edb/ref 1083 #edb/ref 17592186045499 #edb/ref 17592186045585] [17592186336820 #edb/ref 1084 #uuid "54939340-4ca9-5a82-b24c-2542ed64af8f" #edb/ref 17592186045585] [17592186336987 #edb/ref 1081 "{\\begin{aligned}y=1 \\\\ z=-x+2\\end{aligned}" #edb/ref 17592186045585] [17592186336987 #edb/ref 1083 #edb/ref 17592186045499 #edb/ref 17592186045585] [17592186336987 #edb/ref 1084 #uuid "6b358259-0538-5cb3-840e-3b6005519fca" #edb/ref 17592186045585] [17592186338133 #edb/ref 1081 "{\\begin{aligned}y=1 \\\\ z=-2\\end{aligned}" #edb/ref 17592186045585] [17592186338133 #edb/ref 1083 #edb/ref 17592186045499 #edb/ref 17592186045585] [17592186338133 #edb/ref 1084 #uuid "ef59035a-1a91-53fe-8a72-a5d6bc5d3dc8" #edb/ref 17592186045585] [17592186338240 #edb/ref 1081 "⟨0,-2,1⟩" #edb/ref 17592186045585] [17592186338240 #edb/ref 1083 #edb/ref 17592186045499 #edb/ref 17592186045585] [17592186338240 #edb/ref 1084 #uuid "fb04c736-1e93-5392-937a-e6b52b89f395" #edb/ref 17592186045585] [17592186338420 #edb/ref 1075 #edb/ref 17592186336059 #edb/ref 17592186045585] [17592186338420 #edb/ref 1075 #edb/ref 17592186336345 #edb/ref 17592186045585] [17592186338420 #edb/ref 1075 #edb/ref 17592186336698 #edb/ref 17592186045585] [17592186338420 #edb/ref 1075 #edb/ref 17592186336820 #edb/ref 17592186045585] [17592186338420 #edb/ref 1075 #edb/ref 17592186338240 #edb/ref 17592186045585] [17592186338420 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045585] [17592186338420 #edb/ref 1077 "selection" #edb/ref 17592186045585] [17592186338420 #edb/ref 1079 #edb/ref 17592186336059 #edb/ref 17592186045585] [17592186338420 #edb/ref 1080 #uuid "4ee8ed97-cdf9-56b8-9f86-2a9258c8b74b" #edb/ref 17592186045585] [17592186338464 #edb/ref 1075 #edb/ref 17592186336240 #edb/ref 17592186045585] [17592186338464 #edb/ref 1075 #edb/ref 17592186336579 #edb/ref 17592186045585] [17592186338464 #edb/ref 1075 #edb/ref 17592186336687 #edb/ref 17592186045585] [17592186338464 #edb/ref 1075 #edb/ref 17592186336987 #edb/ref 17592186045585] [17592186338464 #edb/ref 1075 #edb/ref 17592186338133 #edb/ref 17592186045585] [17592186338464 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045585] [17592186338464 #edb/ref 1077 "selection" #edb/ref 17592186045585] [17592186338464 #edb/ref 1079 #edb/ref 17592186336579 #edb/ref 17592186045585] [17592186338464 #edb/ref 1080 #uuid "67c2ebb0-7f04-5390-9b3f-6c5b9ac02ee1" #edb/ref 17592186045585] [17592186338923 #edb/ref 1068 #edb/ref 17592186338464 #edb/ref 17592186045585] [17592186338923 #edb/ref 1069 "q-71218" #edb/ref 17592186045585] [17592186338923 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045585] [17592186338923 #edb/ref 1071 "The curve $C$ is the intersection of a surface $S,$ defined by $z=f(x,y),$ with the plane $y=1.$ Given that the point $P(0,1,2)$ lies on $C$, and that ${f}_{x}={x}^{2}+{y}^{2}-\\operatorname{ln}⁡(x+y)$, find the equations of the tangent line to $C$ at $P.$" #edb/ref 17592186045585] [17592186338923 #edb/ref 1072 #uuid "ceda561f-8269-5197-b05a-efc41af9a9a2" #edb/ref 17592186045585] [17592186338923 #edb/ref 1074 "The curve $C$ is the intersection of the surface $z=f(x,y)$ with the plane $y=1.$ Hence, the slope of the tangent to the curve at the point $P(0,1,2)$ will be given by the partial derivative $\\frac{∂z}{∂x}{|}_{(0,1)}.$\n\nTo get the slope, we evaluate the partial derivative $\\frac{∂z}{∂x}$ at $(0,1):$\n\n$$\n\\begin{aligned}\\frac{∂z}{∂x}{|}_{(0,1)} & =(0)^{2}+(1)^{2}-\\operatorname{ln}⁡(0+1) \\\\  & =1-\\operatorname{ln}⁡1 \\\\  & =1-0 \\\\  & =1\\end{aligned}\n$$\n\nNow, we use the point-slope form of a straight line:\n\n$$\n\\begin{aligned}z-z{|}_{(0,1)} & =\\frac{∂z}{∂x}{|}_{(0,1)}(x-0) \\\\ z-2 & =1(x) \\\\ z & =x+2\\end{aligned}\n$$\n\nFinally, the tangent line to the curve $C$ at $P(0,1,2)$ can be given as the intersection of two planes, as follows:\n\n$$\n{\\begin{aligned}y=1 \\\\ z=x+2\\end{aligned}\n$$" #edb/ref 17592186045585] [17592186406822 #edb/ref 1043 #edb/ref 17592186406830 #edb/ref 17592186045585] [17592186406822 #edb/ref 1043 #edb/ref 17592186406831 #edb/ref 17592186045585] [17592186406822 #edb/ref 1043 #edb/ref 17592186406832 #edb/ref 17592186045585] [17592186406822 #edb/ref 1043 #edb/ref 17592186406833 #edb/ref 17592186045585] [17592186406822 #edb/ref 1044 #edb/ref 17592186045464 #edb/ref 17592186045585] [17592186406822 #edb/ref 1045 "Geometric Interpretations of Partial Derivatives" #edb/ref 17592186045585] [17592186406822 #edb/ref 1046 #edb/ref 17592186406831 #edb/ref 17592186045585] [17592186406822 #edb/ref 1048 #edb/ref 17592186046665 #edb/ref 17592186045585] [17592186406822 #edb/ref 1049 #edb/ref 17592186050164 #edb/ref 17592186045585] [17592186406822 #edb/ref 1053 #uuid "fa97339f-4dd8-5f3c-87ec-f76f876eeb93" #edb/ref 17592186045585] [17592186406823 #edb/ref 1081 "⟨1,0,2⟩" #edb/ref 17592186045585] [17592186406823 #edb/ref 1083 #edb/ref 17592186045499 #edb/ref 17592186045585] [1