          "input_html": "<div id=\"freeResponseTextbox-2\" class=\"matheditor-wrapper-answer\" ;=\"\" style=\"min-width:50px;\n                                        margin-left:6px;\n                                        margin-right:2px;\n                                        background:;\"><div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"17\"><span mathquill-command-id=\"27\">1</span><span mathquill-command-id=\"29\" class=\"mq-binary-operator\">−</span><span class=\"mq-fraction mq-non-leaf\" mathquill-command-id=\"31\"><span class=\"mq-numerator\" mathquill-block-id=\"33\"><var mathquill-command-id=\"32\">x</var></span><span class=\"mq-denominator\" mathquill-block-id=\"35\"><span mathquill-command-id=\"34\">2</span></span><span style=\"display:inline-block;width:0\">​</span></span></span></div></div>",
