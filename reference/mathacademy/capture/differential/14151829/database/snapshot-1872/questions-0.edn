answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461633} {:answer/id #uuid "9b7e0b31-d531-5190-871d-e573c0b17482" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461634}] :answer-field/correct {:answer/id #uuid "9b7e0b31-d531-5190-871d-e573c0b17482" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461634} :answer-field/id #uuid "6cbbf209-6f8c-5d7f-bba0-8fe64bcddbb2" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462570}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a60d4465-319d-5ba9-93b8-d257af2c79a6" :question/math-academy-id "q-110449" :question/problem "![](images/8c/8c695ea0cb09807c22fa655182945e838a7c5e454680176add27748945d143e5.png)\n\nWhich of the diagrams shown above represent subspaces of ${R}^{2}$ or ${R}^{3}?$\n\nSelect all that apply." :question/worked-solution "Let's analyze each diagram in turn.\n\n- Diagram I does not represent a subspace. The origin $0=[\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}]$  clearly lies outside the subset.\n\n- Diagram II does not represent a subspace. The origin $0=[\\begin{aligned}0 \\\\ 0\\end{aligned}]$  clearly lies outside the subset.\n\n- Diagram III represents a line passing through the origin. Therefore, it is a subspace of  ${R}^{3}.$\n\nSo, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186275441 :knowledge-point/_questions [{:db/id #edb/ref 17592186192782 :knowledge-point/id #uuid "4a8dbbab-2dea-5fff-86f0-3411f5405ee9" :knowledge-point/title "Identifying Whether Sets Represented Graphically Are Subspaces in Three-Dimensional Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bd96b419-3ee9-5f06-bfb3-c37ca8e