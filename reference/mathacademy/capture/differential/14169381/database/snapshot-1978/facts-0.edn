5436] [17592186049676 #edb/ref 1029 #edb/ref 17592186428478 #edb/ref 17592186045436] [17592186049676 #edb/ref 1031 "Global vs. Local Extrema and Critical Points of Multivariable Functions" #edb/ref 17592186045417] [17592186049676 #edb/ref 1033 1945 #edb/ref 17592186045417] [17592186049676 #edb/ref 1034 0.8167678710235878 #edb/ref 17592186045436] [17592186049676 #edb/ref 1035 #uuid "0a177390-6525-5d0c-8721-f7f75db39408" #edb/ref 17592186045417] [17592186050001 #edb/ref 1027 #edb/ref 17592186048775 #edb/ref 17592186045417] [17592186050001 #edb/ref 1027 #edb/ref 17592186050376 #edb/ref 17592186045417] [17592186050001 #edb/ref 1028 #edb/ref 17592186092229 #edb/ref 17592186045417] [17592186050001 #edb/ref 1028 #edb/ref 17592186092230 #edb/ref 17592186045417] [17592186050001 #edb/ref 1028 #edb/ref 17592186092231 #edb/ref 17592186045417] [17592186050001 #edb/ref 1028 #edb/ref 17592186092232 #edb/ref 17592186045417] [17592186050001 #edb/ref 1029 #edb/ref 17592186429726 #edb/ref 17592186045436] [17592186050001 #edb/ref 1031 "Calculating the Eigenvalues of a 2x2 Matrix" #edb/ref 17592186045417] [17592186050001 #edb/ref 1033 990 #edb/ref 17592186045417] [17592186050001 #edb/ref 1034 0.7291506299743056 #edb/ref 17592186045436] [17592186050001 #edb/ref 1035 #uuid "25757680-24c4-582e-828e-48263c608c8b" #edb/ref 17592186045417] [17592186050205 #edb/ref 1027 #edb/ref 17592186049462 #edb/ref 17592186045417] [17592186050205 #edb/ref 1028 #edb/ref 17592186162097 #edb/ref 17592186045417] [17592186050205 #edb/ref 1028 #edb/ref 17592186162098 #edb/ref 17592186045417] [17592186050205 #edb/ref 1028 #edb/ref 17592186162099 #edb/ref 17592186045417] [17592186050205 #edb/ref 1031 "The Singular Values of a Matrix" #edb/ref 17592186045417] [17592186050205 #edb/ref 1033 3131 #edb/ref 17592186045417] [17592186050205 #edb/ref 1034 0.6439111914053435 #edb/ref 17592186045436] [17592186050205 #edb/ref 1035 #uuid "36128875-8025-5e37-8397-54d8247d47c9" #edb/ref 17592186045417] [17592186050280 #edb/ref 1027 #edb/ref 17592186050612 #edb/ref 17592186045417] [17592186050280 #edb/ref 1028 #edb/ref 17592186188355 #edb/ref 17592186045417] [17592186050280 #edb/ref 1028 #edb/ref 17592186188362 #edb/ref 17592186045417] [17592186050280 #edb/ref 1028 #edb/ref 17592186188363 #edb/ref 17592186045417] [17592186050280 #edb/ref 1028 #edb/ref 17592186188364 #edb/ref 17592186045417] [17592186050280 #edb/ref 1031 "The Covariance Matrix" #edb/ref 17592186045417] [17592186050280 #edb/ref 1033 3939 #edb/ref 17592186045417] [17592186050280 #edb/ref 1035 #uuid "3c894a8e-e328-5ff1-a180-13f9317f8867" #edb/ref 17592186045417] [17592186161800 #edb/ref 1069 "e-8262" #edb/ref 17592186045417] [17592186161800 #edb/ref 1071 "Consider the vector ![](images/cc/cc0456884aa670c8c7f86387574a187f151f4ccc4e4275671425af1aa61812e8.png) By evaluating the following quadratic forms at $\\mathbf{x}$ **only,** determine which of them **cannot** be negative-definite.\n\n- $R(\\mathbf{x})=x_1^2 - 3x_2^2 + 5x_1x_2$\n\n- ![](images/ac/acf8b72ee7b927e5e82570c655a671a62b595a29c8191a64ad22ac98af8cf7a4.png)\n\n- $T(\\mathbf{x})=x_2^2 + 8x_1x_2$" #edb/ref 17592186045417] [17592186161800 #edb/ref 1072 #uuid "f3f6f5b1-bc25-586c-9d4d-dfeb64cfa077" #edb/ref 17592186045417] [17592186161800 #edb/ref 1074 "A quadratic form $Q(\\mathbf{x})$ is negative-definite if $Q(\\mathbf{x}) \\lt 0$ for all $\\mathbf{x} \\in \\mathbb{R}^n \\setminus \\{ \\mathbf{0} \\}.$\n\nWith that in mind, let's examine each of the quadratic forms by substituting ![](images/29/29545f79f3b34ca5395f98fa8c8c81e289482e866c3ad8c576aeb7b9fe8b8749.png)\n\n- Quadratic form I *might* be negative-definite. Indeed, \n\n$$\n\\begin{aligned}R(x) & ={2}^{2}-3\\cdot {7}^{2}+5\\cdot 2\\cdot 7 \\\\  & =4-147+70 \\\\  & =-73<0.\\end{aligned}\n$$\n\n- Quadratic form II *cannot* be negative-definite since\n\n$$\n\\begin{aligned}S(x) & =[\\begin{aligned}2 & 7\\end{aligned}][\\begin{aligned}3 & 0 \\\\ 0 & 2\\end{aligned}][\\begin{aligned}2 \\\\ 7\\end{aligned}] \\\\  & =[\\begin{aligned}6 & 14\\end{aligned}][\\begin{aligned}2 \\\\ 7\\end{aligned}] \\\\  & =110>0.\\end{aligned}\n$$\n\n- Quadratic form III *cannot* be negative-definite since\n\n$$\n\\begin{aligned}T(x) & ={7}^{2}+8\\cdot 2\\cdot 7 \\\\  & =49+112 \\\\  & =161>0.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"II and III only.\"" #edb/ref 17592186045417] [17592186161801 #edb/ref 1069 "e-8263" #edb/ref 17592186045417] [17592186161801 #edb/ref 1071 "Consider the matrix ![](images/d1/d16c12fa9086e956b3b0516d42b40aaa121e3b40bd25a72c3d05d436ba410440.png) Which of the following statements are true?\n\n- The eigenvalues of $A$ are $\\lambda_1=-1$ and $\\lambda_2=9$\n\n- $\\mathbf{x}^T \\! A \\, \\mathbf{x}$ is indefinite\n\n- $A$ is positive-definite" #edb/ref 17592186045417] [17592186161801 #edb/ref 1072 #uuid "178e4bbc-718c-5b9e-843a-91914ef16f64" #edb/ref 17592186045417] [17592186161801 #edb/ref 1074 "Given a quadratic form $Q(\\mathbf x) = \\mathbf{x}^T A \\mathbf{x},$ we have the following theorem:\n\n- $Q$ is positive-definite if and only if all the eigenvalues of $A$ are positive,\n\n- $Q$ is positive semi-definite if and only if all the eigenvalues of $A$ are non-negative (note that positive semi-definite quadratic forms include all positive-definite quadratic forms),\n\n- $Q$ is negative-definite if and only if all the eigenvalues of $A$ are negative,\n\n- $Q$ is negative semi-definite if and only if all the eigenvalues of $A$ are non-positive (note that negative semi-definite quadratic forms include all negative-definite quadratic forms), and\n\n- $Q$ is indefinite if and only if $A$ has both positive and negative eigenvalues.\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is false. Computing the characteristic equation of $A,$ we obtain\n\n$$\n\\begin{aligned}|A-\\lambda I| & =0 \\\\ |\\begin{aligned}-4-\\lambda  & 5 \\\\ 5 & -4-\\lambda \\end{aligned}| & =0 \\\\ (-4-\\lambda )(-4-\\lambda )-25 & =0 \\\\ {\\lambda }^{2}+8\\lambda -9 & =0 \\\\ (\\lambda -1)(\\lambda +9) & =0 \\\\ \\lambda  & =1,\\,-9\\end{aligned}\n$$\n\n- Statement II is true, while statement III is false. Since $A$ has positive and negative eigenvalues, the quadratic form $\\mathbf{x}^T \\! A \\, \\mathbf{x}$ (as well as the matrix $A$) is indefinite.\n\nTherefore, the correct answer is \"II only.\"" #edb/ref 17592186045417] [17592186161802 #edb/ref 1069 "e-8264" #edb/ref 17592186045417] [17592186161802 #edb/ref 1071 "![](images/d8/d81ce57017adec7daf2556322259f32ce4261e646dc8f1a48632beb085d9a9cb.png)\nConsider the matrix $A$ shown above.\nWhich of the following statements are true?\n\n- $a_{11}=-6$ and $\\det(A) \\lt 0$\n\n- $\\mathbf{x}^T \\! A \\, \\mathbf{x}$ is negative-definite\n\n- $A$ is positive-definite" #edb/ref 17592186045417] [17592186161802 #edb/ref 1072 #uuid "fa658f82-1d0b-54a3-a172-4d59f03f629e" #edb/ref 17592186045417] [17592186161802 #edb/ref 1074 "Let $\\Delta_i$ for $i=1,2,\\ldots,n$  denote the principal minors of an $n \\times n$ matrix $A.$ Then, according to Sylvester's criterion, the quadratic form $\\mathbf{x}^T \\! A \\, \\mathbf{x}$ (as well as the matrix $A$) is \n\n- positive-definite if and only if $\\Delta_i > 0$ for all $i=1,2,\\ldots,n,$\n\n- negative-definite if and only if, for all $i=1,2,\\ldots,n,$ we have $\\Delta_i <          0$ when $i$ is odd, and $\\Delta_i > 0$ when $i$ is even.\n\nWith that in mind, let's examine each of the statements in turn.\n\n- Statement I is true. Indeed, $a_{11}=-6.$ Expanding $\\det(A)$ along the top row, we get \n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}-6 & -5 & 1 \\\\ 5 & -2 & 2 \\\\ 1 & 2 & -1\\end{aligned}| \\\\  & =(-6)|\\begin{aligned}-2 & 2 \\\\ 2 & -1\\end{aligned}|-(-5)|\\begin{aligned}5 & 2 \\\\ 1 & -1\\end{aligned}|+1\\cdot |\\begin{aligned}5 & -2 \\\\ 1 & 2\\end{aligned}| \\\\  & =(-6)(-2)+(5)(-7)+12 \\\\  & =-11.\\end{aligned}\n$$\n\n- Statement II is true, while statement III is false. Notice the following:\n\n$$\n\\begin{aligned}{Δ}_{1} & ={a}_{11}=-6<0 \\\\ {Δ}_{2} & =|\\begin{aligned}-6 & -5 \\\\ 5 & -2\\end{aligned}|=37>0 \\\\ {Δ}_{3} & =|A|=-11<0\\end{aligned}\n$$\n\nSo, by Sylvester's criterion, the quadratic form $\\mathbf{x}^T \\! A \\, \\mathbf{x},$ and the matrix $A,$ are negative-definite.\n\nTherefore, the correct answer is \"I and II only.\"" #edb/ref 17592186045417] [17592186162008 #edb/ref 1037 #edb/ref 17592186049450 #edb/ref 17592186045417] [17592186162008 #edb/ref 1038 #edb/ref 17592186162634 #edb/ref 17592186045417] [17592186162008 #edb/ref 1038 #edb/ref 17592186162635 #edb/ref 17592186045417] [17592186162008 #edb/ref 1038 #edb/ref 17592186269218 #edb/ref 17592186045417] [17592186162008 #edb/ref 1038 #edb/ref 17592186360479 #edb/ref 17592186045417] [17592186162008 #edb/ref 1038 #edb/ref 17592186360480 #edb/ref 17592186045417] [17592186162008 #edb/ref 1038 #edb/ref 17592186360482 #edb/ref 17592186045417] [17592186162008 #edb/ref 1039 "Identifying Possible Quadratic Form Types Using Substitution" #edb/ref 17592186045417] [17592186162008 #edb/ref 1041 #edb/ref 17592186161800 #edb/ref 17592186045417] [17592186162008 #edb/ref 1042 #uuid "6289ad34-2393-5f5f-b7f0-a1ab1a3916f4" #edb/ref 17592186045417] [17592186162009 #edb/ref 1037 #edb/ref 17592186050001 #edb/ref 17592186045417] [17592186162009 #edb/ref 1038 #edb/ref 17592186162636 #edb/ref 17592186045417] [17592186162009 #edb/ref 1038 #edb/ref 17592186162637 #edb/ref 17592186045417] [17592186162009 #edb/ref 1038 #edb/ref 17592186269221 #edb/ref 17592186045417] [17592186162009 #edb/ref 1038 #edb/ref 17592186269222 #edb/ref 17592186045417] [17592186162009 #edb/ref 1038 #edb/ref 17592186269223 #edb/ref 17592186045417] [17592186162009 #edb/ref 1038 #edb/ref 17592186269224 #edb/ref 17592186045417] [17592186162009 #edb/ref 1038 #edb/ref 17592186360498 #edb/ref 17592186045417] [17592186162009 #edb/ref 1038 #edb/ref 17592186360499 #edb/ref 17592186045417] [17592186162009 #edb/ref 1039 "Identifying a Quadratic Form Type by Calculating the 