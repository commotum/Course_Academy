      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14207158/observations/step-q97012-faf6afff2f36e3bd7fd8.png",
      "source_url": "https://mathacademy.com/tasks/14207158/topics/1971/review",
