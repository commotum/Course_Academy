83ff44" :knowledge-point/title "Interpreting the Arrow Function Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02c9c58a-a214-5eba-901a-bdc452270c65" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186559025} {:answer/id #uuid "8f698421-325f-5fcb-a32f-80af1dd9ee46" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186559372} {:answer/id #uuid "94fa83da-80c7-5f55-9464-39fa5c58c114" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186559386} {:answer/id #uuid "c329a7b2-7848-5e75-84a5-25bcb45d6cff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186559497} {:answer/id #uuid "d81158c2-eba9-59f7-9367-d11127d5d5a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186559545}] :answer-field/correct {:answer/id #uuid "94fa83da-80c7-5f55-9464-39fa5c58c114" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186559386} :answer-field/id #uuid "0696edc7-2d9c-5594-b819-83895889d785" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186559643}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5328fc24-dd2c-524e-ade9-b248f99c64bf" :question/math-academy-id "q-96742" :question/problem "Which of the following functions has the codomain $R?$\n\nI. $p:[0,1]\\to R$\n\nII. $q:R\\to R$\n\nIII. $r:[0,1]\\to [0,1]$" :question/worked-solution "The notation $f:X\\to Y$ means that the function $f$ maps the set $X$ to the set $Y.$ In this case,\n\n- the domain of $f$ is $X,$\n\n- the codomain of $f$ is $Y.$\n\nWith that in mind, let's examine our functions.\n\n- The codomain of $p$ is $R,$ the set of real numbers.\n\n- The codomain of $q$ is $R,$ the set of real numbers.\n\n- The codomain of $r$ is $[0,1],$ the interval from $0$ to $1$ (including $0$ and $1$).\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186360705 :knowledge-point/_questions [{:db/id #edb/ref 17592186172031 :knowledge-point/id #uuid "bbac348b-629f-52a1-9bb3-0d3f8483ff44" :knowledge-point/title "Interpreting the Arrow Function Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ebdb1253-cd9a-5b85-8df1-75e63393709e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469830} {:answer/id #uuid "e6245462-c3b1-57c7-842e-f6fce74151a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469831}] :answer-field/correct {:answer/id #uuid "e6245462-c3b1-57c7-842e-f6fce74151a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469831} :answer-field/id #uuid "9c46fef9-0e62-59e2-89a4-b2f1649af27e" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470527} {:answer-field/choices [{:answer/id #uuid "d673d8ae-45df-57fc-aaa0-e71b323ace0d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469832} {:answer/id #uuid "ea3173a1-9c3f-5c99-af9b-4dfff4f7859a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469833}] :answer-field/correct {:answer/id #uuid "d673d8ae-45df-57fc-aaa0-e71b323ace0d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469832} :answer-field/id #uuid "caa75953-0552-56a9-9fe1-23388f51b591" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470528} {:answer-field/choices [{:answer/id #uuid "67074685-00b3-5b87-a998-db4ac8a3d493" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469834} {:answer/id #uuid "56055a40-3f95-5b17-9624-994e40241b9a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469835}] :answer-field/correct {:answer/id #uuid "67074685-00b3-5b87-a998-db4ac8a3d493" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469834} :answer-field/id #uuid "062d6788-0eeb-5314-b696-d606d4d46c78" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470529}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "29b22caa-a284-5c7f-8948-ff4f4a184ce4" :question/math-academy-id "q-96745" :question/problem "Which of the following functions has the domain ${1,2}?$\n- **I.** $p:{1,2}\\to R$\n- **II.** $q:R\\to [1,2)$\n- **III.** $r:[1,2)\\to {1,2}$\n\nSelect all that apply." :question/worked-solution "The notation $f:X\\to Y$ means that the function $f$ maps the set $X$ to the set $Y.$ In this case,\n\n- the domain of $f$ is $X,$\n\n- the codomain of $f$ is $Y.$\n\nWith that in mind, let's examine our functions.\n\n- The domain of $p$ is ${1,2},$ the set containing the two numbers $1$ and $2$ only.\n\n- The domain of $q$ is $R,$ the set of real numbers.\n\n- The domain of $r$ is $[1,2),$ the interval from $1$ to $2$ (including $1$ but not including $2$).\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186559883 :knowledge-point/_questions [{:db/id #edb/ref 17592186172031 :knowledge-point/id #uuid "bbac348b-629f-52a1-9bb3-0d3f8483ff44" :knowledge-point/title "Interpreting the Arrow Function Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d23e7c9-40ba-5b54-b02d-21430ba708f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186559171} {:answer/id #uuid "3e4753ac-ec9a-5118-9d5f-497d9fdf772e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186559178} {:answer/id #uuid "4b0dea5d-3507-56bb-8583-68afdd27c73c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186559214} {:answer/id #uuid "64b5696e-2731-5353-9177-5de35368dca6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186559266} {:answer/id #uuid "884b94a9-d6b2-5eeb-b350-6ea73296ca6a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186559358}] :answer-field/correct {:answer/id #uuid "3d23e7c9-40ba-5b54-b02d-21430ba708f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186559171} :answer-field/id #uuid "550f1c25-0293-5be1-ae65-eb50dd02286b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186559690}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f312482e-bbe1-5f40-a816-ce63ddb8cbac" :question/math-academy-id "q-96746" :question/problem "Which of the following functions has the domain $(-2,0)?$\n\nI. $p:(-2,0)\\to \\{-2,0\\}$\n\nII. $q:(-2,0)\\to (-2,0)$\n\nIII. $r:[-2,0)\\to (0,2)$" :question/worked-solution "The notation $f:X\\to Y$ means that the function $f$ maps the set $X$ to the set $Y.$ In this case,\n\n- the domain of $f$ is $X,$\n\n- the codomain of $f$ is $Y.$\n\nWith that in mind, let's examine our functions.\n\n- The domain of $p$ is $(-2,0),$ the interval from $-2$ to $0$ (not including $-2$ nor $0$).\n\n- The domain of $q$ is $(-2,0),$ the interval from $-2$ to $0$ (not including $-2$ nor $0$).\n\n- The domain of $r$ is $[-2,0),$ the interval from $-2$ to $0$ (including $-2$ but not including $0$).\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186559773 :knowledge-point/_questions [{:db/id #edb/ref 17592186172031 :knowledge-point/id #uuid "bbac348b-629f-52a1-9bb3-0d3f8483ff44" :knowledge-point/title "Interpreting the Arrow Function Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02afc777-71c7-54a7-ba97-7bbbfed64a98" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186559024} {:answer/id #uuid "4ee7dff7-3395-58fe-8812-401b24d3c95c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186559219} {:answer/id #uuid "86d8385b-658f-55ab-818a-9655645ea8ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186559352} {:answer/id #uuid "87f28eff-b85c-51e4-bfdb-402ad594d1d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186559356} {:answer/id #uuid "cef5775c-2fbc-5e17-99c4-f04975560bc1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186559518}] :answer-field/correct {:answer/id #uuid "86d8385b-658f-55ab-818a-9655645ea8ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186559352} :answer-field/id #uuid "57c4d1e2-df8c-582b-885f-5ecfb77ad977" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186559695}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "03451249-6784-5494-bb32-85da8e4ecff7" :question/math-academy-id "q-96750" :question/problem "Which of the following functions has the domain $(0,2)?$\n\nI. $p:(0,2)\\to \\{0,2\\}$\n\nII. $q:R\\to (0,2)$\n\nIII. $r:(0,2)\\to R$" :question/worked-solution "The notation $f:X\\to Y$ means that the function $f$ maps the set $X$ to the set $Y.$ In this case,\n\n- the domain of $f$ is $X,$\n\n- the codomain of $f$ is $Y.$\n\nWith that in mind, let's examine our functions.\n\n- The domain of $p$ is $(0,2),$ the interval from $0$ to $2$ (not including $0$ nor $2$).\n\n- The domain of $q$ is $R,$ the set of real numbers.\n\n- The domain of $r$ is $(0,2),$ the interval from $0$ to $2$ (not including $0$ nor $2$).\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186559790 :knowledge-point/_questions [{:db/id #edb/ref 17592186172032 :knowledge-point/id #uuid "1fdf7e44-a092-5990-a10e-d48b175dcef0" :knowledge-point/title "Writing a Function Using Arrow Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f959bdc-fff8-58ea-8b92-1f812f9a3b2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g:R\\to X" :db/id #edb/ref 17592186559048} {:answer/id #uuid "475e1f42-ea61-52a9-9eb5-854f0618f93f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g:Q\\to X" :db/id #edb/ref 17592186559201} {:answer/id #uuid "b136a774-479b-58ba-80f9-7d0bccf5e4cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g:R\\to Q" :db/id #edb/ref 17592186559458} {:answer/id #uuid "d1e5135b-30cf-5ce9-8304-09e5d08ea97d" :answer/type {:db/id #edb/ref 1759