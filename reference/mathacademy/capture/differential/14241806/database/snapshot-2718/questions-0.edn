wer/id #uuid "54b3b309-defa-5ec6-b280-3fe8f810139d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "h:5x↦{x}^{2}" :db/id #edb/ref 17592186358483} {:answer/id #uuid "99029646-1f42-51be-a743-68e7ff3eafef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "h:x↦5x" :db/id #edb/ref 17592186359095} {:answer/id #uuid "e0f10c75-0b76-5f76-ac2e-4068373695d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "h:x↦5x+{x}^{2}" :db/id #edb/ref 17592186359731}] :answer-field/correct {:answer/id #uuid "e0f10c75-0b76-5f76-ac2e-4068373695d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "h:x↦5x+{x}^{2}" :db/id #edb/ref 17592186359731} :answer-field/id #uuid "20256ef8-47eb-5e0b-acce-f6298a04e96d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360050}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2423c376-50d4-5d9b-9b03-1de914522887" :question/math-academy-id "q-96043" :question/problem "Which of the following is equivalent to $h(x)=5x+{x}^{2}?$" :question/worked-solution "The notation $h(x)=5x+{x}^{2}$ means that the function $h$ maps the element $x$ in the domain to $5x+{x}^{2}$ in the codomain. This can also be written as\n\n$$\nh:x↦5x+{x}^{2}.\n$$"}] [{:db/id #edb/ref 17592186360705 :knowledge-point/_questions [{:db/id #edb/ref 17592186172031 :knowledge-point/id #uuid "bbac348b-629f-52a1-9bb3-0d3f8483ff44" :knowledge-point/title "Interpreting the Arrow Function Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ebdb1253-cd9a-5b85-8df1-75e63393709e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469830} {:answer/id #uuid "e6245462-c3b1-57c7-842e-f6fce74151a6" :answer/typ