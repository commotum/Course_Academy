[{"source" ":org/Math-Academy" "forms" [{:db/id 17592186172031 :knowledge-point/questions ["question-03451249-6784-5494-bb32-85da8e4ecff7" "question-5328fc24-dd2c-524e-ade9-b248f99c64bf" "question-f312482e-bbe1-5f40-a816-ce63ddb8cbac"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186171837 :question/problem "Which of the following functions has the codomain $[0,1]?$\n\nI. $p: \\{ 0, 1 \\} \\to \\mathbb{R}$\n\nII. $q: \\mathbb{R} \\to [ 0, 1 ]$\n\nIII. $r: [0,1] \\to [ 0, 1 )$" :db/ensure [:question/validate]} {:db/id 17592186172032 :knowledge-point/questions ["question-33ee1a61-aa83-56a5-8209-eec63038ff68" "question-915687d1-7d3d-5688-b25a-20c50fc27b30" "question-e8bbc308-2450-589f-b174-679c413f5f6e" "question-f9c7a6ed-7bc4-5fae-bd01-cf7380224c4e"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186171838 :question/problem "Which of the following is the correct symbolic notation for the sentence given below?\n\n$\\qquad$ *\"The function $g$ maps the set of rational numbers to the set $Y$.\"*\n\nI. $g:\\mathbb{Q} \\to Y$\n\nII. $g: Y \\to \\mathbb{Q}$\n\nIII. $g:\\mathbb{R} \\to Y$" :db/ensure [:question/validate]} {:db/id 17592186172033 :knowledge-point/questions ["question-97bd3e47-4a7d-51fe-87e4-ccb53cfbd7e2" "question-366b227d-9c09-5249-bc0f-cb45c09620a0"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186171839 :question/problem "Which of the following is equivalent to $g(x)=x-x^3?$\n\nI. $g:x \\mapsto x-x^3$\n\nII. $g:x \\mapsto -x^3$\n\nIII. $g:-x \\mapsto x^3$" :db/ensure [:question/validate]} {:db/id 17592186172034 :knowledge-point/questions ["question-af103ef7-b89b-5289-9d5d-02c1e186f66e" "question-1110805d-d0df-5ae9-af4b-5eeeabf99273"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186171840 :question/problem "Which of the following is the correct interpretation of $g: \\{ -1,0,1 \\} \\to \\mathbb{R}?$\n\nI. The domain of $g$ is $\\{ -1,0,1 \\}$\n\nII. The codomain of $g$ is $\\mathbb{R}$\n\nIII. The range of $g$ is $\\mathbb{R}$" :db/ensure [:question/validate]} {:db/id "question-03451249-6784-5494-bb32-85da8e4ecff7" :question/id #uuid "03451249-6784-5494-bb32-85da8e4ecff7" :question/math-academy-id "q-96750" :question/problem "Which of the following functions has the domain $(0,2)?$\n\nI. $p:(0,2)\\to \\{0,2\\}$\n\nII. $q:R\\to (0,2)$\n\nIII. $r:(0,2)\\to R$" :question/worked-solution "The notation $f:X\\to Y$ means that the function $f$ maps the set $X$ to the set $Y.$ In this case,\n\n- the domain of $f$ is $X,$\n\n- the codomain of $f$ is $Y.$\n\nWith that in mind, let's examine our functions.\n\n- The domain of $p$ is $(0,2),$ the interval from $0$ to $2$ (not including $0$ nor $2$).\n\n- The domain of $q$ is $R,$ the set of real numbers.\n\n- The domain of $r$ is $(0,2),$ the interval from $0$ to $2$ (not including $0$ nor $2$).\n\nTherefore, the correct answer is \"I and III only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-57c4d1e2-df8c-582b-885f-5ecfb77ad977"] :db/ensure [:question/validate]} {:db/id "answer-field-57c4d1e2-df8c-582b-885f-5ecfb77ad977" :answer-field/id #uuid "57c4d1e2-df8c-582b-885f-5ecfb77ad977" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-86d8385b-658f-55ab-818a-9655645ea8ca" :answer-field/choices ["answer-87f28eff-b85c-51e4-bfdb-402ad594d1d7" "answer-86d8385b-658f-55ab-818a-9655645ea8ca" "answer-cef5775c-2fbc-5e17-99c4-f04975560bc1" "answer-4ee7dff7-3395-58fe-8812-401b24d3c95c" "answer-02afc777-71c7-54a7-ba97-7bbbfed64a98"] :db/ensure [:answer-field/validate]} {:db/id "answer-87f28eff-b85c-51e4-bfdb-402ad594d1d7" :answer/id #uuid "87f28eff-b85c-51e4-bfdb-402ad594d1d7" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-86d8385b-658f-55ab-818a-9655645ea8ca" :answer/id #uuid "86d8385b-658f-55ab-818a-9655645ea8ca" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-cef5775c-2fbc-5e17-99c4-f04975560bc1" :answer/id #uuid "cef5775c-2fbc-5e17-99c4-f04975560bc1" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-4ee7dff7-3395-58fe-8812-401b24d3c95c" :answer/id #uuid "4ee7dff7-3395-58fe-8812-401b24d3c95c" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "answer-02afc777-71c7-54a7-ba97-7bbbfed64a98" :answer/id #uuid "02afc777-71c7-54a7-ba97-7bbbfed64a98" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id 17592186172627 :question/problem "Which of the following functions has the codomain $[0,3)?$\n\nI. $p:\\{0,3\\}\\to R$\n\nII. $q:R\\to [0,3)$\n\nIII. $r:[0,3)\\to \\{0,3\\}$" :question/worked-solution "The notation $f:X\\to Y$ means that the function $f$ maps the set $X$ to the set $Y.$ In this case,\n\n- the domain of $f$ is $X,$\n\n- the codomain of $f$ is $Y.$\n\nWith that in mind, let's examine our functions.\n\n- The codomain of $p$ is $R,$ the set of real numbers.\n\n- The codomain of $q$ is $[0,3),$ the interval from $0$ to $3$ (including $0$ but not including $3$).\n\n- The codomain of $r$ is $\\{0,3\\},$ the set containing the two numbers $0$ and $3$ only.\n\nTherefore, the correct answer is \"II only.\"" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186171387 :answer-field/correct 17592186171392 :db/ensure [:answer-field/validate]} {:db/id "question-5328fc24-dd2c-524e-ade9-b248f99c64bf" :question/id #uuid "5328fc24-dd2c-524e-ade9-b248f99c64bf" :question/math-academy-id "q-96742" :question/problem "Which of the following functions has the codomain $R?$\n\nI. $p:[0,1]\\to R$\n\nII. $q:R\\to R$\n\nIII. $r:[0,1]\\to [0,1]$" :question/worked-solution "The notation $f:X\\to Y$ means that the function $f$ maps the set $X$ to the set $Y.$ In this case,\n\n- the domain of $f$ is $X,$\n\n- the codomain of $f$ is $Y.$\n\nWith that in mind, let's examine our functions.\n\n- The codomain of $p$ is $R,$ the set of real numbers.\n\n- The codomain of $q$ is $R,$ the set of real numbers.\n\n- The codomain of $r$ is $[0,1],$ the interval from $0$ to $1$ (including $0$ and $1$).\n\nTherefore, the correct answer is \"I and II only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-0696edc7-2d9c-5594-b819-83895889d785"] :db/ensure [:question/validate]} {:db/id "answer-field-0696edc7-2d9c-5594-b819-83895889d785" :answer-field/id #uuid "0696edc7-2d9c-5594-b819-83895889d785" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-94fa83da-80c7-5f55-9464-39fa5c58c114" :answer-field/choices ["answer-94fa83da-80c7-5f55-9464-39fa5c58c114" "answer-02c9c58a-a214-5eba-901a-bdc452270c65" "answer-c329a7b2-7848-5e75-84a5-25bcb45d6cff" "answer-d81158c2-eba9-59f7-9367-d11127d5d5a0" "answer-8f698421-325f-5fcb-a32f-80af1dd9ee46"] :db/ensure [:answer-field/validate]} {:db/id "answer-94fa83da-80c7-5f55-9464-39fa5c58c114" :answer/id #uuid "94fa83da-80c7-5f55-9464-39fa5c58c114" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-02c9c58a-a214-5eba-901a-bdc452270c65" :answer/id #uuid "02c9c58a-a214-5eba-901a-bdc452270c65" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-c329a7b2-7848-5e75-84a5-25bcb45d6cff" :answer/id #uuid "c329a7b2-7848-5e75-84a5-25bcb45d6cff" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-d81158c2-eba9-59f7-9367-d11127d5d5a0" :answer/id #uuid "d81158c2-eba9-59f7-9367-d11127d5d5a0" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-8f698421-325f-5fcb-a32f-80af1dd9ee46" :answer/id #uuid "8f698421-325f-5fcb-a32f-80af1dd9ee46" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-f312482e-bbe1-5f40-a816-ce63ddb8cbac" :question/id #uuid "f312482e-bbe1-5f40-a816-ce63ddb8cbac" :question/math-academy-id "q-96746" :question/problem "Which of the following functions has the domain $(-2,0)?$\n\nI. $p:(-2,0)\\to \\{-2,0\\}$\n\nII. $q:(-2,0)\\to (-2,0)$\n\nIII. $r:[-2,0)\\to (0,2)$" :question/worked-solution "The notation $f:X\\to Y$ means that the function $f$ maps the set $X$ to the set $Y.$ In this case,\n\n- the domain of $f$ is $X,$\n\n- the codomain of $f$ is $Y.$\n\nWith that in mind, let's examine our functions.\n\n- The domain of $p$ is $(-2,0),$ the interval from $-2$ to $0$ (not including $-2$ nor $0$).\n\n- The domain of $q$ is $(-2,0),$ the interval from $-2$ to $0$ (not including $-2$ nor $0$).\n\n- The domain of $r$ is $[-2,0),$ the interval from $-2$ to $0$ (including $-2$ but not including $0$).\n\nTherefore, the correct answer is \"I and II only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-550f1c25-0293-5be1-ae65-eb50dd02286b"] :db/ensure [:question/validate]} {:db/id "answer-field-550f1c25-0293-5be1-ae65-eb50dd02286b" :answer-field/id #uuid "550f1c25-0293-5be1-ae65-eb50dd02286b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3d23e7c9-40ba-5b54-b02d-21430ba708f2" :answer-field/choices ["answer-3d23e7c9-40ba-5b54-b02d-21430ba708f2" "answer-884b94a9-d6b2-5eeb-b350-6ea73296ca6a" "answer-3e4753ac-ec9a-5118-9d5f-497d9fdf772e" "answer-4b0dea5d-3507-56bb-8583-68afdd27c73c" "answer-64b5696e-2731-5353-9177-5de35368dca6"] :db/ensure [:answer-field/validate]} {:db/id "answer-3d23e7c9-40ba-5b54-b02d-21430ba708f2" :answer/id #uuid "3d23e7c9-40ba-5b54-b02d-21430ba708f2" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-884b94a9-d6b2-5eeb-b350-6ea73296ca6a" :answer/id #uuid "884b94a9-d6b2-5eeb-b350-6ea73296ca6a" :answer/type :answer.type/text :answer/value "I only" :db