#{[{:db/id #edb/ref 17592186386034 :knowledge-point/_questions [{:db/id #edb/ref 17592186059690 :knowledge-point/id #uuid "eec6cf11-74cc-5b3a-b2fe-bd4285fe4a88" :knowledge-point/title "Rewriting Conditional Statement Using the Associative, Commutative, and Absorption Laws"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "df3bb962-f2d1-5ee7-a113-b857fba5cef8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "X⇒Y" :db/id #edb/ref 17592186386036} {:answer/id #uuid "73685603-fc45-5a7b-ae0b-f79c6a725ab6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "X∨Y" :db/id #edb/ref 17592186386037} {:answer/id #uuid "025fb47c-d3b8-5b43-bbc9-da0a019c987e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "X∧Y" :db/id #edb/ref 17592186386038} {:answer/id #uuid "20639ad4-5e0d-5759-9f30-7c348980aae9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬X∨Y" :db/id #edb/ref 17592186386039} {:answer/id #uuid "5d445084-5adf-5e8c-ba3f-39f72da70cd1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Y" :db/id #edb/ref 17592186386040}] :answer-field/correct {:answer/id #uuid "73685603-fc45-5a7b-ae0b-f79c6a725ab6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "X∨Y" :db/id #edb/ref 17592186386037} :answer-field/id #uuid "30b8ea65-fa59-5640-ad1e-d38a5f9bd046" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386035}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ca2063fd-762f-571b-86ef-906797fcc58c" :question/math-academy-id "q-102730" :question/problem "Simplify the statement $¬(X∨Y)⇒Y.$" :question/worked-solution "First, note that\n\n$$\n¬(X∨Y)⇒Y≡¬(¬(X∨Y))∨Y.\n$$\n\nCanceling out double negations, we reach\n\n$$\n¬(¬(X∨Y))∨Y≡(X∨Y)∨Y.\n$$\n\nFinally, by the associative and idempotent law, we have\n\n$$\n(X∨Y)∨Y≡X∨Y.\n$$\n\nSo the given statement is equivalent to $X∨Y.$"}] [{:db/id #edb/ref 17592186237955 :knowledge-point/_questions [{:db/id #edb/ref 17592186054817 :knowledge-point/id #uuid "5f185774-4d55-515c-9032-8f6832c6999a" :knowledge-point/title "Determining the Truth Value of a Statement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "308b89d9-5d11-59d7-be97-d10de51eb1b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "False" :db/id #edb/ref 17592186236127} {:answer/id #uuid "4a90c3d1-f87f-5dd4-8d1a-852847527935" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "True" :db/id #edb/ref 17592186236295} {:answer/id #uuid "cc79f0fa-9b89-59ca-bf18-3fa0b6b3dc96" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Often" :db/id #edb/ref 17592186237115} {:answer/id #uuid "d65830b8-a74d-509d-b4b9-54ce1fb82f24" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Sometimes" :db/id #edb/ref 17592186237173} {:answer/id #uuid "ee5a5a3a-1c0d-5122-9667-27fc089d41b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Maybe" :db/id #edb/ref 17592186237318}] :answer-field/correct {:answer/id #uuid "4a90c3d1-f87f-5dd4-8d1a-852847527935" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "True" :db/id #edb/ref 17592186236295} :answer-field/id #uuid "e676ee11-3b8c-5549-8e45-f56a2f31802e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237733}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8873b6dc-ff10-573d-8081-18d6cc37db5a" :question/math-academy-id "q-102862" :question/problem "What is the truth value of the following mathematical statement?\n\n$\\,$ The square root of $2$ is an irrational number." :question/worked-solution "A mathematical statement is a sentence or mathematical expression that is either true or false.\n\nThis statement is true because $\\sqrt{2}$ is not a rational number."}] [{:db/id #edb/ref 17592186240992 :knowledge-point/_questions [{:db/id #edb/ref 17592186119854 :knowledge-point/id #uuid "13a44dc8-4699-519f-8cb1-87ad77471ebe" :knowledge-point/title "Solving for Three Coefficients in a Linear Combination"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24228b89-72c1-53f9-96a3-762f6e876413" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186238375} {:answer/id #uuid "41f9a912-3fc6-5aa1-be4b-82da70d8f8d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186238629} {:answer/id #uuid "48788366-6d42-5df1-818a-252fcb9e825d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186238685} {:answer/id #uuid "67eb2257-68d5-593f-891b-6945f576e00f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186238957} {:answer/id #uuid "d9f9576f-46f8-5778-888b-cb310e6c107d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186239958}] :answer-field/correct {:answer/id #uuid "24228b89-72c1-53f9-96a3-762f6e876413" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186238375} :answer-field/id #uuid "69b9e7b4-1521-54c5-b7f4-d54ad2ab9039" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240526}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0d52be40-210e-5024-9a79-b6ca4323223c" :question/math-academy-id "q-105168" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ 3 \\\\ -2\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}-3 \\\\ -8 \\\\ 6\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}2 \\\\ 5 \\\\ -3\\end{bmatrix},\\,b=\\begin{bmatrix}2 \\\\ 1 \\\\ 2\\end{bmatrix}.\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b,$ then what is ${x}_{1}+{x}_{2}+{x}_{3}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b$, then we have  \n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}1 \\\\ 3 \\\\ -2\\end{bmatrix}+{x}_{2}\\begin{bmatrix}-3 \\\\ -8 \\\\ 6\\end{bmatrix}+{x}_{3}\\begin{bmatrix}2 \\\\ 5 \\\\ -3\\end{bmatrix} & =\\begin{bmatrix}2 \\\\ 1 \\\\ 2\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1} \\\\ 3{x}_{1} \\\\ -2{x}_{1}\\end{bmatrix}+\\begin{bmatrix}-3{x}_{2} \\\\ -8{x}_{2} \\\\ 6{x}_{2}\\end{bmatrix}+\\begin{bmatrix}2{x}_{3} \\\\ 5{x}_{3} \\\\ -3{x}_{3}\\end{bmatrix} & =\\begin{bmatrix}2 \\\\ 1 \\\\ 2\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1}-3{x}_{2}+2{x}_{3} \\\\ 3{x}_{1}-8{x}_{2}+5{x}_{3} \\\\ -2{x}_{1}+6{x}_{2}-3{x}_{3}\\end{bmatrix} & =\\begin{bmatrix}2 \\\\ 1 \\\\ 2\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-3{x}_{2}+2{x}_{3} &=2 \\\\ 3{x}_{1}-8{x}_{2}+5{x}_{3} &=1 \\\\ -2{x}_{1}+6{x}_{2}-3{x}_{3} &=2\\end{aligned}\\right.\n$$\n\nWe will solve this system using Gaussian elimination. First, we write the augmented matrix for this system:\n\n$$\nM=\\begin{bmatrix}1 & -3 & 2 & 2 \\\\ 3 & -8 & 5 & 1 \\\\ -2 & 6 & -3 & 2\\end{bmatrix}\n$$\n\nRow-reducing the augmented matrix, we get\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -3 & 2 & 2 \\\\ 3 & -8 & 5 & 1 \\\\ -2 & 6 & -3 & 2\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 & 2 & 2 \\\\ 0 & 1 & -1 & -5 \\\\ -2 & 6 & -3 & 2\\end{bmatrix} & {R}_{3} & :={R}_{3}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 & 2 & 2 \\\\ 0 & 1 & -1 & -5 \\\\ 0 & 0 & 1 & 6\\end{bmatrix}.\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-3{x}_{2}+2{x}_{3} &=2 \\\\ {x}_{2}-{x}_{3} &=-5 \\\\ {x}_{3} &=6.\\end{aligned}\\right.\n$$\n\nFrom the third equation, we get ${x}_{3}=6.$ Substituting ${x}_{3}=6$ into the second equation, we obtain\n\n$$\n{x}_{2}-6=-5\\,⟹\\,{x}_{2}=1.\n$$\n\nNow, substituting ${x}_{2}=1$ and ${x}_{3}=6$ into the first equation, we obtain\n\n$$\n{x}_{1}-3(1)+2(6)=2\\,⟹\\,{x}_{1}=-7.\n$$\n\nSo, the solution of the system is ${x}_{1}=-7$, ${x}_{2}=1$, and ${x}_{3}=6,$ which means \n\n$$\n-7{a}_{1}+{a}_{2}+6{a}_{3}=b.\n$$\n\nConsequently, \n\n$$\n{x}_{1}+{x}_{2}+{x}_{3}=-7+1+6=0.\n$$"}] [{:db/id #edb/ref 17592186233094 :knowledge-point/_questions [{:db/id #edb/ref 17592186147455 :knowledge-point/id #uuid "f4196423-3401-54e1-b214-9dbc4861cfe1" :knowledge-point/title "Identifying Spheres, Hemispheres, Cones, and Cylinders"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04522f63-eb9b-55fd-8e80-eb04e8eb110e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Oblique cone" :db/id #edb/ref 17592186410205} {:answer/id #uuid "72cbb011-122f-5f3c-b6f3-68935cfd85da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Hemisphere" :db/id #edb/ref 17592186410277} {:answer/id #uuid "8a47e253-b5fe-558a-bcdc-de8e4c29b15e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Oblique cylinder" :db/id #edb/ref 17592186410288} {:answer/id #uuid "a328348f-8d7e-54d5-861a-7192275e3e03" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Right cone" :db/id #edb/ref 17592186410314} {:answer/id #uuid "c48304ac-a9cd-5de9-b40a-42e8089a9d64" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Right cylinder" :db/id #edb/ref 17592186410336}] :answer-field/correct {:answer/id #uuid "c48304ac-a9cd-5de9-b40a-42e8089a9d64" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Right cylinder" :db/id #edb/ref 17592186410336} :answer-field/id #uuid "22b21cc6-f91d-5265-b595-23f61a650e54" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186410378}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "552d9e5c-d038-53c1-b922-9832413afdda" :question/math-academy-id "q-107246" :question/problem "![](images/2d/2d6d392d4e0f773f962289075ffa07cd26353ebc00ec50e7473a5c992824417f.png)\n\nWhat is the name of the solid shown above?" :question/worked-solution "The solid is a **right cylinder**. \n\nNotice the following:\n\n- The solid has two parallel circular bases. So, it's a cylinder.\n\n- The axis that passes through the centers of the circles is perpendicular to the bases. So, it's right."}] [{:db/id #edb/ref 17592186244102 :knowledge-point/_questions [{:db/id #edb/ref 17592186083239 :knowledge-point/id #uuid "1ee21c78-209f-564b-a005-86f58699a3be" :knowledge-point/title "Factoring a Quadratic Polynomial With Complex Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f8ba98b-b635-57cd-820c-5d662868757d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y-(4+\\text{i})" :db/id #edb/ref 17592186241751} {:answer/id #uuid "7ddb64c3-6920-561d-85f7-cb1a72153226" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y-(3+2\\text{i})" :db/id #edb/ref 17592186242284} {:answer/id #uuid "8e557471-c17d-509e-b5b0-c916eeb42439" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y-(2+3\\text{i})" :db/id #edb/ref 17592186242431} {:answer/id #uuid "a64c07a4-adf4-5664-bb94-d04a1e47b64e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y-(1-4\\text{i})" :db/id #edb/ref 17592186242644} {:answer/id #uuid "afcf5b7a-3cfd-5db2-9715-1a947fbc2372" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y-(3+4\\text{i})" :db/id #edb/ref 17592186242711}] :answer-field/correct {:answer/id #uuid "3f8ba98b-b635-57cd-820c-5d662868757d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y-(4+\\text{i})" :db/id #edb/ref 17592186241751} :answer-field/id #uuid "56e5fdb7-c6cf-585e-a066-ab65dcd10706" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243613}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "963cb1b5-4672-5772-af3f-0514a1529c6d" :question/math-academy-id "q-107696" :question/problem "Which of the following is a factor of ${y}^{2}-8y+17?$" :question/worked-solution "First, we let $f(y)={y}^{2}-8y+17.$\n\nNext, we solve $f(y)=0$ by completing the square, as follows:\n\n$$\n\\begin{aligned}f(y) & =0 \\\\ {y}^{2}-8y+17 & =0 \\\\ ({y}^{2}-8y+{4}^{2})-{4}^{2}+17 & =0 \\\\ (y-4)^{2}-16+17 & =0 \\\\ (y-4)^{2}+1 & =0 \\\\ (y-4)^{2} & =-1 \\\\ (y-4)^{2} & ={\\text{i}}^{2} \\\\ (y-4)^{2} & =(\\text{i})^{2} \\\\ y-4 & =\\pm \\text{i} \\\\ y & =4\\pm \\text{i}\\end{aligned}\n$$\n\nSince our quadratic equation has roots ${y}_{1}=4+\\text{i}$ and ${y}_{2}=4-\\text{i},$ and the coefficient of the quadratic term is $a=1,$ the expression ${y}^{2}-8y+17$ can be written as\n\n$$\n\\begin{aligned}{y}^{2}-8y+17 & =a(y-{y}_{1})(y-{y}_{2}) \\\\  & =(y-(4+\\text{i}))(y-(4-\\text{i})).\\end{aligned}\n$$\n\nTherefore, among the given options, only $y-(4+\\text{i})$ is a factor of ${y}^{2}-8y+17.$"}] [{:db/id #edb/ref 17592186244115 :knowledge-point/_questions [{:db/id #edb/ref 17592186105769 :knowledge-point/id #uuid "32467c2c-5605-50e9-b961-a29535a0effb" :knowledge-point/title "Identifying True Statements About Eigenvalues and Eigenvectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ccffe726-ee51-5e38-82f6-e00cb9bc6c33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447950} {:answer/id #uuid "10830c4b-8858-530c-855b-cb0eb6404dbb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447951}] :answer-field/correct {:answer/id #uuid "ccffe726-ee51-5e38-82f6-e00cb9bc6c33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447950} :answer-field/id #uuid "082071d0-4be9-5965-b725-b0852043bd08" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449015} {:answer-field/choices [{:answer/id #uuid "c189d83a-2ee8-541b-acb8-4506740a7835" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447952} {:answer/id #uuid "79efbd22-8415-5e36-8323-929f43ac9b5e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447953}] :answer-field/correct {:answer/id #uuid "79efbd22-8415-5e36-8323-929f43ac9b5e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447953} :answer-field/id #uuid "05f42b2e-8f6e-5810-a2ac-aac6067c0c01" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449016} {:answer-field/choices [{:answer/id #uuid "75a10b66-5a8f-5871-9339-219b0e3e74d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447954} {:answer/id #uuid "f07c08ea-4ded-5969-9a0d-3e0fe297bfa1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447955}] :answer-field/correct {:answer/id #uuid "75a10b66-5a8f-5871-9339-219b0e3e74d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447954} :answer-field/id #uuid "cefce898-b060-52ac-83be-8cd47e2e1931" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449017}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5fa81e71-e4f5-5405-bfdd-41cd7387b276" :question/math-academy-id "q-108044" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $v=\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}$ is an eigenvector of $A=\\begin{bmatrix}-1 & -2 \\\\ 3 & 4\\end{bmatrix}$ that corresponds to the eigenvalue $\\lambda =-1.$\n\n- **II.** $v=\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}$ is an eigenvector of $A=\\begin{bmatrix}1 & 4 \\\\ 3 & 0\\end{bmatrix}$ that corresponds to the eigenvalue $\\lambda =-3.$\n\n- **III.** If $v$ is an eigenvector of a matrix $A$ corresponding to the eigenvalue $\\lambda =-2,$ then $3v$ is an eigenvector of $A$ corresponding to $\\lambda =-6.$" :question/worked-solution "Remember that the eigenvectors of $A$ are the non-zero vectors $v$ such that $Av=\\lambda v.$ With that in mind, let's examine the statements one by one.\n\n- Statement I is false. We have\n\n$$\n\\begin{aligned}Av & =\\begin{bmatrix}-1 & -2 \\\\ 3 & 4\\end{bmatrix}\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix} \\\\  & =1\\cdot \\begin{bmatrix}-1 \\\\ 1\\end{bmatrix} \\\\  & =1v.\\end{aligned}\n$$\n\n \nSince $Av=v,$ we conclude that $v$ is an eigenvector of $A$ and the corresponding eigenvalue is $\\lambda =1$ (but not $-1$).\n\n- Statement II is true. We have\n\n$$\n\\begin{aligned}Av & =\\begin{bmatrix}1 & 4 \\\\ 3 & 0\\end{bmatrix}\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 \\\\ -3\\end{bmatrix} \\\\  & =-3\\cdot \\begin{bmatrix}-1 \\\\ 1\\end{bmatrix} \\\\  & =-3v.\\end{aligned}\n$$\n\n \nSince $Av=-3v,$ we conclude that $v$ is an eigenvector of $A$ and the corresponding eigenvalue is $\\lambda =-3.$\n\n- Statement III is false. We have\n\n$$\n\\begin{aligned}A(3v)=3Av=3(-2v)=-2(3v).\\end{aligned}\n$$\n\nSince, $A(3v)=-2(3v),$ and $3v\\ne 0,$ this implies that $3v$ is an eigenvector of $A$ and the corresponding eigenvalue is $\\lambda =-2$ (but not $-6$).\n\n**Note:** In general, any non-zero multiple of an eigenvector is again an eigenvector, and the corresponding eigenvalue is the same.\n\nTherefore, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186410416 :knowledge-point/_questions [{:db/id #edb/ref 17592186068786 :knowledge-point/id #uuid "03e934c8-da65-5615-9717-a50eee3577fd" :knowledge-point/title "Integrating Other Fractional Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0678af68-2cfb-5844-963f-561512f9006d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3\\sqrt{2-{x}^{6}}}+C" :db/id #edb/ref 17592186410208} {:answer/id #uuid "327adc54-a9df-5f2d-b704-5f8e97ebeefa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{12}\\sqrt{2-{x}^{6}}+C" :db/id #edb/ref 17592186410241} {:answer/id #uuid "9fb4fe7b-3555-57fe-b8fa-15be7b061577" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\sqrt{2-{x}^{6}}+C" :db/id #edb/ref 17592186410307} {:answer/id #uuid "e1c194db-8c56-5f8b-9caf-143ea6db9c78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{6}\\sqrt{2-{x}^{6}}+C" :db/id #edb/ref 17592186410355} {:answer/id #uuid "e721585d-c9aa-5992-9200-4910767201bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}\\sqrt{2-{x}^{6}}+C" :db/id #edb/ref 17592186410359}] :answer-field/correct {:answer/id #uuid "e721585d-c9aa-5992-9200-4910767201bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}\\sqrt{2-{x}^{6}}+C" :db/id #edb/ref 17592186410359} :answer-field/id #uuid "ba44c6c6-d2e7-5fc3-91bc-e559cd6937b2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186410405}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0a661730-d4ec-53a7-9567-e2d3f75e3bd0" :question/math-academy-id "q-113727" :question/problem "$\\int \\frac{{x}^{5}}{\\sqrt{2-{x}^{6}}}\\,\\text{d}x=$" :question/worked-solution "Let $u=2-{x}^{6}.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-6{x}^{5}\\,⟹\\,(-\\frac{1}{6})\\text{d}u={x}^{5}\\,\\text{d}x,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{{x}^{5}}{\\sqrt{2-{x}^{6}}}\\,\\text{d}x & =\\int \\frac{1}{\\sqrt{2-{x}^{6}}}\\cdot {x}^{5}\\,\\text{d}x \\\\  & =\\int \\frac{1}{\\sqrt{u}}\\cdot (-\\frac{1}{6})\\text{d}u \\\\  & =-\\frac{1}{6}\\int \\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =-\\frac{1}{6}(2\\sqrt{u})+C \\\\  & =-\\frac{1}{3}\\sqrt{u}+C \\\\  & =-\\frac{1}{3}\\sqrt{2-{x}^{6}}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233209 :knowledge-point/_questions [{:db/id #edb/ref 17592186115212 :knowledge-point/id #uuid "66c5a147-0100-5f4b-a221-25b8674b2115" :knowledge-point/title "Evaluating the Integral of a Sum of Two Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ddafc2d-893b-58b6-93dd-9b191a92a685" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9\\pi +4}{12}" :db/id #edb/ref 17592186247830} {:answer/id #uuid "4cfe36d1-77cf-5186-80e9-ceac37ea2ad7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12(3\\pi +2)" :db/id #edb/ref 17592186248114} {:answer/id #uuid "7cfd92ca-b4c4-57ee-a746-bf891b259937" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\pi +2}{6}" :db/id #edb/ref 17592186248522} {:answer/id #uuid "dc326ddf-4b71-52f9-8419-a866454fb96a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9\\pi -4}{6}" :db/id #edb/ref 17592186249371} {:answer/id #uuid "e3f64d7b-32c1-5cbb-8411-3ad4a8b34c76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6(3\\pi -2)" :db/id #edb/ref 17592186249433}] :answer-field/correct {:answer/id #uuid "2ddafc2d-893b-58b6-93dd-9b191a92a685" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9\\pi +4}{12}" :db/id #edb/ref 17592186247830} :answer-field/id #uuid "946952ec-e5b9-501e-94ca-8480dcdab9bc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249934}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1df5e375-31b2-566a-aee3-e06ed27bbd47" :question/math-academy-id "q-114209" :question/problem "${\\int }_{0}^{1}(\\frac{3}{1+{t}^{2}}+{t}^{2})\\text{d}t=$" :question/worked-solution "We split the integral into the sum of two integrals and factor out the constants. We get\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}(\\frac{3}{1+{t}^{2}}+{t}^{2})\\text{d}t & =3{\\int }_{0}^{1}\\frac{1}{1+{t}^{2}}\\,\\text{d}t+{\\int }_{0}^{1}{t}^{2}\\,\\text{d}t \\\\  & =3\\operatorname{arctan}⁡t\\,{|}_{0}^{1}+\\frac{1}{3}{t}^{3}\\,{|}_{0}^{1} \\\\  & =3(\\operatorname{arctan}⁡1-\\operatorname{arctan}⁡0)+\\frac{1}{3}({1}^{3}-{0}^{1}) \\\\  & =3(\\frac{\\pi }{4}-0)+\\frac{1}{3}(1-0) \\\\  & =\\frac{3\\pi }{4}+\\frac{1}{3} \\\\  & =\\frac{9\\pi +4}{12}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233216 :knowledge-point/_questions [{:db/id #edb/ref 17592186087714 :knowledge-point/id #uuid "9fed1761-ceeb-5033-afa2-cb735e6bb96c" :knowledge-point/title "Determining the Lengths of the Major and Minor Axes of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2eb658f2-fe35-5e10-bef3-933961176bf4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186247841} {:answer/id #uuid "7823881d-7e2c-52ef-b688-59e51a932f84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186248480} {:answer/id #uuid "c1414e3b-0d2d-575e-aec1-cf23894cfc17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186249144} {:answer/id #uuid "e54b1dff-2a93-543e-837a-88f13317d60e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186249443} {:answer/id #uuid "e91a99e6-c499-504a-8b9e-a20edd485eeb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186249485}] :answer-field/correct {:answer/id #uuid "7823881d-7e2c-52ef-b688-59e51a932f84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186248480} :answer-field/id #uuid "0577a0ba-da8e-5839-b51c-1923a29693ce" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249675}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fe914836-cad9-5ede-b4ee-c13fc7ae4032" :question/math-academy-id "q-114961" :question/problem "![](images/d6/d624edaffd8c90de40041d419cf65bcf8f3af5d31c8d88d1123bd8f3d7555166.png)\n\nWhat is the length of the major axis of the ellipse given above?" :question/worked-solution "The major axis is the longest diameter of the ellipse, which is the line segment bounded by the points $(-3,1)$ and $(5,1).$ So, the length of the major axis is $5-(-3)=8.$"}] [{:db/id #edb/ref 17592186233277 :knowledge-point/_questions [{:db/id #edb/ref 17592186059652 :knowledge-point/id #uuid "b05f4be1-95d4-5137-bbaa-71c95862bb59" :knowledge-point/title "Simplifying Expressions by Factoring an Alternate Form of the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "070ad91b-8594-5a54-bd22-effa4b3824f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{cos}⁡x" :db/id #edb/ref 17592186250609} {:answer/id #uuid "1c4884cc-8e4f-54c9-9b69-4852a3a71ab5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡x" :db/id #edb/ref 17592186250791} {:answer/id #uuid "4ae1ce24-2485-5108-9fd4-bf13db223503" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡x-1" :db/id #edb/ref 17592186251176} {:answer/id #uuid "861d53de-3a6c-5cea-b897-b08c52349d7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡x" :db/id #edb/ref 17592186251676} {:answer/id #uuid "ad477e53-678e-5262-adb3-20a5abeb8572" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+\\operatorname{cos}⁡x" :db/id #edb/ref 17592186252061}] :answer-field/correct {:answer/id #uuid "1c4884cc-8e4f-54c9-9b69-4852a3a71ab5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡x" :db/id #edb/ref 17592186250791} :answer-field/id #uuid "6855c777-d148-5b64-b557-3af5ffaeb2cf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252994}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d6dd4ef9-dcc4-5324-91b6-a18f8265b17f" :question/math-academy-id "q-119865" :question/problem "Simplify $\\frac{{sin}^{2}⁡x}{1-\\operatorname{cos}⁡x}-1$" :question/worked-solution "First, we rewrite the numerator of the first term using $1-{cos}^{2}⁡x={sin}^{2}⁡x.$\n\n$$\n\\frac{{sin}^{2}⁡x}{1-\\operatorname{cos}⁡x}-1=\\frac{1-{cos}^{2}⁡x}{1-\\operatorname{cos}⁡x}-1\n$$\n\nNext, we factor the numerator of the first term as a difference of squares, and simplify:\n\n$$\n\\begin{aligned}\\frac{1-{cos}^{2}⁡x}{1-\\operatorname{cos}⁡x}-1 & =\\frac{(1-\\operatorname{cos}⁡x)(1+\\operatorname{cos}⁡x)}{1-\\operatorname{cos}⁡x}-1 \\\\  & =\\frac{\\cancel{(1-\\operatorname{cos}⁡x)}(1+\\operatorname{cos}⁡x)}{\\cancel{1-\\operatorname{cos}⁡x}}-1 \\\\  & =\\frac{1+\\operatorname{cos}⁡x}{1}-1 \\\\  & =1+\\operatorname{cos}⁡x-1 \\\\  & =\\operatorname{cos}⁡x\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186371679 :knowledge-point/_questions [{:db/id #edb/ref 17592186129220 :knowledge-point/id #uuid "0b9d2e98-8007-51ec-bfb6-cb9b48029a2a" :knowledge-point/title "Calculating a Double Integral Using the Mean Value of X and Y"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dfe29d41-20aa-5404-b1fe-d53dd72a2e3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186371681} {:answer/id #uuid "95247cc3-5d88-5219-8590-1f2e15220157" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186371682} {:answer/id #uuid "d4dda20c-85d8-5cdb-8d70-c56d3857d27e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186371683} {:answer/id #uuid "24f3cc9c-52d3-5832-98c6-6eaf7668b573" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186371684} {:answer/id #uuid "5863543e-2974-5a76-a791-9bd5c9db01f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186371685}] :answer-field/correct {:answer/id #uuid "95247cc3-5d88-5219-8590-1f2e15220157" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186371682} :answer-field/id #uuid "7d7848e2-f768-55a9-aff3-ed72e02a83b6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186371680}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "eeafd037-077a-51ed-84eb-4b9e62434000" :question/math-academy-id "q-123853" :question/problem "Let $R=[5,6]\\times [1,3]$ be a region in the $xy$-plane, and let $f(x,y)$ be a function defined over $R.$\nThe lower and upper Riemann sums corresponding to an arbitrary partition $P$ of $R$ are given by\n\n$$\n\\begin{aligned}L(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}(2{x}_{i-1}-3{y}_{j})Δ{x}_{i}Δ{y}_{j}, \\\\ U(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}(2{x}_{i}-3{y}_{j-1})Δ{x}_{i}Δ{y}_{j}.\\end{aligned}\n$$\n\nUsing the definition of the double integral in terms of $L(f,P)$ and $U(f,P),$ compute ${∬}_{R}f(x,y)\\,\\text{d}A.$\n\n*Hint: You may wish to make use of the following result:*\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}({x}_{i-1}+{x}_{i})Δ{x}_{i}Δ{y}_{j}=({x}_{m}^{2}-{x}_{0}^{2})({y}_{n}-{y}_{0})\\end{aligned}\n$$" :question/worked-solution "For a function $f(x,y),$ the double integral of $f$ over a rectangular region $R$ is the unique number $I$ (if it exists) such that\n\n$$\nL(f,P)\\le I\\le U(f,P)\n$$\n\nover all partitions $P$ of $R.$\n\nFirst, notice that ${\\overset{¯}{x}}_{i}=\\frac{1}{2}({x}_{i-1}+{x}_{i})$ will always lie between ${x}_{i-1}$ and ${x}_{i}$, and similarly ${\\overset{¯}{y}}_{j}=\\frac{1}{2}({y}_{j-1}+{y}_{j})$ will always lie between ${y}_{j-1}$ and ${y}_{j}.$ Therefore,\n\n$$\n2{x}_{i-1}-3{y}_{j}\\le 2\\cdot \\frac{1}{2}({x}_{i-1}+{x}_{i})-3\\cdot \\frac{1}{2}({y}_{j-1}+{y}_{j})\\le 2{x}_{i}-3{y}_{j-1}\n$$\n\nwhich simplifies to\n\n$$\n2{x}_{i-1}-3{y}_{j}\\le ({x}_{i-1}+{x}_{i})-\\frac{3}{2}({y}_{j-1}+{y}_{j})\\le 2{x}_{i}-3{y}_{j-1}.\n$$\n\nMultiplying this by $Δ{x}_{i}Δ{y}_{j}$ and applying the double summation gives:\n\n$$\nL(f,P)\\le {\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}[({x}_{i-1}+{x}_{i})-\\frac{3}{2}({y}_{j-1}+{y}_{j})]Δ{x}_{i}Δ{y}_{j}\\le U(f,P)\n$$\n\nSeparating the sums using the addition and constant multiple rules, we get\n\n$$\nL(f,P)\\le {\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}({x}_{i-1}+{x}_{i})Δ{x}_{i}Δ{y}_{j}-\\frac{3}{2}{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}({y}_{j-1}+{y}_{j})Δ{x}_{i}Δ{y}_{j}\\le U(f,P).\n$$\n\nUsing the hint, we get the following:\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}({x}_{i-1}+{x}_{i})Δ{x}_{i}Δ{y}_{j} & =({6}^{2}-{5}^{2})(3-1)=22 \\\\ \\frac{3}{2}{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}({y}_{j-1}+{y}_{j})Δ{x}_{i}Δ{y}_{j} & =\\frac{3}{2}({3}^{2}-{1}^{2})(6-5)=12\\end{aligned}\n$$\n\nFinally then:\n\n$$\n\\begin{aligned}L(f,P)\\le 22-12\\le U(f,P)\\,⟹\\,L(f,P)\\le 10\\le U(f,P)\\end{aligned}\n$$\n\nTherefore, we conclude that \n\n$$\n{∬}_{R}f(x,y)\\,\\text{d}A=10.\n$$"}] [{:db/id #edb/ref 17592186262695 :knowledge-point/_questions [{:db/id #edb/ref 17592186124500 :knowledge-point/id #uuid "debd4ccc-de40-55a6-9236-9bf9fff0bdb1" :knowledge-point/title "Finding the Parametric Equations of a Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05138d70-95c1-5979-b58d-e293bc770f12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=-4+3t \\\\ y &=-3-2t \\\\ z &=4-2t\\end{aligned}\\right." :db/id #edb/ref 17592186422929} {:answer/id #uuid "90ed5060-8eb2-5907-9d5e-81459c8f8c02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=4-2t \\\\ y &=-5-2t \\\\ z &=2+3t\\end{aligned}\\right." :db/id #edb/ref 17592186422930} {:answer/id #uuid "b6cefd44-c970-5d19-8f31-e184862531ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=2+t \\\\ y &=-5+3t \\\\ z &=4-2t\\end{aligned}\\right." :db/id #edb/ref 17592186422931} {:answer/id #uuid "b7014cb4-4b9b-5046-a88f-19f20b69fb75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=2-3t \\\\ y &=5-2t \\\\ z &=-4-2t\\end{aligned}\\right." :db/id #edb/ref 17592186422932} {:answer/id #uuid "cac3e014-58d3-578a-97e4-18352d84f826" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=2-3t \\\\ y &=-5+2t \\\\ z &=-4+2t\\end{aligned}\\right." :db/id #edb/ref 17592186422933}] :answer-field/correct {:answer/id #uuid "b6cefd44-c970-5d19-8f31-e184862531ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=2+t \\\\ y &=-5+3t \\\\ z &=4-2t\\end{aligned}\\right." :db/id #edb/ref 17592186422931} :answer-field/id #uuid "b9b1116d-ce1c-52d6-8302-1b2568c8f6a9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262461}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "198cf240-fd0a-5616-aefd-68b43c60564e" :question/math-academy-id "q-127046" :question/problem "Find the parametric equations of the line that passes through the points $P(2,-5,4)$ and $Q(3,-2,2).$" :question/worked-solution "We need to find a direction vector that is parallel to the given line. We can use the vector $\\overset{\\to }{PQ}$ as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{PQ} \\\\  & =\\overset{\\to }{OQ}-\\overset{\\to }{OP} \\\\  & =\\begin{bmatrix}3 \\\\ -2 \\\\ 2\\end{bmatrix}-\\begin{bmatrix}2 \\\\ -5 \\\\ 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ 3 \\\\ -2\\end{bmatrix}\\end{aligned}\n$$\n\nSo, the vector equation of the line is\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =\\begin{bmatrix}2 \\\\ -5 \\\\ 4\\end{bmatrix}+t\\begin{bmatrix}1 \\\\ 3 \\\\ -2\\end{bmatrix} \\\\ \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}2 \\\\ -5 \\\\ 4\\end{bmatrix}+\\begin{bmatrix}t \\\\ 3t \\\\ -2t\\end{bmatrix} \\\\ \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}2+t \\\\ -5+3t \\\\ 4-2t\\end{bmatrix}\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$ And finally, the parametric equations:\n\n$$\n\\left\\{\\begin{aligned}x &=2+t \\\\ y &=-5+3t \\\\ z &=4-2t\\end{aligned}\\right.\n$$"}] [{:db/id #edb/ref 17592186410422 :knowledge-point/_questions [{:db/id #edb/ref 17592186105737 :knowledge-point/id #uuid "3e0b4d33-7699-5068-90f1-663534cd662d" :knowledge-point/title "Calculating Scalar Triple Products Using Its Properties"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29595116-806d-5a50-ab1b-9695013bab97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186410234} {:answer/id #uuid "6cddf496-550e-503d-97cf-86f4c416cb41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186410274} {:answer/id #uuid "87da3e47-9864-54d6-b40d-2913c6ae3373" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-22" :db/id #edb/ref 17592186410286} {:answer/id #uuid "ba4d127a-493d-5de0-a877-1ac772d55fad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186410329} {:answer/id #uuid "f7d42b31-2f13-5fd5-a529-f48c87f1b72a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186410369}] :answer-field/correct {:answer/id #uuid "6cddf496-550e-503d-97cf-86f4c416cb41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186410274} :answer-field/id #uuid "81bc68bf-9d8f-562a-bde6-27ff85778ca1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186410391}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "35202296-3c02-529f-93c9-ab75d2fe58b2" :question/math-academy-id "q-128355" :question/problem "Find $c\\cdot (a\\times b),$ if $b\\times c=⟨4,3,-5⟩$ and $a=⟨-2,8,2⟩.$" :question/worked-solution "First, we compute the triple scalar product \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨-2,8,2⟩\\cdot ⟨4,3,-5⟩ \\\\  & =(-2)\\cdot 4+8\\cdot 3+2\\cdot (-5) \\\\  & =-8+24-10 \\\\  & =6.\\end{aligned}\n$$\n\nThen, we swap $a$ and $c$ to get\n\n$$\n\\begin{aligned}c\\cdot (b\\times a)=-6\\end{aligned}\n$$\n\nand again we swap $a$ and $b$ to get\n\n$$\n\\begin{aligned}c\\cdot (a\\times b)=6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262956 :knowledge-point/_questions [{:db/id #edb/ref 17592186119841 :knowledge-point/id #uuid "489887a0-7013-5fb2-8f16-d18616196b0f" :knowledge-point/title "Finding the Shortest Distance Between a Point and a Plane Given in Cartesian Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "396b6e30-20dc-505a-a011-b9a1c89898fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186260387} {:answer/id #uuid "a3012ac3-d9a2-5ff4-a1ed-0eb949759b36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186261297} {:answer/id #uuid "c2b0aa32-5925-507f-9087-7ad6312dd4d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{30}{7}" :db/id #edb/ref 17592186261593} {:answer/id #uuid "cddd5a3e-4436-57c5-884b-22c96aa491db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186261693} {:answer/id #uuid "ddeb2cc5-b0c3-5e7a-a0e2-5c557307f90f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186261837}] :answer-field/correct {:answer/id #uuid "a3012ac3-d9a2-5ff4-a1ed-0eb949759b36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186261297} :answer-field/id #uuid "d5c4d58e-7136-568a-902e-1affdf5888ab" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262494}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "04f29aba-0bc5-533b-80be-91fd747ce6a1" :question/math-academy-id "q-129158" :question/problem "Find the shortest distance between the point $P(-1,3,-4)$ and the plane $Π$ with equation $6x+2y+3z=9.$" :question/worked-solution "Let's start by picking a point on the plane. To do that, we simply substitute some concrete values for $x$ and $y$ into the equation and solve for $z.$ Let's choose $x=1$ and $y=0$ (though it doesn't really matter what values we choose). Solving for $z,$ we get \n\n$$\n\\begin{aligned}6x+2y+3z & =9 \\\\ 6(1)+2(0)+3z & =9 \\\\ 3z & =3 \\\\ z & =1.\\end{aligned}\n$$\n\nSo, we get the point $Q(1,0,1)$ which lies on the plane.\n\nComputing $\\overset{\\to }{PQ},$ we get \n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨1,0,1⟩-⟨-1,3,-4⟩ \\\\  & =⟨2,-3,5⟩.\\end{aligned}\n$$\n\nWe also need a normal vector to the plane. For any Cartesian equation of a plane $ax+by+cz=d,$ the normal vector is $n=⟨a,b,c⟩.$ So, for the plane $Π,$ we have $n=⟨6,2,3⟩.$ \n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|2\\cdot 6+(-3)\\cdot 2+5\\cdot 3|}{\\sqrt{{6}^{2}+{2}^{2}+{3}^{2}}} \\\\  & =\\frac{|12-6+15|}{\\sqrt{36+4+9}} \\\\  & =\\frac{|21|}{\\sqrt{49}} \\\\  & =\\frac{21}{7} \\\\  & =3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233427 :knowledge-point/_questions [{:db/id #edb/ref 17592186152234 :knowledge-point/id #uuid "35453324-c2ff-5be4-86aa-70b3085154dc" :knowledge-point/title "Interpreting Information From a Scatter Plot"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e44ae12f-0b74-5b85-b272-52f6fe887a7b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462205} {:answer/id #uuid "c3f68198-6097-5921-84e3-218cc095e481" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462206}] :answer-field/correct {:answer/id #uuid "c3f68198-6097-5921-84e3-218cc095e481" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462206} :answer-field/id #uuid "9052a68f-40dc-53f5-bc24-4cb1f9880825" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462856} {:answer-field/choices [{:answer/id #uuid "4ebb57d0-682c-5af2-8879-12cb0e479260" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462207} {:answer/id #uuid "d329c3da-4d09-578c-b937-1eb45e6e0c3b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462208}] :answer-field/correct {:answer/id #uuid "d329c3da-4d09-578c-b937-1eb45e6e0c3b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462208} :answer-field/id #uuid "4a5413e6-6478-549b-bfc3-9a0cf468f957" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462857} {:answer-field/choices [{:answer/id #uuid "a94125c3-5304-5a07-8e6e-a33a9346c736" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462209} {:answer/id #uuid "759a777a-6a4c-5f2a-8f83-c615ee391bcd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462210}] :answer-field/correct {:answer/id #uuid "a94125c3-5304-5a07-8e6e-a33a9346c736" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462209} :answer-field/id #uuid "b57bc8e9-1d65-5f7c-838c-d3b9618b92bd" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462858}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3c285e0d-9ca2-5d71-ae56-cfc30b5c536e" :question/math-academy-id "q-134130" :question/problem "![](images/bc/bc3809e55e601738d56be6885475ed442dec1fb3a0d2e19da14be045510f73dc.png)\n\nThe above scatter plot shows the relationship between age and years of experience of a group of professional soccer players. \n\nGiven that none of the points overlap, which of the following statements are true?\n\nI. Only one player has exactly $10$ years of experience.\n\nII. There are two players aged $21.$\n\nIII. None of the players has fewer than $6$ years of experience.\n\nSelect all that apply." :question/worked-solution "Let's examine our scatter plot.\n\n- Statement I is true. The scatter plot has only one dot whose vertical coordinate equals $10,$ namely, $(21,10).$ This means only one of the players has exactly $10$ years of experience.\n\n![](images/20/209759f5d70fd8587740d1da840f9da838a3c9a055a0d1e962f76c1cd6341fd3.png)\n\n- Statement II is true. The scatter plot has two dots whose horizontal coordinate equals $21,$ namely, $(21,10)$ and $(21,12).$ This means that two players are $21$ years old.\n\n![](images/75/753c503d6751363b1c7d2dc449f1c5f11baec159b1e938e8c807938512111750.png)\n\n- Statement III is false. From the scatter plot, one player has fewer than $6$ years of experience. The dot below the horizontal line represents this player.\n\n![](images/66/66facd1a0683f420aa2ac3d7bfd54290bdb009850bc66cc7523ee569ec81daea.png)\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186410421 :knowledge-point/_questions [{:db/id #edb/ref 17592186054628 :knowledge-point/id #uuid "0e8b25b3-5cc4-51b7-8ff9-fc1773797ad4" :knowledge-point/title "Evaluating the Sum or Difference of Two Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "227b5733-3404-5771-9605-7aa40c072b17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-6" :db/id #edb/ref 17592186410227} {:answer/id #uuid "9a1dad57-e593-551e-8c2e-8e04cb1031ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-x+8" :db/id #edb/ref 17592186410301} {:answer/id #uuid "9baac897-f09d-582f-b1da-3a9c62f28f48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+8" :db/id #edb/ref 17592186410302} {:answer/id #uuid "ad391d1e-b265-5dea-b25b-f4b234954d14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5x+8" :db/id #edb/ref 17592186410321} {:answer/id #uuid "f6c024e0-14f1-55cd-b9c7-b885fa85f645" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+6" :db/id #edb/ref 17592186410367}] :answer-field/correct {:answer/id #uuid "9baac897-f09d-582f-b1da-3a9c62f28f48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+8" :db/id #edb/ref 17592186410302} :answer-field/id #uuid "7011823c-cf5d-51f9-9bd3-0486581bd8c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186410390}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "340eeb23-68bd-5b4a-ac71-e640f063960b" :question/math-academy-id "q-13589" :question/problem "If $f(x)=-2x+1$ and $g(x)=-3x-7,$ then $(f-g)(x)=$" :question/worked-solution "The notation $(f-g)(x)$ means the difference of the functions $f(x)$ and $g(x).$\n\nTo find the difference of the two functions, we subtract $g(x)$ from $f(x):$\n\n$$\n\\begin{aligned}(f-g)(x) & =f(x)-g(x) \\\\  & =(-2x+1)-(-3x-7) \\\\  & =(-2x-(-3x))+(1-(-7)) \\\\  & =x+8\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186410419 :knowledge-point/_questions [{:db/id #edb/ref 17592186064308 :knowledge-point/id #uuid "94a2b8cb-aca4-5e18-bb5c-71c0738c9e30" :knowledge-point/title "Differentiating a Function Raised to the Power of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11871c64-6368-59c5-9ec4-a19994f69e2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(\\operatorname{cos}⁡x)-x{tan}^{2}⁡x" :db/id #edb/ref 17592186410216} {:answer/id #uuid "543a59b8-c1fa-5f13-aee5-fec0cb00f970" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(\\operatorname{cos}⁡x)-\\operatorname{tan}⁡x" :db/id #edb/ref 17592186410262} {:answer/id #uuid "80147df6-2320-55c9-944a-766dbd01c6c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(\\operatorname{cos}⁡x)-x\\operatorname{tan}⁡x" :db/id #edb/ref 17592186410284} {:answer/id #uuid "9c2b317b-6389-5a05-8b28-b44cfeff3161" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(\\operatorname{cos}⁡x)+x\\operatorname{tan}⁡x" :db/id #edb/ref 17592186410304} {:answer/id #uuid "b4326574-8b69-5df3-9063-abf1241c8efd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(\\operatorname{cos}⁡x)+5x\\operatorname{tan}⁡x" :db/id #edb/ref 17592186410325}] :answer-field/correct {:answer/id #uuid "80147df6-2320-55c9-944a-766dbd01c6c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(\\operatorname{cos}⁡x)-x\\operatorname{tan}⁡x" :db/id #edb/ref 17592186410284} :answer-field/id #uuid "19581f53-386c-55c5-88ff-b5d2b3116bb1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186410377}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "29625a08-0232-5ce8-97e1-f2bb9cf1a9d3" :question/math-academy-id "q-138856" :question/problem "Consider the function $y=(\\operatorname{cos}⁡x)^{5x}.$ Its derivative is given by\n\n$$\n{y}^{′}=5(\\operatorname{cos}⁡x)^{5x}\\cdot g(x).\n$$\n\nFind the function $g(x).$" :question/worked-solution "We have the function \n\n$$\ny=(\\operatorname{cos}⁡x)^{5x}.\n$$\n\nFirst, we take the natural logarithm of both sides:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡((\\operatorname{cos}⁡x)^{5x}) \\\\ \\operatorname{ln}⁡y & =5x\\,\\operatorname{ln}⁡(\\operatorname{cos}⁡x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(5x\\operatorname{ln}⁡(\\operatorname{cos}⁡x)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =(5x)^{′}\\cdot (\\operatorname{ln}⁡(\\operatorname{cos}⁡x))+(5x)\\cdot {(\\operatorname{ln}⁡(\\operatorname{cos}⁡x))}^{′} \\\\ \\frac{1}{y}\\cdot {y}^{′} & =5\\cdot \\operatorname{ln}⁡(\\operatorname{cos}⁡x)+5x\\cdot (\\frac{1}{\\operatorname{cos}⁡x}\\cdot (-\\operatorname{sin}⁡x)) \\\\ \\frac{{y}^{′}}{y} & =5\\operatorname{ln}⁡(\\operatorname{cos}⁡x)-5x\\operatorname{tan}⁡x \\\\ \\frac{{y}^{′}}{y} & =5(\\operatorname{ln}⁡(\\operatorname{cos}⁡x)-x\\operatorname{tan}⁡x)\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(5(\\operatorname{ln}⁡(\\operatorname{cos}⁡x)-x\\operatorname{tan}⁡x))\\end{aligned}\n$$\n\nFinally, we substitute $y=(\\operatorname{cos}⁡x)^{5x}:$\n\n$$\n\\begin{aligned}{y}^{′} & =5(\\operatorname{cos}⁡x)^{5x}(\\operatorname{ln}⁡(\\operatorname{cos}⁡x)-x\\operatorname{tan}⁡x)\\end{aligned}\n$$\n\nTherefore, $g(x)=\\operatorname{ln}⁡(\\operatorname{cos}⁡x)-x\\operatorname{tan}⁡x.$"}] [{:db/id #edb/ref 17592186233458 :knowledge-point/_questions [{:db/id #edb/ref 17592186068721 :knowledge-point/id #uuid "bdded031-fd95-5a7f-92d4-c0d6713ba64d" :knowledge-point/title "Calculating the Distance Between Two Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "142f6241-66f6-54d0-b0aa-33cc38a79cba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{5}" :db/id #edb/ref 17592186410217} {:answer/id #uuid "28157bc9-459b-5bb6-9317-6dc9a2f6179b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{3}" :db/id #edb/ref 17592186410232} {:answer/id #uuid "8a88a1d7-e73f-5810-852c-a2aab33a52fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\sqrt{3}" :db/id #edb/ref 17592186410290} {:answer/id #uuid "be5b9233-71d8-5147-8850-d2afc6af5851" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{7}" :db/id #edb/ref 17592186410331} {:answer/id #uuid "ff6c6821-8ec9-522c-8595-99d5e2fe6bcf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\sqrt{3}" :db/id #edb/ref 17592186410374}] :answer-field/correct {:answer/id #uuid "ff6c6821-8ec9-522c-8595-99d5e2fe6bcf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\sqrt{3}" :db/id #edb/ref 17592186410374} :answer-field/id #uuid "c0d74992-ead3-52ac-9022-88bf70fd0973" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186410407}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "20c93a82-e610-599d-874a-ddfeea4ed232" :question/math-academy-id "q-14152" :question/problem "What is the distance between the points $(-\\sqrt{3},2\\sqrt{3})$ and $(3\\sqrt{3},5\\sqrt{3})?$" :question/worked-solution "In this case, we have ${{(-\\sqrt{3},2\\sqrt{3})}_{⏟}}_{\\text{(}{x}_{1}\\text{,}\\,{y}_{1})}$ and ${{(3\\sqrt{3},5\\sqrt{3})}_{⏟}}_{\\text{(}{x}_{2}\\text{,}\\,{y}_{2})}.$\nSo, the distance $d$ can be calculated using the distance formula, as follows:\n\n$$\n\\begin{aligned}d & =\\sqrt{({x}_{2}-{x}_{1})^{2}+({y}_{2}-{y}_{1})^{2}} \\\\  & =\\sqrt{{(3\\sqrt{3}-(-\\sqrt{3}))}^{2}+{(5\\sqrt{3}-2\\sqrt{3})}^{2}} \\\\  & =\\sqrt{(4\\sqrt{3})^{2}+(3\\sqrt{3})^{2}} \\\\  & =\\sqrt{16(3)+9(3)} \\\\  & =\\sqrt{48+27} \\\\  & =\\sqrt{75} \\\\  & =5\\sqrt{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186410436 :knowledge-point/_questions [{:db/id #edb/ref 17592186162154 :knowledge-point/id #uuid "900dcaf8-da39-5654-96cd-6aec89e379c9" :knowledge-point/title "Calculating Joint Probabilities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "256a3727-6321-59c1-b1c7-369f5a6a1518" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.175" :db/id #edb/ref 17592186410229} {:answer/id #uuid "9bddfe86-7dc6-5540-86c3-4723fffc868b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.03" :db/id #edb/ref 17592186410303} {:answer/id #uuid "a0426c68-78cb-5d58-9ffa-051f3b3cc1cc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Impossible to determine using the given information." :db/id #edb/ref 17592186410310} {:answer/id #uuid "bca06a6d-aa6b-587d-8442-4beee8f01b4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.12" :db/id #edb/ref 17592186410330} {:answer/id #uuid "cd3f228e-be2e-5c06-8182-1cd37eda6203" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.025" :db/id #edb/ref 17592186410343}] :answer-field/correct {:answer/id #uuid "9bddfe86-7dc6-5540-86c3-4723fffc868b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.03" :db/id #edb/ref 17592186410303} :answer-field/id #uuid "b6dc3fd8-a6ca-5e23-b3e1-64455b67f269" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186410403}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cb0efc72-9a29-58c3-a0f2-a7c2e7e96100" :question/math-academy-id "q-143316" :question/problem "The marginal mass functions of the independent discrete random variables $X$ and $Y$ are shown below. Given that the corresponding joint probability mass function is $f(x,y),$ find $f(4,3).$\n\n<table align=\"center\">\n<tbody><tr>\n<th>\n<table align=\"center\" cellpadding=\"10\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"30\">$x$</td>\n<td align=\"center\">$2$</td>\n<td align=\"center\">$4$</td>\n<td align=\"center\">$6$</td>\n</tr>\n<tr>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"30\">${f}_{X}(x)$</td>\n<td align=\"center\">$0.1$</td>\n<td align=\"center\">$0.2$</td>\n<td align=\"center\">$0.7$</td>\n</tr>\n</tbody></table>\n<p></p></th>\n<th width=\"50\"></th>\n<th>\n<table align=\"center\" cellpadding=\"10\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"30\">$y$</td>\n<td align=\"center\">$1$</td>\n<td align=\"center\">$2$</td>\n<td align=\"center\">$3$</td>\n</tr>\n<tr>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"30\">${f}_{Y}(y)$</td>\n<td align=\"center\">$0.25$</td>\n<td align=\"center\">$0.6$</td>\n<td align=\"center\">$0.15$</td>\n</tr>\n</tbody></table>\n<p></p></th></tr></tbody></table>" :question/worked-solution "Two discrete random variables $X$ and $Y$ with joint probability mass function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability mass functions for $X$ and $Y,$ respectively.\n\nTherefore, since our discrete random variables are independent, we obtain\n\n$$\n\\begin{aligned}f(4,3) & ={f}_{X}(4)\\cdot {f}_{Y}(3) \\\\  & =0.2\\cdot 0.15 \\\\  & =0.03.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186410430 :knowledge-point/_questions [{:db/id #edb/ref 17592186162108 :knowledge-point/id #uuid "9453a0f1-029b-5436-94c1-47ee311f6e4d" :knowledge-point/title "Calculating an Appropriate Sample Size"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7fa3c38a-049e-59c3-a98c-3e5dbd6f1ba8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186410283} {:answer/id #uuid "8b54b2bf-266b-54ff-a5d4-a1ac6399e630" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186410292} {:answer/id #uuid "a3fe3947-9796-56a3-9f64-a73a496fe76c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,001" :db/id #edb/ref 17592186410315} {:answer/id #uuid "dd64b03b-72a4-5d77-bbef-f658fdcb9c0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "178" :db/id #edb/ref 17592186410352} {:answer/id #uuid "e069f6a1-671b-5f98-9ba7-f48db9f9cb74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "101" :db/id #edb/ref 17592186410354}] :answer-field/correct {:answer/id #uuid "e069f6a1-671b-5f98-9ba7-f48db9f9cb74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "101" :db/id #edb/ref 17592186410354} :answer-field/id #uuid "9c59848f-dfee-5b4c-8761-3808942e6743" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186410396}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8503a82e-cf30-5876-b2c2-50de2ef2f695" :question/math-academy-id "q-143441" :question/problem "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ drawn from a population with mean $\\mu =4$ and variance ${\\sigma }^{2}=9,$  determine the smallest sample size required so that the standard error of the mean is less than $0.3.$" :question/worked-solution "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ from a population with population mean $\\mu $ and population variance ${\\sigma }^{2},$ then\n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu ,\\,\\text{Var}[\\overset{―}{X}]=\\frac{{\\sigma }^{2}}{n},\n$$\n\nand the standard error is given by\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{\\text{Var}[\\overset{―}{X}]}=\\frac{\\sigma }{\\sqrt{n}}\n$$\n\nSince the population standard deviation is $\\sigma =\\sqrt{9}=3,$ we have that \n\n$$\n\\text{SE}[\\overset{―}{X}]=\\frac{3}{\\sqrt{n}}.\n$$\n\nWe require that the standard error is less than $0.3.$ Therefore\n\n$$\n\\begin{aligned}\\frac{3}{\\sqrt{n}} & <0.3 \\\\ \\sqrt{n} & >\\frac{3}{0.3} \\\\ \\sqrt{n} & >10 \\\\ n & >{10}^{2} \\\\ n & >100.\\end{aligned}\n$$\n\nTherefore, the smallest sample size is $n=101.$"}] [{:db/id #edb/ref 17592186233494 :knowledge-point/_questions [{:db/id #edb/ref 17592186073715 :knowledge-point/id #uuid "0b6b70eb-df57-5d17-a753-645ccdf94945" :knowledge-point/title "Finding the Coordinates of an Endpoint Given the Midpoint"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41846390-6a52-578d-8160-9a5ffe51b3a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186410247} {:answer/id #uuid "524f4e0d-a8f4-5b13-89de-967398ab31ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186410260} {:answer/id #uuid "5d7dda1e-729e-5cf8-8a43-96eadd48414d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186410263} {:answer/id #uuid "6a71db0b-e656-5269-a146-a69fd7acd33c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186410272} {:answer/id #uuid "95aeaeed-6ae9-5f05-9597-b35749ede8a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186410299}] :answer-field/correct {:answer/id #uuid "524f4e0d-a8f4-5b13-89de-967398ab31ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186410260} :answer-field/id #uuid "385783ed-c2b9-5782-a389-7faefeb3d5c8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186410382}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bd717350-e4af-57c0-a511-28912f1d1ece" :question/math-academy-id "q-14365" :question/problem "If the midpoint of the line segment with endpoints $(7,-4)$ and $(a,b)$ is $(2,1),$\nthen $a+b=$" :question/worked-solution "The given points are ${{(7,-4)}_{⏟}}_{\\text{(}{x}_{1},\\,{y}_{1})},$ ${{(a,b)}_{⏟}}_{\\text{(}{x}_{2},\\,{y}_{2})}$ and ${{(2,1)}_{⏟}}_{\\text{(}{x}_{m},\\,{y}_{m})}\\,.$\n\nWe use the midpoint formula as follows:\n\n$$\n\\begin{aligned}({x}_{m},{y}_{m}) & =(\\frac{{x}_{1}+{x}_{2}}{2},\\frac{{y}_{1}+{y}_{2}}{2}) \\\\ (2,1) & =(\\frac{7+a}{2},\\frac{-4+b}{2}).\\end{aligned}\n$$\n\nEquating the corresponding $x$- and $y$-coordinates in the equation above gives us\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}2 &=\\frac{7+a}{2} \\\\ 1 &=\\frac{-4+b}{2}\\end{aligned}\\right.\\,⇒\\,\\left\\{\\begin{aligned}a &=-3 \\\\ b &=6.\\end{aligned}\\right.\\end{aligned}\n$$\n\nThus, $(a,b)=(-3,6)$ and $a+b=3.$"}] [{:db/id #edb/ref 17592186410426 :knowledge-point/_questions [{:db/id #edb/ref 17592186176042 :knowledge-point/id #uuid "ebfe6309-b8a3-5e4c-b2ae-495a91bcc433" :knowledge-point/title "Calculating Higher Moments of a Random Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05d0bed3-2f44-5147-8b11-1799b1a77a53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{4}" :db/id #edb/ref 17592186410207} {:answer/id #uuid "164c9de6-1afb-5748-ad52-794c0b12deda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{4}" :db/id #edb/ref 17592186410219} {:answer/id #uuid "2ed70e6b-a2cd-51da-96fd-f5a213dd7fd1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{4}" :db/id #edb/ref 17592186410239} {:answer/id #uuid "7db5c39d-db73-5155-8d2f-1ed953fb569c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186410282} {:answer/id #uuid "cb9f5533-060f-5f5e-99fa-71a91f1849d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186410340}] :answer-field/correct {:answer/id #uuid "05d0bed3-2f44-5147-8b11-1799b1a77a53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{4}" :db/id #edb/ref 17592186410207} :answer-field/id #uuid "b124b7e8-f665-5416-a587-c5c709c95b52" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186410401}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "803f66d6-b1cb-5f24-9bcd-afd86a0fb084" :question/math-academy-id "q-143802" :question/problem "A random variable $X$ has the probability distribution given below.\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{2}, & x=0 \\\\ \\frac{1}{4}, & x=1 \\\\ \\frac{1}{4}, & x=2\\end{aligned}\n$$\n\nCalculate $\\text{E}[{X}^{3}].$" :question/worked-solution "If $X$ is a discrete random variable with probability mass function $f(x)$ and sample space $S,$ the expected value of ${X}^{3}$ is given by\n\n$$\n\\text{E}[{X}^{3}]={\\sum }_{x\\in S}{x}^{3}\\cdot f(x).\n$$\n\nSumming up the products of each cubed value of $X$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[{X}^{3}] & ={\\sum }_{x\\in S}{x}^{3}\\cdot f(x) \\\\  & ={0}^{3}\\cdot \\frac{1}{2}+{1}^{3}\\cdot \\frac{1}{4}+{2}^{3}\\cdot \\frac{1}{4} \\\\  & =0\\cdot \\frac{1}{2}+1\\cdot \\frac{1}{4}+8\\cdot \\frac{1}{4} \\\\  & =0+\\frac{1}{4}+2 \\\\  & =\\frac{9}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233501 :knowledge-point/_questions [{:db/id #edb/ref 17592186054847 :knowledge-point/id #uuid "dfdb93d1-d550-5939-8a47-99bd1d863a8c" :knowledge-point/title "Determining an Intercept of a Tangent or Normal Line to a Curve Given in Implicit Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b71c047d-d0a4-59a9-94d3-e9b03771936d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,\\,-2)" :db/id #edb/ref 17592186410327} {:answer/id #uuid "cda0515f-1f4d-516f-be38-223dff8af225" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,\\,1)" :db/id #edb/ref 17592186410344} {:answer/id #uuid "d3a2a8e4-cff5-5de9-a017-294e1b3e3090" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,\\,-1)" :db/id #edb/ref 17592186410347} {:answer/id #uuid "e659e298-eaa5-5dc6-b4eb-0351e4a2b803" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,\\,\\frac{1}{2})" :db/id #edb/ref 17592186410358} {:answer/id #uuid "f6d5b8d1-56ce-5658-ab8d-6cb521d7bf4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,\\,-\\frac{1}{2})" :db/id #edb/ref 17592186410368}] :answer-field/correct {:answer/id #uuid "f6d5b8d1-56ce-5658-ab8d-6cb521d7bf4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,\\,-\\frac{1}{2})" :db/id #edb/ref 17592186410368} :answer-field/id #uuid "40bccfca-586d-50c1-9dd5-02226a8edd85" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186410384}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ada3b28b-b3a4-5dcc-bddd-f6c1a31f531f" :question/math-academy-id "q-14614" :question/problem "The equation of a curve is $xy+{x}^{2}=1.$ The normal line at the point $(1,\\,0)$ intersects the $y$-axis at the point $P.$ What are the coordinates of $P?$" :question/worked-solution "First of all, we need to find the slope of the normal line at the point $(1,\\,0).$   Remember that the slope of the normal line, ${m}^{′},$ is the negative reciprocal of the slope of the tangent line:\n\n$$\n{m}^{′}=-\\frac{1}{m}\n$$\n\nTo find the slope of the tangent line, we will calculate the derivative using implicit differentiation, assuming that $y=y(x).$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(xy+{x}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(1) \\\\ \\frac{\\text{d}}{\\text{d}x}(xy)+\\frac{\\text{d}}{\\text{d}x}({x}^{2}) & =0 \\\\ x\\frac{\\text{d}y}{\\text{d}x}+y+2x & =0 \\\\ x\\frac{\\text{d}y}{\\text{d}x} & =-(2x+y) \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{2x+y}{x}\\end{aligned}\n$$\n\nSo, the slope of the tangent at the point $(1,\\,0)$ is \n\n$$\n\\begin{aligned}m & ={(\\frac{\\text{d}y}{\\text{d}x})}_{(1,\\,0)} \\\\  & ={(-\\frac{2x+y}{x})}_{(1,\\,0)} \\\\  & =-\\frac{2\\cdot 1+0}{1} \\\\  & =-2.\\end{aligned}\n$$\n\nTherefore, the slope of the normal line is ${m}^{′}=-\\frac{1}{m}=-\\frac{1}{-2}=\\frac{1}{2}.$ We can write the equation of the normal at the point $(1,\\,0)$ as follows:\n\n$$\n\\begin{aligned}(y-{y}_{1}) & ={m}^{′}(x-{x}_{1}) \\\\ (y-0) & =\\frac{1}{2}(x-1) \\\\ y & =\\frac{1}{2}(x-1)\\end{aligned}\n$$\n\nNow, we just need to find where this normal line intersects the $y$-axis. At the point $P$ the $x$-coordinate is $0,$ so we set $x=0$ and solve for $y:$\n\n$$\n\\begin{aligned}y & =\\frac{1}{2}(x-1) \\\\ y & =\\frac{1}{2}(0-1) \\\\ y & =-\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, the coordinates of $P$ are $(0,\\,-\\frac{1}{2}).$"}] [{:db/id #edb/ref 17592186275200 :knowledge-point/_questions [{:db/id #edb/ref 17592186166848 :knowledge-point/id #uuid "3a4fee2d-88c3-5381-bd55-98990abc7df3" :knowledge-point/title "Solving for an Unknown Conditional Probability"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55719c9a-dcbc-577a-8d18-ef15b0b142fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.923" :db/id #edb/ref 17592186273114} {:answer/id #uuid "5c2b6301-9863-588c-afcf-a1135853ff30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.872" :db/id #edb/ref 17592186273178} {:answer/id #uuid "afce45e8-dac9-5cec-af05-43e0ae761b82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.943" :db/id #edb/ref 17592186273907} {:answer/id #uuid "b30dcdf1-6ef0-5b34-9ff8-48cae2cd50c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.664" :db/id #edb/ref 17592186273933} {:answer/id #uuid "d2736c69-c89a-5244-a3d8-660d1d7a9be2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.885" :db/id #edb/ref 17592186274228}] :answer-field/correct {:answer/id #uuid "b30dcdf1-6ef0-5b34-9ff8-48cae2cd50c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.664" :db/id #edb/ref 17592186273933} :answer-field/id #uuid "c2759a57-ee5d-532e-a24f-4499af67035f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274975}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "cbae7601-74f3-53d4-af26-b2c79a262289" :question/math-academy-id "q-148669" :question/problem "A local newspaper is sold by three distributors, $1,$ $2,$ and $3.$\n\n- Distributor $1$ gets $36%$ of the copies.\n\n- Distributor $2$ gets $23%$ of the copies, and $92%$ of those copies are sold.\n\n- Distributor $3$ gets $41%$ of the copies, and $95%$ of those copies are sold.\n\nIf $3%$ of all copies have some printing defect, $70%$ of defective copies are sold, and $2.5%$ of sold copies are defective, what is the probability that a randomly chosen copy bought by distributor $1$ is sold? Round your answer to $3$ decimal places." :question/worked-solution "Let $R$ be the event that a copy has a printing defect, $S$ be the event that a copy is sold, and ${D}_{1},{D}_{2},{D}_{3}$ be the event that a copy is given to distributor $1,$ $2,$ or $3,$ respectively.\n\nLet's break down the information given in the problem statement:\n\n- From the bullet points, we have the following information:\n\n$$\n\\begin{aligned} & P({D}_{1})=0.36 \\\\  & P({D}_{2})=0.23 &  & P(S|{D}_{2})=0.92 \\\\  & P({D}_{3})=0.41 &  & P(S|{D}_{3})=0.95\\end{aligned}\n$$\n\nThe disjoint union ${D}_{1}⊔{D}_{2}⊔{D}_{3}$ covers the entire sample space, and we have\n\n$$\nP({D}_{1})+P({D}_{2})+P({D}_{3})=0.36+0.23+0.41=1.\n$$\n\n- Since $3%$ of all copies has some printing defect, we have\n\n$$\nP(R)=0.03.\n$$\n\n- Since $70%$ of defective copies are sold, we have\n\n$$\nP(S|R)=0.7.\n$$\n\n- Since $2.5%$ of sold copies are defective, we have\n\n$$\nP(R|S)=0.025.\n$$\n\nWe want to find the probability that a randomly chosen copy bought by distributor $1$ is sold, which is represented as $P(S|{D}_{1}).$ \n\nUsing Bayes' theorem combined with the law of total probability, we have\n\n$$\n\\begin{aligned}P(R|S) & =\\frac{P(S|R)P(R)}{P(S)} \\\\ P(R|S) & =\\frac{P(S|R)P(R)}{P(S|{D}_{1})P({D}_{1})+P(S|{D}_{2})P({D}_{2})+P(S|{D}_{3})P({D}_{3})} \\\\ 0.025 & =\\frac{(0.7)(0.03)}{P(S|{D}_{1})(0.36)+(0.92)(0.23)+(0.95)(0.41)} \\\\ 0.025 & =\\frac{0.021}{0.36P(S|{D}_{1})+0.6011}\\end{aligned}\n$$\n\nSolving this equation for $P(S|{D}_{1}),$ we have\n\n$$\n\\begin{aligned}0.025(0.36P(S|{D}_{1})+0.6011) & =0.021 \\\\ 0.36P(S|{D}_{1})+0.6011 & =\\frac{0.021}{0.025} \\\\ 0.36P(S|{D}_{1})+0.6011 & =\\frac{21}{25} \\\\ 0.36P(S|{D}_{1}) & =\\frac{21}{25}-0.6011 \\\\ P(S|{D}_{1}) & =\\frac{1}{0.36}(\\frac{21}{25}-0.6011) \\\\ P(S|{D}_{1}) & ≈0.664\\end{aligned}\n$$\n\nrounded to three decimal places."}] [{:db/id #edb/ref 17592186281418 :knowledge-point/_questions [{:db/id #edb/ref 17592186179775 :knowledge-point/id #uuid "4e551b65-4116-58bc-b2bc-e536930c69b4" :knowledge-point/title "Identifying the Types of Images Formed by an Affine Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c423a78-0db9-5f90-983b-9dfbb047e9f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A pentagon" :db/id #edb/ref 17592186279124} {:answer/id #uuid "8ea410e2-60c7-51c0-9002-7d8a661b4542" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A point" :db/id #edb/ref 17592186279860} {:answer/id #uuid "e1b22b8d-787b-5280-a5f2-57f6394bbe69" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A triangle" :db/id #edb/ref 17592186280587} {:answer/id #uuid "eb788c5f-15bc-5b4c-bbd8-95a2b365d823" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A line segment" :db/id #edb/ref 17592186280660} {:answer/id #uuid "f7ed7cb4-543a-55f8-a67b-979cd22e5cbe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A quadrilateral" :db/id #edb/ref 17592186280765}] :answer-field/correct {:answer/id #uuid "eb788c5f-15bc-5b4c-bbd8-95a2b365d823" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A line segment" :db/id #edb/ref 17592186280660} :answer-field/id #uuid "228341f6-d27f-56b7-9f4c-9d5fa6515e22" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280890}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ef668553-5d10-5944-a4d2-e24693f30a54" :question/math-academy-id "q-162223" :question/problem "![](images/52/522a51527563645261a3b4c5a1472510bcb3e890fc82d3b4c1b2ccdae59b9dbd.png)\n\nConsider the affine transformation $T,$ given by\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}9 & -3 \\\\ 3 & -1\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}.\n$$\n\n \nWhat would be the image of the rectangle shown above under the action of $T?$" :question/worked-solution "Recall that for any affine transformation \n\n$$\nT:u⟶Au+b,\n$$\n\nwhere $A$ is a $2\\times 2$ matrix and $u$ and $b$ are $2\\times 1$ column vectors, we have one of the following three possibilities:\n\n- If $T$ is non-singular, i.e., when $det(A)\\ne 0,$ then the image of a two-dimensional object is a two-dimensional object. In particular, the image of a polygon with $n$ vertices is a polygon with $n$ vertices.\n\n- If $T$ is singular, i.e., when $det(A)=0,$ we have two additional subcases:\n\n- If $A$ has at least one nonzero entry, then the image of a two-dimensional object is a one-dimensional line segment.\n\n- If $A$ is the zero matrix, then the image of a two-dimensional object is a point on the plane.\n\nWith that in mind, let's examine our transformation.\n\nNotice that the matrix representation of the linear transformation associated with $T$ is \n$A=\\begin{bmatrix}9 & -3 \\\\ 3 & -1\\end{bmatrix}.$\n\nComputing the determinant of $A,$ we obtain\n\n$$\n\\begin{aligned}det(T) & =\\begin{vmatrix}9 & -3 \\\\ 3 & -1\\end{vmatrix} \\\\  & =9\\cdot (-1)-3\\cdot (-3) \\\\  & =0.\\end{aligned}\n$$\n\nSo, we have a singular nonzero matrix. \n\nTherefore, $T$ is non-invertible and the image of the rectangle under the action of $T$ is a line segment."}] [{:db/id #edb/ref 17592186389811 :knowledge-point/_questions [{:db/id #edb/ref 17592186198274 :knowledge-point/id #uuid "6290e701-b4ea-5a86-ab7e-7371c5bdc11e" :knowledge-point/title "Visualizing Unions of Uncountable Families of Indexed Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "af8829ea-eabd-5fae-9578-d03488cfc3af" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/26/26e4af1684065b2127b0d9ec33632128f62a3b2b3aa772b48062ed23708b1b7d.png" :db/id #edb/ref 17592186389813} {:answer/id #uuid "1a0a9aea-b6fe-56e1-a8a9-e3ac81332f35" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/2f/2f3d6fcce069f0b7b7918481b4cda68ba16fbb94dbf3ebe6b6841256470b84ea.png" :db/id #edb/ref 17592186389814} {:answer/id #uuid "a269d017-1375-58cf-b810-de5eeec9412c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/db/db4bea7c2f08abb66318443c88a0504bbfdc3d9597b3f42a8808795ebc78b172.png" :db/id #edb/ref 17592186389815} {:answer/id #uuid "e387bc96-400f-584b-a615-edb0551b66e6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/3b/3b3cefa03d71d99e4b7f3b6852ed36512d2a841a37c558034eac5c4b6870799c.png" :db/id #edb/ref 17592186389816} {:answer/id #uuid "fcb67f6a-535a-53df-a825-cfba0db7f11b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a1/a156cbc15d6841b1d661b77c3b2cf7e6459246e20653da5e461cc6446aded4c6.png" :db/id #edb/ref 17592186389817}] :answer-field/correct {:answer/id #uuid "e387bc96-400f-584b-a615-edb0551b66e6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/3b/3b3cefa03d71d99e4b7f3b6852ed36512d2a841a37c558034eac5c4b6870799c.png" :db/id #edb/ref 17592186389816} :answer-field/id #uuid "6201decc-d007-5bcc-852b-b1b8b5bc7b28" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389812}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f0ade82f-e346-52ab-87f9-cb9aa1c85b6d" :question/math-academy-id "q-177651" :question/problem "Let $I=[0,1]⊂R$ and ${X}_{i}=[-i,i]\\times \\{2i\\}.$ Which of the following represents ${⋃}_{i\\in I}{X}_{i}?$" :question/worked-solution "Recall that the union of a family of indexed sets consists of those elements that belong to *at least one* set:\n\n$$\n{⋃}_{i\\in I}{A}_{i}=\\{x\\,:\\,x\\in {A}_{k}\\,\\,\\text{for at least one}\\,\\,k\\in I\\}\n$$\n\nLet's now write down one of our indexed sets. For example, if $i=0.5,$ we have \n\n$$\n{X}_{0.5}=[-0.5,0.5]\\times \\{1\\}=\\{(k,1)\\,:\\,k\\in [-0.5,0.5]\\}.\n$$\n\nThis represents a horizontal line segment from the point $(-0.5,1)$ to the point $(0.5,1)$ in the coordinate plane, as shown below.\n\n![](images/6c/6c6aafd9ea78868e953340eaab3862491d275972d690e2ceb27c213dadbcaea6.png)\n\nIn general,\n\n$$\n{X}_{i}=[-i,i]\\times \\{2i\\}=\\{(k,2i)\\,:\\,k\\in [-i,i]\\}\n$$\n\nis the horizontal line segment from the point $(-i,2i)$ to the point $(i,2i).$ \n\n![](images/02/02c8f93a25d7b510d3e238e6d4a974d6ccc2e83f3ac01fe92ce4535fbb4dce48.png)\n\nAs $i$ runs over $I,$ these line segments sweep the following triangle that represents the union ${⋃}_{i\\in I}{X}_{i}:$\n\n![](images/3b/3b3cefa03d71d99e4b7f3b6852ed36512d2a841a37c558034eac5c4b6870799c.png)"}] [{:db/id #edb/ref 17592186287712 :knowledge-point/_questions [{:db/id #edb/ref 17592186198271 :knowledge-point/id #uuid "26758016-ed47-562a-9338-85c71ffbeaa9" :knowledge-point/title "Sets Defined Using Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0608f7d5-cb5d-5c12-9904-be67e454cb51" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465713} {:answer/id #uuid "b5e2376b-22de-5207-8959-882360f31747" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465714}] :answer-field/correct {:answer/id #uuid "b5e2376b-22de-5207-8959-882360f31747" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465714} :answer-field/id #uuid "9a9244d4-ca29-5b09-ad60-1f882ad66970" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466700} {:answer-field/choices [{:answer/id #uuid "0c75b4b6-2e79-52bd-a819-8ed4e83fe956" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465715} {:answer/id #uuid "e095a3ae-0bbe-5338-98a3-f4b4bf7e6dc4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465716}] :answer-field/correct {:answer/id #uuid "0c75b4b6-2e79-52bd-a819-8ed4e83fe956" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465715} :answer-field/id #uuid "b765a2fa-7d98-5023-a0f1-a961bd05dc4d" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466701} {:answer-field/choices [{:answer/id #uuid "666b4d37-5ccf-50da-8f1a-4bedddc9892b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465717} {:answer/id #uuid "576fb5f4-86dc-5c68-9abb-6fb175b7ba2e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465718}] :answer-field/correct {:answer/id #uuid "576fb5f4-86dc-5c68-9abb-6fb175b7ba2e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465718} :answer-field/id #uuid "fec2b8b6-edfa-5cfb-9457-1478e9b90ba5" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466702}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "614d2565-08b2-5cdc-9df9-02ccb7032ebd" :question/math-academy-id "q-181650" :question/problem "Which of the following sets are infinite?\n\nSelect all that apply.\n\n- **I.** $A=\\{{f}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}(\\operatorname{cos}⁡2x)\\,:\\,n\\in {N}_{0}\\}$\n\n- **II.** $B=\\{{g}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}(-\\operatorname{sin}⁡x)\\,:\\,n\\in {N}_{0}\\}$\n\n- **III.** $C=\\{{h}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}(\\operatorname{sec}⁡x)\\,:\\,n\\in {N}_{0}\\}$" :question/worked-solution "The cardinality of a finite set is the number of elements contained within it. A set is infinite if it has infinitely many elements.\n\n- The set $A$ is infinite. Listing the first few elements of our set, we have the following:\n\n$$\n\\begin{aligned}{f}^{(0)}(x) & =\\operatorname{cos}⁡2x \\\\ {f}^{(1)}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{cos}⁡2x)=-2\\operatorname{sin}⁡2x \\\\ {f}^{(2)}(x) & =\\frac{\\text{d}}{\\text{d}x}(-2\\operatorname{sin}⁡2x)=-4\\operatorname{cos}⁡2x \\\\ {f}^{(3)}(x) & =\\frac{\\text{d}}{\\text{d}x}(-4\\operatorname{cos}⁡2x)=8\\operatorname{sin}⁡2x \\\\ ⋮\\end{aligned}\n$$\n\nThus, we can write our set as follows:\n\n$$\nA=\\{\\operatorname{cos}⁡2x,-2\\operatorname{sin}⁡2x,-4\\operatorname{cos}⁡2x,8\\operatorname{sin}⁡2x,…\\}\n$$\n\nConsequently, $A$ is infinite.\n\n- The set $B$ is finite. Listing the first few elements of our set, we have the following:\n\n$$\n\\begin{aligned}{g}^{(0)}(x) & =-\\operatorname{sin}⁡x \\\\ {g}^{(1)}(x) & =\\frac{\\text{d}}{\\text{d}x}(-\\operatorname{sin}⁡x)=-\\operatorname{cos}⁡x \\\\ {g}^{(2)}(x) & =\\frac{\\text{d}}{\\text{d}x}(-\\operatorname{cos}⁡x)=\\operatorname{sin}⁡x \\\\ {g}^{(3)}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sin}⁡x)=\\operatorname{cos}⁡x \\\\ {g}^{(4)}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{cos}⁡x)=-\\operatorname{sin}⁡x \\\\ ⋮\\end{aligned}\n$$\n\nThus, $B$ contains four elements:\n\n$$\nB=\\{-\\operatorname{sin}⁡x,-\\operatorname{cos}⁡x,\\operatorname{sin}⁡x,\\operatorname{cos}⁡x\\}\n$$\n\nConsequently, $|B|=4,$ which is finite.\n\n- The set $C$ is infinite. Listing the first few elements of our set, we have the following:\n\n$$\n\\begin{aligned}{h}^{(0)}(x) & =\\operatorname{sec}⁡x \\\\ {h}^{(1)}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sec}⁡x)=\\operatorname{sec}⁡x\\operatorname{tan}⁡x \\\\ {h}^{(2)}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sec}⁡x\\operatorname{tan}⁡x)=2{sec}^{3}⁡x-\\operatorname{sec}⁡x \\\\ ⋮\\end{aligned}\n$$\n\nThus, we can write our set as follows:\n\n$$\nC=\\{\\operatorname{sec}⁡x,\\operatorname{sec}⁡x\\operatorname{tan}⁡x,2{sec}^{3}⁡x-\\operatorname{sec}⁡x,…\\}\n$$\n\nConsequently, $C$ is infinite.\n\nTherefore, the correct answer is \"$A$ and $C$ only.\""}] [{:db/id #edb/ref 17592186287732 :knowledge-point/_questions [{:db/id #edb/ref 17592186198466 :knowledge-point/id #uuid "ad21350b-2e3b-57ee-a28c-32a7bd1b2513" :knowledge-point/title "Defining a Set Conditionally Using the Roots of a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f6731372-114d-5789-96c1-8b234a8a8a36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186287047}] :answer-field/correct {:answer/id #uuid "f6731372-114d-5789-96c1-8b234a8a8a36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186287047} :answer-field/id #uuid "19c99cda-0423-547e-950d-64e10d9b76be" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186287193} {:answer-field/choices [{:answer/id #uuid "3a58f260-85bb-5900-91d0-ca3e5d9f962c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186285337}] :answer-field/correct {:answer/id #uuid "3a58f260-85bb-5900-91d0-ca3e5d9f962c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186285337} :answer-field/id #uuid "48256b31-8d1f-5db0-a46f-0fa1f165631b" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186287302} {:answer-field/choices [{:answer/id #uuid "9368e5b0-1f0a-5663-846f-83ac974a77bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186286127}] :answer-field/correct {:answer/id #uuid "9368e5b0-1f0a-5663-846f-83ac974a77bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186286127} :answer-field/id #uuid "7f3589f1-64f3-577c-b73d-b2313f9df647" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186287415}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f1cb23c2-1fc6-50c0-a109-f29b4b4fe8eb" :question/math-academy-id "q-181704" :question/problem "Find the missing coefficients in the conditional definition of the set $\\{2,3-\\text{i},3+\\text{i}\\}$ given below.\n\n$\\{2,3-\\text{i},3+\\text{i}\\}=\\{z\\in C\\,:\\,{z}^{3}\\,-$\n{{field-1}}\n${z}^{2}\\,+$\n{{field-2}}\n$z\\,-$\n{{field-3}}\n$=0\\}$" :question/worked-solution "The given set contains the roots $z\\in C$ of some cubic polynomial $p(z).$\n\nSince the cubic polynomial has roots ${z}_{1}=2,$ ${z}_{2}=3-\\text{i},$ and ${z}_{3}=3+\\text{i},$ and the coefficient of the cubic term is $a=1,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}p(z) & =a(z-{z}_{1})(z-{z}_{2})(z-{z}_{3}) \\\\  & =(1)(z-2)(z-(3-\\text{i}))(z-(3+\\text{i})) \\\\  & =(z-2)({z}^{2}-z(3+\\text{i})-z(3-\\text{i})+(3-\\text{i})(3+\\text{i})) \\\\  & =(z-2)({z}^{2}-6z+10) \\\\  & ={z}^{3}-6{z}^{2}+10z-2{z}^{2}+12z-20 \\\\  & ={z}^{3}-8{z}^{2}+22z-20\\end{aligned}\n$$\n\nTherefore, we can express the given set as\n\n$$\n\\{2,3-\\text{i},3+\\text{i}\\}=\\{z\\in C\\,:\\,{z}^{3}-8{z}^{2}+22z-20=0\\}.\n$$"}] [{:db/id #edb/ref 17592186389975 :knowledge-point/_questions [{:db/id #edb/ref 17592186152053 :knowledge-point/id #uuid "7c49d316-3552-5ace-a749-5070b64230c3" :knowledge-point/title "Completing a Truth Table for a Compound Statement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0077761d-6fff-56d9-aec6-f30e7da5fe11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{F}" :db/id #edb/ref 17592186389977} {:answer/id #uuid "2646912c-011d-5e24-b6eb-4f6d02311fb2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{T}" :db/id #edb/ref 17592186389978}] :answer-f