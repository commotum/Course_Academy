5417] [17592186280890 #edb/ref 1078 #edb/ref 17592186280660 #edb/ref 17592186045417] [17592186280890 #edb/ref 1079 #uuid "228341f6-d27f-56b7-9f4c-9d5fa6515e22" #edb/ref 17592186045417] [17592186281132 #edb/ref 1075 #edb/ref 17592186279170 #edb/ref 17592186045417] [17592186281132 #edb/ref 1075 #edb/ref 17592186279807 #edb/ref 17592186045417] [17592186281132 #edb/ref 1075 #edb/ref 17592186279951 #edb/ref 17592186045417] [17592186281132 #edb/ref 1075 #edb/ref 17592186280479 #edb/ref 17592186045417] [17592186281132 #edb/ref 1075 #edb/ref 17592186280613 #edb/ref 17592186045417] [17592186281132 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186281132 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186281132 #edb/ref 1078 #edb/ref 17592186279807 #edb/ref 17592186045417] [17592186281132 #edb/ref 1079 #uuid "aec2e96d-de39-5f66-aab1-77904959b9e7" #edb/ref 17592186045417] [17592186281418 #edb/ref 1068 #edb/ref 17592186280890 #edb/ref 17592186045417] [17592186281418 #edb/ref 1069 "q-162223" #edb/ref 17592186045417] [17592186281418 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186281418 #edb/ref 1071 "![](images/52/522a51527563645261a3b4c5a1472510bcb3e890fc82d3b4c1b2ccdae59b9dbd.png)\n\nConsider the affine transformation $T,$ given by\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}9 & -3 \\\\ 3 & -1\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}.\n$$\n\n \nWhat would be the image of the rectangle shown above under the action of $T?$" #edb/ref 17592186045443] [17592186281418 #edb/ref 1072 #uuid "ef668553-5d10-5944-a4d2-e24693f30a54" #edb/ref 17592186045417] [17592186281418 #edb/ref 1074 "Recall that for any affine transformation \n\n$$\nT:u⟶Au+b,\n$$\n\nwhere $A$ is a $2\\times 2$ matrix and $u$ and $b$ are $2\\times 1$ column vectors, we have one of the following three possibilities:\n\n- If $T$ is non-singular, i.e., when $det(A)\\ne 0,$ then the image of a two-dimensional object is a two-dimensional object. In particular, the image of a polygon with $n$ vertices is a polygon with $n$ vertices.\n\n- If $T$ is singular, i.e., when $det(A)=0,$ we have two additional subcases:\n\n- If $A$ has at least one nonzero entry, then the image of a two-dimensional object is a one-dimensional line segment.\n\n- If $A$ is the zero matrix, then the image of a two-dimensional object is a point on the plane.\n\nWith that in mind, let's examine our transformation.\n\nNotice that the matrix representation of the linear transformation associated with $T$ is \n$A=\\begin{bmatrix}9 & -3 \\\\ 3 & -1\\end{bmatrix}.$\n\nComputing the determinant of $A,$ we obtain\n\n$$\n\\begin{aligned}det(T) & =\\begin{vmatrix}9 & -3 \\\\ 3 & -1\\end{vmatrix} \\\\  & =9\\cdot (-1)-3\\cdot (-3) \\\\  & =0.\\end{aligned}\n$$\n\nSo, we have a singular nonzero matrix. \n\nTherefore, $T$ is non-invertible and the image of the rectangle under the action of $T$ is a line segment." #edb/ref 17592186045443] [17592186281790 #edb/ref 1080 "18" #edb/ref 17592186045417] [17592186281790 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186281790 #edb/ref 1083 #uuid "0adf79cf-fb4e-5181-93de-3cd6649b8b99" #edb/ref 17592186045417] [17592186282357 #edb/ref 1080 "9" #edb/ref 17592186045417] [17592186282357 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186282357 #edb/ref 1083 #uuid "4d9a26a0-ce05-55c8-b8a8-2ddc2ef5688f" #edb/ref 17592186045417] [17592186282558 #edb/ref 1080 "7\\,840" #edb/ref 17592186045417] [17592186282558 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186282558 #edb/ref 1083 #uuid "65208b93-73ae-599e-971c-64b018afa556" #edb/ref 17592186045417] [17592186282686 #edb/ref 1080 "1\\,810" #edb/ref 17592186045417] [17592186282686 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186282686 #edb/ref 1083 #uuid "74e530a2-a937-5e05-b662-e5de993a3efc" #edb/ref 17592186045417] [17592186282945 