#{[{:activity/expected-seconds 1140.0 :activity/first-step {:db/id #edb/ref 17592186167781} :activity/id #uuid "b36ed83a-cc37-5ff2-a68e-2a0e28c0b24e" :activity/scope {:db/id #edb/ref 17592186048270 :topic/id #uuid "8e43115f-4416-5ec0-b698-3e53a959567b" :topic/math-academy-id 3286} :activity/steps [{:db/id #edb/ref 17592186167713 :step/content {:db/id #edb/ref 17592186166847 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166697 :question/id #uuid "699d9c0c-bb98-5710-8d98-10b6f35ab202" :question/math-academy-id "e-8911"} :knowledge-point/id #uuid "e9d77603-c824-5160-80fc-3d10353fe243" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048412} {:db/id #edb/ref 17592186049605}] :knowledge-point/questions [{:db/id #edb/ref 17592186167115} {:db/id #edb/ref 17592186167116} {:db/id #edb/ref 17592186487306} {:db/id #edb/ref 17592186487321} {:db/id #edb/ref 17592186487345} {:db/id #edb/ref 17592186487380} {:db/id #edb/ref 17592186524964} {:db/id #edb/ref 17592186524987} {:db/id #edb/ref 17592186549984}] :knowledge-point/title "Computing a Conditional Probability Using Bayes' Theorem"} :step/id #uuid "7e6025e7-7c05-542d-a78a-f9d7e627be29" :step/math-academy-id 33287 :step/next {:db/id #edb/ref 17592186167772}} {:db/id #edb/ref 17592186167714 :step/content {:db/id #edb/ref 17592186166848 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166698 :question/id #uuid "284f5029-19eb-53d4-a3b7-0f66d33b9cc9" :question/math-academy-id "e-8912"} :knowledge-point/id #uuid "3a4fee2d-88c3-5381-bd55-98990abc7df3" :knowledge-point/questions [{:db/id #edb/ref 17592186167117} {:db/id #edb/ref 17592186167119} {:db/id #edb/ref 17592186275200} {:db/id #edb/ref 17592186487319} {:db/id #edb/ref 17592186487354} {:db/id #edb/ref 17592186487355} {:db/id #edb/ref 17592186487367} {:db/id #edb/ref 17592186487403} {:db/id #edb/ref 17592186493912} {:db/id #edb/ref 17592186493967} {:db/id #edb/ref 17592186549938}] :knowledge-point/title "Solving for an Unknown Conditional Probability"} :step/id #uuid "fd5da403-f379-5dee-9a50-ecafcf083c36" :step/math-academy-id 33288} {:db/id #edb/ref 17592186167772 :step/content {:db/id #edb/ref 17592186166877 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166482 :question/id #uuid "bc694d40-d150-55e6-981f-0ca6b5d91e21" :question/math-academy-id "e-10418"} :knowledge-point/id #uuid "6c467adb-9d0e-5b33-b81e-4959e2703535" :knowledge-point/questions [{:db/id #edb/ref 17592186167052} {:db/id #edb/ref 17592186167118} {:db/id #edb/ref 17592186487295} {:db/id #edb/ref 17592186487323} {:db/id #edb/ref 17592186487326} {:db/id #edb/ref 17592186487364} {:db/id #edb/ref 17592186487402} {:db/id #edb/ref 17592186493903} {:db/id #edb/ref 17592186524963} {:db/id #edb/ref 17592186525053} {:db/id #edb/ref 17592186525062} {:db/id #edb/ref 17592186549926}] :knowledge-point/title "Applying Bayes’ Theorem to a Situation in Context"} :step/id #uuid "7a97606a-98ac-50e6-9e3c-78ae18820b2e" :step/math-academy-id 39256 :step/next {:db/id #edb/ref 17592186167714}} {:db/id #edb/ref 17592186167781 :step/content {:db/id #edb/ref 17592186168143 :tutorial/content "In this lesson, we will generalize Bayes' theorem to deal with situations where the sample space $\\mathcal S$ is partitioned into a disjoint union of multiple events. \n\nSuppose we have three events $A_1,A_2,$ and $A_3$ that form a disjoint union of the sample space $\\mathcal S,$ as shown below.\n\n![](images/89/89a78ef526fcd29a59bacd4d6ae1a456a596d6616af7453f1ba530a610d9a2ac.png)\n\n \n\nNow consider an event $B$ that also lies in the sample space:\n\n![](images/da/daa96423e45f9f80897e2c2d61177eab2faff77f440921866d1b81b7ef2cfe09.png)\n\n \n\nBayes' theorem states that\n\n$$\nP(A_1|B)=\\dfrac{P(B|A_1)P(A_1)}{P(B)}.\n$$\n\nNow, the law of total probability tells us that\n\n$$\nP(B)=P(B|A_1)P(A_1) + P(B|A_2)P(A_2) + P(B|A_3)P(A_3).\n$$\n\nSubstituting this into Bayes' theorem, we get\n\n$$\nP(A_1 | B) = \\dfrac{P(B|A_1) P(A_1)}{P(B|A_1)P(A_1) + P(B|A_2)P(A_2) + P(B|A_3)P(A_3)} .\n$$\n\nUsing similar arguments, we can say that for $A_k$ for $k=1,2,3,$ we have\n\n$$\nP(A_k | B) = \\dfrac{P(B|A_k) P(A_k)}{P(B|A_1)P(A_1) + P(B|A_2)P(A_2) + P(B|A_3)P(A_3)}\n$$\n\nwhich is usually written more compactly as\n\n$$\nP(A_k | B) = \\dfrac{P(B|A_k) P(A_k)}{\\sum_{i=1}^3 P(B|A_i)P(A_i)}.\n$$\n\nIt's easy to see how this generalizes. If the disjoint union $A_1 \\sqcup A_2 \\sqcup \\ldots \\sqcup A_n$ covers the entire sample space, Bayes' theorem combined with the law of total probability gives us the following:\n\n$$\nP(A_k | B) = \\dfrac{P(B|A_k) P(A_k)}{\\sum_{i=1}^n P(B|A_i)P(A_i)}\n$$\n\nLet's see an example of how to apply this theorem." :tutorial/id #uuid "bf17685f-9890-54cc-b8a2-15815558e87a" :tutorial/math-academy-id 6969 :tutorial/title "Introduction"} :step/id #uuid "b6bd91e8-6598-5c56-9fa4-bf1144fc830d" :step/math-academy-id 42168 :step/next {:db/id #edb/ref 17592186167713}}] :activity/title "Extending Bayes' Theorem" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186167047}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186494026} :activity/id #uuid "cebad3dd-e992-52ed-b284-8c84be80cca2" :activity/scope {:db/id #edb/ref 17592186048270 :topic/id #uuid "8e43115f-4416-5ec0-b698-3e53a959567b" :topic/math-academy-id 3286} :activity/steps [{:db/id #edb/ref 17592186493998 :step/content {:db/id #edb/ref 17592186167118 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88acdedb-86f7-5376-9663-ed92e647a982" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.174" :db/id #edb/ref 17592186163787} {:answer/id #uuid "b8298e93-12cb-5948-9b0c-4d75b7d3a684" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.199" :db/id #edb/ref 17592186163788} {:answer/id #uuid "cca46cae-3f7b-5c75-a82f-2a44e0f21afb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.203" :db/id #edb/ref 17592186163789} {:answer/id #uuid "1bae2866-554f-511e-86e4-7f2ca81b63aa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.13" :db/id #edb/ref 17592186163790} {:answer/id #uuid "7352704f-f734-5a12-b655-8b2ef85bf0d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.191" :db/id #edb/ref 17592186163791}] :answer-field/correct {:db/id #edb/ref 17592186163788} :answer-field/id #uuid "42a0e7e2-d14d-5d36-a9fb-b4d391b04b02" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186163786}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "dea495bf-07d9-54cd-baea-bb953539d3dd" :question/math-academy-id "q-148673" :question/problem "Arthur and Sara are finding the best recipe for chocolate muffins, and they test three different oven cooking modes, mode $1,$ mode $2,$ and mode $3.$ They also try two types of yeast, A and B.\n\n- They use mode $1$ to cook the $30%$ of their muffins, and $90%$ of those muffins turn out well.\n\n- They use mode $2$ to cook the $40%$ of their muffins, and $85%$ of those muffins turn out well.\n\n- They use mode $3$ to cook the $30%$ of their muffins, and $88%$ of those muffins turn out well.\n\nIf $20%$ of all muffins was prepared with yeast A, and $87%$ of yeast A muffins turn out well, what is the probability that a randomly chosen good muffin is done with yeast A? Round your answer to $3$ decimal places." :question/requires-calculator true :question/worked-solution "Let $A$ be the event that a muffin is made with yeast A, $G$ be the event that a muffin turns out well, and ${M}_{1},{M}_{2},{M}_{3}$ be the event that a muffin is cooked with mode $1,$ $2,$ or $3,$ respectively. \n\nLet's break down the information given in the problem statement:\n\n- From the bullet points, we have the following information:\n\n$$\n\\begin{aligned} & P({M}_{1})=0.3 &  & P(G|{M}_{1})=0.9 \\\\  & P({M}_{2})=0.4 &  & P(G|{M}_{2})=0.85 \\\\  & P({M}_{3})=0.3 &  & P(G|{M}_{3})=0.88\\end{aligned}\n$$\n\nThe disjoint union ${M}_{1}⊔{M}_{2}⊔{M}_{3}$ covers the entire sample space, and we have\n\n$$\nP({M}_{1})+P({M}_{2})+P({M}_{3})=0.3+0.4+0.3=1.\n$$\n\n- Since $20%$ of muffins are made with yeast A, we have\n\n$$\nP(A)=0.2.\n$$\n\n- Since $87%$ of muffins made with yeast A turn out well, we have\n\n$$\nP(G|A)=0.87.\n$$\n\nWe want to find the probability that a randomly chosen good muffin is made with yeast A, which is represented as $P(A|G).$ \n\nUsing Bayes' theorem combined with the law of total probability, we have\n\n$$\n\\begin{aligned}P(A|G) & =\\frac{P(G|A)P(A)}{P(G)} \\\\  & =\\frac{P(G|A)P(A)}{P(G|{M}_{1})P({M}_{1})+P(G|{M}_{2})P({M}_{2})+P(G|{M}_{3})P({M}_{3})} \\\\  & =\\frac{(0.87)(0.2)}{(0.9)(0.3)+(0.85)(0.4)+(0.88)(0.3)} \\\\  & =\\frac{0.174}{0.874} \\\\  & ≈0.199,\\end{aligned}\n$$\n\nrounded to $3$ decimal places."} :step/id #uuid "444842eb-2ff5-586c-acce-f30990803c2c" :step/next {:db/id #edb/ref 17592186494071}} {:db/id #edb/ref 17592186494026 :step/content {:db/id #edb/ref 17592186167117 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c5c4998-4883-5ba4-a08f-5c9044a9ad93" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.584" :db/id #edb/ref 17592186163781} {:answer/id #uuid "a9eec898-008f-5aeb-9d82-da5f4e5795a7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.642" :db/id #edb/ref 17592186163782} {:answer/id #uuid "c1f06ee9-62a4-5d90-a2a6-5b8a41e3e676" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.527" :db/id #edb/ref 17592186163783} {:answer/id #uuid "088444df-24a0-506a-90eb-e82abac77d6a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.621" :db/id #edb/ref 17592186163784} {:answer/id #uuid "4988a61c-c2b9-57dd-87f0-60ed10f9fa86" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.592" :db/id #edb/ref 17592186163785}] :answer-field/correct {:db/id #edb/ref 17592186163785} :answer-field/id #uuid "4141da06-c478-52fb-832c-70aa2c84d531" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186163780}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e39e7e2c-b39e-5302-b92e-8f13f6ffd98c" :question/math-academy-id "q-147235" :question/problem "The students in a particular school are split among three classes, class $1,$ class $2,$ and class $3.$\n\n- Class $1$ contains $25%$ of the students in the school, and $55%$ of those students take biology.\n\n- Class $2$ contains $35%$ of the students in the school, and $40%$ of those students take biology.\n\n- Class $3$ contains $40%$ of the students in the school.\n\nIf $45%$ of students in the entire school are female, $80%$ of female students take biology, and $70%$ of biology students are female, what is the probability that a randomly selected student from class $3$ takes biology? Round your answer to $3$ decimal places." :question/requires-calculator true :question/worked-solution "Let $F$ be the event that a student is female, $B$ be the event that a student takes biology, and ${C}_{1},{C}_{2},{C}_{3}$ be the event that a student is in class $1,$ $2,$ or $3,$ respectively. \n\nLet's break down the information given in the problem statement:\n\n- From the bullet points, we have the following information:\n\n$$\n\\begin{aligned} & P({C}_{1})=0.25 &  & P(B|{C}_{1})=0.55 \\\\  & P({C}_{2})=0.35 &  & P(B|{C}_{2})=0.4 \\\\  & P({C}_{3})=0.4\\end{aligned}\n$$\n\nThe disjoint union ${C}_{1}⊔{C}_{2}⊔{C}_{3}$ covers the entire sample space, and we have\n\n$$\nP({C}_{1})+P({C}_{2})+P({C}_{3})=0.25+0.35+0.4=1.\n$$\n\n- Since $45%$ of students in the entire school are female, we have\n\n$$\nP(F)=0.45.\n$$\n\n- Since $80%$ of females take biology, we have\n\n$$\nP(B|F)=0.8.\n$$\n\n- Since $70%$ of biology students are female, we have\n\n$$\nP(F|B)=0.7.\n$$\n\nWe want to find the probability that a randomly chosen student from class $3$ takes biology, which is represented as $P(B|{C}_{3}).$ \n\nUsing Bayes' theorem combined with the law of total probability, we have\n\n$$\n\\begin{aligned}P(F|B) & =\\frac{P(B|F)P(F)}{P(B)} \\\\ P(F|B) & =\\frac{P(B|F)P(F)}{P(B|{C}_{1})P({C}_{1})+P(B|{C}_{2})P({C}_{2})+P(B|{C}_{3})P({C}_{3})} \\\\ 0.7 & =\\frac{(0.8)(0.45)}{(0.55)(0.25)+(0.4)(0.35)+P(B|{C}_{3})(0.4)} \\\\ 0.7 & =\\frac{0.36}{0.2775+0.4P(B|{C}_{3})}.\\end{aligned}\n$$\n\nSolving this equation for $P(B|{C}_{3}),$ we have\n\n$$\n\\begin{aligned}0.7(0.2775+0.4P(B|{C}_{3})) & =0.36 \\\\ 0.2775+0.4P(B|{C}_{3}) & =\\frac{0.36}{0.7} \\\\ 0.2775+0.4P(B|{C}_{3}) & =\\frac{18}{35} \\\\ 0.4P(B|{C}_{3}) & =\\frac{18}{35}-0.2775 \\\\ P(B|{C}_{3}) & =\\frac{1}{0.4}(\\frac{18}{35}-0.2775) \\\\ P(B|{C}_{3}) & ≈0.592\\end{aligned}\n$$\n\nrounded to three decimal places."} :step/id #uuid "84fa05d5-af97-59d8-b33c-dd583737eabb" :step/next {:db/id #edb/ref 17592186494060}} {:db/id #edb/ref 17592186494049 :step/content {:db/id #edb/ref 17592186493903 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0efdb1e8-9c52-52d4-b930-051a0d37a2ac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.08" :db/id #edb/ref 17592186493415} {:answer/id #uuid "0fd36a06-2c0d-5867-b8fb-b56a3f2b9dcd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.369" :db/id #edb/ref 17592186493416} {:answer/id #uuid "9664ae4b-b407-5bfc-92af-7d685fbf9717" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.431" :db/id #edb/ref 17592186493626} {:answer/id #uuid "bd528e4f-8665-5726-9e95-265f3f2fbb42" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.235" :db/id #edb/ref 17592186493702} {:answer/id #uuid "e4fb6fc7-b587-569b-b74c-57c52fc7da96" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.35" :db/id #edb/ref 17592186493756}] :answer-field/correct {:db/id #edb/ref 17592186493626} :answer-field/id #uuid "ae7e24b9-313e-560b-9e0c-e4316aa55761" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186493862}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2ad5265b-a872-53d0-b3f1-65585e111dd6" :question/math-academy-id "q-149494" :question/problem "In a nature park, there are $4$ species of squirrels, each with the same population.\n\n- Among the squirrels of species $1,$ $12%$ are born in captivity.\n\n- Among the squirrels of species $2,$ $5%$ are born in captivity.\n\n- Among the squirrels of species $3,$ $6%$ are born in captivity.\n\n- Among the squirrels of species $4,$ $3%$ are born in captivity.\n\nIf $35%$ of the squirrels are adult females, and $8%$ of the adult female squirrels are born in captivity, what is the probability that a randomly chosen squirrel born in captivity is an adult female? Round your answer to $3$ decimal places." :question/worked-solution "Let $F$ be the event that a squirrel is an adult female, $C$ be the event that a squirrel is born in captivity, and ${S}_{1},{S}_{2},{S}_{3},{S}_{4}$ be the event that a squirrel is of species $1,$ $2,$ $3,$ or $4,$ respectively. \n\nLet's break down the information given in the problem statement:\n\n- Each species has the same number of squirrels, so we have the following information:\n\n$$\n\\begin{aligned}P({S}_{1})=P({S}_{2})=P({S}_{3})=P({S}_{4})=0.25\\end{aligned}\n$$\n\n- From the bullet points, we have the following information:\n\n$$\n\\begin{aligned} & P(C|{S}_{1})=0.12 \\\\  & P(C|{S}_{2})=0.05 \\\\  & P(C|{S}_{3})=0.06 \\\\  & P(C|{S}_{4})=0.03\\end{aligned}\n$$\n\nThe disjoint union ${S}_{1}⊔{S}_{2}⊔{S}_{3}⊔{S}_{4}$ covers the entire sample space, and we have\n\n$$\nP({S}_{1})+P({S}_{2})+P({S}_{3})+P({S}_{4})=0.25+0.25+0.25+0.25=1.\n$$\n\n- Since $35%$ of the squirrels are adult females, we have\n\n$$\nP(F)=0.35.\n$$\n\n- Since $8%$ of adult females are born in captivity, we have\n\n$$\nP(C|F)=0.08.\n$$\n\nWe want to find the probability that a randomly chosen squirrel born in captivity is an adult female, which is represented as $P(F|C).$ \n\nUsing Bayes' theorem combined with the law of total probability, we have\n\n$$\n\\begin{aligned}P(F|C) & =\\frac{P(C|F)P(F)}{P(C)} \\\\  & =\\frac{P(C|F)P(F)}{P(C|{S}_{1})P({S}_{1})+P(C|{S}_{2})P({S}_{2})+P(C|{S}_{3})P({S}_{3})+P(C|{S}_{3})P({S}_{3})} \\\\  & =\\frac{(0.08)(0.35)}{(0.12)(0.25)+(0.05)(0.25)+(0.06)(0.25)+(0.03)(0.25)} \\\\  & =\\frac{0.028}{0.065} \\\\  & ≈0.431,\\end{aligned}\n$$\n\nrounded to $3$ decimal places."} :step/id #uuid "b32c5a3a-fa6d-50eb-94d9-f684a00e861d"} {:db/id #edb/ref 17592186494060 :step/content {:db/id #edb/ref 17592186493912 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08123d50-e1d2-5e75-87c8-dc4ecec898fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.05" :db/id #edb/ref 17592186493402} {:answer/id #uuid "2315c5ef-ec06-536c-af7c-d82e621541c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.03" :db/id #edb/ref 17592186493448} {:answer/id #uuid "68e491ab-da9f-5329-9aaa-a11a1bebb3d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.047" :db/id #edb/ref 17592186493547} {:answer/id #uuid "75ac382e-a141-5c83-ade6-7dc3a4ffc925" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.035" :db/id #edb/ref 17592186493566} {:answer/id #uuid "e67f42bf-f74e-5283-955d-76c3d0573b19" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.040" :db/id #edb/ref 17592186493760}] :answer-field/correct {:db/id #edb/ref 17592186493760} :answer-field/id #uuid "f3f4b001-3f5d-563e-a82a-efaf92b09aad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186493885}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "39f657eb-aa97-5394-b0e6-ecba3bf80018" :question/math-academy-id "q-148666" :question/problem "A manufacturing company has three sites, factory $1,$ factory $2,$ and factory $3.$ They all produce two types of light bulbs: A and B.\n\n- Factory $1$ produces $45%$ of the entire production, and $5%$ of those bulbs are defective.\n\n- Factory $2$ produces $45%$ of the entire production.\n\n- Factory $3$ produces $10%$ of the entire production, and $1%$ of those bulbs are defective.\n\nIf $57%$ of all light bulbs are of type A, $3%$ of type A light bulbs are defective, and $41%$ of defective light bulbs are of type A, what is the probability that a randomly chosen light bulb from factory $2$ is defective? Round your answer to $3$ decimal places." :question/worked-solution "Let $A$ be the event that a light bulb is of type A, $D$ be the event that a light bulb is defective, and ${F}_{1},{F}_{2},{F}_{3}$ be the event that a light bulb is produced in factory $1,$ $2,$ or $3,$ respectively. \n\nLet's break down the information given in the problem statement:\n\n- From the bullet points, we have the following information:\n\n$$\n\\begin{aligned} & P({F}_{1})=0.45 &  & P(D|{F}_{1})=0.05 \\\\  & P({F}_{2})=0.45 \\\\  & P({F}_{3})=0.1 &  & P(D|{F}_{3})=0.01\\end{aligned}\n$$\n\nThe disjoint union ${F}_{1}⊔{F}_{2}⊔{F}_{3}$ covers the entire sample space, and we have\n\n$$\nP({F}_{1})+P({F}_{2})+P({F}_{3})=0.45+0.45+0.1=1.\n$$\n\n- Since $57%$ of all light bulbs are of type A, we have\n\n$$\nP(A)=0.57.\n$$\n\n- Since $3%$ of type A light bulbs are defective, we have\n\n$$\nP(D|A)=0.03.\n$$\n\n- Since $41%$ of defective light bulbs are of type A, we have\n\n$$\nP(A|D)=0.41\n$$\n\nWe want to find the probability that a randomly chosen light bulb from factory $2$ is defective, which is represented as $P(D|{F}_{2}).$ \n\nUsing Bayes' theorem combined with the law of total probability, we have\n\n$$\n\\begin{aligned}P(A|D) & =\\frac{P(D|A)P(A)}{P(D)} \\\\ P(A|D) & =\\frac{P(D|A)P(A)}{P(D|{F}_{1})P({F}_{1})+P(D|{F}_{2})P({F}_{2})+P(D|{F}_{3})P({F}_{3})} \\\\ 0.41 & =\\frac{(0.03)(0.57)}{(0.05)(0.45)+P(D|{F}_{2})(0.45)+(0.01)(0.1)} \\\\ 0.41 & =\\frac{0.0171}{0.0235+0.45P(D|{F}_{2})}\\end{aligned}\n$$\n\nSolving this equation for $P(D|{F}_{2}),$ we have\n\n$$\n\\begin{aligned}0.41(0.0235+0.45P(D|{F}_{2})) & =0.0171 \\\\ 0.0235+0.45P(D|{F}_{2}) & =\\frac{0.0171}{0.41} \\\\ 0.0235+0.45P(D|{F}_{2}) & =\\frac{171}{4100} \\\\ 0.45P(D|{F}_{2}) & =\\frac{171}{4100}-0.0235 \\\\ P(D|{F}_{2}) & =\\frac{1}{0.45}(\\frac{171}{4100}-0.0235) \\\\ P(D|{F}_{2}) & ≈0.040\\end{aligned}\n$$\n\nrounded to three decimal places."} :step/id #uuid "e03d6f33-2586-5d57-a7b2-26ad674790fd" :step/next {:db/id #edb/ref 17592186493998}} {:db/id #edb/ref 17592186494071 :step/content {:db/id #edb/ref 17592186493967 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aad9a2ec-8c38-50c5-a148-e148cf1a201f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.307" :db/id #edb/ref 17592186493659} {:answer/id #uuid "cb08ac4c-bcdb-5bf3-803d-48abd3c44b23" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.546" :db/id #edb/ref 17592186493717} {:answer/id #uuid "db3514aa-7da2-58cd-a765-4883b4c73d8a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.135" :db/id #edb/ref 17592186493736} {:answer/id #uuid "e44bfd71-59f5-5456-8e29-b331fc4b994f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.398" :db/id #edb/ref 17592186493751} {:answer/id #uuid "e5ca70ca-440e-5d09-bd91-1a12c84d2bf9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.252" :db/id #edb/ref 17592186493758}] :answer-field/correct {:db/id #edb/ref 17592186493751} :answer-field/id #uuid "b2b5eda7-fc54-5354-9c43-01751b2546c8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186493866}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "deb0627a-b1f4-5ecd-95e2-372ffa642f2c" :question/math-academy-id "q-149493" :question/problem "A volleyball school for children splits the players into three teams, team $1$, team $2,$ and team $3.$ \n\n- $44%$ of children are in team $1,$ and $23%$ of children in this team have been playing for over two years.\n\n- $32%$ of children are in team $2,$ and $26%$ of children in this team have been playing for over two years.\n\n- $24%$ of children are in team $3.$\n\nIf $7%$ of all children can play in the blocker position, $40%$ of children who can play as blockers have been playing for over two years, and $10%$ of children who have been playing for over two years can play as blockers, what is the probability that a randomly chosen child in team $3$ has been playing for over two years? Round your answer to $3$ decimal places." :question/worked-solution "Let $B$ be the event that a child can play in the blocker position, $I$ be the event that a child has been playing for over two years, and ${T}_{1},{T}_{2},{T}_{3}$ be the events that a child is in team $1,$ $2,$ or $3,$ respectively. \n\nLet's break down the information given in the problem statement:\n\n- From the bullet points, we have the following information:\n\n$$\n\\begin{aligned} & P({T}_{1})=0.44 &  & P(I|{T}_{1})=0.23 \\\\  & P({T}_{2})=0.32 &  & P(I|{T}_{2})=0.26 \\\\  & P({T}_{3})=0.24\\end{aligned}\n$$\n\nThe disjoint union ${T}_{1}⊔{T}_{2}⊔{T}_{3}$ covers the entire sample space, and we have\n\n$$\nP({T}_{1})+P({T}_{2})+P({T}_{3})=0.44+0.32+0.24=1.\n$$\n\n- Since $7%$ of children can play in the blocker position, we have\n\n$$\nP(B)=0.07.\n$$\n\n- Since $40%$ of children who can play as blockers have been playing for over two years, we have\n\n$$\nP(I|B)=0.4.\n$$\n\n- Since $10%$ of children who have been playing for over two years can play as blockers, we have\n\n$$\nP(B|I)=0.1.\n$$\n\nWe want to find the probability that a randomly chosen child in team 3 has been playing for over two years, which is represented as $P(I|{T}_{3}).$\n\nUsing Bayes' theorem combined with the law of total probability, we have\n\n$$\n\\begin{aligned}P(B|I) & =\\frac{P(I|B)P(B)}{P(I)} \\\\ P(B|I) & =\\frac{P(I|B)P(B)}{P(I|{T}_{1})P({T}_{1})+P(I|{T}_{2})P({T}_{2})+P(I|{T}_{3})P({T}_{3})} \\\\ 0.1 & =\\frac{(0.4)(0.07)}{(0.23)(0.44)+(0.26)(0.32)+P(I|{T}_{3})(0.24)} \\\\ 0.1 & =\\frac{0.028}{0.1844+0.24P(I|{T}_{3})}.\\end{aligned}\n$$\n\nSolving this equation for $P(I|{T}_{3}),$ we have\n\n$$\n\\begin{aligned}0.1(0.1844+0.24P(I|{T}_{3})) & =0.028 \\\\ 0.1844+0.24P(I|{T}_{3}) & =\\frac{0.028}{0.1} \\\\ 0.1844+0.24P(I|{T}_{3}) & =\\frac{7}{25} \\\\ 0.24P(I|{T}_{3}) & =\\frac{7}{25}-0.1844 \\\\ P(I|{T}_{3}) & =\\frac{1}{0.24}(\\frac{7}{25}-0.1844) \\\\ P(I|{T}_{3}) & ≈0.398\\end{aligned}\n$$\n\nrounded to three decimal places."} :step/id #uuid "f74c9cc2-11d5-584d-b43f-9184a7e00330" :step/next {:db/id #edb/ref 17592186494049}}] :activity/title "Extending Bayes' Theorem" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186493388}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186550059} :activity/id #uuid "4a76ab2b-fb4c-5063-aa81-3107b8d38d69" :activity/scope {:db/id #edb/ref 17592186048270 :topic/id #uuid "8e43115f-4416-5ec0-b698-3e53a959567b" :topic/math-academy-id 3286} :activity/steps [{:db/id #edb/ref 17592186550043 :step/content {:db/id #edb/ref 17592186549938 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50e9c58b-4fb9-5497-9482-e8f285727015" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.055" :db/id #edb/ref 17592186549479} {:answer/id #uuid "5b9c5c15-f6a2-5b4a-a895-22168d05307d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.095" :db/id #edb/ref 17592186549499} {:answer/id #uuid "8a26048a-fd81-56ee-8af6-bd08ebb325b0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.047" :db/id #edb/ref 17592186549578} {:answer/id #uuid "a2ac414e-15b9-5ce9-93e3-a7f2a6d829da" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.019" :db/id #edb/ref 17592186549625} {:answer/id #uuid "c97eb869-625e-551f-be3b-c0ff2ec27876" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.028" :db/id #edb/ref 17592186549690}] :answer-field/correct {:db/id #edb/ref 17592186549690} :answer-field/id #uuid "2d9e6faf-9e8f-5d9c-aa84-79845b127ed4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186549823}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "1787d264-9d95-57d2-8330-7eec4c052cfe" :question/math-academy-id "q-148271" :question/problem "A medical center is investigating the correlation between scoliosis and sports practice in a sample of children.\n\n- $25%$ of children in the sample don't practice sports, and $2.5%$ of those children have scoliosis.\n\n- $30%$ of children in the sample practice one sport.\n\n- $45%$ of children in the sample practice two sports, and $2.8%$ of those children have scoliosis.\n\nIf $48%$ of children in the entire sample are female, $2.6%$ of female children have scoliosis, and $46%$ of children with scoliosis are female, what is the probability that a randomly chosen child who practices one sport has scoliosis? Round your answer to $3$ decimal places." :question/worked-solution "Let $F$ be the event that a child is female, $C$ be the event that a child has scoliosis, and ${S}_{0},{S}_{1},{S}_{2}$ be the event that a child practices $0,$ $1,$ or $2$ sports, respectively.\n\nLet's break down the information given in the problem statement:\n\n- From the bullet points, we have the following information:\n\n$$\n\\begin{aligned} & P({S}_{0})=0.25 &  & P(C∣{S}_{0})=0.025 \\\\  & P({S}_{1})=0.30 \\\\  & P({S}_{2})=0.45 &  & P(C∣{S}_{2})=0.028\\end{aligned}\n$$\n\nThe disjoint union ${S}_{0}⊔{S}_{1}⊔{S}_{2}$ covers the entire sample space, and we have\n\n$$\nP({S}_{0})+P({S}_{1})+P({S}_{2})=0.25+0.30+0.45=1.\n$$\n\n- Since $48%$ of students in the entire sample are female, we have\n\n$$\nP(F)=0.48.\n$$\n\n- Since $2.6%$ of females have scoliosis, we have\n\n$$\nP(C∣F)=0.026.\n$$\n\n- Since $46%$ of children with scoliosis are female, we have\n\n$$\nP(F∣C)=0.46.\n$$\n\nWe want to find the probability that a randomly chosen child who practices one sport has scoliosis, which is represented as $P(C∣{S}_{1}).$\n\nUsing Bayes' theorem combined with the law of total probability, we have\n\n$$\n\\begin{aligned}P(F∣C) & =\\frac{P(C∣F)P(F)}{P(C)} \\\\ P(F∣C) & =\\frac{P(C∣F)P(F)}{P(C∣{S}_{0})P({S}_{0})+P(C∣{S}_{1})P({S}_{1})+P(C∣{S}_{2})P({S}_{2})} \\\\ 0.46 & =\\frac{(0.026)(0.48)}{(0.25)(0.025)+P(C∣{S}_{1})(0.3)+(0.028)(0.45)} \\\\ 0.46 & =\\frac{0.0125}{0.0189+0.3P(C∣{S}_{1})}\\end{aligned}\n$$\n\nSolving this equation for $P(C∣{S}_{1}),$ we have\n\n$$\n\\begin{aligned}0.46(0.0189+0.3P(C∣{S}_{1})) & =0.0125 \\\\ 0.0189+0.3P(C∣{S}_{1}) & =\\frac{0.0125}{0.46} \\\\ 0.3P(C∣{S}_{1}) & =\\frac{0.0125}{0.46}-0.0189 \\\\ P(C∣{S}_{1}) & =\\frac{1}{0.3}(\\frac{0.0125}{0.46}-0.0189) \\\\ P(C∣{S}_{1}) & ≈0.028\\end{aligned}\n$$\n\nrounded to three decimal places."} :step/id #uuid "39ce452f-966f-5775-99e0-20fb8ca0eef9"} {:db/id #edb/ref 17592186550059 :step/content {:db/id #edb/ref 17592186549984 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "161fb25c-96cf-5b02-8d7d-25af5ca8f28a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.365" :db/id #edb/ref 17592186549357} {:answer/id #uuid "3abf36e3-3cf2-5339-8e78-9d57d7acb48a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.286" :db/id #edb/ref 17592186549435} {:answer/id #uuid "408cef73-e79b-5f84-909b-bb78b0af2709" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.322" :db/id #edb/ref 17592186549446} {:answer/id #uuid "c7987182-3703-5340-83e1-52554f33e28f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.444" :db/id #edb/ref 17592186549688} {:answer/id #uuid "cb1644a5-6db3-535c-a833-2c384185599d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.403" :db/id #edb/ref 17592186549693}] :answer-field/correct {:db/id #edb/ref 17592186549693} :answer-field/id #uuid "266b7c98-bb0c-5250-98ae-54d840c489c2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186549819}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9c281bbc-e5bb-5c0b-9b81-0eabf770ee2e" :question/math-academy-id "q-147885" :question/problem "The disjoint union ${A}_{1}⊔{A}_{2}⊔{A}_{3}⊔{A}_{4}$ of events ${A}_{1},{A}_{2},{A}_{3},{A}_{4}$ covers the entire sample space. Compute $P({A}_{2}|B)$ given the following probabilities:\n\n$$\n\\begin{aligned} & P(B|{A}_{1})=0.25, & P({A}_{1})=0.28 \\\\  & P(B|{A}_{2})=0.3, &  \\\\  & P(B|{A}_{3})=0.28, & P({A}_{3})=0.18 \\\\  & P(B|{A}_{4})=0.1, & P({A}_{4})=0.22\\end{aligned}\n$$\n\nRound your answer to $3$ decimal places." :question/worked-solution "If the disjoint union ${A}_{1}⊔{A}_{2}⊔…⊔{A}_{n}$ covers the entire sample space, Bayes' theorem combined with the law of total probability gives us the following:\n\n$$\nP({A}_{k}|B)=\\frac{P(B|{A}_{k})P({A}_{k})}{P(B)}=\\frac{P(B|{A}_{k})P({A}_{k})}{{\\sum }_{i=1}^{n}P(B|{A}_{i})P({A}_{i})}\n$$\n\nwhere $k=1,2,…,n.$\n\nIn our case, $n=4,$ and ${A}_{1}⊔{A}_{2}⊔{A}_{3}⊔{A}_{4}$ covers the entire sample space. Consequently, we have\n\n$$\nP({A}_{1})+P({A}_{2})+P({A}_{3})+P({A}_{4})=1.\n$$\n\nAs a result,\n\n$$\n\\begin{aligned}P({A}_{2}) & =1-(P({A}_{1})+P({A}_{3})+P({A}_{4})) \\\\  & =1-(0.28+0.18+0.22) \\\\  & =0.32.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P({A}_{2}|B) & =\\frac{P(B|{A}_{2})P({A}_{2})}{{\\sum }_{i=1}^{4}P(B|{A}_{i})P({A}_{i})} \\\\  & =\\frac{P(B|{A}_{2})P({A}_{2})}{P(B|{A}_{1})P({A}_{1})+P(B|{A}_{2})P({A}_{2})+P(B|{A}_{3})P({A}_{3})+P(B|{A}_{4})P({A}_{4})} \\\\  & =\\frac{(0.3)(0.32)}{(0.25)(0.28)+(0.3)(0.32)+(0.28)(0.18)+(0.1)(0.22)} \\\\  & =\\frac{0.096}{0.2384} \\\\  & ≈0.403.\\end{aligned}\n$$"} :step/id #uuid "5af77563-9292-5cfd-aaa2-e0647be6b4b1" :step/next {:db/id #edb/ref 17592186550109}} {:db/id #edb/ref 17592186550081 :step/content {:db/id #edb/ref 17592186549926 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "144c9c56-d288-5656-9e9a-114c97ea9460" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.348" :db/id #edb/ref 17592186549350} {:answer/id #uuid "39018054-1073-5cec-87c0-3be506864193" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.415" :db/id #edb/ref 17592186549432} {:answer/id #uuid "7aae2ee8-a81d-50e2-98ea-e2df978f83a9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.48" :db/id #edb/ref 17592186549546} {:answer/id #uuid "7dd4d43d-b30b-5f97-8032-3941bf17d1fb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.552" :db/id #edb/ref 17592186549552} {:answer/id #uuid "85700ac7-cad1-590c-a143-b418ccc70b5b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.52" :db/id #edb/ref 17592186549565}] :answer-field/correct {:db/id #edb/ref 17592186549350} :answer-field/id #uuid "af85ec6e-7016-53c3-802c-9198ac759320" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186549885}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "095773d5-faca-5dcc-94ed-85e3db151ccc" :question/math-academy-id "q-148082" :question/problem "A medical center is investigating the correlation between scoliosis and sports practice in a sample of children.\n\n- $25%$ of children in the sample don't practice sports, and $3%$ of those children have scoliosis.\n\n- $30%$ of children in the sample practice one sport, and $2.5%$ of those children have scoliosis.\n\n- $45%$ of children in the sample practice two sports, and $3.3%$ of those children have scoliosis.\n\nIf $52%$ of children in the entire sample are female, and $2%$ of female children have scoliosis, what is the probability that a randomly chosen child with scoliosis is female? Round your answer to $3$ decimal places." :question/worked-solution "Let $F$ be the event that a child is female, $C$ be the event that a child has scoliosis, and ${S}_{0},{S}_{1},{S}_{2}$ be the event that a child practice $0,$ $1,$ or $2$ sports, respectively.\n\nLet's break down the information given in the problem statement:\n\n- From the bullet points, we have the following information:\n\n$$\n\\begin{aligned} & P({S}_{0})=0.25 &  & P(C|{S}_{0})=0.03 \\\\  & P({S}_{1})=0.30 &  & P(C|{S}_{1})=0.025 \\\\  & P({S}_{2})=0.45 &  & P(C|{S}_{2})=0.033\\end{aligned}\n$$\n\nThe disjoint union ${S}_{0}⊔{S}_{1}⊔{S}_{2}$ covers the entire sample space, and we have\n\n$$\nP({S}_{0})+P({S}_{1})+P({S}_{2})=0.25+0.30+0.45=1.\n$$\n\n- Since $52%$ of children in the entire sample are female, we have\n\n$$\nP(F)=0.52.\n$$\n\n- Since $2%$ of females have scoliosis, we have\n\n$$\nP(C|F)=0.02.\n$$\n\nWe want to find the probability that a randomly chosen child with scoliosis is female, which is represented as $P(F|C).$ \n\nUsing Bayes' theorem combined with the law of total probability, we have\n\n$$\n\\begin{aligned}P(F|C) & =\\frac{P(C|F)P(F)}{P(C)} \\\\  & =\\frac{P(C|F)P(F)}{P(C|{S}_{0})P({S}_{0})+P(C|{S}_{1})P({S}_{1})+P(C|{S}_{2})P({S}_{2})} \\\\  & =\\frac{(0.02)(0.52)}{(0.03)(0.25)+(0.025)(0.3)+(0.033)(0.45)} \\\\  & =\\frac{0.0104}{0.0299} \\\\  & ≈0.348,\\end{aligned}\n$$\n\nrounded to $3$ decimal places."} :step/id #uuid "964218e8-bf1c-559e-ad24-e50227ec5968" :step/next {:db/id #edb/ref 17592186550118}} {:db/id #edb/ref 17592186550109 :step/content {:db/id #edb/ref 17592186487364 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c32fc9e-ce9a-535b-a8b3-06c486c6cd67" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.610" :db/id #edb/ref 17592186486898} {:answer/id #uuid "a059a8b3-f1ed-5de8-a334-40e4ba40f83d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.602" :db/id #edb/ref 17592186486959} {:answer/id #uuid "a6776cbd-ebfc-53b8-ad96-0550911cd2ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.688" :db/id #edb/ref 17592186486972} {:answer/id #uuid "ec76cd0f-4509-5d07-9c06-06e62501a6f1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.672" :db/id #edb/ref 17592186487097} {:answer/id #uuid "efaec769-99d0-583b-aad4-773115f51b8c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.668" :db/id #edb/ref 17592186487107}] :answer-field/correct {:db/id #edb/ref 17592186486898} :answer-field/id #uuid "55e23228-7c0d-5766-b1ab-6e8ce201deb8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186487178}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a806821e-50df-52c7-a557-34976fdac21e" :question/math-academy-id "q-148079" :question/problem "An English teacher believes that students who prefer cursive handwriting tend to perform better in essay writing. To prove his belief, he puts some students into groups of three according to their average writing grades and asks them if they usually write in cursive.\n\n- $20%$ of students have low grades, and $12%$ of those students usually write in cursive.\n\n- $65%$ of students have average grades, and $15%$ of those students usually write in cursive.\n\n- $15%$ of students have high grades, and $17%$ of those students usually write in cursive.\n\nIf $56%$ of students are female, and $16%$ of female students write in cursive, what is the probability that a randomly chosen student who writes in cursive is a female? Round your answer to $3$ decimal places." :question/worked-solution "Let $F$ be the event that a student is female, $W$ be the event that the student writes in cursive, and $L,A,H$ be the events that the student has low, average, or high grades, respectively.\n\nLet's break down the information given in the problem statement:\n\n- From the bullet points, we have the following information:\n\n$$\n\\begin{aligned} & P(L)=0.2 &  & P(W|L)=0.12 \\\\  & P(A)=0.65 &  & P(W|A)=0.15 \\\\  & P(H)=0.15 &  & P(W|H)=0.17\\end{aligned}\n$$\n\nThe disjoint union $L⊔A⊔H$ covers the entire sample space, and we have\n\n$$\nP(L)+P(A)+P(H)=0.2+0.65+0.15=1.\n$$\n\n- Since $56%$ of students are female, we have\n\n$$\nP(F)=0.56.\n$$\n\n- Since $16%$ of female students write in cursive, we have\n\n$$\nP(W|F)=0.16.\n$$\n\nWe want to find the probability that a randomly chosen student who writes in cursive is a female, which is represented as $P(F|W).$ \n\nUsing Bayes' theorem combined with the law of total probability, we have\n\n$$\n\\begin{aligned}P(F|W) & =\\frac{P(W|F)P(F)}{P(W)} \\\\  & =\\frac{P(W|F)P(F)}{P(W|L)P(L)+P(W|A)P(A)+P(W|H)P(H)} \\\\  & =\\frac{(0.16)(0.56)}{(0.2)(0.12)+(0.65)(0.15)+(0.15)(0.17)} \\\\  & =\\frac{0.0896}{0.147} \\\\  & ≈0.610,\\end{aligned}\n$$\n\nrounded to $3$ decimal places."} :step/id #uuid "da95ad9e-2b99-5840-9da1-16c4078a085a" :step/next {:db/id #edb/ref 17592186550081}} {:db/id #edb/ref 17592186550118 :step/content {:db/id #edb/ref 17592186487402 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10ee0324-47ce-520c-be1b-617fc28bde99" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.004" :db/id #edb/ref 17592186486628} {:answer/id #uuid "1f964113-d9c4-53ce-a730-891983a25308" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.06" :db/id #edb/ref 17592186486654} {:answer/id #uuid "4dd21a5c-17af-557a-936c-d9cb120f8e34" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.066" :db/id #edb/ref 17592186486762} {:answer/id #uuid "56ac6ed1-d21c-50b6-90e0-44a21cfc1766" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.04" :db/id #edb/ref 17592186486783} {:answer/id #uuid "8146efe8-c4c6-5ac7-a7c5-ddfd418eda3b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.045" :db/id #edb/ref 17592186486876}] :answer-field/correct {:db/id #edb/ref 17592186486762} :answer-field/id #uuid "c75bc298-c38f-59f1-b1e6-e063f2062f22" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186487249}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f697c855-b9dd-5b7e-bb24-b23154c897b1" :question/math-academy-id "q-148085" :question/problem "A gambling room has three roulette tables, table $1,$ table $2,$ and table $3.$ Data of all bets of a particular evening are collected.\n\n- $30%$ of bets were played at table $1,$ and $5%$ of those bets were won.\n\n- $35%$ of bets were played at table $2,$ and $6%$ of those bets were won.\n\n- $35%$ of bets were played at table $3,$ and $7%$ of those bets were won.\n\nIf $10%$ of bets were played in the first hour, and $4%$ of bets made in the first hour were won, what is the probability that a randomly chosen winning bet was played in the first hour? Round your answer to $3$ decimal places." :question/worked-solution "Let $F$ be the event that a bet is played in the first hour, $W$ be the event that a bet is won, and ${T}_{1},{T}_{2},{T}_{3}$ be the events that a bet is played at table $1,$ $2,$ or $3,$ respectively.\n\nLet's break down the information given in the problem statement:\n\n- From the bullet points, we have the following information:\n\n$$\n\\begin{aligned} & P({T}_{1})=0.3 &  & P(W|{T}_{1})=0.05 \\\\  & P({T}_{2})=0.35 &  & P(W|{T}_{2})=0.06 \\\\  & P({T}_{3})=0.35 &  & P(W|{T}_{3})=0.07\\end{aligned}\n$$\n\nThe disjoint union ${T}_{1}⊔{T}_{2}⊔{T}_{3}$ covers the entire sample space, and we have\n\n$$\nP({T}_{1})+P({T}_{2})+P({T}_{3})=0.3+0.35+0.35=1.\n$$\n\n- Since $10%$ of bets in the entire evening are played in the first hour, we have\n\n$$\nP(F)=0.1.\n$$\n\n- Since $4%$ of bets made in the first hour are won, we have\n\n$$\nP(W|F)=0.04.\n$$\n\nWe want to find the probability that a randomly chosen winning bet is played in the first hour, which is represented as $P(F|W).$\n\nUsing Bayes' theorem combined with the law of total probability, we have\n\n$$\n\\begin{aligned}P(F|W) & =\\frac{P(W|F)P(F)}{P(W)} \\\\  & =\\frac{P(W|F)P(F)}{P(W|{T}_{1})P({T}_{1})+P(W|{T}_{2})P({T}_{2})+P(W|{T}_{3})P({T}_{3})} \\\\  & =\\frac{(0.04)(0.1)}{(0.05)(0.3)+(0.06)(0.35)+(0.07)(0.35)} \\\\  & =\\frac{0.004}{0.0605} \\\\  & ≈0.066,\\end{aligned}\n$$\n\nrounded to $3$ decimal places."} :step/id #uuid "fce198a3-2fe3-5172-8c78-1731bf8adc70" :step/next {:db/id #edb/ref 17592186550043}}] :activity/title "Extending Bayes' Theorem" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186549303}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186148590} :activity/id #uuid "57371a77-6667-5bdd-b857-9b52cc9a92ac" :activity/scope {:db/id #edb/ref 17592186048313 :topic/id #uuid "93cbb547-bfa6-5649-8003-160f883bcb4f" :topic/math-academy-id 2467} :activity/steps [{:db/id #edb/ref 17592186148323 :step/content {:db/id #edb/ref 17592186147455 :knowledge-point/canonical-example {:db/id #edb/ref 17592186147392 :question/id #uuid "4447e034-350f-5e6b-a501-0f57a3888bd0" :question/math-academy-id "e-8975"} :knowledge-point/id #uuid "f4196423-3401-54e1-b214-9dbc4861cfe1" :knowledge-point/questions [{:db/id #edb/ref 17592186147727} {:db/id #edb/ref 17592186147728} {:db/id #edb/ref 17592186233094} {:db/id #edb/ref 17592186414710} {:db/id #edb/ref 17592186553550}] :knowledge-point/title "Identifying Spheres, Hemispheres, Cones, and Cylinders"} :step/id #uuid "2317aeba-3862-5ebe-a106-96c1e216914d" :step/math-academy-id 33549 :step/next {:db/id #edb/ref 17592186148589}} {:db/id #edb/ref 17592186148588 :step/content {:db/id #edb/ref 17592186147611 :knowledge-point/canonical-example {:db/id #edb/ref 17592186147290 :question/id #uuid "319d252c-a8c4-5a5f-ad2b-f4bdb5702b75" :question/math-academy-id "e-2662"} :knowledge-point/id #uuid "e8fd3c2c-3340-50df-a95c-3b82f165a071" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048698} {:db/id #edb/ref 17592186050585}] :knowledge-point/questions [{:db/id #edb/ref 17592186147891} {:db/id #edb/ref 17592186147899} {:db/id #edb/ref 17592186553517} {:db/id #edb/ref 17592186553558} {:db/id #edb/ref 17592186553567}] :knowledge-point/title "Naming Prisms"} :step/id #uuid "19df8c7e-89cb-5578-919d-65b12d903d26" :step/math-academy-id 8908 :step/next {:db/id #edb/ref 17592186148595}} {:db/id #edb/ref 17592186148589 :step/content {:db/id #edb/ref 17592186147612 :knowledge-point/canonical-example {:db/id #edb/ref 17592186147291 :question/id #uuid "0583c82a-049c-51e6-aebc-bcd32423824e" :question/math-academy-id "e-2668"} :knowledge-point/id #uuid "b9d83422-a877-5de8-bc55-2c7aae9eeb72" :knowledge-point/questions [{:db/id #edb/ref 17592186147914} {:db/id #edb/ref 17592186147915} {:db/id #edb/ref 17592186414711} {:db/id #edb/ref 17592186414712} {:db/id #edb/ref 17592186553548} {:db/id #edb/ref 17592186553581}] :knowledge-point/title "Identifying Non-Polyhedra"} :step/id #uuid "a01f473c-01ac-5a25-a94d-294c2cc662a2" :step/math-academy-id 8914} {:db/id #edb/ref 17592186148590 :step/content {:db/id #edb/ref 17592186148714 :tutorial/content "A **polyhedron** is a $3$-dimensional shape where each side is a polygon. These flat polygonal sides are called **faces**.\n\n**Prisms** are polyhedrons made of two identical polygonal faces (called **bases**) connected by equal parallel line segments. If these line segments are perpendicular to the bases, we have a **right** prism.\n\nLet's take a look at some common prisms.\n\n- A **triangular (right) prism** consists of two identical triangular faces connected by equal parallel line segments.\n\n![](images/95/9563bd4f9c40ff5921998ed5840f8e5b43fb1af579a64a06a14782be4a86ece2.png)\n\n- A **rectangular (right) prism** consists of two identical rectangular faces connected by equal parallel line segments. Notice that each face is a rectangle.\n\n![](images/39/39ea3dd56722c7fb05ba275a054ff46479e3ee96851dafdd66fe09455a517f1a.png)\n\n- A **cube** is a special case of a rectangular prism that consists of six equal square faces.\n\n![](images/41/415d03a9a886793eee4b4d16e50af26002c0881279481b2e70773b8b7bff02a5.png)\n\nBy adding more sides to the polygonal base, we can make more prisms. For example, the following shape is a pentagonal prism.\n\n![](images/8f/8f4dd8fe8c120eabbe5a1ad6413f6f0cd9cd3d22efe8b13e25ac3d2a916f3258.png)\n\n \n\nWe can also construct hexagonal prisms, heptagonal prisms, etc." :tutorial/id #uuid "af52fff0-b45a-59d7-85f8-cacc3a9cb9f9" :tutorial/math-academy-id 2202 :tutorial/title "Introduction"} :step/id #uuid "a54ee23c-aa2f-55da-8cdb-fd96e504ff67" :step/math-academy-id 8915 :step/next {:db/id #edb/ref 17592186148594}} {:db/id #edb/ref 17592186148594 :step/content {:db/id #edb/ref 17592186148718 :tutorial/content "**Pyramids** are polyhedrons made of a polygonal base, with the other triangular faces meeting at a single point. \n\nLet's take a look at some common pyramids.\n\n- A **triangular pyramid** has a triangular base with $3$ other triangular faces that meet at a single point.\n\n![](images/d8/d8597d1e526e2af72255f7dce1cc13e01cf76f1c53522003b126be67a0a6c55d.png)\n\n- A **rectangular pyramid** has a rectangular base with $4$ triangular faces that meet at a single point. If the base is a square, we call this a **square pyramid.**\n\n![](images/26/26700acaf9eae64227988ddcfb43269c0eba6f6447229ec8854cc1ebfeab3334.png)\n\n- A **pentagonal pyramid** has a pentagonal base with $5$ triangular faces that meet at a single point.\n\n![](images/4c/4c73b984b3e4a2ccb0796646ebb4c547947fab7359914599d928a63819818725.png)\n\nSimilarly to prisms, we can add more sides to the polygonal base to make more types of pyramids." :tutorial/id #uuid "5ebd5b00-1afa-5ee5-9321-47a3e76e71ef" :tutorial/math-academy-id 2248 :tutorial/title "Pyramids"} :step/id #uuid "0e005ac2-7765-5ed0-83c6-dc038809de33" :step/math-academy-id 9198 :step/next {:db/id #edb/ref 17592186148588}} {:db/id #edb/ref 17592186148595 :step/content {:db/id #edb/ref 17592186147615 :knowledge-point/canonical-example {:db/id #edb/ref 17592186147294 :question/id #uuid "dc558592-e65f-5369-890d-fffc633f2a3b" :question/math-academy-id "e-2757"} :knowledge-point/id #uuid "ddd0beef-ff0c-5ef3-88c4-ce49fbb8d5cb" :knowledge-point/questions [{:db/id #edb/ref 17592186147897} {:db/id #edb/ref 17592186147900} {:db/id #edb/ref 17592186414713} {:db/id #edb/ref 17592186495110} {:db/id #edb/ref 17592186553541} {:db/id #edb/ref 17592186553575}] :knowledge-point/title "Naming Pyramids"} :step/id #uuid "4c62acce-9aa5-51e7-aab3-ddef11ded75b" :step/math-academy-id 9199 :step/next {:db/id #edb/ref 17592186148596}} {:db/id #edb/ref 17592186148596 :step/content {:db/id #edb/ref 17592186148719 :tutorial/content "Not all three-dimensional shapes are polyhedrons. Let's see some examples.\n\n- A ** sphere** is the set of points with the same distance to a fixed point called the **center.** A sphere is a $3$-dimensional analog of a circle. A ** hemisphere ** is half of a sphere.\n\n![](images/84/84e7b63b5ec8761d4a3ac8a00b15a08f0dab7d4f95a536721df0c82e2999873f.png)\n\n- A **cylinder** is a solid shape with two parallel circular bases. There are two types of cylinders.\n\nA cylinder is **right** if the axis that passes through the centers of the circular bases is perpendicular to the bases. Otherwise, the cylinder is **oblique.**\n\n![](images/f8/f8ddb161d2d8628dd1294cc0d0042437300787217b518be73f010e79be90dcf7.png)\n\n- A **cone** is a solid shape with one circular base and one vertex called the **apex**. There are two types of cones.\n\nA cone is **right** if the axis that passes through the center of the circular base and the vertex is perpendicular to the base. Otherwise, the cone is **oblique.**\n\n![](images/2f/2f9e9ca18a36336ed99695bb51b167ffbd83f002139728f8dfe15227bf9f7745.png)" :tutorial/id #uuid "daf27141-b818-5e08-b09c-b940a0ab763a" :tutorial/math-academy-id 2250 :tutorial/title "Other Three-Dimensional Shapes"} :step/id #uuid "9570e433-348e-5b8c-8ac5-b5e75693bf4e" :step/math-academy-id 9201 :step/next {:db/id #edb/ref 17592186148323}}] :activity/title "Identifying Three-Dimensional Shapes" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186147667}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186414718} :activity/id #uuid "4fbea89c-8f67-5118-a1de-ee1d485d0bea" :activity/scope {:db/id #edb/ref 17592186048313 :topic/id #uuid "93cbb547-bfa6-5649-8003-160f883bcb4f" :topic/math-academy-id 2467} :activity/steps [{:db/id #edb/ref 17592186414714 :step/content {:db/id #edb/ref 17592186414713 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b8744a0-0044-51b5-ba74-cb20ab4ca8f2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Heptagonal pyramid" :db/id #edb/ref 17592186414682} {:answer/id #uuid "1dd46a53-d530-5265-b868-97591886f8f2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Triangular pyramid" :db/id #edb/ref 17592186414683} {:answer/id #uuid "259cae62-6586-502d-bdf1-ccc26c4cad6f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Cube" :db/id #edb/ref 17592186414684} {:answer/id #uuid "2687c571-e8a9-5532-9d9f-a9a82d818067" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Heptagonal prism" :db/id #edb/ref 17592186414685} {:answer/id #uuid "5737e950-c7ba-532c-b742-a233972b8975" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Hexagonal prism" :db/id #edb/ref 17592186414692}] :answer-field/correct {:db/id #edb/ref 17592186414682} :answer-field/id #uuid "f4290576-9979-5457-9533-5ecbf8f69d51" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186414709}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a6fd9de3-145f-5992-abae-ba4ddaa8590f" :question/math-academy-id "q-93195" :question/problem "![](images/4b/4b5055d5290bfefa599d5fa357b76a3ccff05f9b0330c6610ce77deba949e34f.png)\n\nWhat is the name of the polyhedron shown above?" :question/worked-solution "The solid is a **heptagonal pyramid** since it is a pyramid whose base is a heptagon.\n\nAlso, notice that:\n\n- The solid is not a triangular pyramid since not all its faces are triangular.\n\n- The solid is not a heptagonal prism since it has only one heptagonal face.\n\n- The solid is not a hexagonal prism because it has no hexagonal face.\n\n- The solid is not a cube since it has triangular faces."} :step/id #uuid "0b209725-9e0d-563b-a187-f60cb609d0c8" :step/next {:db/id #edb/ref 17592186414717}} {:db/id #edb/ref 17592186414715 :step/content {:db/id #edb/ref 17592186414711 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12a030b9-4c33-563f-932d-cdf0103434a4" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/6a/6a0e4fa080407695749f4e204f08cc062828f358573d56b2bc7e8a25fb61c2c6.png" :db/id #edb/ref 17592186414680} {:answer/id #uuid "40e3dace-c8f0-5451-8326-07ac6adb342d" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/18/180c9fc2f5c00706683921067bd3d4ced0e9f514df89ac1de66d1c959efd81cc.png" :db/id #edb/ref 17592186414689} {:answer/id #uuid "488d6f82-d92d-5984-aa98-caa3998bb08a" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/9b/9b094303688730cbd49075ad75faa3705e00999d40f253addfda88365991e401.png" :db/id #edb/ref 17592186414691} {:answer/id #uuid "b17cb05e-a4c9-58a6-946a-d88e0d16f2b9" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/50/50679b5a5b333daae4346bf729ac2791a1024baed9ae580918d37925c11fe7f1.png" :db/id #edb/ref 17592186414697} {:answer/id #uuid "be92cffe-3554-5972-9564-de1dcf9aba22" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/9f/9feb81a7255725b4d1b370012db8b7f06981daea8c96f16aa5fc6a59ae0a8898.png" :db/id #edb/ref 17592186414698}] :answer-field/correct {:db/id #edb/ref 17592186414691} :answer-field/id #uuid "8e137d3c-1309-5a42-8f77-b44643406daf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186414706}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "60a685f7-2a5b-5185-bd48-1abde4b2de57" :question/math-academy-id "q-69873" :question/problem "Which of the following is **not** a polyhedron?" :question/worked-solution "Each face in a polyhedron must be a polygon. Therefore, the only option that is **not** a polyhedron is:\n\n![](images/9b/9b094303688730cbd49075ad75faa3705e00999d40f253addfda88365991e401.png)\n\n    \n\nNotice that its left face is not a polygon (it's a circle)."} :step/id #uuid "4d46733c-4460-50dc-859b-7dd20a320ad8" :step/next {:db/id #edb/ref 17592186414714}} {:db/id #edb/ref 17592186414716 :step/content {:db/id #edb/ref 17592186414712 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3eb7f412-2103-58ff-a13b-06c1c4330e60" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/92/92151e8fc81b3c8b689b62ed0e5cf810b54f953d5a5675261b44d25d8419402a.png" :db/id #edb/ref 17592186414688} {:answer/id #uuid "44ffa52e-4d0a-566e-8284-0b15eba04159" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/d7/d79beefbd1605daf59fdb152c541784bd886019cc759d52dd6a1e92ffa3a0ff3.png" :db/id #edb/ref 17592186414690} {:answer/id #uuid "5cbbb49d-5c4b-58fb-ace1-178d1cd464f0" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/95/9563bd4f9c40ff5921998ed5840f8e5b43fb1af579a64a06a14782be4a86ece2.png" :db/id #edb/ref 17592186414695} {:answer/id #uuid "c68b03d2-d134-50f4-b325-4d5ddd31ff0e" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/03/037f72666076a57b9d20d9ec39a6c2e6efab31156a81d00ed419c6799c7056b4.png" :db/id #edb/ref 17592186414700} {:answer/id #uuid "e351cfcb-2aac-5397-b2e7-de491bc69f2d" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/0b/0bd12e1073334c21ebd437e103c55d166b4d433d0eec46787bb1906014c0c41d.png" :db/id #edb/ref 17592186414702}] :answer-field/correct {:db/id #edb/ref 17592186414702} :answer-field/id #uuid "e03ee3f1-4549-55c9-919e-e76bc4e6846f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186414708}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8c22d74f-c382-5fcc-9b04-2bd8cc4168b4" :question/math-academy-id "q-117697" :question/problem "Which of the following is **not** a polyhedron?" :question/worked-solution "Each face in a polyhedron must be a polygon. Therefore, the only option that is **not** a polyhedron is:\n\n![](images/0b/0bd12e1073334c21ebd437e103c55d166b4d433d0eec46787bb1906014c0c41d.png)\n\n              \n\nNotice that some of its faces are not polygons (they have curved sides)."} :step/id #uuid "7bebf769-82ed-5ee5-a479-5d4cd518d762"} {:db/id #edb/ref 17592186414717 :step/content {:db/id #edb/ref 17592186414710 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a28560e-80a3-57af-9dfa-e817b929bb85" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Sphere" :db/id #edb/ref 17592186414687} {:answer/id #uuid "7cda9107-2b9b-5255-8de4-8a7f274925d5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Right cylinder" :db/id #edb/ref 17592186414696} {:answer/id #uuid "c366b12c-e909-516f-a328-bcc2b653608e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Oblique cone" :db/id #edb/ref 17592186414699} {:answer/id #uuid "ccfdca69-53cd-540a-b90a-39a52dccc997" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Oblique Cylinder" :db/id #edb/ref 17592186414701} {:answer/id #uuid "ed96ecff-7047-526b-aea2-13644f032520" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Right cone" :db/id #edb/ref 17592186414704}] :answer-field/correct {:db/id #edb/ref 17592186414704} :answer-field/id #uuid "8963e5d2-5f7d-506c-a501-21c462d94bc6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186414705}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2449ad0f-383b-597c-b298-3099a99567bd" :question/math-academy-id "q-107276" :question/problem "![](images/26/264fb9324cad3bbfba25aa5a72c9c4a44e6c149b82f69d9e101fdff9e57a05d2.png)\n\nWhat is the name of the solid shown above?" :question/worked-solution "The solid is a **right cone**. \n\nNotice the following:\n\n- The solid has one circular base and one vertex. So, it's a cone.\n\n- The axis that passes through the center of the circle and the vertex is perpendicular to the base. So, it's right."} :step/id #uuid "87f1f045-6509-52aa-9286-2d5c94a46705" :step/next {:db/id #edb/ref 17592186414716}} {:db/id #edb/ref 17592186414718 :step/content {:db/id #edb/ref 17592186147900 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1900d6b5-ab4e-5cb6-875c-d1325629dba3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Cube" :db/id #edb/ref 17592186414681} {:answer/id #uuid "332e4dbe-20b8-54c1-9358-14a060035cc1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Pentagonal prism" :db/id #edb/ref 17592186414686} {:answer/id #uuid "58cc569c-846f-5023-b24c-d641fdf00ece" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Triangular pyramid" :db/id #edb/ref 17592186414693} {:answer/id #uuid "598ea44a-33fd-558b-a72c-9415a8e71931" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Pentagonal pyramid" :db/id #edb/ref 17592186414694} {:answer/id #uuid "e6a1f23e-e7bc-5e52-a9a0-4fe70a04cb29" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Rectangular prism" :db/id #edb/ref 17592186414703}] :answer-field/correct {:db/id #edb/ref 17592186414694} :answer-field/id #uuid "a5df61c8-1685-5b05-bfab-2db504a8dcb7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186414707}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0def774f-f257-5952-add7-f3a6aeb741ec" :question/math-academy-id "q-61656" :question/problem "![](images/4c/4c73b984b3e4a2ccb0796646ebb4c547947fab7359914599d928a63819818725.png)\n\nWhat is the name of the polyhedron shown above?" :question/worked-solution "The solid is a **pentagonal pyramid** since it is a pyramid whose base is a pentagon.\n\nAlso, notice that:\n\n- The solid is not a triangular pyramid since not all its faces are triangular.\n\n- The solid is not a pentagonal prism since it has only one pentagonal face.\n\n- The solid is not a rectangular prism since not all of its faces are rectangles. Due to the same reasons, the solid is not a cube."} :step/id #uuid "d58ea3ef-a954-5458-b665-9faf042fb48e" :step/next {:db/id #edb/ref 17592186414715}}] :activity/title "Identifying Three-Dimensional Shapes" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186414679}] [{:activity/first-step {:db/id #edb/ref 17592186152882} :activity/id #uuid "04492e62-1f36-5743-ad74-130604e26e5a" :activity/scope {:db/id #edb/ref 17592186048349 :topic/id #uuid "97a8f3f2-67ab-5291-a6e0-b7d19b4541f0" :topic/math-academy-id 2790} :activity/steps [{:db/id #edb/ref 17592186152882 :step/content {:db/id #edb/ref 17592186153426 :tutorial/content "The **negation** of a mathematical statement is its *opposite* statement. A mathematical statement and its negation have opposite truth values.\n\nFor example:\n\n- The negation of the *true* statement \"$4$ is divisible by $2$\" is the *false* statement \"$4$ is **not** divisible by $2.$\"\n- The negation of the *false* statement \"$5$ is even\" is the *true* statement \"$5$ is odd.\"\n\nWe can express negations using the symbol \"$\\neg$\". The negation of $A$ is denoted $\\neg A,$ and has the opposite truth values as $A{:}$\n\n| $\\,A\\,$ | $\\,\\neg A\\,$ |\n| --- | --- |\n| $\\textrm T$ | $\\textrm F$ |\n| $\\textrm F$ | $\\textrm T$ |\n\nWe can negate compound statements as well. For example, the statement $\\neg (A \\land B)$ has the opposite truth values as the statement $A \\land B{:}$\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\, A \\land B \\,$ | $\\, \\neg (A \\land B) \\,$ |\n| --- | --- | --- | --- |\n| $\\textrm T$ | $\\textrm T$ | $\\textrm T$ | $\\textrm F$ |\n| $\\textrm T$ | $\\textrm F$ | $\\textrm F$ | $\\textrm T$ |\n| $\\textrm F$ | $\\textrm T$ | $\\textrm F$ | $\\textrm T$ |\n| $\\textrm F$ | $\\textrm F$ | $\\textrm F$ | $\\textrm T$ |" :tutorial/id #uuid "65ae07d1-2d1e-5f50-9c5f-4b45ca435aed" :tutorial/math-academy-id 7965 :tutorial/title "Introduction"} :step/id #uuid "d6231d40-48ba-5c9d-855d-04ce17a699e2" :step/math-academy-id 120073 :step/next {:db/id #edb/ref 17592186152883}} {:db/id #edb/ref 17592186152883 :step/content {:db/id #edb/ref 17592186152051 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151803 :question/id #uuid "e803903e-e272-5bd9-97a2-6b7cf12c359c" :question/math-academy-id "e-12702"} :knowledge-point/id #uuid "637030d2-d58f-56af-bf16-f33f755b65f9" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049002}] :knowledge-point/questions [{:db/id #edb/ref 17592186152433} {:db/id #edb/ref 17592186152434} {:db/id #edb/ref 17592186374359} {:db/id #edb/ref 17592186374366} {:db/id #edb/ref 17592186374373} {:db/id #edb/ref 17592186401660} {:db/id #edb/ref 17592186401667}] :knowledge-point/title "Negating a Plain English Statement"} :step/id #uuid "05ea8d4a-447c-5dfe-bc07-9429c6506a99" :step/math-academy-id 120074 :step/next {:db/id #edb/ref 17592186152884}} {:db/id #edb/ref 17592186152884 :step/content {:db/id #edb/ref 17592186152052 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151800 :question/id #uuid "f652a287-03b1-5e0b-9d77-9a681b1bb873" :question/math-academy-id "e-12681"} :knowledge-point/id #uuid "93415651-fbcb-56d3-ad93-2b7f34e7bf4c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048778}] :knowledge-point/questions [{:db/id #edb/ref 17592186152829} {:db/id #edb/ref 17592186152833} {:db/id #edb/ref 17592186374380} {:db/id #edb/ref 17592186374387} {:db/id #edb/ref 17592186375453} {:db/id #edb/ref 17592186398631} {:db/id #edb/ref 17592186399152} {:db/id #edb/ref 17592186399159} {:db/id #edb/ref 17592186410106} {:db/id #edb/ref 17592186410108}] :knowledge-point/title "Expressing a Negated Sentence in Symbolic Form"} :step/id #uuid "1b41146a-7652-5f80-8f71-bd202ae02ffb" :step/math-academy-id 120077 :step/next {:db/id #edb/ref 17592186152885}} {:db/id #edb/ref 17592186152885 :step/content {:db/id #edb/ref 17592186152053 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151801 :question/id #uuid "3e19d03f-5298-52f4-a839-b4b7c5a1a4bf" :question/math-academy-id "e-12682"} :knowledge-point/id #uuid "7c49d316-3552-5ace-a749-5070b64230c3" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049269}] :knowledge-point/questions [{:db/id #edb/ref 17592186152465} {:db/id #edb/ref 17592186152466} {:db/id #edb/ref 17592186374492} {:db/id #edb/ref 17592186374505} {:db/id #edb/ref 17592186374518} {:db/id #edb/ref 17592186381598} {:db/id #edb/ref 17592186389949} {:db/id #edb/ref 17592186389962} {:db/id #edb/ref 17592186389975} {:db/id #edb/ref 17592186410105} {:db/id #edb/ref 17592186410109}] :knowledge-point/title "Completing a Truth Table for a Compound Statement"} :step/id #uuid "88af8584-370e-538d-bc31-ffbea331ec2f" :step/math-academy-id 120080 :step/next {:db/id #edb/ref 17592186152886}} {:db/id #edb/ref 17592186152886 :step/content {:db/id #edb/ref 17592186153427 :tutorial/content "When we have two negations in a row, we can cancel them out.\n\n- For example, $\\neg (\\neg A)$ can be simplified to $A.$\n- Likewise, $\\neg (\\neg (A \\land B))$ can be simplified to $A \\land B.$\n\nTo understand why negations cancel with each other, consider the following statement:\n\n$4$ is divisible by $2.$\n\nThe negation of this statement is\n\n$4$ is **not** divisible by $2.$\n\nIf we negate again, we get back the original sentence:\n\n$4$ divisible by $2.$\n\nSo, if we negate a statement twice, we end up with the original statement.\n\nMore formally, we can prove that $\\neg (\\neg A) \\equiv A$ using a truth table.\n\n| $\\,A\\,$ | $\\,\\neg A\\,$ | $\\,\\neg(\\neg A)\\,$ |\n| --- | --- | --- |\n| $\\textrm T$ | $\\textrm F$ | $\\textrm T$ |\n| $\\textrm F$ | $\\textrm T$ | $\\textrm F$ |\n\nSince $A$ and $\\neg(\\neg A)$ have the same truth values, they are logically equivalent." :tutorial/id #uuid "96c8056f-c1d0-5453-ba7f-71700a48506c" :tutorial/math-academy-id 7966 :tutorial/title "Double Negations"} :step/id #uuid "42a89cf9-ea00-5196-9579-5a0eda504d5a" :step/math-academy-id 120083 :step/next {:db/id #edb/ref 17592186152887}} {:db/id #edb/ref 17592186152887 :step/content {:db/id #edb/ref 17592186152054 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151802 :question/id #uuid "503739b1-ea2e-5c6a-8270-6e1fdc050bc4" :question/math-academy-id "e-12683"} :knowledge-point/id #uuid "69612c9a-699f-5635-8c9c-649a93ab4583" :knowledge-point/questions [{:db/id #edb/ref 17592186152830} {:db/id #edb/ref 17592186152832} {:db/id #edb/ref 17592186373729} {:db/id #edb/ref 17592186373736} {:db/id #edb/ref 17592186375439} {:db/id #edb/ref 17592186375446} {:db/id #edb/ref 17592186380726} {:db/id #edb/ref 17592186380733} {:db/id #edb/ref 17592186410107}] :knowledge-point/title "Simplifying a Double Negation"} :step/id #uuid "4ca4d75a-1805-5443-b3f6-3a98bafec5cc" :step/math-academy-id 120084}] :activity/title "The \"Not\" Connective" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186152374}] [{:activity/course {:db/id #edb/ref 17592186046673} :activity/first-step {:db/id #edb/ref 17592186419030} :activity/id #uuid "bfb8308f-9d2a-5c3b-904c-dfb00bba239f" :activity/scope {:db/id #edb/ref 17592186048349 :topic/id #uuid "97a8f3f2-67ab-5291-a6e0-b7d19b4541f0" :topic/math-academy-id 2790} :activity/steps [{:db/id #edb/ref 17592186419026 :step/content {:db/id #edb/ref 17592186410106 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5cf34be5-c594-5496-aa61-41f145440bc7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬P∨¬Q" :db/id #edb/ref 17592186410072} {:answer/id #uuid "7371329d-96b6-51ea-bfe7-14de7b40abf6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬(P∧Q)" :db/id #edb/ref 17592186410077} {:answer/id #uuid "964b4c56-2ede-5a41-8d97-6bcfd3830f9d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬P∧Q" :db/id #edb/ref 17592186410082} {:answer/id #uuid "9beb2485-dd7e-565f-bf11-7179015d4947" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬(P∨Q)" :db/id #edb/ref 17592186410083} {:answer/id #uuid "cd5a65eb-c2e8-56a1-b5c7-79f43616d6f7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬P∨Q" :db/id #edb/ref 17592186410088}] :answer-field/correct {:db/id #edb/ref 17592186410083} :answer-field/id #uuid "81e17c23-e75b-5224-95d3-5b0d550456c4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186410099}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "bc8abf72-5929-5991-bf8d-19db968b0381" :question/math-academy-id "q-81400" :question/problem "$10$ is **not** divisible by $3$ or $4.$\n\nExpress the compound statement above in symbolic form given the following:\n\n- $P:10\\text{ is divisible by }3$\n\n- $Q:10\\text{ is divisible by }4$" :question/worked-solution "The given sentence is the negation of the following sentence: \n\n$10$ is divisible by $3$ or $4$, \n\nwhich can be expressed symbolically as $P∨Q.$\n\nThe negation is represented by the symbol \"$¬$\". \n\nTherefore, the given sentence is expressed symbolically as $¬(P∨Q).$"} :step/id #uuid "4f1521f4-bf4b-579e-96c7-8716bbb01f24" :step/next {:db/id #edb/ref 17592186419028}} {:db/id #edb/ref 17592186419027 :step/content {:db/id #edb/ref 17592186410109 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4633fe49-2c21-5720-a63c-558f45288fa2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{T}" :db/id #edb/ref 17592186410068} {:answer/id #uuid "4a01d36c-4604-5b36-b3e3-00487d979e7f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{F}" :db/id #edb/ref 17592186410070}] :answer-field/correct {:db/id #edb/ref 17592186410068} :answer-field/id #uuid "5660f069-31c9-5611-ada9-3b00eeb9abf2" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186410097} {:answer-field/choices [{:answer/id #uuid "b14e0483-a372-5fd9-9aac-a4c6418f0a40" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{T}" :db/id #edb/ref 17592186410084} {:answer/id #uuid "e24ff342-e818-59d7-8686-5fbf7bfd82cf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{F}" :db/id #edb/ref 17592186410091}] :answer-field/correct {:db/id #edb/ref 17592186410091} :answer-field/id #uuid "7deb5fe1-b953-59ea-8d33-11d1bf079ff6" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186410098} {:answer-field/choices [{:answer/id #uuid "5aeaae2d-638b-50a2-9bc8-5391e436e264" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{F}" :db/id #edb/ref 17592186410071} {:answer/id #uuid "f725e384-3087-53ec-8dea-0de0981c9118" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{T}" :db/id #edb/ref 17592186410093}] :answer-field/correct {:db/id #edb/ref 17592186410071} :answer-field/id #uuid "9689e0cd-e889-5811-9b2c-26c58d6abd6c" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186410100} {:answer-field/choices [{:answer/id #uuid "68f75dcd-4b71-5caa-9634-a7a3ad02f645" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{T}" :db/id #edb/ref 17592186410074} {:answer/id #uuid "844e1f82-b2f7-50b6-a9e7-d4d1243f25fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{F}" :db/id #edb/ref 17592186410080}] :answer-field/correct {:db/id #edb/ref 17592186410080} :answer-field/id #uuid "e14512f5-568b-572f-88e5-8b63aa118ca8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186410103}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f8845516-a376-50cc-8625-12673b114608" :question/math-academy-id "q-182350" :question/problem "Find the missing values in the following truth table:\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,A∧¬B\\,$ |\n| --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | {{field-1}} |\n| $\\text{T}$ | $\\text{F}$ | {{field-2}} |\n| $\\text{F}$ | $\\text{T}$ | {{field-3}} |\n| $\\text{F}$ | $\\text{F}$ | {{field-4}} |" :question/worked-solution "First, we add a column for $¬B,$ where the truth values are opposite to the corresponding values in the column for $B.$ \n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,¬B\\,$ |\n| --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | $\\text{F}$ |\n| $\\text{T}$ | $\\text{F}$ | $\\text{T}$ |\n| $\\text{F}$ | $\\text{T}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{F}$ | $\\text{T}$ |\n\nThen, we add a column for $A∧¬B.$ Remember that $A∧¬B$ is true if both $A$ and $¬B$ are true.\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,¬B\\,$ | $\\,A∧¬B\\,$ |\n| --- | --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | $\\text{F}$ | $\\text{F}$ |\n| $\\text{T}$ | $\\text{F}$ | $\\text{T}$ | $\\text{T}$ |\n| $\\text{F}$ | $\\text{T}$ | $\\text{F}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{F}$ | $\\text{T}$ | $\\text{F}$ |"} :step/id #uuid "94ad02f3-e1b3-5f12-96c2-27d98011331b" :step/next {:db/id #edb/ref 17592186419029}} {:db/id #edb/ref 17592186419028 :step/content {:db/id #edb/ref 17592186410108 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29224407-55cf-551f-b649-9fde0ff90969" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "P∨¬Q" :db/id #edb/ref 17592186410065} {:answer/id #uuid "70bc8ea3-93c8-58ea-848f-ec99ae31061f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬(P∧Q)" :db/id #edb/ref 17592186410075} {:answer/id #uuid "72bcfa5c-5b94-5b39-8907-f5e55b173ceb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬P∨Q" :db/id #edb/ref 17592186410076} {:answer/id #uuid "b3a7f504-4ca7-5894-b89f-b544a051e640" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "P∧¬Q" :db/id #edb/ref 17592186410085} {:answer/id #uuid "bf299fda-072c-544f-b29f-e8fcc1aa3744" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬(P∨Q)" :db/id #edb/ref 17592186410086}] :answer-field/correct {:db/id #edb/ref 17592186410086} :answer-field/id #uuid "3485fc02-497e-5efc-b575-32abe89dc9c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186410095}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e5ae3f5a-c838-553b-8c0d-d176aea1d388" :question/math-academy-id "q-176861" :question/problem "$\\pi $ is **not** a rational or negative number.\n\nExpress the compound statement above in symbolic form given the following:\n\n- $P:\\pi \\text{ is a rational number}$\n\n- $Q:\\pi \\text{ is a negative number}$" :question/worked-solution "The given sentence is the negation of the following sentence: \n\n$\\pi $ is a rational or negative number, \n\nwhich can be expressed symbolically as $P∨Q.$\n\nThe negation is represented by the symbol \"$¬$\".  \n\nTherefore, the given sentence is expressed symbolically as $¬(P∨Q).$"} :step/id #uuid "94f8a49c-36c4-5117-aef4-ce993a2dc394" :step/next {:db/id #edb/ref 17592186419027}} {:db/id #edb/ref 17592186419029 :step/content {:db/id #edb/ref 17592186410105 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02a760ee-5936-56b4-bcc6-367c6cb4e864" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{F}" :db/id #edb/ref 17592186410063} {:answer/id #uuid "e236a867-6c27-5383-a8c6-c14b93397b44" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{T}" :db/id #edb/ref 17592186410090}] :answer-field/correct {:db/id #edb/ref 17592186410090} :answer-field/id #uuid "2fc94c3d-55a6-52a8-befa-23370d9ac2eb" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186410094} {:answer-field/choices [{:answer/id #uuid "31a1a336-0977-5fd7-b705-264101c48ef3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{T}" :db/id #edb/ref 17592186410067} {:answer/id #uuid "60aec5ee-3aa6-551a-9801-5a69fcafe967" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{F}" :db/id #edb/ref 17592186410073}] :answer-field/correct {:db/id #edb/ref 17592186410073} :answer-field/id #uuid "4559bdf1-e658-5991-973b-1850639db1c5" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186410096} {:answer-field/choices [{:answer/id #uuid "1361bf8f-3f03-5934-b7b4-8ab61ff8a2e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{F}" :db/id #edb/ref 17592186410064} {:answer/id #uuid "c78c7797-b922-549a-9951-a4aa5718fb45" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{T}" :db/id #edb/ref 17592186410087}] :answer-field/correct {:db/id #edb/ref 17592186410087} :answer-field/id #uuid "beaf4f62-b5f6-5599-ada6-b031d8f0f2c8" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186410102} {:answer-field/choices [{:answer/id #uuid "2cfb75b6-b8ba-5513-85da-49f6a4546360" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{T}" :db/id #edb/ref 17592186410066} {:answer/id #uuid "d57eea81-3aed-50fc-b8cb-ac92bc70c961" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{F}" :db/id #edb/ref 17592186410089}] :answer-field/correct {:db/id #edb/ref 17592186410066} :answer-field/id #uuid "ee6c6021-4135-5e83-9510-560eaf4934a5" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186410104}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "594bcd16-11e5-554c-954b-51c8f4ae33f3" :question/math-academy-id "q-182392" :question/problem "Find the missing values in the following truth table:\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,¬(A∧B)\\,$ |\n| --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | {{field-1}} |\n| $\\text{T}$ | $\\text{F}$ | {{field-2}} |\n| $\\text{F}$ | $\\text{T}$ | {{field-3}} |\n| $\\text{F}$ | $\\text{F}$ | {{field-4}} |" :question/worked-solution "First, we add a column for $A∧B.$ Remember that $A∧B$ is true if both $A$ and $B$ are true.\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,A∧B\\,$ |\n| --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | $\\text{T}$ |\n| $\\text{T}$ | $\\text{F}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{T}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{F}$ | $\\text{F}$ |\n\nThen, we add a column for $¬(A∧B).$ Remember that the truth values of $¬(A∧B)$ are opposite those of $A∧B.$\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,A∧B\\,$ | $\\,¬(A∧B)\\,$ |\n| --- | --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | $\\text{T}$ | $\\text{F}$ |\n| $\\text{T}$ | $\\text{F}$ | $\\text{F}$ | $\\text{T}$ |\n| $\\text{F}$ | $\\text{T}$ | $\\text{F}$ | $\\text{T}$ |\n| $\\text{F}$ | $\\text{F}$ | $\\text{F}$ | $\\text{T}$ |"} :step/id #uuid "ab9043b6-86e0-58a1-93e8-67e6dae7f9ec"} {:db/id #edb/ref 17592186419030 :step/content {:db/id #edb/ref 17592186410107 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49aac272-50b1-592b-864f-1a27db474750" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬(P∨Q)" :db/id #edb/ref 17592186410069} {:answer/id #uuid "7f9aec45-b986-56ea-b358-ed7dc5a0050d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "P∧Q" :db/id #edb/ref 17592186410078} {:answer/id #uuid "80e5b503-c1f3-55be-8dcc-bddf5095cdd8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬P∨¬Q" :db/id #edb/ref 17592186410079} {:answer/id #uuid "95f97ab8-d3e1-53de-9f6b-81d4359de9e6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "P∨Q" :db/id #edb/ref 17592186410081} {:answer/id #uuid "ec945e37-e9c4-5c98-af1f-ed01f7eca675" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "P∨¬Q" :db/id #edb/ref 17592186410092}] :answer-field/correct {:db/id #edb/ref 17592186410081} :answer-field/id #uuid "ad0dfdbd-2a82-546a-8ef0-7ca0d999f989" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186410101}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d4b4ae83-c202-571a-9f3a-530441a220fc" :question/math-academy-id "q-81359" :question/problem "Simplify the statement $P∨¬(¬Q).$" :question/worked-solution "Two negations in a row cancel each other out. So, we can simplify $¬(¬Q)$ to $Q.$\n\nTherefore, the given statement can be simplified to \n\n$$\nP∨Q.\n$$"} :step/id #uuid "c154e26d-1951-59a3-8a98-2844d71a28d7" :step/next {:db/id #edb/ref 17592186419026}}] :activity/title "The \"Not\" Connective" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186419025}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186106763} :activity/id #uuid "eb9e7f19-fbe1-5bc0-8cac-285a26936c70" :activity/scope {:db/id #edb/ref 17592186048368 :topic/id #uuid "99cc78ff-5612-5e6a-a347-8c2389044b69" :topic/math-academy-id 1290} :activity/steps [{:db/id #edb/ref 17592186106759 :step/content {:db/id #edb/ref 17592186105817 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105651 :question/id #uuid "d044f208-be6c-508f-b92d-221f36a8edcf" :question/math-academy-id "e-7352"} :knowledge-point/id #uuid "2f7256c7-afea-5c33-a859-623b0531e88c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048905} {:db/id #edb/ref 17592186049162} {:db/id #edb/ref 17592186049707}] :knowledge-point/questions [{:db/id #edb/ref 17592186106497} {:db/id #edb/ref 17592186106498} {:db/id #edb/ref 17592186259776} {:db/id #edb/ref 17592186351543} {:db/id #edb/ref 17592186351546} {:db/id #edb/ref 17592186351547} {:db/id #edb/ref 17592186351548} {:db/id #edb/ref 17592186357387}] :knowledge-point/title "Identifying Discrete Random Variables"} :step/id #uuid "04131611-f675-5229-bd1f-811eaf724260" :step/math-academy-id 27298 :step/next {:db/id #edb/ref 17592186106793}} {:db/id #edb/ref 17592186106760 :step/content {:db/id #edb/ref 17592186105818 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105652 :question/id #uuid "528a4e6c-6338-56ae-a56b-3de96b69b32c" :question/math-academy-id "e-7353"} :knowledge-point/id #uuid "53675175-8261-54ef-8dfb-2b3087b91239" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049534}] :knowledge-point/questions [{:db/id #edb/ref 17592186106494} {:db/id #edb/ref 17592186106499} {:db/id #edb/ref 17592186235401} {:db/id #edb/ref 17592186259722}] :knowledge-point/title "Identifying Probability Mass Functions"} :step/id #uuid "d66903ed-322e-5a89-82cf-d007695d5d4c" :step/math-academy-id 27299 :step/next {:db/id #edb/ref 17592186106762}} {:db/id #edb/ref 17592186106761 :step/content {:db/id #edb/ref 17592186105819 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105653 :question/id #uuid "f70939b9-5f06-57e8-ac4a-d4217a12aa6d" :question/math-academy-id "e-7354"} :knowledge-point/id #uuid "d22f7889-e5e4-5237-bb3b-fe1572ef4fbf" :knowledge-point/questions [{:db/id #edb/ref 17592186106495} {:db/id #edb/ref 17592186106501} {:db/id #edb/ref 17592186259729} {:db/id #edb/ref 17592186302130} {:db/id #edb/ref 17592186410420}] :knowledge-point/title "Computing the Probability That a Discrete Random Variable Lies Within an Interval"} :step/id #uuid "ec55bd0b-4d12-5185-b2f3-c2f5b6e10834" :step/math-academy-id 27300} {:db/id #edb/ref 17592186106762 :step/content {:db/id #edb/ref 17592186105820 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105654 :question/id #uuid "c27e7286-1b80-532a-945e-e7897f4635eb" :question/math-academy-id "e-7355"} :knowledge-point/id #uuid "35193ec5-030d-5c78-b536-08e23bd3b7d4" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049911}] :knowledge-point/questions [{:db/id #edb/ref 17592186106496} {:db/id #edb/ref 17592186106500} {:db/id #edb/ref 17592186235402} {:db/id #edb/ref 17592186351550}] :knowledge-point/title "Computing the Probability That a Discrete Random Variable Lies Within a Set of Values"} :step/id #uuid "c81f0294-20be-52d5-b339-bc0866cf7bdc" :step/math-academy-id 27301 :step/next {:db/id #edb/ref 17592186106761}} {:db/id #edb/ref 17592186106763 :step/content {:db/id #edb/ref 17592186107103 :tutorial/content "A **random variable** is a variable whose value is determined by the outcome of a trial or experiment.\n\nFor example, suppose we conduct an experiment where we flip a coin twice. The sample space for this experiment, which we'll denote as $\\Omega$ (the Greek capital letter \"Omega\") is given below:\n\n$$\n\\Omega = \\left\\{HH, HT, TH, TT\\right\\}\n$$\n\nNow, suppose we define the random variable $X$ as follows:\n\n$\\qquad$ $X =$ \"*the number of heads we get when a coin is flipped twice*.\" \n\nLet's work out the possible values of $X.$\n\n- If we get two heads (i.e. the outcome of the experiment is an element of $\\{HH\\}$), then $X = 2.$\n\n- If we get one head (i.e. the outcome of the experiment is an element of $\\{HT,TH\\}$), then $X = 1.$\n\n- If we get no heads (i.e. the outcome of the experiment is an element of $\\{TT\\}$), then $X = 0.$\n\nSo, the possible values of $X$ are given by the following set:\n\n$$\nS = \\{0,1,2\\}\n$$\n\nInformally, if we flip a coin twice and count the number of heads, we can get either no heads, one head, or two heads. No other values are possible.\n\nThe set $S$ is called the **range** or **support** of $X,$ and it includes *every possible value* of the random variable $X.$" :tutorial/id #uuid "0e1db88b-1f70-5049-bcce-35015bbe268c" :tutorial/math-academy-id 4440 :tutorial/title "Introduction"} :step/id #uuid "d8be7abf-649f-5403-aa2f-6829e8676c16" :step/math-academy-id 27302 :step/next {:db/id #edb/ref 17592186106831}} {:db/id #edb/ref 17592186106793 :step/content {:db/id #edb/ref 17592186107115 :tutorial/content "The **probability distribution**, or more precisely, **probability mass function** of a discrete random variable $X$ on a set $S$ is a function $f(x)$ that maps each element $x \\in S$ to its probability of occurring:\n\n$$\nP(X = x) = f(x)\n$$\n\nThe above can be read as \"the probability that the random variable $X$ takes on the value $x,$ is equal to $f(x).$\"\n\nFor example, if $X$ is the result of rolling a $6$-sided die, then we have\n\n$$\n{\\begin{aligned}\\frac{1}{6},\\, & x=1,2,3,4,5,6 \\\\ 0,\\, & \\text{otherwise}.\\end{aligned}\n$$\n\nThis function tells us that\n\n- the probability of the die landing on any integer between $1$ and $6$ inclusive is $\\dfrac{1}{6},$ and\n\n- the probability of the die landing on any other number is zero.\n\nWe can also represent this probability mass function using a table, as follows:\n\n| $x$ | $1$ | $2$ | $3$ | $4$ | $5$ | $6$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $\\dfrac{1}{6}$ | $\\dfrac{1}{6}$ | $\\dfrac{1}{6}$ | $\\dfrac{1}{6}$ | $\\dfrac{1}{6}$ | $\\dfrac{1}{6}$ |" :tutorial/id #uuid "66daf81e-f474-50f8-b670-e55e24eeb1db" :tutorial/math-academy-id 4609 :tutorial/title "The Probability Mass Function for a Discrete Random Variable"} :step/id #uuid "0cfde5a4-e03f-5b7b-b7a3-084b4e188e40" :step/math-academy-id 28351 :step/next {:db/id #edb/ref 17592186106832}} {:db/id #edb/ref 17592186106831 :step/content {:db/id #edb/ref 17592186107132 :tutorial/content "A **discrete random variable** is a random variable\n\n- that has finitely many possible values, or\n\n- whose possible values can be listed in a sequence: $x_1, x_2, x_3, \\ldots$\n\nNote that an interval of real numbers cannot be listed in a sequence.\n\nFor example, the result of rolling a $6$-sided dice is a discrete random variable because its possible values can be listed in a sequence: $1,2,3,4,5,6.$\n\nOn the other hand, the temperature outside is *not* a discrete random variable because its possible values form an interval of real numbers. The temperature could be anywhere between, say, $50^\\circ \\, \\textrm F$ and $90^\\circ \\, \\textrm F,$ and the interval of real numbers $[50, 90]$ cannot be listed in a sequence." :tutorial/id #uuid "41fdd07b-af71-5dd7-8541-e3c161774315" :tutorial/math-academy-id 6286 :tutorial/title "Discrete Random Variables"} :step/id #uuid "ee2b1f28-9218-55e7-85d6-9d0eb6abb586" :step/math-academy-id 38089 :step/next {:db/id #edb/ref 17592186106759}} {:db/id #edb/ref 17592186106832 :step/content {:db/id #edb/ref 17592186107133 :tutorial/content "In general, for a function $f(x)$ to be a valid probability mass function for a random variable $X$ on a set $S,$ it must satisfy the following conditions:\n\n- $0 \\leq f(x) \\leq 1$ for all $x$ in $S$\n\n- $\\displaystyle \\sum\\limits_{x \\in S} f(x) = 1$\n\nThere is some nice intuition to the conditions above.\n\n- The condition $0 \\leq f(x) \\leq 1$ for all $x$ in $S$ states that any possible outcome for $X$ must have a probability between $0$ and $1.$\n\n- The condition $\\displaystyle \\sum\\limits_{x \\in S} f(x) = 1$ states that the sum of all the probabilities over all possible values of $X$ must add up to $1.$" :tutorial/id #uuid "e714d0c9-9e63-52c5-a365-16afc370e98e" :tutorial/math-academy-id 6287 :tutorial/title "Conditions for a Function To Be a Valid Probability Mass Function"} :step/id #uuid "3e5fcbe4-37c4-5421-b3a8-e040c80da52d" :step/math-academy-id 38090 :step/next {:db/id #edb/ref 17592186106760}}] :activity/title "Probability Mass Functions of Discrete Random Variables" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186105966}] [{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186130040} :activity/id #uuid "089b1802-0940-53e5-af98-b7a9c26bba1d" :activity/scope {:db/id #edb/ref 17592186048413 :topic/id #uuid "9cbfcac9-bcba-5bd9-9527-641435a44ebd" :topic/math-academy-id 1990} :activity/steps [{:db/id #edb/ref 17592186130039 :step/content {:db/id #edb/ref 17592186129175 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128994 :question/id #uuid "7caffa88-776d-52e1-8b81-2ebf98aedebc" :question/math-academy-id "e-6122"} :knowledge-point/id #uuid "c0559f0c-a1ca-5ba8-a02e-71d584273958" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049574}] :knowledge-point/questions [{:db/id #edb/ref 17592186129421} {:db/id #edb/ref 17592186129855} {:db/id #edb/ref 17592186259568} {:db/id #edb/ref 17592186259569} {:db/id #edb/ref 17592186259570} {:db/id #edb/ref 17592186341844} {:db/id #edb/ref 17592186341885} {:db/id #edb/ref 17592186364900} {:db/id #edb/ref 17592186364907}] :knowledge-point/title "Calculating a Double Integral Using Lower and Upper Riemann Sums"} :step/id #uuid "02381e3e-cb34-5f3b-8940-d1b55826683c" :step/math-academy-id 22783 :step/next {:db/id #edb/ref 17592186130120}} {:db/id #edb/ref 17592186130040 :step/content {:db/id #edb/ref 17592186130379 :tutorial/content "Let $f(x,y)$ be a positive, continuous function defined on a closed and bounded rectangle $R,$ and let $P = P_1\\times P_2$ be a partition of $R.$ We know that the volume $V$ bounded by the surface $z=f(x,y)$ and the region $R$ in the $xy$-plane satisfies\n\n$$\nL(f,P) \\leq V \\leq U(f,P),\n$$\n\nwhere $L(f, P)$ and $U(f, P)$ are the lower and upper Riemann sums of $f$ with respect to $P.$\n\nImagine that our initial partition $P$ consists of a few rectangles only. Let's visualize the corresponding lower and upper Riemann sums, as shown below:\n\n![](images/89/89ad0fd33f34cfad4f55fc2085360878460df92479f5f938ecd254420457f3f4.png)\n\n \n\nThen, we refine $P$ by adding more points to $P_1$ and $P_2,$ resulting in more rectangles in $P{:}$ \n\n![](images/56/5635f58e19c47d6a9cfeab49c298ce5ca7aa1d8697e1b53390bb3bc31859637c.png)\n\n \n\nRefining the partition once again, we get the following:\n\n![](images/b2/b22f267ecf28627404eb90928e44d59b2873e88adc22ffaaa0a1a3335fffa307.png)\n\n \n\nAs we continue to refine $P$ by adding more and more points to $P_1$ and $P_2,$ we find that the values of the lower and upper Riemann sums approach the volume $V{:}$\n\n- $L(f, P)\\to V$ from below, and\n\n- $U(f, P) \\to V$ from above.\n\nWe define the **double integral** of $f(x,y)$ over $R$ as the *unique* number $I$ that satisfies the inequality\n\n$$\nL(f,P) \\leq I \\leq U(f,P)\n$$\n\nfor *all* partitions $P$ of $R,$ and we write\n\n$$\nI=\\iint\\limits_R f(x,y) \\, \\text{d}A.\n$$\n\nThe double integral gives the exact volume bounded between the surface $z=f(x,y)$ and $R.$" :tutorial/id #uuid "b9ba8fdf-255d-53c2-832a-34ed3374abb0" :tutorial/math-academy-id 3884 :tutorial/title "Introduction"} :step/id #uuid "7ef801e2-e7f6-542e-aab3-64391c418f88" :step/math-academy-id 22946 :step/next {:db/id #edb/ref 17592186130121}} {:db/id #edb/ref 17592186130120 :step/content {:db/id #edb/ref 17592186129220 :knowledge-point/canonical-example {:db/id #edb/ref 17592186129039 :question/id #uuid "3464909c-5b04-5cb1-96c9-a409fa105bb9" :question/math-academy-id "e-9494"} :knowledge-point/id #uuid "0b9d2e98-8007-51ec-bfb6-cb9b48029a2a" :knowledge-point/questions [{:db/id #edb/ref 17592186129853} {:db/id #edb/ref 17592186129854} {:db/id #edb/ref 17592186259571} {:db/id #edb/ref 17592186259572} {:db/id #edb/ref 17592186341883} {:db/id #edb/ref 17592186341884} {:db/id #edb/ref 17592186371679} {:db/id #edb/ref 17592186371686} {:db/id #edb/ref 17592186544806} {:db/id #edb/ref 17592186544863}] :knowledge-point/title "Calculating a Double Integral Using the Mean Value of X and Y"} :step/id #uuid "5af32a1a-efb5-509d-a196-f411e5d46fc5" :step/math-academy-id 35550 :step/next {:db/id #edb/ref 17592186130122}} {:db/id #edb/ref 17592186130121 :step/content {:db/id #edb/ref 17592186129221 :knowledge-point/canonical-example {:db/id #edb/ref 17592186129040 :question/id #uuid "e75f2d8e-c165-5a24-942b-7326d7f11f0f" :question/math-academy-id "e-9497"} :knowledge-point/id #uuid "89023510-57f4-52f9-90ed-eae07f48f707" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049348} {:db/id #edb/ref 17592186050883}] :knowledge-point/questions [{:db/id #edb/ref 17592186129422} {:db/id #edb/ref 17592186129423} {:db/id #edb/ref 17592186259547} {:db/id #edb/ref 17592186259548} {:db/id #edb/ref 17592186259549} {:db/id #edb/ref 17592186259550} {:db/id #edb/ref 17592186544824}] :knowledge-point/title "Applying the Definition of the Double Integral in Terms of Lower and Upper Riemann Sums"} :step/id #uuid "38972544-74f5-555d-aadd-8581d0da7887" :step/math-academy-id 35559 :step/next {:db/id #edb/ref 17592186130039}} {:db/id #edb/ref 17592186130122 :step/content {:db/id #edb/ref 17592186130417 :tutorial/content "Throughout this lesson, we've defined the double integral of $f(x,y)$ over $R$ as the *unique* number $I$ (if it exists) that satisfies the inequality\n\n$$\nL(f,P) \\leq I \\leq U(f,P)\n$$\n\nfor *all* partitions $P$ of $R,$ and we write\n\n$$\nI=\\iint\\limits_R f(x,y) \\, \\text{d}A.\n$$\n\nWe note the following:\n\n- Up to now, we've assumed that $f(x,y)$ is continuous and $R$ is closed and bounded. Whenever this is the case, a unique number $I$ will always exist.\n\n- For positive, continuous functions, the double integral gives the exact volume bounded between the surface $z=f(x,y)$ and $R.$\n\n- More generally, the double integral gives a signed volume. If $f$ is negative everywhere on $R,$ then the double integral of $f$ over $R$ is negative. If $f$ is both positive and negative on $R,$ then the double integral gives the difference between the positive and negative unsigned volumes. This is similar to the case with definite integrals for single-valued functions.\n\n- Finally, It's possible to use this definition with functions that are not continuous. If a function $f$ (not necessarily continuous) is defined over $R,$ we say that $f$ is **Riemann integrable** over $R$ if a unique number $I$ can be found that satisfies the above inequality. Many (though not all) non-continuous functions are Riemann integrable." :tutorial/id #uuid "b0889acb-60da-5e9c-9f1b-530b118b05f9" :tutorial/math-academy-id 5824 :tutorial/title "Final Remarks"} :step/id #uuid "3c30b46b-78e4-5a7f-bec5-89ef0019d000" :step/math-academy-id 35700}] :activity/title "Defining Double Integrals Using Lower and Upper Riemann Sums" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186129337}] [{:activity/expected-seconds 960.0 :activity/first-step {:db/id #edb/ref 17592186120672} :activity/id #uuid "6ede3e68-1ff6-5e3c-afed-499bb387f9a1" :activity/scope {:db/id #edb/ref 17592186048499 :topic/id #uuid "a4bbeec2-7e3f-58f1-87d1-563d58d73752" :topic/math-academy-id 1851} :activity/steps [{:db/id #edb/ref 17592186120672 :step/content {:db/id #edb/ref 17592186121034 :tutorial/content "Consider a vector $\\mathbf{u}$ which is given in terms of the vectors $\\mathbf{v_1}$ and $\\mathbf{v_2}$ as follows:\n\n$$\n{\\color{red}3}{\\color{blue}\\mathbf{v_1}}+({\\color{red}-2}){\\color{blue}\\mathbf{v_2}} = \\mathbf{u}\n$$\n\nHere, we say that $\\mathbf{u}$ is a **linear combination** of the vectors ${\\color{blue}\\mathbf{v_1}}$ and ${\\color{blue}\\mathbf{v_2}}$ with coefficients ${\\color{red}3}$ and ${\\color{red}-2}$ respectively. \n\nIn general, a linear combination of $n$ vectors $\\mathbf{v_1},\\mathbf{v_2},\\dots,\\mathbf{v_n}$ is the *weighted sum*\n\n$$\n{\\color{red}x_1}\\mathbf{\\color{blue}v_1}+{\\color{red}x_2}\\mathbf{\\color{blue}v_2}+\\cdots + {\\color{red}x_n}\\mathbf{\\color{blue}v_n} = \\mathbf{u},\n$$\n\nwhere ${\\color{red}x_1},{\\color{red}x_2},\\dots,{\\color{red}x_n}\\in\\mathbb{R}.$ We say that $\\mathbf{u}$ is a linear combination of the vectors $\\mathbf{\\color{blue}v_1},\\mathbf{\\color{blue}v_2},\\dots,\\mathbf{\\color{blue}v_n}$ with coefficients (or *weights*) ${\\color{red}x_1},{\\color{red}x_2},\\dots,{\\color{red}x_n},$ respectively.\n\nFor instance, \n![](images/ff/ff71636b9b5a34fec4de37b5e924c1c6bc3765c1ee823b325f5b0e01c0dc472a.svg)\nis the linear combination of vectors $\\mathbf{\\color{blue}v_1},\\mathbf{\\color{blue}v_2},\\mathbf{\\color{blue}v_3}$ with coefficients ${\\color{red}2}, {\\color{red}0}, {\\color{red}\\dfrac{1}{2}},$ respectively." :tutorial/id #uuid "229ae855-226b-5f95-b050-b98257747800" :tutorial/math-academy-id 3186 :tutorial/title "Introduction"} :step/id #uuid "b14c637b-1418-59f5-9ac3-37a07d6ad580" :step/math-academy-id 17456 :step/next {:db/id #edb/ref 17592186120673}} {:db/id #edb/ref 17592186120673 :step/content {:db/id #edb/ref 17592186119805 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119616 :question/id #uuid "fd3cb5b1-f16e-5a52-82e4-25bbbd1c4fe7" :question/math-academy-id "e-4789"} :knowledge-point/id #uuid "33586620-e110-5a37-874f-a92103c5e9fb" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048673} {:db/id #edb/ref 17592186049814}] :knowledge-point/question-generator {:db/id #edb/ref 17592186542367} :knowledge-point/questions [{:db/id #edb/ref 17592186120311} {:db/id #edb/ref 17592186120312} {:db/id #edb/ref 17592186240984} {:db/id #edb/ref 17592186240985} {:db/id #edb/ref 17592186314967} {:db/id #edb/ref 17592186317257} {:db/id #edb/ref 17592186319044} {:db/id #edb/ref 17592186319045} {:db/id #edb/ref 17592186319047} {:db/id #edb/ref 17592186419107} {:db/id #edb/ref 17592186542353} {:db/id #edb/ref 17592186542366}] :knowledge-point/title "Solving for One Coefficient in a Linear Combination"} :step/id #uuid "c7323a52-d0b1-55ea-81f4-41623766b9db" :step/math-academy-id 17458 :step/next {:db/id #edb/ref 17592186120674}} {:db/id #edb/ref 17592186120674 :step/content {:db/id #edb/ref 17592186119806 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119617 :question/id #uuid "548ef945-392b-5e75-9b60-14f4e2de6261" :question/math-academy-id "e-4790"} :knowledge-point/id #uuid "590953b8-2533-5a4b-bf4f-f002b0367919" :knowledge-point/question-generator {:db/id #edb/ref 17592186518762} :knowledge-point/questions [{:db/id #edb/ref 17592186120310} {:db/id #edb/ref 17592186120351} {:db/id #edb/ref 17592186240986} {:db/id #edb/ref 17592186240987} {:db/id #edb/ref 17592186240988} {:db/id #edb/ref 17592186314969} {:db/id #edb/ref 175921863