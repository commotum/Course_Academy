      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14261987/observations/step-q132512-2cfa7e6a03e5bd873835.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14261987/observations/step-q132512-2cfa7e6a03e5bd873835.png",
