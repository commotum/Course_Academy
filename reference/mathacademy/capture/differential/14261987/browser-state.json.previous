      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14261987/observations/step-q132518-9ef21b310cf757b2bbbd.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14261987/observations/step-q132518-9ef21b310cf757b2bbbd.png",
      "source_url": "https://mathacademy.com/tasks/14261987/topics/2152/lesson",
      "captured_at": 1792169443.321788,
      "math_academy_id": "q-132518",
      "topic_id": "2152",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q132518",
