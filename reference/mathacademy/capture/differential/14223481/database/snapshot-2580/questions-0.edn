#{[{:db/id #edb/ref 17592186188782 :knowledge-point/_questions [{:db/id #edb/ref 17592186188359 :knowledge-point/id #uuid "96172470-bd90-53eb-aea7-87d08f462ea2" :knowledge-point/title "Calculating the Variance of a Sum of Scaled Random Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81ecbf8d-d029-5d82-afee-64f124b40e88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "88" :db/id #edb/ref 17592186186973} {:answer/id #uuid "8d9525f4-f1c3-55b3-84a9-7af9de25eeb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "112" :db/id #edb/ref 17592186186974} {:answer/id #uuid "ab034a58-29fa-5108-8380-ab56eec7fcce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "104" :db/id #edb/ref 17592186186975} {:answer/id #uuid "c5a94eed-091c-510c-baf3-b6efaea2b33d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "56" :db/id #edb/ref 17592186186976} {:answer/id #uuid "5a9fc544-9474-5b4b-8130-7fd304bd20bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186186977}] :answer-field/correct {:answer/id #uuid "ab034a58-29fa-5108-8380-ab56eec7fcce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "104" :db/id #edb/ref 17592186186975} :answer-field/id #uuid "3fd27e4d-f63b-52ae-9fb3-553aed61e3e2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186186972}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dd575cde-f82b-5f11-9a8c-382a5bdfaaac" :question/math-academy-id "q-148155" :question/problem "For two random variables $X$ and $Y,$ we have $\\text{Var}[X]=3,$ $\\text{Var}[Y]=6,$ and $\\text{Cov}[X,Y]=2.$ Find $\\text{Var}[4X+2Y].$" :question/requires-calculator true :question/worked-solution "Recall that if $X$ and $Y$ are random variables, and $a$ and $b$ are constants, then\n\n$$\n\\text{Var}[aX+bY]={a}^{2}\\text{Var}[X]+{b}^{2}\\text{Var}[Y]+2ab\\,\\text{Cov}[X,Y].\n$$\n\nSubstituting the given data into the formula above, we obtain\n\n$$\n\\begin{aligned}\\text{Var}[4X+2Y] & ={4}^{2}\\cdot 3+{2}^{2}\\cdot 6+2\\cdot 4\\cdot 2\\cdot 2 \\\\  & =48+24+32 \\\\  & =104.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186537932 :knowledge-point/_questions [{:db/id #edb/ref 17592186188359 :knowledge-point/id #uuid "96172470-bd90-53eb-aea7-87d08f462ea2" :knowledge-point/title "Calculating the Variance of a Sum of Scaled Random Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6ff55129-af5c-5c05-ba0c-79d2b64c94e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186537446} {:answer/id #uuid "7481dcce-5cb6-5d08-aba0-d849dc9f222e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186537459} {:answer/id #uuid "8fcb06a8-449e-5686-9043-282535027104" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{5}" :db/id #edb/ref 17592186537502} {:answer/id #uuid "cb00b5e5-8202-5384-a618-4818977df0c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{5}" :db/id #edb/ref 17592186537624} {:answer/id #uuid "eafe1606-b8c9-5c8f-9efb-4dfe5c92c0d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186537709}] :answer-field/correct {:answer/id #uuid "eafe1606-b8c9-5c8f-9efb-4dfe5c92c0d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186537709} :answer-field/id #uuid "35592764-2ebe-5eba-8d3a-5fd6d801071b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186537777}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7816847f-8647-5628-af20-0f9b03662f9a" :question/math-academy-id "q-148328" :question/problem "For two random variables $X$ and $Y,$ we have $\\text{Var}[X]=\\frac{1}{5},$ $\\text{Var}[Y]=\\frac{4}{5},$ and $\\text{Cov}[X,Y]=\\frac{3}{5}.$ Find $\\text{Var}[X-2Y].$" :question/worked-solution "Recall that if $X$ and $Y$ are random variables, and $a$ and $b$ are constants, then\n\n$$\n\\text{Var}[aX+bY]={a}^{2}\\text{Var}[X]+{b}^{2}\\text{Var}[Y]+2ab\\,\\text{Cov}[X,Y].\n$$\n\nSubstituting the given data into the formula above, we obtain\n\n$$\n\\begin{aligned}\\text{Var}[X-2Y] & ={1}^{2}\\cdot \\frac{1}{5}+(-2)^{2}\\cdot \\frac{4}{5}+2\\cdot 1\\cdot (-2)\\cdot \\frac{3}{5} \\\\  & =\\frac{1}{5}+\\frac{16}{5}-\\frac{12}{5} \\\\  & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186537974 :knowledge-point/_questions [{:db/id #edb/ref 17592186188360 :knowledge-point/id #uuid "39efc83e-6658-5b7a-979b-dbc35af5dd98" :knowledge-point/title "Calculating a Combined Variance Given Some Moments"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "122174e1-2c44-5e9e-ad09-27766b4736d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "116" :db/id #edb/ref 17592186537259} {:answer/id #uuid "128385d5-bbff-57a1-8e2c-763e126ac399" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "102" :db/id #edb/ref 17592186537262} {:answer/id #uuid "cb7e2361-9a17-5479-bcea-4c30a0b45a9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "98" :db/id #edb/ref 17592186537627} {:answer/id #uuid "e981695e-7fa7-5ee6-a201-39d90e43a9af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "76" :db/id #edb/ref 17592186537700} {:answer/id #uuid "ed768d67-5f42-5d63-9a00-ef0595ba307d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "84" :db/id #edb/ref 17592186537716}] :answer-field/correct {:answer/id #uuid "ed768d67-5f42-5d63-9a00-ef0595ba307d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "84" :db/id #edb/ref 17592186537716} :answer-field/id #uuid "ea6f32d4-0004-5767-8eca-1a4a4e3083fd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186537870}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d31ef211-c21b-5026-971f-34b7088e4f67" :question/math-academy-id "q-148339" :question/problem "Consider two random variables $X$ and $Y$ with expectations $\\text{E}[X]=2,$ $\\text{E}[Y]=3,$ mixed moment $\\text{E}[XY]=4,$ and second raw moments $\\text{E}[{X}^{2}]=8$ and $\\text{E}[{Y}^{2}]=15.$ Find the variance of $5X+2Y.$" :question/worked-solution "Recall that if $X$ and $Y$ are random variables and $a$ and $b$ are constants, then\n\n$$\n\\text{Var}[aX+bY]={a}^{2}\\text{Var}[X]+{b}^{2}\\text{Var}[Y]+2ab\\,\\text{Cov}[X,Y].\n$$\n\nAlso, the variance of a random variable $X$ is determined by the formula\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2},\n$$\n\nand the covariance of two random variables $X$ and $Y$ is given by the formula\n\n$$\n\\text{Cov}[X,Y]=\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y].\n$$\n\nFirst, let's find $\\text{Var}[X]:$\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =8-{2}^{2} \\\\  & =4\\end{aligned}\n$$\n\nSimilarly,\n\n$$\n\\begin{aligned}\\text{Var}[Y] & =\\text{E}[{Y}^{2}]-\\text{E}[Y]^{2} \\\\  & =15-{3}^{2} \\\\  & =6.\\end{aligned}\n$$\n\nNow, let's find $\\text{Cov}[X,Y]:$\n\n$$\n\\begin{aligned}\\text{Cov}[X,Y] & =\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y] \\\\  & =4-2\\cdot 3 \\\\  & =-2.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[5X+2Y] & ={5}^{2}\\cdot 4+{2}^{2}\\cdot 6+2\\cdot 5\\cdot 2\\cdot (-2) \\\\  & =100+24-40 \\\\  & =84.\\end{aligned}\n$$"}]}
