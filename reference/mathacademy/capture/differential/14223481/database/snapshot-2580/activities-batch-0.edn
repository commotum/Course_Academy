#{[{:activity/expected-seconds 780.0 :activity/first-step {:db/id #edb/ref 17592186189207} :activity/id #uuid "d3179e6a-7442-53e2-9f07-f6ef555a8fc0" :activity/scope {:db/id #edb/ref 17592186048165 :topic/id #uuid "84da0476-daa2-55f1-a6ab-9f6aa7e0bcf3" :topic/math-academy-id 3940} :activity/steps [{:db/id #edb/ref 17592186189207 :step/content {:db/id #edb/ref 17592186189413 :tutorial/content "Given two random variables $X$ and $Y,$ the variance of the sum or difference of these variables is given by\n\n$$\n\\textrm{Var}[X\\pm Y] = \\textrm{Var}[X] + \\textrm{Var}[Y] \\pm 2\\textrm{Cov}[X,Y],\n$$\n\nwhere $\\textrm{Cov}[X,Y]$ is the covariance of $X$ and $Y.$ We'll prove this formula at the end of the lesson.\n\nNote that if $X$ and $Y$ are independent, then $\\textrm{Cov}[X,Y]= 0,$ and we have\n\n$$\n\\textrm{Var}[X\\pm Y] = \\textrm{Var}[X] + \\textrm{Var}[Y].\n$$" :tutorial/id #uuid "84bffdf5-551d-52b7-93f3-5c7ba599e972" :tutorial/math-academy-id 6496 :tutorial/title "Introduction"} :step/id #uuid "91e3c205-114c-5ae0-8abd-5bb7f424476e" :step/math-academy-id 39341 :step/next {:db/id #edb/ref 17592186189208}} {:db/id #edb/ref 17592186189208 :step/content {:db/id #edb/ref 17592186188357 :knowledge-point/canonical-example {:db/id #edb/ref 17592186188065 :question/id #uuid "7ea98738-258e-5cc4-9e04-58b0b4638290" :question/math-academy-id "e-10435"} :knowledge-point/id #uuid "91379d24-6b6d-5642-8eb8-cbcc8feaf355" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049815} {:db/id #edb/ref 17592186050351}] :knowledge-point/questions [{:db/id #edb/ref 17592186188780} {:db/id #edb/ref 17592186188781} {:db/id #edb/ref 17592186527183} {:db/id #edb/ref 17592186527189} {:db/id #edb/ref 17592186527205} {:db/id #edb/ref 17592186527208}] :knowledge-point/title "Calculating the Variance of a Sum or Difference of Random Variables"} :step/id #uuid "8ceb42c5-5f3d-52e4-b3c8-bda0bdf99ba6" :step/math-academy-id 39343 :step/next {:db/id #edb/ref 17592186189211}} {:db/id #edb/ref 17592186189210 :step/content {:db/id #edb/ref 17592186188359 :knowledge-point/canonical-example {:db/id #edb/ref 17592186188067 :question/id #uuid "0bc5206c-e880-5016-9653-49ac54af4d2f" :question/math-academy-id "e-10443"} :knowledge-point/id #uuid "96172470-bd90-53eb-aea7-87d08f462ea2" :knowledge-point/questions [{:db/id #edb/ref 17592186188782} {:db/id #edb/ref 17592186188783} {:db/id #edb/ref 17592186527126} {:db/id #edb/ref 17592186527134} {:db/id #edb/ref 17592186527198} {:db/id #edb/ref 17592186527210} {:db/id #edb/ref 17592186537932}] :knowledge-point/title "Calculating the Variance of a Sum of Scaled Random Variables"} :step/id #uuid "982300e3-8874-58e0-b502-0dd1759d2e87" :step/math-academy-id 39369 :step/next {:db/id #edb/ref 17592186189212}} {:db/id #edb/ref 17592186189211 :step/content {:db/id #edb/ref 17592186189414 :tutorial/content "If $X$ and $Y$ are random variables and $a$ and $b$ are constants, then \n\n$$\n\\textrm{Var}[aX + bY] = a^2 \\textrm{Var}[X] + b^2 \\textrm{Var}[Y] + 2ab \\textrm{Cov}[X,Y].\n$$\n\nIf $X$ and $Y$ are independent, then $\\textrm{Cov}[X,Y] = 0,$ and we recover the formula\n\n$$\n\\textrm{Var}[aX + bY] = a^2 \\textrm{Var}[X] + b^2 \\textrm{Var}[Y] .\n$$" :tutorial/id #uuid "a2319f43-f4e9-5092-93cf-5e5f4f23f4f7" :tutorial/math-academy-id 6502 :tutorial/title "The Variance of a Sum of Scaled Random Variables"} :step/id #uuid "8153054a-c500-5f13-a328-66eb26fc4fb8" :step/math-academy-id 39370 :step/next {:db/id #edb/ref 17592186189210}} {:db/id #edb/ref 17592186189212 :step/content {:db/id #edb/ref 17592186188360 :knowledge-point/canonical-example {:db/id #edb/ref 17592186188068 :question/id #uuid "04bff442-bf0b-529b-a8d8-14538a1db48f" :question/math-academy-id "e-10444"} :knowledge-point/id #uuid "39efc83e-6658-5b7a-979b-dbc35af5dd98" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050327}] :knowledge-point/questions [{:db/id #edb/ref 17592186188786} {:db/id #edb/ref 17592186188787} {:db/id #edb/ref 17592186527156} {:db/id #edb/ref 17592186527173} {:db/id #edb/ref 17592186527224} {:db/id #edb/ref 17592186537974}] :knowledge-point/title "Calculating a Combined Variance Given Some Moments"} :step/id #uuid "ba8e9c50-818a-52c4-8395-b662c6ac186d" :step/math-academy-id 39371 :step/next {:db/id #edb/ref 17592186189222}} {:db/id #edb/ref 17592186189213 :step/content {:db/id #edb/ref 17592186188361 :knowledge-point/canonical-example {:db/id #edb/ref 17592186188069 :question/id #uuid "d849af65-721a-5a47-b8b7-9446e77046f2" :question/math-academy-id "e-10447"} :knowledge-point/id #uuid "f512d235-f663-502f-bd8c-6b3b6748913b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048820}] :knowledge-point/questions [{:db/id #edb/ref 17592186188784} {:db/id #edb/ref 17592186188785} {:db/id #edb/ref 17592186527219}] :knowledge-point/title "Calculating the Variance of a Sum of Three Random Variables"} :step/id #uuid "5fad4c43-2456-5538-bc40-e43bafabf67e" :step/math-academy-id 39377 :step/next {:db/id #edb/ref 17592186189223}} {:db/id #edb/ref 17592186189222 :step/content {:db/id #edb/ref 17592186189420 :tutorial/content "Finally, we have the following generalization for the variance of a sum of $n$ random variables.\n\n$$\n\\textrm{Var} \\left[ \\sum\\limits_{i=1}^{n} a_i X_i \\right] = \\sum\\limits_{i=1}^{n} a_i^2 \\textrm{Var}[X_i] + 2\\sum\\limits_{i < j} a_i a_j \\textrm{Cov}[X_i, X_j]\n$$\n\nLet's see an example of how this works in practice." :tutorial/id #uuid "5169e0a6-5da8-51b4-8e84-5154fe8622f5" :tutorial/math-academy-id 6535 :tutorial/title "Generalizing to Multiple Random Variables"} :step/id #uuid "63b7b972-cc52-5658-b0d3-7a5571d28c29" :step/math-academy-id 39481 :step/next {:db/id #edb/ref 17592186189213}} {:db/id #edb/ref 17592186189223 :step/content {:db/id #edb/ref 17592186189421 :tutorial/content "Let's prove the following formula:\n\n$$\n\\textrm{Var}[X+ Y] = \\textrm{Var}[X] + \\textrm{Var}[Y] + 2\\textrm{Cov}[X,Y]\n$$\n\nApplying the definition of variance and using the linearity of expectation, we have\n\n$$\n\\begin{aligned}\\text{Var}[X+Y] & =\\text{E}[((X+Y)-\\text{E}[X+Y])^{2}] \\\\  & =\\text{E}[((X-\\text{E}[X])+(Y-\\text{E}[Y]))^{2}] \\\\  & =\\text{E}[(X-\\text{E}[X])^{2}+(Y-\\text{E}[Y])^{2}+2(X-\\text{E}[X])(Y-\\text{E}[Y])].\\end{aligned}\n$$\n\nDistributing the expected value, and using the fact that $\\textrm{E}[aX] = a\\cdot \\textrm{E}[X]$ for constant $a,$ we have\n\n$$\n\\begin{aligned}\\text{Var}[X+Y] & =\\text{E}[(X-\\text{E}[X])^{2}+(Y-\\text{E}[Y])^{2}+2(X-\\text{E}[X])(Y-\\text{E}[Y])] \\\\  & =\\text{E}[(X-\\text{E}[X])^{2}]+\\text{E}[(Y-\\text{E}[Y])^{2}]+2\\cdot \\text{E}[(X-\\text{E}[X])(Y-\\text{E}[Y])] \\\\  & =\\text{Var}[X]+\\text{Var}[Y]+2\\text{Cov}[X,Y]\\end{aligned}\n$$\n\nas required. \n\nThe proof for the difference between two random variables is similar." :tutorial/id #uuid "7523c9e9-51f7-52f5-b206-eec1940bf0f9" :tutorial/math-academy-id 6536 :tutorial/title "Proof of the Sum Formula"} :step/id #uuid "9262448d-d4d1-5e9c-a798-bcc9d934f487" :step/math-academy-id 39482}] :activity/title "Variance of Sums of Random Variables" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186188522}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186538014} :activity/id #uuid "571d253e-3721-564a-9807-74e64b2231fa" :activity/scope {:db/id #edb/ref 17592186048165 :topic/id #uuid "84da0476-daa2-55f1-a6ab-9f6aa7e0bcf3" :topic/math-academy-id 3940} :activity/steps [{:db/id #edb/ref 17592186538001 :step/content {:db/id #edb/ref 17592186537974 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "122174e1-2c44-5e9e-ad09-27766b4736d7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "116" :db/id #edb/ref 17592186537259} {:answer/id #uuid "128385d5-bbff-57a1-8e2c-763e126ac399" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "102" :db/id #edb/ref 17592186537262} {:answer/id #uuid "cb7e2361-9a17-5479-bcea-4c30a0b45a9d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "98" :db/id #edb/ref 17592186537627} {:answer/id #uuid "e981695e-7fa7-5ee6-a201-39d90e43a9af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "76" :db/id #edb/ref 17592186537700} {:answer/id #uuid "ed768d67-5f42-5d63-9a00-ef0595ba307d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "84" :db/id #edb/ref 17592186537716}] :answer-field/correct {:db/id #edb/ref 17592186537716} :answer-field/id #uuid "ea6f32d4-0004-5767-8eca-1a4a4e3083fd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186537870}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d31ef211-c21b-5026-971f-34b7088e4f67" :question/math-academy-id "q-148339" :question/problem "Consider two random variables $X$ and $Y$ with expectations $\\text{E}[X]=2,$ $\\text{E}[Y]=3,$ mixed moment $\\text{E}[XY]=4,$ and second raw moments $\\text{E}[{X}^{2}]=8$ and $\\text{E}[{Y}^{2}]=15.$ Find the variance of $5X+2Y.$" :question/worked-solution "Recall that if $X$ and $Y$ are random variables and $a$ and $b$ are constants, then\n\n$$\n\\text{Var}[aX+bY]={a}^{2}\\text{Var}[X]+{b}^{2}\\text{Var}[Y]+2ab\\,\\text{Cov}[X,Y].\n$$\n\nAlso, the variance of a random variable $X$ is determined by the formula\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2},\n$$\n\nand the covariance of two random variables $X$ and $Y$ is given by the formula\n\n$$\n\\text{Cov}[X,Y]=\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y].\n$$\n\nFirst, let's find $\\text{Var}[X]:$\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =8-{2}^{2} \\\\  & =4\\end{aligned}\n$$\n\nSimilarly,\n\n$$\n\\begin{aligned}\\text{Var}[Y] & =\\text{E}[{Y}^{2}]-\\text{E}[Y]^{2} \\\\  & =15-{3}^{2} \\\\  & =6.\\end{aligned}\n$$\n\nNow, let's find $\\text{Cov}[X,Y]:$\n\n$$\n\\begin{aligned}\\text{Cov}[X,Y] & =\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y] \\\\  & =4-2\\cdot 3 \\\\  & =-2.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[5X+2Y] & ={5}^{2}\\cdot 4+{2}^{2}\\cdot 6+2\\cdot 5\\cdot 2\\cdot (-2) \\\\  & =100+24-40 \\\\  & =84.\\end{aligned}\n$$"} :step/id #uuid "2408d45f-690e-5c16-b285-71995f2e1e91"} {:db/id #edb/ref 17592186538014 :step/content {:db/id #edb/ref 17592186188782 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81ecbf8d-d029-5d82-afee-64f124b40e88" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "88" :db/id #edb/ref 17592186186973} {:answer/id #uuid "8d9525f4-f1c3-55b3-84a9-7af9de25eeb9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "112" :db/id #edb/ref 17592186186974} {:answer/id #uuid "ab034a58-29fa-5108-8380-ab56eec7fcce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "104" :db/id #edb/ref 17592186186975} {:answer/id #uuid "c5a94eed-091c-510c-baf3-b6efaea2b33d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "56" :db/id #edb/ref 17592186186976} {:answer/id #uuid "5a9fc544-9474-5b4b-8130-7fd304bd20bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "40" :db/id #edb/ref 17592186186977}] :answer-field/correct {:db/id #edb/ref 17592186186975} :answer-field/id #uuid "3fd27e4d-f63b-52ae-9fb3-553aed61e3e2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186186972}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "dd575cde-f82b-5f11-9a8c-382a5bdfaaac" :question/math-academy-id "q-148155" :question/problem "For two random variables $X$ and $Y,$ we have $\\text{Var}[X]=3,$ $\\text{Var}[Y]=6,$ and $\\text{Cov}[X,Y]=2.$ Find $\\text{Var}[4X+2Y].$" :question/requires-calculator true :question/worked-solution "Recall that if $X$ and $Y$ are random variables, and $a$ and $b$ are constants, then\n\n$$\n\\text{Var}[aX+bY]={a}^{2}\\text{Var}[X]+{b}^{2}\\text{Var}[Y]+2ab\\,\\text{Cov}[X,Y].\n$$\n\nSubstituting the given data into the formula above, we obtain\n\n$$\n\\begin{aligned}\\text{Var}[4X+2Y] & ={4}^{2}\\cdot 3+{2}^{2}\\cdot 6+2\\cdot 4\\cdot 2\\cdot 2 \\\\  & =48+24+32 \\\\  & =104.\\end{aligned}\n$$"} :step/id #uuid "43428109-0699-58be-ba28-1e9ad893c94b" :step/next {:db/id #edb/ref 17592186538068}} {:db/id #edb/ref 17592186538068 :step/content {:db/id #edb/ref 17592186537932 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6ff55129-af5c-5c05-ba0c-79d2b64c94e0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186537446} {:answer/id #uuid "7481dcce-5cb6-5d08-aba0-d849dc9f222e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186537459} {:answer/id #uuid "8fcb06a8-449e-5686-9043-282535027104" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8}{5}" :db/id #edb/ref 17592186537502} {:answer/id #uuid "cb00b5e5-8202-5384-a618-4818977df0c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{6}{5}" :db/id #edb/ref 17592186537624} {:answer/id #uuid "eafe1606-b8c9-5c8f-9efb-4dfe5c92c0d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186537709}] :answer-field/correct {:db/id #edb/ref 17592186537709} :answer-field/id #uuid "35592764-2ebe-5eba-8d3a-5fd6d801071b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186537777}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7816847f-8647-5628-af20-0f9b03662f9a" :question/math-academy-id "q-148328" :question/problem "For two random variables $X$ and $Y,$ we have $\\text{Var}[X]=\\frac{1}{5},$ $\\text{Var}[Y]=\\frac{4}{5},$ and $\\text{Cov}[X,Y]=\\frac{3}{5}.$ Find $\\text{Var}[X-2Y].$" :question/worked-solution "Recall that if $X$ and $Y$ are random variables, and $a$ and $b$ are constants, then\n\n$$\n\\text{Var}[aX+bY]={a}^{2}\\text{Var}[X]+{b}^{2}\\text{Var}[Y]+2ab\\,\\text{Cov}[X,Y].\n$$\n\nSubstituting the given data into the formula above, we obtain\n\n$$\n\\begin{aligned}\\text{Var}[X-2Y] & ={1}^{2}\\cdot \\frac{1}{5}+(-2)^{2}\\cdot \\frac{4}{5}+2\\cdot 1\\cdot (-2)\\cdot \\frac{3}{5} \\\\  & =\\frac{1}{5}+\\frac{16}{5}-\\frac{12}{5} \\\\  & =1.\\end{aligned}\n$$"} :step/id #uuid "f2da1517-b73b-5aab-af67-7d5f5240aacd" :step/next {:db/id #edb/ref 17592186538001}}] :activity/title "Variance of Sums of Random Variables" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186537211}]}
