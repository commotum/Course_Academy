#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186503789} :activity/id #uuid "82b7f6d1-56e6-5996-af14-4bffbc2e1830" :activity/scope {:db/id #edb/ref 17592186050004 :topic/id #uuid "25876b80-efb1-53ed-9327-08d34c32cc9a" :topic/math-academy-id 1903} :activity/steps [{:db/id #edb/ref 17592186503787 :step/content {:db/id #edb/ref 17592186413321 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20243682-29c5-5259-864f-3c811fbe7f7d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-\\frac{1}{5}" :db/id #edb/ref 17592186413304} {:answer/id #uuid "4f14c146-ddb9-57bd-ad6f-3930420ac403" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{9}{5}" :db/id #edb/ref 17592186413306} {:answer/id #uuid "95bed720-0647-52ed-9834-06d42bf8de74" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=0" :db/id #edb/ref 17592186413310} {:answer/id #uuid "b4ee551d-2ce2-5847-a076-aa2475baa979" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186413312} {:answer/id #uuid "f405f918-ce19-52f9-9c3d-f68c97ea5cd2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-\\frac{1}{3}" :db/id #edb/ref 17592186413316}] :answer-field/correct {:db/id #edb/ref 17592186413312} :answer-field/id #uuid "e22bffa8-51cb-5c7c-a8dc-24d845160961" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186413319}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "88ec9ee8-0b06-53f7-bc3c-92317b5059e7" :question/math-academy-id "q-101322" :question/problem "Find the horizontal asymptote of $y=f(x)$ where $f(x)=\\frac{9{x}^{3}+{x}^{2}-x}{5{x}^{2}+3}.$" :question/worked-solution "The horizontal asymptote is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is ${x}^{2}.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{9{x}^{3}+{x}^{2}-x}{5{x}^{2}+3} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{9{x}^{3}}{{x}^{2}}+\\frac{{x}^{2}}{{x}^{2}}-\\frac{x}{{x}^{2}})}{(\\frac{5{x}^{2}}{{x}^{2}}+\\frac{3}{{x}^{2}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(9x+1-\\frac{1}{x})}{(5+\\frac{3}{{x}^{2}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(9x+1-0)}{(5+0)} \\\\  & =\\frac{1}{5}{lim}_{x\\to \\infty }(9x+1) \\\\  & =\\infty .\\end{aligned}\n$$\n\n \n\nThe limit does not come out to a finite number. Therefore, there is no horizontal asymptote."} :step/id #uuid "5368d0b9-16cf-515a-9649-1cc3a2d20352" :step/next {:db/id #edb/ref 17592186503808}} {:db/id #edb/ref 17592186503789 :step/content {:db/id #edb/ref 17592186503740 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12c051ac-16d1-53b0-af08-3845e1f80fcd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=0" :db/id #edb/ref 17592186503020} {:answer/id #uuid "716a5576-1477-5d48-9fac-ce2b26ac1535" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=9" :db/id #edb/ref 17592186503210} {:answer/id #uuid "c22ddc25-362a-57ac-b9a3-be8479d6a75e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{3}{2}" :db/id #edb/ref 17592186503371} {:answer/id #uuid "d43bf7b4-779c-5786-81da-db083c00f923" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=1" :db/id #edb/ref 17592186503403} {:answer/id #uuid "fe457f6b-9fd9-5669-9e55-7cc5d248f357" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186503507}] :answer-field/correct {:db/id #edb/ref 17592186503020} :answer-field/id #uuid "8358f70b-40f4-51c5-ad82-e863f6db2422" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186503579}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c664e1c1-92ad-575b-bafc-9b1ddd2a888d" :question/math-academy-id "q-35762" :question/problem "Find the horizontal asymptote of the function $f(x)=\\frac{9}{{x}^{2}-6}.$" :question/worked-solution "The horizontal asymptote is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is ${x}^{2}.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{9}{{x}^{2}-6} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{9}{{x}^{2}})}{(\\frac{{x}^{2}}{{x}^{2}}-\\frac{6}{{x}^{2}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{9}{{x}^{2}})}{(1-\\frac{6}{{x}^{2}})} \\\\  & =\\frac{0}{1-0} \\\\  & =0.\\end{aligned}\n$$\n\n \n\nTherefore, the horizontal asymptote of $f(x)$ is $y=0.$"} :step/id #uuid "59b57cb6-2983-5ca5-88d0-67859be7b64b" :step/next {:db/id #edb/ref 17592186503831}} {:db/id #edb/ref 17592186503808 :step/content {:db/id #edb/ref 17592186503750 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d555f50e-bb12-5374-8350-a9ef5d7a920d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\infty" :db/id #edb/ref 17592186503405}] :answer-field/correct {:db/id #edb/ref 17592186503405} :answer-field/id #uuid "1152ef23-8437-51aa-a9aa-c16e05bf2bcd" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186503522}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e026e16b-5d19-5563-a374-d9f17e04bfda" :question/math-academy-id "q-339604" :question/problem "Evaluate the limit:\n\n${lim}_{x\\to \\infty }\\,\\,\\frac{{x}^{5}+5x+3}{{x}^{4}-2}=$\n\n{{field-1}}" :question/worked-solution "First, we divide both the numerator and the denominator by the highest power of $x$ in the denominator, which is ${x}^{4}.$ Then, by noting that the reciprocals shrink to $0$ in the limit, we can then evaluate the resulting expression.\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\,\\,\\frac{{x}^{5}+5x+3}{{x}^{4}-2} & ={lim}_{x\\to \\infty }\\,\\,\\frac{(\\frac{{x}^{5}}{{x}^{4}}+\\frac{5x}{{x}^{4}}+\\frac{3}{{x}^{4}})}{(\\frac{{x}^{4}}{{x}^{4}}-\\frac{2}{{x}^{4}})} \\\\  & ={lim}_{x\\to \\infty }\\,\\,\\frac{(x+\\frac{5}{{x}^{3}}+\\frac{3}{{x}^{4}})}{(1-\\frac{2}{{x}^{4}})} \\\\  & ={lim}_{x\\to \\infty }\\,\\text{ }\\frac{x+0+0}{1-0} \\\\  & ={lim}_{x\\to \\infty }\\,\\,x \\\\  & =\\infty .\\end{aligned}\n$$"} :step/id #uuid "8ff8a17a-a0a5-5493-8d28-ed7607b31cac" :step/next {:db/id #edb/ref 17592186503821}} {:db/id #edb/ref 17592186503821 :step/content {:db/id #edb/ref 17592186503667 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c937735b-3bc6-54e6-933f-6f49c7d3c312" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186503382}] :answer-field/correct {:db/id #edb/ref 17592186503382} :answer-field/id #uuid "fb3beee4-cb24-5c90-9eb7-a8526064661d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186503642}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "223b3e58-bcca-5fb5-a51e-27d487af6492" :question/math-academy-id "q-339640" :question/problem "The horizontal asymptote of the function $f(x)=\\frac{2{x}^{3}-1}{{x}^{5}-2x}$ is\n\n$y=$\n{{field-1}}." :question/worked-solution "The horizontal asymptote is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is ${x}^{5}.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{2{x}^{3}-1}{{x}^{5}-2x} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{2{x}^{3}}{{x}^{5}}-\\frac{1}{{x}^{5}})}{(\\frac{{x}^{5}}{{x}^{5}}-\\frac{2x}{{x}^{5}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{2}{{x}^{2}}-\\frac{1}{{x}^{5}})}{(1-\\frac{2}{{x}^{4}})} \\\\  & =\\frac{0-0}{1-0} \\\\  & =0.\\end{aligned}\n$$\n\n \n\nTherefore, the horizontal asymptote of $f(x)$ is $y=0.$"} :step/id #uuid "c3e3b25f-2076-5174-b242-050566e2054d"} {:db/id #edb/ref 17592186503831 :step/content {:db/id #edb/ref 17592186124921 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "544fe8c0-00d7-5582-9b43-a7537bdb2cd4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186321810} {:answer/id #uuid "8d44af16-7047-5688-8bee-4018f24233a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-1" :db/id #edb/ref 17592186322274} {:answer/id #uuid "b0f05e28-da65-5e0b-9cd3-41729a024a5d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=1" :db/id #edb/ref 17592186322534} {:answer/id #uuid "b324732c-ba06-52ac-9465-f950f027ee85" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=0" :db/id #edb/ref 17592186322547} {:answer/id #uuid "d8824ca2-db5e-5819-9375-3a960341c205" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-3" :db/id #edb/ref 17592186322841}] :answer-field/correct {:db/id #edb/ref 17592186321810} :answer-field/id #uuid "1017af27-6db1-5bfd-9bf5-b120516afb73" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186323200}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d5a61e3c-7091-5d14-ae25-993daf76ef12" :question/math-academy-id "q-35834" :question/problem "Find the horizontal asymptote of $y=f(x)$ where $f(x)=\\frac{12x-3{x}^{4}}{3{x}^{2}+7}.$" :question/worked-solution "The horizontal asymptote is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is ${x}^{2}.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{12x-3{x}^{4}}{3{x}^{2}+7} \\\\  & {lim}_{x\\to \\infty }\\frac{(\\frac{12x}{{x}^{2}}-\\frac{3{x}^{4}}{{x}^{2}})}{(\\frac{3{x}^{2}}{{x}^{2}}+\\frac{7}{{x}^{2}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{12}{x}-3{x}^{2})}{(3+\\frac{7}{{x}^{2}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{0-3{x}^{2}}{3+0} \\\\  & ={lim}_{x\\to \\infty }(-{x}^{2}) \\\\  & =-\\infty .\\end{aligned}\n$$\n\n \n\nThe limit does not come out to a finite number. Therefore, there is no horizontal asymptote."} :step/id #uuid "e49c9b88-a758-5641-97ee-f59eae216336" :step/next {:db/id #edb/ref 17592186503787}}] :activity/title "Limits at Infinity and Horizontal Asymptotes of Rational Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186502968}]}
