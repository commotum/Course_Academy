#{[{:db/id #edb/ref 17592186413321 :knowledge-point/_questions [{:db/id #edb/ref 17592186124664 :knowledge-point/id #uuid "bde258b7-1654-5e73-8703-0e42371db8f4" :knowledge-point/title "Identifying When a Rational Function has No Horizontal Asymptote"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20243682-29c5-5259-864f-3c811fbe7f7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{1}{5}" :db/id #edb/ref 17592186413304} {:answer/id #uuid "4f14c146-ddb9-57bd-ad6f-3930420ac403" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{9}{5}" :db/id #edb/ref 17592186413306} {:answer/id #uuid "95bed720-0647-52ed-9834-06d42bf8de74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=0" :db/id #edb/ref 17592186413310} {:answer/id #uuid "b4ee551d-2ce2-5847-a076-aa2475baa979" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186413312} {:answer/id #uuid "f405f918-ce19-52f9-9c3d-f68c97ea5cd2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{1}{3}" :db/id #edb/ref 17592186413316}] :answer-field/correct {:answer/id #uuid "b4ee551d-2ce2-5847-a076-aa2475baa979" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186413312} :answer-field/id #uuid "e22bffa8-51cb-5c7c-a8dc-24d845160961" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186413319}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "88ec9ee8-0b06-53f7-bc3c-92317b5059e7" :question/math-academy-id "q-101322" :question/problem "Find the horizontal asymptote of $y=f(x)$ where $f(x)=\\frac{9{x}^{3}+{x}^{2}-x}{5{x}^{2}+3}.$" :question/worked-solution "The horizontal asymptote is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is ${x}^{2}.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{9{x}^{3}+{x}^{2}-x}{5{x}^{2}+3} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{9{x}^{3}}{{x}^{2}}+\\frac{{x}^{2}}{{x}^{2}}-\\frac{x}{{x}^{2}})}{(\\frac{5{x}^{2}}{{x}^{2}}+\\frac{3}{{x}^{2}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(9x+1-\\frac{1}{x})}{(5+\\frac{3}{{x}^{2}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(9x+1-0)}{(5+0)} \\\\  & =\\frac{1}{5}{lim}_{x\\to \\infty }(9x+1) \\\\  & =\\infty .\\end{aligned}\n$$\n\n \n\nThe limit does not come out to a finite number. Therefore, there is no horizontal asymptote."}] [{:db/id #edb/ref 17592186124921 :knowledge-point/_questions [{:db/id #edb/ref 17592186124664 :knowledge-point/id #uuid "bde258b7-1654-5e73-8703-0e42371db8f4" :knowledge-point/title "Identifying When a Rational Function has No Horizontal Asymptote"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "544fe8c0-00d7-5582-9b43-a7537bdb2cd4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186321810} {:answer/id #uuid "8d44af16-7047-5688-8bee-4018f24233a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-1" :db/id #edb/ref 17592186322274} {:answer/id #uuid "b0f05e28-da65-5e0b-9cd3-41729a024a5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=1" :db/id #edb/ref 17592186322534} {:answer/id #uuid "b324732c-ba06-52ac-9465-f950f027ee85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=0" :db/id #edb/ref 17592186322547} {:answer/id #uuid "d8824ca2-db5e-5819-9375-3a960341c205" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-3" :db/id #edb/ref 17592186322841}] :answer-field/correct {:answer/id #uuid "544fe8c0-00d7-5582-9b43-a7537bdb2cd4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186321810} :answer-field/id #uuid "1017af27-6db1-5bfd-9bf5-b120516afb73" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323200}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d5a61e3c-7091-5d14-ae25-993daf76ef12" :question/math-academy-id "q-35834" :question/problem "Find the horizontal asymptote of $y=f(x)$ where $f(x)=\\frac{12x-3{x}^{4}}{3{x}^{2}+7}.$" :question/worked-solution "The horizontal asymptote is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is ${x}^{2}.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{12x-3{x}^{4}}{3{x}^{2}+7} \\\\  & {lim}_{x\\to \\infty }\\frac{(\\frac{12x}{{x}^{2}}-\\frac{3{x}^{4}}{{x}^{2}})}{(\\frac{3{x}^{2}}{{x}^{2}}+\\frac{7}{{x}^{2}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{12}{x}-3{x}^{2})}{(3+\\frac{7}{{x}^{2}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{0-3{x}^{2}}{3+0} \\\\  & ={lim}_{x\\to \\infty }(-{x}^{2}) \\\\  & =-\\infty .\\end{aligned}\n$$\n\n \n\nThe limit does not come out to a finite number. Therefore, there is no horizontal asymptote."}]}
