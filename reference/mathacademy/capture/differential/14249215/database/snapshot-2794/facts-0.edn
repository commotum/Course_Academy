417] [17592186278094 #edb/ref 1075 #edb/ref 17592186276941 #edb/ref 17592186045417] [17592186278094 #edb/ref 1075 #edb/ref 17592186277415 #edb/ref 17592186045417] [17592186278094 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186278094 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186278094 #edb/ref 1078 #edb/ref 17592186276941 #edb/ref 17592186045417] [17592186278094 #edb/ref 1079 #uuid "d372165d-773c-522b-a6ae-4635a798bcf6" #edb/ref 17592186045417] [17592186278150 #edb/ref 1075 #edb/ref 17592186275864 #edb/ref 17592186045417] [17592186278150 #edb/ref 1075 #edb/ref 17592186276300 #edb/ref 17592186045417] [17592186278150 #edb/ref 1075 #edb/ref 17592186276429 #edb/ref 17592186045417] [17592186278150 #edb/ref 1075 #edb/ref 17592186276746 #edb/ref 17592186045417] [17592186278150 #edb/ref 1075 #edb/ref 17592186276884 #edb/ref 17592186045417] [17592186278150 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186278150 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186278150 #edb/ref 1078 #edb/ref 17592186275864 #edb/ref 17592186045417] [17592186278150 #edb/ref 1079 #uuid "f21cf5ea-df9a-5241-8868-5373b87209ec" #edb/ref 17592186045417] [17592186278244 #edb/ref 1068 #edb/ref 17592186277737 #edb/ref 17592186045417] [17592186278244 #edb/ref 1069 "q-159658" #edb/ref 17592186045417] [17592186278244 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186278244 #edb/ref 1071 "Find ${f}_{y}(x,y)$ for $f(x,y)=\\operatorname{cos}⁡(\\sqrt{2xy-1}).$" #edb/ref 17592186045417] [17592186278244 #edb/ref 1072 #uuid "0833bc78-75ed-516b-b7f3-7df11e162117" #edb/ref 17592186045417] [17592186278244 #edb/ref 1074 "We differentiate the given function with respect to $y,$ treating all other variables as constants. \n\nFirst, we use the chain rule: \n\n$$\n\\begin{aligned}{f}_{y}(x,y) & =\\frac{∂}{∂y}(\\operatorname{cos}⁡(\\sqrt{2xy-1})) \\\\  & =-\\operatorname{sin}⁡(\\sqrt{2xy-1})\\cdot \\frac{∂}{∂y}(\\sqrt{2xy-1}) \\\\  & =-\\operatorname{sin}⁡(\\sqrt{2xy-1})\\cdot \\frac{1}{2\\sqrt{2xy-1}}\\cdot \\frac{∂}{∂y}(2xy-1)\\end{aligned}\n$$\n\nNow, we use the sum and the constant multiple rules for differentiation:\n\n$$\n\\begin{aligned}-\\operatorname{sin}⁡(\\sqrt{2xy-1})\\cdot \\frac{1}{2\\sqrt{2xy-1}}\\cdot \\frac{∂}{∂y}(2xy-1) & =-\\frac{\\operatorname{sin}⁡(\\sqrt{2xy-1})}{2\\sqrt{2xy-1}}(2x\\cdot \\frac{∂}{∂y}(y)-\\frac{∂}{∂y}(1)) \\\\  & =-\\frac{\\operatorname{sin}⁡(\\sqrt{2xy-1})}{2\\sqrt{2xy-1}}\\cdot (2x\\cdot 1-0) \\\\  & =-\\frac{x\\operatorname{sin}⁡(\\sqrt{2xy-1})}{\\sqrt{2xy-1}}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186278246 #edb/ref 1068 #edb/ref 17592186278004 #edb/ref 17592186045417] [17592186278246 #edb/ref 1069 "q-159700" #edb/ref 17592186045417] [17592186278246 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186278246 #edb/ref 1071 "For the function $f(x,y)=\\frac{x+y}{\\operatorname{sin}⁡y},$ evaluate $\\frac{∂f}{∂y}$ at the point $(\\pi ,\\frac{\\pi }{2}).$" #edb/ref 17592186045417] [17592186278246 #edb/ref 1072 #uuid "95a36042-f58f-5fde-b6a7-7ca45f1d6809" #edb/ref 17592186045417] [17592186278246 #edb/ref 1074 "We differentiate the given function with respect to $y,$ treating all other variables as constants. \n\nFirst, we use the quotient rule:\n\n$$\n\\begin{aligned}\\frac{∂}{∂y}(\\frac{x+y}{\\operatorname{sin}⁡y}) & =\\frac{\\frac{∂}{∂y}(x+y)\\cdot \\operatorname{sin}⁡y-(x+y)\\cdot \\frac{∂}{∂y}(\\operatorname{sin}⁡y)}{{sin}^{2}⁡y} \\\\  & =\\frac{1\\cdot \\operatorname{sin}⁡y-(x+y)\\cdot \\operatorname{cos}⁡y}{{sin}^{2}⁡y} \\\\  & =\\frac{\\operatorname{sin}⁡y-(x+y)\\operatorname{cos}⁡y}{{sin}^{2}⁡y}\\end{aligned}\n$$\n\n \n\nFinally, we evaluate the partial derivative at the point $(\\pi ,\\frac{\\pi }{2}):$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}{|}_{(\\pi ,\\pi /2)} & =\\frac{\\operatorname{sin}⁡(\\frac{\\pi }{2})-(\\pi +\\frac{\\pi }{2})\\operatorname{cos}⁡(\\frac{\\pi }{2})}{{sin}^{2}⁡(\\frac{\\pi }{2})} \\\\  & =\\frac{1-0}{{1}^{2}} \\\\  & =1\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186278250 #edb/ref 1068 #edb/ref 17592186278094 #edb/ref 17592186045417] [17592186278250 #edb/ref 1069 "q-159716" #edb/ref 17592186045417] [17592186278250 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186278250 #edb/ref 1071 "Find $\\frac{∂f}{∂x}$ for $f(x,y)={x}^{4}\\operatorname{cos}⁡x-x{y}^{3}.$" #edb/ref 17592186045417] [17592186278250 #edb/ref 1072 #uuid "7c4ebeea-f58f-5eb8-93aa-37b6d0eeb259" #edb/ref 17592186045417] [17592186278250 #edb/ref 1074 "We differentiate the given function with respect to $x,$ treating all other variables as constants. \n\nFirst, we use the sum and constant multiple rules:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}({x}^{4}\\operatorname{cos}⁡x-x{y}^{3}) \\\\  & =\\frac{∂}{∂x}({x}^{4}\\operatorname{cos}⁡x)-\\frac{∂}{∂y}(x{y}^{3}) \\\\  & =\\frac{∂}{∂x}({x}^{4}\\operatorname{cos}⁡x)-{y}^{3}\\cdot \\frac{∂}{∂x}(x)\\end{aligned}\n$$\n\nThen, we use the product rule:\n\n$$\n\\begin{aligned}\\frac{∂}{∂x}({x}^{4}\\operatorname{cos}⁡x)-{y}^{3}\\cdot \\frac{∂}{∂x}(x) & =(\\frac{∂}{∂x}({x}^{4})\\cdot \\operatorname{cos}⁡x+{x}^{4}\\cdot \\frac{∂}{∂x}(\\operatorname{cos}⁡x))-{y}^{3}\\cdot (1) \\\\  & =((4{x}^{3})\\cdot \\operatorname{cos}⁡x+{x}^{4}\\cdot (-\\operatorname{sin}⁡x))-{y}^{3} \\\\  & =4{x}^{3}\\operatorname{cos}⁡x-{x}^{4}\\operatorname{sin}⁡x-{y}^{3}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186278260 #edb/ref 1068 #edb/ref 17592186278150 #edb/ref 17592186045417] [17592186278260 #edb/ref 1069 "q-159768" #edb/ref 17592186045417] [17592186278260 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186278260 #edb/ref 1071 "For the function $f(x,y)=xy\\operatorname{cos}⁡y+\\operatorname{sin}⁡y,$ evaluate $\\frac{∂f}{∂y}$ at the point $(2,\\pi ).$" #edb/ref 17592186045417] [17592186278260 #edb/ref 1072 #uuid "e7a86e6a-207f-552d-b9da-b1e5c673da4e" #edb/ref 17592186045417] [17592186278260 #edb/ref 1074 "We differentiate the given function with respect to $y,$ treating all other variables as constants. \n\nFirst, we use the sum and constant multiple rules:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}(xy\\operatorname{cos}⁡y+\\operatorname{sin}⁡y) \\\\  & =\\frac{∂}{∂y}(xy\\operatorname{cos}⁡y)-\\frac{∂}{∂y}(\\operatorname{sin}⁡y) \\\\  & =x\\cdot \\frac{∂}{∂y}(y\\operatorname{cos}⁡y)+\\frac{∂}{∂y}(\\operatorname{sin}⁡y)\\end{aligned}\n$$\n\nThen, we use the product rule:\n\n$$\n\\begin{aligned}x\\cdot \\frac{∂}{∂y}(y\\operatorname{cos}⁡y)+\\frac{∂}{∂y}(\\operatorname{sin}⁡y) & =x(\\frac{∂}{∂y}(y)\\cdot \\operatorname{cos}⁡y+y\\cdot \\frac{∂}{∂y}(\\operatorname{cos}⁡y))+\\operatorname{cos}⁡y \\\\  & =x(1\\cdot \\operatorname{cos}⁡y+y\\cdot (-\\operatorname{sin}⁡y))+\\operatorname{cos}⁡y \\\\  & =x(\\operatorname{cos}⁡y-y\\operatorname{sin}⁡y)+\\operatorname{cos}⁡y\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(2,\\pi ):$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂y}{|}_{(2,\\pi )} & =2\\cdot (\\operatorname{cos}⁡\\pi -\\pi \\cdot \\operatorname{sin}⁡\\pi )+\\operatorname{cos}⁡\\pi  \\\\  & =2(-1-\\pi \\cdot 0)+(-1) \\\\  & =-3\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186321557 #edb/ref 1080 "2(x+1)^{{y}^{2}}\\operatorname{ln}⁡(x+1)" #edb/ref 17592186045417] [17592186321557 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186321557 #edb/ref 1083 #uuid "359742a6-8a0e-5705-b305-bdbfab09ad97" #edb/ref 17592186045417] [17592186321932 #edb/ref 1080 "-2" #edb/ref 17592186045417] [17592186321932 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186321932 #edb/ref 1083 #uuid "6537a211-988c-5668-b744-a7a835445a10" #edb/ref 17592186045417] [17592186322044 #edb/ref 1080 "1" #edb/ref 17592186045417] [17592186322044 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186322044 #edb/ref 1083 #uuid "71e4806a-8e4b-520c-928b-81dbadc1fe14" #edb/ref 17592186045417] [17592186322339 #edb/ref 10