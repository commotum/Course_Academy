) \\\\  & =2(x+1){e}^{z}+y\\end{aligned}\n$$\n\n \n\nFinally, we evaluate the partial derivative at the point $(1,1,1)\\mathbin{:}$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂z}{|}_{(1,1,1)} & =2(1+1){e}^{1}+1 \\\\  & =4e+1\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186192509 #edb/ref 1069 "e-11028" #edb/ref 17592186045417] [17592186192509 #edb/ref 1071 "Find $\\dfrac{\\partial f}{\\partial x}$ for $f(x,y) =x^2y\\ln{x}.$" #edb/ref 17592186045417] [17592186192509 #edb/ref 1072 #uuid "0fd784a0-5146-5f7b-9936-8d3bc43d7062" #edb/ref 17592186045417] [17592186192509 #edb/ref 1074 "We differentiate the given function with respect to $x,$ treating all other variables as constants. \n\nFirst, we use the constant multiple rule:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}({x}^{2}y\\operatorname{ln}⁡x) \\\\  & =y\\cdot \\frac{∂}{∂x}({x}^{2}\\operatorname{ln}⁡x)\\end{aligned}\n$$\n\nThen, we use the product rule:\n\n$$\n\\begin{aligned}y\\cdot \\frac{∂}{∂x}({x}^{2}\\operatorname{ln}⁡x) & =y\\cdot (\\frac{∂}{∂x}({x}^{2})\\cdot \\operatorname{ln}⁡x+{x}^{2}\\cdot \\frac{∂}{∂x}(\\operatorname{ln}⁡x)) \\\\  & =y\\cdot ((2x)\\cdot \\operatorname{ln}⁡x+{x}^{2}\\cdot (\\frac{1}{x})) \\\\  & =y(2x\\operatorname{ln}⁡x+x) \\\\  & =xy(2\\operatorname{ln}⁡x+1)\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186192514 #edb/ref 1069 "e-11048" #edb/ref 17592186045417] [17592186192514 #edb/ref 1071 "For the function $f(x,y) =\\ln(y-x^2),$ evaluate $f_x(1,9).$" #edb/ref 17592186045417] [17592186192514 #edb/ref 1072 #uuid "fc8ba431-5a97-5f57-9a83-fdcf4ac98d39" #edb/ref 17592186045417] [17592186192514 #edb/ref 1074 "We differentiate the given function with respect to $x,$ treating all other variables as constants. \n\nFirst, we use the chain rule:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}(\\operatorname{ln}⁡(y-{x}^{2})) \\\\  & =\\frac{1}{y-{x}^{2}}\\cdot \\frac{∂}{∂x}(y-{x}^{2})\\end{aligned}\n$$\n\n \n\nNow, we use the sum and constant multiple rules:\n\n$$\n\\begin{aligned}\\frac{1}{y-{x}^{2}}\\cdot \\frac{∂}{∂x}(y-{x}^{2}) & =\\frac{1}{y-{x}^{2}}\\cdot (y\\cdot \\frac{∂}{∂x}(1)-\\frac{∂}{∂x}({x}^{2})) \\\\  & =\\frac{1}{y-{x}^{2}}\\cdot (y\\cdot 0-2x) \\\\  & =-\\frac{2x}{y-{x}^{2}}\\end{aligned}\n$$\n\n \n\nFinally, we evaluate the partial derivative at the point $(1,9)\\mathbin{:}$ \n\n$$\n\\begin{aligned}{f}_{x}(1,9) & =-\\frac{2\\cdot 1}{9-{1}^{2}} \\\\  & =-\\frac{2}{8} \\\\  & =-\\frac{1}{4}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186192518 #edb/ref 1069 "e-11112" #edb/ref 17592186045417] [17592186192518 #edb/ref 1071 "For the function $f(x,y) = \\dfrac{4x-y}{x+y^2},$ evaluate $\\dfrac{\\partial f}{\\partial x}$ at the point $(2,-1).$" #edb/ref 17592186045417] [17592186192518 #edb/ref 1072 #uuid "6f7bdbcf-fb8e-5c70-b368-4e73cc94bdb2" #edb/ref 17592186045417] [17592186192518 #edb/ref 1074 "We differentiate the given function with respect to $x,$ treating all other variables as constants. \n\nFirst, we use the quotient rule:\n\n$$\n\\begin{aligned}\\frac{∂}{∂x}(\\frac{4x-y}{x+{y}^{2}}) & =\\frac{\\frac{∂}{∂x}(4x-y)\\cdot (x+{y}^{2})-(4x-y)\\cdot \\frac{∂}{∂x}(x+{y}^{2})}{{(x+{y}^{2})}^{2}} \\\\  & =\\frac{4\\cdot (x+{y}^{2})-(4x-y)\\cdot 1}{{(x+{y}^{2})}^{2}} \\\\  & =\\frac{4x+4{y}^{2}-4x+y}{{(x+{y}^{2})}^{2}} \\\\  & =\\frac{4{y}^{2}+y}{{(x+{y}^{2})}^{2}}\\end{aligned}\n$$\n\n \n\nThen, we evaluate the partial derivative at the point $(2,-1)\\mathbin{:}$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}{|}_{(2,-1)} & =\\frac{4(-1)^{2}+(-1)}{{(2+{(-1)}^{2})}^{2}} \\\\  & =\\frac{4-1}{{3}^{2}} \\\\  & =\\frac{1}{3}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186192784 #edb/ref 1038 #edb/ref 17592186192958 #edb/ref 17592186045417] [17592186192784 #edb/ref 1038 #edb/ref 17592186193320 #edb/ref 17592186045417] [17592186192784 #edb/ref 1038 #edb/ref 17592186268852 #edb/ref 17592186045417] [17592186192784 #edb/ref 1038 #edb/ref 17592186323712 #edb/ref 17592186045417] [17592186192784 #edb/ref 1038 #edb/ref 17592186335761 #edb/ref