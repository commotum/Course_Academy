[[:db/retract 17592186299874 :question/answer-fields 17592186299088] {:db/id 17592186087723 :knowledge-point/questions ["question-a21adcc1-3b87-5d19-b775-6ef90961f595"] :db/ensure [:knowledge-point/validate]} {:db/id "question-a21adcc1-3b87-5d19-b775-6ef90961f595" :question/id #uuid "a21adcc1-3b87-5d19-b775-6ef90961f595" :question/math-academy-id "q-78237" :question/problem "Write the equation of the hyperbola $7{x}^{2}-4{y}^{2}=56$ in standard form." :question/worked-solution "The Cartesian equation of a horizontal hyperbola centered at the origin is\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\nTherefore, to write the equation of the hyperbola in standard form, we need to divide both sides of the equation by $56$ and then simplify, as follows:\n\n$$\n\\begin{aligned}7{x}^{2}-4{y}^{2} & =56 \\\\ \\frac{7{x}^{2}}{56}-\\frac{4{y}^{2}}{56} & =\\frac{56}{56} \\\\ \\frac{{x}^{2}}{8}-\\frac{{y}^{2}}{14} & =1\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f9046c0d-0a54-52ac-b868-b1d27ab779f6"] :db/ensure [:question/validate]} {:db/id "answer-field-f9046c0d-0a54-52ac-b868-b1d27ab779f6" :answer-field/id #uuid "f9046c0d-0a54-52ac-b868-b1d27ab779f6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d68753b7-939a-51f9-9fca-e1b421a34631" :answer-field/choices ["answer-fcb99119-38c1-5f03-ae02-e62241b13cee" "answer-6071669b-962e-55d2-b933-dee14356467b" "answer-e7619fad-a6de-5649-8a2d-66fa1723aaae" "answer-e6c079e2-cc78-55cd-beda-fc0eb7d4d902" "answer-d68753b7-939a-51f9-9fca-e1b421a34631"] :db/ensure [:answer-field/validate]} {:db/id "answer-fcb99119-38c1-5f03-ae02-e62241b13cee" :answer/id #uuid "fcb99119-38c1-5f03-ae02-e62241b13cee" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{16}-\\frac{{y}^{2}}{12}=1" :db/ensure [:answer/validate]} {:db/id "answer-6071669b-962e-55d2-b933-dee14356467b" :answer/id #uuid "6071669b-962e-55d2-b933-dee1