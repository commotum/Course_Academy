#{[{:db/id #edb/ref 17592186299874 :knowledge-point/_questions [{:db/id #edb/ref 17592186087723 :knowledge-point/id #uuid "dfbe689c-ae04-5405-9a38-d80f10662a0b" :knowledge-point/title "Writing the Equation of a Horizontal Hyperbola in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58e67c93-1125-58c7-8306-ab452c9f35ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{9}-\\frac{{y}^{2}}{6}" :db/id #edb/ref 17592186297923}] :answer-field/correct {:answer/id #uuid "58e67c93-1125-58c7-8306-ab452c9f35ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{9}-\\frac{{y}^{2}}{6}" :db/id #edb/ref 17592186297923} :answer-field/id #uuid "8694e666-1b2c-5967-8670-f56229f00bc8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299088}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f2deaa7c-e065-523b-b096-d4b288306c46" :question/math-academy-id "q-320673" :question/problem "The equation of the hyperbola $14{x}^{2}-21{y}^{2}=126$ in standard form is{{field-1}}\n$=1.$" :question/worked-solution "The Cartesian equation of a horizontal hyperbola centered at the origin is\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\nTherefore, to write the equation of the hyperbola in standard form, we need to divide both sides of the equation by $126$ and then simplify, as follows:\n\n$$\n\\begin{aligned}14{x}^{2}-21{y}^{2} & =126 \\\\ \\frac{14{x}^{2}}{126}-\\frac{21{y}^{2}}{126} & =\\frac{126}{126} \\\\ \\frac{{x}^{2}}{9}-\\frac{{y}^{2}}{6} & =1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299875 :knowledge-point/_questions [{:db/id #edb/ref 17592186087723 :knowledge-point/id #uuid "dfbe689c-ae04-5405-9a38-d80f10662a0b" :knowledge-point/title "Writing the Equation of a Horizontal Hyperbola in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f0cc90b-e38c-506a-8a4c-6a2e8028c58f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{3}-\\frac{{y}^{2}}{27}" :db/id #edb/ref 17592186297751}] :answer-field/correct {:answer/id #uuid "2f0cc90b-e38c-506a-8a4c-6a2e8028c58f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{3}-\\frac{{y}^{2}}{27}" :db/id #edb/ref 17592186297751} :answer-field/id #uuid "01a3424d-fe0a-549a-8dea-0f4f6a36be2c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298650}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "54b5fd86-3d2b-5b48-84c2-d1b54392706a" :question/math-academy-id "q-320675" :question/problem "The equation of the hyperbola $45{x}^{2}-5{y}^{2}=135$ in standard form is{{field-1}}\n$=1.$" :question/worked-solution "The Cartesian equation of a horizontal hyperbola centered at the origin is\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\nTherefore, to write the equation of the hyperbola in standard form, we need to divide both sides of the equation by $135$ and then simplify, as follows:\n\n$$\n\\begin{aligned}45{x}^{2}-5{y}^{2} & =135 \\\\ \\frac{45{x}^{2}}{135}-\\frac{5{y}^{2}}{135} & =\\frac{135}{135} \\\\ \\frac{{x}^{2}}{3}-\\frac{{y}^{2}}{27} & =1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186348072 :knowledge-point/_questions [{:db/id #edb/ref 17592186087783 :knowledge-point/id #uuid "9f783fe8-8f52-5f93-adef-bf4bd030fea0" :knowledge-point/title "Writing the Equation of a Vertical Hyperbola in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "138835ba-000f-506a-a9cc-97976bfe5ff1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{y}^{2}}{12}-\\frac{{x}^{2}}{5}=1" :db/id #edb/ref 17592186345520} {:answer/id #uuid "15999da0-4baa-5506-a796-d3a1c0f347fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{y}^{2}}{5}-\\frac{{x}^{2}}{12}=1" :db/id #edb/ref 17592186345537} {:answer/id #uuid "2a4ec880-eb0e-56cc-b436-c2286be34657" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{10}-\\frac{{y}^{2}}{8}=1" :db/id #edb/ref 17592186345729} {:answer/id #uuid "b10aab39-ef1d-5676-b82e-37dadbe7ff87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{12}-\\frac{{y}^{2}}{15}=1" :db/id #edb/ref 17592186346897} {:answer/id #uuid "bc1c22db-612e-53ae-b7e6-27b48be2a434" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{y}^{2}}{8}-\\frac{{x}^{2}}{15}=1" :db/id #edb/ref 17592186346986}] :answer-field/correct {:answer/id #uuid "138835ba-000f-506a-a9cc-97976bfe5ff1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{y}^{2}}{12}-\\frac{{x}^{2}}{5}=1" :db/id #edb/ref 17592186345520} :answer-field/id #uuid "63fb1228-eac7-5ca7-be69-dc035c2828d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347780}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d117a87d-a783-56b4-8b1c-6fa54b549e3b" :question/math-academy-id "q-78259" :question/problem "Write the equation of the hyperbola $5{y}^{2}-12{x}^{2}=60$ in standard form." :question/worked-solution "The Cartesian equation of a vertical hyperbola centered at the origin is\n\n$$\n\\frac{{y}^{2}}{{a}^{2}}-\\frac{{x}^{2}}{{b}^{2}}=1.\n$$\n\nTherefore, to write the equation of the hyperbola in standard form, we need to divide both sides of the equation by $60$ and then simplify, as follows:\n\n$$\n\\begin{aligned}5{y}^{2}-12{x}^{2} & =60 \\\\ \\frac{5{y}^{2}}{60}-\\frac{12{x}^{2}}{60} & =\\frac{60}{60} \\\\ \\frac{{y}^{2}}{12}-\\frac{{x}^{2}}{5} & =1\\end{aligned}\n$$"}]}
