#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186414103} :activity/id #uuid "baf78baa-496d-5dd9-b863-2a6a8261b98f" :activity/scope {:db/id #edb/ref 17592186049233 :topic/id #uuid "e572abc9-c83b-5936-8447-f37bda127dca" :topic/math-academy-id 871} :activity/steps [{:db/id #edb/ref 17592186414100 :step/content {:db/id #edb/ref 17592186299874 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7794b5ee-a714-596a-b4c9-b69f4dbf630e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x^{2}}{9}-\\frac{y^{2}}{6}" :db/id #edb/ref 17592186414089}] :answer-field/correct {:db/id #edb/ref 17592186414089} :answer-field/id #uuid "cee10fc6-62f7-5b6a-92b5-9e24471d933e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186414096}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f2deaa7c-e065-523b-b096-d4b288306c46" :question/math-academy-id "q-320673" :question/problem "The equation of the hyperbola $14{x}^{2}-21{y}^{2}=126$ in standard form is{{field-1}}\n$=1.$" :question/worked-solution "The Cartesian equation of a horizontal hyperbola centered at the origin is\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\nTherefore, to write the equation of the hyperbola in standard form, we need to divide both sides of the equation by $126$ and then simplify, as follows:\n\n$$\n\\begin{aligned}14{x}^{2}-21{y}^{2} & =126 \\\\ \\frac{14{x}^{2}}{126}-\\frac{21{y}^{2}}{126} & =\\frac{126}{126} \\\\ \\frac{{x}^{2}}{9}-\\frac{{y}^{2}}{6} & =1\\end{aligned}\n$$"} :step/id #uuid "b2519ce3-45c8-5f31-b559-0f092eaad457" :step/next {:db/id #edb/ref 17592186414101}} {:db/id #edb/ref 17592186414101 :step/content {:db/id #edb/ref 17592186299875 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f0cc90b-e38c-506a-8a4c-6a2e8028c58f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{3}-\\frac