      "assets": [],
      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14273134/observations/step-q124143-c86398f79e084420d1db.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14273134/observations/step-q124143-c86398f79e084420d1db.png",
      "source_url": "https://mathacademy.com/tasks/14273134/topics/3706/lesson",
      "captured_at": 1792207653.923583,
      "math_academy_id": "q-124143",
      "topic_id": "3706",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q124143",
        "placement_id": null,
        "content_id": null,
        "type": null
      },
      "source_example_id": "e-12425",
      "knowledge_point": "Finding the Image of a Point or Segment",
