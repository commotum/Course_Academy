      "assets": [],
      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14273134/observations/step-q124156-fb8ea9518063eac0fc30.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14273134/observations/step-q124156-fb8ea9518063eac0fc30.png",
      "source_url": "https://mathacademy.com/tasks/14273134/topics/3706/lesson",
      "captured_at": 1792207610.211834,
      "math_academy_id": "q-124156",
      "topic_id": "3706",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q124156",
        "placement_id": null,
