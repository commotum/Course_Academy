      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14273134/observations/step-q124168-a1fd9b09e280f94bd86c.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14273134/observations/step-q124168-a1fd9b09e280f94bd86c.png",
      "source_url": "https://mathacademy.com/tasks/14273134/topics/3706/lesson",
      "captured_at": 1792207569.1461473,
      "math_academy_id": "q-124168",
      "topic_id": "3706",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q124168",
        "placement_id": null,
