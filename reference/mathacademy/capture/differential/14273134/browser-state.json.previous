hy=\"false\">|</mo></mrow><mo>=</mo><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">|</mo></mrow><mn>3</mn><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">|</mo></mrow><mo>=</mo><mn>3.</mn></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
