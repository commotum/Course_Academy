      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14273134/observations/step-q124103-7c5112279602476dc391.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14273134/observations/step-q124103-7c5112279602476dc391.png",
      "source_url": "https://mathacademy.com/tasks/14273134/topics/3706/lesson",
      "captured_at": 1792207694.9230213,
      "math_academy_id": "q-124103",
      "topic_id": "3706",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q124103",
        "placement_id": null,
        "content_id": null,
        "type": null
