      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14273134/observations/step-q124641-b147a0175b3e6dd87d31.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14273134/observations/step-q124641-b147a0175b3e6dd87d31.png",
      "source_url": "https://mathacademy.com/tasks/14273134/topics/3706/lesson",
      "captured_at": 1792207779.092799,
      "math_academy_id": "q-124641",
      "topic_id": "3706",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q124641",
        "placement_id": null,
