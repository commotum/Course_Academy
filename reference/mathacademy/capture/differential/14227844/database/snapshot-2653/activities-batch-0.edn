#{[{:activity/expected-seconds 480.0 :activity/first-step {:db/id #edb/ref 17592186231875} :activity/id #uuid "520e24e9-af46-59df-9011-5a62dd8528f2" :activity/scope {:db/id #edb/ref 17592186051002 :topic/id #uuid "789cd5aa-fe97-5a6b-aacd-a7149169a85c" :topic/math-academy-id 6824} :activity/steps [{:db/id #edb/ref 17592186231875 :step/content {:db/id #edb/ref 17592186232043 :tutorial/content "In a previous lesson, we learned that $\\max$ and $\\min$ return the largest and smallest *function values,* while $\\arg\\max$ and $\\arg\\min$ return the corresponding *input values.*\n\nIn this lesson, we practice finding $\\max,$ $\\arg\\max,$ $\\min,$ and $\\arg\\min$ from common representations of a function:\n\n- Tables of values\n\n- Graphs" :tutorial/id #uuid "a3e684e6-ccf3-5429-8f42-d25353c5ef2d" :tutorial/math-academy-id 15116 :tutorial/title "Introduction"} :step/id #uuid "7c44b59a-530c-591b-acfc-f83ae3473f80" :step/math-academy-id 629571 :step/next {:db/id #edb/ref 17592186231876}} {:db/id #edb/ref 17592186231876 :step/content {:db/id #edb/ref 17592186232044 :tutorial/content "When a table lists input-output pairs $(x,f(x))$ for $x$ in some set $S,$ we can read:\n\n- $\\max_{x \\in S} f(x)$ by finding the largest output value in the table.\n\n- $\\arg\\max_{x \\in S} f(x)$ by taking the input value where that largest output occurs.\n\nThe same idea applies to $\\min$ and $\\arg\\min,$ except we look for the smallest output value." :tutorial/id #uuid "9668d165-c819-5345-ae0d-924ef3496969" :tutorial/math-academy-id 15117 :tutorial/title "Finding Argmax and Argmin From a Table"} :step/id #uuid "051a2cbc-002e-5666-b743-e373c251d8fd" :step/math-academy-id 629572 :step/next {:db/id #edb/ref 17592186231877}} {:db/id #edb/ref 17592186231877 :step/content {:db/id #edb/ref 17592186231453 :knowledge-point/canonical-example {:db/id #edb/ref 17592186231379 :question/id #uuid "de77d46f-0d04-510d-951e-650c9ae456fa" :question/math-academy-id "e-22129"} :knowledge-point/id #uuid "c20e9719-4699-5c80-92a1-714717021bb1" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049818}] :knowledge-point/questions [{:db/id #edb/ref 17592186231738} {:db/id #edb/ref 17592186231740} {:db/id #edb/ref 17592186533996} {:db/id #edb/ref 17592186534010} {:db/id #edb/ref 17592186534032} {:db/id #edb/ref 17592186534041}] :knowledge-point/title "Reading Argmax and Argmin From a Table"} :step/id #uuid "241e6b5c-c0f1-5f23-a1c7-c370cd5c8fa2" :step/math-academy-id 629573 :step/next {:db/id #edb/ref 17592186231878}} {:db/id #edb/ref 17592186231878 :step/content {:db/id #edb/ref 17592186232045 :tutorial/content "When a graph shows the points $(x,f(x))$ for $x$ in a set $S,$ we can find:\n\n- $\\max_{x \\in S} f(x)$ by locating the highest point on the graph and reading its $y$-coordinate.\n\n- $\\arg\\max_{x \\in S} f(x)$ by taking the corresponding $x$-coordinate.\n\nThe same idea applies to $\\min$ and $\\arg\\min,$ except we look for the lowest point." :tutorial/id #uuid "874a2ec9-3803-59fe-9157-7b451a113671" :tutorial/math-academy-id 15118 :tutorial/title "Finding Argmax and Argmin From a Graph"} :step/id #uuid "a192e4a9-8faa-5a1b-93df-775720b2cded" :step/math-academy-id 629576 :step/next {:db/id #edb/ref 17592186231879}} {:db/id #edb/ref 17592186231879 :step/content {:db/id #edb/ref 17592186231454 :knowledge-point/canonical-example {:db/id #edb/ref 17592186231380 :question/id #uuid "5fe9ded3-34fb-5bf2-a2f4-9598e6cf2d57" :question/math-academy-id "e-22130"} :knowledge-point/id #uuid "23320907-6b2d-5956-82ab-fdd5c5014613" :knowledge-point/questions [{:db/id #edb/ref 17592186231739} {:db/id #edb/ref 17592186231741} {:db/id #edb/ref 17592186534023} {:db/id #edb/ref 17592186534072} {:db/id #edb/ref 17592186534077}] :knowledge-point/title "Reading Argmax and Argmin From a Graph"} :step/id #uuid "71ad2797-2e06-5afb-b5a7-eec5050eac95" :step/math-academy-id 629577}] :activity/title "Finding Argmax and Argmin From Tables and Graphs" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186231552}]}
