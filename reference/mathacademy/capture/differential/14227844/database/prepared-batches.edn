fficulty :question.difficulty/easy :question/answer-fields ["answer-field-14091760-d318-52ef-8f7a-1e7f1505bba7" "answer-field-ecf45cf3-40ef-52e7-9ec6-57d10541f220" "answer-field-9336c99c-17c3-5144-b0dc-5fdffe1c6c29" "answer-field-454cc990-2c69-5f82-8f07-4ebe88482891"] :db/ensure [:question/validate]} {:db/id "answer-field-14091760-d318-52ef-8f7a-1e7f1505bba7" :answer-field/id #uuid "14091760-d318-52ef-8f7a-1e7f1505bba7" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-876868ab-7914-5326-9f9e-f52520e3fd18" :answer-field/choices ["answer-876868ab-7914-5326-9f9e-f52520e3fd18"] :db/ensure [:answer-field/validate]} {:db/id "answer-876868ab-7914-5326-9f9e-f52520e3fd18" :answer/id #uuid "876868ab-7914-5326-9f9e-f52520e3fd18" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "answer-field-ecf45cf3-40ef-52e7-9ec6-57d10541f220" :answer-field/id #uuid "ecf45cf3-40ef-52e7-9ec6-57d10541f220" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-bad574c3-61ab-5018-b7c2-e81c899ee288" :answer-field/choices ["answer-bad574c3-61ab-5018-b7c2-e81c899ee288"] :db/ensure [:answer-field/validate]} {:db/id "answer-bad574c3-61ab-5018-b7c2-e81c899ee288" :answer/id #uuid "bad574c3-61ab-5018-b7c2-e81c899ee288" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-field-9336c99c-17c3-5144-b0dc-5fdffe1c6c29" :answer-field/id #uuid "9336c99c-17c3-5144-b0dc-5fdffe1c6c29" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-29f448ec-e2f7-5423-9c43-b27c85d08ed7" :answer-field/choices ["answer-29f448ec-e2f7-5423-9c43-b27c85d08ed7"] :db/ensure [:answer-field/validate]} {:db/id "answer-29f448ec-e2f7-5423-9c43-b27c85d08ed7" :answer/id #uuid "29f448ec-e2f7-5423-9c43-b27c85d08ed7" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "answer-fiel