      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14233881/observations/step-q134797-c41a7f69ad9f6d289f17.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14233881/observations/step-q134797-c41a7f69ad9f6d289f17.png",
