      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14233881/observations/step-q134788-c2629e1a2b21f0ae2b97.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14233881/observations/step-q134788-c2629e1a2b21f0ae2b97.png",
