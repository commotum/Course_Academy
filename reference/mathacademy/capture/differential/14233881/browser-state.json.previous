      "source_url": "https://mathacademy.com/tasks/14233881/topics/3595/lesson",
      "captured_at": 1792078572.7017024,
      "math_academy_id": "q-134787",
      "topic_id": "3595",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q134787",
        "placement_id": null,
