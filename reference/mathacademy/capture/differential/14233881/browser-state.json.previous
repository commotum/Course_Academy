      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14233881/observations/step-q134830-10a9f697d62212169b65.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14233881/observations/step-q134830-10a9f697d62212169b65.png",
      "source_url": "https://mathacademy.com/tasks/14233881/topics/3595/lesson",
      "captured_at": 1792078632.4954896,
      "math_academy_id": "q-134830",
      "topic_id": "3595",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q134830",
        "placement_id": null,
        "content_id": null,
