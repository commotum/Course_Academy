      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14233881/observations/step-q134812-c56af4b9cff4e1cf2efd.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14233881/observations/step-q134812-c56af4b9cff4e1cf2efd.png",
      "source_url": "https://mathacademy.com/tasks/14233881/topics/3595/lesson",
      "captured_at": 1792078507.886185,
      "math_academy_id": "q-134812",
      "topic_id": "3595",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q134812",
