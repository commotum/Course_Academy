      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14233881/observations/step-q134815-9d107d7dae008df09420.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14233881/observations/step-q134815-9d107d7dae008df09420.png",
      "source_url": "https://mathacademy.com/tasks/14233881/topics/3595/lesson",
      "captured_at": 1792078675.208491,
      "math_academy_id": "q-134815",
      "topic_id": "3595",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q134815",
        "placement_id": null,
        "content_id": null,
