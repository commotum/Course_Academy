      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14233881/observations/step-q134825-1fdae826b20a41f1be5e.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14233881/observations/step-q134825-1fdae826b20a41f1be5e.png",
      "source_url": "https://mathacademy.com/tasks/14233881/topics/3595/lesson",
      "captured_at": 1792078655.8819382,
      "math_academy_id": "q-134825",
      "topic_id": "3595",
      "sequence_position": null,
      "source_step": {
