o>−</mo><mtext>Estimated</mtext></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mi>y</mi><mo>−</mo><mrow data-mjx-texclass=\"ORD\"><mover><mi>y</mi><mo>^</mo></mover></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>1</mn><mo>−</mo><mn>0</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>1.</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
