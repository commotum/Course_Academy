      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14233881/observations/step-q134808-143a89a635ab716a8f3c.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14233881/observations/step-q134808-143a89a635ab716a8f3c.png",
      "source_url": "https://mathacademy.com/tasks/14233881/topics/3595/lesson",
      "captured_at": 1792078528.2096438,
      "math_academy_id": "q-134808",
      "topic_id": "3595",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q134808",
        "placement_id": null,
