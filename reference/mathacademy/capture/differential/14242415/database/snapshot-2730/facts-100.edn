ef 17592186045417] [17592186389897 #edb/ref 1080 "images/82/82f9ecf98b8b2b4e5f75b3130e8483354c93922dc3a942e271562ac1ad17438e.png" #edb/ref 17592186045417] [17592186389897 #edb/ref 1082 #edb/ref 17592186045497 #edb/ref 17592186045417] [17592186389897 #edb/ref 1083 #uuid "63212b76-4dd2-5413-b5ba-4e9195ab76e3" #edb/ref 17592186045417] [17592186389898 #edb/ref 1080 "images/e0/e0fa3e717af02a353db77ae8b357dc338c975166fb5fbe6c5c1309d1c1f511f2.png" #edb/ref 17592186045417] [17592186389898 #edb/ref 1082 #edb/ref 17592186045497 #edb/ref 17592186045417] [17592186389898 #edb/ref 1083 #uuid "4a858bfb-ee22-5b56-9050-fa66d28f0274" #edb/ref 17592186045417] [17592186389899 #edb/ref 1080 "images/c2/c28ba6b0da8364f4e7f157b58827384f9e138a2c0fc53558ce7ab2df2f646747.png" #edb/ref 17592186045417] [17592186389899 #edb/ref 1082 #edb/ref 17592186045497 #edb/ref 17592186045417] [17592186389899 #edb/ref 1083 #uuid "7442f1d4-b621-53b9-a885-39076816c0b2" #edb/ref 17592186045417] [17592186389900 #edb/ref 1080 "images/07/075454dae9ed36967a70537cdf3a3f59931cdd81671ff4059658d2e0df438898.png" #edb/ref 17592186045417] [17592186389900 #edb/ref 1082 #edb/ref 17592186045497 #edb/ref 17592186045417] [17592186389900 #edb/ref 1083 #uuid "281cc561-5401-5252-9068-734db096e5bd" #edb/ref 17592186045417] [17592186389901 #edb/ref 1080 "images/29/2922ff5e3a32e01fbc292898c88c1d8eca8d933897d4b9d3c1694b6f5cbeb2a2.png" #edb/ref 17592186045417] [17592186389901 #edb/ref 1082 #edb/ref 17592186045497 #edb/ref 17592186045417] [17592186389901 #edb/ref 1083 #uuid "b42501d9-b115-5c79-8921-c1756b26a1c9" #edb/ref 17592186045417] [17592186389909 #edb/ref 1068 #edb/ref 17592186389910 #edb/ref 17592186045417] [17592186389909 #edb/ref 1069 "q-181959" #edb/ref 17592186045417] [17592186389909 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186389909 #edb/ref 1071 "Which of the following is a representation of the set $S=N\\times Z$ in the Cartesian plane?" #edb/ref 17592186045417] [17592186389909 #edb/ref 1072 #uuid "9854e016-8489-5582-ad5c-ffa3a5b6e5ec" #edb/ref 17592186045417] [17592186389909 #edb/ref 1074 "The Cartesian product $A\\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\n$$\nA\\times B=\\{(a,b)\\,:\\,a\\in A,\\,b\\in B\\}\n$$\n\nIn this case, the set \n\n$$\nS=N\\times Z\n$$\n\ncontains every point in ${R}^{2}$ whose $x$-coordinate is a natural number and whose $y$-coordinate is an integer number.\n\n$$\nS=\\{(x,y)\\,:\\,x\\in N,\\,y\\in Z\\}.\n$$\n\nTo visualize $S$, consider ${S}_{1}⊂S$ containing all points whose $x$-coordinate equals $1$ and whose $y$-coordinate is any integer number.\n\n$$\n{S}_{1}=\\{(1,y)\\,:\\,y\\in Z\\}.\n$$\n\nWe can represent ${S}_{1}$ in the plane as follows:\n\n![](images/17/179fdaa3921cb29f2d25ff97bce262fd13fb2ff591c12e97a33953e95967f6fc.png)\n\nNext, consider ${S}_{2}⊂S$ containing all points whose $x$-coordinate equals $2$ and whose $y$-coordinate is any natural number.\n\n$$\n{S}_{2}=\\{(2,y)\\,:\\,y\\in Z\\}.\n$$\n\nWe can represent ${S}_{2}$ in the plane as follows:\n\n![](images/73/7399e42988df8a809013393d8873b6a6e5f60b64c0419eadd7bb3c334eb410d6.png)\n\nWe can create the subsets ${S}_{3},{S}_{4},{S}_{5},…$ similarly. Our Cartesian product $S$ is the *union* of these subsets:\n\n$$\n\\begin{aligned}S & ={S}_{1}\\cup {S}_{2}\\cup {S}_{3}\\cup … \\\\  & ={⋃}_{i\\in N}{S}_{i}\\end{aligned}\n$$\n\nTherefore, we can visualize $N\\times Z$ as the set of points in the diagram below.\n\n![](images/16/16ff13c793d3c3f57eefee638fbc1ff83569ef6d084d9d053f8585f72c8812d7.png)" #edb/ref 17592186045417] [17592186389910 #edb/ref 1075 #edb/ref 17592186389911 #edb/ref 17592186045417] [17592186389910 #edb/ref 1075 #edb/ref 17592186389912 #edb/ref 17592186045417] [17592186389910 #edb/ref 1075 #edb/ref 17592186389913 #edb/ref 17592186045417] [17592186389910 #edb/ref 1075 #edb/ref 17592186389914 #edb/ref 17592186045417] [17592186389910 #edb/ref 1075 #edb/ref 17592186389915 #edb/ref 17592186045417] [17592186389910 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186389910 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186389910 #edb/ref 1078 #edb/ref 17592186389913 #edb/ref 17592186045417] [17592186389910 #edb/ref 1079 #uuid "afa6976a-3c32-54c7-bedf-912fa5e61648" #edb/ref 17592186045417] [17592186389911 #edb/ref 1080 "images/c9/c9adb78f087651508a43514756abbc45170766d6bb14a069053c4bf71e78e0a3.png" #edb/ref 17592186045417] [17592186389911 #edb/ref 1082 #edb/ref 17592186045497 #edb/ref 17592186045417] [17592186389911 #edb/ref 1083 #uuid "5c52fa43-923f-576a-ba23-dee22206f178" #edb/ref 17592186045417]}
