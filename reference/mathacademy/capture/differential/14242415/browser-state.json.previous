      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14242415/observations/step-q175302-e746a28adb47bc865b1c.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14242415/observations/step-q175302-e746a28adb47bc865b1c.png",
