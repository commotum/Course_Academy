      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14242415/observations/step-q184490-45ca9b8807dfa2edf934.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14242415/observations/step-q184490-45ca9b8807dfa2edf934.png",
