      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14222477/observations/step-q106412-d37dac11e38f5d9ed2e8.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14222477/observations/step-q106412-d37dac11e38f5d9ed2e8.png",
