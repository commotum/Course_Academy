2186241175} {:db/id #edb/ref 17592186241176} {:db/id #edb/ref 17592186292780} {:db/id #edb/ref 17592186295118} {:db/id #edb/ref 17592186295119} {:db/id #edb/ref 17592186295120} {:db/id #edb/ref 17592186295121} {:db/id #edb/ref 17592186354319} {:db/id #edb/ref 17592186354320} {:db/id #edb/ref 17592186354321} {:db/id #edb/ref 17592186375673} {:db/id #edb/ref 17592186377035} {:db/id #edb/ref 17592186377907} {:db/id #edb/ref 17592186377914} {:db/id #edb/ref 17592186535964} {:db/id #edb/ref 17592186535987}] :knowledge-point/title "Parametrizing a Horizontal Parabola Whose Vertex Is at the Origin"} :step/id #uuid "a81f2327-ee3f-53ff-8ff9-4e5727353be6" :step/math-academy-id 27577 :step/next {:db/id #edb/ref 17592186088689}} {:db/id #edb/ref 17592186088689 :step/content {:db/id #edb/ref 17592186087802 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087630 :question/id #uuid "07678ad9-a16f-5fd2-8e39-85376aa9112e" :question/math-academy-id "e-7442"} :knowledge-point/id #uuid "4ccc7f71-d2e0-5f35-80a5-042a53eda2da" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049144}] :knowledge-point/questions [{:db/id #edb/ref 17592186088429} {:db/id #edb/ref 17592186088435} {:db/id #edb/ref 17592186241177} {:db/id #edb/ref 17592186292781} {:db/id #edb/ref 17592186295129} {:db/id #edb/ref 17592186295131} {:db/id #edb/ref 17592186295132} {:db/id #edb/ref 17592186354325} {:db/id #edb/ref 17592186354326} {:db/id #edb/ref 17592186354327} {:db/id #edb/ref 17592186354328} {:db/id #edb/ref 17592186375680} {:db/id #edb/ref 17592186377058} {:db/id #edb/ref 17592186377061} {:db/id #edb/ref 17592186377064} {:db/id #edb/ref 17592186377921} {:db/id #edb/ref 17592186535931} {:db/id #edb/ref 17592186535947} {:db/id #edb/ref 17592186535971}] :knowledge-point/title "Finding the Cartesian Equation of a Parabola Given Its Parametric Equations"} :step/id #uuid "d0e480ce-44cf-566d-a958-fb2ee799eb46" :step/math-academy-id 27586 :step/next {:db/id #edb/ref 17592186088697}} {:db/id #edb/ref 17592186088695 :step/content {:db/id #edb/ref 17592186088970 :tutorial/content "The standard parametric equations of a *vertical* parabola that has its vertex at $(0,0)$ are\n\n$$\nx = 2pt, \\qquad y = pt^2, \\qquad t \\in (-\\infty, \\infty),\n$$\n\nwhere $p$ is constant.\n\nAs usual, the sign of $p$ determines whether the parabola is upward-opening or downward-opening.\n\n- When $p > 0,$ the parabola is upward-opening.\n\n![](images/39/3962fbc2a0fff44300677c89e867c57582473a8e56aedfe0fcf1d20fb9a322c9.png)\n\n- When $p < 0,$ the parabola is downward-opening.\n\n![](images/63/63acc881f875fbf96fb6ef8a8db9fb778669eabbc171e3800e521a48c130aa89.png)" :tutorial/id #uuid "a0b858e3-ea45-5f93-903c-65d346ab9b0a" :tutorial/math-academy-id 4624 :tutorial/title "Introduction"} :step/id #uuid "283e44b0-129c-5ed3-8eda-f67b74ce0e0d" :step/math-academy-id 28491 :step/next {:db/id #edb/ref 17592186088687}} {:db/id #edb/ref 17592186088696 :step/content {:db/id #edb/ref 17592186088971 :tutorial/content "The parametric equations of a *horizontal* parabola that has its vertex at $(0,0)$ are\n\n$$\nx = pt^2, \\qquad y = 2pt, \\qquad t \\in (-\\infty, \\infty),\n$$\n\nwhere $p$ is constant.\n\nThis time, the sign of $p$ determines whether the parabola is left-opening or right-opening.\n\n- When $p > 0,$ the parabola is right-opening.\n\n![](images/77/7758fc4d8eaec780a92c548393b48eb1457d6961fb33aa7e4e4e776e71a4fd7a.png)\n\n- When $p < 0,$ the parabola is left-opening.\n\n![](images/28/28f17924216890db2b0f9a6baf914502184ce21d7f5723a933c955e789b1bb23.png)" :tutorial/id #uuid "6480b59c-8f91-5c94-8eb9-0f1bfe519e81" :tutorial/math-academy-id 4625 :tutorial/title "The Parametric Equations of Horizontal Parabolas Whose Vertex Is at the Origin"} :step/id #uuid "3c903871-8fc1-5bba-b0a9-757980a0ad09" :step/math-academy-id 28492 :step/next {:db/id #edb/ref 17592186088688}} {:db/id #edb/ref 17592186088697 :step/content {:db/id #edb/ref 17592186088972 :tutorial/content "We've been told that the parametric equations of a vertical parabola that has its vertex at $(0,0)$ are\n\n$$\nx = 2pt, \\qquad y = pt^2, \\qquad t\\in(-\\infty,\\infty).\n$$\n\nBut how do we know that these parametric equations describe a parabola?\n\nFirst, let's make $t$ the subject of the parametric equations:\n\n$$\n\\begin{aligned}x & =2pt & ⟹ &  & t & =\\frac{x}{2p} \\\\ y & =p{t}^{2} & ⟹ &  & {t}^{2} & =\\frac{y}{p}\\end{aligned}\n$$\n\nSquaring the first equation above, we have\n\n$$\n\\begin{aligned}{t}^{2} & ={(\\frac{x}{2p})}^{2} \\\\ {t}^{2} & =\\frac{{x}^{2}}{4{p}^{2}}.\\end{aligned}\n$$\n\nNow, substituting the above into the second equation $t^2 = \\dfrac{y}{p},$ we can eliminate the parameter $t$ and rearrange to find the Cartesian equation:\n\n$$\n\\begin{aligned}{t}^{2} & =\\frac{y}{p} \\\\ \\frac{{x}^{2}}{4{p}^{2}} & =\\frac{y}{p} \\\\ {x}^{2} & =\\frac{y}{p}\\cdot 4{p}^{2} \\\\ {x}^{2} & =4py\\end{aligned}\n$$\n\nThis is the Cartesian equation of a vertical parabola, which confirms that the parametric equations describe a vertical parabola.\n\nIf we followed the same procedure for the parametric equations of a horizontal parabola that has its vertex at $(0,0),$ we would obtain that the Cartesian equation of the parabola is $y^2 = 4px.$" :tutorial/id #uuid "eeb3b2df-57fd-5962-bc60-e1e64961038e" :tutorial/math-academy-id 4626 :tutorial/title "How Do We Know That the Parametric Equations Describe a Parabola?"} :step/id #uuid "f517edbc-d6fc-5d91-ab9f-1f40acb5734e" :step/math-academy-id 28495}] :activity/title "Parametric Equations of Parabolas" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186087940}]}
