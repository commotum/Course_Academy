#{[{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186162851} :activity/id #uuid "b8d01ac6-d0ed-56fb-a724-8bf89dbf7d77" :activity/scope {:db/id #edb/ref 17592186049450 :topic/id #uuid "f66a029b-c648-5d01-a90b-9ef34d0631d3" :topic/math-academy-id 3123} :activity/steps [{:db/id #edb/ref 17592186162851 :step/content {:db/id #edb/ref 17592186163226 :tutorial/content "Given a bilinear form $B(\\mathbf{x},\\mathbf{y})$ such that \n\n$$\nB:\\Bbb R^n \\times \\Bbb R^n \\to \\Bbb R\n$$\n\nand the corresponding $n \\times n$ matrix is *symmetric*, we can define the so-called **quadratic form** by substituting $\\mathbf{y}=\\mathbf{x}$ as follows:\n\n$$\nQ(\\mathbf{x})= B(\\mathbf{x},\\mathbf{x}).\n$$\n\n \n\nNotice that the new expression depends only on $\\mathbf{x}.$ So, a quadratic form is a function \n\n$$\nQ:\\Bbb R^n \\to \\Bbb R.\n$$\n\nIn matrix notation, a quadratic form  can be given as \n\n$$\nQ(\\mathbf{x}) = \\mathbf{x}^T \\! A \\mathbf{x},\n$$\n\n  \n\nwhere $A$ is a symmetric matrix. It's called the **matrix of the quadratic form**. \n\n**Watch out!** By definition, the matrix of a quadratic form must be *symmetric*.\n\nFor example, given the bilinear form \n\n![](images/99/996c4aa136dd7cda56787a2edb0f9481ed3d9356248a27afcde050ca613b6b9c.svg) \n\nthe corresponding quadratic form is then\n$Q( \\mathbf{x})=B( \\mathbf{x}, \\mathbf{x}).$\nExplicitly, we have\n\n$$\n\\begin{aligned}Q({x}_{1},{x}_{2}) & =[\\begin{aligned}{x}_{1} & {x}_{2}\\end{aligned}][\\begin{aligned}1 & 2 \\\\ 2 & 1\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] \\\\  & =[\\begin{aligned}{x}_{1} & {x}_{2}\\end{aligned}][\\begin{aligned}{x}_{1}+2{x}_{2} \\\\ 2{x}_{1}+{x}_{2}\\end{aligned}] \\\\  & ={x}_{1}^{2}+4{x}_{1}{x}_{2}+{x}_{2}^{2}.\\end{aligned}\n$$\n\n  \n\n**Note**: In a quadratic form, all terms must be of degree two (considered as polynomials in the variables $x_1, x_2, \\cdots, x_n$). That's the reason we call it *quadratic*." :tutorial/id #uuid "f35d3e6c-6386-5c92-91c9-05fe3d888a47" :tutorial/math-academy-id 4884 :tutorial/title "Introduction"} :step/id #uuid "79f6f6cd-00ca-545a-aec0-257cfc16bf2b" :step/math-academy-id 30535 :step/next {:db/id #edb/ref 17592186162866}} {:db/id #edb/ref 17592186162866 :step/content {:db/id #edb/ref 17592186161984 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161776 :question/id #uuid "122fd33e-5ef4-5200-9c72-67f40f3b8ca0" :question/math-academy-id "e-8168"} :knowledge-point/id #uuid "e62e458d-0724-5dbe-b448-b79404f279f9" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050021}] :knowledge-point/questions [{:db/id #edb/ref 17592186162592} {:db/id #edb/ref 17592186162616} {:db/id #edb/ref 17592186272168} {:db/id #edb/ref 17592186357639} {:db/id #edb/ref 17592186357640} {:db/id #edb/ref 17592186357641} {:db/id #edb/ref 17592186491113}] :knowledge-point/title "Identifying Matrices of Quadratic Forms"} :step/id #uuid "c50bbdb7-ec08-57b4-bc96-b8e668bc34db" :step/math-academy-id 30584 :step/next {:db/id #edb/ref 17592186162867}} {:db/id #edb/ref 17592186162867 :step/content {:db/id #edb/ref 17592186161985 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161777 :question/id #uuid "d782c826-1111-5c83-98b6-220856d74b41" :question/math-academy-id "e-8169"} :knowledge-point/id #uuid "90f62dc8-396d-5f7f-8295-2e7b5d62bd78" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050407}] :knowledge-point/questions [{:db/id #edb/ref 17592186162593} {:db/id #edb/ref 17592186162594} {:db/id #edb/ref 17592186272172} {:db/id #edb/ref 17592186357643} {:db/id #edb/ref 17592186357644} {:db/id #edb/ref 17592186357646} {:db/id #edb/ref 17592186357647} {:db/id #edb/ref 17592186357649} {:db/id #edb/ref 17592186491135} {:db/id #edb/ref 17592186491154} {:db/id #edb/ref 17592186491171}] :knowledge-point/title "Evaluating a Quadratic Form"} :step/id #uuid "193a5105-f949-5b8b-a134-e0f453f3f2c3" :step/math-academy-id 30585 :step/next {:db/id #edb/ref 17592