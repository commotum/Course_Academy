d #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469678} :answer-field/id #uuid "431b9dde-c58c-5f17-a803-fb9e8caef06e" :answer-field/key "V" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470451}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "93d6f7f1-c1fb-5ae2-b8f7-98ecf5b306a1" :question/math-academy-id "q-94062" :question/problem "Which of the following could be matrices of quadratic forms defined on ${R}^{3}?$\n\n$$\nT=[\\begin{aligned}4 & 5 & -3 \\\\ 5 & 1 & -8 \\\\ -3 & -8 & 7\\end{aligned}],\\,U=[\\begin{aligned}7 & 1 & -2 \\\\ 1 & 4 & 5 \\\\ -2 & 5 & 7\\end{aligned}],\\,V=[\\begin{aligned}1 & -3 \\\\ -3 & 1\\end{aligned}]\n$$\n\nSelect all that apply." :question/worked-solution "Recall that every quadratic form defined on ${R}^{3}$ has an associated $3\\times 3$ symmetric matrix.\n\nWith that in mind, let's examine each matrix in turn.\n\n- $T$ could be a matrix of a quadratic form defined on ${R}^{3}$ since it is a $3\\times 3$ symmetric matrix.\n\n- $U$ could also be a matrix of a quadratic form defined on ${R}^{3}$ since it is a $3\\times 3$ symmetric matrix.\n\n- $V$ *cannot* be a matrix of a quadratic form defined on ${R}^{3}$ since it's a $2\\times 2$ matrix (not $3\\times 3$).\n\nTherefore, the correct answer is \"$T$ and $U$ only.\""}] [{:db/id #edb/ref 17592186357641 :knowledge-point/_questions [{:db/id #edb/ref 17592186161984 :knowledge-point/id #uuid "e62e458d-0724-5dbe-b448-b79404f279f9" :knowledge-point/title "Identifying Matrices of Quadratic Forms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "276e7784-3f27-5f16-857d-565398b07228" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469680} {:answer/id #uuid "8c5031f6-651d-54a5-875f-0765312ac751" :answer/type {:db/id #edb/re