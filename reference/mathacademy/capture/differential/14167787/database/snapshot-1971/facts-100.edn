#{[17592186356809 #edb/ref 1080 "{x}_{1}^{2}+2{x}_{1}{x}_{3}+2{x}_{2}^{2}-2{x}_{3}^{2}" #edb/ref 17592186045417] [17592186356809 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186356809 #edb/ref 1083 #uuid "f65a1d83-e90e-527d-9df8-022f7c05907b" #edb/ref 17592186045417] [17592186356885 #edb/ref 1080 "2{x}_{1}^{2}+2{x}_{1}{x}_{2}+2{x}_{3}^{2}" #edb/ref 17592186045417] [17592186356885 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186356885 #edb/ref 1083 #uuid "fd26311c-2f18-574d-9496-266fed0c1d74" #edb/ref 17592186045417] [17592186356889 #edb/ref 1080 "50" #edb/ref 17592186045417] [17592186356889 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186356889 #edb/ref 1083 #uuid "fd8c4557-1921-5623-801b-cbf59ef1f2a3" #edb/ref 17592186045417] [17592186356890 #edb/ref 1080 "2{x}_{1}^{2}+6{x}_{1}{x}_{2}+2{x}_{2}^{2}" #edb/ref 17592186045417] [17592186356890 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186356890 #edb/ref 1083 #uuid "fd92fbd4-d7d1-557a-8864-0868b5fc986c" #edb/ref 17592186045417] [17592186356935 #edb/ref 1075 #edb/ref 17592186354673 #edb/ref 17592186045417] [17592186356935 #edb/ref 1075 #edb/ref 17592186355485 #edb/ref 17592186045417] [17592186356935 #edb/ref 1075 #edb/ref 17592186356266 #edb/ref 17592186045417] [17592186356935 #edb/ref 1075 #edb/ref 17592186356809 #edb/ref 17592186045417] [17592186356935 #edb/ref 1075 #edb/ref 17592186356885 #edb/ref 17592186045417] [17592186356935 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186356935 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186356935 #edb/ref 1078 #edb/ref 17592186356266 #edb/ref 17592186045417] [17592186356935 #edb/ref 1079 #uuid "09e70103-bd6b-5347-8799-710e68326fdd" #edb/ref 17592186045417] [17592186356952 #edb/ref 1075 #edb/ref 17592186354727 #edb/ref 17592186045417] [17592186356952 #edb/ref 1075 #edb/ref 17592186354776 #edb/ref 17592186045417] [17592186356952 #edb/ref 1075 #edb/ref 17592186355011 #edb/ref 17592186045417] [17592186356952 #edb/ref 1075 #edb/ref 17592186355538 #edb/ref 17592186045417] [17592186356952 #edb/ref 1075 #edb/ref 17592186356172 #edb/ref 17592186045417] [17592186356952 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186356952 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186356952 #edb/ref 1078 #edb/ref 17592186354727 #edb/ref 17592186045417] [17592186356952 #edb/ref 1079 #uuid "135db05c-789b-5517-a595-77d2c4b006a8" #edb/ref 17592186045417] [17592186356981 #edb/ref 1075 #edb/ref 17592186355166 #edb/ref 17592186045417] [17592186356981 #edb/ref 1075 #edb/ref 17592186355735 #edb/ref 17592186045417] [17592186356981 #edb/ref 1075 #edb/ref 17592186356326 #edb/ref 17592186045417] [17592186356981 #edb/ref 1075 #edb/ref 17592186356471 #edb/ref 17592186045417] [17592186356981 #edb/ref 1075 #edb/ref 17592186356611 #edb/ref 17592186045417] [17592186356981 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186356981 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186356981 #edb/ref 1078 #edb/ref 17592186355166 #edb/ref 17592186045417] [17592186356981 #edb/ref 1079 #uuid "24c65efe-f0dc-5833-85bd-c0e38f31a3b2" #edb/ref 17592186045417] [17592186357067 #edb/ref 1075 #edb/ref 17592186354991 #edb/ref 17592186045417] [17592186357067 #edb/ref 1075 #edb/ref 17592186355216 #edb/ref 17592186045417] [17592186357067 #edb/ref 1075 #edb/ref 17592186355314 #edb/ref 17592186045417] [17592186357067 #edb/ref 1075 #edb/ref 17592186356653 #edb/ref 17592186045417] [17592186357067 #edb/ref 1075 #edb/ref 17592186356678 #edb/ref 17592186045417] [17592186357067 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186357067 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186357067 #edb/ref 1078 #edb/ref 17592186356653 #edb/ref 17592186045417] [17592186357067 #edb/ref 1079 #uuid "57a91600-a00a-59db-b63e-edcd7437f52e" #edb/ref 17592186045417] [17592186357165 #edb/ref 1075 #edb/ref 17592186354679 #edb/ref 17592186045417] [17592186357165 #edb/ref 1075 #edb/ref 17592186355662 #edb/ref 17592186045417] [17592186357165 #edb/ref 1075 #edb/ref 17592186356433 #edb/ref 17592186045417] [17592186357165 #edb/ref 1075 #edb/ref 17592186356448 #edb/ref 17592186045417] [17592186357165 #edb/ref 1075 #edb/ref 17592186356534 #edb/ref 17592186045417] [17592186357165 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186357165 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186357165 #edb/ref 1078 #edb/ref 17592186356433 #edb/ref 17592186045417] [17592186357165 #edb/ref 1079 #uuid "8a785e93-2dfe-5d3a-8afd-c6a0e1ac5840" #edb/ref 17592186045417] [17592186357276 #edb/ref 1075 #edb/ref 17592186354908 #edb/ref 17592186045417] [17592186357276 #edb/ref 1075 #edb/ref 17592186355924 #edb/ref 17592186045417] [17592186357276 #edb/ref 1075 #edb/ref 17592186355999 #edb/ref 17592186045417] [17592186357276 #edb/ref 1075 #edb/ref 17592186356383 #edb/ref 17592186045417] [17592186357276 #edb/ref 1075 #edb/ref 17592186356890 #edb/ref 17592186045417] [17592186357276 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186357276 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186357276 #edb/ref 1078 #edb/ref 17592186356890 #edb/ref 17592186045417] [17592186357276 #edb/ref 1079 #uuid "c702bda3-b33d-5d6a-b438-e9d3a5575649" #edb/ref 17592186045417] [17592186357286 #edb/ref 1075 #edb/ref 17592186354758 #edb/ref 17592186045417] [17592186357286 #edb/ref 1075 #edb/ref 17592186355501 #edb/ref 17592186045417] [17592186357286 #edb/ref 1075 #edb/ref 17592186356224 #edb/ref 17592186045417] [17592186357286 #edb/ref 1075 #edb/ref 17592186356586 #edb/ref 17592186045417] [17592186357286 #edb/ref 1075 #edb/ref 17592186356889 #edb/ref 17592186045417] [17592186357286 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186357286 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186357286 #edb/ref 1078 #edb/ref 17592186354758 #edb/ref 17592186045417] [17592186357286 #edb/ref 1079 #uuid "cc3a1765-85b4-55a6-8deb-90bf5ef0fd58" #edb/ref 17592186045417] [17592186357640 #edb/ref 1068 #edb/ref 17592186470449 #edb/ref 17592186045436] [17592186357640 #edb/ref 1068 #edb/ref 17592186470450 #edb/ref 17592186045436] [17592186357640 #edb/ref 1068 #edb/ref 17592186470451 #edb/ref 17592186045436] [17592186357640 #edb/ref 1069 "q-94062" #edb/ref 17592186045417] [17592186357640 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186357640 #edb/ref 1071 "Which of the following could be matrices of quadratic forms defined on ${R}^{3}?$\n\n$$\nT=[\\begin{aligned}4 & 5 & -3 \\\\ 5 & 1 & -8 \\\\ -3 & -8 & 7\\end{aligned}],\\,U=[\\begin{aligned}7 & 1 & -2 \\\\ 1 & 4 & 5 \\\\ -2 & 5 & 7\\end{aligned}],\\,V=[\\begin{aligned}1 & -3 \\\\ -3 & 1\\end{aligned}]\n$$\n\nSelect all that apply." #edb/ref 17592186045436] [17592186357640 #edb/ref 1072 #uuid "93d6f7f1-c1fb-5ae2-b8f7-98ecf5b306a1" #edb/ref 17592186045417] [17592186357640 #edb/ref 1074 "Recall that every quadratic form defined on ${R}^{3}$ has an associated $3\\times 3$ symmetric matrix.\n\nWith that in mind, let's examine each matrix in turn.\n\n- $T$ could be a matrix of a quadratic form defined on ${R}^{3}$ since it is a $3\\times 3$ symmetric matrix.\n\n- $U$ could also be a matrix of a quadratic form defined on ${R}^{3}$ since it is a $3\\times 3$ symmetric matrix.\n\n- $V$ *cannot* be a matrix of a quadratic form defined on ${R}^{3}$ since it's a $2\\times 2$ matrix (not $3\\times 3$).\n\nTherefore, the correct answer is \"$T$ and $U$ only.\"" #edb/ref 17592186045417] [17592186357641 #edb/ref 1068 #edb/ref 17592186470452 #edb/ref 17592186045436] [17592186357641 #edb/ref 1068 #edb/ref 17592186470453 #edb/ref 17592186045436] [17592186357641 #edb/ref 1068 #edb/ref 17592186470454 #edb/ref 17592186045436] [17592186357641 #edb/ref 1069 "q-94063" #edb/ref 17592186045417] [17592186357641 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186357641 #edb/ref 1071 "Which of the following could be matrices of quadratic forms defined on ${R}^{4}?$\n\n$$\nD=[\\begin{aligned}3 & 1 & 3 & 0 \\\\ 1 & 5 & 1 & -2 \\\\ 3 & 1 & -2 & 2 \\\\ 0 & -4 & 2 & 7\\end{aligned}],\\,E=[\\begin{aligned}7 & 1 \\\\ 1 & 4\\end{aligned}],\\,F=[\\begin{aligned}1 & 2 & 3 & 6 \\\\ 2 & 5 & 4 & -1 \\\\ 3 & 4 & -2 & 2 \\\\ 6 & -1 & 2 & 7\\end{aligned}]\n$$\n\nSelect all that apply." #edb/ref 17592186045436] [17592186357641 #edb/ref 1072 #uuid "61630213-687e-509d-b369-4384ce08371c" #edb/ref 17592186045417] [17592186357641 #edb/ref 1074 "Recall that every quadratic form defined on ${R}^{4}$ has an associated $4\\times 4$ symmetric matrix.\n\nWith that in mind, let's examine each matrix in turn.\n\n- $D$ *cannot* be a matrix of a quadratic form defined on ${R}^{4}.$ Although it's a $4\\times 4$ matrix, $D$ is not symmetric since ${d}_{24}\\ne {d}_{42}.$\n\n- $E$ *cannot* be a matrix of a quadratic form defined on ${R}^{4}$ since it's a $2\\times 2$ matrix (not $4\\times 4$).\n\n- $F$ could be a matrix of a quadratic form defined on ${R}^{4}$ since it is a $4\\times 4$ symmetric matrix.\n\nTherefore, the correct answer is \"$F$ only.\"" #edb/ref 17592186045417] [17592186357647 #edb/ref 1068 #edb/ref 17592186357286 #edb/ref 17592186045417] [17592186357647 #edb/ref 1069 "q-94087" #edb/ref 17592186045417] [17592186357647 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186357647 #edb/ref 1071 "$$\nA=[\\begin{aligned}3 & 5 \\\\ 5 & -2\\end{aligned}]\n$$\n\nGiven the matrix $A$ above, evaluate the quadratic form $Q(x)={x}^{T}\\,Ax$ when $x=[\\begin{aligned}3 \\\\ 1\\end{aligned}].$" #edb/ref 17592186045417] [17592186357647 #edb/ref 1072 #uuid "40bf396a-4434-5665-92ca-ca493dc1ea08" #edb/ref 17592186045417] [17592186357647 #edb/ref 1074 "Substituting $x=[\\begin{aligned}3 \\\\ 1\\end{aligned}]$ into the expression for $Q(x),$ we obtain\n\n$$\n\\begin{aligned}Q(x) & ={x}^{T}\\,Ax \\\\  & =[\\begin{aligned}3 & 1\\end{aligned}][\\begin{aligned}3 & 5 \\\\ 5 & -2\\end{aligned}][\\begin{aligned}3 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}14 & 13\\end{aligned}][\\begin{aligned}3 \\\\ 1\\end{aligned}] \\\\  & =55.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186357651 #edb/ref 1068 #edb/ref 17592186357276 #edb/ref 17592186045417] [17592186357651 #edb/ref 1069 "q-94093" #edb/ref 17592186045417] [17592186357651 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186357651 #edb/ref 1071 "$$\nA=[\\begin{aligned}2 & 3 \\\\ 3 & 2\\end{aligned}]\n$$\n\nConsider the matrix $A$ above. Which of the following represents the corresponding quadratic form ${x}^{T}\\,Ax$ in terms of the components of $x=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]?$" #edb/ref 17592186045417] [17592186357651 #edb/ref 1072 #uuid "8b6c5226-6a4c-5905-b982-20f40f90cbd5" #edb/ref 17592186045417] [17592186357651 #edb/ref 1074 "**Method 1**\n\nEach entry ${a}_{ij}$ of $A$ corresponds to the term ${a}_{ij}{x}_{i}{x}_{j}$ in the expression of the quadratic form:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ax & =2{x}_{1}{x}_{1}+(3){x}_{1}{x}_{2}+(3){x}_{2}{x}_{1}+2{x}_{2}{x}_{2} \\\\  & =2{x}_{1}^{2}+3{x}_{1}{x}_{2}+3{x}_{2}{x}_{1}+2{x}_{2}^{2} \\\\  & =2{x}_{1}^{2}+6{x}_{1}{x}_{2}+2{x}_{2}^{2}\\end{aligned}\n$$\n\n**Method 2**\n\nTo write down a quadratic form in terms of vector components, we compute the following expression:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ax & =[\\begin{aligned}{x}_{1} & {x}_{2}\\end{aligned}][\\begin{aligned}2 & 3 \\\\ 3 & 2\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] \\\\  & =[\\begin{aligned}{x}_{1} & {x}_{2}\\end{aligned}][\\begin{aligned}2{x}_{1}+3{x}_{2} \\\\ 3{x}_{1}+2{x}_{2}\\end{aligned}] \\\\  & ={x}_{1}(2{x}_{1}+3{x}_{2})+{x}_{2}(3{x}_{1}+2{x}_{2}) \\\\  & =2{x}_{1}^{2}+3{x}_{1}{x}_{2}+3{x}_{2}{x}_{1}+2{x}_{2}^{2} \\\\  & =2{x}_{1}^{2}+6{x}_{1}{x}_{2}+2{x}_{2}^{2}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186357654 #edb/ref 1068 #edb/ref 17592186356935 #edb/ref 17592186045417] [17592186357654 #edb/ref 1069 "q-94099" #edb/ref 17592186045417] [17592186357654 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186357654 #edb/ref 1071 "$$\nA=[\\begin{aligned}2 & 1 & 0 \\\\ 1 & -2 & 0 \\\\ 0 & 0 & 2\\end{aligned}]\n$$\n\nConsider the matrix $A$ above. Which of the following represents the corresponding quadratic form ${x}^{T}\\,Ax$ in terms of the components of $x=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]?$" #edb/ref 17592186045417] [17592186357654 #edb/ref 1072 #uuid "96f2319e-e633-542e-b1fa-62302f0afd32" #edb/ref 17592186045417] [17592186357654 #edb/ref 1074 "**Method 1**\n\nEach entry ${a}_{ij}$ of $A$ corresponds to the term ${a}_{ij}{x}_{i}{x}_{j}$ in the expression of the quadratic form:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ax & =2{x}_{1}{x}_{1}+1{x}_{1}{x}_{2}+0{x}_{1}{x}_{3}+1{x}_{2}{x}_{1}+(-2){x}_{2}{x}_{2}+0{x}_{2}{x}_{3}+0{x}_{3}{x}_{1}+0{x}_{3}{x}_{2}+2{x}_{3}{x}_{3} \\\\  & =2{x}_{1}^{2}+{x}_{1}{x}_{2}+{x}_{2}{x}_{1}-2{x}_{2}^{2}+2{x}_{3}^{2} \\\\  & =2{x}_{1}^{2}+2{x}_{1}{x}_{2}-2{x}_{2}^{2}+2{x}_{3}^{2}\\end{aligned}\n$$\n\n**Method 2**\n\nTo write down a quadratic form in terms of vector components, we compute the following expression:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ax & =[\\begin{aligned}{x}_{1} & {x}_{2} & {x}_{3}\\end{aligned}][\\begin{aligned}2 & 1 & 0 \\\\ 1 & -2 & 0 \\\\ 0 & 0 & 2\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}] \\\\  & =[\\begin{aligned}{x}_{1} & {x}_{2} & {x}_{3}\\end{aligned}][\\begin{aligned}2{x}_{1}+{x}_{2} \\\\ {x}_{1}-2{x}_{2} \\\\ 2{x}_{3}\\end{aligned}] \\\\  & ={x}_{1}(2{x}_{1}+{x}_{2})+{x}_{2}({x}_{1}-2{x}_{2})+{x}_{3}(2{x}_{3}) \\\\  & =2{x}_{1}^{2}+{x}_{1}{x}_{2}+{x}_{2}{x}_{1}-2{x}_{x}^{2}+2{x}_{3}^{2} \\\\  & =2{x}_{1}^{2}+2{x}_{1}{x}_{2}-2{x}_{2}^{2}+2{x}_{3}^{2}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186357656 #edb/ref 1068 #edb/ref 17592186356952 #edb/ref 17592186045417] [17592186357656 #edb/ref 1069 "q-94105" #edb/ref 17592186045417] [17592186357656 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186357656 #edb/ref 1071 "$$\nA=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 2 & -1 \\\\ 0 & -1 & 3\\end{aligned}]\n$$\n\nConsider the matrix $A$ above. Which of the following represents the corresponding quadratic form ${x}^{T}\\,Ax$ in terms of the components of $x=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]?$" #edb/ref 17592186045417] [17592186357656 #edb/ref 1072 #uuid "fee716f7-a185-58ac-8ee8-36859424ee03" #edb/ref 17592186045417] [17592186357656 #edb/ref 1074 "**Method 1**\n\nEach entry ${a}_{ij}$ of $A$ corresponds to the term ${a}_{ij}{x}_{i}{x}_{j}$ in the expression of the quadratic form:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ax & =1{x}_{1}{x}_{1}+0{x}_{1}{x}_{2}+0{x}_{1}{x}_{3}+0{x}_{2}{x}_{1}+2{x}_{2}{x}_{2}+(-1){x}_{2}{x}_{3}+0{x}_{3}{x}_{1}+(-1){x}_{3}{x}_{2}+3{x}_{3}{x}_{3} \\\\  & ={x}_{1}^{2}+2{x}_{2}^{2}-{x}_{2}{x}_{3}-{x}_{3}{x}_{2}+3{x}_{3}^{2} \\\\  & ={x}_{1}^{2}+2{x}_{2}^{2}-2{x}_{2}{x}_{3}+3{x}_{3}^{2}\\end{aligned}\n$$\n\n**Method 2**\n\nTo write down a quadratic form in terms of vector components, we compute the following expression:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ax & =[\\begin{aligned}{x}_{1} & {x}_{2} & {x}_{3}\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 2 & -1 \\\\ 0 & -1 & 3\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}] \\\\  & =[\\begin{aligned}{x}_{1} & {x}_{2} & {x}_{3}\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ 2{x}_{2}-{x}_{3} \\\\ -{x}_{2}+3{x}_{3}\\end{aligned}] \\\\  & ={x}_{1}({x}_{1})+{x}_{2}(2{x}_{2}-{x}_{3})+{x}_{3}(-{x}_{2}+3{x}_{3}) \\\\  & ={x}_{1}^{2}+2{x}_{2}^{2}-{x}_{2}{x}_{3}-{x}_{3}{x}_{2}+3{x}_{3}^{2} \\\\  & ={x}_{1}^{2}+2{x}_{2}^{2}-2{x}_{2}{x}_{3}+3{x}_{3}^{2}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186357660 #edb/ref 1068 #edb/ref 17592186357165 #edb/ref 17592186045417] [17592186357660 #edb/ref 1069 "q-94115" #edb/ref 17592186045417] [17592186357660 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186357660 #edb/ref 1071 "$$\n[\\begin{aligned}3 & b \\\\ b & c\\end{aligned}]\n$$\n\nThe matrix of the quadratic form $Q(x)=3{x}_{1}^{2}+2{x}_{1}{x}_{2}-2{x}_{2}^{2}\\,$ is given above. What is the value of $b+c?$" #edb/ref 17592186045417] [17592186357660 #edb/ref 1072 #uuid "6a58c19a-d8e2-5b8b-a8c1-6d0a7f511f7e" #edb/ref 17592186045417] [17592186357660 #edb/ref 1074 "Since the matrix of the quadratic form must be symmetric, we rewrite our expression as follows:\n\n$$\n\\begin{aligned}Q(x) & =3{x}_{1}^{2}+2{x}_{1}{x}_{2}-2{x}_{2}^{2} \\\\  & =3{x}_{1}^{2}+1{x}_{1}{x}_{2} \\\\  & +\\,1{x}_{2}{x}_{1}+(-2){x}_{2}^{2}\\end{aligned}\n$$\n\nNotice that to get a symmetric matrix, we must split the coefficient of $2{x}_{1}{x}_{2}$ between the entries \n\n$$\n{a}_{12}={a}_{21}=\\frac{2}{2}=1\n$$\n\nof our matrix. So, the matrix corresponding to our quadratic form is\n\n$$\n[\\begin{aligned}3 & 1 \\\\ 1 & -2\\end{aligned}].\n$$\n\nTherefore, $b=1$ and $c=-2.$ Finally, \n\n$$\nb+c=1-2=-1.\n$$" #edb/ref 17592186045417] [17592186357663 #edb/ref 1068 #edb/ref 17592186357067 #edb/ref 17592186045417] [17592186357663 #edb/ref 1069 "q-94120" #edb/ref 17592186045417] [17592186357663 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186357663 #edb/ref 1071 "$$\n[\\begin{aligned}1 & 6 & b \\\\ 6 & a & 0 \\\\ b & 0 & c\\end{aligned}]\n$$\n\nThe matrix of the quadratic form $Q(x)={x}_{1}^{2}+12{x}_{1}{x}_{2}-4{x}_{1}{x}_{3}+{x}_{2}^{2}$ is given above. What is the value of $a+b+c?$" #edb/ref 17592186045417] [17592186357663 #edb/ref 1072 #uuid "b751a90c-cbe5-589a-aef5-36f0a41388ac" #edb/ref 17592186045417] [17592186357663 #edb/ref 1074 "Since the matrix of the quadratic form must be symmetric, we rewrite our expression as follows:\n\n$$\n\\begin{aligned}Q(x) & ={x}_{1}^{2}+12{x}_{1}{x}_{2}-4{x}_{1}{x}_{3}+{x}_{2}^{2} \\\\  & =1{x}_{1}^{2}+6{x}_{1}{x}_{2}+(-2){x}_{1}{x}_{3} \\\\  & +\\,6{x}_{2}{x}_{1}+1{x}_{2}^{2}+0{x}_{2}{x}_{3} \\\\  & +\\,(-2){x}_{3}{x}_{1}+0{x}_{3}{x}_{2}+0{x}_{3}^{2}\\end{aligned}\n$$\n\nNotice that to get a symmetric matrix, we must do the following splits:\n\n- we split the coefficient of $12{x}_{1}{x}_{2}$ between the entries ${a}_{12}={a}_{21}=\\frac{12}{2}=6,$ and\n\n- we split the coefficient of $-4{x}_{1}{x}_{3}$ between the entries ${a}_{13}={a}_{31}=\\frac{-4}{2}=-2.$\n\nSo, the matrix corresponding to our quadratic form is\n\n$$\n[\\begin{aligned}1 & 6 & -2 \\\\ 6 & 1 & 0 \\\\ -2 & 0 & 0\\end{aligned}].\n$$\n\nTherefore, $a=1,$ $b=-2,$ and $c=0.$ Finally, \n\n$$\na+b+c=1+(-2)+0=-1.\n$$" #edb/ref 17592186045417] [17592186408166 #edb/ref 10 :answer-field.type/checkbox #edb/ref 17592186045416] [17592186428874 #edb/ref 1030 1.0 #edb/ref 17592186045436] [17592186428874 #edb/ref 1032 "Initial Codex estimate from captured target-band crossing frequency. Selected account linear: 1 rises / 1 eligible passed source activities = 1.000000; nearest selected fraction = 1. Crossing activity numbers [1]; waits [1]. Separate account estimates: linear=1 (1/1). Selection: most observations, then lower weight, then account name; no averaging. Single-activity estimates included. Intervening target updates: False. Crossing frequency is the chosen practical estimate of encompassing coverage; a multi-band rise counts once. This does not interpret color steps as physical repetition units. Method: encompassing-report.md. Evidence: reference/mathacademy/encompassing-analysis-2026-10-11/frequency-fractions/linear-frequency-estimates.json, pair 3123->1849. All account evidence retained in the prepared import's selected-relationships.json." #edb/ref 17592186045436] [17592186428874 #edb/ref 1036 #edb/ref 17592186049814 #edb/ref 17592186045436] [17592186428875 #edb/ref 1030 0.5 #edb/ref 17592186045436] [17592186428875 #edb/ref 1032 "Initial Codex estimate from captured target-band crossing frequency. Selected acc