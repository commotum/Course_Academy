27 #edb/ref 17592186048257 #edb/ref 17592186045417] [17592186050426 #edb/ref 1027 #edb/ref 17592186049222 #edb/ref 17592186045417] [17592186050426 #edb/ref 1028 #edb/ref 17592186119923 #edb/ref 17592186045417] [17592186050426 #edb/ref 1028 #edb/ref 17592186119924 #edb/ref 17592186045417] [17592186050426 #edb/ref 1028 #edb/ref 17592186119925 #edb/ref 17592186045417] [17592186050426 #edb/ref 1029 #edb/ref 17592186428408 #edb/ref 17592186045436] [17592186050426 #edb/ref 1029 #edb/ref 17592186428409 #edb/ref 17592186045436] [17592186050426 #edb/ref 1029 #edb/ref 17592186428410 #edb/ref 17592186045436] [17592186050426 #edb/ref 1029 #edb/ref 17592186428411 #edb/ref 17592186045436] [17592186050426 #edb/ref 1029 #edb/ref 17592186428412 #edb/ref 17592186045436] [17592186050426 #edb/ref 1029 #edb/ref 17592186428413 #edb/ref 17592186045436] [17592186050426 #edb/ref 1029 #edb/ref 17592186428414 #edb/ref 17592186045436] [17592186050426 #edb/ref 1031 "Linear Dependence and Independence" #edb/ref 17592186045417] [17592186050426 #edb/ref 1033 1861 #edb/ref 17592186045417] [17592186050426 #edb/ref 1035 #uuid "47f4b767-dd8b-5a07-a614-8ff85185d0eb" #edb/ref 17592186045417] [17592186050527 #edb/ref 1027 #edb/ref 17592186048462 #edb/ref 17592186045417] [17592186050527 #edb/ref 1027 #edb/ref 17592186049422 #edb/ref 17592186045417] [17592186050527 #edb/ref 1027 #edb/ref 17592186050576 #edb/ref 17592186045417] [17592186050527 #edb/ref 1028 #edb/ref 17592186161965 #edb/ref 17592186045417] [17592186050527 #edb/ref 1028 #edb/ref 17592186161966 #edb/ref 17592186045417] [17592186050527 #edb/ref 1028 #edb/ref 17592186161967 #edb/ref 17592186045417] [17592186050527 #edb/ref 1028 #edb/ref 17592186161968 #edb/ref 17592186045417] [17592186050527 #edb/ref 1031 "Creating Rows or Columns Containing Zeros Using Gaussian Elimination" #edb/ref 17592186045417] [17592186050527 #edb/ref 1033 3029 #edb/ref 17592186045417] [17592186050527 #edb/ref 1035 #uuid "508ac00e-0867-53e8-a192-d981ff4bbdc2" #edb/ref 17592186045417] [17592186050996 #edb/ref 1027 #edb/ref 17592186049340 #edb/ref 17592186045417] [17592186050996 #edb/ref 1027 #edb/ref 17592186049903 #edb/ref 17592186045417] [17592186050996 #edb/ref 1028 #edb/ref 17592186124508 #edb/ref 17592186045417] [17592186050996 #edb/ref 1028 #edb/ref 17592186124509 #edb/ref 17592186045417] [17592186050996 #edb/ref 1028 #edb/ref 17592186124510 #edb/ref 17592186045417] [17592186050996 #edb/ref 1031 "The Dimension of the Null Space of a Matrix" #edb/ref 17592186045417] [17592186050996 #edb/ref 1033 1868 #edb/ref 17592186045417] [17592186050996 #edb/ref 1035 #uuid "7821b684-8118-5d42-9459-ebb20010e0ff" #edb/ref 17592186045417] [17592186119627 #edb/ref 1069 "e-4819" #edb/ref 17592186045417] [17592186119627 #edb/ref 1071 "The matrices $A$ and $B$ are given below. If $A$ is row equivalent to $B$, then find a basis of $\\textrm{Null}(A).$\n\n![](images/51/517c8b69f022d892daa4f8f48a74f6a93b12143e71f5077a046133b1b396ee9f.svg)" #edb/ref 17592186045417] [17592186119627 #edb/ref 1072 #uuid "1c4e02bb-5ec0-572e-92ba-46d16c6f03fa" #edb/ref 17592186045417] [17592186119627 #edb/ref 1074 "To find a basis of $\\textrm{Null}(A),$ we need to solve the equation $A\\mathbf{x} = \\mathbf{0}$ and express the solution as a linear combination of linearly independent vectors. Those vectors form a basis of $\\textrm{Null}(A).$\n\nSince $A\\sim B,$ the equation $A \\mathbf{x} = \\mathbf{0}$ is equivalent to the equation $B\\mathbf{x}=\\mathbf{0},$ which corresponds to the following system:\n\n$$\n\\{\\begin{aligned}{x}_{1}=0 \\\\ {x}_{2}-\\frac{1}{3}{x}_{3}+\\frac{2}{3}{x}_{4}=0\\end{aligned}\n$$\n\nSo, the general solution is $x_1=0$ and $x_2=\\dfrac{1}{3}x_3 - \\dfrac{2}{3} x_4$ where $x_3$ and $x_4$ are free variables. Therefore, if $\\mathbf{x}\\in\\textrm{Null}(A),$ then\n\n$$\n\\begin{aligned}[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3} \\\\ {x}_{4}\\end{aligned}] & =[\\begin{aligned}0 \\\\ \\frac{1}{3}{x}_{3}-\\frac{2}{3}{x}_{4} \\\\ {x}_{3} \\\\ {x}_{4}\\end{aligned}]={x}_{3}[\\begin{aligned}0 \\\\ \\frac{1}{3} \\\\ 1 \\\\ 0\\end{aligned}]+{x}_{4}[\\begin{aligned}0 \\\\ -\\frac{2}{3} \\\\ 0 \\\\ 1\\end{aligned}],\\,{x}_{3},{x}_{4}\\in R.\\end{aligned}\n$$\n\nThis implies that\n\n![](images/50/50bf947d3beddfb5be8eee27c0d77bf57f3e93204a8554ffffa1e4cc41f35956.svg)\n\nis a basis of $\\textrm{Null}(A)$ since it is a linearly independent set and its vectors generate $\\textrm{Null}(A).$" #edb/ref 17592186045417] [17592186119628 #edb/ref 1069 "e-4820" #edb/ref 17592186045417] [17592186119628 #edb/ref 1071 "Given that  ![](images/b4/b489811024ece2341b91e0b9819714a988cf31a87598601a8a1257c02129698c.svg) find a basis for $\\textrm{Null}(A).$" #edb/ref 17592186045417] [17592186119628 #edb/ref 1072 #uuid "1cbcbca0-c8b5-55c9-af93-9b9c0ba59ffb" #edb/ref 17592186045417] [17592186119628 #edb/ref 1074 "Any vector in $\\textrm{Null}(A)$ has the form\n\n![](images/94/94af7adea734ab0f38b5f8521fcf575cbc263cc1700a3144f682706711604859.svg)\n\nExpanding, we get\n\n$$\n\\begin{aligned}[\\begin{aligned}3{x}_{3}-{x}_{4} \\\\ 4{x}_{3} \\\\ {x}_{3} \\\\ {x}_{4}\\end{aligned}] & =[\\begin{aligned}3{x}_{3} \\\\ 4{x}_{3} \\\\ {x}_{3} \\\\ 0\\end{aligned}]+[\\begin{aligned}-{x}_{4} \\\\ 0 \\\\ 0 \\\\ {x}_{4}\\end{aligned}] \\\\  & ={x}_{3}[\\begin{aligned}3 \\\\ 4 \\\\ 1 \\\\ 0\\end{aligned}]+{x}_{4}[\\begin{aligned}-1 \\\\ 0 \\\\ 0 \\\\ 1\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, a basis for $\\textrm{Null}(A)$ is\n\n![](images/4a/4a8f749660a2c8b71cd9fe61c97180fd143a3c06c754e75a1dc51c14622f03a2.svg)\n\nsince it is a linearly independent set and its vectors generate $\\textrm{Null}(A).$" #edb/ref 17592186045417] [17592186119629 #edb/ref 1069 "e-4821" #edb/ref 17592186045417] [17592186119629 #edb/ref 1071 "Find a basis of the null space of the matrix ![](images/35/35651f90fba8141cafc7d513670e9903a4977a2c4bd3a8317ee7be90f4e7c493.svg)" #edb/ref 17592186045417] [17592186119629 #edb/ref 1072 #uuid "a9d2ed82-2ba5-53a6-973d-c859ea5c295f" #edb/ref 17592186045417] [17592186119629 #edb/ref 1074 "To find a basis of $\\textrm{Null}(A),$ we need to solve the equation $A\\mathbf{x} = \\mathbf{0}$ and express the solution as a linear combination of linearly independent vectors. Those vectors form a basis of $\\textrm{Null}(A).$\n\nThe given matrix is already in reduced row echelon form. So, the equation $A\\mathbf{x}=\\mathbf{0}$ corresponds to the following system:\n![](images/af/afdd7aba38057c3f4b226c63d103c83d3a76171ae8ae2a900db4c875a9c4e023.svg)\n\nHere, $x_1$ and $x_3$ are basic variables corresponding to the pivot columns ($1$st and $3$rd) and $x_2,x_4$ are free variables corresponding to the non-pivot columns. Therefore, if $\\mathbf{x} \\in \\textrm{Null}(A),$ then\n\n$$\n\\begin{aligned}[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3} \\\\ {x}_{4}\\end{aligned}] & =[\\begin{aligned}-3{x}_{2} \\\\ {x}_{2} \\\\ 4{x}_{4} \\\\ {x}_{4}\\end{aligned}] \\\\  & =[\\begin{aligned}-3{x}_{2} \\\\ {x}_{2} \\\\ 0 \\\\ 0\\end{aligned}]+[\\begin{aligned}0 \\\\ 0 \\\\ 4{x}_{4} \\\\ {x}_{4}\\end{aligned}] \\\\  & ={x}_{2}[\\begin{aligned}-3 \\\\ 1 \\\\ 0 \\\\ 0\\end{aligned}]+{x}_{4}[\\begin{aligned}0 \\\\ 0 \\\\ 4 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\nwhere $x_2,x_4\\in\\mathbb{R}.$ This implies that\n\n![](images/4d/4d430991c440bc6e0afad527930566f4c839476f8f1c4f1ee91f2f726d0ece27.svg)\n\nis a basis of $\\textrm{Null}(A)$ since it is a linearly independent set and its vectors generate $\\textrm{Null}(A).$" #edb/ref 17592186045417] [17592186119630 #edb/ref 1069 "e-4822" #edb/ref 17592186045417] [17592186119630 #edb/ref 1071 "Given the matrix ![](images/ec/ec919391ecd75553fc12f04d1cb6832c7019677ff0954eaffded42fd2cdb8cc2.svg) find a basis of $\\textrm{Null}(A).$" #edb/ref 17592186045417] [17592186119630 #edb/ref 1072 #uuid "ef3be538-d974-5371-bd5b-a7e2ef3df827" #edb/ref 17592186045417] [17592186119630 #edb/ref 1074 "First, we reduce the matrix $A$ to reduced row echelon form (RREF):\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1 & 0 & 2 \\\\ 0 & 1 & 2 \\\\ 0 & 2 & 5\\end{aligned}] & {R}_{3} & :={R}_{3}+(-2){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 2 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{3} \\\\  & ∼[\\begin{aligned}1 & 0 & 2 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{1} & :={R}_{1}+(-2){R}_{3} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\end{aligned}\n$$\n\nSo, the equation $A\\mathbf{x} = \\mathbf{0}$ is equivalent to the system\n\n$$\n\\{\\begin{aligned}{x}_{1}=0 \\\\ {x}_{2}=0 \\\\ {x}_{3}=0.\\end{aligned}\n$$\n\nThis implies that the only solution of $A\\mathbf{x}=\\mathbf{0}$ is $\\mathbf{x}=\\mathbf{0}.$ So $\\textrm{Null}(A)=\\{ \\mathbf{0} \\},$ which means that the basis of $\\textrm{Null}(A)$ is the empty set, i.e., $\\mathcal{B}=\\{\\,\\}.$" #edb/ref 17592186045417] [17592186119816 #edb/ref 1038 #edb/ref 17592186120336 #edb/ref 17592186045417] [17592186119816 #edb/ref 1038 #edb/ref 17592186120343 #edb/ref 17592186045417] [17592186119816 #edb/ref 1038 #edb/ref 17592186247224 #edb/ref 17592186045417] [17592186119816 #edb/ref 1038 #edb/ref 17592186318993 #edb/ref 17592186045417] [17592186119816 #edb/ref 1038 #edb/ref 17592186319020 #edb/ref 17592186045417] [17592186119816 #edb/ref 1038 #edb/ref 17592186345020 #edb/ref 17592186045417] [17592186119816 #edb/ref 1038 #edb/ref 17592186345021 #edb/ref 17592186045417] [17592186119816 #edb/ref 1038 #edb/ref 17592186398067 #edb/ref 17592186045417] [17592186119816 #edb/ref 1038 #edb/ref 17592186418281 #edb/ref 17592186045417] [17592186119816 #edb/ref 1038 #edb/ref 17592186433767 #edb/ref 17592186045417] [17592186119816 #edb/ref 1039 "Finding a Basis of the Null Space of a Matrix Given a Row Equivalent Matrix" #edb/ref 17592186045417] [17592186119816 #edb/ref 1041 #edb/ref 17592186119627 #edb/ref 17592186045417] [17592186119816 #edb/ref 1042 #uuid "6cba14b5-62f7-5fbe-beb1-9b1511305cc6" #edb/ref 17592186045417] [17592186119817 #edb/ref 1037 #edb