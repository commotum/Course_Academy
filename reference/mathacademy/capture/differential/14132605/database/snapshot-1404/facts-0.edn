963f-589d-532b-9286-559f68693df7" #edb/ref 17592186045417] [17592186119819 #edb/ref 1038 #edb/ref 17592186120395 #edb/ref 17592186045417] [17592186119819 #edb/ref 1038 #edb/ref 17592186120396 #edb/ref 17592186045417] [17592186119819 #edb/ref 1038 #edb/ref 17592186247226 #edb/ref 17592186045417] [17592186119819 #edb/ref 1038 #edb/ref 17592186247244 #edb/ref 17592186045417] [17592186119819 #edb/ref 1038 #edb/ref 17592186247245 #edb/ref 17592186045417] [17592186119819 #edb/ref 1038 #edb/ref 17592186345022 #edb/ref 17592186045417] [17592186119819 #edb/ref 1038 #edb/ref 17592186395825 #edb/ref 17592186045417] [17592186119819 #edb/ref 1038 #edb/ref 17592186399023 #edb/ref 17592186045417] [17592186119819 #edb/ref 1038 #edb/ref 17592186399030 #edb/ref 17592186045417] [17592186119819 #edb/ref 1038 #edb/ref 17592186418282 #edb/ref 17592186045417] [17592186119819 #edb/ref 1039 "Finding a Basis for the Null Space of a Matrix That Is Not in Reduced Row Echelon Form" #edb/ref 17592186045417] [17592186119819 #edb/ref 1041 #edb/ref 17592186119630 #edb/ref 17592186045417] [17592186119819 #edb/ref 1042 #uuid "0fd5a675-c692-505e-900b-d7500fb7c653" #edb/ref 17592186045417] [17592186120050 #edb/ref 1043 #edb/ref 17592186120690 #edb/ref 17592186045417] [17592186120050 #edb/ref 1043 #edb/ref 17592186120691 #edb/ref 17592186045417] [17592186120050 #edb/ref 1043 #edb/ref 17592186120692 #edb/ref 17592186045417] [17592186120050 #edb/ref 1043 #edb/ref 17592186120693 #edb/ref 17592186045417] [17592186120050 #edb/ref 1043 #edb/ref 17592186120694 #edb/ref 17592186045417] [17592186120050 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186120050 #edb/ref 1045 "Finding a Basis of the Null Space of a Matrix" #edb/ref 17592186045417] [17592186120050 #edb/ref 1046 #edb/ref 17592186120690 #edb/ref 17592186045417] [17592186120050 #edb/ref 1049 #edb/ref 17592186048823 #edb/ref 17592186045417] [17592186120050 #edb/ref 1050 960.0 #edb/ref 17592186045417] [17592186120050 #edb/ref 1053 #uuid "711b406b-35cb-5fdc-b1b0-d63789565aba" #edb/ref 17592186045417] [17592186120343 #edb/ref 1068 #edb/ref 17592186318666 #edb/ref 17592186045417] [17592186120343 #edb/ref 1069 "q-34522" #edb/ref 17592186045417] [17592186120343 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186120343 #edb/ref 1071 "The matrices $A$ and $B$ are given below. Given that $A$ is row equivalent to $B$, then find a basis of $\\text{Null}(A).$\n\n$$\nA=[\\begin{aligned}1 & -2 & 1 \\\\ 2 & -5 & 2 \\\\ 1 & 0 & 1\\end{aligned}],\\,B=[\\begin{aligned}1 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\n$$" #edb/ref 17592186045417] [17592186120343 #edb/ref 1072 #uuid "7788836f-aadb-5c09-b706-0eb988c022c6" #edb/ref 17592186045417] [17592186120343 #edb/ref 1074 "To find a basis of $\\text{Null}(A),$ we need to solve the equation $Ax=0$ and express the solution as a linear combination of linearly independent vectors. Those vectors form a basis of $\\text{Null}(A).$\n\nSince $A∼B,$ the equation $Ax=0$ is equivalent to the equation $Bx=0,$ which corresponds to the following system:\n\n$$\n\\{\\begin{aligned}{x}_{1}+{x}_{3}=0 \\\\ {x}_{2}=0\\end{aligned}\n$$\n\nSo, the general solution is ${x}_{1}=-{x}_{3}$ and ${x}_{2}=0,$ where ${x}_{3}$ is a free variable. Therefore, if $x\\in \\text{Null}(A),$ then\n\n$$\n[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]=[\\begin{aligned}-{x}_{3} \\\\ 0 \\\\ {x}_{3}\\end{aligned}]={x}_{3}[\\begin{aligned}-1 \\\\ 0 \\\\ 1\\end{aligned}],\\,{x}_{3}\\in R.\n$$\n\nThis implies that \n\n$$\nB=\\{[\\begin{aligned}-1 \\\\ 0 \\\\ 1\\end{aligned}]\\}\n$$\n\nis a basis of $\\text{Null}(A)$ since it is a linearly independent set and its vectors generate $\\text{Null}(A).$" #edb/ref 17592186045417] [17592186120690 #edb/ref 1058 #edb/ref 17592186120692 #edb/ref 17592186045417] [17592186120690 #edb/ref 1061 17508 #edb/ref 17592186045417] [17592186120690 #edb/ref 1062 #uuid "6cd915cb-1be5-57c4-9174-958e51421e23" #edb/ref 17592186045417] [17592186120690 #edb/ref 1063 #edb/ref 17592186121041 #edb/ref 17592186045417] [17592186120691 #edb/ref 1058 #edb/ref 17592186120694 #edb/ref 17592186045417] [17592186120691 #edb/ref 1061 17509 #edb/ref 17592186045417] [17592186120691 #edb/ref 1062 #uuid "f601bb80-6906-5220-b7c7-22b3ad93f773" #edb/ref 17592186045417] [17592186120691 #edb/ref 1063 #edb/ref 17592186119816 #edb/ref 17592186045417] [17592186120692 #edb/ref 1058 #edb/ref 17592186120693 #edb/ref 17592186045417] [17592186120692 #edb/ref 1061 17510 #edb/ref 17592186045417] [17592186120692 #edb/ref 1062 #uuid "3a4d6c4c-5b51-5273-8870-97758393eeff" #edb/ref 17592186045417] [17592186120692 #edb/ref 1063 #edb/ref 17592186119817 #edb/ref 17592186045417] [17592186120693 #edb/ref 1058 #edb/ref 17592186120691 #edb/ref 17592186045417] [17592186120693 #edb/ref 1061 17511 #edb/ref 17592186045417] [17592186120693 #edb/ref 1062 #uuid "f391ffe0-615c-5d48-86e2-243cac8338e5" #edb/ref 17592186045417] [17592186120693 #edb/ref 1063 #edb/ref 17592186119818 #edb/ref 17592186045417] [17592186120694 #edb/ref 1061 17512 #edb/ref 17592186045417] [17592186120694 #edb/ref 1062 #uuid "65f64dc2-9935-58c4-a4d2-93ee03872a6f" #edb/ref 17592186045417] [17592186120694 #edb/ref 1063 #edb/ref 17592186119819 #edb/ref 17592186045417] [17592186121041 #edb/ref 1064 "Remember that the null space $\\textrm{Null}(A)$ of a matrix $A$ consists of the solutions to the equation $A\\mathbf{x} = \\mathbf{0}.$ To find a basis of $\\textrm{Null}(A),$ we solve the equation $A\\mathbf{x} = \\mathbf{0}$ and express the solution as a linear combination of linearly independent vectors. Those vectors form a basis of $\\textrm{Null}(A).$\n\nTo illustrate, consider the matrix ![](images/70/702794c0129df672cc7c4cc65260c9bfa7e33804ea9f71bba048cf62142a0a18.svg) Computing the reduced row echelon form of $A,$ we get\n\n![](images/16/16d52c068c616e2eca149a8e81929a98c85726361d7ea2291ab314fe7567e4ce.svg)\n\nSo, the equation $A\\mathbf{x} = \\mathbf{0}$ is equivalent to the system\n\n![](images/bb/bb8743bd8eb072476af0e9e31c0215916beeeb82fc371348de1e6013b38810f8.svg)\n\nwhere $\\color{blue}x_1$ and $\\color{blue}x_2$ are basic variables (corresponding to the pivot columns) and $\\color{red}x_3$ is a free variable (corresponding to the non-pivot column).\n\nTherefore, any vector $\\mathbf{x}$ in $\\textrm{Null}(A)$ has the form\n\n![](images/6e/6e124e2c030f6cad72932d09211935b438f1189322ded40683a1f18618e35f3e.svg)\n\nSo, the set ![](images/24/2449d6abf866e2baa123e81c1d610940930c75c6b45ecf818d36c62191ef605f.svg) is a basis of $\\textrm{Null}(A)$ since it is a linearly independent set and the vector $[\\begin{aligned}0 \\\\ -1 \\\\ 1\\end{aligned}]$ generates the null space of $A.$\n\n**Note:** It might be the case that $\\textrm{Null}(A)$ for a particular matrix $A$ equals the so-called zero subspace $\\{ \\mathbf{0} \\}$ containing only the zero-vector. The basis of $\\{ \\mathbf{0} \\}$ is said to be the *empty set*, which is a set that does not contain any vectors. The empty set is denoted by $\\emptyset$ or $\\{\\,\\}.$" #edb/ref 17592186045417] [17592186121041 #edb/ref 1065 3207 #edb/ref 17592186045417] [17592186121041 #edb/ref 1066 #uuid "892648a7-3b42-5d92-9592-1a8859cc6b0c" #edb/ref 17592186045417] [17592186121041 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186246921 #edb/ref 1075 #edb/ref 17592186433732 #edb/ref 17592186045417] [17592186246921 #edb/ref 1075 #edb/ref 17592186433735 #edb/ref 17592186045417] [17592186246921 #edb/ref 1075 #edb/ref 17592186433742 #edb/ref 17592186045417] [17592186246921 #edb/ref 1075 #edb/ref 17592186433743 #edb/ref 17592186045417] [17592186246921 #edb/ref 1075 #edb/ref 17592186433753 #edb/ref 17592186045417] [17592186246921 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186246921 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186246921 #edb/ref 1078 #edb/ref 17592186433753 #edb/ref 17592186045417] [17592186246921 #edb/ref 1079 #uuid "d045bd23-b203-58ca-9409-b1fd70b89335" #edb/ref 17592186045417] [17592186247226 #edb/ref 1068 #edb/ref 17592186246921 #edb/ref 17592186045417] [17592186247226 #edb/ref 1069 "q-111509" #edb/ref 17592186045417] [17592186247226 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186247226 #edb/ref 1071 "Given the matrix $A=[\\begin{aligned}1 & 1 & 2 \\\\ 0 & 0 & -1 \\\\ -1 & -1 & 2\\end{aligned}]$, find a basis of $\\text{Null}(A).$" #edb/ref 17592186045417] [17592186247226 #edb/ref 1072 #uuid "dc0b0ced-e72a-5ee0-ae93-04a4f0845d7c" #edb/ref 17592186045417] [17592186247226 #edb/ref 1074 "First, we reduce the matrix $A$ to reduced row echelon form (RREF):\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1 & 1 & 2 \\\\ 0 & 0 & -1 \\\\ -1 & -1 & 2\\end{aligned}] & {R}_{3} & :={R}_{3}+{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & 2 \\\\ 0 & 0 & -1 \\\\ 0 & 0 & 4\\end{aligned}] & {R}_{3} & :={R}_{3}+4{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 1 & 2 \\\\ 0 & 0 & -1 \\\\ 0 & 0 & 0\\end{aligned}] & {R}_{2} & :=(-1){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 1 & 2 \\\\ 0 & 0 & 1 \\\\ 0 & 0 & 0\\end{aligned}] & {R}_{1} & :={R}_{1}+(-2){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 1 & 0 \\\\ 0 & 0 & 1 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nSo, the equation $Ax=0$ is equivalent to the system\n\n$$\n\\{\\begin{aligned}{x}_{1}+{x}_{2}=0 \\\\ {x}_{3}=0.\\end{aligned}\n$$\n\nThe general solution is ${x}_{1}=-{x}_{2}$ and ${x}_{3}=0,$ where ${x}_{2}$ is a free variable. Therefore, if $x\\in \\text{Null}(A),$ then\n\n$$\n[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]=[\\begin{aligned}-{x}_{2} \\\\ {x}_{2} \\\\ 0\\end{aligned}]={x}_{2}[\\begin{aligned}-1 \\\\ 1 \\\\ 0\\end{aligned}],\\,{x}_{2}\\in R.\n$$\n\nThis implies that \n\n$$\nB=\\{[\\begin{aligned}-1 \\\\ 1 \\\\ 0\\end{aligned}]\\}\n$$\n\nis a basis of $\\text{Null}(A)$ since it is a linearly independent set and its vectors generate $\\text{Null}(A).$" #edb/ref 17592186045417] [17592186318666 #edb/ref 1075 #edb/ref 17592186433723 #