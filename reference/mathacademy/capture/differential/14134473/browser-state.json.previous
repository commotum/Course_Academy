      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14134473/observations/step-q159276-7d5b86115587e4ec6f7f.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14134473/observations/step-q159276-7d5b86115587e4ec6f7f.png",
      "source_url": "https://mathacademy.com/tasks/14134473/topics/1930/lesson",
      "captured_at": 1791803884.317809,
      "math_academy_id": "q-159276",
      "topic_id": "1930",
      "sequence_position": null,
      "source_step": {
