      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14134473/observations/step-q159502-e3abd475c1f92713879e.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14134473/observations/step-q159502-e3abd475c1f92713879e.png",
      "source_url": "https://mathacademy.com/tasks/14134473/topics/1930/lesson",
      "captured_at": 1791803939.9030375,
      "math_academy_id": "q-159502",
      "topic_id": "1930",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q159502",
        "placement_id": null,
