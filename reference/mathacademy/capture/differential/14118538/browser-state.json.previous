    "q-128635": {
      "dom_id": "step-q128635",
      "name": "Question 1",
      "problem": "Which statement is equivalent to $(¬P∨Q)∧¬R?$",
      "worked_solution": "We distribute the conjunction over the disjunction, as follows:\n\n$$\n(¬P∨Q)∧¬R≡(¬P∧¬R)∨(Q∧¬R)\n$$",
