field/choices [{:answer/id #uuid "273e0c1d-b87b-5ff3-baa3-fadd69ca7d41" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "81.2%" :db/id #edb/ref 17592186542741} {:answer/id #uuid "b0ea3bfc-2d66-5402-8fe8-5d08e93ae3b2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "89.8%" :db/id #edb/ref 17592186543101} {:answer/id #uuid "de9c26c7-ca69-53f2-b784-e825ea875dab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "95.5%" :db/id #edb/ref 17592186543207} {:answer/id #uuid "f06b33f1-df10-5b8a-954a-74772139f2c9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "72.3%" :db/id #edb/ref 17592186543254}] :answer-field/correct {:db/id #edb/ref 17592186542741} :answer-field/id #uuid "6d8440b4-c109-51ef-8720-bdbc893ad92b" :answer-field/key "field-6" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186543359} {:answer-field/choices [{:answer/id #uuid "6871e947-be5b-5d49-8c80-28db5b0718f0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "100.0%" :db/id #edb/ref 17592186542920} {:answer/id #uuid "7aad50de-6972-531d-aed5-29f0970f12b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "98.4%" :db/id #edb/ref 17592186542965} {:answer/id #uuid "7bdae0e0-a1f8-5b40-ac08-7e3426dd255f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "95.5%" :db/id #edb/ref 17592186542970} {:answer/id #uuid "ffc22edc-362a-55f8-9bbd-d37751da4ae3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "81.2%" :db/id #edb/ref 17592186543290}] :answer-field/correct {:db/id #edb/ref 17592186542970} :answer-field/id #uuid "735358d6-2106-5eb4-bc7b-adf0cbd3ccde" :answer-field/key "field-7" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186543363} {:answer-field/choices [{:answer/id #uuid "320da214-47fa-52c0-9832-e91c6f8a636f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "the direction in feature space" :db/id #edb/ref 17592186542773} {:answer/id #uuid "95248131-6ba2-50d9-