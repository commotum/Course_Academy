#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186498652} :activity/id #uuid "8ad52170-0808-5988-b8c1-c87aa3c1fe8e" :activity/scope {:db/id #edb/ref 17592186048436 :topic/id #uuid "9f06bd65-df18-5d83-abc2-a397390391ec" :topic/math-academy-id 666} :activity/steps [{:db/id #edb/ref 17592186498621 :step/content {:db/id #edb/ref 17592186275330 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9a8b464f-a745-52e7-91ac-bd4ce713ef33" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "center: $(12,-3)$, radius: $4$" :db/id #edb/ref 17592186273722} {:answer/id #uuid "9bac1bca-1a7c-516f-8ec8-2ff395b49a60" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "center: $(12,3)$, radius: $4$" :db/id #edb/ref 17592186273735} {:answer/id #uuid "b13ca8a9-fd5e-51c8-a5cb-c5ca2dfa49f1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "center: $(3,12)$, radius: $4$" :db/id #edb/ref 17592186273919} {:answer/id #uuid "d045b16a-1d8f-5a3b-8110-8d687915aeb3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "center: $(-12,-3)$, radius: $4$" :db/id #edb/ref 17592186274203} {:answer/id #uuid "d66f36ff-0fff-5894-9d3c-b446842d10fc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "center: $(-3,12)$, radius: $4$" :db/id #edb/ref 17592186274263}] :answer-field/correct {:db/id #edb/ref 17592186273722} :answer-field/id #uuid "86fce999-c7ca-52b3-8d85-32bc2f1e7d4c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186274865}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "84046c7c-9cac-5307-98eb-a99f84787582" :question/math-academy-id "q-15468" :question/problem "Find the center and radius of the circle whose equation is ${x}^{2}-24x+{y}^{2}+6y=-137.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}-24x+{y}^{2}+6y & =-137 \\\\ ({x}^{2}-24x)+({y}^{2}+6y) & =-137 \\\\ ({x}^{2}-2\\cdot 12x+{12}^{2})+({y}^{2}+2\\cdot 3y+{3}^{2}) & =-137+{12}^{2}+{3}^{2} \\\\ ({x}^{2}-2\\cdot 12x+{12}^{2})+({y}^{2}+2\\cdot 3y+{3}^{2}) & =16\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x-12)^{2}+(y+3)^{2} & ={4}^{2} \\\\ (x-12)^{2}+(y-(-3))^{2} & ={4}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(12,-3)$ and its radius is $4.$"} :step/id #uuid "3d5581d9-2bc7-55e7-934d-b608f1dcba72" :step/next {:db/id #edb/ref 17592186498638}} {:db/id #edb/ref 17592186498638 :step/content {:db/id #edb/ref 17592186238070 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "268106be-19f1-5f82-813d-950192dc5718" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "center: $(-\\frac{3}{2},\\frac{1}{2})$, radius: $\\frac{3}{\\sqrt{2}}$" :db/id #edb/ref 17592186236063} {:answer/id #uuid "a348d55a-36a9-5af2-81e6-6f7585bd95e1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "center: $(-\\frac{9}{2},\\frac{3}{2})$, radius: $\\frac{9}{2}$" :db/id #edb/ref 17592186236841} {:answer/id #uuid "cf31be4e-0647-5297-be76-a4721eb22f2a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "center: $(\\frac{3}{2},-\\frac{1}{2})$, radius: $\\frac{3}{\\sqrt{2}}$" :db/id #edb/ref 17592186237129} {:answer/id #uuid "d9ca6f54-6773-56f6-8dd0-f043a63dc54a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "center: $(-\\frac{3}{2},\\frac{1}{2})$, radius: $\\frac{9}{2}$" :db/id #edb/ref 17592186237197} {:answer/id #uuid "fc2a1ef9-6f90-5fd1-aa22-221a29a4b907" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "center: $(-\\frac{9}{2},\\frac{3}{2})$, radius: $\\frac{3}{\\sqrt{2}}$" :db/id #edb/ref 17592186237416}] :answer-field/correct {:db/id #edb/ref 17592186236063} :answer-field/id #uuid "2e70a388-068c-5ad0-9ccf-1ecef596f218" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237503}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "072480e4-7dc0-5975-9c71-894af7eb1672" :question/math-academy-id "q-103890" :question/problem "Find the radius and center of the circle whose equation is\n${x}^{2}+{y}^{2}+3x-y-2=0.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}+3x-y-2 & =0 \\\\ ({x}^{2}+3x)+({y}^{2}-y) & =2 \\\\ ({x}^{2}+2\\cdot \\frac{3}{2}x+{(\\frac{3}{2})}^{2})+({y}^{2}-2\\cdot \\frac{1}{2}y+{(\\frac{1}{2})}^{2}) & =2+{(\\frac{3}{2})}^{2}+{(\\frac{1}{2})}^{2} \\\\ ({x}^{2}+2\\cdot \\frac{3}{2}x+{(\\frac{3}{2})}^{2})+({y}^{2}-2\\cdot \\frac{1}{2}y+{(\\frac{1}{2})}^{2}) & =\\frac{9}{2}\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}{(x+\\frac{3}{2})}^{2}+{(y-\\frac{1}{2})}^{2} & =\\frac{9}{2} \\\\ {(x-(-\\frac{3}{2}))}^{2}+{(y-\\frac{1}{2})}^{2} & ={(\\frac{3}{\\sqrt{2}})}^{2}\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(-\\frac{3}{2},\\frac{1}{2})$ and its radius is $\\frac{3}{\\sqrt{2}}.$"} :step/id #uuid "92aff4d7-765d-5976-af15-c9727f6d3cf6" :step/next {:db/id #edb/ref 17592186498644}} {:db/id #edb/ref 17592186498644 :step/content {:db/id #edb/ref 17592186498585 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a0651e04-cc61-5bcf-af3b-f91d6f9a0b0e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "center: $(\\frac{1}{4},1)$, radius: $2$" :db/id #edb/ref 17592186498158} {:answer/id #uuid "ac362cb6-492d-5473-b6dc-d32427af7ead" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "center: $(\\frac{1}{2},1)$, radius: $2$" :db/id #edb/ref 17592186498179} {:answer/id #uuid "db06cb6f-0562-5273-a873-d0e8e28fdf46" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "center: $(\\frac{1}{2},1)$, radius: $4$" :db/id #edb/ref 17592186498288} {:answer/id #uuid "ddb9f323-6fcc-523f-9e46-a8019383f7b6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "center: $(-\\frac{1}{4},-1)$, radius: $4$" :db/id #edb/ref 17592186498294} {:answer/id #uuid "f048c8b8-0deb-58cc-8917-7eb188230fc3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "center: $(-\\frac{1}{2},-1)$, radius: $2$" :db/id #edb/ref 17592186498328}] :answer-field/correct {:db/id #edb/ref 17592186498179} :answer-field/id #uuid "d763b4a3-5d4a-5059-b073-6cac4252989e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186498467}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d79c8724-85a2-50fb-b60d-a80008511394" :question/math-academy-id "q-103893" :question/problem "Find the radius and center of the circle whose equation is\n${x}^{2}+{y}^{2}-x-2y=\\frac{11}{4}.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}-x-2y & =\\frac{11}{4} \\\\ ({x}^{2}-x)+({y}^{2}-2y) & =\\frac{11}{4} \\\\ ({x}^{2}-2\\cdot \\frac{1}{2}x+{(\\frac{1}{2})}^{2})+({y}^{2}-2\\cdot y+{1}^{2}) & ={(\\frac{1}{2})}^{2}+{1}^{2}+\\frac{11}{4} \\\\ ({x}^{2}-2\\cdot \\frac{1}{2}x+{(\\frac{1}{2})}^{2})+({y}^{2}-2\\cdot y+{1}^{2}) & =4\\end{aligned}\n$$\n\nNow, we can factor the perfect square and get\n\n$$\n\\begin{aligned}{(x-\\frac{1}{2})}^{2}+{(y-1)}^{2} & ={2}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(\\frac{1}{2},1)$ and its radius is $2.$"} :step/id #uuid "a94c96ac-5dd9-50ce-ae81-f6a7d86c529f"} {:db/id #edb/ref 17592186498652 :step/content {:db/id #edb/ref 17592186498575 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27785dc6-76a3-5a5d-b8dd-d445c16c7768" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "center: $(3,3)$, radius: $2$" :db/id #edb/ref 17592186497879} {:answer/id #uuid "40c67b67-6b96-5400-842b-51fa742b9835" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "center: $(0,3)$, radius: $4$" :db/id #edb/ref 17592186497943} {:answer/id #uuid "4ace6e36-b1ef-56ec-a5a0-deceabb0e4e6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "center: $(3,0)$, radius: $49$" :db/id #edb/ref 17592186497972} {:answer/id #uuid "af981369-ab02-50f9-9b99-0a675cccf17c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "center: $(-3,0)$, radius: $7$" :db/id #edb/ref 17592186498190} {:answer/id #uuid "b012dc73-db2e-5d6d-9fda-ff683299fa06" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "center: $(0,-3)$, radius: $7$" :db/id #edb/ref 17592186498191}] :answer-field/correct {:db/id #edb/ref 17592186498190} :answer-field/id #uuid "c8afdf75-273f-54be-a69f-223bfb905f12" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186498457}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ba829ff8-bbca-5643-baef-27f89f8dddf9" :question/math-academy-id "q-5192" :question/problem "Find the center and radius of the circle whose equation is ${x}^{2}+6x+{y}^{2}=40.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+6x+{y}^{2} & =40 \\\\ ({x}^{2}+6x)+{y}^{2} & =40 \\\\ ({x}^{2}+2\\cdot 3x+{3}^{2})+{y}^{2} & =40+{3}^{2} \\\\ ({x}^{2}+2\\cdot 3x+{3}^{2})+{y}^{2} & =49\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x+3)^{2}+(y-0)^{2} & ={7}^{2} \\\\ (x-(-3))^{2}+(y-0)^{2} & ={7}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(-3,0)$ and its radius is $7.$"} :step/id #uuid "d7d088cd-f063-5b59-b6f8-dd50ed43784b" :step/next {:db/id #edb/ref 17592186498654}} {:db/id #edb/ref 17592186498654 :step/content {:db/id #edb/ref 17592186396066 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e2fe06dc-0609-5053-9367-73d7ebf2fcb3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "center: $(-2,-2)$, radius: $\\sqrt{\\frac{13}{2}}$" :db/id #edb/ref 17592186396068} {:answer/id #uuid "3f353887-7ced-5107-882a-0276e72dd462" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "center: $(-2,2)$, radius: $\\sqrt{\\frac{13}{2}}$" :db/id #edb/ref 17592186396069} {:answer/id #uuid "d0c03ddb-5aef-510c-adf3-fa2a8970e245" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "center: $(2,2)$, radius: $\\frac{13}{2}$" :db/id #edb/ref 17592186396070} {:answer/id #uuid "ef5518f9-14b3-5d56-ae49-14acc285d236" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "center: $(2,4)$, radius: $\\frac{13}{2}$" :db/id #edb/ref 17592186396071} {:answer/id #uuid "0ddf99ec-bda7-505b-b4fe-67ffc75b34aa" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "center: $(2,-2)$, radius: $\\sqrt{\\frac{13}{2}}$" :db/id #edb/ref 17592186396072}] :answer-field/correct {:db/id #edb/ref 17592186396072} :answer-field/id #uuid "8bd2771d-4f88-578f-9fd3-675729a93312" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186396067}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "0485f61e-5d32-5461-91b2-4119de37bba9" :question/math-academy-id "q-14619" :question/problem "Find the radius and center of the circle whose equation is\n$2{x}^{2}+2{y}^{2}-8x+8y+3=0.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}2{x}^{2}+2{y}^{2}-8x+8y+3 & =0 \\\\ {x}^{2}+{y}^{2}-4x+4y & =-\\frac{3}{2} \\\\ ({x}^{2}-4x)+({y}^{2}+4y) & =-\\frac{3}{2} \\\\ ({x}^{2}-2\\cdot 2x+{2}^{2})+({y}^{2}+2\\cdot 2y+{2}^{2}) & =-\\frac{3}{2}+{2}^{2}+{2}^{2} \\\\ ({x}^{2}-2\\cdot 2x+4)+({y}^{2}+2\\cdot 2x+4) & =\\frac{13}{2}\\end{aligned}\n$$\n\nNow, we can factor the perfect square and get\n\n$$\n\\begin{aligned}(x-2)^{2}+{(y+2)}^{2} & =\\frac{13}{2} \\\\ (x-2)^{2}+{(y-(-2))}^{2} & ={(\\sqrt{\\frac{13}{2}})}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(2,-2)$ and its radius is $\\sqrt{\\frac{13}{2}}.$"} :step/id #uuid "e40f1799-7ad3-5423-9bd0-1511410e546c" :step/next {:db/id #edb/ref 17592186498621}}] :activity/title "Determining Circle Properties by Completing the Square" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186497792}]}
