#{[{:db/id #edb/ref 17592186238070 :knowledge-point/_questions [{:db/id #edb/ref 17592186078391 :knowledge-point/id #uuid "98e3f3b4-8dfa-515c-90b1-09fb19d68144" :knowledge-point/title "Finding the Center and Radius of a Circle by Completing the Square with Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "268106be-19f1-5f82-813d-950192dc5718" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(-\\frac{3}{2},\\frac{1}{2})$, radius: $\\frac{3}{\\sqrt{2}}$" :db/id #edb/ref 17592186236063} {:answer/id #uuid "a348d55a-36a9-5af2-81e6-6f7585bd95e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(-\\frac{9}{2},\\frac{3}{2})$, radius: $\\frac{9}{2}$" :db/id #edb/ref 17592186236841} {:answer/id #uuid "cf31be4e-0647-5297-be76-a4721eb22f2a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(\\frac{3}{2},-\\frac{1}{2})$, radius: $\\frac{3}{\\sqrt{2}}$" :db/id #edb/ref 17592186237129} {:answer/id #uuid "d9ca6f54-6773-56f6-8dd0-f043a63dc54a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(-\\frac{3}{2},\\frac{1}{2})$, radius: $\\frac{9}{2}$" :db/id #edb/ref 17592186237197} {:answer/id #uuid "fc2a1ef9-6f90-5fd1-aa22-221a29a4b907" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(-\\frac{9}{2},\\frac{3}{2})$, radius: $\\frac{3}{\\sqrt{2}}$" :db/id #edb/ref 17592186237416}] :answer-field/correct {:answer/id #uuid "268106be-19f1-5f82-813d-950192dc5718" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(-\\frac{3}{2},\\frac{1}{2})$, radius: $\\frac{3}{\\sqrt{2}}$" :db/id #edb/ref 17592186236063} :answer-field/id #uuid "2e70a388-068c-5ad0-9ccf-1ecef596f218" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237503}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "072480e4-7dc0-5975-9c71-894af7eb1672" :question/math-academy-id "q-103890" :question/problem "Find the radius and center of the circle whose equation is\n${x}^{2}+{y}^{2}+3x-y-2=0.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}+3x-y-2 & =0 \\\\ ({x}^{2}+3x)+({y}^{2}-y) & =2 \\\\ ({x}^{2}+2\\cdot \\frac{3}{2}x+{(\\frac{3}{2})}^{2})+({y}^{2}-2\\cdot \\frac{1}{2}y+{(\\frac{1}{2})}^{2}) & =2+{(\\frac{3}{2})}^{2}+{(\\frac{1}{2})}^{2} \\\\ ({x}^{2}+2\\cdot \\frac{3}{2}x+{(\\frac{3}{2})}^{2})+({y}^{2}-2\\cdot \\frac{1}{2}y+{(\\frac{1}{2})}^{2}) & =\\frac{9}{2}\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}{(x+\\frac{3}{2})}^{2}+{(y-\\frac{1}{2})}^{2} & =\\frac{9}{2} \\\\ {(x-(-\\frac{3}{2}))}^{2}+{(y-\\frac{1}{2})}^{2} & ={(\\frac{3}{\\sqrt{2}})}^{2}\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(-\\frac{3}{2},\\frac{1}{2})$ and its radius is $\\frac{3}{\\sqrt{2}}.$"}] [{:db/id #edb/ref 17592186396066 :knowledge-point/_questions [{:db/id #edb/ref 17592186078391 :knowledge-point/id #uuid "98e3f3b4-8dfa-515c-90b1-09fb19d68144" :knowledge-point/title "Finding the Center and Radius of a Circle by Completing the Square with Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e2fe06dc-0609-5053-9367-73d7ebf2fcb3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(-2,-2)$, radius: $\\sqrt{\\frac{13}{2}}$" :db/id #edb/ref 17592186396068} {:answer/id #uuid "3f353887-7ced-5107-882a-0276e72dd462" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(-2,2)$, radius: $\\sqrt{\\frac{13}{2}}$" :db/id #edb/ref 17592186396069} {:answer/id #uuid "d0c03ddb-5aef-510c-adf3-fa2a8970e245" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(2,2)$, radius: $\\frac{13}{2}$" :db/id #edb/ref 17592186396070} {:answer/id #uuid "ef5518f9-14b3-5d56-ae49-14acc285d236" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(2,4)$, radius: $\\frac{13}{2}$" :db/id #edb/ref 17592186396071} {:answer/id #uuid "0ddf99ec-bda7-505b-b4fe-67ffc75b34aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(2,-2)$, radius: $\\sqrt{\\frac{13}{2}}$" :db/id #edb/ref 17592186396072}] :answer-field/correct {:answer/id #uuid "0ddf99ec-bda7-505b-b4fe-67ffc75b34aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(2,-2)$, radius: $\\sqrt{\\frac{13}{2}}$" :db/id #edb/ref 17592186396072} :answer-field/id #uuid "8bd2771d-4f88-578f-9fd3-675729a93312" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396067}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0485f61e-5d32-5461-91b2-4119de37bba9" :question/math-academy-id "q-14619" :question/problem "Find the radius and center of the circle whose equation is\n$2{x}^{2}+2{y}^{2}-8x+8y+3=0.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}2{x}^{2}+2{y}^{2}-8x+8y+3 & =0 \\\\ {x}^{2}+{y}^{2}-4x+4y & =-\\frac{3}{2} \\\\ ({x}^{2}-4x)+({y}^{2}+4y) & =-\\frac{3}{2} \\\\ ({x}^{2}-2\\cdot 2x+{2}^{2})+({y}^{2}+2\\cdot 2y+{2}^{2}) & =-\\frac{3}{2}+{2}^{2}+{2}^{2} \\\\ ({x}^{2}-2\\cdot 2x+4)+({y}^{2}+2\\cdot 2x+4) & =\\frac{13}{2}\\end{aligned}\n$$\n\nNow, we can factor the perfect square and get\n\n$$\n\\begin{aligned}(x-2)^{2}+{(y+2)}^{2} & =\\frac{13}{2} \\\\ (x-2)^{2}+{(y-(-2))}^{2} & ={(\\sqrt{\\frac{13}{2}})}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(2,-2)$ and its radius is $\\sqrt{\\frac{13}{2}}.$"}] [{:db/id #edb/ref 17592186275330 :knowledge-point/_questions [{:db/id #edb/ref 17592186078390 :knowledge-point/id #uuid "697f9bd8-9edf-5643-8cdb-a821b6dce09c" :knowledge-point/title "Finding the Center and Radius of a Circle by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9a8b464f-a745-52e7-91ac-bd4ce713ef33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(12,-3)$, radius: $4$" :db/id #edb/ref 17592186273722} {:answer/id #uuid "9bac1bca-1a7c-516f-8ec8-2ff395b49a60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(12,3)$, radius: $4$" :db/id #edb/ref 17592186273735} {:answer/id #uuid "b13ca8a9-fd5e-51c8-a5cb-c5ca2dfa49f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(3,12)$, radius: $4$" :db/id #edb/ref 17592186273919} {:answer/id #uuid "d045b16a-1d8f-5a3b-8110-8d687915aeb3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(-12,-3)$, radius: $4$" :db/id #edb/ref 17592186274203} {:answer/id #uuid "d66f36ff-0fff-5894-9d3c-b446842d10fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(-3,12)$, radius: $4$" :db/id #edb/ref 17592186274263}] :answer-field/correct {:answer/id #uuid "9a8b464f-a745-52e7-91ac-bd4ce713ef33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(12,-3)$, radius: $4$" :db/id #edb/ref 17592186273722} :answer-field/id #uuid "86fce999-c7ca-52b3-8d85-32bc2f1e7d4c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274865}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "84046c7c-9cac-5307-98eb-a99f84787582" :question/math-academy-id "q-15468" :question/problem "Find the center and radius of the circle whose equation is ${x}^{2}-24x+{y}^{2}+6y=-137.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}-24x+{y}^{2}+6y & =-137 \\\\ ({x}^{2}-24x)+({y}^{2}+6y) & =-137 \\\\ ({x}^{2}-2\\cdot 12x+{12}^{2})+({y}^{2}+2\\cdot 3y+{3}^{2}) & =-137+{12}^{2}+{3}^{2} \\\\ ({x}^{2}-2\\cdot 12x+{12}^{2})+({y}^{2}+2\\cdot 3y+{3}^{2}) & =16\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x-12)^{2}+(y+3)^{2} & ={4}^{2} \\\\ (x-12)^{2}+(y-(-3))^{2} & ={4}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(12,-3)$ and its radius is $4.$"}]}
