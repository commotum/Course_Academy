#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186516881} :activity/id #uuid "6f2c220d-dea6-5085-bfd4-266f1b303d4e" :activity/scope {:db/id #edb/ref 17592186050222 :topic/id #uuid "37687988-4a1b-507d-bbaa-9d93da76b9a6" :topic/math-academy-id 3849} :activity/steps [{:db/id #edb/ref 17592186516880 :step/content {:db/id #edb/ref 17592186516838 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02ea1683-3673-5e35-9072-ff3ec43edd3d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "q=9,\\,x=-4\\pm \\frac{3\\sqrt{2}}{2}" :db/id #edb/ref 17592186516119} {:answer/id #uuid "0b8dd15f-6ef6-5465-ba84-3a0eaa094c6a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "q=4,\\,x=-1\\pm \\frac{3\\sqrt{2}}{2}" :db/id #edb/ref 17592186516135} {:answer/id #uuid "b903bd14-e04d-5fe0-bd6c-e730be650761" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "q=4,\\,x=-1\\pm \\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186516497} {:answer/id #uuid "c3cfb96e-8f1f-5a2a-8263-292cf5833e90" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "q=9,\\,x=-2\\pm \\frac{3\\sqrt{2}}{4}" :db/id #edb/ref 17592186516526} {:answer/id #uuid "d197f0c1-c269-5113-87f5-a4378c002223" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "q=9,\\,x=-6\\pm \\frac{3\\sqrt{2}}{2}" :db/id #edb/ref 17592186516555}] :answer-field/correct {:db/id #edb/ref 17592186516119} :answer-field/id #uuid "53de4293-1518-51e6-b385-eaf97b7abfbb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186516684}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "b3fa1c78-fc26-501e-be9d-6a19d88c4385" :question/math-academy-id "q-112614" :question/problem "The equation $-2{x}^{2}-16x-23=0$ can be written in the form $2(x+p)^{2}=q.$ Find $q,$ and solve the equation." :question/worked-solution "First, we multiply the equation by $-1:$\n\n$$\n\\begin{aligned}(-1)\\cdot (-2{x}^{2}-16x-23) & =(-1)\\cdot 0 \\\\ 2{x}^{2}+16x+23 & =0\\end{aligned}\n$$\n\nNow we move the constant term to the right-hand side, factor the coefficient of the quadratic term, and complete the square on the left-hand side.\n\n$$\n\\begin{aligned}2{x}^{2}+16x+23 & =0 \\\\ 2{x}^{2}+16x & =-23 \\\\ 2({x}^{2}+8x) & =-23 \\\\ 2[{x}^{2}+2\\cdot 4\\cdot x+{4}^{2}-{4}^{2}] & =-23 \\\\ 2[{(x+4)}^{2}-16] & =-23\\end{aligned}\n$$\n\nNext, we expand the brackets, and write the equation in the required form:\n\n$$\n\\begin{aligned}2{(x+4)}^{2}-2\\cdot 16 & =-23 \\\\ 2{(x+4)}^{2}-32 & =-23 \\\\ 2{(x+4)}^{2} & =-23+32 \\\\ 2{(x+4)}^{2} & =9\\end{aligned}\n$$\n\nTherefore, $q=9.$ We now solve the equation using the square root method:\n\n$$\n\\begin{aligned}2{(x+4)}^{2} & =9 \\\\ {(x+4)}^{2} & =\\frac{9}{2} \\\\ \\sqrt{{(x+4)}^{2}} & =\\sqrt{\\frac{9}{2}} \\\\ |x+4| & =\\frac{3}{\\sqrt{2}} \\\\ x+4 & =\\pm \\frac{3\\sqrt{2}}{2} \\\\ x & =-4\\pm \\frac{3\\sqrt{2}}{2}\\end{aligned}\n$$"} :step/id #uuid "1440d411-5028-5239-a5b0-d36102654409"} {:db/id #edb/ref 17592186516881 :step/content {:db/id #edb/ref 17592186265780 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "92714716-5bbe-5cee-94c5-d4a5659903a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p+q=\\frac{11}{4},\\,z=\\frac{3\\pm \\sqrt{11}}{2}" :db/id #edb/ref 17592186264254} {:answer/id #uuid "a5141912-69d1-5f4a-bca0-9d7248df1949" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p+q=\\frac{15}{4},\\,z=\\frac{1\\pm \\sqrt{11}}{2}" :db/id #edb/ref 17592186264411} {:answer/id #uuid "c8fa13dc-c910-5b24-a8c9-a978ec6e8a33" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p+q=\\frac{15}{4},\\,z=\\frac{-1\\pm \\sqrt{13}}{2}" :db/id #edb/ref 17592186264761} {:answer/id #uuid "e33d3856-1005-5557-b459-f0f8f8c83489" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p+q=\\frac{13}{4},\\,z=\\frac{-1\\pm \\sqrt{13}}{2}" :db/id #edb/ref 17592186264974} {:answer/id #uuid "e3b99594-5bf2-5660-9213-d4ace307273e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p+q=\\frac{17}{4},\\,z=\\frac{-3\\pm \\sqrt{11}}{2}" :db/id #edb/ref 17592186264980}] :answer-field/correct {:db/id #edb/ref 17592186264761} :answer-field/id #uuid "b8ab3eaf-e5a0-5af1-8071-252570846a31" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265570}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e3fdc752-039f-5f05-8441-586cbafa095b" :question/math-academy-id "q-12983" :question/problem "The equation $4{z}^{2}+4z=12$ can be written in the form $(z+p)^{2}=q.$ Find $p+q,$ and solve the equation." :question/worked-solution "First, we move the constant term to the right-hand side, divide it by the coefficient of the quadratic term, and complete the square on the left-hand side.\n\n$$\n\\begin{aligned}4{z}^{2}+4z & =12 \\\\ 4({z}^{2}+z) & =12 \\\\ {z}^{2}+z & =3 \\\\ {z}^{2}+2\\cdot \\frac{1}{2}\\cdot z & =3 \\\\ {z}^{2}+2\\cdot (\\frac{1}{2})\\cdot z+{(\\frac{1}{2})}^{2}-{(\\frac{1}{2})}^{2} & =3 \\\\ {(z+\\frac{1}{2})}^{2}-{(\\frac{1}{2})}^{2} & =3\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}{(z+\\frac{1}{2})}^{2}-{(\\frac{1}{2})}^{2} & =3 \\\\ {(z+\\frac{1}{2})}^{2}-\\frac{1}{4} & =\\frac{12}{4} \\\\ {(z+\\frac{1}{2})}^{2} & =\\frac{13}{4}\\end{aligned}\n$$\n\nSo, $p=\\frac{1}{2},q=\\frac{13}{4},$ and $p+q=\\frac{15}{4}.$ \n\nNext, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}\\sqrt{{(z+\\frac{1}{2})}^{2}} & =\\sqrt{\\frac{13}{4}} \\\\ |z+\\frac{1}{2}| & =\\frac{\\sqrt{13}}{2} \\\\ z+\\frac{1}{2} & =\\pm \\frac{\\sqrt{13}}{2} \\\\ z & =-\\frac{1}{2}\\pm \\frac{\\sqrt{13}}{2} \\\\ z & =\\frac{-1\\pm \\sqrt{13}}{2}\\end{aligned}\n$$"} :step/id #uuid "1620937e-880d-5b09-853a-0f9758011091" :step/next {:db/id #edb/ref 17592186516949}} {:db/id #edb/ref 17592186516897 :step/content {:db/id #edb/ref 17592186247291 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07967e46-3d53-5076-933f-f82b5f556405" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p+q=5" :db/id #edb/ref 17592186244375} {:answer/id #uuid "401d3db9-46c6-5718-9d5d-157bd289930b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p+q=\\frac{7}{6}" :db/id #edb/ref 17592186244875} {:answer/id #uuid "ced9c051-dab3-5f30-85db-fb6e73c83a5d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p+q=\\frac{25}{6}" :db/id #edb/ref 17592186246162} {:answer/id #uuid "ee4131a8-2bd5-5dc8-8936-3564d8e553a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p+q=6" :db/id #edb/ref 17592186246419} {:answer/id #uuid "f25b295c-3860-584d-b014-b08e0d6fae63" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p+q=\\frac{7}{3}" :db/id #edb/ref 17592186246453}] :answer-field/correct {:db/id #edb/ref 17592186246419} :answer-field/id #uuid "9c061393-35f4-5189-baec-26f62e17b0dd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186246820}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "165c4c89-9a6c-555e-8270-074787fb6a50" :question/math-academy-id "q-112589" :question/problem "The equation $6{z}^{2}+10z-1=0$ can be written in the form $6(z+p)^{2}=q.$ Find $p+q.$" :question/worked-solution "First, we move the constant term to the right-hand side, factor the coefficient of the quadratic term, and complete the square on the left-hand side.\n\n$$\n\\begin{aligned}6{z}^{2}+10z-1 & =0 \\\\ 6{z}^{2}+10z & =1 \\\\ 6({z}^{2}+\\frac{5}{3}z) & =1 \\\\ 6[{z}^{2}+2\\cdot \\frac{5}{6}\\cdot z+{(\\frac{5}{6})}^{2}-{(\\frac{5}{6})}^{2}] & =1 \\\\ 6[{(z+\\frac{5}{6})}^{2}-{(\\frac{5}{6})}^{2}] & =1 \\\\ 6[{(z+\\frac{5}{6})}^{2}-\\frac{25}{36}] & =1\\end{aligned}\n$$\n\nNext, we expand the brackets, and write the equation in the required form:\n\n$$\n\\begin{aligned}6{(z+\\frac{5}{6})}^{2}-6\\cdot \\frac{25}{36} & =1 \\\\ 6{(z+\\frac{5}{6})}^{2}-\\frac{25}{6} & =1 \\\\ 6{(z+\\frac{5}{6})}^{2} & =\\frac{31}{6}\\end{aligned}\n$$\n\nTherefore, $p=\\frac{5}{6}$ and $q=\\frac{31}{6}.$ Finally,\n\n$$\np+q=\\frac{5}{6}+\\frac{31}{6}=\\frac{36}{6}=6.\n$$"} :step/id #uuid "4206b113-f5c1-5c37-935a-359976937b39" :step/next {:db/id #edb/ref 17592186516880}} {:db/id #edb/ref 17592186516904 :step/content {:db/id #edb/ref 17592186404336 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a96b493-4dc4-5e3d-affb-5104b074be81" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "q-p=14" :db/id #edb/ref 17592186404338} {:answer/id #uuid "a2847f48-b197-5c55-ac63-4e530e4e9ee9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "q-p=20" :db/id #edb/ref 17592186404339} {:answer/id #uuid "9c3d04fe-ed8a-51ec-a836-0b919705ce38" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "q-p=25" :db/id #edb/ref 17592186404340} {:answer/id #uuid "93a6ab5a-4ea6-5f88-bef2-511b7baac0ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "q-p=6" :db/id #edb/ref 17592186404341} {:answer/id #uuid "f625d56d-5576-52e1-a8c2-d2b4aa1f2141" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "q-p=15" :db/id #edb/ref 17592186404342}] :answer-field/correct {:db/id #edb/ref 17592186404339} :answer-field/id #uuid "a3a12275-0df5-56dd-8578-50b10f58f3d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186404337}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e1734459-a432-53d0-859c-83686d8f7d22" :question/math-academy-id "q-86414" :question/problem "The equation $-3{x}^{2}+36x-94=0$ can be written in the form $3(x+p)^{2}=q.$ Find $q-p.$" :question/worked-solution "First, we multiply the equation by $-1$:\n\n$$\n\\begin{aligned}(-1)\\cdot (-3{x}^{2}+36x-94) & =(-1)\\cdot 0 \\\\ 3{x}^{2}-36x+94 & =0\\end{aligned}\n$$\n\nNow, we move the constant term to the right-hand side, factor the coefficient of the quadratic term, and complete the square on the left-hand side.\n\n$$\n\\begin{aligned}3{x}^{2}-36x+94 & =0 \\\\ 3{x}^{2}-36x & =-94 \\\\ 3[{x}^{2}-12x] & =-94 \\\\ 3[{x}^{2}-2\\cdot 6x+{6}^{2}-{6}^{2}] & =-94 \\\\ 3[{(x-6)}^{2}-36] & =-94\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}3{(x-6)}^{2}-3\\cdot 36 & =-94 \\\\ 3{(x-6)}^{2}-108 & =-94 \\\\ 3{(x-6)}^{2} & =-94+108 \\\\ 3{(x-6)}^{2} & =14\\end{aligned}\n$$\n\nTherefore, $p=-6$, $q=14.$ Finally,\n\n$$\nq-p=14-(-6)=14+6=20.\n$$"} :step/id #uuid "52da9c0a-3535-5459-a1f4-e582ca345e3b" :step/next {:db/id #edb/ref 17592186516897}} {:db/id #edb/ref 17592186516949 :step/content {:db/id #edb/ref 17592186332964 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15778872-121f-5b94-8744-9a4c9cf32f4e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p=-\\frac{21}{4},\\,x=\\frac{3\\pm \\sqrt{21}}{4}" :db/id #edb/ref 17592186330121} {:answer/id #uuid "2d3dfa53-4d0c-5bb3-9a4c-bd1ad30b1391" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p=-\\frac{3}{4},\\,x=\\frac{6\\pm \\sqrt{21}}{4}" :db/id #edb/ref 17592186330350} {:answer/id #uuid "759b0a96-8ac6-5393-b1ad-e344cf880c0b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p=\\frac{21}{4},\\,x=\\frac{6\\pm \\sqrt{21}}{4}" :db/id #edb/ref 17592186331006} {:answer/id #uuid "a18fbe33-0cd3-5a4b-9fb0-3720b35c2568" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p=\\frac{3}{4},\\,x=\\frac{3\\pm \\sqrt{21}}{4}" :db/id #edb/ref 17592186331403} {:answer/id #uuid "ba870abb-664c-54e7-a9c0-fba55234163f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p=-\\frac{3}{4},\\,x=\\frac{3\\pm \\sqrt{21}}{4}" :db/id #edb/ref 17592186331596}] :answer-field/correct {:db/id #edb/ref 17592186331596} :answer-field/id #uuid "56e6e669-7eab-57c6-99be-d7d165ed2a19" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186332365}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f103c196-548b-5d1f-b943-377277db1202" :question/math-academy-id "q-60361" :question/problem "The equation $4{x}^{2}-6x-3=0$ can be written in the form $4(x+p)^{2}=q.$ Find $p,$ and solve the equation." :question/worked-solution "First, we move the constant term to the right-hand side, factor the coefficient of the quadratic term, and complete the square on the left-hand side.\n\n$$\n\\begin{aligned}4{x}^{2}-6x-3 & =0 \\\\ 4{x}^{2}-6x & =3 \\\\ 4[{x}^{2}-\\frac{3}{2}x] & =3 \\\\ 4[{x}^{2}-2\\cdot \\frac{3}{4}x+{(\\frac{3}{4})}^{2}-{(\\frac{3}{4})}^{2}] & =3 \\\\ 4[{(x-\\frac{3}{4})}^{2}-\\frac{9}{16}] & =3\\end{aligned}\n$$\n\nNext, we expand the brackets, and write the equation in the required form:\n\n$$\n\\begin{aligned}4{(x-\\frac{3}{4})}^{2}-4\\cdot \\frac{9}{16} & =3 \\\\ 4{(x-\\frac{3}{4})}^{2}-\\frac{9}{4} & =3 \\\\ 4{(x-\\frac{3}{4})}^{2} & =3+\\frac{9}{4} \\\\ 4{(x-\\frac{3}{4})}^{2} & =\\frac{21}{4}\\end{aligned}\n$$\n\nTherefore, $p=-\\frac{3}{4}.$ We now solve the equation using the square root method:\n\n$$\n\\begin{aligned}4{(x-\\frac{3}{4})}^{2} & =\\frac{21}{4} \\\\ {(x-\\frac{3}{4})}^{2} & =\\frac{21}{16} \\\\ \\sqrt{{(x-\\frac{3}{4})}^{2}} & =\\sqrt{\\frac{21}{16}} \\\\ |x-\\frac{3}{4}| & =\\sqrt{\\frac{21}{16}} \\\\ x-\\frac{3}{4} & =\\pm \\sqrt{\\frac{21}{16}} \\\\ x-\\frac{3}{4} & =\\pm \\frac{\\sqrt{21}}{4} \\\\ x & =\\frac{3}{4}\\pm \\frac{\\sqrt{21}}{4} \\\\ x & =\\frac{3\\pm \\sqrt{21}}{4}\\end{aligned}\n$$"} :step/id #uuid "b1ef3657-c6c8-5b89-902f-79ba06b73e9d" :step/next {:db/id #edb/ref 17592186516904}}] :activity/title "Solving Quadratic Equations With Leading Coefficients by Completing the Square" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186516100}]}
