[{"source" ":org/Math-Academy" "forms" [{:db/id 17592186204103 :knowledge-point/questions ["question-17d82828-3c8a-5034-bf42-fab4e2f3cbb6" "question-d8c2cd33-feb8-5850-af19-6e3631c29b25" "question-1203c4f3-0f74-5bfe-84b7-69d8fde66e20"] :db/ensure [:knowledge-point/validate]} {:db/id "question-17d82828-3c8a-5034-bf42-fab4e2f3cbb6" :question/id #uuid "17d82828-3c8a-5034-bf42-fab4e2f3cbb6" :question/math-academy-id "q-265744" :question/problem "Given the function \n\n$$\nf(w)=-3‖w{‖}^{2}-2\n$$\n\nthat maps a vector to a scalar, find ${∇}_{w}f.$" :question/worked-solution "Using the result \n\n$$\n{∇}_{w}({w}^{T}w)=2w,\n$$\n\nwe have\n\n$$\n\\begin{aligned}{∇}_{w}f & ={∇}_{w}(-3‖w{‖}^{2}-2) \\\\  & =-3\\cdot {∇}_{w}(‖w{‖}^{2})-{∇}_{w}(2) \\\\  & =-3\\cdot {∇}_{w}({w}^{T}w)-{∇}_{w}(2) \\\\  & =-3\\cdot 2w+0 \\\\  & =-6w.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c2d8ec61-54a3-524d-ac1c-f8499eaaacb1"] :db/ensure [:question/validate]} {:db/id "answer-field-c2d8ec61-54a3-524d-ac1c-f8499eaaacb1" :answer-field/id #uuid "c2d8ec61-54a3-524d-ac1c-f8499eaaacb1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2d839084-ebf5-50a1-84e8-aaab3647d2f2" :answer-field/choices ["answer-8cdc6452-7362-5379-a198-0f6e095833c0" "answer-6a10b282-678e-5e67-8c59-8dfb7a853cc4" "answer-2d839084-ebf5-50a1-84e8-aaab3647d2f2" "answer-c4904ffb-8abe-5c81-add0-ac73a2f9a0df" "answer-3cdd1bc7-4812-57f7-81c8-e65554be4222"] :db/ensure [:answer-field/validate]} {:db/id "answer-8cdc6452-7362-5379-a198-0f6e095833c0" :answer/id #uuid "8cdc6452-7362-5379-a198-0f6e095833c0" :answer/type :answer.type/math :answer/value "-3w" :db/ensure [:answer/validate]} {:db/id "answer-6a10b282-678e-5e67-8c59-8dfb7a853cc4" :answer/id #uuid "6a10b282-678e-5e67-8c59-8dfb7a853cc4" :answer/type :answer.type/math :answer/value "-3‖w‖" :db/ensure [:answer/validate]} {:db/id "answer-2d839084-ebf5-50a1-84e8-aaab3647d2f2" :answer/id #uuid "2d839084-ebf5-50a1-84e8-aaab3647d2f2" :answer/type :answer.type/math :answer/value "-6w" :db/ensure [:answer/validate]} {:db/id "answer-c4904ffb-8abe-5c81-add0-ac73a2f9a0df" :answer/id #uuid "c4904ffb-8abe-5c81-add0-ac73a2f9a0df" :answer/type :answer.type/math :answer/value "-6‖w‖" :db/ensure [:answer/validate]} {:db/id "answer-3cdd1bc7-4812-57f7-81c8-e65554be4222" :answer/id #uuid "3cdd1bc7-4812-57f7-81c8-e65554be4222" :answer/type :answer.type/math :answer/value "6w" :db/ensure [:answer/validate]} {:db/id "question-d8c2cd33-feb8-5850-af19-6e3631c29b25" :question/id #uuid "d8c2cd33-feb8-5850-af19-6e3631c29b25" :question/math-academy-id "q-265746" :question/problem "Given the function \n\n$$\nf(x,w)=3{w}^{T}x-‖w{‖}^{2}+1\n$$\n\nthat maps two vectors to a scalar, find ${∇}_{w}f.$" :question/worked-solution "Using the results \n\n$$\n{∇}_{w}({w}^{T}x)=x,\\,{∇}_{w}({w}^{T}w)=2w,\n$$\n\nwe have\n\n$$\n\\begin{aligned}{∇}_{w}f & ={∇}_{w}(3{w}^{T}x-‖w{‖}^{2}+1) \\\\  & =3\\cdot {∇}_{w}({w}^{T}x)-{∇}_{w}(‖w{‖}^{2})+{∇}_{w}(1) \\\\  & =3\\cdot {∇}_{w}({w}^{T}x)-{∇}_{w}({w}^{T}w)+{∇}_{w}(1) \\\\  & =3\\cdot x-2w+0 \\\\  & =3x-2w.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-669218e9-dbb9-5cbc-b3fc-b7445d8b9e17"] :db/ensure [:question/validate]} {:db/id "answer-field-669218e9-dbb9-5cbc-b3fc-b7445d8b9e17" :answer-field/id #uuid "669218e9-dbb9-5cbc-b3fc-b7445d8b9e17" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-303bfee8-5463-56bb-9681-e3b9d4158949" :answer-field/choices ["answer-303bfee8-5463-56bb-9681-e3b9d4158949" "answer-0a1d37be-3fa0-59b9-bd20-4310f8e5627e" "answer-d3532fcf-148d-5c02-9530-dfe46187e43d" "answer-dd3e8051-4283-52b3-93e7-0409ffbc90da" "answer-588514db-1798-58bb-9d0c-b764080a8b2c"] :db/ensure [:answer-field/validate]} {:db/id "answer-303bfee8-5463-56bb-9681-e3b9d4158949" :answer/id #uuid "303bfee8-5463-56bb-9681-e3b9d4158949" :answer/type :answer.type/math :answer/value "3x-2w" :db/ensure [:answer/validate]} {:db/id "answer-0a1d37be-3fa0-59b9-bd20-4310f8e5627e" :answer/id #uuid "0a1d37be-3fa0-59b9-bd20-4310f8e5627e" :answer/type :answer.type/math :answer/value "3x-2w+1" :db/ensure [:answer/validate]} {:db/id "answer-d3532fcf-148d-5c02-9530-dfe46187e43d" :answer/id #uuid "d3532fcf-148d-5c02-9530-dfe46187e43d" :answer/type :answer.type/math :answer/value "3x-2‖w‖" :db/ensure [:answer/validate]} {:db/id "answer-dd3e8051-4283-52b3-93e7-0409ffbc90da" :answer/id #uuid "dd3e8051-4283-52b3-93e7-0409ffbc90da" :answer/type :answer.type/math :answer/value "3x-w" :db/ensure [:answer/validate]} {:db/id "answer-588514db-1798-58bb-9d0c-b764080a8b2c" :answer/id #uuid "588514db-1798-58bb-9d0c-b764080a8b2c" :answer/type :answer.type/math :answer/value "x-w" :db/ensure [:answer/validate]} {:db/id "question-1203c4f3-0f74-5bfe-84b7-69d8fde66e20" :question/id #uuid "1203c4f3-0f74-5bfe-84b7-69d8fde66e20" :question/math-academy-id "q-275971" :question/problem "Given the function \n\n$$\nf(x,w)={w}^{T}x-4‖w{‖}^{2}-10\n$$\n\nthat maps two vectors to a scalar, find ${∇}_{w}f.$" :question/worked-solution "Using the results \n\n$$\n{∇}_{w}({w}^{T}x)=x,\\,{∇}_{w}({w}^{T}w)=2w,\n$$\n\nwe have\n\n$$\n\\begin{aligned}{∇}_{w}f & ={∇}_{w}({w}^{T}x-4‖w{‖}^{2}-10) \\\\  & ={∇}_{w}({w}^{T}x)-4\\cdot {∇}_{w}(‖w{‖}^{2})-{∇}_{w}(10) \\\\  & ={∇}_{w}({w}^{T}x)-4\\cdot {∇}_{w}({w}^{T}w)-{∇}_{w}(10) \\\\  & =x-4\\cdot 2w+0 \\\\  & =x-8w.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-903b2b43-e629-5769-9804-0d3b19dd3c0a"] :db/ensure [:question/validate]} {:db/id "answer-field-903b2b43-e629-5769-9804-0d3b19dd3c0a" :answer-field/id #uuid "903b2b43-e629-5769-9804-0d3b19dd3c0a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6f416802-94d1-53db-9271-9cf7d10be861" :answer-field/choices ["answer-875c69ac-9961-5045-bacf-9f0ddd624bfb" "answer-ea3853c7-a0f9-5bb7-96e8-d1893cf5ebdd" "answer-6f416802-94d1-53db-9271-9cf7d10be861" "answer-aaf49d17-c14b-5bf2-80de-a0bce4d7cfc8" "answer-a078bbe8-abd5-56fe-a1a0-610f745c9255"] :db/ensure [:answer-field/validate]} {:db/id "answer-875c69ac-9961-5045-bacf-9f0ddd624bfb" :answer/id #uuid "875c69ac-9961-5045-bacf-9f0ddd624bfb" :answer/type :answer.type/math :answer/value "x-4w" :db/ensure [:answer/validate]} {:db/id "answer-ea3853c7-a0f9-5bb7-96e8-d1893cf5ebdd" :answer/id #uuid "ea3853c7-a0f9-5bb7-96e8-d1893cf5ebdd" :answer/type :answer.type/math :answer/value "x-4‖w‖" :db/ensure [:answer/validate]} {:db/id "answer-6f416802-94d1-53db-9271-9cf7d10be861" :answer/id #uuid "6f416802-94d1-53db-9271-9cf7d10be861" :answer/type :answer.type/math :answer/value "x-8w" :db/ensure [:answer/validate]} {:db/id "answer-aaf49d17-c14b-5bf2-80de-a0bce4d7cfc8" :answer/id #uuid "aaf49d17-c14b-5bf2-80de-a0bce4d7cfc8" :answer/type :answer.type/math :answer/value "x-8w-10" :db/ensure [:answer/validate]} {:db/id "answer-a078bbe8-abd5-56fe-a1a0-610f745c9255" :answer/id #uuid "a078bbe8-abd5-56fe-a1a0-610f745c9255" :answer/type :answer.type/math :answer/value "x-8‖w‖" :db/ensure [:answer/validate]} {:db/id 17592186204104 :knowledge-point/questions ["question-3cb041fc-343a-591c-abe2-c70938440309" "question-7dc41e95-539c-50b9-8fb0-b63764e8684c"] :db/ensure [:knowledge-point/validate]} {:db/id "question-3cb041fc-343a-591c-abe2-c70938440309" :question/id #uuid "3cb041fc-343a-591c-abe2-c70938440309" :question/math-academy-id "q-275973" :question/problem "Given the function \n\n$$\nf(w)=‖w{‖}_{1}-{w}^{T}w\n$$\n\nthat maps a vector to a scalar, find ${∇}_{w}f.$ You may assume that $w$ has all nonzero components." :question/worked-solution "Using the results\n\n$$\n{∇}_{w}(‖w{‖}_{1})=\\text{sign}(w),\\,{∇}_{w}({w}^{T}w)=2w,\n$$\n\n we have\n\n$$\n\\begin{aligned}{∇}_{w}f & ={∇}_{w}(‖w{‖}_{1}-{w}^{T}w) \\\\  & ={∇}_{w}(‖w{‖}_{1})-{∇}_{w}({w}^{T}w) \\\\  & =\\text{sign}(w)-2w.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-069ca6b9-1065-527d-9439-6d0d2dc19a6f"] :db/ensure [:question/validate]} {:db/id "answer-field-069ca6b9-1065-527d-9439-6d0d2dc19a6f" :answer-field/id #uuid "069ca6b9-1065-527d-9439-6d0d2dc19a6f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2bd2e5ee-b76f-520f-84c9-af1e8bcd6860" :answer-field/choices ["answer-6ee0c7f8-2f47-540f-b5d4-0d2509ab1dfe" "answer-2bd2e5ee-b76f-520f-84c9-af1e8bcd6860" "answer-25c2a063-df9f-56e6-b378-7e460f0097d8" "answer-f52f1330-56f8-57f5-9aec-bd2be7bf70d2" "answer-854198e2-9a62-52ea-bf0c-45c3e1e8db91"] :db/ensure [:answer-field/validate]} {:db/id "answer-6ee0c7f8-2f47-540f-b5d4-0d2509ab1dfe" :answer/id #uuid "6ee0c7f8-2f47-540f-b5d4-0d2509ab1dfe" :answer/type :answer.type/math :answer/value "2\\,\\text{sign}(w)-w" :db/ensure [:answer/validate]} {:db/id "answer-2bd2e5ee-b76f-520f-84c9-af1e8bcd6860" :answer/id #uuid "2bd2e5ee-b76f-520f-84c9-af1e8bcd6860" :answer/type :answer.type/math :answer/value "\\text{sign}(w)-2w" :db/ensure [:answer/validate]} {:db/id "answer-25c2a063-df9f-56e6-b378-7e460f0097d8" :answer/id #uuid "25c2a063-df9f-56e6-b378-7e460f0097d8" :answer/type :answer.type/math :answer/value "\\text{sign}(w)-2‖w‖" :db/ensure [:answer/validate]} {:db/id "answer-f52f1330-56f8-57f5-9aec-bd2be7bf70d2" :answer/id #uuid "f52f1330-56f8-57f5-9aec-bd2be7bf70d2" :answer/type :answer.type/math :answer/value "\\text{sign}(w)-w" :db/ensure [:answer/validate]} {:db/id "answer-854198e2-9a62-52ea-bf0c-45c3e1e8db91" :answer/id #uuid "854198e2-9a62-52ea-bf0c-45c3e1e8db91" :answer/type :answer.type/math :answer/value "‖w{‖}_{1}\\cdot \\text{sign}(w)-2w" :db/ensure [:answer/validate]} {:db/id "question-7dc41e95-539c-50b9-8fb0-b63764e8684c" :question/id #uuid "7dc41e95-539c-50b9-8fb0-b63764e8684c" :question/math-academy-id "q-275978" :question/problem "Given the function \n\n$$\nf(x,w)={(‖w{‖}_{1})}^{3}-4{x}^{T}w\n$$\n\nthat maps a vector to a scalar, find ${∇}_{w}f.$ You may assume that $w$ has no zero components." :question/worked-solution "Using the results\n\n$$\n{∇}_{w}(‖w{‖}_{1})=\\text{sign}(w),\\,{∇}_{w}({x}^{T}w)=x,\n$$\n\n we have\n\n$$\n\\begin{aligned}{∇}_{w}f & ={∇}_{w}({(‖w{‖}_{1})}^{3}-4{x}^{T}w) \\\\  & ={∇}_{w}({(‖w{‖}_{1})}^{3})-{∇}_{w}(4{x}^{T}w) \\\\  & ={∇}_{w}({(‖w{‖}_{1})}^{3})-4\\cdot {∇}_{w}({x}^{T}w) \\\\  & =3(‖w{‖}_{1})^{2}\\cdot {∇}_{w}(‖w{‖}_{1})-4\\cdot x \\\\  & =3(‖w{‖}_{1})^{2}\\cdot \\text{sign}(w)-4\\cdot x \\\\  & =3(‖w{‖}_{1})^{2}\\cdot \\text{sign}(w)-4x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-e5042304-8241-5082-82cb-26bee7d6fc07"] :db/ensure [:question/validate]} {:db/id "answer-field-e5042304-8241-5082-82cb-26bee7d6fc07" :answer-field/id #uuid "e5042304-8241-5082-82cb-26bee7d6fc07" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bd827637-7b44-5716-8016-3b379e1ce6d6" :answer-field/choices ["answer-ca5a0474-5015-51cb-829b-d6477c15697d" "answer-e7e63be3-9e49-5062-b7d5-c7b2c1a4ae27" "answer-bd827637-7b44-5716-8016-3b379e1ce6d6" "answer-9fb156c9-d84f-5baa-add4-3f456c7cf40a" "answer-b5ef1186-89a0-5fdf-84b4-0d9057dc9b7d"] :db/ensure [:answer-field/validate]} {:db/id "answer-ca5a0474-5015-51cb-829b-d6477c15697d" :answer/id #uuid "ca5a0474-5015-51cb-829b-d6477c15697d" :answer/type :answer.type/math :answer/value "(‖w{‖}_{1})^{2}\\cdot \\text{sign}(w)-4x" :db/ensure [:answer/validate]} {:db/id "answer-e7e63be3-9e49-5062-b7d5-c7b2c1a4ae27" :answer/id #uuid "e7e63be3-9e49-5062-b7d5-c7b2c1a4ae27" :answer/type :answer.type/math :answer/value "3(‖w{‖}_{1})^{2}\\cdot \\text{sign}(w)-4w" :db/ensure [:answer/validate]} {:db/id "answer-bd827637-7b44-5716-8016-3b379e1ce6d6" :answer/id #uuid "bd827637-7b44-5716-8016-3b379e1ce6d6" :answer/type :answer.type/math :answer/value "3(‖w{‖}_{1})^{2}\\cdot \\text{sign}(w)-4x" :db/en