mo>=</mo><mn>0</mn></mtd></mtr><mtr><mtd><mn>3</mn><mo stretchy=\"false\">(</mo><mi>k</mi><mo>+</mo><mn>2</mn><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><mi>k</mi><mo>−</mo><mn>1</mn><mo stretchy=\"false\">)</mo></mtd><mtd><mi></mi><mo>=</mo><mn>0</mn></mtd></mtr><mtr><mtd><mi>k</mi></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mn>2</mn><mo>,</mo><mn>1.</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
