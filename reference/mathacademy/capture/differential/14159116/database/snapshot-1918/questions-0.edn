#{[{:db/id #edb/ref 17592186483378 :knowledge-point/_questions [{:db/id #edb/ref 17592186133835 :knowledge-point/id #uuid "a28c4320-e2dd-5195-81ac-b910c2328691" :knowledge-point/title "Evaluating a Repeated Integral Defined Over a Type I Region"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12c2c52e-7edb-55fd-994f-8e6f5b4d4dd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186482845} {:answer/id #uuid "15e4ed08-ffaf-52de-97e2-cfa7db153d54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186482853} {:answer/id #uuid "31357fe9-e1fa-537d-89ee-79b4cac4b7cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186482899} {:answer/id #uuid "4d8fcc2a-87cb-52dc-883a-bec15bf93188" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186482951} {:answer/id #uuid "60d03f26-4c90-5b4e-b801-3e8d67f98fb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186482981}] :answer-field/correct {:answer/id #uuid "31357fe9-e1fa-537d-89ee-79b4cac4b7cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186482899} :answer-field/id #uuid "09e3c1e0-e6e5-5167-83b3-cae11270cfdc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186483242}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "790fc9b6-72db-52a7-bf88-41ac2c2d70f6" :question/math-academy-id "q-132281" :question/problem "${\\int }_{0}^{1}{\\int }_{-\\sqrt{1-{x}^{2}}}^{\\sqrt{1-{x}^{2}}}\\text{ }x(y-1)\\,dy\\,dx=$" :question/worked-solution "The integral is defined over a type I region.\n\nFirst, we evaluate the inner integral by integrating with respect to $y$, treating $x$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{-\\sqrt{1-{x}^{2}}}^{\\sqrt{1-{x}^{2}}}\\text{ }x(y-1)\\,dy\\,dx & ={\\int }_{0}^{1}x[{\\int }_{-\\sqrt{1-{x}^{2}}}^{\\sqrt{1-{x}^{2}}}\\text{ }(y-1)\\,dy]dx \\\\  & ={\\int }_{0}^{1}x{[\\frac{1}{2}{y}^{2}-y]}_{-\\sqrt{1-{x}^{2}}}^{\\sqrt{1-{x}^{2}}}\\,dx \\\\  & ={\\int }_{0}^{1}x(\\frac{1}{2}(1-{x}^{2})-\\sqrt{1-{x}^{2}}-\\frac{1}{2}(1-{x}^{2})-\\sqrt{1-{x}^{2}})dx \\\\  & ={\\int }_{0}^{1}x(-2\\sqrt{1-{x}^{2}})dx \\\\  & ={\\int }_{0}^{1}-2x\\sqrt{1-{x}^{2}}\\,dx\\end{aligned}\n$$\n\nThen, we integrate with respect to $x:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}-2x\\sqrt{1-{x}^{2}}\\,dx & ={[\\frac{2(1-{x}^{2})^{3/2}}{3}]}_{0}^{1} \\\\  & =0-\\frac{2}{3} \\\\  & =-\\frac{2}{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186268855 :knowledge-point/_questions [{:db/id #edb/ref 17592186133835 :knowledge-point/id #uuid "a28c4320-e2dd-5195-81ac-b910c2328691" :knowledge-point/title "Evaluating a Repeated Integral Defined Over a Type I Region"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "576ddeae-8148-5d98-9276-c4916d082cfa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{\\pi }^{2}" :db/id #edb/ref 17592186266923} {:answer/id #uuid "8d3026f4-d919-504f-ae3a-79b5af8301a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}}{8}" :db/id #edb/ref 17592186267406} {:answer/id #uuid "c93138df-b030-5c7f-b21f-415d12704304" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{\\pi }^{2}" :db/id #edb/ref 17592186267948} {:answer/id #uuid "e2affe66-cebd-58ac-b5cd-9043cda4b543" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}}{4}" :db/id #edb/ref 17592186268147} {:answer/id #uuid "ed66d9ac-44b3-55cb-8a98-dbe724a419de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\pi }^{2}" :db/id #edb/ref 17592186268251}] :answer-field/correct {:answer/id #uuid "8d3026f4-d919-504f-ae3a-79b5af8301a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}}{8}" :db/id #edb/ref 17592186267406} :answer-field/id #uuid "eba13f08-f419-5a9a-9957-7c081d134163" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268816}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "63aade32-c436-5c43-9ff2-73d45e2de0f9" :question/math-academy-id "q-132282" :question/problem "${\\int }_{0}^{\\pi /4}{\\int }_{0}^{\\operatorname{sin}⁡x}\\frac{4}{\\sqrt{1-{y}^{2}}}\\,dy\\,dx=$" :question/worked-solution "The integral is defined over a type I region.\n\nFirst, we evaluate the inner integral by integrating with respect to $y$, treating $x$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /4}{\\int }_{0}^{\\operatorname{sin}⁡x}\\frac{4}{\\sqrt{1-{y}^{2}}}\\,dy\\,dx & ={\\int }_{0}^{\\pi /4}[{\\int }_{0}^{\\operatorname{sin}⁡x}\\frac{4}{\\sqrt{1-{y}^{2}}}\\,dy]dx \\\\  & ={\\int }_{0}^{\\pi /4}[4\\operatorname{arcsin}⁡y]_{0}^{\\operatorname{sin}⁡x}\\,dx \\\\  & ={\\int }_{0}^{\\pi /4}4\\operatorname{arcsin}⁡(\\operatorname{sin}⁡x)\\,dx \\\\  & ={\\int }_{0}^{\\pi /4}4x\\,dx\\end{aligned}\n$$\n\nThen, we integrate with respect to $x:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /4}4x\\,dx & ={[2{x}^{2}]}_{0}^{\\pi /4} \\\\  & =2{(\\frac{\\pi }{4})}^{2} \\\\  & =2\\cdot \\frac{{\\pi }^{2}}{16} \\\\  & =\\frac{{\\pi }^{2}}{8}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186483386 :knowledge-point/_questions [{:db/id #edb/ref 17592186133834 :knowledge-point/id #uuid "853b2770-5057-50aa-9c15-7426cf4cc6a4" :knowledge-point/title "Representing a Double Integral as a Repeated Integral When the Limits are Not Given"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f2a6974-156a-58a1-912d-d4e9e5c9106b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-2}^{1}[{\\int }_{1-{x}^{2}}^{x-1}f(x,y)\\text{ }dy]dx" :db/id #edb/ref 17592186482893} {:answer/id #uuid "2fd070a6-0119-5dfa-9699-94cd22f9107e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-2}^{1}[{\\int }_{x-1}^{1-{x}^{2}}f(x,y)\\text{ }dy]dx" :db/id #edb/ref 17592186482895} {:answer/id #uuid "69d1e9a7-9e40-528b-9934-3556f8295863" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{x-1}^{1-{x}^{2}}[{\\int }_{-2}^{1}f(x,y)\\text{ }dy]dx" :db/id #edb/ref 17592186482995} {:answer/id #uuid "90fcc974-e6d1-5c13-933d-0f0e398bfcdc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{x-1}^{1}[{\\int }_{-2}^{1-{x}^{2}}f(x,y)\\text{ }dy]dx" :db/id #edb/ref 17592186483066} {:answer/id #uuid "c039e0dd-3463-5163-9811-98a986c4da00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{1}^{1-{x}^{2}}[{\\int }_{-2}^{1-{x}^{2}}f(x,y)\\text{ }dy]dx" :db/id #edb/ref 17592186483135}] :answer-field/correct {:answer/id #uuid "2fd070a6-0119-5dfa-9699-94cd22f9107e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-2}^{1}[{\\int }_{x-1}^{1-{x}^{2}}f(x,y)\\text{ }dy]dx" :db/id #edb/ref 17592186482895} :answer-field/id #uuid "6b82a6ed-9537-5fe1-9550-c6deec72fd33" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186483278}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "888487e0-300d-510a-97fe-31196306b818" :question/math-academy-id "q-81344" :question/problem "If $D$ is the finite region enclosed by the curves $y=1-{x}^{2}$ and $y=x-1,$ then ${∬}_{D}f(x,y)\\,dA=$" :question/worked-solution "First, let's make a sketch of our region.\n\n![](images/24/24683f81da1c7e90ccbd51748f5f46407137be4a40ef5f0678292b70f0781eff.png)\n\nNow, let's represent $D$ as a type I region. \n\n- To determine the $x$-limits, we need to find the $x$-coordinates of the points at which the curves intersect. So, we set the following equation and solve it for $x:$\n\n$$\n\\begin{aligned}1-{x}^{2} & =x-1 \\\\ {x}^{2}+x-2 & =0 \\\\ (x+2)(x-1) & =0\\end{aligned}\n$$\n\nSo, $x$-limits are \n$-2\\le x\\le 1.$\n\n- To determine the lower and upper functions, we draw a vertical arrow through the region.\n\n![](images/e9/e955ad94bca70a8e6f996d81814ffa8fcc7a322d5979db7b0726d39558b6aa86.png)\n\nAs a result, we get\n\n$$\nD=\\{(x,y)\\,:\\,-2\\le x\\le 1,\\,x-1\\le y\\le 1-{x}^{2}\\}.\n$$\n\nTherefore, we can express the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}f(x,y)\\,dA & ={\\int }_{-2}^{1}{\\int }_{x-1}^{1-{x}^{2}}f(x,y)\\text{ }dy\\,dx \\\\  & ={\\int }_{-2}^{1}[{\\int }_{x-1}^{1-{x}^{2}}f(x,y)\\text{ }dy]dx\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186351295 :knowledge-point/_questions [{:db/id #edb/ref 17592186133836 :knowledge-point/id #uuid "69f6b2a7-7a3a-5c2c-90db-5aa321784048" :knowledge-point/title "Calculating a Double Integral Defined Over a Type I Region"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6ba8975f-1dcf-5982-82b5-4619f25392af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186349440} {:answer/id #uuid "909c8869-f444-52b1-8e81-f3f7d8cd7ea7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186349746} {:answer/id #uuid "9cd6c44c-c13b-51de-a23a-1e56014ae0e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{81}{2}" :db/id #edb/ref 17592186349844} {:answer/id #uuid "a3dbc989-fd06-546f-a58e-5a71b4609f5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186349910} {:answer/id #uuid "d230d5cd-76aa-5b60-afae-1d4ccdb5bb52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{41}{2}" :db/id #edb/ref 17592186350291}] :answer-field/correct {:answer/id #uuid "9cd6c44c-c13b-51de-a23a-1e56014ae0e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{81}{2}" :db/id #edb/ref 17592186349844} :answer-field/id #uuid "cef03a78-3898-53d7-a31f-076237c237e1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186351068}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bba1a6f7-479e-5c7c-a4a7-2bc8097d537b" :question/math-academy-id "q-81361" :question/problem "Calculate ${∬}_{D}3x{e}^{y}\\,dA,\\,$\nwhere $D=\\{(x,y)\\,:\\,1\\le x\\le 4,\\,0\\le y\\le \\operatorname{ln}⁡x\\}.$" :question/worked-solution "The integral is defined over the type I region $D=\\{(x,y)\\,:\\,1\\le x\\le 4,\\,0\\le y\\le \\operatorname{ln}⁡x\\}.$\n\nSo, we can express the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}3x{e}^{y}\\,dA & ={\\int }_{1}^{4}{\\int }_{0}^{\\operatorname{ln}⁡x}3x{e}^{y}\\,dy\\,dx\\end{aligned}\n$$\n\nFirst, we evaluate the inner integral by integrating with respect to $y$, treating $x$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{1}^{4}{\\int }_{0}^{\\operatorname{ln}⁡x}3x{e}^{y}\\,dy\\,dx & ={\\int }_{1}^{4}3x[{\\int }_{0}^{\\operatorname{ln}⁡x}{e}^{y}\\,dy]dx \\\\  & ={\\int }_{1}^{4}3x{[{e}^{y}]}_{0}^{\\operatorname{ln}⁡x}dx \\\\  & ={\\int }_{1}^{4}3x({e}^{\\operatorname{ln}⁡x}-{e}^{0})dx \\\\  & ={\\int }_{1}^{4}3x(x-1)dx \\\\  & ={\\int }_{1}^{4}(3{x}^{2}-3x)dx\\end{aligned}\n$$\n\nThen, we integrate with respect to $x:$\n\n$$\n\\begin{aligned}{\\int }_{1}^{4}(3{x}^{2}-3x)dx & ={[{x}^{3}-\\frac{3{x}^{2}}{2}]}_{1}^{4} \\\\  & =(64-24)-(1-\\frac{3}{2}) \\\\  & =40+\\frac{1}{2} \\\\  & =\\frac{81}{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186483407 :knowledge-point/_questions [{:db/id #edb/ref 17592186133836 :knowledge-point/id #uuid "69f6b2a7-7a3a-5c2c-90db-5aa321784048" :knowledge-point/title "Calculating a Double Integral Defined Over a Type I Region"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "158bc465-6c57-523d-9cf3-6f83f39945fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186482851} {:answer/id #uuid "1b905570-3bc1-56c6-b7bf-ad922d213480" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{16}{3}" :db/id #edb/ref 17592186482867} {:answer/id #uuid "35ff924d-fce0-5c71-95a8-6294d9e42e37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186482905} {:answer/id #uuid "6f0180ea-f116-5dcb-8c89-f5ec1242588d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186483002} {:answer/id #uuid "f32f6e2b-ace4-5f4f-b08b-21b50a871738" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186483222}] :answer-field/correct {:answer/id #uuid "35ff924d-fce0-5c71-95a8-6294d9e42e37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186482905} :answer-field/id #uuid "6d527e9c-2e5b-5948-a599-77a3b28decc4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186483280}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c45bffe5-25bf-5869-8e87-fa24cb3ec218" :question/math-academy-id "q-81369" :question/problem "Evaluate the double integral ${∬}_{D}8x{y}^{3}\\,dA,\\,$\nwhere $D$ is the finite region enclosed by the circle ${x}^{2}+{y}^{2}=1$ and below the $x$-axis." :question/worked-solution "Since $y\\le 0,$ we obtain\n\n$$\n{x}^{2}+{y}^{2}=1\\,⟹\\,y=-\\sqrt{1-{x}^{2}}.\n$$\n\nLet's make a sketch of our region.\n\n![](images/9c/9c6b1dd7d81d124888ddd588027eed908a0eaecb2c42ebc79f3253c4123dbe86.png)\n\nNotice that $D$ is a type I region.\n\n- We already know the intersection of the circle with the line $y=0.$\nSo, the $x$-limits are \n$-1\\le x\\le 1.$\n\n- To determine the lower and upper functions, we draw a vertical arrow through the region.\n\n![](images/bd/bd584d7481549b792e786a7186ba7ee87cd536258c5a0135f36ee17d96c4880d.png)\n\nAs a result, the integral is defined over the following type I region: \n\n$$\nD=\\{(x,y)\\,:\\,-1\\le x\\le 1,\\,-\\sqrt{1-{x}^{2}}\\le y\\le 0\\}\n$$\n\nSo, we can express the integral as follows:\n\n$$\n{∬}_{D}8x{y}^{3}\\,dA={\\int }_{-1}^{1}{\\int }_{-\\sqrt{1-{x}^{2}}}^{0}8x{y}^{3}\\,dy\\,dx\n$$\n\nFirst, we evaluate the inner integral by integrating with respect to $y$, treating $x$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{-1}^{1}{\\int }_{-\\sqrt{1-{x}^{2}}}^{0}8x{y}^{3}\\,dy\\,dx & ={\\int }_{-1}^{1}2x[{\\int }_{-\\sqrt{1-{x}^{2}}}^{0}4{y}^{3}\\,dy]dx \\\\  & ={\\int }_{-1}^{1}2x{[{y}^{4}]}_{-\\sqrt{1-{x}^{2}}}^{0}\\,dx \\\\  & ={\\int }_{-1}^{1}2x(0-{(-\\sqrt{1-{x}^{2}})}^{4})\\,dx \\\\  & ={\\int }_{-1}^{1}(-2x(1-{x}^{2})^{2})\\,dx\\end{aligned}\n$$\n\nThen, we integrate with respect to $x:$\n\n$$\n\\begin{aligned}{\\int }_{-1}^{1}(-2x(1-{x}^{2})^{2})\\,dx & ={[\\frac{(1-{x}^{2})^{3}}{3}]}_{-1}^{1} \\\\  & =-\\frac{(1-{1}^{2})^{3}}{3}-\\frac{(1-(-1)^{2})^{3}}{3} \\\\  & =0\\end{aligned}\n$$"}]}
