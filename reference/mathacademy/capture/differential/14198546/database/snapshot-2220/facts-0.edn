7] [17592186323285 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186323285 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186323285 #edb/ref 1078 #edb/ref 17592186322401 #edb/ref 17592186045417] [17592186323285 #edb/ref 1079 #uuid "3aeb3d56-ad05-5134-a623-f1ab028e5a1a" #edb/ref 17592186045417] [17592186323755 #edb/ref 1068 #edb/ref 17592186323187 #edb/ref 17592186045417] [17592186323755 #edb/ref 1069 "q-36111" #edb/ref 17592186045417] [17592186323755 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186323755 #edb/ref 1071 "Identify the surface ${x}^{2}+3{y}^{2}+12y-z+13=0.$" #edb/ref 17592186045417] [17592186323755 #edb/ref 1072 #uuid "76019938-2501-5ea7-9720-1dd685a8604d" #edb/ref 17592186045417] [17592186323755 #edb/ref 1074 "First, we complete the square in the $y$ term:\n\n$$\n\\begin{aligned}{x}^{2}+3{y}^{2}+12y-z+13 & =0 \\\\ {x}^{2}+3({y}^{2}+4y)-z+13 & =0 \\\\ {x}^{2}+3[(y+2)^{2}-4]-z+13 & =0 \\\\ {x}^{2}+3(y+2)^{2}-12-z+13 & =0 \\\\ {x}^{2}+3(y+2)^{2}-z+1 & =0\\end{aligned}\n$$\n\nNow, by rearranging, we get the equation\n\n$$\n\\begin{aligned}{x}^{2}+3(y+2)^{2}-z+1 & =0 \\\\ {x}^{2}+3(y+2)^{2} & =z-1.\\end{aligned}\n$$\n\nThis is the equation of an elliptic paraboloid centered at $(0,-2,1).$" #edb/ref 17592186045417] [17592186381348 #edb/ref 1068 #edb/ref 17592186381349 #edb/ref 17592186045417] [17592186381348 #edb/ref 1069 "q-164551" #edb/ref 17592186045417] [17592186381348 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186381348 #edb/ref 1071 "Identify the surface $2{x}^{2}+{y}^{2}-4{z}^{2}+4x+8z-10=0.$" #edb/ref 17592186045417] [17592186381348 #edb/ref 1072 #uuid "0ee70413-f7e5-5d0a-806c-10db20253a9c" #edb/ref 17592186045417] [17592186381348 #edb/ref 1074 "First, we complete the square in the $x$ and $z$ terms:\n\n$$\n\\begin{aligned}2{x}^{2}+{y}^{2}-4{z}^{2}+4x+8z-10 & =0 \\\\ 2({x}^{2}+2x)+{y}^{2}-4({z}^{2}-2z)-10 & =0 \\\\ 2[(x+1)^{2}-1]+{y}^{2}-4[(z-1)^{2}-1]-10 & =0 \\\\ 2(x+1)^{2}-2+{y}^{2}-4(z-1)^{2}+4-10 & =0 \\\\ 2(x+1)^{2}+{y}^{2}-4(z-1)^{2}-8 & =0\\end{aligned}\n$$\n\nNow, by rearranging, we get the equation\n\n$$\n\\begin{aligned}2(x+1)^{2}+{y}^{2}-4(z-1)^{2}-8 & =0 \\\\ 2(x+1)^{2}+{y}^{2}-4(z-1)^{2} & =8 \\\\ \\frac{(x+1)^{2}}{4}+\\frac{{y}^{2}}{8}-\\frac{(z-1)^{2}}{2} & =1.\\end{aligned}\n$$\n\nThis is the equation of a hyperboloid of one sheet centered at $(-1,0,1).$" #edb/ref 17592186045417] [17592186381349 #edb/ref 1075 #edb/ref 17592186381350 #edb/ref 17592186045417] [17592186381349 #edb/ref 1075 #edb/ref 17592186381351 #edb/ref 17592186045417] [17592186381349 #edb/ref 1075 #edb/ref 17592186381352 #edb/ref 17592186045417] [17592186381349 #edb/ref 1075 #edb/ref 17592186381353 #edb/ref 17592186045417] [17592186381349 #edb/ref 1075 #edb/ref 17592186381354 #edb/ref 17592186045417] [17592186381349 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186381349 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186381349 #edb/ref 1078 #edb/ref 17592186381350 #edb/ref 17592186045417] [17592186381349 #edb/ref 1079 #uuid "e941d950-316e-5e7e-8eb1-513344452c65" #edb/ref 17592186045417] [17592186381350 #edb/ref 1080 "A hyperboloid of one sheet centered at $(-1,0,1)$" #edb/ref 17592186045417] [17592186381350 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186381350 #edb/ref 1083 #uuid "2d4b7f14-8321-55e3-8547-b5e4dcca9e51" #edb/ref 17592186045417] [17592186381351 #edb/ref 1080 "A hyperboloid of one sheet centered at $(-1,0,-1)$" #edb/ref 17592186045417] [17592186381351 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186381351 #edb/ref 1083 #uuid "28f36501-dfe4-5bae-a8dc-97c146169521" #edb/ref 17592186045417] [17592186381352 #edb/ref 1080 "A hyperboloid of two sheet centered at $(1,0,-1)$" #edb/ref 17592186045417] [17592186381352 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186381352 #edb/ref 1083 #uuid "67877beb-bf36-58d4-8b66-f851c5c4483f" #edb/ref 