#{[{:db/id #edb/ref 17592186124831 :knowledge-point/_questions [{:db/id #edb/ref 17592186124652 :knowledge-point/id #uuid "89fbf42b-d171-5772-87ce-cf622b720963" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders With Alternative Orientations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34a585bb-74c5-510e-a245-f4082f4c3979" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cone whose axis of symmetry is the $x$-axis." :db/id #edb/ref 17592186282158} {:answer/id #uuid "44a458c1-9084-54b2-b8ff-98063908189d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet whose axis of symmetry is the $z$-axis" :db/id #edb/ref 17592186282270} {:answer/id #uuid "b1022887-6bfe-52a6-a0a8-8e1ab06354d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186283222} {:answer/id #uuid "b3c4e925-9bac-5dc9-a77e-70b58c292a9e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets whose axis of symmetry is the $z$-axis" :db/id #edb/ref 17592186283248} {:answer/id #uuid "cc208067-f320-5874-a23a-5da28c9ea960" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186283473}] :answer-field/correct {:answer/id #uuid "cc208067-f320-5874-a23a-5da28c9ea960" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186283473} :answer-field/id #uuid "d3fd279c-bf2c-5eeb-b5e8-70142503f169" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284303}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a4c96dde-6df8-575b-bdd9-f49e9283853d" :question/math-academy-id "q-164373" :question/problem "Identify the surface ${z}^{2}+{y}^{2}-{x}^{2}=1.$" :question/worked-solution "Recall that the equation of a hyperboloid of one sheet centered at $O$ whose axis of symmetry is the $z$-axis is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}-\\frac{{z}^{2}}{{c}^{2}}=-1.\n$$\n\nThus, a hyperboloid of one sheet centered at $O$ whose axis of symmetry is the $x$**-axis** is given by\n\n$$\n-\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}+\\frac{{z}^{2}}{{c}^{2}}=-1.\n$$\n\nTherefore, our equation is a hyperboloid of one sheet whose axis of symmetry is the $x$-axis and $a=b=c=1.$"}] [{:db/id #edb/ref 17592186512936 :knowledge-point/_questions [{:db/id #edb/ref 17592186124651 :knowledge-point/id #uuid "9840265f-02bf-58fa-94fd-77fb970af297" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56ef26e6-92c5-5ea5-b133-22f7b64a33e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic paraboloid" :db/id #edb/ref 17592186512296} {:answer/id #uuid "68d13e64-6b65-563f-999b-e9e60dd96c22" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid" :db/id #edb/ref 17592186512352} {:answer/id #uuid "95e635ba-07ae-51b7-9591-773690c09952" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cone" :db/id #edb/ref 17592186512452} {:answer/id #uuid "dcb21376-02e4-57eb-9eae-d7276dc0e580" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets" :db/id #edb/ref 17592186512626} {:answer/id #uuid "de32f43e-77ab-55e0-8416-a6838959b401" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet" :db/id #edb/ref 17592186512633}] :answer-field/correct {:answer/id #uuid "56ef26e6-92c5-5ea5-b133-22f7b64a33e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic paraboloid" :db/id #edb/ref 17592186512296} :answer-field/id #uuid "f79d7671-2b5b-530a-ae16-c53529846a84" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186512859}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c44a3fc0-0b84-5773-98c9-aa672df4ee82" :question/math-academy-id "q-164407" :question/problem "Identify the following surface: \n\n$$\nz=1+(x-1)^{2}+\\frac{(y-2)^{2}}{9}\n$$" :question/worked-solution "Recall that the equation of an elliptic paraboloid centered at $O$ is given by\n\n$$\nz=\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}},\n$$\n\nand an elliptic paraboloid centered at $({x}_{0},{y}_{0},{z}_{0})$ is given by\n\n$$\nz-{z}_{0}=\\frac{(x-{x}_{0})^{2}}{{a}^{2}}+\\frac{(y-{y}_{0})^{2}}{{b}^{2}},\n$$\n\nThus, our equation is an elliptic paraboloid with the following parameters:\n\n$$\n({x}_{0},{y}_{0},{z}_{0})=(1,2,1),\\,a=1,\\,b=3.\n$$"}] [{:db/id #edb/ref 17592186284500 :knowledge-point/_questions [{:db/id #edb/ref 17592186124652 :knowledge-point/id #uuid "89fbf42b-d171-5772-87ce-cf622b720963" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders With Alternative Orientations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cd6eaa8-586c-5103-b0cc-92a8aaaf1a7e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cone whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186281807} {:answer/id #uuid "2556d713-7643-5e10-b347-3ff594c56f13" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic paraboloid whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186282014} {:answer/id #uuid "2b318cd8-3045-5788-9bb8-ab1134992947" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186282069} {:answer/id #uuid "56d2cf8c-c2ea-5087-9d96-d9a6dcd9d5dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic paraboloid whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186282426} {:answer/id #uuid "eafb0571-17a8-5784-a800-513c70030f56" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186283743}] :answer-field/correct {:answer/id #uuid "2556d713-7643-5e10-b347-3ff594c56f13" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic paraboloid whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186282014} :answer-field/id #uuid "09284adb-1272-5cf4-81c3-aa20d058b0a0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186283949}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e28adc4e-c42a-55a7-ab38-db39626f07cf" :question/math-academy-id "q-164510" :question/problem "Identify the surface $x=\\frac{{y}^{2}}{2}+\\frac{{z}^{2}}{4}.$" :question/worked-solution "Recall that the equation of an elliptic paraboloid centered at $O$ whose axis of symmetry is the $z$-axis is given by\n\n$$\nz=\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}.\n$$\n\nThus, an elliptic paraboloid centered at $O$ whose axis of symmetry is the $x$**-axis** is given by\n\n$$\nx=\\frac{{y}^{2}}{{b}^{2}}+\\frac{{z}^{2}}{{c}^{2}}.\n$$\n\nTherefore, our equation is an elliptic paraboloid whose axis of symmetry is the $x$-axis and $b=\\sqrt{2},\\,c=2.$"}] [{:db/id #edb/ref 17592186381348 :knowledge-point/_questions [{:db/id #edb/ref 17592186124597 :knowledge-point/id #uuid "549870ce-a18a-5a94-a9ea-f3de72aaac1f" :knowledge-point/title "Identifying Quadric Surfaces by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d4b7f14-8321-55e3-8547-b5e4dcca9e51" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet centered at $(-1,0,1)$" :db/id #edb/ref 17592186381350} {:answer/id #uuid "28f36501-dfe4-5bae-a8dc-97c146169521" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet centered at $(-1,0,-1)$" :db/id #edb/ref 17592186381351} {:answer/id #uuid "67877beb-bf36-58d4-8b66-f851c5c4483f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of two sheet centered at $(1,0,-1)$" :db/id #edb/ref 17592186381352} {:answer/id #uuid "2bf53fd3-9386-5a4c-a79f-f3a6af4d6a45" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A ellipsoid centered at $(-1,0,1)$" :db/id #edb/ref 17592186381353} {:answer/id #uuid "0e9ad2a9-9bf4-5355-ae68-2624b7e68903" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets centered at $(-1,0,1)$" :db/id #edb/ref 17592186381354}] :answer-field/correct {:answer/id #uuid "2d4b7f14-8321-55e3-8547-b5e4dcca9e51" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet centered at $(-1,0,1)$" :db/id #edb/ref 17592186381350} :answer-field/id #uuid "e941d950-316e-5e7e-8eb1-513344452c65" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381349}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0ee70413-f7e5-5d0a-806c-10db20253a9c" :question/math-academy-id "q-164551" :question/problem "Identify the surface $2{x}^{2}+{y}^{2}-4{z}^{2}+4x+8z-10=0.$" :question/worked-solution "First, we complete the square in the $x$ and $z$ terms:\n\n$$\n\\begin{aligned}2{x}^{2}+{y}^{2}-4{z}^{2}+4x+8z-10 & =0 \\\\ 2({x}^{2}+2x)+{y}^{2}-4({z}^{2}-2z)-10 & =0 \\\\ 2[(x+1)^{2}-1]+{y}^{2}-4[(z-1)^{2}-1]-10 & =0 \\\\ 2(x+1)^{2}-2+{y}^{2}-4(z-1)^{2}+4-10 & =0 \\\\ 2(x+1)^{2}+{y}^{2}-4(z-1)^{2}-8 & =0\\end{aligned}\n$$\n\nNow, by rearranging, we get the equation\n\n$$\n\\begin{aligned}2(x+1)^{2}+{y}^{2}-4(z-1)^{2}-8 & =0 \\\\ 2(x+1)^{2}+{y}^{2}-4(z-1)^{2} & =8 \\\\ \\frac{(x+1)^{2}}{4}+\\frac{{y}^{2}}{8}-\\frac{(z-1)^{2}}{2} & =1.\\end{aligned}\n$$\n\nThis is the equation of a hyperboloid of one sheet centered at $(-1,0,1).$"}] [{:db/id #edb/ref 17592186323755 :knowledge-point/_questions [{:db/id #edb/ref 17592186124597 :knowledge-point/id #uuid "549870ce-a18a-5a94-a9ea-f3de72aaac1f" :knowledge-point/title "Identifying Quadric Surfaces by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b28e9b1-a006-5803-ab0b-9ba3ba019bd9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid centered at $(0,-2,1)$" :db/id #edb/ref 17592186321601} {:answer/id #uuid "5325c83c-39e2-53ea-83b5-5254ced19457" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cone centered at $(0,-2,1)$" :db/id #edb/ref 17592186321802} {:answer/id #uuid "d23a03a3-c7b0-5c4e-911b-d7b37bbb5bdf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic paraboloid centered at $(0,-2,1)$" :db/id #edb/ref 17592186322789} {:answer/id #uuid "d78d5857-c3ff-5e46-b0d0-174bb7dd79a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cone centered at $(1,-2,0)$" :db/id #edb/ref 17592186322830} {:answer/id #uuid "da030a33-c2a6-5772-8783-4eccde66ee7d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic paraboloid centered at $(1,-2,0)$" :db/id #edb/ref 17592186322854}] :answer-field/correct {:answer/id #uuid "d23a03a3-c7b0-5c4e-911b-d7b37bbb5bdf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic paraboloid centered at $(0,-2,1)$" :db/id #edb/ref 17592186322789} :answer-field/id #uuid "09f76668-5d4a-50c5-b668-d9e2e9822722" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323187}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "76019938-2501-5ea7-9720-1dd685a8604d" :question/math-academy-id "q-36111" :question/problem "Identify the surface ${x}^{2}+3{y}^{2}+12y-z+13=0.$" :question/worked-solution "First, we complete the square in the $y$ term:\n\n$$\n\\begin{aligned}{x}^{2}+3{y}^{2}+12y-z+13 & =0 \\\\ {x}^{2}+3({y}^{2}+4y)-z+13 & =0 \\\\ {x}^{2}+3[(y+2)^{2}-4]-z+13 & =0 \\\\ {x}^{2}+3(y+2)^{2}-12-z+13 & =0 \\\\ {x}^{2}+3(y+2)^{2}-z+1 & =0\\end{aligned}\n$$\n\nNow, by rearranging, we get the equation\n\n$$\n\\begin{aligned}{x}^{2}+3(y+2)^{2}-z+1 & =0 \\\\ {x}^{2}+3(y+2)^{2} & =z-1.\\end{aligned}\n$$\n\nThis is the equation of an elliptic paraboloid centered at $(0,-2,1).$"}]}
