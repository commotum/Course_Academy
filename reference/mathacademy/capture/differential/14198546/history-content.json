      "raw_html": "<div class=\"question\" id=\"question-164510\"><div class=\"questionHeader\"><span class=\"questionNumber\">4.</span><a class=\"questionKP\" href=\"/topics/1898#12560\">Identifying Quadric Surfaces and Cylinders With Alternative Orientations</a><span class=\"helpButton\" questionid=\"164510\">?</span></div><div class=\"questionText\"><p>Identify the surface $x = \\dfrac{y^2}{2} + \\dfrac{z^2}{4}.$</p>\n</div><div class=\"answerDetails\"><div class=\"questionDifficulty difficultyModerate\">M</div><span class=\"answerCreated\">Wed, Oct 14th @ 1:41 AM</span><span class=\"answerDetailsSeparator\">|</span><span class=\"timeElpased\">Elapsed: 0:37</span><span class=\"answerResult\"><span style=\"color: red;\">Incorrect</span></span></div></div>"
