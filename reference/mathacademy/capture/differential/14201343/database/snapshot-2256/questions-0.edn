#{[{:db/id #edb/ref 17592186157040 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186157434 :knowledge-point/id #uuid "38d1bdc1-006f-5efa-a4b0-380bd2d331c4" :knowledge-point/title "Computing the Manhattan Distance"}] :question/id #uuid "c19d702d-7023-5133-9911-9584a4bb3e88" :question/math-academy-id "e-16632" :question/problem "Suppose $\\mathbf a=[6,\\, -1,\\,2]^T$ and $\\mathbf b=[4,\\, -4,\\,0]^T.$ Find the Manhattan distance $d_1$ between $\\mathbf a$ and $\\mathbf b.$" :question/worked-solution "Recall that the Manhattan distance is defined as\n\n$$\nd_1(\\mathbf a,\\mathbf b) =\\|\\mathbf a-\\mathbf b\\|_1\n$$\n\nwhere for an $N$-dimensional vector $\\mathbf v,$\n\n$$\n\\|\\mathbf v\\|_1 = \\sum_{i=1}^N |v_i|.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{1}(a,b) & =‖a-b{‖}_{1} \\\\  & ={‖[\\begin{aligned}6 \\\\ -1 \\\\ 2\\end{aligned}]-[\\begin{aligned}4 \\\\ -4 \\\\ 0\\end{aligned}]‖}_{1} \\\\  & =|6-4|+|-1-(-4)|+|2-0| \\\\  & =7.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186157041 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186157435 :knowledge-point/id #uuid "5a3f27e0-ef39-5965-9fe1-d141c944ac66" :knowledge-point/title "Computing the Minkowski Distance"}] :question/id #uuid "0c580a08-5a51-516f-9ac8-ca3b0ed9984e" :question/math-academy-id "e-16633" :question/problem "Suppose $\\mathbf a=[6,\\, -3,\\, 2]^T,$ and $\\mathbf b=[7,\\, -1,\\, 1]^T,$ and $p=4.$ Find the Minkowski distance $d_p$ between $\\mathbf a$ and $\\mathbf b.$" :question/worked-solution "Recall that the Minkowski distance is defined as\n\n$$\nd_p(\\mathbf a,\\mathbf b) =\\|\\mathbf a-\\mathbf b\\|_p\n$$\n\nwhere for an $N$-dimensional vector $\\mathbf v,$\n\n$$\n\\|\\mathbf v\\|_p = \\left(\\sum_{i=1}^N |v_i|^p \\right)^{1/p}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{4}(a,b) & =‖a-b{‖}_{4} \\\\  & ={‖[\\begin{aligned}6 \\\\ -3 \\\\ 2\\end{aligned}]-[\\begin{aligned}7 \\\\ -1 \\\\ 1\\end{aligned}]‖}_{4} \\\\  & ={(|6-7{|}^{4}+|-3-(-1){|}^{4}+|2-1{|}^{4})}^{1/4} \\\\  & ={18}^{1/4} \\\\  & ≈2.060,\\end{aligned}\n$$\n\nrounded to $3$ decimal places."}] [{:db/id #edb/ref 17592186157042 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186157436 :knowledge-point/id #uuid "9c9c3102-21e9-590d-ad14-c09baba8b4cf" :knowledge-point/title "Computing the Chebyshev Distance"}] :question/id #uuid "b54dd07c-5e48-5d06-a454-c7dd907804d8" :question/math-academy-id "e-16634" :question/problem "Suppose $\\mathbf a=[-2,\\, 6,\\, -7]^T$ and $\\mathbf b=[8,\\, -9,\\, -9]^T.$ Find the Chebyshev distance $d_\\infty$ between $\\mathbf a$ and $\\mathbf b.$" :question/worked-solution "Recall that the Chebyshev distance is defined as\n\n$$\nd_\\infty(\\mathbf a,\\mathbf b) =\\|\\mathbf a-\\mathbf b\\|_\\infty\n$$\n\nwhere for an $N$-dimensional vector $\\mathbf v,$\n\n$$\n\\|\\mathbf v\\|_\\infty = \\operatorname{max}(|v_1|,|v_2|,\\ldots, |v_N|).\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{\\infty }(a,b) & =‖a-b{‖}_{\\infty } \\\\  & ={‖[\\begin{aligned}-2 \\\\ 6 \\\\ -7\\end{aligned}]-[\\begin{aligned}8 \\\\ -9 \\\\ -9\\end{aligned}]‖}_{\\infty } \\\\  & =max(|-2-8|,|6-(-9)|,|-7-(-9)|) \\\\  & =max(10,15,2) \\\\  & =15.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186157043 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186157433 :knowledge-point/id #uuid "04bdd95b-c658-5cfb-a720-246d2eaebbd7" :knowledge-point/title "Computing the Euclidean Distance"}] :question/id #uuid "25111cb4-1ff7-5514-8dd8-fab7ac30c46f" :question/math-academy-id "e-16638" :question/problem "Suppose $\\mathbf a=[7,\\, 2,\\, 4]^T$ and $\\mathbf b=[2,\\, 3,\\, 1]^T.$ Find the Euclidean distance $d_2$ between $\\mathbf a$ and $\\mathbf b.$" :question/worked-solution "Recall that the Euclidean distance is defined as\n\n$$\nd_2(\\mathbf a,\\mathbf b) =\\|\\mathbf a-\\mathbf b\\|_2\n$$\n\nwhere for an $N$-dimensional vector $\\mathbf v,$\n\n$$\n\\|\\mathbf v\\|_2 = \\sqrt{\\sum_{i=1}^N |v_i|^2}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{2}(a,b) & =‖a-b{‖}_{2} \\\\  & ={‖[\\begin{aligned}7 \\\\ 2 \\\\ 4\\end{aligned}]-[\\begin{aligned}2 \\\\ 3 \\\\ 1\\end{aligned}]‖}_{2} \\\\  & =\\sqrt{|7-2{|}^{2}+|2-3{|}^{2}+|4-1{|}^{2}} \\\\  & =\\sqrt{35} \\\\  & ≈5.916,\\end{aligned}\n$$\n\nrounded to $3$ decimal places."}] [{:db/id #edb/ref 17592186157707 :knowledge-point/_questions [{:db/id #edb/ref 17592186157436 :knowledge-point/id #uuid "9c9c3102-21e9-590d-ad14-c09baba8b4cf" :knowledge-point/title "Computing the Chebyshev Distance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9431c376-6b65-5c1c-abe5-8d53adefe289" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186517768}] :answer-field/correct {:answer/id #uuid "9431c376-6b65-5c1c-abe5-8d53adefe289" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186517768} :answer-field/id #uuid "10722ede-227b-5ba8-9712-c73b71d70464" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186154797}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "506f68f5-a23e-5a06-b8e8-1b3b16470943" :question/math-academy-id "q-254757" :question/problem "Suppose $a=[8,\\,4,\\,-3]^{T}$ and $b=[-4,\\,4,\\,-1]^{T}.$ Find the Chebyshev distance between $a$ and $b.$\n\n${d}_{\\infty }(a,b)=$\n{{field-1}}" :question/worked-solution "Recall that the Chebyshev distance is defined as\n\n$$\n{d}_{\\infty }(a,b)=‖a-b{‖}_{\\infty }\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{\\infty }=max(|{v}_{1}|,|{v}_{2}|,…,|{v}_{N}|).\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{\\infty }(a,b) & =‖a-b{‖}_{\\infty } \\\\  & ={‖[\\begin{aligned}8 \\\\ 4 \\\\ -3\\end{aligned}]-[\\begin{aligned}-4 \\\\ 4 \\\\ -1\\end{aligned}]‖}_{\\infty } \\\\  & =max(|8-(-4)|,|4-4|,|-3-(-1)|) \\\\  & =max(12,0,2) \\\\  & =12.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186518202 :knowledge-point/_questions [{:db/id #edb/ref 17592186157433 :knowledge-point/id #uuid "04bdd95b-c658-5cfb-a720-246d2eaebbd7" :knowledge-point/title "Computing the Euclidean Distance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5565d5eb-258d-5c57-abf0-b6d273e3c896" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.742" :db/id #edb/ref 17592186517649}] :answer-field/correct {:answer/id #uuid "5565d5eb-258d-5c57-abf0-b6d273e3c896" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.742" :db/id #edb/ref 17592186517649} :answer-field/id #uuid "64d75463-e711-5175-900d-bcfa3b3c7369" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186518023}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d6227e18-efad-598b-bec8-32e2a28de5a3" :question/math-academy-id "q-254842" :question/problem "Suppose $a=[-1,\\,1,\\,0]^{T}$ and $b=[2,\\,3,\\,1]^{T}.$ Find the Euclidean distance between $a$ and $b.$\n\nRounded to three decimal places, ${d}_{2}(a,b)≈$\n{{field-1}}." :question/worked-solution "Recall that the Euclidean distance is defined as\n\n$$\n{d}_{2}(a,b)=‖a-b{‖}_{2}\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{2}=\\sqrt{{\\sum }_{i=1}^{N}|{v}_{i}{|}^{2}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{2}(a,b) & =‖a-b{‖}_{2} \\\\  & ={‖[\\begin{aligned}-1 \\\\ 1 \\\\ 0\\end{aligned}]-[\\begin{aligned}2 \\\\ 3 \\\\ 1\\end{aligned}]‖}_{2} \\\\  & =\\sqrt{|-1-2{|}^{2}+|1-3{|}^{2}+|0-1{|}^{2}} \\\\  & =\\sqrt{14} \\\\  & ≈3.742.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186518180 :knowledge-point/_questions [{:db/id #edb/ref 17592186157433 :knowledge-point/id #uuid "04bdd95b-c658-5cfb-a720-246d2eaebbd7" :knowledge-point/title "Computing the Euclidean Distance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15bb2856-4f40-543e-9b23-e1e8ec158568" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.449" :db/id #edb/ref 17592186517528}] :answer-field/correct {:answer/id #uuid "15bb2856-4f40-543e-9b23-e1e8ec158568" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.449" :db/id #edb/ref 17592186517528} :answer-field/id #uuid "90f5fe7e-ef85-51aa-90be-01d6e9471ed5" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186518037}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a4985131-38a1-553b-8a59-bf4137759de2" :question/math-academy-id "q-254843" :question/problem "Suppose $a=[2,\\,1,\\,4]^{T}$ and $b=[1,\\,3,\\,5]^{T}.$ Find the Euclidean distance between $a$ and $b.$\n\nRounded to three decimal places, ${d}_{2}(a,b)≈$\n{{field-1}}." :question/worked-solution "Recall that the Euclidean distance is defined as\n\n$$\n{d}_{2}(a,b)=‖a-b{‖}_{2}\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{2}=\\sqrt{{\\sum }_{i=1}^{N}|{v}_{i}{|}^{2}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{2}(a,b) & =‖a-b{‖}_{2} \\\\  & ={‖[\\begin{aligned}2 \\\\ 1 \\\\ 4\\end{aligned}]-[\\begin{aligned}1 \\\\ 3 \\\\ 5\\end{aligned}]‖}_{2} \\\\  & =\\sqrt{|2-1{|}^{2}+|1-3{|}^{2}+|4-5{|}^{2}} \\\\  & =\\sqrt{6} \\\\  & ≈2.449.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186157708 :knowledge-point/_questions [{:db/id #edb/ref 17592186157433 :knowledge-point/id #uuid "04bdd95b-c658-5cfb-a720-246d2eaebbd7" :knowledge-point/title "Computing the Euclidean Distance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b44ec29c-504d-5803-b493-2cf59a287bf9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.606" :db/id #edb/ref 17592186517828}] :answer-field/correct {:answer/id #uuid "b44ec29c-504d-5803-b493-2cf59a287bf9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.606" :db/id #edb/ref 17592186517828} :answer-field/id #uuid "1facda3e-c64b-54a1-ae18-0f17d30b65a3" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186154798}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "638730ce-cea4-5199-9000-7e2a8da3425a" :question/math-academy-id "q-254848" :question/problem "Suppose $a=[5,\\,1]^{T}$ and $b=[3,\\,-2]^{T}.$ Find the Euclidean distance between $a$ and $b.$\n\nRounded to three decimal places, ${d}_{2}(a,b)≈$\n{{field-1}}." :question/worked-solution "Recall that the Euclidean distance is defined as\n\n$$\n{d}_{2}(a,b)=‖a-b{‖}_{2}\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{2}=\\sqrt{{\\sum }_{i=1}^{N}|{v}_{i}{|}^{2}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{2}(a,b) & =‖a-b{‖}_{2} \\\\  & ={‖[\\begin{aligned}5 \\\\ 1\\end{aligned}]-[\\begin{aligned}3 \\\\ -2\\end{aligned}]‖}_{2} \\\\  & =\\sqrt{|5-3{|}^{2}+|1-(-2){|}^{2}} \\\\  & =\\sqrt{13} \\\\  & ≈3.606.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186518140 :knowledge-point/_questions [{:db/id #edb/ref 17592186157433 :knowledge-point/id #uuid "04bdd95b-c658-5cfb-a720-246d2eaebbd7" :knowledge-point/title "Computing the Euclidean Distance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f12aa8ac-db2d-511d-a369-95db4ab320ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.243" :db/id #edb/ref 17592186517949}] :answer-field/correct {:answer/id #uuid "f12aa8ac-db2d-511d-a369-95db4ab320ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.243" :db/id #edb/ref 17592186517949} :answer-field/id #uuid "de7e374a-e6ed-5411-8341-4e4bb667ce86" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186518078}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "55bdf128-1307-57a2-a09e-523ed9c58971" :question/math-academy-id "q-254851" :question/problem "Suppose $a=[2,\\,6]^{T}$ and $b=[5,\\,3]^{T}.$ Find the Euclidean distance between $a$ and $b.$\n\nRounded to three decimal places, ${d}_{2}(a,b)≈$\n{{field-1}}." :question/worked-solution "Recall that the Euclidean distance is defined as\n\n$$\n{d}_{2}(a,b)=‖a-b{‖}_{2}\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{2}=\\sqrt{{\\sum }_{i=1}^{N}|{v}_{i}{|}^{2}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{2}(a,b) & =‖a-b{‖}_{2} \\\\  & ={‖[\\begin{aligned}2 \\\\ 6\\end{aligned}]-[\\begin{aligned}5 \\\\ 3\\end{aligned}]‖}_{2} \\\\  & =\\sqrt{|2-5{|}^{2}+|6-3{|}^{2}} \\\\  & =\\sqrt{18} \\\\  & ≈4.243.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186518165 :knowledge-point/_questions [{:db/id #edb/ref 17592186157433 :knowledge-point/id #uuid "04bdd95b-c658-5cfb-a720-246d2eaebbd7" :knowledge-point/title "Computing the Euclidean Distance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d2d0f71a-5522-5969-b785-b10e460713ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8.246" :db/id #edb/ref 17592186517883}] :answer-field/correct {:answer/id #uuid "d2d0f71a-5522-5969-b785-b10e460713ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8.246" :db/id #edb/ref 17592186517883} :answer-field/id #uuid "1a4bfe98-e47c-5ff6-99b2-15d5e97e7b17" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186517977}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7c744e92-6824-57b8-b5de-89c3c18659be" :question/math-academy-id "q-254852" :question/problem "Suppose $a=[4,\\,6]^{T}$ and $b=[2,\\,-2]^{T}.$ Find the Euclidean distance between $a$ and $b.$\n\nRounded to three decimal places, ${d}_{2}(a,b)≈$\n{{field-1}}." :question/worked-solution "Recall that the Euclidean distance is defined as\n\n$$\n{d}_{2}(a,b)=‖a-b{‖}_{2}\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{2}=\\sqrt{{\\sum }_{i=1}^{N}|{v}_{i}{|}^{2}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{2}(a,b) & =‖a-b{‖}_{2} \\\\  & ={‖[\\begin{aligned}4 \\\\ 6\\end{aligned}]-[\\begin{aligned}2 \\\\ -2\\end{aligned}]‖}_{2} \\\\  & =\\sqrt{|4-2{|}^{2}+|6-(-2){|}^{2}} \\\\  & =\\sqrt{68} \\\\  & ≈8.246.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186518219 :knowledge-point/_questions [{:db/id #edb/ref 17592186157434 :knowledge-point/id #uuid "38d1bdc1-006f-5efa-a4b0-380bd2d331c4" :knowledge-point/title "Computing the Manhattan Distance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a42d1223-744c-5351-b0e1-ced50d043bb0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186517794}] :answer-field/correct {:answer/id #uuid "a42d1223-744c-5351-b0e1-ced50d043bb0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186517794} :answer-field/id #uuid "d8544c82-98cb-5137-bc05-8e0dd6402c7f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186518077}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f3e294b9-f845-51ae-87f3-5926acf855f0" :question/math-academy-id "q-254857" :question/problem "Suppose $a=[7,\\,4]^{T}$ and $b=[3,\\,-2]^{T}.$ Find the Manhattan distance between $a$ and $b.$\n\n${d}_{1}(a,b)=$\n{{field-1}}" :question/worked-solution "Recall that the Manhattan distance is defined as\n\n$$\n{d}_{1}(a,b)=‖a-b{‖}_{1}\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{1}={\\sum }_{i=1}^{N}|{v}_{i}|.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{1}(a,b) & =‖a-b{‖}_{1} \\\\  & ={‖[\\begin{aligned}7 \\\\ 4\\end{aligned}]-[\\begin{aligned}3 \\\\ -2\\end{aligned}]‖}_{1} \\\\  & =|7-3|+|4-(-2)| \\\\  & =10.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186518194 :knowledge-point/_questions [{:db/id #edb/ref 17592186157434 :knowledge-point/id #uuid "38d1bdc1-006f-5efa-a4b0-380bd2d331c4" :knowledge-point/title "Computing the Manhattan Distance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bf28e886-fe2d-5cc3-b630-2c84091f17b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186517853}] :answer-field/correct {:answer/id #uuid "bf28e886-fe2d-5cc3-b630-2c84091f17b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186517853} :answer-field/id #uuid "424205c9-fe8e-5224-a3d6-c6dc9e255ecc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186518003}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c95e267e-85b4-5649-968c-53ba871cff30" :question/math-academy-id "q-254858" :question/problem "Suppose $a=[1,\\,-5]^{T}$ and $b=[5,\\,1]^{T}.$ Find the Manhattan distance between $a$ and $b.$\n\n${d}_{1}(a,b)=$\n{{field-1}}" :question/worked-solution "Recall that the Manhattan distance is defined as\n\n$$\n{d}_{1}(a,b)=‖a-b{‖}_{1}\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{1}={\\sum }_{i=1}^{N}|{v}_{i}|.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{1}(a,b) & =‖a-b{‖}_{1} \\\\  & ={‖[\\begin{aligned}1 \\\\ -5\\end{aligned}]-[\\begin{aligned}5 \\\\ 1\\end{aligned}]‖}_{1} \\\\  & =|1-5|+|-5-1| \\\\  & =10.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186518138 :knowledge-point/_questions [{:db/id #edb/ref 17592186157434 :knowledge-point/id #uuid "38d1bdc1-006f-5efa-a4b0-380bd2d331c4" :knowledge-point/title "Computing the Manhattan Distance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86f9cffe-0437-53b4-9b46-e03c290d7e4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186517742}] :answer-field/correct {:answer/id #uuid "86f9cffe-0437-53b4-9b46-e03c290d7e4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186517742} :answer-field/id #uuid "808c45fe-82b7-5271-9482-5eb4b030372f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186518031}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5380f139-fe32-542e-ba7e-191d7abaa184" :question/math-academy-id "q-254862" :question/problem "Suppose $a=[1,\\,4,\\,-2]^{T}$ and $b=[2,\\,5,\\,3]^{T}.$ Find the Manhattan distance between $a$ and $b.$\n\n${d}_{1}(a,b)=$\n{{field-1}}" :question/worked-solution "Recall that the Manhattan distance is defined as\n\n$$\n{d}_{1}(a,b)=‖a-b{‖}_{1}\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{1}={\\sum }_{i=1}^{N}|{v}_{i}|.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{1}(a,b) & =‖a-b{‖}_{1} \\\\  & ={‖[\\begin{aligned}1 \\\\ 4 \\\\ -2\\end{aligned}]-[\\begin{aligned}2 \\\\ 5 \\\\ 3\\end{aligned}]‖}_{1} \\\\  & =|1-2|+|4-5|+|-2-3| \\\\  & =7.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186518192 :knowledge-point/_questions [{:db/id #edb/ref 17592186157434 :knowledge-point/id #uuid "38d1bdc1-006f-5efa-a4b0-380bd2d331c4" :knowledge-point/title "Computing the Manhattan Distance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eeaef794-0de7-5ce7-8a12-9497ddf3853d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186517942}] :answer-field/correct {:answer/id #uuid "eeaef794-0de7-5ce7-8a12-9497ddf3853d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186517942} :answer-field/id #uuid "1db7e5dd-95fa-58c9-add2-98949ac75558" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186517979}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c6fc9a2a-2dca-5aed-a889-2bc4c863a299" :question/math-academy-id "q-254863" :question/problem "Suppose $a=[3,\\,5,\\,1]^{T}$ and $b=[4,\\,-1,\\,6]^{T}.$ Find the Manhattan distance between $a$ and $b.$\n\n${d}_{1}(a,b)=$\n{{field-1}}" :question/worked-solution "Recall that the Manhattan distance is defined as\n\n$$\n{d}_{1}(a,b)=‖a-b{‖}_{1}\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{1}={\\sum }_{i=1}^{N}|{v}_{i}|.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{1}(a,b) & =‖a-b{‖}_{1} \\\\  & ={‖[\\begin{aligned}3 \\\\ 5 \\\\ 1\\end{aligned}]-[\\begin{aligned}4 \\\\ -1 \\\\ 6\\end{aligned}]‖}_{1} \\\\  & =|3-4|+|5-(-1)|+|1-6| \\\\  & =12.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186518171 :knowledge-point/_questions [{:db/id #edb/ref 17592186157434 :knowledge-point/id #uuid "38d1bdc1-006f-5efa-a4b0-380bd2d331c4" :knowledge-point/title "Computing the Manhattan Distance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17fbba71-b65d-5cc9-9d93-3fa361546a64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186517531}] :answer-field/correct {:answer/id #uuid "17fbba71-b65d-5cc9-9d93-3fa361546a64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186517531} :answer-field/id #uuid "cdfb46aa-95f2-5e0c-93b7-e108a22585c2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186518067}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "83af6a91-b190-50f3-bc76-025dc5091d7d" :question/math-academy-id "q-254864" :question/problem "Suppose $a=[1,\\,4,\\,-2]^{T}$ and $b=[-4,\\,-1,\\,-2]^{T}.$ Find the Manhattan distance between $a$ and $b.$\n\n${d}_{1}(a,b)=$\n{{field-1}}" :question/worked-solution "Recall that the Manhattan distance is defined as\n\n$$\n{d}_{1}(a,b)=‖a-b{‖}_{1}\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{1}={\\sum }_{i=1}^{N}|{v}_{i}|.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{1}(a,b) & =‖a-b{‖}_{1} \\\\  & ={‖[\\begin{aligned}1 \\\\ 4 \\\\ -2\\end{aligned}]-[\\begin{aligned}-4 \\\\ -1 \\\\ -2\\end{aligned}]‖}_{1} \\\\  & =|1-(-4)|+|4-(-1)|+|-2-(-2)| \\\\  & =10.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186157710 :knowledge-point/_questions [{:db/id #edb/ref 17592186157435 :knowledge-point/id #uuid "5a3f27e0-ef39-5965-9fe1-d141c944ac66" :knowledge-point/title "Computing the Minkowski Distance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ae0de384-07cc-5a84-afc1-a9358cfadaec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.271" :db/id #edb/ref 17592186517814}] :answer-field/correct {:answer/id #uuid "ae0de384-07cc-5a84-afc1-a9358cfadaec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.271" :db/id #edb/ref 17592186517814} :answer-field/id #uuid "9b09cff0-f476-5c1b-aada-9e983bf1b11f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186154800}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7c40d6f1-1835-547c-91d2-44386e1bd118" :question/math-academy-id "q-254887" :question/problem "Suppose $a=[1,\\,-1]^{T},$ and $b=[-2,\\,1]^{T},$ and $p=3.$ Find the Minkowski distance between $a$ and $b.$\n\nRounded to three decimal places, ${d}_{p}(a,b)≈$\n{{field-1}}." :question/worked-solution "Recall that the Minkowski distance is defined as\n\n$$\n{d}_{p}(a,b)=‖a-b{‖}_{p}\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{p}={({\\sum }_{i=1}^{N}|{v}_{i}{|}^{p})}^{1/p}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{3}(a,b) & =‖a-b{‖}_{3} \\\\  & ={‖[\\begin{aligned}1 \\\\ -1\\end{aligned}]-[\\begin{aligned}-2 \\\\ 1\\end{aligned}]‖}_{3} \\\\  & ={(|1-(-2){|}^{3}+|-1-1{|}^{3})}^{1/3} \\\\  & ={35}^{1/3} \\\\  & ≈3.271.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186518198 :knowledge-point/_questions [{:db/id #edb/ref 17592186157435 :knowledge-point/id #uuid "5a3f27e0-ef39-5965-9fe1-d141c944ac66" :knowledge-point/title "Computing the Minkowski Distance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "92424c36-a24d-582d-9308-f8f12010911d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.149" :db/id #edb/ref 17592186517763}] :answer-field/correct {:answer/id #uuid "92424c36-a24d-582d-9308-f8f12010911d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.149" :db/id #edb/ref 17592186517763} :answer-field/id #uuid "5abe70ca-7e0c-590c-bb75-0dcc742b5859" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186518015}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cd8b6d86-5eba-5e13-9d83-5bea3e076943" :question/math-academy-id "q-254889" :question/problem "Suppose $a=[3,\\,1]^{T},$ and $b=[2,\\,2]^{T},$ and $p=5.$ Find the Minkowski distance between $a$ and $b.$\n\nRounded to three decimal places, ${d}_{p}(a,b)≈$\n{{field-1}}." :question/worked-solution "Recall that the Minkowski distance is defined as\n\n$$\n{d}_{p}(a,b)=‖a-b{‖}_{p}\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{p}={({\\sum }_{i=1}^{N}|{v}_{i}{|}^{p})}^{1/p}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{5}(a,b) & =‖a-b{‖}_{5} \\\\  & ={‖[\\begin{aligned}3 \\\\ 1\\end{aligned}]-[\\begin{aligned}2 \\\\ 2\\end{aligned}]‖}_{5} \\\\  & ={(|3-2{|}^{5}+|1-2{|}^{5})}^{1/5} \\\\  & ={2}^{1/5} \\\\  & ≈1.149.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186518122 :knowledge-point/_questions [{:db/id #edb/ref 17592186157435 :knowledge-point/id #uuid "5a3f27e0-ef39-5965-9fe1-d141c944ac66" :knowledge-point/title "Computing the Minkowski Distance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bd4c9d49-3a7a-57e3-8d57-5591fee3c393" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.397" :db/id #edb/ref 17592186517848}] :answer-field/correct {:answer/id #uuid "bd4c9d49-3a7a-57e3-8d57-5591fee3c393" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.397" :db/id #edb/ref 17592186517848} :answer-field/id #uuid "9aa93ebe-bf5f-5031-a273-47db623e3948" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186518046}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2ca9d6e1-42a8-5184-8cd9-770775f3f1b2" :question/math-academy-id "q-254902" :question/problem "Suppose $a=[5,\\,-3,\\,4]^{T},$ and $b=[4,\\,-1,\\,2]^{T},$ and $p=4.$ Find the Minkowski distance between $a$ and $b.$\n\nRounded to three decimal places, ${d}_{p}(a,b)≈$ \n{{field-1}}." :question/worked-solution "Recall that the Minkowski distance is defined as\n\n$$\n{d}_{p}(a,b)=‖a-b{‖}_{p}\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{p}={({\\sum }_{i=1}^{N}|{v}_{i}{|}^{p})}^{1/p}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{4}(a,b) & =‖a-b{‖}_{4} \\\\  & ={‖[\\begin{aligned}5 \\\\ -3 \\\\ 4\\end{aligned}]-[\\begin{aligned}4 \\\\ -1 \\\\ 2\\end{aligned}]‖}_{4} \\\\  & ={(|5-4{|}^{4}+|-3-(-1){|}^{4}+|4-2{|}^{4})}^{1/4} \\\\  & ={33}^{1/4} \\\\  & ≈2.397.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186518184 :knowledge-point/_questions [{:db/id #edb/ref 17592186157435 :knowledge-point/id #uuid "5a3f27e0-ef39-5965-9fe1-d141c944ac66" :knowledge-point/title "Computing the Minkowski Distance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b6d080b-addf-5469-8035-84ef6b8b351b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.154" :db/id #edb/ref 17592186517689}] :answer-field/correct {:answer/id #uuid "6b6d080b-addf-5469-8035-84ef6b8b351b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.154" :db/id #edb/ref 17592186517689} :answer-field/id #uuid "4646076f-348f-5d4b-bcaf-606d564e3120" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186518005}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ae95185c-810c-50b4-b278-d16c314036aa" :question/math-academy-id "q-254904" :question/problem "Suppose $a=[1,\\,1,\\,-1]^{T},$ and $b=[2,\\,-1,\\,-2]^{T},$ and $p=3.$ Find the Minkowski distance between $a$ and $b.$\n\nRounded to three decimal places, ${d}_{p}(a,b)≈$\n{{field-1}}." :question/worked-solution "Recall that the Minkowski distance is defined as\n\n$$\n{d}_{p}(a,b)=‖a-b{‖}_{p}\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{p}={({\\sum }_{i=1}^{N}|{v}_{i}{|}^{p})}^{1/p}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{3}(a,b) & =‖a-b{‖}_{3} \\\\  & ={‖[\\begin{aligned}1 \\\\ 1 \\\\ -1\\end{aligned}]-[\\begin{aligned}2 \\\\ -1 \\\\ -2\\end{aligned}]‖}_{3} \\\\  & ={(|1-2{|}^{3}+|1-(-1){|}^{3}+|-1-(-2){|}^{3})}^{1/3} \\\\  & ={10}^{1/3} \\\\  & ≈2.154.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186518220 :knowledge-point/_questions [{:db/id #edb/ref 17592186157435 :knowledge-point/id #uuid "5a3f27e0-ef39-5965-9fe1-d141c944ac66" :knowledge-point/title "Computing the Minkowski Distance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cf04d7d1-03ee-5067-9205-1285cffc22a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.201" :db/id #edb/ref 17592186517877}] :answer-field/correct {:answer/id #uuid "cf04d7d1-03ee-5067-9205-1285cffc22a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.201" :db/id #edb/ref 17592186517877} :answer-field/id #uuid "aecf6ce9-a1f4-555e-9702-8cc70bee1442" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186518053}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f4c50ce1-0092-5528-9c12-822dbb56b8d9" :question/math-academy-id "q-254905" :question/problem "Suppose $a=[2,\\,-1,\\,1]^{T},$ and $b=[3,\\,0,\\,2]^{T},$ and $p=6.$ Find the Minkowski distance between $a$ and $b.$\n\nRounded to three decimal places, ${d}_{p}(a,b)≈$\n{{field-1}}." :question/worked-solution "Recall that the Minkowski distance is defined as\n\n$$\n{d}_{p}(a,b)=‖a-b{‖}_{p}\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{p}={({\\sum }_{i=1}^{N}|{v}_{i}{|}^{p})}^{1/p}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{6}(a,b) & =‖a-b{‖}_{6} \\\\  & ={‖[\\begin{aligned}2 \\\\ -1 \\\\ 1\\end{aligned}]-[\\begin{aligned}3 \\\\ 0 \\\\ 2\\end{aligned}]‖}_{6} \\\\  & ={(|2-3{|}^{6}+|-1-0{|}^{6}+|1-2{|}^{6})}^{1/6} \\\\  & ={3}^{1/6} \\\\  & ≈1.201.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186518161 :knowledge-point/_questions [{:db/id #edb/ref 17592186157436 :knowledge-point/id #uuid "9c9c3102-21e9-590d-ad14-c09baba8b4cf" :knowledge-point/title "Computing the Chebyshev Distance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "006ced18-63ca-5194-b549-3abf13fc8a1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186517495}] :answer-field/correct {:answer/id #uuid "006ced18-63ca-5194-b549-3abf13fc8a1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186517495} :answer-field/id #uuid "57eb417a-dd62-519e-be44-c8803a43e66f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186518013}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "78d962fb-98a1-54a9-be40-612e78bd3a7f" :question/math-academy-id "q-254909" :question/problem "Suppose $a=[7,\\,6,\\,-2]^{T}$ and $b=[-1,\\,2,\\,4]^{T}.$ Find the Chebyshev distance between $a$ and $b.$\n\n${d}_{\\infty }(a,b)=$\n{{field-1}}" :question/worked-solution "Recall that the Chebyshev distance is defined as\n\n$$\n{d}_{\\infty }(a,b)=‖a-b{‖}_{\\infty }\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{\\infty }=max(|{v}_{1}|,|{v}_{2}|,…,|{v}_{N}|).\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{\\infty }(a,b) & =‖a-b{‖}_{\\infty } \\\\  & ={‖[\\begin{aligned}7 \\\\ 6 \\\\ -2\\end{aligned}]-[\\begin{aligned}-1 \\\\ 2 \\\\ 4\\end{aligned}]‖}_{\\infty } \\\\  & =max(|7-(-1)|,|6-2|,|-2-4|) \\\\  & =max(8,4,6) \\\\  & =8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186518163 :knowledge-point/_questions [{:db/id #edb/ref 17592186157436 :knowledge-point/id #uuid "9c9c3102-21e9-590d-ad14-c09baba8b4cf" :knowledge-point/title "Computing the Chebyshev Distance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d2727e3c-066f-