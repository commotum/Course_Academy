#{[{:db/id #edb/ref 17592186157040 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186157434 :knowledge-point/id #uuid "38d1bdc1-006f-5efa-a4b0-380bd2d331c4" :knowledge-point/title "Computing the Manhattan Distance"}] :question/id #uuid "c19d702d-7023-5133-9911-9584a4bb3e88" :question/math-academy-id "e-16632" :question/problem "Suppose $\\mathbf a=[6,\\, -1,\\,2]^T$ and $\\mathbf b=[4,\\, -4,\\,0]^T$. Find the Manhattan distance $d_1$ between $\\mathbf a$ and $\\mathbf b$." :question/worked-solution "Recall that the Manhattan distance is defined as\n\n$$\nd_1(\\mathbf a,\\mathbf b) =\\|\\mathbf a-\\left.\\mathbf b\\\\right|_1\n$$\n\nwhere for an $N$-dimensional vector $\\mathbf v$,\n\n$$\n\\\\begin{vmatrix}\\left.\\mathbf v\\\\right|_1 = \\sum_{i=1}^N & v_i\\end{vmatrix}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\nd_{1}(a, b) &= ‖a - b‖_{1} \\\\\n&= ‖\\begin{bmatrix}6 \\\\ -1 \\\\ 2\\end{bmatrix} - \\begin{bmatrix}4 \\\\ -4 \\\\ 0\\end{bmatrix}‖_{1} \\\\\n&=\\begin{vmatrix}6 - 4 & + & -1 - (-4) & + & 2 - 0\\end{vmatrix} \\\\\n&= 7\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186157041 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186157435 :knowledge-point/id #uuid "5a3f27e0-ef39-5965-9fe1-d141c944ac66" :knowledge-point/title "Computing the Minkowski Distance"}] :question/id #uuid "0c580a08-5a51-516f-9ac8-ca3b0ed9984e" :question/math-academy-id "e-16633" :question/problem "Suppose $\\mathbf a=[6,\\, -3,\\, 2]^T$, and $\\mathbf b=[7,\\, -1,\\, 1]^T$, and $p=4$. Find the Minkowski distance $d_p$ between $\\mathbf a$ and $\\mathbf b$." :question/worked-solution "Recall that the Minkowski distance is defined as\n\n$$\nd_p(\\mathbf a,\\mathbf b) =\\|\\mathbf a-\\left.\\mathbf b\\\\right|_p\n$$\n\nwhere for an $N$-dimensional vector $\\mathbf v$,\n\n$$\n\\left.\\|\\mathbf v\\\\right|_p = \\left.\\left(\\sum_{i=1}^N \\mid v_i\\right|^p \\right)^{1/p}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\nd_{4}(a, b) &= ‖a - b‖_{4} \\\\\n&= ‖\\begin{bmatrix}6 \\\\ -3 \\\\ 2\\end{bmatrix} - \\begin{bmatrix}7 \\\\ -1 \\\\ 1\\end{bmatrix}‖_{4} \\\\\n&= (\\begin{vmatrix}6 - 7 & ^{4} + & -3 - (-1) & ^{4} +\\end{vmatrix}2 - \\left.1\\right|^{4})^{1/4} \\\\\n&= 18^{1/4} \\\\\n&\\approx 2.060\n\\end{aligned}\n$$\n\nrounded to $3$ decimal places."}] [{:db/id #edb/ref 17592186157042 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186157436 :knowledge-point/id #uuid "9c9c3102-21e9-590d-ad14-c09baba8b4cf" :knowledge-point/title "Computing the Chebyshev Distance"}] :question/id #uuid "b54dd07c-5e48-5d06-a454-c7dd907804d8" :question/math-academy-id "e-16634" :question/problem "Suppose $\\mathbf a=[-2,\\, 6,\\, -7]^T$ and $\\mathbf b=[8,\\, -9,\\, -9]^T$. Find the Chebyshev distance $d_\\infty$ between $\\mathbf a$ and $\\mathbf b$." :question/worked-solution "Recall that the Chebyshev distance is defined as\n\n$$\nd_\\infty(\\mathbf a,\\mathbf b) =\\|\\mathbf a-\\left.\\mathbf b\\\\right|_\\infty\n$$\n\nwhere for an $N$-dimensional vector $\\mathbf v$,\n\n$$\n\\left.\\|\\mathbf v\\\\right|_\\infty = \\operatorname{max}(\\begin{vmatrix}v_1 &, & v_2 &,\\ldots, & v_N\\end{vmatrix})\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\nd_{∞}(a, b) &= ‖a - b‖_{∞} \\\\\n&= ‖\\begin{bmatrix}-2 \\\\ 6 \\\\ -7\\end{bmatrix} - \\begin{bmatrix}8 \\\\ -9 \\\\ -9\\end{bmatrix}‖_{∞} \\\\\n&= \\max(\\begin{vmatrix}-2 - 8 &, & 6 - (-9) &, & -7 - (-9)\\end{vmatrix}) \\\\\n&= \\max(10, 15, 2) \\\\\n&= 15\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186157043 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186157433 :knowledge-point/id #uuid "04bdd95b-c658-5cfb-a720-246d2eaebbd7" :knowledge-point/title "Computing the Euclidean Distance"}] :question/id #uuid "25111cb4-1ff7-5514-8dd8-fab7ac30c46f" :question/math-academy-id "e-16638" :question/problem "Suppose $\\mathbf a=[7,\\, 2,\\, 4]^T$ and $\\mathbf b=[2,\\, 3,\\, 1]^T$. Find the Euclidean distance $d_2$ between $\\mathbf a$ and $\\mathbf b$." :question/worked-solution "Recall that the Euclidean distance is defined as\n\n$$\nd_2(\\mathbf a,\\mathbf b) =\\|\\mathbf a-\\left.\\mathbf b\\\\right|_2\n$$\n\nwhere for an $N$-dimensional vector $\\mathbf v$,\n\n$$\n\\left.\\|\\mathbf v\\\\right|_2 = \\left.\\sqrt{\\sum_{i=1}^N \\mid v_i\\right|^2}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\nd_{2}(a, b) &= ‖a - b‖_{2} \\\\\n&= ‖\\begin{bmatrix}7 \\\\ 2 \\\\ 4\\end{bmatrix} - \\begin{bmatrix}2 \\\\ 3 \\\\ 1\\end{bmatrix}‖_{2} \\\\\n&= \\sqrt{\\begin{vmatrix}7 - 2 & ^{2} + & 2 - 3 & ^{2} +\\end{vmatrix}4 - \\left.1\\right|^{2}} \\\\\n&= \\sqrt{35} \\\\\n&\\approx 5.916\n\\end{aligned}\n$$\n\nrounded to $3$ decimal places."}] [{:db/id #edb/ref 17592186157707 :knowledge-point/_questions [{:db/id #edb/ref 17592186157436 :knowledge-point/id #uuid "9c9c3102-21e9-590d-ad14-c09baba8b4cf" :knowledge-point/title "Computing the Chebyshev Distance"}] :question/answer-fields [{:answer-field/id #uuid "10722ede-227b-5ba8-9712-c73b71d70464" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186154797}] :question/id #uuid "506f68f5-a23e-5a06-b8e8-1b3b16470943" :question/math-academy-id "q-254757" :question/problem "Suppose $a = [8, 4,-3]^{T}$ and $b = [- 4, 4,-1]^{T}$. Find the Chebyshev distance between $a$ and $b$.$d_{∞}(a, b) =$\n{{field-1}}"}] [{:db/id #edb/ref 17592186157708 :knowledge-point/_questions [{:db/id #edb/ref 17592186157433 :knowledge-point/id #uuid "04bdd95b-c658-5cfb-a720-246d2eaebbd7" :knowledge-point/title "Computing the Euclidean Distance"}] :question/answer-fields [{:answer-field/id #uuid "1facda3e-c64b-54a1-ae18-0f17d30b65a3" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186154798}] :question/id #uuid "638730ce-cea4-5199-9000-7e2a8da3425a" :question/math-academy-id "q-254848" :question/problem "Suppose $a = [5, 1]^{T}$ and $b = [3,-2]^{T}$. Find the Euclidean distance between $a$ and $b$.Rounded to three decimal places, $d_{2}(a, b) \\approx$\n{{field-1}}."}] [{:db/id #edb/ref 17592186157710 :knowledge-point/_questions [{:db/id #edb/ref 17592186157435 :knowledge-point/id #uuid "5a3f27e0-ef39-5965-9fe1-d141c944ac66" :knowledge-point/title "Computing the Minkowski Distance"}] :question/answer-fields [{:answer-field/id #uuid "9b09cff0-f476-5c1b-aada-9e983bf1b11f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186154800}] :question/id #uuid "7c40d6f1-1835-547c-91d2-44386e1bd118" :question/math-academy-id "q-254887" :question/problem "Suppose $a = [1,-1]^{T}$, and $b = [- 2, 1]^{T}$, and $p = 3$. Find the Minkowski distance between $a$ and $b$.Rounded to three decimal places, $d_{p}(a, b) \\approx$\n{{field-1}}."}]}
