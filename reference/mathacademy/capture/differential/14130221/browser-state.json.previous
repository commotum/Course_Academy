-mo class=\"mjx-n\"><mjx-stretchy-h class=\"mjx-c23DF\" style=\"width: 1.8em;\"><mjx-beg><mjx-c></mjx-c></mjx-beg><mjx-ext><mjx-c></mjx-c></mjx-ext><mjx-mid><mjx-c></mjx-c></mjx-mid><mjx-ext><mjx-c></mjx-c></mjx-ext><mjx-end><mjx-c></mjx-c></mjx-end></mjx-stretchy-h></mjx-mo></mjx-under></mjx-row></mjx-munder></mjx-texatom></mjx-base></mjx-row><mjx-row><mjx-under style=\"padding-top: 0.072em; padding-left: 0.664em;\"><mjx-texatom size=\"s\" texclass=\"ORD\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2228\"></mjx-c></mjx-mo></mjx-texatom></mjx-under></mjx-row></mjx-munder><mjx-mstyle><mjx-mspace style=\"width: 1em;\"></mjx-mspace></mjx-mstyle><mjx-munder><mjx-row><mjx-base><mjx-texatom texclass=\"OP\"><mjx-munder><mjx-row><mjx-base><mjx-mrow><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D465 TEX-I\"></mjx-c></mjx-mi><mjx-texatom texclass=\"ORD\"><mjx-mpadded><mjx-block style=\"width: 0px;\"><mjx-mphantom><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D45D TEX-I\"></mjx-c></mjx-mi></mjx-mphantom></mjx-block></mjx-mpadded></mjx-texatom><mjx-mtext class=\"mjx-n\"><mjx-c class=\"mjx-cA0\"></mjx-c><mjx-c class=\"mjx-c69\"></mjx-c><mjx-c class=\"mjx-c73\"></mjx-c><mjx-c class=\"mjx-c20\"></mjx-c><mjx-c class=\"mjx-c6F\"></mjx-c><mjx-c class=\"mjx-c64\"></mjx-c><mjx-c class=\"mjx-c64\"></mjx-c></mjx-mtext></mjx-mrow></mjx-base></mjx-row><mjx-row><mjx-under style=\"padding-top: 0.105em;\"><mjx-mo class=\"mjx-n\"><mjx-stretchy-h class=\"mjx-c23DF\" style=\"width: 3.356em;\"><mjx-beg><mjx-c></mjx-c></mjx-beg><mjx-ext><mjx-c></mjx-c></mjx-ext><mjx-mid><mjx-c></mjx-c></mjx-mid><mjx-ext><mjx-c></mjx-c></mjx-ext><mjx-end><mjx-c></mjx-c></mjx-end></mjx-stretchy-h></mjx-mo></mjx-under></mjx-row></mjx-munder></mjx-texatom></mjx-base></mjx-row><mjx-row><mjx-under style=\"padding-top: 0.062em; padding-left: 1.398em;\"><mjx-texatom size=\"s\" texclass=\"ORD\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D444 TEX-I\"></mjx-c></mjx-mi></mjx-texatom></mjx-under></mjx-row></mjx-munder><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><munder><mrow data-mjx-texclass=\"OP\"><munder><mrow><mi>x</mi><mrow data-mjx-texclass=\"ORD\"><mpadded width=\"0\"><mphantom><mi>p</mi></mphantom></mpadded></mrow><mtext>&nbsp;is even</mtext></mrow><mo>⏟</mo></munder></mrow><mrow data-mjx-texclass=\"ORD\"><mi>P</mi></mrow></munder><mstyle scriptlevel=\"0\"><mspace width=\"1em\"></mspace></mstyle><munder><mrow data-mjx-texclass=\"OP\"><munder><mrow><mrow data-mjx-texclass=\"ORD\"><mpadded width=\"0\"><mphantom><mi>p</mi></mphantom></mpadded></mrow><mtext mathvariant=\"bold\">or</mtext></mrow><mo>⏟</mo></munder></mrow><mrow data-mjx-texclass=\"ORD\"><mo>∨</mo></mrow></munder><mstyle scriptlevel=\"0\"><mspace width=\"1em\"></mspace></mstyle><munder><mrow data-mjx-texclass=\"OP\"><munder><mrow><mi>x</mi><mrow data-mjx-texclass=\"ORD\"><mpadded width=\"0\"><mphantom><mi>p</mi></mphantom></mpadded></mrow><mtext>&nbsp;is odd</mtext></mrow><mo>⏟</mo></munder></mrow><mrow data-mjx-texclass=\"ORD\"><mi>Q</mi></mrow></munder><mo>,</mo></math></mjx-assistive-mml></mjx-container></p>\n<p>that is, <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"37\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D443 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c2228\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-i\" space=\"3\"><mjx-c class=\"mjx-c1D444 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>P</mi><mo>∨</mo><mi>Q</mi><mo>.</mo></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
