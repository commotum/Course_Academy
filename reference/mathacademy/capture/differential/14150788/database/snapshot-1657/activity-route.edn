ages/e4/e472070f17c47e78024217ed750690b88de87f3849818368dda1dde5d91d90d4.png)"} :step/id #uuid "c93d77e3-7651-52c2-a428-7ad850967a27" :step/next {:db/id #edb/ref 17592186446090}}] :activity/title "Type I and II Regions in Two-Dimensional Space" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186446081}]}
