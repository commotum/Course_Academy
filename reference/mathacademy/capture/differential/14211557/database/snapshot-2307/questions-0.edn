m}Δ{x}_{i} & =({x}_{1}-{x}_{0})+({x}_{2}-{x}_{1})+({x}_{3}-{x}_{2})+⋯+({x}_{m}-{x}_{m-1}) \\\\  & =(\\cancel{{x}_{1}}-{x}_{0})+(\\cancel{{x}_{2}}-\\cancel{{x}_{1}})+(\\cancel{{x}_{3}}-\\cancel{{x}_{2}})+⋯+({x}_{m}-\\cancel{{x}_{m-1}}) \\\\  & =-{x}_{0}+{x}_{m} \\\\  & ={x}_{m}-{x}_{0} \\\\  & =10-2 \\\\  & =8.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n-4{\\sum }_{i=1}^{m}Δ{x}_{i}=(-4)\\cdot 8=-32.\n$$"}] [{:db/id #edb/ref 17592186256762 :knowledge-point/_questions [{:db/id #edb/ref 17592186179720 :knowledge-point/id #uuid "6c91d51f-39b4-547a-971b-9c2dada9eb47" :knowledge-point/title "Computing Simple Sums Over Partitions of the Real Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "141db895-bbc5-5054-af56-41c9ff81d0a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186253841} {:answer/id #uuid "5dd0467c-8cf6-54c1-bb7e-97ff80ee14ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186254502} {:answer/id #uuid "a2bea880-8003-5c03-a805-455200652d81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186255106} {:answer/id #uuid "b46eba14-eda9-524d-885f-6b933077cd5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186255259} {:answer/id #uuid "c7e04e76-daf6-5fb9-ba27-c5ac9f640831" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186255452}] :answer-field/correct {:answer/id #uuid "b46eba14-eda9-524d-885f-6b933077cd5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186255259} :answer-field/id #uuid "6ff6ccbc-1bac-587e-b4e7-254172104711" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256124}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "99e23ff1-d646-54b7-8668-22a06e7d8b04" :question/math-academy-id "q-122979" :question/problem "Let $P=\\{{z}_{0},{z}_{1},…,{z}_{q}\\}$ be a partition of the interval $[4,9].$ If $Δ{z}_{k}={z}_{k}-{z}_{k-1},$ calculate ${\\sum }_{k=1}^{q}7Δ{z}_{k}.$" :question/worked-solution "First, we take the factor $7$ outside the summation:\n\n$$\n\\begin{aligned}{\\sum }_{k=1}^{q}7Δ{z}_{k}=7{\\sum }_{k=1}^{q}Δ{z}_{k}\\end{aligned}\n$$\n\nNote that ${\\sum }_{k=1}^{q}Δ{z}_{k}$ is just the length of the interval $[4,9],$ because\n\n$$\n\\begin{aligned}{\\sum }_{k=1}^{q}Δ{z}_{k} & =({z}_{1}-{z}_{0})+({z}_{2}-{z}_{1})+({z}_{3}-{z}_{2})+⋯+({z}_{q}-{z}_{q-1}) \\\\  & =(\\cancel{{z}_{1}}-{z}_{0})+(\\cancel{{z}_{2}}-\\cancel{{z}_{1}})+(\\cancel{{z}_{3}}-\\cancel{{z}_{2}})+⋯+({z}_{q}-\\cancel{{z}_{q-1}}) \\\\  & =-{z}_{0}+{z}_{q} \\\\  & ={z}_{q}-{z}_{0} \\\\  & =9-4 \\\\  & =5.\\end{aligned}\n$$\n\n \n\nTherefore,\n\n$$\n7{\\sum }_{k=1}^{q}Δ{z}_{k}=7\\cdot 5=35.\n$$"}] [{:db/id #edb/ref 17592186523933 :knowledge-point/_questions [{:db/id #edb/ref 17592186179721 :knowledge-point/id #uuid "0f55bdc9-4066-5786-bafe-c3fdc96a06c9" :knowledge-point/title "Computing Sums Over Partitions of the Real Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7ea547c4-139e-5f3e-b342-d36b9f80ab00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186523519} {:answer/id #uuid "9e97d679-8620-566e-aef5-b860139a2b3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186523586} {:answer/id #uuid "defd9c97-e8e8-51b6-b6df-85204c78bae5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186523723} {:answer/id #uuid "ebe90562-cdd2-5780-939d-bc592f3ec852" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186523748} {:answer/id #uuid "f34d9a61-167a-51a4-ad53-fbf35898e99a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186523761}] :answer-field/correct {:answer/id #uuid "ebe90562-cdd2-5780-939d-bc592f3ec852" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186523748} :answer-field/id #uuid "4c5455b8-9a9d-5129-b786-a83ab740510c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186523828}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1bfa03d7-9352-51b2-9697-231f8df40ac5" :question/math-academy-id "q-122989" :question/problem "Let $P=\\{{z}_{0},{z}_{1},…,{z}_{q}\\}$ be a partition of the interval $[-4,-2].$ If $Δ{z}_{k}={z}_{k}-{z}_{k-1},$ calculate ${\\sum }_{k=1}^{q}({z}_{k}+{z}_{k-1})Δ{z}_{k}.$" :question/worked-solution "We can simplify the given summation as follows: \n\n$$\n\\begin{aligned}{\\sum }_{k=1}^{q}({z}_{k}+{z}_{k-1})Δ{z}_{k} & =({z}_{1}+{z}_{0})Δ{z}_{1}+({z}_{2}+{z}_{1})Δ{z}_{2}+⋯+({z}_{q}+{z}_{q-1})Δ{z}_{n} \\\\  & =({z}_{1}+{z}_{0})({z}_{1}-{z}_{0})+({z}_{2}+{z}_{1})({z}_{2}-{z}_{1})+⋯+({z}_{q}+{z}_{q-1})({z}_{q}-{z}_{q-1}) \\\\  & =({z}_{1}^{2}-{z}_{0}^{2})+({z}_{2}^{2}-{z}_{1}^{2})+⋯+({z}_{q}^{2}-{z}_{q-1}^{2}) \\\\  & =(\\cancel{{z}_{1}^{2}}-{z}_{0}^{2})+(\\cancel{{z}_{2}^{2}}-\\cancel{{z}_{1}^{2}})+⋯+({z}_{q}^{2}-\\cancel{{z}_{q-1}^{2}}) \\\\  & =-{z}_{0}^{2}+{z}_{q}^{2} \\\\  & ={z}_{q}^{2}-{z}_{0}^{2}\\end{aligned}\n$$\n\nNow, since ${z}_{0}=-4$ and ${z}_{q}=-2$ are the endpoints of our partition, we have\n\n$$\n\\begin{aligned}{\\sum }_{k=1}^{q}({z}_{k}+{z}_{k-1})Δ{z}_{k} & ={z}_{q}^{2}-{z}_{0}^{2} \\\\  & =(-2)^{2}-(-4)^{2} \\\\  & =-12.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256768 :knowledge-point/_questions [{:db/id #edb/ref 17592186179721 :knowledge-point/id #uuid "0f55bdc9-4066-5786-bafe-c3fdc96a06c9" :knowledge-point/title "Computing Sums Over Partitions of the Real Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a21aab7-fc2e-549f-aab8-41f5bccb2b74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186253892} {:answer/id #uuid "507bca0f-38a3-53f7-b541-4c90fdccc251" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-28" :db/id #edb/ref 17592186254371} {:answer/id #uuid "b6620d40-be8d-5c18-b31f-71953ef9c8f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186255285} {:answer/id #uuid "c34909b9-269b-56e5-a1c2-f53b84a64cc1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186255414} {:answer/id #uuid "e094f232-f2ca-54f4-a9f8-04b288b09a23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186255664}] :answer-field/correct {:answer/id #uuid "1a21aab7-fc2e-549f-aab8-41f5bccb2b74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186253892} :answer-field/id #uuid "b0b9846e-3490-5206-b201-c84233f5e785" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256241}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e65ff59b-de1e-50f4-9c3d-679e5004d29d" :question/math-academy-id "q-122992" :question/problem "Let $P=\\{{z}_{0},{z}_{1},…,{z}_{q}\\}$ be a partition of the interval $[-2,4].$ If $Δ{z}_{k}={z}_{k}-{z}_{k-1},$ calculate ${\\sum }_{k=1}^{q}-2({z}_{k}+{z}_{k-1})Δ{z}_{k}.$" :question/worked-solution "Using the constant multiple rule, we can write the summation as\n\n$$\n{\\sum }_{k=1}^{q}-2({z}_{k}+{z}_{k-1})Δ{z}_{k}=-2{\\sum }_{k=1}^{q}({z}_{k}+{z}_{k-1})Δ{z}_{k}.\n$$\n\nWe can simplify the summation as follows: \n\n$$\n\\begin{aligned}{\\sum }_{k=1}^{q}({z}_{k}+{z}_{k-1})Δ{z}_{k} & =({z}_{1}+{z}_{0})Δ{z}_{1}+({z}_{2}+{z}_{1})Δ{z}_{2}+⋯+({z}_{q}+{z}_{q-1})Δ{z}_{n} \\\\  & =({z}_{1}+{z}_{0})({z}_{1}-{z}_{0})+({z}_{2}+{z}_{1})({z}_{2}-{z}_{1})+⋯+({z}_{q}+{z}_{q-1})({z}_{q}-{z}_{q-1}) \\\\  & =({z}_{1}^{2}-{z}_{0}^{2})+({z}_{2}^{2}-{z}_{1}^{2})+⋯+({z}_{q}^{2}-{z}_{q-1}^{2}) \\\\  & =(\\cancel{{z}_{1}^{2}}-{z}_{0}^{2})+(\\cancel{{z}_{2}^{2}}-\\cancel{{z}_{1}^{2}})+⋯+({z}_{q}^{2}-\\cancel{{z}_{q-1}^{2}}) \\\\  & =-{z}_{0}^{2}+{z}_{q}^{2} \\\\  & ={z}_{q}^{2}-{z}_{0}^{2}\\end{aligned}\n$$\n\nNow, since ${z}_{0}=-2$ and ${z}_{q}=4$ are the endpoints of our partition, we have\n\n$$\n\\begin{aligned}{\\sum }_{k=1}^{q}({z}_{k}+{z}_{k-1})Δ{z}_{k} & ={z}_{q}^{2}-{z}_{0}^{2} \\\\  & ={4}^{2}-(-2)^{2} \\\\  & =12.\\end{aligned}\n$$\n\n  \n\nFinally, we have\n\n$$\n-2{\\sum }_{k=1}^{q}({z}_{k}+{z}_{k-1})Δ{z}_{k}=(-2)\\cdot 12=-24.\n$$"}] [{:db/id #edb/ref 17592186523983 :knowledge-point/_questions [{:db/id #edb/ref 17592186179721 :knowledge-point/id #uuid "0f55bdc9-4066-5786-bafe-c3fdc96a06c9" :knowledge-point/title "Computing Sums Over Partitions of the Real Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bfa3377-49dd-5c01-9f92-6c06b6561a19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186523311} {:answer/id #uuid "3c274b0a-1fe7-5023-be4b-fa97d2764212" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186523380} {:answer/id #uuid "759843ef-ad38-5c40-b7cb-3f8900a9347d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186523493} {:answer/id #uuid "7a6913dc-7a10-5568-8db9-9fb86dab5d97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186523505} {:answer/id #uuid "bb600cb6-7d76-5292-a580-58d7c9f435f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186523646}] :answer-field/correct {:answer/id #uuid "bb600cb6-7d76-5292-a580-58d7c9f435f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186523646} :answer-field/id #uuid "e8508966-666d-5767-9f3e-6f1a14747298" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186523907}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8a05e0a6-f018-5eeb-9fa0-754bde9f9f75" :question/math-academy-id "q-122993" :question/problem "Let $P=\\{{z}_{0},{z}_{1},…,{z}_{q}\\}$ be a partition of the interval $[2,6].$ If $Δ{z}_{k}={z}_{k}-{z}_{k-1},$ calculate ${\\sum }_{k=1}^{q}\\frac{({z}_{k}+{z}_{k-1})}{2}Δ{z}_{k}.$" :question/worked-solution "Using the constant multiple rule, we can write the summation as\n\n$$\n{\\sum }_{k=1}^{q}\\frac{({z}_{k}+{z}_{k-1})}{2}Δ{z}_{k}=\\frac{1}{2}{\\sum }_{k=1}^{q}({z}_{k}+{z}_{k-1})Δ{z}_{k}.\n$$\n\nWe can simplify the summation as follows: \n\n$$\n\\begin{aligned}{\\sum }_{k=1}^{q}({z}_{k}+{z}_{k-1})Δ{z}_{k} & =({z}_{1}+{z}_{0})Δ{z}_{1}+({z}_{2}+{z}_{1})Δ{z}_{2}+⋯+({z}_{q}+{z}_{q-1})Δ{z}_{n} \\\\  & =({z}_{1}+{z}_{0})({z}_{1}-{z}_{0})+({z}_{2}+{z}_{1})({z}_{2}-{z}_{1})+⋯+({z}_{q}+{z}_{q-1})({z}_{q}-{z}_{q-1}) \\\\  & =({z}_{1}^{2}-{z}_{0}^{2})+({z}_{2}^{2}-{z}_{1}^{2})+⋯+({z}_{q}^{2}-{z}_{q-1}^{2}) \\\\  & =(\\cancel{{z}_{1}^{2}}-{z}_{0}^{2})+(\\cancel{{z}_{2}^{2}}-\\cancel{{z}_{1}^{2}})+⋯+({z}_{q}^{2}-\\cancel{{z}_{q-1}^{2}}) \\\\  & =-{z}_{0}^{2}+{z}_{q}^{2} \\\\  & ={z}_{q}^{2}-{z}_{0}^{2}\\end{aligned}\n$$\n\nNow, since ${z}_{0}=2$ and ${z}_{q}=6$ are the endpoints of our partition, we have\n\n$$\n\\begin{aligned}{\\sum }_{k=1}^{q}({z}_{k}+{z}_{k-1})Δ{z}_{k} & ={z}_{q}^{2}-{z}_{0}^{2} \\\\  & ={6}^{2}-{2}^{2} \\\\  & =32.\\end{aligned}\n$$\n\n  \n\nFinally, we have\n\n$$\n\\frac{1}{2}{\\sum }_{k=1}^{q}({z}_{k}+{z}_{k-1})Δ{z}_{k}=\\frac{1}{2}\\cdot 32=16.\n$$"}] [{:db/id #edb/ref 17592186523971 :knowledge-point/_questions [{:db/id #edb/ref 17592186179721 :knowledge-point/id #uuid "0f55bdc9-4066-5786-bafe-c3fdc96a06c9" :knowledge-point/title "Computing Sums Over Partitions of the Real Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "154c6ccd-afa9-5d6e-b30d-795512a973b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "200" :db/id #edb/ref 17592186523300} {:answer/id #uuid "3e17c7a9-6c99-5817-8972-75e58e23f040" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "190" :db/id #edb/ref 17592186523385} {:answer/id #uuid "3fa8eabe-8df9-5652-9574-6fce6e9ce159" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "196" :db/id #edb/ref 17592186523387} {:answer/id #uuid "a8cc2c6a-d627-5733-9397-df08623f6047" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "192" :db/id #edb/ref 17592186523611} {:answer/id #uuid "f8c1fe78-e46c-5dc7-811d-7c100ded5e0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "198" :db/id #edb/ref 17592186523777}] :answer-field/correct {:answer/id #uuid "f8c1fe78-e46c-5dc7-811d-7c100ded5e0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "198" :db/id #edb/ref 17592186523777} :answer-field/id #uuid "df659612-579e-586d-b30d-ba9a4e631fa2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186523902}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "785f4fec-653e-532c-a878-3835d225527c" :question/math-academy-id "q-122994" :question/problem "Let $P=\\{{x}_{0},{x}_{1},…,{x}_{m}\\}$ be a partition of the interval $[1,10].$ If $Δ{x}_{i}={x}_{i}-{x}_{i-1},$ calculate ${\\sum }_{i=1}^{m}2({x}_{i}+{x}_{i-1})Δ{x}_{i}.$" :question/worked-solution "Using the constant multiple rule, we can write the summation as\n\n$$\n{\\sum }_{i=1}^{m}2({x}_{i}+{x}_{i-1})Δ{x}_{i}=2{\\sum }_{i=1}^{m}({x}_{i}+{x}_{i-1})Δ{x}_{i}.\n$$\n\nWe can simplify the summation as follows:\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}({x}_{i}+{x}_{i-1})Δ{x}_{i} & =({x}_{1}+{x}_{0})Δ{x}_{1}+({x}_{2}+{x}_{1})Δ{x}_{2}+⋯+({x}_{m}+{x}_{m-1})Δ{x}_{m} \\\\  & =({x}_{1}+{x}_{0})({x}_{1}-{x}_{0})+({x}_{2}+{x}_{1})({x}_{2}-{x}_{1})+⋯+({x}_{m}+{x}_{m-1})({x}_{m}-{x}_{m-1}) \\\\  & =({x}_{1}^{2}-{x}_{0}^{2})+({x}_{2}^{2}-{x}_{1}^{2})+⋯+({x}_{m}^{2}-{x}_{m-1}^{2}) \\\\  & =(\\cancel{{x}_{1}^{2}}-{x}_{0}^{2})+(\\cancel{{x}_{2}^{2}}-\\cancel{{x}_{1}^{2}})+⋯+({x}_{m}^{2}-\\cancel{{x}_{m-1}^{2}}) \\\\  & =-{x}_{0}^{2}+{x}_{m}^{2} \\\\  & ={x}_{m}^{2}-{x}_{0}^{2}\\end{aligned}\n$$\n\nNow, since ${x}_{0}=1$ and ${x}_{m}=10$ are the endpoints of our partition, we have\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}({x}_{i}+{x}_{i-1})Δ{x}_{i} & ={x}_{m}^{2}-{x}_{0}^{2} \\\\  & ={10}^{2}-{1}^{2} \\\\  & =99.\\end{aligned}\n$$\n\nFinally, we have\n\n$$\n2{\\sum }_{i=1}^{m}({x}_{i}+{x}_{i-1})Δ{x}_{i}=2\\cdot 99=198.\n$$"}]}
