>5</mn></msup><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><msubsup><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"2.470em\" maxsize=\"2.470em\">|</mo></mrow><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>1</mn></mrow><mrow data-mjx-texclass=\"ORD\"><mn>0</mn></mrow></msubsup><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mn>3</mn></mfrac></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><msup><mi>x</mi><mn>4</mn></msup><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><msubsup><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"2.470em\" maxsize=\"2.470em\">|</mo></mrow><mrow data-mjx-texclass=\"ORD\"><mn>0</mn></mrow><mrow data-mjx-texclass=\"ORD\"><mn>1</mn></mrow></msubsup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mn>5</mn></mfrac></mstyle><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mn>0</mn><mo>+</mo><mn>1</mn><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mn>3</mn></mfrac></mstyle><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mn>1</mn><mo>−</mo><mn>0</mn><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mn>5</mn></mfrac></mstyle><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mn>3</mn></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>8</mn><mn>15</mn></mfrac></mstyle><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
