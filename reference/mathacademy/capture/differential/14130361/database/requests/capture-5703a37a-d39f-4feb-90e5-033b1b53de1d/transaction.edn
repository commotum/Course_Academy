t{d}x \\\\  & =(\\frac{1}{6}\\,{x}^{6}-\\frac{1}{9}\\,{x}^{9}){|}_{0}^{1}+\\frac{1}{24}\\,{x}^{6}\\,{|}_{1}^{2} \\\\  & =(\\frac{1}{6}-\\frac{1}{9}-0)+\\frac{1}{24}(64-1) \\\\  & =\\frac{1}{18}+\\frac{21}{8} \\\\  & =\\frac{193}{72}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-0c007b78-c592-57ca-92fd-6134f73345c2"] :db/ensure [:question/validate]} {:db/id "answer-field-0c007b78-c592-57ca-92fd-6134f73345c2" :answer-field/id #uuid "0c007b78-c592-57ca-92fd-6134f73345c2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f06289bf-091e-50d1-9b59-16cd180c1d5d" :answer-field/choices ["answer-5b4af875-f9cd-5e54-964a-6b3e0fd19b65" "answer-f06289bf-091e-50d1-9b59-16cd180c1d5d" "answer-18dde701-e4cf-5985-910b-d99d3686a2e6" "answer-216706e8-4838-5204-973c-827cb86e9697" "answer-561a582b-3336-5381-80c8-bea3d50931a1"] :db/ensure [:answer-field/validate]} {:db/id "answer-5b4af875-f9cd-5e54-964a-6b3e0fd19b65" :answer/id #uuid "5b4af875-f9cd-5e54-964a-6b3e0fd19b65" :answer/type :answer.type/math :answer/value "\\frac{121}{36}" :db/ensure [:answer/validate]} {:db/id "answer-f06289bf-091e-50d1-9b59-16cd180c1d5d" :answer/id #uuid "f06289bf-091e-50d1-9b59-16cd180c1d5d" :answer/type :answer.type/math :answer/value "\\frac{193}{72}" :db/ensure [:answer/validate]} {:db/id "answer-18dde701-e4cf-5985-910b-d99d3686a2e6" :answer/id #uuid "18dde701-e4cf-5985-910b-d99d3686a2e6" :answer/type :answer.type/math :answer/value "\\frac{64}{9}" :db/ensure [:answer/validate]} {:db/id "answer-216706e8-4838-5204-973c-827cb86e9697" :answer/id #uuid "216706e8-4838-5204-973c-827cb86e9697" :answer/type :answer.type/math :answer/value "\\frac{71}{18}" :db/ensure [:answer/validate]} {:db/id "answer-561a582b-3336-5381-80c8-bea3d50931a1" :answer/id #uuid "561a582b-3336-5381-80c8-bea3d50931a1" :answer/type :answer.type/math :answer/value "\\frac{85}{4}" :db/ensure [:answer/validate]} {:db/id "question-4c7b6764-ca2b-56e1-8efb-c299f7c5895e" :question/id #uuid "4c7b6764-ca2b-56e1-8efb-c299f7c5895e" :question/math-academy-id "q-152918" :question/problem "A continuous random variable $X$ has the probability density function \n\n$$\nf(x)=\\frac{1}{2},\\,0\\le x\\le 2.\n$$\n\nCalculate $\\text{E}[{X}^{5}].$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ the $n$th raw moment of $X$ is given by\n\n$$\n\\text{E}[{X}^{n}]={\\int }_{S}{x}^{n}\\cdot f(x)\\,\\text{d}x.\n$$\n\nSo, we compute the fifth raw moment of $X$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{5}] & ={\\int }_{0}^{2}{x}^{5}\\cdot \\frac{1}{2}\\,\\text{d}x \\\\  & =\\frac{1}{2}{\\int }_{0}^{2}{x}^{5}\\,\\text{d}x \\\\  & =\\frac{1}{12}\\,{x}^{6}\\,{|}_{0}^{2} \\\\  & =\\frac{1}{12}(64-0) \\\\  & =\\frac{16}{3}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-cef75508-985a-555a-8a45-30d352f2ef8a"] :db/ensure [:question/validate]} {:db/id "answer-field-cef75508-985a-555a-8a45-30d352f2ef8a" :answer-field/id #uuid "cef75508-985a-555a-8a45-30d352f2ef8a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9153e45d-d77d-5858-8fc9-e34fc7fa0948" :answer-field/choices ["answer-1b9fa685-0872-591b-81b4-ec8fbd0394aa" "answer-1e10a00b-59c4-5c6b-a991-01b8fe10266b" "answer-bf95dcf6-ad3d-5b88-bbeb-441fd75761f9" "answer-9153e45d-d77d-5858-8fc9-e34fc7fa0948" "answer-d97d2b6a-156a-5b2c-8cbc-9f9956364305"] :db/ensure [:answer-field/validate]} {:db/id "answer-1b9fa685-0872-591b-81b4-ec8fbd0394aa" :answer/id #uuid "1b9fa685-0872-591b-81b4-ec8fbd0394aa" :answer/type :answer.type/math :answer/value "\\frac{10}{9}" :db/ensure [:answer/validate]} {:db/id "answer-1e10a00b-59c4-5c6b-a991-01b8fe10266b" :answer/id #uuid "1e10a00b-59c4-5c6b-a991-01b8fe10266b" :answer/type :answer.type/math :answer/value "\\frac{11}{6}" :db/ensure [:answer/validate]} {:db/id "answer-bf95dcf6-ad3d-5b88-bbeb-441fd75761f9" :answer/id #uuid "bf95dcf6-ad3d-5b88-bbeb-441fd75761f9" :answer/type :answer.type/math :answer/value "\\frac{15}{4}" :db/ensure [:answer/validate]} {:db/id "answer-9153e45d-d77d-5858-8fc9-e34fc7fa0948" :answer/id #uuid "9153e45d-d77d-5858-8fc9-e34fc7fa0948" :answer/type :answer.type/math :answer/value "\\frac{16}{3}" :db/ensure [:answer/validate]} {:db/id "answer-d97d2b6a-156a-5b2c-8cbc-9f9956364305" :answer/id #uuid "d97d2b6a-156a-5b2c-8cbc-9f9956364305" :answer/type :answer.type/math :answer/value "\\frac{8}{3}" :db/ensure [:answer/validate]} {:db/id "question-6e9a565a-12f8-5f6b-b609-40f05cb5f2ab" :question/id #uuid "6e9a565a-12f8-5f6b-b609-40f05cb5f2ab" :question/math-academy-id "q-152923" :question/problem "A continuous random variable $X$ has the probability density function \n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{4}, & 0\\le x<1 \\\\ \\frac{1}{2}\\,x, & 1\\le x\\le 2.\\end{aligned}\n$$\n\nCalculate $\\text{E}[{X}^{4}].$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ the $n$th raw moment of $X$ is given by\n\n$$\n\\text{E}[{X}^{n}]={\\int }_{S}{x}^{n}\\cdot f(x)\\,\\text{d}x.\n$$\n\nSo, we compute the fourth raw moment of $X$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{4}] & ={\\int }_{0}^{2}{x}^{4}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{x}^{4}\\cdot \\frac{1}{4}\\,\\text{d}x+{\\int }_{1}^{2}{x}^{4}\\cdot \\frac{1}{2}\\,x\\,\\text{d}x \\\\  & =\\frac{1}{4}{\\int }_{0}^{1}{x}^{4}\\,\\text{d}x+\\frac{1}{2}{\\int }_{1}^{2}{x}^{5}\\,\\text{d}x \\\\  & =\\frac{1}{20}\\,{x}^{5}\\,{|}_{0}^{1}+\\frac{1}{12}\\,{x}^{6}\\,{|}_{1}^{2} \\\\  & =\\frac{1}{20}(1-0)+\\frac{1}{12}(64-1) \\\\  & =\\frac{1}{20}+\\frac{21}{4} \\\\  & =\\frac{53}{10}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-acd8ebd9-b030-599f-8966-92f0bf6056df"] :db/ensure [:question/validate]} 