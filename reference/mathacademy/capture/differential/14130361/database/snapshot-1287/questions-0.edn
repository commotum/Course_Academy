,{|}_{1}^{2} \\\\  & =\\frac{1}{2}(16-1) \\\\  & =\\frac{15}{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186427363 :knowledge-point/_questions [{:db/id #edb/ref 17592186157395 :knowledge-point/id #uuid "88bd32d5-4a84-58b3-a3e9-73bf32cb5e4f" :knowledge-point/title "Calculating a Higher Moments of a Random Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b9fa685-0872-591b-81b4-ec8fbd0394aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10}{9}" :db/id #edb/ref 17592186427285} {:answer/id #uuid "1e10a00b-59c4-5c6b-a991-01b8fe10266b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{6}" :db/id #edb/ref 17592186427286} {:answer/id #uuid "9153e45d-d77d-5858-8fc9-e34fc7fa0948" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{16}{3}" :db/id #edb/ref 17592186427317} {:answer/id #uuid "bf95dcf6-ad3d-5b88-bbeb-441fd75761f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{15}{4}" :db/id #edb/ref 17592186427327} {:answer/id #uuid "d97d2b6a-156a-5b2c-8cbc-9f9956364305" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{3}" :db/id #edb/ref 17592186427336}] :answer-field/correct {:answer/id #uuid "9153e45d-d77d-5858-8fc9-e34fc7fa0948" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{16}{3}" :db/id #edb/ref 17592186427317} :answer-field/id #uuid "cef75508-985a-555a-8a45-30d352f2ef8a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186427353}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4c7b6764-ca2b-56e1-8efb-c299f7c5895e" :question/math-academy-id "q-152918" :question/problem "A continuous random variable $X$ has the probability density function \n\n$$\nf(x)=\\frac{1}{2},\\,0\\le x\\le 2.\n$$\n\nCalculate $\\text{E}[{X}^{5}].$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ the $n$th raw moment of $X$ is given by\n\n$$\n\\text{E}[{X}^{n}]={\\int }_{S}{x}^{n}\\cdot f(x)\\,\\text{d}x.\n$$\n\nSo, we compute the fifth raw moment of $X$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{5}] & ={\\int }_{0}^{2}{x}^{5}\\cdot \\frac{1}{2}\\,\\text{d}x \\\\  & =\\frac{1}{2}{\\int }_{0}^{2}{x}^{5}\\,\\text{d}x \\\\  & =\\frac{1}{12}\\,{x}^{6}\\,{|}_{0}^{2} \\\\  & =\\frac{1}{12}(64-0) \\\\  & =\\frac{16}{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186427365 :knowledge-point/_questions [{:db/id #edb/ref 17592186157395 :knowledge-point/id #uuid "88bd32d5-4a84-58b3-a3e9-73bf32cb5e4f" :knowledge-point/title "Calculating a Higher Moments of a Random Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18dde701-e4cf-5985-910b-d99d3686a2e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{64}{9}" :db/id #edb/ref 17592186427284} {:answer/id #uuid "216706e8-4838-5204-973c-827cb86e9697" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{71}{18}" :db/id #edb/ref 17592186427288} {:answer/id #uuid "561a582b-3336-5381-80c8-bea3d50931a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{85}{4}" :db/id #edb/ref 17592186427298} {:answer/id #uuid "5b4af875-f9cd-5e54-964a-6b3e0fd19b65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{121}{36}" :db/id #edb/ref 17592186427300} {:answer/id #uuid "f06289bf-091e-50d1-9b59-16cd180c1d5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{193}{72}" :db/id #edb/ref 17592186427342}] :answer-field/correct {:answer/id #uuid "f06289bf-091e-50d1-9b59-16cd180c1d5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{193}{72}" :db/id #edb/ref 17592186427342} :answer-field/id #uuid "0c007b78-c592-57ca-92fd-6134f73345c2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186427347}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6e408aa1-cabb-5d40-b79a-58877a0c50b9" :question/math-academy-id "q-152921" :question/problem "A continuous random variable $X$ has the probability density function \n\n$$\nf(x)=\\{\\begin{aligned}1-{x}^{3}, & 0\\le x\\le 1 \\\\ \\frac{1}{4}, & 1<x\\le 2.\\end{aligned}\n$$\n\nCalculate $\\text{E}[{X}^{5}].$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ the $n$th raw moment of $X$ is given by\n\n$$\n\\text{E}[{X}^{n}]={\\int }_{S}{x}^{n}\\cdot f(x)\\,\\text{d}x.\n$$\n\nSo, we compute the fifth raw moment of $X$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{5}] & ={\\int }_{0}^{3}{x}^{5}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{x}^{5}\\cdot (1-{x}^{3})\\,\\text{d}x+{\\int }_{1}^{2}{x}^{5}\\cdot \\frac{1}{4}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}({x}^{5}-{x}^{8})\\,\\text{d}x+\\frac{1}{4}{\\int }_{1}^{2}{x}^{5}\\,\\text{d}x \\\\  & =(\\frac{1}{6}\\,{x}^{6}-\\frac{1}{9}\\,{x}^{9}){|}_{0}^{1}+\\frac{1}{24}\\,{x}^{6}\\,{|}_{1}^{2} \\\\  & =(\\frac{1}{6}-\\frac{1}{9}-0)+\\frac{1}{24}(64-1) \\\\  & =\\frac{1}{18}+\\frac{21}{8} \\\\  & =\\frac{193}{72}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186427366 :knowledge-point/_questions [{:db/id #edb/ref 17592186157395 :knowledge-point/id #uuid "88bd32d5-4a84-58b3-a3e9-73bf32cb5e4f" :knowledge-point/title "Calculating a Higher Moments of a Random Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "044244e8-f2a2-5ef1-8833-22499068eac4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{53}{10}" :db/id #edb/ref 17592186427277} {:answer/id #uuid "7398c53a-28aa-56f2-8f86-b9c5c3ecdfb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{43}{20}" :db/id #edb/ref 17592186427307} {:answer/id #uuid "b7cc5c5a-3488-59cc-be9d-190da0ab451e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17}{4}" :db/id #edb/ref 17592186427324} {:answer/id #uuid "c4f942b5-1366-5e68-a225-6363a1b6a0c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{24}{5}" :db/id #edb/ref 17592186427329} {:answer/id #uuid "f38b83dc-2a1a-5002-b5c8-92712ed90517" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{33}{12}" :db/id #edb/ref 17592186427343}] :answer-field/correct {:answer/id #uuid "044244e8-f2a2-5ef1-8833-22499068eac4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{53}{10}" :db/id #edb/ref 17592186427277} :answer-field/id #uuid "acd8ebd9-b030-599f-8966-92f0bf6056df" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186427352}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6e9a565a-12f8-5f6b-b609-40f05cb5f2ab" :question/math-academy-id "q-152923" :question/problem "A continuous random variable $X$ has the probability density function \n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{4}, & 0\\le x<1 \\\\ \\frac{1}{2}\\,x, & 1\\le x\\le 2.\\end{aligned}\n$$\n\nCalculate $\\text{E}[{X}^{4}].$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ the $n$th raw moment of $X$ is given by\n\n$$\n\\text{E}[{X}^{n}]={\\int }_{S}{x}^{n}\\cdot f(x)\\,\\text{d}x.\n$$\n\nSo, we compute the fourth raw moment of $X$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{4}] & ={\\int }_{0}^{2}{x}^{4}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{x}^{4}\\cdot \\frac{1}{4}\\,\\text{d}x+{\\int }_{1}^{2}{x}^{4}\\cdot \\frac{1}{2}\\,x\\,\\text{d}x \\\\  & =\\frac{1}{4}{\\int }_{0}^{1}{x}^{4}\\,\\text{d}x+\\frac{1}{2}{\\int }_{1}^{2}{x}^{5}\\,\\text{d}x \\\\  & =\\frac{1}{20}\\,{x}^{5}\\,{|}_{0}^{1}+\\frac{1}{12}\\,{x}^{6}\\,{|}_{1}^{2} \\\\  & =\\frac{1}{20}(1-0)+\\frac{1}{12}(64-1) \\\\  & =\\frac{1}{20}+\\frac{21}{4} \\\\  & =\\frac{53}{10}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186427367 :knowledge-point/_questions [{:db/id #edb/ref 17592186157393 :knowledge-point/id #uuid "f9c799d6-e3fe-5b78-986d-f2068b2db058" :knowledge-point/title "Computing the Mean of a Transformed Random Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "524c0c3b-a863-56ca-980e-5d3036687f18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{21}{5}" :db/id #edb/ref 17592186427297} {:answer/id #uuid "74e3075a-1274-50d8-ab79-2b4f0107f9ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{19}{9}" :db/id #edb/ref 17592186427310} {:answer/id #uuid "77000447-b172-5a27-893e-242b163e73c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{25}{3}" :db/id #edb/ref 17592186427312} {:answer/id #uuid "bde31011-f760-5b4d-85f3-daf008a1415f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{7}" :db/id #edb/ref 17592186427325} {:answer/id #uuid "beabf677-3eb3-5105-9807-95dfda90570d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{20}{3}" :db/id #edb/ref 17592186427326}] :answer-field/correct {:answer/id #uuid "77000447-b172-5a27-893e-242b163e73c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{25}{3}" :db/id #edb/ref 17592186427312} :answer-field/id #uuid "f6b4cbe3-cc32-52a8-971f-7f0c3bceefa4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186427357}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "78882664-5ca1-5d0e-9798-9cca3f283762" :question/math-academy-id "q-90451" :question/problem "Given that $X$ is a continuous random variable with the following probability density function, compute $\\text{E}[2{X}^{2}+1].$\n\n$$\nf(x)=1-\\frac{x}{4},\\,1<x<3\n$$" :question/worked-solution "First, we simplify using the properties of expected value:\n\n$$\n\\text{E}[2{X}^{2}+1]=2\\text{E}[{X}^{2}]+1\n$$\n\nFor a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ the $n$th raw moment of $X$ is given by\n\n$$\n\\text{E}[{X}^{n}]={\\int }_{S}{x}^{n}\\cdot f(x)\\,\\text{d}x.\n$$\n\nSo, we compute the second raw moment of $X$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{S}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{3}{x}^{2}\\cdot (1-\\frac{x}{4})\\text{d}x \\\\  & ={\\int }_{1}^{3}({x}^{2}-\\frac{{x}^{3}}{4})\\text{d}x \\\\  & =(\\frac{{x}^{3}}{3}-\\frac{{x}^{4}}{16}){|}_{1}^{3} \\\\  & =\\frac{11}{3}\\end{aligned}\n$$\n\nSubstituting $\\text{E}[{X}^{2}]=\\frac{11}{3}$ into the simplified expression, we conclude that\n\n$$\n\\begin{aligned}\\text{E}[2{X}^{2}+1] & =2\\text{E}[{X}^{2}]+1 \\\\  & =2\\cdot \\frac{11}{3}+1 \\\\  & =\\frac{25}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186427369 :knowledge-point/_questions [{:db/id #edb/ref 17592186157393 :knowledge-point/id #uuid "f9c799d6-e3fe-5b78-986d-f2068b2db058" :knowledge-point/title "Computing the Mean of a Transformed Random Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09fdd550-bf28-5f33-af90-7628e13259a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{29}{7}" :db/id #edb/ref 17592186427278} {:answer/id #uuid "4965166b-8ac3-5114-9933-f4b87cef16a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186427294} {:answer/id #uuid "6292f7a0-9113-56c4-bf5e-7d9b507cd720" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{34}{5}" :db/id #edb/ref 17592186427302} {:answer/id #uuid "65b5937c-cc39-5723-8f34-9662e8a75710" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186427303} {:answer/id #uuid "dcac4ef3-4b4f-5d57-a295-5bf2a30e3678" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186427338}] :answer-field/correct {:answer/id #uuid "6292f7a0-9113-56c4-bf5e-7d9b507cd720" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{34}{5}" :db/id #edb/ref 17592186427302} :answer-field/id #uuid "e96a4559-67f7-531f-8a30-e313c843c74b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186427355}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8ee689ae-d309-5b9e-a1ff-6e4de3b135ae" :question/math-academy-id "q-90454" :question/problem "The continuous random variable $X$ has the following probability density function:\n\n$$\nf(x)=4{x}^{3},\\,0<x<1\n$$\n\nGiven that $\\text{E}[X]=\\frac{4}{5},$ compute $\\text{E}[9{X}^{2}+X].$\n\n*Hint: You may assume that $\\text{E}[aX+bY]=a\\text{E}[X]+b\\text{E}[Y]$ for any random variables $X$ and $Y$ and constants $a$ and $b.$*" :question/worked-solution "First, we simplify using the hint and the properties of expected value:\n\n$$\n\\text{E}[9{X}^{2}+X]=9\\text{E}[{X}^{2}]+\\text{E}[X]\n$$\n\nFor a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ the $n$th raw moment of $X$ is given by\n\n$$\n\\text{E}[{X}^{n}]={\\int }_{S}{x}^{n}\\cdot f(x)\\,\\text{d}x.\n$$\n\nWe already know $\\text{E}[X].$ So, we compute the second raw moment of $X$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{S}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{x}^{2}\\cdot 4{x}^{3}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}4{x}^{5}\\,\\text{d}x \\\\  & ={\\frac{2{x}^{6}}{3}\\,|}_{0}^{1} \\\\  & =\\frac{2}{3}\\end{aligned}\n$$\n\nSubstituting $\\text{E}[X]=\\frac{4}{5}$ and $\\text{E}[{X}^{2}]=\\frac{2}{3}$ into the simplified expression, we conclude that\n\n$$\n\\begin{aligned}\\text{E}[9{X}^{2}+X] & =9\\text{E}[{X}^{2}]+\\text{E}[X] \\\\  & =9\\cdot \\frac{2}{3}+\\frac{4}{5} \\\\  & =6+\\frac{4}{5} \\\\  & =\\frac{34}{5}.\\end{aligned}\n$$"}]}
