44 #edb/ref 17592186045417] [17592186427358 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186427358 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186427358 #edb/ref 1078 #edb/ref 17592186427319 #edb/ref 17592186045417] [17592186427358 #edb/ref 1079 #uuid "f7aca109-b18a-57b5-90ec-bf719ba83078" #edb/ref 17592186045417] [17592186427359 #edb/ref 1075 #edb/ref 17592186427295 #edb/ref 17592186045417] [17592186427359 #edb/ref 1075 #edb/ref 17592186427311 #edb/ref 17592186045417] [17592186427359 #edb/ref 1075 #edb/ref 17592186427320 #edb/ref 17592186045417] [17592186427359 #edb/ref 1075 #edb/ref 17592186427335 #edb/ref 17592186045417] [17592186427359 #edb/ref 1075 #edb/ref 17592186427340 #edb/ref 17592186045417] [17592186427359 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186427359 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186427359 #edb/ref 1078 #edb/ref 17592186427335 #edb/ref 17592186045417] [17592186427359 #edb/ref 1079 #uuid "fe3f6c56-86fd-5d50-bf8e-6a665c9d1d81" #edb/ref 17592186045417] [17592186427360 #edb/ref 1068 #edb/ref 17592186427356 #edb/ref 17592186045417] [17592186427360 #edb/ref 1069 "q-152901" #edb/ref 17592186045417] [17592186427360 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186427360 #edb/ref 1071 "A continuous random variable $X$ has the probability density function \n\n$$\nf(x)=\\{\\begin{aligned}\\frac{2}{3}, & -1<x<0, \\\\ {x}^{2}, & 0\\le x<1.\\end{aligned}\n$$\n\nCalculate $\\text{E}[{X}^{2}].$" #edb/ref 17592186045417] [17592186427360 #edb/ref 1072 #uuid "10b4599a-65d6-546d-a1db-2b8fd1bfb09d" #edb/ref 17592186045417] [17592186427360 #edb/ref 1074 "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ the expected value of ${X}^{2}$ is given by\n\n$$\n\\text{E}[{X}^{2}]={\\int }_{S}{x}^{2}\\cdot f(x)\\,\\text{d}x.\n$$\n\nSo, we compute the expected value of ${X}^{2}$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{-1}^{1}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{-1}^{0}{x}^{2}\\cdot \\frac{2}{3}\\,\\text{d}x+{\\int }_{0}^{1}{x}^{2}\\cdot {x}^{2}\\,\\text{d}x \\\\  & =\\frac{2}{3}{\\int }_{-1}^{0}{x}^{2}\\,\\text{d}x+{\\int }_{0}^{1}{x}^{4}\\,\\text{d}x \\\\  & =\\frac{2}{9}\\,{x}^{3}\\,{|}_{-1}^{0}+\\frac{1}{5}\\,{x}^{5}\\,{|}_{0}^{1} \\\\  & =\\frac{2}{9}(0+1)+\\frac{1}{5}(1-0) \\\\  & =\\frac{2}{9}+\\frac{1}{5} \\\\  & =\\frac{19}{45}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186427361 #edb/ref 1068 #edb/ref 17592186427349 #edb/ref 17592186045417] [17592186427361 #edb/ref 1069 "q-152894" #edb/ref 17592186045417] [17592186427361 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186427361 #edb/ref 1071 "A continuous random variable $X$ has the probability density function \n\n$$\nf(x)=\\frac{5}{2\\sqrt{{x}^{7}}},\\,x\\ge 1.\n$$\n\nCalculate $\\text{E}[{X}^{2}].$" #edb/ref 17592186045417] [17592186427361 #edb/ref 1072 #uuid "2ced0c63-cf37-5cdb-ae0d-645ad331eb6b" #edb/ref 17592186045417] [17592186427361 #edb/ref 1074 "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ the expected value of ${X}^{2}$ is given by\n\n$$\n\\text{E}[{X}^{2}]={\\int }_{S}{x}^{2}\\cdot f(x)\\,\\text{d}x.\n$$\n\nWe compute the expected value of ${X}^{2}$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{1}^{\\infty }{x}^{2}\\cdot \\frac{5}{2\\sqrt{{x}^{7}}}\\,\\text{d}x \\\\  & =\\frac{5}{2}{\\int }_{1}^{\\infty }{x}^{-3/2}\\,\\text{d}x \\\\  & =\\frac{5}{2}{lim}_{a\\to \\infty }{\\int }_{1}^{a}{x}^{-3/2}\\,\\text{d}x \\\\  & =\\frac{5}{2}{lim}_{a\\to \\infty }{(-2{x}^{-1/2})|}_{1}^{a} \\\\  & =-5{lim}_{a\\to \\infty }{(\\frac{1}{\\sqrt{x}})|}_{1}^{a} \\\\  & =-5{lim}_{a\\to \\infty }(\\frac{1}{\\sqrt{a}}-1) \\\\  & =-5(0-1) \\\\  & =5\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186427362 #edb/ref 1068 #edb/ref 17592186427358 #edb/ref 17592186045417] [17592186427362 #edb/ref 1069 "q-152916" #edb/ref 17592186045417] [17592186427362 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186427362 #edb/ref 1071 "A continuous random variable $X$ has the probability density function \n\n$$\nf(x)=\\frac{2}{{x}^{2}},\\,1\\le x\\le 2.\n$$\n\nCalculate $\\text{E}[{X}^{5}].$" #edb/ref 17592186045417] [17592186427362 #edb/ref 1072 #uuid "2dabf35b-e60b-5d7b-a653-f44f57203be2" #edb/ref 17592186045417] [17592186427362 #edb/ref 1074 "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ the $n$th raw moment of $X$ is given by\n\n$$\n\\text{E}[{X}^{n}]={\\int }_{S}{x}^{n}\\cdot f(x)\\,\\text{d}x.\n$$\n\nSo, we compute the fifth raw moment of $X$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{5}] & ={\\int }_{1}^{2}{x}^{5}\\cdot \\frac{2}{{x}^{2}}\\,\\text{d}x \\\\  & =2{\\int }_{1}^{2}{x}^{3}\\,\\text{d}x \\\\  & =\\frac{1}{2}\\,{x}^{4}\\,{|}_{1}^{2} \\\\  & =\\frac{1}{2}(16-1) \\\\  & =\\frac{15}{2}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186427363 #edb/ref 1068 #edb/ref 17592186427353 #edb/ref 17592186045417] [17592186427363 #edb/ref 1069 "q-152918" #edb/ref 17592186045417] [17592186427363 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186427363 #edb/ref 1071 "A continuous random variable $X$ has the probability density function \n\n$$\nf(x)=\\frac{1}{2},\\,0\\le x\\le 2.\n$$\n\nCalculate $\\text{E}[{X}^{5}].$" #edb/ref 17592186045417] [17592186427363 #edb/ref 1072 #uuid "4c7b6764-ca2b-56e1-8efb-c299f7c5895e" #edb/ref 17592186045417] [17592186427363 #edb/ref 1074 "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ the $n$th raw moment of $X$ is given by\n\n$$\n\\text{E}[{X}^{n}]={\\int }_{S}{x}^{n}\\cdot f(x)\\,\\text{d}x.\n$$\n\nSo, we compute the fifth raw moment of $X$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{5}] & ={\\int }_{0}^{2}{x}^{5}\\cdot \\frac{1}{2}\\,\\text{d}x \\\\  & =\\