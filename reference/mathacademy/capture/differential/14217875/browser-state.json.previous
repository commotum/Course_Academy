<mjx-c class=\"mjx-c33\"></mjx-c><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-texatom></mjx-script></mjx-msub><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mstyle style=\"border: 1px solid lightgray;\" space=\"4\"><mjx-mpadded><mjx-block style=\"width: 2.078em; margin: 0.4em 0px; position: relative;\"><mjx-rbox style=\"left: 0.4em; top: 0px; max-width: 2.078em;\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2212\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-rbox></mjx-block></mjx-mpadded></mjx-mstyle><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mi>∂</mi><msub><mi>f</mi><mn>2</mn></msub></mrow><mrow><mi>∂</mi><msub><mi>a</mi><mrow data-mjx-texclass=\"ORD\"><mn>22</mn></mrow></msub></mrow></mfrac></mstyle><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mi>∂</mi><mrow><mi>∂</mi><msub><mi>a</mi><mrow data-mjx-texclass=\"ORD\"><mn>22</mn></mrow></msub></mrow></mfrac></mstyle><mo stretchy=\"false\">(</mo><mn>2</mn><msub><mi>a</mi><mrow data-mjx-texclass=\"ORD\"><mn>12</mn></mrow></msub><mo>−</mo><mn>2</mn><msub><mi>a</mi><mrow data-mjx-texclass=\"ORD\"><mn>22</mn></mrow></msub><mo>+</mo><mn>3</mn><msub><mi>a</mi><mrow data-mjx-texclass=\"ORD\"><mn>32</mn></mrow></msub><mo stretchy=\"false\">)</mo><mo>=</mo><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mo>−</mo><mn>2</mn></mpadded></mstyle><mo>.</mo></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
