#{[{:db/id #edb/ref 17592186521565 :knowledge-point/_questions [{:db/id #edb/ref 17592186184322 :knowledge-point/id #uuid "2a85fece-e40f-543c-b3c3-ae43a5175808" :knowledge-point/title "Completing the Square When the Leading Coefficient is Negative One: Odd Linear Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0eaa7604-4ed0-50fc-bc63-54add54bc183" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{2}+{(y+\\frac{3}{2})}^{2}" :db/id #edb/ref 17592186520793} {:answer/id #uuid "5111c904-bf94-52bf-b690-08709ab8e4c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "76-{(y+9)}^{2}" :db/id #edb/ref 17592186520949} {:answer/id #uuid "72adf21a-5264-5a28-871d-6fe472489501" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{4}-{(y+\\frac{3}{2})}^{2}" :db/id #edb/ref 17592186521020} {:answer/id #uuid "76a0b804-79e8-5a39-9b18-44d9503bab79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{29}{4}-{(y-\\frac{3}{2})}^{2}" :db/id #edb/ref 17592186521026} {:answer/id #uuid "e13d59b2-3319-54ab-bbb7-cf745495f661" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{11}{4}-{(y+\\frac{3}{2})}^{2}" :db/id #edb/ref 17592186521268}] :answer-field/correct {:answer/id #uuid "e13d59b2-3319-54ab-bbb7-cf745495f661" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{11}{4}-{(y+\\frac{3}{2})}^{2}" :db/id #edb/ref 17592186521268} :answer-field/id #uuid "2878baeb-9a33-5803-8177-df4c02bc48c2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186521346}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "edbc0b13-6a6e-5c66-aaa8-e675f3a4a51e" :question/math-academy-id "q-140409" :question/problem "Rewrite $-{y}^{2}-3y-5$ by completing the square." :question/worked-solution "Notice that the leading coefficient is $-1.$ So, we take out a factor of $-1$ from the entire expression:\n\n$$\n-({y}^{2}+3y+5)\n$$\n\nLet's now complete the square for the expression inside the parentheses:\n\n$$\n{y}^{2}+3y+5\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{y}^{2}+2\\cdot \\frac{3}{2}y+5\n$$\n\nThen, we *add* and *then subtract* ${(\\frac{3}{2})}^{2},$ writing the constant term $5$ last:\n\n$$\n{{y}^{2}+2\\cdot \\frac{3}{2}y+{(\\frac{3}{2})}^{2}}_{⏟}-{(\\frac{3}{2})}^{2}+5\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(y+\\frac{3}{2})}^{2}-{(\\frac{3}{2})}^{2}+5\n$$\n\nEvaluating the last two terms, we get\n\n$$\n{(y+\\frac{3}{2})}^{2}+\\frac{11}{4}.\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}-{y}^{2}-3y-5 & =-({(y+\\frac{3}{2})}^{2}+\\frac{11}{4}) \\\\  & =-\\frac{11}{4}-{(y+\\frac{3}{2})}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186521467 :knowledge-point/_questions [{:db/id #edb/ref 17592186184212 :knowledge-point/id #uuid "3202d7cc-541b-553b-8ec1-d4ea85dd0590" :knowledge-point/title "Completing the Square on an Expression With a Negative Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "468992e9-ad98-5e6d-b726-dd3130a61cee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8{(z+\\frac{3}{4})}^{2}+\\frac{1}{4}" :db/id #edb/ref 17592186520921} {:answer/id #uuid "7fd828f8-42ce-5777-935d-cf7d0ddd6df5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8{(z+\\frac{3}{4})}^{2}+4" :db/id #edb/ref 17592186521057} {:answer/id #uuid "9b6a8bed-d21d-52be-9870-71f5031347b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8{(z-\\frac{3}{2})}^{2}+2" :db/id #edb/ref 17592186521116} {:answer/id #uuid "c85bb9fd-5526-511a-8a6a-c2514cf0251b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8{(z+\\frac{3}{4})}^{2}+1" :db/id #edb/ref 17592186521212} {:answer/id #uuid "d5002f69-b154-569c-9f75-ac522a011347" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8{(z-\\frac{3}{2})}^{2}+\\frac{1}{2}" :db/id #edb/ref 17592186521242}] :answer-field/correct {:answer/id #uuid "c85bb9fd-5526-511a-8a6a-c2514cf0251b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8{(z+\\frac{3}{4})}^{2}+1" :db/id #edb/ref 17592186521212} :answer-field/id #uuid "b57e8dee-3a1b-5eb0-a0a9-8388e98ff9a1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186521417}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "20662b40-9142-5228-b622-edf8a16af72c" :question/math-academy-id "q-140476" :question/problem "Rewrite $-8{z}^{2}-12z-\\frac{7}{2}$ by completing the square." :question/worked-solution "Notice that the leading coefficient is $-8.$ So, we take out a factor of $-8$ from the entire expression:\n\n$$\n-8({z}^{2}+\\frac{3}{2}z+\\frac{7}{16})\n$$\n\nLet's now complete the square for the expression inside the parentheses:\n\n$$\n{z}^{2}+\\frac{3}{2}z+\\frac{7}{16}\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{z}^{2}+2\\cdot \\frac{3}{4}\\cdot z+\\frac{7}{16}\n$$\n\nThen, we *add* and *then subtract* ${(\\frac{3}{4})}^{2},$ writing the constant term $\\frac{7}{16}$ last:\n\n$$\n{{z}^{2}+2\\cdot \\frac{3}{4}\\cdot z+{(\\frac{3}{4})}^{2}}_{⏟}-{(\\frac{3}{4})}^{2}+\\frac{7}{16}\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(z+\\frac{3}{4})}^{2}-{(\\frac{3}{4})}^{2}+\\frac{7}{16}\n$$\n\nEvaluating the last two terms, we get\n\n$$\n{(z+\\frac{3}{4})}^{2}-\\frac{1}{8}.\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}-8({z}^{2}+\\frac{3}{2}z+\\frac{7}{16}) & =-8({(z+\\frac{3}{4})}^{2}-\\frac{1}{8}) \\\\  & =-8{(z+\\frac{3}{4})}^{2}+(-8)\\cdot (-\\frac{1}{8}) \\\\  & =-8{(z+\\frac{3}{4})}^{2}+1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186521522 :knowledge-point/_questions [{:db/id #edb/ref 17592186184322 :knowledge-point/id #uuid "2a85fece-e40f-543c-b3c3-ae43a5175808" :knowledge-point/title "Completing the Square When the Leading Coefficient is Negative One: Odd Linear Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f8b64d1a-7608-5a86-ab17-d145feb343f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{4}" :db/id #edb/ref 17592186521308}] :answer-field/correct {:answer/id #uuid "f8b64d1a-7608-5a86-ab17-d145feb343f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{4}" :db/id #edb/ref 17592186521308} :answer-field/id #uuid "7eb427c0-14cf-57c4-87a9-e84597ae69e6" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186521386} {:answer-field/choices [{:answer/id #uuid "d75106f5-9234-558c-a391-c36bbf650407" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186521245}] :answer-field/correct {:answer/id #uuid "d75106f5-9234-558c-a391-c36bbf650407" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186521245} :answer-field/id #uuid "90dc3305-1623-5c23-9c54-7ae3dcbc7551" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186521398}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8c5fa084-327e-5d66-96c0-960c479aa7b9" :question/math-academy-id "q-218663" :question/problem "Rewrite $-({z}^{2}+z+2)$ by completing the square.\n\n$-({z}^{2}+z+2)=-(z\\,+$\n{{field-1}}\n$)^{2}\\,-$\n{{field-2}}" :question/worked-solution "We begin by completing the square for the expression inside the parentheses:\n\n$$\n{z}^{2}+z+2\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{z}^{2}+2\\cdot \\frac{1}{2}z+2\n$$\n\nThen, we *add* and *then subtract* ${(\\frac{1}{2})}^{2},$ writing the constant term $2$ last:\n\n$$\n{{z}^{2}+2\\cdot \\frac{1}{2}z+{(\\frac{1}{2})}^{2}}_{⏟}-{(\\frac{1}{2})}^{2}+2\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(z+\\frac{1}{2})}^{2}-{(\\frac{1}{2})}^{2}+2\n$$\n\nEvaluating the last two terms, we get\n\n$$\n{(z+\\frac{1}{2})}^{2}+\\frac{7}{4}.\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}-({z}^{2}+z+2) & =-({(z+\\frac{1}{2})}^{2}+\\frac{7}{4}) \\\\  & =-{(z+\\frac{1}{2})}^{2}-\\frac{7}{4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290358 :knowledge-point/_questions [{:db/id #edb/ref 17592186184323 :knowledge-point/id #uuid "564f2cf7-aaaf-5dea-b619-a560c3151fcc" :knowledge-point/title "Completing the Square on an Expression With a Positive Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c46ce32-bfb4-59b1-8c45-4b802c060103" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186288123}] :answer-field/correct {:answer/id #uuid "0c46ce32-bfb4-59b1-8c45-4b802c060103" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186288123} :answer-field/id #uuid "3b4ac515-022f-515e-b805-31a391237daf" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289857} {:answer-field/choices [{:answer/id #uuid "548fc6ac-b128-5b5f-a1cb-e95b2acbe9c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186288615}] :answer-field/correct {:answer/id #uuid "548fc6ac-b128-5b5f-a1cb-e95b2acbe9c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186288615} :answer-field/id #uuid "40666057-5be2-580b-9847-e7d022ff0f2d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289874} {:answer-field/choices [{:answer/id #uuid "77483c12-fdf3-5046-999c-0c3ee2fffd18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186288854}] :answer-field/correct {:answer/id #uuid "77483c12-fdf3-5046-999c-0c3ee2fffd18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186288854} :answer-field/id #uuid "71a33f47-6b1e-5c84-b1c2-76b8a9ae9fba" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289979}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a16b1eda-c529-5caa-8c46-16ed1020b267" :question/math-academy-id "q-218756" :question/problem "Rewrite $6{p}^{2}-12p+7$ by completing the square.\n\n$6{p}^{2}-12p+7=$\n{{field-1}}\n$(p\\,-$\n{{field-2}}\n$)^{2}\\,+$\n{{field-3}}" :question/worked-solution "Notice that the leading coefficient is $6.$ So, we take out a factor of $6$ from the entire expression:\n\n$$\n6({p}^{2}-2p+\\frac{7}{6})\n$$\n\nLet's now complete the square for the expression inside the parentheses:\n\n$$\n{p}^{2}-2p+\\frac{7}{6}\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{p}^{2}-2\\cdot 1p+\\frac{7}{6}\n$$\n\nThen, we *add* and *then subtract* ${1}^{2},$ writing the constant term $\\frac{7}{6}$ last:\n\n$$\n{{p}^{2}-2\\cdot 1p+{1}^{2}}_{⏟}-\\,{1}^{2}+\\frac{7}{6}\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n(p-1)^{2}-{1}^{2}+\\frac{7}{6}\n$$\n\nEvaluating the last two terms, we get\n\n$$\n(p-1)^{2}+\\frac{1}{6}.\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}6({p}^{2}-2p+\\frac{7}{6}) & =6({(p-1)}^{2}+\\frac{1}{6}) \\\\  & =6{(p-1)}^{2}+6\\cdot \\frac{1}{6} \\\\  & =6{(p-1)}^{2}+1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186521557 :knowledge-point/_questions [{:db/id #edb/ref 17592186184212 :knowledge-point/id #uuid "3202d7cc-541b-553b-8ec1-d4ea85dd0590" :knowledge-point/title "Completing the Square on an Expression With a Negative Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14b2d8e5-9b5c-5216-aeff-851b31557845" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{(x+3)}^{2}+\\frac{17}{2}" :db/id #edb/ref 17592186520812} {:answer/id #uuid "7c027f5d-f2be-54c0-ba10-816c2c3c2421" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{(x+\\frac{3}{2})}^{2}+\\frac{17}{2}" :db/id #edb/ref 17592186521046} {:answer/id #uuid "8cc48979-59bf-5cf0-ab38-814855efe50d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{(x+\\frac{3}{2})}^{2}+\\frac{9}{2}" :db/id #edb/ref 17592186521084} {:answer/id #uuid "d260d6cd-2693-5fac-b2ee-6098a1ef0f98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{(2x+3)}^{2}+17" :db/id #edb/ref 17592186521236} {:answer/id #uuid "f242b273-5aa7-5a27-95c1-4f47737537b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{(x+\\frac{3}{2})}^{2}-\\frac{15}{4}" :db/id #edb/ref 17592186521296}] :answer-field/correct {:answer/id #uuid "7c027f5d-f2be-54c0-ba10-816c2c3c2421" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{(x+\\frac{3}{2})}^{2}+\\frac{17}{2}" :db/id #edb/ref 17592186521046} :answer-field/id #uuid "ece1c1a9-e6aa-5e0f-8f5d-a9fac0d03848" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186521446}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "db65568c-c0a4-5de2-8240-a716b187636f" :question/math-academy-id "q-25250" :question/problem "Rewrite $-2{x}^{2}-6x+4$ by completing the square." :question/worked-solution "Notice that the leading coefficient is $-2.$ So, we take out a factor of $-2$ from the entire expression:\n\n$$\n-2({x}^{2}+3x-2)\n$$\n\nLet's now complete the square for the expression inside the parentheses:\n\n$$\n{x}^{2}+3x-2\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{x}^{2}+2\\cdot \\frac{3}{2}x-2\n$$\n\nThen, we *add* and *then subtract* ${(\\frac{3}{2})}^{2},$ writing the constant term $2$ last:\n\n$$\n{{x}^{2}+2\\cdot \\frac{3}{2}x+{(\\frac{3}{2})}^{2}}_{⏟}-{(\\frac{3}{2})}^{2}-2\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(x+\\frac{3}{2})}^{2}-{(\\frac{3}{2})}^{2}-2\n$$\n\nEvaluating the last two terms, we get\n\n$$\n{(x+\\frac{3}{2})}^{2}-\\frac{17}{4}\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}-2({x}^{2}+3x-2) & =-2({(x+\\frac{3}{2})}^{2}-\\frac{17}{4}) \\\\  & =-2{(x+\\frac{3}{2})}^{2}+(-2)\\cdot (-\\frac{17}{4}) \\\\  & =-2{(x+\\frac{3}{2})}^{2}+\\frac{17}{2}\\end{aligned}\n$$"}]}
