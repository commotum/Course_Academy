#{[{:db/id #edb/ref 17592186496250 :knowledge-point/_questions [{:db/id #edb/ref 17592186129188 :knowledge-point/id #uuid "8505beff-75b8-57bf-9312-e0fcf32f44fd" :knowledge-point/title "Using Additivity of Double Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29cb87ec-7b62-54a3-9b91-6761bf4ff971" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186495602} {:answer/id #uuid "32a207e8-72fc-5597-b6e1-52b672dc0edb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186495627} {:answer/id #uuid "64babd30-e58f-5686-b182-18182e671ea5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186495734} {:answer/id #uuid "79a8bba4-a404-5ef1-853e-20b00d2df235" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186495772} {:answer/id #uuid "ec45ef3b-c17c-5ae2-8f29-beba53a099ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186496028}] :answer-field/correct {:answer/id #uuid "79a8bba4-a404-5ef1-853e-20b00d2df235" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186495772} :answer-field/id #uuid "25cf7a13-0b14-5e86-98cd-0f8088bad90b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186496091}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4896f06f-886c-5ec8-9b07-a29fce8c9f73" :question/math-academy-id "q-130021" :question/problem "Given that $C$ and $D$ are finite, non-overlapping regions and that\n\n$$\n{∬}_{C}f(x,y)\\text{ }\\text{d}A=2,\\,{∬}_{D}f(x,y)\\text{ }\\text{d}A=7,\n$$\n\nfind the value of \n\n$$\n{∬}_{C\\cup D}\\frac{1}{3}f(x,y)\\text{ }\\text{d}A.\n$$" :question/worked-solution "Using the linearity and additivity of double integrals, we get the following:\n\n$$\n\\begin{aligned}{∬}_{C\\cup D}5f(x,y)\\text{ }\\text{d}A & =\\frac{1}{3}{∬}_{C\\cup D}f(x,y)\\text{ }\\text{d}A \\\\  & =\\frac{1}{3}({∬}_{C}f(x,y)\\text{ }\\text{d}A+{∬}_{D}f(x,y)\\text{ }\\text{d}A) \\\\  & =\\frac{1}{3}(7+2) \\\\  & =3\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186496247 :knowledge-point/_questions [{:db/id #edb/ref 17592186129188 :knowledge-point/id #uuid "8505beff-75b8-57bf-9312-e0fcf32f44fd" :knowledge-point/title "Using Additivity of Double Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4cd94ac7-3795-5961-a7c1-57dd5b247105" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{∬}_{S}{e}^{x}\\,\\text{d}A+{∬}_{T}x\\,\\text{d}A+{∬}_{U}({x}^{2}+y)\\text{d}A" :db/id #edb/ref 17592186495685} {:answer/id #uuid "683d5a4b-306a-5d43-8f8c-20fb207ba1ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{∬}_{S}y{e}^{x}\\,\\text{d}A+{∬}_{T}{x}^{2}\\,\\text{d}A+{∬}_{U}\\text{d}A" :db/id #edb/ref 17592186495740} {:answer/id #uuid "9d9d4d09-68ab-514c-8c81-4e473a25d36e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{∬}_{S}{e}^{x}\\,\\text{d}A+{∬}_{T}({x}^{2}+y)\\text{d}A+{∬}_{U}x\\,\\text{d}A" :db/id #edb/ref 17592186495863} {:answer/id #uuid "a3b9981d-d744-5f2e-820e-320f4ec86a5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{∬}_{S}{e}^{x}\\,\\text{d}A+{∬}_{T}({x}^{2}+y)\\text{d}A" :db/id #edb/ref 17592186495876} {:answer/id #uuid "b2b195e5-7146-58b0-bd21-eaaacb148632" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{∬}_{S}({x}^{2}+y)\\text{d}A+{∬}_{T}{e}^{x}\\,\\text{d}A+{∬}_{U}\\text{d}A" :db/id #edb/ref 17592186495913}] :answer-field/correct {:answer/id #uuid "a3b9981d-d744-5f2e-820e-320f4ec86a5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{∬}_{S}{e}^{x}\\,\\text{d}A+{∬}_{T}({x}^{2}+y)\\text{d}A" :db/id #edb/ref 17592186495876} :answer-field/id #uuid "89e973d3-c94c-5288-b1d4-40bdaaeee25a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186496142}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3fc1b49a-d775-540a-9853-9d70731cf1c0" :question/math-academy-id "q-80656" :question/problem "![](images/5c/5c6e4deccce395f5bdc8aadef8cd2c712804235c340ccae174f2067211a5a49c.png)\n\nConsider the region $R$ shown above. Let the function $f(x,y)$ be defined as\n\n$$\nf(x,y)=\\{\\begin{aligned}{e}^{x}, & (x,y)\\in S, \\\\ {x}^{2}+y, & (x,y)\\in T, \\\\ 0, & (x,y)\\in U.\\end{aligned}\n$$\n\nThen,\n\n$$\n{∬}_{R}f(x,y)\\text{ }\\text{d}A=\n$$" :question/worked-solution "First, notice that the domain $R$ can be represented as a union of three sub-domains, as follows:\n\n$$\n\\begin{aligned}R & =S\\cup T\\cup U.\\end{aligned}\n$$\n\nSo, we can write\n\n$$\n\\begin{aligned}{∬}_{R}f(x,y)\\,\\text{d}A & ={∬}_{S}f(x,y)\\,\\text{d}A+{∬}_{T}f(x,y)\\,\\text{d}A+{∬}_{U}f(x,y)\\,\\text{d}A \\\\  & ={∬}_{S}{e}^{x}\\,\\text{d}A+{∬}_{T}({x}^{2}+y)\\text{d}A+{∬}_{U}0\\,\\text{d}A \\\\  & ={∬}_{S}{e}^{x}\\,\\text{d}A+{∬}_{T}({x}^{2}+y)\\text{d}A.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186496248 :knowledge-point/_questions [{:db/id #edb/ref 17592186129172 :knowledge-point/id #uuid "8059a197-e9fb-5306-8eed-62c0cea88f33" :knowledge-point/title "Evaluating a Double Integral Using the Additivity Over a Rectangular Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21bb7e4f-4f89-5de1-95f7-da1922b3e4eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+{e}^{2}+e" :db/id #edb/ref 17592186495583} {:answer/id #uuid "4abebdbc-99ae-50c0-a512-0a23de882c10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\frac{e}{2}" :db/id #edb/ref 17592186495682} {:answer/id #uuid "714c7021-6f5d-5cb3-9a9a-f76210471846" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-{e}^{2}" :db/id #edb/ref 17592186495759} {:answer/id #uuid "b0e8c850-fb04-565b-82b5-6a4a220870b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+{e}^{2}" :db/id #edb/ref 17592186495906} {:answer/id #uuid "d2b29483-e8e2-58c0-b501-11ed5e1de262" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+{e}^{2}-e" :db/id #edb/ref 17592186495970}] :answer-field/correct {:answer/id #uuid "d2b29483-e8e2-58c0-b501-11ed5e1de262" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+{e}^{2}-e" :db/id #edb/ref 17592186495970} :answer-field/id #uuid "5f162e99-d897-57bf-9c7b-c3f9fc5e3dae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186496123}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "426d96cd-8cff-562b-8539-4a443da3b8d7" :question/math-academy-id "q-80668" :question/problem "Evaluate the double integral ${∬}_{R}f(x,y)\\,\\text{d}A$, where\n\n$$\nf(x,y)=\\{\\begin{aligned}3{x}^{2},\\, & \\text{if}\\,0<x<1,\\,0<y<1, \\\\ 2x\\text{ }\\,{e}^{y},\\, & \\text{if}\\,0<x<1,\\,1<y<2,\\end{aligned}\n$$\n\nand  $R$ is the domain of $f.$" :question/worked-solution "First, notice that we have $R={R}_{1}\\cup {R}_{2}$, where ${R}_{1}=(0,1)\\times (0,1)$ and ${R}_{2}=(0,1)\\times (1,2).$ So, we can write\n\n$$\n\\begin{aligned}{∬}_{R}f(x,y)\\,\\text{d}A & ={∬}_{{R}_{1}}f(x,y)\\,\\text{d}A+{∬}_{{R}_{2}}f(x,y)\\,\\text{d}A \\\\  & ={∬}_{{R}_{1}}3{x}^{2}\\,\\text{d}A+{∬}_{{R}_{2}}2x\\text{ }\\,{e}^{y}\\,\\text{d}A \\\\  & =(1-0){\\int }_{0}^{1}3{x}^{2}\\,\\text{d}y+({\\int }_{0}^{1}2x\\,\\text{d}x)({\\int }_{1}^{2}{e}^{y}\\,\\text{d}y) \\\\  & ={x}^{3}{|}_{0}^{1}+({x}^{2}{|}_{0}^{1})\\cdot ({e}^{y}{|}_{1}^{2}) \\\\  & =1+1\\cdot ({e}^{2}-{e}^{1}) \\\\  & =1+{e}^{2}-e.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186382448 :knowledge-point/_questions [{:db/id #edb/ref 17592186129171 :knowledge-point/id #uuid "307bccb6-036f-51bb-99ce-327aad8dfdbe" :knowledge-point/title "Evaluating a Double Integral When the Integrand Contains Only One Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51a89715-7a54-5300-819b-fa080b061464" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186382450} {:answer/id #uuid "56fb164e-39a3-5e17-815d-ec81eaeb5642" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186382451} {:answer/id #uuid "a9cb3d91-b5e5-5157-8a43-6dd0b3fbf045" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "72" :db/id #edb/ref 17592186382452} {:answer/id #uuid "8cf0027f-33d6-5dec-9265-dd1640066c6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186382453} {:answer/id #uuid "5f806e22-cdeb-5e59-8750-426e910009d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186382454}] :answer-field/correct {:answer/id #uuid "5f806e22-cdeb-5e59-8750-426e910009d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186382454} :answer-field/id #uuid "d2ffc185-1273-5e29-8ff4-7540cee84426" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382449}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c9713fa5-57af-5823-80a4-91a27fbe3a41" :question/math-academy-id "q-81244" :question/problem "Calculate ${∬}_{R}({x}^{2}-y+1)\\,\\text{d}A$,  where $R=[-3,0]\\times [0,4].$" :question/worked-solution "Using the linearity property of double integrals, we can write\n\n$$\n\\begin{aligned}{∬}_{R}({x}^{2}-y+1)\\,\\text{d}A & ={∬}_{R}{x}^{2}\\text{ }\\text{d}A-{∬}_{R}y\\text{ }\\text{d}A+{∬}_{R}\\text{d}A.\\end{aligned}\n$$\n\nThe function under the first integral is independent of $y.$ So, we have \n\n$$\n\\begin{aligned}{∬}_{R}{x}^{2}\\text{ }\\text{d}A & =(4-0){\\int }_{-3}^{0}{x}^{2}\\,\\text{d}x \\\\  & =4[\\frac{{x}^{3}}{3}]_{-3}^{0} \\\\  & =4(\\frac{{0}^{3}}{3}-\\frac{(-3)^{3}}{3}) \\\\  & =36.\\end{aligned}\n$$\n\nThe function under the second integral is independent of $x.$ So, we have \n\n$$\n\\begin{aligned}{∬}_{R}y\\text{ }\\text{d}A & =(0-(-3)){\\int }_{0}^{4}y\\,\\text{d}y \\\\  & =3[\\frac{{y}^{2}}{2}]_{0}^{4} \\\\  & =3(\\frac{{4}^{2}}{2}-\\frac{{0}^{2}}{2}) \\\\  & =24.\\end{aligned}\n$$\n\nThe third integral is the double integral of unity:\n\n$$\n\\begin{aligned}{∬}_{R}\\text{d}A=\\text{Area}(R)=3\\cdot 4=12\\end{aligned}\n$$\n\n \n\nFinally, combining our results, we obtain\n\n$$\n\\begin{aligned}{∬}_{R}({x}^{2}-y+1)\\,\\text{d}A=36-24+12=24.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186382462 :knowledge-point/_questions [{:db/id #edb/ref 17592186129172 :knowledge-point/id #uuid "8059a197-e9fb-5306-8eed-62c0cea88f33" :knowledge-point/title "Evaluating a Double Integral Using the Additivity Over a Rectangular Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "424c1725-f6be-557b-8ba1-de6cd2c48a82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186382464} {:answer/id #uuid "ad38cb99-0e64-5f96-baca-e7d0549cba5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186382465} {:answer/id #uuid "1e089d84-f069-5f2c-83fa-ebc8d830878a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186382466} {:answer/id #uuid "c6fc8d95-fed9-543b-84f8-e46cb703d09b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186382467} {:answer/id #uuid "9f1aadd1-ba01-5e68-a02a-c2ed4e7c1f65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186382468}] :answer-field/correct {:answer/id #uuid "ad38cb99-0e64-5f96-baca-e7d0549cba5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186382465} :answer-field/id #uuid "d86e0dfb-0f1e-5397-8c0c-93b6e0bbf141" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382463}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "265058e2-39b1-59f9-b955-fd7951910713" :question/math-academy-id "q-81253" :question/problem "Evaluate the double integral ${∬}_{R}f(x,y)\\,\\text{d}A$, where\n\n$$\nf(x,y)=\\{\\begin{aligned}\\operatorname{cos}⁡y,\\, & \\text{if}\\,-1<x<1,\\,0<y<\\pi , \\\\ x\\operatorname{sin}⁡y,\\, & \\text{if}\\,1<x<2,\\,0<y<\\pi ,\\end{aligned}\n$$\n\nand  $R$ is the domain of $f.$" :question/worked-solution "First, notice that we have $R={R}_{1}\\cup {R}_{2}$, where ${R}_{1}=(-1,1)\\times (0,\\pi )$ and ${R}_{2}=(1,2)\\times (0,\\pi ).$ So, we can write\n\n$$\n\\begin{aligned}{∬}_{R}f(x,y)\\,\\text{d}A= & ={∬}_{{R}_{1}}f(x,y)\\,\\text{d}A+{∬}_{{R}_{2}}f(x,y)\\,\\text{d}A \\\\  & ={∬}_{{R}_{1}}\\operatorname{cos}⁡y\\,\\text{d}A+{∬}_{{R}_{2}}x\\operatorname{sin}⁡y\\,\\text{d}A \\\\  & =(1-(-1)){\\int }_{0}^{\\pi }\\operatorname{cos}⁡y\\,\\text{d}y+({\\int }_{1}^{2}x\\,\\text{d}x)({\\int }_{0}^{\\pi }\\operatorname{sin}⁡y\\,\\text{d}y) \\\\  & =2[\\operatorname{sin}⁡y]_{0}^{\\pi }+[\\frac{{x}^{2}}{2}]_{1}^{2}\\cdot [-\\operatorname{cos}⁡y]_{0}^{\\pi } \\\\  & =2(0)+(2-\\frac{1}{2})\\cdot (-(-1)+1) \\\\  & =3.\\end{aligned}\n$$"}]}
