417] [17592186572115 #edb/ref 1072 #uuid "196e0964-4e1e-5145-bb69-08bef197b0a6" #edb/ref 17592186045417] [17592186572115 #edb/ref 1074 "To find $\\frac{{∂}^{2}f}{∂x∂y}$ we differentiate the given first-order partial derivative $\\frac{∂f}{∂y}$ with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(\\frac{∂f}{∂y}) \\\\  & =\\frac{∂}{∂x}(-\\frac{xy}{{x}^{2}+{y}^{2}}) \\\\  & =-y\\cdot \\frac{∂}{∂x}(\\frac{x}{{x}^{2}+{y}^{2}}) \\\\  & =-y(\\frac{1}{{x}^{2}+{y}^{2}}-\\frac{2{x}^{2}}{({x}^{2}+{y}^{2})^{2}}) \\\\  & =-y(\\frac{({x}^{2}+{y}^{2})-2{x}^{2}}{({x}^{2}+{y}^{2})^{2}}) \\\\  & =\\frac{y({x}^{2}-{y}^{2})}{({x}^{2}+{y}^{2})^{2}}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186572140 #edb/ref 1068 #edb/ref 17592186572082 #edb/ref 17592186045417] [17592186572140 #edb/ref 1069 "q-80476" #edb/ref 17592186045417] [17592186572140 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186572140 #edb/ref 1071 "Calculate ${f}_{yyx}(x,y)$ given that $f(x,y)=x\\operatorname{ln}⁡(x+y).$" #edb/ref 17592186045417] [17592186572140 #edb/ref 1072 #uuid "69504aad-b4b4-5456-a945-74b303c69a26" #edb/ref 17592186045417] [17592186572140 #edb/ref 1074 "First, we find the first-order derivative ${g}_{y}(x,y):$ \n\n$$\n\\begin{aligned}{g}_{y}(x,y) & =\\frac{∂}{∂y}(x\\operatorname{ln}⁡(x+y)) \\\\  & =\\frac{x}{x+y}\\end{aligned}\n$$\n\nNext, we find ${g}_{yy}(x,y)$ by differentiating ${g}_{y}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{g}_{yy}(x,y) & =\\frac{∂}{∂y}({g}_{y}(x,y)) \\\\  & =\\frac{∂}{∂y}(\\frac{x}{x+y}) \\\\  & =-\\frac{x}{(x+y)^{2}}\\end{aligned}\n$$\n\nFinally, we find ${g}_{yyx}(x,y)$ by differentiating ${g}_{yy}(x,y)$ with respect to $x:$ \n\n$$\n\\begin{aligned}{g}_{yyx}(x,y) & =\\frac{∂}{∂x}({g}_{yy}(x,y)) \\\\  & =\\frac{∂}{∂x}(-\\frac{x}{(x+y)^{2}}) \\\\  & =-\\frac{1}{(x+y)^{2}}+\\frac{2x}{(x+y)^{3}} \\\\  & =\\frac{-(x+y)+2x}{(x+y)^{3}} \\\\  & =\\frac{x-y}{(x+y)^{3}}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186572145 #edb/ref 1068 #edb/ref 17592186572030 #edb/ref 17592186045417] [17592186572145 #edb/ref 1069 "q-132768" #edb/ref 17592186045417] [17592186572145 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186572145 #edb/ref 1071 "For the function $f(x,y),$ calculate $\\frac{{∂}^{2}f}{∂x∂y}$ given that $\\frac{∂f}{∂y}=\\frac{3{y}^{2}}{\\sqrt{2x+{y}^{3}}}.$" #edb/ref 17592186045417] [17592186572145 #edb/ref 1072 #uuid "79ed868a-e284-5768-82e1-d5ebe657fd93" #edb/ref 17592186045417] [17592186572145 #edb/ref 1074 "To find $\\frac{{∂}^{2}f}{∂x∂y}$ we differentiate the given first-order partial derivative $\\frac{∂f}{∂y}$ with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(\\frac{∂f}{∂y}) \\\\  & =\\frac{∂}{∂x}(\\frac{3{y}^{2}}{\\sqrt{2x+{y}^{3}}}) \\\\  & =3{y}^{2}\\cdot \\frac{∂}{∂x}((2x+{y}^{3})^{-1/2}) \\\\  & =3{y}^{2}(-\\frac{1}{2}\\cdot (2x+{y}^{3})^{-3/2}\\cdot 2) \\\\  & =-\\frac{3{y}^{2}}{\\sqrt{(2x+{y}^{3})^{3}}}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186572162 #edb/ref 1068 #edb/ref 17592186572085 #edb/ref 17592186045417] [17592186572162 #edb/ref 1069 "q-132873" #edb/ref 17592186045417] [17592186572162 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186572162 #edb/ref 1071 "Find ${f}_{xy}(x,y)+{f}_{yx}(x,y)$ given that  ${f}_{x}(x,y)=-\\frac{{e}^{y}}{{x}^{2}}$ and ${f}_{y}(x,y)=\\frac{{e}^{y}}{x}.$" #edb/ref 17592186045417] [17592186572162 #edb/ref 1072 #uuid "a0649915-d841-5c53-ae8a-97441f9599ac" #edb/ref 17592186045417] [17592186572162 #edb/ref 1074 "To find ${f}_{xy}(x,y)$ we differentiate the given first-order partial derivative ${f}_{x}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}({f}_{x}(x,y)) \\\\  & =\\frac{∂}{∂y}(-\\frac{{e}^{y}}{{x}^{2}}) \\\\  & =-\\frac{{e}^{y}}{{x}^{2}}\\end{aligned}\n$$\n\nTo find ${f}_{yx}(x,y)$ we differentiate the given first-order partial derivative ${f}_{y}(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{f}_{yx}(x,y) & =\\frac{∂}{∂x}({f}_{y}(x,y)) \\\\  & =\\frac{∂}{∂x}(\\frac{{e}^{y}}{x}) \\\\  & =-\\frac{{e}^{y}}{{x}^{2}}\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y)+{f}_{yx}(x,y) & =-\\frac{{e}^{y}}{{x}^{2}}-\\frac{{e}^{y}}{{x}^{2}}=-\\frac{2{e}^{y}}{{x}^{2}}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186572178 #edb/ref 1068 #edb/ref 17592186572105 #edb/ref 17592186045417] [17592186572178 #edb/ref 1069 "q-80470" #edb/ref 17592186045417] [17592186572178 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186572178 #edb/ref 1071 "Find ${g}_{xy}(x,y)+{g}_{xx}(x,y)$ given that  ${g}_{x}(x,y)=({x}^{2}+y){e}^{{y}^{2}}.$" #edb/ref 17592186045417] [17592186572178 #edb/ref 1072 #uuid "c9b0d21e-5a07-58a4-92b2-716c5c6aa9a4" #edb/ref 17592186045417] [17592186572178 #edb/ref 1074 "To find ${g}_{xy}(x,y)$ we differentiate the given first-order partial derivative ${g}_{x}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{g}_{xy}(x,y) & =\\frac{∂}{∂y}({g}_{x}(x,y)) \\\\  & =\\frac{∂}{∂y}(({x}^{2}+y){e}^{{y}^{2}}) \\\\  & ={e}^{{y}^{2}}+2y({x}^{2}+y){e}^{{y}^{2}} \\\\  & =(1+2{y}^{2}+2{x}^{2}y){e}^{{y}^{2}}\\end{aligned}\n$$\n\nTo find ${g}_{xx}(x,y)$ we differentiate the given first-order partial derivative ${g}_{x}(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{g}_{xx}(x,y) & =\\frac{∂}{∂x}({g}_{x}(x,y)) \\\\  & =\\frac{∂}{∂x}(({x}^{2}+y){e}^{{y}^{2}}) \\\\  & =2x{e}^{{y}^{2}}\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{g}_{xy}(x,y)+{g}_{xx}(x,y) & =(1+2{y}^{2}+2{x}^{2}y){e}^{{y}^{2}}+2x{e}^{{y}^{2}} \\\\  & =(1+2x+2{y}^{2}+2{x}^{2}y){e}^{{y}^{2}}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186572193 #edb/ref 1068 #edb/ref 17592186572100 #edb/ref 17592186045417] [17592186572193 #edb/ref 1069 "q-35970" #edb/ref 17592186045417] [17592186572193 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186572193 #edb/ref 1071 "Find ${g}_{xx}(x,y)+{g}_{yy}(x,y)$ at $(1,1)$ given that ${g}_{x}(x,y)={e}^{y}+y{e}^{x}$ and ${g}_{y}(x,y)=x{e}^{y}+{e}^{x}.$" #edb/ref 17592186045417] [17592186572193 #edb/ref 1072 #uuid "e4a2a3c2-5795-59c7-86a5-26233516c3b1" #edb/ref 17592186045417] [17592186572193 #edb/ref 1074 "To find ${g}_{xx}(x,y)$ we differentiate the given first-order partial derivative ${g}_{x}(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{g}_{xx}(x,y) & =\\frac{∂}{∂x}({g}_{x}(x,y)) \\\\  & =\\frac{∂}{∂x}({e}^{y}+y{e}^{x}) \\\\  & =0+y{e}^{x} \\\\  & =y{e}^{x}\\end{aligned}\n$$\n\n \n\nTo find ${g}_{yy}(x,y)$ we differentiate the given first-order partial derivative ${g}_{y}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{g}_{yy}(x,y) & =\\frac{∂}{∂y}({g}_{y}(x,y)) \\\\  & =\\frac{∂}{∂y}(x{e}^{y}+{e}^{x}) \\\\  & =x{e}^{y}+0 \\\\  & =x{e}^{y}\\end{aligned}\n$$\n\n \n\nNext, we evaluate ${g}_{xx}(x,y)$ and ${g}_{yy}(x,y)$ at $(1,1):$\n\n$$\n\\begin{aligned}{g}_{xx}(1,1) & =1\\cdot {e}^{1}=e \\\\ {g}_{yy}(1,1) & =1\\cdot {e}^{1}=e\\end{aligned}\n$$\n\nFinally, we have\n\n$$\n{g}_{xx}(1,1)+{g}_{yy}(1,1)=e+e=2e.\n$$" #edb/ref 17592186045417]}
