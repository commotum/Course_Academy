#{[{:db/id #edb/ref 17592186124244 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186124440 :knowledge-point/id #uuid "7ea31275-77bd-59c7-8e1d-96e2e4b252a4" :knowledge-point/title "Finding Mixed Second-Order Partial Derivatives"}] :question/id #uuid "0a8f5141-941d-5059-9d9f-bf9e5b09096f" :question/math-academy-id "e-3127" :question/problem "Find $\\dfrac {\\partial^2 f }{\\partial x\\partial y}$ given that $\\dfrac {\\partial f}{\\partial y} =  \\dfrac {2y} {x + y^2}.$" :question/worked-solution "To find $\\dfrac {\\partial^2 f }{\\partial x\\partial y},$ we differentiate the given first-order partial derivative $\\dfrac {\\partial f}{\\partial y}$ with respect to $x\\mathbin{:}$\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(\\frac{∂f}{∂y}) \\\\  & =\\frac{∂}{∂x}(\\frac{2y}{x+{y}^{2}}) \\\\  & =2y\\cdot \\frac{∂}{∂x}({(x+{y}^{2})}^{-1}) \\\\  & =-2y(x+{y}^{2})^{-2}\\cdot 1 \\\\  & =-\\frac{2y}{{(x+{y}^{2})}^{2}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186124245 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186124441 :knowledge-point/id #uuid "503a0bfe-7c69-5ad0-ad1d-aa8692dae673" :knowledge-point/title "Computing Expressions Involving Second-Order Partial Derivatives"}] :question/id #uuid "e16f6686-dffb-554e-a50a-8760e818439f" :question/math-academy-id "e-3129" :question/problem "Find $f_{xy}(x,y)+f_{yx}(x,y)$ given that  $f_x(x,y)=y\\cos(xy)$ and $f_y(x,y)=x\\cos(xy).$" :question/worked-solution "To find $f_{xy}(x,y),$ we differentiate the given first-order partial derivative $f_{x}(x,y)$ with respect to $y\\mathbin{:}$\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}({f}_{x}(x,y)) \\\\  & =\\frac{∂}{∂y}(y\\operatorname{cos}⁡(xy)) \\\\  & =1\\cdot \\operatorname{cos}⁡(xy)+y(-\\operatorname{sin}⁡(xy)\\cdot x) \\\\  & =\\operatorname{cos}⁡(xy)-xy\\operatorname{sin}⁡(xy)\\end{aligned}\n$$\n\n \n\nSimilarly, to find $f_{yx}(x,y),$ we differentiate the given first-order partial derivative $f_{y}(x,y)$ with respect to $x\\mathbin{:}$\n\n$$\n\\begin{aligned}{f}_{yx}(x,y) & =\\frac{∂}{∂x}({f}_{y}(x,y)) \\\\  & =\\frac{∂}{∂x}(x\\operatorname{cos}⁡(xy)) \\\\  & =1\\cdot \\operatorname{cos}⁡(xy)+x(-\\operatorname{sin}⁡(xy)\\cdot y) \\\\  & =\\operatorname{cos}⁡(xy)-xy\\operatorname{sin}⁡(xy)\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y)+{f}_{yx}(x,y) & =\\operatorname{cos}⁡(xy)-xy\\operatorname{sin}⁡(xy)+\\operatorname{cos}⁡(xy)-xy\\operatorname{sin}⁡(xy) \\\\  & =2(\\operatorname{cos}⁡(xy)-xy\\operatorname{sin}⁡(xy)).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186124246 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186124442 :knowledge-point/id #uuid "83724b66-0f15-5b94-9576-76e9dfd56d38" :knowledge-point/title "Finding Higher-Order Derivatives"}] :question/id #uuid "a41bfb06-4372-5124-b910-4b35f19d148b" :question/math-academy-id "e-3130" :question/problem "Evaluate $g_{xyz}(x,y,z)$ at $(1,2,3)$ if $g_x(x,y,z) = 2x y z +  y^3.$" :question/worked-solution "First, we find $g_{xy}(x,y,z)$ by differentiating $g_{x}(x,y,z)$ with respect to $y\\mathbin{:}$\n\n$$\n\\begin{aligned}{g}_{xy}(x,y,z) & =\\frac{∂}{∂y}(2xyz+{y}^{3}) \\\\  & =2xz+3{y}^{2}\\end{aligned}\n$$\n\nNext, we find $g_{xyz}(x,y,z)$ by differentiating $g_{xy}(x,y,z)$ with respect to $z\\mathbin{:}$\n\n$$\n\\begin{aligned}{g}_{xyz}(x,y,z) & =\\frac{∂}{∂z}(2xz+3{y}^{2}) \\\\  & =2x\\end{aligned}\n$$\n\nFinally, we obtain \n\n$$\n\\begin{aligned}{g}_{xyz}(1,2,3) & =2(1) \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186268915 :knowledge-point/_questions [{:db/id #edb/ref 17592186124440 :knowledge-point/id #uuid "7ea31275-77bd-59c7-8e1d-96e2e4b252a4" :knowledge-point/title "Finding Mixed Second-Order Partial Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12304628-20f8-5683-9591-6e766614e495" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4x}{{y}^{3}}" :db/id #edb/ref 17592186266298} {:answer/id #uuid "3c15558f-306d-5a5f-b3a1-508dde977ce4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4x}{{y}^{4}}" :db/id #edb/ref 17592186266671} {:answer/id #uuid "4f9e073f-4f92-5b97-8ec2-dfe319b1a5fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2x}{{y}^{3}}" :db/id #edb/ref 17592186266853} {:answer/id #uuid "79509108-acae-5b5c-9c2d-faffedf74007" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4x}{{y}^{3}}" :db/id #edb/ref 17592186267213} {:answer/id #uuid "987be1db-9b1e-54ef-a8ec-e99e2f7d919e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2x}{{y}^{2}}" :db/id #edb/ref 17592186267514}] :answer-field/correct {:answer/id #uuid "12304628-20f8-5683-9591-6e766614e495" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4x}{{y}^{3}}" :db/id #edb/ref 17592186266298} :answer-field/id #uuid "b665945a-aea7-5573-82c3-1df78c827b87" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268730}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9ff84a14-2b18-5ea3-8551-3c53774a8d4e" :question/math-academy-id "q-132764" :question/problem "For the function $f(x,y),$ calculate $\\frac{{∂}^{2}f}{∂x∂y}$ given that $\\frac{∂f}{∂y}=-\\frac{2{x}^{2}+y}{{y}^{3}}.$" :question/worked-solution "To find $\\frac{{∂}^{2}f}{∂x∂y}$ we differentiate the given first-order partial derivative $\\frac{∂f}{∂y}$ with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(\\frac{∂f}{∂y}) \\\\  & =\\frac{∂}{∂x}(-\\frac{2{x}^{2}+y}{{y}^{3}}) \\\\  & =-\\frac{1}{{y}^{3}}\\cdot \\frac{∂}{∂x}(2{x}^{2}+y) \\\\  & =-\\frac{1}{{y}^{3}}(4x) \\\\  & =-\\frac{4x}{{y}^{3}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186572145 :knowledge-point/_questions [{:db/id #edb/ref 17592186124440 :knowledge-point/id #uuid "7ea31275-77bd-59c7-8e1d-96e2e4b252a4" :knowledge-point/title "Finding Mixed Second-Order Partial Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06cb8fe9-6f5b-5cc6-ae8b-493a6f7671eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{6{y}^{2}}{\\sqrt{(2x+{y}^{3})^{3}}}" :db/id #edb/ref 17592186571551} {:answer/id #uuid "1ce8408b-f8c1-5dcb-b699-4ee03ecb5eaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3{y}^{2}}{\\sqrt{(2x+{y}^{3})^{3}}}" :db/id #edb/ref 17592186571590} {:answer/id #uuid "8911b4be-7d40-5103-814f-582e57c8eb07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3{y}^{2}}{4\\sqrt{(2x+{y}^{3})^{3}}}" :db/id #edb/ref 17592186571773} {:answer/id #uuid "a1d2fe16-14df-50b1-8437-e724a6c0f329" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3{y}^{2}}{2\\sqrt{(2x+{y}^{3})^{3}}}" :db/id #edb/ref 17592186571819} {:answer/id #uuid "fbb4b5bc-5916-5e16-8a60-de6f9ce34dc0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3{y}^{2}}{\\sqrt{(2x+{y}^{3})^{3}}}" :db/id #edb/ref 17592186571971}] :answer-field/correct {:answer/id #uuid "1ce8408b-f8c1-5dcb-b699-4ee03ecb5eaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3{y}^{2}}{\\sqrt{(2x+{y}^{3})^{3}}}" :db/id #edb/ref 17592186571590} :answer-field/id #uuid "6a175a7d-e72a-5161-bd20-55bcf4b8cce7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572030}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "79ed868a-e284-5768-82e1-d5ebe657fd93" :question/math-academy-id "q-132768" :question/problem "For the function $f(x,y),$ calculate $\\frac{{∂}^{2}f}{∂x∂y}$ given that $\\frac{∂f}{∂y}=\\frac{3{y}^{2}}{\\sqrt{2x+{y}^{3}}}.$" :question/worked-solution "To find $\\frac{{∂}^{2}f}{∂x∂y}$ we differentiate the given first-order partial derivative $\\frac{∂f}{∂y}$ with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(\\frac{∂f}{∂y}) \\\\  & =\\frac{∂}{∂x}(\\frac{3{y}^{2}}{\\sqrt{2x+{y}^{3}}}) \\\\  & =3{y}^{2}\\cdot \\frac{∂}{∂x}((2x+{y}^{3})^{-1/2}) \\\\  & =3{y}^{2}(-\\frac{1}{2}\\cdot (2x+{y}^{3})^{-3/2}\\cdot 2) \\\\  & =-\\frac{3{y}^{2}}{\\sqrt{(2x+{y}^{3})^{3}}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186572162 :knowledge-point/_questions [{:db/id #edb/ref 17592186124441 :knowledge-point/id #uuid "503a0bfe-7c69-5ad0-ad1d-aa8692dae673" :knowledge-point/title "Computing Expressions Involving Second-Order Partial Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40192049-1ad7-5f4e-b2a8-58c39e7a85f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{e}^{y}}{{x}^{2}}" :db/id #edb/ref 17592186571657} {:answer/id #uuid "4e06912b-3663-515d-8658-d4c5b44d07ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{e}^{y}}{x}" :db/id #edb/ref 17592186571680} {:answer/id #uuid "a16b486c-2eb9-5f72-b953-4901b9683a7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{e}^{y}(2+x)}{{x}^{2}}" :db/id #edb/ref 17592186571818} {:answer/id #uuid "d4b81103-4ab3-58a2-8a58-a90f5518df3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2{e}^{y}}{{x}^{2}}" :db/id #edb/ref 17592186571919} {:answer/id #uuid "e54cd7a0-0d35-51ae-8812-156961cad30c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2{e}^{y}}{{x}^{3}}" :db/id #edb/ref 17592186571946}] :answer-field/correct {:answer/id #uuid "d4b81103-4ab3-58a2-8a58-a90f5518df3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2{e}^{y}}{{x}^{2}}" :db/id #edb/ref 17592186571919} :answer-field/id #uuid "d45fbfd8-efe1-53f1-aa72-d9abed6ecdf3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572085}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a0649915-d841-5c53-ae8a-97441f9599ac" :question/math-academy-id "q-132873" :question/problem "Find ${f}_{xy}(x,y)+{f}_{yx}(x,y)$ given that  ${f}_{x}(x,y)=-\\frac{{e}^{y}}{{x}^{2}}$ and ${f}_{y}(x,y)=\\frac{{e}^{y}}{x}.$" :question/worked-solution "To find ${f}_{xy}(x,y)$ we differentiate the given first-order partial derivative ${f}_{x}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}({f}_{x}(x,y)) \\\\  & =\\frac{∂}{∂y}(-\\frac{{e}^{y}}{{x}^{2}}) \\\\  & =-\\frac{{e}^{y}}{{x}^{2}}\\end{aligned}\n$$\n\nTo find ${f}_{yx}(x,y)$ we differentiate the given first-order partial derivative ${f}_{y}(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{f}_{yx}(x,y) & =\\frac{∂}{∂x}({f}_{y}(x,y)) \\\\  & =\\frac{∂}{∂x}(\\frac{{e}^{y}}{x}) \\\\  & =-\\frac{{e}^{y}}{{x}^{2}}\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y)+{f}_{yx}(x,y) & =-\\frac{{e}^{y}}{{x}^{2}}-\\frac{{e}^{y}}{{x}^{2}}=-\\frac{2{e}^{y}}{{x}^{2}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186268922 :knowledge-point/_questions [{:db/id #edb/ref 17592186124442 :knowledge-point/id #uuid "83724b66-0f15-5b94-9576-76e9dfd56d38" :knowledge-point/title "Finding Higher-Order Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3cb29571-e208-5200-a958-c8f3d1d1438d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{5}" :db/id #edb/ref 17592186266681} {:answer/id #uuid "51017f16-eb3a-5c37-82e0-b60af57ae310" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186266870} {:answer/id #uuid "5f3c462c-7b5c-537d-bfc9-20d7ca80f58f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{25}" :db/id #edb/ref 17592186266985} {:answer/id #uuid "a2dedaee-bee2-5ea9-a532-355d0429fc5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186267609} {:answer/id #uuid "eb87f3e1-97a6-518d-b919-c149fc4e2846" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{25}" :db/id #edb/ref 17592186268240}] :answer-field/correct {:answer/id #uuid "a2dedaee-bee2-5ea9-a532-355d0429fc5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186267609} :answer-field/id #uuid "52bd946d-e3d9-5d3b-a474-eaba96f04b7f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268554}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e5449d51-c794-5d29-87ea-e1688a095f9f" :question/math-academy-id "q-132940" :question/problem "Evaluate ${f}_{xyz}(-5,2,3)$ for $f(x,y,z)={x}^{2}\\operatorname{ln}⁡(y+z).$" :question/worked-solution "First, we find the first-order derivative ${f}_{x}(x,y,z):$\n\n$$\n\\begin{aligned}{f}_{x}(x,y,z) & =\\frac{∂}{∂x}({x}^{2}\\operatorname{ln}⁡(y+z)) \\\\  & =2x\\operatorname{ln}⁡(y+z)\\end{aligned}\n$$\n\nNow, we find ${f}_{xy}(x,y,z)$ by differentiating ${f}_{x}(x,y,z)$ with respect to $y:$\n\n$$\n\\begin{aligned}{f}_{xy}(x,y,z) & =\\frac{∂}{∂y}({f}_{x}(x,y,z)) \\\\  & =\\frac{∂}{∂y}(2x\\operatorname{ln}⁡(y+z)) \\\\  & =2x\\cdot \\frac{1}{y+z} \\\\  & =\\frac{2x}{y+z}\\end{aligned}\n$$\n\nNext, we find ${f}_{xyz}(x,y,z)$ by differentiating ${f}_{xy}(x,y,z)$ with respect to $z:$ \n\n$$\n\\begin{aligned}{f}_{xyz}(x,y,z) & =\\frac{∂}{∂z}({f}_{xy}(x,y,z)) \\\\  & =\\frac{∂}{∂z}(\\frac{2x}{y+z}) \\\\  & =2x\\cdot \\frac{∂}{∂z}(\\frac{1}{y+z}) \\\\  & =2x\\cdot (-\\frac{1}{(y+z)^{2}}) \\\\  & =-\\frac{2x}{(y+z)^{2}}\\end{aligned}\n$$\n\nFinally, we evaluate ${f}_{xyz}(x,y,z)$ at $(-5,2,3):$\n\n$$\n\\begin{aligned}{f}_{xyz}(-5,2,3) & =-\\frac{2(-5)}{(2+3)^{2}}=\\frac{2}{5}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186381062 :knowledge-point/_questions [{:db/id #edb/ref 17592186124442 :knowledge-point/id #uuid "83724b66-0f15-5b94-9576-76e9dfd56d38" :knowledge-point/title "Finding Higher-Order Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8654559e-0c2f-5da0-a22d-c4d32b252a1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186381064} {:answer/id #uuid "01d037ce-31b1-550d-9f64-39f98a921a6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186381065} {:answer/id #uuid "3a7e3c17-36aa-5bbb-a443-d147a29832c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186381066} {:answer/id #uuid "4d77f975-e483-5da8-a655-8c2d4d00e88f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186381067} {:answer/id #uuid "8a0eeeeb-b267-56a5-bb8c-8f5ff5f66c9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186381068}] :answer-field/correct {:answer/id #uuid "8654559e-0c2f-5da0-a22d-c4d32b252a1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186381064} :answer-field/id #uuid "863a0f4c-944c-569a-949c-d1714005af42" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381063}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a11d21f8-cefe-5922-beca-1c00b4452f90" :question/math-academy-id "q-132972" :question/problem "Evaluate ${f}_{zyx}(2,4,-2)$ for $f(x,y,z)={x}^{2}{z}^{3}\\sqrt{y}.$" :question/worked-solution "First, we find the first-order derivative ${f}_{z}(x,y,z):$\n\n$$\n\\begin{aligned}{f}_{z}(x,y,z) & =\\frac{∂}{∂z}({x}^{2}{z}^{3}\\sqrt{y}) \\\\  & =3{x}^{2}{z}^{2}\\sqrt{y}\\end{aligned}\n$$\n\nNow, we find ${f}_{zy}(x,y,z)$ by differentiating ${f}_{z}(x,y,z)$ with respect to $y:$\n\n$$\n\\begin{aligned}{f}_{zy}(x,y,z) & =\\frac{∂}{∂y}({f}_{z}(x,y,z)) \\\\  & =\\frac{∂}{∂y}(3{x}^{2}{z}^{2}\\sqrt{y}) \\\\  & =3{x}^{2}{z}^{2}\\cdot \\frac{1}{2\\sqrt{y}} \\\\  & =\\frac{3{x}^{2}{z}^{2}}{2\\sqrt{y}}\\end{aligned}\n$$\n\nNext, we find ${f}_{zyx}(x,y,z)$ by differentiating ${f}_{zy}(x,y,z)$ with respect to $x:$ \n\n$$\n\\begin{aligned}{f}_{zyx}(x,y,z) & =\\frac{∂}{∂x}({f}_{zy}(x,y,z)) \\\\  & =\\frac{∂}{∂x}(\\frac{3{x}^{2}{z}^{2}}{2\\sqrt{y}}) \\\\  & =\\frac{3x{z}^{2}}{\\sqrt{y}}\\end{aligned}\n$$\n\n \n\nFinally, we evaluate ${f}_{zyx}(x,y,z)$ at $(2,4,-2):$  \n\n$$\n\\begin{aligned}{f}_{zyx}(2,4,-2) & =\\frac{3(2)(-2)^{2}}{\\sqrt{4}}=\\frac{24}{2}=12\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186572193 :knowledge-point/_questions [{:db/id #edb/ref 17592186124441 :knowledge-point/id #uuid "503a0bfe-7c69-5ad0-ad1d-aa8692dae673" :knowledge-point/title "Computing Expressions Involving Second-Order Partial Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0780d46e-f890-5e8c-bfaa-c17c60146949" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e" :db/id #edb/ref 17592186571552} {:answer/id #uuid "226f3dea-41ec-558f-a575-86c3198850e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186571596} {:answer/id #uuid "71cc681c-163d-5d61-a84e-e596b66a8a54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186571732} {:answer/id #uuid "b1846d11-f324-5363-a9d7-38cd2fbda339" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e" :db/id #edb/ref 17592186571848} {:answer/id #uuid "bab6362a-0087-51e8-93fe-cddc3fff351d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2}" :db/id #edb/ref 17592186571869}] :answer-field/correct {:answer/id #uuid "0780d46e-f890-5e8c-bfaa-c17c60146949" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e" :db/id #edb/ref 17592186571552} :answer-field/id #uuid "f612a99b-9823-545d-970f-08e78ad416bf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572100}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e4a2a3c2-5795-59c7-86a5-26233516c3b1" :question/math-academy-id "q-35970" :question/problem "Find ${g}_{xx}(x,y)+{g}_{yy}(x,y)$ at $(1,1)$ given that ${g}_{x}(x,y)={e}^{y}+y{e}^{x}$ and ${g}_{y}(x,y)=x{e}^{y}+{e}^{x}.$" :question/worked-solution "To find ${g}_{xx}(x,y)$ we differentiate the given first-order partial derivative ${g}_{x}(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{g}_{xx}(x,y) & =\\frac{∂}{∂x}({g}_{x}(x,y)) \\\\  & =\\frac{∂}{∂x}({e}^{y}+y{e}^{x}) \\\\  & =0+y{e}^{x} \\\\  & =y{e}^{x}\\end{aligned}\n$$\n\n \n\nTo find ${g}_{yy}(x,y)$ we differentiate the given first-order partial derivative ${g}_{y}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{g}_{yy}(x,y) & =\\frac{∂}{∂y}({g}_{y}(x,y)) \\\\  & =\\frac{∂}{∂y}(x{e}^{y}+{e}^{x}) \\\\  & =x{e}^{y}+0 \\\\  & =x{e}^{y}\\end{aligned}\n$$\n\n \n\nNext, we evaluate ${g}_{xx}(x,y)$ and ${g}_{yy}(x,y)$ at $(1,1):$\n\n$$\n\\begin{aligned}{g}_{xx}(1,1) & =1\\cdot {e}^{1}=e \\\\ {g}_{yy}(1,1) & =1\\cdot {e}^{1}=e\\end{aligned}\n$$\n\nFinally, we have\n\n$$\n{g}_{xx}(1,1)+{g}_{yy}(1,1)=e+e=2e.\n$$"}] [{:db/id #edb/ref 17592186335787 :knowledge-point/_questions [{:db/id #edb/ref 17592186124442 :knowledge-point/id #uuid "83724b66-0f15-5b94-9576-76e9dfd56d38" :knowledge-point/title "Finding Higher-Order Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35449759-c15b-512f-8420-1fb63ecd365b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2(1+xy){e}^{xy}" :db/id #edb/ref 17592186333479} {:answer/id #uuid "6ee18fc9-cbc6-586c-bc71-475637c324b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2-xy){e}^{xy}" :db/id #edb/ref 17592186333998} {:answer/id #uuid "9a0371f6-0b4a-5973-b88a-0f71945345be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1+xy){e}^{xy}" :db/id #edb/ref 17592186334348} {:answer/id #uuid "c8509045-b540-5b6c-809d-592048041afb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(2-xy){e}^{xy}" :db/id #edb/ref 17592186334732} {:answer/id #uuid "e331b700-4987-5e42-86ca-0e1830625b2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y(2+xy){e}^{xy}" :db/id #edb/ref 17592186334967}] :answer-field/correct {:answer/id #uuid "e331b700-4987-5e42-86ca-0e1830625b2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y(2+xy){e}^{xy}" :db/id #edb/ref 17592186334967} :answer-field/id #uuid "8f091079-d683-5612-93c2-5fcf60f69e17" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335512}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "101d6e00-46ae-511e-8fb6-40ece63bbd97" :question/math-academy-id "q-65068" :question/problem "Calculate ${f}_{xxy}(x,y)$ given that $f(x,y)={e}^{xy}.$" :question/worked-solution "First, we find the first-order derivative ${f}_{x}(x,y):$ \n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}({e}^{xy}) \\\\  & =y{e}^{xy}\\end{aligned}\n$$\n\nNext, we find ${f}_{xx}(x,y)$ by differentiating ${f}_{x}(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{f}_{xx}(x,y) & =\\frac{∂}{∂x}({f}_{x}(x,y)) \\\\  & =\\frac{∂}{∂x}(y{e}^{xy}) \\\\  & =y(y{e}^{xy}) \\\\  & ={y}^{2}{e}^{xy}\\end{aligned}\n$$\n\nFinally, we find ${f}_{xxy}(x,y)$ by differentiating ${f}_{xx}(x,y)$ with respect to $y:$ \n\n$$\n\\begin{aligned}{f}_{xxy}(x,y) & =\\frac{∂}{∂y}({f}_{xx}(x,y)) \\\\  & =\\frac{∂}{∂y}({y}^{2}{e}^{xy}) \\\\  & =2y\\cdot {e}^{xy}+{y}^{2}\\cdot {e}^{xy}\\cdot x \\\\  & =y(2+xy){e}^{xy}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186422010 :knowledge-point/_questions [{:db/id #edb/ref 17592186124442 :knowledge-point/id #uuid "83724b66-0f15-5b94-9576-76e9dfd56d38" :knowledge-point/title "Finding Higher-Order Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07b7ad2e-54cc-50e3-9ca3-0b8efd17be6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4y+{e}^{x}" :db/id #edb/ref 17592186421994} {:answer/id #uuid "1f109dc7-15d8-584f-8e2b-595762c1a061" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4xy+y{e}^{x}" :db/id #edb/ref 17592186421996} {:answer/id #uuid "44455996-432d-5a3d-8b99-8ba088ea40bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2xy+{e}^{x}" :db/id #edb/ref 17592186421998} {:answer/id #uuid "5e886d04-bc8d-58c5-9141-d4629aa452fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x{y}^{2}+y{e}^{x}" :db/id #edb/ref 17592186421999} {:answer/id #uuid "e3c5be38-2517-52b4-89a2-e748dfb3f71f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y+x+{e}^{x}" :db/id #edb/ref 17592186422007}] :answer-field/correct {:answer/id #uuid "07b7ad2e-54cc-50e3-9ca3-0b8efd17be6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4y+{e}^{x}" :db/id #edb/ref 17592186421994} :answer-field/id #uuid "31dfaa29-640a-5223-927a-6d7e182b7cd8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186422009}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "11508c24-c4aa-589a-b2fa-c4b12396bfe7" :question/math-academy-id "q-65070" :question/problem "Calculate ${f}_{xyx}(x,y)$ given that $f(x,y)={x}^{2}{y}^{2}+y{e}^{x}.$" :question/worked-solution "First, we find the first-order derivative ${f}_{x}(x,y):$ \n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}({x}^{2}{y}^{2}+y{e}^{x}) \\\\  & =2x\\cdot {y}^{2}+y\\cdot {e}^{x} \\\\  & =2x{y}^{2}+y{e}^{x}\\end{aligned}\n$$\n\nNext, we find ${f}_{xy}(x,y)$ by differentiating ${f}_{x}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}({f}_{x}(x,y)) \\\\  & =\\frac{∂}{∂y}(2x{y}^{2}+y{e}^{x}) \\\\  & =2x\\cdot 2y+1\\cdot {e}^{x} \\\\  & =4xy+{e}^{x}\\end{aligned}\n$$\n\nFinally, we find ${f}_{xyx}(x,y)$ by differentiating ${f}_{xy}(x,y)$ with respect to $x:$ \n\n$$\n\\begin{aligned}{f}_{xyx}(x,y) & =\\frac{∂}{∂x}({f}_{xy}(x,y)) \\\\  & =\\frac{∂}{∂x}(4xy+{e}^{x}) \\\\  & =4\\cdot 1\\cdot y+{e}^{x} \\\\  & =4y+{e}^{x}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186382358 :knowledge-point/_questions [{:db/id #edb/ref 17592186124440 :knowledge-point/id #uuid "7ea31275-77bd-59c7-8e1d-96e2e4b252a4" :knowledge-point/title "Finding Mixed Second-Order Partial Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09e08383-3479-5b29-b122-aa6c0c46460c" :answer/type {:db/id #edb/ref 