x∂y}$ we differentiate the given first-order partial derivative $\\frac{∂f}{∂y}$ with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(\\frac{∂f}{∂y}) \\\\  & =\\frac{∂}{∂x}({x}^{2}y\\operatorname{cos}⁡(x{y}^{2})) \\\\  & =y\\cdot \\frac{∂}{∂x}({x}^{2}\\operatorname{cos}⁡(x{y}^{2})) \\\\  & =y\\cdot (2x\\operatorname{cos}⁡(x{y}^{2})-{x}^{2}{y}^{2}\\operatorname{sin}⁡(x{y}^{2})) \\\\  & =2xy\\operatorname{cos}⁡(x{y}^{2})-{x}^{2}{y}^{3}\\operatorname{sin}⁡(x{y}^{2})\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186348377 :knowledge-point/_questions [{:db/id #edb/ref 17592186124440 :knowledge-point/id #uuid "7ea31275-77bd-59c7-8e1d-96e2e4b252a4" :knowledge-point/title "Finding Mixed Second-Order Partial Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06f49280-3e27-52c2-ba02-a96c2c902002" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x({x}^{2}+{y}^{2}){e}^{({x}^{2}+{y}^{2})}" :db/id #edb/ref 17592186345412} {:answer/id #uuid "148b0fbb-3fc3-56e6-af34-b7980a1c68e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4y{x}^{2}{e}^{({x}^{2}+{y}^{2})}" :db/id #edb/ref 17592186345527} {:answer/id #uuid "25a65378-ebdd-5865-99bb-e4f2fc2f3666" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x(1+2{y}^{2}){e}^{({x}^{2}+{y}^{2})}" :db/id #edb/ref 17592186345692} {:answer/id #uuid "55cd2ed6-cc04-5772-bc87-841e5b1d916f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2y(1+2{x}^{2}){e}^{({x}^{2}+{y}^{2})}" :db/id #edb/ref 17592186346080} {:answer/id #uuid "e74f07be-2559-5476-9d96-1dec0cdc625d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4y(1+{x}^{2}){e}^{({x}^{2}+{y}^{2})}" :db/id #edb/ref 17592186347391}] :answer-field/correct {:answer/id #uuid "55cd2ed6-cc04-5772-bc87-841e5b1d916f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2y(1+2{x}^{2}){e}^{({x}^{2}+{y}^{2})}" :db/id #edb/ref 17592186346080} :answer-field/id #uuid "b013f07d-ae92-5419-a127-b78331669dac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347908}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fa43a83f-a97a-54b7-8060-e07ac7e5d1a6" :question/math-academy-id "q-80396" :question/problem "For the function $f(x,y),$ calculate $\\frac{{∂}^{2}f}{∂{x}^{2}}$ given that $\\frac{∂f}{∂x}=2xy{e}^{({x}^{2}+{y}^{2})}.$" :question/worked-solution "To find $\\frac{{∂}^{2}f}{∂{x}^{2}}$ we differentiate the given first-order partial derivative $\\frac{∂f}{∂x}$ with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(\\frac{∂f}{∂x}) \\\\  & =\\frac{∂}{∂x}(2xy{e}^{({x}^{2}+{y}^{2})}) \\\\  & =2y\\cdot \\frac{∂}{∂x}(x{e}^{({x}^{2}+{y}^{2})}) \\\\  & =2y\\cdot ({e}^{({x}^{2}+{y}^{2})}+2{x}^{2}{e}^{({x}^{2}+{y}^{2})}) \\\\  & =2y(1+2{x}^{2}){e}^{({x}^{2}+{y}^{2})}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186572115 :knowledge-point/_questions [{:db/id #edb/ref 17592186124440 :knowledge-point/id #uuid "7ea31275-77bd-59c7-8e1d-96e2e4b252a4" :knowledge-point/title "Finding Mixed Second-Order Partial Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c9cfa5d-41cf-5a5f-809a-d8c4f28a52d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2{x}^{2}-{y}^{2}}{({x}^{2}+{y}^{2})^{2}}" :db/id #edb/ref 17592186571613} {:answer/id #uuid "3b282fe4-17b1-51f0-87d2-2c80732e1692" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{y}^{2}(x-y)}{({x}^{2}+{y}^{2})^{2}}" :db/id #edb/ref 17592186571646} {:answer/id #uuid "45e68316-8377-5cd4-b0c3-6d42603c3d6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y({x}^{2}-{y}^{2})}{({x}^{2}+{y}^{2})^{2}}" :db/id #edb/ref 17592186571664} {:answer/id #uuid "7335c6e8-a54d-57ce-8f8e-1b8b0ecbd51e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y(x-y)}{{x}^{2}+{y}^{2}}" :db/id #edb/ref 17592186571735} {:answer/id #uuid "a0adc39a-bbc3-5d01-87eb-8fe982090eda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}-{y}^{3}}{({x}^{2}+{y}^{2})^{2}}" :db/id #edb/ref 17592186571817}] :answer-field/correct {:answer/id #uuid "45e68316-8377-5cd4-b0c3-6d42603c3d6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y({x}^{2}-{y}^{2})}{({x}^{2}+{y}^{2})^{2}}" :db/id #edb/ref 17592186571664} :answer-field/id #uuid "413910e8-4c00-543b-b56d-b6c4c169bb1f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572010}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "196e0964-4e1e-5145-bb69-08bef197b0a6" :question/math-academy-id "q-80399" :question/problem "For the function $f(x,y),$ calculate $\\frac{{∂}^{2}f}{∂x∂y}$ given that $\\frac{∂f}{∂y}=-\\frac{xy}{{x}^{2}+{y}^{2}}.$" :question/worked-solution "To find $\\frac{{∂}^{2}f}{∂x∂y}$ we differentiate the given first-order partial derivative $\\frac{∂f}{∂y}$ with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(\\frac{∂f}{∂y}) \\\\  & =\\frac{∂}{∂x}(-\\frac{xy}{{x}^{2}+{y}^{2}}) \\\\  & =-y\\cdot \\frac{∂}{∂x}(\\frac{x}{{x}^{2}+{y}^{2}}) \\\\  & =-y(\\frac{1}{{x}^{2}+{y}^{2}}-\\frac{2{x}^{2}}{({x}^{2}+{y}^{2})^{2}}) \\\\  & =-y(\\frac{({x}^{2}+{y}^{2})-2{x}^{2}}{({x}^{2}+{y}^{2})^{2}}) \\\\  & =\\frac{y({x}^{2}-{y}^{2})}{({x}^{2}+{y}^{2})^{2}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186348378 :knowledge-point/_questions [{:db/id #edb/ref 17592186124441 :knowledge-point/id #uuid "503a0bfe-7c69-5ad0-ad1d-aa8692dae673" :knowledge-point/title "Computing Expressions Involving Second-Order Partial Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b7ae8a1-ebe2-59c4-8708-e4a1c32b175a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4xy}{({x}^{2}+{y}^{2})^{2}}" :db/id #edb/ref 17592186345857} {:answer/id #uuid "7d3485ae-94f3-5b77-9f2e-002df7361ef2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{x-y}{({x}^{2}+{y}^{2})^{2}}" :db/id #edb/ref 17592186346445} {:answer/id #uuid "87a67059-8153-5a03-ae43-6b7e24dceadd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186346526} {:answer/id #uuid "a468da5e-c9b4-5727-a6a0-5c7197bd864d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4xy}{({x}^{2}+{y}^{2})^{2}}" :db/id #edb/ref 17592186346778} {:answer/id #uuid "ff97d500-0898-5d7e-a963-3b72cb011bdd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{-(x+y)}{({x}^{2}+{y}^{2})^{2}}" :db/id #edb/ref 17592186347597}] :answer-field/correct {:answer/id #uuid "87a67059-8153-5a03-ae43-6b7e24dceadd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186346526} :answer-field/id #uuid "a24c8cfd-e105-5686-9a9f-4680bc4eac94" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347893}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "afef13bf-72ea-50e0-9df2-d85aa9be21e5" :question/math-academy-id "q-80403" :question/problem "Find ${f}_{xx}(x,y)+{f}_{yy}(x,y)$ given that  ${f}_{x}(x,y)=-\\frac{y}{{x}^{2}+{y}^{2}}$ and ${f}_{y}(x,y)=\\frac{x}{{x}^{2}+{y}^{2}}.$" :question/worked-solution "To find ${f}_{xx}(x,y)$ we differentiate the given first-order partial derivative ${f}_{x}(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{f}_{xx}(x,y) & =\\frac{∂}{∂x}({f}_{x}(x,y)) \\\\  & =\\frac{∂}{∂x}(-\\frac{y}{{x}^{2}+{y}^{2}}) \\\\  & =-y\\cdot \\frac{∂}{∂x}(\\frac{1}{{x}^{2}+{y}^{2}}) \\\\  & =-y\\cdot (-\\frac{2x}{({x}^{2}+{y}^{2})^{2}}) \\\\  & =\\frac{2xy}{({x}^{2}+{y}^{2})^{2}}\\end{aligned}\n$$\n\nTo find ${f}_{yy}(x,y)$ we differentiate the given first-order partial derivative ${f}_{y}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{f}_{yy}(x,y) & =\\frac{∂}{∂y}({f}_{y}(x,y)) \\\\  & =\\frac{∂}{∂y}(\\frac{x}{{x}^{2}+{y}^{2}}) \\\\  & =x\\cdot \\frac{∂}{∂y}(\\frac{1}{{x}^{2}+{y}^{2}}) \\\\  & =x\\cdot (-\\frac{2y}{({x}^{2}+{y}^{2})^{2}}) \\\\  & =-\\frac{2xy}{({x}^{2}+{y}^{2})^{2}}\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{f}_{xx}(x,y)+{f}_{yy}(x,y) & =\\frac{2xy}{({x}^{2}+{y}^{2})^{2}}-\\frac{2xy}{({x}^{2}+{y}^{2})^{2}}=0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186348391 :knowledge-point/_questions [{:db/id #edb/ref 17592186124441 :knowledge-point/id #uuid "503a0bfe-7c69-5ad0-ad1d-aa8692dae673" :knowledge-point/title "Computing Expressions Involving Second-Order Partial Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5aad536a-9197-5a8d-b50f-6327085edfae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2xy\\operatorname{sin}⁡({x}^{2}-{y}^{2})" :db/id #edb/ref 17592186346124} {:answer/id #uuid "5fd9f008-6a2e-5d2a-aa8b-3ccff5ae77e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2({x}^{2}+{y}^{2})\\operatorname{sin}⁡({x}^{2}-{y}^{2})" :db/id #edb/ref 17592186346177} {:answer/id #uuid "6c8cb727-8294-5678-8acc-e9da39627db6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{2}{y}^{2}\\operatorname{sin}⁡({x}^{2}-{y}^{2})" :db/id #edb/ref 17592186346294} {:answer/id #uuid "a77649f1-48b6-55ea-91c0-383fba6c0762" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4xy\\operatorname{sin}⁡({x}^{2}-{y}^{2})" :db/id #edb/ref 17592186346809} {:answer/id #uuid "c3cdbe3f-02f7-51f8-b1f4-0af5a098e658" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2({x}^{2}y+x{y}^{2})\\operatorname{sin}⁡({x}^{2}-{y}^{2})" :db/id #edb/ref 17592186347042}] :answer-field/correct {:answer/id #uuid "a77649f1-48b6-55ea-91c0-383fba6c0762" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4xy\\operatorname{sin}⁡({x}^{2}-{y}^{2})" :db/id #edb/ref 17592186346809} :answer-field/id #uuid "467edf27-1318-5a7e-8c0c-820295e2b8aa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347721}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3a379c4d-6975-5a4f-a1f2-d51e99e08ac7" :question/math-academy-id "q-80468" :question/problem "Find ${f}_{xy}(x,y)+{f}_{yx}(x,y)$ given that  ${f}_{x}(x,y)=x\\operatorname{cos}⁡({x}^{2}-{y}^{2})$ and ${f}_{y}(x,y)=-y\\operatorname{cos}⁡({x}^{2}-{y}^{2}).$" :question/worked-solution "To find ${f}_{xy}(x,y)$ we differentiate the given first-order partial derivative ${f}_{x}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}({f}_{x}(x,y)) \\\\  & =\\frac{∂}{∂y}(x\\operatorname{cos}⁡({x}^{2}-{y}^{2})) \\\\  & =x\\cdot (-\\operatorname{sin}⁡({x}^{2}-{y}^{2})\\cdot (-2y)) \\\\  & =2xy\\operatorname{sin}⁡({x}^{2}-{y}^{2})\\end{aligned}\n$$\n\nTo find ${f}_{yx}(x,y)$ we differentiate the given first-order partial derivative ${f}_{y}(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{f}_{yx}(x,y) & =\\frac{∂}{∂x}({f}_{y}(x,y)) \\\\  & =\\frac{∂}{∂x}(-y\\operatorname{cos}⁡({x}^{2}-{y}^{2})) \\\\  & =-y(-\\operatorname{sin}⁡({x}^{2}-{y}^{2})\\cdot 2x) \\\\  & =2xy\\operatorname{sin}⁡({x}^{2}-{y}^{2})\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y)+{f}_{yx}(x,y) & =2xy\\operatorname{sin}⁡({x}^{2}-{y}^{2})+2xy\\operatorname{sin}⁡({x}^{2}-{y}^{2}) \\\\  & =4xy\\operatorname{sin}⁡({x}^{2}-{y}^{2}).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186572178 :knowledge-point/_questions [{:db/id #edb/ref 17592186124441 :knowledge-point/id #uuid "503a0bfe-7c69-5ad0-ad1d-aa8692dae673" :knowledge-point/title "Computing Expressions Involving Second-Order Partial Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "080a08e9-453b-5c8a-b232-6a3c1e7c6233" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1+x+{x}^{2}y){e}^{{y}^{2}}" :db/id #edb/ref 17592186571554} {:answer/id #uuid "636b61e5-ec88-5bb1-8484-40d5a63ecdfd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1+2x+2{y}^{2}+2{x}^{2}y){e}^{{y}^{2}}" :db/id #edb/ref 17592186571709} {:answer/id #uuid "9bd08106-3e43-5929-84e7-d1fe73a768b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+{y}^{2}+2xy){e}^{{y}^{2}}" :db/id #edb/ref 17592186571810} {:answer/id #uuid "a5379bfe-18f0-5bb2-b524-7b51eeb2147f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1+2{x}^{2}y){e}^{{y}^{2}}" :db/id #edb/ref 17592186571824} {:answer/id #uuid "c89b95cf-1370-5f9b-90e4-17e32f8a6a2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1+2x+{y}^{2}){e}^{{y}^{2}}" :db/id #edb/ref 17592186571896}] :answer-field/correct {:answer/id #uuid "636b61e5-ec88-5bb1-8484-40d5a63ecdfd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1+2x+2{y}^{2}+2{x}^{2}y){e}^{{y}^{2}}" :db/id #edb/ref 17592186571709} :answer-field/id #uuid "fbc74e89-e640-5012-b7da-dea4b8708d3f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572105}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c9b0d21e-5a07-58a4-92b2-716c5c6aa9a4" :question/math-academy-id "q-80470" :question/problem "Find ${g}_{xy}(x,y)+{g}_{xx}(x,y)$ given that  ${g}_{x}(x,y)=({x}^{2}+y){e}^{{y}^{2}}.$" :question/worked-solution "To find ${g}_{xy}(x,y)$ we differentiate the given first-order partial derivative ${g}_{x}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{g}_{xy}(x,y) & =\\frac{∂}{∂y}({g}_{x}(x,y)) \\\\  & =\\frac{∂}{∂y}(({x}^{2}+y){e}^{{y}^{2}}) \\\\  & ={e}^{{y}^{2}}+2y({x}^{2}+y){e}^{{y}^{2}} \\\\  & =(1+2{y}^{2}+2{x}^{2}y){e}^{{y}^{2}}\\end{aligned}\n$$\n\nTo find ${g}_{xx}(x,y)$ we differentiate the given first-order partial derivative ${g}_{x}(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{g}_{xx}(x,y) & =\\frac{∂}{∂x}({g}_{x}(x,y)) \\\\  & =\\frac{∂}{∂x}(({x}^{2}+y){e}^{{y}^{2}}) \\\\  & =2x{e}^{{y}^{2}}\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{g}_{xy}(x,y)+{g}_{xx}(x,y) & =(1+2{y}^{2}+2{x}^{2}y){e}^{{y}^{2}}+2x{e}^{{y}^{2}} \\\\  & =(1+2x+2{y}^{2}+2{x}^{2}y){e}^{{y}^{2}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186572140 :knowledge-point/_questions [{:db/id #edb/ref 17592186124442 :knowledge-point/id #uuid "83724b66-0f15-5b94-9576-76e9dfd56d38" :knowledge-point/title "Finding Higher-Order Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02d9aa9f-a8d8-588f-a8e1-7af4482321a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x+y}{(x+y)^{3}}" :db/id #edb/ref 17592186571542} {:answer/id #uuid "38d35b85-1420-5ed0-bcb5-84ac515d0096" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-y}{(x+y)^{3}}" :db/id #edb/ref 17592186571640} {:answer/id #uuid "6eec6d7a-5739-579b-8ce4-3302fde90d20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2y}{(x+y)^{2}}" :db/id #edb/ref 17592186571729} {:answer/id #uuid "9d8ca974-1e0f-5659-9edb-422337954136" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-2y}{(x+y)^{3}}" :db/id #edb/ref 17592186571813} {:answer/id #uuid "d06ec930-b983-5940-87c6-87b93db3f3ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x}{(x+y)^{2}}" :db/id #edb/ref 17592186571912}] :answer-field/correct {:answer/id #uuid "38d35b85-1420-5ed0-bcb5-84ac515d0096" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-y}{(x+y)^{3}}" :db/id #edb/ref 17592186571640} :answer-field/id #uuid "cc261a92-2131-5add-b6f7-f635dbf455fe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572082}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "69504aad-b4b4-5456-a945-74b303c69a26" :question/math-academy-id "q-80476" :question/problem "Calculate ${f}_{yyx}(x,y)$ given that $f(x,y)=x\\operatorname{ln}⁡(x+y).$" :question/worked-solution "First, we find the first-order derivative ${g}_{y}(x,y):$ \n\n$$\n\\begin{aligned}{g}_{y}(x,y) & =\\frac{∂}{∂y}(x\\operatorname{ln}⁡(x+y)) \\\\  & =\\frac{x}{x+y}\\end{aligned}\n$$\n\nNext, we find ${g}_{yy}(x,y)$ by differentiating ${g}_{y}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{g}_{yy}(x,y) & =\\frac{∂}{∂y}({g}_{y}(x,y)) \\\\  & =\\frac{∂}{∂y}(\\frac{x}{x+y}) \\\\  & =-\\frac{x}{(x+y)^{2}}\\end{aligned}\n$$\n\nFinally, we find ${g}_{yyx}(x,y)$ by differentiating ${g}_{yy}(x,y)$ with respect to $x:$ \n\n$$\n\\begin{aligned}{g}_{yyx}(x,y) & =\\frac{∂}{∂x}({g}_{yy}(x,y)) \\\\  & =\\frac{∂}{∂x}(-\\frac{x}{(x+y)^{2}}) \\\\  & =-\\frac{1}{(x+y)^{2}}+\\frac{2x}{(x+y)^{3}} \\\\  & =\\frac{-(x+y)+2x}{(x+y)^{3}} \\\\  & =\\frac{x-y}{(x+y)^{3}}\\end{aligned}\n$$"}]}
