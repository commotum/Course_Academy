#{[{:db/id #edb/ref 17592186284494 :knowledge-point/_questions [{:db/id #edb/ref 17592186124651 :knowledge-point/id #uuid "9840265f-02bf-58fa-94fd-77fb970af297" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03dda863-9cba-5ac7-b163-95b61c7a3ee5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic paraboloid" :db/id #edb/ref 17592186281725} {:answer/id #uuid "16d5551d-3d24-5dac-b97c-bc7e162ca09e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet" :db/id #edb/ref 17592186281901} {:answer/id #uuid "5d9a7237-f69d-50a6-b871-d9b1e6e46923" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A sphere" :db/id #edb/ref 17592186282482} {:answer/id #uuid "d3260eaa-d1a9-5a45-9f05-0463b59bbd09" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets" :db/id #edb/ref 17592186283532} {:answer/id #uuid "e932d761-78b0-531a-aa87-9ee121dc8267" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An ellipsoid" :db/id #edb/ref 17592186283724}] :answer-field/correct {:answer/id #uuid "16d5551d-3d24-5dac-b97c-bc7e162ca09e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet" :db/id #edb/ref 17592186281901} :answer-field/id #uuid "bceab84c-9b8c-5f9d-b3b9-e91d20b3f572" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284271}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d1da5d09-9bba-571b-a103-055c209c6aeb" :question/math-academy-id "q-164474" :question/problem "Identify the following surface: \n\n$$\n(x+1)^{2}+(y-3)^{2}-(z-1)^{2}=1\n$$" :question/worked-solution "Recall that the equation of a hyperboloid of one sheet centered at $O$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}-\\frac{{z}^{2}}{{c}^{2}}=1,\n$$\n\nand a hyperboloid of one sheet centered at $({x}_{0},{y}_{0},{z}_{0})$ is given by\n\n$$\n\\frac{(x-{x}_{0})^{2}}{{a}^{2}}+\\frac{(y-{y}_{0})^{2}}{{b}^{2}}-\\frac{(z-{z}_{0})^{2}}{{c}^{2}}=1,\n$$\n\nThus, our equation is a hyperboloid of one sheet with the following parameters:\n\n$$\n({x}_{0},{y}_{0},{z}_{0})=(-1,3,1),\\,a=b=c=1.\n$$"}] [{:db/id #edb/ref 17592186401530 :knowledge-point/_questions [{:db/id #edb/ref 17592186124652 :knowledge-point/id #uuid "89fbf42b-d171-5772-87ce-cf622b720963" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders With Alternative Orientations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ed669204-c56c-5225-aefc-956037ae0d37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbolic cylinder whose axis is the $x$-axis" :db/id #edb/ref 17592186401532} {:answer/id #uuid "359f70ba-f3cf-563a-9d19-52e3ff5fe27b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A parabolic cylinder whose axis is the $x$-axis" :db/id #edb/ref 17592186401533} {:answer/id #uuid "d5285b0d-7ee4-5490-8561-775dea047606" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A parabolic cylinder whose axis is the $y$-axis" :db/id #edb/ref 17592186401534} {:answer/id #uuid "74313148-6534-5531-9101-2416622ea616" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cone whose axis is the $z$-axis" :db/id #edb/ref 17592186401535} {:answer/id #uuid "d9ce9479-a493-554f-88d6-f3b32cbf67e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbolic cylinder whose axis is the $y$-axis" :db/id #edb/ref 17592186401536}] :answer-field/correct {:answer/id #uuid "359f70ba-f3cf-563a-9d19-52e3ff5fe27b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A parabolic cylinder whose axis is the $x$-axis" :db/id #edb/ref 17592186401533} :answer-field/id #uuid "fa665e14-2670-50c6-9aa4-6148466ac38d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401531}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "50443007-c819-5285-a74f-1d6dfd323e6d" :question/math-academy-id "q-164547" :question/problem "Identify the following surface:\n\n$$\n{y}^{2}=2z,\\,-\\infty <x<\\infty .\n$$" :question/worked-solution "Recall that the equation of a parabolic cylinder whose axis is the $z$-axis is given by\n\n$$\n{x}^{2}=4py.\n$$\n\nThus, a parabolic cylinder whose axis is the $x$**-axis** is given by\n\n$$\n{y}^{2}=4pz.\n$$\n\nTherefore, our equation is a parabolic cylinder whose axis is the $x$-axis and $p=\\frac{1}{2}.$"}] [{:db/id #edb/ref 17592186411870 :knowledge-point/_questions [{:db/id #edb/ref 17592186124597 :knowledge-point/id #uuid "549870ce-a18a-5a94-a9ea-f3de72aaac1f" :knowledge-point/title "Identifying Quadric Surfaces by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0171cec4-3060-54fe-b331-7b0cb56feb0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cone centered at $(-3,0,1)$" :db/id #edb/ref 17592186411682} {:answer/id #uuid "383f6ed0-5fb4-59d2-b70a-efaec189d129" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets centered at $(3,0,-1)$" :db/id #edb/ref 17592186411708} {:answer/id #uuid "5618185e-e1f3-562e-9bda-391291612de3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cone centered at $(3,0,-1)$" :db/id #edb/ref 17592186411724} {:answer/id #uuid "7b843362-d96d-5169-8747-167de74eaed4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet centered at $(3,0,-1)$" :db/id #edb/ref 17592186411743} {:answer/id #uuid "ebb80510-3271-536a-ba4e-07dbc48d8ccc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cone centered at $(3,4,1)$" :db/id #edb/ref 17592186411810}] :answer-field/correct {:answer/id #uuid "5618185e-e1f3-562e-9bda-391291612de3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cone centered at $(3,0,-1)$" :db/id #edb/ref 17592186411724} :answer-field/id #uuid "dcd694e5-15ab-54db-83e7-909825ce1c4f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411846}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b34cb85d-113c-5f8c-bb3f-86df801d970e" :question/math-academy-id "q-164552" :question/problem "Identify the surface ${x}^{2}+4{y}^{2}-{z}^{2}-6x-2z+8=0.$" :question/worked-solution "First, we complete the square in the $x$ and $z$ terms:\n\n$$\n\\begin{aligned}{x}^{2}+4{y}^{2}-{z}^{2}-6x-2z+8 & =0 \\\\ ({x}^{2}-6x)+4{y}^{2}-({z}^{2}+2z)+8 & =0 \\\\ (x-3)^{2}-9+4{y}^{2}-(z+1)^{2}+1+8 & =0 \\\\ (x-3)^{2}+4{y}^{2}-(z+1)^{2} & =0\\end{aligned}\n$$\n\nThis is the equation of an elliptic cone centered at $(3,0,-1).$"}] [{:db/id #edb/ref 17592186402488 :knowledge-point/_questions [{:db/id #edb/ref 17592186124597 :knowledge-point/id #uuid "549870ce-a18a-5a94-a9ea-f3de72aaac1f" :knowledge-point/title "Identifying Quadric Surfaces by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "adf28e93-9856-5b88-a118-c7fdc1ed380b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid centered at $(-1,0,1)$" :db/id #edb/ref 17592186402490} {:answer/id #uuid "d6d90baa-2f68-5b86-bc0d-0f5ed5239cce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic paraboloid centered at $(-1,1,0)$" :db/id #edb/ref 17592186402491} {:answer/id #uuid "09418836-8d85-5969-8422-a7c16a4c010f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic paraboloid centered at $(1,-1,0)$" :db/id #edb/ref 17592186402492} {:answer/id #uuid "2604ccf1-dbcb-5550-afc6-5a2d18ea1503" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid centered at $(1,-1,0)$" :db/id #edb/ref 17592186402493} {:answer/id #uuid "13ce61ca-12c4-556e-a368-7a6ff53f5341" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cone centered at $(1,-1,0)$" :db/id #edb/ref 17592186402494}] :answer-field/correct {:answer/id #uuid "09418836-8d85-5969-8422-a7c16a4c010f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic paraboloid centered at $(1,-1,0)$" :db/id #edb/ref 17592186402492} :answer-field/id #uuid "c51d387c-bf0a-5c35-97a8-9dc15337e4ac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402489}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e6d1bbdf-cfcb-54f3-b97f-c63787cc6751" :question/math-academy-id "q-36107" :question/problem "Identify the surface $4{y}^{2}+8y+9{z}^{2}-5x+9=0.$" :question/worked-solution "First, we complete the square in the $y$ term:\n\n$$\n\\begin{aligned}4{y}^{2}+8y+9{z}^{2}-5x+9 & =0 \\\\ 4({y}^{2}+2y)+9{z}^{2}-5x+9 & =0 \\\\ 4[(y+1)^{2}-1]+9{z}^{2}-5x+9 & =0 \\\\ 4(y+1)^{2}-4+9{z}^{2}-5x+9 & =0 \\\\ 4(y+1)^{2}+9{z}^{2}-5x+5 & =0\\end{aligned}\n$$\n\nNow, by rearranging, we get the equation\n\n$$\n\\begin{aligned}4(y+1)^{2}+9{z}^{2}-5x+5 & =0 \\\\ 4(y+1)^{2}+9{z}^{2} & =5(x-1) \\\\ \\frac{4(y+1)^{2}}{5}+\\frac{9{z}^{2}}{5} & =x-1.\\end{aligned}\n$$\n\nThis is the equation of an elliptic paraboloid centered at $(1,-1,0).$"}]}
