f620c" #edb/ref 17592186045417] [17592186162181 #edb/ref 1043 #edb/ref 17592186162971 #edb/ref 17592186045417] [17592186162181 #edb/ref 1043 #edb/ref 17592186162972 #edb/ref 17592186045417] [17592186162181 #edb/ref 1043 #edb/ref 17592186162973 #edb/ref 17592186045417] [17592186162181 #edb/ref 1043 #edb/ref 17592186162974 #edb/ref 17592186045417] [17592186162181 #edb/ref 1043 #edb/ref 17592186162975 #edb/ref 17592186045417] [17592186162181 #edb/ref 1043 #edb/ref 17592186162976 #edb/ref 17592186045417] [17592186162181 #edb/ref 1043 #edb/ref 17592186162977 #edb/ref 17592186045417] [17592186162181 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186162181 #edb/ref 1045 "Properties of Variance for Discrete Random Variables" #edb/ref 17592186045417] [17592186162181 #edb/ref 1046 #edb/ref 17592186162974 #edb/ref 17592186045417] [17592186162181 #edb/ref 1049 #edb/ref 17592186048731 #edb/ref 17592186045417] [17592186162181 #edb/ref 1050 420.0 #edb/ref 17592186045417] [17592186162181 #edb/ref 1053 #uuid "9110c851-c32a-57df-a77a-329797a3df41" #edb/ref 17592186045417] [17592186162971 #edb/ref 1058 #edb/ref 17592186162975 #edb/ref 17592186045417] [17592186162971 #edb/ref 1061 33959 #edb/ref 17592186045417] [17592186162971 #edb/ref 1062 #uuid "3174d04a-7e8e-5098-91d3-c55afedd2e39" #edb/ref 17592186045417] [17592186162971 #edb/ref 1063 #edb/ref 17592186162056 #edb/ref 17592186045417] [17592186162972 #edb/ref 1058 #edb/ref 17592186162976 #edb/ref 17592186045417] [17592186162972 #edb/ref 1061 33961 #edb/ref 17592186045417] [17592186162972 #edb/ref 1062 #uuid "fe3d0b73-cb7e-5370-9455-c490da334890" #edb/ref 17592186045417] [17592186162972 #edb/ref 1063 #edb/ref 17592186162057 #edb/ref 17592186045417] [17592186162973 #edb/ref 1058 #edb/ref 17592186162977 #edb/ref 17592186045417] [17592186162973 #edb/ref 1061 33963 #edb/ref 17592186045417] [17592186162973 #edb/ref 1062 #uuid "09f12104-7949-5867-9884-48e422a32857" #edb/ref 17592186045417] [17592186162973 #edb/ref 1063 #edb/ref 17592186162058 #edb/ref 17592186045417] [17592186162974 #edb/ref 1058 #edb/ref 17592186162971 #edb/ref 17592186045417] [17592186162974 #edb/ref 1061 33964 #edb/ref 17592186045417] [17592186162974 #edb/ref 1062 #uuid "65bbda75-37ec-5809-926a-0fb8d31c008d" #edb/ref 17592186045417] [17592186162974 #edb/ref 1063 #edb/ref 17592186163273 #edb/ref 17592186045417] [17592186162975 #edb/ref 1058 #edb/ref 17592186162972 #edb/ref 17592186045417] [17592186162975 #edb/ref 1061 33966 #edb/ref 17592186045417] [17592186162975 #edb/ref 1062 #uuid "55f9fd86-1f4a-5f2c-b7c2-a60113a4a9e8" #edb/ref 17592186045417] [17592186162975 #edb/ref 1063 #edb/ref 17592186163274 #edb/ref 17592186045417] [17592186162976 #edb/ref 1058 #edb/ref 17592186162973 #edb/ref 17592186045417] [17592186162976 #edb/ref 1061 33968 #edb/ref 17592186045417] [17592186162976 #edb/ref 1062 #uuid "e17beec2-91ed-5375-9c58-ab279784f2bf" #edb/ref 17592186045417] [17592186162976 #edb/ref 1063 #edb/ref 17592186163275 #edb/ref 17592186045417] [17592186162977 #edb/ref 1061 33969 #edb/ref 17592186045417] [17592186162977 #edb/ref 1062 #uuid "da23e59c-3020-5db2-8f5b-77675938bf0b" #edb/ref 17592186045417] [17592186162977 #edb/ref 1063 #edb/ref 17592186163276 #edb/ref 17592186045417] [17592186163273 #edb/ref 1064 "There are several important properties of the variance of a random variable that we can use to simplify expressions. \n\nFirstly, the variance of a constant is always zero. That is, for any constant $a,$ we have\n\n$$\n\\textrm{Var}[a] = 0.\n$$\n\nIntuitively, this makes sense. A constant does not vary, so the mean deviation from its expected value should be zero." #edb/ref 17592186045417] [17592186163273 #edb/ref 1065 5458 #edb/ref 17592186045417] [17592186163273 #edb/ref 1066 #uuid "6eb17ec7-1e57-5d75-8a71-9030a420602b" #edb/ref 17592186045417] [17592186163273 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186163274 #edb/ref 1064 "Suppose that $X$ is a random variable and $a$ is a constant. Then,\n\n$$\n\\textrm{Var}[aX] = a^2\\textrm{Var}[X].\n$$\n\nSo, for example, if we know that $\\textrm{Var}[X] = 2,$ then\n\n$$\n\\begin{aligned}\\text{Var}[3X] & ={3}^{2}\\cdot \\text{Var}[X] \\\\  & =9\\cdot \\text{Var}[X] \\\\  & =9\\cdot 2 \\\\  & =18.\\end{aligned}\n$$\n\nSimilarly,\n\n$$\n\\begin{aligned}\\text{Var}[-4X] & =(-4)^{2}\\cdot \\text{Var}[X] \\\\  & =16\\cdot \\text{Var}[X] \\\\  & =16\\cdot 2 \\\\  & =32.\\end{aligned}\n$$\n\n**Note:** To understand why we have to square the constant when we factor it outside the variance, it's helpful to remember that the variance is defined as the expected *squared* deviation from the mean:\n\n$$\n\\textrm{Var}[X] = \\textrm E [ (X - \\textrm E[X])^2 ]\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}\\text{Var}[aX] & =\\text{E}[(aX-\\text{E}[aX])^{2}] \\\\  & =\\text{E}[(aX-a\\text{E}[X])^{2}] \\\\  & =\\text{E}[{a}^{2}(X-\\text{E}[X])^{2}] \\\\  & ={a}^{2}\\text{E}[(X-\\text{E}[X])^{2}] \\\\  & ={a}^{2}\\text{Var}[X].\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186163274 #edb/ref 1065 5459 #edb/ref 17592186045417] [17592186163274 #edb/ref 1066 #uuid "d33b6982-066e-5c82-8138-0283ad8dccbb" #edb/ref 17592186045417] [17592186163274 #edb/ref 1067 "The Variance of a Scaled Random Variable" #edb/ref 17592186045417] [17592186163275 #edb/ref 1064 "Suppose that $X$ is a random variable and $a$ and $b$ are constants. It can be shown that\n\n$$\n\\textrm{Var}[aX+b] = a^2\\textrm{Var}[X].\n$$\n\nA proof of this result is given at the end of this lesson.\n\nTherefore, when a random variable is scaled by a factor of $a$ and shifted by a constant $b\\mathbin{:}$ \n\n- the variance is scaled by a factor of $a^2$ as before, and\n\n- the variance is unaffected by the shift.\n\nThe fact that shifting a random variable leaves the variance unaltered makes intuitive sense. Shifting all values of $X$ by a fixed amount does not change how far apart those values are from each other. \n\nFor example, if we know that $\\textrm{Var}[X] = 3,$ then\n\n$$\n\\begin{aligned}\\text{Var}[2X+1] & ={2}^{2}\\cdot \\text{Var}[X] \\\\  & ={2}^{2}\\cdot 3 \\\\  & =4\\cdot 3 \\\\  & =12.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186163275 #edb/ref 1065 5460 #edb/ref 17592186045417] [17592186163275 #edb/ref 1066 #uuid "1523e51b-84da-5100-809f-09fbcb0d80ba" #edb/ref 17592186045417] [17592186163275 #edb/ref 1067 "The Variance of a Transformed Random Variable" #edb/ref 17592186045417] [17592186163276 #edb/ref 1064 "We wish to prove the following result:\n\n$$\n\\textrm{Var}[aX+b] = a^2\\textrm{Var}[X]\n$$\n\nRecall that, by definition,\n\n$$\n\\textrm{Var}[X] = \\textrm E [ (X - \\textrm E[X])^2 ].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[aX+b] & =\\text{E}[(aX+b-\\text{E}[aX+b])^{2}].\\end{aligned}\n$$\n\nUsing the properties of expected value, we can simplify this as follows:\n\n$$\n\\begin{aligned}\\text{E}[(aX+b-\\text{E}[aX+b])^{2}] & =\\text{E}[(aX+b-a\\text{E}[X]-b)^{2}] \\\\  & =\\text{E}[(aX-a\\text{E}[X])^{2}] \\\\  & =\\text{E}[(a(X-\\text{E}[X]))^{2}] \\\\  & =\\text{E}[{a}^{2}(X-\\text{E}[X])^{2}] \\\\  & ={a}^{2}\\text{E}[(X-\\text{E}[X])^{2}] \\\\  & ={a}^{2}\\text{Var}[X]\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186163276 #edb/ref 1065 5461 #edb/ref 17592186045417] [17592186163276 #edb/ref 1066 #uuid "0372f0de-b6a6-58ee-8195-c04024e8f745" #edb/ref 17592186045417] [17592186163276 #edb/ref 1067 "Proof of the General Formula" #edb/ref 17592186045417] [17592186242081 #edb/ref 1080 "5" #edb/ref 17592186045417] [17592186242081 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186242081 #edb/ref 1083 #uuid "643b59ab-e862-5975-86dd-7355eed4cca6" #edb/ref 17592186045417] [17592186242163 #edb/ref 1080 "\\frac{2\\sqrt{5}}{5}" #edb/ref 17592186045417] [17592186242163 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186242163 #edb/ref 1083 #uuid "6e1ac25e-ba63-509b-9370-23e96efe4ebd" #edb/ref 17592186045417] [17592186242819 #edb/ref 1080 "6" #edb/ref 17592186045417] [17592186242819 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186242819 #edb/ref 1083 #uuid "bac7e8e7-11c4-554e-b61e-02f375d7783a" #edb/ref 17592186045417] [17592186243136 #edb/ref 1080 "\\frac{2\\sqrt{5}}{5}+4" #edb/ref 17592186045417] [17592186243136 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186243136 #edb/ref 1083 #uuid "dc315568-edd6-5abe-b917-d1c33d5e4173" #edb/ref 17592186045417] [17592186243186 #edb/ref 1080 "2" #edb/ref 17592186045417] [17592186243186 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186243186 #edb/ref 1083 #uuid "e1fe8786-4596-56fa-ad58-012b52d63167" #edb/ref 17592186045417] [17592186243660 #edb/ref 1075 #edb/ref 17592186242081 #edb/ref 17592186045417] [17592186243660 #edb/ref 1075 #edb/ref 17592186242163 #edb/ref 17592186045417] [17592186243660 #edb/ref 1075 #edb/ref 17592186242819 #edb/ref 17592186045417] [17592186243660 #edb/ref 1075 #edb/ref 17592186243136 #edb/ref 17592186045417] [17592186243660 #edb/ref 1075 #edb/ref 17592186243186 #edb/ref 17592186045417] [17592186243660 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186243660 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186243660 #edb/ref 1078 #edb/ref 17592186243186 #edb/ref 17592186045417] [17592186243660 #edb/ref 1079 #uuid "718f5cfd-3b86-5662-9124-8b1ae998dc61" #edb/ref 17592186045417] [17592186244227 #edb/ref 1068 #edb/ref 17592186243660 #edb/ref 17592186045417] [17592186244227 #edb/ref 1069 "q-109090" #edb/ref 17592186045417] [17592186244227 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186244227 #edb/ref 1071 "The probability distribution of the random variable $X$ is given below. Given that $\\text{E}[X]=0,$ calculate $\\text{Var}[\\sqrt{5}X+4].$ \n\n| $x$ | $-1$ | $0$ | $1$ |\n| --- | --- | --- | --- |\n| $f(x)$ | $\\frac{1}{5}$ | $\\frac{3}{5}$ | $\\frac{1}{5}$ |" #edb/ref 17592186045417] [17592186244227 #edb/ref 1072 #uuid "7bc237e8-7011-5d1b-897c-e565fd160016" #edb/ref 17592186045417] [17592186244227 #edb/ref 1074 "Recall that for any random variable $X$ and constants $a$ and $b,$ we have\n\n$$\n\\text{Var}[aX+b]={a}^{2}\\cdot \\text{Var}[X].\n$$\n\nIn our case, $a=\\sqrt{5}$ and $b=4.$ Therefore,\n\n$$\n\\begin{aligned}\\text{Var}[\\sqrt{5}X+4] & ={(\\sqrt{5})}^{2}\\cdot \\text{Var}[X] \\\\  & =5\\cdot \\text{Var}[X].\\end{aligned}\n$$\n\nWe can compute the variance of $X$ using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\nAdditionally, we're given that $\\text{E}[X]=0.$ \n\nWe start by computing $\\text{E}[{X}^{2}].$ Summing up the products of each value of ${X}^{2}$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & =(-1)^{2}\\cdot f(-1)+{0}^{2}\\cdot f(0)+{1}^{2}\\cdot f(1) \\\\  & =\\frac{1}{5}+\\frac{1}{5} \\\\  & =\\frac{2}{5}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{2}{5}-{0}^{2} \\\\  & =\\frac{2}{5}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[\\sqrt{5}X+4] & =5\\cdot \\text{Var}[X] \\\\  & =5\\cdot \\frac{2}{5} \\\\  & =2.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186369651 #edb/ref 1068 #edb/ref 17592186369652 #edb/ref 17592186045417] [17592186369651 #edb/ref 1069 "q-129386" #edb/ref 17592186045417] [17592186369651 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186369651 #edb/ref 1071 "If $\\text{Var}[X]=3.6,$ calculate $\\text{Var}[\\frac{10}{3}X].$" #edb/ref 17592186045417] [17592186369651 #edb/ref 1072 #uuid "aeeea4a5-1443-5d67-a950-8990e0faa656" #edb/ref 17592186045417] [17592186369651 #edb/ref 1074 "Recall that for any random variable $X$ and constant $a,$ we have\n\n$$\n\\text{Var}[aX]={a}^{2}\\cdot \\text{Var}[X].\n$$\n\nIn our case, $a=\\frac{10}{3}.$ Therefore,\n\n$$\n\\begin{aligned}\\text{Var}[\\frac{10}{3}X] & ={(\\frac{10}{3})}^{2}\\cdot \\text{Var}[X] \\\\  & =\\frac{100}{9}\\cdot 3.6 \\\\  & =40.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186369652 #edb/ref 1075 #edb/ref 17592186369653 #edb/ref 17592186045417] [17592186369652 #edb/ref 1075 #edb/ref 17592186369654 #edb/ref 17592186045417] [17592186369652 #edb/ref 1075 #edb/ref 17592186369655 #edb/ref 17592186045417] [17592186369652 #edb/ref 1075 #edb/ref 17592186369656 #edb/ref 17592186045417] [17592186369652 #edb/ref 1075 #edb/ref 17592186369657 #edb/ref 17592186045417] [17592186369652 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186369652 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186369652 #edb/ref 1078 #edb/ref 17592186369655 #edb/ref 17592186045417] [17592186369652 #edb/ref 1079 #uuid "e907f6da-cd04-5106-a3c9-cf468f523d2d" #edb/ref 17592186045417] [17592186369653 #edb/ref 1080 "26" #edb/ref 17592186045417] [17592186369653 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369653 #edb/ref 1083 #uuid "6a7a743c-110e-5e17-9b8e-c0a4ed4bf822" #edb/ref 17592186045417] [17592186369654 #edb/ref 1080 "16" #edb/ref 17592186045417] [17592186369654 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369654 #edb/ref 1083 #uuid "d0bc9a45-3558-56aa-b44c-19b91bed820a" #edb/ref 17592186045417] [17592186369655 #edb/ref 1080 "40" #edb/ref 17592186045417] [17592186369655 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369655 #edb/ref 1083 #uuid "6840aa01-0203-5583-a1fb-3ee0ba2fced3" #edb/ref 17592186045417] [17592186369656 #edb/ref 1080 "36" #edb/ref 17592186045417] [17592186369656 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369656 #edb/ref 1083 #uuid "53b84c0f-bed5-541b-8d3e-723a5410d69e" #edb/ref 17592186045417] [17592186369657 #edb/ref 1080 "4" #edb/ref 17592186045417] [17592186369657 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369657 #edb/ref 1083 #uuid "288b9421-5232-599d-975c-4cacf3b01709" #edb/ref 17592186045417] [17592