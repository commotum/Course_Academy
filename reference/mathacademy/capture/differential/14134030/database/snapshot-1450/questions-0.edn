#{[{:db/id #edb/ref 17592186244227 :knowledge-point/_questions [{:db/id #edb/ref 17592186162058 :knowledge-point/id #uuid "85388f7d-b2ee-520b-b711-a7721c6f620c" :knowledge-point/title "Computing the Variance of a Transformed Random Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "643b59ab-e862-5975-86dd-7355eed4cca6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186242081} {:answer/id #uuid "6e1ac25e-ba63-509b-9370-23e96efe4ebd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{5}}{5}" :db/id #edb/ref 17592186242163} {:answer/id #uuid "bac7e8e7-11c4-554e-b61e-02f375d7783a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186242819} {:answer/id #uuid "dc315568-edd6-5abe-b917-d1c33d5e4173" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{5}}{5}+4" :db/id #edb/ref 17592186243136} {:answer/id #uuid "e1fe8786-4596-56fa-ad58-012b52d63167" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186243186}] :answer-field/correct {:answer/id #uuid "e1fe8786-4596-56fa-ad58-012b52d63167" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186243186} :answer-field/id #uuid "718f5cfd-3b86-5662-9124-8b1ae998dc61" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243660}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7bc237e8-7011-5d1b-897c-e565fd160016" :question/math-academy-id "q-109090" :question/problem "The probability distribution of the random variable $X$ is given below. Given that $\\text{E}[X]=0,$ calculate $\\text{Var}[\\sqrt{5}X+4].$ \n\n| $x$ | $-1$ | $0$ | $1$ |\n| --- | --- | --- | --- |\n| $f(x)$ | $\\frac{1}{5}$ | $\\frac{3}{5}$ | $\\frac{1}{5}$ |" :question/worked-solution "Recall that for any random variable $X$ and constants $a$ and $b,$ we have\n\n$$\n\\text{Var}[aX+b]={a}^{2}\\cdot \\text{Var}[X].\n$$\n\nIn our case, $a=\\sqrt{5}$ and $b=4.$ Therefore,\n\n$$\n\\begin{aligned}\\text{Var}[\\sqrt{5}X+4] & ={(\\sqrt{5})}^{2}\\cdot \\text{Var}[X] \\\\  & =5\\cdot \\text{Var}[X].\\end{aligned}\n$$\n\nWe can compute the variance of $X$ using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\nAdditionally, we're given that $\\text{E}[X]=0.$ \n\nWe start by computing $\\text{E}[{X}^{2}].$ Summing up the products of each value of ${X}^{2}$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & =(-1)^{2}\\cdot f(-1)+{0}^{2}\\cdot f(0)+{1}^{2}\\cdot f(1) \\\\  & =\\frac{1}{5}+\\frac{1}{5} \\\\  & =\\frac{2}{5}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{2}{5}-{0}^{2} \\\\  & =\\frac{2}{5}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[\\sqrt{5}X+4] & =5\\cdot \\text{Var}[X] \\\\  & =5\\cdot \\frac{2}{5} \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186369651 :knowledge-point/_questions [{:db/id #edb/ref 17592186162057 :knowledge-point/id #uuid "8a3752a0-431d-5520-97b1-493c36bbce54" :knowledge-point/title "Computing the Variance of a Scaled Random Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a7a743c-110e-5e17-9b8e-c0a4ed4bf822" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186369653} {:answer/id #uuid "d0bc9a45-3558-56aa-b44c-19b91bed820a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186369654} {:answer/id #uuid "6840aa01-0203-5583-a1fb-3ee0ba2fced3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186369655} {:answer/id #uuid "53b84c0f-bed5-541b-8d3e-723a5410d69e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186369656} {:answer/id #uuid "288b9421-5232-599d-975c-4cacf3b01709" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186369657}] :answer-field/correct {:answer/id #uuid "6840aa01-0203-5583-a1fb-3ee0ba2fced3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186369655} :answer-field/id #uuid "e907f6da-cd04-5106-a3c9-cf468f523d2d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186369652}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "aeeea4a5-1443-5d67-a950-8990e0faa656" :question/math-academy-id "q-129386" :question/problem "If $\\text{Var}[X]=3.6,$ calculate $\\text{Var}[\\frac{10}{3}X].$" :question/worked-solution "Recall that for any random variable $X$ and constant $a,$ we have\n\n$$\n\\text{Var}[aX]={a}^{2}\\cdot \\text{Var}[X].\n$$\n\nIn our case, $a=\\frac{10}{3}.$ Therefore,\n\n$$\n\\begin{aligned}\\text{Var}[\\frac{10}{3}X] & ={(\\frac{10}{3})}^{2}\\cdot \\text{Var}[X] \\\\  & =\\frac{100}{9}\\cdot 3.6 \\\\  & =40.\\end{aligned}\n$$"}]}
