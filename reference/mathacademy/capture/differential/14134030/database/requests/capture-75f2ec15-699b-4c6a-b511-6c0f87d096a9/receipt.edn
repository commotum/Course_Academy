45498 13194139534763 17592186045417 true] [17592186435368 1083 #uuid "a9534937-1eca-5636-899b-550bfbfe6e07" 13194139534763 17592186045417 true] [17592186435369 1080 "12" 13194139534763 17592186045417 true] [17592186435369 1082 #edb/ref 17592186045498 13194139534763 17592186045417 true] [17592186435369 1083 #uuid "fc28d66e-a0b9-5d76-9c20-a4f103450187" 13194139534763 17592186045417 true] [17592186435370 1075 #edb/ref 17592186435365 13194139534763 17592186045417 true] [17592186435370 1075 #edb/ref 17592186435366 13194139534763 17592186045417 true] [17592186435370 1075 #edb/ref 17592186435367 13194139534763 17592186045417 true] [17592186435370 1075 #edb/ref 17592186435368 13194139534763 17592186045417 true] [17592186435370 1075 #edb/ref 17592186435369 13194139534763 17592186045417 true] [17592186435370 1076 #edb/ref 17592186045493 13194139534763 17592186045417 true] [17592186435370 1077 "selection" 13194139534763 17592186045417 true] [17592186435370 1078 #edb/ref 17592186435367 13194139534763 17592186045417 true] [17592186435370 1079 #uuid "aadf43d0-7c01-553a-93ba-140bd9fcc568" 13194139534763 17592186045417 true] [17592186435371 1068 #edb/ref 17592186435370 13194139534763 17592186045417 true] [17592186435371 1069 "q-109059" 13194139534763 17592186045417 true] [17592186435371 1070 #edb/ref 17592186045487 13194139534763 17592186045417 true] [17592186435371 1071 "The probability distribution of the random variable $X$ is given below. Given that $\\text{E}[X]=1,$ calculate $\\text{Var}[-2X].$ \n\n| $x$ | $0$ | $1$ | $3$ |\n| --- | --- | --- | --- |\n| $f(x)$ | $\\frac{1}{2}$ | $\\frac{1}{4}$ | $\\frac{1}{4}$ |" 13194139534763 17592186045417 true] [17592186435371 1072 #uuid "a7e780b8-35dc-5693-8651-c458793347c5" 13194139534763 17592186045417 true] [17592186435371 1074 "Recall that for any random variable $X$ and constant $a,$ we have\n\n$$\n\\text{Var}[aX]={a}^{2}\\cdot \\text{Var}[X].\n$$\n\nIn our case, $a=-2.$ Therefore,\n\n$$\n\\begin{aligned}\\text{Var}[-2X] & =(-2)^{2}\\cdot \\text{Var}[X] \\\\  & =4\\cdot \\text{Var}[X].\\end{aligned}\n$$\n\nWe can compute the variance of $X$ using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\nAdditionally, we're given that $\\text{E}[X]=1.$ \n\nWe start by computing $\\text{E}[{X}^{2}].$ Summing up the products of each value of ${X}^{2}$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={0}^{2}\\cdot f(0)+{1}^{2}\\cdot f(1)+{3}^{2}\\cdot f(3) \\\\  & =\\frac{1}{4}+9\\cdot \\frac{1}{4} \\\\  & =\\frac{5}{2}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{5}{2}-{1}^{2} \\\\  & =\\frac{3}{2}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[-2X] & =4\\cdot \\text{Var}[X] \\\\  & =4\\cdot \\frac{3}{2} \\\\  & =6.\\end{aligned}\n$$" 13194139534763 17592186045417 true] [17592186435372 1058 #edb/ref 17592186435374 13194139534763 17592186045417 true] [17592186435372 1062 #uuid "02fca583-999d-5fea-95bb-2fa89ae7e5ac" 13194139534763 17592186045417 true] [17592186435372 1063 #edb/ref 17592186244227 13194139534763 17592186045417 true] [17592186435373 1058 #edb/ref 17592186435372 13194139534763 17592186045417 true] [17592186435373 1062 #uuid "142fd15b-c875-518a-9165-bb478aa0e810" 13194139534763 17592186045417 true] [17592186435373 1063 #edb/ref 17592186435371 13194139534763 17592186045417 true] [17592186435374 1062 #uuid "98fbfae8-3ff5-5189-8ae4-c342310ec549" 13194139534763 17592186045417 true] [17592186435374 1063 #edb/ref 17592186369651 13194139534763 17592186045417 true]] :edb/tempids {"activity-25dbc02e-bef9-5aef-9959-0f81fd1d0280" 17592186435364 "answer-039f84c9-15b6-5535-9aa7-17f63520b5ea" 17592186435365 "answer-31713117-0676-52eb-93ae-63c695655871" 17592186435366 "answer-7d294bd2-f457-5854-b801-d01d068966a4" 17592186435367 "answer-a9534937-1eca-5636-899b-550bfbfe6e07" 17592186435368 "answer-fc28d66e-a0b9-5d76-9c20-a4f103450187" 175921