1}{6(2-x)})}^{2} \\\\ y & =\\frac{1}{36(2-x)^{2}}\\end{aligned}\n$$\n\nTherefore, the inverse function is \n\n$$\n{f}^{-1}(x)=\\frac{1}{36(2-x)^{2}}.\n$$\n\n**Note**: The domain and range of $f(x)$ are\n\n$$\nx>0,\\,f(x)<2.\n$$\n\nTherefore, the domain and range of ${f}^{-1}(x)$ are\n\n$$\nx<2,\\,{f}^{-1}(x)>0.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-40d99a89-ad22-5776-b72c-624e7b154468"] :db/ensure [:question/validate]} {:db/id "answer-field-40d99a89-ad22-5776-b72c-624e7b154468" :answer-field/id #uuid "40d99a89-ad22-5776-b72c-624e7b154468" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-9e485cf9-61f6-51e5-b155-eeafd0535fb8" :answer-field/choices ["answer-9e485cf9-61f6-51e5-b155-eeafd0535fb8"] :db/ensure [:answer-field/validate]} {:db/id "answer-9e485cf9-61f6-51e5-b155-eeafd0535fb8" :answer/id #uuid "9e485cf9-61f6-51e5-b155-eeafd0535fb8" :answer/type :answer.type/math :answer/value "\\frac{1}{36(2-x)^2}" :db/ensure [:answer/validate]} {:db/id "question-0b14029b-c258-5cb1-9467-400506e4dea8" :question/id #uuid "0b14029b-c258-5cb1-9467-400506e4dea8" :question/math-academy-id "q-148747" :question/problem "Find the inverse of the function $f(x)=\\frac{1}{4\\sqrt[3]{x}}+2.$" :question/worked-solution "To find ${f}^{-1}(x),$ we start by replacing $f(x)$ with $y:$\n\n$$\ny=\\frac{1}{4\\sqrt[3]{x}}+2\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx=\\frac{1}{4\\sqrt[3]{y}}+2.\n$$\n\nThen, we make $y$ the subject of the equation as follows:\n\n$$\n\\begin{aligned}x & =\\frac{1}{4\\sqrt[3]{y}}+2 \\\\ x-2 & =\\frac{1}{4\\sqrt[3]{y}} \\\\ \\sqrt[3]{y} & =\\frac{1}{4(x-2)} \\\\ (\\sqrt[3]{y})^{3} & ={(\\frac{1}{4(x-2)})}^{3} \\\\ y & =\\frac{1}{64(x-2)^{3}}\\end{aligned}\n$$\n\nTherefore, the inverse function is \n\n$$\n{f}^{-1}(x)=\\frac{1}{64(x-2)^{3}}.\n$$\n\n**Note**: The domain and range of $f(x)$ are\n\n$$\nx\\ne 0,\\,f(x)\\ne 2.\n$$\n\nTherefore, the domain and range of ${f}^{-1}(x)$ are\n\n$$\nx\\ne 2,\\,{f}^{-1}(x)\\ne 0.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-dcbe83e8-d72e-5bb6-b19b-e4a77cbd25ee"] :db/ensure [:question/validate]} {:db/id "answer-field-dcbe83e8-d72e-5bb6-b19b-e4a77cbd25ee" :answer-field/id #uuid "dcbe83e8-d72e-5bb6-b19b-e4a77cbd25ee" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f5ceef0a-2fb9-54f4-a30f-c1f6dea6f8fa" :answer-field/choices ["answer-bdf416e7-2557-519f-9c8d-e7755baf7e45" "answer-96b7e621-3bbb-55a8-a16a-7decc770db27" "answer-6518ddc4-2fcf-51ec-b05c-ac3df3011702" "answer-f5ceef0a-2fb9-54f4-a30f-c1f6dea6f8fa" "answer-52df6e02-287c-5a79-93aa-3df8e4867c19"] :db/ensure [:answer-field/validate]} {:db/id "answer-bdf416e7-2557-519f-9c8d-e7755baf7e45" :answer/id #uuid "bdf416e7-2557-519f-9c8d-e7755baf7e45" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=64(x-2)^{3}" :db/ensure [:answer/validate]} {:db/id "answer-96b7e621-3bbb-55a8-a16a-7decc770db27" :answer/id #uuid "96b7e621-3bbb-55a8-a16a-7decc770db27" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=64{x}^{3}-2" :db/ensure [:answer/validate]} {:db/id "answer-6518ddc4-2fcf-51ec-b05c-ac3df3011702" :answer/id #uuid "6518ddc4-2fcf-51ec-b05c-ac3df3011702" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=\\frac{1}{4{x}^{3}}-2" :db/ensure [:answer/validate]} {:db/id "answer-f5ceef0a-2fb9-54f4-a30f-c1f6dea6f8fa" :answer/id #uuid "f5ceef0a-2fb9-54f4-a30f-c1f6dea6f8fa" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=\\frac{1}{64(x-2)^{3}}" :db/ensure [:answer/validate]} {:db/id "answer-52df6e02-287c-5a79-93aa-3df8e4867c19" :answer/id #uuid "52df6e02-287c-5a79-93aa-3df8e4867c19" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=\\frac{2}{(x-4)^{3}}" :db/ensure [:answer/validate]} {:db/id "question-37674798-c6eb-521f-b1bd-86df515c51cc" :question/id #uuid "37674798-c6eb-521f-b1bd-86df515c51cc" :question/math-academy-id "q-148501" :question/problem "Find the inverse of the function $f(x)=2\\sqrt[3]{3x-1}.$" :question/worked-solution "To find ${f}^{-1}(x),$ we start by replacing $f(x)$ with $y:$\n\n$$\ny=2\\sqrt[3]{3x-1}\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx=2\\sqrt[3]{3y-1}.\n$$\n\nThen, we make $y$ the subject of the equation as follows:\n\n$$\n\\begin{aligned}x & =2\\sqrt[3]{3y-1} \\\\ \\sqrt[3]{3y-1} & =\\frac{1}{2}x \\\\ {(\\sqrt[3]{3y-1})}^{3} & ={(\\frac{1}{2}x)}^{3} \\\\ 3y-1 & =\\frac{1}{8}{x}^{3} \\\\ 3y & =\\frac{1}{8}{x}^{3}+1 \\\\ y & =\\frac{1}{3}(\\frac{1}{8}{x}^{3}+1) \\\\ y & =\\frac{1}{24}({x}^{3}+8)\\end{aligned}\n$$\n\nTherefore, the inverse function is \n\n$$\n{f}^{-1}(x)=\\frac{1}{24}({x}^{3}+8).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-34761f03-b01e-5d22-8611-5c45286ea99b"] :db/ensure [:question/validate]} {:db/id "answer-field-34761f03-b01e-5d22-8611-5c45286ea99b" :answer-field/id #uuid "34761f03-b01e-5d22-8611-5c45286ea99b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6c68ea4c-d5d7-5c9b-a465-6fa09bd2ebf5" :answer-field/choices ["answer-e37e5b73-e8d4-5af6-b8e6-580429037d3e" "answer-f2dd486e-0038-5ce9-9d90-476d55220192" "answer-6c68ea4c-d5d7-5c9b-a465-6fa09bd2ebf5" "answer-f02462fe-ef6d-54c3-9d42-6b2cb1464fdc" "answer-94cdd666-3a14-52b6-9bc6-23f645829972"] :db/ensure [:answer-field/validate]} {:db/id "answer-e37e5b73-e8d4-5af6-b8e6-580429037d3e" :answer/id #uuid "e37e5b73-e8d4-5af6-b8e6-580429037d3e" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=12(x-1)^{3}" :db/ensure [:answer/validate]} {:db/id "answer-f2dd486e-0038-5ce9-9d90-476d55220192" :answer/id #uuid "f2dd486e-0038-5ce9-9d90-476d55220192" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=6({x}^{3}-2)" :db/ensure [:answer/validate]} {:db/id "answer-6c68ea4c-d5d7-5c9b-a465-6fa09bd2ebf5" :answer/id #uuid "6c68ea4c-d5d7-5c9b-a465-6fa09bd2ebf5" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=\\frac{1}{24}({x}^{3}+8)" :db/ensure [:answer/validate]} {:db/id "answer-f02462fe-ef6d-54c3-9d42-6b2cb1464fdc" :answer/id #uuid "f02462fe-ef6d-54c3-9d42-6b2cb1464fdc" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=\\frac{1}{4}{(x+2)}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-94cdd666-3a14-52b6-9bc6-23f645829972" :answer/id #uuid "94cdd666-3a14-52b6-9bc6-23f645829972" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=\\frac{1}{8}({x}^{3}+1)" :db/ensure [:answer/validate]} {:db/id "question-14c0067f-8b9b-586e-a9fe-ecef26e510a6" :question/id #uuid "14c0067f-8b9b-586e-a9fe-ecef26e510a6" :question/math-academy-id "q-277826" :question/problem "Find the inverse of the function $f(x)=\\frac{3}{\\sqrt[3]{2x-1}}+2.$\n\n${f}^{-1}(x)=$\n{{field-1}}" :question/worked-solution "To find ${f}^{-1}(x),$ we start by replacing $f(x)$ with $y:$\n\n$$\ny=\\frac{3}{\\sqrt[3]{2x-1}}+2\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx=\\frac{3}{\\sqrt[3]{2y-1}}+2.\n$$\n\nThen, we make $y$ the subject of the equation as follows:\n\n$$\n\\begin{aligned}x & =\\frac{3}{\\sqrt[3]{2y-1}}+2 \\\\ \\sqrt[3]{2y-1} & =\\frac{3}{x-2} \\\\ (\\sqrt[3]{2y-1})^{3} & ={(\\frac{3}{x-2})}^{3} \\\\ 2y-1 & =\\frac{27}{(x-2)^{3}} \\\\ 2y & =\\frac{27}{(x-2)^{3}}+1 \\\\ y & =\\frac{27}{2(x-2)^{3}}+\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, the inverse function is \n\n$$\n{f}^{-1}(x)=\\frac{27}{2(x-2)^{3}}+\\frac{1}{2}.\n$$\n\n**Note**: The domain and range of $f(x)$ are\n\n$$\nx\\ne \\frac{1}{2},\\,f(x)\\ne 2.\n$$\n\nTherefore, the domain and range of ${f}^{-1}(x)$ are\n\n$$\nx\\ne 2,\\,{f}^{-1}(x)\\ne \\frac{1}{2}.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-5e843349-d8eb-5c3b-b2d7-adbfcd0cf240"] :db/ensure [:question/validate]} {:db/id "answer-field-5e843349-d8eb-5c3b-b2d7-adbfcd0cf240" :answer-field/id #uuid "5e843349-d8eb-5c3b-b2d7-adbfcd0cf240" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-2dc46780-aad0-5339-8bcd-85933f0f6ae1" :answer-field/choices ["answer-2dc46780-aad0-5339-8bcd-85933f0f6ae1"] :db/ensure [:answer-field/validate]} {:db/id "answer-2dc46780-aad0-5339-8bcd-85933f0f6ae1" :answer/id #uuid "2dc46780-aad0-5339-8bcd-85933f0f6ae1" :answer/type :answer.type/math :answer/value "\\frac{27}{2(x-2)^{3}}+\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "question-286413cf-e05b-52a9-9010-9fd10625bdfe" :question/id #uuid "286413cf-e05b-52a9-9010-9fd10625bdfe" :question/math-academy-id "q-148496" :question/problem "Find the inverse of the function $f(x)=\\frac{1}{3}\\sqrt[3]{x-3}.$" :question/worked-solution "To find ${f}^{-1}(x),$ we start by replacing $f(x)$ with $y:$\n\n$$\ny=\\frac{1}{3}\\sqrt[3]{x-3}\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx=\\frac{1}{3}\\sqrt[3]{y-3}.\n$$\n\nThen, we make $y$ the subject of the equation as follows:\n\n$$\n\\begin{aligned}x & =\\frac{1}{3}\\sqrt[3]{y-3} \\\\ \\sqrt[3]{y-3} & =3x \\\\ {(\\sqrt[3]{y-3})}^{3} & ={(3x)}^{3} \\\\ y-3 & =27{x}^{3} \\\\ y & =27{x}^{3}+3\\end{aligned}\n$$\n\nTherefore, the inverse function is \n\n$$\n{f}^{-1}(x)=27{x}^{3}+3.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b9cdd843-64c4-50a3-ad0d-06cbfb60f172"] :db/ensure [:question/validate]} {:db/id "answer-field-b9cdd843-64c4-50a3-ad0d-06cbfb60f172" :answer-field/id #uuid "b9cdd843-64c4-50a3-ad0d-06cbfb60f172" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8c683e72-6d13-57a1-b930-019be2268271" :answer-field/choices ["answer-8532f603-d7b3-5d9b-a75f-906ea9009617" "answer-bace4cbf-a365-53e9-bce0-e3383e584bbb" "answer-8c683e72-6d13-57a1-b930-019be2268271" "answer-df3aa2c2-149a-55c8-b611-81c3367b402f" "answer-5fd39f34-1a8b-5f62-a888-d836f9832ac3"] :db/ensure [:answer-field/validate]} {:db/id "answer-8532f603-d7b3-5d9b-a75f-906ea9009617" :answer/id #uuid "8532f603-d7b3-5d9b-a75f-906ea9009617" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=(x+3)^{3}-3" :db/ensure [:answer/validate]} {:db/id "answer-bace4cbf-a365-53e9-bce0-e3383e584bbb" :answer/id #uuid "bace4cbf-a365-53e9-bce0-e3383e584bbb" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=(x-3)^{3}+3" :db/ensure [:answer/validate]} {:db/id "answer-8c683e72-6d13-57a1-b930-019be2268271" :answer/id #uuid "8c683e72-6d13-57a1-b930-019be2268271" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=27{x}^{3}+3" :db/ensure [:answer/validate]} {:db/id "answer-df3aa2c2-149a-55c8-b611-81c3367b402f" :answer/id #uuid "df3aa2c2-149a-55c8-b611-81c3367b402f" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=3{x}^{3}-27" :db/ensure [:answer/validate]} {:db/id "answer-5fd39f34-1a8b-5f62-a888-d836f9832ac3" :answer/id #uuid "5fd39f34-1a8b-5f62-a888-d836f9832ac3" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=9{x}^{3}+1" :db/ensure [:answer/validate]} {:db/id "question-f36e5ef3-ccb2-5795-aca3-91dfb93e14f0" :question/id #uuid "f36e5ef3-ccb2-5795-aca3-91dfb93e14f0" :question/math-academy-id "q-148494" :question/problem "Find the inverse of the function $f(x)=\\frac{1}{2}\\sqrt{x-1}+3.$" :question/worked-solution "To find ${f}^{-1}(x),$ we start by replacing $f(x)$ with $y:$\n\n$$\ny=\\frac{1}{2}\\sqrt{x-1}+3\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx=\\frac{1}{2}\\sqrt{y-1}+3.\n$$\n\nThen, we make $y$ the subject of the equation as follows:\n\n$$\n\\begin{aligned}x & =\\frac{1}{2}\\sqrt{y-1}+3 \\\\ \\frac{1}{2}\\sqrt{y-1} & =x-3 \\\\ \\sqrt{y-1} & =2(x-3) \\\\ {(\\sqrt{y-1})}^{2} & ={(2(x-3))}^{2} \\\\ y-1 & =4(x-3)^{2} \\\\ y & =4(x-3)^{2}+1\\end{aligned}\n$$\n\nTherefore, the inverse function is \n\n$$\n{f}^{-1}(x)=4(x-3)^{2}+1.\n$$\n\n**Note**: The domain and range of $f(x)$ are\n\n$$\nx\\ge 1,\\,f(x)\\ge 3.\n$$\n\nTherefore, the domain and range of ${f}^{-1}(x)$ are\n\n$$\nx\\ge 3,\\,{f}^{-1}(x)\\ge 1.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f4ff08e9-b72b-5342-b55b-78431f176928"] :db/ensure [:question/validate]} {:db/id "answer-field-f4ff08e9-b72b-5342-b55b-78431f176928" :answer-field/id #uuid "f4ff08e9-b72b-5342-b55b-78431f176928" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-dd9c5c09-10a6-5342-af9b-78b2b5ae6a65" :answer-field/choices ["answer-dd9c5c09-10a6-5342-af9b-78b2b5ae6a65" "answer-fd71342d-0d39-5d72-ad19-e051b324e06a" "answer-480959df-c442-5539-928c-11f21e7bf1e3" "answer-2dcd6be4-7ab5-5b54-88c5-9399ecae152a" "answer-a85b8ce9-a004-5f51-988e-d3a07f8cb054"] :db/ensure [:answer-field/validate]} {:db/id "answer-dd9c5c09-10a6-5342-af9b-78b2b5ae6a65" :answer/id #uuid "dd9c5c09-10a6-5342-af9b-78b2b5ae6a65" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=4(x-3)^{2}+1" :db/ensure [:answer/validate]} {:db/id "answer-fd71342d-0d39-5d72-ad19-e051b324e06a" :answer/id #uuid "fd71342d-0d39-5d72-ad19-e051b324e06a" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=9(x-1)^{2}+2" :db/ensure [:answer/validate]} {:db/id "answer-480959df-c442-5539-928c-11f21e7bf1e3" :answer/id #uuid "480959df-c442-5539-928c-11f21e7bf1e3" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=9(x-1)^{2}-4" :db/ensure [:answer/validate]} {:db/id "answer-2dcd6be4-7ab5-5b54-88c5-9399ecae152a" :answer/id #uuid "2dcd6be4-7ab5-5b54-88c5-9399ecae152a" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=\\frac{1}{2}(x-3)^{2}-2" :db/ensure [:answer/validate]} {:db/id "answer-a85b8ce9-a004-5f51-988e-d3a07f8cb054" :answer/id #uuid "a85b8ce9-a004-5f51-988e-d3a07f8cb054" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=\\frac{1}{3}(x-3)^{2}-1" :db/ensure [:answer/validate]} {:db/id "question-7e395659-7f2e-5dda-a6c4-f51ac9defcd5" :question/id #uuid "7e395659-7f2e-5dda-a6c4-f51ac9defcd5" :question/math-academy-id "q-148550" :question/problem "Find the inverse of the function $f(x)=2-\\frac{1}{\\sqrt{3x+2}}.$" :question/worked-solution "To find ${f}^{-1}(x),$ we start by replacing $f(x)$ with $y:$\n\n$$\ny=2-\\frac{1}{\\sqrt{3x+2}}\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx=2-\\frac{1}{\\sqrt{3y+2}}.\n$$\n\nThen, we make $y$ the subject of the equation as follows:\n\n$$\n\\begin{aligned}x & =2-\\frac{1}{\\sqrt{3y+2}} \\\\ x-2 & =-\\frac{1}{\\sqrt{3y+2}} \\\\ 2-x & =\\frac{1}{\\sqrt{3y+2}} \\\\ \\sqrt{3y+2} & =\\frac{1}{2-x} \\\\ {(\\sqrt{3y+2})}^{2} & ={(\\frac{1}{2-x})}^{2} \\\\ 3y+2 & =\\frac{1}{(x-2)^{2}} \\\\ 3y & =\\frac{1}{(x-2)^{2}}-2 \\\\ y & =\\frac{1}{3(x-2)^{2}}-\\frac{2}{3}\\end{aligned}\n$$\n\nTherefore, the inverse function is \n\n$$\n{f}^{-1}(x)=\\frac{1}{3(x-2)^{2}}-\\frac{2}{3}.\n$$\n\n**Note**: The domain and range of $f(x)$ are\n\n$$\nx>-\\frac{2}{3},\\,f(x)<2.\n$$\n\nTherefore, the domain and range of ${f}^{-1}(x)$ are\n\n$$\nx<2,\\,{f}^{-1}(x)>-\\frac{2}{3}.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-ab8f4d5e-ee1c-54bc-8580-83267a345dee"] :db/ensure [:question/validate]} {:db/id "answer-field-ab8f4d5e-ee1c-54bc-8580-83267a345dee" :answer-field/id #uuid "ab8f4d5e-ee1c-54bc-8580-83267a345dee" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f92861fe-09c8-581d-936f-0b83ad2bc2b4" :answer-field/choices ["answer-2477bab7-122c-5324-8f02-3dc1b27b3327" "answer-72fb6298-18a6-56bf-a33e-72c4a66e7145" "answer-f92861fe-09c8-581d-936f-0b83ad2bc2b4" "answer-b3a95a87-c0da-5973-ba25-281d8d1b9a09" "answer-4d200f15-e854-5e0c-8e6d-204211621378"] :db/ensure [:answer-field/validate]} {:db/id "answer-2477bab7-122c-5324-8f02-3dc1b27b3327" :answer/id #uuid "2477bab7-122c-5324-8f02-3dc1b27b3327" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=\\frac{1}{2(x-2)^{2}}-1" :db/ensure [:answer/validate]} {:db/id "answer-72fb6298-18a6-56bf-a33e-72c4a66e7145" :answer/id #uuid "72fb6298-18a6-56bf-a33e-72c4a66e7145" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=\\frac{1}{2{x}^{2}}-3" :db/ensure [:answer/validate]} {:db/id "answer-f92861fe-09c8-581d-936f-0b83ad2bc2b4" :answer/id #uuid "f92861fe-09c8-581d-936f-0b83ad2bc2b4" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=\\frac{1}{3(x-2)^{2}}-\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "answer-b3a95a87-c0da-5973-ba25-281d8d1b9a09" :answer/id #uuid "b3a95a87-c0da-5973-ba25-281d8d1b9a09" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=\\frac{3}{(x-2)^{2}}-6" :db/ensure [:answer/validate]} {:db/id "answer-4d200f15-e854-5e0c-8e6d-204211621378" :answer/id #uuid "4d200f15-e854-5e0c-8e6d-204211621378" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=\\frac{3}{{x}^{2}}-\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "question-5cb5bb60-d097-50b4-9ba5-bde88e86a4d3" :question/id #uuid "5cb5bb60-d097-50b4-9ba5-bde88e86a4d3" :question/math-academy-id "q-277959" :question/problem "The function $f(x),$ defined as\n\n$$\nf(x)=\\frac{2}{k\\sqrt[3]{6x-1}}+2,\\,x\\ne \\frac{1}{6}\n$$\n\nhas an inverse function given by \n\n$$\n{f}^{-1}(x)=\\frac{4}{81(x-2)^{3}}+\\frac{1}{6},\\,x\\ne 2.\n$$\n\nWhat is the value of $k?$\n\n$k=$\n{{field-1}}" :question/worked-solution "To find ${f}^{-1}(x),$ we start by replacing $f(x)$ with $y:$\n\n$$\ny=\\frac{2}{k\\sqrt[3]{6x-1}}+2\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx=\\frac{2}{k\\sqrt[3]{6y-1}}+2.\n$$\n\nThen, we make $y$ the subject of the equation as follows:\n\n$$\n\\begin{aligned}x & =\\frac{2}{k\\sqrt[3]{6y-1}}+2 \\\\ \\frac{2}{k\\sqrt[3]{6y-1}} & =x-2 \\\\ \\sqrt[3]{6y-1} & =\\frac{2}{k(x-2)} \\\\ {(\\sqrt[3]{6y-1})}^{3} & ={(\\frac{2}{k(x-2)})}^{3} \\\\ 6y-1 & =\\frac{{2}^{3}}{{k}^{3}(x-2)^{3}} \\\\ 6y & =\\frac{8}{{k}^{3}(x-2)^{3}}+1 \\\\ y & =\\frac{4}{3{k}^{3}(x-2)^{3}}+\\frac{1}{6}\\end{aligned}\n$$\n\nTherefore, the inverse function is \n\n$$\n{f}^{-1}(x)=\\frac{4}{3{k}^{3}(x-2)^{3}}+\\frac{1}{6},\\,x\\ne 2.\n$$\n\nComparing our answer with the given expression, we conclude that\n\n$$\n\\frac{4}{3{k}^{3}}=\\frac{4}{81}\\,⟹\\,k=3.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-e9e8e3bd-efc4-5161-8659-23fbd7d317a4"] :db/ensure [:question/validate]} {:db/id "answer-field-e9e8e3bd-efc4-5161-8659-23fbd7d317a4" :answer-field/id #uuid "e9e8e3bd-efc4-5161-8659-23fbd7d317a4" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-8963ea18-7842-5daf-9fc8-8d25637a3833" :answer-field/choices ["answer-8963ea18-7842-5daf-9fc8-8d25637a3833"] :db/ensure [:answer-field/validate]} {:db/id "answer-8963ea18-7842-5daf-9fc8-8d25637a3833" :answer/id #uuid "8963ea18-7842-5daf-9fc8-8d25637a3833" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "question-22e0c565-a427-5cb0-889a-a9c4e5867def" :question/id #uuid "22e0c565-a427-5cb0-889a-a9c4e5867def" :question/math-academy-id "q-277956" :question/problem "The function $f(x),$ defined as\n\n$$\nf(x)=\\frac{k}{\\sqrt{8x+3}}+2,\\,x>-\\frac{3}{8}\n$$\n\nhas an inverse function given by \n\n$$\n{f}^{-1}(x)=\\frac{9}{2(x-2)^{2}}-\\frac{3}{8},\\,x>2.\n$$\n\nWhat is the value of $k?$ Assume that $k>0.$\n\n$k=$\n{{field-1}}" :question/worked-solution "To find ${f}^{-1}(x),$ we start by replacing $f(x)$ with $y:$\n\n$$\ny=\\frac{k}{\\sqrt{8x+3}}+2\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx=\\frac{k}{\\sqrt{8y+3}}+2.\n$$\n\nThen, we make $y$ the subject of the equation as follows:\n\n$$\n\\begin{aligned}x & =\\frac{k}{\\sqrt{8y+3}}+2 \\\\ x-2 & =\\frac{k}{\\sqrt{8y+3}} \\\\ \\sqrt{8y+3} & =\\frac{k}{x-2} \\\\ {(\\sqrt{8y+3})}^{2} & ={(\\frac{k}{x-2})}^{2} \\\\ 8y+3 & =\\frac{{k}^{2}}{(x-2)^{2}} \\\\ 8y & =\\frac{{k}^{2}}{(x-2)^{2}}-3 \\\\ y & =\\frac{{k}^{2}}{8(x-2)^{2}}-\\frac{3}{8}\\end{aligned}\n$$\n\nTherefore, the inverse function is \n\n$$\n{f}^{-1}(x)=\\frac{{k}^{2}}{8(x-2)^{2}}-\\frac{3}{8},\\,x>2.\n$$\n\nComparing our answer with the given expression, we conclude that\n\n$$\n\\frac{{k}^{2}}{8}=\\frac{9}{2}\\,⟹\\,k=6.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-3eb0821a-73a6-5211-a52f-bc88da953dbc"] :db/ensure [:question/validate]} {:db/id "answer-field-3eb0821a-73a6-5211-a52f-bc88da953dbc" :answer-field/id #uuid "3eb0821a-73a6-5211-a52f-bc88da953dbc" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-7d73fe84-3859-5c8d-a8ac-924dd2eb2505" :answer-field/choices ["answer-7d73fe84-3859-5c8d-a8ac-924dd2eb2505"] :db/ensure [:answer-field/validate]} {:db/id "answer-7d73fe84-3859-5c8d-a8ac-924dd2eb2505" :answer/id #uuid "7d73fe84-3859-5c8d-a8ac-924dd2eb2505" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "question-635cbae5-da30-5f6f-818b-8857829587ba" :question/id #uuid "635cbae5-da30-5f6f-818b-8857829587ba" :question/math-academy-id "q-277840" :question/problem "The function $f(x)=\\frac{1}{k}\\sqrt{x-5}+6$ has an inverse function given by ${f}^{-1}(x)=16(x-6)^{2}+5.$ What is the value of $k?$\n\n$k=$\n{{field-1}}" :question/worked-solution "To find ${f}^{-1}(x),$ we start by replacing $f(x)$ with $y:$\n\n$$\ny=\\frac{1}{k}\\sqrt{x-5}+6\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx=\\frac{1}{k}\\sqrt{y-5}+6.\n$$\n\nThen, we make $y$ the subject of the equation as follows:\n\n$$\n\\begin{aligned}x & =\\frac{1}{k}\\sqrt{y-5}+6 \\\\ \\frac{1}{k}\\sqrt{y-5} & =x-6 \\\\ \\sqrt{y-5} & =k(x-6) \\\\ {(\\sqrt{y-5})}^{2} & ={(k(x-6))}^{2} \\\\ y-5 & ={k}^{2}(x-6)^{2} \\\\ y & ={k}^{2}(x-6)^{2}+5\\end{aligned}\n$$\n\nTherefore, the inverse function is \n\n$$\n{f}^{-1}(x)={k}^{2}(x-6)^{2}+5.\n$$\n\nComparing our answer with the given expression, we conclude that\n\n$$\n{k}^{2}=16\\,⟹\\,k=4.\n$$\n\n**Note**: The domain and range of $f(x)$ are\n\n$$\nx\\ge 5,\\,f(x)\\ge 6.\n$$\n\nTherefore, the domain and range of ${f}^{-1}(x)$ are\n\n$$\nx\\ge 6,\\,{f}^{-1}(x)\\ge 5.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b8eacf56-5c06-55dd-aaa8-08c57c8e44fc"] :db/ensure [:question/validate]} {:db/id "answer-field-b8eacf56-5c06-55dd-aaa8-08c57c8e44fc" :answer-field/id #uuid "b8eacf56-5c06-55dd-aaa8-08c57c8e44fc" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-5a6bb1ec-ffed-5214-bafa-cf929f364451" :answer-field/choices ["answer-5a6bb1ec-ffed-5214-bafa-cf929f364451"] :db/ensure [:answer-field/validate]} {:db/id "answer-5a6bb1ec-ffed-5214-bafa-cf929f364451" :answer/id #uuid "5a6bb1ec-ffed-5214-bafa-cf929f364451" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "question-082ab1b4-7b0d-5301-97bc-d24a513a580b" :question/id #uuid "082ab1b4-7b0d-5301-97bc-d24a513a580b" :question/math-academy-id "q-148570" :question/problem "The function $f(x)=\\sqrt[3]{3x+1}+k$ has an inverse function given by ${f}^{-1}(x)=\\frac{1}{3}(x+4)^{3}-\\frac{1}{3}.$ What is the value of $k?$" :question/worked-solution "To find ${f}^{-1}(x),$ we start by replacing $f(x)$ with $y:$\n\n$$\ny=\\sqrt[3]{3x+1}+k\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx=\\sqrt[3]{3y+1}+k.\n$$\n\nThen, we make $y$ the subject of the equation as follows:\n\n$$\n\\begin{aligned}x & =\\sqrt[3]{3y+1}+k \\\\ \\sqrt[3]{3y+1} & =x-k \\\\ {(\\sqrt[3]{3y+1})}^{3} & ={(x-k)}^{3} \\\\ 3y+1 & =(x-k)^{3} \\\\ 3y & =(x-k)^{3}-1 \\\\ y & =\\frac{1}{3}(x-k)^{3}-\\frac{1}{3}\\end{aligned}\n$$\n\nTherefore, the inverse function is \n\n$$\n{f}^{-1}(x)=\\frac{1}{3}(x-k)^{3}-\\frac{1}{3}.\n$$\n\nComparing our answer with the given expression, we conclude that\n\n$$\n-k=4\\,⟹\\,k=-4.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-5eae2b97-0cb3-5c07-814b-807db626bb1a"] :db/ensure [:question/validate]} {:db/id "answer-field-5eae2b97-0cb3-5c07-814b-807db626bb1a" :answer-field/id #uuid "5eae2b97-0cb3-5c07-814b-807db626bb1a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-541dc755-cfc8-5462-825a-5222d3d5a3b7" :answer-field/choices ["answer-8cbf05be-0c0d-584b-8454-95280fcbd97e" "answer-541dc755-cfc8-5462-825a-5222d3d5a3b7" "answer-e4dd1f5a-912b-519e-afe1-3f55d58ca52b" "answer-27d37fb8-b5ab-549c-9f52-56163d362c4a" "answer-7d022d19-1586-599b-ba25-4ba70baadb54"] :db/ensure [:answer-field/validate]} {:db/id "answer-8cbf05be-0c0d-584b-8454-95280fcbd97e" :answer/id #uuid "8cbf05be-0c0d-584b-8454-95280fcbd97e" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-541dc755-cfc8-5462-825a-5222d3d5a3b7" :answer/id #uuid "541dc755-cfc8-5462-825a-5222d3d5a3b7" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "answer-e4dd1f5a-912b-519e-afe1-3f55d58ca52b" :answer/id #uuid "e4dd1f5a-912b-519e-afe1-3f55d58ca52b" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-27d37fb8-b5ab-549c-9f52-56163d362c4a" :answer/id #uuid "27d37fb8-b5ab-549c-9f52-56163d362c4a" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-7d022d19-1586-599b-ba25-4ba70baadb54" :answer/id #uuid "7d022d19-1586-599b-ba25-4ba70baadb54" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id 17592186193825 :tutorial/content "In this lesson, we'll use our knowledge of solving radical equations to compute inverses of radical functions. \n\nFor example, let's consider the following radical function:\n\n$$\nf(x) = 3\\sqrt{x} + 2\n$$\n\nTo compute the inverse of $f(x),$ we follow the usual four steps:\n\n**Step 1:** First, we replace $f(x)$ with $y\\mathbin{:}$\n\n$$\ny = 3\\sqrt{x} + 2\n$$\n\n**Step 2:** Then, we swap $x$ and $y\\mathbin{:}$\n\n$$\nx = 3\\sqrt{y} + 2\n$$\n\n**Step 3:** Next, we solve for $y\\mathbin{:}$\n\n$$\n\\begin{aligned}x & =3\\sqrt{y}+2 \\\\ 3\\sqrt{y} & =x-2 \\\\ \\sqrt{y} & =\\frac{1}{3}(x-2) \\\\ (\\sqrt{y})^{2} & ={(\\frac{1}{3}(x-2))}^{2} \\\\ y & =\\frac{1}{9}(x-2)^{2}\\end{aligned}\n$$\n\n**Step 4:** Finally, we replace $y$ with $f^{-1}(x)\\mathbin{:}$\n\n$$\nf^{-1}(x) = \\dfrac{1}{9}(x - 2)^2\n$$\n\n**Note**: The domain and range of $f(x)$ are\n\n$$\nx \\geq 0, \\qquad f(x) \\geq 2.\n$$\n\nTherefore, the domain and range of $f^{-1}(x)$ are\n\n$$\nx \\geq 2, \\qquad f^{-1}(x) \\geq 0.\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186192863 :activity/expected-seconds 840.0 :db/ensure [:activity/validate]}] "assertions" [[17592186192402 :question/problem "Find the inverse of the function $f(x) = 1 - \\dfrac{1}{3}\\sqrt{x}.$"] [17592186192402 :question/worked-solution "To find $f^{-1}(x),$ we start by replacing $f(x)$ with $y{:}$\n\n$$\ny = 1 - \\dfrac{1}{3}\\sqrt{x}\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx = 1 - \\dfrac{1}{3}\\sqrt{y}.\n$$\n\nThen, we make $y$ the subject of the equation as follows:\n\n$$\n\\begin{aligned}x & =1-\\frac{1}{3}\\sqrt{y} \\\\ \\frac{1}{3}\\sqrt{y} & =1-x \\\\ \\sqrt{y} & =3(1-x) \\\\ (\\sqrt{y})^{2} & ={(3(1-x))}^{2} \\\\ y & =9(1-x)^{2} \\\\ y & =9(x-1)^{2}\\end{aligned}\n$$\n\nTherefore, the inverse function is \n\n$$\nf^{-1}(x) = 9(x - 1)^2.\n$$\n\n**Note**: The domain and range of $f(x)$ are\n\n$$\nx \\geq 0, \\qquad f(x) \\leq 1.\n$$\n\nTherefore, the domain and range of $f^{-1}(x)$ are\n\n$$\nx \\leq 1, \\qquad f^{-1}(x) \\geq 0.\n$$"] [17592186192415 :question/problem "Find the inverse of the function ![](images/b9/b9a5eece426fa2aa66aac43b9afaf2812dcf483795a84d5e96fa89c0dcd71db6.svg)"] [17592186192415 :question/worked-solution "To find ![](images/6e/6e9ea2da83f324dd20158e4b08fb1c6968b6387d458964f21ed03648be954752.svg) we start by replacing ![](images/93/93f888a1ee0b7da5e29f442f803f1c0eaf73ad02f5eaa97e85bb8a35d607015b.svg) with ![](images/02/028bcadf67e469d96df97e89362f88bb8edca3ddea5579906987cc124663fba8.svg)\n![](images/d4/d4f5098eaa3eb85b97ec9547373f138922d22d734018ede816930c665248c0d5.svg)\n\nNow, interchanging ![](images/fc/fcc5df999e3b49fae1685ee0ab5bd03709804e1dd49f2ee722c4269eb0f5506d.svg) and ![](images/1d/1d9b846cface9f9348e4081a0dd87dd254bf26663c12aa0d1a15aa24d2393261.svg) gives\n![](images/35/35c51b7dff42eeb3c3b2033c78495c07294048ba02628e583382c0807e43d192.svg)\n\nThen, we make ![](images/1d/1d9b846cface9f9348e4081a0dd87dd254bf26663c12aa0d1a15aa24d2393261.svg) the subject of the equation, as follows:\n![](images/18/183e560a55c159a77b1ceacec766572e2279ad4e552242d638a9fdcf96f2c859.svg)\n\nTherefore, the inverse function is \n![](images/b5/b55f51d46d8917e5a44e4dae697c71a004580924cecd5a5f079e5eac7f480b3a.svg)\n\n**Note**: The domain and range of ![](images/93/93f888a1ee0b7da5e29f442f803f1c0eaf73ad02f5eaa97e85bb8a35d607015b.svg) are\n![](images/f2/f2f23ba499fcbb1dee1964f08453be99bdf5ed7ec11581b773845c4aa307b64a.svg)\n\nTherefore, the domain and range of ![](images/90/90bf8beda1404c3f6e9d9d9565922945fb59df9b0488050e3d2b72a153addd3c.svg) are\n![](images/96/96d9c5432e8f14ac6d9bc1841e37772cad060e3d09065129f73161726aeeffd2.svg)"] [17592186192403 :question/problem "Find the inverse of the function $f(x) = \\dfrac{1}{5}\\sqrt{4x + 1}.$"] [17592186192403 :question/worked-solution "To find $f^{-1}(x),$ we start by replacing $f(x)$ with $y{:}$\n\n$$\ny = \\dfrac{1}{5}\\sqrt{4x + 1}\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx = \\dfrac{1}{5}\\sqrt{4y + 1}.\n$$\n\nThen, we make $y$ the subject of the equation as follows:\n\n$$\n\\begin{aligned}x & =\\frac{1}{5}\\sqrt{4y+1} \\\\ \\sqrt{4y+1} & =5x \\\\ {(\\sqrt{4y+1})}^{2} & ={(5x)}^{2} \\\\ 4y+1 & =25{x}^{2} \\\\ 4y & =25{x}^{2}-1 \\\\ y & =\\frac{1}{4}(25{x}^{2}-1)\\end{aligned}\n$$\n\nTherefore, the inverse function is \n\n$$\nf^{-1}(x) = \\dfrac{1}{4}\\left(25x^2 - 1\\right).\n$$\n\n**Note**: The domain and range of $f(x)$ are given by\n\n$$\nx \\geq -\\dfrac14, \\qquad f(x) \\geq 0.\n$$\n\nTherefore, the domain and range of $f^{-1}(x)$ are\n\n$$\nx \\geq 0, \\qquad f^{-1}(x) \\geq -\\dfrac14.\n$$"] [17592186192404 :question/problem "The function $f(x) = 3\\sqrt{x + k} - 2$ has an inverse function given by $f^{-1}(x) = \\dfrac{1}{9}(x + 2)^2 + 3.$ What is the value of $k?$"] [17592186192404 :question/worked-solution "To find $f^{-1}(x),$ we start by replacing $f(x)$ with $y{:}$\n\n$$\ny = 3\\sqrt{x+k} - 2\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx = 3\\sqrt{y + k} - 2.\n$$\n\nThen, we make $y$ the subject of the equation as follows:\n\n$$\n\\begin{aligned}x & =3\\sqrt{y+k}-2 \\\\ 3\\sqrt{y+k} & =x+2 \\\\ \\sqrt{y+k} & =\\frac{1}{3}(x+2) \\\\ {(\\sqrt{y+k})}^{2} & ={(\\frac{1}{3}(x+2))}^{2} \\\\ y+k & =\\frac{1}{9}(x+2)^{2} \\\\ y & =\\frac{1}{9}(x+2)^{2}-k\\end{aligned}\n$$\n\nTherefore, the inverse function is \n\n$$\nf^{-1}(x) = \\dfrac{1}{9}(x + 2)^2 - k.\n$$\n\nComparing our answer with the given expression, we conclude that\n\n$$\n-k = 3 \\qquad \\Longrightarrow \\qquad k = -3.\n$$\n\n**Note**: The domain and range of $f(x)$ are given by\n\n$$\nx \\geq 3, \\qquad f(x) \\geq -2.\n$$\n\nTherefore, the domain and range of $f^{-1}(x)$ are\n\n$$\nx \\geq -2, \\qquad f^{-1}(x) \\geq3.\n$$"] ["question-f2fd8190-fb82-5675-b05f-057d697af7cd" :question/id #uuid "f2fd8190-fb82-5675-b05f-057d697af7cd"] ["question-f2fd8190-fb82-5675-b05f-057d697af7cd" :question/math-academy-id "q-270776"] ["question-f2fd8190-fb82-5675-b05f-057d697af7cd" :question/problem "Find the inverse of the function $f(x)=\\frac{2}{3}\\sqrt{x}-10.$\n\n${f}^{-1}(x)=$\n{{field-1}}"] ["question-f2fd8190-fb82-5675-b05f-057d697af7cd" :question/worked-solution "To find ${f}^{-1}(x),$ we start by replacing $f(x)$ with $y:$\n\n$$\ny=\\frac{2}{3}\\sqrt{x}-10\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx=\\frac{2}{3}\\sqrt{y}-10.\n$$\n\nThen, we make $y$ the subject of the equation as follows:\n\n$$\n\\begin{aligned}x & =\\frac{2}{3}\\sqrt{y}-10 \\\\ \\frac{2}{3}\\sqrt{y} & =x+10 \\\\ \\sqrt{y} & =\\frac{3}{2}(x+10) \\\\ (\\sqrt{y})^{2} & ={(\\frac{3}{2}(x+10))}^{2} \\\\ y & =\\frac{9}{4}(x+10)^{2}\\end{aligned}\n$$\n\nTherefore, the inverse function is \n\n$$\n{f}^{-1}(x)=\\frac{9}{4}(x+10)^{2}.\n$$\n\n**Note**: The domain and range of $f(x)$ are\n\n$$\nx\\ge 0,\\,f(x)\\ge -10.\n$$\n\nTherefore, the domain and range of ${f}^{-1}(x)$ are\n\n$$\nx\\ge -10,\\,{f}^{-1}(x)\\ge 0.\n$$"] ["question-f2fd8190-fb82-5675-b05f-057d697af7cd" :question/difficulty :question.difficulty/easy] ["answer-field-87121302-8c37-5665-97c7-f22db0a986f9" :answer-field/id #uuid "87121302-8c37-5665-97c7-f22db0a986f9"] ["answer-8ca68a00-32fb-52b6-9611-af784188ac51" :answer/id #uuid "8ca68a00-32fb-52b6-9611-af784188ac51"] ["answer-8ca68a00-32fb-52b6-9611-af784188ac51" :answer/type :answer.type/math] ["answer-8ca68a00-32fb-52b6-9611-af784188ac51" :answer/value "\\frac{9}{4}(x+10)^2"] ["answer-field-87121302-8c37-5665-97c7-f22db0a986f9" :answer-field/key "field-1"] ["answer-field-87121302-8c37-5665-97c7-f22db0a986f9" :answer-field/type :answer-field.type/blank] ["answer-field-87121302-8c37-5665-97c7-f22db0a986f9" :answer-field/correct "answer-8ca68a00-32fb-52b6-9611-af784188ac51"] ["answer-field-87121302-8c37-5665-97c7-f22db0a986f9" :answer-field/choices "answer-8ca68a00-32fb-52b6-9611-af784188ac51"] ["question-f2fd8190-fb82-5675-b05f-057d697af7cd" :question/answer-fields "answer-field-87121302-8c37-5665-97c7-f22db0a986f9"] [17592186192697 :knowledge-point/questions "question-f2fd8190-fb82-5675-b05f-057d697af7cd"] ["question-1883917d-29b4-5836-94bf-f6ba9fe053f5" :question/id #uuid "1883917d-29b4-5836-94bf-f6ba9fe053f5"] ["question-1883917d-29b4-5836-94bf-f6ba9fe053f5" :question/math-academy-id "q-277054"] ["question-1883917d-29b4-5836-94bf-f6ba9fe053f5" :question/problem "Find the inverse of the function $f(x)=5\\sqrt[3]{x}+3.$\n\n${f}^{-1}(x)=$\n{{field-1}}"] ["question-1883917d-29b4-5836-94bf-f6ba9fe053f5" :question/worked-solution "To find ${f}^{-1}(x),$ we start by replacing $f(x)$ with $y:$\n\n$$\ny=5\\sqrt[3]{x}+3\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx=5\\sqrt[3]{y}+3.\n$$\n\nThen, we make $y$ the subject of the equation as follows:\n\n$$\n\\begin{aligned}x & =5\\sqrt[3]{y}+3 \\\\ 5\\sqrt[3]{y} & =x-3 \\\\ \\sqrt[3]{y} & =\\frac{1}{5}(x-3) \\\\ (\\sqrt[3]{y})^{3} & ={(\\frac{1}{5}(x-3))}^{3} \\\\ y & =\\frac{1}{125}(x-3)^{3}\\end{aligned}\n$$\n\nTherefore, the inverse function is \n\n$$\n{f}^{-1}(x)=\\frac{1}{125}(x-3)^{3}.\n$$"] ["question-1883917d-29b4-5836-94bf-f6ba9fe053f5" :question/difficulty :question.difficulty/moderate] ["answer-field-77ca7a05-762c-5491-b3c2-14aaeb97dc53" :answer-field/id #uuid "77ca7a05-762c-5491-b3c2-14aaeb97dc53"] ["answer-760022a2-75fb-5225-a136-0dd915af89e1" :answer/id #uuid "760022a2-75fb-5225-a136-0dd915af89e1"] ["answer-760022a2-75fb-5225-a136-0dd915af89e1" :answer/type :answer.type/math] ["answer-760022a2-75fb-5225-a136-0dd915af89e1" :answer/value "\\frac{1}{125}(x-3)^{3}"] ["answer-field-77ca7a05-762c-5491-b3c2-14aaeb97dc53" :answer-field/key "field-1"] ["answer-field-77ca7a05-762c-5491-b3c2-14aaeb97dc53" :answer-field/type :answer-field.type/blank] ["answer-field-77ca7a05-762c-5491-b3c2-14aaeb97dc53" :answer-field/correct "answer-760022a2-75fb-5225-a136-0dd915af89e1"] ["answer-field-77ca7a05-762c-5491-b3c2-14aaeb97dc53" :answer-field/choices "answer-760022a2-75fb-5225-a136-0dd915af89e1"] ["question-1883917d-29b4-5836-94bf-f6ba9fe053f5" :question/answer-fields "answer-field-77ca7a05-762c-5491-b3c2-14aaeb97dc53"] [17592186192697 :knowledge-point/questions "question-1883917d-29b4-5836-94bf-f6ba9fe053f5"] ["question-f867e6a6-dbb2-59f4-99c3-23f6d9793b91" :question/id #uuid "f867e6a6-dbb2-59f4-99c3-23f6d9793b91"] ["question-f867e6a6-dbb2-59f4-99c3-23f6d9793b91" :question/math-academy-id "q-148737"] ["question-f867e6a6-dbb2-59f4-99c3-23f6d9793b91" :question/problem "Find the inverse of the function $f(x)=4\\sqrt[3]{x}-7.$"] ["question-f867e6a6-dbb2-59f4-99c3-23f6d9793b91" :question/worked-solution "To find ${f}^{-1}(x),$ we start by replacing $f(x)$ with $y:$\n\n$$\ny=4\\sqrt[3]{x}-7\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx=4\\sqrt[3]{y}-7.\n$$\n\nThen, we make $y$ the subject of the equation as follows:\n\n$$\n\\begin{aligned}x & =4\\sqrt[3]{y}-7 \\\\ 4\\sqrt[3]{y} & =x+7 \\\\ \\sqrt[3]{y} & =\\frac{1}{4}(x+7) \\\\ (\\sqrt[3]{y})^{3} & ={(\\frac{1}{4}(x+7))}^{3} \\\\ y & =\\frac{1}{64}(x+7)^{3}\\end{aligned}\n$$\n\nTherefore, the inverse function is \n\n$$\n{f}^{-1}(x)=\\frac{1}{64}(x+7)^{3}.\n$$"] ["question-f867e6a6-dbb2-59f4-99c3-23f6d9793b91" :question/difficulty :question.difficulty/moderate] ["answer-field-1e400004-8c3b-55eb-9c62-48d0e98c825c" :answer-field/id #uuid "1e400004-8c3b-55eb-9c62-48d0e98c825c"] ["answer-41a67b62-1927-57c7-b8fd-09c8ea128d9c" :answer/id #uuid "41a67b62-1927-57c7-b8fd-09c8ea128d9c"] ["answer-41a67b62-1927-57c7-b8fd-09c8ea128d9c" :answer/type :answer.type/math] ["answer-41a67b62-1927-57c7-b8fd-09c8ea128d9c" :answer/value "{f}^{-1}(x)=4(x+7)^{3}"] ["answer-2a68acc7-11c9-53ec-9edf-5225b6802e14" :answer/id #uuid "2a68acc7-11c9-53ec-9edf-5225b6802e14"] ["answer-2a68acc7-11c9-53ec-9edf-5225b6802e14" :answer/type :answer.type/math] ["answer-2a68acc7-11c9-53ec-9edf-5225b6802e14" :answer/value "{f}^{-1}(x)=64{x}^{3}+7"] ["answer-0f5a02a6-edc8-579d-9f3e-8685852c250f" :answer/id #uuid "0f5a02a6-edc8-579d-9f3e-8685852c250f"] ["answer-0f5a02a6-edc8-579d-9f3e-8685852c250f" :answer/type :answer.type/math] ["answer-0f5a02a6-edc8-579d-9f3e-8685852c250f" :answer/value "{f}^{-1}(x)=\\frac{1}{64}(x+7)^{3}"] ["answer-b3dda357-db83-5268-bb16-701863b5d617" :answer/id #uuid "b3dda357-db83-5268-bb16-701863b5d617"] ["answer-b3dda357-db83-5268-bb16-701863b5d617" :answer/type :answer.type/math] ["answer-b3dda357-db83-5268-bb16-701863b5d617" :answer/value "{f}^{-1}(x)=\\frac{1}{7}(x+4)^{3}"] ["answer-f16acb2b-4b5f-577f-b3ff-41c909981ff7" :answer/id #uuid "f16acb2b-4b5f-577f-b3ff-41c909981ff7"] ["answer-f16acb2b-4b5f-577f-b3ff-41c909981ff7" :answer/type :answer.type/math] ["answer-f16acb2b-4b5f-577f-b3ff-41c909981ff7" :answer/value "{f}^{-1}(x)=\\frac{1}{7}{x}^{3}+4"] ["answer-field-1e400004-8c3b-55eb-9c62-48d0e98c825c" :answer-field/key "selection"] ["answer-field-1e400004-8c3b-55eb-9c62-48d0e98c825c" :answer-field/type :answer-field.type/radio] ["answer-field-1e400004-8c3b-55eb-9c62-48d0e98c825c" :answer-field/correct "answer-0f5a02a6-edc8-579d-9f3e-8685852c250f"] ["answer-field-1e400004-8c3b-55eb-9c62-48d0e98c825c" :answer-field/choices "answer-41a67b62-1927-57c7-b8fd-09c8ea128d9c"] ["answer-field-1e400004-8c3b-55eb-9c62-48d0e98c825c" :answer-field/choices "answer-2a68acc7-11c9-53ec-9edf-5225b6802e14"] ["answer-field-1e400004-8c3b-55eb-9c62-48d0e98c825c" :answer-field/choices "answer-0f5a02a6-edc8-579d-9f3e-8685852c250f"] ["answer-field-1e400004-8c3b-55eb-9c62-48d0e98c825c" :answer-field/choices "answer-b3dda357-db83-5268-bb16-701863b5d617"] ["answer-field-1e400004-8c3b-55eb-9c62-48d0e98c825c" :answer-field/choices "answer-f16acb2b-4b5f-577f-b3ff-41c909981ff7"] ["question-f867e6a6-dbb2-59f4-99c3-23f6d9793b91" :question/answer-fields "answer-field-1e400004-8c3b-55eb-9c62-48d0e98c825c"] [17592186192697 :knowledge-point/questions "question-f867e6a6-dbb2-59f4-99c3-23f6d9793b91"] ["question-11b34dc5-01d5-59cc-afad-bce1d288e367" :question/id #uuid "11b34dc5-01d5-59cc-afad-bce1d288e367"] ["question-11b34dc5-01d5-59cc-afad-bce1d288e367" :question/math-academy-id "q-148431"] ["question-11b34dc5-01d5-59cc-afad-bce1d288e367" :question/problem "Find the inverse of the function $f(x)=\\sqrt[3]{x}-4.$"] ["question-11b34dc5-01d5-59cc-afad-bce1d288e367" :question/worked-solution "To find ${f}^{-1}(x),$ we start by replacing $f(x)$ with $y:$\n\n$$\ny=\\sqrt[3]{x}-4\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx=\\sqrt[3]{y}-4.\n$$\n\nThen, we make $y$ the subject of the equation as follows:\n\n$$\n\\begin{aligned}x & =\\sqrt[3]{y}-4 \\\\ \\sqrt[3]{y} & =x+4 \\\\ (\\sqrt[3]{y})^{3} & =(x+4)^{3} \\\\ y & =(x+4)^{3}\\end{aligned}\n$$\n\nTherefore, the inverse function is \n\n$$\n{f}^{-1}(x)=(x+4)^{3}.\n$$"] ["question-11b34dc5-01d5-59cc-afad-bce1d288e367" :question/difficulty :question.difficulty/moderate] ["answer-field-b24942f2-dc2d-5709-9d5c-fc4d35113cac" :answer-field/id #uuid "b24942f2-dc2d-5709-9d5c-fc4d35113cac"] ["answer-1547820e-1c6e-5874-a693-dbe63b833497" :answer/id #uuid "1547820e-1c6e-5874-a693-dbe63b833497"] ["answer-1547820e-1c6e-5874-a693-dbe63b833497" :answer/type :answer.type/math] ["answer-1547820e-1c6e-5874-a693-dbe63b833497" :answer/value "{f}^{-1}(x)=(x+2)^{3}"] ["answer-8bca345f-39c9-5521-bcba-a7055750252e" :answer/id #uuid "8bca345f-39c9-5521-bcba-a7055750252e"] ["answer-8bca345f-39c9-5521-bcba-a7055750252e" :answer/type :answer.type/math] ["answer-8bca345f-39c9-5521-bcba-a7055750252e" :answer/value "{f}^{-1}(x)=(x+4)^{3}"] ["answer-3cab048d-9187-5ff9-8179-12253f7ec205" :answer/id #uuid "3cab048d-9187-5ff9-8179-12253f7ec205"] ["answer-3cab048d-9187-5ff9-8179-12253f7ec205" :answer/type :answer.type/math] ["answer-3cab048d-9187-5ff9-8179-12253f7ec205" :answer/value "{f}^{-1}(x)=4{x}^{3}"] ["answer-f1b611fe-9f99-5df6-87f7-dbc5e83677ac" :answer/id #uuid "f1b611fe-9f99-5df6-87f7-dbc5e83677ac"] ["answer-f1b611fe-9f99-5df6-87f7-dbc5e83677ac" :answer/type :answer.type/math] ["answer-f1b611fe-9f99-5df6-87f7-dbc5e83677ac" :answer/value "{f}^{-1}(x)={x}^{3}+4"] ["answer-eb79fd11-c42f-5ea1-80c3-eeb2d1329843" :answer/id #uuid "eb79fd11-c42f-5ea1-80c3-eeb2d1329843"] ["answer-eb79fd11-c42f-5ea1-80c3-eeb2d1329843" :answer/type :answer.type/math] ["answer-eb79fd11-c42f-5ea1-80c3-eeb2d1329843" :answer/value "{f}^{-1}(x)={x}^{3}-4"] ["answer-field-b24942f2-dc2d-5709-9d5c-fc4d35113cac" :answer-field/key "selection"] ["answer-field-b24942f2-dc2d-5709-9d5c-fc4d35113cac" :answer-field/type :answer-field.type/radio] ["answer-field-b24942f2-dc2d-5709-9d5c-fc4d35113cac" :answer-field/correct "answer-8bca345f-39c9-5521-bcba-a7055750252e"] ["answer-field-b24942f2-dc2d-5709-9d5c-fc4d35113cac" :answer-field/choices "answer-1547820e-1c6e-5874-a693-dbe63b833497"] ["answer-field-b24942f2-dc2d-5709-9d5c-fc4d35113cac" :answer-field/choices "answer-8bca345f-39c9-5521-bcba-a7055750252e"] ["answer-field-b24942f2-dc2d-5709-9d5c-fc4d35113cac" :answer-field/choices "answer-3cab048d-9187-5ff9-8179-12253f7ec205"] ["answer-field-b24942f2-dc2d-5709-9d5c-fc4d35113cac" :answer-field/choices "answer-f1b611fe-9f99-5df6-87f7-dbc5e83677ac"] ["answer-field-b24942f2-dc2d-5709-9d5c-fc4d35113cac" :answer-field/choices "answer-eb79fd11-c42f-5ea1-80c3-eeb2d1329843"] ["question-11b34dc5-01d5-59cc-afad-bce1d288e367" :question/answer-fields "answer-field-b24942f2-dc2d-5709-9d5c-fc4d35113cac"] [17592186192697 :knowledge-point/questions "question-11b34dc5-01d5-59cc-afad-bce1d288e367"] ["question-aa587d06-3d76-54dc-bc14-c7a25e414d3a" :question/id #uuid "aa587d06-3d76-54dc-bc14-c7a25e414d3a"] ["question-aa587d06-3d76-54dc-bc14-c7a25e414d3a" :question/math-academy-id "q-277045"] ["question-aa587d06-3d76-54dc-bc14-c7a25e414d3a" :question/problem "Find the inverse of the function $f(x)=6-4\\sqrt{x}.$\n\n${f}^{-1}(x)=$\n{{field-1}}"] ["question-aa587d06-3d76-54dc-bc14-c7a25e414d3a" :question/worked-solution "To find ${f}^{-1}(x),$ we start by replacing $f(x)$ with $y:$\n\n$$\ny=6-4\\sqrt{x}\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx=6-4\\sqrt{y}.\n$$\n\nThen, we make $y$ the subject of the equation as follows:\n\n$$\n\\begin{aligned}x & =6-4\\sqrt{y} \\\\ 4\\sqrt{y} & =6-x \\\\ \\sqrt{y} & =\\frac{1}{4}(6-x) \\\\ (\\sqrt{y})^{2} & ={(\\frac{1}{4}(6-x))}^{2} \\\\ y & =\\frac{1}{16}(6-x)^{2}\\end{aligned}\n$$\n\nTherefore, the inverse function is \n\n$$\n{f}^{-1}(x)=\\frac{1}{16}(6-x)^{2}.\n$$\n\n**Note**: The domain and range of $f(x)$ are\n\n$$\nx\\ge 0,\\,f(x)\\le 6.\n$$\n\nTherefore, the domain and range of ${f}^{-1}(x)$ are\n\n$$\nx\\le 6,\\,{f}^{-1}(x)\\ge 0.\n$$"] ["question-aa587d06-3d76-54dc-bc14-c7a25e414d3a" :question/difficulty :question.difficulty/easy] ["answer-field-c7ff35a3-b189-5c5b-b194-1dd1bc180b94" :answer-field/id #uuid "c7ff35a3-b189-5c5b-b194-1dd1bc180b94"] ["answer-70556f37-c5ed-583c-a04b-123cc8508968" :answer/id #uuid "70556f37-c5ed-583c-a04b-123cc8508968"] ["answer-70556f37-c5ed-583c-a04b-123cc8508968" :answer/type :answer.type/math] ["answer-70556f37-c5ed-583c-a04b-123cc8508968" :answer/value "\\frac{(x-6)^2}{16}"] ["answer-field-c7ff35a3-b189-5c5b-b194-1dd1bc180b94" :answer-field/key "field-1"] ["answer-field-c7ff35a3-b189-5c5b-b194-1dd1bc180b94" :answer-field/type :answer-field.type/blank] ["answer-field-c7ff35a3-b189-5c5b-b194-1dd1bc180b94" :answer-field/correct "answer-70556f37-c5ed-583c-a04b-123cc8508968"] ["answer-field-c7ff35a3-b189-5c5b-b194-1dd1bc180b94" :answer-field/choices "answer-70556f37-c5ed-583c-a04b-123cc8508968"] ["question-aa587d06-3d76-54dc-bc14-c7a25e414d3a" :question/answer-fields "answer-field-c7ff35a3-b189-5c5b-b194-1dd1bc180b94"] [17592186192697 :knowledge-point/questions "question-aa587d06-3d76-54dc-bc14-c7a25e414d3a"] [17592186193001 :question/problem "Find the inverse of the function $f(x)=\\frac{3}{\\sqrt{x}}-1.$"] [17592186193001 :question/worked-solution "To find ${f}^{-1}(x),$ we start by replacing $f(x)$ with $y:$\n\n$$\ny=\\frac{3}{\\sqrt{x}}-1\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx=\\frac{3}{\\sqrt{y}}-1.\n$$\n\nThen, we make $y$ the subject of the equation, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{3}{\\sqrt{y}}-1 \\\\ x+1 & =\\frac{3}{\\sqrt{y}} \\\\ \\frac{1}{x+1} & =\\frac{\\sqrt{y}}{3} \\\\ \\sqrt{y} & =\\frac{3}{x+1} \\\\ (\\sqrt{y})^{2} & ={(\\frac{3}{x+1})}^{2} \\\\ y & =\\frac{9}{(x+1)^{2}}\\end{aligned}\n$$\n\nTherefore, the inverse function is \n\n$$\n{f}^{-1}(x)=\\frac{9}{(x+1)^{2}}.\n$$\n\n**Note**: The domain and range of $f(x)$ are given by\n\n$$\nx>0,\\,f(x)>-1.\n$$\n\nTherefore, the domain and range of ${f}^{-1}(x)$ are\n\n$$\nx>-1,\\,{f}^{-1}(x)>0.\n$$"] [17592186193001 :question/difficulty :question.difficulty/moderate] ["answer-f64ff466-0bca-57e1-8856-2a4a8172d8c4" :answer/id #uuid "f64ff466-0bca-57e1-8856-2a4a8172d8c4"] ["answer-f64ff466-0bca-57e1-8856-2a4a8172d8c4" :answer/type :answer.type/math] ["answer-f64ff466-0bca-57e1-8856-2a4a8172d8c4" :answer/value "{f}^{-1}(x)=9(x+1)^{2}"] ["answer-b704f50d-5c35-5b3e-a0c8-af0ac5fd5317" :answer/id #uuid "b704f50d-5c35-5b3e-a0c8-af0ac5fd5317"] ["answer-b704f50d-5c35-5b3e-a0c8-af0ac5fd5317" :answer/type :answer.type/math] ["answer-b704f50d-5c35-5b3e-a0c8-af0ac5fd5317" :answer/value "{f}^{-1}(x)=9{x}^{2}+1"] ["answer-94ffbd69-746d-5e22-8c95-44e785cd24cf" :answer/id #uuid "94ffbd69-746d-5e22-8c95-44e785cd24cf"] ["answer-94ffbd69-746d-5e22-8c95-44e785cd24cf" :answer/type :answer.type/math] ["answer-94ffbd69-746d-5e22-8c95-44e785cd24cf" :answer/value "{f}^{-1}(x)=\\frac{1}{9}(x+1)^{2}"] ["answer-a685ea85-b22a-51d2-9d33-2ac79331c9a6" :answer/id #uuid "a685ea85-b22a-51d2-9d33-2ac79331c9a6"] ["answer-a685ea85-b22a-51d2-9d33-2ac79331c9a6" :answer/type :answer.type/math] ["answer-a685ea85-b22a-51d2-9d33-2ac79331c9a6" :answer/value "{f}^{-1}(x)=\\frac{9}{(x+1)^{2}}"] ["answer-00fd4c22-89d2-5fde-b119-9ce2163bb9d1" :answer/id #uuid "00fd4c22-89d2-5fde-b119-9ce2163bb9d1"] ["answer-00fd4c22-89d2-5fde-b119-9ce2163bb9d1" :answer/type :answer.type/math] ["answer-00fd4c22-89d2-5fde-b119-9ce2163bb9d1" :answer/value "{f}^{-1}(x)=\\frac{9}{{x}^{2}+1}"] [17592186189892 :answer-field/correct "answer-a685ea85-b22a-51d2-9d33-2ac79331c9a6"] [17592186189892 :answer-field/choices "answer-f64ff466-0bca-57e1-8856-2a4a8172d8c4"] [17592186189892 :answer-field/choices "answer-b704f50d-5c35-5b3e-a0c8-af0ac5fd5317"] [17592186189892 :answer-field/choices "answer-94ffbd69-746d-5e22-8c95-44e785cd24cf"] [17592186189892 :answer-field/choices "answer-a685ea85-b22a-51d2-9d33-2ac79331c9a6"] [17592186189892 :answer-field/choices "answer-00fd4c22-89d2-5fde-b119-9ce2163bb9d1"] ["question-f93430f2-f761-5264-8e7c-28207f8a2873" :question/id #uuid "f93430f2-f761-5264-8e7c-28207f8a2873"] ["question-f93430f2-f761-5264-8e7c-28207f8a2873" :question/math-academy-id "q-277064"] ["question-f93430f2-f761-5264-8e7c-28207f8a2873" :question/problem "Find the inverse of the function $f(x)=\\frac{2}{5\\sqrt{x}}+1.$\n\n${f}^{-1}(x)=$\n{{field-1}}"] ["question-f93430f2-f761-5264-8e7c-28207f8a2873" :question/worked-solution "To find ${f}^{-1}(x),$ we start by replacing $f(x)$ with $y:$\n\n$$\ny=\\frac{2}{5\\sqrt{x}}+1\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx=\\frac{2}{5\\sqrt{y}}+1.\n$$\n\nThen, we make $y$ the subject of the equation as follows:\n\n$$\n\\begin{aligned}x & =\\frac{2}{5\\sqrt{y}}+1 \\\\ \\frac{2}{5\\sqrt{y}} & =x-1 \\\\ \\sqrt{y} & =\\frac{2}{5(x-1)} \\\\ {(\\sqrt{y})}^{2} & ={(\\frac{2}{5(x-1)})}^{2} \\\\ y & =\\frac{4}{25(x-1)^{2}}\\end{aligned}\n$$\n\nTherefore, the inverse function is \n\n$$\n{f}^{-1}(x)=\\frac{4}{25(x-1)^{2}}.\n$$\n\n**Note**: The domain and range of $f(x)$ are\n\n$$\nx>0,\\,f(x)>1.\n$$\n\nTherefore, the domain and range of ${f}^{-1}(x)$ are\n\n$$\nx>1,\\,{f}^{-1}(x)>0.\n$$"] ["question-f93430f2-f761-5264-8e7c-28207f8a2873" :question/difficulty :question.difficulty/moderate] ["answer-field-f2d41407-a63e-565f-bff1-4c6f38bb78e4" :answer-field/id #uuid "f2d41407-a63e-565f-bff1-4c6f38bb78e4"] ["answer-13479a97-4e44-5471-9c23-134ec902cd16" :answer/id #uuid "13479a97-4e44-5471-9c23-134ec902cd16"] ["answer-13479a97-4e44-5471-9c23-134ec902cd16" :answer/type :answer.type/math] ["answer-13479a97-4e44-5471-9c23-134ec902cd16" :answer/value "\\frac{4}{25(x-1)^2}"] ["answer-field-f2d41407-a63e-565f-bff1-4c6f38bb78e4" :answer-field/key "field-1"] ["answer-field-f2d41407-a63e-565f-bff1-4c6f38bb78e4" :answer-field/type :answer-field.type/blank] ["answer-field-f2d41407-a63e-565f-bff1-4c6f38bb78e4" :answer-field/correct "answer-13479a97-4e44-5471-9c23-134ec902cd16"] ["answer-field-f2d41407-a63e-565f-bff1-4c6f38bb78e4" :answer-field/choices "answer-13479a97-4e44-5471-9c23-134ec902cd16"] ["question-f93430f2-f761-5264-8e7c-28207f8a2873" :question/answer-fields "answer-field-f2d41407-a63e-565f-bff1-4c6f38bb78e4"] [17592186192707 :knowledge-point/questions "question-f93430f2-f761-5264-8e7c-28207f8a2873"] [17592186193013 :question/problem "Find the inverse of the function $f(x)=3-\\frac{4}{\\sqrt[3]{x}}.$"] [17592186193013 :question/worked-solution "To find ${f}^{-1}(x),$ we start by replacing $f(x)$ with $y:$\n\n$$\ny=3-\\frac{4}{\\sqrt[3]{x}}\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx=3-\\frac{4}{\\sqrt[3]{y}}.\n$$\n\nThen, we make $y$ the subject of the equation, as follows:\n\n$$\n\\begin{aligned}x & =3-\\frac{4}{\\sqrt[3]{y}} \\\\ x-3 & =-\\frac{4}{\\sqrt[3]{y}} \\\\ 3-x & =\\frac{4}{\\sqrt[3]{y}} \\\\ \\frac{1}{3-x} & =\\frac{\\sqrt[3]{y}}{4} \\\\ \\sqrt[3]{y} & =\\frac{4}{3-x} \\\\ (\\sqrt[3]{y})^{3} & ={(\\frac{4}{3-x})}^{3} \\\\ y & =\\frac{64}{(3-x)^{3}}\\end{aligned}\n$$\n\nTherefore, the inverse function is \n\n$$\n{f}^{-1}(x)=\\frac{64}{(3-x)^{3}}.\n$$\n\n**Note**: The domain and range of $f(x)$ are\n\n$$\nx\\ne 0,\\,f(x)\\ne 3.\n$$\n\nTherefore, the domain and range of ${f}^{-1}(x)$ are\n\n$$\nx\\ne 3,\\,{f}^{-1}(x)\\ne 0.\n$$"] [17592186193013 :question/difficulty :question.difficulty/hard] ["answer-7b2900c9-1a52-5c45-aed2-605280ab5a10" :answer/id #uuid "7b2900c9-1a52-5c45-aed2-605280ab5a10"] ["answer-7b2900c9-1a52-5c45-aed2-605280ab5a10" :answer/type :answer.type/math] ["answer-7b2900c9-1a52-5c45-aed2-605280ab5a10" :answer/value "{f}^{-1}(x)=27(x-4)^{3}"] ["answer-8aaf3446-c684-5564-a8b6-8388976113a9" :answer/id #uuid "8aaf3446-c684-5564-a8b6-8388976113a9"] ["answer-8aaf3446-c684-5564-a8b6-8388976113a9" :answer/type :answer.type/math] ["answer-8aaf3446-c684-5564-a8b6-8388976113a9" :answer/value "{f}^{-1}(x)=\\frac{16}{(3-x)^{3}}"] ["answer-b0ed2b73-1ef1-577c-b9a7-c447148706e5" :answer/id #uuid "b0ed2b73-1ef1-577c-b9a7-c447148706e5"] ["answer-b0ed2b73-1ef1-577c-b9a7-c447148706e5" :answer/type :answer.type/math] ["answer-b0ed2b73-1ef1-577c-b9a7-c447148706e5" :answer/value "{f}^{-1}(x)=\\frac{1}{64}(3-x)^{3}"] ["answer-f085bb4e-fe8a-59a1-aa2f-9be46d61a226" :answer/id #uuid "f085bb4e-fe8a-59a1-aa2f-9be46d61a226"] ["answer-f085bb4e-fe8a-59a1-aa2f-9be46d61a226" :answer/type :answer.type/math] ["answer-f085bb4e-fe8a-59a1-aa2f-9be46d61a226" :answer/value "{f}^{-1}(x)=\\frac{27}{(4-x)^{3}}"] ["answer-fbf8be41-e92b-561f-ad73-49d08a3c31d5" :answer/id #uuid "fbf8be41-e92b-561f-ad73-49d08a3c31d5"] ["answer-fbf8be41-e92b-561f-ad73-49d08a3c31d5" :answer/type :answer.type/math] ["answer-fbf8be41-e92b-561f-ad73-49d08a3c31d5" :answer/value "{f}^{-1}(x)=\\frac{64}{(3-x)^{3}}"] [17592186189964 :answer-field/correct "answer-fbf8be41-e92b-561f-ad73-49d08a3c31d5"] [17592186189964 :answer-field/choices "answer-7b2900c9-1a52-5c45-aed2-605280ab5a10"] [17592186189964 :answer-field/choices "answer-8aaf3446-c684-5564-a8b6-8388976113a9"] [17592186189964 :answer-field/choices "answer-b0ed2b73-1ef1-577c-b9a7-c447148706e5"] [17592186189964 :answer-field/choices "answer-f085bb4e-fe8a-59a1-aa2f-9be46d61a226"] [17592186189964 :answer-field/choices "answer-fbf8be41-e92b-561f-ad73-49d08a3c31d5"] ["question-3c4a5911-5181-51eb-9128-55f7bf7227a5" :question/id #uuid "3c4a5911-5181-51eb-9128-55f7bf7227a5"] ["question-3c4a5911-5181-51eb-9128-55f7bf7227a5" :question/math-academy-id "q-277067"] ["question-3c4a5911-5181-51eb-9128-55f7bf7227a5" :question/problem "Find the inverse of the function $f(x)=2-\\frac{1}{6\\sqrt{x}}.$\n\n${f}^{-1}(x)=$\n{{field-1}}"] ["question-3c4a5911-5181-51eb-9128-55f7bf7227a5" :question/worked-solution "To find ${f}^{-1}(x),$ we start by replacing $f(x)$ with $y:$\n\n$$\ny=2-\\frac{1}{6\\sqrt{x}}\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx=2-\\frac{1}{6\\sqrt{y}}.\n$$\n\nThen, we make $y$ the subject of the equation as follows:\n\n$$\n\\begin{aligned}x & =2-\\frac{1}{6\\sqrt{y}} \\\\ \\frac{1}{6\\sqrt{y}} & =2-x \\\\ \\sqrt{y} & =\\frac{1}{6(2-x)} \\\\ {(\\sqrt{y})}^{2} & ={(\\frac{1}{6(2-x)})}^{2} \\\\ y & =\\frac{1}{36(2-x)^{2}}\\end{aligned}\n$$\n\nTherefore, the inverse function is \n\n$$\n{f}^{-1}(x)=\\frac{1}{36(2-x)^{2}}.\n$$\n\n**Note**: The domain and range of $f(x)$ are\n\n$$\nx>0,\\,f(x)<2.\n$$\n\nTherefore, the domain and range of ${f}^{-1}(x)$ are\n\n$$\nx<2,\\,{f}^{-1}(x)>0.\n$$"] ["question-3c4a5911-5181-51eb-9128-55f7bf7227a5" :question/difficulty :question.difficulty/moderate] ["answer-field-40d99a89-ad22-5776-b72c-624e7b154468" :answer-field/id #uuid "40d99a89-ad22-5776-b72c-624e7b154468"] ["answer-9e485cf9-61f6-51e5-b155-eeafd0535fb8" :answer/id #uuid "9e485cf9-61f6-51e5-b155-eeafd0535fb8"] ["answer-9e485cf9-61f6-51e5-b155-eeafd0535fb8" :answer/type :answer.type/math] ["answer-9e485cf9-61f6-51e5-b155-eeafd0535fb8" :answer/value "\\frac{1}{36(2-x)^2}"] ["answer-field-40d99a89-ad22-5776-b72c-624e7b154468" :answer-field/key "field-1"] ["answer-field-40d99a89-ad22-5776-b72c-624e7b154468" :answer-field/type :answer-field.type/blank] ["answer-field-40d99a89-ad22-5776-b72c-624e7b154468" :answer-field/correct "answer-9e485cf9-61f6-51e5-b155-eeafd0535fb8"] ["answer-field-40d99a89-ad22-5776-b72c-624e7b154468" :answer-field/choices "answer-9e485cf9-61f6-51e5-b155-eeafd0535fb8"] ["question-3c4a5911-5181-51eb-9128-55f7bf7227a5" :question/answer-fields "answer-field-40d99a89-ad22-5776-b72c-624e7b154468"] [17592186192707 :knowledge-point/questions "question-3c4a5911-5181-51eb-9128-55f7bf7227a5"] ["question-0b14029b-c258-5cb1-9467-400506e4dea8" :question/id #uuid "0b14029b-c258-5cb1-9467-400506e4dea8"] ["question-0b14029b-c258-5cb1-9467-400506e4dea8" :question/math-academy-id "q-148747"] ["question-0b14029b-c258-5cb1-9467-400506e4dea8" :question/problem "Find the inverse of the function $f(x)=\\frac{1}{4\\sqrt[3]{x}}+2.$"] ["question-0b14029b-c258-5cb1-9467-400506e4dea8" :question/worked-solution "To find ${f}^{-1}(x),$ we start by replacing $f(x)$ with $y:$\n\n$$\ny=\\frac{1}{4\\sqrt[3]{x}}+2\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx=\\frac{1}{4\\sqrt[3]{y}}+2.\n$$\n\nThen, we make $y$ the subject of the equation as follows:\n\n$$\n\\begin{aligned}x & =\\frac{1}{4\\sqrt[3]{y}}+2 \\\\ x-2 & =\\frac{1}{4\\sqrt[3]{y}} \\\\ \\sqrt[3]{y} & =\\frac{1}{4(x-2)} \\\\ (\\sqrt[3]{y})^{3} & ={(\\frac{1}{4(x-2)})}^{3} \\\\ y & =\\frac{1}{64(x-2)^{3}}\\end{aligned}\n$$\n\nTherefore, the inverse function is \n\n$$\n{f}^{-1}(x)=\\frac{1}{64(x-2)^{3}}.\n$$\n\n**Note**: The domain and range of $f(x)$ are\n\n$$\nx\\ne 0,\\,f(x)\\ne 2.\n$$\n\nTherefore, the domain and range of ${f}^{-1}(x)$ are\n\n$$\nx\\ne 2,\\,{f}^{-1}(x)\\ne 0.\n$$"] ["question-0b14029b-c258-5cb1-9467-400506e4dea8" :question/difficulty :question.difficulty/hard] ["answer-field-dcbe83e8-d72e-5bb6-b19b-e4a77cbd25ee" :answer-field/id #uuid "dcbe83e8-d72e-5bb6-b19b-e4a77cbd25ee"] ["answer-bdf416e7-2557-519f-9c8d-e7755baf7e45" :answer/id #uuid "bdf416e7-2557-519f-9c8d-e7755baf7e45"] ["answer-bdf416e7-2557-519f-9c8d-e7755baf7e45" :answer/type :answer.type/math] ["answer-bdf416e7-2557-519f-9c8d-e7755baf7e45" :answer/value "{f}^{-1}(x)=64(x-2)^{3}"] ["answer-96b7e621-3bbb-55a8-a16a-7decc770db27" :answer/id #uuid "96b7e621-3bbb-55a8-a16a-7decc770db27"] ["answer-96b7e621-3bbb-55a8-a16a-7decc770db27" :answer/type :answer.type/math] ["answer-96b7e621-3bbb-55a8-a16a-7decc770db27" :answer/value "{f}^{-1}(x)=64{x}^{3}-2"] ["answer-6518ddc4-2fcf-51ec-b05c-ac3df3011702" :answer/id #uuid "6518ddc4-2fcf-51ec-b05c-ac3df3011702"] ["answer-6518ddc4-2fcf-51ec-b05c-ac3df3011702" :answer/type :answer.type/math] ["answer-6518ddc4-2fcf-51ec-b05c-ac3df3011702" :answer/value "{f}^{-1}(x)=\\frac{1}{4{x}^{3}}-2"] ["answer-f5ceef0a-2fb9-54f4-a30f-c1f6dea6f8fa" :answer/id #uuid "f5ceef0a-2fb9-54f4-a30f-c1f6dea6f8fa"] ["answer-f5ceef0a-2fb9-54f4-a30f-c1f6dea6f8fa" :answer/type :answer.type/math] ["answer-f5ceef0a-2fb9-54f4-a30f-c1f6dea6f8fa" :answer/value "{f}^{-1}(x)=\\frac{1}{64(x-2)^{3}}"] ["answer-52df6e02-287c-5a79-93aa-3df8e4867c19" :answer/id #uuid "52df6e02-287c-5a79-93aa-3df8e4867c19"] ["answer-52df6e02-287c-5a79-93aa-3df8e4867c19" :answer/type :answer.type/math] ["answer-52df6e02-287c-5a79-93aa-3df8e4867c19" :answer/value "{f}^{-1}(x)=\\frac{2}{(x-4)^{3}}"] ["answer-field-dcbe83e8-d72e-5bb6-b19b-e4a77cbd25ee" :answer-field/key "selection"] ["answer-field-dcbe83e8-d72e-5bb6-b19b-e4a77cbd25ee" :answer-field/type :answer-field.type/radio] ["answer-field-dcbe83e8-d72e-5bb6-b19b-e4a77cbd25ee" :answer-field/correct "answer-f5ceef0a-2fb9-54f4-a30f-c1f6dea6f8fa"] ["answer-field-dcbe83e8-d72e-5bb6-b19b-e4a77cbd25ee" :answer-field/choices "answer-bdf416e7-2557-519f-9c8d-e7755baf7e45"] ["answer-field-dcbe83e8-d72e-5bb6-b19b-e4a77cbd25ee" :answer-field/choices "answer-96b7e621-3bbb-55a8-a16a-7decc770db27"] ["answer-field-dcbe83e8-d72e-5bb6-b19b-e4a77cbd25ee" :answer-field/choices "answer-6518ddc4-2fcf-51ec-b05c-ac3df3011702"] ["answer-field-dcbe83e8-d72e-5bb6-b19b-e4a77cbd25ee" :answer-field/choices "answer-f5ceef0a-2fb9-54f4-a30f-c1f6dea6f8fa"] ["answer-field-dcbe83e8-d72e-5bb6-b19b-e4a77cbd25ee" :answer-field/choices "answer-52df6e02-287c-5a79-93aa-3df8e4867c19"] ["question-0b14029b-c258-5cb1-9467-400506e4dea8" :question/answer-fields "answer-field-dcbe83e8-d72e-5bb6-b19b-e4a77cbd25ee"] [17592186192707 :knowledge-point/questions "question-0b14029b-c258-5cb1-9467-400506e4dea8"] ["question-37674798-c6eb-521f-b1bd-86df515c51cc" :question/id #uuid "37674798-c6eb-521f-b1bd-86df515c51cc"] ["question-37674798-c6eb-521f-b1bd-86df515c51cc" :question/math-academy-id "q-148501"] ["question-37674798-c6eb-521f-b1bd-86df515c51cc" :question/problem "Find the inverse of the function $f(x)=2\\sqrt[3]{3x-1}.$"] ["question-37674798-c6eb-521f-b1bd-86df515c51cc" :question/worked-solution "To find ${f}^{-1}(x),$ we start by replacing $f(x)$ with $y:$\n\n$$\ny=2\\sqrt[3]{3x-1}\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx=2\\sqrt[3]{3y-1}.\n$$\n\nThen, we make $y$ the subject of the equation as follows:\n\n$$\n\\begin{aligned}x & =2\\sqrt[3]{3y-1} \\\\ \\sqrt[3]{3y-1} & =\\frac{1}{2}x \\\\ {(\\sqrt[3]{3y-1})}^{3} & ={(\\frac{1}{2}x)}^{3} \\\\ 3y-1 & =\\frac{1}{8}{x}^{3} \\\\ 3y & =\\frac{1}{8}{x}^{3}+1 \\\\ y & =\\frac{1}{3}(\\frac{1}{8}{x}^{3}+1) \\\\ y & =\\frac{1}{24}({x}^{3}+8)\\end{aligned}\n$$\n\nTherefore, the inverse function is \n\n$$\n{f}^{-1}(x)=\\frac{1}{24}({x}^{3}+8).\n$$"] ["question-37674798-c6eb-521f-b1bd-86df515c51cc" :question/difficulty :question.difficulty/moderate] ["answer-field-34761f03-b01e-5d22-8611-5c45286ea99b" :answer-field/id #uuid "34761f03-b01e-5d22-8611-5c45286ea99b"] ["answer-e37e5b73-e8d4-5af6-b8e6-580429037d3e" :answer/id #uuid "e37e5b73-e8d4-5af6-b8e6-580429037d3e"] ["answer-e37e5b73-e8d4-5af6-b8e6-580429037d3e" :answer/type :answer.type/math] ["answer-e37e5b73-e8d4-5af6-b8e6-580429037d3e" :answer/value "{f}^{-1}(x)=12(x-1)^{3}"] ["answer-f2dd486e-0038-5ce9-9d90-476d55220192" :answer/id #uuid "f2dd486e-0038-5ce9-9d90-476d55220192"] ["answer-f2dd486e-0038-5ce9-9d90-476d55220192" :answer/type :answer.type/math] ["answer-f2dd486e-0038-5ce9-9d90-476d55220192" :answer/value "{f}^{-1}(x)=6({x}^{3}-2)"] ["answer-6c68ea4c-d5d7-5c9b-a465-6fa09bd2ebf5" :answer/id #uuid "6c68ea4c-d5d7-5c9b-a465-6fa09bd2ebf5"] ["answer-6c68ea4c-d5d7-5c9b-a465-6fa09bd2ebf5" :answer/type :answer.type/math] ["answer-6c68ea4c-d5d7-5c9b-a465-6fa09bd2ebf5" :answer/value "{f}^{-1}(x)=\\frac{1}{24}({x}^{3}+8)"] ["answer-f02462fe-ef6d-54c3-9d42-6b2cb1464fdc" :answer/id #uuid "f02462fe-ef6d-54c3-9d42-6b2cb1464fdc"] ["answer-f02462fe-ef6d-54c3-9d42-6b2cb1464fdc" :answer/type :answer.type/math] ["answer-f02462fe-ef6d-54c3-9d42-6b2cb1464fdc" :answer/value "{f}^{-1}(x)=\\frac{1}{4}{(x+2)}^{3}"] ["answer-94cdd666-3a14-52b6-9bc6-23f645829972" :answer/id #uuid "94cdd666-3a14-52b6-9bc6-23f645829972"] ["answer-94cdd666-3a14-52b6-9bc6-23f645829972" :answer/type :answer.type/math] ["answer-94cdd666-3a14-52b6-9bc6-23f645829972" :answer/value "{f}^{-1}(x)=\\frac{1}{8}({x}^{3}+1)"] ["answer-field-34761f03-b01e-5d22-8611-5c45286ea99b" :answer-field/key "selection"] ["answer-field-34761f03-b01e-5d22-8611-5c45286ea99b" :answer-field/type :answer-field.type/radio] ["answer-field-34761f03-b01e-5d22-8611-5c45286ea99b" :answer-field/correct "answer-6c68ea4c-d5d7-5c9b-a465-6fa09bd2ebf5"] ["answer-field-34761f03-b01e-5d22-8611-5c45286ea99b" :answer-field/choices "answer-e37e5b73-e8d4-5af6-b8e6-580429037d3e"] ["answer-field-34761f03-b01e-5d22-8611-5c45286ea99b" :answer-field/choices "answer-f2dd486e-0038-5ce9-9d90-476d55220192"] ["answer-field-34761f03-b01e-5d22-8611-5c45286ea99b" :answer-field/choices "answer-6c68ea4c-d5d7-5c9b-a465-6fa09bd2ebf5"] ["answer-field-34761f03-b01e-5d22-8611-5c45286ea99b" :answer-field/choices "answer-f02462fe-ef6d-54c3-9d42-6b2cb1464fdc"] ["answer-field-34761f03-b01e-5d22-8611-5c45286ea99b" :answer-field/choices "answer-94cdd666-3a14-52b6-9bc6-23f645829972"] ["question-37674798-c6eb-521f-b1bd-86df515c51cc" :question/answer-fields "answer-field-34761f03-b01e-5d22-8611-5c45286ea99b"] [17592186192698 :knowledge-point/questions "question-37674798-c6eb-521f-b1bd-86df515c51cc"] ["question-14c0067f-8b9b-586e-a9fe-ecef26e510a6" :question/id #uuid "14c0067f-8b9b-586e-a9fe-ecef26e510a6"] ["question-14c0067f-8b9b-586e-a9fe-ecef26e510a6" :question/math-academy-id "q-277826"] ["question-14c0067f-8b9b-586e-a9fe-ecef26e510a6" :question/problem "Find the inverse of the function $f(x)=\\frac{3}{\\sqrt[3]{2x-1}}+2.$\n\n${f}^{-1}(x)=$\n{{field-1}}"] ["question-14c0067f-8b9b-586e-a9fe-ecef26e510a6" :question/worked-solution "To find ${f}^{-1}(x),$ we start by replacing $f(x)$ with $y:$\n\n$$\ny=\\frac{3}{\\sqrt[3]{2x-1}}+2\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx=\\frac{3}{\\sqrt[3]{2y-1}}+2.\n$$\n\nThen, we make $y$ the subject of the equation as follows:\n\n$$\n\\begin{aligned}x & =\\frac{3}{\\sqrt[3]{2y-1}}+2 \\\\ \\sqrt[3]{2y-1} & =\\frac{3}{x-2} \\\\ (\\sqrt[3]{2y-1})^{3} & ={(\\frac{3}{x-2})}^{3} \\\\ 2y-1 & =\\frac{27}{(x-2)^{3}} \\\\ 2y & =\\frac{27}{(x-2)^{3}}+1 \\\\ y & =\\frac{27}{2(x-2)^{3}}+\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, the inverse function is \n\n$$\n{f}^{-1}(x)=\\frac{27}{2(x-2)^{3}}+\\frac{1}{2}.\n$$\n\n**Note**: The domain and range of $f(x)$ are\n\n$$\nx\\ne \\frac{1}{2},\\,f(x)\\ne 2.\n$$\n\nTherefore, the domain and range of ${f}^{-1}(x)$ are\n\n$$\nx\\ne 2,\\,{f}^{-1}(x)\\ne \\frac{1}{2}.\n$$"] ["question-14c0067f-8b9b-586e-a9fe-ecef26e510a6" :question/difficulty :question.difficulty/hard] ["answer-field-5e843349-d8eb-5c3b-b2d7-adbfcd0cf240" :answer-field/id #uuid "5e843349-d8eb-5c3b-b2d7-adbfcd0cf240"] ["answer-2dc46780-aad0-5339-8bcd-85933f0f6ae1" :answer/id #uuid "2dc46780-aad0-5339-8bcd-85933f0f6ae1"] ["answer-2dc46780-aad0-5339-8bcd-85933f0f6ae1" :answer/type :answer.type/math] ["answer-2dc46780-aad0-5339-8bcd-85933f0f6ae1" :answer/value "\\frac{27}{2(x-2)^{3}}+\\frac{1}{2}"] ["answer-field-5e843349-d8eb-5c3b-b2d7-adbfcd0cf240" :answer-field/key "field-1"] ["answer-field-5e843349-d8eb-5c3b-b2d7-adbfcd0cf240" :answer-field/type :answer-field.type/blank] ["answer-field-5e843349-d8eb-5c3b-b2d7-adbfcd0cf240" :answer-field/correct "answer-2dc46780-aad0-5339-8bcd-85933f0f6ae1"] ["answer-field-5e843349-d8eb-5c3b-b2d7-adbfcd0cf240" :answer-field/choices "answer-2dc46780-aad0-5339-8bcd-85933f0f6ae1"] ["question-14c0067f-8b9b-586e-a9fe-ecef26e510a6" :question/answer-fields "answer-field-5e843349-d8eb-5c3b-b2d7-adbfcd0cf240"] [17592186192698 :knowledge-point/questions "question-14c0067f-8b9b-586e-a9fe-ecef26e510a6"] ["question-286413cf-e05b-52a9-9010-9fd10625bdfe" :question/id #uuid "286413cf-e05b-52a9-9010-9fd10625bdfe"] ["question-286413cf-e05b-52a9-9010-9fd10625bdfe" :question/math-academy-id "q-148496"] ["question-286413cf-e05b-52a9-9010-9fd10625bdfe" :question/problem "Find the inverse of the function $f(x)=\\frac{1}{3}\\sqrt[3]{x-3}.$"] ["question-286413cf-e05b-52a9-9010-9fd10625bdfe" :question/worked-solution "To find ${f}^{-1}(x),$ we start by replacing $f(x)$ with $y:$\n\n$$\ny=\\frac{1}{3}\\sqrt[3]{x-3}\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx=\\frac{1}{3}\\sqrt[3]{y-3}.\n$$\n\nThen, we make $y$ the subject of the equation as follows:\n\n$$\n\\begin{aligned}x & =\\frac{1}{3}\\sqrt[3]{y-3} \\\\ \\sqrt[3]{y-3} & =3x \\\\ {(\\sqrt[3]{y-3})}^{3} & ={(3x)}^{3} \\\\ y-3 & =27{x}^{3} \\\\ y & =27{x}^{3}+3\\end{aligned}\n$$\n\nTherefore, the inverse function is \n\n$$\n{f}^{-1}(x)=27{x}^{3}+3.\n$$"] ["question-286413cf-e05b-52a9-9010-9fd10625bdfe" :question/difficulty :question.difficulty/moderate] ["answer-field-b9cdd843-64c4-50a3-ad0d-06cbfb60f172" :answer-field/id #uuid "b9cdd843-64c4-50a3-ad0d-06cbfb60f172"] ["answer-8532f603-d7b3-5d9b-a75f-906ea9009617" :answer/id #uuid "8532f603-d7b3-5d9b-a75f-906ea9009617"] ["answer-8532f603-d7b3-5d9b-a75f-906ea9009617" :answer/type :answer.type/math] ["answer-8532f603-d7b3-5d9b-a75f-906ea9009617" :answer/value "{f}^{-1}(x)=(x+3)^{3}-3"] ["answer-bace4cbf-a365-53e9-bce0-e3383e584bbb" :answer/id #uuid "bace4cbf-a365-53e9-bce0-e3383e584bbb"] ["answer-bace4cbf-a365-53e9-bce0-e3383e584bbb" :answer/type :answer.type/math] ["answer-bace4cbf-a365-53e9-bce0-e3383e584bbb" :answer/value "{f}^{-1}(x)=(x-3)^{3}+3"] ["answer-8c683e72-6d13-57a1-b930-019be2268271" :answer/id #uuid "8c683e72-6d13-57a1-b930-019be2268271"] ["answer-8c683e72-6d13-57a1-b930-019be2268271" :answer/type :answer.type/math] ["answer-8c683e72-6d13-57a1-b930-019be2268271" :answer/value "{f}^{-1}(x)=27{x}^{3}+3"] ["answer-df3aa2c2-149a-55c8-b611-81c3367b402f" :answer/id #uuid "df3aa2c2-149a-55c8-b611-81c3367b402f"] ["answer-df3aa2c2-149a-55c8-b611-81c3367b402f" :answer/type :answer.type/math] ["answer-df3aa2c2-149a-55c8-b611-81c3367b402f" :answer/value "{f}^{-1}(x)=3{x}^{3}-27"] ["answer-5fd39f34-1a8b-5f62-a888-d836f9832ac3" :answer/id #uuid "5fd39f34-1a8b-5f62-a888-d836f9832ac3"] ["answer-5fd39f34-1a8b-5f62-a888-d836f9832ac3" :answer/type :answer.type/math] ["answer-5fd39f34-1a8b-5f62-a888-d836f9832ac3" :answer/value "{f}^{-1}(x)=9{x}^{3}+1"] ["answer-field-b9cdd843-64c4-50a3-ad0d-06cbfb60f172" :answer-field/key "selection"] ["answer-field-b9cdd843-64c4-50a3-ad0d-06cbfb60f172" :answer-field/type :answer-field.type/radio] ["answer-field-b9cdd843-64c4-50a3-ad0d-06cbfb60f172" :answer-field/correct "answer-8c683e72-6d13-57a1-b930-019be2268271"] ["answer-field-b9cdd843-64c4-50a3-ad0d-06cbfb60f172" :answer-field/choices "answer-8532f603-d7b3-5d9b-a75f-906ea9009617"] ["answer-field-b9cdd843-64c4-50a3-ad0d-06cbfb60f172" :answer-field/choices "answer-bace4cbf-a365-53e9-bce0-e3383e584bbb"] ["answer-field-b9cdd843-64c4-50a3-ad0d-06cbfb60f172" :answer-field/choices "answer-8c683e72-6d13-57a1-b930-019be2268271"] ["answer-field-b9cdd843-64c4-50a3-ad0d-06cbfb60f172" :answer-field/choices "answer-df3aa2c2-149a-55c8-b611-81c3367b402f"] ["answer-field-b9cdd843-64c4-50a3-ad0d-06cbfb60f172" :answer-field/choices "answer-5fd39f34-1a8b-5f62-a888-d836f9832ac3"] ["question-286413cf-e05b-52a9-9010-9fd10625bdfe" :question/answer-fields "answer-field-b9cdd843-64c4-50a3-ad0d-06cbfb60f172"] [17592186192698 :knowledge-point/questions "question-286413cf-e05b-52a9-9010-9fd10625bdfe"] ["question-f36e5ef3-ccb2-5795-aca3-91dfb93e14f0" :question/id #uuid "f36e5ef3-ccb2-5795-aca3-91dfb93e14f0"] ["question-f36e5ef3-ccb2-5795-aca3-91dfb93e14f0" :question/math-academy-id "q-148494"] ["question-f36e5ef3-ccb2-5795-aca3-91dfb93e14f0" :question/problem "Find the inverse of the function $f(x)=\\frac{1}{2}\\sqrt{x-1}+3.$"] ["question-f36e5ef3-ccb2-5795-aca3-91dfb93e14f0" :question/worked-solution "To find ${f}^{-1}(x),$ we start by replacing $f(x)$ with $y:$\n\n$$\ny=\\frac{1}{2}\\sqrt{x-1}+3\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx=\\frac{1}{2}\\sqrt{y-1}+3.\n$$\n\nThen, we make $y$ the subject of the equation as follows:\n\n$$\n\\begin{aligned}x & =\\frac{1}{2}\\sqrt{y-1}+3 \\\\ \\frac{1}{2}\\sqrt{y-1} & =x-3 \\\\ \\sqrt{y-1} & =2(x-3) \\\\ {(\\sqrt{y-1})}^{2} & ={(2(x-3))}^{2} \\\\ y-1 & =4(x-3)^{2} \\\\ y & =4(x-3)^{2}+1\\end{aligned}\n$$\n\nTherefore, the inverse function is \n\n$$\n{f}^{-1}(x)=4(x-3)^{2}+1.\n$$\n\n**Note**: The domain and range of $f(x)$ are\n\n$$\nx\\ge 1,\\,f(x)\\ge 3.\n$$\n\nTherefore, the domain and range of ${f}^{-1}(x)$ are\n\n$$\nx\\ge 3,\\,{f}^{-1}(x)\\ge 1.\n$$"] ["question-f36e5ef3-ccb2-5795-aca3-91dfb93e14f0" :question/difficulty :question.difficulty/moderate] ["answer-field-f4ff08e9-b72b-5342-b55b-78431f176928" :answer-field/id #uuid "f4ff08e9-b72b-5342-b55b-78431f176928"] ["answer-dd9c5c09-10a6-5342-af9b-78b2b5ae6a65" :answer/id #uuid "dd9c5c09-10a6-5342-af9b-78b2b5ae6a65"] ["answer-dd9c5c09-10a6-5342-af9b-78b2b5ae6a65" :answer/type :answer.type/math] ["answer-dd9c5c09-10a6-5342-af9b-78b2b5ae6a65" :answer/value "{f}^{-1}(x)=4(x-3)^{2}+1"] ["answer-fd71342d-0d39-5d72-ad19-e051b324e06a" :answer/id #uuid "fd71342d-0d39-5d72-ad19-e051b324e06a"] ["answer-fd71342d-0d39-5d72-ad19-e051b324e06a" :answer/type :answer.type/math] ["answer-fd71342d-0d39-5d72-ad19-e051b324e06a" :answer/value "{f}^{-1}(x)=9(x-1)^{2}+2"] ["answer-480959df-c442-5539-928c-11f21e7bf1e3" :answer/id #uuid "480959df-c442-5539-928c-11f21e7bf1e3"] ["answer-480959df-c442-5539-928c-11f21e7bf1e3" :answer/type :answer.type/math] ["answer-480959df-c442-5539-928c-11f21e7bf1e3" :answer/value "{f}^{-1}(x)=9(x-1)^{2}-4"] ["answer-2dcd6be4-7ab5-5b54-88c5-9399ecae152a" :answer/id #uuid "2dcd6be4-7ab5-5b54-88c5-9399ecae152a"] ["answer-2dcd6be4-7ab5-5b54-88c5-9399ecae152a" :answer/type :answer.type/math] ["answer-2dcd6be4-7ab5-5b54-88c5-9399ecae152a" :answer/value "{f}^{-1}(x)=\\frac{1}{2}(x-3)^{2}-2"] ["answer-a85b8ce9-a004-5f51-988e-d3a07f8cb054" :answer/id #uuid "a85b8ce9-a004-5f51-988e-d3a07f8cb054"] ["answer-a85b8ce9-a004-5f51-988e-d3a07f8cb054" :answer/type :answer.type/math] ["answer-a85b8ce9-a004-5f51-988e-d3a07f8cb054" :answer/value "{f}^{-1}(x)=\\frac{1}{3}(x-3)^{2}-1"] ["answer-field-f4ff08e9-b72b-5342-b55b-78431f176928" :answer-field/key "selection"] ["answer-field-f4ff08e9-b72b-5342-b55b-78431f176928" :answer-field/type :answer-field.type/radio] ["answer-field-f4ff08e9-b72b-5342-b55b-78431f176928" :answer-field/correct "answer-dd9c5c09-10a6-5342-af9b-78b2b5ae6a65"] ["answer-field-f4ff08e9-b72b-5342-b55b-78431f176928" :answer-field/choices "answer-dd9c5c09-10a6-5342-af9b-78b2b5ae6a65"] ["answer-field-f4ff08e9-b72b-5342-b55b-78431f176928" :answer-field/choices "answer-fd71342d-0d39-5d72-ad19-e051b324e06a"] ["answer-field-f4ff08e9-b72b-5342-b55b-78431f176928" :answer-field/choices "answer-480959df-c442-5539-928c-11f21e7bf1e3"] ["answer-field-f4ff08e9-b72b-5342-b55b-78431f176928" :answer-field/choices "answer-2dcd6be4-7ab5-5b54-88c5-9399ecae152a"] ["answer-field-f4ff08e9-b72b-5342-b55b-78431f176928" :answer-field/choices "answer-a85b8ce9-a004-5f51-988e-d3a07f8cb054"] ["question-f36e5ef3-ccb2-5795-aca3-91dfb93e14f0" :question/answer-fields "answer-field-f4ff08e9-b72b-5342-b55b-78431f176928"] [17592186192698 :knowledge-point/questions "question-f36e5ef3-ccb2-5795-aca3-91dfb93e14f0"] ["question-7e395659-7f2e-5dda-a6c4-f51ac9defcd5" :question/id #uuid "7e395659-7f2e-5dda-a6c4-f51ac9defcd5"] ["question-7e395659-7f2e-5dda-a6c4-f51ac9defcd5" :question/math-academy-id "q-148550"] ["question-7e395659-7f2e-5dda-a6c4-f51ac9defcd5" :question/problem "Find the inverse of the function $f(x)=2-\\frac{1}{\\sqrt{3x+2}}.$"] ["question-7e395659-7f2e-5dda-a6c4-f51ac9defcd5" :question/worked-solution "To find ${f}^{-1}(x),$ we start by replacing $f(x)$ with $y:$\n\n$$\ny=2-\\frac{1}{\\sqrt{3x+2}}\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx=2-\\frac{1}{\\sqrt{3y+2}}.\n$$\n\nThen, we make $y$ the subject of the equation as follows:\n\n$$\n\\begin{aligned}x & =2-\\frac{1}{\\sqrt{3y+2}} \\\\ x-2 & =-\\frac{1}{\\sqrt{3y+2}} \\\\ 2-x & =\\frac{1}{\\sqrt{3y+2}} \\\\ \\sqrt{3y+2} & =\\frac{1}{2-x} \\\\ {(\\sqrt{3y+2})}^{2} & ={(\\frac{1}{2-x})}^{2} \\\\ 3y+2 & =\\frac{1}{(x-2)^{2}} \\\\ 3y & =\\frac{1}{(x-2)^{2}}-2 \\\\ y & =\\frac{1}{3(x-2)^{2}}-\\frac{2}{3}\\end{aligned}\n$$\n\nTherefore, the inverse function is \n\n$$\n{f}^{-1}(x)=\\frac{1}{3(x-2)^{2}}-\\frac{2}{3}.\n$$\n\n**Note**: The domain and range of $f(x)$ are\n\n$$\nx>-\\frac{2}{3},\\,f(x)<2.\n$$\n\nTherefore, the domain and range of ${f}^{-1}(x)$ are\n\n$$\nx<2,\\,{f}^{-1}(x)>-\\frac{2}{3}.\n$$"] ["question-7e395659-7f2e-5dda-a6c4-f51ac9defcd5" :question/difficulty :question.difficulty/hard] ["answer-field-ab8f4d5e-ee1c-54bc-8580-83267a345dee" :answer-field/id #uuid "ab8f4d5e-ee1c-54bc-8580-83267a345dee"] ["answer-2477bab7-122c-5324-8f02-3dc1b27b3327" :answer/id #uuid "2477bab7-122c-5324-8f02-3dc1b27b3327"] ["answer-2477bab7-122c-5324-8f02-3dc1b27b3327" :answer/type :answer.type/math] ["answer-2477bab7-122c-5324-8f02-3dc1b27b3327" :answer/value "{f}^{-1}(x)=\\frac{1}{2(x-2)^{2}}-1"] ["answer-72fb6298-18a6-56bf-a33e-72c4a66e7145" :answer/id #uuid "72fb6298-18a6-56bf-a33e-72c4a66e7145"] ["answer-72fb6298-18a6-56bf-a33e-72c4a66e7145" :answer/type :answer.type/math] ["answer-72fb6298-18a6-56bf-a33e-72c4a66e7145" :answer/value "{f}^{-1}(x)=\\frac{1}{2{x}^{2}}-3"] ["answer-f92861fe-09c8-581d-936f-0b83ad2bc2b4" :answer/id #uuid "f92861fe-09c8-581d-936f-0b83ad2bc2b4"] ["answer-f92861fe-09c8-581d-936f-0b83ad2bc2b4" :answer/type :answer.type/math] ["answer-f92861fe-09c8-581d-936f-0b83ad2bc2b4" :answer/value "{f}^{-1}(x)=\\frac{1}{3(x-2)^{2}}-\\frac{2}{3}"] ["answer-b3a95a87-c0da-5973-ba25-281d8d1b9a09" :answer/id #uuid "b3a95a87-c0da-5973-ba25-281d8d1b9a09"] ["answer-b3a95a87-c0da-5973-ba25-281d8d1b9a09" :answer/type :answer.type/math] ["answer-b3a95a87-c0da-5973-ba25-281d8d1b9a09" :answer/value "{f}^{-1}(x)=\\frac{3}{(x-2)^{2}}-6"] ["answer-4d200f15-e854-5e0c-8e6d-204211621378" :answer/id #uuid "4d200f15-e854-5e0c-8e6d-204211621378"] ["answer-4d200f15-e854-5e0c-8e6d-204211621378" :answer/type :answer.type/math] ["answer-4d200f15-e854-5e0c-8e6d-204211621378" :answer/value "{f}^{-1}(x)=\\frac{3}{{x}^{2}}-\\frac{3}{2}"] ["answer-field-ab8f4d5e-ee1c-54bc-8580-83267a345dee" :answer-field/key "selection"] ["answer-field-ab8f4d5e-ee1c-54bc-8580-83267a345dee" :answer-field/type :answer-field.type/radio] ["answer-field-ab8f4d5e-ee1c-54bc-8580-83267a345dee" :answer-field/correct "answer-f92861fe-09c8-581d-936f-0b83ad2bc2b4"] ["answer-field-ab8f4d5e-ee1c-54bc-8580-83267a345dee" :answer-field/choices "answer-2477bab7-122c-5324-8f02-3dc1b27b3327"] ["answer-field-ab8f4d5e-ee1c-54bc-8580-83267a345dee" :answer-field/choices "answer-72fb6298-18a6-56bf-a33e-72c4a66e7145"] ["answer-field-ab8f4d5e-ee1c-54bc-8580-83267a345dee" :answer-field/choices "answer-f92861fe-09c8-581d-936f-0b83ad2bc2b4"] ["answer-field-ab8f4d5e-ee1c-54bc-8580-83267a345dee" :answer-field/choices "answer-b3a95a87-c0da-5973-ba25-281d8d1b9a09"] ["answer-field-ab8f4d5e-ee1c-54bc-8580-83267a345dee" :answer-field/choices "answer-4d200f15-e854-5e0c-8e6d-204211621378"] ["question-7e395659-7f2e-5dda-a6c4-f51ac9defcd5" :question/answer-fields "answer-field-ab8f4d5e-ee1c-54bc-8580-83267a345dee"] [17592186192698 :knowledge-point/questions "question-7e395659-7f2e-5dda-a6c4-f51ac9defcd5"] ["question-5cb5bb60-d097-50b4-9ba5-bde88e86a4d3" :question/id #uuid "5cb5bb60-d097-50b4-9ba5-bde88e86a4d3"] ["question-5cb5bb60-d097-50b4-9ba5-bde88e86a4d3" :question/math-academy-id "q-277959"] ["question-5cb5bb60-d097-50b4-9ba5-bde88e86a4d3" :question/problem "The function $f(x),$ defined as\n\n$$\nf(x)=\\frac{2}{k\\sqrt[3]{6x-1}}+2,\\,x\\ne \\frac{1}{6}\n$$\n\nhas an inverse function given by \n\n$$\n{f}^{-1}(x)=\\frac{4}{81(x-2)^{3}}+\\frac{1}{6},\\,x\\ne 2.\n$$\n\nWhat is the value of $k?$\n\n$k=$\n{{field-1}}"] ["question-5cb5bb60-d097-50b4-9ba5-bde88e86a4d3" :question/worked-solution "To find ${f}^{-1}(x),$ we start by replacing $f(x)$ with $y:$\n\n$$\ny=\\frac{2}{k\\sqrt[3]{6x-1}}+2\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx=\\frac{2}{k\\sqrt[3]{6y-1}}+2.\n$$\n\nThen, we make $y$ the subject of the equation as follows:\n\n$$\n\\begin{aligned}x & =\\frac{2}{k\\sqrt[3]{6y-1}}+2 \\\\ \\frac{2}{k\\sqrt[3]{6y-1}} & =x-2 \\\\ \\sqrt[3]{6y-1} & =\\frac{2}{k(x-2)} \\\\ {(\\sqrt[3]{6y-1})}^{3} & ={(\\frac{2}{k(x-2)})}^{3} \\\\ 6y-1 & =\\frac{{2}^{3}}{{k}^{3}(x-2)^{3}} \\\\ 6y & =\\frac{8}{{k}^{3}(x-2)^{3}}+1 \\\\ y & =\\frac{4}{3{k}^{3}(x-2)^{3}}+\\frac{1}{6}\\end{aligned}\n$$\n\nTherefore, the inverse function is \n\n$$\n{f}^{-1}(x)=\\frac{4}{3{k}^{3}(x-2)^{3}}+\\frac{1}{6},\\,x\\ne 2.\n$$\n\nComparing our answer with the given expression, we conclude that\n\n$$\n\\frac{4}{3{k}^{3}}=\\frac{4}{81}\\,⟹\\,k=3.\n$$"] ["question-5cb5bb60-d097-50b4-9ba5-bde88e86a4d3" :question/difficulty :question.difficulty/hard] ["answer-field-e9e8e3bd-efc4-5161-8659-23fbd7d317a4" :answer-field/id #uuid "e9e8e3bd-efc4-5161-8659-23fbd7d317a4"] ["answer-8963ea18-7842-5daf-9fc8-8d25637a3833" :answer/id #uuid "8963ea18-7842-5daf-9fc8-8d25637a3833"] ["answer-8963ea18-7842-5daf-9fc8-8d25637a3833" :answer/type :answer.type/math] ["answer-8963ea18-7842-5daf-9fc8-8d25637a3833" :answer/value "3"] ["answer-field-e9e8e3bd-efc4-5161-8659-23fbd7d317a4" :answer-field/key "field-1"] ["answer-field-e9e8e3bd-efc4-5161-8659-23fbd7d317a4" :answer-field/type :answer-field.type/blank] ["answer-field-e9e8e3bd-efc4-5161-8659-23fbd7d317a4" :answer-field/correct "answer-8963ea18-7842-5daf-9fc8-8d25637a3833"] ["answer-field-e9e8e3bd-efc4-5161-8659-23fbd7d317a4" :answer-field/choices "answer-8963ea18-7842-5daf-9fc8-8d25637a3833"] ["question-5cb5bb60-d097-50b4-9ba5-bde88e86a4d3" :question/answer-fields "answer-field-e9e8e3bd-efc4-5161-8659-23fbd7d317a4"] [17592186192699 :knowledge-point/questions "question-5cb5bb60-d097-50b4-9ba5-bde88e86a4d3"] ["question-22e0c565-a427-5cb0-889a-a9c4e5867def" :question/id #uuid "22e0c565-a427-5cb0-889a-a9c4e5867def"] ["question-22e0c565-a427-5cb0-889a-a9c4e5867def" :question/math-academy-id "q-277956"] ["question-22e0c565-a427-5cb0-889a-a9c4e5867def" :question/problem "The function $f(x),$ defined as\n\n$$\nf(x)=\\frac{k}{\\sqrt{8x+3}}+2,\\,x>-\\frac{3}{8}\n$$\n\nhas an inverse function given by \n\n$$\n{f}^{-1}(x)=\\frac{9}{2(x-2)^{2}}-\\frac{3}{8},\\,x>2.\n$$\n\nWhat is the value of $k?$ Assume that $k>0.$\n\n$k=$\n{{field-1}}"] ["question-22e0c565-a427-5cb0-889a-a9c4e5867def" :question/worked-solution "To find ${f}^{-1}(x),$ we start by replacing $f(x)$ with $y:$\n\n$$\ny=\\frac{k}{\\sqrt{8x+3}}+2\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx=\\frac{k}{\\sqrt{8y+3}}+2.\n$$\n\nThen, we make $y$ the subject of the equation as follows:\n\n$$\n\\begin{aligned}x & =\\frac{k}{\\sqrt{8y+3}}+2 \\\\ x-2 & =\\frac{k}{\\sqrt{8y+3}} \\\\ \\sqrt{8y+3} & =\\frac{k}{x-2} \\\\ {(\\sqrt{8y+3})}^{2} & ={(\\frac{k}{x-2})}^{2} \\\\ 8y+3 & =\\frac{{k}^{2}}{(x-2)^{2}} \\\\ 8y & =\\frac{{k}^{2}}{(x-2)^{2}}-3 \\\\ y & =\\frac{{k}^{2}}{8(x-2)^{2}}-\\frac{3}{8}\\end{aligned}\n$$\n\nTherefore, the inverse function is \n\n$$\n{f}^{-1}(x)=\\frac{{k}^{2}}{8(x-2)^{2}}-\\frac{3}{8},\\,x>2.\n$$\n\nComparing our answer with the given expression, we conclude that\n\n$$\n\\frac{{k}^{2}}{8}=\\frac{9}{2}\\,⟹\\,k=6.\n$$"] ["question-22e0c565-a427-5cb0-889a-a9c4e5867def" :question/difficulty :question.difficulty/hard] ["answer-field-3eb0821a-73a6-5211-a52f-bc88da953dbc" :answer-field/id #uuid "3eb0821a-73a6-5211-a52f-bc88da953dbc"] ["answer-7d73fe84-3859-5c8d-a8ac-924dd2eb2505" :answer/id #uuid "7d73fe84-3859-5c8d-a8ac-924dd2eb2505"] ["answer-7d73fe84-3859-5c8d-a8ac-924dd2eb2505" :answer/type :answer.type/math] ["answer-7d73fe84-3859-5c8d-a8ac-924dd2eb2505" :answer/value "6"] ["answer-field-3eb0821a-73a6-5211-a52f-bc88da953dbc" :answer-field/key "field-1"] ["answer-field-3eb0821a-73a6-5211-a52f-bc88da953dbc" :answer-field/type :answer-field.type/blank] ["answer-field-3eb0821a-73a6-5211-a52f-bc88da953dbc" :answer-field/correct "answer-7d73fe84-3859-5c8d-a8ac-924dd2eb2505"] ["answer-field-3eb0821a-73a6-5211-a52f-bc88da953dbc" :answer-field/choices "answer-7d73fe84-3859-5c8d-a8ac-924dd2eb2505"] ["question-22e0c565-a427-5cb0-889a-a9c4e5867def" :question/answer-fields "answer-field-3eb0821a-73a6-5211-a52f-bc88da953dbc"] [17592186192699 :knowledge-point/questions "question-22e0c565-a427-5cb0-889a-a9c4e5867def"] ["question-635cbae5-da30-5f6f-818b-8857829587ba" :question/id #uuid "635cbae5-da30-5f6f-818b-8857829587ba"] ["question-635cbae5-da30-5f6f-818b-8857829587ba" :question/math-academy-id "q-277840"] ["question-635cbae5-da30-5f6f-818b-8857829587ba" :question/problem "The function $f(x)=\\frac{1}{k}\\sqrt{x-5}+6$ has an inverse function given by ${f}^{-1}(x)=16(x-6)^{2}+5.$ What is the value of $k?$\n\n$k=$\n{{field-1}}"] ["question-635cbae5-da30-5f6f-818b-8857829587ba" :question/worked-solution "To find ${f}^{-1}(x),$ we start by replacing $f(x)$ with $y:$\n\n$$\ny=\\frac{1}{k}\\sqrt{x-5}+6\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx=\\frac{1}{k}\\sqrt{y-5}+6.\n$$\n\nThen, we make $y$ the subject of the equation as follows:\n\n$$\n\\begin{aligned}x & =\\frac{1}{k}\\sqrt{y-5}+6 \\\\ \\frac{1}{k}\\sqrt{y-5} & =x-6 \\\\ \\sqrt{y-5} & =k(x-6) \\\\ {(\\sqrt{y-5})}^{2} & ={(k(x-6))}^{2} \\\\ y-5 & ={k}^{2}(x-6)^{2} \\\\ y & ={k}^{2}(x-6)^{2}+5\\end{aligned}\n$$\n\nTherefore, the inverse function is \n\n$$\n{f}^{-1}(x)={k}^{2}(x-6)^{2}+5.\n$$\n\nComparing our answer with the given expression, we conclude that\n\n$$\n{k}^{2}=16\\,⟹\\,k=4.\n$$\n\n**Note**: The domain and range of $f(x)$ are\n\n$$\nx\\ge 5,\\,f(x)\\ge 6.\n$$\n\nTherefore, the domain and range of ${f}^{-1}(x)$ are\n\n$$\nx\\ge 6,\\,{f}^{-1}(x)\\ge 5.\n$$"] ["question-635cbae5-da30-5f6f-818b-8857829587ba" :question/difficulty :question.difficulty/moderate] ["answer-field-b8eacf56-5c06-55dd-aaa8-08c57c8e44fc" :answer-field/id #uuid "b8eacf56-5c06-55dd-aaa8-08c57c8e44fc"] ["answer-5a6bb1ec-ffed-5214-bafa-cf929f364451" :answer/id #uuid "5a6bb1ec-ffed-5214-bafa-cf929f364451"] ["answer-5a6bb1ec-ffed-5214-bafa-cf929f364451" :answer/type :answer.type/math] ["answer-5a6bb1ec-ffed-5214-bafa-cf929f364451" :answer/value "4"] ["answer-field-b8eacf56-5c06-55dd-aaa8-08c57c8e44fc" :answer-field/key "field-1"] ["answer-field-b8eacf56-5c06-55dd-aaa8-08c57c8e44fc" :answer-field/type :answer-field.type/blank] ["answer-field-b8eacf56-5c06-55dd-aaa8-08c57c8e44fc" :answer-field/correct "answer-5a6bb1ec-ffed-5214-bafa-cf929f364451"] ["answer-field-b8eacf56-5c06-55dd-aaa8-08c57c8e44fc" :answer-field/choices "answer-5a6bb1ec-ffed-5214-bafa-cf929f364451"] ["question-635cbae5-da30-5f6f-818b-8857829587ba" :question/answer-fields "answer-field-b8eacf56-5c06-55dd-aaa8-08c57c8e44fc"] [17592186192699 :knowledge-point/questions "question-635cbae5-da30-5f6f-818b-8857829587ba"] ["question-082ab1b4-7b0d-5301-97bc-d24a513a580b" :question/id #uuid "082ab1b4-7b0d-5301-97bc-d24a513a580b"] ["question-082ab1b4-7b0d-5301-97bc-d24a513a580b" :question/math-academy-id "q-148570"] ["question-082ab1b4-7b0d-5301-97bc-d24a513a580b" :question/problem "The function $f(x)=\\sqrt[3]{3x+1}+k$ has an inverse function given by ${f}^{-1}(x)=\\frac{1}{3}(x+4)^{3}-\\frac{1}{3}.$ What is the value of $k?$"] ["question-082ab1b4-7b0d-5301-97bc-d24a513a580b" :question/worked-solution "To find ${f}^{-1}(x),$ we start by replacing $f(x)$ with $y:$\n\n$$\ny=\\sqrt[3]{3x+1}+k\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx=\\sqrt[3]{3y+1}+k.\n$$\n\nThen, we make $y$ the subject of the equation as follows:\n\n$$\n\\begin{aligned}x & =\\sqrt[3]{3y+1}+k \\\\ \\sqrt[3]{3y+1} & =x-k \\\\ {(\\sqrt[3]{3y+1})}^{3} & ={(x-k)}^{3} \\\\ 3y+1 & =(x-k)^{3} \\\\ 3y & =(x-k)^{3}-1 \\\\ y & =\\frac{1}{3}(x-k)^{3}-\\frac{1}{3}\\end{aligned}\n$$\n\nTherefore, the inverse function is \n\n$$\n{f}^{-1}(x)=\\frac{1}{3}(x-k)^{3}-\\frac{1}{3}.\n$$\n\nComparing our answer with the given expression, we conclude that\n\n$$\n-k=4\\,⟹\\,k=-4.\n$$"] ["question-082ab1b4-7b0d-5301-97bc-d24a513a580b" :question/difficulty :question.difficulty/moderate] ["answer-field-5eae2b97-0cb3-5c07-814b-807db626bb1a" :answer-field/id #uuid "5eae2b97-0cb3-5c07-814b-807db626bb1a"] ["answer-8cbf05be-0c0d-584b-8454-95280fcbd97e" :answer/id #uuid "8cbf05be-0c0d-584b-8454-95280fcbd97e"] ["answer-8cbf05be-0c0d-584b-8454-95280fcbd97e" :answer/type :answer.type/math] ["answer-8cbf05be-0c0d-584b-8454-95280fcbd97e" :answer/value "-2"] ["answer-541dc755-cfc8-5462-825a-5222d3d5a3b7" :answer/id #uuid "541dc755-cfc8-5462-825a-5222d3d5a3b7"] ["answer-541dc755-cfc8-5462-825a-5222d3d5a3b7" :answer/type :answer.type/math] ["answer-541dc755-cfc8-5462-825a-5222d3d5a3b7" :answer/value "-4"] ["answer-e4dd1f5a-912b-519e-afe1-3f55d58ca52b" :answer/id #uuid "e4dd1f5a-912b-519e-afe1-3f55d58ca52b"] ["answer-e4dd1f5a-912b-519e-afe1-3f55d58ca52b" :answer/type :answer.type/math] ["answer-e4dd1f5a-912b-519e-afe1-3f55d58ca52b" :answer/value "2"] ["answer-27d37fb8-b5ab-549c-9f52-56163d362c4a" :answer/id #uuid "27d37fb8-b5ab-549c-9f52-56163d362c4a"] ["answer-27d37fb8-b5ab-549c-9f52-56163d362c4a" :answer/type :answer.type/math] ["answer-27d37fb8-b5ab-549c-9f52-56163d362c4a" :answer/value "4"] ["answer-7d022d19-1586-599b-ba25-4ba70baadb54" :answer/id #uuid "7d022d19-1586-599b-ba25-4ba70baadb54"] ["answer-7d022d19-1586-599b-ba25-4ba70baadb54" :answer/type :answer.type/math] ["answer-7d022d19-1586-599b-ba25-4ba70baadb54" :answer/value "8"] ["answer-field-5eae2b97-0cb3-5c07-814b-807db626bb1a" :answer-field/key "selection"] ["answer-field-5eae2b97-0cb3-5c07-814b-807db626bb1a" :answer-field/type :answer-field.type/radio] ["answer-field-5eae2b97-0cb3-5c07-814b-807db626bb1a" :answer-field/correct "answer-541dc755-cfc8-5462-825a-5222d3d5a3b7"] ["answer-field-5eae2b97-0cb3-5c07-814b-807db626bb1a" :answer-field/choices "answer-8cbf05be-0c0d-584b-8454-95280fcbd97e"] ["answer-field-5eae2b97-0cb3-5c07-814b-807db626bb1a" :answer-field/choices "answer-541dc755-cfc8-5462-825a-5222d3d5a3b7"] ["answer-field-5eae2b97-0cb3-5c07-814b-807db626bb1a" :answer-field/choices "answer-e4dd1f5a-912b-519e-afe1-3f55d58ca52b"] ["answer-field-5eae2b97-0cb3-5c07-814b-807db626bb1a" :answer-field/choices "answer-27d37fb8-b5ab-549c-9f52-56163d362c4a"] ["answer-field-5eae2b97-0cb3-5c07-814b-807db626bb1a" :answer-field/choices "answer-7d022d19-1586-599b-ba25-4ba70baadb54"] ["question-082ab1b4-7b0d-5301-97bc-d24a513a580b" :question/answer-fields "answer-field-5eae2b97-0cb3-5c07-814b-807db626bb1a"] [17592186192699 :knowledge-point/questions "question-082ab1b4-7b0d-5301-97bc-d24a513a580b"] [17592186193825 :tutorial/content "In this lesson, we'll use our knowledge of solving radical equations to compute inverses of radical functions. \n\nFor example, let's consider the following radical function:\n\n$$\nf(x) = 3\\sqrt{x} + 2\n$$\n\nTo compute the inverse of $f(x),$ we follow the usual four steps:\n\n**Step 1:** First, we replace $f(x)$ with $y\\mathbin{:}$\n\n$$\ny = 3\\sqrt{x} + 2\n$$\n\n**Step 2:** Then, we swap $x$ and $y\\mathbin{:}$\n\n$$\nx = 3\\sqrt{y} + 2\n$$\n\n**Step 3:** Next, we solve for $y\\mathbin{:}$\n\n$$\n\\begin{aligned}x & =3\\sqrt{y}+2 \\\\ 3\\sqrt{y} & =x-2 \\\\ \\sqrt{y} & =\\frac{1}{3}(x-2) \\\\ (\\sqrt{y})^{2} & ={(\\frac{1}{3}(x-2))}^{2} \\\\ y & =\\frac{1}{9}(x-2)^{2}\\end{aligned}\n$$\n\n**Step 4:** Finally, we replace $y$ with $f^{-1}(x)\\mathbin{:}$\n\n$$\nf^{-1}(x) = \\dfrac{1}{9}(x - 2)^2\n$$\n\n**Note**: The domain and range of $f(x)$ are\n\n$$\nx \\geq 0, \\qquad f(x) \\geq 2.\n$$\n\nTherefore, the domain and range of $f^{-1}(x)$ are\n\n$$\nx \\geq 2, \\qquad f^{-1}(x) \\geq 0.\n$$"] [17592186192863 :activity/expected-seconds 840.0]] "retractions" [[17592186192402 :question/problem "Find the inverse of the function $f(x) = 1 - \\dfrac{1}{3}\\sqrt{x}$."] [17592186192402 :question/worked-solution "To find $f^{-1}(x)$, we start by replacing $f(x)$ with $y{:}$\n\n$$\ny = 1 - \\dfrac{1}{3}\\sqrt{x}\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx = 1 - \\dfrac{1}{3}\\sqrt{y}\n$$\n\nThen, we make $y$ the subject of the equation as follows:\n\n$$\n\\begin{aligned}\nx &= 1 - \\frac{1}{3}\\sqrt{y} \\\\\n\\frac{1}{3}\\sqrt{y} &= 1 - x \\\\\n\\sqrt{y} &= 3(1 - x) \\\\\n(\\sqrt{y})^{2} &= (3(1 - x))^{2} \\\\\ny &= 9(1 - x)^{2} \\\\\ny &= 9(x - 1)^{2}\n\\end{aligned}\n$$\n\nTherefore, the inverse function is\n\n$$\nf^{-1}(x) = 9(x - 1)^2\n$$\n\n**Note**: The domain and range of $f(x)$ are\n\n$$\nx \\geq 0, \\qquad f(x) \\leq 1\n$$\n\nTherefore, the domain and range of $f^{-1}(x)$ are\n\n$$\nx \\leq 1, \\qquad f^{-1}(x) \\geq 0\n$$"] [17592186192415 :question/problem "Find the inverse of the function $f(x) = \\dfrac{3}{\\sqrt[3]{x}} + 1$."] [17592186192415 :question/worked-solution "To find $f^{-1}(x)$, we start by replacing $f(x)$ with $y{:}$\n\n$$\ny = \\dfrac{3}{\\sqrt[3]{x}} + 1\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx = \\dfrac{3}{\\sqrt[3]{y}} + 1\n$$\n\nThen, we make $y$ the subject of the equation, as follows:\n\n$$\n\\begin{aligned}\nx &= \\frac{3}{\\sqrt[3]{y}} + 1 \\\\\nx - 1 &= \\frac{3}{\\sqrt[3]{y}} \\\\\n\\frac{1}{x - 1} &= \\frac{\\sqrt[3]{y}}{3} \\\\\n\\sqrt[3]{y} &= \\frac{3}{x - 1} \\\\\n(\\sqrt[3]{y})^{3} &= (\\frac{3}{x - 1})^{3} \\\\\ny &= (27)/((x - 1)^{3})\n\\end{aligned}\n$$\n\nTherefore, the inverse function is\n\n$$\nf^{-1}(x) = \\dfrac{27}{(x - 1)^3}\n$$\n\n**Note**: The domain and range of $f(x)$ are\n\n$$\nx\\neq 0, \\qquad f(x)\\neq 1\n$$\n\nTherefore, the domain and range of $f^{-1}(x)$ are\n\n$$\nx\\neq 1, \\qquad f(x)\\neq 0\n$$"] [17592186192403 :question/problem "Find the inverse of the function $f(x) = \\dfrac{1}{5}\\sqrt{4x + 1}$."] [17592186192403 :question/worked-solution "To find $f^{-1}(x)$, we start by replacing $f(x)$ with $y{:}$\n\n$$\ny = \\dfrac{1}{5}\\sqrt{4x + 1}\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx = \\dfrac{1}{5}\\sqrt{4y + 1}\n$$\n\nThen, we make $y$ the subject of the equation as follows:\n\n$$\n\\begin{aligned}\nx &= \\frac{1}{5}\\sqrt{4y + 1} \\\\\n\\sqrt{4y + 1} &= 5x \\\\\n(\\sqrt{4y + 1})^{2} &= (5x)^{2} \\\\\n4y + 1 &= 25x^{2} \\\\\n4y &= 25x^{2} - 1 \\\\\ny &= \\frac{1}{4}(25x^{2} - 1)\n\\end{aligned}\n$$\n\nTherefore, the inverse function is\n\n$$\nf^{-1}(x) = \\dfrac{1}{4}\\left(25x^2 - 1\\right)\n$$\n\n**Note**: The domain and range of $f(x)$ are given by\n\n$$\nx \\geq -\\dfrac14, \\qquad f(x) \\geq 0\n$$\n\nTherefore, the domain and range of $f^{-1}(x)$ are\n\n$$\nx \\geq 0, \\qquad f^{-1}(x) \\geq -\\dfrac14\n$$"] [17592186192404 :question/problem "The function $f(x) = 3\\sqrt{x + k} - 2$ has an inverse function given by $f^{-1}(x) = \\dfrac{1}{9}(x + 2)^2 + 3$. What is the value of $k$?"] [17592186192404 :question/worked-solution "To find $f^{-1}(x)$, we start by replacing $f(x)$ with $y{:}$\n\n$$\ny = 3\\sqrt{x+k} - 2\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx = 3\\sqrt{y + k} - 2\n$$\n\nThen, we make $y$ the subject of the equation as follows:\n\n$$\n\\begin{aligned}\nx &= 3\\sqrt{y + k} - 2 \\\\\n3\\sqrt{y + k} &= x + 2 \\\\\n\\sqrt{y + k} &= \\frac{1}{3}(x + 2) \\\\\n(\\sqrt{y + k})^{2} &= (\\frac{1}{3}(x + 2))^{2} \\\\\ny + k &= \\frac{1}{9}(x + 2)^{2} \\\\\ny &= \\frac{1}{9}(x + 2)^{2} - k\n\\end{aligned}\n$$\n\nTherefore, the inverse function is\n\n$$\nf^{-1}(x) = \\dfrac{1}{9}(x + 2)^2 - k\n$$\n\nComparing our answer with the given expression, we conclude that\n\n$$\n-k = 3 \\qquad \\Longrightarrow \\qquad k = -3\n$$\n\n**Note**: The domain and range of $f(x)$ are given by\n\n$$\nx \\geq 3, \\qquad f(x) \\geq -2\n$$\n\nTherefore, the domain and range of $f^{-1}(x)$ are\n\n$$\nx \\geq -2, \\qquad f^{-1}(x) \\geq3\n$$"] [17592186193001 :question/problem "Find the inverse of the function $f(x) = \\frac{3}{\\sqrt{x}} - 1$."] [17592186189892 :answer-field/choices 17592186189893] [17592186189892 :answer-field/choices 17592186189894] [17592186189892 :answer-field/choices 17592186189895] [17592186189892 :answer-field/choices 17592186189896] [17592186189892 :answer-field/choices 17592186189897] [17592186193013 :question/problem "Find the inverse of the function $f(x) = 3 - \\frac{4}{\\sqrt[3]{x}}$."] [17592186189964 :answer-field/choices 17592186189968] [17592186189964 :answer-field/choices 17592186189969] [17592186189964 :answer-field/choices 17592186189965] [17592186189964 :answer-field/choices 17592186189966] [17592186189964 :answer-field/choices 17592186189967] [17592186193825 :tutorial/content "In this lesson, we'll use our knowledge of solving radical equations to compute inverses of radical functions.\n\nFor example, let's consider the following radical function:\n\n$$\nf(x) = 3\\sqrt{x} + 2\n$$\n\nTo compute the inverse of $f(x)$, we follow the usual four steps:\n\n**Step 1:** First, we replace $f(x)$ with $y$:\n\n$$\ny = 3\\sqrt{x} + 2\n$$\n\n**Step 2:** Then, we swap $x$ and $y$:\n\n$$\nx = 3\\sqrt{y} + 2\n$$\n\n**Step 3:** Next, we solve for $y$:\n\n$$\n\\begin{aligned}\nx &= 3\\sqrt{y} + 2 \\\\\n3\\sqrt{y} &= x - 2 \\\\\n\\sqrt{y} &= \\frac{1}{3}(x - 2) \\\\\n(\\sqrt{y})^{2} &= (\\frac{1}{3}(x - 2))^{2} \\\\\ny &= \\frac{1}{9}(x - 2)^{2}\n\\end{aligned}\n$$\n\n**Step 4:** Finally, we replace $y$ with $f^{-1}(x)$:\n\n$$\nf^{-1}(x) = \\dfrac{1}{9}(x - 2)^2\n$$\n\n**Note**: The domain and range of $f(x)$ are\n\n$$\nx \\geq 0, \\qquad f(x) \\geq 2\n$$\n\nTherefore, the domain and range of $f^{-1}(x)$ are\n\n$$\nx \\geq 2, \\qquad f^{-1}(x) \\geq 0\n$$"]]}]