 "f^{-1}(x) = (64)/((3 - x)^{3})" :db/id #edb/ref 17592186189968} {:answer/id #uuid "7abc0f41-f07d-5f2f-8376-dbc02329de1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f^{-1}(x) = (16)/((3 - x)^{3})" :db/id #edb/ref 17592186189969}] :answer-field/id #uuid "0e4db2ae-6667-5cf8-9f6c-1f35ce6fa735" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186189964}] :question/id #uuid "f4c1cf18-a880-5282-8283-771dcb962b4a" :question/math-academy-id "q-148452" :question/problem "Find the inverse of the function $f(x) = 3 - \\frac{4}{\\sqrt[3]{x}}$."}]}
