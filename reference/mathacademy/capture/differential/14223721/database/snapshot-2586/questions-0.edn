#{[{:db/id #edb/ref 17592186204576 :knowledge-point/_questions [{:db/id #edb/ref 17592186204077 :knowledge-point/id #uuid "d786586f-cacb-5781-86ff-cc8acf311dcf" :knowledge-point/title "Computing the Total Derivative of a Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89ee6b6c-075c-595a-aac5-273cdbc81bb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x" :db/id #edb/ref 17592186203390} {:answer/id #uuid "2c0665a6-5fd8-5a60-a295-8eb83a2e097c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x" :db/id #edb/ref 17592186203394} {:answer/id #uuid "28fad7c5-7710-53c9-96dc-3a22b189fd28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x{x}^{T}" :db/id #edb/ref 17592186538318} {:answer/id #uuid "36ecfad0-45a6-5a26-931b-31fd7b5c023f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{T}x" :db/id #edb/ref 17592186538345} {:answer/id #uuid "ff6fd27f-675e-55fe-8e51-a1443e1cde27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{T}" :db/id #edb/ref 17592186538805}] :answer-field/correct {:answer/id #uuid "ff6fd27f-675e-55fe-8e51-a1443e1cde27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{T}" :db/id #edb/ref 17592186538805} :answer-field/id #uuid "2f5e576a-9d0c-5e63-ad25-093924cf3622" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186203389}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a9b60135-10d8-57c5-ae3d-61cf69876b83" :question/math-academy-id "q-268177" :question/problem "Consider the function $f:{R}^{3}\\to R$ defined by $f(x)={x}^{T}x.$ What is the total derivative of $f$ with respect to $x?$" :question/worked-solution "The total derivative of a scalar-valued function $f:{R}^{n}\\to R$ with respect to a vector $x\\in {R}^{n}$ is the row vector\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=[\\begin{aligned}\\frac{∂f}{∂{x}_{1}} & \\frac{∂f}{∂{x}_{2}} & ⋯ & \\frac{∂f}{∂{x}_{n}}\\end{aligned}]\\in {R}^{1\\times n}.\n$$\n\nIn our case, the function \n\n- acts on a vector $x\\in {R}^{3},$ and\n\n- outputs a scalar $f({x}_{1},{x}_{2},{x}_{3})\\in R$ defined by \n\n$$\nf(x)={x}^{T}x=[\\begin{aligned}{x}_{1} & {x}_{2} & {x}_{3}\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]={x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =[\\begin{aligned}\\frac{∂f}{∂{x}_{1}} & \\frac{∂f}{∂{x}_{2}} & \\frac{∂f}{∂{x}_{3}}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{∂}{∂{x}_{1}}({x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2}) & \\frac{∂}{∂{x}_{2}}({x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2}) & \\frac{∂}{∂{x}_{3}}({x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2})\\end{aligned}] \\\\  & =[\\begin{aligned}2{x}_{1} & 2{x}_{2} & 2{x}_{3}\\end{aligned}]\\in {R}^{1\\times 3}.\\end{aligned}\n$$\n\nWe can also write this as\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=2{x}^{T}.\n$$"}] [{:db/id #edb/ref 17592186204579 :knowledge-point/_questions [{:db/id #edb/ref 17592186204076 :knowledge-point/id #uuid "feb08dad-d927-55f9-8fef-723795030c8c" :knowledge-point/title "Identifying the Shape of a Derivative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "de143918-a5c5-54c6-8191-100ca3eb3d69" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "a scalar" :db/id #edb/ref 17592186203409} {:answer/id #uuid "7fc4f1f8-61e0-5902-87da-4c880d27639d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "a column vector of shape $2\\times 1$" :db/id #edb/ref 17592186538524} {:answer/id #uuid "886bd58a-d2a1-58c4-85bb-21bcd3179800" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "a matrix of shape $1\\times 1$" :db/id #edb/ref 17592186538548} {:answer/id #uuid "89f6a51d-2ad5-50de-abf7-2ae76d9a88e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "a matrix of shape $2\\times 2$" :db/id #edb/ref 17592186538553} {:answer/id #uuid "ec5950a8-970d-5df3-b935-f039ec4c769a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "a row vector of shape $1\\times 2$" :db/id #edb/ref 17592186538772}] :answer-field/correct {:answer/id #uuid "7fc4f1f8-61e0-5902-87da-4c880d27639d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "a column vector of shape $2\\times 1$" :db/id #edb/ref 17592186538524} :answer-field/id #uuid "58e2f6df-668f-58d0-af45-8b0dc73f1847" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186203407}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ab16b06c-77e8-52fd-a1bb-c0353a01d556" :question/math-academy-id "q-268488" :question/problem "Consider the function $f,$ defined as \n\n$$\nf(x)=[\\begin{aligned}{x}^{2} \\\\ x\\end{aligned}].\n$$\n\nWhat is the shape of the total derivative of $f$ with respect to $x?$" :question/worked-solution "The total derivative of a vector-valued function $f:R\\to {R}^{m}$ with respect to a scalar $x$ is the column vector\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=[\\begin{aligned}\\frac{∂{f}_{1}}{∂x} \\\\ \\frac{∂{f}_{2}}{∂x} \\\\ ⋮ \\\\ \\frac{∂{f}_{m}}{∂x}\\end{aligned}]\\in {R}^{m\\times 1}.\n$$\n\nIn our case, the function \n\n- acts on a scalar $x\\in R,$ and\n\n- outputs a vector $f(x)\\in {R}^{2}.$\n\nTherefore, the total derivative will be a column vector of shape $2\\times 1.$"}] [{:db/id #edb/ref 17592186539024 :knowledge-point/_questions [{:db/id #edb/ref 17592186204077 :knowledge-point/id #uuid "d786586f-cacb-5781-86ff-cc8acf311dcf" :knowledge-point/title "Computing the Total Derivative of a Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "014d9c3e-1663-5259-9277-a7bbddf6e2fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 3 \\\\ 4 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186538237} {:answer/id #uuid "34bbe26e-bcba-5583-9c68-b3f83a035eb2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 0 \\\\ -5 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186538339} {:answer/id #uuid "def4b6c6-b6f4-5d5a-8261-aa0965a945ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & -5 & 3\\end{aligned}]" :db/id #edb/ref 17592186538743} {:answer/id #uuid "e11583b8-4e30-5e78-b665-3691a908779c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 3 & 4 & 0\\end{aligned}]" :db/id #edb/ref 17592186538747} {:answer/id #uuid "e681a790-14d2-5d84-85a8-796a2c566dbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}x \\\\ 3x \\\\ -5x \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186538757}] :answer-field/correct {:answer/id #uuid "014d9c3e-1663-5259-9277-a7bbddf6e2fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 3 \\\\ 4 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186538237} :answer-field/id #uuid "c80c0f77-3e67-5a7e-8ad6-7ef450e73970" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186538899}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ee17a4e4-1d8d-5373-a5f7-48bfde731f73" :question/math-academy-id "q-269516" :question/problem "Consider the function $f:R\\to {R}^{4},$ defined by \n\n$$\nf(x)=[\\begin{aligned}1 & 1 \\\\ 3 & 0 \\\\ 4 & -5 \\\\ 0 & 3\\end{aligned}]\\cdot [\\begin{aligned}x \\\\ 2\\end{aligned}].\n$$\n\nWhat is the total derivative of $f$ with respect to $x?$" :question/worked-solution "The total derivative of a vector-valued function $f:R\\to {R}^{m}$ with respect to a scalar $x$ is the column vector\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=[\\begin{aligned}\\frac{∂{f}_{1}}{∂x} \\\\ \\frac{∂{f}_{2}}{∂x} \\\\ ⋮ \\\\ \\frac{∂{f}_{m}}{∂x}\\end{aligned}]\\in {R}^{m\\times 1}.\n$$\n\nIn our case, the function \n\n- acts on a scalar $x\\in R,$ and\n\n- outputs a vector $f(x)\\in {R}^{4}$ defined by \n\n$$\n\\begin{aligned}f(x)=[\\begin{aligned}1 & 1 \\\\ 3 & 0 \\\\ 4 & -5 \\\\ 0 & 3\\end{aligned}]\\cdot [\\begin{aligned}x \\\\ 2\\end{aligned}] & =[\\begin{aligned}x+2 \\\\ 3x \\\\ 4x-10 \\\\ 6\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =[\\begin{aligned}\\frac{∂{f}_{1}}{∂x} \\\\ \\frac{∂{f}_{2}}{∂x} \\\\ \\frac{∂{f}_{3}}{∂x} \\\\ \\frac{∂{f}_{4}}{∂x}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{∂}{∂x}(x+2) \\\\ \\frac{∂}{∂x}(3x) \\\\ \\frac{∂}{∂x}(4x-10) \\\\ \\frac{∂}{∂x}(6)\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 3 \\\\ 4 \\\\ 0\\end{aligned}]\\in {R}^{4\\times 1}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186538967 :knowledge-point/_questions [{:db/id #edb/ref 17592186204077 :knowledge-point/id #uuid "d786586f-cacb-5781-86ff-cc8acf311dcf" :knowledge-point/title "Computing the Total Derivative of a Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17f51f1a-4d67-51a2-a688-b61e6a787b32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 1 \\\\ 0 & 1 & 1 \\\\ 1 & 1 & 0\\end{aligned}]" :db/id #edb/ref 17592186538285} {:answer/id #uuid "2e584046-9915-5986-8dd3-f1cf10ec80b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 1 \\\\ 1 & 0\\end{aligned}]" :db/id #edb/ref 17592186538328} {:answer/id #uuid "4ea1e5d3-2f94-5af0-9b2b-dbe977709a27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186538397} {:answer/id #uuid "52208163-567f-5131-b309-cfa086f0b55e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 1 & 0 \\\\ 1 & 0 & 1 \\\\ 0 & 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186538408} {:answer/id #uuid "ffe8c4b7-c3a3-5549-b3d0-a5b9714b08d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 1 & 0 & 1 \\\\ 0 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186538806}] :answer-field/correct {:answer/id #uuid "52208163-567f-5131-b309-cfa086f0b55e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 1 & 0 \\\\ 1 & 0 & 1 \\\\ 0 & 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186538408} :answer-field/id #uuid "11c166e6-1f28-5e02-9955-3d8f3525359c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186538811}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "67046761-6838-5e5c-bd1f-8e1ae02d3dbf" :question/math-academy-id "q-269555" :question/problem "Consider the vector-valued function $f:{R}^{3}\\to {R}^{3}$ defined by\n\n$$\nf(x)=[\\begin{aligned}1 & 1 & 0 \\\\ 1 & 0 & 1 \\\\ 0 & 1 & 1\\end{aligned}]x.\n$$\n\n \n\nWhat is $\\frac{\\text{d}f}{\\text{d}x},$ the total derivative of $f$ with respect to $x$ at ${x}_{0}=[\\begin{aligned}1 \\\\ 0 \\\\ 2\\end{aligned}]?$" :question/worked-solution "The total derivative of a vector-valued function $f:{R}^{n}\\to {R}^{m}$ with respect to a vector $x\\in {R}^{n}$ is the $m\\times n$ matrix\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=[\\begin{aligned}\\frac{∂{f}_{1}}{∂{x}_{1}} & \\frac{∂{f}_{1}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{1}}{∂{x}_{n}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & \\frac{∂{f}_{2}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{2}}{∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋱ & ⋮ \\\\ \\frac{∂{f}_{m}}{∂{x}_{1}} & \\frac{∂{f}_{m}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{m}}{∂{x}_{n}}\\end{aligned}]\\in {R}^{m\\times n}.\n$$\n\nIn our case, writing out the function $f(x)$ where $x=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]\\in {R}^{3}$, we get\n\n$$\nf(x)=[\\begin{aligned}1 & 1 & 0 \\\\ 1 & 0 & 1 \\\\ 0 & 1 & 1\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]=[\\begin{aligned}{x}_{1}+{x}_{2} \\\\ {x}_{1}+{x}_{3} \\\\ {x}_{2}+{x}_{3}\\end{aligned}].\n$$\n\nSo, the total derivative is\n\n$$\n\\begin{aligned}\\,\\,\\,\\frac{\\text{d}f}{\\text{d}x} & =[\\begin{aligned}\\frac{∂{f}_{1}}{∂{x}_{1}} & \\frac{∂{f}_{1}}{∂{x}_{2}} & \\frac{∂{f}_{1}}{∂{x}_{3}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & \\frac{∂{f}_{2}}{∂{x}_{2}} & \\frac{∂{f}_{2}}{∂{x}_{3}} \\\\ \\frac{∂{f}_{3}}{∂{x}_{1}} & \\frac{∂{f}_{3}}{∂{x}_{2}} & \\frac{∂{f}_{3}}{∂{x}_{3}}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{∂}{∂{x}_{1}}({x}_{1}+{x}_{2}) & \\frac{∂}{∂{x}_{2}}({x}_{1}+{x}_{2}) & \\frac{∂}{∂{x}_{3}}({x}_{1}+{x}_{2}) \\\\ \\frac{∂}{∂{x}_{1}}({x}_{1}+{x}_{3}) & \\frac{∂}{∂{x}_{2}}({x}_{1}+{x}_{3}) & \\frac{∂}{∂{x}_{3}}({x}_{1}+{x}_{3}) \\\\ \\frac{∂}{∂{x}_{1}}({x}_{2}+{x}_{3}) & \\frac{∂}{∂{x}_{2}}({x}_{2}+{x}_{3}) & \\frac{∂}{∂{x}_{3}}({x}_{2}+{x}_{3})\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 1 & 0 \\\\ 1 & 0 & 1 \\\\ 0 & 1 & 1\\end{aligned}].\\end{aligned}\n$$\n\nSince the total derivative is a constant matrix, evaluating it at ${x}_{0}=[\\begin{aligned}1 \\\\ 0 \\\\ 2\\end{aligned}]$ gives the same matrix."}] [{:db/id #edb/ref 17592186538934 :knowledge-point/_questions [{:db/id #edb/ref 17592186204078 :knowledge-point/id #uuid "15fada7f-4a9a-5e72-9699-694e302beef3" :knowledge-point/title "Computing a 3-Tensor Derivative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f6cf4237-3068-5ef2-966f-556a26a2b8cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186538793}] :answer-field/correct {:answer/id #uuid "f6cf4237-3068-5ef2-966f-556a26a2b8cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186538793} :answer-field/id #uuid "496c72b0-90f2-51f5-a462-e8c20d943af2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186538842}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "20f2946c-2b05-548e-8d4f-c195e7f5a6e5" :question/math-academy-id "q-269858" :question/problem "Consider a function $f:{R}^{3\\times 3}\\to {R}^{3}$ defined by\n\n$$\nf(A)=A[\\begin{aligned}2 \\\\ 3 \\\\ -1\\end{aligned}].\n$$\n\nGiven that ${a}_{ij}$ denotes the entry of $A$ in the intersection of the $i$th row and $j$th column, we have\n\n$\\frac{∂{f}_{3}}{∂{a}_{31}}=${{field-1}}." :question/worked-solution "We can write the function $f$ as\n\n$$\nf(A)=[\\begin{aligned}{a}_{11} & {a}_{12} & {a}_{13} \\\\ {a}_{21} & {a}_{22} & {a}_{23} \\\\ {a}_{31} & {a}_{32} & {a}_{33}\\end{aligned}][\\begin{aligned}2 \\\\ 3 \\\\ -1\\end{aligned}]=[\\begin{aligned}2{a}_{11}+3{a}_{12}-{a}_{13} \\\\ 2{a}_{21}+3{a}_{22}-{a}_{23} \\\\ 2{a}_{31}+3{a}_{32}-{a}_{33}\\end{aligned}].\n$$\n\nThus,\n\n$$\n\\frac{∂{f}_{3}}{∂{a}_{31}}=\\frac{∂}{∂{a}_{31}}(2{a}_{31}+3{a}_{32}-{a}_{33})=2.\n$$"}]}
