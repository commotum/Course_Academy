w data-mjx-texclass=\"ORD\"><mi>t</mi><mo>∈</mo><mi>T</mi></mrow></munder><mi>h</mi><mo stretchy=\"false\">(</mo><mi>t</mi><mo stretchy=\"false\">)</mo></mtd><mtd><mi></mi><mo>=</mo><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mn>4</mn></mpadded></mstyle></mtd></mtr><mtr><mtd><mi>arg</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><munder><mo data-mjx-texclass=\"OP\" movablelimits=\"true\">max</mo><mrow data-mjx-texclass=\"ORD\"><mi>t</mi><mo>∈</mo><mi>T</mi></mrow></munder><mi>h</mi><mo stretchy=\"false\">(</mo><mi>t</mi><mo stretchy=\"false\">)</mo></mtd><mtd><mi></mi><mo>=</mo><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mn>2</mn></mpadded></mstyle></mtd></mtr><mtr><mtd><munder><mo data-mjx-texclass=\"OP\" movablelimits=\"true\">min</mo><mrow data-mjx-texclass=\"ORD\"><mi>t</mi><mo>∈</mo><mi>T</mi></mrow></munder><mi>h</mi><mo stretchy=\"false\">(</mo><mi>t</mi><mo stretchy=\"false\">)</mo></mtd><mtd><mi></mi><mo>=</mo><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mo>−</mo><mn>5</mn></mpadded></mstyle></mtd></mtr><mtr><mtd><mi>arg</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><munder><mo data-mjx-texclass=\"OP\" movablelimits=\"true\">min</mo><mrow data-mjx-texclass=\"ORD\"><mi>t</mi><mo>∈</mo><mi>T</mi></mrow></munder><mi>h</mi><mo stretchy=\"false\">(</mo><mi>t</mi><mo stretchy=\"false\">)</mo></mtd><mtd><mi></mi><mo>=</mo><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mn>0</mn></mpadded></mstyle></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
