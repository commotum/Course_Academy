x\\in T}h(x)=-3$ and $\\operatorname{arg}⁡{min}_{x\\in T}h(x)=0.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-0aad743d-8ba5-5337-80cb-c78474745b6a" "answer-field-f483d2df-b9cf-50d1-a630-f22f82aee20c" "answer-field-d02bb7c5-371d-5577-8733-d6381c78836f" "answer-field-8d978aec-9e8e-54a6-b0e9-0ee9ab40c5a2"] :db/ensure [:question/validate]} {:db/id "answer-field-0aad743d-8ba5-5337-80cb-c78474745b6a" :answer-field/id #uuid "0aad743d-8ba5-5337-80cb-c78474745b6a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-4aedb0ca-c06b-5df2-b475-a620f0810e2e" :answer-field/choices ["answer-4aedb0ca-c06b-5df2-b475-a620f0810e2e"] :db/ensure [:answer-field/validate]} {:db/id "answer-4aedb0ca-c06b-5df2-b475-a620f0810e2e" :answer/id #uuid "4aedb0ca-c06b-5df2-b475-a620f0810e2e" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-field-f483d2df-b9cf-50d1-a630-f22f82aee20c" :answer-field/id #uuid "f483d2df-b9cf-50d1-a630-f22f82aee20c" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-8b240ae8-8138-51da-9cc2-e69a75cf9aed" :answer-field/choices ["answer-8b240ae8-8138-51da-9cc2-e69a75cf9aed"] :db/ensure [:answer-field/validate]} {:db/id "answer-8b240ae8-8138-51da-9cc2-e69a75cf9aed" :answer/id #uuid "8b240ae8-8138-51da-9cc2-e69a75cf9aed" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-field-d02bb7c5-371d-5577-8733-d6381c78836f" :answer-field/id #uuid "d02bb7c5-371d-5577-8733-d6381c78836f" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-11ddc8d5-5d4c-5727-9340-5fb584443922" :answer-field/choices ["answer-11ddc8d5-5d4c-5727-9340-5fb584443922"] :db/ensure [:answer-field/validate]} {:db/id "answer-11ddc8d5-5d4c-5727-9340-5fb584443922" :answer/id #uuid "11ddc8d5-5d4c-5727-9340-5fb584443922" :answer/type :answer.t