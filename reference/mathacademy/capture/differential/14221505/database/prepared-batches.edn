s.\n\nFrom the graph, \n\n- the highest point is at $(2,4),$ so ${max}_{x\\in T}h(x)=4$ and $\\operatorname{arg}⁡{max}_{x\\in T}h(x)=2,$ and\n\n- the lowest point is at $(5,-2),$ so ${min}_{x\\in T}h(x)=-2$ and $\\operatorname{arg}⁡{min}_{x\\in T}h(x)=5.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-02686e7f-48fb-5be5-bdbc-2e1c7deb0939" "answer-field-4b1234e0-949a-50d8-8a34-df59659598ff" "answer-field-62c68636-e279-5a7b-8a47-28d02a3afd70" "answer-field-642b339b-e6ee-5ad6-9bcb-89daeb22fd8d"] :db/ensure [:question/validate]} {:db/id "answer-field-02686e7f-48fb-5be5-bdbc-2e1c7deb0939" :answer-field/id #uuid "02686e7f-48fb-5be5-bdbc-2e1c7deb0939" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-aec0c41c-9ba4-59fb-a65f-771034554fe8" :answer-field/choices ["answer-aec0c41c-9ba4-59fb-a65f-771034554fe8"] :db/ensure [:answer-field/validate]} {:db/id "answer-aec0c41c-9ba4-59fb-a65f-771034554fe8" :answer/id #uuid "aec0c41c-9ba4-59fb-a65f-771034554fe8" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-field-4b1234e0-949a-50d8-8a34-df59659598ff" :answer-field/id #uuid "4b1234e0-949a-50d8-8a34-df59659598ff" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-024ad5dc-d6eb-508f-afba-e6473a82a0ac" :answer-field/choices ["answer-024ad5dc-d6eb-508f-afba-e6473a82a0ac"] :db/ensure [:answer-field/validate]} {:db/id "answer-024ad5dc-d6eb-508f-afba-e6473a82a0ac" :answer/id #uuid "024ad5dc-d6eb-508f-afba-e6473a82a0ac" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-field-62c68636-e279-5a7b-8a47-28d02a3afd70" :answer-field/id #uuid "62c68636-e279-5a7b-8a47-28d02a3afd70" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-8a606945-efd4-5d0a-a61f-1f56b1be5ee1" :answer-field/choices ["answer-8a606945-efd4-5d0a