#{[{:activity/first-step {:db/id #edb/ref 17592186111649} :activity/id #uuid "f0ccfa97-349a-51e7-8c3e-2b151be71120" :activity/scope {:db/id #edb/ref 17592186048787 :topic/id #uuid "bee6b4ad-7bf3-5c2d-82dc-c00a53e573bb" :topic/math-academy-id 1472} :activity/steps [{:db/id #edb/ref 17592186111649 :step/content {:db/id #edb/ref 17592186111905 :tutorial/content "Suppose we have the transformed exponential function\n\n$$\nf(x)=2^{5x}+1\n$$\n\nand we wish to find the inverse function $f^{-1}(x)$. We can do this using the following three steps.\n\n**Step 1:** We start by replacing $f(x)$ with $y$:\n\n$$\n\\begin{aligned}\ny &= 2^{5x} + 1\n\\end{aligned}\n$$\n\n**Step 2:** Then, we interchange $x$ and $y$:\n\n$$\n\\begin{aligned}\nx &= 2^{5y} + 1\n\\end{aligned}\n$$\n\n**Step 3:** Finally, we make $y$ the subject of the equation:\n\n$$\n\\begin{aligned}\nx &= 2^{5y} + 1 \\\\\nx - 1 &= 2^{5y} \\\\\n\\log_{2} (x - 1) &= \\log_{2} (2^{5y}) \\\\\n\\log_{2} (x - 1) &= 5y \\\\\n5y &= \\log_{2} (x - 1) \\\\\ny &= \\frac{1}{5}\\log_{2} (x - 1)\n\\end{aligned}\n$$\n\nTherefore, the inverse function is\n\n$$\nf^{-1}(x) = \\dfrac{1}{5}\\log_2{(x-1)}\n$$" :tutorial/id #uuid "dc5609e8-50a8-59fe-af6c-4cfc16ccc454" :tutorial/math-academy-id 6516 :tutorial/title "Introduction"} :step/id #uuid "27fb8a99-b935-578a-a9a7-3c26c121777d" :step/math-academy-id 458787 :step/next {:db/id #edb/ref 17592186111650}} {:db/id #edb/ref 17592186111650 :step/content {:db/id #edb/ref 17592186110700 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110501 :question/id #uuid "2b08436f-c561-59c5-bb79-621a1780b470" :question/math-academy-id "e-4128"} :knowledge-point/id #uuid "c01b24c5-c253-5a11-8055-9be0d60da592" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049053} {:db/id #edb/ref 17592186050322} {:db/id #edb/ref 17592186050649}] :knowledge-point/questions [{:db/id #edb/ref 17592186110917} {:db/id #edb/ref 17592186110983}] :knowledge-point/title "Finding Inverses of Exponential Functions With Up to Two Transformations"} :step/id #uuid "91aff0b1-b90e-5801-8592-dc12106afede" :step/math-academy-id 458788 :step/next {:db/id #edb/ref 17592186111651}} {:db/id #edb/ref 17592186111651 :step/content {:db/id #edb/ref 17592186110701 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110289 :question/id #uuid "09634460-21c4-5389-92f4-15339282b7ff" :question/math-academy-id "e-10455"} :knowledge-point/id #uuid "bfadce43-b527-59fc-b6c7-ec963bb543b4" :knowledge-point/questions [{:db/id #edb/ref 17592186110918} {:db/id #edb/ref 17592186110919} {:db/id #edb/ref 17592186110984}] :knowledge-point/title "Finding Inverses of Exponential Functions With More Than Two Transformations"} :step/id #uuid "027efb8b-b7f4-57c3-9b47-e73dfdc14471" :step/math-academy-id 458791 :step/next {:db/id #edb/ref 17592186111652}} {:db/id #edb/ref 17592186111652 :step/content {:db/id #edb/ref 17592186111881 :tutorial/content "Now suppose we wish to find the inverse of the logarithmic function\n\n$$\nf(x)=3\\log_{2}(x-1)+1\n$$\n\nWe can find $f^{-1}(x)$ using the same three steps as before.\n\n**Step 1:** We start by replacing $f(x)$ with $y{:}$\n\n$$\ny = 3\\log_{2}(x-1)+1\n$$\n\n**Step 2:** Then, we interchange $x$ and $y$:\n\n$$\nx = 3\\log_{2}(y-1)+1\n$$\n\n**Step 3:** Finally, we make $y$ the subject of the equation:\n\n$$\n\\begin{aligned}\n3\\log_{2} (y - 1) + 1 &= x \\\\\n3\\log_{2} (y - 1) &= x - 1 \\\\\n\\log_{2} (y - 1) &= \\frac{x - 1}{3} \\\\\n2^{\\log_{2} (y - 1)} &= 2^{(x - 1)/3} \\\\\ny - 1 &= 2^{(x - 1)/3} \\\\\ny &= 2^{(x - 1)/3} + 1\n\\end{aligned}\n$$\n\nTherefore, the inverse function is\n\n$$\nf^{-1}(x) = {2}^{(x-1)/3}+1\n$$" :tutorial/id #uuid "cf6e7706-d6b7-5b75-ac3f-184a71b3330a" :tutorial/math-academy-id 2818 :tutorial/title "Finding the Inverse of a Transformed Logarithmic Function"} :step/id #uuid "2d5c352f-41f8-5a6a-bb13-3c7b0d3b54e8" :step/math-academy-id 458795 :step/next {:db/id #edb/ref 17592186111653}} {:db/id #edb/ref 17592186111653 :step/content {:db/id #edb/ref 17592186110702 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110500 :question/id #uuid "fc54368a-099e-5b85-a6c4-15db9be3ee8f" :question/math-academy-id "e-4127"} :knowledge-point/id #uuid "2efb7d6d-25e9-5bf3-b2b3-5085221b0e76" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048741} {:db/id #edb/ref 17592186049944}] :knowledge-point/questions [{:db/id #edb/ref 17592186111045} {:db/id #edb/ref 17592186111209}] :knowledge-point/title "Finding Inverses of Logarithmic Functions With Up to Two Transformations"} :step/id #uuid "54971f0b-36de-5930-a669-5c88c032a9cb" :step/math-academy-id 458796 :step/next {:db/id #edb/ref 17592186111654}} {:db/id #edb/ref 17592186111654 :step/content {:db/id #edb/ref 17592186110703 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110502 :question/id #uuid "c6d0d3ad-111a-5db1-b521-0c9416dfb6b8" :question/math-academy-id "e-4140"} :knowledge-point/id #uuid "a220ac5f-7b5c-59ef-82d5-aa84654f9fc2" :knowledge-point/questions [{:db/id #edb/ref 17592186110985} {:db/id #edb/ref 17592186111404}] :knowledge-point/title "Finding Inverses of Logarithmic Functions With More Than Two Transformations"} :step/id #uuid "3b1ca6f9-7082-5953-a9d6-ea4f7272ccd1" :step/math-academy-id 458799}] :activity/title "Inverses of Exponential and Logarithmic Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186110841}]}
