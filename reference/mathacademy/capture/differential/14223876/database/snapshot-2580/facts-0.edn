45417] [17592186050649 #edb/ref 1027 #edb/ref 17592186048787 #edb/ref 17592186045417] [17592186050649 #edb/ref 1027 #edb/ref 17592186049095 #edb/ref 17592186045417] [17592186050649 #edb/ref 1027 #edb/ref 17592186049527 #edb/ref 17592186045417] [17592186050649 #edb/ref 1027 #edb/ref 17592186050209 #edb/ref 17592186045417] [17592186050649 #edb/ref 1027 #edb/ref 17592186050797 #edb/ref 17592186045417] [17592186050649 #edb/ref 1027 #edb/ref 17592186051065 #edb/ref 17592186045417] [17592186050649 #edb/ref 1028 #edb/ref 17592186087689 #edb/ref 17592186045417] [17592186050649 #edb/ref 1028 #edb/ref 17592186087690 #edb/ref 17592186045417] [17592186050649 #edb/ref 1028 #edb/ref 17592186087691 #edb/ref 17592186045417] [17592186050649 #edb/ref 1029 #edb/ref 17592186429668 #edb/ref 17592186045436] [17592186050649 #edb/ref 1029 #edb/ref 17592186429669 #edb/ref 17592186045436] [17592186050649 #edb/ref 1029 #edb/ref 17592186429670 #edb/ref 17592186045436] [17592186050649 #edb/ref 1031 "Solving Equations Containing the Exponential Function" #edb/ref 17592186045417] [17592186050649 #edb/ref 1033 870 #edb/ref 17592186045417] [17592186050649 #edb/ref 1035 #uuid "5c4bc59d-ac0f-5225-a803-5b20b7524274" #edb/ref 17592186045417] [17592186107628 #edb/ref 1075 #edb/ref 17592186537646 #edb/ref 17592186045417] [17592186107628 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186107628 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186107628 #edb/ref 1078 #edb/ref 17592186537646 #edb/ref 17592186045417] [17592186107628 #edb/ref 1079 #uuid "d7396d89-4bc9-5ba9-b9b1-12012d5351ed" #edb/ref 17592186045417] [17592186110289 #edb/ref 1069 "e-10455" #edb/ref 17592186045417] [17592186110289 #edb/ref 1071 "Find the inverse of the function $f(x) = \\dfrac12 e^{x+8}-2.$" #edb/ref 17592186045417] [17592186110289 #edb/ref 1072 #uuid "09634460-21c4-5389-92f4-15339282b7ff" #edb/ref 17592186045417] [17592186110289 #edb/ref 1074 "To find $f^{-1}(x),$ we start by replacing $f(x)$ with $y\\mathbin{:}$\n\n$$\n\\begin{aligned}y & =\\frac{1}{2}{e}^{x+8}-2\\end{aligned}\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\n\\begin{aligned}x & =\\frac{1}{2}{e}^{y+8}-2.\\end{aligned}\n$$\n\nFinally, we make $y$ the subject of the equation, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{1}{2}{e}^{y+8}-2 \\\\ \\frac{1}{2}{e}^{y+8} & =x+2 \\\\ {e}^{y+8} & =2x+4 \\\\ \\operatorname{ln}⁡({e}^{y+8}) & =\\operatorname{ln}⁡(2x+4) \\\\ y+8 & =\\operatorname{ln}⁡(2x+4) \\\\ y & =\\operatorname{ln}⁡(2x+4)-8\\end{aligned}\n$$\n\n     \n\nTherefore, the inverse function is $f^{-1}(x) = \\ln{(2x+4)} - 8.$" #edb/ref 17592186045417] [17592186110500 #edb/ref 1069 "e-4127" #edb/ref 17592186045417] [17592186110500 #edb/ref 1071 "What is the inverse of $f(x) =\\ln(x+3)+6?$" #edb/ref 17592186045417] [17592186110500 #edb/ref 1072 #uuid "fc54368a-099e-5b85-a6c4-15db9be3ee8f" #edb/ref 17592186045417] [17592186110500 #edb/ref 1074 "To find $f^{-1}(x),$ we start by replacing $f(x)$ with $y\\mathbin{:}$\n\n$$\ny = \\ln(x+3)+6\n$$\n\nThen, we swap $x$ and $y{:}$\n\n$$\n\\begin{aligned}x & =\\operatorname{ln}⁡(y+3)+6\\end{aligned}\n$$\n\nFinally, we make $y$ the subject of the equation, as follows:\n\n$$\n\\begin{aligned}x & =\\operatorname{ln}⁡(y+3)+6 \\\\ \\operatorname{ln}⁡(y+3) & =x-6 \\\\ {e}^{\\operatorname{ln}⁡(y+3)} & ={e}^{x-6} \\\\ y+3 & ={e}^{x-6} \\\\ y & ={e}^{x-6}-3\\end{aligned}\n$$\n\n    \n\nTherefore, the inverse function is $f^{-1}(x) = e^{x-6}-3.$" #edb/ref 17592186045417] [17592186110501 #edb/ref 1069 "e-4128" #edb/ref 17592186045417] [17592186110501 #edb/ref 1071 "The function $f(x) = e^{x-k}+2$ has an inverse function given by $f^{-1}(x) = \\ln{(x-2)}+4.$ What is the value of $k?$" #edb/ref 17592186045417] [17592186110501 #edb/ref 1072 #uuid "2b08436f-c561-59c5-bb79-621a1780b470" #edb/ref 17592186045417] [17592186110501 #edb/ref 1074 "To find $f^{-1}(x),$ we start by replacing $f(x)$ with $y\\mathbin{:}$\n\n$$\n\\begin{aligned}y & ={e}^{x-k}+2\\end{aligned}\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\n\\begin{aligned}x & ={e}^{y-k}+2.\\end{aligned}\n$$\n\nFinally, we make $y$ the subject of the equation, as follows:\n\n$$\n\\begin{aligned}x & ={e}^{y-k}+2 \\\\ {e}^{y-k} & =x-2 \\\\ \\operatorname{ln}⁡({e}^{y-k}) & =\\operatorname{ln}⁡(x-2) \\\\ y-k & =\\operatorname{ln}⁡(x-2) \\\\ y & =\\operatorname{ln}⁡(x-2)+k\\end{aligned}\n$$\n\n    \n\nTherefore, the inverse function is $f^{-1}(x) = \\ln{(x-2)} + k.$\n\nComparing our answer with the given expression, we conclude that $k=4.$" #edb/ref 17592186045417] [17592186110502 #edb/ref 1069 "e-4140" #edb/ref 17592186045417] [17592186110502 #edb/ref 1071 "What is the inverse of $f(x) = 2\\log_4(3x)-1?$" #edb/ref 17592186045417] [17592186110502 #edb/ref 1072 #uuid "c6d0d3ad-111a-5db1-b521-0c9416dfb6b8" #edb/ref 17592186045417] [17592186110502 #edb/ref 1074 "To find $f^{-1}(x),$ we start by replacing $f(x)$ with $y\\mathbin{:}$\n\n$$\n\\begin{aligned}y & =2{log}_{4}⁡(3x)-1\\end{aligned}\n$$\n\nThen, we swap $x$ and $y{:}$\n\n$$\n\\begin{aligned}x & =2{log}_{4}⁡(3y)-1\\end{aligned}\n$$\n\nFinally, we make $y$ the subject of the equation, as follows:\n\n$$\n\\begin{aligned}x & =2{log}_{4}⁡(3y)-1 \\\\ 2{log}_{4}⁡(3y) & =x+1 \\\\ {log}_{4}⁡(3y) & =\\frac{x+1}{2} \\\\ {4}^{{log}_{4}⁡(3y)} & ={4}^{(x+1)/2} \\\\ 3y & ={4}^{(x+1)/2} \\\\ y & =\\frac{1}{3}{4}^{(x+1)/2}\\end{aligned}\n$$\n\n    \n\nTherefore, the inverse function is $f^{-1}(x) =\\dfrac13 4^{(x+1)/2}.$" #edb/ref 17592186045417] [17592186110700 #edb/ref 1037 #edb/ref 17592186049053 #edb/ref 17592186045417] [17592186110700 #edb/ref 1037 #edb/ref 17592186050322 #edb/ref 17592186045417] [17592186110700 #edb/ref 1037 #edb/ref 17592186050649 #edb/ref 17592186045417] [17592186110700 #edb/ref 1038 #edb/ref 17592186110917 #edb/ref 17592186045417] [17592186110700 #edb/ref 1038 #edb/ref 17592186110983 #edb/ref 17592186045417] [17592186110700 #edb/ref 1038 #edb/ref 17592186537918 #edb/ref 17592186045417] [17592186110700 #edb/ref 1038 