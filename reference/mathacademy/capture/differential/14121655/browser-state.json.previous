ptlevel=\"0\"><mfrac><mrow><msup><mn>9</mn><mrow data-mjx-texclass=\"ORD\"><mn>4</mn></mrow></msup><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>9</mn></mrow></msup></mrow><mrow><mn>4</mn><mo>!</mo></mrow></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>≈</mo><mn>0.055</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container>\nrounded to <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"133\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c33\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn></math></mjx-assistive-mml></mjx-container> decimal places.</p>\n</div></div>",
