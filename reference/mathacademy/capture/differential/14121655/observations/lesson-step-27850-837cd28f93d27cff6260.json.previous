524Q69 579 117 622T233 665Q268 665 277 664Q351 652 390 611T430 522Q430 470 396 421T302 350L299 348Q299 347 308 345T337 336T375 315Q457 262 457 175Q457 96 395 37T238 -22Q158 -22 100 21T42 130Q42 158 60 175T105 193Q133 193 151 175T169 130Q169 119 166 110T159 94T148 82T136 74T126 70T118 67L114 66Q165 21 238 21Q293 21 321 74Q338 107 338 175V195Q338 290 274 322Q259 328 213 329L171 330L168 332Q166 335 166 348Q166 366 174 366Q202 366 232 371Q266 376 294 413T322 525V533Q322 590 287 612Q265 626 240 626Q208 626 181 615T143 592T132 580H135Q138 579 143 578T153 573T165 566T175 555T183 540T186 520Q186 498 172 481T127 463Z\"></path>\n<path stroke-width=\"1\" id=\"E3-MJMAIN-2026\" d=\"M78 60Q78 84 95 102T138 120Q162 120 180 104T199 61Q199 36 182 18T139 0T96 17T78 60ZM525 60Q525 84 542 102T585 120Q609 120 627 104T646 61Q646 36 629 18T586 0T543 17T525 60ZM972 60Q972 84 989 102T1032 120Q1056 120 1074 104T1093 61Q1093 36 1076 18T1033 0T990 17T972 60Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E3-MJMATHI-66\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMAIN-28\" x=\"550\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMATHI-78\" x=\"940\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMAIN-29\" x=\"1512\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMAIN-3D\" x=\"2179\" y=\"0\"></use>\n<g transform=\"translate(3236,0)\">\n<g transform=\"translate(120,0)\">\n<rect stroke=\"none\" width=\"2737\" height=\"60\" x=\"0\" y=\"220\"></rect>\n<g transform=\"translate(60,676)\">\n <use xlink:href=\"#E3-MJMATHI-3BB\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E3-MJMATHI-78\" x=\"825\" y=\"513\"></use>\n<g transform=\"translate(1088,0)\">\n <use xlink:href=\"#E3-MJMATHI-65\" x=\"0\" y=\"0\"></use>\n<g transform=\"translate(466,362)\">\n <use transform=\"scale(0.707)\" xlink:href=\"#E3-MJMAIN-2212\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink: