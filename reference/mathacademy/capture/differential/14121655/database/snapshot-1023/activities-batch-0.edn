592186157310 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157114 :question/id #uuid "ae98c2fc-bfb5-5f5d-bfce-f536aa42e5d3" :question/math-academy-id "e-7496"} :knowledge-point/id #uuid "73b026df-b888-5e60-b448-c239cd3e05cd" :knowledge-point/questions [{:db/id #edb/ref 17592186157860} {:db/id #edb/ref 17592186157861} {:db/id #edb/ref 17592186419531} {:db/id #edb/ref 17592186419545} {:db/id #edb/ref 17592186419546} {:db/id #edb/ref 17592186419547}] :knowledge-point/title "Computing the Probability of a Poisson Random Variable on a Bounded Interval"} :step/id #uuid "4b44c854-917d-5ba0-b5a2-d41308ca5256" :step/math-academy-id 27840 :step/next {:db/id #edb/ref 17592186158158}} {:db/id #edb/ref 17592186158158 :step/content {:db/id #edb/ref 17592186157311 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157115 :question/id #uuid "5be23338-73b5-50b5-8dc8-0aa6d264afb1" :question/math-academy-id "e-7497"} :knowledge-point/id #uuid "12ffe541-9864-5d3f-92d0-8cc32d05b44f" :knowledge-point/questions [{:db/id #edb/ref 17592186157862} {:db/id #edb/ref 17592186157863} {:db/id #edb/ref 17592186419534} {:db/id #edb/ref 17592186419537} {:db/id #edb/ref 17592186419543}] :knowledge-point/title "Computing the Probability of a Poisson Random Variable on an Unbounded Interval"} :step/id #uuid "61e344b0-9976-54f7-a03c-175fe1505fbb" :step/math-academy-id 27841} {:db/id #edb/ref 17592186158167 :step/content {:db/id #edb/ref 17592186158491 :tutorial/content "A **Poisson distribution** is a probability distribution that models the number of events that occur in an interval of time or space if events occur independently and at a constant average rate.\n\nIf the rate of the events is $\\lambda,$ then the number of events $x$ occurring in an interval of fixed length has the following probability mass function:\n\n$$\nf(x) = \\dfrac{\\lambda^x e^{-\\lambda}}{x!}, \\qquad x=0,1,2,3, \\ldots\n$$\n\nIf a random variable $X$ follows a Poisson distribution with rate $\\lambda,$ then we write $X \\sim \\textrm{Po}(\\lambda).$\n\nFor example, suppose that calls come in at an average rate of $3$ calls per minute at a call center. Then the number of calls $X$ that are received during the next minute has the following probability mass function:\n\n$$\nf(x) = \\dfrac{3^x e^{-3}}{x!}\n$$\n\nIn particular, the probability of receiving $4$ calls during the next minute is\n\n$$\n\\begin{aligned}P(X=4) & =f(4) \\\\  & =\\frac{{3}^{4}{e}^{-3}}{4!} \\\\  & ≈0.168\\end{aligned}\n$$\n\nrounded to $3$ decimal places." :tutorial/id #uuid "6e07ef85-f3ca-52c8-89e2-062d8ea7c9eb" :tutorial/math-academy-id 4525 :tutorial/title "Introduction"} :step/id #uuid "fd4dd871-25f7-54f5-9345-a556f2356cb0" :step/math-academy-id 27850 :step/next {:db/id #edb/ref 17592186158170}} {:db/id #edb/ref 17592186158170 :step/content {:db/id #edb/ref 17592186158493 :tutorial/content "The shape of the graph of the Poisson distribution depends on the value of $\\lambda.$ When $\\lambda$ is small, the probability is concentrated at small values of $x.$ When $\\lambda$ is larger, the probability is concentrated at larger values of $x.$\n\n![](images/a8/a8af371733bd248a4e5ba3bc35199f00414188e9ca033a04dee2a7de4b0a7db4.png)" :tutorial/id #uuid "f0026198-16d4-5332-9f5b-036bd00ef32d" :tutorial/math-academy-id 4534 :tutorial/title "The Graph of the Poisson Distribution"} :step/id #uuid "3576e13c-4960-5e5a-b072-2acaff8161cf" :step/math-academy-id 27932 :step/next {:db/id #edb/ref 17592186158155}}] :activity/title "Modeling With the Poisson Distribution" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186157493}]}
