 1 & 0 & 3 & 0 & 0 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & 1 & 0 & 0 \\\\ 0 & 1 & 0 & -2 & 1 & 0 \\\\ 1 & 0 & 3 & 0 & 0 & 1\\end{aligned}] & {R}_{3} & :=\\text{___________} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & 1 & 0 & 0 \\\\ 0 & 1 & 0 & -2 & 1 & 0 \\\\ 0 & 0 & 3 & -1 & 0 & 1\\end{aligned}] & {R}_{3} & :=\\text{___________} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & 1 & 0 & 0 \\\\ 0 & 1 & 0 & -2 & 1 & 0 \\\\ 0 & 0 & 1 & -\\frac{1}{3} & 0 & \\frac{1}{3}\\end{aligned}]\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186515556 #edb/ref 1072 #uuid "6a105b77-6c71-5c3c-96b1-ba828bd44a61" #edb/ref 17592186045417] [17592186515556 #edb/ref 1074 "We write down $G$ and the identity matrix $I$ side-by-side (as shown below) and apply the standard Gauss-Jordan method to transform the matrix $G$ into the identity matrix. We perform the same row operations on both matrices:\n\n$$\n\\begin{aligned}[G\\,|\\,I] & =[\\begin{aligned}1 & 0 & 0 & 1 & 0 & 0 \\\\ 2 & 1 & 0 & 0 & 1 & 0 \\\\ 1 & 0 & 3 & 0 & 0 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & 1 & 0 & 0 \\\\ 0 & 1 & 0 & -2 & 1 & 0 \\\\ 1 & 0 & 3 & 0 & 0 & 1\\end{aligned}] & {R}_{3} & :={R}_{3}-{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & 1 & 0 & 0 \\\\ 0 & 1 & 0 & -2 & 1 & 0 \\\\ 0 & 0 & 3 & -1 & 0 & 1\\end{aligned}] & {R}_{3} & :=\\frac{1}{3}{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & 1 & 0 & 0 \\\\ 0 & 1 & 0 & -2 & 1 & 0 \\\\ 0 & 0 & 1 & -\\frac{1}{3} & 0 & \\frac{1}{3}\\end{aligned}]\\end{aligned}\n$$\n\nThe corresponding row operations are\n\n$$\n{R}_{3}:={R}_{3}-{R}_{1},\\,{R}_{3}:=\\frac{1}{3}{R}_{3}.\n$$\n\nThe matrix ${G}^{-1}$ is given by the right-hand side of our big matrix after all of the transformations have been completed. Therefore, \n\n$$\n{G}^{-1}=[\\begin{aligned}1 & 0 & 0 \\\\ -2 & 1 & 0 \\\\ -\\frac{1}{3} & 0 & \\frac{1}{3}\\end{aligned}].\n$$" #edb/ref 17592186045417] [17592186515574 #edb/ref 1068 #edb/ref 175921865