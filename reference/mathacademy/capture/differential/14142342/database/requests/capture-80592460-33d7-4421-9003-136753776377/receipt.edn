21 17592186045417 true] [17592186437080 1082 #edb/ref 17592186045498 13194139534821 17592186045417 true] [17592186437080 1083 #uuid "9507cee6-c36c-51c1-88e0-630f702efac1" 13194139534821 17592186045417 true] [17592186437081 1080 "a=2,\\,b=1" 13194139534821 17592186045417 true] [17592186437081 1082 #edb/ref 17592186045498 13194139534821 17592186045417 true] [17592186437081 1083 #uuid "b2e70829-198b-5fba-9007-e3b43ddb0346" 13194139534821 17592186045417 true] [17592186437082 1080 "6" 13194139534821 17592186045417 true] [17592186437082 1082 #edb/ref 17592186045498 13194139534821 17592186045417 true] [17592186437082 1083 #uuid "b3d39e69-ac71-52bc-b3fa-32d9dee16b58" 13194139534821 17592186045417 true] [17592186437083 1080 "a=-3,\\,b=2" 13194139534821 17592186045417 true] [17592186437083 1082 #edb/ref 17592186045498 13194139534821 17592186045417 true] [17592186437083 1083 #uuid "e269130c-3006-5fed-9abb-a6de955d0350" 13194139534821 17592186045417 true] [17592186437084 1080 "-28" 13194139534821 17592186045417 true] [17592186437084 1082 #edb/ref 17592186045498 13194139534821 17592186045417 true] [17592186437084 1083 #uuid "ed3fd222-7c6c-5f15-a429-78af9dfec4a2" 13194139534821 17592186045417 true] [17592186437085 1075 #edb/ref 17592186437073 13194139534821 17592186045417 true] [17592186437085 1075 #edb/ref 17592186437077 13194139534821 17592186045417 true] [17592186437085 1075 #edb/ref 17592186437080 13194139534821 17592186045417 true] [17592186437085 1075 #edb/ref 17592186437082 13194139534821 17592186045417 true] [17592186437085 1075 #edb/ref 17592186437084 13194139534821 17592186045417 true] [17592186437085 1076 #edb/ref 17592186045493 13194139534821 17592186045417 true] [17592186437085 1077 "selection" 13194139534821 17592186045417 true] [17592186437085 1078 #edb/ref 17592186437073 13194139534821 17592186045417 true] [17592186437085 1079 #uuid "61f81261-3e5b-587f-b2ff-a3f22db029b7" 13194139534821 17592186045417 true] [17592186437086 1075 #edb/ref 17592186437074 13194139534821 17592186045417 true] [17592186437086 1075 #edb/ref 17592186437075 13194139534821 17592186045417 true] [17592186437086 1075 #edb/ref 17592186437076 13194139534821 17592186045417 true] [17592186437086 1075 #edb/ref 17592186437079 13194139534821 17592186045417 true] [17592186437086 1075 #edb/ref 17592186437083 13194139534821 17592186045417 true] [17592186437086 1076 #edb/ref 17592186045493 13194139534821 17592186045417 true] [17592186437086 1077 "selection" 13194139534821 17592186045417 true] [17592186437086 1078 #edb/ref 17592186437075 13194139534821 17592186045417 true] [17592186437086 1079 #uuid "6a912a37-363a-53e6-bf86-dbe48185fc08" 13194139534821 17592186045417 true] [17592186437087 1075 #edb/ref 17592186437070 13194139534821 17592186045417 true] [17592186437087 1075 #edb/ref 17592186437071 13194139534821 17592186045417 true] [17592186437087 1075 #edb/ref 17592186437072 13194139534821 17592186045417 true] [17592186437087 1075 #edb/ref 17592186437078 13194139534821 17592186045417 true] [17592186437087 1075 #edb/ref 17592186437081 13194139534821 17592186045417 true] [17592186437087 1076 #edb/ref 17592186045493 13194139534821 17592186045417 true] [17592186437087 1077 "selection" 13194139534821 17592186045417 true] [17592186437087 1078 #edb/ref 17592186437071 13194139534821 17592186045417 true] [17592186437087 1079 #uuid "843bf297-f481-59fb-a7e7-1153b03b247c" 13194139534821 17592186045417 true] [17592186437088 1068 #edb/ref 17592186437085 13194139534821 17592186045417 true] [17592186437088 1069 "q-133394" 13194139534821 17592186045417 true] [17592186437088 1070 #edb/ref 17592186045487 13194139534821 17592186045417 true] [17592186437088 1071 "Evaluate ${f}_{xyz}(4,1,7)$ given that a function $f(x,y,z)$ and all of its higher-order partial derivatives are continuous on an open set $U,$ and that\n\n$$\n{f}_{xz}(x,y,z)=2x\\sqrt{z-3y}+z{e}^{x-4y}\n$$" 13194139534821 17592186045417 true] [17592186437088 1072 #uuid "17f2fd35-823f-52a1-8bc6-17fa0dd0fd8c" 13194139534821 17592186045417 true] [17592186437088 1074 "As the higher-order partial derivatives are continuous on an open set $U,$ the mixed partial derivatives must be equal. \n\nTherefore, we have\n\n$$\n\\begin{aligned}{f}_{xyz}(x,y,z) & ={f}_{xzy}(x,y,z) \\\\  & =\\frac{∂}{∂y}({f}_{xz}(x,y,z)) \\\\  & =\\frac{∂}{∂y}(2x\\sqrt{z-3y}+z{e}^{x-4y}) \\\\  & =2x\\cdot (-\\frac{3}{2\\sqrt{z-3y}})-4z{e}^{x-4y} \\\\  & =-\\frac{3x}{\\sqrt{z-3y}}-4z{e}^{x-4y}.\\end{aligned}\n$$\n\nNow, we evaluate the partial derivative at the point  $(4,1,7):$\n\n$$\n\\begin{aligned}{f}_{xyz}(4,1,7) & =-\\frac{3\\cdot 4}{\\sqrt{7-3\\cdot 1}}-4\\cdot 7\\cdot {e}^{4-4\\cdot 1} \\\\  & =-\\frac{12}{\\sqrt{7-3}}-28{e}^{4-4} \\\\  & =-6-28 \\\\  & =-34\\end{aligned}\n$$" 13194139534821 17592186045417 true] [17592186437089 1068 #edb/ref 17592186437086 13194139534821 17592186045417 true] [17592186437089 1069 "q-133235" 13194139534821 17592186045417 true] [17592186437089 1070 #edb/ref 17592186045485 13194139534821 17592186045417 true] [17592186437089 1071 "Suppose that the function $f(x,y)$ and all of its first and second-order partial derivatives are continuous on an open set $U.$ Find the values of $a$ and $b$, if \n\n$$\n{f}_{x}(x,y)=2y\\operatorname{cos}⁡(xy)+a{y}^{2},\\,{f}_{y}(x,y)=bx\\operatorname{cos}⁡(xy)+6xy.\n$$" 13194139534821 17592186045417 true] [17592186437089 1072 #uuid "b2a9101c-1b4a-5430-a447-8fae79ba4cdb" 13194139534821 17592186045417 true] [17592186437089 1074 "First, we find the mixed partial derivatives:\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}({f}_{x}(x,y)) \\\\  & =\\frac{∂}{∂y}(2y\\operatorname{cos}⁡(xy)+a{y}^{2}) \\\\  & =2\\operatorname{cos}⁡(xy)-2yx\\operatorname{sin}⁡(xy)+2ay \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}({f}_{y}(x,y)) \\\\  & =\\frac{∂}{∂x}(bx\\operatorname{cos}⁡(xy)+6xy) \\\\  & =b\\operatorname{cos}⁡(xy)-bxy\\operatorname{sin}⁡(xy)+6y\\end{aligned}\n$$\n\nSince the function and its first and second-order partial derivatives are continuous on an open set $U,$ the mixed partial derivatives must be equal. Hence, we have the identity\n\n$$\n\\begin{aligned}2\\operatorname{cos}⁡(xy)-2yx\\operatorname{sin}⁡(xy)+2ay & =b\\operatorname{cos}⁡(xy)-bxy\\operatorname{sin}⁡(xy)+6y.\\end{aligned}\n$$\n\nEquating the coefficients of $y$ and $\\operatorname{cos}⁡(xy),$ respectively, we see that $a=3$ and $b=2.$" 13194139534821 17592186045417 true] [17592186437090 1068 #edb/ref 17592186437087 13194139534821 17592186045417 true] [17592186437090 1069 "q-133224" 13194139534821 17592186045417 true] [17592186437090 1070 #edb/ref 17592186045485 13194139534821 17592186045417 true] [17592186437090 1071 "Suppose that the function $f(x,y)$ and all of its first and second-order partial derivatives are continuous on an open set $U.$ Find the values of $a$ and $b$, if \n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =a{x}^{2}{y}^{2}+5{y}^{2}-3, \\\\ {f}_{y}(x,y) & =b{x}^{3}y+10xy, \\\\ {f}_{x}(2,1) & =14.\\end{aligned}\n$$" 13194139534821 17592186045417 true] [17592186437090 1072 #uuid "e1ce51ab-65e5-5a2f-a7f1-d19c74e60108" 13194139534821 17592186045417 true] [17592186437090 1074 "First, we find the mixed partial derivatives:\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}({f}_{x}(x,y)) \\\\  & =\\frac{∂}{∂y}(a{x}^{2}{y}^{2}+5{y}^{2}-3) \\\\  & =2a{x}^{2}y+10y-0 \\\\  & =2a{x}^{2}y+10y \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}({f}_{y}(x,y)) \\\\  & =\\frac{∂}{∂x}(b{x}^{3}y+10xy) \\\\  & =3b{x}^{2}y+10y\\end{aligned}\n$$\n\nSince the function and its first and second-order partial derivatives are continuous on an open set $U,$ the mixed partial derivatives must be equal. Hence, we have the identity\n\n$$\n\\begin{aligned}2a{x}^{2}y+10y & =3b{x}^{2}y+10y.\\end{aligned}\n$$\n\nEquating the coefficients of ${x}^{2}y,$ we get $b=\\frac{2}{3}a.$ \n\nNow, since ${f}_{x}(2,1)=14$, we get\n\n$$\n\\begin{aligned}{f}_{x}(2,1) & =14 \\\\ a(2)^{2}(1)^{2}+5(1)^{2}-3 & =14 \\\\ 4a+2 & =14 \\\\ a & =3.\\end{aligned}\n$$\n\nFinally, $b=\\frac{2}{3}a=\\frac{2}{3}(3)=2.$" 13194139534821 17592186045417 true]] :edb/tempids {"answer-090cb572-cfdb-5f1c-ab62-85230fae9ba1" 17592186437070 "answer-17ff528c-3c19-55ef-aada-a825dbe38568" 17592186437071 "answer-1a612995-7d65-55d6-92a3-415ca7d3151e" 17592186437072 "answer-3b450a0c-622f-59cc-b892-e0e3a7245713" 17592186437073 "answer-40357cb7-ceb7-5912-9a08-22064ac23e43" 17592186437074 "answer-467fecb4-2ef9-52a6-963f-3519ca79e412" 17592186437075 "answer-4a53e719-2052-591b-812c-8d7bafb6fb97" 17592186437076 "answer-5f497807-e3fd-59ce-901a-13ca8829f6a8" 17592186437077 "answer-6d620e7d-0d60-5dad-a3b6-8c6c1da4471c" 17592186437078 "answer-8dc86f81-73d2-56a8-b320-2c1bc2c18f7a" 17592186437079 "answer-9507cee6-c36c-51c1-88e0-630f702efac1" 17592186437080 "answer-b2e70829-198b-5fba-9007-e3b43ddb0346" 17592186437081 "answer-b3d39e69-ac71-52bc-b3fa-32d9dee16b58" 17592186437082 "answer-e269130c-3006-5fed-9abb-a6de955d0350" 17592186437083 "answer-ed3fd222-7c6c-5f15-a429-78af9dfec4a2" 17592186437084 "answer-field-61f81261-3e5b-587f-b2ff-a3f22db029b7" 17592186437085 "answer-field-6a912a37-363a-53e6-bf86-dbe48185fc08" 17592186437086 "answer-field-843bf297-f481-59fb-a7e7-1153b03b247c" 17592186437087 "question-17f2fd35-823f-52a1-8bc6-17fa0dd0fd8c" 17592186437088 "question-b2a9101c-1b4a-5430-a447-8fae79ba4cdb" 17592186437089 "question-e1ce51ab-65e5-5a2f-a7f1-d19c74e60108" 17592186437090}}
