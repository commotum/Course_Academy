e><mo>+</mo><msup><mn>4</mn><mn>2</mn></msup><mo>⋅</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow><mo>−</mo><msup><mn>3</mn><mn>2</mn></msup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>2</mn><mo>+</mo><mn>8</mn><mo>−</mo><mn>9</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>1.</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
