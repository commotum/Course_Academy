"OP\">∑</mo><mi>x</mi></munder><msup><mi>x</mi><mn>2</mn></msup><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><msub><mi>f</mi><mrow data-mjx-texclass=\"ORD\"><mi>X</mi><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">|</mo></mrow><mi>Y</mi></mrow></msub><mo stretchy=\"false\">(</mo><mi>x</mi><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">|</mo></mrow><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mn>1</mn><mo stretchy=\"false\">)</mo><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"2.047em\" maxsize=\"2.047em\">]</mo></mrow><mo>−</mo><msubsup><mi>μ</mi><mrow data-mjx-texclass=\"ORD\"><mi>X</mi><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">|</mo></mrow><mn>1</mn></mrow><mn>2</mn></msubsup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"2.047em\" maxsize=\"2.047em\">[</mo></mrow><mo stretchy=\"false\">(</mo><mn>1</mn><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup><mo>⋅</mo><mn>0.4</mn><mo>+</mo><mo stretchy=\"false\">(</mo><mn>2</mn><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup><mo>⋅</mo><mn>0.6</mn><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"2.047em\" maxsize=\"2.047em\">]</mo></mrow><mo>−</mo><mo stretchy=\"false\">(</mo><mn>1.6</mn><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>0.4</mn><mo>+</mo><mn>2.4</mn><mo>−</mo><mn>2.56</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>0.24</mn><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
