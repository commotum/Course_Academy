d style=\"text-align: left; padding-left: 0px; padding-top: 0.4em;\"><mjx-mi class=\"mjx-n\"></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c30\"></mjx-c><mjx-c class=\"mjx-c2E\"></mjx-c><mjx-c class=\"mjx-c34\"></mjx-c><mjx-c class=\"mjx-c34\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mo><mjx-tstrut></mjx-tstrut></mjx-mtd></mjx-mtr></mjx-itable></mjx-table></mjx-mtable></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mtable displaystyle=\"true\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"0.8em 0.8em 0.8em 0.3em\"><mtr><mtd><mtext>Var</mtext><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"1.2em\" maxsize=\"1.2em\">[</mo></mrow><mi>Y</mi><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">|</mo></mrow><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mi>X</mi><mo>=</mo><mn>1</mn><mo stretchy=\"false\">]</mo></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"2.047em\" maxsize=\"2.047em\">[</mo></mrow><munder><mo data-mjx-texclass=\"OP\">∑</mo><mi>y</mi></munder><msup><mi>y</mi><mn>2</mn></msup><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><msub><mi>f</mi><mrow data-mjx-texclass=\"ORD\"><mi>Y</mi><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">|</mo></mrow><mi>X</mi></mrow></msub><mo stretchy=\"false\">(</mo><mi>y</mi><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">|</mo></mrow><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mn>1</mn><mo stretchy=\"false\">)</mo><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"2.047em\" maxsize=\"2.047em\">]</mo></mrow><mo>−</mo><msubsup><mi>μ</mi><mrow data-mjx-texclass=\"ORD\"><mi>Y</mi><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">|</mo></mrow><mn>1</mn></mrow><mn>2</mn></msubsup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"1.2em\" maxsize=\"1.2em\">[</mo></mrow><mo stretchy=\"false\">(</mo><mn>0</mn><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup><mo>⋅</mo><mn>0.1</mn><mo>+</mo><mo stretchy=\"false\">(</mo><mn>1</mn><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup><mo>⋅</mo><mn>0.4</mn><mo>+</mo><mo stretchy=\"false\">(</mo><mn>2</mn><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup><mo>⋅</mo><mn>0.5</mn><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"1.2em\" maxsize=\"1.2em\">]</mo></mrow><mo>−</mo><mo stretchy=\"false\">(</mo><mn>1.4</mn><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>0</mn><mo>+</mo><mn>0.4</mn><mo>+</mo><mn>2</mn><mo>−</mo><mn>1.96</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>0.44</mn><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
