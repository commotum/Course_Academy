.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186186365}] :answer-field/id #uuid "6762d125-e9d7-5f02-9226-4a00e4721756" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186186360}] :question/id #uuid "60cb8cd8-f4a1-51b2-afe3-57e452f5f729" :question/math-academy-id "q-146159" :question/problem "| $f$ | $Y = 0$ | $Y = 1$ | $Y = 2$ |\n| --- | ---: | ---: | ---: |\n| $X = 0$ | $\\frac{1}{8}$ | $\\frac{1}{4}$ | $\\frac{1}{8}$ |\n| $X = 1$ | $\\frac{1}{4}$ | $\\frac{1}{8}$ | $\\frac{1}{8}$ |\n\nSuppose $X$ and $Y$ are discrete random variables. Find $Var\\begin{bmatrix}Y & X = 0\\end{bmatrix}$ given that $X$ and $Y$ have the joint probability mass function $f(x, y)$ shown in the table above and the corresponding conditional expected value is $μ_{Y \\mid 0} = 1$.\n\n> A scientific calculator is required to answer this question." :question/requires-calculator true}] [{:db/id #edb/ref 17592186511574 :knowledge-point/_questions [{:db/id #edb/ref 17592186188339 :knowledge-point/id #uuid "abfaf356-6b74-5dfd-8070-e3a60dc372c5" :knowledge-point/title "Calculating a Conditional Variance Using Row Totals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46451ad3-292e-5818-b57f-512919c1b762" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186510940} {:answer/id #uuid "85f1ae38-1f12-5af1-9e47-1e397e55e732" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17}{2}" :db/id #edb/ref 17592186511058} {:answer/id #uuid "9848b01d-ae3d-5b11-a03c-4137d1ec2d54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186511099} {:answer/id #uuid "e44fbbd6-2948-5df7-8863-f9b14dba4caa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{25}{4}" :db/id #edb/ref 17592186511260} {:answer/id #uuid "f1966108-9bd3-50ba-ae71-0b6fda1b9652" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{4}" :db/id #edb/ref 17592186511278}] :answer-field/correct {:answer/id #uuid "e44fbbd6-2948-5df7-8863-f9b14dba4caa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{25}{4}" :db/id #edb/ref 17592186511260} :answer-field/id #uuid "273fb450-78e1-578c-ad1c-ea60b9f9611a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186511330}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e9ff9199-1184-598e-a945-b789f3d5b0b6" :question/math-academy-id "q-146236" :question/problem "| $f$ | $Y=5$ | $Y=10$ |\n| --- | --- | --- |\n| $X=3$ | $\\frac{4}{5}$ | $\\frac{3}{25}$ |\n| $X=6$ | $\\frac{1}{25}$ | $\\frac{1}{25}$ |\n\nSuppose $X$ and $Y$ are discrete random variables. Find $\\text{Var}[Y\\,|\\,X=6]$ given that $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above and the corresponding conditional expected value is ${\\mu }_{Y|6}=\\frac{15}{2}.$" :question/worked-solution "Recall that the conditional variance of $Y$ given $X=x$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=x] & =\\text{E}[(Y-{\\mu }_{Y|x})^{2}\\,|\\,X=x] \\\\  & =\\text{E}[{Y}^{2}\\,|\\,X=x]-{\\mu }_{Y|x}^{2} \\\\  & =[{\\sum }_{y}{y}^{2}\\,{f}_{Y|X}(y\\,|\\,x)]-{\\mu }_{Y|x}^{2}.\\end{aligned}\n$$\n\nIn order to find ${f}_{Y|X}(y\\,|\\,x),$ let's first find the marginal distribution for $X,$ corresponding to the row totals: \n\n| $f$ | $Y=5$ | $Y=10$ | ${f}_{X}(x)$ |\n| --- | --- | --- | --- |\n| $X=3$ | $\\frac{4}{5}$ | $\\frac{3}{25}$ | $\\frac{23}{25}$ |\n| $X=6$ | $\\frac{1}{25}$ | $\\frac{1}{25}$ | $\\frac{2}{25}$ |\n\nThe conditional probability mass function of $Y$ given that $X=x$ is\n\n$$\n{f}_{Y|X}(y\\,|\\,x)=\\frac{f(x,y)}{{f}_{X}(x)}.\n$$\n\nTherefore, dividing each joint probability by the corresponding row total, we obtain the conditional probability mass function of $Y$ given that $X=x:$\n\n| ${f}_{Y|X}(y\\,|\\,x)$ | $Y=5$ | $Y=10$ |  |\n| --- | --- | --- | --- |\n| $X=3$ | $\\frac{20}{23}$ | $\\frac{3}{23}$ | $1$ |\n| $X=6$ | $\\frac{1}{2}$ | $\\frac{1}{2}$ | $1$ |\n\nFinally, we obtain\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=6] & =[{\\sum }_{y}{y}^{2}\\,{f}_{Y|X}(y\\,|\\,6)]-{\\mu }_{Y|6}^{2} \\\\  & =[{5}^{2}\\cdot \\frac{1}{2}+{10}^{2}\\cdot \\frac{1}{2}]-{(\\frac{15}{2})}^{2} \\\\  & =\\frac{25}{2}+50-\\frac{225}{4} \\\\  & =\\frac{25}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186511582 :knowledge-point/_questions [{:db/id #edb/ref 17592186188328 :knowledge-point/id #uuid "92a52324-627c-5796-bc4f-ddeb5380f129" :knowledge-point/title "Calculating a Conditional Variance Using Column Totals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14738cb2-b471-5d99-b3eb-4afbb5fa348a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186510824} {:answer/id #uuid "20ae5337-49f2-5726-8ce9-b5fca604cf7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186510853} {:answer/id #uuid "518547db-16ad-50af-8a24-b4267aa35a9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186510957} {:answer/id #uuid "a50bc467-b427-559a-829c-9f60582a46c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186511128} {:answer/id #uuid "ee546c20-c60e-59e8-af15-1c8202fb7fba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186511274}] :answer-field/correct {:answer/id #uuid "14738cb2-b471-5d99-b3eb-4afbb5fa348a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186510824} :answer-field/id #uuid "0f312ee4-2cb7-5564-9f11-50b74da2484d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186511318}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "fa585366-16bd-5221-b5b1-a80000ac4783" :question/math-academy-id "q-146282" :question/problem "| $f$ | $Y=0$ | $Y=2$ |\n| --- | --- | --- |\n| $X=0$ | $\\frac{1}{8}$ | $\\frac{1}{8}$ |\n| $X=1$ | $\\frac{1}{8}$ | $\\frac{1}{4}$ |\n| $X=2$ | $\\frac{1}{4}$ | $\\frac{1}{8}$ |\n\nSuppose $X$ and $Y$ are discrete random variables. Find $\\text{Var}[X\\,|\\,Y=2]$ given that the random variables $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above and the corresponding conditional expected value is ${\\mu }_{X|2}=1.$" :question/worked-solution "Recall that the conditional variance of $X$ given $Y=y$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=y] & =\\text{E}[(X-{\\mu }_{X|y})^{2}\\,|\\,Y=y] \\\\  & =\\text{E}[{X}^{2}\\,|\\,Y=y]-{\\mu }_{X|y}^{2} \\\\  & =[{\\sum }_{x}{x}^{2}\\,{f}_{X|Y}(x\\,|\\,y)]-{\\mu }_{X|y}^{2}.\\end{aligned}\n$$\n\nIn order to find ${f}_{X|Y}(x\\,|\\,y),$ let's first find the marginal distribution of $Y,$ corresponding to the column totals: \n\n| $f$ | $Y=0$ | $Y=2$ |\n| --- | --- | --- |\n| $X=0$ | $\\frac{1}{8}$ | $\\frac{1}{8}$ |\n| $X=1$ | $\\frac{1}{8}$ | $\\frac{1}{4}$ |\n| $X=2$ | $\\frac{1}{4}$ | $\\frac{1}{8}$ |\n| ${f}_{Y}(y)$ | $\\frac{1}{2}$ | $\\frac{1}{2}$ |\n\nThe conditional probability mass function of $X$ given that $Y=y$ is\n\n$$\n{f}_{X|Y}(x\\,|\\,y)=\\frac{f(x,y)}{{f}_{Y}(y)}.\n$$\n\nTherefore, dividing each joint probability by the corresponding column total, we obtain the conditional probability mass function of $X$ given that $Y=y:$\n\n| ${f}_{X|Y}(x\\,|\\,y)$ | $Y=0$ | $Y=2$ |\n| --- | --- | --- |\n| $X=0$ | $\\frac{1}{4}$ | $\\frac{1}{4}$ |\n| $X=1$ | $\\frac{1}{4}$ | $\\frac{1}{2}$ |\n| $X=2$ | $\\frac{1}{2}$ | $\\frac{1}{4}$ |\n|  | $1$ | $1$ |\n\nFinally, we obtain\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=2] & =[{\\sum }_{x}{x}^{2}\\,{f}_{X|Y}(x\\,|\\,2)]-{\\mu }_{X|2}^{2} \\\\  & =[{0}^{2}\\cdot \\frac{1}{4}+{1}^{2}\\cdot \\frac{1}{2}+{2}^{2}\\cdot \\frac{1}{4}]-{1}^{2} \\\\  & =0+\\frac{1}{2}+1-1 \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186188689 :knowledge-point/_questions [{:db/id #edb/ref 17592186188328 :knowledge-point/id #uuid "92a52324-627c-5796-bc4f-ddeb5380f129" :knowledge-point/title "Calculating a Conditional Variance Using Column Totals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "984380c5-40cc-5710-a30c-a6c66b2ff180" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{91}{9}" :db/id #edb/ref 17592186186415} {:answer/id #uuid "b6b9fba5-d63e-5377-857e-f317e4e33b6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{103}{9}" :db/id #edb/ref 17592186186416} {:answer/id #uuid "d576a0de-cee9-5266-b5b8-30152891dc3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{110}{9}" :db/id #edb/ref 17592186186417} {:answer/id #uuid "4cb7bf53-7c58-55f8-abd8-0cd422ffc050" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{70}{3}" :db/id #edb/ref 17592186186418} {:answer/id #uuid "7044a4a3-0a43-582f-817a-e99488b07711" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{50}{3}" :db/id #edb/ref 17592186186419}] :answer-field/id #uuid "f443ee10-4ae5-53b4-b5be-0af99b1c94bf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186186414}] :question/id #uuid "07c19340-2d1a-5056-9657-cee2e32e9b96" :question/math-academy-id "q-146289" :question/problem "| $f$ | $Y = 0$ | $Y = 1$ |\n| --- | ---: | ---: |\n| $X = 0$ | $\\frac{1}{10}$ | $\\frac{1}{5}$ |\n| $X = 3$ | $\\frac{1}{5}$ | $\\frac{1}{4}$ |\n| $X = 9$ | $\\frac{3}{20}$ | $\\frac{1}{10}$ |\n\nSuppose $X$ and $Y$ are discrete random variables. Find $Var\\begin{bmatrix}X & Y = 0\\end{bmatrix}$ given that the random variables $X$ and $Y$ have the joint probability mass function $f(x, y)$ shown in the table above and the corresponding conditional expected value is $μ_{X \\mid 0} = \\frac{13}{3}$.\n\n> A scientific calculator is required to answer this question." :question/requires-calculator true}]}
