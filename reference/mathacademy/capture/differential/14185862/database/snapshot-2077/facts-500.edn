-5bae-aefd-02f4a378e3ca" #edb/ref 17592186045417] [17592186500965 #edb/ref 1080 "0.932" #edb/ref 17592186045417] [17592186500965 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186500965 #edb/ref 1083 #uuid "e91a7731-a4f2-5c1c-ab3c-3264404a0e02" #edb/ref 17592186045417] [17592186501076 #edb/ref 1075 #edb/ref 17592186500664 #edb/ref 17592186045417] [17592186501076 #edb/ref 1075 #edb/ref 17592186500767 #edb/ref 17592186045417] [17592186501076 #edb/ref 1075 #edb/ref 17592186500887 #edb/ref 17592186045417] [17592186501076 #edb/ref 1075 #edb/ref 17592186500926 #edb/ref 17592186045417] [17592186501076 #edb/ref 1075 #edb/ref 17592186500965 #edb/ref 17592186045417] [17592186501076 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186501076 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186501076 #edb/ref 1078 #edb/ref 17592186500887 #edb/ref 17592186045417] [17592186501076 #edb/ref 1079 #uuid "7c8ed450-14d6-56b8-9f85-42f0c5090225" #edb/ref 17592186045417] [17592186501186 #edb/ref 1068 #edb/ref 17592186501076 #edb/ref 17592186045417] [17592186501186 #edb/ref 1069 "q-131278" #edb/ref 17592186045417] [17592186501186 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186501186 #edb/ref 1071 "A supplier of clothing materials looks for flaws before selling the material to customers. On average, there have been $1.7$ flaws per meter. What is the probability of finding fewer than $4$  flaws in the next meter length of the material? Round your answer to $3$ decimal places. You may assume that flaws appear independently and at a constant average rate." #edb/ref 17592186045417] [17592186501186 #edb/ref 1072 #uuid "7f6be4fe-78ba-5d67-91ec-fd3e20928e4b" #edb/ref 17592186045417] [17592186501186 #edb/ref 1074 "A Poisson random variable $X$ with rate $\\lambda $ has the following probability mass function:\n\n$$\nf(x)=\\frac{{\\lambda }^{x}{e}^{-\\lambda }}{x!}\n$$\n\nLet $X$ be the number of flaws in a meter length of the material. Since the average rate is $1.7$ flaws per meter, and events occur independently and at a constant average rate, the number of flaws can be modeled as a Poisson random variable with rate $\\lambda =1.7,$ and we can write $X∼\\text{Po}(1.7).$\n\nSo, $X$ has the following probability mass function:\n\n$$\nf(x)=\\frac{{1.7}^{x}{e}^{-1.7}}{x!}\n$$\n\nTherefore, the probability of finding fewer than $4$  flaws in the next meter length of the material is\n\n$$\n\\begin{aligned}P(X<4) & =P(X\\in \\{0,1,2,3\\}) \\\\  & =f(0)+f(1)+f(2)+f(3) \\\\  & =\\frac{{1.7}^{0}{e}^{-1.7}}{0!}+\\frac{{1.7}^{1}{e}^{-1.7}}{1!}+\\frac{{1.7}^{2}{e}^{-1.7}}{2!}+\\frac{{1.7}^{3}{e}^{-1.7}}{3!} \\\\  & ≈0.907\\end{aligned}\n$$\n\nrounded to $3$ decimal places." #edb/ref 17592186045417] [17592186501284 #edb/ref 1058 #edb/ref 17592186501299 #edb/ref 17592186045417] [17592186501284 #edb/ref 1062 #uuid "b3f379e0-d96a-59b3-a5f3-cd3157bae58d" #edb/ref 17592186045417] [17592186501284 #edb/ref 1063 #edb/ref 17592186342240 #edb/ref 17592186045417] [17592186501287 #edb/ref 1058 #edb/ref 17592186501284 #edb/ref 17592186045417] [17592186501287 #edb/ref 1062 #uuid "b72404ac-26bb-566e-86ed-eac8022d2e24" #edb/ref 17592186045417] [17592186501287 #edb/ref 1063 #edb/ref 17592186342231 #edb/ref 17592186045417] [17592186501293 #edb/ref 1062 #uuid "e2d3f1ac-8edc-511e-a9dc-9a185ba14e65" #edb/ref 17592186045417] [17592186501293 #edb/ref 1063 #edb/ref 17592186241019 #edb/ref 17592186045417] [17592186501294 #edb/ref 1058 #edb/ref 17592186501287 #edb/ref 17592186045417] [17592186501294 #edb/ref 1062 #uuid "e82061b7-e579-5804-86dd-b377e54a1147" #edb/ref 17592186045417] [17592186501294 #edb/ref 1063 #edb/ref 17592186317208 #edb/ref 17592186045417] [17592186501299 #edb/ref 1058 #edb/ref 17592186501293 #edb/ref 17592186045417] [17592186501299 #edb/ref 1062 #uuid "fc03f4e8-430f-5ef2-ba85-5ff08877b297" #edb/ref 17592186045417] [17592186501299 #edb/ref 1063 #edb/ref 17592186241017 #edb/ref 17592186045417] [1759218650