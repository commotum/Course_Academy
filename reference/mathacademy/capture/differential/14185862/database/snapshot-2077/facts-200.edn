5417] [17592186342239 #edb/ref 1069 "q-74597" #edb/ref 17592186045417] [17592186342239 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186342239 #edb/ref 1071 "Find the values of $k$ such that the vector $b$ lies in $\\text{Span}\\{{a}_{1},{a}_{2}\\},$ where\n\n$$\n{a}_{1}=[\\begin{aligned}5 \\\\ 1 \\\\ 2\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}1 \\\\ -1 \\\\ -1\\end{aligned}],\\,b=[\\begin{aligned}-3 \\\\ -3 \\\\ k\\end{aligned}].\n$$" #edb/ref 17592186045417] [17592186342239 #edb/ref 1072 #uuid "d5c520f5-835e-5cc8-a0fb-53c3d5239f5d" #edb/ref 17592186045417] [17592186342239 #edb/ref 1074 "We know that $b\\in \\text{Span}\\{{a}_{1},{a}_{2}\\}$ if there exist ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2} & =b \\\\ {x}_{1}[\\begin{aligned}5 \\\\ 1 \\\\ 2\\end{aligned}]+{x}_{2}[\\begin{aligned}1 \\\\ -1 \\\\ -1\\end{aligned}] & =[\\begin{aligned}-3 \\\\ -3 \\\\ k\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n\\{\\begin{aligned}5{x}_{1}+{x}_{2}=-3 \\\\ {x}_{1}-{x}_{2}=-3 \\\\ 2{x}_{1}-{x}_{2}=k\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{aligned}5 & 1 & -3 \\\\ 1 & -1 & -3 \\\\ 2 & -1 & k\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -1 & -3 \\\\ 5 & 1 & -3 \\\\ 2 & -1 & k\\end{aligned}] & {R}_{2} & :={R}_{2}-5{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & -3 \\\\ 0 & 6 & 12 \\\\ 2 & -1 & k\\end{aligned}] & {R}_{3} & :={R}_{3}-2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & -3 \\\\ 0 & 6 & 12 \\\\ 0 & 1 & k+6\\end{aligned}] & {R}_{2} & :=\\frac{1}{6}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -1 & -3 \\\\ 0 & 1 & 2 \\\\ 0 & 1 & k+6\\end{aligned}] & {R}_{3} & :={R}_{3}-{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -1 & -3 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & k+4\\end{aligned}]\\end{aligned}\n$$\n\nThe third row of the augmented matrix now corresponds to the equation $0{x}_{1}+0{x}_{2}=k+4.$ Therefore, the system has a solution only if\n\n$$\n0=k+4\\,⇒\\,k=-4.\n$$" #edb/ref 17592186045417] [17592186369652 #edb/ref 1075 #edb/ref 17592186369653 #edb/ref 17592186045417] [17592186369652 #edb/ref 1075 #edb/ref 17592186369654 #edb/ref 17592186045417] [17592186369652 #edb/ref 1075 #edb/ref 17592186369655 #edb/ref 17592186045417] [17592186369652 #edb/ref 1075 #edb/ref 17592186369656 #edb/ref 17592186045417] [17592186369652 #edb/ref 1075 #edb/ref 17592186369657 #edb/ref 17592186045417] [17592186369652 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186369652 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186369652 #edb/ref 1078 #edb/ref 17592186369655 #edb/ref 17592186045417] [17592186369652 #edb/ref 1079 #uuid "e907f6da-cd04-5106-a3c9-cf468f523d2d" #edb/ref 17592186045417] [17592186369653 #edb/ref 1080 "26" #edb/ref 17592186045417] [17592186369653 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369653 #edb/ref 1083 #uuid "6a7a743c-110e-5e17-9b8e-c0a4ed4bf822" #edb/ref 17592186045417] [17592186369654 #edb/ref 1080 "16" #edb/ref 17592186045417] [17592186369654 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369654 #edb/ref 1083 #uuid "d0bc9a45-3558-56aa-b44c-19b91bed820a" #edb/ref 17592186045417] [17592186369655 #edb/ref 1080 "40" #edb/ref 17592186045417] [17592186369655 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369655 #edb/ref 1083 #uuid "6840aa01-0203-5583-a1fb-3ee0ba2fced3" #edb/ref 17592186045417] [17592186369656 #edb/ref 1080 "36" #edb/ref 17592186045417] [17592186369656 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369656 #edb/ref 1083 #uuid "53b84c0f-bed5-541b-8d3e-723a5410d69e" #edb/ref 17592186045417] [17592186369657 #edb/ref 1080 "4" #edb/ref 17592186045417] [17592186369657 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369657 #edb/ref 1083 #uuid "288b9421-5232-599d-975c-4cacf3b01709" #edb/ref 