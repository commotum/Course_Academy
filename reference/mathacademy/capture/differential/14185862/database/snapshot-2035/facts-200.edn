-828e-687788c962cb" #edb/ref 17592186045417] [17592186393049 #edb/ref 1080 "r\\cdot ⟨-3,4,-1⟩=-27" #edb/ref 17592186045417] [17592186393049 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186393049 #edb/ref 1083 #uuid "1521f0fb-a511-5bc0-893e-2c6a06cceff9" #edb/ref 17592186045417] [17592186402002 #edb/ref 1068 #edb/ref 17592186402003 #edb/ref 17592186045417] [17592186402002 #edb/ref 1069 "q-31954" #edb/ref 17592186045417] [17592186402002 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186402002 #edb/ref 1071 "The inverse of the $2\\times 2$ matrix $D$ is found using row operations, as shown below. Complete the process, and determine ${D}^{-1}.$\n\n$$\n\\begin{aligned}[D\\,|\\,I] & =[\\begin{aligned}1 & 1 & 1 & 0 \\\\ 2 & 1 & 0 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & 1 & 0 \\\\ 0 & -1 & -2 & 1\\end{aligned}] & {R}_{2} & :=-{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 1 & 1 & 0 \\\\ 0 & 1 & 2 & -1\\end{aligned}] & {R}_{1} & :=\\text{___________} \\\\  & ∼[\\begin{aligned}1 & 0 &  &  \\\\ 0 & 1 &  & \\end{aligned}]\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186402002 #edb/ref 1072 #uuid "1fb0889d-6fed-5243-aaf7-929089854f2b" #edb/ref 17592186045417] [17592186402002 #edb/ref 1074 "We write down $D$ and the identity matrix $I$ side-by-side (as shown below) and apply the standard Gauss-Jordan method to transform the matrix $D$ into the identity matrix. We perform the same row operations on both matrices:\n\n$$\n\\begin{aligned}[D\\,|\\,I] & =[\\begin{aligned}1 & 1 & 1 & 0 \\\\ 2 & 1 & 0 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & 1 & 0 \\\\ 0 & -1 & -2 & 1\\end{aligned}] & {R}_{2} & :=-{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 1 & 1 & 0 \\\\ 0 & 1 & 2 & -1\\end{aligned}] & {R}_{1} & :={R}_{1}+(-1){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & -1 & 1 \\\\ 0 & 1 & 2 & -1\\end{aligned}]\\end{aligned}\n$$\n\nThe matrix ${D}^{-1}$ is given by the right-hand side of our big matrix after all of the transformations have been completed. Therefore, \n\n$$\n{D}^{-1}=[\\begin{aligned}-1 & 1 \\\\ 2 & 1\\end{aligned}].\n$$" #edb/ref 17592186045417] [17592186402003 #edb/ref 1075 #edb/ref 17592186402004 #edb/ref 17592186045417] [17592186402003 #edb/ref 1075 #edb/ref 17592186402005 #edb/ref 17592186045417] [17592186402003 #edb/ref 1075 #edb/ref 17592186402006 #edb/ref 17592186045417] [17592186402003 #edb/ref 1075 #edb/ref 17592186402007 #edb/ref 17592186045417] [17592186402003 #edb/ref 1075 #edb/ref 17592186402008 #edb/ref 17592186045417] [17592186402003 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186402003 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186402003 #edb/ref 1078 #edb/ref 17592186402004 #edb/ref 17592186045417] [17592186402003 #edb/ref 1079 #uuid "ce793d72-97c8-5680-9b23-e9cde7d661bb" #edb/ref 17592186045417] [17592186402004 #edb/ref 1080 "{D}^{-1}=[\\begin{aligned}-1 & 1 \\\\ 2 & -1\\end{aligned}]" #edb/ref 17592186045417] [17592186402004 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186402004 #edb/ref 1083 #uuid "d4683baa-7e31-565a-90dd-81bc97617456" #edb/ref 17592186045417] [17592186402005 #edb/ref 1080 "{D}^{-1}=[\\begin{aligned}-1 & -1 \\\\ 1 & 2\\end{aligned}]" #edb/ref 17592186045417] [17592186402005 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186402005 #edb/ref 1083 #uuid "e66e39bf-af21-54ee-9c01-1e665e79afcb" #edb/ref 17592186045417]}
