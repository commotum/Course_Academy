-a17c-5fc3-8c14-3aaec7753b3c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048252}] :knowledge-point/questions [{:db/id #edb/ref 17592186115851} {:db/id #edb/ref 17592186115852} {:db/id #edb/ref 17592186265998} {:db/id #edb/ref 17592186266077} {:db/id #edb/ref 17592186345092} {:db/id #edb/ref 17592186345095} {:db/id #edb/ref 17592186345097} {:db/id #edb/ref 17592186345106} {:db/id #edb/ref 17592186345107} {:db/id #edb/ref 17592186417378}] :knowledge-point/title "Transforming a 2x2 Matrix Into the Identity Matrix Using Row Operations"} :step/id #uuid "e2dcd832-c069-5309-a7a3-27850adf28e2" :step/math-academy-id 17233 :step/next {:db/id #edb/ref 17592186116135}}] :activity/title "Finding the Inverse of a 2x2 Matrix Using Row Operations" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186115474}] [{:activity/expected-seconds 780.0 :activity/first-step {:db/id #edb/ref 17592186158167} :activity/id #uuid "0acc44f8-9b24-5d3b-9b0b-bdb2777ea7d3" :activity/scope {:db/id #edb/ref 17592186048934 :topic/id #uuid "cd3b7077-78e5-5eb6-880e-d8648790c6b0" :topic/math-academy-id 2838} :activity/steps [{:db/id #edb/ref 17592186158155 :step/content {:db/id #edb/ref 17592186157308 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157112 :question/id #uuid "2ba74c8a-f3b2-5a1d-a596-9f41be61e7d8" :question/math-academy-id "e-7493"} :knowledge-point/id #uuid "4f0a57c2-bbad-5225-976b-385c7f117738" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049358}] :knowledge-point/questions [{:db/id #edb/ref 17592186157853} {:db/id #edb/ref 17592186157859} {:db/id #edb/ref 17592186419533} {:db/id #edb/ref 17592186419535} {:db/id #edb/ref 17592186419538} {:db/id #edb/ref 17592186419541} {:db/id #edb/ref 17592186419542}] :knowledge-point/title "Identifying Random Variables that Follow a Poisson Distribution"} :step/id #uuid "baff7f20-dc53-5d87-94c9-0725cca77ccb" :step/math-academy-id 27837 :step/next {:db/id #edb/ref 17592186158156}} {:db/id #edb/ref 17592186158156 :step/content {:db/id #edb/ref 17592186157309 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157113 :question/id #uuid "0f9af894-7d9c-5535-8db7-ff928a5a290a" :question/math-academy-id "e-7495"} :knowledge-point/id #uuid "e8ebf979-62b1-53f6-bb77-685b22e25190" :knowledge-point/questions [{:db/id #edb/ref 17592186157854} {:db/id #edb/ref 17592186157855} {:db/id #edb/ref 17592186419532} {:db/id #edb/ref 17592186419536} {:db/id #edb/ref 17592186419539} {:db/id #edb/ref 17592186419540} {:db/id #edb/ref 17592186419544} {:db/id #edb/ref 17592186437136}] :knowledge-point/title "Computing the Probability of a Poisson Random Variable at Some Value"} :step/id #uuid "3a629aba-522f-548e-80da-577c194fdfe9" :step/math-academy-id 27839 :step/next {:db/id #edb/ref 17592186158157}} {:db/id #edb/ref 17592186158157 :step/content {:db/id #edb/ref 17592186157310 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157114 :question/id #uuid "ae98c2fc-bfb5-5f5d-bfce-f536aa42e5d3" :question/math-academy-id "e-7496"} :knowledge-point/id #uuid "73b026df-b888-5e60-b448-c239cd3e05cd" :knowledge-point/questions [{:db/id #edb/ref 17592186157860} {:db/id #edb/ref 17592186157861} {:db/id #edb/ref 17592186419531} {:db/id #edb/ref 17592186419545} {:db/id #edb/ref 17592186419546} {:db/id #edb/ref 17592186419547} {:db/id #edb/ref 17592186437137} {:db/id #edb/ref 17592186437139}] :knowledge-point/title "Computing the Probability of a Poisson Random Variable on a Bounded Interval"} :step/id #uuid "4b44c854-917d-5ba0-b5a2-d41308ca5256" :step/math-academy-id 27840 :step/next {:db/id #edb/ref 17592186158158}} {:db/id #edb/ref 17592186158158 :step/content {:db/id #edb/ref 17592186157311 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157115 :question/id #uuid "5be23338-73b5-50b5-8dc8-0aa6d264afb1" :question/math-academy-id "e-7497"} :knowledge-point/id #uuid "12ffe541-9864-5d3f-92d0-8cc32d05b44f" :knowledge-point/questions [{:db/id #edb/ref 17592186157862} {:db/id #edb/ref 17592186157863} {:db/id #edb/ref 17592186419534} {:db/id #edb/ref 17592186419537} {:db/id #edb/ref 17592186419543} {:db/id #edb/ref 17592186437138}] :knowledge-point/title "Computing the Probability of a Poisson Random Variable on an Unbounded Interval"} :step/id #uuid "61e344b0-9976-54f7-a03c-175fe1505fbb" :step/math-academy-id 27841} {:db/id #edb/ref 17592186158167 :step/content {:db/id #edb/ref 17592186158491 :tutorial/content "A **Poisson distribution** is a probability distribution that models the number of events that occur in an interval of time or space if events occur independently and at a constant average rate.\n\nIf the rate of the events is $\\lambda,$ then the number of events $x$ occurring in an interval of fixed length has the following probability mass function:\n\n$$\nf(x) = \\dfrac{\\lambda^x e^{-\\lambda}}{x!}, \\qquad x=0,1,2,3, \\ldots\n$$\n\nIf a random variable $X$ follows a Poisson distribution with rate $\\lambda,$ then we write $X \\sim \\textrm{Po}(\\lambda).$\n\nFor example, suppose that calls come in at an average rate of $3$ calls per minute at a call center. Then the number of calls $X$ that are received during the next minute has the following probability mass function:\n\n$$\nf(x) = \\dfrac{3^x e^{-3}}{x!}\n$$\n\nIn particular, the probability of receiving $4$ calls during the next minute is\n\n$$\n\\begin{aligned}P(X=4) & =f(4) \\\\  & =\\frac{{3}^{4}{e}^{-3}}{4!} \\\\  & ≈0.168\\end{aligned}\n$$\n\nrounded to $3$ decimal places." :tutorial/id #uuid "6e07ef85-f3ca-52c8-89e2-062d8ea7c9eb" :tutorial/math-academy-id 4525 :tutorial/title "Introduction"} :step/id #uuid "fd4dd871-25f7-54f5-9345-a556f2356cb0" :step/math-academy-id 27850 :step/next {:db/id #edb/ref 17592186158170}} {:db/id #edb/ref 17592186158170 :step/content {:db/id #edb/ref 17592186158493 :tutorial/content "The shape of the graph of the Poisson distribution depends on the value of $\\lambda.$ When $\\lambda$ is small, the probability is concentrated at small values of $x.$ When $\\lambda$ is larger, the probability is concentrated at larger values of $x.$\n\n![](images/a8/a8af371733bd248a4e5ba3bc35199f00414188e9ca033a04dee2a7de4b0a7db4.png)" :tutorial/id #uuid "f0026198-16d4-5332-9f5b-036bd00ef32d" :tutorial/math-academy-id 4534 :tutorial/title "The Graph of the Poisson Distribution"} :step/id #uuid "3576e13c-4960-5e5a-b072-2acaff8161cf" :step/math-academy-id 27932 :step/next {:db/id #edb/ref 17592186158155}}] :activity/title "Modeling With the Poisson Distribution" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186157493}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186437141} :activity/id #uuid "6e3ee6dd-60a3-557f-8bd4-cac744c68b82" :activity/scope {:db/id #edb/ref 17592186048934 :topic/id #uuid "cd3b7077-78e5-5eb6-880e-d8648790c6b0" :topic/math-academy-id 2838} :activity/steps [{:db/id #edb/ref 17592186437140 :step/content {:db/id #edb/ref 17592186437138 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3cd87632-86c9-568a-93e5-d7ef69437ccc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.827" :db/id #edb/ref 17592186437116} {:answer/id #uuid "4f5cd1e1-b1c5-5fc7-9253-2dc3e4f28a46" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.979" :db/id #edb/ref 17592186437118} {:answer/id #uuid "7c8348b8-c42d-56b0-b92b-798242f8369b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.865" :db/id #edb/ref 17592186437122} {:answer/id #uuid "b61aade4-803e-5239-8e68-f83d9c20a8cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.798" :db/id #edb/ref 17592186437126} {:answer/id #uuid "fe83b2b1-31dd-59c3-9890-738677753877" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.812" :db/id #edb/ref 17592186437131}] :answer-field/correct {:db/id #edb/ref 17592186437116} :answer-field/id #uuid "80be0045-2641-54de-af08-8fe8e34ad2a8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186437133}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "630f14f8-eb57-54c4-9fbf-4988a90b57a0" :question/math-academy-id "q-85394" :question/problem "A telephone exchange receives an average of $7$ calls every $5$ minutes. What is the probability that the exchange will receive at least $5$ calls in the next $5$ minutes? Round your answer to $3$ decimal places. You may assume that calls occur independently and at a constant average rate." :question/worked-solution "A Poisson random variable $X$ with rate $\\lambda $ has the following probability mass function:\n\n$$\nf(x)=\\frac{{\\lambda }^{x}{e}^{-\\lambda }}{x!}\n$$\n\nLet $X$ be the number of calls received in the telephone exchange. Since the average rate is $7$ calls every $5$ minutes, and events occur independently and at a constant average rate, the number of calls can be modeled as a Poisson random variable with rate $\\lambda =7,$ and we can write $X∼\\text{Po}(7).$ \n\nSo, $X$ has the following probability mass function:\n\n$$\nf(x)=\\frac{{7}^{x}{e}^{-7}}{x!}\n$$\n\nTo compute $P(X\\ge 5),$ we will use the complement:\n\n$$\nP(X\\ge 5)=1-P(X<5)\n$$\n\nComputing the probability of the complement, we get\n\n$$\n\\begin{aligned}P(X<5) & =P(X\\in \\{0,1,2,3,4\\}) \\\\  & =f(0)+f(1)+f(2)+f(3)+f(4) \\\\  & =\\frac{{7}^{0}{e}^{-7}}{0!}+\\frac{{7}^{1}{e}^{-7}}{1!}+\\frac{{7}^{2}{e}^{-7}}{2!}+\\frac{{7}^{3}{e}^{-7}}{3!}+\\frac{{7}^{4}{e}^{-7}}{4!} \\\\  & ≈0.173\\end{aligned}\n$$\n\nrounded to $3$ decimal places.\n\nTherefore, the probability of receiving at least $5$ calls in the next $5$ minutes is\n\n$$\n\\begin{aligned}P(X\\ge 5) & =1-P(X<5) \\\\  & ≈1-0.173 \\\\  & =0.827\\end{aligned}\n$$\n\nrounded to $3$ decimal places."} :step/id #uuid "004acfbe-1d4d-5f2f-b440-224bff7b1696" :step/next {:db/id #edb/ref 17592186437144}} {:db/id #edb/ref 17592186437141 :step/content {:db/id #edb/ref 17592186157854 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "993a5061-81f4-5185-bc75-a6608906c4a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.500" :db/id #edb/ref 17592186156046} {:answer/id #uuid "bb85757a-c98d-5e3e-84d6-7a62598ca493" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.238" :db/id #edb/ref 17592186156047} {:answer/id #uuid "cc9d3125-b7f6-515d-b49c-71622de1db1b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.147" :db/id #edb/ref 17592186156048} {:answer/id #uuid "07ca3f4d-0088-5e6b-b659-17cf0e9f2ec7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.173" :db/id #edb/ref 17592186156049} {:answer/id #uuid "3ee4152b-ecde-55d6-b908-b244e85fc5ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.115" :db/id #edb/ref 17592186156050}] :answer-field/correct {:db/id #edb/ref 17592186156048} :answer-field/id #uuid "f6e3d202-ddbe-575d-aec9-41da45239dbb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186156045}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0cb030d4-b2c6-50c8-943d-58caad6b6e01" :question/math-academy-id "q-85150" :question/problem "A writer is editing the first draft of a book. On average, there have been $4$ typos per page. What is the probability of finding $2$ typos on the next page? Round your answer to $3$ decimal places. You may assume that typos occur independently and at a constant average rate." :question/requires-calculator true :question/worked-solution "A Poisson random variable $X$ with rate $\\lambda $ has the following probability mass function:\n\n$$\nf(x)=\\frac{{\\lambda }^{x}{e}^{-\\lambda }}{x!}\n$$\n\nLet $X$ be the number of typos on a page of the book. Since the average rate is $4$ typos per page, and events occur independently and at a constant average rate, the number of typos can be modeled as a Poisson random variable with rate $\\lambda =4,$ and we can write $X∼\\text{Po}(4).$\n\nSo, $X$ has the following probability mass function:\n\n$$\nf(x)=\\frac{{4}^{x}{e}^{-4}}{x!}\n$$\n\nTherefore, the probability of finding $2$ typos on the next page is\n\n$$\n\\begin{aligned}P(X=2) & =f(2) \\\\  & =\\frac{{4}^{2}{e}^{-4}}{2!} \\\\  & ≈0.147\\end{aligned}\n$$\n\nrounded to $3$ decimal places."} :step/id #uuid "212ee944-3799-52f3-82f8-1c83bc934474" :step/next {:db/id #edb/ref 17592186437140}} {:db/id #edb/ref 17592186437142 :step/content {:db/id #edb/ref 17592186437137 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f9e78be-1c05-5746-af99-56ee649b8e69" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.151" :db/id #edb/ref 17592186437112} {:answer/id #uuid "23e97ddf-d3f7-50f6-875a-5463203ee997" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.221" :db/id #edb/ref 17592186437115} {:answer/id #uuid "6ff4f1e3-cf6e-5cd8-8f0c-fc33cf9a7534" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.135" :db/id #edb/ref 17592186437120} {:answer/id #uuid "99acdea4-f1d6-5ba9-80fa-995cba142c5c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.253" :db/id #edb/ref 17592186437123} {:answer/id #uuid "fa8c3282-52ef-59d2-8559-f4a7b0b33e09" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.156" :db/id #edb/ref 17592186437130}] :answer-field/correct {:db/id #edb/ref 17592186437112} :answer-field/id #uuid "8aa4c72e-18f1-5153-bc4d-2cd8d8207293" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186437134}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "57e8cbd7-ad98-573e-bd99-c98a3e1a7b22" :question/math-academy-id "q-131276" :question/problem "The mean number of bacteria per milliliter of a liquid is $6.$ What is the probability that there will be no more than $3$ bacteria in one milliliter of the liquid? Round your answer to $3$ decimal places. You may assume that bacteria appear independently and at a constant average rate." :question/worked-solution "A Poisson random variable $X$ with rate $\\lambda $ has the following probability mass function:\n\n$$\nf(x)=\\frac{{\\lambda }^{x}{e}^{-\\lambda }}{x!}\n$$\n\nLet $X$ be the number of bacteria in one milliliter of the liquid. Since the average rate is $6$ bacteria per milliliter, and events occur independently and at a constant average rate, the number of bacteria can be modeled as a Poisson random variable with rate $\\lambda =6,$ and we can write $X∼\\text{Po}(6).$\n\nSo, $X$ has the following probability mass function:\n\n$$\nf(x)=\\frac{{6}^{x}{e}^{-6}}{x!}\n$$\n\nTherefore, the probability that at most $3$ bacteria will be found in one milliliter of the liquid is\n\n$$\n\\begin{aligned}P(X\\le 3) & =P(X\\in \\{0,1,2,3\\}) \\\\  & =f(0)+f(1)+f(2)+f(3) \\\\  & =\\frac{{6}^{0}{e}^{-6}}{0!}+\\frac{{6}^{1}{e}^{-6}}{1!}+\\frac{{6}^{2}{e}^{-6}}{2!}+\\frac{{6}^{3}{e}^{-6}}{3!} \\\\  & ≈0.151\\end{aligned}\n$$\n\nrounded to $3$ decimal places."} :step/id #uuid "a6a9e584-e23b-5f27-aa56-050dc0d31fff" :step/next {:db/id #edb/ref 17592186437143}} {:db/id #edb/ref 17592186437143 :step/content {:db/id #edb/ref 17592186437139 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16527557-36e3-5765-85fe-85ad503bd10f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.907" :db/id #edb/ref 17592186437114} {:answer/id #uuid "4e7ef5fa-25a0-50e1-8283-427fee96d7fc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.890" :db/id #edb/ref 17592186437117} {:answer/id #uuid "9b51b374-afa5-5992-b9cf-b6d3ff5216f4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.904" :db/id #edb/ref 17592186437124} {:answer/id #uuid "c22b8e86-37a9-5abd-9b15-d5deb571c1ae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.881" :db/id #edb/ref 17592186437127} {:answer/id #uuid "ed10d1fe-7030-5542-b1f6-229aafd2780f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.981" :db/id #edb/ref 17592186437129}] :answer-field/correct {:db/id #edb/ref 17592186437129} :answer-field/id #uuid "6fbd0a6e-1d11-5207-93f7-e444bfce1656" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186437132}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c5edc979-6530-503b-9c43-a29e848f0191" :question/math-academy-id "q-131281" :question/problem "Previous results indicate that, on average, for each batch of transistors, $1$ is defective. What is the probability that in the next batch of transistors, there will be less than $4$ defective transistors? Round your answer to $3$ decimal places. You may assume that defective transistors occur independently and at a constant average rate." :question/worked-solution "A Poisson random variable $X$ with rate $\\lambda $ has the following probability mass function:\n\n$$\nf(x)=\\frac{{\\lambda }^{x}{e}^{-\\lambda }}{x!}\n$$\n\nLet $X$ be the number of defective transistors in a batch of transistors. Since the average rate is $1$ defective transistors per batch, and events occur independently and at a constant average rate, the number of defective transistors can be modeled as a Poisson random variable with rate $\\lambda =1,$ and we can write $X∼\\text{Po}(1).$\n\nSo, $X$ has the following probability mass function:\n\n$$\nf(x)=\\frac{{1}^{x}{e}^{-1}}{x!}\n$$\n\nTherefore, the probability that in the next batch of transistors, there will be less than $4$ defective transistors is\n\n$$\n\\begin{aligned}P(X<4) & =P(X\\in \\{0,1,2,3\\}) \\\\  & =f(0)+f(1)+f(2)+f(3) \\\\  & =\\frac{{1}^{0}{e}^{-1}}{0!}+\\frac{{1}^{1}{e}^{-1}}{1!}+\\frac{{1}^{2}{e}^{-1}}{2!}+\\frac{{1}^{3}{e}^{-1}}{3!} \\\\  & ≈0.981\\end{aligned}\n$$\n\nrounded to $3$ decimal places."} :step/id #uuid "db7e6473-de0a-51cd-a4c0-7c7adca3341e"} {:db/id #edb/ref 17592186437144 :step/content {:db/id #edb/ref 17592186437136 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "103af267-4448-5f1d-b2c7-5d3a6eb5caa1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.132" :db/id #edb/ref 17592186437113} {:answer/id #uuid "5546866d-cf0c-5f34-a20b-0d37698b92d2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.050" :db/id #edb/ref 17592186437119} {:answer/id #uuid "7a864749-ecf3-5067-80f4-653b14e5fe85" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.018" :db/id #edb/ref 17592186437121} {:answer/id #uuid "9cc7c554-abbe-5a01-96eb-fd4a8610edf5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.122" :db/id #edb/ref 17592186437125} {:answer/id #uuid "d4920049-b97d-5e34-bd87-a602c7c19c73" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.034" :db/id #edb/ref 17592186437128}] :answer-field/correct {:db/id #edb/ref 17592186437119} :answer-field/id #uuid "c35bc065-fcec-52cb-96c4-b81be5324354" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186437135}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "033d05af-1912-5a6e-86f3-f9dda400af0a" :question/math-academy-id "q-131102" :question/problem "A company rents cars to tourists. On average, there have been $3$ rental requests each day. What is the probability that none of the cars are rented the next day? Round your answer to $3$ decimal places. You may assume that rental requests occur independently and at a constant average rate." :question/worked-solution "A Poisson random variable $X$ with rate $\\lambda $ has the following probability mass function:\n\n$$\nf(x)=\\frac{{\\lambda }^{x}{e}^{-\\lambda }}{x!}\n$$\n\nLet $X$ be the number of cars rented in a day. Since the average rate is $3$ requests per day, and events occur independently and at a constant average rate, the number of rented cars can be modeled as a Poisson random variable with rate $\\lambda =3,$ and we can write $X∼\\text{Po}(3).$\n\nSo, $X$ has the following probability mass function:\n\n$$\nf(x)=\\frac{{3}^{x}{e}^{-3}}{x!}\n$$\n\nTherefore, the probability that none of the cars are rented the next day is\n\n$$\n\\begin{aligned}P(X=0) & =f(0) \\\\  & =\\frac{{3}^{0}{e}^{-3}}{0!} \\\\  & ≈0.050\\end{aligned}\n$$\n\nrounded to $3$ decimal places."} :step/id #uuid "f54fa653-ea98-5ece-9516-abf27f41ad60" :step/next {:db/id #edb/ref 17592186437142}}] :activity/title "Modeling With the Poisson Distribution" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186437111}] [{:activity/expected-seconds 900.0 :activity/first-step {:db/id #edb/ref 17592186120711} :activity/id #uuid "8313edbb-dabc-5be6-9269-6a1622b71d3d" :activity/scope {:db/id #edb/ref 17592186049436 :topic/id #uuid "f5218ca7-a9d3-5ad9-b17a-ee16b6e2b34a" :topic/math-academy-id 1805} :activity/steps [{:db/id #edb/ref 17592186120711 :step/content {:db/id #edb/ref 17592186121049 :tutorial/content "Suppose we know that a plane $\\Pi$ passes through the point $P(1,1,2)$ and that the vector $\\mathbf{n}=\\langle 0,0,3 \\rangle$ is perpendicular to the plane. Let's write down an equation of this plane using the dot product.\n\n![](images/0f/0f8353480099369ad92701d1799f72d46eab4bbe5c17add8cb37a4f34074311b.png)\n\nWe start by considering an arbitrary point $R(x,y,z)$ that lies on the plane. The position vectors of the points $R$ and $P$ are $\\mathbf{r}=\\langle x,y,z \\rangle$ and $\\mathbf{p}=\\langle 1,1,2 \\rangle$ respectively. So, the vector\n\n$$\n\\begin{aligned}\\overset{\\to }{PR} & =r-p \\\\  & =r-⟨1,1,2⟩\\end{aligned}\n$$\n\nis parallel to the plane. Therefore, $\\overrightarrow{PR} \\perp \\mathbf{n},$ as shown below.\n\n![](images/28/28b6770bd681257b1030679a421b80e3f3d1e8fbb86d2060b64c7301d0878c5c.png)\n\nNow, recall that if two nonzero vectors are perpendicular, then their dot product is zero:\n\n$$\n\\overrightarrow{PR}\\perp \\mathbf{n} \\quad \\Leftrightarrow \\quad \\overrightarrow{PR}\\cdot \\mathbf{n} = 0\n$$\n\nSo, we get the equation\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0.\\end{aligned}\n$$\n\nThis equation is called the **vector equation of the plane** that passes through the point $P(x_0,y_0,z_0)$ and is perpendicular to the vector $\\mathbf{n}.$ In our case, we obtain\n\n$$\n(\\mathbf{r} - \\langle 1,1,2 \\rangle) \\cdot \\langle 0,0,3 \\rangle = 0.\n$$\n\n**Note:** Using the properties of the dot product, we can arrive at an alternative vector equation given by\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n-p\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot n & =c\\end{aligned}\n$$\n\nwhere $c = \\mathbf{p} \\cdot \\mathbf{n}$ is a (scalar) constant." :tutorial/id #uuid "77d83d72-9202-50d7-af28-72062f00bfa5" :tutorial/math-academy-id 3255 :tutorial/title "Introduction"} :step/id #uuid "cf165cc4-ae6c-564d-b8e6-051c7aba1faa" :step/math-academy-id 17917 :step/next {:db/id #edb/ref 17592186120712}} {:db/id #edb/ref 17592186120712 :step/content {:db/id #edb/ref 17592186119829 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119640 :question/id #uuid "ba897e22-8104-5772-a0d3-9b062f3592f1" :question/math-academy-id "e-4932"} :knowledge-point/id #uuid "3f5c9c30-1745-5986-b116-e9e70a7c6161" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048954}] :knowledge-point/questions [{:db/id #edb/ref 17592186120217} {:db/id #edb/ref 17592186120222} {:db/id #edb/ref 17592186262809} {:db/id #edb/ref 17592186304808} {:db/id #edb/ref 17592186304818} {:db/id #edb/ref 17592186308388} {:db/id #edb/ref 17592186308412} {:db/id #edb/ref 17592186390848} {:db/id #edb/ref 17592186392994} {:db/id #edb/ref 17592186413463} {:db/id #edb/ref 17592186413464} {:db/id #edb/ref 17592186423177}] :knowledge-point/title "Finding the Vector Equation of the Plane Perpendicular to a Given Vector"} :step/id #uuid "e689c57c-a11c-582d-bed2-1b5777ad003d" :step/math-academy-id 17918 :step/next {:db/id #edb/ref 17592186120870}} {:db/id #edb/ref 17592186120713 :step/content {:db/id #edb/ref 17592186119830 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119641 :question/id #uuid "a33f6c43-4e25-5d67-9f73-ca99a18fb434" :question/math-academy-id "e-4933"} :knowledge-point/id #uuid "b0d93156-f9be-5e6e-976a-bef30dc892ee" :knowledge-point/questions [{:db/id #edb/ref 17592186120248} {:db/id #edb/ref 17592186120508} {:db/id #edb/ref 17592186262837} {:db/id #edb/ref 17592186262838} {:db/id #edb/ref 17592186262846} {:db/id #edb/ref 17592186262847} {:db/id #edb/ref 17592186308389} {:db/id #edb/ref 17592186338827} {:db/id #edb/ref 17592186338828} {:db/id #edb/ref 17592186338829} {:db/id #edb/ref 17592186338830} {:db/id #edb/ref 17592186338831} {:db/id #edb/ref 17592186393029} {:db/id #edb/ref 17592186420153} {:db/id #edb/ref 17592186445224}] :knowledge-point/title "Finding a Vector That Is Parallel To a Plane"} :step/id #uuid "36217cb6-2731-5a89-84ce-0738c511b417" :step/math-academy-id 17919 :step/next {:db/id #edb/ref 17592186120714}} {:db/id #edb/ref 17592186120714 :step/content {:db/id #edb/ref 17592186119831 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119642 :question/id #uuid "43586a83-879c-5caf-9063-a8f4afbb8b4c" :question/math-academy-id "e-4935"} :knowledge-point/id #uuid "45cdbb0d-2986-5c05-8d23-dce29363051b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048729}] :knowledge-point/questions [{:db/id #edb/ref 17592186120224} {:db/id #edb/ref 17592186120247} {:db/id #edb/ref 17592186262853} {:db/id #edb/ref 17592186262855} {:db/id #edb/ref 17592186262857} {:db/id #edb/ref 17592186262858} {:db/id #edb/ref 17592186262859} {:db/id #edb/ref 17592186308399} {:db/id #edb/ref 17592186338842} {:db/id #edb/ref 17592186338843} {:db/id #edb/ref 17592186387852} {:db/id #edb/ref 17592186391180} {:db/id #edb/ref 17592186393036} {:db/id #edb/ref 17592186393043} {:db/id #edb/ref 17592186413462}] :knowledge-point/title "Finding the Vector Equation of the Plane Perpendicular to a Given Straight Line"} :step/id #uuid "1b13bc4d-57be-5d17-841a-4f2645bc3982" :step/math-academy-id 17921} {:db/id #edb/ref 17592186120870 :step/content {:db/id #edb/ref 17592186121120 :tutorial/content "Suppose we have a plane with the following normal vector: \n\n$$\n\\mathbf{n}=\\langle -1,2,1 \\rangle\n$$\n\nLet's use the scalar product to find a vector that is parallel to this plane.\n\nWe denote our parallel vector as $\\mathbf{v} = \\langle t_1,t_2,t_3 \\rangle.$ Now, since $\\mathbf{v} \\perp \\mathbf{n},$ we must have\n\n$$\n\\begin{aligned}v\\cdot n & =0 \\\\ ⟨{t}_{1},{t}_{2},{t}_{3}⟩\\cdot ⟨-1,2,1⟩ & =0 \\\\ -{t}_{1}+2{t}_{2}+{t}_{3} & =0\\end{aligned}\n$$\n\nWe now need to find a nonzero solution to this equation. To do that, we solve the equation for *one* of the variables (it doesn't matter which one). For example, let's solve our equation for the variable $t_1\\mathbin{:}$\n\n$$\n\\begin{aligned}{t}_{1} & =2{t}_{2}+{t}_{3}\\end{aligned}\n$$\n\nHere, the variable $t_1$ depends on $t_2$ and $t_3,$ which, in turn, can be *any* real numbers. The variables $t_2$ and $t_3$ are called **free variables**.\n\nHence, the general form of our vector $\\mathbf{v}$ is\n\n$$\n\\mathbf{v}=\\langle 2t_2+t_3, \\, t_2, \\, t_3 \\rangle,\n$$\n\nwhere $t_2, t_3 \\in (-\\infty,\\infty).$\n\nTo find a particular vector parallel to the plane, we can substitute any values for $t_2$ and $t_3\\mathbin{:}$\n\n- For example, setting $t_2=0$ and $t_3=1$, we get\n\n$$\n\\mathbf{v}_1= \\langle 1, 0, 1 \\rangle.\n$$\n\n- Or, we could set $t_2=1$ and $t_3=0$ and get\n\n$$\n\\mathbf{v}_2 = \\langle 2, 1, 0 \\rangle.\n$$\n\n**Note:** There are infinitely many vectors parallel to a given plane. In our example, we found only two particular vectors." :tutorial/id #uuid "980ef6f4-542d-5915-84b8-e34f4480ae68" :tutorial/math-academy-id 6411 :tutorial/title "A Vector Parallel To a Plane"} :step/id #uuid "69d22458-d2d5-5c3d-b6fb-4714f2ea1b49" :step/math-academy-id 38733 :step/next {:db/id #edb/ref 17592186120713}}] :activity/title "The Vector Equation of a Plane" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186120016}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186420157} :activity/id #uuid "77095dee-04b2-5198-bba9-43f589fc9964" :activity/scope {:db/id #edb/ref 17592186049436 :topic/id #uuid "f5218ca7-a9d3-5ad9-b17a-ee16b6e2b34a" :topic/math-academy-id 1805} :activity/steps [{:db/id #edb/ref 17592186420154 :step/content {:db/id #edb/ref 17592186393043 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "493da2a3-c2b1-5d90-946c-32226dc19e64" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨3,-5,-2⟩=⟨-3,4,-1⟩" :db/id #edb/ref 17592186393045} {:answer/id #uuid "dc7fa3af-d391-569e-bc17-106f3e9396bf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨-3,4,-1⟩=⟨3,-5,-2⟩" :db/id #edb/ref 17592186393046} {:answer/id #uuid "8fe2b282-7f73-5949-a7f3-cc5ddf1e2530" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨-3,4,-1⟩=0" :db/id #edb/ref 17592186393047} {:answer/id #uuid "949e581b-c362-5470-828e-687788c962cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨3,-5,-2⟩=-27" :db/id #edb/ref 17592186393048} {:answer/id #uuid "1521f0fb-a511-5bc0-893e-2c6a06cceff9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨-3,4,-1⟩=-27" :db/id #edb/ref 17592186393049}] :answer-field/correct {:db/id #edb/ref 17592186393049} :answer-field/id #uuid "31ef96c8-9198-5e30-8832-aa55a71dc6d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186393044}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "ca2b2271-1ec0-5a3e-b5ac-687d91668797" :question/math-academy-id "q-70895" :question/problem "Find an equation of the plane that passes through the point $P(3,-5,-2)$ and is perpendicular to the line \n\n$$\n\\{\\begin{aligned}x=2-3t \\\\ y=3+4t \\\\ z=4-t.\\end{aligned}\n$$" :question/worked-solution "Note that the position vector of $P$ is $p=⟨3,-5,-2⟩.$ Converting the parametric equations of the line to vector form, we get\n\n$$\n\\{\\begin{aligned}x=2-3t \\\\ y=3+4t \\\\ z=4-t\\end{aligned}\\,⟹\\,⟨x,y,z⟩=⟨2,3,4⟩+t\\text{ }{{⟨-3,4,-1⟩}_{⏟}}_{v}.\n$$\n\n \n\nThe direction vector of the line is $v=⟨-3,4,-1⟩,$ so a normal vector to the plane is \n\n$$\nn=v=⟨-3,4,-1⟩.\n$$\n\nTherefore, the equation of the plane is given by\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n-p\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨-3,4,-1⟩ & =⟨3,-5,-2⟩\\cdot ⟨-3,4,-1⟩ \\\\ r\\cdot ⟨-3,4,-1⟩ & =-27.\\end{aligned}\n$$"} :step/id #uuid "6262b847-bfad-5541-b7d9-0c48d99eb024" :step/next {:db/id #edb/ref 17592186420155}} {:db/id #edb/ref 17592186420155 :step/content {:db/id #edb/ref 17592186262846 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1066db60-12af-5e82-a7c0-d24afa450e35" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{7}" :db/id #edb/ref 17592186260024} {:answer/id #uuid "336d23d9-d848-54ca-86e6-782c1b13a369" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186260339} {:answer/id #uuid "6bfd83ea-5bb5-57e7-b814-e0e365ce1b44" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186260820} {:answer/id #uuid "d4093fa7-7b24-5445-bf63-718de7a82e0c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186261744} {:answer/id #uuid "f03309e1-ca15-5335-aab5-a2535a4337a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186261981}] :answer-field/correct {:db/id #edb/ref 17592186260339} :answer-field/id #uuid "f46674a6-7e2b-5656-b018-7f5bf5e7afa0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186262547}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "aa3bed00-1af4-5c46-8c12-264209634c51" :question/math-academy-id "q-127910" :question/problem "A nonzero vector $⟨a,\\,0,\\,c⟩$ is parallel to the plane $r\\cdot ⟨-1,1,3⟩=\\sqrt{7}.$ What is the value of $\\frac{a}{c}?$" :question/worked-solution "We need a vector $v=⟨{t}_{1},{t}_{2},{t}_{3}⟩$ that is parallel to the given plane. \n\nFrom the equation $r\\cdot ⟨-1,1,3⟩=\\sqrt{7}$ of the plane, we get the normal vector $n=⟨-1,1,3⟩.$ So, $v⊥n$ and we have the following:\n\n$$\n\\begin{aligned}v\\cdot n & =0 \\\\ ⟨{t}_{1},{t}_{2},{t}_{3}⟩\\cdot ⟨-1,1,3⟩ & =0 \\\\ -{t}_{1}+{t}_{2}+3{t}_{3} & =0 \\\\ {t}_{1} & ={t}_{2}+3{t}_{3}\\end{aligned}\n$$\n\nHence, we obtain \n\n$$\nv=⟨{t}_{2}+3{t}_{3},\\,{t}_{2},{t}_{3}⟩,\n$$\n\nwhere ${t}_{2},{t}_{3}\\in (-\\infty ,\\infty ).$ \n\nWe are told that the second component of $v$ equals $0.$ So, we must set ${t}_{2}=0.$ \n\nSince $v$ is nonzero, we can pick any ${t}_{3}\\ne 0.$ For example, setting ${t}_{3}=1$, we get\n\n$$\nv=⟨3,\\,0,\\,1⟩.\n$$\n\nTherefore, $\\frac{a}{c}=3.$"} :step/id #uuid "6f1edd60-137c-5af0-bf08-f3f3e9df0344" :step/next {:db/id #edb/ref 17592186420156}} {:db/id #edb/ref 17592186420156 :step/content {:db/id #edb/ref 17592186420153 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b182a09-cc9d-51c4-95fe-e78790ecf72a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186420142} {:answer/id #uuid "36cb63bc-ae79-51e4-b5ab-3039c42340e0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186420143} {:answer/id #uuid "4173b538-e381-5dd5-b0c5-10dc2eaa96c4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186420144} {:answer/id #uuid "502b671f-b1be-5d29-8f96-08571a87d173" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186420145} {:answer/id #uuid "72001519-6957-56f0-b511-f27a9ed3c85f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186420146}] :answer-field/correct {:db/id #edb/ref 17592186420143} :answer-field/id #uuid "f9a0d8dd-871f-5fc8-9699-7a78c5f80aac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186420152}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3fa29ff6-5ae4-5642-82fd-03b1645e810c" :question/math-academy-id "q-127921" :question/problem "A nonzero vector $⟨0,\\,b,\\,c⟩$ is parallel to the plane $r\\cdot ⟨5,-1,3⟩=27.$ What is the value of $\\frac{b}{c}?$" :question/worked-solution "We need a vector $v=⟨{t}_{1},{t}_{2},{t}_{3}⟩$ that is parallel to the given plane. \n\nFrom the equation $r\\cdot ⟨5,-1,3⟩=27$ of the plane, we get the normal vector $n=⟨5,-1,3⟩.$ So, $v⊥n$ and we have the following:\n\n$$\n\\begin{aligned}v\\cdot n & =0 \\\\ ⟨{t}_{1},{t}_{2},{t}_{3}⟩\\cdot ⟨5,-1,3⟩ & =0 \\\\ 5{t}_{1}-{t}_{2}+3{t}_{3} & =0 \\\\ {t}_{2} & =5{t}_{1}+3{t}_{3}\\end{aligned}\n$$\n\nHence, we obtain \n\n$$\nv=⟨{t}_{1},\\,5{t}_{1}+3{t}_{3},\\,{t}_{3}⟩,\n$$\n\nwhere ${t}_{1},{t}_{3}\\in (-\\infty ,\\infty ).$ \n\nWe are told that the first component of $v$ equals $0.$ So, we must set ${t}_{1}=0.$ \n\nSince $v$ is nonzero, we can pick any ${t}_{3}\\ne 0.$ For example, setting ${t}_{3}=1$, we get\n\n$$\nv=⟨0,\\,3,\\,1⟩.\n$$\n\nTherefore, $\\frac{b}{c}=3.$"} :step/id #uuid "7c175861-cf16-5bce-9a3d-7dd7700bfeb3" :step/next {:db/id #edb/ref 17592186420158}} {:db/id #edb/ref 17592186420157 :step/content {:db/id #edb/ref 17592186120224 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7a8f836e-b1bd-5929-a0d4-cc62e2406547" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨2,-3,5⟩=-11" :db/id #edb/ref 17592186420147} {:answer/id #uuid "8f5b6228-4151-5fb7-a8b8-4defb3112da4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨-2,0,3⟩=11" :db/id #edb/ref 17592186420148} {:answer/id #uuid "ab54b251-064b-57d4-8fc1-3a45c6f498e7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨2,-3,5⟩=⟨-2,0,3⟩" :db/id #edb/ref 17592186420149} {:answer/id #uuid "b05ca4a9-4343-56a3-86ae-980793c8602f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨-2,0,3⟩=⟨2,-3,5⟩" :db/id #edb/ref 17592186420150} {:answer/id #uuid "f59eba3d-6e2f-504f-905a-a227d63c2c42" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨2,-3,5⟩=11" :db/id #edb/ref 17592186420151}] :answer-field/correct {:db/id #edb/ref 17592186420148} :answer-field/id #uuid "b2947f04-3e78-507e-b09a-00ccebdf73ba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186117505}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ee828cf7-8b80-575c-a644-51d699464b23" :question/math-academy-id "q-33037" :question/problem "Find an equation of the plane that passes through the point $Q(2,-3,5)$ and is perpendicular to the line that goes through the points \n$A(3,2,-8)$ and $B(1,2,-5).$" :question/worked-solution "First, we note that the position vector of $Q$ is $q=⟨2,-3,5⟩.$\n\nSince the line  passes through the points $A(3,2,-8)$ and $B(1,2,-5)$, we can find a vector that is parallel to the line:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =⟨1,2,-5⟩-⟨3,2,-8⟩ \\\\  & =⟨-2,0,3⟩\\end{aligned}\n$$\n\n \n\nSo, a normal vector to the plane is $n=⟨-2,0,3⟩.$\n\nTherefore, the equation of the plane is given by \n\n$$\n\\begin{aligned}(r-q)\\cdot n & =0 \\\\ r\\cdot n-q\\cdot n & =0 \\\\ r\\cdot n & =q\\cdot n \\\\ r\\cdot ⟨-2,0,3⟩ & =⟨2,-3,5⟩\\cdot ⟨-2,0,3⟩ \\\\ r\\cdot ⟨-2,0,3⟩ & =11.\\end{aligned}\n$$"} :step/id #uuid "8d1b2442-6684-5f23-a6d5-881beb105644" :step/next {:db/id #edb/ref 17592186420154}} {:db/id #edb/ref 17592186420158 :step/content {:db/id #edb/ref 17592186262859 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "65e4dacb-b64f-5663-ae54-844ec9e37c4a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨1,-2,4⟩=22" :db/id #edb/ref 17592186260760} {:answer/id #uuid "a344d6d0-c843-57a0-87ed-6643487a6ce9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨-2,2,1⟩=12" :db/id #edb/ref 17592186261298} {:answer/id #uuid "a5b752a4-52ea-54e2-96dc-81dc14098d76" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨4,-2,1⟩=18" :db/id #edb/ref 17592186261313} {:answer/id #uuid "aa9815dd-2b59-5495-91a4-c387e6882786" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨1,-4,-2⟩=8" :db/id #edb/ref 17592186261371} {:answer/id #uuid "c0f71bee-c234-59c3-9e78-d739bf030e68" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨2,-2,1⟩=15" :db/id #edb/ref 17592186261577}] :answer-field/correct {:db/id #edb/ref 17592186261577} :answer-field/id #uuid "4e498358-75ca-5ef1-ae02-06dee6634086" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186262265}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "7885abf5-baa7-59dd-be20-bec3451c5be4" :question/math-academy-id "q-127956" :question/problem "Find an equation of the plane that passes through the point $Q(4,-2,3)$ and is  perpendicular to the line \n\n$$\n{\\begin{aligned}x=-1+2t \\\\ y=3-2t \\\\ z=5+t.\\end{aligned}\n$$" :question/worked-solution "Note that the position vector of $Q$ is $q=⟨4,-2,3⟩.$ Converting the parametric equations of the line to vector form, we get\n\n$$\n{\\begin{aligned}x=-1+2t \\\\ y=3-2t \\\\ z=5+t\\end{aligned}\\,⇒\\,⟨x,y,z⟩=⟨-1,3,5⟩+t\\text{ }{{⟨2,-2,1⟩}_{⏟}}_{v}.\n$$\n\n   \n\nThe direction vector of the line is $v=⟨2,-2,1⟩.$ So, a normal  vector to the plane is \n\n$$\nn=v=⟨2,-2,1⟩.\n$$\n\n \n\nTherefore, the equation of the plane is given by\n\n$$\n\\begin{aligned}(r-q)\\cdot n & =0 \\\\ r\\cdot n-q\\cdot n & =0 \\\\ r\\cdot n & =q\\cdot n \\\\ r\\cdot ⟨2,-2,1⟩ & =⟨4,-2,3⟩\\cdot ⟨2,-2,1⟩ \\\\ r\\cdot ⟨2,-2,1⟩ & =15.\\end{aligned}\n$$"} :step/id #uuid "f1fe54dc-0b25-528c-81fb-caa7a89e418f"}] :activity/title "The Vector Equation of a Plane" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186420141}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186423181} :activity/id #uuid "68a08d63-69d2-59f4-855e-ab9c40ae1bca" :activity/scope {:db/id #edb/ref 17592186049436 :topic/id #uuid "f5218ca7-a9d3-5ad9-b17a-ee16b6e2b34a" :topic/math-academy-id 1805} :activity/steps [{:db/id #edb/ref 17592186423178 :step/content {:db/id #edb/ref 17592186338831 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ad3af79-fcd3-5749-b0e5-9411379a50d2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186336721} {:answer/id #uuid "886c099c-bd36-506a-9021-b550fe0b57c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186337264} {:answer/id #uuid "926d8af8-a19c-5443-bbf7-6f269886e17b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186337364} {:answer/id #uuid "d60f66f3-48fa-5ebf-837a-e090ca7d3d6a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186337896} {:answer/id #uuid "d99cfee8-de55-5ea6-8c2e-3385468433bb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186337925}] :answer-field/correct {:db/id #edb/ref 17592186337896} :answer-field/id #uuid "7727c896-6f1b-5615-b00c-42ad7fd27f9f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186338483}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e0327785-b28b-5842-b652-0805899123b3" :question/math-academy-id "q-70830" :question/problem "A nonzero vector $⟨a,\\,b,\\,0⟩$ is parallel to the plane $r\\cdot ⟨-1,1,-3⟩=8.$ What is the value of $\\frac{a}{b}?$" :question/worked-solution "We need a vector $v=⟨{t}_{1},{t}_{2},{t}_{3}⟩$ that is parallel to the given plane. \n\nFrom the equation $r\\cdot ⟨-1,1,-3⟩=8$ of the plane, we get the normal vector $n=⟨-1,1,-3⟩.$ So, $v⊥n$ and we have the following:\n\n$$\n\\begin{aligned}v\\cdot n & =0 \\\\ ⟨{t}_{1},{t}_{2},{t}_{3}⟩\\cdot ⟨-1,1,-3⟩ & =0 \\\\ -{t}_{1}+{t}_{2}-3{t}_{3} & =0 \\\\ {t}_{2} & ={t}_{1}+3{t}_{3}\\end{aligned}\n$$\n\nHence, we obtain \n\n$$\nv=⟨{t}_{1},{t}_{1}+3{t}_{3},{t}_{3}⟩,\n$$\n\nwhere ${t}_{1},{t}_{3}\\in (-\\infty ,\\infty ).$ \n\nWe are told that the third component of $v$ equals $0.$ So, we must set ${t}_{3}=0.$ \n\nSince $v$ is nonzero, we can pick any ${t}_{1}\\ne 0.$ For example, setting ${t}_{1}=1$, we get\n\n$$\nv=⟨1,\\,1,\\,0⟩.\n$$\n\nTherefore, $\\frac{a}{b}=1.$"} :step/id #uuid "0ecb2ec2-22d0-5b28-bc73-c57c70725e45" :step/next {:db/id #edb/ref 17592186423179}} {:db/id #edb/ref 17592186423179 :step/content {:db/id #edb/ref 17592186393043 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "493da2a3-c2b1-5d90-946c-32226dc19e64" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨3,-5,-2⟩=⟨-3,4,-1⟩" :db/id #edb/ref 17592186393045} {:answer/id #uuid "dc7fa3af-d391-569e-bc17-106f3e9396bf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨-3,4,-1⟩=⟨3,-5,-2⟩" :db/id #edb/ref 17592186393046} {:answer/id #uuid "8fe2b282-7f73-5949-a7f3-cc5ddf1e2530" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨-3,4,-1⟩=0" :db/id #edb/ref 17592186393047} {:answer/id #uuid "949e581b-c362-5470-828e-687788c962cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨3,-5,-2⟩=-27" :db/id #edb/ref 17592186393048} {:answer/id #uuid "1521f0fb-a511-5bc0-893e-2c6a06cceff9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨-3,4,-1⟩=-27" :db/id #edb/ref 17592186393049}] :answer-field/correct {:db/id #edb/ref 17592186393049} :answer-field/id #uuid "31ef96c8-9198-5e30-8832-aa55a71dc6d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186393044}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "ca2b2271-1ec0-5a3e-b5ac-687d91668797" :question/math-academy-id "q-70895" :question/problem "Find an equation of the plane that passes through the point $P(3,-5,-2)$ and is perpendicular to the line \n\n$$\n\\{\\begin{aligned}x=2-3t \\\\ y=3+4t \\\\ z=4-t.\\end{aligned}\n$$" :question/worked-solution "Note that the position vector of $P$ is $p=⟨3,-5,-2⟩.$ Converting the parametric equations of the line to vector form, we get\n\n$$\n\\{\\begin{aligned}x=2-3t \\\\ y=3+4t \\\\ z=4-t\\end{aligned}\\,⟹\\,⟨x,y,z⟩=⟨2,3,4⟩+t\\text{ }{{⟨-3,4,-1⟩}_{⏟}}_{v}.\n$$\n\n \n\nThe direction vector of the line is $v=⟨-3,4,-1⟩,$ so a normal vector to the plane is \n\n$$\nn=v=⟨-3,4,-1⟩.\n$$\n\nTherefore, the equation of the plane is given by\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n-p\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨-3,4,-1⟩ & =⟨3,-5,-2⟩\\cdot ⟨-3,4,-1⟩ \\\\ r\\cdot ⟨-3,4,-1⟩ & =-27.\\end{aligned}\n$$"} :step/id #uuid "2c8b595f-b1a8-514e-9b95-bb539ab93fc0" :step/next {:db/id #edb/ref 17592186423180}} {:db/id #edb/ref 17592186423180 :step/content {:db/id #edb/ref 17592186262855 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0387b95b-ea4c-5624-9fdd-7d44aae31856" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨3,1,1⟩=12" :db/id #edb/ref 17592186259907} {:answer/id #uuid "ad85ebfc-775c-5bdb-a5e6-836a5963e43c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨1,1,5⟩=9" :db/id #edb/ref 17592186261395} {:answer/id #uuid "b2a79415-12c6-5171-8ecf-e701971bbaad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨1,3,1⟩=12" :db/id #edb/ref 17592186261452} {:answer/id #uuid "d9ba12b0-dcfe-5c43-b282-17a43fb1d275" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨5,1,1⟩=18" :db/id #edb/ref 17592186261796} {:answer/id #uuid "eb666347-2e39-5891-a53f-4830ffc6eb6f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨1,5,1⟩=9" :db/id #edb/ref 17592186261942}] :answer-field/correct {:db/id #edb/ref 17592186261796} :answer-field/id #uuid "207a2b37-6c4f-5b41-aa59-d8127027f268" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186262177}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "57b46f7d-b75a-5f5c-87e6-c8948d671ea4" :question/math-academy-id "q-127936" :question/problem "Find an equation of the plane that passes through the point $P(3,-2,5)$ and is perpendicular to the line that goes through the points \n$A(-3,0,2)$ and $B(2,1,3).$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨3,-2,5⟩.$\n\nSince the line  passes through the points $A(-3,0,2)$ and $B(2,1,3)$ we can find a vector parallel to the line:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =⟨2,1,3⟩-⟨-3,0,2⟩ \\\\  & =⟨5,1,1⟩.\\end{aligned}\n$$\n\n \n\nSo, a normal vector to the plane is $n=⟨5,1,1⟩.$\n\nTherefore, the equation of the plane is given by\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n-p\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨5,1,1⟩ & =⟨3,-2,5⟩\\cdot ⟨5,1,1⟩ \\\\ r\\cdot ⟨5,1,1⟩ & =18.\\end{aligned}\n$$"} :step/id #uuid "376b1716-abbb-51bb-97e6-b6e06c8b7140"} {:db/id #edb/ref 17592186423181 :step/content {:db/id #edb/ref 17592186423177 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "54c2e93d-88d9-55e5-8da7-a7c8857c95a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot [\\begin{aligned}0 \\\\ 1 \\\\ 1\\end{aligned}]=1" :db/id #edb/ref 17592186423171} {:answer/id #uuid "865e5880-5d6c-5eb8-b605-32023bca731a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot [\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]=0" :db/id #edb/ref 17592186423172} {:answer/id #uuid "88b7b35b-b8a9-55fa-b177-e46dd3a1176a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot [\\begin{aligned}0 \\\\ 1 \\\\ 1\\end{aligned}]=-1" :db/id #edb/ref 17592186423173} {:answer/id #uuid "c899f30d-448a-55d6-a220-50efc27da551" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot [\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]=1" :db/id #edb/ref 17592186423174} {:answer/id #uuid "f42a4087-cff6-5d2b-9264-832562c287ce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot [\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]=[\\begin{aligned}0 \\\\ 1 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186423175}] :answer-field/correct {:db/id #edb/ref 17592186423174} :answer-field/id #uuid "ed6bca43-1900-5519-94be-29cc1bb55d43" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186423176}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9509d4b2-8f43-5f25-8917-81a3d5d9b04d" :question/math-academy-id "q-33195" :question/problem "Find an equation of the plane that contains the point $P(0,1,1)$ and is perpendicular to the vector $n=[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}].$" :question/worked-solution "First, notice that the position vector of $P$ is $p=[\\begin{aligned}0 \\\\ 1 \\\\ 1\\end{aligned}]$ and $n=[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]$ is normal to the plane.\n\nThe equation of the plane that passes though the point $P({x}_{0},{y}_{0},{z}_{0})$ and is perpendicular to the vector $n$ can be given as\n\n$$\n(r-p)\\cdot n=0,\n$$\n\nwhere $r$ is the position vector of any point on the plane, and $p$ is the position vector of $P.$\n\nSo, we have\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n-p\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot [\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}] & =[\\begin{aligned}0 \\\\ 1 \\\\ 1\\end{aligned}]\\cdot [\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}] \\\\ r\\cdot [\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}] & =1.\\end{aligned}\n$$"} :step/id #uuid "3ecf110e-e7e0-5add-b305-ad1bf6c365c5" :step/next {:db/id #edb/ref 17592186423182}} {:db/id #edb/ref 17592186423182 :step/content {:db/id #edb/ref 17592186393029 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c4fb71df-948c-5126-86b0-9d79cb4c0fee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186393031} {:answer/id #uuid "75ed4713-5dc0-5929-8f1a-ae29368dccf9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186393032} {:answer/id #uuid "14d6c7a2-54c1-5ce2-9906-4d55cf87f498" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186393033} {:answer/id #uuid "32938842-cdd7-5118-b60e-0c5d24a27836" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186393034} {:answer/id #uuid "ea4da8ff-198b-50e0-8319-7a9af39b8918" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186393035}] :answer-field/correct {:db/id #edb/ref 17592186393032} :answer-field/id #uuid "b14d7746-5f36-5ef0-9936-be22c8877f39" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186393030}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ee04e6aa-94ba-5e6d-a904-4a34aac7a757" :question/math-academy-id "q-70827" :question/problem "A nonzero vector $⟨0,\\,b,\\,c⟩$ is parallel to the plane $r\\cdot ⟨1,2,-1⟩=7.$ What is the value of $\\frac{b}{c}?$" :question/worked-solution "We need a vector $v=⟨{t}_{1},{t}_{2},{t}_{3}⟩$ that is parallel to the given plane. \n\nFrom the equation $r\\cdot ⟨1,2,-1⟩=7$ of the plane, we get the normal vector $n=⟨1,2,-1⟩.$ So, $v⊥n$ and we have the following:\n\n$$\n\\begin{aligned}v\\cdot n & =0 \\\\ ⟨{t}_{1},{t}_{2},{t}_{3}⟩\\cdot ⟨1,2,-1⟩ & =0 \\\\ {t}_{1}+2{t}_{2}-{t}_{3} & =0 \\\\ {t}_{3} & ={t}_{1}+2{t}_{2}\\end{aligned}\n$$\n\nHence, we obtain \n\n$$\nv=⟨{t}_{1},\\,{t}_{2},\\,{t}_{1}+2{t}_{2}⟩,\n$$\n\nwhere ${t}_{1},{t}_{2}\\in (-\\infty ,\\infty ).$ \n\nWe are told that the first component of $v$ equals $0.$ So, we must set ${t}_{1}=0.$ \n\nSince $v$ is nonzero, we can pick any ${t}_{2}\\ne 0.$ For example, setting ${t}_{2}=1$, we get\n\n$$\nv=⟨0,\\,1,\\,2⟩.\n$$\n\nTherefore, $\\frac{b}{c}=\\frac{1}{2}.$"} :step/id #uuid "55812343-3b60-5de3-98f2-95ffd7bd0ddb" :step/next {:db/id #edb/ref 17592186423178}}] :activity/title "The Vector Equation of a Plane" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186423170}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186442994} :activity/id #uuid "b4a03ddd-003b-5e8e-82c8-2cc43b396522" :activity/scope {:db/id #edb/ref 17592186049436 :topic/id #uuid "f5218ca7-a9d3-5ad9-b17a-ee16b6e2b34a" :topic/math-academy-id 1805} :activity/steps [{:db/id #edb/ref 17592186442991 :step/content {:db/id #edb/ref 17592186420153 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b182a09-cc9d-51c4-95fe-e78790ecf72a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186420142} {:answer/id #uuid "36cb63bc-ae79-51e4-b5ab-3039c42340e0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186420143} {:answer/id #uuid "4173b538-e381-5dd5-b0c5-10dc2eaa96c4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186420144} {:answer/id #uuid "502b671f-b1be-5d29-8f96-08571a87d173" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186420145} {:answer/id #uuid "72001519-6957-56f0-b511-f27a9ed3c85f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186420146}] :answer-field/correct {:db/id #edb/ref 17592186420143} :answer-field/id #uuid "f9a0d8dd-871f-5fc8-9699-7a78c5f80aac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186420152}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3fa29ff6-5ae4-5642-82fd-03b1645e810c" :question/math-academy-id "q-127921" :question/problem "A nonzero vector $⟨0,\\,b,\\,c⟩$ is parallel to the plane $r\\cdot ⟨5,-1,3⟩=27.$ What is the value of $\\frac{b}{c}?$" :question/worked-solution "We need a vector $v=⟨{t}_{1},{t}_{2},{t}_{3}⟩$ that is parallel to the given plane. \n\nFrom the equation $r\\cdot ⟨5,-1,3⟩=27$ of the plane, we get the normal vector $n=⟨5,-1,3⟩.$ So, $v⊥n$ and we have the following:\n\n$$\n\\begin{aligned}v\\cdot n & =0 \\\\ ⟨{t}_{1},{t}_{2},{t}_{3}⟩\\cdot ⟨5,-1,3⟩ & =0 \\\\ 5{t}_{1}-{t}_{2}+3{t}_{3} & =0 \\\\ {t}_{2} & =5{t}_{1}+3{t}_{3}\\end{aligned}\n$$\n\nHence, we obtain \n\n$$\nv=⟨{t}_{1},\\,5{t}_{1}+3{t}_{3},\\,{t}_{3}⟩,\n$$\n\nwhere ${t}_{1},{t}_{3}\\in (-\\infty ,\\infty ).$ \n\nWe are told that the first component of $v$ equals $0.$ So, we must set ${t}_{1}=0.$ \n\nSince $v$ is nonzero, we can pick any ${t}_{3}\\ne 0.$ For example, setting ${t}_{3}=1$, we get\n\n$$\nv=⟨0,\\,3,\\,1⟩.\n$$\n\nTherefore, $\\frac{b}{c}=3.$"} :step/id #uuid "3458e62b-8854-5734-859a-ce2619927743" :step/next {:db/id #edb/ref 17592186442995}} {:db/id #edb/ref 17592186442992 :step/content {:db/id #edb/ref 17592186387852 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "901763ea-91a4-5ccc-9fd1-7a5abd771549" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨2,2,3⟩=22" :db/id #edb/ref 17592186387854} {:answer/id #uuid "e471dd7f-cf5c-5449-bdd5-1669c5ee7ff8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨2,3,2⟩=14" :db/id #edb/ref 17592186387855} {:answer/id #uuid "be245f9d-2743-5776-a695-325f9e3f765e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨6,2,2⟩=16" :db/id #edb/ref 17592186387856} {:answer/id #uuid "e50391f5-f264-5d75-924b-8343f68bda37" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨3,2,2⟩=8" :db/id #edb/ref 17592186387857} {:answer/id #uuid "9c146846-53c1-5f64-8789-a2b060a469a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨2,6,2⟩=12" :db/id #edb/ref 17592186387858}] :answer-field/correct {:db/id #edb/ref 17592186387856} :answer-field/id #uuid "60a27afd-b25c-559e-94cd-93712349e320" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186387853}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "78e0dc1f-5e12-54f0-b00c-492a979933d2" :question/math-academy-id "q-127937" :question/problem "Find an equation of the plane that passes through the point $P(2,-1,3)$ and is perpendicular to the line that goes through the points \n$A(-4,1,3)$ and $B(2,3,5).$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨2,-1,3⟩.$\n\nSince the line  passes through the points $A(-4,1,3)$ and $B(2,3,5)$ we can find a vector parallel to the line:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =⟨2,3,5⟩-⟨-4,1,3⟩ \\\\  & =⟨6,2,2⟩.\\end{aligned}\n$$\n\n \n\nSo, a normal vector to the plane is $n=⟨6,2,2⟩.$\n\nTherefore, the equation of the plane is given by\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n-p\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨6,2,2⟩ & =⟨2,-1,3⟩\\cdot ⟨6,2,2⟩ \\\\ r\\cdot ⟨6,2,2⟩ & =16.\\end{aligned}\n$$"} :step/id #uuid "735f1d1f-3dd1-50b8-8d7c-9fcb22c5b1c7"} {:db/id #edb/ref 17592186442993 :step/content {:db/id #edb/ref 17592186338827 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7b4cf333-fb31-53e5-a3b2-4d1da8c129ea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186337143} {:answer/id #uuid "8699f13d-227d-54e9-8db2-f586a65cc4a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186337250} {:answer/id #uuid "8ed87010-5adf-5b37-aeca-2e7df330c813" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186337317} {:answer/id #uuid "92eae00f-5f08-53b6-b534-72b9e6866cbc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186337371} {:answer/id #uuid "a20a8aa3-4bd5-5bea-8e7e-61c74a32567a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186337501}] :answer-field/correct {:db/id #edb/ref 17592186337317} :answer-field/id #uuid "557fd6f3-4749-5c34-935d-a0b820019a0f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186338422}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "22393ec9-8250-54f3-ad30-3ecff187a9da" :question/math-academy-id "q-70814" :question/problem "A nonzero vector $⟨0,\\,b,\\,c⟩$ is parallel to the plane $r\\cdot ⟨1,-2,1⟩=10.$ What is the value of $\\frac{b}{c}?$" :question/worked-solution "We need a vector $v=⟨{t}_{1},{t}_{2},{t}_{3}⟩$ that is parallel to the given plane. \n\nFrom the equation $r\\cdot ⟨1,-2,1⟩=10$ of the plane, we get the normal vector $n=⟨1,-2,1⟩.$ So, $v⊥n$ and we have the following:\n\n$$\n\\begin{aligned}v\\cdot n & =0 \\\\ ⟨{t}_{1},{t}_{2},{t}_{3}⟩\\cdot ⟨1,-2,1⟩ & =0 \\\\ {t}_{1}-2{t}_{2}+{t}_{3} & =0 \\\\ {t}_{3} & =2{t}_{2}-{t}_{1}\\end{aligned}\n$$\n\nHence, we obtain \n\n$$\nv=[\\begin{aligned}{t}_{1} \\\\ {t}_{2} \\\\ 2{t}_{2}-{t}_{1}\\end{aligned}],\n$$\n\nwhere ${t}_{1},{t}_{2}\\in (-\\infty ,\\infty ).$ \n\nWe are told that the first component of $v$ equals $0.$ So, we must set ${t}_{1}=0.$ \n\nSince $v$ is nonzero, we can pick any ${t}_{2}\\ne 0.$ For example, setting ${t}_{2}=1$, we get\n\n$$\nv=⟨0,\\,1,\\,2⟩.\n$$\n\nTherefore, $\\frac{b}{c}=\\frac{1}{2}.$"} :step/id #uuid "9462b507-c0a1-5898-9afa-bb4186df83ec" :step/next {:db/id #edb/ref 17592186442991}} {:db/id #edb/ref 17592186442994 :step/content {:db/id #edb/ref 17592186120222 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1490998e-fd96-558a-92bf-90c3e1b1d823" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot (\\sqrt{2}i+3j+4k)=2\\sqrt{2}i+7j-6k" :db/id #edb/ref 17592186442986} {:answer/id #uuid "24bd5c51-ea5f-55c2-b7cc-0a1c6fdaf3e9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot (2\\sqrt{2}i+7j-6k)=\\sqrt{2}i+3j+4k" :db/id #edb/ref 17592186442987} {:answer/id #uuid "26e81e0f-00be-5150-9e74-fec4066ead13" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot (2\\sqrt{2}i+7j-6k)=1" :db/id #edb/ref 17592186442988} {:answer/id #uuid "d8a2f39f-065a-5b9a-9af2-2369637cc071" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot (2\\sqrt{2}i+7j-6k)=5" :db/id #edb/ref 17592186442989} {:answer/id #uuid "eead13a6-edac-5ccb-bd23-f3ae56dce20e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot (2\\sqrt{2}i+7j-6k)=-5" :db/id #edb/ref 17592186442990}] :answer-field/correct {:db/id #edb/ref 17592186442988} :answer-field/id #uuid "1ea9a67f-f999-5059-be26-16de635db5bd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186117493}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3aea6384-95f5-5566-a595-7a25ca576605" :question/math-academy-id "q-33029" :question/problem "Find an equation of the plane that contains the point $P(\\sqrt{2},3,4)$ and is perpendicular to the vector $n=2\\sqrt{2}i+7j-6k.$" :question/worked-solution "First, we note that the position vector of $P$ is $p=\\sqrt{2}i+3j+4k,$ and $n=2\\sqrt{2}i+7j-6k$ is normal to the plane.\n\nThe equation of the plane that passes through the point $P({x}_{0},{y}_{0},{z}_{0})$ and is perpendicular to the vector $n$ can be given as\n\n$$\n(r-p)\\cdot n=0,\n$$\n\nwhere $r$ is the position vector of any point on the plane, and $p$ is the position vector of $P.$\n\nSo, we have\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n-p\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot (2\\sqrt{2}i+7j-6k) & =(\\sqrt{2}i+3j+4k)\\cdot (2\\sqrt{2}i+7j-6k) \\\\ r\\cdot (2\\sqrt{2}i+7j-6k) & =1.\\end{aligned}\n$$"} :step/id #uuid "ad4d6328-8534-5210-8c4a-365882fe2824" :step/next {:db/id #edb/ref 17592186442993}} {:db/id #edb/ref 17592186442995 :step/content {:db/id #edb/ref 17592186262853 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1aa825cb-f5f2-5941-b18f-a35a9e8ffaab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨-4,-4,3⟩=11" :db/id #edb/ref 17592186260107} {:answer/id #uuid "394ffd1f-3104-5495-902a-37954445a0c9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨-4,3,4⟩=12" :db/id #edb/ref 17592186260385} {:answer/id #uuid "56cda873-6a65-51e4-b130-2eb9c208d8a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨3,4,4⟩=23" :db/id #edb/ref 17592186260617} {:answer/id #uuid "ce2cec22-6b83-56cf-81ae-8596b434a0ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨4,-3,4⟩=11" :db/id #edb/ref 17592186261696} {:answer/id #uuid "e6b3d4ad-159b-554b-a0a1-ef2fb9a85ed2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨3,-4,4⟩=23" :db/id #edb/ref 17592186261900}] :answer-field/correct {:db/id #edb/ref 17592186261900} :answer-field/id #uuid "7f4a93d8-207b-5307-acbb-b861f6a8320e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186262337}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9164c795-7f61-5d54-9538-2653e37cb486" :question/math-academy-id "q-127927" :question/problem "Find an equation of the plane that passes through the point $Q(1,-2,3)$ and is perpendicular to the line that goes through the points \n$A(4,1,-3)$ and $B(7,-3,1).$" :question/worked-solution "First, we note that the position vector of $Q$ is $q=⟨1,-2,3⟩.$\n\nSince the line  passes through the points $A(4,1,-3)$ and $B(7,-3,1)$, we can find a vector that is parallel to the line:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =⟨7,-3,1⟩-⟨4,1,-3⟩ \\\\  & =⟨3,-4,4⟩\\end{aligned}\n$$\n\n \n\nSo, a normal vector to the plane is $n=⟨3,-4,4⟩.$\n\nTherefore, the equation of the plane is given by \n\n$$\n\\begin{aligned}(r-q)\\cdot n & =0 \\\\ r\\cdot n-q\\cdot n & =0 \\\\ r\\cdot n & =q\\cdot n \\\\ r\\cdot ⟨3,-4,4⟩ & =⟨1,-2,3⟩\\cdot ⟨3,-4,4⟩ \\\\ r\\cdot ⟨3,-4,4⟩ & =23.\\end{aligned}\n$$"} :step/id #uuid "fb8f9fe8-2ed4-5d86-8099-75a35919ccad" :step/next {:db/id #edb/ref 17592186442992}}] :activity/title "The Vector Equation of a Plane" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186442985}]}
