            "source_file": "/tmp/capture-new-errors/repair-preview/database/source-evidence/e93adebfbe74f79cb240e3ffe91b484c7c407ba09f063661fe78c0ff641f9f3a.edn",
            "source_kind": "existing_edb_math_academy_answer",
            "basis": 2065,
