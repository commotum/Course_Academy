490d" #edb/ref 17592186045417] [17592186341774 #edb/ref 1075 #edb/ref 17592186339563 #edb/ref 17592186045417] [17592186341774 #edb/ref 1075 #edb/ref 17592186339761 #edb/ref 17592186045417] [17592186341774 #edb/ref 1075 #edb/ref 17592186340063 #edb/ref 17592186045417] [17592186341774 #edb/ref 1075 #edb/ref 17592186340166 #edb/ref 17592186045417] [17592186341774 #edb/ref 1075 #edb/ref 17592186340484 #edb/ref 17592186045417] [17592186341774 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186341774 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186341774 #edb/ref 1078 #edb/ref 17592186340063 #edb/ref 17592186045417] [17592186341774 #edb/ref 1079 #uuid "df4036f4-0b20-53ba-89f9-e6eee6e466b9" #edb/ref 17592186045417] [17592186342191 #edb/ref 1068 #edb/ref 17592186341774 #edb/ref 17592186045417] [17592186342191 #edb/ref 1069 "q-74255" #edb/ref 17592186045417] [17592186342191 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186342191 #edb/ref 1071 "Which of the following sets is a subspace of ${R}^{3}?$\n\nI. $A=\\{⟨x,y,z⟩\\in {R}^{3}:\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}<\\frac{1}{2}\\}$\n\nII. $B=\\{⟨x,y,z⟩\\in {R}^{3}:5x-y-z=0\\}$\n\nIII. $C=\\{⟨x,y,z⟩\\in {R}^{3}:5-x-z=0\\}$" #edb/ref 17592186045417] [17592186342191 #edb/ref 1072 #uuid "fb81e4a8-c5a7-59da-b168-b278b747b24a" #edb/ref 17592186045417] [17592186342191 #edb/ref 1074 "Let's analyze each of the subsets.\n\n- The set $A$ is not a subspace. Indeed, the vector $u=⟨\\frac{1}{4},0,0⟩$ is in $A$, since\n\n$$\n\\sqrt{{(\\frac{1}{4})}^{2}+{0}^{2}+{0}^{2}}=\\frac{1}{4}<\\frac{1}{2},\n$$\n\nbut, $4u=⟨1,0,0⟩$ is not in $B$, since \n\n$$\n\\sqrt{{1}^{2}+{0}^{2}+{0}^{2}}>\\frac{1}{2}.\n$$\n\nSo, $A$ is not closed under scalar multiplication.\n\n- The set $B$ is a subspace. It represents a plane, and a plane is a subspace if and only if it passes through the origin. Here, the components of the zero vector $0=⟨0,0,0⟩$ satisfy the equation $5x-y-z=0$ since $5\\cdot 0-0-0=0.$ So $0$ lies in $B.$\n\n- The set $C$ is not a subspace because it does not contain the zero vector. Indeed, $0=⟨0,0,0⟩$ does not satisfy the equation $5-x-z=0$ since $5-0-0\\ne 0.$\n\nIn conclusion, the correct answer is \"II only.\"" #edb/ref 17592186045417] [17592186407328 #edb/ref 1080 "I and II only" #edb/ref 17592186045417] [17592186407328 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186407328 #edb/ref 1083 #uuid "baba48d0-d9fb-5842-84e6-6919f8e36cee" #edb/ref 17592186045417] [17592186407330 #edb/ref 1080 "II and III only" #edb/ref 17592186045417] [17592186407330 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186407330 #edb/ref 1083 #uuid "dbd0836e-e6f4-5b58-bfb5-c8dec7e9a94d" #edb/ref 17592186045417] [17592186407331 #edb/ref 1080 "I only" #edb/ref 17592186045417] [17592186407331 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186407331 #edb/ref 1083 #uuid "f16a724b-c1f8-5ad0-8225-b9af9742e1cc" #edb/ref 17592186045417] [17592186407332 #edb/ref 1080 "III only" #edb/ref 17592186045417] [17592186407332 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186407332 #edb/ref 1083 #uuid "f67abfd4-642f-5614-876f-390eb3d1595b" #edb/ref 17592186045417] [17592186407333 #edb/ref 1080 "II only" #edb/ref 17592186045417] [17592186407333 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186407333 #edb/ref 1083 #uuid "fe963c24-be42-5cfe-a77e-8b918c0ffa49" #edb/ref 17592186045417] [17592186407334 #edb/ref 1075 #edb/ref 17592186407328 #edb/ref 17592186045417] [17592186407334 #edb/ref 1075 #edb/ref 17592186407330 #edb/ref 17592186045417] [17592186407334 #edb/ref 1075 #edb/ref 17592186407331 #edb/ref 17592186045417] [17592186407334 #edb/ref 1075 #edb/ref 17592186407332 #edb/ref 17592186045417] [17592186407334 #edb/ref 1075 #edb/ref 17592186407333 #edb/ref 17592186045417] [17592186407334 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186407334 #edb/ref 1077 "selectio