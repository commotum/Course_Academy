#{[{:db/id #edb/ref 17592186133571 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186133762 :knowledge-point/id #uuid "e46fa568-0a40-5b36-a01f-20555db9b055" :knowledge-point/title "Calculating the Inner Product of Two Vectors"}] :question/id #uuid "d8ab385f-ca7e-5ac2-9c0c-23ec78c9b1f7" :question/math-academy-id "e-5542" :question/problem "An inner product on $V = \\mathbb{R}^3$ is given by $\\langle \\mathbf{x}, \\mathbf{y} \\rangle =  3 x_1 y_1 + x_2 y_2 + 7 x_3 y_3.$ Find $\\langle \\mathbf{x}, \\mathbf{y} \\rangle,$ if\n![](images/02/028bb3befd54071fcae6cb88bd3e054d3325557ef31274ec23146e1da81f8258.png)" :question/worked-solution "Computing the inner product according to the definition, we get\n\n$$\n\\begin{aligned}⟨x,y⟩ & =3{x}_{1}{y}_{1}+{x}_{2}{y}_{2}+7{x}_{3}{y}_{3} \\\\  & =3\\cdot 1\\cdot (-3)+(-2)\\cdot 1+7\\cdot 0\\cdot 5 \\\\  & =-9-2+0 \\\\  & =-11.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186133572 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186133763 :knowledge-point/id #uuid "efed2bff-625e-556d-99a3-9b51f9d68937" :knowledge-point/title "Calculating the Inner Product of Two Vectors in a Vector Space of Polynomials"}] :question/id #uuid "d7217dd1-5e4d-5ecb-96a4-e4c7064f2f88" :question/math-academy-id "e-5543" :question/problem "Let $V=\\mathbb{R}_2[t]$ be the vector space of all polynomials of degree at most $2$, equipped with the inner product \n\n$$\n\\langle {x}(t), {y}(t) \\rangle = x(1)y(1) + x(2)y(2) + x(3)y(3).\n$$\n\n Find $\\langle \\mathbf{x}(t), \\mathbf{y}(t) \\rangle,$ if\n\n$$\n{x}(t) = 1-2t+3t^2,\n\t\\quad\n\t{y}(t) = t-t^2.\n$$" :question/worked-solution "Computing the inner product according to the definition, we get\n\n$$\n\\begin{aligned}⟨x(t),y(t)⟩ & =x(1)y(1)+x(2)y(2)+x(3)y(3) \\\\  & =2\\cdot 0+9\\cdot (-2)+22\\cdot (-6) \\\\  & =0-18-132 \\\\  & =-150.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186133573 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186133764 :knowledge-point/id #uuid "4c553cb8-9f5c-5fa5-bc43-db7d7b64755f" :knowledge-point/title "Calculating the Inner Product of Two Vectors in a Vector Space of Continuous Functions"}] :question/id #uuid "007b171e-6587-5835-a59c-443b29c2b667" :question/math-academy-id "e-5544" :question/problem "Let $V=\\mathcal{C}\\left[0,2\\pi\\right],$ the vector space of all functions that are continuous on $\\left[0,2\\pi\\right].$ Find $\\langle \\sin t, \\cos t \\rangle$ if the inner product on $V$ is defined as\n\n$$\n\\langle x(t),y(t) \\rangle = \\displaystyle\\int_{0}^{2\\pi} x(t) y(t) \\, \\textrm{d}t.\n$$" :question/worked-solution "We need to evaluate\n\n$$\n\\langle \\sin t, \\cos t \\rangle  =  \\int_{0}^{2\\pi}\\sin{t} \\cos{t} \\,\\textrm{d}t.\n$$\n\nWe can evaluate this integral using the identity $\\sin2t =2\\sin t\\cos t,$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2\\pi }\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\,\\text{d}t & =\\frac{1}{2}{\\int }_{0}^{2\\pi }\\operatorname{sin}⁡2t\\,\\text{d}t \\\\  & =-\\frac{1}{4}\\operatorname{cos}⁡2t{|}_{0}^{2\\pi } \\\\  & =-\\frac{1}{4}(\\operatorname{cos}⁡4\\pi -\\operatorname{cos}⁡0) \\\\  & =-\\frac{1}{4}(1-1) \\\\  & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186271985 :knowledge-point/_questions [{:db/id #edb/ref 17592186133762 :knowledge-point/id #uuid "e46fa568-0a40-5b36-a01f-20555db9b055" :knowledge-point/title "Calculating the Inner Product of Two Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b85138b-35bf-5e5a-9812-3db962e529e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186269368} {:answer/id #uuid "2ba72422-557c-5a5d-810a-ac558880663f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186269663} {:answer/id #uuid "67eef88a-5b92-5625-bf64-58603c013bd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-26" :db/id #edb/ref 17592186270191} {:answer/id #uuid "7ab7ea64-f770-56f1-ae8a-dc05816621e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186270355} {:answer/id #uuid "ce0be4fd-27af-529e-a54e-0ec40fe58195" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186271076}] :answer-field/correct {:answer/id #uuid "67eef88a-5b92-5625-bf64-58603c013bd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-26" :db/id #edb/ref 17592186270191} :answer-field/id #uuid "af1c7b7a-2cbb-5e50-a163-724e091e307b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271827}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "489b5eb0-3a2c-5dea-a319-177ed67c1db4" :question/math-academy-id "q-139971" :question/problem "An inner product on $V={R}^{3}$ is given by $⟨p,q⟩=2{p}_{1}{q}_{1}+2{p}_{2}{q}_{2}+3{p}_{3}{q}_{3}.$ Find $⟨p,q⟩$, if\n\n$$\np=[\\begin{aligned}1 \\\\ -3 \\\\ -4\\end{aligned}],\\,q=[\\begin{aligned}5 \\\\ 2 \\\\ 2\\end{aligned}].\n$$" :question/worked-solution "Computing the inner product according to the definition, we get\n\n$$\n\\begin{aligned}⟨p,q⟩ & =2{p}_{1}{q}_{1}+2{p}_{2}{q}_{2}+3{p}_{3}{q}_{3} \\\\  & =2\\cdot 1\\cdot 5+2\\cdot (-3)\\cdot 2+3\\cdot (-4)\\cdot 2 \\\\  & =10-12-24 \\\\  & =-26.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186271998 :knowledge-point/_questions [{:db/id #edb/ref 17592186133763 :knowledge-point/id #uuid "efed2bff-625e-556d-99a3-9b51f9d68937" :knowledge-point/title "Calculating the Inner Product of Two Vectors in a Vector Space of Polynomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1375ebbb-0441-5a50-a76e-8b6bec720cbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186269442} {:answer/id #uuid "5dcdf529-9dd1-5aa5-8d36-8572c155f84a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186270102} {:answer/id #uuid "89275420-755a-5a9d-986b-08760d728594" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186270452} {:answer/id #uuid "d0b34eeb-cb58-53aa-b60b-6aed54c264f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186271104} {:answer/id #uuid "e8de50f3-7a7b-568b-8d8f-15ecfad3b327" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186271304}] :answer-field/correct {:answer/id #uuid "1375ebbb-0441-5a50-a76e-8b6bec720cbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186269442} :answer-field/id #uuid "b31f5296-17f3-5e8b-ae99-8ca0c1e33eef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271837}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a3cf5eb6-772c-5651-a1c7-b231261583a4" :question/math-academy-id "q-139995" :question/problem "Let $V={R}_{2}[t]$ be the vector space of all polynomials of degree at most $2$, equipped with the inner product \n\n$$\n⟨x(t),y(t)⟩=x(1)y(1)+x(2)y(2)+x(3)y(3).\n$$\n\n Find $⟨x(t),y(t)⟩$, if\n\n$$\nx(t)={t}^{2}-2t-3,\\,y(t)={t}^{2}-1.\n$$" :question/worked-solution "Computing the inner product according to the definition, we get\n\n$$\n\\begin{aligned}⟨x(t),y(t)⟩ & =x(1)y(1)+x(2)y(2)+x(3)y(3) \\\\  & =-4\\cdot 0+(-3)\\cdot 3+0\\cdot 8 \\\\  & =0-9+0 \\\\  & =-9.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186134382 :knowledge-point/_questions [{:db/id #edb/ref 17592186133763 :knowledge-point/id #uuid "efed2bff-625e-556d-99a3-9b51f9d68937" :knowledge-point/title "Calculating the Inner Product of Two Vectors in a Vector Space of Polynomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bbf676a-2b68-5c6a-8396-ed46a4789612" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186327176} {:answer/id #uuid "3238cc20-ed6b-52c7-906c-45aca7b0226a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-21" :db/id #edb/ref 17592186327375} {:answer/id #uuid "56cc5908-152f-5793-be65-bbc1f817287c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186327689} {:answer/id #uuid "a0b91dc3-046a-5b8f-b76a-95b379ce61ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{t}^{2}-t+4" :db/id #edb/ref 17592186328327} {:answer/id #uuid "de304544-f935-50e8-8a9d-01be4281b87e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186328876}] :answer-field/correct {:answer/id #uuid "3238cc20-ed6b-52c7-906c-45aca7b0226a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-21" :db/id #edb/ref 17592186327375} :answer-field/id #uuid "9535d699-949a-52c2-839e-0167146ea30e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329435}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "26d059cc-b327-5568-bdbd-81c6e2f0a4fd" :question/math-academy-id "q-42250" :question/problem "Let $V={R}_{2}[t]$ be the vector space of all polynomials of degree at most $2$, equipped with the inner product\n\n$$\n⟨x(t),y(t)⟩=x(-1)y(-1)+x(0)y(0)+x(1)y(1).\n$$\n\n Find $⟨x(t),y(t)⟩$, if\n\n$$\nx(t)=5-2t+{t}^{2},\\,y(t)=t-1.\n$$" :question/worked-solution "Computing the inner product according to the definition, we get\n\n$$\n\\begin{aligned}⟨x(t),y(t)⟩ & =x(-1)y(-1)+x(0)y(0)+x(1)y(1) \\\\  & =8\\cdot (-2)+5\\cdot (-1)+4\\cdot 0 \\\\  & =-16-5+0 \\\\  & =-21.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186134384 :knowledge-point/_questions [{:db/id #edb/ref 17592186133764 :knowledge-point/id #uuid "4c553cb8-9f5c-5fa5-bc43-db7d7b64755f" :knowledge-point/title "Calculating the Inner Product of Two Vectors in a Vector Space of Continuous Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07ce7e4c-f358-59e1-83ec-c12d185581ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186326996} {:answer/id #uuid "4c81f4db-d861-547d-a06f-42826d808a37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186327598} {:answer/id #uuid "ae66382d-5670-5d2c-88f6-a6e2c5123b49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186328448} {:answer/id #uuid "b25772cd-af85-5333-aa05-8ae7885a5e83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186328481} {:answer/id #uuid "b2a08351-6bdd-5434-861e-a5f6e60e14fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186328483}] :answer-field/correct {:answer/id #uuid "ae66382d-5670-5d2c-88f6-a6e2c5123b49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186328448} :answer-field/id #uuid "033cf0fb-22d2-5315-bb5f-00c4ceeb328a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329191}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "663f08e4-70a8-54d4-a465-2c24f8e60288" :question/math-academy-id "q-42254" :question/problem "Let $V=C[-\\frac{\\pi }{2},\\frac{\\pi }{2}],$ the vector space of all functions that are continuous on $[-\\frac{\\pi }{2},\\frac{\\pi }{2}].$ Find $⟨{sin}^{2}⁡t,\\operatorname{cos}⁡t⟩$ if the inner product on $V$ is defined as\n\n$$\n⟨x(t),y(t)⟩={\\int }_{-\\pi /2}^{\\pi /2}x(t)y(t)\\,\\text{d}t.\n$$" :question/worked-solution "We need to evaluate\n\n$$\n⟨{sin}^{2}⁡t,\\operatorname{cos}⁡t⟩={\\int }_{-\\pi /2}^{\\pi /2}{sin}^{2}⁡t\\operatorname{cos}⁡t\\,\\text{d}t.\n$$\n\nWe can evaluate this integral using the substitution $u=\\operatorname{sin}⁡t,$ $\\text{d}u=\\operatorname{cos}⁡t\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{-\\pi /2}^{\\pi /2}{sin}^{2}⁡t\\operatorname{cos}⁡t\\,\\text{d}t & ={\\int }_{-1}^{1}{u}^{2}\\,\\text{d}u \\\\  & ={\\frac{1}{3}{u}^{3}|}_{-1}^{1} \\\\  & =[\\frac{1}{3}(1)^{3}]-[\\frac{1}{3}(-1)^{3}] \\\\  & =\\frac{1}{3}+\\frac{1}{3} \\\\  & =\\frac{2}{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329737 :knowledge-point/_questions [{:db/id #edb/ref 17592186133763 :knowledge-point/id #uuid "efed2bff-625e-556d-99a3-9b51f9d68937" :knowledge-point/title "Calculating the Inner Product of Two Vectors in a Vector Space of Polynomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1abdfbc3-5dd6-5447-9ac6-b5d81427f03d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186327166} {:answer/id #uuid "53cadbe1-b244-5e6f-a28a-b6600ba2710d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186327659} {:answer/id #uuid "9027be66-2c27-56c9-aa8d-b119ca2363ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186328192} {:answer/id #uuid "ced14b1d-c904-5116-b163-fe54a3c28b5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186328752} {:answer/id #uuid "d6f9fb9a-3323-5097-9563-93f2085554b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186328816}] :answer-field/correct {:answer/id #uuid "9027be66-2c27-56c9-aa8d-b119ca2363ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186328192} :answer-field/id #uuid "5f469ccb-cf9c-5ecf-b070-76c0ba752c17" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329353}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4fc7263f-e87d-5e94-84c5-b2dba4518ba6" :question/math-academy-id "q-43815" :question/problem "Let $V={R}_{2}[t]$ be the vector space of all polynomials of degree at most $2$, equipped with the inner product \n\n$$\n⟨x(t),y(t)⟩=x(1)y(1)+x(2)y(2)+x(-2)y(-2).\n$$\n\n Find $⟨x(t),y(t)⟩$, if\n\n$$\nx(t)={t}^{2}-5,\\,y(t)={t}^{2}-3t.\n$$" :question/worked-solution "Computing the inner product according to the definition, we get\n\n$$\n\\begin{aligned}⟨x(t),y(t)⟩ & =x(1)y(1)+x(2)y(2)+x(-2)y(-2) \\\\  & =(-4)\\cdot (-2)+(-1)\\cdot (-2)+(-1)\\cdot 10 \\\\  & =8+2-10 \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329738 :knowledge-point/_questions [{:db/id #edb/ref 17592186133762 :knowledge-point/id #uuid "e46fa568-0a40-5b36-a01f-20555db9b055" :knowledge-point/title "Calculating the Inner Product of Two Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "036ed7e4-da6e-523f-b32f-b75656a548b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186326969} {:answer/id #uuid "419840a5-6cf5-5ad7-9ea9-7d2195951389" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186327510} {:answer/id #uuid "49ef06b9-2506-5a52-9041-26f2f58384f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186327576} {:answer/id #uuid "7d638941-1b25-5334-8286-beba4cc9f0aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-40" :db/id #edb/ref 17592186328016} {:answer/id #uuid "933d7878-5508-5574-b742-7209eb25fb44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186328219}] :answer-field/correct {:answer/id #uuid "419840a5-6cf5-5ad7-9ea9-7d2195951389" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186327510} :answer-field/id #uuid "d6f5d1f2-0757-52e8-b413-5c729ce1fc18" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329565}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e9aa0831-441e-5d2a-80e1-42bf1577c056" :question/math-academy-id "q-43816" :question/problem "An inner product on $V={R}^{3}$ is given by $⟨x,y⟩=2{x}_{1}{y}_{1}+5{x}_{2}{y}_{2}+7{x}_{3}{y}_{3}.$ Find $⟨x,y⟩$, if\n\n$$\nx=[\\begin{aligned}2 \\\\ 1 \\\\ -2\\end{aligned}],\\,y=[\\begin{aligned}3 \\\\ -3 \\\\ -2\\end{aligned}].\n$$" :question/worked-solution "Computing the inner product according to the definition, we get\n\n$$\n\\begin{aligned}⟨x,y⟩ & =2{x}_{1}{y}_{1}+5{x}_{2}{y}_{2}+7{x}_{3}{y}_{3} \\\\  & =2\\cdot 2\\cdot 3+5\\cdot 1\\cdot (-3)+7\\cdot (-2)\\cdot (-2) \\\\  & =12-15+28 \\\\  & =25.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329742 :knowledge-point/_questions [{:db/id #edb/ref 17592186133764 :knowledge-point/id #uuid "4c553cb8-9f5c-5fa5-bc43-db7d7b64755f" :knowledge-point/title "Calculating the Inner Product of Two Vectors in a Vector Space of Continuous Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f60fecc-f79a-5989-916d-f1dc1508a8ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186327772} {:answer/id #uuid "a63e4efb-65ca-582f-aef6-452aaa57060e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{1-{t}^{2}}}{3}" :db/id #edb/ref 17592186328371} {:answer/id #uuid "de35967f-f177-58a6-bb65-1d140d4719fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186328878} {:answer/id #uuid "e987c9fc-174b-5d04-89d9-2ba46fe1e8ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186328981} {:answer/id #uuid "f30cf7c4-af07-5900-a89d-c8446012d603" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186329056}] :answer-field/correct {:answer/id #uuid "de35967f-f177-58a6-bb65-1d140d4719fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186328878} :answer-field/id #uuid "81231336-19d6-56d7-abf5-f1e9516e7ed8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329397}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "455737fc-ee99-5287-85ce-5747c0a041d5" :question/math-academy-id "q-43855" :question/problem "Let $V=C[-1,0],$ the vector space of all functions that are continuous on $[-1,0].$ Find $⟨t,\\sqrt{1-{t}^{2}}⟩$ if the inner product on $V$ is defined as\n\n$$\n⟨x(t),y(t)⟩={\\int }_{-1}^{0}x(t)y(t)\\,\\text{d}t.\n$$" :question/worked-solution "We need to evaluate\n\n$$\n⟨t,\\sqrt{1-{t}^{2}}⟩={\\int }_{-1}^{0}t\\sqrt{1-{t}^{2}}\\,\\text{d}t.\n$$\n\nWe can evaluate this integral using the substitution $u=1-{t}^{2},$ $\\text{d}u=-2t\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{-1}^{0}t\\sqrt{1-{t}^{2}}\\,\\text{d}t & =-\\frac{1}{2}{\\int }_{0}^{1}\\sqrt{u}\\,\\text{d}u \\\\  & =-\\frac{1}{2}\\cdot \\frac{2}{3}{u}^{3/2}\\,{|}_{0}^{1} \\\\  & =-\\frac{1}{3}{u}^{3/2}\\,{|}_{0}^{1} \\\\  & =[-\\frac{1}{3}(1)^{3/2}]-[-\\frac{1}{3}(0)^{3/2}] \\\\  & =-\\frac{1}{3}\\end{aligned}\n$$"}]}
