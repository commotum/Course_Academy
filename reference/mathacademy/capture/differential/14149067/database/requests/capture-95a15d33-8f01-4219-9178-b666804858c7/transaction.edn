/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6f312a38-d24c-5fe1-af5f-6b21afdd5e30" :answer-field/choices ["answer-6f312a38-d24c-5fe1-af5f-6b21afdd5e30" "answer-95129c89-acc6-5af6-ac5d-46b405be3509" "answer-e84b0382-768c-583c-a899-bd6fdd749d6a" "answer-4e6b98b7-953e-535e-8d20-7a1e38e2635b" "answer-114352ba-5dd4-53f3-a738-fd5540be3aba"] :db/ensure [:answer-field/validate]} {:db/id "answer-6f312a38-d24c-5fe1-af5f-6b21afdd5e30" :answer/id #uuid "6f312a38-d24c-5fe1-af5f-6b21afdd5e30" :answer/type :answer.type/math :answer/value "-12" :db/ensure [:answer/validate]} {:db/id "answer-95129c89-acc6-5af6-ac5d-46b405be3509" :answer/id #uuid "95129c89-acc6-5af6-ac5d-46b405be3509" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-e84b0382-768c-583c-a899-bd6fdd749d6a" :answer/id #uuid "e84b0382-768c-583c-a899-bd6fdd749d6a" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-4e6b98b7-953e-535e-8d20-7a1e38e2635b" :answer/id #uuid "4e6b98b7-953e-535e-8d20-7a1e38e2635b" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "answer-114352ba-5dd4-53f3-a738-fd5540be3aba" :answer/id #uuid "114352ba-5dd4-53f3-a738-fd5540be3aba" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "question-81ac8592-2b70-55bf-8038-041515b727a4" :question/id #uuid "81ac8592-2b70-55bf-8038-041515b727a4" :question/math-academy-id "q-76439" :question/problem "An inner product on $V={R}^{3}$ is given by $⟨x,y⟩=3{x}_{1}{y}_{1}+5{x}_{2}{y}_{2}+{x}_{3}{y}_{3}.$ Find $⟨x,y⟩$, if\n\n$$\nx=[\\begin{aligned}2 \\\\ -1 \\\\ 3\\end{aligned}],\\,y=[\\begin{aligned}1 \\\\ 1 \\\\ 3\\end{aligned}].\n$$" :question/worked-solution "Computing the inner product according to the definition, we get\n\n$$\n\\begin{aligned}⟨x,y⟩ & =3{x}_{1}{y}_{1}+5{x}_{2}{y}_{2}+{x}_{3}{y}_{3} \\\\  & =3\\cdot 2\\cdot 1+5\\cdot (-1)\\cdot 1+3\\cdot 3 \\\\  & =6-5+9 \\\\  & =10.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b1dff34c-e9ec-5c79-a9b8-9a73be39c14d"] :db/ensure [:question/validate]} {:db/id "answer-field-b1dff34c-e9ec-5c79-a9b8-9a73be39c14d" :answer-field/id #uuid "b1dff34c-e9ec-5c79-a9b8-9a73be39c14d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-493843e3-6065-57b3-9ba1-7610a15409bc" :answer-field/choices ["answer-493843e3-6065-57b3-9ba1-7610a15409bc" "answer-19661f33-0f7d-5793-b930-90d7317e07ed" "answer-1008803b-c2f6-569b-b2ff-1240127da120" "answer-0f327f02-b0a3-5361-b5e8-983acbd2ecd0" "answer-001e21f4-8791-5985-80aa-f25450805342"] :db/ensure [:answer-field/validate]} {:db/id "answer-493843e3-6065-57b3-9ba1-7610a15409bc" :answer/id #uuid "493843e3-6065-57b3-9ba1-7610a15409bc" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-19661f33-0f7d-5793-b930-90d7317e07ed" :answer/id #uuid "19661f33-0f7d-5793-b930-90d7317e07ed" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "answer-1008803b-c2f6-569b-b2ff-1240127da120" :answer/id #uuid "1008803b-c2f6-569b-b2ff-1240127da120" :answer/type :answer.type/math :answer/value "18" :db/ensure [:answer/validate]} {:db/id "answer-0f327f02-b0a3-5361-b5e8-983acbd2ecd0" :answer/id #uuid "0f327f02-b0a3-5361-b5e8-983acbd2ecd0" :answer/type :answer.type/math :answer/value "20" :db/ensure [:answer/validate]} {:db/id "answer-001e21f4-8791-5985-80aa-f25450805342" :answer/id #uuid "001e21f4-8791-5985-80aa-f25450805342" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "question-6652b923-fbed-582d-9443-3f7fe8880fb9" :question/id #uuid "6652b923-fbed-582d-9443-3f7fe8880fb9" :question/math-academy-id "q-43812" :question/problem "An inner product on $V={R}^{3}$ is given by $⟨x,y⟩={x}_{1}{y}_{1}+3{x}_{2}{y}_{2}+{x}_{3}{y}_{3}.$ Find $⟨x,y⟩$, if\n\n$$\nx=[\\begin{aligned}3 \\\\ -1 \\\\ 2\\end{aligned}],\\,y=[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}].\n$$" :question/worked-solution "Computing the inner product according to the definition, we get\n\n$$\n\\begin{aligned}⟨x,y⟩ & ={x}_{1}{y}_{1}+3{x}_{2}{y}_{2}+{x}_{3}{y}_{3} \\\\  & =3\\cdot (-1)+3\\cdot (-1)\\cdot 1+2\\cdot 1 \\\\  & =-3-3+2 \\\\  & =-4.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-8086cc7b-01c1-518b-af27-1c151c1f387a"] :db/ensure [:question/validate]} {:db/id "answer-field-8086cc7b-01c1-518b-af27-1c151c1f387a" :answer-field/id #uuid "8086cc7b-01c1-518b-af27-1c151c1f387a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-51c68614-6008-5a4d-a20f-1206d39b5136" :answer-field/choices ["answer-8e419059-fc1d-50e2-92b7-7dfd1c4cc8d9" "answer-51c68614-6008-5a4d-a20f-1206d39b5136" "answer-c079f29c-9e80-57dd-97d3-cae57722f2f1" "answer-a9e26ea8-4cd3-5377-b63a-9d00f923f60e" "answer-9a37a70b-83c6-5274-9206-66a261dd6f98"] :db/ensure [:answer-field/validate]} {:db/id "answer-8e419059-fc1d-50e2-92b7-7dfd1c4cc8d9" :answer/id #uuid "8e419059-fc1d-50e2-92b7-7dfd1c4cc8d9" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-51c68614-6008-5a4d-a20f-1206d39b5136" :answer/id #uuid "51c68614-6008-5a4d-a20f-1206d39b5136" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "answer-c079f29c-9e80-57dd-97d3-cae57722f2f1" :answer/id #uuid "c079f29c-9e80-57dd-97d3-cae57722f2f1" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "answer-a9e26ea8-4cd3-5377-b63a-9d00f923f60e" :answer/id #uuid "a9e26ea8-4cd3-5377-b63a-9d00f923f60e" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "answer-9a37a70b-83c6-5274-9206-66a261dd6f98" :answer/id #uuid "9a37a70b-83c6-5274-9206-66a261dd6f98" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "question-b1906542-1837-55c7-bfa3-d76ad056eb3b" :question/id #uuid "b1906542-1837-55c7-bfa3-d76ad056eb3b" :question/math-academy-id "q-76443" :question/problem "Let $V={R}_{2}[t]$ be the vector space of all polynomials of degree at most $2$, equipped with the inner product \n\n$$\n⟨x(t),y(t)⟩=x(-1)y(-1)+x(0)y(0)+x(1)y(1).\n$$\n\n Find $⟨x(t),y(t)⟩$, if\n\n$$\nx(t)={t}^{2}-4,\\,y(t)=3-t.\n$$" :question/worked-solution "Computing the inner product according to the definition, we get\n\n$$\n\\begin{aligned}⟨x(t),y(t)⟩ & =x(-1)y(-1)+x(0)y(0)+x(1)y(1) \\\\  & =(-3)\\cdot 4+(-4)\\cdot 3+(-3)\\cdot 2 \\\\  & =-12-12-6 \\\\  & =-30.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-64a51fc8-5c03-5f0f-bf50-67aa3a0e0d48"] :db/ensure [:question/validate]} {:db/id "answer-field-64a51fc8-5c03-5f0f-bf50-67aa3a0e0d48" :answer-field/id #uuid "64a51fc8-5c03-5f0f-bf50-67aa3a0e0d48" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1425608e-c991-50c7-b584-e4b9dcc0689e" :answer-field/choices ["answer-1d6897ab-0bef-54a1-b5ca-789cb37c03a2" "answer-e30ccf2e-df49-5ce2-b87e-ac6d12abb412" "answer-f3d843f2-db61-5940-aedd-063c2d5dca33" "answer-1425608e-c991-50c7-b584-e4b9dcc0689e" "answer-98c7c9b2-31ef-570f-ba9f-9b45433ceeb1"] :db/ensure [:answer-field/validate]} {:db/id "answer-1d6897ab-0bef-54a1-b5ca-789cb37c03a2" :answer/id #uuid "1d6897ab-0bef-54a1-b5ca-789cb37c03a2" :answer/type :answer.type/math :answer/value "-12" :db/ensure [:answer/validate]} {:db/id "answer-e30ccf2e-df49-5ce2-b87e-ac6d12abb412" :answer/id #uuid "e30ccf2e-df49-5ce2-b87e-ac6d12abb412" :answer/type :answer.type/math :answer/value "-18" :db/ensure [:answer/validate]} {:db/id "answer-f3d843f2-db61-5940-aedd-063c2d5dca33" :answer/id #uuid "f3d843f2-db61-5940-aedd-063c2d5dca33" :answer/type :answer.type/math :answer/value "-24" :db/ensure [:answer/