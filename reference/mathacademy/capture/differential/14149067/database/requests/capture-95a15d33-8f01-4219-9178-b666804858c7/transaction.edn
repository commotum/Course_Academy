-0b7b-5ddf-a2bc-e63bdc5c780c" :answer/id #uuid "eadd86a2-0b7b-5ddf-a2bc-e63bdc5c780c" :answer/type :answer.type/math :answer/value "-406" :db/ensure [:answer/validate]} {:db/id "answer-6e41c6a8-f52f-5350-8c40-79e2744b879e" :answer/id #uuid "6e41c6a8-f52f-5350-8c40-79e2744b879e" :answer/type :answer.type/math :answer/value "-675" :db/ensure [:answer/validate]} {:db/id "answer-411a1090-801a-5fd2-91c0-e477148635e1" :answer/id #uuid "411a1090-801a-5fd2-91c0-e477148635e1" :answer/type :answer.type/math :answer/value "304" :db/ensure [:answer/validate]} {:db/id "answer-3f24a5fc-645c-5ac1-892f-084879401a36" :answer/id #uuid "3f24a5fc-645c-5ac1-892f-084879401a36" :answer/type :answer.type/math :answer/value "653" :db/ensure [:answer/validate]} {:db/id "question-0be188f9-6651-53a5-a98d-3c5cc7f7f4e2" :question/id #uuid "0be188f9-6651-53a5-a98d-3c5cc7f7f4e2" :question/math-academy-id "q-43856" :question/problem "Let $V=C[0,\\frac{\\pi }{2}],$ the vector space of all functions that are continuous on $[0,\\frac{\\pi }{2}].$ Find $⟨t,\\operatorname{cos}⁡t⟩$ if the inner product on $V$ is defined as\n\n$$\n⟨x(t),y(t)⟩={\\int }_{0}^{\\pi /2}x(t)y(t)\\,\\text{d}t.\n$$" :question/worked-solution "We need to evaluate\n\n$$\n⟨t,\\operatorname{cos}⁡t⟩={\\int }_{0}^{\\pi /2}t\\operatorname{cos}⁡t\\,\\text{d}t.\n$$\n\nLet's use integration by parts. We denote\n\n$$\n\\begin{aligned}u=t & ⟹ & {u}^{′}=1, \\\\ {v}^{′}=\\operatorname{cos}⁡t & ⟹ & v=\\int {v}^{′}\\,\\text{d}t=\\int \\operatorname{cos}⁡t\\,\\text{d}t=\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nNow, substituting into the formula for the integration by parts, we obtain \n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}t\\operatorname{cos}⁡t\\,\\text{d}t & =uv{|}_{0}^{\\pi /2}-{\\int }_{0}^{\\pi /2}v{u}^{′}\\,\\text{d}t \\\\  & =(t\\operatorname{sin}⁡t){|}_{0}^{\\pi /2}-{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡t\\,\\text{d}t \\\\  & =(\\frac{\\pi }{2}\\cdot \\operatorname{sin}⁡\\frac{\\pi }{2}-\\frac{\\pi }{2}\\cdot \\operatorname{sin}⁡0)+\\operatorname{cos}⁡t{|}_{0}^{\\pi /2} \\\\  & =\\frac{\\pi }{2}+(\\operatorname{cos}⁡\\frac{\\pi }{2}-\\operatorname{cos}⁡0) \\\\  & =\\frac{\\pi }{2}-1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-5f0a1a01-415b-5c49-9e24-1991eb5a02c9"] :db/ensure [:question/validate]} {:db/id "answer-field-5f0a1a01-415b-5c49-9e24-1991eb5a02c9" :answer-field/id #uuid "5f0a1a01-415b-5c49-9e24-1991eb5a02c9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c7e73e07-ab43-556f-870c-6df1af14fc25" :answer-field/choices ["answer-a0cba996-7b68-58e1-ace5-7811f5305eab" "answer-813dae2d-0f53-57fb-9a1a-1d2509827eda" "answer-2397b865-3c09-5174-bc67-a170acce9725" "answer-97ebceb2-c69d-5984-b715-f21796bdb745" "answer-c7e73e07-ab43-556f-870c-6df1af14fc25"] :db/ensure [:answer-field/validate]} {:db/id "answer-a0cba996-7b68-58e1-ace5-7811f5305eab" :answer/id #uuid "a0cba996-7b68-58e1-ace5-7811f5305eab" :answer/type :answer.type/math :answer/value "-\\operatorname{cos}⁡t" :db/ensure [:answer/validate]} {:db/id "answer-813dae2d-0f53-57fb-9a1a-1d2509827eda" :answer/id #uuid "813dae2d-0f53-57fb-9a1a-1d2509827eda" :answer/type :answer.type/math :answer/value "1-\\frac{\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "answer-2397b865-3c09-5174-bc67-a170acce9725" :answer/id #uuid "2397b865-3c09-5174-bc67-a170acce9725" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "answer-97ebceb2-c69d-5984-b715-f21796bdb745" :answer/id #uuid "97ebceb2-c69d-5984-b715-f21796bdb745" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{2}+1" :db/ensure [:answer/validate]} {:db/id "answer-c7e73e07-ab43-556f-870c-6df1af14fc25" :answer/id #uuid "c7e73e07-ab43-556f-870c-6df1af14fc25" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{2}-1" :db/ensure [:answer/validate]} {:db/id "question-37beaef3-36bd-59a9-8b05-4fe440be106e" :question/id #uuid "37beaef3-36bd-59a9-8b05-4fe440be106e" :question/math-academy-id "q-76452" :question/problem "Let $V=C[-\\pi ,0],$ the vector space of all functions that are continuous on $[-\\pi ,0].$ Find $⟨t,\\operatorname{sin}⁡t⟩$ if the inner product on $V$ is defined as\n\n$$\n⟨x(t),y(t)⟩={\\int }_{-\\pi }^{0}x(t)y(t)\\,\\text{d}t.\n$$" :question/worked-solution "We need to evaluate\n\n$$\n⟨t,\\operatorname{sin}⁡t⟩={\\int }_{-\\pi }^{0}t\\operatorname{sin}⁡t\\,\\text{d}t.\n$$\n\nLet's use integration by parts. We denote\n\n$$\n\\begin{aligned}u=t & ⟹ & {u}^{′}=1, \\\\ {v}^{′}=\\operatorname{sin}⁡t & ⟹ & v=\\int {v}^{′}\\,\\text{d}t=\\int \\operatorname{sin}⁡t\\,\\text{d}t=-\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nNow, substituting into the formula for the integration by parts, we obtain \n\n$$\n\\begin{aligned}{\\int }_{-\\pi }^{0}t\\operatorname{sin}⁡t\\,\\text{d}t & =uv{|}_{-\\pi }^{0}-{\\int }_{-\\pi }^{0}v{u}^{′}\\,\\text{d}t \\\\  & =(-t\\operatorname{cos}⁡t){|}_{-\\pi }^{0}+{\\int }_{-\\pi }^{0}\\operatorname{cos}⁡t\\,\\text{d}t \\\\  & =(-0\\cdot \\operatorname{cos}⁡0+(-\\pi )\\cdot \\operatorname{cos}⁡(-\\pi ))+\\operatorname{sin}⁡t{|}_{-\\pi }^{0} \\\\  & =\\pi +(\\operatorname{sin}⁡0-\\operatorname{sin}⁡(-\\pi )) \\\\  & =\\pi .\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-468f980b-08ae-5d3c-bc6e-fd559a6c8692"] :db/ensure [:question/validate]} {:db/id "answer-field-468f980b-08ae-5d3c-bc6e-fd559a6c8692" :answer-field/id #uuid "468f980b-08ae-5d3c-bc6e-fd559a6c8692" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f33dc946-3ee4-50d5-90dd-5604be5bdb3a" :answer-field/choices ["answer-4e0c7b54-4be7-5c97-8ab2-5fe7016d840c" "answer-c4fcb82a-d6e8-5c8d-b3d3-f18e785cc703" "answer-ccf88be4-d19c-5fd7-b5b9-2901367208a4" "answer-f27b3d6e-bdea-597c-bb71-4cb48c36b474" "answer-f33dc946-3ee4-50d5-90dd-5604be5bdb3a"] :db/ensure [:answer-field/validate]} {:db/id "answer-4e0c7b54-4be7-5c97-8ab2-5fe7016d840c" :answer/id #uuid "4e0c7b54-4be7-5c97-8ab2-5fe7016d840c" :answer/type :answer.type/math :answer/value "-2\\pi " :db/ensure [:answer/validate]} {:db/id "answer-c4fcb82a-d6e8-5c8d-b3d3-f18e785cc703" :answer/id #uuid "c4fcb82a-d6e8-5c8d-b3d3-f18e785cc703" :answer/type :answer.type/math :answer/value "-\\pi " :db/ensure [:answer/validate]} {:db/id "answer-ccf88be4-d19c-5fd7-b5b9-2901367208a4" :answer/id #uuid "ccf88be4-d19c-5fd7-b5b9-2901367208a4" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-f27b3d6e-bdea-597c-bb71-4cb48c36b474" :answer/id #uuid "f27b3d6e-bdea-597c-bb71-4cb48c36b474" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "answer-f33dc946-3ee4-50d5-90dd-5604be5bdb3a" :answer/id #uuid "f33dc946-3ee4-50d5-90dd-5604be5bdb3a" :answer/type :answer.type/math :answer/value "\\pi " :db/ensure [:answer/validate]} {:db/id "question-9f6d0c17-94d0-5de9-adca-7a206888f584" :question/id #uuid "9f6d0c17-94d0-5de9-adca-7a206888f584" :question/math-academy-id "q-140317" :question/problem "Let $V=C[-\\frac{\\pi }{2},0],$ the vector space of all functions that are continuous on $[-\\frac{\\pi }{2},0].$ Find $⟨5{cos}^{4}⁡t,\\operatorname{sin}⁡t⟩$ if the inner product on $V$ is defined as\n\n$$\n⟨x(t),y(t)⟩={\\int }_{-\\pi /2}^{0}x(t)y(t)\\,\\text{d}t.\n$$" :question/worked-solution "We need to evaluate\n\n$$\n⟨5{cos}^{4}⁡t,\\operatorname{sin}⁡t⟩={\\int }_{-\\pi /2}^{0}5{cos}^{4}⁡t\\operatorname{sin}⁡t\\,\\text{d}t.\n$$\n\nWe can evaluate this integral using the substitution $u=\\operatorname{cos}⁡t,$ $\\text{d}u=-\\operatorname{sin}⁡t\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{-\\pi /2}^{0}5{cos}^{4}⁡t\\operatorname{sin}⁡t\\,\\text{d}t & =-5{\\int }_{-\\pi /2}^{0}{cos}^{4}⁡t\\,(-\\operatorname{sin}⁡t)\\,\\text{d}t \\\\  & =-5{\\int }_{0}^{1}{u}^{4}\\,\\text{d}u \\\\  & =-5\\cdot {\\frac{{u}^{5}}{5}|}_{0}^{1} \\\\  & =-(1)^{5}+(0)^{5} \\\\  & =-1\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f4a25410-34fc-5134-b1de-f77df5c01d17"] :db/ensure [:question/validate]} {:db/id "answer-field-f4a25410-34fc-5134-b1de-f77df5c01d17" :answer-field/id #uuid "f4a25410-34fc-5134-b1de-f77df5c01d17" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-17eee941-46bf-5210-beaa-585a99e07ef1" :answer-field/choices ["answer-17eee941-46bf-5210-beaa-585a99e07ef1" "answer-3ccb8322-2ce6-5f5a-8d3f-9b90fdb39783" "answer-57142efe-4d6e-57b7-b34f-4d203584394c" "answer-7af448e8-8bd7-520d-9167-eb8782c39e3c" "answer-38a65582-989f-52ec-9d45-cfd033ffcfcc"] :db/ensure [:answer-field/validate]} {:db/id "answer-17eee941-46bf-5210-beaa-585a99e07ef1" :answer/id #uuid "17eee941-46bf-5210-beaa-585a99e07ef1" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-3ccb8322-2ce6-5f5a-8d3f-9b90fdb39783" :answer/id #uuid "3ccb8322-2ce6-5f5a-8d3f-9b90fdb39783" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-57142efe-4d6e-57b7-b34f-4d203584394c" :answer/id #uuid "57142efe-4d6e-57b7-b34f-4d203584394c" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-7af448e8-8bd7-520d-9167-eb8782c39e3c" :answer/id #uuid "7af448e8-8bd7-520d-9167-eb8782c39e3c" :answer/type :answer.type/math :answer/value "\\frac{1}{5}" :db/ensure [:answer/validate]} {:db/id "answer-38a65582-989f-52ec-9d45-cfd033ffcfcc" :answer/id #uuid "38a65582-989f-52ec-9d45-cfd033ffcfcc" :answer/type :answer.type/math :answer/value "\\frac{3}{5}" :db/ensure [:answer/validate]} {:db/id 17592186133983 :activity/expected-seconds 780.0 :db/ensure [:activity/validate]}]
