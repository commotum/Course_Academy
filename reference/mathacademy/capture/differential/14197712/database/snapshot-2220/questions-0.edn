#{[{:db/id #edb/ref 17592186512878 :knowledge-point/_questions [{:db/id #edb/ref 17592186133780 :knowledge-point/id #uuid "2b2f7e06-54f8-5a9b-a926-362fb087b59c" :knowledge-point/title "Finding the Orthogonal Complement of a Span"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fc41dc0-e625-54ec-935c-e2218ad7619b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{H}^{⊥}=\\{[\\begin{aligned}\\frac{7}{8}{x}_{2} \\\\ {x}_{2}\\end{aligned}]\\,:\\,{x}_{2}\\in R\\}" :db/id #edb/ref 17592186512129} {:answer/id #uuid "23439808-c020-5fe6-9947-75475ae07c6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{H}^{⊥}=\\{[\\begin{aligned}-\\frac{7}{8}{x}_{2} \\\\ {x}_{2}\\end{aligned}]\\,:\\,{x}_{2}\\in R\\}" :db/id #edb/ref 17592186512176} {:answer/id #uuid "a7a43a48-c5a3-5fe0-b7e7-03cf00683fb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{H}^{⊥}=\\{\\text{0}\\}" :db/id #edb/ref 17592186512496} {:answer/id #uuid "bd28a383-d220-5ede-95f6-48a1f6e0c3eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{H}^{⊥}=\\{[\\begin{aligned}-7{x}_{2} \\\\ {x}_{2}\\end{aligned}]\\,:\\,{x}_{2}\\in R\\}" :db/id #edb/ref 17592186512554} {:answer/id #uuid "ce3b37a3-f596-55cd-9709-b88fbdabcc2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{H}^{⊥}=\\{[\\begin{aligned}\\frac{7}{4}{x}_{2} \\\\ {x}_{2}\\end{aligned}]\\,:\\,{x}_{2}\\in R\\}" :db/id #edb/ref 17592186512593}] :answer-field/correct {:answer/id #uuid "ce3b37a3-f596-55cd-9709-b88fbdabcc2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{H}^{⊥}=\\{[\\begin{aligned}\\frac{7}{4}{x}_{2} \\\\ {x}_{2}\\end{aligned}]\\,:\\,{x}_{2}\\in R\\}" :db/id #edb/ref 17592186512593} :answer-field/id #uuid "356e4ab9-2091-593a-99dd-55afcb98c941" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186512753}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1b5b5791-1037-533d-a2f0-5ffb4bac0dd8" :question/math-academy-id "q-140469" :question/problem "Find ${H}^{⊥}$ if $H=\\text{Span}\\{[\\begin{aligned}-4 \\\\ 7\\end{aligned}],[\\begin{aligned}8 \\\\ -14\\end{aligned}]\\}.$" :question/worked-solution "Let's denote the vectors that span the subspace $H$ as ${h}_{1}$ and ${h}_{2}.$ \n\nA vector $x=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$ belongs to ${H}^{⊥}$ if $x\\cdot {h}_{1}=0$ and $x\\cdot {h}_{2}=0.$ So, we need to solve the following system:\n\n$$\n\\{\\begin{aligned}x\\cdot {h}_{1}=0 \\\\ x\\cdot {h}_{2}=0\\end{aligned}\\,⟹\\,\\{\\begin{aligned}-4{x}_{1}+7{x}_{2}=0 \\\\ 8{x}_{1}-14{x}_{2}=0\\end{aligned}\n$$\n\nwith the augmented matrix $M,$ which we reduce to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}-4 & 7 & 0 \\\\ 8 & -14 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}-4 & 7 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nIn the reduced matrix above, we have $1$ pivot column (the $1$st one), so ${x}_{2}$ is a free variable. From the first equation, we get ${x}_{1}=\\frac{7}{4}{x}_{2}.$ So, the general solution is\n\n$$\n[\\begin{aligned}\\frac{7}{4}{x}_{2} \\\\ {x}_{2}\\end{aligned}],\\,{x}_{2}\\in R.\n$$\n\nTherefore, our orthogonal complement is\n\n$$\n{H}^{⊥}=\\{[\\begin{aligned}\\frac{7}{4}{x}_{2} \\\\ {x}_{2}\\end{aligned}]\\,:\\,{x}_{2}\\in R\\}.\n$$"}] [{:db/id #edb/ref 17592186134247 :knowledge-point/_questions [{:db/id #edb/ref 17592186133780 :knowledge-point/id #uuid "2b2f7e06-54f8-5a9b-a926-362fb087b59c" :knowledge-point/title "Finding the Orthogonal Complement of a Span"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "315b71a4-28e0-5aea-b2c4-c7a46375dded" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{H}^{⊥}={\\begin{bmatrix}{x}_{1} \\\\ 3{x}_{1}\\end{bmatrix}\\,:\\,{x}_{1}\\in R}" :db/id #edb/ref 17592186324369} {:answer/id #uuid "39895333-f8bd-5aaa-90e7-ecbd25f291f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{H}^{⊥}={\\begin{bmatrix}{x}_{1} \\\\ -\\frac{2}{3}{x}_{1}\\end{bmatrix}\\,:\\,{x}_{1}\\in R}" :db/id #edb/ref 17592186324438} {:answer/id #uuid "70b0d670-feb2-5e76-a4a2-11b302ca3fac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{H}^{⊥}={\\begin{bmatrix}\\frac{3}{2}{x}_{2} \\\\ {x}_{2}\\end{bmatrix}\\,:\\,{x}_{2}\\in R}" :db/id #edb/ref 17592186324898} {:answer/id #uuid "821b82f3-fe56-570f-ade4-2d7232dcbfa1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{H}^{⊥}={0}" :db/id #edb/ref 17592186325065} {:answer/id #uuid "f75310d1-47c6-57cf-9ba0-7e4f001d4215" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{H}^{⊥}={\\begin{bmatrix}\\frac{2}{3}{x}_{2} \\\\ {x}_{2}\\end{bmatrix}\\,:\\,{x}_{2}\\in R}" :db/id #edb/ref 17592186326151}] :answer-field/correct {:answer/id #uuid "70b0d670-feb2-5e76-a4a2-11b302ca3fac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{H}^{⊥}={\\begin{bmatrix}\\frac{3}{2}{x}_{2} \\\\ {x}_{2}\\end{bmatrix}\\,:\\,{x}_{2}\\in R}" :db/id #edb/ref 17592186324898} :answer-field/id #uuid "c64c6253-854b-5bb4-95cc-01aebed6b16b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326582}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "17bd69d7-65e4-535e-bfc3-813ca9368a10" :question/math-academy-id "q-39915" :question/problem "Find ${H}^{⊥}$ if $H=\\text{Span}{\\begin{bmatrix}6 \\\\ -9\\end{bmatrix},\\begin{bmatrix}4 \\\\ -6\\end{bmatrix}}.$" :question/worked-solution "Let's denote the vectors that span the subspace $H$ as ${h}_{1}$ and ${h}_{2}.$ \n\nA vector $x=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}$ belongs to ${H}^{⊥}$ if $x\\cdot {h}_{1}=0$ and $x\\cdot {h}_{2}=0.$ So, we need to solve the following system:\n\n$$\n{\\begin{aligned}x\\cdot {h}_{1}=0 \\\\ x\\cdot {h}_{2}=0\\end{aligned}\\,⟹\\,{\\begin{aligned}6{x}_{1}-9{x}_{2}=0 \\\\ 4{x}_{1}-6{x}_{2}=0\\end{aligned}\n$$\n\nwith the augmented matrix $M,$ which we reduce to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}6 & -9 & 0 \\\\ 4 & -6 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}-\\frac{2}{3}{R}_{1} \\\\  & ∼\\begin{bmatrix}6 & -9 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nIn the reduced matrix above, we have $1$ pivot column (the $1$st one), so ${x}_{2}$ is a free variable. From the first equation, we get ${x}_{1}=\\frac{3}{2}{x}_{2}.$ So, the general solution is\n\n$$\n\\begin{bmatrix}\\frac{3}{2}{x}_{2} \\\\ {x}_{2}\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nTherefore, our orthogonal complement is\n\n$$\n{H}^{⊥}={\\begin{bmatrix}\\frac{3}{2}{x}_{2} \\\\ {x}_{2}\\end{bmatrix}\\,:\\,{x}_{2}\\in R}.\n$$"}] [{:db/id #edb/ref 17592186134499 :knowledge-point/_questions [{:db/id #edb/ref 17592186133779 :knowledge-point/id #uuid "9aa43961-5b6a-5c8b-adea-809d0a693cd1" :knowledge-point/title "Calculating the Components of a Vector Orthogonal to a Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "842b5c5c-cc5c-50d2-b823-6def6fca04e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186133033} {:answer/id #uuid "da8821b3-5d06-5e21-80f5-a553896d64c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186133034} {:answer/id #uuid "15e8b357-5098-57b9-8c74-02a2282b9714" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186133035} {:answer/id #uuid "38f6361e-a902-560f-9217-4c195d638701" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186133036} {:answer/id #uuid "660803b9-f7f4-568d-8a7c-5d45e4320d32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186133037}] :answer-field/id #uuid "142bdc42-c623-5b18-9590-d0d791655eb1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186133032} {:answer-field/choices [{:answer/id #uuid "6ae2689b-03da-5b4a-8bd9-e03a7a3d536c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186393086} {:answer/id #uuid "2c523036-0297-53fb-8cf4-0a2347f12c7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186393087} {:answer/id #uuid "e5ddb235-9955-5a27-87c5-3f2c81216912" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186393088} {:answer/id #uuid "56996c07-885b-5b0d-8973-e1ca5a8ac3fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186393089} {:answer/id #uuid "81374ca6-2fbe-5ee7-a0ba-75942ffe6258" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186393090}] :answer-field/correct {:answer/id #uuid "e5ddb235-9955-5a27-87c5-3f2c81216912" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186393088} :answer-field/id #uuid "98103ba7-7941-593f-8c55-fa6f21186d7c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393085}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e055065d-3cdf-5f06-8b7f-a22a1c681c38" :question/math-academy-id "q-71102" :question/problem "Given that $u=\\begin{bmatrix}a \\\\ b \\\\ c\\end{bmatrix}$ is a non-zero  vector that is orthogonal to the set $W={\\begin{bmatrix}1 \\\\ -3 \\\\ 1\\end{bmatrix},\\begin{bmatrix}3 \\\\ 1 \\\\ -2\\end{bmatrix}},$ find the value of $\\frac{c}{a+b}.$" :question/worked-solution "The vector $u$ is orthogonal to the set $W$ if $u\\cdot {w}_{1}=0$ and $u\\cdot {w}_{2}=0.$ So, we need to solve the following system:\n\n$$\n{\\begin{aligned}u\\cdot {w}_{1}=0 \\\\ u\\cdot {w}_{2}=0\\end{aligned}\\,⟹\\,{\\begin{aligned}{x}_{1}-3{x}_{2}+{x}_{3}=0 \\\\ 3{x}_{1}+{x}_{2}-2{x}_{3}=0\\end{aligned}\n$$\n\nwith the augmented matrix $M,$ which we reduce to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -3 & 1 & 0 \\\\ 3 & 1 & -2 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 & 1 & 0 \\\\ 0 & 10 & -5 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nIn the reduced matrix above, we have $2$ pivot columns (the $1$st and $2$nd), so ${x}_{3}$ is a free variable. From the second equation, we get ${x}_{2}=\\frac{1}{2}{x}_{3}.$ Substituting this into the first equation, we obtain ${x}_{1}=\\frac{1}{2}{x}_{3}.$ So, the general solution is\n\n$$\n\\begin{bmatrix}\\frac{1}{2}{x}_{3} \\\\ \\frac{1}{2}{x}_{3} \\\\ {x}_{3}\\end{bmatrix},\\,{x}_{3}\\in R.\n$$\n\nSetting ${x}_{3}=2,$ we get the vector \n$\\begin{bmatrix}1 \\\\ 1 \\\\ 2\\end{bmatrix}.$\n\nTherefore, we obtain $a=1,$ $b=1,$ and $c=2.$\n\nFinally, $\\frac{c}{a+b}=\\frac{2}{1+1}=1.$"}] [{:db/id #edb/ref 17592186348409 :knowledge-point/_questions [{:db/id #edb/ref 17592186133779 :knowledge-point/id #uuid "9aa43961-5b6a-5c8b-adea-809d0a693cd1" :knowledge-point/title "Calculating the Components of a Vector Orthogonal to a Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24e627cc-9ad9-5364-a03f-0a60a7ff7e76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186345685} {:answer/id #uuid "35a5cdc8-809a-5ac7-966a-3468c85a0cc8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186345814} {:answer/id #uuid "5ad54b60-cd95-5301-a3d6-c6926d9c9dc5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186346126} {:answer/id #uuid "628879f1-3e6f-5f07-bd70-ca54cc5545bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186346212} {:answer/id #uuid "7cffd9e3-8a81-51c0-af55-dcb26b21e161" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186346443}] :answer-field/correct {:answer/id #uuid "24e627cc-9ad9-5364-a03f-0a60a7ff7e76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186345685} :answer-field/id #uuid "2222f2a3-c047-5414-b19b-01d3b4f258cf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347663}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ff28c518-d713-5726-9541-4836cde2e6b1" :question/math-academy-id "q-80539" :question/problem "Given that $u=\\begin{bmatrix}a \\\\ b \\\\ c\\end{bmatrix}$ is a non-zero vector that is orthogonal to the set $W={\\begin{bmatrix}1 \\\\ -3 \\\\ -1\\end{bmatrix},\\begin{bmatrix}3 \\\\ 1 \\\\ 1\\end{bmatrix}},$ find the value of $\\frac{b+c}{a}.$" :question/worked-solution "The vector $u$ is orthogonal to the set $W$ if $u\\cdot {w}_{1}=0$ and $u\\cdot {w}_{2}=0.$ So, we need to solve the following system:\n\n$$\n{\\begin{aligned}u\\cdot {w}_{1}=0 \\\\ u\\cdot {w}_{2}=0\\end{aligned}\\,⟹\\,{\\begin{aligned}{x}_{1}-3{x}_{2}-{x}_{3}=0 \\\\ 3{x}_{1}+{x}_{2}+{x}_{3}=0\\end{aligned}\n$$\n\nwith the augmented matrix $M,$ which we reduce to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -3 & -1 & 0 \\\\ 3 & 1 & 1 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 & -1 & 0 \\\\ 0 & 10 & 4 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nIn the reduced matrix above, we have $2$ pivot columns (the $1$st and $2$nd), so ${x}_{3}$ is a free variable. From the second equation, we get ${x}_{2}=-\\frac{2}{5}{x}_{3}.$ Substituting this into the first equation, we obtain ${x}_{1}=-\\frac{1}{5}{x}_{3}.$ So, the general solution is\n\n$$\n\\begin{bmatrix}-\\frac{1}{5}{x}_{3} \\\\ -\\frac{2}{5}{x}_{3} \\\\ {x}_{3}\\end{bmatrix},\\,{x}_{3}\\in R.\n$$\n\nSetting ${x}_{3}=5$, we get the vector \n$\\begin{bmatrix}-1 \\\\ -2 \\\\ 5\\end{bmatrix}.$\n\nTherefore, we obtain $a=-1,$ $b=-2,$ and $c=5.$\n\nFinally, $\\frac{b+c}{a}=\\frac{-2+5}{-1}=-3.$"}] [{:db/id #edb/ref 17592186348415 :knowledge-point/_questions [{:db/id #edb/ref 17592186133817 :knowledge-point/id #uuid "bb11d128-ee1b-5c35-aefb-1455570d20c6" :knowledge-point/title "Identifying Which Vectors Belong to the Orthogonal Complement of a Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06d3f947-88e4-5988-8e0d-3fd68cbe30be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${v}_{3}$  only" :db/id #edb/ref 17592186345410} {:answer/id #uuid "2f715520-d0fb-53f3-b206-534321c0bc79" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${v}_{1}$  only" :db/id #edb/ref 17592186345771} {:answer/id #uuid "57cd3071-12ba-5752-be59-a530d172b957" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${v}_{1}$ and ${v}_{3}$ only" :db/id #edb/ref 17592186346101} {:answer/id #uuid "b7805445-b42b-5871-918b-c9f63736a062" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${v}_{2}$ and ${v}_{3}$ only" :db/id #edb/ref 17592186346951} {:answer/id #uuid "c9365c52-9d6b-5c2f-bb15-037396c3ab84" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${v}_{1}$ and ${v}_{2}$ only" :db/id #edb/ref 17592186347103}] :answer-field/correct {:answer/id #uuid "2f715520-d0fb-53f3-b206-534321c0bc79" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${v}_{1}$  only" :db/id #edb/ref 17592186345771} :answer-field/id #uuid "b15bb1c1-681b-5425-b17c-5396ce1536d8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347912}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "105935bf-05fc-5973-9fd9-74c435a6a9b6" :question/math-academy-id "q-80581" :question/problem "Consider the vector subspace $H=\\text{Span}{\\begin{bmatrix}1 \\\\ 4 \\\\ -4\\end{bmatrix}}.$ Which of the following vectors belong to ${H}^{⊥}?$\n\n$$\n{v}_{1}=\\begin{bmatrix}4 \\\\ -5 \\\\ -4\\end{bmatrix},\\,{v}_{2}=\\begin{bmatrix}2 \\\\ 4 \\\\ -3\\end{bmatrix},\\,{v}_{3}=\\begin{bmatrix}1 \\\\ -1 \\\\ 4\\end{bmatrix}\n$$" :question/worked-solution "Let  $h=\\begin{bmatrix}1 \\\\ 4 \\\\ -4\\end{bmatrix}.$ A vector  $v$ belongs to ${H}^{⊥}$ if $v$ is orthogonal to $h.$ So, we have to find the products ${v}_{i}\\cdot h$ for $i=1,2,3.$   \n\n- For ${v}_{1}$, we have the following:\n\n$$\n\\begin{aligned}{v}_{1}\\cdot h & =4\\cdot 1+(-5)\\cdot 4+(-4)\\cdot (-4)=0 & ✓\\end{aligned}\n$$\n\n \nSo, ${v}_{1}\\in {H}^{⊥}.$\n\n- For ${v}_{2}$, we have the following:\n\n$$\n\\begin{aligned}{v}_{2}\\cdot h & =2\\cdot 1+4\\cdot 4+(-3)\\cdot (-4)=30\\ne 0 & \\times \\end{aligned}\n$$\n\n \nSo, ${v}_{2}\\notin {H}^{⊥}.$\n\n- For ${v}_{3}$, we have the following:\n\n$$\n\\begin{aligned}{v}_{3}\\cdot h & =1\\cdot 1+(-1)\\cdot 4+4\\cdot (-4)=-19\\ne 0 & \\times \\end{aligned}\n$$\n\nSo, ${v}_{3}\\notin {H}^{⊥}.$\n\nTherefore, the correct answer is \"${v}_{1}$  only\"."}]}
