  "live_records": {
    "q-42491": {
      "dom_id": "step-q42491",
      "name": "Question 1",
      "problem": "Suppose $A$ is a $5\\times 5$ matrix and $det(A)=6.$ The matrix $B$ is obtained from $A$ by applying the elementary row operation ${R}_{1}↔{R}_{2}$ (switching the first and the second rows). What is the value of $det(B)?$",
      "worked_solution": "Since swapping any two rows changes the sign of the determinant to the opposite sign, we have\n\n$$\n\\begin{aligned}det(B) & =-det(A) \\\\  & =-(6) \\\\  & =-6.\\end{aligned}\n$$",
      "calculator_instructions": "",
