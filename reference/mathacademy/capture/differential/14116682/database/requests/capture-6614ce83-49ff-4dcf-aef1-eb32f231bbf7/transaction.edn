6-15b5-5fe0-b45f-ce012015c3e0" :answer-field/id #uuid "2d954636-15b5-5fe0-b45f-ce012015c3e0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8b0ff215-a15d-58fa-8a84-6b3c46517368" :answer-field/choices ["answer-8b0ff215-a15d-58fa-8a84-6b3c46517368" "answer-f664b945-3527-5f51-abfc-ae17525d67b6" "answer-78ccb4fd-9ad3-5659-84e0-a011530ee6d8" "answer-e6ee5a00-c62f-5993-8707-cb7aba8270c7" "answer-132747fd-8145-5600-a67f-e5fedabc2538"] :db/ensure [:answer-field/validate]} {:db/id "answer-8b0ff215-a15d-58fa-8a84-6b3c46517368" :answer/id #uuid "8b0ff215-a15d-58fa-8a84-6b3c46517368" :answer/type :answer.type/math :answer/value "-15" :db/ensure [:answer/validate]} {:db/id "answer-f664b945-3527-5f51-abfc-ae17525d67b6" :answer/id #uuid "f664b945-3527-5f51-abfc-ae17525d67b6" :answer/type :answer.type/math :answer/value "-240" :db/ensure [:answer/validate]} {:db/id "answer-78ccb4fd-9ad3-5659-84e0-a011530ee6d8" :answer/id #uuid "78ccb4fd-9ad3-5659-84e0-a011530ee6d8" :answer/type :answer.type/math :answer/value "-60" :db/ensure [:answer/validate]} {:db/id "answer-e6ee5a00-c62f-5993-8707-cb7aba8270c7" :answer/id #uuid "e6ee5a00-c62f-5993-8707-cb7aba8270c7" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "answer-132747fd-8145-5600-a67f-e5fedabc2538" :answer/id #uuid "132747fd-8145-5600-a67f-e5fedabc2538" :answer/type :answer.type/math :answer/value "60" :db/ensure [:answer/validate]} {:db/id "question-8e473584-e9d3-56ba-b273-e8476acf9443" :question/id #uuid "8e473584-e9d3-56ba-b273-e8476acf9443" :question/math-academy-id "q-72750" :question/problem "Suppose $C$ is a $5\\times 5$ matrix and $det(C)=-24.$ The matrix $D$ is obtained from $C$ by applying the elementary row operations ${R}_{1}↔{R}_{5}$ and ${R}_{3}:=-\\frac{1}{6}{R}_{3}.$ What is the value of $det(D)?$" :question/worked-solution "First, let's figure out what each operation does to the determinant.\n\n- The operation ${R}_{1}↔{R}_{5}$ involves swapping two rows, so it changes the sign of the determinant to the opposite one.\n\n- The operation ${R}_{3}:=-\\frac{1}{6}{R}_{3}$ involves multiplying a row by $-\\frac{1}{6},$ so the determinant is multiplied by $-\\frac{1}{6}$ as well.\n\nTherefore, we have to change the sign of the determinant to the opposite one and multiply by $-\\frac{1}{6}$ as well. Consequently, we get\n\n$$\n\\begin{aligned}det(D) & =-\\frac{1}{6}\\cdot (-det(C)) \\\\  & =\\frac{1}{6}det(C) \\\\  & =\\frac{1}{6}\\cdot (-24) \\\\  & =-4.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-31de2b36-2a3a-5de3-9428-2467d57745e7"] :db/ensure [:question/validate]} {:db/id "answer-field-31de2b36-2a3a-5de3-9428-2467d57745e7" :answer-field/id #uuid "31de2b36-2a3a-5de3-9428-2467d57745e7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-40a285bb-2c28-5dc2-bb55-500bf985bb7b" :answer-field/choices ["answer-43e91860-50ac-5b66-b967-946f1e1fc8f0" "answer-6a51c6b8-2c73-55e3-a6ed-302213e3f577" "answer-40a285bb-2c28-5dc2-bb55-500bf985bb7b" "answer-40238690-4089-5383-b0be-144e4a66318a" "answer-bae51b38-f76c-5484-acc5-93c339e8b199"] :db/ensure [:answer-field/validate]} {:db/id "answer-43e91860-50ac-5b66-b967-946f1e1fc8f0" :answer/id #uuid "43e91860-50ac-5b66-b967-946f1e1fc8f0" :answer/type :answer.type/math :answer/value "-20" :db/ensure [:answer/validate]} {:db/id "answer-6a51c6b8-2c73-55e3-a6ed-302213e3f577" :answer/id #uuid "6a51c6b8-2c73-55e3-a6ed-302213e3f577" :answer/type :answer.type/math :answer/value "-24" :db/ensure [:answer/validate]} {:db/id "answer-40a285bb-2c28-5dc2-bb55-500bf985bb7b" :answer/id #uuid "40a285bb-2c28-5dc2-bb55-500bf985bb7b" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "answer-40238690-4089-5383-b0be-144e4a66318a" :answer/id #uuid "40238690-4089-5383-b0be-144e4a66318a" :answer/type :answer.type/math :answer/value "24" :db/ensure [:answer/validate]} {:db/id "answer-bae51b38-f76c-5484-acc5-93c339e8b199" :answer/id #uuid "bae51b38-f76c-5484-acc5-93c339e8b199" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "question-441df1fa-6b02-5f85-abd1-1592ef6dada4" :question/id #uuid "441df1fa-6b02-5f85-abd1-1592ef6dada4" :question/math-academy-id "q-72770" :question/problem "Consider the matrices given below. Given that $A$ and $B$ are row equivalent matrices and $det(A)=1$, find $det(B).$\n\n$$\nA=[\\begin{aligned}0 & 1 & -1 \\\\ 1 & -2 & 3 \\\\ 4 & 2 & 1\\end{aligned}],\\,B=[\\begin{aligned}0 & 1 & -1 \\\\ 4 & -8 & 12 \\\\ 4 & 2 & 1\\end{aligned}].\n$$" :question/worked-solution "Notice that $B$ can be obtained from $A$ by multiplying the $2$nd row by $4.$ \n\nSo, the determinant is multiplied by $4$ as well.\nTherefore, we obtain\n\n$$\n\\begin{aligned}det(B) & =4\\cdot det(A) \\\\  & =4\\cdot 1 \\\\  & =4.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-93fee275-10ef-55f5-b6b3-8793339d38c8"] :db/ensure [:question/validate]} {:db/id "answer-field-93fee275-10ef-55f5-b6b3-8793339d38c8" :answer-field/id #uuid "93fee275-10ef-55f5-b6b3-8793339d38c8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ca4dd63f-7252-5bf2-9499-144f36222c27" :answer-field/choices ["answer-e1001e71-dfc2-59ca-a3c7-8d9e00835d22" "answer-2bb7ef99-5504-5559-a251-067d58c0bd0c" "answer-1efd96de-5d59-5c21-b6c4-f57a804edb99" "answer-5f7847c9-3225-566d-a4bb-dbc66736309d" "answer-ca4dd63f-7252-5bf2-9499-144f36222c27"] :db/ensure [:answer-field/validate]} {:db/id "answer-e1001e71-dfc2-59ca-a3c7-8d9e00835d22" :answer/id #uuid "e1001e71-dfc2-59ca-a3c7-8d9e00835d22" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-2bb7ef99-5504-5559-a251-067d58c0bd0c" :answer/id #uuid "2bb7ef99-5504-5559-a251-067d58c0bd0c" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "answer-1efd96de-5d59-5c21-b6c4-f57a804edb99" :answer/id #uuid "1efd96de-5d59-5c21-b6c4-f57a804edb99" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-5f7847c9-3225-566d-a4bb-dbc66736309d" :answer/id #uuid "5f7847c9-3225-566d-a4bb-dbc66736309d" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-ca4dd63f-7252-5bf2-9499-144f36222c27" :answer/id #uuid "ca4dd63f-7252-5bf2-9499-144f36222c27" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id 17592186121020 :tutorial/content "Remember the following three standard elementary row operations: \n\n  I. Swapping two rows\n\n  II. Multiplying a row by a non-zero number\n\n  III. Adding a multiple of one row to another row\n\nOf these three elementary row operations, only III (adding a multiple of one row to another row) *preserves* the determinant. The other two operations, switching two rows or multiplying a row by a non-zero number, *change* the determinant.\n\nTo demonstrate, let's consider the matrix ![](images/fa/fa51d7c585db408c47e8640ae839c1a3bbf94e2b0097e1ade511e5773461f1e8.svg) Taking the determinant, we have\n![](images/bc/bcf5c5dc9f5b7ed3849e719665f802040cf51e3334ae99e25ea7648cbb0f6134.svg)\n\nIf we swap the two rows, we get a different determinant:\n\n$$\n\\begin{aligned}|\\begin{aligned}3 & 4 \\\\ 1 & 2\\end{aligned}| & =3\\cdot 2-1\\cdot 4 \\\\  & =2 \\\\  & \\ne -2\\,\\times \\end{aligned}\n$$\n\nLikewise, if we multiply top row by ${\\color{red}2},$ then we get a different determinant:\n\n$$\n\\begin{aligned}|\\begin{aligned}2\\cdot 1 & 2\\cdot 2 \\\\ 3 & 4\\end{aligned}| & =|\\begin{aligned}2 & 4 \\\\ 3 & 4\\end{aligned}| \\\\  & =2\\cdot 4-3\\cdot 4 \\\\  & =-4 \\\\  & \\ne -2\\,\\times \\end{aligned}\n$$\n\nHowever, if we add twice the top row to the bottom row, then we get the same determinant:\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 2 \\\\ 3+2\\cdot 1 & 4+2\\cdot 2\\end{aligned}| & =|\\begin{aligned}1 & 2 \\\\ 5 & 8\\end{aligned}| \\\\  & =1\\cdot 8-2\\cdot 5 \\\\  & =-2\\,✓\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186121045 :tutorial/content "As we have seen, multiplying a row by a number does not preserve the determinant. However, it does affect the determinant in a predictable way: multiplying a row by a number scales the determinant by that number as well.\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 2 \\\\ 3 & 4\\end{aligned}| & =1\\cdot 4-2\\cdot 3=-2 \\\\ |\\begin{aligned}2\\cdot 1 & 2\\cdot 2 \\\\ 3 & 4\\end{aligned}|=|\\begin{aligned}2 & 4 \\\\ 3 & 4\\end{aligned}| & =2\\cdot 4-3\\cdot 4=-4\\end{aligned}\n$$\n\nSo, in the above example, we have\n![](images/08/0826c05fe2eabec96065eb2c83228168129b42c309764df4b101f4a520c4a0f9.svg)\n\nIn general, multiplying a row of a matrix by a number multiplies the determinant by that number. That is to say, we can factor out the common multiplier from the row of the determinant:\n\n$$\n\\begin{aligned}det[\\begin{aligned}⋮ & ⋮ & … & ⋮ \\\\ k△ & k△ & … & k△ \\\\ ⋮ & ⋮ & … & ⋮\\end{aligned}]=k\\cdot det[\\begin{aligned}⋮ & ⋮ & … & ⋮ \\\\ △ & △ & … & △ \\\\ ⋮ & ⋮ & … & ⋮\\end{aligned}]\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186121061 :tutorial/content "Let's check what happens if we multiply the entire matrix (not only one row) by a number. For example,\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 2 \\\\ 3 & 4\\end{aligned}| & =1\\cdot 4-2\\cdot 3=-2 \\\\ |\\begin{aligned}3\\cdot 1 & 3\\cdot 2 \\\\ 3\\cdot 3 & 3\\cdot 4\\end{aligned}|=|\\begin{aligned}3 & 6 \\\\ 9 & 12\\end{aligned}| & =3\\cdot 12-6\\cdot 9=-18\\end{aligned}\n$$\n\nSo, in the above example, we have\n\n![](images/fe/fe02091dde43a8a2405f6b588f619bc9fa3f54b31ac8a1ac39d318761f00cc3e.svg)\n\nThe above is equivalent to multiplying both rows of the matrix by $3$. Multiplying the first row scales the determinant by $3$, and then multiplying the second row scales it by $3$ once more.\n\nIn general, multiplying an entire $n \\times n$ matrix by a number multiplies the determinant by that number to the power of $n$. That is to say, we can factor out the common multiplier from the entire matrix, as follows:\n\n$$\n\\begin{aligned}det(k\\cdot A)={k}^{n}\\cdot det(A),\\end{aligned}\n$$\n\nwhere $A$ is an $n \\times n$ matrix." :db/ensure [:tutorial/validate]} {:db/id 17592186119994 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]}]
