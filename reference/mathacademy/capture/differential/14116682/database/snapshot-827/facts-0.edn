b/ref 17592186264165 #edb/ref 17592186045417] [17592186265589 #edb/ref 1075 #edb/ref 17592186264618 #edb/ref 17592186045417] [17592186265589 #edb/ref 1075 #edb/ref 17592186264848 #edb/ref 17592186045417] [17592186265589 #edb/ref 1075 #edb/ref 17592186265234 #edb/ref 17592186045417] [17592186265589 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186265589 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186265589 #edb/ref 1078 #edb/ref 17592186264848 #edb/ref 17592186045417] [17592186265589 #edb/ref 1079 #uuid "c44403e8-a5cd-5235-983a-00f2ee10a5ae" #edb/ref 17592186045417] [17592186265614 #edb/ref 1075 #edb/ref 17592186263742 #edb/ref 17592186045417] [17592186265614 #edb/ref 1075 #edb/ref 17592186264014 #edb/ref 17592186045417] [17592186265614 #edb/ref 1075 #edb/ref 17592186264145 #edb/ref 17592186045417] [17592186265614 #edb/ref 1075 #edb/ref 17592186264937 #edb/ref 17592186045417] [17592186265614 #edb/ref 1075 #edb/ref 17592186264947 #edb/ref 17592186045417] [17592186265614 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186265614 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186265614 #edb/ref 1078 #edb/ref 17592186264014 #edb/ref 17592186045417] [17592186265614 #edb/ref 1079 #uuid "cf6cdcea-ffe0-5e06-a7c5-0284d3815f01" #edb/ref 17592186045417] [17592186265965 #edb/ref 1068 #edb/ref 17592186265589 #edb/ref 17592186045417] [17592186265965 #edb/ref 1069 "q-130738" #edb/ref 17592186045417] [17592186265965 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186265965 #edb/ref 1071 "Suppose $B$ is a $5\\times 5$ matrix and $det(B)=-3.$ What is the value of $det(-2B)?$" #edb/ref 17592186045417] [17592186265965 #edb/ref 1072 #uuid "06a215a3-28a1-5081-94e6-eb4defb995c9" #edb/ref 17592186045417] [17592186265965 #edb/ref 1074 "Multiplying a $n\\times n$ matrix by a scalar $k$ is equivalent to multiplying each row by $k,$ and this occurs $n$ times. This leads to the result\n\n$$\n\\begin{aligned}det(k\\cdot B)={k}^{n}\\cdot det(B).\\end{aligned}\n$$\n\nIn our case, we have $k=-2$ and $n=5.$ Therefore,\n\n$$\n\\begin{aligned}det(-2B) & =(-2)^{5}\\cdot det(B) \\\\  & =-32\\cdot (-3) \\\\  & =96.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186265966 #edb/ref 1068 #edb/ref 17592186265330 #edb/ref 17592186045417] [17592186265966 #edb/ref 1069 "q-130739" #edb/ref 17592186045417] [17592186265966 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186265966 #edb/ref 1071 "Suppose $Y$ is a $3\\times 3$ matrix and $det(Y)=2.$ What is the value of $det(-4Y)?$" #edb/ref 17592186045417] [17592186265966 #edb/ref 1072 #uuid "6d71a2d5-21fb-5641-ae6e-b88e302c6622" #edb/ref 17592186045417] [17592186265966 #edb/ref 1074 "Multiplying a $n\\times n$ matrix by a scalar $k$ is equivalent to multiplying each row by $k,$ and this occurs $n$ times. This leads to the result\n\n$$\n\\begin{aligned}det(k\\cdot Y)={k}^{n}\\cdot det(Y).\\end{aligned}\n$$\n\nIn our case, we have $k=-4$ and $n=3.$ Therefore,\n\n$$\n\\begin{aligned}det(-4Y) & =(-4)^{3}\\cdot det(Y) \\\\  & =-64\\cdot 2 \\\\  & =-128.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186265992 #edb/ref 1068 #edb/ref 17592186265497 #edb/ref 17592186045417] [17592186265992 #edb/ref 1069 "q-130854" #edb/ref 17592186045417] [17592186265992 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186265992 #edb/ref 1071 "Given that $det(A)=det(B),$ which of the following elementary row operations transforms matrix $A$ to matrix $B,$ where\n\n$$\nA=[\\begin{aligned}1 & -2 & 3 \\\\ 3 & 5 & -2 \\\\ 2 & -3 & -1\\end{aligned}],\\,B=[\\begin{aligned}1 & -2 & 3 \\\\ 1 & 8 & -1 \\\\ 2 & -3 & -1\\end{aligned}]?\n$$" #edb/ref 17592186045417] [17592186265992 #edb/ref 1072 #uuid "a88eab2f-0bec-591e-a119-0d1e91654bf5" #edb/ref 17592186045417] [17592186265992 #edb/ref 1074 "Since $det(A)=det(B)$, the row operation applied to $A$ must be to add or subtract a multiple of one row to another row. In other words, it is of the form \n\n$$\n{R}_{j}:={R}_{j}+(k){R}_{i},\\,i\\ne j.\n$$\n\nBy considering the given row operations that are of the above form, we notice that\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}1 & -2 & 3 \\\\ 3 & 5 & -2 \\\\ 2 & -3 & -1\\end{aligned}| & {R}_{2} & :={R}_{2}+(-1){R}_{3} \\\\  & =|\\begin{aligned}1 & -2 & 3 \\\\ 1 & 8 & -1 \\\\ 2 & -3 & -1\\end{aligned}| \\\\  & =det(B).\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{2}:={R}_{2}+(-1){R}_{3}.\n$$" #edb/ref 17592186045417] [17592186265993 #edb/ref 1068 #edb/ref 17592186265614 #edb/ref 17592186045417] [17592186265993 #edb/ref 1069 "q-130855" #edb/ref 17592186045417] [17592186265993 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186265993 #edb/ref 1071 "Consider the matrices given below. Given that $X$ and $Y$ are row equivalent matrices and $det(X)=5$, find $det(Y).$\n\n$$\nX=[\\begin{aligned}2 & -3 & 1 \\\\ 1 & 1 & -2 \\\\ -3 & 2 & 2\\end{aligned}],\\,Y=[\\begin{aligned}2 & -3 & 1 \\\\ -3 & 2 & 2 \\\\ 1 & 1 & -2\\end{aligned}].\n$$" #edb/ref 17592186045417] [17592186265993 #edb/ref 1072 #uuid "2e099506-9b8a-52ad-a7eb-ff6f42b6d002" #edb/ref 17592186045417] [17592186265993 #edb/ref 1074 "Notice that $Y$ can be obtained from $X$ by swapping the $2$nd and the $3$rd rows. \n\nThis changes the sign of the determinant to the opposite one.\nTherefore, we obtain\n\n$$\n\\begin{aligned}det(Y) & =-det(X) \\\\  & =-(5) \\\\  & =-5.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186327183 #edb/ref 1080 "4" #edb/ref 17592186045417] [17592186327183 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186327183 #edb/ref 1083 #uuid "1ceb8d39-892a-568d-bb1d-1e0de0abcd35" #edb/ref 17592186045417] [17592186327204 #edb/ref 1080 "-4" #edb/ref 17592186045417] [17592186327204 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186327204 #edb/ref 1083 #uuid "1f2ad961-98aa-51c8-9cf6-358e73cf2d49" #edb/ref 17592186045417] [1759218632737