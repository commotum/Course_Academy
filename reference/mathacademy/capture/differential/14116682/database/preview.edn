34140 17592186045417 true] [17592186411961 1078 #edb/ref 17592186411945 13194139534140 17592186045417 true] [17592186411961 1079 #uuid "93fee275-10ef-55f5-b6b3-8793339d38c8" 13194139534140 17592186045417 true] [17592186411962 1075 #edb/ref 17592186411931 13194139534140 17592186045417 true] [17592186411962 1075 #edb/ref 17592186411938 13194139534140 17592186045417 true] [17592186411962 1075 #edb/ref 17592186411942 13194139534140 17592186045417 true] [17592186411962 1075 #edb/ref 17592186411943 13194139534140 17592186045417 true] [17592186411962 1075 #edb/ref 17592186411946 13194139534140 17592186045417 true] [17592186411962 1076 #edb/ref 17592186045493 13194139534140 17592186045417 true] [17592186411962 1077 "selection" 13194139534140 17592186045417 true] [17592186411962 1078 #edb/ref 17592186411943 13194139534140 17592186045417 true] [17592186411962 1079 #uuid "edd46d74-f62c-517b-8453-8f9197d0ad86" 13194139534140 17592186045417 true] [17592186411963 1068 #edb/ref 17592186411961 13194139534140 17592186045417 true] [17592186411963 1069 "q-72770" 13194139534140 17592186045417 true] [17592186411963 1070 #edb/ref 17592186045485 13194139534140 17592186045417 true] [17592186411963 1071 "Consider the matrices given below. Given that $A$ and $B$ are row equivalent matrices and $det(A)=1$, find $det(B).$\n\n$$\nA=[\\begin{aligned}0 & 1 & -1 \\\\ 1 & -2 & 3 \\\\ 4 & 2 & 1\\end{aligned}],\\,B=[\\begin{aligned}0 & 1 & -1 \\\\ 4 & -8 & 12 \\\\ 4 & 2 & 1\\end{aligned}].\n$$" 13194139534140 17592186045417 true] [17592186411963 1072 #uuid "441df1fa-6b02-5f85-abd1-1592ef6dada4" 13194139534140 17592186045417 true] [17592186411963 1074 "Notice that $B$ can be obtained from $A$ by multiplying the $2$nd row by $4.$ \n\nSo, the determinant is multiplied by $4$ as well.\nTherefore, we obtain\n\n$$\n\\begin{aligned}det(B) & =4\\cdot det(A) \\\\  & =4\\cdot 1 \\\\  & =4.\\end{aligned}\n$$" 13194139534140 17592186045417 true] [17592186411964 1068 #edb/ref 17592186411962 13194139534140 17592186045417 true] [17592186411964 1069 "q-130679" 13194139534140 17592186045417 true] [17592186411964 1070 #edb/ref 17592186045485 13194139534140 17592186045417 true] [17592186411964 1071 "Suppose $A$ is a $5\\times 5$ matrix and $det(A)=-31.$ The matrix $B$ is obtained from $A$ by applying the elementary row operation ${R}_{2}↔{R}_{4}$ (switching the second and the fourth rows). What is the value of $det(B)?$" 13194139534140 17592186045417 true] [17592186411964 1072 #uuid "6035e308-4a34-531b-a058-679d8485fb52" 13194139534140 17592186045417 true] [17592186411964 1074 "Since swapping any two rows changes the sign of the determinant to the opposite sign, we have\n\n$$\n\\begin{aligned}det(B) & =-det(A) \\\\  & =-(-31) \\\\  & =31.\\end{aligned}\n$$" 13194139534140 17592186045417 true] [17592186411965 1068 #edb/ref 17592186411960 13194139534140 17592186045417 true] [17592186411965 1069 "q-72722" 13194139534140 17592186045417 true] [17592186411965 1070 #edb/ref 17592186045485 13194139534140 17592186045417 true] [17592186411965 1071 "Suppose $B$ is a $3\\times 3$ matrix and $det(B)=12.$ The matrix $C$ is obtained from $B$ by applying the elementary row operation ${R}_{3}↔{R}_{2}$ (switching the second and the third rows). What is the value of $det(C)?$" 13194139534140 17592186045417 true] [17592186411965 1072 #uuid "8d84b0ed-254e-5487-a529-04888ae00fda" 13194139534140 17592186045417 true] [17592186411965 1074 "Since swapping any two rows changes the sign of the determinant to the opposite sign, we have\n\n$$\n\\begin{aligned}det(C) & =-det(B) \\\\  & =-(12) \\\\  & =-12.\\end{aligned}\n$$" 13194139534140 17592186045417 true] [17592186411966 1068 #edb/ref 17592186411955 13194139534140 17592186045417 true] [17592186411966 1069 "q-72750" 13194139534140 17592186045417 true] [17592186411966 1070 #edb/ref 17592186045487 13194139534140 17592186045417 true] [17592186411966 1071 "Suppose $C$ is a $5\\times 5$ matrix and $det(C)=-24.$ The matrix $D$ is obtained from $C$ by applying the elementary row operations ${R}_{1}↔{R}_{5}$ and ${R}_{3}:=-\\frac{1}{6}{R}_{3}.$ What is the value of $det(D)?$" 13194139534140 17592186045417 true] [17592186411966 1072 #uuid "8e473584-e9d3-56ba-b273-e8476acf9443" 13194139534140 17592186045417 true] [17592186411966 1074 "First, let's figure out what each operation does to the determinant.\n\n- The operation ${R}_{1}↔{R}_{5}$ involves swapping two rows, so it changes the sign of the determinant to the opposite one.\n\n- The operation ${R}_{3}:=-\\frac{1}{6}{R}_{3}$ involves multiplying a row by $-\\frac{1}{6},$ so the determinant is multiplied by $-\\frac{1}{6}$ as well.\n\nTherefore, we have to change the sign of the determinant to the opposite one and multiply by $-\\frac{1}{6}$ as well. Consequently, we get\n\n$$\n\\begin{aligned}det(D) & =-\\frac{1}{6}\\cdot (-det(C)) \\\\  & =\\frac{1}{6}det(C) \\\\  & =\\frac{1}{6}\\cdot (-24) \\\\  & =-4.\\end{aligned}\n$$" 13194139534140 17592186045417 true] [17592186411967 1068 #edb/ref 17592186411959 13194139534140 17592186045417 true] [17592186411967 1069 "q-130685" 13194139534140 17592186045417 true] [17592186411967 1070 #edb/ref 17592186045485 13194139534140 17592186045417 true] [17592186411967 1071 "Suppose $B$ is a $7\\times 7$ matrix and $det(B)=103.$ The matrix $C$ is obtained from $B$ by applying the elementary row operation ${R}_{7}↔{R}_{3}$ (switching the seventh and the third rows). What is the value of $det(C)?$" 13194139534140 17592186045417 true] [17592186411967 1072 #uuid "9e7ff967-4362-5d3c-a258-c6d91f60d8e0" 13194139534140 17592186045417 true] [17592186411967 1074 "Since swapping any two rows changes the sign of the determinant to the opposite sign, we have\n\n$$\n\\begin{aligned}det(C) & =-det(B) \\\\  & =-(103) \\\\  & =-103.\\end{aligned}\n$$" 13194139534140 17592186045417 true] [17592186411968 1068 #edb/ref 17592186411958 13194139534140 17592186045417 true] [17592186411968 1069 "q-72732" 13194139534140 17592186045417 true] [17592186411968 1070 #edb/ref 17592186045485 13194139534140 17592186045417 true] [17592186411968 1071 "Suppose $B$ is a $3\\times 3$ matrix and $det(B)=102.$ The matrix $C$ is obtained from $B$ by applying the elementary row operation ${R}_{2}:=-\\frac{1}{2}{R}_{2}.$ What is the value of $det(C)?$" 13194139534140 17592186045417 true] [17592186411968 1072 #uuid "b576de71-195c-5652-8dd1-ca2db7441a59" 13194139534140 17592186045417 true] [17592186411968 1074 "The row operation applied to $B$ consists of multiplying a row by the number $-\\frac{1}{2}.$\n\nWhen we do this, the determinant is multiplied by the same number. So, we have\n\n$$\n\\begin{aligned}det(C) & =-\\frac{1}{2}det(B) \\\\  & =-\\frac{1}{2}\\cdot 102 \\\\  & =-51.\\end{aligned}\n$$" 13194139534140 17592186045417 true] [17592186411969 1068 #edb/ref 17592186411954 13194139534140 17592186045417 true] [17592186411969 1069 "q-72728" 13194139534140 17592186045417 true] [17592186411969 1070 #edb/ref 17592186045485 13194139534140 17592186045417 true] [17592186411969 1071 "Suppose $X$ is a $3\\times 3$ matrix and $det(X)=-60.$ The matrix $Y$ is obtained from $X$ by applying the elementary row operation ${R}_{3}:=\\frac{1}{4}{R}_{3}.$ What is the value of $det(Y)?$" 13194139534140 17592186045417 true] [17592186411969 1072 #uuid "befe5af1-f89b-5614-a978-2722ee7dbb46" 13194139534140 17592186045417 true] [17592186411969 1074 "The row operation applied to $X$ consists of multiplying a row by the number $\\frac{1}{4}.$\n\nWhen we do this, the determinant is multiplied by the same number. So, we have\n\n$$\n\\begin{aligned}det(Y) & =\\frac{1}{4}det(X) \\\\  & =\\frac{1}{4}\\cdot (-60) \\\\  & =-15.\\end{aligned}\n$$" 13194139534140 17592186045417 true] [17592186411970 1068 #edb/ref 17592186411956 13194139534140 17592186045417 true] [17592186411970 1069 "q-130734" 13194139534140 17592186045417 true] [17592186411970 1070 #edb/ref 17592186045485 13194139534140 17592186045417 true] [17592186411970 1071 "Suppose $B$ is a $6\\times 6$ matrix and $det(B)=120.$ The matrix $C$ is obtained from $B$ by applying the elementary row operation ${R}_{3}:=\\frac{1}{8}{R}_{3}.$ What is the value of $det(C)?$" 13194139534140 17592186045417 true] [17592186411970 1072 #uuid "c64b1d7a-babf-5255-875a-51e173624ada" 13194139534140 17592186045417 true] [17592186411970 1074 "The row operation applied to $B$ consists of multiplying a row by the number $\\frac{1}{8}.$\n\nWhen we do this, the determinant is multiplied by the same number. So, we have\n\n$$\n\\begin{aligned}det(C) & =\\frac{1}{8}det(B) \\\\  & =\\frac{1}{8}\\cdot 120 \\\\  & =15.\\end{aligned}\n$$" 13194139534140 17592186045417 true] [17592186411971 1068 #edb/ref 17592186411957 13194139534140 17592186045417 true] [17592186411971 1069 "q-72730" 13194139534140 17592186045417 true] [17592186411971 1070 #edb/ref 17592186045485 13194139534140 17592186045417 true] [17592186411971 1071 "Suppose $C$ is a $9\\times 9$ matrix and $det(C)=-46.$ The matrix $D$ is obtained from $C$ by applying the elementary row operation ${R}_{9}:=-\\frac{2}{23}{R}_{9}.$ What is the value of $det(D)?$" 13194139534140 17592186045417 true] [17592186411971 1072 #uuid "cbb370be-de14-5258-93fd-4e6a870c68bc" 13194139534140 17592186045417 true] [17592186411971 1074 "The row operation applied to $C$ consists of multiplying a row by the number $-\\frac{2}{23}.$\n\nWhen we do this, the determinant is multiplied by the same number. So, we have\n\n$$\n\\begin{aligned}det(D) & =-\\frac{2}{23}det(C) \\\\  & =-\\frac{2}{23}\\cdot (-46) \\\\  & =4.\\end{aligned}\n$$" 13194139534140 17592186045417 true]] :edb/tempids {"answer-01085bc4-2d6b-556c-908d-a086f143e25f" 17592186411909 "answer-116428ff-2d2f-5e28-a226-5dbcdd1ff147" 17592186411910 "answer-132747fd-8145-5600-a67f-e5fedabc2538" 17592186411911 "answer-159fb8ce-d84b-5877-8981-51153df872c1" 17592186411912 "answer-1efd96de-5d59-5c21-b6c4-f57a804edb99" 17592186411913 "answer-2bb7ef99-5504-5559-a251-067d58c0bd0c" 17592186411914 "answer-354ead57-b818-5300-af89-ce4e85f7