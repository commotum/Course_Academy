hoices [{:answer/id #uuid "40ecf49b-f6f6-5aa8-9833-f456756fb345" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186411919} {:answer/id #uuid "737d37ba-0517-586e-990a-6cb29bb74c93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186411927} {:answer/id #uuid "7d6841d3-274b-5077-bf57-e479dc1150ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186411930} {:answer/id #uuid "adbd9b77-9f27-5ccd-b380-119472cf1000" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-21" :db/id #edb/ref 17592186411937} {:answer/id #uuid "f7b945de-5bde-5cc0-b950-21e572dcd5e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186411952}] :answer-field/correct {:answer/id #uuid "7d6841d3-274b-5077-bf57-e479dc1150ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186411930} :answer-field/id #uuid "322d6374-8524-5348-bde2-7964444c576c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411956}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c64b1d7a-babf-5255-875a-51e173624ada" :question/math-academy-id "q-130734" :question/problem "Suppose $B$ is a $6\\times 6$ matrix and $det(B)=120.$ The matrix $C$ is obtained from $B$ by applying the elementary row operation ${R}_{3}:=\\frac{1}{8}{R}_{3}.$ What is the value of $det(C)?$" :question/worked-solution "The row operation applied to $B$ consists of multiplying a row by the number $\\frac{1}{8}.$\n\nWhen we do this, the determinant is multiplied by the same number. So, we have\n\n$$\n\\begin{aligned}det(C) & =\\frac{1}{8}det(B) \\\\  & =\\frac{1}{8}\\cdot 120 \\\\  & =15.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186265965 :knowledge-point/_questions [{:db/id #edb/ref 17592186119851 :knowledge-point/id #uuid "272d9a54-ba97-5175-86df-0a78337da7b9" :knowledge-point/title "Calculating a Determinant After Multiplying a Matrix by a Scalar"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f43edac-7246-5d43-8000-c3bbff4a8176" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "78" :db/id #edb/ref 17592186263825} {:answer/id #uuid "86e0a75e-55d0-5e2a-9a63-a82c9c202c35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-108" :db/id #edb/ref 17592186264165} {:answer/id #uuid "baa05d38-6ecb-5379-9f1f-5e3e7b9ccf4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "84" :db/id #edb/ref 17592186264618} {:answer/id #uuid "d4349a15-8511-5f32-95bd-1870e7829de8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "96" :db/id #edb/ref 17592186264848} {:answer/id #uuid "fe0308d4-84ec-5efb-85f8-99f4481efc31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-90" :db/id #edb/ref 17592186265234}] :answer-field/correct {:answer/id #uuid "d4349a15-8511-5f32-95bd-1870e7829de8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "96" :db/id #edb/ref 17592186264848} :answer-field/id #uuid "c44403e8-a5cd-5235-983a-00f2ee10a5ae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265589}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "06a215a3-28a1-5081-94e6-eb4defb995c9" :question/math-academy-id "q-130738" :question/problem "Suppose $B$ is a $5\\times 5$ matrix and $det(B)=-3.$ What is the value of $det(-2B)?$" :question/worked-solution "Multiplying a $n\\times n$ matrix by a scalar $k$ is equivalent to multiplying each row by $k,$ and this occurs $n$ times. This leads to the result\n\n$$\n\\begin{aligned}det(k\\cdot B)={k}^{n}\\cdot det(B).\\end{aligned}\n$$\n\nIn our case, we have $k=-2$ and $n=5.$ Therefore,\n\n$$\n\\begin{aligned}det(-2B) & =(-2)^{5}\\cdot det(B) \\\\  & =-32\\cdot (-3) \\\\  & =96.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186265966 :knowledge-point/_questions [{:db/id #edb/ref 17592186119851 :knowledge-point/id #uuid "272d9a54-ba97-5175-86df-0a78337da7b9" :knowledge-point/title "Calculating a Determinant After Multiplying a Matrix by a Scalar"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ea955b9-6711-5c65-bda1-3ab48eabd812" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-64" :db/id #edb/ref 17592186263132} {:answer/id #uuid "17da9e59-b9f5-509b-a7fb-62f252a7e9a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "160" :db/id #edb/ref 17592186263226} {:answer/id #uuid "33f0d4df-6db7-5edb-83e5-879e71782b3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-128" :db/id #edb/ref 17592186263453} {:answer/id #uuid "6565e424-45a3-596a-a6bd-d07a0bf5686e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-88" :db/id #edb/ref 17592186263879} {:answer/id #uuid "95a19408-ad9c-5d73-b520-d5ebea3b4631" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "96" :db/id #edb/ref 17592186264282}] :answer-field/correct {:answer/id #uuid "33f0d4df-6db7-5edb-83e5-879e71782b3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-128" :db/id #edb/ref 17592186263453} :answer-field/id #uuid "304a5032-001d-525b-8f6a-528d675f38d4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265330}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6d71a2d5-21fb-5641-ae6e-b88e302c6622" :question/math-academy-id "q-130739" :question/problem "Suppose $Y$ is a $3\\times 3$ matrix and $det(Y)=2.$ What is the value of $det(-4Y)?$" :question/worked-solution "Multiplying a $n\\times n$ matrix by a scalar $k$ is equivalent to multiplying each row by $k,$ and this occurs $n$ times. This leads to the result\n\n$$\n\\begin{aligned}det(k\\cdot Y)={k}^{n}\\cdot det(Y).\\end{aligned}\n$$\n\nIn our case, we have $k=-4$ and $n=3.$ Therefore,\n\n$$\n\\begin{aligned}det(-4Y) & =(-4)^{3}\\cdot det(Y) \\\\  & =-64\\cdot 2 \\\\  & =-128.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186383202 :knowledge-point/_questions [{:db/id #edb/ref 17592186119777 :knowledge-point/id #uuid "24e5e193-5e30-5480-9e5d-b7b8f1d5de87" :knowledge-point/title "Calculating a Determinant After Applying Several Elementary Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d90fab71-15ff-5154-8626-0065130da4bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186383204} {:answer/id #uuid "d60ff1cc-e04c-5e97-b4d5-91717ba060d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186383205} {:answer/id #uuid "7b55776f-fb40-547c-87b6-e49a33a6d01f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-30" :db/id #edb/ref 17592186383206} {:answer/id #uuid "e01c2414-82ca-5b80-9168-7660be02d0f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-23" :db/id #edb/ref 17592186383207} {:answer/id #uuid "b3ca33ad-0034-5250-b44f-d67a667d9573" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-17" :db/id #edb/ref 17592186383208}] :answer-field/correct {:answer/id #uuid "e01c2414-82ca-5b80-9168-7660be02d0f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-23" :db/id #edb/ref 17592186383207} :answer-field/id #uuid "19c40756-1ae1-55ae-86e7-0dc818b95e09" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383203}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3b572280-0021-5039-9903-b8cbf3a6e8d3" :question/math-academy-id "q-130742" :question/problem "Suppose $A$ is a $4\\times 4$ matrix and $det(A)=23.$ The matrix $B$ is obtained from $A$ by applying the elementary row operations ${R}_{1}↔{R}_{3}$ and ${R}_{1}:={R}_{1}+5{R}_{3}.$ What is the value of $det(B)?$" :question/worked-solution "First, let's figure out what each operation does to the determinant.\n\n- The operation ${R}_{1}↔{R}_{3}$ involves swapping two rows, so it changes the sign of the determinant to the opposite one.\n\n- The operation ${R}_{1}:={R}_{1}+5{R}_{3}$ involves adding a multiple of one row to another row,  so it does not change the determinant.\n\nTherefore, we only have to change the sign of the determinant to the opposite one. Consequently, we get\n\n$$\n\\begin{aligned}det(B) & =-det(A) \\\\  & =-(23) \\\\  & =-23.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186265992 :knowledge-point/_questions [{:db/id #edb/ref 17592186119850 :knowledge-point/id #uuid "9a0ab53e-79ff-5520-bb50-069fd381d29d" :knowledge-point/title "Identifying a Row Operation Given the Connection Between Two Determinants"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f938576-14ee-5665-942c-f5bfc3534050" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{3}:={R}_{3}+(-1){R}_{2}" :db/id #edb/ref 17592186263289} {:answer/id #uuid "66e265c6-ed48-5d88-966e-a5dff8678916" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{1}:=-{R}_{1}" :db/id #edb/ref 17592186263892} {:answer/id #uuid "96934c85-fbb8-5687-a238-dbee446961d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{1}↔{R}_{3}" :db/id #edb/ref 17592186264288} {:answer/id #uuid "a3c6c16d-b28c-5665-bfd2-d38f6dbf5091" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+(-1){R}_{3}" :db/id #edb/ref 17592186264392} {:answer/id #uuid "d5476105-e8e0-591e-9f16-19d7dff3433b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+{R}_{3}" :db/id #edb/ref 17592186264857}] :answer-field/correct {:answer/id #uuid "a3c6c16d-b28c-5665-bfd2-d38f6dbf5091" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+(-1){R}_{3}" :db/id #edb/ref 17592186264392} :answer-field/id #uuid "8d92ecd7-28e6-5f20-bfc3-d836c30d39c6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265497}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a88eab2f-0bec-591e-a119-0d1e91654bf5" :question/math-academy-id "q-130854" :question/problem "Given that $det(A)=det(B),$ which of the following elementary row operations transforms matrix $A$ to matrix $B,$ where\n\n$$\nA=[\\begin{aligned}1 & -2 & 3 \\\\ 3 & 5 & -2 \\\\ 2 & -3 & -1\\end{aligned}],\\,B=[\\begin{aligned}1 & -2 & 3 \\\\ 1 & 8 & -1 \\\\ 2 & -3 & -1\\end{aligned}]?\n$$" :question/worked-solution "Since $det(A)=det(B)$, the row operation applied to $A$ must be to add or subtract a multiple of one row to another row. In other words, it is of the form \n\n$$\n{R}_{j}:={R}_{j}+(k){R}_{i},\\,i\\ne j.\n$$\n\nBy considering the given row operations that are of the above form, we notice that\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}1 & -2 & 3 \\\\ 3 & 5 & -2 \\\\ 2 & -3 & -1\\end{aligned}| & {R}_{2} & :={R}_{2}+(-1){R}_{3} \\\\  & =|\\begin{aligned}1 & -2 & 3 \\\\ 1 & 8 & -1 \\\\ 2 & -3 & -1\\end{aligned}| \\\\  & =det(B).\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{2}:={R}_{2}+(-1){R}_{3}.\n$$"}] [{:db/id #edb/ref 17592186265993 :knowledge-point/_questions [{:db/id #edb/ref 17592186119850 :knowledge-point/id #uuid "9a0ab53e-79ff-5520-bb50-069fd381d29d" :knowledge-point/title "Identifying a Row Operation Given the Connection Between Two Determinants"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5631a190-3164-5c81-9c22-e6a70c44c09d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186263742} {:answer/id #uuid "74e1b546-dc5d-5c39-8615-b03158b816ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186264014} {:answer/id #uuid "850ef7c7-1f4b-53c9-b078-25bda4009629" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186264145} {:answer/id #uuid "df7141db-3b66-5a7a-b89e-874dcb0bbee8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186264937} {:answer/id #uuid "e044d557-77d9-53d0-a554-77b04c1a4a41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186264947}] :answer-field/correct {:answer/id #uuid "74e1b546-dc5d-5c39-8615-b03158b816ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186264014} :answer-field/id #uuid "cf6cdcea-ffe0-5e06-a7c5-0284d3815f01" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265614}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2e099506-9b8a-52ad-a7eb-ff6f42b6d002" :question/math-academy-id "q-130855" :question/problem "Consider the matrices given below. Given that $X$ and $Y$ are row equivalent matrices and $det(X)=5$, find $det(Y).$\n\n$$\nX=[\\begin{aligned}2 & -3 & 1 \\\\ 1 & 1 & -2 \\\\ -3 & 2 & 2\\end{aligned}],\\,Y=[\\begin{aligned}2 & -3 & 1 \\\\ -3 & 2 & 2 \\\\ 1 & 1 & -2\\end{aligned}].\n$$" :question/worked-solution "Notice that $Y$ can be obtained from $X$ by swapping the $2$nd and the $3$rd rows. \n\nThis changes the sign of the determinant to the opposite one.\nTherefore, we obtain\n\n$$\n\\begin{aligned}det(Y) & =-det(X) \\\\  & =-(5) \\\\  & =-5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329636 :knowledge-point/_questions [{:db/id #edb/ref 17592186119777 :knowledge-point/id #uuid "24e5e193-5e30-5480-9e5d-b7b8f1d5de87" :knowledge-point/title "Calculating a Determinant After Applying Several Elementary Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ceb8d39-892a-568d-bb1d-1e0de0abcd35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186327183} {:answer/id #uuid "1f2ad961-98aa-51c8-9cf6-358e73cf2d49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186327204} {:answer/id #uuid "6aec1ceb-3826-5f48-a5ff-67e8e8026011" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186327855} {:answer/id #uuid "e1ed0c5c-a2b6-593c-825e-2e9391bcf551" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186328911} {:answer/id #uuid "f6ad7918-1d64-5a4a-9ddf-ab50ee7931ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186329097}] :answer-field/correct {:answer/id #uuid "1f2ad961-98aa-51c8-9cf6-358e73cf2d49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186327204} :answer-field/id #uuid "c1229dc0-d6f0-51b6-b46e-d6021bec8ef2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329522}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cd8840c4-6eae-5436-8938-81828d23c8b5" :question/math-academy-id "q-42204" :question/problem "Suppose $A$ is a $5\\times 5$ matrix and $det(A)=4.$ The matrix $B$ is obtained from $A$ by applying the elementary row operation ${R}_{1}:={R}_{1}+3{R}_{2}$ and ${R}_{2}↔{R}_{3}.$ What is the value of $det(B)?$" :question/worked-solution "First, let's figure out what each operation does to the determinant.\n\n- The operation ${R}_{2}↔{R}_{3}$ involves swapping two rows, so it changes the sign of the determinant to the opposite one.\n\n- The operation ${R}_{1}:={R}_{1}+3{R}_{2}$ involves adding a multiple of one row to another row,  so it does not change the determinant.\n\nTherefore, we only have to change the sign of the determinant to the opposite one. Consequently, we get\n\n$$\n\\begin{aligned}det(B) & =-det(A) \\\\  & =-(4) \\\\  & =-4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186385422 :knowledge-point/_questions [{:db/id #edb/ref 17592186119775 :knowledge-point/id #uuid "74764043-e1e7-56d6-8f53-9d287a30e538" :knowledge-point/title "Calculating a Determinant After Switching Two Rows"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c31511e8-82ea-5af0-a213-66dd9b336d00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186385424} {:answer/id #uuid "3d205cfc-0512-50c3-a95b-46b05574fdab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186385425} {:answer/id #uuid "2acaf9d0-8561-5813-ab9c-315f11aafdb3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186385426} {:answer/id #uuid "ca054d25-5ca7-5fd3-ab29-cd1889fb23fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186385427} {:answer/id #uuid "8e8105f7-39f7-543e-a898-f8df4d976675" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186385428}] :answer-field/correct {:answer/id #uuid "8e8105f7-39f7-543e-a898-f8df4d976675" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186385428} :answer-field/id #uuid "0f94982c-4ec7-5423-86de-a88f18f95a14" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186385423}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4d2eb3a4-1529-5361-9598-a0c5afbbd3cf" :question/math-academy-id "q-42491" :question/problem "Suppose $A$ is a $5\\times 5$ matrix and $det(A)=6.$ The matrix $B$ is obtained from $A$ by applying the elementary row operation ${R}_{1}↔{R}_{2}$ (switching the first and the second rows). What is the value of $det(B)?$" :question/worked-solution "Since swapping any two rows changes the sign of the determinant to the opposite sign, we have\n\n$$\n\\begin{aligned}det(B) & =-det(A) \\\\  & =-(6) \\\\  & =-6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186120431 :knowledge-point/_questions [{:db/id #edb/ref 17592186119777 :knowledge-point/id #uuid "24e5e193-5e30-5480-9e5d-b7b8f1d5de87" :knowledge-point/title "Calculating a Determinant After Applying Several Elementary Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e01723b-cc89-5e3f-b933-6517b2094770" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186409662} {:answer/id #uuid "91ff05b8-c923-5cbc-9974-2858e86d4877" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186409672} {:answer/id #uuid "b7b3cea5-79ed-5121-8909-27b79eb945a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186409674} {:answer/id #uuid "b8a98397-80e5-5a87-b4ed-d166d96908c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-36" :db/id #edb/ref 17592186409675} {:answer/id #uuid "eb7338ba-732f-5bfb-aded-530b4a5f8d7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186409677}] :answer-field/correct {:answer/id #uuid "eb7338ba-732f-5bfb-aded-530b4a5f8d7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186409677} :answer-field/id #uuid "dc16361c-3306-5054-a003-e31388cab6e6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186409687}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0a9d752b-69e4-5f21-888f-3429a8443f7b" :question/math-academy-id "q-42503" :question/problem "Suppose $A$ is a $4\\times 4$ matrix and $det(A)=12.$ The matrix $B$ is obtained from $A$ by applying the elementary row operations ${R}_{2}↔{R}_{3}$ and ${R}_{1}:={R}_{1}+2{R}_{3}.$ What is the value of $det(B)?$" :question/worked-solution "First, let's figure out what each operation does to the determinant.\n\n- The operation ${R}_{2}↔{R}_{3}$ involves swapping two rows, so it changes the sign of the determinant to the opposite one.\n\n- The operation ${R}_{1}:={R}_{1}+2{R}_{3}$ involves adding a multiple of one row to another row,  so it does not change the determinant.\n\nTherefore, we only have to change the sign of the determinant to the opposite one. Consequently, we get\n\n$$\n\\begin{aligned}det(B) & =-det(A) \\\\  & =-(12) \\\\  & =-12.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186385442 :knowledge-point/_questions [{:db/id #edb/ref 17592186119850 :knowledge-point/id #uuid "9a0ab53e-79ff-5520-bb50-069fd381d29d" :knowledge-point/title "Identifying a Row Operation Given the Connection Between Two Determinants"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eef6e93d-f65c-5ac8-a313-118c028fcea5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{1}:={R}_{1}+(-2){R}_{3}" :db/id #edb/ref 17592186385444} {:answer/id #uuid "4f761496-d7dc-5eaf-8c5f-a2ed07387580" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{3}:=\\frac{1}{2}{R}_{3}" :db/id #edb/ref 17592186385445} {:answer/id #uuid "f1f9e742-6ad1-5201-ab5d-6de6ae61dad2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{1}:={R}_{1}+2{R}_{2}" :db/id #edb/ref 17592186385446} {:answer/id #uuid "c17d0592-c56f-54f6-b24a-c443443b36de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{1}:={R}_{1}+(-1){R}_{3}" :db/id #edb/ref 17592186385447} {:answer/id #uuid "c02317d2-d147-540e-940b-ea20052b0ef4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{1}↔{R}_{2}" :db/id #edb/ref 17592186385448}] :answer-field/correct {:answer/id #uuid "c17d0592-c56f-54f6-b24a-c443443b36de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{1}:={R}_{1}+(-1){R}_{3}" :db/id #edb/ref 17592186385447} :answer-field/id #uuid "36b4251d-aea0-541f-9df1-43c7caac3dd1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186385443}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6f2538da-8d51-59ef-9c88-dd06d7af1438" :question/math-academy-id "q-43047" :question/problem "Given that $det(A)=det(B),$ which of the following elementary row operations transforms matrix $A$ to matrix $B,$ where\n\n$$\nA=[\\begin{aligned}2 & 4 & -2 \\\\ 1 & -1 & 0 \\\\ -2 & 2 & 1\\end{aligned}],\\,B=[\\begin{aligned}4 & 2 & -3 \\\\ 1 & -1 & 0 \\\\ -2 & 2 & 1\\end{aligned}]?\n$$" :question/worked-solution "Since $det(A)=det(B)$, the row operation applied to $A$ must be to add or subtract a multiple of one row to another row. In other words, it is of the form \n\n$$\n{R}_{j}:={R}_{j}+(k){R}_{i},\\,i\\ne j.\n$$\n\nBy considering the given row operations that are of the above form, we notice that\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}2 & 4 & -2 \\\\ 1 & -1 & 0 \\\\ -2 & 2 & 1\\end{aligned}| & {R}_{1} & :={R}_{1}+(-1){R}_{3} \\\\  & =|\\begin{aligned}4 & 2 & -3 \\\\ 1 & -1 & 0 \\\\ -2 & 2 & 1\\end{aligned}| \\\\  & =det(B).\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{1}:={R}_{1}+(-1){R}_{3}.\n$$"}] [{:db/id #edb/ref 17592186120454 :knowledge-point/_questions [{:db/id #edb/ref 17592186119775 :knowledge-point/id #uuid "74764043-e1e7-56d6-8f53-9d287a30e538" :knowledge-point/title "Calculating a Determinant After Switching Two Rows"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31d65bd9-9697-55d7-81da-edd05a273db7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186327374} {:answer/id #uuid "a9819235-6a71-54a1-bc72-06895dbab668" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "105" :db/id #edb/ref 17592186328402} {:answer/id #uuid "bc75b843-6b44-5d5c-a07e-1868901cb4f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-105" :db/id #edb/ref 17592186328573} 