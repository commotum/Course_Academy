" :knowledge-point/title "Calculating a Determinant After Multiplying a Matrix by a Scalar"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "512abaff-433d-5e4a-864f-f1df10d56d6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186409663} {:answer/id #uuid "7a56edfe-4461-57d1-8804-22f3e005401a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186409670} {:answer/id #uuid "f689939f-47fe-5c00-a125-9fe1fc1187ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "180" :db/id #edb/ref 17592186409679} {:answer/id #uuid "face2d4d-2a2b-5eb7-8047-8fb6dbd54d8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "160" :db/id #edb/ref 17592186409680} {:answer/id #uuid "fcf8031f-e31a-5703-96b3-5a28bec971aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "320" :db/id #edb/ref 17592186409682}] :answer-field/correct {:answer/id #uuid "fcf8031f-e31a-5703-96b3-5a28bec971aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "320" :db/id #edb/ref 17592186409682} :answer-field/id #uuid "98c176ba-da66-551c-9c0c-0c257e4d9459" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186409686}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "81c5993c-3d71-5869-bbf5-3e36b2df3a7f" :question/math-academy-id "q-72741" :question/problem "Suppose $Y$ is a $6\\times 6$ matrix and $det(Y)=5.$ What is the value of $det(2Y)?$" :question/worked-solution "Multiplying a $n\\times n$ matrix by a scalar $k$ is equivalent to multiplying each row by $k,$ and this occurs $n$ times. This leads to the result\n\n$$\n\\begin{aligned}det(k\\cdot Y)={k}^{n}\\cdot det(Y).\\end{aligned}\n$$\n\nIn our case, we have $k=2$ and $n=6.$ Therefore,\n\n$$\n\\begin{aligned}det(2Y) & ={2}^{6}\\cdot det(Y) \\\\  & =64\\cdot 5 \\\\  & =320.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186379980 :knowledge-point/_questions [{:db/id #edb/ref 17592186119851 :knowledge-point/id #uuid "272d9a54-ba97-5175-86df-0a78337da7b9" :knowledge-point/title "Calculating a Determinant After Multiplying a Matrix by a Scalar"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7e82175b-bea8-5a74-b02e-c936593b97ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "180" :db/id #edb/ref 17592186379982} {:answer/id #uuid "74d9c464-c1d9-5c1c-9898-e524d4a223c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186379983} {:answer/id #uuid "cfcadc6e-ae48-50b5-a73e-be1bd42f023b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\,290" :db/id #edb/ref 17592186379984} {:answer/id #uuid "1686ccc1-a296-5e34-a4b0-5717f1e9a359" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,160" :db/id #edb/ref 17592186379985} {:answer/id #uuid "6466ade6-6672-5f9b-a85e-d500d5002105" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "360" :db/id #edb/ref 17592186379986}] :answer-field/correct {:answer/id #uuid "1686ccc1-a296-5e34-a4b0-5717f1e9a359" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,160" :db/id #edb/ref 17592186379985} :answer-field/id #uuid "37d4f007-41c0-5c4c-afc3-772d63dabd28" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186379981}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "409f716a-c0ac-55a0-a174-94c6fcabcec4" :question/math-academy-id "q-72742" :question/problem "Suppose $X$ is a $3\\times 3$ matrix and $det(X)=10.$ What is the value of $det(6X)?$" :question/worked-solution "Multiplying a $n\\times n$ matrix by a scalar $k$ is equivalent to multiplying each row by $k,$ and this occurs $n$ times. This leads to the result\n\n$$\n\\begin{aligned}det(k\\cdot X)={k}^{n}\\cdot det(X).\\end{aligned}\n$$\n\nIn our case, we have $k=6$ and $n=3.$ Therefore,\n\n$$\n\\begin{aligned}det(6X) & ={6}^{3}\\cdot det(X) \\\\  & =216\\cdot 10 \\\\  & =2160.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186411966 :knowledge-point/_questions [{:db/id #edb/ref 17592186119777 :knowledge-point/id #uuid "24e5e193-5e30-5480-9e5d-b7b8f1d5de87" :knowledge-point/title "Calculating a Determinant After Applying Several Elementary Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40238690-4089-5383-b0be-144e4a66318a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186411917} {:answer/id #uuid "40a285bb-2c28-5dc2-bb55-500bf985bb7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186411918} {:answer/id #uuid "43e91860-50ac-5b66-b967-946f1e1fc8f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186411921} {:answer/id #uuid "6a51c6b8-2c73-55e3-a6ed-302213e3f577" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186411925} {:answer/id #uuid "bae51b38-f76c-5484-acc5-93c339e8b199" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186411940}] :answer-field/correct {:answer/id #uuid "40a285bb-2c28-5dc2-bb55-500bf985bb7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186411918} :answer-field/id #uuid "31de2b36-2a3a-5de3-9428-2467d57745e7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411955}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8e473584-e9d3-56ba-b273-e8476acf9443" :question/math-academy-id "q-72750" :question/problem "Suppose $C$ is a $5\\times 5$ matrix and $det(C)=-24.$ The matrix $D$ is obtained from $C$ by applying the elementary row operations ${R}_{1}↔{R}_{5}$ and ${R}_{3}:=-\\frac{1}{6}{R}_{3}.$ What is the value of $det(D)?$" :question/worked-solution "First, let's figure out what each operation does to the determinant.\n\n- The operation ${R}_{1}↔{R}_{5}$ involves swapping two rows, so it changes the sign of the determinant to the opposite one.\n\n- The operation ${R}_{3}:=-\\frac{1}{6}{R}_{3}$ involves multiplying a row by $-\\frac{1}{6},$ so the determinant is multiplied by $-\\frac{1}{6}$ as well.\n\nTherefore, we have to change the sign of the determinant to the opposite one and multiply by $-\\frac{1}{6}$ as well. Consequently, we get\n\n$$\n\\begin{aligned}det(D) & =-\\frac{1}{6}\\cdot (-det(C)) \\\\  & =\\frac{1}{6}det(C) \\\\  & =\\frac{1}{6}\\cdot (-24) \\\\  & =-4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186385571 :knowledge-point/_questions [{:db/id #edb/ref 17592186119777 :knowledge-point/id #uuid "24e5e193-5e30-5480-9e5d-b7b8f1d5de87" :knowledge-point/title "Calculating a Determinant After Applying Several Elementary Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4dba8559-0132-5214-a523-39faf0ee84e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-42" :db/id #edb/ref 17592186385573} {:answer/id #uuid "5c3492ed-9532-5e7f-9660-d7372420dadf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186385574} {:answer/id #uuid "61e4d41c-e3fc-5164-bd61-99321ffd812a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "84" :db/id #edb/ref 17592186385575} {:answer/id #uuid "7c95e153-52fb-5e32-82f7-a535998522aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-84" :db/id #edb/ref 17592186385576} {:answer/id #uuid "bcf59fb7-294d-5123-8822-654918f7dc75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-21" :db/id #edb/ref 17592186385577}] :answer-field/correct {:answer/id #uuid "7c95e153-52fb-5e32-82f7-a535998522aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-84" :db/id #edb/ref 17592186385576} :answer-field/id #uuid "ee630750-cac3-50bd-8769-0e87a844e96e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186385572}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7dd7b936-dcd4-5588-8ef8-d567f8396fba" :question/math-academy-id "q-72751" :question/problem "Suppose $Y$ is a $9\\times 9$ matrix and $det(Y)=84.$ The matrix $Z$ is obtained from $Y$ by applying the elementary row operations ${R}_{3}↔{R}_{7}$ and ${R}_{6}:={R}_{6}+\\frac{1}{4}{R}_{1}.$ What is the value of $det(Z)?$" :question/worked-solution "First, let's figure out what each operation does to the determinant.\n\n- The operation ${R}_{3}↔{R}_{7}$ involves swapping two rows, so it changes the sign of the determinant to the opposite one.\n\n- The operation ${R}_{6}:={R}_{6}+\\frac{1}{4}{R}_{1}$ involves adding a multiple of one row to another row,  so it does not change the determinant.\n\nTherefore, we only have to change the sign of the determinant to the opposite one. Consequently, we get\n\n$$\n\\begin{aligned}det(Z) & =-det(Y) \\\\  & =-(84) \\\\  & =-84.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186411963 :knowledge-point/_questions [{:db/id #edb/ref 17592186119850 :knowledge-point/id #uuid "9a0ab53e-79ff-5520-bb50-069fd381d29d" :knowledge-point/title "Identifying a Row Operation Given the Connection Between Two Determinants"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1efd96de-5d59-5c21-b6c4-f57a804edb99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186411913} {:answer/id #uuid "2bb7ef99-5504-5559-a251-067d58c0bd0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186411914} {:answer/id #uuid "5f7847c9-3225-566d-a4bb-dbc66736309d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186411923} {:answer/id #uuid "ca4dd63f-7252-5bf2-9499-144f36222c27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186411945} {:answer/id #uuid "e1001e71-dfc2-59ca-a3c7-8d9e00835d22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186411947}] :answer-field/correct {:answer/id #uuid "ca4dd63f-7252-5bf2-9499-144f36222c27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186411945} :answer-field/id #uuid "93fee275-10ef-55f5-b6b3-8793339d38c8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411961}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "441df1fa-6b02-5f85-abd1-1592ef6dada4" :question/math-academy-id "q-72770" :question/problem "Consider the matrices given below. Given that $A$ and $B$ are row equivalent matrices and $det(A)=1$, find $det(B).$\n\n$$\nA=[\\begin{aligned}0 & 1 & -1 \\\\ 1 & -2 & 3 \\\\ 4 & 2 & 1\\end{aligned}],\\,B=[\\begin{aligned}0 & 1 & -1 \\\\ 4 & -8 & 12 \\\\ 4 & 2 & 1\\end{aligned}].\n$$" :question/worked-solution "Notice that $B$ can be obtained from $A$ by multiplying the $2$nd row by $4.$ \n\nSo, the determinant is multiplied by $4$ as well.\nTherefore, we obtain\n\n$$\n\\begin{aligned}det(B) & =4\\cdot det(A) \\\\  & =4\\cdot 1 \\\\  & =4.\\end{aligned}\n$$"}]}
