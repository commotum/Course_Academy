 Connection Between Two Determinants"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32f10a65-b2dd-5264-be04-cd77ee8486f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186385462} {:answer/id #uuid "a32db1a3-8910-58f3-addd-697a1c8eac50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186385463} {:answer/id #uuid "ca1e7385-be8c-569c-a83a-fd9c19722762" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186385464} {:answer/id #uuid "d3ea8a4a-610c-59b9-b2ef-b66f8acee455" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186385465} {:answer/id #uuid "43d84a56-269f-58a8-93a2-b0ccafcfa0f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186385466}] :answer-field/correct {:answer/id #uuid "a32db1a3-8910-58f3-addd-697a1c8eac50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186385463} :answer-field/id #uuid "7ccd8d0e-7322-5ccb-9755-abded82540db" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186385461}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fd213cdd-f67a-5a57-9e3f-84846a552cf7" :question/math-academy-id "q-43080" :question/problem "Consider the matrices given below. Given that $X$ and $Y$ are row equivalent matrices and $det(X)=-8$, find $det(Y).$\n\n$$\nX=[\\begin{aligned}1 & -1 & 0 \\\\ 0 & 1 & 0 \\\\ -6 & 3 & 5\\end{aligned}],\\,Y=[\\begin{aligned}1 & -1 & 0 \\\\ -6 & 3 & 5 \\\\ 0 & 1 & 0\\end{aligned}].\n$$" :question/worked-solution "Notice that $Y$ can be obtained from $X$ by swapping the $2$nd and the $3$rd rows. \n\nThis changes the sign of the determinant to the opposite one.\nTherefore, we obtain\n\n$$\n\\begin{aligned}det(Y) & =-det(X) \\\\  & =-(-8) \\\\  & =8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186411965 :knowledge-point/_questions [{:db/id #edb/ref 17592186119775 :knowledge-point/id #uuid "74764043-e1e7-56d6-8f53-9d287a30e538" :knowledge-point/title "Calculating a Determinant After Switching Two Rows"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "740b596e-c7c5-57a3-a78d-d745db32ed37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186411928} {:answer/id #uuid "8755e30a-6c2d-5890-9aa2-1fdaed9292a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186411933} {:answer/id #uuid "99b8b3ea-b5f8-5b88-96aa-d7030872b48b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186411935} {:answer/id #uuid "b4dd7187-5fd9-570d-8677-1d756d7b4a36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-36" :db/id #edb/ref 17592186411939} {:answer/id #uuid "e90be040-dedb-5683-88a4-177738d9f5f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186411949}] :answer-field/correct {:answer/id #uuid "99b8b3ea-b5f8-5b88-96aa-d7030872b48b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186411935} :answer-field/id #uuid "92d67137-c9e6-5c58-bf53-0d6623567fde" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411960}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8d84b0ed-254e-5487-a529-04888ae00fda" :question/math-academy-id "q-72722" :question/problem "Suppose $B$ is a $3\\times 3$ matrix and $det(B)=12.$ The matrix $C$ is obtained from $B$ by applying the elementary row operation ${R}_{3}↔{R}_{2}$ (switching the second and the third rows). What is the value of $det(C)?$" :question/worked-solution "Since swapping any two rows changes the sign of the determinant to the opposite sign, we have\n\n$$\n\\begin{aligned}det(C) & =-det(B) \\\\  & =-(12) \\\\  & =-12.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186411969 :knowledge-point/_questions [{:db/id #edb/ref 17592186119776 :knowledge-point/id #uuid "2f11b223-edd2-59b8-b761-164d56e29746" :knowledge-point/title "Calculating a Determinant After Multiplying a Row by a Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "132747fd-8145-5600-a67f-e5fedabc2538" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186411911} {:answer/id #uuid "78ccb4fd-9ad3-5659-84e0-a011530ee6d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-60" :db/id #edb/ref 17592186411929} {:answer/id #uuid "8b0ff215-a15d-58fa-8a84-6b3c46517368" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186411934} {:answer/id #uuid "e6ee5a00-c62f-5993-8707-cb7aba8270c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186411948} {:answer/id #uuid "f664b945-3527-5f51-abfc-ae17525d67b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-240" :db/id #edb/ref 17592186411951}] :answer-field/correct {:answer/id #uuid "8b0ff215-a15d-58fa-8a84-6b3c46517368" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186411934} :answer-field/id #uuid "2d954636-15b5-5fe0-b45f-ce012015c3e0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411954}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "befe5af1-f89b-5614-a978-2722ee7dbb46" :question/math-academy-id "q-72728" :question/problem "Suppose $X$ is a $3\\times 3$ matrix and $det(X)=-60.$ The matrix $Y$ is obtained from $X$ by applying the elementary row operation ${R}_{3}:=\\frac{1}{4}{R}_{3}.$ What is the value of $det(Y)?$" :question/worked-solution "The row operation applied to $X$ consists of multiplying a row by the number $\\frac{1}{4}.$\n\nWhen we do this, the determinant is multiplied by the same number. So, we have\n\n$$\n\\begin{aligned}det(Y) & =\\frac{1}{4}det(X) \\\\  & =\\frac{1}{4}\\cdot (-60) \\\\  & =-15.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186411971 :knowledge-point/_questions [{:db/id #edb/ref 17592186119776 :knowledge-point/id #uuid "2f11b223-edd2-59b8-b761-164d56e29746" :knowledge-point/title "Calculating a Determinant After Multiplying a Row by a Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01085bc4-2d6b-556c-908d-a086f143e25f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186411909} {:answer/id #uuid "354ead57-b818-5300-af89-ce4e85f781ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186411915} {:answer/id #uuid "54a05767-12a7-5d4d-811a-9a9690b4fe5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186411922} {:answer/id #uuid "bbb4c07b-c598-5d80-b49b-bf9f83404327" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186411941} {:answer/id #uuid "f544947c-0c5e-5671-b370-2a270f2e40fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 1759218641