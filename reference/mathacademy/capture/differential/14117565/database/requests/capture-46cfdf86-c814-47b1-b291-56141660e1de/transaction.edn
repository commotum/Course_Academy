[[:db/retract 17592186198842 :question/answer-fields 17592186196076] [:db/retract 17592186198844 :question/answer-fields 17592186196105] {:db/id 17592186198465 :knowledge-point/questions ["question-1e8c26e7-e9d8-563e-b578-6100bf923d6c"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186198842 :question/problem "Describe the set $S={5,6,7,...,50}$ using a conditional definition." :db/ensure [:question/validate]} {:db/id 17592186198844 :question/problem "Describe the set $S={…,3,6,12,24,48,...}$ using a constructive definition.\n\n*Hint: Take ${a}_{1}=6$ in the sequence that generates the elements of $S.$*" :db/ensure [:question/validate]} {:db/id 17592186396254 :question/problem "Describe the set $S={-6,-5,-4,...,12}$ using a conditional definition." :db/ensure [:question/validate]} {:db/id "question-1e8c26e7-e9d8-563e-b578-6100bf923d6c" :question/id #uuid "1e8c26e7-e9d8-563e-b578-6100bf923d6c" :question/math-academy-id "q-183697" :question/problem "Describe the set $S={…,-2,-1,0,1,2,3}$ using a conditional definition." :question/worked-solution "The set $S$ contains all integers less than $3,$ including $3.$\n\nIn other words, $S$ contains all integers less than $4,$  *excluding* $4.$ \n\nTherefore, the set can be written as\n\n$$\nS={x\\in Z\\,:\\,x<4}.\n$$\n\n**Note**: This definition is not unique. For example:\n\n- We can write $x\\le 3.$ This gives\n\n$$\nS={x\\in Z\\,:\\,x\\le 3}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ddcd27c7-8319-5553-8fa5-9d996008549a" "answer-field-8b480447-2056-5cc5-bd5d-e625edb62fa3"] :db/ensure [:question/validate]} {:db/id "answer-field-ddcd27c7-8319-5553-8fa5-9d996008549a" :answer-field/id #uuid "ddcd27c7-8319-5553-8fa5-9d996008549a" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-2ff79e69-0b12-56e7-9984-59ab4023180c" :answer-field/choices ["answer-0c80075a-23bd-565b-b792-75b9483248b2" "answer-1fec48bf-7341-5e00-bf54-1