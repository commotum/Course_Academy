#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186418462} :activity/id #uuid "b1628e49-8c52-59b4-abeb-efcedb34a064" :activity/scope {:db/id #edb/ref 17592186049076 :topic/id #uuid "d8ad0390-dfee-58d8-ac50-00cbfdc660af" :topic/math-academy-id 4393} :activity/steps [{:db/id #edb/ref 17592186418461 :step/content {:db/id #edb/ref 17592186198844 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6756d5e9-8c2b-5648-9cef-d57cf02e8e50" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}\\cdot {2}^{n}" :db/id #edb/ref 17592186396245} {:answer/id #uuid "de50addf-3149-5f58-b066-97f2f40179d2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\cdot {2}^{n}" :db/id #edb/ref 17592186396246} {:answer/id #uuid "cf715dcc-e03e-5ea8-aeed-f7ac4fdc33cc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}\\cdot {3}^{n}" :db/id #edb/ref 17592186396247} {:answer/id #uuid "7855bcc5-306f-5477-83df-730bda1dbba3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}\\cdot {3}^{n}" :db/id #edb/ref 17592186396248} {:answer/id #uuid "9b1a1661-077d-5469-a87e-386432d18ff0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{2}^{n}" :db/id #edb/ref 17592186396249}] :answer-field/correct {:db/id #edb/ref 17592186396246} :answer-field/id #uuid "3da75658-493e-5414-9ef4-07db0edd9ac6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186396244} {:answer-field/choices [{:answer/id #uuid "02e44344-d16a-5d1d-af75-d63577743717" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "N" :db/id #edb/ref 17592186396251} {:answer/id #uuid "717cb1ad-26fb-5d39-b775-f38b2206a689" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "Z" :db/id #edb/ref 17592186396252} {:answer/id #uuid "5a2860f0-b7f1-553d-a57e-50270b5ec131" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "R" :db/id #edb/ref 17592186396253}] :answer-field/correct {:db/id #edb/ref 17592186396252} :answer-field/id #uuid "95707686-21cc-5e61-98a8-5364df18a6b6" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186396250}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4a35af51-a0e2-50d0-bbd3-1c0dc3bc52aa" :question/math-academy-id "q-183328" :question/problem "Describe the set $S={…,3,6,12,24,48,...}$ using a constructive definition.\n\n*Hint: Take ${a}_{1}=6$ in the sequence that generates the elements of $S.$*\n\n$$\nS={{{field-1}}\\,:\\,n\\in {{field-2}}}\n$$" :question/worked-solution "Notice that the elements of our set\n\n$$\n…,\\,3,\\,6,\\,12,\\,24,\\,48,\\,…\n$$\n\nform a two-way infinite geometric sequence with a common ratio $r=2:$\n\n$$\n\\begin{aligned}r & =2 \\\\  & =\\frac{6}{3} \\\\  & =\\frac{12}{6} \\\\  & =\\frac{24}{12} \\\\  & =⋯\\end{aligned}\n$$\n\nTherefore, setting  ${a}_{1}=6,$ the $n$th term ${a}_{n}$ of our sequence for $n\\in Z$ is given by\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}\\cdot {r}^{n-1} \\\\  & =6\\cdot {2}^{n-1} \\\\  & =6\\cdot {2}^{n}\\cdot {2}^{-1} \\\\  & =\\frac{6}{2}\\cdot {2}^{n} \\\\  & =3\\cdot {2}^{n}\\end{aligned}\n$$\n\nTherefore, we can define our set using a constructive definition as follows:\n\n$$\nS={3\\cdot {2}^{n}\\,:\\,n\\in Z}\n$$"} :step/id #uuid "07b065de-bc57-5b1f-9638-2357e81c045e" :step/next {:db/id #edb/ref 17592186418465}} {:db/id #edb/ref 17592186418462 :step/content {:db/id #edb/ref 17592186198842 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58adad53-8ca3-58fb-98eb-57482e4bd46a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "52" :db/id #edb/ref 17592186390161} {:answer/id #uuid "c593d39e-6133-5c10-a20c-02e7b771c723" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "50" :db/id #edb/ref 17592186390162} {:answer/id #uuid "4492d437-9549-5ca9-9bb2-c2bbce7b9eb9" :answer/type {:db/id #edb/ref 17592186045498