      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14121793/observations/step-q124558-0f7d4717bf7a9a1963f6.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14121793/observations/step-q124558-0f7d4717bf7a9a1963f6.png",
