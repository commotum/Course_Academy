          "dom_index": 8,
          "source_url": "https://mathacademy.com/graphics/q-124634-e-1",
          "render_ready": true,
          "path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14121793/assets/92b9079151925202a5346e6b1dd2082b21a4e4102720673773e958c5f3644c4f.png",
          "sha256": "92b9079151925202a5346e6b1dd2082b21a4e4102720673773e958c5f3644c4f",
