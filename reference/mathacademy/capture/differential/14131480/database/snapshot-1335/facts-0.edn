db/ref 17592186045417] [17592186320654 #edb/ref 1075 #edb/ref 17592186319607 #edb/ref 17592186045417] [17592186320654 #edb/ref 1075 #edb/ref 17592186319834 #edb/ref 17592186045417] [17592186320654 #edb/ref 1075 #edb/ref 17592186319873 #edb/ref 17592186045417] [17592186320654 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186320654 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186320654 #edb/ref 1078 #edb/ref 17592186319607 #edb/ref 17592186045417] [17592186320654 #edb/ref 1079 #uuid "eca04464-a958-5b61-98f7-1d33e413d898" #edb/ref 17592186045417] [17592186321061 #edb/ref 1068 #edb/ref 17592186320416 #edb/ref 17592186045417] [17592186321061 #edb/ref 1069 "q-35297" #edb/ref 17592186045417] [17592186321061 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186321061 #edb/ref 1071 "Determine the dimension of\n$\\text{Span}\\{[\\begin{aligned}5 \\\\ 4 \\\\ 3\\end{aligned}],[\\begin{aligned}-10 \\\\ -2 \\\\ -6\\end{aligned}]\\}.$" #edb/ref 17592186045417] [17592186321061 #edb/ref 1072 #uuid "2472ea9f-8e8e-5b80-8c7c-945a5a43c650" #edb/ref 17592186045417] [17592186321061 #edb/ref 1074 "We start by creating a matrix whose columns are made up of our vectors, and then we reduce the matrix to row echelon form:\n\n$$\n\\begin{aligned} & [\\begin{aligned}5 & -10 \\\\ 4 & -2 \\\\ 3 & -6\\end{aligned}] & {R}_{2} & :={R}_{2}+(-\\frac{4}{5}){R}_{1} \\\\  & ∼[\\begin{aligned}5 & -10 \\\\ 0 & 6 \\\\ 3 & -6\\end{aligned}] & {R}_{3} & :={R}_{3}+(-\\frac{3}{5}){R}_{1} \\\\  & ∼[\\begin{aligned}5 & -10 \\\\ 0 & 6 \\\\ 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe pivot columns correspond to basis vectors, while the non-pivot columns correspond to linearly dependent vectors that can be removed. Here, the reduced matrix has $2$ pivot columns (or alternatively, it has exactly $2$ non-zero rows). \n\nTherefore, the dimension of the span is $2.$" #edb/ref 17592186045417] [17592186321062 #edb/ref 1068 #edb/ref 17592186320596 #edb/ref 17592186045417] [17592186321062 #edb/ref 1069 "q-35298" #edb/ref 17592186045417] [17592186321062 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186321062 #edb/ref 1071 "$\\text{dim}(\\text{Span}\\{[\\begin{aligned}2 \\\\ -4\\end{aligned}],[\\begin{aligned}-3 \\\\ 6\\end{aligned}],[\\begin{aligned}5 \\\\ -10\\end{aligned}]\\})=$" #edb/ref 17592186045417] [17592186321062 #edb/ref 1072 #uuid "2304859f-a364-5093-b7c5-56d02eda6877" #edb/ref 17592186045417] [17592186321062 #edb/ref 1074 "We start by creating a matrix whose columns are made up of our vectors, and then we reduce the matrix to row echelon form:\n\n$$\n\\begin{aligned} & [\\begin{aligned}2 & -3 & 5 \\\\ -4 & 6 & -10\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}2 & -3 & 5 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe pivot columns correspond to basis vectors, while the non-pivot columns correspond to linearly dependent vectors that can be removed. Here, the reduced matrix has $1$ pivot column (or alternatively, it has exactly $1$ non-zero row). \n\nTherefore, \n$\\text{dim}(\\text{Span}\\{[\\begin{aligned}2 \\\\ -4\\end{aligned}],[\\begin{aligned}-3 \\\\ 6\\end{aligned}],[\\begin{aligned}5 \\\\ -10\\end{aligned}]\\})=1.$" #edb/ref 17592186045417] [17592186321065 #edb/ref 1068 #edb/ref 17592186320654 #edb/ref 17592186045417] [17592186321065 #edb/ref 1069 "q-35302" #edb/ref 17592186045417] [17592186321065 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186321065 #edb/ref 1071 "$\\text{dim}(\\text{Span}\\{[\\begin{aligned}-2 \\\\ 0 \\\\ -1 \\\\ 0\\end{aligned}],[\\begin{aligned}5 \\\\ 1 \\\\ 0 \\\\ -2\\end{aligned}],[\\begin{aligned}-6 \\\\ -2 \\\\ 2 \\\\ 4\\end{aligned}],[\\begin{aligned}3 \\\\ 1 \\\\ -1 \\\\ -2\\end{aligned}]\\})=$" #edb/ref 17592186045417] [17592186321065 #edb/ref 1072 #uuid "2a41f8fd-4b7f-554c-b544-a6304735d193" #edb/ref 17592186045417] [17592186321065 #edb/ref 1074 "We start by creating a matrix whose columns are made up of our vectors, and then we reduce the matrix to row echelon form:\n\n$$\n\\begin{aligned} & [\\begin{aligned}-2 & 5 & -6 & 3 \\\\ 0 & 1 & -2 & 1 \\\\ -1 & 0 & 2 & -1 \\\\ 0 & -2 & 4 & -2\\end{aligned}] & {R}_{3} & :={R}_{3}+(-\\frac{1}{2}){R}_{1} \\\\  & ∼[\\begin{aligned}-2 & 5 & -6 & 3 \\\\ 0 & 1 & -2 & 1 \\\\ 0 & -\\frac{5}{2} & 5 & -\\frac{5}{2} \\\\ 0 & -2 & 4 & -2\\end{aligned}] & {R}_{3} & :={R}_{3}+\\frac{5}{2}{R}_{2} \\\\  & ∼[\\begin{aligned}-2 & 5 & -6 & 3 \\\\ 0 & 1 & -2 & 1 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & -2 & 4 & -2\\end{aligned}] & {R}_{4} & :={R}_{4}+2{R}_{2} \\\\  & ∼[\\begin{aligned}-2 & 5 & -6 & 3 \\\\ 0 & 1 & -2 & 1 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe pivot columns correspond to basis vectors, while the non-pivot columns correspond to linearly dependent vectors that can be removed. Here, the reduced matrix has $2$ pivot columns (or alternatively, it has exactly $2$ non-zero rows). \n\nTherefore, \n$\\text{dim}(\\text{Span}\\{[\\begin{aligned}-2 \\\\ 0 \\\\ -1 \\\\ 0\\end{aligned}],[\\begin{aligned}5 \\\\ 1 \\\\ 0 \\\\ -2\\end{aligned}],[\\begin{aligned}-6 \\\\ -2 \\\\ 2 \\\\ 4\\end{aligned}],[\\begin{aligned}3 \\\\ 1 \\\\ -1 \\\\ -2\\end{aligned}]\\})=2.$" #edb/ref 17592186045417] [17592186345465 #edb/ref 1080 "1" #edb/ref 17592186045417] [17592186345465 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186345465 #edb/ref 1083 #uuid "0e3095f8-ebd6-5417-b5fa-228deb53654e" #edb/ref 17592186045417] [17592186345623 #edb/ref 1080 "I and II only" #edb/ref 17592186045417] [17592186345623 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186345623 #edb/ref 1083 #uuid "1f09dffb-bf3a-5fbb-b995-ad3a893cd8a3" #edb/ref 17592186045417] [17592186345633 #edb/ref 1080 "3" #edb/ref 17592186045417] [17592186345633 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186345633 #edb/ref 1083 #uuid "1ffb8a8a-2e10-5113-8365-30ccd72226d2" #edb/ref 17592186045417] [17592186345688 #ed