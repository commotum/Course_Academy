k\"><mtable displaystyle=\"true\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"0.8em 0.8em 0.3em\"><mtr><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>5</mn><mi>σ</mi></mfrac></mstyle></mtd><mtd><mi></mi><mo>=</mo><mn>1.34</mn></mtd></mtr><mtr><mtd><mi>σ</mi></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>5</mn><mn>1.34</mn></mfrac></mstyle></mtd></mtr><mtr><mtd><mi>σ</mi></mtd><mtd><mi></mi><mo>≈</mo><mn>3.73</mn><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
