/mjx-mtable></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mtable displaystyle=\"true\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"0.8em 0.8em 0.3em\"><mtr><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>3.2</mn><mo>−</mo><mi>μ</mi></mrow><mn>3</mn></mfrac></mstyle></mtd><mtd><mi></mi><mo>=</mo><mn>0.65</mn></mtd></mtr><mtr><mtd><mn>3.2</mn><mo>−</mo><mi>μ</mi></mtd><mtd><mi></mi><mo>=</mo><mn>1.95</mn></mtd></mtr><mtr><mtd><mi>μ</mi></mtd><mtd><mi></mi><mo>=</mo><mn>1.25</mn><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
