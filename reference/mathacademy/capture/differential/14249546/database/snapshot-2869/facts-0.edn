86045417] [17592186265373 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186265373 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186265373 #edb/ref 1078 #edb/ref 17592186264578 #edb/ref 17592186045417] [17592186265373 #edb/ref 1079 #uuid "446ceb46-6d4a-51ab-82b3-1f055fd41555" #edb/ref 17592186045417] [17592186266111 #edb/ref 1068 #edb/ref 17592186265286 #edb/ref 17592186045417] [17592186266111 #edb/ref 1069 "q-131715" #edb/ref 17592186045417] [17592186266111 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186266111 #edb/ref 1071 "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-{x}_{2}+2{x}_{3} &=2 \\\\ {x}_{1}-3{x}_{3} &=1.\\end{aligned}\\right.\n$$\n\n \nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." #edb/ref 17592186045443] [17592186266111 #edb/ref 1072 #uuid "9e0a0a65-dec2-598f-90c5-c70695152a49" #edb/ref 17592186045417] [17592186266111 #edb/ref 1074 "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & -1 & 2 & 2 \\\\ 1 & 0 & -3 & 1\\end{bmatrix}.\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -1 & 2 & 2 \\\\ 1 & 0 & -3 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}-{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -1 & 2 & 2 \\\\ 0 & 1 & -5 & -1\\end{bmatrix} & {R}_{1} & :={R}_{1}+{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & -3 & 1 \\\\ 0 & 1 & -5 & -1\\end{bmatrix}\\end{aligned}\n$$\n\n \n\nThe corresponding system is now  \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-3{x}_{3} &=1 \\\\ {x}_{2}-5{x}_{3} &=-1.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are ${x}_{1}$ and ${x}_{2},$ and we have one free variable, ${x}_{3}.$ That means we need to find ${x}_{1}$ and ${x}_{2}$ in terms of ${x}_{3}.$ \n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}{x}_{1} &=3{x}_{3}+1 \\\\ {x}_{2} &=5{x}_{3}-1 \\\\ {x}_{3} &={x}_{3},\\end{aligned}\\right.\n$$\n\nwhere ${x}_{3}$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}=\\begin{bmatrix}3{x}_{3}+1 \\\\ 5{x}_{3}-1 \\\\ {x}_{3}\\end{bmatrix},\\,{x}_{3}\\in (-\\infty ,\\infty ).\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186266112 #edb/ref 1068 #edb/ref 17592186265356 #edb/ref 17592186045417] [17592186266112 #edb/ref 1069 "q-131717" #edb/ref 17592186045417] [17592186266112 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186266112 #edb/ref 1071 "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+3{x}_{2}+{x}_{3} &=-1 \\\\ -2{x}_{1}-5{x}_{2} &=3.\\end{aligned}\\right.\n$$\n\n \nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." #edb/ref 17592186045443] [17592186266112 #edb/ref 1072 #uuid "175b6895-5ce4-52f4-b20c-0c4033601e3d" #edb/ref 17592186045417] [17592186266112 #edb/ref 1074 "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & 3 & 1 & -1 \\\\ -2 & -5 & 0 & 3\\end{bmatrix}.\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 3 & 1 & -1 \\\\ -2 & -5 & 0 & 3\\end{bmatrix} & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 3 & 1 & -1 \\\\ 0 & 1 & 2 & 1\\end{bmatrix} & {R}_{1} & :={R}_{1}-3{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & -5 & -4 \\\\ 0 & 1 & 2 & 1\\end{bmatrix}\\end{aligned}\n$$\n\n \n\nThe corresponding system is now  \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-5{x}_{3} &=-4 \\\\ {x}_{2}+2{x}_{3} &=1.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are ${x}_{1}$ and ${x}_{2},$ and we have one free variable, ${x}_{3}.$ That means we need to find ${x}_{1}$ and ${x}_{2}$ in terms of ${x}_{3}.$ \n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}{x}_{1} &=5{x}_{3}-4 \\\\ {x}_{2} &=1-2{x}_{3} \\\\ {x}_{3} &={x}_{3},\\end{aligned}\\right.\n$$\n\nwhere ${x}_{3}$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}=\\begin{bmatrix}5{x}_{3}-4 \\\\ 1-2{x}_{3} \\\\ {x}_{3}\\end{bmatrix},\\,{x}_{3}\\in (-\\infty ,\\infty ).\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186266113 #edb/ref 1068 #edb/ref 17592186438968 #edb/ref 17592186045436] [17592186266113 #edb/ref 1068 #edb/ref 17592186438969 #edb/ref 17592186045436] [17592186266113 #edb/ref 1068 #edb/ref 17592186438970 #edb/ref 17592186045436] [17592186266113 #edb/ref 1069 "q-131719" #edb/ref 17592186045417] [17592186266113 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186266113 #edb/ref 1071 "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}x+4y &=-1 \\\\ 2x+8y &=-2 \\\\ -3x-12y &=3\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is inconsistent\n\n- **II.** The system is consistent dependent\n\n- **III.** The system has a unique solution" #edb/ref 17592186045443] [17592186266113 #edb/ref 1072 #uuid "e7e2bc11-b1bf-5938-9267-7923a80ec463" #edb/ref 17592186045417] [17592186266113 #edb/ref 1074 "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & 4 & -1 \\\\ 2 & 8 & -2 \\\\ -3 & -12 & 3\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 4 & -1 \\\\ 2 & 8 & -2 \\\\ -3 & -12 & 3\\end{bmatrix} & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 4 & -1 \\\\ 0 & 0 & 0 \\\\ -3 & -12 & 3\\end{bmatrix} & {R}_{3} & :={R}_{3}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 4 & -1 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x,$ and we have one free variable, $y.$ That means we can find $x$ in terms of $y.$ \n\nTherefore, since there are infinitely many solutions, we conclude that the system is *consistent dependent*. \n\nAs a result, only statement II is true." #edb/ref 17592186045443] [17592186266119 #edb/ref 1068 #edb/ref 17592186265373 #edb/ref 17592186045417] [17592186266119 #edb/ref 1069 "q-131729" #edb/ref 17592186045417] [17592186266119 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186266119 #edb/ref 1071 "Determine the value of $k$ for which the following system of linear equations is consistent dependent:\n\n$$\n\\left\\{\\begin{aligned}-2x+7y &=6 \\\\ x+ky &=-3\\end{aligned}\\right.\n$$" #edb/ref 17592186045443] [17592186266119 #edb/ref 1072 #uuid "49ba50cf-14b7-5be4-8660-2e096dc4c172" #edb/ref 17592186045417] [17592186266119 #edb/ref 1074 "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}-2 & 7 & 6 \\\\ 1 & k & -3\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}-2 & 7 & 6 \\\\ 1 & k & -3\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & k & -3 \\\\ -2 & 7 & 6\\end{bmatrix} & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & k & -3 \\\\ 0 & 2k+7 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}x+ky &=-3 \\\\ (2k+7)y &=0.\\end{aligned}\\right.\n$$\n\nThe system is consistent dependent if it has infinitely many solutions. For the system to have infinitely many solutions, it must have at least one free variable.\n\nIf $k=-\\frac{7}{2},$ then the second equation is $0=0,$ which is true for any value of $y$, and we can remove this equation from the system. As a result, the system will contain only one equation, $x+ky=-3.$ \n\nThen, the basic variable will be $x,$ and we will have a free variable $y.$ That means the system will have infinitely many solutions.\n\nTherefore, our system is consistent dependent when $k=-\\frac{7}{2}.$" #edb/ref 17592186045443] [17592186300213 #edb/ref 1080 "k=0" #edb/ref 17592186045417] [17592186300213 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186300213 #edb/ref 1083 #uuid "3248af5c-24d6-51a0-a62b-8d5ab0e0e782" #edb/ref 17592186045417] [17592186300241 #edb/ref 1080 "k=2" #edb/ref 17592186045417] [17592186300241 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186300241 #edb/ref 1083 #uuid "39edf270-ef24-52e6-8a06-10a72874478d" #edb/ref 17592186045417] [17592186300297 #edb/ref 1080 "k=0" #edb/ref 17592186045417] [17592186300297 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186300297 #edb/ref 1083 #uuid "441122b0-3b95-5e4c-ad49-ebd17ab5fd1b" #edb/ref 17592186045417] [17592186300447 #edb/ref 1080 "k=\\frac{4}{3}" #edb/ref 17592186045417] [17592186300447 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186300447 #edb/ref 1083 #uuid "5ed5f31b-5757-56ca-ac90-622019b8d7e7" #edb/ref 17592186045417] [17592186300503 #edb/ref 1080 "k=\\frac{3}{4}" #edb/ref 17592186045417] [17592186300503 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186300503 #edb/ref 1083 #uuid "6b3ca3f5-57b3-5b3c-b6b4-0772e9be135c" #edb/ref 17592186045417] [17592186300522 #edb/ref 1080 "k=-4" #edb/ref 17592186045417] [17592186300522 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186300522 #edb/ref 1083 #uuid "6f2681ec-b8ae-51dc-9094-2e2bcadf6d8a" #edb/ref 17592186045417] [17592186300560 #edb/ref 1080 "k=-5" #edb/r