x,y)$ is\n\n$$\nf(x,y)=\\{\\begin{aligned}3y\\sqrt{x}, & \\,0\\le x\\le 1,\\,0\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186478444 :knowledge-point/_questions [{:db/id #edb/ref 17592186188274 :knowledge-point/id #uuid "8382e740-f1a5-52f6-97f5-df8c11929ef4" :knowledge-point/title "Finding the Joint PDF of Two Independent Random Variables Using Marginal PDFs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5cb9131c-d9eb-5cef-8e05-9ff2d9b72f68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x,y)=\\{\\begin{aligned}\\frac{3}{4}(y-1)\\sqrt{x}, & \\,0\\le x\\le 2,\\,1\\le y\\le 3 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186477925} {:answer/id #uuid "74029174-1966-5659-83fe-2592772dacda" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Impossible to determine using only the given information." :db/id #edb/ref 17592186477980} {:answer/id #uuid "89c7b625-6def-5a2d-8456-aeaab562159a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x,y)=\\{\\begin{aligned}\\frac{3}{16}(x-1)\\sqrt{2y}, & \\,0\\le x\\le 2,\\,1\\le y\\le 3 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186478014} {:answer/id #uuid "acad0ea1-c3a9-5b2c-bf4c-e2e36b44ad54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x,y)=\\{\\begin{aligned}\\frac{3}{16}(y-1)\\sqrt{2x}, & \\,0\\le x\\le 2,\\,1\\le y\\le 3 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186478067} {:answer/id #uuid "fd8d834e-9ed1-5dcb-a3d9-f32dc5876e0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x,y)=\\{\\begin{aligned}\\frac{1}{16}(y-1)\\sqrt{x}, & \\,0\\le x\\le 2,\\,1\\le y\\le 3 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186478241}] :answer-field/correct {:answer/id #uuid "7402