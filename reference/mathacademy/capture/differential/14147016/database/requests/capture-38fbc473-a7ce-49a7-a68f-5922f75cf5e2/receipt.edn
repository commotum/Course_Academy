{:edb/committed true :edb/basis-t 1566 :edb/replayed false :edb/tx-hash "41bf576ef0cceb81529970c8ea34c04294f03dd18b1fdbd712e092275a3c9a08" :edb/db-before-t 1565 :edb/db-after-t 1566 :edb/tx-data [[13194139534878 50 #inst "2026-10-12T22:23:08.300Z" 13194139534878 17592186045417 true] [17592186087834 1038 #edb/ref 17592186442283 13194139534878 17592186045417 true] [17592186442278 1043 #edb/ref 17592186442284 13194139534878 17592186045417 true] [17592186442278 1043 #edb/ref 17592186442285 13194139534878 17592186045417 true] [17592186442278 1043 #edb/ref 17592186442286 13194139534878 17592186045417 true] [17592186442278 1043 #edb/ref 17592186442287 13194139534878 17592186045417 true] [17592186442278 1043 #edb/ref 17592186442288 13194139534878 17592186045417 true] [17592186442278 1044 #edb/ref 17592186045464 13194139534878 17592186045417 true] [17592186442278 1045 "Equations of Ellipses Centered at a General Point" 13194139534878 17592186045417 true] [17592186442278 1046 #edb/ref 17592186442287 13194139534878 17592186045417 true] [17592186442278 1048 #edb/ref 17592186046658 13194139534878 17592186045417 true] [17592186442278 1049 #edb/ref 17592186049699 13194139534878 17592186045417 true] [17592186442278 1053 #uuid "3feb4992-432e-5c94-9938-9677fea30f81" 13194139534878 17592186045417 true] [17592186442279 1080 "8" 13194139534878 17592186045417 true] [17592186442279 1082 #edb/ref 17592186045498 13194139534878 17592186045417 true] [17592186442279 1083 #uuid "3d35968d-5c44-5e65-a197-520a366d9bdd" 13194139534878 17592186045417 true] [17592186442280 1080 "6\\sqrt{2}" 13194139534878 17592186045417 true] [17592186442280 1082 #edb/ref 17592186045498 13194139534878 17592186045417 true] [17592186442280 1083 #uuid "6350dda7-0009-5d3a-9b8a-8e8d61699c42" 13194139534878 17592186045417 true] [17592186442281 1075 #edb/ref 17592186442279 13194139534878 17592186045417 true] [17592186442281 1076 #edb/ref 17592186045492 13194139534878 17592186045417 true] [17592186442281 1077 "field-2" 13194139534878 17592186045417 true] [17592186442281 1078 #edb/ref 17592186442279 13194139534878 17592186045417 true] [17592186442281 1079 #uuid "344c48c4-4333-53a2-91c2-910da2275099" 13194139534878 17592186045417 true] [17592186442282 1075 #edb/ref 17592186442280 13194139534878 17592186045417 true] [17592186442282 1076 #edb/ref 17592186045492 13194139534878 17592186045417 true] [17592186442282 1077 "field-1" 13194139534878 17592186045417 true] [17592186442282 1078 #edb/ref 17592186442280 13194139534878 17592186045417 true] [17592186442282 1079 #uuid "72c3b159-addc-58ed-8523-aec1a6a17d47" 13194139534878 17592186045417 true] [17592186442283 1068 #edb/ref 17592186442281 13194139534878 17592186045417 true] [17592186442283 1068 #edb/ref 17592186442282 13194139534878 17592186045417 true] [17592186442283 1069 "q-278400" 13194139534878 17592186045417 true] [17592186442283 1070 #edb/ref 17592186045487 13194139534878 17592186045417 true] [17592186442283 1071 "For the ellipse $\\frac{(x-2)^{2}}{18}+\\frac{(y+1)^{2}}{16}=1,$ find the lengths of its major and minor axes.\n\n$\\,$ The length of the major axis is \n{{field-1}}.\n\n$\\,$ The length of the minor axis is \n{{field-2}}." 13194139534878 17592186045417 true] [17592186442283 1072 #uuid "35dee2e4-b90f-575e-8987-9a600b4e60ac" 13194139534878 17592186045417 true] [17592186442283 1074 "Remember that the general equation of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nIn the given equation, we have $h=2$ and $k=-1,$ so the center is located at $(2,-1).$\n\nIn the given equation, we also have ${a}^{2}=18$ and ${b}^{2}=16.$\n\n- Since ${a}^{2}=18,$ the length of the horizontal radius must be $a=\\sqrt{18}=3\\sqrt{2}.$\n\n- Since ${b}^{2}=16,$ the length of the vertical radius must be $b=\\sqrt{16}=4.$\n\nSo the semi-major axis has length $a=3\\sqrt{2},$ and the semi-minor axis has length $b=4.$\n\nTherefore, the major axis has length $2a=2\\cdot 3\\sqrt{2}=6\\sqrt{2},$ and the minor axis has length $2b=2\\cdot 4=8.$" 13194139534878 17592186045417 true] [17592186442284 1062 #uuid "479cce25-13e7-5cc9-8b50-cb0c7ebd0554" 13194139534878 17592186045417 true] [17592186442284 1063 #edb/ref 17592186295011 13194139534878 17592186045417 true] [17592186442285 1058 #edb/ref 17592186442286 13194139534878 17592186045417 true] [17592186442285 1062 #uuid "5e449fb1-4c6a-52d2-ba8a-4d3471a77fb8" 13194139534878 17592186045417 true] [17592186442285 1063 #edb/ref 17592186442283 13194139534878 17592186045417 true] [17592186442286 1058 #edb/ref 17592186442284 13194139534878 17592186045417 true] [17592186442286 1062 #uuid "5f6429ed-2ed5-5a9e-8dc2-d2bd00c04dcd" 13194139534878 17592186045417 true] [17592186442286 1063 #edb/ref 17592186295010 13194139534878 17592186045417 true] [17592186442287 1058 #edb/ref 17592186442288 13194139534878 17592186045417 true] [17592186442287 1062 #uuid "6ea8cfec-9867-5979-9717-6e4a67bd667e" 13194139534878 17592186045417 true] [17592186442287 1063 #edb/ref 17592186295006 13194139534878 17592186045417 true] [17592186442288 1058 #edb/ref 17592186442285 13194139534878 17592186045417 true] [17592186442288 1062 #uuid "f7f3c721-aa49-5677-9ac6-7f79cac99137" 13194139534878 17592186045417 true] [17592186442288 1063 #edb/ref 17592186295007 13194139534878 17592186045417 true]] :edb/tempids {"activity-3feb4992-432e-5c94-9938-9677fea30f81" 17592186442278 "answer-3d35968d-5c44-5e65-a197-520a366d9bdd" 17592186442279 "answer-6350dda7-0009-5d3a-9b8a-8e8d61699c42" 17592186442280 "answer-field-344c48c4-4333-53a2-91c2-910da2275099" 17592186442281 "answer-field-72c3b159-addc-58ed-8523-aec1a6a17d47" 17592186442282 "question-35dee2e4-b90f-575e-8987-9a600b4e60ac" 17592186442283 "step-479cce25-13e7-5cc9-8b50-cb0c7ebd0554" 17592186442284 "step-5e449fb1-4c6a-52d2-ba8a-4d3471a77fb8" 17592186442285 "step-5f6429ed-2ed5-5a9e-8dc2-d2bd00c04dcd" 17592186442286 "step-6ea8cfec-986