186045417] [17592186162114 #edb/ref 1038 #edb/ref 17592186544823 #edb/ref 17592186045417] [17592186162114 #edb/ref 1038 #edb/ref 17592186544888 #edb/ref 17592186045417] [17592186162114 #edb/ref 1039 "Finding a Conditional PDF" #edb/ref 17592186045417] [17592186162114 #edb/ref 1041 #edb/ref 17592186161680 #edb/ref 17592186045417] [17592186162114 #edb/ref 1042 #uuid "eb3b4b6a-3a24-5079-bf33-ed1c5576ffa7" #edb/ref 17592186045417] [17592186162176 #edb/ref 1043 #edb/ref 17592186163007 #edb/ref 17592186045417] [17592186162176 #edb/ref 1043 #edb/ref 17592186163078 #edb/ref 17592186045417] [17592186162176 #edb/ref 1043 #edb/ref 17592186163079 #edb/ref 17592186045417] [17592186162176 #edb/ref 1043 #edb/ref 17592186163080 #edb/ref 17592186045417] [17592186162176 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186162176 #edb/ref 1045 "Conditional Distributions for Continuous Random Variables" #edb/ref 17592186045417] [17592186162176 #edb/ref 1046 #edb/ref 17592186163007 #edb/ref 17592186045417] [17592186162176 #edb/ref 1049 #edb/ref 17592186050535 #edb/ref 17592186045417] [17592186162176 #edb/ref 1050 900.0 #edb/ref 17592186045417] [17592186162176 #edb/ref 1053 #uuid "fa26629c-b4dd-57db-9661-3b43692ea236" #edb/ref 17592186045417] [17592186162391 #edb/ref 1068 #edb/ref 17592186159548 #edb/ref 17592186045417] [17592186162391 #edb/ref 1069 "q-143460" #edb/ref 17592186045417] [17592186162391 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186162391 #edb/ref 1071 "Let $X$ and $Y$ be two continuous random variables with the following conditional probability density function:\n\n$$\n{f}_{X\\,|\\,Y}(x\\,|\\,y)=\\{\\begin{aligned}\\frac{2x}{{y}^{2}}, & \\,0<x<y,\\,0<y<1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nFind $P(\\frac{1}{4}<X<\\frac{1}{2}\\,|\\,Y=\\frac{5}{8}).$" #edb/ref 17592186045417] [17592186162391 #edb/ref 1072 #uuid "11a32556-0b83-5605-b76d-705cb2b8ca2e" #edb/ref 17592186045417] [17592186162391 #edb/ref 1074 "Recall that \n\n$$\nP(X\\in A\\,|\\,Y=y)={\\int }_{A}{f}_{X\\,|\\,Y}(x\\,|\\,y)\\,\\text{d}x,\n$$\n\nwhere ${f}_{X\\,|\\,Y}(x\\,|\\,y)$ is the conditional probability density function of $X$ given $Y=y.$ \n\nIn our case, we have \n\n$$\n\\begin{aligned}P(\\frac{1}{4}<X<\\frac{1}{2}\\,|\\,Y=\\frac{5}{8}) & ={\\int }_{1/4}^{1/2}{f}_{X\\,|\\,Y}(x\\,|\\,y=\\frac{5}{8})\\text{d}x \\\\  & ={\\int }_{1/4}^{1/2}\\frac{2x}{{(\\frac{5}{8})}^{2}}\\,\\text{d}x \\\\  & =\\frac{64}{25}{\\int }_{1/4}^{1/2}2x\\,\\text{d}x \\\\  & =\\frac{64}{25}[{x}^{2}]_{1/4}^{1/2} \\\\  & =\\frac{64}{25}(\\frac{1}{4}-\\frac{1}{16}) \\\\  & =\\frac{64}{25}(\\frac{3}{16}) \\\\  & =\\frac{12}{25}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186162392 #edb/ref 1068 #edb/ref 17592186413413 #edb/ref 17592186045417] [17592186162392 #edb/ref 1069 "q-143461" #edb/ref 17592186045417] [17592186162392 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186162392 #edb/ref 1071 "Let $X$ and $Y$ be two continuous random variables with the following joint probability density function:\n\n$$\nf(x,y)=\\{\\begin{aligned}24xy, & \\,0<x<1,0<y<1-x \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\n \n\nFind $P(Y<X\\,|\\,X=\\frac{1}{3}).$" #edb/ref 17592186045417] [17592186162392 #edb/ref 1072 #uuid "990850d6-75f9-5e72-98e4-4c732056938a" #edb/ref 17592186045417] [17592186162392 #edb/ref 1074 "Recall that \n\n$$\nP(Y\\in A\\,|\\,X=x)={\\int }_{A}{f}_{Y\\,|\\,X}(y\\,|\\,x)\\,\\text{d}y,\n$$\n\nwhere ${f}_{Y\\,|\\,X}(y\\,|\\,x)$ is the conditional probability density function of $Y$ given $X=x.$ \n\nUsing the formula for the marginal density function for $X,$ we have\n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y \\\\  & ={\\int }_{0}^{1-x}24xy\\,\\text{d}y \\\\  & =24x{\\int }_{0}^{1-x}y\\,\\text{d}y \\\\  & =24x{[\\frac{1}{2}{y}^{2}]}_{0}^{1-x} \\\\  & =12x(1-x)^{2}-0 \\\\  & =12x(x-1)^{2}.\\end{aligned}\n$$\n\nSo, the full expression for ${f}_{X}(x)$ is the following:\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}12x(x-1)^{2}, & \\,0<x<1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nNow recall that the conditional probability density function of $Y$ given $X=x$ for two continuous random variables $X$ and $Y$ is given by\n\n$$\n{f}_{Y\\,|\\,X}(y\\,|\\,x)=\\frac{f(x,y)}{{f}_{X}(x)}.\n$$\n\nwhere\n\n- $f(x,y)$ is the joint probability density function for $X$ and $Y,$ and\n\n- ${f}_{X}(x)$ is the marginal density function for $X.$\n\nNow, for $0<x<1,0<y<1-x,$ we have\n\n$$\n\\begin{aligned}{f}_{Y\\,|\\,X}(y\\,|\\,x) & =\\frac{f(x,y)}{{f}_{X}(x)} \\\\  & =\\frac{24xy}{12x(x-1)^{2}} \\\\  & =\\frac{2y}{(x-1)^{2}}.\\end{aligned}\n$$\n\nFor other values of $x$ and $y,$ the function $f(x,y)$ equals $0.$ As a result, ${f}_{Y\\,|\\,X}(y\\,|\\,x)$ will be equal to $0$ too.\n\nTherefore, the conditional probability density function is the following:\n\n$$\n{f}_{Y\\,|\\,X}(y\\,|\\,x)=\\{\\begin{aligned}\\frac{2y}{(x-1)^{2}}, & \\,0<x<1,0<y<1-x \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nFinally, we compute our probability:\n\n$$\n\\begin{aligned}P(Y<X\\,|\\,X=\\frac{1}{3}) & =P(Y<\\frac{1}{3}\\,|\\,X=\\frac{1}{3}) \\\\  & ={\\int }_{0}^{1/3}{f}_{Y\\,|\\,X}(y\\,|\\,x=\\frac{1}{3})\\text{d}y \\\\  & ={\\int }_{0}^{1/3}\\frac{2y}{{(\\frac{1}{3}-1)}^{2}}\\text{d}y \\\\  & =\\frac{9}{2}{\\int }_{0}^{1/3}y\\,\\text{d}y \\\\  & =\\frac{9}{2}{[\\frac{{y}^{2}}{2}]}_{0}^{1/3} \\\\  & =\\frac{9}{2}(\\frac{1}{18}-0) \\\\  & =\\frac{1}{4}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186163007 #edb/ref 1058 #edb/ref 17592186163078 #edb/ref 17592186045417] [17592186163007 #edb/ref 1061 34590 #edb/ref 17592186045417] [17592186163007 #edb/ref 1062 #uuid "cc469a65-06a8-5cb9-9eed-1c3d9f00c4c2" #edb/ref 17592186045417] [17592186163007 #edb/ref 1063 #edb/ref 17592186163291 #edb/ref 17592186045417] [17592186163078 #edb/ref 1058 #edb/ref 17592186163080 #edb/ref 17592186045417] [17592186163078 #edb/ref 1061 38091 #edb/ref 17592186045417] [17592186163078 #edb/ref 1062 #uuid "5d645e06-ba3d-5245-bff3-396e4a4a04e4" #edb/ref 17592186045417] [17592186163078 #edb/ref 1063 #edb/ref 17592186162112 #edb/ref 17592186045417] [17592186163079 #edb/ref 1061 38092 #edb/ref 17592186045417] [17592186163079 #edb/ref 1062 #uuid "f08e3c7b-ff47-5108-9d4d-3471aa625605" #edb/ref 17592186045417] [17592186163079 #edb/ref 1063 #edb/ref 17592186162113 #edb/ref 17592186045417] [17592186163080 #edb/ref 1058 #edb/ref 17592186163079 #edb/ref 17592186045417] [17592186163080 #edb/ref 1061 38093 #edb/ref 17592186045417] [17592186163080 #edb/ref 1062 #uuid "ccc00629-902d-501f-86c2-7072c1aad6a6" #edb/ref 17592186045417] [17592186163080 #edb/ref 1063 #edb/ref 17592186162114 #edb/ref 17592186045417] [17592186163291 #edb/ref 1064 "We can easily extend the notion of conditional probability distributions for discrete random variables to continuous random variables.\n\nFor continuous random variables $X$ and $Y,$ the **conditional probability density function of $X$ given $Y = y$** is given by\n\n$$\nf_{X|Y} (x|y) =\\dfrac{f(x, y)}{f_Y (y)}, \\qquad f_Y(y) \\neq 0,\n$$\n\nand the conditional probability density function of $Y$ given $X = x$ is given by\n\n$$\nf_{Y|X} (y|x) =\\dfrac{f(x, y)}{f_X (x)}, \\qquad f_X(x) \\neq 0.\n$$\n\nNotice that these definitions are analogous to those for discrete random variables.\n\nTo compute probabilities, we work directly with these conditional PDFs. For example, to calculate the **conditional probability of $X$ given $Y,$** we use\n\n$$\nP(X \\in A|Y = y) =\\int_A f_{X|Y} (x|y)\\, \\textrm dx.\n$$\n\nIn general, the conditional distribution of $X$ given $Y$ does not equal the conditional distribution of $Y$  given $X$. That is\n\n$$\nf_{X|Y}(x|y)  \\ne f_{Y|X}(y|x).\n$$\n\nFinally, if $X$  and $Y$  are independent, then\n\n$$\nf_{X|Y}(x|y)=f_X(x),\\qquad f_{Y|X}(y|x)=f_Y(y).\n$$" #edb/ref 17592186045417] [17592186163291 #edb/ref 1065 5625 #edb/ref 17592186045417] [17592186163291 #edb/ref 1066 #uuid "4e66c559-ad43-5152-a04e-7aa8b01374ef" #edb/ref 17592186045417] [17592186163291 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186413396 #edb/ref 1043 #edb/ref 17592186413416 #edb/ref 17592186045417] [17592186413396 #edb/ref 1043 #edb/ref 17592186413417 #edb/ref 17592186045417] [17592186413396 #edb/ref 1043 #edb/ref 17592186413418 #edb/ref 17592186045417] [17592186413396 #edb/ref 1044 #edb/ref 17592186045464 #edb/ref 17592186045417] [17592186413396 #edb/ref 1045 "Conditional Distributions for Continuous Random Variables" #edb/ref 17592186045417] [17592186413396 #edb/ref 1046 #edb/ref 17592186413418 #edb/ref 17592186045417] [17592186413396 #edb/ref 1048 #edb/ref 17592186046660 #edb/ref 17592186045417] [17592186413396 #edb/ref 1049 #edb/ref 17592186050535 #edb/ref 17592186045417] [17592186413396 #edb/ref 1053 #uuid "8d71dbb8-3f6b-51a3-b4b2-a5b2c8b23a9b" #edb/ref 17592186045417] [17592186413397 #edb/ref 1080 "\\frac{15}{16}" #edb/ref 17592186045417] [17592186413397 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186413397 #edb/ref 1083 #uuid "0232ff5b-0d05-5778-88a0-ff0af66fc111" #edb/ref 17592186045417] [17592186413398 #edb/ref 1080 "\\frac{27}{64}" #edb/ref 17592186045417] [17592186413398 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186413398 #edb/ref 1083 #uuid "0d7ebaa8-7f99-5427-8a2f-237d9f6e4410" #edb/ref 17592186045417] [17592186413399 #edb/ref 1080 "\\frac{8}{9}" #edb/ref 17592186045417] [17592186413399 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186413399 #edb/ref 1083 #uuid "291ffaa1-af34-572c-8208-632d599387b4" #edb/ref 17592186045417] [17592186413400 #edb/ref 1080 "\\frac{2x+3y}{3(y+1)}" #edb/ref 17592186045417] [17592186413400 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186413400 #edb/ref 1083 #uuid "2b4b973f-cb9d-5e7e-8beb-4c556f2b875c" #edb/ref 17592186045417] [17592186413401 #edb/ref 1080 "\\frac{4}{9}" #edb/ref 17592186045417] [17592186413401 #edb/ref 1082 #edb/re