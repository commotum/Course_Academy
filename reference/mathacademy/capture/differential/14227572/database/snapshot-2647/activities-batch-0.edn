92186354350} {:db/id #edb/ref 17592186354351} {:db/id #edb/ref 17592186354352} {:db/id #edb/ref 17592186354353} {:db/id #edb/ref 17592186354354} {:db/id #edb/ref 17592186487291} {:db/id #edb/ref 17592186487386}] :knowledge-point/title "Parametrizing a Horizontal Parabola"} :step/id #uuid "3d1e229c-5dac-5677-a852-b2257436bd7c" :step/math-academy-id 27634 :step/next {:db/id #edb/ref 17592186158150}} {:db/id #edb/ref 17592186158150 :step/content {:db/id #edb/ref 17592186157305 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157109 :question/id #uuid "780170af-a92e-5a87-b08d-d9d940d6906b" :question/math-academy-id "e-7448"} :knowledge-point/id #uuid "14079b03-66c0-5657-8909-a7d5ea35bfc0" :knowledge-point/questions [{:db/id #edb/ref 17592186157846} {:db/id #edb/ref 17592186157847} {:db/id #edb/ref 17592186243891} {:db/id #edb/ref 17592186243892} {:db/id #edb/ref 17592186243893} {:db/id #edb/ref 17592186243894} {:db/id #edb/ref 17592186302072} {:db/id #edb/ref 17592186302131} {:db/id #edb/ref 17592186302132} {:db/id #edb/ref 17592186302135} {:db/id #edb/ref 17592186302138} {:db/id #edb/ref 17592186302140} {:db/id #edb/ref 17592186302141} {:db/id #edb/ref 17592186354355} {:db/id #edb/ref 17592186354356} {:db/id #edb/ref 17592186354357} {:db/id #edb/ref 17592186354358} {:db/id #edb/ref 17592186354359} {:db/id #edb/ref 17592186354360} {:db/id #edb/ref 17592186487305} {:db/id #edb/ref 17592186487377} {:db/id #edb/ref 17592186487378} {:db/id #edb/ref 17592186548981} {:db/id #edb/ref 17592186549012}] :knowledge-point/title "Finding the Cartesian Equation of Parabola Given Its Parametric Equations"} :step/id #uuid "c1826ce1-bb63-5660-9720-c1e180003184" :step/math-academy-id 27635 :step/next {:db/id #edb/ref 17592186158182}} {:db/id #edb/ref 17592186158180 :step/content {:db/id #edb/ref 17592186158498 :tutorial/content "The parametric equations of a *vertical* parabola that has its vertex at $(h,k)$ are\n\n$$\nx-h = 2pt, \\qquad y-k = pt^2, \\qquad t \\in (-\\infty, \\infty),\n$$\n\nwhere $p$ is constant.\n\nFor instance, the parabola \n\n$$\nx-2 = 2t,\\quad y-1 = t^2,\\quad t \\in (-\\infty, \\infty)\n$$\n\nhas its vertex at $(h,k) = (2,1)$ and has $p = 1.$ A sketch of this parabola is shown below.\n\n![](images/03/036d1dff3c5daada329489b55259369e1dece17be7b1af7ff0314eb47318a9ce.png)" :tutorial/id #uuid "e03fed66-1fc4-5d82-a378-4f47605f8e17" :tutorial/math-academy-id 4627 :tutorial/title "Introduction"} :step/id #uuid "bcfe026f-8c08-5f21-a2e2-5d9aa2ef5726" :step/math-academy-id 28496 :step/next {:db/id #edb/ref 17592186158148}} {:db/id #edb/ref 17592186158181 :step/content {:db/id #edb/ref 17592186158499 :tutorial/content "The parametric equations of a *horizontal* parabola that has its vertex at $(h,k)$ are\n\n$$\nx-h = pt^2, \\qquad y-k = 2pt, \\qquad t \\in (-\\infty, \\infty),\n$$\n\nwhere $p$ is constant." :tutorial/id #uuid "badab523-af9e-55ff-b5e0-cd66ae697426" :tutorial/math-academy-id 4628 :tutorial/title "Parametric Equations of Horizontal Parabolas"} :step/id #uuid "e3279e8f-1b3f-59cf-b3a2-dedf1b46f31b" :step/math-academy-id 28498 :step/next {:db/id #edb/ref 17592186158149}} {:db/id #edb/ref 17592186158182 :step/content {:db/id #edb/ref 17592186158500 :tutorial/content "Let's recall the parametric equations of a vertical parabola that has its vertex at $(h,k){:}$\n\n$$\nx-h = 2pt, \\qquad y-k = pt^2, \\qquad t\\in(-\\infty,\\infty).\n$$\n\nHow can we be sure that these equations describe a parabola?\n\nFirst, let's make $t$ the subject of the parametric equations:\n\n$$\n\\begin{aligned}x-h & =2pt & ⟹ &  & t & =\\frac{x-h}{2p} \\\\ y-k & =p{t}^{2} & ⟹ &  & {t}^{2} & =\\frac{y-k}{p}\\end{aligned}\n$$\n\nSquaring the first equation above, we have\n\n$$\n\\begin{aligned}{t}^{2} & ={(\\frac{x-h}{2p})}^{2} \\\\ {t}^{2} & =\\frac{(x-h)^{2}}{4{p}^{2}}.\\end{aligned}\n$$\n\nNow, substituting in the second equation $t^2 = \\dfrac{y-k}{p},$ we can eliminate the parameter $t$ and rearrange to find the Cartesian equation:\n\n$$\n\\begin{aligned}{t}^{2} & =\\frac{(x-h)^{2}}{4{p}^{2}} \\\\ \\frac{y-k}{p} & =\\frac{(x-h)^{2}}{4{p}^{2}} \\\\ \\frac{y-k}{p}\\cdot 4{p}^{2} & =(x-h)^{2} \\\\ (x-h)^{2} & =4p(y-k)\\end{aligned}\n$$\n\nThis is the Cartesian equation of a vertical parabola with vertex $(h,k).$ Therefore, the parametric equations do indeed describe a vertical parabola.\n\nIf we did the same for the parametric equations of a horizontal parabola that has its vertex at $(h,k),$ we would obtain the Cartesian equation of a horizontal parabola, namely $(y-k)^2 = 4p(x-h).$" :tutorial/id #uuid "aa16807b-02e7-5313-af63-c2996410568b" :tutorial/math-academy-id 4629 :tutorial/title "Justification That the Parametric Equations Describe a Parabola"} :step/id #uuid "6ab7a388-97c9-5750-8334-4e93498973b7" :step/math-academy-id 28500}] :activity/title "Parametric Equations of Parabolas Centered at (h,k)" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186157492}]}
