      "disabled": false,
      "input_html": "<div id=\"freeResponseTextbox-1\" class=\"matheditor-wrapper-answer\" ;=\"\" style=\"min-width:55px;\n                                        margin-left:2px;\n                                        margin-right:1px;\n                                        background:;\"><div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"71\"><span mathquill-command-id=\"73\">0</span><span mathquill-command-id=\"75\">.</span><span mathquill-command-id=\"77\">2</span><span mathquill-command-id=\"79\">3</span><span mathquill-command-id=\"81\">2</span><span mathquill-command-id=\"83\">7</span></span></div></div>",
