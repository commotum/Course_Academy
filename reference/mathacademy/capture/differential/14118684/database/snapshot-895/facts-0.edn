-52a1-a085-a06727c301b8" #edb/ref 17592186045417] [17592186050527 #edb/ref 1027 #edb/ref 17592186048462 #edb/ref 17592186045417] [17592186050527 #edb/ref 1027 #edb/ref 17592186049422 #edb/ref 17592186045417] [17592186050527 #edb/ref 1027 #edb/ref 17592186050576 #edb/ref 17592186045417] [17592186050527 #edb/ref 1028 #edb/ref 17592186161965 #edb/ref 17592186045417] [17592186050527 #edb/ref 1028 #edb/ref 17592186161966 #edb/ref 17592186045417] [17592186050527 #edb/ref 1028 #edb/ref 17592186161967 #edb/ref 17592186045417] [17592186050527 #edb/ref 1028 #edb/ref 17592186161968 #edb/ref 17592186045417] [17592186050527 #edb/ref 1031 "Creating Rows or Columns Containing Zeros Using Gaussian Elimination" #edb/ref 17592186045417] [17592186050527 #edb/ref 1033 3029 #edb/ref 17592186045417] [17592186050527 #edb/ref 1035 #uuid "508ac00e-0867-53e8-a192-d981ff4bbdc2" #edb/ref 17592186045417] [17592186050765 #edb/ref 1027 #edb/ref 17592186048980 #edb/ref 17592186045417] [17592186050765 #edb/ref 1027 #edb/ref 17592186049120 #edb/ref 17592186045417] [17592186050765 #edb/ref 1028 #edb/ref 17592186059767 #edb/ref 17592186045417] [17592186050765 #edb/ref 1028 #edb/ref 17592186059768 #edb/ref 17592186045417] [17592186050765 #edb/ref 1028 #edb/ref 17592186059769 #edb/ref 17592186045417] [17592186050765 #edb/ref 1028 #edb/ref 17592186059770 #edb/ref 17592186045417] [17592186050765 #edb/ref 1031 "Systems of Equations as Augmented Matrices" #edb/ref 17592186045417] [17592186050765 #edb/ref 1033 148 #edb/ref 17592186045417] [17592186050765 #edb/ref 1035 #uuid "64dbabd7-08e6-5435-b006-ab4997312f47" #edb/ref 17592186045417] [17592186059584 #edb/ref 1069 "e-4697" #edb/ref 17592186045417] [17592186059584 #edb/ref 1071 "Consider the augmented matrix $M$ given by \n![](images/46/464ba24026d89efb3e62f7807426e5c413f277da3c8087931d2e3fde9a0b8e74.svg)\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form, and then solve the linear system represented by the matrix." #edb/ref 17592186045417] [17592186059584 #edb/ref 1072 #uuid "0a9e6824-677a-5fae-9867-1701e7d8378f" #edb/ref 17592186045417] [17592186059584 #edb/ref 1074 "Reducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}1 & 2 & 0 \\\\ 3 & -2 & -8\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & 0 \\\\ 0 & -8 & -8\\end{aligned}] & {R}_{2} & :=-\\frac{1}{8}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 2 & 0 \\\\ 0 & 1 & 1\\end{aligned}].\\end{aligned}\n$$\n\nThe system is now \n![](images/ba/baf05a693deacc3ef644165bae4de7b1435a90c73f050ac76c48892b2e010393.svg)\n\nand we can apply back substitution. The final equation $y=1$ tells us the value of $y.$ Substituting this value into the first equation, we get\n\n$$\nx+2(1)=0 \n\t\\quad\\Rightarrow\\quad\n\tx=-2.\n$$\n\nTherefore, the solution is $x=-2$ and $y=1.$ Or, in vector form, $\\left<  -2,1 \\right>.$" #edb/ref 17592186045417] [17592186059585 #edb/ref 1069 "e-4698" #edb/ref 17592186045417] [17592186059585 #edb/ref 1071 "Consider the system of linear equations\n![](images/7b/7b1adc08164fdcf1a5322b4fbfd3e5b0f57e22e018aa801add4bb3b572c29f76.svg)\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form, and then solve the linear system." #edb/ref 17592186045417] [17592186059585 #edb/ref 1072 #uuid "1eea81be-26d7-57dd-a622-d66300de7f4f" #edb/ref 17592186045417] [17592186059585 #edb/ref 1074 "The augmented matrix for this system is\n\n![](images/87/8773defc4db521e846b58b7c5ef04b54f26723d94099c75caffbeca0587c33dc.svg)\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}-1 & 5 & 5 \\\\ 1 & -6 & 5\\end{aligned}] & {R}_{1} & :=-{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -5 & -5 \\\\ 1 & -6 & 5\\end{aligned}] & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\  & ∼[\\begin{aligned}1 & -5 & -5 \\\\ 0 & -1 & 10\\end{aligned}] & {R}_{2} & :=-{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -5 & -5 \\\\ 0 & 1 & -10\\end{aligned}].\\end{aligned}\n$$\n\nThe system is now \n\n![](images/45/455dc49a531a371ea8aecd6259a677c8006bb2a23181ed66d27721135f240c89.svg)\n\nand we can apply back substitution. The final equation $y=-10$ tells us the value of $y.$ Substituting this value into the first equation, we get\n\n$$\nx-5(-10)=-5 \n\t\\quad\\Rightarrow\\quad\n\tx=-55.\n$$\n\nTherefore, the solution is $x=-55$ and $y=-10.$ Or, in vector form, $\\langle -55,-10 \\rangle.$" #edb/ref 17592186045417] [17592186059775 #edb/ref 1037 #edb/ref 17592186050267 #edb/ref 17592186045417] [17592186059775 #edb/ref 1037 #edb/ref 17592186050527 #edb/ref 17592186045417] [17592186059775 #edb/ref 1038 #edb/ref 17592186059965 #edb/ref 17592186045417] [17592186059775 #edb/ref 1038 #edb/ref 17592186059978 #edb/ref 17592186045417] [17592186059775 #edb/ref 1038 #edb/ref 17592186237988 #edb/ref 17592186045417] [17592186059775 #edb/ref 1038 #edb/ref 17592186241137 #edb/ref 17592186045417] [17592186059775 #edb/ref 1038 #edb/ref 17592186241149 #edb/ref 17592186045417] [17592186059775 #edb/ref 1038 #edb/ref 17592186266010 #edb/ref 17592186045417] [17592186059775 #edb/ref 1038 #edb/ref 17592186287991 #edb/ref 17592186045417] [17592186059775 #edb/ref 1038 #edb/ref 17592186287992 #edb/ref 17592186045417] [17592186059775 #edb/ref 1038 #edb/ref 17592186386127 #edb/ref 17592186045417] [17592186059775 #edb/ref 1038 #edb/ref 17592186388195 #edb/ref 17592186045417] [17592186059775 #edb/ref 1039 "Reducing a 2x2 Augmented Matrix to REF Using Gaussian Elimination" #edb/ref 17592186045417] [17592186059775 #edb/ref 1041 #edb/ref 17592186059584 #edb/ref 17592186045417] [17592186059775 #edb/ref 1042 #uuid "a10cafc6-9da7-5ffc-a0c7-686a7638fbd9" #edb/ref 17592186045417] [17592186059776 #edb/ref 1037 #edb/ref 17592186050765 #edb/ref 17592186045417] [17592186059776 #edb/ref 1038 #edb/ref 17592186059970 #edb/ref 17592186045417] [17592186059776 #edb/ref 1038 #edb/ref 17592186060205 #edb/ref 17592186045417] [17592186059776 #edb/ref 1038 #edb/ref 17592186287994 #edb/ref 17592186045417] [17592186059776 #edb/ref 1038 #edb/ref 17592186287995 #edb/ref 17592186045417] [17592186059776 #edb/ref 1038 #edb/ref 17592186342013 #edb/ref 17592186045417] [17592186059776 #edb/ref 1038 #edb/ref 17592186388202 #edb/ref 17592186045417] [17592186059776 #edb/ref 1038 #edb/ref 17592186393299 #edb/ref 17592186045417] [17592186059776 #edb/ref 1038 #edb/ref 17592186393306 #edb/ref 17592186045417] [17592186059776 #edb/ref 1038 #edb/ref 17592186393313 #edb/ref 17592186045417] [17592186059776 #edb/ref 1038 #edb/ref 17592186414018 #edb/ref 17592186045417] [17592186059776 #edb/ref 1039 "Solving a 2x2 System of Equations Using Gaussian Elimination" #edb/ref 17592186045417] [17592186059776 #edb/ref 1041 #edb/ref 17592186059585 #edb/ref 17592186045417] [17592186059776 #edb/ref 1042 #uuid "07abc1cc-5794-51a6-bad4-40565eae52be" #edb/ref 17592186045417] [17592186059884 #edb/ref 1043 #edb/ref 17592186060686 #edb/ref 17592186045417] [17592186059884 #edb/ref 1043 #edb/ref 17592186060687 #edb/ref 17592186045417] [17592186059884 #edb/ref 1043 #edb/ref 17592186060688 #edb/ref 17592186045417] [17592186059884 #edb/ref 1043 #edb/ref 17592186060689 #edb/ref 17592186045417] [17592186059884 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186059884 #edb/ref 1045 "Solving 2x2 Systems of Equations Using Gaussian Elimination" #edb/ref 17592186045417] [17592186059884 #edb/ref 1046 #edb/ref 17592186060686 #edb/ref 17592186045417] [17592186059884 #edb/ref 1049 #edb/ref 17592186049422 #edb/ref 17592186045417] [17592186059884 #edb/ref 1050 600.0 #edb/ref 17592186045417] [17592186059884 #edb/ref 1053 #uuid "ccb8f334-2616-5c6c-bf9f-ac7f7a6bbbf5" #edb/ref 17592186045417] [17592186060686 #edb/ref 1058 #edb/ref 17592186060688 #edb/ref 17592186045417] [17592186060686 #edb/ref 1061 17188 #edb/ref 17592186045417] [17592186060686 #edb/ref 1062 #uuid "4af04e11-a9c8-594e-af53-b43d73f0e12d" #edb/ref 17592186045417] [17592186060686 #edb/ref 1063 #edb/ref 17592186060941 #edb/ref 17592186045417] [17592186060687 #edb/ref 1058 #edb/ref 17592186060689 #edb/ref 17592186045417] [17592186060687 #edb/ref 1061 17189 #edb/ref 17592186045417] [17592186060687 #edb/ref 1062 #uuid "2b9b40ab-3cb7-53b3-bb37-414d8e65412f" #edb/ref 17592186045417] [17592186060687 #edb/ref 1063 #edb/ref 17592186059775 #edb/ref 17592186045417] [17592186060688 #edb/ref 1058 #edb/ref 17592186060687 #edb/ref 17592186045417] [17592186060688 #edb/ref 1061 17190 #edb/ref 17592186045417] [17592186060688 #edb/ref 1062 #uuid "bafcaf30-9671-5655-95bd-e04dfa8750ef" #edb/ref 17592186045417] [17592186060688 #edb/ref 1063 #edb/ref 17592186060942 #edb/ref 17592186045417] [17592186060689 #edb/ref 1061 17191 #edb/ref 17592186045417] [17592186060689 #edb/ref 1062 #uuid "381e4e89-5395-58a9-bdf6-3f814147b17f" #edb/ref 17592186045417] [17592186060689 #edb/ref 1063 #edb/ref 17592186059776 #edb/ref 17592186045417] [17592186060941 #edb/ref 1064 "Consider the following system of linear equations and its respective **augmented matrix**:\n![](images/2c/2c5dfe046037750f98f773ad906094f5ffbad3c285adf200134a119f72888ac8.svg)\n\nIf we can convert the augmented matrix $M$ to row echelon form, then we can solve the system using back substitution.\n\nThe procedure for reducing $M$ to row echelon form using elementary row operations is called **Gaussian elimination**. To perform Gaussian elimination on a $2 \\times 2$ matrix, we use the following procedure.\n\n**Step 1:** Consider the entry $a_{11}=2$ of the coefficient matrix. This entry is called a **pivot element**. We want to make this entry equal to $1$. So, the first elementary row operation will be \n\n$$\nR_1 := \\dfrac{1}{2}R_1\n$$\n\nand we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}2 & 6 & -2 \\\\ 3 & -1 & 2\\end{aligned}] & {R}_{1}:=\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 3 & -1 \\\\ 3 & -1 & 2\\end{aligned}].\\end{aligned}\n$$\n\n**Step 2:** Consider the entry $a_{21}=3$ below the first pivot element. We want to make this entry equal to $0$. So, the second elementary row operation will be \n\n$$\nR_2 :=R_2+(-3)R_1\n$$\n\nand we have\n\n$$\n\\begin{aligned} & ∼[\\begin{aligned}1 & 3 & -1 \\\\ 3 & -1 & 2\\end{aligned}] & {R}_{2}:={R}_{2}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 3 & -1 \\\\ 0 & -10 & 5\\end{aligned}].\\end{aligned}\n$$\n\n**Step 3:** Finally, consider the entry $a_{22}=-10$. This entry is the second pivot element, and we would like to make it equal to $1$. So, the third elementary row operation will be \n\n$$\nR_2 :=\\dfrac{1}{-10}R_2\n$$\n\nand we get $M$ in row echelon form:\n\n$$\n\\begin{aligned} & ∼[\\begin{aligned}1 & 3 & -1 \\\\ 0 & -10 & 5\\end{aligned}] & {R}_{2}:=\\frac{1}{-10}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 3 & -1 \\\\ 0 & 1 & -\\frac{1}{2}\\end{aligned}].\\end{aligned}\n$$\n\nThe system is now \n![](images/b8/b83c4646349bada803311e5e9e160aafc8f08e6f51c7b69302def5ca4eeaa3fa.svg)\n\nand we can apply back substitution. The final equation $y=-\\dfrac{1}{2}$ tells us the value of $y.$ Substituting this value into the first equation, we get\n\n$$\nx+3 \\left( -\\dfrac{1}{2} \\right) = -1 \n\t\\qquad\\Rightarrow\\qquad\n\tx=\\dfrac{1}{2}.\n$$\n\nTherefore, the solution is $x=\\dfrac{1}{2}$ and $y=-\\dfrac{1}{2}.$ Or, in vector form, $\\left< \\dfrac{1}{2}, -\\dfrac{1}{2} \\right>.$" #edb/ref 17592186045417] [17592186060941 #edb/ref 1065 3151 #edb/ref 17592186045417] [17592186060941 #edb/ref 1066 #uuid "2112d3af-1fb0-5a70-ab99-59931db99930" #edb/ref 17592186045417] [17592186060941 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186060942 #edb/ref 1064 "The row echelon form of a matrix is *not* unique. In the previous example, after the first row operation we arrived at \n\n![](images/eb/ebcb9bc5aedf609284436ad1c10e98f9b22d91a382136b5aabfb3f18c736ddae.svg)\n\nThis augmented matrix is already in row echelon form! However, it is always useful to do an extra step and obtain $1$'s along the main diagonal, like we did previously:\n\n![](images/53/536245bdc7fc9dab02723d3576adff774dfd9711551f472333c027d83f76c05b.svg)\n\nHaving $1$'s along the main diagonal makes the final back substitution process a little easier." #edb/ref 17592186045417] [17592186060942 #edb/ref 1065 3152 #edb/ref 17592186045417] [17592186060942 #edb/ref 1066 #uuid "ee4b134d-2908-5930-86bb-32537e0d8347" #edb/ref 17592186045417] [17592186060942 #edb/ref 1067 "The Uniqueness of the Row Echelon Form Matrix" #edb/ref 17592186045417] [17592186238587 #edb/ref 1080 "M∼[\\begin{aligned}1 & -2 & -1 \\\\ 0 & 1 & \\frac{11}{16}\\end{aligned}]" #edb/ref 17592186045417] [17592186238587 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186238587 #edb/ref 1083 #uuid "3d657c0d-5d97-537c-911b-9fadbaaa3670" #edb/ref 17592186045417] [17592186238598 #edb/ref 1080 "M∼[\\begin{aligned}1 & -2 & -1 \\\\ 0 & 1 & \\frac{13}{16}\\end{aligned}]" #edb/ref 17592186045417] [17592186238598 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186238598 #edb/ref 1083 #uuid "3e408362-b837-5b32-9b36-33ac7e5b4610" #edb/ref 17592186045417] [17592186239014 #edb/ref 1080 "M∼[\\begin{aligned}1 & -2 & -1 \\\\ 0 & 1 & \\frac{15}{16}\\end{aligned}]" #edb/ref 17592186045417] [17592186239014 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186239014 #edb/ref 1083 #uuid "6f45203e-09d8-57c8-83cd-c8f7658a36f5" #edb/ref 17592186045417] [17592186239668 #edb/ref 1080 "M∼[\\begin{aligned}1 & -2 & -1 \\\\ 0 & 1 & \\frac{17}{16}\\end{aligned}]" #edb/ref 17592186045417] [17592186239668 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186239668 #edb/ref 1083 #uuid "b9791b07-a4eb-523d-9cf6-2317db471ade" #edb/ref 17592186045417] [17592186240258 #edb/ref 1080 "M∼[\\begin{aligned}1 & -2 & -1 \\\\ 0 & 1 & \\frac{9}{16}\\end{aligned}]" #edb/ref 17592186045417] [17592186240258 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186240258 #edb/ref 1083 #uuid "f90e1648-976d-5da5-90a9-f26e2ffeb4ed" #edb/ref 17592186045417] [17592186240459 #edb/ref 1075 #edb/ref 17592186238587 #edb/ref 17592186045417] [17592186240459 #edb/ref 1075 #edb/ref 17592186238598 #edb/ref 17592186045417] [17592186240459 #edb/ref 1075 #edb/ref 17592186239014 #edb/ref 17592186045417] [17592186240459 #edb/ref 1075 #edb/ref 17592186239668 #edb/ref 17592186045417] [17592186240459 #edb/ref 1075 #edb/ref 17592186240258 #edb/ref 17592186045417] [17592186240459 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186240459 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186240459 #edb/ref 1078 #edb/ref 17592186238598 #edb/ref 17592186045417] [17592186240459 #edb/ref 1079 #uuid "4a1bbeec-fbf0-53a7-9f8e-2c368383943e" #edb/ref 17592186045417] [17592186241149 #edb/ref 1068 #edb/ref 17592186240459 #edb/ref 17592186045417] [17592186241149 #edb/ref 1069 "q-1060" #edb/ref 17592186045417] [17592186241149 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186241149 #edb/ref 1071 "Consider the augmented matrix $M$ given by\n\n$$\nM=[\\begin{aligned}-1 & 2 & 1 \\\\ 5 & 6 & 8\\end{aligned}].\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form." #edb/ref 17592186045417] [17592186241149 #edb/ref 1072 #uuid "157d0b46-caa9-5e52-add3-341aa2ee9d01" #edb/ref 17592186045417] [17592186241149 #edb/ref 1074 "Reducing $M$ to row echelon form using the standard algorithm for Gaussian elimination, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}-1 & 2 & 1 \\\\ 5 & 6 & 8\\end{aligned}] & {R}_{1} & :=-1\\cdot {R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & -1 \\\\ 5 & 6 & 8\\end{aligned}] & {R}_{2} & :={R}_{2}-5\\cdot {R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & -1 \\\\ 0 & 16 & 13\\end{aligned}] & {R}_{2} & :=\\frac{1}{16}\\cdot {R}_{2} \\\\  & ∼[\\begin{aligned}1 & -2 & -1 \\\\ 0 & 1 & \\frac{13}{16}\\end{aligned}].\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186388195 #edb/ref 1068 #edb/ref 17592186388196 #edb/ref 17592186045417] [17592186388195 #edb/ref 1069 "q-130909" #edb/ref 17592186045417] [17592186388195 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186388195 #edb/ref 1071 "Consider the augmented matrix $M$ given by\n\n$$\nM=[\\begin{aligned}2 & -8 & 6 \\\\ 3 & -7 & 4\\end{aligned}].\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form." #edb/ref 17592186045417] [17592186388195 #edb/ref 1072 #uuid "dc5530a8-d7bb-5ee6-b842-11178cec4e06" #edb/ref 17592186045417] [17592186388195 #edb/ref 1074 "Reducing $M$ to row echelon form using the standard algorithm for Gaussian elimination, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}2 & -8 & 6 \\\\ 3 & -7 & 4\\end{aligned}] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -4 & 3 \\\\ 3 & -7 & 4\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & -4 & 3 \\\\ 0 & 5 & -5\\end{aligned}] & {R}_{2} & :=\\frac{1}{5}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -4 & 3 \\\\ 0 & 1 & -1\\end{aligned}].\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186388196 #edb/ref 1075 #edb/ref 17592186388197 #edb/ref 17592186045417] [17592186388196 #edb/ref 1075 #edb/ref 17592186388198 #edb/ref 17592186045417] [17592186388196 #edb/ref 1075 #edb/ref 17592186388199 #edb/ref 17592186045417] [17592186388196 #edb/ref 1075 #edb/ref 17592186388200 #edb/ref 17592186045417] [17592186388196 #edb/ref 1075 #edb/ref 17592186388201 #edb/ref 17592186045417] [17592186388196 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186388196 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186388196 #edb/ref 1078 #edb/ref 17592186388200 #edb/ref 17592186045417] [17592186388196 #edb/ref 1079 #uuid "d7823cff-303e-53ab-9742-7a012bfe87c1" #edb/ref 17592186045417] [17592186388197 #edb/ref 1080 "M∼[\\begin{aligned}1 & -4 & 3 \\\\ 0 & 1 & 1\\end{aligned}]" #edb/ref 17592186045417] [17592186388197 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186388197 #edb/ref 1083 #u