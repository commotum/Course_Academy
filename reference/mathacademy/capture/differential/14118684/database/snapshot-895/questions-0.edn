#{[{:db/id #edb/ref 17592186059584 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186059775 :knowledge-point/id #uuid "a10cafc6-9da7-5ffc-a0c7-686a7638fbd9" :knowledge-point/title "Reducing a 2x2 Augmented Matrix to REF Using Gaussian Elimination"}] :question/id #uuid "0a9e6824-677a-5fae-9867-1701e7d8378f" :question/math-academy-id "e-4697" :question/problem "Consider the augmented matrix $M$ given by \n![](images/46/464ba24026d89efb3e62f7807426e5c413f277da3c8087931d2e3fde9a0b8e74.svg)\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form, and then solve the linear system represented by the matrix." :question/worked-solution "Reducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}1 & 2 & 0 \\\\ 3 & -2 & -8\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & 0 \\\\ 0 & -8 & -8\\end{aligned}] & {R}_{2} & :=-\\frac{1}{8}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 2 & 0 \\\\ 0 & 1 & 1\\end{aligned}].\\end{aligned}\n$$\n\nThe system is now \n![](images/ba/baf05a693deacc3ef644165bae4de7b1435a90c73f050ac76c48892b2e010393.svg)\n\nand we can apply back substitution. The final equation $y=1$ tells us the value of $y.$ Substituting this value into the first equation, we get\n\n$$\nx+2(1)=0 \n\t\\quad\\Rightarrow\\quad\n\tx=-2.\n$$\n\nTherefore, the solution is $x=-2$ and $y=1.$ Or, in vector form, $\\left<  -2,1 \\right>.$"}] [{:db/id #edb/ref 17592186059585 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186059776 :knowledge-point/id #uuid "07abc1cc-5794-51a6-bad4-40565eae52be" :knowledge-point/title "Solving a 2x2 System of Equations Using Gaussian Elimination"}] :question/id #uuid "1eea81be-26d7-57dd-a622-d66300de7f4f" :question/math-academy-id "e-4698" :question/problem "Consider the system of linear equations\n![](images/7b/7b1adc08164fdcf1a5322b4fbfd3e5b0f57e22e018aa801add4bb3b572c29f76.svg)\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n![](images/87/8773defc4db521e846b58b7c5ef04b54f26723d94099c75caffbeca0587c33dc.svg)\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}-1 & 5 & 5 \\\\ 1 & -6 & 5\\end{aligned}] & {R}_{1} & :=-{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -5 & -5 \\\\ 1 & -6 & 5\\end{aligned}] & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\  & ∼[\\begin{aligned}1 & -5 & -5 \\\\ 0 & -1 & 10\\end{aligned}] & {R}_{2} & :=-{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -5 & -5 \\\\ 0 & 1 & -10\\end{aligned}].\\end{aligned}\n$$\n\nThe system is now \n\n![](images/45/455dc49a531a371ea8aecd6259a677c8006bb2a23181ed66d27721135f240c89.svg)\n\nand we can apply back substitution. The final equation $y=-10$ tells us the value of $y.$ Substituting this value into the first equation, we get\n\n$$\nx-5(-10)=-5 \n\t\\quad\\Rightarrow\\quad\n\tx=-55.\n$$\n\nTherefore, the solution is $x=-55$ and $y=-10.$ Or, in vector form, $\\langle -55,-10 \\rangle.$"}] [{:db/id #edb/ref 17592186241149 :knowledge-point/_questions [{:db/id #edb/ref 17592186059775 :knowledge-point/id #uuid "a10cafc6-9da7-5ffc-a0c7-686a7638fbd9" :knowledge-point/title "Reducing a 2x2 Augmented Matrix to REF Using Gaussian Elimination"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d657c0d-5d97-537c-911b-9fadbaaa3670" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & -2 & -1 \\\\ 0 & 1 & \\frac{11}{16}\\end{aligned}]" :db/id #edb/ref 17592186238587} {:answer/id #uuid "3e408362-b837-5b32-9b36-33ac7e5b4610" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & -2 & -1 \\\\ 0 & 1 & \\frac{13}{16}\\end{aligned}]" :db/id #edb/ref 17592186238598} {:answer/id #uuid "6f45203e-09d8-57c8-83cd-c8f7658a36f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & -2 & -1 \\\\ 0 & 1 & \\frac{15}{16}\\end{aligned}]" :db/id #edb/ref 17592186239014} {:answer/id #uuid "b9791b07-a4eb-523d-9cf6-2317db471ade" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & -2 & -1 \\\\ 0 & 1 & \\frac{17}{16}\\end{aligned}]" :db/id #edb/ref 17592186239668} {:answer/id #uuid "f90e1648-976d-5da5-90a9-f26e2ffeb4ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & -2 & -1 \\\\ 0 & 1 & \\frac{9}{16}\\end{aligned}]" :db/id #edb/ref 17592186240258}] :answer-field/correct {:answer/id #uuid "3e408362-b837-5b32-9b36-33ac7e5b4610" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & -2 & -1 \\\\ 0 & 1 & \\frac{13}{16}\\end{aligned}]" :db/id #edb/ref 17592186238598} :answer-field/id #uuid "4a1bbeec-fbf0-53a7-9f8e-2c368383943e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240459}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "157d0b46-caa9-5e52-add3-341aa2ee9d01" :question/math-academy-id "q-1060" :question/problem "Consider the augmented matrix $M$ given by\n\n$$\nM=[\\begin{aligned}-1 & 2 & 1 \\\\ 5 & 6 & 8\\end{aligned}].\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form." :question/worked-solution "Reducing $M$ to row echelon form using the standard algorithm for Gaussian elimination, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}-1 & 2 & 1 \\\\ 5 & 6 & 8\\end{aligned}] & {R}_{1} & :=-1\\cdot {R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & -1 \\\\ 5 & 6 & 8\\end{aligned}] & {R}_{2} & :={R}_{2}-5\\cdot {R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & -1 \\\\ 0 & 16 & 13\\end{aligned}] & {R}_{2} & :=\\frac{1}{16}\\cdot {R}_{2} \\\\  & ∼[\\begin{aligned}1 & -2 & -1 \\\\ 0 & 1 & \\frac{13}{16}\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186388195 :knowledge-point/_questions [{:db/id #edb/ref 17592186059775 :knowledge-point/id #uuid "a10cafc6-9da7-5ffc-a0c7-686a7638fbd9" :knowledge-point/title "Reducing a 2x2 Augmented Matrix to REF Using Gaussian Elimination"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25d065ca-e03a-590b-8565-4aa796b3f85f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & -4 & 3 \\\\ 0 & 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186388197} {:answer/id #uuid "d7c367f9-0dd8-5eb2-bb63-b07c18fddbae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & -8 & 6 \\\\ 0 & 1 & -1\\end{aligned}]" :db/id #edb/ref 17592186388198} {:answer/id #uuid "d2f53d2d-3d78-590a-995b-7bd29edb89ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & 8 & -6 \\\\ 0 & 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186388199} {:answer/id #uuid "92579536-cb78-5a9d-9313-d30b90e25a2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & -4 & 3 \\\\ 0 & 1 & -1\\end{aligned}]" :db/id #edb/ref 17592186388200} {:answer/id #uuid "d9f89373-ace8-5a5d-ae8e-4a9ab6d34eda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & 4 & -3 \\\\ 0 & 1 & -1\\end{aligned}]" :db/id #edb/ref 17592186388201}] :answer-field/correct {:answer/id #uuid "92579536-cb78-5a9d-9313-d30b90e25a2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & -4 & 3 \\\\ 0 & 1 & -1\\end{aligned}]" :db/id #edb/ref 17592186388200} :answer-field/id #uuid "d7823cff-303e-53ab-9742-7a012bfe87c1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388196}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dc5530a8-d7bb-5ee6-b842-11178cec4e06" :question/math-academy-id "q-130909" :question/problem "Consider the augmented matrix $M$ given by\n\n$$\nM=[\\begin{aligned}2 & -8 & 6 \\\\ 3 & -7 & 4\\end{aligned}].\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form." :question/worked-solution "Reducing $M$ to row echelon form using the standard algorithm for Gaussian elimination, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}2 & -8 & 6 \\\\ 3 & -7 & 4\\end{aligned}] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -4 & 3 \\\\ 3 & -7 & 4\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & -4 & 3 \\\\ 0 & 5 & -5\\end{aligned}] & {R}_{2} & :=\\frac{1}{5}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -4 & 3 \\\\ 0 & 1 & -1\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393306 :knowledge-point/_questions [{:db/id #edb/ref 17592186059776 :knowledge-point/id #uuid "07abc1cc-5794-51a6-bad4-40565eae52be" :knowledge-point/title "Solving a 2x2 System of Equations Using Gaussian Elimination"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c7b08e6-d085-5aaa-8d73-b963955cfc39" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$M∼[\\begin{aligned}1 & -2 & 3 \\\\ 0 & 1 & -1\\end{aligned}],$\n$\\,x=1$ and $y=-1$" :db/id #edb/ref 17592186393308} {:answer/id #uuid "06300e64-ff4a-5f52-b477-8bb88f43f8a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$M∼[\\begin{aligned}1 & -2 & 3 \\\\ 0 & 1 & -2\\end{aligned}],$\n$\\,x=-1$ and $y=-2$" :db/id #edb/ref 17592186393309} {:answer/id #uuid "af523f5a-739c-5f31-b5eb-464880f8d7fb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$M∼[\\begin{aligned}1 & -2 & 3 \\\\ 0 & 1 & -4\\end{aligned}],$\n$\\,x=-5$ and $y=-4$" :db/id #edb/ref 17592186393310} {:answer/id #uuid "1b343ef7-3ddf-5c6c-94e7-03e5be9701c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$M∼[\\begin{aligned}1 & -2 & 3 \\\\ 0 & 1 & 2\\end{aligned}],$\n$\\,x=7$ and $y=2$" :db/id #edb/ref 17592186393311} {:answer/id #uuid "374d0aef-c48a-512b-ba16-2324cb201e02" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$M∼[\\begin{aligned}1 & -2 & 3 \\\\ 0 & 1 & 4\\end{aligned}],$\n$\\,x=11$ and $y=4$" :db/id #edb/ref 17592186393312}] :answer-field/correct {:answer/id #uuid "06300e64-ff4a-5f52-b477-8bb88f43f8a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$M∼[\\begin{aligned}1 & -2 & 3 \\\\ 0 & 1 & -2\\end{aligned}],$\n$\\,x=-1$ and $y=-2$" :db/id #edb/ref 17592186393309} :answer-field/id #uuid "de9973d7-7169-5172-bb3d-d4ad9a2d6a14" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393307}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4e51e1e1-f4ea-594e-af90-cfd7caef02c6" :question/math-academy-id "q-73544" :question/problem "Consider the system of linear equations\n\n$$\n{\\begin{aligned} & 2x-4y=6 \\\\  & 4x-7y=10.\\end{aligned}\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}2 & -4 & 6 \\\\ 4 & -7 & 10\\end{aligned}].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}2 & -4 & 6 \\\\ 4 & -7 & 10\\end{aligned}] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 3 \\\\ 4 & -7 & 10\\end{aligned}] & {R}_{2} & :={R}_{2}-4{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 3 \\\\ 0 & 1 & -2\\end{aligned}].\\end{aligned}\n$$\n\nThe system is now \n\n$$\n{\\begin{aligned} & x-2y=3 \\\\  & y=-2,\\end{aligned}\n$$\n\nand we can apply back substitution. The final equation $y=-2$ tells us the value of $y.$ Substituting this value into the first equation, we get\n\n$$\nx-2(-2)=3\\,⇒\\,x=-1.\n$$\n\nThus, the solution is $x=-1$ and $y=-2.$"}] [{:db/id #edb/ref 17592186414018 :knowledge-point/_questions [{:db/id #edb/ref 17592186059776 :knowledge-point/id #uuid "07abc1cc-5794-51a6-bad4-40565eae52be" :knowledge-point/title "Solving a 2x2 System of Equations Using Gaussian Elimination"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29b00cee-94fc-5ef4-95de-2345a02742de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & -4 & 5 \\\\ 0 & 1 & 4\\end{aligned}]" :db/id #edb/ref 17592186414012} {:answer/id #uuid "35507ba3-dc5e-5f36-bb3c-2cadb07fb8ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & -4 & 5 \\\\ 0 & 1 & -2\\end{aligned}]" :db/id #edb/ref 17592186414013} {:answer/id #uuid "632206dd-bb16-5704-9288-1e7bf08e0cfc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & -4 & 5 \\\\ 0 & 1 & 2\\end{aligned}]" :db/id #edb/ref 17592186414014} {:answer/id #uuid "7bad20ef-df3c-52d4-a10d-b7e2a38262ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & -4 & 5 \\\\ 0 & 1 & -4\\end{aligned}]" :db/id #edb/ref 17592186414015} {:answer/id #uuid "92cfbdd1-6bb8-5b06-89f2-6d7a9c5e7075" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & -4 & 5 \\\\ 0 & 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186414016}] :answer-field/correct {:answer/id #uuid "35507ba3-dc5e-5f36-bb3c-2cadb07fb8ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & -4 & 5 \\\\ 0 & 1 & -2\\end{aligned}]" :db/id #edb/ref 17592186414013} :answer-field/id #uuid "cae93ed5-7aca-5036-ae81-d4a677001210" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186414017}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "13eff08d-2b22-5094-8876-818462babb6f" :question/math-academy-id "q-73554" :question/problem "Consider the system of linear equations\n\n$$\n{\\begin{aligned} & 2x-8y=10 \\\\  & 3x-7y=5.\\end{aligned}\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}2 & -8 & 10 \\\\ 3 & -7 & 5\\end{aligned}].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}2 & -8 & 10 \\\\ 3 & -7 & 5\\end{aligned}] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -4 & 5 \\\\ 3 & -7 & 5\\end{aligned}] & {R}_{2} & :={R}_{2}-3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -4 & 5 \\\\ 0 & 5 & -10\\end{aligned}] & {R}_{2} & :=\\frac{1}{5}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -4 & 5 \\\\ 0 & 1 & -2\\end{aligned}].\\end{aligned}\n$$"}]}
