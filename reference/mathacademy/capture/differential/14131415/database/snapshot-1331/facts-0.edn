6120696 #edb/ref 17592186045417] [17592186120054 #edb/ref 1043 #edb/ref 17592186120697 #edb/ref 17592186045417] [17592186120054 #edb/ref 1043 #edb/ref 17592186120698 #edb/ref 17592186045417] [17592186120054 #edb/ref 1043 #edb/ref 17592186120756 #edb/ref 17592186045417] [17592186120054 #edb/ref 1043 #edb/ref 17592186120757 #edb/ref 17592186045417] [17592186120054 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186120054 #edb/ref 1045 "Expressing the Coordinates of a Vector in a Given Basis" #edb/ref 17592186045417] [17592186120054 #edb/ref 1046 #edb/ref 17592186120695 #edb/ref 17592186045417] [17592186120054 #edb/ref 1049 #edb/ref 17592186050638 #edb/ref 17592186045417] [17592186120054 #edb/ref 1050 900.0 #edb/ref 17592186045417] [17592186120054 #edb/ref 1053 #uuid "ad4d6410-a365-5f77-a4b1-3e2d134d5a3d" #edb/ref 17592186045417] [17592186120358 #edb/ref 1068 #edb/ref 17592186318899 #edb/ref 17592186045417] [17592186120358 #edb/ref 1069 "q-34764" #edb/ref 17592186045417] [17592186120358 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186120358 #edb/ref 1071 "Find the coordinates of the vector $x$ relative to the basis $B=\\{{b}_{1},{b}_{2},{b}_{3}\\},$ where\n\n$$\n{b}_{1}=[\\begin{aligned}1 \\\\ -1 \\\\ 2 \\\\ 0\\end{aligned}],\\,{b}_{2}=[\\begin{aligned}2 \\\\ 0 \\\\ 0 \\\\ 4\\end{aligned}],\\,{b}_{3}=[\\begin{aligned}0 \\\\ 0 \\\\ -1 \\\\ 0\\end{aligned}],\\,x=[\\begin{aligned}2 \\\\ 2 \\\\ -5 \\\\ 4\\end{aligned}].\n$$\n\nIf $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]$ then what is the value of ${x}_{1}+{x}_{2}+{x}_{3}?$" #edb/ref 17592186045417] [17592186120358 #edb/ref 1072 #uuid "127eef35-0ba2-54bf-857c-c0aaa600443a" #edb/ref 17592186045417] [17592186120358 #edb/ref 1074 "We need to find ${x}_{1}$,  ${x}_{2}$, and ${x}_{3}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2}+{x}_{3}{b}_{3} & =x \\\\ {x}_{1}[\\begin{aligned}1 \\\\ -1 \\\\ 2 \\\\ 0\\end{aligned}]+{x}_{2}[\\begin{aligned}2 \\\\ 0 \\\\ 0 \\\\ 4\\end{aligned}]+{x}_{3}[\\begin{aligned}0 \\\\ 0 \\\\ -1 \\\\ 0\\end{aligned}] & =[\\begin{aligned}2 \\\\ 2 \\\\ -5 \\\\ 4\\end{aligned}]\\end{aligned}\n$$\n\nFrom this, we get the system with the augmented matrix $M$, which we reduce using Gaussian elimination:\n\n$$\n\\begin{aligned}M= & [\\begin{aligned}1 & 2 & 0 & 2 \\\\ -1 & 0 & 0 & 2 \\\\ 2 & 0 & -1 & -5 \\\\ 0 & 4 & 0 & 4\\end{aligned}] & {R}_{2} & :={R}_{2}+{R}_{1} \\\\ ∼ & [\\begin{aligned}1 & 2 & 0 & 2 \\\\ 0 & 2 & 0 & 4 \\\\ 2 & 0 & -1 & -5 \\\\ 0 & 4 & 0 & 4\\end{aligned}] & {R}_{3} & :={R}_{3}+(-2){R}_{1} \\\\ ∼ & [\\begin{aligned}1 & 2 & 0 & 2 \\\\ 0 & 2 & 0 & 4 \\\\ 0 & -4 & -1 & -9 \\\\ 0 & 4 & 0 & 4\\end{aligned}] & {R}_{3} & :={R}_{3}+2{R}_{2} \\\\ ∼ & [\\begin{aligned}1 & 2 & 0 & 2 \\\\ 0 & 2 & 0 & 4 \\\\ 0 & 0 & -1 & -1 \\\\ 0 & 4 & 0 & 4\\end{aligned}] & {R}_{4} & :={R}_{4}+(-2){R}_{2} \\\\ ∼ & [\\begin{aligned}1 & 2 & 0 & 2 \\\\ 0 & 2 & 0 & 4 \\\\ 0 & 0 & -1 & -1 \\\\ 0 & 0 & 0 & -4\\end{aligned}]\\end{aligned}\n$$\n\n \nThe system is now \n\n$$\n\\{\\begin{aligned}{x}_{1}+2{x}_{2}=2 \\\\ 2{x}_{2}=4 \\\\ -{x}_{3}=-1 \\\\ 0=4,\\end{aligned}\n$$\n\nwhere the fourth equation is always false. Therefore, the system has no solution and we conclude that \n\n$$\nx\\notin \\text{Span}\\{{b}_{1},{b}_{2},{b}_{3}\\}.\n$$" #edb/ref 17592186045417] [17592186120379 #edb/ref 1068 #edb/ref 17592186118388 #edb/ref 17592186045417] [17592186120379 #edb/ref 1069 "q-35232" #edb/ref 17592186045417] [17592186120379 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186120379 #edb/ref 1071 "Find the vector $x$, if $B=\\{{b}_{1},{b}_{2}\\}$ is a basis of $\\text{Span}\\{{b}_{1},{b}_{2}\\},$ and \n\n$$\n{b}_{1}=[\\begin{aligned}3 \\\\ -2 \\\\ 3\\end{aligned}],\\,{b}_{2}=[\\begin{aligned}5 \\\\ 3 \\\\ 4\\end{aligned}],\\,[x]_{B}=[\\begin{aligned}-3 \\\\ 5\\end{aligned}].\n$$" #edb/ref 17592186045417] [17592186120379 #edb/ref 1072 #uuid "fd151813-8e78-53b9-b9c5-57f0cca18b33" #edb/ref 17592186045417] [17592186120379 #edb/ref 1074 "We know that any vector in  $\\text{Span}\\{{b}_{1},{b}_{2}\\}$ has the form\n\n$$\n\\begin{aligned}{x}_{1}[\\begin{aligned}3 \\\\ -2 \\\\ 3\\end{aligned}]+{x}_{2}[\\begin{aligned}5 \\\\ 3 \\\\ 4\\end{aligned}]\\end{aligned}\n$$\n\nwhere ${x}_{1}$ and ${x}_{2}$ are the coordinates relative to the basis $\\,B.$ Since we are told that $[x]_{B}=[\\begin{aligned}-3 \\\\ 5\\end{aligned}],$ we obtain\n\n$$\n\\begin{aligned}x & ={{(\\,-3\\,)}_{⏟}}_{{x}_{1}}[\\begin{aligned}3 \\\\ -2 \\\\ 3\\end{aligned}]+{{(\\,5\\,)}_{⏟}}_{{x}_{2}}[\\begin{aligned}5 \\\\ 3 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}-9 \\\\ 6 \\\\ -9\\end{aligned}]+[\\begin{aligned}25 \\\\ 15 \\\\ 20\\end{aligned}] \\\\  & =[\\begin{aligned}16 \\\\ 21 \\\\ 11\\end{aligned}].\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186120695 #edb/ref 1058 #edb/ref 17592186120696 #edb/ref 17592186045417] [17592186120695 #edb/ref 1061 17513 #edb/ref 17592186045417] [17592186120695 #edb/ref 1062 #uuid "55354f89-d587-5329-9788-b198ebb218a3" #edb/ref 17592186045417] [17592186120695 #edb/ref 1063 #edb/ref 17592186121042 #edb/ref 17592186045417] [17592186120696 #edb/ref 1058 #edb/ref 17592186120757 #edb/ref 17592186045417] [17592186120696 #edb/ref 1061 17514 #edb/ref 17592186045417] [17592186120696 #edb/ref 1062 #uuid "b2734184-6a42-50f6-9a19-566236b06025" #edb/ref 17592186045417] [17592186120696 #edb/ref 1063 #edb/ref 17592186119820 #edb/ref 17592186045417] [17592186120697 #edb/ref 1058 #edb/ref 17592186120698 #edb/ref 17592186045417] [17592186120697 #edb/ref 1061 17515 #edb/ref 17592186045417] [17592186120697 #edb/ref 1062 #uuid "94aa1ebf-d415-58aa-a0dc-17e8201c1669" #edb/ref 17592186045417] [17592186120697 #edb/ref 1063 #edb/ref 17592186119821 #edb/ref 17592186045417] [17592186120698 #edb/ref 1058 #edb/ref 17592186120756 #edb/ref 17592186045417] [17592186120698 #edb/ref 1061 17516 #edb/ref 17592186045417] [17592186120698 #edb/ref 1062 #uuid "34b75a42-9505-5418-a27f-2b9aade2bc07" #edb/ref 17592186045417] [17592186120698 #edb/ref 1063 #edb/ref 17592186119822 #edb/ref 17592186045417] [17592186120756 #edb/ref 1061 23574 #edb/ref 17592186045417] [17592186120756 #edb/ref 1062 #uuid "9053925c-8744-5312-b890-f5e4a1a8d2e8" #edb/ref 17592186045417] [17592186120756 #edb/ref 1063 #edb/ref 17592186121066 #edb/ref 17592186045417] [17592186120757 #edb/ref 1058 #edb/ref 17592186120697 #edb/ref 17592186045417] [17592186120757 #edb/ref 1061 23612 #edb/ref 17592186045417] [17592186120757 #edb/ref 1062 #uuid "79095f38-ffd3-565b-a534-f136c7646422" #edb/ref 17592186045417] [17592186120757 #edb/ref 1063 #edb/ref 17592186119859 #edb/ref 17592186045417] [17592186121042 #edb/ref 1064 "Given a subspace $H$ with a basis $\\mathcal B = \\{ \\mathbf b_1, \\mathbf b_2 \\}$ and a vector $\\mathbf x \\in H,$ the **coordinates of the vector** $\\mathbf{x}$ **relative to the basis** $\\mathcal{B}$ are the coefficients ${\\color{red} x_1}$ and ${\\color{blue} x_2}$ such that\n\n$$\n{\\color{red}x_1} \\mathbf{b}_1+{\\color{blue}x_2} \\mathbf{b}_2 = \\mathbf{x}.\n$$\n\nWe can write the vector $\\mathbf x$ relative to the basis $\\mathcal B$ using these coordinates, as follows:\n\n![](images/05/0593ca6a838b66c4623e8749eb5236d6259b1f9bf36ed0d68b83c49781076341.svg)\n\nTo demonstrate, consider the basis $\\mathcal{B}=\\{ \\mathbf{b}_1, \\mathbf{b}_2 \\},$ where \n\n![](images/f3/f355faa0c477775f2a1cbb3522d0743cdbc9649a5ee9c55b579b1fac9ae2a661.svg)\n\nAlso let $H = \\textrm{span} \\{ \\mathbf b_1, \\mathbf b_2 \\},$ and consider the vector ![](images/78/78357fcf51c9cd6b7873f5bc35fcc214cb3790bcec00ee69d0932f15aacd39cb.svg)\n\nThe vector $\\mathbf x$ can be expressed as a unique linear combination of $\\mathbf b_1$ and $\\mathbf b_2.$ That is to say, there exist *unique coefficients* $\\color{red}x_1$ and $\\color{blue}x_2$ such that\n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2} & =x \\\\ {x}_{1}[\\begin{aligned}2 \\\\ 0 \\\\ 0\\end{aligned}]+{x}_{2}[\\begin{aligned}1 \\\\ 2 \\\\ 0\\end{aligned}] & =[\\begin{aligned}8 \\\\ 4 \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\nLet's solve for these coefficients. From the above, we get the following system:\n\n$$\n\\{\\begin{aligned}2{x}_{1}+{x}_{2}=8 \\\\ 2{x}_{2}=4\\end{aligned}\n$$\n\nThe unique solution of this system is \n\n![](images/82/82d4f494936d23e9b697aa4518edf68f7ea62e504d9d2576a6d13971acaf1c96.svg)\n\nTherefore, we have that \n\n$$\n\\mathbf{x} = {\\color{red}3} \\mathbf{b}_1+ {\\color{blue}2} \\mathbf{b}_2,\n$$\n\nwhich can be visualized as shown below.\n\n![](images/94/94b2934727a32284e9790e59ccd301bd858a0258843314a2968285a5eda7a302.png)" #edb/ref 17592186045417] [17592186121042 #edb/ref 1065 3208 #edb/ref 17592186045417] [17592186121042 #edb/ref 1066 #uuid "bb4f07e6-7c2f-5fe2-b96b-1bb37603981a" #edb/ref 17592186045417] [17592186121042 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186121066 #edb/ref 1064 "Let's consider a set of vectors\n![](images/0d/0d78e1b2d01003885882f19b3856278e5024719f26f33594fd071fbd73273b71.svg)\n\nNotice that the set $\\mathcal{S}$ is linearly independent since the vector equation $x_1\\mathbf{e}_1+x_2\\mathbf{e}_2+x_3\\mathbf{e}_3=\\mathbf{0}$ leads to the system\n\n$$\n\\{\\begin{aligned}{x}_{1}=0 \\\\ {x}_{2}=0 \\\\ {x}_{3}=0,\\end{aligned}\n$$\n\nwhich has only the zero solution. \n\nAlso, notice that any vector in $\\mathbb{R}^3$ can be written as a linear combination of $\\mathbf{e}_1,$ $\\mathbf{e}_2,$ and $\\mathbf{e}_3.$ For instance,\n![](images/ef/ef28dd8cbad6d256b9fa82c487263af3327ce630839cfcd1c7433417d0e0ae73.svg)\n\nIn particular, the equation above tells us that \n![](images/72/724f42afb534edbde7588c5508a4bf8de6d3cd068bc2989da7c7207b1bf7a1ba.svg)\nthat is to say, the numbers $\\color{red}-2,$ $\\color{red}0,$ $\\color{red}5$ are the coordinates of $\\mathbf{v}$ relative to the basis $\\mathcal{S}.$ \n\nThe basis $\\mathcal{S}$ is somewhat special, since the coordinates of a vector relative to this basis coincide with the components of the vector. We refer to $\\mathcal{S}$ as the **standard basis**. Remember that in $\\mathbb{R}^2$ and $\\mathbb{R}^3$ we even have special notations for the vectors of the standard basis:\n![](images/ae/aee5dd3226ebe950defc8b873399a884e0679ce701a3a55354ef01960e029f8e.svg)\n\n![](images/dd/dd96e0b70173adf8983feb4975c351ab3e417c34ed4a6a944bc391e33db4c8e9.png)\n\nIn general, the standard basis of $\\mathbb{R}^n$ is\n\n![](images/a8/a8e4b648898c0dc036e228fb84945833dc40c053beff034596e098c4dd077e23.svg)" #edb/ref 17592186045417] [17592186121066 #edb/ref 1065 3969 #edb/ref 17592186045417] [17592186121066 #edb/ref 1066 #uuid "54e7c1fd-c7bf-5c77-bcc5-eb8d93a11582" #edb/ref 17592186045417] [17592186121066 #edb/ref 1067 "The Standard Basis" #edb/ref 17592186045417] [17592186244889 #edb/ref 1080 "8" #edb/ref 17592186045417] [17592186244889 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186244889 #edb/ref 1083 #uuid "41cb02b9-13f3-5f1d-bb94-34c18d18a3a3" #edb/ref 17592186045417] [17592186245216 #edb/ref 1080 "2" #edb/ref 17592186045417] [17592186245216 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186245216 #edb/ref 1083 #uuid "6641cc50-250b-56ad-b14a-c1124ec8c662" #edb/ref 17592186045417] [17592186245269 #edb/ref 1080 "3" #edb/ref 17592186045417] [17592186245269 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186245269 #edb/ref 1083 #uuid "6bdc01cf-2d88-5f1d-918a-b6b8c908df28" #edb/ref 17592186045417] [17592186245272 #edb/ref 1080 "-2" #edb/ref 17592186045417] [17592186245272 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186245272 #edb/ref 1083 #uuid "6c86a8e6-6f85-5aa5-ae6d-29029bdec356" #edb/ref 17592186045417] [17592186245311 #edb/ref 1080 "6" #edb/ref 17592186045417] [17592186245311 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186245311 #edb/ref 1083 #uuid "6fd41642-b280-5a7c-b432-e2ff0d315b3a" #edb/ref 17592186045417] [17592186245422 #