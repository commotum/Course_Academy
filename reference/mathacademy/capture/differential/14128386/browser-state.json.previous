mo><mo>+</mo><mn>2</mn><mi>x</mi><mi>csc</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mi>sec</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi></math></mjx-assistive-mml></mjx-container>"
            },
            {
              "option": "b",
              "dom_id": "questionWidget-choiceLetterCircle-138851-b",
