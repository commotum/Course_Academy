7] [17592186443257 #edb/ref 1080 "\\frac{20}{3}" #edb/ref 17592186045417] [17592186443257 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186443257 #edb/ref 1083 #uuid "d7d5ba1e-9709-5d81-81a8-a2db338b2a56" #edb/ref 17592186045417] [17592186443259 #edb/ref 1080 "6" #edb/ref 17592186045417] [17592186443259 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186443259 #edb/ref 1083 #uuid "e134b035-3648-5a34-a02a-44af5b1b5f73" #edb/ref 17592186045417] [17592186443261 #edb/ref 1075 #edb/ref 17592186443241 #edb/ref 17592186045417] [17592186443261 #edb/ref 1075 #edb/ref 17592186443242 #edb/ref 17592186045417] [17592186443261 #edb/ref 1075 #edb/ref 17592186443246 #edb/ref 17592186045417] [17592186443261 #edb/ref 1075 #edb/ref 17592186443253 #edb/ref 17592186045417] [17592186443261 #edb/ref 1075 #edb/ref 17592186443254 #edb/ref 17592186045417] [17592186443261 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186443261 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186443261 #edb/ref 1078 #edb/ref 17592186443241 #edb/ref 17592186045417] [17592186443261 #edb/ref 1079 #uuid "161dc5e7-caef-534f-b118-60aceff59caf" #edb/ref 17592186045417] [17592186443263 #edb/ref 1075 #edb/ref 17592186443244 #edb/ref 17592186045417] [17592186443263 #edb/ref 1075 #edb/ref 17592186443252 #edb/ref 17592186045417] [17592186443263 #edb/ref 1075 #edb/ref 17592186443256 #edb/ref 17592186045417] [17592186443263 #edb/ref 1075 #edb/ref 17592186443257 #edb/ref 17592186045417] [17592186443263 #edb/ref 1075 #edb/ref 17592186443259 #edb/ref 17592186045417] [17592186443263 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186443263 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186443263 #edb/ref 1078 #edb/ref 17592186443256 #edb/ref 17592186045417] [17592186443263 #edb/ref 1079 #uuid "3647b522-cc39-5b80-86fd-13996ce4e48f" #edb/ref 17592186045417] [17592186443265 #edb/ref 1068 #edb/ref 17592186443261 #edb/ref 17592186045417] [17592186443265 #edb/ref 1069 "q-129126" #edb/ref 17592186045417] [17592186443265 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186443265 #edb/ref 1071 "Find the shortest distance between the point $P(-3,4,7)$ and the plane $Π$ with equation $r\\cdot ⟨-3,1,1⟩=9.$" #edb/ref 17592186045417] [17592186443265 #edb/ref 1072 #uuid "072e9e45-d148-5a1a-9029-08725d744a80" #edb/ref 17592186045417] [17592186443265 #edb/ref 1074 "First, we need to find a point on the plane. If $r=⟨x,y,z⟩,$ we obtain\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨-3,1,1⟩ & =9 \\\\ -3x+y+z & =9 \\\\ z & =9+3x-y.\\end{aligned}\n$$\n\nSetting $x=1$ and $y=1,$ we get \n\n$$\nz=9+3(1)-(1)=11.\n$$\n\nSo, the point $Q(1,1,11)$ lies on the plane. \n\nNow, we find\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨1,1,11⟩-⟨-3,4,7⟩ \\\\  & =⟨4,-3,4⟩.\\end{aligned}\n$$\n\nFrom the equation of a plane, we get a normal vector $n=⟨-3,1,1⟩.$\n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|4\\cdot (-3)+(-3)\\cdot 1+4\\cdot 1|}{\\sqrt{(-3)^{2}+{1}^{2}+{1}^{2}}} \\\\  & =\\frac{|-12-3+4|}{\\sqrt{9+1+1}} \\\\  & =\\frac{|-11|}{\\sqrt{11}} \\\\  & =\\frac{11}{\\sqrt{11}} \\\\  & =\\sqrt{11}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186443268 #edb/ref 1068 #edb/ref 17592186443263 #edb/ref 17592186045417] [17592186443268 #edb/ref 1069 "q-129142" #edb/ref 17592186045417] [17592186443268 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186443268 #edb/ref 1071 "Find the shortest distance between the point $P(-3,2,6)$ and the plane $Π$ with equation $r\\cdot ⟨-2,4,4⟩=8.$" #edb/ref 17592186045417] [17592186443268 #edb/ref 1072 #uuid "ee5f2c99-4524-5cc2-872a-3bdd6d04d82a" #edb/ref 17592186045417] [17592186443268 #edb/ref 1074 "First, we need to find a point on the plane. If $r=⟨x,y,z⟩,$ we obtain\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨-2,4,4⟩ & =8 \\\\ -2x+4y+4z & =8 \\\\ 4z & =8+2x-4y \\\\ z & =2+\\frac{x}{2}-y.\\end{aligned}\n$$\n\nSetting $x=2$ and $y=1,$ we get \n\n$$\nz=2+\\frac{2}{2}-1=2.\n$$\n\nSo, the point $Q(2,1,2)$ lies on the plane. \n\nNow, we find\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨2,1,2⟩-⟨-3,2,6⟩ \\\\  & =⟨5,-1,-4⟩.\\end{aligned}\n$$\n\nFrom the equation of a plane, we get a normal vector $n=⟨-2,4,4⟩.$\n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|5\\cdot (-2)+(-1)\\cdot 4+(-4)\\cdot 4|}{\\sqrt{(-2)^{2}+{4}^{2}+{4}^{2}}} \\\\  & =\\frac{|-10-4-16|}{\\sqrt{4+16+16}} \\\\  & =\\frac{|-30|}{\\sqrt{36}} \\\\  & =\\frac{30}{6} \\\\  & =5.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186476200 #edb/ref 1043 #edb/ref 17592186476980 #edb/ref 17592186045417] [17592186476200 #edb/ref 1043 #edb/ref 17592186476984 #edb/ref 17592186045417] [17592186476200 #edb/ref 1043 #edb/ref 17592186476987 #edb/ref 17592186045417] [17592186476200 #edb/ref 1043 #edb/ref 17592186476996 #edb/ref 17592186045417] [17592186476200 #edb/ref 1043 #edb/ref 17592186477001 #edb/ref 17592186045417] [17592186476200 #edb/ref 1044 #edb/ref 17592186045464 #edb/ref 17592186045417] [17592186476200 #edb/ref 1045 "The Shortest Distance Between a Plane and a Point" #edb/ref 17592186045417] [17592186476200 #edb/ref 1046 #edb/ref 17592186477001 #edb/ref 17592186045417] [17592186476200 #edb/ref 1048 #edb/ref 17592186046659 #edb/ref 17592186045417] [17592186476200 #edb/ref 1049 #edb/ref 17592186049322 #edb/ref 17592186045417] [17592186476200 #edb/ref 1053 #uuid "607e9414-4918-5745-b10c-99f76f09cb79" #edb/ref 17592186