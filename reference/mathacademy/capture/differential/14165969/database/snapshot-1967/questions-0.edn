field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186490206}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "aa05eb09-9ab6-5ac2-b2dd-bab3e1656e0c" :question/math-academy-id "q-223782" :question/problem "![](images/0c/0c18987fb16fc67df39e9887f152b2c6f38649b58e4bf469c80feb908eded8d2.png)\n\nWhat is the range of the function $f(x),$ shown above?\n\n{{field-1}}\n$<\\,f(x)$\n{{field-2}}{{field-3}}" :question/worked-solution "First, we find the lowest and highest $y$-values in the graph.\n\n- The lowest $y$-value is $2.$ This occurs at the point $(2,2).$\n\n- The highest $y$-value is $6.$ This occurs at the point $(-2,6).$\n\nThe function covers all the $y$-values between $2$ and $6,$ but not including $2$ nor $6.$\n\nTherefore, the range is $2<y<6,$ which can also be written as $2<f(x)<6.$"}] [{:db/id #edb/ref 17592186490248 :knowledge-point/_questions [{:db/id #edb/ref 17592186083179 :knowledge-point/id #uuid "7d3796fa-e911-5553-83c2-24c98370e4ea" :knowledge-point/title "Identifying a Function's Range From a Table"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fc1138d-b64d-5082-89d9-b3b84611ecfa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\infty ,5.25]" :db/id #edb/ref 17592186489588} {:answer/id #uuid "3fd3ec45-844e-5d7b-9b80-178c7ce40b0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{29.25,15,11.25,3,0,-1,5.25\\}" :db/id #edb/ref 17592186489662} {:answer/id #uuid "4eabe352-2553-5b7c-855b-8e81885bb9b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(29.25,5.25)" :db/id #edb/ref 17592186489700} {:answer/id #uuid "80662819-e21b-5a80-b6b5-cdd6e678d445" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[29.25,5.25]" :db/id #edb/ref 17592186489806} {:answer/id #uuid "9703411c-630f-5902-bc32-abff536bb656" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{29.25,15,11.25,3,-1,5.25\\}" :db/id #edb/ref 17592186489852}] :answer-field/correct {:answer/id #uuid "3fd3ec45-844e-5d7b-9b80-178c7ce40b0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{29.25,15,11.25,3,0,-1,5.25\\}" :db/id #edb/ref 17592186489662} :answer-field/id #uuid "25d2ead3-cfcb-5726-b6ad-7e3e0645bcae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490091}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4f0badb4-976a-5d37-8143-b285dc344b75" :question/math-academy-id "q-34817" :question/problem "What is the range of the function $f$ defined by the following table?\n\n| $x$ | $-4.5$ | $-3$ | $-2.5$ | $-1$ | $0$ | $1$ | $2$ | $3.5$ |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $29.25$ | $15$ | $11.25$ | $3$ | $0$ | $-1$ | $0$ | $5.25$ |" :question/worked-solution "The range of $f(x)$ consists of all the outputs that have a corresponding $x$-input.\n\nIn a table, the range consists of all numbers that feature in the row corresponding to $f(x).$\n\nTherefore, the range is the set $\\{29.25,15,11.25,3,0,-1,5.25\\}.$"}] [{:db/id #edb/ref 17592186490294 :knowledge-point/_questions [{:db/id #edb/ref 17592186083179 :knowledge-point/id #uuid "7d3796fa-e911-5553-83c2-24c98370e4ea" :knowledge-point/title "Identifying a Function's Range From a Table"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14c41c16-9803-55fa-a5ea-e27f258697f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-4,-3,-2,-1,0\\}" :db/id #edb/ref 17592186489560} {:answer/id #uuid "3a1175ce-ad9d-5809-b45e-508cf644005e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{1,2,3\\}" :db/id #edb/ref 17592186489646} {:answer/id #uuid "a4078208-f82f-58ea-a06a-9183c0a39a85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{1,2,3,4\\}" :db/id #edb/ref 17592186489880} {:answer/id #uuid "b0685845-823d-5102-8576-378e2adb4ec5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{0,1,2,3\\}" :db/id #edb/ref 17592186489900} {:answer/id #uuid "e4ae3fc3-cd5c-5fd4-9466-6ba1a8dc3f8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-4,-3,-2,-1,0,1,2,3\\}" :db/id #edb/ref 17592186490011}] :answer-field/correct {:answer/id #uuid "a4078208-f82f-58ea-a06a-9183c0a39a85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{1,2,3,4\\}" :db/id #edb/ref 17592186489880} :answer-field/id #uuid "abdc0fd2-3497-5511-9719-4d38e8827235" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490170}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b868c541-58e5-5131-8ec5-c685d5ff37ca" :question/math-academy-id "q-54965" :question/problem "What is the range of the function $f$ defined by the following table?\n\n| $x$ | $-4$ | $-3$ | $-2$ | $-1$ | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $1$ | $2$ | $3$ | $2$ | $1$ | $2$ | $3$ | $4$ |" :question/worked-solution "The range of $f(x)$ consists of all the outputs that have a corresponding $x$-input.\n\nIn a table, the range consists of all numbers that feature in the row corresponding to $f(x).$\n\nTherefore, the range is the set $\\{1,2,3,4\\}.$"}] [{:db/id #edb/ref 17592186490280 :knowledge-point/_questions [{:db/id #edb/ref 17592186083180 :knowledge-point/id #uuid "f4d624bf-dfd2-5910-a5a6-c72352e76e40" :knowledge-point/title "Identifying a Function's Range From a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b4f4007-9614-5c27-86dc-5b6c8f4e5221" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0<f(x)\\le 4" :db/id #edb/ref 17592186489576} {:answer/id #uuid "3c9e33fa-f145-5c62-8aba-4b06a341ec87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1<f(x)\\le 3" :db/id #edb/ref 17592186489652} {:answer/id #uuid "88bd4100-5b4f-5acb-9ca3-94b61db3e012" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0<f(x)<4" :db/id #edb/ref 17592186489828} {:answer/id #uuid "9143cb9d-1e7b-5d6c-826e-9e30878041d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\ge 0" :db/id #edb/ref 17592186489843} {:answer/id #uuid "b49f81b1-bee6-52ee-8ec8-c7969c90282b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)>0" :db/id #edb/ref 17592186489911}] :answer-field/correct {:answer/id #uuid "1b4f4007-9614-5c27-86dc-5b6c8f4e5221" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0<f(x)\\le 4" :db/id #edb/ref 17592186489576} :answer-field/id #uuid "eb48cbc4-341a-5740-83c8-b736e21b49ff" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490199}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9ea4d21a-4360-5351-8a08-59d8247080d9" :question/math-academy-id "q-6844" :question/problem "![](images/2c/2c12cd35e66acc00de926a2375460242e46f359548a5112f0d87654485ba9a42.png)\n\nWhat is the range of the function $f(x),$ shown above?" :question/worked-solution "First, we find the lowest and highest $y$-values in the graph.\n\n- The lowest $y$-value is $0.$ This occurs at the point $(-1,0).$ However note that this point is not actually included in the graph.\n\n- The highest $y$-value is $4.$ This occurs at the point $(3,4).$\n\nThe function covers all the $y$-values between $0$ and $4,$ including $4$ but not including $0.$\n\nTherefore, the range is $0<y\\le 4,$ which can also be written as  $0<f(x)\\le 4.$"}] [{:db/id #edb/ref 17592186490237 :knowledge-point/_questions [{:db/id #edb/ref 17592186083179 :knowledge-point/id #uuid "7d3796fa-e911-5553-83c2-24c98370e4ea" :knowledge-point/title "Identifying a Function's Range From a Table"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0663c337-1271-56f3-bbc1-7801324d950a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,8)" :db/id #edb/ref 17592186489527} {:answer/id #uuid "59fa25b2-7ea0-5451-9577-044908cbf4b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-3,4,5,8\\}" :db/id #edb/ref 17592186489734} {:answer/id #uuid "728a8336-fa69-5dc3-9980-645b06c7081a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-3,8\\}" :db/id #edb/ref 17592186489782} {:answer/id #uuid "84c00d66-7ff1-5312-bc22-95db44f19e2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\frac{3}{2},8)" :db/id #edb/ref 17592186489818} {:answer/id #uuid "cb7373de-854a-513c-b9f1-1eaeb8612bff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-3,\\frac{3}{2},4,5,8\\}" :db/id #edb/ref 17592186489961}] :answer-field/correct {:answer/id #uuid "cb7373de-854a-513c-b9f1-1eaeb8612bff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-3,\\frac{3}{2},4,5,8\\}" :db/id #edb/ref 17592186489961} :answer-field/id #uuid "7c0d37ee-e575-5337-97f1-9a2aaec2c86a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490143}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3945419b-cbc3-5382-8a24-c717f52753bb" :question/math-academy-id "q-79265" :question/problem "What is the range of the function $f$ defined by the following table?\n\n| $x$ | $-9$ | $-7$ | $-5$ | $-3$ | $0$ | $\\frac{1}{2}$ | $\\frac{3}{2}$ | $\\frac{5}{2}$ |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $\\frac{3}{2}$ | $-3$ | $5$ | $8$ | $4$ | $\\frac{3}{2}$ | $-3$ | $4$ |" :question/worked-solution "The range of $f(x)$ consists of all the outputs that have a corresponding $x$-input.\n\nIn a table, the range consists of all numbers that feature in the row corresponding to $f(x).$\n\nTherefore, the range is the set $\\{-3,\\frac{3}{2},4,5,8\\}.$"}]}
