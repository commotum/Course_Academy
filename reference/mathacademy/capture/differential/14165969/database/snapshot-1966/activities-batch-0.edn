#{[{:activity/first-step {:db/id #edb/ref 17592186084040} :activity/id #uuid "3329496d-4743-5f4d-aa65-19187c9c8e23" :activity/scope {:db/id #edb/ref 17592186049707 :topic/id #uuid "0d118f55-a6b1-5729-9c06-3dbae669ed79" :topic/math-academy-id 754} :activity/steps [{:db/id #edb/ref 17592186084040 :step/content {:db/id #edb/ref 17592186084518 :tutorial/content "The **range** of a function is the collection of numbers (or set) containing all the function's outputs.\n\nConsider the function $f(x)$, defined by the mapping diagram below.\n\n![](images/60/60ae5361f9f51bb7e61083269770ee3dd432e04ad2f968df07d78c8dc61e7188.png)\n\nIn a mapping diagram, the range consists of all the outputs to which an arrow is drawn. Therefore, the range is\n\n$$\n\\{-1,2,3 \\}\n$$\n\nThe value $y=0$ is not part of the range because there is no $x$-value such that\n\n$$\nf(x) = 0\n$$" :tutorial/id #uuid "a6969f16-6b56-552e-8162-ba459b815dc6" :tutorial/math-academy-id 8799 :tutorial/title "Introduction"} :step/id #uuid "2642b03f-30f8-5a73-8a08-f51f7b592baf" :step/math-academy-id 150950 :step/next {:db/id #edb/ref 17592186084041}} {:db/id #edb/ref 17592186084041 :step/content {:db/id #edb/ref 17592186083178 :knowledge-point/canonical-example {:db/id #edb/ref 17592186082939 :question/id #uuid "9e732b25-cc9a-5a1a-b6d8-3502495a7fe4" :question/math-academy-id "e-14165"} :knowledge-point/id #uuid "390282db-587c-5b6c-a051-f62e4092bb0a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048838} {:db/id #edb/ref 17592186049072}] :knowledge-point/questions [{:db/id #edb/ref 17592186083661} {:db/id #edb/ref 17592186083677} {:db/id #edb/ref 17592186489261}] :knowledge-point/title "Identifying a Function's Range From a Mapping Diagram"} :step/id #uuid "4f14b6dd-48cf-50bf-9faa-ac12c6ebb738" :step/math-academy-id 150951 :step/next {:db/id #edb/ref 17592186084042}} {:db/id #edb/ref 17592186084042 :step/content {:db/id #edb/ref 17592186083179 :knowledge-point/canonical-example {:db/id #edb/ref 17592186082940 :question/id #uuid "0b107cc8-8085-57b4-b194-9adc02698826" :question/math-academy-id "e-14170"} :knowledge-point/id #uuid "7d3796fa-e911-5553-83c2-24c98370e4ea" :knowledge-point/questions [{:db/id #edb/ref 17592186083515} {:db/id #edb/ref 17592186083936} {:db/id #edb/ref 17592186488258} {:db/id #edb/ref 17592186488281} {:db/id #edb/ref 17592186489181}] :knowledge-point/title "Identifying a Function's Range From a Table"} :step/id #uuid "5f681af9-5dd3-5ccc-8663-eb8759acc874" :step/math-academy-id 150954 :step/next {:db/id #edb/ref 17592186084043}} {:db/id #edb/ref 17592186084043 :step/content {:db/id #edb/ref 17592186084519 :tutorial/content "When we graph a function, the range is the set of all $y$-values given by the graph.\n\nFor example, consider the linear function\n\n$$\nf(x) = 2x\n$$\n\ngraphed below.\n\n![](images/09/09716693ba950bd3d14d0ea008dbd9d99dc51a26f30e87ccbf1559f34329fed9.png)\n\nThe graph covers all $y$-values, so the range of the function is\n\n$$\n-\\infty < y< \\infty\n$$\n\nwhich we can also write as\n$-\\infty < f(x) < \\infty$.\n\nFurthermore, we can express the range as $f(x)\\in (-\\infty,\\infty)$ using interval notation.\n\nIf we restrict the domain, the range also changes. Let's now consider the function\n\n$$\ng(x) = 2x, \\quad x \\in [0,2)\n$$\n\nThe graph $y = g(x)$ is shown below.\n\n![](images/79/791aca2b232c0eee5950c4c1c87073b4c51cd5d61d094de893ca4a2ec28e8d1e.png)\n\nThe $y$ values go from $y=0$ up to (but not including) $y=4$, including every value in between. Therefore, the range of the function is\n\n$$\n0\\leq g(x) < 4\n$$\n\nUsing interval notation, we can also write the range as $g(x)\\in [0,4)$." :tutorial/id #uuid "35906cd0-d08e-5f2a-b88e-9e8ac1329502" :tutorial/math-academy-id 8801 :tutorial/title "Graphs of Functions"} :step/id #uuid "0e0d7002-1126-53ab-8ffd-a09dbe4a234a" :step/math-academy-id 150957 :step/next {:db/id #edb/ref 17592186084044}} {:db/id #edb/ref 17592186084044 :step/content {:db/id #edb/ref 17592186083180 :knowledge-point/canonical-example {:db/id #edb/ref 17592186082941 :question/id #uuid "6b1dabe1-f820-5ab8-aceb-bbd5be3029a2" :question/math-academy-id "e-14172"} :knowledge-point/id #uuid "f4d624bf-dfd2-5910-a5a6-c72352e76e40" :knowledge-point/questions [{:db/id #edb/ref 17592186083526} {:db/id #edb/ref 17592186083937} {:db/id #edb/ref 17592186488182} {:db/id #edb/ref 17592186488278} {:db/id #edb/ref 17592186489217} {:db/id #edb/ref 17592186489284}] :knowledge-point/title "Identifying a Function's Range From a Graph"} :step/id #uuid "5bd906c2-2b91-5274-869f-0425ba950919" :step/math-academy-id 150958}] :activity/title "The Range of a Function" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186083444}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186488318} :activity/id #uuid "4dc16135-b9af-5c1e-ab88-b2de2e7d8742" :activity/scope {:db/id #edb/ref 17592186049707 :topic/id #uuid "0d118f55-a6b1-5729-9c06-3dbae669ed79" :topic/math-academy-id 754} :activity/steps [{:db/id #edb/ref 17592186488287 :step/content {:db/id #edb/ref 17592186488281 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b53980ec-b15d-549a-8525-7a63afb3b2f3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{-10,11\\}" :db/id #edb/ref 17592186487910} {:answer/id #uuid "c8327966-1579-50f4-8769-4f4b1d20b937" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{-10,0,5,8,11\\}" :db/id #edb/ref 17592186487950} {:answer/id #uuid "d6c9b848-eb9c-5da4-a5f0-aafd698f9eb5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[-10,11]" :db/id #edb/ref 17592186487974} {:answer/id #uuid "e848015c-8529-5e20-997f-452f870dbae1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(5,8)" :db/id #edb/ref 17592186488005} {:answer/id #uuid "f2190b72-89e7-54d5-927a-57b95863b4f6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{0,5,8,11\\}" :db/id #edb/ref 17592186488021}] :answer-field/correct {:db/id #edb/ref 17592186487950} :answer-field/id #uuid "fdbf69e7-910a-5185-95d7-1b30300b0a57" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186488174}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f6271452-0c9d-5cbb-808a-a03630c0e389" :question/math-academy-id "q-79266" :question/problem "What is the range of the function $f$ defined by the following table?\n\n| $x$ | $6$ | $7$ | $9$ | $11$ | $13$ | $14$ | $18$ | $19$ |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $5$ | $0$ | $8$ | $-10$ | $11$ | $-10$ | $5$ | $0$ |" :question/worked-solution "The range of $f(x)$ consists of all the outputs that have a corresponding $x$-input.\n\nIn a table, the range consists of all numbers that feature in the row corresponding to $f(x).$\n\nTherefore, the range is the set $\\{-10,0,5,8,11\\}.$"} :step/id #uuid "0320c674-391c-525d-a5c4-9c442fc33f7e" :step/next {:db/id #edb/ref 17592186488326}} {:db/id #edb/ref 17592186488288 :step/content {:db/id #edb/ref 17592186488258 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11dda732-4b38-5d2d-945d-43e23eb61bd5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[-6,7]" :db/id #edb/ref 17592186487599} {:answer/id #uuid "3ef48750-e872-55e8-879b-29227874153e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{0,7\\}" :db/id #edb/ref 17592186487689} {:answer/id #uuid "78dd9aa6-9e83-5292-b186-73b2f4cc12de" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{-6,-4,-2,0,1,3,5,7\\}" :db/id #edb/ref 17592186487803} {:answer/id #uuid "a9c18ff8-03ed-5a26-9279-ad019db3f2bb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\infty ,\\infty )" :db/id #edb/ref 17592186487891} {:answer/id #uuid "ae4b3ee0-e0a4-547e-873b-10171c79bb3b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{-6,7\\}" :db/id #edb/ref 17592186487899}] :answer-field/correct {:db/id #edb/ref 17592186487803} :answer-field/id #uuid "5cc0bbc9-e32a-5c02-a5ea-63505b608b9c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186488085}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c17be40c-81be-54ae-93a6-293eae7f05d7" :question/math-academy-id "q-37027" :question/problem "What is the range of the function $h$ defined by the following table?\n\n| $x$ | $0$ | $-1$ | $2$ | $-3$ | $4$ | $-5$ | $6$ | $-7$ |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n| $h(x)$ | $0$ | $1$ | $-2$ | $3$ | $-4$ | $5$ | $-6$ | $7$ |" :question/worked-solution "The range of $h(x)$ consists of all the outputs that have a corresponding $x$-input.\n\nIn a table, the range consists of all numbers that feature in the row corresponding to $h(x).$\n\nTherefore, the range is the set $\\{-6,-4,-2,0,1,3,5,7\\}.$"} :step/id #uuid "062e6706-d792-58b5-acc0-8902fc891e0b" :step/next {:db/id #edb/ref 17592186488287}} {:db/id #edb/ref 17592186488318 :step/content {:db/id #edb/ref 17592186083526 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15ccbd64-dd37-5c1c-ac0c-62783d6002f8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1\\le f(x)\\le 0" :db/id #edb/ref 17592186487614} {:answer/id #uuid "1f37bcb0-b9d9-5a12-8b71-9c9a950fd0a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1\\le f(x)\\le 1" :db/id #edb/ref 17592186487631} {:answer/id #uuid "87a3ab71-ea35-509e-9e3f-5556d8497808" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4<f(x)<4" :db/id #edb/ref 17592186487824} {:answer/id #uuid "c4ba7457-4a29-535a-b0e5-20a84b3a0639" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4\\le f(x)\\le 4" :db/id #edb/ref 17592186487941} {:answer/id #uuid "f669d99f-f22f-5736-807c-f6a7b2de210d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1\\le f(x)<1" :db/id #edb/ref 17592186488029}] :answer-field/correct {:db/id #edb/ref 17592186488029} :answer-field/id #uuid "fdcf4998-be8e-5c14-a306-1b9b77ef3f68" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186080051}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "39d5c05a-d237-5ed6-abcc-a736fbe37cdd" :question/math-academy-id "q-13722" :question/problem "![](images/e0/e07a67e287b43cad2785d717393a3868803b94dffed14040fdf1329dd6bc9378.png)\n\nWhat is the range of the function $f(x),$ shown above?" :question/worked-solution "First, we find the lowest and highest $y$-values in the graph.\n\n- The lowest $y$-value is $-1.$ This occurs at the point $(-4,-1).$\n\n- The highest $y$-value is $1.$ This occurs at the point $(4,1).$ However note that this point is not actually included in the graph.\n\nThe function covers all the $y$-values between $-1$ and $1,$ including $-1$ but not including $1.$\n\nTherefore, the range is $-1\\le y<1,$ which can also be written as  $-1\\le f(x)<1.$"} :step/id #uuid "983f5a45-1a23-5889-ac93-0368d4110505" :step/next {:db/id #edb/ref 17592186488288}} {:db/id #edb/ref 17592186488326 :step/content {:db/id #edb/ref 17592186488278 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10b99c2c-7707-5d66-8da2-a5686ff27235" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0<f(x)<3" :db/id #edb/ref 17592186487595} {:answer/id #uuid "11f89eee-1bbb-58b3-8fa4-b20195b0fc5d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2<f(x)<4" :db/id #edb/ref 17592186487600} {:answer/id #uuid "5e18da27-97d3-5495-b1f2-041cf7e3c7bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2\\le f(x)\\le 4" :db/id #edb/ref 17592186487755} {:answer/id #uuid "5eedf984-c57c-5a23-b01d-25c70190b6f8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1<f(x)<3" :db/id #edb/ref 17592186487758} {:answer/id #uuid "b30149ca-0055-5673-9eab-08614a1566db" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0\\le f(x)\\le 3" :db/id #edb/ref 17592186487908}] :answer-field/correct {:db/id #edb/ref 17592186487595} :answer-field/id #uuid "76d58179-406b-5f6d-bfb2-2743c8e8bdc1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186488099}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f18ce5af-43bd-5993-814d-ed1e89769ace" :question/math-academy-id "q-129337" :question/problem "![](images/d9/d94225e60a13742a70558cea252d7bffde2bab51bcb6942be510e7bbde6323e5.png)\n\nWhat is the range of the function $f(x),$ shown above?" :question/worked-solution "First, we find the lowest and highest $y$-values in the graph.\n\n- The lowest $y$-value is $0.$ This occurs at the point $(4,0).$ However, note that this point is not actually included in the graph.\n\n- The highest $y$-value is $3.$ This occurs at the point $(-2,3).$ However, note that this point is not actually included in the graph.\n\nThe function covers all the $y$-values between $0$ and $3,$ but not including $0$ nor $3.$\n\nTherefore, the range is $0<y<3,$ which can also be written as  $0<f(x)<3.$"} :step/id #uuid "b04d87be-0779-5826-b838-ff3afa3d8d4c" :step/next {:db/id #edb/ref 17592186488343}} {:db/id #edb/ref 17592186488343 :step/content {:db/id #edb/ref 17592186488182 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d9a0b69-2551-510b-a191-6777480f7929" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186487719}] :answer-field/correct {:db/id #edb/ref 17592186487719} :answer-field/id #uuid "0dc700b9-f0a4-5b59-9c19-77a6b7c1362c" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186488059} {:answer-field/choices [{:answer/id #uuid "049ea557-4d92-5f5b-878c-bb4d41b99074" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "<" :db/id #edb/ref 17592186487575}] :answer-field/correct {:db/id #edb/ref 17592186487575} :answer-field/id #uuid "920b4acd-ce70-5a81-a42c-cb01e9f965fb" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186488113} {:answer-field/choices [{:answer/id #uuid "8320ca0e-0d78-5eb4-a373-2c5fe073b03a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186487817}] :answer-field/correct {:db/id #edb/ref 17592186487817} :answer-field/id #uuid "aa1cc76b-9163-5d2c-a6ce-24fa7d880f16" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186488124}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0794aaff-8257-5ff5-95bd-c8b72d62b6ae" :question/math-academy-id "q-223601" :question/problem "![](images/58/5835b3fdf2fccfd3b27f326bd90188a8382ea826a019c161e65c8a58376b3d7f.png)\n\nWhat is the range of the function $f(x),$ shown above?\n\n{{field-1}}\n$\\le \\,f(x)$\n{{field-2}}{{field-3}}" :question/worked-solution "First, we find the lowest and highest $y$-values in the graph.\n\n- The lowest $y$-value is $-2.$ This occurs at the point $(-4,-2).$\n\n- The highest $y$-value is $4.$ This occurs at the point $(4,4).$ However note that this point is not actually included in the graph.\n\nThe function covers all the $y$-values between $-2$ and $4,$ including $-2$ but not including $4.$\n\nTherefore, the range is $-2\\le y<4,$ which can also be written as $-2\\le f(x)<4.$"} :step/id #uuid "f351f74d-f785-540b-b5d7-7d1c984c411b"}] :activity/title "The Range of a Function" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186487556}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186489300} :activity/id #uuid "e818d606-33e5-5229-a600-ada8b5ddee18" :activity/scope {:db/id #edb/ref 17592186049707 :topic/id #uuid "0d118f55-a6b1-5729-9c06-3dbae669ed79" :topic/math-academy-id 754} :activity/steps [{:db/id #edb/ref 17592186489300 :step/content {:db/id #edb/ref 17592186489181 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2258233c-c2c4-54f3-addc-915a3b8792f3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{0,1,2\\}" :db/id #edb/ref 17592186488540} {:answer/id #uuid "45f03560-8552-5225-8b6e-686c54b971aa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{-4,-3,-2,-1,0,1,2,3\\}" :db/id #edb/ref 17592186488612} {:answer/id #uuid "d4a3f675-5b61-533c-b307-90662d867b67" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{-2,-1,0,1,2\\}" :db/id #edb/ref 17592186488905} {:answer/id #uuid "f0be3a58-bff6-5c34-ab52-62c4eb68ac00" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{-4,-3,-1,3\\}" :db/id #edb/ref 17592186488979} {:answer/id #uuid "f8b0258c-faf9-5c36-903e-0f4c7efe4ece" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{-2,0,1,2\\}" :db/id #edb/ref 17592186488996}] :answer-field/correct {:db/id #edb/ref 17592186488996} :answer-field/id #uuid "7402e270-5499-5544-ab53-5759d512b365" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186489078}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1458db49-4a48-5b8a-8849-91c1b7ef8d88" :question/math-academy-id "q-60869" :question/problem "What is the range of the function $f$ defined by the following table?\n\n| $x$ | $-4$ | $-3$ | $-2$ | $-1$ | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $-2$ | $0$ | $2$ | $1$ | $0$ | $1$ | $2$ | $1$ |" :question/worked-solution "The range of $f(x)$ consists of all the outputs that have a corresponding $x$-input.\n\nIn a table, the range consists of all numbers that feature in the row corresponding to $f(x).$\n\nTherefore, the range is the set $\\{-2,0,1,2\\}.$"} :step/id #uuid "159ccee0-b33f-55fe-9d07-9d714f92c050" :step/next {:db/id #edb/ref 17592186489307}} {:db/id #edb/ref 17592186489307 :step/content {:db/id #