ices [{:answer/id #uuid "84cac5ce-e3e7-5c21-8c31-79b4eac65790" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-7,0)" :db/id #edb/ref 17592186488730} {:answer/id #uuid "86108145-1c61-593e-9944-c48c2d3ee18a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{-7,-5,-3,-1,0,4,6\\}" :db/id #edb/ref 17592186488731} {:answer/id #uuid "9e8e1400-45eb-5e9a-b750-f95f072133d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[-7,6]" :db/id #edb/ref 17592186488783} {:answer/id #uuid "e84fe7fd-6735-5887-8811-1577bf7dc94a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{-7,-5,-3,-1,0,2,4,6\\}" :db/id #edb/ref 17592186488957} {:answer/id #uuid "f0a977cc-2b1a-5047-8a3c-d6058da4b075" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{-7,0\\}" :db/id #edb/ref 17592186488978}] :answer-field/correct {:db/id #edb/ref 17592186488731} :answer-field/id #uuid "caa52531-0081-59c2-b65d-8eb92a32d532" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186082547}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e24a0352-55e7-51e0-b32f-99eea47a5c5d" :question/math-academy-id "q-79267" :question/problem "What is the range of the function $h$ defined by the following table?\n\n| $x$ | $0$ | $1$ | $-2$ | $3$ | $-4$ | $5$ | $-6$ | $7$ |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n| $h(x)$ | $-7$ | $6$ | $-5$ | $4$ | $-3$ | $6$ | $-1$ | $0$ |" :question/worked-solution "The range of $h(x)$ consists of all the outputs that have a corresponding $x$-input.\n\nIn a table, the range consists of all numbers that feature in the row corresponding to $h(x).$\n\nTherefore, the range is the set $\\{-7,-5,-3,-1,0,4,6\\}.$"} :step/id #uuid "34ca2e15-f552-58af-9efe-ae01b771e8dd" :step/next {:db/id #edb/ref 17592186489358}} {:db/id #edb/ref 17592186489347 :step/content {:db/id #edb/ref 17592186489284 :question/answer-fields [{:answer-field/choices [{:answer/i