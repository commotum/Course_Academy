#{[{:db/id #edb/ref 17592186489217 :knowledge-point/_questions [{:db/id #edb/ref 17592186083180 :knowledge-point/id #uuid "f4d624bf-dfd2-5910-a5a6-c72352e76e40" :knowledge-point/title "Identifying a Function's Range From a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "188c4fda-9403-5e96-8778-6fa47508ca07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\le f(x)\\le 1" :db/id #edb/ref 17592186488522} {:answer/id #uuid "31e170db-9a48-588a-8a1d-9fbc906b510e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\le f(x)\\le -1" :db/id #edb/ref 17592186488577} {:answer/id #uuid "8837b46e-1a4c-5bec-be6d-a7dbe8b25314" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\le f(x)\\le 0" :db/id #edb/ref 17592186488738} {:answer/id #uuid "a548bfd7-7287-5be4-92d7-196f40aaeb6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1\\le f(x)\\le 3" :db/id #edb/ref 17592186488798} {:answer/id #uuid "d4b92c31-a6c4-51c9-9ea1-65459509653c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\le f(x)\\le 3" :db/id #edb/ref 17592186488906}] :answer-field/correct {:answer/id #uuid "188c4fda-9403-5e96-8778-6fa47508ca07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\le f(x)\\le 1" :db/id #edb/ref 17592186488522} :answer-field/id #uuid "b8128f7f-f2e6-5c3a-88a9-33f221275500" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186489119}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4ecf9c80-3378-55e5-9ee3-61d34805f6d4" :question/math-academy-id "q-129333" :question/problem "![](images/57/579e17e56674e39e552f1c0856f40e7f878ed94248a7a0e878c1f851c54ecbea.png)\n\nWhat is the range of the function $f(x),$ shown above?" :question/worked-solution "First, we find the lowest and highest $y$-values in the graph.\n\n- The lowest $y$-value is $-3.$ This occurs at the point $(3,-3).$\n\n- The highest $y$-value is $1.$ This occurs at the point $(-1,1).$\n\nThe function covers all the $y$-values between $-3$ and $1,$ including both $-3$ and $1.$\n\nTherefore, the range is $-3\\le y\\le 1,$ which can also be written as  $-3\\le f(x)\\le 1.$"}] [{:db/id #edb/ref 17592186489284 :knowledge-point/_questions [{:db/id #edb/ref 17592186083180 :knowledge-point/id #uuid "f4d624bf-dfd2-5910-a5a6-c72352e76e40" :knowledge-point/title "Identifying a Function's Range From a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cd86298a-5ffa-5447-b9e0-56aac06aeefc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le" :db/id #edb/ref 17592186488890}] :answer-field/correct {:answer/id #uuid "cd86298a-5ffa-5447-b9e0-56aac06aeefc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le" :db/id #edb/ref 17592186488890} :answer-field/id #uuid "47d5073b-231a-54ee-a7b5-cd502b4cbda6" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186489057} {:answer-field/choices [{:answer/id #uuid "b51a175d-4a00-5b26-b00f-08b1e089652c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186488836}] :answer-field/correct {:answer/id #uuid "b51a175d-4a00-5b26-b00f-08b1e089652c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186488836} :answer-field/id #uuid "75b2a0de-fa1b-52ac-9b84-916e78eff091" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186489081} {:answer-field/choices [{:answer/id #uuid "d376a715-685a-501a-ac44-0fcbf8b2c3f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186488904}] :answer-field/correct {:answer/id #uuid "d376a715-685a-501a-ac44-0fcbf8b2c3f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186488904} :answer-field/id #uuid "959adb46-231a-5540-9f7d-05d88f3e81fe" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186489097}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "eb6a9a5f-89b9-5986-bd3d-889c98bdbbd7" :question/math-academy-id "q-223598" :question/problem "![](images/e8/e874f46cd9a95c8bff5316128c72f4fd216194e44f54dc0929f6ad53a2e6a4c9.png)\n\nWhat is the range of the function $f(x),$ shown above?\n\n{{field-1}}\n$<\\,f(x)$\n{{field-2}}{{field-3}}" :question/worked-solution "First, we find the lowest and highest $y$-values in the graph.\n\n- The lowest $y$-value is $-4.$ This occurs at the point $(-4,-4).$ However note that this point is not actually included in the graph.\n\n- The highest $y$-value is $5.$ This occurs at the point $(4,5).$\n\nThe function covers all the $y$-values between $-4$ and $5,$ including $5$ but not including $-4.$\n\nTherefore, the range is $-4<y\\le 5,$ which can also be written as $-4<f(x)\\le 5.$"}] [{:db/id #edb/ref 17592186489181 :knowledge-point/_questions [{:db/id #edb/ref 17592186083179 :knowledge-point/id #uuid "7d3796fa-e911-5553-83c2-24c98370e4ea" :knowledge-point/title "Identifying a Function's Range From a Table"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2258233c-c2c4-54f3-addc-915a3b8792f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{0,1,2\\}" :db/id #edb/ref 17592186488540} {:answer/id #uuid "45f03560-8552-5225-8b6e-686c54b971aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-4,-3,-2,-1,0,1,2,3\\}" :db/id #edb/ref 17592186488612} {:answer/id #uuid "d4a3f675-5b61-533c-b307-90662d867b67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-2,-1,0,1,2\\}" :db/id #edb/ref 17592186488905} {:answer/id #uuid "f0be3a58-bff6-5c34-ab52-62c4eb68ac00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-4,-3,-1,3\\}" :db/id #edb/ref 17592186488979} {:answer/id #uuid "f8b0258c-faf9-5c36-903e-0f4c7efe4ece" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-2,0,1,2\\}" :db/id #edb/ref 17592186488996}] :answer-field/correct {:answer/id #uuid "f8b0258c-faf9-5c36-903e-0f4c7efe4ece" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-2,0,1,2\\}" :db/id #edb/ref 17592186488996} :answer-field/id #uuid "7402e270-5499-5544-ab53-5759d512b365" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186489078}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1458db49-4a48-5b8a-8849-91c1b7ef8d88" :question/math-academy-id "q-60869" :question/problem "What is the range of the function $f$ defined by the following table?\n\n| $x$ | $-4$ | $-3$ | $-2$ | $-1$ | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $-2$ | $0$ | $2$ | $1$ | $0$ | $1$ | $2$ | $1$ |" :question/worked-solution "The range of $f(x)$ consists of all the outputs that have a corresponding $x$-input.\n\nIn a table, the range consists of all numbers that feature in the row corresponding to $f(x).$\n\nTherefore, the range is the set $\\{-2,0,1,2\\}.$"}] [{:db/id #edb/ref 17592186489261 :knowledge-point/_questions [{:db/id #edb/ref 17592186083178 :knowledge-point/id #uuid "390282db-587c-5b6c-a051-f62e4092bb0a" :knowledge-point/title "Identifying a Function's Range From a Mapping Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "054d5d9a-aba1-5c76-8345-7ecbeb93ae04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-\\frac{5}{2},0,2,5\\}" :db/id #edb/ref 17592186488482} {:answer/id #uuid "6828e34f-2c24-505a-96f5-50b6b6941424" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-\\frac{5}{2},0,2,5,6\\}" :db/id #edb/ref 17592186488672} {:answer/id #uuid "88943568-2139-578f-994b-b87c69520664" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{5\\}" :db/id #edb/ref 17592186488739} {:answer/id #uuid "c5bb03b2-82ea-59b4-8fa4-bce7b5127b4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-\\frac{5}{2},0,2,6\\}" :db/id #edb/ref 17592186488872} {:answer/id #uuid "c6eb96d0-12ef-568c-8e86-b8c9c6e9d05a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-3,\\frac{3}{4},2,5\\}" :db/id #edb/ref 17592186488875}] :answer-field/correct {:answer/id #uuid "c5bb03b2-82ea-59b4-8fa4-bce7b5127b4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-\\frac{5}{2},0,2,6\\}" :db/id #edb/ref 17592186488872} :answer-field/id #uuid "d705e5c5-02ad-52b1-8d89-720188a2ac4f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186489142}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b6c7077f-943a-52fc-905d-553a194f631f" :question/math-academy-id "q-79264" :question/problem "![](images/df/dfcaa1de127881d7f6291efa2f78fbaecf1e5e29cea00d6b071c6ed2b800026f.png)\n\nWhat is the range of the function $g$ defined by the mapping diagram shown above?" :question/worked-solution "The range of $g(x)$ consists of all the outputs that have a corresponding $x$-input.\n\nIn a mapping diagram, the range consists of all the outputs to which an arrow is drawn.\n\nTherefore, the range is the set $\\{-\\frac{5}{2},0,2,6\\}.$"}] [{:db/id #edb/ref 17592186083936 :knowledge-point/_questions [{:db/id #edb/ref 17592186083179 :knowledge-point/id #uuid "7d3796fa-e911-5553-83c2-24c98370e4ea" :knowledge-point/title "Identifying a Function's Range From a Table"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84cac5ce-e3e7-5c21-8c31-79b4eac65790" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-7,0)" :db/id #edb/ref 17592186488730} {:answer/id #uuid "86108145-1c61-593e-9944-c48c2d3ee18a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-7,-5,-3,-1,0,4,6\\}" :db/id #edb/ref 17592186488731} {:answer/id #uuid "9e8e1400-45eb-5e9a-b750-f95f072133d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[-7,6]" :db/id #edb/ref 17592186488783} {:answer/id #uuid "e84fe7fd-6735-5887-8811-1577bf7dc94a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-7,-5,-3,-1,0,2,4,6\\}" :db/id #edb/ref 17592186488957} {:answer/id #uuid "f0a977cc-2b1a-5047-8a3c-d6058da4b075" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-7,0\\}" :db/id #edb/ref 17592186488978}] :answer-field/correct {:answer/id #uuid "86108145-1c61-593e-9944-c48c2d3ee18a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-7,-5,-3,-1,0,4,6\\}" :db/id #edb/ref 17592186488731} :answer-field/id #uuid "caa52531-0081-59c2-b65d-8eb92a32d532" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186082547}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e24a0352-55e7-51e0-b32f-99eea47a5c5d" :question/math-academy-id "q-79267" :question/problem "What is the range of the function $h$ defined by the following table?\n\n| $x$ | $0$ | $1$ | $-2$ | $3$ | $-4$ | $5$ | $-6$ | $7$ |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n| $h(x)$ | $-7$ | $6$ | $-5$ | $4$ | $-3$ | $6$ | $-1$ | $0$ |" :question/worked-solution "The range of $h(x)$ consists of all the outputs that have a corresponding $x$-input.\n\nIn a table, the range consists of all numbers that feature in the row corresponding to $h(x).$\n\nTherefore, the range is the set $\\{-7,-5,-3,-1,0,4,6\\}.$"}]}
