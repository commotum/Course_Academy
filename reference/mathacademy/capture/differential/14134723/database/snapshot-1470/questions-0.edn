id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186375295} {:answer/id #uuid "a1ff7b33-78b9-5494-b1f6-21fedac20ac0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186375296} {:answer/id #uuid "1dc8f458-65bc-5c8d-90ae-6ef401a3ebd4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186375297} {:answer/id #uuid "67431a46-73ba-543b-b5f2-c0345c743beb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186375298} {:answer/id #uuid "52a7d1c6-e780-567b-a541-1a25d2b17a20" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186375299}] :answer-field/correct {:answer/id #uuid "67431a46-73ba-543b-b5f2-c0345c743beb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186375298} :answer-field/id #uuid "5000b0ad-4add-5d5e-a297-df68ae5024b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375294}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b84b6274-fa65-5873-af84-3d0475556d93" :question/math-academy-id "q-71892" :question/problem "Which of the following statements are true regarding the finite region bounded between the parabola $y=1-{x}^{2}$ and the line $y=-3?$\n\n- It is a type I region\n- It is a type II region\n- It's neither a type I nor a type II region" :question/worked-solution "First, notice that\n\n$$\ny=1-{x}^{2}\\,⟹\\,x=\\pm \\sqrt{1-y}.\n$$\n\nNow, let's sketch our region.\n\n![](images/72/726ad8599b89029d3dba8e79ca947af99c17bd8712e551e49fc33d3e597a5cb7.png)\n\nWe have the following:\n\n- Any vertical line through the region intersects it on a single interval. Furthermore, we can represent our region as\n\n$$\nD={(x,y)\\,:\\,-2\\le x\\le 2,\\,-3\\le y\\le 1-{x}^{2}}.\n$$\n\nSo, this is a type I region.\n\n- Any horizontal line through the region intersects it on a single interval. Furthermore, we can represent our region as\n\n$$\nD={(x,y)\\,:\\,-3\\le y\\le 1,\\,-\\sqrt{1-y}\\le y\\le \\sqrt{1-y}}.\n$$\n\nSo, this is a type II region.\n\nTherefore, only statements I and II are true."}] [{:db/id #edb/ref 17592186339049 :knowledge-point/_questions [{:db/id #edb/ref 17592186129168 :knowledge-point/id #uuid "85335de6-e1dc-5a2f-b30a-806627759030" :knowledge-point/title "Identifying Type II Regions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "099efdac-6222-5744-b3c1-1dad27d41b85" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186336117} {:answer/id #uuid "2f51b9b3-9edb-5ad5-a10c-52cfdfd9e751" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/6c/6ccd325f24c9550f82a7063623db1cae0212a07f1c938b882c6707d35a6eee29.png" :db/id #edb/ref 17592186336484} {:answer/id #uuid "5a4f7dba-2306-55b0-ad53-f7348ae38b3c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/5a/5a14be084ba22e33b636465156276fc489904a650077612c15fdec3634f8d902.png" :db/id #edb/ref 17592186336855} {:answer/id #uuid "d8f500b5-47d1-5c54-82d7-03d7175ff4bd" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/5e/5e41509dcb689a5f16822eea9b8700171a74124789e12990ee4fd292d52aa2ea.png" :db/id #edb/ref 17592186337919} {:answer/id #uuid "f39c32b9-aa95-5261-a245-c6851bf03b8c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/81/81b206d34bfa12b8623329616368ea3e6a978cf7963dbe5f09b23cafffb76dae.png" :db/id #edb/ref 17592186338160}] :answer-field/correct {:answer/id #uuid "2f51b9b3-9edb-5ad5-a10c-52cfdfd9e751" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/6c/6ccd325f24c9550f82a7063623db1cae0212a07f1c938b882c6707d35a6eee29.png" :db/id #edb/ref 17592186336484} :answer-field/id #uuid "b0492a08-2d29-5eca-af88-ac3ff00ea955" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338600}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "efbcfea6-0f26-55f3-9790-4f12e94364d5" :question/math-academy-id "q-72049" :question/problem "Which of the following is a type II region in two-dimensional space?" :question/worked-solution "A type II region can be written as\n\n$$\nD={(x,y)\\,:\\,a\\le y\\le b,\\,g(y)\\le x\\le f(y)},\n$$\n\nwhere $f$ and $g$ are continuous functions.\n\nA type II region has the property that a horizontal line drawn through the region intersects the region in a single interval only.\n\nAmong the given options, the only type II region is the following.\n\n![](images/7c/7c159c025f0b7ae4bfa8984f637a492cda21ec2dd39e87be724324e1334c06a3.png)"}] [{:db/id #edb/ref 17592186339051 :knowledge-point/_questions [{:db/id #edb/ref 17592186129168 :knowledge-point/id #uuid "85335de6-e1dc-5a2f-b30a-806627759030" :knowledge-point/title "Identifying Type II Regions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "304d5c58-6d45-56a3-99aa-d17f8b68ab8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186336495} {:answer/id #uuid "5441b55a-4a1a-594f-9724-97328f24db28" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/11/11311a36be324ae3a62fa1333203f722364ba99c6b0aefbff5672cf18df1e8f7.png" :db/id #edb/ref 17592186336811} {:answer/id #uuid "63378892-552b-57c0-a27d-54ec70f96e47" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/72/7231c566a92c547b6fa950052ddfbe90cf08faf794937295226c468764701a3d.png" :db/id #edb/ref 17592186336925} {:answer/id #uuid "c790838e-f2a9-5918-bdd1-8e5421ebd3d0" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d2/d25e6ae97e93e13491cac3937cae0928694f843479de353be8e5874fb0e726f1.png" :db/id #edb/ref 17592186337803} {:answer/id #uuid "f926c30c-f403-58a7-a6b8-aec9711a7738" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/cc/ccc416dcf8464cc7fb7e6ea5aad60803a4c1bb273fe6f1069bfbb3e2fe124b64.png" :db/id #edb/ref 17592186338216}] :answer-field/correct {:answer/id #uuid "63378892-552b-57c0-a27d-54ec70f96e47" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/72/7231c566a92c547b6fa950052ddfbe90cf08faf794937295226c468764701a3d.png" :db/id #edb/ref 17592186336925} :answer-field/id #uuid "2b60ff15-436e-5d40-8454-d27cd64273f2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338356}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9bfc53ce-85fd-5d88-8915-7ff8d8881ed6" :question/math-academy-id "q-72055" :question/problem "Which of the following is a type II region in two-dimensional space?" :question/worked-solution "A type II region can be written as\n\n$$\nD={(x,y)\\,:\\,a\\le y\\le b,\\,g(y)\\le x\\le f(y)},\n$$\n\nwhere $f$ and $g$ are continuous functions.\n\nA type II region has the property that a horizontal line drawn through the region intersects the region in a single interval only.\n\nAmong the given options, the only type II region is the following.\n\n![](images/fe/fe16f5f3d1e9663a7e0df88d71639016bfb3357a6745ee6f125968978fd54c12.png)"}] [{:db/id #edb/ref 17592186373174 :knowledge-point/_questions [{:db/id #edb/ref 17592186129168 :knowledge-point/id #uuid "85335de6-e1dc-5a2f-b30a-806627759030" :knowledge-point/title "Identifying Type II Regions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a975ac4-7eb7-5fd7-877f-3b02d86d178c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D={(x,y)\\,:\\,0\\le y\\le 1,\\,y\\le x\\le \\sqrt{y}}" :db/id #edb/ref 17592186373176} {:answer/id #uuid "39895c7e-c47a-544c-91d0-9dfd7ed83606" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D={(x,y)\\,:\\,0\\le y\\le {x}^{2},\\,0\\le x\\le 1}" :db/id #edb/ref 17592186373177} {:answer/id #uuid "a9081b22-1a7d-5fe6-a42e-28c78f31adb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D={(x,y)\\,:\\,0\\le y\\le 1,\\,0\\le x\\le y}" :db/id #edb/ref 17592186373178} {:answer/id #uuid "cdc5c900-890c-5102-b2c4-66ae4d181695" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D={(x,y)\\,:\\,0\\le y\\le 1,\\,0\\le x\\le 1}" :db/id #edb/ref 17592186373179} {:answer/id #uuid "9ec0e614-7e69-564e-8bef-ca2ee0f86847" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D={(x,y)\\,:\\,0\\le y\\le 1,\\,0\\le x\\le \\sqrt{y}}" :db/id #edb/ref 17592186373180}] :answer-field/correct {:answer/id #uuid "6a975ac4-7eb7-5fd7-877f-3b02d86d178c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D={(x,y)\\,:\\,0\\le y\\le 1,\\,y\\le x\\le \\sqrt{y}}" :db/id #edb/ref 17592186373176} :answer-field/id #uuid "257fac2f-8a02-59c7-aca1-ef19cbb1795a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373175}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ef441fce-64e9-5f90-b9fb-0d44af6b333e" :question/math-academy-id "q-72143" :question/problem "![](images/76/768046952484d181a404486547db84882424d98da4f677254484e1083580a39b.png)\n\nWhich of the following represents the shaded region above as a type II region in two-dimensional space?" :question/worked-solution "A type II region can be written as\n\n$$\nD={(x,y)\\,:\\,a\\le y\\le b,\\,g(y)\\le x\\le f(y)},\n$$\n\nwhere $f$ and $g$ are continuous functions.\n\nTo express the given region as a type II region, we first rewrite all of the given curves as functions of $y:$\n\n$$\ny={x}^{2}\\,⟹\\,x=\\sqrt{y}\n$$\n\nThe function $x=y$ is already written as a function of $y.$\n\nNotice that the region lies between the horizontal lines $y=0$ and $y=1.$ So, we have $0\\le y\\le 1.$\n\nWe draw a horizontal arrow through the region to determine the left function $g(y)$ and the right function $f(y).$ A horizontal line should intersect the region in a single interval only for it to be a type II region.\n\n![](images/d5/d55cb7ea67d9865368c744577bb4a4b22a3635e8e62869ee65e945612d6c0e98.png)\n\nThe horizontal line enters the region through the lower function $x=y$ and leaves through the upper function $x=\\sqrt{y}.$ So, we have $y\\le x\\le \\sqrt{y}.$\n\nTherefore, we obtain\n\n$$\nD={(x,y)\\,:\\,0\\le y\\le 1,\\,y\\le x\\le \\sqrt{y}}.\n$$"}] [{:db/id #edb/ref 17592186339070 :knowledge-point/_questions [{:db/id #edb/ref 17592186129169 :knowledge-point/id #uuid "7948909f-8dcb-5cc0-a00f-f505a41e4004" :knowledge-point/title "Classifying a Region as Type I, Type II, Both, or Neither"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d5dfdf6-e50a-544c-a082-757d6a3cc45e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186336750} {:answer/id #uuid "6f3a5eba-d4b1-5a73-b36e-ccfbf5537a92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186337017} {:answer/id #uuid "71d9509f-880d-594a-ad0c-8f134a4a17bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186337050} {:answer/id #uuid "87c90cf0-1d0a-5ecb-9f7d-4e9022a09814" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186337256} {:answer/id #uuid "fc897d08-7b5c-5946-a0d6-80162b7a9c92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186338252}] :answer-field/correct {:answer/id #uuid "87c90cf0-1d0a-5ecb-9f7d-4e9022a09814" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186337256} :answer-field/id #uuid "5dc16394-01fd-51be-9be9-07cf0cfe3cbb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338440}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f581ab20-43e5-59a8-ac58-914378a7361e" :question/math-academy-id "q-72186" :question/problem "Which of the following statements are true regarding the finite region bounded between the parabola $y=4-{x}^{2}$ and the line $y=2-|x|?$\n\n- It is a type I region\n- It is a type II region\n- It's neither a type I nor a type II region" :question/worked-solution "First, let's sketch our region.\n\n![](images/6f/6f35161e7efbd53c9ef558ffe88d8e046771128965a9fdd02143ae37a9b130ea.png)\n\nWe have the following:\n\n- Any vertical line through the region intersects it on a single interval. Furthermore, we can represent our region as\n\n$$\nD={(x,y)\\,:\\,-2\\le x\\le 2,\\,2-|x|\\le y\\le 4-{x}^{2}}.\n$$\n\nSo, this is a type I region.\n\n- The horizontal line $y=1$ intersects the region in two separate intervals, as shown below. So, this can't be a type II region.\n\n![](images/76/769a521cd6b05ecf05052da382e40295b26be66fe56e4eff7c6940c9032f2f0b.png)\n\nTherefore, only statement I is true."}] [{:db/id #edb/ref 17592186375314 :knowledge-point/_questions [{:db/id #edb/ref 17592186129167 :knowledge-point/id #uuid "64d342be-ebaf-5e94-b641-ea8ce6f14c12" :knowledge-point/title "Identifying Type I Regions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dea59bf2-3509-5e23-bc45-8a6f00f8f763" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/7c/7c634f90a086b28d8d8c2f5cb898a149a885803851dedcf94ed6e8782ad1e25d.png" :db/id #edb/ref 17592186375316} {:answer/id #uuid "cfddd069-ef87-5e55-83af-2dcabd0224f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186375317} {:answer/id #uuid "e0121ce2-27fc-58d8-947a-5788ad384bcf" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/06/062003a83f4afa0cadd68eee54dc0379e469041f3fd0b2371acf5428d8709306.png" :db/id #edb/ref 17592186375318} {:answer/id #uuid "3d74f904-81a5-542a-b32a-e0709ccd1fed" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ef/ef9d0a612a093852fd9f60fb20c86b946c178f9e2a9877ef7c16f89f98e324f6.png" :db/id #edb/ref 17592186375319} {:answer/id #uuid "3631542a-0a0a-5e75-9d2a-b39d672ba7dc" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/67/677097b290404e318a097ee79fba82a2f3217ce2762df983229b75ef3d493f13.png" :db/id #edb/ref 17592186375320}] :answer-field/correct {:answer/id #uuid "3631542a-0a0a-5e75-9d2a-b39d672ba7dc" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/67/677097b290404e318a097ee79fba82a2f3217ce2762df983229b75ef3d493f13.png" :db/id #edb/ref 17592186375320} :answer-field/id #uuid "7caf983d-6da5-5ae9-b908-c6e8bf00bc8a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375315}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f42f9772-6905-5ddc-bad3-1a0fe74e1330" :question/math-academy-id "q-72318" :question/problem "Which of the following is a type I region in two-dimensional space?" :question/worked-solution "A type I region can be written as\n\n$$\nD={(x,y)\\,:\\,a\\le x\\le b,\\,g(x)\\le y\\le f(x)},\n$$\n\nwhere $f$ and $g$ are continuous functions.\n\nA type I region has the property that a vertical line drawn through the region intersects the region in a single interval only.\n\nAmong the given options, the only type I region is the following.\n\n![](images/bf/bf2098a7fcdecce8405dadf6f9cd2c78da19d1c0a7ae2c9c9e95a897a64ef9d9.png)"}] [{:db/id #edb/ref 17592186375328 :knowledge-point/_questions [{:db/id #edb/ref 17592186129167 :knowledge-point/id #uuid "64d342be-ebaf-5e94-b641-ea8ce6f14c12" :knowledge-point/title "Identifying Type I Regions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "94d1678f-c40b-5af3-9c01-5e44121bc63a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D={(x,y)\\,:\\,1\\le x\\le y+1,\\,0\\le y\\le \\frac{1}{2}(x-1)^{2}}" :db/id #edb/ref 17592186375330} {:answer/id #uuid "84793cb4-e8f5-5b93-983f-4e8cd175b741" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D={(x,y)\\,:\\,1\\le x\\le 3,\\,\\frac{1}{2}(x-1)^{2}\\le y\\le x-1}" :db/id #edb/ref 17592186375331} {:answer/id #uuid "ef5ce8c7-a9c2-5498-ac15-36a28bbba91d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D={(x,y)\\,:\\,0\\le y\\le 2,\\,0\\le x\\le \\sqrt{y}+1}" :db/id #edb/ref 17592186375332} {:answer/id #uuid "a8532342-6134-55eb-82d5-4bcf4a8d4a3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D={(x,y)\\,:\\,0\\le y\\le 2,\\,0\\le x\\le y+1}" :db/id #edb/ref 17592186375333} {:answer/id #uuid "c8beef18-d508-5038-9945-f9210d0f3975" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D={(x,y)\\,:\\,1\\le x\\le 3,\\,\\frac{1}{2}(x-1)^{2}\\le y\\le x+1}" :db/id #edb/ref 17592186375334}] :answer-field/correct {:answer/id #uuid "84793cb4-e8f5-5b93-983f-4e8cd175b741" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D={(x,y)\\,:\\,1\\le x\\le 3,\\,\\frac{1}{2}(x-1)^{2}\\le y\\le x-1}" :db/id #edb/ref 17592186375331} :answer-field/id #uuid "06791450-79a7-57ff-982c-0a9c0c48c94a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375329}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b8dcd36b-62ff-51dd-911e-391155781896" :question/math-academy-id "q-72322" :question/problem "![](images/88/8861ad010cbd19d897ace4c8da2fdaeca25e9d2319ab95d3b338e6db49aa21ae.png)\n\nWhich of the following represents the shaded region above as a type I region in two-dimensional space?" :question/worked-solution "A type I region can be written as\n\n$$\nD={(x,y)\\,:\\,a\\le x\\le b,\\,g(x)\\le y\\le f(x)},\n$$\n\nwhere $f$ and $g$ are continuous functions.\n\nTo express the given region as a type I region, we first rewrite all of the given curves as functions of $x:$\n\n$$\nx=y+1\\,⟹\\,y=x-1\n$$\n\nThe function $y=\\frac{1}{2}(x-1)^{2}$ is already written as a function of $x.$\n\nNotice that the region lies between the vertical lines $x=1$ and $x=3.$ So, we have $1\\le x\\le 3.$\n\nWe draw a vertical arrow through the region to determine the lower function $g(x)$ and the upper function $f(x).$ A vertical line should intersect the region in a single interval only for it to be a type I region.\n\n![](images/15/15f9c5d526747b80766a8a3250fa2e705d5d7d9561c52e08492b7a18f1483eb6.png)\n\nThe vertical line enters the region through the lower function $y=\\frac{1}{2}(x-1)^{2}$ and leaves through the upper function $y=x-1.$ So, we have $\\frac{1}{2}(x-1)^{2}\\le y\\le x-1.$\n\nTherefore, we obtain\n\n$$\nD={(x,y)\\,:\\,1\\le x\\le 3,\\,\\frac{1}{2}(x-1)^{2}\\le y\\le x-1}.\n$$"}] [{:db/id #edb/ref 17592186403647 :knowledge-point/_questions [{:db/id #edb/ref 17592186129169 :knowledge-point/id #uuid "7948909f-8dcb-5cc0-a00f-f505a41e4004" :knowledge-point/title "Classifying a Region as Type I, Type II, Both, or Neither"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58331f85-b5fc-59a5-a2ca-f0a6fd38ca0b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186403649} {:answer/id #uuid "76022809-5efc-5b86-8507-f2ad2e7674e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186403650} {:answer/id #uuid "b0765542-63c4-5076-85eb-d92c5b5ac592" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186403651} {:answer/id #uuid "20d4565f-595d-51c6-857d-208b49c021b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186403652} {:answer/id #uuid "57eafbb0-6829-567e-b846-7bde9a6cae27" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186403653}] :answer-field/correct {:answer/id #uuid "20d4565f-595d-51c6-857d-208b49c021b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186403652} :answer-field/id #uuid "c8f0581f-5142-59ed-84df-f95cc7adf20e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403648}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "964e90c7-3ddc-59ef-9c19-6cc6da31e561" :question/math-academy-id "q-73552" :question/problem "Which of the following statements are true regarding the finite region bounded between the ellipses $(x-1)^{2}+4{y}^{2}=1$ and ${x}^{2}+4{y}^{2}=4?$\n\nI. It is a type I region\nII. It is a type II region\nIII. It's neither a type I nor a type II region" :question/worked-solution "First, let's sketch our region.\n\n![](images/21/215dd0c920e700a75896fc54751ec20d197487a2c992cd8910810c66129c14dc.png)\n\nWe have the following:\n\n- The vertical line $x=1$ intersects the region in two separate intervals, as shown below. So, this can't be a type I region.\n\n![](images/7e/7e1a0c5dd2b4aadf7efe78d903234b8d00cf4fa92eb7a3b41209a856f2d14b01.png)\n\n- The horizontal line $y=0.25$ intersects the region in two separate intervals, as shown below. So, this can't be a type II region.\n\n![](images/a9/a90d7306e3f88a31609e368f9362248d6a12b7922b6a9e8c9f980ab31e7fb140.png)\n\nTherefore, only statement III is true."}]}
