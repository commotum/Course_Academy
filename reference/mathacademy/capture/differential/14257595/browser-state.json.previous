    "q-139962": {
      "dom_id": "step-q139962",
      "name": "Question 3",
      "problem": "Given $x=[\\begin{aligned}-1 \\\\ -4 \\\\ 8\\end{aligned}]$, find $‖x‖.$",
      "worked_solution": "Using the formula for the norm, we have\n\n$$\n\\begin{aligned}‖x‖ & =\\sqrt{{x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2}} \\\\  & =\\sqrt{(-1)^{2}+(-4)^{2}+{8}^{2}} \\\\  & =\\sqrt{1+16+64} \\\\  & =\\sqrt{81} \\\\  & =9.\\end{aligned}\n$$",
      "calculator_instructions": "",
      "fields": [
        {
          "key": "selection",
          "type": "radio",
          "choices": [
            {
              "option": "a",
              "dom_id": "questionWidget-choiceLetterCircle-139962-a",
