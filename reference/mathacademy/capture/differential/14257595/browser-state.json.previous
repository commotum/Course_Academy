    "q-39213": {
      "dom_id": "step-q39213",
      "name": "Question 6",
      "problem": "Given the vectors $x=[\\begin{aligned}2 \\\\ 3\\end{aligned}]$ and $y=[\\begin{aligned}-1 \\\\ 2\\end{aligned}]$, find the distance $\\text{d}(x,y).$",
      "worked_solution": "Using the formula for the distance, we have\n\n$$\n\\begin{aligned}\\text{d}(x,y) & =‖x-y‖ \\\\  & =\\sqrt{({x}_{1}-{y}_{1})^{2}+({x}_{2}-{y}_{2})^{2}} \\\\  & =\\sqrt{(2-(-1))^{2}+(3-2)^{2}} \\\\  & =\\sqrt{{3}^{2}+{1}^{2}} \\\\  & =\\sqrt{9+1} \\\\  & =\\sqrt{10}.\\end{aligned}\n$$",
      "calculator_instructions": "",
      "fields": [
        {
          "key": "selection",
          "type": "radio",
          "choices": [
            {
              "option": "a",
              "dom_id": "questionWidget-choiceLetterCircle-39213-a",
