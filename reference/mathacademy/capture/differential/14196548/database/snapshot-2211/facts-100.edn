0e0eb9da-e4d5-55d6-ad33-7db8760cccce" #edb/ref 17592186045417] [17592186435392 #edb/ref 1075 #edb/ref 17592186435375 #edb/ref 17592186045417] [17592186435392 #edb/ref 1075 #edb/ref 17592186435377 #edb/ref 17592186045417] [17592186435392 #edb/ref 1075 #edb/ref 17592186435381 #edb/ref 17592186045417] [17592186435392 #edb/ref 1075 #edb/ref 17592186435383 #edb/ref 17592186045417] [17592186435392 #edb/ref 1075 #edb/ref 17592186435387 #edb/ref 17592186045417] [17592186435392 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186435392 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186435392 #edb/ref 1078 #edb/ref 17592186435375 #edb/ref 17592186045417] [17592186435392 #edb/ref 1079 #uuid "835cf471-5984-50ad-ac7a-5c92395f40c6" #edb/ref 17592186045417] [17592186435394 #edb/ref 1068 #edb/ref 17592186435390 #edb/ref 17592186045417] [17592186435394 #edb/ref 1069 "q-102452" #edb/ref 17592186045417] [17592186435394 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186435394 #edb/ref 1071 "Find ${f}^{″}(2,1)$ for the function $f(x,y)$ given that\n${f}^{′}(x,y)=\\begin{bmatrix}-2xy & 2y-{x}^{2}\\end{bmatrix}$" #edb/ref 17592186045443] [17592186435394 #edb/ref 1072 #uuid "d48bb18b-a23a-5640-ba69-c0db05f527bc" #edb/ref 17592186045417] [17592186435394 #edb/ref 1074 "For a function $f:{R}^{n}\\to R,$ given by\n\n$$\nf:{{\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{bmatrix}}_{⏟}}_{x}⟶f({x}_{1},{x}_{2},…,{x}_{n}),\n$$\n\nthe second derivative of $f$ is given by the $n\\times n$ matrix\n\n$$\n{f}^{″}(x)=\\begin{bmatrix}\\frac{{∂}^{2}f}{∂{x}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{n}} \\\\ \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{2}^{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{n}^{2}}\\end{bmatrix}.\n$$\n\nIn our case, we have\n\n$$\n{f}^{″}(x,y)=\\begin{bmatrix}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{bmatrix}.\n$$\n\nFirst, notice that since ${f}^{′}(x,y)=\\begin{bmatrix}-2xy & 2y-{x}^{2}\\end{bmatrix},$ \n we must have\n\n$$\n\\frac{∂f}{∂x}=-2xy,\\,\\frac{∂f}{∂y}=2y-{x}^{2}.\n$$\n\nNow, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(-2xy)=-2y\\, & \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(2y-{x}^{2})=-2x \\\\ \\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}(-2xy)=-2x\\, & \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(2y-{x}^{2})=2\\end{aligned}\n$$\n\nSo, the second derivative is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =\\begin{bmatrix}-2y & -2x \\\\ -2x & 2\\end{bmatrix}.\\end{aligned}\n$$\n\nFinally, we evaluate this matrix at $(2,1).$ This gives\n\n$$\n{f}^{″}(2,1)=\\begin{bmatrix}-2 & -4 \\\\ -4 & 2\\end{bmatrix}.\n$$" #edb/ref 17592186045443] [17592186435395 #edb/ref 1068 #edb/ref 17592186435392 #edb/ref 17592186045417] [17592186435395 #edb/ref 1069 "q-102686" #edb/ref 17592186045417] [17592186435395 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186435395 #edb/ref 1071 "Given that \n${f}^{′}(x,y)=\\begin{bmatrix}2x{y}^{2} & 2y{x}^{2}-1\\end{bmatrix},$ \nevaluate the Hessian determinant of $f(x,y)$ at the point $(1,-1).$" #edb/ref 17592186045443] [17592186435395 #edb/ref 1072 #uuid "e525b492-a29a-585f-8c96-2055a51f2341" #edb/ref 17592186045417] [17592186435395 #edb/ref 1074 "For a function $f:{R}^{n}\\to R,$ given by\n\n$$\nf:{{\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{bmatrix}}_{⏟}}_{x}⟶f({x}_{1},{x}_{2},…,{x}_{n}),\n$$\n\nthe second derivative of $f$ is given by the $n\\times n$ matrix\n\n$$\n{f}^{″}(x)=\\begin{bmatrix}\\frac{{∂}^{2}f}{∂{x}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{n}} \\\\ \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{2}^{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{n}^{2}}\\end{bmatrix}.\n$$\n\nThe Hessian determinant $H(x,y)$ is the determinant of the second derivative:\n\n$$\nH(x)=det({f}^{″}(x))\n$$\n\nIn our case, we have\n\n$$\n{f}^{″}(x,y)=\\begin{bmatrix}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{bmatrix}.\n$$\n\nFirst, notice that since\n${f}^{′}(x,y)=\\begin{bmatrix}2x{y}^{2} & 2y{x}^{2}-1\\end{bmatrix},$ we must have\n\n$$\n\\frac{∂f}{∂x}=2x{y}^{2},\\,\\frac{∂f}{∂y}=2y{x}^{2}-1.\n$$\n\nNow, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(2x{y}^{2})=2{y}^{2}\\, & \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(2y{x}^{2}-1)=4xy \\\\ \\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}(2x{y}^{2})=4xy\\, & \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(2y{x}^{2}-1)=2{x}^{2}\\end{aligned}\n$$\n\nSo, the second derivative is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =\\begin{bmatrix}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{bmatrix}=\\begin{bmatrix}2{y}^{2} & 4xy \\\\ 4xy & 2{x}^{2}\\end{bmatrix}.\\end{aligned}\n$$\n\n \n\nEvaluating the second derivative at $(1,-1),$ we obtain\n\n$$\n\\begin{aligned}{f}^{″}(1,-1)=\\begin{bmatrix}2 & -4 \\\\ -4 & 2\\end{bmatrix}.\\end{aligned}\n$$\n\nFinally, we have\n\n$$\nH(1,-1)=2\\cdot 2-(-4)\\cdot (-4)=-12.\n$$" #edb/ref 17592186045443] [17592186480731 #edb/ref 1043 #edb/ref 17592186481442 #edb/ref 17592186045417] [17592186480731 #edb/ref 1043 #edb/ref 17592186481451 #edb/ref 17592186045417] [17592186480731 #edb/ref 1043 #edb/ref 17592186481454 #edb/ref 17592186045417] [17592186480731 #edb/ref 1043 #edb/ref 17592186481455 #edb/ref 17592186045417] [17592186480731 #edb/ref 1043 #edb/ref 17592186481463 #edb/ref 17592186045417] [17592186480731 #edb/ref 1044 #edb/ref 17592186045464 #edb/