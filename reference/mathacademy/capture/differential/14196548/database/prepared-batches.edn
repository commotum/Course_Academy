b69-1ae0-561f-a21b-1f490d47e054" :answer-field/choices "answer-7e106318-5cd1-562e-bb83-a7e1e65c6c69"] ["answer-field-a8dc6b69-1ae0-561f-a21b-1f490d47e054" :answer-field/choices "answer-df6ec264-721c-5c32-b562-4dd7d6f6e9fb"] ["answer-field-a8dc6b69-1ae0-561f-a21b-1f490d47e054" :answer-field/choices "answer-3317f54b-1416-55a3-8ca3-d53a13390c95"] ["question-46310383-5e9b-5711-9143-446211dee40a" :question/answer-fields "answer-field-a8dc6b69-1ae0-561f-a21b-1f490d47e054"] [17592186157425 :knowledge-point/questions "question-46310383-5e9b-5711-9143-446211dee40a"] ["question-0614088a-4b37-5f45-a256-f7dd1a417f0a" :question/id #uuid "0614088a-4b37-5f45-a256-f7dd1a417f0a"] ["question-0614088a-4b37-5f45-a256-f7dd1a417f0a" :question/math-academy-id "q-80943"] ["question-0614088a-4b37-5f45-a256-f7dd1a417f0a" :question/problem "Find ${f}^{″}(x,y)$ for the function $f(x,y)={e}^{x}\\operatorname{sin}⁡y.$"] ["question-0614088a-4b37-5f45-a256-f7dd1a417f0a" :question/worked-solution "For a function $f:{R}^{n}\\to R,$ given by\n\n$$\nf:{{[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]}_{⏟}}_{x}⟶f({x}_{1},{x}_{2},…,{x}_{n}),\n$$\n\nthe second derivative of $f$ is given by the $n\\times n$ matrix\n\n$$\n{f}^{″}(x)=[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{n}} \\\\ \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{2}^{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{n}^{2}}\\end{aligned}].\n$$\n\nIn our case, we have\n\n$$\n{f}^{″}(x,y)=[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{aligned}].\n$$\n\nFirst, we compute the first derivative of $f(x,y),$ as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x,y) & =[\\begin{aligned}\\frac{∂f}{∂x} & \\frac{∂f}{∂y}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{∂}{∂x}({e}^{x}\\operatorname{sin}⁡y) & \\frac{∂}{∂y}({e}^{x}\\operatorname{sin}⁡y)\\end{aligned}] \\\\  & =[\\begin{aligned}{e}^{x}\\operatorname{sin}⁡y & {e}^{x}\\operatorname{cos}⁡y\\end{aligned}]\\end{aligned}\n$$\n\nNow, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}({e}^{x}\\operatorname{sin}⁡y)={e}^{x}\\operatorname{sin}⁡y\\, & \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}({e}^{x}\\operatorname{cos}⁡y)={e}^{x}\\operatorname{cos}⁡y \\\\ \\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}({e}^{x}\\operatorname{sin}⁡y)={e}^{x}\\operatorname{cos}⁡y\\, & \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}({e}^{x}\\operatorname{cos}⁡y)=-{e}^{x}\\operatorname{sin}⁡y\\end{aligned}\n$$\n\nSo, the second derivative is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =[\\begin{aligned}{e}^{x}\\operatorname{sin}⁡y & {e}^{x}\\operatorname{cos}⁡y \\\\ {e}^{x}\\operatorname{cos}⁡y & -{e}^{x}\\operatorname{sin}⁡y\\end{aligned}].\\end{aligned}\n$$"] ["question-0614088a-4b37-5f45-a256-f7dd1a417f0a" :question/difficulty :question.difficulty/moderate] ["answer-field-7c34ea07-7e19-56a7-ba03-b874c7a7954b" :answer-field/id #uuid "7c34ea07-7e19-56a7-ba03-b874c7a7954b"] ["answer-88aa9963-0fec-593b-849b-6f365aef81b0" :answer/id #uuid "88aa9963-0fec-593b-849b-6f365aef81b0"] ["answer-88aa9963-0fec-593b-849b-6f365aef81b0" :answer/type :answer.type/math] ["answer-88aa9963-0fec-593b-849b-6f365aef81b0" :answer/value "[\\begin{aligned}-{e}^{x}\\operatorname{cos}⁡y & {e}^{x}\\operatorname{sin}⁡y \\\\ {e}^{x}\\operatorname{sin}⁡y & {e}^{x}\\operatorname{cos}⁡y\\end{aligned}]"] ["answer-af47d397-3313-5f02-895b-4079622ccc89" :answer/id #uuid "af47d397-3313-5f02-895b-4079622ccc89"] ["answer-af47d397-3313-5f02-895b-4079622ccc89" :answer/type :answer.type/math] ["answer-af47d397-3313-5f02-895b-4079622ccc89" :answer/value "[\\begin{aligned}{e}^{x}\\operatorname{cos}⁡y & -{e}^{x}\\operatorname{sin}⁡y \\\\ {e}^{x}\\operatorname{sin}⁡y & {e}^{x}\\operatorname{cos}⁡y\\end{aligned}]"] ["answer-695ca77d-0c24-5a11-989b-13dbb21f08ac" :answer/id #uuid "695ca77d-0c24-5a11-989b-13dbb21f08ac"] ["answer-695ca77d-0c24-5a11-989b-13dbb21f08ac" :answer/type :answer.type/math] ["answer-695ca77d-0c24-5a11-989b-13dbb21f08ac" :answer/value "[\\begin{aligned}{e}^{x}\\operatorname{cos}⁡y & {e}^{x}\\operatorname{sin}⁡y \\\\ -{e}^{x}\\operatorname{sin}⁡y & {e}^{x}\\operatorname{cos}⁡y\\end{aligned}]"] ["answer-9b60e2a2-ee1f-5fb2-9669-c7f3d20a997a" :answer/id #uuid "9b60e2a2-ee1f-5fb2-9669-c7f3d20a997a"] ["answer-9b60e2a2-ee1f-5fb2-9669-c7f3d20a997a" :answer/type :answer.type/math] ["answer-9b60e2a2-ee1f-5fb2-9669-c7f3d20a997a" :answer/value "[\\begin{aligned}{e}^{x}\\operatorname{sin}⁡y & \\operatorname{cos}⁡y \\\\ \\operatorname{cos}⁡y & -{e}^{x}\\operatorname{sin}⁡y\\end{aligned}]"] ["answer-f08cd101-4751-528e-9c91-8bd8e073764f" :answer/id #uuid "f08cd101-4751-528e-9c91-8bd8e073764f"] ["answer-f08cd101-4751-528e-9c91-8bd8e073764f" :answer/type :answer.type/math] ["answer-f08cd101-4751-528e-9c91-8bd8e073764f" :answer/value "[\\begin{aligned}{e}^{x}\\operatorname{sin}⁡y & {e}^{x}\\operatorname{cos}⁡y \\\\ {e}^{x}\\operatorname{cos}⁡y & -{e}^{x}\\operatorname{sin}⁡y\\end{aligned}]"] ["answer-field-7c34ea07-7e19-56a7-ba03-b874c7a7954b" :answer-field/key "selection"] ["answer-field-7c34ea07-7e19-56a7-ba03-b874c7a7954b" :answer-field/type :answer-field.type/radio] ["answer-field-7c34ea07-7e19-56a7-ba03-b874c7a7954b" :answer-field/correct "answer-f08cd101-4751-528e-9c91-8bd8e073764f"] ["answer-field-7c34ea07-7e19-56a7-ba03-b874c7a7954b" :answer-field/choices "answer-88aa9963-0fec-593b-849b-6f365aef81b0"] ["answer-field-7c34ea07-7e19-56a7-ba03-b874c7a7954b" :answer-field/choices "answer-af47d397-3313-5f02-895b-4079622ccc89"] ["answer-field-7c34ea07-7e19-56a7-ba03-b874c7a7954b" :answer-field/choices "answer-695ca77d-0c24-5a11-989b-13dbb21f08ac"] ["answer-field-7c34ea07-7e19-56a7-ba03-b874c7a7954b" :answer-field/choices "answer-9b60e2a2-ee1f-5fb2-9669-c7f3d20a997a"] ["answer-field-7c34ea07-7e19-56a7-ba03-b874c7a7954b" :answer-field/choices "answer-f08cd101-4751-528e-9c91-8bd8e073764f"] ["question-0614088a-4b37-5f45-a256-f7dd1a417f0a" :question/answer-fields "answer-field-7c34ea07-7e19-56a7-ba03-b874c7a7954b"] [17592186157425 :knowledge-point/questions "question-0614088a-4b37-5f45-a256-f7dd1a417f0a"] ["question-223797a4-3fdc-5efb-a9f2-b733398cd415" :question/id #uuid "223797a4-3fdc-5efb-a9f2-b733398cd415"] ["question-223797a4-3fdc-5efb-a9f2-b733398cd415" :question/math-academy-id "q-80946"] ["question-223797a4-3fdc-5efb-a9f2-b733398cd415" :question/problem "Given that \n${f}^{′}(x,y)=[\\begin{aligned}-{e}^{y}\\operatorname{sin}⁡x & {e}^{y}\\operatorname{cos}⁡x\\end{aligned}],$ \nevaluate the Hessian determinant of $f(x,y)$ at the point $(0,0).$"] ["question-223797a4-3fdc-5efb-a9f2-b733398cd415" :question/worked-solution "For a function $f:{R}^{n}\\to R,$ given by\n\n$$\nf:{{[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]}_{⏟}}_{x}⟶f({x}_{1},{x}_{2},…,{x}_{n}),\n$$\n\nthe second derivative of $f$ is given by the $n\\times n$ matrix\n\n$$\n{f}^{″}(x)=[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{n}} \\\\ \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{2}^{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{n}^{2}}\\end{aligned}].\n$$\n\nThe Hessian determinant $H(x,y)$ is the determinant of the second derivative:\n\n$$\nH(x)=det({f}^{″}(x))\n$$\n\nIn our case, we have\n\n$$\n{f}^{″}(x,y)=[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{aligned}].\n$$\n\nFirst, notice that since ${f}^{′}(x,y)=[\\begin{aligned}-{e}^{y}\\operatorname{sin}⁡x & {e}^{y}\\operatorname{cos}⁡x\\end{aligned}],$ we must have\n\n$$\n\\frac{∂f}{∂x}=-{e}^{y}\\operatorname{sin}⁡x,\\,\\frac{∂f}{∂y}={e}^{y}\\operatorname{cos}⁡x.\n$$\n\nNow, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(-{e}^{y}\\operatorname{sin}⁡x)=-{e}^{y}\\operatorname{cos}⁡x\\, & \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}({e}^{y}\\operatorname{cos}⁡x)=-{e}^{y}\\operatorname{sin}⁡x \\\\ \\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}(-{e}^{y}\\operatorname{sin}⁡x)=-{e}^{y}\\operatorname{sin}⁡x\\, & \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}({e}^{y}\\operatorname{cos}⁡x)={e}^{y}\\operatorname{cos}⁡x\\end{aligned}\n$$\n\nSo, the second derivative is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{aligned}]=[\\begin{aligned}-{e}^{y}\\operatorname{cos}⁡x & -{e}^{y}\\operatorname{sin}⁡x \\\\ -{e}^{y}\\operatorname{sin}⁡x & {e}^{y}\\operatorname{cos}⁡x\\end{aligned}].\\end{aligned}\n$$\n\nEvaluating the second derivative at $(0,0),$ we obtain\n\n$$\n\\begin{aligned}{f}^{″}(0,0)=[\\begin{aligned}-1 & 0 \\\\ 0 & 1\\end{aligned}].\\end{aligned}\n$$\n\nFinally, we have\n\n$$\nH(0,0)=(-1)\\cdot 1-{0}^{2}=-1.\n$$"] ["question-223797a4-3fdc-5efb-a9f2-b733398cd415" :question/difficulty :question.difficulty/moderate] ["answer-field-e7c15a59-5adc-5127-8074-bf8ca6a5dc2b" :answer-field/id #uuid "e7c15a59-5adc-5127-8074-bf8ca6a5dc2b"] ["answer-81decfb0-353d-554c-a766-c2d475210694" :answer/id #uuid "81decfb0-353d-554c-a766-c2d475210694"] ["answer-81decfb0-353d-554c-a766-c2d475210694" :answer/type :answer.type/math] ["answer-81decfb0-353d-554c-a766-c2d475210694" :answer/value "-1"] ["answer-c08ac167-4934-5d02-a974-ed7fd8f64367" :answer/id #uuid "c08ac167-4934-5d02-a974-ed7fd8f64367"] ["answer-c08ac167-4934-5d02-a974-ed7fd8f64367" :answer/type :answer.type/math] ["answer-c08ac167-4934-5d02-a974-ed7fd8f64367" :answer/value "-2"] ["answer-06acb265-9aa4-5e5c-afdc-84b8445440f4" :