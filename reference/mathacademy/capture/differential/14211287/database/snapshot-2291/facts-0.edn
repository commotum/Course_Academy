7] [17592186522628 #edb/ref 1075 #edb/ref 17592186522157 #edb/ref 17592186045417] [17592186522628 #edb/ref 1075 #edb/ref 17592186522272 #edb/ref 17592186045417] [17592186522628 #edb/ref 1075 #edb/ref 17592186522334 #edb/ref 17592186045417] [17592186522628 #edb/ref 1075 #edb/ref 17592186522498 #edb/ref 17592186045417] [17592186522628 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186522628 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186522628 #edb/ref 1078 #edb/ref 17592186522060 #edb/ref 17592186045417] [17592186522628 #edb/ref 1079 #uuid "8b20a77e-96f0-53df-9532-08e282712028" #edb/ref 17592186045417] [17592186522658 #edb/ref 1075 #edb/ref 17592186522134 #edb/ref 17592186045417] [17592186522658 #edb/ref 1075 #edb/ref 17592186522146 #edb/ref 17592186045417] [17592186522658 #edb/ref 1075 #edb/ref 17592186522151 #edb/ref 17592186045417] [17592186522658 #edb/ref 1075 #edb/ref 17592186522499 #edb/ref 17592186045417] [17592186522658 #edb/ref 1075 #edb/ref 17592186522541 #edb/ref 17592186045417] [17592186522658 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186522658 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186522658 #edb/ref 1078 #edb/ref 17592186522134 #edb/ref 17592186045417] [17592186522658 #edb/ref 1079 #uuid "d02a1966-a7e4-53aa-b8f4-e6c00697e831" #edb/ref 17592186045417] [17592186522735 #edb/ref 1068 #edb/ref 17592186522628 #edb/ref 17592186045417] [17592186522735 #edb/ref 1069 "q-107854" #edb/ref 17592186045417] [17592186522735 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186522735 #edb/ref 1071 "Evaluate $Γ(\\frac{3}{2}).$" #edb/ref 17592186045417] [17592186522735 #edb/ref 1072 #uuid "6b08de07-14d5-570b-89f3-5d4423c1c633" #edb/ref 17592186045417] [17592186522735 #edb/ref 1074 "To evaluate the gamma function at multiples of one-half, we use the following recursive formula:\n\n$$\nΓ(z+1)=zΓ(z),\\,Γ(\\frac{1}{2})=\\sqrt{\\pi }\n$$\n\nSo, we have the following:\n\n$$\n\\begin{aligned}Γ(\\frac{3}{2}) & =\\frac{1}{2}Γ(\\frac{1}{2}) \\\\  & =\\frac{\\sqrt{\\pi }}{2}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186522765 #edb/ref 1068 #edb/ref 17592186522562 #edb/ref 17592186045417] [17592186522765 #edb/ref 1069 "q-107839" #edb/ref 17592186045417] [17592186522765 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186522765 #edb/ref 1071 "$Γ(11)=$" #edb/ref 17592186045417] [17592186522765 #edb/ref 1072 #uuid "a471c8a2-3054-5106-9731-9d5bdebed1cf" #edb/ref 17592186045417] [17592186522765 #edb/ref 1074 "For any natural number $n\\ge 1,$ we have\n\n$$\nΓ(n)=(n-1)!\n$$\n\nTherefore, \n\n$$\nΓ(11)=10!\n$$" #edb/ref 17592186045417] [17592186522769 #edb/ref 1068 #edb/ref 17592186522570 #edb/ref 17592186045417] [17592186522769 #edb/ref 1069 "q-107883" #edb/ref 17592186045417] [17592186522769 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186522769 #edb/ref 1071 "$\\frac{4}{\\sqrt{\\pi }}\\,Γ(\\frac{7}{2})+\\frac{1}{\\sqrt{\\pi }}\\,Γ(\\frac{3}{2})=$" #edb/ref 17592186045417] [17592186522769 #edb/ref 1072 #uuid "b031bd51-cdd6-576b-8767-0d0f9a3a9494" #edb/ref 17592186045417] [17592186522769 #edb/ref 1074 "To evaluate the gamma function at multiples of one-half, we use the following recursive formula:\n\n$$\nΓ(z+1)=zΓ(z),\\,Γ(\\frac{1}{2})=\\sqrt{\\pi }\n$$\n\nSo, we have the following:\n\n$$\nΓ(\\frac{3}{2})=\\frac{1}{2}Γ(\\frac{1}{2})=\\frac{1}{2}\\sqrt{\\pi },\n$$\n\n$$\n\\begin{aligned}Γ(\\frac{7}{2}) & =\\frac{5}{2}\\,Γ(\\frac{5}{2}) \\\\  & =\\frac{5}{2}\\cdot \\frac{3}{2}\\,Γ(\\frac{3}{2}) \\\\  & =\\frac{5}{2}\\cdot \\frac{3}{2}\\cdot \\frac{1}{2}\\sqrt{\\pi } \\\\  & =\\frac{15}{8}\\sqrt{\\pi }\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{4}{\\sqrt{\\pi }}\\,Γ(\\frac{7}{2})+\\frac{1}{\\sqrt{\\pi }}\\,Γ(\\frac{3}{2})=\\frac{4}{\\sqrt{\\pi }}\\cdot \\frac{15}{8}\\sqrt{\\pi }+\\frac{1}{\\sqrt{\\pi }}\\cdot \\frac{1}{2}\\sqrt{\\pi }=8.\n$$" #edb/ref 17592186045417]}
