i }\\,Γ(\\frac{7}{2})+\\frac{4}{3}\\sqrt{\\pi }\\,Γ(\\frac{5}{2})=\\frac{8}{3}\\sqrt{\\pi }\\cdot \\frac{15}{8}\\sqrt{\\pi }+\\frac{4}{3}\\sqrt{\\pi }\\cdot \\frac{3}{4}\\sqrt{\\pi }=6\\pi .\n$$"} :step/id #uuid "b1d9251f-c8f5-57aa-a85f-1f4c592833ea" :step/next {:db/id #edb/ref 17592186522841}} {:db/id #edb/ref 17592186522880 :step/content {:db/id #edb/ref 17592186522801 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33dc703e-684e-53d0-8781-bc7a04a21b42" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "53!" :db/id #edb/ref 17592186522134} {:answer/id #uuid "3b3b559a-f9cd-54d1-a0dd-b13d6d5fb9e7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "54\\sqrt{\\pi }" :db/id #edb/ref 17592186522146} {:answer/id #uuid "3dacfde4-1314-5992-8767-3fb4c8d2082e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "55\\sqrt{\\pi }" :db/id #edb/ref 17592186522151} {:answer/id #uuid "e1de1fbc-e580-592c-b8a7-356e3fda8bdc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "55!" :db/id #edb/ref 17592186522499} {:answer/id #uuid "f60d4564-181e-5cb1-ac97-85c611ff2811" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "54!" :db/id #edb/ref 17592186522541}] :answer-field/correct {:db/id #edb/ref 17592186522134} :answer-field/id #uuid "d02a1966-a7e4-53aa-b8f4-e6c00697e831" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186522658}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ed844e83-8648-5ae6-bf7d-9f1f63004687" :question/math-academy-id "q-107846" :question/problem "$Γ(54)=$" :question/worked-solution "For any natural number $n\\ge 1,$ we have\n\n$$\nΓ(n)=(n-1)!\n$$\n\nTherefore, \n\n$$\nΓ(54)=53!\n$$"} :step/id #uuid "d1c7e50f-fd61-5628-ae73-30d06a3748c0" :step/next {:db/id #edb/ref 17592186522816}}] :activity/title "The Gamma Function" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 1759