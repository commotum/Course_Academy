{2}) & =\\frac{1}{2}Γ(\\frac{1}{2}) \\\\  & =\\frac{\\sqrt{\\pi }}{2}\\end{aligned}\n$$"} :step/id #uuid "023ef265-213e-5e4c-b092-5f0d563d74f4" :step/next {:db/id #edb/ref 17592186522869}} {:db/id #edb/ref 17592186522841 :step/content {:db/id #edb/ref 17592186522769 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "050d72d8-9732-5d66-9749-bb6219b382a4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186522027} {:answer/id #uuid "64f70bec-dfba-5908-ae62-b36e526bc693" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16" :db/id #edb/ref 17592186522228} {:answer/id #uuid "a4da2019-88c0-57c4-bb97-d5aa6d31b1a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{15}{8}\\sqrt{\\pi }" :db/id #edb/ref 17592186522365} {:answer/id #uuid "bd9d8a80-77df-59fa-9951-2e78efff78f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18" :db/id #edb/ref 17592186522411} {:answer/id #uuid "f7779c3f-37b2-5f1d-848b-d22bcbee42f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186522546}] :answer-field/correct {:db/id #edb/ref 17592186522546} :answer-field/id #uuid "26b21c09-8fe6-5a0f-b6ac-aa6ac324ee5e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186522570}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b031bd51-cdd6-576b-8767-0d0f9a3a9494" :question/math-academy-id "q-107883" :question/problem "$\\frac{4}{\\sqrt{\\pi }}\\,Γ(\\frac{7}{2})+\\frac{1}{\\sqrt{\\pi }}\\,Γ(\\frac{3}{2})=$" :question/worked-solution "To evaluate the gamma function at multiples of one-half, we use the following recursive formula:\n\n$$\nΓ(z+1)=zΓ(z),\\,Γ(\\frac{1}{2})=\\sqrt{\\pi }\n$$\n\nSo, we have the following:\n\n$$\nΓ(\\frac{3}{2})=\\frac{1}{2}Γ(\\frac{1}{2})=\\frac{1}{2}\\sqrt{\\pi },\n$$\n\n$$\n\\begin{aligned}Γ(\\frac{7}{2}) & =\\frac{5}{2}\\,Γ(\\frac{5}{2}) \\\\  & =\\frac{5}{2}\\cdot \\frac{