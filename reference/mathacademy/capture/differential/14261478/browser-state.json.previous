      "html": "<div id=\"step-q81355\" class=\"step questionWidget\" style=\"display: block;\"><div class=\"questionWidget-header\"><div class=\"questionWidget-title\">Question 11</div><div class=\"questionWidget-helpButton\">?</div></div><div class=\"questionWidget-text\"><p>Calculate <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"163\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mstyle><mjx-msubsup><mjx-mo class=\"mjx-lop\"><mjx-c class=\"mjx-c222B TEX-S2\"></mjx-c></mjx-mo><mjx-script style=\"vertical-align: -0.896em; margin-left: -0.388em;\"><mjx-mn class=\"mjx-n\" size=\"s\" style=\"margin-left: 0.647em;\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn><mjx-spacer style=\"margin-top: 1.513em;\"></mjx-spacer><mjx-texatom size=\"s\" texclass=\"ORD\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c30\"></mjx-c></mjx-mn></mjx-texatom></mjx-script></mjx-msubsup><mjx-msubsup space=\"2\"><mjx-mo class=\"mjx-lop\"><mjx-c class=\"mjx-c222B TEX-S2\"></mjx-c></mjx-mo><mjx-script style=\"vertical-align: -0.896em; margin-left: -0.388em;\"><mjx-texatom size=\"s\" texclass=\"ORD\" style=\"margin-left: 0.647em;\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2212\"></mjx-c></mjx-mo><mjx-msup><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D465 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: 0.363em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-script></mjx-msup></mjx-texatom><mjx-spacer style=\"margin-top: 1.389em;\"></mjx-spacer><mjx-texatom size=\"s\" texclass=\"ORD\"><mjx-msup><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D465 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: 0.289em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-script></mjx-msup></mjx-texatom></mjx-script></mjx-msubsup><mjx-texatom space=\"2\"