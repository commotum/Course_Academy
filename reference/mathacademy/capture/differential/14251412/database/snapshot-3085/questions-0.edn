#{[{:db/id #edb/ref 17592186124398 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186124587 :knowledge-point/id #uuid "36c5224a-eccc-5ea9-8719-2b0dc2ddb44d" :knowledge-point/title "The Domain of a Cylinder"}] :question/id #uuid "0cb849bd-8a9f-5305-b086-62da1a10e54f" :question/math-academy-id "e-8226" :question/problem "What is the domain in the $xy$-plane of the elliptic cylinder $\\dfrac{x^2}{9} + (y+1)^2 = 1?$" :question/worked-solution "The full expression describing all points on our elliptic cylinder is\n\n$$\n\\dfrac{x^2}{9} + (y+1)^2 = 1, \\qquad z=k\n$$\n\nwhere $k \\in \\mathbb{R}$ can vary arbitrarily. \n\nThe domain of any cylinder in the $xy$-plane is its base curve. Hence, in this case, the domain is\n\n$$\n\\left\\{(x,y) \\in \\mathbb{R}^2 : \\dfrac{x^2}{9} + (y+1)^2 = 1\\right\\}\n$$\n\nwhich can be written as\n\n$$\n\\left\\{ (x,y) \\in \\mathbb{R}^2 : \\dfrac{x^2}{3^2} + \\dfrac{(y+1)^2}{1^2} = 1\\right\\}.\n$$\n\nThis is an ellipse centered at $(0,-1)$ with semi-axes of lengths $3$ and $1.$"}] [{:db/id #edb/ref 17592186124399 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186124588 :knowledge-point/id #uuid "abbeda26-2fc0-5195-be26-ae79c72fc7bf" :knowledge-point/title "Traces of Cylinders"}] :question/id #uuid "64fc4653-a2ba-5013-8c70-1f4f14e5f8be" :question/math-academy-id "e-8227" :question/problem "What is the trace in the $yz$-plane of the elliptic cylinder $\\dfrac {x^2} 2 +  \\dfrac {(y-2)^2}4  = 1?$" :question/worked-solution "To find the trace in the $yz$-plane, we substitute $x=0$ into the equation of the cylinder, and simplify:\n\n$$\n\\begin{aligned}\\frac{{0}^{2}}{2}+\\frac{(y-2)^{2}}{4} & =1 \\\\ (y-2)^{2} & =4 \\\\ y-2 & =\\pm 2 \\\\ y & =2\\pm 2 \\\\ y & =0,4\\end{aligned}\n$$\n\nThis gives us the equation of two lines $y=0$ and $y=4$ in the $yz$-plane."}] [{:db/id #edb/ref 17592186284481 :knowledge-point/_questions [{:db/id #edb/ref 17592186124588 :knowledge-point/id #uuid "abbeda26-2fc0-5195-be26-ae79c72fc7bf" :knowledge-point/title "Traces of Cylinders"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "101118e5-34a4-565a-a28a-4f40416d56e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The ellipse $\\frac{(x-3)^{2}}{4}+{y}^{2}=1$" :db/id #edb/ref 17592186281835} {:answer/id #uuid "9a06e049-3bce-5679-b2f8-a8feb7f78d29" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The line $x=3$" :db/id #edb/ref 17592186283030} {:answer/id #uuid "a33498b0-8c7a-59f0-b1f4-84030b810117" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The hyperbola $\\frac{(x-3)^{2}}{4}-\\frac{{y}^{2}}{6}=1$" :db/id #edb/ref 17592186283110} {:answer/id #uuid "b21f79cf-70f7-57cc-998a-8f85a0170d0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The lines $x=1$ and $x=5$" :db/id #edb/ref 17592186283231} {:answer/id #uuid "e4cf441d-fec3-5f26-8511-8ba34d2eaf31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The line $x=5$" :db/id #edb/ref 17592186283683}] :answer-field/correct {:answer/id #uuid "b21f79cf-70f7-57cc-998a-8f85a0170d0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The lines $x=1$ and $x=5$" :db/id #edb/ref 17592186283231} :answer-field/id #uuid "043b77db-2656-5be3-9500-2312a78ba8df" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186283939}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "afb60cb3-06a3-5237-8d36-2a300505f7f2" :question/math-academy-id "q-164398" :question/problem "What is the trace in the $xy$-plane of the elliptic cylinder $\\frac{(x-3)^{2}}{4}+\\frac{{z}^{2}}{6}=1?$" :question/worked-solution "To find the trace in the $xy$-plane, we substitute $z=0$ into the equation of the cylinder, and simplify:\n\n$$\n\\begin{aligned}\\frac{(x-3)^{2}}{4}+\\frac{(0)^{2}}{6} & =1 \\\\ \\frac{(x-3)^{2}}{4} & =1 \\\\ (x-3)^{2} & =4 \\\\ x-3 & =\\pm 2 \\\\ x & =3\\pm 2 \\\\ x & =1,5\\end{aligned}\n$$\n\nThis gives us the equation of two lines $x=1$ and $x=5$ in the $xy$-plane."}] [{:db/id #edb/ref 17592186401467 :knowledge-point/_questions [{:db/id #edb/ref 17592186124588 :knowledge-point/id #uuid "abbeda26-2fc0-5195-be26-ae79c72fc7bf" :knowledge-point/title "Traces of Cylinders"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ff45c2a2-3a41-5311-99ca-5e68d6a5cab4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The parabola $(x+3)^{2}=6z$" :db/id #edb/ref 17592186401469} {:answer/id #uuid "de23290b-1126-571c-a0e8-9a9fda87468d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The line $y=3$" :db/id #edb/ref 17592186401470} {:answer/id #uuid "86e5f373-6dc5-578d-9dab-a014632c2480" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The parabola ${x}^{2}=6(z-3)$" :db/id #edb/ref 17592186401471} {:answer/id #uuid "017e8e93-5da0-5960-ba95-563c27bee3c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The line $y=\\frac{3}{2}$" :db/id #edb/ref 17592186401472} {:answer/id #uuid "defd7bf9-9f21-5237-ad4c-3feffa02e09e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The lines $y=-3$ and $y=15$" :db/id #edb/ref 17592186401473}] :answer-field/correct {:answer/id #uuid "017e8e93-5da0-5960-ba95-563c27bee3c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The line $y=\\frac{3}{2}$" :db/id #edb/ref 17592186401472} :answer-field/id #uuid "770068c0-e321-5534-9c7a-f0ff2132d3c7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401468}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7c06a8e8-6e3d-50f3-ae2e-200f38471a76" :question/math-academy-id "q-164400" :question/problem "What is the trace in the $yz$-plane of the parabolic cylinder $(x+3)^{2}=6y?$" :question/worked-solution "To find the trace in the $yz$-plane, we substitute $x=0$ into the equation of the cylinder, and simplify:\n\n$$\n\\begin{aligned}(0+3)^{2} & =6y \\\\ 9 & =6y \\\\ y & =\\frac{9}{6} \\\\ y & =\\frac{3}{2}\\end{aligned}\n$$\n\nThis gives us the equation of a line in the $yz$-plane."}] [{:db/id #edb/ref 17592186398597 :knowledge-point/_questions [{:db/id #edb/ref 17592186124588 :knowledge-point/id #uuid "abbeda26-2fc0-5195-be26-ae79c72fc7bf" :knowledge-point/title "Traces of Cylinders"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e422031f-1484-5bc6-8b3c-a582a65649b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,2)" :db/id #edb/ref 17592186398599} {:answer/id #uuid "cb516869-a543-5bb4-a49a-1d6a41dfce68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,-3)" :db/id #edb/ref 17592186398600} {:answer/id #uuid "1b1a5a20-c7b4-5185-92b5-163b7a139d28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,3)" :db/id #edb/ref 17592186398601} {:answer/id #uuid "6feba394-c3ca-5316-a6b7-e7c023aefbf2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,-3)" :db/id #edb/ref 17592186398602} {:answer/id #uuid "d8d770c7-1de6-53fa-b478-f0ede460b35e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,4)" :db/id #edb/ref 17592186398603}] :answer-field/correct {:answer/id #uuid "6feba394-c3ca-5316-a6b7-e7c023aefbf2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,-3)" :db/id #edb/ref 17592186398602} :answer-field/id #uuid "79567a05-b827-5460-9e1f-fb9fcfce3867" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398598}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "75aa15a4-a235-5132-bf56-78143897ca7d" :question/math-academy-id "q-164412" :question/problem "The projection of the intersection between the parabolic cylinder $3(x+2)^{2}=6(y+3)$ and the plane $z=4$ onto the $xy$-plane is a parabola. What is the vertex of the parabola?" :question/worked-solution "To find the intersection of the cylinder and the plane $z=4,$ we substitute $z=4$ into the equation of the cylinder. However, since the equation has no (explicit) $z$ term, we get\n\n$$\n\\begin{aligned}3(x+2)^{2} & =6(y+3) \\\\ (x+2)^{2} & =2(y+3) \\\\ (x+2)^{2} & =4\\cdot \\frac{1}{2}\\cdot (y+3).\\end{aligned}\n$$\n\nThis gives us the equation of a parabola in the $xy$-plane with the vertex at $(-2,-3).$"}] [{:db/id #edb/ref 17592186284485 :knowledge-point/_questions [{:db/id #edb/ref 17592186124588 :knowledge-point/id #uuid "abbeda26-2fc0-5195-be26-ae79c72fc7bf" :knowledge-point/title "Traces of Cylinders"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "071d3bcc-39b3-5c99-93b6-62cd8ae9cf5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,1)" :db/id #edb/ref 17592186281754} {:answer/id #uuid "1c8a33f3-7a1b-50fa-a541-ab34e0431905" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,-1)" :db/id #edb/ref 17592186281948} {:answer/id #uuid "37a95c20-f2fe-5c07-ada4-469f21d936aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,1)" :db/id #edb/ref 17592186282183} {:answer/id #uuid "57aeb6c0-2182-5711-a54a-f48855583b2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,2)" :db/id #edb/ref 17592186282435} {:answer/id #uuid "e433c482-9e74-566a-8f3b-810a0ce6733a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,-1)" :db/id #edb/ref 17592186283678}] :answer-field/correct {:answer/id #uuid "e433c482-9e74-566a-8f3b-810a0ce6733a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,-1)" :db/id #edb/ref 17592186283678} :answer-field/id #uuid "8bf6386c-b8c7-53b9-abbf-517dbee91f42" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284173}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d45d5923-cf19-557a-b6bb-276b79a4af56" :question/math-academy-id "q-164414" :question/problem "The projection of the intersection between the parabolic cylinder $4(x-3)^{2}=12(z+1)$ and the plane $y=2$ onto the $xz$-plane is a parabola. What is the vertex of the parabola?" :question/worked-solution "To find the intersection of the cylinder and the plane $y=2,$ we substitute $y=2$ into the equation of the cylinder. However, since the equation has no (explicit) $y$ term, we get\n\n$$\n\\begin{aligned}4(x-3)^{2} & =12(z+1) \\\\ (x-3)^{2} & =3(z+1) \\\\ (x-3)^{2} & =4\\cdot \\frac{3}{4}\\cdot (z+1).\\end{aligned}\n$$\n\nThis gives us the equation of a parabola in the $xz$-plane with the vertex at $(3,-1).$"}] [{:db/id #edb/ref 17592186401495 :knowledge-point/_questions [{:db/id #edb/ref 17592186124587 :knowledge-point/id #uuid "36c5224a-eccc-5ea9-8719-2b0dc2ddb44d" :knowledge-point/title "The Domain of a Cylinder"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "74d4f589-684f-54c3-98d4-d4a82b6d1f66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{2}" :db/id #edb/ref 17592186401497} {:answer/id #uuid "c8b1b394-3eb1-53d4-aa43-d93c484ebf19" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbola centered at $(5,1)$" :db/id #edb/ref 17592186401498} {:answer/id #uuid "52adf993-254f-51e6-8678-427a0e39d183" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}:xy=1}" :db/id #edb/ref 17592186401499} {:answer/id #uuid "92358f72-d64b-514a-80c8-595390361c59" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbola centered at $(-5,0)$" :db/id #edb/ref 17592186401500} {:answer/id #uuid "1238065d-225e-5276-ac70-011b60b63f35" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbola centered at $(5,0)$" :db/id #edb/ref 17592186401501}] :answer-field/correct {:answer/id #uuid "92358f72-d64b-514a-80c8-595390361c59" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbola centered at $(-5,0)$" :db/id #edb/ref 17592186401500} :answer-field/id #uuid "7ccdc892-8830-5973-bdbd-4e9a1948683b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401496}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1a066ac1-6120-502f-9195-eb35e4541908" :question/math-academy-id "q-164417" :question/problem "What is the domain in the $xy$-plane of the hyperbolic cylinder $(x+5)^{2}-{y}^{2}=1?$" :question/worked-solution "The full expression describing all points on our hyperbolic cylinder is\n\n$$\n(x+5)^{2}-{y}^{2}=1,\\,z=k\n$$\n\nwhere $k\\in R$ can vary arbitrarily. \n\nThe domain of any cylinder in the $xy$-plane is its base curve. Hence, in this case, the domain is\n\n$$\n{(x,y)\\in {R}^{2}:\\text{ }(x+5)^{2}-{y}^{2}=1}.\n$$\n\nThis is a hyperbola centered at $(-5,0).$"}] [{:db/id #edb/ref 17592186381320 :knowledge-point/_questions [{:db/id #edb/ref 17592186124587 :knowledge-point/id #uuid "36c5224a-eccc-5ea9-8719-2b0dc2ddb44d" :knowledge-point/title "The Domain of a Cylinder"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a70b4201-b3d7-5344-86ed-d7d2af745b22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{2}" :db/id #edb/ref 17592186381322} {:answer/id #uuid "e5f1a311-5f28-5d82-9e57-94d5f4323d01" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An upward-opening parabola with a vertex at $(-3,3)$" :db/id #edb/ref 17592186381323} {:answer/id #uuid "59e85dbc-a9d9-5f95-b382-b9677bdcc848" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A rightward-opening parabola with a vertex at $(3,-3)$" :db/id #edb/ref 17592186381324} {:answer/id #uuid "f061b28f-afa8-55a7-8e0d-e7c2bb070092" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An upward-opening parabola with a vertex at $(3,-3)$" :db/id #edb/ref 17592186381325} {:answer/id #uuid "82abe973-0c73-56af-b10e-7aaf2a7cd7f9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A rightward-opening parabola with a vertex at $(-3,3)$" :db/id #edb/ref 17592186381326}] :answer-field/correct {:answer/id #uuid "82abe973-0c73-56af-b10e-7aaf2a7cd7f9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A rightward-opening parabola with a vertex at $(-3,3)$" :db/id #edb/ref 17592186381326} :answer-field/id #uuid "a0288ccf-6b64-5773-8c55-2daba30f8b5b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381321}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ebbcd5f8-b7ec-570a-a890-74321cb785c1" :question/math-academy-id "q-164422" :question/problem "What is the domain in the $xy$-plane of the parabolic cylinder $(y-3)^{2}=2(x+3)?$" :question/worked-solution "The full expression describing all points on our parabolic cylinder is\n\n$$\n(y-3)^{2}=2(x+3),\\,z=k\n$$\n\nwhere $k\\in R$ can vary arbitrarily. \n\nThe domain of any cylinder in the $xy$-plane is its base curve. Hence, in this case, the domain is\n\n$$\n{(x,y)\\in {R}^{2}:(y-3)^{2}=2(x+3)}.\n$$\n\nThis is a rightward-opening parabola with a vertex at $(-3,3).$"}] [{:db/id #edb/ref 17592186410158 :knowledge-point/_questions [{:db/id #edb/ref 17592186124587 :knowledge-point/id #uuid "36c5224a-eccc-5ea9-8719-2b0dc2ddb44d" :knowledge-point/title "The Domain of a Cylinder"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "242e6d5f-d8c9-5706-a049-e8d876e8cf4d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An ellipse centered at $(4,2)$ with semi-axes of lengths $2$ and $6.$" :db/id #edb/ref 17592186410152} {:answer/id #uuid "2db77962-9dd8-5e3e-afd9-c903fc200b96" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The interior and boundary of an ellipse centered at $(4,2)$ with semi-axes of lengths $2$ and $6.$" :db/id #edb/ref 17592186410153} {:answer/id #uuid "3a86a3b3-9ac2-5bfe-8094-01d6a3bffb3a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An ellipse centered at $(-4,-2)$ with semi-axes of lengths $2$ and $6.$" :db/id #edb/ref 17592186410154} {:answer/id #uuid "70d01c11-f202-5519-a0ea-00fb5b34ce79" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The interior and boundary of an ellipse centered at $(2,\\sqrt{2})$ with semi-axes of lengths $4$ and $36.$" :db/id #edb/ref 17592186410155} {:answer/id #uuid "989114cb-f25b-5fc1-b192-1030cf33ffd9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An ellipse centered at $(2,\\sqrt{2})$ with semi-axes of lengths $4$ and $36.$" :db/id #edb/ref 17592186410156}] :answer-field/correct {:answer/id #uuid "242e6d5f-d8c9-5706-a049-e8d876e8cf4d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An ellipse centered at $(4,2)$ with semi-axes of lengths $2$ and $6.$" :db/id #edb/ref 17592186410152} :answer-field/id #uuid "b9e78ba6-8720-5926-8f0b-e52d4b64b7d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186410157}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6343760b-b53e-5293-9f9e-2e583031956b" :question/math-academy-id "q-164424" :question/problem "What is the domain in the $xy$-plane of the elliptic cylinder $\\frac{(x-4)^{2}}{4}+\\frac{(y-2)^{2}}{36}=1?$" :question/worked-solution "The full expression describing all points on our elliptic cylinder is\n\n$$\n\\frac{(x-4)^{2}}{4}+\\frac{(y-2)^{2}}{36}=1,\\,z=k\n$$\n\nwhere $k\\in R$ can vary arbitrarily. \n\nThe domain of any cylinder in the $xy$-plane is its base curve. Hence, in this case, the domain is\n\n$$\n{(x,y)\\in {R}^{2}:\\frac{(x-4)^{2}}{4}+\\frac{(y-2)^{2}}{36}=1}\n$$\n\nwhich can be written as\n\n$$\n{(x,y)\\in {R}^{2}:\\frac{(x-4)^{2}}{{2}^{2}}+\\frac{(y-2)^{2}}{{6}^{2}}=1}.\n$$\n\nThis is an ellipse centered at $(4,2)$ with semi-axes of lengths $2$ and $6.$"}] [{:db/id #edb/ref 17592186284489 :knowledge-point/_questions [{:db/id #edb/ref 17592186124587 :knowledge-point/id #uuid "36c5224a-eccc-5ea9-8719-2b0dc2ddb44d" :knowledge-point/title "The Domain of a Cylinder"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44539af4-0399-5ce0-b529-2ec9422b06c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An ellipse centered at $(0,3)$ with semi-axes of lengths $5$ and $3.$" :db/id #edb/ref 17592186282269} {:answer/id #uuid "51b07608-8e61-5926-ac17-e7dd744d0848" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The interior and boundary of an ellipse centered at $(0,-3)$ with semi-axes of lengths $25$ and $9.$" :db/id #edb/ref 17592186282391} {:answer/id #uuid "9a07fe10-cac8-55ba-b581-4e3f67ea9b07" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The interior and boundary of an ellipse centered at $(0,3)$ with semi-axes of lengths $5$ and $3.$" :db/id #edb/ref 17592186283031} {:answer/id #uuid "e8ad06f8-c6db-54fb-98ea-a18033a046ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An ellipse centered at $(0,-3)$ with semi-axes of lengths $25$ and $9.$" :db/id #edb/ref 17592186283716} {:answer/id #uuid "f1578ea5-8a30-5d54-9df7-7a5a0bca3a28" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An ellipse centered at $(0,-3)$ with semi-axes of lengths $5$ and $3.$" :db/id #edb/ref 17592186283793}] :answer-field/correct {:answer/id #uuid "44539af4-0399-5ce0-b529-2ec9422b06c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An ellipse centered at $(0,3)$ with semi-axes of lengths $5$ and $3.$" :db/id #edb/ref 17592186282269} :answer-field/id #uuid "632305da-72ca-5185-8088-00cc26485c0c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284098}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "12ff0311-caaa-5591-a831-5519fc8ddee1" :question/math-academy-id "q-164425" :question/problem "What is the domain in the $xy$-plane of the elliptic cylinder $\\frac{{x}^{2}}{25}+\\frac{(y-3)^{2}}{9}=1?$" :question/worked-solution "The full expression describing all points on our elliptic cylinder is\n\n$$\n\\frac{{x}^{2}}{25}+\\frac{(y-3)^{2}}{9}=1,\\,z=k\n$$\n\nwhere $k\\in R$ can vary arbitrarily. \n\nThe domain of any cylinder in the $xy$-plane is its base curve. Hence, in this case, the domain is\n\n$$\n{(x,y)\\in {R}^{2}:\\frac{{x}^{2}}{25}+\\frac{(y-3)^{2}}{9}=1}\n$$\n\nwhich can be written as\n\n$$\n{(x,y)\\in {R}^{2}:\\frac{{x}^{2}}{{5}^{2}}+\\frac{(y-3)^{2}}{{3}^{2}}=1}.\n$$\n\nThis is an ellipse centered at $(0,3)$ with semi-axes of lengths $5$ and $3.$"}] [{:db/id #edb/ref 17592186124892 :knowledge-point/_questions [{:db/id #edb/ref 17592186124587 :knowledge-point/id #uuid "36c5224a-eccc-5ea9-8719-2b0dc2ddb44d" :knowledge-point/title "The Domain of a Cylinder"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1918d48a-53c2-5f16-b174-67c3e227b561" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An ellipse centered at $(1,-2)$ with semi-axes of lengths $4$ and $2\\sqrt{2}.$" :db/id #edb/ref 17592186321344} {:answer/id #uuid "70131a1d-4e49-51d9-a2ff-a0b1651583bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An ellipse centered at $(1,-2)$ with semi-axes of lengths $2$ and $4.$" :db/id #edb/ref 17592186322017} {:answer/id #uuid "96136be2-82aa-56d6-878d-39245ffbc9fb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The interior and boundary of an ellipse centered at $(1,2)$ with semi-axes of lengths $4$ and $2.$" :db/id #edb/ref 17592186322340} {:answer/id #uuid "f0f2330d-cc93-503c-b4e7-ef2a3e7e2b3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An ellipse centered at $(-1,2)$ with semi-axes of lengths $2$ and $2\\sqrt{2}.$" :db/id #edb/ref 17592186323043} {:answer/id #uuid "f9df1992-e0c3-5c68-a3a1-27c701716f54" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The interior and boundary of an ellipse centered at $(1,-2)$ with semi-axes of lengths $4$ and $2\\sqrt{2}.$" :db/id #edb/ref 17592186323113}] :answer-field/correct {:answer/id #uuid "1918d48a-53c2-5f16-b174-67c3e227b561" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An ellipse centered at $(1,-2)$ with semi-axes of lengths $4$ and $2\\sqrt{2}.$" :db/id #edb/ref 17592186321344} :answer-field/id #uuid "45a14d6f-cbc9-50aa-a59c-af63bb97d8e7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323299}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cc8b2a71-605f-561b-af0c-35843cefcc96" :question/math-academy-id "q-35569" :question/problem "What is the domain in the $xy$-plane of the elliptic cylinder $\\frac{(x-1)^{2}}{16}+\\frac{(y+2)^{2}}{8}=1?$" :question/worked-solution "The full expression describing all points on our elliptic cylinder is\n\n$$\n\\frac{(x-1)^{2}}{16}+\\frac{(y+2)^{2}}{8}=1,\\,z=k\n$$\n\nwhere $k\\in R$ can vary arbitrarily. \n\nThe domain of any cylinder in the $xy$-plane is its base curve. Hence, in this case, the domain is\n\n$$\n{(x,y)\\in {R}^{2}:\\text{ }\\frac{(x-1)^{2}}{16}+\\frac{(y+2)^{2}}{8}=1}\n$$\n\nwhich can be written as\n\n$$\n{(x,y)\\in {R}^{2}:\\text{ }\\frac{(x-1)^{2}}{{4}^{2}}+\\frac{(y+2)^{2}}{(2\\sqrt{2})^{2}}=1}.\n$$\n\nThis is an ellipse centered at $(1,-2)$ with semi-axes of lengths $4$ and $2\\sqrt{2}.$"}]}
