#{[{:db/id #edb/ref 17592186518118 :knowledge-point/_questions [{:db/id #edb/ref 17592186124610 :knowledge-point/id #uuid "b1639105-dca4-50d1-8d86-a7aed03ba0b5" :knowledge-point/title "Estimating the Value of a Three-Variable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29960ef5-732d-5bda-992a-c2410df10260" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1.12" :db/id #edb/ref 17592186517563} {:answer/id #uuid "31371fc5-3db5-5f52-a902-57193843002d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-0.96" :db/id #edb/ref 17592186517582} {:answer/id #uuid "410f0bc0-fa46-543e-a594-c94e9437eab2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1.08" :db/id #edb/ref 17592186517617} {:answer/id #uuid "8c9c2861-2dbc-526f-80ca-6ca1f0e8b13f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-0.88" :db/id #edb/ref 17592186517751} {:answer/id #uuid "e9ad5b50-59ef-5132-a6fb-4eb47c9fd526" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1.02" :db/id #edb/ref 17592186517929}] :answer-field/correct {:answer/id #uuid "410f0bc0-fa46-543e-a594-c94e9437eab2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1.08" :db/id #edb/ref 17592186517617} :answer-field/id #uuid "d7da7969-1bfc-5a7a-973b-13d349fbd405" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186518074}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2a3146e0-f24e-5488-9d01-55dfe24a4858" :question/math-academy-id "q-129665" :question/problem "Let $f(x,y,z)$ be a differentiable function such that\n\n$$\nf(1,-1,-1)=-1,\\,{f}_{x}(x,y,z)=2x,\\,{f}_{y}(x,y,z)=-2z,\\,{f}_{z}(x,y,z)=-2y.\n$$\n\nUsing a linear approximation of $f$ at the point $(1,-1,-1),$ estimate the value of $f(1.01,-1.02,-1.03).$" :question/worked-solution "The linear approximation of the function $f$ at the point $(a,b,c)$ is given by\n\n$$\nf(x,y,z)≈f(a,b,c)+∇f(a,b,c)\\cdot ⟨x-a,y-b,z-c⟩.\n$$\n\nSo, the linear approximation of $f$ at the point $(1,-1,-1)$ is\n\n$$\n\\begin{aligned}f(x,y,z) & ≈f(1,-1,-1)+∇f(1,-1,-1)\\cdot ⟨x-1,y-(-1),z-(-1)⟩ \\\\  & ≈-1+⟨{f}_{x}(1,-1,-1),{f}_{y}(1,-1,-1),{f}_{z}(1,-1,-1)⟩\\cdot ⟨x-1,y+1,z+1⟩.\\end{aligned}\n$$\n\nNow, we find ${f}_{x}(1,-1,-1),$ ${f}_{y}(1,-1,-1)$ and ${f}_{z}(1,-1,-1),$ using the given partial derivatives:\n\n$$\n\\begin{aligned}{f}_{x}(1,-1,-1) & =2(1)=2 \\\\ {f}_{y}(1,-1,-1) & =-2(-1)=2 \\\\ {f}_{z}(1,-1,-1) & =-2(-1)=2\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nf(x,y,z)≈-1+⟨2,2,2⟩\\cdot ⟨x-1,y+1,z+1⟩.\n$$\n\nFinally, we can estimate $f(1.01,-1.02,-1.03)$ by evaluating the linear approximation at $x=1.01,y=-1.02$ and $z=-1.03,$ as follows:\n\n$$\n\\begin{aligned}f(1.01,-1.02,-1.03) & ≈-1+⟨2,2,2⟩\\cdot ⟨1.01-1,-1.02+1,-1.03+1⟩ \\\\  & ≈-1+⟨2,2,2⟩\\cdot ⟨0.01,-0.02,-0.03⟩ \\\\  & ≈-1+2(0.01)+2(-0.02)+2(-0.03) \\\\  & ≈-1+0.02-0.04-0.06 \\\\  & ≈-1.08\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186489249 :knowledge-point/_questions [{:db/id #edb/ref 17592186124451 :knowledge-point/id #uuid "0015e19e-222b-5c5b-a020-93392c50c10e" :knowledge-point/title "Finding the Best Linear Approximation of a Multivariable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f7d0aa5-2342-5d6f-a521-a62d6d54725c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x,y,z)≈-\\frac{1}{6}-\\frac{x}{108}+\\frac{y}{54}+\\frac{z}{54}" :db/id #edb/ref 17592186488506} {:answer/id #uuid "4c8e5783-e729-5001-b425-9bd95d7f94c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x,y,z)≈\\frac{1}{3}-\\frac{x}{108}-\\frac{y}{54}-\\frac{z}{54}" :db/id #edb/ref 17592186488619} {:answer/id #uuid "52aebee7-a1be-5094-b50c-2fecab43978c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x,y,z)≈-\\frac{1}{6}-\\frac{x}{108}-\\frac{y}{108}-\\frac{z}{108}" :db/id #edb/ref 17592186488628} {:answer/id #uuid "8b357635-83ca-53f3-be6f-efc2212bf65c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x,y,z)≈\\frac{1}{3}+\\frac{x}{108}+\\frac{y}{54}+\\frac{z}{54}" :db/id #edb/ref 17592186488749} {:answer/id #uuid "bac0b568-47cf-5aed-a2d1-d6ae3ec5aafb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x,y,z)≈\\frac{1}{3}-\\frac{x}{54}-\\frac{y}{54}-\\frac{z}{54}" :db/id #edb/ref 17592186488846}] :answer-field/correct {:answer/id #uuid "4c8e5783-e729-5001-b425-9bd95d7f94c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x,y,z)≈\\frac{1}{3}-\\frac{x}{108}-\\frac{y}{54}-\\frac{z}{54}" :db/id #edb/ref 17592186488619} :answer-field/id #uuid "c5948ebf-b36f-50ef-996a-235488992a7d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186489127}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9d2fd7c0-6fec-5b30-98fe-3b0bf10ba9a4" :question/math-academy-id "q-65338" :question/problem "Let $f(x,y,z)=\\frac{1}{\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}}.$ Find the linear approximation of $f$ at the point $(2,4,4).$" :question/worked-solution "The linear approximation of the function $f$ at the point $(a,b,c)$ is given by\n\n$$\nf(x,y,z)≈f(a,b,c)+∇f(a,b,c)\\cdot ⟨x-a,y-b,z-c⟩.\n$$\n\nSo, the linear approximation of $f$ at the point $(2,4,4)$ is\n\n$$\n\\begin{aligned}f(x,y,z) & ≈f(2,4,4)+∇f(2,4,4)\\cdot ⟨x-2,y-4,z-4⟩.\\end{aligned}\n$$\n\nFrom the definition of $f,$ we have that $f(2,4,4)=\\frac{1}{6}.$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}{f}_{x} & =-\\frac{x}{{({x}^{2}+{y}^{2}+{z}^{2})}^{3/2}}\\,⇒\\,{f}_{x}(2,4,4)=-\\frac{2}{{({2}^{2}+{4}^{2}+{4}^{2})}^{3/2}}=-\\frac{1}{108}, \\\\ {f}_{y} & =-\\frac{y}{{({x}^{2}+{y}^{2}+{z}^{2})}^{3/2}}\\,⇒\\,{f}_{y}(2,4,4)=-\\frac{4}{{({2}^{2}+{4}^{2}+{4}^{2})}^{3/2}}=-\\frac{1}{54}, \\\\ {f}_{z} & =-\\frac{z}{{({x}^{2}+{y}^{2}+{z}^{2})}^{3/2}}\\,⇒\\,{f}_{z}(2,4,4)=-\\frac{4}{{({2}^{2}+{4}^{2}+{4}^{2})}^{3/2}}=-\\frac{1}{54}.\\end{aligned}\n$$\n\nTherefore, the gradient of the function at the point $(2,4,4)$ is given by\n\n$$\n\\begin{aligned}∇f(2,4,4) & =⟨{f}_{x}(2,4,4),{f}_{y}(2,4,4),{f}_{z}(2,4,4)⟩ \\\\  & =⟨-\\frac{1}{108},-\\frac{1}{54},-\\frac{1}{54}⟩.\\end{aligned}\n$$\n\nFinally, the linear approximation of the function $f$ is\n\n$$\n\\begin{aligned}f(x,y,z) & ≈f(2,4,4)+∇f(2,4,4)\\cdot ⟨x-2,y-4,z-4⟩ \\\\  & =\\frac{1}{6}+⟨-\\frac{1}{108},-\\frac{1}{54},-\\frac{1}{54}⟩\\cdot ⟨x-2,y-4,z-4⟩ \\\\  & =\\frac{1}{6}-\\frac{1}{108}(x-2)-\\frac{1}{54}(y-4)-\\frac{1}{54}(z-4) \\\\  & =\\frac{1}{6}-\\frac{x}{108}+\\frac{1}{54}-\\frac{y}{54}+\\frac{4}{54}-\\frac{z}{54}+\\frac{4}{54} \\\\  & =\\frac{1}{3}-\\frac{x}{108}-\\frac{y}{54}-\\frac{z}{54}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186518199 :knowledge-point/_questions [{:db/id #edb/ref 17592186124451 :knowledge-point/id #uuid "0015e19e-222b-5c5b-a020-93392c50c10e" :knowledge-point/title "Finding the Best Linear Approximation of a Multivariable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "348d3e63-246e-544f-943d-87eec084c7a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x,y)≈-2\\pi +4x-\\pi y" :db/id #edb/ref 17592186517589} {:answer/id #uuid "871ed938-ce33-556f-8ef5-892006482a3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x,y)≈4\\pi -x-2\\pi y" :db/id #edb/ref 17592186517743} {:answer/id #uuid "89f60499-597c-504c-905d-9aa123018b42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x,y)≈4\\pi -4x-\\pi y" :db/id #edb/ref 17592186517747} {:answer/id #uuid "8eab8e94-7ae8-562e-b6e4-834aa6cc6887" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x,y)≈-\\frac{1}{2}+\\pi -\\pi x+4y" :db/id #edb/ref 17592186517755} {:answer/id #uuid "d43587aa-caee-5e81-afc1-75cb5372bcd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x,y)≈\\frac{3\\pi }{2}-4x-\\frac{\\pi }{2}y" :db/id #edb/ref 17592186517887}] :answer-field/correct {:answer/id #uuid "89f60499-597c-504c-905d-9aa123018b42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x,y)≈4\\pi -4x-\\pi y" :db/id #edb/ref 17592186517747} :answer-field/id #uuid "95092209-0ff6-5c1f-932a-fa94ab6826d5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186518039}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cf3c18cd-d64f-5eb9-99df-fc0a97727985" :question/math-academy-id "q-65339" :question/problem "Let $f(x,y)=y\\operatorname{sin}⁡(xy).$ Find the linear approximation of $f$ at the point $(\\frac{\\pi }{2},2).$" :question/worked-solution "The linear approximation of the function $f$ at the point $(a,b)$ is given by\n\n$$\nf(x,y)≈f(a,b)+∇f(a,b)\\cdot ⟨x-a,y-b⟩.\n$$\n\nSo, the linear approximation of $f$ at the point $(\\frac{\\pi }{2},2)$ is\n\n$$\n\\begin{aligned}f(x,y) & ≈f(\\frac{\\pi }{2},2)+∇f(\\frac{\\pi }{2},2)\\cdot ⟨x-\\frac{\\pi }{2},y-2⟩.\\end{aligned}\n$$\n\nFrom the definition of $f,$ we have that $f(\\frac{\\pi }{2},2)=0.$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}{f}_{x} & ={y}^{2}\\operatorname{cos}⁡(xy)\\, & ⇒\\, & {f}_{x}(\\frac{\\pi }{2},2)=(2)^{2}\\operatorname{cos}⁡(\\frac{\\pi }{2}\\cdot 2)=-4, \\\\ {f}_{y} & =\\operatorname{sin}⁡(xy)+xy\\operatorname{cos}⁡(xy) & ⇒\\, & {f}_{y}(\\frac{\\pi }{2},2)=\\operatorname{sin}⁡(\\frac{\\pi }{2}\\cdot 2)+\\frac{\\pi }{2}\\cdot 2\\cdot \\operatorname{cos}⁡(\\frac{\\pi }{2}\\cdot 2)=-\\pi .\\end{aligned}\n$$\n\nTherefore, the gradient of the function at the point $(\\frac{\\pi }{2},2)$ is given by\n\n$$\n\\begin{aligned}∇f(\\frac{\\pi }{2},2) & =⟨-4,-\\pi ⟩.\\end{aligned}\n$$\n\nFinally, the linear approximation of the function $f$ is\n\n$$\n\\begin{aligned}f(x,y) & ≈f(\\frac{\\pi }{2},2)+∇\\,f(\\frac{\\pi }{2},2)\\cdot ⟨x-\\frac{\\pi }{2},\\,y-2⟩ \\\\  & =0+⟨-4,-\\pi ⟩\\cdot ⟨x-\\frac{\\pi }{2},\\,y-2⟩ \\\\  & =-4(x-\\frac{\\pi }{2})-\\pi (y-2) \\\\  & =4\\pi -4x-\\pi y.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186125255 :knowledge-point/_questions [{:db/id #edb/ref 17592186124610 :knowledge-point/id #uuid "b1639105-dca4-50d1-8d86-a7aed03ba0b5" :knowledge-point/title "Estimating the Value of a Three-Variable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87af71d8-c14b-5e93-8a58-f967155726ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.2" :db/id #edb/ref 17592186124131} {:answer/id #uuid "8c132d2f-f0e1-55c6-8681-fe71e2237c65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.85" :db/id #edb/ref 17592186124132} {:answer/id #uuid "bc3bd8a9-f201-5d6b-bf76-51931b9ad32b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.06" :db/id #edb/ref 17592186124133} {:answer/id #uuid "d42ce0c3-890f-5ac1-a33f-8104d2a260ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.91" :db/id #edb/ref 17592186124134} {:answer/id #uuid "46c19a80-75d5-5b32-b217-f47c15153172" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.9" :db/id #edb/ref 17592186124135}] :answer-field/correct {:answer/id #uuid "87af71d8-c14b-5e93-8a58-f967155726ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.2" :db/id #edb/ref 17592186124131} :answer-field/id #uuid "b665f142-dd59-559d-9742-e6ed101ab440" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186124130}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1d1a53d9-3ef8-57e5-86e4-66648db12db7" :question/math-academy-id "q-97877" :question/problem "Suppose that $f(x,y,z)$ is a differentiable function such that\n\n$$\nf(2,-2,-1)=4,\\,{f}_{x}(2,-2,-1)=2,\\,{f}_{y}(2,-2,-1)=-2,\\,{f}_{z}(2,-2,-1)=-4.\n$$\n\nUsing a linear approximation of $f$ at the point $(2,-2,-1)$ estimate the value of $f(2.02,-1.98,-1.05)$" :question/requires-calculator true :question/worked-solution "The linear approximation of the function $f$ at the point $(a,b,c)$ is given by\n\n$$\nf(x,y,z)≈f(a,b,c)+∇f(a,b,c)\\cdot ⟨x-a,y-b,z-c⟩.\n$$\n\nSo, the linear approximation of $f$ at the point $(2,-2,-1)$ is\n\n$$\n\\begin{aligned}f(x,y,z) & ≈f(2,-2,-1)+∇f(2,-2,-1)\\cdot ⟨x-2,y+2,z+1⟩ \\\\  & =f(2,-2,-1)+⟨{f}_{x}(2,-2,-1),{f}_{y}(2,-2,-1),{f}_{z}(2,-2,-1)⟩\\cdot ⟨x-2,y+2,z+1⟩ \\\\  & =4+⟨2,-2,-4⟩\\cdot ⟨x-2,y+2,z+1⟩.\\end{aligned}\n$$\n\nWe can approximate $f(2.02,-1.98,-1.05)$ by evaluating the linear approximation at $x=2.02,$ $y=-1.98,$ and $z=-1.05$ as follows:\n\n$$\n\\begin{aligned}f(2.02,-1.98,-1.05) & ≈4+⟨2,-2,-4⟩\\cdot ⟨2.02-2,-1.98+2,-1.05+1⟩ \\\\  & =4+⟨2,-2,-4⟩\\cdot ⟨0.02,0.02,-0.05⟩ \\\\  & =4+(0.04-0.04+0.2) \\\\  & =4.2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186518157 :knowledge-point/_questions [{:db/id #edb/ref 17592186124610 :knowledge-point/id #uuid "b1639105-dca4-50d1-8d86-a7aed03ba0b5" :knowledge-point/title "Estimating the Value of a Three-Variable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "67dfeaeb-1e41-58cc-9a73-4c453d503c85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4.93" :db/id #edb/ref 17592186517679} {:answer/id #uuid "bead9479-8739-5826-ae34-4afcf877117d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5.11" :db/id #edb/ref 17592186517851} {:answer/id #uuid "d1051c05-0555-59bf-bd9a-560bd3386e91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4.85" :db/id #edb/ref 17592186517881} {:answer/id #uuid "db9225d9-c497-562a-b106-0754baa0db31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5.15" :db/id #edb/ref 17592186517904} {:answer/id #uuid "e427de28-f06a-5b57-9189-a092c905fde2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4.89" :db/id #edb/ref 17592186517919}] :answer-field/correct {:answer/id #uuid "bead9479-8739-5826-ae34-4afcf877117d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5.11" :db/id #edb/ref 17592186517851} :answer-field/id #uuid "7b62e85b-4101-530d-8082-303741e5d581" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186518028}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "72ddfe60-c39c-529d-b7e5-b5ef0ab41db5" :question/math-academy-id "q-98343" :question/problem "Suppose that $f(x,y,z)$ is a differentiable function such that\n\n$$\nf(3,0,4)=-5,\\,{f}_{x}(3,0,4)=3,\\,{f}_{y}(3,0,4)=-1,\\,{f}_{z}(3,0,4)=2.\n$$\n\nUsing a linear approximation of $f$ at the point $(3,0,4)$ estimate the value of $f(2.97,-0.02,3.98).$" :question/worked-solution "The linear approximation of the function $f$ at the point $(a,b,c)$ is given by\n\n$$\nf(x,y,z)≈f(a,b,c)+∇f(a,b,c)\\cdot ⟨x-a,y-b,z-c⟩.\n$$\n\nSo, the linear approximation of $f$ at the point $(3,0,4)$ is\n\n$$\n\\begin{aligned}f(x,y,z) & ≈f(3,0,4)+∇f(3,0,4)\\cdot ⟨x-3,y-0,z-4⟩ \\\\  & =f(3,0,4)+⟨{f}_{x}(3,0,4),{f}_{y}(3,0,4),{f}_{z}(3,0,4)⟩\\cdot ⟨x-3,y,z-4⟩ \\\\  & =-5+⟨3,-1,2⟩\\cdot ⟨x-3,y,z-4⟩.\\end{aligned}\n$$\n\nWe can approximate $f(2.97,-0.02,3.98)$ by evaluating the linear approximation at $x=2.97,$ $y=-0.02,$ and $z=3.98$ as follows:\n\n$$\n\\begin{aligned}f(2.97,-0.02,3.98) & ≈-5+⟨3,-1,2⟩\\cdot ⟨2.97-3,-0.02,3.98-4⟩ \\\\  & =-5+⟨3,-1,2⟩\\cdot ⟨-0.03,-0.02,-0.02⟩ \\\\  & =-5-0.09+0.02-0.04 \\\\  & =-5.11\\end{aligned}\n$$"}]}
