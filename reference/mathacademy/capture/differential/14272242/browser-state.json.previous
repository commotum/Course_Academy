      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14272242/observations/step-q81315-f0dbdcf208d697b20bdc.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14272242/observations/step-q81315-f0dbdcf208d697b20bdc.png",
      "source_url": "https://mathacademy.com/tasks/14272242/topics/2152/review",
      "captured_at": 1792203460.6081934,
      "math_academy_id": "q-81315",
