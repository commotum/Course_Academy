ix}" :db/id #edb/ref 17592186341038} :answer-field/id #uuid "892def45-fd05-566e-afd6-be2b00ed2ed5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341620}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "56215786-6dd7-5900-942c-c24344ff27f3" :question/math-academy-id "q-73927" :question/problem "If $v=\\begin{bmatrix}0 \\\\ 2 \\\\ 5 \\\\ -1\\end{bmatrix}$, then $3v=$" :question/worked-solution "Multiplying each component of $v$ by $3,$ we get\n\n$$\n\\begin{aligned}3v & =3\\begin{bmatrix}0 \\\\ 2 \\\\ 5 \\\\ -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}3\\cdot 0 \\\\ 3\\cdot 2 \\\\ 3\\cdot 5 \\\\ 3\\cdot (-1)\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 \\\\ 6 \\\\ 15 \\\\ -3\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186364351 :knowledge-point/_questions [{:db/id #edb/ref 17592186119803 :knowledge-point/id #uuid "ec386a91-fc52-56d8-8531-7e78a8464380" :knowledge-point/title "Calculating the Dot Product of Two Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "94684f50-85e0-5b16-9c76-e95d6f808b63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186364353} {:answer/id #uuid "8d44af52-39c0-527a-88ac-1519f75188fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186364354} {:answer/id #uuid "bf0c3a86-73bf-5d01-8251-12828d9e1549" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186364355} {:answer/id #uuid "d3bb01ba-40c0-5f98-b056-df025d672b26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186364356} {:answer/id #uuid "f6a2b666-c962-5379-b707-fb1c31bee037" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186364357}] :answer-field/correct {:answer/id #uuid "94684f50-85e0-5b16-9c76-e95d6f808b63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186364353} :answer-field/id #uuid "017cd05d-71b2-5588-bbdd-a05d4d8d7193" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186364352}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6ddc2331-5b16-5155-80a8-cc824617edac" :question/math-academy-id "q-73938" :question/problem "If $r=\\begin{bmatrix}1 \\\\ -1 \\\\ 3 \\\\ 5 \\\\ 2\\end{bmatrix}$ and $s=\\begin{bmatrix}3 \\\\ -4 \\\\ 1 \\\\ 1 \\\\ -2\\end{bmatrix}$, then $r\\cdot s=$" :question/worked-solution "To compute the dot product, we add up the products of corresponding components:\n\n$$\n\\begin{aligned}r\\cdot s & ={r}_{1}\\cdot {s}_{1}+{r}_{2}\\cdot {s}_{2}+{r}_{3}\\cdot {s}_{3}+{r}_{4}\\cdot {s}_{4}+{r}_{5}\\cdot {s}_{5} \\\\  & =1\\cdot 3+(-1)\\cdot (-4)+3\\cdot 1+5\\cdot 1+2\\cdot (-2) \\\\  & =3+4+3+5-4 \\\\  & =11\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186342112 :knowledge-point/_questions [{:db/id #edb/ref 17592186119803 :knowledge-point/id #uuid "ec386a91-fc52-56d8-8531-7e78a8464380" :knowledge-point/title "Calculating the Dot Product of Two Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43d96809-e3dd-5fef-aec9-43b2a849f964" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186339725} {:answer/id #uuid "53143a70-d722-51cd-8e2b-e4e20cc2d282" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186339893} {:answer/id #uuid "707f529c-3710-523a-9777-24e6935aad7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186340126} {:answer/id #uuid "ea6b0a98-b813-579e-9675-d74b38ae8281" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186341199} {:answer/id #uuid "f11c1ac8-7991-5f39-84b0-28a20d7bcaf6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186341253}] :answer-field/correct {:answer/id #uuid "f11c1ac8-7991-5f39-84b0-28a20d7bcaf6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186341253} :answer-field/id #uuid "eef3e121-56c7-5a3b-bf87-c4536c1b03a4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341808}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7fa0bdb5-f053-5d67-8f95-d145fa39b1e1" :question/math-academy-id "q-73939" :question/problem "Let $a=\\begin{bmatrix}4 \\\\ -2 \\\\ 2 \\\\ 6 \\\\ 10\\end{bmatrix}$ and $b=\\begin{bmatrix}5 \\\\ -3 \\\\ 1 \\\\ 0 \\\\ 2\\end{bmatrix}.$ What is $(\\frac{1}{2}a)\\cdot b?$" :question/worked-solution "First, multiplying each component of $a$ by $\\frac{1}{2}$, we get\n\n$$\n\\begin{aligned}\\frac{1}{2}a & =\\frac{1}{2}\\begin{bmatrix}4 \\\\ -2 \\\\ 2 \\\\ 6 \\\\ 10\\end{bmatrix}=\\begin{bmatrix}2 \\\\ -1 \\\\ 1 \\\\ 3 \\\\ 5\\end{bmatrix}\\,.\\end{aligned}\n$$\n\nTo compute the dot product, we add up the products of corresponding components:\n\n$$\n\\begin{aligned}(\\frac{1}{2}a)\\cdot b & =2\\cdot 5+(-1)\\cdot (-3)+1\\cdot 1+3\\cdot 0+5\\cdot 2 \\\\  & =10+3+1+0+10 \\\\  & =24\\end{aligned}\n$$"}]}
