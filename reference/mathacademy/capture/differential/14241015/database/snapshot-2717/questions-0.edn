begin{bmatrix}-3 \\\\ -2 \\\\ 1 \\\\ 5 \\\\ 6\\end{bmatrix} \\\\  & =\\begin{bmatrix}-9 \\\\ 6 \\\\ 15 \\\\ 3 \\\\ -6\\end{bmatrix}+\\begin{bmatrix}-6 \\\\ -4 \\\\ 2 \\\\ 10 \\\\ 12\\end{bmatrix} \\\\  & =\\begin{bmatrix}-9-6 \\\\ 6-4 \\\\ 15+2 \\\\ 3+10 \\\\ -6+12\\end{bmatrix} \\\\  & =\\begin{bmatrix}-15 \\\\ 2 \\\\ 17 \\\\ 13 \\\\ 6\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186120308 :knowledge-point/_questions [{:db/id #edb/ref 17592186119803 :knowledge-point/id #uuid "ec386a91-fc52-56d8-8531-7e78a8464380" :knowledge-point/title "Calculating the Dot Product of Two Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d121836-e443-558d-929c-8bd21606d806" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186315470} {:answer/id #uuid "8d3d800a-9052-595e-a031-5226ef486e29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-21" :db/id #edb/ref 17592186315906} {:answer/id #uuid "c6781ffe-cdff-5d7f-afb2-3db0e7a0ce55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186316238} {:answer/id #uuid "e2b65ccc-226c-5ef1-8a2b-d7b38984345f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-33" :db/id #edb/ref 17592186316375} {:answer/id #uuid "f117b470-f657-5c7d-aa84-a01b32a9a40d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-45" :db/id #edb/ref 17592186316460}] :answer-field/correct {:answer/id #uuid "8d3d800a-9052-595e-a031-5226ef486e29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-21" :db/id #edb/ref 17592186315906} :answer-field/id #uuid "a5e5d351-39b7-5541-a784-7d9844e3fae1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186316933}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6b6cc7d3-d9ee-56cd-98e9-b1d240810c8e" :question/math-academy-id "q-34227" :question/problem "If $u=\\begin{bmatrix}-4 \\\\ 1 \\\\ 2 \\\\ 3\\end{bmatrix}$ and $v=\\begin{bmatrix}2 \\\\ -4 \\\\ 6 \\\\ -7\\end{bmatrix}$, then $u\\cdot v=$" :question/worked-solution "To compute the dot product, we add up the products of corresponding components:\n\n$$\n\\begin{aligned}u\\cdot v & ={u}_{1}\\cdot {v}_{1}+{u}_{2}\\cdot {v}_{2}+{u}_{3}\\cdot {v}_{3}+{u}_{4}\\cdot {v}_{4} \\\\  & =(-4)\\cdot 2+1\\cdot (-4)+2\\cdot 6+3\\cdot (-7) \\\\  & =-8-4+12-21 \\\\  & =-21\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186120373 :knowledge-point/_questions [{:db/id #edb/ref 17592186119803 :knowledge-point/id #uuid "ec386a91-fc52-56d8-8531-7e78a8464380" :knowledge-point/title "Calculating the Dot Product of Two Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c12b04b3-6e93-5ec4-aef6-0db74f411fb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186118353} {:answer/id #uuid "cb43ae8b-eb24-5061-8b6e-576d82b83b44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186118354} {:answer/id #uuid "f07d0b03-02e9-5dda-9828-5fe45e5e5bb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186118355} {:answer/id #uuid "0d50181b-9c79-5e2d-8fe3-df70311bbab2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186118356} {:answer/id #uuid "69993763-cf26-53da-b98c-762146e4ea05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186118357}] :answer-field/id #uuid "ed48d113-e4b3-515a-8450-eb9085c3d999" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 175921860454