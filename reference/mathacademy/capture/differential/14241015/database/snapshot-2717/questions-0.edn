#{[{:db/id #edb/ref 17592186119612 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186119801 :knowledge-point/id #uuid "1ce19559-0f08-5ef7-9ce4-58e8e14094ab" :knowledge-point/title "Calculating a Multiple of a Vector"}] :question/id #uuid "13fa2a8c-de7c-59ee-a838-2997494edc56" :question/math-academy-id "e-4782" :question/problem "Let ![](images/3b/3b40aa273b0ea1138535c7bfc77c2c80ee16a14570a8cbf0e9306ea66ad6c5d0.svg) Find $\\dfrac{1}{2} \\mathbf{a}.$" :question/worked-solution "Multiplying each component of $\\mathbf{a}$ by $\\dfrac{1}{2},$ we get\n\n$$\n\\begin{aligned}\\frac{1}{2}a & =\\frac{1}{2}\\begin{bmatrix}-4 \\\\ 6 \\\\ 3 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{1}{2}\\cdot (-4) \\\\ \\frac{1}{2}\\cdot 6 \\\\ \\frac{1}{2}\\cdot 3 \\\\ \\frac{1}{2}\\cdot 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 \\\\ 3 \\\\ \\frac{3}{2} \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186119613 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186119802 :knowledge-point/id #uuid "ab0d2c2f-e7a4-51bb-a20a-f28c2f7ded8b" :knowledge-point/title "Adding Multiples of Vectors"}] :question/id #uuid "1e82713d-4063-5bcd-bc2e-1d35c831ab34" :question/math-academy-id "e-4783" :question/problem "Let ![](images/f3/f3118303ab755b84d1a8065e3fef0ff13c2ff44e3601c3aae0207022b64c09fa.svg) and ![](images/dd/dd226e3cb1952497d8f546e4ee73d4860f23ccda89662bc2a4012f583aa6dc24.svg) Find $\\dfrac{1}{3}\\mathbf{a}+\\dfrac{1}{2}\\mathbf{b}.$" :question/worked-solution "First, we multiply each component of $\\mathbf{a}$ by $\\dfrac{1}{3}$ and each component of $\\mathbf{b}$ by $\\dfrac{1}{2}.$ Then, we add the vectors:\n\n$$\n\\begin{aligned}\\frac{1}{3}a+\\frac{1}{2}b & =\\frac{1}{3}\\cdot \\begin{bmatrix}-3 \\\\ 6 \\\\ 12 \\\\ -9 \\\\ 3\\end{bmatrix}+\\frac{1}{2}\\cdot \\begin{bmatrix}-4 \\\\ -6 \\\\ 2 \\\\ -8 \\\\ 10\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 \\\\ 2 \\\\ 4 \\\\ -3 \\\\ 1\\end{bmatrix}+\\begin{bmatrix}-2 \\\\ -3 \\\\ 1 \\\\ -4 \\\\ 5\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1-2 \\\\ 2-3 \\\\ 4+1 \\\\ -3-4 \\\\ 1+5\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3 \\\\ -1 \\\\ 5 \\\\ -7 \\\\ 6\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186119614 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186119803 :knowledge-point/id #uuid "ec386a91-fc52-56d8-8531-7e78a8464380" :knowledge-point/title "Calculating the Dot Product of Two Vectors"}] :question/id #uuid "ba38ff28-b4f3-59b8-b18a-a278db26294d" :question/math-academy-id "e-4784" :question/problem "If ![](images/86/8639fb58fd989253bb0095f58c39189ce653683c908d22a787c7454447ae706c.svg) and ![](images/24/24145ff5ab9076ec70b5e8f57304bd93e507154b5ad7cb61b5a580445fdad3dd.svg) then what is $\\mathbf{u} \\cdot \\mathbf{v}?$" :question/worked-solution "To compute the dot product, we add up the products of corresponding components:\n\n$$\n\\begin{aligned}u\\cdot v & ={u}_{1}\\cdot {v}_{1}+{u}_{2}\\cdot {v}_{2}+{u}_{3}\\cdot {v}_{3}+{u}_{4}\\cdot {v}_{4} \\\\  & =(-1)\\cdot (-2)+4\\cdot 3+3\\cdot (-4)+(-5)\\cdot 6 \\\\  & =2+12-12-30 \\\\  & =-28\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186119615 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186119804 :knowledge-point/id #uuid "94f8e0e5-8d8a-516a-8f46-d76e94305df4" :knowledge-point/title "Finding the Value of an Unknown Quantity in an Expression Involving the Dot Product"}] :question/id #uuid "3ec5f9d5-327b-59e5-8df7-fb37d4054021" :question/math-academy-id "e-4785" :question/problem "Let be ![](images/87/870f39e6853ca1dc2013d9b82beb35e1533a3d4b5f2318cf607f1f19efdeb0d7.svg) and ![](images/9f/9f51885fedc5cf606a4e2c48663c5e85df144fe004adf7795677a3a4dc37218a.svg) If $\\mathbf{a}\\cdot \\mathbf{b}=0,$ find the value of $x.$" :question/worked-solution "Starting from the equation $\\mathbf{a} \\cdot \\mathbf{b}=0,$ we compute the dot product in terms of $x$ and then solve for $x$ in the resulting equation:\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ 10\\cdot x+x\\cdot x+0\\cdot 8+5\\cdot 5 & =0 \\\\ 10x+{x}^{2}+25 & =0 \\\\ {x}^{2}+10x+25 & =0 \\\\ (x+5)^{2} & =0 \\\\ x & =-5\\end{aligned}\n$$\n\nTherefore, we conclude that $x=-5.$"}] [{:db/id #edb/ref 17592186386120 :knowledge-point/_questions [{:db/id #edb/ref 17592186119802 :knowledge-point/id #uuid "ab0d2c2f-e7a4-51bb-a20a-f28c2f7ded8b" :knowledge-point/title "Adding Multiples of Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5107457c-138b-51a7-92ae-a6758039472a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}16 \\\\ 24 \\\\ 0 \\\\ -8 \\\\ -4\\end{bmatrix}" :db/id #edb/ref 17592186386122} {:answer/id #uuid "ff169898-02e2-5209-864c-d14da00b29d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}18 \\\\ 12 \\\\ 4 \\\\ 2 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186386123} {:answer/id #uuid "532d0a4e-4a89-57b6-99e6-afc159ce6d1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}18 \\\\ 6 \\\\ 4 \\\\ 2 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186386124} {:answer/id #uuid "87d8f2f7-2901-5f83-8b3e-f48100e7a7d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}8 \\\\ 12 \\\\ 0 \\\\ -4 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186386125} {:answer/id #uuid "655d0d3d-495e-5ce2-a46b-ad3d1938e299" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 \\\\ 6 \\\\ 0 \\\\ -2 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186386126}] :answer-field/correct {:answer/id #uuid "532d0a4e-4a89-57b6-99e6-afc159ce6d1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}18 \\\\ 6 \\\\ 4 \\\\ 2 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186386124} :answer-field/id #uuid "0c9fbf95-eeae-5173-ac51-079d67124b2a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386121}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e3e014c9-7e0f-5613-9d77-d53b9ab4992b" :question/math-academy-id "q-105102" :question/problem "Let $v=\\begin{bmatrix}5 \\\\ -3 \\\\ 2 \\\\ -1 \\\\ 0\\end{bmatrix}$ and $w=\\begin{bmatrix}-1 \\\\ 9 \\\\ -2 \\\\ 3 \\\\ -1\\end{bmatrix}.$ Find $4v+2w.$" :question/worked-solution "First, we multiply each component of $v$ by $4$ and each component of $w$ by $2.$ Then, we add the vectors:\n\n$$\n\\begin{aligned}4v+2w & =4\\cdot \\begin{bmatrix}5 \\\\ -3 \\\\ 2 \\\\ -1 \\\\ 0\\end{bmatrix}+2\\cdot \\begin{bmatrix}-1 \\\\ 9 \\\\ -2 \\\\ 3 \\\\ -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}20 \\\\ -12 \\\\ 8 \\\\ -4 \\\\ 0\\end{bmatrix}+\\begin{bmatrix}-2 \\\\ 18 \\\\ -4 \\\\ 6 \\\\ -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}20+(-2) \\\\ -12+18 \\\\ 8+(-4) \\\\ -4+6 \\\\ 0+(-2)\\end{bmatrix} \\\\  & =\\begin{bmatrix}18 \\\\ 6 \\\\ 4 \\\\ 2 \\\\ -2\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186366822 :knowledge-point/_questions [{:db/id #edb/ref 17592186119804 :knowledge-point/id #uuid "94f8e0e5-8d8a-516a-8f46-d76e94305df4" :knowledge-point/title "Finding the Value of an Unknown Quantity in an Expression Involving the Dot Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ed3bb668-f155-56de-a8c2-70df13916dba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186366824} {:answer/id #uuid "681d5b5f-27c4-5d62-9775-7fb94deda3bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186366825} {:answer/id #uuid "e10bdba7-03c5-56be-8819-e59ca7b574b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186366826} {:answer/id #uuid "be09c5e1-83a5-5086-9a71-cbc4be7d0