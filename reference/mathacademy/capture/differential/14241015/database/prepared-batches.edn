1a-843e-e7a80b8dc6db" :answer-field/choices "answer-7216454c-ed63-547f-894e-d36dbdb1f804"] ["answer-field-4b53d2ba-d063-501a-843e-e7a80b8dc6db" :answer-field/choices "answer-01b71c62-6f9d-5a55-b388-591a5c389ad6"] ["answer-field-4b53d2ba-d063-501a-843e-e7a80b8dc6db" :answer-field/choices "answer-1c97c416-eba8-5fdb-837f-7b4da0e417d7"] ["question-457dac21-00fa-5025-808b-b3e414ce1988" :question/answer-fields "answer-field-4b53d2ba-d063-501a-843e-e7a80b8dc6db"] [17592186119802 :knowledge-point/questions "question-457dac21-00fa-5025-808b-b3e414ce1988"] [17592186120373 :question/problem "Let $u=[\\begin{aligned}1 \\\\ -1 \\\\ 1 \\\\ 2\\end{aligned}]$ and $v=[\\begin{aligned}2 \\\\ -5 \\\\ 1 \\\\ 0\\end{aligned}].$ What is $(2u)\\cdot v?$"] [17592186120373 :question/worked-solution "First, multiplying each component of $u$ by $2$, we get\n\n$$\n\\begin{aligned}2u & =2[\\begin{aligned}1 \\\\ -1 \\\\ 1 \\\\ 2\\end{aligned}]=[\\begin{aligned}2 \\\\ -2 \\\\ 2 \\\\ 4\\end{aligned}]\\,.\\end{aligned}\n$$\n\nTo compute the dot product, we add up the products of corresponding components:\n\n$$\n\\begin{aligned}(2u)\\cdot v & =2\\cdot 2+(-2)\\cdot (-5)+2\\cdot 1+4\\cdot 0 \\\\  & =4+10+2+0 \\\\  & =16\\end{aligned}\n$$"] [17592186120373 :question/difficulty :question.difficulty/moderate] [17592186118352 :answer-field/correct 17592186118353] ["question-99f979f5-50b6-5282-8195-712172f0dd94" :question/id #uuid "99f979f5-50b6-5282-8195-712172f0dd94"] ["question-99f979f5-50b6-5282-8195-712172f0dd94" :question/math-academy-id "q-105106"] ["question-99f979f5-50b6-5282-8195-712172f0dd94" :question/problem "Let $r=[\\begin{aligned}10 \\\\ 0 \\\\ 7 \\\\ 1\\end{aligned}]$ and $s=[\\begin{aligned}2 \\\\ 12 \\\\ -3 \\\\ 4 \\\\ 3\\end{aligned}].$ What is $r\\cdot s?$"] ["question-99f979f5-50b6-5282-8195-712172f0dd94" :question/worked-solution "Let's examine our vectors:\n\n- The vector $r=[\\begin{aligned}10 \\\\ 0 \\\\ 7 \\\\ 1\\end{aligned}]$ has $4$ components as it lies in ${R}^{4}.$\n\n- The vector $s=[\\begin{aligned}2 \\\\ 12 \\\\ -3 \\\\ 4 \\\\ 3\\end{aligned}]$ has $5$ components as it lies in ${R}^{5}.$\n\nTherefore, since the number of components does not match, the operation is undefined."] ["question-99f979f5-50b6-5282-8195-712172f0dd94" :question/difficulty :question.difficulty/easy] ["answer-field-0fb98a7f-ad8a-5e6c-a75e-a840dc8becf9" :answer-field/id #uuid "0fb98a7f-ad8a-5e6c-a75e-a840dc8becf9"] ["answer-e450beec-fb91-51ce-9266-c0780d069541" :answer/id #uuid "e450beec-fb91-51ce-9266-c0780d069541"] ["answer-e450beec-fb91-51ce-9266-c0780d069541" :answer/type :answer.type/math] ["answer-e450beec-fb91-51ce-9266-c0780d069541" :answer/value "3"] ["answer-3d40e247-e7a6-52d9-b061-d0eb12e43950" :answer/id #uuid "3d40e247-e7a6-52d9-b061-d0eb12e43950"] ["answer-3d40e247-e7a6-52d9-b061-d0eb12e43950" :answer/type :answer.type/math] ["answer-3d40e247-e7a6-52d9-b061-d0eb12e43950" :answer/value "4"] ["answer-99bc17e3-08dd-536d-b086-370a117aaf2b" :answer/id #uuid "99bc17e3-08dd-536d-b086-370a117aaf2b"] ["answer-99bc17e3-08dd-536d-b086-370a117aaf2b" :answer/type :answer.type/math] ["answer-99bc17e3-08dd-536d-b086-370a117aaf2b" :answer/value "6"] ["answer-7449c50e-1ec7-5e2c-ab02-d370a373173c" :answer/id #uuid "7449c50e-1ec7-5e2c-ab02-d370a373173c"] ["answer-7449c50e-1ec7-5e2c-ab02-d370a373173c" :answer/type :answer.type/math] ["answer-7449c50e-1ec7-5e2c-ab02-d370a373173c" :answer/value "9"] ["answer-16cbb84b-4b49-534a-9632-2742c64dc828" :answer/id #uuid "16cbb84b-4b49-534a-9632-2742c64dc828"] ["answer-16cbb84b-4b49-534a-9632-2742c64dc828" :answer/type :answer.type/text] ["answer-16cbb84b-4b49-534a-9632-2742c64dc828" :answer/value "Undefined"] ["answer-field-0fb98a7f-ad8a-5e6c-a75e-a840dc8becf9" :answer-field/key "selection"] ["answer-field-0fb98a7f-ad8a-5e6c-a75e-a840dc8becf9" :answer-field/type :answer-field.type/radio] ["answer-field-0fb98a7f-ad8a-5e6c-a75e-a840dc8becf9" :answer-field/correct "answer-16cbb84b-4b49-534a-9632-2742c64dc828"] ["answer-field-0fb98a7f-ad8a-5e6c-a75e-a840dc8becf9" :answer-field/choices "answer-e450beec-fb91-51ce-9266-c0780d069541"] ["answer-field-0fb98a7f-ad8a-5e6c-a75e-a840dc8becf9" :answer-field/choices "answer-3d40e247-e7a6-52d9-b061-d0eb12e43950"] ["answer-field-0fb98a7f-ad8a-5e6c-a75e-a840dc8becf9" :answer-field/choices "answer-99bc17e3-08dd-536d-b086-370a117aaf2b"] ["answer-field-0fb98a7f-ad8a-5e6c-a75e-a840dc8becf9" :answer-field/choices "answer-7449c50e-1ec7-5e2c-ab02-d370a373173c"] ["answer-field-0fb98a7f-ad8a-5e6c-a75e-a840dc8becf9" :answer-field/choices "answer-16cbb84b-4b49-534a-9632-2742c64dc828"] ["question-99f979f5-50b6-5282-8195-712172f0dd94" :question/answer-fields "answer-field-0fb98a7f-ad8a-5e6c-a75e-a840dc8becf9"] [17592186119803 :knowledge-point/questions "question-99f979f5-50b6-5282-8195-712172f0dd94"] ["question-36b464cf-4c70-5aa3-a6c7-ba1498951d9c" :question/id #uuid "36b464cf-4c70-5aa3-a6c7-ba1498951d9c"] ["question-36b464cf-4c70-5aa3-a6c7-ba1498951d9c" :question/math-academy-id "q-73943"] ["question-36b464cf-4c70-5aa3-a6c7-ba1498951d9c" :question/problem "Let\n$r=[\\begin{aligned}x-2 \\\\ 2 \\\\ -3 \\\\ 1 \\\\ 1\\end{aligned}]$ and $s=[\\begin{aligned}1 \\\\ 3 \\\\ x \\\\ -2 \\\\ 1\\end{aligned}].$\nIf $r\\cdot s=7$, find the value of $x.$"] ["question-36b464cf-4c70-5aa3-a6c7-ba1498951d9c" :question/worked-solution "Starting from the equation $r\\cdot s=7,$ we compute the dot product in terms of $x$ and then solve for $x$ in the resulting equation:\n\n$$\n\\begin{aligned}r\\cdot s & =7 \\\\ (x-2)\\cdot 1+2\\cdot 3+(-3)\\cdot x+1\\cdot (-2)+1\\cdot 1 & =7 \\\\ x-2+6-3x-2+1 & =7 \\\\ -2x+3 & =7 \\\\ 2x & =-4 \\\\ x & =-2\\end{aligned}\n$$\n\nTherefore, we conclude that $x=-2.$"] ["question-36b464cf-4c70-5aa3-a6c7-ba1498951d9c" :question/difficulty :question.difficulty/moderate] ["answer-field-4b8ec564-aa1b-5852-8d2e-5e288d532861" :answer-field/id #uuid "4b8ec564-aa1b-5852-8d2e-5e288d532861"] ["answer-41ca8a64-2cf5-52f3-9711-01557d3f9064" :answer/id #uuid "41ca8a64-2cf5