-5e288d532861" :answer-field/choices "answer-681716cd-d4da-5905-8de6-fe282cc9d42b"] ["question-36b464cf-4c70-5aa3-a6c7-ba1498951d9c" :question/answer-fields "answer-field-4b8ec564-aa1b-5852-8d2e-5e288d532861"] [17592186119804 :knowledge-point/questions "question-36b464cf-4c70-5aa3-a6c7-ba1498951d9c"] ["question-ea418b13-9cd8-58b9-8c0f-d233456f224d" :question/id #uuid "ea418b13-9cd8-58b9-8c0f-d233456f224d"] ["question-ea418b13-9cd8-58b9-8c0f-d233456f224d" :question/math-academy-id "q-73944"] ["question-ea418b13-9cd8-58b9-8c0f-d233456f224d" :question/problem "Let\n$v=[\\begin{aligned}-2 \\\\ p \\\\ 5 \\\\ -2 \\\\ -3\\end{aligned}]$ and $w=[\\begin{aligned}2 \\\\ -4 \\\\ 3 \\\\ -3 \\\\ p\\end{aligned}].$\nIf $v\\cdot w=3$, find the value of $p.$"] ["question-ea418b13-9cd8-58b9-8c0f-d233456f224d" :question/worked-solution "Starting from the equation $v\\cdot w=3,$ we compute the dot product in terms of $p$ and then solve for $p$ in the resulting equation:\n\n$$\n\\begin{aligned}v\\cdot w & =3 \\\\ -2\\cdot 2+p\\cdot (-4)+5\\cdot 3+(-2)\\cdot (-3)+(-3)\\cdot p & =3 \\\\ -4-4p+15+6-3p & =3 \\\\ -7p+17 & =3 \\\\ 7p & =14 \\\\ p & =2\\end{aligned}\n$$\n\nTherefore, we conclude that $p=2.$"] ["question-ea418b13-9cd8-58b9-8c0f-d233456f224d" :question/difficulty :question.difficulty/moderate] ["answer-field-3e1fad6f-855e-553e-8d75-e321cc680343" :answer-field/id #uuid "3e1fad6f-855e-553e-8d75-e321cc680343"] ["answer-b5008f77-48d1-5bb2-ba5f-fe9365aea196" :answer/id #uuid "b5008f77-48d1-5bb2-ba5f-fe9365aea196"] ["answer-b5008f77-48d1-5bb2-ba5f-fe9365aea196" :answer/type :answer.type/math] ["answer-b5008f77-48d1-5bb2-ba5f-fe9365aea196" :answer/value "1"] ["answer-d0c098d1-7ef1-5ad1-b259-c1614202d6d3" :answer/id #uuid "d0c098d1-7ef1-5ad1-b259-c1614202d6d3"] ["answer-d0c098d1-7ef1-5ad1-b259-c1614202d6d3" :answer/type :answer.type/math] ["answer-d0c098d1-7ef1-5ad1-b259-c1614202d6d3" :answer/value "2"] ["answer-d290f871-27b8-5194-87df-869b3c3e63ff" :answer/id #uuid "d290f871-27b8-5194-87df-869b3c3e63ff"] ["answer-d290f871-27b8-5194-87df-869b3c3e63ff" :answer/type :answer.type/math] ["answer-d290f871-27b8-5194-87df-869b3c3e63ff" :answer/value "3"] ["answer-444efbe8-dff8-5c45-a4c6-ad837d7e5d57" :answer/id #uuid "444efbe8-dff8-5c45-a4c6-ad837d7e5d57"] ["answer-444efbe8-dff8-5c45-a4c6-ad837d7e5d57" :answer/type :answer.type/math] ["answer-444efbe8-dff8-5c45-a4c6-ad837d7e5d57" :answer/value "4"] ["answer-87e9f515-7eb3-5e62-a8a0-a8403b398027" :answer/id #uuid "87e9f515-7eb3-5e62-a8a0-a8403b398027"] ["answer-87e9f515-7eb3-5e62-a8a0-a8403b398027" :answer/type :answer.type/math] ["answer-87e9f515-7eb3-5e62-a8a0-a8403b398027" :answer/value "7"] ["answer-field-3e1fad6f-855e-553e-8d75-e321cc680343" :answer-field/key "selection"] ["answer-field-3e1fad6f-855e-553e-8d75-e321cc680343" :answer-field/type :answer-field.type/radio] ["answer-field-3e1fad6f-855e-553e-8d75-e321cc680343" :answer-field/correct "answer-d0c098d1-7ef1-5ad1-b259-c1614202d6d3"] ["answer-field-3e1fad6f-855e-553e-8d75-e321cc680343" :answer-field/choices "answer-b5008f77-48d1-5bb2-ba5f-fe9365aea196"] ["answer-field-3e1fad6f-855e-553e-8d75-e321cc680343" :answer-field/choices "answer-d0c098d1-7ef1-5ad1-b259-c1614202d6d3"] ["answer-field-3e1fad6f-855e-553e-8d75-e321cc680343" :answer-field/choices "answer-d290f871-27b8-5194-87df-869b3c3e63ff"] ["answer-field-3e1fad6f-855e-553e-8d75-e321cc680343" :answer-field/choices "answer-444efbe8-dff8-5c45-a4c6-ad837d7e5d57"] ["answer-field-3e1fad6f-855e-553e-8d75-e321cc680343" :answer-field/choices "answer-87e9f515-7eb3-5e62-a8a0-a8403b398027"] ["question-ea418b13-9cd8-58b9-8c0f-d233456f224d" :question/answer-fields "answer-field-3e1fad6f-855e-553e-8d75-e321cc680343"] [17592186119804 :knowledge-point/questions "question-ea418b13-9cd8-58b9-8c0f-d233456f224d"] ["question-99569175-b9f3-5c01-983c-724e408918e3" :question/id #uuid "99569175-b9f3-5c01-983c-724e408918e3"] ["question-99569175-b9f3-5c01-983c-724e408918e3" :question/math-academy-id "q-73947"] ["question-99569175-b9f3-5c01-983c-724e408918e3" :question/problem "Let $r=[\\begin{aligned}3 \\\\ \\frac{2}{{x}^{2}} \\\\ 0 \\\\ x\\end{aligned}]$ and $s=[\\begin{aligned}-1 \\\\ {x}^{4} \\\\ 8 \\\\ -1\\end{aligned}].$\nIf $r\\cdot s=0$ and $x<0$, find the value of $x.$"] ["question-99569175-b9f3-5c01-983c-724e408918e3" :question/worked-solution "Starting from the equation $r\\cdot s=0,$ we compute the dot product in terms of $x$ and then solve for $x$ in the resulting equation:\n\n$$\n\\begin{aligned}r\\cdot s & =0 \\\\ 3\\cdot (-1)+\\frac{2}{{x}^{2}}\\cdot {x}^{4}+0\\cdot 8+x\\cdot (-1) & =0 \\\\ -3+2{x}^{2}+0-x & =0 \\\\ 2{x}^{2}-x-3 & =0\\end{aligned}\n$$\n\nNow, using the quadratic formula, we obtain\n\n$$\n\\begin{aligned}x & =\\frac{-(-1)\\pm \\sqrt{(-1)^{2}-4(2)(-3)}}{2(2)} \\\\  & =\\frac{1\\pm \\sqrt{25}}{4} \\\\  & =\\frac{1\\pm 5}{4}.\\end{aligned}\n$$\n\nSo, we get two solutions, ${x}_{1}=\\frac{3}{2}$ and ${x}_{2}=-1.$ Since we need $x<0$, our final answer is $x=-1$ only."] ["question-99569175-b9f3-5c01-983c-724e408918e3" :question/difficulty :question.difficulty/hard] ["answer-field-17f4d7b6-1d54-58dd-a546-544bac478642" :answer-field/id #uuid "17f4d7b6-1d54-58dd-a546-544bac478642"] ["answer-548a5160-ea2a-5460-be28-4daa3a49d1cb" :answer/id #uuid "548a5160-ea2a-5460-be28-4daa3a49d1cb"] ["answer-548a5160-ea2a-5460-be28-4daa3a49d1cb" :answer/type :answer.type/math] ["answer-548a5160-ea2a-5460-be28-4daa3a49d1cb" :answer/value "-1"] ["answer-a5314088-f525-53ae-8f0e-c1cb3cc6d421" :answer/id #uuid "a5314088-f525-53ae-8f0e-c1cb3cc6d421"] ["answer-a5314088-f525-53ae-8f0e-c1cb3cc6d421" :answer/type :answer.type/math] ["answer-a5314088-f525-53ae-8f0e-c1cb3cc6d421" :answer/value "-2"] ["answer-b29fdb02-3b26-5216-8f4e-13b529bbcd39" :answer/id #uuid "b29fdb02-3b26-5216-8f4e-13b529bbcd39"] ["answer-b29fdb02-3b26-5216-8f4e-13b529bbcd39" :answer/type :answer.type/math] ["answer-b29fdb02-3b26-5216-8f4e-13b529bbcd39" :answer/value "-3"] ["answer-4a8a54af-e3aa-5606-a52d-b582cbbc8cca" :answer/id #uuid "4a8a54af-e3aa-5606-a52d-b582cbbc8cca"] ["answer-4a8a54af-e3aa-5606-a52d-b582cbbc8cca" :answer/type :answer.type/math] ["answer-4a8a54af-e3aa-5606-a52d-b582cbbc8cca" :answer/value "-\\frac{2}{3}"] ["answer-280517df-9242-59ab-bc3e-65af0d2d37ee" :answer/id #uuid "280517df-9242-59ab-bc3e-65af0d2d37ee"] ["answer-280517df-9242-59ab-bc3e-65af0d2d37ee" :answer/type :answer.type/math] ["answer-280517df-9242-59ab-bc3e-65af0d2d37ee" :answer/value "-\\frac{3}{2}"] ["answer-field-17f4d7b6-1d54-58dd-a546-544bac478642" :answer-field/key "selection"] ["answer-field-17f4d7b6-1d54-58dd-a546-544bac478642" :answer-field/type :answer-field.type/radio] ["answer-field-17f4d7b6-1d54-58dd-a546-544bac478642" :answer-field/correct "answer-548a5160-ea2a-5460-be28-4daa3a49d1cb"] ["answer-field-17f4d7b6-1d54-58dd-a546-544bac478642" :answer-field/choices "answer-548a5160-ea2a-5460-be28-4daa3a49d1cb"] ["answer-field-17f4d7b6-1d54-58dd-a546-544bac478642" :answer-field/choices "answer-a5314088-f525-53ae-8f0e-c1cb3cc6d421"] ["answer-field-17f4d7b6-1d54-58dd-a546-544bac478642" :answer-field/choices "answer-b29fdb02-3b26-5216-8f4e-13b529bbcd39"] ["answer-field-17f4d7b6-1d54-58dd-a546-544bac478642" :answer-field/choices "answer-4a8a54af-e3aa-5606-a52d-b582cbbc8cca"] ["answer-field-17f4d7b6-1d54-58dd-a546-544bac478642" :answer-field/choices "answer-280517df-9242-59ab-bc3e-65af0d2d37ee"] ["question-99569175-b9f3-5c01-983c-724e408918e3" :question/answer-fields "answer-field-17f4d7b6-1d54-58dd-a546-544bac478642"] [17592186119804 :knowledge-point/questions "question-99569175-b9f3-5c01-983c-724e408918e3"] ["question-ac43b1b5-6764-5241-bdc0-c6b7a39ba60f" :question/id #uuid "ac43b1b5-6764-5241-bdc0-c6b7a39ba60f"] ["question-ac43b1b5-6764-5241-bdc0-c6b7a39ba60f" :question/math-academy-id "q-35098"] ["question-ac43b1b5-6764-5241-bdc0-c6b7a39ba60f" :question/problem "Let $u=[\\begin{aligned}1 \\\\ 3 \\\\ 2 \\\\ 6\\end{aligned}]$ and $v=[\\begin{aligned}k \\\\ 4 \\\\ -5 \\\\ k+2\\end{aligned}].$ If $u\\cdot v=0$, find the value of $k.$"] ["question-ac43b1b5-6764-5241-bdc0-c6b7a39ba60f" :question/worked-solution "Starting from the equation $u\\cdot v=0,$ we compute the dot product in terms of $k$ and then solve for $k$ in the resulting equation:\n\n$$\n\\begin{aligned}u\\cdot v & =0 \\\\ 1\\cdot k+3\\cdot 4+2\\cdot (-5)+6\\cdot (k+2) & =0 \\\\ k+12-10+6k+12 & =0 \\\\ 7k+14 & =0 \\\\ 7k & =-14 \\\\ k & =-2\\end{aligned}\n$$\n\nTherefore, we conclude that $k=-2.$"] ["question-ac43b1b5-6764-5241-bdc0-c6b7a39ba60f" :question/difficulty :question.difficulty/moderate] ["answer-field-513e934d-104b-54ec-9e02-0f0638cf1a17" :answer-field/id #uuid "513e934d-104b-54ec-9e02-0f0638cf1a17"] ["answer-3c75b571-33fa-5088-b2e0-5d3674cd21af" :answer/id #uuid "3c75b571-33fa-5088-b2e0-5d3674cd21af"] ["answer-3c75b571-33fa-5088-b2e0-5d3674cd21af" :answer/type :answer.type/math] ["answer-3c75b571-33fa-5088-b2e0-5d3674cd21af" :answer/value "-2"] ["answer-7337f43d-3302-55c7-837c-201949c779c0" :answer/id #uuid "7337f43d-3302-55c7-837c-201949c779c0"] ["answer-7337f43d-3302-55c7-837c-201949c779c0" :answer/type :answer.type/math] ["answer-7337f43d-3302-55c7-837c-201949c779c0" :answer/value "-4"] ["answer-14c7e230-fd06-52b6-a9bf-f5d1185d3530" :answer/id #uuid "14c7e230-fd06-52b6-a9bf-f5d1185d3530"] ["answer-14c7e230-fd06-52b6-a9bf-f5d1185d3530" :answer/type :answer.type/math] ["answer-14c7e230-fd06-52b6-a9bf-f5d1185d3530" :answer/value "0"] ["answer-ab52cab0-c0f9-5d04-a911-88760c863129" :answer/id #uuid "ab52cab0-c0f9-5d04-a911-88760c863129"] ["answer-ab52cab0-c0f9-5d04-a911-88760c863129" :answer/type :answer.type/math] ["answer-ab52cab0-c0f9-5d04-a911-88760c863129" :answer/value "\\frac{16}{7}"] ["answer-d6c70620-90f9-5604-afb9-68b09a4d75d9" :answer/id #uuid "d6c70620-90f9-5604-afb9-68b09a4d75d9"] ["answer-d6c70620-90f9-5604-afb9-68b09a4d75d9" :answer/type :answer.type/math] ["answer-d6c70620-90f9-5604-afb9-68b09a4d75d9" :answer/value "\\frac{24}{7}"] ["answer-field-513e934d-104b-54ec-9e02-0f0638cf1a17" :answer-field/key "selection"] ["answer-field-513e934d-104b-54ec-9e02-0f0638cf1a17" :answer-field/type :answer-field.type/radio] ["answer-field-513e934d-104b-54ec-9e02-0f0638cf1a17" :answer-field/correct "answer-3c75b571-33fa-5088-b2e0-5d3674cd21af"] ["answer-field-513e934d-104b-54ec-9e02-0f0638cf1a17" :answer-field/choices "answer-3c75b571-33fa-5088-b2e0-5d3674cd21af"] ["answer-field-513e934d-104b-54ec-9e02-0f0638cf1a17" :answer-field/choices "answer-7337f43d-3302-55c7-837c-201949c779c0"] ["answer-field-513e934d-104b-54ec-9e02-0f0638cf1a17" :answer-field/choices "answer-14c7e230-fd06-52b6-a9bf-f5d1185d3530"] ["answer-field-513e934d-104b-54ec-9e02-0f0638cf1a17" :answer-field/choices "answer-ab52cab0-c0f9-5d04-a911-88760c863129"] ["answer-field-513e934d-104b-54ec-9e02-0f0638cf1a17" :answer-field/choices "answer-d6c70620-90f9-5604-afb9-68b09a4d75d9"] ["question-ac43b1b5-6764-5241-bdc0-c6b7a39ba60f" :question/answer-fields "answer-field-513e934d-104b-54ec-9e02-0f0638cf1a17"] [17592186119804 :knowledge-point/questions "question-ac43b1b5-6764-5241-bdc0-c6b7a39ba60f"] [17592186121062 :tutorial/content "To add two vectors in $\\mathbb{R}^n,$ we just need to add their corresponding components. To illustrate, consider the vectors $\\mathbf{a},\\mathbf{b} \\in \\mathbb{R}^4,$ given by\n\n![](images/1f/1f1b79f2e61fccbb27944284cbdd217a311a7f795100cfbb56340a457814b407.svg)\n\nTo compute $\\mathbf{a} + \\mathbf{b},$ all we have to do is to add each component of the vector $\\mathbf{a}$ with the corresponding component of $\\mathbf{b}.$ Doing this, we get\n\n$$\n\\begin{aligned}a+b & =[\\begin{aligned}5 \\\\ 1 \\\\ -3 \\\\ 6\\end{aligned}]+[\\begin{aligned}-5 \\\\ 3 \\\\ 1 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}5+(-5) \\\\ 1+3 \\\\ -3+1 \\\\ 6+0\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 4 \\\\ -2 \\\\ 6\\end{aligned}].\\end{aligned}\n$$\n\nWe can only compute the sum, difference, or dot product of two vectors if both vectors have the same number of components. For example, we can't find the following sum, so we say it's *undefined*:\n![](images/6c/6c377966aa9fa1d581c0f9e3ba16bceb4020471914d5c4fb61118ff7cd709466.svg)"] [17592186121033 :tutorial/content "In general, if we have two vectors $\\mathbf{u},\\mathbf{v}\\in\\mathbb{R}^n$ and a scalar $\\lambda\\in\\mathbb{R},$ then our vector operations are defined as follows:\n\n1\\. The **sum/difference** of the two vectors is defined as\n  ![](images/fc/fc78b2f4e9262108a217e57fec67e096b8b8b18e1486bec8e51df60b8afdfdfa.svg)\n\n2\\. **Scalar multiplication** of a vector is defined as\n  ![](images/e7/e78025f3481423365b2e924b6f8ba4e59f41e0c644ced7d2263238b219cba27a.svg)\n\n3\\. The **dot product** of two vectors is defined as\n\n  $$\n  \\quad \\mathbf{u}\\cdot\\mathbf{v} = \\underbrace{u_1 \\cdot v_1 + u_2 \\cdot v_2 + \\cdots + u_n \\cdot v_n}_{\\Large{n} \\,\\textrm{-terms}} = \\sum_{i=1}^n u_i v_i.\n  $$"]] "retractions" [[17592186120373 :question/problem "Let $u = \\begin{bmatrix}1 \\\\ -1 \\\\ 1 \\\\ 2\\end{bmatrix}$ and $v = \\begin{bmatrix}2 \\\\ -5 \\\\ 1 \\\\ 0\\end{bmatrix}$. What is $(2u) \\cdot v$?"] [17592186121062 :tutorial/content "To add two vectors in $\\mathbb{R}^n,$ we just need to add their corresponding components. To illustrate, consider the vectors $\\mathbf{a},\\mathbf{b} \\in \\mathbb{R}^4,$ given by\n\n![](images/1f/1f1b79f2e61fccbb27944284cbdd217a311a7f795100cfbb56340a457814b407.svg)\n\nTo compute $\\mathbf{a} + \\mathbf{b},$ all we have to do is to add each component of the vector $\\mathbf{a}$ with the corresponding component of $\\mathbf{b}.$ Doing this, we get\n\n$$\n\\begin{aligned}a+b & =\\begin{bmatrix}5 \\\\ 1 \\\\ -3 \\\\ 6\\end{bmatrix}+\\begin{bmatrix}-5 \\\\ 3 \\\\ 1 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}5+(-5) \\\\ 1+3 \\\\ -3+1 \\\\ 6+0\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 \\\\ 4 \\\\ -2 \\\\ 6\\end{bmatrix}.\\end{aligned}\n$$\n\nWe can only compute the sum, difference, or dot product of two vectors if both vectors have the same number of components. For example, we can't find the following sum, so we say it's *undefined*:\n![](images/6c/6c377966aa9fa1d581c0f9e3ba16bceb4020471914d5c4fb61118ff7cd709466.svg)"] [17592186121033 :tutorial/content "In general, if we have two vectors $\\mathbf{u},\\mathbf{v}\\in\\mathbb{R}^n$ and a scalar $\\lambda\\in\\mathbb{R},$ then our vector operations are defined as follows:\n\n- The **sum/difference** of the two vectors is defined as\n![](images/fc/fc78b2f4e9262108a217e57fec67e096b8b8b18e1486bec8e51df60b8afdfdfa.svg)\n\n- **Scalar multiplication** of a vector is defined as\n![](images/e7/e78025f3481423365b2e924b6f8ba4e59f41e0c644ced7d2263238b219cba27a.svg)\n\n- The **dot product** of two vectors is defined as\n\n$$\n\\quad \\mathbf{u}\\cdot\\mathbf{v} = \\underbrace{u_1 \\cdot v_1 + u_2 \\cdot v_2 + \\cdots + u_n \\cdot v_n}_{\\Large{n} \\,\\textrm{-terms}} = \\sum_{i=1}^n u_i v_i.\n$$"]]}]