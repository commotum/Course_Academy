-d0c8046f8e6c" "answer-19f053af-c94a-5c7b-a41a-ccc081521fa3" "answer-7216454c-ed63-547f-894e-d36dbdb1f804" "answer-01b71c62-6f9d-5a55-b388-591a5c389ad6" "answer-1c97c416-eba8-5fdb-837f-7b4da0e417d7"] :db/ensure [:answer-field/validate]} {:db/id "answer-5e798b1b-86d7-5e28-83af-d0c8046f8e6c" :answer/id #uuid "5e798b1b-86d7-5e28-83af-d0c8046f8e6c" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 \\\\ 6 \\\\ -13 \\\\ -7 \\\\ -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-19f053af-c94a-5c7b-a41a-ccc081521fa3" :answer/id #uuid "19f053af-c94a-5c7b-a41a-ccc081521fa3" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 \\\\ 6 \\\\ -13 \\\\ -7\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-7216454c-ed63-547f-894e-d36dbdb1f804" :answer/id #uuid "7216454c-ed63-547f-894e-d36dbdb1f804" :answer/type :answer.type/math :answer/value "[\\begin{aligned}4 \\\\ -2 \\\\ 3 \\\\ 7 \\\\ -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-01b71c62-6f9d-5a55-b388-591a5c389ad6" :answer/id #uuid "01b71c62-6f9d-5a55-b388-591a5c389ad6" :answer/type :answer.type/math :answer/value "[\\begin{aligned}4 \\\\ -2 \\\\ 3 \\\\ 7\\text{ }\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-1c97c416-eba8-5fdb-837f-7b4da0e417d7" :answer/id #uuid "1c97c416-eba8-5fdb-837f-7b4da0e417d7" :answer/type :answer.type/text :answer/value "Undefined" :db/ensure [:answer/validate]} {:db/id 17592186120373 :question/problem "Let $u=[\\begin{aligned}1 \\\\ -1 \\\\ 1 \\\\ 2\\end{aligned}]$ and $v=[\\begin{aligned}2 \\\\ -5 \\\\ 1 \\\\ 0\\end{aligned}].$ What is $(2u)\\cdot v?$" :question/worked-solution "First, multiplying each component of $u$ by $2$, we get\n\n$$\n\\begin{aligned}2u & =2[\\begin{aligned}1 \\\\ -1 \\\\ 1 \\\\ 2\\end{aligned}]=[\\begin{aligned}2 \\\\ -2 \\\\ 2 \\\\ 4\\end{aligned}]\\,.\\end{aligned}\n$$\n\nTo compute the dot product, we add up the products of corresponding components:\n\n$$\n\\begin{aligned}(2u)\\cdot v & =2\\cdot 2+(-2)\\cdot (-5)+2\\cdot 1+4\\cdot 0 \\\\  & =4+10+2+0 \\\\  & =16\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186118352 :answer-field/correct 17592186118353 :db/ensure [:answer-field/validate]} {:db/id "question-99f979f5-50b6-5282-8195-712172f0dd94" :question/id #uuid "99f979f5-50b6-5282-8195-712172f0dd94" :question/math-academy-id "q-105106" :question/problem "Let $r=[\\begin{aligned}10 \\\\ 0 \\\\ 7 \\\\ 1\\end{aligned}]$ and $s=[\\begin{aligned}2 \\\\ 12 \\\\ -3 \\\\ 4 \\\\ 3\\end{aligned}].$ What is $r\\cdot s?$" :question/worked-solution "Let's examine our vectors:\n\n- The vector $r=[\\begin{aligned}10 \\\\ 0 \\\\ 7 \\\\ 1\\end{aligned}]$ has $4$ components as it lies in ${R}^{4}.$\n\n- The vector $s=[\\begin{aligned}2 \\\\ 12 \\\\ -3 \\\\ 4 \\\\ 3\\end{aligned}]$ has $5$ components as it lies in ${R}^{5}.$\n\nTherefore, since the number of components does not match, the operation is undefined." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-0fb98a7f-ad8a-5e6c-a75e-a840dc8becf9"] :db/ensure [:question/validate]} {:db/id "answer-field-0fb98a7f-ad8a-5e6c-a75e-a840dc8becf9" :answer-field/id #uuid "0fb98a7f-ad8a-5e6c-a75e-a840dc8becf9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-16cbb84b-4b49-534a-9632-2742c64dc828" :answer-field/choices ["answer-e450beec-fb91-51ce-9266-c0780d069541" "answer-3d40e247-e7a6-52d9-b061-d0eb12e43950" "answer-99bc17e3-08dd-536d-b086-370a117aaf2b" "answer-7449c50e-1ec7-5e2c-ab02-d370a373173c" "answer-16cbb84b-4b49-534a-9632-2742c64dc828"] :db/ensure [:answer-field/validate]} {:db/id "answer-e450beec-fb91-51ce-9266-c0780d069541" :answer/id #uuid "e450beec-fb91-51ce-9266-c0780d069541" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-3d40e247-e7a6-52d9-b061-d0eb12e43950" :answer/id #uuid "3d40e247-e7a6-52d9-b0