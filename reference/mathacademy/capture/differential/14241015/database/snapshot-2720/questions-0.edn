 Multiple of a Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53101337-d24a-559b-aa8f-cdbf301c4b57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ -6 \\\\ 0 \\\\ -20\\end{aligned}]" :db/id #edb/ref 17592186559227} {:answer/id #uuid "5ad9bb18-360a-538c-adbd-c7e0b9b61ec2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ -6 \\\\ 0 \\\\ -5\\end{aligned}]" :db/id #edb/ref 17592186559251} {:answer/id #uuid "62c4b9af-c6a5-5f58-aa80-5f7a54467f01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 \\\\ 3 \\\\ 0 \\\\ 10\\end{aligned}]" :db/id #edb/ref 17592186559264} {:answer/id #uuid "def44a4e-8710-5f00-857e-2e3e545ebdcf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ -6 \\\\ -2 \\\\ -20\\end{aligned}]" :db/id #edb/ref 17592186559563} {:answer/id #uuid "df2309da-74e6-5056-a5cb-efe8ef129faf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ -6 \\\\ -2 \\\\ -5\\end{aligned}]" :db/id #edb/ref 17592186559565}] :answer-field/correct {:answer/id #uuid "53101337-d24a-559b-aa8f-cdbf301c4b57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ -6 \\\\ 0 \\\\ -20\\end{aligned}]" :db/id #edb/ref 17592186559227} :answer-field/id #uuid "be6c4f4d-2ffc-56dc-bc2a-4afe7b023e22" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186559743}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dc18df10-64c6-5957-81d9-6515439cccbe" :question/math-academy-id "q-73925" :question/problem "If $v=[\\begin{aligned}-1 \\\\ 3 \\\\ 0 \\\\ 10\\end{aligned}]$, th