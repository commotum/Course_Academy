ef 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186559687}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ac43b1b5-6764-5241-bdc0-c6b7a39ba60f" :question/math-academy-id "q-35098" :question/problem "Let $u=[\\begin{aligned}1 \\\\ 3 \\\\ 2 \\\\ 6\\end{aligned}]$ and $v=[\\begin{aligned}k \\\\ 4 \\\\ -5 \\\\ k+2\\end{aligned}].$ If $u\\cdot v=0$, find the value of $k.$" :question/worked-solution "Starting from the equation $u\\cdot v=0,$ we compute the dot product in terms of $k$ and then solve for $k$ in the resulting equation:\n\n$$\n\\begin{aligned}u\\cdot v & =0 \\\\ 1\\cdot k+3\\cdot 4+2\\cdot (-5)+6\\cdot (k+2) & =0 \\\\ k+12-10+6k+12 & =0 \\\\ 7k+14 & =0 \\\\ 7k & =-14 \\\\ k & =-2\\end{aligned}\n$$\n\nTherefore, we conclude that $k=-2.$"}] [{:db/id #edb/ref 17592186559862 :knowledge-point/_questions [{:db/id #edb/ref 17592186119802 :knowledge-point/id #uuid "ab0d2c2f-e7a4-51bb-a20a-f28c2f7ded8b" :knowledge-point/title "Adding Multiples of Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fb27b9d-e0b3-575f-a7ec-6b6b43a21ec1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-13 \\\\ 7 \\\\ 3 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186559051} {:answer/id #uuid "1dbf7ce5-b72e-5ccf-b276-d2aa0f21eec6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186559089} {:answer/id #uuid "39f285c4-7742-53a9-80f0-ae34c34ca4c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-5 \\\\ 11 \\\\ 6\\end{aligned}]" :db/id #edb/ref 17592186559159} {:answer/id #uuid "4ae31e67-f29a-5c5d-8999-21dab43f94e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-14 \\\\ 2 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186559210} {:a