igned}4 \\\\ 20 \\\\ -4 \\\\ -8 \\\\ 7\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{4}\\cdot 4 \\\\ \\frac{1}{4}\\cdot 20 \\\\ \\frac{1}{4}\\cdot (-4) \\\\ \\frac{1}{4}\\cdot (-8) \\\\ \\frac{1}{4}\\cdot 7\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 5 \\\\ -1 \\\\ -2 \\\\ \\frac{7}{4}\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186559845 :knowledge-point/_questions [{:db/id #edb/ref 17592186119802 :knowledge-point/id #uuid "ab0d2c2f-e7a4-51bb-a20a-f28c2f7ded8b" :knowledge-point/title "Adding Multiples of Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "033d36c0-a58c-503e-8ea9-e8a6b0e9f4bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ 13 \\\\ 18 \\\\ 18 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186559026} {:answer/id #uuid "16fd313a-3358-5664-a840-4e611df4cb3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ 13 \\\\ 18 \\\\ 18\\end{aligned}]" :db/id #edb/ref 17592186559068} {:answer/id #uuid "447336ff-38cc-5606-a1e8-a716b7b2f8be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186559196} {:answer/id #uuid "842d59a6-7999-5384-b6a7-abbcfb68ac22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 \\\\ 14 \\\\ 18 \\\\ 22\\end{aligned}]" :db/id #edb/ref 17592186559347} {:answer/id #uuid "b08e7057-bff1-5294-98dd-a8af27f11fb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 \\\\ 14 \\\\ 18 \\\\ 22 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186559457}] :answer-field/correct {:answer/id #uuid "447336ff-38cc-5606-a1e8-a716b7b2f8be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186559196} :answer-field/id #uuid "0abe482e-6838-5c0