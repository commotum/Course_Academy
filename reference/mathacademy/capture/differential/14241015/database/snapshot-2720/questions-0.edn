6 \\\\ 15 \\\\ -3\\end{bmatrix}" :db/id #edb/ref 17592186341038} :answer-field/id #uuid "892def45-fd05-566e-afd6-be2b00ed2ed5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341620}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "56215786-6dd7-5900-942c-c24344ff27f3" :question/math-academy-id "q-73927" :question/problem "If $v=\\begin{bmatrix}0 \\\\ 2 \\\\ 5 \\\\ -1\\end{bmatrix}$, then $3v=$" :question/worked-solution "Multiplying each component of $v$ by $3,$ we get\n\n$$\n\\begin{aligned}3v & =3\\begin{bmatrix}0 \\\\ 2 \\\\ 5 \\\\ -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}3\\cdot 0 \\\\ 3\\cdot 2 \\\\ 3\\cdot 5 \\\\ 3\\cdot (-1)\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 \\\\ 6 \\\\ 15 \\\\ -3\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186364351 :knowledge-point/_questions [{:db/id #edb/ref 17592186119803 :knowledge-point/id #uuid "ec386a91-fc52-56d8-8531-7e78a8464380" :knowledge-point/title "Calculating the Dot Product of Two Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "94684f50-85e0-5b16-9c76-e95d6f808b63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186364353} {:answer/id #uuid "8d44af52-39c0-527a-88ac-1519f75188fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186364354} {:answer/id #uuid "bf0c3a86-73bf-5d01-8251-12828d9e1549" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186364355} {:answer/id #uuid "d3bb01ba-40c0-5f98-b056-df025d672b26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186364356} {:answer/id #uuid "f6a2b666-c962-5379-b707-fb1c31bee037" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186364357}] :answer-field/correct {:answer/id #uuid "94684f50-85e0-5b16-9c76-e95d6f808b63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186364353} :answer-field/id #uuid "017cd05d-71b2-5588-bbdd-a05d4d8d7193" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186364352}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6ddc2331-5b16-5155-80a8-cc824617edac" :question/math-academy-id "q-73938" :question/problem "If $r=\\begin{bmatrix}1 \\\\ -1 \\\\ 3 \\\\ 5 \\\\ 2\\end{bmatrix}$ and $s=\\begin{bmatrix}3 \\\\ -4 \\\\ 1 \\\\ 1 \\\\ -2\\end{bmatrix}$, then $r\\cdot s=$" :question/worked-solution "To compute the dot product, we add up the products of corresponding components:\n\n$$\n\\begin{aligned}r\\cdot s & ={r}_{1}\\cdot {s}_{1}+{r}_{2}\\cdot {s}_{2}+{r}_{3}\\cdot {s}_{3}+{r}_{4}\\cdot {s}_{4}+{r}_{5}\\cdot {s}_{5} \\\\  & =1\\cdot 3+(-1)\\cdot (-4)+3\\cdot 1+5\\cdot 1+2\\cdot (-2) \\\\  & =3+4+3+5-4 \\\\  & =11\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186342112 :knowledge-point/_questions [{:db/id #edb/ref 17592186119803 :knowledge-point/id #uuid "ec386a91-fc52-56d8-8531-7e78a8464380" :knowledge-point/title "Calculating the Dot Product of Two Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43d96809-e3dd-5fef-aec9-43b2a849f964" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186339725} {:answer/id #uuid "53143a70-d722-51cd-8e2b-e4e20cc2d282" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186339893} {:answer/id #uuid "707f529c-3710-523a-9777-24e6935aad7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186340126} {:answer/id #uuid "ea6b0a98-b813-579e-9675-d74b38ae8281" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186341199} {:answer/id #uuid "f11c1ac8-7991-5f39-84b0-28a20d7bcaf6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186341253}] :answer-field/correct {:answer/id #uuid "f11c1ac8-7991-5f39-84b0-28a20d7bcaf6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186341253} :answer-field/id #uuid "eef3e121-56c7-5a3b-bf87-c4536c1b03a4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341808}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7fa0bdb5-f053-5d67-8f95-d145fa39b1e1" :question/math-academy-id "q-73939" :question/problem "Let $a=\\begin{bmatrix}4 \\\\ -2 \\\\ 2 \\\\ 6 \\\\ 10\\end{bmatrix}$ and $b=\\begin{bmatrix}5 \\\\ -3 \\\\ 1 \\\\ 0 \\\\ 2\\end{bmatrix}.$ What is $(\\frac{1}{2}a)\\cdot b?$" :question/worked-solution "First, multiplying each component of $a$ by $\\frac{1}{2}$, we get\n\n$$\n\\begin{aligned}\\frac{1}{2}a & =\\frac{1}{2}\\begin{bmatrix}4 \\\\ -2 \\\\ 2 \\\\ 6 \\\\ 10\\end{bmatrix}=\\begin{bmatrix}2 \\\\ -1 \\\\ 1 \\\\ 3 \\\\ 5\\end{bmatrix}\\,.\\end{aligned}\n$$\n\nTo compute the dot product, we add up the products of corresponding components:\n\n$$\n\\begin{aligned}(\\frac{1}{2}a)\\cdot b & =2\\cdot 5+(-1)\\cdot (-3)+1\\cdot 1+3\\cdot 0+5\\cdot 2 \\\\  & =10+3+1+0+10 \\\\  & =24\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186559795 :knowledge-point/_questions [{:db/id #edb/ref 17592186119804 :knowledge-point/id #uuid "94f8e0e5-8d8a-516a-8f46-d76e94305df4" :knowledge-point/title "Finding the Value of an Unknown Quantity in an Expression Involving the Dot Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b14a075-42dc-5acb-b0ba-f7abb08019c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186559078} {:answer/id #uuid "3e03f259-c4ff-5558-b956-a6de172b8d43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186559177} {:answer/id #uuid "41ca8a64-2cf5-52f3-9711-01557d3f9064" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186559184} {:answer/id #uuid "5e6868a9-5b3e-5e84-a960-5b86e70a2ee6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186559257} {:answer/id #uuid "681716cd-d4da-5905-8de6-fe282cc9d42b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186559275}] :answer-field/correct {:answer/id #uuid "41ca8a64-2cf5-52f3-9711-01557d3f9064" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186559184} :answer-field/id #uuid "4b8ec564-aa1b-5852-8d2e-5e288d532861" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186559682}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "36b464cf-4c70-5aa3-a6c7-ba1498951d9c" :question/math-academy-id "q-73943" :question/problem "Let\n$r=[\\begin{aligned}x-2 \\\\ 2 \\\\ -3 \\\\ 1 \\\\ 1\\end{aligned}]$ and $s=[\\begin{aligned}1 \\\\ 3 \\\\ x \\\\ -2 \\\\ 1\\end{aligned}].$\nIf $r\\cdot s=7$, find the value of $x.$" :question/worked-solution "Starting from the equation $r\\cdot s=7,$ we compute the dot product in terms of $x$ and then solve for $x$ in the resulting equation:\n\n$$\n\\begin{aligned}r\\cdot s & =7 \\\\ (x-2)\\cdot 1+2\\cdot 3+(-3)\\cdot x+1\\cdot (-2)+1\\cdot 1 & =7 \\\\ x-2+6-3x-2+1 & =7 \\\\ -2x+3 & =7 \\\\ 2x & =-4 \\\\ x & =-2\\end{aligned}\n$$\n\nTherefore, we conclude that $x=-2.$"}] [{:db/id #edb/ref 17592186559879 :knowledge-point/_questions [{:db/id #edb/ref 17592186119804 :knowledge-point/id #uuid "94f8e0e5-8d8a-516a-8f46-d76e94305df4" :knowledge-point/title "Finding the Value of an Unknown Quantity in an Expression Involving the Dot Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "444efbe8-dff8-5c45-a4c6-ad837d7e5d57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186559194} {:answer/id #uuid "87e9f515-7eb3-5e62-a8a0-a8403b398027" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186559355} {:answer/id #uuid "b5008f77-48d1-5bb2-ba5f-fe9365aea196" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186559469} {:answer/id #uuid "d0c098d1-7ef1-5ad1-b259-c1614202d6d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186559522} {:answer/id #uuid "d290f871-27b8-5194-87df-869b3c3e63ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186559534}] :answer-field/correct {:answer/id #uuid "d0c098d1-7ef1-5ad1-b259-c1614202d6d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186559522} :answer-field/id #uuid "3e1fad6f-855e-553e-8d75-e321cc680343" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186559675}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ea418b13-9cd8-58b9-8c0f-d233456f224d" :question/math-academy-id "q-73944" :question/problem "Let\n$v=[\\begin{aligned}-2 \\\\ p \\\\ 5 \\\\ -2 \\\\ -3\\end{aligned}]$ and $w=[\\begin{aligned}2 \\\\ -4 \\\\ 3 \\\\ -3 \\\\ p\\end{aligned}].$\nIf $v\\cdot w=3$, find the value of $p.$" :question/worked-solution "Starting from the equation $v\\cdot w=3,$ we compute the dot product in terms of $p$ and then solve for $p$ in the resulting equation:\n\n$$\n\\begin{aligned}v\\cdot w & =3 \\\\ -2\\cdot 2+p\\cdot (-4)+5\\cdot 3+(-2)\\cdot (-3)+(-3)\\cdot p & =3 \\\\ -4-4p+15+6-3p & =3 \\\\ -7p+17 & =3 \\\\ 7p & =14 \\\\ p & =2\\end{aligned}\n$$\n\nTherefore, we conclude that $p=2.$"}] [{:db/id #edb/ref 17592186559834 :knowledge-point/_questions [{:db/id #edb/ref 17592186119804 :knowledge-point/id #uuid "94f8e0e5-8d8a-516a-8f46-d76e94305df4" :knowledge-point/title "Finding the Value of an Unknown Quantity in an Expression Involving the Dot Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "280517df-9242-59ab-bc3e-65af0d2d37ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186559115} {:answer/id #uuid "4a8a54af-e3aa-5606-a52d-b582cbbc8cca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186559209} {:answer/id #uuid "548a5160-ea2a-5460-be28-4daa3a49d1cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186559231} {:answer/id #uuid "a5314088-f525-53ae-8f0e-c1cb3cc6d421" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186559430} {:answer/id #uuid "b29fdb02-3b26-5216-8f4e-13b529bbcd39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186559461}] :answer-field/correct {:answer/id #uuid "548a5160-ea2a-5460-be28-4daa3a49d1cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186559231} :answer-field/id #uuid "17f4d7b6-1d54-58dd-a546-544bac478642" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186559653}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "99569175-b9f3-5c01-983c-724e408918e3" :question/math-academy-id "q-73947" :question/problem "Let $r=[\\begin{aligned}3 \\\\ \\frac{2}{{x}^{2}} \\\\ 0 \\\\ x\\end{aligned}]$ and $s=[\\begin{aligned}-1 \\\\ {x}^{4} \\\\ 8 \\\\ -1\\end{aligned}].$\nIf $r\\cdot s=0$ and $x<0$, find the value of $x.$" :question/worked-solution "Starting from the equation $r\\cdot s=0,$ we compute the dot product in terms of $x$ and then solve for $x$ in the resulting equation:\n\n$$\n\\begin{aligned}r\\cdot s & =0 \\\\ 3\\cdot (-1)+\\frac{2}{{x}^{2}}\\cdot {x}^{4}+0\\cdot 8+x\\cdot (-1) & =0 \\\\ -3+2{x}^{2}+0-x & =0 \\\\ 2{x}^{2}-x-3 & =0\\end{aligned}\n$$\n\nNow, using the quadratic formula, we obtain\n\n$$\n\\begin{aligned}x & =\\frac{-(-1)\\pm \\sqrt{(-1)^{2}-4(2)(-3)}}{2(2)} \\\\  & =\\frac{1\\pm \\sqrt{25}}{4} \\\\  & =\\frac{1\\pm 5}{4}.\\end{aligned}\n$$\n\nSo, we get two solutions, ${x}_{1}=\\frac{3}{2}$ and ${x}_{2}=-1.$ Since we need $x<0$, our final answer is $x=-1$ only."}]}
