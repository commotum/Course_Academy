db/ref 17592186559666 #edb/ref 17592186045417] [17592186559791 #edb/ref 1069 "q-105094" #edb/ref 17592186045417] [17592186559791 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186559791 #edb/ref 1071 "Let $a=[\\begin{aligned}-7 \\\\ 2 \\\\ 2 \\\\ -3 \\\\ 6\\end{aligned}].$ Find $2a.$" #edb/ref 17592186045417] [17592186559791 #edb/ref 1072 #uuid "34bb1a50-1857-5b83-b60b-483ccca13301" #edb/ref 17592186045417] [17592186559791 #edb/ref 1074 "Multiplying each component of $a$ by $2,$ we get\n\n$$\n\\begin{aligned}2a & =2[\\begin{aligned}-7 \\\\ 2 \\\\ 2 \\\\ -3 \\\\ 6\\end{aligned}] \\\\  & =[\\begin{aligned}2\\cdot (-7) \\\\ 2\\cdot 2 \\\\ 2\\cdot 2 \\\\ 2\\cdot (-3) \\\\ 2\\cdot 6\\end{aligned}] \\\\  & =[\\begin{aligned}-14 \\\\ 4 \\\\ 4 \\\\ -6 \\\\ 12\\end{aligned}].\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186559795 #edb/ref 1068 #edb/ref 17592186559682 #edb/ref 17592186045417] [17592186559795 #edb/ref 1069 "q-73943" #edb/ref 17592186045417] [17592186559795 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186559795 #edb/ref 1071 "Let\n$r=[\\begin{aligned}x-2 \\\\ 2 \\\\ -3 \\\\ 1 \\\\ 1\\end{aligned}]$ and $s=[\\begin{aligned}1 \\\\ 3 \\\\ x \\\\ -2 \\\\ 1\\end{aligned}].$\nIf $r\\cdot s=7$, find the value of $x.$" #edb/ref 17592186045417] [17592186559795 #edb/ref 1072 #uuid "36b464cf-4c70-5aa3-a6c7-ba1498951d9c" #edb/ref 17592186045417] [17592186559795 #edb/ref 1074 "Starting from the equation $r\\cdot s=7,$ we compute the dot product in terms of $x$ and then solve for $x$ in the resulting equation:\n\n$$\n\\begin{aligned}r\\cdot s & =7 \\\\ (x-2)\\cdot 1+2\\cdot 3+(-3)\\cdot x+1\\cdot (-2)+1\\cdot 1 & =7 \\\\ x-2+6-3x-2+1 & =7 \\\\ -2x+3 & =7 \\\\ 2x & =-4 \\\\ x & =-2\\end{aligned}\n$$\n\nTherefore, we conclude that $x=-2.$" #edb/ref 17592186045417] [17592186559803 #edb/ref 1068 #edb/ref 17592186559681 #edb/ref 17592186045417] [17592186559803 #edb/ref 1069 "q-35096" #edb/ref 17592186045417] [17592186559803 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186559803 #edb/ref 1071 "Let $b=[\\begin{aligned}1 \\\\ 2 \\\\ -5 \\\\ 0 \\\\ -1\\end{aligned}]$ and $c=[\\begin{aligned}3 \\\\ -4 \\\\ 8 \\\\ 7\\end{aligned}].$ Find $b+c.$" #edb/ref 17592186045417] [17592186559803 #edb/ref 1072 #uuid "457dac21-00fa-5025-808b-b3e414ce1988" #edb/ref 17592186045417] [17592186559803 #edb/ref 1074 "Let's examine our vectors:\n\n- The vector $b=[\\begin{aligned}1 \\\\ 2 \\\\ -5 \\\\ 0 \\\\ -1\\end{aligned}]$ has $5$ components as it lies in ${R}^{5}.$\n\n- The vector $c=[\\begin{aligned}3 \\\\ -4 \\\\ 8 \\\\ 7\\end{aligned}]$ has $4$ components as it lies in ${R}^{4}.$\n\nTherefore, since the number of components does not match, the operation is undefined." #edb/ref 17592186045417] [17592186559834 #edb/ref 1068 #edb/ref 17592186559653 #edb/ref 17592186045417] [17592186559834 #edb/ref 1069 "q-73947" #edb/ref 17592186045417] [17592186559834 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186559834 #edb/ref 1071 "Let $r=[\\begin{aligned}3 \\\\ \\frac{2}{{x}^{2}} \\\\ 0 \\\\ x\\end{aligned}]$ and $s=[\\begin{aligned}-1 \\\\ {x}^{4} \\\\ 8 \\\\ -1\\end{aligned}].$\nIf $r\\cdot s=0$ and $x<0$, find the value of $x.$" #edb/ref 17592186045417] [17592186559834 #edb/ref 1072 #uuid "99569175-b9f3-5c01-983c-724e408918e3" #edb/ref 17592186045417] [17592186559834 #edb/ref 1074 "Starting from the equation $r\\cdot s=0,$ we compute the dot product in terms of $x$ and then solve for $x$ in the resulting equation:\n\n$$\n\\begin{aligned}r\\cdot s & =0 \\\\ 3\\cdot (-1)+\\frac{2}{{x}^{2}}\\cdot {x}^{4}+0\\cdot 8+x\\cdot (-1) & =0 \\\\ -3+2{x}^{2}+0-x & =0 \\\\ 2{x}^{2}-x-3 & =0\\end{aligned}\n$$\n\nNow, using the quadratic formula, we obtain\n\n$$\n\\begin{aligned}x & =\\frac{-(-1)\\pm \\sqrt{(-1)^{2}-4(2)(-3)}}{2(2)} \\\\  & =\\frac{1\\pm \\sqrt{25}}{4} \\\\  & =\\frac{1\\pm 5}{4}.\\end{aligned}\n$$\n\nSo, we get two solutions, ${x}_{1}=\\frac{3}{2}$ and ${x}_{2}=-1.$ Since we need $x<0$, our final answer is $x=-1$ only." #edb/ref 17592186045417] [17592186559836 #edb/ref 1068 #edb/ref 17592186559646 #edb/ref 17592186045417] [17592186559836 #edb/ref 1069 "q-105106" #edb/ref 17592186045417] [17592186559836 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186559836 #edb/ref 1071 "Let $r=[\\begin{aligned}10 \\\\ 0 \\\\ 7 \\\\ 1\\end{aligned}]$ and $s=[\\begin{aligned}2 \\\\ 12 \\\\ -3 \\\\ 4 \\\\ 3\\end{aligned}].$ What is $r\\cdot s?$" #edb/ref 17592186045417] [17592186559836 #edb/ref 1072 #uuid "99f979f5-50b6-5282-8195-712172f0dd94" #edb/ref 17592186045417] [17592186559836 #edb/ref 1074 "Let's examine our vectors:\n\n- The vector $r=[\\begin{aligned}10 \\\\ 0 \\\\ 7 \\\\ 1\\end{aligned}]$ has $4$ components as it lies in ${R}^{4}.$\n\n- The vector $s=[\\begin{aligned}2 \\\\ 12 \\\\ -3 \\\\ 4 \\\\ 3\\end{aligned}]$ has $5$ components as it lies in ${R}^{5}.$\n\nTherefore, since the number of components does not match, the operation is undefined." #edb/ref 17592186045417] [17592186559840 #edb/ref 1068 #edb/ref 17592186559687 #edb/ref 17592186045417] [17592186559840 #edb/ref 1069 "q-35098" #edb/ref 17592186045417] [17592186559840 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186559840 #edb/ref 1071 "Let $u=[\\begin{aligned}1 \\\\ 3 \\\\ 2 \\\\ 6\\end{aligned}]$ and $v=[\\begin{aligned}k \\\\ 4 \\\\ -5 \\\\ k+2\\end{aligned}].$ If $u\\cdot v=0$, find the value of $k.$" #edb/ref 17592186045417] [17592186559840 #edb/ref 1072 #uuid "ac43b1b5-6764-5241-bdc0-c6b7a39ba60f" #edb/ref 17592186045417] [17592186559840 #edb/ref 1074 "Starting from the equation $u\\cdot v=0,$ we compute the dot product in terms of $k$ and then solve for $k$ in the resulting equation:\n\n$$\n\\begin{aligned}u\\cdot v & =0 \\\\ 1\\cdot k+3\\cdot 4+2\\cdot (-5)+6\\cdot (k+2) & =0 \\\\ k+12-10+6k+12 & =0 \\\\ 7k+14 & =0 \\\\ 7k & =-14 \\\\ k & =-2\\end{aligned}\n$$\n\nTherefore, we conclude that $k=-2.$" #edb/ref 17592186045417] [17592186559845 #edb/ref 1068 #edb/ref 17592186559644 #edb/ref 17592186045417] [17592186559845 #edb/ref 1069 "q-105101" #edb/ref 17592186045417] [17592186559845 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186559845 #edb/ref 1071 "Let $v=[\\begin{aligned}1 \\\\ 6 \\\\ 9 \\\\ 7 \\\\ 0\\end{aligned}]$ and $w=[\\begin{aligned}8 \\\\ 4 \\\\ 0 \\\\ 16\\end{aligned}].$ Find $2v+\\frac{1}{4}w.$" #edb/ref 17592186045417] [17592186559845 #edb/ref 1072 #uuid "b2fb6e56-ff2e-5614-a5dd-38bf8fc25970" #edb/ref 17592186045417] [17592186559845 #edb/ref 1074 "Let's examine our vectors:\n\n- The vector $v=[\\begin{aligned}1 \\\\ 6 \\\\ 9 \\\\ 7 \\\\ 0\\end{aligned}]$ has $5$ components as it lies in ${R}^{5}.$\n\n- The vector $w=[\\begin{aligned}8 \\\\ 4 \\\\ 0 \\\\ 16\\end{aligned}]$ has $4$ components as it lies in ${R}^{4}.$\n\nTherefore, since the number of components does not match, the operation is undefined." #edb/ref 17592186045417] [17592186559862 #edb/ref 1068 #edb/ref 17592186559747 #edb/ref 17592186045417] [17592186559862 #edb/ref 1069 "q-35120" #edb/ref 17592186045417] [17592186559862 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186559862 #edb/ref 1071 "Let $u=[\\begin{aligned}-7 \\\\ 1 \\\\ 0\\end{aligned}]$ and $v=[\\begin{aligned}1 \\\\ 5 \\\\ 3 \\\\ 0\\end{aligned}].$ Find $u+2v.$" #edb/ref 17592186045417] [17592186559862 #edb/ref 1072 #uuid "cdc2cbf3-48b6-588f-b958-c891b668d712" #edb/ref 17592186045417] [17592186559862 #edb/ref 1074 "Let's examine our vectors:\n\n- The vector $u=[\\begin{aligned}-7 \\\\ 1 \\\\ 0\\end{aligned}]$ has $3$ components as it lies in ${R}^{3}.$\n\n- The vector $v=[\\begin{aligned}1 \\\\ 5 \\\\ 3 \\\\ 0\\end{aligned}]$ has $4$ components as it lies in ${R}^{4}.$\n\nTherefore, since the number of components does not match, the operation is undefined." #edb/ref 17592186045417] [17592186559863 #edb/ref 1068 #edb/ref 17592186559672 #edb/ref 17592186045417] [17592186559863 #edb/ref 1069 "q-105096" #edb/ref 17592186045417] [17592186559863 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186559863 #edb/ref 1071 "Let $c=[\\begin{aligned}4 \\\\ 20 \\\\ -4 \\\\ -8 \\\\ 7\\end{aligned}].$ Find $\\frac{1}{4}c.$" #edb/ref 17592186045417] [17592186559863 #edb/ref 1072 #uuid "ceec6370-9876-5337-a51f-c0a5305aac98" #edb/ref 17592186045417] [17592186559863 #edb/ref 1074 "Multiplying each component of $c$ by $\\frac{1}{4},$ we get\n\n$$\n\\begin{aligned}\\frac{1}{4}c & =\\frac{1}{4}[\\begin{aligned}4 \\\\ 20 \\\\ -4 \\\\ -8 \\\\ 7\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{4}\\cdot 4 \\\\ \\frac{1}{4}\\cdot 20 \\\\ \\frac{1}{4}\\cdot (-4) \\\\ \\frac{1}{4}\\cdot (-8) \\\\ \\frac{1}{4}\\cdot 7\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 5 \\\\ -1 \\\\ -2 \\\\ \\frac{7}{4}\\end{aligned}].\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186559868 #edb/ref 1068 #edb/ref 17592186559743 #edb/ref 17592186045417] [17592186559868 #edb/ref 1069 "q-73925" #edb/ref 17592186045417] [17592186559868 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186559868 #edb/ref 1071 "If $v=[\\begin{aligned}-1 \\\\ 3 \\\\ 0 \\\\ 10\\end{aligned}]$, then $-2v=$" #edb/ref 17592186045417] [17592186559868 #edb/ref 1072 #uuid "dc18df10-64c6-5957-81d9-6515439cccbe" #edb/ref 17592186045417] [17592186559868 #edb/ref 1074 "Multiplying each component of $v$ by $-2,$ we get\n\n$$\n\\begin{aligned}-2v & =-2[\\begin{aligned}-1 \\\\ 3 \\\\ 0 \\\\ 10\\end{aligned}] \\\\  & =[\\begin{aligned}-2\\cdot (-1) \\\\ -2\\cdot 3 \\\\ -2\\cdot 0 \\\\ -2\\cdot 10\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ -6 \\\\ 0 \\\\ -20\\end{aligned}].\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186559879 #edb/ref 1068 #edb/ref 17592186559675 #edb/ref 17592186045417] [17592186559879 #edb/ref 1069 "q-73944" #edb/ref 17592186045417] [17592186559879 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186559879 #edb/ref 1071 "Let\n$v=[\\begin{aligned}-2 \\\\ p \\\\ 5 \\\\ -2 \\\\ -3\\end{aligned}]$ and $w=[\\begin{aligned}2 \\\\ -4 \\\\ 3 \\\\ -3 \\\\ p\\end{aligned}].$\nIf $v\\cdot w=3$, find the value of $p.$" #edb/ref 17592186045417] [17592186559879 #edb/ref 1072 #uuid "ea418b13-9cd8-58b9-8c0f-d233456f224d" #edb/ref 17592186045417] [17592186559879 #edb/ref 1074 "Starting from the equation $v\\cdot w=3,$ we compute the dot product in terms of $p$ and then solve for $p$ in the resulting equation:\n\n$$\n\\begin{aligned}v\\cdot w & =3 \\\\ -2\\cdot 2+p\\cdot (-4)+5\\cdot 3+(-2)\\cdot (-3)+(-3)\\cdot p & =3 \\\\ -4-4p+15+6-3p & =3 \\\\ -7p+17 & =3 \\\\ 7p & =14 \\\\ p & =2\\end{aligned}\n$$\n\nTherefore, we conclude that $p=2.$" #edb/ref 17592186045417]}
