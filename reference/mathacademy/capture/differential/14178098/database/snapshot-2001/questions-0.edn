d #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f2/f24b8b76970891cd8a3b8f797f608ff916dd6f05e5e8afddbb5575778b024be7.png" :db/id #edb/ref 17592186388610} {:answer/id #uuid "631b4cca-5bfd-50b0-b342-d2b909e8276f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/3a/3a73e3c8343526ceb755d6a0b44ba83d816265c5893a94d82a87f8f04ad4969a.png" :db/id #edb/ref 17592186388611}] :answer-field/correct {:answer/id #uuid "cdfb9fcb-b239-5df8-9af8-871f42370220" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f2/f24b8b76970891cd8a3b8f797f608ff916dd6f05e5e8afddbb5575778b024be7.png" :db/id #edb/ref 17592186388610} :answer-field/id #uuid "cd6a7ad8-1c7c-51b3-b1e8-1174655fdfab" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388606}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1c34e831-6b73-5cf1-b4f7-78b87586c856" :question/math-academy-id "q-139110" :question/problem "Which of the following data sets **might** be normally distributed?" :question/worked-solution "If a large data set is normally distributed, it should be approximately bell-shaped. \n\nAmong the given options, the only bell-shaped curve is the following:\n\n![](images/92/925a72e15da6d9ace52507e88a92da4a4e82d17b073fe6d6bcb4d6c14f716da4.png)\n\nIt's important to note that other bell-shaped distributions exist. Therefore, further tests on the data are required to confirm whether the underlying distribution is normal."}] [{:db/id #edb/ref 17592186269206 :knowledge-point/_questions [{:db/id #edb/ref 17592186083342 :knowledge-point/id #uuid "7f79d9ff-425b-5f2e-8380-23435a01a5b4" :knowledge-point/title "Identifying Data Sets That Could Be Normally Distributed"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d359508-b7e7-51c9-a254-cf