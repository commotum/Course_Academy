 n.$\n\nFinally, the lower Riemann sum is \n\n$$\n\\begin{aligned}L(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}(9-2{x}_{i}-6{y}_{j})Δ{x}_{i}Δ{y}_{j}.\\end{aligned}\n$$\n\nSo, the missing expression is $9-2{x}_{i}-6{y}_{j}.$"}] [{:db/id #edb/ref 17592186345073 :knowledge-point/_questions [{:db/id #edb/ref 17592186152154 :knowledge-point/id #uuid "bd33f89c-3adc-5b57-b7b7-4877a9e54e11" :knowledge-point/title "Writing the Lower Riemann Sum for a Strictly Decreasing Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02532b0b-006f-5c88-aaac-9e4ec68923ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "130-3{x}_{i-1}^{2}-5{y}_{j}^{2}" :db/id #edb/ref 17592186342271} {:answer/id #uuid "4e602fcf-179e-53ed-9499-e92cee8054bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}_{i}^{2}+4{y}_{j}^{2}" :db/id #edb/ref 17592186342882} {:answer/id #uuid "cb314dc0-eb3f-52ae-a0d5-d6477e50828a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}_{i-1}^{2}+4{y}_{j-1}^{2}" :db/id #edb/ref 17592186344025} {:answer/id #uuid "de3ddddb-3319-5927-a4a9-e659e439e045" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "130-3{x}_{i-1}^{2}-5{y}_{j-1}^{2}" :db/id #edb/ref 17592186344189} {:answer/id #uuid "f36358ed-9b39-50ca-bd44-908dc23b9097" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "130-3{x}_{i}^{2}-5{y}_{j}^{2}" :db/id #edb/ref 17592186344379}] :answer-field/correct {:answer/id #uuid "f36358ed-9b39-50ca-bd44-908dc23b9097" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "130-3{x}_{i}^{2}-5{y}_{j}^{2}" :db/id #edb/ref 17592186344379} :answer-field/id #uuid "38b89eb9-4497-56ea-8763-d8052eed6d74" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/re