le m$ and $1\\le j\\le n.$\n\nFinally, the lower Riemann sum is \n\n$$\n\\begin{aligned}L(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}(11{x}_{i-1}+2{y}_{j-1}-6)Δ{x}_{i}Δ{y}_{j}.\\end{aligned}\n$$\n\nSo, the missing expression is $11{x}_{i-1}+2{y}_{j-1}-6.$"}] [{:db/id #edb/ref 17592186345069 :knowledge-point/_questions [{:db/id #edb/ref 17592186152153 :knowledge-point/id #uuid "41a9d47a-2dd6-5177-afd1-e4adcd887f55" :knowledge-point/title "Writing the Lower Riemann Sum for a Strictly Increasing Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9eeb73dc-36d7-5e7d-b501-db75c415fd96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}_{i}^{2}+5{y}_{j-1}^{2}+7" :db/id #edb/ref 17592186343641} {:answer/id #uuid "a347e2f7-a900-59de-927e-2aa360286b6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}_{i-1}^{2}+4{y}_{j-1}^{2}" :db/id #edb/ref 17592186343672} {:answer/id #uuid "b7096a4b-29c4-58ea-85c7-483e10af74ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}_{i}^{2}+5{y}_{j}^{2}" :db/id #edb/ref 17592186343844} {:answer/id #uuid "c08fbb0b-9265-5d65-b685-dffe4a34996b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}_{i-1}^{2}+5{y}_{j-1}^{2}+7" :db/id #edb/ref 17592186343928} {:answer/id #uuid "e0b17630-4691-52cf-8db1-670d47b4ce77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}_{i}^{2}+5{y}_{j}^{2}+7" :db/id #edb/ref 17592186344211}] :answer-field/correct {:answer/id #uuid "c08fbb0b-9265-5d65-b685-dffe4a34996b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}_{i-1}^{2}+5{y}_{j-1}^{2}+7" :db/id #edb/ref 17592186343928} :answer-field/id #uuid "46a90ec4-1640-5471-8242-994c71f12fb4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344611}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e88cf287-5e72-5040-a31b-f657fcc2c634" :question/math-academy-id "q-75320" :question/problem "Let $R=[1,4]\\times [3,5]$ be a region in the $xy$-plane, and let $f(x,y)=3{x}^{2}+5{y}^{2}+7.$\nFurther, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}={{x}_{0},{x}_{1},…,{x}_{m}},\\,{P}_{2}={{y}_{0},{y}_{1},…,{y}_{n}},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nGiven that the lower Riemann sum of $f$ with respect to $P$ is given by\n\n$$\nL(f,P)={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}\\boxed{}\\,Δ{x}_{i}Δ{y}_{j}\n$$\n\nwhere $Δ{x}_{i}={x}_{i}-{x}_{i-1}$ and $Δ{y}_{j}={y}_{j}-{y}_{j-1},$ what is the missing expression in the double summation above?" :question/worked-solution "The lower Riemann sum is given by\n\n$$\n\\begin{aligned}L(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{m}_{ij}Δ{x}_{i}Δ{y}_{j}\\end{aligned}\n$$\n\nwhere ${m}_{ij}$ is the *minimum* value of $f$ in each subregion ${R}_{ij}.$ \n\nWe consider an arbitrary subregion ${R}_{ij}$ of the partition. This subregion lies between ${x}_{i-1}$ and ${x}_{i}$ over the $x$-axis and ${y}_{i-1}$ and ${y}_{i}$ over the $y$-axis, as shown below. \n\n![](images/88/88ffe30ae5401e00502b35d851b216768aad69bf94236561617adf23e1ce058f.png)\n\nNotice that:\n\n- $f(x,y)=3{x}^{2}+5{y}^{2}+7$ increases as $x$ increases on $[1,4],$ and\n\n- $f(x,y)=3{x}^{2}+5{y}^{2}+7$ increases as $y$ increases on $[3,5].$\n\n![](images/67/67daa328cc6ae4cb37be386c327fb4548844fad2adc10476bdf1147c5a5d4218.png)\n\nAs a result, the *minimum* value of $f$ in each subregion is attained when we have the *smallest* possible $x$ and the *smallest* possible $y.$ This is the value at the *bottom left corner* of each subregion. \n\n![](images/51/51808df96cf7dd295bfa24aa3641a601c821116e1a0014898ffe705036704a53.png)\n\nTherefore,\n\n$$\n\\begin{aligned}{m}_{ij} & =f({x}_{i-1},{y}_{j-1})=3{x}_{i-1}^{2}+5{y}_{j-1}^{2}+7\\end{aligned}\n$$\n\nfor all $1\\le i\\le m$ and $1\\le j\\le n.$\n\nFinally, the lower Riemann sum is \n\n$$\n\\begin{aligned}L(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}(3{x}_{i-1}^{2}+5{y}_{j-1}^{2}+7)Δ{x}_{i}Δ{y}_{j}.\\end{aligned}\n$$\n\nSo, the missing expression is $3{x}_{i-1}^{2}+5{y}_{j-1}^{2}+7.$"}] [{:db/id #edb/ref 17592186345070 :knowledge-point/_questions [{:db/id #edb/ref 17592186152154 :knowledge-point/id #uuid "bd33f89c-3adc-5b57-b7b7-4877a9e54e11" :knowledge-point/title "Writing the Lower Riemann Sum for a Strictly Decreasing Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3bb1753f-7b14-5907-82a7-8e6517a55a4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11-3{x}_{i}-4{y}_{j}" :db/id #edb/ref 17592186342730} {:answer/id #uuid "3d85e703-d37a-55da-b6a9-a09170d1b98e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11-3{x}_{i-1}-4{y}_{j-1}" :db/id #edb/ref 17592186342744} {:answer/id #uuid "4c611321-d7cf-58b0-9437-dc5df6a5a05d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3{x}_{i}+{y}_{j}" :db/id #edb/ref 17592186342868} {:answer/id #uuid "9a877f16-0e4f-5d41-8f6e-1290766eaf32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3{x}_{i-1}+{y}_{j-1}" :db/id #edb/ref 17592186343598} {:answer/id #uuid "b35aefea-a53c-56bd-a5f6-5634dcf8c746" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11-3{x}_{i}-4{y}_{j-1}" :db/id #edb/ref 17592186343812}] :answer-field/correct {:answer/id #uuid "3bb1753f-7b14-5907-82a7-8e6517a55a4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11-3{x}_{i}-4{y}_{j}" :db/id #edb/ref 17592186342730} :answer-field/id #uuid "1caeeb05-53a7-54ee-b7d9-bce9837b8083" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344541}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "290d62a5-c005-5705-932b-f1cd7c393170" :question/math-academy-id "q-75323" :question/problem "Let $R=[-3,1]\\times [-4,0]$ be a region in the $xy$-plane, and let $f(x,y)=11-3x-4y.$\nFurther, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}={{x}_{0},{x}_{1},…,{x}_{m}},\\,{P}_{2}={{y}_{0},{y}_{1},…,{y}_{n}},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nGiven that the lower Riemann sum of $f$ with respect to $P$ is given by\n\n$$\nL(f,P)={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}\\boxed{}\\,Δ{x}_{i}Δ{y}_{j}\n$$\n\nwhere $Δ{x}_{i}={x}_{i}-{x}_{i-1}$ and $Δ{y}_{j}={y}_{j}-{y}_{j-1},$ what is the missing expression in the double summation above?" :question/worked-solution "The lower Riemann sum is given by\n\n$$\n\\begin{aligned}L(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{m}_{ij}Δ{x}_{i}Δ{y}_{j}\\end{aligned}\n$$\n\nwhere ${m}_{ij}$ is the *minimum* value of $f$ in each subregion ${R}_{ij}.$ \n\nWe consider an arbitrary subregion ${R}_{ij}$ of the partition. This subregion lies between ${x}_{i-1}$ and ${x}_{i}$ over the $x$-axis and ${y}_{i-1}$ and ${y}_{i}$ over the $y$-axis, as shown below. \n\n![](images/88/88ffe30ae5401e00502b35d851b216768aad69bf94236561617adf23e1ce058f.png)\n\nNotice that:\n\n- $f(x,y)=11-3x-4y$ decreases as $x$ increases, and\n\n- $f(x,y)=11-3x-4y$ decreases as $y$ increases.\n\n![](images/ce/ce0d90127e1f14654f4b32a933f1eb6e76e054c03f19ca40c3f04116aa3c2c93.png)\n\nAs a result, the *minimum* value of $f$ in each subregion is attained when we have the *largest* possible $x$ and the *largest* possible $y.$ This is the value at the *top right corner* of each subregion. \n\n![](images/4a/4a10c8332a5f346d393c37531c13db6aa69d4cecb241efd7c34d57f32d5a98b8.png)\n\nTherefore,\n\n$$\n\\begin{aligned}{m}_{ij} & =f({x}_{i},{y}_{j})=11-3{x}_{i}-4{y}_{j}\\end{aligned}\n$$\n\nfor all $1\\le i\\le m$ and $1\\le j\\le n.$\n\nFinally, the lower Riemann sum is \n\n$$\n\\begin{aligned}L(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}(11-3{x}_{i}-4{y}_{j})Δ{x}_{i}Δ{y}_{j}.\\end{aligned}\n$$\n\nSo, the missing expression is $11-3{x}_{i}-4{y}_{j}.$"}] [{:db/id #edb/ref 17592186393521 :knowledge-point/_questions [{:db/id #edb/ref 17592186152154 :knowledge-point/id #uuid "bd33f89c-3adc-5b57-b7b7-4877a9e54e11" :knowledge-point/title "Writing the Lower Riemann Sum for a Strictly Decreasing Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "67b87e94-eb0b-57a6-8d55-cb9743dbcc56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}_{i}+7{y}_{j}" :db/id #edb/ref 17592186393523} {:answer/id #uuid "2288b855-e0cb-5cd0-89ef-073ce6f0c0b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9-2{x}_{i-1}-6{y}_{j-1}" :db/id #edb/ref 17592186393524} {:answer/id #uuid "4a2d6b48-e271-5f17-8e96-126ba2286d40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9-2{x}_{i}-6{y}_{j}" :db/id #edb/ref 17592186393525} {:answer/id #uuid "2e2fc85d-5451-5469-8f7b-61cc02f3776b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}_{i-1}+7{y}_{j-1}" :db/id #edb/ref 17592186393526} {:answer/id #uuid "d63db457-2c15-5b4f-8f26-010a6cef35cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9-2{x}_{i}-6{y}_{j-1}" :db/id #edb/ref 17592186393527}] :answer-field/correct {:answer/id #uuid "4a2d6b48-e271-5f17-8e96-126ba2286d40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9-2{x}_{i}-6{y}_{j}" :db/id #edb/ref 17592186393525} :answer-field/id #uuid "df84a140-508e-52ee-98bd-0a46d5280afa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/i