  "live_records": {
    "q-94877": {
      "dom_id": "step-q94877",
      "name": "Question 1",
      "problem": "In a particular park, the smallest tree is $6$ meters tall, and the tallest tree $10$ meters tall. Assuming that the height of the trees is uniformly distributed, what is the mean height of the trees in this park?",
      "worked_solution": "Let $X$ represent the height of a randomly chosen tree. From the problem statement, we know that $X∼U[6,10],$ and we wish to compute $\\text{E}[X].$\n\nIn general, if $X∼U[a,b],$ then $X$ has the following expected value:\n\n$$\n\\text{E}[X]=\\frac{a+b}{2}\n$$\n\nSo, for our random variable $X∼U[6,10],$ we have the following expected value:\n\n$$\n\\text{E}[X]=\\frac{6+10}{2}=8\n$$\n\nTherefore, the mean height of the trees is $8\\,\\text{m}.$",
      "calculator_instructions": "",
