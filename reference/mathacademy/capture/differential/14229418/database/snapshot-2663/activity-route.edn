#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186551470} :activity/id #uuid "58684ead-ad97-5f37-9158-83260440a5cb" :activity/scope {:db/id #edb/ref 17592186049403 :topic/id #uuid "f1c16ce5-7aa6-5801-b2e5-6bbc325fdf0d" :topic/math-academy-id 2990} :activity/steps [{:db/id #edb/ref 17592186551365 :step/content {:db/id #edb/ref 17592186551275 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "322599c7-5fb6-5a1a-a0e3-86699496d4dc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1200\\,{\\text{days}}^{2}" :db/id #edb/ref 17592186550487} {:answer/id #uuid "3425537f-a9ce-571f-98b5-9007a9fdef43" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1500\\,{\\text{days}}^{2}" :db/id #edb/ref 17592186550496} {:answer/id #uuid "569bb1a3-cf81-5eea-ac47-49251694875a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1215\\,{\\text{days}}^{2}" :db/id #edb/ref 17592186550578} {:answer/id #uuid "a07b88e6-0271-544e-b9c5-d07b293f86d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1350\\,{\\text{days}}^{2}" :db/id #edb/ref 17592186550782} {:answer/id #uuid "a2432121-4603-59ed-a77f-958b0b8a2440" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1235\\,{\\text{days}}^{2}" :db/id #edb/ref 17592186550787}] :answer-field/correct {:db/id #edb/ref 17592186550487} :answer-field/id #uuid "35c0c28d-17f3-5232-805f-c8fc73f618df" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186551099}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "48548786-5710-5326-90a5-450f466b1ddc" :question/math-academy-id "q-96951" :question/problem "A publisher has noticed that the minimum time needed to review a book is $115$ working days, and the maximum time is $235$ days. Assuming that the review time is uniformly distributed, what is the variance of the time needed to review a book?" :question/worked-solution "Let $X$ represent the time needed to review a randomly chosen book. From the problem statement, we know that $X∼U[115,235],$ and we wish to compute $\\text{Var}[X].$\n\nIn general, if $X∼U[a,b],$ then $X$ has the following variance:\n\n$$\n\\text{Var}[X]=\\frac{(b-a)^{2}}{12}\n$$\n\nSo, for our random variable $X∼U[115,235],$ we have the following variance:\n\n$$\n\\text{Var}[X]=\\frac{(235-115)^{2}}{12}=\\frac{14400}{12}=1200\n$$\n\nTherefore, the variance of the reviewing time is $1200\\,{\\text{days}}^{2}.$"} :step/id #uuid "0ef96b48-1ed9-5d10-a129-7a73c2edd39b" :step/next {:db/id #edb/ref 17592186551401}} {:db/id #edb/ref 17592186551392 :step/content {:db/id #edb/ref 17592186551322 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06b6b883-644f-5240-86cf-2f01bd1dd15d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "27\\,{\\text{min}}^{2}" :db/id #edb/ref 17592186550389} {:answer/id #uuid "1f7cf9b6-d296-5917-b91b-a3922654ec0e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "17\\,{\\text{min}}^{2}" :db/id #edb/ref 17592186550436} {:answer/id #uuid "5e7bba96-7ecb-5799-909c-4e38cab89914" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14\\,{\\text{min}}^{2}" :db/id #edb/ref 17592186550597} {:answer/id #uuid "709591d7-8631-5657-ba16-1f8436e9bee0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12\\,{\\text{min}}^{2}" :db/id #edb/ref 17592186550651} {:answer/id #uuid "c142bb8b-582e-511f-a12d-8d39875ecb37" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15\\,{\\text{min}}^{2}" :db/id #edb/ref 17592186550896}] :answer-field/correct {:db/id #edb/ref 17592186550651} :answer-field/id #uuid "5c06d34a-873f-5c1f-bb8a-cc928f9a21e1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186551121}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ac72fdfc-0b2a-5fb9-aa6a-78fe0b949c39" :question/math-academy-id "q-96924" :question/problem "The minimum time it takes a pizzeria to deliver an order is $15$ minutes, and the maximum time is $27$ minutes. If the delivery time is uniformly distributed, what is the variance in the delivery time?" :question/worked-solution "Let $X$ represent the time it takes to deliver a randomly selected order. From the problem statement, we know that $X∼U[15,27],$ and we wish to compute $\\text{Var}[X].$\n\nIn general, if $X∼U[a,b],$ then $X$ has the following variance:\n\n$$\n\\text{Var}[X]=\\frac{(b-a)^{2}}{12}\n$$\n\nSo, for our random variable $X∼U[15,27],$ we have the following variance:\n\n$$\n\\text{Var}[X]=\\frac{(27-15)^{2}}{12}=\\frac{144}{12}=12\n$$\n\nTherefore, the variance of the delivery time is $12\\,{\\text{min}}^{2}.$"} :step/id #uuid "3f8634f9-d4aa-5b58-9536-502fe9adc8ba" :step/next {:db/id #edb/ref 17592186551365}} {:db/id #edb/ref 17592186551401 :step/content {:db/id #edb/ref 17592186551316 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00a603bf-395b-559a-a676-83b6de7d673a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$15$ minutes before the beginning of the match" :db/id #edb/ref 17592186550369} {:answer/id #uuid "66cd71ac-bd10-5eb8-9b40-0347cef6a18b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$5$ minutes after the beginning of the match" :db/id #edb/ref 17592186550623} {:answer/id #uuid "ab957bdc-f463-5d79-a1f5-559b1eef4e56" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$5$ minutes before the beginning of the match" :db/id #edb/ref 17592186550830} {:answer/id #uuid "b4cf7291-6aec-5175-a62d-fc2ac7cc99e9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$3$ minutes after the beginning of the match" :db/id #edb/ref 17592186550861} {:answer/id #uuid "ffcbb2d4-ba30-5383-bede-f139f251ad55" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$10$ minutes before the beginning of the match" :db/id #edb/ref 17592186551056}] :answer-field/correct {:db/id #edb/ref 17592186550830} :answer-field/id #uuid "203f41b3-95ad-561c-b021-f76cc9d25199" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186551081}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9d49aabd-7000-5cc9-aab2-77d9e81c75f5" :question/math-academy-id "q-170688" :question/problem "The earliest that a football fan arrives at a match is $15$ minutes before the beginning of the match, and the latest that they arrive is $5$ minutes late. If the arrival times are uniformly distributed, what is the mean arrival time?" :question/worked-solution "Let $X$ represent the arrival time of a randomly chosen fan relative to the beginning of the match. From the problem statement, we know that $X∼U[-15,5],$ and we wish to compute $\\text{E}[X].$\n\nIn general, if $X∼U[a,b],$ then $X$ has the following expected value:\n\n$$\n\\text{E}[X]=\\frac{a+b}{2}\n$$\n\nSo, for our random variable $X∼U[-15,5],$ we have the following expected value:\n\n$$\n\\text{E}[X]=\\frac{-15+5}{2}=-5\n$$\n\nTherefore, the mean arrival time is $5$ minutes before the beginning of the match."} :step/id #uuid "57615c55-c739-51a4-800f-548673564677"} {:db/id #edb/ref 17592186551439 :step/content {:db/id #edb/ref 17592186158008 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0123579c-fcde-53be-aa62-af9baaca87cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "25.5\\,\\text{min}" :db/id #edb/ref 17592186550371} {:answer/id #uuid "0e945b16-27df-5bf7-9478-2df2eca1e337" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "59\\,\\text{min}" :db/id #edb/ref 17592186550407} {:answer/id #uuid "6ec7295d-bea7-5183-ab51-4e003202222f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "30\\,\\text{min}" :db/id #edb/ref 17592186550643} {:answer/id #uuid "94dcbe25-a54b-5b5d-bb4f-fe5f90e862e9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "34\\,\\text{min}" :db/id #edb/ref 17592186550739} {:answer/id #uuid "b131d1b8-1bd6-5d83-9081-be839823a988" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "29.5\\,\\text{min}" :db/id #edb/ref 17592186550851}] :answer-field/correct {:db/id #edb/ref 17592186550851} :answer-field/id #uuid "c69ad1f7-6091-56b0-8cbb-7b7c8f08c4fd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186156969}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "783a0029-9876-5d5f-8e19-0749f3f99743" :question/math-academy-id "q-96910" :question/problem "The duration of a podcast episode is uniformly distributed between $25$ and $34$ minutes. What is the expected duration of an episode?" :question/requires-calculator true :question/worked-solution "Let $X$ represent the duration of a randomly chosen episode. From the problem statement, we know that $X∼U[25,34],$ and we wish to compute $\\text{E}[X].$\n\nIn general, if $X∼U[a,b],$ then $X$ has the following expected value:\n\n$$\n\\text{E}[X]=\\frac{a+b}{2}\n$$\n\nSo, for our random variable $X∼U[25,34],$ we have the following expected value:\n\n$$\n\\text{E}[X]=\\frac{25+34}{2}=29.5\n$$\n\nTherefore, the mean duration of an episode is $29.5\\,\\text{min}.$"} :step/id #uuid "b240f3d9-e947-5ab3-a824-82c0f7d5edb2" :step/next {:db/id #edb/ref 17592186551392}} {:db/id #edb/ref 17592186551470 :step/content {:db/id #edb/ref 17592186158002 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47139a26-d804-59e4-870b-0b5fc3a07282" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8\\,\\text{m}" :db/id #edb/ref 17592186550536} {:answer/id #uuid "6b7576a7-b188-5d29-9666-0430897568db" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10\\,\\text{m}" :db/id #edb/ref 17592186550633} {:answer/id #uuid "b400b317-0cb2-5752-955d-096fd7622908" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9\\,\\text{m}" :db/id #edb/ref 17592186550858} {:answer/id #uuid "c6d821b6-c4a4-5a46-ab4d-0167d341c182" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8.5\\,\\text{m}" :db/id #edb/ref 17592186550905} {:answer/id #uuid "d59bb3da-caf8-563a-a85b-45e4f3b2a669" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7.5\\,\\text{m}" :db/id #edb/ref 17592186550945}] :answer-field/correct {:db/id #edb/ref 17592186550536} :answer-field/id #uuid "27b55c9f-abf7-57c8-8ef3-6ccffec95f3a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186156933}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a2bf66f0-fdce-5219-924b-0a53cc32c2d7" :question/math-academy-id "q-94877" :question/problem "In a particular park, the smallest tree is $6$ meters tall, and the tallest tree $10$ meters tall. Assuming that the height of the trees is uniformly distributed, what is the mean height of the trees in this park?" :question/requires-calculator true :question/worked-solution "Let $X$ represent the height of a randomly chosen tree. From the problem statement, we know that $X∼U[6,10],$ and we wish to compute $\\text{E}[X].$\n\nIn general, if $X∼U[a,b],$ then $X$ has the following expected value:\n\n$$\n\\text{E}[X]=\\frac{a+b}{2}\n$$\n\nSo, for our random variable $X∼U[6,10],$ we have the following expected value:\n\n$$\n\\text{E}[X]=\\frac{6+10}{2}=8\n$$\n\nTherefore, the mean height of the trees is $8\\,\\text{m}.$"} :step/id #uuid "fa137d99-705a-51f0-98fd-ba2d94c9ab48" :step/next {:db/id #edb/ref 17592186551439}}] :activity/title "Modeling With Continuous Uniform Distributions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186550350}]}
