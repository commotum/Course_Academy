#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186158261} :activity/id #uuid "94ee19b2-82ee-5848-bade-b4ccfb0e809c" :activity/scope {:db/id #edb/ref 17592186049403 :topic/id #uuid "f1c16ce5-7aa6-5801-b2e5-6bbc325fdf0d" :topic/math-academy-id 2990} :activity/steps [{:db/id #edb/ref 17592186158259 :step/content {:db/id #edb/ref 17592186157375 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157195 :question/id #uuid "6c73f039-2cb9-516e-9fdf-dc1054ca93c4" :question/math-academy-id "e-8305"} :knowledge-point/id #uuid "14a5ffb6-c652-5626-b6c2-bcd5004b6297" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049239}] :knowledge-point/questions [{:db/id #edb/ref 17592186158001} {:db/id #edb/ref 17592186158007} {:db/id #edb/ref 17592186524959} {:db/id #edb/ref 17592186524995} {:db/id #edb/ref 17592186525018} {:db/id #edb/ref 17592186525052} {:db/id #edb/ref 17592186525056}] :knowledge-point/title "Calculating a Probability in Context"} :step/id #uuid "f522daa5-e0ec-537c-b842-5fa4768ed614" :step/math-academy-id 30999 :step/next {:db/id #edb/ref 17592186158260}} {:db/id #edb/ref 17592186158260 :step/content {:db/id #edb/ref 17592186157376 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157196 :question/id #uuid "70b91fcc-70a7-580d-84b0-b24a7e2643d5" :question/math-academy-id "e-8306"} :knowledge-point/id #uuid "38f8d9f6-9ef8-5cc1-b2d8-38936c08468a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048513}] :knowledge-point/questions [{:db/id #edb/ref 17592186158002} {:db/id #edb/ref 17592186158008} {:db/id #edb/ref 17592186524968} {:db/id #edb/ref 17592186524969} {:db/id #edb/ref 17592186524977} {:db/id #edb/ref 17592186525022} {:db/id #edb/ref 17592186525049}] :knowledge-point/title "Calculating an Expected Value in Context"} :step/id #uuid "c48606fd-e52f-588d-8027-d4e3910466b0" :step/math-academy-id 31000 :step/next {:db/id #edb/ref 17592186158262}} {:db/id #edb/ref 17592186158261 :step/content {:db/id #edb/ref 17592186158542 :tutorial/content "In general, if $X \\sim U[a,b]$ is uniformly distributed, then $X$ has the following probability density function:\n\n![](images/93/93894f939fa0ef715ee6ab6c225f456972b746184673df0b8d8312656727d793.svg)\n\nWe can use a continuous uniform distribution to model situations where all possible outcomes on a finite interval are equally likely.\n\nFor instance, suppose a dental receptionist wants to model the waiting time of a randomly selected patient. After observing a number of patients over several days, the receptionist notices that the waiting time is uniformly distributed between $6$ and $14$ minutes, inclusive.\n\nThen, by letting $X$ be the amount of time a randomly selected patient spends waiting, we can model the waiting time using the continuous uniform distribution: \n\n$$\nX \\sim U[6,14]\n$$\n\nTherefore, $X$ has the following probability density function:\n\n![](images/fd/fd37b3e19aad197ebb7eeabad00fca068455eed8da462a12630134cd7980941e.svg)\n\nWith this model, we can now make predictions about patient waiting times.\n\nFor example, the probability that a randomly selected patient waits longer than $9$ minutes is equal to\n\n$$\n\\begin{aligned}P(X\\ge 9) & ={\\int }_{9}^{14}\\frac{1}{8}\\,\\text{d}x \\\\  & =\\frac{1}{8}{\\int }_{9}^{14}\\,\\text{d}x \\\\  & =\\frac{1}{8}{[x]}_{9}^{14} \\\\  & =\\frac{1}{8}[14-9] \\\\  & =\\frac{5}{8}.\\end{aligned}\n$$\n\nWe can also calculate the mean waiting time by finding the expected value of $X\\mathbin{:}$\n\n$$\n\\begin{aligned}\\text{E}[X] & =\\frac{a+b}{2} \\\\  & =\\frac{6+14}{2} \\\\  & =10\\end{aligned}\n$$\n\nTherefore, the mean waiting time is $10$ minutes." :tutorial/id #uuid "1087e8f4-f648-5237-8623-0c17d0025548" :tutorial/math-academy-id 4980 :tutorial/title "Introduction"} :step/id #uuid "440a6b0e-f841-5fce-a0bd-4e3697ea4ea3" :step/math-academy-id 31001 :step/next {:db/id #edb/ref 17592186158259}} {:db/id #edb/ref 17592186158262 :step/content {:db/id #edb/ref 17592186157377 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157197 :question/id #uuid "2ab8efcd-495b-5ed4-a6be-e3d24d046fe1" :question/math-academy-id "e-8307"} :knowledge-point/id #uuid "610bddb6-0731-53d1-9fcf-ab202d4cf151" :knowledge-point/questions [{:db/id #edb/ref 17592186158003} {:db/id #edb/ref 17592186158009} {:db/id #edb/ref 17592186525004} {:db/id #edb/ref 17592186525027} {:db/id #edb/ref 17592186525029} {:db/id #edb/ref 17592186525066}] :knowledge-point/title "Calculating a Variance in Context"} :step/id #uuid "f455aacf-dfe4-59fa-854e-a6aac8ae7a22" :step/math-academy-id 31002}] :activity/title "Modeling With Continuous Uniform Distributions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186157536}]}
