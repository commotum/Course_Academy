48548786-5710-5326-90a5-450f466b1ddc" :question/answer-fields "answer-field-35c0c28d-17f3-5232-805f-c8fc73f618df"] [17592186157377 :knowledge-point/questions "question-48548786-5710-5326-90a5-450f466b1ddc"] ["question-9d49aabd-7000-5cc9-aab2-77d9e81c75f5" :question/id #uuid "9d49aabd-7000-5cc9-aab2-77d9e81c75f5"] ["question-9d49aabd-7000-5cc9-aab2-77d9e81c75f5" :question/math-academy-id "q-170688"] ["question-9d49aabd-7000-5cc9-aab2-77d9e81c75f5" :question/problem "The earliest that a football fan arrives at a match is $15$ minutes before the beginning of the match, and the latest that they arrive is $5$ minutes late. If the arrival times are uniformly distributed, what is the mean arrival time?"] ["question-9d49aabd-7000-5cc9-aab2-77d9e81c75f5" :question/worked-solution "Let $X$ represent the arrival time of a randomly chosen fan relative to the beginning of the match. From the problem statement, we know that $X∼U[-15,5],$ and we wish to compute $\\text{E}[X].$\n\nIn general, if $X∼U[a,b],$ then $X$ has the following expected value:\n\n$$\n\\text{E}[X]=\\frac{a+b}{2}\n$$\n\nSo, for our random variable $X∼U[-15,5],$ we have the following expected value:\n\n$$\n\\text{E}[X]=\\frac{-15+5}{2}=-5\n$$\n\nTherefore, the mean arrival time is $5$ minutes before the beginning of the match."] ["question-9d49aabd-7000-5cc9-aab2-77d9e81c75f5" :question/difficulty :question.difficulty/easy] ["answer-field-203f41b3-95ad-561c-b021-f76cc9d25199" :answer-field/id #uuid "203f41b3-95ad-561c-b021-f76cc9d25199"] ["answer-ffcbb2d4-ba30-5383-bede-f139f251ad55" :answer/id #uuid "ffcbb2d4-ba30-5383-bede-f139f251ad55"] ["answer-ffcbb2d4-ba30-5383-bede-f139f251ad55" :answer/type :answer.type/text] ["answer-ffcbb2d4-ba30-5383-bede-f139f251ad55" :answer/value "$10$ minutes before the beginning of the match"] ["answer-00a603bf-395b-559a-a676-83b6de7d673a" :answer/id #uuid "00a603bf-395b-559a-a676-83b6de7d673a"] ["answer-00a603bf-395b-559a-a676-83b6de7d673a" :answer/type :answer.type/text] ["answer-00a603bf-395b-559a-a676-83b6de7d673a" :answer/value "$15$ minutes before the beginning of the match"] ["answer-b4cf7291-6aec-5175-a62d-fc2ac7cc99e9" :answer/id #uuid "b4cf7291-6aec-5175-a62d-fc2ac7cc99e9"] ["answer-b4cf7291-6aec-5175-a62d-fc2ac7cc99e9" :answer/type :answer.type/text] ["answer-b4cf7291-6aec-5175-a62d-fc2ac7cc99e9" :answer/value "$3$ minutes after the beginning of the match"] ["answer-66cd71ac-bd10-5eb8-9b40-0347cef6a18b" :answer/id #uuid "66cd71ac-bd10-5eb8-9b40-0347cef6a18b"] ["answer-66cd71ac-bd10-5eb8-9b40-0347cef6a18b" :answer/type :answer.type/text] ["answer-66cd71ac-bd10-5eb8-9b40-0347cef6a18b" :answer/value "$5$ minutes after the beginning of the match"] ["answer-ab957bdc-f463-5d79-a1f5-559b1eef4e56" :answer/id #uuid "ab957bdc-f463-5d79-a1f5-559b1eef4e56"] ["answer-ab957bdc-f463-5d79-a1f5-559b1eef4e56" :answer/type :answer.type/text] ["answer-ab957bdc-f463-5d79-a1f5-559b1eef4e56" :answer/value "$5$ minutes before the beginning of the match"] ["answer-field-203f41b3-95ad-561c-b021-f76cc9d25199" :answer-field/key "selection"] ["answer-field-203f41b3-95ad-561c-b021-f76cc9d25199" :answer-field/type :answer-field.type/radio] ["answer-field-203f41b3-95ad-561c-b021-f76cc9d25199" :answer-field/correct "answer-ab957bdc-f463-5d79-a1f5-559b1eef4e56"] ["answer-field-203f41b3-95ad-561c-b021-f76cc9d25199" :answer-field/choices "answer-ffcbb2d4-ba30-5383-bede-f139f251ad55"] ["answer-field-203f41b3-95ad-561c-b021-f76cc9d25199" :answer-field/choices "answer-00a603bf-395b-559a-a676-83b6de7d673a"] ["answer-field-203f41b3-95ad-561c-b021-f76cc9d25199" :answer-field/choices "answer-b4cf7291-6aec-5175-a62d-fc2ac7cc99e9"] ["answer-field-203f41b3-95ad-561c-b021-f76cc9d25199" :answer-field/choices "answer-66cd71ac-bd10-5eb8-9b40-0347cef6a18b"] ["answer-field-203f41b3-95ad-561c-b021-f76cc9d25199" :answer-field/choices "answer-ab957bdc-f463-5d79-a1f5-559b1eef4e56"] ["question-9d49aabd-7000-5cc9-aab2-77d9e81c75f5" :question/answer-fields "answer-field-203f41b3-95ad-561