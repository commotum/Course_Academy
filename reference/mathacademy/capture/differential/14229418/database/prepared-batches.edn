[{"source" ":org/Math-Academy" "forms" [[:db/retract 17592186156933 :answer-field/choices 17592186156934] [:db/retract 17592186156933 :answer-field/choices 17592186156935] [:db/retract 17592186156933 :answer-field/choices 17592186156936] [:db/retract 17592186156933 :answer-field/choices 17592186156937] [:db/retract 17592186156933 :answer-field/choices 17592186156938] [:db/retract 17592186156969 :answer-field/choices 17592186156970] [:db/retract 17592186156969 :answer-field/choices 17592186156971] [:db/retract 17592186156969 :answer-field/choices 17592186156972] [:db/retract 17592186156969 :answer-field/choices 17592186156973] [:db/retract 17592186156969 :answer-field/choices 17592186156974] {:db/id 17592186157376 :knowledge-point/questions ["question-9d49aabd-7000-5cc9-aab2-77d9e81c75f5"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186158002 :question/problem "In a particular park, the smallest tree is $6$ meters tall, and the tallest tree $10$ meters tall. Assuming that the height of the trees is uniformly distributed, what is the mean height of the trees in this park?" :question/worked-solution "Let $X$ represent the height of a randomly chosen tree. From the problem statement, we know that $X∼U[6,10],$ and we wish to compute $\\text{E}[X].$\n\nIn general, if $X∼U[a,b],$ then $X$ has the following expected value:\n\n$$\n\\text{E}[X]=\\frac{a+b}{2}\n$$\n\nSo, for our random variable $X∼U[6,10],$ we have the following expected value:\n\n$$\n\\text{E}[X]=\\frac{6+10}{2}=8\n$$\n\nTherefore, the mean height of the trees is $8\\,\\text{m}.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186156933 :answer-field/correct "answer-47139a26-d804-59e4-870b-0b5fc3a07282" :answer-field/choices ["answer-6b7576a7-b188-5d29-9666-0430897568db" "answer-d59bb3da-caf8-563a-a85b-45e4f3b2a669" "answer-c6d821b6-c4a4-5a46-ab4d-0167d341c182" "answer-47139a26-d804-59e4-870b-0b5fc3a07282" "answer-b400b317-0cb2-5752-955d-096fd7622908"] :db/ensure [:answer-field/validate]} {:db/id "answer-6b7576a7-b188-5d29-9666-0430897568db" :answer/id #uuid "6b7576a7-b188-5d29-9666-0430897568db" :answer/type :answer.type/math :answer/value "10\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "answer-d59bb3da-caf8-563a-a85b-45e4f3b2a669" :answer/id #uuid "d59bb3da-caf8-563a-a85b-45e4f3b2a669" :answer/type :answer.type/math :answer/value "7.5\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "answer-c6d821b6-c4a4-5a46-ab4d-0167d341c182" :answer/id #uuid "c6d821b6-c4a4-5a46-ab4d-0167d341c182" :answer/type :answer.type/math :answer/value "8.5\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "answer-47139a26-d804-59e4-870b-0b5fc3a07282" :answer/id #uuid "47139a26-d804-59e4-870b-0b5fc3a07282" :answer/type :answer.type/math :answer/value "8\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "answer-b400b317-0cb2-5752-955d-096fd7622908" :answer/id #uuid "b400b317-0cb2-5752-955d-096fd7622908" :answer/type :answer.type/math :answer/value "9\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id 17592186158008 :question/problem "The duration of a podcast episode is uniformly distributed between $25$ and $34$ minutes. What is the expected duration of an episode?" :question/worked-solution "Let $X$ represent the duration of a randomly chosen episode. From the problem statement, we know that $X∼U[25,34],$ and we wish to compute $\\text{E}[X].$\n\nIn general, if $X∼U[a,b],$ then $X$ has the following expected value:\n\n$$\n\\text{E}[X]=\\frac{a+b}{2}\n$$\n\nSo, for our random variable $X∼U[25,34],$ we have the following expected value:\n\n$$\n\\text{E}[X]=\\frac{25+34}{2}=29.5\n$$\n\nTherefore, the mean duration of an episode is $29.5\\,\\text{min}.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186156969 :answer-field/correct "answer-b131d1b8-1bd6-5d83-9081-be839823a988" :answer-field/choices ["answer-0123579c-fcde-53be-aa62-af9baaca87cb" "answer-b131d1b8-1bd6-5d83-9081-be839823a988" "answer-6ec7295d-bea7-5183-ab51-4e003202222f" "answer-94dcbe25-a54b-5b5d-bb4f-fe5f90e862e9" "answer-0e945b16-27df-5bf7-9478-2df2eca1e337"] :db/ensure [:answer-field/validate]} {:db/id "answer-0123579c-fcde-53be-aa62-af9baaca87cb" :answer/id #uuid "0123579c-fcde-53be-aa62-af9baaca87cb" :answer/type :answer.type/math :answer/value "25.5\\,\\text{min}" :db/ensure [:answer/validate]} {:db/id "answer-b131d1b8-1bd6-5d83-9081-be839823a988" :answer/id #uuid "b131d1b8-1bd6-5d83-9081-be839823a988" :answer/type :answer.type/math :answer/value "29.5\\,\\text{min}" :db/ensure [:answer/validate]} {:db/id "answer-6ec7295d-bea7-5183-ab51-4e003202222f" :answer/id #uuid "6ec7295d-bea7-5183-ab51-4e003202222f" :answer/type :answer.type/math :answer/value "30\\,\\text{min}" :db/ensure [:answer/validate]} {:db/id "answer-94dcbe25-a54b-5b5d-bb4f-fe5f90e862e9" :answer/id #uuid "94dcbe25-a54b-5b5d-bb4f-fe5f90e862e9" :answer/type :answer.type/math :answer/value "34\\,\\text{min}" :db/ensure [:answer/validate]} {:db/id "answer-0e945b16-27df-5bf7-9478-2df2eca1e337" :answer/id #uuid "0e945b16-27df-5bf7-9478-2df2eca1e337" :answer/type :answer.type/math :answer/value "59\\,\\text{min}" :db/ensure [:answer/validate]} {:db/id 17592186157377 :knowledge-point/questions ["question-ac72fdfc-0b2a-5fb9-aa6a-78fe0b949c39" "question-48548786-5710-5326-90a5-450f466b1ddc"] :db/ensure [:knowledge-point/validate]} {:db/id "question-ac72fdfc-0b2a-5fb9-aa6a-78fe0b949c39" :question/id #uuid "ac72fdfc-0b2a-5fb9-aa6a-78fe0b949c39" :question/math-academy-id "q-96924" :question/problem "The minimum time it takes a pizzeria to deliver an order is $15$ minutes, and the maximum time is $27$ minutes. If the delivery time is uniformly distributed, what is the variance in the delivery time?" :question/worked-solution "Let $X$ represent the time it takes to deliver a randomly selected order. From the problem statement, we know that $X∼U[15,27],$ and we wish to compute $\\text{Var}[X].$\n\nIn general, if $X∼U[a,b],$ then $X$ has the following variance:\n\n$$\n\\text{Var}[X]=\\frac{(b-a)^{2}}{12}\n$$\n\nSo, for our random variable $X∼U[15,27],$ we have the following variance:\n\n$$\n\\text{Var}[X]=\\frac{(27-15)^{2}}{12}=\\frac{144}{12}=12\n$$\n\nTherefore, the variance of the delivery time is $12\\,{\\text{min}}^{2}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-5c06d34a-873f-5c1f-bb8a-cc928f9a21e1"] :db/ensure [:question/validate]} {:db/id "answer-field-5c06d34a-873f-5c1f-bb8a-cc928f9a21e1" :answer-field/id #uuid "5c06d34a-873f-5c1f-bb8a-cc928f9a21e1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-709591d7-8631-5657-ba16-1f8436e9bee0" :answer-field/choices ["answer-709591d7-8631-5657-ba16-1f8436e9bee0" "answer-5e7bba96-7ecb-5799-909c-4e38cab89914" "answer-c142bb8b-582e-511f-a12d-8d39875ecb37" "answer-1f7cf9b6-d296-5917-b91b-a3922654ec0e" "answer-06b6b883-644f-5240-86cf-2f01bd1dd15d"] :db/ensure [:answer-field/validate]} {:db/id "answer-709591d7-8631-5657-ba16-1f8436e9bee0" :answer/id #uuid "709591d7-8631-5657-ba16-1f8436e9bee0" :answer/type :answer.type/math :answer/value "12\\,{\\text{min}}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-5e7bba96-7ecb-5799-909c-4e38cab89914" :answer/id #uuid "5e7bba96-7ecb-5799-909c-4e38cab89914" :answer/type :answer.type/math :answer/value "14\\,{\\text{min}}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-c142bb8b-582e-511f-a12d-8d39875ecb37" :answer/id #uuid "c142bb8b-582e-511f-a12d-8d39875ecb37" :answer/type :answer.type/math :answer/value "15\\,{\\text{min}}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-1f7cf9b6-d296-5917-b91b-a3922654ec0e" :answer/id #uuid "1f7cf9b6-d296-5917-b91b-a3922654ec0e" :answer/type :answer.type/math :answer/value "17\\,{\\text{min}}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-06b6b883-644f-5240-86cf-2f01bd1dd15d" :answer/id #uuid "06b6b883-644f-5240-86cf-2f01bd1dd15d" :answer/type :answer.type/math :answer/value "27\\,{\\text{min}}^{2}" :db/ensure [:answer/validate]} {:db/id "question-48548786-5710-5326-90a5-450f466b1ddc" :question/id #uuid "48548786-5710-5326-90a5-450f466b1ddc" :question/math-academy-id "q-96951" :question/problem "A publisher has noticed that the minimum time needed to review a book is $115$ working days, and the maximum time is $235$ days. Assuming that the review time is uniformly distributed, what is the variance of the time needed to review a book?" :question/worked-solution "Let $X$ represent the time needed to review a randomly chosen book. From the problem statement, we know that $X∼U[115,235],$ and we wish to compute $\\text{Var}[X].$\n\nIn general, if $X∼U[a,b],$ then $X$ has the following variance:\n\n$$\n\\text{Var}[X]=\\frac{(b-a)^{2}}{12}\n$$\n\nSo, for our random variable $X∼U[115,235],$ we have the following variance:\n\n$$\n\\text{Var}[X]=\\frac{(235-115)^{2}}{12}=\\frac{14400}{12}=1200\n$$\n\nTherefore, the variance of the reviewing time is $1200\\,{\\text{days}}^{2}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-35c0c28d-17f3-5232-805f-c8fc73f618df"] :db/ensure [:question/validate]} {:db/id "answer-field-35c0c28d-17f3-5232-805f-c8fc73f618df" :answer-field/id #uuid "35c0c28d-17f3-5232-805f-c8fc73f618df" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-322599c7-5fb6-5a1a-a0e3-86699496d4dc" :answer-field/choices ["answer-322599c7-5fb6-5a1a-a0e3-86699496d4dc" "answer-569bb1a3-cf81-5eea-ac47-49251694875a" "answer-a2432121-4603-59ed-a77f-958b0b8a2440" "answer-a07b88e6-0271-544e-b9c5-d07b293f86d1" "answer-3425537f-a9ce-571f-98b5-9007a9fdef43"] :db/ensure [:answer-field/validate]} {:db/id "answer-322599c7-5fb6-5a1a-a0e3-86699496d4dc" :answer/id #uuid "322599c7-5fb6-5a1a-a0e3-86699496d4dc" :answer/type :answer.type/math :answer/value "1200\\,{\\text{days}}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-569bb1a3-cf81-