ices "answer-1f7cf9b6-d296-5917-b91b-a3922654ec0e"] ["answer-field-5c06d34a-873f-5c1f-bb8a-cc928f9a21e1" :answer-field/choices "answer-06b6b883-644f-5240-86cf-2f01bd1dd15d"] ["question-ac72fdfc-0b2a-5fb9-aa6a-78fe0b949c39" :question/answer-fields "answer-field-5c06d34a-873f-5c1f-bb8a-cc928f9a21e1"] [17592186157377 :knowledge-point/questions "question-ac72fdfc-0b2a-5fb9-aa6a-78fe0b949c39"] ["question-48548786-5710-5326-90a5-450f466b1ddc" :question/id #uuid "48548786-5710-5326-90a5-450f466b1ddc"] ["question-48548786-5710-5326-90a5-450f466b1ddc" :question/math-academy-id "q-96951"] ["question-48548786-5710-5326-90a5-450f466b1ddc" :question/problem "A publisher has noticed that the minimum time needed to review a book is $115$ working days, and the maximum time is $235$ days. Assuming that the review time is uniformly distributed, what is the variance of the time needed to review a book?"] ["question-48548786-5710-5326-90a5-450f466b1ddc" :question/worked-solution "Let $X$ represent the time needed to review a randomly chosen book. From the problem statement, we know that $X∼U[115,235],$ and we wish to compute $\\text{Var}[X].$\n\nIn general, if $X∼U[a,b],$ then $X$ has the following variance:\n\n$$\n\\text{Var}[X]=\\frac{(b-a)^{2}}{12}\n$$\n\nSo, for our random variable $X∼U[115,235],$ we have the following variance:\n\n$$\n\\text{Var}[X]=\\frac{(235-115)^{2}}{12}=\\frac{14400}{12}=1200\n$$\n\nTherefore, the variance of the reviewing time is $1200\\,{\\text{days}}^{2}.$"] ["question-48548786-5710-5326-90a5-450f466b1ddc" :question/difficulty :question.difficulty/moderate] ["answer-field-35c0c28d-17f3-5232-805f-c8fc73f618df" :answer-field/id #uuid "35c0c28d-17f3-5232-805f-c8fc73f618df"] ["answer-322599c7-5fb6-5a1a-a0e3-86699496d4dc" :answer/id #uuid "322599c7-5fb6-5a1a-a0e3-86699496d4dc"] ["answer-322599c7-5fb6-5a1a-a0e3-86699496d4dc" :answer/type :answer.type/math] ["answer-322599c7-5fb6-5a1a-a0e3-86699496d4dc" :answer/value "1200\\,{\\text{days}}^{2}"] ["answer-569bb1a3