#{[{:db/id #edb/ref 17592186119710 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186119890 :knowledge-point/id #uuid "4d503d5d-ee8f-57a2-a6ef-b5b05d5e8ae4" :knowledge-point/title "Calculating the Volume of a Rectangular Solid Given Its Dimensions"}] :question/id #uuid "78d0bc32-ce61-5c58-a31a-bf3b0cc55761" :question/math-academy-id "e-8972" :question/problem "What is the volume of a rectangular solid that has length, width, and height of $5 \\: \\textrm{m}$, $\\sqrt3 \\: \\textrm{m}$, and $\\sqrt6 \\: \\textrm{m}$, respectively?" :question/worked-solution "We can find the volume $V$ of the rectangular prism using the formula\n\n$$\nV = lwh\n$$\n\nwhere $l$ is the length, $w$ is the width, and $h$ is the height of the solid.\n\nSubstituting\n\n$$\nl=5 \\, \\textrm{m}, \\qquad w=\\sqrt3 \\, \\textrm{m}, \\qquad h=\\sqrt6 \\, \\textrm{m}\n$$\n\ninto the formula, we obtain\n\n$$\nV = 5 \\cdot \\sqrt3 \\cdot \\sqrt6 = 5\\sqrt{18} = 15\\sqrt2 \\: \\textrm{m}^3\n$$"}] [{:db/id #edb/ref 17592186119711 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186119891 :knowledge-point/id #uuid "a97dc9e3-b5a4-5913-94c3-aea43e639ce8" :knowledge-point/title "Finding a Dimension of a Rectangular Solid Given Its Volume and Some Other Dimensions"}] :question/id #uuid "35043b46-40e9-51c4-8676-ad7a81763aae" :question/math-academy-id "e-8973" :question/problem "Determine the height of the rectangular solid below given that its volume is $700\\:\\textrm{cm}^3$.\n\n![](images/8a/8a232f69c9c6abbffcb2272d4fbd237c644273826fb46dd5742bdc07d89544cb.png)" :question/worked-solution "We can find the volume $V$ of the rectangular prism using the formula\n\n$$\nV = lwh\n$$\n\nwhere $l$ is the length, $w$ is the width, and $h$ is the height of the solid.\n\nSubstituting\n\n$$\nV = 700, \\qquad l=14, \\qquad w=10\n$$\n\ninto the formula, we obtain the following:\n\n$$\n\\begin{aligned}\n700 &= 14 \\cdot 10 \\cdot h \\\\\n700 &= 140h \\\\\nh &= 5\n\\end{aligned}\n$$\n\nTherefore, the height is $5\\:\\textrm{cm}$."}] [{:db/id #edb/ref 17592186119712 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186119892 :knowledge-point/id #uuid "ba5bf1d9-f6e2-5494-91fd-31c20d7fa09b" :knowledge-point/title "Finding the Volume of a Rectangular Solid: Word Problems"}] :question/id #uuid "3528ee00-01a7-5c77-af81-50d53b5fa849" :question/math-academy-id "e-8974" :question/problem "The diagram below shows a carton of orange juice. One-third of the carton is filled with juice, forming a cube. Find the volume of the empty space in the carton.\n\n![](images/90/90280dd78d285df5dc798c3ec90b7fb47a72414f2934d36885eb9d65fd7584fd.png)" :question/worked-solution "The orange juice in the carton creates a cube. Since the height of the juice is $9\\,\\textrm{cm}$, the side length of the cube is also $9\\,\\textrm{cm}$.\n\nThe height of $9 \\: \\textrm{cm}$ shown in the diagram represents a third of the carton's height. Therefore, the height of the carton is\n\n$$\n3 \\cdot 9 = 27 \\: \\textrm{cm}\n$$\n\nThe empty space in the carton is a rectangular prism that is $9\\:\\textrm{cm}$ long, $9\\:\\textrm{cm}$ wide, and\n\n$$\n27 - 9 = 18\\:\\textrm{cm}\n$$\n\nhigh.\n\nWe can find the volume $V$ of the rectangular prism using the formula\n\n$$\nV = lwh\n$$\n\nwhere $l$ is the length, $w$ is the width, and $h$ is the height of the solid.\n\nSubstituting\n\n$$\nl=9\\,\\textrm{cm}, \\qquad w=9\\,\\textrm{cm}, \\qquad h=18\\,\\textrm{cm}\n$$\n\ninto the formula, we obtain\n\n$$\nV = 9 \\cdot 9 \\cdot 18 = 1\\,458\\:\\textrm{cm}^3\n$$\n\nTherefore, we conclude that there is $1\\,458 \\: \\textrm{cm}^3$ of empty space in the carton."}] [{:db/id #edb/ref 17592186120060 :knowledge-point/_questions [{:db/id #edb/ref 17592186119890 :knowledge-point/id #uuid "4d503d5d-ee8f-57a2-a6ef-b5b05d5e8ae4" :knowledge-point/title "Calculating the Volume of a Rectangular Solid Given Its Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87103bbe-81c6-5c71-b3ab-3fa6883d2c8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "82in^{3}" :db/id #edb/ref 17592186116568} {:answer/id #uuid "9509363a-18a7-5feb-9438-8519ed35e43d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "68in^{3}" :db/id #edb/ref 17592186116569} {:answer/id #uuid "d57dea2e-c306-5bf7-b425-612decdec472" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "42in^{3}" :db/id #edb/ref 17592186116570} {:answer/id #uuid "e3e38693-e447-5c7f-a808-7f5f822b96f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28in^{3}" :db/id #edb/ref 17592186116571} {:answer/id #uuid "7a202a61-79ea-547a-adf2-9cfd028498d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "54in^{3}" :db/id #edb/ref 17592186116572}] :answer-field/id #uuid "df9c4862-1049-51fe-b6d5-ec40711c7e8e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186116567}] :question/id #uuid "354c9af3-a204-5b30-bbc0-46ae605292f1" :question/math-academy-id "q-10228" :question/problem "![](images/17/175d15b140a660148d8890cf32f4c4b79a43ff86d82c7e4461174326dfa9eeca.png)\n\nFind the volume of the rectangular prism shown above."}] [{:db/id #edb/ref 17592186233065 :knowledge-point/_questions [{:db/id #edb/ref 17592186119891 :knowledge-point/id #uuid "a97dc9e3-b5a4-5913-94c3-aea43e639ce8" :knowledge-point/title "Finding a Dimension of a Rectangular Solid Given Its Volume and Some Other Dimensions"}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ab063eb3-e1ae-540f-a02b-e6ce9ad41bcd" :question/math-academy-id "q-10229" :question/problem "![](images/70/70fc259b5863513eabaf6b67eeb5e6b8debcb40d4a91d096f6515cb9f2efe642.png)\n\nDetermine the length of the rectangular solid above given that its volume is $720\\,{\\text{in}}^{3}.$" :question/worked-solution "We can find the volume $V$ of the rectangular prism using the formula\n\n$$\nV=lwh,\n$$\n\nwhere $l$ is the length, $w$ is the width, and $h$ is the height of the solid.\n\nSubstituting \n\n$$\nV=720,\\,w=5,\\,h=8\n$$\n\ninto the formula, we obtain the following\n\n$$\n\\begin{aligned}720 & =l\\cdot 5\\cdot 8 \\\\ 720 & =40l \\\\ l & =18\\end{aligned}\n$$\n\nTherefore, the length is $18\\,\\text{in}.$"}] [{:db/id #edb/ref 17592186120088 :knowledge-point/_questions [{:db/id #edb/ref 17592186119892 :knowledge-point/id #uuid "ba5bf1d9-f6e2-5494-91fd-31c20d7fa09b" :knowledge-point/title "Finding the Volume of a Rectangular Solid: Word Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "94e026db-b6ca-5d1f-bc3c-3be6b14dd14a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$1.80$" :db/id #edb/ref 17592186116735} {:answer/id #uuid "aaf356cf-15b6-5092-9788-e98b4f596935" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$8.50$" :db/id #edb/ref 17592186116736} {:answer/id #uuid "d22f8719-b0f3-5d7a-8f03-f8cb18846173" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$7.20$" :db/id #edb/ref 17592186116737} {:answer/id #uuid "f581f57c-328a-511b-adf3-7882b27f3560" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$7.02$" :db/id #edb/ref 17592186116738} {:answer/id #uuid "35dc34cf-6ed5-588b-8665-51cdf9e08eda" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$6.20$" :db/id #edb/ref 17592186116739}] :answer-field/id #uuid "8e3ac18f-df2a-531e-80f1-3bbd339896a0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186116734}] :question/id #uuid "f9fb6d92-70dd-5c7f-9979-070fe590bd5f" :question/math-academy-id "q-107738" 