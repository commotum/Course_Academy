#{[{:activity/first-step {:db/id #edb/ref 17592186120806} :activity/id #uuid "eed5aa9e-ed1f-5edb-990e-f8643f3d4226" :activity/scope {:db/id #edb/ref 17592186049878 :topic/id #uuid "1a524c38-2f30-5eb7-8ed4-12cf2dc92b46" :topic/math-academy-id 1753} :activity/steps [{:db/id #edb/ref 17592186120806 :step/content {:db/id #edb/ref 17592186121085 :tutorial/content "Let's consider the rectangular prism below. How can we calculate its volume?\n\n![](images/94/94bdf8333e1cb6a7ff9f99bc4ef854433bc99a8310f61181309cf51709e7569c.png)\n\nIn general, we can find the volume $V$ of a rectangular prism using the formula\n\n$$\nV = lwh\n$$\n\nwhere $l$ is the length, $w$ is the width, and $h$ is the height of the solid.\n\nSubstituting\n\n$$\nl = 20\\,\\textrm{cm}, \\qquad w=10\\,\\textrm{cm}, \\qquad h=5\\,\\textrm{cm}\n$$\n\ninto the formula, we obtain\n\n$$\n\\begin{aligned}\nV &= 20 \\cdot 10 \\cdot 5 = 1000cm^{3}\n\\end{aligned}\n$$" :tutorial/id #uuid "feec31b3-1ad3-5875-8ef1-2ea93c1a154f" :tutorial/math-academy-id 5377 :tutorial/title "Introduction"} :step/id #uuid "974ddcf1-fc2c-505b-8c87-39b02be85d11" :step/math-academy-id 33545 :step/next {:db/id #edb/ref 17592186120807}} {:db/id #edb/ref 17592186120807 :step/content {:db/id #edb/ref 17592186119890 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119710 :question/id #uuid "78d0bc32-ce61-5c58-a31a-bf3b0cc55761" :question/math-academy-id "e-8972"} :knowledge-point/id #uuid "4d503d5d-ee8f-57a2-a6ef-b5b05d5e8ae4" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049923} {:db/id #edb/ref 17592186051057}] :knowledge-point/questions [{:db/id #edb/ref 17592186120059} {:db/id #edb/ref 17592186120060} {:db/id #edb/ref 17592186233103} {:db/id #edb/ref 17592186233104}] :knowledge-point/title "Calculating the Volume of a Rectangular Solid Given Its Dimensions"} :step/id #uuid "43fe0233-b488-5e80-a3a1-01c13e10309c" :step/math-academy-id 33546 :step/next {:db/id #edb/ref 17592186120808}} {:db/id #edb/ref 17592186120808