#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186553658} :activity/id #uuid "e5c483f8-80a6-58a7-9a49-027e31676ad1" :activity/scope {:db/id #edb/ref 17592186048988 :topic/id #uuid "d152b82b-357d-5dd0-8cd0-d9f05720adc2" :topic/math-academy-id 1042} :activity/steps [{:db/id #edb/ref 17592186553651 :step/content {:db/id #edb/ref 17592186553588 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ca225f04-c41c-5801-bbe0-bb926d928f52" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{25-k^2}" :db/id #edb/ref 17592186553273}] :answer-field/correct {:db/id #edb/ref 17592186553273} :answer-field/id #uuid "09cadba8-c7e5-5038-8a48-1336913c1648" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186553382}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f18a40a3-25a5-51f7-ad9a-5b7927d2de6b" :question/math-academy-id "q-345025" :question/problem "![](images/a1/a1f53be1baf6a5db5807565f0511813cb41a7b48ec42e37a96049403aaa2235d.png)\n\nThe area under the curve $y=\\sqrt{25-{x}^{2}}$ between $x=0$, $x=5$ and the $x$-axis is approximated using a left Riemann sum, as shown above. What is the expression for the left Riemann sum ${S}_{L}$ in sigma notation?\n\n*Hint: Write down the expression in terms of $k.$*\n\n${S}_{L}={\\sum }_{k=0}^{4}$\n{{field-1}}" :question/worked-solution "The left Riemann sum for $y=f(x)$ with a regular step size in sigma notation is\n\n$$\n{S}_{L}={\\sum }_{k=0}^{n-1}f({x}_{k})Δx,\n$$\n\nwhere ${x}_{k}=a+kΔx$ with $Δx=\\frac{b-a}{n}.$ \n\nFrom the diagram, we see that there are $n=5$ rectangles. The endpoints indicate that $a=0$ and $b=5,$ so the step size is\n\n$$\nΔx=\\frac{5-0}{5}=\\frac{5}{5}=1.\n$$\n\nTherefore, using sigma notation, the left Riemann sum ${S}_{L}$ can be expressed as\n\n$$\n\\begin{aligned}{S}_{L}={\\sum }_{k=0}^{n-1}f({x}_{k})Δx & ={\\sum }_{k=0}^{n-1}f(a+kΔx)Δx \\\\  & ={\\sum }_{k=0}^{5-1}f(0+k\\cdot 1)\\cdot 1 \\\\  & ={\\sum }_{k=0}^{4}f(k) \\\\  & ={\\sum }_{k=0}^{4}\\sqrt{25-{k}^{2}}.\\end{aligned}\n$$"} :step/id #uuid "94144180-b9da-5c4a-94e2-66f4cf3503ec"} {:db/id #edb/ref 17592186553655 :step/content {:db/id #edb/ref 17592186553515 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f27cc60-4ad8-593e-9ef5-5d362258831b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{27}{{n}^{4}}{\\sum }_{j=0}^{n-1}\\,(j-2)^{3}" :db/id #edb/ref 17592186552888} {:answer/id #uuid "1b99b866-cfcd-5ab3-97e9-6c269fcfe9fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{81}{{n}^{2}}{\\sum }_{j=0}^{n-1}\\,{j}^{3}" :db/id #edb/ref 17592186552915} {:answer/id #uuid "265541b8-e6de-5a62-ba09-d145d5094973" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{{n}^{2}}{\\sum }_{j=0}^{n-1}\\,{j}^{3}" :db/id #edb/ref 17592186552935} {:answer/id #uuid "93fd0fdd-bb74-5b4c-9cce-c52e5835da23" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{81}{{n}^{4}}{\\sum }_{j=0}^{n-1}\\,{j}^{3}" :db/id #edb/ref 17592186553167} {:answer/id #uuid "dfa60640-75f4-50e0-8054-4fd539a3b520" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{27}{{n}^{3}}{\\sum }_{j=0}^{n-1}\\,{j}^{3}" :db/id #edb/ref 17592186553312}] :answer-field/correct {:db/id #edb/ref 17592186553167} :answer-field/id #uuid "5c5920c5-4b86-5a6d-b9f0-0d98e11b6c2d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186553418}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "37c41f7c-c697-50e0-8b4c-374dcc3f004e" :question/math-academy-id "q-73165" :question/problem "The area under the curve $y=(x+2)^{3}$ between $x=-2$ and $x=1$ and the $x$-axis is approximated by a left Riemann sum using $n$ subintervals of equal length. What is the expression for the Riemann sum in sigma notation?" :question/worked-solution "The left Riemann sum for $y=f(x)$ with a regular step size in sigma notation is\n\n$$\n{\\sum }_{j=0}^{n-1}f({x}_{j})Δx,\n$$\n\nwhere $n$ is the number of subintervals,   ${x}_{j}=a+jΔx$, and  $Δx=\\frac{b-a}{n}.$ \n\nThe endpoints indicate that $a=-2$ and $b=1,$ so the step size is\n\n$$\nΔx=\\frac{1-(-2)}{n}=\\frac{3}{n}.\n$$\n\nTherefore, using sigma notation, the left Riemann sum can be expressed as\n\n$$\n\\begin{aligned}{\\sum }_{j=0}^{n-1}f({x}_{j})Δx & ={\\sum }_{j=0}^{n-1}f(a+jΔx)Δx \\\\  & ={\\sum }_{j=0}^{n-1}f(-2+j\\cdot \\frac{3}{n})\\cdot \\frac{3}{n} \\\\  & ={\\sum }_{j=0}^{n-1}f(-2+\\frac{3j}{n})\\cdot \\frac{3}{n} \\\\  & ={\\sum }_{j=0}^{n-1}{(-2+\\frac{3j}{n}+2)}^{3}\\cdot \\frac{3}{n} \\\\  & ={\\sum }_{j=0}^{n-1}\\frac{3}{n}{(\\frac{3j}{n})}^{3} \\\\  & ={\\sum }_{j=0}^{n-1}\\frac{3}{n}\\cdot \\frac{27{j}^{3}}{{n}^{3}} \\\\  & =\\frac{81}{{n}^{4}}{\\sum }_{j=0}^{n-1}\\,{j}^{3}.\\end{aligned}\n$$"} :step/id #uuid "98521d78-3d9c-5855-83a3-132d76b75772" :step/next {:db/id #edb/ref 17592186553661}} {:db/id #edb/ref 17592186553658 :step/content {:db/id #edb/ref 17592186553583 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34a0c68b-e9f8-549e-842e-b401217d6da3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\sum }_{i=0}^{3}\\frac{1}{2}\\operatorname{sin}⁡(\\frac{i\\pi }{4})" :db/id #edb/ref 17592186552968} {:answer/id #uuid "761a9645-004c-5d1a-a018-4e98c7126007" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\sum }_{i=1}^{4}\\frac{1}{2}\\operatorname{sin}⁡(\\frac{i\\pi }{4})" :db/id #edb/ref 17592186553106} {:answer/id #uuid "ca16e453-591e-50ca-b9b0-9c6c804546b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\sum }_{i=1}^{4}\\frac{1}{2}\\operatorname{sin}⁡(\\frac{i\\pi }{2})" :db/id #edb/ref 17592186553272} {:answer/id #uuid "dec5872d-a8a0-52d9-b1df-f39709699d7c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\sum }_{i=0}^{3}\\operatorname{sin}⁡(\\frac{i\\pi }{4})" :db/id #edb/ref 17592186553311} {:answer/id #uuid "f70e4a83-804d-5d8d-a2bf-8321912f101c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\sum }_{i=1}^{4}[-\\operatorname{sin}⁡(\\frac{i\\pi }{4})]" :db/id #edb/ref 17592186553357}] :answer-field/correct {:db/id #edb/ref 17592186553106} :answer-field/id #uuid "80c578ea-f1c8-5e3b-b6d6-b57c333da3a1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186553437}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e4c3e43e-fe55-559b-8cc6-a202da2850e8" :question/math-academy-id "q-49330" :question/problem "The area under the curve $y=\\operatorname{sin}⁡(\\frac{\\pi x}{2})$ between $x=0$ and $x=2$ and the $x$-axis is approximated by a right Riemann sum using $4$ subintervals of equal length. What is the expression for the Riemann sum in sigma notation?" :question/worked-solution "The right Riemann sum for $y=f(x)$ with a regular step size in sigma notation is\n\n$$\n{\\sum }_{i=1}^{n}f({x}_{i})Δx,\n$$\n\nwhere ${x}_{i}=a+iΔx$ with $Δx=\\frac{b-a}{n}.$ \n\nWe're told that there are $n=4$ subintervals. The endpoints indicate that $a=0$ and $b=2.$ So, the step size is\n\n$$\nΔx=\\frac{2-0}{4}=\\frac{2}{4}=\\frac{1}{2}.\n$$\n\nTherefore, using sigma notation, the right Riemann sum can be expressed as\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{n}f({x}_{i})Δx & ={\\sum }_{i=1}^{n}f(a+iΔx)Δx \\\\  & ={\\sum }_{i=1}^{4}f(0+i\\cdot \\frac{1}{2})\\cdot \\frac{1}{2} \\\\  & ={\\sum }_{i=1}^{4}f(\\frac{i}{2})\\cdot \\frac{1}{2} \\\\  & ={\\sum }_{i=1}^{4}\\frac{1}{2}\\operatorname{sin}⁡(\\frac{i\\pi }{4}).\\end{aligned}\n$$"} :step/id #uuid "a58c0fc5-07f8-5a57-9d1d-48e43c216105" :step/next {:db/id #edb/ref 17592186553655}} {:db/id #edb/ref 17592186553661 :step/content {:db/id #edb/ref 17592186553533 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f15eefe-3a94-52eb-b0db-fbe7b7e8c5e8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\sum }_{j=0}^{n-1}\\,\\operatorname{sin}⁡(\\frac{3j+3}{n})" :db/id #edb/ref 17592186552926} {:answer/id #uuid "494d84f7-e321-5bbf-9260-a5d994e6bad2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\sum }_{j=1}^{n-1}\\,\\frac{3}{n}\\operatorname{sin}⁡(\\frac{j}{n}+3)" :db/id #edb/ref 17592186553021} {:answer/id #uuid "637e03eb-1b6f-575b-8c6c-dcc21ef08a1d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\sum }_{j=0}^{n}\\,\\frac{3}{n}\\operatorname{sin}⁡(\\frac{3j}{n})" :db/id #edb/ref 17592186553081} {:answer/id #uuid "903605f0-bbb6-51e7-b29a-abff3e1d83c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\sum }_{j=0}^{n-1}\\,\\frac{3}{n}\\operatorname{sin}⁡(\\frac{3j}{n})" :db/id #edb/ref 17592186553155} {:answer/id #uuid "9b0d2c49-0687-55c5-88d3-59452dabce7e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\sum }_{j=1}^{n}\\,\\frac{3}{n}\\operatorname{sin}⁡(\\frac{j}{n})" :db/id #edb/ref 17592186553183}] :answer-field/correct {:db/id #edb/ref 17592186553155} :answer-field/id #uuid "0287ad59-5a09-5d14-b668-9a96a7a6d0a9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186553376}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "6c6f0b11-13a1-5912-b416-72a57173178b" :question/math-academy-id "q-116625" :question/problem "The area under the curve $y=\\operatorname{sin}⁡(x+3)$ between $x=-3$ and $x=0$ and the $x$-axis is approximated by a left Riemann sum using $n$ subintervals of equal length. What is the expression for the Riemann sum in sigma notation?" :question/worked-solution "The left Riemann sum for $y=f(x)$ with a regular step size in sigma notation is\n\n$$\n{\\sum }_{j=0}^{n-1}f({x}_{j})Δx,\n$$\n\nwhere $n$ is the number of subintervals, ${x}_{j}=a+jΔx$, and  $Δx=\\frac{b-a}{n}.$ \n\nThe endpoints indicate that $a=-3$ and $b=0,$ so the step size is\n\n$$\nΔx=\\frac{0-(-3)}{n}=\\frac{3}{n}.\n$$\n\nTherefore, using sigma notation, the left Riemann sum can be expressed as\n\n$$\n\\begin{aligned}{\\sum }_{j=0}^{n-1}f({x}_{k})Δx & ={\\sum }_{j=0}^{n-1}f(a+jΔx)Δx \\\\  & ={\\sum }_{j=0}^{n-1}f(-3+j\\cdot \\frac{3}{n})\\cdot \\frac{3}{n} \\\\  & ={\\sum }_{j=0}^{n-1}f(-3+\\frac{3j}{n})\\cdot \\frac{3}{n} \\\\  & ={\\sum }_{j=0}^{n-1}\\,\\frac{3}{n}\\cdot \\operatorname{sin}⁡(-3+\\frac{3j}{n}+3) \\\\  & ={\\sum }_{j=0}^{n-1}\\,\\frac{3}{n}\\operatorname{sin}⁡(\\frac{3j}{n}).\\end{aligned}\n$$"} :step/id #uuid "aef43ed3-757d-50cb-b210-12d3e1909452" :step/next {:db/id #edb/ref 17592186553686}} {:db/id #edb/ref 17592186553686 :step/content {:db/id #edb/ref 17592186233230 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36d0b2e7-6b1e-5c39-947f-21883b5f48ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\sum }_{j=1}^{n}[{(\\frac{4j}{n}+1)}^{3}]" :db/id #edb/ref 17592186552975} {:answer/id #uuid "994192dd-582e-50fe-98a3-038c82cfc67d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\sum }_{j=0}^{n}[{(\\frac{4}{n})}^{4}{(j+1)}^{3}]" :db/id #edb/ref 17592186553178} {:answer/id #uuid "9c82cd81-4ecb-542d-ae56-556d01765358" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\sum }_{j=1}^{n}[{(\\frac{4}{n})}^{4}{j}^{3}]" :db/id #edb/ref 17592186553186} {:answer/id #uuid "a7034dd5-0b93-59ba-85f4-8a88fce11c84" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\sum }_{j=1}^{n}[\\frac{4}{n}{(\\frac{4j}{n}+1)}^{3}]" :db/id #edb/ref 17592186553200} {:answer/id #uuid "ae50862f-a25d-563a-a92d-0d0178b72923" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\sum }_{j=1}^{n-1}[\\frac{4}{n}{(\\frac{4j}{n}+1)}^{3}]" :db/id #edb/ref 17592186553219}] :answer-field/correct {:db/id #edb/ref 17592186553200} :answer-field/id #uuid "91f26888-434b-5c5c-a749-e627db784a28" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186553444}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "d0dd25ca-44a0-5275-b710-e7c2a70a0387" :question/math-academy-id "q-116627" :question/problem "The area under the curve $y=(x+1)^{3}$ between $x=0$ and $x=4$ and the $x$-axis is approximated by a right Riemann sum using $n$ subintervals of equal length. What is the expression for the Riemann sum in sigma notation?" :question/worked-solution "The right Riemann sum for $y=f(x)$ with a regular step size in sigma notation is\n\n$$\n{\\sum }_{j=1}^{n}f({x}_{j})Δx,\n$$\n\nwhere ${x}_{j}=a+jΔx$ with $Δx=\\frac{b-a}{n}.$ \n\nWe're told that there are $n$ subintervals. The endpoints indicate that $a=0$ and $b=4.$ So, we have\n\n$$\nΔx=\\frac{4-0}{n}=\\frac{4}{n}.\n$$\n\nTherefore, using sigma notation, the right Riemann sum can be expressed as \n\n$$\n\\begin{aligned}{\\sum }_{j=1}^{n}f({x}_{j})Δx & ={\\sum }_{j=1}^{n}f(a+jΔx)Δx \\\\  & ={\\sum }_{j=1}^{n}[f(0+j\\cdot \\frac{4}{n})\\cdot \\frac{4}{n}] \\\\  & ={\\sum }_{j=1}^{n}[f(\\frac{4j}{n})\\cdot \\frac{4}{n}] \\\\  & ={\\sum }_{j=1}^{n}[\\frac{4}{n}{(\\frac{4j}{n}+1)}^{3}].\\end{aligned}\n$$"} :step/id #uuid "fe9ddf2c-9375-5f42-bbd6-35c574b47dbc" :step/next {:db/id #edb/ref 17592186553651}}] :activity/title "Left and Right Riemann Sums in Sigma Notation" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186552865}]}
