qrt{5}}\\end{aligned}] \\\\  & =\\frac{1}{11}[\\begin{aligned}-\\frac{22}{\\sqrt{5}} \\\\ -\\frac{11}{\\sqrt{5}}\\end{aligned}] \\\\  \\\\  & =[\\begin{aligned}-\\frac{2}{\\sqrt{5}} \\\\ -\\frac{1}{\\sqrt{5}}\\end{aligned}].\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186388779 #edb/ref 1075 #edb/ref 17592186388780 #edb/ref 17592186045417] [17592186388779 #edb/ref 1075 #edb/ref 17592186388781 #edb/ref 17592186045417] [17592186388779 #edb/ref 1075 #edb/ref 17592186388782 #edb/ref 17592186045417] [17592186388779 #edb/ref 1075 #edb/ref 17592186388783 #edb/ref 17592186045417] [17592186388779 #edb/ref 1075 #edb/ref 17592186388784 #edb/ref 17592186045417] [17592186388779 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186388779 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186388779 #edb/ref 1078 #edb/ref 17592186388782 #edb/ref 17592186045417] [17592186388779 #edb/ref 1079 #uuid "e7af0c55-c0c0-57b2-8764-cee03bfd3605" #edb/ref 17592186045417] [17592186388780 #edb/ref 1080 "[\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}]" #edb/ref 17592186045417] [17592186388780 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186388780 #edb/ref 1083 #uuid "e6055e84-6449-5143-a2b3-46eff0358050" #edb/ref 17592186045417] [17592186388781 #edb/ref 1080 "[\\begin{aligned}\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{aligned}]" #edb/ref 17592186045417] [17592186388781 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186388781 #edb/ref 1083 #uuid "1f939b74-aaf7-502f-8564-0b661fd0e6a9" #edb/ref 17592186045417] [17592186388782 #edb/ref 1080 "[\\begin{aligned}-\\frac{2}{\\sqrt{5}} \\\\ -\\frac{1}{\\sqrt{5}}\\end{aligned}]" #edb/ref 17592186045417] [17592186388782 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186388782 #edb/ref 1083 #uuid "02624a8f-1b6a-5107-a65b-691283905860" #edb/ref 17592186045417] [17592186388783 #edb/ref 1080 "[\\begin{aligned}\\frac{2}{\\sqrt{5}} \\\\ -\\frac{1}{\\sqrt{5}}\\end{aligned}]" #edb/ref 17592186045417] [17592186388783 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186388783 #edb/ref 1083 #uuid "a8527eb6-3fa6-5558-a401-122a4ccf2932" #edb/ref 17592186045417] [17592186388784 #edb/ref 1080 "[\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{2}}\\end{aligned}]" #edb/ref 17592186045417] [17592186388784 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186388784 #edb/ref 1083 #uuid "2499ff1e-f85f-5965-ad45-394bcfc443a3" #edb/ref 17592186045417] [17592186395086 #edb/ref 1068 #edb/ref 17592186395087 #edb/ref 17592186045417] [17592186395086 #edb/ref 1069 "q-95911" #edb/ref 17592186045417] [17592186395086 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186395086 #edb/ref 1071 "$$\nA=[\\begin{aligned}-6 & 2 \\\\ 7 & 6\\end{aligned}],\\,Σ=[\\begin{aligned}10 & 0 \\\\ 0 & 5\\end{aligned}]\n$$\n\nConsider the matrices $A$ and $Σ$ shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ which of the following could be the matrices $U$ and $V?$" #edb/ref 17592186045417] [17592186395086 #edb/ref 1072 #uuid "5db18361-738b-5a9a-b3b0-1db51bcde1bd" #edb/ref 17592186045417] [17592186395086 #edb/ref 1074 "Let's find the singular value decomposition of $A$ using the usual algorithm.\n\n- **Step 1.** Compute ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={[\\begin{aligned}-6 & 2 \\\\ 7 & 6\\end{aligned}]}^{T}[\\begin{aligned}-6 & 2 \\\\ 7 & 6\\end{aligned}] \\\\  & =[\\begin{aligned}-6 & 7 \\\\ 2 & 6\\end{aligned}][\\begin{aligned}-6 & 2 \\\\ 7 & 6\\end{aligned}] \\\\  & =[\\begin{aligned}85 & 30 \\\\ 30 & 40\\end{aligned}]\\end{aligned}\n$$\n\n- **Step 2.** Find the singular values: From the matrix $Σ,$ we deduce that ${\\sigma }_{1}=10$ and ${\\sigma }_{2}=5.$\n\n- **Step 3.** Find the right singular vectors of $A$ (i.e., the unit eigenvectors of ${A}^{T}\\,A$):\n\n- For ${\\lambda }_{1}={\\sigma }_{1}^{2}=100,$ we have\n\n$$\n\\begin{aligned}{A}^{T}\\,A-100I & =[\\begin{aligned}85 & 30 \\\\ 30 & 40\\end{aligned}]-100[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}-15 & 30 \\\\ 30 & -60\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $({A}^{T}\\,A-100I)v=0$ gives a unit eigenvector\n\n$$\n{v}_{1}=[\\begin{aligned}\\frac{2}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}}\\end{aligned}].\n$$\n\n- For ${\\lambda }_{2}={\\sigma }_{2}^{2}=25,$ we have\n\n$$\n\\begin{aligned}{A}^{T}\\,A-25I & =[\\begin{aligned}85 & 30 \\\\ 30 & 40\\end{aligned}]-25[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}60 & 30 \\\\ 30 & 15\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $({A}^{T}\\,A-25I)v=0$ gives a unit eigenvector\n\n$$\n{v}_{2}=[\\begin{aligned}-\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{aligned}].\n$$\n\n- **Step 4.** Find the left singular vectors of $A$: Since we know the singular values and right singular vectors, we can compute the columns of $U$ as follows:\n\n- First, we compute ${u}_{1}:$\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{10}[\\begin{aligned}-6 & 2 \\\\ 7 & 6\\end{aligned}][\\begin{aligned}\\frac{2}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}}\\end{aligned}] \\\\  & =\\frac{1}{10}[\\begin{aligned}-2\\sqrt{5} \\\\ 10\\sqrt{5}\\end{aligned}] \\\\  & =[\\begin{aligned}-\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{aligned}]\\end{aligned}\n$$\n\n- Then, we compute ${u}_{2}:$\n\n$$\n\\begin{aligned}{u}_{2} & =\\frac{1}{{\\sigma }_{2}}A{v}_{2} \\\\  & =\\frac{1}{5}[\\begin{aligned}-6 & 2 \\\\ 7 & 6\\end{aligned}][\\begin{aligned}-\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{aligned}] \\\\  & =\\frac{1}{5}[\\begin{aligned}2\\sqrt{5} \\\\ \\sqrt{5}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{2}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}}\\end{aligned}]\\end{aligned}\n$$\n\nFinally, we construct the matrices $U$ and $V:$\n\n$$\nU=[\\begin{aligned}-\\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}}\\end{aligned}],\\,V=[\\begin{aligned}\\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}}\\end{aligned}]\n$$" #edb/ref 17592186045417] [17592186395087 #edb/ref 1075 #edb/ref 17592186395088 #edb/ref 17592186045417] [17592186395087 #edb/ref 1075 #edb/ref 17592186395089 #edb/ref 17592186045417] [17592186395087 #edb/ref 1075 #edb/ref 17592186395090 #edb/ref 17592186045417] [17592186395087 #edb/ref 1075 #edb/ref 17592186395091 #edb/ref 17592186045417] [17592186395087 #edb/ref 1075 #edb/ref 17592186395092 #edb/ref 17592186045417] [17592186395087 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186395087 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186395087 #edb/ref 1078 #edb/ref 17592186395091 #edb/ref 17592186045417] [17592186395087 #edb/ref 1079 #uuid "9d28a695-b25d-5276-8883-5cca1cebedbd" #edb/ref 17592186045417] [17592186395088 #edb/ref 1080 "$U=[\\begin{aligned}\\frac{2}{\\sqrt{13}} & -\\frac{3}{\\sqrt{13}} \\\\ \\frac{3}{\\sqrt{13}} & \\frac{2}{\\sqrt{13}}\\end{aligned}]$\nand\n$V=[\\begin{aligned}-\\frac{3}{\\sqrt{5}} & \\frac{2}{\\sqrt{13}} \\\\ \\frac{2}{\\sqrt{13}} & \\frac{3}{\\sqrt{13}}\\end{aligned}]$" #edb/ref 17592186045417] [17592186395088 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186395088 #edb/ref 1083 #uuid "332ee583-e727-5bba-8acd-922d23695b56" #edb/ref 17592186045417] [17592186395089 #edb/ref 1080 "$U=[\\begin{aligned}-\\frac{3}{\\sqrt{5}} & \\frac{2}{\\sqrt{13}} \\\\ \\frac{2}{\\sqrt{13}} & \\frac{3}{\\sqrt{13}}\\end{aligned}]$\nand\n$V=[\\begin{aligned}\\frac{2}{\\sqrt{13}} & -\\frac{3}{\\sqrt{13}} \\\\ \\frac{3}{\\sqrt{13}} & \\frac{2}{\\sqrt{13}}\\end{aligned}]$" #edb/ref 17592186045417] [17592186395089 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186395089 #edb/ref 1083 #uuid "a10add95-adc6-5235-9f97-1b43eca22a80" #edb/ref 17592186045417] [175921