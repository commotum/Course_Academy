      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14165783/observations/step-q253895-cdc363ae6e90535ea332.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14165783/observations/step-q253895-cdc363ae6e90535ea332.png",
      "source_url": "https://mathacademy.com/tasks/14165783/topics/3036/lesson",
      "captured_at": 1791894129.702926,
      "math_academy_id": "q-253895",
      "topic_id": "3036",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q253895",
