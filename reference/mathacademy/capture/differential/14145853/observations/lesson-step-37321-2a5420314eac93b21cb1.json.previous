\n <use transform=\"scale(0.707)\" xlink:href=\"#E2-MJMAIN-31\" x=\"1124\" y=\"0\"></use>\n</g>\n<g transform=\"translate(368,1151)\">\n <use transform=\"scale(0.707)\" xlink:href=\"#E2-MJMAIN-38\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E2-MJMAIN-31\" x=\"500\" y=\"0\"></use>\n</g>\n<g transform=\"translate(1611,0)\">\n <use xlink:href=\"#E2-MJMAIN-28\"></use>\n<g transform=\"translate(389,0)\">\n <use xlink:href=\"#E2-MJMATHI-78\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E2-MJMATHI-69\" x=\"809\" y=\"-213\"></use>\n</g>\n <use xlink:href=\"#E2-MJMAIN-2212\" x=\"1528\" y=\"0\"></use>\n<g transform=\"translate(2529,0)\">\n <use xlink:href=\"#E2-MJMATHI-78\" x=\"24\" y=\"0\"></use>\n<g transform=\"translate(0,259)\">\n <use transform=\"scale(0.707)\" xlink:href=\"#E2-MJMAIN-AF\" x=\"-70\" y=\"0\"></use>\n<g transform=\"translate(243.33524654895245,0) scale(0.2427625054254761,1)\">\n <use transform=\"scale(0.707)\" xlink:href=\"#E2-MJMAIN-AF\"></use>\n</g>\n <use transform=\"scale(0.707)\" xlink:href=\"#E2-MJMAIN-AF\" x=\"379\" y=\"0\"></use>\n</g>\n</g>\n <use xlink:href=\"#E2-MJMAIN-29\" x=\"3151\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E2-MJMAIN-32\" x=\"5007\" y=\"712\"></use>\n</g>\n <use xlink:href=\"#E2-MJMAIN-3D\" x=\"5883\" y=\"0\"></use>\n<g transform=\"translate(6939,0)\">\n <use xlink:href=\"#E2-MJMAIN-31\"></use>\n <use xlink:href=\"#E2-MJMAIN-38\" x=\"500\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-30\" x=\"1001\" y=\"0\"></use>\n</g>\n</g>\n</svg></span> </p>\n<p>where each <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"2.129ex\" height=\"2.009ex\" style=\"vertical-align: -0.671ex;\" viewBox=\"0 -576.1 916.8 865.1\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-3-Title\">\n<title id=\"MathJax-SVG-3-Title\">x_i</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E3-MJMATHI-78\" d=