d{aligned}\n$$"}] [{:db/id #edb/ref 17592186443481 :knowledge-point/_questions [{:db/id #edb/ref 17592186184195 :knowledge-point/id #uuid "cb182688-828c-5252-8d6d-d09c93ba2bc8" :knowledge-point/title "Computing an Estimate of the Population Variance Using the Alternative Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "138278bc-8f58-5839-98b8-c61a9d2415ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.75" :db/id #edb/ref 17592186443413} {:answer/id #uuid "5231e110-de83-5beb-9bbe-513a3dc494c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.25" :db/id #edb/ref 17592186443426} {:answer/id #uuid "799d6b7d-3c95-585b-af79-10ceeea11d85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.5" :db/id #edb/ref 17592186443437} {:answer/id #uuid "b0fef01d-2c0a-5373-9767-64818f3cd010" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.25" :db/id #edb/ref 17592186443444} {:answer/id #uuid "e6635d68-c2da-535f-b53d-a46a3adbae72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.75" :db/id #edb/ref 17592186443458}] :answer-field/correct {:answer/id #uuid "5231e110-de83-5beb-9bbe-513a3dc494c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.25" :db/id #edb/ref 17592186443426} :answer-field/id #uuid "2f652f3e-3ab6-5596-8f84-5ff120c471c8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186443467}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "41998970-961a-5e8f-b06c-92a60dd861ec" :question/math-academy-id "q-88957" :question/problem "Suppose that ${x}_{1},{x}_{2},…,{x}_{13}$ is a random sample of size $n=13$ from a population, and \n\n$$\n\\overset{―}{{x}^{2}