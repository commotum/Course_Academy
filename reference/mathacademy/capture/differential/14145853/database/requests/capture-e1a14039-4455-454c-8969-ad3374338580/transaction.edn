}^{2}}-{(\\overset{―}{x})}^{2}] \\\\  & =\\frac{26}{26-1}\\cdot 5 \\\\  & =\\frac{130}{25} \\\\  & =5.2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-43858ee8-0cce-5541-a0b2-7dda22556d89"] :db/ensure [:question/validate]} {:db/id "answer-field-43858ee8-0cce-5541-a0b2-7dda22556d89" :answer-field/id #uuid "43858ee8-0cce-5541-a0b2-7dda22556d89" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4782e79d-2978-56f4-8596-d71632fec800" :answer-field/choices ["answer-4782e79d-2978-56f4-8596-d71632fec800" "answer-d2628084-0fcd-5c98-90c0-5d2f55fb9f20" "answer-6efb4a9f-ee23-54d8-bb63-67d67da3a792" "answer-c64059bc-60a7-5cf6-8990-bc4a4acd021d" "answer-d1e83c13-78d9-509c-937f-6d79daf8d735"] :db/ensure [:answer-field/validate]} {:db/id "answer-4782e79d-2978-56f4-8596-d71632fec800" :answer/id #uuid "4782e79d-2978-56f4-8596-d71632fec800" :answer/type :answer.type/math :answer/value "5.2" :db/ensure [:answer/validate]} {:db/id "answer-d2628084-0fcd-5c98-90c0-5d2f55fb9f20" :answer/id #uuid "d2628084-0fcd-5c98-90c0-5d2f55fb9f20" :answer/type :answer.type/math :answer/value "5.4" :db/ensure [:answer/validate]} {:db/id "answer-6efb4a9f-ee23-54d8-bb63-67d67da3a792" :answer/id #uuid "6efb4a9f-ee23-54d8-bb63-67d67da3a792" :answer/type :answer.type/math :answer/value "5.6" :db/ensure [:answer/validate]} {:db/id "answer-c64059bc-60a7-5cf6-8990-bc4a4acd021d" :answer/id #uuid "c64059bc-60a7-5cf6-8990-bc4a4acd021d" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-d1e83c13-78d9-509c-937f-6d79daf8d735" :answer/id #uuid "d1e83c13-78d9-509c-937f-6d79daf8d735" :answer/type :answer.type/math :answer/value "6.2" :db/ensure [:answer/validate]} {:db/id "question-41998970-961a-5e8f-b06c-92a60dd861ec" :question/id #uuid "41998970-961a-5e8f-b06c-92a60dd861ec" :question/math-academy-id "q-88957" :question/problem "Suppose that ${x}_{1},{x}_{2},…,{x}_{13}$ is a random sample of size $n=13$ from a population, and \n\n$$\n\\overset{―}{{x}^{2}}-{(\\overset{―}{x})}^{2}=3.\n$$\n\n \n\nCompute an unbiased estimate of the population variance." :question/worked-solution "Suppose ${X}_{1},{X}_{2},…{X}_{n}$ is a sequence of random variables representing a random sample of size $n$ drawn from a population with population mean $\\mu $ and population variance ${\\sigma }^{2}.$ Then, the sample variance ${S}^{2}$ is given by\n\n$$\n{S}^{2}=\\frac{1}{n-1}{\\sum }_{i=1}^{n}{({X}_{i}-\\overset{―}{X})}^{2}=\\frac{n}{n-1}[\\overset{―}{{X}^{2}}-{(\\overset{―}{X})}^{2}].\n$$\n\nNote that:\n\n- $\\overset{―}{X}$ is the sample mean,\n\n- the sample variance ${S}^{2}$ is an unbiased estimator of the population variance ${\\sigma }^{2},$ and\n\n- ${\\overset{^}{\\sigma }}^{2}={s}^{2}$ denotes an unbiased estimate of ${\\sigma }^{2}$ that's computed from the sample ${x}_{1},{x}_{2},…,{x}_{n}.$\n\nHere, there are $n=13$ data points in the sample, and we have\n\n$$\n\\overset{―}{{x}^{2}}-{(\\overset{―}{x})}^{2}=3.\n$$\n\nTherefore, an unbiased estimate of the population variance is\n\n$$\n\\begin{aligned}{\\overset{^}{\\sigma }}^{2} & ={s}^{2} \\\\  & =\\frac{n}{n-1}[\\overset{―}{{x}^{2}}-{(\\overset{―}{x})}^{2}] \\\\  & =\\frac{13}{13-1}\\cdot 3 \\\\  & =\\frac{39}{12} \\\\  & =3.25.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-2f652f3e-3ab6-5596-8f84-5ff120c471c8"] :db/ensure [:question/validate]} {:db/id "answer-field-2f652f3e-3ab6-5596-8f84-5ff120c471c8" :answer-field/id #uuid "2f652f3e-3ab6-5596-8f84-5ff120c471c8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5231e110-de83-5beb-9bbe-513a3dc494c0" :answer-field/choices ["answer-b0fef01d-2c0a-5373-9767-64818f3cd010" "answer-138278bc-8f58-5839-98b8-c61a9d2415ad" "answer-5231e110-de83-5beb-9bbe-513a3dc494c0" "answer-799d6b7d-3c95-585b-af79-10ceeea11d85" "answer-e6635d68-c2