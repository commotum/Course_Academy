ass=\"OPEN\">[</mo><mover><msup><mi>x</mi><mn>2</mn></msup><mo accent=\"true\">―</mo></mover><mo>−</mo><msup><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mover><mi>x</mi><mo accent=\"true\">―</mo></mover><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mn>2</mn></msup><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>26</mn><mrow><mn>26</mn><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle><mo>⋅</mo><mn>5</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>130</mn><mn>25</mn></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>5.2</mn><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
