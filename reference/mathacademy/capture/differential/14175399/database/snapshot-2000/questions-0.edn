#{[{:db/id #edb/ref 17592186262907 :knowledge-point/_questions [{:db/id #edb/ref 17592186105909 :knowledge-point/id #uuid "57c790ad-c7fb-596c-8b60-cddd9b4e2165" :knowledge-point/title "Calculating the Volume of a Parallelepiped Spanned by Three Position Vectors Given Their Coordinates"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "196c7bb9-2703-5d83-8058-24be71bcb43b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186260097} {:answer/id #uuid "44662d03-7907-5288-b2f2-17f084b58313" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186260471} {:answer/id #uuid "5d8121de-a71a-5f79-841e-03f4c4d8f85c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186260679} {:answer/id #uuid "c69b8832-1644-5736-8a79-f96a8d866802" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186261625} {:answer/id #uuid "fba18045-5247-5864-b09c-6d2f59aad9bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186262075}] :answer-field/correct {:answer/id #uuid "44662d03-7907-5288-b2f2-17f084b58313" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186260471} :answer-field/id #uuid "00e3b359-0ccd-5626-ac16-03a3053097e9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262125}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1edaed17-510c-5349-a80b-092dc57c864f" :question/math-academy-id "q-128475" :question/problem "Calculate the volume of the parallelepiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC}$ and $\\overset{\\to }{AD},$ given the points $A(7,6,4),$ $B(8,5,9),$ $C(7,4,2),$ and $D(5,7,4).$" :question/worked-solution "First, we find the displacement vectors $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ that span the parallelepiped:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =(8i+5j+9k)-(7i+6j+4k) \\\\  & =i-j+5k \\\\  & =⟨1,-1,5⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =(7i+4j+2k)-(7i+6j+4k) \\\\  & =-2j-2k \\\\  & =⟨0,-2,-2⟩ \\\\ \\overset{\\to }{AD} & =d-a \\\\  & =(5i+7j+4k)-(7i+6j+4k) \\\\  & =-2i+j \\\\  & =⟨-2,1,0⟩\\end{aligned}\n$$\n\nNow, to find the volume of the parallelepiped, we need to take the absolute value of the triple product of the above vectors.\n\nComputing the triple product, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot (\\overset{\\to }{AC}\\times \\overset{\\to }{AD}) & =|\\begin{aligned}1 & -1 & 5 \\\\ 0 & -2 & -2 \\\\ -2 & 1 & 0\\end{aligned}| \\\\  & =1\\cdot |\\begin{aligned}-2 & -2 \\\\ 1 & 0\\end{aligned}|-(-1)\\cdot |\\begin{aligned}0 & -2 \\\\ -2 & 0\\end{aligned}|+5\\cdot |\\begin{aligned}0 & -2 \\\\ -2 & 1\\end{aligned}| \\\\  & =((-2)\\cdot 0-1\\cdot (-2))+(0\\cdot 0-(-2)\\cdot (-2))+5(0\\cdot 1-(-2)\\cdot (-2)) \\\\  & =2-4-20 \\\\  & =-22.\\end{aligned}\n$$\n\nTherefore, the volume of the corresponding parallelepiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ is\n\n$$\nV=|-22|=22.\n$$"}] [{:db/id #edb/ref 17592186106135 :knowledge-point/_questions [{:db/id #edb/ref 17592186105909 :knowledge-point/id #uuid "57c790ad-c7fb-596c-8b60-cddd9b4e2165" :knowledge-point/title "Calculating the Volume of a Parallelepiped Spanned by Three Position Vectors Given Their Coordinates"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cf3c4e57-2ad8-56ca-9a27-7faa2aaf1255" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186102687} {:answer/id #uuid "d07f6bfb-5502-5a87-b026-3ef84ecd878d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186102688} {:answer/id #uuid "ec1ae10b-c98c-5aea-b28d-a0931aaf66da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186102689} {:answer/id #uuid "4b15e493-3d4c-50d7-8e36-9379740a5e5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186102690} {:answer/id #uuid "5c8d1f64-85e4-551c-8f55-38866b9af8a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186102691}] :answer-field/id #uuid "5a8e5f2b-038e-5f94-8231-636fcf8c722e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186102686}] :question/id #uuid "c6409f39-73a4-56e7-9d4f-f576ba58985d" :question/math-academy-id "q-20138" :question/problem "Calculate the volume of the parallelepiped spanned by $AB^(→)$, $AC^(→)$ and $AD^(→)$, given the points $A(1, 2,-1)$, $B(2, 3, 1)$, $C(4, 1, 2)$, and $D(1, 4, 2)$."}] [{:db/id #edb/ref 17592186295176 :knowledge-point/_questions [{:db/id #edb/ref 17592186105909 :knowledge-point/id #uuid "57c790ad-c7fb-596c-8b60-cddd9b4e2165" :knowledge-point/title "Calculating the Volume of a Parallelepiped Spanned by Three Position Vectors Given Their Coordinates"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6122a148-198a-57cc-b7dd-7fcbcaac6bb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "27" :db/id #edb/ref 17592186293328}] :answer-field/correct {:answer/id #uuid "6122a148-198a-57cc-b7dd-7fcbcaac6bb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "27" :db/id #edb/ref 17592186293328} :answer-field/id #uuid "d6bff096-9adc-55e6-b402-42dc714742c4" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294687}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c74fea15-7593-5e2d-a899-51b33896c8fd" :question/math-academy-id "q-281030" :question/problem "Calculate the volume $V$ of the parallelepiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD},$ given the points $A(-1,0,1),$ $B(2,-3,4),$ $C(-2,-2,2),$ and $D(0,-1,5).$\n\n$V=${{field-1}}" :question/worked-solution "First, we find the displacement vectors $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ that span the parallelepiped:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =(2i-3j+4k)-(-i+1k) \\\\  & =3i-3j+3k \\\\  & =⟨3,-3,3⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =(-2i-2j+2k)-(-i+1k) \\\\  & =-i-2j+1k \\\\  & =⟨-1,-2,1⟩ \\\\ \\overset{\\to }{AD} & =d-a \\\\  & =(-j+5k)-(-i+1k) \\\\  & =i-j+4k \\\\  & =⟨1,-1,4⟩\\end{aligned}\n$$\n\nNow, to find the volume of the parallelepiped, we need to take the absolute value of the triple product of the above vectors.\n\nComputing the triple product, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot (\\overset{\\to }{AC}\\times \\overset{\\to }{AD}) & =|\\begin{aligned}3 & -3 & 3 \\\\ -1 & -2 & 1 \\\\ 1 & -1 & 4\\end{aligned}| \\\\  & =3\\cdot |\\begin{aligned}-2 & 1 \\\\ -1 & 4\\end{aligned}|-(-3)\\cdot |\\begin{aligned}-1 & 1 \\\\ 1 & 4\\end{aligned}|+3\\cdot |\\begin{aligned}-1 & -2 \\\\ 1 & -1\\end{aligned}| \\\\  & =3(-8+1)+3(-4-1)+3(1-(-2)) \\\\  & =-21-15+9 \\\\  & =-27.\\end{aligned}\n$$\n\nTherefore, the volume of the corresponding parallelepiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ is\n\n$$\nV=|-27|=27.\n$$"}]}
