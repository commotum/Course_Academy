7592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284033}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "34ac06c6-738c-5077-b953-6f19c9bf7aa1" :question/math-academy-id "q-164216" :question/problem "What is the trace in the $xz$-plane of the ellipsoid $\\frac{(x-3)^{2}}{16}+\\frac{{y}^{2}}{2}+{z}^{2}=1?$" :question/worked-solution "To find the trace in the $xz$-plane, we substitute $y=0$ into the equation of the ellipsoid:\n\n$$\n\\begin{aligned}\\frac{(x-3)^{2}}{16}+\\frac{{0}^{2}}{2}+{z}^{2} & =1 \\\\ \\frac{(x-3)^{2}}{16}+{z}^{2} & =1 \\\\ \\frac{(x-3)^{2}}{{4}^{2}}+\\frac{{z}^{2}}{{1}^{2}} & =1\\end{aligned}\n$$\n\nThis gives us the equation of the ellipse with semi-axes $4$ and $1,$ centered at $(3,0)$ in the $xz$-plane."}] [{:db/id #edb/ref 17592186378892 :knowledge-point/_questions [{:db/id #edb/ref 17592186124502 :knowledge-point/id #uuid "64e7d2fb-003c-58c0-ab80-159e50748cc7" :knowledge-point/title "Calculating Intercepts of Spheres and Ellipsoids"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "77d05961-b54e-5f9f-ac67-691ed3feb22e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-4,0,0)$ and $(4,0,0).$" :db/id #edb/ref 17592186378894} {:answer/id #uuid "1deaf375-2c39-5642-95d0-e115488ca297" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0,0)$ and $(2,0,0).$" :db/id #edb/ref 17592186378895} {:answer/id #uuid "39b766ee-4ff9-559c-bae8-c5fc1cc4f2c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-2,0,0)$ and $(0,0,0).$" :db/id #edb/ref 17592186378896} {:answer/id #uuid "2190b75a-4f8e-5efb-a353-5e0881c39757" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0,0)$ and $(4,0,0)$" :db/id #edb/ref 17592186378897} {:answer/id #uuid "6123778b-2ad5-549e-a346-56d2293a36fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-2,0,0)$ and $(2,0,0).$" :db/id #edb/ref 17592186378898}] :answer-field/correct {:answer/id #uuid "2190b75a-4f8e-5efb-a353-5e0881c39757" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0,0)$ and $(4,0,0)$" :db/id #edb/ref 17592186378897} :answer-field/id #uuid "c6ab9847-35b1-5697-965c-e0e4ae7c065e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378893}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8358ba3d-fe0d-5487-9222-565dc3b520a1" :question/math-academy-id "q-164251" :question/problem "Given the ellipsoid $\\frac{(x-2)^{2}}{16}+\\frac{(y+2)^{2}}{8}+\\frac{(z-1)^{2}}{4}=1$, find its intercepts with the $x$-axis." :question/worked-solution "To find the $x$-intercepts, we plug $y=0$ and $z=0$ into the equation:\n\n$$\n\\begin{aligned}\\frac{(x-2)^{2}}{16}+\\frac{(0+2)^{2}}{8}+\\frac{(0-1)^{2}}{4} & =1 \\\\ \\frac{(x-2)^{2}}{16}+\\frac{1}{2}+\\frac{1}{4} & =1 \\\\ \\frac{(x-2)^{2}}{16} & =\\frac{1}{4} \\\\ (x-2)^{2} & =4 \\\\ x-2 & =\\pm 2 \\\\ x & =2\\pm 2\\end{aligned}\n$$\n\nHence, we get the solutions $x=0$ and $x=4.$\n\nTherefore, the intercepts with the $x$-axis are $(0,0,0)$ and $(4,0,0).$"}] [{:db/id #edb/ref 17592186401460 :knowledge-point/_questions [{:db/id #edb/ref 17592186124649 :knowledge-point/id #uuid "08c2d581-8b12-575d-bb78-d8bb293a7339" :knowledge-point/title "The Domain of a Sphere or Ellipsoid"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9e71a948-a9c5-5faf-b47c-17e50a3f8324" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The interior and boundary of the circle of radius $3$ centered at $(3,1)$" :db/id #edb/ref 17592186401462} {:answer/id #uuid "1e85c958-d38e-5452-bf22-85abbc7a75bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The interior and boundary of the circle of radius $3$ centered at $(1,-3)$" :db/id #edb/ref 17592186401463} {:answer/id #uuid "df3c0953-d686-59f3-a7d7-fe00ebde4e1d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The interior and boundary of the circle of radius $\\sqrt{3}$ centered at $(-3,1)$" :db/id #edb/ref 17592186401464} {:answer/id #uuid "c7c4b9ff-1b21-54cc-b53e-7eb6f046091b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The interior and boundary of the circle of radius $\\sqrt{3}$ centered at $(3,2)$" :db/id #edb/ref 17592186401465} {:answer/id #uuid "598580ec-0b00-5ab0-a4fe-2e46a90d75e6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The interior and boundary of the circle of radius $\\sqrt{3}$ centered at $(1,3)$" :db/id #edb/ref 17592186401466}] :answer-field/correct {:answer/id #uuid "9e71a948-a9c5-5faf-b47c-17e50a3f8324" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The interior and boundary of the circle of radius $3$ centered at $(3,1)$" :db/id #edb/ref 17592186401462} :answer-field/id #uuid "182e0ed3-43fe-59b0-b733-03b03b4eb82f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401461}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3e6a384d-7ca2-5551-9c7a-30830f5ff58a" :question/math-academy-id "q-164311" :question/problem "Given the sphere $(x-3)^{2}+(y-1)^{2}+(z-2)^{2}=9,$ what is the domain of $z=z(x,y)?$" :question/worked-solution "From the equation of the sphere, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}(x-3)^{2}+(y-1)^{2}+(z-2)^{2} & =9 \\\\ (z-2)^{2} & =9-((x-3)^{2}+(y-1)^{2}) \\\\ z-2 & =\\pm \\sqrt{9-((x-3)^{2}+(y-1)^{2})} \\\\ z & =2\\pm \\sqrt{9-((x-3)^{2}+(y-1)^{2})}\\end{aligned}\n$$\n\nSince the square root is defined only for non-negative arguments, we have the following:\n\n$$\n\\begin{aligned}9-((x-3)^{2}+(y-1)^{2})\\ge 0 \\\\ (x-3)^{2}+(y-1)^{2}\\le 9\\end{aligned}\n$$\n\nThis inequality describes the interior and boundary of the circle \n\n$$\n(x-3)^{2}+(y-1)^{2}=9\n$$\n\nwhich is a circle of radius $3$ centered at $(3,1)$ in the $xy$-plane."}] [{:db/id #edb/ref 17592186378941 :knowledge-point/_questions [{:db/id #edb/ref 17592186124649 :knowledge-point/id #uuid "08c2d581-8b12-575d-bb78-d8bb293a7339" :knowledge-point/title "The Domain of a Sphere or Ellipsoid"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a719123-d941-522f-b216-e78a28925020" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,(x-1)^{2}+\\frac{(y-1)^{2}}{4}>1}" :db/id #edb/ref 17592186378943} {:answer/id #uuid "e3de31ff-ea7e-5492-8565-087a8702ee30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,(x-1)^{2}+\\frac{{y}^{2}}{4}\\le 1}" :db/id #edb/ref 17592186378944} {:answer/id #uuid "a654e349-743c-56dc-bcdd-ec9064bc30d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,{x}^{2}+\\frac{(y-1)^{2}}{4}\\le 1}" :db/id #edb/ref 17592186378945} {:answer/id #uuid "5a6cef30-dbda-57b7-b65f-5d1ee04f7346" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,(x-1)^{2}+\\frac{(y-1)^{2}}{4}\\le 1}" :db/id #edb/ref 17592186378946} {:answer/id #uuid "51a5d61e-e9be-55ec-af83-94c29bb7d9da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,(x-1)^{2}+\\frac{(y-2)^{2}}{4}<1}" :db/id #edb/ref 17592186378947}] :answer-field/correct {:answer/id #uuid "5a6cef30-dbda-57b7-b65f-5d1ee04f7346" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,(x-1)^{2}+\\frac{(y-1)^{2}}{4}\\le 1}" :db/id #edb/ref 17592186378946} :answer-field/id #uuid "b03fdffd-f573-5a99-b226-1770ea3e8102" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378942}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b4c3310c-555f-544e-9fd7-31c9a3fe58ac" :question/math-academy-id "q-164399" :question/problem "Given the ellipsoid $(x-1)^{2}+\\frac{(y-1)^{2}}{4}+\\frac{(z-5)^{2}}{2}=1$, find the domain of $z=z(x,y).$" :question/worked-solution "From the ellipsoid equation, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}(x-1)^{2}+\\frac{(y-1)^{2}}{4}+\\frac{(z-5)^{2}}{2} & =1 \\\\ (z-5)^{2} & =2(1-(x-1)^{2}-\\frac{(y-1)^{2}}{4}) \\\\ z-5 & =\\pm \\sqrt{2(1-(x-1)^{2}-\\frac{(y-1)^{2}}{4})}\\end{aligned}\n$$\n\n \n\nSince the square root is defined only for non-negative arguments, we have:\n\n$$\n\\begin{aligned}1-(x-1)^{2}-\\frac{(y-1)^{2}}{4}\\ge 0 \\\\ (x-1)^{2}+\\frac{(y-1)^{2}}{4}\\le 1\\end{aligned}\n$$\n\n \n\nwhich gives the interior of the ellipse $(x-1)^{2}+\\frac{(y-1)^{2}}{4}=1$ and its boundary.\n\nTherefore, the domain is \n\n$$\n{(x,y)\\,:\\,(x-1)^{2}+\\frac{(y-1)^{2}}{4}\\le 1}.\n$$"}]}
