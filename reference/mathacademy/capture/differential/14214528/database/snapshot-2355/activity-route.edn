#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186525088} :activity/id #uuid "97656ef7-8b3f-5b3b-a78e-b180f6afdb4b" :activity/scope {:db/id #edb/ref 17592186049477 :topic/id #uuid "f843541a-9614-5f09-bac2-fce7637a0932" :topic/math-academy-id 1896} :activity/steps [{:db/id #edb/ref 17592186525070 :step/content {:db/id #edb/ref 17592186401460 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9e71a948-a9c5-5faf-b47c-17e50a3f8324" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The interior and boundary of the circle of radius $3$ centered at $(3,1)$" :db/id #edb/ref 17592186401462} {:answer/id #uuid "1e85c958-d38e-5452-bf22-85abbc7a75bf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The interior and boundary of the circle of radius $3$ centered at $(1,-3)$" :db/id #edb/ref 17592186401463} {:answer/id #uuid "df3c0953-d686-59f3-a7d7-fe00ebde4e1d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The interior and boundary of the circle of radius $\\sqrt{3}$ centered at $(-3,1)$" :db/id #edb/ref 17592186401464} {:answer/id #uuid "c7c4b9ff-1b21-54cc-b53e-7eb6f046091b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The interior and boundary of the circle of radius $\\sqrt{3}$ centered at $(3,2)$" :db/id #edb/ref 17592186401465} {:answer/id #uuid "598580ec-0b00-5ab0-a4fe-2e46a90d75e6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The interior and boundary of the circle of radius $\\sqrt{3}$ centered at $(1,3)$" :db/id #edb/ref 17592186401466}] :answer-field/correct {:db/id #edb/ref 17592186401462} :answer-field/id #uuid "182e0ed3-43fe-59b0-b733-03b03b4eb82f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186401461}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3e6a384d-7ca2-5551-9c7a-30830f5ff58a" :question/math-academy-id "q-164311" :question/problem "Given the sphere $(x-3)^{2}+(y-1)^{2}+(z-2)^{2}=9,$ what is the domain of $z=z(x,y)?$" :question/worked-solution "From the equation of the sphere, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}(x-3)^{2}+(y-1)^{2}+(z-2)^{2} & =9 \\\\ (z-2)^{2} & =9-((x-3)^{2}+(y-1)^{2}) \\\\ z-2 & =\\pm \\sqrt{9-((x-3)^{2}+(y-1)^{2})} \\\\ z & =2\\pm \\sqrt{9-((x-3)^{2}+(y-1)^{2})}\\end{aligned}\n$$\n\nSince the square root is defined only for non-negative arguments, we have the following:\n\n$$\n\\begin{aligned}9-((x-3)^{2}+(y-1)^{2})\\ge 0 \\\\ (x-3)^{2}+(y-1)^{2}\\le 9\\end{aligned}\n$$\n\nThis inequality describes the interior and boundary of the circle \n\n$$\n(x-3)^{2}+(y-1)^{2}=9\n$$\n\nwhich is a circle of radius $3$ centered at $(3,1)$ in the $xy$-plane."} :step/id #uuid "05f9a82f-656b-50bc-8f0f-e8191e8f5a42" :step/next {:db/id #edb/ref 17592186525110}} {:db/id #edb/ref 17592186525088 :step/content {:db/id #edb/ref 17592186524967 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6614239e-1f45-5292-a065-0e178c240ecc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An ellipse with semi-axes $4$ and $2,$ centered at $(0,1)$ in the $xy$-plane" :db/id #edb/ref 17592186524549} {:answer/id #uuid "b85f60df-219f-5be3-aaaf-2385ba1bce5f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An ellipse with semi-axes $2$ and $\\sqrt{2},$ centered at $(0,1)$ in the $xy$-plane" :db/id #edb/ref 17592186524675} {:answer/id #uuid "d676a34b-4dca-5450-bd6d-3361f79fa4f9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An ellipse with semi-axes $2$ and $\\sqrt{2},$ centered at $(0,0)$ in the $xy$-plane" :db/id #edb/ref 17592186524740} {:answer/id #uuid "e6f6a3eb-578c-5a4e-a845-6dfd36aaeb14" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An ellipse with semi-axes $\\sqrt{2}$ and $\\sqrt{2},$ centered at $(1,0)$ in the $xy$-plane" :db/id #edb/ref 17592186524789} {:answer/id #uuid "fa525cea-3517-526d-84b3-2444d744b1e5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An ellipse with semi-axes $4$ and $2,$ centered at $(1,0)$ in the $xy$-plane" :db/id #edb/ref 17592186524831}] :answer-field/correct {:db/id #edb/ref 17592186524675} :answer-field/id #uuid "ee99d141-0b3e-5394-b62b-4fd1bb248207" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186524944}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "17beca86-e4d7-5c67-a86e-43d1aa96f62a" :question/math-academy-id "q-35256" :question/problem "What is the trace in the $xy$-plane of the ellipsoid $\\frac{{x}^{2}}{4}+\\frac{(y-1)^{2}}{2}+\\frac{{z}^{2}}{2}=1?$" :question/worked-solution "To find the trace in the $xy$-plane, we substitute $z=0$ into the equation of the ellipsoid:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{4}+\\frac{(y-1)^{2}}{2}+\\frac{{0}^{2}}{2} & =1 \\\\ \\frac{{x}^{2}}{4}+\\frac{(y-1)^{2}}{2} & =1 \\\\ \\frac{{x}^{2}}{{2}^{2}}+\\frac{(y-1)^{2}}{(\\sqrt{2})^{2}} & =1\\end{aligned}\n$$\n\nThis gives us the equation of the ellipse with semi-axes $2$ and $\\sqrt{2},$ centered at $(0,1)$ in the $xy$-plane."} :step/id #uuid "3f47cbab-f727-53bf-9a6c-904dcbb4215a" :step/next {:db/id #edb/ref 17592186525095}} {:db/id #edb/ref 17592186525095 :step/content {:db/id #edb/ref 17592186284454 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00f92c09-b721-512b-a0c6-93269c8f28a9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An ellipse with semi-axes $2\\sqrt{2}$ and $2,$ centered at $(3,0)$ in the $xz$-plane" :db/id #edb/ref 17592186281696} {:answer/id #uuid "0480d13f-f224-5cae-a7e4-474f969e8370" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An ellipse with semi-axes $4$ and $1,$ centered at $(0,0)$ in the $xz$-plane" :db/id #edb/ref 17592186281728} {:answer/id #uuid "05431c2a-03fe-511d-8152-1d11098c3982" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An ellipse with semi-axes $4$ and $1,$ centered at $(3,0)$ in the $xz$-plane" :db/id #edb/ref 17592186281734} {:answer/id #uuid "512f3ece-ed46-51ac-b5af-a7cb5dbf52e9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An ellipse with semi-axes $2\\sqrt{2}$ and $\\sqrt{2},$ centered at $(0,3)$ in the $xz$-plane" :db/id #edb/ref 17592186282383} {:answer/id #uuid "9d744398-f703-5b3c-b0c5-eeeb774fab49" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An ellipse with semi-axes $2\\sqrt{2}$ and $\\sqrt{2},$ centered at $(0,0)$ in the $xz$-plane" :db/id #edb/ref 17592186283062}] :answer-field/correct {:db/id #edb/ref 17592186281734} :answer-field/id #uuid "38f38b8d-bfde-542c-84e9-205f74a6bb61" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186284033}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "34ac06c6-738c-5077-b953-6f19c9bf7aa1" :question/math-academy-id "q-164216" :question/problem "What is the trace in the $xz$-plane of the ellipsoid $\\frac{(x-3)^{2}}{16}+\\frac{{y}^{2}}{2}+{z}^{2}=1?$" :question/worked-solution "To find the trace in the $xz$-plane, we substitute $y=0$ into the equation of the ellipsoid:\n\n$$\n\\begin{aligned}\\frac{(x-3)^{2}}{16}+\\frac{{0}^{2}}{2}+{z}^{2} & =1 \\\\ \\frac{(x-3)^{2}}{16}+{z}^{2} & =1 \\\\ \\frac{(x-3)^{2}}{{4}^{2}}+\\frac{{z}^{2}}{{1}^{2}} & =1\\end{aligned}\n$$\n\nThis gives us the equation of the ellipse with semi-axes $4$ and $1,$ centered at $(3,0)$ in the $xz$-plane."} :step/id #uuid "56ceaeb1-6ec7-595a-9937-934df0bd5805" :step/next {:db/id #edb/ref 17592186525105}} {:db/id #edb/ref 17592186525105 :step/content {:db/id #edb/ref 17592186378892 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "77d05961-b54e-5f9f-ac67-691ed3feb22e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(-4,0,0)$ and $(4,0,0).$" :db/id #edb/ref 17592186378894} {:answer/id #uuid "1deaf375-2c39-5642-95d0-e115488ca297" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(0,0,0)$ and $(2,0,0).$" :db/id #edb/ref 17592186378895} {:answer/id #uuid "39b766ee-4ff9-559c-bae8-c5fc1cc4f2c8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(-2,0,0)$ and $(0,0,0).$" :db/id #edb/ref 17592186378896} {:answer/id #uuid "2190b75a-4f8e-5efb-a353-5e0881c39757" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(0,0,0)$ and $(4,0,0)$" :db/id #edb/ref 17592186378897} {:answer/id #uuid "6123778b-2ad5-549e-a346-56d2293a36fc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(-2,0,0)$ and $(2,0,0).$" :db/id #edb/ref 17592186378898}] :answer-field/correct {:db/id #edb/ref 17592186378897} :answer-field/id #uuid "c6ab9847-35b1-5697-965c-e0e4ae7c065e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186378893}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8358ba3d-fe0d-5487-9222-565dc3b520a1" :question/math-academy-id "q-164251" :question/problem "Given the ellipsoid $\\frac{(x-2)^{2}}{16}+\\frac{(y+2)^{2}}{8}+\\frac{(z-1)^{2}}{4}=1$, find its intercepts with the $x$-axis." :question/worked-solution "To find the $x$-intercepts, we plug $y=0$ and $z=0$ into the equation:\n\n$$\n\\begin{aligned}\\frac{(x-2)^{2}}{16}+\\frac{(0+2)^{2}}{8}+\\frac{(0-1)^{2}}{4} & =1 \\\\ \\frac{(x-2)^{2}}{16}+\\frac{1}{2}+\\frac{1}{4} & =1 \\\\ \\frac{(x-2)^{2}}{16} & =\\frac{1}{4} \\\\ (x-2)^{2} & =4 \\\\ x-2 & =\\pm 2 \\\\ x & =2\\pm 2\\end{aligned}\n$$\n\nHence, we get the solutions $x=0$ and $x=4.$\n\nTherefore, the intercepts with the $x$-axis are $(0,0,0)$ and $(4,0,0).$"} :step/id #uuid "75d99a5b-c852-5111-a02c-67dea933b6f4" :step/next {:db/id #edb/ref 17592186525070}} {:db/id #edb/ref 17592186525110 :step/content {:db/id #edb/ref 17592186378941 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0542b6da-d2bf-5b22-bd04-20504f562c8e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{(x,y)\\,:\\,(x-1)^{2}+\\frac{(y-1)^{2}}{4}>1\\}" :db/id #edb/ref 17592186524389} {:answer/id #uuid "2c483d3e-2246-508e-b8da-35510f1d8428" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{(x,y)\\,:\\,(x-1)^{2}+\\frac{{y}^{2}}{4}\\le 1\\}" :db/id #edb/ref 17592186524462} {:answer/id #uuid "c0ba014d-0ec2-55fe-bf40-d651669f4cc1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{(x,y)\\,:\\,(x-1)^{2}+\\frac{(y-1)^{2}}{4}\\le 1\\}" :db/id #edb/ref 17592186524690} {:answer/id #uuid "c6f713a9-8f47-5306-bfae-9b1382971838" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{(x,y)\\,:\\,{x}^{2}+\\frac{(y-1)^{2}}{4}\\le 1\\}" :db/id #edb/ref 17592186524702} {:answer/id #uuid "dfef3fad-9852-5933-acfa-b0120c7d2df8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{(x,y)\\,:\\,(x-1)^{2}+\\frac{(y-2)^{2}}{4}<1\\}" :db/id #edb/ref 17592186524769}] :answer-field/correct {:db/id #edb/ref 17592186524690} :answer-field/id #uuid "b03fdffd-f573-5a99-b226-1770ea3e8102" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186378942}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "b4c3310c-555f-544e-9fd7-31c9a3fe58ac" :question/math-academy-id "q-164399" :question/problem "Given the ellipsoid $(x-1)^{2}+\\frac{(y-1)^{2}}{4}+\\frac{(z-5)^{2}}{2}=1$, find the domain of $z=z(x,y).$" :question/worked-solution "From the ellipsoid equation, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}(x-1)^{2}+\\frac{(y-1)^{2}}{4}+\\frac{(z-5)^{2}}{2} & =1 \\\\ (z-5)^{2} & =2(1-(x-1)^{2}-\\frac{(y-1)^{2}}{4}) \\\\ z-5 & =\\pm \\sqrt{2(1-(x-1)^{2}-\\frac{(y-1)^{2}}{4})}\\end{aligned}\n$$\n\n \n\nSince the square root is defined only for non-negative arguments, we have:\n\n$$\n\\begin{aligned}1-(x-1)^{2}-\\frac{(y-1)^{2}}{4}\\ge 0 \\\\ (x-1)^{2}+\\frac{(y-1)^{2}}{4}\\le 1\\end{aligned}\n$$\n\n \n\nwhich gives the interior of the ellipse $(x-1)^{2}+\\frac{(y-1)^{2}}{4}=1$ and its boundary.\n\nTherefore, the domain is \n\n$$\n\\{(x,y)\\,:\\,(x-1)^{2}+\\frac{(y-1)^{2}}{4}\\le 1\\}.\n$$"} :step/id #uuid "8beb4ab1-bdc6-52df-894d-4e715c654bd8"}] :activity/title "Ellipsoids" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186524370}]}
