><mi>x</mi><mi>y</mi><mo>≤</mo><mn>1</mn><mo fence=\"false\" stretchy=\"false\">}</mo><mo>∩</mo><mo fence=\"false\" stretchy=\"false\">{</mo><mo stretchy=\"false\">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy=\"false\">)</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mo>:</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mo>−</mo><mn>1</mn><mo>&lt;</mo><mi>x</mi><mi>y</mi><mo>&lt;</mo><mn>1</mn><mo fence=\"false\" stretchy=\"false\">}</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo fence=\"false\" stretchy=\"false\">{</mo><mo stretchy=\"false\">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy=\"false\">)</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mo>:</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mo>−</mo><mn>1</mn><mo>&lt;</mo><mi>x</mi><mi>y</mi><mo>&lt;</mo><mn>1</mn><mo fence=\"false\" stretchy=\"false\">}</mo><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
