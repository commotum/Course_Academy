#{[{:activity/expected-seconds 480.0 :activity/first-step {:db/id #edb/ref 17592186153102} :activity/id #uuid "9ac1ae53-cd07-5301-b138-85876fe1cd80" :activity/scope {:db/id #edb/ref 17592186049672 :topic/id #uuid "09a480ff-86b3-5a9f-87fc-9be4a100ee60" :topic/math-academy-id 2746} :activity/steps [{:db/id #edb/ref 17592186153102 :step/content {:db/id #edb/ref 17592186153377 :tutorial/content "Consider the following ellipse:\n\n![](images/a0/a0ad477f0f911f2841738defe666f84f448777c1d1b1498d53ac81daa3fabb41.png)\n\nThis ellipse is centered at the origin, has a horizontal radius of $4$ and a vertical radius of $3.$\n\nThe parametric equations for this ellipse are\n\n$$\nx = 4\\cos{\\theta},\\quad y=3\\sin\\theta, \\quad 0\\leq \\theta \\lt 2\\pi.\n$$\n\nIn general, an ellipse centered at $O$ with horizontal radius $a$ and vertical radius $b$ has parametric equations\n\n$$\nx = a\\cos{\\theta},\\quad y=b\\sin\\theta, \\quad 0\\leq \\theta \\lt 2\\pi.\n$$\n\nUnder this parameterization, the ellipse is traversed once counterclockwise starting from the point $(a,0).$" :tutorial/id #uuid "c23180fb-1491-5e96-8773-fd53608a3c84" :tutorial/math-academy-id 4150 :tutorial/title "Introduction"} :step/id #uuid "769f3b17-060b-567d-b07b-b00699ec2000" :step/math-academy-id 25233 :step/next {:db/id #edb/ref 17592186153103}} {:db/id #edb/ref 17592186153103 :step/content {:db/id #edb/ref 17592186152187 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151989 :question/id #uuid "e57f9dab-c5db-55d9-9b21-375bbc92281c" :question/math-academy-id "e-6814"} :knowledge-point/id #uuid "db20f4a5-27a4-5fbc-aae2-2febf8f99cb1" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048432} {:db/id #edb/ref 17592186050722}] :knowledge-point/questions [{:db/id #edb/ref 17592186152431} {:db/id #edb/ref 17592186152432} {:db/id #edb/ref 17592186241161} {:db/id #edb/ref 17592186241162} {:db/id #edb/ref 17592186241163} {:db/id #edb/ref 17592186243927} {:db/id #edb/ref 17592186292788} {:db/id #e