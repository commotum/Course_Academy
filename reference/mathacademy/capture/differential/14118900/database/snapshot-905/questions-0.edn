#{[{:db/id #edb/ref 17592186124290 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186124477 :knowledge-point/id #uuid "488c9762-554b-5ea6-b414-ce6cbde9bbd1" :knowledge-point/title "Finding the Pivot Columns of a Matrix in Row Echelon Form"}] :question/id #uuid "ccfdc303-534f-530e-810b-f475a997f5d8" :question/math-academy-id "e-4703" :question/problem "The row echelon form matrix $B$ is given below. What are its pivot columns?\n![](images/ce/ce4c17b3e47f0618d315e8e61feeb2b58cd913e54b63a3a375b8bd4676efbc8e.svg)" :question/worked-solution "Remember that the pivots of a matrix in row echelon form are the first non-zero entries in each row of the matrix.\n\nWe can see that $B$ has $3$ pivots in the $2$nd, $3$rd, and $4$th columns:\n\n![](images/31/31b76b7840d750cf7cf060c5d218644f8733d46a0b59c0e347aeb634ea6c1091.svg)"}] [{:db/id #edb/ref 17592186124291 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186124478 :knowledge-point/id #uuid "a5f0d2e9-1cf6-5fe4-85cc-f401382f39b2" :knowledge-point/title "Finding the Non-Pivot Columns of a Matrix in Row Echelon Form"}] :question/id #uuid "22a77802-4114-516f-a0e0-4cda2e069361" :question/math-academy-id "e-4704" :question/problem "The row echelon form matrix $C$ is given below. What are its **non**-pivot columns?\n\n![](images/b1/b1f927457c74f57ff2e7cdb9d030492fffcb49bdfd9199e8720d3da2263e0b1e.svg)" :question/worked-solution "Remember that the pivots of a matrix in row echelon form are the first non-zero entries in each row of the matrix.\n\nWe can see that $C$ has $3$ pivots in the $1$st, $3$rd, and $4$th columns:\n\n![](images/05/05264585d59a4430f5424b91f649eecc80a5f28fa460a935f5c224882e08d56c.svg)\n\nTherefore, the only non-pivot column is the $2$nd column."}] [{:db/id #edb/ref 17592186124292 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186124479 :knowledge-point/id #uuid "1073953e-7e0a-5237-8533-8882b7772741" :knowledge-point/title "Finding the Number of Pivot Columns of a Matrix"}] :question/id #uuid "6e4b2e85-86a8-5050-a60a-ae8d40453ad0" :question/math-academy-id "e-4705" :question/problem "Determine the number of pivot columns of the matrix $A,$ given by\n![](images/df/dfe650778e528254fc2098714566d954c47442ede485d6a92495cf16eb9e936d.svg)" :question/worked-solution "First, we need to convert $A$ to row echelon form:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1 & 0 & 0 & 0 \\\\ 0 & 3 & 0 & -2 \\\\ 0 & -6 & 1 & 4\\end{aligned}] & {R}_{3}:={R}_{3}+2{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & 0 \\\\ 0 & 3 & 0 & -2 \\\\ 0 & 0 & 1 & 0\\end{aligned}]\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $A$ has $3$ pivots, and therefore the number of pivot columns is $3.$"}] [{:db/id #edb/ref 17592186124293 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186124480 :knowledge-point/id #uuid "b1a557d6-52f3-5df3-8088-5b875296e72e" :knowledge-point/title "Finding the Pivot Columns of a Matrix"}] :question/id #uuid "3ac076bd-5add-5c08-bb96-7b11c0a37d54" :question/math-academy-id "e-4706" :question/problem "What are the pivot columns of the matrix $B,$ given by\n![](images/f1/f10a5ef881920312ccdb163d9db70779d3848f7dc510c29d516eaf74a5ddd38d.svg)" :question/worked-solution "First, we need to convert $B$ to row echelon form:\n\n$$\n\\begin{aligned}B & =[\\begin{aligned}1 & -5 & 0 & 0 \\\\ 0 & 0 & 2 & 0 \\\\ 0 & 0 & -4 & 7 \\\\ 0 & 0 & 0 & 2\\end{aligned}] & {R}_{3} & :={R}_{3}+2{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -5 & 0 & 0 \\\\ 0 & 0 & 2 & 0 \\\\ 0 & 0 & 0 & 7 \\\\ 0 & 0 & 0 & 2\\end{aligned}] & {R}_{4} & :={R}_{4}+(-\\frac{2}{7}){R}_{3} \\\\  & ∼[\\begin{aligned}1 & -5 & 0 & 0 \\\\ 0 & 0 & 2 & 0 \\\\ 0 & 0 & 0 & 7 \\\\ 0 & 0 & 0 & 0\\end{aligned}] & \\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $B$ has $3$ pivots. In particular, the pivot columns are the $1$st, $3$rd, and $4$th columns."}] [{:db/id #edb/ref 17592186266017 :knowledge-point/_questions [{:db/id #edb/ref 17592186124477 :knowledge-point/id #uuid "488c9762-554b-5ea6-b414-ce6cbde9bbd1" :knowledge-point/title "Finding the Pivot Columns of a Matrix in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c21634a-9540-5e95-9156-0ffb362dfd3e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3$rd and $4$th only" :db/id #edb/ref 17592186263373} {:answer/id #uuid "5d4f9c44-9e89-54be-bee6-c802eb51f782" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st, $3$rd and $4$th only" :db/id #edb/ref 17592186263809} {:answer/id #uuid "7f53d2fc-0a30-5d97-9817-a001f0b2982e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st and $3$rd only" :db/id #edb/ref 17592186264100} {:answer/id #uuid "a550728b-da46-57dc-9506-deaffd3cd7ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "All the columns are pivot" :db/id #edb/ref 17592186264416} {:answer/id #uuid "ac9b21ce-44ee-5fbe-bb23-f902296418ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st and $4$th only" :db/id #edb/ref 17592186264484}] :answer-field/correct {:answer/id #uuid "5d4f9c44-9e89-54be-bee6-c802eb51f782" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st, $3$rd and $4$th only" :db/id #edb/ref 17592186263809} :answer-field/id #uuid "53ef179b-83c3-5806-93f5-d2919bdeea12" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265395}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6f1401c8-a7df-5366-97e7-46ea675ddf41" :question/math-academy-id "q-130934" :question/problem "The row echelon form matrix $A$ is given below. What are the pivot columns of $A?$\n\n$$\nA=[\\begin{aligned}-1 & 7 & 0 & -4 \\\\ 0 & 0 & -3 & 2 \\\\ 0 & 0 & 0 & 4 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\n$$" :question/worked-solution "Remember that the pivots of a matrix in row echelon form are the first non-zero entries in each row of the matrix.\n\nWe can see that $A$ has $3$ pivots in the $1$st, $3$rd and $4$th columns:\n\n$$\nA=[\\begin{aligned}-1 & 7 & 0 & -4 \\\\ 0 & 0 & -3 & 2 \\\\ 0 & 0 & 0 & 4 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\n$$"}] [{:db/id #edb/ref 17592186400527 :knowledge-point/_questions [{:db/id #edb/ref 17592186124477 :knowledge-point/id #uuid "488c9762-554b-5ea6-b414-ce6cbde9bbd1" :knowledge-point/title "Finding the Pivot Columns of a Matrix in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07e57d00-42e2-52df-952c-42750204443a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st and $4$th only" :db/id #edb/ref 17592186400529} {:answer/id #uuid "a3863802-93b4-5373-bcde-0104355b474b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st, $3$rd, and $4$th only" :db/id #edb/ref 17592186400530} {:answer/id #uuid "9762716d-a441-594e-b7da-17f912c3928a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3$rd and $4$th only" :db/id #edb/ref 17592186400531} {:answer/id #uuid "f7d3708e-c3d0-564b-bd88-f92111f6947e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st, $3$rd, $4$th, and $5$th" :db/id #edb/ref 17592186400532} {:answer/id #uuid "5e65e301-be51-5d5c-a153-d8c519c07444" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "All the columns are pivot" :db/id #edb/ref 17592186400533}] :answer-field/correct {:answer/id #uuid "a3863802-93b4-5373-bcde-0104355b474b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st, $3$rd, and $4$th only" :db/id #edb/ref 17592186400530} :answer-field/id #uuid "ba0fda7f-cbbe-50a6-a823-a14a0b2a64d2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400528}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9ae52a94-ae23-5f16-93c9-2dbde81b5ce4" :question/math-academy-id "q-130935" :question/problem "The row echelon form matrix $M$ is given below. What are the pivot columns of $M?$\n\n$$\nM=[\\begin{aligned}5 & -6 & 8 & 7 & -2 \\\\ 0 & 0 & -2 & 3 & 6 \\\\ 0 & 0 & 0 & 3 & -6 \\\\ 0 & 0 & 0 & 0 & 0\\end{aligned}]\n$$" :question/worked-solution "Remember that the pivots of a matrix in row echelon form are the first non-zero entries in each row of the matrix.\n\nWe can see that $M$ has $3$ pivots in the $1$st, $3$rd, and $4$th columns:\n\n$$\nM=[\\begin{aligned}5 & -6 & 8 & 7 & -2 \\\\ 0 & 0 & -2 & 3 & 6 \\\\ 0 & 0 & 0 & 3 & -6 \\\\ 0 & 0 & 0 & 0 & 0\\end{aligned}]\n$$"}] [{:db/id #edb/ref 17592186266018 :knowledge-point/_questions [{:db/id #edb/ref 17592186124478 :knowledge-point/id #uuid "a5f0d2e9-1cf6-5fe4-85cc-f401382f39b2" :knowledge-point/title "Finding the Non-Pivot Columns of a Matrix in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1348b18e-cd6f-5470-aeb7-1dc2e503b959" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$nd and $3$rd only" :db/id #edb/ref 17592186263182} {:answer/id #uuid "297d61f2-cb88-51f7-9997-9c3505aaf0ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st and $2$nd only" :db/id #edb/ref 17592186263356} {:answer/id #uuid "34f81a52-240d-5419-9297-dc3d4103363f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st only" :db/id #edb/ref 17592186263467} {:answer/id #uuid "bef4cc09-e4db-597f-b29c-001a00b4a13b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$nd only" :db/id #edb/ref 17592186264663} {:answer/id #u