48f-0b61-5bdc-8a2a-e96df88d5c14" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st and $3$rd only" :db/id #edb/ref 17592186393330} {:answer/id #uuid "60f7b35e-f308-5048-828b-42bd129a850a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$nd and $3$rd only" :db/id #edb/ref 17592186393331} {:answer/id #uuid "aa466513-f31a-5498-9b9e-30176cd680cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "All the columns are non-pivot" :db/id #edb/ref 17592186393332} {:answer/id #uuid "00672e34-1cd7-5dbf-a849-6c48ad3fbe88" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$nd only" :db/id #edb/ref 17592186393333}] :answer-field/correct {:answer/id #uuid "bf036a0d-5682-596f-8f07-3199b4d776a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3$rd only" :db/id #edb/ref 17592186393329} :answer-field/id #uuid "026b9f0e-b07b-577d-b82e-aa9c9be6839b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393328}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "882ebb4d-35c9-5b5b-8139-3566e490f853" :question/math-academy-id "q-73616" :question/problem "The row echelon form matrix $P$ is given below. What are its **non**-pivot columns?\n\n$$\nP=[\\begin{aligned}-3 & 1 & -1 \\\\ 0 & 1 & 6 \\\\ 0 & 0 & 0\\end{aligned}]\n$$" :question/worked-solution "Remember that the pivots of a matrix in row echelon form are the first non-zero entries in each row of the matrix.\n\nWe can see that $P$ has $2$ pivots in the $1$st and $2$nd columns:\n\n$$\nP=[\\begin{aligned}-3 & 1 & -1 \\\\ 0 & 1 & 6 \\\\ 0 & 0 & 0\\end{aligned}]\n$$\n\nTherefore, the only non-pivot column is the $3$rd column."}] [{:db/id #edb/ref 17592186364337 :knowledge-point/_questions [{:db/id #edb/ref 17592186124478 :knowledge-point/id #uuid "a5f0d2e9-1cf6-5fe4-85cc-f401382f39b2" :knowledge-point/title "Finding the Non-Pivot Columns of a Matrix in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a0e1a0cc-91dc-5a46-868c-d70694f51867" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3$rd only" :db/id #edb/ref 17592186364339} {:answer/id #uuid "43dd0549-9a80-53c7-af32-77969aa8b405" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$nd and $3$rd only" :db/id #edb/ref 17592186364340} {:answer/id #uuid "40c26875-f06f-5f7e-b9a8-1f2706d334ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4$th only" :db/id #edb/ref 17592186364341} {:answer/id #uuid "7f0ec1e7-f618-501b-acbc-ecdc42e02019" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3$rd and $4$th only" :db/id #edb/ref 17592186364342} {:answer/id #uuid "25fe51d6-e28b-5ed0-bcf2-dd90e575257c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$nd only" :db/id #edb/ref 17592186364343}] :answer-field/correct {:answer/id #uuid "a0e1a0cc-91dc-5a46-868c-d70694f51867" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3$rd only" :db/id #edb/ref 17592186364339} :answer-field/id #uuid "647a5b89-bbff-5f16-9a48-f62220537bf9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186364338}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5149a8bf-4216-5b0c-825e-8103ee48f823" :question/math-academy-id "q-73621" :question/problem "The row echelon form matrix $R$ is given below. What are its **non**-pivot columns?\n\n$$\nR=[\\begin{aligned}1 & -1 & 2 & 0 \\\\ 0 & -4 & 3 & 1 \\\\ 0 & 0 & 0 & 7 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\n$$" :question/worked-solution "Remember that the pivots of a matrix in row echelon form are the first non-zero entries in each row of the matrix.\n\nWe can see that $R$ has $3$ pivots in the $1$st, $2$nd and $4$th columns:\n\n$$\nR=[\\begin{aligned}1 & -1 & 2 & 0 \\\\ 0 & -4 & 3 & 1 \\\\ 0 & 0 & 0 & 7 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\n$$\n\nTherefore, the only non-pivot column is the $3$rd columns."}] [{:db/id #edb/ref 17592186342043 :knowledge-point/_questions [{:db/id #edb/ref 17592186124479 :knowledge-point/id #uuid "1073953e-7e0a-5237-8533-8882b7772741" :knowledge-point/title "Finding the Number of Pivot Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "470abe29-2542-5865-96c9-702c10206992" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186339757} {:answer/id #uuid "600d14b0-e227-5cd2-baf1-b373cb377c46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186339984} {:answer/id #uuid "7975c256-a582-594f-915f-ca709cab8f6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186340211} {:answer/id #uuid "c7ff069b-8d25-52fc-bb50-e97180724410" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186340899} {:answer/id #uuid "cc96cd99-7932-5285-85c2-b574ef3ae1a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186340939}] :answer-field/correct {:answer/id #uuid "600d14b0-e227-5cd2-baf1-b373cb377c46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186339984} :answer-field/id #uuid "8dfe9dc9-fee0-5440-81d7-9f98049c1f83" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341631}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7ddee6b4-1b01-50b9-84af-b697c22f2675" :question/math-academy-id "q-73633" :question/problem "Determine the number of pivot columns of the matrix $P,$ given by\n\n$$\nP=[\\begin{aligned}0 & 3 & 2 & -1 & 0 \\\\ 0 & 0 & 6 & 1 & 3 \\\\ 0 & -6 & -4 & 9 & 1 \\\\ 0 & 0 & 0 & 0 & 0\\end{aligned}].\n$$" :question/worked-solution "First, we need to convert $P$ to row echelon form:\n\n$$\n\\begin{aligned}P & =[\\begin{aligned}0 & 3 & 2 & -1 & 0 \\\\ 0 & 0 & 6 & 1 & 3 \\\\ 0 & -6 & -4 & 9 & 1 \\\\ 0 & 0 & 0 & 0 & 0\\end{aligned}] & {R}_{3} & :={R}_{3}+2{R}_{1} \\\\  & ∼[\\begin{aligned}0 & 3 & 2 & -1 & 0 \\\\ 0 & 0 & 6 & 1 & 3 \\\\ 0 & 0 & 0 & 7 & 1 \\\\ 0 & 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $P$ has $3$ pivots, and therefore the number of pivot columns is $3.$"}] [{:db/id #edb/ref 17592186342045 :knowledge-point/_questions [{:db/id #edb/ref 17592186124480 :knowledge-point/id #uuid "b1a557d6-52f3-5df3-8088-5b875296e72e" :knowledge-point/title "Finding the Pivot Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c1ee36a-4db5-53af-aad2-6e0f7d75bf06" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st, $3$rd only" :db/id #edb/ref 17592186339233} {:answer/id #uuid "31c1489a-e505-5968-a0fe-1c13d9448994" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3$rd only" :db/id #edb/ref 17592186339565} {:answer/id #uuid "8af06da7-434a-5cf5-a301-e37cb45b27db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$nd, and $4$th only" :db/id #edb/ref 17592186340371} {:answer/id #uuid "a5c4ebf5-c3f7-51fd-acf7-a9712d8515e6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st, $2$nd, and $3$rd only" :db/id #edb/ref 17592186340632} {:answer/id #uuid "a6d8599e-872a-5853-ab9c-14124febdd25" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st, $2$nd, $3$rd and $4$th" :db/id #edb/ref 17592186340642}] :answer-field/correct {:answer/id #uuid "a5c4ebf5-c3f7-51fd-acf7-a9712d8515e6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st, $2$nd, and $3$rd only" :db/id #edb/ref 17592186340632} :answer-field/id #uuid "72bd5908-df4a-5071-9c06-4a211c439573" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341580}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e012b726-5b5c-59b3-9af4-421c826c1005" :question/math-academy-id "q-73636" :question/problem "What are the pivot columns of the matrix $B,$ given by\n\n$$\nB=[\\begin{aligned}1 & 3 & 0 & -1 \\\\ 0 & 0 & 6 & 0 \\\\ 0 & 1 & 3 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}]?\n$$" :question/worked-solution "First, we need to convert $B$ to row echelon form:\n\n$$\n\\begin{aligned}B & =[\\begin{aligned}1 & 3 & 0 & -1 \\\\ 0 & 0 & 6 & 0 \\\\ 0 & 1 & 3 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}] & {R}_{2} & ↔{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 3 & 0 & -1 \\\\ 0 & 1 & 3 & 0 \\\\ 0 & 0 & 6 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $B$ has $3$ pivots. In particular, the pivot columns are the $1$st, $2$nd, and $3$rd columns."}] [{:db/id #edb/ref 17592186403682 :knowledge-point/_questions [{:db/id #edb/ref 17592186124480 :knowledge-point/id #uuid "b1a557d6-52f3-5df3-8088-5b875296e72e" :knowledge-point/title "Finding the Pivot Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "62c7b061-ae07-587c-bab0-15049cf99b56" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st and $4$th only" :db/id #edb/ref 17592186403684} {:answer/id #uuid "bc30072d-7cf1-5da5-97b9-253a92f7877b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$nd and $3$rd only" :db/id #edb/ref 17592186403685} {:answer/id #uuid "508efe11-c663-52c3-84b8-ac714fe99937" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st, $3$rd, and $4$th only" :db/id #edb/ref 17592186403686} {:answer/id #uuid "8054e257-e2ab-5aa6-b464-152bde3bafb3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st, $2$nd, $3$rd, and $4$th only" :db/id #edb/ref 17592186403687} {:answer/id #uuid "56527d12-3319-58cd-8ff8-f8efdf4d8acf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st, $2$nd, and $4$th only" :db/id #edb/ref 17592186403688}] :answer-field/correct {:answer/id #uuid "8054e257-e2ab-5aa6-b464-152bde3bafb3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st, $2$nd, $3$rd, and $4$th only" :db/id #edb/ref 17592186403687} :answer-field/id #uuid "6197e392-74ff-5689-be7c-741e44610b04" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403683}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8bbb774c-4bbb-58f8-84cb-fd20b0029b02" :question/math-academy-id "q-73638" :question/problem "What are the pivot columns of the matrix $P,$ given by\n\n$$\nP=[\\begin{aligned}-3 & 2 & 1 & 0 & 4 \\\\ 0 & 0 & 0 & 1 & 0 \\\\ 0 & -4 & 5 & -1 & 0 \\\\ 0 & 0 & 4 & 0 & 2\\end{aligned}]?\n$$" :question/worked-solution "First, we need to convert $P$ to row echelon form:\n\n$$\n\\begin{aligned}P & =[\\begin{aligned}-3 & 2 & 1 & 0 & 4 \\\\ 0 & 0 & 0 & 1 & 0 \\\\ 0 & -4 & 5 & -1 & 0 \\\\ 0 & 0 & 4 & 0 & 2\\end{aligned}] & {R}_{2} & ↔{R}_{3} \\\\  & ∼[\\begin{aligned}-3 & 2 & 1 & 0 & 4 \\\\ 0 & -4 & 5 & -1 & 0 \\\\ 0 & 0 & 0 & 1 & 0 \\\\ 0 & 0 & 4 & 0 & 2\\end{aligned}] & {R}_{3} & ↔{R}_{4} \\\\  & ∼[\\begin{aligned}-3 & 2 & 1 & 0 & 4 \\\\ 0 & -4 & 5 & -1 & 0 \\\\ 0 & 0 & 4 & 0 & 2 \\\\ 0 & 0 & 0 & 1 & 0\\end{aligned}]\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $P$ has $4$ pivots. In particular, the pivot columns are the $1$st, $2$nd, $3$rd, and $4$th columns."}]}
