#{[{:activity/first-step {:db/id #edb/ref 17592186125332} :activity/id #uuid "987e1e0c-bea1-5c9c-84ad-c50c09fe4abb" :activity/scope {:db/id #edb/ref 17592186049723 :topic/id #uuid "0e15397e-6c32-508c-b6ea-90f1a9e5a237" :topic/math-academy-id 1904} :activity/steps [{:db/id #edb/ref 17592186125332 :step/content {:db/id #edb/ref 17592186125757 :tutorial/content "The **pivots** of a matrix in row echelon form are the first non-zero entries in each row of the matrix.\n\nFor example, given the matrix \n\n$$\n[\\begin{aligned}1 & 0 & -2 & 0 \\\\ 0 & 1 & 5 & 0 \\\\ 0 & 0 & 0 & 1\\end{aligned}]\n$$\n\nwhich is in row echelon form, let's find the pivots of $A.$\n\n- The first non-zero entry in the first row is the entry $a_{11}=1.$ So this is a pivot.\n\n- The first non-zero entry of the second row is $a_{22}=1.$ So this is also a pivot.\n\n- The first non-zero entry in the third row is $a_{34}=1.$ Therefore this is a pivot.\n\nThe pivots of $A$ are highlighted below.\n\n$$\n[\\begin{aligned}1 & 0 & -2 & 0 \\\\ 0 & 1 & 5 & 0 \\\\ 0 & 0 & 0 & 1\\end{aligned}]\n$$\n\nThe **pivot columns** of a matrix in row echelon form are simply the columns in which the pivots appear.\n\nFor our matrix $A$, we can see that the pivot columns are the $1$st, $2$nd, and $4$th columns.\n\nThe non-pivot columns are the columns that do not contain a pivot. So for the matrix $A,$ the only non-pivot column is the $3$rd column." :tutorial/id #uuid "feec6418-f447-5ee0-8c62-7d6b690f9228" :tutorial/math-academy-id 3157 :tutorial/title "Introduction"} :step/id #uuid "a9d24104-f86a-5d95-8475-56e2dbec3b1c" :step/math-academy-id 17200 :step/next {:db/id #edb/ref 17592186125333}} {:db/id #edb/ref 17592186125333 :step/content {:db/id #edb/ref 17592186124477 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124290 :question/id #uuid "ccfdc303-534f-530e-810b-f475a997f5d8" :question/math-academy-id "e-4703"} :knowledge-point/id #uuid "488c9762-554b-5ea6-b414-ce6cbde9bbd1" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048980}] :knowledge-point/questions [{:db/id #edb/ref 17592186124903} {:db/id #edb/ref 17592186124909} {:db/id #edb/ref 17592186266016} {:db/id #edb/ref 17592186266017} {:db/id #edb/ref 17592186342028} {:db/id #edb/ref 17592186342030} {:db/id #edb/ref 17592186342031} {:db/id #edb/ref 17592186400520} {:db/id #edb/ref 17592186400527} {:db/id #edb/ref 17592186400534} {:db/id #edb/ref 17592186403661}] :knowledge-point/title "Finding the Pivot Columns of a Matrix in Row Echelon Form"} :step/id #uuid "791285ec-5594-542a-8408-63f1e171f030" :step/math-academy-id 17201 :step/next {:db/id #edb/ref 17592186125334}} {:db/id #edb/ref 17592186125334 :step/content {:db/id #edb/ref 17592186124478 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124291 :question/id #uuid "22a77802-4114-516f-a0e0-4cda2e069361" :question/math-academy-id "e-4704"} :knowledge-point/id #uuid "a5f0d2e9-1cf6-5fe4-85cc-f401382f39b2" :knowledge-point/questions [{:db/id #edb/ref 17592186124880} {:db/id #edb/ref 17592186124904} {:db/id #edb/ref 17592186266018} {:db/id #edb/ref 17592186266019} {:db/id #edb/ref 17592186266020} {:db/id #edb/ref 17592186266021} {:db/id #edb/ref 17592186342032} {:db/id #edb/ref 17592186342033} {:db/id #edb/ref 17592186342035} {:db/id #edb/ref 17592186364337} {:db/id #edb/ref 17592186393327} {:db/id #edb/ref 17592186400541} {:db/id #edb/ref 17592186400548} {:db/id #edb/ref 17592186403668} {:db/id #edb/ref 17592186410771}] :knowledge-point/title "Finding the Non-Pivot Columns of a Matrix in Row Echelon Form"} :step/id #uuid "a8ae7cc9-0379-5556-914f-78c73a269672" :step/math-academy-id 17202 :step/next {:db/id #edb/ref 17592186125335}} {:db/id #edb/ref 17592186125335 :step/content {:db/id #edb/ref 17592186125758 :tutorial/content "To find the pivots and pivot columns of a general matrix, we first need to convert the matrix to row echelon form (REF).\n\n- The pivots of any matrix are the pivots of its row equivalent REF matrix.\n\n- The pivot columns of a matrix are the pivot columns of its row equivalent REF matrix.\n\nTo reduce a general $n\\times m$ matrix to row echelon form, we follow a similar procedure to the $2\\times 2$ and $3\\times 3$ cases, as we'll see in the next example." :tutorial/id #uuid "d45a4eba-96ce-5bef-92b7-b8f0d4cd8b72" :tutorial/math-academy-id 3158 :tutorial/title "Pivot Columns of a General Matrix"} :step/id #uuid "c86295bd-d79e-5f83-97d7-9a828e1b01e3" :step/math-academy-id 17203 :step/next {:db/id #edb/ref 17592186125336}} {:db/id #edb/ref 17592186125336 :step/content {:db/id #edb/ref 17592186124479 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124292 :question/id #uuid "6e4b2e85-86a8-5050-a60a-ae8d40453ad0" :question/math-academy-id "e-4705"} :knowledge-point/id #uuid "1073953e-7e0a-5237-8533-8882b7772741" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049120}] :knowledge-point/questions [{:db/id #edb/ref 17592186124884} {:db/id #edb/ref 17592186124885} {:db/id #edb/ref 17592186266022} {:db/id #edb/ref 17592186266023} {:db/id #edb/ref 17592186266024} {:db/id #edb/ref 17592186266025} {:db/id #edb/ref 17592186266026} {:db/id #edb/ref 17592186323676} {:db/id #edb/ref 17592186323677} {:db/id #edb/ref 17592186342037} {:db/id #edb/ref 17592186342040} {:db/id #edb/ref 17592186342041} {:db/id #edb/ref 17592186342043} {:db/id #edb/ref 17592186342044} {:db/id #edb/ref 17592186367331} {:db/id #edb/ref 17592186368482}] :knowledge-point/title "Finding the Number of Pivot Columns of a Matrix"} :step/id #uuid "3bd0dda5-f697-5c86-9873-bdf79b5a2e7e" :step/math-academy-id 17204 :step/next {:db/id #edb/ref 17592186125337}} {:db/id #edb/ref 17592186125337 :step/content {:db/id #edb/ref 17592186124480 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124293 :question/id #uuid "3ac076bd-5add-5c08-bb96-7b11c0a37d54" :question/math-academy-id "e-4706"} :knowledge-point/id #uuid "b1a557d6-52f3-5df3-8088-5b875296e72e" :knowledge-point/questions [{:db/id #edb/ref 17592186124905} {:db/id #edb/ref 17592186124906} {:db/id #edb/ref 17592186266069} {:db/id #edb/ref 17592186266070} {:db/id #edb/ref 17592186266071} {:db/id #edb/ref 17592186266072} {:db/id #edb/ref 17592186323715} {:db/id #edb/ref 17592186342045} {:db/id #edb/ref 17592186342046} {:db/id #edb/ref 17592186367373} {:db/id #edb/ref 17592186400590} {:db/id #edb/ref 17592186402448} {:db/id #edb/ref 17592186402461} {:db/id #edb/ref 17592186403682}] :knowledge-point/title "Finding the Pivot Columns of a Matrix"} :step/id #uuid "097f2290-0ddc-5eda-9104-3480eee4084e" :step/math-academy-id 17205}] :activity/title "Identifying the Pivot Columns of a Matrix" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186124704}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186410776} :activity/id #uuid "620653fd-8e7d-5de8-beb7-37d1715ab5f2" :activity/scope {:db/id #edb/ref 17592186049723 :topic/id #uuid "0e15397e-6c32-508c-b6ea-90f1a9e5a237" :topic/math-academy-id 1904} :activity/steps [{:db/id #edb/ref 17592186410772 :step/content {:db/id #edb/ref 17592186402461 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9e2cc6e3-e6bd-532d-8f1f-9b390c501b74" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$1$st and $2$nd only" :db/id #edb/ref 17592186402463} {:answer/id #uuid "6fdb0769-e31b-5103-99f8-7c1edc831761" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$3$rd only" :db/id #edb/ref 17592186402464} {:answer/id #uuid "a11b1eb4-e2a7-524e-a084-458df3eaa259" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$2$nd and $3$rd only" :db/id #edb/ref 17592186402465} {:answer/id #uuid "fc893d60-072c-5dca-bf01-c98cdfe541a2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$3$rd and $4$th only" :db/id #edb/ref 17592186402466} {:answer/id #uuid "697bc745-dc44-59f7-92ec-a23865a1d921" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$1$st, $2$nd, and $4$th only" :db/id #edb/ref 17592186402467}] :answer-field/correct {:db/id #edb/ref 17592186402467} :answer-field/id #uuid "b29827dc-7c2e-5a8a-9cf8-9120c56fe561" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186402462}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7d0368b2-c48d-55b9-a038-5636deca9c98" :question/math-academy-id "q-35757" :question/problem "What are the pivot columns of the matrix $A,$ given by\n\n$$\nA=[\\begin{aligned}1 & 2 & 5 & 7 \\\\ 0 & 0 & 0 & 3 \\\\ 0 & 2 & 4 & 6 \\\\ 0 & 0 & 0 & 0\\end{aligned}]?\n$$" :question/worked-solution "First, we need to convert $A$ to row echelon form:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1 & 2 & 5 & 7 \\\\ 0 & 0 & 0 & 3 \\\\ 0 & 2 & 4 & 6 \\\\ 0 & 0 & 0 & 0\\end{aligned}] & {R}_{2} & ↔{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 2 & 5 & 7 \\\\ 0 & 2 & 4 & 6 \\\\ 0 & 0 & 0 & 3 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $A$ has $3$ pivots. In particular, the pivot columns are the $1$st, $2$nd, and $4$th columns."} :step/id #uuid "30f26997-9e49-5db0-9f88-9376de7a0b7c" :step/next {:db/id #edb/ref 17592186410775}} {:db/id #edb/ref 17592186410773 :step/content {:db/id #edb/ref 17592186410771 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d3d7552-73fd-5a30-adca-213fce95daf3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$1$st and $3$rd only" :db/id #edb/ref 17592186410765} {:answer/id #uuid "2c231bf1-1c62-5bb0-a5af-80fd235dc05d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$1$st only" :db/id #edb/ref 17592186410766} {:answer/id #uuid "88eecdfd-f245-5138-93d4-a347d38063c5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$3$rd only" :db/id #edb/ref 17592186410767} {:answer/id #uuid "a582f1d6-9082-5ca9-8a15-8892198e09a8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$1$st and $2$nd only" :db/id #edb/ref 17592186410768} {:answer/id #uuid "ab2f5437-3869-5765-88a5-9a58e75de19b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$2$nd, $4$th, and $5$th only" :db/id #edb/ref 17592186410769}] :answer-field/correct {:db/id #edb/ref 17592186410765} :answer-field/id #uuid "0ec2a6fc-f001-5e94-83d4-c400fba8593b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186410770}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "bcd1cb26-1c44-5d74-aa8e-2093ab435f98" :question/math-academy-id "q-130950" :question/problem "The row echelon form matrix $A$ is given below. What are its **non**-pivot columns?\n\n$$\nA=[\\begin{aligned}0 & -4 & 3 & -3 & 5 \\\\ 0 & 0 & 0 & 2 & -6 \\\\ 0 & 0 & 0 & 0 & -3\\end{aligned}]\n$$" :question/worked-solution "Remember that the pivots of a matrix in row echelon form are the first non-zero entries in each row of the matrix.\n\nWe can see that $A$ has $3$ pivots in the $2$nd, $4$th and $5$th columns:\n\n$$\nA=[\\begin{aligned}0 & -4 & 3 & -3 & 5 \\\\ 0 & 0 & 0 & 2 & -6 \\\\ 0 & 0 & 0 & 0 & -3\\end{aligned}]\n$$\n\nTherefore, the only non-pivot columns are the $1$st and $3$rd columns."} :step/id #uuid "4d58ea96-3315-5ccd-a989-6430f4d9b8fb"} {:db/id #edb/ref 17592186410774 :step/content {:db/id #edb/ref 17592186124905 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d902d5f9-286f-59ed-ad2f-a940f9d64e13" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$1$st and $3$rd only" :db/id #edb/ref 17592186402456} {:answer/id #uuid "59e21a65-e54b-529e-af01-45eee909fed5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$4$th only" :db/id #edb/ref 17592186402457} {:answer/id #uuid "9e3a2e7f-88af-59d2-b10b-0f6888607047" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$3$rd and $4$th only" :db/id #edb/ref 17592186402458} {:answer/id #uuid "5c862c29-b1f0-5ae3-9332-7d1761b0bb60" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$1$st, $2$nd, and $4$th only" :db/id #edb/ref 17592186402459} {:answer/id #uuid "56592c5b-5ea8-5015-81bc-3667c1634320" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$1$st, $2$nd, $3$rd, and $4$th" :db/id #edb/ref 17592186402460}] :answer-field/correct {:db/id #edb/ref 17592186402459} :answer-field/id #uuid "b7425100-9aef-51c1-8d0e-fb3c989d9fa0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186402455}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c93d2ae4-7e7b-5500-9b27-fd939892ffa9" :question/math-academy-id "q-35732" :question/problem "What are the pivot columns of the matrix $A,$ given by\n\n$$\nA=[\\begin{aligned}0 & 0 & 0 & 0 \\\\ 0 & 4 & 8 & -6 \\\\ 0 & -2 & -4 & 1 \\\\ 1 & 4 & 0 & 2\\end{aligned}]?\n$$" :question/worked-solution "First, we need to convert $A$ to row echelon form:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}0 & 0 & 0 & 0 \\\\ 0 & 4 & 8 & -6 \\\\ 0 & -2 & -4 & 1 \\\\ 1 & 4 & 0 & 2\\end{aligned}] & {R}_{1} & ↔{R}_{4} \\\\  & ∼[\\begin{aligned}1 & 4 & 0 & 2 \\\\ 0 & 4 & 8 & -6 \\\\ 0 & -2 & -4 & 1 \\\\ 0 & 0 & 0 & 0\\end{aligned}] & {R}_{3} & :={R}_{3}+\\frac{1}{2}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 4 & 0 & 2 \\\\ 0 & 4 & 8 & -6 \\\\ 0 & 0 & 0 & -2 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $A$ has $3$ pivots. In particular, the pivot columns are the $1$st, $2$nd, and $4$th columns."} :step/id #uuid "9f3fb4e7-d2df-5336-aacb-83aad5e72280" :step/next {:db/id #edb/ref 17592186410772}} {:db/id #edb/ref 17592186410775 :step/content {:db/id #edb/ref 17592186342043 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "470abe29-2542-5865-96c9-702c10206992" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186339757} {:answer/id #uuid "600d14b0-e227-5cd2-baf1-b373cb377c46" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186339984} {:answer/id #uuid "7975c256-a582-594f-915f-ca709cab8f6a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186340211} {:answer/id #uuid "c7ff069b-8d25-52fc-bb50-e97180724410" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186340899} {:answer/id #uuid "cc96cd99-7932-5285-85c2-b574ef3ae1a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186340939}] :answer-field/correct {:db/id #edb/ref 17592186339984} :answer-field/id #uuid "8dfe9dc9-fee0-5440-81d7-9f98049c1f83" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341631}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7ddee6b4-1b01-50b9-84af-b697c22f2675" :question/math-academy-id "q-73633" :question/problem "Determine the number of pivot columns of the matrix $P,$ given by\n\n$$\nP=[\\begin{aligned}0 & 3 & 2 & -1 & 0 \\\\ 0 & 0 & 6 & 1 & 3 \\\\ 0 & -6 & -4 & 9 & 1 \\\\ 0 & 0 & 0 & 0 & 0\\end{aligned}].\n$$" :question/worked-solution "First, we need to convert $P$ to row echelon form:\n\n$$\n\\begin{aligned}P & =[\\begin{aligned}0 & 3 & 2 & -1 & 0 \\\\ 0 & 0 & 6 & 1 & 3 \\\\ 0 & -6 & -4 & 9 & 1 \\\\ 0 & 0 & 0 & 0 & 0\\end{aligned}] & {R}_{3} & :={R}_{3}+2{R}_{1} \\\\  & ∼[\\begin{aligned}0 & 3 & 2 & -1 & 0 \\\\ 0 & 0 & 6 & 1 & 3 \\\\ 0 & 0 & 0 & 7 & 1 \\\\ 0 & 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $P$ has $3$ pivots, and therefore the number of pivot columns is $3.$"} :step/id #uuid "acf78879-b468-5dc7-b376-c889a5d49184" :step/next {:db/id #edb/ref 17592186410773}} {:db/id #edb/ref 17592186410776 :step/content {:db/id #edb/ref 17592186323677 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f6819e4-8455-5b92-950f-ef80d03e3a6f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186321384} {:answer/id #uuid "22d20878-4616-551d-9c51-c3ab339f7c02" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186321411} {:answer/id #uuid "3c1f36d6-2f31-5193-baa9-352cb4ec2d30" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186321613} {:answer/id #uuid "e42fdf84-b6d0-5da0-bf66-8b251052d501" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186322934} {:answer/id #uuid "e52ea9bd-c2ff-5f62-8bce-c9950d05029d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186322941}] :answer-field/correct {:db/id #edb/ref 17592186321411} :answer-field/id #uuid "0d8d06a1-5f1a-5dd9-a91d-202d54fedda4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186323192}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9f943d34-2384-5dae-913e-74d32b4a024f" :question/math-academy-id "q-35453" :question/problem "Determine the number of pivot columns of the matrix $B,$ given by\n\n$$\nB=[\\begin{aligned}-2 & 0 & 0 & 0 & 0 \\\\ 0 & 1 & 4 & -2 & 0 \\\\ 0 & -3 & -6 & 4 & 2 \\\\ 0 & 0 & -3 & 1 & -1\\end{aligned}].\n$$" :question/worked-solution "First, we need to convert $B$ to row echelon form:\n\n$$\n\\begin{aligned}B & =[\\begin{aligned}-2 & 0 & 0 & 0 & 0 \\\\ 0 & 1 & 4 & -2 & 0 \\\\ 0 & -3 & -6 & 4 & 2 \\\\ 0 & 0 & -3 & 1 & -1\\end{aligned}] & {R}_{3} & :={R}_{3}+3{R}_{2} \\\\  & ∼[\\begin{aligned}-2 & 0 & 0 & 0 & 0 \\\\ 0 & 1 & 4 & -2 & 0 \\\\ 0 & 0 & 6 & -2 & 2 \\\\ 0 & 0 & -3 & 1 & -1\\end{aligned}] & {R}_{4} & :={R}_{4}+\\frac{1}{2}{R}_{3} \\\\  & ∼[\\begin{aligned}-2 & 0 & 0 & 0 & 0 \\\\ 0 & 1 & 4 & -2 & 0 \\\\ 0 & 0 & 6 & -2 & 2 \\\\ 0 & 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $B$ has $3$ pivots, and therefore the number of pivot columns is $3.$"} :step/id #uuid "c53be52e-3dd0-549d-8ced-3218bf1d3d25" :step/next {:db/id #edb/ref 17592186410774}}] :activity/title "Identifying the Pivot Columns of a Matrix" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186410764}]}
