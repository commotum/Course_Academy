db/ref 17592186432627} {:answer/id #uuid "d4ad4e57-242d-51ac-a7fd-f2d398f4f608" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "44\\sqrt{\\pi }" :db/id #edb/ref 17592186432658} {:answer/id #uuid "f73b55d4-d73e-56f0-92d3-70dea098ffb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "46!" :db/id #edb/ref 17592186432668}] :answer-field/correct {:answer/id #uuid "713dac32-c8df-56dd-8214-cb5f985996e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "44!" :db/id #edb/ref 17592186432627} :answer-field/id #uuid "5dde0b6a-8c50-57b3-b88b-967c5e454bc9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186432676}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8f3249d6-edac-5050-9528-d13b2bdbb793" :question/math-academy-id "q-107853" :question/problem "$Γ(45)=$" :question/worked-solution "For any natural number $n\\ge 1,$ we have\n\n$$\nΓ(n)=(n-1)!\n$$\n\nTherefore, \n\n$$\nΓ(45)=44!\n$$"}] [{:db/id #edb/ref 17592186432692 :knowledge-point/_questions [{:db/id #edb/ref 17592186172065 :knowledge-point/id #uuid "4c8de43f-dc61-5bbe-8b84-b8aa0be19146" :knowledge-point/title "Evaluating the Gamma Function at a Multiple of One-Half"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "179d6519-3f5e-5e5c-931a-bef96f2e6027" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\pi " :db/id #edb/ref 17592186432604} {:answer/id #uuid "823c273b-b579-5de8-8c66-72b5bee2d5a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\pi " :db/id #edb/ref 17592186432631} {:answer/id #uuid "8245d4e4-4d9b-5e0f-9138-dddbd9735459" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\pi \\sqrt{2}" :db/id #edb/ref 17592186432632} {:answer/id #uuid "bca03f9f-8e84-56ca-8ab2-759eaf4b56d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi " :db/id #edb/ref 17592186432651} {:answer/id #uuid "da7d5a9a-ce82-5886-ae3c-0b43836c92d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\pi \\sqrt{2}" :db/id #edb/ref 17592186432661}] :answer-field/correct {:answer/id #uuid "179d6519-3f5e-5e5c-931a-bef96f2e6027" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\pi " :db/id #edb/ref 17592186432604} :answer-field/id #uuid "ecdcf851-bd5a-52f8-bfcc-45e6d82c2328" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186432685}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6bbc8ec2-1cd6-5115-ab81-c2fbacd13746" :question/math-academy-id "q-107855" :question/problem "Evaluate $4\\sqrt{\\pi }\\,Γ(\\frac{5}{2}).$" :question/worked-solution "To evaluate the gamma function at multiples of one-half, we use the following recursive formula:\n\n$$\nΓ(z+1)=zΓ(z),\\,Γ(\\frac{1}{2})=\\sqrt{\\pi }\n$$\n\nSo, we have the following:\n\n$$\n\\begin{aligned}Γ(\\frac{5}{2}) & =\\frac{3}{2}Γ(\\frac{3}{2}) \\\\  & =\\frac{3}{2}\\cdot \\frac{1}{2}\\cdot Γ(\\frac{1}{2}) \\\\  & =\\frac{3\\sqrt{\\pi }}{4}\\end{aligned}\n$$\n\n$$\n4\\sqrt{\\pi }\\,Γ(\\frac{5}{2})=4\\sqrt{\\pi }\\cdot \\frac{3}{4}\\sqrt{\\pi }=3\\pi .\n$$"}] [{:db/id #edb/ref 17592186432695 :knowledge-point/_questions [{:db/id #edb/ref 17592186172065 :knowledge-point/id #uuid "4c8de43f-dc61-5bbe-8b84-b8aa0be19146" :knowledge-point/title "Evaluating the Gamma Function at a Multiple of One-Half"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "272b993d-cfcd-5fbc-8438-b2fc2453c336" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14\\sqrt{\\pi }" :db/id #edb/ref 17592186432607} {:answer/id #uuid "5c4d0a3c-d3e6-501a-ae95-afa45890cb45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\pi " :db/id #edb/ref 17592186432620} {:answer/id #uuid "87e9f7a5-e27e-53c0-8cae-d05da59ced47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16\\sqrt{\\pi }" :db/id #edb/ref 17592186432635} {:answer/id #uuid "fc7aaba3-9d2b-5078-921a-a7a5e7d7f864" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\pi " :db/id #edb/ref 17592186432670} {:answer/id #uuid "fdf35405-2f8a-5450-8095-15a55e5e6172" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186432672}] :answer-field/correct {:answer/id #uuid "fc7aaba3-9d2b-5078-921a-a7a5e7d7f864" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\pi " :db/id #edb/ref 17592186432670} :answer-field/id #uuid "2e8f9836-3d65-5692-9b53-efc548319f0d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186432675}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bd01511b-f45a-5cd4-b173-d099f3266062" :question/math-academy-id "q-107860" :question/problem "Evaluate $\\frac{16\\sqrt{\\pi }}{15}\\,Γ(\\frac{9}{2}).$" :question/worked-solution "To evaluate the gamma function at multiples of one-half, we use the following recursive formula:\n\n$$\nΓ(z+1)=zΓ(z),\\,Γ(\\frac{1}{2})=\\sqrt{\\pi }\n$$\n\nSo, we have the following:\n\n$$\n\\begin{aligned}\\frac{16\\sqrt{\\pi }}{15}\\,Γ(\\frac{9}{2}) & =\\frac{16\\sqrt{\\pi }}{15}\\cdot \\frac{7}{2}\\cdot Γ(\\frac{7}{2}) \\\\  & =\\frac{16\\sqrt{\\pi }}{15}\\cdot \\frac{7}{2}\\cdot \\frac{5}{2}Γ(\\frac{5}{2}) \\\\  & =\\frac{16\\sqrt{\\pi }}{15}\\cdot \\frac{7}{2}\\cdot \\frac{5}{2}\\cdot \\frac{3}{2}Γ(\\frac{3}{2}) \\\\  & =\\frac{16\\sqrt{\\pi }}{15}\\cdot \\frac{7}{2}\\cdot \\frac{5}{2}\\cdot \\frac{3}{2}\\cdot \\frac{1}{2}Γ(\\frac{1}{2}) \\\\  & =\\frac{16\\sqrt{\\pi }}{15}\\cdot \\frac{7}{2}\\cdot \\frac{5}{2}\\cdot \\frac{3}{2}\\cdot \\frac{1}{2}\\sqrt{\\pi } \\\\  & =7\\pi \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186432687 :knowledge-point/_questions [{:db/id #edb/ref 17592186172065 :knowledge-point/id #uuid "4c8de43f-dc61-5bbe-8b84-b8aa0be19146" :knowledge-point/title "Evaluating the Gamma Function at a Multiple of One-Half"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "067a2195-d3de-5acc-b220-c39097febda2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\sqrt{\\pi }" :db/id #edb/ref 17592186432598} {:answer/id #uuid "45dd61c6-4646-5510-9b63-d54bc159f05b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\sqrt{\\pi }" :db/id #edb/ref 17592186432614} {:answer/id #uuid "b2a0e4e4-dd3b-55bc-a9fb-699bdd60de42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{\\pi }" :db/id #edb/ref 17592186432645} {:answer/id #uuid "d65e1e14-1f3f-5358-bf26-7ba446ad986d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{2}\\sqrt{\\pi }" :db/id #edb/ref 17592186432659} {:answer/id #uuid "d776aef3-e85d-5ab3-8ee3-9c9b560c8c22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}\\sqrt{\\pi }" :db/id #edb/ref 17592186432660}] :answer-field/correct {:answer/id #uuid "b2a0e4e4-dd3b-55bc-a9fb-699bdd60de42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{\\pi }" :db/id #edb/ref 17592186432645} :answer-field/id #uuid "bb60e818-0b8f-5548-8ae0-4c03ecdde68e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186432682}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0fdfcf02-67ae-5263-baa1-a6ba5d9b1b6d" :question/math-academy-id "q-107862" :question/problem "$Γ(\\frac{1}{2})+4\\,Γ(\\frac{5}{2})=$" :question/worked-solution "To evaluate the gamma function at multiples of one-half, we use the following recursive formula:\n\n$$\nΓ(z+1)=zΓ(z),\\,Γ(\\frac{1}{2})=\\sqrt{\\pi }\n$$\n\nSo, we have the following:\n\n$$\n\\begin{aligned}Γ(\\frac{5}{2})=\\frac{3}{2}Γ(\\frac{3}{2})=\\frac{3}{2}\\cdot \\frac{1}{2}Γ(\\frac{1}{2})=\\frac{3}{2}\\cdot \\frac{1}{2}\\sqrt{\\pi }=\\frac{3}{4}\\sqrt{\\pi }\\end{aligned}\n$$\n\nTherefore,\n\n$$\nΓ(\\frac{1}{2})+4\\,Γ(\\frac{5}{2})=\\sqrt{\\pi }+4\\cdot \\frac{3}{4}\\sqrt{\\pi }=4\\sqrt{\\pi }.\n$$"}] [{:db/id #edb/ref 17592186432689 :knowledge-point/_questions [{:db/id #edb/ref 17592186172065 :knowledge-point/id #uuid "4c8de43f-dc61-5bbe-8b84-b8aa0be19146" :knowledge-point/title "Evaluating the Gamma Function at a Multiple of One-Half"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15b2ab14-edca-5f56-b447-4b5fab9c2703" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}\\sqrt{\\pi }" :db/id #edb/ref 17592186432603} {:answer/id #uuid "5d513a95-f295-54c8-8a9c-aee17a71f839" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}\\sqrt{\\pi }" :db/id #edb/ref 17592186432621} {:answer/id #uuid "5fecaf9c-523b-5840-82f6-4a073fed5f55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}\\sqrt{\\pi }" :db/id #edb/ref 17592186432622} {:answer/id #uuid "60a4904e-dcde-5ed0-889d-30606d3a21d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{23}{4}\\sqrt{\\pi }" :db/id #edb/ref 17592186432623} {:answer/id #uuid "b551f6da-f7c3-592b-9b70-c9a13bffd28c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{23}{8}\\sqrt{\\pi }" :db/id #edb/ref 17592186432649}] :answer-field/correct {:answer/id #uuid "b551f6da-f7c3-592b-9b70-c9a13bffd28c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{23}{8}\\sqrt{\\pi }" :db/id #edb/ref 17592186432649} :answer-field/id #uuid "af6e50ef-05cd-5170-9ca8-db0d80c3fd8a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186432680}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "38540fee-f0e4-596e-9eff-9715fa0a19af" :question/math-academy-id "q-107886" :question/problem "$Γ(\\frac{7}{2})+Γ(\\frac{1}{2})=$" :question/worked-solution "To evaluate the gamma function at multiples of one-half, we use the following recursive formula:\n\n$$\nΓ(z+1)=zΓ(z),\\,Γ(\\frac{1}{2})=\\sqrt{\\pi }\n$$\n\nSo, we have the following:\n\n$$\n\\begin{aligned}Γ(\\frac{7}{2}) & =\\frac{5}{2}\\,Γ(\\frac{5}{2}) \\\\  & =\\frac{5}{2}\\cdot \\frac{3}{2}\\,Γ(\\frac{3}{2}) \\\\  & =\\frac{5}{2}\\cdot \\frac{3}{2}\\cdot \\frac{1}{2}Γ(\\frac{1}{2}) \\\\  & =\\frac{5}{2}\\cdot \\frac{3}{2}\\cdot \\frac{1}{2}\\cdot \\sqrt{\\pi } \\\\  & =\\frac{15}{8}\\sqrt{\\pi }\\end{aligned}\n$$\n\nTherefore,\n\n$$\nΓ(\\frac{7}{2})+Γ(\\frac{1}{2})=\\frac{15}{8}\\sqrt{\\pi }+\\sqrt{\\pi }=\\frac{23}{8}\\sqrt{\\pi }.\n$$"}] [{:db/id #edb/ref 17592186432686 :knowledge-point/_questions [{:db/id #edb/ref 17592186172066 :knowledge-point/id #uuid "7e75041c-d0be-5db2-a0db-7c2c2b57b44e" :knowledge-point/title "Defining the Gamma Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1365d528-3559-5e8c-aab0-a5fb4cd1c0ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186432601} {:answer/id #uuid "461bf02a-0b0d-5764-8758-d03d9e57079c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186432615} {:answer/id #uuid "939b0a23-be39-5e33-a7e0-ca57fb9a21db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186432639} {:answer/id #uuid "a3251647-5a25-5014-86dc-0d1aa75cf482" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186432643} {:answer/id #uuid "eb1e7480-42fe-5890-a5bb-345d5a5e89d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186432665}] :answer-field/correct {:answer/id #uuid "1365d528-3559-5e8c-aab0-a5fb4cd1c0ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186432601} :answer-field/id #uuid "cc13ac3c-08d2-5ebd-90fb-f6bd2706df71" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186432684}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0d9f5142-140d-5b22-b957-299741979b12" :question/math-academy-id "q-107888" :question/problem "Which of the following integrals are equivalent to $Γ(z)$ for $\\text{Re}(z)>0?$\n\nI. ${\\int }_{0}^{\\infty }{t}^{z-1}{e}^{-t}\\,\\text{d}t$\n\nII. ${\\int }_{0}^{\\infty }\\frac{{t}^{z-1}}{{e}^{t}}\\,\\text{d}t$\n\nIII. ${\\int }_{1}^{\\infty }{t}^{z-1}{e}^{-t}\\,\\text{d}t$" :question/worked-solution "First, let's recall the definition of the gamma function:\n\n$$\nΓ(z)={\\int }_{0}^{\\infty }{t}^{z-1}{e}^{-t}\\,\\text{d}t,\\,\\text{Re}(z)>0.\n$$\n\nWith this definition in mind, let's consider each of the given integrals.\n\n- Integral I matches the definition:\n\n$$\n{\\int }_{0}^{\\infty }{t}^{z-1}{e}^{-t}\\,\\text{d}t=Γ(z)\n$$\n\n- Integral II matches the definition:\n\n$$\n{\\int }_{0}^{\\infty }\\frac{{t}^{z-1}}{{e}^{t}}={\\int }_{0}^{\\infty }{t}^{z-1}{e}^{-t}\\,\\text{d}t=Γ(z)\n$$\n\n- Integral III does *not* match the definition. The lower bound of integration does not match that given in the definition.\n\nTherefore, the correct answer is \"I and II only.\""}]}
