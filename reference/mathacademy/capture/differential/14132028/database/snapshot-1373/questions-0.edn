} :answer/value "3" :db/id #edb/ref 17592186432636} {:answer/id #uuid "943e04b1-ba07-5aed-8046-8c20df99f769" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186432640} {:answer/id #uuid "b9d3285d-efdb-515b-89b0-a83bb7af1c03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186432650}] :answer-field/correct {:answer/id #uuid "1162131c-43c4-54ff-92ec-db2b4f6a331a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186432599} :answer-field/id #uuid "c95ca100-3984-5a97-9a0d-82d238cb72cc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186432683}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "58e93e99-d92a-5ce1-a5e1-f2a7ff45e177" :question/math-academy-id "q-107848" :question/problem "Evaluate $Γ(3).$" :question/worked-solution "For any natural number $n\\ge 1,$ we have\n\n$$\nΓ(n)=(n-1)!.\n$$\n\nTherefore, \n\n$$\nΓ(3)=2!=2.\n$$"}] [{:db/id #edb/ref 17592186432697 :knowledge-point/_questions [{:db/id #edb/ref 17592186172064 :knowledge-point/id #uuid "59f9abf1-17db-5717-8660-a531ef00b15c" :knowledge-point/title "Evaluating the Gamma Function for a Positive Integer"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31575386-b43c-5cfb-b9cf-056d4be6aa3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,040" :db/id #edb/ref 17592186432609} {:answer/id #uuid "5a3da224-1c13-581e-8e58-d2d8d7580f45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "49" :db/id #edb/ref 17592186432619} {:answer/id #uuid "91c7943b-a614-5f02-890f-e5dcc585e8ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "120" :d