o class=\"mjx-n\"><mjx-c class=\"mjx-c2212\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D461 TEX-I\"></mjx-c></mjx-mi></mjx-texatom></mjx-script></mjx-msup><mjx-mstyle><mjx-mspace style=\"width: 0.167em;\"></mjx-mspace></mjx-mstyle><mjx-mtext class=\"mjx-n\"><mjx-c class=\"mjx-c64\"></mjx-c></mjx-mtext><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D461 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c393\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D467 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mn>0</mn><mi mathvariant=\"normal\">∞</mi></msubsup><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mtext>d</mtext><mi>t</mi></mrow><mrow><msup><mi>t</mi><mrow data-mjx-texclass=\"ORD\"><mn>1</mn><mo>−</mo><mi>z</mi></mrow></msup><msup><mi>e</mi><mi>t</mi></msup></mrow></mfrac></mstyle><mo>=</mo><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mn>0</mn><mi mathvariant=\"normal\">∞</mi></msubsup><msup><mi>t</mi><mrow data-mjx-texclass=\"ORD\"><mi>z</mi><mo>−</mo><mn>1</mn></mrow></msup><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mi>t</mi></mrow></msup><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>d</mtext><mi>t</mi><mo>=</mo><mi mathvariant=\"normal\">Γ</mi><mo stretchy=\"false\">(</mo><mi>z</mi><mo stretchy=\"false\">)</mo></math></mjx-assistive-mml></mjx-container></p>\n</li>\n</ul>\n<p>Therefore, the correct answer is \"III only.\"</p>\n</div></div>",
