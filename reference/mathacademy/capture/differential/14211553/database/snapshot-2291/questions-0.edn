ac{(0.6)(0.4)}{0.5} \\\\  & =\\frac{0.24}{0.5} \\\\  & =0.48.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186522752 :knowledge-point/_questions [{:db/id #edb/ref 17592186166849 :knowledge-point/id #uuid "12feb6dc-fadb-5502-86ed-7a238a3d38f1" :knowledge-point/title "Computing a Conditional Probability Using Bayes' Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51fc805e-7c80-544d-b04e-95ffc3b00b3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.63" :db/id #edb/ref 17592186522194} {:answer/id #uuid "7b2ba900-5841-5c93-be10-2cecb78788a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.48" :db/id #edb/ref 17592186522261} {:answer/id #uuid "b426b5ed-504c-537d-8c67-d362dc4b39ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.36" :db/id #edb/ref 17592186522390} {:answer/id #uuid "d8dc04fd-9562-52e8-8c20-ef54ed786e96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.51" :db/id #edb/ref 17592186522469} {:answer/id #uuid "e357c35e-053f-5ac0-a631-7cb3fbe107da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.25" :db/id #edb/ref 17592186522503}] :answer-field/correct {:answer/id #uuid "e357c35e-053f-5ac0-a631-7cb3fbe107da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.25" :db/id #edb/ref 17592186522503} :answer-field/id #uuid "fa4911c0-8b9b-5ded-8541-7a649e780685" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186522685}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "884aeeae-3d24-5d63-bf46-362bb4b6d4a9" :question/math-academy-id "q-105987" :question/problem "Given that $P(S|T)=0.3,$ $P(S)=0.6,$ and $P(T)=0.5,$ compute $P(T|S).$" :question/worked-solution "Using Bayes' theorem, we have\n\n$$\n\\begin{aligned}P(T|S) & =\\frac{P(S|T)P(T)}{P(S)} \\\\  & =\\frac{(0.3)(0.5)}{0.6} \\\\  & =\\frac{0.15}{0.6} \\\\  & =0.25.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186485564 :knowledge-point/_questions [{:db/id #edb/ref 17592186166849 :knowledge-point/id #uuid "12feb6dc-fadb-5502-86ed-7a238a3d38f1" :knowledge-point/title "Computing a Conditional Probability Using Bayes' Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b273b5f-039c-5dfa-aea1-90c5adefb5c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.15" :db/id #edb/ref 17592186484866} {:answer/id #uuid "548ac4a8-1508-57cd-8ade-15cdfda487fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.025" :db/id #edb/ref 17592186485005} {:answer/id #uuid "b56522e3-fcab-504e-8f1e-8d92e6d7bdbd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1" :db/id #edb/ref 17592186485208} {:answer/id #uuid "c761d015-4d28-595b-93b5-775dc5c5e533" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.18" :db/id #edb/ref 17592186485245} {:answer/id #uuid "e355b3a1-3bea-5e81-8cfe-737194f9762f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.06" :db/id #edb/ref 17592186485297}] :answer-field/correct {:answer/id #uuid "e355b3a1-3bea-5e81-8cfe-737194f9762f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.06" :db/id #edb/ref 17592186485297} :answer-field/id #uuid "38bbc380-b74e-556f-aed5-40d425cfefbb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485390}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a0c5c51a-9ae7-508b-bfcb-a9d35170be46" :question/math-academy-id "q-105988" :question/problem "Given that $P(E|G)=0.15,$ $P(E)=0.75,$ and $P(G)=0.3,$ compute $P(G|E).$" :question/worked-solution "Using Bayes' theorem, we have\n\n$$\n\\begin{aligned}P(G|E) & =\\frac{P(E|G)P(G)}{P(E)} \\\\  & =\\frac{(0.15)(0.3)}{0.75} \\\\  & =\\frac{0.045}{0.75} \\\\  & =0.06.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186522790 :knowledge-point/_questions [{:db/id #edb/ref 17592186166743 :knowledge-point/id #uuid "e40869c1-4d5a-57af-a2a1-55b514614c4f" :knowledge-point/title "Applying Bayes' Theorem With the Law of Total Probability"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02a70b8e-641b-5f9f-8429-083646503d5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "34%" :db/id #edb/ref 17592186522019} {:answer/id #uuid "23c9b185-7787-54a4-bca2-f16375591efa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "31%" :db/id #edb/ref 17592186522100} {:answer/id #uuid "6a61f532-a319-545e-866c-fd70cd536703" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "33%" :db/id #edb/ref 17592186522234} {:answer/id #uuid "91283086-43e6-5966-9458-5ec5d404d381" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "35%" :db/id #edb/ref 17592186522316} {:answer/id #uuid "f7095591-02a5-59b3-8d3e-ad153f388853" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32%" :db/id #edb/ref 17592186522543}] :answer-field/correct {:answer/id #uuid "f7095591-02a5-59b3-8d3e-ad153f388853" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32%" :db/id #edb/ref 17592186522543} :answer-field/id #uuid "e5cec0d0-a37e-5101-b62c-020ee35e0baf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186522673}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d7bc91a9-28bf-5e94-8b54-f2a8632dbd6e" :question/math-academy-id "q-106224" :question/problem "A survey of Bulgarian citizens showed that $17%$ of all females and  $38%$ of all males smoke. $51%$ of the population are female. If a smoker from this population is selected at random, what is the probability of them being female? Express your answer as a percentage to the nearest percent." :question/worked-solution "Let $S$ be the event that a randomly selected person smokes, and let $F$ be the event that they are female. Then, we require $P(F|S),$ which we can compute using Bayes' theorem.\n\n$$\nP(F|S)=\\frac{P(S|F)P(F)}{P(S)}=\\frac{P(S|F)P(F)}{P(S|F)P(F)+P(S|{F}^{′})P({F}^{′})}\n$$\n\nFrom the problem statement, we have the following:\n\n- Since $17%$ of all females and  $38%$ of all males smoke, we have\n\n$$\nP(S|F)=0.17,\\,P(S|{F}^{′})=0.38.\n$$\n\n- Since $51%$ of the population are female, we have\n\n$$\nP(F)=0.51,\\,P({F}^{′})=1-0.51=0.49.\n$$\n\nTherefore, using Bayes' theorem, we have\n\n$$\n\\begin{aligned}P(F|S) & =\\frac{P(S|F)P(F)}{P(S|F)P(F)+P(S|{F}^{′})P({F}^{′})} \\\\  & =\\frac{(0.17)(0.51)}{(0.17)(0.51)+(0.38)(0.49)} \\\\  & ≈32%\\end{aligned}\n$$\n\nrounded to the nearest percent."}] [{:db/id #edb/ref 17592186485552 :knowledge-point/_questions [{:db/id #edb/ref 17592186166743 :knowledge-point/id #uuid "e40869c1-4d5a-57af-a2a1-55b514614c4f" :knowledge-point/title "Applying Bayes' Theorem With the Law of Total Probability"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "290c59db-26fa-57d1-bbcb-729dd654b6c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9%" :db/id #edb/ref 17592186484894} {:answer/id #uuid "29e78ca5-247c-5685-b4ab-103670e45b6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10%" :db/id #edb/ref 17592186484900} {:answer/id #uuid "2a5595c2-7fa1-5498-8feb-9d09d0f8a9c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13%" :db/id #edb/ref 17592186484902} {:answer/id #uuid "9716a68c-461f-5e4a-ae26-a773cf54ebaa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11%" :db/id #edb/ref 17592186485143} {:answer/id #uuid "d101d0e6-9a35-546d-864c-63daa0176ad7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12%" :db/id #edb/ref 17592186485257}] :answer-field/correct {:answer/id #uuid "2a5595c2-7fa1-5498-8feb-9d09d0f8a9c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13%" :db/id #edb/ref 17592186484902} :answer-field/id #uuid "1d022681-c9f6-5bed-bb1f-10a3b038aa5d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485378}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8763b60a-8a9e-5a4f-9933-1a229bcc9ffb" :question/math-academy-id "q-106240" :question/problem "A survey of adult citizens of a particular city showed that $32%$ of all females and  $5%$ of all males don't eat after $6$ p.m. $51%$ of the population are female. If a person who doesn't eat after $6$ p.m. is selected at random, what is the probability of them being male? Express your answer as a percentage to the nearest percent." :question/worked-solution "Let $N$ be the event that a randomly selected person doesn't eat after $6$ p.m., and let $M$ be the event that they are male. Then, we require $P(M|N),$ which we can compute using Bayes' theorem.\n\n$$\nP(M|N)=\\frac{P(N|M)P(M)}{P(N)}=\\frac{P(N|M)P(M)}{P(N|M)P(M)+P(N|{M}^{′})P({M}^{′})}\n$$\n\nFrom the problem statement, we have the following:\n\n- Since $32%$ of all females and  $5%$ of all males don't eat after $6$ p.m, we have\n\n$$\nP(N|M)=0.05,\\,P(N|{M}^{′})=0.32.\n$$\n\n- Since $51%$ of the population are female, we have\n\n$$\nP(M)=1-0.51=0.49,\\,P({M}^{′})=0.51.\n$$\n\nTherefore, using Bayes' theorem, we have\n\n$$\n\\begin{aligned}P(M|N) & =\\frac{P(N|M)P(M)}{P(N|M)P(M)+P(N|{M}^{′})P({M}^{′})} \\\\  & =\\frac{(0.05)(0.49)}{(0.05)(0.49)+(0.32)(0.51)} \\\\  & ≈13%\\end{aligned}\n$$\n\nrounded to the nearest percent."}] [{:db/id #edb/ref 17592186522700 :knowledge-point/_questions [{:db/id #edb/ref 17592186166743 :knowledge-point/id #uuid "e40869c1-4d5a-57af-a2a1-55b514614c4f" :knowledge-point/title "Applying Bayes' Theorem With the Law of Total Probability"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18a6a22b-b44c-52f9-ad3e-8ce36c0c0333" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "56%" :db/id #edb/ref 17592186522075} {:answer/id #uuid "27163e64-ae56-5a01-ba08-3fcd6fa957eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "57%" :db/id #edb/ref 17592186522108} {:answer/id #uuid "45c30ff2-47a3-55bc-89c5-a3c9b9084fda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "59%" :db/id #edb/ref 17592186522170} {:answer/id #uuid "572a21b4-bb72-5c4c-aba6-d9b8820f6a5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "58%" :db/id #edb/ref 17592186522202} {:answer/id #uuid "7f159084-aaea-5881-b203-85398de327d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "55%" :db/id #edb/ref 17592186522270}] :answer-field/correct {:answer/id #uuid "27163e64-ae56-5a01-ba08-3fcd6fa957eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "57%" :db/id #edb/ref 17592186522108} :answer-field/id #uuid "59356800-2af7-5a74-9697-ca78c9e24c95" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186522605}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0ba278eb-bd8e-5c0e-8df1-e6e393201d18" :question/math-academy-id "q-106242" :question/problem "A survey of adult citizens of a particular city showed that $32%$ of all females and $5%$ of all males don't eat after $6$ p.m. $51%$ of the population are female. If a person who eats after $6$ p.m. is selected at random, what is the probability of them being male? Express your answer as a percentage to the nearest percent." :question/worked-solution "Let $E$ be the event that a randomly selected person eats after $6$ p.m., and let $M$ be the event that they are male. Then, we require $P(M|E),$ which we can compute using Bayes' theorem.\n\n$$\nP(M|E)=\\frac{P(E|M)P(M)}{P(E)}=\\frac{P(E|M)P(M)}{P(E|M)P(M)+P(E|{M}^{′})P({M}^{′})}\n$$\n\nFrom the problem statement, we have the following:\n\n- Since $32%$ of all females and  $5%$ of all males don't eat after $6$ p.m, we have\n\n$$\nP(E|M)=1-0.05=0.95,\\,P(E|{M}^{′})=1-0.32=0.68.\n$$\n\n- Since $51%$ of the population are female, we have\n\n$$\nP(M)=1-0.51=0.49,\\,P({M}^{′})=0.51.\n$$\n\nTherefore, using Bayes' theorem, we have\n\n$$\n\\begin{aligned}P(M|E) & =\\frac{P(E|M)P(M)}{P(E|M)P(M)+P(E|{M}^{′})P({M}^{′})} \\\\  & =\\frac{(0.95)(0.49)}{(0.95)(0.49)+(0.68)(0.51)} \\\\  & ≈57%\\end{aligned}\n$$\n\nrounded to the nearest percent."}] [{:db/id #edb/ref 17592186522738 :knowledge-point/_questions [{:db/id #edb/ref 17592186166744 :knowledge-point/id #uuid "5b11a5ad-5289-55e6-9a97-4c4544d76673" :knowledge-point/title "Determining the Accuracy of Medical Tests"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "124a67f2-41f7-57f2-9556-2e058ea1059e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9941" :db/id #edb/ref 17592186522056} {:answer/id #uuid "187c8520-6d60-5a7b-a412-938adbc2ec03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9712" :db/id #edb/ref 17592186522073} {:answer/id #uuid "26e742ea-5326-5b39-801a-a08dfb32c9e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9913" :db/id #edb/ref 17592186522107} {:answer/id #uuid "6dd21978-fd97-5670-80d0-583c75b3b9af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9823" :db/id #edb/ref 17592186522242} {:answer/id #uuid "d860c886-503f-5d02-9030-15c830db168a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9852" :db/id #edb/ref 17592186522466}] :answer-field/correct {:answer/id #uuid "26e742ea-5326-5b39-801a-a08dfb32c9e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9913" :db/id #edb/ref 17592186522107} :answer-field/id #uuid "eb0df150-a742-5467-bdb9-d727d51505a7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186522674}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "729d63e1-69ab-5f12-b423-6126fc288807" :question/math-academy-id "q-106498" :question/problem "A laboratory test for a particular disease is conducted on some patients. Of the tested patients, $94%$ of those infected and $7%$ of those not infected tested positive for the disease. Only $12%$ of the entire population is infected with the disease. What is the probability that a randomly chosen patient that tested negative is not infected? Round your answer to four decimal places." :question/worked-solution "Let $D$ be the event that a randomly chosen patient is infected with the disease, and let $T$ be the event they tested positive. Then, we require $P({D}^{′}|{T}^{′}),$ which we can compute using Bayes' theorem.\n\n$$\nP({D}^{′}|{T}^{′})=\\frac{P({T}^{′}|{D}^{′})P({D}^{′})}{P({T}^{′})}=\\frac{P({T}^{′}|{D}^{′})P({D}^{′})}{P({T}^{′}|{D}^{′})P({D}^{′})+P({T}^{′}|D)P(D)}\n$$\n\nFrom the problem statement, we have the following:\n\n- Since the probability of an infected person testing positive is $94%,$ and the probability of a non-infected person testing positive is $7%,$ we have\n\n$$\nP({T}^{′}|D)=1-0.94=0.06,\\,P({T}^{′}|{D}^{′})=1-0.07=0.93.\n$$\n\n- Since only $12%$ of the population has the disease, we have\n\n$$\nP(D)=0.12\\,P({D}^{′})=1-0.12=0.88.\n$$\n\nTherefore, using Bayes' theorem, we have\n\n$$\n\\begin{aligned}P({D}^{′}|{T}^{′}) & =\\frac{P({T}^{′}|{D}^{′})P({D}^{′})}{P({T}^{′}|{D}^{′})P({D}^{′})+P({T}^{′}|D)P(D)} \\\\  & =\\frac{(0.93)(0.88)}{(0.93)(0.88)+(0.06)(0.12)} \\\\  & ≈0.9913\\end{aligned}\n$$\n\nrounded to four decimal places."}] [{:db/id #edb/ref 17592186485497 :knowledge-point/_questions [{:db/id #edb/ref 17592186166744 :knowledge-point/id #uuid "5b11a5ad-5289-55e6-9a97-4c4544d76673" :knowledge-point/title "Determining the Accuracy of Medical Tests"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3cf79116-9d92-52e9-9f12-b157d9d9c934" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9885" :db/id #edb/ref 17592186484945} {:answer/id #uuid "8c51c1de-261c-5524-a4fc-c29b4bfec824" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9824" :db/id #edb/ref 17592186485121} {:answer/id #uuid "b08cff2a-aaed-5655-af11-ea689a7ea24c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9760" :db/id #edb/ref 17592186485200} {:answer/id #uuid "d5f5d8e6-2f9d-52a9-9442-17c4f785c098" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9980" :db/id #edb/ref 17592186485264} {:answer/id #uuid "dfd6f33e-a95f-532e-851f-47ac6722765f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9715" :db/id #edb/ref 17592186485287}] :answer-field/correct {:answer/id #uuid "8c51c1de-261c-5524-a4fc-c29b4bfec824" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9824" :db/id #edb/ref 17592186485121} :answer-field/id #uuid "0a36c630-25c6-582c-be57-3ab7b4dc4069" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485368}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "10d543bf-463f-57f9-8fa9-461f96d806af" :question/math-academy-id "q-106499" :question/problem "A laboratory test for a particular disease is conducted on some patients. Of the tested patients, $90%$ of those infected and $9%$ of those not infected tested positive for the disease. Only $14%$ of the entire population is infected with the disease. What is the probability that a randomly chosen patient that tested negative is not infected?  Round your answer to four decimal places." :question/worked-solution "Let $D$ be the event that a randomly chosen patient is infected with the disease, and let $T$ be the event they tested positive. Then, we require $P({D}^{′}|{T}^{′}),$ which we can compute using Bayes' theorem.\n\n$$\nP({D}^{′}|{T}^{′})=\\frac{P({T}^{′}|{D}^{′})P({D}^{′})}{P({T}^{′})}=\\frac{P({T}^{′}|{D}^{′})P({D}^{′})}{P({T}^{′}|D)P(D)+P({T}^{′}|{D}^{′})P({D}^{′})}\n$$\n\nFrom the problem statement, we have the following:\n\n- Since the probability of an infected person testing positive is $90%,$ and the probability of a non-infected person testing positive is $9%,$ we have\n\n$$\nP({T}^{′}|D)=1-0.9=0.1,\\,P({T}^{′}|{D}^{′})=1-0.09=0.91.\n$$\n\n- Since only $14%$ of the population has the disease, we have\n\n$$\nP(D)=0.14\\,P({D}^{′})=1-0.14=0.86.\n$$\n\nTherefore, using Bayes' theorem, we have\n\n$$\n\\begin{aligned}P({D}^{′}|{T}^{′}) & =\\frac{P({T}^{′}|{D}^{′})P({D}^{′})}{P({T}^{′}|D)P(D)+P({T}^{′}|{D}^{′})P({D}^{′})} \\\\  & =\\frac{(0.91)(0.86)}{(0.1)(0.14)+(0.91)(0.86)} \\\\  & ≈0.9824\\end{aligned}\n$$\n\nrounded four decimal places."}] [{:db/id #edb/ref 17592186522740 :knowledge-point/_questions [{:db/id #edb/ref 17592186166850 :knowledge-point/id #uuid "616b7aa2-2c55-5a29-a908-545a4bad4376" :knowledge-point/title "Applying Bayes’ Theorem to a Situation in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e033aa6-4de7-5db1-800c-879f51bc96d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.25" :db/id #edb/ref 17592186522153} {:answer/id #uuid "53c8eae7-65b6-5519-80c5-4696c5b5a043" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.5" :db/id #edb/ref 17592186522198} {:answer/id #uuid "6591953e-3f02-5704-a30f-7350a0937ed3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.2" :db/id #edb/ref 17592186522230} {:answer/id #uuid "b63be08a-971e-568a-bcf0-aa32ee85628f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.4" :db/id #edb/ref 17592186522393} {:answer/id #uuid "e3413079-7aa5-56cc-86b6-cb2dc4f54f32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.3" :db/id #edb/ref 17592186522502}] :answer-field/correct {:answer/id #uuid "b63be08a-971e-568a-bcf0-aa32ee85628f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.4" :db/id #edb/ref 17592186522393} :answer-field/id #uuid "fd74e72c-2c1f-53f8-8056-3995854a281c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186522687}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "74a09e82-c6f4-5ba5-932c-01b4112c68fd" :question/math-academy-id "q-170678" :question/problem "At a soccer game, $60%$ of the spectators are men. It is known that $20%$ of the men in the crowd are over $50,$ while $30%$ of all people in the crowd are over $50.$ If a person over $50$ is picked at random from the crowd, what is the probability that the person will be a man?" :question/worked-solution "Let $M$ be the event that the randomly selected person is a man, and let $F$ be the event that it is over $50.$ Then, we require $P(M|F),$ which we can compute using Bayes' theorem.\n\n$$\nP(M|F)=\\frac{P(F|M)P(M)}{P(F)}\n$$\n\nFrom the problem statement, we have the following:\n\n- $P(F|M)=0.2,$ since $20%$ of the men at the game are over $50.$\n\n- $P(M)=0.6,$ since $60%$ of all the spectators are men.\n\n- $P(F)=0.3,$ since $30%$ of all spectators are over $50.$\n\nTherefore, using Bayes' theorem, we have\n\n$$\n\\begin{aligned}P(M|F) & =\\frac{P(F|M)P(M)}{P(F)} \\\\  & =\\frac{(0.2)(0.6)}{0.3} \\\\  & =0.4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186522742 :knowledge-point/_questions [{:db/id #edb/ref 17592186166850 :knowledge-point/id #uuid "616b7aa2-2c55-5a29-a908-545a4bad4376" :knowledge-point/title "Applying Bayes’ Theorem to a Situation in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "173c78ca-07cd-5a6c-9761-ea787464b15a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "45%" :db/id #edb/ref 17592186522068} {:answer/id #uuid "2657e280-a097-5f1b-91d1-d15ac0d109bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32%" :db/id #edb/ref 17592186522104} {:answer/id #uuid "3aa84135-60de-5943-b3d5-5a014c50188d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "27%" :db/id #edb/ref 17592186522145} {:answer/id #uuid "9aa85b33-9082-59e6-8111-8fff5a6185df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "31%" :db/id #edb/ref 17592186522335} {:answer/id #uuid "b7316c1e-431c-5433-ad77-0aabc09e351b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "47%" :db/id #edb/ref 17592186522395}] :answer-field/correct {:answer/id #uuid "173c78ca-07cd-5a6c-9761-ea787464b15a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "45%" :db/id #edb/ref 17592186522068} :answer-field/id #uuid "87d6bcc7-6589-5e99-bac2-8e50a7a34102" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186522625}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7838b043-50f3-55a8-b1f4-349f8ab97093" :question/math-academy-id "q-170679" :question/problem "On an MLB team, $75%$ of all players are American citizens. It is known that $15%$ of them also speak Spanish, while $25%$ of all players on the team speak Spanish. If a player who speaks Spanish is randomly selected for a TV interview, what is the probability that he is American? Express your answer as a percentage." :question/worked-solution "Let $A$ be the event that the randomly selected player is American, and let $S$ be the event that a player speaks Spanish. Then, we require $P(A|S),$ which we can compute using Bayes' theorem.\n\n$$\nP(A|S)=\\frac{P(S|A)P(A)}{P(S)}\n$$\n\nFrom the problem statement, we have the following:\n\n- $P(S|A)=0.15,$ since $15%$ of all American players on the team speak spanish.\n\n- $P(A)=0.75,$ since $0.75%$ of the players on the team are American citizens.\n\n- $P(S)=0.25,$ since  $25%$ of all players on the team speak Spanish.\n\nTherefore, using Bayes' theorem, we have\n\n$$\n\\begin{aligned}P(A|S) & =\\frac{P(S|A)P(A)}{P(S)} \\\\  & =\\frac{(0.15)(0.75)}{0.25} \\\\  & =0.45.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186522807 :knowledge-point/_questions [{:db/id #edb/ref 17592186166743 :knowledge-point/id #uuid "e40869c1-4d5a-57af-a2a1-55b514614c4f" :knowledge-point/title "Applying Bayes' Theorem With the Law of Total Probability"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08668600-cdfa-52f8-ab7a-d4a36c8ad7e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{15}" :db/id #edb/ref 17592186522032} {:answer/id #uuid "1ffc0230-8021-5fb9-97c8-3bdfd65c4744" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{23}" :db/id #edb/ref 17592186522091} {:answer/id #uuid "aa044da1-85a9-511d-b5d4-f73842833f10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{23}" :db/id #edb/ref 17592186522376} {:answer/id #uuid "b9fdd295-7d5b-5a27-b880-407ff1f5f955" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{15}" :db/id #edb/ref 17592186522403} {:answer/id #uuid "dcd04df4-f6d0-543d-b41f-3f62636bc031" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{16}" :db/id #edb/ref 17592186522478}] :answer-field/correct {:answer/id #uuid "aa044da1-85a9-511d-b5d4-f73842833f10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{23}" :db/id #edb/ref 17592186522376} :answer-field/id #uuid "ed19dedc-ec19-5969-a25e-5d950eb640c1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186522676}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f5454beb-e917-5a8e-86e1-4e0232e2e094" :question/math-academy-id "q-170681" :question/problem "Two groups of high school students are competing in a math contest. Group $A$ consists of $5$ girls and $3$ boys, while Group $B$ consists of $2$ girls and $4$ boys. For the first challenge, one group is randomly selected, and one student is randomly selected from that group. If the selected student is a girl, what is the probability that she is from Group $B?$" :question/worked-solution "Let $B$ be the event that Group $B$ is selected, and let $G$ be the event that a randomly selected student is a girl. Then, we require $P(B|G),$ which we can compute using Bayes' theorem.\n\n$$\nP(B|G)=\\frac{P(G|B)P(B)}{P(G)}=\\frac{P(G|B)P(B)}{P(G|B)P(B)+P(G|{B}^{′})P({B}^{′})}\n$$\n\nNote that ${B}^{′}$ is the event that Group A is selected.\n\nFrom the problem statement, we have the following:\n\n- Since Group $A$ consists of $5$ girls and $3$ boys and Group $B$ consists of $2$ girls and $4$ boys, we have\n\n$$\nP(G|B)=\\frac{2}{6}=\\frac{1}{3},\\,P(G|{B}^{′})=\\frac{5}{8}.\n$$\n\n- Since the group is selected at random, we have\n\n$$\nP(B)=P({B}^{′})=\\frac{1}{2}.\n$$\n\nTherefore, using Bayes' theorem, we have\n\n$$\n\\begin{aligned}P(B|G) & =\\frac{P(G|B)P(B)}{P(G|B)P(B)+P(G|{B}^{′})P({B}^{′})} \\\\  & =\\frac{(\\frac{1}{3}\\cdot \\frac{1}{2})}{(\\frac{1}{3}\\cdot \\frac{1}{2}+\\frac{5}{8}\\cdot \\frac{1}{2})} \\\\  & =\\frac{(\\frac{1}{6})}{(\\frac{1}{6}+\\frac{5}{16})} \\\\  & =\\frac{(\\frac{1}{6})}{(\\frac{23}{48})} \\\\  & =\\frac{8}{23}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186485558 :knowledge-point/_questions [{:db/id #edb/ref 17592186166744 :knowledge-point/id #uuid "5b11a5ad-5289-55e6-9a97-4c4544d76673" :knowledge-point/title "Determining the Accuracy of Medical Tests"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b268d6b-c3b0-50cf-ba9b-3de22683fdf4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.59" :db/id #edb/ref 17592186484904} {:answer/id #uuid "702024f1-5c2b-52fe-a66f-36ff26426eb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.11" :db/id #edb/ref 17592186485058} {:answer/id #uuid "77265340-2c2c-5241-870c-55efbde8304f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.18" :db/id #edb/ref 17592186485072} {:answer/id #uuid "eedef7dd-ac36-5b19-ab7a-06d7da451edf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.67" :db/id #edb/ref 17592186485327} {:answer/id #uuid "f4020995-ec9c-5045-8b97-6421acd3b2a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.33" :db/id #edb/ref 17592186485338}] :answer-field/correct {:answer/id #uuid "f4020995-ec9c-5045-8b97-6421acd3b2a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.33" :db/id #edb/ref 17592186485338} :answer-field/id #uuid "df655b6c-59fb-5622-9ea9-612d1e33b110" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485465}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "93a07e59-f865-5d60-89bb-f9fb0b96134d" :question/math-academy-id "q-42556" :question/problem "A laboratory test for a particular allergy is conducted on some patients. Of the tested patients, $98%$ of allergy sufferers and $4%$ of non-allergic patients tested positive for the allergy. Only $2%$ of the entire population has the allergy. What is the probability that a randomly chosen patient that tested positive is an allergy sufferer? Round your answer to $2$ decimal places." :question/worked-solution "Let $A$ be the event that a randomly chosen patient is an allergy sufferer, and let $T$ be the event they tested positive. Then, we require $P(A|T),$ which we can compute using Bayes' theorem.\n\n$$\nP(A|T)=\\frac{P(T|A)P(A)}{P(T)}=\\frac{P(T|A)P(A)}{P(T|A)P(A)+P(T|{A}^{′})P({A}^{′})}\n$$\n\nFrom the problem statement, we have the following:\n\n- Since the probability of a person who has the allergy  testing positive is $98%,$ and the probability of a  non-allergic person testing positive is $4%,$ we have\n\n$$\nP(T|A)=0.98,\\,P(T|{A}^{′})=0.04.\n$$\n\n- Since only $2%$ of the population suffers the allergy, we have\n\n$$\nP(A)=0.02,\\,P({A}^{′})=1-0.02=0.98.\n$$\n\nTherefore, using Bayes' theorem, we have\n\n$$\n\\begin{aligned}P(A|T) & =\\frac{P(T|A)P(A)}{P(T|A)P(A)+P(T|{A}^{′})P({A}^{′})} \\\\  & =\\frac{(0.98)(0.02)}{(0.98)(0.02)+(0.04)(0.98)} \\\\  & ≈0.33\\end{aligned}\n$$\n\nrounded to $2$ decimal places."}] [{:db/id #edb/ref 17592186485589 :knowledge-point/_questions [{:db/id #edb/ref 17592186166850 :knowledge-point/id #uuid "616b7aa2-2c55-5a29-a908-545a4bad4376" :knowledge-point/title "Applying Bayes’ Theorem to a Situation in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52b96479-cd34-54ba-ad92-ef3be8fa5f3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.25" :db/id #edb/ref 17592186485000} {:answer/id #uuid "56ed3ec5-ca38-5ee2-87b2-01b3c0107df9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.2" :db/id #edb/ref 17592186485013} {:answer/id #uuid "becc5747-18cb-5b06-9297-9de39ab4e710" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.4" :db/id #edb/ref 17592186485227} {:answer/id #uuid "df54899c-0770-5f5e-ad57-f43564302c1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.12" :db/id #edb/ref 17592186485285} {:answer/id #uuid "f3f924fe-ad39-5b65-8e80-c2cc5621a979" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.8" :db/id #edb/ref 17592186485337}] :answer-field/correct {:answer/id #uuid "56ed3ec5-ca38-5ee2-87b2-01b3c0107df9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.2" :db/id #edb/ref 17592186485013} :answer-field/id #uuid "d9365ada-91e3-54da-a0d9-612ba60324bb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485460}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "edf69e26-0d8e-540c-b142-6a409309f520" :question/math-academy-id "q-42557" :question/problem "In a particular city, about $60%$ of mornings are cloudy and $30%$ of days are rainy. \nIt is known that $40%$ of rainy days start with cloudy mornings. What is the probability that a randomly selected cloudy morning continues as a rainy day?" :question/worked-solution "Let $C$ be the event that a randomly selected morning is cloudy, and let $R$ be the event that a randomly selected day is rainy. Then, we require $P(R|C),$ which we can compute using Bayes' theorem.\n\n$$\nP(R|C)=\\frac{P(C|R)P(R)}{P(C)}\n$$\n\n- $P(C)=0.6,$ since $60%$ of mornings are cloudy.\n\n- $P(R)=0.3,$ since $30%$ of days are rainy.\n\n- $P(C|R)=0.4,$ since $40%$ of rainy days start with cloudy mornings.\n\nTherefore, using Bayes' theorem, we have\n\n$$\n\\begin{aligned}P(R|C) & =\\frac{P(C|R)P(R)}{P(C)} \\\\  & =\\frac{0.4\\cdot 0.3}{0.6} \\\\  & =0.2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186485569 :knowledge-point/_questions [{:db/id #edb/ref 17592186166850 :knowledge-point/id #uuid "616b7aa2-2c55-5a29-a908-545a4bad4376" :knowledge-point/title "Applying Bayes’ Theorem to a Situation in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50acda37-3316-5234-ab8b-2f67633ae818" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.25" :db/id #edb/ref 17592186484990} {:answer/id #uuid "677f941d-5866-587a-917d-66562a4c917f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.43" :db/id #edb/ref 17592186485043} {:answer/id #uuid "8774a09b-47fc-5670-bf8e-966e21995278" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.55" :db/id #edb/ref 17592186485110} {:answer/id #uuid "99826990-bdc7-51ce-bcce-d832b15787b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.38" :db/id #edb/ref 17592186485149} {:answer/id #uuid "b3469cc4-c6c3-5b23-9603-1edd982206a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.45" :db/id #edb/ref 17592186485206}] :answer-field/correct {:answer/id #uuid "99826990-bdc7-51ce-bcce-d832b15787b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.38" :db/id #edb/ref 17592186485149} :answer-field/id #uuid "771b8f37-09d3-5c99-b8ef-a73c9ba31e72" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485415}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b2713c99-1478-532d-bcdd-d19b74d5beb0" :question/math-academy-id "q-42566" :question/problem "In a particular school, $65%$ of students attend a history course, and $55%$ of students attend a language course.  If $45%$ of language students attend a history course, what is the probability that a randomly chosen history student also attends a language course? Round your answer to $2$ decimal places." :question/worked-solution "Let $H$ be the event that a randomly selected student attends a history course, and let $L$ be the event that they attend a language course. Then, we require $P(L|H),$ which we can compute using Bayes' theorem.\n\n$$\nP(L|H)=\\frac{P(H|L)P(L)}{P(H)}.\n$$\n\nFrom the problem statement, we have the following:\n\n- $P(H|L)=0.45$ since $45%$ of language students also attend a history course.\n\n- $P(L)=0.55$, since $55%$ of students attend a language course.\n\n- $P(H)=0.65,$ since $65%$ of students attend a history course.\n\nTherefore, using Bayes' theorem, we have\n\n$$\n\\begin{aligned}P(L|H) & =\\frac{P(H|L)P(L)}{P(H)} \\\\  & =\\frac{(0.45)(0.55)}{0.65} \\\\  & ≈0.38\\end{aligned}\n$$\n\nrounded to $2$ decimal places."}] [{:db/id #edb/ref 17592186522727 :knowledge-point/_questions [{:db/id #edb/ref 17592186166850 :knowledge-point/id #uuid "616b7aa2-2c55-5a29-a908-545a4bad4376" :knowledge-point/title "Applying Bayes’ Theorem to a Situation in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5be87e40-3750-5117-b4cd-0091a8b0ae50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.01" :db/id #edb/ref 17592186522209} {:answer/id #uuid "9360a81e-537b-5ac8-a6f0-68bd41ed97d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.24" :db/id #edb/ref 17592186522321} {:answer/id #uuid "9ab42b52-3ca2-50ff-8c28-d4a3662f6586" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.14" :db/id #edb/ref 17592186522336} {:answer/id #uuid "9e8f44d0-fe3f-5ff0-81df-53d7daed0469" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.11" :db/id #edb/ref 17592186522346} {:answer/id #uuid "cafe4a0b-7ce5-53c1-b61a-7bd7d7990f17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.75" :db/id #edb/ref 17592186522441}] :answer-field/correct {:answer/id #uuid "9ab42b52-3ca2-50ff-8c28-d4a3662f6586" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.14" :db/id #edb/ref 17592186522336} :answer-field/id #uuid "57bdf9d4-8e50-5968-9900-6c66def0225d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186522604}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4fe71dad-9ede-5ba8-b760-d7b3b5dd3ac6" :question/math-academy-id "q-42569" :question/problem "On a particular industrial estate, the probability of smoke on a given day is $10%$ and the probability of a dangerous fire is $1.5%.$ It is known that $90%$ of dangerous fires create smoke. What is the probability of a dangerous fire when there is smoke? Round your answer to $2$ decimal places." :question/worked-solution "Let $S$ be the event that there is smoke, and let $F$ be the event that there is a dangerous fire. Then, we require $P(F|S),$ which we can compute using Bayes' theorem.\n\n$$\nP(F|S)=\\frac{P(S|F)P(F)}{P(S)}\n$$\n\n- $P(S)=0.1,$ since the probability of smoke is $10%.$\n\n- $P(F)=0.015,$ since the probability of dangerous fire is $1.5%.$\n\n- $P(S|F)=0.9,$ since  $90%$ of dangerous fires make smoke.\n\nTherefore, using Bayes' theorem, we have\n\n$$\n\\begin{aligned}P(F|S) & =\\frac{P(S|F)P(F)}{P(S)} \\\\  & =\\frac{0.9\\cdot 0.015}{0.1} \\\\  & ≈0.14,\\end{aligned}\n$$\n\nrounded to $2$ decimal places."}] [{:db/id #edb/ref 17592186522784 :knowledge-point/_questions [{:db/id #edb/ref 17592186166744 :knowledge-point/id #uuid "5b11a5ad-5289-55e6-9a97-4c4544d76673" :knowledge-point/title "Determining the Accuracy of Medical Tests"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3307c114-ee95-5061-841e-9f5b1821a620" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.7" :db/id #edb/ref 17592186522132} {:answer/id #uuid "408436ae-fcb7-5192-bc36-9e3f0f7634c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.63" :db/id #edb/ref 17592186522156} {:answer/id #uuid "87a0d937-2322-5709-8228-c8ba006d3f62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.19" :db/id #edb/ref 17592186522289} {:answer/id #uuid "a67c16ed-d105-58e7-b006-7489ffd0523f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.67" :db/id #edb/ref 17592186522372} {:answer/id #uuid "f9ea11e2-7f1e-5b27-8a6d-549184b965b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.73" :db/id #edb/ref 17592186522548}] :answer-field/correct {:answer/id #uuid "f9ea11e2-7f1e-5b27-8a6d-549184b965b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.73" :db/id #edb/ref 17592186522548} :answer-field/id #uuid "f4f7d0a9-5a27-5459-8a96-37790d16d10f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186522681}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d0b4bd1c-2214-5d30-8eda-6058d4c56287" :question/math-academy-id "q-5787" :question/problem "A laboratory test for a particular disease is conducted on some patients. Of the tested patients, $95%$ of those infected and $4%$ of those not infected tested positive for the disease. Only $10%$ of the entire population is infected with the disease. What is the probability that a randomly chosen patient that tested positive is infected? Round your answer to $2$ decimal places." :question/worked-solution "Let $D$ be the event that a randomly chosen patient is infected with the disease, and let $T$ be the event they tested positive. Then, we require $P(D|T),$ which we can compute using Bayes' theorem.\n\n$$\nP(D|T)=\\frac{P(T|D)P(D)}{P(T)}=\\frac{P(T|D)P(D)}{P(T|D)P(D)+P(T|{D}^{′})P({D}^{′})}\n$$\n\nFrom the problem statement, we have the following:\n\n- Since the probability of an infected person testing positive is $95%,$ and the probability of a non-infected person testing positive is $4%,$ we have\n\n$$\nP(T|D)=0.95,\\,P(T|{D}^{′})=0.04.\n$$\n\n- Since only $10%$ of the population has the disease, we have\n\n$$\nP(D)=0.1,\\,P({D}^{′})=1-0.1=0.9.\n$$\n\nTherefore, using Bayes' theorem, we have\n\n$$\n\\begin{aligned}P(D|T) & =\\frac{P(T|D)P(D)}{P(T|D)P(D)+P(T|{D}^{′})P({D}^{′})} \\\\  & =\\frac{(0.95)(0.1)}{(0.95)(0.1)+(0.04)(0.9)} \\\\  & ≈0.73\\end{aligned}\n$$\n\nrounded to $2$ decimal places."}] [{:db/id #edb/ref 17592186522778 :knowledge-point/_questions [{:db/id #edb/ref 17592186166744 :knowledge-point/id #uuid "5b11a5ad-5289-55e6-9a97-4c4544d76673" :knowledge-point/title "Determining the Accuracy of Medical Tests"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23ce4d3b-cda1-5a8e-9672-c0c366c0eeeb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.5" :db/id #edb/ref 17592186522101} {:answer/id #uuid "8c571f86-5a66-5e4e-a53f-a859152ee43f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.47" :db/id #edb/ref 17592186522304} {:answer/id #uuid "9ba81f0e-1c4e-5cdb-897c-d3bd7096b0fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.28" :db/id #edb/ref 17592186522338} {:answer/id #uuid "c0111cfe-e353-588e-8af3-1ae79def79e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.57" :db/id #edb/ref 17592186522413} {:answer/id #uuid "ff70f6bf-9c7a-558b-9578-7602758cd0bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.63" :db/id #edb/ref 17592186522556}] :answer-field/correct {:answer/id #uuid "c0111cfe-e353-588e-8af3-1ae79def79e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.57" :db/id #edb/ref 17592186522413} :answer-field/id #uuid "d1e98b60-187d-5aae-9ce2-daeaf5ade61f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186522660}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "befc2ac4-e448-5384-bd13-1313e616793b" :question/math-academy-id "q-5788" :question/problem "A laboratory test for a particular allergy is conducted on some patients. Of the tested patients, $96%$ of allergy sufferers and $3%$ of non-allergic patients tested positive for the allergy. Only $4%$ of the entire population has the allergy. What is the probability that a randomly chosen patient that tested positive is an allergy sufferer? Round your answer to $2$ decimal places." :question/worked-solution "Let $A$ be the event that a randomly chosen patient is an allergy sufferer, and let $T$ be the event they tested positive. Then, we require $P(A|T),$ which we can compute using Bayes' theorem.\n\n$$\nP(A|T)=\\frac{P(T|A)P(A)}{P(T)}=\\frac{P(T|A)P(A)}{P(T|A)P(A)+P(T|{A}^{′})P({A}^{′})}\n$$\n\nFrom the problem statement, we have the following:\n\n- Since the probability of a person who has the allergy testing positive is $96%,$ and the probability of a non-allergic person testing positive is $3%,$ we have\n\n$$\nP(T|A)=0.96,\\,P(T|{A}^{′})=0.03.\n$$\n\n- Since only $4%$ of the population suffers the allergy, we have\n\n$$\nP(A)=0.04,\\,P({A}^{′})=1-0.04=0.96.\n$$\n\nTherefore, using Bayes' theorem, we have\n\n$$\n\\begin{aligned}P(A|T) & =\\frac{P(T|A)P(A)}{P(T|A)P(A)+P(T|{A}^{′})P({A}^{′})} \\\\  & =\\frac{(0.96)(0.04)}{(0.96)(0.04)+(0.03)(0.96)} \\\\  & ≈0.57\\end{aligned}\n$$\n\nrounded to $2$ decimal places."}] [{:db/id #edb/ref 17592186485562 :knowledge-point/_questions [{:db/id #edb/ref 17592186166743 :knowledge-point/id #uuid "e40869c1-4d5a-57af-a2a1-55b514614c4f" :knowledge-point/title "Applying Bayes' Theorem With the Law of Total Probability"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "040aea00-58a2-5fca-845d-ab01518f7128" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186484824} {:answer/id #uuid "2f0ab6fc-40f3-5916-8be3-ff27866df904" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186484914} {:answer/id #uuid "41ac3180-c308-5c00-a48c-c3b297baf6c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186484961} {:answer/id #uuid "489b057b-8bb2-59e8-9ee9-66cb865d82a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{17}" :db/id #edb/ref 17592186484973} {:answer/id #uuid "83d6b3b0-95c8-524a-904a-5b529da0fd29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186485100}] :answer-field/correct {:answer/id #uuid "489b057b-8bb2-59e8-9ee9-66cb865d82a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{17}" :db/id #edb/ref 17592186484973} :answer-field/id #uuid "2dc6f092-2dbe-5bcc-b852-dc75e7c56d14" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485385}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9db6fca8-e341-510d-8f9f-24e493c62cfd" :question/math-academy-id "q-5792" :question/problem "Two identical bins contain chips. The first bin contains four green and two yellow chips. The second bin has three green and one yellow chip. A bin is chosen at random, and a chip is selected from the chosen bin, also at random. If we know that the selected chip is green, what is the probability that it came from the second bin?" :question/worked-solution "Let $S$ be the event that the second bin is selected, and let $G$ be the event that a randomly selected chip is green. Then, we require $P(S|G),$ which we can compute using Bayes' theorem. \n\n$$\nP(S|G)=\\frac{P(G|S)P(S)}{P(G)}=\\frac{P(G|S)P(S)}{P(G|S)P(S)+P(G|{S}^{′})P({S}^{′})}\n$$\n\nNote that ${S}^{′}$ is the event that the first bin is selected.\n\nFrom the problem statement, we have the following:\n\n- Since the first bin contains four green and two yellow chips, and the second bin contains three green and one yellow chip, we have\n\n$$\nP(G|S)=\\frac{3}{4},\\,P(G|{S}^{′})=\\frac{4}{6}=\\frac{2}{3}.\n$$\n\n- Since the bin is selected at random, we have\n\n$$\nP(S)=P({S}^{′})=\\frac{1}{2}.\n$$\n\nTherefore, using Bayes' theorem, we have\n\n$$\n\\begin{aligned}P(S|G) & =\\frac{P(G|S)P(S)}{P(G|S)P(S)+P(G|{S}^{′})P({S}^{′})} \\\\  & =\\frac{(\\frac{3}{4}\\cdot \\frac{1}{2})}{(\\frac{3}{4}\\cdot \\frac{1}{2}+\\frac{2}{3}\\cdot \\frac{1}{2})} \\\\  & =\\frac{(\\frac{3}{4})}{(\\frac{3}{4}+\\frac{2}{3})} \\\\  & =\\frac{(\\frac{3}{4})}{(\\frac{17}{12})} \\\\  & =\\frac{9}{17}.\\end{aligned}\n$$"}]}
