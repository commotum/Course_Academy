    "q-105986": {
      "dom_id": "step-q105986",
      "name": "Question 4",
      "problem": "Given that $P(L|K)=0.6,$ $P(K)=0.4,$ and $P(L)=0.5,$ compute $P(K|L).$",
      "worked_solution": "Using Bayes' theorem, we have\n\n$$\n\\begin{aligned}P(K|L) & =\\frac{P(L|K)P(K)}{P(L)} \\\\  & =\\frac{(0.6)(0.4)}{0.5} \\\\  & =\\frac{0.24}{0.5} \\\\  & =0.48.\\end{aligned}\n$$",
      "calculator_instructions": "",
