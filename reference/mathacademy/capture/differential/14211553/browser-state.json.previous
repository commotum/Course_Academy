    "q-105984": {
      "dom_id": "step-q105984",
      "name": "Question 2",
      "problem": "Given that $P(M|L)=0.15,$ $P(M)=0.35,$ and $P(L)=0.14,$ compute $P(L|M).$",
      "worked_solution": "Using Bayes' theorem, we have\n\n$$\n\\begin{aligned}P(L|M) & =\\frac{P(M|L)P(L)}{P(M)} \\\\  & =\\frac{(0.15)(0.14)}{0.35} \\\\  & =\\frac{0.021}{0.35} \\\\  & =0.06.\\end{aligned}\n$$",
      "calculator_instructions": "",
