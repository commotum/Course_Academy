">)</mo><mi>P</mi><mo stretchy=\"false\">(</mo><msup><mi>D</mi><mo data-mjx-alternate=\"1\">′</mo></msup><mo stretchy=\"false\">)</mo></mrow><mrow><mi>P</mi><mo stretchy=\"false\">(</mo><msup><mi>T</mi><mo data-mjx-alternate=\"1\">′</mo></msup><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">|</mo></mrow><mi>D</mi><mo stretchy=\"false\">)</mo><mi>P</mi><mo stretchy=\"false\">(</mo><mi>D</mi><mo stretchy=\"false\">)</mo><mo>+</mo><mi>P</mi><mo stretchy=\"false\">(</mo><msup><mi>T</mi><mo data-mjx-alternate=\"1\">′</mo></msup><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">|</mo></mrow><msup><mi>D</mi><mo data-mjx-alternate=\"1\">′</mo></msup><mo stretchy=\"false\">)</mo><mi>P</mi><mo stretchy=\"false\">(</mo><msup><mi>D</mi><mo data-mjx-alternate=\"1\">′</mo></msup><mo stretchy=\"false\">)</mo></mrow></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mo stretchy=\"false\">(</mo><mn>0.91</mn><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><mn>0.86</mn><mo stretchy=\"false\">)</mo></mrow><mrow><mo stretchy=\"false\">(</mo><mn>0.1</mn><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><mn>0.14</mn><mo stretchy=\"false\">)</mo><mo>+</mo><mo stretchy=\"false\">(</mo><mn>0.91</mn><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><mn>0.86</mn><mo stretchy=\"false\">)</mo></mrow></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>≈</mo><mn>0.9824</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container>\nrounded four decimal places.</p>\n</div></div>",
