      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14249795/observations/step-q132595-daef7d183fca05603f47.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14249795/observations/step-q132595-daef7d183fca05603f47.png",
      "source_url": "https://mathacademy.com/tasks/14249795/topics/1955/review",
