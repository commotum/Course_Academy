      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14221931/observations/step-q321945-e0a78634da1b69d1c800.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14221931/observations/step-q321945-e0a78634da1b69d1c800.png",
      "source_url": "https://mathacademy.com/tasks/14221931/topics/806/lesson",
      "captured_at": 1792029896.650401,
      "math_academy_id": "q-321945",
      "topic_id": "806",
      "sequence_position": null,
      "source_step": {
