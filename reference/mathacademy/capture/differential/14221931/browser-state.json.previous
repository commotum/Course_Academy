      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14221931/observations/step-q106293-93681fa4022e198eab55.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14221931/observations/step-q106293-93681fa4022e198eab55.png",
      "source_url": "https://mathacademy.com/tasks/14221931/topics/806/lesson",
      "captured_at": 1792029918.1275744,
      "math_academy_id": "q-106293",
      "topic_id": "806",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q106293",
