      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14221931/observations/step-q106693-c1e5485e7a4ce5fdcdc6.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14221931/observations/step-q106693-c1e5485e7a4ce5fdcdc6.png",
