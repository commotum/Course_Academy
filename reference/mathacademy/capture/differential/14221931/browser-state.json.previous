      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14221931/observations/step-q321957-1e184bf11ee347591036.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14221931/observations/step-q321957-1e184bf11ee347591036.png",
      "source_url": "https://mathacademy.com/tasks/14221931/topics/806/lesson",
      "captured_at": 1792029940.4364908,
      "math_academy_id": "q-321957",
