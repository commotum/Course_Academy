 "cf960976-4b33-5d50-bb00-f55f8bea67a5" #edb/ref 17592186045417] [17592186301093 #edb/ref 1080 "4\\operatorname{sin}\\theta " #edb/ref 17592186045417] [17592186301093 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186301093 #edb/ref 1083 #uuid "e36e3afa-c12b-5dbf-b925-ce2a9ac1b821" #edb/ref 17592186045417] [17592186301094 #edb/ref 1080 "25" #edb/ref 17592186045417] [17592186301094 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186301094 #edb/ref 1083 #uuid "e37b2f7b-15e2-5184-bb38-7c4d0c13df3b" #edb/ref 17592186045417] [17592186301224 #edb/ref 1080 "4\\operatorname{cos}\\theta " #edb/ref 17592186045417] [17592186301224 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186301224 #edb/ref 1083 #uuid "ff1359ca-731e-588b-ad72-8641a92033c3" #edb/ref 17592186045417] [17592186301419 #edb/ref 1075 #edb/ref 17592186301093 #edb/ref 17592186045417] [17592186301419 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186301419 #edb/ref 1077 "field-2" #edb/ref 17592186045417] [17592186301419 #edb/ref 1078 #edb/ref 17592186301093 #edb/ref 17592186045417] [17592186301419 #edb/ref 1079 #uuid "3c007995-49ad-5e9a-b8b6-93fc43a8d698" #edb/ref 17592186045417] [17592186301438 #edb/ref 1075 #edb/ref 17592186301224 #edb/ref 17592186045417] [17592186301438 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186301438 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186301438 #edb/ref 1078 #edb/ref 17592186301224 #edb/ref 17592186045417] [17592186301438 #edb/ref 1079 #uuid "401ee065-0ebf-5aa0-824b-786cf439cf76" #edb/ref 17592186045417] [17592186301630 #edb/ref 1075 #edb/ref 17592186300744 #edb/ref 17592186045417] [17592186301630 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186301630 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186301630 #edb/ref 1078 #edb/ref 17592186300744 #edb/ref 17592186045417] [17592186301630 #edb/ref 1079 #uuid "800b3d0b-20d9-50e8-a5e7-06f6f3966edc" #edb/ref 17592186045417] [17592186301966 #edb/ref 1075 #edb/ref 17592186300997 #edb/ref 17592186045417] [17592186301966 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186301966 #edb/ref 1077 "field-2" #edb/ref 17592186045417] [17592186301966 #edb/ref 1078 #edb/ref 17592186300997 #edb/ref 17592186045417] [17592186301966 #edb/ref 1079 #uuid "e9c94416-2a0c-5eec-9d8c-84444f96eb1f" #edb/ref 17592186045417] [17592186301979 #edb/ref 1075 #edb/ref 17592186301094 #edb/ref 17592186045417] [17592186301979 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186301979 #edb/ref 1077 "field-3" #edb/ref 17592186045417] [17592186301979 #edb/ref 1078 #edb/ref 17592186301094 #edb/ref 17592186045417] [17592186301979 #edb/ref 1079 #uuid "ec807056-656f-52ca-a946-3ed532a26982" #edb/ref 17592186045417] [17592186302089 #edb/ref 1068 #edb/ref 17592186301419 #edb/ref 17592186045417] [17592186302089 #edb/ref 1068 #edb/ref 17592186301438 #edb/ref 17592186045417] [17592186302089 #edb/ref 1069 "q-321890" #edb/ref 17592186045417] [17592186302089 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186302089 #edb/ref 1071 "![](images/b5/b51c85930a5b93bcf7f3e7537cd39cf4134d93470b580c0f7276ddb58ade7297.png)\n\nConsider the circle of radius $4$ centered at the origin, as shown above. Construct a set of parametric equations, defined for $\\theta \\in [0,2\\pi ),$ that traverse the circle once in the counterclockwise direction starting at the point $A(4,0).$\n\n$x=$\n{{field-1}}$,\\,y=$\n{{field-2}}$,\\,\\theta \\in [0,2\\pi )$" #edb/ref 17592186045417] [17592186302089 #edb/ref 1072 #uuid "6149e2ab-873c-5575-a1df-2ba15ff46c49" #edb/ref 17592186045417] [17592186302089 #edb/ref 1074 "The parametric equations of a circle of radius $r$ centered at the origin are\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nUnder this parametrization, the circle is traversed once in the counterclockwise direction, starting from $(r,0).$\n\nIn our case, the radius is $r=4.$ Substituting $r=4$ gives\n\n$$\nx=4\\operatorname{cos}⁡\\theta ,\\,y=4\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$" #edb/ref 17592186045417] [17592186302103 #edb/ref 1068 #edb/ref 17592186301630 #edb/ref 17592186045417] [17592186302103 #edb/ref 1068 #edb/ref 17592186301966 #edb/ref 17592186045417] [17592186302103 #edb/ref 1068 #edb/ref 17592186301979 #edb/ref 17592186045417] [17592186302103 #edb/ref 1069 "q-321986" #edb/ref 17592186045417] [17592186302103 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186302103 #edb/ref 1071 "The Cartesian equation of the circle defined by the parametric equations\n\n$$\nx=5\\operatorname{cos}⁡\\theta -3,\\,y=5\\operatorname{sin}⁡\\theta +4,\\,0\\le \\theta <2\\pi \n$$\n\nis given by\n\n$(x\\,+$\n{{field-1}}$)^{2}+(y\\,-$\n{{field-2}}$)^{2}=$\n{{field-3}}." #edb/ref 17592186045417] [17592186302103 #edb/ref 1072 #uuid "7267f9b7-cdd2-51d4-b411-b6d5bc974cb9" #edb/ref 17592186045417] [17592186302103 #edb/ref 1074 "To find the Cartesian equation of the circle, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy isolating the $\\operatorname{cos}⁡\\theta $ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}\\frac{x+3}{5} & =\\operatorname{cos}⁡\\theta  \\\\ \\frac{(x+3)^{2}}{{5}^{2}} & ={cos}^{2}⁡\\theta  \\\\ \\frac{(x+3)^{2}}{25} & ={cos}^{2}⁡\\theta .\\end{aligned}\n$$\n\nBy isolating the $\\operatorname{sin}⁡\\theta $ term in the $y$-equation and squaring, we get\n\n$$\n\\begin{aligned}\\frac{y-4}{5} & =\\operatorname{sin}⁡\\theta  \\\\ \\frac{(y-4)^{2}}{{5}^{2}} & ={sin}^{2}⁡\\theta  \\\\ \\frac{(y-4)^{2}}{25} & ={sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nAdding the two equations and using ${cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1,$ we get\n\n$$\n\\begin{aligned}\\frac{(x+3)^{2}}{25}+\\frac{(y-4)^{2}}{25} & ={cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta  \\\\ \\frac{(x+3)^{2}}{25}+\\frac{(y-4)^{2}}{25} & =1 \\\\ (x+3)^{2}+(y-4)^{2} & =25\\end{aligned}\n$$\n\nTherefore, the Cartesian equation is $(x+3)^{2}+(y-4)^{2}=25.$" #edb/ref 17592186045417] [17592186333841 #edb/ref 1080 "x=7\\operatorname{cos}⁡\\theta ,\\,y=7\\operatorname{sin}⁡\\theta " #edb/ref 17592186045417] [17592186333841 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186333841 #edb/ref 1083 #uuid "5d1b8313-c1b2-5eda-acb2-63c348152409" #edb/ref 17592186045417] [17592186334082 #edb/ref 1080 "x=3.5\\operatorname{sin}⁡\\theta ,\\,y=3,5\\operatorname{cos}⁡\\theta " #edb/ref 17592186045417] [17592186334082 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186334082 #edb/ref 1083 #uuid "79996192-7b93-5c51-a526-1276dbe3b10a" #edb/ref 17592186045417] [17592186334383 #edb/ref 1080 "x=14\\operatorname{sin}⁡\\theta ,\\,y=14\\operatorname{cos}⁡\\theta " #edb/ref 17592186045417] [17592186334383 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186334383 #edb/ref 1083 #uuid "9e394e44-710c-54a8-bc1c-3c21623a7a44" #edb/ref 17592186045417] [17592186334418 #edb/ref 1080 "x=49\\operatorname{sin}⁡\\theta ,\\,y=49\\operatorname{cos}⁡\\theta " #edb/ref 17592186045417] [17592186334418 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186334418 #edb/ref 1083 #uuid "a28bd334-8170-58e3-9445-9cb1b6aa8fec" #edb/ref 17592186045417] [17592186334983 #edb/ref 1080 "x=\\sqrt{7}\\operatorname{sin}⁡\\theta ,\\,y=\\sqrt{7}\\operatorname{cos}⁡\\theta " #edb/ref 17592186045417] [17592186334983 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186334983 #edb/ref 1083 #uuid "e4d26940-aaf6-5b1b-8aed-83475b1eb948" #edb/ref 17592186045417] [17592186335421 #edb/ref 1075 #edb/ref 17592186333841 #edb/ref 17592186045417] [17592186335421 #edb/ref 1075 #edb/ref 17592186334082 #edb/ref 17592186045417] [17592186335421 #edb/ref 1075 #edb/ref 17592186334383 #edb/ref 17592186045417] [17592186335421 #edb/ref 1075 #edb/ref