#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186484343} :activity/id #uuid "a8c2fb89-d42b-514b-82ae-19ce4b7382f1" :activity/scope {:db/id #edb/ref 17592186049113 :topic/id #uuid "dba97a8b-19ad-5a52-bd24-261e0b206661" :topic/math-academy-id 1968} :activity/steps [{:db/id #edb/ref 17592186484302 :step/content {:db/id #edb/ref 17592186404086 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7df3b7c7-8ab5-56e8-8b9c-3e3f6b261779" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$a=1,$ $b=7,$ and $c=-2$" :db/id #edb/ref 17592186404088} {:answer/id #uuid "bb986d69-47f8-539e-8e78-570956df6719" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$a=7,$ $b=1,$ and $c=-2$" :db/id #edb/ref 17592186404089} {:answer/id #uuid "5e7bfd3a-84c3-5bd7-86de-43e46a13b773" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$a=-2,$ $b=1,$ and $c=7$" :db/id #edb/ref 17592186404090} {:answer/id #uuid "72889b64-0d8f-5cf5-a078-304cd0270229" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$a=1,$ $b=-2,$ and $c=7$" :db/id #edb/ref 17592186404091} {:answer/id #uuid "d85b9e14-5285-547f-8225-bac68ffb2c7b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$a=-2,$ $b=7,$ and $c=1$" :db/id #edb/ref 17592186404092}] :answer-field/correct {:db/id #edb/ref 17592186404092} :answer-field/id #uuid "9085b031-ef66-5fae-9905-de9a5b2e5bed" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186404087}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5e995591-79aa-5800-bd07-e99e51f5d9cb" :question/math-academy-id "q-80373" :question/problem "Consider the matrix $H$ for which ${\\lambda }_{1}=4$ and ${\\lambda }_{2}=-2$ are eigenvalues, and\n\n$$\n{v}_{1}=[\\begin{aligned}5 \\\\ 7\\end{aligned}],\\,{v}_{2}=[\\begin{aligned}-3 \\\\ 1\\end{aligned}]\n$$\n\nare the respective eigenvectors. What are the values of $a,b,c$ given that\n\n$$\nH=[\\begin{aligned}5 & -3 \\\\ b & c\\end{aligned}][\\begin{aligned}4 & 0 \\\\ 0 & a\\end{aligned}]{[\\begin{aligned}5 & -3 \\\\ b & c\\end{aligned}]}^{-1}?\n$$" :question/worked-solution "Since the eigenvalues of the matrix are ${\\lambda }_{1}=4$ and ${\\lambda }_{2}=-2,$ we construct the diagonal matrix $D$ by writing the eigenvalues in the main diagonal:\n\n$$\nD=[\\begin{aligned}4 & 0 \\\\ 0 & -2\\end{aligned}].\n$$\n\nNow, to construct the matrix $P,$ we simply write the respective eigenvectors as columns: \n\n- the $1$st column is the eigenvector corresponding to ${\\lambda }_{1}=4,$ and\n\n- the $2$nd column is the eigenvector corresponding to ${\\lambda }_{2}=-2.$\n\nTherefore, we get\n\n$$\nP=[\\begin{aligned}5 & -3 \\\\ 7 & 1\\end{aligned}].\n$$\n\nFinally, we obtain\n\n$$\nH=[\\begin{aligned}5 & -3 \\\\ 7 & 1\\end{aligned}][\\begin{aligned}4 & 0 \\\\ 0 & -2\\end{aligned}]{[\\begin{aligned}5 & -3 \\\\ 7 & 1\\end{aligned}]}^{-1}.\n$$\n\n \n\nIn conclusion, we get  $a=-2,$ $b=7,$ and $c=1.$"} :step/id #uuid "0941e58b-0bd2-5235-9587-a3343780969f" :step/next {:db/id #edb/ref 17592186484348}} {:db/id #edb/ref 17592186484321 :step/content {:db/id #edb/ref 17592186272003 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1efeb8db-be18-53ad-9f41-5d9c7901a0a7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$D=[\\begin{aligned}-1 & 0 \\\\ 0 & 3\\end{aligned}]$\nand\n$P=[\\begin{aligned}2 & 3 \\\\ 1 & 1\\end{aligned}]$" :db/id #edb/ref 17592186269528} {:answer/id #uuid "7ec1cf70-97c1-5cb0-8bd5-06b5006830a9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$D=[\\begin{aligned}3 & 0 \\\\ 0 & -1\\end{aligned}]$\nand\n$P=[\\begin{aligned}2 & 3 \\\\ 1 & 1\\end{aligned}]$" :db/id #edb/ref 17592186270376} {:answer/id #uuid "892aa3f2-2bcf-5365-9936-d7600a913769" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$D=[\\begin{aligned}-1 & 0 \\\\ 0 & 3\\end{aligned}]$\nand\n$P=[\\begin{aligned}2 & 1 \\\\ 3 & 1\\end{aligned}]$" :db/id #edb/ref 17592186270453} {:answer/id #uuid "b318af36-27af-5e2d-86e0-a473a223bf88" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$D=[\\begin{aligned}-1 & 0 \\\\ 0 & 3\\end{aligned}]$\nand\n$P=[\\begin{aligned}1 & 2 \\\\ 1 & 3\\end{aligned}]$" :db/id #edb/ref 17592186270866} {:answer/id #uuid "cfd567a3-4432-56c1-9cad-efedcb5d9c2f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$D=[\\begin{aligned}3 & 0 \\\\ 0 & -1\\end{aligned}]$\nand\n$P=[\\begin{aligned}2 & 1 \\\\ 3 & 1\\end{aligned}]$" :db/id #edb/ref 17592186271092}] :answer-field/correct {:db/id #edb/ref 17592186270453} :answer-field/id #uuid "4f85dded-035f-5cb9-a048-9d2ff9e5113a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186271654}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f80fc9d4-c782-54c4-af07-b3eb33afd65c" :question/math-academy-id "q-140038" :question/problem "Consider the matrix $A=[\\begin{aligned}11 & -8 \\\\ 12 & -9\\end{aligned}].$ You're given that ${\\lambda }_{1}=-1$ and ${\\lambda }_{2}=3$ are the eigenvalues of $A$, and\n${v}_{1}=[\\begin{aligned}2 \\\\ 3\\end{aligned}]$, ${v}_{2}=[\\begin{aligned}1 \\\\ 1\\end{aligned}]$ are the respective eigenvectors. Find the matrices $P$ and $D$ such that $PD{P}^{-1}=A,$ where $D$ is a diagonal matrix." :question/worked-solution "Since the eigenvalues of the matrix are ${\\lambda }_{1}=-1$ and ${\\lambda }_{2}=3,$ we construct the diagonal matrix $D$ by writing the eigenvalues in the main diagonal:\n\n$$\nD=[\\begin{aligned}-1 & 0 \\\\ 0 & 3\\end{aligned}].\n$$\n\nNow, to construct the matrix $P,$ we simply write the respective eigenvectors as columns: \n\n- the $1$st column is the eigenvector corresponding to ${\\lambda }_{1}=-1,$ and\n\n- the $2$nd column is the eigenvector corresponding to ${\\lambda }_{2}=3.$\n\nTherefore, we get\n\n$$\nP=[\\begin{aligned}2 & 1 \\\\ 3 & 1\\end{aligned}].\n$$"} :step/id #uuid "5513cc34-2b32-5506-9702-6da092a7c566"} {:db/id #edb/ref 17592186484343 :step/content {:db/id #edb/ref 17592186125087 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a3d8a9f-0837-5444-96f4-3343addf731c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$D=[\\begin{aligned}-3 & 0 \\\\ 0 & 1\\end{aligned}]$\nand\n$P=[\\begin{aligned}2 & 0 \\\\ -2 & 1\\end{aligned}]$" :db/id #edb/ref 17592186321730} {:answer/id #uuid "5eb2d859-49de-56b7-a465-a7874068e2c1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$D=[\\begin{aligned}-3 & 0 \\\\ 0 & 1\\end{aligned}]$\nand\n$P=[\\begin{aligned}2 & -2 \\\\ 0 & 1\\end{aligned}]$" :db/id #edb/ref 17592186321894} {:answer/id #uuid "7867aeed-68dd-56a2-a34d-5ec26ea35c5c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$D=[\\begin{aligned}-3 & 0 \\\\ 0 & 1\\end{aligned}]$\nand \n$P=[\\begin{aligned}-2 & 2 \\\\ 1 & 0\\end{aligned}]$" :db/id #edb/ref 17592186322093} {:answer/id #uuid "9d96ee6e-162e-5c5e-a698-98e97a131b1e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$D=[\\begin{aligned}-3 & 0 \\\\ 0 & 1\\end{aligned}]$\nand \n$P=[\\begin{aligned}-2 & 1 \\\\ 2 & 0\\end{aligned}]$" :db/id #edb/ref 17592186322387} {:answer/id #uuid "dfb16a4c-567b-5f54-9449-b0670f93ce27" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$D=[\\begin{aligned}1 & 0 \\\\ 0 & -3\\end{aligned}]$\nand\n$P=[\\begin{aligned}2 & -2 \\\\ 0 & 1\\end{aligned}]$" :db/id #edb/ref 17592186322897}] :answer-field/correct {:db/id #edb/ref 17592186321894} :answer-field/id #uuid "13cf44af-77c6-56e5-9933-c6fb76ed79fc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186323206}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1a91b641-268c-57ee-aae6-245277497fff" :question/math-academy-id "q-37600" :question/problem "Consider the matrix $A=[\\begin{aligned}-3 & -8 \\\\ 0 & 1\\end{aligned}].$ You're given that ${\\lambda }_{1}=-3$ and ${\\lambda }_{2}=1$ are the eigenvalues of $A$, and\n${v}_{1}=[\\begin{aligned}2 \\\\ 0\\end{aligned}]$, ${v}_{2}=[\\begin{aligned}-2 \\\\ 1\\end{aligned}]$ are the respective eigenvectors. Find the matrices $P$ and $D$ such that $PD{P}^{-1}=A,$ where $D$ is a diagonal matrix." :question/worked-solution "Since the eigenvalues of the matrix are ${\\lambda }_{1}=-3$ and ${\\lambda }_{2}=1,$ we construct the diagonal matrix $D$ by writing the eigenvalues in the main diagonal:\n\n$$\nD=[\\begin{aligned}-3 & 0 \\\\ 0 & 1\\end{aligned}].\n$$\n\nNow, to construct the matrix $P,$ we simply write the respective eigenvectors as columns: \n\n- the $1$st column is the eigenvector corresponding to ${\\lambda }_{1}=-3,$ and\n\n- the $2$nd column is the eigenvector corresponding to ${\\lambda }_{2}=1.$\n\nTherefore, we get\n\n$$\nP=[\\begin{aligned}2 & -2 \\\\ 0 & 1\\end{aligned}].\n$$"} :step/id #uuid "b6191fc0-4b6b-54d3-87b6-db357e39ec0f" :step/next {:db/id #edb/ref 17592186484359}} {:db/id #edb/ref 17592186484348 :step/content {:db/id #edb/ref 17592186404093 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fb0eb10f-8358-5f70-9dcf-5a12623a7ffa" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$D=[\\begin{aligned}3 & 0 \\\\ 0 & -6\\end{aligned}]$ and \n$P=[\\begin{aligned}1 & 2 \\\\ 1 & 1\\end{aligned}]$" :db/id #edb/ref 17592186404095} {:answer/id #uuid "1df643a8-80e1-5748-9179-fabd113dde47" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$D=[\\begin{aligned}-6 & 0 \\\\ 0 & -3\\end{aligned}]$ and \n$P=[\\begin{aligned}1 & 1 \\\\ 1 & -2\\end{aligned}]$" :db/id #edb/ref 17592186404096} {:answer/id #uuid "0dd75f60-e366-51aa-9704-98e0a480bbc9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$D=[\\begin{aligned}-3 & 0 \\\\ 0 & -6\\end{aligned}]$ and \n$P=[\\begin{aligned}1 & 2 \\\\ 1 & 1\\end{aligned}]$" :db/id #edb/ref 17592186404097} {:answer/id #uuid "fa9540b0-0bdb-50eb-99c1-9744cc3a5660" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$D=[\\begin{aligned}3 & 0 \\\\ 0 & 6\\end{aligned}]$ and \n$P=[\\begin{aligned}1 & 2 \\\\ 1 & -1\\end{aligned}]$" :db/id #edb/ref 17592186404098} {:answer/id #uuid "f62ab074-e099-5956-af5c-d32875cc38df" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$D=[\\begin{aligned}6 & 0 \\\\ 0 & 3\\end{aligned}]$ and \n$P=[\\begin{aligned}2 & 1 \\\\ 1 & -1\\end{aligned}]$" :db/id #edb/ref 17592186404099}] :answer-field/correct {:db/id #edb/ref 17592186404098} :answer-field/id #uuid "76990587-1106-5838-a7d3-5abb529f309f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186404094}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0fb53181-29d9-5f89-8598-3c491720e6bd" :question/math-academy-id "q-80389" :question/problem "Consider the matrix $A=[\\begin{aligned}5 & -2 \\\\ -1 & 4\\end{aligned}].$ You're given that ${\\lambda }_{1}=3$ and ${\\lambda }_{2}=6$ are the eigenvalues of $A$, and\n${v}_{1}=[\\begin{aligned}1 \\\\ 1\\end{aligned}]$, ${v}_{2}=[\\begin{aligned}2 \\\\ -1\\end{aligned}]$ are the respective eigenvectors. Find the matrices $P$ and $D$ such that $PD{P}^{-1}=A,$ where $D$ is a diagonal matrix." :question/worked-solution "Since the eigenvalues of the matrix are ${\\lambda }_{1}=3$ and ${\\lambda }_{2}=6,$ we construct the diagonal matrix $D$ by writing the eigenvalues in the main diagonal:\n\n$$\nD=[\\begin{aligned}3 & 0 \\\\ 0 & 6\\end{aligned}].\n$$\n\nNow, to construct the matrix $P,$ we simply write the respective eigenvectors as columns: \n\n- the $1$st column is the eigenvector corresponding to ${\\lambda }_{1}=3,$ and\n\n- the $2$nd column is the eigenvector corresponding to ${\\lambda }_{2}=6.$\n\nTherefore, we get\n\n$$\nP=[\\begin{aligned}1 & 2 \\\\ 1 & -1\\end{aligned}].\n$$"} :step/id #uuid "be260382-f713-59c8-aa98-36b16550df21" :step/next {:db/id #edb/ref 17592186484321}} {:db/id #edb/ref 17592186484359 :step/content {:db/id #edb/ref 17592186125090 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0acfb64f-d399-5128-abd9-0fd718785c17" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$a=1,$ $b=-3,$ and $c=3$" :db/id #edb/ref 17592186321233} {:answer/id #uuid "32ca874e-c218-5348-8254-ebdd24f6b5a9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$a=3,$ $b=1,$ and $c=-1$" :db/id #edb/ref 17592186321535} {:answer/id #uuid "3d45e436-1b6c-5c26-990c-2a9bafba337d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$a=15,$ $b=-1,$ and $c=-2$" :db/id #edb/ref 17592186321624} {:answer/id #uuid "824319fd-3efa-515c-be89-065ca8419d86" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$a=3,$ $b=-1,$ and $c=1$" :db/id #edb/ref 17592186322173} {:answer/id #uuid "f428ad45-b7f1-5420-a618-a7f180e0107e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$a=-1,$ $b=3,$ and $c=-3$" :db/id #edb/ref 17592186323062}] :answer-field/correct {:db/id #edb/ref 17592186322173} :answer-field/id #uuid "c580f2eb-b112-550e-99c4-120b3d89a440" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186323555}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "52d32399-93d9-5ce5-a996-5d60c1e0900e" :question/math-academy-id "q-37610" :question/problem "Consider the matrix $A$ for which ${\\lambda }_{1}=3$ and ${\\lambda }_{2}=15$ are eigenvalues, and\n\n$$\n{v}_{1}=[\\begin{aligned}1 \\\\ 2\\end{aligned}],\\,{v}_{2}=[\\begin{aligned}-1 \\\\ 1\\end{aligned}]\n$$\n\nare the respective eigenvectors. What are the values of $a,b,c$ given that\n\n$$\nA=[\\begin{aligned}1 & b \\\\ 2 & c\\end{aligned}][\\begin{aligned}a & 0 \\\\ 0 & 15\\end{aligned}]{[\\begin{aligned}1 & b \\\\ 2 & c\\end{aligned}]}^{-1}?\n$$" :question/worked-solution "Since the eigenvalues of the matrix are ${\\lambda }_{1}=3$ and ${\\lambda }_{2}=15,$ we construct the diagonal matrix $D$ by writing the eigenvalues in the main diagonal:\n\n$$\nD=[\\begin{aligned}3 & 0 \\\\ 0 & 15\\end{aligned}].\n$$\n\nNow, to construct the matrix $P,$ we simply write the respective eigenvectors as columns: \n\n- the $1$st column is the eigenvector corresponding to ${\\lambda }_{1}=3,$ and\n\n- the $2$nd column is the eigenvector corresponding to ${\\lambda }_{2}=15.$\n\nTherefore, we get\n\n$$\nP=[\\begin{aligned}1 & -1 \\\\ 2 & 1\\end{aligned}].\n$$\n\nFinally, we obtain\n\n$$\nA=[\\begin{aligned}1 & -1 \\\\ 2 & 1\\end{aligned}][\\begin{aligned}3 & 0 \\\\ 0 & 15\\end{aligned}]{[\\begin{aligned}1 & -1 \\\\ 2 & 1\\end{aligned}]}^{-1}.\n$$\n\n \n\nIn conclusion, we get $a=3,$ $b=-1,$ and $c=1.$"} :step/id #uuid "e96641df-6f79-5c48-8011-c2641ddec815" :step/next {:db/id #edb/ref 17592186484302}}] :activity/title "Diagonalizing a 2x2 Matrix" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186483562}]}
