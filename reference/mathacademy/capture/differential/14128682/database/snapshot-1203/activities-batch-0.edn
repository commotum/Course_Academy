/ref 17592186419422} {:db/id #edb/ref 17592186423157}] :knowledge-point/title "Finding the Cartesian Equation of the Plane Perpendicular To a Given Line"} :step/id #uuid "38691512-c8ac-58b3-b639-597249a111ce" :step/math-academy-id 17924 :step/next {:db/id #edb/ref 17592186120718}} {:db/id #edb/ref 17592186120718 :step/content {:db/id #edb/ref 17592186119834 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119645 :question/id #uuid "aa7c3400-9bc0-5f3a-84e5-f3cc2bb87f5d" :question/math-academy-id "e-4938"} :knowledge-point/id #uuid "80c443e5-a0b2-5aae-ac8d-27449a8049a3" :knowledge-point/questions [{:db/id #edb/ref 17592186120282} {:db/id #edb/ref 17592186120284} {:db/id #edb/ref 17592186262889} {:db/id #edb/ref 17592186262890} {:db/id #edb/ref 17592186302310} {:db/id #edb/ref 17592186311666} {:db/id #edb/ref 17592186311667} {:db/id #edb/ref 17592186311668} {:db/id #edb/ref 17592186311669} {:db/id #edb/ref 17592186311670} {:db/id #edb/ref 17592186311671} {:db/id #edb/ref 17592186363024} {:db/id #edb/ref 17592186387873} {:db/id #edb/ref 17592186393015} {:db/id #edb/ref 17592186393022} {:db/id #edb/ref 17592186423960}] :knowledge-point/title "Finding the Vector Equation of a Plane Given Its Cartesian Equation"} :step/id #uuid "4e18819d-30d0-5673-a2f4-2264aa09fbde" :step/math-academy-id 17925 :step/next {:db/id #edb/ref 17592186120719}} {:db/id #edb/ref 17592186120719 :step/content {:db/id #edb/ref 17592186119835 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119646 :question/id #uuid "8a9e1070-0ca0-5f24-ac89-999c9271a91b" :question/math-academy-id "e-4939"} :knowledge-point/id #uuid "0efe5b11-2c87-58e9-bf7c-e1eecb07adf2" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049132}] :knowledge-point/questions [{:db/id #edb/ref 17592186120232} {:db/id #edb/ref 17592186120283} {:db/id #edb/ref 17592186262901} {:db/id #edb/ref 17592186302288} {:db/id #edb/ref 17592186304912} {:db/id #edb/ref 17592186311692} {:db/id #edb/ref 17592186311695} {:db/id #edb/ref 17592186311696} {:db/id #edb/ref 17592186311708} {:db/id #edb/ref 17592186314753} {:db/id #edb/ref 17592186338833} {:db/id #edb/ref 17592186413737} {:db/id #edb/ref 17592186419423}] :knowledge-point/title "Finding the Cartesian Equation of the Plane Parallel To Two Vectors"} :step/id #uuid "311c08f2-aa3d-5ea5-8386-44e9771e47c6" :step/math-academy-id 17926}] :activity/title "The Cartesian Equation of a Plane" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186120018}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186419424} :activity/id #uuid "0a7d7d24-69e8-5aec-803a-f5712a252473" :activity/scope {:db/id #edb/ref 17592186050830 :topic/id #uuid "6a093d52-40f2-54b8-8982-db428e58bab5" :topic/math-academy-id 1807} :activity/steps [{:db/id #edb/ref 17592186419424 :step/content {:db/id #edb/ref 17592186419422 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08c0fd5d-eb30-51ed-9d57-ff0d86d1b905" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x-y+z-2=0" :db/id #edb/ref 17592186419403} {:answer/id #uuid "25dcf144-1a51-5366-9800-5383c00b5a7d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x-2y-z-2=0" :db/id #edb/ref 17592186419405} {:answer/id #uuid "2b822cf8-78b8-5c6f-ba5e-a61ce1027e3a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x-2y-z-5=0" :db/id #edb/ref 17592186419406} {:answer/id #uuid "aaf4ea99-1c7e-5b6b-af27-f81db06966e0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-x-2y-z-5=0" :db/id #edb/ref 17592186419410} {:answer/id #uuid "b32a3885-cdf4-51dc-ad0e-0a3c46647043" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x-y+z-5=0" :db/id #edb/ref 17592186419412}] :answer-field/correct {:db/id #edb/ref 17592186419405} :answer-field/id #uuid "b30e511f-0a3e-547f-96f1-0bfc53ad4766" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186419419}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "70aeaa22-2b90-533e-ab1d-9dbd9f885f48" :question/math-academy-id "q-70807" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(1,-1,1)$ and is perpendicular to the line \n$\\frac{x-2}{-1}=\\frac{y-1}{2}=\\frac{z+1}{1}.$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨1,-1,1⟩.$ From the canonical equation, we find that the line is parallel to the vector $⟨-1,2,1⟩.$ So, the normal vector of the plane is \n\n$$\nn=⟨-1,2,1⟩.\n$$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨-1,2,1⟩ & =⟨1,-1,1⟩\\cdot ⟨-1,2,1⟩ \\\\ r\\cdot ⟨-1,2,1⟩ & =-2\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨-1,2,1⟩ & =-2 \\\\ -x+2y+z & =-2 \\\\ -x+2y+z+2 & =0 \\\\ x-2y-z-2 & =0.\\end{aligned}\n$$"} :step/id #uuid "4426cd88-0ed0-5a8a-bd40-151d1e9d59dd" :step/next {:db/id #edb/ref 17592186419428}} {:db/id #edb/ref 17592186419425 :step/content {:db/id #edb/ref 17592186419421 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "66b70f6a-e851-54e5-aa28-b6a025e9ece5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "57" :db/id #edb/ref 17592186419408}] :answer-field/correct {:db/id #edb/ref 17592186419408} :answer-field/id #uuid "2f1bb041-bd3b-51ec-95b9-ab27a720aff3" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186419416} {:answer-field/choices [{:answer/id #uuid "b0061273-aae7-5a50-ba3b-7dbc44ba608c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186419411}] :answer-field/correct {:db/id #edb/ref 17592186419411} :answer-field/id #uuid "51f6537d-feab-5ce3-9fc6-f89624d037a2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186419418} {:answer-field/choices [{:answer/id #uuid "373d6628-e7af-5c99-8ea7-bda3f45e1294" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186419407}] :answer-field/correct {:db/id #edb/ref 17592186419407} :answer-field/id #uuid "c79424ce-ee00-57d0-b195-b7db6dde7351" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186419420}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "53aad395-ec2e-5a47-9cdb-e404625e4482" :question/math-academy-id "q-330576" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(7,4,-3)$ and is perpendicular to the line \n$\\frac{x-3}{5}=\\frac{y-2}{4}=\\frac{z+1}{-2}.$\n\n{{field-1}}\n$x\\,+4y\\,-$\n{{field-2}}\n$z\\,-$\n{{field-3}}\n$=0$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨7,4,-3⟩.$ From the canonical equation, we find that the line is parallel to the vector $⟨5,4,-2⟩.$ So, the normal vector of the plane is \n\n$$\nn=⟨5,4,-2⟩.\n$$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨5,4,-2⟩ & =⟨7,4,-3⟩\\cdot ⟨5,4,-2⟩ \\\\ r\\cdot ⟨5,4,-2⟩ & =57\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨5,4,-2⟩ & =57 \\\\ 5x+4y-2z & =57 \\\\ 5x+4y-2z-57 & =0.\\end{aligned}\n$$"} :step/id #uuid "62621dfb-b37e-5d44-bdc0-8c2aa74e902d" :step/next {:db/id #edb/ref 17592186419426}} {:db/id #edb/ref 17592186419426 :step/content {:db/id #edb/ref 17592186311671 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43ac71e4-1f43-51f8-bfa4-a92855f4700b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186309261}] :answer-field/correct {:db/id #edb/ref 17592186309261} :answer-field/id #uuid "7faaceec-cd8b-568a-858c-271760090279" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186311144} {:answer-field/choices [{:answer/id #uuid "580b7964-a0b4-59ea-bd21-b56d80484ba8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186309413}] :answer-field/correct {:db/id #edb/ref 17592186309413} :answer-field/id #uuid "93f3390e-533a-5d25-83c0-c5daa77f3ccf" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186311213} {:answer-field/choices [{:answer/id #uuid "0ccc2dae-6d3d-5c97-a2ff-2660720cb731" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5" :db/id #edb/ref 17592186308836}] :answer-field/correct {:db/id #edb/ref 17592186308836} :answer-field/id #uuid "95d0ab30-64b1-59c5-b1be-e3cbd8256de2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186311226}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "04886b81-54da-502a-b95c-1502eb418ce2" :question/math-academy-id "q-336241" :question/problem "Given the Cartesian equation $12y-6z-30=0$ of the plane $Π$, find an equation of $Π$ in the form $(r-p)\\cdot n=0.$\n\n$(r-⟨0,0,$\n{{field-1}}\n$⟩)\\cdot ⟨0,$\n{{field-2}}\n,\n{{field-3}}\n$⟩=0$" :question/worked-solution "First, from the equation of the plane we get that the normal vector of $Π$ is $n=⟨0,12,-6⟩.$\n\nNow, we solve the Cartesian equation of $Π$ for $z$:\n\n$$\n\\begin{aligned}12y-6z-30 & =0 \\\\ -6z & =-12y+30 \\\\ z & =2y-5\\end{aligned}\n$$\n\nIf we put, say, $y=0$, we get $z=-5.$ Hence, the point $P(0,0,-5)$ lies on $Π.$ Note that the position vector of $P$ is $p=⟨0,0,-5⟩.$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ (r-⟨0,0,-5⟩)\\cdot ⟨0,12,-6⟩ & =0.\\end{aligned}\n$$"} :step/id #uuid "6908c1c1-4988-5f64-8e7b-f1732fcb1a7f"} {:db/id #edb/ref 17592186419427 :step/content {:db/id #edb/ref 17592186419423 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "102de1fa-9039-5418-a721-6fc419237fc4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x+5y+8z+9=0" :db/id #edb/ref 17592186419404} {:answer/id #uuid "90536ec6-2590-5af2-a702-9be2e4b1ecdc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x+8y+5z+6=0" :db/id #edb/ref 17592186419409} {:answer/id #uuid "c7f81252-3be5-5daa-a718-63070020d187" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x-5y+8z+7=0" :db/id #edb/ref 17592186419413} {:answer/id #uuid "c8ca9437-ca61-5c50-96e0-f167dfcd51fe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x+5y-8z+11=0" :db/id #edb/ref 17592186419414} {:answer/id #uuid "d6eccb3f-c3a2-58a8-b47e-683c853ab3af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x+5y+9z+15=0" :db/id #edb/ref 17592186419415}] :answer-field/correct {:db/id #edb/ref 17592186419404} :answer-field/id #uuid "34e50549-8287-5dd0-82ee-b77b6017695a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186419417}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e08b1f6c-36a3-5d41-8737-49d26e8563c5" :question/math-academy-id "q-128459" :question/problem "Find a Cartesian equation of the plane that passes through the points $A(1,-2,0)$, $P(3,-4,1)$ and $Q(2,1,-2).$" :question/worked-solution "Note that the position vectors of the points $A,P$ and $Q$ are $a=⟨1,-2,0⟩,\\,p=⟨3,-4,1⟩,$ and $q=⟨2,1,-2⟩.$\n\nFirst, using the $3$ points we build $2$ vectors parallel to the plane:\n\n$$\n\\begin{aligned}{v}_{1} & =\\overset{\\to }{AP} \\\\  & =⟨3,-4,1⟩-⟨1,-2,0⟩ \\\\  & =⟨2,-2,1⟩ \\\\ {v}_{2} & =\\overset{\\to }{AQ} \\\\  & =⟨2,1,-2⟩-⟨1,-2,0⟩ \\\\  & =⟨1,3,-2⟩\\end{aligned}\n$$\n\n \n\nNow, we need to find the normal vector of the plane. To do that, we use the cross product of ${v}_{1}$ and ${v}_{2}$ as follows:\n\n$$\n\\begin{aligned}n & ={v}_{1}\\times {v}_{2} \\\\  & =[\\begin{aligned}2 \\\\ -2 \\\\ 1\\end{aligned}]\\times [\\begin{aligned}1 \\\\ 3 \\\\ -2\\end{aligned}] \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 2 & -2 & 1 \\\\ 1 & 3 & -2\\end{aligned}\\right| \\\\  & =i+5j+8k \\\\  & =⟨1,5,8⟩\\end{aligned}\n$$\n\nThen, using the dot product, we can find the equation of the plane:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨1,5,8⟩ & =⟨3,-4,1⟩\\cdot ⟨1,5,8⟩ \\\\ r\\cdot ⟨1,5,8⟩ & =-9\\end{aligned}\n$$\n\nFinally, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨1,5,8⟩ & =-9 \\\\ x+5y+8z & =-9 \\\\ x+5y+8z+9 & =0.\\end{aligned}\n$$"} :step/id #uuid "6d308039-35f2-59e5-b262-324c1a8c2bf2" :step/next {:db/id #edb/ref 17592186419425}} {:db/id #edb/ref 17592186419428 :step/content {:db/id #edb/ref 17592186262889 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f87268c-9742-5090-b7cb-521a5d8bbe66" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(r-⟨0,0,1⟩)\\cdot ⟨2,4,-4⟩=0" :db/id #edb/ref 17592186260021} {:answer/id #uuid "a390ff13-0937-5eb3-b38b-3df5883b8889" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(r-⟨0,0,-2⟩)\\cdot ⟨-4,4,-2⟩=0" :db/id #edb/ref 17592186261300} {:answer/id #uuid "def43d7d-583f-5acb-a4e0-a37562571a5c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(r-⟨0,0,0⟩)\\cdot ⟨4,-2,4⟩=0" :db/id #edb/ref 17592186261844} {:answer/id #uuid "f4c13bd5-c05b-5f70-93b5-0ba177da222f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(r-⟨0,0,0⟩)\\cdot ⟨4,4,-2⟩=0" :db/id #edb/ref 17592186262013} {:answer/id #uuid "ffcc7a65-376c-57d0-ac3e-a501019e18ce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(r-⟨0,0,2⟩)\\cdot ⟨4,4,2⟩=0" :db/id #edb/ref 17592186262119}] :answer-field/correct {:db/id #edb/ref 17592186262013} :answer-field/id #uuid "7b80e560-2ad7-58b7-9b2c-28eb67acbc7c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186262329}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0f6aca53-4308-58bc-afcc-f2738d69d1e0" :question/math-academy-id "q-128380" :question/problem "Given the Cartesian equation $4x+4y-2z=0$ of the plane $Π$, find an equation of $Π$ in the form $(r-p)\\cdot n=0.$" :question/worked-solution "First, from the equation of the plane we get that the normal vector of $Π$ is $n=⟨4,4,-2⟩.$\n\nNow, we solve the Cartesian equation of $Π$ for $z$:\n\n$$\n\\begin{aligned}4x+4y-2z & =0 \\\\ 2z & =4x+4y \\\\ z & =2x+2y.\\end{aligned}\n$$\n\nIf we put, say, $x=0$ and $y=0$, we get $z=0.$ Hence, the point $P(0,0,0)$ lies on $Π.$ Note that the position vector of $P$ is $p=⟨0,0,0⟩.$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ (r-⟨0,0,0⟩)\\cdot ⟨4,4,-2⟩ & =0.\\end{aligned}\n$$"} :step/id #uuid "c018d688-d281-50de-9674-51b7847b124c" :step/next {:db/id #edb/ref 17592186419427}}] :activity/title "The Cartesian Equation of a Plane" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186419402}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186423962} :activity/id #uuid "2e339301-4273-5fe3-adcf-f9263b991a91" :activity/scope {:db/id #edb/ref 17592186050830 :topic/id #uuid "6a093d52-40f2-54b8-8982-db428e58bab5" :topic/math-academy-id 1807} :activity/steps [{:db/id #edb/ref 17592186423961 :step/content {:db/id #edb/ref 17592186338833 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10191765-520e-51b1-b616-6aed299a1951" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x+3y=0" :db/id #edb/ref 17592186336181} {:answer/id #uuid "7daf1c63-6468-51ad-b441-f7fb571f725e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x-3z+4=0" :db/id #edb/ref 17592186337169} {:answer/id #uuid "ba9bfc06-e53d-546a-8e5c-41d1b1999a5a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x-2y-4=0" :db/id #edb/ref 17592186337685} {:answer/id #uuid "c52efad2-ab20-5349-b4af-05ecdf7d704d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z-4=0" :db/id #edb/ref 17592186337785} {:answer/id #uuid "f09bbdc2-0929-5b68-b7a0-f2e4bd00ad0d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x+3y-4=0" :db/id #edb/ref 17592186338137}] :answer-field/correct {:db/id #edb/ref 17592186338137} :answer-field/id #uuid "6f92cb71-8832-51de-ba25-618de4d73dc2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186338468}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ee138f11-2a9e-5208-a49a-f5a947f6c08b" :question/math-academy-id "q-70833" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(2,0,-3)$ and is parallel to the vectors ${v}_{1}=⟨-3,2,0⟩$ and ${v}_{2}=⟨0,0,1⟩.$" :question/worked-solution "First, we note that the position vector of the point $P$ is $p=⟨2,0,-3⟩.$\n\nNow, we need to find the normal vector of the plane. To do that, we use the cross product of ${v}_{1}$ and ${v}_{2}$ as follows:\n\n$$\n\\begin{aligned}n & ={v}_{1}\\times {v}_{2} \\\\  & =[\\begin{aligned}-3 \\\\ 2 \\\\ 0\\end{aligned}]\\times [\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}] \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ -3 & 2 & 0 \\\\ 0 & 0 & 1\\end{aligned}\\right| \\\\  & =2i+3j \\\\  & =⟨2,3,0⟩\\end{aligned}\n$$\n\nThen, using the dot product, we can find the equation of the plane:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨2,3,0⟩ & =⟨2,0,-3⟩\\cdot ⟨2,3,0⟩ \\\\ r\\cdot ⟨2,3,0⟩ & =4\\end{aligned}\n$$\n\nFinally, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨2,3,0⟩ & =4 \\\\ 2x+3y & =4 \\\\ 2x+3y-4 & =0.\\end{aligned}\n$$"} :step/id #uuid "24b7f863-ce6a-5264-b6ec-ac8e65ecdb05"} {:db/id #edb/ref 17592186423962 :step/content {:db/id #edb/ref 17592186120233 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0395970e-0d9a-5762-bb5c-e46f2d38b8c0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x-y-5z+11=0" :db/id #edb/ref 17592186423949} {:answer/id #uuid "4b65c837-ece2-5b2d-a1d6-63cd8cc028b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x+3y-7=0" :db/id #edb/ref 17592186423953} {:answer/id #uuid "5e5c8545-4573-5ed8-bdbb-b47cb8a05b58" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x+3y-1=0" :db/id #edb/ref 17592186423954} {:answer/id #uuid "a9e87eac-968b-5331-95b6-4aa94e8c328b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2y+z+7=0" :db/id #edb/ref 17592186423956} {:answer/id #uuid "c2a52ec1-f084-5a8c-880c-5ed843166cc3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x-y-5z+7=0" :db/id #edb/ref 17592186423958}] :answer-field/correct {:db/id #edb/ref 17592186423958} :answer-field/id #uuid "cc839475-9e1b-518e-9233-6715536351ec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186117557}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e3a2e450-d136-5240-a920-568065ef68bb" :question/math-academy-id "q-33146" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(0,2,1)$ and is perpendicular to the line \n$\\frac{x-1}{-2}=\\frac{y-3}{1}=\\frac{z}{5}.$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨0,2,1⟩.$ From the canonical equation, we find that the line is parallel to the vector $⟨-2,1,5⟩.$ So, the normal vector of the plane is \n\n$$\nn=⟨-2,1,5⟩.\n$$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨-2,1,5⟩ & =⟨0,2,1⟩\\cdot ⟨-2,1,5⟩ \\\\ r\\cdot ⟨-2,1,5⟩ & =7\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨-2,1,5⟩ & =7 \\\\ -2x+y+5z & =7 \\\\ -2x+y+5z-7 & =0 \\\\ 2x-y-5z+7 & =0.\\end{aligned}\n$$"} :step/id #uuid "3d11e9af-f90d-5fbe-a96b-a527fdd70135" :step/next {:db/id #edb/ref 17592186423963}} {:db/id #edb/ref 17592186423963 :step/content {:db/id #edb/ref 17592186423960 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13bd6234-56f6-541c-bfc5-f390a8cb5bfa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(r-⟨0,0,0⟩)\\cdot ⟨3,-2,1⟩=0" :db/id #edb/ref 17592186423950} {:answer/id #uuid "1d1ce09d-4b43-5ecf-b718-dbc33ca70dc2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(r-⟨0,0,0⟩)\\cdot ⟨1,2,3⟩=0" :db/id #edb/ref 17592186423951} {:answer/id #uuid "2c57426d-3447-5790-bc09-7f27391e4e89" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(r-⟨0,0,3⟩)\\cdot ⟨1,-2,3⟩=0" :db/id #edb/ref 17592186423952} {:answer/id #uuid "95f99c20-a235-5660-8d6b-b04b727483d7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(r-⟨0,0,0⟩)\\cdot ⟨1,-2,3⟩=0" :db/id #edb/ref 17592186423955} {:answer/id #uuid "b1292071-77e9-579a-8b2f-0a1e4da37f19" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(r-⟨0,0,\\frac{1}{3}⟩)\\cdot ⟨1,-2,3⟩=0" :db/id #edb/ref 17592186423957}] :answer-field/correct {:db/id #edb/ref 17592186423955} :answer-field/id #uuid "0fa9de33-9d04-55cd-94a1-cecb483c4e8f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186423959}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e005b4ab-002a-57d1-b9b7-3fc85eeb395f" :question/math-academy-id "q-70819" :question/problem "Given the Cartesian equation $x-2y+3z=0$ of the plane $Π$, find an equation of $Π$ in the form $(r-p)\\cdot n=0.$" :question/worked-solution "First, from the equation of the plane we get that the normal vector of $Π$ is $n=⟨1,-2,3⟩.$\n\nNow, we solve the Cartesian equation of $Π$ for $z$:\n\n$$\n\\begin{aligned}x-2y+3z & =0 \\\\ 3z & =-x+2y \\\\ z & =-\\frac{1}{3}x+\\frac{2}{3}y.\\end{aligned}\n$$\n\nIf we put, say, $x=0$ and $y=0$, we get $z=0.$ Hence, the point $P(0,0,0)$ lies on $Π.$ Note that the position vector of $P$ is $p=⟨0,0,0⟩.$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ (r-⟨0,0,0⟩)\\cdot ⟨1,-2,3⟩ & =0.\\end{aligned}\n$$"} :step/id #uuid "eee37068-88fb-59e1-930d-db5693058840" :step/next {:db/id #edb/ref 17592186423961}}] :activity/title "The Cartesian Equation of a Plane" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186423948}]}
