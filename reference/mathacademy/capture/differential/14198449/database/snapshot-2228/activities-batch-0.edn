#{[{:activity/expected-seconds 840.0 :activity/first-step {:db/id #edb/ref 17592186162964} :activity/id #uuid "5e1abfbf-6305-5be0-9393-a812bd1f7fea" :activity/scope {:db/id #edb/ref 17592186049812 :topic/id #uuid "1599ff71-6ac6-594e-a9d9-6e787e12bce6" :topic/math-academy-id 3009} :activity/steps [{:db/id #edb/ref 17592186162964 :step/content {:db/id #edb/ref 17592186163271 :tutorial/content "Let $X_1$ and $X_2$ be *independent* random variables that are normally distributed with\n\n$$\nX_1\\sim N(\\mu_1, \\sigma_1^2), \\qquad X_2\\sim N(\\mu_2, \\sigma_2^2).\n$$\n\nWe can show that the random variable $Y = X_1\\pm X_2$ is normally distributed, and\n\n$$\nY =  X_1\\pm X_2 \\sim N(\\mu_1\\pm\\mu_2, \\sigma_1^2+\\sigma_2^2).\n$$\n\nWe'll prove this in a separate lesson.\n\nFor example, if $X_1\\sim N(2,3)$ and $X_2\\sim  N(1,4)$ are independent, then \n\n$$\n\\begin{aligned}{X}_{1}+{X}_{2} & ∼N(2+1,3+4)∼N(3,7),\\end{aligned}\n$$\n\n \n\nand\n\n$$\n\\begin{aligned}{X}_{1}-{X}_{2} & ∼N(2-1,3+4)∼N(1,7).\\end{aligned}\n$$\n\n \n\nWhen computing a sum or difference of normal random variables, there are a few things to watch out for:\n\n- Firstly, when we compute the distribution of a *difference*, we subtract the means, but *add* the variances!\n\n- Secondly, it is vital to check that $X_1$ and $X_2$ are independent. Cases where $X_1$ and $X_2$ are *dependent* will be dealt with in future lessons." :tutorial/id #uuid "081629c5-dd0b-5541-b151-16f392fb9a31" :tutorial/math-academy-id 5442 :tutorial/title "Introduction"} :step/id #uuid "1f2e7312-035a-58f0-a5f4-a7a2cb453deb" :step/math-academy-id 33902 :step/next {:db/id #edb/ref 17592186162970}} {:db/id #edb/ref 17592186162970 :step/content {:db/id #edb/ref 17592186162055 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161855 :question/id #uuid "e100670a-00a3-5b89-a454-aef34af2caac" :question/math-academy-id "e-9103"} :knowledge-point/id #uuid "c4cac2a0-2591-548f-ba83-1c55554eb499" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048615} {:db/id #edb/ref 17592186049412} {:db/id #edb/ref 17592186049815}] :knowledge-point/questions [{:db/id #edb/ref 17592186162270} {:db/id #edb/ref 17592186162289} {:db/id #edb/ref 17592186496259} {:db/id #edb/ref 17592186496260} {:db/id #edb/ref 17592186496285} {:db/id #edb/ref 17592186496327}] :knowledge-point/title "Finding the Distribution of a Sum or Difference of Normal Random Variables"} :step/id #uuid "b6d57cdd-23b8-5334-ab35-b2d652c0c0d2" :step/math-academy-id 33933 :step/next {:db/id #edb/ref 17592186163003}} {:db/id #edb/ref 17592186162978 :step/content {:db/id #edb/ref 17592186162059 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161859 :question/id #uuid "934c72e0-0fa3-55db-955a-eae8d546315e" :question/math-academy-id "e-9117"} :knowledge-point/id #uuid "06dabd63-8400-57cb-8978-54f0b4640759" :knowledge-point/questions [{:db/id #edb/ref 17592186162261} {:db/id #edb/ref 17592186162271} {:db/id #edb/ref 17592186496222} {:db/id #edb/ref 17592186496225} {:db/id #edb/ref 17592186496254} {:db/id #edb/ref 17592186496291}] :knowledge-point/title "Finding the Distribution of a Sum or Difference of Scaled Normal Random Variables"} :step/id #uuid "e329fb62-17bf-50ce-9656-dcfb745d9da2" :step/math-academy-id 33983 :step/next {:db/id #edb/ref 17592186162979}} {:db/id #edb/ref 17592186162979 :step/content {:db/id #edb/ref 17592186162060 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161860 :question/id #uuid "744539e8-4bb1-57c4-acaf-ed8da68650bd" :question/math-academy-id "e-9118"} :knowledge-point/id #uuid "4358607d-b068-5dd9-8b35-46dc6bcecd1a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050116}] :knowledge-point/questions [{:db/id #edb/ref 17592186162272} {:db/id #edb/ref 17592186162290} {:db/id #edb/ref 17592186496267} {:db/id #edb/ref 17592186496278} {:db/id #edb/ref 17592186496316} {:db/id #edb/ref 17592186496332}] :knowledge-point/title "Calculating a Probability Involving a Sum or Difference of Normally Distributed Random Variables"} :step/id #uuid "c790b092-ebdf-54f1-8b69-54a1a21f5eb3" :step/math-academy-id 33986 :step/next {:db/id #edb/ref 17592186162980}} {:db/id #edb/ref 17592186162980 :step/content {:db/id #edb/ref 17592186162061 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161861 :question/id #uuid "0f84847c-0ffd-573b-ac60-c7ab7633b6ea" :question/math-academy-id "e-9119"} :knowledge-point/id #uuid "22f7e940-b159-5d68-8ce4-d33f4a2f6907" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050198}] :knowledge-point/questions [{:db/id #edb/ref 17592186162273} {:db/id #edb/ref 17592186162297} {:db/id #edb/ref 17592186496228} {:db/id #edb/ref 17592186496268} {:db/id #edb/ref 17592186496301} {:db/id #edb/ref 17592186496325}] :knowledge-point/title "Calculating a Probability Involving a Sum or Difference of Normally Distributed Random Variables in Context"} :step/id #uuid "271cebaa-3f3c-5886-aecd-e3ab160bb06b" :step/math-academy-id 33988} {:db/id #edb/ref 17592186163003 :step/content {:db/id #edb/ref 17592186163285 :tutorial/content "If $X_1\\sim N(\\mu_1, \\sigma_1^2)$ and $X_2\\sim N(\\mu_2, \\sigma_2^2)$ are *independent* random variables and $a$ and $b$ are constants, we have\n\n$$\naX_1+bX_2\\sim N(a\\mu_1+b\\mu_2, a^2\\sigma^2_1+b^2\\sigma^2_2).\n$$\n\nFor example, if $X_1\\sim N(2,3)$ and $X_2\\sim  N(1,4)$ are independent, then \n\n$$\n\\begin{aligned}2{X}_{1}+3{X}_{2} & ∼N(2\\cdot 2+3\\cdot 1,{2}^{2}\\cdot 3+{3}^{2}\\cdot 4) \\\\  & ∼N(4+3,4\\cdot 3+9\\cdot 4) \\\\  & ∼N(7,48),\\end{aligned}\n$$\n\n \n\nand\n\n$$\n\\begin{aligned}2{X}_{1}-3{X}_{2} & ∼N(2\\cdot 2+(-3)\\cdot 1,{2}^{2}\\cdot 3+{3}^{2}\\cdot 4) \\\\  & ∼N(4-3,4\\cdot 3+9\\cdot 4) \\\\  & ∼N(1,48).\\end{aligned}\n$$" :tutorial/id #uuid "e34c3ff4-0506-5301-a7a5-0d4eea0a0ed0" :tutorial/math-academy-id 5523 :tutorial/title "Finding a Sum or Difference of Scaled Normal Random Variables"} :step/id #uuid "7ac39654-356a-5d2e-b561-f1ca3ba76bcb" :step/math-academy-id 34366 :step/next {:db/id #edb/ref 17592186162978}}] :activity/title "Combining Two Normally Distributed Random Variables" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186162166}]}
