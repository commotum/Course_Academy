86045417] [17592186050372 #edb/ref 1035 #uuid "43f7df3c-d8d4-556e-9f46-8a4092e26bff" #edb/ref 17592186045417] [17592186050980 #edb/ref 1028 #edb/ref 17592186221355 #edb/ref 17592186045417] [17592186050980 #edb/ref 1028 #edb/ref 17592186221356 #edb/ref 17592186045417] [17592186050980 #edb/ref 1028 #edb/ref 17592186221357 #edb/ref 17592186045417] [17592186050980 #edb/ref 1031 "General Equations of Circles in the Coordinate Plane" #edb/ref 17592186045417] [17592186050980 #edb/ref 1033 6451 #edb/ref 17592186045417] [17592186050980 #edb/ref 1035 #uuid "76c7b01d-502d-5cca-a93b-a9d238fc24ca" #edb/ref 17592186045417] [17592186077996 #edb/ref 1075 #edb/ref 17592186432208 #edb/ref 17592186045417] [17592186077996 #edb/ref 1075 #edb/ref 17592186432216 #edb/ref 17592186045417] [17592186077996 #edb/ref 1075 #edb/ref 17592186432217 #edb/ref 17592186045417] [17592186077996 #edb/ref 1075 #edb/ref 17592186432221 #edb/ref 17592186045417] [17592186077996 #edb/ref 1075 #edb/ref 17592186432224 #edb/ref 17592186045417] [17592186077996 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186077996 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186077996 #edb/ref 1078 #edb/ref 17592186432217 #edb/ref 17592186045417] [17592186077996 #edb/ref 1079 #uuid "0135309d-4571-5e4f-b373-ceb7b0682c4e" #edb/ref 17592186045417] [17592186078247 #edb/ref 1069 "e-3228" #edb/ref 17592186045417] [17592186078247 #edb/ref 1071 "Find the center and radius of the circle whose equation is $x^2 + y^2 - 4x + 6y = 12.$" #edb/ref 17592186045417] [17592186078247 #edb/ref 1072 #uuid "36c32777-8081-5431-a112-321738a3adab" #edb/ref 17592186045417] [17592186078247 #edb/ref 1074 "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}-4x+6y & =12 \\\\ ({x}^{2}-4x)+({y}^{2}+6y) & =12 \\\\ ({x}^{2}-2\\cdot 2x+{2}^{2})+({y}^{2}+2\\cdot 3y+{3}^{2}) & =12+{2}^{2}+{3}^{2} \\\\ ({x}^{2}-2\\cdot 2x+{2}^{2})+({y}^{2}+2\\cdot 3y+{3}^{2}) & =25\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x-2)^{2}+(y+3)^{2} & ={5}^{2} \\\\ (x-2)^{2}+(y-(-3))^{2} & ={5}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(2,-3)$ and its radius is $5.$" #edb/ref 17592186045417] [17592186078248 #edb/ref 1069 "e-3229" #edb/ref 17592186045417] [17592186078248 #edb/ref 1071 "Find the center and radius of the circle whose equation is $x^2 + y^2 - x  = 6.$" #edb/ref 17592186045417] [17592186078248 #edb/ref 1072 #uuid "b05d1090-fd7b-52eb-84a7-55377ead0dda" #edb/ref 17592186045417] [17592186078248 #edb/ref 1074 "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}-x & =6 \\\\ ({x}^{2}-x)+{y}^{2} & =6 \\\\ ({x}^{2}-2\\cdot \\frac{1}{2}x+{(\\frac{1}{2})}^{2})+{y}^{2} & =6+{(\\frac{1}{2})}^{2} \\\\ ({x}^{2}-2\\cdot \\frac{1}{2}x+{(\\frac{1}{2})}^{2})+{y}^{2} & =\\frac{25}{4}\\end{aligned}\n$$\n\nNow, we can factor the perfect square and get\n\n$$\n\\begin{aligned}{(x-\\frac{1}{2})}^{2}+{y}^{2} & ={(\\frac{5}{2})}^{2} \\\\ {(x-\\frac{1}{2})}^{2}+(y-0)^{2} & ={(\\frac{5}{2})}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $\\left(\\dfrac{1}{2}, 0 \\right)$ and its radius is $\\dfrac{5}{2}.$" #edb/ref 17592186045417] [17592186078390 #edb/ref 1037 #edb/ref 17592186049570 #edb/ref 17592186045417] [17592186078390 #edb/ref 1037 #edb/ref 17592186050372 #edb/ref 17592186045417] [17592186078390 #edb/ref 1038 #edb/ref 17592186079061 #edb/ref 17592186045417] [17592186078390 #edb/ref 1038 #edb/ref 17592186079065 #edb/ref 17592186045417] [17592186078390 #edb/ref 1038 #edb/ref 17592186275313 #edb/ref 17592186045417] [17592186078390 #edb/ref 1038 #edb/ref 17592186275326 #edb/ref 17592186045417] [17592186078390 #edb/ref 1038 #edb/ref 17592186275328 #edb/ref 17592186045417] [17592186078390 #edb/ref 1038 #edb/ref 17592186275329 #edb/ref 17592186045417] [1759218607839