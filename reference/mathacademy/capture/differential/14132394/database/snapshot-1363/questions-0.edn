#{[{:db/id #edb/ref 17592186078247 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186078390 :knowledge-point/id #uuid "697f9bd8-9edf-5643-8cdb-a821b6dce09c" :knowledge-point/title "Finding the Center and Radius of a Circle by Completing the Square"}] :question/id #uuid "36c32777-8081-5431-a112-321738a3adab" :question/math-academy-id "e-3228" :question/problem "Find the center and radius of the circle whose equation is $x^2 + y^2 - 4x + 6y = 12.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}-4x+6y & =12 \\\\ ({x}^{2}-4x)+({y}^{2}+6y) & =12 \\\\ ({x}^{2}-2\\cdot 2x+{2}^{2})+({y}^{2}+2\\cdot 3y+{3}^{2}) & =12+{2}^{2}+{3}^{2} \\\\ ({x}^{2}-2\\cdot 2x+{2}^{2})+({y}^{2}+2\\cdot 3y+{3}^{2}) & =25\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x-2)^{2}+(y+3)^{2} & ={5}^{2} \\\\ (x-2)^{2}+(y-(-3))^{2} & ={5}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(2,-3)$ and its radius is $5.$"}] [{:db/id #edb/ref 17592186078248 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186078391 :knowledge-point/id #uuid "98e3f3b4-8dfa-515c-90b1-09fb19d68144" :knowledge-point/title "Finding the Center and Radius of a Circle by Completing the Square with Fractions"}] :question/id #uuid "b05d1090-fd7b-52eb-84a7-55377ead0dda" :question/math-academy-id "e-3229" :question/problem "Find the center and radius of the circle whose equation is $x^2 + y^2 - x  = 6.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}-x & =6 \\\\ ({x}^{2}-x)+{y}^{2} & =6 \\\\ ({x}^{2}-2\\cdot \\frac{1}{2}x+{(\\frac{1}{2})}^{2})+{y}^{2} & =6+{(\\frac{1}{2})}^{2} \\\\ ({x}^{2}-2\\cdot \\frac{1}{2}x+{(\\frac{1}{2})}^{2})+{y}^{2} & =\\frac{25}{4}\\end{aligned}\n$$\n\nNow, we can factor the perfect square and get\n\n$$\n\\begin{aligned}{(x-\\frac{1}{2})}^{2}+{y}^{2} & ={(\\frac{5}{2})}^{2} \\\\ {(x-\\frac{1}{2})}^{2}+(y-0)^{2} & ={(\\frac{5}{2})}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $\\left(\\dfrac{1}{2}, 0 \\right)$ and its radius is $\\dfrac{5}{2}.$"}] [{:db/id #edb/ref 17592186238072 :knowledge-point/_questions [{:db/id #edb/ref 17592186078391 :knowledge-point/id #uuid "98e3f3b4-8dfa-515c-90b1-09fb19d68144" :knowledge-point/title "Finding the Center and Radius of a Circle by Completing the Square with Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "921a2627-ec10-5d1e-8639-eef8fd7f3342" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(0,-\\frac{1}{2})$, radius: $\\frac{3}{4}$" :db/id #edb/ref 17592186236745} {:answer/id #uuid "9fb55b6d-6427-54d7-925a-0d7d4383ae68" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(0,\\frac{1}{4})$, radius: $\\sqrt{\\frac{3}{4}}$" :db/id #edb/ref 17592186236813} {:answer/id #uuid "b365be51-4d65-5928-9f90-0629516c1e8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(0,-\\frac{1}{4})$, radius: $\\frac{3}{4}$" :db/id #edb/ref 17592186236953} {:answer/id #uuid "b865178d-d257-5526-bfc0-ea89da1ca0eb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(0,\\frac{1}{4})$, radius: $\\frac{3}{4}$" :db/id #edb/ref 17592186236995} {:answer/id #uuid "c9d0e896-c4c4-58e2-a331-79ea27bb0deb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(0,\\frac{1}{2})$, radius: $\\sqrt{\\frac{3}{4}}$" :db/id #edb/ref 17592186237098}] :answer-field/correct {:answer/id #uuid "b865178d-d257-5526-bfc0-ea89da1ca0eb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(0,\\frac{1}{4})$, radius: $\\frac{3}{4}$" :db/id #edb/ref 17592186236995} :answer-field/id #uuid "94b4f34f-41d5-5588-8d90-691adc493613" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237636}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f6a657b9-6edf-5ed4-a2a2-a0a7062d8da7" :question/math-academy-id "q-103896" :question/problem "Find the radius and center of the circle whose equation is\n${x}^{2}+{y}^{2}-\\frac{1}{2}y=\\frac{1}{2}.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}-\\frac{1}{2}y & =\\frac{1}{2} \\\\ {x}^{2}+({y}^{2}-\\frac{1}{2}y) & =\\frac{1}{2} \\\\ {x}^{2}+({y}^{2}-2\\cdot \\frac{1}{4}y+{(\\frac{1}{4})}^{2}) & ={(\\frac{1}{4})}^{2}+\\frac{1}{2} \\\\ {x}^{2}+({y}^{2}-2\\cdot \\frac{1}{4}y+{(\\frac{1}{4})}^{2}) & =\\frac{9}{16}\\end{aligned}\n$$\n\nNow, we can factor the perfect square and get\n\n$$\n\\begin{aligned}{x}^{2}+{(y-\\frac{1}{4})}^{2} & ={(\\frac{3}{4})}^{2} \\\\ (x-0)^{2}+{(y-\\frac{1}{4})}^{2} & ={(\\frac{3}{4})}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(0,\\frac{1}{4})$ and its radius is $\\frac{3}{4}.$"}] [{:db/id #edb/ref 17592186396073 :knowledge-point/_questions [{:db/id #edb/ref 17592186078390 :knowledge-point/id #uuid "697f9bd8-9edf-5643-8cdb-a821b6dce09c" :knowledge-point/title "Finding the Center and Radius of a Circle by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "74e6273a-f318-5c34-a052-af10236b8229" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(1,5)$, radius: $3$" :db/id #edb/ref 17592186396075} {:answer/id #uuid "6ef4fb82-ea8e-583d-9771-d8277b4a76da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(-1,5)$, radius: $9$" :db/id #edb/ref 17592186396076} {:answer/id #uuid "c6be1a14-c6c9-582a-8aa6-d933eeef50a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(5,-1)$, radius: $7$" :db/id #edb/ref 17592186396077} {:answer/id #uuid "ecbea558-c9ab-5f89-80f4-8cdcb2e0f681" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(-5,1)$, radius: $4$" :db/id #edb/ref 17592186396078} {:answer/id #uuid "91bca4ac-a533-50cd-b79b-78e54b58a746" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(-1,-5)$, radius: $9$" :db/id #edb/ref 17592186396079}] :answer-field/correct {:answer/id #uuid "6ef4fb82-ea8e-583d-9771-d8277b4a76da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(-1,5)$, radius: $9$" :db/id #edb/ref 17592186396076} :answer-field/id #uuid "de4e6f08-aad0-5add-9bc8-7a4631ad1e27" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396074}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bf1d8b4a-8091-5076-a3c1-f3d77fa5e29a" :question/math-academy-id "q-15460" :question/problem "Find the center and radius of the circle whose equation is ${x}^{2}+2x+{y}^{2}=55+10y.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+2x+{y}^{2} & =55+10y \\\\ ({x}^{2}+2x)+({y}^{2}-10y) & =55 \\\\ ({x}^{2}+2\\cdot x+{1}^{2})+({y}^{2}-2\\cdot 5y+{5}^{2}) & =55+{1}^{2}+{5}^{2} \\\\ ({x}^{2}+2\\cdot x+{1}^{2})+({y}^{2}-2\\cdot 5y+{5}^{2}) & =81\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x+1)^{2}+(y-5)^{2} & ={9}^{2} \\\\ (x-(-1))^{2}+(y-5)^{2} & ={9}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(-1,5)$ and its radius is $9.$"}] [{:db/id #edb/ref 17592186432243 :knowledge-point/_questions [{:db/id #edb/ref 17592186078390 :knowledge-point/id #uuid "697f9bd8-9edf-5643-8cdb-a821b6dce09c" :knowledge-point/title "Finding the Center and Radius of a Circle by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c4c2640-0a36-56ec-af1b-fcad7796bf52" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(2,0)$, radius: $4$" :db/id #edb/ref 17592186432205} {:answer/id #uuid "4b6a21d8-b231-54b8-835d-bbc866e009e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(0,-2)$, radius: $4$" :db/id #edb/ref 17592186432206} {:answer/id #uuid "9ce3603d-5b4a-5dda-a1c9-233c3000b216" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(-2,0)$, radius: $4$" :db/id #edb/ref 17592186432220} {:answer/id #uuid "edcde0e6-477c-5745-bf5a-2a31b797aad2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(0,2)$, radius: $4$" :db/id #edb/ref 17592186432232} {:answer/id #uuid "fabd3cfd-ff6d-5a4a-a418-e152dd3aff14" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(2,-2)$, radius: $4$" :db/id #edb/ref 17592186432233}] :answer-field/correct {:answer/id #uuid "4b6a21d8-b231-54b8-835d-bbc866e009e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(0,-2)$, radius: $4$" :db/id #edb/ref 17592186432206} :answer-field/id #uuid "0a922d1e-3efd-542e-bef1-bfc418bd95bf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186432235}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1da6dc7e-65e3-5087-87df-4fd7079a93cd" :question/math-academy-id "q-15464" :question/problem "Find the center and radius of the circle whose equation is ${x}^{2}+{y}^{2}+4y=12.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}+4y & =12 \\\\ {x}^{2}+({y}^{2}+4y) & =12 \\\\ {x}^{2}+({y}^{2}+2\\cdot 2y+{2}^{2}) & =12+{2}^{2} \\\\ {x}^{2}+({y}^{2}+2\\cdot 2y+{2}^{2}) & =16\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x-0)^{2}+(y+2)^{2} & ={4}^{2} \\\\ (x-0)^{2}+(y-(-2))^{2} & ={4}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(0,-2)$ and its radius is $4.$"}] [{:db/id #edb/ref 17592186432244 :knowledge-point/_questions [{:db/id #edb/ref 17592186078390 :knowledge-point/id #uuid "697f9bd8-9edf-5643-8cdb-a821b6dce09c" :knowledge-point/title "Finding the Center and Radius of a Circle by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "154e2e8b-b004-5fd6-a8af-0795c8960483" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(0,-1)$, radius: $9$" :db/id #edb/ref 17592186432201} {:answer/id #uuid "7e4b8669-6cf3-5213-ae28-795579f30a2a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(-1,0)$, radius: $4$" :db/id #edb/ref 17592186432213} {:answer/id #uuid "81717722-81c3-5f14-8952-c1d23e5092e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(0,1)$, radius: $7$" :db/id #edb/ref 17592186432214} {:answer/id #uuid "e0870e71-30f3-54e9-bb11-425115745529" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(1,0)$, radius: $9$" :db/id #edb/ref 17592186432230} {:answer/id #uuid "e800b37d-a48c-5fa3-b18c-a1c109867cd2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(-1,1)$, radius: $9$" :db/id #edb/ref 17592186432231}] :answer-field/correct {:answer/id #uuid "e0870e71-30f3-54e9-bb11-425115745529" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(1,0)$, radius: $9$" :db/id #edb/ref 17592186432230} :answer-field/id #uuid "475d7cd0-eeb5-57a4-b7c2-c1eef8977b26" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186432237}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3d51e7e2-42da-5029-94ba-a383fb96ca48" :question/math-academy-id "q-15466" :question/problem "Find the center and radius of the circle whose equation is ${x}^{2}-2x+{y}^{2}=80.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}-2x+{y}^{2} & =80 \\\\ ({x}^{2}-2x)+{y}^{2} & =80 \\\\ ({x}^{2}-2\\cdot x+{1}^{2})+{y}^{2} & =80+{1}^{2} \\\\ ({x}^{2}-2\\cdot x+{1}^{2})+{y}^{2} & =81\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x-1)^{2}+{y}^{2} & ={9}^{2} \\\\ (x-1)^{2}+(y-0)^{2} & ={9}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(1,0)$ and its radius is $9.$"}] [{:db/id #edb/ref 17592186432245 :knowledge-point/_questions [{:db/id #edb/ref 17592186078390 :knowledge-point/id #uuid "697f9bd8-9edf-5643-8cdb-a821b6dce09c" :knowledge-point/title "Finding the Center and Radius of a Circle by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d6171a8-6197-560d-8edc-2b5e80c6ce81" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(6,8)$, radius: $11$" :db/id #edb/ref 17592186432200} {:answer/id #uuid "16f43589-ba4b-5fe3-b651-27dcee807b31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(-12,-16)$, radius: $21$" :db/id #edb/ref 17592186432202} {:answer/id #uuid "9896f873-fcd7-5d43-8b83-249941df2b11" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(6,8)$, radius: $21$" :db/id #edb/ref 17592186432219} {:answer/id #uuid "cd5d7134-54b8-5fbc-9070-2f312605b654" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(12,16)$, radius: $21$" :db/id #edb/ref 17592186432225} {:answer/id #uuid "d87ebf8c-3a5e-53cb-b9ad-7e52233c6175" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(-6,-8)$, radius: $11$" :db/id #edb/ref 17592186432229}] :answer-field/correct {:answer/id #uuid "0d6171a8-6197-560d-8edc-2b5e80c6ce81" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(6,8)$, radius: $11$" :db/id #edb/ref 17592186432200} :answer-field/id #uuid "6620afbd-acc2-572e-82fa-fe544bca1ecb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186432239}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "81e4046d-ee12-5213-9139-6081d308b0b9" :question/math-academy-id "q-5182" :question/problem "Find the center and radius of the circle whose equation is ${x}^{2}-12x+{y}^{2}-16y-21=0.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}-12x+{y}^{2}-16y-21 & =0 \\\\ {x}^{2}-12x+{y}^{2}-16y & =21 \\\\ ({x}^{2}-2\\cdot 6x+{6}^{2})+({y}^{2}-2\\cdot 8y+{8}^{2}) & =21+{6}^{2}+{8}^{2} \\\\ ({x}^{2}-2\\cdot 6x+{6}^{2})+({y}^{2}-2\\cdot 8y+{8}^{2}) & =121\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x-6)^{2}+(y-8)^{2} & ={11}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(6,8)$ and its radius is $11.$"}] [{:db/id #edb/ref 17592186432246 :knowledge-point/_questions [{:db/id #edb/ref 17592186078390 :knowledge-point/id #uuid "697f9bd8-9edf-5643-8cdb-a821b6dce09c" :knowledge-point/title "Finding the Center and Radius of a Circle by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "582731db-ea16-5d66-9090-5f57ae7fd64d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(1,2),$ radius: $1$" :db/id #edb/ref 17592186432207} {:answer/id #uuid "648f4194-fec8-5e9c-87af-4fb442b8ea1e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(2,1),$ radius: $\\sqrt{2}$" :db/id #edb/ref 17592186432209} {:answer/id #uuid "6c5d401c-bb61-5f85-be78-864bd3556574" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(2,1),$ radius: $1$" :db/id #edb/ref 17592186432210} {:answer/id #uuid "6d9f2f63-2b6c-5173-96ad-fa3cefcebd64" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(2,1),$ radius: $2$" :db/id #edb/ref 17592186432211} {:answer/id #uuid "76607376-556e-5250-8ef1-e96ff909028c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(1,2),$ radius: $\\sqrt{2}$" :db/id #edb/ref 17592186432212}] :answer-field/correct {:answer/id #uuid "6c5d401c-bb61-5f85-be78-864bd3556574" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(2,1),$ radius: $1$" :db/id #edb/ref 17592186432210} :answer-field/id #uuid "2f7be69d-ef52-5421-abfe-89f073f68500" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186432236}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f5b1b8a2-d088-51d1-b8fc-6a7c6d262461" :question/math-academy-id "q-54216" :question/problem "Find the center and radius of the circle whose equation is ${x}^{2}-4x+{y}^{2}-2y=-4.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}-4x+{y}^{2}-2y & =-4 \\\\ ({x}^{2}-4x)+({y}^{2}-2y) & =-4 \\\\ ({x}^{2}-2\\cdot 2x+{2}^{2})+({y}^{2}-2\\cdot y+{1}^{2}) & =-4+{2}^{2}+{1}^{2} \\\\ ({x}^{2}-2\\cdot 2x+{2}^{2})+({y}^{2}-2\\cdot y+{1}^{2}) & =1\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x-2)^{2}+(y-1)^{2} & ={1}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(2,1)$ and its radius is $1.$"}] [{:db/id #edb/ref 17592186079203 :knowledge-point/_questions [{:db/id #edb/ref 17592186078391 :knowledge-point/id #uuid "98e3f3b4-8dfa-515c-90b1-09fb19d68144" :knowledge-point/title "Finding the Center and Radius of a Circle by Completing the Square with Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a24aa32-be27-5a08-b7f2-3b7687162fe7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(\\frac{5}{2},1),$ radius: $\\frac{25}{4}$" :db/id #edb/ref 17592186432208} {:answer/id #uuid "8a69426e-541f-5455-a730-43f891fdd05a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(-\\frac{5}{2},-1),$ radius: $3$" :db/id #edb/ref 17592186432216} {:answer/id #uuid "8d2cea3d-9511-52f8-ba35-37514aa28e6b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(-\\frac{5}{2},1),$ radius: $3$" :db/id #edb/ref 17592186432217} {:answer/id #uuid "b7212f1a-369b-508d-af5b-02c25936336a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(\\frac{5}{2},-1),$ radius: $\\frac{7}{4}$" :db/id #edb/ref 17592186432221} {:answer/id #uuid "cafaa4da-7864-5748-8e08-e8893dc4bdbd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(-\\frac{5}{2},1),$ radius: $\\frac{5}{2}$" :db/id #edb/ref 17592186432224}] :answer-field/correct {:answer/id #uuid "8d2cea3d-9511-52f8-ba35-37514aa28e6b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(-\\frac{5}{2},1),$ radius: $3$" :db/id #edb/ref 17592186432217} :answer-field/id #uuid "0135309d-4571-5e4f-b373-ceb7b0682c4e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186077996}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7f67332a-d49b-5dc7-b92a-6be6456a8b20" :question/math-academy-id "q-76089" :question/problem "Find the radius and center of the circle whose equation is\n${x}^{2}+5x+{y}^{2}-2y=\\frac{7}{4}.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+5x+{y}^{2}-2y & =\\frac{7}{4} \\\\ ({x}^{2}+5x)+({y}^{2}-2y) & =\\frac{7}{4} \\\\ ({x}^{2}+2\\cdot \\frac{5}{2}x+{(\\frac{5}{2})}^{2})+({y}^{2}-2\\cdot 1y+{1}^{2}) & =\\frac{7}{4}+{(\\frac{5}{2})}^{2}+{1}^{2} \\\\ ({x}^{2}+2\\cdot \\frac{5}{2}x+{(\\frac{5}{2})}^{2})+({y}^{2}-2\\cdot 1y+{1}^{2}) & =9.\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}{(x+\\frac{5}{2})}^{2}+(y-1)^{2} & ={3}^{2} \\\\ {(x-(-\\frac{5}{2}))}^{2}+(y-1)^{2} & ={3}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(-\\frac{5}{2},1)$ and its radius is $3.$"}] [{:db/id #edb/ref 17592186432241 :knowledge-point/_questions [{:db/id #edb/ref 17592186078391 :knowledge-point/id #uuid "98e3f3b4-8dfa-515c-90b1-09fb19d68144" :knowledge-point/title "Finding the Center and Radius of a Circle by Completing the Square with Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "869f4c55-546c-52cc-8ced-67516318c751" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(-\\frac{9}{2},2),$ radius: $\\frac{9}{2}$" :db/id #edb/ref 17592186432215} {:answer/id #uuid "8f2c590a-006c-5f3e-a6ce-8ac136804c47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(\\frac{9}{2},-2),$ radius: $\\frac{25}{2}$" :db/id #edb/ref 17592186432218} {:answer/id #uuid "b7aafbb4-5f1a-532e-a061-cd5642e39dcb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(-\\frac{9}{2},-2),$ radius: $\\frac{7}{2}$" :db/id #edb/ref 17592186432222} {:answer/id #uuid "cf5a2a27-3dd3-5a9b-b293-538e2a5ae403" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(\\frac{9}{2},2),$ radius: $\\frac{5}{2}$" :db/id #edb/ref 17592186432226} {:answer/id #uuid "d272cd79-ec75-589c-ac60-423761ee530e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(\\frac{9}{2},-2),$ radius: $\\frac{5}{2}$" :db/id #edb/ref 17592186432228}] :answer-field/correct {:answer/id #uuid "cf5a2a27-3dd3-5a9b-b293-538e2a5ae403" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(\\frac{9}{2},2),$ radius: $\\frac{5}{2}$" :db/id #edb/ref 17592186432226} :answer-field/id #uuid "5ef058c1-0aa5-57fc-9272-6eda95714a4b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186432238}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "05b6d7d5-d625-5b32-8cf2-e194a924cafa" :question/math-academy-id "q-76372" :question/problem "Find the radius and center of the circle whose equation is\n${x}^{2}-9x+18=4y-{y}^{2}.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}-9x+18 & =4y-{y}^{2} \\\\ ({x}^{2}-9x)+({y}^{2}-4y) & =-18 \\\\ ({x}^{2}-2\\cdot \\frac{9}{2}x+{(\\frac{9}{2})}^{2})+({y}^{2}-2\\cdot 2y+{2}^{2}) & =-18+{(\\frac{9}{2})}^{2}+{2}^{2} \\\\ ({x}^{2}-2\\cdot \\frac{9}{2}x+{(\\frac{9}{2})}^{2})+({y}^{2}-2\\cdot 2y+{2}^{2}) & =\\frac{25}{4}.\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}{(x-\\frac{9}{2})}^{2}+(y-2)^{2} & ={(\\frac{5}{2})}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(\\frac{9}{2},2)$ and its radius is $\\frac{5}{2}.$"}] [{:db/id #edb/ref 17592186432242 :knowledge-point/_questions [{:db/id #edb/ref 17592186078391 :knowledge-point/id #uuid "98e3f3b4-8dfa-515c-90b1-09fb19d68144" :knowledge-point/title "Finding the Center and Radius of a Circle by Completing the Square with Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bde742f-f51c-5674-bb70-2f6fd40536f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(1,-\\frac{7}{2}),$ radius: $\\frac{3}{2}$" :db/id #edb/ref 17592186432203} {:answer/id #uuid "327347a6-42f8-50e6-ad5f-073e874b3720" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(-1,-\\frac{7}{2}),$ radius: $\\frac{5}{2}$" :db/id #edb/ref 17592186432204} {:answer/id #uuid "c0852af0-ccd5-5bd7-9bd6-ee1f70eaa95d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(\\frac{7}{2},1),$ radius: $\\frac{5}{2}$" :db/id #edb/ref 17592186432223} {:answer/id #uuid "d1b3959a-2607-51e9-a4b6-5a4f75bcd867" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(-1,\\frac{7}{2}),$ radius: $\\frac{5}{2}$" :db/id #edb/ref 17592186432227} {:answer/id #uuid "ff7c06d3-205f-5a3d-a8e4-802ee7d82dbe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(1,\\frac{7}{2}),$ radius: $\\frac{7}{2}$" :db/id #edb/ref 17592186432234}] :answer-field/correct {:answer/id #uuid "d1b3959a-2607-51e9-a4b6-5a4f75bcd867" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(-1,\\frac{7}{2}),$ radius: $\\frac{5}{2}$" :db/id #edb/ref 17592186432227} :answer-field/id #uuid "c017ab2c-4452-50b0-937f-c0713b32da2b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186432240}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "11173788-8230-54a4-a1cf-e31575312fe3" :question/math-academy-id "q-76373" :question/problem "Find the radius and center of the circle whose equation is\n${x}^{2}+{y}^{2}+7=7y-2x.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}+7 & =7y-2x \\\\ ({x}^{2}+2x)+({y}^{2}-7y) & =-7 \\\\ ({x}^{2}+2\\cdot x+{1}^{2})+({y}^{2}-2\\cdot \\frac{7}{2}y+{(\\frac{7}{2})}^{2}) & =-7+{1}^{2}+{(\\frac{7}{2})}^{2} \\\\ ({x}^{2}+2\\cdot x+{1}^{2})+({y}^{2}-2\\cdot \\frac{7}{2}y+{(\\frac{7}{2})}^{2}) & =\\frac{25}{4}.\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}{(x+1)}^{2}+{(y-\\frac{7}{2})}^{2} & ={(\\frac{5}{2})}^{2} \\\\ {(x-(-1))}^{2}+{(y-\\frac{7}{2})}^{2} & ={(\\frac{5}{2})}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(-1,\\frac{7}{2})$ and its radius is $\\frac{5}{2}.$"}] [{:db/id #edb/ref 17592186403836 :knowledge-point/_questions [{:db/id #edb/ref 17592186078391 :knowledge-point/id #uuid "98e3f3b4-8dfa-515c-90b1-09fb19d68144" :knowledge-point/title "Finding the Center and Radius of a Circle by Completing the Square with Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "707a4cfe-d34e-5500-a601-9753b554d97e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(1,-\\frac{1}{4}),$ radius: $\\frac{5}{4}$" :db/id #edb/ref 17592186403838} {:answer/id #uuid "0043bbe1-8c13-5357-841d-e795a04df199" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(-1,-\\frac{1}{4}),$ radius: $\\frac{3}{4}$" :db/id #edb/ref 17592186403839} {:answer/id #uuid "13f05de5-d7d8-5d9c-9e5d-ac75c76fa048" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(1,\\frac{1}{4}),$ radius: $\\frac{3}{4}$" :db/id #edb/ref 17592186403840} {:answer/id #uuid "1705b14f-f5fa-5468-b93d-33bcdcdbb387" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(\\frac{1}{4},1),$ radius: $\\frac{7}{4}$" :db/id #edb/ref 17592186403841} {:answer/id #uuid "cc1a32ca-3acb-5d7d-b8ad-8a49ebecf6c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(-1,\\frac{1}{4}),$ radius: $\\frac{5}{4}$" :db/id #edb/ref 17592186403842}] :answer-field/correct {:answer/id #uuid "13f05de5-d7d8-5d9c-9e5d-ac75c76fa048" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(1,\\frac{1}{4}),$ radius: $\\frac{3}{4}$" :db/id #edb/ref 17592186403840} :answer-field/id #uuid "64251e03-03e9-594a-89a0-0a7ae7fb1367" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403837}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "64257e64-8ece-56eb-a9da-46dae15085ca" :question/math-academy-id "q-76374" :question/problem "Find the radius and center of the circle whose equation is\n$2{x}^{2}-4x+2{y}^{2}-y=-1.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}2{x}^{2}-4x+2{y}^{2}-y & =-1 \\\\ {x}^{2}-2x+{y}^{2}-\\frac{1}{2}y & =-\\frac{1}{2} \\\\ ({x}^{2}-2x)+({y}^{2}-\\frac{1}{2}y) & =-\\frac{1}{2} \\\\ ({x}^{2}-2\\cdot x+{1}^{2})+({y}^{2}-2\\cdot \\frac{1}{4}y+{(\\frac{1}{4})}^{2}) & =-\\frac{1}{2}+{1}^{2}+{(\\frac{1}{4})}^{2} \\\\ ({x}^{2}-2\\cdot x+{1}^{2})+({y}^{2}-2\\cdot \\frac{1}{4}y+{(\\frac{1}{4})}^{2}) & =\\frac{9}{16}\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x-1)^{2}+{(y-\\frac{1}{4})}^{2} & =\\frac{9}{16} \\\\ (x-1)^{2}+{(y-\\frac{1}{4})}^{2} & ={(\\frac{3}{4})}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(1,\\frac{1}{4})$ and its radius is $\\frac{3}{4}.$"}]}
