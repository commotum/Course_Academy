{9}{2}x+{(\\frac{9}{2})}^{2})+({y}^{2}-2\\cdot 2y+{2}^{2}) & =\\frac{25}{4}.\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}{(x-\\frac{9}{2})}^{2}+(y-2)^{2} & ={(\\frac{5}{2})}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(\\frac{9}{2},2)$ and its radius is $\\frac{5}{2}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-5ef058c1-0aa5-57fc-9272-6eda95714a4b"] :db/ensure [:question/validate]} {:db/id "answer-field-5ef058c1-0aa5-57fc-9272-6eda95714a4b" :answer-field/id #uuid "5ef058c1-0aa5-57fc-9272-6eda95714a4b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-cf5a2a27-3dd3-5a9b-b293-538e2a5ae403" :answer-field/choices ["answer-b7aafbb4-5f1a-532e-a061-cd5642e39dcb" "answer-869f4c55-546c-52cc-8ced-67516318c751" "answer-8f2c590a-006c-5f3e-a6ce-8ac136804c47" "answer-d272cd79-ec75-589c-ac60-423761ee530e" "answer-cf5a2a27-3dd3-5a9b-b293-538e2a5ae403"] :db/ensure [:answer-field/validate]} {:db/id "answer-b7aafbb4-5f1a-532e-a061-cd5642e39dcb" :answer/id #uuid "b7aafbb4-5f1a-532e-a061-cd5642e39dcb" :answer/type :answer.type/text :answer/value "center: $(-\\frac{9}{2},-2),$ radius: $\\frac{7}{2}$" :db/ensure [:answer/validate]} {:db/id "answer-869f4c55-546c-52cc-8ced-67516318c751" :answer/id #uuid "869f4c55-546c-52cc-8ced-67516318c751" :answer/type :answer.type/text :answer/value "center: $(-\\frac{9}{2},2),$ radius: $\\frac{9}{2}$" :db/ensure [:answer/validate]} {:db/id "answer-8f2c590a-006c-5f3e-a6ce-8ac136804c47" :answer/id #uuid "8f2c590a-006c-5f3e-a6ce-8ac136804c47" :answer/type :answer.type/text :answer/value "center: $(\\frac{9}{2},-2),$ radius: $\\frac{25}{2}$" :db/ensure [:answer/validate]} {:db/id "answer-d272cd79-ec75-589c-ac60-423761ee530e" :answer/id #uuid "d272cd79-ec75-589c-ac60-423761ee530e" :answer/type :answer.type/text :answer/value "center: $(\\frac{9}{2},-2),$ radius: $\\frac{5}{2}$" :db/ensure [:answer/validate]} {:db/id "answer-cf5a2a27-3dd3-5a9b-b293-538e2a5ae403" :answer/id #uuid "cf5a2a27-3dd3-5a9b-b293-538e2a5ae403" :answer/type :answer.type/text :answer/value "center: $(\\frac{9}{2},2),$ radius: $\\frac{5}{2}$" :db/ensure [:answer/validate]} {:db/id "question-11173788-8230-54a4-a1cf-e31575312fe3" :question/id #uuid "11173788-8230-54a4-a1cf-e31575312fe3" :question/math-academy-id "q-76373" :question/problem "Find the radius and center of the circle whose equation is\n${x}^{2}+{y}^{2}+7=7y-2x.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}+7 & =7y-2x \\\\ ({x}^{2}+2x)+({y}^{2}-7y) & =-7 \\\\ ({x}^{2}+2\\cdot x+{1}^{2})+({y}^{2}-2\\cdot \\frac{7}{2}y+{(\\frac{7}{2})}^{2}) & =-7+{1}^{2}+{(\\frac{7}{2})}^{2} \\\\ ({x}^{2}+2\\cdot x+{1}^{2})+({y}^{2}-2\\cdot \\frac{7}{2}y+{(\\frac{7}{2})}^{2}) & =\\frac{25}{4}.\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}{(x+1)}^{2}+{(y-\\frac{7}{2})}^{2} & ={(\\frac{5}{2})}^{2} \\\\ {(x-(-1))}^{2}+{(y-\\frac{7}{2})}^{2} & ={(\\frac{5}{2})}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(-1,\\frac{7}{2})$ and its radius is $\\frac{5}{2}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c017ab2c-4452-50b0-937f-c0713b32da2b"] :db/ensure [:question/validate]} {:db/id "answer-field-c017ab2c-4452-50b0-937f-c0713b32da2b" :answer-field/id #uuid "c017ab2c-4452-50b0-937f-c0713b32da2b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d1b3959a-2607-51e9-a4b6-5a4f75bcd867" :answer-field/choices ["answer-327347a6-42f8-50e6-ad5f-073e874b3720" "answer-d1b3959a-2607-51e9-a4b6-5a4f75bcd867" "answer-1bde742f-f51c-5674-bb70-2f6fd40536f4" "answer-ff7c06d3-205f-5a3d-a8e4-802ee7d82dbe" "answer-c0852af0-ccd5-5bd7-9bd6-ee1f70eaa95d"] :db/ensure [:answer-field/validate]} {:db/id "answer-327347a6-42f8-50e6-ad5f-073e874b3720" :answer/id #uuid "327347a6-42f8-50e6-ad5f-073e874b3720" :answer/type :answer.type/text :answer/value "center: $(-1,-\\frac{7}{2}),$ radius: $\\frac{5}{2}$" :db/ensure [:answer/validate]} {:db/id "answer-d1b3959a-2607-51e9-a4b6-5a4f75bcd867" :answer/id #uuid "d1b3959a-2607-51e9-a4b6-5a4f75bcd867" :answer/type :answer.type/text :answer/value "center: $(-1,\\frac{7}{2}),$ radius: $\\frac{5}{2}$" :db/ensure [:answer/validate]} {:db/id "answer-1bde742f-f51c-5674-bb70-2f6fd40536f4" :answer/id #uuid "1bde742f-f51c-5674-bb70-2f6fd40536f4" :answer/type :answer.type/text :answer/value "center: $(1,-\\frac{7}{2}),$ radius: $\\frac{3}{2}$" :db/ensure [:answer/validate]} {:db/id "answer-ff7c06d3-205f-5a3d-a8e4-802ee7d82dbe" :answer/id #uuid "ff7c06d3-205f-5a3d-a8e4-802ee7d82dbe" :answer/type :answer.type/text :answer/value "center: $(1,\\frac{7}{2}),$ radius: $\\frac{7}{2}$" :db/ensure [:answer/validate]} {:db/id "answer-c0852af0-ccd5-5bd7-9bd6-ee1f70eaa95d" :answer/id #uuid "c0852af0-ccd5-5bd7-9bd6-ee1f70eaa95d" :answer/type :answer.type/text :answer/value "center: $(\\frac{7}{2},1),$ radius: $\\frac{5}{2}$" :db/ensure [:answer/validate]} {:db/id 17592186079203 :question/problem "Find the radius and center of the circle whose equation is\n${x}^{2}+5x+{y}^{2}-2y=\\frac{7}{4}.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+5x+{y}^{2}-2y & =\\frac{7}{4} \\\\ ({x}^{2}+5x)+({y}^{2}-2y) & =\\frac{7}{4} \\\\ ({x}^{2}+2\\cdot \\frac{5}{2}x+{(\\frac{5}{2})}^{2})+({y}^{2}-2\\cdot 1y+{1}^{2}) & =\\frac{7}{4}+{(\\frac{5}{2})}^{2}+{1}^{2} \\\\ ({x}^{2}+2\\cdot \\frac{5}{2}x+{(\\frac{5}{2})}^{2})+({y}^{2}-2\\cdot 1y+{1}^{2}) & =9.\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}{(x+\\frac{5}{2})}^{2}+(y-1)^{2} & ={3}^{2} \\\\ {(x-(-\\frac{5}{2}))}^{2}+(y-1)^{2} & ={3}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(-\\frac{5}{2},1)$ and its radius is $3.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186077996 :answer-field/correct "answer-8d2cea3d-9511-52f8-ba35-37514aa28e6b" :answer-field/choices ["answer-8a69426e-541f-5455-a730-43f891fdd05a" "answer-8d2cea3d-9511-52f8-ba35-37514aa28e6b" "answer-cafaa4da-7864-5748-8e08-e8893dc4bdbd" "answer-b7212f1a-369b-508d-af5b-02c25936336a" "answer-5a24aa32-be27-5a08-b7f2-3b7687162fe7"] :db/ensure [:answer-field/validate]} {:db/id "answer-8a69426e-541f-5455-a730-43f891fdd05a" :answer/id #uuid "8a69426e-541f-5455-a730-43f891fdd05a" :answer/type :answer.type/text :answer/value "center: $(-\\frac{5}{2},-1),$ radius: $3$" :db/ensure [:answer/validate]} {:db/id "answer-8d2cea3d-9511-52f8-ba35-37514aa28e6b" :answer/id #uuid "8d2cea3d-9511-52f8-ba35-37514aa28e6b" :answer/type :answer.type/text :answer/value "center: $(-\\frac{5}{2},1),$ radius: $3$" :db/ensure [:answer/validate]} {:db/id "answer-cafaa4da-7864-5748-8e08-e8893dc4bdbd" :answer/id #uuid "cafaa4da-7864-5748-8e08-e8893dc4bdbd" :answer/type :answer.type/text :answer/value "center: $(-\\frac{5}{2},1),$ radius: $\\frac{5}{2}$" :db/ensure [:answer/validate]} {:db/id "answer-b7212f1a-369b-508d-af5b-02c25936336a" :answer/id #uuid "b7212f1a-369b-508d-af5b-02c25936336a" :answer/type :answer.type/text :answer/value "center: $(\\frac{5}{2},-1),$ radius: $\\frac{7}{4}$" :db/ensure [:answer/validate]} {:db/id "answer-5a24aa32-be27-5a08-b7f2-3b7687162fe7" :answer/id #uuid "5a24aa32-be27-5a08-b7f2-3b7687162fe7" :answer/type :answer.type/text :answer/value "center: $(\\frac{5}{2},1),$ radius: $\\frac{25}{4}$" :db/ensure [:answer/validate]} {:db/id 17592186079635 :tutorial/content "Consider the equation \n\n$$\nx^2 +  y^2 - 2x - 4y = 4.\n$$\n\nBelieve it or not, this equation actually represents a circle! Its graph is given below:\n\n![](images/5d/5dfea5042d6c84f40a2790a01ee6aafb64433f7422ce88b589cf670d93771e2c.png)\n\n   \n\nClearly, this is a circle of radius $3$ centered at $(1,2).$ But how can we determine the center and radius from the given circle equation?\n\nLet's start with the equation\n\n$$\nx^2 +  y^2 - 2x - 4y = 4.\n$$\n\nBy grouping the $x$ and $y$ terms and completing the squares, we can write the equation in the standard form\n\n$$\n(x-a)^2 + (y-b)^2 = r^2.\n$$\n\nWe carry out the process with the following steps:\n\n**Step 1. **Group the $x$ and $y$ terms.\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}-2x-4y & =4 \\\\ ({x}^{2}-2x)+({y}^{2}-4y) & =4\\end{aligned}\n$$\n\n**Step 2.** In each group, add the square of half the linear coefficient to both sides of the equation. \n\n- Here, the $x$ coefficient is $-2,$ so we add $\\left( \\dfrac{-2}{2} \\right)^2 = (-1)^2 = 1$ to both sides.\n\n- Likewise, the $y$ coefficient is $-4,$ so we add $\\left( \\dfrac{-4}{2} \\right)^2 = (-2)^2 = 4$ to both sides.\n\nSo, we have\n\n$$\n\\begin{aligned}({x}^{2}-2x+1)+({y}^{2}-4y+4) & =4+1+4 \\\\ ({x}^{2}-2x+1)+({y}^{2}-4y+4) & =9.\\end{aligned}\n$$\n\n**Step 3.** Finally, we factor each group into a perfect square, and we get\n\n$$\n\\begin{aligned}(x-1)^{2}+(y-2)^{2} & =9 \\\\ (x-1)^{2}+(y-2)^{2} & ={3}^{2}.\\end{aligned}\n$$\n\nNow, we can see that the equation represents a circle centered at $(1,2)$ with radius $3.$" :db/ensure [:tutorial/validate]} {:db/id 17592186078682 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]}]
