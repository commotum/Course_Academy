}-2\\cdot 6x+{6}^{2})+({y}^{2}-2\\cdot 8y+{8}^{2}) & =121\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x-6)^{2}+(y-8)^{2} & ={11}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(6,8)$ and its radius is $11.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-6620afbd-acc2-572e-82fa-fe544bca1ecb"] :db/ensure [:question/validate]} {:db/id "answer-field-6620afbd-acc2-572e-82fa-fe544bca1ecb" :answer-field/id #uuid "6620afbd-acc2-572e-82fa-fe544bca1ecb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0d6171a8-6197-560d-8edc-2b5e80c6ce81" :answer-field/choices ["answer-16f43589-ba4b-5fe3-b651-27dcee807b31" "answer-d87ebf8c-3a5e-53cb-b9ad-7e52233c6175" "answer-cd5d7134-54b8-5fbc-9070-2f312605b654" "answer-0d6171a8-6197-560d-8edc-2b5e80c6ce81" "answer-9896f873-fcd7-5d43-8b83-249941df2b11"] :db/ensure [:answer-field/validate]} {:db/id "answer-16f43589-ba4b-5fe3-b651-27dcee807b31" :answer/id #uuid "16f43589-ba4b-5fe3-b651-27dcee807b31" :answer/type :answer.type/text :answer/value "center: $(-12,-16)$, radius: $21$" :db/ensure [:answer/validate]} {:db/id "answer-d87ebf8c-3a5e-53cb-b9ad-7e52233c6175" :answer/id #uuid "d87ebf8c-3a5e-53cb-b9ad-7e52233c6175" :answer/type :answer.type/text :answer/value "center: $(-6,-8)$, radius: $11$" :db/ensure [:answer/validate]} {:db/id "answer-cd5d7134-54b8-5fbc-9070-2f312605b654" :answer/id #uuid "cd5d7134-54b8-5fbc-9070-2f312605b654" :answer/type :answer.type/text :answer/value "center: $(12,16)$, radius: $21$" :db/ensure [:answer/validate]} {:db/id "answer-0d6171a8-6197-560d-8edc-2b5e80c6ce81" :answer/id #uuid "0d6171a8-6197-560d-8edc-2b5e80c6ce81" :answer/type :answer.type/text :answer/value "center: $(6,8)$, radius: $11$" :db/ensure [:answer/validate]} {:db/id "answer-9896f873-fcd7-5d43-8b83-249941df2b11" :answer/id #uuid "9896f873-fcd7-5d43-8b83-249941df2b11" :answer/type :answer.typ