>,</mo><mn>2</mn><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>1</mn><mo>⋅</mo><mn>0.1</mn><mo>+</mo><mn>0</mn><mo>⋅</mo><mn>0.55</mn><mo>+</mo><mn>9</mn><mo>⋅</mo><mn>0.15</mn><mo>+</mo><mn>4</mn><mo>⋅</mo><mn>0.2</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>0.1</mn><mo>+</mo><mn>0</mn><mo>+</mo><mn>1.35</mn><mo>+</mo><mn>0.8</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>2.25</mn><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
