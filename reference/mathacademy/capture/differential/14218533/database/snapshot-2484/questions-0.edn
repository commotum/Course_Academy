f 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449632} {:answer/id #uuid "2e93e8a1-abd3-5bae-8c25-a6156dc77f12" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449633}] :answer-field/correct {:answer/id #uuid "2e93e8a1-abd3-5bae-8c25-a6156dc77f12" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449633} :answer-field/id #uuid "71691d56-9200-5496-becc-0f211d28a39b" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450770}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f63719f4-7a1e-5b43-8302-7786de4d0619" :question/math-academy-id "q-141199" :question/problem "Which of the following statements are true, given that $A$ is a $4\\times 4$ matrix and $v=\\begin{bmatrix}1 \\\\ 0 \\\\ -1 \\\\ 0\\end{bmatrix}$ is a solution of the equation $Ax=0?$\n\nSelect all that apply.\n\n- **I.** $\\text{Null}(A)={0}$\n- **II.** $A$ is not invertible\n- **III.** $\\text{Col}(A)\\ne {R}^{4}$" :question/worked-solution "Since $A$ is a $4\\times 4$ matrix, the invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,{\\,\\begin{aligned} & \\text{Col}(A)={R}^{4} \\\\  & \\text{dim(Col}(A))=4=\\text{rank}(A) \\\\  & \\text{Null}(A)={0} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$ \n\nWith that in mind, let's examine each statement in turn. \n\n- Statement I is false. Since $v\\ne 0$ and $Av=0,$ \nthen $v\\in \\text{Null}(A)$ and, therefore, $\\text{Null}(A)\\ne {0}.$\n\n- Statement II is true. Since $\\text{Null}(A)\\ne {0},$ then according to the invertible matrix theorem, the matrix $A$ can't be invertible.\n\n- Statement III is true. Since $A$ is not invertible, then by the invertible matrix theorem, we must have $\\text{Col}(A)\\ne {R}^{4}.$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186272348 :knowledge-point/_questions [{:db/id #edb/ref 17592186124629 :knowledge-point/id #uuid "bb90e5b9-03fe-51cf-bc16-a293befacebc" :knowledge-point/title "Сompleting a Sentence Using the Invertible Matrix Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d248bbb6-50b4-5d61-a95e-58f318131503" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464246} {:answer/id #uuid "7e5d0dfe-318f-5100-ac82-83455377b98c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464247}] :answer-field/correct {:answer/id #uuid "7e5d0dfe-318f-5100-ac82-83455377b98c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464247} :answer-field/id #uuid "2d37791a-a285-5a2f-af41-bcd2d8afc075" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465057} {:answer-field/choices [{:answer/id #uuid "3957e353-c39b-5011-af11-d2c9b6787af4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464248} {:answer/id #uuid "8a540690-cbd6-5a7b-8e6a-735ce1ef7a6a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464249}] :answer-field/correct {:answer/id #uuid "3957e353-c39b-5011-af11-d2c9b6787af4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464248} :answer-field/id #uuid "8cfe4de2-b1c4-55bb-a60d-27c7be7257dc" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465058} {:answer-field/choices [{:answer/id #uuid "4f6788d6-5506-57b7-9972-0d793d0b67f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464250} {:answer/id #uuid "67197e1a-6b46-5a73-9b9e-21d0f7711026" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464251}] :answer-field/correct {:answer/id #uuid "67197e1a-6b46-5a73-9b9e-21d0f7711026" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464251} :answer-field/id #uuid "41d8c4a3-f095-50cd-bcf7-92ff6b429b75" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465059}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "795129ab-7204-5692-a97c-e32525213e2a" :question/math-academy-id "q-142475" :question/problem "Consider the following sentence:\n\n*If $A$ is a $n\\times n$ matrix and $\\text{nullity}(A)=0,$ then  $\\text{__________}\\,.$*\n\nWhich of the following can be placed into the blank space to make a true statement?\n- **I.** $A$ is invertible\n- **II.** $\\text{rank}(A)<n$\n- **III.** $\\text{Col}(A)={R}^{n}$\n\nSelect all that apply." :question/worked-solution "The invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,{\\,\\begin{aligned} & \\text{Col}(A)={R}^{n} \\\\  & \\text{dim(Col}(A))=n=\\text{rank}(A) \\\\  & \\text{Null}(A)={0} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$\n\nWith that in mind, let's examine each of the options separately.\n\n- The following statement is true:\n\n*If $A$ is a $n\\times n$ matrix and $\\text{nullity}(A)=0,$ then $A$ is invertible.* $\\,✓$ \n\nIndeed, according to the invertible matrix theorem, \n\n$A$ is invertible $\\,⇔\\,\\text{dim(Null}(A))=0=\\text{nullity}(A).$\n\n- The following statement is false:\n\n*If $A$ is a $n\\times n$ matrix and $\\text{nullity}(A)=0,$ then $\\text{rank}(A)<n.$* $\\,\\times $ \n\nIndeed, since $A$ is invertible, then according to the invertible matrix theorem, we have $\\text{rank}(A)=n.$\n\n- The following statement is true:\n\n*If $A$ is a $n\\times n$ matrix and $\\text{nullity}(A)=0,$ then $\\text{Col}(A)={R}^{n}.$*  $\\,✓$ \n\nIndeed, since $A$ is invertible, then according to the invertible matrix theorem, we have $\\text{Col}(A)={R}^{n}.$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186329820 :knowledge-point/_questions [{:db/id #edb/ref 17592186124629 :knowledge-point/id #uuid "bb90e5b9-03fe-51cf-bc16-a293befacebc" :knowledge-point/title "Сompleting a Sentence Using the Invertible Matrix Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86d1fafe-67a4-5304-b42b-0fa34a95eaff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467578} {:answer/id #uuid "c76c9ea4-d5d0-5c09-adc5-db52b1568fa5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467579}] :answer-field/correct {:answer/id #uuid "c76c9ea4-d5d0-5c09-adc5-db52b1568fa5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467579} :answer-field/id #uuid "3df948ff-c1ab-538f-b99e-ed07682677fc" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468510} {:answer-field/choices [{:answer/id #uuid "6428bf6c-1cd8-523e-89a2-bbd6aefca97b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467580} {:answer/id #uuid "49e7f113-867c-5ee0-a738-ba5b88651827" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467581}] :answer-field/correct {:answer/id #uuid "6428bf6c-1cd8-523e-89a2-bbd6aefca97b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467580} :answer-field/id #uuid "2e8c77e6-a0b4-526b-bf8e-a435b7b66ac1" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468511} {:answer-field/choices [{:answer/id #uuid "7b22f319-2182-5f2f-984d-2c69a38c95bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467582} {:answer/id #uuid "f8184f79-583b-5721-92be-e461d3dc1a14" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467583}] :answer-field/correct {:answer/id #uuid "7b22f319-2182-5f2f-984d-2c69a38c95bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467582} :answer-field/id #uuid "d58f3fca-628f-5dd4-9837-348f91ad595e" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468512}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2c600e13-fdff-5526-82d0-6659ac10dfc3" :question/math-academy-id "q-47587" :question/problem "Consider the following sentence:\n\n*If $A$ is a $n\\times n$ matrix and $det(A)=0,$ then $\\text{__________}\\,.$*\n\nWhich of the following can be placed into the blank space to make a true statement?\n\nI. $A$ has no inverse\n\nII. $\\text{rank}(A)=n$\n\nIII. All columns of $A$ are pivot columns\n\nSelect all that apply." :question/worked-solution "The invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,\\{\\,\\begin{aligned} & \\text{Col}(A)={R}^{n} \\\\  & \\text{dim(Col}(A))=n=\\text{rank}(A) \\\\  & \\text{Null}(A)=\\{0\\} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$\n\nWith that in mind, let's examine each of the options separately.\n\n- The following statement is true:\n\n*If $A$ is a $n\\times n$ matrix and $det(A)=0,$ then $A$ has no inverse.* $\\,✓$  \n\nIndeed,  a matrix $A$ is invertible if and only if $det(A)\\ne 0.$\n\n- The following statement is false:\n\n*If $A$ is a $n\\times n$ matrix and $det(A)=0,$ then $\\text{rank}(A)=n.$*$\\,\\times $\n\nSince our matrix is not invertible, according to the invertible matrix theorem, it must be $\\text{rank}(A)\\ne n.$\n\n- The following statement is false:\n\n*If $A$ is a $n\\times n$ matrix and $det(A)=0,$ then all columns of $A$ are pivot columns.*  $\\,\\times $\n\nSince $\\text{rank}(A)\\ne n$, it must be $\\text{dim(Col}(A))<n,$ which means that not all columns of $A$ are pivot columns.\n\nTherefore, the correct answer is \"I only.\""}]}
