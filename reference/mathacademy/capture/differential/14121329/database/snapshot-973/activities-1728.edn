#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186116133} :activity/id #uuid "d6f7c63b-f172-5766-b56a-db8bf2a22464" :activity/scope {:db/id #edb/ref 17592186048920 :topic/id #uuid "cc887b1d-8841-507d-a99b-b7888c08a675" :topic/math-academy-id 1728} :activity/steps [{:db/id #edb/ref 17592186116133 :step/content {:db/id #edb/ref 17592186116498 :tutorial/content "Suppose we want to find the inverse of the matrix \n\n![](images/fd/fd9e9dc44e27810ef490a898a7c82ae9296eaf85ac9406cf310afe86638f71e1.svg) \n\nWe can compute the inverse of $A$ using elementary row operations. There are two key advantages to using row operations to compute the inverse of a matrix:\n\n- The method works for any invertible matrix of any size, not just $2\\times 2$ matrices.\n\n- It requires significantly less computation than some alternative methods. This is especially true for large matrices.\n\nHere, we'll focus on the $2\\times 2$ case. We use the following fact:\n\n*The row operations that transform $A$ into the identity matrix $I_2$ also transform $I_2$ into $A^{-1}$*.\n\nSo, to find the inverse of $A,$ we proceed as follows:\n\n**Step 1:** Write down $\\color{blue}A$ and the identity matrix $I_2$ side-by-side, as shown below:\n![](images/e5/e553bcc265698432452c8d35b79fe9dc70c25010a0bcc6874ad0302ea7033ed7.svg)\n\n**Step 2:** Apply the standard Gauss-Jordan method to transform the matrix $A$ into the identity matrix. We perform the same row operations on both matrices:\n\n$$\n\\begin{aligned}[A\\,|\\,{I}_{2}\\,] & =[\\begin{aligned}1 & 2 & 1 & 0 \\\\ 3 & 7 & 0 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & 1 & 0 \\\\ 0 & 1 & -3 & 1\\end{aligned}] & {R}_{1} & :={R}_{1}+(-2){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 7 & -2 \\\\ 0 & 1 & -3 & 1\\end{aligned}] \\\\  & =[\\,I\\,|\\,{A}^{-1}]\\end{aligned}\n$$\n\nThe matrix $A^{-1}$ is obtained on the right-hand side of our big matrix after the transformation. Therefore, \n\n![](images/b7/b7c08e9a28ebfe456a9d77ccdaf6688893dfd04ba755a989a417c8a43e80ee0c.svg)\n\nWe can easily check our result by computing $AA^{-1}\\mathbin{:}$\n\n$$\n\\begin{aligned}A{A}^{-1} & =[\\begin{aligned}1 & 2 \\\\ 3 & 7\\end{aligned}][\\begin{aligned}7 & -2 \\\\ -3 & 1\\end{aligned}]=[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]\\,✓\\end{aligned}\n$$" :tutorial/id #uuid "fc38ae42-2cd4-53df-9ad5-568d8e3b5fd4" :tutorial/math-academy-id 3167 :tutorial/title "Introduction"} :step/id #uuid "d8efc5ed-eaaf-514d-b03a-248df406a7d5" :step/math-academy-id 17230 :step/next {:db/id #edb/ref 17592186116136}} {:db/id #edb/ref 17592186116134 :step/content {:db/id #edb/ref 17592186115249 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115078 :question/id #uuid "7c480d6a-93a1-56ec-a75c-56402e872c92" :question/math-academy-id "e-4723"} :knowledge-point/id #uuid "b7f42188-bf51-5546-89fb-e33ba47c4b5e" :knowledge-point/questions [{:db/id #edb/ref 17592186115731} {:db/id #edb/ref 17592186115853} {:db/id #edb/ref 17592186299766} {:db/id #edb/ref 17592186329704} {:db/id #edb/ref 17592186345085} {:db/id #edb/ref 17592186383286} {:db/id #edb/ref 17592186398368} {:db/id #edb/ref 17592186398375} {:db/id #edb/ref 17592186401981} {:db/id #edb/ref 17592186401995}] :knowledge-point/title "Determining the Row Operations Required To Find the Inverse of a 2x2 Matrix"} :step/id #uuid "e874c19f-8e51-5ff3-b8d2-dd1a0540bbc2" :step/math-academy-id 17231} {:db/id #edb/ref 17592186116135 :step/content {:db/id #edb/ref 17592186115250 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115079 :question/id #uuid "e13311fb-21de-58d4-aed0-18304b48bb0c" :question/math-academy-id "e-4724"} :knowledge-point/id #uuid "8a4b135f-df0d-5443-bb93-796f32c380c6" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048742}] :knowledge-point/questions [{:db/id #edb/ref 17592186115849} {:db/id #edb/ref 17592186115850} {:db/id #edb/ref 17592186266081} {:db/id #edb/ref 17592186266082} {:db/id #edb/ref 17592186266083} {:db/id #edb/ref 17592186299700} {:db/id #edb/ref 17592186329703} {:db/id #edb/ref 17592186329705} {:db/id #edb/ref 17592186367380} {:db/id #edb/ref 17592186383279} {:db/id #edb/ref 17592186385599} {:db/id #edb/ref 17592186388209} {:db/id #edb/ref 17592186402002} {:db/id #edb/ref 17592186417379}] :knowledge-point/title "Identifying the Inverse of a 2x2 Matrix Calculated Using Row Operations"} :step/id #uuid "7cf9141d-1c90-5675-a333-b0aa4e0f3cef" :step/math-academy-id 17232 :step/next {:db/id #edb/ref 17592186116134}} {:db/id #edb/ref 17592186116136 :step/content {:db/id #edb/ref 17592186115251 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115080 :question/id #uuid "ff4b4389-d8ff-5b48-904b-ff405abb4e48" :question/math-academy-id "e-4725"} :knowledge-point/id #uuid "77d78574-a17c-5fc3-8c14-3aaec7753b3c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048252}] :knowledge-point/questions [{:db/id #edb/ref 17592186115851} {:db/id #edb/ref 17592186115852} {:db/id #edb/ref 17592186265998} {:db/id #edb/ref 17592186266077} {:db/id #edb/ref 17592186345092} {:db/id #edb/ref 17592186345095} {:db/id #edb/ref 17592186345097} {:db/id #edb/ref 17592186345106} {:db/id #edb/ref 17592186345107} {:db/id #edb/ref 17592186417378}] :knowledge-point/title "Transforming a 2x2 Matrix Into the Identity Matrix Using Row Operations"} :step/id #uuid "e2dcd832-c069-5309-a7a3-27850adf28e2" :step/math-academy-id 17233 :step/next {:db/id #edb/ref 17592186116135}}] :activity/title "Finding the Inverse of a 2x2 Matrix Using Row Operations" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186115474}]}
