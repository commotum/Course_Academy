-522f-ba63-0c6f8892c7a1" #edb/ref 17592186045417] [17592186347657 #edb/ref 1075 #edb/ref 17592186345465 #edb/ref 17592186045417] [17592186347657 #edb/ref 1075 #edb/ref 17592186345633 #edb/ref 17592186045417] [17592186347657 #edb/ref 1075 #edb/ref 17592186346122 #edb/ref 17592186045417] [17592186347657 #edb/ref 1075 #edb/ref 17592186346617 #edb/ref 17592186045417] [17592186347657 #edb/ref 1075 #edb/ref 17592186347524 #edb/ref 17592186045417] [17592186347657 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186347657 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186347657 #edb/ref 1078 #edb/ref 17592186346122 #edb/ref 17592186045417] [17592186347657 #edb/ref 1079 #uuid "1ce3662f-50d2-5467-a302-1a748f1ec224" #edb/ref 17592186045417] [17592186347922 #edb/ref 1075 #edb/ref 17592186345578 #edb/ref 17592186045417] [17592186347922 #edb/ref 1075 #edb/ref 17592186345844 #edb/ref 17592186045417] [17592186347922 #edb/ref 1075 #edb/ref 17592186346421 #edb/ref 17592186045417] [17592186347922 #edb/ref 1075 #edb/ref 17592186346551 #edb/ref 17592186045417] [17592186347922 #edb/ref 1075 #edb/ref 17592186347214 #edb/ref 17592186045417] [17592186347922 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186347922 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186347922 #edb/ref 1078 #edb/ref 17592186347214 #edb/ref 17592186045417] [17592186347922 #edb/ref 1079 #uuid "b4ef23ce-41c7-5926-88dd-2b76f64cc792" #edb/ref 17592186045417] [17592186348198 #edb/ref 1068 #edb/ref 17592186347922 #edb/ref 17592186045417] [17592186348198 #edb/ref 1069 "q-79312" #edb/ref 17592186045417] [17592186348198 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186348198 #edb/ref 1071 "$\\text{dim}(\\text{Span}{\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix},\\begin{bmatrix}-1 \\\\ 0 \\\\ 0\\end{bmatrix},\\begin{bmatrix}2 \\\\ 0 \\\\ 0\\end{bmatrix}})=$" #edb/ref 17592186045443] [17592186348198 #edb/ref 1072 #uuid "3bcc7f9f-485e-5418-994c-aa7e3d5166fe" #edb/ref 17592186045417] [17592186348198 #edb/ref 1074 "We start by creating a matrix whose columns are made up of our vectors, and then we reduce the matrix to row echelon form:\n\n$$\n\\begin{aligned}\\begin{bmatrix}1 & -1 & 2 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nIn this case, our matrix is already in a row echelon form.\n\nThe pivot columns correspond to basis vectors, while the non-pivot columns correspond to linearly dependent vectors that can be removed. Here, the reduced matrix has $1$ pivot column (or alternatively, $1$ non-zero row). \n\nTherefore,\n$\\text{dim}(\\text{Span}{\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix},\\begin{bmatrix}-1 \\\\ 0 \\\\ 0\\end{bmatrix},\\begin{bmatrix}2 \\\\ 0 \\\\ 0\\end{bmatrix}})=1.$" #edb/ref 17592186045443] [17592186368716 #edb/ref 1068 #edb/ref 17592186368717 #edb/ref 17592186045417] [17592186368716 #edb/ref 1069 "q-73713" #edb/ref 17592186045417] [17592186368716 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186368716 #edb/ref 1071 "$\\int \\frac{10}{1+4{x}^{2}}\\,\\text{d}x=$" #edb/ref 17592186045417] [17592186368716 #edb/ref 1072 #uuid "c6decd4b-7a1d-5fb8-8bf2-963b2f6581d8" #edb/ref 17592186045417] [17592186368716 #edb/ref 1074 "This integral resembles the basic integral for inverse tangent,\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $4{x}^{2}=(2x)^{2}.$\n\nSo. let's substitute $u=2x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2\\,⟹\\,\\text{d}x=\\frac{1}{2}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{10}{1+4{x}^{2}}\\,\\text{d}x & =10\\int \\frac{1}{1+(2x)^{2}}\\text{d}x \\\\  & =10\\int \\frac{1}{1+{u}^{2}}\\cdot (\\frac{1}{2}\\text{d}u) \\\\  & =5\\int \\frac{1}{1+{u}^{2}}\\text{d}u \\\\  & =5\\operatorname{arctan}⁡u+C \\\\  & =5\\operatorname{arctan}⁡(2x)+C\\end{aligned}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186368717 #edb/ref 1075 #edb/ref 17592186368718 #edb/ref 17592186045417] [17592186368717 #edb/ref 1075 #edb/ref 17592186368719 #edb/ref 17592186045417] [17592186368717 #edb/ref 1075 #edb/ref 17592186368720 #edb/ref 17592186045417] [17592186368717 #edb/ref 1075 #edb/ref 17592186368721 #edb/ref 17592186045417] [17592186368717 #edb/ref 1075 #edb/ref 17592186368722 #edb/ref 17592186045417] [17592186368717 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186368717 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186368717 #edb/ref 1078 #edb/ref 17592186368722 #edb/ref 17592186045417] [17592186368717 #edb/ref 1079 #uuid "4b4164c5-58af-56ae-8f11-f8cd84fa0fda" #edb/ref 17592186045417] [17592186368718 #edb/ref 1080 "\\frac{\\operatorname{arctan}⁡(2x)}{5}+C" #edb/ref 17592186045417] [17592186368718 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186368718 #edb/ref 1083 #uuid "bc0eaaa6-3c74-5955-ab7a-40c09fa2a964" #edb/ref 17592186045417] [17592186368719 #edb/ref 1080 "\\frac{\\operatorname{arcsin}⁡(2x)}{5}+C" #edb/ref 17592186045417] [17592186368719 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186368719 #edb/ref 1083 #uuid "6b672eef-fdca-5016-828c-47d6af33c13e" #edb/ref 17592186045417] [17592186368720 #edb/ref 1080 "5\\operatorname{arctan}⁡x+C" #edb/ref 17592186045417] [17592186368720 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186368720 #edb/ref 1083 #uuid "ce69df23-6261-537f-bc31-f5d9599f5543" #edb/ref 17592186045417] [17592186368721 #edb/ref 1080 "5\\operatorname{arcsin}⁡(2x)+C" #edb/ref 17592186045417] [17592186368721 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186368721 #edb/ref 1083 #uuid "b7c8552a-dd1c-59c6-825b-7bdb5b09d5cc" #edb/ref 17592186045417] [17592186368722 #edb/ref 1080 "5\\operatorname{arctan}⁡(2x)+C" #edb/ref 17592186045417] [17592186368722 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186368722 #edb/ref 1083 #uuid "250a9a15-df5f-58ee-9c74-d26e624f24b9" #edb/ref 17592186045417] [17592186371700 #edb/ref 1068 #edb/ref 17592186454403 #edb/ref 17592186045436] [17592186371700 #edb/ref 1068 #edb/ref 17592186454404 #edb/ref 17592186045436] [17592186371700 #edb/ref 1068 #edb/ref 17592186454405 #edb/ref 17592186045436] [17592186371700 #edb/ref 1069 "q-124332" #edb/ref 17592186045417] [17592186371700 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186371700 #edb/ref 1071 "Consider the affine transformation $T$ defined as\n\n$$\nx=1-v,\\,y=u+2.\n$$\n\nLet $A$ be the matrix representation of the linear transformation associated with $T.$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $A=\\begin{bmatrix}1 & -1 \\\\ 1 & 2\\end{bmatrix}$\n- **II.** $det(A)=1$\n- **III.** The transformation $T$ is orientation-preserving" #edb/ref 17592186045443] [17592186371700 #edb/ref 1072 #uuid "c2b565dd-1238-5428-a4d5-150ac346f6d7" #edb/ref 17592186045417] [17592186371700 #edb/ref 1074 "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nLet's look at each statement in turn:\n\n- Statement I is false. Notice that the given transformation can be expressed as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}1-v, \\\\ u+2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-v \\\\ u\\end{bmatrix}+\\begin{bmatrix}1 \\\\ 2\\end{bmatrix} \\\\  & ={{\\begin{bmatrix}0 & -1 \\\\ 1 & 0\\end{bmatrix}}_{⏟}}_{A}\\cdot {{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u}+{{\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}}_{⏟}}_{b}\\end{aligned}\n$$\n\nTherefore, the matrix representation of the linear transformation associated with $T$ is $A=\\begin{bmatrix}0 & -1 \\\\ 1 & 0\\end{bmatrix}.$\n\n- Statement II is true. Indeed, computing the determinant of $A,$ we get\n\n$$\ndet(A)=\\begin{vmatrix}0 & -1 \\\\ 1 & 0\\end{vmatrix}=0\\cdot 0-(-1)\\cdot 1=1.\n$$\n\n- Statement III is true. Indeed, since $det(A)>0,$ the affine transformation $T$ is orientation-preserving.\n\nTherefore, the correct answer is \"II and III only.\"" #edb/ref 17592186045443] [17592186373175 #edb/ref 1075 #edb/ref 17592186435869 #edb/ref 17592186045417] [17592186373175 #edb/ref 1075 #edb/ref 17592186435871 #edb/ref 17592186045417] [17592186373175 #edb/ref 1075 #edb/ref 17592186435875 #edb/ref 17592186045417] [17592186373175 #edb/ref 1075 #edb/ref 17592186435876 #edb/ref 17592186045417] [17592186373175 #edb/ref 1075 #edb/ref 17592186435884 #edb/ref 17592186045417] [17592186373175 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186373175 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186373175 #edb/ref 1078 #edb/ref 17592186435884 #edb/ref 17592186045417] [17592186373175 #edb/ref 1079 #uuid "257fac2f-8a02-59c7-aca1-ef19cbb1795a" #edb/ref 17592186045417] [17592186375288 #edb/ref 1075 #edb/ref 17592186515155 #edb/ref 17592186045417] [17592186375288 #edb/ref 1075 #edb/ref 17592186515196 #edb/ref 17592186045417] [17592186375288 #edb/ref 1075 #edb/ref 17592186515211 #edb/ref 17592186045417] [17592186375288 #edb/ref 1075 #edb/ref 17592186515222 #edb/ref 17592186045417] [17592186375288 #edb/ref 1075 #edb/ref 17592186515376 #edb/ref 17592186045417] [17592186375288 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186375288 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186375288 #edb/ref 1078 #edb/ref 17592186515376 #edb/ref 17592186045417] [17592186375288 #edb/ref 1079 #uuid "121eed80-0cfa-5e17-b370-61189884e2ef" #edb/ref 17592186045417] [17592186375322 #edb/ref 1075 #edb/ref 17592186375323 #edb/ref 17592186045417] [17592186375322 #edb/ref 1075 #edb/ref 17592186375324 #edb/ref 17592186045417] [17592186375322 #edb/ref 1075 #edb/ref 17592186375325 #edb/ref 17592186045