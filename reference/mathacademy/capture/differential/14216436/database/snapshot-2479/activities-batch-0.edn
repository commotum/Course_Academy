b2b-8d0b-624598682601" :step/next {:db/id #edb/ref 17592186447171}} {:db/id #edb/ref 17592186447173 :step/content {:db/id #edb/ref 17592186162381 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d48c9f9b-3549-5764-b708-d84d1a81277e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.09" :db/id #edb/ref 17592186159489} {:answer/id #uuid "078e2955-6c71-5d06-b3c7-66ce9b2711c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.3" :db/id #edb/ref 17592186159490} {:answer/id #uuid "17f2bf08-271e-5210-9635-b7feef509a21" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.9" :db/id #edb/ref 17592186159491} {:answer/id #uuid "7709bcf7-4a06-5cb8-8170-55b19bc2fce6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.35" :db/id #edb/ref 17592186159492} {:answer/id #uuid "7793508a-e542-5e32-af73-86d3caa2d640" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.55" :db/id #edb/ref 17592186159493}] :answer-field/correct {:db/id #edb/ref 17592186159490} :answer-field/id #uuid "1673aac7-1c38-545e-83b9-0f96062e75d8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186159488}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "503fe913-6b66-5820-b334-367782412a2a" :question/math-academy-id "q-143197" :question/problem "If ${X}_{1},{X}_{2},…,{X}_{100}$ is a sample of size $n=100$ drawn from a population with mean $\\mu =30$ and variance ${\\sigma }^{2}=9,$ calculate the standard error of $\\overset{―}{X}.$" :question/requires-calculator true :question/worked-solution "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ from a population with population mean $\\mu $ and population variance ${\\sigma }^{2},$ then\n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu ,\\,\\text{Var}[\\overset{―}{X}]=\\frac{{\\sigma }^{2}}{n},\n$$\n\nand the standard error is given by\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{\\text{Var}[\\overset{―}{X}]}=\\frac{\\sigma }{\\sqrt{n}}.\n$$\n\nSince the population variance ${\\sigma }^{2}=9$ and the sample size $n=100,$ we have that \n\n$$\n\\begin{aligned}\\text{Var}[\\overset{―}{X}] & =\\frac{9}{100} \\\\  & =0.09.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{0.09}=0.3.\n$$"} :step/id #uuid "e819b894-7ed2-5c6c-9756-eea6cdfe101a" :step/next {:db/id #edb/ref 17592186447169}}] :activity/title "Variance of Sample Means" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186447161}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186491271} :activity/id #uuid "c64c48fd-6421-5002-b8ac-ec2858dbbea6" :activity/scope {:db/id #edb/ref 17592186049674 :topic/id #uuid "09e82368-7656-5709-b72f-b4db605d6406" :topic/math-academy-id 3013} :activity/steps [{:db/id #edb/ref 17592186491224 :step/content {:db/id #edb/ref 17592186491194 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d27b381-2583-5b7a-9fca-f1b985469a8a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.24" :db/id #edb/ref 17592186490564} {:answer/id #uuid "285d902e-e585-5afb-b7d0-a096327f6bdc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.08" :db/id #edb/ref 17592186490584} {:answer/id #uuid "720b4a42-214e-5e9a-9503-6877dcdc5e91" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.28" :db/id #edb/ref 17592186490736} {:answer/id #uuid "88c5126e-12bf-54b2-b915-69e90cd55a29" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.12" :db/id #edb/ref 17592186490783} {:answer/id #uuid "cfaa20be-1127-571b-9b08-97a73a594545" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.36" :db/id #edb/ref 17592186490903}] :answer-field/correct {:db/id #edb/ref 17592186490736} :answer-field/id #uuid "a928408c-e2bb-5ac3-8926-8be8d60e417f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186491068}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "bbae1413-e0da-5920-9a81-9f35b978911e" :question/math-academy-id "q-143422" :question/problem "If ${X}_{1},{X}_{2},…,{X}_{50}$ is a sample of size $n=50$ drawn from a population with mean $\\mu =12$ and variance ${\\sigma }^{2}=4,$ calculate the standard error of $\\overset{―}{X}.$ Round your answer to two decimal places." :question/worked-solution "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ from a population with population mean $\\mu $ and population variance ${\\sigma }^{2},$ then\n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu ,\\,\\text{Var}[\\overset{―}{X}]=\\frac{{\\sigma }^{2}}{n},\n$$\n\nand the standard error is given by\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{\\text{Var}[\\overset{―}{X}]}=\\frac{\\sigma }{\\sqrt{n}}.\n$$\n\nSince the population variance is ${\\sigma }^{2}=4$ and the sample size is $n=50,$ we have that \n\n$$\n\\begin{aligned}\\text{Var}[\\overset{―}{X}] & =\\frac{4}{50} \\\\  & =0.08.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{0.08}≈0.28.\n$$"} :step/id #uuid "145bbf22-1749-5090-aadc-e3554ab59101" :step/next {:db/id #edb/ref 17592186491278}} {:db/id #edb/ref 17592186491233 :step/content {:db/id #edb/ref 17592186491183 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2340fb78-3bc0-52f2-8490-70b953ad6bad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "101" :db/id #edb/ref 17592186490575} {:answer/id #uuid "5361feae-c64c-5ad9-9e88-dc19f7cade4b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "401" :db/id #edb/ref 17592186490670} {:answer/id #uuid "78e50466-a068-54f3-a9e1-1405af2707ba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "201" :db/id #edb/ref 17592186490751} {:answer/id #uuid "96643632-e50d-5725-b254-61e0b31e5d5b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1\\,001" :db/id #edb/ref 17592186490816} {:answer/id #uuid "e63fe34a-b9f7-5470-aaa5-176d56673f6b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "41" :db/id #edb/ref 17592186490951}] :answer-field/correct {:db/id #edb/ref 17592186490575} :answer-field/id #uuid "2aee0077-edc2-5b86-802c-50ab5c7a8951" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186491023}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9f4e58b8-0514-5aa4-9211-b553375a01af" :question/math-academy-id "q-143489" :question/problem "A sample ${X}_{1},{X}_{2},…,{X}_{n}$ of $n$ coins is drawn from a population. The population has coins of two different denominations, $$1$ and $$0.50,$ distributed in the ratio $1:4.$ Determine the smallest sample size required so that the standard error of the mean is less than $$0.02.$" :question/worked-solution "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ from a population with population mean $\\mu $ and population variance ${\\sigma }^{2},$ then\n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu ,\\,\\text{Var}[\\overset{―}{X}]=\\frac{{\\sigma }^{2}}{n},\n$$\n\nand the standard error is given by\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{\\text{Var}[\\overset{―}{X}]}=\\frac{\\sigma }{\\sqrt{n}}.\n$$\n\nWe're told that the coins in the population have denominations $$1$ and $$0.50,$ and these are distributed in the ratio $1:4.$ Therefore, to compute the population's mean and variance, we can consider a population consisting of $1+4=5$ coins only with the following denominations:\n\n$$\n$1,\\,$0.5,\\,$0.5,\\,$0.5,\\,$0.5.\n$$\n\nTherefore, the population mean is\n\n$$\n\\begin{aligned}\\mu  & =\\frac{1}{5}{\\sum }_{i}{x}_{i} \\\\  & =\\frac{1}{5}(1+4\\cdot 0.5) \\\\  & =\\frac{1}{5}(1+2) \\\\  & =\\frac{3}{5} \\\\  & =$0.6,\\end{aligned}\n$$\n\nand the population variance is\n\n$$\n\\begin{aligned}{\\sigma }^{2} & =\\frac{1}{5}{\\sum }_{i}{x}_{i}^{2}-{\\mu }^{2} \\\\  & =\\frac{1}{5}({1}^{2}+4\\cdot {0.5}^{2})-{0.6}^{2} \\\\  & =\\frac{1}{5}(2)-0.36 \\\\  & =0.4-0.36 \\\\  & =0.04.\\end{aligned}\n$$\n\nThus, the population standard deviation is $\\sigma =\\sqrt{0.04}=0.2,$ and we have that \n\n$$\n\\text{SE}[\\overset{―}{X}]=\\frac{0.2}{\\sqrt{n}}.\n$$\n\nWe require that the standard error is less than $$0.02.$ Therefore\n\n$$\n\\begin{aligned}\\frac{0.2}{\\sqrt{n}} & <0.02 \\\\ \\sqrt{n} & >\\frac{0.2}{0.02} \\\\ \\sqrt{n} & >10 \\\\ n & >{10}^{2} \\\\ n & >100.\\end{aligned}\n$$\n\nTherefore, the smallest sample size is $n=101.$"} :step/id #uuid "46254631-f53c-514a-8d4a-8cae395482d2" :step/next {:db/id #edb/ref 17592186491274}} {:db/id #edb/ref 17592186491271 :step/content {:db/id #edb/ref 17592186162382 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "210567c7-e894-5b02-9ee8-c6893172df38" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.18\\,\\text{cm}" :db/id #edb/ref 17592186425735} {:answer/id #uuid "60c93555-b34b-575f-95b2-f38de1599831" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.15\\,\\text{cm}" :db/id #edb/ref 17592186425739} {:answer/id #uuid "ca20eb7d-1ae8-5c45-ab85-1bae5f9c5811" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.32\\,\\text{cm}" :db/id #edb/ref 17592186425747} {:answer/id #uuid "cce28df6-b4e2-5293-9860-139a95e35caa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2.24\\,\\text{cm}" :db/id #edb/ref 17592186425748} {:answer/id #uuid "cfed1752-e352-5a6b-9e2d-7dc6a36ff6ae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.33\\,\\text{cm}" :db/id #edb/ref 17592186425749}] :answer-field/correct {:db/id #edb/ref 17592186425739} :answer-field/id #uuid "e23ca134-e512-533c-83e5-e06d13cf4c5f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186159494}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "bcb58811-e371-5576-bf66-5ecfddbfc1fb" :question/math-academy-id "q-143202" :question/problem "A sample ${X}_{1},{X}_{2},{X}_{3}$ of three nails is drawn from a population. The population has nails of two different lengths, $5\\,\\text{cm}$ and $\\text{10}\\,\\text{cm},$ distributed in the ratio $4:1.$ Calculate the standard error of $\\overset{―}{X}.$ Round your answer to two decimal places." :question/requires-calculator true :question/worked-solution "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ from a population with population mean $\\mu $ and population variance ${\\sigma }^{2},$ then\n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu ,\\,\\text{Var}[\\overset{―}{X}]=\\frac{{\\sigma }^{2}}{n},\n$$\n\nand the standard error is given by\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{\\text{Var}[\\overset{―}{X}]}=\\frac{\\sigma }{\\sqrt{n}}.\n$$\n\nWe're told that the nails in the population have lengths $5\\,\\text{cm}$ and $\\text{10}\\,\\text{cm},$ and these are distributed in the ratio $4:1.$ Therefore, to compute the population mean and variance, we can consider a population consisting of $4+1=5$ nails only with the following lengths:\n\n$$\n5\\,\\text{cm},\\,5\\,\\text{cm},\\,5\\,\\text{cm},\\,5\\,\\text{cm}\\,10\\,\\text{cm}.\n$$\n\nTherefore, the population mean is\n\n$$\n\\begin{aligned}\\mu  & =\\frac{1}{5}{\\sum }_{i}{x}_{i} \\\\  & =\\frac{1}{5}(4\\cdot 5+10) \\\\  & =\\frac{1}{5}(20+10) \\\\  & =\\frac{30}{5} \\\\  & =6\\,\\text{cm},\\end{aligned}\n$$\n\nand the population variance is\n\n$$\n\\begin{aligned}{\\sigma }^{2} & =\\frac{1}{5}{\\sum }_{i}{x}_{i}^{2}-{\\mu }^{2} \\\\  & =\\frac{1}{5}(4\\cdot {5}^{2}+{10}^{2})-{6}^{2} \\\\  & =\\frac{1}{5}(200)-36 \\\\  & =40-36 \\\\  & =4\\,{\\text{cm}}^{2}.\\end{aligned}\n$$\n\nSince the sample size $n=3,$ we have\n\n$$\n\\text{Var}[\\overset{―}{X}]=\\frac{{\\sigma }^{2}}{n}=\\frac{4}{3}\\,{\\text{cm}}^{2}.\n$$\n\nFinally,\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{\\frac{4}{3}}≈1.15\\,\\text{cm}\n$$\n\nrounded to two decimal places."} :step/id #uuid "e09f4a70-dbb4-5510-9c9f-f62ce6e6b9da" :step/next {:db/id #edb/ref 17592186491224}} {:db/id #edb/ref 17592186491274 :step/content {:db/id #edb/ref 17592186491123 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00419cc9-1483-5e06-b0b3-661e4e54899f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186490512} {:answer/id #uuid "47723024-b4a1-584b-a829-85dceb9329c6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186490643} {:answer/id #uuid "80b0e3c0-0da7-58eb-94d5-d78a9853d5ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186490770} {:answer/id #uuid "ccb60d40-47ca-586a-82af-614639d331fc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186490897} {:answer/id #uuid "e18c0630-b233-59ad-b582-a2188863f6f8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16" :db/id #edb/ref 17592186490936}] :answer-field/correct {:db/id #edb/ref 17592186490897} :answer-field/id #uuid "c686f557-e13f-5945-8efd-5e2a53507af7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186491081}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "18073722-b26c-57f1-b864-bfe7c648363b" :question/math-academy-id "q-143495" :question/problem "A sample ${X}_{1},{X}_{2},…,{X}_{n}$ of $n$ shirts is drawn from a population. The population has shirts of two different sizes, $8$ and $10,$ distributed in the ratio $1:3.$ Determine the smallest sample size required so that the standard error of the mean is less than $0.5.$" :question/worked-solution "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ from a population with population mean $\\mu $ and population variance ${\\sigma }^{2},$ then\n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu ,\\,\\text{Var}[\\overset{―}{X}]=\\frac{{\\sigma }^{2}}{n},\n$$\n\nand the standard error is given by\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{\\text{Var}[\\overset{―}{X}]}=\\frac{\\sigma }{\\sqrt{n}}.\n$$\n\nWe're told that the shirts in the population have sizes $8$ and $10,$ and these are distributed in the ratio $1:3.$ Therefore, to compute the population's mean and variance, we can consider a population consisting of $1+3=4$ shirts only with the following sizes:\n\n$$\n8,\\,10,\\,10,\\,10.\n$$\n\nTherefore, the population mean is\n\n$$\n\\begin{aligned}\\mu  & =\\frac{1}{4}{\\sum }_{i}{x}_{i} \\\\  & =\\frac{1}{4}(8+3\\cdot 10) \\\\  & =\\frac{1}{4}(8+30) \\\\  & =\\frac{38}{4} \\\\  & =9.5,\\end{aligned}\n$$\n\nand the population variance is\n\n$$\n\\begin{aligned}{\\sigma }^{2} & =\\frac{1}{4}{\\sum }_{i}{x}_{i}^{2}-{\\mu }^{2} \\\\  & =\\frac{1}{4}({8}^{2}+3\\cdot {10}^{2})-{9.5}^{2} \\\\  & =\\frac{1}{4}(364)-90.25 \\\\  & =91-90.25 \\\\  & =0.75.\\end{aligned}\n$$\n\nThus, the population standard deviation is $\\sigma =\\sqrt{0.75},$ and we have that \n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{\\frac{0.75}{n}}.\n$$\n\nWe require that the standard error is less than $0.5.$ Therefore\n\n$$\n\\begin{aligned}\\sqrt{\\frac{0.75}{n}} & <0.5 \\\\ \\sqrt{n} & >\\frac{\\sqrt{0.75}}{0.5} \\\\ \\sqrt{n} & >\\sqrt{\\frac{0.75}{{0.5}^{2}}} \\\\ \\sqrt{n} & >\\sqrt{\\frac{0.75}{0.25}} \\\\ \\sqrt{n} & >\\sqrt{3} \\\\ n & >3.\\end{aligned}\n$$\n\nTherefore, the smallest sample size is $n=4.$"} :step/id #uuid "f623e816-8a9f-53dc-ac9b-5d259ddbb546"} {:db/id #edb/ref 17592186491278 :step/content {:db/id #edb/ref 17592186491203 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1eb4622f-90b6-5a96-a333-ac1ffe1c4ee6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "122" :db/id #edb/ref 17592186490568} {:answer/id #uuid "7156e35a-a0cd-5c4a-9cfe-86803b267024" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "50" :db/id #edb/ref 17592186490734} {:answer/id #uuid "cad96efa-207b-59ed-9afb-6c27a870f1d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\,305" :db/id #edb/ref 17592186490895} {:answer/id #uuid "db47dba0-0807-5e27-ac1c-6bd558d9926c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186490927} {:answer/id #uuid "dc1775bd-6de6-57e4-b281-5dc5531234f3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186490928}] :answer-field/correct {:db/id #edb/ref 17592186490928} :answer-field/id #uuid "a38d7fe4-d3d9-5f07-8a46-a68180a20afb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186491067}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "df86b42c-6e72-556f-b425-3d68c35d4d8d" :question/math-academy-id "q-143440" :question/problem "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ drawn from a population with mean $\\mu =24$ and variance ${\\sigma }^{2}=1,$  determine the smallest sample size required so that the standard error of the mean is less than $0.5.$" :question/worked-solution "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ from a population with population mean $\\mu $ and population variance ${\\sigma }^{2},$ then\n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu ,\\,\\text{Var}[\\overset{―}{X}]=\\frac{{\\sigma }^{2}}{n},\n$$\n\nand the standard error is given by\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{\\text{Var}[\\overset{―}{X}]}=\\frac{\\sigma }{\\sqrt{n}}\n$$\n\nSince the population standard deviation is $\\sigma =\\sqrt{1}=1,$ we have that \n\n$$\n\\text{SE}[\\overset{―}{X}]=\\frac{1}{\\sqrt{n}}.\n$$\n\nWe require that the standard error is less than $0.5.$ Therefore\n\n$$\n\\begin{aligned}\\frac{1}{\\sqrt{n}} & <0.5 \\\\ \\sqrt{n} & >\\frac{1}{0.5} \\\\ \\sqrt{n} & >2 \\\\ n & >{2}^{2} \\\\ n & >4.\\end{aligned}\n$$\n\nTherefore, the smallest sample size is $n=5.$"} :step/id #uuid "faa8d334-a6c2-5d81-9e07-13cab6f2da50" :step/next {:db/id #edb/ref 17592186491233}}] :activity/title "Variance of Sample Means" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186490511}] [{:activity/expected-seconds 900.0 :activity/first-step {:db/id #edb/ref 17592186120695} :activity/id #uuid "ad4d6410-a365-5f77-a4b1-3e2d134d5a3d" :activity/scope {:db/id #edb/ref 17592186050638 :topic/id #uuid "5ae18ce0-90c2-55f7-8d81-bd5949f05aa3" :topic/math-academy-id 1864} :activity/steps [{:db/id #edb/ref 17592186120695 :step/content {:db/id #edb/ref 17592186121042 :tutorial/content "Given a subspace $H$ with a basis $\\mathcal B = \\{ \\mathbf b_1, \\mathbf b_2 \\}$ and a vector $\\mathbf x \\in H,$ the **coordinates of the vector** $\\mathbf{x}$ **relative to the basis** $\\mathcal{B}$ are the coefficients ${\\color{red} x_1}$ and ${\\color{blue} x_2}$ such that\n\n$$\n{\\color{red}x_1} \\mathbf{b}_1+{\\color{blue}x_2} \\mathbf{b}_2 = \\mathbf{x}.\n$$\n\nWe can write the vector $\\mathbf x$ relative to the basis $\\mathcal B$ using these coordinates, as follows:\n\n![](images/05/0593ca6a838b66c4623e8749eb5236d6259b1f9bf36ed0d68b83c49781076341.svg)\n\nTo demonstrate, consider the basis $\\mathcal{B}=\\{ \\mathbf{b}_1, \\mathbf{b}_2 \\},$ where \n\n![](images/f3/f355faa0c477775f2a1cbb3522d0743cdbc9649a5ee9c55b579b1fac9ae2a661.svg)\n\nAlso let $H = \\textrm{span} \\{ \\mathbf b_1, \\mathbf b_2 \\},$ and consider the vector ![](images/78/78357fcf51c9cd6b7873f5bc35fcc214cb3790bcec00ee69d0932f15aacd39cb.svg)\n\nThe vector $\\mathbf x$ can be expressed as a unique linear combination of $\\mathbf b_1$ and $\\mathbf b_2.$ That is to say, there exist *unique coefficients* $\\color{red}x_1$ and $\\color{blue}x_2$ such that\n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2} & =x \\\\ {x}_{1}\\begin{bmatrix}2 \\\\ 0 \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}1 \\\\ 2 \\\\ 0\\end{bmatrix} & =\\begin{bmatrix}8 \\\\ 4 \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$\n\nLet's solve for these coefficients. From the above, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}2{x}_{1}+{x}_{2} &=8 \\\\ 2{x}_{2} &=4\\end{aligned}\\right.\n$$\n\nThe unique solution of this system is \n\n![](images/82/82d4f494936d23e9b697aa4518edf68f7ea62e504d9d2576a6d13971acaf1c96.svg)\n\nTherefore, we have that \n\n$$\n\\mathbf{x} = {\\color{red}3} \\mathbf{b}_1+ {\\color{blue}2} \\mathbf{b}_2,\n$$\n\nwhich can be visualized as shown below.\n\n![](images/94/94b2934727a32284e9790e59ccd301bd858a0258843314a2968285a5eda7a302.png)" :tutorial/id #uuid "bb4f07e6-7c2f-5fe2-b96b-1bb37603981a" :tutorial/math-academy-id 3208 :tutorial/title "Introduction"} :step/id #uuid "55354f89-d587-5329-9788-b198ebb218a3" :step/math-academy-id 17513 :step/next {:db/id #edb/ref 17592186120696}} {:db/id #edb/ref 17592186120696 :step/content {:db/id #edb/ref 17592186119820 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119631 :question/id #uuid "0a0ea798-5125-5d0e-a755-96bf9af5f543" :question/math-academy-id "e-4823"} :knowledge-point/id #uuid "6e4f1675-9146-5279-9b64-07a63a9bed99" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048499}] :knowledge-point/questions [{:db/id #edb/ref 17592186120379} {:db/id #edb/ref 17592186120382} {:db/id #edb/ref 17592186247247} {:db/id #edb/ref 17592186319177} {:db/id #edb/ref 17592186319186} {:db/id #edb/ref 17592186391910} {:db/id #edb/ref 17592186393563} {:db/id #edb/ref 17592186409817} {:db/id #edb/ref 17592186430732}] :knowledge-point/title "Finding a Vector Given Its Coordinates Relative To a Given Basis"} :step/id #uuid "b2734184-6a42-50f6-9a19-566236b06025" :step/math-academy-id 17514 :step/next {:db/id #edb/ref 17592186120757}} {:db/id #edb/ref 17592186120697 :step/content {:db/id #edb/ref 17592186119821 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119632 :question/id #uuid "6c7237cd-c655-575f-83ac-7a0891c336b2" :question/math-academy-id "e-4824"} :knowledge-point/id #uuid "841f498b-f737-5086-8f79-44f1a143bebb" :knowledge-point/questions [{:db/id #edb/ref 17592186120352} {:db/id #edb/ref 17592186120380} {:db/id #edb/ref 17592186247252} {:db/id #edb/ref 17592186319175} {:db/id #edb/ref 17592186319176} {:db/id #edb/ref 17592186345154} {:db/id #edb/ref 17592186386599} {:db/id #edb/ref 17592186391903} {:db/id #edb/ref 17592186409818} {:db/id #edb/ref 17592186409820} {:db/id #edb/ref 17592186416946} {:db/id #edb/ref 17592186426857} {:db/id #edb/ref 17592186430731}] :knowledge-point/title "Finding the Coordinates of a Vector Relative To a Given Basis Containing Two Vectors"} :step/id #uuid "94aa1ebf-d415-58aa-a0dc-17e8201c1669" :step/math-academy-id 17515 :step/next {:db/id #edb/ref 17592186120698}} {:db/id #edb/ref 17592186120698 :step/content {:db/id #edb/ref 17592186119822 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119633 :question/id #uuid "90f07e38-405a-5f79-8501-0b4dfb8fa4c8" :question/math-academy-id "e-4825"} :knowledge-point/id #uuid "ed6a6ea8-6100-5224-b75f-b87c037fafbb" :knowledge-point/questions [{:db/id #edb/ref 17592186120357} {:db/id #edb/ref 17592186120358} {:db/id #edb/ref 17592186247255} {:db/id #edb/ref 17592186247256} {:db/id #edb/ref 17592186247257} {:db/id #edb/ref 17592186320959} {:db/id #edb/ref 17592186345167} {:db/id #edb/ref 17592186409821} {:db/id #edb/ref 17592186426856} {:db/id #edb/ref 17592186455442} {:db/id #edb/ref 17592186455505}] :knowledge-point/title "Finding the Coordinates of a Vector Relative To a Given Basis Containing More Than Two Vectors"} :step/id #uuid "34b75a42-9505-5418-a27f-2b9aade2bc07" :step/math-academy-id 17516 :step/next {:db/id #edb/ref 17592186120756}} {:db/id #edb/ref 17592186120756 :step/content {:db/id #edb/ref 17592186121066 :tutorial/content "Let's consider a set of vectors\n![](images/0d/0d78e1b2d01003885882f19b3856278e5024719f26f33594fd071fbd73273b71.svg)\n\nNotice that the set $\\mathcal{S}$ is linearly independent since the vector equation $x_1\\mathbf{e}_1+x_2\\mathbf{e}_2+x_3\\mathbf{e}_3=\\mathbf{0}$ leads to the system\n\n$$\n\\left\\{\\begin{aligned}{x}_{1} &=0 \\\\ {x}_{2} &=0 \\\\ {x}_{3} &=0,\\end{aligned}\\right.\n$$\n\nwhich has only the zero solution. \n\nAlso, notice that any vector in $\\mathbb{R}^3$ can be written as a linear combination of $\\mathbf{e}_1,$ $\\mathbf{e}_2,$ and $\\mathbf{e}_3.$ For instance,\n![](images/ef/ef28dd8cbad6d256b9fa82c487263af3327ce630839cfcd1c7433417d0e0ae73.svg)\n\nIn particular, the equation above tells us that \n![](images/72/724f42afb534edbde7588c5508a4bf8de6d3cd068bc2989da7c7207b1bf7a1ba.svg)\nthat is to say, the numbers $\\color{red}-2,$ $\\color{red}0,$ $\\color{red}5$ are the coordinates of $\\mathbf{v}$ relative to the basis $\\mathcal{S}.$ \n\nThe basis $\\mathcal{S}$ is somewhat special, since the coordinates of a vector relative to this basis coincide with the components of the vector. We refer to $\\mathcal{S}$ as the **standard basis**. Remember that in $\\mathbb{R}^2$ and $\\mathbb{R}^3$ we even have special notations for the vectors of the standard basis:\n![](images/ae/aee5dd3226ebe950defc8b873399a884e0679ce701a3a55354ef01960e029f8e.svg)\n\n![](images/dd/dd96e0b70173adf8983feb4975c351ab3e417c34ed4a6a944bc391e33db4c8e9.png)\n\nIn general, the standard basis of $\\mathbb{R}^n$ is\n\n![](images/a8/a8e4b648898c0dc036e228fb84945833dc40c053beff034596e098c4dd077e23.svg)" :tutorial/id #uuid "54e7c1fd-c7bf-5c77-bcc5-eb8d93a11582" :tutorial/math-academy-id 3969 :tutorial/title "The Standard Basis"} :step/id #uuid "9053925c-8744-5312-b890-f5e4a1a8d2e8" :step/math-academy-id 23574} {:db/id #edb/ref 17592186120757 :step/content {:db/id #edb/ref 17592186119859 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119674 :question/id #uuid "a79126f2-e26c-5929-93d8-825d85b9a438" :question/math-academy-id "e-6282"} :knowledge-point/id #uuid "a2926764-dfbc-5e4e-a6b0-db24a7298a64" :knowledge-point/questions [{:db/id #edb/ref 17592186120525} {:db/id #edb/ref 17592186120526} {:db/id #edb/ref 17592186247248} {:db/id #edb/ref 17592186247249} {:db/id #edb/ref 17592186247250} {:db/id #edb/ref 17592186345146} {:db/id #edb/ref 17592186345147} {:db/id #edb/ref 17592186345150} {:db/id #edb/ref 17592186345152} {:db/id #edb/ref 17592186409819} {:db/id #edb/ref 17592186527961}] :knowledge-point/title "Finding the Coordinates of a Vector Relative To a Given Basis by Inspection"} :step/id #uuid "79095f38-ffd3-565b-a534-f136c7646422" :step/math-academy-id 23612 :step/next {:db/id #edb/ref 17592186120697}}] :activity/title "Expressing the Coordinates of a Vector in a Given Basis" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186120054}] [{:activity/course {:db/id #edb/ref 17592186046673} :activity/first-step {:db/id #edb/ref 17592186416947} :activity/id #uuid "e9bd4727-090c-5259-8cb9-53f91a718d53" :activity/scope {:db/id #edb/ref 17592186050638 :topic/id #uuid "5ae18ce0-90c2-55f7-8d81-bd5949f05aa3" :topic/math-academy-id 1864} :activity/steps [{:db/id #edb/ref 17592186416947 :step/content {:db/id #edb/ref 17592186416946 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "54b2da92-80e1-5a61-a19c-e0402c5db36e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186416936} {:answer/id #uuid "94ec8a9d-591d-59ec-b9c5-a655500ebc04" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186416937} {:answer/id #uuid "c791cf81-feb5-59a1-bf25-b0be74c138f2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\notin \\text{span}{{b}_{1},{b}_{2}}" :db/id #edb/ref 17592186416940} {:answer/id #uuid "ccdbeb50-bd46-5e6a-a5d9-d2fa3f1bb293" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186416942} {:answer/id #uuid "f2716f4b-b756-5daf-b7ff-420d367fb480" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186416943}] :answer-field/correct {:db/id #edb/ref 17592186416936} :answer-field/id #uuid "9bd25317-6ae7-5ed2-b2f8-06a74441129a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186416944}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1098aac8-90b3-5ba0-b447-7ead2947d568" :question/math-academy-id "q-35247" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B={{b}_{1},{b}_{2}},$ where\n\n$$\n{b}_{1}=\\begin{bmatrix}3 \\\\ 9 \\\\ -12\\end{bmatrix},\\,{b}_{2}=\\begin{bmatrix}-4 \\\\ -8 \\\\ 16\\end{bmatrix},\\,x=\\begin{bmatrix}-8 \\\\ -4 \\\\ 32\\end{bmatrix}.\n$$\n\nIf $[x]_{B}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}$ then what is the value of ${x}_{1}+{x}_{2}?$" :question/worked-solution "We need to find ${x}_{1}$ and ${x}_{2}$ such that  \n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2} & =x \\\\ {x}_{1}\\begin{bmatrix}3 \\\\ 9 \\\\ -12\\end{bmatrix}+{x}_{2}\\begin{bmatrix}-4 \\\\ -8 \\\\ 16\\end{bmatrix} & =\\begin{bmatrix}-8 \\\\ -4 \\\\ 32\\end{bmatrix}.\\end{aligned}\n$$\n\nThe equation above gives the system with the augmented matrix \n\n$$\nM=\\begin{bmatrix}3 & -4 & -8 \\\\ 9 & -8 & -4 \\\\ -12 & 16 & 32\\end{bmatrix}.\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}3 & -4 & -8 \\\\ 9 & -8 & -4 \\\\ -12 & 16 & 32\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\begin{bmatrix}3 & -4 & -8 \\\\ 0 & 4 & 20 \\\\ -12 & 16 & 32\\end{bmatrix} & {R}_{3} & :={R}_{3}+4{R}_{1} \\\\  & ∼\\begin{bmatrix}3 & -4 & -8 \\\\ 0 & 4 & 20 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\n \n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}3{x}_{1}-4{x}_{2} &=-8 \\\\ 4{x}_{2} &=20.\\end{aligned}\\right.\n$$\n\nFrom the second equation, we get ${x}_{2}=5.$ Substituting this into the first equation, we obtain\n\n$$\n3{x}_{1}-4(5)=-8\\,⟹\\,{x}_{1}=4.\n$$\n\nTherefore, $[x]_{B}=\\begin{bmatrix}4 \\\\ 5\\end{bmatrix}.$\n\nFinally, ${x}_{1}+{x}_{2}=4+5=9.$"} :step/id #uuid "52d64f85-27e5-5e6b-8c92-f165572fe095" :step/next {:db/id #edb/ref 17592186416948}} {:db/id #edb/ref 17592186416948 :step/content {:db/id #edb/ref 17592186120525 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04f5fc79-efcf-5beb-8f44-6c5bbee2e205" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\notin \\text{Span}{{b}_{1},{b}_{2}}" :db/id #edb/ref 17592186416934} {:answer/id #uuid "460c227b-da50-5240-a61b-5d7158cbefb0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186416935} {:answer/id #uuid "b96e7099-61f5-552d-a37f-75ea4d0acd7b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186416938} {:answer/id #uuid "c28d8b2c-0794-5b52-be1a-1a5068c24206" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186416939} {:answer/id #uuid "ca59db9a-208c-56e6-9d14-d390aecd3368" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186416941}] :answer-field/correct {:db/id #edb/ref 17592186416935} :answer-field/id #uuid "c652bfa5-8e6a-53fc-ad6f-da352c6f194d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186416945}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "93dd069a-4710-5057-b8fe-736d3ab4c0dc" :question/math-academy-id "q-75844" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B={{b}_{1},{b}_{2}},$ where\n\n$$\n{b}_{1}=\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix},\\,{b}_{2}=\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix},\\,x=\\begin{bmatrix}0 \\\\ -4 \\\\ 2\\end{bmatrix}.\n$$\n\nIf $[x]_{B}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}$ then what is the value of ${x}_{2}?$" :question/worked-solution "Remember, the order of the vectors in a basis is important.\n\nNotice that \n\n$$\n{{\\begin{bmatrix}0 \\\\ -4 \\\\ 2\\end{bmatrix}}_{⏟}}_{x}={{(\\,2\\,)}_{⏟}}_{{x}_{1}}\\cdot {{\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}}_{⏟}}_{{b}_{1}}+{{(\\,-4\\,)}_{⏟}}_{{x}_{2}}\\cdot {{\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}}_{⏟}}_{{b}_{2}}\n$$\n\nwhich means that\n\n$$\nx=2\\cdot {b}_{1}+(-4)\\cdot {b}_{2}\n$$\n\nand therefore\n\n$$\n[x]_{B}=\\begin{bmatrix}2 \\\\ -4\\end{bmatrix}.\n$$\n\nFinally, we have that ${x}_{2}=-4.$"} :step/id #uuid "598de137-99ae-5ba2-ac49-2dd82ea7ee2f" :step/next {:db/id #edb/ref 17592186416949}} {:db/id #edb/ref 17592186416949 :step/content {:db/id #edb/ref 17592186409821 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0470cd3b-2bcb-575e-9def-d43004406207" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186409787} {:answer/id #uuid "a3e208c3-ba1a-51ec-b367-c2784fabe06c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186409800} {:answer/id #uuid "a5ba42a7-b00b-5980-9f89-48160c1eb49e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\notin \\text{Span}{{b}_{1},{b}_{2},{b}_{3}}" :db/id #edb/ref 17592186409801} {:answer/id #uuid "d13c159c-f442-5933-a821-d94880c3ba32" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5" :db/id #edb/ref 17592186409806} {:answer/id #uuid "eec553dd-6fd7-5208-9292-850213e9c19b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186409809}] :answer-field/correct {:db/id #edb/ref 17592186409801} :answer-field/id #uuid "a79bee7d-12b6-5017-ae13-ca00a861bd24" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186409812}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "ec45397c-5ced-5a47-b9a9-86c6aa1d1bf3" :question/math-academy-id "q-76073" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B={{b}_{1},{b}_{2},{b}_{3}},$ where\n\n$$\n{b}_{1}=\\begin{bmatrix}1 \\\\ -1 \\\\ 0 \\\\ 0\\end{bmatrix},\\,{b}_{2}=\\begin{bmatrix}-1 \\\\ 0 \\\\ 1 \\\\ 0\\end{bmatrix},\\,{b}_{3}=\\begin{bmatrix}0 \\\\ -1 \\\\ 1 \\\\ 0\\end{bmatrix},\\,x=\\begin{bmatrix}5 \\\\ -5 \\\\ 5 \\\\ 0\\end{bmatrix}.\n$$\n\nIf $[x]_{B}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}$ then what is the value of ${x}_{1}+{x}_{2}+{x}_{3}?$" :question/worked-solution "We need to find ${x}_{1}$,  ${x}_{2}$, and ${x}_{3}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2}+{x}_{3}{b}_{3} & =x \\\\ {x}_{1}\\begin{bmatrix}1 \\\\ -1 \\\\ 0 \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}-1 \\\\ 0 \\\\ 1 \\\\ 0\\end{bmatrix}+{x}_{3}\\begin{bmatrix}0 \\\\ -1 \\\\ 1 \\\\ 0\\end{bmatrix} & =\\begin{bmatrix}5 \\\\ -5 \\\\ 5 \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$\n\nFrom this, we get the system with the augmented matrix $M$, which we reduce using Gaussian elimination:\n\n$$\n\\begin{aligned}M= & \\begin{bmatrix}1 & -1 & 0 & 5 \\\\ -1 & 0 & -1 & -5 \\\\ 0 & 1 & 1 & 5 \\\\ 0 & 0 & 0 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}+{R}_{1} \\\\ ∼ & \\begin{bmatrix}1 & -1 & 0 & 5 \\\\ 0 & -1 & -1 & 0 \\\\ 0 & 1 & 1 & 5 \\\\ 0 & 0 & 0 & 0\\end{bmatrix} & {R}_{3} & :={R}_{3}+{R}_{2} \\\\ ∼ & \\begin{bmatrix}1 & -1 & 0 & 5 \\\\ 0 & -1 & -1 & 0 \\\\ 0 & 0 & 0 & 5 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}\\,\\,{x}_{1}-{x}_{2} &=5 \\\\ \\,\\,-{x}_{2}-{x}_{3} &=0 \\\\ \\,\\,0 &=5,\\end{aligned}\\right.\n$$\n\nwhere the third equation is always false. Therefore, the system has no solution and we conclude that \n\n$$\nx\\notin \\text{Span}{{b}_{1},{b}_{2},{b}_{3}}.\n$$"} :step/id #uuid "6074dbdf-0c2f-509e-aa43-e4c385bf7861"}] :activity/title "Expressing the Coordinates of a Vector in a Given Basis" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186416933}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186426858} :activity/id #uuid "7b9fccdb-a888-5b80-9f71-5e4ef95dcf8c" :activity/scope {:db/id #edb/ref 17592186050638 :topic/id #uuid "5ae18ce0-90c2-55f7-8d81-bd5949f05aa3" :topic/math-academy-id 1864} :activity/steps [{:db/id #edb/ref 17592186426858 :step/content {:db/id #edb/ref 17592186426856 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e83f3a8-e73e-5dcd-ac90-e7fbd7a63237" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186426844} {:answer/id #uuid "1298c82b-5f34-5b3d-9a2e-19a4db3c3122" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186426845} {:answer/id #uuid "6f2c222c-23e3-58cc-87ec-9f7920cb1f7d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5" :db/id #edb/ref 17592186426847} {:answer/id #uuid "b92f0488-96a7-580a-9581-5603eab3169c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186426851} {:answer/id #uuid "ef9d08f1-fc9e-5876-bc5a-62f5443e92fe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\notin \\text{span}\\{{b}_{1},{b}_{2}\\}" :db/id #edb/ref 17592186426853}] :answer-field/correct {:db/id #edb/ref 17592186426845} :answer-field/id #uuid "3659e401-201b-5665-a817-8016820a5661" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186426854}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "973ba0d1-71e0-5bd1-b707-8f3f23076709" :question/math-academy-id "q-34761" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B=\\{{b}_{1},{b}_{2},{b}_{3}\\},$ where\n\n$$\n{b}_{1}=\\begin{bmatrix}1 \\\\ -3 \\\\ 0\\end{bmatrix},\\,{b}_{2}=\\begin{bmatrix}4 \\\\ 0 \\\\ -6\\end{bmatrix},\\,{b}_{3}=\\begin{bmatrix}0 \\\\ 2 \\\\ 0\\end{bmatrix},\\,x=\\begin{bmatrix}6 \\\\ -2 \\\\ -6\\end{bmatrix}.\n$$\n\nIf $[x]_{B}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}$ then what is the value of ${x}_{1}+{x}_{2}+{x}_{3}?$" :question/worked-solution "We need to find ${x}_{1}$,  ${x}_{2}$, and ${x}_{3}$ such that  \n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2}+{x}_{3}{b}_{3} & =x \\\\ {x}_{1}\\begin{bmatrix}1 \\\\ -3 \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}4 \\\\ 0 \\\\ -6\\end{bmatrix}+{x}_{3}\\begin{bmatrix}0 \\\\ 2 \\\\ 0\\end{bmatrix} & =\\begin{bmatrix}6 \\\\ -2 \\\\ -6\\end{bmatrix}.\\end{aligned}\n$$\n\nFrom this, we get the system with the augmented matrix $M$, which we reduce using Gaussian elimination: \n\n$$\n\\begin{aligned}M= & \\begin{bmatrix}1 & 4 & 0 & 6 \\\\ -3 & 0 & 2 & -2 \\\\ 0 & -6 & 0 & -6\\end{bmatrix} & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\ ∼ & \\begin{bmatrix}1 & 4 & 0 & 6 \\\\ 0 & 12 & 2 & 16 \\\\ 0 & -6 & 0 & -6\\end{bmatrix} & {R}_{3} & :={R}_{3}+\\frac{1}{2}{R}_{2} \\\\ ∼ & \\begin{bmatrix}1 & 4 & 0 & 6 \\\\ 0 & 12 & 2 & 16 \\\\ 0 & 0 & 1 & 2\\end{bmatrix}\\end{aligned}\n$$\n\n  \n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+4{x}_{2} &=6 \\\\ 12{x}_{2}+2{x}_{3} &=16 \\\\ {x}_{3} &=2.\\end{aligned}\\right.\n$$\n\nFrom the third equation, we get ${x}_{3}=2.$ Substituting this into the second  equation yields\n\n$$\n12{x}_{2}+2(2)=16\\,⟹\\,{x}_{2}=1.\n$$\n\n Finally,  by substituting ${x}_{2}=1$ into the first equation we obtain \n\n$$\n{x}_{1}+4(1)=6\\,⟹\\,{x}_{1}=2.\n$$\n\nTherefore, $[x]_{B}=\\begin{bmatrix}2 \\\\ 1 \\\\ 2\\end{bmatrix}.$\n\nSo, we have \n\n$$\n{x}_{1}+{x}_{2}+{x}_{3}=2+1+2=5.\n$$"} :step/id #uuid "23a4ea36-89a6-56d3-bf56-d577c8099f1a" :step/next {:db/id #edb/ref 17592186426860}} {:db/id #edb/ref 17592186426859 :step/content {:db/id #edb/ref 17592186247257 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c86a8e6-6f85-5aa5-ae6d-29029bdec356" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186245272} {:answer/id #uuid "9aad1bac-86db-5804-9c07-c985acb44877" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186245681} {:answer/id #uuid "a44bbdac-4145-547d-a028-c0ec1721745f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186245782} {:answer/id #uuid "d577a31d-6124-5fbe-949c-907e0f506fb8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186246217} {:answer/id #uuid "f3d6cf3f-5569-5d37-8bae-a5a9fd24ed99" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186246466}] :answer-field/correct {:db/id #edb/ref 17592186245681} :answer-field/id #uuid "cb99454a-a003-5139-9346-c2529872576e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186246914}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "fb853955-e8ef-5657-bd4c-789f3e409e20" :question/math-academy-id "q-112291" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B=\\{{b}_{1},{b}_{2},{b}_{3}\\},$ where\n\n$$\n{b}_{1}=\\begin{bmatrix}1 \\\\ -2 \\\\ 4\\end{bmatrix},\\,{b}_{2}=\\begin{bmatrix}1 \\\\ -3 \\\\ -2\\end{bmatrix},\\,{b}_{3}=\\begin{bmatrix}0 \\\\ -2 \\\\ -4\\end{bmatrix},\\,x=\\begin{bmatrix}7 \\\\ -15 \\\\ 6\\end{bmatrix}.\n$$\n\nIf $[x]_{B}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}$ then what is the value of ${x}_{1}+{x}_{2}+{x}_{3}?$" :question/worked-solution "We need to find ${x}_{1}$,  ${x}_{2}$, and ${x}_{3}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2}+{x}_{3}{b}_{3} & =x \\\\ {x}_{1}\\begin{bmatrix}1 \\\\ -2 \\\\ 4\\end{bmatrix}+{x}_{2}\\begin{bmatrix}1 \\\\ -3 \\\\ -2\\end{bmatrix}+{x}_{3}\\begin{bmatrix}0 \\\\ -2 \\\\ -4\\end{bmatrix} & =\\begin{bmatrix}7 \\\\ -15 \\\\ 6\\end{bmatrix}.\\end{aligned}\n$$\n\nFrom this, we get the system with the augmented matrix $M$, which we reduce using Gaussian elimination:\n\n$$\n\\begin{aligned}M= & \\begin{bmatrix}1 & 1 & 0 & 7 \\\\ -2 & -3 & -2 & -15 \\\\ 4 & -2 & -4 & 6\\end{bmatrix} & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\ ∼ & \\begin{bmatrix}1 & 1 & 0 & 7 \\\\ 0 & -1 & -2 & -1 \\\\ 4 & -2 & -4 & 6\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-4){R}_{1} \\\\ ∼ & \\begin{bmatrix}1 & 1 & 0 & 7 \\\\ 0 & -1 & -2 & -1 \\\\ 0 & -6 & -4 & -22\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-6){R}_{2} \\\\ ∼ & \\begin{bmatrix}1 & 1 & 0 & 7 \\\\ 0 & -1 & -2 & -1 \\\\ 0 & 0 & 8 & -16\\end{bmatrix}\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+{x}_{2} &=7 \\\\ -{x}_{2}-2{x}_{3} &=-1 \\\\ 8{x}_{3} &=-16.\\end{aligned}\\right.\n$$\n\nFrom third equation we get ${x}_{3}=-2$ and substituting this value into the second equation yields ${x}_{2}=-2(-2)+1=5.$ Finally, substituting ${x}_{2}=5$ into the first equation, we obtain\n\n$$\n{x}_{1}+5=7\\,⟹\\,{x}_{1}=2.\n$$\n\nTherefore, $[x]_{B}=\\begin{bmatrix}2 \\\\ 5 \\\\ -2\\end{bmatrix}.$\n\nFinally, \n\n$$\n{x}_{1}+{x}_{2}+{x}_{3}=2+5+(-2)=5.\n$$"} :step/id #uuid "500d3e2f-f405-56db-9c0b-61c6afc8b340"} {:db/id #edb/ref 17592186426860 :step/content {:db/id #edb/ref 17592186345147 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10b3425c-3f4f-50ac-9c9d-0a2e7c77dbbd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186342384} {:answer/id #uuid "429a3619-daf6-5115-8c01-735449d7217d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186342791} {:answer/id #uuid "6ca6b908-2e20-5cef-bb8b-aa67933e5937" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186343166} {:answer/id #uuid "7becf401-33da-536b-bc10-f41539c33323" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186343306} {:answer/id #uuid "868ebaf6-e3a5-54f9-a3a1-db42d06e7646" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186343397}] :answer-field/correct {:db/id #edb/ref 17592186343397} :answer-field/id #uuid "737ac1c3-2191-5acf-acad-aaac5e91f2b2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186344701}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cfe9fa20-a503-5468-a775-31a4b970b2ec" :question/math-academy-id "q-75973" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B=\\{{b}_{1},{b}_{2}\\},$ where\n\n$$\n{b}_{1}=\\begin{bmatrix}0 \\\\ 1\\end{bmatrix},\\,{b}_{2}=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix},\\,x=\\begin{bmatrix}-3 \\\\ 4\\end{bmatrix}.\n$$\n\nIf $[x]_{B}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}$ then what is the value of ${x}_{2}?$" :question/worked-solution "Remember, the order of the vectors in a basis is important.\n\nNotice that \n\n$$\n{{\\begin{bmatrix}-3 \\\\ 4\\end{bmatrix}}_{⏟}}_{x}={{(\\,4\\,)}_{⏟}}_{{x}_{1}}\\cdot {{\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}}_{⏟}}_{{b}_{1}}+{{(\\,-3\\,)}_{⏟}}_{{x}_{2}}\\cdot {{\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}}_{⏟}}_{{b}_{2}}\n$$\n\nwhich means that\n\n$$\nx=4\\cdot {b}_{1}+(-3)\\cdot {b}_{2}\n$$\n\nand therefore\n\n$$\n[x]_{B}=\\begin{bmatrix}4 \\\\ \\,\\,-3\\end{bmatrix}.\n$$\n\nFinally, we have that ${x}_{2}=-3.$"} :step/id #uuid "620d8ecf-1f15-5e8d-9b5a-7ce1565395d4" :step/next {:db/id #edb/ref 17592186426861}} {:db/id #edb/ref 17592186426861 :step/content {:db/id #edb/ref 17592186247248 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41cb02b9-13f3-5f1d-bb94-34c18d18a3a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186244889} {:answer/id #uuid "6bdc01cf-2d88-5f1d-918a-b6b8c908df28" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186245269} {:answer/id #uuid "7ddf9142-c44c-55fc-9780-62e19815fce1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186245422} {:answer/id #uuid "f2a4d81c-2941-5f57-a05a-cf24897f52ce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186246455} {:answer/id #uuid "b24cff0c-453c-54bf-b5a0-92ed0ff4ac54" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\notin \\text{Span}\\{{b}_{1},{b}_{2}\\}" :db/id #edb/ref 17592186426850}] :answer-field/correct {:db/id #edb/ref 17592186245269} :answer-field/id #uuid "306483a6-036f-5c40-8757-606ab6fe2509" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186246624}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "df51ea15-f830-55ce-a2e9-e42267e5f4de" :question/math-academy-id "q-112203" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B=\\{{b}_{1},{b}_{2}\\},$ where\n\n$$\n{b}_{1}=\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix},\\,{b}_{2}=\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix},\\,x=\\begin{bmatrix}0 \\\\ 8 \\\\ 3\\end{bmatrix}.\n$$\n\nIf $[x]_{B}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}$ then what is the value of ${x}_{1}?$" :question/worked-solution "Remember, the order of the vectors in a basis is important.\n\nNotice that \n\n$$\n{{\\begin{bmatrix}0 \\\\ 8 \\\\ 3\\end{bmatrix}}_{⏟}}_{x}={{(\\,3\\,)}_{⏟}}_{{x}_{1}}\\cdot {{\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}}_{⏟}}_{{b}_{1}}+{{(\\,8\\,)}_{⏟}}_{{x}_{2}}\\cdot {{\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}}_{⏟}}_{{b}_{2}}\n$$\n\nwhich means that\n\n$$\nx=3\\cdot {b}_{1}+8\\cdot {b}_{2}\n$$\n\nand therefore\n\n$$\n[x]_{B}=\\begin{bmatrix}3 \\\\ 8\\end{bmatrix}.\n$$\n\nFinally, we have that ${x}_{1}=3.$"} :step/id #uuid "661bfcf4-d5c1-5b96-9534-b39e2fc11947" :step/next {:db/id #edb/ref 17592186426862}} {:db/id #edb/ref 17592186426862 :step/content {:db/id #edb/ref 17592186426857 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06febdbc-65f9-5901-99f7-6a7827495ba9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\notin \\text{Span}\\{{b}_{1},{b}_{2}\\}" :db/id #edb/ref 17592186426843} {:answer/id #uuid "5fac1657-f0bf-58cd-839a-2936f55e9617" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186426846} {:answer/id #uuid "922920ae-5499-5f5e-8c1f-2a7d78b98e5b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186426848} {:answer/id #uuid "a26be051-5458-55a3-b657-078318cd500e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-7" :db/id #edb/ref 17592186426849} {:answer/id #uuid "de386f32-9648-5557-95da-e81b5a893cdb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186426852}] :answer-field/correct {:db/id #edb/ref 17592186426849} :answer-field/id #uuid "6dbd70cc-1860-587f-a06b-f6be24d7a7e1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186426855}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ad22bfb4-da83-594b-af3c-ca1a05478310" :question/math-academy-id "q-112247" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B=\\{{b}_{1},{b}_{2}\\},$ where\n\n$$\n{b}_{1}=\\begin{bmatrix}1 \\\\ -3\\end{bmatrix},\\,{b}_{2}=\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix},\\,x=\\begin{bmatrix}2 \\\\ 9\\end{bmatrix}.\n$$\n\nIf $[x]_{B}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}$ then what is the value of ${x}_{1}+{x}_{2}?$" :question/worked-solution "We need to find ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2} & =x \\\\ {x}_{1}\\begin{bmatrix}1 \\\\ -3\\end{bmatrix}+{x}_{2}\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix} & =\\begin{bmatrix}2 \\\\ 9\\end{bmatrix}.\\end{aligned}\n$$\n\nThe equation above gives the system with the augmented matrix\n\n$$\nM=\\begin{bmatrix}1 & -2 & 2 \\\\ -3 & 1 & 9\\end{bmatrix}.\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -2 & 2 \\\\ -3 & 1 & 9\\end{bmatrix} & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 & 2 \\\\ 0 & -5 & 15\\end{bmatrix}\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-2{x}_{2} &=2 \\\\ -5{x}_{2} &=15.\\end{aligned}\\right.\n$$\n\nFrom the second equation, we get ${x}_{2}=-3.$ Substituting this into the first equation, we obtain\n\n$$\n{x}_{1}-2(-3)=2\\,⟹\\,{x}_{1}=-4.\n$$\n\nTherefore, $[x]_{B}=\\begin{bmatrix}-4 \\\\ -3\\end{bmatrix}.$\n\nFinally, ${x}_{1}+{x}_{2}=(-4)+(-3)=-7.$"} :step/id #uuid "f56d58dc-6376-5d83-8bb7-3af73050ef21" :step/next {:db/id #edb/ref 17592186426859}}] :activity/title "Expressing the Coordinates of a Vector in a Given Basis" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186426842}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186455517} :activity/id #uuid "dd948f84-01c7-51cf-b5c9-f9c00a2b84b8" :activity/scope {:db/id #edb/ref 17592186050638 :topic/id #uuid "5ae18ce0-90c2-55f7-8d81-bd5949f05aa3" :topic/math-academy-id 1864} :activity/steps [{:db/id #edb/ref 17592186455516 :step/content {:db/id #edb/ref 17592186455442 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "066bb7c4-7521-5727-993a-55db17b87282" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186454919} {:answer/id #uuid "49378edd-134f-5712-a720-7f1c131c32c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186455026} {:answer/id #uuid "a6f74b12-935c-5e33-a5e5-220baef222b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\notin \\text{Span}\\{{b}_{1},{b}_{2},{b}_{3}\\}" :db/id #edb/ref 17592186455198} {:answer/id #uuid "b4852b6d-9a78-5d08-bc44-0fc169587a8b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186455217} {:answer/id #uuid "f9fc417c-d758-5208-baf3-43da35bca066" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186455333}] :answer-field/correct {:db/id #edb/ref 17592186455333} :answer-field/id #uuid "8aa3925e-da8c-56e5-b9b6-c047f1edb4c2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186455385}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "3d89aeef-7acc-5575-9764-44e144045f82" :question/math-academy-id "q-75998" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B=\\{{b}_{1},{b}_{2},{b}_{3}\\},$ where\n\n$$\n{b}_{1}=\\begin{bmatrix}1 \\\\ 3 \\\\ 2\\end{bmatrix},\\,{b}_{2}=\\begin{bmatrix}1 \\\\ 2 \\\\ 2\\end{bmatrix},\\,{b}_{3}=\\begin{bmatrix}1 \\\\ 1 \\\\ -1\\end{bmatrix},\\,x=\\begin{bmatrix}6 \\\\ 11 \\\\ 6\\end{bmatrix}.\n$$\n\nIf $[x]_{B}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}$ then what is the value of ${x}_{1}?$" :question/worked-solution "We need to find ${x}_{1}$,  ${x}_{2}$, and ${x}_{3}$ such that  \n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2}+{x}_{3}{b}_{3} & =x \\\\ {x}_{1}\\begin{bmatrix}1 \\\\ 3 \\\\ 2\\end{bmatrix}+{x}_{2}\\begin{bmatrix}1 \\\\ 2 \\\\ 2\\end{bmatrix}+{x}_{3}\\begin{bmatrix}1 \\\\ 1 \\\\ -1\\end{bmatrix} & =\\begin{bmatrix}6 \\\\ 11 \\\\ 6\\end{bmatrix}.\\end{aligned}\n$$\n\nFrom this, we get the system with the augmented matrix $M$, which we reduce using Gaussian elimination: \n\n$$\n\\begin{aligned}M= & \\begin{bmatrix}1 & 1 & 1 & 6 \\\\ 3 & 2 & 1 & 11 \\\\ 2 & 2 & -1 & -6\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\ ∼ & \\begin{bmatrix}1 & 1 & 1 & 6 \\\\ 0 & -1 & -2 & 7 \\\\ 2 & 2 & -1 & -6\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-2){R}_{2} \\\\ ∼ & \\begin{bmatrix}1 & 1 & 1 & 6 \\\\ 0 & -1 & -2 & -7 \\\\ 0 & 0 & -3 & -6\\end{bmatrix}\\end{aligned}\n$$\n\n  \n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+{x}_{2}+{x}_{3} &=6 \\\\ -{x}_{2}-2{x}_{3} &=-7 \\\\ -3{x}_{3} &=-6.\\end{aligned}\\right.\n$$\n\nFrom the third equation, we get ${x}_{3}=2.$ Substituting this into the second   equation yields\n\n$$\n-{x}_{2}-2(2)=-7\\,⟹\\,{x}_{2}=3.\n$$\n\n Finally,  by substituting ${x}_{2}=3$ and ${x}_{3}=2$ into the first equation we obtain\n\n$$\n{x}_{1}+(3)+2=6\\,⟹\\,{x}_{1}=1.\n$$\n\nTherefore, $[x]_{B}=\\begin{bmatrix}1 \\\\ 3 \\\\ 2\\end{bmatrix}.$\n\nSo, we have ${x}_{1}=1.$"} :step/id #uuid "3120d902-59cf-52cd-afde-5f7a4f7e1d5f" :step/next {:db/id #edb/ref 17592186455531}} {:db/id #edb/ref 17592186455517 :step/content {:db/id #edb/ref 17592186120352 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "028867b0-8cf6-524a-93e6-8e63fa02e23d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186317580} {:answer/id #uuid "2f329de5-7c1a-5fad-b2d2-f7cc8384731d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186317709} {:answer/id #uuid "5f5bbc70-a2a7-5d4f-9c69-50122cef639d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186317888} {:answer/id #uuid "844d0795-32e6-5eb9-9815-e5906f5fb3e2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186318014} {:answer/id #uuid "c5c361cd-49f5-527f-91c1-eb17cbe67bc5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\notin \\text{Span}\\{{b}_{1},{b}_{2}\\}" :db/id #edb/ref 17592186455244}] :answer-field/correct {:db/id #edb/ref 17592186317580} :answer-field/id #uuid "add90972-43b4-50ff-b652-f7e992bc2ad7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186318801}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f17a8e42-194f-52ed-9136-123dd348b4bc" :question/math-academy-id "q-34617" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B=\\{{b}_{1},{b}_{2}\\},$ where\n\n$$\n{b}_{1}=\\begin{bmatrix}1 \\\\ -2\\end{bmatrix},\\,{b}_{2}=\\begin{bmatrix}2 \\\\ 1\\end{bmatrix},\\,x=\\begin{bmatrix}2 \\\\ 6\\end{bmatrix}.\n$$\n\nIf $[x]_{B}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}$ then what is the value of ${x}_{1}+{x}_{2}?$" :question/worked-solution "We need to find ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2} & =x \\\\ {x}_{1}\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}+{x}_{2}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix} & =\\begin{bmatrix}2 \\\\ 6\\end{bmatrix}.\\end{aligned}\n$$\n\nThe equation above gives the system with the augmented matrix\n\n$$\nM=\\begin{bmatrix}1 & 2 & 2 \\\\ -2 & 1 & 6\\end{bmatrix}.\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 2 & 2 \\\\ -2 & 1 & 6\\end{bmatrix} & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & 2 \\\\ 0 & 5 & 10\\end{bmatrix}\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+2{x}_{2} &=2 \\\\ 5{x}_{2} &=10.\\end{aligned}\\right.\n$$\n\nFrom the second equation, we get ${x}_{2}=2.$ Substituting this into the first equation, we obtain\n\n$$\n{x}_{1}+2(2)=2\\,⟹\\,{x}_{1}=-2.\n$$\n\nTherefore, $[x]_{B}=\\begin{bmatrix}-2 \\\\ 2\\end{bmatrix}.$\n\nFinally, ${x}_{1}+{x}_{2}=(-2)+2=0.$"} :step/id #uuid "3d7897f3-95d9-53e4-9b05-08455a50a2b6" :step/next {:db/id #edb/ref 17592186455528}} {:db/id #edb/ref 17592186455527 :step/content {:db/id #edb/ref 17592186409819 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2115aac5-da66-5510-8b11-176ba754f81a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186409789} {:answer/id #uuid "45dbc0e6-16a9-5c62-a183-2dd30e767a3a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186409790} {:answer/id #uuid "60013665-0a5a-5449-9017-6cb6ae7ed2ca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-7" :db/id #edb/ref 17592186409792} {:answer/id #uuid "7ad6f309-f775-5604-ba46-fa9609a5688b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186409798} {:answer/id #uuid "ba977b58-8add-5c57-ae69-640a36ab4ef9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-8" :db/id #edb/ref 17592186409803}] :answer-field/correct {:db/id #edb/ref 17592186409792} :answer-field/id #uuid "fe323417-1cf2-5a08-b6a1-9d36f7d769a5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186409816}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d9b245f0-31aa-56fe-aa26-5663dd9e140f" :question/math-academy-id "q-112211" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B=\\{{b}_{1},{b}_{2}\\},$ where\n\n$$\n{b}_{1}=\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix},\\,{b}_{2}=\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix},\\,x=\\begin{bmatrix}-7 \\\\ -8 \\\\ 0\\end{bmatrix}.\n$$\n\nIf $[x]_{B}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}$ then what is the value of ${x}_{2}?$" :question/worked-solution "Remember, the order of the vectors in a basis is important.\n\nNotice that \n\n$$\n{{\\begin{bmatrix}-7 \\\\ -8 \\\\ 0\\end{bmatrix}}_{⏟}}_{x}={{(\\,-8\\,)}_{⏟}}_{{x}_{1}}\\cdot {{\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}}_{⏟}}_{{b}_{1}}+{{(\\,-7\\,)}_{⏟}}_{{x}_{2}}\\cdot {{\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}}_{⏟}}_{{b}_{2}}\n$$\n\nwhich means that\n\n$$\nx=(-8)\\cdot {b}_{1}+(-7)\\cdot {b}_{2}\n$$\n\nand therefore\n\n$$\n[x]_{B}=\\begin{bmatrix}-8 \\\\ -7\\end{bmatrix}.\n$$\n\nFinally, we have that ${x}_{2}=-7.$"} :step/id #uuid "af36c254-27dd-5c17-9617-e7f9d654737f"} {:db/id #edb/ref 17592186455528 :step/content {:db/id #edb/ref 17592186319175 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28f401e4-eb59-5198-abf4-1458830b331c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186317692} {:answer/id #uuid "55e9e214-e0b3-5771-95e7-5cb487ad7118" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186317852} {:answer/id #uuid "914f6ffc-e4c9-5161-9fde-b475bcf8fceb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186318060} {:answer/id #uuid "e0273188-6c7e-5354-921c-cdc4386a3d9a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186318313} {:answer/id #uuid "32fd85ec-3fca-5fdb-8d41-028482470a84" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\notin \\text{span}\\{{b}_{1},{b}_{2}\\}" :db/id #edb/ref 17592186454982}] :answer-field/correct {:db/id #edb/ref 17592186317852} :answer-field/id #uuid "e0750bff-0d7b-54f9-bc9f-9e5f7a657747" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186318894}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "706ae806-e20f-56d6-9072-359885047529" :question/math-academy-id "q-34738" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B=\\{{b}_{1},{b}_{2}\\},$ where\n\n$$\n{b}_{1}=\\begin{bmatrix}-1 \\\\ 5 \\\\ 0\\end{bmatrix},\\,{b}_{2}=\\begin{bmatrix}4 \\\\ 2 \\\\ -3\\end{bmatrix},\\,x=\\begin{bmatrix}6 \\\\ -8 \\\\ -3\\end{bmatrix}.\n$$\n\nIf $[x]_{B}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}$ then what is the value of ${x}_{1}+{x}_{2}?$" :question/worked-solution "We need to find ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2} & =x \\\\ {x}_{1}\\begin{bmatrix}-1 \\\\ 5 \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}4 \\\\ 2 \\\\ -3\\end{bmatrix} & =\\begin{bmatrix}6 \\\\ -8 \\\\ -3\\end{bmatrix}.\\end{aligned}\n$$\n\nThe equation above gives the system with the augmented matrix \n\n$$\nM=\\begin{bmatrix}-1 & 4 & 6 \\\\ 5 & 2 & -8 \\\\ 0 & -3 & -3\\end{bmatrix}.\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following: \n\n$$\n\\begin{aligned}M= & \\begin{bmatrix}-1 & 4 & 6 \\\\ 5 & 2 & -8 \\\\ 0 & -3 & -3\\end{bmatrix} & {R}_{2}:={R}_{2}+5{R}_{1} \\\\ ∼ & \\begin{bmatrix}-1 & 4 & 6 \\\\ 0 & 22 & 22 \\\\ 0 & -3 & -3\\end{bmatrix} & {R}_{3}:={R}_{3}+\\frac{3}{22}{R}_{2} \\\\ ∼ & \\begin{bmatrix}-1 & 4 & 6 \\\\ 0 & 22 & 22 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}-{x}_{1}+4{x}_{2} &=6 \\\\ 22{x}_{2} &=22.\\end{aligned}\\right.\n$$\n\nFrom the second equation, we get ${x}_{2}=1.$ Substituting this into the first equation, we obtain\n\n$$\n-{x}_{1}+4(1)=6\\,⟹\\,{x}_{1}=-2.\n$$\n\nTherefore, $[x]_{B}=\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix}.$ \n\nFinally, ${x}_{1}+{x}_{2}=-2+1=-1.$"} :step/id #uuid "bc51db51-8852-5a95-a4d4-b77331fb8d8a" :step/next {:db/id #edb/ref 17592186455516}} {:db/id #edb/ref 17592186455531 :step/content {:db/id #edb/ref 17592186455505 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2679ade7-de7e-5ff4-88c8-94968abbecd0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186454962} {:answer/id #uuid "2e4e66c0-8e5c-5dff-8789-8ac0302fb04b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186454974} {:answer/id #uuid "58225722-5487-53b4-b242-37a168921893" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186455056} {:answer/id #uuid "a19f8251-ccaa-52d8-8b83-bba63f64cb63" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\notin \\text{Span}\\{{b}_{1},{b}_{2},{b}_{3}\\}" :db/id #edb/ref 17592186455191} {:answer/id #uuid "f7cbfdfe-250f-5f75-93f6-f1ca311bd2d2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186455327}] :answer-field/correct {:db/id #edb/ref 17592186454962} :answer-field/id #uuid "8c6024f5-9069-597b-a291-cd59361ac136" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186455386}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e3764343-10e9-5a7d-b034-e095faf7f51c" :question/math-academy-id "q-76054" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B=\\{{b}_{1},{b}_{2},{b}_{3}\\},$ where\n\n$$\n{b}_{1}=\\begin{bmatrix}1 \\\\ 0 \\\\ 3\\end{bmatrix},\\,{b}_{2}=\\begin{bmatrix}-1 \\\\ 2 \\\\ 1\\end{bmatrix},\\,{b}_{3}=\\begin{bmatrix}1 \\\\ 3 \\\\ 0\\end{bmatrix},\\,x=\\begin{bmatrix}3 \\\\ 15 \\\\ 12\\end{bmatrix}.\n$$\n\nIf $[x]_{B}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}$ then what is the value of ${x}_{1}+{x}_{2}+{x}_{3}?$" :question/worked-solution "We need to find ${x}_{1}$,  ${x}_{2}$, and ${x}_{3}$ such that\n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2}+{x}_{3}{b}_{3} & =x \\\\ {x}_{1}\\begin{bmatrix}1 \\\\ 0 \\\\ 3\\end{bmatrix}+{x}_{2}\\begin{bmatrix}-1 \\\\ 2 \\\\ 1\\end{bmatrix}+{x}_{3}\\begin{bmatrix}1 \\\\ 3 \\\\ 0\\end{bmatrix} & =\\begin{bmatrix}3 \\\\ 15 \\\\ 12\\end{bmatrix}.\\end{aligned}\n$$\n\nFrom this, we get the system with the augmented matrix $M$, which we reduce using Gaussian elimination: \n\n$$\n\\begin{aligned}M= & \\begin{bmatrix}1 & -1 & 1 & 3 \\\\ 0 & 2 & 3 & 15 \\\\ 3 & 1 & 0 & 12\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-3){R}_{1} \\\\ ∼ & \\begin{bmatrix}1 & -1 & 1 & 3 \\\\ 0 & 2 & 3 & 15 \\\\ 0 & 4 & -3 & 3\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-2){R}_{2} \\\\ ∼ & \\begin{bmatrix}1 & -1 & 1 & 3 \\\\ 0 & 2 & 3 & 15 \\\\ 0 & 0 & -9 & -27\\end{bmatrix}\\end{aligned}\n$$\n\n  \n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-{x}_{2}+{x}_{3} &=3 \\\\ 2{x}_{2}+3{x}_{3} &=15 \\\\ -9{x}_{3} &=-27.\\end{aligned}\\right.\n$$\n\nFrom the third equation, we get ${x}_{3}=3.$ Substituting this into the second   equation yields\n\n$$\n2{x}_{2}+3(3)=15\\,⟹\\,{x}_{2}=3.\n$$\n\n Finally,  by substituting ${x}_{2}=3$ and ${x}_{3}=3$ into the first equation we obtain\n\n$$\n{x}_{1}-3+3=3\\,⟹\\,{x}_{1}=3.\n$$\n\nTherefore, $[x]_{B}=\\begin{bmatrix}3 \\\\ 3 \\\\ 3\\end{bmatrix}.$\n\nSo, we have \n\n$$\n{x}_{1}+{x}_{2}+{x}_{3}=3+3+3=9.\n$$"} :step/id #uuid "e175e73c-1506-54af-ab5d-d11256d84f83" :step/next {:db/id #edb/ref 17592186455527}}] :activity/title "Expressing the Coordinates of a Vector in a Given Basis" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186454902}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186130023} :activity/id #uuid "c092012f-6280-5531-b39f-09c65d20ea5d" :activity/scope {:db/id #edb/ref 17592186050822 :topic/id #uuid "6961ffb7-2e37-5f54-ac39-0331f4517bbc" :topic/math-academy-id 1979} :activity/steps [{:db/id #edb/ref 17592186130023 :step/content {:db/id #edb/ref 17592186130371 :tutorial/content "Let's consider the region that lies between the curves ${\\color{red}y=f(x)}$ and ${\\color{blue}y=g(x)}$ over a closed interval $[a,b]$ on the $x$-axis, as shown below.\n\n![](images/a4/a45abf7904382a16daaa38ff617a9487b5c274cf65ef44f89e7feb0c32c496e0.png)\n\nThis region is an example of a **type I region**. Generally, a type I region is any region bounded by two vertical lines $x=a$ and $x=b,$ and two curves $y=g(x)$ and $y=f(x),$ where $f$ and $g$ are continuous functions. \n\nUsing set notation, a type I region can be written as\n\n$$\nD = \\big\\{ (x,y) \\: : \\: a \\leq x  \\leq b, \\quad g(x) \\leq y \\leq f(x) \\big\\}.\n$$\n\nIn a type I region, any vertical line drawn through the region should intersect the region in a *single* interval, as shown below.\n\n![](images/f7/f7282efbe2c9244c77ce6bbbeca047ee3ab29dd2fc90e0d2440c519328cb5973.png)\n\nBy contrast, the following region is *not* a type I region since there is a vertical line whose intersection with the region results in two *separate* line segments. In other words, the vertical line enters and leaves the region more than once.\n\n![](images/a2/a26c7588e297a8af35f1e709210596a94f3fb4bd84e8237dc1462f48b961630e.png)" :tutorial/id #uuid "2658cc5e-d169-5ff8-871c-4ccaab428eb7" :tutorial/math-academy-id 3854 :tutorial/title "Introduction"} :step/id #uuid "0b518252-fe1c-57d7-bc6f-6a00d3addac9" :step/math-academy-id 22589 :step/next {:db/id #edb/ref 17592186130024}} {:db/id #edb/ref 17592186130024 :step/content {:db/id #edb/ref 17592186129167 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128986 :question/id #uuid "9cbb7321-753d-5253-8b64-072e3cc227bc" :question/math-academy-id "e-6101"} :knowledge-point/id #uuid "64d342be-ebaf-5e94-b641-ea8ce6f14c12" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049051} {:db/id #edb/ref 17592186050367} {:db/id #edb/ref 17592186050641}] :knowledge-point/questions [{:db/id #edb/ref 17592186129837} {:db/id #edb/ref 17592186129838} {:db/id #edb/ref 17592186339048} {:db/id #edb/ref 17592186342004} {:db/id #edb/ref 17592186374248} {:db/id #edb/ref 17592186375307} {:db/id #edb/ref 17592186375314} {:db/id #edb/ref 17592186375328} {:db/id #edb/ref 17592186393187} {:db/id #edb/ref 17592186429974} {:db/id #edb/ref 17592186435896}] :knowledge-point/title "Identifying Type I Regions"} :step/id #uuid "1b6899de-a336-56a9-809a-31cc01aeebb8" :step/math-academy-id 22590 :step/next {:db/id #edb/ref 17592186130025}} {:db/id #edb/ref 17592186130025 :step/content {:db/id #edb/ref 17592186130372 :tutorial/content "Let's consider the region that lies between the curves ${\\color{red}x=f(y)}$ and ${\\color{blue}x=g(y)}$ over a closed interval $[a,b]$ on the $y$-axis, as shown below.\n\n![](images/cf/cf2a2a41d63f21b279215fd1aa8d7361eb638e831b970bb3de861673f67612e6.png)\n\nThis region is an example of a **type II region**. In general, a type II region is any region that is bounded by two horizontal lines $y=a$ and $y=b,$ and two curves $x=g(y)$ and $x=f(y),$ where $f$ and $g$ are continuous functions.\n\nUsing set notation, a type II region can be written as\n\n$$\nD = \\big\\{ (x,y) \\: : \\: a \\leq y  \\leq b, \\quad g(y) \\leq x \\leq f(y) \\big\\}.\n$$\n\nIn a type II region, any horizontal line drawn through the region should intersect the region in a *single* interval, as shown below.\n\n![](images/56/56019e8cc2b1146b99fa6f6532356281fdb847c342c25c63f843ddee4f8cb197.png)\n\nBy contrast, the following region is *not* a type II region since there is a horizontal line whose intersection with the region results in two *separate* line segments. In other words, the horizontal line enters and leaves the region more than once.\n\n![](images/a7/a7c1ead1274250f7184b132eff58a3028ce648715dcbfa7c7046077fd4e680ef.png)" :tutorial/id #uuid "d089f833-c09a-5229-9be0-8cffa2510d60" :tutorial/math-academy-id 3855 :tutorial/title "Type II Regions"} :step/id #uuid "4858561d-380d-50d9-901d-e33ce219f2d6" :step/math-academy-id 22591 :step/next {:db/id #edb/ref 17592186130026}} {:db/id #edb/ref 17592186130026 :step/content {:db/id #edb/ref 17592186129168 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128987 :question/id #uuid "cce0a7b2-7b25-5da6-8aa2-cbe8a40cd522" :question/math-academy-id "e-6102"} :knowledge-point/id #uuid "85335de6-e1dc-5a2f-b30a-806627759030" :knowledge-point/questions [{:db/id #edb/ref 17592186129839} {:db/id #edb/ref 17592186129840} {:db/id #edb/ref 17592186339049} {:db/id #edb/ref 17592186339051} {:db/id #edb/ref 17592186339062} {:db/id #edb/ref 17592186342005} {:db/id #edb/ref 17592186373174} {:db/id #edb/ref 17592186375321} {:db/id #edb/ref 17592186389594} {:db/id #edb/ref 17592186393194} {:db/id #edb/ref 17592186429975} {:db/id #edb/ref 17592186435897}] :knowledge-point/title "Identifying Type II Regions"} :step/id #uuid "952b663b-02bc-55c3-b391-c854df6de6fb" :step/math-academy-id 22592 :step/next {:db/id #edb/ref 17592186130027}} {:db/id #edb/ref 17592186130027 :step/content {:db/id #edb/ref 17592186130373 :tutorial/content "In general, a given region can be type I, type II, both, or neither.\n\nFor example, let's consider the region in the coordinate plane bounded between the circle ${\\color{blue}x^2+y^2=2}$ and the lines ${\\color{red}x=-1},$ ${\\color{red}x=1},$ ${\\color{red}y=-1}$, and ${\\color{red}y=1},$ as shown below.\n\n![](images/db/db43502c2b096c912ac38d297c3a06e7dcbf4945af6fbc7f5e365a40d11fcde8.png)\n\nThere is a vertical line (for instance, the $y$-axis) whose intersection with the region results in two separate line segments. In other words, the vertical line enters and leaves the region more than once. So, this region *cannot* be a type I region.\n\n![](images/dc/dc1dca3b3015da15f554d95dae7add65aeee0b83a0075ec5295716a3e86d71f5.png)\n\nSimilarly, there is a horizontal line (for instance, the $x$-axis) whose intersection with the region results in two separate line segments. In other words, the horizontal line enters and leaves the region more than once. So, this region *cannot* be a type II region.\n\n![](images/82/82720f4b69fc3e63bbf54cb22d60299035faf91a6021f09d41e9f62dad571581.png)\n\nIn conclusion, this region is *neither* type I nor type II.\n\nLet's now look at an example that is *both* type I and type II." :tutorial/id #uuid "09369aae-8943-5475-9739-20e6619b16d7" :tutorial/math-academy-id 3856 :tutorial/title "Regions that are Neither Type I Nor Type II"} :step/id #uuid "eafe2c8b-e7b1-59e6-9468-2c731ee86e98" :step/math-academy-id 22593 :step/next {:db/id #edb/ref 17592186130028}} {:db/id #edb/ref 17592186130028 :step/content {:db/id #edb/ref 17592186129169 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128988 :question/id #uuid "cd9ce5bf-1663-5110-8aaa-8f0f47d7d30a" :question/math-academy-id "e-6103"} :knowledge-point/id #uuid "7948909f-8dcb-5cc0-a00f-f505a41e4004" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048598} {:db/id #edb/ref 17592186049528} {:db/id #edb/ref 17592186049570} {:db/id #edb/ref 17592186049699} {:db/id #edb/ref 17592186050294}] :knowledge-point/questions [{:db/id #edb/ref 17592186129841} {:db/id #edb/ref 17592186129842} {:db/id #edb/ref 17592186284608} {:db/id #edb/ref 17592186339069} {:db/id #edb/ref 17592186339070} {:db/id #edb/ref 17592186339071} {:db/id #edb/ref 17592186342012} {:db/id #edb/ref 17592186401586} {:db/id #edb/ref 17592186403564} {:db/id #edb/ref 17592186403647} {:db/id #edb/ref 17592186406982} {:db/id #edb/ref 17592186446088}] :knowledge-point/title "Classifying a Region as Type I, Type II, Both, or Neither"} :step/id #uuid "3b78b691-c694-59d1-b1ef-5ea8a77ad679" :step/math-academy-id 22594}] :activity/title "Type I and II Regions in Two-Dimensional Space" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186129327}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186406984} :activity/id #uuid "3da669c9-a862-59b7-84e5-f7ce7ac62942" :activity/scope {:db/id #edb/ref 17592186050822 :topic/id #uuid "6961ffb7-2e37-5f54-ac39-0331f4517bbc" :topic/math-academy-id 1979} :activity/steps [{:db/id #edb/ref 17592186406983 :step/content {:db/id #edb/ref 17592186393194 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b5bce626-d9bb-5dbb-905a-7daed41e086c" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/a2/a216b288b70301fb14b8f1219b909edb69ab77b08c29460b5522abc2025ab494.png" :db/id #edb/ref 17592186393196} {:answer/id #uuid "c9d47ae6-371d-5f7f-a924-edcd6ec62dd3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "None of the listed" :db/id #edb/ref 17592186393197} {:answer/id #uuid "693ea9c7-f1ff-5a1c-b288-3ea683ff953d" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/20/205fdc7a29c94d36b5bd8847a2600c41d7e3fd2ac0fd92947dddcb241bdae012.png" :db/id #edb/ref 17592186393198} {:answer/id #uuid "349c2643-543b-501a-b8d3-7af986d4a0af" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/25/254691f56d0586b2cbfd75a3fce34ecc1062b0f0fde538d3885860ed1b71555c.png" :db/id #edb/ref 17592186393199} {:answer/id #uuid "d7836927-19a4-54a2-aabf-fc9fd48ada96" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/ed/edbcc3bcef921ef736f9bd31bec56f69736c632bf835cf4c9c1c46026fda8083.png" :db/id #edb/ref 17592186393200}] :answer-field/correct {:db/id #edb/ref 17592186393196} :answer-field/id #uuid "7683d677-08f6-57b3-b924-04b4d1ba5f5a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186393195}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "13be6924-14b7-5b8e-8469-18a97723bd20" :question/math-academy-id "q-72120" :question/problem "Which of the following is a type II region in two-dimensional space?" :question/worked-solution "A type II region can be written as\n\n$$\nD=\\{(x,y)\\,:\\,a\\le y\\le b,\\,g(y)\\le x\\le f(y)\\},\n$$\n\nwhere $f$ and $g$ are continuous functions.\n\nA type II region has the property that a horizontal line drawn through the region intersects the region in a single interval only.\n\nAmong the given options, the only type II region is the following.\n\n![](images/e4/e472070f17c47e78024217ed750690b88de87f3849818368dda1dde5d91d90d4.png)"} :step/id #uuid "0868f274-6d6e-5256-97a9-564c4f1a8169" :step/next {:db/id #edb/ref 17592186406985}} {:db/id #edb/ref 17592186406984 :step/content {:db/id #edb/ref 17592186339049 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "099efdac-6222-5744-b3c1-1dad27d41b85" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "None of the listed" :db/id #edb/ref 17592186336117} {:answer/id #uuid "2f51b9b3-9edb-5ad5-a10c-52cfdfd9e751" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/6c/6ccd325f24c9550f82a7063623db1cae0212a07f1c938b882c6707d35a6eee29.png" :db/id #edb/ref 17592186336484} {:answer/id #uuid "5a4f7dba-2306-55b0-ad53-f7348ae38b3c" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/5a/5a14be084ba22e33b636465156276fc489904a650077612c15fdec3634f8d902.png" :db/id #edb/ref 17592186336855} {:answer/id #uuid "d8f500b5-47d1-5c54-82d7-03d7175ff4bd" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/5e/5e41509dcb689a5f16822eea9b8700171a74124789e12990ee4fd292d52aa2ea.png" :db/id #edb/ref 17592186337919} {:answer/id #uuid "f39c32b9-aa95-5261-a245-c6851bf03b8c" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/81/81b206d34bfa12b8623329616368ea3e6a978cf7963dbe5f09b23cafffb76dae.png" :db/id #edb/ref 17592186338160}] :answer-field/correct {:db/id #edb/ref 17592186336484} :answer-field/id #uuid "b0492a08-2d29-5eca-af88-ac3ff00ea955" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186338600}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "efbcfea6-0f26-55f3-9790-4f12e94364d5" :question/math-academy-id "q-72049" :question/problem "Which of the following is a type II region in two-dimensional space?" :question/worked-solution "A type II region can be written as\n\n$$\nD=\\{(x,y)\\,:\\,a\\le y\\le b,\\,g(y)\\le x\\le f(y)\\},\n$$\n\nwhere $f$ and $g$ are continuous functions.\n\nA type II region has the property that a horizontal line drawn through the region intersects the region in a single interval only.\n\nAmong the given options, the only type II region is the following.\n\n![](images/7c/7c159c025f0b7ae4bfa8984f637a492cda21ec2dd39e87be724324e1334c06a3.png)"} :step/id #uuid "11bc950f-28ab-5ada-8524-78d17fbdb0fc" :step/next {:db/id #edb/ref 17592186406983}} {:db/id #edb/ref 17592186406985 :step/content {:db/id #edb/ref 17592186373174 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0747cf82-408b-58c2-b5d7-dcefd0ed68ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "D=\\{(x,y)\\,:\\,0\\le y\\le 1,\\,0\\le x\\le 1\\}" :db/id #edb/ref 17592186435869} {:answer/id #uuid "17567c73-9403-53e0-b46b-a5ceadd85060" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "D=\\{(x,y)\\,:\\,0\\le y\\le 1,\\,0\\le x\\le \\sqrt{y}\\}" :db/id #edb/ref 17592186435871} {:answer/id #uuid "429ef4b8-fbc0-567d-af67-084931824074" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "D=\\{(x,y)\\,:\\,0\\le y\\le 1,\\,0\\le x\\le y\\}" :db/id #edb/ref 17592186435875} {:answer/id #uuid "4b704cda-a7e0-5c8b-9cf6-66429dfd1ade" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "D=\\{(x,y)\\,:\\,0\\le y\\le {x}^{2},\\,0\\le x\\le 1\\}" :db/id #edb/ref 17592186435876} {:answer/id #uuid "a709f16c-6935-5b16-8b38-88908d6454cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "D=\\{(x,y)\\,:\\,0\\le y\\le 1,\\,y\\le x\\le \\sqrt{y}\\}" :db/id #edb/ref 17592186435884}] :answer-field/correct {:db/id #edb/ref 17592186435884} :answer-field/id #uuid "257fac2f-8a02-59c7-aca1-ef19cbb1795a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186373175}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ef441fce-64e9-5f90-b9fb-0d44af6b333e" :question/math-academy-id "q-72143" :question/problem "![](images/76/768046952484d181a404486547db84882424d98da4f677254484e1083580a39b.png)\n\nWhich of the following represents the shaded region above as a type II region in two-dimensional space?" :question/worked-solution "A type II region can be written as\n\n$$\nD=\\{(x,y)\\,:\\,a\\le y\\le b,\\,g(y)\\le x\\le f(y)\\},\n$$\n\nwhere $f$ and $g$ are continuous functions.\n\nTo express the given region as a type II region, we first rewrite all of the given curves as functions of $y:$\n\n$$\ny={x}^{2}\\,⟹\\,x=\\sqrt{y}\n$$\n\nThe function $x=y$ is already written as a function of $y.$\n\nNotice that the region lies between the horizontal lines $y=0$ and $y=1.$ So, we have $0\\le y\\le 1.$\n\nWe draw a horizontal arrow through the region to determine the left function $g(y)$ and the right function $f(y).$ A horizontal line should intersect the region in a single interval only for it to be a type II region.\n\n![](images/d5/d55cb7ea67d9865368c744577bb4a4b22a3635e8e62869ee65e945612d6c0e98.png)\n\nThe horizontal line enters the region through the lower function $x=y$ and leaves through the upper function $x=\\sqrt{y}.$ So, we have $y\\le x\\le \\sqrt{y}.$\n\nTherefore, we obtain\n\n$$\nD=\\{(x,y)\\,:\\,0\\le y\\le 1,\\,y\\le x\\le \\sqrt{y}\\}.\n$$"} :step/id #uuid "1c227960-e1d3-5f07-b75a-31b153d00a8a" :step/next {:db/id #edb/ref 17592186406987}} {:db/id #edb/ref 17592186406986 :step/content {:db/id #edb/ref 17592186339070 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6cb3d1e7-cf6a-54b2-a095-b9fdc68a8d5b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186467926} {:answer/id #uuid "cab149b0-2702-528d-b56e-23d4232647f3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186467927}] :answer-field/correct {:db/id #edb/ref 17592186467927} :answer-field/id #uuid "368ddd66-9d80-586f-9e2a-9ab70f075343" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186468684} {:answer-field/choices [{:answer/id #uuid "8ea3c229-904d-5a2f-8d07-a00dada077bd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186467928} {:answer/id #uuid "7d445f31-2d12-5062-a2a4-99e2b64c0491" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186467929}] :answer-field/correct {:db/id #edb/ref 17592186467928} :answer-field/id #uuid "4edea166-3bfd-535f-b98e-b624be2d49a5" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186468685} {:answer-field/choices [{:answer/id #uuid "a94e95bb-c951-576f-aa60-7b79a87fb894" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186467930} {:answer/id #uuid "1541c926-bd73-5e47-854d-d4e15738f59a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186467931}] :answer-field/correct {:db/id #edb/ref 17592186467930} :answer-field/id #uuid "88bc4663-71c0-5111-9c92-a5bd0ddc37dc" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186468686}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f581ab20-43e5-59a8-ac58-914378a7361e" :question/math-academy-id "q-72186" :question/problem "Which of the following statements are true regarding the finite region bounded between the parabola $y=4-{x}^{2}$ and the line $y=2-|x|?$\n\nSelect all that apply.\n\n- **I.** It is a type I region\n- **II.** It is a type II region\n- **III.** It's neither a type I nor a type II region" :question/worked-solution "First, let's sketch our region.\n\n![](images/6f/6f35161e7efbd53c9ef558ffe88d8e046771128965a9fdd02143ae37a9b130ea.png)\n\nWe have the following:\n\n- Any vertical line through the region intersects it on a single interval. Furthermore, we can represent our region as\n\n$$\nD=\\{(x,y)\\,:\\,-2\\le x\\le 2,\\,2-|x|\\le y\\le 4-{x}^{2}\\}.\n$$\n\nSo, this is a type I region.\n\n- The horizontal line $y=1$ intersects the region in two separate intervals, as shown below. So, this can't be a type II region.\n\n![](images/76/769a521cd6b05ecf05052da382e40295b26be66fe56e4eff7c6940c9032f2f0b.png)\n\nTherefore, only statement I is true."} :step/id #uuid "52cd1fa6-d29c-562d-9d88-cade3cec5a66"} {:db/id #edb/ref 17592186406987 :step/content {:db/id #edb/ref 17592186406982 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b532929-031f-53ba-845b-1b69f35ae5ab" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186473278} {:answer/id #uuid "da5ae196-6ddc-5f90-8faf-ce02251fa644" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186473279}] :answer-field/correct {:db/id #edb/ref 17592186473279} :answer-field/id #uuid "8261d6df-4d7c-5438-ab24-46a9a778e5ea" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186474034} {:answer-field/choices [{:answer/id #uuid "ff2626a4-af3b-558c-898b-e325dcd7c8a7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186473280} {:answer/id #uuid "74014f19-619f-54ff-9fc7-8f16f269680a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186473281}] :answer-field/correct {:db/id #edb/ref 17592186473281} :answer-field/id #uuid "1f34c2c1-88e7-5e59-bf72-b638136d3b12" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186474035} {:answer-field/choices [{:answer/id #uuid "8d131820-9e7d-5679-bbf5-8ff122bec3c3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186473282} {:answer/id #uuid "38a132f3-eea1-5c88-b25c-151a9517cd9c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186473283}] :answer-field/correct {:db/id #edb/ref 17592186473282} :answer-field/id #uuid "9f148b1b-a08c-5f92-88d7-fab284af6a47" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186474036}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0d779a1b-dcae-59f0-822c-7860f9483ab7" :question/math-academy-id "q-72160" :question/problem "Which of the following statements are true regarding the finite region bounded between the curves $y={x}^{3}$ and $y=\\sqrt[3]{x},$ in the first quadrant?\n\nSelect all that apply.\n\n- **I.** It is a type I region\n- **II.** It is a type II region\n- **III.** It's neither a type I nor a type II region" :question/worked-solution "First, notice that\n\n$$\n\\begin{aligned}y={x}^{3}\\, & ⟹\\,x=\\sqrt[3]{y} \\\\ y=\\sqrt[3]{x}\\, & ⟹\\,x={y}^{3}.\\end{aligned}\n$$\n\nNow, let's sketch our region.\n\n![](images/89/899357795c6d5b81d3cb619d71493ad787645697fe1f2fcecda78c1b875f388e.png)\n\nWe have the following:\n\n- Any vertical line through the region intersects it on a single interval. Furthermore, we can represent our region as\n\n$$\nD={(x,y)\\,:\\,0\\le x\\le 1,\\,{x}^{3}\\le y\\le \\sqrt[3]{x}}.\n$$\n\nSo, this is a type I region.\n\n- Any horizontal line through the region intersects it on a single interval. Furthermore, we can represent our region as\n\n$$\nD={(x,y)\\,:\\,0\\le y\\le 1,\\,{y}^{3}\\le x\\le \\sqrt[3]{y}}.\n$$\n\nSo, this is a type II region.\n\nTherefore, only statements I and II are true."} :step/id #uuid "fd242e61-69b5-5bfd-bc83-d7379d3f45c8" :step/next {:db/id #edb/ref 17592186406986}}] :activity/title "Type I and II Regions in Two-Dimensional Space" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186406975}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186429979} :activity/id #uuid "d57582b7-233f-54ba-bba8-bc7760d18c20" :activity/scope {:db/id #edb/ref 17592186050822 :topic/id #uuid "6961ffb7-2e37-5f54-ac39-0331f4517bbc" :topic/math-academy-id 1979} :activity/steps [{:db/id #edb/ref 17592186429976 :step/content {:db/id #edb/ref 17592186429975 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "177be529-dbfe-5550-a65b-a03b4c722a7b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "D=\\{(x,y)\\,:\\,1\\le y\\le {e}^{x-1},\\,0\\le x\\le \\operatorname{ln}⁡(y)+1\\}" :db/id #edb/ref 17592186429962} {:answer/id #uuid "69b6c086-4549-55a7-9eba-d0041a274109" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "D=\\{(x,y)\\,:\\,1\\le y\\le e,\\,0\\le x\\le \\operatorname{ln}⁡(y)+1\\}" :db/id #edb/ref 17592186429966} {:answer/id #uuid "ad13df4f-7bd9-5a03-86d7-02175fdb12da" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "D=\\{(x,y)\\,:\\,0\\le y\\le e,\\,0\\le x\\le \\operatorname{ln}⁡(y)+1\\}" :db/id #edb/ref 17592186429968} {:answer/id #uuid "c5dacd0b-ebeb-5ba4-b6db-4ab0dd2f71e0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "D=\\{(x,y)\\,:\\,0\\le y\\le {e}^{x-1},\\,1\\le x\\le 2\\}" :db/id #edb/ref 17592186429970} {:answer/id #uuid "dfdb17ab-530e-5006-a6b1-b68bfc5121a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "D=\\{(x,y)\\,:\\,1\\le y\\le {e}^{x-1},\\,0\\le x\\le 2\\}" :db/id #edb/ref 17592186429971}] :answer-field/correct {:db/id #edb/ref 17592186429966} :answer-field/id #uuid "d1839b45-678e-5716-ac62-7bfdda74ad68" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186429972}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5cace0f5-d8d3-5cc8-93c4-64d577bf2d3c" :question/math-academy-id "q-72344" :question/problem "![](images/40/4066b07ace047e9a7ce813ed70dd6648649a192d648ed810fa96b5146d2c5581.png)\n\nWhich of the following represents the shaded region above as a type II region in two-dimensional space?" :question/worked-solution "A type II region can be written as\n\n$$\nD=\\{(x,y)\\,:\\,a\\le y\\le b,\\,g(y)\\le x\\le f(y)\\},\n$$\n\nwhere $f$ and $g$ are continuous functions.\n\nTo express the given region as a type II region, we first rewrite all of the given curves as functions of $y:$\n\n$$\ny={e}^{x-1}\\,⟹\\,x=\\operatorname{ln}⁡(y)+1\n$$\n\nThe function $x=0$ is already written as a function of $y.$\n\nNotice that the region lies between the horizontal lines $y=1$ and $y=e.$ So, we have $1\\le y\\le e.$\n\nWe draw a horizontal arrow through the region to determine the left function $g(y)$ and the right function $f(y).$ A horizontal line should intersect the region in a single interval only for it to be a type II region.\n\n![](images/68/680842905f6e308d3c438063769bde9854401a300371452d1c0735bb7d272a02.png)\n\nThe horizontal line enters the region through the lower function $x=0$ and leaves through the upper function $x=\\operatorname{ln}⁡(y)+1.$ So, we have $0\\le x\\le \\operatorname{ln}⁡(y)+1.$\n\nTherefore, we obtain\n\n$$\nD=\\{(x,y)\\,:\\,1\\le y\\le e,\\,0\\le x\\le \\operatorname{ln}⁡(y)+1\\}.\n$$"} :step/id #uuid "3390ee50-86eb-5461-9633-3fe230269903" :step/next {:db/id #edb/ref 17592186429978}} {:db/id #edb/ref 17592186429977 :step/content {:db/id #edb/ref 17592186339069 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28e2c148-6ee6-5f8c-9b2b-442fe96cf085" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186467920} {:answer/id #uuid "90143807-a74a-57ee-aa16-a1ee057a16c2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186467921}] :answer-field/correct {:db/id #edb/ref 17592186467921} :answer-field/id #uuid "2de9075c-99a1-540e-b78d-991060565cb7" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186468681} {:answer-field/choices [{:answer/id #uuid "a8488a4b-f9b2-5a2f-aeff-132fefe2716f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186467922} {:answer/id #uuid "1a62f2dd-5c52-5ce6-8102-f840944d8ef7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186467923}] :answer-field/correct {:db/id #edb/ref 17592186467923} :answer-field/id #uuid "e5389031-03cb-5727-b801-66a146d9f193" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186468682} {:answer-field/choices [{:answer/id #uuid "25b7c356-4e59-589f-9d6a-565ed0873aee" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186467924} {:answer/id #uuid "58cf1eb8-5878-59da-b070-f3f00fcdcb15" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186467925}] :answer-field/correct {:db/id #edb/ref 17592186467924} :answer-field/id #uuid "fb366d99-7744-5bfb-8897-cc8aae3154da" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186468683}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0bcd8034-22f3-5298-b8d3-b69cdcbc84fc" :question/math-academy-id "q-72185" :question/problem "Which of the following statements are true regarding the finite region inside the circumference ${x}^{2}+{y}^{2}=1?$\n\nSelect all that apply.\n\n- **I.** It is a type I region\n- **II.** It is a type II region\n- **III.** It's neither a type I nor a type II region" :question/worked-solution "First, notice that\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}=1\\, & ⟹\\,x=\\pm \\sqrt{1-{y}^{2}} \\\\ {x}^{2}+{y}^{2}=1\\, & ⟹\\,y=\\pm \\sqrt{1-{x}^{2}}.\\end{aligned}\n$$\n\nNow, let's sketch our region.\n\n![](images/09/0960063edcce8ccd55dc2f77147c4a4982645c180e8b998d7e520c65131ea045.png)\n\nWe have the following:\n\n- Any vertical line through the region intersects it on a single interval. Furthermore, we can represent our region as\n\n$$\nD=\\{(x,y)\\,:\\,-1\\le x\\le 1,\\,-\\sqrt{1-{x}^{2}}\\le y\\le \\sqrt{1-{x}^{2}}\\}.\n$$\n\nSo, this is a type I region.\n\n- Any horizontal line through the region intersects it on a single interval. Furthermore, we can represent our region as\n\n$$\nD=\\{(x,y)\\,:\\,-1\\le y\\le 1,\\,-\\sqrt{1-{y}^{2}}\\le x\\le \\sqrt{1-{y}^{2}}\\}.\n$$\n\nSo, this is a type II region.\n\nTherefore, only statements I and II are true."} :step/id #uuid "4eb88ece-6f0a-54bd-b308-acf69dcf4cf6" :step/next {:db/id #edb/ref 17592186429980}} {:db/id #edb/ref 17592186429978 :step/content {:db/id #edb/ref 17592186389594 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e353de59-45ed-5d3e-a3c7-c62ccb8bfee0" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/32/32e6ed07f3229c8e6016d12dd35c42597888662fbc909f53bc07e495a73958e8.png" :db/id #edb/ref 17592186389596} {:answer/id #uuid "189f5878-608c-523c-8af3-61b336e7fea3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "None of the listed" :db/id #edb/ref 17592186389597} {:answer/id #uuid "cae29720-9bdf-5675-b7dc-87fb52dc9fc5" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/36/36275eef6e634c83c614626bc2af6b97cd5bafddc8c02b64ba2a1aa7ea983317.png" :db/id #edb/ref 17592186389598} {:answer/id #uuid "b6e89d64-16cb-5f6e-924f-288db18c0bdb" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/de/de643820e7690a10eae2e7de2e2cb974700996b36130af4f45c446640b49dcc4.png" :db/id #edb/ref 17592186389599} {:answer/id #uuid "a2e82089-b886-5a96-8c4e-a2c7d256121e" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/5a/5ac45c6757e187796674ca4beda4ff73c60835b401df302bfd8a91fa5c98b68c.png" :db/id #edb/ref 17592186389600}] :answer-field/correct {:db/id #edb/ref 17592186389599} :answer-field/