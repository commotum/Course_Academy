 17592186045497} :answer/value "images/70/70662d02852c7299ab1c040362664de79de8bc51689b0611796f63a737412693.png" :db/id #edb/ref 17592186429969}] :answer-field/correct {:db/id #edb/ref 17592186429967} :answer-field/id #uuid "e615de10-cf5a-5071-a58d-94a8d37e22e4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186429973}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "033e3725-7b31-599b-85d8-6c6f830b966d" :question/math-academy-id "q-72042" :question/problem "Which of the following is a type I region in two-dimensional space?" :question/worked-solution "A type I region can be written as\n\n$$\nD=\\{(x,y)\\,:\\,a\\le x\\le b,\\,g(x)\\le y\\le f(x)\\},\n$$\n\nwhere $f$ and $g$ are continuous functions.\n\nA type I region has the property that a vertical line drawn through the region intersects the region in a single interval only.\n\nAmong the given options, the only type I region is the following.\n\n![](images/00/00654c32dbc74614de9b6fdd0f39a5f7d4ecb6ccca0c642ab7ca4a2a8cfe1d89.png)"} :step/id #uuid "8bd0027a-2407-5324-8c03-911f21cc41f4" :step/next {:db/id #edb/ref 17592186429977}} {:db/id #edb/ref 17592186429980 :step/content {:db/id #edb/ref 17592186339071 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93784bc3-b560-52b9-a35d-2ec831b381f2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186467932} {:answer/id #uuid "3e4ef645-0e9e-59ca-9ead-4e534938e7a3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186467933}] :answer-field/correct {:db/id #edb/ref 17592186467932} :answer-field/id #uuid "fae03209-445f-57ef-a7d8-bf499239612a" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186468687} {:answer-field/choices [{:answer/id #uuid "fea766b7-5902-5718-9a79-ebd9d7790d66" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186467934} {:answer/id #uuid "652141fa-413d-505f-be84-3dff8c027c0d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186467935}] :answer-field/correct {:db/id #edb/ref 17592186467934} :answer-field/id #uuid "a1a093da-8121-5419-baa0-42398a34c5c0" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186468688} {:answer-field/choices [{:answer/id #uuid "38c7e8b2-4b4c-577e-a27a-0aa07ff9fbc3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186467936} {:answer/id #uuid "482c64c9-5eab-5414-829d-60978c25b3af" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186467937}] :answer-field/correct {:db/id #edb/ref 17592186467937} :answer-field/id #uuid "b7660e82-ac96-5396-b514-daa03b2886a3" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186468689}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "b03842bf-e94f-5526-903d-de5a2a3bccca" :question/math-academy-id "q-72187" :question/problem "Which of the following statements are true regarding the finite region bounded between the circles ${x}^{2}+{y}^{2}=2$ and ${x}^{2}+{y}^{2}=1?$\n\nSelect all that apply.\n\n- **I.** It is a type I region\n- **II.** It is a type II region\n- **III.** It's neither a type I nor a type II region" :question/worked-solution "First, let's sketch our region.\n\n![](images/28/28290c5530efd27a979f4284481ca7e0384342d7d426dde0ab36894a0d77a166.png)\n\nWe have the following:\n\n- The vertical line $x=0.5$ intersects the region in two separate intervals, as shown below. So, this can't be a type I region.\n\n![](images/30/3007cffb725faee44d2a06ad077eec630791b1a94c373a323f62d0d721c87207.png)\n\n- The horizontal line $y=0.5$ intersects the region in two separate intervals, as shown below. So, this can't be a type II region.\n\n![](images/38/383f88668435556d3a856cf852caf548b1f1bf3a90d50f9d85d7968188984804.png)\n\nTherefore, only statement III is true."} :step/id #uuid "ad81c404-9fb0-5596-9d64-58c400c8f6c0" :step/next {:db/id #edb/ref 17592186429976}}] :activity/title "Type I and II Regions in Two-Dimensional Space" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186429961}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186446093} :activity/id #uuid "02067a53-4847-5e9e-8b0d-b2b3da7d2999" :activity/scope {:db/id #edb/ref 17592186050822 :topic/id #uuid "6961ffb7-2e37-5f54-ac39-0331f4517bbc" :topic/math-academy-id 1979} :activity/steps [{:db/id #edb/ref 17592186446089 :step/content {:db/id #edb/ref 17592186446088 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b0966e0-07b0-5f6b-880a-9d5d92900e6d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186446082} {:answer/id #uuid "5e8e26dd-8c1f-5a51-bd64-4a8c0ed95c65" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186446083} {:answer/id #uuid "72f83e85-8dd3-534d-b4ca-baaac2319fc8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186446084} {:answer/id #uuid "a8406b13-840b-5d77-8dd2-2d014e10235d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186446085} {:answer/id #uuid "abf0e08f-d55a-5c7e-8ead-34398d2d59d4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186446086}] :answer-field/correct {:db/id #edb/ref 17592186446084} :answer-field/id #uuid "f3a6a40a-0b17-512b-bf03-9bbe6e406509" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186446087}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "fd6674b6-1720-503b-8769-c73b368922ec" :question/math-academy-id "q-72188" :question/problem "Which of the following statements are true regarding the finite region that lies outside the circle ${x}^{2}+{y}^{2}=1$ and inside the square defined by the lines $x=-1,$ $x=1,$ $y=-1$ and $y=1?$\n\nI. It is a type I region\n\nII. It is a type II region\n\nIII. It's neither a type I nor a type II region" :question/worked-solution "First, let's sketch our region.\n\n![](images/e7/e762e510b690d65dfc8365d041c734d7b16611411004723a2abdbb74bfb41cc3.png)\n\nWe have the following:\n\n- The vertical line $x=0.75$ intersects the region in two separate intervals, as shown below. So, this can't be a type I region.\n\n![](images/b7/b72bb25ce1dcce3dc7792bbbcb8a878dde14df3a90c9243a3c75ac26a19aaa47.png)\n\n- The horizontal line $y=0.75$ intersects the region in two separate intervals, as shown below. So, this can't be a type II region.\n\n![](images/eb/eb34633d98011ed7050694c722bc7c736a95939783efec3321d95517695642e2.png)\n\nTherefore, only statement III is true."} :step/id #uuid "24b1c7cb-ecec-5845-8416-fdfafa79a79d" :step/next {:db/id #edb/ref 17592186446092}} {:db/id #edb/ref 17592186446090 :step/content {:db/id #edb/ref 17592186339069 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28e2c148-6ee6-5f8c-9b2b-442fe96cf085" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186467920} {:answer/id #uuid "90143807-a74a-57ee-aa16-a1ee057a16c2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186467921}] :answer-field/correct {:db/id #edb/ref 17592186467921} :answer-field/id #uuid "2de9075c-99a1-540e-b78d-991060565cb7" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186468681} {:answer-field/choices [{:answer/id #uuid "a8488a4b-f9b2-5a2f-aeff-132fefe2716f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186467922} {:answer/id #uuid "1a62f2dd-5c52-5ce6-8102-f840944d8ef7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186467923}] :answer-field/correct {:db/id #edb/ref 17592186467923} :answer-field/id #uuid "e5389031-03cb-5727-b801-66a146d9f193" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186468682} {:answer-field/choices [{:answer/id #uuid "25b7c356-4e59-589f-9d6a-565ed0873aee" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186467924} {:answer/id #uuid "58cf1eb8-5878-59da-b070-f3f00fcdcb15" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186467925}] :answer-field/correct {:db/id #edb/ref 17592186467924} :answer-field/id #uuid "fb366d99-7744-5bfb-8897-cc8aae3154da" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186468683}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0bcd8034-22f3-5298-b8d3-b69cdcbc84fc" :question/math-academy-id "q-72185" :question/problem "Which of the following statements are true regarding the finite region inside the circumference ${x}^{2}+{y}^{2}=1?$\n\nSelect all that apply.\n\n- **I.** It is a type I region\n- **II.** It is a type II region\n- **III.** It's neither a type I nor a type II region" :question/worked-solution "First, notice that\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}=1\\, & ⟹\\,x=\\pm \\sqrt{1-{y}^{2}} \\\\ {x}^{2}+{y}^{2}=1\\, & ⟹\\,y=\\pm \\sqrt{1-{x}^{2}}.\\end{aligned}\n$$\n\nNow, let's sketch our region.\n\n![](images/09/0960063edcce8ccd55dc2f77147c4a4982645c180e8b998d7e520c65131ea045.png)\n\nWe have the following:\n\n- Any vertical line through the region intersects it on a single interval. Furthermore, we can represent our region as\n\n$$\nD=\\{(x,y)\\,:\\,-1\\le x\\le 1,\\,-\\sqrt{1-{x}^{2}}\\le y\\le \\sqrt{1-{x}^{2}}\\}.\n$$\n\nSo, this is a type I region.\n\n- Any horizontal line through the region intersects it on a single interval. Furthermore, we can represent our region as\n\n$$\nD=\\{(x,y)\\,:\\,-1\\le y\\le 1,\\,-\\sqrt{1-{y}^{2}}\\le x\\le \\sqrt{1-{y}^{2}}\\}.\n$$\n\nSo, this is a type II region.\n\nTherefore, only statements I and II are true."} :step/id #uuid "42ed5761-ab81-502e-952a-3422383e386b" :step/next {:db/id #edb/ref 17592186446089}} {:db/id #edb/ref 17592186446091 :step/content {:db/id #edb/ref 17592186389594 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e353de59-45ed-5d3e-a3c7-c62ccb8bfee0" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/32/32e6ed07f3229c8e6016d12dd35c42597888662fbc909f53bc07e495a73958e8.png" :db/id #edb/ref 17592186389596} {:answer/id #uuid "189f5878-608c-523c-8af3-61b336e7fea3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "None of the listed" :db/id #edb/ref 17592186389597} {:answer/id #uuid "cae29720-9bdf-5675-b7dc-87fb52dc9fc5" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/36/36275eef6e634c83c614626bc2af6b97cd5bafddc8c02b64ba2a1aa7ea983317.png" :db/id #edb/ref 17592186389598} {:answer/id #uuid "b6e89d64-16cb-5f6e-924f-288db18c0bdb" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/de/de643820e7690a10eae2e7de2e2cb974700996b36130af4f45c446640b49dcc4.png" :db/id #edb/ref 17592186389599} {:answer/id #uuid "a2e82089-b886-5a96-8c4e-a2c7d256121e" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/5a/5ac45c6757e187796674ca4beda4ff73c60835b401df302bfd8a91fa5c98b68c.png" :db/id #edb/ref 17592186389600}] :answer-field/correct {:db/id #edb/ref 17592186389599} :answer-field/id #uuid "9e761f31-f26b-54c2-90ef-d2fbb7506ab7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186389595}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2da77bc4-04e1-56ef-a7c8-2c62ea7852fc" :question/math-academy-id "q-168140" :question/problem "Which of the following is a type II region in two-dimensional space?" :question/worked-solution "A type II region can be written as\n\n$$\nD=\\{(x,y)\\,:\\,a\\le y\\le b,\\,g(y)\\le x\\le f(y)\\},\n$$\n\nwhere $f$ and $g$ are continuous functions.\n\nA type II region has the property that a horizontal line drawn through the region intersects the region in a single interval only.\n\nAmong the given options, the only type II region is the following.\n\n![](images/1b/1bee7870760a7c267ca83806f04b3fa8b933891fa5e5524ce76ee09f2c7c98e0.png)"} :step/id #uuid "6b389470-3267-59d1-924e-08b2f27327ab"} {:db/id #edb/ref 17592186446092 :step/content {:db/id #edb/ref 17592186403564 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f1d251ac-d08a-5fc3-9ec4-e2a5e2493afa" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186473284} {:answer/id #uuid "19c1a0ea-5caa-5890-ac0d-2d827757e556" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186473285}] :answer-field/correct {:db/id #edb/ref 17592186473285} :answer-field/id #uuid "1a048736-62c4-5ae7-ba08-ddae3a27ddb4" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186474037} {:answer-field/choices [{:answer/id #uuid "d1618621-5371-566a-a49c-7a0f183b30ed" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186473286} {:answer/id #uuid "481f5b87-9f73-537d-9816-151ef21cea64" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186473287}] :answer-field/correct {:db/id #edb/ref 17592186473287} :answer-field/id #uuid "e5e9f322-c387-5cd3-8b91-fdc3fbea85d1" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186474038} {:answer-field/choices [{:answer/id #uuid "797651e0-5145-583d-85ca-f9008b9eeba5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186473288} {:answer/id #uuid "a16652aa-2afa-5a37-aef1-bd72dd19254f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186473289}] :answer-field/correct {:db/id #edb/ref 17592186473288} :answer-field/id #uuid "a3c77b81-b299-5de1-b94d-45a418effefa" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186474039}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d94b1132-4667-52b0-83fe-bd8235741b13" :question/math-academy-id "q-72345" :question/problem "Which of the following statements are true regarding the finite region bounded between the line $y=x$ and the curve $y={x}^{3},$ in the first quadrant?\n\nSelect all that apply.\n\n- **I.** It is a type I region\n- **II.** It is a type II region\n- **III.** It's neither a type I nor a type II region" :question/worked-solution "First, notice that\n\n$$\ny={x}^{3}\\,⟹\\,x=\\sqrt[3]{y}.\n$$\n\nNow, let's sketch our region.\n\n![](images/1d/1d1c1cbe30e6f612f824adc76d712a98194ffccc5edefc11cccdaf07204513ba.png)\n\nWe have the following:\n\n- Any vertical line through the region intersects it on a single interval. Furthermore, we can represent our region as\n\n$$\nD=\\{(x,y)\\,:\\,0\\le x\\le 1,\\,{x}^{3}\\le y\\le x\\}.\n$$\n\nSo, this is a type I region.\n\n- Any horizontal line through the region intersects it on a single interval. Furthermore, we can represent our region as\n\n$$\nD=\\{(x,y)\\,:\\,0\\le y\\le 1,\\,y\\le x\\le \\sqrt[3]{y}\\}.\n$$\n\nSo, this is a type II region.\n\nTherefore, only statements I and II are true."} :step/id #uuid "79b60224-d789-538c-8707-f34af9a3d64e" :step/next {:db/id #edb/ref 17592186446091}} {:db/id #edb/ref 17592186446093 :step/content {:db/id #edb/ref 17592186393194 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b5bce626-d9bb-5dbb-905a-7daed41e086c" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/a2/a216b288b70301fb14b8f1219b909edb69ab77b08c29460b5522abc2025ab494.png" :db/id #edb/ref 17592186393196} {:answer/id #uuid "c9d47ae6-371d-5f7f-a924-edcd6ec62dd3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "None of the listed" :db/id #edb/ref 17592186393197} {:answer/id #uuid "693ea9c7-f1ff-5a1c-b288-3ea683ff953d" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/20/205fdc7a29c94d36b5bd8847a2600c41d7e3fd2ac0fd92947dddcb241bdae012.png" :db/id #edb/ref 17592186393198} {:answer/id #uuid "349c2643-543b-501a-b8d3-7af986d4a0af" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/25/254691f56d0586b2cbfd75a3fce34ecc1062b0f0fde538d3885860ed1b71555c.png" :db/id #edb/ref 17592186393199} {:answer/id #uuid "d7836927-19a4-54a2-aabf-fc9fd48ada96" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/ed/edbcc3bcef921ef736f9bd31bec56f69736c632bf835cf4c9c1c46026fda8083.png" :db/id #edb/ref 17592186393200}] :answer-field/correct {:db/id #edb/ref 17592186393196} :answer-field/id #uuid "7683d677-08f6-57b3-b924-04b4d1ba5f5a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186393195}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "13be6924-14b7-5b8e-8469-18a97723bd20" :question/math-academy-id "q-72120" :question/problem "Which of the following is a type II region in two-dimensional space?" :question/worked-solution "A type II region can be written as\n\n$$\nD=\\{(x,y)\\,:\\,a\\le y\\le b,\\,g(y)\\le x\\le f(y)\\},\n$$\n\nwhere $f$ and $g$ are continuous functions.\n\nA type II region has the property that a horizontal line drawn through the region intersects the region in a single interval only.\n\nAmong the given options, the only type II region is the following.\n\n![](images/e4/e472070f17c47e78024217ed750690b88de87f3849818368dda1dde5d91d90d4.png)"} :step/id #uuid "c93d77e3-7651-52c2-a428-7ad850967a27" :step/next {:db/id #edb/ref 17592186446090}}] :activity/title "Type I and II Regions in Two-Dimensional Space" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186446081}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186515636} :activity/id #uuid "820c7569-ca59-5a59-b866-f834cfa94ce3" :activity/scope {:db/id #edb/ref 17592186050822 :topic/id #uuid "6961ffb7-2e37-5f54-ac39-0331f4517bbc" :topic/math-academy-id 1979} :activity/steps [{:db/id #edb/ref 17592186515626 :step/content {:db/id #edb/ref 17592186342012 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c94e30f0-68f2-5998-b9f9-644e9e44b95f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186468070} {:answer/id #uuid "5f0ed006-c485-5f47-9cb3-66d73cb5b6eb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186468071}] :answer-field/correct {:db/id #edb/ref 17592186468070} :answer-field/id #uuid "e579a2ca-789a-528f-993a-72fedc592395" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186468756} {:answer-field/choices [{:answer/id #uuid "5794e6f7-e7be-5b7e-8bb8-bb34003ae429" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186468072} {:answer/id #uuid "c1777e06-539e-50b4-a94c-4208586ed294" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186468073}] :answer-field/correct {:db/id #edb/ref 17592186468072} :answer-field/id #uuid "3694904e-0ccc-5a31-b8a9-6ec58e4eec46" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186468757} {:answer-field/choices [{:answer/id #uuid "6117a2a3-4603-5502-8e5e-e303e66ecd3a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186468074} {:answer/id #uuid "32f5d350-119e-5636-b3cb-0f999c5e3d27" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186468075}] :answer-field/correct {:db/id #edb/ref 17592186468075} :answer-field/id #uuid "abcdcfba-e886-55b6-abf8-403802e888af" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186468758}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "451e02c3-10e2-5101-a83f-538a8be6b03d" :question/math-academy-id "q-73549" :question/problem "Which of the following statements are true regarding the finite region bounded between the ellipses $4{x}^{2}+{y}^{2}=4$ and $4{x}^{2}+{y}^{2}=1?$\n\nSelect all that apply.\n\n- **I.** It is a type I region\n- **II.** It is a type II region\n- **III.** It's neither a type I nor a type II region" :question/worked-solution "First, let's sketch our region.\n\n![](images/62/627e7e102a0f16cb0c4946e42b48ad122299d729c5bc419293e258a3f2e1701e.png)\n\nWe have the following:\n\n- The vertical line $x=0.25$ intersects the region in two separate intervals, as shown below. So, this can't be a type I region.\n\n![](images/d7/d7aa48c887d6fb1c3d0420867b7e74010fa93e16d7e24317e2cf214764e56113.png)\n\n- The horizontal line $y=0.5$ intersects the region in two separate intervals, as shown below. So, this can't be a type II region.\n\n![](images/ec/ec632fa5f86d8d9b34b9ccf661a3219e965f289c28bf69d7d80eeeb46093e7ae.png)\n\nTherefore, only statement III is true."} :step/id #uuid "0d43dfd0-0bc2-522d-9f41-53b137a34a58"} {:db/id #edb/ref 17592186515636 :step/content {:db/id #edb/ref 17592186129840 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86e11a1f-00dc-51de-8fae-8e31288e9455" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "D=\\{(x,y)\\,:\\,1\\le y\\le 4,\\,2y\\le x\\le \\sqrt{y}\\}" :db/id #edb/ref 17592186515155} {:answer/id #uuid "98af0664-fef3-5195-8942-4ae62f79f459" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "D=\\{(x,y)\\,:\\,1\\le y\\le 4,\\,2y\\le x\\le \\sqrt{y}+1\\}" :db/id #edb/ref 17592186515196} {:answer/id #uuid "9f3d9aa4-b230-5307-8b9e-8fda1b89d36a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "D=\\{(x,y)\\,:\\frac{1}{2}\\le x\\le 3\\,,\\,2x\\le y\\le \\sqrt{x}+1\\}" :db/id #edb/ref 17592186515211} {:answer/id #uuid "a5a1af78-5337-58fe-9506-fb9b3db058f1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "D=\\{(x,y)\\,:\\frac{1}{2}\\le x\\le 2\\,,\\,2x\\le y\\le (x-1)^{2}\\}" :db/id #edb/ref 17592186515222} {:answer/id #uuid "f038c740-7bd9-542c-aa85-3c158363caa4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "D=\\{(x,y)\\,:\\,1\\le y\\le 4,\\,\\frac{y}{2}\\le x\\le \\sqrt{y}+1\\}" :db/id #edb/ref 17592186515376}] :answer-field/correct {:db/id #edb/ref 17592186515376} :answer-field/id #uuid "121eed80-0cfa-5e17-b370-61189884e2ef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186375288}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "771776cb-495a-5541-85ae-ed89a3b38002" :question/math-academy-id "q-71830" :question/problem "![](images/f7/f7a556f986c44b922908b79e3982e098eb7250d9d470092ba2c45bbffe190913.png)\n\nWhich of the following represents the shaded region above as a type II region in two-dimensional space?" :question/worked-solution "A type II region can be written as\n\n$$\nD=\\{(x,y)\\,:\\,a\\le y\\le b,\\,g(y)\\le x\\le f(y)\\},\n$$\n\nwhere $f$ and $g$ are continuous functions.\n\nTo express the given region as a type II region, we first rewrite all of the given curves as functions of $y:$\n\n$$\ny=2x\\,⟹\\,x=\\frac{y}{2}\n$$\n\nThe function $x=\\sqrt{y}+1$ is already written as a function of $y.$\n\nNotice that the region lies between the horizontal lines $y=1$ and $y=4.$ So, we have $1\\le y\\le 4.$\n\nWe draw a horizontal arrow through the region to determine the left function $g(y)$ and the right function $f(y).$ A horizontal line should intersect the region in a single interval only for it to be a type II region.\n\n![](images/c5/c55d5f809462b767122ccc4af97c5b4d243730ed24f655bdc18e35ec57e25ce2.png)\n\nThe horizontal line enters the region through the lower function $x=\\frac{y}{2}$ and leaves through the upper function $x=\\sqrt{y}+1.$ So, we have $\\frac{y}{2}\\le x\\le \\sqrt{y}+1.$\n\nTherefore, we obtain\n\n$$\nD=\\{(x,y)\\,:\\,1\\le y\\le 4,\\,\\frac{y}{2}\\le x\\le \\sqrt{y}+1\\}.\n$$"} :step/id #uuid "1eccfbc0-5646-515c-b76e-a435267876f8" :step/next {:db/id #edb/ref 17592186515654}} {:db/id #edb/ref 17592186515654 :step/content {:db/id #edb/ref 17592186129842 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55a6ee0a-d96f-565a-b86b-753fef10bcb0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186460173} {:answer/id #uuid "c5fa2d01-0363-5414-aee0-15a329ab0bd8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186460174}] :answer-field/correct {:db/id #edb/ref 17592186460173} :answer-field/id #uuid "5ad56762-b330-5bb1-8ba0-9869f5af2ead" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186460953} {:answer-field/choices [{:answer/id #uuid "b3f634cf-ea4c-5e68-b5da-4eef1c1c56af" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186460175} {:answer/id #uuid "49f35556-5b7c-515b-9a7a-4189930ec2c0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186460176}] :answer-field/correct {:db/id #edb/ref 17592186460175} :answer-field/id #uuid "409900db-4264-516b-b459-9b27a44721c2" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186460954} {:answer-field/choices [{:answer/id #uuid "34ae5851-54cb-53e1-a0fe-3cb10c69a3f8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186460177} {:answer/id #uuid "58d69edb-8d2a-5ce7-bef1-d0329b4c1d8e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186460178}] :answer-field/correct {:db/id #edb/ref 17592186460178} :answer-field/id #uuid "f764f310-ac1b-5163-8ef9-b2f704f3384e" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186460955}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "7805c1fc-f8dc-58be-9c44-d22a8226c755" :question/math-academy-id "q-71895" :question/problem "Which of the following statements are true regarding the finite region bounded between the circles ${x}^{2}+(y-1)^{2}=1$ and ${x}^{2}+{y}^{2}=4?$\n\nSelect all that apply.\n\n- **I.** It is a type I region\n- **II.** It is a type II region\n- **III.** It's neither a type I nor a type II region" :question/worked-solution "First, let's sketch our region.\n\n![](images/24/24cbd9a0e01023dca6a289838d94efe3c7b67abe5b7a1f275f6945f280e65d64.png)\n\nWe have the following:\n\n- The vertical line $x=0.75$ intersects the region in two separate intervals, as shown below. So, this can't be a type I region.\n\n![](images/6c/6c51abe5c21571a9c5596fce4e3b8ace210eacfab125016e6b9a3b2a7bc2e056.png)\n\n- The horizontal line $y=1$ intersects the region in two separate intervals, as shown below. So, this can't be a type II region.\n\n![](images/f9/f9fed5856eda128d84debec320bc38a35eaa2bf5184b1f81cb1194b02f8a306a.png)\n\nTherefore, only statement III is true."} :step/id #uuid "549657be-a51d-5365-b225-95d098f92f33" :step/next {:db/id #edb/ref 17592186515685}} {:db/id #edb/ref 17592186515685 :step/content {:db/id #edb/ref 17592186375321 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cd4804dc-232f-5717-b07c-b3e74fbff1bc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "None of the listed" :db/id #edb/ref 17592186375323} {:answer/id #uuid "a9fa7755-b5ce-5247-a0a8-910a9073e68d" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/ef/ef9d0a612a093852fd9f60fb20c86b946c178f9e2a9877ef7c16f89f98e324f6.png" :db/id #edb/ref 17592186375324} {:answer/id #uuid "89301be4-f9a9-59a2-ac5e-5d39c6146fc8" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/67/67b42d8a49263abc8cce98f20b59370047b989ae69d55050e4001897ba3f9d2e.png" :db/id #edb/ref 17592186375325} {:answer/id #uuid "0e509b6d-02de-56c1-a9e8-7efb98174520" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/5e/5eb14fb126d8b0df54e5523d705cb5491e161c00b118f07a0bf3407644b7d4a0.png" :db/id #edb/ref 17592186375326} {:answer/id #uuid "79d18367-2462-5b79-ac87-734c517ed764" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/32/3228d2d0c2fb3ce74c98b018c0694e9da5fc4a8444a7b67b5fb7fa0eb24eaa6c.png" :db/id #edb/ref 17592186375327}] :answer-field/correct {:db/id #edb/ref 17592186375326} :answer-field/id #uuid "2d8d4731-859f-5217-921a-45bb7148c36f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186375322}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f280067d-2410-589e-b620-7c39e01b3ccd" :question/math-academy-id "q-72319" :question/problem "Which of the following is a type II region in two-dimensional space?" :question/worked-solution "A type II region can be written as\n\n$$\nD=\\{(x,y)\\,:\\,a\\le y\\le b,\\,g(y)\\le x\\le f(y)\\},\n$$\n\nwhere $f$ and $g$ are continuous functions.\n\nA type II region has the property that a horizontal line drawn through the region intersects the region in a single interval only.\n\nAmong the given options, the only type II region is the following.\n\n![](images/12/1206abdf317df09c8c54714a6178d78570b3c10a49513c3c626c09be3ea2cf72.png)"} :step/id #uuid "b5cb88a3-789d-5dd8-871d-8cd73e60f6f0" :step/next {:db/id #edb/ref 17592186515701}} {:db/id #edb/ref 17592186515701 :step/content {:db/id #edb/ref 17592186342005 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1756c48c-665f-5f06-b577-1b909cc87f92" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "D=\\{(x,y)\\,:\\,1\\le y\\le 3,\\,-\\sqrt{y}+3\\le x\\le \\frac{y}{2}+2\\}" :db/id #edb/ref 17592186514921} {:answer/id #uuid "1a8d8801-ef97-55e2-bc3a-31cf1be29d3f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "D=\\{(x,y)\\,:\\,\\sqrt{y}\\le y\\le \\frac{y}{2},\\,1\\le x\\le 3\\}" :db/id #edb/ref 17592186514930} {:answer/id #uuid "a8039587-077a-5341-9003-3971e08c6ca6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "D=\\{(x,y)\\,:\\,1\\le y\\le 3,\\,-\\sqrt{y}+2\\le x\\le -\\frac{y}{2}+3\\}" :db/id #edb/ref 17592186515225} {:answer/id #uuid "b4fa72f4-3cd9-588c-8d31-a887a4ecafd6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "D=\\{(x,y)\\,:\\,-\\sqrt{y}+2\\le y\\le -\\frac{y}{2}+3,\\,1\\le x\\le 3\\}" :db/id #edb/ref 17592186515251} {:answer/id #uuid "f6ff3e83-5d71-5daa-b2f8-25c47f45a202" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "D=\\{(x,y)\\,:\\,0\\le y\\le 3,\\,-\\sqrt{y}+2\\le x\\le 2.5\\}" :db/id #edb/ref 17592186515389}] :answer-field/correct {:db/id #edb/ref 17592186515225} :answer-field/id #uuid "2dd26fe5-df42-54f1-a759-c32dddc997da" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341458}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "80f56e91-1777-5d7a-b918-7d315f6b332a" :question/math-academy-id "q-73534" :question/problem "![](images/c3/c316b62d5c1a08c6513413fd87c36c6feb26fb632709909a9c9f761d0806c4af.png)\n\nWhich of the following represents the shaded region above as a type II region in two-dimensional space?" :question/worked-solution "A type II region can be written as\n\n$$\nD=\\{(x,y)\\,:\\,a\\le y\\le b,\\,g(y)\\le x\\le f(y)\\},\n$$\n\nwhere $f$ and $g$ are continuous functions.\n\nTo express the given region as a type II region, we first rewrite all of the given curves as functions of $y:$\n\n$$\ny=-2(x-3)\\,⟹\\,x=-\\frac{y}{2}+3\n$$\n\nThe function $x=-\\sqrt{y}+2$ is already written as a function of $y.$\n\nNotice that the region lies between the horizontal lines $y=1$ and $y=3.$ So, we have $1\\le y\\le 3.$\n\nWe draw a horizontal arrow through the region to determine the left function $g(y)$ and the right function $f(y).$ A horizontal line should intersect the region in a single interval only for it to be a type II region.\n\n![](images/fb/fb05eec73599c1beb8dd588c478208315f6edaf10af999115eb29fa10d5601e9.png)\n\nThe horizontal line enters the region through the lower function $x=-\\sqrt{y}+2$ and leaves through the upper function $x=-\\frac{y}{2}+3.$ So, we have $-\\sqrt{y}+2\\le x\\le -\\frac{y}{2}+3.$\n\nTherefore, we obtain\n\n$$\nD=\\{(x,y)\\,:\\,1\\le y\\le 3,\\,-\\sqrt{y}+2\\le x\\le -\\frac{y}{2}+3\\}.\n$$"} :step/id #uuid "d98b72e4-43cf-558b-8b0e-212ac545b3e9" :step/next {:db/id #edb/ref 17592186515626}}] :activity/title "Type I and II Regions in Two-Dimensional Space" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186514859}]}
