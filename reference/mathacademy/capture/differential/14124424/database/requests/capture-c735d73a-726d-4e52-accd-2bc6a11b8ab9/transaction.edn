db/id "answer-7cfb5360-6ccd-5c63-9ad7-875282e7b9de" :answer/id #uuid "7cfb5360-6ccd-5c63-9ad7-875282e7b9de" :answer/type :answer.type/math :answer/value "21" :db/ensure [:answer/validate]} {:db/id "answer-4bb8e441-16c8-530a-917b-10b4c86c13eb" :answer/id #uuid "4bb8e441-16c8-530a-917b-10b4c86c13eb" :answer/type :answer.type/math :answer/value "23" :db/ensure [:answer/validate]} {:db/id "answer-628d10ee-284c-52e3-b4ae-27022236c5ce" :answer/id #uuid "628d10ee-284c-52e3-b4ae-27022236c5ce" :answer/type :answer.type/math :answer/value "\\sqrt{471}" :db/ensure [:answer/validate]} {:db/id "answer-108dbbc7-92f9-5c26-a888-dc74c843d18a" :answer/id #uuid "108dbbc7-92f9-5c26-a888-dc74c843d18a" :answer/type :answer.type/math :answer/value "\\sqrt{495}" :db/ensure [:answer/validate]} {:db/id "answer-9dad544e-f652-53b2-8f71-6060a1e81965" :answer/id #uuid "9dad544e-f652-53b2-8f71-6060a1e81965" :answer/type :answer.type/math :answer/value "\\sqrt{530}" :db/ensure [:answer/validate]} {:db/id "question-cbc4c264-a470-51c7-b34c-2fec35b37aa8" :question/id #uuid "cbc4c264-a470-51c7-b34c-2fec35b37aa8" :question/math-academy-id "q-74123" :question/problem "Given the vectors $a=[\\begin{aligned}5 \\\\ 3 \\\\ -1 \\\\ 1 \\\\ 6\\end{aligned}]$ and $b=[\\begin{aligned}3 \\\\ 5 \\\\ 1 \\\\ -1 \\\\ 6\\end{aligned}]$, find the distance $\\text{d}(a,b).$" :question/worked-solution "Using the formula for the distance, we have\n\n$$\n\\begin{aligned}\\text{d}(a,b) & =‖a-b‖ \\\\  & =\\sqrt{({a}_{1}-{b}_{1})^{2}+({a}_{2}-{b}_{2})^{2}+({a}_{3}-{b}_{3})^{2}+({a}_{4}-{b}_{4})^{2}+({a}_{5}-{b}_{5})^{2}} \\\\  & =\\sqrt{(5-3)^{2}+(3-5)^{2}+(-1-1)^{2}+(1-(-1))^{2}+(6-6)^{2}} \\\\  & =\\sqrt{{2}^{2}+(-2)^{2}+(-2)^{2}+{2}^{2}+{0}^{2}} \\\\  & =\\sqrt{4+4+4+4+0} \\\\  & =\\sqrt{16} \\\\  & =4.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-2670353f-0ead-5f64-a671-b59cfdccdce5"] :db/ensure [:question/validate]} {:db/id "answer-field-2670353f-0ead-5f64-a671-