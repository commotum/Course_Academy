$" :question/worked-solution "Using the formula for the norm, we have\n\n$$\n\\begin{aligned}‖w‖ & =\\sqrt{{w}_{1}^{2}+{w}_{2}^{2}+{w}_{3}^{2}+{w}_{4}^{2}+{w}_{5}^{2}} \\\\  & =\\sqrt{(-2)^{2}+(-1)^{2}+{9}^{2}+{2}^{2}+(\\sqrt{10})^{2}} \\\\  & =\\sqrt{4+1+81+4+10} \\\\  & =\\sqrt{100} \\\\  & =10.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-927f21d5-5ee5-55ad-8f32-98ef453c6640"] :db/ensure [:question/validate]} {:db/id "answer-field-927f21d5-5ee5-55ad-8f32-98ef453c6640" :answer-field/id #uuid "927f21d5-5ee5-55ad-8f32-98ef453c6640" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7f56a8db-0847-554c-8a3c-fbe50cec4038" :answer-field/choices ["answer-7f56a8db-0847-554c-8a3c-fbe50cec4038" "answer-5325fd97-a1ce-5989-ad0f-60f3bf0d3f08" "answer-dad9a40f-a641-5776-bf4b-27f888acac5c" "answer-8b86d00b-63f2-58b8-a66c-25688b67d507" "answer-dac077dd-7c91-587d-ad3a-edc888911e37"] :db/ensure [:answer-field/validate]} {:db/id "answer-7f56a8db-0847-554c-8a3c-fbe50cec4038" :answer/id #uuid "7f56a8db-0847-554c-8a3c-fbe50cec4038" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-5325fd97-a1ce-5989-ad0f-60f3bf0d3f08" :answer/id #uuid "5325fd97-a1ce-5989-ad0f-60f3bf0d3f08" :answer/type :answer.type/math :answer/value "20" :db/ensure [:answer/validate]} {:db/id "answer-dad9a40f-a641-5776-bf4b-27f888acac5c" :answer/id #uuid "dad9a40f-a641-5776-bf4b-27f888acac5c" :answer/type :answer.type/math :answer/value "2\\sqrt{10}" :db/ensure [:answer/validate]} {:db/id "answer-8b86d00b-63f2-58b8-a66c-25688b67d507" :answer/id #uuid "8b86d00b-63f2-58b8-a66c-25688b67d507" :answer/type :answer.type/math :answer/value "2\\sqrt{50}" :db/ensure [:answer/validate]} {:db/id "answer-dac077dd-7c91-587d-ad3a-edc888911e37" :answer/id #uuid "dac077dd-7c91-587d-ad3a-edc888911e37" :answer/type :answer.type/math :answer/value "\\sqrt{10}" :db/ensure [:answer/validate]} {:db/id "question-203f62af-5fb6-55c0-adc4-39591e34a84e" :question/id #uuid "203f62af-5fb6-55c0-adc4-39591e34a84e" :question/math-academy-id "q-74112" :question/problem "Given $a=[\\begin{aligned}3 \\\\ 0 \\\\ 4\\end{aligned}]$, find $‖a‖.$" :question/worked-solution "Using the formula for the norm, we have\n\n$$\n\\begin{aligned}‖a‖ & =\\sqrt{{a}_{1}^{2}+{a}_{2}^{2}+{a}_{3}^{2}} \\\\  & =\\sqrt{{3}^{2}+{0}^{2}+{4}^{2}} \\\\  & =\\sqrt{9+16} \\\\  & =\\sqrt{25} \\\\  & =5.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-159b604b-074b-5dab-9731-8def4defd472"] :db/ensure [:question/validate]} {:db/id "answer-field-159b604b-074b-5dab-9731-8def4defd472" :answer-field/id #uuid "159b604b-074b-5dab-9731-8def4defd472" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0321dad9-7a91-5b43-b252-10b7425bf47e" :answer-field/choices ["answer-5ffebb7a-7c2f-5232-82ab-36fabe11517c" "answer-3d402660-4ccd-5a89-a0a7-8af179d1b65b" "answer-16f2bc27-34f2-5477-bbe3-2f9bb1e0fe26" "answer-0321dad9-7a91-5b43-b252-10b7425bf47e" "answer-52062bf9-5943-5448-a6df-d00d280b0713"] :db/ensure [:answer-field/validate]} {:db/id "answer-5ffebb7a-7c2f-5232-82ab-36fabe11517c" :answer/id #uuid "5ffebb7a-7c2f-5232-82ab-36fabe11517c" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-3d402660-4ccd-5a89-a0a7-8af179d1b65b" :answer/id #uuid "3d402660-4ccd-5a89-a0a7-8af179d1b65b" :answer/type :answer.type/math :answer/value "2\\sqrt{5}" :db/ensure [:answer/validate]} {:db/id "answer-16f2bc27-34f2-5477-bbe3-2f9bb1e0fe26" :answer/id #uuid "16f2bc27-34f2-5477-bbe3-2f9bb1e0fe26" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-0321dad9-7a91-5b43-b252-10b7425bf47e" :answer/id #uuid "0321dad9-7a91-5b43-b252-10b7425bf47e" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-52062bf9-5943-5448-a6df-d00d280b0713" :answer/id #uuid "52062bf9-5943-5448-a6df-d00d280b0713" :answer/type :answer.type/math :answer/value "\\sqrt{5}" :db/ensure [:answer/validate]} {:db/id "question-a59db3f3-f5cf-55e8-a066-a483320cdf58" :question/id #uuid "a59db3f3-f5cf-55e8-a066-a483320cdf58" :question/math-academy-id "q-74119" :question/problem "Given $x=[\\begin{aligned}-3 \\\\ 3 \\\\ 8 \\\\ 3 \\\\ -3\\end{aligned}]$, find $‖x‖.$" :question/worked-solution "Using the formula for the norm, we have\n\n$$\n\\begin{aligned}‖x‖ & =\\sqrt{{x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2}+{x}_{4}^{2}+{x}_{5}^{2}} \\\\  & =\\sqrt{(-3)^{2}+{3}^{2}+{8}^{2}+{3}^{2}+(-3)^{2}} \\\\  & =\\sqrt{9+9+64+9+9} \\\\  & =\\sqrt{100} \\\\  & =10.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-37120e7e-6786-51db-81c0-d0b14e33c411"] :db/ensure [:question/validate]} {:db/id "answer-field-37120e7e-6786-51db-81c0-d0b14e33c411" :answer-field/id #uuid "37120e7e-6786-51db-81c0-d0b14e33c411" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bc4bc073-c1a4-5e73-8781-e84f4b41d203" :answer-field/choices ["answer-bc4bc073-c1a4-5e73-8781-e84f4b41d203" "answer-54cf7b2d-6da6-5445-b5a6-36b589d1bb59" "answer-8ce74f01-ae8d-560f-8571-d44af4d583c7" "answer-1ea78520-9772-565f-b6c7-dcfdb658a382" "answer-f5675c4d-f538-599b-a465-676708aa48e7"] :db/ensure [:answer-field/validate]} {:db/id "answer-bc4bc073-c1a4-5e73-8781-e84f4b41d203" :answer/id #uuid "bc4bc073-c1a4-5e73-8781-e84f4b41d203" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-54cf7b2d-6da6-5445-b5a6-36b589d1bb59" :answer/id #uuid "54cf7b2d-6da6-5445-b5a6-36b589d1bb59" :answer/type :answer.type/math :answer/value "2\\sqrt{10}" :db/ensure [:answer/validate]} {:db/id "answer-8ce74f01-ae8d-560f-8571-d44af4d583c7" :answer/id #uuid "8ce74f01-ae8d-560f-8571-d44af4d583c7" :answer/type :answer.type/math :ans