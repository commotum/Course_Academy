r/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{10}" :db/id #edb/ref 17592186340349} :answer-field/id #uuid "4c32c531-076f-52b6-aebd-a5aa95cc7d98" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341513}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9a189b1e-6084-525e-b3be-a2438685ab6a" :question/math-academy-id "q-74117" :question/problem "Given $v=[\\begin{aligned}2 \\\\ 1 \\\\ -1 \\\\ 2 \\\\ 0\\end{aligned}]$, find $‖v‖.$" :question/worked-solution "Using the formula for the norm, we have\n\n$$\n\\begin{aligned}‖v‖ & =\\sqrt{{v}_{1}^{2}+{v}_{2}^{2}+{v}_{3}^{2}+{v}_{4}^{2}+{v}_{5}^{2}} \\\\  & =\\sqrt{{2}^{2}+{1}^{2}+(-1)^{2}+{2}^{2}+{0}^{2}} \\\\  & =\\sqrt{4+1+1+4+0} \\\\  & =\\sqrt{10}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186423594 :knowledge-point/_questions [{:db/id #edb/ref 17592186133759 :knowledge-point/id #uuid "d893f937-d802-5d27-b91a-b78caee0313e" :knowledge-point/title "Calculating the Norm of a Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5325fd97-a1ce-5989-ad0f-60f3bf0d3f08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186423525} {:answer/id #uuid "7f56a8db-0847-554c-8a3c-fbe50cec4038" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186423538} {:answer/id #uuid "8b86d00b-63f2-58b8-a66c-25688b67d507" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{50}" :db/id #edb/ref 17592186423543} {:answer/id #uuid "dac077dd-7c91-587d-ad3a-edc888911e37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{10}" :db/id #edb/ref 17592186423562} {:answer/id #uuid "dad9a40f-a641-5776-bf4b-27f888acac5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{10}" :db/id #edb/ref 17592186423563}] :answer-field/correct {:answer/id #uuid "7f56a8db-0847-554c-8a3c-fbe50cec4038" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186423538} :answer-field/id #uuid "927f21d5-5ee5-55ad-8f32-98ef453c6640" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186423580}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a076c01e-29ae-51f5-9ba7-a79f626ba8b5" :question/math-academy-id "q-74118" :question/problem "Given $w=[\\begin{aligned}-2 \\\\ -1 \\\\ 9 \\\\ 2 \\\\ \\sqrt{10}\\end{aligned}]$, find $‖w‖.$" :question/worked-solution "Using the formula for the norm, we have\n\n$$\n\\begin{aligned}‖w‖ & =\\sqrt{{w}_{1}^{2}+{w}_{2}^{2}+{w}_{3}^{2}+{w}_{4}^{2}+{w}_{5}^{2}} \\\\  & =\\sqrt{(-2)^{2}+(-1)^{2}+{9}^{2}+{2}^{2}+(\\sqrt{10})^{2}} \\\\  & =\\sqrt{4+1+81+4+10} \\\\  & =\\sqrt{100} \\\\  & =10.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186423595 :knowledge-point/_questions [{:db/id #edb/ref 17592186133759 :knowledge-point/id #uuid "d893f937-d802-5d27-b91a-b78caee0313e" :knowledge-point/title "Calculating the Norm of a Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ea78520-9772-565f-b6c7-dcfdb658a382" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186423515} {:answer/id #uuid "54cf7b2d-6da6-5445-b5a6-36b589d1bb59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{10}" :db/id #edb/ref 17592186423527} {:answer/id #uuid "8ce74f01-ae8d-560f-8571-d44af4d583c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{5}" :db/id #edb/ref 17592186423544} {:answer/id #uuid "bc4bc073-c1a4-5e73-8781-e84f4b41d203" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186423557} {:answer/id #uuid "f5675c4d-f538-599b-a465-676708aa48e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{10}" :db/id #edb/ref 17592186423569}] :answer-field/correct {:answer/id #uuid "bc4bc073-c1a4-5e73-8781-e84f4b41d203" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186423557} :answer-field/id #uuid "37120e7e-6786-51db-81c0-d0b14e33c411" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186423578}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a59db3f3-f5cf-55e8-a066-a483320cdf58" :question/math-academy-id "q-74119" :question/problem "Given $x=[\\begin{aligned}-3 \\\\ 3 \\\\ 8 \\\\ 3 \\\\ -3\\end{aligned}]$, find $‖x‖.$" :question/worked-solution "Using the formula for the norm, we have\n\n$$\n\\begin{aligned}‖x‖ & =\\sqrt{{x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2}+{x}_{4}^{2}+{x}_{5}^{2}} \\\\  & =\\sqrt{(-3)^{2}+{3}^{2}+{8}^{2}+{3}^{2}+(-3)^{2}} \\\\  & =\\sqrt{9+9+64+9+9} \\\\  & =\\sqrt{100} \\\\  & =10.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186423597 :knowledge-point/_questions [{:db/id #edb/ref 17592186133760 :knowledge-point/id #uuid "ff66eef8-74b6-5553-af34-7da5a8cbbb02" :knowledge-point/title "Finding the Distance Between Two Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04dbab12-ca8b-5d27-a241-6617b3607e24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186423505} {:answer/id #uuid "81181822-cd9e-5ebe-99ad-1065ecd54e03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186423539} {:answer/id #uuid "a3d26198-c194-5268-8149-7ccc9e0403a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186423550} {:answer/id #uuid "c84a9560-e8c6-5078-9628-8ebbdf4d654e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186423560} {:answer/id #uuid "e15fee0c-8204-5a54-812c-d64d46c84a64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186423564}] :answer-field/correct {:answer/id #uuid "c84a9560-e8c6-5078-9628-8ebbdf4d654e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186423560} :answer-field/id #uuid "2670353f-0ead-5f64-a671-b59cfdccdce5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186423576}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cbc4c264-a470-51c7-b34c-2fec35b37aa8" :question/math-academy-id "q-74123" :question/problem "Given the vectors $a=[\\begin{aligned}5 \\\\ 3 \\\\ -1 \\\\ 1 \\\\ 6\\end{aligned}]$ and $b=[\\begin{aligned}3 \\\\ 5 \\\\ 1 \\\\ -1 \\\\ 6\\end{aligned}]$, find the distance $\\text{d}(a,b).$" :question/worked-solution "Using the formula for the distance, we have\n\n$$\n\\begin{aligned}\\text{d}(a,b) & =‖a-b‖ \\\\  & =\\sqrt{({a}_{1}-{b}_{1})^{2}+({a}_{2}-{b}_{2})^{2}+({a}_{3}-{b}_{3})^{2}+({a}_{4}-{b}_{4})^{2}+({a}_{5}-{b}_{5})^{2}} \\\\  & =\\sqrt{(5-3)^{2}+(3-5)^{2}+(-1-1)^{2}+(1-(-1))^{2}+(6-6)^{2}} \\\\  & =\\sqrt{{2}^{2}+(-2)^{2}+(-2)^{2}+{2}^{2}+{0}^{2}} \\\\  & =\\sqrt{4+4+4+4+0} \\\\  & =\\sqrt{16} \\\\  & =4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186342158 :knowledge-point/_questions [{:db/id #edb/ref 17592186133760 :knowledge-point/id #uuid "ff66eef8-74b6-5553-af34-7da5a8cbbb02" :knowledge-point/title "Finding the Distance Between Two Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37434868-6f5f-5d16-8d45-01edccea5e52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186339624} {:answer/id #uuid "94f647cd-bd1d-51c8-9266-cc5aca828872" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{7}" :db/id #edb/ref 17592186340468} {:answer/id #uuid "9e846bf6-f159-545e-b906-81ce9285dc93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{6}" :db/id #edb/ref 17592186340558} {:answer/id #uuid "fd373fb9-0f16-5a86-861d-451773494a13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186341367} {:answer/id #uuid "ff264c79-d1db-59ac-9c5c-358688706ec3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186341375}] :answer-field/correct {:answer/id #uuid "37434868-6f5f-5d16-8d45-01edccea5e52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186339624} :answer-field/id #uuid "76df1ca7-f9cc-592c-b62b-3e5795092e6d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341589}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "af2154e6-d3f8-5a48-b875-56e7eea54063" :question/math-academy-id "q-74126" :question/problem "Find the distance between the vector $c=[\\begin{aligned}-3 \\\\ 0 \\\\ 2 \\\\ 4 \\\\ \\sqrt{7}\\end{aligned}]$ and the vector $0.$" :question/worked-solution "Using the formula for the distance, we have\n\n$$\n\\begin{aligned}\\text{d}(c,0) & =‖c-0‖ \\\\  & =‖c‖ \\\\  & =\\sqrt{{c}_{1}^{2}+{c}_{2}^{2}+{c}_{3}^{2}+{c}_{4}^{2}+{c}_{5}^{2}} \\\\  & =\\sqrt{(-3)^{2}+{0}^{2}+{2}^{2}+{4}^{2}+(\\sqrt{7})^{2}} \\\\  & =\\sqrt{9+0+4+16+7} \\\\  & =\\sqrt{36} \\\\  & =6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186342159 :knowledge-point/_questions [{:db/id #edb/ref 17592186133824 :knowledge-point/id #uuid "837e0fa4-b8d3-59c1-87c7-44317adafaf9" :knowledge-point/title "Factoring a Constant Out of the Norm"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1437c17c-3dad-5082-848d-4310eca38fa8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{5}" :db/id #edb/ref 17592186339307} {:answer/id #uuid "2c7242ae-c9d8-5d6e-a9b6-3ac28a44c895" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{10}" :db/id #edb/ref 17592186339513} {:answer/id #uuid "7804df71-e14e-5c60-b661-dbab81394099" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{10}" :db/id #edb/ref 17592186340199} {:answer/id #uuid "d1da5792-1232-5d4b-a7c1-e58f9b029e64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4\\sqrt{10}" :db/id #edb/ref 17592186340989} {:answer/id #uuid "fe39e4ae-30fe-5205-bcf7-1682d2c4a5ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\sqrt{10}" :db/id #edb/ref 17592186341370}] :answer-field/correct {:answer/id #uuid "2c7242ae-c9d8-5d6e-a9b6-3ac28a44c895" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{10}" :db/id #edb/ref 17592186339513} :answer-field/id #uuid "f9d33391-8604-594a-aeda-64c8336fdd05" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341827}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7e06b7e6-fc39-5b93-a36f-ce6fa273939e" :question/math-academy-id "q-74128" :question/problem "Given the vector $u=[\\begin{aligned}2 \\\\ -1 \\\\ 5 \\\\ 3 \\\\ 1\\end{aligned}]$, find $‖-2u‖.$" :question/worked-solution "Remember that we can factor a constant out of the norm, provided that we take the absolute value of the constant:\n\n$$\n‖ku‖=|k|\\cdot ‖u‖\n$$\n\nUsing this fact and the formula for the norm, we have\n\n$$\n\\begin{aligned}‖-2u‖ & =|-2|\\cdot ‖u‖ \\\\  & =2\\sqrt{{u}_{1}^{2}+{u}_{2}^{2}+{u}_{3}^{2}+{u}_{4}^{2}+{u}_{5}^{2}} \\\\  & =2\\sqrt{{2}^{2}+(-1)^{2}+{5}^{2}+{3}^{2}+{1}^{2}} \\\\  & =2\\sqrt{4+1+25+9+1} \\\\  & =2\\sqrt{40} \\\\  & =2\\cdot 2\\sqrt{10} \\\\  & =4\\sqrt{10}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186423592 :knowledge-point/_questions [{:db/id #edb/ref 17592186133824 :knowledge-point/id #uuid "837e0fa4-b8d3-59c1-87c7-44317adafaf9" :knowledge-point/title "Factoring a Constant Out of the Norm"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09cd35ab-5375-5955-b3eb-b86578cb2956" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{5}" :db/id #edb/ref 17592186423507} {:answer/id #uuid "8ab3596c-42f0-561d-978c-86dd4ffe5fc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{5}" :db/id #edb/ref 17592186423542} {:answer/id #uuid "ab701453-cfdc-5ae4-b243-b1e4e6c6f06d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{10}" :db/id #edb/ref 17592186423552} {:answer/id #uuid "b37fbc05-fe82-5876-bcb9-d58736c4f50d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\sqrt{5}" :db/id #edb/ref 17592186423556} {:answer/id #uuid "bebae5b0-873f-5d88-8b25-daff30c6fafa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\sqrt{10}" :db/id #edb/ref 17592186423559}] :answer-field/correct {:answer/id #uuid "b37fbc05-fe82-5876-bcb9-d58736c4f50d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\sqrt{5}" :db/id #edb/ref 17592186423556} :answer-field/id #uuid "dfbc77cc-9928-5c7b-a442-680cf76c0925" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186423584}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8cc596a5-8803-52b2-93a7-a243d5af26bc" :question/math-academy-id "q-74130" :question/problem "Given the vector $v=[\\begin{aligned}-1 \\\\ 3 \\\\ 1 \\\\ -3\\end{aligned}]$, find $‖4v‖.$" :question/worked-solution "Remember that we can factor a constant out of the norm, provided that we take the absolute value of the constant:\n\n$$\n‖kv‖=|k|\\cdot ‖v‖\n$$\n\nUsing this fact and the formula for the norm, we have\n\n$$\n\\begin{aligned}‖4v‖ & =|4|\\cdot ‖v‖ \\\\  & =4\\sqrt{{v}_{1}^{2}+{v}_{2}^{2}+{v}_{3}^{2}+{v}_{4}^{2}} \\\\  & =4\\sqrt{(-1)^{2}+{3}^{2}+{1}^{2}+(-3)^{2}} \\\\  & =4\\sqrt{1+9+1+9} \\\\  & =4\\sqrt{20} \\\\  & =4\\cdot 2\\sqrt{5} \\\\  & =8\\sqrt{5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186423600 :knowledge-point/_questions [{:db/id #edb/ref 17592186133824 :knowledge-point/id #uuid "837e0fa4-b8d3-59c1-87c7-44317adafaf9" :knowledge-point/title "Factoring a Constant Out of the Norm"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20baf338-65e1-5d1d-b674-3f0a7f87c7ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186423516} {:answer/id #uuid "21569f32-2dd3-522d-a835-82a75760b312" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186423517} {:answer/id #uuid "4299f0c5-cc63-5808-99df-fdda4a65c6fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186423521} {:answer/id #uuid "741632d1-208c-5d04-9dd7-95fb12ced8dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186423533} {:answer/id #uuid "939ab4ac-b0eb-5583-a507-30ec715ed593" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186423545}] :answer-field/correct {:answer/id #uuid "939ab4ac-b0eb-5583-a507-30ec715ed593" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186423545} :answer-field/id #uuid "a1b99505-88f3-5e64-abac-1b95f853d681" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186423582}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "eca368ca-a4ba-5312-b178-c63c0431130b" :question/math-academy-id "q-74132" :question/problem "If $‖-2x‖=3$, find $‖6x‖.$" :question/worked-solution "Remember that we can factor a constant out of the norm, provided that we take the absolute value of the constant:\n\n$$\n‖kx‖=|k|\\cdot ‖x‖\n$$\n\nUsing this fact, we can solve for the norm $‖x‖$ as follows:\n\n$$\n\\begin{aligned}‖-2x‖ & =3 \\\\ |-2|\\cdot ‖x‖ & =3 \\\\ ‖x‖ & =\\frac{3}{2}\\end{aligned}\n$$\n\nNow, we can evaluate $‖6x‖:$\n\n$$\n\\begin{aligned}‖6x‖ & =6\\cdot ‖x‖ \\\\  & =6\\cdot \\frac{3}{2} \\\\  & =9\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186423591 :knowledge-point/_questions [{:db/id #edb/ref 17592186133761 :knowledge-point/id #uuid "ae41d849-9def-540c-8985-8fbeec679991" :knowledge-point/title "Normalizing a Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12ff338b-c3cb-5873-97ee-33513fecbc83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 \\\\ \\frac{2\\sqrt{2}}{9} \\\\ -\\frac{\\sqrt{2}}{6} \\\\ \\frac{\\sqrt{2}}{6}\\end{aligned}]" :db/id #edb/ref 17592186423511} {:answer/id #uuid "5363f39a-7b6b-5cdc-aac6-d7bb396071fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 \\\\ \\frac{\\sqrt{2}}{3} \\\\ -\\frac{\\sqrt{2}}{3} \\\\ \\frac{\\sqrt{2}}{3}\\end{aligned}]" :db/id #edb/ref 17592186423526} {:answer/id #uuid "7d42fa43-344e-5abb-8870-37969fd0327c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 \\\\ 4 \\\\ -1 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186423537} {:answer/id #uuid "95b4a85b-7861-5ab1-b592-7b9c8569104e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 \\\\ \\frac{2\\sqrt{2}}{3} \\\\ -\\frac{\\sqrt{2}}{6} \\\\ \\frac{\\sqrt{2}}{6}\\end{aligned}]" :db/id #edb/ref 17592186423546} {:answer/id #uuid "9f3d4087-3766-5495-930d-d4cde087cd64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 \\\\ \\frac{4\\sqrt{2}}{3} \\\\ -\\frac{\\sqrt{2}}{6} \\\\ \\frac{\\sqrt{2}}{6}\\end{aligned}]" :db/id #edb/ref 17592186423549}] :answer-field/correct {:answer/id #uuid "95b4a85b-7861-5ab1-b592-7b9c8569104e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 \\\\ \\frac{2\\sqrt{2}}{3} \\\\ -\\frac{\\sqrt{2}}{6} \\\\ \\frac{\\sqrt{2}}{6}\\end{aligned}]" :db/id #edb/ref 17592186423546} :answer-field/id #uuid "9bbd8ab4-1a40-599a-b247-4e701aa93341" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186423581}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6fe81e21-b32f-5653-9746-86ee81aa65aa" :question/math-academy-id "q-74146" :question/problem "Normalize the vector $x=[\\begin{aligned}0 \\\\ 4 \\\\ -1 \\\\ 1\\end{aligned}].$" :question/worked-solution "To normalize a vector $x,$ we have to divide the vector by its norm: $\\frac{x}{‖x‖}.$ Therefore, to normalize $x,$ we first calculate $‖x‖$ as follows:\n\n$$\n\\begin{aligned}‖x‖ & =\\sqrt{{x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2}+{x}_{4}^{2}} \\\\  & =\\sqrt{{0}^{2}+{4}^{2}+(-1)^{2}+{1}^{2}} \\\\  & =\\sqrt{0+16+1+1} \\\\  & =\\sqrt{18} \\\\  & =3\\sqrt{2}\\end{aligned}\n$$\n\nThen, we divide $x$ by its length:\n\n$$\n\\begin{aligned}\\frac{x}{‖x‖} & =\\frac{x}{3\\sqrt{2}} \\\\  & =\\frac{1}{3\\sqrt{2}}x \\\\  & =\\frac{1}{3\\sqrt{2}}[\\begin{aligned}0 \\\\ 4 \\\\ -1 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ \\frac{4}{3\\sqrt{2}} \\\\ \\frac{-1}{3\\sqrt{2}} \\\\ \\frac{1}{3\\sqrt{2}}\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ \\frac{2\\sqrt{2}}{3} \\\\ -\\frac{\\sqrt{2}}{6} \\\\ \\frac{\\sqrt{2}}{6}\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186423593 :knowledge-point/_questions [{:db/id #edb/ref 17592186133761 :knowledge-point/id #uuid "ae41d849-9def-540c-8985-8fbeec679991" :knowledge-point/title "Normalizing a Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "75b1fa49-49da-5f37-8dfa-465fb4af4967" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k=\\pm 2" :db/id #edb/ref 17592186423534} {:answer/id #uuid "86977b64-b6c8-5365-bf6e-5ff5b06feb84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k=\\pm 3" :db/id #edb/ref 17592186423541} {:answer/id #uuid "ac4581c9-0b61-577e-b7a9-aba7bac04110" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k=\\pm 4" :db/id #edb/ref 17592186423553} {:answer/id #uuid "e3efac19-7b5c-5684-8e8f-127af8b3a1dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k=\\pm \\sqrt{3}" :db/id #edb/ref 17592186423565} {:answer/id #uuid "eb9e68d1-fabf-5d62-b704-62d032286855" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k=\\pm \\sqrt{2}" :db/id #edb/ref 17592186423566}] :answer-field/correct {:answer/id #uuid "eb9e68d1-fabf-5d62-b704-62d032286855" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k=\\pm \\sqrt{2}" :db/id #edb/ref 17592186423566} :answer-field/id #uuid "f00c50c9-3345-5470-8ccb-bce50ca0fdd4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186423586}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9c46599f-15c6-531f-94db-06b03ec04f84" :question/math-academy-id "q-74149" :question/problem "Find $k$, if $u=[\\begin{aligned}-\\frac{1}{2} \\\\ \\frac{1}{4} \\\\ \\frac{3}{4} \\\\ \\frac{k}{4}\\end{aligned}]$ is a unit vector." :question/worked-solution "First, we calculate the norm of the vector $u$ in terms of $k:$\n\n$$\n\\begin{aligned}‖u‖ & =\\sqrt{{u}_{1}^{2}+{u}_{2}^{2}+{u}_{3}^{2}+{u}_{4}^{2}} \\\\  & =\\sqrt{{(-\\frac{1}{2})}^{2}+{(\\frac{1}{4})}^{2}+{(\\frac{3}{4})}^{2}+{(\\frac{k}{4})}^{2}} \\\\  & =\\sqrt{\\frac{1}{4}+\\frac{1}{16}+\\frac{9}{16}+\\frac{{k}^{2}}{16}} \\\\  & =\\sqrt{\\frac{14+{k}^{2}}{16}}\\end{aligned}\n$$\n\nSubstituting the above into the given equation  $‖u‖=1,$ we obtain an equation that we can solve for $k:$\n\n$$\n\\begin{aligned}\\sqrt{\\frac{14+{k}^{2}}{16}} & =1 \\\\ \\sqrt{14+{k}^{2}} & =4 \\\\ {(\\sqrt{14+{k}^{2}})}^{2} & ={4}^{2} \\\\ 14+{k}^{2} & =16 \\\\ {k}^{2} & =2 \\\\ k & =\\pm \\sqrt{2}\\end{aligned}\n$$"}]}
