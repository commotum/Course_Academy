orname{arg}⁡{min}_{x\\in S}f(x)=\\{-1,2\\}.\n$$"] ["question-c31456f2-6f7b-5c43-b2d6-d63a185e088a" :question/difficulty :question.difficulty/easy] ["answer-field-dea23e0a-f02d-57be-9af6-ef1ec5ff726d" :answer-field/id #uuid "dea23e0a-f02d-57be-9af6-ef1ec5ff726d"] ["answer-8f41a682-ab0b-5931-8d0f-f6dc1f0b19d6" :answer/id #uuid "8f41a682-ab0b-5931-8d0f-f6dc1f0b19d6"] ["answer-8f41a682-ab0b-5931-8d0f-f6dc1f0b19d6" :answer/type :answer.type/math] ["answer-8f41a682-ab0b-5931-8d0f-f6dc1f0b19d6" :answer/value "-1"] ["answer-acc90f90-20a4-5ab7-9cc7-f5256d6b72a0" :answer/id #uuid "acc90f90-20a4-5ab7-9cc7-f5256d6b72a0"] ["answer-acc90f90-20a4-5ab7-9cc7-f5256d6b72a0" :answer/type :answer.type/math] ["answer-acc90f90-20a4-5ab7-9cc7-f5256d6b72a0" :answer/value "1"] ["answer-5867a175-6ed7-56f3-a3c6-f5ec652ea39c" :answer/id #uuid "5867a175-6ed7-56f3-a3c6-f5ec652ea39c"] ["answer-5867a175-6ed7-56f3-a3c6-f5ec652ea39c" :answer/type :answer.type/math] ["answer-5867a175-6ed7-56f3-a3c6-f5ec652ea39c" :answer/value "5"] ["answer-24e4e581-cd1a-580b-b032-c609777f53f9" :answer/id #uuid "24e4e581-cd1a-580b-b032-c609777f53f9"] ["answer-24e4e581-cd1a-580b-b032-c609777f53f9" :answer/type :answer.type/math] ["answer-24e4e581-cd1a-580b-b032-c609777f53f9" :answer/value "8"] ["answer-field-dea23e0a-f02d-57be-9af6-ef1ec5ff726d" :answer-field/key "field-1"] ["answer-field-dea23e0a-f02d-57be-9af6-ef1ec5ff726d" :answer-field/type :answer-field.type/select] ["answer-field-dea23e0a-f02d-57be-9af6-ef1ec5ff726d" :answer-field/correct "answer-acc90f90-20a4-5ab7-9cc7-f5256d6b72a0"] ["answer-field-dea23e0a-f02d-57be-9af6-ef1ec5ff726d" :answer-field/choices "answer-8f41a682-ab0b-5931-8d0f-f6dc1f0b19d6"] ["answer-field-dea23e0a-f02d-57be-9af6-ef1ec5ff726d" :answer-field/choices "answer-acc90f90-20a4-5ab7-9cc7-f5256d6b72a0"] ["answer-field-dea23e0a-f02d-57be-9af6-ef1ec5ff726d" :answer-field/choices "answer-5867a175-6ed7-56f3-a3c6-f5ec652ea39c"] ["answer-field-dea23e0a-f02d-57be-9af6-ef1ec5ff726d" :answer-field/choi