ax}_{x\\in S}f(x) & =10 \\\\ \\operatorname{arg}⁡{max}_{x\\in S}f(x) & =2 \\\\ {min}_{x\\in S}f(x) & =-8 \\\\ \\operatorname{arg}⁡{min}_{x\\in S}f(x) & =4\\end{aligned}\n$$"] ["question-dae35b84-ab79-5551-9374-7336192ddee8" :question/difficulty :question.difficulty/easy] ["answer-field-8a466fba-def7-55ba-8f8f-e4d5b58d8d7b" :answer-field/id #uuid "8a466fba-def7-55ba-8f8f-e4d5b58d8d7b"] ["answer-a7788327-b0c0-54fc-85c0-8f6bfa719642" :answer/id #uuid "a7788327-b0c0-54fc-85c0-8f6bfa719642"] ["answer-a7788327-b0c0-54fc-85c0-8f6bfa719642" :answer/type :answer.type/math] ["answer-a7788327-b0c0-54fc-85c0-8f6bfa719642" :answer/value "10"] ["answer-field-8a466fba-def7-55ba-8f8f-e4d5b58d8d7b" :answer-field/key "field-1"] ["answer-field-8a466fba-def7-55ba-8f8f-e4d5b58d8d7b" :answer-field/type :answer-field.type/blank] ["answer-field-8a466fba-def7-55ba-8f8f-e4d5b58d8d7b" :answer-field/correct "answer-a7788327-b0c0-54fc-85c0-8f6bfa719642"] ["answer-field-8a466fba-def7-55ba-8f8f-e4d5b58d8d7b" :answer-field/choices "answer-a7788327-b0c0-54fc-85c0-8f6bfa719642"] ["answer-field-bbb2ab49-40eb-5b48-800d-507bb695f316" :answer-field/id #uuid "bbb2ab49-40eb-5b48-800d-507bb695f316"] ["answer-f0cae313-5ca8-5968-99a4-e1333c64e33e" :answer/id #uuid "f0cae313-5ca8-5968-99a4-e1333c64e33e"] ["answer-f0cae313-5ca8-5968-99a4-e1333c64e33e" :answer/type :answer.type/math] ["answer-f0cae313-5ca8-5968-99a4-e1333c64e33e" :answer/value "2"] ["answer-field-bbb2ab49-40eb-5b48-800d-507bb695f316" :answer-field/key "field-2"] ["answer-field-bbb2ab49-40eb-5b48-800d-507bb695f316" :answer-field/type :answer-field.type/blank] ["answer-field-bbb2ab49-40eb-5b48-800d-507bb695f316" :answer-field/correct "answer-f0cae313-5ca8-5968-99a4-e1333c64e33e"] ["answer-field-bbb2ab49-40eb-5b48-800d-507bb695f316" :answer-field/choices "answer-f0cae313-5ca8-5968-99a4-e1333c64e33e"] ["answer-field-a8adcb23-4793-5db2-b42b-3165ad50dc81" :answer-field/id #uuid "a8adcb23-4793-5db2-b42b-3165ad50dc81"] ["answer-73cb411d-4a6d-5b99-97f0-