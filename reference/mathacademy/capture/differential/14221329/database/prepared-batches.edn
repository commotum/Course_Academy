4-917e-23c1fbc33ba5" :answer-field/choices "answer-4be13631-d183-51ce-9cf9-635adf6fa5e3"] ["answer-field-cf2478ca-341b-5684-917e-23c1fbc33ba5" :answer-field/choices "answer-2816e8f2-85f0-5744-ac9e-bd675a29c2f5"] ["answer-field-cf2478ca-341b-5684-917e-23c1fbc33ba5" :answer-field/choices "answer-7842d38e-55bb-5a67-9ff8-b04dea78e691"] ["answer-field-cf2478ca-341b-5684-917e-23c1fbc33ba5" :answer-field/choices "answer-aa82b804-ae48-5345-8c7f-1e5fb38d03cf"] ["question-53479689-99f5-53fc-9bbf-170474b20c8c" :question/answer-fields "answer-field-98216f74-dc70-5d6d-8b65-3533eb892def"] ["question-53479689-99f5-53fc-9bbf-170474b20c8c" :question/answer-fields "answer-field-cf2478ca-341b-5684-917e-23c1fbc33ba5"] [17592186231451 :knowledge-point/questions "question-53479689-99f5-53fc-9bbf-170474b20c8c"] ["question-b99f27b6-bb0f-5afc-b357-d0b316cf7a24" :question/id #uuid "b99f27b6-bb0f-5afc-b357-d0b316cf7a24"] ["question-b99f27b6-bb0f-5afc-b357-d0b316cf7a24" :question/math-academy-id "q-355392"] ["question-b99f27b6-bb0f-5afc-b357-d0b316cf7a24" :question/problem "Which of the following best describes $\\operatorname{arg}⁡{max}_{\\theta \\in [0,2\\pi ]}f(\\theta )?$"] ["question-b99f27b6-bb0f-5afc-b357-d0b316cf7a24" :question/worked-solution "By definition, $\\operatorname{arg}⁡max$ returns an input value where the function achieves its maximum value. \n\nTherefore, $\\operatorname{arg}⁡{max}_{\\theta \\in [0,2\\pi ]}f(\\theta )$ is the value of $\\theta $ in $[0,2\\pi ]$ where $f(\\theta )$ is largest."] ["question-b99f27b6-bb0f-5afc-b357-d0b316cf7a24" :question/difficulty :question.difficulty/easy] ["answer-field-0834d9ef-3a48-5a32-a4fd-6b4392e97da5" :answer-field/id #uuid "0834d9ef-3a48-5a32-a4fd-6b4392e97da5"] ["answer-97bf954f-753a-55e5-a496-69bf543f8ca2" :answer/id #uuid "97bf954f-753a-55e5-a496-69bf543f8ca2"] ["answer-97bf954f-753a-55e5-a496-69bf543f8ca2" :answer/type :answer.type/text] ["answer-97bf954f-753a-55e5-a496-69bf543f8ca2" :answer/value "The average value of $f(\\theta )$ on $[0,2\\pi ].$"] ["answer-36b15808-5d17-588e-96b0-4bafa73d3a87" :answer/id #uuid "36b15808-5d17-588e-96b0-4bafa73d3a87"] ["answer-36b15808-5d17-588e-96b0-4bafa73d3a87" :answer/type :answer.type/text] ["answer-36b15808-5d17-588e-96b0-4bafa73d3a87" :answer/value "The largest value of $f(\\theta )$ on $[0,2\\pi ].$"] ["answer-03cc3ad8-5803-5027-8ae1-b9ab3dc36bf0" :answer/id #uuid "03cc3ad8-5803-5027-8ae1-b9ab3dc36bf0"] ["answer-03cc3ad8-5803-5027-8ae1-b9ab3dc36bf0" :answer/type :answer.type/text] ["answer-03cc3ad8-5803-5027-8ae1-b9ab3dc36bf0" :answer/value "The smallest value of $f(\\theta )$ on $[0,2\\pi ].$"] ["answer-f76c7c1f-2951-5978-a2f9-0a0b65916cfd" :answer/id #uuid "f76c7c1f-2951-5978-a2f9-0a0b65916cfd"] ["answer-f76c7c1f-2951-5978-a2f9-0a0b65916cfd" :answer/type :answer.type/text] ["answer-f76c7c1f-2951-5978-a2f9-0a0b65916cfd" :answer/value "The value of $\\theta $ in $[0,2\\pi ]$ where $f(\\theta )$ is largest."] ["answer-109bb7e4-12e9-5e6e-a2c9-4a3ea3215fc9" :answer/id #uuid "109bb7e4-12e9-5e6e-a2c9-4a3ea3215fc9"] ["answer-109bb7e4-12e9-5e6e-a2c9-4a3ea3215fc9" :answer/type :answer.type/text] ["answer-109bb7e4-12e9-5e6e-a2c9-4a3ea3215fc9" :answer/value "The value of $\\theta $ in $[0,2\\pi ]$ where $f(\\theta )$ is smallest."] ["answer-field-0834d9ef-3a48-5a32-a4fd-6b4392e97da5" :answer-field/key "selection"] ["answer-field-0834d9ef-3a48-5a32-a4fd-6b4392e97da5" :answer-field/type :answer-field.type/radio] ["answer-field-0834d9ef-3a48-5a32-a4fd-6b4392e97da5" :answer-field/correct "answer-f76c7c1f-2951-5978-a2f9-0a0b65916cfd"] ["answer-field-0834d9ef-3a48-5a32-a4fd-6b4392e97da5" :answer-field/choices "answer-97bf954f-753a-55e5-a496-69bf543f8ca2"] ["answer-field-0834d9ef-3a48-5a32-a4fd-6b4392e97da5" :answer-field/choices "answer-36b15808-5d17-588e-96b0-4bafa73d3a87"] ["answer-field-0834d9ef-3a48-5a32-a4fd-6b4392e97da5" :answer-field/choices "answer-03cc3ad8-5803-5027-8ae1-b9ab3dc36bf0"] ["answer-field-0834d9ef-3a48-5a32-a4fd-6b4392e97da5" :answer-field/choices "answer-f76c7c1f-2951-5978-a2f9-0a0b65916cfd"] ["answer-field-0834d9ef-3a48-5a32-a4fd-6b4392e97da5" :answer-field/choices "answer-109bb7e4-12e9-5e6e-a2c9-4a3ea3215fc9"] ["question-b99f27b6-bb0f-5afc-b357-d0b316cf7a24" :question/answer-fields "answer-field-0834d9ef-3a48-5a32-a4fd-6b4392e97da5"] [17592186231452 :knowledge-point/questions "question-b99f27b6-bb0f-5afc-b357-d0b316cf7a24"] ["question-f7168caf-99d8-56ba-8b1b-f286cb0133ec" :question/id #uuid "f7168caf-99d8-56ba-8b1b-f286cb0133ec"] ["question-f7168caf-99d8-56ba-8b1b-f286cb0133ec" :question/math-academy-id "q-355394"] ["question-f7168caf-99d8-56ba-8b1b-f286cb0133ec" :question/problem "Let $g(y)$ be a profit for product $y,$ where $y\\in \\{3,7,11,15\\}.$ We want to write the best product $\\overset{^}{y}$ as \"the value of $y$ that makes $g(y)$ as large as possible.\"\n\nWhich of the following correctly defines $\\overset{^}{y}?$"] ["question-f7168caf-99d8-56ba-8b1b-f286cb0133ec" :question/worked-solution "We want $\\overset{^}{y}$ to be an *input value* $y$ where the profit $g(y)$ is as large as possible. \n\nThat is exactly what $\\operatorname{arg}⁡max$ returns.\nTherefore,\n\n$$\n\\overset{^}{y}=\\operatorname{arg}⁡{max}_{y\\in \\{3,7,11,15\\}}g(y).\n$$"] ["question-f7168caf-99d8-56ba-8b1b-f286cb0133ec" :question/difficulty :question.difficulty/moderate] ["answer-field-bba509ec-a193-5a29-9ee6-8dfb74ce1d8f" :answer-field/id #uuid "bba509ec-a193-5a29-9ee6-8dfb74ce1d8f"] ["answer-cd1c8e6c-c2cc-567c-b331-4c30a5590e84" :answer/id #uuid "cd1c8e6c-c2cc-567c-b331-4c30a5590e84"] ["answer-cd1c8e6c-c2cc-567c-b331-4c30a5590e84" :answer/type :answer.type/math] ["answer-cd1c8e6c-c2cc-567c-b331-4c30a5590e84" :answer/value "\\overset{^}{y}=\\operatorname{arg}⁡{max}_{y\\in \\{3,7,11,15\\}}g(y)"] ["answer-aefadc2d-31ef-5613-926b-0f541f57d23f" :answer/id #uuid "aefadc2d-31ef-5613-926b-0f541f57d23f"] ["answer-aefadc2d-31ef-5613-926b-0f541f57d23f" :answer/type :answer.type/math] ["answer-aefadc2d-31ef-5613-926b-0f541f