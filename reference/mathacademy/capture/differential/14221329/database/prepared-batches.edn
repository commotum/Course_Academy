ces "answer-766090e8-7730-5324-a88a-78fc608aa33f"] ["question-6b85f086-3ff0-5996-862a-13fba81da102" :question/answer-fields "answer-field-eaa4f776-3456-50ae-b247-8f35eba24311"] ["question-6b85f086-3ff0-5996-862a-13fba81da102" :question/answer-fields "answer-field-0694b919-f666-5cf0-8eef-96291747b094"] [17592186231451 :knowledge-point/questions "question-6b85f086-3ff0-5996-862a-13fba81da102"] [17592186231735 :question/problem "Let $T=\\{-2,-1,0,1\\}$ and suppose\n\n$$\ng(-2)=3,\\,g(-1)=-2,\\,g(0)=0,\\,g(1)=-2.\n$$\n\nCompute ${min}_{x\\in T}g(x)$ and $\\operatorname{arg}⁡{min}_{x\\in T}g(x).$\n\n$\\,$\n${min}_{x\\in T}g(x)=$ {{field-1}}\n\n$\\,$\n$\\operatorname{arg}⁡{min}_{x\\in T}g(x)=$ {{field-2}}"] [17592186231735 :question/worked-solution "Recall that \n\n- ${min}_{x\\in T}f(x)$ is the smallest output value, while\n\n- $\\operatorname{arg}⁡{min}_{x\\in T}f(x)$ is an input in $T$ where that smallest output occurs.\n\nThe output values are $3,$ $-2,$ $0,$ and $-2,$ so the minimum output value is $-2.$ This minimum occurs at both $x=-1$ and $x=1.$ Therefore,\n\n$$\n{min}_{x\\in T}g(x)=-2\\,\\text{and}\\,\\operatorname{arg}⁡{min}_{x\\in T}g(x)=\\{-1,1\\}.\n$$"] [17592186231735 :question/difficulty :question.difficulty/easy] [17592186231003 :answer-field/correct 17592186231007] ["answer-fb3b48b6-7d47-5ae4-9b29-ebd354c5d29a" :answer/id #uuid "fb3b48b6-7d47-5ae4-9b29-ebd354c5d29a"] ["answer-fb3b48b6-7d47-5ae4-9b29-ebd354c5d29a" :answer/type :answer.type/math] ["answer-fb3b48b6-7d47-5ae4-9b29-ebd354c5d29a" :answer/value "\\{-1,1\\}"] ["answer-c323b06b-7a3b-51b1-b940-61dbb9aca334" :answer/id #uuid "c323b06b-7a3b-51b1-b940-61dbb9aca334"] ["answer-c323b06b-7a3b-51b1-b940-61dbb9aca334" :answer/type :answer.type/math] ["answer-c323b06b-7a3b-51b1-b940-61dbb9aca334" :answer/value "\\{-1\\}"] ["answer-71a394aa-8e3b-524c-8e76-c656e0db6806" :answer/id #uuid "71a394aa-8e3b-524c-8e76-c656e0db6806"] ["answer-71a394aa-8e3b-524c-8e76-c656e0db6806" :answer/type :answer.type/math] ["answer-71a394aa-8e3b-524c-8e76-c656e0db6806" :answer/value "\\{-2,0\\}"] ["answer-890abc9b-4b54-5ee2-9413-30a0aa7c2a70" :answer/id #uuid "890abc9b-4b54-5ee2-9413-30a0aa7c2a70"] ["answer-890abc9b-4b54-5ee2-9413-30a0aa7c2a70" :answer/type :answer.type/math] ["answer-890abc9b-4b54-5ee2-9413-30a0aa7c2a70" :answer/value "\\{-2\\}"] ["answer-31464fc0-268d-513c-a882-b9f9b02a994e" :answer/id #uuid "31464fc0-268d-513c-a882-b9f9b02a994e"] ["answer-31464fc0-268d-513c-a882-b9f9b02a994e" :answer/type :answer.type/math] ["answer-31464fc0-268d-513c-a882-b9f9b02a994e" :answer/value "\\{1\\}"] [17592186230997 :answer-field/correct "answer-fb3b48b6-7d47-5ae4-9b29-ebd354c5d29a"] [17592186230997 :answer-field/choices "answer-fb3b48b6-7d47-5ae4-9b29-ebd354c5d29a"] [17592186230997 :answer-field/choices "answer-c323b06b-7a3b-51b1-b940-61dbb9aca334"] [17592186230997 :answer-field/choices "answer-71a394aa-8e3b-524c-8e76-c656e0db6806"] [17592186230997 :answer-field/choices "answer-890abc9b-4b54-5ee2-9413-30a0aa7c2a70"] [17592186230997 :answer-field/choices "answer-31464fc0-268d-513c-a882-b9f9b02a994e"] ["question-53479689-99f5-53fc-9bbf-170474b20c8c" :question/id #uuid "53479689-99f5-53fc-9bbf-170474b20c8c"] ["question-53479689-99f5-53fc-9bbf-170474b20c8c" :question/math-academy-id "q-355387"] ["question-53479689-99f5-53fc-9bbf-170474b20c8c" :question/problem "Let $B=\\{-4,-2,0,3\\}$ and suppose\n\n$$\nk(-4)=-5,\\,k(-2)=-8,\\,k(0)=-2,\\,k(3)=-8.\n$$\n\nCompute ${min}_{x\\in B}k(x)$ and $\\operatorname{arg}⁡{min}_{x\\in B}k(x).$\n\n$\\,$\n${min}_{x\\in B}k(x)=$ {{field-1}}\n\n$\\,$\n$\\operatorname{arg}⁡{min}_{x\\in B}k(x)=$ {{field-2}}"] ["question-53479689-99f5-53fc-9bbf-170474b20c8c" :question/worked-solution "Recall that \n\n- ${min}_{x\\in B}k(x)$ is the smallest output value, while\n\n- $\\operatorname{arg}⁡{min}_{x\\in B}k(x)$ is an input in $B$ where that smallest output occurs.\n\nThe output values are $-5,$ $-8,$ $-2,$ and $-8,$ so the minimum output value is $-8.$ This minimum occurs at both $x=-2$ and $x=3.$ Therefore,\n\n$$\n{min}_{x\\in B}k(x)=-8\\,\\text{and}\\,\\operatorname{arg}⁡{min}_{x\\in B}k(x)=\\{-2,3\\}.\n$$"] ["question-53479689-99f5-53fc-9bbf-170474b20c8c" :question/difficulty :question.difficulty/easy] ["answer-field-98216f74-dc70-5d6d-8b65-3533eb892def" :answer-field/id #uuid "98216f74-dc70-5d6d-8b65-3533eb892def"] ["answer-a057dbd2-121a-5b50-83ed-e137b18aa10c" :answer/id #uuid "a057dbd2-121a-5b50-83ed-e137b18aa10c"] ["answer-a057dbd2-121a-5b50-83ed-e137b18aa10c" :answer/type :answer.type/math] ["answer-a057dbd2-121a-5b50-83ed-e137b18aa10c" :answer/value "-2"] ["answer-16c83e94-ae98-529d-89d6-030b4ba65c27" :answer/id #uuid "16c83e94-ae98-529d-89d6-030b4ba65c27"] ["answer-16c83e94-ae98-529d-89d6-030b4ba65c27" :answer/type :answer.type/math] ["answer-16c83e94-ae98-529d-89d6-030b4ba65c27" :answer/value "-4"] ["answer-fec2c26d-c48d-58d2-b10d-e3f202e6f4c6" :answer/id #uuid "fec2c26d-c48d-58d2-b10d-e3f202e6f4c6"] ["answer-fec2c26d-c48d-58d2-b10d-e3f202e6f4c6" :answer/type :answer.type/math] ["answer-fec2c26d-c48d-58d2-b10d-e3f202e6f4c6" :answer/value "-5"] ["answer-32728266-17ee-5834-98d0-7081fcf6278e" :answer/id #uuid "32728266-17ee-5834-98d0-7081fcf6278e"] ["answer-32728266-17ee-5834-98d0-7081fcf6278e" :answer/type :answer.type/math] ["answer-32728266-17ee-5834-98d0-7081fcf6278e" :answer/value "-8"] ["answer-field-98216f74-dc70-5d6d-8b65-3533eb892def" :answer-field/key "field-1"] ["answer-field-98216f74-dc70-5d6d-8b65-3533eb892def" :answer-field/type :answer-field.type/select] ["answer-field-98216f74-dc70-5d6d-8b65-3533eb892def" :answer-field/correct "answer-32728266-17ee-5834-98d0-7081fcf6278e"] ["answer-field-98216f74-dc70-5d6d-8b65-3533eb892def" :answer-field/choices "answer-a057dbd2-121a-5b50-83ed-e137b18aa10c"] ["answer-field-98216f74-dc70-5d6d-8b65-3533eb892def" :answer-field/choices "answer-16c83e94-ae98-529d-89d6-030b4ba65c27"] ["answer-field-98216f74-dc70-5d6d-8b65-3533eb892def" :answer-field/choices "answer-fec2c26d-c48d-58