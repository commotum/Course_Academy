#{[{:db/id #edb/ref 17592186250388 :knowledge-point/_questions [{:db/id #edb/ref 17592186087833 :knowledge-point/id #uuid "57e19ee3-db9a-58d7-8ca3-4e8801aee656" :knowledge-point/title "Determining the Equation of a Tall Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01a0e5e1-b1da-5dc9-b41e-3bb393e24954" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-4)^{2}}{36}+\\frac{{y}^{2}}{4}=1" :db/id #edb/ref 17592186247432} {:answer/id #uuid "35585ca0-a98f-5baf-94fe-509a8b5d8a32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{4}+\\frac{(y-4)^{2}}{36}=1" :db/id #edb/ref 17592186247903} {:answer/id #uuid "7dc151f9-95d7-5299-ad1e-76f145c3c6eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x+4)^{2}}{4}+\\frac{{y}^{2}}{12}=1" :db/id #edb/ref 17592186248525} {:answer/id #uuid "82cb959f-6960-532f-bba7-b7925ec3c118" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x+4)^{2}}{2}+\\frac{{y}^{2}}{6}=1" :db/id #edb/ref 17592186248581} {:answer/id #uuid "be580972-e9e1-565a-a446-3b2e2bb49a81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x+4)^{2}}{4}+\\frac{{y}^{2}}{36}=1" :db/id #edb/ref 17592186249116}] :answer-field/correct {:answer/id #uuid "be580972-e9e1-565a-a446-3b2e2bb49a81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x+4)^{2}}{4}+\\frac{{y}^{2}}{36}=1" :db/id #edb/ref 17592186249116} :answer-field/id #uuid "164d9e4d-3f7a-5463-987e-751c5fbca993" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249708}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e17dda64-b9d6-527b-acc5-6bdc5ef17fe0" :question/math-academy-id "q-115297" :question/problem "![](images/10/1006eabe3321beb48df2cd936ff2252b77e8ded81f9c5b7aec4d143e43941088.png)\n\nWhat is the equation of the ellipse given above?" :question/worked-solution "Remember that the general equation of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the ellipse is centered at $(-4,0),$ the horizontal radius has length $a=2,$ and the vertical radius has length $b=6.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}} & =1 \\\\ \\frac{(x-(-4))^{2}}{{2}^{2}}+\\frac{(y-0)^{2}}{{6}^{2}} & =1 \\\\ \\frac{(x+4)^{2}}{4}+\\frac{{y}^{2}}{36} & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186416685 :knowledge-point/_questions [{:db/id #edb/ref 17592186087833 :knowledge-point/id #uuid "57e19ee3-db9a-58d7-8ca3-4e8801aee656" :knowledge-point/title "Determining the Equation of a Tall Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23962a06-bb97-5fbd-a080-34dac0fedadd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x+3)^{2}}{4}+\\frac{(y-4)^{2}}{25}" :db/id #edb/ref 17592186416678}] :answer-field/correct {:answer/id #uuid "23962a06-bb97-5fbd-a080-34dac0fedadd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x+3)^{2}}{4}+\\frac{(y-4)^{2}}{25}" :db/id #edb/ref 17592186416678} :answer-field/id #uuid "43d267b9-ec22-5b8b-a0c1-af357d98c1d6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186416683}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d94a5264-18c5-5679-b580-fde7816b3b57" :question/math-academy-id "q-278253" :question/problem "![](images/1a/1a8e0f0c766d2674dbf32feac760baea28418d65565fd6d64dccc6cf3eecd6bf.png)\n\nWhat is the equation of the ellipse given above?\n\n{{field-1}}$=1$" :question/worked-solution "Remember that the general equation of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the ellipse is centered at $(-3,4),$ the horizontal radius has length $a=2,$ and the vertical radius has length $b=5.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}} & =1 \\\\ \\frac{(x-(-3))^{2}}{{2}^{2}}+\\frac{(y-4)^{2}}{{5}^{2}} & =1 \\\\ \\frac{(x+3)^{2}}{4}+\\frac{(y-4)^{2}}{25} & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186372489 :knowledge-point/_questions [{:db/id #edb/ref 17592186087834 :knowledge-point/id #uuid "a5028940-be34-56b7-8947-6129252f06a7" :knowledge-point/title "Determining the Center and Lengths of the Major and Minor Axes Given the Equation of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32977988-9ddf-5f51-8216-474ed5b18590" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186372491}] :answer-field/correct {:answer/id #uuid "32977988-9ddf-5f51-8216-474ed5b18590" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186372491} :answer-field/id #uuid "f56c2aba-5529-57e1-a79a-70813d89b492" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186372490} {:answer-field/choices [{:answer/id #uuid "1123100d-4da4-58aa-b750-ca1b46eba376" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186372493}] :answer-field/correct {:answer/id #uuid "1123100d-4da4-58aa-b750-ca1b46eba376" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186372493} :answer-field/id #uuid "bd4abeb6-cc64-59bf-97b7-a7eab1dbd17f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186372492}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "51372c7c-b0b0-5674-a112-93ab7dec687c" :question/math-academy-id "q-278317" :question/problem "The center of the ellipse $\\frac{(x-4)^{2}}{4}+\\frac{(y+4)^{2}}{9}=1$ is located at the point$\\,($\n{{field-1}},\n{{field-2}}$).$" :question/worked-solution "Remember that the general equation of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nIn the given equation, we have $h=4$ and $k=-4,$ so the center is located at $(\\,4,-4\\,).$"}] [{:db/id #edb/ref 17592186416686 :knowledge-point/_questions [{:db/id #edb/ref 17592186087833 :knowledge-point/id #uuid "57e19ee3-db9a-58d7-8ca3-4e8801aee656" :knowledge-point/title "Determining the Equation of a Tall Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06b57d90-a9ee-54f9-840f-6dfdd3aab51c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x+1)^{2}}{2}+(y+1)^{2}=1" :db/id #edb/ref 17592186416677} {:answer/id #uuid "3c3d7e26-2073-5af5-a3f5-d42d26f20154" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-1)^{2}+\\frac{(y-1)^{2}}{4}=1" :db/id #edb/ref 17592186416679} {:answer/id #uuid "4376677f-9a7f-532f-b66b-ad4902b9c630" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-1)^{2}}{4}+(y-1)^{2}=1" :db/id #edb/ref 17592186416680} {:answer/id #uuid "b2919188-309d-5e3e-965d-f1e83d98bddc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+1)^{2}+\\frac{(y+1)^{2}}{2}=1" :db/id #edb/ref 17592186416681} {:answer/id #uuid "d9e0ee02-13c6-544f-b4b9-39031730f3ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+1)^{2}+\\frac{(y+1)^{2}}{4}=1" :db/id #edb/ref 17592186416682}] :answer-field/correct {:answer/id #uuid "d9e0ee02-13c6-544f-b4b9-39031730f3ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+1)^{2}+\\frac{(y+1)^{2}}{4}=1" :db/id #edb/ref 17592186416682} :answer-field/id #uuid "759f0728-d8d2-515a-b991-0560a3f812fb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186416684}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ee934c99-4f27-5203-a0f5-c13e99354b00" :question/math-academy-id "q-7630" :question/problem "![](images/e2/e2cabfed6c7008b47c3157cca4862d0c2a5b2a2b34e1bb35aeea963b1639af8c.png)\n\nWhat is the equation of the ellipse given above?" :question/worked-solution "Remember that the general equation of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the ellipse is centered at $(-1,-1),$ the horizontal radius has length $a=1,$ and the vertical radius has length $b=2.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}} & =1 \\\\ \\frac{(x-(-1))^{2}}{{1}^{2}}+\\frac{(y-(-1))^{2}}{{2}^{2}} & =1 \\\\ (x+1)^{2}+\\frac{(y+1)^{2}}{4} & =1.\\end{aligned}\n$$"}]}
