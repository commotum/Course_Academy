#{[{:db/id #edb/ref 17592186250388 :knowledge-point/_questions [{:db/id #edb/ref 17592186087833 :knowledge-point/id #uuid "57e19ee3-db9a-58d7-8ca3-4e8801aee656" :knowledge-point/title "Determining the Equation of a Tall Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01a0e5e1-b1da-5dc9-b41e-3bb393e24954" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-4)^{2}}{36}+\\frac{{y}^{2}}{4}=1" :db/id #edb/ref 17592186247432} {:answer/id #uuid "35585ca0-a98f-5baf-94fe-509a8b5d8a32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{4}+\\frac{(y-4)^{2}}{36}=1" :db/id #edb/ref 17592186247903} {:answer/id #uuid "7dc151f9-95d7-5299-ad1e-76f145c3c6eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x+4)^{2}}{4}+\\frac{{y}^{2}}{12}=1" :db/id #edb/ref 17592186248525} {:answer/id #uuid "82cb959f-6960-532f-bba7-b7925ec3c118" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x+4)^{2}}{2}+\\frac{{y}^{2}}{6}=1" :db/id #edb/ref 17592186248581} {:answer/id #uuid "be580972-e9e1-565a-a446-3b2e2bb49a81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x+4)^{2}}{4}+\\frac{{y}^{2}}{36}=1" :db/id #edb/ref 17592186249116}] :answer-field/correct {:answer/id #uuid "be580972-e9e1-565a-a446-3b2e2bb49a81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x+4)^{2}}{4}+\\frac{{y}^{2}}{36}=1" :db/id #edb/ref 17592186249116} :answer-field/id #uuid "164d9e4d-3f7a-5463-987e-751c5fbca993" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249708}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e17dda64-b9d6-527b-acc5-6bdc5ef17fe0" :question/math-academy-id "q-115297" :question/problem "![](images/10/1006eabe3321beb48df2cd936ff2252b77e8ded81f9c5b7aec4d143e43941088.png)\n\nWhat is the equation of the ellipse given above?" :question/worked-solution "Remember that the general equation of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the ellipse is centered at $(-4,0),$ the horizontal radius has length $a=2,$ and the vertical radius has length $b=6.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}} & =1 \\\\ \\frac{(x-(-4))^{2}}{{2}^{2}}+\\frac{(y-0)^{2}}{{6}^{2}} & =1 \\\\ \\frac{(x+4)^{2}}{4}+\\frac{{y}^{2}}{36} & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186372489 :knowledge-point/_questions [{:db/id #edb/ref 17592186087834 :knowledge-point/id #uuid "a5028940-be34-56b7-8947-6129252f06a7" :knowledge-point/title "Determining the Center and Lengths of the Major and Minor Axes Given the Equation of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32977988-9ddf-5f51-8216-474ed5b18590" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186372491}] :answer-field/correct {:answer/id #uuid "32977988-9ddf-5f51-8216-474ed5b18590" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186372491} :answer-field/id #uuid "f56c2aba-5529-57e1-a79a-70813d89b492" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186372490} {:answer-field/choices [{:answer/id #uuid "1123100d-4da4-58aa-b750-ca1b46eba376" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186372493}] :answer-field/correct {:answer/id #uuid "1123100d-4da4-58aa-b750-ca1b46eba376" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186372493} :answer-field/id #uuid "bd4abeb6-cc64-59bf-97b7-a7eab1dbd17f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186372492}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "51372c7c-b0b0-5674-a112-93ab7dec687c" :question/math-academy-id "q-278317" :question/problem "The center of the ellipse $\\frac{(x-4)^{2}}{4}+\\frac{(y+4)^{2}}{9}=1$ is located at the point$\\,($\n{{field-1}},\n{{field-2}}$).$" :question/worked-solution "Remember that the general equation of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nIn the given equation, we have $h=4$ and $k=-4,$ so the center is located at $(\\,4,-4\\,).$"}]}
