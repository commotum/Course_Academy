[{"source" ":org/Math-Academy" "forms" [[:db/retract 17592186146924 :answer-field/choices 17592186146928] [:db/retract 17592186146924 :answer-field/choices 17592186146925] [:db/retract 17592186146924 :answer-field/choices 17592186146927] {:db/id 17592186147425 :knowledge-point/questions ["question-0174198f-a0ad-5395-9af8-f36d4c14897b" "question-fad299b6-2750-5729-9622-52ccf21ff85a"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186147427 :knowledge-point/questions ["question-e8cdac5c-1e47-510f-8a9c-c4df54b69f10"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186147343 :question/problem "Given the two planes $4x-2y=0$ and $-2x+y+1=0$, which of the following statements are true?\n\nI. The cross product of the normal vectors of the planes is equal to $\\mathbf{0}.$\n\nII. The planes are parallel but not coincident.\n\nIII. The planes intersect on a straight line." :db/ensure [:question/validate]} {:db/id 17592186148195 :question/problem "Find a direction vector of the line that is given as the intersection of the following two planes:\n\n$$\n\\{\\begin{aligned}x+2y-5=0 \\\\ 2x-y+z+1=0\\end{aligned}\n$$" :question/worked-solution "First, we notice:\n\n- For the plane $x+2y-5=0,$ a normal vector to the plane is ${n}_{1}=⟨1,2,0⟩.$\n\n- For the plane $2x-y+z+1=0,$ a normal vector to the plane is ${n}_{2}=⟨2,-1,1⟩.$\n\nTo find a direction vector for the line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}v & ={n}_{1}\\times {n}_{2} \\\\  & =⟨1,2,0⟩\\times ⟨2,-1,1⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 1 & 2 & 0 \\\\ 2 & -1 & 1\\end{aligned}\\right| \\\\  & =2i-j-5k \\\\  & =⟨2,-1,-5⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186146924 :answer-field/correct 17592186146926 :answer-field/choices ["answer-251ddf2f-7d06-501e-bde5-438da0173d51" "answer-6bfb1a2f-76c3-5220-b5fb-9dadb44d9e5d" "answer-5c4bd33c-8bb2-56f3-a03d-83062a02bb60"] :db/ensure [:answer-field/validate]} {:db/id "answer-251ddf2f-7d06-501e-bde5-438da0173d51" :answer/id #uuid "251ddf2f-7d06-501e-bde5-438da0173d51" :answer/type :answer.type/math :answer/value "⟨1,2,-5⟩" :db/ensure [:answer/validate]} {:db/id "answer-6bfb1a2f-76c3-5220-b5fb-9dadb44d9e5d" :answer/id #uuid "6bfb1a2f-76c3-5220-b5fb-9dadb44d9e5d" :answer/type :answer.type/math :answer/value "⟨1,2,0⟩" :db/ensure [:answer/validate]} {:db/id "answer-5c4bd33c-8bb2-56f3-a03d-83062a02bb60" :answer/id #uuid "5c4bd33c-8bb2-56f3-a03d-83062a02bb60" :answer/type :answer.type/math :answer/value "⟨2,-1,1⟩" :db/ensure [:answer/validate]} {:db/id "question-0174198f-a0ad-5395-9af8-f36d4c14897b" :question/id #uuid "0174198f-a0ad-5395-9af8-f36d4c14897b" :question/math-academy-id "q-71392" :question/problem "The intersection of the planes $-x+z-1=0$ and $y+z+5=0$ is given by the line\n\n$$\nr(t)=⟨{a}_{1},{a}_{2},0⟩+tb,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nCalculate ${a}_{1}+{a}_{2},$ and find a possible direction vector $b.$" :question/worked-solution "We're given that there exists a point on the line where $z=0.$ Substituting this to the first equation gives\n\n$$\n-x+0-1=0\\,⟹\\,x=-1,\n$$\n\nand substituting $z=0$ into the second equation gives\n\n$$\ny+0+5=0\\,⟹\\,y=-5.\n$$\n\nTherefore, $a=⟨-1,-5,0⟩$ is a position vector of a point on the line.\n\nNext, we notice:\n\n- For the plane $-x+z-1=0,$ a normal vector to the plane is ${n}_{1}=⟨-1,0,1⟩.$\n\n- For the plane $y+z+5=0,$ a normal vector to the plane is ${n}_{2}=⟨0,1,1⟩.$\n\nTo find a direction vector for the line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}b & ={n}_{1}\\times {n}_{2} \\\\  & =⟨-1,0,1⟩\\times ⟨0,1,1⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ -1 & 0 & 1 \\\\ 0 & 1 & 1\\end{aligned}\\right| \\\\  & =-i+j-k \\\\  & =⟨-1,1,-1⟩\\end{aligned}\n$$\n\nThus, the equation of the line is:\n\n$$\n\\begin{aligned}r(t) & =a+tb \\\\ r(t) & =⟨-1,-5,0⟩+t⟨-1,1,-1⟩\\end{aligned}\n$$\n\nFinally then, ${a}_{1}+{a}_{2}=-1+(-5)=-6,$ and $b=⟨-1,1,-1⟩.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b9c0353c-be95-5a9c-955e-2c015a02fd36"] :db/ensure [:question/validate]} {:db/id "answer-field-b9c0353c-be95-5a9c-955e-2c015a02fd36" :answer-field/id #uuid "b9c0353c-be95-5a9c-955e-2c015a02fd36" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-82e54d6b-a318-5bff-8d8f-60506bb19284" :answer-field/choices ["answer-22825761-3cc9-54a0-9fb4-b992332a08ec" "answer-f182158c-1a39-52d9-93a0-587908c41e2d" "answer-82e54d6b-a318-5bff-8d8f-60506bb19284" "answer-bbe216cb-a5f0-5c32-89c9-5b3529ecb0d0" "answer-8836d71d-2734-54f0-91d8-699ef75e1c78"] :db/ensure [:answer-field/validate]} {:db/id "answer-22825761-3cc9-54a0-9fb4-b992332a08ec" :answer/id #uuid "22825761-3cc9-54a0-9fb4-b992332a08ec" :answer/type :answer.type/math :answer/value "{a}_{1}+{a}_{2}=-2,\\,b=⟨-1,-1,-1⟩" :db/ensure [:answer/validate]} {:db/id "answer-f182158c-1a39-52d9-93a0-587908c41e2d" :answer/id #uuid "f182158c-1a39-52d9-93a0-587908c41e2d" :answer/type :answer.type/math :answer/value "{a}_{1}+{a}_{2}=-4,\\,b=⟨1,1,-1⟩" :db/ensure [:answer/validate]} {:db/id "answer-82e54d6b-a318-5bff-8d8f-60506bb19284" :answer/id #uuid "82e54d6b-a318-5bff-8d8f-60506bb19284" :answer/type :answer.type/math :answer/value "{a}_{1}+{a}_{2}=-6,\\,b=⟨-1,1,-1⟩" :db/ensure [:answer/validate]} {:db/id "answer-bbe216cb-a5f0-5c32-89c9-5b3529ecb0d0" :answer/id #uuid "bbe216cb-a5f0-5c32-89c9-5b3529ecb0d0" :answer/type :answer.type/math :answer/value "{a}_{1}+{a}_{2}=2,\\,b=⟨-1,1,1⟩" :db/ensure [:answer/validate]} {:db/id "answer-8836d71d-2734-54f0-91d8-699ef75e1c78" :answer/id #uuid "8836d71d-2734-54f0-91d8-699ef75e1c78" :answer/type :answer.type/math :answer/value "{a}_{1}+{a}_{2}=6,\\,b=⟨1,1,-1⟩" :db/ensure [:answer/validate]} {:db/id "question-fad299b6-2750-5729-9622-52ccf21ff85a" :question/id #uuid "fad299b6-2750-5729-9622-52ccf21ff85a" :question/math-academy-id "q-71414" :question/problem "The intersection of the planes $x+2y+2z=0$ and $4x-2y+4z+8=0$ is given by the line\n\n$$\nr(t)=⟨{a}_{1},0,{a}_{3}⟩+tb,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nCalculate ${a}_{1}+{a}_{3},$ and find a possible direction vector $b.$" :question/worked-solution "We're given that there exists a point on the line where $y=0.$ Substituting this into the first equation gives \n\n$$\nx+2(0)+2z=0\\,⟹\\,x=-2z,\n$$\n\nand substituting $y=0$ and $x=-2z$ into the second equation gives\n\n$$\n\\begin{aligned}4x-2y+4z+8 & =0 \\\\ 4(-2z)-2(0)+4z+8 & =0 \\\\ -4z & =-8 \\\\ z & =2.\\end{aligned}\n$$\n\nTherefore, $x=-2z=-4$ and $a=⟨-4,0,2⟩$ is a position vector of a point on the line.\n\nNext, we notice:\n\n- For the plane $x+2y+2z=0,$ a normal vector to the plane is ${n}_{1}=⟨1,2,2⟩.$\n\n- For the plane $4x-2y+4z+8=0,$ a normal vector to the plane is ${n}_{2}=⟨4,-2,4⟩.$\n\nTo find a direction vector for the line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}{n}_{1}\\times {n}_{2} & =⟨1,2,2⟩\\times ⟨4,-2,4⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 1 & 2 & 2 \\\\ 4 & -2 & 4\\end{aligned}\\right| \\\\  & =12i+4j-10k \\\\  & =⟨12,4,-10⟩\\end{aligned}\n$$\n\nWe can pick any vector that is parallel to ${n}_{1}\\times {n}_{2}$ as a direction vector of the line. So, let \n\n$$\nb=\\frac{1}{2}({n}_{1}\\times {n}_{2})=⟨6,2,-5⟩.\n$$\n\nThe equation of the line is:\n\n$$\n\\begin{aligned}r(t) & =a+tb \\\\ r(t) & =⟨-4,0,2⟩+t⟨6,2,-5⟩\\end{aligned}\n$$\n\nFinally then, ${a}_{1}+{a}_{3}=-4+2=-2,$ and $b=⟨6,2,-5⟩.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-55c226f4-65ae-55eb-8831-38644f8ba978"] :db/ensure [:question/validate]} {:db/id "answer-field-55c226f4-65ae-55eb-8831-38644f8ba978" :answer-field/id #uuid "55c226f4-65ae-55eb-8831-38644f8ba978" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f462a311-ea89-555c-9281-1e9601a16c66" :answer-field/choices ["answer-908a5ab3-8788-5615-82bc-44ddb7d0ef8d" "answer-f462a311-ea89-555c-9281-1e9601a16c66" "answer-a898a62f-1ba9-595b-99f1-d28e38c134b3" "answer-3a7df74d-f1a4-5ac2-993c-3eae86fd0451" "answer-f66ecaf3-9ca2-57cf-a1ac-6666ad1e34d8"] :db/ensure [:answer-field/validate]} {:db/id "answer-908a5ab3-8788-5615-82bc-44ddb7d0ef8d" :answer/id #uuid "908a5ab3-8788-5615-82bc-44ddb7d0ef8d" :answer/type :answer.type/math :answer/value "{a}_{1}+{a}_{3}=-1,\\,b=⟨6,4,5⟩" :db/ensure [:answer/validate]} {:db/id "answer-f462a311-ea89-555c-9281-1e9601a16c66" :answer/id #uuid "f462a311-ea89-555c-9281-1e9601a16c66" :answer/type :answer.type/math :answer/value "{a}_{1}+{a}_{3}=-2,\\,b=⟨6,2,-5⟩" :db/ensure [:answer/validate]} {:db/id "answer-a898a62f-1ba9-595b-99f1-d28e38c134b3" :answer/id #uuid "a898a62f-1ba9-595b-99f1-d28e38c134b3" :answer/type :answer.type/math :answer/value "{a}_{1}+{a}_{3}=-4,\\,b=⟨6,2,5⟩" :db/ensure [:answer/validate]} {:db/id "answer-3a7df74d-f1a4-5ac2-993c-3eae86fd0451" :answer/id #uuid "3a7df74d-f1a4-5ac2-993c-3eae86fd0451" :answer/type :answer.type/math :answer/value "{a}_{1}+{a}_{3}=1,\\,b=⟨6,2,5⟩" :db/ensure [:answer/validate]} {:db/id "answer-f66ecaf3-9ca2-57cf-a1ac-6666ad1e34d8" :answer/id #uuid "f66ecaf3-9ca2-57cf-a1ac-6666ad1e34d8" :answer/type :answer.type/math :answer/value "{a}_{1}+{a}_{3}=2,\\,b=⟨6,-2,-5⟩" :db/ensure [:answer/validate]} {:db/id "question-e8cdac5c-1e47-510f-8a9c-c4df54b69f10" :question/id #uuid "e8cdac5c-1e47-510f-8a9c-c4df54b69f10" :question/math-academy-id "q-71467" :question/problem "Given the two planes $3x-6y+1=0$ and $-x+2y=0$, which of the following statements are true?\n\nI. The cross product of the normal vectors of the planes is equal to $0.$\n\nII. The planes are parallel but not coincident.\n\nIII. The planes intersect in a straight line." :question/worked-solution "First, notice that:  \n\n- For the plane $3x-6y+1=0,$ a normal vector to the plane is ${n}_{1}=⟨3,-6,0⟩.$\n\n- For the plane $-x+2y=0,$ a normal vector to the plane is ${n}_{2}=⟨-1,2,0⟩.$\n\nNow, let's consider the statements.\n\n- Statement I is true. Indeed, computing the cross product of the normal vectors, we get\n\n$$\n\\begin{aligned}{n}_{1}\\times {n}_{2} & =⟨3,-6,0⟩\\times ⟨-1,2,0⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 3 & -6 & 0 \\\\ -1 & 2 & 0\\end{aligned}\\right| \\\\  & =0i+0j+0k \\\\  & =0.\\end{aligned}\n$$\n\n- Statement II is true. Since ${n}_{1}\\times {n}_{2}=0$, the vectors ${n}_{1}$ and ${n}_{2}$ are parallel. However,  the second plane passes through the origin  $O(0,0,0)$ but the first plane doesn't: \n\n$$\n3(0)-6(0)+1=1\\ne 0\n$$\n\n So, the planes are parallel but not coincident.\n\n- Statement III is false. Since planes are parallel but not coincident, they cannot intersect.\n\nTherefore, only statements I and II are true." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-2364b0d7-2e01-5066-ae19-026ea99bfd99"] :db/ensure [:question/validate]} {:db/id "answer-field-2364b0d7-2e01-5066-ae19-026ea99bfd99" :answer-field/id #uuid "2364b0d7-2e01-5066-ae19-026ea99bfd99" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0cd4e332-b156-59b1-ae2a-6ee0a08db8ae" :answer-field/choices ["answer-0cd4e332-b156-59b1-ae2a-6ee0a08db8ae" "answer-df0cddb8-e92c-55c7-aa50-0c028229c858" "answer-b421ec28-5bd3-59b4-af01-a5ba41d5c3ce" "answer-9cd38e05-67b8-5a94-8742-6e3af398c4d8" "answer-41b5d577-0fb3-59f4-8ba7-b4b1fb1a2178"] :db/ensure [:answer-field/validate]} {:db/id "answer-0cd4e332-b156-59b1-ae2a-6ee0a08db8ae" :answer/id #uuid "0cd4e332-b156-59b1-ae2a-6ee0a08db8ae" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-df0cddb8-e92c-55c7-aa50-0c028229c858" :answer/id #uuid "df0cddb8-e92c-55c7-aa50-0c028229c858" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-b421ec28-5bd3-59b4-af01-a5ba41d5c3ce" :answer/id #uuid "b421ec28-5bd3-59b4-af01-a5ba41d5c3ce" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-9cd38e05-67b8-5a94-8742-6e3af398c4d8" :answer/id #uuid "9cd38e05-67b8-5a94-8742-6e3af398c4d8" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-41b5d577-0fb3-59f4-8ba7-b4b1fb1a2178" :answer/id #uuid "41b5d577-0fb3-59f4-8ba7-b4b1fb1a2178" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]}] "assertions" [[17592186147343 :question/problem "Given the two planes $4x-2y=0$ and $-2x+y+1=0$, which of the following statements are true?\n\nI. The cross product of the normal vectors of the planes is equal to $\\mathbf{0}.$\n\nII. The planes are parallel but not coincident.\n\nIII. The planes intersect on a straight line."] [17592186148195 :question/problem "Find a direction vector of the line that is given as the intersection of the following two planes:\n\n$$\n\\{\\begin{aligned}x+2y-5=0 \\\\ 2x-y+z+1=0\\end{aligned}\n$$"] [17592186148195 :question/worked-solution "First, we notice:\n\n- For the plane $x+2y-5=0,$ a normal vector to the plane is ${n}_{1}=⟨1,2,0⟩.$\n\n- For the plane $2x-y+z+1=0,$ a normal vector to the plane is ${n}_{2}=⟨2,-1,1⟩.$\n\nTo find a direction vector for the line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}v & ={n}_{1}\\times {n}_{2} \\\\  & =⟨1,2,0⟩\\times ⟨2,-1,1⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 1 & 2 & 0 \\\\ 2 & -1 & 1\\end{aligned}\\right| \\\\  & =2i-j-5k \\\\  & =⟨2,-1,-5⟩\\end{aligned}\n$$"] [17592186148195 :question/difficulty :question.difficulty/easy] ["answer-251ddf2f-7d06-501e-bde5-438da0173d51" :answer/id #uuid "251ddf2f-7d06-501e-bde5-438da0173d51"] ["answer-251ddf2f-7d06-501e-bde5-438da0173d51" :answer/type :answer.type/math] ["answer-251ddf2f-7d06-501e-bde5-438da0173d51" :answer/value "⟨1,2,-5⟩"] ["answer-6bfb1a2f-76c3-5220-b5fb-9dadb44d9e5d" :answer/id #uuid "6bfb1a2f-76c3-5220-b5fb-9dadb44d9e5d"] ["answer-6bfb1a2f-76c3-5220-b5fb-9dadb44d9e5d" :answer/type :answer.type/math] ["answer-6bfb1a2f-76c3-5220-b5fb-9dadb44d9e5d" :answer/value "⟨1,2,0⟩"] ["answer-5c4bd33c-8bb2-56f3-a03d-83062a02bb60" :answer/id #uuid "5c4bd33c-8bb2-56f3-a03d-83062a02bb60"] ["answer-5c4bd33c-8bb2-56f3-a03d-83062a02bb60" :answer/type :answer.type/math] ["answer-5c4bd33c-8bb2-56f3-a03d-83062a02bb60" :answer/value "⟨2,-1,1⟩"] [17592186146924 :answer-field/correct 17592186146926] [17592186146924 :answer-field/choices "answer-251ddf2f-7d06-501e-bde5-438da0173d51"] [17592186146924 :answer-field/choices "answer-6bfb1a2f-76c3-5220-b5fb-9dadb44d9e5d"] [17592186146924 :answer-field/choices "answer-5c4bd33c-8bb2-56f3-a03d-83062a02bb60"] ["question-0174198f-a0ad-5395-9af8-f36d4c14897b" :question/id #uuid "0174198f-a0ad-5395-9af8-f36d4c14897b"] ["question-0174198f-a0ad-5395-9af8-f36d4c14897b" :question/math-academy-id "q-71392"] ["question-0174198f-a0ad-5395-9af8-f36d4c14897b" :question/problem "The intersection of the planes $-x+z-1=0$ and $y+z+5=0$ is given by the line\n\n$$\nr(t)=⟨{a}_{1},{a}_{2},0⟩+tb,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nCalculate ${a}_{1}+{a}_{2},$ and find a possible direction vector $b.$"] ["question-0174198f-a0ad-5395-9af8-f36d4c14897b" :question/worked-solution "We're given that there exists a point on the line where $z=0.$ Substituting this to the first equation gives\n\n$$\n-x+0-1=0\\,⟹\\,x=-1,\n$$\n\nand substituting $z=0$ into the second equation gives\n\n$$\ny+0+5=0\\,⟹\\,y=-5.\n$$\n\nTherefore, $a=⟨-1,-5,0⟩$ is a position vector of a point on the line.\n\nNext, we notice:\n\n- For the plane $-x+z-1=0,$ a normal vector to the plane is ${n}_{1}=⟨-1,0,1⟩.$\n\n- For the plane $y+z+5=0,$ a normal vector to the plane is ${n}_{2}=⟨0,1,1⟩.$\n\nTo find a direction vector for the line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}b & ={n}_{1}\\times {n}_{2} \\\\  & =⟨-1,0,1⟩\\times ⟨0,1,1⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ -1 & 0 & 1 \\\\ 0 & 1 & 1\\end{aligned}\\right| \\\\  & =-i+j-k \\\\  & =⟨-1,1,-1⟩\\end{aligned}\n$$\n\nThus, the equation of the line is:\n\n$$\n\\begin{aligned}r(t) & =a+tb \\\\ r(t) & =⟨-1,-5,0⟩+t⟨-1,1,-1⟩\\end{aligned}\n$$\n\nFinally then, ${a}_{1}+{a}_{2}=-1+(-5)=-6,$ and $b=⟨-1,1,-1⟩.$"] ["question-0174198f-a0ad-5395-9af8-f36d4c14897b" :question/difficulty :question.difficulty/easy] ["answer-field-b9c0353c-be95-5a9c-955e-2c015a02fd36" :answer-field/id #uuid "b9c0353c-be95-5a9c-955e-2c015a02fd36"] ["answer-22825761-3cc9-54a0-9fb4-b992332a08ec" :answer/id #uuid "22825761-3cc9-54a0-9fb4-b992332a08ec"] ["answer-22825761-3cc9-54a0-9fb4-b992332a08ec" :answer/type :answer.type/math] ["answer-22825761-3cc9-54a0-9fb4-b992332a08ec" :answer/value "{a}_{1}+{a}_{2}=-2,\\,b=⟨-1,-1,-1⟩"] ["answer-f182158c-1a39-52d9-93a0-587908c41e2d" :answer/id #uuid "f182158c-1a39-52d9-93a0-587908c41e2d"] ["answer-f182158c-1a39-52d9-93a0-587908c41e2d" :answer/type :answer.type/math] ["answer-f182158c-1a39-52d9-93a0-587908c41e2d" :answer/value "{a}_{1}+{a}_{2}=-4,\\,b=⟨1,1,-1⟩"] ["answer-82e54d6b-a318-5bff-8d8f-60506bb19284" :answer/id #uuid "82e54d6b-a318-5bff-8d8f-60506bb19284"] ["answer-82e54d6b-a318-5bff-8d8f-60506bb19284" :answer/type :answer.type/math] ["answer-82e54d6b-a318-5bff-8d8f-60506bb19284" :answer/value "{a}_{1}+{a}_{2}=-6,\\,b=⟨-1,1,-1⟩"] ["answer-bbe216cb-a5f0-5c32-89c9-5b3529ecb0d0" :answer/id #uuid "bbe216cb-a5f0-5c32-89c9-5b3529ecb0d0"] ["answer-bbe216cb-a5f0-5c32-89c9-5b3529ecb0d0" :answer/type :answer.type/math] ["answer-bbe216cb-a5f0-5c32-89c9-5b3529ecb0d0" :answer/value "{a}_{1}+{a}_{2}=2,\\,b=⟨-1,1,1⟩"] ["answer-8836d71d-2734-54f0-91d8-699ef75e1c78" :answer/id #uuid "8836d71d-2734-54f0-91d8-699ef75e1c78"] ["answer-8836d71d-2734-54f0-91d8-699ef75e1c78" :answer/type :answer.type/math] ["answer-8836d71d-2734-54f0-91d8-699ef75e1c78" :answer/value "{a}_{1}+{a}_{2}=6,\\,b=⟨1,1,-1⟩"] ["answer-field-b9c0353c-be95-5a9c-955e-2c015a02fd36" :answer-field/key "selection"] ["answer-field-b9c0353c-be95-5a9c-955e-2c015a02fd36" :answer-field/type :answer-field.type/radio] ["answer-field-b9c0353c-be95-5a9c-955e-2c015a02fd36" :answer-field/correct "answer-82e54d6b-a318-5bff-8d8f-60506bb19284"] ["answer-field-b9c0353c-be95-5a9c-955e-2c015a02fd36" :answer-field/choices "answer-22825761-3cc9-54a0-9fb4-b992332a08ec"] ["answer-field-b9c0353c-be95-5a9c-955e-2c015a02fd36" :answer-field/choices "answer-f182158c-1a39-52d9-93a0-587908c41e2d"] ["answer-field-b9c0353c-be95-5a9c-955e-2c015a02fd36" :answer-field/choices "answer-82e54d6b-a318-5bff-8d8f-60506bb19284"] ["answer-field-b9c0353c-be95-5a9c-955e-2c015a02fd36" :answer-field/choices "answer-bbe216cb-a5f0-5c32-89c9-5b3529ecb0d0"] ["answer-field-b9c0353c-be95-5a9c-955e-2c015a02fd36" :answer-field/choices "answer-8836d71d-2734-54f0-91d8-699ef75e1c78"] ["question-0174198f-a0ad-5395-9af8-f36d4c14897b" :question/answer-fields "answer-field-b9c0353c-be95-5a9c-955e-2c015a02fd36"] [17592186147425 :knowledge-point/questions "question-0174198f-a0ad-5395-9af8-f36d4c14897b"] ["question-fad299b6-2750-5729-9622-52ccf21ff85a" :question/id #uuid "fad299b6-2750-5729-9622-52ccf21ff85a"] ["question-fad299b6-2750-5729-9622-52ccf21ff85a" :question/math-academy-id "q-71414"] ["question-fad299b6-2750-5729-9622-52ccf21ff85a" :question/problem "The intersection of the planes $x+2y+2z=0$ and $4x-2y+4z+8=0$ is given by the line\n\n$$\nr(t)=⟨{a}_{1},0,{a}_{3}⟩+tb,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nCalculate ${a}_{1}+{a}_{3},$ and find a possible direction vector $b.$"] ["question-fad299b6-2750-5729-9622-52ccf21ff85a" :question/worked-solution "We're given that there exists a point on the line where $y=0.$ Substituting this into the first equation gives \n\n$$\nx+2(0)+2z=0\\,⟹\\,x=-2z,\n$$\n\nand substituting $y=0$ and $x=-2z$ into the second equation gives\n\n$$\n\\begin{aligned}4x-2y+4z+8 & =0 \\\\ 4(-2z)-2(0)+4z+8 & =0 \\\\ -4z & =-8 \\\\ z & =2.\\end{aligned}\n$$\n\nTherefore, $x=-2z=-4$ and $a=⟨-4,0,2⟩$ is a position vector of a point on the line.\n\nNext, we notice:\n\n- For the plane $x+2y+2z=0,$ a normal vector to the plane is ${n}_{1}=⟨1,2,2⟩.$\n\n- For the plane $4x-2y+4z+8=0,$ a normal vector to the plane is ${n}_{2}=⟨4,-2,4⟩.$\n\nTo find a direction vector for the line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}{n}_{1}\\times {n}_{2} & =⟨1,2,2⟩\\times ⟨4,-2,4⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 1 & 2 & 2 \\\\ 4 & -2 & 4\\end{aligned}\\right| \\\\  & =12i+4j-10k \\\\  & =⟨12,4,-10⟩\\end{aligned}\n$$\n\nWe can pick any vector that is parallel to ${n}_{1}\\times {n}_{2}$ as a direction vector of the line. So, let \n\n$$\nb=\\frac{1}{2}({n}_{1}\\times {n}_{2})=⟨6,2,-5⟩.\n$$\n\nThe equation of the line is:\n\n$$\n\\begin{aligned}r(t) & =a+tb \\\\ r(t) & =⟨-4,0,2⟩+t⟨6,2,-5⟩\\end{aligned}\n$$\n\nFinally then, ${a}_{1}+{a}_{3}=-4+2=-2,$ and $b=⟨6,2,-5⟩.$"] ["question-fad299b6-2750-5729-9622-52ccf21ff85a" :question/difficulty :question.difficulty/moderate] ["answer-field-55c226f4-65ae-55eb-8831-38644f8ba978" :answer-field/id #uuid "55c226f4-65ae-55eb-8831-38644f8ba978"] ["answer-908a5ab3-8788-5615-82bc-44ddb7d0ef8d" :answer/id #uuid "908a5ab3-8788-5615-82bc-44ddb7d0ef8d"] ["answer-908a5ab3-8788-5615-82bc-44ddb7d0ef8d" :answer/type :answer.type/math] ["answer-908a5ab3-8788-5615-82bc-44ddb7d0ef8d" :answer/value "{a}_{1}+{a}_{3}=-1,\\,b=⟨6,4,5⟩"] ["answer-f462a311-ea89-555c-9281-1e9601a16c66" :answer/id #uuid "f462a311-ea89-555c-9281-1e9601a16c66"] ["answer-f462a311-ea89-555c-9281-1e9601a16c66" :answer/type :answer.type/math] ["answer-f462a311-ea89-555c-9281-1e9601a16c66" :answer/value "{a}_{1}+{a}_{3}=-2,\\,b=⟨6,2,-5⟩"] ["answer-a898a62f-1ba9-595b-99f1-d28e38c134b3" :answer/id #uuid "a898a62f-1ba9-595b-99f1-d28e38c134b3"] ["answer-a898a62f-1ba9-595b-99f1-d28e38c134b3" :answer/type :answer.type/math] ["answer-a898a62f-1ba9-595b-99f1-d28e38c134b3" :answer/value "{a}_{1}+{a}_{3}=-4,\\,b=⟨6,2,5⟩"] ["answer-3a7df74d-f1a4-5ac2-993c-3eae86fd0451" :answer/id #uuid "3a7df74d-f1a4-5ac2-993c-3eae86fd0451"] ["answer-3a7df74d-f1a4-5ac2-993c-3eae86fd0451" :answer/type :answer.type/math] ["answer-3a7df74d-f1a4-5ac2-993c-3eae86fd0451" :answer/value "{a}_{1}+{a}_{3}=1,\\,b=⟨6,2,5⟩"] ["answer-f66ecaf3-9ca2-57cf-a1ac-6666ad1e34d8" :answer/id #uuid "f66ecaf3-9ca2-57cf-a1ac-6666ad1e34d8"] ["answer-f66ecaf3-9ca2-57cf-a1ac-6666ad1e34d8" :answer/type :answer.type/math] ["answer-f66ecaf3-9ca2-57cf-a1ac-6666ad1e34d8" :answer/value "{a}_{1}+{a}_{3}=2,\\,b=⟨6,-2,-5⟩"] ["answer-field-55c226f4-65ae-55eb-8831-38644f8ba978" :answer-field/key "selection"] ["answer-field-55c226f4-65ae-55eb-8831-38644f8ba978" :answer-field/type :answer-field.type/radio] ["answer-field-55c226f4-65ae-55eb-8831-38644f8ba978" :answer-field/correct "answer-f462a311-ea89-555c-9281-1e9601a16c66"] ["answer-field-55c226f4-65ae-55eb-8831-38644f8ba978" :answer-field/choices "answer-908a5ab3-8788-5615-82bc-44ddb7d0ef8d"] ["answer-field-55c226f4-65ae-55eb-8831-38644f8ba978" :answer-field/choices "answer-f462a311-ea89-555c-9281-1e9601a16c66"] ["answer-field-55c226f4-65ae-55eb-8831-38644f8ba978" :answer-field/choices "answer-a898a62f-1ba9-595b-99f1-d28e38c134b3"] ["answer-field-55c226f4-65ae-55eb-8831-38644f8ba978" :answer-field/choices "answer-3a7df74d-f1a4-5ac2-993c-3eae86fd0451"] ["answer-field-55c226f4-65ae-55eb-8831-38644f8ba978" :answer-field/choices "answer-f66ecaf3-9ca2-57cf-a1ac-6666ad1e34d8"] ["question-fad299b6-2750-5729-9622-52ccf21ff85a" :question/answer-fields "answer-field-55c226f4-65ae-55eb-8831-38644f8ba978"] [17592186147425 :knowledge-point/questions "question-fad299b6-2750-5729-9622-52ccf21ff85a"] ["question-e8cdac5c-1e47-510f-8a9c-c4df54b69f10" :question/id #uuid "e8cdac5c-1e47-510f-8a9c-c4df54b69f10"] ["question-e8cdac5c-1e47-510f-8a9c-c4df54b69f10" :question/math-academy-id "q-71467"] ["question-e8cdac5c-1e47-510f-8a9c-c4df54b69f10" :question/problem "Given the two planes $3x-6y+1=0$ and $-x+2y=0$, which of the following statements are true?\n\nI. The cross product of the normal vectors of the planes is equal to $0.$\n\nII. The planes are parallel but not coincident.\n\nIII. The planes intersect in a straight line."] ["question-e8cdac5c-1e47-510f-8a9c-c4df54b69f10" :question/worked-solution "First, notice that:  \n\n- For the plane $3x-6y+1=0,$ a normal vector to the plane is ${n}_{1}=⟨3,-6,0⟩.$\n\n- For the plane $-x+2y=0,$ a normal vector to the plane is ${n}_{2}=⟨-1,2,0⟩.$\n\nNow, let's consider the statements.\n\n- Statement I is true. Indeed, computing the cross product of the normal vectors, we get\n\n$$\n\\begin{aligned}{n}_{1}\\times {n}_{2} & =⟨3,-6,0⟩\\times ⟨-1,2,0⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 3 & -6 & 0 \\\\ -1 & 2 & 0\\end{aligned}\\right| \\\\  & =0i+0j+0k \\\\  & =0.\\end{aligned}\n$$\n\n- Statement II is true. Since ${n}_{1}\\times {n}_{2}=0$, the vectors ${n}_{1}$ and ${n}_{2}$ are parallel. However,  the second plane passes through the origin  $O(0,0,0)$ but the first plane doesn't: \n\n$$\n3(0)-6(0)+1=1\\ne 0\n$$\n\n So, the planes are parallel but not coincident.\n\n- Statement III is false. Since planes are parallel but not coincident, they cannot intersect.\n\nTherefore, only statements I and II are true."] ["question-e8cdac5c-1e47-510f-8a9c-c4df54b69f10" :question/difficulty :question.difficulty/moderate] ["answer-field-2364b0d7-2e01-5066-ae19-026ea99bfd99" :answer-field/id #uuid "2364b0d7-2e01-5066-ae19-026ea99bfd99"] ["answer-0cd4e332-b156-59b1-ae2a-6ee0a08db8ae" :answer/id #uuid "0cd4e332-b156-59b1-ae2a-6ee0a08db8ae"] ["answer-0cd4e332-b156-59b1-ae2a-6ee0a08db8ae" :answer/type :answer.type/text] ["answer-0cd4e332-b156-59b1-ae2a-6ee0a08db8ae" :answer/value "I and II only"] ["answer-df0cddb8-e92c-55c7-aa50-0c028229c858" :answer/id #uuid "df0cddb8-e92c-55c7-aa50-0c028229c858"] ["answer-df0cddb8-e92c-55c7-aa50-0c028229c858" :answer/type :answer.type/text] ["answer-df0cddb8-e92c-55c7-aa50-0c028229c858" :answer/value "I only"] ["answer-b421ec28-5bd3-59b4-af01-a5ba41d5c3ce" :answer/id #uuid "b421ec28-5bd3-59b4-af01-a5ba41d5c3ce"] ["answer-b421ec28-5bd3-59b4-af01-a5ba41d5c3ce" :answer/type :answer.type/text] ["answer-b421ec28-5bd3-59b4-af01-a5ba41d5c3ce" :answer/value "II and III only"] ["answer-9cd38e05-67b8-5a94-8742-6e3af398c4d8" :answer/id #uuid "9cd38e05-67b8-5a94-8742-6e3af398c4d8"] ["answer-9cd38e05-67b8-5a94-8742-6e3af398c4d8" :answer/type :answer.type/text] ["answer-9cd38e05-67b8-5a94-8742-6e3af398c4d8" :answer/value "II only"] ["answer-41b5d577-0fb3-59f4-8ba7-b4b1fb1a2178" :answer/id #uuid "41b5d577-0fb3-59f4-8ba7-b4b1fb1a2178"] ["answer-41b5d577-0fb3-59f4-8ba7-b4b1fb1a2178" :answer/type :answer.type/text] ["answer-41b5d577-0fb3-59f4-8ba7-b4b1fb1a2178" :answer/value "III only"] ["answer-field-2364b0d7-2e01-5066-ae19-026ea99bfd99" :answer-field/key "selection"] ["answer-field-2364b0d7-2e01-5066-ae19-026ea99bfd99" :answer-field/type :answer-field.type/radio] ["answer-field-2364b0d7-2e01-5066-ae19-026ea99bfd99" :answer-field/correct "answer-0cd4e332-b156-59b1-ae2a-6ee0a08db8ae"] ["answer-field-2364b0d7-2e01-5066-ae19-026ea99bfd99" :answer-field/choices "answer-0cd4e332-b156-59b1-ae2a-6ee0a08db8ae"] ["answer-field-2364b0d7-2e01-5066-ae19-026ea99bfd99" :answer-field/choices "answer-df0cddb8-e92c-55c7-aa50-0c028229c858"] ["answer-field-2364b0d7-2e01-5066-ae19-026ea99bfd99" :answer-field/choices "answer-b421ec28-5bd3-59b4-af01-a5ba41d5c3ce"] ["answer-field-2364b0d7-2e01-5066-ae19-026ea99bfd99" :answer-field/choices "answer-9cd38e05-67b8-5a94-8742-6e3af398c4d8"] ["answer-field-2364b0d7-2e01-5066-ae19-026ea99bfd99" :answer-field/choices "answer-41b5d577-0fb3-59f4-8ba7-b4b1fb1a2178"] ["question-e8cdac5c-1e47-510f-8a9c-c4df54b69f10" :question/answer-fields "answer-field-2364b0d7-2e01-5066-ae19-026ea99bfd99"] [17592186147427 :knowledge-point/questions "question-e8cdac5c-1e47-510f-8a9c-c4df54b69f10"]] "retractions" [[17592186147343 :question/problem "Given the two planes $4x-2y=0$ and $-2x+y+1=0$, which of the following statements are true?\n\n- The cross product of the normal vectors of the planes is equal to $\\mathbf{0}.$\n\n- The planes are parallel but not coincident.\n\n- The planes intersect on a straight line."] [17592186148195 :question/problem "Find a direction vector of the line that is given as the intersection of the following two planes:\n${x + 2y - 5 = 0; 2x - y + z + 1 = 0$"] [17592186146924 :answer-field/choices 17592186146928] [17592186146924 :answer-field/choices 17592186146925] [17592186146924 :answer-field/choices 17592186146927]]}]