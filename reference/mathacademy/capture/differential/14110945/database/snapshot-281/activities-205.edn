#{[{:activity/first-step {:db/id #edb/ref 17592186060490} :activity/id #uuid "07969c2a-d9c9-5aa3-b46d-6859410b9517" :activity/scope {:db/id #edb/ref 17592186050932 :topic/id #uuid "7297f638-82c2-5d3f-881c-0b3c54878087" :topic/math-academy-id 205} :activity/steps [{:db/id #edb/ref 17592186060490 :step/content {:db/id #edb/ref 17592186060880 :tutorial/content "Let's recall the Pythagorean identity:\n\n$$\n\\cos^2\\theta + \\sin^2\\theta = 1\n$$\n\nIf we subtract $\\sin^2\\theta$ from both sides, we get another identity:\n\n$$\n\\cos^2\\theta  = 1 - \\sin^2\\theta\n$$\n\nWe call this an **alternate form** of the Pythagorean identity.\n\nWe can get a second alternate form if we start with $\\cos^2\\theta + \\sin^2\\theta = 1$ and subtract $\\cos^2\\theta$ from both sides. This gives\n\n$$\n\\sin^2\\theta  = 1 - \\cos^2\\theta.\n$$\n\nThe alternate forms can be used to rewrite $\\cos^2\\theta$ in terms of $\\sin^2\\theta$ and vice-versa. Let's see how this works in practice." :tutorial/id #uuid "848375eb-c4b8-5536-863e-71a8e31faf38" :tutorial/math-academy-id 2421 :tutorial/title "Introduction"} :step/id #uuid "dc99d20a-0da8-5894-aaf6-530f330aaa63" :step/math-academy-id 10859 :step/next {:db/id #edb/ref 17592186060498}} {:db/id #edb/ref 17592186060491 :step/content {:db/id #edb/ref 17592186059651 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059479 :question/id #uuid "3b9c93fe-82ac-58c5-b14a-9bcd30b1f0e9" :question/math-academy-id "e-3175"} :knowledge-point/id #uuid "23637774-8d69-500d-8cb0-5e41a0207542" :knowledge-point/questions [{:db/id #edb/ref 17592186060070} {:db/id #edb/ref 17592186060229} {:db/id #edb/ref 17592186253616} {:db/id #edb/ref 17592186275457} {:db/id #edb/ref 17592186275471} {:db/id #edb/ref 17592186290461} {:db/id #edb/ref 17592186290507} {:db/id #edb/ref 17592186290545} {:db/id #edb/ref 17592186335814}] :knowledge-point/title "Simplifying Rational Expressions Using an Alternate Form of the Pythagorean Identity"} :step/id #uuid "e24efac5-