b/ref 1075 #edb/ref 17592186340856 #edb/ref 17592186045417] [17592186341692 #edb/ref 1075 #edb/ref 17592186340988 #edb/ref 17592186045417] [17592186341692 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186341692 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186341692 #edb/ref 1078 #edb/ref 17592186340856 #edb/ref 17592186045417] [17592186341692 #edb/ref 1079 #uuid "b0f127f7-fee8-5dab-b7e7-c77e03e05e5e" #edb/ref 17592186045417] [17592186342080 #edb/ref 1068 #edb/ref 17592186341692 #edb/ref 17592186045417] [17592186342080 #edb/ref 1069 "q-73752" #edb/ref 17592186045417] [17592186342080 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186342080 #edb/ref 1071 "Consider the system of linear equations\n\n$$\n{\\begin{aligned}2x-6y=10 \\\\ -x+3y=-5.\\end{aligned}\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form, and then find the general solution of the linear system." #edb/ref 17592186045417] [17592186342080 #edb/ref 1072 #uuid "824eec75-5ee7-5066-9e8b-de6f124de7ef" #edb/ref 17592186045417] [17592186342080 #edb/ref 1074 "First, we set up the augmented matrix for the system:\n\n$$\nM=[\\begin{aligned}2 & -6 & 10 \\\\ -1 & 3 & -5\\end{aligned}]\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}2 & -6 & 10 \\\\ -1 & 3 & -5\\end{aligned}] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 5 \\\\ -1 & 3 & -5\\end{aligned}] & {R}_{2} & :={R}_{2}+{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 5 \\\\ 0 & 0 & 0\\end{aligned}].\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n{\\begin{aligned}x-3y=5 \\\\ 0x+0y=0.\\end{aligned}\n$$\n\nSince any pair of numbers $x,y$ is a solution of the final equation $0x+0y=0,$ we can remove this equation from the system. So, our system now consists of a single equation\n\n$$\nx-3y=5.\n$$\n\nThe first variable $(x)$ is the basic variable, and the second variable $(y)$ is the free variable. Solving for the basic variable $(x)$ in terms of the free variable $(y),$ we get $x=5+3y,$ and the general solution is\n\n$$\n{\\begin{aligned}x=5+3y \\\\ y=y\\end{aligned}\n$$\n\nwhere $y$ is an arbitrary number. \n\nIn vector form, the general solution can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}5+3y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty ).\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186345677 #edb/ref 1080 "\\frac{{y}^{2}}{8}-\\frac{{x}^{2}}{12}=1" #edb/ref 17592186045417] [17592186345677 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186345677 #edb/ref 1083 #uuid "23a27f9c-9749-5a27-8bc1-687e30cd4c90" #edb/ref 17592186045417] [17592186345712 #edb/ref 1080 "\\frac{{x}^{2}}{10}-\\frac{{y}^{2}}{8}=1" #edb/ref 17592186045417] [17592186345712 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186345712 #edb/ref 1083 #uuid "282f1ff0-43c3-5110-a0ca-15b6659a694f" #edb/ref 17592186045417] [17592186346170 #edb/ref 1080 "\\frac{{y}^{2}}{10}-\\frac{{x}^{2}}{8}=1" #edb/ref 17592186045417] [17592186346170 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186346170 #edb/ref 1083 #uuid "5ec6e0c4-def5-53e9-aadf-75e564f8266a" #edb/ref 17592186045417] [17592186346281 #edb/ref 1080 "\\frac{{y}^{2}}{4}-\\frac{{x}^{2}}{5}=1" #edb/ref 17592186045417] [17592186346281 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186346281 #edb/ref 1083 #uuid "6b8b3c6d-f140-5e1e-8597-57286a4f5bd6" #edb/ref 17592186045417] [17592186347217 #edb/ref 1080 "\\frac{{x}^{2}}{4}-\\frac{{y}^{2}}{5}=1" #edb/ref 17592186045417] [17592186347217 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186347217 #edb/ref 1083 #uuid "d497e033-1aac-533a-8281-18c86d19ff0b" #edb/ref 17592186045417] [17592186347892 #edb/ref 1075 #edb/ref 17592186345677 #edb/ref 17592186045417] [17592186347892 #edb/ref 1075 #edb/ref 1759218