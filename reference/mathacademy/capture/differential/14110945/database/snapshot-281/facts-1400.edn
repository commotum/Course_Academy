aligned}] \\\\  & \\ne {I}_{3}.\\,\\times \\end{aligned}\n$$\n\nSo, statement II is false.\n\nTherefore, the correct answer is \"I and III only\"." #edb/ref 17592186045417] [17592186339176 #edb/ref 1080 "-14" #edb/ref 17592186045417] [17592186339176 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186339176 #edb/ref 1083 #uuid "05a8d4cf-2a52-5eb3-932c-de54f969d498" #edb/ref 17592186045417] [17592186339665 #edb/ref 1080 "10" #edb/ref 17592186045417] [17592186339665 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186339665 #edb/ref 1083 #uuid "3c2029a1-5daa-5d17-915b-5cb3db9d0a31" #edb/ref 17592186045417] [17592186340152 #edb/ref 1080 "-30" #edb/ref 17592186045417] [17592186340152 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186340152 #edb/ref 1083 #uuid "7364ef2c-a924-50d5-ae40-c9a6106f8bfa" #edb/ref 17592186045417] [17592186340168 #edb/ref 1080 "No solution" #edb/ref 17592186045417] [17592186340168 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186340168 #edb/ref 1083 #uuid "748a6c3f-5c5a-52d0-80b1-56ed7d055f93" #edb/ref 17592186045417] [17592186340321 #edb/ref 1080 "-33" #edb/ref 17592186045417] [17592186340321 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186340321 #edb/ref 1083 #uuid "84d38775-5cfe-5497-a2ea-945dc01057b3" #edb/ref 17592186045417] [17592186340369 #edb/ref 1080 "[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}3-5y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )" #edb/ref 17592186045417] [17592186340369 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186340369 #edb/ref 1083 #uuid "8ab41392-7ec6-5d49-9a1b-01cc4e0b27b4" #edb/ref 17592186045417] [17592186340572 #edb/ref 1080 "[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}5-3y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )" #edb/ref 17592186045417] [17592186340572 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186340572 #e