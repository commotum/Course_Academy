#{[{:activity/first-step {:db/id #edb/ref 17592186101708} :activity/id #uuid "415f6847-2cd0-58f9-a597-f65b9de7b7f6" :activity/scope {:db/id #edb/ref 17592186049144 :topic/id #uuid "de5636f1-a352-5442-9fc2-8f1ec6ed0666" :topic/math-academy-id 1255} :activity/steps [{:db/id #edb/ref 17592186101708 :step/content {:db/id #edb/ref 17592186101973 :tutorial/content "Given the parametric equations of a curve, we can find its Cartesian equation by eliminating the parameter.\n\nFor instance, consider the parametric curve given by\n\n$$\nx=2t, \\,\\,\\, y=t^3, \\quad -2 \\leq t \\leq 2.\n$$\n\nTo find the Cartesian equation of the curve, we start with the $x$ equation and solve for $t\\mathbin{:}$\n\n$$\nx=2t \\quad \\Rightarrow \\quad t=\\frac{x}{2}\n$$\n\nWe now substitute this into our expression for $y\\mathbin{:}$\n\n$$\n\\begin{aligned}y & ={t}^{3} \\\\  & ={(\\frac{x}{2})}^{3} \\\\  & =\\frac{{x}^{3}}{{2}^{3}} \\\\  & =\\frac{{x}^{3}}{8} \\\\  & =\\frac{1}{8}{x}^{3}\\end{aligned}\n$$\n\nSo the Cartesian equation of the curve is $y=\\dfrac{1}{8}x^3.$\n\nHowever, our parametric curve was subject to the constraint $-2\\leq t \\leq 2.$ Since $x=2t,$ the corresponding constraint for $x$ is $-4 \\leq x \\leq 4.$\n\nSo, the complete Cartesian equation is\n\n$$\ny=\\dfrac{1}{8}x^3, \\quad -4 \\leq x \\leq 4.\n$$\n\nThe graph of this curve is shown below:\n\n![](images/46/4697114d3ce40272a49dff794c4375301ae346e81b823049f587f8780172c413.png)" :tutorial/id #uuid "3f03b65a-1f29-5eb4-839d-45eb293997a5" :tutorial/math-academy-id 3354 :tutorial/title "Introduction"} :step/id #uuid "e7a9c822-fdf0-5e24-ac81-c8d6d9320645" :step/math-academy-id 18564 :step/next {:db/id #edb/ref 17592186101709}} {:db/id #edb/ref 17592186101709 :step/content {:db/id #edb/ref 17592186100889 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100713 :question/id #uuid "cbd0cb3d-cf0f-54db-8cfc-c938e463e4f8" :question/math-academy-id "e-5087"} :knowledge-point/id #uuid "79107609-77e6-55e9-970d-da63c39daf0a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048293} {:db/id #edb/ref 17592186048760} {:db/id #edb/ref 17592186048784} {:db/id #edb/ref 17592186048826} {:db/id #edb/ref 17592186050310}] :knowledge-point/questions [{:db/id #edb/ref 17592186101207} {:db/id #edb/ref 17592186101210} {:db/id #edb/ref 17592186237916} {:db/id #edb/ref 17592186237918} {:db/id #edb/ref 17592186275353} {:db/id #edb/ref 17592186275354} {:db/id #edb/ref 17592186275366} {:db/id #edb/ref 17592186292916} {:db/id #edb/ref 17592186292918} {:db/id #edb/ref 17592186299913} {:db/id #edb/ref 17592186299919} {:db/id #edb/ref 17592186299923} {:db/id #edb/ref 17592186299924} {:db/id #edb/ref 17592186299925} {:db/id #edb/ref 17592186299926} {:db/id #edb/ref 17592186299929} {:db/id #edb/ref 17592186302062} {:db/id #edb/ref 17592186335960} {:db/id #edb/ref 17592186335961} {:db/id #edb/ref 17592186377040} {:db/id #edb/ref 17592186377085}] :knowledge-point/title "Finding the Cartesian Equation of a Curve Defined Parametrically"} :step/id #uuid "18c41421-e014-54c1-bddd-7391ac9c146f" :step/math-academy-id 18565 :step/next {:db/id #edb/ref 17592186101711}} {:db/id #edb/ref 17592186101710 :step/content {:db/id #edb/ref 17592186100890 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100714 :question/id #uuid "f3d396ea-caed-51ed-a4d8-0bfc3301f2f3" :question/math-academy-id "e-5101"} :knowledge-point/id #uuid "78dbecb4-68d4-53b0-b47f-f37ce92da896" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048362} {:db/id #edb/ref 17592186048703} {:db/id #edb/ref 17592186049338} {:db/id #edb/ref 17592186049488} {:db/id #edb/ref 17592186050107}] :knowledge-point/questions [{:db/id #edb/ref 17592186101208} {:db/id #edb/ref 17592186101209} {:db/id #edb/ref 17592186237924} {:db/id #edb/ref 17592186237925} {:db/id #edb/ref 17592186237926} {:db/id #edb/ref 17592186275355} {:db/id #edb/ref 17592186275367} {:db/id #edb/ref 17592186275401} {:db/id #edb/ref 17592186275402} {:db/id #edb/ref 17592186290547} {:db/id #edb/ref 17592186290552} {:db/id #edb/ref 17592186290553} {:db/id #edb/ref 17592186290554} {:db/id #edb/ref 17592186299922} {:db/id #edb/ref 17592186302048} {:db/id #edb/ref 17592186302049} {:db/id #edb/ref 17592186375624} {:db/id #edb/ref 17592186377082} {:db/id #edb/ref 17592186377088} {:db/id #edb/ref 17592186377091}] :knowledge-point/title "Finding the Cartesian Equation of a Curve Defined Parametrically With Trigonometric Functions"} :step/id #uuid "8d2cea34-9028-5c66-b57d-e1c8dde4c2ec" :step/math-academy-id 18615} {:db/id #edb/ref 17592186101711 :step/content {:db/id #edb/ref 17592186101974 :tutorial/content "When parametric equations contain trigonometric equations, we can often eliminate the parameter using a trigonometric identity.\n\nTo demonstrate, consider the curve defined parametrically as\n\n$$\nx = \\dfrac{1}{2}\\cos t, \\,\\,\\, y = \\dfrac{1}{3}\\sin t, \\quad 0 \\leq t\\lt 2\\pi\n$$\n\nFor the sine and cosine functions, we have the following Pythagorean identity:\n\n$$\n\\cos^2 t + \\sin^2 t = 1\n$$\n\nFirst, let's make the trigonometric functions the subject of each equation:\n\n$$\n\\begin{aligned}x=\\frac{1}{2}\\operatorname{cos}t\\, & \\Rightarrow \\,\\operatorname{cos}t=2x \\\\ y=\\frac{1}{3}\\operatorname{sin}t\\, & \\Rightarrow \\,\\operatorname{sin}t=3y\\end{aligned}\n$$\n\nSubstituting these values into the Pythagorean identity, we obtain\n\n$$\n\\begin{aligned}(2x)^{2}+(3y)^{2} & =1 \\\\ 4{x}^{2}+9{y}^{2} & =1.\\end{aligned}\n$$\n\nSo, the Cartesian equation of the given curve is $4x^2 + 9y^2 = 1.$" :tutorial/id #uuid "6ac28915-be9b-5357-8577-3e4d1ab9a25d" :tutorial/math-academy-id 3360 :tutorial/title "Finding the Cartesian Equation of Curves Defined Parametrically With Trigonometric Functions"} :step/id #uuid "5010d59b-20f1-5abe-9dbf-e1b6304f1342" :step/math-academy-id 18616 :step/next {:db/id #edb/ref 17592186101710}}] :activity/title "Cartesian Equations of Parametric Curves" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186101094}]}
