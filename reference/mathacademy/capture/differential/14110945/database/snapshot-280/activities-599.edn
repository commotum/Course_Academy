#{[{:activity/first-step {:db/id #edb/ref 17592186079505} :activity/id #uuid "fdd52764-0daf-5efd-a9d3-a33178d0ea3d" :activity/scope {:db/id #edb/ref 17592186049235 :topic/id #uuid "e5a9189d-c52f-5fc0-b562-b787ed5b5ba1" :topic/math-academy-id 599} :activity/steps [{:db/id #edb/ref 17592186079505 :step/content {:db/id #edb/ref 17592186079624 :tutorial/content "When simplifying expressions, we prefer not to leave a radical in the denominator. To eliminate a radical in an expression's denominator, we can use a process known as **rationalizing the denominator**.\n\nTo rationalize the denominator, we need to multiply both the numerator and denominator by the radical that we wish to remove from the denominator.\n\nFor instance, to rationalize the denominator in the expression\n\n$$\n\\dfrac{1}{\\sqrt{x}}\n$$\n\nall we need to do is multiply both the numerator and denominator by $\\sqrt{x}$ and simplify:\n\n$$\n\\begin{aligned}\n\\frac{1}{\\sqrt{x}} &=  \\\\\n\\frac{1}{\\sqrt{x}}\\cdot \\frac{\\sqrt{x}}{\\sqrt{x}} &=  \\\\\n(\\sqrt{x})/((\\sqrt{x})^{2}) &=  \\\\\n&= \\frac{\\sqrt{x}}{x}\n\\end{aligned}\n$$\n\nWe see that the final expression no longer has a radical in the denominator. Thus, the denominator has been rationalized.\n\n**Note:** Because we multiplied the numerator and denominator by the same amount, the resulting expression\n\n$$\n\\dfrac{\\sqrt{x}}{x}\n$$\n\nis equivalent to the original fraction\n\n$$\n\\dfrac{1}{\\sqrt{x}}\n$$\n\nThey are equivalent, even though they are written differently." :tutorial/id #uuid "17e8e5bd-0b03-5315-8d7a-fc97948fb0d4" :tutorial/math-academy-id 1614 :tutorial/title "Introduction"} :step/id #uuid "32f48700-2e28-53f4-8117-05414a51c990" :step/math-academy-id 472359 :step/next {:db/id #edb/ref 17592186079506}} {:db/id #edb/ref 17592186079506 :step/content {:db/id #edb/ref 17592186078561 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078342 :question/id #uuid "b7506e51-659a-5f10-a2a8-822e8378768c" :question/math-academy-id "e-6718"} :knowledge-point/id #uuid "064cd24d-8e8c-5c55-b354-e84edb518c59" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048702}] :knowledge-point/questions [{:db/id #edb/ref 17592186078845} {:db/id #edb/ref 17592186078846} {:db/id #edb/ref 17592186079127}] :knowledge-point/title "Rationalizing a Variable Fraction"} :step/id #uuid "03cdecc5-044c-525b-9d1a-1f3234b5c9a1" :step/math-academy-id 472360 :step/next {:db/id #edb/ref 17592186079507}} {:db/id #edb/ref 17592186079507 :step/content {:db/id #edb/ref 17592186078562 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078171 :question/id #uuid "3b907098-3e14-5db0-914f-811c84a79d1b" :question/math-academy-id "e-1385"} :knowledge-point/id #uuid "49541737-272f-5821-8bf2-241989e14349" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050887}] :knowledge-point/questions [{:db/id #edb/ref 17592186078870} {:db/id #edb/ref 17592186079208}] :knowledge-point/title "Rationalizing a Variable Fraction Using the Quotient Rule For Radicals"} :step/id #uuid "c84a2326-edc8-5f45-9916-727883af7cec" :step/math-academy-id 472364 :step/next {:db/id #edb/ref 17592186079508}} {:db/id #edb/ref 17592186079508 :step/content {:db/id #edb/ref 17592186078563 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078172 :question/id #uuid "226ef796-a5c7-5113-a268-825bc1738a78" :question/math-academy-id "e-1386"} :knowledge-point/id #uuid "bd46dce5-3009-5b72-9230-f4b66fa77c9a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050818}] :knowledge-point/questions [{:db/id #edb/ref 17592186078872} {:db/id #edb/ref 17592186078873} {:db/id #edb/ref 17592186078874}] :knowledge-point/title "Rationalizing a Variable Fraction With More Than Two Terms"} :step/id #uuid "01600498-e551-5c5b-b3e4-ea3cc665f3c0" :step/math-academy-id 472367}] :activity/title "Rationalizing Denominators of Algebraic Expressions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 175