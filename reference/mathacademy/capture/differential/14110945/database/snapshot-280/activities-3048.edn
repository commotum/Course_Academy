#{[{:activity/first-step {:db/id #edb/ref 17592186163156} :activity/id #uuid "4373edc4-1d40-5e9a-bfe9-ecc0845c2651" :activity/scope {:db/id #edb/ref 17592186050835 :topic/id #uuid "6a5936fb-0bab-5b84-a342-e13ec8019ebc" :topic/math-academy-id 3048} :activity/steps [{:db/id #edb/ref 17592186163156 :step/content {:db/id #edb/ref 17592186163365 :tutorial/content "Let $X$ and $Y$ be discrete random variables with supports $S_X$ and $S_Y,$ respectively. We say that $X$ and $Y$ are **independent** if, for all $x\\in S_X$ and $y\\in S_Y,$ we have \n\n$$\nP(X=x, Y=y)=P(X=x)\\cdot P(Y=y).\n$$\n\nMoreover, if $X$ and $Y$ have the joint probability mass function $f(x,y),$ and $f_X(x)$ and $f_Y(y)$ are the marginal mass functions of $X$ and $Y,$ respectively, then\n\n$$\nf(x, y) = f_X(x)\\cdot f_Y (y)\n$$\n\n \n\nfor all $x\\in S_X$ and $y\\in S_Y.$\n\nIf the random variables are not independent, they are **dependent**." :tutorial/id #uuid "ab3a2705-ec4d-5e72-b6dd-553e9cbb6884" :tutorial/math-academy-id 7746 :tutorial/title "Introduction"} :step/id #uuid "b566ab50-5b2d-5693-aaa2-b74aeb985d53" :step/math-academy-id 44847 :step/next {:db/id #edb/ref 17592186163159}} {:db/id #edb/ref 17592186163157 :step/content {:db/id #edb/ref 17592186162153 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161713 :question/id #uuid "1fdcc887-4c52-5d91-ab28-63a7dce9fe5a" :question/math-academy-id "e-12462"} :knowledge-point/id #uuid "196e7d31-5af8-5c82-b2bd-0cf1ed7415e2" :knowledge-point/questions [{:db/id #edb/ref 17592186162343} {:db/id #edb/ref 17592186162388} {:db/id #edb/ref 17592186275114} {:db/id #edb/ref 17592186275115} {:db/id #edb/ref 17592186275116} {:db/id #edb/ref 17592186275117} {:db/id #edb/ref 17592186275118} {:db/id #edb/ref 17592186383466} {:db/id #edb/ref 17592186383473}] :knowledge-point/title "Determining Whether Two Random Variables are Independent Given the Joint PMF Only"} :step/id #uuid "85e8d07f-ff5e-5a08-b15e-b9682157622a" :step/math-academy-id 44848 :step/nex