#{[{:activity/first-step {:db/id #edb/ref 17592186084125} :activity/id #uuid "28dce159-b20f-5270-a0a2-505427e84a1b" :activity/scope {:db/id #edb/ref 17592186048340 :topic/id #uuid "97021ff6-453f-5638-924e-46e41b2ed833" :topic/math-academy-id 711} :activity/steps [{:db/id #edb/ref 17592186084125 :step/content {:db/id #edb/ref 17592186084451 :tutorial/content "Suppose that a student takes a test and gets a score of $x=82.$ If we know that the mean score for the class is $\\overline{x} = 75$ and the standard deviation is $\\sigma = 3.5,$ then how good is the student's score? \n\nTo determine how good the student's score is, we can calculate the **$z$-score**, which is defined by\n\n$$\nz = \\frac{x-\\overline{x}}{\\sigma}.\n$$\n\nThe $z$-score represents how many standard deviations the observed score is above or below the mean of the data set.\n\n- A large positive $z$-score means the student's score is high compared to the class's mean score.\n\n- A $z$-score close to $0$ means the student's score is close to the class's mean score.\n\n- A large negative $z$-score means the student's score is low compared to the class's mean score.\n\nIn this particular example, the student's $z$-score is\n\n$$\nz = \\dfrac{82 - 75}{3.5} = 2.\n$$\n\nSo, the student's score is $2$ standard deviations above the mean. This suggests that the student obtained a much higher score than the average score for the entire class." :tutorial/id #uuid "79fbe8d7-9dd2-5396-a697-e06d76e71c6b" :tutorial/math-academy-id 3697 :tutorial/title "Introduction"} :step/id #uuid "75c61202-a9c8-5b14-884c-0c243f39aa42" :step/math-academy-id 20613 :step/next {:db/id #edb/ref 17592186084126}} {:db/id #edb/ref 17592186084126 :step/content {:db/id #edb/ref 17592186083226 :knowledge-point/canonical-example {:db/id #edb/ref 17592186083026 :question/id #uuid "3a18e6a6-e190-5977-9e1f-0d115b16c9fb" :question/math-academy-id "e-5703"} :knowledge-point/id #uuid "dc94085c-4088-5eaf-887a-eea7f040573c" :knowledge-point/questions [{:db/id #edb/ref 17592186083969} {:db/id #edb/ref 17592186083970} {:db/id #edb/ref 17592186304972} {:db/id #edb/ref 17592186304973} {:db/id #edb/ref 17592186304974} {:db/id #edb/ref 17592186357743} {:db/id #edb/ref 17592186357744}] :knowledge-point/title "Calculating the Z-Score of a Given Observation"} :step/id #uuid "c1a68bf5-c5d5-50ba-aa47-bafe92cbd183" :step/math-academy-id 20614 :step/next {:db/id #edb/ref 17592186084134}} {:db/id #edb/ref 17592186084127 :step/content {:db/id #edb/ref 17592186083227 :knowledge-point/canonical-example {:db/id #edb/ref 17592186083027 :question/id #uuid "1c03d476-51f5-5dc4-bed6-04986f318924" :question/math-academy-id "e-5705"} :knowledge-point/id #uuid "2169053d-78fc-5714-82f4-d89fc36ff695" :knowledge-point/questions [{:db/id #edb/ref 17592186083971} {:db/id #edb/ref 17592186083988} {:db/id #edb/ref 17592186284640} {:db/id #edb/ref 17592186284687} {:db/id #edb/ref 17592186304975} {:db/id #edb/ref 17592186304976} {:db/id #edb/ref 17592186304977} {:db/id #edb/ref 17592186304978} {:db/id #edb/ref 17592186305001} {:db/id #edb/ref 17592186357745}] :knowledge-point/title "Finding the Value of an Observation, Standard Deviation, or Mean Given a Z-Score"} :step/id #uuid "b0edd80f-a5ee-5023-80d1-fdad43bc6b63" :step/math-academy-id 20616 :step/next {:db/id #edb/ref 17592186084268}} {:db/id #edb/ref 17592186084134 :step/content {:db/id #edb/ref 17592186084454 :tutorial/content "So far, we have practiced converting an observation $x$ into a $z$-score. Other times, though, we may be given a $z$-score and want to find the corresponding observation $x.$\n\nTo accomplish this, we can take the formula for the $z$-score and solve for $x\\mathbin{:}$\n\n$$\n\\begin{aligned}z & =\\frac{x-\\overset{―}{x}}{\\sigma } \\\\ z\\cdot \\sigma  & =x-\\overset{―}{x} \\\\ x & =\\overset{―}{x}+z\\cdot \\sigma \\end{aligned}\n$$\n\nFor example, suppose that a data set has a mean of $\\overline{x}=15$ and a standard deviation of $\\sigma = 1.5.$ If we're given a $z$-score of $z=2,$ then we can find the corresponding observation $x$ as follows:\n\n$$\n\\begin{aligned}x & =\\overset{―}{x}+z\\cdot \\sigma  \\\\  & =15+2\\cdot 1.5 \\\\  & =15+3 \\\\  & =18\\end{aligned}\n$$" :tutorial/id #uuid "b2772228-1477-5aed-b3ec-02d21f685274" :tutorial/math-academy-id 3705 :tutorial/title "Finding an Observation Corresponding to a Given Z-Score"} :step/id #uuid "56695f9f-5daf-5cc8-9b02-6106e78ba5bb" :step/math-academy-id 20707 :step/next {:db/id #edb/ref 17592186084127}} {:db/id #edb/ref 17592186084267 :step/content {:db/id #edb/ref 17592186083322 :knowledge-point/canonical-example {:db/id #edb/ref 17592186083124 :question/id #uuid "68d14643-0faf-5cff-b4b9-cdb903946c39" :question/math-academy-id "e-8235"} :knowledge-point/id #uuid "d7e9daa2-4aaa-5c33-b611-231f3d0e4782" :knowledge-point/questions [{:db/id #edb/ref 17592186083982} {:db/id #edb/ref 17592186083985} {:db/id #edb/ref 17592186284642} {:db/id #edb/ref 17592186305009} {:db/id #edb/ref 17592186305010} {:db/id #edb/ref 17592186305011} {:db/id #edb/ref 17592186357752} {:db/id #edb/ref 17592186362243} {:db/id #edb/ref 17592186362297}] :knowledge-point/title "Z-Score: Word Problems"} :step/id #uuid "e4fabb97-fb83-54ac-bf48-59a6c3ed7682" :step/math-academy-id 30811} {:db/id #edb/ref 17592186084268 :step/content {:db/id #edb/ref 17592186083323 :knowledge-point/canonical-example {:db/id #edb/ref 17592186083125 :question/id #uuid "c4f84572-0883-5fb5-b5d8-513d1aa2f50a" :question/math-academy-id "e-8236"} :knowledge-point/id #uuid "01100ea8-2ab9-511e-8321-6ef5588c4417" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050564} {:db/id #edb/ref 17592186050926}] :knowledge-point/questions [{:db/id #edb/ref 17592186083569} {:db/id #edb/ref 17592186083968} {:db/id #edb/ref 17592186305005} {:db/id #edb/ref 17592186305006} {:db/id #edb/ref 17592186305007} {:db/id #edb/ref 17592186305008} {:db/id #edb/ref 17592186357746} {:db/id #edb/ref 17592186357747}] :knowledge-point/title "Solving a System of Equations to Compute an Unknown Mean or Standard Deviation"} :step/id #uuid "83423fd5-cc32-5942-8633-6f6c285f43c7" :step/math-academy-id 30812 :step/next {:db/id #edb/ref 17592186084267}}] :activity/title "The Z-Score" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186083415}]}
