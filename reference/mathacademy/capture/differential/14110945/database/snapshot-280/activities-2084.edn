#{[{:activity/first-step {:db/id #edb/ref 17592186129988} :activity/id #uuid "bb4f4046-3730-5392-be21-d66c1f2457af" :activity/scope {:db/id #edb/ref 17592186049105 :topic/id #uuid "daf230f5-1a2c-50ef-8877-f60d57223e1e" :topic/math-academy-id 2084} :activity/steps [{:db/id #edb/ref 17592186129988 :step/content {:db/id #edb/ref 17592186130361 :tutorial/content "The graph of any cubic function\n\n$$\ny = f(x)= ax^3 + bx^2 + cx +d\n$$\n\nwhere $a >0$, has a characteristic inverted ${\\textsf{S}}$-shape, with $y$-values ranging from $-\\infty$ to $+\\infty$. This means that every such function has at least one real root and at most three distinct roots.\n\nFor instance, suppose that we want to plot the graph of\n\n$$\ny = x^3-3x^2 +3x-1\n$$\n\nFirst, we need to find the roots, so we set $y=0$ and solve. Noting that the polynomial is a perfect cube, we find\n\n$$\n\\begin{aligned}\nx^{3} - 3x^{2} + 3x - 1 &= 0 \\\\\n(x - 1)^{3} &= 0\n\\end{aligned}\n$$\n\nSo we get one real root $x=1$, which has multiplicity $3$.\n\nAt a root of multiplicity $3$, the graph becomes **tangent** (i.e., lies parallel) to the $x$-axis and crosses the $x$-axis.\n\nTherefore, the graph looks as follows:\n\n![](images/d8/d87834ef3f7225b00d92e6051a67735cf6695c5a2eff9635c4de416d0be1577f.png)" :tutorial/id #uuid "848b066b-7e36-58cf-ae75-a8e28e9d3358" :tutorial/math-academy-id 3752 :tutorial/title "Introduction"} :step/id #uuid "051afa25-c36b-5ee0-9d9d-eb0b733f3ede" :step/math-academy-id 21027 :step/next {:db/id #edb/ref 17592186129989}} {:db/id #edb/ref 17592186129989 :step/content {:db/id #edb/ref 17592186129140 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128955 :question/id #uuid "75d559bd-99c1-5374-9ae6-0096a8b1d86e" :question/math-academy-id "e-5806"} :knowledge-point/id #uuid "40733109-8985-5f30-9678-289216c1da00" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048691} {:db/id #edb/ref 17592186050334}] :knowledge-point/questions [{:db/id #edb/ref 17592186129571} {:db/id #edb/ref 17592186129573}] :knowledge-point/title "Graphing a Factored Cubic Curve with a Positive Leading Coefficient"} :step/id #uuid "eb11761e-2cec-5933-a69a-8624ea5f99b8" :step/math-academy-id 21029 :step/next {:db/id #edb/ref 17592186129990}} {:db/id #edb/ref 17592186129990 :step/content {:db/id #edb/ref 17592186129141 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128956 :question/id #uuid "1ebf167f-0c61-5721-9019-1da86d591c7c" :question/math-academy-id "e-5808"} :knowledge-point/id #uuid "4ef84d8b-a825-581a-aa43-2b18b42ab882" :knowledge-point/questions [{:db/id #edb/ref 17592186129709} {:db/id #edb/ref 17592186129713}] :knowledge-point/title "Graphing an Expanded Cubic Curve with a Positive Leading Coefficient"} :step/id #uuid "865f0324-f2f1-593d-a63c-922f8ee140ad" :step/math-academy-id 21032 :step/next {:db/id #edb/ref 17592186129991}} {:db/id #edb/ref 17592186129991 :step/content {:db/id #edb/ref 17592186130364 :tutorial/content "The graph of any cubic function\n\n$$\ny = f(x)= ax^3 + bx^2 + cx +d\n$$\n\nwhere $a <0$, has a characteristic ${\\textsf{S}}$-shape, with $y$-values ranging from $+\\infty$ to $-\\infty$.\n\nFor instance, suppose that we want to plot the graph of\n\n$$\ny = -x^3+3x^2 -3x+1\n$$\n\nFirst, we need to find the roots, so we set $y=0$ and solve. Noting that the polynomial is a perfect cube, we find\n\n$$\n\\begin{aligned}\n-x^{3} + 3x^{2} - 3x + 1 &= 0 \\\\\n(-x + 1)^{3} &= 0 \\\\\n- (x - 1)^{3} &= 0\n\\end{aligned}\n$$\n\nSo we get one real root $x=1$, which has multiplicity $3$.\n\nAt a root of multiplicity $3$, the graph becomes tangent to the $x$-axis and crosses the $x$-axis. Therefore, the graph looks as follows:\n\n![](images/5c/5cd99c1f2a3a596002edc222e0d9b13969286a49361fc804fe7db8818017980b.png)" :tutorial/id #uuid "73e1e583-b344-5de0-9cc8-c0ec3a475e82" :tutorial/math-academy-id 3756 :tutorial/title "Negative Cubic Curves With Only One Distinct Real Root"} :step/id #uuid "d1f3375e-451a-5569-acec-c0bde4d976fa" :step/math-academy-id 21033 :step/next {:db/id #edb/ref 17592186129994}} {:db/id #edb/ref 17592186129994 :step/content {:db/id #edb/ref 17592186129143 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128957 :question/id #uuid "acf8ac05-4080-50ea-8a33-dca4a08cb7e6" :question/math-academy-id "e-5810"} :knowledge-point/id #uuid "fde30544-dd02-5df3-838f-896d81562ebb" :knowledge-point/questions [{:db/id #edb/ref 17592186129572} {:db/id #edb/ref 17592186129870}] :knowledge-point/title "Graphing a Factored Cubic Curve with a Negative Leading Coefficient"} :step/id #uuid "25f7fb47-95e9-58de-9b40-bdc5ea29bc79" :step/math-academy-id 21037 :step/next {:db/id #edb/ref 17592186129999}} {:db/id #edb/ref 17592186129999 :step/content {:db/id #edb/ref 17592186129146 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128959 :question/id #uuid "50dda1cf-e61a-5efb-9671-a66d71360b84" :question/math-academy-id "e-5813"} :knowledge-point/id #uuid "5fd988de-d8c3-5dcb-b3c3-636d4173d5de" :knowledge-point/questions [{:db/id #edb/ref 17592186129711} {:db/id #edb/ref 17592186129724}] :knowledge-point/title "Graphing an Expanded Cubic Curve with a Negative Leading Coefficient"} :step/id #uuid "c6e25844-0c2f-5a68-af2d-f3b6ac122e86" :step/math-academy-id 21043}] :activity/title "Graphing Cubic Curves Containing One Distinct Real Root" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186129396}]}
