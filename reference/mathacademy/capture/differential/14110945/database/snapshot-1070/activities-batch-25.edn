#edb/ref 17592186265938} {:db/id #edb/ref 17592186265939} {:db/id #edb/ref 17592186265940} {:db/id #edb/ref 17592186357506} {:db/id #edb/ref 17592186357507} {:db/id #edb/ref 17592186394847} {:db/id #edb/ref 17592186412026}] :knowledge-point/title "Using Column Operations to Create a Row of Zeros in a 3x3 Matrix"} :step/id #uuid "007cc686-090e-50a0-8170-5b1c5eb412f6" :step/math-academy-id 30061 :step/next {:db/id #edb/ref 17592186162827}}] :activity/title "Creating Rows or Columns Containing Zeros Using Gaussian Elimination" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186162182}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186412027} :activity/id #uuid "61c7230c-4be1-54c6-95c3-76fe59986f88" :activity/scope {:db/id #edb/ref 17592186050527 :topic/id #uuid "508ac00e-0867-53e8-a192-d981ff4bbdc2" :topic/math-academy-id 3029} :activity/steps [{:db/id #edb/ref 17592186412027 :step/content {:db/id #edb/ref 17592186329695 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0166ede7-ac8b-5aee-a3fc-ae0a17866fce" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "${R}_{1}:={R}_{1}+4{R}_{3}\\,$ and $\\,{R}_{4}:={R}_{4}-3{R}_{3}$" :db/id #edb/ref 17592186326949} {:answer/id #uuid "2ccc7768-32ec-5947-9670-1ec97e53d1da" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "${R}_{1}:={R}_{1}+4{R}_{3}\\,$ and $\\,{R}_{4}:={R}_{4}+3{R}_{3}$" :db/id #edb/ref 17592186327328} {:answer/id #uuid "54c6de8d-19a8-57aa-96b2-7a92b017ceaa" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "${R}_{1}:={R}_{1}-4{R}_{3}\\,$ and $\\,{R}_{4}:={R}_{4}+3{R}_{3}$" :db/id #edb/ref 17592186327667} {:answer/id #uuid "57b8eae7-5346-50fa-98a2-5cd486bfdba3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "${R}_{1}:={R}_{1}-4{R}_{3}\\,$ and $\\,{R}_{4}:={R}_{4}-3{R}_{3}$" :db/id #edb/ref 17592186327701} {:answer/id #uuid "ddddd82a-3c70-51bf-a2eb-edddccc2e4c2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "${R}_{1}:={R}_{1}+3{R}_{3}\\,$ and $\\,{R}_{4}:={R}_{4}-4{R}_{3}$" :db/id #edb/ref 17592186328873}] :answer-field/correct {:db/id #edb/ref 17592186326949} :answer-field/id #uuid "326f90b0-553c-55c5-999d-072fa4528fa2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186329280}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5b4f6183-748c-523a-a6b7-35464ca87075" :question/math-academy-id "q-42918" :question/problem "$$\nA=[\\begin{aligned}-3 & 1 & 1 & 8 \\\\ 1 & 2 & 3 & -4 \\\\ 0 & 5 & 4 & -2 \\\\ 4 & -3 & -1 & -6\\end{aligned}],\\,B=[\\begin{aligned}-3 & 21 & 17 & 0 \\\\ 1 & -8 & -5 & 0 \\\\ 0 & 5 & 4 & -2 \\\\ 4 & -18 & -13 & 0\\end{aligned}]\n$$\n\nConsider the matrices $A$ and $B$ above. By applying three matrix elementary row operations \n\n- ${R}_{1}:=…$\n- ${R}_{2}:={R}_{2}-2{R}_{3}$\n- ${R}_{4}:=…$\n\neach of the form ${R}_{i}:={R}_{i}+k{R}_{3},$ the matrix $A$ can be transformed into the matrix $B.$ What are the missing elementary row operations?" :question/worked-solution "To transform $A$ into $B,$ we need to make entries above and below ${a}_{34}=-2$ equal to $0.$\n\nTo do this, we can apply the following elementary row operations:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}-3 & 1 & 1 & 8 \\\\ 1 & 2 & 3 & -4 \\\\ 0 & 5 & 4 & -2 \\\\ 4 & -3 & -1 & -6\\end{aligned}] &  & \\,\\begin{aligned}{R}_{1}:={R}_{1}+4{R}_{3}\\end{aligned} \\\\  & ∼[\\begin{aligned}-3 & 21 & 17 & 0 \\\\ 1 & 2 & 3 & -4 \\\\ 0 & 5 & 4 & -2 \\\\ 4 & -3 & -1 & -6\\end{aligned}] &  & \\,\\begin{aligned}{R}_{2}:={R}_{2}-2{R}_{3}\\end{aligned} \\\\  & ∼[\\begin{aligned}-3 & 21 & 17 & 0 \\\\ 1 & -8 & -5 & 0 \\\\ 0 & 5 & 4 & -2 \\\\ 4 & -3 & -1 & -6\\end{aligned}] &  & \\,\\begin{aligned}{R}_{4}:={R}_{4}-3{R}_{3}\\end{aligned} \\\\  & ∼[\\begin{aligned}-3 & 21 & 17 & 0 \\\\ 1 & -8 & -5 & 0 \\\\ 0 & 5 & 4 & -2 \\\\ 4 & -18 & -13 & 0\\end{aligned}] \\\\  & =B.\\end{aligned}\n$$\n\n  \n\nTherefore, the missing elementary row operations are\n\n$\\,$ ${R}_{1}:={R}_{1}+4{R}_{3}\\,$ and $\\,{R}_{4}:={R}_{4}-3{R}_{3}.$"} :step/id #uuid "3be10ce9-b323-5320-8a6b-fd2980284abe" :step/next {:db/id #edb/ref 17592186412028}} {:db/id #edb/ref 17592186412028 :step/content {:db/id #edb/ref 17592186162571 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39feaea9-f53d-5ee3-a622-cbfc2b43387f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "${R}_{2}:={R}_{2}-{R}_{1}\\,$ and $\\,{R}_{4}:={R}_{4}+2{R}_{1}$" :db/id #edb/ref 17592186412015} {:answer/id #uuid "3b22a6a4-61fa-5183-9649-c580b3bc7020" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "${R}_{2}:={R}_{2}-{R}_{1}\\,$ and $\\,{R}_{4}:={R}_{4}-2{R}_{1}$" :db/id #edb/ref 17592186412016} {:answer/id #uuid "a66beb93-cf63-56e5-af86-8bf4482be7a2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "${R}_{2}:={R}_{2}-{R}_{1}\\,$ and $\\,{R}_{4}:={R}_{4}+{R}_{1}$" :db/id #edb/ref 17592186412019} {:answer/id #uuid "c49a7ab3-b457-50a7-8db3-96d09691584e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "${R}_{2}:={R}_{2}+{R}_{1}\\,$ and $\\,{R}_{4}:={R}_{4}-2{R}_{1}$" :db/id #edb/ref 17592186412022} {:answer/id #uuid "caaba1b9-461d-5d04-a1fd-8f442d709eb4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "${R}_{2}:={R}_{2}+{R}_{1}\\,$ and $\\,{R}_{4}:={R}_{4}+2{R}_{1}$" :db/id #edb/ref 17592186412023}] :answer-field/correct {:db/id #edb/ref 17592186412015} :answer-field/id #uuid "db7b0ab2-ace0-5e5f-813e-a09b5ee8870d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186412025}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e471ec15-a8b3-57bf-a5ff-3531b5523c10" :question/math-academy-id "q-91171" :question/problem "$$\nA=[\\begin{aligned}1 & -3 & -7 & -5 \\\\ 1 & 10 & 7 & 2 \\\\ -1 & 0 & 8 & 7 \\\\ -2 & 1 & 0 & 9\\end{aligned}],\\,B=[\\begin{aligned}1 & -3 & -7 & -5 \\\\ 0 & 13 & 14 & 7 \\\\ 0 & -3 & 1 & 2 \\\\ 0 & -5 & -14 & -1\\end{aligned}]\n$$\n\nConsider the matrices $A$ and $B$ above. By applying three matrix elementary row operations \n\n- ${R}_{2}:=…$\n- ${R}_{3}:={R}_{3}+{R}_{1}$\n- ${R}_{4}:=…$\n\neach of the form ${R}_{i}:={R}_{i}+k{R}_{1},$ the matrix $A$ can be transformed into the matrix $B.$ What are the missing elementary row operations?" :question/worked-solution "To transform $A$ into $B,$ we need to make entries below ${a}_{11}=1$ equal to $0.$\n\nTo do this, we can apply the following elementary row operations:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1 & -3 & -7 & -5 \\\\ 1 & 10 & 7 & 2 \\\\ -1 & 0 & 8 & 7 \\\\ -2 & 1 & 0 & 9\\end{aligned}] &  & \\,\\begin{aligned}{R}_{2}:={R}_{2}-{R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & -3 & -7 & -5 \\\\ 0 & 13 & 14 & 7 \\\\ -1 & 0 & 8 & 7 \\\\ -2 & 1 & 0 & 9\\end{aligned}] &  & \\,\\begin{aligned}{R}_{3}:={R}_{3}+{R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & -3 & -7 & -5 \\\\ 0 & 13 & 14 & 7 \\\\ 0 & -3 & 1 & 2 \\\\ -2 & 1 & 0 & 9\\end{aligned}] &  & \\,\\begin{aligned}{R}_{4}:={R}_{4}+2{R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & -3 & -7 & -5 \\\\ 0 & 13 & 14 & 7 \\\\ 0 & -3 & 1 & 2 \\\\ 0 & -5 & -14 & -1\\end{aligned}] \\\\  & =B\\end{aligned}\n$$\n\n  \n\nTherefore, the missing elementary row operations are\n\n$\\,$ ${R}_{2}:={R}_{2}-{R}_{1}\\,$ and $\\,{R}_{4}:={R}_{4}+2{R}_{1}.$"} :step/id #uuid "481012f0-867f-5ff8-ba1d-2515c1153226" :step/next {:db/id #edb/ref 17592186412029}} {:db/id #edb/ref 17592186412029 :step/content {:db/id #edb/ref 17592186412026 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "166feab7-a264-55aa-acc5-4218b97966a9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "${C}_{2}:={C}_{2}-2{C}_{1}\\,$ and $\\,{C}_{3}:={C}_{3}+{C}_{1}$" :db/id #edb/ref 17592186412014} {:answer/id #uuid "4c552dee-9870-5f80-99c4-13a42caad182" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "${C}_{2}:={C}_{2}+3{C}_{1}\\,$ and $\\,{C}_{3}:={C}_{3}+2{C}_{1}$" :db/id #edb/ref 17592186412017} {:answer/id #uuid "99b872c0-2012-5d57-9afd-16e6b6bde53b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "${C}_{2}:={C}_{2}+2{C}_{1}\\,$ and $\\,{C}_{3}:={C}_{3}-{C}_{1}$" :db/id #edb/ref 17592186412018} {:answer/id #uuid "a66ce929-c767-5507-b64f-0b3826324583" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "${C}_{2}:={C}_{2}-{C}_{1}\\,$ and $\\,{C}_{3}:={C}_{3}-2{C}_{1}$" :db/id #edb/ref 17592186412020} {:answer/id #uuid "aa1f46ac-844a-5bb2-b9b6-04cb4156fcf9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "${C}_{2}:={C}_{2}-2{C}_{1}\\,$ and $\\,{C}_{3}:={C}_{3}-{C}_{1}$" :db/id #edb/ref 17592186412021}] :answer-field/correct {:db/id #edb/ref 17592186412021} :answer-field/id #uuid "3ff26ed5-7a58-584f-95b3-0a0e85d61774" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186412024}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e8820685-174a-5aac-b0a4-a6b54f80941e" :question/math-academy-id "q-91188" :question/problem "$$\nA=[\\begin{aligned}0 & 1 & 2 \\\\ 3 & 7 & 4 \\\\ 3 & 6 & 3\\end{aligned}],\\,B=[\\begin{aligned}0 & 1 & 2 \\\\ 3 & 1 & 1 \\\\ 3 & 0 & 0\\end{aligned}]\n$$\n\nBy applying elementary column operations of the form ${C}_{i}:={C}_{i}+k{C}_{1},$ the matrix $A$ can be transformed into the matrix $B.$ What are the elementary column operations?" :question/worked-solution "To transform $A$ into $B,$ we need to make entries to the right of ${a}_{31}=3$ equal to $0.$\n\nTo do this, we can apply the following elementary column operations:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}0 & 1 & 2 \\\\ 3 & 7 & 4 \\\\ 3 & 6 & 3\\end{aligned}] &  & \\,\\begin{aligned}{C}_{2}:={C}_{2}-2{C}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}0 & 1 & 2 \\\\ 3 & 1 & 4 \\\\ 3 & 0 & 3\\end{aligned}] &  & \\,\\begin{aligned}{C}_{3}:={C}_{3}-{C}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}0 & 1 & 2 \\\\ 3 & 1 & 1 \\\\ 3 & 0 & 0\\end{aligned}] \\\\  & =B\\end{aligned}\n$$\n\nTherefore, the elementary column operations are\n\n$\\,$ ${C}_{2}:={C}_{2}-2{C}_{1}\\,$ and $\\,{C}_{3}:={C}_{3}-{C}_{1}.$"} :step/id #uuid "9cc0e464-95dc-5890-bc99-303c34184e49"}] :activity/title "Creating Rows or Columns Containing Zeros Using Gaussian Elimination" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186412013}] [{:activity/first-step {:db/id #edb/ref 17592186116072} :activity/id #uuid "44ee8e90-06fb-5914-8a24-13b8cd43fdef" :activity/scope {:db/id #edb/ref 17592186050819 :topic/id #uuid "68fac9fb-a6fb-5c4b-a510-881f3f9dcbd6" :topic/math-academy-id 1685} :activity/steps [{:db/id #edb/ref 17592186116072 :step/content {:db/id #edb/ref 17592186116550 :tutorial/content "The properties of indefinite integrals also apply to definite integrals. For example, to evaluate the definite integral\n\n$$\n\\displaystyle\\int_{2}^{3} 4 x \\, \\textrm d x,\n$$\n\nwe can use the constant multiple rule and factor the constant out of the integral:\n\n$$\n\\begin{aligned}{\\int }_{2}^{3}4x\\,\\text{d}x & =4{\\int }_{2}^{3}x\\,\\text{d}x \\\\  & =4\\cdot \\frac{{x}^{2}}{2}{|}_{2}^{3} \\\\  & =2{x}^{2}{|}_{2}^{3} \\\\  & =2({3}^{2}-{2}^{2}) \\\\  & =2(9-4) \\\\  & =10.\\end{aligned}\n$$\n\nIn general, the constant multiple rule holds for any constant $k$ and any definite integral:\n\n$$\n\\begin{aligned}{\\int }_{a}^{b}kf(x)\\,\\text{d}x & =k{\\int }_{a}^{b}f(x)\\,\\text{d}x.\\end{aligned}\n$$" :tutorial/id #uuid "bdf78ae3-dc9e-5db4-a6a4-ac8883d6ab7a" :tutorial/math-academy-id 771 :tutorial/title "Introduction"} :step/id #uuid "42942332-9de2-50a2-84a2-31cc9820d6cd" :step/math-academy-id 1479 :step/next {:db/id #edb/ref 17592186116073}} {:db/id #edb/ref 17592186116073 :step/content {:db/id #edb/ref 17592186115209 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115032 :question/id #uuid "4036785f-d99b-5c01-81e9-edfb93cc1f0d" :question/math-academy-id "e-413"} :knowledge-point/id #uuid "eaea1ecf-d6b9-5807-8776-17359e94336b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048442} {:db/id #edb/ref 17592186050057}] :knowledge-point/questions [{:db/id #edb/ref 17592186115924} {:db/id #edb/ref 17592186115925} {:db/id #edb/ref 17592186250198} {:db/id #edb/ref 17592186250199} {:db/id #edb/ref 17592186314854} {:db/id #edb/ref 17592186314865} {:db/id #edb/ref 17592186314866}] :knowledge-point/title "Evaluating a Definite Integral Using the Constant Multiple Rule"} :step/id #uuid "21ed1c8e-2514-5eae-bb70-556cf141e5f0" :step/math-academy-id 1480 :step/next {:db/id #edb/ref 17592186116074}} {:db/id #edb/ref 17592186116074 :step/content {:db/id #edb/ref 17592186116551 :tutorial/content "We can also use the sum rule to compute the definite integral of the sum of two functions. For example, to evaluate the definite integral\n\n$$\n\\displaystyle\\int_{1}^{2} (x+x^2) \\, \\textrm d x,\n$$\n\nwe can split up the integral into a sum of two integrals and evaluate each integral separately:\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}(x+{x}^{2})\\,\\text{d}x & ={\\int }_{1}^{2}x\\,\\text{d}x+{\\int }_{1}^{2}{x}^{2}\\,\\text{d}x \\\\  & =\\frac{{x}^{2}}{2}{|}_{1}^{2}+\\frac{{x}^{3}}{3}{|}_{1}^{2} \\\\  & =\\frac{4-1}{2}+\\frac{8-1}{3} \\\\  & =\\frac{3}{2}+\\frac{7}{3} \\\\  & =\\frac{23}{6}.\\end{aligned}\n$$\n\nIn general,\n\n$$\n\\begin{aligned}{\\int }_{a}^{b}(f(x)+g(x))\\,\\text{d}x & ={\\int }_{a}^{b}f(x)\\,\\text{d}x+{\\int }_{a}^{b}g(x)\\,\\text{d}x.\\end{aligned}\n$$" :tutorial/id #uuid "4a0dd6d3-abec-56e8-a3b1-a812dfb45c5a" :tutorial/math-academy-id 773 :tutorial/title "Integrating the Sum of Two Functions"} :step/id #uuid "a617fa95-33e7-5e87-86d9-7d7d9736b369" :step/math-academy-id 1482 :step/next {:db/id #edb/ref 17592186116075}} {:db/id #edb/ref 17592186116075 :step/content {:db/id #edb/ref 17592186115210 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115039 :question/id #uuid "6ecec0d3-1714-550b-bce2-88ead5abf2f4" :question/math-academy-id "e-414"} :knowledge-point/id #uuid "f236feb9-761b-544b-b34a-19eb46c28988" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050321}] :knowledge-point/questions [{:db/id #edb/ref 17592186115525} {:db/id #edb/ref 17592186115538} {:db/id #edb/ref 17592186250200} {:db/id #edb/ref 17592186297439} {:db/id #edb/ref 17592186314867} {:db/id #edb/ref 17592186314930} {:db/id #edb/ref 17592186341948}] :knowledge-point/title "Evaluating the Integral of the Sum of Two Functions Using the Sum Rule"} :step/id #uuid "c61f0b67-9fc5-5ae1-b73c-67633bb488dc" :step/math-academy-id 1483 :step/next {:db/id #edb/ref 17592186116076}} {:db/id #edb/ref 17592186116076 :step/content {:db/id #edb/ref 17592186116552 :tutorial/content "To compute the integral of the sum of two functions multiplied by constants, we can combine the addition rule and the constant multiple rule. For example, to compute the integral\n\n$$\n\\int_{0}^1 (3x^2 + 6x)\\,\\textrm d x ,\n$$\n\n we can split up the sum and factor out the constants, as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}(3{x}^{2}+6x)\\,\\text{d}x & ={\\int }_{0}^{1}3{x}^{2}\\,\\text{d}x+{\\int }_{0}^{1}6x\\,\\text{d}x \\\\  & =3{\\int }_{0}^{1}{x}^{2}\\,\\text{d}x+6{\\int }_{0}^{1}x\\,\\text{d}x.\\end{aligned}\n$$\n\nThen, we can compute the two resulting integrals using the usual methods.\n\nIn general, for functions $f(x)$ and $g(x)$ and constants $c$ and $k$, we have\n\n$$\n\\begin{aligned}{\\int }_{a}^{b}(cf(x)+kg(x))\\,\\text{d}x & =c{\\int }_{a}^{b}f(x)\\,\\text{d}x+k{\\int }_{a}^{b}g(x)\\,\\text{d}x.\\end{aligned}\n$$" :tutorial/id #uuid "244b2afb-58eb-526d-ba0c-7ff36d5b834f" :tutorial/math-academy-id 775 :tutorial/title "Combining the Constant Multiple and Sum Rules"} :step/id #uuid "883460b7-eab8-5c86-9349-144425d70c90" :step/math-academy-id 1485 :step/next {:db/id #edb/ref 17592186116077}} {:db/id #edb/ref 17592186116077 :step/content {:db/id #edb/ref 17592186115211 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115041 :question/id #uuid "d5d4992c-4c68-5d30-b7b7-a5a89e4cc3e4" :question/math-academy-id "e-415"} :knowledge-point/id #uuid "5cff6bd5-aeb6-55ed-a44b-fca322e73dd8" :knowledge-point/questions [{:db/id #edb/ref 17592186115542} {:db/id #edb/ref 17592186115895} {:db/id #edb/ref 17592186250204} {:db/id #edb/ref 17592186250205} {:db/id #edb/ref 17592186287978} {:db/id #edb/ref 17592186314937} {:db/id #edb/ref 17592186314941}] :knowledge-point/title "Evaluating the Integral of a Polynomial Function"} :step/id #uuid "33986316-e319-566e-9931-5531866da50b" :step/math-academy-id 1486 :step/next {:db/id #edb/ref 17592186116078}} {:db/id #edb/ref 17592186116078 :step/content {:db/id #edb/ref 17592186115212 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115047 :question/id #uuid "0347b53a-4f7c-587e-9232-aa9be2065576" :question/math-academy-id "e-416"} :knowledge-point/id #uuid "66c5a147-0100-5f4b-a221-25b8674b2115" :knowledge-point/questions [{:db/id #edb/ref 17592186115718} {:db/id #edb/ref 17592186115719} {:db/id #edb/ref 17592186233209} {:db/id #edb/ref 17592186235506} {:db/id #edb/ref 17592186250206} {:db/id #edb/ref 17592186297247} {:db/id #edb/ref 17592186314942} {:db/id #edb/ref 17592186314943} {:db/id #edb/ref 17592186314944}] :knowledge-point/title "Evaluating the Integral of a Sum of Two Functions"} :step/id #uuid "8300db68-e37d-5905-a6e3-75198133f507" :step/math-academy-id 1488}] :activity/title "The Sum and Constant Multiple Rules for Definite Integrals" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186115456}] [{:activity/first-step {:db/id #edb/ref 17592186163156} :activity/id #uuid "4373edc4-1d40-5e9a-bfe9-ecc0845c2651" :activity/scope {:db/id #edb/ref 17592186050835 :topic/id #uuid "6a5936fb-0bab-5b84-a342-e13ec8019ebc" :topic/math-academy-id 3048} :activity/steps [{:db/id #edb/ref 17592186163156 :step/content {:db/id #edb/ref 17592186163365 :tutorial/content "Let $X$ and $Y$ be discrete random variables with supports $S_X$ and $S_Y,$ respectively. We say that $X$ and $Y$ are **independent** if, for all $x\\in S_X$ and $y\\in S_Y,$ we have \n\n$$\nP(X=x, Y=y)=P(X=x)\\cdot P(Y=y).\n$$\n\nMoreover, if $X$ and $Y$ have the joint probability mass function $f(x,y),$ and $f_X(x)$ and $f_Y(y)$ are the marginal mass functions of $X$ and $Y,$ respectively, then\n\n$$\nf(x, y) = f_X(x)\\cdot f_Y (y)\n$$\n\n \n\nfor all $x\\in S_X$ and $y\\in S_Y.$\n\nIf the random variables are not independent, they are **dependent**." :tutorial/id #uuid "ab3a2705-ec4d-5e72-b6dd-553e9cbb6884" :tutorial/math-academy-id 7746 :tutorial/title "Introduction"} :step/id #uuid "b566ab50-5b2d-5693-aaa2-b74aeb985d53" :step/math-academy-id 44847 :step/next {:db/id #edb/ref 17592186163159}} {:db/id #edb/ref 17592186163157 :step/content {:db/id #edb/ref 17592186162153 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161713 :question/id #uuid "1fdcc887-4c52-5d91-ab28-63a7dce9fe5a" :question/math-academy-id "e-12462"} :knowledge-point/id #uuid "196e7d31-5af8-5c82-b2bd-0cf1ed7415e2" :knowledge-point/questions [{:db/id #edb/ref 17592186162343} {:db/id #edb/ref 17592186162388} {:db/id #edb/ref 17592186275114} {:db/id #edb/ref 17592186275115} {:db/id #edb/ref 17592186275116} {:db/id #edb/ref 17592186275117} {:db/id #edb/ref 17592186275118} {:db/id #edb/ref 17592186383466} {:db/id #edb/ref 17592186383473}] :knowledge-point/title "Determining Whether Two Random Variables are Independent Given the Joint PMF Only"} :step/id #uuid "85e8d07f-ff5e-5a08-b15e-b9682157622a" :step/math-academy-id 44848 :step/next {:db/id #edb/ref 17592186163158}} {:db/id #edb/ref 17592186163158 :step/content {:db/id #edb/ref 17592186162154 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161714 :question/id #uuid "4e12d6b6-5771-5e54-8f16-7899f82d90bc" :question/math-academy-id "e-12463"} :knowledge-point/id #uuid "900dcaf8-da39-5654-96cd-6aec89e379c9" :knowledge-point/questions [{:db/id #edb/ref 17592186162304} {:db/id #edb/ref 17592186162305} {:db/id #edb/ref 17592186275113} {:db/id #edb/ref 17592186275221} {:db/id #edb/ref 17592186281557} {:db/id #edb/ref 17592186281558} {:db/id #edb/ref 17592186383459} {:db/id #edb/ref 17592186383582} {:db/id #edb/ref 17592186410436}] :knowledge-point/title "Calculating Joint Probabilities"} :step/id #uuid "3bf9c7bd-4281-5c38-aa27-271d95010465" :step/math-academy-id 44851} {:db/id #edb/ref 17592186163159 :step/content {:db/id #edb/ref 17592186162155 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161715 :question/id #uuid "1875d098-95f6-50a7-b069-56865207b3dc" :question/math-academy-id "e-12464"} :knowledge-point/id #uuid "35de7257-8d35-5f81-89be-c7faa73d6bc3" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048325} {:db/id #edb/ref 17592186048945}] :knowledge-point/questions [{:db/id #edb/ref 17592186162457} {:db/id #edb/ref 17592186162458} {:db/id #edb/ref 17592186281533} {:db/id #edb/ref 17592186281553} {:db/id #edb/ref 17592186281683} {:db/id #edb/ref 17592186284383}] :knowledge-point/title "Determining Whether Two Random Variables are Independent"} :step/id #uuid "b0b7073a-7020-52ef-b9e8-f169d03cd0f4" :step/math-academy-id 44854 :step/next {:db/id #edb/ref 17592186163157}}] :activity/title "Independence of Discrete Random Variables" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186162186}] [{:activity/first-step {:db/id #edb/ref 17592186163160} :activity/id #uuid "fc8ae5eb-5ab5-597c-afc2-a92953484868" :activity/scope {:db/id #edb/ref 17592186051075 :topic/id #uuid "7ef16e52-fe9f-5d49-a45f-2293e652f044" :topic/math-academy-id 3036} :activity/steps [{:db/id #edb/ref 17592186163160 :step/content {:db/id #edb/ref 17592186163369 :tutorial/content "In this lesson, we will learn about the **supremum** of a set.\n\nTo get started, we first need to understand a related concept: the **upper bounds** of a set.\n\nGiven a set $A$, a number $x$ is called an upper bound for $A$ if every element of $A$ is smaller than or equal to $x$.\nAlternatively, $x$ is greater than or equal to every element of $A$.\n\nFor example, consider\n\n$$\nA = \\{1,2,3\\}\\subseteq \\mathbb R\n$$\n\nIn this case, any number\n\n$$\nx\\geq 3\n$$\n\nis an upper bound of $A$, since it is greater than or equal to $1, 2$, and $3$.\nSo, $[3, \\infty)$ is the set of upper bounds of $A$.\n\nWe will denote the set of the upper bounds of $A$ as $U_A$.\n\nWe can now proceed with the definition of **supremum**.\n\nFor a set $A$ that is bounded above, the supremum of $A$ is the minimum of $U_A$. It is also called the **least upper bound** of $A$.\n\nIn our example\n\n$$\nA = \\{1,2,3\\}\n$$\n\nwe have\n\n$$\n\\min(U_A) = \\min [3, \\infty) = 3\n$$\n\nThus,\n\n$$\n\\sup(A) = 3\n$$\n\nNotice that, when a set has a maximum, the supremum equals the maximum. This holds, in particular, for non-empty finite sets.\n\nThis leads to the following result:\n\n> For any non-empty finite set, $\\max(A) = \\sup(A)$" :tutorial/id #uuid "ca59d62a-e7c7-5a90-b351-f1caf0f39ac0" :tutorial/math-academy-id 9405 :tutorial/title "Introduction"} :step/id #uuid "c153f719-0723-5000-ab9b-87cfd2f9bbb3" :step/math-academy-id 629493 :step/next {:db/id #edb/ref 17592186163161}} {:db/id #edb/ref 17592186163161 :step/content {:db/id #edb/ref 17592186163203 :tutorial/content "Just as we defined the supremum, we now introduce the **infimum** of a set.\n\nAs we did for the supremum, we first need to define the lower bounds of a set.\n\nGiven a set $A$, a number $x$ is called a **lower bound** for $A$ if every element of $A$ is greater than or equal to $x$, or, alternatively, if $x$ is less than or equal to every element of $A$.\n\nFor example, for\n\n$$\nA=\\{1,2,3\\}\\subseteq \\mathbb R\n$$\n\nany number\n\n$$\nx \\leq 1\n$$\n\nis less than $1$, $2$, and $3$. Therefore, $(-\\infty, 1]$ is the set of lower bounds of $A$.\n\nWe will denote the set of the lower bounds of $A$ as $L_A$.\n\nThe infimum of a set $A$ is the maximum of $L_A$, or the greatest lower bound of $A$.\n\nFor our set\n\n$$\nA = \\{1,2,3\\}\n$$\n\nwe have\n\n$$\n\\max(L_A) = \\max (-\\infty, 1] = 1\n$$\n\nThus,\n\n$$\n\\inf(A) = 1\n$$\n\nAgain, we notice that the minimum of a set (provided that it exists) equals the infimum. As finite sets always have a minimum, this holds in particular for finite sets:\n\n> For any finite set, $\\min(A) = \\inf(A)$" :tutorial/id #uuid "51b90880-5036-599d-96af-8a4c20add3ee" :tutorial/math-academy-id 10844 :tutorial/title "Infimum"} :step/id #uuid "783f0d37-8fa2-5e94-a643-c928a45a5266" :step/math-academy-id 629494 :step/next {:db/id #edb/ref 17592186163162}} {:db/id #edb/ref 17592186163162 :step/content {:db/id #edb/ref 17592186162156 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161741 :question/id #uuid "80eb38f0-092a-54fc-873c-6ab7b6be5307" :question/math-academy-id "e-16535"} :knowledge-point/id #uuid "f950f3da-81c2-574a-b7f7-06d88945c249" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049900}] :knowledge-point/questions [{:db/id #edb/ref 17592186162525} {:db/id #edb/ref 17592186162529}] :knowledge-point/title "Supremum and Infimum of a Finite Set"} :step/id #uuid "49b1de3d-7a36-5ac7-a8b3-9f98c01634c2" :step/math-academy-id 629495 :step/next {:db/id #edb/ref 17592186163163}} {:db/id #edb/ref 17592186163163 :step/content {:db/id #edb/ref 17592186163200 :tutorial/content "Let's explore the supremum and infimum of intervals, starting with a closed interval.\n\n**Example A:** $A = [0, 1]$.\n\n**Observation (Min/Max):**\nRecall that if a set has a minimum and maximum, they correspond to the infimum and supremum.\nSince $0$ and $1$ are bounds contained in $A$, we have $\\min(A)=0$ and $\\max(A)=1$. Thus, we expect:\n\n$$\n\\inf (A) = 0, \\qquad \\sup (A) = 1\n$$\n\n**Derivation using Sets of Bounds:**\nTo deepen our understanding, we verify this by finding the sets of lower and upper bounds ($L_A$ and $U_A$).\n\n1. **Infimum:** We identify $L_A$ and find its maximum.Any number $x \\leq 0$ is a lower bound for $A$.Any number $x > 0$ is *not* a lower bound. Since $0 \\in A$ and $0 < x$, the number $x$ fails to be a lower bound.Therefore, $L_A = (-\\infty, 0]$ and $\\inf (A) = \\max (-\\infty, 0] = \\bbox[4pt,border: 1px solid lightgray]{0}$.\n2. **Supremum:** We identify $U_A$ and find its minimum.Any number $x \\geq 1$ is an upper bound for $A$.Any number $x < 1$ is *not* an upper bound. Since $1 \\in A$ and $1 > x$, the number $x$ fails to be an upper bound.Therefore, $U_A = [1, \\infty)$ and $\\sup (A) = \\min [1, \\infty) = \\bbox[4pt,border: 1px solid lightgray]{1}$." :tutorial/id #uuid "46a24733-634e-584e-8d69-01df206cfe24" :tutorial/math-academy-id 10841 :tutorial/title "Supremum and Infimum of a Closed Interval"} :step/id #uuid "c1a27dbd-9e07-56e1-9495-5799582ca8d5" :step/math-academy-id 629498 :step/next {:db/id #edb/ref 17592186163164}} {:db/id #edb/ref 17592186163164 :step/content {:db/id #edb/ref 17592186163210 :tutorial/content "We now consider intervals where the endpoints are not necessarily included.\n\n**Example B:** $B = (0, 1)$.\nThe endpoints $0$ and $1$ are not in $B$, so the set has **neither a maximum nor a minimum.**\n\nHowever, the logical boundaries of the set remain the same.\n\n- The set of lower bounds is $L_B = (-\\infty, 0]$.\n$\\inf (B) = \\max (-\\infty, 0] = \\bbox[4pt,border: 1px solid lightgray]{0}$.\n- The set of upper bounds is $U_B = [1, \\infty)$.\n$\\sup (B) = \\min [1, \\infty) = \\bbox[4pt,border: 1px solid lightgray]{1}$." :tutorial/id #uuid "63a74372-be0b-55ee-88cf-ba10236de365" :tutorial/math-academy-id 14945 :tutorial/title "Supremum and Infimum of an Open Interval"} :step/id #uuid "14b7a7db-76cd-51a1-9831-3d3d23c70db6" :step/math-academy-id 629499 :step/next {:db/id #edb/ref 17592186163165}} {:db/id #edb/ref 17592186163165 :step/content {:db/id #edb/ref 17592186163211 :tutorial/content "We continue by considering a half-open interval.\n\n**Example C:** $C = [0, 1)$.\nHere, the inclusion is mixed.\n\n- **Lower Bound:** $L_C = (-\\infty, 0]$.\n$\\inf (C) = \\bbox[4pt,border: 1px solid lightgray]{0}$\nSince $0 \\in C$, it is also the **minimum.**\n- **Upper Bound:** $U_C = [1, \\infty)$.\n$\\sup (C) = \\bbox[4pt,border: 1px solid lightgray]{1}$\nSince $1 \\notin C$, the set has **no maximum.**" :tutorial/id #uuid "e886348b-6c7d-5c56-9ba6-8f18d48237e6" :tutorial/math-academy-id 14953 :tutorial/title "Supremum and Infimum of a Half-Open Interval"} :step/id #uuid "1be05391-d776-53e2-94a9-17169863be6e" :step/math-academy-id 629500 :step/next {:db/id #edb/ref 17592186163166}} {:db/id #edb/ref 17592186163166 :step/content {:db/id #edb/ref 17592186163209 :tutorial/content "So far, we have dealt with bounded sets: sets that have both upper and lower bounds. Now, we consider unbounded sets.\n\nIf a set $A$ is unbounded above, then it has no upper bounds. In this case, we write\n\n$$\n\\sup(A) = +\\infty\n$$\n\nSimilarly, if a set $A$ is unbounded below, then it has no lower bounds. In this case, we write\n\n$$\n\\inf(A) = -\\infty\n$$\n\nFor example, consider the set\n\n$$\nA = (1, \\infty)\n$$\n\nThis set is unbounded above, so\n\n$$\n\\sup(A) = +\\infty\n$$\n\nHowever, $A$ is bounded below, and\n\n$$\n\\inf(A) = 1\n$$" :tutorial/id #uuid "205608a0-b120-56a1-b2c9-f33f2540e0b1" :tutorial/math-academy-id 14797 :tutorial/title "Unbounded Sets"} :step/id #uuid "340b9ca0-497a-5086-82a9-e785a2e094e9" :step/math-academy-id 629501 :step/next {:db/id #edb/ref 17592186163167}} {:db/id #edb/ref 17592186163167 :step/content {:db/id #edb/ref 17592186162157 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161742 :question/id #uuid "a6b8b164-5249-58e0-a701-b6e6151c1881" :question/math-academy-id "e-16536"} :knowledge-point/id #uuid "fee0e08c-5a7a-5f78-83aa-39679bb3b17b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049162} {:db/id #edb/ref 17592186050301}] :knowledge-point/questions [{:db/id #edb/ref 17592186162528} {:db/id #edb/ref 17592186162552}] :knowledge-point/title "Supremum and Infimum of an Interval"} :step/id #uuid "99437115-10cd-5290-aee8-0bbc4fa42ca2" :step/math-academy-id 629502 :step/next {:db/id #edb/ref 17592186163168}} {:db/id #edb/ref 17592186163168 :step/content {:db/id #edb/ref 17592186163201 :tutorial/content "Consider the following set.\n\n$$\nA = \\left\\{\\left(\\dfrac 12\\right)^n \\:: \\: n\\in \\mathbb N \\right\\}\n$$\n\nThe elements of $A$ are the terms of the sequence $a_n$, given by\n\n$$\na_n =\\left(\\dfrac 12\\right)^n, \\qquad n \\in \\mathbb N = \\{1,2,3,4,\\ldots\\}\n$$\n\nLet's draw some points of our sequence on the real line:\n\n![](images/bb/bb46c2cd565e33b9da6e6ef1496a0726212ebc18a425b915d3ef0d2acacef058.png)\n\nNotice that $a_n$ is a decreasing sequence. Therefore, the first term $a_1$ is the maximum of the set. Since $A$ has a maximum, the supremum equals the maximum:\n\n$$\n\\sup(A) = \\max(A) = a_1 = \\dfrac 12\n$$\n\nNow, our set doesn't have a minimum: the points of the sequence get closer and closer to $0$ without reaching it. Let's find the infimum by determining the set of the lower bounds.\n\nNotice that:\n\n- any number $x \\leq 0$ is a lower bound of $A$,\n- any number $x > 0$ is **not** a lower bound of $A$. In other words, we can always find a sufficiently large $n$ so that $\\left(\\dfrac 12\\right)^n$ is smaller than $x$ for any $x > 0$.\n\nTherefore, $(-\\infty, 0]$ is the set of lower bounds of $A$, and\n\n$$\n\\inf(A) = \\max \\big({-\\infty}, 0\\big] = 0\n$$" :tutorial/id #uuid "90180d58-a7d9-562b-91a3-cccac21bfc91" :tutorial/math-academy-id 10842 :tutorial/title "Sequences"} :step/id #uuid "1a3ee896-b5b1-59d9-a79e-d3371f921784" :step/math-academy-id 629506 :step/next {:db/id #edb/ref 17592186163169}} {:db/id #edb/ref 17592186163169 :step/content {:db/id #edb/ref 17592186162158 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161743 :question/id #uuid "ed21dea5-5c8b-5193-8fe9-4f1105410843" :question/math-academy-id "e-16537"} :knowledge-point/id #uuid "ffe2b2c0-23a0-5bd0-8bc7-c12139820b61" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049983} {:db/id #edb/ref 17592186050155}] :knowledge-point/questions [{:db/id #edb/ref 17592186162526} {:db/id #edb/ref 17592186162530}] :knowledge-point/title "Supremum and Infimum of a Sequence"} :step/id #uuid "a141f9b7-44be-5ea4-b45f-327b33819ac6" :step/math-academy-id 629507 :step/next {:db/id #edb/ref 17592186163170}} {:db/id #edb/ref 17592186163170 :step/content {:db/id #edb/ref 17592186163202 :tutorial/content "The concepts of supremum and infimum can be extended to functions.\n\nGiven a function $y=f(x)$, the **supremum** and the **infimum** of $f$ are, respectively, the supremum and the infimum of the range of $f$.\n\nThe **supremum** and **infimum** of a function will be denoted as\n$\\inf_{x\\in D} f(x), \\qquad \\text{and} \\sup_{x\\in D} f(x)$,\nwhere $D$ is the domain of the function.\n\nFor example, consider the following parabola:\n\n![](images/69/690b179ad127181eeb316fb9ae9c8085fa6aa96c6d4729c88d176a908950e80e.png)\n\nThe range of $f$ is\n\n$$\nA = (-\\infty, 0]\n$$\n\nLet's find the infimum and the supremum of $A$.\n\nTo find the infimum, we must find the set containing **all** lower bounds of $A$ (i.e., the set of lower bounds) and take the maximum of this set.\n\nIn our case, $A$ has no lower bounds. For any real number $y$, we can find an element $x$ such that $f(x) < y$.\n\nTherefore,\n\n$$\n\\inf_{x\\in \\mathbb R} f(x) = -\\infty\n$$\n\nNext, to find the supremum, we must find the set containing **all** upper bounds of $A$ (i.e., the set of upper bounds) and take the minimum of this set.\n\nSo, in our case, we have that\n\n- any number $y \\geq 0$ is an upper bound of $A$,\n- any number $y < 0$ cannot be an upper bound of $A$ because $0$, an element of $A$, is greater than $y$.\n\nTherefore, $[0,\\infty)$ is the set of upper bounds of $A$, and\n\n$$\n\\bbox[4pt,border: 1px solid lightgray]{\\sup_{x\\in \\mathbb R} f(x) = \\sup(A) =\\min[0,\\infty)= 0.}\n$$" :tutorial/id #uuid "73cabff4-8bcc-5e0c-a0c6-0c53136c1ba0" :tutorial/math-academy-id 10843 :tutorial/title "Functions"} :step/id #uuid "adb9b1a3-d36f-56f5-aed4-25013ca7485d" :step/math-academy-id 629510 :step/next {:db/id #edb/ref 17592186163171}} {:db/id #edb/ref 17592186163171 :step/content {:db/id #edb/ref 17592186162159 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161744 :question/id #uuid "1a3afebe-554b-51c5-833c-431bbd669e91" :question/math-academy-id "e-16538"} :knowledge-point/id #uuid "4649783b-3436-55a5-b779-1ca3de17c535" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049707} {:db/id #edb/ref 17592186050580}] :knowledge-point/questions [{:db/id #edb/ref 17592186162531} {:db/id #edb/ref 17592186162532} {:db/id #edb/ref 17592186410429}] :knowledge-point/title "Supremum and Infimum of a Function"} :step/id #uuid "ce6cca22-43d2-5f35-a1c3-e7ab58514145" :step/math-academy-id 629511 :step/next {:db/id #edb/ref 17592186163172}} {:db/id #edb/ref 17592186163172 :step/content {:db/id #edb/ref 17592186163370 :tutorial/content "**Theorem.** Suppose $A\\subseteq \\mathbb R$ is a non-empty set and $s$ is an upper bound of $A$. Then $s = \\sup A$ if and only if for all $\\varepsilon > 0$ there exists $a\\in A$ such that\n$s - \\varepsilon < a$.\n\n- **First, we prove that if $s = \\sup A$ then for all $\\varepsilon > 0$ there exists $a\\in A$ such that $s - \\varepsilon < a$.**By contradiction, suppose that there exists some $\\varepsilon > 0$ such that there does not exist any $a\\in A$ with $s - \\varepsilon < a$. Then, every element of $A$ is less than or equal to $s - \\varepsilon$. This implies that $s - \\varepsilon$ is an upper bound of $A$.Since $s$ is the least upper bound, we must have $s \\le s - \\varepsilon$. However, since $\\varepsilon > 0$, we know that $s - \\varepsilon < s$. This is a contradiction.\n- **Next, we prove that if for all $\\varepsilon > 0$ there exists $a\\in A$ such that $s - \\varepsilon < a$, then $s = \\sup A$.**Again, by contradiction, assume $s \\neq \\sup A$. Since $s$ is an upper bound of $A$, the least upper bound must be strictly smaller than $s$. Let $s_1 = \\sup A$, so $s_1 < s$. Let $\\varepsilon_1 = s - s_1$. Since $s_1 < s$, we have $\\varepsilon_1 > 0$.\nWe can apply the property stated in the hypothesis to our $\\varepsilon_1$. So, there exists $a_1 \\in A$ such that\n$s - \\varepsilon_1 < a_1$.\nSubstituting $\\varepsilon_1 = s - s_1$, we get $s - (s - s_1) < a_1$, which simplifies to\n$s_1 < a_1$.\nSince $s_1$ is an upper bound of $A$, we must have $a_1 \\le s_1$. This contradicts $s_1 < a_1$. Thus, $s = \\sup A$." :tutorial/id #uuid "cced0110-6687-5d41-b7d0-e650638b956e" :tutorial/math-academy-id 9407 :tutorial/title "An Important Lemma"} :step/id #uuid "34608cbd-8d66-523a-92fa-79ddb1f72cba" :step/math-academy-id 629514 :step/next {:db/id #edb/ref 17592186163173}} {:db/id #edb/ref 17592186163173 :step/content {:db/id #edb/ref 17592186163204 :tutorial/content "In this lesson, we defined the infimum of a set as the maximum of the set of lower bounds, and the supremum as the minimum of the set of upper bounds.\n\nIf a set of real numbers is bounded and not empty, then the infimum exists and is a real number, and the supremum exists and is a real number.\n\nThis follows from the so-called **axiom of completeness**, a fundamental property of the real numbers that ensures that the real number line has no \"gaps.\"\n\nThere are number sets, such as the set of rational numbers, that don't have this property. Consider for example the following subset of $\\mathbb Q{:}$\n\n$$\nA = \\{q \\in \\mathbb Q \\,: \\, 1 < q^2 < 2 \\}\n$$\n\nNotice that the rational numbers greater than $\\sqrt 2$ are the upper bounds of $A$. However, this set has no minimum *in $\\mathbb{Q}$*, so $\\sup(A)$ doesn't exist." :tutorial/id #uuid "22748d4c-0a29-59d0-ace0-00f9cea6dd28" :tutorial/math-academy-id 10853 :tutorial/title "The Completeness Axiom"} :step/id #uuid "8e86da46-eeeb-505c-861c-4485b44013f4" :step/math-academy-id 629515}] :activity/title "Supremum and Infimum" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186162184}] [{:activity/first-step {:db/id #edb/ref 17592186129910} :activity/id #uuid "4d339a6a-8559-5175-8572-cf929b41a1ee" :activity/scope {:db/id #edb/ref 17592186051076 :topic/id #uuid "7ef40719-b08d-55b6-b171-8b9bfe562c09" :topic/math-academy-id 2006} :activity/steps [{:db/id #edb/ref 17592186129910 :step/content {:db/id #edb/ref 17592186130331 :tutorial/content "Polynomial, rational, power, radical, exponential, logarithmic, and trigonometric functions are all continuous at every point in their respective domains. Therefore, to work out where any of these types of functions are continuous, we just need to work out what the domain is.\n\nFor example, the polynomial $f(x) = 3x^3-2x^2-1$ defined for all real numbers $x.$ Therefore, it is continuous on the interval $(-\\infty, \\infty).$\n\nOn the other hand, the radical function $g(x) = \\sqrt{x}$ is defined for all numbers $x \\geq 0.$ Therefore, it is continuous on the interval $[0,\\infty).$" :tutorial/id #uuid "0df60318-c501-5ae0-a9d7-b2aa36203e90" :tutorial/math-academy-id 2601 :tutorial/title "Introduction"} :step/id #uuid "799ba962-dfd1-5401-a504-65ceb6297660" :step/math-academy-id 12129 :step/next {:db/id #edb/ref 17592186129911}} {:db/id #edb/ref 17592186129911 :step/content {:db/id #edb/ref 17592186129093 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128907 :question/id #uuid "df4f2e74-d645-5593-8b4a-9dd311c9638e" :question/math-academy-id "e-3597"} :knowledge-point/id #uuid "195aa6d7-fbb5-5b8f-8c0f-0df7a844ad59" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048176} {:db/id #edb/ref 17592186050642}] :knowledge-point/questions [{:db/id #edb/ref 17592186129808} {:db/id #edb/ref 17592186129811} {:db/id #edb/ref 17592186241056} {:db/id #edb/ref 17592186241057} {:db/id #edb/ref 17592186314900} {:db/id #edb/ref 17592186345172} {:db/id #edb/ref 17592186345173}] :knowledge-point/title "Finding the Intervals on Which a Radical Function Is Continuous"} :step/id #uuid "fb530867-3da3-572c-a4fa-c110ef89ae1f" :step/math-academy-id 12131 :step/next {:db/id #edb/ref 17592186129912}} {:db/id #edb/ref 17592186129912 :step/content {:db/id #edb/ref 17592186129094 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128908 :question/id #uuid "13d99b42-2152-5484-b0c3-68fcb8917b85" :question/math-academy-id "e-3598"} :knowledge-point/id #uuid "eac988ba-ea97-52c7-90a7-d451ee7f49e5" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048163}] :knowledge-point/questions [{:db/id #edb/ref 17592186129809} {:db/id #edb/ref 17592186129810} {:db/id #edb/ref 17592186241060} {:db/id #edb/ref 17592186241061} {:db/id #edb/ref 17592186297284} {:db/id #edb/ref 17592186314903} {:db/id #edb/ref 17592186326721} {:db/id #edb/ref 17592186326722} {:db/id #edb/ref 17592186329766} {:db/id #edb/ref 17592186345174}] :knowledge-point/title "Finding the Intervals on Which a Rational Function Is Continuous"} :step/id #uuid "73ca7d4b-a0fe-54e9-bd65-d0d79e97725f" :step/math-academy-id 12132 :step/next {:db/id #edb/ref 17592186129913}} {:db/id #edb/ref 17592186129913 :step/content {:db/id #edb/ref 17592186129095 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128909 :question/id #uuid "98c2146d-2e1f-5acc-9774-75aa200cfacb" :question/math-academy-id "e-3599"} :knowledge-point/id #uuid "0c9958ee-c8b0-5d33-8755-e61cb445b0de" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049984}] :knowledge-point/questions [{:db/id #edb/ref 17592186129735} {:db/id #edb/ref 17592186129807} {:db/id #edb/ref 17592186241062} {:db/id #edb/ref 17592186241064} {:db/id #edb/ref 17592186314905} {:db/id #edb/ref 17592186314