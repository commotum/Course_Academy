186233116} {:db/id #edb/ref 17592186233117} {:db/id #edb/ref 17592186234143} {:db/id #edb/ref 17592186244142} {:db/id #edb/ref 17592186244148} {:db/id #edb/ref 17592186244149} {:db/id #edb/ref 17592186339074} {:db/id #edb/ref 17592186339075} {:db/id #edb/ref 17592186339079} {:db/id #edb/ref 17592186339080} {:db/id #edb/ref 17592186339081}] :knowledge-point/title "Finding the Derivative of a Function Given in Implicit Form Using the Product Rule"} :step/id #uuid "dce98779-99bc-5774-beef-a23e45a94a72" :step/math-academy-id 22699 :step/next {:db/id #edb/ref 17592186055903}} {:db/id #edb/ref 17592186055901 :step/content {:db/id #edb/ref 17592186055989 :tutorial/content "Functions are usually given in the form ![](images/44/44c838deb3fa8e3182fbd9d4a03f964dc2731730559d00328190e9259bf01762.svg) where ![](images/1d/1d9b846cface9f9348e4081a0dd87dd254bf26663c12aa0d1a15aa24d2393261.svg) is explicitly written as a function of ![](images/cf/cff7b257e3c71ec70dc7cd273bdd1cced4254993a43cffbfc338460c21bc7319.svg) However, they can also be written in **implicit** form, like\n![](images/82/82728d8a7de8d66f1952d6404473ba2e8130c13c9536b2d335b05684c9e9b382.svg)\n\nWhen a function is given in implicit form, we can differentiate it using the method of **implicit differentiation**, which consists of the following two steps:\n\n**Step 1**: Differentiate both sides of the equation with respect to ![](images/cf/cff7b257e3c71ec70dc7cd273bdd1cced4254993a43cffbfc338460c21bc7319.svg)\n\nWe need to remember that ![](images/1d/1d9b846cface9f9348e4081a0dd87dd254bf26663c12aa0d1a15aa24d2393261.svg) *is a function of* ![](images/5a/5aac2c81021f3f9e468e7840c5f95ece35c10b894bdae19ec1d247bdeb47ac6f.svg) i.e., ![](images/6f/6f3c9a64baef025798baeebc2d92c4361ec210293ebf0b0b5c64055541a50ae3.svg) So, we apply the chain rule:\n![](images/7d/7d48f6e8d69bab060f3e0a41927e97481d0a8f05b424b8bdb5639dfcc58fbc76.svg)\n\n**Step 2**: Solve the equation for ![](images/c7/c7244a31f756199a29c0e7e755eccdf9274346e643e0856566469b35a207e53a.svg)\n![](images/80/80fd42d93eb7ab2cce44347268e404853f4cf507896d8097af70a92323962377.svg)\n\nSo, the derivative of ![](images/1d/1d9b846cface9f9348e4081a0dd87dd254bf26663c12aa0d1a15aa24d2393261.svg) is ![](images/42/420cc2cbdc995a548ee077e5547ca1522bd2c1cdbbd31f304a4466497acacb5c.svg)" :tutorial/id #uuid "4f8a0764-c99e-5be6-8b49-3ca28725caf9" :tutorial/math-academy-id 433 :tutorial/title "Introduction"} :step/id #uuid "47c11c73-2f53-5115-996d-e1dca896a32a" :step/math-academy-id 806 :step/next {:db/id #edb/ref 17592186055902}} {:db/id #edb/ref 17592186055902 :step/content {:db/id #edb/ref 17592186054845 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054503 :question/id #uuid "59d2e907-e788-5a22-93a9-c49ff94df6ca" :question/math-academy-id "e-190"} :knowledge-point/id #uuid "9bf25f86-6b27-5eaa-b1a1-1104478b290a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048274} {:db/id #edb/ref 17592186049332} {:db/id #edb/ref 17592186050271} {:db/id #edb/ref 17592186050789} {:db/id #edb/ref 17592186051084}] :knowledge-point/questions [{:db/id #edb/ref 17592186055138} {:db/id #edb/ref 17592186055139} {:db/id #edb/ref 17592186233645} {:db/id #edb/ref 17592186233647} {:db/id #edb/ref 17592186244127} {:db/id #edb/ref 17592186244140} {:db/id #edb/ref 17592186244141} {:db/id #edb/ref 17592186290442} {:db/id #edb/ref 17592186290443}] :knowledge-point/title "Finding the Derivative of a Function Given in Implicit Form"} :step/id #uuid "df7753ed-cc52-5fcd-b5cf-d0d376cf15e6" :step/math-academy-id 807 :step/next {:db/id #edb/ref 17592186055638}} {:db/id #edb/ref 17592186055903 :step/content {:db/id #edb/ref 17592186054846 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054504 :question/id #uuid "8a6eb51f-6232-5a08-acf1-136f0d14a4d9" :question/math-academy-id "e-191"} :knowledge-point/id #uuid "2311a895-587e-5609-8a9f-9963b8cae372" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050711}] :knowledge-point/questions [{:db/id #edb/ref 17592186055013} {:db/id #edb/ref 17592186055366} {:db/id #edb/ref 17592186233118} {:db/id #edb/ref 17592186233500} {:db/id #edb/ref 17592186233920} {:db/id #edb/ref 17592186233921} {:db/id #edb/ref 17592186244152} {:db/id #edb/ref 17592186244153} {:db/id #edb/ref 17592186244239} {:db/id #edb/ref 17592186297333} {:db/id #edb/ref 17592186317187} {:db/id #edb/ref 17592186317188} {:db/id #edb/ref 17592186317239} {:db/id #edb/ref 17592186332898} {:db/id #edb/ref 17592186332899}] :knowledge-point/title "Finding the Slope of the Tangent Line to a Curve Given in Implicit Form at a Point"} :step/id #uuid "ae453d7c-abe1-5c23-af16-160d6d1d7d2a" :step/math-academy-id 810 :step/next {:db/id #edb/ref 17592186055904}} {:db/id #edb/ref 17592186055904 :step/content {:db/id #edb/ref 17592186054847 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054505 :question/id #uuid "cd630daa-4813-5ca8-b3d4-5fe35c4af4fa" :question/math-academy-id "e-192"} :knowledge-point/id #uuid "dfdb93d1-d550-5939-8a47-99bd1d863a8c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049119}] :knowledge-point/questions [{:db/id #edb/ref 17592186055014} {:db/id #edb/ref 17592186055017} {:db/id #edb/ref 17592186233501} {:db/id #edb/ref 17592186233502} {:db/id #edb/ref 17592186233931} {:db/id #edb/ref 17592186234142} {:db/id #edb/ref 17592186275167} {:db/id #edb/ref 17592186275262} {:db/id #edb/ref 17592186317240} {:db/id #edb/ref 17592186317241} {:db/id #edb/ref 17592186317253} {:db/id #edb/ref 17592186317254} {:db/id #edb/ref 17592186317273} {:db/id #edb/ref 17592186332901}] :knowledge-point/title "Determining an Intercept of a Tangent or Normal Line to a Curve Given in Implicit Form"} :step/id #uuid "73b8ac60-1c84-5c86-a80d-cef53c382fb9" :step/math-academy-id 814 :step/next {:db/id #edb/ref 17592186055635}}] :activity/title "Implicit Differentiation" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186054912}] [{:activity/first-step {:db/id #edb/ref 17592186079363} :activity/id #uuid "a97252e8-f2e3-56af-a563-f945a05bf97f" :activity/scope {:db/id #edb/ref 17592186049803 :topic/id #uuid "15363df8-84f0-5d8e-be74-122c5c580d0e" :topic/math-academy-id 672} :activity/steps [{:db/id #edb/ref 17592186079363 :step/content {:db/id #edb/ref 17592186079730 :tutorial/content "In addition to using the formula\n\n$$\n\\begin{aligned}\na_{n} &= a_{1} + (n - 1)d\n\\end{aligned}\n$$\n\nto compute the terms of an arithmetic sequence, we can also use it to compute the **index** of a particular term. The index of a term is simply the value of $n$ corresponding to that term.\n\nTo illustrate, suppose we're given the following arithmetic sequence:\n\n$$\n1, \\: 4, \\: 7, \\: 10, \\ \\ldots, \\: 28, \\: \\ldots\n$$\n\nIf the first term is $1$, the second term is $4$, the third term is $7$, and so on, then what term gives the value $28$? In other words, what value of $n$ gives $a_n=28$?\n\nSince $a_1=1$ and $d=3$, we can construct the formula for the $n$th term as follows:\n\n$$\n\\begin{aligned}\na_{n} &= a_{1} + (n - 1)d \\\\\n&= 1 + (n - 1)(3) \\\\\n&= 1 + 3n - 3 \\\\\n&= 3n - 2\n\\end{aligned}\n$$\n\nNow we can solve for the value of $n$ that gives $a_n=28$, as follows:\n\n$$\n\\begin{aligned}\na_{n} &= 3n - 2 \\\\\n28 &= 3n - 2 \\\\\n30 &= 3n \\\\\n10 &= n\n\\end{aligned}\n$$\n\nTherefore, $28$ is the $10$th term of the sequence." :tutorial/id #uuid "ea5fca63-4618-5148-9355-8de0ed7707db" :tutorial/math-academy-id 8915 :tutorial/title "Introduction"} :step/id #uuid "de017b4d-d30f-53a6-907e-76f2041922d8" :step/math-academy-id 192027 :step/next {:db/id #edb/ref 17592186079364}} {:db/id #edb/ref 17592186079364 :step/content {:db/id #edb/ref 17592186078468 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078187 :question/id #uuid "eec455b0-98ff-59a5-b552-3381fb893fd2" :question/math-academy-id "e-14392"} :knowledge-point/id #uuid "1d905f41-5940-547e-b3d2-558c6b881b68" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048673} {:db/id #edb/ref 17592186049504}] :knowledge-point/questions [{:db/id #edb/ref 17592186078806} {:db/id #edb/ref 17592186079066} {:db/id #edb/ref 17592186079074} {:db/id #edb/ref 17592186233119} {:db/id #edb/ref 17592186233654} {:db/id #edb/ref 17592186233655}] :knowledge-point/title "Determining the Index of a Term in an Arithmetic Sequence"} :step/id #uuid "59d284ba-ad7f-51c6-9702-393b4df65edd" :step/math-academy-id 192028 :step/next {:db/id #edb/ref 17592186079365}} {:db/id #edb/ref 17592186079365 :step/content {:db/id #edb/ref 17592186078469 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078188 :question/id #uuid "ff198a0e-d34e-5706-ad74-dbfa20fc3a94" :question/math-academy-id "e-14395"} :knowledge-point/id #uuid "3c61d587-2441-5e8c-8da1-5bd62ff98e1e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049399}] :knowledge-point/questions [{:db/id #edb/ref 17592186078780} {:db/id #edb/ref 17592186079148} {:db/id #edb/ref 17592186234017}] :knowledge-point/title "Determining the Index of a Term Given the Recursive Formula"} :step/id #uuid "86b3cd64-20d2-5c3f-a721-8d1eb42c0252" :step/math-academy-id 192032 :step/next {:db/id #edb/ref 17592186079366}} {:db/id #edb/ref 17592186079366 :step/content {:db/id #edb/ref 17592186078470 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078189 :question/id #uuid "84266116-5a1b-528a-929a-40b5d863e5a5" :question/math-academy-id "e-14397"} :knowledge-point/id #uuid "2bbbc551-e3ff-5cce-a572-e5b89067005a" :knowledge-point/questions [{:db/id #edb/ref 17592186078810} {:db/id #edb/ref 17592186079075}] :knowledge-point/title "Determining the Index of a Term Given Another Term and the Common Difference"} :step/id #uuid "9a20f271-7fe8-5fe6-a484-e4fb2d2becdb" :step/math-academy-id 192035 :step/next {:db/id #edb/ref 17592186079367}} {:db/id #edb/ref 17592186079367 :step/content {:db/id #edb/ref 17592186078471 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078191 :question/id #uuid "5b905b18-5ac3-5a0f-a42f-1d9e53e792cc" :question/math-academy-id "e-14399"} :knowledge-point/id #uuid "d979a7bd-42a1-5d4f-8717-1caa06ce623c" :knowledge-point/questions [{:db/id #edb/ref 17592186078781} {:db/id #edb/ref 17592186079062} {:db/id #edb/ref 17592186233656} {:db/id #edb/ref 17592186234235} {:db/id #edb/ref 17592186234465}] :knowledge-point/title "Determining the Index of a Term Given Two Terms"} :step/id #uuid "365e24e0-7b67-5ec0-b97d-dd778e400ad7" :step/math-academy-id 192038}] :activity/title "Determining Indexes of Terms in Arithmetic Sequences" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186078687}] [{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186060552} :activity/id #uuid "29cf2698-b761-565d-9655-9c36bff61aab" :activity/scope {:db/id #edb/ref 17592186049805 :topic/id #uuid "155403ed-fbfa-59a9-b928-e762a73145ef" :topic/math-academy-id 247} :activity/steps [{:db/id #edb/ref 17592186060552 :step/content {:db/id #edb/ref 17592186060984 :tutorial/content "The conditional statement $A \\Rightarrow B$ is logically equivalent to the disjunction $\\lnot A \\lor B{:}$ \n\n$$\nA \\Rightarrow B \\equiv \\lnot A \\lor B\n$$\n\nWe can verify this by the following truth table:\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\, A \\Rightarrow B \\,$ | $\\, \\neg A \\lor B \\,$ |\n| --- | --- | --- | --- |\n| $\\textrm T$ | $\\textrm T$ | $\\color{blue} \\textrm T$ | $\\color{blue} \\textrm T$ |\n| $\\textrm T$ | $\\textrm F$ | $\\color{blue} \\textrm F$ | $\\color{blue} \\textrm F$ |\n| $\\textrm F$ | $\\textrm T$ | $\\color{blue} \\textrm T$ | $\\color{blue} \\textrm T$ |\n| $\\textrm F$ | $\\textrm F$ | $\\color{blue} \\textrm T$ | $\\color{blue} \\textrm T$ |\n\nIn other words, any conditional statement of the form\n\n$\\qquad$ *if antecedent, then consequent*\n\ncan be expressed equivalently as \n\n$\\qquad$ *not antecedent, or consequent.*\n\nFor example, consider the following conditional statement:\n\n$\\qquad$ *If you do not take your watch, then you will be late for the meeting.* \n\nLet's rewrite this statement using its logically equivalent form. \n\nFirst, we denote the antecedent $A$ and consequent $B$ as follows:  \n\n- $A{:}$ You do not take your watch.\n\n- $B{:}$ You will be late for the meeting.\n\nThen, our initial statement can be written as $A \\Rightarrow B,$ which is logically equivalent to \n\n$$\n\\neg A \\lor B.\n$$\n\nThe negation of $A$ is:\n\n- $\\neg A{:}$ You take your watch.\n\nTherefore, the given statement is logically equivalent to the following:\n\n$\\qquad$ *You take your watch, or you will be late for the meeting.*\n\nWe can write this using more everyday language as follows:\n\n$\\qquad$ *Take your watch, or you will be late for the meeting.*\n\nAnother way to write this is to append the word \"either\" to the beginning of the sentence, like so:\n\n$\\qquad$ *Either you take your watch, or you will be late for the meeting.*\n\nUsing the word \"either\" helps clarify that the sentence structure presents two alternatives and is particularly useful when employing the disjunctive form $(\\lnot A\\lor B)$ in conversational or formal English. So, the phrase effectively conveys that one of the two stated conditions will hold true." :tutorial/id #uuid "6634a172-a5c9-557f-9091-35a4ebd198d3" :tutorial/math-academy-id 7978 :tutorial/title "Introduction"} :step/id #uuid "082980d1-6f7a-54ee-8a3f-6ce0b731dc29" :step/math-academy-id 139680 :step/next {:db/id #edb/ref 17592186060553}} {:db/id #edb/ref 17592186060553 :step/content {:db/id #edb/ref 17592186059687 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059409 :question/id #uuid "48364248-d296-502c-96da-d1905be35627" :question/math-academy-id "e-12707"} :knowledge-point/id #uuid "8b60a8ae-c04f-530a-b89c-f8ac70969d0f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048349} {:db/id #edb/ref 17592186048778} {:db/id #edb/ref 17592186050360}] :knowledge-point/questions [{:db/id #edb/ref 17592186060139} {:db/id #edb/ref 17592186060140} {:db/id #edb/ref 17592186379181} {:db/id #edb/ref 17592186379188} {:db/id #edb/ref 17592186401722} {:db/id #edb/ref 17592186401729} {:db/id #edb/ref 17592186411060} {:db/id #edb/ref 17592186411063}] :knowledge-point/title "Expressing Conditional Statements as Disjunctions"} :step/id #uuid "9889ed7d-e94e-5481-9500-3dcd8edb1f23" :step/math-academy-id 139681 :step/next {:db/id #edb/ref 17592186060554}} {:db/id #edb/ref 17592186060554 :step/content {:db/id #edb/ref 17592186059688 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059425 :question/id #uuid "54512495-0ca8-55a3-834d-0b70f96a5fe7" :question/math-academy-id "e-13231"} :knowledge-point/id #uuid "0936217d-66d2-5360-b88b-a30683720415" :knowledge-point/questions [{:db/id #edb/ref 17592186060149} {:db/id #edb/ref 17592186060150} {:db/id #edb/ref 17592186379154} {:db/id #edb/ref 17592186379260} {:db/id #edb/ref 17592186379267} {:db/id #edb/ref 17592186401736} {:db/id #edb/ref 17592186411059} {:db/id #edb/ref 17592186411062} {:db/id #edb/ref 17592186411064}] :knowledge-point/title "Expressing Disjunctive Statements as Conditionals"} :step/id #uuid "c1808ea7-1187-5229-8eb6-1d0bb6fff501" :step/math-academy-id 139684 :step/next {:db/id #edb/ref 17592186060555}} {:db/id #edb/ref 17592186060555 :step/content {:db/id #edb/ref 17592186059689 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059411 :question/id #uuid "b9a65dc8-528a-5c3c-b518-a2bbecc551c8" :question/math-academy-id "e-12709"} :knowledge-point/id #uuid "0d56b033-a2c8-57c7-adde-e574d726ec78" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048378}] :knowledge-point/questions [{:db/id #edb/ref 17592186060142} {:db/id #edb/ref 17592186060143} {:db/id #edb/ref 17592186378712} {:db/id #edb/ref 17592186379167} {:db/id #edb/ref 17592186379174} {:db/id #edb/ref 17592186389677} {:db/id #edb/ref 17592186409584} {:db/id #edb/ref 17592186409585} {:db/id #edb/ref 17592186411058} {:db/id #edb/ref 17592186411065} {:db/id #edb/ref 17592186411066}] :knowledge-point/title "Rewriting Symbolic Conditional Statements"} :step/id #uuid "34a8f3e2-6b17-513b-bc4e-df73bc766ffa" :step/math-academy-id 139687 :step/next {:db/id #edb/ref 17592186060556}} {:db/id #edb/ref 17592186060556 :step/content {:db/id #edb/ref 17592186059690 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059410 :question/id #uuid "caa49bb8-c66f-56cb-a3d2-a7616abee38c" :question/math-academy-id "e-12708"} :knowledge-point/id #uuid "eec6cf11-74cc-5b3a-b2fe-bd4285fe4a88" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049824} {:db/id #edb/ref 17592186050128}] :knowledge-point/questions [{:db/id #edb/ref 17592186060062} {:db/id #edb/ref 17592186060412} {:db/id #edb/ref 17592186060421} {:db/id #edb/ref 17592186378174} {:db/id #edb/ref 17592186378732} {:db/id #edb/ref 17592186386034} {:db/id #edb/ref 17592186386041} {:db/id #edb/ref 17592186409586} {:db/id #edb/ref 17592186411061}] :knowledge-point/title "Rewriting Conditional Statement Using the Associative, Commutative, and Absorption Laws"} :step/id #uuid "f956015e-ca45-5f2f-8813-7e7f2a215cba" :step/math-academy-id 139690}] :activity/title "Logical Equivalence with Conditional Statements" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186059925}] [{:activity/course {:db/id #edb/ref 17592186046673} :activity/first-step {:db/id #edb/ref 17592186409588} :activity/id #uuid "f39321ff-9db6-52db-bca8-a10eccf4ff9b" :activity/scope {:db/id #edb/ref 17592186049805 :topic/id #uuid "155403ed-fbfa-59a9-b928-e762a73145ef" :topic/math-academy-id 247} :activity/steps [{:db/id #edb/ref 17592186409587 :step/content {:db/id #edb/ref 17592186409584 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "776196c9-cd05-5240-9195-0b0ce27cb444" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186409574} {:answer/id #uuid "8c6f81fa-ef3e-50ce-8cd2-a95e102cf1da" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186409575} {:answer/id #uuid "9ebe90ec-2497-5de0-b5bd-ba3d0c79d56c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186409576} {:answer/id #uuid "cff472a8-e087-557d-80e6-5d535af2d5c5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186409578} {:answer/id #uuid "e1eca4c9-2b1c-5f16-824c-d7eea7cfd316" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186409580}] :answer-field/correct {:db/id #edb/ref 17592186409574} :answer-field/id #uuid "7645b3d9-5bcf-5720-89a4-adc2f8073a1c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186409581}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "1308109d-5efe-51ad-bfa1-4050522344dd" :question/math-academy-id "q-182506" :question/problem "Which of the following statements are true?\n\n- $A⇒¬B≡¬(A∧B)$\n- $¬(A⇒¬B)≡A∧B$\n- $¬(A⇒¬B)≡¬A∧B$" :question/worked-solution "Let's examine each of our statements:\n\n- Statement I is true. Indeed, $A⇒¬B$ is logically equivalent to the disjunction $¬A∨¬B,$ which by De Morgan's law is equivalent to $¬(A∧B).$\n\n- Statement II is true, while statement III is false. From part I, we have the following equivalence:\n\n$$\nA⇒¬B≡¬(A∧B)\n$$\n\nBy negating this statement, we get\n\n$$\n¬(A⇒¬B)≡¬(¬(A∧B)).\n$$\n\nCanceling out double negation, we reach\n\n$$\nA∧B.\n$$\n\nSo, $¬(A⇒¬B)$ is equivalent to $A∧B.$\n\nTherefore, the correct answer is \"I and II only.\""} :step/id #uuid "7e76a699-413c-5c79-9a86-67728b6bb289"} {:db/id #edb/ref 17592186409588 :step/content {:db/id #edb/ref 17592186409586 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "191c421c-bbe9-5286-9beb-03027543bcc3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "B∨¬C" :db/id #edb/ref 17592186409566} {:answer/id #uuid "33e9615f-fd80-5202-949f-ebfef4f3e8b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬B∨C" :db/id #edb/ref 17592186409569} {:answer/id #uuid "35dc661b-8042-5dd9-ae2c-1ddb0493316b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "B∧¬C" :db/id #edb/ref 17592186409570} {:answer/id #uuid "442d26c2-04f3-57d7-adf7-53465469c631" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬B∧C" :db/id #edb/ref 17592186409572} {:answer/id #uuid "4c2b2d55-0e4e-5769-9706-03ec9ecc763c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "B∨C" :db/id #edb/ref 17592186409573}] :answer-field/correct {:db/id #edb/ref 17592186409566} :answer-field/id #uuid "eea492f1-156d-5834-96c0-8454fc274282" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186409583}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c7953127-b916-5d8d-98b4-eeece8a2e1ec" :question/math-academy-id "q-81892" :question/problem "Simplify the statement $(¬B∧C)⇒(B∨¬C).$" :question/worked-solution "First, note that\n\n$$\n(¬B∧C)⇒(B∨¬C)≡¬(¬B∧C)∨(B∨¬C).\n$$\n\nWe can distribute the negation over the disjunction using De Morgan's law:\n\n$$\n¬(¬B∧C)∨(B∨¬C)≡(¬(¬B)∨¬C)∨(B∨¬C)\n$$\n\nCanceling out double negations, we reach\n\n$$\n(¬(¬B)∨¬C)∨(B∨¬C)≡(B∨¬C)∨(B∨¬C).\n$$\n\nFinally, we simplify the disjunction of a statement with itself:\n\n$$\n(B∨¬C)∨(B∨¬C)≡B∨¬C\n$$\n\nSo the given statement is equivalent to $B∨¬C.$"} :step/id #uuid "b1214e01-49e9-573c-a4c8-4d572ee5620a" :step/next {:db/id #edb/ref 17592186409589}} {:db/id #edb/ref 17592186409589 :step/content {:db/id #edb/ref 17592186409585 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b57f374-7974-5938-b11d-cfd731887fe8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬X∨¬Y" :db/id #edb/ref 17592186409567} {:answer/id #uuid "33e6f69b-ceb9-546e-bc81-3a178a362d67" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬Y∨X" :db/id #edb/ref 17592186409568} {:answer/id #uuid "42a65b2d-e5f8-5a76-b55d-46a8613eea7f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬Y∧X" :db/id #edb/ref 17592186409571} {:answer/id #uuid "a433720c-898a-5e82-b529-c83bbf9df930" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬X∧Y" :db/id #edb/ref 17592186409577} {:answer/id #uuid "d0b85a9a-afc4-5057-b50b-a3fabfd591bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬X∨Y" :db/id #edb/ref 17592186409579}] :answer-field/correct {:db/id #edb/ref 17592186409568} :answer-field/id #uuid "bc790e07-5a28-514e-aa55-ed9af585fbba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186409582}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6b7c7494-65e2-5888-808a-8604d9b7cfa1" :question/math-academy-id "q-182492" :question/problem "$Y⇒X\\,≡$" :question/worked-solution "The conditional statement $P⇒Q$ is logically equivalent to the disjunction $¬P∨Q:$\n\nSo, in this case, we have the following equivalence:\n\n$$\nY⇒X\\,≡\\,¬Y∨X\n$$"} :step/id #uuid "ede73126-39fd-544c-9a47-ac55caf10274" :step/next {:db/id #edb/ref 17592186409587}}] :activity/title "Logical Equivalence with Conditional Statements" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186409565}] [{:activity/first-step {:db/id #edb/ref 17592186079282} :activity/id #uuid "5cd5b7c4-6c3f-5140-8338-e68375ee1c35" :activity/scope {:db/id #edb/ref 17592186050153 :topic/id #uuid "3210c88b-5df2-5409-97cd-3a2eb2370ffd" :topic/math-academy-id 665} :activity/steps [{:db/id #edb/ref 17592186079282 :step/content {:db/id #edb/ref 17592186079720 :tutorial/content "Let's think about how to graph the solutions to the following two-variable inequality:\n\n$$\ny \\gt x\n$$\n\nSince this is a two-variable inequality, we must represent its solutions in the $xy$-plane.\n\nWe start by replacing the inequality symbol $(>)$ with an equals sign $(=)$ and plot the resulting line. In this case, we get the line $y=x$.\n\n![](images/34/3497eb8d3f071794cd899c5c62a88500fbcf7b69a34d58171866a078a185bfc9.png)\n\nNotice that we have a \"*greater than*\" $(>)$ inequality. Therefore, we draw a *dashed* line to denote that points on the line are *not* solutions to our inequality.\n\nNow, since we're solving $y > x$, we need to shade all points whose $y$-value is *greater than* its $x$-value. This is given by all of the points that lie *above* our dashed line. So, let's shade these in.\n\n![](images/74/74fef6fbfabb750d09bba12b30f06bc9fd625ef824bdb3388bc66fe03a02c48c.png)\n\nAnd we're done! All of the points in the shaded region satisfy the inequality $y > x$." :tutorial/id #uuid "ce943551-fa59-5976-8896-2c757f4b230a" :tutorial/math-academy-id 8721 :tutorial/title "Introduction"} :step/id #uuid "13f02de4-12fb-5e10-8f77-15e3768daca5" :step/math-academy-id 140701 :step/next {:db/id #edb/ref 17592186079283}} {:db/id #edb/ref 17592186079283 :step/content {:db/id #edb/ref 17592186079721 :tutorial/content "When solving two-variable inequalities, it's often helpful to test to ensure we've shaded the correct region.\n\nTo demonstrate, let's go back to the following inequality:\n\n$$\ny > x\n$$\n\nThe solution to this inequality is indicated by the shaded region below.\n\n![](images/2c/2ceb4ad142fc943e9c5a95c43ba4e3a309669f09d383540fdfcb42f8cb48bf7c.png)\n\nTo check that we've shaded the correct region, we pick a point inside the shaded region and verify that it satisfies the original inequality. Let's pick the point $(0,1)$.\n\n![](images/29/29fc8bba0c205e7aa782fed0bb3cf348d4acc92b806eef60997917ade05905d5.png)\n\nWhen we substitute the coordinates $(0,1)$ into our inequality, we get a true statement:\n\n$$\n\\begin{bmatrix}y & > x \\\\ 1 & > 0✓\\end{bmatrix}\n$$\n\nThis indicates that we have shaded the correct region." :tutorial/id #uuid "a4437a9f-4fe6-5dcf-a771-61bba9e944f1" :tutorial/math-academy-id 8722 :tutorial/title "Testing the Solution"} :step/id #uuid "32db02a0-6340-58c0-9169-33c79dd56e21" :step/math-academy-id 140702 :step/next {:db/id #edb/ref 17592186079284}} {:db/id #edb/ref 17592186079284 :step/content {:db/id #edb/ref 17592186078417 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078173 :question/id #uuid "7d1608fe-29b3-57de-9f32-b7c574b582c3" :question/math-academy-id "e-14035"} :knowledge-point/id #uuid "7ad11090-d67b-5a5b-aaa7-2d9a5841b255" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049716} {:db/id #edb/ref 17592186050361} {:db/id #edb/ref 17592186050519}] :knowledge-point/questions [{:db/id #edb/ref 17592186078733} {:db/id #edb/ref 17592186079153}] :knowledge-point/title "Sketching the Solution to a “Strictly Greater Than” Inequality"} :step/id #uuid "e65855e8-ad54-55a1-bb5a-f11caf0d33ee" :step/math-academy-id 140703 :step/next {:db/id #edb/ref 17592186079285}} {:db/id #edb/ref 17592186079285 :step/content {:db/id #edb/ref 17592186079722 :tutorial/content "Let's now think about how to graph the solutions to the inequality\n\n$$\ny \\lt x\n$$\n\nAs before, we start by replacing the inequality symbol $(\\lt)$ with an equals sign $(=)$ and plot the resulting line $y=x$.\n\n![](images/72/72b217c75c8ec84681212a8ab48614fb777e05e7022ca338897d16763070c816.png)\n\nNotice that we have a \"*less than*\" $(\\lt)$ inequality. Therefore, we draw a *dashed* line.\n\nNow, since we're solving $y \\lt x$, we need to shade all points whose $y$-value is *smaller than* its $x$-value. This is given by all of the points that lie *below* our dashed line.\n\n![](images/f7/f7259181cf578ae89840d42c752b9f36f84862a95dd3b03bc6e5b1aba7870e93.png)\n\nAnd we're done! All of the points in the shaded region satisfy the inequality $y \\lt x$.\n\nTo check that we've shaded the correct region, we pick a point inside the shaded region and check that it satisfies the original inequality. Let's pick the point $(1,0)$.\n\n![](images/e3/e33d6402bfcbc4fad89775c451a0048f09aee83753b790ce9c98e465b3f374e1.png)\n\nWhen we substitute the coordinates $(1,0)$ into our inequality, we get a true statement:\n\n$$\n\\begin{bmatrix}y & < x \\\\ 0 & < 1✓\\end{bmatrix}\n$$\n\nThis indicates that we have shaded the correct region." :tutorial/id #uuid "760096fa-2690-595f-b535-65cec94088a0" :tutorial/math-academy-id 8731 :tutorial/title "Solving \"Strictly Less Than\" Inequalities"} :step/id #uuid "3a3f7a76-f54b-5f7d-a7d3-11dc5d22fc4b" :step/math-academy-id 140706 :step/next {:db/id #edb/ref 17592186079286}} {:db/id #edb/ref 17592186079286 :step/content {:db/id #edb/ref 17592186078418 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078174 :question/id #uuid "2fb1ec62-4417-5e4a-9fe1-23d667875e34" :question/math-academy-id "e-14046"} :knowledge-point/id #uuid "d7e4cee6-c73b-5894-b3f9-531f4cd41c66" :knowledge-point/questions [{:db/id #edb/ref 17592186078717} {:db/id #edb/ref 17592186079141}] :knowledge-point/title "Sketching the Solution to a “Strictly Less Than” Inequality"} :step/id #uuid "b463d728-7e47-511e-bed3-fc9201ebe3ef" :step/math-academy-id 140707 :step/next {:db/id #edb/ref 17592186079287}} {:db/id #edb/ref 17592186079287 :step/content {:db/id #edb/ref 17592186078419 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078175 :question/id #uuid "df46228d-4744-5b2b-9886-8b6010f02a95" :question/math-academy-id "e-14059"} :knowledge-point/id #uuid "5dd738be-308a-54b8-aa4c-7acd6d60b691" :knowledge-point/questions [{:db/id #edb/ref 17592186078773} {:db/id #edb/ref 17592186078784} {:db/id #edb/ref 17592186233750} {:db/id #edb/ref 17592186235492}] :knowledge-point/title "Finding an Inequality Corresponding to a Given Graph"} :step/id #uuid "f0a9fe4e-160d-50d3-98a4-d6661bcfd764" :step/math-academy-id 140710}] :activity/title "Graphing Strict Two-Variable Linear Inequalities" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186078681}] [{:activity/first-step {:db/id #edb/ref 17592186055706} :activity/id #uuid "d981772b-339b-55c1-975c-c5ef7ec6cb31" :activity/scope {:db/id #edb/ref 17592186050291 :topic/id #uuid "3d5ca35e-6400-55ca-b230-0ff03628b370" :topic/math-academy-id 112} :activity/steps [{:db/id #edb/ref 17592186055706 :step/content {:db/id #edb/ref 17592186055959 :tutorial/content "Let's consider the unit circle with a central angle $\\theta$ in the first quadrant, measured in the usual way.\n\n![](images/3d/3d51ca417ba4f6f62bd3e5db5997842d0671f18920a7de70578146a49de79ec3.png)\n\nNotice that\n\n- the $x$-coordinate of $P$ coincides with the cosine of the angle $\\theta$, and\n- the $y$-coordinate coincides with the sine of the angle $\\theta$.\n\nSo, we have\n\n$$\nx = \\cos\\theta, \\qquad y = \\sin\\theta\n$$\n\nConsequently, if we know the angle $\\theta$, we can easily work out the coordinates of the point $P$, and vice-versa. This works regardless of whether the angle $\\theta$ is given in degrees or radians.\n\nFor now, we'll focus on points located in the first quadrant. Later, we will encounter points in all quadrants." :tutorial/id #uuid "8e9912a6-a3c6-5076-9724-a53f5e215dd8" :tutorial/math-academy-id 2493 :tutorial/title "Introduction"} :step/id #uuid "03f7f3cb-7a44-54e1-965c-a670919e31f2" :step/math-academy-id 453943 :step/next {:db/id #edb/ref 17592186055707}} {:db/id #edb/ref 17592186055707 :step/content {:db/id #edb/ref 17592186054716 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054514 :question/id #uuid "c4d9963b-1fed-523f-89c7-961ffb12feee" :question/math-academy-id "e-3343"} :knowledge-point/id #uuid "70b2f3c7-1600-51c6-91ad-855bcee7d18a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049407} {:db/id #edb/ref 17592186050847}] :knowledge-point/questions [{:db/id #edb/ref 17592186055184} {:db/id #edb/ref 17592186055444} {:db/id #edb/ref 17592186055445}] :knowledge-point/title "Finding the Coordinates of a Point on the Unit Circle Given Its Central Angle"} :step/id #uuid "38d038fc-1d12-524b-b9d7-96c6225df167" :step/math-academy-id 453944 :step/next {:db/id #edb/ref 17592186055708}} {:db/id #edb/ref 17592186055708 :step/content {:db/id #edb/ref 17592186055960 :tutorial/content "Let's consider the unit circle and a point $P(x,y)$ that lies on the circle.\n\n![](images/3d/3d51ca417ba4f6f62bd3e5db5997842d0671f18920a7de70578146a49de79ec3.png)\n\nTo prove that\n\n$$\nx=\\cos\\theta\n$$\n\nand\n\n$$\ny=\\sin\\theta\n$$\n\nlet's examine the triangle that's formed by $\\overline{OP}$ and the $x$-axis.\n\n![](images/53/53d84bedcddcb484bc613a2f01e002afe16b614daa909ff744195bcc45464472.png)\n\nNotice that:\n\n- The hypotenuse has length $1$ since it is a radius of the unit circle.\n- The adjacent and opposite sides have lengths $x$ and $y$, respectively.\n\nTherefore, using the definitions of $\\cos\\theta$ and $\\sin\\theta$, we have\n\n$$\n\\cos\\theta = \\dfrac{x}{1} = x, \\qquad \\sin\\theta = \\dfrac{y}{1} = y\n$$" :tutorial/id #uuid "e7838544-050b-5270-a16a-1679e3489a02" :tutorial/math-academy-id 2494 :tutorial/title "A Proof of the Unit Circle Property"} :step/id #uuid "8eef6615-9b8a-526e-9e9e-25070edfdad2" :step/math-academy-id 453948 :step/next {:db/id #edb/ref 17592186055709}} {:db/id #edb/ref 17592186055709 :step/content {:db/id #edb/ref 17592186054717 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054515 :question/id #uuid "59696ddf-7aa4-561a-ac77-2216038294b2" :question/math-academy-id "e-3346"} :knowledge-point/id #uuid "568011de-56c0-55f4-95ec-0a426cbf6b67" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049794}] :knowledge-point/questions [{:db/id #edb/ref 17592186055185} {:db/id #edb/ref 17592186055446}] :knowledge-point/title "Finding a Central Angle Given the Coordinates of a Point on the Unit Circle"} :step/id #uuid "9d51bf5e-1d13-5f8d-9fd6-c02b852842c4" :step/math-academy-id 453949 :step/next {:db/id #edb/ref 17592186055710}} {:db/id #edb/ref 17592186055710 :step/content {:db/id #edb/ref 17592186054718 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054517 :question/id #uuid "acb093c8-daa1-5eee-8678-e985fb9dfd71" :question/math-academy-id "e-3348"} :knowledge-point/id #uuid "8487f45b-a734-5375-abc2-5a347d49587c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050928} {:db/id #edb/ref 17592186051029}] :knowledge-point/questions [{:db/id #edb/ref 17592186055169} {:db/id #edb/ref 17592186055449}] :knowledge-point/title "Finding a Reciprocal Trigonometric Ratio Given the Coordinates of a Point on the Unit Circle"} :step/id #uuid "a21ae939-d688-510c-9d02-aec18c105046" :step/math-academy-id 453952 :step/next {:db/id #edb/ref 17592186055711}} {:db/id #edb/ref 17592186055711 :step/content {:db/id #edb/ref 17592186055963 :tutorial/content "To find the tangent of an angle using the unit circle, we need to use the relationship\n\n$$\n\\tan\\theta = \\dfrac{\\sin\\theta}{\\cos\\theta}\n$$\n\nTo see why this is true, let's take a look at the following triangle.\n\n![](images/99/99b51d7d25a266dbfda7839be6bafc335b181ecd6dc74224fcb0557180f872aa.png)\n\nFor this particular triangle, we have\n\n$$\n\\sin\\theta = \\dfrac{y}{z}, \\qquad \\cos\\theta = \\dfrac{x}{z}, \\qquad \\tan\\theta = \\dfrac{y}{x}\n$$\n\nWhen we take $\\sin\\theta$ and divide it by $\\cos\\theta$, we get\n\n$$\n\\begin{aligned}\n\\frac{\\sin θ}{\\cos θ} &= \\frac{y}{z} \\div \\frac{x}{z} \\\\\n&= \\frac{y}{z} \\cdot \\frac{z}{x} \\\\\n&= \\frac{y \\cdot z}{x \\cdot z} \\\\\n&= \\frac{y \\cdot z}{x \\cdot z} \\\\\n&= \\frac{y}{x} \\\\\n&= \\tan θ\n\\end{aligned}\n$$\n\nAlthough this proof is only for acute angles, the identity is true for any angle, provided that $\\tan\\theta$ is well-defined.\n\nFinally, since\n\n$$\n\\cot\\theta = \\dfrac{1}{\\tan\\theta}\n$$\n\nit immediately follows that\n\n$$\n\\cot\\theta = \\dfrac{1}{\\left(\\dfrac{\\sin\\theta}{\\cos\\theta}\\right)} = \\dfrac{\\cos\\theta}{\\sin\\theta}\n$$" :tutorial/id #uuid "a17ae159-de66-547d-8e9a-2190b512ab3c" :tutorial/math-academy-id 2725 :tutorial/title "The Relationship Between Sine, Cosine, and Tangent"} :step/id #uuid "68735c4a-f7f9-5265-80af-ded103195f00" :step/math-academy-id 453955 :step/next {:db/id #edb/ref 17592186055712}} {:db/id #edb/ref 17592186055712 :step/content {:db/id #edb/ref 17592186054719 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054516 :question/id #uuid "ee188df6-0ef5-5819-8fd9-77d48e8a5dce" :question/math-academy-id "e-3347"} :knowledge-point/id #uuid "83a4297b-016b-5182-bf4f-cd2b64a23c41" :knowledge-point/questions [{:db/id #edb/ref 17592186055186} {:db/id #edb/ref 17592186055448} {:db/id #edb/ref 17592186410425}] :knowledge-point/title "Finding the Tangent or Cotangent of a Central Angle Given a Point on the Unit Circle"} :step/id #uuid "8e354a30-502e-5775-810b-ba93046cedfb" :step/math-academy-id 453956}] :activity/title "Properties of the Unit Circle in the First Quadrant" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186054870}] [{:activity/first-step {:db/id #edb/ref 17592186084143} :activity/id #uuid "692fe7ac-6eba-59e0-91c1-ec7dd4e4d67e" :activity/scope {:db/id #edb/ref 17592186050455 :topic/id #uuid "4a511bf0-3faa-5067-bc10-c9e1989452c8" :topic/math-academy-id 724} :activity/steps [{:db/id #edb/ref 17592186084143 :step/content {:db/id #edb/ref 17592186084458 :tutorial/content "The **fundamental theorem of algebra** tells us that any quadratic polynomial with real coefficients has precisely two roots. \n\nFurthermore, any such polynomial can be factored as\n\n$$\nax^2+bx+c = a(x-x_1)(x-x_2),\n$$\n\nwhere $x_1$ and $x_2$ are the roots of the polynomial.\n\nWhen counting the roots of a quadratic polynomial, we need to bear in mind the following important points:\n\n- If a root has multiplicity $2,$ we count that root twice.\n\n- We also include any imaginary or complex roots.\n\nAlso, remember that in the case of imaginary or complex roots, the roots always come in complex conjugate pairs.\n\nLet's consider some examples.\n\n- Let $f(x) = 2x^2 +x -1.$ This polynomial has two distinct real roots, $x = \\dfrac12$ and $x = -1.$ Therefore, it can be factored as follows:\n\n$$\n\\begin{aligned}f(x) & =2(x-\\frac{1}{2})(x-(-1)) \\\\  & =2(x-\\frac{1}{2})(x+1)\\end{aligned}\n$$\n\n- Let $g(x) = 9x^2-6x+1.$ This polynomial has a single repeated root, $x = \\dfrac13.$ Therefore, it can be factored as follows:\n\n$$\n\\begin{aligned}g(x) & =9(x-\\frac{1}{3})(x-\\frac{1}{3}) \\\\  & =9{(x-\\frac{1}{3})}^{2}\\end{aligned}\n$$\n\n- Let $h(x) = x^2+4.$ This polynomial has two purely imaginary roots, $x = \\pm 2\\textrm i.$ Therefore, it can be factored as follows:\n\n$$\n\\begin{aligned}h(x) & =(x-2\\text{i})(x-(-2\\text{i})) \\\\  & =(x-2\\text{i})(x+2\\text{i})\\end{aligned}\n$$\n\n- Let $k(x) = x^2-4x+5.$ This polynomial has two complex roots, $x = 2\\pm \\textrm i.$ Therefore, it can be factored as follows:\n\n$$\n\\begin{aligned}k(x) & =(x-(2+\\text{i}))(x-(2-\\text{i})) \\\\  & =(x-2-\\text{i})(x-2+\\text{i})\\end{aligned}\n$$" :tutorial/id #uuid "8a2af100-5906-5681-b260-d7d94f51dc8d" :tutorial/math-academy-id 3739 :tutorial/title "Introduction"} :step/id #uuid "a27452eb-dcf8-59d9-baa4-2ffd3a0418ec" :step/math-academy-id 20996 :step/next {:db/id #edb/ref 17592186084158}} {:db/id #edb/ref 17592186084144 :step/content {:db/id #edb/ref 17592186083237 :knowledge-point/canonical-example {:db/id #edb/ref 17592186083037 :question/id #uuid "65baa4aa-0b90-52d0-91a2-93377e13af18" :question/math-academy-id "e-5788"} :knowledge-point/id #uuid "4b0262c8-c029-5a72-846b-1b4f4f3306ba" :knowledge-point/questions [{:db/id #edb/ref 17592186083724} {:db/id #edb/ref 17592186083725} {:db/id #edb/ref 17592186240850} {:db/id #edb/ref 17592186244066} {:db/id #edb/ref 17592186244101} {:db/id #edb/ref 17592186295225} {:db/id #edb/ref 17592186295226} {:db/id #edb/ref 17592186329786} {:db/id #edb/ref 17592186329787}] :knowledge-point/title "Finding a Quadratic Polynomial Given a Double Root and a Leading Coefficient"} :step/id #uuid "7cdad979-0b4f-5e49-9162-759975e40f28" :step/math-academy-id 20997 :step/next {:db/id #edb/ref 17592186084145}} {:db/id #edb/ref 17592186084145 :step/content {:db/id #edb/ref 17592186083238 :knowledge-point/canonical-example {:db/id #edb/ref 17592186083038 :question/id #uuid "98750271-1c2d-5b5f-851c-24963da1e6bf" :question/math-academy-id "e-5789"} :knowledge-point/id #uuid "70c149d8-3739-564c-97c5-6636860ad0c4" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050384}] :knowledge-point/questions [{:db/id #edb/ref 17592186083726} {:db/id #edb/ref 17592186083727} {:db/id #edb/ref 17592186295220} {:db/id #edb/ref 17592186295232} {:db/id #edb/ref 17592186329788} {:db/id #edb/ref 17592186329789} {:db/id #edb/ref 17592186329791} {:db/id #edb/ref 17592186329792}] :knowledge-point/title "Finding a Quadratic Polynomial Given Two Imaginary or Complex Roots"} :step/id #uuid "e12cd4eb-71d9-5a39-93d8-00acad4b3943" :step/math-academy-id 20999 :step/next {:db/id #edb/ref 17592186084146}} {:db/id #edb/ref 17592186084146 :step/content {:db/id #edb/ref 17592186083239 :knowledge-point/canonical-example {:db/id #edb/ref 17592186083039 :question/id #uuid "0af567b3-a239-5149-b022-d71693c63661" :question/math-academy-id "e-5791"} :knowledge-point/id #uuid "1ee21c78-209f-564b-a005-86f58699a3be" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049695}] :knowledge-point/questions [{:db/id #edb/ref 17592186083728} {:db/id #edb/ref 17592186083729} {:db/id #edb/ref 17592186244067} {:db/id #edb/ref 17592186244102} {:db/id #edb/ref 17592186244103} {:db/id #edb/ref 17592186329777} {:db/id #edb/ref 17592186329778} {:db/id #edb/ref 17592186329790} {:db/id #edb/ref 17592186329793} {:db/id #edb/ref 17592186329794}] :knowledge-point/title "Factoring a Quadratic Polynomial With Complex Roots"} :step/id #uuid "8cdc7989-b37b-58d9-ba73-aada903f432a" :step/math-academy-id 21001 :step/next {:db/id #edb/ref 17592186084282}} {:db/id #edb/ref 17592186084158 :step/content {:db/id #edb/ref 17592186083248 :knowledge-point/canonical-example {:db/id #edb/ref 17592186083044 :question/id #uuid "a9e7aedc-1b2b-5fb7-b8fb-1f9ef7c0643a" :question/math-academy-id "e-5887"} :knowledge-point/id #uuid "b2478305-485c-53a6-9d6c-a72e0764dd4e" :knowledge-point/questions [{:db/id #edb/ref 17592186083722} {:db/id #edb/ref 17592186083723} {:db/id #edb/ref 17592186292805} {:db/id #edb/ref 17592186295224} {:db/id #edb/ref 17592186329784} {:db/id #edb/ref 17592186329785}] :knowledge-point/title "Finding a Quadratic Polynomial Given Two Real Roots and a Leading Coefficient"} :step/id #uuid "97173e88-ddbb-59ee-bd62-597dc3ad2844" :step/math-academy-id 21288 :step/next {:db/id #edb/ref 17592186084144}} {:db/id #edb/ref 17592186084282 :step/content {:db/id #edb/ref 17592186084486 :tutorial/content "In this lesson, we have considered the fundamental theorem of algebra applied to quadratic polynomials. As it turns out, we can apply the fundamental theorem of algebra to *any* polynomial with real coefficients.\n\nConsider a general polynomial $p(x)$ of degree $n$ with real coefficients, given by\n\n$$\np(x) = a_nx^n+\\ldots+a_1x+a_0, \\qquad a_n\\neq 0.\n$$\n\nThe fundamental theorem of algebra tells us that $p(x)$ will always have precisely $n$ roots. \n\nFurthermore, $p(x)$ can be factored as follows:\n\n$$\np(x) = a_n(x-x_1)(x-x_2)(x-x_3)\\cdots (x-x_{n})\n$$\n\nwhere $x_1, x_2, x_3,\\ldots, x_n$ are the roots of the polynomial.\n\nAs with the quadratic case, we need to bear the following important points in mind when counting the roots of a polynomial:\n\n- If a root has multiplicity $m,$ we count that root $m$ times.\n\n- We also include any imaginary or complex roots.\n\nAs with the quadratic case, imaginary and complex roots always come in complex conjugate pairs.\n\nIn future lessons, we will learn more about the fundamental theorem of algebra applied to higher-degree polynomials." :tutorial/id #uuid "8c472d9a-6048-51aa-8381-1c446607a0e3" :tutorial/math-academy-id 5598 :tutorial/title "General Statement of the Fundamental Theorem of Algebra"} :step/id #uuid "3c4ad85e-6dc8-5d9b-a6ef-50ade8a0f2cd" :step/math-academy-id 34510}] :activity/title "The Fundamental Theorem of Algebra for Quadratic Equations" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186083419}] [{:activity/first-step {:db/id #edb/ref 17592186069612} :activity/id #uuid "b16543e4-9398-58b9-b3c3-d37c4e46b486" :activity/scope {:db/id #edb/ref 17592186050771 :topic/id #uuid "655ce7e8-5c0a-5ddc-a7e7-f1d2126f4eba" :topic/math-academy-id 443} :activity/steps [{:db/id #edb/ref 17592186069612 :step/content {:db/id #edb/ref 17592186070014 :tutorial/content "How can we solve an integral like\n\n$$\n\\int 2x(x^2+1)^3\\,\\textrm{d}x \\,?\n$$\n\nNotice that if we let $u=x^2+1$, then the derivative is $u' = 2x,$ and both $u$ and $u'$ are present in the integrand:\n\n$$\n\\int \\underbrace{2x}_{u'}(\\overbrace{x^2+1}^{u})^3\\,\\textrm{d}x\n$$\n\nIntegrals like this can always be solved using substitution. So, let's proceed. If we let ${\\color{red}{u=x^2+1}},$ then differentiating with respect to $x$ gives\n\n$$\n\\dfrac{\\textrm d u}{\\textrm d x} = 2x\\quad\\Longrightarrow\\quad\\color{blue}\\textrm{d}u=2x \\, \\textrm{d}x.\n$$\n\nWe can now see that the change of variables from $x$ to $u$ is convenient because if we substitute, we get\n\n$$\n\\int {\\color{blue}{2x}}({\\color{red}{x^2+1}})^3\\,{\\color{blue}{\\textrm{d}x}} =  \\int \\color{red}(x^2+1)^{\\color{black}3}\\, \\color{blue}{2x\\,\\textrm{d}x} \\color{black}= \\int {\\color{red}u}^{\\color{black}3}\\, {\\color{blue}{\\,\\textrm{d}u}} .\n$$\n\nNow, we can solve the integral on the right since it's the integral of a power function:\n\n$$\n\\begin{aligned}\\int {u}^{3}\\,\\,\\text{d}u & =\\frac{{u}^{4}}{4}+C.\\end{aligned}\n$$\n\nFor the last step, we change the variable back to $x$ by replacing $u=x^2+1.$ So the final result is\n\n$$\n\\displaystyle\\int 2x(x^2+1)^3\\,\\textrm{d}x \n=\\dfrac{(x^2+1)^4}{4}+C.\n$$\n\n**Note:** After solving an integral using substitution, we should always double-check that our result is correct. If we differentiate the result, then it should come out to the original integrand:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[\\frac{({x}^{2}+1)^{4}}{4}+C] & =\\frac{1}{4}\\cdot \\frac{\\text{d}}{\\text{d}x}[({x}^{2}+1)^{4}]+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =\\frac{1}{4}\\cdot 4({x}^{2}+1)^{3}\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{2}+1)+0 \\\\  & =({x}^{2}+1)^{3}\\cdot (2x) \\\\  & =2x({x}^{2}+1)^{3}\\,✓\\end{aligned}\n$$" :tutorial/id #uuid "4b1e3de2-02c8-5c3b-8e85-606d3fb2a801" :tutorial/math-academy-id 835 :tutorial/title "Introduction"} :step/id #uuid "122952df-ade4-5fd8-a8d0-4755ccb3a2b4" :step/math-academy-id 1608 :step/next {:db/id #edb/ref 17592186069613}} {:db/id #edb/ref 17592186069613 :step/content {:db/id #edb/ref 17592186068722 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068564 :question/id #uuid "e2579380-1933-5819-a39e-9ffcfdafeeee" :question/math-academy-id "e-452"} :knowledge-point/id #uuid "b89c50f3-2181-5b61-96cb-386ef88d2035" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050628}] :knowledge-point/questions [{:db/id #edb/ref 17592186069140} {:db/id #edb/ref 17592186069141} {:db/id #edb/ref 17592186247375} {:db/id #edb/ref 17592186290518} {:db/id #edb/ref 17592186339100}] :knowledge-point/title "Integrating an Expression Involving a Power Function Multiplied by Its Derivative"} :step/id #uuid "051164fd-284e-552d-9f28-b9c59e3a66be" :step/math-academy-id 1609 :step/next {:db/id #edb/ref 17592186069614}} {:db/id #edb/ref 17592186069614 :step/content {:db/id #edb/ref 17592186068723 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068565 :question/id #uuid "9bf7d343-8d3d-5194-93c4-7b80bc1e3609" :question/math-academy-id "e-453"} :knowledge-point/id #uuid "8fe2a279-0b92-561e-b17d-b902f43725ac" :knowledge-point/questions [{:db/id #edb/ref 17592186069029} {:db/id #edb/ref 17592186069030} {:db/id #edb/ref 17592186247396} {:db/id #edb/ref 17592186247397} {:db/id #edb/ref 17592186247398} {:db/id #edb/ref 17592186290504} {:db/id #edb/ref 17592186290514} {:db/id #edb/ref 17592186339101} {:db/id #edb/ref 17592186339102} {:db/id #edb/ref 17592186339123}] :knowledge-point/title "Integrating an Expression Involving a Power Function Multiplied by a Constant Multiple of Its Derivative"} :step/id #uuid "b81b95bc-62ed-53b5-89a4-fa5c9f0b6ce1" :step/math-academy-id 1612 :step/next {:db/id #edb/ref 17592186069615}} {:db/id #edb/ref 17592186069615 :step/content {:db/id #edb/ref 17592186070015 :tutorial/content "How do we calculate $\\displaystyle\\int \\dfrac{2x}{1+x^2}\\,\\textrm d x?$\n\nIn this case, the numerator is the derivative of the denominator! Again, integrals like this are always solvable by substitution. So, we let\n\n$$\n\\color{red}u = x^2+1.\n$$\n\nDifferentiating the above with respect to $x$ gives\n\n$$\n\\dfrac{\\textrm d u}{\\textrm d x} = 2x\\quad\\Longrightarrow\\quad {\\color{blue}{\\textrm d u = 2x \\, \\textrm d x}},\n$$\n\nand we can now rewrite the integral in terms of $u$ as\n\n$$\n\\begin{aligned}\\int \\frac{2x}{1+{x}^{2}}\\,\\text{d}x & =\\int \\frac{1}{1+{x}^{2}}\\cdot 2x\\,\\text{d}x \\\\  & =\\int \\frac{1}{u}\\cdot \\,\\text{d}u.\\end{aligned}\n$$\n\nFinally, we can solve the integral in terms of $u$ and then write the final result in terms of $x.$ We get\n\n$$\n\\begin{aligned}\\int \\frac{1}{u}\\,\\text{d}u & =\\operatorname{ln}|u|+C \\\\  & =\\operatorname{ln}|1+{x}^{2}|+C \\\\  & =\\operatorname{ln}(1+{x}^{2})+C.\\end{aligned}\n$$\n\nTherefore, we conclude that \n\n$$\n\\displaystyle\\int \\dfrac{2x}{1+x^2}\\,\\textrm{d}x = \\ln(1+x^2)+C.\n$$\n\nNotice that we removed the absolute value bars because the function $1+x^2$ is always positive." :tutorial/id #uuid "f4d80988-fa2c-534a-9e1a-653904508b5e" :tutorial/math-academy-id 838 :tutorial/title "Integrating Rational Functions Using Substitution"} :step/id #uuid "b89e3ba3-9d7e-5f4c-af25-daf3385dfd27" :step/math-academy-id 1615 :step/next {:db/id #edb/ref 17592186069616}} {:db/id #edb/ref 17592186069616 :step/content {:db/id #edb/ref 17592186068724 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068566 :question/id #uuid "49f679c4-bbc4-59a5-9b0c-0f3b69d7cf57" :question/math-academy-id "e-454"} :knowledge-point/id #uuid "18ce1807-3a09-5ebd-b3cd-a91db8d2b4a8" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048557}] :knowledge-point/questions [{:db/id #edb/ref 17592186069031} {:db/id #edb/ref 17592186069509} {:db/id #edb/ref 17592186235390} {:db/id #edb/ref 17592186247399} {:db/id #edb/ref 17592186247400} {:db/id #edb/ref 17592186247401} {:db/id #edb/ref 17592186259765} {:db/id #edb/ref 17592186332718} {:db/id #edb/ref 17592186332746} {:db/id #edb/ref 17592186341840}] :knowledge-point/title "Integrating a Rational Function Using Natural Logarithms"} :step/id #uuid "f947b337-8a7f-55c4-847d-ab36ef91ad40" :step/math-academy-id 1616 :step/next {:db/id #edb/ref 17592186069706}} {:db/id #edb/ref 17592186069706 :step/content {:db/id #edb/ref 17592186068786 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068628 :question/id #uuid "0461f8ba-c3c5-5e22-a679-32ee4f2a01b8" :question/math-academy-id "e-6149"} :knowledge-point/id #uuid "03e934c8-da65-5615-9717-a50eee3577fd" :knowledge-point/questions [{:db/id #edb/ref 17592186069174} {:db/id #edb/ref 17592186069380} {:db/id #edb/ref 17592186247402} {:db/id #edb/ref 17592186247403} {:db/id #edb/ref 17592186259766} {:db/id #edb/ref 17592186332742} {:db/id #edb/ref 17592186332743} {:db/id #edb/ref 17592186332747} {:db/id #edb/ref 17592186332756} {:db/id #edb/ref 17592186410416}] :knowledge-point/title "Integrating Other Fractional Expressions"} :step/id #uuid "8fd95143-4254-533f-8d05-73f6865604aa" :step/math-academy-id 22929}] :activity/title "Integration Using Substitution" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186068971}] [{:activity/first-step {:db/id #edb/ref 17592186055528} :activity/id #uuid "14506510-6a23-50e7-9f92-2d6a0e7b9372" :activity/scope {:db/id #edb/ref 17592186050782 :topic/id #uuid "66aee53c-aecf-5378-b318-bdc0930f5e43" :topic/math-academy-id 140} :activity/steps [{:db/id #edb/ref 17592186055528 :step/content {:db/id #edb/ref 17592186055964 :tutorial/content "It's possible to perform arithmetic with functions, just like with numbers. Shown below are the four arithmetic operations, addition $(+)$, subtraction $(-)$, multiplication $(\\cdot)$, and division $(/)$, applied to the functions\n\n$$\nf(x) = 4x + 1\n$$\n\nand\n\n$$\ng(x) = x - 2\n$$\n\n- **Addition**\n$\\begin{aligned} (f + g)(x) &= f(x) + g(x) \\\\ &= (4x + 1) + (x - 2) \\\\ &= 4x + 1 + x - 2 \\\\ &= 5x - 1 \\end{aligned}$\n- **Subtraction**\n$(f - g)(x)|= f(x) - g(x); = (4x + 1) - (x - 2); = 4x + 1 - x + 2; = 3x + 3$\n- **Multiplication**\n$(fg)(x)|= f(x)g(x); = (4x + 1)(x - 2); = 4x^{2} - 8x + x - 2; = 4x^{2} - 7x - 2$\n- **Division**\n$(f/g)(x)|= (f(x))/(g(x)); = \\frac{4x + 1}{x - 2}$\n\n**Note:** In the case of division, we must have that\n\n$$\ng(x)\\neq 0\n$$\n\nso that we avoid dividing by zero." :tutorial/id #uuid "c656d962-19ad-5e04-b117-fa8d0c9034b8" :tutorial/math-academy-id 2751 :tutorial/title "Introduction"} :step/id #uuid "10d1d758-8351-5c00-a262-8b57b04f8398" :step/math-academy-id 13680 :step/next {:db/id #edb/ref 17592186055531}} {:db/id #edb/ref 17592186055529 :step/content {:db/id #edb/ref 17592186054611 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054522 :question/id #uuid "9a523530-ec38-5df8-997f-2f94975eb87b" :question/math-academy-id "e-3912"} :knowledge-point/id #uuid "67b307f2-1d37-5741-8972-cbddae50c4c8" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050818}] :knowledge-point/questions [{:db/id #edb/ref 17592186055326} {:db/id #edb/ref 17592186055350} {:db/id #edb/ref 17592186233436} {:db/id #edb/ref 17592186233437} {:db/id #edb/ref 17592186234092} {:db/id #edb/ref 17592186234198} {:db/id #edb/ref 17592186413864} {:db/id #edb/ref 17592186413865}] :knowledge-point/title "Finding the Product of Two Functions"} :step/id #uuid "725779d7-8771-596d-841c-0ca2dd5da761" :step/math-academy-id 13682 :step/next {:db/id #edb/ref 17592186055530}} {:db/id #edb/ref 17592186055530 :step/content {:db/id #edb/ref 17592186054612 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054523 :question/id #uuid "79c8f0a9-6f05-515f-abaa-553863402a06" :question/math-academy-id "e-3913"} :knowledge-point/id #uuid "55d291ea-d722-5852-9c3a-faaba8e6df3e" :knowledge-point/questions [{:db/id #edb/ref 17592186055327} {:db/id #edb/ref 17592186055459} {:db/id #edb/ref 17592186233401} {:db/id #edb/ref 17592186233410} {:db/id #edb/ref 17592186234199} {:db/id #edb/ref 17592186234201} {:db/id #edb/ref 17592186413866}] :knowledge-point/title "Evaluating the Quotient of Two Functions"} :step/id #uuid "c6da4ec9-5a2e-5037-ad6d-2b91d02a4fa0" :step/math-academy-id 13683} {:db/id #edb/ref 17592186055531 :step/content {:db/id #edb/ref 17592186054613 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054524 :question/id #uuid "c68e70d0-ccec-578a-96c1-7ed106aebc79" :question/math-academy-id "e-3914"} :knowledge-point/id #uuid "2aafd8db-c723-508f-9ea3-43881f0d9140" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048524}] :knowledge-point/questions [{:db/id #edb/ref 17592186055325} {:db/id #edb/ref 17592186055452} {:db/id #edb/ref 17592186233400} {:db/id #edb/ref 17592186233409} {:db/id #edb/ref 17592186234196} {:db/id #edb/ref 17592186234505} {:db/id #edb/ref 17592186234506}] :knowledge-point/title "Finding the Sum or Difference of Two Functions"} :step/id #uuid "722ef25c-0cfd-5916-9719-a70b3e79029b" :step/math-academy-id 13684 :step/next {:db/id #edb/ref 17592186055552}} {:db/id #edb/ref 17592186055551 :step/content {:db/id #edb/ref 17592186054628 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054544 :question/id #uuid "b6a4d0a8-f579-5d6d-ad74-59b68d2046e6" :question/math-academy-id "e-4162"} :knowledge-point/id #uuid "0e8b25b3-5cc4-51b7-8ff9-fc1773797ad4" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048652}] :knowledge-point/questions [{:db/id #edb/ref 17592186055450} {:db/id #edb/ref 17592186055458} {:db/id #edb/ref 17592186233434} {:db/id #edb/ref 17592186233435} {:db/id #edb/ref 17592186234197} {:db/id #edb/ref 17592186234260} {:db/id #edb/ref 17592186234261} {:db/id #edb/ref 17592186234407} {:db/id #edb/ref 17592186410421}] :knowledge-point/title "Evaluating the Sum or Difference of Two Functions"} :step/id #uuid "d9de7d87-ac26-5915-a421-2a3c6f706e14" :step/math-academy-id 15087 :step/next {:db/id #edb/ref 17592186055529}} {:db/id #edb/ref 17592186055552 :step/content {:db/id #edb/ref 17592186055971 :tutorial/content "When we're asked to evaluate the sum of two functions at a particular point, there are two methods that we can use. We could either evaluate both functions at the point and sum the results. Or, we could sum the two functions and then evaluate the result at the point.\n\nTo demonstrate, let's find the $(f+g)(1)$ for\n\n$$\nf(x) = x^2 -1\n$$\n\nand\n\n$$\ng(x) = 2x-3\n$$\n\nThe notation $(f+g)(x)$ means the sum of the functions $f(x)$ and $g(x)$.\n\n**Method 1**\n\nTo evaluate $(f + g)(1)$, we find $f(1)$ and $g(1)$, and then add the results:\n\nFirst, we find $f(1)$ and $g(1)$:\n\n$$\n\\begin{aligned}\nf(1) &= (1)^{2} - 1 = 0 \\\\\ng(1) &= 2(1) - 3 =-1\n\\end{aligned}\n$$\n\nNow, we add the results:\n\n$$\n\\begin{aligned}\n(f + g)(1) &= f(1) + g(1) \\\\\n&= 0 + (-1) \\\\\n&=-1\n\\end{aligned}\n$$\n\n**Method 2**\n\nFirst, we find $(f+g)(x)$ by adding the two functions:\n\n$$\n\\begin{aligned}\n(f + g)(x) &= (x^{2} - 1) + (2x - 3) \\\\\n&= x^{2} + 2x - 4\n\\end{aligned}\n$$\n\nNow, we evaluate $(f + g)(1)$:\n\n$$\n\\begin{aligned}\n(f + g)(1) &= (1)^{2} + 2(1) - 4 =-1\n\\end{aligned}\n$$\n\nBoth these methods work fine, but method $1$ is usually faster.\n\nFinally, note that we can evaluate the difference between two functions using the same methods." :tutorial/id #uuid "74671b66-6f9b-59a5-96e2-aeb7ca503afe" :tutorial/math-academy-id 2834 :tutorial/title "Evaluating the Sum or Difference of Two Functions"} :step/id #uuid "c0ba47b0-a276-56f7-965d-acc1c060fc97" :step/math-academy-id 15088 :step/next {:db/id #edb/ref 17592186055551}}] :activity/title "The Arithmetic of Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186054889}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186413867} :activity/id #uuid "034eac1a-9202-5b49-a5b1-6bfa6ac2f838" :activity/scope {:db/id #edb/ref 17592186050782 :topic/id #uuid "66aee53c-aecf-5378-b318-bdc0930f5e43" :topic/math-academy-id 140} :activity/steps [{:db/id #edb/ref 17592186413867 :step/content {:db/id #edb/ref 17592186055450 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "191ed9fb-e1ea-5bef-892a-5baa90256a4d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186413837} {:answer/id #uuid "2d90ba2d-f17e-5fdb-9818-2e1002340d59" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186413838} {:answer/id #uuid "325859ee-224e-52c1-a505-c5197b9a6558" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186413839} {:answer/id #uuid "65020d93-ef32-58e5-bf24-738b6719f093" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186413841} {:answer/id #uuid "e7666301-e17b-5314-afdb-d7835e5ea1bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186413855}] :answer-field/correct {:db/id #edb/ref 17592186413841} :answer-field/id #uuid "b4da891c-9eb7-5195-a3f8-0ac1c8c6f04f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186413861}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "23a164f0-a08a-5974-9621-a6231dc1af90" :question/math-academy-id "q-66137" :question/problem "Given $f(x)=2x+1$ and $g(x)=-3x+5,$ find $(f+g)(4).$" :question/worked-solution "The notation $(f+g)(x)$ means the sum of the functions $f(x)$ and $g(x).$\n\n**Method 1**\n\nTo evaluate $(f+g)(4),$ we find $f(4)$ and $g(4),$ and then add the results.\n\nFirst, we find $f(4)$ and $g(4):$\n\n$$\n\\begin{aligned}f(4) & =2(4)+1=9 \\\\ g(4) & =-3(4)+5=-7\\end{aligned}\n$$\n\n \n\nNow, we add the results:\n\n$$\n(f+g)(4)=f(4)+g(4)=9+(-7)=2\n$$\n\n**Method 2**\n\nFirst, we find $(f+g)(x)$ by adding the two functions:\n\n$$\n\\begin{aligned}(f+g)(x) & =(2x+1)+(-3x+5) \\\\  & =-x+6 \\\\  & =6-x\\end{aligned}\n$$\n\nNow, we evaluate $(f+g)(4):$\n\n$$\n\\begin{aligned}(f+g)(4) & =6-4=2\\end{aligned}\n$$"} :step/id #uuid "03bc34b4-7201-59a8-8931-1f1c21fe49e2" :step/next {:db/id #edb/ref 17592186413871}} {:db/id #edb/ref 17592186413868 :step/content {:db/id #edb/ref 17592186413866 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ace236d-44ca-52a6-8858-d6e6168991a4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186413836} {:answer/id #uuid "596e74cb-e10e-56ee-8a2b-0983ab1a5c46" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186413840} {:answer/id #uuid "7494fadd-dd07-5f67-a41d-7917f368d4e2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186413842} {:answer/id #uuid "e1f2e513-a3ca-5f51-9c1b-c18eeceadd98" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186413853} {:answer/id #uuid "f632d377-ac04-57c7-af38-4a82afb34aaa" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Undefined" :db/id #edb/ref 17592186413856}] :answer-field/correct {:db/id #edb/ref 17592186413856} :answer-field/id #uuid "5a311d46-6876-5cc8-bd29-ac82b7694535" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186413860}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "fe5aa5dd-14e3-52ea-8c5e-90aad88d589b" :question/math-academy-id "q-78620" :question/problem "Find  $(f/g)(-1)$  for $f(x)={x}^{2}+2x$ and $g(x)={x}^{2}+x.$" :question/worked-solution "The notation $(f/g)(x)$ means the quotient of the functions $f(x)$ and $g(x).$ \n\nTo evaluate $(f/g)(-1),$ we find $f(-1)$ and $g(-1),$ and then divide the results. \n\nFirst, we find $f(-1)$ and $g(-1):$\n\n$$\n\\begin{aligned}f(-1) & =(-1)^{2}+2(-1)=-1 \\\\ g(-1) & =(-1)^{2}+(-1)=0\\end{aligned}\n$$\n\n \n\nHowever, since the denominator of a fraction can't be zero, we can't divide $f(-1)$ by $g(-1).$\n\nTherefore, the value  $(f/g)(-1)$  is undefined."} :step/id #uuid "292a564d-1238-5079-b27b-a11f9ef4f0f1"} {:db/id #edb/ref 17592186413869 :step/content {:db/id #edb/ref 17592186413865 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84f34919-47cb-54fa-a488-9daaa920449b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "450" :db/id #edb/ref 17592186413844} {:answer/id #uuid "99c58b19-affa-5e56-ac31-b7ba0d67c4b7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "120" :db/id #edb/ref 17592186413847} {:answer/id #uuid "d5863df3-ccee-5d78-a1f6-ffe664b5ed2f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "100" :db/id #edb/ref 17592186413850} {:answer/id #uuid "d88a8dac-6d79-5f3b-af46-b99926e48769" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "135" :db/id #edb/ref 17592186413851} {:answer/id #uuid "ff7784da-0b8b-5927-98d8-267858c58f6e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "540" :db/id #edb/ref 17592186413858}] :answer-field/correct {:db/id #edb/ref 17592186413850} :answer-field/id #uuid "c6c5b78a-506e-5248-bf6a-b9065365cf86" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186413862}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e96a222d-7bc2-5df0-a9b1-bdb0a30abe0c" :question/math-academy-id "q-66422" :question/problem "Given $f(x)=4x-6$ and $g(x)=5x-10,$ find  $(fg)(4).$" :question/worked-solution "The notation $(fg)(x)$ means  the product of the functions  $f(x)$ and $g(x).$\n\n**Method 1**\n\nTo evaluate $(fg)(4),$ we find $f(4)$ and $g(4),$ and then multiply the results.\n\nFirst, we find $f(4)$ and $g(4):$\n\n$$\n\\begin{aligned}f(4) & =4(4)-6=10 \\\\ g(4) & =5(4)-10=10\\end{aligned}\n$$\n\n \n\nNow, we multiply the results:\n\n$$\n(fg)(4)=f(4)g(4)=10\\cdot 10=100\n$$\n\n**Method 2**\n\nFirst, we find $(fg)(x)$ by multiplying the two functions:\n\n$$\n\\begin{aligned}(fg)(x) & =(4x-6)(5x-10) \\\\  & =20{x}^{2}-70x+60\\end{aligned}\n$$\n\n \n\nNow, we evaluate $(fg)(4):$ \n\n$$\n\\begin{aligned}(fg)(4) & =20(4)^{2}-70(4)+60 \\\\  & =320-280+60 \\\\  & =100\\end{aligned}\n$$"} :step/id #uuid "8e2f3d8e-766a-5816-a6bd-fad48a7d5c1a" :step/next {:db/id #edb/ref 17592186413870}} {:db/id #edb/ref 17592186413870 :step/content {:db/id #edb/ref 17592186234199 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00a971ff-a0ac-5e41-a6f9-de3fae7b9090" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186413834} {:answer/id #uuid "79f9695d-1add-50ce-be55-ea88b6f4de22" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186413843} {:answer/id #uuid "970de561-023f-5e4a-8ecd-0cd2dba960b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186413846} {:answer/id #uuid "e137be1f-e344-5693-8401-73a72931c8a7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186413852} {:answer/id #uuid "fb2ca1be-c620-54b9-9e8c-878f37709564" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5" :db/id #edb/ref 17592186413857}] :answer-field/correct {:db/id #edb/ref 17592186413846} :answer-field/id #uuid "328f71c0-868a-51e6-9077-92f3e52307b3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186413859}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8d54abce-95cd-5dd9-be80-9f173369bea7" :question/math-academy-id "q-66425" :question/problem "Given $f(x)=2{x}^{2}-6$ and $g(x)=-2x+2,$ find  $(f/g)(3).$" :question/worked-solution "The notation $(f/g)(x)$ means the quotient of the functions $f(x)$ and $g(x).$\n\n**Method 1**\n\nTo evaluate $(f/g)(3),$ we find $f(3)$ and $g(3),$ and then divide the results.\n\nFirst, we find $f(3)$ and $g(3):$\n\n$$\n\\begin{aligned}f(3) & =2(3)^{2}-6=12 \\\\ g(3) & =-2(3)+2=-4\\end{aligned}\n$$\n\n \n\nNow, we divide the results:\n\n$$\n(f/g)(3)=\\frac{f(3)}{g(3)}=\\frac{12}{-4}=-3\n$$\n\n**Method 2**\n\nFirst, we find $(f/g)(x)$ by dividing $f$ by $g$:\n\n$$\n\\begin{aligned}(f/g)(x)=\\frac{2{x}^{2}-6}{-2x+2}\\end{aligned}\n$$\n\nNow, we evaluate $(f/g)(3):$ \n\n$$\n\\begin{aligned}(f/g)(3) & =\\frac{2(3)^{2}-6}{-2(3)+2}=\\frac{12}{-4}=-3\\end{aligned}\n$$"} :step/id #uuid "a4e39718-e05a-5c8f-b46d-8cb5708b44e2" :step/next {:db/id #edb/ref 17592186413868}} {:db/id #edb/ref 17592186413871 :step/content {:db/id #edb/ref 17592186413864 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0624c52e-1d19-5b3b-ba86-d2f6b9cc8ef9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "50" :db/id #edb/ref 17592186413835} {:answer/id #uuid "881fa5d4-1c12-5bc5-a457-efc8e41af6ea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "54" :db/id #edb/ref 17592186413845} {:answer/id #uuid "9a61e467-6a0c-55c5-bb23-f1d334a8e5d4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "64" :db/id #edb/ref 17592186413848} {:answer/id #uuid "c363b46a-0dfe-5b02-aa34-a0ac7fb02ba1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "52" :db/id #edb/ref 17592186413849} {:answer/id #uuid "e3d08458-0ba1-59ee-877c-a0b12c255dc9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "25" :db/id #edb/ref 17592186413854}] :answer-field/correct {:db/id #edb/ref 17592186413835} :answer-field/id #uuid "fb5f2ce0-c095-5ce3-be9e-db12b1e6fb29" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186413863}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a8d2e394-0754-5534-a3fd-34ae3db4d32c" :question/math-academy-id "q-66348" :question/problem "Given $f(x)={x}^{2}+1$ and $g(x)=2x-1,$ find  $(fg)(3).$" :question/worked-solution "The notation $(fg)(x)$ means  the product of the functions  $f(x)$ and $g(x).$\n\n**Method 1**\n\nTo evaluate $(fg)(3),$ we find $f(3)$ and $g(3),$ and then multiply the results.\n\nFirst, we find $f(3)$ and $g(3):$\n\n$$\n\\begin{aligned}f(3) & =(3)^{2}+1=10 \\\\ g(3) & =2(3)-1=5\\end{aligned}\n$$\n\n \n\nNow, we multiply the results:\n\n$$\n(fg)(3)=f(3)g(3)=10\\cdot 5=50\n$$\n\n**Method 2**\n\nFirst, we find $(fg)(x)$ by multiplying the two functions:\n\n$$\n\\begin{aligned}(fg)(x) & =({x}^{2}+1)(2x-1) \\\\  & =2{x}^{3}-{x}^{2}+2x-1\\end{aligned}\n$$\n\nNow, we evaluate $(fg)(3):$ \n\n$$\n\\begin{aligned}(fg)(3) & =2(3)^{3}-(3)^{2}+2(3)-1 \\\\  & =54-9+6-1 \\\\  & =50\\end{aligned}\n$$"} :step/id #uuid "fc41b5fb-c1e3-5c52-a028-1ec2c66a6df0" :step/next {:db/id #edb/ref 17592186413869}}] :activity/title "The Arithmetic of Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186413833}] [{:activity/first-step {:db/id #edb/ref 17592186060490} :activity/id #uuid "07969c2a-d9c9-5aa3-b46d-6859410b9517" :activity/scope {:db/id #edb/ref 17592186050932 :topic/id #uuid "7297f638-82c2-5d3f-881c-0b3c54878087" :topic/math-academy-id 205} :activity/steps [{:db/id #edb/ref 17592186060490 :step/content {:db/id #edb/ref 17592186060880 :tutorial/content "Let's recall the Pythagorean identity:\n\n$$\n\\cos^2\\theta + \\sin^2\\theta = 1\n$$\n\nIf we subtract $\\sin^2\\theta$ from both sides, we get another identity:\n\n$$\n\\cos^2\\theta  = 1 - \\sin^2\\theta\n$$\n\nWe call this an **alternate form** of the Pythagorean identity.\n\nWe can get a second alternate form if we start with $\\cos^2\\theta + \\sin^2\\theta = 1$ and subtract $\\cos^2\\theta$ from both sides. This gives\n\n$$\n\\sin^2\\theta  = 1 - \\cos^2\\theta.\n$$\n\nThe alternate forms can be used to rewrite $\\cos^2\\theta$ in terms of $\\sin^2\\theta$ and vice-versa. Let's see how this works in practice." :tutorial/id #uuid "848375eb-c4b8-5536-863e-71a8e31faf38" :tutorial/math-academy-id 2421 :tutorial/title "Introduction"} :step/id #uuid "dc99d20a-0da8-5894-aaf6-530f330aaa63" :step/math-academy-id 10859 :step/next {:db/id #edb/ref 17592186060498}} {:db/id #edb/ref 17592186060491 :step/content {:db/id #edb/ref 17592186059651 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059479 :question/id #uuid "3b9c93fe-82ac-58c5-b14a-9bcd30b1f0e9" :question/math-academy-id "e-3175"} :knowledge-point/id #uuid "23637774-8d69-500d-8cb0-5e41a0207542" :knowledge-point/questions [{:db/id #edb/ref 17592186060070} {:db/id #edb/ref 17592186060229} {:db/id #edb/ref 17592186253616} {:db/id #edb/ref 17592186275457} {:db/id #edb/ref 17592186275471} {:db/id #edb/ref 17592186290461} {:db/id #edb/ref 17592186290507} {:db/id #edb/ref 17592186290545} {:db/id #edb/ref 17592186335814}] :knowledge-point/title "Simplifying Rational Expressions Using an Alternate Form of the Pythagorean Identity"} :step/id #uuid "e24efac5-83c9-5b40-99e4-c5e23867ff12" :step/math-academy-id 10860 :step/next {:db/id #edb/ref 17592186060492}} {:db/id #edb/ref 17592186060492 :step/content {:db/id #edb/ref 17592186059652 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059480 :question/id #uuid "e5821060-9f69-5df5-9456-a4574e92e910" :question/math-academy-id "e-3176"} :knowledge-point/id #uuid "b05f4be1-95d4-5137-bbaa-71c95862bb59" :knowledge-point/questions [{:db/id #edb/ref 17592186060347} {:db/id #edb/ref 17592186060348} {:db/id #edb/ref 17592186233277} {:db/id #edb/ref 17592186253617} {:db/id #edb/ref 17592186253618} {:db/id #edb/ref 17592186253619} {:db/id #edb/ref 17592186253620} {:db/id #edb/ref 17592186335812} {:db/id #edb/ref 17592186335813} {:db/id #edb/ref 17592186335823}] :knowledge-point/title "Simplifying Expressions by Factoring an Alternate Form of the Pythagorean Identity"} :step/id #uuid "892ac19b-ec94-5934-81c5-fa793320ac06" :step/math-academy-id 10864} {:db/id #edb/ref 17592186060498 :step/content {:db/id #edb/ref 17592186059656 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059487 :question/id #uuid "056204bc-53b9-5a32-a53c-0f728729fd9f" :question/math-academy-id "e-3332"} :knowledge-point/id #uuid "e85a2d68-d49f-5bf4-ab62-13ad8c35b0d4" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049488} {:db/id #edb/ref 17592186050928}] :knowledge-point/questions [{:db/id #edb/ref 17592186060069} {:db/id #edb/ref 17592186060073} {:db/id #edb/ref 17592186329719} {:db/id #edb/ref 17592186335805} {:db/id #edb/ref 17592186335806} {:db/id #edb/ref 17592186335807} {:db/id #edb/ref 17592186335808}] :knowledge-point/title "Simplifying Expression Using an Alternate Form of the Pythagorean Identity"} :step/id #uuid "fb1c3d1d-ec2b-50d8-8e5f-98b54f00edec" :step/math-academy-id 11097 :step/next {:db/id #edb/ref 17592186060491}}] :activity/title "Alternate Forms of the Pythagorean Identity" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186059905}] [{:activity/first-step {:db/id #edb/ref 17592186069609} :activity/id #uuid "8ab5b031-09a4-5e75-b365-2c7486f2168f" :activity/scope {:db/id #edb/ref 17592186050975 :topic/id #uuid "7697398d-61ca-52dc-8fab-4d569b573455" :topic/math-academy-id 459} :activity/steps [{:db/id #edb/ref 17592186069609 :step/content {:db/id #edb/ref 17592186070033 :tutorial/content "To find the distance between two points on the Cartesian plane, we can create a right triangle and use the Pythagorean theorem.\n\nTo demonstrate, consider the points $(2, 3)$ and $(5, 7)$, shown in the diagram below. We draw a right triangle so that the segment between the two points is the hypotenuse.\n\n![](images/3d/3d3629fbd659ebfb6d32080feeb64bd2ebdd3fb63e9826970d64aa41a00b9a56.png)\n\nWe can find the distance between the points by finding the length of the hypotenuse $d$ using the Pythagorean theorem in the form\n\n$$\nd = \\sqrt{a^2 + b^2}\n$$\n\nFrom this perspective:\n\n- $a$ is the distance between the $x$-coordinates.\n$a|= x_{2} - x_{1}; = 5 - 2; = 3$\n- $b$ is the distance between the $y$-coordinates.\n$b|= y_{2} - y_{1}; = 7 - 3; = 4$\n\nSo the distance between the points $(2, 3)$ and $(5, 7)$ is given by\n\n$$\n\\begin{aligned} d &= \\sqrt{3^2 + 4^2} \\\\[3pt] &= \\sqrt{9 + 16} \\\\[3pt] &= \\sqrt{25} \\\\[3pt] &= 5. \\end{aligned}\n$$\n\nIn general, the distance $d$ between any two points in the Cartesian plane is given by the **distance formula**:\n\n$$\nd = \\sqrt{(x_2 - x_1)^2 + (y_2 - y_1)^2}\n$$" :tutorial/id #uuid "e9d89e3c-10fa-540c-bc9f-221d84f3a839" :tutorial/math-academy-id 9120 :tutorial/title "Introduction"} :step/id #uuid "8fd761d6-3af8-51f6-824f-a972e67c1b97" :step/math-academy-id 147701 :step/next {:db/id #edb/ref 17592186069610}} {:db/id #edb/ref 17592186069610 :step/content {:db/id #edb/ref 17592186068720 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068508 :question/id #uuid "ca739248-c388-531e-ba5f-7f9cce2aa70b" :question/math-academy-id "e-14706"} :knowledge-point/id #uuid "5df52cb5-75b1-58d9-8535-07c1bb87be34" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049224} {:db/id #edb/ref 17592186049923}] :knowledge-point/questions [{:db/id #edb/ref 17592186069125} {:db/id #edb/ref 17592186069298} {:db/id #edb/re