76.svg)\n\n**Step 2**: Solve the equation for ![](images/c7/c7244a31f756199a29c0e7e755eccdf9274346e643e0856566469b35a207e53a.svg)\n![](images/80/80fd42d93eb7ab2cce44347268e404853f4cf507896d8097af70a92323962377.svg)\n\nSo, the derivative of ![](images/1d/1d9b846cface9f9348e4081a0dd87dd254bf26663c12aa0d1a15aa24d2393261.svg) is ![](images/42/420cc2cbdc995a548ee077e5547ca1522bd2c1cdbbd31f304a4466497acacb5c.svg)" :tutorial/id #uuid "4f8a0764-c99e-5be6-8b49-3ca28725caf9" :tutorial/math-academy-id 433 :tutorial/title "Introduction"} :step/id #uuid "47c11c73-2f53-5115-996d-e1dca896a32a" :step/math-academy-id 806 :step/next {:db/id #edb/ref 17592186055902}} {:db/id #edb/ref 17592186055902 :step/content {:db/id #edb/ref 17592186054845 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054503 :question/id #uuid "59d2e907-e788-5a22-93a9-c49ff94df6ca" :question/math-academy-id "e-190"} :knowledge-point/id #uuid "9bf25f86-6b27-5eaa-b1a1-1104478b290a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048274} {:db/id #edb/ref 17592186049332} {:db/id #edb/ref 17592186050271} {:db/id #edb/ref 17592186050789} {:db/id #edb/ref 17592186051084}] :knowledge-point/questions [{:db/id #edb/ref 17592186055138} {:db/id #edb/ref 17592186055139} {:db/id #edb/ref 17592186233645} {:db/id #edb/ref 17592186233647} {:db/id #edb/ref 17592186244127} {:db/id #edb/ref 17592186244140} {:db/id #edb/ref 17592186244141} {:db/id #edb/ref 17592186290442} {:db/id #edb/ref 17592186290443}] :knowledge-point/title "Finding the Derivative of a Function Given in Implicit Form"} :step/id #uuid "df7753ed-cc52-5fcd-b5cf-d0d376cf15e6" :step/math-academy-id 807 :step/next {:db/id #edb/ref 17592186055638}} {:db/id #edb/ref 17592186055903 :step/content {:db/id #edb/ref 17592186054846 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054504 :question/id #uuid "8a6eb51f-6232-5a08-acf1-136f0d14a4d9" :question/math-academy-id "e-191"} :knowledge-point/id #uuid "2311a895-587e-5609-8a9f-9963b8cae372