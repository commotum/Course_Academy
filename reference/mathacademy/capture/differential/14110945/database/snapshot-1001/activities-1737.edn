question/math-academy-id "e-12455"} :knowledge-point/id #uuid "553f7b9d-c387-59b0-a0d6-9624d012e414" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048484} {:db/id #edb/ref 17592186049372}] :knowledge-point/questions [{:db/id #edb/ref 17592186115510} {:db/id #edb/ref 17592186115516} {:db/id #edb/ref 17592186281510} {:db/id #edb/ref 17592186281511} {:db/id #edb/ref 17592186281512} {:db/id #edb/ref 17592186281514} {:db/id #edb/ref 17592186281515} {:db/id #edb/ref 17592186281516} {:db/id #edb/ref 17592186363451} {:db/id #edb/ref 17592186398576} {:db/id #edb/ref 17592186401364} {:db/id #edb/ref 17592186401371} {:db/id #edb/ref 17592186401378}] :knowledge-point/title "Domains of Functions With Trigonometric Components"} :step/id #uuid "3947d2bf-1e5f-5028-8a1b-43cfaacc4546" :step/math-academy-id 44801}] :activity/title "The Domain of a Vector-Valued Function" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186115482}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186411595} :activity/id #uuid "96cfc23a-e860-5cec-be62-9f9b3c48eb57" :activity/scope {:db/id #edb/ref 17592186049186 :topic/id #uuid "e1c10e80-3811-5fcd-98a3-8118c49347e4" :topic/math-academy-id 1737} :activity/steps [{:db/id #edb/ref 17592186411591 :step/content {:db/id #edb/ref 17592186398576 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bfa1654c-e948-5fc3-a89a-4fe52cc8fccf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{6}+\\frac{\\pi n}{3}" :db/id #edb/ref 17592186398578} {:answer/id #uuid "8d1b7514-50b8-5ddd-9dc3-5b90007cd7cf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi n}{6}" :db/id #edb/ref 17592186398579} {:answer/id #uuid "61124a49-e750-5eed-9f63-4fab70f48c25" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\pi n" :db/id #edb/ref 17592186398580} {:answer/id #uuid "282a04d7-5121-553a-8c70-66602f8c83db" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi n}{3}" :db/id #edb/ref 17592186398581} {:answer/id #uuid "4a1c8270-8fd2-50fc-8447-30acc60e9312" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{2}+\\frac{\\pi n}{3}" :db/id #edb/ref 17592186398582}] :answer-field/correct {:db/id #edb/ref 17592186398578} :answer-field/id #uuid "4112b8f8-a1d3-5ca1-a272-50f00bc81e5d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186398577}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b2987e81-f85b-5262-9ea2-835ea44d86e0" :question/math-academy-id "q-162644" :question/problem "The domain of the vector-valued function $f(t)=(t+1)\\,i+\\operatorname{tan}⁡(3t)\\,j+{e}^{-t}\\,k$ is \n\n$$\nt\\in (-\\infty ,\\infty ),\\,t\\ne .\n$$\n\nWhat is the missing expression? You may assume that $n$ is an integer." :question/worked-solution "To find the domain of $f$, we need the intersection of the domains of the individual components.\n\n- The domain of the 1st component $t+1$ is $t\\in (-\\infty ,\\infty ).$\n\n- The domain of the 2nd component $\\operatorname{tan}⁡(3t)$ is $t\\in (-\\infty ,\\infty ),$ except for the values of $t$ for which\n\n$$\n3t=\\frac{\\pi }{2}+\\pi n\\,⟹\\,t=\\frac{\\pi }{6}+\\frac{\\pi n}{3},\n$$\n\nwhere $n$ is an integer.\n\n- The domain of the 3rd component ${e}^{-t}$ is $t\\in (-\\infty ,\\infty ).$\n\nTherefore, the domain of the vector-valued function $f(t)$ is \n\n$$\nt\\in (-\\infty ,\\infty ),\\,t\\ne \\frac{\\pi }{6}+\\frac{\\pi n}{3},\n$$\n\nwhere $n$ is an integer."} :step/id #uuid "3ce5a87f-f4ad-59bf-8bf7-3a76cd4d166e" :step/next {:db/id #edb/ref 17592186411594}} {:db/id #edb/ref 17592186411592 :step/content {:db/id #edb/ref 17592186281524 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d759664-71cf-5524-8292-b4f9f56698b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t\\in (-1,\\infty )" :db/id #edb/ref 17592186279292} {:answer/id #uuid "839d4983-b3e1-5df2-929b-e864ccf4fcda" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t\\in (-1,0)\\cup (0,\\infty )" :db/id #edb/ref 17592186279769} {:answer/id #uuid "8ed76513-0186-5831-b557-a4f08af7383f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t\\in (-1,0]" :db/id #edb/ref 17592186279863} {:answer/id #uuid "ad393dc1-dc55-547e-b037-d30e59fc192b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t\\in (0,\\infty )" :db/id #edb/ref 17592186280126} {:answer/id #uuid "b43b6b14-c660-5371-ab23-f23367846209" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t\\in [0,\\infty )" :db/id #edb/ref 17592186280178}] :answer-field/correct {:db/id #edb/ref 17592186280126} :answer-field/id #uuid "685912e0-327e-5f2f-962f-61ee3eb96008" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186281014}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "0b92442b-8b2c-57b7-8241-452f363996f5" :question/math-academy-id "q-162662" :question/problem "Find the domain of the vector-valued function $f(t)=⟨\\sqrt{t},\\,\\operatorname{ln}⁡(t+1),\\,\\frac{1}{t}⟩.$" :question/worked-solution "To find the domain of $f$, we need the intersection of the domains of the individual components. \n\n- The domain of $\\sqrt{t}$ is $t\\in [0,\\infty ).$\n\n- The domain of $\\operatorname{ln}⁡(t+1)$ is $s\\in (-1,\\infty ).$\n\n- The domain of $\\frac{1}{t}$ is  $t\\in (-\\infty ,0)\\cup (0,\\infty ).$\n\nThe intersection is illustrated in the diagram below.\n\n![](images/97/971a65619088884002784f5abb3c4f3dc9b2e17e6b905f171b8106219a139557.png)\n\nTherefore, the domain of the vector-valued function $f(t)$ is $t\\in (0,\\infty ).$"} :step/id #uuid "3f69fac6-c791-5076-b0cb-1df861e3f01d" :step/next {:db/id #edb/ref 17592186411593}} {:db/id #edb/ref 17592186411593 :step/content {:db/id #edb/ref 17592186363458 :question/answer-fields [{