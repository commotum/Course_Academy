#{[{:activity/expected-seconds 600.0 :activity/first-step {:db/id #edb/ref 17592186193666} :activity/id #uuid "3166e137-4d3f-5719-abca-e284bb2446a8" :activity/scope {:db/id #edb/ref 17592186048744 :topic/id #uuid "ba8cd959-4cba-5c60-858b-f7ee86680552" :topic/math-academy-id 4043} :activity/steps [{:db/id #edb/ref 17592186193611 :step/content {:db/id #edb/ref 17592186192753 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192472 :question/id #uuid "65070836-e061-5fec-ae8d-263ef0c32659" :question/math-academy-id "e-10839"} :knowledge-point/id #uuid "fe4b690c-94a9-5a27-b0e8-5583ba6dba19" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049638}] :knowledge-point/questions [{:db/id #edb/ref 17592186192957} {:db/id #edb/ref 17592186193389} {:db/id #edb/ref 17592186275461} {:db/id #edb/ref 17592186275466} {:db/id #edb/ref 17592186275467} {:db/id #edb/ref 17592186278193} {:db/id #edb/ref 17592186406919} {:db/id #edb/ref 17592186406922}] :knowledge-point/title "Computing the Probability That a Random Variable Lies Within a Bounded Interval"} :step/id #uuid "a3e6cf46-1327-5a3a-8953-f8f5c744aa8d" :step/math-academy-id 41078 :step/next {:db/id #edb/ref 17592186193665}} {:db/id #edb/ref 17592186193665 :step/content {:db/id #edb/ref 17592186192788 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192512 :question/id #uuid "d8425df8-1fb2-5f59-a034-2b30f14b9b4b" :question/math-academy-id "e-11036"} :knowledge-point/id #uuid "1e723a34-c6e1-5827-87ad-866cbaeef98c" :knowledge-point/questions [{:db/id #edb/ref 17592186193181} {:db/id #edb/ref 17592186193393} {:db/id #edb/ref 17592186275458} {:db/id #edb/ref 17592186275459} {:db/id #edb/ref 17592186275460} {:db/id #edb/ref 17592186275462} {:db/id #edb/ref 17592186275464} {:db/id #edb/ref 17592186275465} {:db/id #edb/ref 17592186278194} {:db/id #edb/ref 17592186406921} {:db/id #edb/ref 17592186406923}] :knowledge-point/title "Computing the Probability That a Random Variable Lies Within an Unbounded Interval"} :step/id #uuid "f94672ce-3841-5241-8adb-0cd157483370" :step/math-academy-id 41927 :step/next {:db/id #edb/ref 17592186193667}} {:db/id #edb/ref 17592186193666 :step/content {:db/id #edb/ref 17592186193886 :tutorial/content "Recall that the **probability density function** (or **pdf**) of a continuous random variable $X$ defined over a set $S$ is a function $f(x)$ that satisfies the following conditions:\n\n- $f(x) \\geq 0$ for all $x$ in $S$\n\n- $\\displaystyle \\int_{S} f(x) \\, \\textrm dx = 1$\n\nThe probability that $X$ lies in the interval $[a,b]$ is given by\n\n$$\nP(a \\leq X \\leq b) = \\int_a^b f(x) \\, \\textrm dx.\n$$\n\nThis probability can be interpreted as the area bounded between $f(x)$ and the $x$-axis over the interval $x\\in [a,b],$ as shown below.\n\n![](images/e6/e6c21e69a0dbd15ce32d18c2e74d8fcab0276e82bc55b354eaa5140adff610e6.png)\n\nAlso, remember that for continuous random variables, we get the same answer whether or not we include the endpoints of an interval $[a,b].$ In other words,\n\n$$\nP(a \\leq X \\leq b) = P(a < X < b)  = P(a < X \\leq b) = P(a \\leq X < b).\n$$\n\nIn this lesson, we'll get some practice at computing probabilities with continuous random variables." :tutorial/id #uuid "a6c7afdc-da68-55d5-aaa4-9ff1c77b6740" :tutorial/math-academy-id 6926 :tutorial/title "Introduction"} :step/id #uuid "167eafc7-5e80-5952-9c5c-541b7d78828f" :step/math-academy-id 41930 :step/next {:db/id #edb/ref 17592186193611}} {:db/id #edb/ref 17592186193667 :step/content {:db/id #edb/ref 17592186192789 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192513 :question/id #uuid "4baa68f1-2f68-5df5-936a-aff56605ed8e" :question/math-academy-id "e-11038"} :knowledge-point/id #uuid "17408f35-ef57-5eb2-8cb6-3a946194d2d3" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050215}] :knowledge-point/questions [{:db/id #edb/ref 17592186193177} {:db/id #edb/ref 17592186193180} {:db/id #edb/ref 17592186275473} {:db/id #edb/ref 17592186275474} {:db/id #edb/ref 17592186275475} {:db/id #edb/ref 17592186275477} {:db/id #edb/ref 17592186278184} {:db/id #edb/ref 17592186278185} {:db/id #edb/ref 17592186278187} {:db/id #edb/ref 17592186278189} {:db/id #edb/ref 17592186406920}] :knowledge-point/title "Calculating Probabilities With Piecewise PDFs"} :step/id #uuid "c5ab4c4d-fb97-5d7e-a711-dca2df3d7318" :step/math-academy-id 41936}] :activity/title "Calculating Probabilities With Continuous Random Variables" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186192912}]}
