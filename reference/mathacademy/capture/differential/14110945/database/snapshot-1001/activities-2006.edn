#{[{:activity/first-step {:db/id #edb/ref 17592186129910} :activity/id #uuid "4d339a6a-8559-5175-8572-cf929b41a1ee" :activity/scope {:db/id #edb/ref 17592186051076 :topic/id #uuid "7ef40719-b08d-55b6-b171-8b9bfe562c09" :topic/math-academy-id 2006} :activity/steps [{:db/id #edb/ref 17592186129910 :step/content {:db/id #edb/ref 17592186130331 :tutorial/content "Polynomial, rational, power, radical, exponential, logarithmic, and trigonometric functions are all continuous at every point in their respective domains. Therefore, to work out where any of these types of functions are continuous, we just need to work out what the domain is.\n\nFor example, the polynomial $f(x) = 3x^3-2x^2-1$ defined for all real numbers $x.$ Therefore, it is continuous on the interval $(-\\infty, \\infty).$\n\nOn the other hand, the radical function $g(x) = \\sqrt{x}$ is defined for all numbers $x \\geq 0.$ Therefore, it is continuous on the interval $[0,\\infty).$" :tutorial/id #uuid "0df60318-c501-5ae0-a9d7-b2aa36203e90" :tutorial/math-academy-id 2601 :tutorial/title "Introduction"} :step/id #uuid "799ba962-dfd1-5401-a504-65ceb6297660" :step/math-academy-id 12129 :step/next {:db/id #edb/ref 17592186129911}} {:db/id #edb/ref 17592186129911 :step/content {:db/id #edb/ref 17592186129093 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128907 :question/id #uuid "df4f2e74-d645-5593-8b4a-9dd311c9638e" :question/math-academy-id "e-3597"} :knowledge-point/id #uuid "195aa6d7-fbb5-5b8f-8c0f-0df7a844ad59" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048176} {:db/id #edb/ref 17592186050642}] :knowledge-point/questions [{:db/id #edb/ref 17592186129808} {:db/id #edb/ref 17592186129811} {:db/id #edb/ref 17592186241056} {:db/id #edb/ref 17592186241057} {:db/id #edb/ref 17592186314900} {:db/id #edb/ref 17592186345172} {:db/id #edb/ref 17592186345173}] :knowledge-point/title "Finding the Intervals on Which a Radical Function Is Continuous"} :step/id #uuid "fb530867-3da3-572c-a4fa-c