-b6776782c3e2" :answer/id #uuid "3c90578f-5ddb-5e29-80b6-b6776782c3e2" :answer/type :answer.type/math :answer/value "y\\ge -x+\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-60e9c668-cb01-53d2-a7ef-ebb65337bf9e" :answer/id #uuid "60e9c668-cb01-53d2-a7ef-ebb65337bf9e" :answer/type :answer.type/math :answer/value "y\\ge \\frac{x}{2}-1" :db/ensure [:answer/validate]} {:db/id 17592186233494 :question/worked-solution "The given points are ${{(7,-4)}_{⏟}}_{\\text{(}{x}_{1},\\,{y}_{1})},$ ${{(a,b)}_{⏟}}_{\\text{(}{x}_{2},\\,{y}_{2})}$ and ${{(2,1)}_{⏟}}_{\\text{(}{x}_{m},\\,{y}_{m})}\\,.$\n\nWe use the midpoint formula as follows:\n\n$$\n\\begin{aligned}({x}_{m},{y}_{m}) & =(\\frac{{x}_{1}+{x}_{2}}{2},\\frac{{y}_{1}+{y}_{2}}{2}) \\\\ (2,1) & =(\\frac{7+a}{2},\\frac{-4+b}{2}).\\end{aligned}\n$$\n\nEquating the corresponding $x$- and $y$-coordinates in the equation above gives us\n\n$$\n\\begin{aligned}{\\begin{aligned}2=\\frac{7+a}{2} \\\\ 1=\\frac{-4+b}{2}\\end{aligned}\\,⇒\\,{\\begin{aligned}a=-3 \\\\ b=6.\\end{aligned}\\end{aligned}\n$$\n\nThus, $(a,b)=(-3,6)$ and $a+b=3.$" :question/answer-fields ["answer-field-385783ed-c2b9-5782-a389-7faefeb3d5c8"] :db/ensure [:question/validate]} {:db/id "answer-field-385783ed-c2b9-5782-a389-7faefeb3d5c8" :answer-field/id #uuid "385783ed-c2b9-5782-a389-7faefeb3d5c8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-524f4e0d-a8f4-5b13-89de-967398ab31ae" :answer-field/choices ["answer-5d7dda1e-729e-5cf8-8a43-96eadd48414d" "answer-41846390-6a52-578d-8160-9a5ffe51b3a8" "answer-95aeaeed-6ae9-5f05-9597-b35749ede8a9" "answer-524f4e0d-a8f4-5b13-89de-967398ab31ae" "answer-6a71db0b-e656-5269-a146-a69fd7acd33c"] :db/ensure [:answer-field/validate]} {:db/id "answer-5d7dda1e-729e-5cf8-8a43-96eadd48414d" :answer/id #uuid "5d7dda1e-729e-5cf8-8a43-96eadd48414d" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-41846390-6a52-578d-8160-9a5ffe51b3a8" :answer/id #uuid "41846390-6a52-578d-8160-9a5ffe51b3a8" :answer/type :answer.type/math :answer/value "-9" :db/ensure [:answer/validate]} {:db/id "answer-95aeaeed-6ae9-5f05-9597-b35749ede8a9" :answer/id #uuid "95aeaeed-6ae9-5f05-9597-b35749ede8a9" :answer/type :answer.type/math :answer/value "18" :db/ensure [:answer/validate]} {:db/id "answer-524f4e0d-a8f4-5b13-89de-967398ab31ae" :answer/id #uuid "524f4e0d-a8f4-5b13-89de-967398ab31ae" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-6a71db0b-e656-5269-a146-a69fd7acd33c" :answer/id #uuid "6a71db0b-e656-5269-a146-a69fd7acd33c" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id 17592186233427 :question/problem "![](images/bc/bc3809e55e601738d56be6885475ed442dec1fb3a0d2e19da14be045510f73dc.png)\n\nThe above scatter plot shows the relationship between age and years of experience of a group of professional soccer players. \n\nGiven that none of the points overlap, which of the following statements are true?\n\n- Only one player has exactly $10$ years of experience.\n- There are two players aged $21.$\n- None of the players has fewer than $6$ years of experience." :question/worked-solution "Let's examine our scatter plot.\n\n- Statement I is true. The scatter plot has only one dot whose vertical coordinate equals $10,$ namely, $(21,10).$ This means only one of the players has exactly $10$ years of experience.\n\n![](images/20/209759f5d70fd8587740d1da840f9da838a3c9a055a0d1e962f76c1cd6341fd3.png)\n\n- Statement II is true. The scatter plot has two dots whose horizontal coordinate equals $21,$ namely, $(21,10)$ and $(21,12).$ This means that two players are $21$ years old.\n\n![](images/75/753c503d6751363b1c7d2dc449f1c5f11baec159b1e938e8c807938512111750.png)\n\n- Statement III is false. From the scatter plot, one player has fewer than $6$ years of experience. The dot below the horizontal line represents this player.\n\n![](images/66/66facd1a0683f420aa2ac3d7bfd54290bdb009850bc66cc7523ee569ec81daea.png)\n\nTherefore, the correct answer is \"I and II only.\"" :question/answer-fields ["answer-field-977e29cd-53bb-5754-b469-cfb2c272536e"] :db/ensure [:question/validate]} {:db/id "answer-field-977e29cd-53bb-5754-b469-cfb2c272536e" :answer-field/id #uuid "977e29cd-53bb-5754-b469-cfb2c272536e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1e6903d6-66ca-5ff5-94be-d71ca6082cb9" :answer-field/choices ["answer-1e6903d6-66ca-5ff5-94be-d71ca6082cb9" "answer-2130bb1f-e8fd-5d92-bb5e-f650fec945b6" "answer-ec38aaf4-30b0-52d4-baf2-44e11db90cec" "answer-9fcd5d89-3140-5f33-ba80-d0643cfa95d6" "answer-94ce42f5-0ccc-53aa-a786-2762aa646dda"] :db/ensure [:answer-field/validate]} {:db/id "answer-1e6903d6-66ca-5ff5-94be-d71ca6082cb9" :answer/id #uuid "1e6903d6-66ca-5ff5-94be-d71ca6082cb9" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-2130bb1f-e8fd-5d92-bb5e-f650fec945b6" :answer/id #uuid "2130bb1f-e8fd-5d92-bb5e-f650fec945b6" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-ec38aaf4-30b0-52d4-baf2-44e11db90cec" :answer/id #uuid "ec38aaf4-30b0-52d4-baf2-44e11db90cec" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-9fcd5d89-3140-5f33-ba80-d0643cfa95d6" :answer/id #uuid "9fcd5d89-3140-5f33-ba80-d0643cfa95d6" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-94ce42f5-0ccc-53aa-a786-2762aa646dda" :answer/id #uuid "94ce42f5-0ccc-53aa-a786-2762aa646dda" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id 17592186234327 :question/answer-fields ["answer-field-2f94bc8f-6c0f-50a3-8936-bf86f03998e4"] :db/ensure [:question/validate]} {:db/id "answer-field-2f94bc8f-6c0f-50a3-8936-bf86f03998e4" :answer-field/id #uui