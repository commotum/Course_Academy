5cc9ad956f02bd4cfd6bddf224ac6.svg)" :tutorial/id #uuid "8476c8a4-d8cc-506a-9a59-336f4479edb7" :tutorial/math-academy-id 8144 :tutorial/title "Introduction"} :step/id #uuid "c5fae52f-334e-5bf5-b0c4-8317d931bc20" :step/math-academy-id 467154 :step/next {:db/id #edb/ref 17592186199398}} {:db/id #edb/ref 17592186199398 :step/content {:db/id #edb/ref 17592186198445 :knowledge-point/canonical-example {:db/id #edb/ref 17592186198139 :question/id #uuid "252f20b3-8797-5709-96b5-6e9b4aea9677" :question/math-academy-id "e-13034"} :knowledge-point/id #uuid "5d5731e2-34fa-5e27-84be-324dc958b509" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048355} {:db/id #edb/ref 17592186049894}] :knowledge-point/questions [{:db/id #edb/ref 17592186198939} {:db/id #edb/ref 17592186199010} {:db/id #edb/ref 17592186284776} {:db/id #edb/ref 17592186290565} {:db/id #edb/ref 17592186292647} {:db/id #edb/ref 17592186292648} {:db/id #edb/ref 17592186292649}] :knowledge-point/title "Finding the Probability of an Intersection"} :step/id #uuid "5c5de07e-ba56-530f-a115-ae4b337e043f" :step/math-academy-id 467155 :step/next {:db/id #edb/ref 17592186199399}} {:db/id #edb/ref 17592186199399 :step/content {:db/id #edb/ref 17592186198446 :knowledge-point/canonical-example {:db/id #edb/ref 17592186198129 :question/id #uuid "e1b4a2f7-3859-5648-9072-a76486fa1bfa" :question/math-academy-id "e-12933"} :knowledge-point/id #uuid "053ab8bb-73ba-54b1-b195-05d4e12c56f1" :knowledge-point/questions [{:db/id #edb/ref 17592186198761} {:db/id #edb/ref 17592186198940} {:db/id #edb/ref 17592186256403} {:db/id #edb/ref 17592186284769} {:db/id #edb/ref 17592186284780} {:db/id #edb/ref 17592186292651} {:db/id #edb/ref 17592186292652} {:db/id #edb/ref 17592186292653}] :knowledge-point/title "Finding the Probability of a Union"} :step/id #uuid "ec02fbba-20ca-5afa-93b8-8fdee5c166c0" :step/math-academy-id 467158 :step/next {:db/id #edb/ref 17592186199400}} {:db/id #edb/ref 17592186199400 :step/content {:db/id #edb/ref 17592186198447 :knowledge-point/canonical-example {:db/id #edb/ref 17592186198140 :question/id #uuid "21e52195-d600-5cb5-a8f4-4c9019816694" :question/math-academy-id "e-13035"} :knowledge-point/id #uuid "44603ff6-f9c7-5a02-83c1-0e803444bd25" :knowledge-point/questions [{:db/id #edb/ref 17592186198941} {:db/id #edb/ref 17592186199011} {:db/id #edb/ref 17592186284778} {:db/id #edb/ref 17592186284779} {:db/id #edb/ref 17592186292654} {:db/id #edb/ref 17592186292655} {:db/id #edb/ref 17592186292656} {:db/id #edb/ref 17592186292657} {:db/id #edb/ref 17592186292658} {:db/id #edb/ref 17592186354561}] :knowledge-point/title "Finding the Probability of a Complement"} :step/id #uuid "41b543a8-ae29-5b54-8e27-42e7d9425e15" :step/math-academy-id 467162}] :activity/title "Applying the Addition Law With Event Complements" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186198523}] [{:activity/first-step {:db/id #edb/ref 17592186167781} :activity/id #uuid "b36ed83a-cc37-5ff2-a68e-2a0e28c0b24e" :activity/scope {:db/id #edb/ref 17592186048270 :topic/id #uuid "8e43115f-4416-5ec0-b698-3e53a959567b" :topic/math-academy-id 3286} :activity/steps [{:db/id #edb/ref 17592186167713 :step/content {:db/id #edb/ref 17592186166847 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166697 :question/id #uuid "699d9c0c-bb98-5710-8d98-10b6f35ab202" :question/math-academy-id "e-8911"} :knowledge-point/id #uuid "e9d77603-c824-5160-80fc-3d10353fe243" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048412} {:db/id #edb/ref 17592186049605}] :knowledge-point/questions [{:db/id #edb/ref 17592186167115} {:db/id #edb/ref 17592186167116}] :knowledge-point/title "Computing a Conditional Probability Using Bayes' Theorem"} :step/id #uuid "7e6025e7-7c05-542d-a78a-f9d7e627be29" :step/math-academy-id 33287 :step/next {:db/id #edb/ref 17592186167772}} {:db/id #edb/ref 17592186167714 :step/content {:db/id #edb/ref 17592186166848 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166698 :question/id #uuid "284f5029-19eb-53d4-a3b7-0f66d33b9cc9" :question/math-academy-id "e-8912"} :knowledge-point/id #uuid "3a4fee2d-88c3-5381-bd55-98990abc7df3" :knowledge-point/questions [{:db/id #edb/ref 17592186167117} {:db/id #edb/ref 17592186167119} {:db/id #edb/ref 17592186275200}] :knowledge-point/title "Solving for an Unknown Conditional Probability"} :step/id #uuid "fd5da403-f379-5dee-9a50-ecafcf083c36" :step/math-academy-id 33288} {:db/id #edb/ref 17592186167772 :step/content {:db/id #edb/ref 17592186166877 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166482 :question/id #uuid "bc694d40-d150-55e6-981f-0ca6b5d91e21" :question/math-academy-id "e-10418"} :knowledge-point/id #uuid "6c467adb-9d0e-5b33-b81e-4959e2703535" :knowledge-point/questions [{:db/id #edb/ref 17592186167052} {:db/id #edb/ref 17592186167118}] :knowledge-point/title "Applying Bayes’ Theorem to a Situation in Context"} :step/id #uuid "7a97606a-98ac-50e6-9e3c-78ae18820b2e" :step/math-academy-id 39256 :step/next {:db/id #edb/ref 17592186167714}} {:db/id #edb/ref 17592186167781 :step/content {:db/id #edb/ref 17592186168143 :tutorial/content "In this lesson, we will generalize Bayes' theorem to deal with situations where the sample space $\\mathcal S$ is partitioned into a disjoint union of multiple events.\n\nSuppose we have three events $A_1,A_2$, and $A_3$ that form a disjoint union of the sample space $\\mathcal S$, as shown below.\n\n![](images/89/89a78ef526fcd29a59bacd4d6ae1a456a596d6616af7453f1ba530a610d9a2ac.png)\n\nNow consider an event $B$ that also lies in the sample space:\n\n![](images/da/daa96423e45f9f80897e2c2d61177eab2faff77f440921866d1b81b7ef2cfe09.png)\n\nBayes' theorem states that\n\n$$\nP(A_1 \\mid B)=\\dfrac{P(B \\mid A_1)P(A_1)}{P(B)}\n$$\n\nNow, the law of total probability tells us that\n\n$$\nP(B)=P(B \\mid A_1)P(A_1) + P(B \\mid A_2)P(A_2) + P(B \\mid A_3)P(A_3)\n$$\n\nSubstituting this into Bayes' theorem, we get\n\n$$\nP(A_1 \\mid B) = \\dfrac{P(B \\mid A_1) P(A_1)}{P(B \\mid A_1)P(A_1) + P(B \\mid A_2)P(A_2) + P(B \\mid A_3)P(A_3)}\n$$\n\nUsing similar arguments, we can say that for $A_k$ for $k=1,2,3$, we have\n\n$$\nP(A_k \\mid B) = \\dfrac{P(B \\mid A_k) P(A_k)}{P(B \\mid A_1)P(A_1) + P(B \\mid A_2)P(A_2) + P(B \\mid A_3)P(A_3)}\n$$\n\nwhich is usually written more compactly as\n\n$$\nP(A_k \\mid B) = \\dfrac{P(B \\mid A_k) P(A_k)}{\\sum_{i=1}^3 P(B \\mid A_i)P(A_i)}\n$$\n\nIt's easy to see how this generalizes. If the disjoint union $A_1 \\sqcup A_2 \\sqcup \\ldots \\sqcup A_n$ covers the entire sample space, Bayes' theorem combined with the law of total probability gives us the following:\n\n$$\nP(A_k \\mid B) = \\dfrac{P(B \\mid A_k) P(A_k)}{\\sum_{i=1}^n P(B \\mid A_i)P(A_i)}\n$$\n\nLet's see an example of how to apply this theorem." :tutorial/id #uuid "bf17685f-9890-54cc-b8a2-15815558e87a" :tutorial/math-academy-id 6969 :tutorial/title "Introduction"} :step/id #uuid "b6bd91e8-6598-5c56-9fa4-bf1144fc830d" :step/math-academy-id 42168 :step/next {:db/id #edb/ref 17592186167713}}] :activity/title "Extending Bayes' Theorem" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186167047}] [{:activity/first-step {:db/id #edb/ref 17592186184904} :activity/id #uuid "294c5c60-7cc0-5d4b-b33a-c4b1d0febcf6" :activity/scope {:db/id #edb/ref 17592186048358 :topic/id #uuid "985dd262-d15d-59ca-814a-d63fefbc5327" :topic/math-academy-id 3829} :activity/steps [{:db/id #edb/ref 17592186184890 :step/content {:db/id #edb/ref 17592186184140 :knowledge-point/canonical-example {:db/id #edb/ref 17592186184050 :question/id #uuid "62e7eb47-4217-5bf0-b458-6059c1040fd7" :question/math-academy-id "e-3476"} :knowledge-point/id #uuid "50af360c-635c-5b48-bfdf-8e85cc3608b2" :knowledge-point/questions [{:db/id #edb/ref 17592186184456} {:db/id #edb/ref 17592186184490} {:db/id #edb/ref 17592186410424}] :knowledge-point/title "Expressing the Tangent of a Large Angle in Terms of a Reference Angle"} :step/id #uuid "5e63ab9a-476f-5df8-9300-eb8b953d3e5d" :step/math-academy-id 11655} {:db/id #edb/ref 17592186184904 :step/content {:db/id #edb/ref 17592186185312 :tutorial/content "Recall that the **reference angle** $\\theta_R$ of a given angle $\\theta$ is the positive acute angle $\\theta$ makes with the $x$-axis.\n\nReference angles can be used to evaluate trigonometric functions for large angles. In this lesson, we'll learn how to express trigonometric ratios of large angles in terms of reference angles.\n\nAs an example, let's write the following trigonometric ratio in terms of a reference angle:\n\n$$\n\\sin{440^\\circ}\n$$\n\nTo express this trigonometric ratio in terms of a reference angle, we first find the corresponding *coterminal angle* that lies in the range $[0^\\circ, 360^\\circ)$. We do this by subtracting integer multiples of $360^\\circ$ as many times as necessary until we get our coterminal angle:\n\n$$\n440^\\circ - 360^\\circ = 80^\\circ \\quad{\\color{green}{\\checkmark}}\n$$\n\nNow, notice that our coterminal angle is acute and lies in the first quadrant. Therefore,\n\n$$\n\\theta_R = 80^\\circ\n$$\n\nand we conclude that\n\n$$\n\\sin 440^\\circ = \\sin 80^\\circ\n$$\n\n![](images/9d/9d1ea107c7247c576a3b8b431b822ca08c8aee55c5898d59e48c6c4581188452.png)" :tutorial/id #uuid "1be22cf7-45e4-5f98-b822-b15908dfde21" :tutorial/math-academy-id 2719 :tutorial/title "Introduction"} :step/id #uuid "2a9925ca-b285-52f9-be38-c12b5a590da1" :step/math-academy-id 13279 :step/next {:db/id #edb/ref 17592186185002}} {:db/id #edb/ref 17592186185002 :step/content {:db/id #edb/ref 17592186184216 :knowledge-point/canonical-example {:db/id #edb/ref 17592186184121 :question/id #uuid "15f7c53c-eb3f-516a-9452-330dddee8a15" :question/math-academy-id "e-9956"} :knowledge-point/id #uuid "7d16d09c-098e-5104-8703-9b2dcaf9e253" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050795} {:db/id #edb/ref 17592186051050}] :knowledge-point/questions [{:db/id #edb/ref 17592186184487} {:db/id #edb/ref 17592186184822}] :knowledge-point/title "Expressing Large Angles in the First Quadrant in Terms of Reference Angles"} :step/id #uuid "fb0249ac-20ee-5461-bef6-c7ec304fddc7" :step/math-academy-id 37490 :step/next {:db/id #edb/ref 17592186185003}} {:db/id #edb/ref 17592186185003 :step/content {:db/id #edb/ref 17592186185341 :tutorial/content "Suppose we're given a large angle $\\theta$ that does *not* lie in the first quadrant. In these cases, the procedure for expressing a trigonometric ratio evaluated at $\\theta$ in terms of $\\theta_R$ is similar to what we saw previously. However, we also need to consider the *sign* of the trigonometric ratio in the quadrant where $\\theta$ lies.\n\nAs an example, let's express the following trigonometric ratio in terms of a reference angle:\n\n$$\n\\sin{940^\\circ}\n$$\n\nTo do this, we follow three steps:\n\n- **Step 1**: Find an angle that's coterminal with $940^\\circ$ and lies in the range $[0^\\circ, 360^\\circ)$. We do this by subtracting integer multiples of $360^\\circ$ until we get our desired angle:\n$940^{∘} - 360^{∘}|= 580^{∘}; 940^{∘} - 2 \\cdot 360^{∘}|= 220^{∘}✓$\nTherefore,\n$\\sin 940^\\circ = \\sin 220^\\circ$.\nA sketch of our angle and its corresponding reference angle is shown below.\n\n![](images/0b/0b256260541503fdf451f29ef0c71cd4e8ef63883f4e1dbf93da071eda4aecd3.png)\n\n- **Step 2**: Compute the reference angle. Since $\\theta = 220^\\circ$ is in the $3$rd quadrant, the reference angle is\n$\\theta_R = 220^\\circ - 180^\\circ = 40^\\circ$.\n\n- **Step 3**: Determine the correct sign. The sine function is negative $({\\color{red}{-}})$ in the third quadrant. Therefore,\n$\\sin (220^\\circ) = {\\color{red}{-}}\\sin\\theta_R = {\\color{red}{-}}\\sin{40^\\circ}$.\n\nSo, we conclude that\n\n$$\n\\sin 940^\\circ = -\\sin{40^\\circ}\n$$" :tutorial/id #uuid "b306b1d4-2c03-5cb7-9f03-07c8b3a7a420" :tutorial/math-academy-id 6184 :tutorial/title "Large Angles Outside the First Quadrant"} :step/id #uuid "a7946eab-4eb9-5b3a-833c-ef1c159c81ca" :step/math-academy-id 37492 :step/next {:db/id #edb/ref 17592186185004}} {:db/id #edb/ref 17592186185004 :step/content {:db/id #edb/ref 17592186184217 :knowledge-point/canonical-example {:db/id #edb/ref 17592186184122 :question/id #uuid "b70919c3-c48f-55c8-bd8c-9441b4b66de8" :question/math-academy-id "e-9957"} :knowledge-point/id #uuid "ab2decf6-9a5b-5942-80b7-f48522e93b7f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186051043}] :knowledge-point/questions [{:db/id #edb/ref 17592186184823} {:db/id #edb/ref 17592186184853}] :knowledge-point/title "Expressing the Sine of a Large Angle in Terms of a Reference Angle"} :step/id #uuid "daf93413-c40c-51c5-a21d-30d2ea7a31ea" :step/math-academy-id 37493 :step/next {:db/id #edb/ref 17592186185005}} {:db/id #edb/ref 17592186185005 :step/content {:db/id #edb/ref 17592186184218 :knowledge-point/canonical-example {:db/id #edb/ref 17592186184123 :question/id #uuid "07ae3d2b-9593-5927-ad3c-c5ad3682333f" :question/math-academy-id "e-9958"} :knowledge-point/id #uuid "a58fe278-8008-5dab-9b96-6ecda6202a2b" :knowledge-point/questions [{:db/id #edb/ref 17592186184488} {:db/id #edb/ref 17592186184489}] :knowledge-point/title "Expressing the Cosine of a Large Angle in Terms of a Reference Angle"} :step/id #uuid "6c7d9d02-5463-594d-84ef-eef4a1fa1587" :step/math-academy-id 37494 :step/next {:db/id #edb/ref 17592186184890}}] :activity/title "Extending the Trigonometric Ratios to Large Angles" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186184414}] [{:activity/first-step {:db/id #edb/ref 17592186176723} :activity/id #uuid "55f43435-8dca-5810-9753-eee340bb8532" :activity/scope {:db/id #edb/ref 17592186048485 :topic/id #uuid "a385b92b-792f-5dd9-9921-9b85efbacd4d" :topic/math-academy-id 3603} :activity/steps [{:db/id #edb/ref 17592186176723 :step/content {:db/id #edb/ref 17592186176991 :tutorial/content "Sometimes, we might know the general form of the probability distribution for a population, yet we may not know some of its underlying parameters. We wish to develop strategies to estimate unknown population parameters from sample data. One such strategy is to use **likelihood functions.**\n\nIn this lesson, we'll learn how to compute likelihood functions for particular discrete probability distributions.\n\nSuppose we have an I.I.D. (independent and identically distributed) random sample\n\n$$\nX_1, \\: X_2, \\: \\ldots, \\: X_n\n$$\n\nwhere the probability mass function of each $X_i$ is given by\n\n$$\nf(x;\\,\\theta)\n$$\n\nand $\\theta$ is an *unknown,* fixed parameter.\n\nSuppose we have a particular sample from this distribution:\n\n$$\nx_1, \\: x_2, \\: \\ldots, \\: x_n\n$$\n\nWe define the **likelihood function** $L(\\theta)$ as\n\n$$\nL(\\theta) = P(X_1=x_1, X_2=x_2, \\ldots, X_n = x_n)\n$$\n\nThe likelihood function gives the probability of getting a particular sample for a specific parameter value.\n\nNow, since we assumed that all $X_i$'s are independent and identically distributed, by the multiplication law, we have\n\n$$\n\\begin{aligned}\nL(θ) &= P(X_{1} = x_{1}, X_{2} = x_{2}, …, X_{n} = x_{n}) \\\\\n&= P(X_{1} = x_{1}) \\cdot P(X_{2} = x_{2})⋯P(X_{n} = x_{n}) \\\\\n&= ∏_(i = 1)^(n)P(X_{i} = x_{i}) \\\\\n&= ∏_(i = 1)^(n)f(x_{i} \\\\\n&= θ)\n\\end{aligned}\n$$\n\nTo summarize, the likelihood function $L(\\theta)$ is defined as\n\n$$\nL(\\theta) = \\prod_{i=1}^n f(x_i;\\,\\theta)\n$$\n\nLet's take a look at a concrete example." :tutorial/id #uuid "febfe0fc-b4fd-5ec4-9fe2-66459c06433b" :tutorial/math-academy-id 5364 :tutorial/title "Introduction"} :step/id #uuid "05cbc6df-2e50-58cc-b377-41b56e25e5ed" :step/math-academy-id 33494 :step/next {:db/id #edb/ref 17592186176882}} {:db/id #edb/ref 17592186176845 :step/content {:db/id #edb/ref 17592186176040 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175687 :question/id #uuid "d15d6003-a4dd-599f-987d-289508968ac7" :question/math-academy-id "e-10105"} :knowledge-point/id #uuid "39593326-76e2-578f-af68-57f59712c30e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048922} {:db/id #edb/ref 17592186049273} {:db/id #edb/ref 17592186049367} {:db/id #edb/ref 17592186049729} {:db/id #edb/ref 17592186051082}] :knowledge-point/questions [{:db/id #edb/ref 17592186176370} {:db/id #edb/ref 17592186176392}] :knowledge-point/title "Likelihood Functions for Bernoulli Random Variables"} :step/id #uuid "819b8cb4-51d8-5f27-b9c1-7715977c4527" :step/math-academy-id 38120 :step/next {:db/id #edb/ref 17592186176880}} {:db/id #edb/ref 17592186176880 :step/content {:db/id #edb/ref 17592186176062 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175708 :question/id #uuid "3e3ca456-a46a-5a5b-9cf6-07caad631ff9" :question/math-academy-id "e-11117"} :knowledge-point/id #uuid "2a2eb2ca-a19a-591e-810a-c028a17be252" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050651}] :knowledge-point/questions [{:db/id #edb/ref 17592186176371} {:db/id #edb/ref 17592186176393}] :knowledge-point/title "Likelihood Functions for Binomial Random Variables"} :step/id #uuid "808203c4-7f89-5eca-af00-29965de75553" :step/math-academy-id 42270 :step/next {:db/id #edb/ref 17592186176881}} {:db/id #edb/ref 17592186176881 :step/content {:db/id #edb/ref 17592186176063 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175709 :question/id #uuid "9f08cf84-3e3b-5c86-adb6-622bc51a15f6" :question/math-academy-id "e-11118"} :knowledge-point/id #uuid "03d91774-9a9f-55a8-8a9a-090788318a98" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049358}] :knowledge-point/questions [{:db/id #edb/ref 17592186176372} {:db/id #edb/ref 17592186176394} {:db/id #edb/ref 17592186410435}] :knowledge-point/title "Likelihood Functions for Poisson Random Variables"} :step/id #uuid "44901d9a-fe9f-55ba-bd1c-9441ea7f0e71" :step/math-academy-id 42271} {:db/id #edb/ref 17592186176882 :step/content {:db/id #edb/ref 17592186177074 :tutorial/content "Suppose that\n$X_1,\\quad X_2,\\quad X_3,\\quad X_4,\\quad X_5,\\quad X_6$\n\nis an I.I.D random sample from a population, where\n\n$X_i\\sim \\text{Bernoulli}(\\theta)$\nand $\\theta$ is the *unknown* probability of success.\n\nSuppose we conduct a sample and get the following data:\n\n$$\nx_1=0, \\quad x_2=1, \\quad x_3=1, \\quad x_4=0, \\quad x_5=1, \\quad x_6=1\n$$\n\nLet's compute the likelihood function for this sample.\n\nRecall that if $X_1, X_2, \\ldots, X_{n}$ are I.I.D random variables with probability mass function $f(x; \\theta)$, then the likelihood function of a random sample $x_1, x_2, \\ldots, x_n$ is given by\n\n$$\nL(\\theta) = P(X_1=x_1, X_2=x_2, \\ldots, X_n = x_n) = \\displaystyle\\prod_{i=1}^n f(x_i;\\,\\theta)\n$$\n\nThe probability mass function for a Bernoulli random variable with an unknown probability of success $\\theta$ is given by\n\n$$\nf(x; \\theta) = \\theta^x(1-\\theta)^{1-x}, \\qquad x=0,1\n$$\n\nUsing this definition, we can calculate the likelihood function as follows:\n\n$$\n\\begin{aligned}\nL(θ) &= ∏_(i = 1)^(n)f(x_{i} \\\\\n&= θ) \\\\\n&= ∏_(i = 1)^(n)θ^{x_{i}}(1 - θ)^{1 - x_{i}} \\\\\n&= (θ^{x_{1}}(1 - θ)^{1 - x_{1}}) \\cdot (θ^{x_{2}}(1 - θ)^{1 - x_{2}})⋯(θ^{x_{n}}(1 - θ)^{1 - x_{n}}) \\\\\n&= θ^{∑x_{i}}(1 - θ)^{∑(1 - x_{i})} \\\\\n&= θ^{∑x_{i}}(1 - θ)^{n - ∑x_{i}} \\\\\n&= θ^{S}(1 - θ)^{n - S}\n\\end{aligned}\n$$\n\nwhere\n\n$$\n\\displaystyle S = \\sum\\limits_ {i=1}^n x_i\n$$\n\nFor our sample, we have that $n=6$, and\n\n$$\n\\begin{aligned}\nS &= ∑_(i = 1)^(n)x_{i} \\\\\n&= 0 + 1 + 1 + 0 + 1 + 1 \\\\\n&= 4\n\\end{aligned}\n$$\n\nTherefore, the likelihood function for this sample is given by\n\n$$\n\\begin{aligned}\nL(θ) &= θ^{4}(1 - θ)^{6 - 4} \\\\\n&= θ^{4}(1 - θ)^{2}\n\\end{aligned}\n$$\n\nThe graph of $L(\\theta)$ is shown below.\n\n![](images/28/28c73749a566d5531ef2f13c5b01bd1d26ced28e19749abf056841492fb497f5.png)\n\nNotice that $L(\\theta)$ has a maximum inside the interval $\\theta \\in [0,1]$. The value $\\widehat{\\,\\theta\\,}$ that corresponds to the maximum likelihood is called the **maximum likelihood estimate** of the parameter $\\theta$ for the given sample.\n\nWe'll discuss how to compute the maximum likelihood estimate in future topics. But, for now, let's see more examples of finding the likelihood functions for different distributions and samples." :tutorial/id #uuid "8748c53f-183a-5ba8-99aa-e0a92e7d9707" :tutorial/math-academy-id 7013 :tutorial/title "A Worked Example"} :step/id #uuid "7abb8790-00de-50e4-8248-7dcfdef20be2" :step/math-academy-id 42315 :step/next {:db/id #edb/ref 17592186176845}}] :activity/title "Likelihood Functions for Discrete Probability Distributions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186176143}] [{:activity/first-step {:db/id #edb/ref 17592186180559} :activity/id #uuid "1c5ce268-312c-52a6-9777-1ff390251f96" :activity/scope {:db/id #edb/ref 17592186048492 :topic/id #uuid "a459a1e3-e019-5c4e-a702-5c6685ca3dec" :topic/math-academy-id 3707} :activity/steps [{:db/id #edb/ref 17592186180559 :step/content {:db/id #edb/ref 17592186180757 :tutorial/content "Suppose that $\\mathbf T:\\mathbb R^2\\rightarrow\\mathbb R^2$ is an affine transformation. The **inverse** of $\\mathbf T$ (if it exists) is an affine transformation $\\mathbf T^{-1}$ such that\n\n$$\\mathbf T^{-1} (\\mathbf T(\\mathbf u)) = \\mathbf T (\\mathbf T^{-1}(\\mathbf u)) = \\mathbf u$$\n\nfor every vector $\\mathbf u\\in\\mathbb R^2.$ In other words, the transformation $\\mathbf T^{-1}$ reverses the action of $\\mathbf T.$\n\nNot all affine transformations are invertible. So how can we determine whether a given affine transformation is invertible?\n\nTo answer this, recall that an affine transformation $\\mathbf T$ can be expressed in matrix form as\n\n$$\\mathbf x = A \\mathbf u + \\mathbf b,$$\n\nwhere $\\mathbf x, \\mathbf u,$ and $\\mathbf b$ are column vectors in $\\mathbb R^2,$ and $A$ is a $2\\times 2$ matrix. We can reverse the action of $\\mathbf T$ by making $\\mathbf u$ the subject of this equation, as follows:\n\n$$\\begin{aligned}Au+b & =x \\\\ Au & =x-b \\\\ {A}^{-1}\\cdot Au & ={A}^{-1}\\cdot (x-b) \\\\ {I}_{2}\\cdot u & ={A}^{-1}(x-b) \\\\ u & ={A}^{-1}(x-b)\\end{aligned}$$\n\nThis equation gives us a method of computing the inverse of an affine transformation. Additionally, we have the following:\n\n*An affine transformation $\\mathbf T$ is invertible if and only if the matrix $A$ that represents the linear transformation associated with $\\mathbf T$ is invertible, that is, $\\det(A) \\neq 0.$*" :tutorial/id #uuid "bf99caa7-1e47-5fea-87ac-9b91151af127" :tutorial/math-academy-id 7697 :tutorial/title "Introduction"} :step/id #uuid "35dfb0c0-efab-5193-92eb-6eb22cc2af9f" :step/math-academy-id 44660 :step/next {:db/id #edb/ref 17592186180560}} {:db/id #edb/ref 17592186180560 :step/content {:db/id #edb/ref 17592186179770 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179431 :question/id #uuid "f9d3291b-b95b-536b-93ec-9815f7f554d5" :question/math-academy-id "e-12428"} :knowledge-point/id #uuid "e39ae7fc-ff0a-5b97-8e13-1f15b12a07e5" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049012} {:db/id #edb/ref 17592186049548}] :knowledge-point/questions [{:db/id #edb/ref 17592186179992} {:db/id #edb/ref 17592186179993} {:db/id #edb/ref 17592186259618} {:db/id #edb/ref 17592186259620} {:db/id #edb/ref 17592186259621} {:db/id #edb/ref 17592186259623} {:db/id #edb/ref 17592186378490} {:db/id #edb/ref 17592186378497} {:db/id #edb/ref 17592186378504}] :knowledge-point/title "Identifying Invertible Affine Transformations"} :step/id #uuid "30275202-8cd8-51e0-a9e1-92aa287dbe42" :step/math-academy-id 44661 :step/next {:db/id #edb/ref 17592186180561}} {:db/id #edb/ref 17592186180561 :step/content {:db/id #edb/ref 17592186180758 :tutorial/content "Consider the affine transformation $\\mathbf T,$ expressed in matrix form as\n\n$$\\underbrace{[\\begin{aligned}x \\\\ y\\end{aligned}]}_{\\mathbf x} = \\underbrace{[\\begin{aligned}1 & -3 \\\\ 1 & -2\\end{aligned}]}_{A} \\cdot \\underbrace{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{\\mathbf u} + \\underbrace{[\\begin{aligned}2 \\\\ 3\\end{aligned}]}_{\\mathbf b}.$$\n\nWe wish to determine whether $\\mathbf T^{-1}$ exists and find its matrix form if it does exist.\n\nComputing the determinant of $A,$ we get $$\\det(A) = \\left| \\begin{aligned}1 & -3 \\\\ 1 & -2\\end{aligned} \\right| = 1\\cdot (-2) - (-3) \\cdot 1 = 1 \\neq 0.$$\n\nSince $\\det(A) \\neq 0,$ the affine transformation is invertible.\n\nTo compute the inverse of $\\mathbf T,$ we will use the formula we derived earlier:\n\n$$\\mathbf{u} = A^{-1}(\\mathbf{x} - \\mathbf{b})$$\n\nWe start by calculating the inverse of $A{:}$\n\n$$\\begin{aligned}{A}^{-1} & =\\frac{1}{1}[\\begin{aligned}-2 & 3 \\\\ -1 & 1\\end{aligned}] \\\\ & =[\\begin{aligned}-2 & 3 \\\\ -1 & 1\\end{aligned}]\\end{aligned}$$\n\nTherefore, the matrix form of the inverse affine transformation $\\mathbf{T}^{-1}$ is\n\n$$\\begin{aligned}{{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u} & ={{[\\begin{aligned}-2 & 3 \\\\ -1 & 1\\end{aligned}]}_{⏟}}_{{A}^{-1}}\\cdot ({{[\\begin{aligned}x \\\\ y\\end{aligned}]}_{⏟}}_{x}-{{[\\begin{aligned}2 \\\\ 3\\end{aligned}]}_{⏟}}_{b}) \\\\ & =[\\begin{aligned}-2 & 3 \\\\ -1 & 1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]-[\\begin{aligned}-2 & 3 \\\\ -1 & 1\\end{aligned}][\\begin{aligned}2 \\\\ 3\\end{aligned}] \\\\ & =[\\begin{aligned}-2 & 3 \\\\ -1 & 1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]-[\\begin{aligned}5 \\\\ 1\\end{aligned}] \\\\ & =[\\begin{aligned}-2 & 3 \\\\ -1 & 1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]+[\\begin{aligned}-5 \\\\ -1\\end{aligned}].\\end{aligned}$$" :tutorial/id #uuid "c4c88a3e-6514-5b56-ab23-306164b0a3a3" :tutorial/math-academy-id 7698 :tutorial/title "Finding the Inverse of an Affine Transformation"} :step/id #uuid "6802d261-21db-5122-886a-1dda8f3a0db4" :step/math-academy-id 44664 :step/next {:db/id #edb/ref 17592186180562}} {:db/id #edb/ref 17592186180562 :step/content {:db/id #edb/ref 17592186179771 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179432 :question/id #uuid "af48b8ba-874a-5753-9874-a2b13fc5a65b" :question/math-academy-id "e-12429"} :knowledge-point/id #uuid "0403251a-9491-5d04-ab5a-ed027024d0a4" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049213} {:db/id #edb/ref 17592186050944}] :knowledge-point/questions [{:db/id #edb/ref 17592186179995} {:db/id #edb/ref 17592186180005} {:db/id #edb/ref 17592186259625} {:db/id #edb/ref 17592186259626} {:db/id #edb/ref 17592186259627} {:db/id #edb/ref 17592186259629} {:db/id #edb/ref 17592186259632} {:db/id #edb/ref 17592186259633} {:db/id #edb/ref 17592186259634} {:db/id #edb/ref 17592186378511} {:db/id #edb/ref 17592186378518}] :knowledge-point/title "Inverting Affine Transformations Given in Matrix Form"} :step/id #uuid "3f8aecda-4d54-5528-939f-886f4ab93593" :step/math-academy-id 44665 :step/next {:db/id #edb/ref 17592186180563}} {:db/id #edb/ref 17592186180563 :step/content {:db/id #edb/ref 17592186179772 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179433 :question/id #uuid "c5e70edd-5a39-5e85-9461-68df182780dc" :question/math-academy-id "e-12430"} :knowledge-point/id #uuid "b99071b9-d463-5e3e-9a0d-71711af836cb" :knowledge-point/questions [{:db/id #edb/ref 17592186179994} {:db/id #edb/ref 17592186180006} {:db/id #edb/ref 17592186259647} {:db/id #edb/ref 17592186259649} {:db/id #edb/ref 17592186259651} {:db/id #edb/ref 17592186259658} {:db/id #edb/ref 17592186259659} {:db/id #edb/ref 17592186259660} {:db/id #edb/ref 17592186259661} {:db/id #edb/ref 17592186378525} {:db/id #edb/ref 17592186406969}] :knowledge-point/title "Inverting Affine Transformations Given in Parametric Form"} :step/id #uuid "21d1cffb-5a12-5ee7-ad2a-181e2a8d4474" :step/math-academy-id 44668 :step/next {:db/id #edb/ref 17592186180569}} {:db/id #edb/ref 17592186180568 :step/content {:db/id #edb/ref 17592186179775 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179436 :question/id #uuid "98ebb2b6-475b-53c5-acae-0b1b0f0778d2" :question/math-academy-id "e-12441"} :knowledge-point/id #uuid "4e551b65-4116-58bc-b2bc-e536930c69b4" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049254}] :knowledge-point/questions [{:db/id #edb/ref 17592186180089} {:db/id #edb/ref 17592186180090} {:db/id #edb/ref 17592186281405} {:db/id #edb/ref 17592186281414} {:db/id #edb/ref 17592186281415} {:db/id #edb/ref 17592186281417} {:db/id #edb/ref 17592186281418} {:db/id #edb/ref 17592186281419} {:db/id #edb/ref 17592186281420} {:db/id #edb/ref 17592186389250} {:db/id #edb/ref 17592186389257} {:db/id #edb/ref 17592186406968}] :knowledge-point/title "Identifying the Types of Images Formed by an Affine Transformation"} :step/id #uuid "35abe35f-9e29-539b-aaa5-a2546fd2fbfb" :step/math-academy-id 44704} {:db/id #edb/ref 17592186180569 :step/content {:db/id #edb/ref 17592186180761 :tutorial/content "Consider the square in the $uv$-plane shown below.\n\n![](images/a8/a8cc0923da86a1a1ac6b666893397263ef3865448080500caa6f17510547d901.png)\n\nWe wish to explore the image of this square under an affine transformation $$\\mathbf{T}: \\mathbf{u} \\longrightarrow A \\mathbf{u} + \\mathbf{b},$$ where $A$ is a $2\\times 2$ matrix, and $\\mathbf u$ and $\\mathbf b$ are $2\\times 1$ column vectors.\n\nSimilar to linear transformations, there are three possibilities depending on the value of $\\det(A)$.\n\n- $\\mathbf{T}$ is non-singular ($\\det(A)\\neq 0$). In this case, our square is mapped to a parallelogram.\n\nFor example, let the transformation $\\mathbf T$ be given by $$[\\begin{aligned}x \\\\ y\\end{aligned}] = [\\begin{aligned}2 & 1 \\\\ 1 & 2\\end{aligned}] \\cdot [\\begin{aligned}u \\\\ v\\end{aligned}] + [\\begin{aligned}1 \\\\ 1\\end{aligned}].$$ Mapping our square to the $xy$-plane, we get the following parallelogram:\n\n![](images/36/36da067393fa53f4296373d65e3c6177a54d1a901824188687b4a74ea171afdf.png)\n- $\\mathbf{T}$ is singular ($\\det(A)=0$) and $A$ has at least one nonzero entry. In this case, our square is mapped to a line segment.\n\nFor example, let the transformation $\\mathbf T$ be given by $$[\\begin{aligned}x \\\\ y\\end{aligned}] = [\\begin{aligned}2 & -1 \\\\ 2 & -1\\end{aligned}] \\cdot [\\begin{aligned}u \\\\ v\\end{aligned}] + [\\begin{aligned}1 \\\\ 1\\end{aligned}].$$ Mapping our square to the $xy$-plane gives the following line segment:\n\n![](images/5e/5e5481e5b2f2218a6097020e260dc991cde05574372c724aa07527458257d94c.png)\n- $\\mathbf{T}$ is singular ($\\det(A)=0$) and $A$ is the zero matrix. In this case, our square is mapped to a point on the plane.\n\nFor example, let the transformation $\\mathbf T$ be given by $$[\\begin{aligned}x \\\\ y\\end{aligned}] = [\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}] \\cdot [\\begin{aligned}u \\\\ v\\end{aligned}] + [\\begin{aligned}1 \\\\ 1\\end{aligned}].$$ Mapping our square to the $xy$-plane gives the following point.\n\n![](images/00/0072c5e06674f79f82e771744fda217e6558830f7a6e4ab387aa9dbf4dda09bc.png)" :tutorial/id #uuid "375d6591-08dd-5dbf-b36a-28013839a28b" :tutorial/math-academy-id 7706 :tutorial/title "Image Types Formed by Affine Transformations"} :step/id #uuid "5ec4662b-6870-532f-83f9-f7a9cbe5504e" :step/math-academy-id 44705 :step/next {:db/id #edb/ref 17592186180570}} {:db/id #edb/ref 17592186180570 :step/content {:db/id #edb/ref 17592186180762 :tutorial/content "In general, if we consider the affine transformation $\\mathbf T:\\Bbb R^2 \\to \\Bbb R^2,$ defined by the mapping\n\n$$\n\\mathbf{T}: \\mathbf{u} \\longrightarrow A \\mathbf{u} + \\mathbf{b},\n$$\n\nwhere $A$ is a $2\\times 2$ matrix and $\\mathbf u$ and $\\mathbf b$ are $2\\times 1$ column vectors, then we have one of the following three possibilities:\n\n- If $\\mathbf{T}$ is non-singular, i.e., when $\\det(A) \\neq 0,$ then the image of a two-dimensional object is a two-dimensional object. In particular, the image of a polygon with $n$ vertices is a polygon with $n$ vertices.\n\n- If $\\mathbf{T}$ is singular, i.e., when $\\det(A) = 0,$ we have two additional subcases: \n\n- If $A$ has at least one nonzero entry, then the image of a two-dimensional object is a one-dimensional line segment.\n\n- If $A$ is the zero matrix, then the image of a two-dimensional object is a point on the plane (namely, the point with position vector $\\mathbf b$)." :tutorial/id #uuid "560907bc-354a-5693-a8df-e6824454755d" :tutorial/math-academy-id 7710 :tutorial/title "A Summary of Image Types"} :step/id #uuid "d71cf118-7383-5aea-a47c-8359fc7dffe4" :step/math-academy-id 44723 :step/next {:db/id #edb/ref 17592186180568}}] :activity/title "The Inverse of an Affine Transformation" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186179860}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186406970} :activity/id #uuid "13211b98-9cdf-5456-a254-0f2d03a88cbb" :activity/scope {:db/id #edb/ref 17592186048492 :topic/id #uuid "a459a1e3-e019-5c4e-a702-5c6685ca3dec" :topic/math-academy-id 3707} :activity/steps [{:db/id #edb/ref 17592186406970 :step/content {:db/id #edb/ref 17592186259633 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46c52d4e-2631-53e7-8a00-72ab68871a97" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186257401} {:answer/id #uuid "746b1cdb-7c35-5efe-a92c-2cd06400438a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186257801} {:answer/id #uuid "a34beb49-2bb7-5107-84ce-cae801ce1c47" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186258211} {:answer/id #uuid "ef2b02b6-f203-59a0-ab8f-6e907c4aac2b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186258857} {:answer/id #uuid "f75572fb-3d5c-57c1-b45a-ea11a4c996bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186258950}] :answer-field/correct {:db/id #edb/ref 17592186257801} :answer-field/id #uuid "99e69744-50ea-5409-9359-8197e1464b98" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186259303}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "08a12b2e-6f73-5fc0-987c-f4d58e5bc21f" :question/math-academy-id "q-124241" :question/problem "The matrix form of the affine transformation $T$ is given by\n\n$$\n[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}8 & 9 \\\\ 4 & 5\\end{aligned}]\\cdot [\\begin{aligned}u \\\\ v\\end{aligned}]+[\\begin{aligned}6 \\\\ 2\\end{aligned}].\n$$\n\nFind $a+b+c,$ given that the matrix form of the inverse transformation ${T}^{-1}$ is given by\n\n$$\n[\\begin{aligned}u \\\\ v\\end{aligned}]=[\\begin{aligned}a & b \\\\ -1 & c\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]+[\\begin{aligned}-3 \\\\ 2\\end{aligned}].\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nReversing the action of $T,$ we get\n\n$$\n\\begin{aligned}Au+b & =x \\\\ Au & =x-b \\\\ u & ={A}^{-1}(x-b).\\end{aligned}\n$$\n\nThe matrix form of $T$ gives us the following information:\n\n$$\n{{[\\begin{aligned}8 & 9 \\\\ 4 & 5\\end{aligned}]}_{⏟}}_{A}\\cdot {{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u}+{{[\\begin{aligned}6 \\\\ 2\\end{aligned}]}_{⏟}}_{b}\n$$\n\nNext, we calculate the inverse of $A:$\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{5\\cdot 8-9\\cdot 4}[\\begin{aligned}5 & -9 \\\\ -4 & 8\\end{aligned}] \\\\  & =\\frac{1}{4}[\\begin{aligned}5 & -9 \\\\ -4 & 8\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{5}{4} & -\\frac{9}{4} \\\\ -1 & 2\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the inverse transformation ${T}^{-1}$ is\n\n$$\n\\begin{aligned}{{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u} & ={{[\\begin{aligned}\\frac{5}{4} & -\\frac{9}{4} \\\\ -1 & 2\\end{aligned}]}_{⏟}}_{{A}^{-1}}\\cdot ({{[\\begin{aligned}x \\\\ y\\end{aligned}]}_{⏟}}_{x}-{{[\\begin{aligned}6 \\\\ 2\\end{aligned}]}_{⏟}}_{b}) \\\\  & =[\\begin{aligned}\\frac{5}{4} & -\\frac{9}{4} \\\\ -1 & 2\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]-[\\begin{aligned}\\frac{5}{4} & -\\frac{9}{4} \\\\ -1 & 2\\end{aligned}][\\begin{aligned}6 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{5}{4} & -\\frac{9}{4} \\\\ -1 & 2\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]-[\\begin{aligned}3 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{5}{4} & -\\frac{9}{4} \\\\ -1 & 2\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]+[\\begin{aligned}-3 \\\\ 2\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=\\frac{5}{4}+(-\\frac{9}{4})+2=1.\n$$"} :step/id #uuid "1d9d1d09-adca-5f60-87c8-6eda1712954f" :step/next {:db/id #edb/ref 17592186406974}} {:db/id #edb/ref 17592186406971 :step/content {:db/id #edb/ref 17592186406968 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fc064fc-557b-51b4-acc4-5e5aac84e9ea" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A triangle" :db/id #edb/ref 17592186406956} {:answer/id #uuid "394dd73f-cf48-54c7-81fb-4dd53a787045" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A line segment" :db/id #edb/ref 17592186406957} {:answer/id #uuid "72653cf4-8cbf-523e-b1d8-e878cfd112ab" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A square" :db/id #edb/ref 17592186406961} {:answer/id #uuid "c61e03b3-7008-5b09-9b8a-dd9dc056f91b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A pentagon" :db/id #edb/ref 17592186406964} {:answer/id #uuid "d1b9f565-9eda-5c15-bc7f-e57e8c6bdef5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A point" :db/id #edb/ref 17592186406965}] :answer-field/correct {:db/id #edb/ref 17592186406957} :answer-field/id #uuid "2eef93f6-f290-530b-8af5-dd127f8894d8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186406967}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "353e50fd-8521-51a5-ae98-273dc887e6d8" :question/math-academy-id "q-162221" :question/problem "![](images/99/99b3d68b7f0c89ba430b098f9e7fda95f3013f310060dd71cf86eacc6e51afa7.png)\n\nConsider the affine transformation $T,$ given by\n\n$$\n[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-1 & 2 \\\\ -4 & 8\\end{aligned}]\\cdot [\\begin{aligned}u \\\\ v\\end{aligned}]+[\\begin{aligned}3 \\\\ -1\\end{aligned}].\n$$\n\n \nWhat would be the image of the quadrilateral shown above under the action of $T?$" :question/worked-solution "Recall that for any affine transformation \n\n$$\nT:u⟶Au+b,\n$$\n\nwhere $A$ is a $2\\times 2$ matrix and $u$ and $b$ are $2\\times 1$ column vectors, we have one of the following three possibilities:\n\n- If $T$ is non-singular, i.e., when $det(A)\\ne 0,$ then the image of a two-dimensional object is a two-dimensional object. In particular, the image of a polygon with $n$ vertices is a polygon with $n$ vertices.\n\n- If $T$ is singular, i.e., when $det(A)=0,$ we have two additional subcases:\n\n- If $A$ has at least one nonzero entry, then the image of a two-dimensional object is a one-dimensional line segment.\n\n- If $A$ is the zero matrix, then the image of a two-dimensional object is a point on the plane.\n\nWith that in mind, let's examine our transformation.\n\nNotice that the matrix representation of the linear transformation associated with $T$ is \n$A=[\\begin{aligned}-1 & 2 \\\\ -4 & 8\\end{aligned}].$\n\nComputing the determinant of $A,$ we obtain\n\n$$\n\\begin{aligned}det(T) & =|\\begin{aligned}-1 & 2 \\\\ -4 & 8\\end{aligned}| \\\\  & =(-1)\\cdot 8-(-4)\\cdot 2 \\\\  & =0.\\end{aligned}\n$$\n\nSo, we have a singular nonzero matrix. \n\nTherefore, $T$ is non-invertible, and the image of the quadrilateral under the action of $T$ is a line segment."} :step/id #uuid "57752ad6-299b-53a6-80c6-38f70d7331f1"} {:db/id #edb/ref 17592186406972 :step/content {:db/id #edb/ref 17592186180089 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1acc367e-71f3-5e97-87ce-92842c5b3257" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A parallelepiped" :db/id #edb/ref 17592186278836} {:answer/id #uuid "3f4b22b4-65fa-5db1-94f1-780f0591f6e8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A parallelogram" :db/id #edb/ref 17592186279153} {:answer/id #uuid "638bcae2-f573-5b91-97f0-f5ab7fc66eb9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A line segment" :db/id #edb/ref 17592186279497} {:answer/id #uuid "7e024141-a94e-5f97-ae2f-a04b85d857ef" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A point on the plane" :db/id #edb/ref 17592186279720} {:answer/id #uuid "a42ad425-777b-5f11-8db0-c06039f852ee" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A triangle" :db/id #edb/ref 17592186280049}] :answer-field/correct {:db/id #edb/ref 17592186279497} :answer-field/id #uuid "2222be89-5b86-5d7e-873f-1d11313d8d91" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186280888}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "79161a5e-44bb-5845-8a74-564fa863b598" :question/math-academy-id "q-162151" :question/problem "![](images/3f/3f8c1c9854ec54dd3caf4487328d3f3c35f2d69680a8fd1c13d28125dac77d03.png)\n\nConsider the affine transformation $T,$ given by\n\n$$\n[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-2 & 6 \\\\ 1 & -3\\end{aligned}]\\cdot [\\begin{aligned}u \\\\ v\\end{aligned}]+[\\begin{aligned}-1 \\\\ 1\\end{aligned}].\n$$\n\n \nWhat would be the image of the square shown above under the action of $T?$" :question/worked-solution "Recall that for any affine transformation \n\n$$\nT:u⟶Au+b,\n$$\n\nwhere $A$ is a $2\\times 2$ matrix and $u$ and $b$ are $2\\times 1$ column vectors, we have one of the following three possibilities:\n\n- If $T$ is non-singular, i.e., when $det(A)\\ne 0,$ then the image of a two-dimensional object is a two-dimensional object. In particular, the image of a polygon with $n$ vertices is a polygon with $n$ vertices.\n\n- If $T$ is singular, i.e., when $det(A)=0,$ we have two additional subcases:\n\n- If $A$ has at least one nonzero entry, then the image of a two-dimensional object is a one-dimensional line segment.\n\n- If $A$ is the zero matrix, then the image of a two-dimensional object is a point on the plane.\n\nWith that in mind, let's examine our transformation.\n\nNotice that the matrix representation of the linear transformation associated with $T$ is \n$A=[\\begin{aligned}-2 & 6 \\\\ 1 & -3\\end{aligned}].$\n\nComputing the determinant of $A,$ we obtain\n\n$$\n\\begin{aligned}det(T) & =|\\begin{aligned}-2 & 6 \\\\ 1 & -3\\end{aligned}| \\\\  & =(-2)\\cdot (-3)-6\\cdot 1 \\\\  & =0.\\end{aligned}\n$$\n\nSo, we have a singular nonzero matrix. \n\nTherefore, $T$ is non-invertible and the image of the square under the action of $T$ is a line segment."} :step/id #uuid "8adcf20b-9143-567f-8916-5a2f8686af25" :step/next {:db/id #edb/ref 17592186406971}} {:db/id #edb/ref 17592186406973 :step/content {:db/id #edb/ref 17592186406969 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f998697-e815-585e-b0b5-3820b9ab9a03" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186406958} {:answer/id #uuid "51054506-a98c-59d1-82db-eab8461f2cb2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186406959} {:answer/id #uuid "6c76efec-c230-59b8-bab5-b44500517e1e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "13" :db/id #edb/ref 17592186406960} {:answer/id #uuid "80f4eee2-e47a-55c2-b5f0-e42eb70ff849" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186406962} {:answer/id #uuid "c3375fbb-f890-5cba-a4b4-7f53a73a78cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186406963}] :answer-field/correct {:db/id #edb/ref 17592186406960} :answer-field/id #uuid "20065c9e-4427-527a-a708-a46b3d2f2065" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186406966}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e92cb69b-a679-593b-8882-9cab8d26a8fb" :question/math-academy-id "q-124289" :question/problem "The affine transformation $T$ is defined as\n\n$$\nx=u-v-1,\\,y=3v-2u-6.\n$$\n\nGiven that the inverse transformation ${T}^{-1}$ of $T$ is\n\n$$\nu=ax+y+9,\\,v=bx+y+c,\n$$\n\nwhat is the value of $a+b+c?$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nReversing the action of $T,$ we get\n\n$$\n\\begin{aligned}Au+b & =x \\\\ Au & =x-b \\\\ u & ={A}^{-1}(x-b).\\end{aligned}\n$$\n\nSo, writing our transformation in matrix form, we have\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}] & =[\\begin{aligned}u-v-1 \\\\ 3v-2u-6\\end{aligned}] \\\\  & =[\\begin{aligned}u-v \\\\ -2u+3v\\end{aligned}]+[\\begin{aligned}-1 \\\\ -6\\end{aligned}] \\\\  & ={{[\\begin{aligned}1 & -1 \\\\ -2 & 3\\end{aligned}]}_{⏟}}_{A}\\cdot {{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u}+{{[\\begin{aligned}-1 \\\\ -6\\end{aligned}]}_{⏟}}_{b}.\\end{aligned}\n$$\n\nNext, we calculate the inverse of $A:$\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{3\\cdot 1-(-1)\\cdot (-2)}[\\begin{aligned}3 & 1 \\\\ 2 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 1 \\\\ 2 & 1\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the inverse transformation ${T}^{-1}$ is\n\n$$\n\\begin{aligned}{{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u} & ={{[\\begin{aligned}3 & 1 \\\\ 2 & 1\\end{aligned}]}_{⏟}}_{{A}^{-1}}\\cdot ({{[\\begin{aligned}x \\\\ y\\end{aligned}]}_{⏟}}_{x}-{{[\\begin{aligned}-1 \\\\ -6\\end{aligned}]}_{⏟}}_{b}) \\\\  & =[\\begin{aligned}3 & 1 \\\\ 2 & 1\\end{aligned}][\\begin{aligned}x+1 \\\\ y+6\\end{aligned}] \\\\  & =[\\begin{aligned}3\\cdot (x+1)+1\\cdot (y+6) \\\\ 2\\cdot (x+1)+1\\cdot (y+6)\\end{aligned}] \\\\  & =[\\begin{aligned}3x+y+9 \\\\ 2x+y+8\\end{aligned}]\\end{aligned}\n$$\n\nEquating the corresponding components, the inverse transformation ${T}^{-1}$ in coordinate form is\n\n$$\nu=3x+y+9,\\,v=2x+y+8.\n$$\n\nTherefore, we have\n\n$$\na+b+c=3+2+8=13.\n$$"} :step/id #uuid "b7332e33-ee2f-5908-9f85-c258b5d80b5d" :step/next {:db/id #edb/ref 17592186406972}} {:db/id #edb/ref 17592186406974 :step/content {:db/id #edb/ref 17592186259649 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bed1340-8927-5ff0-ba69-b2b93cdd78e8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186256896} {:answer/id #uuid "81fb632e-14da-5038-b6f9-74ec0da963a5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186257937} {:answer/id #uuid "82d7f633-617d-5497-a90c-a0550510c2f6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186257941} {:answer/id #uuid "d5507f11-f2dc-54ed-aa00-8c211067e5e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186258649} {:answer/id #uuid "e3817db8-3192-5a2c-ad51-eb7cb8e7b55c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186258760}] :answer-field/correct {:db/id #edb/ref 17592186258649} :answer-field/id #uuid "fa29d767-9911-5a05-a828-3b3c81faca3c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186259473}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f20eb077-8cae-5138-ae0e-248f60ff9fb8" :question/math-academy-id "q-124280" :question/problem "The affine transformation $T$ is defined as\n\n$$\nx=2-u-v,\\,y=3u+4v-1.\n$$\n\nGiven that the inverse transformation ${T}^{-1}$ of $T$ is\n\n$$\nu=7+ax-y,\\,v=bx+y+c,\n$$\n\nwhat is the value of $a+b+c?$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nReversing the action of $T,$ we get\n\n$$\n\\begin{aligned}Au+b & =x \\\\ Au & =x-b \\\\ u & ={A}^{-1}(x-b).\\end{aligned}\n$$\n\nSo, writing our transformation in matrix form, we have\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}] & =[\\begin{aligned}2-u-v \\\\ 3u+4v-1\\end{aligned}] \\\\  & =[\\begin{aligned}-u-v \\\\ 3u+4v\\end{aligned}]+[\\begin{aligned}2 \\\\ -1\\end{aligned}] \\\\  & ={{[\\begin{aligned}-1 & -1 \\\\ 3 & 4\\end{aligned}]}_{⏟}}_{A}\\cdot {{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u}+{{[\\begin{aligned}2 \\\\ -1\\end{aligned}]}_{⏟}}_{b}.\\end{aligned}\n$$\n\nNext, we calculate the inverse of $A:$\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{4\\cdot (-1)-(-1)\\cdot 3}[\\begin{aligned}4 & 1 \\\\ -3 & -1\\end{aligned}] \\\\  & =\\frac{1}{-1}[\\begin{aligned}4 & 1 \\\\ -3 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}-4 & -1 \\\\ 3 & 1\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the inverse transformation ${T}^{-1}$ is\n\n$$\n\\begin{aligned}{{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u} & ={{[\\begin{aligned}-4 & -1 \\\\ 3 & 1\\end{aligned}]}_{⏟}}_{{A}^{-1}}\\cdot ({{[\\begin{aligned}x \\\\ y\\end{aligned}]}_{⏟}}_{x}-{{[\\begin{aligned}2 \\\\ -1\\end{aligned}]}_{⏟}}_{b}) \\\\  & =[\\begin{aligned}-4 & -1 \\\\ 3 & 1\\end{aligned}][\\begin{aligned}x-2 \\\\ y+1\\end{aligned}] \\\\  & =[\\begin{aligned}-4\\cdot (x-2)+(-1)\\cdot (y+1) \\\\ 3\\cdot (x-2)+1\\cdot (y+1)\\end{aligned}] \\\\  & =[\\begin{aligned}7-4x-y \\\\ 3x+y-5\\end{aligned}]\\end{aligned}\n$$\n\nEquating the corresponding components, the inverse transformation ${T}^{-1}$ in coordinate form is\n\n$$\nu=7+(-4)x-y,\\,v=3x+y+(-5).\n$$\n\nTherefore, we have\n\n$$\na+b+c=-4+3+(-5)=-6.\n$$"} :step/id #uuid "c564b67d-ab6c-5a8c-9962-63cefc9e226d" :step/next {:db/id #edb/ref 17592186406973}}] :activity/title "The Inverse of an Affine Transformation" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186406955}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186412072} :activity/id #uuid "5dadfabb-9118-5878-8b7b-abe67ab51d1a" :activity/scope {:db/id #edb/ref 17592186048492 :topic/id #uuid "a459a1e3-e019-5c4e-a702-5c6685ca3dec" :topic/math-academy-id 3707} :activity/steps [{:db/id #edb/ref 17592186412068 :step/content {:db/id #edb/ref 17592186406968 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fc064fc-557b-51b4-acc4-5e5aac84e9ea" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A triangle" :db/id #edb/ref 17592186406956} {:answer/id #uuid "394dd73f-cf48-54c7-81fb-4dd53a787045" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A line segment" :db/id #edb/ref 17592186406957} {:answer/id #uuid "72653cf4-8cbf-523e-b1d8-e878cfd112ab" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A square" :db/id #edb/ref 17592186406961} {:answer/id #uuid "c61e03b3-7008-5b09-9b8a-dd9dc056f91b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A pentagon" :db/id #edb/ref 17592186406964} {:answer/id #uuid "d1b9f565-9eda-5c15-bc7f-e57e8c6bdef5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A point" :db/id #edb/ref 17592186406965}] :answer-field/correct {:db/id #edb/ref 17592186406957} :answer-field/id #uuid "2eef93f6-f290-530b-8af5-dd127f8894d8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186406967}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "353e50fd-8521-51a5-ae98-273dc887e6d8" :question/math-academy-id "q-162221" :question/problem "![](images/99/99b3d68b7f0c89ba430b098f9e7fda95f3013f310060dd71cf86eacc6e51afa7.png)\n\nConsider the affine transformation $T,$ given by\n\n$$\n[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-1 & 2 \\\\ -4 & 8\\end{aligned}]\\cdot [\\begin{aligned}u \\\\ v\\end{aligned}]+[\\begin{aligned}3 \\\\ -1\\end{aligned}].\n$$\n\n \nWhat would be the image of the quadrilateral shown above under the action of $T?$" :question/worked-solution "Recall that for any affine transformation \n\n$$\nT:u⟶Au+b,\n$$\n\nwhere $A$ is a $2\\times 2$ matrix and $u$ and $b$ are $2\\times 1$ column vectors, we have one of the following three possibilities:\n\n- If $T$ is non-singular, i.e., when $det(A)\\ne 0,$ then the image of a two-dimensional object is a two-dimensional object. In particular, the image of a polygon with $n$ vertices is a polygon with $n$ vertices.\n\n- If $T$ is singular, i.e., when $det(A)=0,$ we have two additional subcases:\n\n- If $A$ has at least one nonzero entry, then the image of a two-dimensional object is a one-dimensional line segment.\n\n- If $A$ is the zero matrix, then the image of a two-dimensional object is a point on the plane.\n\nWith that in mind, let's examine our transformation.\n\nNotice that the matrix representation of the linear transformation associated with $T$ is \n$A=[\\begin{aligned}-1 & 2 \\\\ -4 & 8\\end{aligned}].$\n\nComputing the determinant of $A,$ we obtain\n\n$$\n\\begin{aligned}det(T) & =|\\begin{aligned}-1 & 2 \\\\ -4 & 8\\end{aligned}| \\\\  & =(-1)\\cdot 8-(-4)\\cdot 2 \\\\  & =0.\\end{aligned}\n$$\n\nSo, we have a singular nonzero matrix. \n\nTherefore, $T$ is non-invertible, and the image of the quadrilateral under the action of $T$ is a line segment."} :step/id #uuid "57a42c1b-28d8-57a5-acfd-dd199e88f044"} {:db/id #edb/ref 17592186412069 :step/content {:db/id #edb/ref 17592186281414 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "411cf09f-aaa8-5213-a15d-e483b24650c1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A tetrahedron" :db/id #edb/ref 17592186279170} {:answer/id #uuid "87fc0aa9-2d9d-5344-8ce5-d4d954e92fb5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A triangle" :db/id #edb/ref 17592186279807} {:answer/id #uuid "99cffdbb-a38c-5a63-9d04-87167a638bb7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A point" :db/id #edb/ref 17592186279951} {:answer/id #uuid "d5f74625-2c51-5fb6-83b9-61fbae0292bb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A quadrilateral" :db/id #edb/ref 17592186280479} {:answer/id #uuid "e51121c0-fae9-532e-b1aa-79a388ca1f2d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A line segment" :db/id #edb/ref 17592186280613}] :answer-field/correct {:db/id #edb/ref 17592186279807} :answer-field/id #uuid "aec2e96d-de39-5f66-aab1-77904959b9e7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186281132}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0a795336-4ab0-5101-bbca-aa94f4ca2a93" :question/math-academy-id "q-162214" :question/problem "![](images/00/00151dc7a58722a649a52494434950695a27cb4e7cad14f32f76abbddf629a91.png)\n\nConsider the affine transformation $T,$ given by\n\n$$\nx=u-3v+2,\\,y=4v-1.\n$$\n\nWhat would be the image of the triangle shown above under the action of $T?$" :question/worked-solution "Recall that for any affine transformation \n\n$$\nT:u⟶Au+b,\n$$\n\nwhere $A$ is a $2\\times 2$ matrix and $u$ and $b$ are $2\\times 1$ column vectors, we have one of the following three possibilities:\n\n- If $T$ is non-singular, i.e., when $det(A)\\ne 0,$ then the image of a two-dimensional object is a two-dimensional object. In particular, the image of a polygon with $n$ vertices is a polygon with $n$ vertices.\n\n- If $T$ is singular, i.e., when $det(A)=0,$ we have two additional subcases:\n\n- If $A$ has at least one nonzero entry, then the image of a two-dimensional object is a one-dimensional line segment.\n\n- If $A$ is the zero matrix, then the image of a two-dimensional object is a point on the plane.\n\nWith that in mind, let's examine our transformation.\n\nThe given transformation can be expressed as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}] & =[\\begin{aligned}u-3v+2 \\\\ 4v-1\\end{aligned}] \\\\  & =[\\begin{aligned}u-3v \\\\ 4v\\end{aligned}]+[\\begin{aligned}2 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -3 \\\\ 0 & 4\\end{aligned}]\\cdot [\\begin{aligned}u \\\\ v\\end{aligned}]+[\\begin{aligned}2 \\\\ -1\\end{aligned}].\\end{aligned}\n$$\n\nNotice that the matrix representation of the linear transformation associated with $T$ is \n$A=[\\begin{aligned}1 & -3 \\\\ 0 & 4\\end{aligned}].$\n\nComputing the determinant of $A,$ we obtain\n\n$$\n\\begin{aligned}det(T) & =|\\begin{aligned}1 & -3 \\\\ 0 & 4\\end{aligned}| \\\\  & =1\\cdot 4-0\\cdot (-3) \\\\  & =4 \\\\  & \\ne 0.\\end{aligned}\n$$\n\nSo, we have a non-singular matrix. \n\nTherefore, $T$ is invertible and the image of the triangle under the action of $T$ is a triangle."} :step/id #uuid "5d41d9ac-1e31-5132-8e1e-f51eb5e05b80" :step/next {:db/id #edb/ref 17592186412068}} {:db/id #edb/ref 17592186412070 :step/content {:db/id #edb/ref 17592186259659 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23580040-99be-5f75-be43-adefd3cbfade" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186257077} {:answer/id #uuid "58e9a951-d5aa-5d93-8ae3-c1349449a5e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186257554} {:answer/id #uuid "8cc83444-b44c-54bf-83b7-307d0775c0bb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{13}{3}" :db/id #edb/ref 17592186258020} {:answer/id #uuid "b1de513c-2a81-54b9-9e95-c28eb012ca2a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{10}{3}" :db/id #edb/ref 17592186258331} {:answer/id #uuid "f8c13e37-05bf-5042-b338-1fc4c401c1ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186258964}] :answer-field/correct {:db/id #edb/ref 17592186257077} :answer-field/id #uuid "c3cd215d-51f0-56ca-9929-c005182aeb03" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186259373}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "6d452c80-d748-5af8-bbed-4f41e3a6ab8b" :question/math-academy-id "q-124314" :question/problem "The affine transformation $T$ is defined as\n\n$$\nx=2u-3v+2,\\,y=6v-3u-4.\n$$\n\nGiven that the inverse transformation ${T}^{-1}$ of $T$ is\n\n$$\nu=2x+y+a,\\,v=x+by+c,\n$$\n\nwhat is the value of $a+b+c?$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nReversing the action of $T,$ we get\n\n$$\n\\begin{aligned}Au+b & =x \\\\ Au & =x-b \\\\ u & ={A}^{-1}(x-b).\\end{aligned}\n$$\n\nSo, writing our transformation in matrix form, we have\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}] & =[\\begin{aligned}2u-3v+2 \\\\ 6v-3u-4\\end{aligned}] \\\\  & =[\\begin{aligned}2u-3v \\\\ -3u+6v\\end{aligned}]+[\\begin{aligned}2 \\\\ -4\\end{aligned}] \\\\  & ={{[\\begin{aligned}2 & -3 \\\\ -3 & 6\\end{aligned}]}_{⏟}}_{A}\\cdot {{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u}+{{[\\begin{aligned}2 \\\\ -4\\end{aligned}]}_{⏟}}_{b}.\\end{aligned}\n$$\n\nNext, we calculate the inverse of $A:$\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{6\\cdot 2-(-3)\\cdot (-3)}[\\begin{aligned}6 & 3 \\\\ 3 & 2\\end{aligned}] \\\\  & =\\frac{1}{3}[\\begin{aligned}6 & 3 \\\\ 3 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 1 \\\\ 1 & \\frac{2}{3}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the inverse transformation ${T}^{-1}$ is\n\n$$\n\\begin{aligned}{{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u} & ={{[\\begin{aligned}2 & 1 \\\\ 1 & \\frac{2}{3}\\end{aligned}]}_{⏟}}_{{A}^{-1}}\\cdot ({{[\\begin{aligned}x \\\\ y\\end{aligned}]}_{⏟}}_{x}-{{[\\begin{aligned}2 \\\\ -4\\end{aligned}]}_{⏟}}_{b}) \\\\  & =[\\begin{aligned}2 & 1 \\\\ 1 & \\frac{2}{3}\\end{aligned}][\\begin{aligned}x-2 \\\\ y+4\\end{aligned}] \\\\  & =[\\begin{aligned}2\\cdot (x-2)+1\\cdot (y+4) \\\\ 1\\cdot (x-2)+(\\frac{2}{3})\\cdot (y+4)\\end{aligned}] \\\\  & =[\\begin{aligned}2x+y \\\\ x+\\frac{2}{3}y+\\frac{2}{3}\\end{aligned}]\\end{aligned}\n$$\n\nEquating the corresponding components, the inverse transformation ${T}^{-1}$ in coordinate form is\n\n$$\nu=2x+y+0,\\,v=x+\\frac{2}{3}y+\\frac{2}{3}.\n$$\n\nTherefore, we have\n\n$$\na+b+c=0+\\frac{2}{3}+\\frac{2}{3}=\\frac{4}{3}.\n$$"} :step/id #uuid "7e79ca9f-a884-5f7c-a928-03d9e0201c9a" :step/next {:db/id #edb/ref 17592186412069}} {:db/id #edb/ref 17592186412071 :step/content {:db/id #edb/ref 17592186259649 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bed1340-8927-5ff0-ba69-b2b93cdd78e8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186256896} {:answer/id #uuid "81fb632e-14da-5038-b6f9-74ec0da963a5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186257937} {:answer/id #uuid "82d7f633-617d-5497-a90c-a0550510c2f6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186257941} {:answer/id #uuid "d5507f11-f2dc-54ed-aa00-8c211067e5e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186258649} {:answer/id #uuid "e3817db8-3192-5a2c-ad51-eb7cb8e7b55c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186258760}] :answer-field/correct {:db/id #edb/ref 17592186258649} :answer-field/id #uuid "fa29d767-9911-5a05-a828-3b3c81faca3c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186259473}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f20eb077-8cae-5138-ae0e-248f60ff9fb8" :question/math-academy-id "q-124280" :question/problem "The affine transformation $T$ is defined as\n\n$$\nx=2-u-v,\\,y=3u+4v-1.\n$$\n\nGiven that the inverse transformation ${T}^{-1}$ of $T$ is\n\n$$\nu=7+ax-y,\\,v=bx+y+c,\n$$\n\nwhat is the value of $a+b+c?$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nReversing the action of $T,$ we get\n\n$$\n\\begin{aligned}Au+b & =x \\\\ Au & =x-b \\\\ u & ={A}^{-1}(x-b).\\end{aligned}\n$$\n\nSo, writing our transformation in matrix form, we have\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}] & =[\\begin{aligned}2-u-v \\\\ 3u+4v-1\\end{aligned}] \\\\  & =[\\begin{aligned}-u-v \\\\ 3u+4v\\end{aligned}]+[\\begin{aligned}2 \\\\ -1\\end{aligned}] \\\\  & ={{[\\begin{aligned}-1 & -1 \\\\ 3 & 4\\end{aligned}]}_{⏟}}_{A}\\cdot {{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u}+{{[\\begin{aligned}2 \\\\ -1\\end{aligned}]}_{⏟}}_{b}.\\end{aligned}\n$$\n\nNext, we calculate the inverse of $A:$\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{4\\cdot (-1)-(-1)\\cdot 3}[\\begin{aligned}4 & 1 \\\\ -3 & -1\\end{aligned}] \\\\  & =\\frac{1}{-1}[\\begin{aligned}4 & 1 \\\\ -3 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}-4 & -1 \\\\ 3 & 1\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the inverse transformation ${T}^{-1}$ is\n\n$$\n\\begin{aligned}{{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u} & ={{[\\begin{aligned}-4 & -1 \\\\ 3 & 1\\end{aligned}]}_{⏟}}_{{A}^{-1}}\\cdot ({{[\\begin{aligned}x \\\\ y\\end{aligned}]}_{⏟}}_{x}-{{[\\begin{aligned}2 \\\\ -1\\end{aligned}]}_{⏟}}_{b}) \\\\  & =[\\begin{aligned}-4 & -1 \\\\ 3 & 1\\end{aligned}][\\begin{aligned}x-2 \\\\ y+1\\end{aligned}] \\\\  & =[\\begin{aligned}-4\\cdot (x-2)+(-1)\\cdot (y+1) \\\\ 3\\cdot (x-2)+1\\cdot (y+1)\\end{aligned}] \\\\  & =[\\begin{aligned}7-4x-y \\\\ 3x+y-5\\end{aligned}]\\end{aligned}\n$$\n\nEquating the corresponding components, the inverse transformation ${T}^{-1}$ in coordinate form is\n\n$$\nu=7+(-4)x-y,\\,v=3x+y+(-5).\n$$\n\nTherefore, we have\n\n$$\na+b+c=-4+3+(-5)=-6.\n$$"} :step/id #uuid "d9eae084-1f11-516b-9c30-618279f69755" :step/next {:db/id #edb/ref 17592186412070}} {:db/id #edb/ref 17592186412072 :step/content {:db/id #edb/ref 17592186179995 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0086e1d8-f0ee-53c6-8443-35f56170d9d8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-11" :db/id #edb/ref 17592186256787} {:answer/id #uuid "0d67fff4-252d-5baa-b919-6e2e71d71094" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186256912} {:answer/id #uuid "80d9c10d-d8ce-5ef8-9f6d-73c22d791bad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11" :db/id #edb/ref 17592186257926} {:answer/id #uuid "d0f2b7b2-0f28-5166-96d2-007456d5faee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-9" :db/id #edb/ref 17592186258602} {:answer/id #uuid "d1a8a822-04f8-5fb6-8bb9-09b853fcf229" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-8" :db/id #edb/ref 17592186258608}] :answer-field/correct {:db/id #edb/ref 17592186258602} :answer-field/id #uuid "79824dff-905f-590c-af91-7c9745e11bfb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186259237}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "24203ad0-c666-584c-ace2-35e7e7f927ec" :question/math-academy-id "q-124117" :question/problem "The matrix form of the affine transformation $T$ is given by\n\n$$\n[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}2 & 1 \\\\ 5 & 2\\end{aligned}]\\cdot [\\begin{aligned}u \\\\ v\\end{aligned}]+[\\begin{aligned}2 \\\\ 1\\end{aligned}].\n$$\n\nFind $a+b+c,$ given that the matrix form of the inverse transformation ${T}^{-1}$ is given by\n\n$$\n[\\begin{aligned}u \\\\ v\\end{aligned}]=[\\begin{aligned}a & b \\\\ 5 & -2\\end{aligned}]\\cdot [\\begin{aligned}x \\\\ y\\end{aligned}]+[\\begin{aligned}3 \\\\ c\\end{aligned}].\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nReversing the action of $T,$ we get\n\n$$\n\\begin{aligned}Au+b & =x \\\\ Au & =x-b \\\\ u & ={A}^{-1}(x-b).\\end{aligned}\n$$\n\nThe matrix form of $T$ gives us the following information:\n\n$$\n{{[\\begin{aligned}2 & 1 \\\\ 5 & 2\\end{aligned}]}_{⏟}}_{A}\\cdot {{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u}+{{[\\begin{aligned}2 \\\\ 1\\end{aligned}]}_{⏟}}_{b}\n$$\n\nNext, we calculate the inverse of $A:$\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{2\\cdot 2-1\\cdot 5}[\\begin{aligned}2 & -1 \\\\ -5 & 2\\end{aligned}] \\\\  & =\\frac{1}{-1}[\\begin{aligned}2 & -1 \\\\ -5 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & 1 \\\\ 5 & -2\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the inverse transformation ${T}^{-1}$ is\n\n$$\n\\begin{aligned}{{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u} & ={{[\\begin{aligned}-2 & 1 \\\\ 5 & -2\\end{aligned}]}_{⏟}}_{{A}^{-1}}\\cdot ({{[\\begin{aligned}x \\\\ y\\end{aligned}]}_{⏟}}_{x}-{{[\\begin{aligned}2 \\\\ 1\\end{aligned}]}_{⏟}}_{b}) \\\\  & =[\\begin{aligned}-2 & 1 \\\\ 5 & -2\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]-[\\begin{aligned}-2 & 1 \\\\ 5 & -2\\end{aligned}][\\begin{aligned}2 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & 1 \\\\ 5 & -2\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]-[\\begin{aligned}-3 \\\\ 8\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & 1 \\\\ 5 & -2\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]+[\\begin{aligned}3 \\\\ -8\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=-2+1+(-8)=-9.\n$$"} :step/id #uuid "e391a44c-ebaa-5dea-a1f8-4caf64dd590c" :step/next {:db/id #edb/ref 17592186412071}}] :activity/title "The Inverse of an Affine Transformation" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186412067}] [{:activity/expected-seconds 480.0 :activity/first-step {:db/id #edb/ref 17592186176753} :activity/id #uuid "a82f82dc-e433-5288-bb71-1269a1685809" :activity/scope {:db/id #edb/ref 17592186048516 :topic/id #uuid "a5effb25-537a-5891-b350-6a8d3f357154" :topic/math-academy-id 3642} :activity/steps [{:db/id #edb/ref 17592186176685 :step/content {:db/id #edb/ref 17592186175958 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175804 :question/id #uuid "5e71fcd7-b782-5399-979f-fd62607b5653" :question/math-academy-id "e-7421"} :knowledge-point/id #uuid "33fca834-0063-5252-832f-5efb4be6e599" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050775}] :knowledge-point/questions [{:db/id #edb/ref 17592186176583} {:db/id #edb/ref 17592186176584} {:db/id #edb/ref 17592186366952} {:db/id #edb/ref 17592186366959} {:db/id #edb/ref 17592186366966} {:db/id #edb/ref 17592186367054} {:db/id #edb/ref 17592186367061} {:db/id #edb/ref 17592186382895} {:db/id #edb/ref 17592186382915} {:db/id #edb/ref 17592186382922} {:db/id #edb/ref 17592186416523}] :knowledge-point/title "Simplifying Expressions Using the Properties of Expected Value"} :step/id #uuid "7c87517d-0124-503b-ad8d-9d75e2bcf4c6" :step/math-academy-id 27507} {:db/id #edb/ref 17592186176741 :step/content {:db/id #edb/ref 17592186175991 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175842 :question/id #uuid "46566681-c2e4-53e1-83c4-d438cabc8066" :question/math-academy-id "e-9106"} :knowledge-point/id #uuid "0c105dd8-6739-5889-a529-9182ea814d76" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048317}] :knowledge-point/questions [{:db/id #edb/ref 17592186176229} {:db/id #edb/ref 17592186176253} {:db/id #edb/ref 17592186367033} {:db/id #edb/ref 17592186367040} {:db/id #edb/ref 17592186367047} {:db/id #edb/ref 17592186367205} {:db/id #edb/ref 17592186367212} {:db/id #edb/ref 17592186416522}] :knowledge-point/title "Calculating the Second Moment of a Random Variable"} :step/id #uuid "e4a2022f-0bfe-53a7-a3a3-924b5ed19a7c" :step/math-academy-id 33947 :step/next {:db/id #edb/ref 17592186176751}} {:db/id #edb/ref 17592186176751 :step/content {:db/id #edb/ref 17592186177003 :tutorial/content "Suppose that $X$ is a discrete random variable with probability mass function $f(x)$ defined over $S.$\n\nThe values $\\textrm E[X]$ and $\\textrm E[X^2]$ are called the **first moment** and **second moment**, respectively. \n\nIt's also possible to define higher moments. For example, $\\textrm E[X^3]$ is the **third moment. **\n\nNotice the pattern:\n\n- $\\displaystyle \\textrm E[X] =  \\sum\\limits_{x \\in S} x \\cdot f(x)$ is the first moment\n\n- $\\displaystyle \\textrm E[X^2] = \\sum\\limits_{x \\in S} x^2 \\cdot f(x)$ is the second moment\n\n- $\\displaystyle \\textrm E[X^3] = \\sum\\limits_{x \\in S} x^3 \\cdot f(x)$ is the third moment\n\n- $\\,\\cdots$\n\nIn general, the $n$th  moment is given by\n\n$$\n\\displaystyle \\textrm E[X^n] = \\sum\\limits_{x \\in S} x^n \\cdot f(x).\n$$\n\nThe concept of a moment will become important later. In particular, we'll soon see how $\\textrm{E}[X^2]$ can be used to compute the **variance** of a random variable.\n\nFinally, note that $\\textrm E[X], \\textrm E[X^2], \\textrm E[X^3],$ etc. are sometimes referred to as the first, second, and third **raw moments**. This is because it's possible to define other types of moment. \n\nIn general, $\\textrm{E}[X^n]$ can be called either the $n$th *moment* or $n$th *raw moment*." :tutorial/id #uuid "0f377288-40af-50ed-b77c-90edf07bb005" :tutorial/math-academy-id 5499 :tutorial/title "The Moments of a Random Variable"} :step/id #uuid "77279341-1e22-5bb1-bd2c-8981a3235685" :step/math-academy-id 34228 :step/next {:db/id #edb/ref 17592186176847}} {:db/id #edb/ref 17592186176753 :step/content {:db/id #edb/ref 17592186177004 :tutorial/content "Recall that for a discrete random variable $X$ defined over a set $S,$ the expected value of $X,$ denoted $\\textrm E[X],$ is given by\n\n$$\n\\textrm E[X] = \\sum\\limits_{x \\in S} x \\cdot f(x),\n$$\n\nwhere $f(x)$ is the probability mass function of $X.$ \n\nTherefore, we can calculate the expected value of the random variable $X^2$ as\n\n$$\n\\textrm E[X^2] = \\sum\\limits_{x \\in S} x^2 \\cdot f(x).\n$$\n\nFor example, suppose that the random variable $X$ has the following probability distribution.\n\n| $x$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- |\n| $f(x)$ | $0.25$ | $0.5$ | $0.25$ |\n\nIn this case, $\\textrm E[X^2]$ is given by\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\sum }_{x\\in S}{x}^{2}\\cdot f(x) \\\\  & ={1}^{2}\\cdot 0.25+{2}^{2}\\cdot 0.5+{3}^{2}\\cdot 0.25 \\\\  & =1\\cdot 0.25+4\\cdot 0.5+9\\cdot 0.25 \\\\  & =4.5.\\end{aligned}\n$$\n\n**Watch out!** When computing $\\textrm E[X^2],$ it's important to remember that we still evaluate the probability mass function as $f(x),$ *not* $f(x^2).$" :tutorial/id #uuid "544551ff-1bd9-5834-8bed-084fe6b81425" :tutorial/math-academy-id 5503 :tutorial/title "Introduction"} :step/id #uuid "e5dae560-1167-5534-8639-30d7fa5c56b5" :step/math-academy-id 34238 :step/next {:db/id #edb/ref 17592186176741}} {:db/id #edb/ref 17592186176847 :step/content {:db/id #edb/ref 17592186176042 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175689 :question/id #uuid "69fdace0-5c5b-519b-b03b-40fd523915f6" :question/math-academy-id "e-10128"} :knowledge-point/id #uuid "ebfe6309-b8a3-5e4c-b2ae-495a91bcc433" :knowledge-point/questions [{:db/id #edb/ref 17592186176375} {:db/id #edb/ref 17592186176376} {:db/id #edb/ref 17592186367568} {:db/id #edb/ref 17592186367575} {:db/id #edb/ref 17592186367582} {:db/id #edb/ref 17592186367589} {:db/id #edb/ref 17592186367596} {:db/id #edb/ref 17592186383480} {:db/id #edb/ref 17592186383487} {:db/id #edb/ref 17592186410426}] :knowledge-point/title "Calculating Higher Moments of a Random Variable"} :step/id #uuid "f44e66b4-ae69-5a8a-b61a-38a70551aa2f" :step/math-academy-id 38212 :step/next {:db/id #edb/ref 17592186176685}}] :activity/title "Moments of Discrete Random Variables" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186176159}] [{:activity/expected-seconds 600.0 :activity/first-step {:db/id #edb/ref 17592186193666} :activity/id #uuid "3166e137-4d3f-5719-abca-e284bb2446a8" :activity/scope {:db/id #edb/ref 17592186048744 :topic/id #uuid "ba8cd959-4cba-5c60-858b-f7ee86680552" :topic/math-academy-id 4043} :activity/steps [{:db/id #edb/ref 17592186193611 :step/content {:db/id #edb/ref 17592186192753 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192472 :question/id #uuid "65070836-e061-5fec-ae8d-263ef0c32659" :question/math-academy-id "e-10839"} :knowledge-point/id #uuid "fe4b690c-94a9-5a27-b0e8-5583ba6dba19" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049638}] :knowledge-point/questions [{:db/id #edb/ref 17592186192957} {:db/id #edb/ref 17592186193389} {:db/id #edb/ref 17592186275461} {:db/id #edb/ref 17592186275466} {:db/id #edb/ref 17592186275467} {:db/id #edb/ref 17592186278193} {:db/id #edb/ref 17592186406919} {:db/id #edb/ref 17592186406922} {:db/id #edb/ref 17592186419855}] :knowledge-point/title "Computing the Probability That a Random Variable Lies Within a Bounded Interval"} :step/id #uuid "a3e6cf46-1327-5a3a-8953-f8f5c744aa8d" :step/math-academy-id 41078 :step/next {:db/id #edb/ref 17592186193665}} {:db/id #edb/ref 17592186193665 :step/content {:db/id #edb/ref 17592186192788 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192512 :question/id #uuid "d8425df8-1fb2-5f59-a034-2b30f14b9b4b" :question/math-academy-id "e-11036"} :knowledge-point/id #uuid "1e723a34-c6e1-5827-87ad-866cbaeef98c" :knowledge-point/questions [{:db/id #edb/ref 17592186193181} {:db/id #edb/ref 17592186193393} {:db/id #edb/ref 17592186275458} {:db/id #edb/ref 17592186275459} {:db/id #edb/ref 17592186275460} {:db/id #edb/ref 17592186275462} {:db/id #edb/ref 17592186275464} {:db/id #edb/ref 17592186275465} {:db/id #edb/ref 17592186278194} {:db/id #edb/ref 17592186406921} {:db/id #edb/ref 17592186406923} {:db/id #edb/ref 17592186419854}] :knowledge-point/title "Computing the Probability That a Random Variable Lies Within an Unbounded Interval"} :step/id #uuid "f94672ce-3841-5241-8adb-0cd157483370" :step/math-academy-id 41927 :step/next {:db/id #edb/ref 17592186193667}} {:db/id #edb/ref 17592186193666 :step/content {:db/id #edb/ref 17592186193886 :tutorial/content "Recall that the **probability density function** (or **pdf**) of a continuous random variable $X$ defined over a set $S$ is a function $f(x)$ that satisfies the following conditions:\n\n- $f(x) \\geq 0$ for all $x$ in $S$\n\n- $\\displaystyle \\int_{S} f(x) \\, \\textrm dx = 1$\n\nThe probability that $X$ lies in the interval $[a,b]$ is given by\n\n$$\nP(a \\leq X \\leq b) = \\int_a^b f(x) \\, \\textrm dx.\n$$\n\nThis probability can be interpreted as the area bounded between $f(x)$ and the $x$-axis over the interval $x\\in [a,b],$ as shown below.\n\n![](images/e6/e6c21e69a0dbd15ce32d18c2e74d8fcab0276e82bc55b354eaa5140adff610e6.png)\n\nAlso, remember that for continuous random variables, we get the same answer whether or not we include the endpoints of an interval $[a,b].$ In other words,\n\n$$\nP(a \\leq X \\leq b) = P(a < X < b)  = P(a < X \\leq b) = P(a \\leq X < b).\n$$\n\nIn this lesson, we'll get some practice at computing probabilities with continuous random variables." :tutorial/id #uuid "a6c7afdc-da68-55d5-aaa4-9ff1c77b6740" :tutorial/math-academy-id 6926 :tutorial/title "Introduction"} :step/id #uuid "167eafc7-5e80-5952-9c5c-541b7d78828f" :step/math-academy-id 41930 :step/next {:db/id #edb/ref 17592186193611}} {:db/id #edb/ref 17592186193667 :step/content {:db/id #edb/ref 17592186192789 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192513 :question/id #uuid "4baa68f1-2f68-5df5-936a-aff56605ed8e" :question/math-academy-id "e-11038"} :knowledge-point/id #uuid "17408f35-ef57-5eb2-8cb6-3a946194d2d3" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050215}] :knowledge-point/questions [{:db/id #edb/ref 17592186193177} {:db/id #edb/ref 17592186193180} {:db/id #edb/ref 17592186275473} {:db/id #edb/ref 17592186275474} {:db/id #edb/ref 17592186275475} {:db/id #edb/ref 17592186275477} {:db/id #edb/ref 17592186278184} {:db/id #edb/ref 17592186278185} {:db/id #edb/ref 17592186278187} {:db/id #edb/ref 17592186278189} {:db/id #edb/ref 17592186406920} {:db/id #edb/ref 17592186419853}] :knowledge-point/title "Calculating Probabilities With Piecewise PDFs"} :step/id #uuid "c5ab4c4d-fb97-5d7e-a711-dca2df3d7318" :step/math-academy-id 41936}] :activity/title "Calculating Probabilities With Continuous Random Variables" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186192912}] [{:activity/expected-seconds 660.0 :activity/first-step {:db/id #edb/ref 17592186199073} :activity/id #uuid "ad7b60fb-b35c-5961-9636-cd37dd5c65f3" :activity/scope {:db/id #edb/ref 17592186049070 :topic/id #uuid "d79ee816-b7eb-5805-856a-502f9a6adaa4" :topic/math-academy-id 4386} :activity/steps [{:db/id #edb/ref 17592186199073 :step/content {:db/id #edb/ref 17592186199555 :tutorial/content "Recall that a set is **finite** if it contains a finite number of elements and is **infinite** if it has infinitely many elements.\n\nIn this lesson, we'll determine whether a set given in set-builder notation is finite or infinite.\n\nFor example, let's determine which of the following sets are finite and which are infinite:\n\n$$\n\\begin{aligned}A={n\\in Z\\,:\\,|2n|\\le 8},\\,B={q\\in Q\\,:\\,|2q|\\le 8},\\,C={x\\in R\\,:\\,|2x|\\le 8}\\end{aligned}\n$$\n\nNotice that all three sets are defined using a conditional definition with the same restricting inequality defined over different universal sets ($\\mathbb{Z},$ $\\mathbb{Q},$ and $\\mathbb{R}$).\n\nFirstly, since $\\mathbb Z\\subset \\mathbb Q \\subset \\mathbb R,$ we start by solving the restricting inequality $|2x| \\leq 8$ for $x\\in \\mathbb R{:}$\n\n$$\n\\begin{aligned}|2x|\\le 8 \\\\ 2|x|\\le 8 \\\\ |x|\\le 4\\end{aligned}\n$$\n\nThis inequality has the solution\n\n$$\n-4 \\leq x \\leq 4.\n$$\n\nFor convenience, we'll express our solution in interval notation as $x\\in I,$ where $I=\\left[-4,4\\right].$ \n\nNow, before we analyze our sets, we need to state a couple of theorems:\n\n ** *Theorem 1* **: *Every real interval of nonzero length contains infinitely many rational numbers.*\n\n ** *Theorem 2* **: *If $X$ is infinite and $X\\subseteq Y,$ then $Y$ is infinite.*\n\nWe're now ready to determine whether $A, B,$ and $C$ are finite or infinite:\n\n- Set $A$ is finite. If $n \\in \\mathbb{Z},$ the solutions to the inequality $|2n| \\leq 8$ are all the *integers* that lie in the interval $I.$ Therefore, \n\n$$\nA = \\{0,\\pm 1, \\pm 2, \\pm 3, \\pm 4\\}.\n$$\n\nConsequently, $|A| = 9,$ which is finite.\n\n- Set $B$ is infinite. If $q \\in \\mathbb{Q},$ the solutions to $|2q| \\leq 8$ are all the *rational* numbers in the interval $I.$ Since any real interval of nonzero length contains infinitely many rational numbers (by Theorem 1), it follows that $B$ is infinite.\n\n- Set $C$ is infinite. Since $B$ is infinite, and $B \\subset C,$ it follows that $C$ is infinite (by Theorem 2).\n\nTherefore, we conclude that $A$ is finite, while $B$ and $C$ are infinite. \n\nLet's see some more examples." :tutorial/id #uuid "32f4b216-b9df-5b0b-a06c-f22d30a51693" :tutorial/math-academy-id 8231 :tutorial/title "Introduction"} :step/id #uuid "9618b821-6d6c-5a8b-b57f-4d5b54ebec92" :step/math-academy-id 152952 :step/next {:db/id #edb/ref 17592186199074}} {:db/id #edb/ref 17592186199074 :step/content {:db/id #edb/ref 17592186198269 :knowledge-point/canonical-example {:db/id #edb/ref 17592186198156 :question/id #uuid "1a2f8100-8f2e-5c6b-ade3-7192a914323f" :question/math-academy-id "e-13171"} :knowledge-point/id #uuid "efdb77bf-dd8b-5ccc-8265-79bd319afaa3" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048887} {:db/id #edb/ref 17592186048899} {:db/id #edb/ref 17592186049309} {:db/id #edb/ref 17592186050923}] :knowledge-point/questions [{:db/id #edb/ref 17592186198784} {:db/id #edb/ref 17592186198797} {:db/id #edb/ref 17592186287739} {:db/id #edb/ref 17592186287740} {:db/id #edb/ref 17592186287741} {:db/id #edb/ref 17592186287742} {:db/id #edb/ref 17592186287748}] :knowledge-point/title "Sets Defined Using Inequalities"} :step/id #uuid "4bafb049-71f3-53c5-a32d-1189de0b902a" :step/math-academy-id 152953 :step/next {:db/id #edb/ref 17592186199075}} {:db/id #edb/ref 17592186199075 :step/content {:db/id #edb/ref 17592186198270 :knowledge-point/canonical-example {:db/id #edb/ref 17592186198157 :question/id #uuid "3ccf363e-d311-50e9-83b1-929ef1148554" :question/math-academy-id "e-13174"} :knowledge-point/id #uuid "f98332fd-e902-5390-a4d3-4e181ce97219" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048666}] :knowledge-point/questions [{:db/id #edb/ref 17592186198786} {:db/id #edb/ref 17592186198792} {:db/id #edb/ref 17592186287682} {:db/id #edb/ref 17592186287715} {:db/id #edb/ref 17592186287716} {:db/id #edb/ref 17592186287717} {:db/id #edb/ref 17592186396641} {:db/id #edb/ref 17592186420329} {:db/id #edb/ref 17592186420331}] :knowledge-point/title "Sets Defined Using Trigonometric Equations"} :step/id #uuid "33c8e980-5213-53fa-ae32-f3d881db66cd" :step/math-academy-id 152956 :step/next {:db/id #edb/ref 17592186199076}} {:db/id #edb/ref 17592186199076 :step/content {:db/id #edb/ref 17592186198271 :knowledge-point/canonical-example {:db/id #edb/ref 17592186198158 :question/id #uuid "359028be-0c1d-5f5c-ace7-3d7aeb36d9e6" :question/math-academy-id "e-13175"} :knowledge-point/id #uuid "26758016-ed47-562a-9338-85c71ffbeaa9" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050271} {:db/id #edb/ref 17592186050367} {:db/id #edb/ref 17592186050690} {:db/id #edb/ref 17592186050789} {:db/id #edb/ref 17592186050902}] :knowledge-point/questions [{:db/id #edb/ref 17592186198787} {:db/id #edb/ref 17592186198791} {:db/id #edb/ref 17592186287683} {:db/id #edb/ref 17592186287708} {:db/id #edb/ref 17592186287711} {:db/id #edb/ref 17592186287712} {:db/id #edb/ref 17592186287713} {:db/id #edb/ref 17592186287714} {:db/id #edb/ref 17592186287731} {:db/id #edb/ref 17592186420330} {:db/id #edb/ref 17592186420332}] :knowledge-point/title "Sets Defined Using Derivatives"} :step/id #uuid "979c5557-fc2a-5482-9427-3b8b74b9e995" :step/math-academy-id 152959}] :activity/title "Infinite Sets" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186198531}] [{:activity/first-step {:db/id #edb/ref 17592186199425} :activity/id #uuid "572640c2-48d2-5508-9b8f-be1309fc61e3" :activity/scope {:db/id #edb/ref 17592186049076 :topic/id #uuid "d8ad0390-dfee-58d8-ac50-00cbfdc660af" :topic/math-academy-id 4393} :activity/steps [{:db/id #edb/ref 17592186199425 :step/content {:db/id #edb/ref 17592186199577 :tutorial/content "As previously seen, we can define sets using so-called *constructive definitions* of the form\n\n$$\n\\big\\{ {\\color{blue}\\textrm{rule}} \\: : \\: {\\color{blue}\\textrm{base set}} \\big\\}\n$$\n\n \n\nwhere the ${\\color{blue}\\textrm{rule}}$ is an expression (or formula) that depends on a variable that *constructs* elements of our set when the variable runs over some ${\\color{blue}\\textrm{base set}}.$ \n\nFor example, the set $A,$ given by\n\n$$\nA = \\big\\{ 2n+1\\, : \\, n\\in\\mathbb N_0 \\big \\}\n$$\n\nis defined constructively and contains all positive odd numbers:\n\n$$\n\\begin{aligned}A & ={2n+1\\,:\\,n\\in {N}_{0}} \\\\  & ={2(0)+1,\\,2(1)+1,\\,2(2)+1,\\,2(3)+1,\\,…} \\\\  & ={1,3,5,7,…}\\end{aligned}\n$$\n\n \n\nSometimes, it's helpful to write a set using a constructive definition. For example, how might we express the following set constructively?\n\n$$\nB = \\big\\{ 4, 7, 10, 13, \\ldots \\big\\}\n$$\n\nFirst, notice that the elements of our set \n\n$$\n4,\\quad 7,\\quad 10,\\quad 13,\\quad \\ldots\n$$\n\nform an arithmetic sequence with common difference $d=3{:}$\n\n$$\n\\begin{aligned}d & =3 \\\\  & =7-4 \\\\  & =10-7 \\\\  & =13-10 \\\\  & ⋮\\end{aligned}\n$$\n\nSo, the $n$th term $a_n$ of our sequence for $n\\in\\mathbb N$ is given by\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)\\cdot d \\\\  & =4+(n-1)\\cdot 3 \\\\  & =4+3n-3 \\\\  & =3n+1.\\end{aligned}\n$$\n\nTherefore, we can define our set constructively as follows:\n\n$$\nB = \\big\\{ 3n+1 \\: : \\: n \\in \\mathbb{N} \\big\\}\n$$\n\nThe expression $3n+1$ generates the elements of our set when $n$ runs over $\\mathbb{N}.$ \n\nNote the following:\n\n- A bar \"$\\mid$\" is just as acceptable as a colon to separate the rule from the base set. So, we could also express our set as follows:\n\n$$\nB=\\big\\{ 3n+1 \\: \\mid \\: n \\in \\mathbb{N} \\big\\}\n$$\n\n- The constructive definition of a given set is typically not unique. For example, we could also define $B$ as follows:\n\n$$\nB=\\big\\{ 3n+4 \\: :\\: n \\in \\mathbb{N}_0 \\big\\}\n$$\n\nNotice that we used $\\mathbb N_0$ as the base set.\n\nThis definition does indeed generate all elements of $B{:}$\n\n$$\n\\begin{aligned}{3n+4\\,:\\,n\\in {N}_{0}} & ={3(0)+4,\\,3(1)+4,\\,3(2)+4,\\,3(3)+4,\\,…} \\\\  & ={4,\\,7,\\,10,\\,13,\\,…} \\\\  & =B.\\end{aligned}\n$$" :tutorial/id #uuid "57358da7-7aa7-5201-b3bd-e43581b18a41" :tutorial/math-academy-id 8307 :tutorial/title "Introduction"} :step/id #uuid "95633ec2-0a87-53d4-9845-589ad5e2c472" :step/math-academy-id 67909 :step/next {:db/id #edb/ref 17592186199426}} {:db/id #edb/ref 17592186199426 :step/content {:db/id #edb/ref 17592186198463 :knowledge-point/canonical-example {:db/id #edb/ref 17592186198166 :question/id #uuid "231da77b-8370-543a-abf0-effb78e50802" :question/math-academy-id "e-13186"} :knowledge-point/id #uuid "1c5b3eb6-187f-5f16-a32e-66b0842adfe9" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050157} {:db/id #edb/ref 17592186050367}] :knowledge-point/questions [{:db/id #edb/ref 17592186198843} {:db/id #edb/ref 17592186198872} {:db/id #edb/ref 17592186287858} {:db/id #edb/ref 17592186287860} {:db/id #edb/ref 17592186396282} {:db/id #edb/ref 17592186396295}] :knowledge-point/title "Expressing a Given Set Using an Arithmetic Sequence"} :step/id #uuid "d31b48cd-0396-5a79-94df-84872a357ae8" :step/math-academy-id 67910 :step/next {:db/id #edb/ref 17592186199427}} {:db/id #edb/ref 17592186199427 :step/content {:db/id #edb/ref 17592186198464 :knowledge-point/canonical-example {:db/id #edb/ref 17592186198164 :question/id #uuid "e81a9a3f-3dbb-5244-8ea0-9b967bb5a46f" :question/math-academy-id "e-13184"} :knowledge-point/id #uuid "9df722a8-2db6-5bb8-a69c-b81b33037ab2" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050067}] :knowledge-point/questions [{:db/id #edb/ref 17592186198844} {:db/id #edb/ref 17592186198873} {:db/id #edb/ref 17592186287862} {:db/id #edb/ref 17592186287863} {:db/id #edb/ref 17592186287864} {:db/id #edb/ref 17592186287865} {:db/id #edb/ref 17592186396308}] :knowledge-point/title "Expressing a Given Set Using a Geometric Sequence"} :step/id #uuid "01644308-2657-5bfc-bdad-7c6353f7293a" :step/math-academy-id 67913 :step/next {:db/id #edb/ref 17592186199428}} {:db/id #edb/ref 17592186199428 :step/content {:db/id #edb/ref 17592186199552 :tutorial/content "We can also define sets using so-called *conditional definitions* of the form\n\n$$\n\\{ {\\color{blue}\\textrm{base set}} \\: : \\: {\\color{blue}\\textrm{conditions}} \\}\n$$\n\nwhere our set contains only those elements of the ${\\color{blue}\\textrm{base set}}$ that satisfy the given ${\\color{blue}\\textrm{conditions}}$ (or restrictions).\n\nFor example, the set $A,$ given by\n\n$$\nA = \\{n\\in \\mathbb Z \\::\\: -2\\leq n\\leq 2\\}\n$$\n\nis defined conditionally and contains all integers between $-2$ and $2$ inclusive:\n\n$$\nA = \\{-2,-1,0,1,2\\}\n$$\n\nIt's often helpful to describe sets using conditional definitions. For example, let's rewrite the following set using a conditional definition.\n\n$$\nS = \\big\\{50,51,52,53,\\ldots\\big\\}\n$$\n\nThe set $S$ contains all natural numbers greater than or equal to $50,$ which we can write as follows:\n\n$$\nS = \\{n\\in \\mathbb N \\::\\: n\\geq 50\\}\n$$\n\nThe conditional definition of a set is not unique. We can write down an equivalent definition of $S$ as follows:\n\n$$\nS = \\{n\\in \\mathbb N \\::\\: n\\gt 49\\}\n$$\n\nUnder this definition, $S$ contains all natural numbers greater than $49,$ *excluding* $49.$ \n\nAlthough $\\mathbb N$ is the most natural base set in this instance, we can also define $S$ using the set of integers $\\mathbb Z$ as the base set. For example,\n\n$$\nS = \\{n\\in \\mathbb Z \\::\\: n\\geq 50\\}.\n$$" :tutorial/id #uuid "a5b5e889-bdb2-5707-90ab-be875064cc73" :tutorial/math-academy-id 8228 :tutorial/title "Conditional Definitions of Sets"} :step/id #uuid "82de79d7-d2f1-5a78-845b-a3a4a47ee4c5" :step/math-academy-id 67916 :step/next {:db/id #edb/ref 17592186199429}} {:db/id #edb/ref 17592186199429 :step/content {:db/id #edb/ref 17592186198465 :knowledge-point/canonical-example {:db/id #edb/ref 17592186198150 :question/id #uuid "cfd5a7b6-4ee8-5c66-9b1d-81d1d9a1aee7" :question/math-academy-id "e-13144"} :knowledge-point/id #uuid "f49ef1c2-06de-597c-bf4d-6d613989987e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050035}] :knowledge-point/questions [{:db/id #edb/ref 17592186198842} {:db/id #edb/ref 17592186198868} {:db/id #edb/ref 17592186287843} {:db/id #edb/ref 17592186287847} {:db/id #edb/ref 17592186287848} {:db/id #edb/ref 17592186396254} {:db/id #edb/ref 17592186396272} {:db/id #edb/ref 17592186412792}] :knowledge-point/title "Expressing a Set Using a Conditional Definition"} :step/id #uuid "5ed9a110-74bf-5cdf-8e45-8f23b994a145" :step/math-academy-id 67917 :step/next {:db/id #edb/ref 17592186199430}} {:db/id #edb/ref 17592186199430 :step/content {:db/id #edb/ref 17592186198466 :knowledge-point/canonical-example {:db/id #edb/ref 17592186198165 :question/id #uuid "a67f56bb-352b-5126-84c8-c38fc3d0532c" :question/math-academy-id "e-13185"} :knowledge-point/id #uuid "ad21350b-2e3b-57ee-a28c-32a7bd1b2513" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049645} {:db/id #edb/ref 17592186050455}] :knowledge-point/questions [{:db/id #edb/ref 17592186198789} {:db/id #edb/ref 17592186198794} {:db/id #edb/ref 17592186287732} {:db/id #edb/ref 17592186287849} {:db/id #edb/ref 17592186287851} {:db/id #edb/ref 17592186287852} {:db/id #edb/ref 17592186287853} {:db/id #edb/ref 17592186287857}] :knowledge-point/title "Defining a Set Conditionally Using the Roots of a Polynomial"} :step/id #uuid "03fd2408-ced4-5196-8d53-1d732ef57031" :step/math-academy-id 67920}] :activity/title "Describing Sets Using Set-Builder Notation" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186198534}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186418462} :activity/id #uuid "b1628e49-8c52-59b4-abeb-efcedb34a064" :activity/scope {:db/id #edb/ref 17592186049076 :topic/id #uuid "d8ad0390-dfee-58d8-ac50-00cbfdc660af" :topic/math-academy-id 4393} :activity/steps [{:db/id #edb/ref 17592186418461 :step/content {:db/id #edb/ref 175921