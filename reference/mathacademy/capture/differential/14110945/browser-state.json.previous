      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14110945/observations/diagnostic-15-1207660dd5d1ac3203fe.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14110945/observations/diagnostic-15-1207660dd5d1ac3203fe.png",
      "source_url": "https://mathacademy.com/tasks/14110945/diagnostics/453710",
