"color: red;\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-cD7\"></mjx-c></mjx-mo></mjx-mstyle></mjx-texatom><mjx-tstrut></mjx-tstrut></mjx-mtd></mjx-mtr></mjx-itable></mjx-table></mjx-mtable></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mtable displaystyle=\"true\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"0.8em 0.8em 0.3em\"><mtr><mtd><mi>C</mi><mi>E</mi></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">[</mo><mtable columnalign=\"center\" columnspacing=\"1em\" rowspacing=\"4pt\"><mtr><mtd><mn>2</mn></mtd><mtd><mn>1</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>1</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>1</mn></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">[</mo><mtable columnalign=\"center\" columnspacing=\"1em\" rowspacing=\"4pt\"><mtr><mtd><mn>0</mn></mtd><mtd><mn>1</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>1</mn></mtd><mtd><mn>1</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mo>−</mo><mn>2</mn></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">[</mo><mtable columnalign=\"center\" columnspacing=\"1em\" rowspacing=\"4pt\"><mtr><mtd><mstyle mathcolor=\"lightgray\"><mo>∗</mo></mstyle></mtd><mtd><mn>3</mn></mtd><mtd><mstyle mathcolor=\"lightgray\"><mo>∗</mo></mstyle></mtd></mtr><mtr><mtd><mstyle mathcolor=\"lightgray\"><mo>∗</mo></mstyle></mtd><mtd><mstyle mathcolor=\"lightgray\"><mo>∗</mo></mstyle></mtd><mtd><mstyle mathcolor=\"lightgray\"><mo>∗</mo></mstyle></mtd></mtr><mtr><mtd><mstyle mathcolor=\"lightgray\"><mo>∗</mo></mstyle></mtd><mtd><mstyle mathcolor=\"lightgray\"><mo>∗</mo></mstyle></mtd><mtd><mstyle mathcolor=\"lightgray\"><mo>∗</mo></mstyle></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>≠</mo><msub><mi>I</mi><mn>3</mn></msub><mo>.</mo><mstyle scriptlevel=\"0\"><mspace width=\"1em\"></mspace></mstyle><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"red\"><mo>×</mo></mstyle></mrow></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container>\nSo, statement II is false. </li>\n</ul><p></p>\n<p>Therefore, the correct answer is \"I and III only\".</p>\n</div></div>",
