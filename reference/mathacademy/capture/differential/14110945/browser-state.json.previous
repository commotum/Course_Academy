      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14110945/observations/diagnostic-37-8155d2527ada71b51ccb.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14110945/observations/diagnostic-37-8155d2527ada71b51ccb.png",
