      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14110945/observations/diagnostic-31-ff5fc28d96487c91786c.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14110945/observations/diagnostic-31-ff5fc28d96487c91786c.png",
      "source_url": "https://mathacademy.com/tasks/14110945/diagnostics/453710",
      "captured_at": 1791699027.3058171,
