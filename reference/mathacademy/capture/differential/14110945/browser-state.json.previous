</mtd><mtd><mo>=</mo><msqrt><mo stretchy=\"false\">(</mo><mn>4</mn><msqrt><mn>3</mn></msqrt><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup><mo>+</mo><mo stretchy=\"false\">(</mo><mn>3</mn><msqrt><mn>3</mn></msqrt><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup></msqrt></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><msqrt><mn>16</mn><mo stretchy=\"false\">(</mo><mn>3</mn><mo stretchy=\"false\">)</mo><mo>+</mo><mn>9</mn><mo stretchy=\"false\">(</mo><mn>3</mn><mo stretchy=\"false\">)</mo></msqrt></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><msqrt><mn>48</mn><mo>+</mo><mn>27</mn></msqrt></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><msqrt><mn>75</mn></msqrt></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><mn>5</mn><msqrt><mn>3</mn></msqrt></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
