& 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}1 & 3 \\\\ 3 & 9\\end{aligned}]\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(C-7I)x=0$ gives the eigenvector ${v}_{2}=[\\begin{aligned}-3 \\\\ 1\\end{aligned}].$ \n\nFinally, dividing ${v}_{2}$ by its norm $‖{v}_{2}‖=\\sqrt{10},$ we get \n\n$$\n{u}_{2}=\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{10}}[\\begin{aligned}-3 \\\\ 1\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186514375 :knowledge-point/_questions [{:db/id #edb/ref 17592186192681 :knowledge-point/id #uuid "7674fd32-6462-5973-9b40-930637b68c85" :knowledge-point/title "Finding a Principal Component Given a 3x3 Covariance Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30a3113b-fc17-596b-9f95-def6091c6999" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{6}}[\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186513660} {:answer/id #uuid "5ae9e2d9-02b8-5bf3-9e21-3b0ccae3f4f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{6}}[\\begin{aligned}2 \\\\ 1 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186513774} {:answer/id #uuid "7a6b67ad-416f-59d6-a159-dc4add175bb2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{6}}[\\begin{aligned}-1 \\\\ 1 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186513854} {:answer/id #uuid "aa0c7856-5a8b-5fd6-87db-61cf81268afc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{6}}[\\begin{aligned}2 \\\\ -1 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186513975} {:answer/id #uuid "d24bafaa-3b7e-53f5-9a86-3e1dc5279c5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{6}}[\\begin{aligned}2 \\\\ 1 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186514082}] :answer-field/correct {:answer/id #uuid "5ae9e2d9-02b8-5bf3-9e21-3b0ccae3f4f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{6}}[\\begin{aligned}2 \\\\ 1 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186513774} :answer-field/id #uuid "145dd816-7538-567d-8cf5-d59c4f788fe9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514221}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1dfd23ff-dd1b-5e4d-b783-10b5e0f038d4" :question/math-academy-id "q-149404" :question/problem "The covariance matrix $C$ of some particular observations is shown below. \n\n$$\nC=[\\begin{aligned}3 & 1 & -1 \\\\ 1 & 5 & 3 \\\\ -1 & 3 & 5\\end{aligned}]\n$$\n\nFind the second principal component of the data, given that the eigenvalues of $C$ are $1,$ $4,$ and $8.$" :question/worked-solution "Recall that the unit eigenvectors of the covariance matrix $C$ are called the principal components of the data. If \n\n$$\n{\\lambda }_{1}>{\\lambda }_{2}>⋯>{\\lambda }_{n}\n$$\n\nare the eigenvalues of $C$ written in descending order, then: \n\n- the $1$st principal component is the unit eigenvector ${u}_{1}$ corresponding to the $1$st eigenvalue ${\\lambda }_{1},$\n\n- the $2$nd principal component is the unit eigenvector ${u}_{2}$ corresponding to the $2$nd eigenvalue ${\\lambda }_{2},$\n\n- $⋯$\n\nand so on.\n\nIn our case, the eigenvalues of the covariance matrix $C,$ in descending order, are \n\n$$\n{\\lambda }_{1}=8,\\,{\\lambda }_{2}=4,\\,{\\lambda }_{3}=1.\n$$\n\nSo, we need the unit eigenvector that corresponds to the eigenvalue ${\\lambda }_{2}=4:$\n\n$$\n\\begin{aligned}C-4I & =[\\begin{aligned}3 & 1 & -1 \\\\ 1 & 5 & 3 \\\\ -1 & 3 & 5\\end{aligned}]-4[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]=[\\begin{aligned}-1 & 1 & -1 \\\\ 1 & 1 & 3 \\\\ -1 & 3 & 1\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(C-4I)x=0$ gives the eigenvector ${v}_{2}=[\\begin{aligned}2 \\\\ 1 \\\\ -1\\end{aligned}].$ \n\nFinally, dividing ${v}_{2}$ by its norm $‖{v}_{2}‖=\\sqrt{6},$ we get \n\n$$\n{u}_{2}=\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{6}}[\\begin{aligned}2 \\\\ 1 \\\\ -1\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186514386 :knowledge-point/_questions [{:db/id #edb/ref 17592186192681 :knowledge-point/id #uuid "7674fd32-6462-5973-9b40-930637b68c85" :knowledge-point/title "Finding a Principal Component Given a 3x3 Covariance Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "216c564c-5ad0-50d5-982d-6e8432fadef1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{2}}[\\begin{aligned}0 \\\\ -1 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186513622} {:answer/id #uuid "570890c9-81bc-575a-a7d3-d1c395f52180" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{2}}[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186513768} {:answer/id #uuid "5c298372-518e-51e5-8af5-1a96d417af2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{2}}[\\begin{aligned}0 \\\\ 1 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186513780} {:answer/id #uuid "6f3241c0-aebf-5f17-b035-18257b7ec1f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{2}}[\\begin{aligned}-1 \\\\ 0 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186513833} {:answer/id #uuid "c355b21c-fab5-547e-b193-a8f5ac6b906a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{2}}[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186514048}] :answer-field/correct {:answer/id #uuid "c355b21c-fab5-547e-b193-a8f5ac6b906a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{2}}[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186514048} :answer-field/id #uuid "1e70a197-b3ce-5e88-b246-d5ee3922e949" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514229}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "30659c57-f541-5ec5-857d-e24511eb8172" :question/math-academy-id "q-149430" :question/problem "The covariance matrix $C$ of some particular observations is shown below. \n\n$$\nC=[\\begin{aligned}4 & -2 & -3 \\\\ -2 & 5 & 2 \\\\ -3 & 2 & 4\\end{aligned}]\n$$\n\nFind the third principal component of the data, given that the eigenvalues of $C$ are $1,$ $3,$ and $9.$" :question/worked-solution "Recall that the unit eigenvectors of the covariance matrix $C$ are called the principal components of the data. If \n\n$$\n{\\lambda }_{1}>{\\lambda }_{2}>⋯>{\\lambda }_{n}\n$$\n\nare the eigenvalues of $C$ written in descending order, then: \n\n- the $1$st principal component is the unit eigenvector ${u}_{1}$ corresponding to the $1$st eigenvalue ${\\lambda }_{1},$\n\n- the $2$nd principal component is the unit eigenvector ${u}_{2}$ corresponding to the $2$nd eigenvalue ${\\lambda }_{2},$\n\n- $⋯$\n\nand so on.\n\nIn our case, the eigenvalues of the covariance matrix $C,$ in descending order, are \n\n$$\n{\\lambda }_{1}=9,\\,{\\lambda }_{2}=3,\\,{\\lambda }_{3}=1.\n$$\n\nSo, we need the unit eigenvector that corresponds to the eigenvalue ${\\lambda }_{3}=1:$\n\n$$\n\\begin{aligned}C-I & =[\\begin{aligned}4 & -2 & -3 \\\\ -2 & 5 & 2 \\\\ -3 & 2 & 4\\end{aligned}]-[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]=[\\begin{aligned}3 & -2 & -3 \\\\ -2 & 4 & 2 \\\\ -3 & 2 & 3\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(C-I)x=0$ gives the eigenvector ${v}_{3}=[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}].$ \n\nFinally, dividing ${v}_{3}$ by its norm $‖{v}_{3}‖=\\sqrt{2},$ we get \n\n$$\n{u}_{3}=\\frac{{v}_{3}}{‖{v}_{3}‖}=\\frac{1}{\\sqrt{2}}[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}].\n$$"}]}
