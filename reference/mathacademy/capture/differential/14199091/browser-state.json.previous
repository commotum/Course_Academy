      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14199091/observations/step-q137740-08cde4f9e8e4117c03c8.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14199091/observations/step-q137740-08cde4f9e8e4117c03c8.png",
