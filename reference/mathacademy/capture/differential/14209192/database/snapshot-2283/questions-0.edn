}^{+}\\,{U}_{r}^{T} \\\\  & =\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}\\cdot \\frac{1}{5}\\begin{bmatrix}1\\end{bmatrix}\\cdot \\frac{1}{5}\\begin{bmatrix}4 & 3 & 0\\end{bmatrix} \\\\  & =\\frac{1}{25}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}\\cdot \\begin{bmatrix}1\\end{bmatrix}\\cdot \\begin{bmatrix}4 & 3 & 0\\end{bmatrix} \\\\  & =\\frac{1}{25}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}\\cdot \\begin{bmatrix}4 & 3 & 0\\end{bmatrix} \\\\  & =\\frac{1}{25}\\begin{bmatrix}4 & 3 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186511568 :knowledge-point/_questions [{:db/id #edb/ref 17592186162091 :knowledge-point/id #uuid "ff858037-da99-53e9-acdc-e4963e7d765e" :knowledge-point/title "Finding the Pseudoinverse of a Matrix Given Its Reduced Singular Value Decomposition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ae11b85-45e6-5dd7-8b03-2d6388de4723" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{12}[\\begin{aligned}1 & 0 & 5 \\\\ 5 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186510973} {:answer/id #uuid "673fceb3-6f45-5623-8b71-9c0dfa70f9da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{12}[\\begin{aligned}0 & 0 \\\\ 5 & 1 \\\\ 1 & 5\\end{aligned}]" :db/id #edb/ref 17592186510999} {:answer/id #uuid "682473a8-ddf4-51d7-92e8-835c0c7d6bf1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{12}[\\begin{aligned}1 & 5 & 0 \\\\ 5 & 1 & 0\\end{aligned}]" :db/id #edb/ref 17592186511003} {:answer/id #uuid "97c1d397-ce2a-566d-87b1-9841a83b5ce6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{12}[\\begin{aligned}0 & 5 & 1 \\\\ 0 & 1 & 5\\end{aligned}]" :db/id #edb/ref 17592186511097} {:answer/id #uuid "e27eae27-fef7-5f3f-9694-1cc984a96420" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{12}[\\begin{aligned}1 & 5 \\\\ 0 & 0 \\\\ 5 & 1\\end{aligned}]" :db/id #edb/ref 17592186511252}] :answer-field/correct {:answer/id #uuid "5ae11b85-45e6-5dd7-8b03-2d6388de4723" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{12}[\\begin{aligned}1 & 0 & 5 \\\\ 5 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186510973} :answer-field/id #uuid "06233fbd-739a-5715-82d1-f750ac787a62" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186511311}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e15227a9-4593-50e7-a6e9-0ebad0f88648" :question/math-academy-id "q-138617" :question/problem "$$\n{U}_{r}=[\\begin{aligned}-\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ 0 & 0 \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{aligned}],\\,{Σ}_{r}=[\\begin{aligned}3 & 0 \\\\ 0 & 2\\end{aligned}],\\,{V}_{r}=[\\begin{aligned}\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{aligned}]\n$$\n\nConsider the matrices shown above. Given that $A={U}_{r}{Σ}_{r}{V}_{r}^{T}$ is a reduced singular value decomposition of $A,$ find the pseudoinverse ${A}^{+}.$" :question/worked-solution "If $A={U}_{r}{Σ}_{r}{V}_{r}^{T}$ is a reduced singular value decomposition of $A,$ then the pseudoinverse of $A$ is given by\n\n$$\n{V}_{r}\\,{Σ}_{r}^{+}\\,{U}_{r}^{T},\n$$\n\nwhere ${Σ}_{r}^{+}$ is the pseudoinverse of ${Σ}_{r}.$\n\nFirst, notice that\n\n$$\n{V}_{r}=\\frac{1}{\\sqrt{2}}[\\begin{aligned}1 & 1 \\\\ -1 & 1\\end{aligned}],\\,{Σ}_{r}^{+}=\\frac{1}{6}[\\begin{aligned}2 & 0 \\\\ 0 & 3\\end{aligned}],\\,{U}_{r}^{T}=\\frac{1}{\\sqrt{2}}[\\begin{aligned}-1 & 0 & 1 \\\\ 1 & 0 & 1\\end{aligned}].\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{A}^{+} & ={V}_{r}\\,{Σ}_{r}^{+}\\,{U}_{r}^{T} \\\\  & =\\frac{1}{\\sqrt{2}}[\\begin{aligned}1 & 1 \\\\ -1 & 1\\end{aligned}]\\cdot \\frac{1}{6}[\\begin{aligned}2 & 0 \\\\ 0 & 3\\end{aligned}]\\cdot \\frac{1}{\\sqrt{2}}[\\begin{aligned}-1 & 0 & 1 \\\\ 1 & 0 & 1\\end{aligned}] \\\\  & =\\frac{1}{12}[\\begin{aligned}1 & 1 \\\\ -1 & 1\\end{aligned}]\\cdot [\\begin{aligned}2 & 0 \\\\ 0 & 3\\end{aligned}]\\cdot [\\begin{aligned}-1 & 0 & 1 \\\\ 1 & 0 & 1\\end{aligned}] \\\\  & =\\frac{1}{12}[\\begin{aligned}2 & 3 \\\\ -2 & 3\\end{aligned}]\\cdot [\\begin{aligned}-1 & 0 & 1 \\\\ 1 & 0 & 1\\end{aligned}] \\\\  & =\\frac{1}{12}[\\begin{aligned}1 & 0 & 5 \\\\ 5 & 0 & 1\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186388552 :knowledge-point/_questions [{:db/id #edb/ref 17592186162091 :knowledge-point/id #uuid "ff858037-da99-53e9-acdc-e4963e7d765e" :knowledge-point/title "Finding the Pseudoinverse of a Matrix Given Its Reduced Singular Value Decomposition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "95aa3141-e8ca-53cd-80c2-927fdca976aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{50}\\begin{bmatrix}-2 & 0 & 6 \\\\ 6 & 0 & -7\\end{bmatrix}" :db/id #edb/ref 17592186388554} {:answer/id #uuid "b5fdec83-023c-50aa-a518-6e4e8482250b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{50}\\begin{bmatrix}-7 & 0 & 6 \\\\ -2 & 0 & 6\\end{bmatrix}" :db/id #edb/ref 17592186388555} {:answer/id #uuid "7520040e-4dcb-567d-99b1-b572de819cfa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{50}\\begin{bmatrix}6 & 0 & -7 \\\\ -2 & 0 & 6\\end{bmatrix}" :db/id #edb/ref 17592186388556} {:answer/id #uuid "f7e39201-ff92-5aa6-bf59-03f275ce9b4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{50}\\begin{bmatrix}-7 & 0 & 6 \\\\ -6 & 0 & -2\\end{bmatrix}" :db/id #edb/ref 17592186388557} {:answer/id #uuid "80f0b7a6-f32e-5a85-8574-16e142f64353" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{50}\\begin{bmatrix}0 & -7 & 6 \\\\ 0 & 6 & -2\\end{bmatrix}" :db/id #edb/ref 17592186388558}] :answer-field/correct {:answer/id #uuid "f7e39201-ff92-5aa6-bf59-03f275ce9b4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{50}\\begin{bmatrix}-7 & 0 & 6 \\\\ -6 & 0 & -2\\end{bmatrix}" :db/id #edb/ref 17592186388557} :answer-field/id #uuid "ff1f002b-652d-5333-8455-842c9d746458" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388553}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0806e0ef-e656-5bbb-b90b-e4ef2729a281" :question/math-academy-id "q-138621" :question/problem "$$\n{U}_{r}=\\begin{bmatrix}\\frac{1}{\\sqrt{5}} & -\\frac{2}{\\sqrt{5}} \\\\ 0 & 0 \\\\ \\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}}\\end{bmatrix},\\,{Σ}_{r}=\\begin{bmatrix}10 & 0 \\\\ 0 & 5\\end{bmatrix},\\,{V}_{r}=\\begin{bmatrix}\\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}} \\\\ -\\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}}\\end{bmatrix}\n$$\n\nConsider the matrices shown above. Given that $A={U}_{r}{Σ}_{r}{V}_{r}^{T}$ is a reduced singular value decomposition of $A,$ find the pseudoinverse ${A}^{+}.$" :question/worked-solution "If $A={U}_{r}{Σ}_{r}{V}_{r}^{T}$ is a reduced singular value decomposition of $A,$ then the pseudoinverse of $A$ is given by\n\n$$\n{V}_{r}\\,{Σ}_{r}^{+}\\,{U}_{r}^{T},\n$$\n\nwhere ${Σ}_{r}^{+}$ is the pseudoinverse of ${Σ}_{r}.$\n\nFirst, notice that\n\n$$\n{V}_{r}=\\frac{1}{\\sqrt{5}}\\begin{bmatrix}1 & 2 \\\\ -2 & 1\\end{bmatrix},\\,{Σ}_{r}^{+}=\\frac{1}{10}\\begin{bmatrix}1 & 0 \\\\ 0 & 2\\end{bmatrix},\\,{U}_{r}^{T}=\\frac{1}{\\sqrt{5}}\\begin{bmatrix}1 & 0 & 2 \\\\ -2 & 0 & 1\\end{bmatrix}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{A}^{+} & ={V}_{r}\\,{Σ}_{r}^{+}\\,{U}_{r}^{T} \\\\  & =\\frac{1}{\\sqrt{5}}\\begin{bmatrix}1 & 2 \\\\ -2 & 1\\end{bmatrix}\\cdot \\frac{1}{10}\\begin{bmatrix}1 & 0 \\\\ 0 & 2\\end{bmatrix}\\cdot \\frac{1}{\\sqrt{5}}\\begin{bmatrix}1 & 0 & 2 \\\\ -2 & 0 & 1\\end{bmatrix} \\\\  & =\\frac{1}{50}\\begin{bmatrix}1 & 2 \\\\ -2 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 \\\\ 0 & 2\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 & 2 \\\\ -2 & 0 & 1\\end{bmatrix} \\\\  & =\\frac{1}{50}\\begin{bmatrix}1 & 4 \\\\ -2 & 2\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 & 2 \\\\ -2 & 0 & 1\\end{bmatrix} \\\\  & =\\frac{1}{50}\\begin{bmatrix}-7 & 0 & 6 \\\\ -6 & 0 & -2\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186383396 :knowledge-point/_questions [{:db/id #edb/ref 17592186162091 :knowledge-point/id #uuid "ff858037-da99-53e9-acdc-e4963e7d765e" :knowledge-point/title "Finding the Pseudoinverse of a Matrix Given Its Reduced Singular Value Decomposition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5355fc95-98d9-5275-b614-f7e300c3db38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{25}\\begin{bmatrix}1 & 2 \\\\ 2 & 4\\end{bmatrix}" :db/id #edb/ref 17592186383398} {:answer/id #uuid "3048f5ee-cb31-5041-9217-a3fd6860c7ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{250}\\begin{bmatrix}2 & 1 \\\\ 4 & 2\\end{bmatrix}" :db/id #edb/ref 17592186383399} {:answer/id #uuid "ef2577b0-c58c-520a-a8c9-c3dc44b90e84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{50}\\begin{bmatrix}2 & 2 \\\\ 4 & 4\\end{bmatrix}" :db/id #edb/ref 17592186383400} {:answer/id #uuid "d9afa991-040e-59c9-84e9-6c09c3f4c543" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{50}\\begin{bmatrix}4 & 2 \\\\ 2 & 1\\end{bmatrix}" :db/id #edb/ref 17592186383401} {:answer/id #uuid "f17cf18e-24ef-55ac-b30e-278699b70f46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{25}\\begin{bmatrix}2 & -1 \\\\ 4 & -2\\end{bmatrix}" :db/id #edb/ref 17592186383402}] :answer-field/correct {:answer/id #uuid "3048f5ee-cb31-5041-9217-a3fd6860c7ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{250}\\begin{bmatrix}2 & 1 \\\\ 4 & 2\\end{bmatrix}" :db/id #edb/ref 17592186383399} :answer-field/id #uuid "05809be0-17aa-5334-936d-ab9666766872" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383397}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5851c410-b086-5a97-80bf-885080ee6074" :question/math-academy-id "q-138657" :question/problem "$$\n{U}_{r}=\\begin{bmatrix}\\frac{2}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}}\\end{bmatrix},\\,{Σ}_{r}=\\begin{bmatrix}50\\end{bmatrix},\\,{V}_{r}=\\begin{bmatrix}\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{bmatrix}\n$$\n\nConsider the matrices shown above. Given that $A={U}_{r}{Σ}_{r}{V}_{r}^{T}$ is a reduced singular value decomposition of $A,$ find the pseudoinverse ${A}^{+}.$" :question/worked-solution "If $A={U}_{r}{Σ}_{r}{V}_{r}^{T}$ is a reduced singular value decomposition of $A,$ then the pseudoinverse of $A$ is given by\n\n$$\n{V}_{r}\\,{Σ}_{r}^{+}\\,{U}_{r}^{T},\n$$\n\nwhere ${Σ}_{r}^{+}$ is the pseudoinverse of ${Σ}_{r}.$\n\nFirst, notice that\n\n$$\n{V}_{r}=\\frac{1}{\\sqrt{5}}\\begin{bmatrix}1 \\\\ 2\\end{bmatrix},\\,{Σ}_{r}^{+}=\\frac{1}{50}\\begin{bmatrix}1\\end{bmatrix},\\,{U}_{r}^{T}=\\frac{1}{\\sqrt{5}}\\begin{bmatrix}2 & 1\\end{bmatrix}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{A}^{+} & ={V}_{r}\\,{Σ}_{r}^{+}\\,{U}_{r}^{T} \\\\  & =\\frac{1}{\\sqrt{5}}\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}\\cdot \\frac{1}{50}\\begin{bmatrix}1\\end{bmatrix}\\cdot \\frac{1}{\\sqrt{5}}\\begin{bmatrix}2 & 1\\end{bmatrix} \\\\  & =\\frac{1}{250}\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}\\cdot \\begin{bmatrix}1\\end{bmatrix}\\cdot \\begin{bmatrix}2 & 1\\end{bmatrix} \\\\  & =\\frac{1}{250}\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}\\cdot \\begin{bmatrix}2 & 1\\end{bmatrix} \\\\  & =\\frac{1}{250}\\begin{bmatrix}2 & 1 \\\\ 4 & 2\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186388566 :knowledge-point/_questions [{:db/id #edb/ref 17592186162091 :knowledge-point/id #uuid "ff858037-da99-53e9-acdc-e4963e7d765e" :knowledge-point/title "Finding the Pseudoinverse of a Matrix Given Its Reduced Singular Value Decomposition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e4372203-9216-542b-970e-8cec151b32b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\begin{bmatrix}2 & 0 & 1 \\\\ 2 & 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186388568} {:answer/id #uuid "25f946f1-f189-517c-8d4f-b7f6d74888cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{50}\\begin{bmatrix}2 & 0 & 2 \\\\ 3 & 0 & 3\\end{bmatrix}" :db/id #edb/ref 17592186388569} {:answer/id #uuid "a3e8a4db-a98e-5764-a4cd-a07ee633c5e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{15}\\begin{bmatrix}1 & 0 & -1 \\\\ 2 & 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186388570} {:answer/id #uuid "71d51881-84bd-5ffd-b315-fb3f57f85778" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{20}\\begin{bmatrix}1 & 0 & -2 \\\\ 1 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186388571} {:answer/id #uuid "82ca2f2f-9b22-51bd-ac91-e35d0267268a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{30}\\begin{bmatrix}2 & 0 & -1 \\\\ 2 & 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186388572}] :answer-field/correct {:answer/id #uuid "82ca2f2f-9b22-51bd-ac91-e35d0267268a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{30}\\begin{bmatrix}2 & 0 & -1 \\\\ 2 & 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186388572} :answer-field/id #uuid "519e599e-557f-5219-8bbb-718b79623ca0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388567}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4e5b5ecc-a097-5151-8920-89607e5df059" :question/math-academy-id "q-138669" :question/problem "$$\n{U}_{r}=\\begin{bmatrix}\\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}} \\\\ 0 & 0 \\\\ -\\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}}\\end{bmatrix},\\,{Σ}_{r}=\\begin{bmatrix}15 & 0 \\\\ 0 & 10\\end{bmatrix},\\,{V}_{r}=\\begin{bmatrix}\\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}} \\\\ -\\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}}\\end{bmatrix}\n$$\n\nConsider the matrices shown above. Given that $A={U}_{r}{Σ}_{r}{V}_{r}^{T}$ is a reduced singular value decomposition of $A,$ find the pseudoinverse ${A}^{+}.$" :question/worked-solution "If $A={U}_{r}{Σ}_{r}{V}_{r}^{T}$ is a reduced singular value decomposition of $A,$ then the pseudoinverse of $A$ is given by\n\n$$\n{V}_{r}\\,{Σ}_{r}^{+}\\,{U}_{r}^{T},\n$$\n\nwhere ${Σ}_{r}^{+}$ is the pseudoinverse of ${Σ}_{r}.$\n\nFirst, notice that\n\n$$\n{V}_{r}=\\frac{1}{\\sqrt{5}}\\begin{bmatrix}2 & 1 \\\\ -1 & 2\\end{bmatrix},\\,{Σ}_{r}^{+}=\\frac{1}{30}\\begin{bmatrix}2 & 0 \\\\ 0 & 3\\end{bmatrix},\\,{U}_{r}^{T}=\\frac{1}{\\sqrt{5}}\\begin{bmatrix}1 & 0 & -2 \\\\ 2 & 0 & 1\\end{bmatrix}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{A}^{+} & ={V}_{r}\\,{Σ}_{r}^{+}\\,{U}_{r}^{T} \\\\  & =\\frac{1}{\\sqrt{5}}\\begin{bmatrix}2 & 1 \\\\ -1 & 2\\end{bmatrix}\\cdot \\frac{1}{30}\\begin{bmatrix}2 & 0 \\\\ 0 & 3\\end{bmatrix}\\cdot \\frac{1}{\\sqrt{5}}\\begin{bmatrix}1 & 0 & -2 \\\\ 2 & 0 & 1\\end{bmatrix} \\\\  & =\\frac{1}{150}\\begin{bmatrix}2 & 1 \\\\ -1 & 2\\end{bmatrix}\\cdot \\begin{bmatrix}2 & 0 \\\\ 0 & 3\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 & -2 \\\\ 2 & 0 & 1\\end{bmatrix} \\\\  & =\\frac{1}{150}\\begin{bmatrix}4 & 3 \\\\ -2 & 6\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 & -2 \\\\ 2 & 0 & 1\\end{bmatrix} \\\\  & =\\frac{1}{150}\\begin{bmatrix}10 & 0 & -5 \\\\ 10 & 0 & 10\\end{bmatrix} \\\\  & =\\frac{1}{30}\\begin{bmatrix}2 & 0 & -1 \\\\ 2 & 0 & 2\\end{bmatrix}.\\end{aligned}\n$$"}]}
