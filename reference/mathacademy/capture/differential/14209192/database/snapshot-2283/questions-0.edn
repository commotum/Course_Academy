#{[{:db/id #edb/ref 17592186161902 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186162089 :knowledge-point/id #uuid "e82e8b16-51a8-59c8-9ed1-51619335de97" :knowledge-point/title "Finding the Pseudoinverse of a Matrix Given Its Singular Value Decomposition"}] :question/id #uuid "e0a12130-2908-58fd-a8e0-91083fa30e96" :question/math-academy-id "e-9828" :question/problem "![](images/39/399738d7c4da59c73c954cfd41d8c76fc93ad0351fc8f2854ad33796aa2379df.svg)\nConsider the matrices shown above. Given that $A=U \\Sigma V^T$ is a singular value decomposition of $A,$ find the pseudoinverse $A^+.$" :question/worked-solution "If $A=U \\Sigma V ^T$ is a singular value decomposition of $A,$ then the pseudoinverse of $A$ is given by\n\n$$\nV \\, \\Sigma^+ \\, U^T,\n$$\n\nwhere $\\Sigma^+$ is the pseudoinverse of $\\Sigma.$ \n\nFirst, notice that\n\n![](images/f6/f6703dcf594334ec5ab821bbaac5654de5e3970b0e7981f256a8fd00df31060f.svg)\n\nTherefore, we have\n\n$$\n\\begin{aligned}{A}^{+} & =V\\,{Σ}^{+}\\,{U}^{T} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot \\frac{1}{5}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\cdot \\frac{1}{5}\\begin{bmatrix}4 & 3 & 0 \\\\ -3 & 4 & 0 \\\\ 0 & 0 & 5\\end{bmatrix} \\\\  & =\\frac{1}{25}\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}4 & 3 & 0 \\\\ -3 & 4 & 0 \\\\ 0 & 0 & 5\\end{bmatrix} \\\\  & =\\frac{1}{25}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}4 & 3 & 0 \\\\ -3 & 4 & 0 \\\\ 0 & 0 & 5\\end{bmatrix} \\\\  & =\\frac{1}{25}\\begin{bmatrix}4 & 3 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186161903 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186162090 :knowledge-point/id #uuid "3460bfd6-8b2f-5a52-891a-4c8b2af5b5e8" :knowledge-point/title "Finding the Pseudoinverse of a Diagonal Matrix"}] :question/id #uuid "64e7f84f-da34-5ae2-b2d1-72373a1d2888" :question/math-academy-id "e-9829" :question/problem "For the matrix \n![](images/1d/1d0733f2c724253c804c596e1d0a1432b8281afa7a14a9dc6702b099ab4795e0.svg) find the pseudoinverse $A^+.$" :question/worked-solution "For an \"almost\" zero $m \\times n$ matrix with non-zero entries \n\n$$\n\\sigma_1, \\: \\sigma_2, \\: \\ldots, \\: \\sigma_r\n$$\n\non the main diagonal, the corresponding pseudoinverse is the \"almost\" zero $n \\times m$ matrix with entries \n\n$$\n{\\sigma_1^{-1}}, \\, {\\sigma_2^{-1}}, \\, \\ldots, \\, {\\sigma_r^{-1}}\n$$\n\non the main diagonal.\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}{A}^{+} & ={\\begin{bmatrix}6 & 0 \\\\ 0 & 4 \\\\ 0 & 0\\end{bmatrix}}^{+} \\\\  & =\\begin{bmatrix}{6}^{-1} & \\,\\,\\,0 & 0 \\\\ \\,\\,0 & \\,{4}^{-1} & 0\\end{bmatrix} \\\\  & =\\frac{1}{12}\\begin{bmatrix}2 & 0 & 0 \\\\ 0 & 3 & 0\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186161904 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186162091 :knowledge-point/id #uuid "ff858037-da99-53e9-acdc-e4963e7d765e" :knowledge-point/title "Finding the Pseudoinverse of a Matrix Given Its Reduced Singular Value Decomposition"}] :question/id #uuid "66c34c76-6243-50b8-832f-027abb6ab736" :question/math-academy-id "e-9830" :question/problem "![](images/fd/fdc735895573e0d7c1eb7865233dd7b56a38aeeb9c76bba77fa669212262791d.svg)\nConsider the matrices shown above. Given that $A=U_r \\Sigma_r V_r^T$ is a reduced singular value decomposition of $A,$ find the pseudoinverse $A^+.$" :question/worked-solution "If $A=U_r \\Sigma_r V_r ^T$ is a reduced singular value decomposition of $A,$ then the pseudoinverse of $A$ is given by\n\n$$\nV_r \\, \\Sigma_r^+ \\, U_r^T,\n$$\n\nwhere $\\Sigma_r^+$ is the pseudoinverse of $\\Sigma_r.$\n\nFirst, notice that\n\n![](images/d7/d750c1c5030e0d1df7e8b14790e3f189e69346ca392d3d2885ad49db0e66b7e0.svg)\n\nTherefore, we have\n\n$$\n\\begin{aligned}{A}^{+} & ={V}_{r}\\,{Σ}_{r}^{+}\\,{U}_{r}^{T} \\\\  & =\\frac{1}{5}\\begin{bmatrix}4 \\\\ 3\\end{bmatrix}\\cdot \\frac{1}{2}\\begin{bmatrix}1\\end{bmatrix}\\cdot \\frac{1}{5}\\begin{bmatrix}3 & 4 & 0\\end{bmatrix} \\\\  & =\\frac{1}{50}\\begin{bmatrix}4 \\\\ 3\\end{bmatrix}\\cdot \\begin{bmatrix}1\\end{bmatrix}\\cdot \\begin{bmatrix}3 & 4 & 0\\end{bmatrix} \\\\  & =\\frac{1}{50}\\begin{bmatrix}4 \\\\ 3\\end{bmatrix}\\cdot \\begin{bmatrix}3 & 4 & 0\\end{bmatrix} \\\\  & =\\frac{1}{50}\\begin{bmatrix}12 & 16 & 0 \\\\ 9 & 12 & 0\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186162344 :knowledge-point/_questions [{:db/id #edb/ref 17592186162089 :knowledge-point/id #uuid "e82e8b16-51a8-59c8-9ed1-51619335de97" :knowledge-point/title "Finding the Pseudoinverse of a Matrix Given Its Singular Value Decomposition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "065fffc8-3e59-5969-929b-5087533bf93f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{25}\\begin{bmatrix}1 & -2 & 0 \\\\ -2 & 4 & 0\\end{bmatrix}" :db/id #edb/ref 17592186432586} {:answer/id #uuid "39695dbd-9cb4-567f-a279-8277626c4d7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{16}\\begin{bmatrix}1 & -2 \\\\ -2 & 4 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186432588} {:answer/id #uuid "597aa326-f1e8-5701-9c20-5031aee7b048" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{16}\\begin{bmatrix}1 & -2 & 0 \\\\ -2 & 4 & 0\\end{bmatrix}" :db/id #edb/ref 17592186432590} {:answer/id #uuid "fcd31e64-a634-576e-a8e8-c7e2bca6ed34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{25}\\begin{bmatrix}-2 & 1 \\\\ 4 & -2 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186432594} {:answer/id #uuid "ffb3d5ad-4c33-5033-8c68-0522a4f523a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{25}\\begin{bmatrix}-2 & 4 & 0 \\\\ 1 & -2 & 0\\end{bmatrix}" :db/id #edb/ref 17592186432595}] :answer-field/correct {:answer/id #uuid "065fffc8-3e59-5969-929b-5087533bf93f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{25}\\begin{bmatrix}1 & -2 & 0 \\\\ -2 & 4 & 0\\end{bmatrix}" :db/id #edb/ref 17592186432586} :answer-field/id #uuid "821729eb-93c4-5d09-9aa0-cfa962c2ddca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186159266}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "989a4485-e5eb-5b78-be60-afb9e4f1a969" :question/math-academy-id "q-136972" :question/problem "$$\nU=\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} & 0 & \\frac{2}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} & 0 & \\frac{1}{\\sqrt{5}} \\\\ 0 & 1 & 0\\end{bmatrix},\\,Σ=\\begin{bmatrix}5 & 0 \\\\ 0 & 0 \\\\ 0 & 0\\end{bmatrix},\\,V=\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}}\\end{bmatrix}\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ find the pseudoinverse ${A}^{+}.$" :question/worked-solution "If $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ then the pseudoinverse of $A$ is given by\n\n$$\nV\\,{Σ}^{+}\\,{U}^{T},\n$$\n\nwhere ${Σ}^{+}$ is the pseudoinverse of $Σ.$\n\nFirst, notice that\n\n$$\nV=\\frac{1}{\\sqrt{5}}\\begin{bmatrix}-1 & 2 \\\\ 2 & 1\\end{bmatrix},\\,{Σ}^{+}=\\frac{1}{5}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix},\\,{U}^{T}=\\frac{1}{\\sqrt{5}}\\begin{bmatrix}-1 & 2 & 0 \\\\ 0 & 0 & \\sqrt{5} \\\\ 2 & 1 & 0\\end{bmatrix}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{A}^{+} & =V\\,{Σ}^{+}\\,{U}^{T} \\\\  & =\\frac{1}{\\sqrt{5}}\\begin{bmatrix}-1 & 2 \\\\ 2 & 1\\end{bmatrix}\\cdot \\frac{1}{5}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\cdot \\frac{1}{\\sqrt{5}}\\begin{bmatrix}-1 & 2 & 0 \\\\ 0 & 0 & \\sqrt{5} \\\\ 2 & 1 & 0\\end{bmatrix} \\\\  & =\\frac{1}{25}\\begin{bmatrix}-1 & 2 \\\\ 2 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}-1 & 2 & 0 \\\\ 0 & 0 & \\sqrt{5} \\\\ 2 & 1 & 0\\end{bmatrix} \\\\  & =\\frac{1}{25}\\begin{bmatrix}-1 & 0 & 0 \\\\ 2 & 0 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}-1 & 2 & 0 \\\\ 0 & 0 & \\sqrt{5} \\\\ 2 & 1 & 0\\end{bmatrix} \\\\  & =\\frac{1}{25}\\begin{bmatrix}1 & -2 & 0 \\\\ -2 & 4 & 0\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186162346 :knowledge-point/_questions [{:db/id #edb/ref 17592186162090 :knowledge-point/id #uuid "3460bfd6-8b2f-5a52-891a-4c8b2af5b5e8" :knowledge-point/title "Finding the Pseudoinverse of a Diagonal Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ae7f487-e4cb-5a2c-9236-037edd4464c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{10}[\\begin{aligned}5 & 0 & 0 \\\\ 0 & 2 & 0\\end{aligned}]" :db/id #edb/ref 17592186520822} {:answer/id #uuid "3c2319a4-1c0c-55d6-a9a4-cedc2a35cda6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{10}[\\begin{aligned}2 & 0 \\\\ 0 & 5 \\\\ 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186520898} {:answer/id #uuid "7cd17152-3983-5db3-8252-60325d77c72c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{10}[\\begin{aligned}2 & 0 & 0 \\\\ 0 & 5 & 0\\end{aligned}]" :db/id #edb/ref 17592186521050} {:answer/id #uuid "b78213b1-1bfd-5637-bcbc-943dcbd0d99c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{10}[\\begin{aligned}-5 & 0 \\\\ 0 & -2 \\\\ 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186521173} {:answer/id #uuid "bdbedc83-febf-5b2d-ab4e-2f262fbdb8dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{10}[\\begin{aligned}5 & 0 \\\\ 0 & 2 \\\\ 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186521190}] :answer-field/correct {:answer/id #uuid "bdbedc83-febf-5b2d-ab4e-2f262fbdb8dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{10}[\\begin{aligned}5 & 0 \\\\ 0 & 2 \\\\ 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186521190} :answer-field/id #uuid "e95a7bc1-ea56-5f45-9df9-1470b470d84d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186159278}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f5e5d707-1ea3-5b65-82a1-f18b019e2ede" :question/math-academy-id "q-136990" :question/problem "For the matrix \n$A=[\\begin{aligned}2 & 0 & 0 \\\\ 0 & 5 & 0\\end{aligned}],$ find the pseudoinverse ${A}^{+}.$" :question/worked-solution "For an \"almost\" zero $m\\times n$ matrix with non-zero entries \n\n$$\n{\\sigma }_{1},\\,{\\sigma }_{2},\\,…,\\,{\\sigma }_{r}\n$$\n\non the main diagonal, the corresponding pseudoinverse is the \"almost\" zero $n\\times m$ matrix with entries \n\n$$\n{\\sigma }_{1}^{-1},\\,{\\sigma }_{2}^{-1},\\,…,\\,{\\sigma }_{r}^{-1}\n$$\n\non the main diagonal.\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}{A}^{+} & ={[\\begin{aligned}2 & 0 & 0 \\\\ 0 & 5 & 0\\end{aligned}]}^{+} \\\\  & =[\\begin{aligned}{2}^{-1} & 0 \\\\ 0 & {5}^{-1} \\\\ 0 & 0\\end{aligned}] \\\\  & =\\frac{1}{10}[\\begin{aligned}5 & 0 \\\\ 0 & 2 \\\\ 0 & 0\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186521518 :knowledge-point/_questions [{:db/id #edb/ref 17592186162090 :knowledge-point/id #uuid "3460bfd6-8b2f-5a52-891a-4c8b2af5b5e8" :knowledge-point/title "Finding the Pseudoinverse of a Diagonal Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e59c3e9-3153-55ad-a3a5-92e642d0788c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186520792} {:answer/id #uuid "25e92a54-1b79-51b0-9145-95bb94f1dc21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}[\\begin{aligned}0 & 0 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186520845} {:answer/id #uuid "3c19642d-0d29-5db8-8698-690e13c0ca93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}[\\begin{aligned}0 & 0 \\\\ 0 & -1\\end{aligned}]" :db/id #edb/ref 17592186520897} {:answer/id #uuid "5ee1a542-97ea-57ea-832a-117266a654c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}[\\begin{aligned}1 & 0 \\\\ 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186520977} {:answer/id #uuid "82dd3bce-a901-539c-9a60-4a9bc7a451d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}[\\begin{aligned}-1 & 0 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186521063}] :answer-field/correct {:answer/id #uuid "25e92a54-1b79-51b0-9145-95bb94f1dc21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}[\\begin{aligned}0 & 0 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186520845} :answer-field/id #uuid "4ea4243f-e8bc-5238-a430-24274b725da6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186521362}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7eff1b38-24fd-5e4c-adf3-ec6e1162e257" :question/math-academy-id "q-138484" :question/problem "For the matrix \n$A=[\\begin{aligned}0 & 0 \\\\ 0 & 4\\end{aligned}],$ find the pseudoinverse ${A}^{+}.$" :question/worked-solution "For an \"almost\" zero $m\\times n$ matrix with non-zero entries \n\n$$\n{\\sigma }_{1},\\,{\\sigma }_{2},\\,…,\\,{\\sigma }_{r}\n$$\n\non the main diagonal, the corresponding pseudoinverse is the \"almost\" zero $n\\times m$ matrix with entries \n\n$$\n{\\sigma }_{1}^{-1},\\,{\\sigma }_{2}^{-1},\\,…,\\,{\\sigma }_{r}^{-1}\n$$\n\non the main diagonal.\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}{A}^{+} & ={[\\begin{aligned}0 & 0 \\\\ 0 & 4\\end{aligned}]}^{+} \\\\  & =[\\begin{aligned}0 & 0 \\\\ 0 & {4}^{-1}\\end{aligned}] \\\\  & =\\frac{1}{4}[\\begin{aligned}0 & 0 \\\\ 0 & 1\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186521527 :knowledge-point/_questions [{:db/id #edb/ref 17592186162090 :knowledge-point/id #uuid "3460bfd6-8b2f-5a52-891a-4c8b2af5b5e8" :knowledge-point/title "Finding the Pseudoinverse of a Diagonal Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "607fba4b-a3c5-53ce-9054-c4e5df896d07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}]" :db/id #edb/ref 17592186520982} {:answer/id #uuid "7644a604-cf73-5442-8725-be22ba80a563" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}[\\begin{aligned}0 & -1 \\\\ 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186521025} {:answer/id #uuid "8ca0e0bb-8a82-5517-b771-f93850f54c4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}[\\begin{aligned}0 & 0 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186521083} {:answer/id #uuid "a7695fdb-ee31-5096-a213-f3e9e5fbfec7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}[\\begin{aligned}1 & 0 \\\\ 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186521140} {:answer/id #uuid "bb902678-e8ab-5d83-8667-d11bab43ee55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186521185}] :answer-field/correct {:answer/id #uuid "a7695fdb-ee31-5096-a213-f3e9e5fbfec7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}[\\begin{aligned}1 & 0 \\\\ 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186521140} :answer-field/id #uuid "d1b0c82a-9a7e-5567-921e-646b3756d6d7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186521432}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "92a0ecc9-adbd-5716-8a7f-f658ffcbaf41" :question/math-academy-id "q-138486" :question/problem "For the matrix \n$A=[\\begin{aligned}8 & 0 \\\\ 0 & 0\\end{aligned}],$ find the pseudoinverse ${A}^{+}.$" :question/worked-solution "For an \"almost\" zero $m\\times n$ matrix with non-zero entries \n\n$$\n{\\sigma }_{1},\\,{\\sigma }_{2},\\,…,\\,{\\sigma }_{r}\n$$\n\non the main diagonal, the corresponding pseudoinverse is the \"almost\" zero $n\\times m$ matrix with entries \n\n$$\n{\\sigma }_{1}^{-1},\\,{\\sigma }_{2}^{-1},\\,…,\\,{\\sigma }_{r}^{-1}\n$$\n\non the main diagonal.\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}{A}^{+} & ={[\\begin{aligned}8 & 0 \\\\ 0 & 0\\end{aligned}]}^{+} \\\\  & =[\\begin{aligned}{8}^{-1} & 0 \\\\ 0 & 0\\end{aligned}] \\\\  & =\\frac{1}{8}[\\begin{aligned}1 & 0 \\\\ 0 & 0\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186371769 :knowledge-point/_questions [{:db/id #edb/ref 17592186162090 :knowledge-point/id #uuid "3460bfd6-8b2f-5a52-891a-4c8b2af5b5e8" :knowledge-point/title "Finding the Pseudoinverse of a Diagonal Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a1174f7d-b141-5713-b4de-b75c8c38e687" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{12}\\begin{bmatrix}-4 & 0 \\\\ 0 & 3 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186371771} {:answer/id #uuid "1cc78ed8-c7f0-5a41-9e00-adfce49