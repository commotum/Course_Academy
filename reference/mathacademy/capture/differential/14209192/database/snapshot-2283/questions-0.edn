trix with entries \n\n$$\n{\\sigma }_{1}^{-1},\\,{\\sigma }_{2}^{-1},\\,…,\\,{\\sigma }_{r}^{-1}\n$$\n\non the main diagonal.\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}{A}^{+} & ={\\begin{bmatrix}4 & 0 & 0 \\\\ 0 & 3 & 0\\end{bmatrix}}^{+} \\\\  & =\\begin{bmatrix}{4}^{-1} & 0 \\\\ 0 & {3}^{-1} \\\\ 0 & 0\\end{bmatrix} \\\\  & =\\frac{1}{12}\\begin{bmatrix}3 & 0 \\\\ 0 & 4 \\\\ 0 & 0\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186388531 :knowledge-point/_questions [{:db/id #edb/ref 17592186162090 :knowledge-point/id #uuid "3460bfd6-8b2f-5a52-891a-4c8b2af5b5e8" :knowledge-point/title "Finding the Pseudoinverse of a Diagonal Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b0d8eb8-52ec-567f-a20c-35fd689bcb4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\begin{bmatrix}1 & 0 \\\\ 0 & 2 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186388533} {:answer/id #uuid "55099218-d7c6-5e3f-aef6-6dfdb282b7c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}\\begin{bmatrix}2 & 0 \\\\ 1 & 1 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186388534} {:answer/id #uuid "3ae31cac-b6d3-5ba2-94bf-0b183abddd0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}\\begin{bmatrix}2 & 0 \\\\ 0 & 1 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186388535} {:answer/id #uuid "591b90c9-7dc1-51c9-993e-d75077665942" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}\\begin{bmatrix}1 & 0 \\\\ 0 & 2 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186388536} {:answer/id #uuid "0d168c30-3b5a-5117-9b57-5eb4d3087a9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\begin{bmatrix}2 & 0 \\\\ 0 & 4 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186388537}] :answer-field/correct {:answer/id #uuid "59