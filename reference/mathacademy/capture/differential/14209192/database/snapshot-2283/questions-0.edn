d #uuid "9647bbdf-fcf2-5bad-a3b3-3e9694fc3084" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\begin{bmatrix}4 & 2 \\\\ 2 & 1\\end{bmatrix}" :db/id #edb/ref 17592186371786} {:answer/id #uuid "2921dae6-65c8-54c1-bbee-1a5cf4f1be1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{20}\\begin{bmatrix}2 & -2 \\\\ 1 & -1\\end{bmatrix}" :db/id #edb/ref 17592186371787} {:answer/id #uuid "c1649e67-dae8-577c-9013-fb4d1dfa9a7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{10}\\begin{bmatrix}2 & -2 \\\\ -1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186371788} {:answer/id #uuid "f92721bb-f509-5c05-9e8a-6cddb7eeedbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{10}\\begin{bmatrix}4 & 2 \\\\ 2 & 1\\end{bmatrix}" :db/id #edb/ref 17592186371789}] :answer-field/correct {:answer/id #uuid "0a66a064-024a-502e-9b04-347d649103a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{20}\\begin{bmatrix}2 & 2 \\\\ 1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186371785} :answer-field/id #uuid "90c3d92d-95b1-5446-b383-5a0f0a13437f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186371784}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "730701f6-1ca8-5b40-956c-c0113bda87d0" :question/math-academy-id "q-138495" :question/problem "$$\nU=\\begin{bmatrix}\\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix},\\,Σ=\\begin{bmatrix}2\\sqrt{10} & 0 \\\\ 0 & 0\\end{bmatrix},\\,V=\\begin{bmatrix}\\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}}\\end{bmatrix}\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ find the pseudoinverse ${A}^{+}.$" :question/worked-solution "If $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ then the pseudoinverse of $A$ is given by\n\n$$\nV\\,{Σ}^{+}\\,{U}^{T},\n$$\n\nwhere ${Σ}^{+}$ is the pseudoinverse of $Σ.$\n\nFirst, notice that\n\n$$\nV=\\frac{1}{\\sqrt{5}}\\begin{bmatrix}2 & -1 \\\\ 1 & 2\\end{bmatrix},\\,{Σ}^{+}=\\frac{1}{2\\sqrt{10}}\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix},\\,{U}^{T}=\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 & 1 \\\\ -1 & 1\\end{bmatrix}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{A}^{+} & =V\\,{Σ}^{+}\\,{U}^{T} \\\\  & =\\frac{1}{\\sqrt{5}}\\begin{bmatrix}2 & -1 \\\\ 1 & 2\\end{bmatrix}\\cdot \\frac{1}{2\\sqrt{10}}\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix}\\cdot \\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 & 1 \\\\ -1 & 1\\end{bmatrix} \\\\  & =\\frac{1}{20}\\begin{bmatrix}2 & -1 \\\\ 1 & 2\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 1 \\\\ -1 & 1\\end{bmatrix} \\\\  & =\\frac{1}{20}\\begin{bmatrix}2 & 0 \\\\ 1 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 1 \\\\ -1 & 1\\end{bmatrix} \\\\  & =\\frac{1}{20}\\begin{bmatrix}2 & 2 \\\\ 1 & 1\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186432597 :knowledge-point/_questions [{:db/id #edb/ref 17592186162089 :knowledge-point/id #uuid "e82e8b16-51a8-59c8-9ed1-51619335de97" :knowledge-point/title "Finding the Pseudoinverse of a Matrix Given Its Singular Value Decomposition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38c000fb-0f6e-5949-8db6-c4c5d28b3248" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 & 1 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186432587} {:answer/id #uuid "3fe77835-4c02-5a54-960e-f2c670d5fae4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{10}}\\begin{bmatrix}2 & -2 \\\\ -1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186432589} {:answer/id #uuid "8e69fde6-984a-5a8b-8dd0-63b58423f006" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\begin{bmatrix}1 & -1 \\\\ -1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186432591} {:answer/id #uuid "afeacb94-4e5b-58cc-be9f-c0b7884171f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\begin{bmatrix}1 & 1 \\\\ 1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186432592} {:answer/id #uuid "c0338917-af25-5f02-ba7d-b2159df253f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\begin{bmatrix}1 & 1 \\\\ 1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186432593}] :answer-field/correct {:answer/id #uuid "8e69fde6-984a-5a8b-8dd0-63b58423f006" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\begin{bmatrix}1 & -1 \\\\ -1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186432591} :answer-field/id #uuid "2881387b-754e-56f3-834a-ac7d858e2ecf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186432596}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3fcee73d-521b-5fd0-a9c6-c7b6d8e05cce" :question/math-academy-id "q-138516" :question/problem "$$\nU=\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix},\\,Σ=\\begin{bmatrix}2 & 0 \\\\ 0 & 0\\end{bmatrix},\\,V=\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ find the pseudoinverse ${A}^{+}.$" :question/worked-solution "If $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ then the pseudoinverse of $A$ is given by\n\n$$\nV\\,{Σ}^{+}\\,{U}^{T},\n$$\n\nwhere ${Σ}^{+}$ is the pseudoinverse of $Σ.$\n\nFirst, notice that\n\n$$\nV=\\frac{1}{\\sqrt{2}}\\begin{bmatrix}-1 & 1 \\\\ 1 & 1\\end{bmatrix},\\,{Σ}^{+}=\\frac{1}{2}\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix},\\,{U}^{T}=\\frac{1}{\\sqrt{2}}\\begin{bmatrix}-1 & 1 \\\\ 1 & 1\\end{bmatrix}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{A}^{+} & =V\\,{Σ}^{+}\\,{U}^{T} \\\\  & =\\frac{1}{\\sqrt{2}}\\begin{bmatrix}-1 & 1 \\\\ 1 & 1\\end{bmatrix}\\cdot \\frac{1}{2}\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix}\\cdot \\frac{1}{\\sqrt{2}}\\begin{bmatrix}-1 & 1 \\\\ 1 & 1\\end{bmatrix} \\\\  & =\\frac{1}{4}\\begin{bmatrix}-1 & 1 \\\\ 1 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}-1 & 1 \\\\ 1 & 1\\end{bmatrix} \\\\  & =\\frac{1}{4}\\begin{bmatrix}-1 & 0 \\\\ 1 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}-1 & 1 \\\\ 1 & 1\\end{bmatrix} \\\\  & =\\frac{1}{4}\\begin{bmatrix}1 & -1 \\\\ -1 & 1\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186388538 :knowledge-point/_questions [{:db/id #edb/ref 17592186162089 :knowledge-point/id #uuid "e82e8b16-51a8-59c8-9ed1-51619335de97" :knowledge-point/title "Finding the Pseudoinverse of a Matrix Given Its Singular Value Decomposition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d429bc69-c341-5a48-9804-58abbc0fd361" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{25}\\begin{bmatrix}1 & 2 \\\\ 2 & 4\\end{bmatrix}" :db/id #edb/ref 17592186388540} {:answer/id #uuid "cd2b9dd8-a0a6-54ff-bad0-f2b924848fee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{25}\\begin{bmatrix}1 & 1 \\\\ 2 & 2\\end{bmatrix}" :db/id #edb/ref 17592186388541} {:answer/id #uuid "458b76cb-2abb-5fc3-a5a9-245ea3e66854" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value 