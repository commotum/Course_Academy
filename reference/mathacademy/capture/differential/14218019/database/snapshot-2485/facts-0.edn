6045417] [17592186162129 #edb/ref 1038 #edb/ref 17592186520458 #edb/ref 17592186045417] [17592186162129 #edb/ref 1038 #edb/ref 17592186520489 #edb/ref 17592186045417] [17592186162129 #edb/ref 1038 #edb/ref 17592186520503 #edb/ref 17592186045417] [17592186162129 #edb/ref 1039 "Calculating a Conditional Expectation From a Conditional PDF" #edb/ref 17592186045417] [17592186162129 #edb/ref 1041 #edb/ref 17592186161695 #edb/ref 17592186045417] [17592186162129 #edb/ref 1042 #uuid "fcf85ec6-b20d-5540-a709-9ff28bc82ca6" #edb/ref 17592186045417] [17592186162193 #edb/ref 1043 #edb/ref 17592186163099 #edb/ref 17592186045417] [17592186162193 #edb/ref 1043 #edb/ref 17592186163105 #edb/ref 17592186045417] [17592186162193 #edb/ref 1043 #edb/ref 17592186163106 #edb/ref 17592186045417] [17592186162193 #edb/ref 1043 #edb/ref 17592186163107 #edb/ref 17592186045417] [17592186162193 #edb/ref 1043 #edb/ref 17592186163127 #edb/ref 17592186045417] [17592186162193 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186162193 #edb/ref 1045 "Conditional Expectation for Continuous Random Variables" #edb/ref 17592186045417] [17592186162193 #edb/ref 1046 #edb/ref 17592186163099 #edb/ref 17592186045417] [17592186162193 #edb/ref 1049 #edb/ref 17592186050965 #edb/ref 17592186045417] [17592186162193 #edb/ref 1050 1020.0 #edb/ref 17592186045417] [17592186162193 #edb/ref 1053 #uuid "5ae71148-97b7-53da-9878-67b3a9acb4b2" #edb/ref 17592186045417] [17592186162414 #edb/ref 1068 #edb/ref 17592186159686 #edb/ref 17592186045417] [17592186162414 #edb/ref 1069 "q-145622" #edb/ref 17592186045417] [17592186162414 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186162414 #edb/ref 1071 "$$\n\\begin{aligned}f(x,y)=\\{\\begin{aligned}\\frac{3}{2}, & {x}^{2}\\le y\\le 1,\\,0<x<1 \\\\ 0, & \\text{otherwise}\\end{aligned}\\,{f}_{X}(x)=\\{\\begin{aligned}\\frac{3}{2}(1-{x}^{2}), & 0<x<1 \\\\ 0, & \\text{otherwise}\\end{aligned}\\end{aligned}\n$$\n\nLet $X$ and $Y$  be continuous random variables. Their joint probability density function and the marginal probability density function of $X$ are shown above. Find the expression for the conditional expected value $\\text{E}[Y\\,|\\,X=x]$ for $0<x<1.$" #edb/ref 17592186045417] [17592186162414 #edb/ref 1072 #uuid "9d9910fd-054f-5969-9b22-8e682fab832a" #edb/ref 17592186045417] [17592186162414 #edb/ref 1074 "Recall that the conditional expected value of $Y$ given $X=x$ is defined by\n\n$$\n\\text{E}[Y\\,|\\,X=x]={\\int }_{-\\infty }^{\\infty }y\\,{f}_{Y|X}(y\\,|\\,x)\\,\\text{d}y.\n$$\n\nNote that $\\text{E}[Y\\,|\\,X=x]$ is a function of $x.$ \n\nThe conditional density function of $Y$ given $X=x$ can be computed as \n\n$$\n\\begin{aligned}{f}_{Y|X}(y\\,|\\,x) & =\\frac{f(x,y)}{{f}_{X}(x)} \\\\  & =\\frac{(\\frac{3}{2})}{\\frac{3}{2}(1-{x}^{2})} \\\\  & =\\frac{1}{1-{x}^{2}},\\end{aligned}\n$$\n\nwhere ${x}^{2}\\le y\\le 1,\\,0<x<1.$ Outside this domain, we have ${f}_{Y|X}(y\\,|\\,x)=0.$\n\nTherefore, using the definition of the conditional expectation above, we obtain \n\n$$\n\\begin{aligned}\\text{E}[Y\\,|\\,X=x] & ={\\int }_{-\\infty }^{\\infty }y\\,{f}_{Y|X}(y\\,|\\,x)\\,\\text{d}y \\\\  & ={\\int }_{{x}^{2}}^{1}y\\cdot \\,\\frac{1}{1-{x}^{2}}\\,\\text{d}y \\\\  & =\\frac{1}{1-{x}^{2}}{\\int }_{{x}^{2}}^{1}y\\,\\text{d}y \\\\  & =\\frac{1}{1-{x}^{2}}{[\\frac{{y}^{2}}{2}]}_{{x}^{2}}^{1} \\\\  & =\\frac{1}{1-{x}^{2}}[\\frac{1}{2}-\\frac{{x}^{4}}{2}] \\\\  & =\\frac{1}{1-{x}^{2}}\\cdot \\frac{1-{x}^{4}}{2} \\\\  & =\\frac{1}{\\cancel{1-{x}^{2}}}\\cdot \\frac{\\cancel{(1-{x}^{2})}(1+{x}^{2})}{2} \\\\  & =\\frac{1+{x}^{2}}{2}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186163099 #edb/ref 1058 #edb/ref 17592186163127 #edb/ref 17592186045417] [17592186163099 #edb/ref 1061 38822 #edb/ref 17592186045417] [17592186163099 #edb/ref 1062 #uuid "282b0aa7-ba2b-5cf7-a3e4-71b3c23149c6" #edb/ref 17592186045417] [17592186163099 #edb/ref 1063 #edb/ref 17592186163340 #edb/ref 17592186045417] [17592186163105 #edb/ref 1058 #edb/ref 17592186163106 #edb/ref 17592186045417] [17592186163105 #edb/ref 1061 38861 #edb/ref 17592186045417] [17592186163105 #edb/ref 1062 #uuid "a1982d74-327b-5c93-bb74-783cbc9372a2" #edb/ref 17592186045417] [17592186163105 #edb/ref 1063 #edb/ref 17592186162127 #edb/ref 17592186045417] [17592186163106 #edb/ref 1061 38877 #edb/ref 17592186045417] [17592186163106 #edb/ref 1062 #uuid "850d0de4-ea82-55a1-8a30-8ac3203528ea" #edb/ref 17592186045417] [17592186163106 #edb/ref 1063 #edb/ref 17592186162128 #edb/ref 17592186045417] [17592186163107 #edb/ref 1058 #edb/ref 17592186163105 #edb/ref 17592186045417] [17592186163107 #edb/ref 1061 38880 #edb/ref 17592186045417] [17592186163107 #edb/ref 1062 #uuid "b8bd50e9-6e43-51c0-981c-5d228ed06948" #edb/ref 17592186045417] [17592186163107 #edb/ref 1063 #edb/ref 17592186162129 #edb/ref 17592186045417] [17592186163127 #edb/ref 1058 #edb/ref 17592186163107 #edb/ref 17592186045417] [17592186163127 #edb/ref 1061 39220 #edb/ref 17592186045417] [17592186163127 #edb/ref 1062 #uuid "d7f16db2-fef5-5e1e-9727-5f6164e5f735" #edb/ref 17592186045417] [17592186163127 #edb/ref 1063 #edb/ref 17592186163348 #edb/ref 17592186045417] [17592186163340 #edb/ref 1064 "For continuous random variables $X$ and $Y,$ the **conditional expectation of $X$ given $Y=y$** is defined as\n\n$$\n\\textrm E[X |Y = y] =\\int\\limits_{\\mathbb R} x \\, f_{X|Y}(x|y)\\;\\textrm dx,\n$$\n\nwhere $f_{X|Y}(x|y)$ is the conditional probability density function of $X$ given $Y.$ \n\nThis definition is similar to that of $\\textrm{E}[X].$ However, we now use the conditional PDF $f_{X|Y}(x|y)$ instead of the marginal PDF $f_X(x)$ in our integral.\n\nNote the following:\n\n- When we select a particular value of $y,$ the conditional expected value of $X$ given $Y=y$ returns a real number. However, if $y$ is not specified, i.e., $\\textrm{E}[X |Y = y]$ *depends* on $y,$ we have that $\\textrm{E}[X |Y = y]$ gives us a *function* of $y.$\n\n- If $X$ and $Y$ are independent, then $\\textrm E[X | Y = y] = \\textrm E[X]$ for all $y$.\n\n- We sometimes use the notation $\\mu_{X|y}$ to denote $E[X | Y = y].$\n\n- We have an analogous definition for $\\textrm E[Y |X = x]\\mathbin{:}$\n\n$$\n\\textrm E[Y |X = x] =\\int\\limits_{\\mathbb R} y \\, f_{Y|X}(y|x)\\;\\textrm dy,\n$$\n\nwhere $f_{Y|X}(y|x)$ is the conditional probability density function of $Y$ given $X.$" #edb/ref 17592186045417] [17592186163340 #edb/ref 1065 6428 #edb/ref 17592186045417] [17592186163340 #edb/ref 1066 #uuid "9640f2b9-e8e6-51dd-8c81-c7f1a9f45362" #edb/ref 17592186045417] [17592186163340 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186163348 #edb/ref 1064 "Let's find the conditional expectation $\\textrm{E}\\big[X \\,|\\, Y=1\\big]$ given that the conditional probability density function $f_{X|Y}(x \\,|\\, 1)$ is given by\n![](images/8b/8b71da7aecae81ed4e8d9dc27f4730d3d0a03d73146b7b899003d3f8787694bc.svg) \n\nApplying the formula for the conditional expectation of $X$ given $Y=y,$ we have\n\n$$\n\\begin{aligned}\\text{E}[X\\,|\\,Y=1] & ={\\int }_{-\\infty }^{\\infty }x\\,{f}_{X|Y}(x\\,|\\,1)\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}x\\cdot 2(x-1)\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}2x(x-1)\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}2{x}^{2}-2x\\,\\text{d}x \\\\  & ={[\\frac{2{x}^{3}}{3}-{x}^{2}]}_{1}^{2} \\\\  & =[\\frac{2(2)^{3}}{3}-(2)^{2}]-[\\frac{2(1)^{3}}{3}-(1)^{2}] \\\\  & =[\\frac{16}{3}-4]-[\\frac{2}{3}-1] \\\\  & =[\\frac{16}{3}-\\frac{12}{3}]-[\\frac{2}{3}-\\frac{3}{3}] \\\\  & =\\frac{4}{3}-(-\\frac{1}{3}) \\\\  & =\\frac{5}{3}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186163348 #edb/ref 1065 6481 #edb/ref 17592186045417] [17592186163348 #edb/ref 1066 #uuid "8c2314f8-7929-53f2-9261-e2cc145337ae" #edb/ref 17592186045417] [17592186163348 #edb/ref 1067 "A Worked Example" #edb/ref 17592186045417] [17592186528297 #edb/ref 1043 #edb/ref 17592186529198 #edb/ref 17592186045417] [17592186528297 #edb/ref 1043 #edb/ref 17592186529201 #edb/ref 175