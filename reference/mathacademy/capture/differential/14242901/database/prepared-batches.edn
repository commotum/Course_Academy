ield/choices "answer-0cf54b0a-f725-5551-884f-5f05c8e0bbfe"] ["answer-field-f8d46926-9db0-5c4b-a3db-34f864eb0fca" :answer-field/choices "answer-07bd78db-1c06-5810-ad16-f709dc55c0f3"] ["question-f4e2f465-8077-58ed-9a98-b0019bd19799" :question/answer-fields "answer-field-f8d46926-9db0-5c4b-a3db-34f864eb0fca"] [17592186115354 :knowledge-point/questions "question-f4e2f465-8077-58ed-9a98-b0019bd19799"] ["question-6a136627-eda2-5d29-b505-8b7058c4663c" :question/id #uuid "6a136627-eda2-5d29-b505-8b7058c4663c"] ["question-6a136627-eda2-5d29-b505-8b7058c4663c" :question/math-academy-id "q-162654"] ["question-6a136627-eda2-5d29-b505-8b7058c4663c" :question/problem "Find the domain of the vector-valued function $f(s)=⟨\\frac{1}{{s}^{2}+1},\\,8s,\\,\\operatorname{ln}⁡(s+2)⟩.$"] ["question-6a136627-eda2-5d29-b505-8b7058c4663c" :question/worked-solution "To find the domain of $f$, we need the intersection of the domains of the individual components.\n\n- The domain of the 1st component $\\frac{1}{{s}^{2}+1}$ is $s\\in (-\\infty ,\\infty ).$\n\n- The domain of the 2nd component $8s$ is $s\\in (-\\infty ,\\infty ).$\n\n- The domain of the 3rd component $\\operatorname{ln}⁡(s+2)$ is $s\\in (-2,\\infty ).$\n\nThe intersection is illustrated in the diagram below.\n\n![](images/39/39aa3fde0371988849572ce6f92a7e9994e4756db4aafd6f82dc7c86aa321dc1.png)\n\nTherefore, the domain of the vector-valued function $f(s)$ is $s\\in (-2,\\infty ).$"] ["question-6a136627-eda2-5d29-b505-8b7058c4663c" :question/difficulty :question.difficulty/easy] ["answer-field-a5bbfcd1-3d27-527f-b11e-e1b0237715ed" :answer-field/id #uuid "a5bbfcd1-3d27-527f-b11e-e1b0237715ed"] ["answer-31e183d1-a4ca-52c9-a62d-d1d64eaa24f4" :answer/id #uuid "31e183d1-a4ca-52c9-a62d-d1d64eaa24f4"] ["answer-31e183d1-a4ca-52c9-a62d-d1d64eaa24f4" :answer/type :answer.type/math] ["answer-31e183d1-a4ca-52c9-a62d-d1d64eaa24f4" :answer/value "s\\in (-2,1)"] ["answer-44d9d9d8-b252-559e-9a97-3fa5616eb628" :answer/id #uuid "44d9d9d8-b252-559e-9a