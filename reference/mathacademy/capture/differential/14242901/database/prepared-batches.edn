[{"source" ":org/Math-Academy" "forms" [{:db/id 17592186115354 :knowledge-point/questions ["question-72c1cee2-c377-54c5-9063-216281f970a4" "question-f4e2f465-8077-58ed-9a98-b0019bd19799"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186115355 :knowledge-point/questions ["question-6a136627-eda2-5d29-b505-8b7058c4663c"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186115356 :knowledge-point/questions ["question-8fca9eb0-e6f5-519c-a32f-bb2e9feb0354"] :db/ensure [:knowledge-point/validate]} {:db/id "question-72c1cee2-c377-54c5-9063-216281f970a4" :question/id #uuid "72c1cee2-c377-54c5-9063-216281f970a4" :question/math-academy-id "q-161527" :question/problem "Find the domain of the vector-valued function $f(t)=⟨5t,\\,\\frac{1}{(t+2)^{2}},\\,{e}^{t}+t⟩.$" :question/worked-solution "To find the domain of $f$, we need the intersection of the domains of the individual components.\n\n- The domain of the 1st component $5t$ is $t\\in (-\\infty ,\\infty ).$\n\n- The domain of the 2nd component $\\frac{1}{(t+2)^{2}}$ is $t\\in (-\\infty ,-2)\\cup (-2,\\infty ).$\n\n- The domain of the 3rd component ${e}^{t}+t$ is $t\\in (-\\infty ,\\infty ).$\n\nThe intersection is illustrated in the diagram below.\n\n![](images/b5/b50ca0dfe2d2fa5a56edd03e9e4817751f821d610faba2e2dd3eb07982157a4a.png)\n\nTherefore, the domain of the vector-valued function $f(t)$ is $t\\in (-\\infty ,-2)\\cup (-2,\\infty ).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-7bd512c5-050a-5de9-b738-4e68c0945c73"] :db/ensure [:question/validate]} {:db/id "answer-field-7bd512c5-050a-5de9-b738-4e68c0945c73" :answer-field/id #uuid "7bd512c5-050a-5de9-b738-4e68c0945c73" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-17792dbc-3022-5692-9147-a173d879d4cf" :answer-field/choices ["answer-cf30b158-f341-51ed-90af-5cb6af59fb85" "answer-bdad9bdb-98f2-5981-9f75-f056ba73a9ff" "answer-17792dbc-3022-5692-9147-a173d879d4cf" "answer-dfca12b4-10d3-59be-aa62-e629aee82744" "answer-0e3e3a56-c662-5bf1-b12c-84ef667edc70"] :db/ensure [:answer-field/validate]} {:db/id "answer-cf30b158-f341-51ed-90af-5cb6af59fb85" :answer/id #uuid "cf30b158-f341-51ed-90af-5cb6af59fb85" :answer/type :answer.type/math :answer/value "t\\in (-\\infty ,-2)" :db/ensure [:answer/validate]} {:db/id "answer-bdad9bdb-98f2-5981-9f75-f056ba73a9ff" :answer/id #uuid "bdad9bdb-98f2-5981-9f75-f056ba73a9ff" :answer/type :answer.type/math :answer/value "t\\in (-\\infty ,-2)\\cup (-2,0]" :db/ensure [:answer/validate]} {:db/id "answer-17792dbc-3022-5692-9147-a173d879d4cf" :answer/id #uuid "17792dbc-3022-5692-9147-a173d879d4cf" :answer/type :answer.type/math :answer/value "t\\in (-\\infty ,-2)\\cup (-2,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-dfca12b4-10d3-59be-aa62-e629aee82744" :answer/id #uuid "dfca12b4-10d3-59be-aa62-e629aee82744" :answer/type :answer.type/math :answer/value "t\\in (2,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-0e3e3a56-c662-5bf1-b12c-84ef667edc70" :answer/id #uuid "0e3e3a56-c662-5bf1-b12c-84ef667edc70" :answer/type :answer.type/math :answer/value "t\\in [0,\\infty )" :db/ensure [:answer/validate]} {:db/id "question-f4e2f465-8077-58ed-9a98-b0019bd19799" :question/id #uuid "f4e2f465-8077-58ed-9a98-b0019bd19799" :question/math-academy-id "q-162680" :question/problem "Find the domain of the vector-valued function $f(t)=({t}^{2}+t)\\,i+\\frac{1}{2+2t}\\,j+\\sqrt{2-t}\\,k.$" :question/worked-solution "To find the domain of $f$, we need the intersection of the domains of the individual components.\n\n- The domain of the 1st component ${t}^{2}+t$ is $t\\in (-\\infty ,\\infty ).$\n\n- The domain of the 2nd component $\\frac{1}{2+2t}$ is $t\\in (-\\infty ,-1)\\cup (-1,\\infty ).$\n\n- The domain of the 3rd component $\\sqrt{2-t}$ is $t\\in (-\\infty ,2].$\n\nThe intersection is illustrated in the diagram below.\n\n![](images/61/61138db6d0965f64d225d694f90e237955db1e5adfb67cfbf6adfae82520f3aa.png)\n\nTherefore, the domain of the vector-valued function $f(t)$ is $t\\in (-\\infty ,-1)\\cup (-1,2].$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f8d46926-9db0-5c4b-a3db-34f864eb0fca"] :db/ensure [:question/validate]} {:db/id "answer-field-f8d46926-9db0-5c4b-a3db-34f864eb0fca" :answer-field/id #uuid "f8d46926-9db0-5c4b-a3db-34f864eb0fca" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ee3dd53d-bf85-5bc4-91b3-36c445b230cc" :answer-field/choices ["answer-b522003f-42c6-526b-a9a0-8f6e5fb9a329" "answer-debfad90-7328-5c02-8b60-8a2861a146aa" "answer-ee3dd53d-bf85-5bc4-91b3-36c445b230cc" "answer-0cf54b0a-f725-5551-884f-5f05c8e0bbfe" "answer-07bd78db-1c06-5810-ad16-f709dc55c0f3"] :db/ensure [:answer-field/validate]} {:db/id "answer-b522003f-42c6-526b-a9a0-8f6e5fb9a329" :answer/id #uuid "b522003f-42c6-526b-a9a0-8f6e5fb9a329" :answer/type :answer.type/math :answer/value "t\\in (-1,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-debfad90-7328-5c02-8b60-8a2861a146aa" :answer/id #uuid "debfad90-7328-5c02-8b60-8a2861a146aa" :answer/type :answer.type/math :answer/value "t\\in (-\\infty ,-1)" :db/ensure [:answer/validate]} {:db/id "answer-ee3dd53d-bf85-5bc4-91b3-36c445b230cc" :answer/id #uuid "ee3dd53d-bf85-5bc4-91b3-36c445b230cc" :answer/type :answer.type/math :answer/value "t\\in (-\\infty ,-1)\\cup (-1,2]" :db/ensure [:answer/validate]} {:db/id "answer-0cf54b0a-f725-5551-884f-5f05c8e0bbfe" :answer/id #uuid "0cf54b0a-f725-5551-884f-5f05c8e0bbfe" :answer/type :answer.type/math :answer/value "t\\in (-\\infty ,-2)\\cup (-2,1)" :db/ensure [:answer/validate]} {:db/id "answer-07bd78db-1c06-5810-ad16-f709dc55c0f3" :answer/id #uuid "07bd78db-1c06-5810-ad16-f709dc55c0f3" :answer/type :answer.type/math :answer/value "t\\in (-\\infty ,2]" :db/ensure [:answer/validate]} {:db/id "question-6a136627-eda2-5d29-b505-8b7058c4663c" :question/id #uuid "6a136627-eda2-5d29-b505-8b7058c4663c" :question/math-academy-id "q-162654" :question/problem "Find the domain of the vector-valued function $f(s)=⟨\\frac{1}{{s}^{2}+1},\\,8s,\\,\\operatorname{ln}⁡(s+2)⟩.$" :question/worked-solution "To find the domain of $f$, we need the intersection of the domains of the individual components.\n\n- The domain of the 1st component $\\frac{1}{{s}^{2}+1}$ is $s\\in (-\\infty ,\\infty ).$\n\n- The domain of the 2nd component $8s$ is $s\\in (-\\infty ,\\infty ).$\n\n- The domain of the 3rd component $\\operatorname{ln}⁡(s+2)$ is $s\\in (-2,\\infty ).$\n\nThe intersection is illustrated in the diagram below.\n\n![](images/39/39aa3fde0371988849572ce6f92a7e9994e4756db4aafd6f82dc7c86aa321dc1.png)\n\nTherefore, the domain of the vector-valued function $f(s)$ is $s\\in (-2,\\infty ).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a5bbfcd1-3d27-527f-b11e-e1b0237715ed"] :db/ensure [:question/validate]} {:db/id "answer-field-a5bbfcd1-3d27-527f-b11e-e1b0237715ed" :answer-field/id #uuid "a5bbfcd1-3d27-527f-b11e-e1b0237715ed" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-44d9d9d8-b252-559e-9a97-3fa5616eb628" :answer-field/choices ["answer-31e183d1-a4ca-52c9-a62d-d1d64eaa24f4" "answer-44d9d9d8-b252-559e-9a97-3fa5616eb628" "answer-515ce0a5-4d67-58af-b600-76c1d1c303ac" "answer-4423b7c6-a52e-5509-8de4-c87344bea059" "answer-dba29d51-05a7-5944-b853-8d252a2a96b0"] :db/ensure [:answer-field/validate]} {:db/id "answer-31e183d1-a4ca-52c9-a62d-d1d64eaa24f4" :answer/id #uuid "31e183d1-a4ca-52c9-a62d-d1d64eaa24f4" :answer/type :answer.type/math :answer/value "s\\in (-2,1)" :db/ensure [:answer/validate]} {:db/id "answer-44d9d9d8-b252-559e-9a97-3fa5616eb628" :answer/id #uuid "44d9d9d8-b252-559e-9a97-3fa5616eb628" :answer/type :answer.type/math :answer/value "s\\in (-2,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-515ce0a5-4d67-58af-b600-76c1d1c303ac" :answer/id #uuid "515ce0a5-4d67-58af-b600-76c1d1c303ac" :answer/type :answer.type/math :answer/value "s\\in (-\\infty ,-2)" :db/ensure [:answer/validate]} {:db/id "answer-4423b7c6-a52e-5509-8de4-c87344bea059" :answer/id #uuid "4423b7c6-a52e-5509-8de4-c87344bea059" :answer/type :answer.type/math :answer/value "s\\in (1,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-dba29d51-05a7-5944-b853-8d252a2a96b0" :answer/id #uuid "dba29d51-05a7-5944-b853-8d252a2a96b0" :answer/type :answer.type/math :answer/value "s\\in (2,\\infty )" :db/ensure [:answer/validate]} {:db/id 17592186281515 :question/problem "The domain of the vector-valued function $f(t)=\\operatorname{cot}⁡(2t)\\,i+\\operatorname{cos}⁡t\\,j+({t}^{3}+1)\\,k$ is \n\n$$\nt\\in (-\\infty ,\\infty ),\\,t\\ne \\bbox[5pt,border:1pt solid black]{\\phantom{AAAAA}}.\n$$\n\nWhat is the missing expression? You may assume that $n$ is an integer." :db/ensure [:question/validate]} {:db/id 17592186281510 :question/problem "The domain of the vector-valued function $f(t)={t}^{4}\\,i+2\\operatorname{csc}⁡t\\,j+{e}^{t}\\,k$ is \n\n$$\nt\\in (-\\infty ,\\infty ),\\,t\\ne \\bbox[5pt,border:1pt solid black]{\\phantom{AAAAA}}.\n$$\n\nWhat is the missing expression? You may assume that $n$ is an integer." :db/ensure [:question/validate]} {:db/id "question-8fca9eb0-e6f5-519c-a32f-bb2e9feb0354" :question/id #uuid "8fca9eb0-e6f5-519c-a32f-bb2e9feb0354" :question/math-academy-id "q-161534" :question/problem "The domain of the vector-valued function $f(t)=\\operatorname{csc}⁡t\\,i+{e}^{-{t}^{2}}\\,j+(t-1)^{3}\\,k$ is \n\n$$\nt\\in (-\\infty ,\\infty ),\\,t\\ne \\bbox[5pt,border:1pt solid black]{\\phantom{AAAAA}}.\n$$\n\nWhat is the missing expression? You may assume that $n$ is an integer." :question/worked-solution "To find the domain of $f$, we need the intersection of the domains of the individual components.\n\n- The domain of the $1$st component $\\operatorname{csc}⁡t$ is $t\\in (-\\infty ,\\infty ),$ $t\\ne n\\pi ,$  where $n$ is an integer.\n\n- The domain of the $2$nd component  ${e}^{-{t}^{2}}$ is $t\\in (-\\infty ,\\infty ).$\n\n- The domain of the $3$rd component $(t-1)^{3}$ is  $t\\in (-\\infty ,\\infty )$\n\nTherefore, the domain of the vector-valued function $f(t)$ is \n\n$$\nt\\in (-\\infty ,\\infty ),\\,t\\ne n\\pi ,\n$$\n\nwhere $n$ is an integer." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-45690dea-1ba3-504a-87b5-58ba96cb252b"] :db/ensure [:question/validate]} {:db/id "answer-field-45690dea-1ba3-504a-87b5-58ba96cb252b" :answer-field/id #uuid "45690dea-1ba3-504a-87b5-58ba96cb252b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-325f0324-6644-537f-8902-57c28b2b7e58" :answer-field/choices ["answer-caf5664b-18a2-5954-9ee6-dba84e81a45b" "answer-e4bf4686-2e08-55b1-9c61-d5e51a43466d" "answer-a89b6c45-d211-542e-bfa5-1a0941f80d5f" "answer-f708bc31-553a-5790-aacb-1dea3a94acc6" "answer-325f0324-6644-537f-8902-57c28b2b7e58"] :db/ensure [:answer-field/validate]} {:db/id "answer-caf5664b-18a2-5954-9ee6-dba84e81a45b" :answer/id #uuid "caf5664b-18a2-5954-9ee6-dba84e81a45b" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-e4bf4686-2e08-55b1-9c61-d5e51a43466d" :answer/id #uuid "e4bf4686-2e08-55b1-9c61-d5e51a43466d" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{2}+n\\pi " :db/ensure [:answer/validate]} {:db/id "answer-a89b6c45-d211-542e-bfa5-1a0941f80d5f" :answer/id #uuid "a89b6c45-d211-542e-bfa5-1a0941f80d5f" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{4}+\\frac{n\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "answer-f708bc31-553a-5790-aacb-1dea3a94acc6" :answer/id #uuid "f708bc31-553a-5790-aacb-1dea3a94acc6" :answer/type :answer.type/math :answer/value "\\frac{n\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "answer-325f0324-6644-537f-8902-57c28b2b7e58" :answer/id #uuid "325f0324-6644-537f-8902-57c28b2b7e58" :answer/type :answer.type/math :answer/val