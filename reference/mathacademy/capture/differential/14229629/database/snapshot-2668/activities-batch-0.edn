 {:db/id #edb/ref 17592186351220} {:db/id #edb/ref 17592186351221} {:db/id #edb/ref 17592186351233} {:db/id #edb/ref 17592186373463} {:db/id #edb/ref 17592186375425} {:db/id #edb/ref 17592186481391} {:db/id #edb/ref 17592186481422} {:db/id #edb/ref 17592186490324}] :knowledge-point/title "Finding a Component of a Vector With Respect to a Given Orthogonal Basis"} :step/id #uuid "de4c2603-0fe6-5fca-ad09-e02417514da9" :step/math-academy-id 26152 :step/next {:db/id #edb/ref 17592186158105}} {:db/id #edb/ref 17592186158105 :step/content {:db/id #edb/ref 17592186157277 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157081 :question/id #uuid "d7df79a9-2489-5fed-9e00-29890bd01f82" :question/math-academy-id "e-7113"} :knowledge-point/id #uuid "39b12711-22c8-5cb7-bd61-e128734e7e6f" :knowledge-point/questions [{:db/id #edb/ref 17592186157769} {:db/id #edb/ref 17592186157770} {:db/id #edb/ref 17592186237886} {:db/id #edb/ref 17592186237888} {:db/id #edb/ref 17592186326838} {:db/id #edb/ref 17592186351222} {:db/id #edb/ref 17592186351234} {:db/id #edb/ref 17592186351235} {:db/id #edb/ref 17592186373449} {:db/id #edb/ref 17592186373456} {:db/id #edb/ref 17592186375418} {:db/id #edb/ref 17592186386000} {:db/id #edb/ref 17592186392347} {:db/id #edb/ref 17592186490244} {:db/id #edb/ref 17592186490247} {:db/id #edb/ref 17592186490328}] :knowledge-point/title "Calculating the Components of a Vector With Respect to a Given Orthonormal Basis"} :step/id #uuid "f247c384-fdd7-5b12-a6d5-f04393f4df78" :step/math-academy-id 26153 :step/next {:db/id #edb/ref 17592186158106}} {:db/id #edb/ref 17592186158106 :step/content {:db/id #edb/ref 17592186158471 :tutorial/content "Given any vector $\\mathbf{x}$ and any subspace $W$ in $\\mathbb{R}^n,$ we can always write $\\mathbf{x}$ as a sum of a vector from $W$ and a vector from $W^{\\perp}.$ This fact is known as the **orthogonal decomposition theorem.** We can state it formally as follows:\n\n*Let $W$ be a subspace of $\\mathbb{R}^n.$ Then each $\\mathbf{x}\\in\\mathbb{R}^n$ can be written uniquely in the form\n\n$$\n\\mathbf{x}= \\mathbf{y}+\\mathbf{z}\n$$\n\nwhere $\\mathbf{y} \\in W$ and $\\mathbf{z} \\in W^{\\perp}.$* \n\n*Moreover, since $\\mathbf y$ is the orthogonal projection of $\\mathbf x$ onto the subspace $W,$ if $\\{\\mathbf{u}_1\\,\\dots,\\mathbf{u}_p\\}$ is any orthogonal basis of $W,$ then* \n\n$$\n\\begin{aligned}y & ={\\text{proj}}_{W}\\,x \\\\  & ={\\text{proj}}_{{u}_{1}}\\,x+{\\text{proj}}_{{u}_{2}}\\,x+⋯+{\\text{proj}}_{{u}_{p}}\\,x \\\\  & =\\frac{x\\cdot {u}_{1}}{{u}_{1}\\cdot {u}_{1}}{u}_{1}+\\frac{x\\cdot {u}_{2}}{{u}_{2}\\cdot {u}_{2}}{u}_{2}+⋯+\\frac{x\\cdot {u}_{p}}{{u}_{p}\\cdot {u}_{p}}{u}_{p}.\\end{aligned}\n$$" :tutorial/id #uuid "789dc38d-c1e0-5bdc-9f01-5940371a326b" :tutorial/math-academy-id 4304 :tutorial/title "The Orthogonal Decomposition Theorem"} :step/id #uuid "450eea64-01cc-591d-9042-fba21e4feb99" :step/math-academy-id 26173}] :activity/title "The Components of a Vector with Respect to an Orthogonal or Orthonormal Basis" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186157482}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186490383} :activity/id #uuid "cc22b251-df3f-5cc0-b38c-623425ac9228" :activity/scope {:db/id #edb/ref 17592186050366 :topic/id #uuid "4395903b-598c-5c34-b488-0d6a79550dd7" :topic/math-academy-id 2825} :activity/steps [{:db/id #edb/ref 17592186490351 :step/content {:db/id #edb/ref 17592186490324 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89245d79-d07d-52fc-b200-d036359ea5dd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186489830} {:answer/id #uuid "8ec329dc-1748-52dd-b167-d53c2b2de5f8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186489838} {:answer/id #uuid "cbb2be99-4d40-5ce0-8615-04e936d37155" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186489962} {:answer/id #uuid "d5cedc30-2694-5244-bfcb-f9f82cdcc31e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186489988} {:answer/id #uuid "ede240b8-195a-5dc0-9427-2e395b73f909" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186490027}] :answer-field/correct {:db/id #edb/ref 17592186489988} :answer-field/id #uuid "846614c1-9a14-59e2-9c4d-0efd9f8946b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186490151}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f89c3382-117b-502e-8af6-ebca79b6f083" :question/math-academy-id "q-102354" :question/problem "Given the orthogonal basis $B$ of ${R}^{3}$ and the vector $x$ below, find the value of $\\frac{5}{3}{x}_{1}$, where ${x}_{1}$ is the first component of $[x]_{B}.$\n\n$$\nB=\\{\\begin{bmatrix}1 \\\\ 2 \\\\ 1\\end{bmatrix},\\begin{bmatrix}-2 \\\\ 1 \\\\ 0\\end{bmatrix},\\begin{bmatrix}-1 \\\\ -2 \\\\ 5\\end{bmatrix}\\}\\,x=\\begin{bmatrix}2 \\\\ 4 \\\\ 8\\end{bmatrix}\n$$" :question/worked-solution "Let's denote the vectors of $B$ as ${q}_{1},\\,{q}_{2},\\,{q}_{3}.$ \n\nSince $B$ is an orthogonal basis, we have that $[x]_{B}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}$, where ${x}_{i}=\\frac{x\\cdot {q}_{i}}{{q}_{i}\\cdot {q}_{i}}.$ Computing ${x}_{1},$ we obtain \n\n$$\n\\begin{aligned}{x}_{1} & =\\frac{x\\cdot {q}_{1}}{{q}_{1}\\cdot {q}_{1}} \\\\  & =\\frac{2\\cdot 1+4\\cdot 2+8\\cdot 1}{{1}^{2}+{2}^{2}+{1}^{2}} \\\\  & =\\frac{2+8+8}{1+4+1} \\\\  & =\\frac{18}{6} \\\\  & =3.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{5}{3}{x}_{1}=\\frac{5}{3}\\cdot 3=5.\n$$"} :step/id #uuid "42789cd5-e071-545e-b036-41b4b0e1042f"} {:db/id #edb/ref 17592186490367 :step/content {:db/id #edb/ref 17592186490328 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35584b0d-5f36-530c-95c4-8d8dec57a042" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3\\sqrt{2} \\\\ -\\sqrt{2}\\end{bmatrix}" :db/id #edb/ref 17592186489635} {:answer/id #uuid "62645a61-af8c-50c1-891a-ec2a1bd6ffa4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}\\sqrt{2} \\\\ -\\sqrt{2}\\end{bmatrix}" :db/id #edb/ref 17592186489746} {:answer/id #uuid "a7dfba1c-89fc-5799-a7ce-902a9097fb41" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}\\frac{3}{\\sqrt{2}} \\\\ -\\frac{3}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186489885} {:answer/id #uuid "b077d275-d97e-5b1d-b7c1-156af5d3749c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-3\\sqrt{2} \\\\ 3\\sqrt{2}\\end{bmatrix}" :db/id #edb/ref 17592186489901} {:answer/id #uuid "cf87e655-37bd-5819-8214-e0383ae42a09" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}\\frac{\\sqrt{2}}{3} \\\\ -\\frac{\\sqrt{2}}{3}\\end{bmatrix}" :db/id #edb/ref 17592186489975}] :answer-field/correct {:db/id #edb/ref 17592186489635} :answer-field/id #uuid "6f22f005-276f-5d7e-8ec0-5d5973524d87" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186490136}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fbba5a71-4786-5f34-9118-2344153343aa" :question/math-academy-id "q-81140" :question/problem "Given the **orthonormal** basis $B=\\{\\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{2}}\\end{bmatrix},\\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}\\}$ of ${R}^{2},$ find $[x]_{B}$ if $x=\\begin{bmatrix}2 \\\\ -4\\end{bmatrix}.$" :question/worked-solution "Let's denote the vectors of $B$ as ${q}_{1},\\,{q}_{2}.$ \n\nSince $B$ is an orthonormal basis, we have that $[x]_{B}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}$, where ${x}_{i}=x\\cdot {q}_{i}.$ Computing the components of $x,$ we get the following: \n\n$$\n\\begin{aligned}{x}_{1} & =\\begin{bmatrix}2 \\\\ -4\\end{bmatrix}\\cdot \\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{2}}\\end{bmatrix}=\\frac{2}{\\sqrt{2}}+\\frac{4}{\\sqrt{2}}=\\frac{6}{\\sqrt{2}}=3\\sqrt{2} \\\\ {x}_{2} & =\\begin{bmatrix}2 \\\\ -4\\end{bmatrix}\\cdot \\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}=\\frac{2}{\\sqrt{2}}-\\frac{4}{\\sqrt{2}}=-\\frac{2}{\\sqrt{2}}=-\\sqrt{2}\\end{aligned}\n$$\n\nTherefore, we have \n\n$$\n[x]_{B}=\\begin{bmatrix}3\\sqrt{2} \\\\ -\\sqrt{2}\\end{bmatrix}.\n$$"} :step/id #uuid "95863f60-8f06-563b-88de-fe49aa124204" :step/next {:db/id #edb/ref 17592186490386}} {:db/id #edb/ref 17592186490376 :step/content {:db/id #edb/ref 17592186490247 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2297f5c1-de21-5ae7-bdaa-c11eef2db9ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186489594} {:answer/id #uuid "2323e7de-6036-569e-953d-d977998ad9b4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-9" :db/id #edb/ref 17592186489596} {:answer/id #uuid "5620e6f6-75a0-5f4a-8f11-1f0be3b41912" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-27" :db/id #edb/ref 17592186489716} {:answer/id #uuid "98d031cb-9e96-593d-bd25-1d64d893572e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186489855} {:answer/id #uuid "b6f0d473-5189-54a8-aa7b-ef8f87c0b58c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-46" :db/id #edb/ref 17592186489915}] :answer-field/correct {:db/id #edb/ref 17592186489915} :answer-field/id #uuid "81c27db6-a846-5a45-83a3-5a70d18bec75" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186490150}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4d4f28f0-6e57-5f1c-b187-80e59b881c47" :question/math-academy-id "q-81108" :question/problem "Given the **orthonormal** basis $B$ of ${R}^{3}$ and the vector $x$ below, find the value of $2{x}_{2}$, where ${x}_{2}$ is the second component of $[x]_{B}.$\n\n$$\nB=\\{\\begin{bmatrix}\\frac{4}{\\sqrt{41}} \\\\ 0 \\\\ \\frac{5}{\\sqrt{41}}\\end{bmatrix},\\begin{bmatrix}-\\frac{5}{\\sqrt{41}} \\\\ 0 \\\\ \\frac{4}{\\sqrt{41}}\\end{bmatrix},\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}\\},\\,x=\\begin{bmatrix}3\\sqrt{41} \\\\ -9 \\\\ -2\\sqrt{41}\\end{bmatrix}\n$$" :question/worked-solution "Let's denote the vectors of $B$ as ${q}_{1},\\,{q}_{2},\\,{q}_{3}.$ \n\nSince $B$ is an orthonormal basis, we have that $[x]_{B}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}$, where ${x}_{i}=x\\cdot {q}_{i}.$ Computing ${x}_{2},$ we obtain\n\n$$\n\\begin{aligned}{x}_{2} & =x\\cdot {q}_{2} \\\\  & =\\begin{bmatrix}3\\sqrt{41} \\\\ -9 \\\\ -2\\sqrt{41}\\end{bmatrix}\\cdot \\begin{bmatrix}-\\frac{5}{\\sqrt{41}} \\\\ 0 \\\\ \\frac{4}{\\sqrt{41}}\\end{bmatrix} \\\\  & =-15+0-8 \\\\  & =-23.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n2{x}_{2}=2\\cdot (-23)=-46.\n$$"} :step/id #uuid "b94c0da3-b4f4-5f78-9cf1-261b170244ad" :step/next {:db/id #edb/ref 17592186490367}} {:db/id #edb/ref 17592186490383 :step/content {:db/id #edb/ref 17592186351219 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ecf8788-69f4-5834-812b-5702d49e4f4f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "20" :db/id #edb/ref 17592186348862} {:answer/id #uuid "7038e2ce-8c22-56c7-bce9-4531c5d29eef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "28" :db/id #edb/ref 17592186349480} {:answer/id #uuid "741b3734-968c-5909-903f-3a1aadd10955" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "19" :db/id #edb/ref 17592186349513} {:answer/id #uuid "ad057dc2-b49e-5c5b-8cd2-a865922a7c52" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "21" :db/id #edb/ref 17592186349981} {:answer/id #uuid "df7ddcb6-3b2b-5373-bd11-799c6429dd8a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14" :db/id #edb/ref 17592186350405}] :answer-field/correct {:db/id #edb/ref 17592186349981} :answer-field/id #uuid "d2b38458-09c8-5aec-b568-d48ebb9481a8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186351072}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a0ea9087-dcb2-563d-a61a-22e857198678" :question/math-academy-id "q-81103" :question/problem "Given the orthogonal basis $B$ of ${R}^{2}$ and the vector $x$ below, find the value of $15{x}_{1},$ where ${x}_{1}$ is the first component of $[x]_{B}.$\n\n$$\nB=\\{\\begin{bmatrix}1 \\\\ -3\\end{bmatrix},\\begin{bmatrix}-6 \\\\ -2\\end{bmatrix}\\},\\,x=\\begin{bmatrix}2 \\\\ -4\\end{bmatrix}\n$$" :question/worked-solution "Let's denote the vectors of $B$ as ${q}_{1},\\,{q}_{2}.$ \n\nSince $B$ is an orthogonal basis, we have that $[x]_{B}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}$, where ${x}_{i}=\\frac{x\\cdot {q}_{i}}{{q}_{i}\\cdot {q}_{i}}.$ Computing ${x}_{1},$ we obtain \n\n$$\n\\begin{aligned}{x}_{1} & =\\frac{x\\cdot {q}_{1}}{{q}_{1}\\cdot {q}_{1}} \\\\  & =\\frac{2\\cdot 1+(-4)\\cdot (-3)}{{1}^{2}+(-3)^{2}} \\\\  & =\\frac{2+12}{1+9} \\\\  & =\\frac{7}{5}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n15{x}_{1}=15\\cdot \\frac{7}{5}=21.\n$$"} :step/id #uuid "dd349e63-c92c-5105-b629-eece45df73c7" :step/next {:db/id #edb/ref 17592186490376}} {:db/id #edb/ref 17592186490386 :step/content {:db/id #edb/ref 17592186490244 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03308ccf-77b0-5a02-af96-d39b1048daf6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-20 \\\\ 10\\end{bmatrix}" :db/id #edb/ref 17592186489519} {:answer/id #uuid "3cf6c244-2a79-5865-8cb4-cbb552d3e654" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-4 \\\\ 22\\end{bmatrix}" :db/id #edb/ref 17592186489653} {:answer/id #uuid "6c09e389-b27b-544f-b450-ec29c5574df9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-20 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186489771} {:answer/id #uuid "83da0c7d-97f5-59a5-8e85-e915619fc0ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}4 \\\\ -10\\end{bmatrix}" :db/id #edb/ref 17592186489816} {:answer/id #uuid "e7ab850f-14bf-53dd-88ed-cd3f163a5e8f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-4 \\\\ 10\\end{bmatrix}" :db/id #edb/ref 17592186490017}] :answer-field/correct {:db/id #edb/ref 17592186489653} :answer-field/id #uuid "32a6cdb5-6723-5485-bdd3-27cef7d40f0f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186490101}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "45f13db9-2e9d-5ea4-a615-95b4e61aba9f" :question/math-academy-id "q-102324" :question/problem "Given the **orthonormal** basis $B=\\{\\begin{bmatrix}\\frac{3}{5} \\\\ \\frac{4}{5}\\end{bmatrix},\\begin{bmatrix}-\\frac{4}{5} \\\\ \\frac{3}{5}\\end{bmatrix}\\}$ of ${R}^{2},$ find $[x]_{B}$ if $x=\\begin{bmatrix}-20 \\\\ 10\\end{bmatrix}.$" :question/worked-solution "Let's denote the vectors of $B$ as ${q}_{1},\\,{q}_{2}.$ \n\nSince $B$ is an orthonormal basis, we have that $[x]_{B}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}$, where ${x}_{i}=x\\cdot {q}_{i}.$ Computing the components of $x,$ we get the following: \n\n$$\n\\begin{aligned}{x}_{1} & =\\begin{bmatrix}-20 \\\\ 10\\end{bmatrix}\\cdot \\begin{bmatrix}\\frac{3}{5} \\\\ \\frac{4}{5}\\end{bmatrix}=-12+8=-4 \\\\ {x}_{2} & =\\begin{bmatrix}-20 \\\\ 10\\end{bmatrix}\\cdot \\begin{bmatrix}-\\frac{4}{5} \\\\ \\frac{3}{5}\\end{bmatrix}=16+6=22\\end{aligned}\n$$\n\nTherefore, we have \n\n$$\n[x]_{B}=\\begin{bmatrix}-4 \\\\ 22\\end{bmatrix}.\n$$"} :step/id #uuid "ece727ba-a6ce-5bd3-b189-44423b34df89" :step/next {:db/id #edb/ref 17592186490351}}] :activity/title "The Components of a Vector with Respect to an Orthogonal or Orthonormal Basis" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186489509}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186508151} :activity/id #uuid "c1103ca1-a4b8-5e45-80ee-206e2a1e5539" :activity/scope {:db/id #edb/ref 17592186050366 :topic/id #uuid "4395903b-598c-5c34-b488-0d6a79550dd7" :topic/math-academy-id 2825} :activity/steps [{:db/id #edb/ref 17592186508128 :step/content {:db/id #edb/ref 17592186373449 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3baa5869-ff0b-5403-b033-919553504d72" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186373451} {:answer/id #uuid "769007af-b6c7-5efe-ac49-fb68e74be631" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{\\sqrt{2}}" :db/id #edb/ref 17592186373452} {:answer/id #uuid "26283cc4-2c94-5a9c-9bb7-189875fd80a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186373453} {:answer/id #uuid "de396bb5-03a1-500f-a618-13ab4495ac21" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186373454} {:answer/id #uuid "05f62fc0-83a8-5811-b698-83d5bb992b8f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186373455}] :answer-field/correct {:db/id #edb/ref 17592186373453} :answer-field/id #uuid "f9cad807-93ce-5f80-9bd9-c184b0c68a8a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186373450}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e6ddfc5b-03e2-58d1-9cba-06e3b340cbab" :question/math-academy-id "q-102321" :question/problem "Given the **orthonormal** basis $B$ of ${R}^{3}$ and the vector $x$ below, find the value of $-2{x}_{2}$, where ${x}_{2}$ is the second component of $[x]_{B}.$\n\n$$\nB=\\{\\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} \\\\ 0\\end{bmatrix},\\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{2}} \\\\ 0\\end{bmatrix},\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}\\},\\,x=\\begin{bmatrix}\\sqrt{2} \\\\ 2\\sqrt{2} \\\\ 2\\end{bmatrix}\n$$" :question/worked-solution "Let's denote the vectors of $B$ as ${q}_{1},\\,{q}_{2},\\,{q}_{3}.$ \n\nSince $B$ is an orthonormal basis, we have that $[x]_{B}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}$, where ${x}_{i}=x\\cdot {q}_{i}.$ Computing ${x}_{2},$ we obtain\n\n$$\n\\begin{aligned}{x}_{2} & =x\\cdot {q}_{2} \\\\  & =\\begin{bmatrix}\\sqrt{2} \\\\ 2\\sqrt{2} \\\\ 2\\end{bmatrix}\\cdot \\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{2}} \\\\ 0\\end{bmatrix} \\\\  & =1-2 \\\\  & =-1.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n-2{x}_{2}=-2\\cdot (-1)=2.\n$$"} :step/id #uuid "3d2d4703-0f66-5735-a395-f8a1316dde9f"} {:db/id #edb/ref 17592186508144 :step/content {:db/id #edb/ref 17592186351220 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "029ad763-c8ac-5848-9e51-a53c81228b42" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15" :db/id #edb/ref 17592186348476} {:answer/id #uuid "0ec60a61-d3a0-5a3c-9fa3-9f052d615228" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186348574} {:answer/id #uuid "3066946a-f044-5204-ab77-bef3a2693067" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186348877} {:answer/id #uuid "51c171be-4034-5192-89e4-b692911a89f9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14" :db/id #edb/ref 17592186349189} {:answer/id #uuid "94ed251c-0d5e-5d2d-94e7-1fb28d07bdcb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186349781}] :answer-field/correct {:db/id #edb/ref 17592186348877} :answer-field/id #uuid "cb94e7f6-2fde-5f36-ac5f-9619c1b6e412" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186351061}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "35f8611c-3990-55b5-9e1a-16081db42aa2" :question/math-academy-id "q-81104" :question/problem "Given the orthogonal basis $B$ of ${R}^{2}$ and the vector $x$ below, find the value of $20{x}_{2},$ where ${x}_{2}$ is the second component of $[x]_{B}.$\n\n$$\nB=\\{\\begin{bmatrix}4 \\\\ -8\\end{bmatrix},\\begin{bmatrix}-2 \\\\ -1\\end{bmatrix}\\},\\,x=\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}\n$$" :question/worked-solution "Let's denote the vectors of $B$ as ${q}_{1},\\,{q}_{2}.$ \n\nSince $B$ is an orthogonal basis, we have that $[x]_{B}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}$, where ${x}_{i}=\\frac{x\\cdot {q}_{i}}{{q}_{i}\\cdot {q}_{i}}.$ Computing ${x}_{2},$ we obtain \n\n$$\n\\begin{aligned}{x}_{2} & =\\frac{x\\cdot {q}_{2}}{{q}_{2}\\cdot {q}_{2}} \\\\  & =\\frac{(-1)\\cdot (-2)+1\\cdot (-1)}{(-2)^{2}+(-1)^{2}} \\\\  & =\\frac{2-1}{4+1} \\\\  & =\\frac{1}{5}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n20{x}_{2}=20\\cdot \\frac{1}{5}=4.\n$$"} :step/id #uuid "9bc5e018-a1be-5fe9-a7e1-d943f160ff64" :step/next {:db/id #edb/ref 17592186508161}} {:db/id #edb/ref 17592186508151 :step/content {:db/id #edb/ref 17592186157770 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "898de07e-22f0-5b81-a6cd-37d35343a1b6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186155542} {:answer/id #uuid "8ac8670e-07ad-5f8d-ac5e-7bfe6a35b537" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186155543} {:answer/id #uuid "c143d4fe-69e7-5420-9ea9-3d38db56c785" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186155544} {:answer/id #uuid "dd1a88aa-b632-5b2b-8f59-780e088a5400" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186155545} {:answer/id #uuid "ffcdc839-cded-5235-88ac-025aad5e9df0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186155546}] :answer-field/correct {:db/id #edb/ref 17592186155542} :answer-field/id #uuid "bc82df55-72c6-562d-ac48-86abb6081419" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186155541}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3f69cf78-fd51-5a1e-96aa-685ecd2890e1" :question/math-academy-id "q-39493" :question/problem "Given the **orthonormal** basis $B$ of ${R}^{3}$ and the vector $x$ below, find the value of $4{x}_{3}$, where ${x}_{3}$ is the third component of $[x]_{B}.$\n\n$$\nB=\\{[\\begin{aligned}-\\frac{1}{\\sqrt{3}} \\\\ \\frac{1}{\\sqrt{3}} \\\\ \\frac{1}{\\sqrt{3}}\\end{aligned}],[\\begin{aligned}\\frac{2}{\\sqrt{6}} \\\\ \\frac{1}{\\sqrt{6}} \\\\ \\frac{1}{\\sqrt{6}}\\end{aligned}],[\\begin{aligned}0 \\\\ \\frac{1}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{2}}\\end{aligned}]\\},\\,x=[\\begin{aligned}-5 \\\\ \\frac{3\\sqrt{2}}{2} \\\\ -\\frac{\\sqrt{2}}{2}\\end{aligned}]\n$$" :question/worked-solution "Let's denote the vectors of $B$ as ${q}_{1},\\,{q}_{2},\\,{q}_{3}.$ \n\nSince $B$ is an orthonormal basis, we have that $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]$, where ${x}_{i}=x\\cdot {q}_{i}.$ Computing ${x}_{3},$ we obtain\n\n$$\n\\begin{aligned}{x}_{3} & =x\\cdot {q}_{3} \\\\  & =[\\begin{aligned}-5 \\\\ \\frac{3\\sqrt{2}}{2} \\\\ -\\frac{\\sqrt{2}}{2}\\end{aligned}]\\cdot [\\begin{aligned}0 \\\\ \\frac{1}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{2}}\\end{aligned}] \\\\  & =\\frac{3}{2}+\\frac{1}{2} \\\\  & =2.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n4{x}_{3}=4\\cdot 2=8.\n$$"} :step/id #uuid "b1a31c7e-0951-5165-83b7-3c5aa3c9dc20" :step/next {:db/id #edb/ref 17592186508144}} {:db/id #edb/ref 17592186508157 :step/content {:db/id #edb/ref 17592186351235 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0990fd7b-21d6-50c6-a747-173db0842535" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186348524} {:answer/id #uuid "2fce5078-e924-52bf-a081-b822054da6cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "30" :db/id #edb/ref 17592186348872} {:answer/id #uuid "39de05b5-020b-5630-834d-7b794db09ff7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186348966} {:answer/id #uuid "4a7f4998-356c-5aea-84e9-57685a5ac81c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{6}" :db/id #edb/ref 17592186349125} {:answer/id #uuid "ee898a3c-4ef1-56c7-b651-7c702754aa39" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186350532}] :answer-field/correct {:db/id #edb/ref 17592186350532} :answer-field/id #uuid "f4ea86f5-53be-5b8e-970a-70ed5d02d48e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186351137}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2c7b8cdd-da80-5fc5-a44b-0a5962fa099a" :question/math-academy-id "q-81142" :question/problem "Given the **orthonormal** basis $B$ of ${R}^{3}$ and the vector $x$ below, find the value of $\\sqrt{6}{x}_{2}$, where ${x}_{2}$ is the second component of $[x]_{B}.$\n\n$$\nB=\\{\\begin{bmatrix}\\frac{2}{\\sqrt{5}} \\\\ -\\frac{1}{\\sqrt{5}} \\\\ 0\\end{bmatrix},\\begin{bmatrix}\\frac{1}{\\sqrt{6}} \\\\ \\frac{2}{\\sqrt{6}} \\\\ \\frac{1}{\\sqrt{6}}\\end{bmatrix},\\begin{bmatrix}\\frac{1}{\\sqrt{30}} \\\\ \\frac{2}{\\sqrt{30}} \\\\ -\\frac{5}{\\sqrt{30}}\\end{bmatrix}\\},\\,x=\\begin{bmatrix}4 \\\\ 5 \\\\ -8\\end{bmatrix}\n$$" :question/worked-solution "Let's denote the vectors of $B$ as ${q}_{1},\\,{q}_{2},\\,{q}_{3}.$ \n\nSince $B$ is an orthonormal basis, we have that $[x]_{B}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}$, where ${x}_{i}=x\\cdot {q}_{i}.$ Computing ${x}_{2},$ we obtain\n\n$$\n\\begin{aligned}{x}_{2} & =x\\cdot {q}_{2} \\\\  & =\\begin{bmatrix}4 \\\\ 5 \\\\ -8\\end{bmatrix}\\cdot \\begin{bmatrix}\\frac{1}{\\sqrt{6}} \\\\ \\frac{2}{\\sqrt{6}} \\\\ \\frac{1}{\\sqrt{6}}\\end{bmatrix} \\\\  & =\\frac{4}{\\sqrt{6}}+\\frac{10}{\\sqrt{6}}-\\frac{8}{\\sqrt{6}} \\\\  & =\\frac{6}{\\sqrt{6}} \\\\  & =\\sqrt{6}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\sqrt{6}{x}_{2}=\\sqrt{6}\\cdot \\sqrt{6}=6.\n$$"} :step/id #uuid "d60fa14c-dd43-51e9-b0de-5ea532d37c12" :step/next {:db/id #edb/ref 17592186508128}} {:db/id #edb/ref 17592186508161 :step/content {:db/id #edb/ref 17592186351221 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19f3bbf1-c0e5-5228-8cff-d59b8275a445" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186348665} {:answer/id #uuid "2e23fd73-4511-51ce-9c9b-a2e85d0d467e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{5}" :db/id #edb/ref 17592186348854} {:answer/id #uuid "3c8ba05b-0fb2-552e-b2c3-c261f851e968" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18" :db/id #edb/ref 17592186348996} {:answer/id #uuid "cae57d69-bc15-563e-b711-8f432ccf3f01" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186350233} {:answer/id #uuid "e1b1524a-a35f-5d39-88f2-6978a5dcde2a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "27" :db/id #edb/ref 17592186350431}] :answer-field/correct {:db/id #edb/ref 17592186348996} :answer-field/id #uuid "f2732aa6-db93-5aa1-a3dd-e5d16456325b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186351132}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d38229d4-d437-56ee-81dd-f6a825ab8d98" :question/math-academy-id "q-81105" :question/problem "Given the orthogonal basis $B$ of ${R}^{2}$ and the vector $x$ below, find the value of $10{x}_{2},$ where ${x}_{2}$ is the second component of $[x]_{B}.$\n\n$$\nB=\\{\\begin{bmatrix}-2 \\\\ -6\\end{bmatrix},\\begin{bmatrix}3 \\\\ -1\\end{bmatrix}\\},\\,x=\\begin{bmatrix}5 \\\\ -3\\end{bmatrix}\n$$" :question/worked-solution "Let's denote the vectors of $B$ as ${q}_{1},\\,{q}_{2}.$ \n\nSince $B$ is an orthogonal basis, we have that $[x]_{B}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}$, where ${x}_{i}=\\frac{x\\cdot {q}_{i}}{{q}_{i}\\cdot {q}_{i}}.$ Computing ${x}_{2},$ we obtain \n\n$$\n\\begin{aligned}{x}_{2} & =\\frac{x\\cdot {q}_{2}}{{q}_{2}\\cdot {q}_{2}} \\\\  & =\\frac{5\\cdot 3+(-3)\\cdot (-1)}{{3}^{2}+(-1)^{2}} \\\\  & =\\frac{15+3}{9+1} \\\\  & =\\frac{9}{5}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n10{x}_{2}=10\\cdot \\frac{9}{5}=18.\n$$"} :step/id #uuid "df9bf2a8-1619-5624-a3e0-651ea74d1dcb" :step/next {:db/id #edb/ref 17592186508157}}] :activity/title "The Components of a Vector with Respect to an Orthogonal or Orthonormal Basis" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186507603}]}
