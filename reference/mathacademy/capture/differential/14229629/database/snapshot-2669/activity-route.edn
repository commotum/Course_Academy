#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186552536} :activity/id #uuid "517de2fd-4e27-5631-8aea-18371a597d86" :activity/scope {:db/id #edb/ref 17592186050366 :topic/id #uuid "4395903b-598c-5c34-b488-0d6a79550dd7" :topic/math-academy-id 2825} :activity/steps [{:db/id #edb/ref 17592186552536 :step/content {:db/id #edb/ref 17592186392347 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8922ae3c-603f-57bf-9d13-2577f00cdf54" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-\\frac{4}{\\sqrt{26}} \\\\ -\\frac{24}{\\sqrt{26}}\\end{bmatrix}" :db/id #edb/ref 17592186392349} {:answer/id #uuid "c8d89c68-6627-5cda-aa57-5ef9affcb139" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-\\frac{10}{\\sqrt{26}} \\\\ -\\frac{24}{\\sqrt{26}}\\end{bmatrix}" :db/id #edb/ref 17592186392350} {:answer/id #uuid "1279d653-2d23-571b-a06b-3fafaed60ab8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 \\\\ -\\sqrt{26}\\end{bmatrix}" :db/id #edb/ref 17592186392351} {:answer/id #uuid "4efb1bad-1459-5810-be3f-8072372d257a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-\\frac{10}{\\sqrt{26}} \\\\ -\\sqrt{26}\\end{bmatrix}" :db/id #edb/ref 17592186392352} {:answer/id #uuid "4765fe02-6447-5405-a090-2cee7b7976a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-\\frac{10}{\\sqrt{26}} \\\\ \\sqrt{26}\\end{bmatrix}" :db/id #edb/ref 17592186392353}] :answer-field/correct {:db/id #edb/ref 17592186392350} :answer-field/id #uuid "8f607589-dc1e-5e13-83ae-8a50bfa4dafa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186392348}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d52318cf-590e-555c-bafa-19ac086a5c9f" :question/math-academy-id "q-40293" :question/problem "Given the **orthonormal** basis $B={\\begin{bmatrix}\\frac{1}{\\sqrt{26}} \\\\ -\\frac{5}{\\sqrt{26}}\\end{bmatrix},\\begin{bmatrix}\\frac{5}{\\sqrt{26}} \\\\ \\frac{1}{\\sqrt{26}}\\end{bmatrix}}$  of ${R}^{2},$ find $[x]_{B}$ if $x=\\begin{bmatrix}-5 \\\\ 1\\end{bmatrix}.$" :question/worked-solution "Let's denote the vectors of $B$ as ${q}_{1},\\,{q}_{2}.$ \n\nSince $B$ is an orthonormal basis, we have that $[x]_{B}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}$, where ${x}_{i}=x\\cdot {q}_{i}.$ Computing the components of $x,$ we get the following: \n\n$$\n\\begin{aligned}{x}_{1} & =\\begin{bmatrix}-5 \\\\ 1\\end{bmatrix}\\cdot \\begin{bmatrix}\\frac{1}{\\sqrt{26}} \\\\ -\\frac{5}{\\sqrt{26}}\\end{bmatrix}=-\\frac{5}{\\sqrt{26}}-\\frac{5}{\\sqrt{26}}=-\\frac{10}{\\sqrt{26}} \\\\ {x}_{2} & =\\begin{bmatrix}-5 \\\\ 1\\end{bmatrix}\\cdot \\begin{bmatrix}\\frac{5}{\\sqrt{26}} \\\\ \\frac{1}{\\sqrt{26}}\\end{bmatrix}=-\\frac{25}{\\sqrt{26}}+\\frac{1}{\\sqrt{26}}=-\\frac{24}{\\sqrt{26}}\\end{aligned}\n$$\n\nTherefore, we have \n\n$$\n[x]_{B}=\\begin{bmatrix}-\\frac{10}{\\sqrt{26}} \\\\ -\\frac{24}{\\sqrt{26}}\\end{bmatrix}.\n$$"} :step/id #uuid "0d255e3d-83de-58fa-a2fb-4134cf57d2f5" :step/next {:db/id #edb/ref 17592186552571}} {:db/id #edb/ref 17592186552537 :step/content {:db/id #edb/ref 17592186552419 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "354f21b2-96ab-5d34-8629-17b1cd8d23d3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186551791} {:answer/id #uuid "5ee3cf3b-86e3-5e57-83f5-b5451cd4c7b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186551893} {:answer/id #uuid "800e78fd-bc77-5f21-8b03-8b51fc29c534" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186551970} {:answer/id #uuid "c3ccdf0e-7384-5c78-bdab-6715b3b614a5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5" :db/id #edb/ref 17592186552133} {:answer/id #uuid "f270c863-ecf9-5d37-bac9-47ebceb975b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-15" :db/id #edb/ref 17592186552232}] :answer-field/correct {:db/id #edb/ref 17592186551791} :answer-field/id #uuid "3231d9e1-5db0-532b-9d06-68eafedeb402" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186552279}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "226b9b94-926b-577f-834a-35ff659d1159" :question/math-academy-id "q-102338" :question/problem "Given the orthogonal basis $B$ of ${R}^{2}$ and the vector $x$ below, find the value of $15{x}_{2},$ where ${x}_{2}$ is the second component of $[x]_{B}.$\n\n$$\nB=\\{[\\begin{aligned}-3 \\\\ 4\\end{aligned}],[\\begin{aligned}4 \\\\ 3\\end{aligned}]\\},\\,x=[\\begin{aligned}10 \\\\ -15\\end{aligned}]\n$$" :question/worked-solution "Let's denote the vectors of $B$ as ${q}_{1},\\,{q}_{2}.$ \n\nSince $B$ is an orthogonal basis, we have that $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$, where ${x}_{i}=\\frac{x\\cdot {q}_{i}}{{q}_{i}\\cdot {q}_{i}}.$ Computing ${x}_{2},$ we obtain \n\n$$\n\\begin{aligned}{x}_{2} & =\\frac{x\\cdot {q}_{2}}{{q}_{2}\\cdot {q}_{2}} \\\\  & =\\frac{10\\cdot 4+(-15)\\cdot 3}{{4}^{2}+{3}^{2}} \\\\  & =\\frac{40-45}{25} \\\\  & =\\frac{-5}{25} \\\\  & =-\\frac{1}{5}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n15{x}_{2}=15\\cdot (-\\frac{1}{5})=-3.\n$$"} :step/id #uuid "12ab800e-4044-5733-b61f-ed72a58c438f" :step/next {:db/id #edb/ref 17592186552569}} {:db/id #edb/ref 17592186552569 :step/content {:db/id #edb/ref 17592186373463 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a75e20a-f8bc-58e6-910e-ec92ed6b662a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-15" :db/id #edb/ref 17592186373465} {:answer/id #uuid "e8171b49-25ec-5cb6-bd6f-5326f46d1f19" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186373466} {:answer/id #uuid "cdcb1cc4-802b-5694-a812-ca49526d0038" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186373467} {:answer/id #uuid "a8e37f87-37f3-562f-884f-53c553f8542d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15" :db/id #edb/ref 17592186373468} {:answer/id #uuid "6f2927c4-96b8-5f86-a96d-2f996a08de0b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186373469}] :answer-field/correct {:db/id #edb/ref 17592186373467} :answer-field/id #uuid "8023f698-f0f2-537a-9fae-ff06d4e399a4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186373464}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d5e8c4f8-d59a-504a-9b0d-85223ced377b" :question/math-academy-id "q-102345" :question/problem "Given the orthogonal basis $B$ of ${R}^{3}$ and the vector $x$ below, find the value of $5{x}_{3}$, where ${x}_{3}$ is the third component of $[x]_{B}.$\n\n$$\nB={\\begin{bmatrix}-1 \\\\ 2 \\\\ 0\\end{bmatrix},\\begin{bmatrix}0 \\\\ 0 \\\\ 2\\end{bmatrix},\\begin{bmatrix}2 \\\\ 1 \\\\ 0\\end{bmatrix}},\\,x=\\begin{bmatrix}5 \\\\ -7 \\\\ 6\\end{bmatrix}\n$$" :question/worked-solution "Let's denote the vectors of $B$ as ${q}_{1},\\,{q}_{2},\\,{q}_{3}.$ \n\nSince $B$ is an orthogonal basis, we have that $[x]_{B}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}$, where ${x}_{i}=\\frac{x\\cdot {q}_{i}}{{q}_{i}\\cdot {q}_{i}}.$ Computing ${x}_{3},$ we obtain \n\n$$\n\\begin{aligned}{x}_{3} & =\\frac{x\\cdot {q}_{3}}{{q}_{3}\\cdot {q}_{3}} \\\\  & =\\frac{5\\cdot 2+(-7)\\cdot 1+6\\cdot 0}{{2}^{2}+{1}^{2}+{0}^{2}} \\\\  & =\\frac{10-7+0}{5} \\\\  & =\\frac{3}{5}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n5{x}_{3}=5\\cdot \\frac{3}{5}=3.\n$$"} :step/id #uuid "79783177-a377-56af-8f45-bf1b327223d8"} {:db/id #edb/ref 17592186552571 :step/content {:db/id #edb/ref 17592186326838 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42047f24-b6a4-5961-a98a-1f14b4853553" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6\\sqrt{2}" :db/id #edb/ref 17592186324506} {:answer/id #uuid "4cf8a34c-ae2c-5fe0-be04-aee4fff25402" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186324605} {:answer/id #uuid "5d86677e-d6de-50a5-ace7-fe65bb43944e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\sqrt{2}" :db/id #edb/ref 17592186324748} {:answer/id #uuid "720498b3-a650-5657-9d59-b06781da4f77" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186324915} {:answer/id #uuid "f7487450-9e70-5ebf-99a3-733bbdbae3e4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186326150}] :answer-field/correct {:db/id #edb/ref 17592186326150} :answer-field/id #uuid "b2b17abd-f93a-53b3-9caf-3a19284d7633" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186326542}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b4b2a4bc-bef5-526b-8331-e2a300c52787" :question/math-academy-id "q-40402" :question/problem "Given the **orthonormal** basis $B$ of ${R}^{3}$ and the vector $x$ below, find the value of $\\frac{{x}_{2}}{4}$, where ${x}_{2}$ is the second component of $[x]_{B}.$\n\n$$\nB={\\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ 0 \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix},\\begin{bmatrix}\\frac{1}{\\sqrt{3}} \\\\ \\frac{1}{\\sqrt{3}} \\\\ -\\frac{1}{\\sqrt{3}}\\end{bmatrix},\\begin{bmatrix}-\\frac{1}{\\sqrt{6}} \\\\ \\frac{2}{\\sqrt{6}} \\\\ \\frac{1}{\\sqrt{6}}\\end{bmatrix}},\\,x=\\begin{bmatrix}2\\sqrt{6} \\\\ 3\\sqrt{6} \\\\ \\sqrt{6}\\end{bmatrix}\n$$" :question/worked-solution "Let's denote the vectors of $B$ as ${q}_{1},\\,{q}_{2},\\,{q}_{3}.$ \n\nSince $B$ is an orthonormal basis, we have that $[x]_{B}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}$, where ${x}_{i}=x\\cdot {q}_{i}.$ Computing ${x}_{2},$ we obtain\n\n$$\n\\begin{aligned}{x}_{2} & =x\\cdot {q}_{2} \\\\  & =\\begin{bmatrix}2\\sqrt{6} \\\\ 3\\sqrt{6} \\\\ \\sqrt{6}\\end{bmatrix}\\cdot \\begin{bmatrix}\\frac{1}{\\sqrt{3}} \\\\ \\frac{1}{\\sqrt{3}} \\\\ -\\frac{1}{\\sqrt{3}}\\end{bmatrix} \\\\  & =2\\sqrt{2}+3\\sqrt{2}-\\sqrt{2} \\\\  & =4\\sqrt{2}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\frac{{x}_{2}}{4}=\\frac{4\\sqrt{2}}{4}=\\sqrt{2}.\n$$"} :step/id #uuid "7e70a0ad-7c83-5596-9dc2-5b6c068009c0" :step/next {:db/id #edb/ref 17592186552573}} {:db/id #edb/ref 17592186552573 :step/content {:db/id #edb/ref 17592186375425 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81ce51a0-4702-52a5-924e-19be4941741b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186375427} {:answer/id #uuid "8e13fed4-8c67-5201-b89b-f871ed602acb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186375428} {:answer/id #uuid "e29a69ff-94da-5a5f-b841-733b403fc0b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186375429} {:answer/id #uuid "030839e0-b252-5ec9-ab41-75211a2931b2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186375430} {:answer/id #uuid "163f74d9-f778-5f59-9cd4-06913957affa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186375431}] :answer-field/correct {:db/id #edb/ref 17592186375429} :answer-field/id #uuid "7ebee8f3-75c4-5f61-8fdf-653df68efc1f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186375426}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "95ff8312-2cb9-54b6-a1c9-9f27ce9c6cd1" :question/math-academy-id "q-81139" :question/problem "Given the orthogonal basis $B$ of ${R}^{3}$ and the vector $x$ below, find the value of $3{x}_{3}$, where ${x}_{3}$ is the third component of $[x]_{B}.$\n\n$$\nB={\\begin{bmatrix}-3 \\\\ 1 \\\\ 1\\end{bmatrix},\\begin{bmatrix}1 \\\\ -4 \\\\ 7\\end{bmatrix},\\begin{bmatrix}1 \\\\ 2 \\\\ 1\\end{bmatrix}},\\,x=\\begin{bmatrix}4 \\\\ 3 \\\\ 6\\end{bmatrix}\n$$" :question/worked-solution "Let's denote the vectors of $B$ as ${q}_{1},\\,{q}_{2},\\,{q}_{3}.$ \n\nSince $B$ is an orthogonal basis, we have that $[x]_{B}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}$, where ${x}_{i}=\\frac{x\\cdot {q}_{i}}{{q}_{i}\\cdot {q}_{i}}.$ Computing ${x}_{3},$ we obtain \n\n$$\n\\begin{aligned}{x}_{3} & =\\frac{x\\cdot {q}_{3}}{{q}_{3}\\cdot {q}_{3}} \\\\  & =\\frac{4\\cdot 1+3\\cdot 2+6\\cdot 1}{{1}^{2}+{2}^{2}+{1}^{2}} \\\\  & =\\frac{4+6+6}{6} \\\\  & =\\frac{8}{3}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n3{x}_{3}=3\\cdot \\frac{8}{3}=8.\n$$"} :step/id #uuid "82fcfff4-ef86-517e-9715-e86ac9ab8b0f" :step/next {:db/id #edb/ref 17592186552537}}] :activity/title "The Components of a Vector with Respect to an Orthogonal or Orthonormal Basis" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186551651}]}
