/answer-fields [{:answer-field/choices [{:answer/id #uuid "49b6d884-1f1f-5515-9208-44fc250671f4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186479470} {:answer/id #uuid "69786cd2-b99b-5dbd-8075-213ab71d07dd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186479517} {:answer/id #uuid "9807ea88-a3a9-5154-a546-71a17c56832c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186479591} {:answer/id #uuid "9e72f8ca-cf52-50d2-beaf-003a6572d927" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186479601} {:answer/id #uuid "b735a3c9-2177-54de-b227-f9c00a922b09" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186479633}] :answer-field/correct {:db/id #edb/ref 17592186479517} :answer-field/id #uuid "a27d4985-c893-59c2-8d1d-cd7a9be7d49e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186479794}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "aa86399c-45ea-5f74-a86a-9df5e96aefc4" :question/math-academy-id "q-71811" :question/problem "Which of the following sets are neither open nor closed?\n\nI. $\\{(x,y)\\in {R}^{2}\\,:\\,0\\le x\\le 2,\\,0\\le {y}^{2}\\le 4\\}$\n\nII. $\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}<9,\\,0\\le x\\le 3\\}$\n\nIII. $\\{(x,y)\\in {R}^{2}\\,:\\,0\\le y<\\sqrt{x},\\,1\\le x\\le 4\\}$" :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nLet's examine our sets in turn.\n\n- The first set is *closed* since it contains all its boundary points (all the corresponding inequalities are not strict).\n\n- The second set is *neither open nor closed*. It contains some of its boundary points, for example, the point $(0,0).$ On the other hand, it does not contain some other boundary points, for example, the point $(3,0).$\n\n- The third set is *neither open nor closed*. It contains some of its boundary points, for example, the point $(1,0).$ On the other hand, it does not contain some other boundary points, for example, the point $(4,2).$\n\nTherefore, the correct answer is \"II and III only.\""} :step/id #uuid "fc7a8ece-f5fa-5dfb-a44a-4b9b848e5eef" :step/next {:db/id #edb/ref 17592186481736}}] :activity/title "Open and Closed Sets" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186481577}]}
