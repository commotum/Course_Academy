-dda3dbb64fc8" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466557}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "20984d3c-4813-50f9-a16b-ba04fcaf3833" :question/math-academy-id "q-161640" :question/problem "Which of the following sets are closed?\n\nI. $\\{(x,y)\\in {R}^{2}\\,:\\,-3<x<-1,\\,1<y<0.5x+3\\}$\n\nII. $\\{(x,y)\\in {R}^{2}\\,:\\,-2\\le x\\le 2,\\,0\\le y\\le 4-{x}^{2}\\}$\n\nIII. $\\{(x,y)\\in {R}^{2}\\,:\\,1<x<2,\\,0<y<2\\}$\n\nSelect all that apply." :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nLet's examine our sets in turn.\n\n- The first set is *open* since it doesn't contain any of its boundary points (all the corresponding inequalities are strict).\n\n- The second set is *closed* since it contains all of its boundary points (all the corresponding inequalities are not strict).\n\n- The third set is *open* since it doesn't contain any of its boundary points (all the corresponding inequalities are strict).\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186409711 :knowledge-point/_questions [{:db/id #edb/ref 17592186192767 :knowledge-point/id #uuid "7adf2c3e-4a73-5098-ab60-790d637728cf" :knowledge-point/title "Identifying Open and Closed Sets in the Plane in Set Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9a21b5b4-8c29-55bf-9071-2d2b633aa59b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472760} {:answer/id #uuid "e0e36382-39e0-5e92-9083-d5fb9b041b92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472761}] :answer-field/correct {:answer/id #uuid "9a21b5b4-8c29-55bf-9071-2d2b633aa59b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472760} :answer-field/id #uuid "d5ccf86d-3b0c-575d-be62-dcd07f2c84b2" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473775} {:answer-field/choices [{:answer/id #uuid "e14bf656-6f18-54c0-9140-a4e367e88751" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472762} {:answer/id #uuid "ba64d4e9-e44f-50cd-ae83-6f4393f74694" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472763}] :answer-field/correct {:answer/id #uuid "ba64d4e9-e44f-50cd-ae83-6f4393f74694" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472763} :answer-field/id #uuid "0b2d70a2-ca62-51f1-bf2b-2dd24fb3a9fd" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473776} {:answer-field/choices [{:answer/id #uuid "a3ffa913-0456-5435-8425-10083a166104" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472764} {:answer/id #uuid "e26a2e2e-02cd-579c-bae8-f4e53d04fb09" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472765}] :answer-field/correct {:answer/id #uuid "a3ffa913-0456-5435-8425-10083a166104" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472764} :answer-field/id #uuid "5f7902ed-77a2-5fae-a322-2ec4a2fe2e71" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473777}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b04f2bd5-de84-5515-a0a5-3d6c81e3d583" :question/math-academy-id "q-161644" :question/problem "Which of the following sets are open?\n- **I.** ${(x,y)\\in {R}^{2}:\\text{ }-2\\le x\\le 0,\\,1\\le y\\le 2-x}$\n- **II.** ${(x,y)\\in {R}^{2}:\\text{ }-1<x<1,\\,0<y<1+x}$\n- **III.** ${(x,y)\\in {R}^{2}:\\text{ }4\\le {x}^{2}+{y}^{2}\\le 9}$\n\nSelect all that apply." :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nLet's examine our sets in turn.\n\n- The first set is *closed* since it contains all of its boundary points (all the corresponding inequalities are not strict).\n\n- The second set is *open* since it doesn't contain any of its boundary points (all the corresponding inequalities are strict).\n\n- The third set is *closed* since it contains all of its boundary points (all the corresponding inequalities are not strict).\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186378864 :knowledge-point/_questions [{:db/id #edb/ref 17592186192767 :knowledge-point/id #uuid "7adf2c3e-4a73-5098-ab60-790d637728cf" :knowledge-point/title "Identifying Open and Closed Sets in the Plane in Set Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b7519ae6-6283-5e9b-a86d-15f672cad5d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471119} {:answer/id #uuid "18729287-882a-5576-aa4a-14fe4