b866-780b1af534a5" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472067}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "be4d8952-950b-5fb0-a574-0337f64e1d84" :question/math-academy-id "q-161648" :question/problem "Which of the following sets are open?\n- **I.** ${(x,y)\\in {R}^{2}:\\text{ }0<x<3,\\,0<y<6-2x}$\n- **II.** ${(x,y)\\in {R}^{2}:\\text{ }1<x<4,\\,x<y<{x}^{2}}$\n- **III.** ${(x,y)\\in {R}^{2}:\\text{ }-1\\le x\\le 1,\\,0\\le {y}^{2}\\le 5}$\n\nSelect all that apply." :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nLet's examine our sets in turn.\n\n- The first set is *open* since it doesn't contain any of its boundary points (all the corresponding inequalities are strict).\n\n- The second set is *open* since it doesn't contain any of its boundary points (all the corresponding inequalities are strict).\n\n- The third set is *closed* since it contains all of its boundary points (all the corresponding inequalities are not strict).\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186193323 :knowledge-point/_questions [{:db/id #edb/ref 17592186192765 :knowledge-point/id #uuid "5c6044dc-d4a7-5662-a825-3c13e49d198a" :knowledge-point/title "Identifying Sets That are Neither Open Nor Closed"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dc67ad68-9c4e-5e01-ad45-5e0583b64cfb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477247} {:answer/id #uuid "33373e69-3a76-5ea7-a9ae-d867253e930d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477248}] :answer-field/correct {:answer/id #uuid "33373e69-3a76-5ea7-a9ae-d867253e930d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477248} :answer-field/id #uuid "1a91c133-f09c-5414-8406-55eccccaf1d1" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477593} {:answer-field/choices [{:answer/id #uuid "b4347200-6d55-5c61-a030-a4ac871e9a91" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477249} {:answer/id #uuid "18b92bb6-72b5-59f3-9611-f5668d921023" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477250}] :answer-field/correct {:answer/id #uuid "b4347200-6d55-5c61-a030-a4ac871e9a91" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477249} :answer-field/id #uuid "c3901499-272d-57fb-ac61-d587813aa8eb" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477594} {:answer-field/choices [{:answer/id #uuid "97ea91e4-3c46-5e6e-a294-087688f785fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477251} {:answer/id #uuid "0aff04e8-7fae-5878-94e2-41f564a32c8f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477252}] :answer-field/correct {:answer/id #uuid "97ea91e4-3c46-5e6e-a294-087688f785fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477251} :answer-field/id #uuid "c67f297c-e6e9-5e72-a41b-b78ae9b4d08e" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477595}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8166eb05-ff92-507f-8eb2-6ecb8cda44b3" :question/math-academy-id "q-35866" :question/problem "Which of the following sets are neither open nor closed?\n- **I.** ${(x,y)\\in {R}^{2}\\,:\\,0\\le x<2,\\,0<y<2}$\n- **II.** ${(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}<2,}$\n- **III.** ${(x,y)\\in {R}^{2}\\,:\\,0\\le y\\le {x}^{2},\\,-1\\le x\\le 1}$\n\nSelect all that apply." :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nLet's examine our sets in turn.\n\n- The first set is *neither open nor closed*. It contains some of its boundary points, for example, the point $(0,1).$ On the other hand, it does not contain some other boundary points, for example, the point $(1,0).$\n\n- The second set is *open* since it doesn't contain any of its boundary points (all the corresponding inequalities are strict).\n\n- The third set is *closed* since it contains all its boundary points (all the corresponding inequalities are not strict).\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186193325 :knowledge-point/_questions [{:db/id #edb/ref 17592186192764 :knowledge-point/id #uuid "f3149834-ef92-5016-a84a-40b207fee519" :knowledge-point/title "Identifying Open and Closed Sets of Real Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "facf23d5-9117-50d0-ada3-7655fa8f7201" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186191878} {:answer/id #uuid "2e69bb7e-e939-5070-bb59-8f9d1092af92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186191879} {:answer/id #uuid "434a1c4a-a3e9-5ea0-b8d0-a0659339a9b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186191880} {:answer/id #uuid "5bb4d92c-87f1-5feb-a1b6-07dcd9ccb1bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186191881} {:answer/id #uuid "645d283a-9751-5b8d-bf9f-045f81ec8255" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186191882}] :answer-field/correct {:answer/id #uuid "facf23d5-9117-50d0-ada3-7655fa8f7201" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186191878} :answer-field/id #uuid "3b69c7f3-c351-59ac-bb07-0af3d7e41c2c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186191877}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "48c2f172-a7b8-52c3-85b9-54d5dd4bd677" :question/math-academy-id "q-36443" :question/problem "Which of the following sets are closed?\n\nI. $[1,2]\\cup [3,4]$\n\nII. $[0,1)$\n\nIII. $[0,1)\\cup (1,2]$" :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nAmong the given sets, only $[1,2]\\cup [3,4]$ is closed. It consists of two parts, where the boundary points are $1,2,3,$ and $4.$ All of them lie in the set.\n\nThe other sets are not closed because:\n\n- $[0,1)$ has a boundary point $1$, which does not lie in the set.\n\n- $[0,1)\\cup (1,2]$ has a boundary point $1$, which does not lie in the set.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186193375 :knowledge-point/_questions [{:db/id #edb/ref 17592186192764 :knowledge-point/id #uuid "f3149834-ef92-5016-a84a-40b207fee519" :knowledge-point/title "Identifying Open and Closed Sets of Real Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d1e5564-8d40-563f-99ca-ee957ca06fd1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186192178} {:answer/id #uuid "a01cf154-099a-50ad-86d5-90669ff55a95" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186192179} {:answer/id #uuid "1ec2d258-24e2-5f14-bda1-db691bc73041" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186192180} {:answer/id #uuid "249ed794-1d5b-5d37-8faa-b48507656f14" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186192181} {:answer/id #uuid "45c72bc5-b256-5cee-a0fb-bc3c117260ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186192182}] :answer-field/correct {:answer/id #uuid "a01cf154-099a-50ad-86d5-90669ff55a95" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186192179} :answer-field/id #uuid "bbcb1643-af9b-5292-9882-9b79589969fd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186192177}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "76376c2d-5792-5547-8d0b-a67daa836dac" :question/math-academy-id "q-65003" :question/problem "Which of the following sets are open?\n\nI. $(-\\infty ,1]$\n\nII. $(0,1)\\cup (5,6)$\n\nIII. $[-3,-1)\\cup (0,1]$" :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nAmong the given sets, only $(0,1)\\cup (5,6)$ is open. It consists of two parts, where the boundary points are $0$, $1$, $5$, and $6.$ None of them lie in the set.\n\nThe other sets are not open because:\n\n- $(-\\infty ,1]$ has a boundary point $1$ and it lies in the set.\n\n- $[-3,-1)\\cup (0,1]$ has four boundary points $-3$, $-1$, $0$, and $1$, and the points $-3$ and $1$ lie in the set.\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186563700 :knowledge-point/_questions [{:db/id #edb/ref 17592186192764 :knowledge-point/id #uuid "f3149834-ef92-5016-a84a-40b207fee519" :knowledge-point/title "Identifying Open and Closed Sets of Real Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fe60442-b181-5edf-a66e-97f8860604d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186562976} {:answer/id #uuid "1ed8fb2e-025d-558e-b734-33e4b83dc4e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186563014} {:answer/id #uuid "ab767696-bebf-5e3e-898c-7b6fb784dec2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186563331} {:answer/id #uuid "f302f02f-61a4-575b-9708-5be939245e79" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186563490} {:answer/id #uuid "fffeb0c3-dc23-57b1-9396-d4b717c58bd3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186563518}] :answer-field/correct {:answer/id #uuid "1ed8fb2e-025d-558e-b734-33e4b83dc4e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186563014} :answer-field/id #uuid "088f8fb8-c517-5efa-a60f-bfc3f63f3d91" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186563521}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6e1139bd-70c8-5172-a11e-474495b10da9" :question/math-academy-id "q-71799" :question/problem "Which of the following sets are open?\n\nI. $(-4,1)$\n\nII. $(2,4)\\cup (5,6)$\n\nIII. $(0,1)\\cup (7,9]$" :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nAmong the given sets, only $(-4,1)$ and $(2,4)\\cup (5,6)$ are open because:\n\n- The boundary points of the set $(-4,1)$ are $-4$, and $1.$ None of them lie in the set.\n\n- The boundary points of the set  $(2,4)\\cup (5,6)$ are $2$, $4$, $5$, and $6.$ None of them lie in the set.\n\nThe other set is not open because $(0,1)\\cup (7,9]$ has four boundary points $0$, $1$, $7$, and $9$, and the point $9$ lies in the set.\n\nTherefore, the correct answer is \"I and II only\"."}] [{:db/id #edb/ref 17592186338994 :knowledge-point/_questions [{:db/id #edb/ref 17592186192765 :knowledge-point/id #uuid "5c6044dc-d4a7-5662-a825-3c13e49d198a" :knowledge-point/title "Identifying Sets That are Neither Open Nor Closed"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b5c97d8-b6b9-59d5-9e48-f02e00576bf3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467878} {:answer/id #uuid "b70b7d57-44be-598c-81f7-72a6992ce643" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467879}] :answer-field/correct {:answer/id #uuid "6b5c97d8-b6b9-59d5-9e48-f02e00576bf3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467878} :answer-field/id #uuid "2e6bbccd-f9e1-5e48-a3e5-91c54d7aa28d" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468660} {:answer-field/choices [{:answer/id #uuid "51d46821-d6ac-5305-ac1d-8e84896e2aa6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467880} {:answer/id #uuid "e135b96f-3787-5488-8560-5b21efdc4cbe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467881}] :answer-field/correct {:answer/id #uuid "e135b96f-3787-5488-8560-5b21efdc4cbe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467881} :answer-field/id #uuid "27ce7f15-6ee7-563e-b1e5-f9c5644feaf4" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468661} {:answer-field/choices [{:answer/id #uuid "a06cdb67-1683-534c-8615-e83f9147b2fb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467882} {:answer/id #uuid "7b4c137e-6f23-51a8-bdc4-64384849f016" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467883}] :answer-field/correct {:answer/id #uuid "a06cdb67-1683-534c-8615-e83f9147b2fb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467882} :answer-field/id #uuid "6e6b7678-25c3-5224-a960-9698f38fdb8c" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468662}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8018b9d7-b35d-54ca-b97a-1ac935d3c057" :question/math-academy-id "q-71815" :question/problem "Which of the following sets are neither open nor closed?\n- **I.** ${(x,y)\\in {R}^{2}:\\text{ }2x+y<6,\\,0<x<3}$\n- **II.** ${(x,y)\\in {R}^{2}:\\text{ }1\\le x<3,\\,2<y\\le 4}$\n- **III.** ${(x,y)\\in {R}^{2}:\\text{ }2{x}^{2}+3{y}^{2}<6}$\n\nSelect all that apply." :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nLet's examine our sets in turn.\n\n- The first set is *open* since it doesn't contain any point of its boundary (all the corresponding inequalities are strict).\n\n- The second set is *neither open nor closed*. It contains some of its boundary points, for example, the point $(1,4).$ On the other hand, it does not contain some other boundary points, for example, the point $(3,2).$\n\n- The third set is *open *since it doesn't contain any point of its boundary (the corresponding inequality is strict).\n\nTherefore, the correct answer is \"II only.\""}]}
