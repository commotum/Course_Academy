#{[{:activity/expected-seconds 840.0 :activity/first-step {:db/id #edb/ref 17592186106673} :activity/id #uuid "e8bbfc2d-b5f4-57c0-9027-1b66b844109b" :activity/scope {:db/id #edb/ref 17592186048819 :topic/id #uuid "c29ac9c3-f2c1-572b-9251-f82101c5a30e" :topic/math-academy-id 1375} :activity/steps [{:db/id #edb/ref 17592186106673 :step/content {:db/id #edb/ref 17592186107090 :tutorial/content "Given a matrix $A,$ an **eigenvector** of $A$ is a *non-zero* vector $\\mathbf{v}$ such that \n\n$$\nA \\mathbf{v} = \\lambda \\mathbf{v}\n$$\n\nfor some scalar $\\lambda \\in \\mathbb{R}.$ The scalar $\\lambda$ is called the **eigenvalue** corresponding to the eigenvector $\\mathbf{v}.$\n\nFor example, consider the matrix \n![](images/63/63e2c65a23a0680412a14084d543b6cc19c0529fd80863b09c99987d309eaa4f.svg) \nand the vector ![](images/b7/b7811b74d8d3075357925864b5be27f57b292dadca9c04d222954baa1e66ba2a.svg) Computing the product $A \\cdot \\mathbf{v},$ we get\n\n$$\n\\begin{aligned}Av & =\\begin{bmatrix}2 & 2 \\\\ 2 & -1\\end{bmatrix}\\cdot \\begin{bmatrix}1 \\\\ -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 \\\\ 4\\end{bmatrix} \\\\  & =(-2)\\cdot \\begin{bmatrix}1 \\\\ -2\\end{bmatrix} \\\\  & =-2v.\\end{aligned}\n$$\n\nWe've discovered that $A {\\color{blue}\\mathbf{v}} = {\\color{red}-2} {\\color{blue}\\mathbf{v}}.$ Therefore,\n\n- the vector ![](images/13/13a28e543647ede7a88b30fb652bd7fba6c9adb8ee3142161a102de947ef2d2a.svg) is an *eigenvector* of $A,$ and\n\n- the scalar $\\color{red}\\lambda=-2$ is the *eigenvalue* corresponding to the eigenvector ${\\color{blue}\\mathbf{v}}.$\n\n**Caution:** Remember that an eigenvector must be a *non-zero* vector. This is very important." :tutorial/id #uuid "1014a8e8-38ce-568b-86d7-22f32ef8f697" :tutorial/math-academy-id 3557 :tutorial/title "Introduction"} :step/id #uuid "9b7139a7-3f19-5d72-857b-7a01a291e46b" :step/math-academy-id 20075 :step/next {:db/id #edb/ref 17592186106674}} {:db/id #edb/ref 17592186106674 :step/content {:db/id #edb/ref 17592186105768 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105620 :question/id #uuid "61bb0d60-a61e-5485-9df5-308e16dfd1aa" :question/math-academy-id "e-5476"} :knowledge-point/id #uuid "c4e9867f-15ba-5073-a20f-542045fced08" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050136} {:db/id #edb/ref 17592186050825}] :knowledge-point/questions [{:db/id #edb/ref 17592186106092} {:db/id #edb/ref 17592186106296} {:db/id #edb/ref 17592186243944} {:db/id #edb/ref 17592186244106} {:db/id #edb/ref 17592186323871} {:db/id #edb/ref 17592186338848} {:db/id #edb/ref 17592186345104} {:db/id #edb/ref 17592186345105} {:db/id #edb/ref 17592186399538} {:db/id #edb/ref 17592186411285}] :knowledge-point/title "Finding the Eigenvalue that Corresponds to a Given Eigenvector"} :step/id #uuid "4921a5cc-f26d-5b7a-9865-e447eec1d53e" :step/math-academy-id 20077 :step/next {:db/id #edb/ref 17592186106746}} {:db/id #edb/ref 17592186106675 :step/content {:db/id #edb/ref 17592186105769 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105621 :question/id #uuid "f4ff15d3-1a6e-56c0-a7c4-13f18ef1a8e1" :question/math-academy-id "e-5477"} :knowledge-point/id #uuid "32467c2c-5605-50e9-b961-a29535a0effb" :knowledge-point/questions [{:db/id #edb/ref 17592186106297} {:db/id #edb/ref 17592186106298} {:db/id #edb/ref 17592186244030} {:db/id #edb/ref 17592186244045} {:db/id #edb/ref 17592186244115} {:db/id #edb/ref 17592186323843} {:db/id #edb/ref 17592186323858} {:db/id #edb/ref 17592186323877} {:db/id #edb/ref 17592186345121} {:db/id #edb/ref 17592186345122} {:db/id #edb/ref 17592186411286} {:db/id #edb/ref 17592186571393}] :knowledge-point/title "Identifying True Statements About Eigenvalues and Eigenvectors"} :step/id #uuid "64cdc019-4015-5867-b014-691bcc52330a" :step/math-academy-id 20078} {:db/id #edb/ref 17592186106676 :step/content {:db/id #edb/ref 17592186105770 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105622 :question/id #uuid "6cba45d6-5a69-5b83-937c-c19368aaeea9" :question/math-academy-id "e-5478"} :knowledge-point/id #uuid "b7f5608f-a9f5-5e6a-b308-540ed8b29259" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048213}] :knowledge-point/questions [{:db/id #edb/ref 17592186106091} {:db/id #edb/ref 17592186106093} {:db/id #edb/ref 17592186243959} {:db/id #edb/ref 17592186243978} {:db/id #edb/ref 17592186243986} {:db/id #edb/ref 17592186243987} {:db/id #edb/ref 17592186244107} {:db/id #edb/ref 17592186244108} {:db/id #edb/ref 17592186287815} {:db/id #edb/ref 17592186345108} {:db/id #edb/ref 17592186345109} {:db/id #edb/ref 17592186369017} {:db/id #edb/ref 17592186495152} {:db/id #edb/ref 17592186571446}] :knowledge-point/title "Determining the Value of an Unknown Given an Eigenvalue and Eigenvector of a Matrix"} :step/id #uuid "6e9a9912-8def-5a76-892f-0608e119d89c" :step/math-academy-id 20081 :step/next {:db/id #edb/ref 17592186106675}} {:db/id #edb/ref 17592186106711 :step/content {:db/id #edb/ref 17592186105787 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105628 :question/id #uuid "df40f37e-0d8f-5eb2-ad8a-9257440851df" :question/math-academy-id "e-5891"} :knowledge-point/id #uuid "49c501da-161c-53be-8349-571cc6a07975" :knowledge-point/questions [{:db/id #edb/ref 17592186106295} {:db/id #edb/ref 17592186106299} {:db/id #edb/ref 17592186243973} {:db/id #edb/ref 17592186243974} {:db/id #edb/ref 17592186345123} {:db/id #edb/ref 17592186345124} {:db/id #edb/ref 17592186369010} {:db/id #edb/ref 17592186386229} {:db/id #edb/ref 17592186392017} {:db/id #edb/ref 17592186393542} {:db/id #edb/ref 17592186393549} {:db/id #edb/ref 17592186393556}] :knowledge-point/title "Plotting the Product of a Matrix and an Eigenvector Given its Corresponding Eigenvalue"} :step/id #uuid "5b97f2fc-3025-5372-9dc4-19c05d084b76" :step/math-academy-id 21410 :step/next {:db/id #edb/ref 17592186106676}} {:db/id #edb/ref 17592186106746 :step/content {:db/id #edb/ref 17592186107098 :tutorial/content "Eigenvectors and eigenvalues can be interpreted geometrically.\n\nFirst, recall that if the matrix ![](images/32/3207697e43e4f88223ad85c16964c3103a50c0c999a4ca14417695158d45526b.svg) is the standard matrix of some linear transformation ![](images/80/80d488fc9d8168cecdf882f1aa178325bb36bd387dd9f86f2b0cd98a5c54f4dc.svg) then the product ![](images/dc/dcc52971e9a7e86ebbe8bf972c562fce13d389f9261b69cba05dcabb1426b9dc.svg) gives the image of ![](images/4f/4fa2300af121b336bb0d7845b8e2b3e34be5a517a1bca45b4ec7b6514b2c544d.svg) under the action of ![](images/a1/a1af41bdb2f2fe410c6f8e02d1a2a0048f0aa470ceef4508753090444ca039be.svg) The image of ![](images/4f/4fa2300af121b336bb0d7845b8e2b3e34be5a517a1bca45b4ec7b6514b2c544d.svg) under the action of ![](images/c1/c15eeb9e7a3ff525fbdcd2f175622bd034f0b34899224f9ce2e08a5300d625de.svg) can appear quite different from the original vector ![](images/92/9221d4dc55c1df8da019956ea23f9d4f9ff3f5b04921ec2158804a31a50e636b.svg)\n\nHowever, for an eigenvector ![](images/77/771507e21f2935d77160257f7d56c3f5fcef1d0a114ac8a38c373c49790dd854.svg) with corresponding eigenvalue ![](images/4a/4a2f3891f0b4c8b852767d556e1607028035219b70ab83b4910e95159a930b9c.svg) we get\n\n![](images/ee/eed93a562368727b490c2b63d14f46580dcd0439ac90df23a23f75a31de9e971.svg)\n\nIn other words, when the matrix ![](images/32/3207697e43e4f88223ad85c16964c3103a50c0c999a4ca14417695158d45526b.svg) is applied to an eigenvector ![](images/b2/b2766af4a0fe79e81fbd5ac113f0446ce1d111def401abbf09ced1ee62ca1cf1.svg) the image of ![](images/77/771507e21f2935d77160257f7d56c3f5fcef1d0a114ac8a38c373c49790dd854.svg) is a scaled version of the original vector ![](images/77/771507e21f2935d77160257f7d56c3f5fcef1d0a114ac8a38c373c49790dd854.svg), and the scale factor is ![](images/44/44db815dcaf0a9d405026460a655495e055df7e55a785f542f8920ca90af5418.svg)\n\nTo demonstrate, consider once again the following matrix:\n\n![](images/43/43e76f5a5e889ec18a6893be8cdbf4837d3dedfab149a0981ce6619a62718170.svg)\n\nWe've already seen that ![](images/32/3207697e43e4f88223ad85c16964c3103a50c0c999a4ca14417695158d45526b.svg) has an eigenvector ![](images/fe/fef256ade4f52003da67fac5af68ff4b0d4e7f04ef55e72bb0279bdc8f1e8c3c.svg) with corresponding eigenvalue ![](images/b5/b5cdbd2f286044241daca2565a1ab7f70196ecc2cf6503965d9a820faad9b06e.svg) So we have\n\n![](images/2d/2da94bfdde0e3650ded2622748ead5a4c09cabf610f9d181d48ae158d9bd0986.svg)\n\nPlotting the vector ![](images/77/771507e21f2935d77160257f7d56c3f5fcef1d0a114ac8a38c373c49790dd854.svg) and its image ![](images/ab/abe8027351c1645f4c582440b8b536f48f3ec35d008570f3432f322fa468e861.svg) in the plane, we get the following picture.\n\n![](images/9a/9aca41e0597b0b1698e8ec24da9966fd9b7e5fee3951081d8abdb0cc0caaac7b.png)\n\nIn general, when we apply a matrix ![](images/32/3207697e43e4f88223ad85c16964c3103a50c0c999a4ca14417695158d45526b.svg) to an eigenvector ![](images/b2/b2766af4a0fe79e81fbd5ac113f0446ce1d111def401abbf09ced1ee62ca1cf1.svg) the resulting vector ![](images/be/befecb9d885ee3bbbb7313401ca3671428e4aced68a4bfdb4b2fc9a005ea2b43.svg) always lies on the same line as ![](images/1f/1f3d1a60926323e963d7563529669e5cf8210771c8cbb0379f7a7d90e7c6aeec.svg)\n\nIf ![](images/8c/8c453358dacec49655b560be52a99066e3cab1d34cfbdbdbaa7bd74d868fef82.svg) then the matrix stretches the vector. For ![](images/ea/ea6d742051f82ff2f258e08ed09c3b3dc6d4c7f9bbbe40fea718aec8183dc44f.svg) the matrix compresses the vector. In addition, a negative eigenvalue ![](images/c9/c91cda6703c5767aaafeca807b07e466f160cb0ade84472ade5fa85d71a5713e.svg) means that ![](images/77/771507e21f2935d77160257f7d56c3f5fcef1d0a114ac8a38c373c49790dd854.svg) is flipped in the opposite direction as well as scaled." :tutorial/id #uuid "cdf6ca75-e37b-552a-a106-ee8ac2f36a61" :tutorial/math-academy-id 3963 :tutorial/title "The Geometric Interpretation of Eigenvalues and Eigenvectors"} :step/id #uuid "ab53090e-96b8-5dcc-b77f-6ff038689cac" :step/math-academy-id 23514 :step/next {:db/id #edb/ref 17592186106711}}] :activity/title "The Eigenvalues and Eigenvectors of a 2x2 Matrix" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186106002}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186571482} :activity/id #uuid "29b930e0-d300-5c18-b22e-b6c8fa5110b7" :activity/scope {:db/id #edb/ref 17592186048819 :topic/id #uuid "c29ac9c3-f2c1-572b-9251-f82101c5a30e" :topic/math-academy-id 1375} :activity/steps [{:db/id #edb/ref 17592186571477 :step/content {:db/id #edb/ref 17592186571393 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4537924c-6e29-55ff-b3f8-dc181ec0e42f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186570995} {:answer/id #uuid "b0aecb63-c63a-50f2-a367-8c0bc46f3d0d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "None" :db/id #edb/ref 17592186571164} {:answer/id #uuid "ba493e6d-d0cf-5095-bfa8-8805ceb595dc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186571179} {:answer/id #uuid "bd39d6f9-1a79-5269-bb60-a3705107fe12" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186571183} {:answer/id #uuid "e2c9af5a-45a8-5973-9c44-186d59bb5f68" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186571241}] :answer-field/correct {:db/id #edb/ref 17592186571241} :answer-field/id #uuid "d76769ca-539d-5bea-bc37-7af743caadc7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186571363}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "48224f9c-af15-5271-930c-05fc20cc3fbf" :question/math-academy-id "q-107312" :question/problem "Which of the following statements are true?\n\nI. If $v$ is an eigenvector of an invertible matrix $A$ that corresponds to the eigenvalue $\\lambda =\\frac{1}{3}$ then $v$ is also an eigenvector of the matrix ${A}^{-1}$ that corresponds to $\\lambda =4.$\n\nII. An eigenvector of an invertible matrix $A$ that corresponds to the eigenvalue $\\lambda =-2$ is also an eigenvector of the inverse ${A}^{-1}$ that corresponds to $\\lambda =-\\frac{1}{2}.$\n\nIII. If $v$ is an eigenvector of a matrix $A$ corresponding to the eigenvalue $\\lambda =3,$ then $5v$ is also an eigenvector of $A$ corresponding to $\\lambda =15.$" :question/worked-solution "Remember that the eigenvectors of $A$ are the non-zero vectors $v$ such that $Av=\\lambda v.$ With that in mind, let's examine the statements one by one.\n\n- Statement is false. By the definition of an eigenvector, we have \n\n$$\nAv=\\frac{1}{3}v.\n$$\n\n \nMultiplying it by ${A}^{-1}$ from the left, we obtain \n\n$$\nv=\\frac{1}{3}{A}^{-1}v.\n$$\n\nMultiplying both sides by $3$, we get \n\n$$\n{A}^{-1}v=3v.\n$$\n\n \nSo, $v$ is an eigenvector of ${A}^{-1}$ that corresponds to the eigenvalue $3.$\n\n**Note:** In general, an eigenvector of an invertible matrix $A$ that corresponds to an eigenvalue $\\lambda$ is an eigenvector of ${A}^{-1}$ that corresponds to the eigenvalue $\\frac{1}{\\lambda }.$\n\n- Statement II is true. According to the statement above, an eigenvector of $A$ that corresponds to the eigenvalue $\\lambda =-2$ is an eigenvector of ${A}^{-1}$ that corresponds to $\\lambda =-\\frac{1}{2}.$\n\n- Statement III is false. We have\n\n$$\n\\begin{aligned}A(5v) &=5Av=5(3v)=3(5v).\\end{aligned}\n$$\n\nSince, $A(5v)=3(5v),$ and $5v\\ne 0,$ this implies that $5v$ is an eigenvector of $A$ and the corresponding eigenvalue is $\\lambda =3.$\n\n**Note:** In general, any non-zero multiple of an eigenvector is again an eigenvector, and the corresponding eigenvalue is the same.\n\nTherefore, the correct answer is \"II only.\""} :step/id #uuid "3ceb3caa-5108-55c6-93e3-8d37c4a57f4a"} {:db/id #edb/ref 17592186571482 :step/content {:db/id #edb/ref 17592186287815 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "000e3561-1544-5dc9-8c11-17c48b422a41" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14" :db/id #edb/ref 17592186284787} {:answer/id #uuid "097c3642-1c4d-5f84-8e55-34a351e7fb55" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186284868} {:answer/id #uuid "0cd337c9-0e8e-5c98-801f-ee9718e01ded" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186284893} {:answer/id #uuid "201af8ed-db42-5e03-815b-dbf694b92e78" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186285075} {:answer/id #uuid "fad2ed4b-35b0-525e-8240-933b2bc19e1f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186287077}] :answer-field/correct {:db/id #edb/ref 17592186285075} :answer-field/id #uuid "a631f2f2-9eef-524a-8c00-16323ea7e0c4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186287482}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ac23d8ea-7894-5e1d-9e2b-923ff426fb50" :question/math-academy-id "q-18233" :question/problem "An eigenvector of $D=\\begin{bmatrix}-8 & 10 \\\\ -7 & 11\\end{bmatrix}$ corresponding to an eigenvalue $\\lambda =6$ is  $\\begin{bmatrix}c \\\\ 14\\end{bmatrix}.$ Determine the value of $c.$" :question/worked-solution "Remember that the eigenvectors of $D$ are the non-zero vectors $v$ such that $Dv=\\lambda v.$ So, we have\n\n$$\n\\begin{aligned}Dv & =\\lambda v \\\\ \\begin{bmatrix}-8 & 10 \\\\ -7 & 11\\end{bmatrix}\\begin{bmatrix}c \\\\ 14\\end{bmatrix} & =6\\begin{bmatrix}c \\\\ 14\\end{bmatrix} \\\\ \\begin{bmatrix}-8c+140 \\\\ -7c+154\\end{bmatrix} & =\\begin{bmatrix}6c \\\\ 84\\end{bmatrix}.\\end{aligned}\n$$\n\nThis gives us the following system of linear equations:\n\n$$\n\\left\\{\\begin{aligned}-8c+140 &=6c \\\\ -7c+154 &=84\\end{aligned}\\right.\n$$\n\n- Solving for $c$ in the first equation, we get\n\n$$\n-8c+140=6c\\,⟹\\,c=10.\n$$\n\n- Solving for $c$ in the second equation, we get\n\n$$\n-7c+154=84\\,⟹\\,c=10.\n$$\n\nTherefore, the solution of the system is $c=10.$"} :step/id #uuid "5e138194-7714-5b10-b6fc-e0340f52b114" :step/next {:db/id #edb/ref 17592186571511}} {:db/id #edb/ref 17592186571488 :step/content {:db/id #edb/ref 17592186345124 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09e12ff8-523f-5c8d-a706-ba8422caadff" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/8b/8b688fcd0fd4e0eeee005687fcdc53fe96b671e551a99656df9cb77175f40df1.png" :db/id #edb/ref 17592186342321} {:answer/id #uuid "7af1fddd-ef2d-5429-8bef-94f40a541aa2" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/ba/baab64be7493281733cf8b4b94736d4bb46a43e511b379e939abf0cd3d822510.png" :db/id #edb/ref 17592186343295} {:answer/id #uuid "8a9c7110-2ced-5415-9901-6bf2704afc9e" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/75/75a8012b7823a0256e42a4db5fc40c3ea3a12226bd9989ab3de639c2ee271c98.png" :db/id #edb/ref 17592186343443} {:answer/id #uuid "d565df53-cdd1-579a-9144-4b2cc326733d" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/af/afc3e8503656a84f23c7f58fd05e005ee07200b75ddec1aa5cf247b3484e81b4.png" :db/id #edb/ref 17592186344108} {:answer/id #uuid "e502ad54-3f96-58bf-b350-a65382820455" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/2d/2dcc1cd1e1b93fa8b01e68e1bc102b5f76d83d954cbf0df11ecc7cc8a8e8dafb.png" :db/id #edb/ref 17592186344251}] :answer-field/correct {:db/id #edb/ref 17592186344108} :answer-field/id #uuid "01840463-24e4-5419-b9c4-a0e3ada98130" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186344497}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "87b8923c-30bf-57c2-9051-8311487777e0" :question/math-academy-id "q-75734" :question/problem "![](images/02/0269c9d60a97984f55cefccbd8cf1192dfdb4082935162206b1ce1a3cfb413f7.png)\n\nThe vector $u$ is an eigenvector of a $2\\times 2$ matrix $B$ corresponding to the eigenvalue $-1.$ Find the vector $Bu.$" :question/worked-solution "The eigenvector $u=\\begin{bmatrix}3 \\\\ 1\\end{bmatrix}$ corresponds to the eigenvalue $\\lambda =-1.$ So, \n\n$$\n\\begin{aligned}Bu & =-u.\\end{aligned}\n$$\n\nTherefore, we have the following picture:\n\n![](images/af/afc3e8503656a84f23c7f58fd05e005ee07200b75ddec1aa5cf247b3484e81b4.png)"} :step/id #uuid "7931e841-3cfd-560d-84bf-f26f00e03321" :step/next {:db/id #edb/ref 17592186571513}} {:db/id #edb/ref 17592186571511 :step/content {:db/id #edb/ref 17592186571446 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07eb1dc5-98f3-5daa-91e3-a9e09abb0895" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186570903} {:answer/id #uuid "37563492-e7cf-5fdf-9ea2-b0e40fe05275" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-8" :db/id #edb/ref 17592186570975} {:answer/id #uuid "8be08705-3f7e-5fdb-a167-e4244e9ea1fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186571105} {:answer/id #uuid "e4291a8f-63e2-5130-a4f3-66c8b39bc724" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186571245} {:answer/id #uuid "f462c8dd-3f8b-5230-9dc9-c062aa74de47" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186571259}] :answer-field/correct {:db/id #edb/ref 17592186571105} :answer-field/id #uuid "e3ef38cb-d22b-5c07-9abf-231f5e6be217" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186571367}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e4e6ce71-c74f-5790-9b61-f458926b26f7" :question/math-academy-id "q-18236" :question/problem "The eigenvector of $A=\\begin{bmatrix}-3 & 1 \\\\ 3k+1 & 3\\end{bmatrix}$ corresponding to the eigenvalue $\\lambda =-k$ is  $\\begin{bmatrix}1 \\\\ 5\\end{bmatrix}.$ Determine the value of $k.$" :question/worked-solution "Remember that the eigenvectors of $A$ are the non-zero vectors $v$ such that $Av=\\lambda v.$ So, we have\n\n$$\n\\begin{aligned}Av & =\\lambda v \\\\ \\begin{bmatrix}-3 & 1 \\\\ 3k+1 & 3\\end{bmatrix}\\begin{bmatrix}1 \\\\ 5\\end{bmatrix} & =-k\\begin{bmatrix}1 \\\\ 5\\end{bmatrix} \\\\ \\begin{bmatrix}2 \\\\ 3k+16\\end{bmatrix} & =\\begin{bmatrix}-k \\\\ -5k\\end{bmatrix}.\\end{aligned}\n$$\n\nThis gives us the following system of linear equations:\n\n$$\n\\left\\{\\begin{aligned}2 &=-k, \\\\ 3k+16 &=-5k\\end{aligned}\\right.\n$$\n\nSolving for $k$ in the first equation, we get\n\n$$\n2=-k\\,⟹\\,k=-2.\n$$\n\nNow, substituting $k=-2$ into the second equation, we get\n\n$$\n\\begin{aligned}3k+16 & =-5k \\\\ 3\\cdot (-2)+16 & =-5\\cdot (-2) \\\\ 10 & =10,\\end{aligned}\n$$\n\nwhich is a true statement.\n\nTherefore, the solution of the system is $k=-2.$"} :step/id #uuid "e4278250-85d4-5e96-add4-c7d4c1187239" :step/next {:db/id #edb/ref 17592186571488}} {:db/id #edb/ref 17592186571513 :step/content {:db/id #edb/ref 17592186369010 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bd32804e-3923-5318-97f1-01f3adefac2b" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/f1/f1e1b3eba7086332888fecf1c92642450a66c092b85a27b6284a482313e55394.png" :db/id #edb/ref 17592186369012} {:answer/id #uuid "dfb6e91e-a3a5-5044-85bc-a35206a19811" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/7a/7a8d68549189fdeadfa6d12a668dd69e5fa545d33e992dcbd2c92fa44633959a.png" :db/id #edb/ref 17592186369013} {:answer/id #uuid "6de2baed-9e4a-5469-960d-0bd3b9f42f48" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/91/91d45713ecd57f376825f82a34efb2dcf7cede21a4085c46339193b26d86979d.png" :db/id #edb/ref 17592186369014} {:answer/id #uuid "eab22fda-9bb0-5ef0-9596-2ce1b90143fa" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/90/9056e7d00d0fd892f2281b534a59598db355cfd8caf9d239c552e609783091c8.png" :db/id #edb/ref 17592186369015} {:answer/id #uuid "dd2e4b1a-8072-5c8f-a594-1b08e4a5431f" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/bb/bb31aef8625f25f0048bb1f15f8c8fb75483e9d5fb5167b96398bcb4e25445d9.png" :db/id #edb/ref 17592186369016}] :answer-field/correct {:db/id #edb/ref 17592186369015} :answer-field/id #uuid "2c18d877-b27b-546c-82e0-2263feeac823" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186369011}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2619eb87-a4d6-584a-ac06-7c0d135f7808" :question/math-academy-id "q-106876" :question/problem "![](images/95/952f35d03c8554f2feaeb50296df9ac426a49730a44038bf6f9cf47b1fa3f9ee.png)\n\nThe vector $v$ is an eigenvector of a $2\\times 2$ matrix $A$ corresponding to the eigenvalue $\\frac{5}{2}.$ Find the vector $Av.$" :question/worked-solution "The eigenvector $v=\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}$ corresponds to the eigenvalue $\\lambda =\\frac{5}{2}.$ So, \n\n$$\n\\begin{aligned}Av & =\\frac{5}{2}v.\\end{aligned}\n$$\n\nTherefore, we have the following picture:\n\n![](images/cb/cb3fae2e42e90e7e8398c311fd9c4d20ac1db51687a7d4f3f77146eb53728de5.png)"} :step/id #uuid "f02310af-9ad3-5d7c-90ac-a5a1f4308abf" :step/next {:db/id #edb/ref 17592186571477}}] :activity/title "The Eigenvalues and Eigenvectors of a 2x2 Matrix" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186570881}]}
