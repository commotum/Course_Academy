839b-6f9f1f5f5711" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-4,\\pm 1)" :db/id #edb/ref 17592186542808} {:answer/id #uuid "8244ce39-770f-5afd-9030-ccc12deef001" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-4,\\pm 2)" :db/id #edb/ref 17592186542987} {:answer/id #uuid "e0c259f5-c5fe-5a6c-bfb5-ec83693ad8ca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-4,\\pm 16)" :db/id #edb/ref 17592186543213} {:answer/id #uuid "e449e3da-c482-5c69-a8f3-b4a2dec38e47" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-4,\\pm 3)" :db/id #edb/ref 17592186543218}] :answer-field/correct {:db/id #edb/ref 17592186542720} :answer-field/id #uuid "a1ef507b-8129-5dce-a6ec-07aaa47a4a1f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186543406}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1a906e6f-23fd-5f8d-83eb-286b57e0e8a7" :question/math-academy-id "q-10494" :question/problem "Calculate the points where the hyperbola\n$\\frac{{y}^{2}}{8}-\\frac{{x}^{2}}{16}=1$\nintersects the line $x=-4.$" :question/worked-solution "To find the points where the hyperbola intersects the line $x=-4,$ we substitute $x=-4$ into the equation of the hyperbola and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}\\frac{{y}^{2}}{8}-\\frac{{x}^{2}}{16} & =1 \\\\ \\frac{{y}^{2}}{8}-\\frac{(-4)^{2}}{16} & =1 \\\\ \\frac{{y}^{2}}{8}-1 & =1 \\\\ \\frac{{y}^{2}}{8} & =1+1 \\\\ \\frac{{y}^{2}}{8} & =2 \\\\ {y}^{2} & =16 \\\\ y & =\\pm 4\\end{aligned}\n$$\n\nTherefore, the hyperbola intersects the vertical line  $x=-4$ at the points $(-4,\\pm 4).$"} :step/id #uuid "122f40a7-b142-5437-98a6-419c453df10e" :step/next {:db/id #edb/ref 17592186543649}} {:db/id #edb/ref 17592186543631 :step/content {:db/id #edb/ref 17592186295000 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "171b9f4c-ba23-5171-940d-3e96e126108c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186293021}] :answer-field/correct {:db/id #edb/ref 17592186293021} :answer-field/id #uuid "108bd8a9-3be5-5cb0-8581-e0814486c7fc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186293974} {:answer-field/choices [{:answer/id #uuid "a6eda28e-021c-56d4-b9d2-b5d42ea9c8aa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186293591}] :answer-field/correct {:db/id #edb/ref 17592186293591} :answer-field/id #uuid "4a0c7c6c-38ce-5696-a418-9dd0534bcfb1" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186294192}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c8f9741f-55e8-540b-9683-1ea533e2d292" :question/math-academy-id "q-278383" :question/problem "In **ascending order,** the $x$-coordinates of the points where the hyperbola $14{x}^{2}-5{y}^{2}=64$ intersects the line $y=\\sqrt{2}x$ are\n\n$\\,x=$\n{{field-1}}$\\,$ and $\\,x=$\n{{field-2}}." :question/worked-solution "To find the points where the hyperbola intersects the line $y=\\sqrt{2}x,$ we first replace $y$ with $\\sqrt{2}x$ in the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}14{x}^{2}-5{y}^{2} & =64 \\\\ 14{x}^{2}-5(\\sqrt{2}x)^{2} & =64 \\\\ 14{x}^{2}-5(2{x}^{2}) & =64 \\\\ 14{x}^{2}-10{x}^{2} & =64 \\\\ 4{x}^{2} & =64 \\\\ {x}^{2} & =16 \\\\ x & =\\pm 4\\end{aligned}\n$$\n\nSo, in ascending order, the $x$-coordinates of the points of intersection are\n$x=-4$ and $x=4.$"} :step/id #uuid "527721bd-8b12-53d7-a82e-7f1f746bc04c"} {:db/id #edb/ref 17592186543633 :step/content {:db/id #edb/ref 17592186348325 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1286ade9-0d9c-55b3-a188-2ef7abe62ae0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-4,\\pm 4)" :db/id #edb/ref 17592186345511} {:answer/id #uuid "70713768-2993-552f-b235-524f06674f79" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-4,\\pm 3)" :db/id #edb/ref 17592186346336} {:answer/id #uuid "72977c36-4164-5f02-a1ec-1b788b3b3caa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-4,\\pm \\sqrt{12})" :db/id #edb/ref 17592186346368} {:answer/id #uuid "89e86036-bfeb-5b00-bf35-e125171095a9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-4,\\pm 2)" :db/id #edb/ref 17592186346549} {:answer/id #uuid "8f8b3556-c634-5b94-b39e-1bc624a55e86" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-4,\\pm 1)" :db/id #edb/ref 17592186346598}] :answer-field/correct {:db/id #edb/ref 17592186346549} :answer-field/id #uuid "0dcd5295-b6a1-5054-8563-2a8b5b5da306" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186347632}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ce114744-a24e-5cfc-a63d-8c05e070564b" :question/math-academy-id "q-8006" :question/problem "Calculate the points where the hyperbola ${x}^{2}-{y}^{2}=12$ intersects the line $x=-4.$" :question/worked-solution "To find the points where the hyperbola intersects the line $x=-4,$ we substitute $x=-4$ into the equation of the hyperbola and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}{x}^{2}-{y}^{2} & =12 \\\\ (-4)^{2}-{y}^{2} & =12 \\\\ 16-{y}^{2} & =12 \\\\ -{y}^{2} & =12-16 \\\\ -{y}^{2} & =-4 \\\\ {y}^{2} & =4 \\\\ y & =\\pm 2\\end{aligned}\n$$\n\nTherefore, the hyperbola intersects the vertical line $x=-4$  at the points $(-4,\\pm 2).$"} :step/id #uuid "556a951d-92d7-5dde-ba03-04865781693d" :step/next {:db/id #edb/ref 17592186543603}} {:db/id #edb/ref 17592186543638 :step/content {:db/id #edb/ref 17592186372481 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "98c863f7-b438-5664-a947-3dcaceb9a809" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5" :db/id #edb/ref 17592186372483}] :answer-field/correct {:db/id #edb/ref 17592186372483} :answer-field/id #uuid "af462b30-53a5-5a99-9bb3-7dbaed8a8b52" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186372482} {:answer-field/choices [{:answer/id #uuid "7df0eebe-5d75-5c49-98be-815bfb23f53a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186372485}] :answer-field/correct {:db/id #edb/ref 17592186372485} :answer-field/id #uuid "564d7c00-a2a3-5426-ab6c-2f25bc43608b" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186372484}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "40ee8abc-a370-5f9e-aca7-98eb85a4280e" :question/math-academy-id "q-277806" :question/problem "In **ascending order,** the $x$-coordinates of the points where the hyperbola $2{y}^{2}-25{x}^{2}=625$ intersects the line $y=-5x$ are\n\n$\\,x=$\n{{field-1}}$\\,$ and $\\,x=$\n{{field-2}}." :question/worked-solution "To find the points where the hyperbola intersects the line $y=-5x,$ we first replace $y$ with $-5x$ in the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}2{y}^{2}-25{x}^{2} & =625 \\\\ 2(-5x)^{2}-25{x}^{2} & =625 \\\\ 2(25{x}^{2})-25{x}^{2} & =625 \\\\ 50{x}^{2}-25{x}^{2} & =625 \\\\ 25{x}^{2} & =625 \\\\ {x}^{2} & =25 \\\\ x & =\\pm 5\\end{aligned}\n$$\n\nSo, in ascending order, the $x$-coordinates of the points of intersection are\n$x=-5$ and $x=5.$"} :step/id #uuid "6259f0d7-87ca-54f9-be7f-4bc7e3d6e4ee" :step/next {:db/id #edb/ref 17592186543631}} {:db/id #edb/ref 17592186543649 :step/content {:db/id #edb/ref 17592186354287 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0357b877-3685-5b74-84b9-785bd6624ec4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,\\pm 2)" :db/id #edb/ref 17592186351597} {:answer/id #uuid "346a5f40-655b-5283-a744-3a7d78f3baf2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,0)" :db/id #edb/ref 17592186352057} {:answer/id #uuid "5d254b9d-4764-50ea-a18b-6414d330aa4a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(0,-10)$ and $(0,0)$" :db/id #edb/ref 17592186352390} {:answer/id #uuid "96a5dedf-d33b-5855-afbf-2a12809e8278" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,\\pm 10)" :db/id #edb/ref 17592186352871} {:answer/id #uuid "e26cc505-8f11-5648-b0c1-d1d9b4952c45" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(0,0)$ and $(0,10)$" :db/id #edb/ref 17592186353534}] :answer-field/correct {:db/id #edb/ref 17592186352390} :answer-field/id #uuid "d670a4ad-c750-5c7c-9a1d-df1a493eb3e2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186354180}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1129953c-1746-583e-b3b7-c3a8d0e441f7" :question/math-academy-id "q-84060" :question/problem "Calculate the $y$-intercepts of the hyperbola $\\frac{(y+5)^{2}}{5}-(x-2)^{2}=1.$" :question/worked-solution "To find the $y$-intercepts of the hyperbola, we substitute $x=0$ into the equation of the hyperbola and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}\\frac{(y+5)^{2}}{5}-(x-2)^{2} & =1 \\\\ \\frac{(y+5)^{2}}{5}-(0-2)^{2} & =1 \\\\ \\frac{(y+5)^{2}}{5}-4 & =1 \\\\ \\frac{(y+5)^{2}}{5} & =5 \\\\ (y+5)^{2} & =25 \\\\ y+5 & =\\pm 5 \\\\ y & =-10,0\\end{aligned}\n$$\n\nTherefore, the $y$-intercepts are $(0,-10)$ and $(0,0).$"} :step/id #uuid "9e2bec4e-7f67-59b0-a0fd-fb028eb622db" :step/next {:db/id #edb/ref 17592186543638}}] :activity/title "Finding Intercepts and Intersections of Hyperbolas" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186542614}]}
