#{[{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186088752} :activity/id #uuid "32fc74f9-ca5f-5f57-a626-d4e31a145f67" :activity/scope {:db/id #edb/ref 17592186051028 :topic/id #uuid "7b7dc93e-4cab-570c-b330-4cc489161751" :topic/math-academy-id 874} :activity/steps [{:db/id #edb/ref 17592186088752 :step/content {:db/id #edb/ref 17592186088967 :tutorial/content "The figure below shows the hyperbola $\\dfrac{x^2}{9} - \\dfrac{y^2}{25} = 1.$ We can see that this hyperbola intersects the $x$-axis at two points. How do we find the coordinates of these points?\n\n![](images/a3/a3f664f7e1916ca550c33060d78ad26e33aa9eb78ba32a44d46d7aa109ed4c2a.png)\n\nTo find the coordinates of the $x$-intercepts of a hyperbola, we substitute $y=0$ into the equation of the hyperbola and solve the resulting equation for $x{:}$\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{9}-\\frac{{0}^{2}}{25} & =1 \\\\ \\frac{{x}^{2}}{9} & =1 \\\\ {x}^{2} & =9 \\\\ x & =\\pm 3\\end{aligned}\n$$\n\nTherefore, the $x$-intercepts are $(-3,0)$ and $(3,0).$" :tutorial/id #uuid "af9cbb7e-1a39-5ea6-9000-606a1e7bfa33" :tutorial/math-academy-id 4585 :tutorial/title "Introduction"} :step/id #uuid "5524464b-6a66-5f98-893e-48ac0fedd44a" :step/math-academy-id 464451 :step/next {:db/id #edb/ref 17592186088753}} {:db/id #edb/ref 17592186088753 :step/content {:db/id #edb/ref 17592186087835 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087552 :question/id #uuid "03bb8d2d-55c5-5511-94c5-73e73db9ccf8" :question/math-academy-id "e-5361"} :knowledge-point/id #uuid "2de185a6-24a0-55aa-905d-8893a555e331" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048963} {:db/id #edb/ref 17592186049394}] :knowledge-point/questions [{:db/id #edb/ref 17592186088378} {:db/id #edb/ref 17592186088424} {:db/id #edb/ref 17592186284651} {:db/id #edb/ref 17592186284652} {:db/id #edb/ref 17592186294916} {:db/id #edb/ref 17592186294984} {:db/id #edb/ref 17592186294985} {:db/id #edb/ref 17592186294986} {:db/id #edb/ref 17592186348322} {:db/id #edb/ref 17592186348323} {:db/id #edb/ref 17592186354280} {:db/id #edb/ref 17592186354281} {:db/id #edb/ref 17592186372494} {:db/id #edb/ref 17592186372503} {:db/id #edb/ref 17592186372512} {:db/id #edb/ref 17592186373346} {:db/id #edb/ref 17592186506536}] :knowledge-point/title "Finding the X-Intercepts of a Hyperbola"} :step/id #uuid "b342a9b4-8a39-5d74-9943-f197d4b9d913" :step/math-academy-id 464452 :step/next {:db/id #edb/ref 17592186088754}} {:db/id #edb/ref 17592186088754 :step/content {:db/id #edb/ref 17592186087836 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087625 :question/id #uuid "bb09b5f0-832f-5008-970c-87c6dfaf076f" :question/math-academy-id "e-7424"} :knowledge-point/id #uuid "c249cf3a-7864-5132-80fa-c18a3ea915c2" :knowledge-point/questions [{:db/id #edb/ref 17592186087977} {:db/id #edb/ref 17592186088425} {:db/id #edb/ref 17592186240945} {:db/id #edb/ref 17592186294917} {:db/id #edb/ref 17592186294987} {:db/id #edb/ref 17592186294988} {:db/id #edb/ref 17592186294989} {:db/id #edb/ref 17592186294990} {:db/id #edb/ref 17592186294991} {:db/id #edb/ref 17592186354283} {:db/id #edb/ref 17592186354284} {:db/id #edb/ref 17592186354286} {:db/id #edb/ref 17592186354287} {:db/id #edb/ref 17592186372363} {:db/id #edb/ref 17592186373353} {:db/id #edb/ref 17592186404294} {:db/id #edb/ref 17592186404301} {:db/id #edb/ref 17592186506566}] :knowledge-point/title "Finding the Y-Intercepts of a Hyperbola"} :step/id #uuid "a3621b99-6383-5d05-94f4-a6d42a2480a3" :step/math-academy-id 464455 :step/next {:db/id #edb/ref 17592186088755}} {:db/id #edb/ref 17592186088755 :step/content {:db/id #edb/ref 17592186088924 :tutorial/content "Let's now consider the hyperbola $\\dfrac {x^2}{9} - \\dfrac {y ^2}{3} = 1$ and the line $x = 6.$ The hyperbola and the line intersect at the points $A$ and $B,$ as shown in the diagram below.\n\n![](images/fa/fade29777e50e807aabb1f26f129669ae8b999235efb6c9bf72f11dcbfbb0a2e.png)\n\nTo find the points where the hyperbola intersects the line, we substitute the equation of the line, $x=6,$ into the equation of the hyperbola and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{9}-\\frac{{y}^{2}}{3} & =1 \\\\ \\frac{{6}^{2}}{9}-\\frac{{y}^{2}}{3} & =1 \\\\ \\frac{36}{9}-\\frac{{y}^{2}}{3} & =1 \\\\ 4-\\frac{{y}^{2}}{3} & =1 \\\\ \\frac{{y}^{2}}{3} & =4-1 \\\\ \\frac{{y}^{2}}{3} & =3 \\\\ {y}^{2} & =9 \\\\ y & =\\pm 3\\end{aligned}\n$$\n\nTherefore, the hyperbola intersects the line $x=6$ at the points $\\left(6, \\pm3\\right).$" :tutorial/id #uuid "d604b388-ae8e-5c3d-8061-34c0ded1ecc9" :tutorial/math-academy-id 3495 :tutorial/title "Finding Intersections of Hyperbolas and Lines"} :step/id #uuid "ff447adf-216a-5a29-bd4e-7b5990174906" :step/math-academy-id 464458 :step/next {:db/id #edb/ref 17592186088756}} {:db/id #edb/ref 17592186088756 :step/content {:db/id #edb/ref 17592186087837 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087553 :question/id #uuid "b3eac4e2-5e85-5669-8dfb-c7fe4e5a47ae" :question/math-academy-id "e-5362"} :knowledge-point/id #uuid "395f435d-473f-5dae-b215-2986556d5793" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050984}] :knowledge-point/questions [{:db/id #edb/ref 17592186088049} {:db/id #edb/ref 17592186088379} {:db/id #edb/ref 17592186240967} {:db/id #edb/ref 17592186294992} {:db/id #edb/ref 17592186294993} {:db/id #edb/ref 17592186294994} {:db/id #edb/ref 17592186295001} {:db/id #edb/ref 17592186295002} {:db/id #edb/ref 17592186295003} {:db/id #edb/ref 17592186295005} {:db/id #edb/ref 17592186348325} {:db/id #edb/ref 17592186348326} {:db/id #edb/ref 17592186348329} {:db/id #edb/ref 17592186372370} {:db/id #edb/ref 17592186372472} {:db/id #edb/ref 17592186543480}] :knowledge-point/title "Finding the Points of Intersection of a Hyperbola and a Horizontal or Vertical Line"} :step/id #uuid "a34871c6-28d9-5cf8-8450-ec6fa81fe40e" :step/math-academy-id 464459 :step/next {:db/id #edb/ref 1759