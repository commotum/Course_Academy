5417] [17592186240523 #edb/ref 1078 #edb/ref 17592186240171 #edb/ref 17592186045417] [17592186240523 #edb/ref 1079 #uuid "68b90f24-4567-517f-8de2-11b101a1752a" #edb/ref 17592186045417] [17592186240637 #edb/ref 1075 #edb/ref 17592186238106 #edb/ref 17592186045417] [17592186240637 #edb/ref 1075 #edb/ref 17592186238466 #edb/ref 17592186045417] [17592186240637 #edb/ref 1075 #edb/ref 17592186238573 #edb/ref 17592186045417] [17592186240637 #edb/ref 1075 #edb/ref 17592186238786 #edb/ref 17592186045417] [17592186240637 #edb/ref 1075 #edb/ref 17592186239129 #edb/ref 17592186045417] [17592186240637 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186240637 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186240637 #edb/ref 1078 #edb/ref 17592186238786 #edb/ref 17592186045417] [17592186240637 #edb/ref 1079 #uuid "ad81c796-cc4e-569c-a65f-97300b90db16" #edb/ref 17592186045417] [17592186241002 #edb/ref 1068 #edb/ref 17592186240521 #edb/ref 17592186045417] [17592186241002 #edb/ref 1069 "q-105185" #edb/ref 17592186045417] [17592186241002 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186241002 #edb/ref 1071 "Which of the following sets are closed?\n\nI. $[4,8]\\cup [10,12]$\n\nII. $[0,5)$\n\nIII. $[1,3)\\cup (3,7]$" #edb/ref 17592186045417] [17592186241002 #edb/ref 1072 #uuid "1b64d31c-86a0-5b85-a7b4-c7e3f17987a9" #edb/ref 17592186045417] [17592186241002 #edb/ref 1074 "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nAmong the given sets, only $[4,8]\\cup [10,12]$ is closed. It consists of two parts, where the boundary points are $4,8,10,$ and $12.$ All of them lie in the set.\n\nThe other sets are not closed because:\n\n- $[0,5)$ has a boundary point $5