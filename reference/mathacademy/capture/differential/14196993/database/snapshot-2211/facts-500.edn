417] [17592186511418 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186511418 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186511418 #edb/ref 1078 #edb/ref 17592186511183 #edb/ref 17592186045417] [17592186511418 #edb/ref 1079 #uuid "c4360e51-0f64-590c-bba8-917045fffada" #edb/ref 17592186045417] [17592186511512 #edb/ref 1068 #edb/ref 17592186511418 #edb/ref 17592186045417] [17592186511512 #edb/ref 1069 "q-140961" #edb/ref 17592186045417] [17592186511512 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186511512 #edb/ref 1071 "$$\nA=[\\begin{aligned}2 & 1 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}],\\,Σ=[\\begin{aligned}\\sqrt{6} & 0 \\\\ 0 & 1 \\\\ 0 & 0\\end{aligned}]\n$$\n\nConsider the matrices $A$ and $Σ$ shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ which of the following could be the matrix $V?$" #edb/ref 17592186045417] [17592186511512 #edb/ref 1072 #uuid "79df1f11-1c43-51b8-8e99-4f8efb003972" #edb/ref 17592186045417] [17592186511512 #edb/ref 1074 "Recall that if  $A=UΣ{V}^{T}$ is a singular value decomposition of a $3\\times 2$ matrix $A,$ then\n\n- $Σ$ is a $3\\times 2$ matrix with nonnegative elements on the main diagonal and zeroes outside the main diagonal,\n\n- $U$ is an orthogonal $3\\times 3$ matrix,\n\n- $V$ is an orthogonal $2\\times 2$ matrix.\n\nLet's find the singular value decomposition of $A$ using the usual algorithm.\n\n- **Step 1.** Compute ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={[\\begin{aligned}2 & 1 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]}^{T}[\\begin{aligned}2 & 1 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 1 & 0 \\\\ 1 & 0 & 1\\end{aligned}][\\begin{aligned}2 & 1 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}5 & 2 \\\\ 2 & 2\\end{aligned}]\\end{aligned}\n$$\n\n- **Step 2.** Find the singular values: From the matrix $Σ,$ we deduce that ${\\sigma }_{1}=\\sqrt{6}$ and ${\\sigma }_{2}=1.$\n\n- **Step 3.** Find the right singular vectors of $A$ (i.e., the unit eigenvectors of ${A}^{T}\\,A$):\n\n- For ${\\lambda }_{1}={\\sigma }_{1}^{2}=6,$ we have\n\n$$\n\\begin{aligned}{A}^{T}\\,A-6I & =[\\begin{aligned}5 & 2 \\\\ 2 & 2\\end{aligned}]-6[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}-1 & 2 \\\\ 2 & -4\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $({A}^{T}\\,A-6I)v=0$ gives the unit eigenvector\n\n$$\n{v}_{1}=[\\begin{aligned}\\frac{2}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}}\\end{aligned}].\n$$\n\n- For ${\\lambda }_{2}={\\sigma }_{2}^{2}=1,$ we have\n\n$$\n\\begin{aligned}{A}^{T}\\,A-1I & =[\\begin{aligned}5 & 2 \\\\ 2 & 2\\end{aligned}]-[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}4 & 2 \\\\ 2 & 1\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $({A}^{T}\\,A-1I)v=0$ gives the unit eigenvector\n\n$$\n{v}_{2}=[\\begin{aligned}-\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{aligned}].\n$$\n\nFinally, we construct the matrix $V:$\n\n$$\nV=[\\begin{aligned}\\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}}\\end{aligned}]\n$$" #edb/ref 17592186045417] [17592186511603 #edb/ref 1062 #uuid "2ae9fbe8-190e-52f6-9c10-192410ac4065" #edb/ref 17592186045417] [17592186511603 #edb/ref 1063 #edb/ref 17592186370654 #edb/ref 17592186045417] [17592186511611 #edb/ref 1058 #edb/ref 17592186511603 #edb/ref 17592186045417] [17592186511611 #edb/ref 1062 #uuid "392eb1aa-9b69-5309-8d5f-16ee0b5603a3" #edb/ref 17592186045417] [17592186511611 #edb/ref 1063 #edb/ref 17592186511512 #edb/ref 17592186045417] [17592186511613 #edb/ref 1058 #edb/ref 17592186511652 #edb/ref 17592186045417] [17592186511613 #edb/ref 1062 #uuid "3be28e76-1c88-5275-b4a3-f54e97e30cfd" #edb/ref 17592186045417] [17592186511613 #edb/ref 1063 #edb/ref 17592186443406 #edb/ref 17592186045417] [17592186511652 #edb/ref 1058 #edb/ref 17592186511611 #edb/ref 17592186045417] [17592186511652 #edb/ref 1062 #uuid "ada826