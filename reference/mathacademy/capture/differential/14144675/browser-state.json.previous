e mathcolor=\"blue\"><mtext>A2</mtext></mstyle></mrow></mrow><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mo stretchy=\"false\">]</mo></mtd></mtr><mtr><mtd><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">w</mi></mrow><mo>+</mo><mrow data-mjx-texclass=\"ORD\"><mn mathvariant=\"bold\">0</mn></mrow></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">x</mi></mrow></mtd><mtd></mtd><mtd><mi></mi><mo stretchy=\"false\">[</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mtext>axiom A4</mtext><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mo stretchy=\"false\">]</mo></mtd></mtr><mtr><mtd><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">w</mi></mrow></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">x</mi></mrow></mtd><mtd></mtd><mtd><mi></mi><mo stretchy=\"false\">[</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mrow><mtext>axiom&nbsp;</mtext><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"blue\"><mtext>A3</mtext></mstyle></mrow></mrow><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mo stretchy=\"false\">]</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
