5417] [17592186382552 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186382552 #edb/ref 1071 "Consider the following matrices:\n\n$$\nA=[\\begin{aligned}-3 & 1 & 4 \\\\ 2 & -4 & -2 \\\\ 3 & -3 & -2\\end{aligned}],\\,D=[\\begin{aligned}-8 & 0 & 0 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & 1\\end{aligned}],\\,P=[\\begin{aligned}-1 & a & 1 \\\\ 1 & b & 0 \\\\ 1 & 0 & 1\\end{aligned}]\n$$\n\nGiven that $A=PD{P}^{-1},$ find the value of $a-b.$" #edb/ref 17592186045417] [17592186382552 #edb/ref 1072 #uuid "4a6d9730-0724-557b-bd0c-58990ff98311" #edb/ref 17592186045417] [17592186382552 #edb/ref 1074 "From the diagonal matrix $D$, we deduce that the eigenvalues of $A$ are \n\n$\\,$ ${\\lambda }_{1}=-8,\\,$ ${\\lambda }_{2}=-2,\\,$ ${\\lambda }_{3}=1.$\n\nSo, the second column of $P$ corresponds to the eigenvalue ${\\lambda }_{2}=-2.$\n\nNow, we need to find an eigenvector that corresponds to ${\\lambda }_{2}=-2.$ Computing $A-(-2)I,$ we get\n\n$$\n\\begin{aligned}A+2I & =[\\begin{aligned}-3 & 1 & 4 \\\\ 2 & -4 & -2 \\\\ 3 & -3 & -2\\end{aligned}]+2[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & 1 & 4 \\\\ 2 & -2 & -2 \\\\ 3 & -3 & 0\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M$ that we reduce to row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}-1 & 1 & 4 \\\\ 2 & -2 & -2 \\\\ 3 & -3 & 0\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+2{R}_{1} \\\\ {R}_{3}:={R}_{3}+3{R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}-1 & 1 & 4 \\\\ 0 & 0 & 6 \\\\ 0 & 0 & 12\\end{aligned}] &  & \\begin{aligned}{R}_{3}:={R}_{3}+(-2){R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}-1 & 1 & 4 \\\\ 0 & 0 & 6 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe reduced matrix above has two pivot columns ($1$st and $3$rd). Thus, ${x}_{2}$ is a free variable. From the second equation, we obtain ${x}_{3}=0.$ Substituting this into the first equation, we get ${x}_{1}={x}_{2}.$\nHence, the general solution is\n\n$$\n[\\begin{aligned}{x}_{2} \\\\ {x}_{2} \\\\ 0\\end{aligned}],\\,{x}_{2}\\in R.\n$$\n\nTherefore, setting ${x}_{2}=1,$ we get the eigenvector \n\n$$\n{v}_{2}=[\\begin{aligned}a \\\\ b \\\\ 0\\end{aligned}]=[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}].\n$$\n\nFinally, $a-b=1-1=0.$" #edb/ref 17592186045417] [17592186382553 #edb/ref 1075 #edb/ref 17592186382554 #edb/ref 17592186045417] [17592186382553 #edb/ref 1075 #edb/ref 17592186382555 #edb/ref 17592186045417] [17592186382553 #edb/ref 1075 #edb/ref 17592186382556 #edb/ref 17592186045417] [17592186382553 #edb/ref 1075 #edb/ref 17592186382557 #edb/ref 17592186045417] [17592186382553 #edb/ref 1075 #edb/ref 17592186382558 #edb/ref 17592186045417] [17592186382553 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186382553 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186382553 #edb/ref 1078 #edb/ref 17592186382558 #edb/ref 17592186045417] [17592186382553 #edb/ref 1079 #uuid "db6e6cfe-224b-582d-a339-40b97c0e9678" #edb/ref 17592186045417] [17592186382554 #edb/ref 1080 "2" #edb/ref 17592186045417] [17592186382554 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186382554 #edb/ref 1083 #uuid "f6f6a680-345d-5a5b-99e4-e6fe2833a541" #edb/ref 17592186045417] [17592186382555 #edb/ref 1080 "1" #edb/ref 17592186045417] [17592186382555 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186382555 #edb/ref 1083 #uuid "2301fa40-f8b0-5fd4-bead-c2e76b13105b" #edb/ref 17592186045417] [17592186382556 #edb/ref 1080 "-3" #edb/ref 17592186045417] [17592186382556 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186382556 #edb/ref 1083 #uuid "e9d79bb0-e5bb-501a-99df-c84429ac1d43" #edb/ref 17592186045417] [17592186382557 #edb/ref 1080 "4" #edb/ref 17592186045417] [17592186382557 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186382557 #edb/ref 1