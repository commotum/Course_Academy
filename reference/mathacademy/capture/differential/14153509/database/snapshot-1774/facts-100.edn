egin{aligned}1 & 0 & 0 \\\\ 0 & -1 & 0 \\\\ 0 & 0 & 2\\end{aligned}],\\,P=[\\begin{aligned}2 & 0 & 1 \\\\ 1 & 1 & 2 \\\\ 1 & 0 & 0\\end{aligned}]\n$$" #edb/ref 17592186045417] [17592186404281 #edb/ref 1075 #edb/ref 17592186404282 #edb/ref 17592186045417] [17592186404281 #edb/ref 1075 #edb/ref 17592186404283 #edb/ref 17592186045417] [17592186404281 #edb/ref 1075 #edb/ref 17592186404284 #edb/ref 17592186045417] [17592186404281 #edb/ref 1075 #edb/ref 17592186404285 #edb/ref 17592186045417] [17592186404281 #edb/ref 1075 #edb/ref 17592186404286 #edb/ref 17592186045417] [17592186404281 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186404281 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186404281 #edb/ref 1078 #edb/ref 17592186404284 #edb/ref 17592186045417] [17592186404281 #edb/ref 1079 #uuid "e147ba3d-c970-55a9-ac96-8187378e9cae" #edb/ref 17592186045417] [17592186404282 #edb/ref 1080 "$D=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & -1 & 0 \\\\ 0 & 0 & 2\\end{aligned}]$ and $P=[\\begin{aligned}2 & 1 & 1 \\\\ 1 & 2 & 2 \\\\ 1 & 3 & 0\\end{aligned}]$" #edb/ref 17592186045417] [17592186404282 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186404282 #edb/ref 1083 #uuid "91c8360c-3a50-5dde-b1bc-982c3982cc9e" #edb/ref 17592186045417] [17592186404283 #edb/ref 1080 "$D=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & -1 & 0 \\\\ 0 & 0 & 2\\end{aligned}]$ and $P=[\\begin{aligned}1 & 0 & 1 \\\\ 1 & -1 & 2 \\\\ 1 & 1 & 0\\end{aligned}]$" #edb/ref 17592186045417] [17592186404283 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186404283 #edb/ref 1083 #uuid "f6699882-8461-5d24-9c25-bf00717bab1d" #edb/ref 17592186045417] [17592186404284 #edb/ref 1080 "$D=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & -1 & 0 \\\\ 0 & 0 & 2\\end{aligned}]$ and $P=[\\begin{aligned}2 & 0 & 1 \\\\ 1 & 1 & 2 \\\\ 1 & 0 & 0\\end{aligned}]$" #edb/ref 17592186045417] [17592186404284 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186404284 #edb/ref