#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186550034} :activity/id #uuid "f063dc42-6d1b-5e1c-9569-9f74dc807d8e" :activity/scope {:db/id #edb/ref 17592186048550 :topic/id #uuid "a9165535-d837-58b0-9784-39a400db9d86" :topic/math-academy-id 5869} :activity/steps [{:db/id #edb/ref 17592186550025 :step/content {:db/id #edb/ref 17592186549991 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5431fd3a-c958-5840-b6fc-bd80d1d983c6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}-2 \\\\ 4 \\\\ 9\\end{aligned}]" :db/id #edb/ref 17592186549487} {:answer/id #uuid "ab469b17-e684-57f3-a032-921d53d60e0b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}0 & -2 \\\\ 0 & 4 \\\\ 0 & 9\\end{aligned}]" :db/id #edb/ref 17592186549637} {:answer/id #uuid "d75faa5d-b436-5bf2-80c6-7dd3b873f64d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}-1 & 6 \\\\ 2 & 2 \\\\ 3 & -1\\end{aligned}]" :db/id #edb/ref 17592186549715} {:answer/id #uuid "f3189ab9-689f-5420-a82c-7c912aa81e2d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}-2 & 0 \\\\ 4 & 0 \\\\ 9 & 0\\end{aligned}]" :db/id #edb/ref 17592186549770} {:answer/id #uuid "fc7ffc60-8c50-5d64-a8a1-dfe85be3ab2c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}0 & 0 \\\\ 9 & 4 \\\\ -2 & 9\\end{aligned}]" :db/id #edb/ref 17592186549790}] :answer-field/correct {:db/id #edb/ref 17592186549637} :answer-field/id #uuid "6d683c36-c6df-5d48-954b-faab60c2b7e7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186549847}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b06d01a6-0f9f-5c10-83f5-9d9f497a0fba" :question/math-academy-id "q-269387" :question/problem "Consider the function $L:{R}^{3\\times 2}\\to R$ defined by $L(A)={y}^{T}Ax$ where \n\n$$\nx=[\\begin{aligned}0 \\\\ 1\\end{aligned}],\\,y=[\\begin{aligned}-2 \\\\ 4 \\\\ 9\\end{aligned}].\n$$\n\nWhat is ${∇}_{A}L$ at \n$A=[\\begin{aligned}-1 & 6 \\\\ 2 & 2 \\\\ 3 & -1\\end{aligned}]?$" :question/worked-solution "The gradient of $L$ with respect to $A$ is a matrix of the same shape as $A$, with $(i,j)$th entry given by\n\n$$\n\\frac{∂L}{∂{a}_{ij}},\n$$\n\nthe partial derivative of $L$ with respect to the $(i,j)$th entry of $A.$\n\nWriting out $L$ in component-wise notation as \n\n$$\nL={\\sum }_{i=1}^{3}{\\sum }_{j=1}^{2}{a}_{ij}{y}_{i}{x}_{j},\n$$\n\nwe have\n\n$$\n\\frac{∂L}{∂{a}_{ij}}={y}_{i}{x}_{j}.\n$$\n\nThus, ${∇}_{A}L=y\\cdot {x}^{T}.$\n\nEvaluating at the given values $x=[\\begin{aligned}0 \\\\ 1\\end{aligned}]$ and $y=[\\begin{aligned}-2 \\\\ 4 \\\\ 9\\end{aligned}],$ we get\n\n$$\n{∇}_{A}L=[\\begin{aligned}-2 \\\\ 4 \\\\ 9\\end{aligned}]\\cdot [\\begin{aligned}0 & 1\\end{aligned}]=[\\begin{aligned}0 & -2 \\\\ 0 & 4 \\\\ 0 & 9\\end{aligned}].\n$$"} :step/id #uuid "08378717-3017-5e03-97b0-35ada959e212" :step/next {:db/id #edb/ref 17592186550030}} {:db/id #edb/ref 17592186550030 :step/content {:db/id #edb/ref 17592186549924 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b4d4fb6a-d27b-55cc-8727-67a4c04b568b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "760" :db/id #edb/ref 17592186549652}] :answer-field/correct {:db/id #edb/ref 17592186549652} :answer-field/id #uuid "86a09f03-3f8a-5c3f-9183-dbfb9af6dd2a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186549863} {:answer-field/choices [{:answer/id #uuid "eeb1139b-d9f2-55ff-8169-1877c0fc480b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-40" :db/id #edb/ref 17592186549755}] :answer-field/correct {:db/id #edb/ref 17592186549755} :answer-field/id #uuid "a107a0f3-3d37-50c0-a77a-33925b86f16a" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186549878}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "078844cb-65ac-54f4-bde7-64e4bd44f313" :question/math-academy-id "q-269466" :question/problem "Consider the function $L:{R}^{2\\times 2}\\to R$ defined by $L(A)=2(Ax-b)^{T}(Ax-b),$ where\n\n$$\nx=[\\begin{aligned}10 \\\\ 10\\end{aligned}],\\,b=[\\begin{aligned}1 \\\\ 1\\end{aligned}].\n$$\n\nWhat is ${∇}_{A}L$ at \n$A=[\\begin{aligned}1 & 1 \\\\ 1 & -1\\end{aligned}]?$\n\n<table cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"70px\" rowspan=\"2\" width=\"30px\">\n${∇}_{A}=\\,\\,$\n</td>\n<td align=\"center\" height=\"35px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">$760$</td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\">$-40$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "The gradient of $L$ with respect to $A$ is a matrix of the same shape as $A$, with $(i,j)$th entry given by\n\n$$\n\\frac{∂L}{∂{a}_{ij}},\n$$\n\nthe partial derivative of $L$ with respect to the $(i,j)$th entry of $A.$\n\nWe can compute $\\frac{∂L}{∂{a}_{ij}}$ by applying the chain rule.\n\nLet $y=Ax-b\\in {R}^{2}.$ Then, $L(A)=2{y}^{T}y$ and\n\n$$\n\\frac{∂L}{∂{a}_{ij}}={\\sum }_{k=1}^{2}\\frac{∂L}{∂{y}_{k}}\\cdot \\frac{∂{y}_{k}}{∂{a}_{ij}}\n$$\n\nNow, since \n\n$$\n{∇}_{y}L={∇}_{y}(2{y}^{T}y)=4y,\n$$\n\nwe have that\n\n$$\n\\frac{∂L}{∂{y}_{k}}=4{y}_{k}.\n$$\n\nWriting out $y=Ax-b$ in component-wise notation as \n\n$$\n{y}_{i}={\\sum }_{j=1}^{2}{a}_{ij}{x}_{j}-{b}_{i}.\n$$\n\nwe have \n\n- $\\frac{∂{y}_{k}}{∂{a}_{ij}}={x}_{j}$ if $i=k$, and\n\n- $\\frac{∂{y}_{k}}{∂{a}_{ij}}=0$ if $i\\ne k.$\n\nThis means that \n\n$$\n\\begin{aligned}\\frac{∂L}{∂{a}_{ij}} & ={\\sum }_{k=1}^{2}\\frac{∂L}{∂{y}_{k}}\\cdot \\frac{∂{y}_{k}}{∂{a}_{ij}} \\\\  & =\\frac{∂L}{∂{y}_{i}}\\cdot \\frac{∂{y}_{i}}{∂{a}_{ij}} \\\\  & =4{y}_{i}\\cdot \\frac{∂{y}_{i}}{∂{a}_{ij}} \\\\  & =4{y}_{i}{x}_{j}.\\end{aligned}\n$$\n\nThe $(i,j)$th entry of ${∇}_{A}L$ is $4$ times the $i$th entry of $y$ multiplied by the $j$th entry of $x,$ so\n\n$$\n{∇}_{A}L=4y\\cdot {x}^{T}.\n$$\n\nFinally, evaluating ${∇}_{A}L$ at $A=[\\begin{aligned}1 & 1 \\\\ 1 & -1\\end{aligned}],$ we get\n\n$$\n\\begin{aligned}{∇}_{A}L & =4y\\cdot {x}^{T} \\\\  & =4(Ax-b)\\cdot {x}^{T} \\\\  & =4([\\begin{aligned}1 & 1 \\\\ 1 & -1\\end{aligned}][\\begin{aligned}10 \\\\ 10\\end{aligned}]-[\\begin{aligned}1 \\\\ 1\\end{aligned}])\\cdot [\\begin{aligned}10 & 10\\end{aligned}] \\\\  & =4([\\begin{aligned}20 \\\\ 0\\end{aligned}]-[\\begin{aligned}1 \\\\ 1\\end{aligned}])\\cdot [\\begin{aligned}10 & 10\\end{aligned}] \\\\  & =[\\begin{aligned}76 \\\\ -4\\end{aligned}]\\cdot [\\begin{aligned}10 & 10\\end{aligned}] \\\\  & =[\\begin{aligned}760 & 760 \\\\ -40 & -40\\end{aligned}].\\end{aligned}\n$$"} :step/id #uuid "1ce65caa-d800-5e9b-998a-08f08f3b10e3"} {:db/id #edb/ref 17592186550034 :step/content {:db/id #edb/ref 17592186204583 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "390d31e7-0eb4-5afa-8052-7ccdd44c6579" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186549433}] :answer-field/correct {:db/id #edb/ref 17592186549433} :answer-field/id #uuid "a792c03a-20d1-502a-87d8-51c51290a0f7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186203428} {:answer-field/choices [{:answer/id #uuid "4bf55f8d-69c2-5804-b198-4e612f8ef966" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "260" :db/id #edb/ref 17592186549469}] :answer-field/correct {:db/id #edb/ref 17592186549469} :answer-field/id #uuid "d8fb804b-e34c-5518-b27d-f7e1b108969b" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186203429} {:answer-field/choices [{:answer/id #uuid "d24effe3-93a6-51e3-92fb-67753603fb63" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-80" :db/id #edb/ref 17592186549705}] :answer-field/correct {:db/id #edb/ref 17592186549705} :answer-field/id #uuid "f24f27c1-d129-569d-91c5-ec978eca7083" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186203430} {:answer-field/choices [{:answer/id #uuid "e1be0ef3-af8e-50ef-8a85-884fab6e57c6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "130" :db/id #edb/ref 17592186549731}] :answer-field/correct {:db/id #edb/ref 17592186549731} :answer-field/id #uuid "1b648609-00c6-5d8f-b7a0-5619dddfcab1" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186203431}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c38068fb-d53f-5bd3-995e-1c6838e1f711" :question/math-academy-id "q-269257" :question/problem "Consider the function $L:{R}^{2\\times 3}\\to R$ defined by $L(A)=\\frac{1}{2}(Ax-b)^{T}(Ax-b),$ where\n\n$$\nx=[\\begin{aligned}0 \\\\ 10 \\\\ 20\\end{aligned}],\\,b=[\\begin{aligned}7 \\\\ 8\\end{aligned}].\n$$\n\nWhat is ${∇}_{A}L$ at \n$A=[\\begin{aligned}1 & 2 & 0 \\\\ 4 & 0 & 0\\end{aligned}]?$\n\n<table cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"70px\" rowspan=\"2\" width=\"30px\">\n${∇}_{A}=\\,\\,$\n</td>\n<td align=\"center\" height=\"35px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"30px\">{{field-2}}</td>\n<td align=\"center\" width=\"30px\">{{field-3}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">$0$</td>\n<td align=\"center\">{{field-4}}</td>\n<td align=\"center\">$-160$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "The gradient of $L$ with respect to $A$ is a matrix of the same shape as $A$, with $(i,j)$th entry given by\n\n$$\n\\frac{∂L}{∂{a}_{ij}},\n$$\n\nthe partial derivative of $L$ with respect to the $(i,j)$th entry of $A.$\n\nWe can compute $\\frac{∂L}{∂{a}_{ij}}$ by applying the chain rule.\n\nLet $y=Ax-b\\in {R}^{2}.$ Then, $L(A)=\\frac{1}{2}{y}^{T}y$ and\n\n$$\n\\frac{∂L}{∂{a}_{ij}}={\\sum }_{k=1}^{2}\\frac{∂L}{∂{y}_{k}}\\cdot \\frac{∂{y}_{k}}{∂{a}_{ij}}\n$$\n\nNow, since \n\n$$\n{∇}_{y}L={∇}_{y}(\\frac{1}{2}{y}^{T}y)=y,\n$$\n\nwe have that\n\n$$\n\\frac{∂L}{∂{y}_{k}}={y}_{k}.\n$$\n\nWriting out $y=Ax-b$ in component-wise notation as \n\n$$\n{y}_{i}={\\sum }_{j=1}^{3}{a}_{ij}{x}_{j}-{b}_{i},\n$$\n\nwe have \n\n- $\\frac{∂{y}_{k}}{∂{a}_{ij}}={x}_{j}$ if $i=k$, and\n\n- $\\frac{∂{y}_{k}}{∂{a}_{ij}}=0$ if $i\\ne k.$\n\nThis means that \n\n$$\n\\begin{aligned}\\frac{∂L}{∂{a}_{ij}} & ={\\sum }_{k=1}^{2}\\frac{∂L}{∂{y}_{k}}\\cdot \\frac{∂{y}_{k}}{∂{a}_{ij}} \\\\  & =\\frac{∂L}{∂{y}_{i}}\\cdot \\frac{∂{y}_{i}}{∂{a}_{ij}} \\\\  & ={y}_{i}\\cdot \\frac{∂{y}_{i}}{∂{a}_{ij}} \\\\  & ={y}_{i}{x}_{j}.\\end{aligned}\n$$\n\nThe $(i,j)$th entry of ${∇}_{A}L$ is the $i$th entry of $y$ multiplied by the $j$th entry of $x$, so\n\n$$\n{∇}_{A}L=y\\cdot {x}^{T}.\n$$\n\nFinally, evaluating ${∇}_{A}L$ at $A=[\\begin{aligned}1 & 2 & 0 \\\\ 4 & 0 & 0\\end{aligned}],$ we get\n\n$$\n\\begin{aligned}{∇}_{A}L & =y\\cdot {x}^{T} \\\\  & =(Ax-b)\\cdot {x}^{T} \\\\  & =([\\begin{aligned}1 & 2 & 0 \\\\ 4 & 0 & 0\\end{aligned}][\\begin{aligned}0 \\\\ 10 \\\\ 20\\end{aligned}]-[\\begin{aligned}7 \\\\ 8\\end{aligned}])\\cdot [\\begin{aligned}0 & 10 & 20\\end{aligned}] \\\\  & =([\\begin{aligned}20 \\\\ 0\\end{aligned}]-[\\begin{aligned}7 \\\\ 8\\end{aligned}])\\cdot [\\begin{aligned}0 & 10 & 20\\end{aligned}] \\\\  & =[\\begin{aligned}13 \\\\ -8\\end{aligned}]\\cdot [\\begin{aligned}0 & 10 & 20\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 130 & 260 \\\\ 0 & -80 & -160\\end{aligned}].\\end{aligned}\n$$"} :step/id #uuid "244abaf2-b14e-5d3c-8a36-dbd5fac2c489" :step/next {:db/id #edb/ref 17592186550058}} {:db/id #edb/ref 17592186550058 :step/content {:db/id #edb/ref 17592186549972 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "298e07ae-5f8c-52b7-8fdb-05f8ff2eb333" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}4 & -2 & 0 \\\\ 28 & -14 & 0\\end{aligned}]" :db/id #edb/ref 17592186549407} {:answer/id #uuid "3b2813e9-da8e-59ae-9d0e-61e685a4f322" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}1 & -3 & 5 \\\\ 0 & 0 & 2\\end{aligned}]" :db/id #edb/ref 17592186549437} {:answer/id #uuid "a2aefe95-7159-51aa-88da-37aecf1ef5f2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}4 & -2 \\\\ 0 & 28 \\\\ -14 & 0\\end{aligned}]" :db/id #edb/ref 17592186549626} {:answer/id #uuid "af6ac5dd-6929-5011-8bf3-a504e287864a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}2 & -1 & 0 \\\\ 14 & -7 & 0\\end{aligned}]" :db/id #edb/ref 17592186549644} {:answer/id #uuid "f7a8f364-5251-5618-b38b-b49e3fc2960c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}1 & 4 \\\\ 2 & 0 \\\\ 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186549780}] :answer-field/correct {:db/id #edb/ref 17592186549407} :answer-field/id #uuid "8abf474a-1fab-5810-988c-58859ca7b121" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186549865}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7c674592-16b0-5e5a-b0ac-ce1e62f430e7" :question/math-academy-id "q-269369" :question/problem "Consider the function $L:{R}^{2\\times 3}\\to R$ defined by $L(A)=2({y}^{T}Ax)$ where \n\n$$\nx=[\\begin{aligned}2 \\\\ -1 \\\\ 0\\end{aligned}],\\,y=[\\begin{aligned}1 \\\\ 7\\end{aligned}].\n$$\n\nWhat is ${∇}_{A}L$ at \n$A=[\\begin{aligned}1 & -3 & 5 \\\\ 0 & 0 & 2\\end{aligned}]?$" :question/worked-solution "The gradient of $L$ with respect to $A$ is a matrix of the same shape as $A$, with $(i,j)$th entry given by\n\n$$\n\\frac{∂L}{∂{a}_{ij}},\n$$\n\nthe partial derivative of $L$ with respect to the $(i,j)$th entry of $A.$\n\nWriting out $L$ in component-wise notation as \n\n$$\nL={\\sum }_{i=1}^{2}{\\sum }_{j=1}^{3}2{a}_{ij}{y}_{i}{x}_{j},\n$$\n\nwe have\n\n$$\n\\frac{∂L}{∂{a}_{ij}}=2{y}_{i}{x}_{j}.\n$$\n\nThus, ${∇}_{A}L=2(y\\cdot {x}^{T}).$\n\nEvaluating at the given values $x=[\\begin{aligned}2 \\\\ -1 \\\\ 0\\end{aligned}]$ and $y=[\\begin{aligned}1 \\\\ 7\\end{aligned}],$ we get\n\n$$\n{∇}_{A}L=2([\\begin{aligned}1 \\\\ 7\\end{aligned}]\\cdot [\\begin{aligned}2 & -1 & 0\\end{aligned}])=2([\\begin{aligned}2 & -1 & 0 \\\\ 14 & -7 & 0\\end{aligned}])=[\\begin{aligned}4 & -2 & 0 \\\\ 28 & -14 & 0\\end{aligned}].\n$$"} :step/id #uuid "5abfd5b5-134f-5a5a-8939-900b7bd8ea02" :step/next {:db/id #edb/ref 17592186550063}} {:db/id #edb/ref 17592186550063 :step/content {:db/id #edb/ref 17592186549952 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f99e9f1-58c4-5851-9600-8204fd87374e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}1 & 4 \\\\ 1 & -2 \\\\ 1 & -8\\end{aligned}]" :db/id #edb/ref 17592186549342} {:answer/id #uuid "10f26137-5141-548b-ae96-c5e466eb63be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}14 & 14 & 28 \\\\ 14 & 14 & 28\\end{aligned}]" :db/id #edb/ref 17592186549343} {:answer/id #uuid "902a2d7e-4845-5624-8b64-c075f831f4cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}14 & 14 & -28 \\\\ -28 & 14 & 14\\end{aligned}]" :db/id #edb/ref 17592186549595} {:answer/id #uuid "b57deb46-f99b-5d8a-aa79-e0e3eafad385" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}14 & 14 & -28 \\\\ 14 & 14 & -28\\end{aligned}]" :db/id #edb/ref 17592186549654} {:answer/id #uuid "ea606262-28d8-520e-a132-062645065d2c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}14 & 14 \\\\ -28 & 28 \\\\ 14 & -28\\end{aligned}]" :db/id #edb/ref 17592186549745}] :answer-field/correct {:db/id #edb/ref 17592186549654} :answer-field/id #uuid "1e3a6cde-fe2e-5328-94cb-e127be547cc6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186549812}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "34c44cc9-bf3e-5025-8ef7-d8fd637a6eae" :question/math-academy-id "q-269370" :question/problem "Consider the function $L:{R}^{2\\times 3}\\to R$ defined by $L(A)={y}^{T}Ax$ where \n\n$$\nx=[\\begin{aligned}2 \\\\ 2 \\\\ -4\\end{aligned}],\\,y=[\\begin{aligned}7 \\\\ 7\\end{aligned}].\n$$\n\nWhat is ${∇}_{A}L$ at \n$A=[\\begin{aligned}0 & -1 & 3 \\\\ 1 & 1 & 1\\end{aligned}]?$" :question/worked-solution "The gradient of $L$ with respect to $A$ is a matrix of the same shape as $A$, with $(i,j)$th entry given by\n\n$$\n\\frac{∂L}{∂{a}_{ij}},\n$$\n\nthe partial derivative of $L$ with respect to the $(i,j)$th entry of $A.$\n\nWriting out $L$ in component-wise notation as \n\n$$\nL={\\sum }_{i=1}^{2}{\\sum }_{j=1}^{3}{a}_{ij}{y}_{i}{x}_{j},\n$$\n\nwe have\n\n$$\n\\frac{∂L}{∂{a}_{ij}}={y}_{i}{x}_{j}.\n$$\n\nThus, ${∇}_{A}L=y\\cdot {x}^{T}.$\n\nEvaluating at the given values $x=[\\begin{aligned}2 \\\\ 2 \\\\ -4\\end{aligned}]$ and $y=[\\begin{aligned}7 \\\\ 7\\end{aligned}],$ we get\n\n$$\n{∇}_{A}L=[\\begin{aligned}7 \\\\ 7\\end{aligned}]\\cdot [\\begin{aligned}2 & 2 & -4\\end{aligned}]=[\\begin{aligned}14 & 14 & -28 \\\\ 14 & 14 & -28\\end{aligned}].\n$$"} :step/id #uuid "64cd4bd3-fcea-541b-aa6e-833c6b308386" :step/next {:db/id #edb/ref 17592186550025}}] :activity/title "Matrix Gradients" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186549318}]}
