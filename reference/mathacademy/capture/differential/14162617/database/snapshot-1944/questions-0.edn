db/id #edb/ref 17592186486926} {:answer/id #uuid "9f9cbb60-93e6-5126-a662-317f82561921" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "greatest upper bound" :db/id #edb/ref 17592186486953}] :answer-field/correct {:answer/id #uuid "4d66afd5-954f-52aa-85ff-8a35f220352d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "smallest upper bound" :db/id #edb/ref 17592186486761} :answer-field/id #uuid "cccdc7ac-4c98-5946-bd46-0e11422f5ea2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186487254}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "be9aa3b1-68a0-5981-aa70-f10a99f6fbac" :question/math-academy-id "q-253556" :question/problem "Consider the set $C=(-2,-1].$ Complete the following reasoning to identify $sup(C).$\n\nThe supremum of a set $C$ is the {{field-1}} of $C.$\n\nThe set of upper bounds of $C$ is as follows:\n\n$$\n\\{x\\in R\\,:\\,x{{field-2}}{{field-3}}\\}\n$$\n\nTherefore, {{field-4}}." :question/worked-solution "The supremum of a set $C$ is the smallest upper bound of $C.$\n\nTo find the supremum of this set, we must find the set containing **all** upper bounds of $C$ (i.e., the set of upper bounds) and take the minimum of this set.\n\nIn our case, we have the following:\n\n- Any number in the set $x\\ge -1$ is greater than or equal to the elements of $C.$ Thus, the set $[-1,\\infty )$ contains only upper bounds of $C.$\n\n- Any number in the set $x<-1$ is **not** an upper bound of $C.$ In other words, we can always find an element of $C$ that is greater than $x$ for any $x<-1.$\n\nTherefore, $[-1,\\infty )$ is the set of upper bounds of $C,$ and\n\n$$\nsup(C)=min[-1,\\infty )=-1.\n$$\n\nNotice that $-1$ is also the maximum of $C.$\n\nThe completed reasoning is given below.\n\nThe supremum of $C$ is the $\\text{smallest upper bound}$ of $C.$\n\nThe set of upper bounds of $C$ is as follows:\n\n$$\n\\{x\\in R\\,:\\,x\\ge -1\\}\n$$\n\nTherefore, $sup(C)=-1\\in C.$"}] [{:db/id #edb/ref 17592186487338 :knowledge-point/_questions [{:db/id #edb/ref 17592186162157 :knowledge-point/id #uuid "fee0e08c-5a7a-5f78-83aa-39679bb3b17b" :knowledge-point/title "Supremum and Infimum of an Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "62cdb8be-ff0a-5ba1-b0a9-dc08786b5ad9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "unbounded above" :db/id #edb/ref 17592186486810} {:answer/id #uuid "780a734c-73b7-5ed7-8224-36e0b8d09502" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "bounded below" :db/id #edb/ref 17592186486857} {:answer/id #uuid "ae00c5e2-c9f7-5933-9796-5ffc94c34d89" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "bounded above" :db/id #edb/ref 17592186486983} {:answer/id #uuid "f4b738d0-d9f1-569e-acb9-261c8fe2e4be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "unbounded below" :db/id #edb/ref 17592186487118}] :answer-field/correct {:answer/id #uuid "62cdb8be-ff0a-5ba1-b0a9-dc08786b5ad9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "unbounded above" :db/id #edb/ref 17592186486810} :answer-field/id #uuid "17cc1735-bda1-5b2e-bec3-aadf0a63ced6" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186487145} {:answer-field/choices [{:answer/id #uuid "0735ca12-5065-5046-b0f7-3bfc9e3f9c44" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "unbounded below" :db/id #edb/ref 17592186486606} {:answer/id #uuid "336b7dfe-4cdb-510d-86ba-babad133fa08" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "bounded below" :db/i