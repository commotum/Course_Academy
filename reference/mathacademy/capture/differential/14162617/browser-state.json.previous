" space=\"4\"><mjx-c class=\"mjx-c30\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2208\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-i\" space=\"4\"><mjx-c class=\"mjx-c1D434 TEX-I\"></mjx-c></mjx-mi></mjx-mstyle></mjx-rbox></mjx-block></mjx-mpadded></mjx-mstyle><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mstyle mathbackground=\"Gainsboro\"><mpadded height=\"+3pt\" depth=\"+3pt\" lspace=\"3pt\" width=\"+6pt\"><mstyle mathcolor=\"blue\"><mo data-mjx-texclass=\"OP\" movablelimits=\"true\">inf</mo><mo stretchy=\"false\">(</mo><mi>A</mi><mo stretchy=\"false\">)</mo><mo>=</mo><mn>0</mn><mo>∈</mo><mi>A</mi></mstyle></mpadded></mstyle><mo>.</mo></math></mjx-assistive-mml></mjx-container></p>\n</blockquote>\n</div></div>",
