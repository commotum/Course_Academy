x{e}^{-3x}}{3}+\\frac{1}{3}\\int {e}^{-3x}\\,\\text{d}x \\\\  & =-\\frac{x{e}^{-3x}}{3}-\\frac{{e}^{-3x}}{9}+C\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186272422 #edb/ref 1080 "-2x\\operatorname{sin}⁡x+\\operatorname{cos}⁡x+C" #edb/ref 17592186045417] [17592186272422 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186272422 #edb/ref 1083 #uuid "043fa24a-45ec-5b10-bfa8-7e31faa50866" #edb/ref 17592186045417] [17592186273038 #edb/ref 1080 "2x\\operatorname{cos}⁡x-x\\operatorname{sin}⁡x+C" #edb/ref 17592186045417] [17592186273038 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186273038 #edb/ref 1083 #uuid "4dad317a-7e2c-5027-9a3a-188de187c660" #edb/ref 17592186045417] [17592186273256 #edb/ref 1080 "\\operatorname{cos}⁡2x+x\\operatorname{sin}⁡2x+C" #edb/ref 17592186045417] [17592186273256 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186273256 #edb/ref 1083 #uuid "657c9906-4184-54b2-a2ca-75931266448c" #edb/ref 17592186045417] [17592186274192 #edb/ref 1080 "-x\\operatorname{cos}⁡x-\\operatorname{cos}⁡2x+C" #edb/ref 17592186045417] [17592186274192 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186274192 #edb/ref 1083 #uuid "cf6fa9bf-7209-5009-8683-0533f03518a8" #edb/ref 17592186045417] [17592186274503 #edb/ref 1080 "-2x\\operatorname{cos}⁡x+2\\operatorname{sin}⁡x+C" #edb/ref 17592186045417] [17592186274503 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186274503 #edb/ref 1083 #uuid "ef13a328-66f5-517d-8b0a-ca4c0258e019" #edb/ref 17592186045417] [17592186274873 #edb/ref 1075 #edb/ref 17592186272422 #edb/ref 17592186045417] [17592186274873 #edb/ref 1075 #edb/ref 17592186273038 #edb/ref 17592186045417] [17592186274873 #edb/ref 1075 #edb/ref 17592186273256 #edb/ref 17592186045417] [17592186274873 #edb/ref 1075 #edb/ref 17592186274192 #edb/ref 17592186045417] [17592186274873 #edb/ref 1075 #edb/ref 17592186274503 #edb/ref 17592186045417] [17592186274873 #edb/ref