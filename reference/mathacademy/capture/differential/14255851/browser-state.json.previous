 data-mjx-texclass=\"OPEN\">(</mo><msup><mi>x</mi><mn>3</mn></msup><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mo>⋅</mo><msup><mi>x</mi><mn>2</mn></msup><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>d</mtext><mi>x</mi></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><mo data-mjx-texclass=\"OP\">∫</mo><mn>5</mn><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>u</mi><mo>⋅</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mn>3</mn></mfrac></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>d</mtext><mi>u</mi></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>5</mn><mn>3</mn></mfrac></mstyle><mo data-mjx-texclass=\"OP\">∫</mo><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>u</mi><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>d</mtext><mi>u</mi></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>5</mn><mn>3</mn></mfrac></mstyle><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>u</mi><mo>+</mo><mi>C</mi></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>5</mn><mn>3</mn></mfrac></mstyle><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><msup><mi>x</mi><mn>3</mn></msup><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mo>+</mo><mi>C</mi></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
