 & 0\\end{aligned}] & {R}_{1} & ↔{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 3 & 0 \\\\ 1 & 2 & 1 \\\\ 0 & 0 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 3 & 0 \\\\ 0 & -1 & 1 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe pivot columns correspond to linearly independent vectors, while the non-pivot columns correspond to linearly dependent vectors that can be removed. Here, the $1$st and $2$nd columns are pivot columns, while the $3$rd column is a non-pivot column.\n\nRemember that we need to pick the pivot columns from the *original matrix*, not from the reduced one. \n\nThe $1$st and $2$nd columns from the original matrix are ${d}_{1}$ and ${d}_{2}.$ So, a basis of $\\text{Col}(D)$ is $\\{{d}_{1},{d}_{2}\\},$ that is to say,\n\n$$\nB=\\{[\\begin{aligned}0 \\\\ 1 \\\\ 1\\end{aligned}],[\\begin{aligned}0 \\\\ 2 \\\\ 3\\end{aligned}]\\}.\n$$" 13194139534888 17592186045417 true] [17592186442800 1068 #edb/ref 17592186442796 13194139534888 17592186045417 true] [17592186442800 1069 "q-75072" 13194139534888 17592186045417 true] [17592186442800 1070 #edb/ref 17592186045487 13194139534888 17592186045417 true] [17592186442800 1071 "Consider the matrix \n$T=[\\begin{aligned}1 & -3 & 0 \\\\ 2 & -1 & 10 \\\\ 4 & -10 & 2\\end{aligned}].$ Find a basis $B$ of $\\text{Col}(T).$" 13194139534888 17592186045417 true] [17592186442800 1072 #uuid "826a5640-8f36-5e06-a060-8061b74d91af" 13194139534888 17592186045417 true] [17592186442800 1074 "In order to find a basis of $\\text{Col}(T),$ we reduce the matrix $T$ to row echelon form:\n\n$$\n\\begin{aligned}T & =[\\begin{aligned}1 & -3 & 0 \\\\ 2 & -1 & 10 \\\\ 4 & -10 & 2\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 0 \\\\ 0 & 5 & 10 \\\\ 4 & -10 & 2\\end{aligned}] & {R}_{3} & :={R}_{3}+(-4){R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 0 \\\\ 0 & 5 & 10 \\\\ 0 & 2 & 2\\end{aligned}] & {R}_{3} & :={R}_{3}+(-\\frac{2}{5}){R}_{2} \\\\  & ∼[\\begin{aligned}1 & -3 & 0 \\\\ 0 & 5 & 10 \\\\ 0 & 0 & -2\\end{aligned}]\\end{aligned}\n$$\n\nThe pivot columns correspond to linearly independent vectors, while the non-pivot columns correspond to linearly dependent vectors that can be removed. Here, the $1$st, $2$nd and $3$rd columns are pivot columns.\n\nRemember that we need to pick the pivot columns from the *original matrix*, not from the reduced one. \n\nThe $1$st, $2$nd and $3$rd columns from the original matrix are ${t}_{1},$ ${t}_{2}$ and ${t}_{3}.$ So, a basis of $\\text{Col}(T)$ is $\\{{t}_{1},{t}_{2},{t}_{3}\\},$ that is to say, \n\n$$\nB=\\{[\\begin{aligned}1 \\\\ 2 \\\\ 4\\end{aligned}],[\\begin{aligned}-3 \\\\ -1 \\\\ -10\\end{aligned}],[\\begin{aligned}0 \\\\ 10 \\\\ 2\\end{aligned}]\\}.\n$$" 13194139534888 17592186045417 true] [17592186442801 1068 #edb/ref 17592186442798 13194139534888 17592186045417 true] [17592186442801 1069 "q-111202" 13194139534888 17592186045417 true] [17592186442801 1070 #edb/ref 17592186045487 13194139534888 17592186045417 true] [17592186442801 1071 "Consider the matrix \n$T=[\\begin{aligned}1 & -1 & 2 \\\\ 3 & -7 & 2 \\\\ -9 & 17 & -10\\end{aligned}].$ Find a basis $B$ of $\\text{Col}(T).$" 13194139534888 17592186045417 true] [17592186442801 1072 #uuid "8d9f1369-e16d-5498-abf4-50e74407ebff" 13194139534888 17592186045417 true] [17592186442801 1074 "In order to find a basis of $\\text{Col}(T),$ we reduce the matrix $T$ to row echelon form:\n\n$$\n\\begin{aligned}T & =[\\begin{aligned}1 & -1 & 2 \\\\ 3 & -7 & 2 \\\\ -9 & 17 & -10\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 \\\\ 0 & -4 & -4 \\\\ -9 & 17 & -10\\end{aligned}] & {R}_{3} & :={R}_{3}+9{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 \\\\ 0 & -4 & -4 \\\\ 0 & 8 & 8\\end{aligned}] & {R}_{3} & :={R}_{3}+2{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 \\\\ 0 & -4 & -4 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe pivot columns correspond to linearly independent vectors, while the non-pivot columns correspond to linearly dependent vectors that can be removed. Here, the $1$st and $2$nd columns are pivot columns, while the $3$rd column is a non-pivot column.\n\nRemember that we need to pick the pivot columns from the *original matrix*, not from the reduced one. \n\nThe $1$st and $2$nd columns from the original matrix are ${t}_{1}$ and ${t}_{2}.$ So, a basis of $\\text{Col}(T)$ is $\\{{t}_{1},{t}_{2}\\},$ that is to say, \n\n$$\nB=\\{[\\begin{aligned}1 \\\\ 3 \\\\ -9\\end{aligned}],[\\begin{aligned}-1 \\\\ -7 \\\\ 17\\end{aligned}]\\}.\n$$" 13194139534888 17592186045417 true] [17592186442802 1068 #edb/ref 17592186442795 13194139534888 17592186045417 true] [17592186442802 1069 "q-111511" 13194139534888 17592186045417 true] [17592186442802 1070 #edb/ref 17592186045486 13194139534888 17592186045417 true] [17592186442802 1071 "The matrix $H$ is given below. Let ${h}_{1}$, ${h}_{2}$,  ${h}_{3}$ and ${h}_{4}$ be the respective columns of $H.$\nDetermine if $B=\\text{{}{h}_{1},{h}_{3}\\text{}}$ is a basis of $\\text{Col}(H).$ \nIf that is the case, find ${x}_{1}\\cdot {x}_{3}$, where ${h}_{4}={x}_{1}{h}_{1}+{x}_{3}{h}_{3}.$ \n\n$$\nH=[\\begin{aligned}1 & -2 & 1 & 0 \\\\ 2 & -6 & 0 & -6 \\\\ -7 & 18 & -3 & 13\\end{aligned}]\n$$" 13194139534888 17592186045417 true] [17592186442802 1072 #uuid "fb8ab0b6-52ad-56fe-b865-4fa731f7308c" 13194139534888 17592186045417 true] [17592186442802 1074 "First, we reduce the matrix $H$ to reduced row echelon form (RREF):\n\n$$\n\\begin{aligned}H & =[\\begin{aligned}1 & -2 & 1 & 0 \\\\ 2 & -6 & 0 & -6 \\\\ -7 & 18 & -3 & 13\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 1 & 0 \\\\ 0 & -2 & -2 & -6 \\\\ -7 & 18 & -3 & 13\\end{aligned}] & {R}_{3} & :={R}_{3}+7{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 1 & 0 \\\\ 0 & -2 & -2 & -6 \\\\ 0 & 4 & 4 & 13\\end{aligned}] & {R}_{3} & :=(-\\frac{1}{2}){R}_{3} \\\\  & ∼[\\begin{aligned}1 & -2 & 1 & 0 \\\\ 0 & 1 & 1 & 3 \\\\ 0 & 4 & 4 & 13\\end{aligned}] & {R}_{3} & :={R}_{3}+(-4){R}_{2} \\\\  & ∼[\\begin{aligned}1 & -2 & 1 & 0 \\\\ 0 & 1 & 1 & 3 \\\\ 0 & 0 & 0 & 1\\end{aligned}]\\end{aligned}\n$$\n\nFrom the matrix above, we see that the pivot columns are the $1$st, $2$nd, and $4$th columns. So, a basis of $\\text{Col}(H)$ is $\\{{h}_{1},{h}_{2},{h}_{4}\\}.$ \n\nTherefore, we conclude that $B=\\{{h}_{1},{h}_{3}\\}$ is not a basis of $\\text{Col}(H).$" 13194139534888 17592186045417 true]] :edb/tempids {"answer-054ab422-ed82-5647-a3ec-ee7e5f938c0b" 17592186442766 "answer-09edbcaf-e507-56c2-9601-97a969f32090" 17592186442767 "answer-0c61635a-16c4-5875-a03d-2914bf2b487b" 17592186442768 "answer-1a09c2a0-736e-5081-9d7b-cd940e10ce12" 17592186442769 "answer-1e9cd8e0-a7ea-505f-a45a-9be34d920212" 17592186442770 "answer-2decce7e-2100-5b81-a206-46546723c381" 17592186442771 "answer-35598a21-d7f5-5d84-82fa-760e414d1e91" 17592186442772 "answer-4143e3f3-49a8-557d-b984-d646890798bd" 17592186442773 "answer-5164791c-ddd6-543a-91e1-e45b17206848" 17592186442774 "answer-572e0214-e8cf-5d31-97a8-af4af5bb7ef5" 17592186442775 "answer-66a3ceae-0855-545a-af62-72a0d257ecfd" 17592186442776 "answer-6d306a86-e1bb-5440-b35f-34da68a45e9e" 17592186442777 "answer-71e6a5d4-18a8-5568-b05a-36719e527e28" 17592186442778 "answer-76031efa-b2a3-59a0-8d28-4da798f07ea1" 17592186442779 "answer-96a3e6f1-81c0-56ef-815f-d0a58729ca14" 17592186442780 "answer-a5fbafaa-f05c-5762-8d2f-0ad19854c541" 17592186442781 "answer-ac7a6cb3-b0b4-52a1-b2dd-c3680a86168c" 17592186442782 "answer-b9c9eafc-4807-5e80-867d-9b5b4c2e0cfe" 17592186442783 "answer-c0d8a778-cf1d-59df-817d-a34a0002be31" 17592186442784 "answer-caf351c8-dc27-5048-8439-3fd32f3cb562" 17592186442785 "answer-cee0af27-d726-504b-bcd1-86fab0b3c8e9" 17592186442786 "answer-d2c4495a-79e6-52e0-b7b6-1c35021762ad" 17592186442787 "answer-dbe4833c-57ba-5128-b5d0-898033056d88" 17592186442788 "answer-dc1d290d-4def-5d35-a92b-4140f3d0ba55" 17592186442789 "answer-def5fdfb-e89a-5859-8b3c-d85be3961922" 17592186442790 "answer-eac1002d-df88-59d4-97af-f9d