5417] [17592186442798 #edb/ref 1075 #edb/ref 17592186442766 #edb/ref 17592186045417] [17592186442798 #edb/ref 1075 #edb/ref 17592186442774 #edb/ref 17592186045417] [17592186442798 #edb/ref 1075 #edb/ref 17592186442779 #edb/ref 17592186045417] [17592186442798 #edb/ref 1075 #edb/ref 17592186442782 #edb/ref 17592186045417] [17592186442798 #edb/ref 1075 #edb/ref 17592186442790 #edb/ref 17592186045417] [17592186442798 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186442798 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186442798 #edb/ref 1078 #edb/ref 17592186442774 #edb/ref 17592186045417] [17592186442798 #edb/ref 1079 #uuid "dc25d7c4-dcb7-5031-956f-6a696139cc1b" #edb/ref 17592186045417] [17592186442799 #edb/ref 1068 #edb/ref 17592186442797 #edb/ref 17592186045417] [17592186442799 #edb/ref 1069 "q-35693" #edb/ref 17592186045417] [17592186442799 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186442799 #edb/ref 1071 "Consider the matrix \n$D=[\\begin{aligned}0 & 0 & 0 \\\\ 1 & 2 & 1 \\\\ 1 & 3 & 0\\end{aligned}].$ Find a basis $B$ of $\\text{Col}(D).$" #edb/ref 17592186045417] [17592186442799 #edb/ref 1072 #uuid "25a2d5c0-7186-5968-b93b-25b6e34f0acb" #edb/ref 17592186045417] [17592186442799 #edb/ref 1074 "In order to find a basis of $\\text{Col}(D),$ we reduce the matrix $D$ to row echelon form:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}0 & 0 & 0 \\\\ 1 & 2 & 1 \\\\ 1 & 3 & 0\\end{aligned}] & {R}_{1} & ↔{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 3 & 0 \\\\ 1 & 2 & 1 \\\\ 0 & 0 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 3 & 0 \\\\ 0 & -1 & 1 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe pivot columns correspond to linearly independent vectors, while the non-pivot columns correspond to linearly dependent vectors that can be removed. Here, the $1$st and $2$nd columns are pivot columns, while the $3$rd column is a non-pivot column.\n\nRemember that we need to pick the pivot columns from the *original matrix*, not from the reduced one. \n\nThe $1$st and $2$nd columns from the original matrix are ${d}_{1}$ and ${d}_{2}.$ So, a basis of $\\text{Col}(D)$ is $\\{{d}_{1},{d}_{2}\\},$ that is to say,\n\n$$\nB=\\{[\\begin{aligned}0 \\\\ 1 \\\\ 1\\end{aligned}],[\\begin{aligned}0 \\\\ 2 \\\\ 3\\end{aligned}]\\}.\n$$" #edb/ref 17592186045417] [17592186442800 #edb/ref 1068 #edb/ref 17592186442796 #edb/ref 17592186045417] [17592186442800 #edb/ref 1069 "q-75072" #edb/ref 17592186045417] [17592186442800 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186442800 #edb/ref 1071 "Consider the matrix \n$T=[\\begin{aligned}1 & -3 & 0 \\\\ 2 & -1 & 10 \\\\ 4 & -10 & 2\\end{aligned}].$ Find a basis $B$ of $\\text{Col}(T).$" #edb/ref 17592186045417] [17592186442800 #edb/ref 1072 #uuid "826a5640-8f36-5e06-a060-8061b74d91af" #edb/ref 17592186045417] [17592186442800 #edb/ref 1074 "In order to find a basis of $\\text{Col}(T),$ we reduce the matrix $T$ to row echelon form:\n\n$$\n\\begin{aligned}T & =[\\begin{aligned}1 & -3 & 0 \\\\ 2 & -1 & 10 \\\\ 4 & -10 & 2\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 0 \\\\ 0 & 5 & 10 \\\\ 4 & -10 & 2\\end{aligned}] & {R}_{3} & :={R}_{3}+(-4){R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 0 \\\\ 0 & 5 & 10 \\\\ 0 & 2 & 2\\end{aligned}] & {R}_{3} & :={R}_{3}+(-\\frac{2}{5}){R}_{2} \\\\  & ∼[\\begin{aligned}1 & -3 & 0 \\\\ 0 & 5 & 10 \\\\ 0 & 0 & -2\\end{aligned}]\\end{aligned}\n$$\n\nThe pivot columns correspond to linearly independent vectors, while the non-pivot columns correspond to linearly dependent vectors that can be removed. Here, the $1$st, $2$nd and $3$rd columns are pivot columns.\n\nRemember that we need to pick the pivot columns from the *original matrix*, not from the reduced one. \n\nThe $1$st, $2$nd and $3$rd columns from the original matrix are ${t}_{1},$ ${t}_{2}$ and ${t}_{3}.$ So, a basis of $\\text{Col}(T)$ is $\\{{t}_{1},{t}_{2},{t}_{3}\\},$ that is to say, \n\n$$\nB=\\{[\\begin{aligned}1 \\\\ 2 \\\\ 4\\end{aligned}],[\\begin{aligned}-3 \\\\ -1 \\\\ -10\\end{aligned}],[\\begin{aligned}0 \\\\ 10 \\\\ 2\\end{aligned}]\\}.\n$$" #edb/ref 17592186045417] [17592186442801 #edb/ref 1068 #edb/ref 17592186442798 #edb/ref 17592186045417] [17592186442801 #edb/ref 1069 "q-111202" #edb/ref 17592186045417] [17592186442801 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186442801 #edb/ref 1071 "Consider the matrix \n$T=[\\begin{aligned}1 & -1 & 2 \\\\ 3 & -7 & 2 \\\\ -9 & 17 & -10\\end{aligned}].$ Find a basis $B$ of $\\text{Col}(T).$" #edb/ref 17592186045417] [17592186442801 #edb/ref 1072 #uuid "8d9f1369-e16d-5498-abf4-50e74407ebff" #edb/ref 17592186045417] [17592186442801 #edb/ref 1074 "In order to find a basis of $\\text{Col}(T),$ we reduce the matrix $T$ to row echelon form:\n\n$$\n\\begin{aligned}T & =[\\begin{aligned}1 & -1 & 2 \\\\ 3 & -7 & 2 \\\\ -9 & 17 & -10\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 \\\\ 0 & -4 & -4 \\\\ -9 & 17 & -10\\end{aligned}] & {R}_{3} & :={R}_{3}+9{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 \\\\ 0 & -4 & -4 \\\\ 0 & 8 & 8\\end{aligned}] & {R}_{3} & :={R}_{3}+2{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 \\\\ 0 & -4 & -4 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe pivot columns correspond to linearly independent vectors, while the non-pivot columns correspond to linearly dependent vectors that can be removed. Here, the $1$st and $2$nd columns are pivot columns, while the $3$rd column is a non-pivot column.\n\nRemember that we need to pick the pivot columns from the *original matrix*, not from the reduced one. \n\nThe $1$st and $2$nd columns from the original matrix are ${t}_{1}$ and ${t}_{2}.$ So, a basis of $\\text{Col}(T)$ is $\\{{t}_{1},{t}_{2}\\},$ that is to say, \n\n$$\nB=\\{[\\begin{aligned}1 \\\\ 3 \\\\ -9\\end{aligned}],[\\begin{aligned}-1 \\\\ -7 \\\\ 17\\end{aligned}]\\}.\n$$" #edb/ref 17592186045417] [17592186442802 #edb/ref 1068 #edb/ref 17592186442795 #edb/ref 17592186045417] [17592186442802 #edb/ref 1069 "q-111511" #edb/ref 17592186045417] [17592186442802 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186442802 #edb/ref 1071 "The matrix $H$ is given below. Let ${h}_{1}$, ${h}_{2}$,  ${h}_{3}$ and ${h}_{4}$ be the respective columns of $H.$\nDetermine if $B=\\text{{}{h}_{1},{h}_{3}\\text{}}$ is a basis of $\\text{Col}(H).$ \nIf that is the case, find ${x}_{1}\\cdot {x}_{3}$, where ${h}_{4}={x}_{1}{h}_{1}+{x}_{3}{h}_{3}.$ \n\n$$\nH=[\\begin{aligned}1 & -2 & 1 & 0 \\\\ 2 & -6 & 0 & -6 \\\\ -7 & 18 & -3 & 13\\end{aligned}]\n$$" #edb/ref 17592186045417] [17592186442802 #edb/ref 1072 #uuid "fb8ab0b6-52ad-56fe-b865-4fa731f7308c" #edb/ref 17592186045417] [17592186442802 #edb/ref 1074 "First, we reduce the matrix $H$ to reduced row echelon form (RREF):\n\n$$\n\\begin{aligned}H & =[\\begin{aligned}1 & -2 & 1 & 0 \\\\ 2 & -6 & 0 & -6 \\\\ -7 & 18 & -3 & 13\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 1 & 0 \\\\ 0 & -2 & -2 & -6 \\\\ -7 & 18 & -3 & 13\\end{aligned}] & {R}_{3} & :={R}_{3}+7{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 1 & 0 \\\\ 0 & -2 & -2 & -6 \\\\ 0 & 4 & 4 & 13\\end{aligned}] & {R}_{3} & :=(-\\frac{1}{2}){R}_{3} \\\\  & ∼[\\begin{aligned}1 & -2 & 1 & 0 \\\\ 0 & 1 & 1 & 3 \\\\ 0 & 4 & 4 & 13\\end{aligned}] & {R}_{3} & :={R}_{3}+(-4){R}_{2} \\\\  & ∼[\\begin{aligned}1 & -2 & 1 & 0 \\\\ 0 & 1 & 1 & 3 \\\\ 0 & 0 & 0 & 1\\end{aligned}]\\end{aligned}\n$$\n\nFrom the matrix above, we see that the pivot columns are the $1$st, $2$nd, and $4$th columns. So, a basis of $\\text{Col}(H)$ is $\\{{h}_{1},{h}_{2},{h}_{4}\\}.$ \n\nTherefore, we conclude that $B=\\{{h}_{1},{h}_{3}\\}$ is not a basis of $\\text{Col}(H).$" #edb/ref 17592186045417]}
