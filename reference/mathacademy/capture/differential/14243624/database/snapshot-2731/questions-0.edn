a-571a-822c-2948c4126d42" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448106} {:answer/id #uuid "ab2c8761-cb24-5c49-baab-a2303bc03a42" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448107}] :answer-field/correct {:answer/id #uuid "ab2c8761-cb24-5c49-baab-a2303bc03a42" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448107} :answer-field/id #uuid "74100c42-d4be-5d17-996f-41cc6eef4ed8" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449093} {:answer-field/choices [{:answer/id #uuid "742b2bf0-8afb-5164-a377-5d2ea7896302" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448108} {:answer/id #uuid "cbe1f184-21ca-5a30-a4b4-e7e2d07489d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448109}] :answer-field/correct {:answer/id #uuid "cbe1f184-21ca-5a30-a4b4-e7e2d07489d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448109} :answer-field/id #uuid "5180f33c-1f08-53df-8b94-f11a41c22fc6" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449094}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dc49fe00-4ce7-5ef1-a571-3c5c05755fd2" :question/math-academy-id "q-1212" :question/problem "Which of the following statements are true for the sets $A={x\\in N∣-1\\le x+1\\le 3}$ and $B={x\\in Z∣{x}^{2}\\le -2}?$\n\nSelect all that apply.\n\n- **I.** $A⊆B$\n- **II.** $A⊈B$\n- **III.** $B⊆A$\n- **IV.** $A⊇B$" :question/worked-solution "First, we must find the elements of the sets $A$ and $B.$\n\n- The elements of the set $A$ are all the natural numbers that satisfy the inequality $-1\\le x+1\\le 3,$ that is to say, $-2\\le x\\le 2.$ So, we have\n\n$$\nA={1,2}.\n$$\n\n- On the other hand, the elements of the set $B$ are all integers that satisfy the inequality ${x}^{2}\\le -2.$ So, we have\n\n$$\nB=∅.\n$$\n\nNow, let's inspect the given statements.\n\n- $A⊆B$ is false, while $A⊈B$ is true. For example, $0\\in A$ but $0\\notin B.$\n\n- $B⊆A$ is true. The empty set is a subset of every set.\n\n- $A⊇B$ is equivalent to $B⊆A,$ which is true.\n\nTherefore, the correct answer is \"II, III, and IV only.\""}] [{:db/id #edb/ref 17592186561047 :knowledge-point/_questions [{:db/id #edb/ref 17592186054632 :knowledge-point/id #uuid "495f3da0-849a-589d-ac88-26d6825445e4" :knowledge-point/title "Identifying True Statements About Subsets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c888f0e-54ba-51cb-a28f-bb550f2ccfe7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186560393} {:answer/id #uuid "3346d54c-0156-5635-a6e1-8679f717dab0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, III, and IV only" :db/id #edb/ref 17592186560479} {:answer/id #uuid "45a3acd8-8fac-5480-9456-949aed4deb1a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186560518} {:answer/id #uuid "69a3d84c-451e-565a-a9c3-67039d27f8ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186560585} {:answer/id #uuid "69e94d24-ed64-50bd-9e61-d489a3365853" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and IV only" :db/id #edb/ref 17592186560587}] :answer-field/correct {:answer/id #uuid "3346d54c-0156-5635-a6e1-8679f717dab0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, III, and IV only" :db/id #edb/ref 17592186560479} :answer-field/id #uuid "d3b7eed1-707d-5cdf-8d4a-2b44d5dd6b20" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186560955}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ca4e5acb-c615-5b3e-863b-498834fef823" :question/math-academy-id "q-37262" :question/problem "Which of the following statements are true for the sets $A=\\{n\\in N∣n+1\\ge 2\\}$ and $B=\\{n\\in Z∣n-1\\ge -2\\}?$\n\nI. $A⊆B$\n\nII. $∅⊈A$\n\nIII. $B⊈A$\n\nIV. $B⊇A$" :question/worked-solution "First, we must find the elements of the sets $A$ and $B.$\n\n- The elements of the set $A$ are all the natural numbers that satisfy the inequality $n+1\\ge 2,$ that is to say, $n\\ge 1.$ So, we have\n\n$$\nA=\\{1,2,3,4,5,6,…\\}.\n$$\n\n- On the other hand, the elements of the set $B$ are all integers that satisfy the inequality $n-1\\ge -2,$ That is to say, $n\\ge -1.$ So, we have\n\n$$\nB=\\{-1,0,1,2,3,4,5,…\\}.\n$$\n\nNow, let's inspect the given statements.\n\n- $A⊆B$ is true. Every element in the set $A$ is an element of the set $B.$\n\n- $∅⊈A$ is false. The null set $∅=\\{\\}$ is a subset of *every* set.\n\n- $B⊈A$ is true. For example, $0\\in B$ but $0\\notin A.$\n\n- $B⊇A$ is equivalent to $A⊆B,$ which is true.\n\nTherefore, the correct answer is \"I, III, and IV only.\""}] [{:db/id #edb/ref 17592186323898 :knowledge-point/_questions [{:db/id #edb/ref 17592186054632 :knowledge-point/id #uuid "495f3da0-849a-589d-ac88-26d6825445e4" :knowledge-point/title "Identifying True Statements About Subsets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89f21c4a-93c8-548f-8c4d-bb755dd17e33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450586} {:answer/id #uuid "958c3be8-463c-5ec4-b871-935267f79fb4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450587}] :answer-field/correct {:answer/id #uuid "958c3be8-463c-5ec4-b871-935267f79fb4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450587} :answer-field/id #uuid "b95ab62e-0d04-5f23-9890-187fec1efb3e" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451247} {:answer-field/choices [{:answer/id #uuid "42cba8ed-d55d-56ec-9d4b-efd82f796bf7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450588} {:answer/id #uuid "a9202d2e-57a2-5dbf-b710-5def44bb60cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450589}] :answer-field/correct {:answer/id #uuid "42cba8ed-d55d-56ec-9d4b-efd82f796bf7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450588} :answer-field/id #uuid "92cdc7f5-a8ce-58c6-856d-34aeff58a258" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451248} {:answer-field/choices [{:answer/id #uuid "1448a45b-9aa9-5235-8ea8-b5e74cbfc4fb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450590} {:answer/id #uuid "aa1e20a3-2d00-5edc-82dd-cccb7dfe1f31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450591}] :answer-field/correct {:answer/id #uuid "aa1e20a3-2d00-5edc-82dd-cccb7dfe1f31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450591} :answer-field/id #uuid "f8e4a50c-b87c-5e4d-88a1-e33c5b57c607" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451249} {:answer-field/choices [{:answer/id #uuid "52a72544-303f-5a4c-a46c-e62d55037959" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450592} {:answer/id #uuid "ad86dbb3-f60e-5466-800f-47012e2a976c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450593}] :answer-field/correct {:answer/id #uuid "ad86dbb3-f60e-5466-800f-47012e2a976c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450593} :answer-field/id #uuid "e6475119-a024-5d8a-8708-d3d59741c388" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451250}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ac9d3f90-ae5f-56ba-9210-f0c988989a62" :question/math-academy-id "q-37267" :question/problem "Which of the following statements are true for the sets $A={5,10,15,20,25,30,35,…}$ and $B={5n∣n\\in N,3\\le n\\le 7}?$\n\nSelect all that apply.\n\n- **I.** $B⊆A$\n- **II.** $A⊆B$\n- **III.** $A⊈B$\n- **IV.** $A⊇B$" :question/worked-solution "First, we must find the elements of the set $B.$ Substituting the values $n\\in {3,4,5,6,7}$ into the formula $5n,$ we get the following elements:\n\n$$\n\\begin{aligned}n=3 & \\,⇒\\,5(3)=15 \\\\ n=4 & \\,⇒\\,5(4)=20 \\\\ n=5 & \\,⇒\\,5(5)=25 \\\\ n=6 & \\,⇒\\,5(6)=30 \\\\ n=7 & \\,⇒\\,5(7)=35\\end{aligned}\n$$\n\nSo, we have\n\n$$\nB={15,20,25,30,35}.\n$$\n\nNow, let's inspect the given statements.\n\n- $B⊆A$ is true. Every element in the set $B$ is an element of the set $A.$\n\n- $A⊆B$ is false, while $A⊈B$ is true. For example, $5\\in A$ but $5\\notin B.$\n\n- $A⊇B$ is equivalent to $B⊆A,$ which is true.\n\nTherefore, the correct answer is \"I, III, and IV only\"."}] [{:db/id #edb/ref 17592186055352 :knowledge-point/_questions [{:db/id #edb/ref 17592186054631 :knowledge-point/id #uuid "9b7f1d12-3335-5dd7-bf36-e07077d0c45d" :knowledge-point/title "Identifying Subsets of Special Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "826ec734-e316-5072-b417-11f281b06bbd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186053350} {:answer/id #uuid "9c5f376e-e23f-5366-a479-685790173a72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186053351} {:answer/id #uuid "196b7f9e-16c0-51ec-8d81-78ef067bc7ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186053352} {:answer/id #uuid "3ba4444c-9934-5c54-811f-d05da1bce6da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186053353} {:answer/id #uuid "7c08dbd0-5551-5aba-b843-5e3ce6f01512" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186053354}] :answer-field/correct {:answer/id #uuid "196b7f9e-16c0-51ec-8d81-78ef067bc7ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186053352} :answer-field/id #uuid "3157dead-ae40-519f-9128-17d0e2527dfd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186053349}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c377d903-348b-5206-96c1-78c4296236ca" :question/math-academy-id "q-498" :question/problem "Which of the following are subsets of ${Q}_{0}^{+}$ (the set of non-negative rational numbers)?\n\nI. $Z$\n\nII. ${Z}^{+}$ (the set of positive integers)\n\nIII. $N$" :question/worked-solution "$A$ is a subset of $B$ if every element of $A$ is an element of $B.$\n\nWith that in mind, let's inspect the given choices.\n\n- $Z$ is *not* a subset of ${Q}_{0}^{+}.$ For example, $-1\\in Z$ but $-1\\notin {Q}_{0}^{+}.$\n\n- ${Z}^{+}$ is  a subset of ${Q}_{0}^{+}.$ Every positive integer is a positive rational number.\n\n- $N$ a subset of ${Q}_{0}^{+}.$ Every natural number is a positive rational number.\n\nTherefore, the correct answer is \"II and III only\"."}] [{:db/id #edb/ref 17592186351156 :knowledge-point/_questions [{:db/id #edb/ref 17592186054630 :knowledge-point/id #uuid "3cbddaef-3828-5454-b892-26a3c6242ddb" :knowledge-point/title "Finding All Subsets of a Given Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09f325bf-d24d-50fd-80d6-30c09ae04436" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅,\\{10\\},\\{20\\},\\{10,20\\}" :db/id #edb/ref 17592186560384} {:answer/id #uuid "41312684-7225-5ecc-8e04-52bdce722210" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅,\\{10,20\\}" :db/id #edb/ref 17592186560509} {:answer/id #uuid "6d1762ad-5abf-509d-8ce1-df3d1de97be1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{10\\},\\{20\\}" :db/id #edb/ref 17592186560595} {:answer/id #uuid "9d6db429-81a1-5bdc-a59a-56dfc564feb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅,\\{10\\},\\{20\\}" :db/id #edb/ref 17592186560686} {:answer/id #uuid "f1ba747c-3f06-595b-88ee-b1df82b6a1d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{10\\},\\{20\\},\\{10,20\\}" :db/id #edb/ref 17592186560840}] :answer-field/correct {:answer/id #uuid "09f325bf-d24d-50fd-80d6-30c09ae04436" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅,\\{10\\},\\{20\\},\\{10,20\\}" :db/id #edb/ref 17592186560384} :answer-field/id #uuid "03099ae6-3de2-5dfa-8e06-fab7b23bdf08" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350710}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c97b5b71-71aa-5c9f-b66b-7c0744f33544" :question/math-academy-id "q-80807" :question/problem "Find all of the subsets of $P=\\{10,20\\}.$" :question/worked-solution "To find every subset of $P,$ we list out every combination of elements within $P.$ \n\nWe can use the following diagram to visualize the process:\n\n![](images/17/17d796ca9f78e72d15b6f29565d03a5ea42c1e2fe544acd02bc3f368993cdb9c.png)\n\nNote that we must include the empty set, since it is a subset of every set.\n\nBy doing this, we get\n\n$$\n∅,\\{10\\},\\{20\\},\\{10,20\\}.\n$$"}] [{:db/id #edb/ref 17592186351157 :knowledge-point/_questions [{:db/id #edb/ref 17592186054630 :knowledge-point/id #uuid "3cbddaef-3828-5454-b892-26a3c6242ddb" :knowledge-point/title "Finding All Subsets of a Given Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13068f17-863c-5aa3-9c27-ce57020d0c6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\alpha \\},\\{\\beta \\},\\{\\gamma \\}" :db/id #edb/ref 17592186560404} {:answer/id #uuid "214b064c-638d-59ef-9137-43d6ee585849" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅,\\{\\alpha \\},\\{\\beta \\},\\{\\gamma \\},\\{\\alpha ,\\beta \\},\\{\\alpha ,\\gamma \\},\\{\\beta ,\\gamma \\},\\{\\alpha ,\\beta ,\\gamma \\}" :db/id #edb/ref 17592186560440} {:answer/id #uuid "52dfce89-f583-5d98-9b09-c1a1b5ba73cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅,\\{\\alpha \\},\\{\\beta \\},\\{\\gamma \\}" :db/id #edb/ref 17592186560545} {:answer/id #uuid "acf702c7-ec12-55e5-9ea2-3c9f8018fd1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\alpha ,\\beta ,\\gamma \\}" :db/id #edb/ref 17592186560712} {:answer/id #uuid "efc39038-dbcd-5c31-978e-91bf59c387b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\alpha ,\\beta \\},\\{\\alpha ,\\gamma \\},\\{\\beta ,\\gamma \\}" :db/id #edb/ref 17592186560833}] :answer-field/correct {:answer/id #uuid "214b064c-638d-59ef-9137-43d6ee585849" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅,\\{\\alpha \\},\\{\\beta \\},\\{\\gamma \\},\\{\\alpha ,\\beta \\},\\{\\alpha ,\\gamma \\},\\{\\beta ,\\gamma \\},\\{\\alpha ,\\beta ,\\gamma \\}" :db/id #edb/ref 17592186560440} :answer-field/id #uuid "daa3978b-121f-5e14-b3b5-4e9953584269" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186351087}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dd5b17e8-78b5-59d5-b563-f6d50839e764" :question/math-academy-id "q-80808" :question/problem "Find all of the subsets of $Q=\\{\\alpha ,\\beta ,\\gamma \\}.$" :question/worked-solution "To find every subset of $Q,$ we list out every combination of elements within $Q.$\n\nWe can use the following diagram to visualize the process: \n\n![](images/56/56d0ff0c0e539286b6c15496c7ad295008779f07f4e9132280c787b6303902c0.png)\n\nNote that we must include the empty set since it is a subset of every set.\n\nBy doing this, we get\n\n$$\n∅,\\{\\alpha \\},\\{\\beta \\},\\{\\gamma \\},\\{\\alpha ,\\beta \\},\\{\\alpha ,\\gamma \\},\\{\\beta ,\\gamma \\},\\{\\alpha ,\\beta ,\\gamma \\}.\n$$"}] [{:db/id #edb/ref 17592186561020 :knowledge-point/_questions [{:db/id #edb/ref 17592186054632 :knowledge-point/id #uuid "495f3da0-849a-589d-ac88-26d6825445e4" :knowledge-point/title "Identifying True Statements About Subsets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d638923-cecf-59a3-9dd7-95b010b744a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186560466} {:answer/id #uuid "3c91d41d-35ad-5cb1-8da6-37cb13223ce2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186560502} {:answer/id #uuid "40a33e13-388a-525b-83c0-b7ed6105ead4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186560508} {:answer/id #uuid "5b1b09ec-5afa-5e99-aefe-b392810acdae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186560560} {:answer/id #uuid "c7b00fd0-7905-5e65-91ef-6e0c3c8ffeca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186560762}] :answer-field/correct {:answer/id #uuid "40a33e13-388a-525b-83c0-b7ed6105ead4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186560508} :answer-field/id #uuid "b7fc5eab-4c18-5a60-8fc6-c5a0861c2c1b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186560942}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "83ab9b35-c1e3-561b-9f67-abfc0e8e8a12" :question/math-academy-id "q-80841" :question/problem "Which of the following statements are true for the sets $A=\\{x\\in Z∣-1\\le x+2\\le 3\\}$ and $B=\\{x\\in Z∣{x}^{2}<2\\}?$\n\nI. $A⊆B$\n\nII. $B⊆A$\n\nIII. $B⊈A$" :question/worked-solution "First, we must find the elements of the sets $A$ and $B.$\n\n- The elements of the set $A$ are all the integer numbers that satisfy the inequality $-1\\le x+2\\le 3,$ that is to say, $-3\\le x\\le 1.$ So, we have\n\n$$\nA=\\{-3,-2,-1,0,1\\}.\n$$\n\n- On the other hand, the elements of the set $B$ are all integers that satisfy the inequality ${x}^{2}<2.$ So, we have\n\n$$\nB=\\{-1,0,1\\}.\n$$\n\nNow, let's inspect the given statements.\n\n- $A⊆B$ is false. For example, $-3\\in A$ but $-3\\notin B.$\n\n- $B⊆A$ is true, while $B⊈A$ is false. Indeed, every element in the set $B$ is an element of the set $A.$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186561012 :knowledge-point/_questions [{:db/id #edb/ref 17592186054632 :knowledge-point/id #uuid "495f3da0-849a-589d-ac88-26d6825445e4" :knowledge-point/title "Identifying True Statements About Subsets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7691ae11-33ae-50a4-9eb9-de1fe4c7a7b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II, III, and IV only" :db/id #edb/ref 17592186560618} {:answer/id #uuid "7c845076-ba15-5a9d-9053-a6b2e603927f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186560631} {:answer/id #uuid "8b5ca774-da1f-5977-a4df-c5f8f5210f15" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186560654} {:answer/id #uuid "b44e18f7-ca2a-59c7-9fb7-f38f7527a958" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186560727} {:answer/id #uuid "ff813adc-a63d-5297-b77f-e5f9fcf4f554" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, III, and IV only" :db/id #edb/ref 17592186560863}] :answer-field/correct {:answer/id #uuid "7c845076-ba15-5a9d-9053-a6b2e603927f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186560631} :answer-field/id #uuid "84f2b8a0-f781-5fe2-ac9e-75c68e238f0f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186560920}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "713562a6-f85e-5713-a528-f52fb32799ee" :question/math-academy-id "q-80843" :question/problem "Which of the following statements are true for the sets $A=\\{x\\in N:x<5\\}$ and $B=\\{x\\in N:2x\\ge 4\\}?$\n\nI. $A⊆B$\n\nII. $B⊆A$\n\nIII. $∅⊆B$\n\nIV. $B⊇A$" :question/worked-solution "First, we must find the elements of the sets $A$ and $B.$\n\n- The elements of the set $A$ are all natural numbers less than $5.$ So,\n\n$$\nA=\\{1,2,3,4\\}.\n$$\n\n- On the other hand, the elements of the set $B$ are natural numbers which satisfy the inequality $2x\\ge 4,$ that is to say $x\\ge 2.$ So,\n\n$$\nB=\\{2,3,…\\}.\n$$\n\nNow, let's inspect the given statements.\n\n- $A⊆B$ is false. For example, $1\\in A$ but $1\\notin B.$\n\n- $B⊆A$ is false. For example, $5\\in B$ but $5\\notin A.$\n\n- $∅⊆B$ is true. The null set $∅=\\{\\}$ is a subset of *every* set.\n\n- $B⊇A$ is equivalent to $A⊆B,$ which is false.\n\nTherefore, the correct answer is \"III only.\""}]}
