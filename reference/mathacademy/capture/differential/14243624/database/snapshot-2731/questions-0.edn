#uuid "eb139d93-059f-53af-a8f9-6a747e8ff56b" :question/math-academy-id "q-105034" :question/problem "Which of the following are subsets of $R?$\n- **I.** ${Q}^{-}$ (the set of negative rationals)\n- **II.** ${Z}^{+}$ (the set of positive integers)\n- **III.** $N$\n\nSelect all that apply." :question/worked-solution "$A$ is a subset of $B$ if every element of $A$ is an element of $B.$\n\nWith that in mind, let's inspect the given choices.\n\n- ${Q}^{-}$ is  a subset of $R.$ Every negative rational number is a real number.\n\n- ${Z}^{+}$ is a subset of $R.$ Every positive integer number is a real number.\n\n- $N$ a subset of $R.$ Every natural number is a real number.\n\nTherefore, the correct answer is \"I, II and III\"."}] [{:db/id #edb/ref 17592186561007 :knowledge-point/_questions [{:db/id #edb/ref 17592186054631 :knowledge-point/id #uuid "9b7f1d12-3335-5dd7-bf36-e07077d0c45d" :knowledge-point/title "Identifying Subsets of Special Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fc727f2-c118-59d9-bef1-319f61ac67af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "N⊆R" :db/id #edb/ref 17592186560399} {:answer/id #uuid "4809c7b0-7a53-5da1-8ec2-403d36b43401" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R⊆Q" :db/id #edb/ref 17592186560521} {:answer/id #uuid "6d297646-3077-5fe0-8d3c-2ea9298474ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{Z}^{+}⊆R" :db/id #edb/ref 17592186560596} {:answer/id #uuid "b931012e-07aa-53b1-8019-98f569760f38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R⊆C" :db/id #edb/ref 17592186560732} {:answer/id #uuid "bfe47b9d-e35e-5bce-9bca-5d9133925e90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{Z}^{-}⊆Z" :db/id #edb/ref 17592186560748}] :answer-field/correct {:answer/id #uuid "4809c7b0-7a53-5da1-8ec2-403d36b43401" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R⊆Q" :db/id #edb/ref 17592186560521} :answer-field/id #uuid "2bad22a0-e25f-5db1-9827-75aee3ba7896" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186560879}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "68f004d9-140c-5382-893d-19e68749e384" :question/math-academy-id "q-105037" :question/problem "Which statement is **not** true?" :question/worked-solution "If $A⊆B,$ then $A$ is a subset of $B,$ meaning that every element of $A$ is an element of $B.$\n\nAmong the given choices, only $R⊆Q$ is not true. This statement is not true because not every real number is a rational number. For example, we have $\\sqrt{2}\\in R$ but $\\sqrt{2}\\notin Q.$"}] [{:db/id #edb/ref 17592186395707 :knowledge-point/_questions [{:db/id #edb/ref 17592186054629 :knowledge-point/id #uuid "b0e5efaa-e624-5045-abdb-cdf8d32ad6cb" :knowledge-point/title "Identifying Subsets of a Given Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c0dd0f7-8517-5c43-b3cc-91fa2f347f63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{a,b,e\\}" :db/id #edb/ref 17592186560459} {:answer/id #uuid "8d3a718a-2bb7-5907-a404-33cd62b364d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{a,b,c\\}" :db/id #edb/ref 17592186560657} {:answer/id #uuid "bf88cc96-4beb-53c3-8d61-7ee3c8a80c31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{a,c,d,e\\}" :db/id #edb/ref 17592186560746} {:answer/id #uuid "f092903b-bdb3-5018-bf0e-0c03096dc38b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{a\\}" :db/id #edb/ref 17592186560835} {:answer/id #uuid "f1982fbe-b3bc-5a6c-8be8-a4559f2eb965" :an