$\n\n- ${{20,22}}$ is a subset of $A.\\,✓$\n\n- ${{0},{6,9,15}}$ is *not* a subset of $A$ because it contains the element ${0}\\notin A.\\,\\times $\n\nTherefore, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186561055 :knowledge-point/_questions [{:db/id #edb/ref 17592186054629 :knowledge-point/id #uuid "b0e5efaa-e624-5045-abdb-cdf8d32ad6cb" :knowledge-point/title "Identifying Subsets of a Given Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c20d2ea-a078-5182-8b9b-d739fd141252" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{m\\}" :db/id #edb/ref 17592186560533} {:answer/id #uuid "58c01a46-245b-5bb5-a588-8f8f039d4dc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{l,s,t\\}" :db/id #edb/ref 17592186560556} {:answer/id #uuid "9187625c-647d-5cf9-88b5-38b1d05598c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{l,m,n,o\\}" :db/id #edb/ref 17592186560665} {:answer/id #uuid "b97eecbe-49a7-5c10-914d-836c6a1910ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{l,n,p,q\\}" :db/id #edb/ref 17592186560733} {:answer/id #uuid "f516e849-a622-5bf2-b219-219038892094" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{k,l,m\\}" :db/id #edb/ref 17592186560851}] :answer-field/correct {:answer/id #uuid "4c20d2ea-a078-5182-8b9b-d739fd141252" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{m\\}" :db/id #edb/ref 17592186560533} :answer-field/id #uuid "a3c54aaa-e710-577d-887e-02dcd32349b8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186560933}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e7899b45-120a-5ab1-97c8-2f3192dc7444" :que