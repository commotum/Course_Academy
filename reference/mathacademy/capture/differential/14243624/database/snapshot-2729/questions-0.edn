ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450592} {:answer/id #uuid "ad86dbb3-f60e-5466-800f-47012e2a976c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450593}] :answer-field/correct {:answer/id #uuid "ad86dbb3-f60e-5466-800f-47012e2a976c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450593} :answer-field/id #uuid "e6475119-a024-5d8a-8708-d3d59741c388" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451250}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ac9d3f90-ae5f-56ba-9210-f0c988989a62" :question/math-academy-id "q-37267" :question/problem "Which of the following statements are true for the sets $A={5,10,15,20,25,30,35,…}$ and $B={5n∣n\\in N,3\\le n\\le 7}?$\n\nSelect all that apply.\n\n- **I.** $B⊆A$\n- **II.** $A⊆B$\n- **III.** $A⊈B$\n- **IV.** $A⊇B$" :question/worked-solution "First, we must find the elements of the set $B.$ Substituting the values $n\\in {3,4,5,6,7}$ into the formula $5n,$ we get the following elements:\n\n$$\n\\begin{aligned}n=3 & \\,⇒\\,5(3)=15 \\\\ n=4 & \\,⇒\\,5(4)=20 \\\\ n=5 & \\,⇒\\,5(5)=25 \\\\ n=6 & \\,⇒\\,5(6)=30 \\\\ n=7 & \\,⇒\\,5(7)=35\\end{aligned}\n$$\n\nSo, we have\n\n$$\nB={15,20,25,30,35}.\n$$\n\nNow, let's inspect the given statements.\n\n- $B⊆A$ is true. Every element in the set $B$ is an element of the set $A.$\n\n- $A⊆B$ is false, while $A⊈B$ is true. For example, $5\\in A$ but $5\\notin B.$\n\n- $A⊇B$ is equivalent to $B⊆A,$ which is true.\n\nTherefore, the correct answer is \"I, III, and IV only\"."}] [{:db/id #edb/ref 17592186055352 :knowledge-point/_questions [{:db/id #edb/ref 17592186054631 :knowledge-point/id #uuid "9b7f1d12-3335-5dd7-bf36-e07077d0c45d" :knowledge-point/title "Identifying Subsets of Special Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "826ec734-e316-5072-b417-11f281b06bbd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186053350} {:answer/id #uuid "9c5f376e-e23f-5366-a479-685790173a72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186053351} {:answer/id #uuid "196b7f9e-16c0-51ec-8d81-78ef067bc7ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186053352} {:answer/id #uuid "3ba4444c-9934-5c54-811f-d05da1bce6da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186053353} {:answer/id #uuid "7c08dbd0-5551-5aba-b843-5e3ce6f01512" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186053354}] :answer-field/id #uuid "3157dead-ae40-519f-9128-17d0e2527dfd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186053349}] :question/id #uuid "c377d903-348b-5206-96c1-78c4296236ca" :question/math-academy-id "q-498" :question/problem "Which of the following are subsets of $Q_{0}^{+}$ (the set of non-negative rational numbers)?\n\n1. $Z$\n2. $Z^{+}$ (the set of positive integers)\n3. $N$"}] [{:db/id #edb/ref 17592186351156 :knowledge-point/_questions [{:db/id #edb/ref 17592186054630 :knowledge-point/id #uuid "3cbddaef-3828-5454-b892-26a3c6242ddb" :knowledge-point/title "Finding All Subsets of a Given Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33b254c7-6497-5d0b-ae56-3a0bf0e0e36f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅,{10},{20}" :db/id #edb/ref 17592186348910} {:answer/id #uuid "a5bad288-8230-5c40-b35b-c0cb14a3e988" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{10},{20}" :db/id #edb/ref 17592186349923} {:answer/id #uuid "c8b3650a-b5c2-59d2-b4f1-1d5e4122400d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅,{10,20}" :db/id #edb/ref 17592186350213} {:answer/id #uuid "f6b283ac-f183-5104-b65e-1303a4fb0d80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{10},{20},{10,20}" :db/id #edb/ref 17592186350606} {:answer/id #uuid "f71a0951-1d16-58be-a27c-722c7401b195" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅,{10},{20},{10,20}" :db/id #edb/ref 17592186350612}] :answer-field/correct {:answer/id #uuid "f71a0951-1d16-58be-a27c-722c7401b195" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅,{10},{20},{10,20}" :db/id #edb/ref 17592186350612} :answer-field/id #uuid "03099ae6-3de2-5dfa-8e06-fab7b23bdf08" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350710}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c97b5b71-71aa-5c9f-b66b-7c0744f33544" :question/math-academy-id "q-80807" :question/problem "Find all of the subsets of $P={10,20}.$" :question/worked-solution "To find every subset of $P,$ we list out every combination of elements within $P.$ \n\nWe can use the following diagram to visualize the process:\n\n![](images/17/17d796ca9f78e72d15b6f29565d03a5ea42c1e2fe544acd02bc3f368993cdb9c.png)\n\nNote that we must include the empty set, since it is a subset of every set.\n\nBy doing this, we get\n\n$$\n∅,{10},{20},{10,20}.\n$$"}] [{:db/id #edb/ref 17592186351157 :knowledge-point/_questions [{:db/id #edb/ref 17592186054630 :knowledge-point/id #uuid "3cbddaef-3828-5454-b892-26a3c6242ddb" :knowledge-point/title "Finding All Subsets of a Given Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2df04b11-8757-5bc3-85f1-6d21a468cea3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅,{\\alpha },{\\beta },{\\gamma },{\\alpha ,\\beta },{\\alpha ,\\gamma },{\\beta ,\\gamma },{\\alpha ,\\beta ,\\gamma }" :db/id #edb/ref 17592186348850} {:answer/id #uuid "39205fe0-16ac-5121-9ef1-e7269a8e8e16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\alpha },{\\beta },{\\gamma }" :db/id #edb/ref 17592186348962} {:answer/id #uuid "4b6c7455-2819-5ec2-bab9-4c45a8e99c57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\alpha ,\\beta ,\\gamma }" :db/id #edb/ref 17592186349137} {:answer/id #uuid "52d82e07-19c5-5373-a67b-69c115cdcad9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\alpha ,\\beta },{\\alpha ,\\gamma },{\\beta ,\\gamma }" :db/id #edb/ref 17592186349201} {:answer/id #uuid "5edd0fb3-710e-54dc-9fa4-6eb0cf68c1bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅,{\\alpha },{\\beta },{\\gamma }" :db/id #edb/ref 17592186349318}] :answer-field/correct {:answer/id #uuid "2df04b11-8757-5bc3-85f1-6d21a468cea3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅,{\\alpha },{\\beta },{\\gamma },{\\alpha ,\\beta },{\\alpha ,\\gamma },{\\beta ,\\gamma },{\\alpha ,\\beta ,\\gamma }" :db/id #edb/ref 17592186348850} :answer-field/id #uuid "daa3978b-121f-5e14-b3b5-4e9953584269" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186351087}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dd5b17e8-78b5-59d5-b563-f6d50839e764" :question/math-academy-id "q-80808" :question/problem "Find all of the subsets of $Q={\\alpha ,\\beta ,\\gamma }.$" :question/worked-solution "To find every subset of $Q,$ we list out every combination of elements within $Q.$\n\nWe can use the following diagram to visualize the process: \n\n![](images/56/56d0ff0c0e539286b6c15496c7ad295008779f07f4e9132280c787b6303902c0.png)\n\nNote that we must include the empty set since it is a subset of every set.\n\nBy doing this, we get\n\n$$\n∅,{\\alpha },{\\beta },{\\gamma },{\\alpha ,\\beta },{\\alpha ,\\gamma },{\\beta ,\\gamma },{\\alpha ,\\beta ,\\gamma }.\n$$"}]}
