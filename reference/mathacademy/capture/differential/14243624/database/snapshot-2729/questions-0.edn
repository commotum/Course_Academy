t/id #uuid "3cbddaef-3828-5454-b892-26a3c6242ddb" :knowledge-point/title "Finding All Subsets of a Given Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b4a3183-69f6-5f5d-a9e1-c1e072a1f24c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅,\\{x\\},\\{y\\},\\{z\\}\\{x,y,z\\}" :db/id #edb/ref 17592186422817} {:answer/id #uuid "6ff14b5d-188a-55a7-affd-519f5a9ab5e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅,\\{x\\},\\{y\\},\\{z\\},\\{x,y\\},\\{x,z\\},\\{y,z\\}" :db/id #edb/ref 17592186422820} {:answer/id #uuid "73b56506-163b-5f00-81f1-df59bf19d5ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅,\\{x\\},\\{y\\},\\{z\\}" :db/id #edb/ref 17592186422823} {:answer/id #uuid "8dba51cf-7500-588f-9ddc-13c1238ad685" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅,\\{x\\},\\{y\\},\\{z\\},\\{x,y\\},\\{x,z\\},\\{y,z\\},\\{x,y,z\\}" :db/id #edb/ref 17592186422844} {:answer/id #uuid "adaade65-0ace-5c85-9f33-9af310f49494" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{x\\},\\{y\\},\\{z\\}" :db/id #edb/ref 17592186422876}] :answer-field/correct {:answer/id #uuid "8dba51cf-7500-588f-9ddc-13c1238ad685" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅,\\{x\\},\\{y\\},\\{z\\},\\{x,y\\},\\{x,z\\},\\{y,z\\},\\{x,y,z\\}" :db/id #edb/ref 17592186422844} :answer-field/id #uuid "94357139-827d-5170-82dc-cc21ec831009" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253065}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4dc7abe5-6826-51d9-82bd-d471faabcb9f" :question/math-academy-id "q-1191" :question/problem "Find all of the subsets of $A=\\{x,y,z\\}.$" :question/worked-solution "To find every subset of $A,$ we list out every combination of elements within $A.$\n\nWe can use the following diagram to visualize the process:\n\n![](images/1d/1d7c11586a8fff5f63d46d936fd32c7b5fbfc33a406ddf268bfdd934fe787cdf.png)\n\nNote that we must include the empty set since it is a subset of every set.\n\nBy doing this, we get\n\n$$\n∅,\\{x\\},\\{y\\},\\{z\\},\\{x,y\\},\\{x,z\\},\\{y,z\\},\\{x,y,z\\}.\n$$"}] [{:db/id #edb/ref 17592186395721 :knowledge-point/_questions [{:db/id #edb/ref 17592186054631 :knowledge-point/id #uuid "9b7f1d12-3335-5dd7-bf36-e07077d0c45d" :knowledge-point/title "Identifying Subsets of Special Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6bd69dee-1a90-5731-909e-bf193606c3f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R⊆R" :db/id #edb/ref 17592186395723} {:answer/id #uuid "ef9e9860-9681-5612-8906-739b929d5dd1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Q⊆R" :db/id #edb/ref 17592186395724} {:answer/id #uuid "326b432e-d3d4-56b8-9641-51af48c34b1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{Z}^{+}⊆Z" :db/id #edb/ref 17592186395725} {:answer/id #uuid "1d8512ed-f553-5147-af6d-509a075c0b1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Z⊆R" :db/id #edb/ref 17592186395726} {:answer/id #uuid "0d38cc69-4692-5308-aef1-5edd65a60ef8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "C⊆Z" :db/id #edb/ref 17592186395727}] :answer-field/correct {:answer/id #uuid "0d38cc69-4692-5308-aef1-5edd65a60ef8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "C⊆Z" :db/id #edb/ref 17592186395727} :answer-field/id #uuid "2de47cf9-4ba6-564d-8b13-dc2ae4c1b836" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395722}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "23e8510c-99c3-539c-9c30-63245db2572b" :question/math-academy-id "q-1208" :question/problem "Which statement is **not** true?" :question/worked-solution "If $A⊆B,$ then $A$ is a subset of $B,$ meaning that every element of $A$ is an element of $B.$\n\nAmong the given choices, only $C⊆Z$ is not true. This statement is not true because not every complex is an integer number. For example, we have $2\\text{i}\\in C$ but $2\\text{i}\\notin Z.$"}] [{:db/id #edb/ref 17592186256520 :knowledge-point/_questions [{:db/id #edb/ref 17592186054632 :knowledge-point/id #uuid "495f3da0-849a-589d-ac88-26d6825445e4" :knowledge-point/title "Identifying True Statements About Subsets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4dc7a6c2-ba2d-58fe-9809-c8a2e62ab9a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448102} {:answer/id #uuid "f83abbc0-81b1-5423-9411-39e57332b5b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448103}] :answer-field/correct {:answer/id #uuid "4dc7a6c2-ba2d-58fe-9809-c8a2e62ab9a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448102} :answer-field/id #uuid "eddaff1a-a5b2-51f6-a80b-b6a66ebde808" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449091} {:answer-field/choices [{:answer/id #uuid "2baba46a-66d2-585e-b78c-e1a30ee1baba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448104} {:answer/id #uuid "80bf77cc-25ad-5cef-aea0-a44fb7faa19d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448105}] :answer-field/correct {:answer/id #uuid "80bf77cc-25ad-5cef-aea0-a44fb7faa19d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448105} :answer-field/id #uuid "fbe1673a-1e7f-52d0-8675-b7d65b4462e2" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449092} {:answer-field/choices [{:answer/id #uuid "441afc09-6aea-571a-822c-2948c4126d42" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448106} {:answer/id #uuid "ab2c8761-cb24-5c49-baab-a2303bc03a42" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448107}] :answer-field/correct {:answer/id #uuid "ab2c8761-cb24-5c49-baab-a2303bc03a42" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448107} :answer-field/id #uuid "74100c42-d4be-5d17-996f-41cc6eef4ed8" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449093} {:answer-field/choices [{:answer/id #uuid "742b2bf0-8afb-5164-a377-5d2ea7896302" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448108} {:answer/id #uuid "cbe1f184-21ca-5a30-a4b4-e7e2d07489d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448109}] :answer-field/correct {:answer/id #uuid "cbe1f184-21ca-5a30-a4b4-e7e2d07489d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448109} :answer-field/id #uuid "5180f33c-1f08-53df-8b94-f11a41c22fc6" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449094}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dc49fe00-4ce7-5ef1-a571-3c5c05755fd2" :question/math-academy-id "q-1212" :question/problem "Which of the following statements are true for the sets $A={x\\in N∣-1\\le x+1\\le 3}$ and $B={x\\in Z∣{x}^{2}\\le -2}?$\n\nSelect all that apply.\n\n- **I.** $A⊆B$\n- **II.** $A⊈B$\n- **III.** $B⊆A$\n- **IV.** $A⊇B$" :question/worked-solution "First, we must find the elements of the sets $A$ and $B.$\n\n- The elements of the set $A$ are all the natural numbers that satisfy the inequality $-1\\le x+1\\le 3,$ that is to say, $-2\\le x\\le 2.$ So, we have\n\n$$\nA={1,2}.\n$$\n\n- On the other hand, the elements of the set $B$ are all integers that satisfy the inequality ${x}^{2}\\le -2.$ So, we have\n\n$$\nB=∅.\n$$\n\nNow, let's inspect the given statements.\n\n- $A⊆B$ is false, while $A⊈B$ is true. For example, $0\\in A$ but $0\\notin B.$\n\n- $B⊆A$ is true. The empty set is a subset of every set.\n\n- $A⊇B$ is equivalent to $B⊆A,$ which is true.\n\nTherefore, the correct answer is \"II, III, and IV only.\""}] [{:db/id #edb/ref 17592186323898 :knowledge-point/_questions [{:db/id #edb/ref 17592186054632 :knowledge-point/id #uuid "495f3da0-849a-589d-ac88-26d6825445e4" :knowledge-point/title "Identifying True Statements About Subsets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89f21c4a-93c8-548f-8c4d-bb755dd17e33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450586} {:answer/id #uuid "958c3be8-463c-5ec4-b871-935267f79fb4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450587}] :answer-field/correct {:answer/id #uuid "958c3be8-463c-5ec4-b871-935267f79fb4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :