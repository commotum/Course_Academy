  "live_records": {
    "q-1188": {
      "dom_id": "step-q1188",
      "name": "Question 1",
      "problem": "Which set is a subset of $B=\\{a,b,c,f\\}?$",
      "worked_solution": "A set is a subset of $B$ if all its elements are elements of $B.$\n\nOf the given sets, only $\\{c,f\\}$ has all of its elements in $B.$\n\nTherefore, $\\{c,f\\}$ is a subset of $B.$",
