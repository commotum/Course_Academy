#{[{:db/id #edb/ref 17592186250242 :knowledge-point/_questions [{:db/id #edb/ref 17592186064274 :knowledge-point/id #uuid "d3aaba0a-3b86-58c3-bbc8-22ced09bc8a8" :knowledge-point/title "Computing a Definite Integral Using Integration by Parts"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d83e583-d218-50f4-abb7-474c6d01c304" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}+\\frac{1}{3}" :db/id #edb/ref 17592186247546} {:answer/id #uuid "3d047995-440b-51a6-837d-6a9c0a9dea33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{3}+\\frac{1}{9}" :db/id #edb/ref 17592186247961} {:answer/id #uuid "4217347b-9b32-5330-8c51-bcd370f084c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{6}-\\frac{1}{9}" :db/id #edb/ref 17592186248013} {:answer/id #uuid "8c7776ae-27e1-5fb2-91d8-1d3d11b460fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{6}+\\frac{1}{3}" :db/id #edb/ref 17592186248680} {:answer/id #uuid "aea67226-a698-5829-a7e0-c9089694e776" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}-\\frac{1}{6}" :db/id #edb/ref 17592186248983}] :answer-field/correct {:answer/id #uuid "4217347b-9b32-5330-8c51-bcd370f084c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{6}-\\frac{1}{9}" :db/id #edb/ref 17592186248013} :answer-field/id #uuid "4ff430e6-479c-5fff-ae3c-19a79a5cfe3a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249818}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "37affd24-3b4f-536c-8927-723157249685" :question/math-academy-id "q-114328" :question/problem "${\\int }_{0}^{\\pi /2}x\\operatorname{cos}⁡(3x)\\,\\text{d}x=$" :question/worked-solution "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=x & ⇒ & {u}^{′}=1 \\\\ {v}^{′}=\\operatorname{cos}⁡(3x) & ⇒ & v=\\frac{\\operatorname{sin}⁡(3x)}{3}.\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int x\\cdot \\operatorname{cos}⁡(3x)\\,\\text{d}x & =x\\cdot \\frac{\\operatorname{sin}⁡(3x)}{3}-\\int \\frac{\\operatorname{sin}⁡(3x)}{3}\\cdot 1\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}x\\operatorname{cos}⁡(3x)\\,\\text{d}x & ={\\frac{x\\operatorname{sin}⁡(3x)}{3}|}_{0}^{\\pi /2}-{\\int }_{0}^{\\pi /2}\\frac{\\operatorname{sin}⁡(3x)}{3}\\,\\text{d}x \\\\  & ={\\frac{1}{3}x\\operatorname{sin}⁡(3x)|}_{0}^{\\pi /2}+\\frac{1}{9}\\operatorname{cos}⁡(3x){|}_{0}^{\\pi /2} \\\\  & =\\frac{1}{3}[\\frac{\\pi }{2}\\operatorname{sin}⁡(\\frac{3\\pi }{2})-0\\operatorname{sin}⁡(0)] \\\\  & +\\frac{1}{9}[\\operatorname{cos}⁡(\\frac{3\\pi }{2})-\\operatorname{cos}⁡(0)] \\\\  & =\\frac{1}{3}(-\\frac{\\pi }{2}-0)+\\frac{1}{9}(0-1) \\\\  & =-\\frac{\\pi }{6}-\\frac{1}{9}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186437252 :knowledge-point/_questions [{:db/id #edb/ref 17592186105901 :knowledge-point/id #uuid "fa712994-dace-59ea-aaec-cc83ad4fb4a6" :knowledge-point/title "Applying the Rule of the Lazy Statistician for Continuous Random Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5cba1c3f-01fc-5d61-b88d-23f8fb1c01cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186437235} {:answer/id #uuid "6e0e2884-b8c3-55f1-8134-c7be000c4e59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186437236} {:answer/id #uuid "981854b0-550e-526d-8dc5-31a33f4f1dc8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186437237} {:answer/id #uuid "a7326d17-2a72-5e07-9719-7b37acd2cbb0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186437238} {:answer/id #uuid "f7e98ebf-dfdd-53cf-a8c8-c06a7f1ed6e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186437243}] :answer-field/correct {:answer/id #uuid "f7e98ebf-dfdd-53cf-a8c8-c06a7f1ed6e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186437243} :answer-field/id #uuid "91cbb973-133c-5997-84aa-4bae64a092e0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186437249}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "63944823-073b-5e64-b6fb-3ef658695df7" :question/math-academy-id "q-137060" :question/problem "Find $\\text{E}[\\sqrt{X}],$ given that the continuous random variable $X$ has the probability density function\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{{x}^{2}}, & x\\ge 1 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$" :question/worked-solution "For a continuous random variable $X$ and a function $r(x),$ the rule of the lazy statistician states that \n\n$$\n\\text{E}[r(X)]={\\int }_{-\\infty }^{\\infty }r(x)f(x)\\,\\text{d}x.\n$$\n\nIn our case, we have \n\n$$\nr(x)=\\sqrt{x}.\n$$\n\n \n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{E}[\\sqrt{X}] & ={\\int }_{-\\infty }^{\\infty }r(x)f(x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\sqrt{x}\\cdot \\frac{1}{{x}^{2}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }{x}^{1/2}\\cdot {x}^{-2}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }{x}^{-3/2}\\,\\text{d}x \\\\  & ={[-2{x}^{-1/2}]}_{1}^{\\infty } \\\\  & =0-(-2) \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272101 :knowledge-point/_questions [{:db/id #edb/ref 17592186133817 :knowledge-point/id #uuid "bb11d128-ee1b-5c35-aefb-1455570d20c6" :knowledge-point/title "Identifying Which Vectors Belong to the Orthogonal Complement of a Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "95ad0c30-25aa-5214-9fc7-c939f04b78e6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${v}_{1}$ only" :db/id #edb/ref 17592186270583} {:answer/id #uuid "975fd28e-adf6-5603-b413-9e3981f4ba92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186270599} {:answer/id #uuid "a602827a-7757-58ef-8992-cd274f1c3f2d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${v}_{3}$ only" :db/id #edb/ref 17592186270755} {:answer/id #uuid "f01d63bf-360f-5027-9b52-9a5dc8da2b84" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${v}_{2}$ and ${v}_{3}$ only" :db/id #edb/ref 17592186271380} {:answer/id #uuid "f2beaf42-65fa-5bab-8cbb-58886c446972" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${v}_{1}$ and ${v}_{3}$ only" :db/id #edb/ref 17592186271402}] :answer-field/correct {:answer/id #uuid "a602827a-7757-58ef-8992-cd274f1c3f2d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${v}_{3}$ only" :db/id #edb/ref 17592186270755} :answer-field/id #uuid "abea13b0-61b2-513e-8903-85f6a044cb51" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271821}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "886a7d65-d33d-599b-a7ad-97a12c1790fd" :question/math-academy-id "q-140468" :question/problem "Consider the vector subspace $H=\\text{Span}{\\begin{bmatrix}-6 \\\\ 0 \\\\ 5\\end{bmatrix},\\begin{bmatrix}2 \\\\ 4 \\\\ -11\\end{bmatrix}}.$ Which of the following vectors belong to ${H}^{⊥}?$\n\n$$\n{v}_{1}=\\begin{bmatrix}5 \\\\ -2 \\\\ 6\\end{bmatrix},\\,{v}_{2}=\\begin{bmatrix}5 \\\\ -14 \\\\ -6\\end{bmatrix},\\,{v}_{3}=\\begin{bmatrix}5 \\\\ 14 \\\\ 6\\end{bmatrix}\n$$" :question/worked-solution "Let's denote the vectors that span the subspace $H$ as ${h}_{1}$ and ${h}_{2}.$ \n\nNow, a vector $v$ belongs to ${H}^{⊥}$ if $v$ is orthogonal to the set of vectors that spans the subspace $H.$ So, we have to find the products ${v}_{i}\\cdot {h}_{j}$ for $i=1,2,3$ and  $j=1,2.$  \n\n- For ${v}_{1}$, we have the following:\n\n$$\n\\begin{aligned}{v}_{1}\\cdot {h}_{1} & =5\\cdot (-6)+(-2)\\cdot 0+6\\cdot 5=0 & ✓ \\\\ {v}_{1}\\cdot {h}_{2} & =5\\cdot 2+(-2)\\cdot 4+6\\cdot (-11)=-64\\ne 0 & \\times \\end{aligned}\n$$\n\nSo, ${v}_{1}\\notin {H}^{⊥}.$\n\n- For ${v}_{2}$, we have the following:\n\n$$\n\\begin{aligned}{v}_{2}\\cdot {h}_{1} & =5\\cdot (-6)+(-14)\\cdot 0+(-6)\\cdot 5=-60\\ne 0 & \\times \\end{aligned}\n$$\n\nSo, ${v}_{2}\\notin {H}^{⊥}.$ We do not need to test ${v}_{2}\\cdot {h}_{2}.$\n\n- For ${v}_{3}$, we have the following:\n\n$$\n\\begin{aligned}{v}_{3}\\cdot {h}_{1} & =5\\cdot (-6)+14\\cdot 0+6\\cdot 5=0 & ✓ \\\\ {v}_{3}\\cdot {h}_{2} & =5\\cdot 2+14\\cdot 4+6\\cdot (-11)=0 & ✓\\end{aligned}\n$$\n\nSo, ${v}_{3}\\in {H}^{⊥}.$\n\nTherefore, the correct answer is \"${v}_{3}$ only\"."}] [{:db/id #edb/ref 17592186275313 :knowledge-point/_questions [{:db/id #edb/ref 17592186078390 :knowledge-point/id #uuid "697f9bd8-9edf-5643-8cdb-a821b6dce09c" :knowledge-point/title "Finding the Center and Radius of a Circle by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31063f08-1e78-5379-8242-cacf1a1d6a7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186272824} {:answer/id #uuid "6c4099a2-b1f7-512a-bb2c-d7f0465c2381" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186273321} {:answer/id #uuid "b713ce94-48fa-5ac2-95e8-75f2acb1782d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186273975} {:answer/id #uuid "d6152ee4-371c-567f-a7c3-3a6b44ec945c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186274260} {:answer/id #uuid "fd8d4981-cac9-569f-a5c8-dce13d00dbea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186274617}] :answer-field/correct {:answer/id #uuid "31063f08-1e78-5379-8242-cacf1a1d6a7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186272824} :answer-field/id #uuid "c93918a5-c8b2-5c94-8ed4-2849b95cb1aa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274985}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8f4ce117-1fd3-56dc-bc77-859fb08b2278" :question/math-academy-id "q-15304" :question/problem "A circle in the Cartesian plane is given by the equation $8x+{x}^{2}-2y=64-{y}^{2}.$ If the circle is written in the standard form $(x-a)^{2}+(y-b)^{2}={r}^{2},$ then $a+b+r=$" :question/worked-solution "To find the standard form of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}8x+{x}^{2}-2y & =64-{y}^{2} \\\\ ({x}^{2}+8x)+({y}^{2}-2y) & =64 \\\\ ({x}^{2}+2\\cdot 4x+{4}^{2})+({y}^{2}-2\\cdot y+{1}^{2}) & =64+{4}^{2}+{1}^{2} \\\\ ({x}^{2}+2\\cdot 4x+{4}^{2})+({y}^{2}-2\\cdot y+{1}^{2}) & =81\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x+4)^{2}+(y-1)^{2} & ={9}^{2} \\\\ (x-(-4))^{2}+(y-1)^{2} & ={9}^{2}.\\end{aligned}\n$$\n\nTherefore, $a=-4,b=1$ and $r=9,$ and\n\n$$\na+b+r=-4+1+9=6.\n$$"}]}
