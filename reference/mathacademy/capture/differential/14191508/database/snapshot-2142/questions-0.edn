#{[{:db/id #edb/ref 17592186250232 :knowledge-point/_questions [{:db/id #edb/ref 17592186064226 :knowledge-point/id #uuid "e7542b0b-20cf-52a6-8889-23c81b40e0e5" :knowledge-point/title "Integrating a Quotient of Trigonometric Functions Using Trigonometric Identities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19d87cf2-ba4e-5ee2-b888-16334d204447" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3(\\sqrt{2}-1)" :db/id #edb/ref 17592186247661} {:answer/id #uuid "1bfa8fa7-c8a9-5491-a85f-a85434d1131e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3(\\sqrt{2}-2)" :db/id #edb/ref 17592186247678} {:answer/id #uuid "5b42bf75-0d9b-5855-aac9-9999790d5338" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}-3" :db/id #edb/ref 17592186248251} {:answer/id #uuid "a03cb483-a296-5946-8a8d-952eac55cad3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3(\\sqrt{2}+1)" :db/id #edb/ref 17592186248855} {:answer/id #uuid "aedb9126-7c6d-5c55-ad4b-869a319638e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}+1" :db/id #edb/ref 17592186248989}] :answer-field/correct {:answer/id #uuid "19d87cf2-ba4e-5ee2-b888-16334d204447" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3(\\sqrt{2}-1)" :db/id #edb/ref 17592186247661} :answer-field/id #uuid "0416b7bd-da37-58c6-8855-48ba00ca405e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249671}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "edc6fd62-64ca-5ae7-b219-55728bf85a2e" :question/math-academy-id "q-114306" :question/problem "${\\int }_{0}^{\\pi /4}\\frac{3\\operatorname{sec}⁡x\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\\,\\text{d}x=$" :question/worked-solution "We can write the integral as\n\n$$\n{\\int }_{0}^{\\pi /4}\\frac{3\\operatorname{sec}⁡x\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\\,\\text{d}x=3{\\int }_{0}^{\\pi /4}\\operatorname{sec}⁡x\\cdot \\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\\,\\text{d}x\n$$\n\nThen, we use the fact that $\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}=\\operatorname{tan}⁡x,$ as follows:\n\n$$\n\\begin{aligned}3{\\int }_{0}^{\\pi /4}\\operatorname{sec}⁡x\\cdot \\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\\,\\text{d}x & =3{\\int }_{0}^{\\pi /4}\\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /4}\\frac{3\\operatorname{sec}⁡x\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\\,\\text{d}x & =3{\\int }_{0}^{\\pi /4}\\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x \\\\  & =3\\operatorname{sec}⁡x\\,{|}_{0}^{\\pi /4} \\\\  & =3[\\operatorname{sec}⁡(\\frac{\\pi }{4})-\\operatorname{sec}⁡0] \\\\  & =3(\\sqrt{2}-1)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186332692 :knowledge-point/_questions [{:db/id #edb/ref 17592186064227 :knowledge-point/id #uuid "7d309fd9-62bd-5307-9dfc-128f9ff028aa" :knowledge-point/title "Integrating a Trigonometric Expression Using Identities and Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c5821ad-3d4f-57c6-a299-5d7eb8eb6393" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{cos}⁡2x+C" :db/id #edb/ref 17592186330643} {:answer/id #uuid "9313388c-be46-561d-9054-618eddeb5792" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡2x+C" :db/id #edb/ref 17592186331257} {:answer/id #uuid "968b5dbc-fc14-52e1-b8ba-c858af9d76e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{sin}⁡2x+C" :db/id #edb/ref 17592186331286} {:answer/id #uuid "bcf4b03b-f1c8-5d81-b6e3-2abcf9f93640" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\operatorname{cos}⁡2x+C" :db/id #edb/ref 17592186331617} {:answer/id #uuid "fd662dda-2335-5bcb-a678-23c74459f46b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\operatorname{sin}⁡2x+C" :db/id #edb/ref 17592186332176}] :answer-field/correct {:answer/id #uuid "968b5dbc-fc14-52e1-b8ba-c858af9d76e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{sin}⁡2x+C" :db/id #edb/ref 17592186331286} :answer-field/id #uuid "b6ced3b9-575e-546e-8f36-c27932699fb7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332518}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1c693f81-0fae-5be2-839f-6622073dd810" :question/math-academy-id "q-49281" :question/problem "Calculate $\\int \\frac{1}{{sec}^{2}⁡2x\\operatorname{cos}⁡2x}\\,\\text{d}x.$" :question/worked-solution "We can write the integral as\n\n$$\n\\int \\frac{1}{{sec}^{2}⁡2x\\operatorname{cos}⁡2x}\\,\\text{d}x=\\int \\frac{1}{{sec}^{2}⁡2x}\\cdot \\frac{1}{\\operatorname{cos}⁡2x}\\,\\text{d}x.\n$$\n\nThen, we use the identity $\\frac{1}{\\operatorname{cos}⁡x}=\\operatorname{sec}⁡x$ as follows:\n\n$$\n\\int \\frac{1}{{sec}^{2}⁡2x}\\cdot \\operatorname{sec}⁡2x\\,\\text{d}x=\\int \\frac{1}{\\operatorname{sec}⁡2x}\\,\\text{d}x=\\int \\operatorname{cos}⁡2x\\,\\text{d}x\n$$\n\nWe can solve this by substitution. Let  $u=2x.$ Then $\\text{d}x=\\frac{1}{2}\\text{d}u.$ Hence\n\n$$\n\\begin{aligned}\\int \\frac{1}{{sec}^{2}⁡2x\\operatorname{cos}⁡2x}\\,\\text{d}x & =\\int \\operatorname{cos}⁡2x\\,\\text{d}x \\\\  & =\\int \\operatorname{cos}⁡u\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int \\operatorname{cos}⁡u\\,\\text{d}u \\\\  & =\\frac{1}{2}\\operatorname{sin}⁡u+C \\\\  & =\\frac{1}{2}\\operatorname{sin}⁡2x+C.\\end{aligned}\n$$"}]}
