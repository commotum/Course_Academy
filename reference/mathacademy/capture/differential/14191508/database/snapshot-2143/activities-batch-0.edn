y-id "e-475"} :knowledge-point/id #uuid "7d309fd9-62bd-5307-9dfc-128f9ff028aa" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050489}] :knowledge-point/questions [{:db/id #edb/ref 17592186064673} {:db/id #edb/ref 17592186064856} {:db/id #edb/ref 17592186250228} {:db/id #edb/ref 17592186319212} {:db/id #edb/ref 17592186321040} {:db/id #edb/ref 17592186321041} {:db/id #edb/ref 17592186321042} {:db/id #edb/ref 17592186323768} {:db/id #edb/ref 17592186332684} {:db/id #edb/ref 17592186332685} {:db/id #edb/ref 17592186332689} {:db/id #edb/ref 17592186332690} {:db/id #edb/ref 17592186332691} {:db/id #edb/ref 17592186332692} {:db/id #edb/ref 17592186431115} {:db/id #edb/ref 17592186431116} {:db/id #edb/ref 17592186431119} {:db/id #edb/ref 17592186431120} {:db/id #edb/ref 17592186505780} {:db/id #edb/ref 17592186505828}] :knowledge-point/title "Integrating a Trigonometric Expression Using Identities and Substitution"} :step/id #uuid "559a1161-8ab4-5d93-84cb-aca7d0953273" :step/math-academy-id 639756}] :activity/title "Integration Using Basic Trigonometric Identities" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186064389}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186505868} :activity/id #uuid "f8da8748-4462-536f-9575-687f636235e9" :activity/scope {:db/id #edb/ref 17592186050783 :topic/id #uuid "66b05ba4-f638-5531-98d7-9a7817e5a7aa" :topic/math-academy-id 282} :activity/steps [{:db/id #edb/ref 17592186505847 :step/content {:db/id #edb/ref 17592186505780 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5cc5eff9-4511-5ebc-9346-fef6d3ff2cd5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186505293} {:answer/id #uuid "61a52828-b97a-55bc-89af-abdc326b7088" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{15}{4}" :db/id #edb/ref 17592186505301} {:answer/id #uuid "a747a90c-e5d0-5aef-9c1b-23569a104c74" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{15}{8}" :db/id #edb/ref 17592186505440} {:answer/id #uuid "bf18c3df-1eff-5189-830c-ed12cf41dde6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186505476} {:answer/id #uuid "cae550b1-5979-52c8-970e-b1b797158855" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186505498}] :answer-field/correct {:db/id #edb/ref 17592186505440} :answer-field/id #uuid "7876217b-a5c3-5d52-8219-aba955692660" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186505660}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "6b6577b4-d24d-5962-9f5c-436ba639df8e" :question/math-academy-id "q-73371" :question/problem "${\\int }_{\\pi /12}^{\\pi /4}\\frac{\\operatorname{cot}⁡(2x)}{{sin}^{4}⁡(2x)}\\,\\text{d}x=$" :question/worked-solution "We use the identity $\\operatorname{cot}⁡2x=\\frac{\\operatorname{cos}⁡2x}{\\operatorname{sin}⁡2x}$ and rewrite the integral as\n\n$$\n\\begin{aligned}{\\int }_{\\pi /12}^{\\pi /4}\\frac{\\operatorname{cot}⁡(2x)}{{sin}^{4}⁡(2x)}\\,\\text{d}x & ={\\int }_{\\pi /12}^{\\pi /4}\\frac{1}{{sin}^{4}⁡(2x)}\\cdot \\frac{\\operatorname{cos}⁡2x}{\\operatorname{sin}⁡2x}\\,\\text{d}x \\\\  & ={\\int }_{\\pi /12}^{\\pi /4}\\frac{1}{{sin}^{5}⁡(2x)}\\cdot \\operatorname{cos}⁡2x\\,\\text{d}x.\\end{aligned}\n$$\n\nWe can solve this by substitution. Let $u=\\operatorname{sin}⁡2x.$ Then \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2\\operatorname{cos}⁡2x\\,⟹\\,\\frac{1}{2}\\text{d}u=\\operatorname{cos}⁡2x\\,\\text{d}x.\n$$\n\nNow, we fill the table for the limits of integration, according to the rule $u=\\operatorname{sin}⁡2x.$\n\n| $x$ | $\\frac{\\pi }{12}$ | $\\frac{\\pi }{4}$ |\n| --- | --- | --- |\n| $u$ | $\\frac{1}{2}$ | $1$ |\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{\\pi /12}^{\\pi /4}\\frac{1}{{sin}^{5}⁡(2x)}\\cdot \\operatorname{cos}⁡2x\\,\\text{d}x & ={\\int }_{1/2}^{1}\\frac{1}{{u}^{5}}\\,\\cdot \\frac{1}{2}\\text{d}u \\\\  & =\\frac{1}{2}{\\int }_{1/2}^{1}\\frac{1}{{u}^{5}}\\,\\text{d}u \\\\  & =\\frac{1}{2}(\\frac{{u}^{-4}}{-4}){|}_{1/2}^{1} \\\\  & =-\\frac{1}{8}(\\frac{1}{{u}^{4}}){|}_{1/2}^{1} \\\\  & =-\\frac{1}{8}(\\frac{1}{{1}^{4}}-{(\\frac{2}{1})}^{4}) \\\\  & =-\\frac{1}{8}(1-16) \\\\  & =\\frac{15}{8}.\\end{aligned}\\end{aligned}\n$$"} :step/id #uuid "0051ac35-b045-55e9-8042-aafa23faee8f" :step/next {:db/id #edb/ref 17592186505860}} {:db/id #edb/ref 17592186505849 :step/content {:db/id #edb/ref 17592186505809 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "57752369-ee0f-585d-9307-31648dc6aed8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\frac{\\sqrt{2}}{3}" :db/id #edb/ref 17592186505282} {:answer/id #uuid "6cf67a66-1f7d-589b-9794-976a6ee03856" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{3}" :db/id #edb/ref 17592186505324} {:answer/id #uuid "6e6725ad-f38e-5393-96b7-7603ac0c2f06" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186505329} {:answer/id #uuid "a9187687-7c45-54ed-92e1-7d05ac532cf0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2}}{3}" :db/id #edb/ref 17592186505442} {:answer/id #uuid "b3f34fb5-2b1a-527d-8cbd-18a361eec573" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186505455}] :answer-field/correct {:db/id #edb/ref 17592186505455} :answer-field/id #uuid "9163b72a-ca3f-56d5-be84-6c361f7f2037" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186505673}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "bcf19778-fecb-5e86-ab67-3237ac262859" :question/math-academy-id "q-73357" :question/problem "Calculate ${\\int }_{\\pi /12}^{\\pi /4}\\frac{\\operatorname{cot}⁡3x}{\\operatorname{csc}⁡3x}\\,\\text{d}x.$" :question/worked-solution "We can write the integral as\n\n$$\n{\\int }_{\\pi /12}^{\\pi /4}\\frac{\\operatorname{cot}⁡3x}{\\operatorname{csc}⁡3x}\\,\\text{d}x={\\int }_{\\pi /12}^{\\pi /4}\\operatorname{cot}⁡3x\\cdot \\frac{1}{\\operatorname{csc}⁡3x}\\,\\text{d}x\n$$\n\nThen, we use the fact that $\\operatorname{cot}⁡3x=\\frac{\\operatorname{cos}⁡3x}{\\operatorname{sin}⁡3x}$ and $\\frac{1}{\\operatorname{sin}⁡3x}=\\operatorname{csc}⁡3x$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{\\pi /12}^{\\pi /4}\\frac{\\operatorname{cos}⁡3x}{\\operatorname{sin}⁡3x}\\cdot \\operatorname{sin}⁡3x\\,\\text{d}x={\\int }_{\\pi /12}^{\\pi /4}\\operatorname{cos}⁡3x\\,\\text{d}x\\end{aligned}\n$$\n\nWe can solve this by substitution. Let $u=3x.$ Then $\\text{d}x=\\frac{1}{3}\\text{d}u.$ \n\nNow, we fill the table for the limits of integration, according to the rule $u=3x.$\n\n| $x$ | $\\frac{\\pi }{12}$ | $\\frac{\\pi }{4}$ |\n| --- | --- | --- |\n| $u$ | $\\frac{\\pi }{4}$ | $\\frac{3\\pi }{4}$ |\n\nTherefore, the integral in terms of the new variable is\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{\\pi /12}^{\\pi /4}\\operatorname{cos}⁡3x\\,\\text{d}x & ={\\int }_{\\pi /4}^{3\\pi /4}\\operatorname{cos}⁡u\\,\\cdot \\frac{1}{3}\\text{d}u \\\\  & =\\frac{1}{3}{\\int }_{\\pi /4}^{3\\pi /4}\\operatorname{cos}⁡u\\,\\text{d}u \\\\  & =\\frac{1}{3}\\operatorname{sin}⁡u{|}_{\\pi /4}^{3\\pi /4} \\\\  & =\\frac{1}{3}(\\operatorname{sin}⁡(\\frac{3\\pi }{4})-\\operatorname{sin}⁡(\\frac{\\pi }{4})) \\\\  & =\\frac{1}{3}(\\frac{\\sqrt{2}}{2}-\\frac{\\sqrt{2}}{2}) \\\\  & =0.\\end{aligned}\\end{aligned}\n$$"} :step/id #uuid "06120e1b-9a6c-5586-9e92-0e7f9b806e77" :step/next {:db/id #edb/ref 17592186505847}} {:db/id #edb/ref 17592186505860 :step/content {:db/id #edb/ref 17592186250232 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19d87cf2-ba4e-5ee2-b888-16334d204447" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3(\\sqrt{2}-1)" :db/id #edb/ref 17592186247661} {:answer/id #uuid "1bfa8fa7-c8a9-5491-a85f-a85434d1131e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3(\\sqrt{2}-2)" :db/id #edb/ref 17592186247678} {:answer/id #uuid "5b42bf75-0d9b-5855-aac9-9999790d5338" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}-3" :db/id #edb/ref 17592186248251} {:answer/id #uuid "a03cb483-a296-5946-8a8d-952eac55cad3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3(\\sqrt{2}+1)" :db/id #edb/ref 17592186248855} {:answer/id #uuid "aedb9126-7c6d-5c55-ad4b-869a319638e0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}+1" :db/id #edb/ref 17592186248989}] :answer-field/correct {:db/id #edb/ref 17592186247661} :answer-field/id #uuid "0416b7bd-da37-58c6-8855-48ba00ca405e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186249671}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "edc6fd62-64ca-5ae7-b219-55728bf85a2e" :question/math-academy-id "q-114306" :question/problem "${\\int }_{0}^{\\pi /4}\\frac{3\\operatorname{sec}⁡x\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\\,\\text{d}x=$" :question/worked-solution "We can write the integral as\n\n$$\n{\\int }_{0}^{\\pi /4}\\frac{3\\operatorname{sec}⁡x\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\\,\\text{d}x=3{\\int }_{0}^{\\pi /4}\\operatorname{sec}⁡x\\cdot \\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\\,\\text{d}x\n$$\n\nThen, we use the fact that $\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}=\\operatorname{tan}⁡x,$ as follows:\n\n$$\n\\begin{aligned}3{\\int }_{0}^{\\pi /4}\\operatorname{sec}⁡x\\cdot \\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\\,\\text{d}x & =3{\\int }_{0}^{\\pi /4}\\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /4}\\frac{3\\operatorname{sec}⁡x\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\\,\\text{d}x & =3{\\int }_{0}^{\\pi /4}\\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x \\\\  & =3\\operatorname{sec}⁡x\\,{|}_{0}^{\\pi /4} \\\\  & =3[\\operatorname{sec}⁡(\\frac{\\pi }{4})-\\operatorname{sec}⁡0] \\\\  & =3(\\sqrt{2}-1)\\end{aligned}\n$$"} :step/id #uuid "365bc5c1-aa86-54ca-84e3-75f3f3c60782" :step/next {:db/id #edb/ref 17592186505893}} {:db/id #edb/ref 17592186505868 :step/content {:db/id #edb/ref 17592186332692 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c5821ad-3d4f-57c6-a299-5d7eb8eb6393" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{cos}⁡2x+C" :db/id #edb/ref 17592186330643} {:answer/id #uuid "9313388c-be46-561d-9054-618eddeb5792" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{sin}⁡2x+C" :db/id #edb/ref 17592186331257} {:answer/id #uuid "968b5dbc-fc14-52e1-b8ba-c858af9d76e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}\\operatorname{sin}⁡2x+C" :db/id #edb/ref 17592186331286} {:answer/id #uuid "bcf4b03b-f1c8-5d81-b6e3-2abcf9f93640" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2}\\operatorname{cos}⁡2x+C" :db/id #edb/ref 17592186331617} {:answer/id #uuid "fd662dda-2335-5bcb-a678-23c74459f46b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2\\operatorname{sin}⁡2x+C" :db/id #edb/ref 17592186332176}] :answer-field/correct {:db/id #edb/ref 17592186331286} :answer-field/id #uuid "b6ced3b9-575e-546e-8f36-c27932699fb7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186332518}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1c693f81-0fae-5be2-839f-6622073dd810" :question/math-academy-id "q-49281" :question/problem "Calculate $\\int \\frac{1}{{sec}^{2}⁡2x\\operatorname{cos}⁡2x}\\,\\text{d}x.$" :question/worked-solution "We can write the integral as\n\n$$\n\\int \\frac{1}{{sec}^{2}⁡2x\\operatorname{cos}⁡2x}\\,\\text{d}x=\\int \\frac{1}{{sec}^{2}⁡2x}\\cdot \\frac{1}{\\operatorname{cos}⁡2x}\\,\\text{d}x.\n$$\n\nThen, we use the identity $\\frac{1}{\\operatorname{cos}⁡x}=\\operatorname{sec}⁡x$ as follows:\n\n$$\n\\int \\frac{1}{{sec}^{2}⁡2x}\\cdot \\operatorname{sec}⁡2x\\,\\text{d}x=\\int \\frac{1}{\\operatorname{sec}⁡2x}\\,\\text{d}x=\\int \\operatorname{cos}⁡2x\\,\\text{d}x\n$$\n\nWe can solve this by substitution. Let  $u=2x.$ Then $\\text{d}x=\\frac{1}{2}\\text{d}u.$ Hence\n\n$$\n\\begin{aligned}\\int \\frac{1}{{sec}^{2}⁡2x\\operatorname{cos}⁡2x}\\,\\text{d}x & =\\int \\operatorname{cos}⁡2x\\,\\text{d}x \\\\  & =\\int \\operatorname{cos}⁡u\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int \\operatorname{cos}⁡u\\,\\text{d}u \\\\  & =\\frac{1}{2}\\operatorname{sin}⁡u+C \\\\  & =\\frac{1}{2}\\operatorname{sin}⁡2x+C.\\end{aligned}\n$$"} :step/id #uuid "574d8f69-05d3-59ca-9215-5636208ebe73" :step/next {:db/id #edb/ref 17592186505849}} {:db/id #edb/ref 17592186505893 :step/content {:db/id #edb/ref 17592186505828 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e5976a6b-1d1d-57ce-8564-63c89f695029" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186505555}] :answer-field/correct {:db/id #edb/ref 17592186505555} :answer-field/id #uuid "b5cb8799-b859-5b82-be20-c6134d8d1332" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186505696}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e2444a41-f0c0-50e5-91b8-38bd6aeb8a43" :question/math-academy-id "q-347942" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{\\pi /18}^{\\pi /6}\\frac{\\operatorname{cot}⁡(3x)}{{sin}^{4}⁡(3x)}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "We use the identity $\\operatorname{cot}⁡3x=\\frac{\\operatorname{cos}⁡3x}{\\operatorname{sin}⁡3x}$ and rewrite the integral as\n\n$$\n\\begin{aligned}{\\int }_{\\pi /18}^{\\pi /6}\\frac{\\operatorname{cot}⁡(3x)}{{sin}^{4}⁡(3x)}\\,\\text{d}x & ={\\int }_{\\pi /18}^{\\pi /6}\\frac{1}{{sin}^{4}⁡(3x)}\\cdot \\frac{\\operatorname{cos}⁡3x}{\\operatorname{sin}⁡3x}\\,\\text{d}x \\\\  & ={\\int }_{\\pi /18}^{\\pi /6}\\frac{1}{{sin}^{5}⁡(3x)}\\cdot \\operatorname{cos}⁡3x\\,\\text{d}x.\\end{aligned}\n$$\n\nWe can solve this by substitution. Let $u=\\operatorname{sin}⁡3x.$ Then \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3\\operatorname{cos}⁡3x\\,⟹\\,\\frac{1}{3}\\text{d}u=\\operatorname{cos}⁡3x\\,\\text{d}x.\n$$\n\nNow, we fill the table for the limits of integration, according to the rule $u=\\operatorname{sin}⁡3x.$\n\n| $x$ | $\\frac{\\pi }{18}$ | $\\frac{\\pi }{6}$ |\n| --- | --- | --- |\n| $u$ | $\\frac{1}{2}$ | $1$ |\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{\\pi /18}^{\\pi /6}\\frac{1}{{sin}^{5}⁡(3x)}\\cdot \\operatorname{cos}⁡3x\\,\\text{d}x & ={\\int }_{1/2}^{1}\\frac{1}{{u}^{5}}\\,\\cdot \\frac{1}{3}\\text{d}u \\\\  & =\\frac{1}{3}{\\int }_{1/2}^{1}{u}^{-5}\\,\\text{d}u \\\\  & =\\frac{1}{3}(\\frac{{u}^{-4}}{-4}){|}_{1/2}^{1} \\\\  & =-\\frac{1}{12}(\\frac{1}{{u}^{4}}){|}_{1/2}^{1} \\\\  & =-\\frac{1}{12}(\\frac{1}{{1}^{4}}-{(\\frac{2}{1})}^{4}) \\\\  & =-\\frac{1}{12}(1-16) \\\\  & =\\frac{5}{4}.\\end{aligned}\\end{aligned}\n$$"} :step/id #uuid "d58755bb-4591-557d-aad1-735c72468084"}] :activity/title "Integration Using Basic Trigonometric Identities" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186505103}]}
