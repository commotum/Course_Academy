7592186045498 :db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186355302} {:answer/id #uuid "a2e46ee5-50f0-57cb-bc2b-f369c695e46e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186356108} {:answer/id #uuid "c5437e71-1640-5851-ba9a-7230b9ae0812" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186356389}] :answer-field/correct {:answer/id #uuid "2c4b73fa-5b35-5465-b2f4-143714eef4cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186355040} :answer-field/id #uuid "490bdf07-2ddc-57de-a237-15240ed0a043" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357035}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0f0bce3e-c7ad-5cbe-a214-649d56d182b8" :question/math-academy-id "q-93977" :question/problem "$$\nA=[\\begin{aligned}\\,\\,-2 & 4 \\\\ \\,2 & 3\\end{aligned}]\n$$\n\nGiven the matrix $A$ above, evaluate the bilinear form $B(x,y)={x}^{T}\\,Ay$ when $x=[\\begin{aligned}3 \\\\ -1\\end{aligned}]$ and $y=[\\begin{aligned}1 \\\\ 4\\end{aligned}].$" :question/worked-solution "Substituting $x=[\\begin{aligned}3 \\\\ -1\\end{aligned}]$ and $y=[\\begin{aligned}1 \\\\ 4\\end{aligned}],$ we obtain   \n\n$$\n\\begin{aligned}B(x,y) & ={x}^{T}\\,Ay \\\\  & =[\\begin{aligned}3 & -1\\end{aligned}][\\begin{aligned}-2 & 4 \\\\ 2 & 3\\end{aligned}][\\begin{aligned}1 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}-8 & 9\\end{aligned}][\\begin{aligned}1 \\\\ 4\\end{aligned}] \\\\  & =28.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186423358 :knowledge-point/_questions [{:db/id #edb/ref 17592186161981 :knowledge-point/id #uuid "7083d465-9871-59ca-97fa-583e740e961f" :knowledge-point/title "Evaluating a Bilinear Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2cff8026-19f3-5d12-8d4a-fdebbba7f5dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186423313} {:answer/id #uuid "7b78cc5b-5be7-561b-961d-acbfeed38058" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186423327} {:answer/id #uuid "afe1c099-4476-5cd6-8168-bb6f44c3c646" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186423334} {:answer/id #uuid "c2701e16-efe4-5b21-b6fa-6619278a33a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186423338} {:answer/id #uuid "eccf2580-037b-52f5-a74d-d1ddb3539839" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186423342}] :answer-field/correct {:answer/id #uuid "afe1c099-4476-5cd6-8168-bb6f44c3c646" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186423334} :answer-field/id #uuid "d1fd5e82-7e1e-5e80-89d9-fc63ac2ef995" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186423353}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8fd187ae-a269-5381-90d7-f0ba2d5b4ded" :question/math-academy-id "q-93979" :question/problem "$$\nA=[\\begin{aligned}1 & 0 & -1 \\\\ 0 & 2 & -1 \\\\ 0 & 0 & 3\\end{aligned}]\n$$\n\nGiven the matrix $A$ above, evaluate the bilinear form $B(x,y)={x}^{T}\\,Ay$ when $x=[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}]$ and $y=[\\begin{aligned}0 \\\\ -1 \\\\ 2\\end{aligned}].$" :question/worked-solution "Substituting $x=[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}]$ and $y=[\\begin{aligned}0 \\\\ -1 \\\\ 2\\end{aligned}],$ we obtain \n\n$$\n\\begin{aligned}B(x,y) & ={x}^{T}\\,Ay \\\\  & =[\\begin{aligned}-1 & 1 & 1\\end{aligned}][\\begin{aligned}1 & 0 & -1 \\\\ 0 & 2 & -1 \\\\ 0 & 0 & 3\\end{aligned}][\\begin{aligned}0 \\\\ -1 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & 2 & 3\\end{aligned}][\\begin{aligned}0 \\\\ -1 \\\\ 2\\end{aligned}] \\\\  & =4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186357610 :knowledge-point/_questions [{:db/id #edb/ref 17592186161982 :knowledge-point/id #uuid "55277d69-eedc-5c5c-883a-083746e00947" :knowledge-point/title "Writing Down a Bilinear Form Given Its Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27f83b81-5cc0-57d4-a486-aa7a94c5375e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{x}_{1}{y}_{1}+2{x}_{1}{y}_{2}-{x}_{2}{y}_{1}+3{x}_{2}{y}_{2}" :db/id #edb/ref 17592186355001} {:answer/id #uuid "61faa07c-7bb7-52eb-b0c4-8944a52be8b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{x}_{1}{y}_{1}-{x}_{1}{y}_{2}+{x}_{2}{y}_{1}+3{x}_{2}{y}_{2}" :db/id #edb/ref 17592186355536} {:answer/id #uuid "86053994-8185-551b-889b-0fa792fd8526" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{x}_{1}{y}_{1}+{x}_{1}{y}_{2}-{x}_{2}{y}_{1}+3{x}_{2}{y}_{2}" :db/id #edb/ref 17592186355845} {:answer/id #uuid "c9c0332d-2d9c-5c3e-92d8-8236819f0c19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}_{1}{y}_{1}+{x}_{1}{y}_{2}-{x}_{2}{y}_{1}+2{x}_{2}{y}_{2}" :db/id #edb/ref 17592186356425} {:answer/id #uuid "db1dbfd2-d42d-5d8e-b330-5a4b8b982165" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}_{1}{y}_{1}+{x}_{1}{y}_{2}-2{x}_{2}{y}_{1}+3{x}_{2}{y}_{2}" :db/id #edb/ref 17592186356593}] :answer-field/correct {:answer/id #uuid "86053994-8185-551b-889b-0fa792fd8526" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{x}_{1}{y}_{1}+{x}_{1}{y}_{2}-{x}_{2}{y}_{1}+3{x}_{2}{y}_{2}" :db/id #edb/ref 17592186355845} :answer-field/id #uuid "2c4dd9bd-475e-5191-8fe7-38d4524d146a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186356990}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "09763352-7b89-5e95-8516-57e6bce8d181" :question/math-academy-id "q-93984" :question/problem "$$\nA=[\\begin{aligned}-2 & 1 \\\\ -1 & 3\\end{aligned}]\n$$\n\nConsider the matrix $A$ above. Which of the following represents the corresponding bilinear form ${x}^{T}\\,Ay$ in terms of the components of $x=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$ and $y=[\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}]?$" :question/worked-solution "**Method 1**\n\nEach entry ${a}_{ij}$ of $A$ corresponds to the term ${a}_{ij}{x}_{i}{y}_{j}$ in the expression of the bilinear form:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ay & =(-2){x}_{1}{y}_{1}+1{x}_{1}{y}_{2}+(-1){x}_{2}{y}_{1}+3{x}_{2}{y}_{2} \\\\  & =-2{x}_{1}{y}_{1}+{x}_{1}{y}_{2}-{x}_{2}{y}_{1}+3{x}_{2}{y}_{2}\\end{aligned}\n$$\n\n**Method 2**\n\nTo write down a bilinear form in terms of vector components, we compute the following expression:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ay & =[\\begin{aligned}{x}_{1} & {x}_{2}\\end{aligned}][\\begin{aligned}-2 & 1 \\\\ -1 & 3\\end{aligned}][\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}] \\\\  & =[\\begin{aligned}{x}_{1} & {x}_{2}\\end{aligned}][\\begin{aligned}-2{y}_{1}+{y}_{2} \\\\ -{y}_{1}+3{y}_{2}\\end{aligned}] \\\\  & ={x}_{1}(-2{y}_{1}+{y}_{2})+{x}_{2}(-{y}_{1}+3{y}_{2}) \\\\  & =-2{x}_{1}{y}_{1}+{x}_{1}{y}_{2}-{x}_{2}{y}_{1}+3{x}_{2}{y}_{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186423360 :knowledge-point/_questions [{:db/id #edb/ref 17592186161982 :knowledge-point/id #uuid "55277d69-eedc-5c5c-883a-083746e00947" :knowledge-point/title "Writing Down a Bilinear Form Given Its Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b02a7dc-3d77-54f9-9eab-4104398fd87b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}_{1}{y}_{1}+3{x}_{1}{y}_{2}+4{x}_{2}{y}_{1}+3{x}_{2}{y}_{2}" :db/id #edb/ref 17592186423304} {:answer/id #uuid "22b8fa47-b5d7-5475-809f-5b86289a33ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}_{1}{y}_{1}+4{x}_{1}{y}_{2}+3{x}_{2}{y}_{1}+4{x}_{2}{y}_{2}" :db/id #edb/ref 17592186423308} {:answer/id #uuid "296cb029-fd72-54e6-8b59-ce6e9308ae5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}_{1}{y}_{1}+3{x}_{1}{y}_{2}+{x}_{2}{y}_{1}+{x}_{2}{y}_{2}" :db/id #edb/ref 17592186423310} {:answer/id #uuid "a2f621b4-1a27-59a6-9d95-b8cc81fcaf7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}_{1}{y}_{1}+{x}_{1}{y}_{2}+3{x}_{2}{y}_{1}+{x}_{2}{y}_{2}" :db/id #edb/ref 17592186423330} {:answer/id #uuid "f2d475eb-ebf0-5365-a6f5-fdf8e2a293d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}_{1}{y}_{1}+3{x}_{1}{y}_{2}+3{x}_{2}{y}_{1}-{x}_{2}{y}_{2}" :db/id #edb/ref 17592186423343}] :answer-field/correct {:answer/id #uuid "a2f621b4-1a27-59a6-9d95-b8cc81fcaf7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}_{1}{y}_{1}+{x}_{1}{y}_{2}+3{x}_{2}{y}_{1}+{x}_{2}{y}_{2}" :db/id #edb/ref 17592186423330} :answer-field/id #uuid "43d9d476-deb7-5159-945c-bd382763aea3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186423348}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b15d4431-e43f-5101-96e7-ab09f0076b4a" :question/math-academy-id "q-93991" :question/problem "$$\nA=[\\begin{aligned}4 & 1 \\\\ 3 & 1\\end{aligned}]\n$$\n\nConsider the matrix $A$ above. Which of the following represents the corresponding bilinear form ${x}^{T}\\,Ay$ in terms of the components of $x=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$ and $y=[\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}]?$" :question/worked-solution "**Method 1**\n\nEach entry ${a}_{ij}$ of $A$ corresponds to the term ${a}_{ij}{x}_{i}{y}_{j}$ in the expression of the bilinear form:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ay & =4{x}_{1}{y}_{1}+1{x}_{1}{y}_{2}+3{x}_{2}{y}_{1}+1{x}_{2}{y}_{2} \\\\  & =4{x}_{1}{y}_{1}+{x}_{1}{y}_{2}+3{x}_{2}{y}_{1}+{x}_{2}{y}_{2}\\end{aligned}\n$$\n\n**Method 2**\n\nTo write down a bilinear form in terms of vector components, we compute the following expression:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ay & =[\\begin{aligned}{x}_{1} & {x}_{2}\\end{aligned}][\\begin{aligned}4 & 1 \\\\ 3 & 1\\end{aligned}][\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}] \\\\  & =[\\begin{aligned}{x}_{1} & {x}_{2}\\end{aligned}][\\begin{aligned}4{y}_{1}+{y}_{2} \\\\ 3{y}_{1}+{y}_{2}\\end{aligned}] \\\\  & ={x}_{1}(4{y}_{1}+{y}_{2})+{x}_{2}(3{y}_{1}+{y}_{2}) \\\\  & =4{x}_{1}{y}_{1}+{x}_{1}{y}_{2}+3{x}_{2}{y}_{1}+{x}_{2}{y}_{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186357615 :knowledge-point/_questions [{:db/id #edb/ref 17592186161982 :knowledge-point/id #uuid "55277d69-eedc-5c5c-883a-083746e00947" :knowledge-point/title "Writing Down a Bilinear Form Given Its Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a7ba25b-c13d-5925-a2ef-d0f44fe78b5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{x}_{1}{y}_{1}-2{x}_{1}{y}_{2}-2{x}_{2}{y}_{1}+3{x}_{2}{y}_{2}" :db/id #edb/ref 17592186355021} {:answer/id #uuid "987657a3-9fac-53a5-9903-25a92423fb68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{x}_{1}{y}_{1}+2{x}_{1}{y}_{2}+2{x}_{2}{y}_{1}+3{x}_{2}{y}_{2}" :db/id #edb/ref 17592186356011} {:answer/id #uuid "a6a163c0-6928-5aff-94f8-da4ee68d485a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{x}_{1}{y}_{1}+2{x}_{1}{y}_{2}+3{x}_{2}{y}_{1}+2{x}_{2}{y}_{2}" :db/id #edb/ref 17592186356139} {:answer/id #uuid "e5e00cff-942b-5e00-b35e-dbcc54526642" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}_{1}{y}_{1}-2{x}_{1}{y}_{2}+2{x}_{2}{y}_{1}+3{x}_{2}{y}_{2}" :db/id #edb/ref 17592186356671} {:answer/id #uuid "ff14bba7-d2c8-50f6-ac9a-a9b2d3ffcf74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}_{1}{y}_{1}+2{x}_{1}{y}_{2}-2{x}_{2}{y}_{1}+3{x}_{2}{y}_{2}" :db/id #edb/ref 17592186356900}] :answer-field/correct {:answer/id #uuid "987657a3-9fac-53a5-9903-25a92423fb68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{x}_{1}{y}_{1}+2{x}_{1}{y}_{2}+2{x}_{2}{y}_{1}+3{x}_{2}{y}_{2}" :db/id #edb/ref 17592186356011} :answer-field/id #uuid "aa9552f5-221d-5abb-b816-150bd35582d4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357227}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9eb1f202-37a9-5513-9728-465e7c426c0d" :question/math-academy-id "q-93996" :question/problem "$$\nA=[\\begin{aligned}-2 & 2 \\\\ 2 & 3\\end{aligned}]\n$$\n\nConsider the matrix $A$ above. Which of the following represents the corresponding bilinear form ${x}^{T}\\,Ay$ in terms of the components of $x=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$ and $y=[\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}]?$" :question/worked-solution "**Method 1**\n\nEach entry ${a}_{ij}$ of $A$ corresponds to the term ${a}_{ij}{x}_{i}{y}_{j}$ in the expression of the bilinear form:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ay & =(-2){x}_{1}{y}_{1}+2{x}_{1}{y}_{2}+2{x}_{2}{y}_{1}+3{x}_{2}{y}_{2} \\\\  & =-2{x}_{1}{y}_{1}+2{x}_{1}{y}_{2}+2{x}_{2}{y}_{1}+3{x}_{2}{y}_{2}\\end{aligned}\n$$\n\n**Method 2**\n\nTo write down a bilinear form in terms of vector components, we compute the following expression:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ay & =[\\begin{aligned}{x}_{1} & {x}_{2}\\end{aligned}][\\begin{aligned}-2 & 2 \\\\ 2 & 3\\end{aligned}][\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}] \\\\  & =[\\begin{aligned}{x}_{1} & {x}_{2}\\end{aligned}][\\begin{aligned}-2{y}_{1}+2{y}_{2} \\\\ 2{y}_{1}+3{y}_{2}\\end{aligned}] \\\\  & ={x}_{1}(-2{y}_{1}+2{y}_{2})+{x}_{2}(2{y}_{1}+3{y}_{2}) \\\\  & =-2{x}_{1}{y}_{1}+2{x}_{1}{y}_{2}+2{x}_{2}{y}_{1}+3{x}_{2}{y}_{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186423357 :knowledge-point/_questions [{:db/id #edb/ref 17592186161982 :knowledge-point/id #uuid "55277d69-eedc-5c5c-883a-083746e00947" :knowledge-point/title "Writing Down a Bilinear Form Given Its Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c39145d-687d-5e9d-a4b7-4803af6f1033" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5{x}_{1}{y}_{1}+3{x}_{1}{y}_{2}-2{x}_{2}{y}_{1}-2{x}_{2}{y}_{2}" :db/id #edb/ref 17592186423311} {:answer/id #uuid "6a490a4b-b443-5931-846e-82347d39a8a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{x}_{1}{y}_{1}+2{x}_{1}{y}_{2}+2{x}_{2}{y}_{1}-3{x}_{2}{y}_{2}" :db/id #edb/ref 17592186423324} {:answer/id #uuid "c19d0695-6a4b-5a8d-8f46-59949e70c5cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{x}_{1}{y}_{1}-2{x}_{1}{y}_{2}+2{x}_{2}{y}_{1}+3{x}_{2}{y}_{2}" :db/id #edb/ref 17592186423337} {:answer/id #uuid "e1f20766-50fb-5c84-b3d7-0dee5a60c22e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5{x}_{1}{y}_{1}+3{x}_{1}{y}_{2}-2{x}_{2}{y}_{1}+2{x}_{2}{y}_{2}" :db/id #edb/ref 17592186423339} {:answer/id #uuid "f8faa3ec-9091-532c-92df-30bbd8e9a9f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5{x}_{1}{y}_{1}+2{x}_{1}{y}_{2}-2{x}_{2}{y}_{1}+3{x}_{2}{y}_{2}" :db/id #edb/ref 17592186423344}] :answer-field/correct {:answer/id #uuid "f8faa3ec-9091-532c-92df-30bbd8e9a9f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5{x}_{1}{y}_{1}+2{x}_{1}{y}_{2}-2{x}_{2}{y}_{1}+3{x}_{2}{y}_{2}" :db/id #edb/ref 17592186423344} :answer-field/id #uuid "498a26f3-93fc-5768-8c25-7e9199e29e91" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186423349}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8f253585-3e9e-576c-84e8-68a00302ab3a" :question/math-academy-id "q-93997" :question/problem "$$\nA=[\\begin{aligned}-5 & 2 \\\\ -2 & 3\\end{aligned}]\n$$\n\nConsider the matrix $A$ above. Which of the following represents the corresponding bilinear form ${x}^{T}\\,Ay$ in terms of the components of $x=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$ and $y=[\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}]?$" :question/worked-solution "**Method 1**\n\nEach entry ${a}_{ij}$ of $A$ corresponds to the term ${a}_{ij}{x}_{i}{y}_{j}$ in the expression of the bilinear form:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ay & =(-5){x}_{1}{y}_{1}+2{x}_{1}{y}_{2}+(-2){x}_{2}{y}_{1}+3{x}_{2}{y}_{2} \\\\  & =-5{x}_{1}{y}_{1}+2{x}_{1}{y}_{2}-2{x}_{2}{y}_{1}+3{x}_{2}{y}_{2}\\end{aligned}\n$$\n\n**Method 2**\n\nTo write down a bilinear form in terms of vector components, we compute the following expression:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ay & =[\\begin{aligned}{x}_{1} & {x}_{2}\\end{aligned}][\\begin{aligned}-5 & 2 \\\\ -2 & 3\\end{aligned}][\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}] \\\\  & =[\\begin{aligned}{x}_{1} & {x}_{2}\\end{aligned}][\\begin{aligned}-5{y}_{1}+2{y}_{2} \\\\ -2{y}_{1}+3{y}_{2}\\end{aligned}] \\\\  & ={x}_{1}(-5{y}_{1}+2{y}_{2})+{x}_{2}(-2{y}_{1}+3{y}_{2}) \\\\  & =-5{x}_{1}{y}_{1}+2{x}_{1}{y}_{2}-2{x}_{2}{y}_{1}+3{x}_{2}{y}_{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186357632 :knowledge-point/_questions [{:db/id #edb/ref 17592186161983 :knowledge-point/id #uuid "f60cd05d-e4af-5bf1-8827-cab48da934f1" :knowledge-point/title "Finding the Matrix of a Bilinear Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d42be02-7f19-54e2-82cb-3df6ba35bc59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186355487} {:answer/id #uuid "64314b6b-2065-5485-b518-e241939c903f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186355558} {:answer/id #uuid "841f10b2-364e-5de9-b84b-f438f36993f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186355829} {:answer/id #uuid "8dd192af-d547-5d88-a769-5c1981af761c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186355914} {:answer/id #uuid "9768f61d-b930-53c9-bd10-f838eacea0aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186355997}] :answer-field/correct {:answer/id #uuid "9768f61d-b930-53c9-bd10-f838eacea0aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186355997} :answer-field/id #uuid "bfd66483-0f86-5977-b311-6db52cd032f6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357261}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "04f3f719-b108-5208-92b0-9457c6817de3" :question/math-academy-id "q-94045" :question/problem "$$\n[\\begin{aligned}a & b \\\\ -5 & -2\\end{aligned}]\n$$\n\nThe matrix of the bilinear form $B(x,y)=-4{x}_{1}{y}_{1}+3{x}_{1}{y}_{2}-5{x}_{2}{y}_{1}-2{x}_{2}{y}_{2}$ is given above. What is the value of $a+b?$" :question/worked-solution "Each term ${a}_{ij}{x}_{i}{y}_{j}$ in the expression of the bilinear form corresponds to the entry ${a}_{ij}$ of the matrix:\n\n$$\n\\begin{aligned}B(x,y) & =-4{x}_{1}{y}_{1}+3{x}_{1}{y}_{2}-5{x}_{2}{y}_{1}-2{x}_{2}{y}_{2} \\\\  & =(-4){x}_{1}{y}_{1}+\\,\\,3{x}_{1}{y}_{2} \\\\  & +\\,(-5){x}_{2}{y}_{1}\\,+(-2){x}_{2}{y}_{2}\\end{aligned}\n$$\n\n   \n\nThen, the corresponding matrix of the bilinear form is\n\n$$\n[\\begin{aligned}-4 & 3 \\\\ -5 & -2\\end{aligned}].\n$$\n\nTherefore, $a=-4$ and $b=3.$ Finally, \n\n$$\na+b=-4+3=-1.\n$$"}] [{:db/id #edb/ref 17592186423355 :knowledge-point/_questions [{:db/id #edb/ref 17592186161983 :knowledge-point/id #uuid "f60cd05d-e4af-5bf1-8827-cab48da934f1" :knowledge-point/title "Finding the Matrix of a Bilinear Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09004ef9-4917-58d2-8c07-5742c23a3707" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186423303} {:answer/id #uuid "4b827265-5f1b-5d21-bc00-5ef126ec2974" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186423317} {:answer/id #uuid "51df2d1f-f33d-542f-95ae-1b7bae1bef78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186423319} {:answer/id #uuid "ab7bf224-6bd2-51db-a931-dd164fe74c50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186423333} {:answer/id #uuid "ff6634ff-8df0-570a-b775-f5f7b0dd5975" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186423346}] :answer-field/correct {:answer/id #uuid "09004ef9-4917-58d2-8c07-5742c23a3707" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186423303} :answer-field/id #uuid "6070624a-322a-55b2-9acf-4b66d4684f47" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186423352}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "41f16b5c-e680-54f8-926b-ebe6345d8561" :question/math-academy-id "q-94050" :question/problem "$$\n[\\begin{aligned}a & 0 & 2 \\\\ 0 & b & 0 \\\\ 0 & c & 1\\end{aligned}]\n$$\n\nThe matrix of the bilinear form $B(x,y)={x}_{1}{y}_{1}+2{x}_{1}{y}_{3}-2{x}_{2}{y}_{2}+{x}_{3}{y}_{2}+{x}_{3}{y}_{3}$ is given above. What is the value of $a+b+c?$" :question/worked-solution "Each term ${a}_{ij}{x}_{i}{y}_{j}$ in the expression of the bilinear form corresponds to the entry ${a}_{ij}$ of the matrix:\n\n$$\n\\begin{aligned}B(x,y) & ={x}_{1}{y}_{1}+2{x}_{1}{y}_{3}-2{x}_{2}{y}_{2}+{x}_{3}{y}_{2}+{x}_{3}{y}_{3} \\\\  & =1{x}_{1}{y}_{1}+0{x}_{1}{y}_{2}+2{x}_{1}{y}_{3} \\\\  & +\\,0{x}_{2}{y}_{1}+(-2){x}_{2}{y}_{2}+0{x}_{2}{y}_{3} \\\\  & +\\,0{x}_{3}{y}_{1}+1{x}_{3}{y}_{2}+1{x}_{3}{y}_{3}\\end{aligned}\n$$\n\nThen, the corresponding matrix of the bilinear form is\n\n$$\n[\\begin{aligned}1 & 0 & 2 \\\\ 0 & \\,\\,-2 & 0 \\\\ 0 & 1 & 1\\end{aligned}].\n$$\n\nTherefore, $a=1,$ $b=-2,$ and $c=1.$ Finally, \n\n$$\na+b+c=1+(-2)+1=0.\n$$"}] [{:db/id #edb/ref 17592186357635 :knowledge-point/_questions [{:db/id #edb/ref 17592186161983 :knowledge-point/id #uuid "f60cd05d-e4af-5bf1-8827-cab48da934f1" :knowledge-point/title "Finding the Matrix of a Bilinear Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c017696-7edc-50b4-9035-1f3ce4d23b51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186355038} {:answer/id #uuid "3de97409-1c58-5b53-92bc-8e7f3b56e935" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186355217} {:answer/id #uuid "61088392-e274-50b7-bd68-e1e134fd198a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186355526} {:answer/id #uuid "cfc5825a-9c48-583a-8c9d-72bebfbc01da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186356480} {:answer/id #uuid "f6d93756-6a43-550f-9105-ceabaee133f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186356815}] :answer-field/correct {:answer/id #uuid "f6d93756-6a43-550f-9105-ceabaee133f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186356815} :answer-field/id #uuid "c1db56dc-7afb-5c75-8b54-941d34316501" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357266}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7c502fc9-407f-54ee-a63b-8ef283056af2" :question/math-academy-id "q-94052" :question/problem "$$\n[\\begin{aligned}a & 0 & 0 \\\\ 0 & b & 0 \\\\ 2 & 1 & c\\end{aligned}]\n$$\n\nThe matrix of the bilinear form $B(x,y)={x}_{1}{y}_{1}+2{x}_{2}{y}_{2}+2{x}_{3}{y}_{1}+{x}_{3}{y}_{2}-3{x}_{3}{y}_{3}$ is given above. What is the value of $a+b+c?$" :question/worked-solution "Each term ${a}_{ij}{x}_{i}{y}_{j}$ in the expression of the bilinear form corresponds to the entry ${a}_{ij}$ of the matrix:\n\n$$\n\\begin{aligned}B(x,y) & ={x}_{1}{y}_{1}+2{x}_{2}{y}_{2}+2{x}_{3}{y}_{1}+{x}_{3}{y}_{2}-3{x}_{3}{y}_{3} \\\\  & =1{x}_{1}{y}_{1}+0{x}_{1}{y}_{2}+0{x}_{1}{y}_{3} \\\\  & +\\,0{x}_{2}{y}_{1}+2{x}_{2}{y}_{2}+0{x}_{2}{y}_{3} \\\\  & +\\,2{x}_{3}{y}_{1}+1{x}_{3}{y}_{2}+(-3){x}_{3}{y}_{3}\\end{aligned}\n$$\n\nThen, the corresponding matrix of the bilinear form is\n\n$$\n[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 2 & 1 & -3\\end{aligned}].\n$$\n\nTherefore, $a=1,$ $b=2,$ and $c=-3.$ Finally, \n\n$$\na+b+c=1+2+(-3)=0.\n$$"}]}
