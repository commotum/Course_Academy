 #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186355113} {:answer/id #uuid "a0ca1022-57ef-510a-a692-20c04cb6a494" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186356090} {:answer/id #uuid "c4b69677-a3c4-5a4a-8fd8-58a0444592ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186356380} {:answer/id #uuid "fe84379a-3267-576b-9bab-8baa1faa5368" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186356899}] :answer-field/correct {:answer/id #uuid "c4b69677-a3c4-5a4a-8fd8-58a0444592ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186356380} :answer-field/id #uuid "9ab27b24-a4f1-5208-81ee-7394385c2c05" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357192}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e96ec148-dcd3-5736-b705-6d0e6370e151" :question/math-academy-id "q-93968" :question/problem "The linear form $f(x)$ is defined as $f(x)=ax,$ where $a=[\\begin{aligned}6 & -1 & 1\\end{aligned}].$  Evaluate the function when $x=[\\begin{aligned}3 \\\\ 8 \\\\ -7\\end{aligned}].$" :question/worked-solution "Substituting $x=[\\begin{aligned}3 \\\\ 8 \\\\ -7\\end{aligned}],$ we obtain\n\n$$\n\\begin{aligned}f(x) & =ax \\\\  & =[\\begin{aligned}6 & -1 & 1\\end{aligned}]\\cdot [\\begin{aligned}3 \\\\ 8 \\\\ -7\\end{aligned}] \\\\  & =6\\cdot 3+(-1)\\cdot 8+1\\cdot (-7) \\\\  & =18-8-7 \\\\  & =3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186357606 :knowledge-point/_questions [{:db/id #edb/ref 17592186161981 :knowledge-point/id #uuid "7083d465-9871-59ca-97fa-583e740e961f" :knowledge-point/title "Evaluating a Bilinear Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ef13890-828e-5801-a252-a2d31844e36a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186354803} {:answer/id #uuid "2c4b73fa-5b35-5465-b2f4-143714eef4cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186355040} {:answer/id #uuid "47bb2c63-b162-504b-9017-48a2f388b960" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186355302} {:answer/id #uuid "a2e46ee5-50f0-57cb-bc2b-f369c695e46e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186356108} {:answer/id #uuid "c5437e71-1640-5851-ba9a-7230b9ae0812" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186356389}] :answer-field/correct {:answer/id #uuid "2c4b73fa-5b35-5465-b2f4-143714eef4cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186355040} :answer-field/id #uuid "490bdf07-2ddc-57de-a237-15240ed0a043" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357035}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0f0bce3e-c7ad-5cbe-a214-649d56d182b8" :question/math-academy-id "q-93977" :question/problem "$$\nA=[\\begin{aligned}\\,\\,-2 & 4 \\\\ \\,2 & 3\\end{aligned}]\n$$\n\nGiven the matrix $A$ above, evaluate the bilinear form $B(x,y)={x}^{T}\\,Ay$ when $x=[\\begin{aligned}3 \\\\ -1\\end{aligned}]$ and $y=[\\begin{aligned}1 \\\\ 4\\end{aligned}].$" :question/worked-solution "Substituting $x=[\\begin{aligned}3 \\\\ -1\\end{aligned}]$ and $y=[\\begin{aligned}1 \\\\ 4\\end{aligned}],$ we obtain   \n\n$$\n\\begin{aligned}B(x,y) & ={x}^{T}\\,Ay \\\\  & =[\\begin{aligned}3 & -1\\end{aligned}][\\begin{aligned}-2 & 4 \\\\ 2 & 3\\end{aligned}][\\begin{aligned}1 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}-8 & 9\\end{aligned}][\\begin{aligned}1 \\\\ 4\\end{aligned}] \\\\  & =28.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186357610 :knowledge-point/_questions [{:db/id #edb/ref 17592186161982 :knowledge-point/id #uuid "55277d69-eedc-5c5c-883a-083746e00947" :knowledge-point/title "Writing Down a Bilinear Form Given Its Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27f83b81-5cc0-57d4-a486-aa7a94c5375e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{x}_{1}{y}_{1}+2{x}_{1}{y}_{2}-{x}_{2}{y}_{1}+3{x}_{2}{y}_{2}" :db/id #edb/ref 17592186355001} {:answer/id #uuid "61faa07c-7bb7-52eb-b0c4-8944a52be8b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{x}_{1}{y}_{1}-{x}_{1}{y}_{2}+{x}_{2}{y}_{1}+3{x}_{2}{y}_{2}" :db/id #edb/ref 17592186355536} {:answer/id #uuid "86053994-8185-551b-889b-0fa792fd8526" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{x}_{1}{y}_{1}+{x}_{1}{y}_{2}-{x}_{2}{y}_{1}+3{x}_{2}{y}_{2}" :db/id #edb/ref 17592186355845} {:answer/id #uuid "c9c0332d-2d9c-5c3e-92d8-8236819f0c19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}_{1}{y}_{1}+{x}_{1}{y}_{2}-{x}_{2}{y}_{1}+2{x}_{2}{y}_{2}" :db/id #edb/ref 17592186356425} {:answer/id #uuid "db1dbfd2-d42d-5d8e-b330-5a4b8b982165" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}_{1}{y}_{1}+{x}_{1}{y}_{2}-2{x}_{2}{y}_{1}+3{x}_{2}{y}_{2}" :db/id #edb/ref 17592186356593}] :answer-field/correct {:answer/id #uuid "86053994-8185-551b-889b-0fa792fd8526" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{x}_{1}{y}_{1}+{x}_{1}{y}_{2}-{x}_{2}{y}_{1}+3{x}_{2}{y}_{2}" :db/id #edb/ref 17592186355845} :answer-field/id #uuid "2c4dd9bd-475e-5191-8fe7-38d4524d146a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186356990}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "09763352-7b89-5e95-8516-57e6bce8d181" :question/math-academy-id "q-93984" :question/problem "$$\nA=[\\begin{aligned}-2 & 1 \\\\ -1 & 3\\end{aligned}]\n$$\n\nConsider the matrix $A$ above. Which of the following represents the corresponding bilinear form ${x}^{T}\\,Ay$ in terms of the components of $x=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$ and $y=[\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}]?$" :question/worked-solution "**Method 1**\n\nEach entry ${a}_{ij}$ of $A$ corresponds to the term ${a}_{ij}{x}_{i}{y}_{j}$ in the expression of the bilinear form:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ay & =(-2){x}_{1}{y}_{1}+1{x}_{1}{y}_{2}+(-1){x}_{2}{y}_{1}+3{x}_{2}{y}_{2} \\\\  & =-2{x}_{1}{y}_{1}+{x}_{1}{y}_{2}-{x}_{2}{y}_{1}+3{x}_{2}{y}_{2}\\end{aligned}\n$$\n\n**Method 2**\n\nTo write down a bilinear form in terms of vector components, we compute the following expression:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ay & =[\\begin{aligned}{x}_{1} & {x}_{2}\\end{aligned}][\\begin{aligned}-2 & 1 \\\\ -1 & 3\\end{aligned}][\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}] \\\\  & =[\\begin{aligned}{x}_{1} & {x}_{2}\\end{aligned}][\\begin{aligned}-2{y}_{1}+{y}_{2} \\\\ -{y}_{1}+3{y}_{2}\\end{aligned}] \\\\  & ={x}_{1}(-2{y}_{1}+{y}_{2})+{x}_{2}(-{y}_{1}+3{y}_{2}) \\\\  & =-2{x}_{1}{y}_{1}+{x}_{1}{y}_{2}-{x}_{2}{y}_{1}+3{x}_{2}{y}_{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186357615 :knowledge-point/_questions [{:db/id #edb/ref 17592186161982 :knowledge-point/id #uuid "55277d69-eedc-5c5c-883a-083746e00947" :knowledge-point/title "Writing Down a Bilinear Form Given Its Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a7ba25b-c13d-5925-a2ef-d0f44fe78b5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{x}_{1}{y}_{1}-2{x}_{1}{y}_{2}-2{x}_{2}{y}_{1}+3{x}_{2}{y}_{2}" :db/id #edb/ref 17592186355021} {:answer/id #uuid "987657a3-9fac-53a5-9903-25a92423fb68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{x}_{1}{y}_{1}+2{x}_{1}{y}_{2}+2{x}_{2}{y}_{1}+3{x}_{2}{y}_{2}" :db/id #edb/ref 17592186356011} {:answer/id #uuid "a6a163c0-6928-5aff-94f8-da4ee68d485a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{x}_{1}{y}_{1}+2{x}_{1}{y}_{2}+3{x}_{2}{y}_{1}+2{x}_{2}{y}_{2}" :db/id #edb/ref 17592186356139} {:answer/id #uuid "e5e00cff-942b-5e00-b35e-dbcc54526642" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}_{1}{y}_{1}-2{x}_{1}{y}_{2}+2{x}_{2}{y}_{1}+3{x}_{2}{y}_{2}" :db/id #edb/ref 17592186356671} {:answer/id #uuid "ff14bba7-d2c8-50f6-ac9a-a9b2d3ffcf74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}_{1}{y}_{1}+2{x}_{1}{y}_{2}-2{x}_{2}{y}_{1}+3{x}_{2}{y}_{2}" :db/id #edb/ref 17592186356900}] :answer-field/correct {:answer/id #uuid "987657a3-9fac-53a5-9903-25a92423fb68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{x}_{1}{y}_{1}+2{x}_{1}{y}_{2}+2{x}_{2}{y}_{1}+3{x}_{2}{y}_{2}" :db/id #edb/ref 17592186356011} :answer-field/id #uuid "aa9552f5-221d-5abb-b816-150bd35582d4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357227}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9eb1f202-37a9-5513-9728-465e7c426c0d" :question/math-academy-id "q-93996" :question/problem "$$\nA=[\\begin{aligned}-2 & 2 \\\\ 2 & 3\\end{aligned}]\n$$\n\nConsider the matrix $A$ above. Which of the following represents the corresponding bilinear form ${x}^{T}\\,Ay$ in terms of the components of $x=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$ and $y=[\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}]?$" :question/worked-solution "**Method 1**\n\nEach entry ${a}_{ij}$ of $A$ corresponds to the term ${a}_{ij}{x}_{i}{y}_{j}$ in the expression of the bilinear form:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ay & =(-2){x}_{1}{y}_{1}+2{x}_{1}{y}_{2}+2{x}_{2}{y}_{1}+3{x}_{2}{y}_{2} \\\\  & =-2{x}_{1}{y}_{1}+2{x}_{1}{y}_{2}+2{x}_{2}{y}_{1}+3{x}_{2}{y}_{2}\\end{aligned}\n$$\n\n**Method 2**\n\nTo write down a bilinear form in terms of vector components, we compute the following expression:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ay & =[\\begin{aligned}{x}_{1} & {x}_{2}\\end{aligned}][\\begin{aligned}-2 & 2 \\\\ 2 & 3\\end{aligned}][\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}] \\\\  & =[\\begin{aligned}{x}_{1} & {x}_{2}\\end{aligned}][\\begin{aligned}-2{y}_{1}+2{y}_{2} \\\\ 2{y}_{1}+3{y}_{2}\\end{aligned}] \\\\  & ={x}_{1}(-2{y}_{1}+2{y}_{2})+{x}_{2}(2{y}_{1}+3{y}_{2}) \\\\  & =-2{x}_{1}{y}_{1}+2{x}_{1}{y}_{2}+2{x}_{2}{y}_{1}+3{x}_{2}{y}_{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186357632 :knowledge-point/_questions [{:db/id #edb/ref 17592186161983 :knowledge-point/id #uuid "f60cd05d-e4af-5bf1-8827-cab48da934f1" :knowledge-point/title "Finding the Matrix of a Bilinear Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d42be02-7f19-54e2-82cb-3df6ba35bc59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186355487} {:answer/id #uuid "64314b6b-2065-5485-b518-e241939c903f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186355558} {:answer/id #uuid "841f10b2-364e-5de9-b84b-f438f36993f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186355829} {:answer/id #uuid "8dd192af-d547-5d88-a769-5c1981af761c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186355914} {:answer/id #uuid "9768f61d-b930-53c9-bd10-f838eacea0aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186355997}] :answer-field/correct {:answer/id #uuid "9768f61d-b930-53c9-bd10-f838eacea0aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186355997} :answer-field/id #uuid "bfd66483-0f86-5977-b311-6db52cd032f6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357261}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "04f3f719-b108-5208-92b0-9457c6817de3" :question/math-academy-id "q-94045" :question/problem "$$\n[\\begin{aligned}a & b \\\\ -5 & -2\\end{aligned}]\n$$\n\nThe matrix of the bilinear form $B(x,y)=-4{x}_{1}{y}_{1}+3{x}_{1}{y}_{2}-5{x}_{2}{y}_{1}-2{x}_{2}{y}_{2}$ is given above. What is the value of $a+b?$" :question/worked-solution "Each term ${a}_{ij}{x}_{i}{y}_{j}$ in the expression of the bilinear form corresponds to the entry ${a}_{ij}$ of the matrix:\n\n$$\n\\begin{aligned}B(x,y) & =-4{x}_{1}{y}_{1}+3{x}_{1}{y}_{2}-5{x}_{2}{y}_{1}-2{x}_{2}{y}_{2} \\\\  & =(-4){x}_{1}{y}_{1}+\\,\\,3{x}_{1}{y}_{2} \\\\  & +\\,(-5){x}_{2}{y}_{1}\\,+(-2){x}_{2}{y}_{2}\\end{aligned}\n$$\n\n   \n\nThen, the corresponding matrix of the bilinear form is\n\n$$\n[\\begin{aligned}-4 & 3 \\\\ -5 & -2\\end{aligned}].\n$$\n\nTherefore, $a=-4$ and $b=3.$ Finally, \n\n$$\na+b=-4+3=-1.\n$$"}] [{:db/id #edb/ref 17592186357635 :knowledge-point/_questions [{:db/id #edb/ref 17592186161983 :knowledge-point/id #uuid "f60cd05d-e4af-5bf1-8827-cab48da934f1" :knowledge-point/title "Finding the Matrix of a Bilinear Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c017696-7edc-50b4-9035-1f3ce4d23b51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186355038} {:answer/id #uuid "3de97409-1c58-5b53-92bc-8e7f3b56e935" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186355217} {:answer/id #uuid "61088392-e274-50b7-bd68-e1e134fd198a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186355526} {:answer/id #uuid "cfc5825a-9c48-583a-8c9d-72bebfbc01da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186356480} {:answer/id #uuid "f6d93756-6a43-550f-9105-ceabaee133f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186356815}] :answer-field/correct {:answer/id #uuid "f6d93756-6a43-550f-9105-ceabaee133f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186356815} :answer-field/id #uuid "c1db56dc-7afb-5c75-8b54-941d34316501" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357266}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7c502fc9-407f-54ee-a63b-8ef283056af2" :question/math-academy-id "q-94052" :question/problem "$$\n[\\begin{aligned}a & 0 & 0 \\\\ 0 & b & 0 \\\\ 2 & 1 & c\\end{aligned}]\n$$\n\nThe matrix of the bilinear form $B(x,y)={x}_{1}{y}_{1}+2{x}_{2}{y}_{2}+2{x}_{3}{y}_{1}+{x}_{3}{y}_{2}-3{x}_{3}{y}_{3}$ is given above. What is the value of $a+b+c?$" :question/worked-solution "Each term ${a}_{ij}{x}_{i}{y}_{j}$ in the expression of the bilinear form corresponds to the entry ${a}_{ij}$ of the matrix:\n\n$$\n\\begin{aligned}B(x,y) & ={x}_{1}{y}_{1}+2{x}_{2}{y}_{2}+2{x}_{3}{y}_{1}+{x}_{3}{y}_{2}-3{x}_{3}{y}_{3} \\\\  & =1{x}_{1}{y}_{1}+0{x}_{1}{y}_{2}+0{x}_{1}{y}_{3} \\\\  & +\\,0{x}_{2}{y}_{1}+2{x}_{2}{y}_{2}+0{x}_{2}{y}_{3} \\\\  & +\\,2{x}_{3}{y}_{1}+1{x}_{3}{y}_{2}+(-3){x}_{3}{y}_{3}\\end{aligned}\n$$\n\nThen, the corresponding matrix of the bilinear form is\n\n$$\n[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 2 & 1 & -3\\end{aligned}].\n$$\n\nTherefore, $a=1,$ $b=2,$ and $c=-3.$ Finally, \n\n$$\na+b+c=1+2+(-3)=0.\n$$"}]}
