  "live_records": {
    "q-93900": {
      "dom_id": "step-q93900",
      "name": "Question 1",
      "problem": "The linear form $f(x)$ is defined as $f(x)=ax,$ where $a=[\\begin{aligned}-2 & 1\\end{aligned}].$   Evaluate the function when $x=[\\begin{aligned}-6 \\\\ -8\\end{aligned}].$",
      "worked_solution": "Substituting $x=[\\begin{aligned}-6 \\\\ -8\\end{aligned}],$ we obtain \n\n$$\n\\begin{aligned}f(x) & =ax \\\\  & =[\\begin{aligned}-2 & 1\\end{aligned}]\\cdot [\\begin{aligned}-6 \\\\ -8\\end{aligned}] \\\\  & =(-2)\\cdot (-6)+1\\cdot (-8) \\\\  & =12-8 \\\\  & =4.\\end{aligned}\n$$",
      "calculator_instructions": "",
