\"right left\" columnspacing=\"0em\" rowspacing=\"0.6em 0.6em 0.6em 0.3em\"><mtr><mtd><mi>B</mi><mo stretchy=\"false\">(</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">x</mi></mrow><mo>,</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">y</mi></mrow><mo stretchy=\"false\">)</mo></mtd><mtd><mi></mi><mo>=</mo><mn>2</mn><msub><mi>x</mi><mn>1</mn></msub><msub><mi>y</mi><mn>2</mn></msub><mo>+</mo><msub><mi>x</mi><mn>1</mn></msub><msub><mi>y</mi><mn>3</mn></msub><mo>−</mo><mn>3</mn><msub><mi>x</mi><mn>2</mn></msub><msub><mi>y</mi><mn>2</mn></msub><mo>+</mo><mn>2</mn><msub><mi>x</mi><mn>3</mn></msub><msub><mi>y</mi><mn>1</mn></msub></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>2</mn><mo>⋅</mo><mn>3</mn><mo>⋅</mo><mn>5</mn><mo>+</mo><mn>3</mn><mo>⋅</mo><mn>2</mn><mo>−</mo><mn>3</mn><mo>⋅</mo><mn>1</mn><mo>⋅</mo><mn>5</mn><mo>+</mo><mn>2</mn><mo>⋅</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mn>2</mn><mo stretchy=\"false\">)</mo><mo>⋅</mo><mn>0</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>30</mn><mo>+</mo><mn>6</mn><mo>−</mo><mn>15</mn><mo>+</mo><mn>0</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>21.</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
