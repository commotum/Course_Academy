#{[{:db/id #edb/ref 17592186367226 :knowledge-point/_questions [{:db/id #edb/ref 17592186119827 :knowledge-point/id #uuid "d44cf726-a4a6-5ac9-a63c-7464fe5566c5" :knowledge-point/title "Finding the Cartesian Equation of a Line Given in Parametric or Vector Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d9e78327-b43d-5969-8d3b-bed4609b49e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-2}{-5}=\\frac{y+3}{2}=\\frac{z-7}{-1}" :db/id #edb/ref 17592186367228} {:answer/id #uuid "415707ec-16c3-52eb-ae48-60f27d55babf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-2}{-1}=\\frac{y+3}{2}=\\frac{z-7}{-5}" :db/id #edb/ref 17592186367229} {:answer/id #uuid "ace39f4a-2512-5b36-8884-7fa037704cfc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+5}{2}=\\frac{y-2}{-3}=\\frac{z+1}{7}" :db/id #edb/ref 17592186367230} {:answer/id #uuid "e8680259-b972-51c1-a413-a39306c9e5d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+2}{-5}=\\frac{y+3}{2}=\\frac{z+7}{1}" :db/id #edb/ref 17592186367231} {:answer/id #uuid "e0439e86-3ea3-5b81-8a8b-d0a949ba059f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+5}{3}=\\frac{y-2}{-2}=\\frac{z+1}{7}" :db/id #edb/ref 17592186367232}] :answer-field/correct {:answer/id #uuid "d9e78327-b43d-5969-8d3b-bed4609b49e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-2}{-5}=\\frac{y+3}{2}=\\frac{z-7}{-1}" :db/id #edb/ref 17592186367228} :answer-field/id #uuid "4010e133-bb74-590a-aaad-0744ebb64de5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186367227}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "841b2c54-bf92-5c9a-835e-03e5b492bd88" :question/math-academy-id "q-127408" :question/problem "Consider the straight line with the vector equation\n\n$$\nr=[\\begin{aligned}2 \\\\ -3 \\\\ 7\\end{aligned}]+t[\\begin{aligned}-5 \\\\ 2 \\\\ -1\\end{aligned}]\n$$\n\nfor $t\\in (-\\infty ,\\infty ).$ Find the Cartesian equation of this line." :question/worked-solution "We have the vector equation \n\n$$\nr=[\\begin{aligned}2 \\\\ -3 \\\\ 7\\end{aligned}]+t[\\begin{aligned}-5 \\\\ 2 \\\\ -1\\end{aligned}],\\,t\\in (-\\infty ,\\infty ).\n$$\n\nThis implies that the straight line passes through the point $P(2,-3,7)$ and is parallel to the vector $v=⟨-5,2,-1⟩.$ So, its Cartesian (canonical) equation is given by\n\n$$\n\\frac{x-2}{-5}=\\frac{y-(-3)}{2}=\\frac{z-7}{-1}=t,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nSimplifying, we reach\n\n$$\n\\frac{x-2}{-5}=\\frac{y+3}{2}=\\frac{z-7}{-1}.\n$$"}] [{:db/id #edb/ref 17592186447025 :knowledge-point/_questions [{:db/id #edb/ref 17592186119828 :knowledge-point/id #uuid "cbc74baa-313b-51e7-8ae1-5e9fe0761256" :knowledge-point/title "Finding the Cartesian Equation of a Line Given Two Points on the Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34899314-00b5-5497-adbb-b71a1ac21237" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-1}{4}=\\frac{y-3}{-4}=\\frac{z-7}{6}" :db/id #edb/ref 17592186447013} {:answer/id #uuid "3aff6a90-29cb-5fbb-a280-7d4c79fc7881" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+1}{4}=\\frac{y+3}{4}=\\frac{z-7}{6}" :db/id #edb/ref 17592186447014} {:answer/id #uuid "6083d104-e8d5-54a9-91d4-825774ce35f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-1}{-4}=\\frac{y-3}{-4}=\\frac{z+7}{-6}" :db/id #edb/ref 17592186447016} {:answer/id #uuid "a3f8e739-90fc-54a0-8ff2-caa9d9c9da58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-1}{-6}=\\frac{y+3}{4}=\\frac{z-7}{-4}" :db/id #edb/ref 17592186447019} {:answer/id #uuid "e6c04908-246a-5ae0-92f2-f471b0d7a518" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+1}{4}=\\frac{y-3}{-4}=\\frac{z-7}{-6}" :db/id #edb/ref 17592186447021}] :answer-field/correct {:answer/id #uuid "e6c04908-246a-5ae0-92f2-f471b0d7a518" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+1}{4}=\\frac{y-3}{-4}=\\frac{z-7}{-6}" :db/id #edb/ref 17592186447021} :answer-field/id #uuid "58349fdc-d11c-5b54-9386-0a54b8d936ea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186447023}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "61ab7a4c-ae26-516b-9967-3f8072e6be8b" :question/math-academy-id "q-127468" :question/problem "![](images/01/01943e80947c833ef37241fb836db96afd61731b9873cd061277a7453b34f3d8.png)\n\nFind a Cartesian equation of the line shown in the figure above." :question/worked-solution "We know that the line passes through the points $P(-1,3,7)$ and $Q(3,-1,1).$ Now, we need to find a vector parallel to the given line. Let's consider the vector $\\overset{\\to }{PQ}$ which is given by\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨3,-1,1⟩-⟨-1,3,7⟩ \\\\  & =⟨4,-4,-6⟩.\\end{aligned}\n$$\n\nUsing the point $P$ and the vector $\\overset{\\to }{PQ}$, we have that the Cartesian (canonical) equation of the given line is given by\n\n$$\n\\frac{x-(-1)}{4}=\\frac{y-3}{-4}=\\frac{z-7}{-6}=t,\\,t\\in (-\\infty ,\\infty ),\n$$\n\nor equivalently\n\n$$\n\\frac{x+1}{4}=\\frac{y-3}{-4}=\\frac{z-7}{-6}.\n$$"}] [{:db/id #edb/ref 17592186262792 :knowledge-point/_questions [{:db/id #edb/ref 17592186119828 :knowledge-point/id #uuid "cbc74baa-313b-51e7-8ae1-5e9fe0761256" :knowledge-point/title "Finding the Cartesian Equation of a Line Given Two Points on the Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "628ba019-e287-5e6c-9c20-0bd08a8d96f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-2}{-2}=\\frac{y+1}{-4},\\,z=-3" :db/id #edb/ref 17592186260725} {:answer/id #uuid "b5e6a649-3a81-512d-94bb-f14eb562c95d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-2}{2}=\\frac{y+1}{-2},\\,z=3" :db/id #edb/ref 17592186261472} {:answer/id #uuid "c7117f4f-8b9b-5207-8fcb-870aceb867f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+2}{2}=\\frac{y+1}{4},\\,z=3" :db/id #edb/ref 17592186261635} {:answer/id #uuid "e335a903-50df-50af-bbcb-1934b2874ec6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-2}{-2}=\\frac{y+1}{4},\\,z=3" :db/id #edb/ref 17592186261871} {:answer/id #uuid "f563cde3-4746-533c-bf25-d120ecc2da8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-2}{2}=\\frac{y-1}{-4},\\,z=-3" :db/id #edb/ref 17592186262020}] :answer-field/correct {:answer/id #uuid "b5e6a649-3a81-512d-94bb-f14eb562c95d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-2}{2}=\\frac{y+1}{-2},\\,z=3" :db/id #edb/ref 17592186261472} :answer-field/id #uuid "1c9a7cd2-cbdc-54f5-8320-283acf5adf7b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262169}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b6f2a4e2-bb20-56c7-957d-47666291e84e" :question/math-academy-id "q-127527" :question/problem "![](images/87/8722b93655e069e2f35147b572c16ed7af408a86f8a88597c79aea8fe59e9c4d.png)\n\nFind a Cartesian equation of the line shown in the figure above." :question/worked-solution "We know that the line passes through the points $P(2,-1,3)$ and $Q(4,-3,3).$ Now, we need to find a vector parallel to the given line. Let's consider the vector $\\overset{\\to }{PQ}$ which is given by\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨4,-3,3⟩-⟨2,-1,3⟩ \\\\  & =⟨2,-2,0⟩.\\end{aligned}\n$$\n\nUsing the point $P$ and the vector $\\overset{\\to }{PQ}$, we have that the Cartesian (canonical) equation of the given line is given by\n\n$$\n\\frac{x-2}{2}=\\frac{y-(-1)}{-2}=\\frac{z-3}{0}=t,\\,t\\in (-\\infty ,\\infty ),\n$$\n\nor equivalently\n\n$$\n\\frac{x-2}{2}=\\frac{y+1}{-2}=\\frac{z-3}{0}.\n$$\n\nBut the above equation is problematic because $\\frac{z-3}{0}$ involves division by zero.\n\nHowever, in our line, the $z$ component always maintains the constant value of $z=3.$ For example, our two points $P(2,-1,3)$ and $Q(4,-3,3)$ both have $z$-coordinates of $z=3.$\n\nSo, in the Cartesian equation, we remove the $\\frac{z-3}{0}$ part and instead write $z=3,$ as follows:\n\n$$\n\\frac{x-2}{2}=\\frac{y+1}{-2},\\,z=3.\n$$"}] [{:db/id #edb/ref 17592186338882 :knowledge-point/_questions [{:db/id #edb/ref 17592186119842 :knowledge-point/id #uuid "07c209a4-5c69-561e-9015-28b0f6e436e5" :knowledge-point/title "Finding the Cartesian Equation of a Line When a Component of the Direction Vector is Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c0fb049-79eb-55e2-a0ca-4fdfc5e2665f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-7}{-3}=\\frac{y+9}{2},\\,z=11" :db/id #edb/ref 17592186336144} {:answer/id #uuid "aaeb2205-47f3-5952-a1db-f53aaf324af1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+3}{7}=\\frac{y-2}{-9},\\,z=0" :db/id #edb/ref 17592186337572} {:answer/id #uuid "bf5d36b6-450f-5f52-a838-c89ca6718db3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-7}{-3}=z-11,\\,y=-9" :db/id #edb/ref 17592186337732} {:answer/id #uuid "c8b304a4-4128-55d7-9b97-804366ca23bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+7}{-3}=\\frac{y-9}{2},\\,z=-11" :db/id #edb/ref 17592186337806} {:answer/id #uuid "d10667a1-fec6-59c1-a83d-dc77b0c42b34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-7}{-3}=\\frac{y+9}{2}=z-11" :db/id #edb/ref 17592186337862}] :answer-field/correct {:answer/id #uuid "0c0fb049-79eb-55e2-a0ca-4fdfc5e2665f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-7}{-3}=\\frac{y+9}{2},\\,z=11" :db/id #edb/ref 17592186336144} :answer-field/id #uuid "1f571153-e1e5-51d4-9174-5e999fd92b23" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338335}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4f24fb14-8cf2-586c-8b58-d1952f0a20ca" :question/math-academy-id "q-71039" :question/problem "Find the Cartesian equation for the line with the following vector equation:\n\n$$\nr=[\\begin{aligned}7 \\\\ -9 \\\\ 11\\end{aligned}]+t[\\begin{aligned}-3 \\\\ 2 \\\\ 0\\end{aligned}],\\,t\\in (-\\infty ,\\infty )\n$$" :question/worked-solution "Using the usual formula, we get\n\n$$\n\\frac{x-7}{-3}=\\frac{y-(-9)}{2}=\\frac{z-11}{0}=t,\\,t\\in (-\\infty ,\\infty ),\n$$\n\nor equivalently\n\n$$\n\\frac{x-7}{-3}=\\frac{y+9}{2}=\\frac{z-11}{0},\n$$\n\nwhich is problematic because $\\frac{z-11}{0}$ involves division by zero.\n\nHowever, notice that in our line, the $z$ component always maintains the constant value of $z=11:$\n\n$$\nr=[\\begin{aligned}7-3t \\\\ -9+2t \\\\ 11\\end{aligned}],\\,t\\in (-\\infty ,\\infty )\n$$\n\nSo, in the Cartesian equation, we remove the $\\frac{z-11}{0}$ part and instead write $z=11$, as follows:\n\n$$\n\\frac{x-7}{-3}=\\frac{y+9}{2},\\,z=11\n$$"}] [{:db/id #edb/ref 17592186447024 :knowledge-point/_questions [{:db/id #edb/ref 17592186119842 :knowledge-point/id #uuid "07c209a4-5c69-561e-9015-28b0f6e436e5" :knowledge-point/title "Finding the Cartesian Equation of a Line When a Component of the Direction Vector is Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bbe3ab9-a7ef-5513-96b0-4bb81eecfdf5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y-3}{5}=z-2,\\,x=0" :db/id #edb/ref 17592186447012} {:answer/id #uuid "58eab78c-4412-5b45-b6ad-1d2c084a66a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+4=\\frac{z-1}{2},\\,y=5" :db/id #edb/ref 17592186447015} {:answer/id #uuid "7287e364-e5ae-5892-9f4f-1be7926ae48e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y-5}{3}=\\frac{z-1}{2},=x+4" :db/id #edb/ref 17592186447017} {:answer/id #uuid "77cf8edb-f11a-593d-b22b-70517358473d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y+5}{3}=\\frac{z+1}{2},\\,x=4" :db/id #edb/ref 17592186447018} {:answer/id #uuid "bd35653f-734b-565e-9879-e2cd580e5dfd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y-5}{3}=\\frac{z-1}{2},\\,x=-4" :db/id #edb/ref 17592186447020}] :answer-field/correct {:answer/id #uuid "bd35653f-734b-565e-9879-e2cd580e5dfd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y-5}{3}=\\frac{z-1}{2},\\,x=-4" :db/id #edb/ref 17592186447020} :answer-field/id #uuid "1aa198ef-bba1-5d57-9850-a75e16ce7498" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186447022}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "47833d2d-e4b4-5480-a72b-ba5cccc746dd" :question/math-academy-id "q-71043" :question/problem "Find the Cartesian equation for the line with the following vector equation:\n\n$$\nr=[\\begin{aligned}-4 \\\\ 5 \\\\ 1\\end{aligned}]+t[\\begin{aligned}0 \\\\ 3 \\\\ 2\\end{aligned}],\\,t\\in (-\\infty ,\\infty )\n$$" :question/worked-solution "Using the usual formula, we get\n\n$$\n\\frac{x-(-4)}{0}=\\frac{y-5}{3}=\\frac{z-1}{2}=t,\\,t\\in (-\\infty ,\\infty ),\n$$\n\nor equivalently\n\n$$\n\\frac{x+4}{0}=\\frac{y-5}{3}=\\frac{z-1}{2},\n$$\n\nwhich is problematic because $\\frac{x+4}{0}$ involves division by zero.\n\nHowever, notice that in our line, the $x$ component always maintains the constant value of $x=-4:$\n\n$$\nr=[\\begin{aligned}-4 \\\\ 5+3t \\\\ 1+2t\\end{aligned}],\\,t\\in (-\\infty ,\\infty )\n$$\n\nSo, in the Cartesian equation, we remove the $\\frac{x+4}{0}$ part and instead write $x=-4$, as follows:\n\n$$\n\\frac{y-5}{3}=\\frac{z-1}{2},\\,x=-4\n$$"}]}
