#{[{:db/id #edb/ref 17592186553561 :knowledge-point/_questions [{:db/id #edb/ref 17592186204077 :knowledge-point/id #uuid "d786586f-cacb-5781-86ff-cc8acf311dcf" :knowledge-point/title "Computing the Total Derivative of a Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "064362e4-1172-5328-8b38-693aa1baa195" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 3\\end{aligned}]" :db/id #edb/ref 17592186552875} {:answer/id #uuid "7f2a84d4-3209-521d-95d8-238b2392ab32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186553125} {:answer/id #uuid "99a421f0-37bb-5df0-9f7e-208e7a1000ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2{x}_{1} \\\\ 3{x}_{2}^{2}\\end{aligned}]" :db/id #edb/ref 17592186553180} {:answer/id #uuid "a7bc33e0-600d-5025-8bea-89a458700651" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2{x}_{1}+{x}_{2}^{3} & {x}_{1}^{2}+3{x}_{2}^{2}\\end{aligned}]" :db/id #edb/ref 17592186553204} {:answer/id #uuid "c04eb3ec-514c-5137-b2b9-aebfbff94a76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2{x}_{1} & 3{x}_{2}^{2}\\end{aligned}]" :db/id #edb/ref 17592186553251}] :answer-field/correct {:answer/id #uuid "c04eb3ec-514c-5137-b2b9-aebfbff94a76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2{x}_{1} & 3{x}_{2}^{2}\\end{aligned}]" :db/id #edb/ref 17592186553251} :answer-field/id #uuid "f9027672-89dd-5956-be1e-019b2d653102" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186553486}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a75d383a-395b-563b-8f65-088c9a838675" :question/math-academy-id "q-269507" :question/problem "Consider the function $f:{R}^{2}\\to R$ defined by $f(x)={x}_{1}^{2}+{x}_{2}^{3}.$ What is the total derivative of $f$ with respect to $x=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]?$" :question/worked-solution "The total derivative of a scalar-valued function $f:{R}^{n}\\to R$ with respect to a vector $x\\in {R}^{n}$ is the row vector\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=[\\begin{aligned}\\frac{∂f}{∂{x}_{1}} & \\frac{∂f}{∂{x}_{2}} & ⋯ & \\frac{∂f}{∂{x}_{n}}\\end{aligned}]\\in {R}^{1\\times n}.\n$$\n\nIn our case, the function \n\n- acts on a vector $x\\in {R}^{2},$ and\n\n- outputs a scalar $f(x)\\in R$ defined by \n\n$$\nf(x)={x}_{1}^{2}+{x}_{2}^{3}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =[\\begin{aligned}\\frac{∂f}{∂{x}_{1}} & \\frac{∂f}{∂{x}_{2}}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{∂}{∂{x}_{1}}({x}_{1}^{2}+{x}_{2}^{3}) & \\frac{∂}{∂{x}_{2}}({x}_{1}^{2}+{x}_{2}^{3})\\end{aligned}] \\\\  & =[\\begin{aligned}2{x}_{1} & 3{x}_{2}^{2}\\end{aligned}]\\in {R}^{1\\times 2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186553528 :knowledge-point/_questions [{:db/id #edb/ref 17592186204077 :knowledge-point/id #uuid "d786586f-cacb-5781-86ff-cc8acf311dcf" :knowledge-point/title "Computing the Total Derivative of a Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29e1642d-a951-5365-bcfa-1c8270b0b3a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 & 1 & 0 \\\\ 0 & -2 & 3\\end{aligned}]" :db/id #edb/ref 17592186552944} {:answer/id #uuid "519c1c5e-eb11-5bef-a5d1-8d588bcd535e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 3 \\\\ 1 & -2 \\\\ 5 & 0\\end{aligned}]" :db/id #edb/ref 17592186553044} {:answer/id #uuid "779eef84-8b8d-52e1-be92-129fe96b377d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 & 1 & 0\\end{aligned}]" :db/id #edb/ref 17592186553110} {:answer/id #uuid "7a42af84-2ac9-5199-a176-ab33dbb85109" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 \\\\ -1 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186553119} {:answer/id #uuid "bb7906b9-198c-5f56-83a9-2095603d17cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 & 0 \\\\ 1 & -2 \\\\ 0 & 3\\end{aligned}]" :db/id #edb/ref 17592186553240}] :answer-field/correct {:answer/id #uuid "bb7906b9-198c-5f56-83a9-2095603d17cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 & 0 \\\\ 1 & -2 \\\\ 0 & 3\\end{aligned}]" :db/id #edb/ref 17592186553240} :answer-field/id #uuid "075c7ff4-2ca7-546f-abe5-5b7be8c7c6fc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186553379}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "63af40a1-e373-588a-a15a-0cad7e71e5cc" :question/math-academy-id "q-269548" :question/problem "Consider the vector-valued function $f:{R}^{2}\\to {R}^{3}$ defined by\n\n$$\nf(x)=[\\begin{aligned}5 & 0 \\\\ 1 & -2 \\\\ 0 & 3\\end{aligned}]x.\n$$\n\n \n\nWhat is $\\frac{\\text{d}f}{\\text{d}x},$ the total derivative of $f$ with respect to $x=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]?$" :question/worked-solution "The total derivative of a vector-valued function $f:{R}^{n}\\to {R}^{m}$ with respect to a vector $x\\in {R}^{n}$ is the $m\\times n$ matrix\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=[\\begin{aligned}\\frac{∂{f}_{1}}{∂{x}_{1}} & \\frac{∂{f}_{1}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{1}}{∂{x}_{n}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & \\frac{∂{f}_{2}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{2}}{∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋱ & ⋮ \\\\ \\frac{∂{f}_{m}}{∂{x}_{1}} & \\frac{∂{f}_{m}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{m}}{∂{x}_{n}}\\end{aligned}]\\in {R}^{m\\times n}.\n$$\n\nIn our case, writing out the function $f(x)$ where $x=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]\\in {R}^{2}$, we get\n\n$$\nf(x)=[\\begin{aligned}5 & 0 \\\\ 1 & -2 \\\\ 0 & 3\\end{aligned}]\\cdot [\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]=[\\begin{aligned}5{x}_{1} \\\\ {x}_{1}-2{x}_{2} \\\\ 3{x}_{2}\\end{aligned}].\n$$\n\nSo, the total derivative is\n\n$$\n\\begin{aligned}\\,\\,\\,\\frac{\\text{d}f}{\\text{d}x} & =[\\begin{aligned}\\frac{∂{f}_{1}}{∂{x}_{1}} & \\frac{∂{f}_{1}}{∂{x}_{2}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & \\frac{∂{f}_{2}}{∂{x}_{2}} \\\\ \\frac{∂{f}_{3}}{∂{x}_{1}} & \\frac{∂{f}_{3}}{∂{x}_{2}}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{∂}{∂{x}_{1}}(5{x}_{1}) & \\frac{∂}{∂{x}_{2}}(5{x}_{1}) \\\\ \\frac{∂}{∂{x}_{1}}({x}_{1}-2{x}_{2}) & \\frac{∂}{∂{x}_{2}}({x}_{1}-2{x}_{2}) \\\\ \\frac{∂}{∂{x}_{1}}(3{x}_{2}) & \\frac{∂}{∂{x}_{2}}(3{x}_{2})\\end{aligned}] \\\\  & =[\\begin{aligned}5 & 0 \\\\ 1 & -2 \\\\ 0 & 3\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186553584 :knowledge-point/_questions [{:db/id #edb/ref 17592186204077 :knowledge-point/id #uuid "d786586f-cacb-5781-86ff-cc8acf311dcf" :knowledge-point/title "Computing the Total Derivative of a Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56b71a8d-8ee4-534d-8ff6-78d1bb064b70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 1 \\\\ 4 & 0 \\\\ 1 & 3 \\\\ 2 & 5\\end{aligned}]" :db/id #edb/ref 17592186553053} {:answer/id #uuid "91ede33f-ec6e-5b0f-85d8-8d21aafdea41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 2 \\\\ 3 & 2 \\\\ 6 & 5 \\\\ 4 & 5\\end{aligned}]" :db/id #edb/ref 17592186553163} {:answer/id #uuid "bb800b06-575b-528f-9ff7-82092032f43c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 16 \\\\ 4 & 4 \\\\ 12 & 16 \\\\ 0 & 4\\end{aligned}]" :db/id #edb/ref 17592186553241} {:answer/id #uuid "c65e46ec-65a2-5652-974d-2253a0e92953" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 2 \\\\ 1 & 2 \\\\ 6 & 5 \\\\ 4 & 5\\end{aligned}]" :db/id #edb/ref 17592186553262} {:answer/id #uuid "ff18ad35-d86e-5e26-8a5d-2ecdd455b6f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 2 \\\\ 3 & 2 \\\\ 4 & 5 \\\\ 6 & 5\\end{aligned}]" :db/id #edb/ref 17592186553374}] :answer-field/correct {:answer/id #uuid "ff18ad35-d86e-5e26-8a5d-2ecdd455b6f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 2 \\\\ 3 & 2 \\\\ 4 & 5 \\\\ 6 & 5\\end{aligned}]" :db/id #edb/ref 17592186553374} :answer-field/id #uuid "6518c394-70d2-5d31-8d6a-aaa22b67295d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186553422}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e86c609f-69e3-5722-94f9-81733ff82960" :question/math-academy-id "q-269557" :question/problem "Consider the vector-valued function $f:{R}^{2}\\to {R}^{4}$ defined by\n\n$$\nf(x)=[\\begin{aligned}1 & 2 \\\\ 3 & 2 \\\\ 4 & 5 \\\\ 6 & 5\\end{aligned}]x.\n$$\n\n \n\nWhat is $\\frac{\\text{d}f}{\\text{d}x},$ the total derivative of $f$ with respect to $x$ at ${x}_{0}=[\\begin{aligned}4 \\\\ 4\\end{aligned}]?$" :question/worked-solution "The total derivative of a vector-valued function $f:{R}^{n}\\to {R}^{m}$ with respect to a vector $x\\in {R}^{n}$ is the $m\\times n$ matrix\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=[\\begin{aligned}\\frac{∂{f}_{1}}{∂{x}_{1}} & \\frac{∂{f}_{1}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{1}}{∂{x}_{n}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & \\frac{∂{f}_{2}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{2}}{∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋱ & ⋮ \\\\ \\frac{∂{f}_{m}}{∂{x}_{1}} & \\frac{∂{f}_{m}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{m}}{∂{x}_{n}}\\end{aligned}]\\in {R}^{m\\times n}.\n$$\n\nIn our case, writing out the function $f(x)$ where $x=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]\\in {R}^{2}$, we get\n\n$$\nf(x)=[\\begin{aligned}1 & 2 \\\\ 3 & 2 \\\\ 4 & 5 \\\\ 6 & 5\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]=[\\begin{aligned}{x}_{1}+2{x}_{2} \\\\ 3{x}_{1}+2{x}_{2} \\\\ 4{x}_{1}+5{x}_{2} \\\\ 6{x}_{1}+5{x}_{2}\\end{aligned}].\n$$\n\nSo, the total derivative is\n\n$$\n\\begin{aligned}\\,\\,\\,\\frac{\\text{d}f}{\\text{d}x} & =[\\begin{aligned}\\frac{∂{f}_{1}}{∂{x}_{1}} & \\frac{∂{f}_{1}}{∂{x}_{2}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & \\frac{∂{f}_{2}}{∂{x}_{2}} \\\\ \\frac{∂{f}_{3}}{∂{x}_{1}} & \\frac{∂{f}_{3}}{∂{x}_{2}} \\\\ \\frac{∂{f}_{4}}{∂{x}_{1}} & \\frac{∂{f}_{4}}{∂{x}_{2}}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{∂}{∂{x}_{1}}({x}_{1}+2{x}_{2}) & \\frac{∂}{∂{x}_{2}}({x}_{1}+2{x}_{2}) \\\\ \\frac{∂}{∂{x}_{1}}(3{x}_{1}+2{x}_{2}) & \\frac{∂}{∂{x}_{2}}(3{x}_{1}+2{x}_{2}) \\\\ \\frac{∂}{∂{x}_{1}}(4{x}_{1}+5{x}_{2}) & \\frac{∂}{∂{x}_{2}}(4{x}_{1}+5{x}_{2}) \\\\ \\frac{∂}{∂{x}_{1}}(6{x}_{1}+5{x}_{2}) & \\frac{∂}{∂{x}_{2}}(6{x}_{1}+5{x}_{2})\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 2 \\\\ 3 & 2 \\\\ 4 & 5 \\\\ 6 & 5\\end{aligned}].\\end{aligned}\n$$\n\nSince the total derivative is a constant matrix, evaluating it at ${x}_{0}=[\\begin{aligned}4 \\\\ 4\\end{aligned}]$ gives the same matrix."}] [{:db/id #edb/ref 17592186553556 :knowledge-point/_questions [{:db/id #edb/ref 17592186204078 :knowledge-point/id #uuid "15fada7f-4a9a-5e72-9699-694e302beef3" :knowledge-point/title "Computing a 3-Tensor Derivative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7019131b-9402-5521-a32e-57231209147d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186553099}] :answer-field/correct {:answer/id #uuid "7019131b-9402-5521-a32e-57231209147d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186553099} :answer-field/id #uuid "b28e8121-9af9-52a0-b859-1492c6936f8f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186553460}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9948bdcd-742f-571f-96d0-1bd2c32c8fbf" :question/math-academy-id "q-269652" :question/problem "Consider a function $f:{R}^{2\\times 3}\\to {R}^{2}$ defined by\n\n$$\nf(A)=A[\\begin{aligned}3 \\\\ 2 \\\\ 1\\end{aligned}].\n$$\n\nGiven that ${a}_{ij}$ denotes the entry of $A$ in the intersection of the $i$th row and $j$th column, we have\n\n$\\frac{∂{f}_{2}}{∂{a}_{12}}=${{field-1}}." :question/worked-solution "We can write the function $f$ as\n\n$$\nf(A)=[\\begin{aligned}{a}_{11} & {a}_{12} & {a}_{13} \\\\ {a}_{21} & {a}_{22} & {a}_{23}\\end{aligned}][\\begin{aligned}3 \\\\ 2 \\\\ 1\\end{aligned}]=[\\begin{aligned}3{a}_{11}+2{a}_{12}+{a}_{13} \\\\ 3{a}_{21}+2{a}_{22}+{a}_{23}\\end{aligned}].\n$$\n\nThus,\n\n$$\n\\frac{∂{f}_{2}}{∂{a}_{12}}=\\frac{∂}{∂{a}_{13}}(3{a}_{21}+2{a}_{22}+{a}_{23})=0.\n$$"}] [{:db/id #edb/ref 17592186553591 :knowledge-point/_questions [{:db/id #edb/ref 17592186204078 :knowledge-point/id #uuid "15fada7f-4a9a-5e72-9699-694e302beef3" :knowledge-point/title "Computing a 3-Tensor Derivative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3679c42b-4a13-5846-ba02-647214c69bf1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186552973}] :answer-field/correct {:answer/id #uuid "3679c42b-4a13-5846-ba02-647214c69bf1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186552973} :answer-field/id #uuid "77e677bc-abeb-5bb6-bf03-5c9c94891cbe" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186553433}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ffba6d3e-e7c1-5d0c-b946-5bae6cef7f3f" :question/math-academy-id "q-269859" :question/problem "Consider a function $f:{R}^{4\\times 3}\\to {R}^{3}$ defined by\n\n$$\nf(A)=[\\begin{aligned}1 & 2 & -1 & 3\\end{aligned}]A.\n$$\n\nGiven that ${a}_{ij}$ denotes the entry of $A$ in the intersection of the $i$th row and $j$th column, we have\n\n$\\frac{∂{f}_{2}}{∂{a}_{32}}=${{field-1}}." :question/worked-solution "We can write the function $f$ as\n\n$$\n\\begin{aligned}f(A) & =[\\begin{aligned}1 & 2 & -1 & 3\\end{aligned}][\\begin{aligned}{a}_{11} & {a}_{12} & {a}_{13} \\\\ {a}_{21} & {a}_{22} & {a}_{23} \\\\ {a}_{31} & {a}_{32} & {a}_{33} \\\\ {a}_{41} & {a}_{42} & {a}_{43}\\end{aligned}] \\\\  & =[\\begin{aligned}{a}_{11}+2{a}_{21}-{a}_{31}+3{a}_{41}\\,\\, & {a}_{12}+2{a}_{22}-{a}_{32}+3{a}_{42}\\,\\, & {a}_{13}+2{a}_{23}-{a}_{33}+3{a}_{43}\\end{aligned}].\\end{aligned}\n$$\n\nThus,\n\n$$\n\\begin{aligned}\\frac{∂{f}_{2}}{∂{a}_{32}} & =\\frac{∂}{∂{a}_{32}}({a}_{12}+2{a}_{22}-{a}_{32}+3{a}_{42})=-1.\\end{aligned}\n$$"}]}
