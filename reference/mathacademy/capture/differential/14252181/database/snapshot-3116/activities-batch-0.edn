#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186193663} :activity/id #uuid "d93075cf-1282-5b7f-b71d-4c5f5fd85e47" :activity/scope {:db/id #edb/ref 17592186048621 :topic/id #uuid "af65e753-6f2e-5d89-8c0d-d3d5df2fc680" :topic/math-academy-id 4063} :activity/steps [{:db/id #edb/ref 17592186193662 :step/content {:db/id #edb/ref 17592186192786 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192510 :question/id #uuid "00b0d838-163d-5299-beaf-255f9b13cf71" :question/math-academy-id "e-11034"} :knowledge-point/id #uuid "a024c46e-0374-5d03-b895-eb754ff7ad97" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048681} {:db/id #edb/ref 17592186048899} {:db/id #edb/ref 17592186050923} {:db/id #edb/ref 17592186051033}] :knowledge-point/questions [{:db/id #edb/ref 17592186193206} {:db/id #edb/ref 17592186193207} {:db/id #edb/ref 17592186278571} {:db/id #edb/ref 17592186278572} {:db/id #edb/ref 17592186278573} {:db/id #edb/ref 17592186278574} {:db/id #edb/ref 17592186278575} {:db/id #edb/ref 17592186278580} {:db/id #edb/ref 17592186278583} {:db/id #edb/ref 17592186281284} {:db/id #edb/ref 17592186378850} {:db/id #edb/ref 17592186378871}] :knowledge-point/title "Identifying True Statements Regarding Interiors and Boundaries of Sets"} :step/id #uuid "a9a56a41-bd42-55bc-97e0-3044e441a107" :step/math-academy-id 41922} {:db/id #edb/ref 17592186193663 :step/content {:db/id #edb/ref 17592186193885 :tutorial/content "The **boundary** of a set $S,$ denoted $\\partial S,$ is the set that contains all the boundary points of $S.$\n\nFor example, consider the set $A,$ given by \n\n$$\nA = \\big\\{ (x,y)\\in\\mathbb R^2 \\,:\\, -1 \\lt x \\leq 1, \\, 0 \\lt y \\leq 2 \\big\\}.\n$$\n\nWe can represent this set as the following shaded region.\n\n![](images/50/5033928a09f9c320973a223bfd49b4b67924b433c7ba53e58bc07a95905f4231.png)\n\nThen, the set $\\partial A,$ the boundary of $A,$ has the following representation in the plane.\n\n![](images/e2/e2034b17b6a6834c1d747e2eba4a2522c43e9ff888d5f7feb7bf716b3e2cec00.png)\n\nThe **interior** of a set $S,$ denoted $\\textrm{int}\\, S,$ is the set containing all the interior points of $S.$ It contains every point in $S$ except the boundary points: \n\n$$\n\\textrm{int}\\,S = S - \\partial S\n$$\n\nFor our set $A$ defined above, the interior looks as follows:\n\n![](images/57/57ab8735d761926a36aa0e469b4637482c31880cc446d913f93755a12ec65a8f.png)\n\nMore formally, the interior of $A$ is given by\n\n$$\n\\textrm{int}\\,A = \\big\\{ (x,y)\\in\\mathbb R^2 \\,:\\, -1 \\lt x \\lt 1, \\, 0 \\lt y \\lt 2 \\big\\}.\n$$" :tutorial/id #uuid "0e637424-4284-59d5-be69-a86587836ad8" :tutorial/math-academy-id 6925 :tutorial/title "Introduction"} :step/id #uuid "a6d2c5fc-ab0d-5230-b12f-968073fd01a2" :step/math-academy-id 41923 :step/next {:db/id #edb/ref 17592186193696}} {:db/id #edb/ref 17592186193664 :step/content {:db/id #edb/ref 17592186192787 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192511 :question/id #uuid "a8045dd8-90b8-5671-9003-2539c502cb49" :question/math-academy-id "e-11035"} :knowledge-point/id #uuid "f89386f9-8a2b-56eb-8521-7c1ddafcfd96" :knowledge-point/questions [{:db/id #edb/ref 17592186193179} {:db/id #edb/ref 17592186193324} {:db/id #edb/ref 17592186240997} {:db/id #edb/ref 17592186281302} {:db/id #edb/ref 17592186281303} {:db/id #edb/ref 17592186281306} {:db/id #edb/ref 17592186281310} {:db/id #edb/ref 17592186281311} {:db/id #edb/ref 17592186339008} {:db/id #edb/ref 17592186379973} {:db/id #edb/ref 17592186401268} {:db/id #edb/ref 17592186407107}] :knowledge-point/title "Identifying the Interior of a Set"} :step/id #uuid "9d5d8127-b825-594a-81df-e04296e04e38" :step/math-academy-id 41924 :step/next {:db/id #edb/ref 17592186193662}} {:db/id #edb/ref 17592186193696 :step/content {:db/id #edb/ref 17592186192802 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192530 :question/id #uuid "44971e25-0367-5b13-a6be-db503c6b4539" :question/math-academy-id "e-12399"} :knowledge-point/id #uuid "e534c006-a5b4-5f76-bbd6-451496358d3a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048942}] :knowledge-point/questions [{:db/id #edb/ref 17592186193178} {:db/id #edb/ref 17592186193205} {:db/id #edb/ref 17592186278568} {:db/id #edb/ref 17592186278570} {:db/id #edb/ref 17592186378836} {:db/id #edb/ref 17592186378843} {:db/id #edb/ref 17592186398541} {:db/id #edb/ref 17592186398548} {:db/id #edb/ref 17592186398555} {:db/id #edb/ref 17592186435686} {:db/id #edb/ref 17592186563671} {:db/id #edb/ref 17592186563753}] :knowledge-point/title "Identifying the Boundary of a Set"} :step/id #uuid "96d5ce65-6ad2-5f74-bcdb-8d90d0ff8464" :step/math-academy-id 44507 :step/next {:db/id #edb/ref 17592186193664}}] :activity/title "Interiors and Boundaries of Sets" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186192917}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186407109} :activity/id #uuid "76e2698b-8be0-5d8e-90fa-0fb9464d3b79" :activity/scope {:db/id #edb/ref 17592186048621 :topic/id #uuid "af65e753-6f2e-5d89-8c0d-d3d5df2fc680" :topic/math-academy-id 4063} :activity/steps [{:db/id #edb/ref 17592186407108 :step/content {:db/id #edb/ref 17592186278572 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be55a3c3-a14a-5616-b434-748a64016ec5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186449946} {:answer/id #uuid "9b71986f-ed36-5a4e-9a5f-7dc9b8a49066" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186449947}] :answer-field/correct {:db/id #edb/ref 17592186449947} :answer-field/id #uuid "c0acb8a6-343b-54a7-9d7f-399cf2145053" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186450927} {:answer-field/choices [{:answer/id #uuid "d69f8359-c7e9-5292-948c-328d26d2fcd4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186449948} {:answer/id #uuid "947dbbdb-26b6-5c81-b11b-1ddb925d5b03" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186449949}] :answer-field/correct {:db/id #edb/ref 17592186449948} :answer-field/id #uuid "7a149c98-887c-59d2-92f6-de50cb110a9c" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186450928} {:answer-field/choices [{:answer/id #uuid "d9b547fe-4e7e-53cd-bca0-9119bfd32cd8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186449950} {:answer/id #uuid "69ad3907-4b5f-5519-bfd6-a21aa64633f1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186449951}] :answer-field/correct {:db/id #edb/ref 17592186449950} :answer-field/id #uuid "ee22d64e-0f8b-5b04-928a-65a44a0afe68" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186450929}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4104ec23-658c-58b7-8dbf-72086dab259b" :question/math-academy-id "q-161622" :question/problem "Consider the set $A,$ defined by \n\n$$\nA={(x,y)\\in {R}^{2}\\,:\\,y\\ge -1+x}.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $A$ contains all of its boundary points.\n- **II.** $A$ contains none of its boundary points.\n- **III.** $\\text{int}\\,A=A$" :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nIn this case, the set $A$ and its boundary $∂A$ are shown below.\n\n![](images/3e/3e7d8c11ac4b3de8473741a362ad2b78555c764da2d61f955435e8d59771cf46.png)\n\nThe interior of a set $A,$ denoted $\\text{int}\\,A,$ is the set containing all the interior points of $A.$ It contains every point in $A$ except the boundary points: \n\n$$\n\\text{int}\\,A=A-∂A\n$$\n\nNotice that, in this case, the set $A$ contains all of its boundary points. \n\nWith that in mind, let's examine each statement:\n\n- Statement I is true, while statement II is false. As we've seen, $A$ contains all of its boundary points.\n\n- Statement III is false. Since $A$ contains all of its boundary points, we must have $A-∂A⊊A.$ Therefore $\\text{int}\\,A\\ne A.$\n\nTherefore, the correct answer is \"I only.\""} :step/id #uuid "2c059530-0946-5277-be5a-d012a040ea0c" :step/next {:db/id #edb/ref 17592186407110}} {:db/id #edb/ref 17592186407109 :step/content {:db/id #edb/ref 17592186407107 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1343a63e-0338-5507-8d29-781c61de7f44" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0<x<2" :db/id #edb/ref 17592186407101} {:answer/id #uuid "24a9296e-4eb0-5d98-9be7-848968667f9d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2<x<2" :db/id #edb/ref 17592186407102} {:answer/id #uuid "75e8591a-dc02-55dc-ad14-ef68af4fe858" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2<x<0" :db/id #edb/ref 17592186407103} {:answer/id #uuid "c0c3ae09-1abc-5587-9c24-5fe509b146bf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2\\le x\\le 0" :db/id #edb/ref 17592186407104} {:answer/id #uuid "f99af401-4a27-5bd3-bd62-ea126d8fc033" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0\\le x\\le 0" :db/id #edb/ref 17592186407105}] :answer-field/correct {:db/id #edb/ref 17592186407103} :answer-field/id #uuid "8f40a659-1e0d-5b32-94de-7b630e906f3f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186407106}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8b1bfea3-dfec-5d1e-9126-a29ce02c9c56" :question/math-academy-id "q-64991" :question/problem "Consider the set $A,$ defined by \n\n$$\nA=\\{(x,y)\\in {R}^{2}\\,:\\,-2\\le x<0,\\,0\\le y<2\\}\n$$\n\nThe interior of $A$ is given by\n\n$$\n\\text{int}\\,A=\\{(x,y)\\in {R}^{2}\\,:\\,\\bbox[5px,border:1px solid black]{\\phantom{AAAAA}},\\,0<y<2\\,\\}.\n$$\n\nWhat is the missing expression?" :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nThe set $A$ and its boundary $∂A$ are shown below.\n\n![](images/71/71851a12f638da9604450cae0d50ed15187e850368890845d60b16b89e728bcf.png)\n\nThe interior of a set $A,$ denoted $\\text{int}\\,A,$ is the set containing all the interior points of $A.$ It contains every point in $A$ except the boundary points: \n\n$$\n\\text{int}\\,A=A-∂A\n$$\n\nThe interior of $A$ is shown below.\n\n![](images/ab/abdd434da59bb3a1bdc0ee7de398d7ea4aeae2f617f54b5a26a5bad871ba0ac4.png)\n\nSo, in this case, the interior of $A$ is given by\n\n$$\n\\text{int}\\,A=\\{(x,y)\\in {R}^{2}\\,:\\,-2<x<0,\\,0<y<2\\,\\}.\n$$"} :step/id #uuid "402d691f-f025-5fda-a714-cdf450986aae" :step/next {:db/id #edb/ref 17592186407108}} {:db/id #edb/ref 17592186407110 :step/content {:db/id #edb/ref 17592186278574 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "769ab244-b50f-5cca-ab22-fd43c9447cc4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186465411} {:answer/id #uuid "2c5149c3-ecba-57d2-b462-3dbdfb69933a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186465412}] :answer-field/correct {:db/id #edb/ref 17592186465411} :answer-field/id #uuid "087f9ca1-8165-5d08-815b-de98c18b98c3" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186466549} {:answer-field/choices [{:answer/id #uuid "61780875-68b1-505b-895f-12ff1ff66c15" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186465413} {:answer/id #uuid "dad38122-7c39-50f3-9242-6e99cb69a4f0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186465414}] :answer-field/correct {:db/id #edb/ref 17592186465413} :answer-field/id #uuid "65372a61-77ce-559a-9860-6323bcc95b27" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186466550} {:answer-field/choices [{:answer/id #uuid "f0696dc0-2a39-515e-89a4-41b079d76ebe" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186465415} {:answer/id #uuid "61f6634a-9066-5bbf-b0fc-703e680d6c85" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186465416}] :answer-field/correct {:db/id #edb/ref 17592186465416} :answer-field/id #uuid "db274c98-e65f-53ec-bc5e-861c8411a39d" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186466551}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "be0484aa-ac87-5330-9ede-cd54e1386a15" :question/math-academy-id "q-161625" :question/problem "Consider the set $A,$ defined by \n\n$$\nA=\\{(x,y)\\in {R}^{2}\\,:\\,y\\ge 2-x\\}.\n$$\n\nWhich of the following statements are true?\n\nI. $A$ contains none of its boundary points.\n\nII. $A$ contains some (not all) of its boundary points.\n\nIII. $\\text{int}\\,A\\ne A$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nIn this case, the set $A$ and its boundary $∂A$ are shown below.\n\n![](images/cd/cdca164d343d8bff4c78a1e366e52c588ca6c54dfdea61acea1900bcbdc79f31.png)\n\nThe interior of a set $A,$ denoted $\\text{int}\\,A,$ is the set containing all the interior points of $A.$ It contains every point in $A$ except the boundary points: \n\n$$\n\\text{int}\\,A=A-∂A\n$$\n\nNotice that, in this case, the set $A$ contains all of its boundary points.\n\nWith that in mind, let's examine each statement:\n\n- Statements I and II are false. As we have seen, $A$ contains all its boundary points.\n\n- Statement III is true. Since $A$ contains all of its boundary points, we must have $A-∂A⊊A.$ Therefore $\\text{int}\\,A\\ne A.$\n\nTherefore, the correct answer is \"III only.\""} :step/id #uuid "792002f7-8976-53c6-927a-3e52d881bb37" :step/next {:db/id #edb/ref 17592186407112}} {:db/id #edb/ref 17592186407111 :step/content {:db/id #edb/ref 17592186281306 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16ed68dd-7aef-5656-ac3a-0cafe1572795" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0\\le x<2,\\text{ }0\\le y<2" :db/id #edb/ref 17592186278794} {:answer/id #uuid "38d4ea31-5c92-59e1-b1b8-86206c057d4a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0\\le x\\le 2,\\text{ }0<y<2" :db/id #edb/ref 17592186279088} {:answer/id #uuid "5124a441-ffdf-5fb7-9c90-48ab336f851d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0<x<2,\\text{ }0\\le y\\le 2" :db/id #edb/ref 17592186279331} {:answer/id #uuid "df496dda-7913-50b6-b84c-a2e72d9ca9c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0<x<2,\\text{ }0<y<2" :db/id #edb/ref 17592186280560} {:answer/id #uuid "eb4012d7-37e1-5799-babd-f5c1ef441092" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0\\le x\\le 2,\\text{ }0\\le y\\le 2" :db/id #edb/ref 17592186280657}] :answer-field/correct {:db/id #edb/ref 17592186280560} :answer-field/id #uuid "74aee92b-a504-5e91-8eb4-d4d52bb0c27d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186281045}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "eb88fa68-158a-5357-aaca-59045c1933c3" :question/math-academy-id "q-161721" :question/problem "![](images/6d/6debac35386e085a0197cf9eb3f2da65cc719ace67163cad625f58c056fb8f67.png)\n\nConsider the set $A$ shown above. The interior of $A$ is \n\n$$\n\\text{int}\\,A=\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}<4,\\,\\bbox[5px,border:1px solid black]{\\phantom{AAAA}}\\}.\n$$\n\nWhat is the missing expression?" :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nThe set $A$ and its boundary $∂A$ are shown below.\n\n![](images/c0/c0b805c707981b9b6fcfa2ed387ad32a024fc845e6fd355a4b751ede4ad6a97e.png)\n\nThe interior of a set $A,$ denoted $\\text{int}\\,A,$ is the set containing all the interior points of $A.$ It contains every point in $A$ except the boundary points: \n\n$$\n\\text{int}\\,A=A-∂A\n$$\n\nThe interior of $A$ is shown below.\n\n![](images/69/69708aa698c38f8a29d3eb69083f893fd8fca183bd713387456624fc38b86fe9.png)\n\nSo, in this case, the interior of $A$ is given by\n\n$$\n\\text{int}\\,A=\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}<4,\\,0<x<2,\\text{ }0<y<2\\}.\n$$"} :step/id #uuid "8b91c588-b8dd-5d0f-bb39-1c50d03a3a31"} {:db/id #edb/ref 17592186407112 :step/content {:db/id #edb/ref 17592186281302 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1325c53d-2a90-5778-afb8-06fcd3205174" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{x}^{2}+{y}^{2}<4" :db/id #edb/ref 17592186278766} {:answer/id #uuid "4728e048-8ecd-5ccd-ac4b-e6cbd5e27ae0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{x}^{2}+{y}^{2}\\le 4" :db/id #edb/ref 17592186279227} {:answer/id #uuid "6578e51f-39ed-5919-8a55-dbd0a80e7410" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{x}^{2}+{y}^{2}<2" :db/id #edb/ref 17592186279513} {:answer/id #uuid "789e155f-7ca8-5285-8b89-650ea79f4175" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{x}^{2}+{y}^{2}\\le 2" :db/id #edb/ref 17592186279665} {:answer/id #uuid "ae570040-33fc-5a0b-b3dd-7a737099d6ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{2}+{y}^{2}<4" :db/id #edb/ref 17592186280136}] :answer-field/correct {:db/id #edb/ref 17592186278766} :answer-field/id #uuid "07fc9cff-ef6e-56b5-99d9-20afa2b43a94" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186280844}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "82618995-8e73-5f87-bf17-79a78614a421" :question/math-academy-id "q-161700" :question/problem "Consider the set $A,$ defined by \n\n$$\nA=\\{(x,y)\\in {R}^{2}\\,:\\,4{x}^{2}+{y}^{2}\\le 4,\\,0\\le x\\le 1\\}.\n$$\n\nThe interior of $A$ is given by\n\n$$\n\\text{int}\\,A=\\{(x,y)\\in {R}^{2}\\,:\\,\\bbox[5px,border: 1px solid black]{\\phantom{AAAAA}},\\,0<x<1\\}.\n$$\n\nWhat is the missing expression?" :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nThe set $A$ and its boundary $∂A$ are shown below.\n\n![](images/d6/d60700d57ddc72bb410b3136f546705676f83d23d9071ffe972c5163d11af549.png)\n\nThe interior of a set $A,$ denoted $\\text{int}\\,A,$ is the set containing all the interior points of $A.$ It contains every point in $A$ except the boundary points: \n\n$$\n\\text{int}\\,A=A-∂A\n$$\n\nThe interior of $A$ is shown below.\n\n![](images/75/75e0132cd3854f18e9ab409b7fd13af3898f78b5174647bf2b33b8438b9228cb.png)\n\nSo, in this case, the interior of $A$ is given by\n\n$$\n\\text{int}\\,A=\\{(x,y)\\in {R}^{2}\\,:\\,4{x}^{2}+{y}^{2}<4,\\,0<x<1\\}.\n$$"} :step/id #uuid "a1abd988-5a8d-5e08-8366-ca4c63f4e968" :step/next {:db/id #edb/ref 17592186407111}}] :activity/title "Interiors and Boundaries of Sets" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186407100}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186430779} :activity/id #uuid "ae35b94d-2e76-5fcd-b627-6a9afdd973c8" :activity/scope {:db/id #edb/ref 17592186048621 :topic/id #uuid "af65e753-6f2e-5d89-8c0d-d3d5df2fc680" :topic/math-academy-id 4063} :activity/steps [{:db/id #edb/ref 17592186430776 :step/content {:db/id #edb/ref 17592186281284 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2fa99ca1-0112-5944-8107-a465cf0627dc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186449976} {:answer/id #uuid "15a110f6-eccf-56f5-998c-8997e94f0e65" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186449977}] :answer-field/correct {:db/id #edb/ref 17592186449976} :answer-field/id #uuid "064a7a52-cec6-5ccc-a004-9c6fecd644e0" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186450942} {:answer-field/choices [{:answer/id #uuid "327300e8-f0e1-5c3f-a6e7-beb22904b216" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186449978} {:answer/id #uuid "50af4e2e-bd80-5f87-9f7f-30c9a6d776f0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186449979}] :answer-field/correct {:db/id #edb/ref 17592186449979} :answer-field/id #uuid "72039e1e-3581-51dc-a5b8-57794c0a1d42" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186450943} {:answer-field/choices [{:answer/id #uuid "d3d1b1a8-bff4-538e-9246-7df95c62a467" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186449980} {:answer/id #uuid "22eb3a74-db0a-5456-85b9-2111511cf1ba" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186449981}] :answer-field/correct {:db/id #edb/ref 17592186449981} :answer-field/id #uuid "1116eaca-e1e8-5e9d-879d-508f9c37e751" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186450944}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "46773dfb-2950-5619-a7ba-c3559b8d83bf" :question/math-academy-id "q-161652" :question/problem "Consider the set $A,$ defined by \n\n$$\nA=\\{(x,y)\\in {R}^{2}\\,:\\,1<{x}^{2}+{y}^{2}<4\\}.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $∂A\\cap A\\ne ∅$\n\n- **II.** $\\text{int}\\,A\\cap ∂A=∅$\n\n- **III.** $A=\\text{int}\\,A$" :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nIn this case, the set $A$ and its boundary $∂A={C}_{1}\\cup {C}_{2}$ are shown below.\n\n![](images/22/2273cd843c4bfaeaff10d49d3400d7661262673639a66034638d805eef5b1e47.png)\n\n   \n\nThe interior of a set $A,$ denoted $\\text{int}\\,A,$ is the set containing all the interior points of $A.$ It contains every point in $A$ except the boundary points: \n\n$$\n\\text{int}\\,A=A-∂A\n$$\n\nThe interior of $A$ is shown below.\n\n![](images/5e/5e473584ef5193b434ff6c138b08c4fbd9111a37252019143b1afb2d48c913c6.png)\n\nWith that in mind, let's examine each statement:\n\n- Statement I is false. As we've seen, $A$ contains none of its boundary points, so we must have  $∂A\\cap A=∅.$\n\n- Statement II is true. Since $\\text{int}\\,A$ contains all points in $A$ except the boundary points, we must have $\\text{int}\\,A\\cap ∂A=∅,$ where $∅$ denotes the empty set.\n\n- Statement III is true. Since $A$ contains none of its boundary points, we must have $A=\\text{int}\\,A.$\n\nTherefore, the correct answer is \"II and III  only.\""} :step/id #uuid "17d99301-dd16-5965-97b9-df38716417f5" :step/next {:db/id #edb/ref 17592186430780}} {:db/id #edb/ref 17592186430777 :step/content {:db/id #edb/ref 17592186278571 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24d1e79b-e7fb-5978-8b61-317e3cdc2318" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186449940} {:answer/id #uuid "bc77f129-c1ae-5fbc-bc29-dc39b9e0d483" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186449941}] :answer-field/correct {:db/id #edb/ref 17592186449941} :answer-field/id #uuid "6ad42456-eefd-513b-b1ff-1ddbbb8c3215" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186450924} {:answer-field/choices [{:answer/id #uuid "0ee14783-2c54-554a-85a4-909bd52480c6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186449942} {:answer/id #uuid "57213e39-07f9-53b0-9e6a-2235cede2a82" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186449943}] :answer-field/correct {:db/id #edb/ref 17592186449942} :answer-field/id #uuid "43ad0e94-a683-565d-a041-fe8827a078c0" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186450925} {:answer-field/choices [{:answer/id #uuid "1cdc4b8b-a4b8-5f63-9a52-137f8257c0db" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186449944} {:answer/id #uuid "ff06a87a-6dcf-5b24-936f-02500a3aa3ce" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186449945}] :answer-field/correct {:db/id #edb/ref 17592186449945} :answer-field/id #uuid "b03afc6c-2900-515e-85f5-539a9b27b138" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186450926}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2307ae9e-a249-5090-bfed-df0660f7b0eb" :question/math-academy-id "q-161601" :question/problem "Consider the set $A,$ defined by \n\n$$\nA=\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+4{y}^{2}<36\\}.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $A$ contains none of its boundary points.\n\n- **II.** $A$ contains some (not all) of its boundary points.\n\n- **III.** $\\text{int}\\,A=A$" :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nIn this case, the set $A$ and its boundary $∂A$ are shown below.\n\n![](images/ff/ff1f735266f66879834e02ca7601e90e40dfa7929e5796d4a3f8cb4ff2828de7.png)\n\n  \n\nThe interior of a set $A,$ denoted $\\text{int}\\,A,$ is the set containing all the interior points of $A.$ It contains every point in $A$ except the boundary points: \n\n$$\n\\text{int}\\,A=A-∂A\n$$\n\nNotice that, in this case, the set $A$ contains none of its boundary points. \n\nWith that in mind, let's examine each statement:\n\n- Statement I is true, while statement II is false. As we've seen, $A$ contains none of its boundary points.\n\n- Statement III is true. Since $A$ contains none of its boundary points, we must have $\\text{int}\\,A=A.$\n\nTherefore, the correct answer is \"I and III only.\""} :step/id #uuid "73729323-9be1-5e40-94b8-3eddef70b4a7" :step/next {:db/id #edb/ref 17592186430776}} {:db/id #edb/ref 17592186430778 :step/content {:db/id #edb/ref 17592186193206 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6df4c2be-04e6-571f-b0a9-dfab0dd98141" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186448466} {:answer/id #uuid "6e49a39a-5368-5de8-8c63-144924ac30d6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186448467}] :answer-field/correct {:db/id #edb/ref 17592186448467} :answer-field/id #uuid "efee37f6-b4c6-545d-bd91-c2a4f79965cc" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186449273} {:answer-field/choices [{:answer/id #uuid "3a00d201-d27c-52d0-8af0-2805fae6cd94" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186448468} {:answer/id #uuid "75d7e2d1-7f56-515b-bd02-787ded8e5270" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186448469}] :answer-field/correct {:db/id #edb/ref 17592186448469} :answer-field/id #uuid "c2b89ba2-4284-58ef-a934-c6ed5ebe6b7d" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186449274} {:answer-field/choices [{:answer/id #uuid "1c6ba7f9-51b0-5600-a4ea-f1ca0eedcc9d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186448470} {:answer/id #uuid "8af85e9b-1a4d-52a0-b5dc-188c47bd77d1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186448471}] :answer-field/correct {:db/id #edb/ref 17592186448471} :answer-field/id #uuid "f4439f51-b7e9-58c6-8132-dce6ead75ac7" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186449275}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "68256c62-7faf-5747-9e8c-b2c67a0a95a2" :question/math-academy-id "q-161444" :question/problem "Consider the set $A,$ defined by \n\n$$\nA=\\{(x,y)\\in {R}^{2}\\,:\\,4{x}^{2}+{y}^{2}\\ge 4\\}.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $\\text{int}\\,A\\cap ∂A=∅$\n\n- **II.** $A-∂A=\\text{int}\\,A$\n\n- **III.** $∂A⊂A$" :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nIn this case, the set $A$ and its boundary $∂A$ are shown below.\n\n![](images/62/62c410c21e79e1bc688c1ff1a3440a207c62bcad42525bdc93fa2770b76d48bd.png)\n\nThe interior of a set $A,$ denoted $\\text{int}\\,A,$ is the set containing all the interior points of $A.$ It contains every point in $A$ except the boundary points: \n\n$$\n\\text{int}\\,A=A-∂A\n$$\n\nThe interior of $A$ is shown below.\n\n![](images/33/33a4738b642443c2535d347aa53ee2b7b80c800142c4844d94578769118ebfbc.png)\n\nWith that in mind, let's examine each statement:\n\n- Statement I is true. Since $\\text{int}\\,A$ contains all points in $A$ except the boundary points, we must have $\\text{int}\\,A\\cap ∂A=∅,$ where $∅$ denotes the empty set.\n\n- Statement II is true. Since $\\text{int}\\,A$ contains all points in $A$ except the boundary points, we must have $A-∂A=\\text{int}\\,A.$\n\n- Statement III is true. In this case, the set $A$ contains all of its boundary points, so we must have $∂A⊂A.$\n\nTherefore, the correct answer is \"I, II, and III.\""} :step/id #uuid "992eb2be-3ddd-57bf-a76a-79f416d50e34" :step/next {:db/id #edb/ref 17592186430777}} {:db/id #edb/ref 17592186430779 :step/content {:db/id #edb/ref 17592186240997 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3243b0c1-092b-5601-b0a7-3f3c3e1a11a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2<x<2" :db/id #edb/ref 17592186238491} {:answer/id #uuid "3292f4f8-3340-5dcc-8508-318774f90133" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2<x<0" :db/id #edb/ref 17592186238495} {:answer/id #uuid "99e00a77-24b1-59aa-8b87-eeed024a6ac6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2\\le x<0" :db/id #edb/ref 17592186239391} {:answer/id #uuid "bc38a932-011d-51ce-8574-ad8d957e354d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0<x\\le 2" :db/id #edb/ref 17592186239697} {:answer/id #uuid "ed989251-9ebe-5e5b-b96b-de3e3996d705" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0<x<2" :db/id #edb/ref 17592186240146}] :answer-field/correct {:db/id #edb/ref 17592186238495} :answer-field/id #uuid "d5caea72-1771-5754-bf55-8da480cdcb1d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240708}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "47ef764e-19dd-5c12-b6a9-8ee51c79b104" :question/math-academy-id "q-105176" :question/problem "Consider the set $A,$ defined by \n\n$$\nA=\\{(x,y)\\in {R}^{2}\\,:\\,-2\\le x<0,\\,0<y\\le 1\\}.\n$$\n\nThe interior of $A$ is given by\n\n$$\n\\text{int}\\,A=\\{(x,y)\\in {R}^{2}\\,:\\,\\bbox[5px,border: 1px solid black]{\\phantom{AAAAA}},\\,0<y<1\\,\\}.\n$$\n\nWhat is the missing expression?" :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nThe set $A$ and its boundary $∂A$ are shown below.\n\n![](images/4f/4f65a735e53130f633635fdfc8cd6de6c4fa39ed1fb7913ba9679bb07e73a6a0.png)\n\nThe interior of a set $A,$ denoted $\\text{int}\\,A,$ is the set containing all the interior points of $A.$ It contains every point in $A$ except the boundary points: \n\n$$\n\\text{int}\\,A=A-∂A\n$$\n\nThe interior of $A$ is shown below.\n\n![](images/c7/c76cea9b33420bf6c2e03d8eecb105003ce8b4e619063cbf2b7fccd5bc596cb2.png)\n\nSo, in this case, the interior of $A$ is given by\n\n$$\n\\text{int}\\,A=\\{(x,y)\\in {R}^{2}\\,:\\,-2<x<0,\\,0<y<1\\,\\}.\n$$"} :step/id #uuid "cbd027d6-1f1e-5c1e-908b-e26efca43cff" :step/next {:db/id #edb/ref 17592186430778}} {:db/id #edb/ref 17592186430780 :step/content {:db/id #edb/ref 17592186281303 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21a437c9-898a-560e-9410-f1b54bde1b49" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{2}-1\\le y\\le 0" :db/id #edb/ref 17592186278896} {:answer/id #uuid "457a4dac-7b09-53f3-a0b2-fc26b6d17f3b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{2}-1\\le y<0" :db/id #edb/ref 17592186279212} {:answer/id #uuid "6b30a6d1-cc0f-5b57-a13e-c4a4b0eff724" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={x}^{2}-1" :db/id #edb/ref 17592186279564} {:answer/id #uuid "be011cab-f94a-5242-9219-8918bad94e5e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=0" :db/id #edb/ref 17592186280262} {:answer/id #uuid "ca3cde79-af5e-5be0-aee1-d2ce3550f31a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{2}-1<y<0" :db/id #edb/ref 17592186280365}] :answer-field/correct {:db/id #edb/ref 17592186280365} :answer-field/id #uuid "aec5203e-7431-5285-804f-2b85f96ff86c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186281134}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "45bc0b9a-3391-5849-aa6e-c42fba251f8a" :question/math-academy-id "q-161702" :question/problem "![](images/84/84806884f843154c17c338eef0f50d83cae049aece675450e21e58dade6a9f34.png)\n\nConsider the set $A$ shown above. The interior of $A$ is \n\n$$\n\\text{int}\\,A=\\{(x,y)\\in {R}^{2}\\,:\\,\\bbox[5px,border:1px solid black]{\\phantom{AAAA}}\\}.\n$$\n\nWhat is the missing expression?" :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nThe set $A$ and its boundary $∂A$ are shown below.\n\n![](images/ce/ce268d8b396ea63227734c1edd6b876bb0fe9755fa12a3b75be90c6ef4af5af3.png)\n\nThe interior of a set $A,$ denoted $\\text{int}\\,A,$ is the set containing all the interior points of $A.$ It contains every point in $A$ except the boundary points: \n\n$$\n\\text{int}\\,A=A-∂A\n$$\n\nThe interior of $A$ is shown below.\n\n![](images/84/84780a84406a3fd0e281737b979887e0de6b1e9fe39d440f379fbb2b84e80a3b.png)\n\nSo, in this case, the interior of $A$ is given by\n\n$$\n\\text{int}\\,A=\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}-1<y<0\\}.\n$$"} :step/id #uuid "e882a353-3705-56ae-8672-046cb8d6e7ed"}] :activity/title "Interiors and Boundaries of Sets" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186430775}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186442853} :activity/id #uuid "f8eec0d0-f78f-5fc0-b443-6a20c34d9a4c" :activity/scope {:db/id #edb/ref 17592186048621 :topic/id #uuid "af65e753-6f2e-5d89-8c0d-d3d5df2fc680" :topic/math-academy-id 4063} :activity/steps [{:db/id #edb/ref 17592186442851 :step/content {:db/id #edb/ref 17592186281284 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2fa99ca1-0112-5944-8107-a465cf0627dc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186449976} {:answer/id #uuid "15a110f6-eccf-56f5-998c-8997e94f0e65" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186449977}] :answer-field/correct {:db/id #edb/ref 17592186449976} :answer-field/id #uuid "064a7a52-cec6-5ccc-a004-9c6fecd644e0" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186450942} {:answer-field/choices [{:answer/id #uuid "327300e8-f0e1-5c3f-a6e7-beb22904b216" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186449978} {:answer/id #uuid "50af4e2e-bd80-5f87-9f7f-30c9a6d776f0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186449979}] :answer-field/correct {:db/id #edb/ref 17592186449979} :answer-field/id #uuid "72039e1e-3581-51dc-a5b8-57794c0a1d42" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186450943} {:answer-field/choices [{:answer/id #uuid "d3d1b1a8-bff4-538e-9246-7df95c62a467" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186449980} {:answer/id #uuid "22eb3a74-db0a-5456-85b9-2111511cf1ba" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186449981}] :answer-field/correct {:db/id #edb/ref 17592186449981} :answer-field/id #uuid "1116eaca-e1e8-5e9d-879d-508f9c37e751" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186450944}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "46773dfb-2950-5619-a7ba-c3559b8d83bf" :question/math-academy-id "q-161652" :question/problem "Consider the set $A,$ defined by \n\n$$\nA=\\{(x,y)\\in {R}^{2}\\,:\\,1<{x}^{2}+{y}^{2}<4\\}.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $∂A\\cap A\\ne ∅$\n\n- **II.** $\\text{int}\\,A\\cap ∂A=∅$\n\n- **III.** $A=\\text{int}\\,A$" :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nIn this case, the set $A$ and its boundary $∂A={C}_{1}\\cup {C}_{2}$ are shown below.\n\n![](images/22/2273cd843c4bfaeaff10d49d3400d7661262673639a66034638d805eef5b1e47.png)\n\n   \n\nThe interior of a set $A,$ denoted $\\text{int}\\,A,$ is the set containing all the interior points of $A.$ It contains every point in $A$ except the boundary points: \n\n$$\n\\text{int}\\,A=A-∂A\n$$\n\nThe interior of $A$ is shown below.\n\n![](images/5e/5e473584ef5193b434ff6c138b08c4fbd9111a37252019143b1afb2d48c913c6.png)\n\nWith that in mind, let's examine each statement:\n\n- Statement I is false. As we've seen, $A$ contains none of its boundary points, so we must have  $∂A\\cap A=∅.$\n\n- Statement II is true. Since $\\text{int}\\,A$ contains all points in $A$ except the boundary points, we must have $\\text{int}\\,A\\cap ∂A=∅,$ where $∅$ denotes the empty set.\n\n- Statement III is true. Since $A$ contains none of its boundary points, we must have $A=\\text{int}\\,A.$\n\nTherefore, the correct answer is \"II and III  only.\""} :step/id #uuid "909e433a-8b41-5a26-89ce-2bbce68c19cf" :step/next {:db/id #edb/ref 17592186442854}} {:db/id #edb/ref 17592186442852 :step/content {:db/id #edb/ref 17592186278580 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c1e2b183-1fbb-5d3a-95b8-ba5907b77381" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186449964} {:answer/id #uuid "009859f9-d5f0-5f12-8808-874a29b0d49a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186449965}] :answer-field/correct {:db/id #edb/ref 17592186449965} :answer-field/id #uuid "16e233f5-f964-5ef9-8385-488a93458b37" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186450936} {:answer-field/choices [{:answer/id #uuid "38a4adba-909c-5b52-9d39-dd7435fea047" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186449966} {:answer/id #uuid "8350d841-99c9-5e4f-bef6-5096ca7e6bc7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186449967}] :answer-field/correct {:db/id #edb/ref 17592186449967} :answer-field/id #uuid "c1b347b8-8595-51cb-990e-7a0cbef944cf" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186450937} {:answer-field/choices [{:answer/id #uuid "c563f6e6-481a-566e-952a-6ebc338f042e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186449968} {:answer/id #uuid "2b815ef2-94ab-5ef5-96a3-fca6c27ac9f7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186449969}] :answer-field/correct {:db/id #edb/ref 17592186449968} :answer-field/id #uuid "4645f2ba-58bb-53a2-860c-75230a1dd41f" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186450938}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "32d0249e-396e-5abf-9c3e-a9a01870f500" :question/math-academy-id "q-161643" :question/problem "Consider the set $A,$ defined by \n\n$$\nA=\\{(x,y)\\in {R}^{2}\\,:\\,4y>{x}^{2}\\}.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $\\text{int}\\,A\\cap ∂A=∅$\n\n- **II.** $A-∂A=\\text{int}\\,A$\n\n- **III.** $∂A⊂A$" :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nIn this case, the set $A$ and its boundary $∂A$ are shown below.\n\n![](images/a3/a380742f47d97062d56b482592cd2d2961dcc40262131a99886b815c507ab6e3.png)\n\nThe interior of a set $A,$ denoted $\\text{int}\\,A,$ is the set containing all the interior points of $A.$ It contains every point in $A$ except the boundary points: \n\n$$\n\\text{int}\\,A=A-∂A\n$$\n\nThe interior of $A$ is shown below.\n\n![](images/26/26d264d702368ed6fe05577d7c34630bd16b41bdba8d206dd4db39763db02938.png)\n\n \n\nWith that in mind, let's examine each statement:\n\n- Statement I is true. Since $\\text{int}\\,A$ contains all points in $A$ except the boundary points, we must have $\\text{int}\\,A\\cap ∂A=∅,$ where $∅$ denotes the empty set.\n\n- Statement II is true. Since $\\text{int}\\,A$ contains all points in $A$ except the boundary points, we must have $A-∂A=\\text{int}\\,A.$\n\n- Statement III is false. In this case, the set $A$ contains none of its boundary points, so we must have $∂A⊈A.$\n\nTherefore, the correct answer is \"I and  II only.\""} :step/id #uuid "c2cf7678-3eef-5b44-a81e-730e7364aaf8" :step/next {:db/id #edb/ref 17592186442851}} {:db/id #edb/ref 17592186442853 :step/content {:db/id #edb/ref 17592186193324 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "afb66ed2-895b-5f65-920c-57e9c4e712a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0<y<2" :db/id #edb/ref 17592186379786} {:answer/id #uuid "c89a07de-de11-5729-9c3f-59a3dce504fb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1\\le x\\le 0" :db/id #edb/ref 17592186379787} {:answer/id #uuid "27aebc95-7034-501b-b146-69c5c61f0fd8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0\\le x\\le 1" :db/id #edb/ref 17592186379788} {:answer/id #uuid "f05d76fa-181c-5c72-bf35-0a16895ff797" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0<y<1" :db/id #edb/ref 17592186379789} {:answer/id #uuid "bca2f207-84e6-5811-b1b2-ec4c412cc4d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1<y<0" :db/id #edb/ref 17592186379790}] :answer-field/correct {:db/id #edb/ref 17592186379790} :answer-field/id #uuid "0884985a-f4ec-5536-b90e-64a7f3d92f99" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186379785}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "13c6da4f-5008-5951-9c9e-dc34e9db3f48" :question/math-academy-id "q-35879" :question/problem "Consider the set $A,$ defined by \n\n$$\nA=\\{(x,y)\\in {R}^{2}\\,:\\,0\\le x\\le 2,\\,-1\\le y<0\\}.\n$$\n\nThe interior of $A$ is given by\n\n$$\n\\text{int}\\,A=\\{(x,y)\\in {R}^{2}\\,:\\,0<x<2,\\,\\bbox[5px,border:1px solid black]{\\phantom{AAAAA}}\\,\\}.\n$$\n\nWhat is the missing expression?" :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nThe set $A$ and its boundary $∂A$ are shown below.\n\n![](images/fc/fc71859cb4d1e58ea3d15c2da66bce014898281fe237f2e0c2396f96c84c9e79.png)\n\nThe interior of a set $A,$ denoted $\\text{int}\\,A,$ is the set containing all the interior points of $A.$ It contains every point in $A$ except the boundary points: \n\n$$\n\\text{int}\\,A=A-∂A\n$$\n\nThe interior of $A$ is shown below.\n\n![](images/ef/eff037b96b6a42120fdfa112a98d1e0749cdd56bd89acd647db448b08d7323ad.png)\n\nSo, in this case, the interior of $A$ is given by\n\n$$\n\\text{int}\\,A=\\{(x,y)\\in {R}^{2}\\,:\\,0<x<2,\\,-1<y<0\\,\\}.\n$$"} :step/id #uuid "ca759e97-85ee-514a-bb82-190c512bf87c" :step/next {:db/id #edb/ref 17592186442855}} {:db/id #edb/ref 17592186442854 :step/content {:db/id #edb/ref 17592186281306 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16ed68dd-7aef-5656-ac3a-0cafe1572795" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0\\le x<2,\\text{ }0\\le y<2" :db/id #edb/ref 17592186278794} {:answer/id #uuid "38d4ea31-5c92-59e1-b1b8-86206c057d4a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0\\le x\\le 2,\\text{ }0<y<2" :db/id #edb/ref 17592186279088} {:answer/id #uuid "5124a441-ffdf-5fb7-9c90-48ab336f851d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0<x<2,\\text{ }0\\le y\\le 2" :db/id #edb/ref 17592186279331} {:answer/id #uuid "df496dda-7913-50b6-b84c-a2e72d9ca9c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0<x<2,\\text{ }0<y<2" :db/id #edb/ref 17592186280560} {:answer/id #uuid "eb4012d7-37e1-5799-babd-f5c1ef441092" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0\\le x\\le 2,\\text{ }0\\le y\\le 2" :db/id #edb/ref 17592186280657}] :answer-field/correct {:db/id #edb/ref 17592186280560} :answer-field/id #uuid "74aee92b-a504-5e91-8eb4-d4d52bb0c27d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186281045}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "eb88fa68-158a-5357-aaca-59045c1933c3" :question/math-academy-id "q-161721" :question/problem "![](images/6d/6debac35386e085a0197cf9eb3f2da65cc719ace67163cad625f58c056fb8f67.png)\n\nConsider the set $A$ shown above. The interior of $A$ is \n\n$$\n\\text{int}\\,A=\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}<4,\\,\\bbox[5px,border:1px solid black]{\\phantom{AAAA}}\\}.\n$$\n\nWhat is the missing expression?" :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nThe set $A$ and its boundary $∂A$ are shown below.\n\n![](images/c0/c0b805c707981b9b6fcfa2ed387ad32a024fc845e6fd355a4b751ede4ad6a97e.png)\n\nThe interior of a set $A,$ denoted $\\text{int}\\,A,$ is the set containing all the interior points of $A.$ It contains every point in $A$ except the boundary points: \n\n$$\n\\text{int}\\,A=A-∂A\n$$\n\nThe interior of $A$ is shown below.\n\n![](images/69/69708aa698c38f8a29d3eb69083f893fd8fca183bd713387456624fc38b86fe9.png)\n\nSo, in this case, the interior of $A$ is given by\n\n$$\n\\text{int}\\,A=\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}<4,\\,0<x<2,\\text{ }0<y<2\\}.\n$$"} :step/id #uuid "cd888233-2b60-5220-b469-4008e301268f"} {:db/id #edb/ref 17592186442855 :step/content {:db/id #edb/ref 17592186278573 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34114c44-99df-5eb6-abf1-299e7f8a59e2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186449952} {:answer/id #uuid "a7a7d464-f27e-5816-910d-97e3198e8ac3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186449953}] :answer-field/correct {:db/id #edb/ref 17592186449952} :answer-field/id #uuid "a8c5a9d2-ddb3-5ced-9423-63314912bd6c" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186450930} {:answer-field/choices [{:answer/id #uuid "9d7ec702-57a1-5c3e-8b98-8dd92e48f1f8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186449954} {:answer/id #uuid "9b3e8b1f-44eb-5090-ac11-cc11a79bc546" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186449955}] :answer-field/correct {:db/id #edb/ref 17592186449955} :answer-field/id #uuid "a05a88b2-59a5-5a9b-8d98-69da3d4daec3" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186450931} {:answer-field/choices [{:answer/id #uuid "0d950cf8-fba5-5439-a346-fb6f6919aabb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186449956} {:answer/id #uuid "f65576ec-dbd6-5f03-8c29-7a62088cf6b4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186449957}] :answer-field/correct {:db/id #edb/ref 17592186449956} :answer-field/id #uuid "ef878e5f-c50a-5783-85f5-385663e493c3" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186450932}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "35b15061-fc8b-55f3-8742-4ca105208a91" :question/math-academy-id "q-161624" :question/problem "Consider the set $A,$ defined by \n\n$$\nA=\\{(x,y)\\in {R}^{2}\\,:\\,1<{x}^{2}+{y}^{2}\\le 4\\}.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $A$ contains none of its boundary points.\n\n- **II.** $A$ contains some (not all) of its boundary points.\n\n- **III.** $\\text{int}\\,A=A$" :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nIn this case, the set $A$ and its boundary $∂A$ are shown below.\n\n![](images/84/8414de2e05da43c03fae3c8b1ff2102401e990188e9fd4ee59a24308ec34b086.png)\n\n \n\nThe interior of a set $A,$ denoted $\\text{int}\\,A,$ is the set containing all the interior points of $A.$ It contains every point in $A$ except the boundary points: \n\n$$\n\\text{int}\\,A=A-∂A\n$$\n\nNotice that, in this case, the set $A$ contains some (not all) of its boundary points.\n\nWith that in mind, let's examine each statement:\n\n- Statement I is false, while statement II is true. As we have seen, $∂A$ consists of two concentric circles: the outer one is in $A,$ while the inner one is not.\n\n- Statement III is false. Since $A$ contains some of its boundary points, we must have $\\text{int}\\,A\\ne A.$\n\nTherefore, the correct answer is \"II only.\""} :step/id #uuid "dab0e3df-3979-5bc3-b20c-cb2469721525" :step/next {:db/id #edb/ref 17592186442852}}] :activity/title "Interiors and Boundaries of Sets" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186442850}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186510533} :activity/id #uuid "3da69255-8e25-5787-aeff-55f176c9e5f1" :activity/scope {:db/id #edb/ref 17592186048621 :topic/id #uuid "af65e753-6f2e-5d89-8c0d-d3d5df2fc680" :topic/math-academy-id 4063} :activity/steps [{:db/id #edb/ref 17592186510495 :step/content {:db/id #edb/ref 17592186193206 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6df4c2be-04e6-571f-b0a9-dfab0dd98141" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186448466} {:answer/id #uuid "6e49a39a-5368-5de8-8c63-144924ac30d6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186448467}] :answer-field/correct {:db/id #edb/ref 17592186448467} :answer-field/id #uuid "efee37f6-b4c6-545d-bd91-c2a4f79965cc" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186449273} {:answer-field/choices [{:answer/id #uuid "3a00d201-d27c-52d0-8af0-2805fae6cd94" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186448468} {:answer/id #uuid "75d7e2d1-7f56-515b-bd02-787ded8e5270" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186448469}] :answer-field/correct {:db/id #edb/ref 17592186448469} :answer-field/id #uuid "c2b89ba2-4284-58ef-a934-c6ed5ebe6b7d" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186449274} {:answer-field/choices [{:answer/id #uuid "1c6ba7f9-51b0-5600-a4ea-f1ca0eedcc9d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186448470} {:answer/id #uuid "8af85e9b-1a4d-52a0-b5dc-188c47bd77d1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186448471}] :answer-field/correct {:db/id #edb/ref 17592186448471} :answer-field/id #uuid "f4439f51-b7e9-58c6-8132-dce6ead75ac7" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186449275}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "68256c62-7faf-5747-9e8c-b2c67a0a95a2" :question/math-academy-id "q-161444" :question/problem "Consider the set $A,$ defined by \n\n$$\nA=\\{(x,y)\\in {R}^{2}\\,:\\,4{x}^{2}+{y}^{2}\\ge 4\\}.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $\\text{int}\\,A\\cap ∂A=∅$\n\n- **II.** $A-∂A=\\text{int}\\,A$\n\n- **III.** $∂A⊂A$" :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nIn this case, the set $A$ and its boundary $∂A$ are shown below.\n\n![](images/62/62c410c21e79e1bc688c1ff1a3440a207c62bcad42525bdc93fa2770b76d48bd.png)\n\nThe interior of a set $A,$ denoted $\\text{int}\\,A,$ is the set containing all the interior points of $A.$ It contains every point in $A$ except the boundary points: \n\n$$\n\\text{int}\\,A=A-∂A\n$$\n\nThe interior of $A$ is shown below.\n\n![](images/33/33a4738b642443c2535d347aa53ee2b7b80c800142c4844d94578769118ebfbc.png)\n\nWith that in mind, let's examine each statement:\n\n- Statement I is true. Since $\\text{int}\\,A$ contains all points in $A$ except the boundary points, we must have $\\text{int}\\,A\\cap ∂A=∅,$ where $∅$ denotes the empty set.\n\n- Statement II is true. Since $\\text{int}\\,A$ contains all points in $A$ except the boundary points, we must have $A-∂A=\\text{int}\\,A.$\n\n- Statement III is true. In this case, the set $A$ contains all of its boundary points, so we must have $∂A⊂A.$\n\nTherefore, the correct answer is \"I, II, and III.\""} :step/id #uuid "3aeb6357-d3cb-58b4-a333-6689b626b0b1" :step/next {:db/id #edb/ref 17592186510536}} {:db/id #edb/ref 17592186510533 :step/content {:db/id #edb/ref 17592186193179 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8042759c-34e5-5005-b223-6ae432924393" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=0" :db/id #edb/ref 17592186401112} {:answer/id #uuid "005523ea-9cd4-5f90-a22e-334d6a25f40b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=0" :db/id #edb/ref 17592186401113} {:answer/id #uuid "9fcc1510-f906-5cf2-aee6-a593897199ea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0<y<1" :db/id #edb/ref 17592186401114} {:answer/id #uuid "54b76232-1674-5242-9acf-123f7bdcf11e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1<y<0" :db/id #edb/ref 17592186401115} {:answer/id #uuid "3512bb23-ec85-559a-bb44-2c0d0c3ebdfe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1\\le y\\le 0" :db/id #edb/ref 17592186401116}] :answer-field/correct {:db/id #edb/ref 17592186401115} :answer-field/id #uuid "071a160d-4402-56e8-b9f3-e34425bb2388" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186401111}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "846d6059-ad4f-5e01-8a65-610c7d23e3a4" :question/math-academy-id "q-158314" :question/problem "![](images/b9/b95c538613ee8672e0f1cac970b7af230ec40bf3075e609b1e03f7cad4382fb1.png)\n\nConsider the set $A$ shown above. The interior of $A$ is \n\n$$\n\\text{int}\\,A=\\{(x,y)\\in {R}^{2}\\,:\\,0<x<1,\\,\\bbox[5px,border:1px solid black]{\\phantom{AAAAA}}\\}.\n$$\n\nWhat is the missing expression?" :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nThe set $A$ and its boundary $∂A$ are shown below.\n\n![](images/19/19e8e52881066864cba562ed2a8cdc2944b9dae416c7124fdee207cdad1d8bdf.png)\n\nThe interior of a set $A,$ denoted $\\text{int}\\,A,$ is the set containing all the interior points of $A.$ It contains every point in $A$ except the boundary points: \n\n$$\n\\text{int}\\,A=A-∂A\n$$\n\nThe interior of $A$ is shown below.\n\n![](images/90/907e996fb7aea36e0c924feb0f5d9dc6804c768be775953d277e84b0145ef5a0.png)\n\nSo, in this case, the interior of $A$ is given by\n\n$$\n\\text{int}\\,A=\\{(x,y)\\in {R}^{2}\\,:\\,0<x<1,\\,-1<y<0\\}.\n$$"} :step/id #uuid "ad2d8f33-f769-5b19-b3a8-2c1054e52764" :step/next {:db/id #edb/ref 17592186510495}} {:db/id #edb/ref 17592186510535 :step/content {:db/id #edb/ref 17592186278575 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f5b39a98-ac20-5cbf-805a-5c64b48f4d91" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186449958} {:answer/id #uuid "a6123e03-9f1a-55ae-8049-e66f7df48abf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186449959}] :answer-field/correct {:db/id #edb/ref 17592186449959} :answer-field/id #uuid "bb5b9ea3-b19f-572e-90a5-93f3f3d18280" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186450933} {:answer-field/choices [{:answer/id #uuid "bc09b043-a237-5147-8e74-3cb2d48c0db4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186449960} {:answer/id #uuid "d3f5341e-9ebd-53a8-b977-c25f8d8c2d89" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186449961}] :answer-field/correct {:db/id #edb/ref 17592186449960} :answer-field/id #uuid "45b72198-7edb-5c3f-a56e-f84b68b732be" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186450934} {:answer-field/choices [{:answer/id #uuid "3e755d2a-b5e6-5e96-88fd-d0e6cd0cfc47" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186449962} {:answer/id #uuid "896e016a-452b-53dc-9c84-3690b98756c8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186449963}] :answer-field/correct {:db/id #edb/ref 17592186449963} :answer-field/id #uuid "3b80112e-c8cb-5761-852a-1dc1da395e6b" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186450935}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "baee2889-195d-5ff5-b660-0a9acac1604c" :question/math-academy-id "q-161626" :question/problem "Consider the set $A,$ defined by \n\n$$\nA={(x,y)\\in {R}^{2}\\,:\\,\\frac{{x}^{2}}{4}+{y}^{2}<4}.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $\\text{int}\\,A\\cap ∂A=∅$\n- **II.** $A-\\text{int}\\,A=∂A$\n- **III.** $∂A⊂{R}^{2}-A$" :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nIn this case, the set $A$ and its boundary $∂A$ are shown below.\n\n![](images/45/4540e03fc5404474a0cd900c89004e6a5cfe7ac2d4702348e9d0395fc1c914e9.png)\n\n \n\nThe interior of a set $A,$ denoted $\\text{int}\\,A,$ is the set containing all the interior points of $A.$ It contains every point in $A$ except the boundary points: \n\n$$\n\\text{int}\\,A=A-∂A\n$$\n\nThe interior of $A$ is shown below.  \n\n![](images/2a/2a93b912f0d7b3a84bf0ec9c3b3596d080a9e71a345ff436e2f591edf042d9db.png)\n\n  \n\nWith that in mind, let's examine each statement:\n\n- Statement I is true. Since $\\text{int}\\,A$ contains all points in $A$ except the boundary points, we must have $\\text{int}\\,A\\cap ∂A=∅,$ where $∅$ denotes the empty set.\n\n- Statement II is false. Since $A$ contains none of its boundary points, we must have $A=\\text{int}\\,A$ or, equivalently,  $A-\\text{int}\\,A=∅.$\n\n- Statement III is true. In this case, the set $A$ contains none of its boundary points, so we must have $∂A⊂{R}^{2}-A.$\n\nTherefore, the correct answer is \"I and  III only.\""} :step/id #uuid "b277a6a0-e989-50db-857a-8b156c750f75" :step/next {:db/id #edb/ref 17592186510540}} {:db/id #edb/ref 17592186510536 :step/content {:db/id #edb/ref 17592186378843 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e10af6b-0591-5053-99a4-daa139c38eaa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y>-1+x" :db/id #edb/ref 17592186378845} {:answer/id #uuid "6db4587d-cb4b-5833-8c4e-4aaa4bbaceb4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y<-1+x" :db/id #edb/ref 17592186378846} {:answer/id #uuid "0010883b-56fc-5f98-bf3b-0ca63324c983" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-1+x" :db/id #edb/ref 17592186378847} {:answer/id #uuid "f36ec4d6-3398-59fb-96fa-76646653031c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y\\ge -1+x" :db/id #edb/ref 17592186378848} {:answer/id #uuid "a21a36f6-b572-588d-aa2e-573d52ea0330" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y\\le -1+x" :db/id #edb/ref 17592186378849}] :answer-field/correct {:db/id #edb/ref 17592186378847} :answer-field/id #uuid "59c8bfe0-08bc-5e9b-93ce-301d8e63019e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186378844}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4a26d47e-204e-5e18-9063-2683b6b0394d" :question/math-academy-id "q-161593" :question/problem "![](images/80/80bde6a20ceed7c052a87eda6f05c542f6046de7014f6402f5f453b6610f8d42.png)\n\nConsider the set $A,$ shown above. The boundary of $A$ is given by\n\n$$\n∂A=\\{(x,y)\\in {R}^{2}\\,:\\,\\bbox[5px,border:1px solid black]{\\phantom{AAAAA}}\\,\\}.\n$$\n\nWhat is the missing expression?" :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nThe set $A$ and its boundary $∂A$ are shown below.\n\n![](images/05/05b25521109f373e2a7718523ce6289b27b37bd185d4fc60f0d052c232f4f8a4.png)\n\nFrom the diagram, the boundary points of $A$ lie on the line $y=-1+x.$\n\nTherefore, \n\n$$\n∂A=\\{(x,y)\\in {R}^{2}\\,:\\,y=-1+x\\,\\}.\n$$"} :step/id #uuid "b46780df-21b0-590b-bec2-f3671aa2cd9f" :step/next {:db/id #edb/ref 17592186510535}} {:db/id #edb/ref 17592186510540 :step/content {:db/id #edb/ref 17592186281310 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43574f05-777a-549d-bcc5-4111c8c8d7de" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=2" :db/id #edb/ref 17592186279195} {:answer/id #uuid "5a9719d8-ee0b-5a00-a340-ff263989cce4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1\\le y\\le 1" :db/id #edb/ref 17592186279427} {:answer/id #uuid "ca03051f-af96-56ae-ab61-1088cac3f4b2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=0" :db/id #edb/ref 17592186280361} {:answer/id #uuid "d49251f6-f1c4-5cb4-80d5-9e8219614615" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0<y<2" :db/id #edb/ref 17592186280466} {:answer/id #uuid "ecf5aa37-a11b-5e7d-9327-c99e5e66d2dd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0\\le y\\le 2" :db/id #edb/ref 17592186280670}] :answer-field/correct {:db/id #edb/ref 17592186280466} :answer-field/id #uuid "a6060a7f-f5cd-551c-84e4-60b33ad6abe7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186281123}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "62cf2373-4936-5999-9138-7b1b78c43b9d" :question/math-academy-id "q-161730" :question/problem "![](images/aa/aa335a55f5b4496cdaccca5d35e286a168598761188bc520c81397ef136f927d.png)\n\nConsider the set $A$ shown above. The interior of $A$ is \n\n$$\n\\text{int}\\,A=\\{(x,y)\\in {R}^{2}\\,:\\,4{x}^{2}+{y}^{2}<4,\\,\\bbox[5px,border:1px solid black]{\\phantom{AAAA}}\\}.\n$$\n\nWhat is the missing expression?" :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nThe set $A$ and its boundary $∂A$ are shown below.\n\n![](images/fb/fba9ba3e52ed19eb0bb2286ae59c49bb9dc648134d9eab3c4e2d13862963f736.png)\n\nThe interior of a set $A,$ denoted $\\text{int}\\,A,$ is the set containing all the interior points of $A.$ It contains every point in $A$ except the boundary points: \n\n$$\n\\text{int}\\,A=A-∂A\n$$\n\nThe interior of $A$ is shown below.\n\n![](images/2f/2f3cd30dbaa4f84c43f2a7f1197aa904e3d43b1212241ae26736b2a0087f6170.png)\n\nSo, in this case, the interior of $A$ is given by\n\n$$\n\\text{int}\\,A=\\{(x,y)\\in {R}^{2}\\,:\\,4{x}^{2}+{y}^{2}<4,\\,0<y<2\\}.\n$$"} :step/id #uuid "c5efa418-7310-57f8-a775-d17dbd515940"}] :activity/title "Interiors and Boundaries of Sets" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186509682}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186572740} :activity/id #uuid "882f3cca-a610-5b45-a3c2-861cdf2c46ff" :activity/scope {:db/id #edb/ref 17592186048621 :topic/id #uuid "af65e753-6f2e-5d89-8c0d-d3d5df2fc680" :topic/math-academy-id 4063} :activity/steps [{:db/id #edb/ref 17592186572740 :step/content {:db/id #edb/ref 17592186378843 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e10af6b-0591-5053-99a4-daa139c38eaa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y>-1+x" :db/id #edb/ref 17592186378845} {:answer/id #uui