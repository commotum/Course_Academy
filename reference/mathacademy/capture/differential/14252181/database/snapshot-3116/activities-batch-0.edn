b3d97ab19" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{2}\\ge -x" :db/id #edb/ref 17592186398550} {:answer/id #uuid "ff58ee15-73c1-5580-9e71-8bba76a9b817" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{2}\\le -x" :db/id #edb/ref 17592186398551} {:answer/id #uuid "7091d7cf-fb36-5a53-885a-a308985da886" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{2}<-x" :db/id #edb/ref 17592186398552} {:answer/id #uuid "d659a207-f68e-587b-a239-ea9f4042aefe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{2}=-x" :db/id #edb/ref 17592186398553} {:answer/id #uuid "a4015647-d62f-51c8-aff3-60d6eea64e52" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{2}>-x" :db/id #edb/ref 17592186398554}] :answer-field/correct {:db/id #edb/ref 17592186398553} :answer-field/id #uuid "0c536b1b-39ee-59d3-8fef-dfde6d2dc504" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186398549}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "28ca8dae-bb66-5179-8a04-f47a13f5a86d" :question/math-academy-id "q-161596" :question/problem "![](images/2b/2bb25857047d7a0200d4c58ee3756b0efa0f2d13aaca8664b1fe49414c18a461.png)\n\nConsider the set $A,$ shown above. The boundary of $A$ is given by\n\n$$\n∂A=\\{(x,y)\\in {R}^{2}\\,:\\,\\bbox[5px,border: 1px solid black]{\\phantom{AAAAA}}\\,\\}.\n$$\n\nWhat is the missing expression?" :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nThe set $A$ and its boundary $∂A$ are shown below.\n\n![](images/88/88f35519cf1aa01bcc9e4fb91b24c2bc2a1a823867ec2670563b0b45f2643a0a.png)\n\nFrom the diagram, the boundary points of $A$ lie on the parabola ${y}^{2}=-x.$\n\nTherefore, \n\n$$\n∂A=\\{(x,y)\\in {R}^{2}\\,:\\,{y}^{2}=-x\\,\\}.\n$$"} :step/id #uuid "334e179e-59e2-5c16-8f4a-0f86c0a2ff33" :step/next {:db/id #edb/ref 17592186572764}} {:db/id #edb/ref 17592186572764 :step/content {:db/id #edb/ref 17592186398555 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e217ad3d-748d-5af0-96b1-e1ce473458d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{2}+4{y}^{2}<36" :db/id #edb/ref 17592186398557} {:answer/id #uuid "cd0bfd32-77d4-5a28-b13f-6b03980aac88" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{2}+4{y}^{2}>36" :db/id #edb/ref 17592186398558} {:answer/id #uuid "d591b7a8-1678-5fc4-8efb-59323697512e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{2}+4{y}^{2}=36" :db/id #edb/ref 17592186398559} {:answer/id #uuid "b121b495-13d7-5ac2-843d-1f8022ddb37d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{2}+4{y}^{2}\\le 36" :db/id #edb/ref 17592186398560} {:answer/id #uuid "b5797dbb-800e-55ff-b8bd-e000ab812acf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{2}+4{y}^{2}\\ge 36" :db/id #edb/ref 17592186398561}] :answer-field/correct {:db/id #edb/ref 17592186398559} :answer-field/id #uuid "634120e7-888a-527b-b321-8e6ce84d2f2c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186398556}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "bcfdd46f-14ab-5535-a276-fcd0db509adc" :question/math-academy-id "q-161598" :question/problem "![](images/11/112ab676fa5a97db198a872c33579900deab76e0c3c9c92016e165a67482bbcd.png)\n\nConsider the set $A,$ shown above. The boundary of $A$ is given by\n\n$$\n∂A=\\{(x,y)\\in {R}^{2}\\,:\\,\\bbox[5px,border: 1px solid black]{\\phantom{AAAAA}}\\,\\}.\n$$\n\nWhat is the missing expression?" :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nThe set $A$ and its boundary $∂A$ are shown below.\n\n![](images/44/44f3a2a8e535c7248dac49d126da9bf17fce94c357f15c93a3eaad665e73b47a.png)\n\n \n\nFrom the diagram, the boundary points of $A$ lie on the ellipse ${x}^{2}+4{y}^{2}=36.$  \n\nTherefore, \n\n$$\n∂A=\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+4{y}^{2}=36\\,\\}.\n$$"} :step/id #uuid "4ddfc8a4-2dd3-59a8-808a-c1829fd8b9d3" :step/next {:db/id #edb/ref 17592186572796}} {:db/id #edb/ref 17592186572796 :step/content {:db/id #edb/ref 17592186401268 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "388d2b25-435c-5296-9aa6-b2d86268ab07" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0<y\\le x" :db/id #edb/ref 17592186401270} {:answer/id #uuid "f7697d7e-3437-54cb-8f6c-2a92ca54ced0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-x\\le y\\le x" :db/id #edb/ref 17592186401271} {:answer/id #uuid "715a11d5-48d4-58bf-b2c8-7bc968bb12ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-x\\le y<x" :db/id #edb/ref 17592186401272} {:answer/id #uuid "6585c463-6545-5cb0-b223-cfd5eb13f4f3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-x<y<x" :db/id #edb/ref 17592186401273} {:answer/id #uuid "2bc09c1e-549e-5605-9dc7-40a23cf11591" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0<y<x" :db/id #edb/ref 17592186401274}] :answer-field/correct {:db/id #edb/ref 17592186401273} :answer-field/id #uuid "41473911-1989-5683-9728-285b3c146754" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186401269}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9cae3814-ea99-54e9-86e7-c0bc019bdf37" :question/math-academy-id "q-161718" :question/problem "![](images/af/af1e6e7b384732a527fc77e9729c6e02aaa288d4076c030c9fae58742cb10f74.png)\n\nConsider the set $A$ shown above. The interior of $A$ is \n\n$$\n\\text{int}\\,A=\\{(x,y)\\in {R}^{2}\\,:\\,0<x<2,\\,\\bbox[5px,border: 1px solid black]{\\phantom{AAAA}}\\}.\n$$\n\nWhat is the missing expression?" :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nThe set $A$ and its boundary $∂A$ are shown below.\n\n![](images/0a/0a0b92621d83d6395926a75b5cae34f479a8b9e64dfe82711094c3724b3b3220.png)\n\nThe interior of a set $A,$ denoted $\\text{int}\\,A,$ is the set containing all the interior points of $A.$ It contains every point in $A$ except the boundary points: \n\n$$\n\\text{int}\\,A=A-∂A\n$$\n\nThe interior of $A$ is shown below.\n\n![](images/3d/3ddef68bf4b4284c1b68896920fddb8d7fb0e70eba15dee103cdbc0134a9ed20.png)\n\nSo, in this case, the interior of $A$ is given by\n\n$$\n\\text{int}\\,A=\\{(x,y)\\in {R}^{2}\\,:\\,0<x<2,\\,-x<y<x\\}.\n$$"} :step/id #uuid "d1941f92-b302-52a7-af78-5b4f30a1bddd"} {:db/id #edb/ref 17592186572798 :step/content {:db/id #edb/ref 17592186435686 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12dc85bb-cd47-5b33-a127-8e0086b71833" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y<2-x" :db/id #edb/ref 17592186435680} {:answer/id #uuid "4abb66be-2678-58be-a9b9-2a2311d4b784" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y>2-x" :db/id #edb/ref 17592186435681} {:answer/id #uuid "4f38e133-dcd8-5339-a2b7-5a9997c0d1f0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y\\le 2-x" :db/id #edb/ref 17592186435682} {:answer/id #uuid "6dc57868-eec7-5486-9156-13dad63ee061" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y\\ge 2-x" :db/id #edb/ref 17592186435683} {:answer/id #uuid "db118f09-f7c6-5463-ab93-b46db354c131" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=2-x" :db/id #edb/ref 17592186435684}] :answer-field/correct {:db/id #edb/ref 17592186435684} :answer-field/id #uuid "4437d06f-222c-582a-ab1b-38dd45632e8b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186435685}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4bf3edf8-7469-5b33-bc3b-54f4acae6cf1" :question/math-academy-id "q-161595" :question/problem "![](images/65/6559dfed58b9456d6eebfd660f7a0d59a60db9db1159561f010f6b7e13e90e5b.png)\n\nConsider the set $A,$ shown above. The boundary of $A$ is given by\n\n$$\n∂A=\\{(x,y)\\in {R}^{2}\\,:\\,\\bbox[5px,border:1px solid black]{\\phantom{AAAAA}}\\,\\}.\n$$\n\nWhat is the missing expression?" :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nThe set $A$ and its boundary $∂A$ are shown below.\n\n![](images/d7/d7293d96b71f573dbdcbfb491646f0e563f8ad1567eab5baaf960533e72d473f.png)\n\nFrom the diagram, the boundary points of $A$ lie on the line $y=2-x.$\n\nTherefore, \n\n$$\n∂A=\\{(x,y)\\in {R}^{2}\\,:\\,y=2-x\\,\\}.\n$$"} :step/id #uuid "da85ea15-55c8-5492-a039-e2f5a855c6a7" :step/next {:db/id #edb/ref 17592186572748}}] :activity/title "Interiors and Boundaries of Sets" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186572308}]}
