#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186193663} :activity/id #uuid "d93075cf-1282-5b7f-b71d-4c5f5fd85e47" :activity/scope {:db/id #edb/ref 17592186048621 :topic/id #uuid "af65e753-6f2e-5d89-8c0d-d3d5df2fc680" :topic/math-academy-id 4063} :activity/steps [{:db/id #edb/ref 17592186193662 :step/content {:db/id #edb/ref 17592186192786 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192510 :question/id #uuid "00b0d838-163d-5299-beaf-255f9b13cf71" :question/math-academy-id "e-11034"} :knowledge-point/id #uuid "a024c46e-0374-5d03-b895-eb754ff7ad97" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048681} {:db/id #edb/ref 17592186048899} {:db/id #edb/ref 17592186050923} {:db/id #edb/ref 17592186051033}] :knowledge-point/questions [{:db/id #edb/ref 17592186193206} {:db/id #edb/ref 17592186193207} {:db/id #edb/ref 17592186278571} {:db/id #edb/ref 17592186278572} {:db/id #edb/ref 17592186278573} {:db/id #edb/ref 17592186278574} {:db/id #edb/ref 17592186278575} {:db/id #edb/ref 17592186278580} {:db/id #edb/ref 17592186278583} {:db/id #edb/ref 17592186281284} {:db/id #edb/ref 17592186378850} {:db/id #edb/ref 17592186378871}] :knowledge-point/title "Identifying True Statements Regarding Interiors and Boundaries of Sets"} :step/id #uuid "a9a56a41-bd42-55bc-97e0-3044e441a107" :step/math-academy-id 41922} {:db/id #edb/ref 17592186193663 :step/content {:db/id #edb/ref 17592186193885 :tutorial/content "The **boundary** of a set $S,$ denoted $\\partial S,$ is the set that contains all the boundary points of $S.$\n\nFor example, consider the set $A,$ given by \n\n$$\nA = \\big\\{ (x,y)\\in\\mathbb R^2 \\,:\\, -1 \\lt x \\leq 1, \\, 0 \\lt y \\leq 2 \\big\\}.\n$$\n\nWe can represent this set as the following shaded region.\n\n![](images/50/5033928a09f9c320973a223bfd49b4b67924b433c7ba53e58bc07a95905f4231.png)\n\nThen, the set $\\partial A,$ the boundary of $A,$ has the following representation in the plane.\n\n![](images/e2/e2034b17b6a6834c1d747e2eba4a2522c43e9ff888d5f7feb7bf716b3e2cec00.png)\n\nThe **interior** of a set $S,$ denoted $\\textrm{int}\\, S,$ is the set containing all the interior points of $S.$ It contains every point in $S$ except the boundary points: \n\n$$\n\\textrm{int}\\,S = S - \\partial S\n$$\n\nFor our set $A$ defined above, the interior looks as follows:\n\n![](images/57/57ab8735d761926a36aa0e469b4637482c31880cc446d913f93755a12ec65a8f.png)\n\nMore formally, the interior of $A$ is given by\n\n$$\n\\textrm{int}\\,A = \\big\\{ (x,y)\\in\\mathbb R^2 \\,:\\, -1 \\lt x \\lt 1, \\, 0 \\lt y \\lt 2 \\big\\}.\n$$" :tutorial/id #uuid "0e637424-4284-59d5-be69-a86587836ad8" :tutorial/math-academy-id 6925 :tutorial/title "Introduction"} :step/id #uuid "a6d2c5fc-ab0d-5230-b12f-968073fd01a2" :step/math-academy-id 41923 :step/next {:db/id #edb/ref 17592186193696}} {:db/id #edb/ref 17592186193664 :step/content {:db/id #edb/ref 17592186192787 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192511 :question/id #uuid "a8045dd8-90b8-5671-9003-2539c502cb49" :question/math-academy-id "e-11035"} :knowledge-point/id #uuid "f89386f9-8a2b-56eb-8521-7c1ddafcfd96" :knowledge-point/questions [{:db/id #edb/ref 17592186193179} {:db/id #edb/ref 17592186193324} {:db/id #edb/ref 17592186240997} {:db/id #edb/ref 17592186281302} {:db/id #edb/ref 17592186281303} {:db/id #edb/ref 17592186281306} {:db/id #edb/ref 17592186281310} {:db/id #edb/ref 17592186281311} {:db/id #edb/ref 17592186339008} {:db/id #edb/ref 17592186379973} {:db/id #edb/ref 17592186401268} {:db/id #edb/ref 17592186407107}] :knowledge-point/title "Identifying the Interior of a Set"} :step/id #uuid "9d5d8127-b825-594a-81df-e04296e04e38" :step/math-academy-id 41924 :step/next {:db/id #edb/ref 17592186193662}} {:db/id #edb/ref 17592186193696 :step/content {:db/id #edb/ref 17592186192802 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192530 :question/id #uuid "44971e25-0367-5b13-a6be-db503c6b4539" :question/math-academy-id "e-12399"} :knowledge-point/id #uuid "e534c006-a5b4-5f76-bbd6-451496358d3a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048942}] :knowledge-point/questions [{:db/id #edb/ref 17592186193178} {:db/id #edb/ref 17592186193205} {:db/id #edb/ref 17592186278568} {:db/id #edb/ref 17592186278570} {:db/id #edb/ref 17592186378836} {:db/id #edb/ref 17592186378843} {:db/id #edb/ref 17592186398541} {:db/id #edb/ref 17592186398548} {:db/id #edb/ref 17592186398555} {:db/id #edb/ref 17592186435686}] :knowledge-point/title "Identifying the Boundary of a Set"} :step/id #uuid "96d5ce65-6ad2-5f74-bcdb-8d90d0ff8464" :step/math-academy-id 44507 :step/next {:db/id #edb/ref 17592186193664}}] :activity/title "Interiors and Boundaries of Sets" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186192917}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186407109} :activity/id #uuid "76e2698b-8be0-5d8e-90fa-0fb9464d3b79" :activity/scope {:db/id #edb/ref 17592186048621 :topic/id #uuid "af65e753-6f2e-5d89-8c0d-d3d5df2fc680" :topic/math-academy-id 4063} :activity/steps [{:db/id #edb/ref 17592186407108 :step/content {:db/id #edb/ref 17592186278572 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1762dd7a-cdff-5568-977d-6d80f2adc2de" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186275698} {:answer/id #uuid "89802e03-4038-5079-a2d6-6fbcbfaa4f4f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186276719} {:answer/id #uuid "8b30765e-36b9-5ec6-98f6-842bac2a8047" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186276741} {:answer/id #uuid "a64a6892-a119-5289-a94b-626583cc70ba" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186276975} {:answer/id #uuid "af9e721c-402a-5c3f-9692-3951b59def5a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186277051}] :answer-field/correct {:db/id #edb/ref 17592186276719} :answer-field/id #uuid "b45260eb-ab24-5e89-9cc0-6905bd2dcc59" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186278041}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4104ec23-658c-58b7-8dbf-72086dab259b" :question/math-academy-id "q-161622" :question/problem "Consider the set $A,$ defined by \n\n$$\nA={(x,y)\\in {R}^{2}\\,:\\,y\\ge -1+x}.\n$$\n\nWhich of the following statements are true?\n\n- $A$ contains all of its boundary points.\n- $A$ contains none of its boundary points.\n- $\\text{int}\\,A=A$" :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nIn this case, the set $A$ and its boundary $∂A$ are shown below.\n\n![](images/3e/3e7d8c11ac4b3de8473741a362ad2b78555c764da2d61f955435e8d59771cf46.png)\n\nThe interior of a set $A,$ denoted $\\text{int}\\,A,$ is the set containing all the interior points of $A.$ It contains every point in $A$ except the boundary points: \n\n$$\n\\text{int}\\,A=A-∂A\n$$\n\nNotice that, in this case, the set $A$ contains all of its boundary points. \n\nWith that in mind, let's examine each statement:\n\n- Statement I is true, while statement II is false. As we've seen, $A$ contains all of its boundary points.\n\n- Statement III is false. Since $A$ contains all of its boundary points, we must have $A-∂A⊊A.$ Therefore $\\text{int}\\,A\\ne A.$\n\nTherefore, the correct answer is \"I only.\""} :step/id #uuid "2c059530-0946-5277-be5a-d012a040ea0c" :step/next {:db/id #edb/ref 17592186407110}} {:db/id #edb/ref 17592186407109 :step/content {:db/id #edb/ref 17592186407107 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1343a63e-0338-5507-8d29-781c61de7f44" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0<x<2" :db/id #edb/ref 17592186407101} {:answer/id #uuid "24a9296e-4eb0-5d98-9be7-848968667f9d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2<x<2" :db/id #edb/ref 17592186407102} {:answer/id #uuid "75e8591a-dc02-55dc-ad14-ef68af4fe858" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2<x<0" :db/id #edb/ref 17592186407103} {:answer/id #uuid "c0c3ae09-1abc-5587-9c24-5fe509b146bf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2\\le x\\le 0" :db/id #edb/ref 17592186407104} {:answer/id #uuid "f99af401-4a27-5bd3-bd62-ea126d8fc033" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0\\le x\\le 0" :db/id #edb/ref 17592186407105}] :answer-field/correct {:db/id #edb/ref 17592186407103} :answer-field/id #uuid "8f40a659-1e0d-5b32-94de-7b630e906f3f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186407106}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8b1bfea3-dfec-5d1e-9126-a29ce02c9c56" :question/math-academy-id "q-64991" :question/problem "Consider the set $A,$ defined by \n\n$$\nA={(x,y)\\in {R}^{2}\\,:\\,-2\\le x<0,\\,0\\le y<2}\n$$\n\nThe interior of $A$ is given by\n\n$$\n\\text{int}\\,A={(x,y)\\in {R}^{2}\\,:\\,,\\,0<y<2\\,}.\n$$\n\nWhat is the missing expression?" :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nThe set $A$ and its boundary $∂A$ are shown below.\n\n![](images/71/71851a12f638da9604450cae0d50ed15187e850368890845d60b16b89e728bcf.png)\n\nThe interior of a set $A,$ denoted $\\text{int}\\,A,$ is the set containing all the interior points of $A.$ It contains every point in $A$ except the boundary points: \n\n$$\n\\text{int}\\,A=A-∂A\n$$\n\nThe interior of $A$ is shown below.\n\n![](images/ab/abdd434da59bb3a1bdc0ee7de398d7ea4aeae2f617f54b5a26a5bad871ba0ac4.png)\n\nSo, in this case, the interior of $A$ is given by\n\n$$\n\\text{int}\\,A={(x,y)\\in {R}^{2}\\,:\\,-2<x<0,\\,0<y<2\\,}.\n$$"} :step/id #uuid "402d691f-f025-5fda-a714-cdf450986aae" :step/next {:db/id #edb/ref 17592186407108}} {:db/id #edb/ref 17592186407110 :step/content {:db/id #edb/ref 17592186278574 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51545767-3cc2-5437-9f48-638348ea4cb8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186276205} {:answer/id #uuid "65e476b0-8d46-5284-adff-7ab3dfc01d42" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186276391} {:answer/id #uuid "8a5f5c40-cedb-5337-a6d5-fdb5d40c8667" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "None of the statements are true" :db/id #edb/ref 17592186276728} {:answer/id #uuid "ebbc21fd-75c6-57b1-b5df-f0a1cd6cf1c3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186277540} {:answer/id #uuid "fbea97be-23e3-55aa-9854-424f79b2abcb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186277686}] :answer-field/correct {:db/id #edb/ref 17592186276391} :answer-field/id #uuid "79c6778a-20db-511f-af8b-42a6afc7a710" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186277940}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "be0484aa-ac87-5330-9ede-cd54e1386a15" :question/math-academy-id "q-161625" :question/problem "Consider the set $A,$ defined by \n\n$$\nA=\\{(x,y)\\in {R}^{2}\\,:\\,y\\ge 2-x\\}.\n$$\n\nWhich of the following statements are true?\n\nI. $A$ contains none of its boundary points.\n\nII. $A$ contains some (not all) of its boundary points.\n\nIII. $\\text{int}\\,A\\ne A$" :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nIn this case, the set $A$ and its boundary $∂A$ are shown below.\n\n![](images/cd/cdca164d343d8bff4c78a1e366e52c588ca6c54dfdea61acea1900bcbdc79f31.png)\n\nThe interior of a set $A,$ denoted $\\text{int}\\,A,$ is the set containing all the interior points of $A.$ It contains every point in $A$ except the boundary points: \n\n$$\n\\text{int}\\,A=A-∂A\n$$\n\nNotice that, in this case, the set $A$ contains all of its boundary points.\n\nWith that in mind, let's examine each statement:\n\n- Statements I and II are false. As we have seen, $A$ contains all its boundary points.\n\n- Statement III is true. Since $A$ contains all of its boundary points, we must have $A-∂A⊊A.$ Therefore $\\text{int}\\,A\\ne A.$\n\nTherefore, the correct answer is \"III only.\""} :step/id #uuid "792002f7-8976-53c6-927a-3e52d881bb37" :step/next {:db/id #edb/ref 17592186407112}} {:db/id #edb/ref 17592186407111 :step/content {:db/id #edb/ref 17592186281306 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16ed68dd-7aef-5656-ac3a-0cafe1572795" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0\\le x<2,\\text{ }0\\le y<2" :db/id #edb/ref 17592186278794} {:answer/id #uuid "38d4ea31-5c92-59e1-b1b8-86206c057d4a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0\\le x\\le 2,\\text{ }0<y<2" :db/id #edb/ref 17592186279088} {:answer/id #uuid "5124a441-ffdf-5fb7-9c90-48ab336f851d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0<x<2,\\text{ }0\\le y\\le 2" :db/id #edb/ref 17592186279331} {:answer/id #uuid "df496dda-7913-50b6-b84c-a2e72d9ca9c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0<x<2,\\text{ }0<y<2" :db/id #edb/ref 17592186280560} {:answer/id #uuid "eb4012d7-37e1-5799-babd-f5c1ef441092" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0\\le x\\le 2,\\text{ }0\\le y\\le 2" :db/id #edb/ref 17592186280657}] :answer-field/correct {:db/id #edb/ref 17592186280560} :answer-field/id #uuid "74aee92b-a504-5e91-8eb4-d4d52bb0c27d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186281045}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "eb88fa68-158a-5357-aaca-59045c1933c3" :question/math-academy-id "q-161721" :question/problem "![](images/6d/6debac35386e085a0197cf9eb3f2da65cc719ace67163cad625f58c056fb8f67.png)\n\nConsider the set $A$ shown above. The interior of $A$ is \n\n$$\n\\text{int}\\,A={(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}<4,\\,}.\n$$\n\nWhat is the missing expression?" :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nThe set $A$ and its boundary $∂A$ are shown below.\n\n![](images/c0/c0b805c707981b9b6fcfa2ed387ad32a024fc845e6fd355a4b751ede4ad6a97e.png)\n\nThe interior of a set $A,$ denoted $\\text{int}\\,A,$ is the set containing all the interior points of $A.$ It contains every point in $A$ except the boundary points: \n\n$$\n\\text{int}\\,A=A-∂A\n$$\n\nThe interior of $A$ is shown below.\n\n![](images/69/69708aa698c38f8a29d3eb69083f893fd8fca183bd713387456624fc38b86fe9.png)\n\nSo, in this case, the interior of $A$ is given by\n\n$$\n\\text{int}\\,A={(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}<4,\\,0<x<2,\\text{ }0<y<2}.\n$$"} :step/id #uuid "8b91c588-b8dd-5d0f-bb39-1c50d03a3a31"} {:db/id #edb/ref 17592186407112 :step/content {:db/id #edb/ref 17592186281302 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1325c53d-2a90-5778-afb8-06fcd3205174" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{x}^{2}+{y}^{2}<4" :db/id #edb/ref 17592186278766} {:answer/id #uuid "4728e048-8ecd-5ccd-ac4b-e6cbd5e27ae0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{x}^{2}+{y}^{2}\\le 4" :db/id #edb/ref 17592186279227} {:answer/id #uuid "6578e51f-39ed-5919-8a55-dbd0a80e7410" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{x}^{2}+{y}^{2}<2" :db/id #edb/ref 17592186279513} {:answer/id #uuid "789e155f-7ca8-5285-8b89-650ea79f4175" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{x}^{2}+{y}^{2}\\le 2" :db/id #edb/ref 17592186279665} {:answer/id #uuid "ae570040-33fc-5a0b-b3dd-7a737099d6ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{2}+{y}^{2}<4" :db/id #edb/ref 17592186280136}] :answer-field/correct {:db/id #edb/ref 17592186278766} :answer-field/id #uuid "07fc9cff-ef6e-56b5-99d9-20afa2b43a94" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186280844}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "82618995-8e73-5f87-bf17-79a78614a421" :question/math-academy-id "q-161700" :question/problem "Consider the set $A,$ defined by \n\n$$\nA=\\{(x,y)\\in {R}^{2}\\,:\\,4{x}^{2}+{y}^{2}\\le 4,\\,0\\le x\\le 1\\}.\n$$\n\nThe interior of $A$ is given by\n\n$$\n\\text{int}\\,A=\\{(x,y)\\in {R}^{2}\\,:\\,\\bbox[5px,border: 1px solid black]{\\phantom{AAAAA}},\\,0<x<1\\}.\n$$\n\nWhat is the missing expression?" :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nThe set $A$ and its boundary $∂A$ are shown below.\n\n![](images/d6/d60700d57ddc72bb410b3136f546705676f83d23d9071ffe972c5163d11af549.png)\n\nThe interior of a set $A,$ denoted $\\text{int}\\,A,$ is the set containing all the interior points of $A.$ It contains every point in $A$ except the boundary points: \n\n$$\n\\text{int}\\,A=A-∂A\n$$\n\nThe interior of $A$ is shown below.\n\n![](images/75/75e0132cd3854f18e9ab409b7fd13af3898f78b5174647bf2b33b8438b9228cb.png)\n\nSo, in this case, the interior of $A$ is given by\n\n$$\n\\text{int}\\,A=\\{(x,y)\\in {R}^{2}\\,:\\,4{x}^{2}+{y}^{2}<4,\\,0<x<1\\}.\n$$"} :step/id #uuid "a1abd988-5a8d-5e08-8366-ca4c63f4e968" :step/next {:db/id #edb/ref 17592186407111}}] :activity/title "Interiors and Boundaries of Sets" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186407100}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186430779} :activity/id #uuid "ae35b94d-2e76-5fcd-b627-6a9afdd973c8" :activity/scope {:db/id #edb/ref 17592186048621 :topic/id #uuid "af65e753-6f2e-5d89-8c0d-d3d5df2fc680" :topic/math-academy-id 4063} :activity/steps [{:db/id #edb/ref 17592186430776 :step/content {:db/id #edb/ref 17592186281284 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "052b75ab-358d-5073-b438-8aabbcf16598" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III  only" :db/id #edb/ref 17592186278638} {:answer/id #uuid "21f1b1b1-4cbf-5384-abf1-011fb4b8e732" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II  only" :db/id #edb/ref 17592186278897} {:answer/id #uuid "62d28ecd-0906-545c-93e9-7da6ccef73dc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III  only" :db/id #edb/ref 17592186279488} {:answer/id #uuid "84b65459-6cd3-563c-a465-2e40b3ffdf57" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I  only" :db/id #edb/ref 17592186279785} {:answer/id #uuid "97292980-0d47-5775-9ecb-d399051901ab" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III  only" :db/id #edb/ref 17592186279929}] :answer-field/correct {:db/id #edb/ref 17592186279929} :answer-field/id #uuid "f48d194b-9d36-54e9-be97-ae912aef2d30" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186281267}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "46773dfb-2950-5619-a7ba-c3559b8d83bf" :question/math-academy-id "q-161652" :question/problem "Consider the set $A,$ defined by \n\n$$\nA=\\{(x,y)\\in {R}^{2}\\,:\\,1<{x}^{2}+{y}^{2}<4\\}.\n$$\n\nWhich of the following statements are true?  \n\nI. $∂A\\cap A\\ne ∅$\n\nII. $\\text{int}\\,A\\cap ∂A=∅$\n\nIII. $A=\\text{int}\\,A$" :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nIn this case, the set $A$ and its boundary $∂A={C}_{1}\\cup {C}_{2}$ are shown below.\n\n![](images/22/2273cd843c4bfaeaff10d49d3400d7661262673639a66034638d805eef5b1e47.png)\n\n   \n\nThe interior of a set $A,$ denoted $\\text{int}\\,A,$ is the set containing all the interior points of $A.$ It contains every point in $A$ except the boundary points: \n\n$$\n\\text{int}\\,A=A-∂A\n$$\n\nThe interior of $A$ is shown below.\n\n![](images/5e/5e473584ef5193b434ff6c138b08c4fbd9111a37252019143b1afb2d48c913c6.png)\n\nWith that in mind, let's examine each statement:\n\n- Statement I is false. As we've seen, $A$ contains none of its boundary points, so we must have  $∂A\\cap A=∅.$\n\n- Statement II is true. Since $\\text{int}\\,A$ contains all points in $A$ except the boundary points, we must have $\\text{int}\\,A\\cap ∂A=∅,$ where $∅$ denotes the empty set.\n\n- Statement III is true. Since $A$ contains none of its boundary points, we must have $A=\\text{int}\\,A.$\n\nTherefore, the correct answer is \"II and III  only.\""} :step/id #uuid "17d99301-dd16-5965-97b9-df38716417f5" :step/next {:db/id #edb/ref 17592186430780}} {:db/id #edb/ref 17592186430777 :step/content {:db/id #edb/ref 17592186278571 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06342551-0e88-5a6b-bd0d-60e7e94f92cc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186275532} {:answer/id #uuid "514cdd25-4769-5166-850c-a323f4ce90d5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186276204} {:answer/id #uuid "9472a39b-33fc-53d0-8cc5-e0e82c1a530a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186276820} {:answer/id #uuid "a5d437f7-5a15-5e16-8d18-d6085aacba13" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186276973} {:answer/id #uuid "e15fd5f3-6d8f-5ca6-a7db-f5eec29b87ba" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186277448}] :answer-field/correct {:db/id #edb/ref 17592186275532} :answer-field/id #uuid "0377995e-0aa9-5059-b2c1-6fd8c5abf106" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186277730}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2307ae9e-a249-5090-bfed-df0660f7b0eb" :question/math-academy-id "q-161601" :question/problem "Consider the set $A,$ defined by \n\n$$\nA=\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+4{y}^{2}<36\\}.\n$$\n\nWhich of the following statements are true?\n\nI. $A$ contains none of its boundary points.\n\nII. $A$ contains some (not all) of its boundary points.\n\nIII. $\\text{int}\\,A=A$" :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nIn this case, the set $A$ and its boundary $∂A$ are shown below.\n\n![](images/ff/ff1f735266f66879834e02ca7601e90e40dfa7929e5796d4a3f8cb4ff2828de7.png)\n\n  \n\nThe interior of a set $A,$ denoted $\\text{int}\\,A,$ is the set containing all the interior points of $A.$ It contains every point in $A$ except the boundary points: \n\n$$\n\\text{int}\\,A=A-∂A\n$$\n\nNotice that, in this case, the set $A$ contains none of its boundary points. \n\nWith that in mind, let's examine each statement:\n\n- Statement I is true, while statement II is false. As we've seen, $A$ contains none of its boundary points.\n\n- Statement III is true. Since $A$ contains none of its boundary points, we must have $\\text{int}\\,A=A.$\n\nTherefore, the correct answer is \"I and III only.\""} :step/id #uuid "73729323-9be1-5e40-94b8-3eddef70b4a7" :step/next {:db/id #edb/ref 17592186430776}} {:db/id #edb/ref 17592186430778 :step/content {:db/id #edb/ref 17592186193206 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "114232b4-2761-5665-9296-c185bd484017" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186275631} {:answer/id #uuid "7880da2d-e957-5ca8-8e13-bcb627935744" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186276569} {:answer/id #uuid "8c2c725f-185f-5f35-871e-79e343f1ed7a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186276749} {:answer/id #uuid "a5c9fbc8-b14c-5cbc-8b85-1785d478d974" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186276972} {:answer/id #uuid "f330e754-04e9-557c-9d3e-6d2ab7556a6d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II, and III" :db/id #edb/ref 17592186277609}] :answer-field/correct {:db/id #edb/ref 17592186277609} :answer-field/id #uuid "c8880f9f-c13c-59f9-8dce-1a13792353a5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186278077}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "68256c62-7faf-5747-9e8c-b2c67a0a95a2" :question/math-academy-id "q-161444" :question/problem "Consider the set $A,$ defined by \n\n$$\nA=\\{(x,y)\\in {R}^{2}\\,:\\,4{x}^{2}+{y}^{2}\\ge 4\\}.\n$$\n\nWhich of the following statements are true?\n\nI. $\\text{int}\\,A\\cap ∂A=∅$\n\nII. $A-∂A=\\text{int}\\,A$\n\nIII. $∂A⊂A$" :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nIn this case, the set $A$ and its boundary $∂A$ are shown below.\n\n![](images/62/62c410c21e79e1bc688c1ff1a3440a207c62bcad42525bdc93fa2770b76d48bd.png)\n\nThe interior of a set $A,$ denoted $\\text{int}\\,A,$ is the set containing all the interior points of $A.$ It contains every point in $A$ except the boundary points: \n\n$$\n\\text{int}\\,A=A-∂A\n$$\n\nThe interior of $A$ is shown below.\n\n![](images/33/33a4738b642443c2535d347aa53ee2b7b80c800142c4844d94578769118ebfbc.png)\n\nWith that in mind, let's examine each statement:\n\n- Statement I is true. Since $\\text{int}\\,A$ contains all points in $A$ except the boundary points, we must have $\\text{int}\\,A\\cap ∂A=∅,$ where $∅$ denotes the empty set.\n\n- Statement II is true. Since $\\text{int}\\,A$ contains all points in $A$ except the boundary points, we must have $A-∂A=\\text{int}\\,A.$\n\n- Statement III is true. In this case, the set $A$ contains all of its boundary points, so we must have $∂A⊂A.$\n\nTherefore, the correct answer is \"I, II, and III.\""} :step/id #uuid "992eb2be-3ddd-57bf-a76a-79f416d50e34" :step/next {:db/id #edb/ref 17592186430777}} {:db/id #edb/ref 17592186430779 :step/content {:db/id #edb/ref 17592186240997 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3243b0c1-092b-5601-b0a7-3f3c3e1a11a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2<x<2" :db/id #edb/ref 17592186238491} {:answer/id #uuid "3292f4f8-3340-5dcc-8508-318774f90133" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2<x<0" :db/id #edb/ref 17592186238495} {:answer/id #uuid "99e00a77-24b1-59aa-8b87-eeed024a6ac6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2\\le x<0" :db/id #edb/ref 17592186239391} {:answer/id #uuid "bc38a932-011d-51ce-8574-ad8d957e354d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0<x\\le 2" :db/id #edb/ref 17592186239697} {:answer/id #uuid "ed989251-9ebe-5e5b-b96b-de3e3996d705" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0<x<2" :db/id #edb/ref 17592186240146}] :answer-field/correct {:db/id #edb/ref 17592186238495} :answer-field/id #uuid "d5caea72-1771-5754-bf55-8da480cdcb1d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240708}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "47ef764e-19dd-5c12-b6a9-8ee51c79b104" :question/math-academy-id "q-105176" :question/problem "Consider the set $A,$ defined by \n\n$$\nA=\\{(x,y)\\in {R}^{2}\\,:\\,-2\\le x<0,\\,0<y\\le 1\\}.\n$$\n\nThe interior of $A$ is given by\n\n$$\n\\text{int}\\,A=\\{(x,y)\\in {R}^{2}\\,:\\,\\bbox[5px,border: 1px solid black]{\\phantom{AAAAA}},\\,0<y<1\\,\\}.\n$$\n\nWhat is the missing expression?" :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nThe set $A$ and its boundary $∂A$ are shown below.\n\n![](images/4f/4f65a735e53130f633635fdfc8cd6de6c4fa39ed1fb7913ba9679bb07e73a6a0.png)\n\nThe interior of a set $A,$ denoted $\\text{int}\\,A,$ is the set containing all the interior points of $A.$ It contains every point in $A$ except the boundary points: \n\n$$\n\\text{int}\\,A=A-∂A\n$$\n\nThe interior of $A$ is shown below.\n\n![](images/c7/c76cea9b33420bf6c2e03d8eecb105003ce8b4e619063cbf2b7fccd5bc596cb2.png)\n\nSo, in this case, the interior of $A$ is given by\n\n$$\n\\text{int}\\,A=\\{(x,y)\\in {R}^{2}\\,:\\,-2<x<0,\\,0<y<1\\,\\}.\n$$"} :step/id #uuid "cbd027d6-1f1e-5c1e-908b-e26efca43cff" :step/next {:db/id #edb/ref 17592186430778}} {:db/id #edb/ref 17592186430780 :step/content {:db/id #edb/ref 17592186281303 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21a437c9-898a-560e-9410-f1b54bde1b49" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{2}-1\\le y\\le 0" :db/id #edb/ref 17592186278896} {:answer/id #uuid "457a4dac-7b09-53f3-a0b2-fc26b6d17f3b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{2}-1\\le y<0" :db/id #edb/ref 17592186279212} {:answer/id #uuid "6b30a6d1-cc0f-5b57-a13e-c4a4b0eff724" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={x}^{2}-1" :db/id #edb/ref 17592186279564} {:answer/id #uuid "be011cab-f94a-5242-9219-8918bad94e5e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=0" :db/id #edb/ref 17592186280262} {:answer/id #uuid "ca3cde79-af5e-5be0-aee1-d2ce3550f31a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{2}-1<y<0" :db/id #edb/ref 17592186280365}] :answer-field/correct {:db/id #edb/ref 17592186280365} :answer-field/id #uuid "aec5203e-7431-5285-804f-2b85f96ff86c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186281134}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "45bc0b9a-3391-5849-aa6e-c42fba251f8a" :question/math-academy-id "q-161702" :question/problem "![](images/84/84806884f843154c17c338eef0f50d83cae049aece675450e21e58dade6a9f34.png)\n\nConsider the set $A$ shown above. The interior of $A$ is \n\n$$\n\\text{int}\\,A=\\{(x,y)\\in {R}^{2}\\,:\\,\\bbox[5px,border: 1px solid black]{\\phantom{AAAA}}\\}.\n$$\n\nWhat is the missing expression?" :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nThe set $A$ and its boundary $∂A$ are shown below.\n\n![](images/ce/ce268d8b396ea63227734c1edd6b876bb0fe9755fa12a3b75be90c6ef4af5af3.png)\n\nThe interior of a set $A,$ denoted $\\text{int}\\,A,$ is the set containing all the interior points of $A.$ It contains every point in $A$ except the boundary points: \n\n$$\n\\text{int}\\,A=A-∂A\n$$\n\nThe interior of $A$ is shown below.\n\n![](images/84/84780a84406a3fd0e281737b979887e0de6b1e9fe39d440f379fbb2b84e80a3b.png)\n\nSo, in this case, the interior of $A$ is given by\n\n$$\n\\text{int}\\,A=\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}-1<y<0\\}.\n$$"} :step/id #uuid "e882a353-3705-56ae-8672-046cb8d6e7ed"}] :activity/title "Interiors and Boundaries of Sets" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186430775}]}
