swer-fields [{:answer-field/choices [{:answer/id #uuid "07a430fa-18ac-5b72-b213-7419118f4d28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0<{x}^{2}+{y}^{2}<1" :db/id #edb/ref 17592186336091} {:answer/id #uuid "261681af-6b12-54ce-90d1-a8bbf77d214c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0\\le {x}^{2}+{y}^{2}<2" :db/id #edb/ref 17592186336389} {:answer/id #uuid "3bf8ee8f-a53d-5a4a-970b-d8f88bbf5f34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0<{x}^{2}+{y}^{2}<4" :db/id #edb/ref 17592186336596} {:answer/id #uuid "b7fe65d2-d5b1-57e7-967d-53f4f7eb8d9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0<{x}^{2}+{y}^{2}<2" :db/id #edb/ref 17592186337661} {:answer/id #uuid "ec60a4d0-fed3-50cf-8700-ae050890c608" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0\\le {x}^{2}+{y}^{2}\\le 4" :db/id #edb/ref 17592186338092}] :answer-field/correct {:answer/id #uuid "3bf8ee8f-a53d-5a4a-970b-d8f88bbf5f34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0<{x}^{2}+{y}^{2}<4" :db/id #edb/ref 17592186336596} :answer-field/id #uuid "3f1f5949-3ba9-562b-a461-7c260db2239f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338390}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a329f0e7-fa8c-5ef6-8758-63f7881531f4" :question/math-academy-id "q-71888" :question/problem "Consider the set $A,$ defined by \n\n$$\nA={(x,y)\\in {R}^{2}\\,:\\,0\\le {x}^{2}+{y}^{2}<4,\\,0\\le y<2}.\n$$\n\nThe interior of $A$ is given by\n\n$$\n\\text{int}\\,A={(x,y)\\in {R}^{2}\\,:\\,,\\,0<y<2}.\n$$\n\nWhat is the missing expression?" :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nThe set $A$ and its boundary $∂A$ are shown below.\n\n![](images/f4/f4ee8fbf9a7670a7d0e0b7488bccbf014f8db8fff0154c7db025f2b071aec566.png)\n\nThe interior of a set $A,$ denoted $\\text{int}\\,A,$ is the set containing all the interior points of $A.$ It contains every point in $A$ except the boundary points: \n\n$$\n\\text{int}\\,A=A-∂A\n$$\n\nThe interior of $A$ is shown below.\n\n![](images/9f/9fc733f6966b016c93b6ee6a305c5af5ee4fa432dad5d95e28061fd2a0d33efb.png)\n\nSo, in this case, the interior of $A$ is given by\n\n$$\n\\text{int}\\,A={(x,y)\\in {R}^{2}\\,:\\,0<{x}^{2}+{y}^{2}<4,\\,0<y<2}.\n$$"}]}
