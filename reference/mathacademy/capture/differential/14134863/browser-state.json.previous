      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14134863/observations/step-q161718-518880c61b2be0bb79be.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14134863/observations/step-q161718-518880c61b2be0bb79be.png",
