      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14134863/observations/step-q105176-1829c2b9a7a50dfe87f3.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14134863/observations/step-q105176-1829c2b9a7a50dfe87f3.png",
