      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14134863/observations/step-q161700-84a36d332d53166e8bc1.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14134863/observations/step-q161700-84a36d332d53166e8bc1.png",
