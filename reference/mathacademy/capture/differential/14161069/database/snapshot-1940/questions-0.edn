#{[{:db/id #edb/ref 17592186124392 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186124661 :knowledge-point/id #uuid "32cbf366-20bd-5a52-a14f-83add698bf07" :knowledge-point/title "Evaluating a Limit at Infinity: Rational Solutions"}] :question/id #uuid "0fc616fa-c901-53ff-acab-cdada6bb5ce2" :question/math-academy-id "e-80" :question/problem "Evaluate $\\lim_\\limits{x\\rightarrow \\infty} \\dfrac{3x^4+9x}{6x^4-x^3}.$" :question/worked-solution "First, we divide both the numerator and the denominator by the highest power of $x$ in the denominator, which is $x^4.$ Then, by noting that the reciprocals shrink to $0$ in the limit, we can then evaluate the resulting expression.\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{3{x}^{4}+9x}{6{x}^{4}-{x}^{3}} & ={lim}_{x\\to \\infty }\\frac{(\\frac{3{x}^{4}}{{x}^{4}}+\\frac{9x}{{x}^{4}})}{(\\frac{6{x}^{4}}{{x}^{4}}-\\frac{{x}^{3}}{{x}^{4}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(3+\\frac{9}{{x}^{3}})}{(6-\\frac{1}{x})} \\\\  & =\\frac{3+0}{6-0} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186124394 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186124662 :knowledge-point/id #uuid "020c3de3-bcaf-5ade-ba50-2f15e344157d" :knowledge-point/title "Evaluating a Limit at Infinity: Infinite Solutions"}] :question/id #uuid "b648ed80-e2e1-57c4-bd37-147d92315e90" :question/math-academy-id "e-81" :question/problem "Calculate $\\lim_\\limits{x\\rightarrow -\\infty} \\dfrac{4-5x-2x^3}{x^2+3}.$" :question/worked-solution "First, we divide both the numerator and the denominator by the highest power of $x$ in the denominator, which is $x^2.$ Then, by noting that the reciprocals shrink to $0$ in the limit, we can then evaluate the resulting expression.\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }\\frac{4-5x-2{x}^{3}}{{x}^{2}+3} & ={lim}_{x\\to -\\infty }\\frac{(\\frac{-2{x}^{3}}{{x}^{2}}-\\frac{5x}{{x}^{2}}+\\frac{4}{{x}^{2}})}{(\\frac{{x}^{2}}{{x}^{2}}+\\frac{3}{{x}^{2}})} \\\\  & ={lim}_{x\\to -\\infty }\\frac{(-2x-\\frac{5}{x}+\\frac{4}{{x}^{2}})}{(1+\\frac{3}{{x}^{2}})} \\\\  & ={lim}_{x\\to -\\infty }(\\frac{-2x+0+0}{1+0}) \\\\  & ={lim}_{x\\to -\\infty }(-2x) \\\\  & =\\infty .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186124395 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186124663 :knowledge-point/id #uuid "ee15db10-b92c-5f48-8983-e602068c7e08" :knowledge-point/title "Identifying the Horizontal Asymptote of a Rational Function"}] :question/id #uuid "c3798fe4-058f-5970-a903-65c654abb788" :question/math-academy-id "e-82" :question/problem "What is the horizontal asymptote of $y=f(x)$ with $f(x)=\\dfrac{2x^3+1}{x^3-15x}?$" :question/worked-solution "The horizontal asymptote is $y=\\lim_\\limits{x \\rightarrow \\infty} f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is $x^3.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{2{x}^{3}+1}{{x}^{3}-15x} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{2{x}^{3}}{{x}^{3}}+\\frac{1}{{x}^{3}})}{(\\frac{{x}^{3}}{{x}^{3}}-\\frac{15x}{{x}^{3}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(2+\\frac{1}{{x}^{3}})}{(1-\\frac{15}{{x}^{2}})} \\\\  & =\\frac{2+0}{1-0} \\\\  & =2\\end{aligned}\n$$\n\nTherefore, the horizontal asymptote is $y=2.$"}] [{:db/id #edb/ref 17592186124408 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186124664 :knowledge-point/id #uuid "bde258b7-1654-5e73-8703-0e42371db8f4" :knowledge-point/title "Identifying When a Rational Function has No Horizontal Asymptote"}] :question/id #uuid "32a8e4bb-4191-55a8-883b-baa36f67b061" :question/math-academy-id "e-83" :question/problem "Find the horizontal asymptote of $y=f(x)$ where $f(x)=\\dfrac{x^5-10}{x^3-8x^2}.$" :question/worked-solution "The horizontal asymptote is $y=\\lim_\\limits{x \\rightarrow \\infty} f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is $x^3.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{{x}^{5}-10}{{x}^{3}-8{x}^{2}} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{{x}^{5}}{{x}^{3}}-\\frac{10}{{x}^{3}})}{(\\frac{{x}^{3}}{{x}^{3}}-\\frac{8{x}^{2}}{{x}^{3}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{({x}^{2}-\\frac{10}{{x}^{3}})}{(1-\\frac{8}{x})} \\\\  & ={lim}_{x\\to \\infty }(\\frac{{x}^{2}-0}{1-0}) \\\\  & ={lim}_{x\\to \\infty }{x}^{2} \\\\  & =\\infty .\\end{aligned}\n$$\n\nThe limit does not come out to a finite number. Therefore, there is no horizontal asymptote."}] [{:db/id #edb/ref 17592186237818 :knowledge-point/_questions [{:db/id #edb/ref 17592186124662 :knowledge-point/id #uuid "020c3de3-bcaf-5ade-ba50-2f15e344157d" :knowledge-point/title "Evaluating a Limit at Infinity: Infinite Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c55fdb4-94a8-5696-a79f-4aec4259cfa9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186236095} {:answer/id #uuid "78c24e86-ccb0-545b-9a56-9c9a78a37b68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186236575} {:answer/id #uuid "8dd4e621-fd8a-5442-bc7f-ec60a31b67e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186236714} {:answer/id #uuid "d9431812-5f39-5ef3-8901-6008588de9a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186237193} {:answer/id #uuid "fce6e95c-a436-5086-811e-2e3fcc7f7312" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186237419}] :answer-field/correct {:answer/id #uuid "2c55fdb4-94a8-5696-a79f-4aec4259cfa9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186236095} :answer-field/id #uuid "2830c226-cabc-5d07-96b2-f645a76d5197" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237492}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "13e1ae6a-783c-594e-b16d-9b94ff980ccc" :question/math-academy-id "q-101316" :question/problem "${lim}_{x\\to \\infty }\\frac{2{x}^{6}+7{x}^{3}-9}{2{x}^{3}-1}=$" :question/worked-solution "First, we divide both the numerator and the denominator by the highest power of $x$ in the denominator, which is ${x}^{3}.$ Then, by noting that the reciprocals shrink to $0$ in the limit, we can then evaluate the resulting expression.\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{2{x}^{6}+7{x}^{3}-9}{2{x}^{3}-1} & ={lim}_{x\\to \\infty }\\frac{(\\frac{2{x}^{6}}{{x}^{3}}+\\frac{7{x}^{3}}{{x}^{3}}-\\frac{9}{{x}^{3}})}{(\\frac{2{x}^{3}}{{x}^{3}}-\\frac{1}{{x}^{3}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(2{x}^{3}+7-\\frac{9}{{x}^{3}})}{(2-\\frac{1}{{x}^{3}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{2{x}^{3}+7-0}{2-0} \\\\  & =\\frac{1}{2}{lim}_{x\\to \\infty }(2{x}^{3}+7) \\\\  & =\\infty .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186486415 :knowledge-point/_questions [{:db/id #edb/ref 17592186124664 :knowledge-point/id #uuid "bde258b7-1654-5e73-8703-0e42371db8f4" :knowledge-point/title "Identifying When a Rational Function has No Horizontal Asymptote"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18225e1f-0a99-5c73-ba86-725d19891b9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-1" :db/id #edb/ref 17592186485811} {:answer/id #uuid "2c78ef0f-8c9a-5e42-bb47-baeca8842914" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=6" :db/id #edb/ref 17592186485845} {:answer/id #uuid "434a426b-ea91-5826-94d3-a8c38da8e809" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=0" :db/id #edb/ref 17592186485891} {:answer/id #uuid "4c3b8c2c-22f2-5c5d-b620-41024514bb25" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-3" :db/id #edb/ref 17592186485905} {:answer/id #uuid "7325fb68-d309-5a52-b9c3-1f2077dc2892" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186485963}] :answer-field/correct {:answer/id #uuid "7325fb68-d309-5a52-b9c3-1f2077dc2892" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186485963} :answer-field/id #uuid "2ca041ea-2eb0-5b17-ae12-8f4cd24f66d8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186486253}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9426b3d5-4ce9-5f76-8b8a-628c207151a9" :question/math-academy-id "q-101318" :question/problem "Find the horizontal asymptote of $y=f(x)$ where $f(x)=\\frac{6{x}^{3}-x}{{x}^{2}+1}.$" :question/worked-solution "The horizontal asymptote is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is ${x}^{2}.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{6{x}^{3}-x}{{x}^{2}+1} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{6{x}^{3}}{{x}^{2}}-\\frac{x}{{x}^{2}})}{(\\frac{{x}^{2}}{{x}^{2}}+\\frac{1}{{x}^{2}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(6x-\\frac{1}{x})}{(1+\\frac{1}{{x}^{2}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(6x-0)}{(1+0)} \\\\  & =6{lim}_{x\\to \\infty }x \\\\  & =\\infty .\\end{aligned}\n$$\n\n \n\nThe limit does not come out to a finite number. Therefore, there is no horizontal asymptote."}] [{:db/id #edb/ref 17592186243922 :knowledge-point/_questions [{:db/id #edb/ref 17592186124662 :knowledge-point/id #uuid "020c3de3-bcaf-5ade-ba50-2f15e344157d" :knowledge-point/title "Evaluating a Limit at Infinity: Infinite Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43b0a725-d447-576e-a529-e3e22a813ddb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186241790} {:answer/id #uuid "67ce2a5a-11a1-5cb2-a758-cede652d285c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186242113} {:answer/id #uuid "a0ef56a2-7acd-5eb0-a4ee-ce680fd2223f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186242589} {:answer/id #uuid "d52fe75b-65bd-5227-bca0-d0743266ede4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186243066} {:answer/id #uuid "e3131d35-0e58-5c14-af76-4a9ee4a1f4f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186243199}] :answer-field/correct {:answer/id #uuid "d52fe75b-65bd-5227-bca0-d0743266ede4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186243066} :answer-field/id #uuid "e3a5b97f-49c2-5d5e-b75b-00ec674594d7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243832}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a5bfb77e-165a-5915-a6e7-be81e5ce9578" :question/math-academy-id "q-106694" :question/problem "${lim}_{x\\to \\infty }\\,\\,\\frac{2x-{x}^{5}}{{x}^{3}+5}=$" :question/worked-solution "First, we divide both the numerator and the denominator by the highest power of $x$ in the denominator, which is ${x}^{3}.$ Then, by noting that the reciprocals shrink to $0$ in the limit, we can then evaluate the resulting expression.\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\,\\,\\frac{2x-{x}^{5}}{{x}^{3}+5} & ={lim}_{x\\to \\infty }\\,\\,\\frac{(\\frac{2x}{{x}^{3}}-\\frac{{x}^{5}}{{x}^{3}})}{(\\frac{{x}^{3}}{{x}^{3}}+\\frac{5}{{x}^{3}})} \\\\  & ={lim}_{x\\to \\infty }\\,\\,\\frac{(\\frac{2}{{x}^{2}}-{x}^{2})}{(1+\\frac{5}{{x}^{3}})} \\\\  & ={lim}_{x\\to \\infty }\\,\\,\\frac{0-{x}^{2}}{1-0} \\\\  & =-{lim}_{x\\to \\infty }\\,\\,{x}^{2} \\\\  & =-\\infty .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186243924 :knowledge-point/_questions [{:db/id #edb/ref 17592186124662 :knowledge-point/id #uuid "020c3de3-bcaf-5ade-ba50-2f15e344157d" :knowledge-point/title "Evaluating a Limit at Infinity: Infinite Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a7590e3-bf52-5c83-9c80-f0042f85092b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186241273} {:answer/id #uuid "145d61fd-9765-544f-89e9-bcf2afbdd4fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186241355} {:answer/id #uuid "460a89c3-adf2-5bf3-8f2b-4ba536c2709c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186241812} {:answer/id #uuid "a469b71b-ef03-5ad9-ba5d-a2469968f9c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186242625} {:answer/id #uuid "e4b282ee-11fe-5f9c-a218-05beff99d692" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186243213}] :answer-field/correct {:answer/id #uuid "0a7590e3-bf52-5c83-9c80-f0042f85092b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186241273} :answer-field/id #uuid "6a65e2ef-9a56-5774-9f2d-0f7c885d70ba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243650}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e2bbf6bd-a57e-500b-a9a6-06098ef957a5" :question/math-academy-id "q-106697" :question/problem "Calculate ${lim}_{x\\to -\\infty }\\,\\,\\frac{{x}^{7}-3{x}^{2}+4x}{{x}^{4}-3{x}^{3}+5}.$" :question/worked-solution "First, we divide both the numerator and the denominator by the highest power of $x$ in the denominator, which is ${x}^{4}.$ Then, by noting that the reciprocals shrink to $0$ in the limit, we can then evaluate the resulting expression.\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }\\,\\,\\frac{{x}^{7}-3{x}^{2}+4x}{{x}^{4}-3{x}^{3}+5} & ={lim}_{x\\to -\\infty }\\,\\,\\frac{(\\frac{{x}^{7}}{{x}^{4}}-\\frac{3{x}^{2}}{{x}^{4}}+\\frac{4x}{{x}^{4}})}{(\\frac{{x}^{4}}{{x}^{4}}-\\frac{3{x}^{3}}{{x}^{4}}+\\frac{5}{{x}^{4}})} \\\\  & ={lim}_{x\\to -\\infty }\\,\\,\\frac{({x}^{3}-\\frac{3}{{x}^{2}}+\\frac{4}{{x}^{3}})}{(1-\\frac{3}{x}+\\frac{5}{{x}^{4}})} \\\\  & ={lim}_{x\\to -\\infty }\\,\\,\\frac{({x}^{3}-0+0)}{(1-0+0)} \\\\  & ={lim}_{x\\to -\\infty }\\,\\,{x}^{3} \\\\  & =-\\infty .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297271 :knowledge-point/_questions [{:db/id #edb/ref 17592186124663 :knowledge-point/id #uuid "ee15db10-b92c-5f48-8983-e602068c7e08" :knowledge-point/title "Identifying the Horizontal Asymptote of a Rational Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f0d9acb3-2434-56be-aa4c-a64c219f0e19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{5}" :db/id #edb/ref 17592186296551}] :answer-field/correct {:answer/id #uuid "f0d9acb3-2434-56be-aa4c-a64c219f0e19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{5}" :db/id #edb/ref 17592186296551} :answer-field/id #uuid "12f4d372-a091-54bb-b1c9-2dc96c45bdc3" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296674}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a9813cef-279a-5fd4-8e50-a7601280fe38" :question/math-academy-id "q-302240" :question/problem "What is the horizontal asymptote of $y=f(x)$ for $x<0$ with $f(x)=\\frac{|8x-7|}{-5x+2}?$\n\nThe horizontal asymptote is $y=$\n\n{{field-1}}." :question/worked-solution "For large negative values of $x,$ we have $|8x-7|=-(8x-7).$ Consequently, for $x\\to -\\infty ,$ we get\n\n$$\n{lim}_{x\\to -\\infty }\\frac{|8x-7|}{-5x+2}={lim}_{x\\to -\\infty }\\frac{-(8x-7)}{-5x+2}.\n$$\n\nThe horizontal asymptote for $x<0$ is $y={lim}_{x\\to -\\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is $x.$\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }f(x) & ={lim}_{x\\to -\\infty }\\frac{-(8x-7)}{-5x+2} \\\\  & ={lim}_{x\\to -\\infty }\\frac{-(\\frac{8x}{x}-\\frac{7}{x})}{(\\frac{-5x}{x}+\\frac{2}{x})} \\\\  & ={lim}_{x\\to -\\infty }\\frac{-(8-\\frac{7}{x})}{(-5+\\frac{2}{x})} \\\\  & =\\frac{-(8-0)}{-5+0} \\\\  & =\\frac{8}{5}.\\end{aligned}\n$$\n\n \n\nTherefore, the horizontal asymptote is $y=\\frac{8}{5}.$"}] [{:db/id #edb/ref 17592186486407 :knowledge-point/_questions [{:db/id #edb/ref 17592186124661 :knowledge-point/id #uuid "32cbf366-20bd-5a52-a14f-83add698bf07" :knowledge-point/title "Evaluating a Limit at Infinity: Rational Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e2c073a3-e98b-5724-bbcf-df8e016578fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186486180}] :answer-field/correct {:answer/id #uuid "e2c073a3-e98b-5724-bbcf-df8e016578fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186486180} :answer-field/id #uuid "9305cced-9e82-583f-9fb7-1a195ab922a6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186486297}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "881251ae-3ce1-502c-8f83-ef36164a7a11" :question/math-academy-id "q-339424" :question/problem "Evaluate the limit:\n\n${lim}_{x\\to \\infty }\\frac{{x}^{2}+7x+1}{3{x}^{4}-x+5}=$\n\n{{field-1}}" :question/worked-solution "First, we divide both the numerator and the denominator by the highest power of $x$ in the denominator, which is ${x}^{4}.$ Then, by noting that the reciprocals shrink to $0$ in the limit, we can then evaluate the resulting expression.\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{{x}^{2}+7x+1}{3{x}^{4}-x+5} & ={lim}_{x\\to \\infty }\\frac{(\\frac{{x}^{2}}{{x}^{4}}+\\frac{7x}{{x}^{4}}+\\frac{1}{{x}^{4}})}{(\\frac{3{x}^{4}}{{x}^{4}}-\\frac{x}{{x}^{4}}+\\frac{5}{{x}^{4}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{1}{{x}^{2}}+\\frac{7}{{x}^{3}}+\\frac{1}{{x}^{4}})}{(3-\\frac{1}{{x}^{3}}+\\frac{5}{{x}^{4}})} \\\\  & =\\frac{0+0}{3-0+0} \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186413322 :knowledge-point/_questions [{:db/id #edb/ref 17592186124662 :knowledge-point/id #uuid "020c3de3-bcaf-5ade-ba50-2f15e344157d" :knowledge-point/title "Evaluating a Limit at Infinity: Infinite Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "955a14ee-2d66-50bc-8de3-377077da9e48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\infty" :db/id #edb/ref 17592186413309}] :answer-field/correct {:answer/id #uuid "955a14ee-2d66-50bc-8de3-377077da9e48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\infty" :db/id #edb/ref 17592186413309} :answer-field/id #uuid "e59f45ed-d037-5bd6-940e-13f41f6c836c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186413320}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d8cdb7dd-976e-5b44-901a-f1aa1b8415b7" :question/math-academy-id "q-339615" :question/problem "Evaluate the limit:\n\n${lim}_{x\\to \\infty }\\,\\,\\frac{-{x}^{7}+3}{{x}^{4}+6x+2}=$\n\n{{field-1}}" :question/worked-solution "First, we divide both the numerator and the denominator by the highest power of $x$ in the denominator, which is ${x}^{4}.$ Then, by noting that the reciprocals shrink to $0$ in the limit, we can then evaluate the resulting expression.\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\,\\,\\frac{-{x}^{7}+3}{{x}^{4}+6x+2} & ={lim}_{x\\to \\infty }\\,\\,\\frac{(\\frac{-{x}^{7}}{{x}^{4}}+\\frac{3}{{x}^{4}})}{(\\frac{{x}^{4}}{{x}^{4}}+\\frac{6x}{{x}^{4}}+\\frac{2}{{x}^{4}})} \\\\  & ={lim}_{x\\to \\infty }\\,\\,\\frac{(-{x}^{3}+\\frac{3}{{x}^{4}})}{(1+\\frac{6}{{x}^{3}}+\\frac{2}{{x}^{4}})} \\\\  & ={lim}_{x\\to \\infty }\\,\\text{ }\\frac{-{x}^{3}+0}{1+0+0} \\\\  & ={lim}_{x\\to \\infty }\\,\\,-{x}^{3} \\\\  & =-\\infty .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186314804 :knowledge-point/_questions [{:db/id #edb/ref 17592186124662 :knowledge-point/id #uuid "020c3de3-bcaf-5ade-ba50-2f15e344157d" :knowledge-point/title "Evaluating a Limit at Infinity: Infinite Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c24294b-34a4-5d19-98d3-e45b31b33e68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186312822} {:answer/id #uuid "9de6e7b6-7290-559c-ac83-f864f0b80f97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty" :db/id #edb/ref 17592186486047}] :answer-field/correct {:answer/id #uuid "9de6e7b6-7290-559c-ac83-f864f0b80f97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty" :db/id #edb/ref 17592186486047} :answer-field/id #uuid "3319e749-9653-5a21-bf0b-e2fb9dca7f41" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314148}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "53a17b4c-4adf-5239-8971-3a7f7c6e95fd" :question/math-academy-id "q-339623" :question/problem "Evaluate the limit:\n\n${lim}_{x\\to -\\infty }\\,\\,\\frac{{x}^{4}-2}{5{x}^{2}-1}=$\n\n{{field-1}}" :question/worked-solution "First, we divide both the numerator and the denominator by the highest power of $x$ in the denominator, which is ${x}^{2}.$ Then, by noting that the reciprocals shrink to $0$ in the limit, we can then evaluate the resulting expression.\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }\\,\\,\\frac{{x}^{4}-2}{5{x}^{2}-1} & ={lim}_{x\\to -\\infty }\\,\\,\\frac{(\\frac{{x}^{4}}{{x}^{2}}-\\frac{2}{{x}^{2}})}{(\\frac{5{x}^{2}}{{x}^{2}}-\\frac{1}{{x}^{2}})} \\\\  & ={lim}_{x\\to -\\infty }\\,\\,\\frac{({x}^{2}-\\frac{2}{{x}^{2}})}{(5-\\frac{1}{{x}^{2}})} \\\\  & ={lim}_{x\\to -\\infty }\\,\\,\\frac{{x}^{2}-0}{5-0} \\\\  & ={lim}_{x\\to -\\infty }\\frac{{x}^{2}}{5} \\\\  & =\\infty .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186486364 :knowledge-point/_questions [{:db/id #edb/ref 17592186124663 :knowledge-point/id #uuid "ee15db10-b92c-5f48-8983-e602068c7e08" :knowledge-point/title "Identifying the Horizontal Asymptote of a Rational Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7c2c59b0-a796-5757-a453-236cf2d643bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186485983}] :answer-field/correct {:answer/id #uuid "7c2c59b0-a796-5757-a453-236cf2d643bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186485983} :answer-field/id #uuid "b57aac32-eba8-5f85-9381-a300601e8081" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186486314}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "22cc12b8-5ddc-5c5a-b8ac-2ac46afb7003" :question/math-academy-id "q-339637" :question/problem "The horizontal asymptote of the function $f(x)=\\frac{-1}{3{x}^{3}+5}$ is\n\n$y=$\n{{field-1}}." :question/worked-solution "The horizontal asymptote is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is ${x}^{3}.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{-1}{3{x}^{3}+5} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{-1}{{x}^{3}})}{(\\frac{3{x}^{3}}{{x}^{3}}+\\frac{5}{{x}^{3}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{-1}{{x}^{3}})}{(3+\\frac{5}{{x}^{3}})} \\\\  & =\\frac{0}{3+0} \\\\  & =0.\\end{aligned}\n$$\n\n \n\nTherefore, the horizontal asymptote of $f(x)$ is $y=0.$"}] [{:db/id #edb/ref 17592186486408 :knowledge-point/_questions [{:db/id #edb/ref 17592186124661 :knowledge-point/id #uuid "32cbf366-20bd-5a52-a14f-83add698bf07" :knowledge-point/title "Evaluating a Limit at Infinity: Rational Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "725cde84-240c-5711-867a-be8e0d4bd1a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186485961} {:answer/id #uuid "a260e183-6a51-5103-8e98-b97570d9cc31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186486054} {:answer/id #uuid "a2ac2659-0176-5b78-a38a-f3cd1c7380d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186486056} {:answer/id #uuid "cd567928-025a-5d7c-a077-128da30f66f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186486135} {:answer/id #uuid "eafe233a-e75a-5307-a7f3-812ec920fd1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186486194}] :answer-field/correct {:answer/id #uuid "cd567928-025a-5d7c-a077-128da30f66f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186486135} :answer-field/id #uuid "51d88423-72f9-55d3-bfd2-ae1d580b9e22" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186486271}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8bd57c14-ae43-573a-96f9-4a756bc9a869" :question/math-academy-id "q-35719" :question/problem "${lim}_{x\\to -\\infty }\\frac{{x}^{2}+9}{8{x}^{5}+x}=$" :question/worked-solution "First, we divide both the numerator and the denominator by the highest power of $x$ in the denominator, which is ${x}^{5}.$ Then, by noting that the reciprocals shrink to $0$ in the limit, we can then evaluate the resulting expression.\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }\\frac{{x}^{2}+9}{8{x}^{5}+x} & ={lim}_{x\\to -\\infty }\\frac{(\\frac{{x}^{2}}{{x}^{5}}+\\frac{9}{{x}^{5}})}{(\\frac{8{x}^{5}}{{x}^{5}}+\\frac{x}{{x}^{5}})} \\\\  & ={lim}_{x\\to -\\infty }\\frac{(\\frac{1}{{x}^{3}}+\\frac{9}{{x}^{5}})}{(8+\\frac{1}{{x}^{4}})} \\\\  & =\\frac{0+0}{8+0} \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186486356 :knowledge-point/_questions [{:db/id #edb/ref 17592186124661 :knowledge-point/id #uuid "32cbf366-20bd-5a52-a14f-83add698bf07" :knowledge-point/title "Evaluating a Limit at Infinity: Rational Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29005a9b-9b50-5a7c-888b-dcbf8ffed5ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186485837} {:answer/id #uuid "7be291b6-d083-5af3-8ebc-d5ffcb3774df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186485982} {:answer/id #uuid "e9e3277a-6fab-503e-97c7-15fca17a5119" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186486193} {:answer/id #uuid "f27dfe74-1cc3-5f37-8d41-5e6cb0ac0cea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186486205} {:answer/id #uuid "fb11c2f2-7ebe-5372-8d74-0d5f425df3a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{4}" :db/id #edb/ref 17592186486219}] :answer-field/correct {:answer/id #uuid "e9e3277a-6fab-503e-97c7-15fca17a5119" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186486193} :answer-field/id #uuid "8fec2a0d-6bd7-5672-995f-b7af0b1f6b11" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186486295}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "16c9d9f3-b6b3-5f3f-a06a-81ddff866ad4" :question/math-academy-id "q-35725" :question/problem "Given that ${lim}_{x\\to \\infty }\\frac{1-18{x}^{2}}{12p{x}^{2}-3x+9}=-2,$  what is the value of $p?$" :question/worked-solution "First, we divide both the numerator and the denominator by the highest power of $x$ in the denominator, which is ${x}^{2}.$ Then, by noting that the reciprocals shrink to $0$ in the limit, we can then evaluate the resulting expression.\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{1-18{x}^{2}}{12p{x}^{2}-3x+9} & ={lim}_{x\\to \\infty }\\frac{(\\frac{1}{{x}^{2}}-\\frac{18{x}^{2}}{{x}^{2}})}{(\\frac{12p{x}^{2}}{{x}^{2}}-\\frac{3x}{{x}^{2}}+\\frac{9}{{x}^{2}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{1}{{x}^{2}}-18)}{(12p-\\frac{3}{x}+\\frac{9}{{x}^{2}})} \\\\  & =\\frac{0-18}{12p-0+0} \\\\  & =-\\frac{3}{2p}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}-\\frac{3}{2p} & =-2 \\\\ 4p & =3 \\\\ p & =\\frac{3}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186486389 :knowledge-point/_questions [{:db/id #edb/ref 17592186124663 :knowledge-point/id #uuid "ee15db10-b92c-5f48-8983-e602068c7e08" :knowledge-point/title "Identifying the Horizontal Asymptote of a Rational Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28f1e747-6d55-5298-ace4-95dd52c7d617" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=0" :db/id #edb/ref 17592186485836} {:answer/id #uuid "3a437750-a172-5976-b64c-d632be99d199" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{2}" :db/id #edb/ref 17592186485878} {:answer/id #uuid "417e061a-8287-5bae-b9b8-c63d3153875c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186485888} {:answer/id #uuid "c50ca5b1-36da-5a46-b3f8-e7b59a548d3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2" :db/id #edb/ref 17592186486118} {:answer/id #uuid "fb6b5695-1aa2-5966-99ac-6888affc3493" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=1" :db/id #edb/ref 17592186486220}] :answer-field/correct {:answer/id #uuid "28f1e747-6d55-5298-ace4-95dd52c7d617" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=0" :db/id #edb/ref 17592186485836} :answer-field/id #uuid "644a0d25-983f-5344-8813-91c7a7069fd3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186486280}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5d186d1a-cd8d-5a4f-8dee-02515d4d8947" :question/math-academy-id "q-35765" :question/problem "Find the horizontal asymptote of the function $f(x)=\\frac{6{x}^{5}}{2{x}^{9}+{x}^{4}+9x}.$" :question/worked-solution "The horizontal asymptote is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is ${x}^{9}.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{6{x}^{5}}{2{x}^{9}+{x}^{4}+9x} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{6{x}^{5}}{{x}^{9}})}{(\\frac{2{x}^{9}}{{x}^{9}}+\\frac{{x}^{4}}{{x}^{9}}+\\frac{9x}{{x}^{9}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{6}{{x}^{4}})}{(2+\\frac{1}{{x}^{5}}+\\frac{9}{{x}^{8}})} \\\\  & =\\frac{0}{2+0+0} \\\\  & =0.\\end{aligned}\n$$\n\n \n\nTherefore, the horizontal asymptote is $y=0.$"}] [{:db/id #edb/ref 17592186323720 :knowledge-point/_questions [{:db/id #edb/ref 17592186124663 :knowledge-point/id #uuid "ee15db10-b92c-5f48-8983-e602068c7e08" :knowledge-point/title "Identifying the Horizontal Asymptote of a Rational Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16123c5b-0e24-5448-94af-edee5d7a2379" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2" :db/id #edb/ref 17592186321327} {:answer/id #uuid "54a80482-3b1f-51c4-b743-a176cf7