rac{14}{6+0} \\\\  & =\\frac{7}{3}.\\end{aligned}\n$$\n\n \n\nTherefore, the horizontal asymptote of $f(x)$ is $y=\\frac{7}{3}.$"}] [{:db/id #edb/ref 17592186323722 :knowledge-point/_questions [{:db/id #edb/ref 17592186124664 :knowledge-point/id #uuid "bde258b7-1654-5e73-8703-0e42371db8f4" :knowledge-point/title "Identifying When a Rational Function has No Horizontal Asymptote"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "234f7d81-e78d-5fe3-b129-5f4bf00e6224" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-5" :db/id #edb/ref 17592186321417} {:answer/id #uuid "4ea65ffe-2fe5-5c75-b24e-efb906e8e11c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{1}{2}" :db/id #edb/ref 17592186321766} {:answer/id #uuid "71d3622c-9734-56d4-ab39-31e03ec099f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=0" :db/id #edb/ref 17592186322042} {:answer/id #uuid "87f2f1fd-23cf-5869-958e-7a4bba436621" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2" :db/id #edb/ref 17592186322229} {:answer/id #uuid "c3cb3150-af20-55f7-b016-5c74565acbc8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186322666}] :answer-field/correct {:answer/id #uuid "c3cb3150-af20-55f7-b016-5c74565acbc8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186322666} :answer-field/id #uuid "bafb6833-d353-5e3b-ad9b-f62986ed6b18" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323536}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6fca582f-c695-580e-9776-a4158e15837c" :question/math-academy-id "q-35835" :question/problem "Find the horizontal asymptote of the function $f(x)=\\frac{-5{x}^{7}+1}{10{x}^{3}+x+3}.$" :question/worked-solution "The horizontal asymptote is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is ${x}^{3}.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{-5{x}^{7}+1}{10{x}^{3}+x+3} \\\\  & ={lim}_{x\\to \\infty }\\frac{(-\\frac{5{x}^{7}}{{x}^{3}}+\\frac{1}{{x}^{3}})}{(\\frac{10{x}^{3}}{{x}^{3}}+\\frac{x}{{x}^{3}}+\\frac{3}{{x}^{3}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(-5{x}^{4}+\\frac{1}{{x}^{3}})}{(10+\\frac{1}{{x}^{2}}+\\frac{3}{{x}^{3}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{-5{x}^{4}+0}{10+0+0} \\\\  & =-\\frac{1}{2}{lim}_{x\\to \\infty }{x}^{4} \\\\  & =-\\infty .\\end{aligned}\n$$\n\n \n\nThe limit does not come out to a finite number. Therefore, there is no horizontal asymptote."}] [{:db/id #edb/ref 17592186486362 :knowledge-point/_questions [{:db/id #edb/ref 17592186124663 :knowledge-point/id #uuid "ee15db10-b92c-5f48-8983-e602068c7e08" :knowledge-point/title "Identifying the Horizontal Asymptote of a Rational Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0040223b-3414-5538-888b-8f1cdb82fe50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=1" :db/id #edb/ref 17592186485762} {:answer/id #uuid "03d97ec7-41c9-58e3-9bad-cd84ac80020c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=0" :db/id #edb/ref 17592186485773} {:answer/id #uuid "4bad6395-c50c-5273-b2cf-20bebd01232a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4" :db/id #edb/ref 17592186485903} {:answer/id #uuid "64bfad7a-0820-50f0-93a5-c290dcf81277" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186485938} {:answer/id #uuid "b28f6df6-dd1f-5815-9b84-be8a451f93f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{5}{4}" :db/id #edb/ref 17592186486085}] :answer-field/correct {:answer/id #uuid "03d97ec7-41c9-58e3-9bad-cd84ac80020c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=0" :db/id #edb/ref 17592186485773} :answer-field/id #uuid "d99197d1-b7c2-5321-bba2-d50ff0c5dd66" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186486329}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1d359bbd-ffea-5e49-a7be-f90cdd60255a" :question/math-academy-id "q-48838" :question/problem "Find the horizontal asymptote of the function $f(x)=\\frac{5}{{x}^{2}+4}.$" :question/worked-solution "The horizontal asymptote is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is ${x}^{2}.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{5}{{x}^{2}+4} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{5}{{x}^{2}})}{(\\frac{{x}^{2}}{{x}^{2}}+\\frac{4}{{x}^{2}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{5}{{x}^{2}})}{(1+\\frac{4}{{x}^{2}})} \\\\  & =\\frac{0}{1+0} \\\\  & =0.\\end{aligned}\n$$\n\n \n\nTherefore, the horizontal asymptote of $f(x)$ is $y=0.$"}] [{:db/id #edb/ref 17592186486372 :knowledge-point/_questions [{:db/id #edb/ref 17592186124661 :knowledge-point/id #uuid "32cbf366-20bd-5a52-a14f-83add698bf07" :knowledge-point/title "Evaluating a Limit at Infinity: Rational Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d9fedce-bc28-5d24-b746-f2a3ba35b875" :answer/type {:db/id #edb/ref 17592186045498 :d