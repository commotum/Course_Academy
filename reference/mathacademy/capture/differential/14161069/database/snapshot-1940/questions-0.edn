x}^{3}})}{(1-\\frac{8}{{x}^{3}})} \\\\  & =\\frac{0}{(1-0)} \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329940 :knowledge-point/_questions [{:db/id #edb/ref 17592186124661 :knowledge-point/id #uuid "32cbf366-20bd-5a52-a14f-83add698bf07" :knowledge-point/title "Evaluating a Limit at Infinity: Rational Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "146df663-646f-583b-8853-1b29177d56fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186327107} {:answer/id #uuid "57ab1978-4fc2-588a-8e55-e2e1e3f01d86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186327699} {:answer/id #uuid "5c72e787-b85a-53cc-b7c2-f60f281d9f8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186327744} {:answer/id #uuid "b1c68607-b916-59d2-a86f-fb27b22351ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186328473} {:answer/id #uuid "e55d3de8-5905-5c5c-9468-8c6422623d14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186328942}] :answer-field/correct {:answer/id #uuid "146df663-646f-583b-8853-1b29177d56fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186327107} :answer-field/id #uuid "a9a3b49d-6d69-5d8a-917f-db73c53a3540" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329478}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9ab17231-842d-5e7f-9ff8-285a1cc56cb1" :question/math-academy-id "q-48925" :question/problem "${lim}_{x\\to -\\infty }\\frac{|6x-4|}{3x+4}=$" :question/worked-solution "For sufficiently large negative values of $x,$ we have $|6x-4|=-(6x-4)=-6x+4.$ Consequently, for $x\\to -\\infty ,$ we get\n\n$$\n{lim}_{x\\to -\\infty }\\frac{|6x-4|}{3x+4}={lim}_{x\\to -\\infty }\\frac{-6x+4}{3x+4}.\n$$\n\nFirst, we divide both the numerator and the denominator by the highest power of $x$ in the denominator, which is ${x}^{1}.$ Then, by noting that the reciprocals shrink to $0$ in the limit, we can then evaluate the resulting expression.\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }\\frac{-6x+4}{3x+4} & ={lim}_{x\\to -\\infty }\\frac{(\\frac{-6x}{x}+\\frac{4}{x})}{(\\frac{3x}{x}+\\frac{4}{x})} \\\\  & ={lim}_{x\\to -\\infty }\\frac{(-6+\\frac{4}{x})}{(3+\\frac{4}{x})} \\\\  & =\\frac{-6+0}{3+0} \\\\  & =-2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186335946 :knowledge-point/_questions [{:db/id #edb/ref 17592186124664 :knowledge-point/id #uuid "bde258b7-1654-5e73-8703-0e42371db8f4" :knowledge-point/title "Identifying When a Rational Function has No Horizontal Asymptote"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "142cf96f-53f3-5b6f-bdcf-73a359ab0b6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{5}" :db/id #edb/ref 17592186333166} {:answer/id #uuid "1a6a8233-ba1d-5256-ae17-62beaf3e7d29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186333232} {:answer/id #uuid "8a1fe2b5-c224-5f63-bc0e-38f520111296" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186334221} {:answer/id #uuid "bd46532d-7f38-534f-a68a-6f3926e6afcc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186334633} {:answer/id #uuid "edd473a6-2783-5ab7-b8c8-6144975fc73d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186335076}] :answer-field/correct {:answer/id #uuid "bd46532d-7f38-534f-a68a-6f3926e6afcc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186334633} :answer-field/id #uuid "fdec7d8b-cde3-5351-955b-03701c3f9af2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335682}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6089db0f-0d34-5714-823b-8d79a6bc501d" :question/math-academy-id "q-68068" :question/problem "Find the horizontal asymptote of $y=f(x)$ where $f(x)=\\frac{4{x}^{3}+6}{5x}.$" :question/worked-solution "The horizontal asymptote is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is $x.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{4{x}^{3}+6}{5x} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{4{x}^{3}}{x}+\\frac{6}{x})}{(\\frac{5x}{x})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(4{x}^{2}+\\frac{6}{x})}{5} \\\\  & ={lim}_{x\\to \\infty }\\frac{(4{x}^{2}+0)}{5} \\\\  & =\\frac{4}{5}{lim}_{x\\to \\infty }{x}^{2} \\\\  & =\\infty .\\end{aligned}\n$$\n\n \n\nThe limit does not come out to a finite number. Therefore, there is no horizontal asymptote."}] [{:db/id #edb/ref 17592186335947 :knowledge-point/_questions [{:db/id #edb/ref 17592186124664 :knowledge-point/id #uuid "bde258b7-1654-5e73-8703-0e42371db8f4" :knowledge-point/title "Identifying When a Rational Function has No Horizontal Asymptote"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07861053-efcd-5054-bda8-5b43052cc4e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186333063} {:answer/id #uuid "116b15a5-e064-5b08-8a01-6e79c8c564cc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186333145} {:answer/id #uuid "26048c5f-c841-573f-8e79-1ce438d9f778" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186333340} {:answer/id #uuid "e4db77d8-2f83-5ff5-b83f-88bb63a791db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{2}" :db/id #edb/ref 17592186334984} {:answer/id #uuid "f4879d14-9de7-56f0-88cb-088c95731d16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186335131}] :answer-field/correct {:answer/id #uuid "116b15a5-e064-5b08-8a01-6e79c8c564cc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186333145} :answer-field/id #uuid "090a0827-2b0f-5abd-a88e-87efbe8c8519" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335249}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "98294198-57a8-5bec-b4cf-a0af2cd8622c" :question/math-academy-id "q-68072" :question/problem "Find the horizontal asymptote of $y=f(x)$ where $f(x)=\\frac{-7{x}^{4}+3}{2{x}^{2}-4}.$" :question/worked-solution "The horizontal asymptote is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is ${x}^{2}.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{-7{x}^{4}+3}{2{x}^{2}-4} \\\\  & {lim}_{x\\to \\infty }\\frac{(\\frac{-7{x}^{4}}{{x}^{2}}+\\frac{3}{{x}^{2}})}{(\\frac{2{x}^{2}}{{x}^{2}}-\\frac{4}{{x}^{2}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(-7{x}^{2}+\\frac{3}{{x}^{2}})}{(2-\\frac{4}{{x}^{2}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{-7{x}^{2}+0}{2-0} \\\\  & =\\frac{7}{2}{lim}_{x\\to \\infty }(-{x}^{2}) \\\\  & =-\\infty .\\end{aligned}\n$$\n\n \n\nThe limit does not come out to a finite number. Therefore, there is no horizontal asymptote."}] [{:db/id #edb/ref 17592186348056 :knowledge-point/_questions [{:db/id #edb/ref 17592186124664 :knowledge-point/id #uuid "bde258b7-1654-5e73-8703-0e42371db8f4" :knowledge-point/title "Identifying When a Rational Function has No Horizontal Asymptote"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "117be22f-0498-56c8-8c5e-eeea3bfa919b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=0" :db/id #edb/ref 17592186345500} {:answer/id #uuid "42848b2b-0583-5a3a-b1e5-791f99f8dd1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4" :db/id #edb/ref 17592186345921} {:answer/id #uuid "7ddd3c81-6a6b-5d64-914b-025b09f1a30c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2" :db/id #edb/ref 17592186346452} {:answer/id #uuid "e23f104d-f3a1-52e8-b59e-42a5c19f1d74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=5" :db/id #edb/ref 17592186347341} {:answer/id #uuid "f446b28c-37f3-5de6-9491-dc3048430119" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186347519}] :answer-field/correct {:answer/id #uuid "f446b28c-37f3-5de6-9491-dc3048430119" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186347519} :answer-field/id #uuid "abaa5846-1c43-5a58-ae01-c2d971b74ea6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347905}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "46a07c22-0617-5695-b7be-c28f6615ea99" :question/math-academy-id "q-78013" :question/problem "Find the horizontal asymptote of $y=f(x)$ where $f(x)=\\frac{4{x}^{2}+5}{2x}.$" :question/worked-solution "The horizontal asymptote is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is $x.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{4{x}^{2}+5}{2x} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{4{x}^{2}}{x}+\\frac{5}{x})}{(\\frac{2x}{x})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(4x+\\frac{5}{x})}{2} \\\\  & ={lim}_{x\\to \\infty }\\frac{(4x+0)}{2} \\\\  & ={lim}_{x\\to \\infty }2x \\\\  & =\\infty .\\end{aligned}\n$$\n\n \n\nThe limit does not come out to a finite number. Therefore, there is no horizontal asymptote."}]}
