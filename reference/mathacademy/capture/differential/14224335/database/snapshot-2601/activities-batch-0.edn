#edb/ref 17592186045498} :answer/value "16" :db/id #edb/ref 17592186380875} {:answer/id #uuid "f9b9919a-def8-55b0-b9c2-b44fc832ab35" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14" :db/id #edb/ref 17592186380876} {:answer/id #uuid "831f7c88-e098-5c1f-a8e5-ccb34b89df28" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186380877} {:answer/id #uuid "67ea11e1-25b5-553f-9220-1d54bd8cbd08" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "32" :db/id #edb/ref 17592186380878} {:answer/id #uuid "14b66f59-cdaf-5100-99dd-152700887b12" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18" :db/id #edb/ref 17592186380879}] :answer-field/correct {:db/id #edb/ref 17592186380879} :answer-field/id #uuid "4f5de000-5e2e-5293-bbbc-fea0dfb73f12" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186380874}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2a641d94-d436-5610-8401-c196fdb866a7" :question/math-academy-id "q-129953" :question/problem "Calculate ${∬}_{R}(3{x}^{2}+6{y}^{2})\\,\\text{d}A$,  where $R=[-1,0]\\times [0,2].$" :question/worked-solution "Using the linearity property of double integrals, we can write\n\n$$\n\\begin{aligned}{∬}_{R}(3{x}^{2}+6{y}^{2})\\text{d}A & ={∬}_{R}3{x}^{2}\\text{ }\\text{d}A+{∬}_{R}6{y}^{2}\\text{ }\\text{d}A.\\end{aligned}\n$$\n\nThe function under the first integral is independent of $y.$ So, we have \n\n$$\n\\begin{aligned}{∬}_{R}3{x}^{2}\\text{ }\\text{d}A & =(2-0){\\int }_{-1}^{0}3{x}^{2}\\,\\text{d}x \\\\  & =2({x}^{3}{|}_{-1}^{0}) \\\\  & =2({0}^{3}-(-1)^{3}) \\\\  & =2.\\end{aligned}\n$$\n\nThe function under the second integral is independent of $x.$ So, we have \n\n$$\n\\begin{aligned}{∬}_{R}6{y}^{2}\\text{ }\\text{d}A & =(0-(-1)){\\int }_{0}^{2}6{y}^{2}\\,\\text{d}y \\\\  & =2{y}^{3}{|}_{0}^{2} \\\\  & =2\\cdot {2}^{3}-0 \\\\  & =16.\\end{aligned}\n$$\n\nFinally, combining our results, we obtain\n\n$$\n\\begin{aligned}{∬}_{R}(3{x}^{2}+6{y}^{2})\\,\\text{d}A=2+16=18.\\end{aligned}\n$$"} :step/id #uuid "893db046-3a6d-56c7-8f63-bc9d855915b3" :step/next {:db/id #edb/ref 17592186541192}} {:db/id #edb/ref 17592186541219 :step/content {:db/id #edb/ref 17592186541090 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27dab55e-2a07-5559-adf9-474a787ae042" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{∬}_{(0,\\pi )\\times (-\\pi /2,0)}\\operatorname{cos}⁡(x+y)\\,\\text{d}A+{∬}_{(0,\\pi )\\times (0,\\pi /2)}\\operatorname{sin}⁡(x-y)\\,\\text{d}A" :db/id #edb/ref 17592186540597} {:answer/id #uuid "4a503419-3b03-55f7-a026-c71a3cdf1fda" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{∬}_{(0,\\pi )\\times (-\\pi /2,0)}\\operatorname{sin}⁡(x-y)\\,\\text{d}A+{∬}_{(0,\\pi )\\times (0,\\pi /2)}\\operatorname{cos}⁡(x+y)\\,\\text{d}A" :db/id #edb/ref 17592186540660} {:answer/id #uuid "cf8aa907-71bd-57bd-b9b0-a791585844c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{∬}_{(0,\\pi )\\times (-\\pi /2,\\pi /2)}(\\operatorname{sin}⁡(x+y)-\\operatorname{cos}⁡(x-y))\\text{ }\\text{d}A" :db/id #edb/ref 17592186540878} {:answer/id #uuid "db274e58-8e5f-5077-88fc-c9024b1f6057" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{∬}_{(0,\\pi )\\times (-\\pi /2,0)}\\operatorname{sin}⁡(x+y)\\operatorname{cos}⁡(x-y)\\,\\text{d}A" :db/id #edb/ref 17592186540901} {:answer/id #uuid "ff3ec6df-aa0b-5131-ba4c-022b02da3f60" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{∬}_{(0,\\pi )\\times (-\\pi /2,0)}\\operatorname{sin}⁡(x+y)\\,\\text{d}A+{∬}_{(0,\\pi )\\times (0,\\pi /2)}\\operatorname{cos}⁡(x-y)\\,\\text{d}A" :db/id #edb/ref 17592186540940}] :answer-field/correct {:db/id #edb/ref 17592186540940} :answer-field/id #uuid "c22f973c-4187-5d34-928b-a206bc95c78a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186541027}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "66ff7371-5323-5876-b071-49b4ca2a6463" :question/math-academy-id "q-80674" :question/problem "Let the function $f(x,y)$ be defined as\n\n$$\nf(x,y)=\\{\\begin{aligned}\\operatorname{sin}⁡(x+y),\\, & \\text{if}\\,0<x<\\pi ,\\,-\\frac{\\pi }{2}<y<0, \\\\ \\operatorname{cos}⁡(x-y),\\, & \\text{if}\\,0<x<\\pi ,\\,0<y<\\frac{\\pi }{2}.\\end{aligned}\n$$\n\nThen,\n\n$$\n{∬}_{(0,\\pi )\\times (-\\pi /2,\\pi /2)}f(x,y)\\text{ }\\text{d}A=\n$$" :question/worked-solution "First, notice that the rectangle $R$ can be represented as a union of two smaller rectangles, as follows:\n\n$$\n\\begin{aligned}R & =(0,\\pi )\\times ((-\\frac{\\pi }{2},0)\\cup (0,\\frac{\\pi }{2})) \\\\  & =((0,\\pi )\\times (-\\frac{\\pi }{2},0))\\cup ((0,\\pi )\\times (0,\\frac{\\pi }{2})).\\end{aligned}\n$$\n\nSo, we can write\n\n$$\n\\begin{aligned}{∬}_{R}f(x,y)\\,\\text{d}A & ={∬}_{(0,\\pi )\\times (-\\pi /2,0)}f(x,y)\\,\\text{d}A+{∬}_{(0,\\pi )\\times (0,\\pi /2)}f(x,y)\\,\\text{d}A \\\\  & ={∬}_{(0,\\pi )\\times (-\\pi /2,0)}\\operatorname{sin}⁡(x+y)\\,\\text{d}A+{∬}_{(0,\\pi )\\times (0,\\pi /2)}\\operatorname{cos}⁡(x-y)\\,\\text{d}A.\\end{aligned}\n$$"} :step/id #uuid "ca77b050-7163-5e44-bed7-5cbfe6365a13" :step/next {:db/id #edb/ref 17592186541198}} {:db/id #edb/ref 17592186541220 :step/content {:db/id #edb/ref 17592186129872 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34b43744-10b8-5bdd-86b0-6a7b66637027" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{∬}_{(0,2)}(x+y)\\,\\text{d}A+{∬}_{(-1,1)}\\operatorname{sin}⁡(x+y)\\,\\text{d}A" :db/id #edb/ref 17592186540609} {:answer/id #uuid "48d84918-aaf4-5e48-802a-eb621ffae666" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{∬}_{(0,1)\\times (-1,1)}(x+y)\\,\\text{d}A+{∬}_{(1,2)\\times (-1,1)}\\operatorname{sin}⁡(x+y)\\,\\text{d}A" :db/id #edb/ref 17592186540658} {:answer/id #uuid "5ba92148-b911-57fa-bcc8-d6592d9da4b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{∬}_{(-1,1)}(x+y)\\,\\text{d}A+{∬}_{(0,2)}\\operatorname{sin}⁡(x+y)\\,\\text{d}A" :db/id #edb/ref 17592186540682} {:answer/id #uuid "822a278f-47f8-5535-9796-535bd9d05cea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{∬}_{(0,2)\\times (-1,1)}(x+y)\\,\\text{d}A+{∬}_{(0,2)\\times (-1,1)}\\operatorname{sin}⁡(x+y)\\,\\text{d}A" :db/id #edb/ref 17592186540750} {:answer/id #uuid "c5b9d0b8-9a3f-5bdc-b4d0-bb4eb57acfcf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{∬}_{(0,2)\\times (-1,0)}(x+y)\\,\\text{d}A+{∬}_{(0,2)\\times (0,1)}\\operatorname{sin}⁡(x+y)\\,\\text{d}A" :db/id #edb/ref 17592186540857}] :answer-field/correct {:db/id #edb/ref 17592186540857} :answer-field/id #uuid "24968e69-4fb3-5ca6-888b-ea79f8a7f6b2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186128713}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "66b7b545-f5c5-56eb-bf68-00d58148275e" :question/math-academy-id "q-80449" :question/problem "Let the function $f(x,y)$ be defined as\n\n$$\nf(x,y)=\\{\\begin{aligned}x+y,\\, & \\text{if}\\,0<x<2,\\,-1<y<0, \\\\ \\operatorname{sin}⁡(x+y),\\, & \\text{if}\\,0<x<2,\\,0<y<1.\\end{aligned}\n$$\n\nThen,\n\n$$\n{∬}_{(0,2)\\times (-1,1)}f(x,y)\\text{ }\\text{d}A=\n$$" :question/worked-solution "First, notice that the rectangle $R$ can be represented as a union of two smaller rectangles, as follows:\n\n$$\n\\begin{aligned}R & =(0,2)\\times ((-1,0)\\cup (0,1)) \\\\  & =((0,2)\\times (-1,0))\\cup ((0,2)\\times (0,1)).\\end{aligned}\n$$\n\nSo, we can write\n\n$$\n\\begin{aligned}{∬}_{R}f(x,y)\\,\\text{d}A & ={∬}_{(0,2)\\times (-1,0)}f(x,y)\\,\\text{d}A+{∬}_{(0,2)\\times (0,1)}f(x,y)\\,\\text{d}A \\\\  & ={∬}_{(0,2)\\times (-1,0)}(x+y)\\,\\text{d}A+{∬}_{(0,2)\\times (0,1)}\\operatorname{sin}⁡(x+y)\\,\\text{d}A.\\end{aligned}\n$$"} :step/id #uuid "cd03560a-f875-5516-bfa6-d69e8b5f5aca" :step/next {:db/id #edb/ref 17592186541219}}] :activity/title "Properties of Double Integrals" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186540526}] [{:activity/expected-seconds 840.0 :activity/first-step {:db/id #edb/ref 17592186134648} :activity/id #uuid "5ee13f38-08f9-501d-b6b6-787a1145a683" :activity/scope {:db/id #edb/ref 17592186050693 :topic/id #uuid "5f71e968-b382-5c1b-bc8c-518dc0440228" :topic/math-academy-id 2101} :activity/steps [{:db/id #edb/ref 17592186134648 :step/content {:db/id #edb/ref 17592186135038 :tutorial/content "The **Cauchy-Schwarz Inequality** (sometimes called the **Cauchy-Bunyakovsky-Schwarz Inequality**) provides a connection between dot products and norms. It states that for any two vectors $\\mathbf{u}$ and $\\mathbf{v}$ in $\\mathbb{R}^n$, we have the inequality\n\n$$\n\\vert \\mathbf{u} \\cdot \\mathbf{v} \\vert \\leq \\Vert \\mathbf{u} \\Vert \\Vert \\mathbf{v} \\Vert.\n$$\n\nIn other words, the absolute value of the dot product is no more than the product of the norms.\n\nFor instance, if ![](images/6f/6f13203f5c0bc85b3af24b0a276e30044825c0133a6e8b42e6500cb20c0e754c.svg) and ![](images/80/809bfd2b9daeb6f8eee30bbe9ddbfe996326dcf1954cd3f9e09e072e95a16aa3.svg) then \n\n$$\n\\begin{aligned}|u\\cdot v| & \\le ‖u‖\\cdot ‖v‖ \\\\ |3\\cdot 5+(-4)\\cdot 12| & \\le \\sqrt{{3}^{2}+(-4)^{2}}\\sqrt{{5}^{2}+{12}^{2}} \\\\ |-33| & \\le 5\\cdot 13 \\\\ 33 & \\le 65.\\,✓\\end{aligned}\n$$\n\n**Note:** An easy trick to remember the Cauchy-Schwarz inequality is to think of the formula for the dot product:\n\n$$\n\\mathbf u \\cdot \\mathbf v = \\Vert \\mathbf u \\Vert \\Vert \\mathbf v \\Vert \\cos \\theta\n$$\n\nBecause $\\vert \\cos \\theta \\vert \\leq 1,$ we can see that\n\n$$\n\\vert \\mathbf{u} \\cdot \\mathbf{v} \\vert \\leq \\Vert \\mathbf{u} \\Vert \\Vert \\mathbf{v} \\Vert.\n$$\n\n**Watch out!** The above trick is only a mnemonic trick, *not* an actual proof of the Cauchy-Schwarz inequality. The formula $\\mathbf u \\cdot \\mathbf v = \\Vert \\mathbf u \\Vert \\Vert \\mathbf v \\Vert \\cos \\theta$ is actually a *consequence* of the Cauchy-Schwarz inequality, so a proof of the Cauchy-Schwarz inequality cannot use the formula." :tutorial/id #uuid "7dd99f48-bbdd-5c22-b5b5-f540eed16b92" :tutorial/math-academy-id 3609 :tutorial/title "Introduction"} :step/id #uuid "37742cc9-b4c6-528d-a58c-980bbc6f6f0f" :step/math-academy-id 20206 :step/next {:db/id #edb/ref 17592186134649}} {:db/id #edb/ref 17592186134649 :step/content {:db/id #edb/ref 17592186133773 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133582 :question/id #uuid "77b63ba5-410b-536c-8ed0-92c895097cc9" :question/math-academy-id "e-5554"} :knowledge-point/id #uuid "7ec34a19-988a-5421-8c05-6bb4c5a9e366" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048849}] :knowledge-point/questions [{:db/id #edb/ref 17592186134218} {:db/id #edb/ref 17592186134263} {:db/id #edb/ref 17592186272088} {:db/id #edb/ref 17592186272089} {:db/id #edb/ref 17592186326765} {:db/id #edb/ref 17592186326886} {:db/id #edb/ref 17592186342150} {:db/id #edb/ref 17592186479826}] :knowledge-point/title "Determining a Minimum Possible Value Using the Cauchy-Schwarz Inequality"} :step/id #uuid "f5ab144b-fcb0-51fc-bdfa-3c957620d966" :step/math-academy-id 20207 :step/next {:db/id #edb/ref 17592186134650}} {:db/id #edb/ref 17592186134650 :step/content {:db/id #edb/ref 17592186135039 :tutorial/content "Now, using the dot product, we can define the angle $\\theta$ between two vectors $\\mathbf{u}$ and $\\mathbf{v}$ in $\\mathbb{R}^n$, where $n \\ge 2$.\n\n![](images/82/8244d121c65d655f42378c68e1a197528fb2db60a3890b3842e3c93692d88071.png)\n\nTo do that, we say that $\\cos\\theta$ will be equal to the ratio of the two sides of the Cauchy-Schwarz inequality, as follows:\n\n$$\n\\cos\\theta\t=\t\\dfrac{\\mathbf{u}\\cdot\\mathbf{v}}{\\Vert \\mathbf{u} \\Vert \\cdot \\Vert \\mathbf{v} \\Vert}\n$$\n\nNotice that this formula is completely analogous to the formula for the angle between two vectors in two-dimensional or three-dimensional space. It only works for non-zero vectors (otherwise, we will be dividing by zero).\n\nSince the Cauchy-Schwarz inequality guarantees that $|\\mathbf{u} \\cdot \\mathbf{v}| \\leq \\| \\mathbf{u} \\| \\cdot \\| \\mathbf{v} \\|$, we get\n\n$$\n-1 \\leq \\dfrac{\\mathbf{u}\\cdot\\mathbf{v}}{\\Vert \\mathbf{u} \\Vert \\cdot \\Vert \\mathbf{v} \\Vert} \\leq 1,\n$$\n\nwhich means that $\\theta$ can be found given any two non-zero $\\mathbf{u}$ and $\\mathbf{v}$." :tutorial/id #uuid "fb193109-edd9-56c5-a643-2472eb776c80" :tutorial/math-academy-id 3610 :tutorial/title "The Angle Between Two Vectors"} :step/id #uuid "26f7bbc7-420d-5194-a4cc-342313c26a2f" :step/math-academy-id 20208 :step/next {:db/id #edb/ref 17592186134651}} {:db/id #edb/ref 17592186134651 :step/content {:db/id #edb/ref 17592186133774 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133583 :question/id #uuid "763f7e8e-081a-57ad-825f-601a38fe3984" :question/math-academy-id "e-5555"} :knowledge-point/id #uuid "6bde92b0-4e98-5c2e-848e-7a5febc848ae" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050336}] :knowledge-point/questions [{:db/id #edb/ref 17592186134294} {:db/id #edb/ref 17592186134295} {:db/id #edb/ref 17592186272090} {:db/id #edb/ref 17592186326849} {:db/id #edb/ref 17592186326850} {:db/id #edb/ref 17592186326851} {:db/id #edb/ref 17592186326852} {:db/id #edb/ref 17592186326853} {:db/id #edb/ref 17592186326887} {:db/id #edb/ref 17592186414662} {:db/id #edb/ref 17592186414663} {:db/id #edb/ref 17592186479875}] :knowledge-point/title "Finding the Acute Angle Between Two Vectors"} :step/id #uuid "16edcc5a-a81b-54dc-93af-a242d90ab883" :step/math-academy-id 20209 :step/next {:db/id #edb/ref 17592186134720}} {:db/id #edb/ref 17592186134652 :step/content {:db/id #edb/ref 17592186135041 :tutorial/content "Now, let's prove the general statement of the Cauchy-Schwarz inequality for vectors $\\mathbf{u}, \\mathbf{v} \\in \\mathbb{R}^n\\mathbin{:}$\n\n$$\n\\vert \\mathbf{u}\\cdot\\mathbf{v} \\vert \\leq \\Vert \\mathbf{u} \\Vert \\Vert \\mathbf{v} \\Vert\n$$\n\nTo start, let $t\\in\\mathbb{R}$ be any number, and consider the vector $t\\mathbf{u}+\\mathbf{v}.$ Since $\\Vert t\\mathbf{u} + \\mathbf{v} \\Vert \\geq 0,$ using the definition and properties of the dot product, we have\n\n$$\n\\begin{aligned}‖tu+v{‖}^{2} & \\ge 0 \\\\ (tu+v)\\cdot (tu+v) & \\ge 0 \\\\ {t}^{2}(u\\cdot u)+t(u\\cdot v)+t(v\\cdot u)+(v\\cdot v) & \\ge 0 \\\\ {t}^{2}‖u{‖}^{2}+2t(u\\cdot v)+‖v{‖}^{2} & \\ge 0.\\end{aligned}\n$$\n\nIn the last line above, we have a quadratic with the coefficients $a=\\Vert \\mathbf{u} \\Vert^2,$ $b=2\\left( \\mathbf{u}\\cdot\\mathbf{v} \\right),$ and $c=\\Vert \\mathbf{v} \\Vert^2.$\n\nSince the quadratic is greater than or equal to zero, its discriminant must be less than or equal to zero, $\\mathcal{D} \\leq 0.$ Therefore, we have\n\n$$\n\\begin{aligned}D & \\le 0 \\\\ {b}^{2}-4ac & \\le 0 \\\\ {(2(u\\cdot v))}^{2}-4\\cdot ‖u{‖}^{2}\\cdot ‖v{‖}^{2} & \\le 0 \\\\ 4{(u\\cdot v)}^{2}-4‖u{‖}^{2}‖v{‖}^{2} & \\le 0 \\\\ {(u\\cdot v)}^{2} & \\le ‖u{‖}^{2}‖v{‖}^{2} \\\\ \\sqrt{{(u\\cdot v)}^{2}} & \\le \\sqrt{‖u{‖}^{2}‖v{‖}^{2}} \\\\ |u\\cdot v| & \\le ‖u‖‖v‖.\\end{aligned}\n$$" :tutorial/id #uuid "60d5d1df-43c6-5f0a-9f65-0bf4f078cff0" :tutorial/math-academy-id 3614 :tutorial/title "Algebraic Proof of the Schwarz Inequality"} :step/id #uuid "1fa328eb-e089-5fa4-8c20-b79162bc8781" :step/math-academy-id 20213} {:db/id #edb/ref 17592186134720 :step/content {:db/id #edb/ref 17592186133816 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133631 :question/id #uuid "0562751a-55be-5fd1-83d2-11795ba7a052" :question/math-academy-id "e-5910"} :knowledge-point/id #uuid "7b56b45b-94dd-5ba1-aae6-6b17cffaf532" :knowledge-point/questions [{:db/id #edb/ref 17592186134328} {:db/id #edb/ref 17592186134331} {:db/id #edb/ref 17592186272094} {:db/id #edb/ref 17592186272095} {:db/id #edb/ref 17592186342151} {:db/id #edb/ref 17592186342154} {:db/id #edb/ref 17592186342157} {:db/id #edb/ref 17592186342163} {:db/id #edb/ref 17592186479879} {:db/id #edb/ref 17592186479886} {:db/id #edb/ref 17592186492825}] :knowledge-point/title "Calculating the Cosine of an Angle"} :step/id #uuid "8bfc4661-356b-5920-8c62-42e9e563ec9c" :step/math-academy-id 21811 :step/next {:db/id #edb/ref 17592186134652}}] :activity/title "The Cauchy-Schwarz Inequality and the Angle Between Two Vectors" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186133988}] [{:activity/course {:db/id #edb/ref 17592186046673} :activity/first-step {:db/id #edb/ref 17592186414665} :activity/id #uuid "1cd8eb7e-fe04-5fdd-83e0-383ffc51e2ba" :activity/scope {:db/id #edb/ref 17592186050693 :topic/id #uuid "5f71e968-b382-5c1b-bc8c-518dc0440228" :topic/math-academy-id 2101} :activity/steps [{:db/id #edb/ref 17592186414664 :step/content {:db/id #edb/ref 17592186414663 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bec6782-5b25-5f66-a69c-bd940a684008" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{84.32}^{∘}" :db/id #edb/ref 17592186414645} {:answer/id #uuid "42d9c80c-b7ce-5329-bd52-05c6944cc99d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{83.24}^{∘}" :db/id #edb/ref 17592186414648} {:answer/id #uuid "6fccab70-38d0-5196-9e05-328ab9515f03" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{85.50}^{∘}" :db/id #edb/ref 17592186414649} {:answer/id #uuid "82db5a26-f843-545e-b28d-8edda8760ffb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{87.27}^{∘}" :db/id #edb/ref 17592186414651} {:answer/id #uuid "89bd71bc-8f74-5cc5-8323-858f0ad1097e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{85.35}^{∘}" :db/id #edb/ref 17592186414652}] :answer-field/correct {:db/id #edb/ref 17592186414649} :answer-field/id #uuid "c9256cbf-1d22-506c-aaed-b510f33eb670" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186414661}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "99b52f99-8be2-5e57-bfd3-38bdea87dcf3" :question/math-academy-id "q-40563" :question/problem "Rounded to two decimal places, what is the acute angle between the vectors $v=\\begin{bmatrix}6 \\\\ \\sqrt{5} \\\\ 1 \\\\ -1\\end{bmatrix}$ and $w=\\begin{bmatrix}1 \\\\ -2 \\\\ 2\\sqrt{5} \\\\ 3\\end{bmatrix}?$" :question/worked-solution "Using the formula\n\n$$\n\\operatorname{cos}⁡\\theta =\\frac{v\\cdot w}{‖v‖\\,‖w‖},\n$$\n\nwe have the following:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{{v}_{1}{w}_{1}+{v}_{2}{w}_{2}+{v}_{3}{w}_{3}+{v}_{4}{w}_{4}}{\\sqrt{{v}_{1}^{2}+{v}_{2}^{2}+{v}_{3}^{2}+{v}_{4}^{2}}\\sqrt{{w}_{1}^{2}+{w}_{2}^{2}+{w}_{3}^{2}+{w}_{4}^{2}}} \\\\  & =\\frac{(6)(1)+(\\sqrt{5})(-2)+(1)(2\\sqrt{5})+(-1)(3)}{\\sqrt{{6}^{2}+(\\sqrt{5})^{2}+{1}^{2}+(-1)^{2}}\\sqrt{{1}^{2}+(-2)^{2}+(2\\sqrt{5})^{2}+{3}^{2}}} \\\\  & =\\frac{3}{\\sqrt{43}\\sqrt{34}} \\\\  & =\\frac{3\\sqrt{1462}}{1462}\\end{aligned}\n$$\n\n \n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{3\\sqrt{1462}}{1462})≈{85.50}^{∘}.\n$$"} :step/id #uuid "31ec05bc-1755-5418-abd2-881dd5798752" :step/next {:db/id #edb/ref 17592186414666}} {:db/id #edb/ref 17592186414665 :step/content {:db/id #edb/ref 17592186414662 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bff7206-3e83-5486-87f5-627306292967" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{5}" :db/id #edb/ref 17592186414646} {:answer/id #uuid "385da54c-4492-5bbc-951a-ed5c5080d241" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186414647} {:answer/id #uuid "c9aa9be2-fd88-5217-83f7-344e4baf419e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186414656} {:answer/id #uuid "d4a61390-9440-51e4-aed8-0f77831ed9d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{8}" :db/id #edb/ref 17592186414657} {:answer/id #uuid "faeabdd2-c5d4-509e-96e7-7dc4d046eb5d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186414658}] :answer-field/correct {:db/id #edb/ref 17592186414647} :answer-field/id #uuid "8e595341-6d0b-5218-827a-e206e85ab469" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186414659}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "44f2ea0b-1adf-505c-8fa7-ec801c70c20d" :question/math-academy-id "q-40560" :question/problem "Find the acute angle between the vectors $v=\\begin{bmatrix}-\\sqrt{2} \\\\ 1 \\\\ -2 \\\\ 3\\end{bmatrix}$ and $w=\\begin{bmatrix}1 \\\\ \\sqrt{2} \\\\ -5 \\\\ 2\\end{bmatrix}.$" :question/worked-solution "Using the formula\n\n$$\n\\operatorname{cos}⁡\\theta =\\frac{v\\cdot w}{‖v‖\\,‖w‖},\n$$\n\nwe have the following: \n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{{v}_{1}{w}_{1}+{v}_{2}{w}_{2}+{v}_{3}{w}_{3}+{v}_{4}{w}_{4}}{\\sqrt{{v}_{1}^{2}+{v}_{2}^{2}+{v}_{3}^{2}+{v}_{4}^{2}}\\sqrt{{w}_{1}^{2}+{w}_{2}^{2}+{w}_{3}^{2}+{w}_{4}^{2}}} \\\\  & =\\frac{(-\\sqrt{2})(1)+(1)(\\sqrt{2})+(-2)(-5)+(3)(2)}{\\sqrt{(-\\sqrt{2})^{2}+{1}^{2}+(-2)^{2}+{3}^{2}}\\sqrt{{1}^{2}+(\\sqrt{2})^{2}+(-5)^{2}+{2}^{2}}} \\\\  & =\\frac{16}{\\sqrt{16}\\sqrt{32}} \\\\  & =\\frac{4}{\\sqrt{32}} \\\\  & =\\frac{1}{\\sqrt{2}} \\\\  & =\\frac{\\sqrt{2}}{2}\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{\\sqrt{2}}{2})=\\frac{\\pi }{4}.\n$$"} :step/id #uuid "a5f85e51-6089-5f7b-af28-71304b8227fc" :step/next {:db/id #edb/ref 17592186414664}} {:db/id #edb/ref 17592186414666 :step/content {:db/id #edb/ref 17592186134331 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "002742f3-7284-5ac0-8779-30b804e92705" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{\\sqrt{131}}" :db/id #edb/ref 17592186414644} {:answer/id #uuid "7d06f1ec-30ff-53f8-9943-6ae3b36ce40d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{\\sqrt{266}}" :db/id #edb/ref 17592186414650} {:answer/id #uuid "bcaffc6f-0a85-5982-a4c7-707c5cbc1a65" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{15}{\\sqrt{131}}" :db/id #edb/ref 17592186414653} {:answer/id #uuid "bd84ff6d-55f1-5a15-aef5-c63480bc1877" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{13}{\\sqrt{266}}" :db/id #edb/ref 17592186414654} {:answer/id #uuid "bf2d35a4-2976-51e9-ab5e-f0e748e55003" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{18}{\\sqrt{266}}" :db/id #edb/ref 17592186414655}] :answer-field/correct {:db/id #edb/ref 17592186414650} :answer-field/id #uuid "c90a5531-3cd5-5504-b1c0-5278d3ea6ed7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186414660}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3dd6a25a-12e9-5ca9-91cb-a545462d6da3" :question/math-academy-id "q-40902" :question/problem "Let $A(-2,1,0,-3)$ and $B(1,-1,1,-4).$ Find the cosine of the angle $∠AOB$, where $O(0,0,0,0)$ is the origin." :question/worked-solution "First, let\n\n$$\n\\begin{aligned}a=\\overset{\\to }{OA}=\\begin{bmatrix}-2 \\\\ 1 \\\\ 0 \\\\ -3\\end{bmatrix},\\,b=\\overset{\\to }{OB}=\\begin{bmatrix}1 \\\\ -1 \\\\ 1 \\\\ -4\\end{bmatrix}.\\end{aligned}\n$$\n\nAlso, let $\\theta =m∠AOB$ be the angle between the vectors $a$ and $b.$ Then, we can find $\\operatorname{cos}⁡\\theta $ using the following formula:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{a\\cdot b}{‖a‖\\,‖b‖} \\\\  & =\\frac{{a}_{1}{b}_{1}+{a}_{2}{b}_{2}+{a}_{3}{b}_{3}+{a}_{4}{b}_{4}}{\\sqrt{{a}_{1}^{2}+{a}_{2}^{2}+{a}_{3}^{2}+{a}_{4}^{2}}\\,\\sqrt{{b}_{1}^{2}+{b}_{2}^{2}+{b}_{3}^{2}+{b}_{4}^{2}}} \\\\  & =\\frac{(-2)\\cdot 1+1\\cdot (-1)+0\\cdot 1+(-3)\\cdot (-4)}{\\sqrt{(-2)^{2}+{1}^{2}+{0}^{2}+(-3)^{2}}\\,\\sqrt{{1}^{2}+(-1)^{2}+{1}^{2}+(-4)^{2}}} \\\\  & =\\frac{9}{\\sqrt{14}\\cdot \\sqrt{19}} \\\\  & =\\frac{9}{\\sqrt{266}}\\end{aligned}\n$$"} :step/id #uuid "fa61a90f-8525-5836-ab74-36eb3593cfd4"}] :activity/title "The Cauchy-Schwarz Inequality and the Angle Between Two Vectors" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186414643}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186492929} :activity/id #uuid "6c970452-ad6d-5655-ae36-5c3a6315fc86" :activity/scope {:db/id #edb/ref 17592186050693 :topic/id #uuid "5f71e968-b382-5c1b-bc8c-518dc0440228" :topic/math-academy-id 2101} :activity/steps [{:db/id #edb/ref 17592186492929 :step/content {:db/id #edb/ref 17592186326850 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05aa2b74-3473-50db-a3d9-fefeb5b23a74" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{87.24}^{∘}" :db/id #edb/ref 17592186324023} {:answer/id #uuid "816f4158-b74f-583e-9a6d-e44c27a2e626" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{85.35}^{∘}" :db/id #edb/ref 17592186325054} {:answer/id #uuid "82d52b5b-2b69-5058-a805-f742853d81d3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{83.24}^{∘}" :db/id #edb/ref 17592186325072} {:answer/id #uuid "a3b306f2-05b0-566f-b4bb-3365478423d7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{87.27}^{∘}" :db/id #edb/ref 17592186325360} {:answer/id #uuid "a719e046-f4eb-571e-9d73-55b635635972" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{84.32}^{∘}" :db/id #edb/ref 17592186325397}] :answer-field/correct {:db/id #edb/ref 17592186325360} :answer-field/id #uuid "114ad25d-2d18-5a8b-98d7-ea7680bff2b8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186326252}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "473a85e8-59ee-5be1-849d-d7a1fd3382ad" :question/math-academy-id "q-40562" :question/problem "Rounded to two decimal places, what is the acute angle between the vectors $v=\\begin{bmatrix}1 \\\\ \\sqrt{8} \\\\ -2 \\\\ -3\\end{bmatrix}$ and $w=\\begin{bmatrix}4 \\\\ 1 \\\\ \\sqrt{2} \\\\ 1\\end{bmatrix}?$" :question/worked-solution "Using the formula\n\n$$\n\\operatorname{cos}⁡\\theta =\\frac{v\\cdot w}{‖v‖\\,‖w‖},\n$$\n\nwe have the following:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{{v}_{1}{w}_{1}+{v}_{2}{w}_{2}+{v}_{3}{w}_{3}+{v}_{4}{w}_{4}}{\\sqrt{{v}_{1}^{2}+{v}_{2}^{2}+{v}_{3}^{2}+{v}_{4}^{2}}\\sqrt{{w}_{1}^{2}+{w}_{2}^{2}+{w}_{3}^{2}+{w}_{4}^{2}}} \\\\  & =\\frac{(1)(4)+(\\sqrt{8})(1)+(-2)(\\sqrt{2})+(-3)(1)}{\\sqrt{{1}^{2}+(\\sqrt{8})^{2}+(-2)^{2}+(-3)^{2}}\\sqrt{(4)^{2}+{1}^{2}+(\\sqrt{2})^{2}+{1}^{2}}} \\\\  & =\\frac{1}{\\sqrt{22}\\sqrt{20}} \\\\  & =\\frac{1}{2\\sqrt{110}} \\\\  & =\\frac{\\sqrt{110}}{220}\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{\\sqrt{110}}{220})≈{87.27}^{∘}.\n$$"} :step/id #uuid "0182ba91-ee4d-5b74-a117-b457a06eff85" :step/next {:db/id #edb/ref 17592186492986}} {:db/id #edb/ref 17592186492956 :step/content {:db/id #edb/ref 17592186492825 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01ff0db7-bee8-5c22-bcf6-717f10c873bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186492227} {:answer/id #uuid "179642be-505d-5e1b-bb2a-b937afe83962" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{5}" :db/id #edb/ref 17592186492262} {:answer/id #uuid "afb5358c-3022-5993-afeb-0b8224de5160" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186492569} {:answer/id #uuid "e12cb031-4be0-5534-ad8a-2cad6c375052" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186492654} {:answer/id #uuid "e2349564-7be1-546c-b905-c0f5302320e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{6}" :db/id #edb/ref 17592186492658}] :answer-field/correct {:db/id #edb/ref 17592186492658} :answer-field/id #uuid "396e31d7-971b-5c45-b7d7-da00f7454c2c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186492728}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0a4aeef2-6579-5805-af59-33b7dcd85283" :question/math-academy-id "q-74111" :question/problem "Let $A(1,0,1,0)$ and $B(-1,4,0,-1).$ Find the cosine of the angle $∠AOB$, where $O(0,0,0,0)$ is the origin." :question/worked-solution "First, let\n\n$$\n\\begin{aligned}a=\\overset{\\to }{OA}=\\begin{bmatrix}1 \\\\ 0 \\\\ 1 \\\\ 0\\end{bmatrix},\\,b=\\overset{\\to }{OB}=\\begin{bmatrix}-1 \\\\ 4 \\\\ 0 \\\\ -1\\end{bmatrix}.\\end{aligned}\n$$\n\nAlso, let $\\theta =m∠AOB$ be the angle between the vectors $a$ and $b.$ Then, we can find $\\operatorname{cos}⁡\\theta $ using the following formula:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{a\\cdot b}{‖a‖\\,‖b‖} \\\\  & =\\frac{{a}_{1}{b}_{1}+{a}_{2}{b}_{2}+{a}_{3}{b}_{3}+{a}_{4}{b}_{4}}{\\sqrt{{a}_{1}^{2}+{a}_{2}^{2}+{a}_{3}^{2}+{a}_{4}^{2}}\\,\\sqrt{{b}_{1}^{2}+{b}_{2}^{2}+{b}_{3}^{2}+{b}_{4}^{2}}} \\\\  & =\\frac{1\\cdot (-1)+0\\cdot 4+1\\cdot 0+0\\cdot (-1)}{\\sqrt{{1}^{2}+{0}^{2}+{1}^{2}+{0}^{2}}\\,\\sqrt{(-1)^{2}+{4}^{2}+{0}^{2}+(-1)^{2}}} \\\\  & =\\frac{-1}{\\sqrt{2}\\cdot \\sqrt{18}} \\\\  & =\\frac{-1}{\\sqrt{36}} \\\\  & =-\\frac{1}{6}\\end{aligned}\n$$"} :step/id #uuid "6e3dfff7-7e49-5a06-9195-b5d03e27fcda" :step/next {:db/id #edb/ref 17592186492963}} {:db/id #edb/ref 17592186492960 :step/content {:db/id #edb/ref 17592186134331 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "002742f3-7284-5ac0-8779-30b804e92705" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{\\sqrt{131}}" :db/id #edb/ref 17592186414644} {:answer/id #uuid "7d06f1ec-30ff-53f8-9943-6ae3b36ce40d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{\\sqrt{266}}" :db/id #edb/ref 17592186414650} {:answer/id #uuid "bcaffc6f-0a85-5982-a4c7-707c5cbc1a65" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{15}{\\sqrt{131}}" :db/id #edb/ref 17592186414653} {:answer/id #uuid "bd84ff6d-55f1-5a15-aef5-c63480bc1877" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{13}{\\sqrt{266}}" :db/id #edb/ref 17592186414654} {:answer/id #uuid "bf2d35a4-2976-51e9-ab5e-f0e748e55003" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{18}{\\sqrt{266}}" :db/id #edb/ref 17592186414655}] :answer-field/correct {:db/id #edb/ref 17592186414650} :answer-field/id #uuid "c90a5531-3cd5-5504-b1c0-5278d3ea6ed7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186414660}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3dd6a25a-12e9-5ca9-91cb-a545462d6da3" :question/math-academy-id "q-40902" :question/problem "Let $A(-2,1,0,-3)$ and $B(1,-1,1,-4).$ Find the cosine of the angle $∠AOB$, where $O(0,0,0,0)$ is the origin." :question/worked-solution "First, let\n\n$$\n\\begin{aligned}a=\\overset{\\to }{OA}=\\begin{bmatrix}-2 \\\\ 1 \\\\ 0 \\\\ -3\\end{bmatrix},\\,b=\\overset{\\to }{OB}=\\begin{bmatrix}1 \\\\ -1 \\\\ 1 \\\\ -4\\end{bmatrix}.\\end{aligned}\n$$\n\nAlso, let $\\theta =m∠AOB$ be the angle between the vectors $a$ and $b.$ Then, we can find $\\operatorname{cos}⁡\\theta $ using the following formula:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{a\\cdot b}{‖a‖\\,‖b‖} \\\\  & =\\frac{{a}_{1}{b}_{1}+{a}_{2}{b}_{2}+{a}_{3}{b}_{3}+{a}_{4}{b}_{4}}{\\sqrt{{a}_{1}^{2}+{a}_{2}^{2}+{a}_{3}^{2}+{a}_{4}^{2}}\\,\\sqrt{{b}_{1}^{2}+{b}_{2}^{2}+{b}_{3}^{2}+{b}_{4}^{2}}} \\\\  & =\\frac{(-2)\\cdot 1+1\\cdot (-1)+0\\cdot 1+(-3)\\cdot (-4)}{\\sqrt{(-2)^{2}+{1}^{2}+{0}^{2}+(-3)^{2}}\\,\\sqrt{{1}^{2}+(-1)^{2}+{1}^{2}+(-4)^{2}}} \\\\  & =\\frac{9}{\\sqrt{14}\\cdot \\sqrt{19}} \\\\  & =\\frac{9}{\\sqrt{266}}\\end{aligned}\n$$"} :step/id #uuid "77d1e56c-51f3-5c1c-94bb-784b6eec9f2c" :step/next {:db/id #edb/ref 17592186492956}} {:db/id #edb/ref 17592186492963 :step/content {:db/id #edb/ref 17592186272090 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13324668-ce20-5ef2-a468-80b0d3559702" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{86.22}^{∘}" :db/id #edb/ref 17592186269438} {:answer/id #uuid "20612eaf-6f72-5c17-b500-3e91c9c59bec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{75.28}^{∘}" :db/id #edb/ref 17592186269540} {:answer/id #uuid "6c956be0-6107-50ca-9fbb-b6a515d4b585" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{83.01}^{∘}" :db/id #edb/ref 17592186270232} {:answer/id #uuid "ddd29c40-21e0-51ac-bccc-b59d130e6b0a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{65.86}^{∘}" :db/id #edb/ref 17592186271217} {:answer/id #uuid "e24ab0a8-78b8-52e7-9bfc-1c0a57398dec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{72.45}^{∘}" :db/id #edb/ref 17592186271258}] :answer-field/correct {:db/id #edb/ref 17592186270232} :answer-field/id #uuid "53995c65-618d-55f5-ae00-77480a6ad442" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186271663}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a7c02465-0f29-5382-84ca-baeafb02cecc" :question/math-academy-id "q-140444" :question/problem "Rounded to two decimal places, what is the acute angle between the vectors $v=\\begin{bmatrix}-1 \\\\ 2 \\\\ 0 \\\\ 5\\end{bmatrix}$ and $w=\\begin{bmatrix}4 \\\\ 4 \\\\ -2 \\\\ 0\\end{bmatrix}?$" :question/worked-solution "Using the formula\n\n$$\n\\operatorname{cos}⁡\\theta =\\frac{v\\cdot w}{‖v‖\\,‖w‖},\n$$\n\nwe have the following:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{{v}_{1}{w}_{1}+{v}_{2}{w}_{2}+{v}_{3}{w}_{3}+{v}_{4}{w}_{4}}{\\sqrt{{v}_{1}^{2}+{v}_{2}^{2}+{v}_{3}^{2}+{v}_{4}^{2}}\\,\\sqrt{{w}_{1}^{2}+{w}_{2}^{2}+{w}_{3}^{2}+{w}_{4}^{2}}} \\\\  & =\\frac{(-1)\\cdot 4+2\\cdot 4+0\\cdot (-2)+5\\cdot 0}{\\sqrt{{1}^{2}+(-2)^{2}+{0}^{2}+{5}^{2}}\\,\\sqrt{{4}^{2}+{4}^{2}+(-2)^{2}+{0}^{2}}} \\\\  & =\\frac{4}{\\sqrt{30}\\cdot \\sqrt{36}} \\\\  & =\\frac{4}{6\\sqrt{30}} \\\\  & =\\frac{2}{3\\sqrt{30}}\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{2}{3\\sqrt{30}})≈{83.01}^{∘}.\n$$"} :step/id #uuid "839d743d-84ad-5c4d-83cf-80fd7c3e23c5"} {:db/id #edb/ref 17592186492986 :step/content {:db/id #edb/ref 17592186134328 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40bf9200-1ded-5747-9100-fdedc6dbc312" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{27}{\\sqrt{87}}" :db/id #edb/ref 17592186324492} {:answer/id #uuid "661ac123-d77e-5c6e-8d2c-7670eee85acd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{17}{\\sqrt{7}}" :db/id #edb/ref 17592186324820} {:answer/id #uuid "a42362a6-32c2-5609-85a5-a68ce5cce8c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{7}" :db/id #edb/ref 17592186325365} {:answer/id #uuid "d8a8d4bc-4399-5de0-8a90-b2bb3fb89a57" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{13}{41}" :db/id #edb/ref 17592186325856} {:answer/id #uuid "fd0988c8-ca2f-56e1-b886-bad29e42c487" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186326200}] :answer-field/correct {:db/id #edb/ref 17592186326200} :answer-field/id #uuid "9d381a9f-7e00-5a40-aefb-bf456bb7a19b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186326503}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f556bfd7-df7c-5f35-9d10-55d46797ea31" :question/math-academy-id "q-40886" :question/problem "Let $A(1,-1,2,0)$, $B(1,0,0,-1)$, and $C(0,1,1,0).$ Find the cosine of the angle $∠BAC.$" :question/worked-solution "Let $v=\\overset{\\to }{AB}$ and $w=\\overset{\\to }{AC}.$ Then we have\n\n$$\n\\begin{aligned}v & =b-a \\\\  & =\\begin{bmatrix}1 \\\\ 0 \\\\ 0 \\\\ -1\\end{bmatrix}-\\begin{bmatrix}1 \\\\ -1 \\\\ 2 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 \\\\ 1 \\\\ -2 \\\\ -1\\end{bmatrix}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}w & =c-a \\\\  & =\\begin{bmatrix}0 \\\\ 1 \\\\ 1 \\\\ 0\\end{bmatrix}-\\begin{bmatrix}1 \\\\ -1 \\\\ 2 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 \\\\ 2 \\\\ -1 \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$\n\nLet $\\theta =m∠BAC$ be the angle between the vectors $v$ and $w.$ Then, we can find $\\operatorname{cos}⁡\\theta $ using the following formula:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{v\\cdot w}{‖v‖\\,‖w‖} \\\\  & =\\frac{{v}_{1}{w}_{1}+{v}_{2}{w}_{2}+{v}_{3}{w}_{3}+{v}_{4}{w}_{4}}{\\sqrt{{v}_{1}^{2}+{v}_{2}^{2}+{v}_{3}^{2}+{v}_{4}^{2}}\\,\\sqrt{{w}_{1}^{2}+{w}_{2}^{2}+{w}_{3}^{2}+{w}_{4}^{2}}} \\\\  & =\\frac{0\\cdot (-1)+1\\cdot 2+(-2)\\cdot (-1)+(-1)\\cdot 0}{\\sqrt{{0}^{2}+{1}^{2}+(-2)^{2}+(-1)^{2}}\\,\\sqrt{(-1)^{2}+{2}^{2}+(-1)^{2}+{0}^{2}}} \\\\  & =\\frac{4}{\\sqrt{6}\\cdot \\sqrt{6}} \\\\  & =\\frac{4}{6} \\\\  & =\\frac{2}{3}\\end{aligned}\n$$"} :step/id #uuid "ae2a2680-6e74-5502-b8e6-68c4a860aea6" :step/next {:db/id #edb/ref 17592186492960}}] :activity/title "The Cauchy-Schwarz Inequality and the Angle Between Two Vectors" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186492209}] [{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186162850} :activity/id #uuid "fbe58342-4666-5afb-a7ae-33c1d4a9914d" :activity/scope {:db/id #edb/ref 17592186050972 :topic/id #uuid "7685a107-6df6-5dd2-9d7d-cacd4a8d7f80" :topic/math-academy-id 3121} :activity/steps [{:db/id #edb/ref 17592186162850 :step/content {:db/id #edb/ref 17592186163225 :tutorial/content "Let $n$ be a positive integer. A  function \n\n$$\nf: \\Bbb R^n \\to \\Bbb R\n$$\n\nis a **linear form**  (or  *linear functional*) if there is a row-vector \n\n![](images/95/952d8832a903cf184286698e449da84d94d61cb46d984a48f33f406a42a8007a.svg)\n\nsuch that for any ![](images/6b/6b756f37311a5e7f4e6cfb160a37b31d54b2ce1e29849044101dc82d49e44d21.svg) we have \n\n$$\n\\begin{aligned}f(x) & =ax \\\\  & =\\begin{bmatrix}{a}_{1} & {a}_{2} & ⋯ & {a}_{n}\\end{bmatrix}\\cdot \\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{bmatrix} \\\\  & ={a}_{1}{x}_{1}+{a}_{2}{x}_{2}+…+{a}_{n}{x}_{n}.\\end{aligned}\n$$\n\nFor example, let $f(\\mathbf{x})$ be the linear form   defined on $\\Bbb R^2$ by $f(\\mathbf{x}) = \\mathbf{a} \\mathbf{x},$ where ![](images/26/26cf6eb0836041b648c29908c8d13ae132e644ea68c772e81e011470283c3427.svg) \n\nSuppose we want to evaluate $f(\\mathbf{x})$ at ![](images/5d/5d6ebda5e8563d23b66cdf15f4a47a1ae712510eeacbe6bcebd031534bcc841a.svg) Then, we simply substitute ![](images/6c/6c79170289a47e3ebb2a7226432938640c63ccea0d032e674d4f03967c12c8ea.svg) and obtain  \n\n$$\n\\begin{aligned}f(x) & =ax \\\\  & =\\begin{bmatrix}3 & -2\\end{bmatrix}\\cdot \\begin{bmatrix}\\,1 \\\\ \\,\\,-1\\end{bmatrix} \\\\  & =3\\cdot 1+(-2)\\cdot (-1) \\\\  & =3+2 \\\\  & =5.\\end{aligned}\n$$" :tutorial/id #uuid "a0cf8344-4180-5121-8429-bf2232ea1c94" :tutorial/math-academy-id 4883 :tutorial/title "Introduction"} :step/id #uuid "10801c67-6977-5b0e-8ebd-4c3a8edd48f7" :step/math-academy-id 30534 :step/next {:db/id #edb/ref 17592186162860}} {:db/id #edb/ref 17592186162860 :step/content {:db/id #edb/ref 17592186161980 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161772 :question/id #uuid "59ea7ebb-5b69-5551-a5b9-c286e2730881" :question/math-academy-id "e-8160"} :knowledge-point/id #uuid "5b58f4ff-b6ed-5df6-b04f-137e285d5460" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048652} {:db/id #edb/ref 17592186048954}] :knowledge-point/questions [{:db/id #edb/ref 17592186162587} {:db/id #edb/ref 17592186162611} {:db/id #edb/ref 17592186272163} {:db/id #edb/ref 17592186272164} {:db/id #edb/ref 17592186357595} {:db/id #edb/ref 17592186357603} {:db/id #edb/ref 17592186357604} {:db/id #edb/ref 17592186423356} {:db/id #edb/ref 17592186423362}] :knowledge-point/title "Evaluating a Linear Form"} :step/id #uuid "a5a71a2d-8697-5b95-99ea-19befec73017" :step/math-academy-id 30561 :step/next {:db/id #edb/ref 17592186162861}} {:db/id #edb/ref 17592186162861 :step/content {:db/id #edb/ref 17592186163234 :tutorial/content "Let $n$ be a positive integer. A  function $B: \\Bbb R^n\\times \\Bbb R^n \\to \\Bbb R$ is said to be a **bilinear form** if there is an $n\\times n$   matrix $A$ such that \n\n$$\nB(\\mathbf{x}, \\mathbf{y}) =  \\mathbf{x}^T \\! A\\mathbf{y}, \\qquad  \\mathbf{x}, \\mathbf{y} \\in \\Bbb R^n.\n$$\n\nSuppose, for example, that ![](images/e3/e3ef7815e373c266abf34e4bbba1dd9b29adf2865721afeb8bf4e3eb44b105dc.svg) To  evaluate the bilinear form $B(\\mathbf{x},\\mathbf{y}) = \\mathbf{x}^T \\! A \\mathbf{y}$ when ![](images/ac/ac7f10624ad2b9d0807018976526311423dc4110a98ba24f4ff7eac6760af616.svg) and ![](images/5a/5a074c9193bbe395506549cb69b1b2e84d1208211efb1008a5192989850606ce.svg) we substitute  these vectors in the above expression as follows \n\n$$\n\\begin{aligned}B(x,y) & ={x}^{T}\\,Ay \\\\  & =\\begin{bmatrix}1 & 2\\end{bmatrix}\\begin{bmatrix}1 & 2 \\\\ 3 & 4\\end{bmatrix}\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}7 & 10\\end{bmatrix}\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix} \\\\  & =3.\\end{aligned}\n$$\n\n \n\nTo write down our bilinear form $B(\\mathbf{x},\\mathbf{y})$ above in terms of vector components \n\n![](images/c4/c47fc6c2d7df7ced599a643531bc19656c7c62915930583089df641e493680e5.svg)\n\nwe proceed as follows:  \n\n$$\n\\begin{aligned}B(x,y) & ={x}^{T}\\,Ay \\\\  & =\\begin{bmatrix}{x}_{1} & {x}_{2}\\end{bmatrix}\\begin{bmatrix}1 & 2 \\\\ 3 & 4\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2}\\end{bmatrix} \\\\  & =\\begin{bmatrix}{x}_{1} & {x}_{2}\\end{bmatrix}\\begin{bmatrix}{y}_{1}+2{y}_{2} \\\\ 3{y}_{1}+4{y}_{2}\\end{bmatrix} \\\\  & ={x}_{1}({y}_{1}+2{y}_{2})+{x}_{2}(3{y}_{1}+4{y}_{2}) \\\\  & ={x}_{1}{y}_{1}+2{x}_{1}{y}_{2}+3{x}_{2}{y}_{1}+4{x}_{2}{y}_{2}\\end{aligned}\n$$" :tutorial/id #uuid "c47b7403-36bf-5bf1-b9ab-46fa073f3659" :tutorial/math-academy-id 4896 :tutorial/title "Bilinear Forms"} :step/id #uuid "4a0b1af7-0002-5905-8ed2-197ac9436ab0" :step/math-academy-id 30562 :step/next {:db/id #edb/ref 17592186162862}} {:db/id #edb/ref 17592186162862 :step/content {:db/id #edb/ref 17592186161981 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161773 :question/id #uuid "30204c69-3362-5cc1-a04a-3bb83559b300" :question/math-academy-id "e-8161"} :knowledge-point/id #uuid "7083d465-9871-59ca-97fa-583e740e961f" :knowledge-point/questions [{:db/id #edb/ref 17592186162588} {:db/id #edb/ref 17592186162589} {:db/id #edb/ref 17592186272165} {:db/id #edb/ref 17592186272166} {:db/id #edb/ref 17592186357600} {:db/id #edb/ref 17592186357605} {:db/id #edb/ref 17592186357606} {:db/id #edb/ref 17592186357607} {:db/id #edb/ref 17592186423358} {:db/id #edb/ref 17592186423361}] :knowledge-point/title "Evaluating a Bilinear Form"} :step/id #uuid "b118bcc0-126e-5a1f-a269-8e6c781977ad" :step/math-academy-id 30563 :step/next {:db/id #edb/ref 17592186162863}} {:db/id #edb/ref 17592186162863 :step/content {:db/id #edb/ref 17592186161982 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161774 :question/id #uuid "34398117-07f4-51d9-a879-30a0f6891e68" :question/math-academy-id "e-8162"} :knowledge-point/id #uuid "55277d69-eedc-5c5c-883a-083746e00947" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050163}] :knowledge-point/questions [{:db/id #edb/ref 17592186162590} {:db/id #edb/ref 17592186162614} {:db/id #edb/ref 17592186272167} {:db/id #edb/ref 17592186357608} {:db/id #edb/ref 17592186357609} {:db/id #edb/ref 17592186357610} {:db/id #edb/ref 17592186357614} {:db/id #edb/ref 17592186357615} {:db/id #edb/ref 17592186423357} {:db/id #edb/ref 17592186423360}] :knowledge-point/title "Writing Down a Bilinear Form Given Its Matrix"} :step/id #uuid "d8e4413d-393f-5d07-acd6-7fa0e9f24c33" :step/math-academy-id 30564 :step/next {:db/id #edb/ref 17592186162864}} {:db/id #edb/ref 17592186162864 :step/content {:db/id #edb/ref 17592186161983 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161775 :question/id #uuid "84e1b597-45d7-51f4-aaa9-8a52c753a510" :question/math-academy-id "e-8163"} :knowledge-point/id #uuid "f60cd05d-e4af-5bf1-8827-cab48da934f1" :knowledge-point/questions [{:db/id #edb/ref 17592186162591} {:db/id #edb/ref 17592186162615} {:db/id #edb/ref 17592186357632} {:db/id #edb/ref 17592186357633} {:db/id #edb/ref 17592186357634} {:db/id #edb/ref 17592186357635} {:db/id #edb/ref 17592186357638} {:db/id #edb/ref 17592186423355} {:db/id #edb/ref 17592186423359}] :knowledge-point/title "Finding the Matrix of a Bilinear Form"} :step/id #uuid "171e7c1e-5d10-5f94-a034-21a27c1aa8d8" :step/math-academy-id 30565 :step/next {:db/id #edb/ref 17592186162865}} {:db/id #edb/ref 17592186162865 :step/content {:db/id #edb/ref 17592186163235 :tutorial/content "Suppose $A$ is an $n\\times n$ matrix. Then, it readily follows that the function $B: \\Bbb R^n\\times \\Bbb R^n \\to \\Bbb R$ defined as \n\n$$\nB(\\mathbf{x}, \\mathbf{y}) =  \\mathbf{x}^T \\! A \\, \\mathbf{y}, \\qquad \\mathbf{x}, \\mathbf{y} \\in \\Bbb R^n,\n$$\n\nis **linear in each argument** separately. That's the reason why we call them *bilinear*.\n\n- For $\\mathbf{y}$ fixed, all $\\mathbf{u}, \\mathbf{v} \\in \\Bbb R^n,$  and any real constant $c$, linearity in the first argument means the following:\n\n$$\n\\begin{aligned}B(u+v,y) & =B(u,y)+B(v,y) \\\\ B(cu,y) & =c\\,B(u,y)\\end{aligned}\n$$\n\n- For $\\mathbf{x}$ fixed, all $\\mathbf{w}, \\mathbf{z} \\in \\Bbb R^n,$ and any real constant $c$, linearity in the second argument means the following:\n\n$$\n\\begin{aligned}B(x,w+z) & =B(x,w)+B(x,z) \\\\ B(x,cw) & =c\\,B(x,w)\\end{aligned}\n$$" :tutorial/id #uuid "587cb24c-48a7-5ba8-9424-4dae3dd192d9" :tutorial/math-academy-id 4898 :tutorial/title "Properties of Bilinear Forms"} :step/id #uuid "d20da724-d87e-59ed-8fed-cc45889fcaea" :step/math-academy-id 30572}] :activity/title "Bilinear Forms" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186162217}]}
