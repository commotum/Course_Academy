#{[{:db/id #edb/ref 17592186162240 :knowledge-point/_questions [{:db/id #edb/ref 17592186161924 :knowledge-point/id #uuid "4c91d137-d318-5d98-9dc4-0b701a767b5e" :knowledge-point/title "Using a Percentage Points Table To Find a Chi-Square Probability"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03085833-8fec-5380-837a-ee4898512de3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.700" :db/id #edb/ref 17592186158643} {:answer/id #uuid "21c1ae62-b78b-570e-a7ed-7a03910197d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.940" :db/id #edb/ref 17592186158644} {:answer/id #uuid "37f04950-67ce-59c2-86d5-40e6039a01e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.156" :db/id #edb/ref 17592186158645} {:answer/id #uuid "3c512bc1-21bf-54d0-85db-aa764672c4f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.735" :db/id #edb/ref 17592186158646} {:answer/id #uuid "5938b8ce-e180-5070-bf28-c97fb44710ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.646" :db/id #edb/ref 17592186158647}] :answer-field/correct {:answer/id #uuid "21c1ae62-b78b-570e-a7ed-7a03910197d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.940" :db/id #edb/ref 17592186158644} :answer-field/id #uuid "7ba93739-4e48-54d2-97ab-e7cb42ddadfe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186158642}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f8e3428f-1cb7-573b-a6df-37a8352dbbcd" :question/math-academy-id "q-108269" :question/problem "The table below gives the values of $x$ that satisfy $P(X\\ge x)=p,$ where $X∼{χ}^{2}(k).$  Given that the random variable $X∼{χ}^{2}(10),$ find the value of $x$ such that $P(X>x)=0.950.$\n\n| $k∖p$ | $0.995$ | $0.990$ | $0.975$ | $0.950$ | $0.900$ |\n| --- | --- | --- | --- | --- | --- |\n| $8$ | $\\,1.344\\,$ | $\\,1.646\\,$ | $\\,2.180\\,$ | $\\,2.733\\,$ | $\\,3.490\\,$ |\n| $9$ | $\\,1.735\\,$ | $\\,2.088\\,$ | $\\,2.700\\,$ | $\\,3.325\\,$ | $\\,4.168\\,$ |\n| $10$ | $\\,2.156\\,$ | $\\,2.558\\,$ | $\\,3.247\\,$ | $\\,3.940\\,$ | $\\,4.865\\,$ |" :question/worked-solution "Since $X∼{χ}^{2}(10),$ we focus on the row of the table that corresponds to $k=10.$\n\n| $k∖p$ | $0.995$ | $0.990$ | $0.975$ | $0.950$ | $0.900$ |\n| --- | --- | --- | --- | --- | --- |\n| $10$ | $\\,2.156\\,$ | $\\,2.558\\,$ | $\\,3.247\\,$ | $\\,3.940\\,$ | $\\,4.865\\,$ |\n\nFrom this row, we see that\n\n$$\nP(X>3.940)=0.950.\n$$\n\nTherefore, our answer is $x=3.940.$"}] [{:db/id #edb/ref 17592186541084 :knowledge-point/_questions [{:db/id #edb/ref 17592186162062 :knowledge-point/id #uuid "52596d3a-a7af-55a0-97a8-8a6158b65638" :knowledge-point/title "Calculating the Variance of a Sum of Scaled Random Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "074012c5-6ca1-5495-8009-0d0c255d3ee8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{15}{4}" :db/id #edb/ref 17592186540534} {:answer/id #uuid "1bc800b9-5ce9-51df-9646-ad28b4b5f5dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186540575} {:answer/id #uuid "81f7e7be-4c3c-5db4-9e89-a897730e6bd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{155}{32}" :db/id #edb/ref 17592186540748} {:answer/id #uuid "afc9329d-23eb-511f-aef5-7c8e3284646b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{41}{4}" :db/id #edb/ref 17592186540823} {:answer/id #uuid "d18a0d10-9bd4-5e8e-9023-0b2590d9b92f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186540882}] :answer-field/correct {:answer/id #uuid "074012c5-6ca1-5495-8009-0d0c255d3ee8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{15}{4}" :db/id #edb/ref 17592186540534} :answer-field/id #uuid "3a192929-90b9-5ade-b716-7719dbfc5bbf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186540967}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "59606949-3c87-521e-a2c2-60c040472354" :question/math-academy-id "q-109956" :question/problem "For two independent random variables $X$ and $Y,$ we have $\\text{Var}[X]=16$ and $\\text{Var}[Y]=6.$ Find $\\text{Var}[\\frac{3}{8}X+\\frac{1}{2}Y].$" :question/worked-solution "Recall that if $X$ and $Y$ are independent variables, and $a$ and $b$ are constants, then \n\n$$\n\\text{Var}[aX+bY]={a}^{2}\\text{Var}[X]+{b}^{2}\\text{Var}[Y].\n$$\n\nSubstituting the given data into the formula above, we obtain \n\n$$\n\\text{Var}[\\frac{3}{8}X+\\frac{1}{2}Y]={(\\frac{3}{8})}^{2}\\cdot 16+{(\\frac{1}{2})}^{2}\\cdot 6=\\frac{15}{4}.\n$$"}] [{:db/id #edb/ref 17592186381048 :knowledge-point/_questions [{:db/id #edb/ref 17592186124557 :knowledge-point/id #uuid "e2d7d4db-e9e1-54a0-aadb-42447771855d" :knowledge-point/title "Finding the Domain Where All Partial Derivatives Exist"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c87158e-2c98-5786-92c3-7401ac9880a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\,:\\,y\\ne 0\\,\\text{and}\\,x\\ge 0\\}" :db/id #edb/ref 17592186540550} {:answer/id #uuid "3f1523c2-f133-58a1-bbf8-fd7a6928b953" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\,:\\,y\\ge 0\\}" :db/id #edb/ref 17592186540633} {:answer/id #uuid "646b7d0d-81dc-553a-84a0-b0fc791fa343" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\,:\\,y>0\\}" :db/id #edb/ref 17592186540698} {:answer/id #uuid "d41c428c-d04e-5f2e-a433-2206f490a862" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\,:\\,y\\ne 0\\}" :db/id #edb/ref 17592186540886} {:answer/id #uuid "f0bf3fe3-986e-545e-b34a-605fe91bb5de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\,:\\,y>0\\,\\text{and}\\,x>0\\}" :db/id #edb/ref 17592186540929}] :answer-field/correct {:answer/id #uuid "d41c428c-d04e-5f2e-a433-2206f490a862" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\,:\\,y\\ne 0\\}" :db/id #edb/ref 17592186540886} :answer-field/id #uuid "d1f6e4dc-6584-5b6a-8780-9caeb5fe7ea6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381049}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cb51f4b0-9af5-582f-b38f-08847728e4c9" :question/math-academy-id "q-132655" :question/problem "Given that $f(x,y)=\\frac{{e}^{-x}}{y}$ and\n\n$$\n\\frac{∂f}{∂x}=-\\frac{{e}^{-x}}{y},\\,\\frac{∂f}{∂y}=-\\frac{{e}^{-x}}{{y}^{2}},\n$$\n\nfind the set of values $(x,y)$ where all partial derivatives of $f$ exist." :question/worked-solution "First, notice that $f(x,y)=\\frac{{e}^{-x}}{y}$ is defined only when $y\\ne 0.$ So, the domain of $f$ is \n\n$$\n{D}_{f}=\\{(x,y)\\,:\\,y\\ne 0\\}.\n$$\n\nAs for the partial derivatives, we have the following.\n\n- The function ${f}_{x}(x,y)=-\\frac{{e}^{-x}}{y}$ is defined only when $y\\ne 0.$ So, the domain of ${f}_{x}$ is \n\n$$\n{D}_{{f}_{x}}=\\{(x,y)\\,:\\,y\\ne 0\\}.\n$$\n\n- Similarly, the domain of ${f}_{y}$ is the same: \n\n$$\n{D}_{{f}_{y}}=\\{(x,y)\\,:\\,y\\ne 0\\}\n$$\n\nFinally, we conclude that the partials of $f$ exist on the set\n\n$$\n\\begin{aligned}{D}_{f}\\cap {D}_{{f}_{x}}\\cap {D}_{{f}_{y}} & =\\{(x,y)\\,:\\,y\\ne 0\\}\\cap \\{(x,y)\\,:\\,y\\ne 0\\}\\cap \\{(x,y)\\,:\\,y\\ne 0\\} \\\\  & =\\{(x,y)\\,:\\,y\\ne 0\\}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272239 :knowledge-point/_questions [{:db/id #edb/ref 17592186124511 :knowledge-point/id #uuid "084a0a83-5ce6-5184-beb7-8ae7b4f1a799" :knowledge-point/title "Identifying True Statements Using the Invertible Matrix Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f87f060-5b8c-5b4a-806f-8cf93ee4d70d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449634} {:answer/id #uuid "4360a160-1403-523e-8e62-4fbb2ec722d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449635}] :answer-field/correct {:answer/id #uuid "4360a160-1403-523e-8e62-4fbb2ec722d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449635} :answer-field/id #uuid "359ebe96-94aa-58ea-b60b-be863ac84a52" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450771} {:answer-field/choices [{:answer/id #uuid "bb552ac2-1033-5cf0-95e3-c64844f7abfd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449636} {:answer/id #uuid "e0cf0040-9b44-519e-ab54-532b2b101a3a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449637}] :answer-field/correct {:answer/id #uuid "e0cf0040-9b44-519e-ab54-532b2b101a3a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449637} :answer-field/id #uuid "65159a93-fba0-5a45-abcc-86fe85e1adb6" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450772} {:answer-field/choices [{:answer/id #uuid "39e5820e-dedb-509b-bef8-5b24f4aea7b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449638} {:answer/id #uuid "319a4d81-4806-58b2-9a6b-94494e8c5b9e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449639}] :answer-field/correct {:answer/id #uuid "39e5820e-dedb-509b-bef8-5b24f4aea7b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449638} :answer-field/id #uuid "d8aa8650-12f8-56c0-ac84-85ed73892db0" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450773}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8dad0d98-37c5-5af9-9c0a-4f0fabec2bcc" :question/math-academy-id "q-141200" :question/problem "Which of the following statements are true, given that $A$ is a $6\\times 6$ matrix and  $det(A)=-1?$\n\nSelect all that apply.\n\n- **I.** $A$ is invertible\n\n- **II.** $\\text{Null}(A)=\\{0\\}$\n\n- **III.** $\\text{nullity}(A)=6$" :question/worked-solution "Since $A$ is a $6\\times 6$ matrix, the invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,\\{\\,\\begin{aligned} & \\text{Col}(A)={R}^{6} \\\\  & \\text{dim(Col}(A))=6=\\text{rank}(A) \\\\  & \\text{Null}(A)=\\{0\\} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$\n\nWith that in mind, let's examine each statement in turn. \n\n- Statement I is true. Indeed,   a matrix $A$ is invertible if and only if $det(A)\\ne 0.$ Since here we have $det(A)=-1\\ne 0,$ our matrix $A$ must be  invertible.\n\n- Statement II is true. Indeed, by the invertible matrix theorem\n$A$ is invertible $\\,⇔\\,\\text{Null}(A)=\\{0\\}.$\n\n- Statement III is false. Since $A$ is invertible,  it must be $\\text{nullity}(A)=0.$\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186157605 :knowledge-point/_questions [{:db/id #edb/ref 17592186157395 :knowledge-point/id #uuid "88bd32d5-4a84-58b3-a3e9-73bf32cb5e4f" :knowledge-point/title "Calculating a Higher Moments of a Random Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8747a16d-fffd-573f-9dab-0fb4c2f5c9a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{18}{5}" :db/id #edb/ref 17592186153875} {:answer/id #uuid "01e98cf9-4df5-5f38-ac4d-8e72b016512a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{23}{5}" :db/id #edb/ref 17592186153876} {:answer/id #uuid "11d527f2-6a0a-584b-bfb4-e5704b235915" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17}{5}" :db/id #edb/ref 17592186153877} {:answer/id #uuid "1362ab14-4e58-5f77-95aa-3657536ccc3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{5}" :db/id #edb/ref 17592186153878} {:answer/id #uuid "2027b0ff-5039-5ce6-a7c2-f72df0b13df3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{5}" :db/id #edb/ref 17592186153879}] :answer-field/correct {:answer/id #uuid "2027b0ff-5039-5ce6-a7c2-f72df0b13df3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{5}" :db/id #edb/ref 17592186153879} :answer-field/id #uuid "4907e8dd-f514-5f68-99d1-3cf4a4530a78" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186153874}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "15a2b420-fbe7-5988-afd4-7c0f27613662" :question/math-academy-id "q-149704" :question/problem "A continuous random variable $X$ has the probability density function \n\n$$\nf(x)=\\frac{3}{4}(2x-{x}^{2}),\\,0\\le x\\le 2.\n$$\n\nCalculate $\\text{E}[{X}^{3}].$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ the $n$th raw moment of $X$ is given by\n\n$$\n\\text{E}[{X}^{n}]={\\int }_{S}{x}^{n}\\cdot f(x)\\,\\text{d}x.\n$$\n\nSo, we compute the third raw moment of $X$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{3}] & ={\\int }_{0}^{2}{x}^{3}\\cdot \\frac{3}{4}(2x-{x}^{2})\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}(\\frac{3}{2}{x}^{4}-\\frac{3}{4}{x}^{5})\\,\\text{d}x \\\\  & ={(\\frac{3}{10}{x}^{5}-\\frac{1}{8}{x}^{6})|}_{0}^{2} \\\\  & =(\\frac{3\\cdot {2}^{5}}{10}-\\frac{{2}^{6}}{8})-0 \\\\  & =\\frac{48}{5}-8 \\\\  & =\\frac{8}{5}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186326849 :knowledge-point/_questions [{:db/id #edb/ref 17592186133774 :knowledge-point/id #uuid "6bde92b0-4e98-5c2e-848e-7a5febc848ae" :knowledge-point/title "Finding the Acute Angle Between Two Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02ba46e1-9fb1-54f5-9f26-4a03d84e709f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{33.87}^{∘}" :db/id #edb/ref 17592186323998} {:answer/id #uuid "2674114e-3fc0-5703-a213-4179de80a6ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{60.67}^{∘}" :db/id #edb/ref 17592186324282} {:answer/id #uuid "5eb90082-fba8-5dc3-ba8e-438ce3fe2cf6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{68.12}^{∘}" :db/id #edb/ref 17592186324760} {:answer/id #uuid "883066a8-775d-587c-8c24-18ffbf7670b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{60.01}^{∘}" :db/id #edb/ref 17592186325130} {:answer/id #uuid "8fc50684-1de5-58d8-b274-f925b67abaef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{15.25}^{∘}" :db/id #edb/ref 17592186325192}] :answer-field/correct {:answer/id #uuid "5eb90082-fba8-5dc3-ba8e-438ce3fe2cf6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{68.12}^{∘}" :db/id #edb/ref 17592186324760} :answer-field/id #uuid "d39f6345-f523-582a-8ed1-bd373584a33a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326605}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6d402119-a262-5f96-8245-1e50922a8694" :question/math-academy-id "q-40561" :question/problem "Rounded to two decimal places, what is the acute angle between the vectors  $v=\\begin{bmatrix}-1 \\\\ 2 \\\\ 3 \\\\ -4\\end{bmatrix}$ and $w=\\begin{bmatrix}-1 \\\\ -1 \\\\ 2 \\\\ 0\\end{bmatrix}?$" :question/worked-solution "Using the formula\n\n$$\n\\operatorname{cos}⁡\\theta =\\frac{v\\cdot w}{‖v‖\\,‖w‖},\n$$\n\nwe have the following:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{{v}_{1}{w}_{1}+{v}_{2}{w}_{2}+{v}_{3}{w}_{3}+{v}_{4}{w}_{4}}{\\sqrt{{v}_{1}^{2}+{v}_{2}^{2}+{v}_{3}^{2}+{v}_{4}^{2}}\\sqrt{{w}_{1}^{2}+{w}_{2}^{2}+{w}_{3}^{2}+{w}_{4}^{2}}} \\\\  & =\\frac{(-1)(-1)+(2)(-1)+(3)(2)+(-4)(0)}{\\sqrt{(-1)^{2}+{2}^{2}+{3}^{2}+(-4)^{2}}\\sqrt{(-1)^{2}+(-1)^{2}+{2}^{2}+{0}^{2}}} \\\\  & =\\frac{5}{\\sqrt{30}\\sqrt{6}} \\\\  & =\\frac{5}{6\\sqrt{5}} \\\\  & =\\frac{\\sqrt{5}}{6}\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{\\sqrt{5}}{6})≈{68.12}^{∘}.\n$$"}] [{:db/id #edb/ref 17592186541101 :knowledge-point/_questions [{:db/id #edb/ref 17592186129188 :knowledge-point/id #uuid "8505beff-75b8-57bf-9312-e0fcf32f44fd" :knowledge-point/title "Using Additivity of Double Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08859865-52fe-5dbb-8f26-32959c6acbd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186540540} {:answer/id #uuid "128be196-9e1b-5546-be5b-900e9b7b4df5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186540560} {:answer/id #uuid "2862b1c1-f759-5410-aa00-ccf9a4520165" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186540599} {:answer/id #uuid "a86dd52e-3027-5c20-8506-094ac20452c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186540809} {:answer/id #uuid "adc94108-5e06-511a-9533-0be105c23e85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186540821}] :answer-field/correct {:answer/id #uuid "08859865-52fe-5dbb-8f26-32959c6acbd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186540540} :answer-field/id #uuid "5f5a94fb-044e-5125-bc1a-367ebc8a739b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186540983}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7534ff45-14c3-5354-a5be-41324d6a8d58" :question/math-academy-id "q-81246" :question/problem "Given that $C$ and $D$ are finite, non-overlapping regions and that\n\n$$\n{∬}_{C}f(x,y)\\text{ }\\text{d}A=-7,\\,{∬}_{D}f(x,y)\\text{ }\\text{d}A=19,\n$$\n\nfind the value of \n\n$$\n{∬}_{C\\cup D}2f(x,y)\\text{ }\\text{d}A.\n$$" :question/worked-solution "Using the linearity and additivity of double integrals, we get the following:\n\n$$\n\\begin{aligned}{∬}_{C\\cup D}2f(x,y)\\text{ }\\text{d}A & =2{∬}_{C\\cup D}f(x,y)\\text{ }\\text{d}A \\\\  & =2({∬}_{C}f(x,y)\\text{ }\\text{d}A+{∬}_{D}f(x,y)\\text{ }\\text{d}A) \\\\  & =2(-7+19) \\\\  & =24\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186162588 :knowledge-point/_questions [{:db/id #edb/ref 17592186161981 :knowledge-point/id #uuid "7083d465-9871-59ca-97fa-583e740e961f" :knowledge-point/title "Evaluating a Bilinear Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8a0e8295-10ec-5da2-a14c-c4165a04a815" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186160821} {:answer/id #uuid "975bde4e-8024-54ec-bd8f-67e552e21400" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186160822} {:answer/id #uuid "c6cbab59-528c-5129-a1bc-95edc9e99556" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186160823} {:answer/id #uuid "226c3bd0-4c16-522c-a0c8-793f1f4bb7b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186160824} {:answer/id #uuid "4f459899-26dd-5346-a323-8e4a145fe9e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186160825}] :answer-field/correct {:answer/id #uuid "4f459899-26dd-5346-a323-8e4a145fe9e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186160825} :answer-field/id #uuid "e912f19e-f3f4-504a-a584-0cb0f7e9f8f6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186160820}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5e47c745-3434-584a-80d1-0037e0ca34ad" :question/math-academy-id "q-93679" :question/problem "Consider the bilinear form $B(x,y),$ given by \n\n$$\nB(x,y)={x}_{1}{y}_{1}-3{x}_{1}{y}_{3}-{x}_{2}{y}_{3}+{x}_{3}{y}_{3}.\n$$\n\n \n\nEvaluate $B(x,y)$ when $x=[\\begin{aligned}1 \\\\ 0 \\\\ -4\\end{aligned}]$ and $y=[\\begin{aligned}2 \\\\ -1 \\\\ 1\\end{aligned}].$" :question/worked-solution "We are given that \n\n$\\,$ $x=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]=[\\begin{aligned}1 \\\\ 0 \\\\ -4\\end{aligned}]\\,$ and $\\,y=[\\begin{aligned}{y}_{1} \\\\ {y}_{2} \\\\ {y}_{3}\\end{aligned}]=[\\begin{aligned}2 \\\\ -1 \\\\ 1\\end{aligned}].$\n\nSubstituting these into the bilinear expression, we obtain\n\n$$\n\\begin{aligned}B(x,y) & ={x}_{1}{y}_{1}-3{x}_{1}{y}_{3}-{x}_{2}{y}_{3}+{x}_{3}{y}_{3} \\\\  & =1\\cdot 2-3\\cdot 1\\cdot 1-0\\cdot 1+(-4)\\cdot 1 \\\\  & =2-3+0-4 \\\\  & =-5.\\end{aligned}\n$$"}]}
