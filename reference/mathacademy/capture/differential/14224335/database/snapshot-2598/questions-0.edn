3.247$ | $3.940$ | $4.865$ |"}] [{:db/id #edb/ref 17592186381048 :knowledge-point/_questions [{:db/id #edb/ref 17592186124557 :knowledge-point/id #uuid "e2d7d4db-e9e1-54a0-aadb-42447771855d" :knowledge-point/title "Finding the Domain Where All Partial Derivatives Exist"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a74a5dd-9cb3-52af-a33a-90eddcd388b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,y\\ne 0\\,\\text{and}\\,x\\ge 0}" :db/id #edb/ref 17592186381050} {:answer/id #uuid "e2a9fb2f-b2d7-5282-8a1c-2526828827d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,y>0\\,\\text{and}\\,x>0}" :db/id #edb/ref 17592186381051} {:answer/id #uuid "63afa7e9-7386-5380-8dcf-61d08c4cf38e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,y\\ge 0}" :db/id #edb/ref 17592186381052} {:answer/id #uuid "7108e9dc-1522-5cd9-b5ae-4cc1ec535ec9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,y\\ne 0}" :db/id #edb/ref 17592186381053} {:answer/id #uuid "5d460286-bdbb-5f72-bc4f-c79bc7f2d387" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,y>0}" :db/id #edb/ref 17592186381054}] :answer-field/correct {:answer/id #uuid "7108e9dc-1522-5cd9-b5ae-4cc1ec535ec9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,y\\ne 0}" :db/id #edb/ref 17592186381053} :answer-field/id #uuid "d1f6e4dc-6584-5b6a-8780-9caeb5fe7ea6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381049}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cb51f4b0-9af5-582f-b38f-08847728e4c9" :question/math-academy-id "q-132655" :question/problem "Given that $f(x,y)=\\frac{{e}^{-x}}{y}$ and\n\n$$\n\\frac{∂f}{∂x}=-\\frac{{e}^{-x}}{y},\\,\\frac{∂f}{∂y}=-\\frac{{e}^{-x}}{{y}^{2}},\n$$\n\nfind the set of values $(x,y)$ where all partial derivatives of $f$ exist." :question/worked-solution "First, notice that $f(x,y)=\\frac{{e}^{-x}}{y}$ is defined only when $y\\ne 0.$ So, the domain of $f$ is \n\n$$\n{D}_{f}={(x,y)\\,:\\,y\\ne 0}.\n$$\n\nAs for the partial derivatives, we have the following.\n\n- The function ${f}_{x}(x,y)=-\\frac{{e}^{-x}}{y}$ is defined only when $y\\ne 0.$ So, the domain of ${f}_{x}$ is \n\n$$\n{D}_{{f}_{x}}={(x,y)\\,:\\,y\\ne 0}.\n$$\n\n- Similarly, the domain of ${f}_{y}$ is the same: \n\n$$\n{D}_{{f}_{y}}={(x,y)\\,:\\,y\\ne 0}\n$$\n\nFinally, we conclude that the partials of $f$ exist on the set\n\n$$\n\\begin{aligned}{D}_{f}\\cap {D}_{{f}_{x}}\\cap {D}_{{f}_{y}} & ={(x,y)\\,:\\,y\\ne 0}\\cap {(x,y)\\,:\\,y\\ne 0}\\cap {(x,y)\\,:\\,y\\ne 0} \\\\  & ={(x,y)\\,:\\,y\\ne 0}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272239 :knowledge-point/_questions [{:db/id #edb/ref 17592186124511 :knowledge-point/id #uuid "084a0a83-5ce6-5184-beb7-8ae7b4f1a799" :knowledge-point/title "Identifying True Statements Using the Invertible Matrix Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f87f060-5b8c-5b4a-806f-8cf93ee4d70d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449634} {:answer/id #uuid "4360a160-1403-523e-8e62-4fbb2ec722d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449635}] :answer-field/correct {:answer/id #uuid "4360a160-1403-523e-8e62-4fbb2ec722d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449635} :answer-field/id #uuid "359ebe96-94aa-58ea-b60b-be863ac84a52" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450771} {:answer-field/choices [{:answer/id #uuid "bb552ac2-1033-5cf0-95e3-c64844f7abfd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449636} {:answer/id #uuid "e0cf0040-9b44-519e-ab54-532b2b101a3a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449637}] :answer-field/correct {:answer/id #uuid "e0cf0040-9b44-519e-ab54-532b2b101a3a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449637} :answer-field/id #uuid "65159a93-fba0-5a45-abcc-86fe85e1adb6" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450772} {:answer-field/choices [{:answer/id #uuid "39e5820e-dedb-509b-bef8-5b24f4aea7b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449638} {:answer/id #uuid "319a4d81-4806-58b2-9a6b-94494e8c5b9e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449639}] :answer-field/correct {:answer/id #uuid "39e5820e-dedb-509b-bef8-5b24f4aea7b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449638} :answer-field/id #uuid "d8aa8650-12f8-56c0-ac84-85ed73892db0" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450773}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8dad0d98-37c5-5af9-9c0a-4f0fabec2bcc" :question/math-academy-id "q-141200" :question/problem "Which of the following statements are true, given that $A$ is a $6\\times 6$ matrix and  $det(A)=-1?$\n\nSelect all that apply.\n\n- **I.** $A$ is invertible\n\n- **II.** $\\text{Null}(A)=\\{0\\}$\n\n- **III.** $\\text{nullity}(A)=6$" :question/worked-solution "Since $A$ is a $6\\times 6$ matrix, the invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,\\{\\,\\begin{aligned} & \\text{Col}(A)={R}^{6} \\\\  & \\text{dim(Col}(A))=6=\\text{rank}(A) \\\\  & \\text{Null}(A)=\\{0\\} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$\n\nWith that in mind, let's examine each statement in turn. \n\n- Statement I is true. Indeed,   a matrix $A$ is invertible if and only if $det(A)\\ne 0.$ Since here we have $det(A)=-1\\ne 0,$ our matrix $A$ must be  invertible.\n\n- Statement II is true. Indeed, by the invertible matrix theorem\n$A$ is invertible $\\,⇔\\,\\text{Null}(A)=\\{0\\}.$\n\n- Statement III is false. Since $A$ is invertible,  it must be $\\text{nullity}(A)=0.$\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186157605 :knowledge-point/_questions [{:db/id #edb/ref 17592186157395 :knowledge-point/id #uuid "88bd32d5-4a84-58b3-a3e9-73bf32cb5e4f" :knowledge-point/title "Calculating a Higher Moments of a Random Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8747a16d-fffd-573f-9dab-0fb4c2f5c9a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{18}{5}" :db/id #edb/ref 17592186153875} {:answer/id #uuid "01e98cf9-4df5-5f38-ac4d-8e72b016512a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{23}{5}" :db/id #edb/ref 17592186153876} {:answer/id #uuid "11d527f2-6a0a-584b-bfb4-e5704b235915" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17}{5}" :db/id #edb/ref 17592186153877} {:answer/id #uuid "1362ab14-4e58-5f77-95aa-3657536ccc3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{5}" :db/id #edb/ref 17592186153878} {:answer/id #uuid "2027b0ff-5039-5ce6-a7c2-f72df0b13df3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{5}" :db/id #edb/ref 17592186153879}] :answer-field/id #uuid "4907e8dd-f514-5f68-99d1-3cf4a4530a78" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186153874}] :question/id #uuid "15a2b420-fbe7-5988-afd4-7c0f27613662" :question/math-academy-id "q-149704" :question/problem "A continuous random variable $X$ has the probability density function\n\n$f(x) = \\frac{3}{4}(2x - x^{2}), 0 \\le x \\le 2$.\n\nCalculate $E[X^{3}]$."}] [{:db/id #edb/ref 17592186326849 :knowledge-point/_questions [{:db/id #edb/ref 17592186133774 :knowledge-point/id #uuid "6bde92b0-4e98-5c2e-848e-7a5febc848ae" :knowledge-point/title "Finding the Acute Angle Between Two Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02ba46e1-9fb1-54f5-9f26-4a03d84e709f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{33.87}^{∘}" :db/id #edb/ref 17592186323998} {:answer/id #uuid "2674114e-3fc0-5703-a213-4179de80a6ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{60.67}^{∘}" :db/id #edb/ref 17592186324282} {:answer/id #uuid "5eb90082-fba8-5dc3-ba8e-438ce3fe2cf6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{68.12}^{∘}" :db/id #edb/ref 17592186324760} {:answer/id #uuid "883066a8-775d-587c-8c24-18ffbf7670b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{60.01}^{∘}" :db/id #edb/ref 17592186325130} {:answer/id #uuid "8fc50684-1de5-58d8-b274-f925b67abaef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{15.25}^{∘}" :db/id #edb/ref 17592186325192}] :answer-field/correct {:answer/id #uuid "5eb90082-fba8-5dc3-ba8e-438ce3fe2cf6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{68.12}^{∘}" :db/id #edb/ref 17592186324760} :answer-field/id #uuid "d39f6345-f523-582a-8ed1-bd373584a33a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326605}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6d402119-a262-5f96-8245-1e50922a8694" :question/math-academy-id "q-40561" :question/problem "Rounded to two decimal places, what is the acute angle between the vectors  $v=\\begin{bmatrix}-1 \\\\ 2 \\\\ 3 \\\\ -4\\end{bmatrix}$ and $w=\\begin{bmatrix}-1 \\\\ -1 \\\\ 2 \\\\ 0\\end{bmatrix}?$" :question/worked-solution "Using the formula\n\n$$\n\\operatorname{cos}⁡\\theta =\\frac{v\\cdot w}{‖v‖\\,‖w‖},\n$$\n\nwe have the following:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{{v}_{1}{w}_{1}+{v}_{2}{w}_{2}+{v}_{3}{w}_{3}+{v}_{4}{w}_{4}}{\\sqrt{{v}_{1}^{2}+{v}_{2}^{2}+{v}_{3}^{2}+{v}_{4}^{2}}\\sqrt{{w}_{1}^{2}+{w}_{2}^{2}+{w}_{3}^{2}+{w}_{4}^{2}}} \\\\  & =\\frac{(-1)(-1)+(2)(-1)+(3)(2)+(-4)(0)}{\\sqrt{(-1)^{2}+{2}^{2}+{3}^{2}+(-4)^{2}}\\sqrt{(-1)^{2}+(-1)^{2}+{2}^{2}+{0}^{2}}} \\\\  & =\\frac{5}{\\sqrt{30}\\sqrt{6}} \\\\  & =\\frac{5}{6\\sqrt{5}} \\\\  & =\\frac{\\sqrt{5}}{6}\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{\\sqrt{5}}{6})≈{68.12}^{∘}.\n$$"}] [{:db/id #edb/ref 17592186162588 :knowledge-point/_questions [{:db/id #edb/ref 17592186161981 :knowledge-point/id #uuid "7083d465-9871-59ca-97fa-583e740e961f" :knowledge-point/title "Evaluating a Bilinear Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8a0e8295-10ec-5da2-a14c-c4165a04a815" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186160821} {:answer/id #uuid "975bde4e-8024-54ec-bd8f-67e552e21400" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186160822} {:answer/id #uuid "c6cbab59-528c-5129-a1bc-95edc9e99556" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186160823} {:answer/id #uuid "226c3bd0-4c16-522c-a0c8-793f1f4bb7b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186160824} {:answer/id #uuid "4f459899-26dd-5346-a323-8e4a145fe9e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186160825}] :answer-field/id #uuid "e912f19e-f3f4-504a-a584-0cb0f7e9f8f6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186160820}] :question/id #uuid "5e47c745-3434-584a-80d1-0037e0ca34ad" :question/math-academy-id "q-93679" :question/problem "Consider the bilinear form $B(x, y)$, given by\n\n$B(x, y) = x_{1}y_{1} - 3x_{1}y_{3} - x_{2}y_{3} + x_{3}y_{3}$.\n\nEvaluate $B(x, y)$ when $x = \\begin{bmatrix}1 \\\\ 0 \\\\ -4\\end{bmatrix}$ and $y = \\begin{bmatrix}2 \\\\ -1 \\\\ 1\\end{bmatrix}$."}]}
