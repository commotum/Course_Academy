      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14224903/observations/step-q134028-f887c748a7e3f7c63a1f.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14224903/observations/step-q134028-f887c748a7e3f7c63a1f.png",
