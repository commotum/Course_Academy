#{[{:db/id #edb/ref 17592186407846 :knowledge-point/_questions [{:db/id #edb/ref 17592186124453 :knowledge-point/id #uuid "d5666035-199d-56aa-a6f4-f65a3f847b42" :knowledge-point/title "Calculating Limits of Multivariable Rational Functions by Factoring"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "194293e4-0f48-56b7-8094-db759002b936" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186407825} {:answer/id #uuid "638f4f88-2af6-5eb2-9ed5-e5ceca460c65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186407831} {:answer/id #uuid "88efc86f-081f-55bf-ae7a-919620a60363" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186407834} {:answer/id #uuid "ab3f8034-9dc3-50c6-bd5e-b2ea032262ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{8}" :db/id #edb/ref 17592186407835} {:answer/id #uuid "ada75cf0-6667-5096-ac74-83cbe5d47353" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186407836}] :answer-field/correct {:answer/id #uuid "88efc86f-081f-55bf-ae7a-919620a60363" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186407834} :answer-field/id #uuid "926f9639-4822-59a3-b1ce-00790077ea5e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186407844}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "113d22b7-0222-5499-8d44-de1af29900a0" :question/math-academy-id "q-129340" :question/problem "Determine ${lim}_{x\\to (2,0)}\\frac{{y}^{3}-xy}{{x}^{3}y}.$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0},$ as follows: \n\n$$\n\\begin{aligned}{lim}_{x\\to (2,0)}\\frac{{y}^{3}-xy}{{x}^{3}y} & =\\frac{{0}^{3}-2(0)}{{2}^{3}(0)} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nHowever, we can simplify the limit by canceling common factors in the numerator and denominator:\n\n$$\n\\begin{aligned}{lim}_{x\\to (2,0)}\\frac{{y}^{3}-xy}{{x}^{3}y} & ={lim}_{x\\to (2,0)}\\frac{y({y}^{2}-x)}{{x}^{3}y} \\\\  & ={lim}_{x\\to (2,0)}\\frac{\\cancel{y}({y}^{2}-x)}{{x}^{3}\\cancel{y}} \\\\  & ={lim}_{x\\to (2,0)}\\frac{{y}^{2}-x}{{x}^{3}}\\end{aligned}\n$$\n\nNow that the limit has been simplified, we can evaluate it using direct substitution:\n\n$$\n\\begin{aligned}{lim}_{x\\to (2,0)}\\frac{{y}^{2}-x}{{x}^{3}} & =\\frac{{0}^{2}-2}{{2}^{3}} \\\\  & =-\\frac{2}{8} \\\\  & =-\\frac{1}{4}\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $-\\frac{1}{4}.$"}] [{:db/id #edb/ref 17592186265716 :knowledge-point/_questions [{:db/id #edb/ref 17592186124558 :knowledge-point/id #uuid "7d53554f-6d77-56f9-8950-d8e31a7f4fdb" :knowledge-point/title "Calculating Limits of Multivariable Functions Using Conjugate Multiplication"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52b2e738-d4ff-5a73-bf88-ee96a546601e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186263713} {:answer/id #uuid "6e5d18cd-26e9-513a-9ac2-d9e28cdc3a96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186263957} {:answer/id #uuid "859fba6d-65df-52f9-8934-78218673bfa0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186264151} {:answer/id #uuid "b3999021-6e0d-58f6-8af2-534ecd301f3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186264540} {:answer/id #uuid "f16bc0b6-a366-5c5f-a505-fcaf77e8d63c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186265120}] :answer-field/correct {:answer/id #uuid "f16bc0b6-a366-5c5f-a505-fcaf77e8d63c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186265120} :answer-field/id #uuid "828835a1-d776-5ae6-8933-2aafe083fed7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265474}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d8bc5519-0c3a-5438-9140-d93c11fd7b22" :question/math-academy-id "q-129342" :question/problem "${lim}_{x\\to (0,0)}\\frac{\\sqrt{x}-\\sqrt{y}+x-y}{\\sqrt{x}-\\sqrt{y}}=$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0},$ as follows: \n\n$$\n\\begin{aligned}{lim}_{x\\to (0,0)}\\frac{\\sqrt{x}-\\sqrt{y}+x-y}{\\sqrt{x}-\\sqrt{y}} & =\\frac{\\sqrt{0}-\\sqrt{0}+0-0}{\\sqrt{0}-\\sqrt{0}} \\\\  & =\\frac{0-0+0-0}{0-0} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nHowever, we can simplify the limit by first multiplying the numerator and denominator by the conjugate of the denominator:\n\n$$\n\\begin{aligned}{lim}_{x\\to (0,0)}\\frac{\\sqrt{x}-\\sqrt{y}+x-y}{\\sqrt{x}-\\sqrt{y}} & ={lim}_{x\\to (0,0)}\\frac{(\\sqrt{x}-\\sqrt{y}+x-y)(\\sqrt{x}+\\sqrt{y})}{(\\sqrt{x}-\\sqrt{y})(\\sqrt{x}+\\sqrt{y})} \\\\  & ={lim}_{x\\to (0,0)}\\frac{(\\sqrt{x}-\\sqrt{y})(\\sqrt{x}+\\sqrt{y})+(x-y)(\\sqrt{x}+\\sqrt{y})}{x-y} \\\\  & ={lim}_{x\\to (0,0)}\\frac{x-y+(x-y)(\\sqrt{x}+\\sqrt{y})}{x-y} \\\\  & ={lim}_{x\\to (0,0)}\\frac{(x-y)(1+\\sqrt{x}+\\sqrt{y})}{x-y} \\\\  & ={lim}_{x\\to (0,0)}\\frac{\\cancel{(x-y)}(1+\\sqrt{x}+\\sqrt{y})}{\\cancel{x-y}} \\\\  & ={lim}_{x\\to (0,0)}(1+\\sqrt{x}+\\sqrt{y})\\end{aligned}\n$$\n\nNow that the limit has been simplified, we can evaluate it:\n\n$$\n\\begin{aligned}{lim}_{x\\to (0,0)}(1+\\sqrt{x}+\\sqrt{y}) & =1+\\sqrt{0}+\\sqrt{0} \\\\  & =1+0+0 \\\\  & =1\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $1.$"}] [{:db/id #edb/ref 17592186344994 :knowledge-point/_questions [{:db/id #edb/ref 17592186124453 :knowledge-point/id #uuid "d5666035-199d-56aa-a6f4-f65a3f847b42" :knowledge-point/title "Calculating Limits of Multivariable Rational Functions by Factoring"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "154cde04-acab-5465-9547-10829d1c2ac6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186342426} {:answer/id #uuid "6bb42284-ebac-5722-a55a-f3d61f6c5806" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186343155} {:answer/id #uuid "92dfc28e-190d-569d-937c-6a93104fd226" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186343523} {:answer/id #uuid "b4342938-2831-524c-937b-68dbdb102e85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186343816} {:answer/id #uuid "dcaa824e-6288-5d0e-ba41-9737c9cd645c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186344174}] :answer-field/correct {:answer/id #uuid "154cde04-acab-5465-9547-10829d1c2ac6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186342426} :answer-field/id #uuid "0e203f08-9966-5d66-bfae-16443836045d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344522}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "267b24cc-56d4-5780-90e2-1ea13cc5ba4e" :question/math-academy-id "q-74918" :question/problem "Find  ${lim}_{x\\to (1,1,2)}\\frac{x{z}^{2}-y{z}^{2}}{yz-xz}.$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0},$ as follows: \n\n$$\n{lim}_{x\\to (1,1,2)}\\frac{x{z}^{2}-y{z}^{2}}{yz-xz}=\\frac{1\\cdot {2}^{2}-1\\cdot {2}^{2}}{1\\cdot 2-1\\cdot 2}=\\frac{0}{0}\n$$\n\nHowever, we can simplify the limit by canceling common factors in the numerator and denominator:\n\n$$\n\\begin{aligned}{lim}_{x\\to (1,1,2)}\\frac{x{z}^{2}-y{z}^{2}}{yz-xz} & ={lim}_{x\\to (1,1,2)}\\frac{(x-y){z}^{2}}{(y-x)z} \\\\  & ={lim}_{x\\to (1,1,2)}-\\frac{(x-y){z}^{2}}{(x-y)z} \\\\  & ={lim}_{x\\to (1,1,2)}(-z)\\end{aligned}\n$$\n\nNow that the limit has been simplified, we can evaluate it using direct substitution:\n\n$$\n\\begin{aligned}{lim}_{x\\to (1,1,2)}(-z) & =-2\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $-2.$"}]}
