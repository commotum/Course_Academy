#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186508127} :activity/id #uuid "ceebe888-3e8e-5cd4-adb8-cd12e96beae4" :activity/scope {:db/id #edb/ref 17592186048449 :topic/id #uuid "a05758d1-f2b4-5a86-b7b0-c2a4bb6dcb85" :topic/math-academy-id 1931} :activity/steps [{:db/id #edb/ref 17592186508124 :step/content {:db/id #edb/ref 17592186508060 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1dc3fc2e-8291-595d-9efe-37b54c54ec70" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186507628} {:answer/id #uuid "21b545b6-d2ce-5675-b1f3-a77567c762a5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186507636} {:answer/id #uuid "7fd6bc83-ee8d-5527-acf0-39f4c02d1429" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186507789} {:answer/id #uuid "8f99aa38-d301-56e1-857e-d573e65c98ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186507801} {:answer/id #uuid "acdc3a68-84af-5610-9099-7c787b10a4a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186507839}] :answer-field/correct {:db/id #edb/ref 17592186507789} :answer-field/id #uuid "44b72334-231e-5d57-bdc0-d2fb9585f9c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186507968}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "462f5046-e4ee-5f94-8bfd-00082400022c" :question/math-academy-id "q-74956" :question/problem "${lim}_{x\\to (0,0)}\\frac{{x}^{2}+{y}^{2}}{\\sqrt{{x}^{2}+{y}^{2}+1}-1}=$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0},$ as follows: \n\n$$\n{lim}_{x\\to (0,0)}\\frac{{x}^{2}+{y}^{2}}{\\sqrt{{x}^{2}+{y}^{2}+1}-1}=\\frac{{0}^{2}+{0}^{2}}{\\sqrt{{0}^{2}+{0}^{2}+1}-1}=\\frac{0}{0}\n$$\n\nHowever, we can simplify the limit by first multiplying the numerator and denominator by the conjugate of the denominator:\n\n$$\n\\begin{aligned}{lim}_{x\\to (0,0)}\\frac{{x}^{2}+{y}^{2}}{\\sqrt{{x}^{2}+{y}^{2}+1}-1} & ={lim}_{x\\to (0,0)}\\frac{({x}^{2}+{y}^{2})(\\sqrt{{x}^{2}+{y}^{2}+1}+1)}{(\\sqrt{{x}^{2}+{y}^{2}+1}-1)(\\sqrt{{x}^{2}+{y}^{2}+1}+1)} \\\\  & ={lim}_{x\\to (0,0)}\\frac{({x}^{2}+{y}^{2})(\\sqrt{{x}^{2}+{y}^{2}+1}+1)}{(\\sqrt{{x}^{2}+{y}^{2}+1})^{2}-{1}^{2}} \\\\  & ={lim}_{x\\to (0,0)}\\frac{({x}^{2}+{y}^{2})(\\sqrt{{x}^{2}+{y}^{2}+1}+1)}{{x}^{2}+{y}^{2}} \\\\  & ={lim}_{x\\to (0,0)}(\\sqrt{{x}^{2}+{y}^{2}+1}+1)\\end{aligned}\n$$\n\n  \n\nNow that the limit has been simplified, we can evaluate it:\n\n$$\n\\begin{aligned}{lim}_{x\\to (0,0)}(\\sqrt{{x}^{2}+{y}^{2}+1}+1) & =\\sqrt{{0}^{2}+{0}^{2}+1}+1 \\\\  & =\\sqrt{1}+1 \\\\  & =2\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $2.$"} :step/id #uuid "3074aaf8-a64d-58be-886f-5f8b626d0bc8" :step/next {:db/id #edb/ref 17592186508140}} {:db/id #edb/ref 17592186508125 :step/content {:db/id #edb/ref 17592186265716 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52b2e738-d4ff-5a73-bf88-ee96a546601e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186263713} {:answer/id #uuid "6e5d18cd-26e9-513a-9ac2-d9e28cdc3a96" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186263957} {:answer/id #uuid "859fba6d-65df-52f9-8934-78218673bfa0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186264151} {:answer/id #uuid "b3999021-6e0d-58f6-8af2-534ecd301f3a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186264540} {:answer/id #uuid "f16bc0b6-a366-5c5f-a505-fcaf77e8d63c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186265120}] :answer-field/correct {:db/id #edb/ref 17592186265120} :answer-field/id #uuid "828835a1-d776-5ae6-8933-2aafe083fed7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265474}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "d8bc5519-0c3a-5438-9140-d93c11fd7b22" :question/math-academy-id "q-129342" :question/problem "${lim}_{x\\to (0,0)}\\frac{\\sqrt{x}-\\sqrt{y}+x-y}{\\sqrt{x}-\\sqrt{y}}=$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0},$ as follows: \n\n$$\n\\begin{aligned}{lim}_{x\\to (0,0)}\\frac{\\sqrt{x}-\\sqrt{y}+x-y}{\\sqrt{x}-\\sqrt{y}} & =\\frac{\\sqrt{0}-\\sqrt{0}+0-0}{\\sqrt{0}-\\sqrt{0}} \\\\  & =\\frac{0-0+0-0}{0-0} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nHowever, we can simplify the limit by first multiplying the numerator and denominator by the conjugate of the denominator:\n\n$$\n\\begin{aligned}{lim}_{x\\to (0,0)}\\frac{\\sqrt{x}-\\sqrt{y}+x-y}{\\sqrt{x}-\\sqrt{y}} & ={lim}_{x\\to (0,0)}\\frac{(\\sqrt{x}-\\sqrt{y}+x-y)(\\sqrt{x}+\\sqrt{y})}{(\\sqrt{x}-\\sqrt{y})(\\sqrt{x}+\\sqrt{y})} \\\\  & ={lim}_{x\\to (0,0)}\\frac{(\\sqrt{x}-\\sqrt{y})(\\sqrt{x}+\\sqrt{y})+(x-y)(\\sqrt{x}+\\sqrt{y})}{x-y} \\\\  & ={lim}_{x\\to (0,0)}\\frac{x-y+(x-y)(\\sqrt{x}+\\sqrt{y})}{x-y} \\\\  & ={lim}_{x\\to (0,0)}\\frac{(x-y)(1+\\sqrt{x}+\\sqrt{y})}{x-y} \\\\  & ={lim}_{x\\to (0,0)}\\frac{\\cancel{(x-y)}(1+\\sqrt{x}+\\sqrt{y})}{\\cancel{x-y}} \\\\  & ={lim}_{x\\to (0,0)}(1+\\sqrt{x}+\\sqrt{y})\\end{aligned}\n$$\n\nNow that the limit has been simplified, we can evaluate it:\n\n$$\n\\begin{aligned}{lim}_{x\\to (0,0)}(1+\\sqrt{x}+\\sqrt{y}) & =1+\\sqrt{0}+\\sqrt{0} \\\\  & =1+0+0 \\\\  & =1\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $1.$"} :step/id #uuid "33d52943-cf7c-5ddf-bb1f-113936cfa6d5" :step/next {:db/id #edb/ref 17592186508167}} {:db/id #edb/ref 17592186508127 :step/content {:db/id #edb/ref 17592186344994 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "154cde04-acab-5465-9547-10829d1c2ac6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186342426} {:answer/id #uuid "6bb42284-ebac-5722-a55a-f3d61f6c5806" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186343155} {:answer/id #uuid "92dfc28e-190d-569d-937c-6a93104fd226" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186343523} {:answer/id #uuid "b4342938-2831-524c-937b-68dbdb102e85" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186343816} {:answer/id #uuid "dcaa824e-6288-5d0e-ba41-9737c9cd645c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186344174}] :answer-field/correct {:db/id #edb/ref 17592186342426} :answer-field/id #uuid "0e203f08-9966-5d66-bfae-16443836045d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186344522}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "267b24cc-56d4-5780-90e2-1ea13cc5ba4e" :question/math-academy-id "q-74918" :question/problem "Find  ${lim}_{x\\to (1,1,2)}\\frac{x{z}^{2}-y{z}^{2}}{yz-xz}.$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0},$ as follows: \n\n$$\n{lim}_{x\\to (1,1,2)}\\frac{x{z}^{2}-y{z}^{2}}{yz-xz}=\\frac{1\\cdot {2}^{2}-1\\cdot {2}^{2}}{1\\cdot 2-1\\cdot 2}=\\frac{0}{0}\n$$\n\nHowever, we can simplify the limit by canceling common factors in the numerator and denominator:\n\n$$\n\\begin{aligned}{lim}_{x\\to (1,1,2)}\\frac{x{z}^{2}-y{z}^{2}}{yz-xz} & ={lim}_{x\\to (1,1,2)}\\frac{(x-y){z}^{2}}{(y-x)z} \\\\  & ={lim}_{x\\to (1,1,2)}-\\frac{(x-y){z}^{2}}{(x-y)z} \\\\  & ={lim}_{x\\to (1,1,2)}(-z)\\end{aligned}\n$$\n\nNow that the limit has been simplified, we can evaluate it using direct substitution:\n\n$$\n\\begin{aligned}{lim}_{x\\to (1,1,2)}(-z) & =-2\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $-2.$"} :step/id #uuid "3c399357-4d7f-55ba-a5f1-d7571818aae3" :step/next {:db/id #edb/ref 17592186508124}} {:db/id #edb/ref 17592186508140 :step/content {:db/id #edb/ref 17592186407846 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "194293e4-0f48-56b7-8094-db759002b936" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186407825} {:answer/id #uuid "638f4f88-2af6-5eb2-9ed5-e5ceca460c65" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186407831} {:answer/id #uuid "88efc86f-081f-55bf-ae7a-919620a60363" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186407834} {:answer/id #uuid "ab3f8034-9dc3-50c6-bd5e-b2ea032262ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{8}" :db/id #edb/ref 17592186407835} {:answer/id #uuid "ada75cf0-6667-5096-ac74-83cbe5d47353" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186407836}] :answer-field/correct {:db/id #edb/ref 17592186407834} :answer-field/id #uuid "926f9639-4822-59a3-b1ce-00790077ea5e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186407844}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "113d22b7-0222-5499-8d44-de1af29900a0" :question/math-academy-id "q-129340" :question/problem "Determine ${lim}_{x\\to (2,0)}\\frac{{y}^{3}-xy}{{x}^{3}y}.$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0},$ as follows: \n\n$$\n\\begin{aligned}{lim}_{x\\to (2,0)}\\frac{{y}^{3}-xy}{{x}^{3}y} & =\\frac{{0}^{3}-2(0)}{{2}^{3}(0)} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nHowever, we can simplify the limit by canceling common factors in the numerator and denominator:\n\n$$\n\\begin{aligned}{lim}_{x\\to (2,0)}\\frac{{y}^{3}-xy}{{x}^{3}y} & ={lim}_{x\\to (2,0)}\\frac{y({y}^{2}-x)}{{x}^{3}y} \\\\  & ={lim}_{x\\to (2,0)}\\frac{\\cancel{y}({y}^{2}-x)}{{x}^{3}\\cancel{y}} \\\\  & ={lim}_{x\\to (2,0)}\\frac{{y}^{2}-x}{{x}^{3}}\\end{aligned}\n$$\n\nNow that the limit has been simplified, we can evaluate it using direct substitution:\n\n$$\n\\begin{aligned}{lim}_{x\\to (2,0)}\\frac{{y}^{2}-x}{{x}^{3}} & =\\frac{{0}^{2}-2}{{2}^{3}} \\\\  & =-\\frac{2}{8} \\\\  & =-\\frac{1}{4}\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $-\\frac{1}{4}.$"} :step/id #uuid "7b2bc548-78f2-5e4e-b985-befdf65ed49c" :step/next {:db/id #edb/ref 17592186508125}} {:db/id #edb/ref 17592186508167 :step/content {:db/id #edb/ref 17592186508069 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15c9e982-2244-5a23-aac9-ea8f242dfd59" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186507626} {:answer/id #uuid "2c45373f-5f36-5270-9c27-ce7558fa56c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186507653} {:answer/id #uuid "59f30dc1-5f5d-5fdc-a739-06dad6b23c63" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186507728} {:answer/id #uuid "5beae258-194a-5396-abb9-d22777307972" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186507731} {:answer/id #uuid "824d43de-2c6c-5256-ab7d-e1e81ca546b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186507793}] :answer-field/correct {:db/id #edb/ref 17592186507731} :answer-field/id #uuid "f962e375-138e-5ba3-a11f-61cf507ac9c8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186508030}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "6b2bedc8-52f9-5d40-afcd-8617235afd0f" :question/math-academy-id "q-129401" :question/problem "Determine ${lim}_{x\\to (1,0)}\\frac{{y}^{2}}{{x}^{2}+{y}^{2}-1}.$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0}:$\n\n$$\n\\begin{aligned}{lim}_{x\\to (1,0)}\\frac{{y}^{2}}{{x}^{2}+{y}^{2}-1} & =\\frac{{0}^{2}}{{1}^{2}+{0}^{2}-1} \\\\  & =\\frac{0}{1-1} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nHowever, the function cannot be simplified by canceling common factors in the numerator and denominator:\n\nLet's attempt to evaluate the limit approaching $(1,0)$ from different paths.\n\n- Taking $x\\to (1,0)$ along the path $y=0,$ we have\n\n$$\n\\begin{aligned}{lim}_{x\\to (1,0)\\,\\,\\,y=0}\\frac{{y}^{2}}{{x}^{2}+{y}^{2}-1} & ={lim}_{x\\to 1}\\frac{{0}^{2}}{{x}^{2}+{0}^{2}-1} \\\\  & ={lim}_{x\\to 1}0 \\\\  & =0.\\end{aligned}\n$$\n\n- Taking $x\\to (1,0)$ along the path $x=1,$ we have\n\n$$\n\\begin{aligned}{lim}_{x\\to (1,0)\\,\\,\\,x=1}\\frac{{y}^{2}}{{x}^{2}+{y}^{2}-1} & ={lim}_{y\\to 0}\\frac{{y}^{2}}{{1}^{2}+{y}^{2}-1} \\\\  & ={lim}_{y\\to 0}\\frac{{y}^{2}}{{y}^{2}} \\\\  & ={lim}_{y\\to 0}1 \\\\  & =1\\end{aligned}\n$$\n\nBecause the limit evaluates to different results on two different paths, we conclude that the limit does not exist:\n\n$$\n{lim}_{x\\to (1,0)}\\frac{{y}^{2}}{{x}^{2}+{y}^{2}-1}=\\text{DNE}\n$$"} :step/id #uuid "ee66d94f-00d8-5e5e-84ff-35a7175f7dff"}] :activity/title "Limits and Continuity of Multivariable Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186507605}]}
