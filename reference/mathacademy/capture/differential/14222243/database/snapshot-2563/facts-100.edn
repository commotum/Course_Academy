3fdd2" #edb/ref 17592186045417] [17592186364652 #edb/ref 1080 "128\\,{\\text{ft}}^{2}" #edb/ref 17592186045417] [17592186364652 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186364652 #edb/ref 1083 #uuid "5fe9f1a7-0904-5a92-b9f4-1e7ca2a2d4bb" #edb/ref 17592186045417] [17592186364653 #edb/ref 1080 "369\\,{\\text{ft}}^{2}" #edb/ref 17592186045417] [17592186364653 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186364653 #edb/ref 1083 #uuid "dc20d337-eb61-592e-aeed-865846e45bfb" #edb/ref 17592186045417] [17592186364654 #edb/ref 1080 "192\\,{\\text{ft}}^{2}" #edb/ref 17592186045417] [17592186364654 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186364654 #edb/ref 1083 #uuid "42cfec62-7180-5eb9-8dbb-e33d7fe7ecf5" #edb/ref 17592186045417] [17592186389360 #edb/ref 1068 #edb/ref 17592186389361 #edb/ref 17592186045417] [17592186389360 #edb/ref 1069 "q-162789" #edb/ref 17592186045417] [17592186389360 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186389360 #edb/ref 1071 "Use the method of Lagrange multipliers to find the minimum value of the function $f(x,y)={x}^{2}+{y}^{2}-2y$ given that ${x}^{2}-{y}^{2}\\le 9.$" #edb/ref 17592186045417] [17592186389360 #edb/ref 1072 #uuid "e0ad6e6a-85b2-5b87-87b2-edb5a819eb6e" #edb/ref 17592186045417] [17592186389360 #edb/ref 1074 "First, we need to find the critical values of the function in the region's interior. We compute the critical points by solving $∇f=0,$ as follows:\n\n$$\n\\begin{aligned}⟨{f}_{x}(x,y),{f}_{y}(x,y)⟩ & =⟨0,0⟩ \\\\ ⟨2x,2y-2⟩ & =⟨0,0⟩\\end{aligned}\n$$\n\nThe above equation has the solution $(x,y)=(0,1).$ This point belongs to our region.\n\nNext, we need to find the minimum value of $f(x,y)$ subject to the constraint $g(x,y)={x}^{2}-{y}^{2}=9.$ Therefore, by the method of Lagrange multipliers, we must solve the following system:\n\n$$\n∇f(x,y)=\\lambda ∇g(x,y),\\,g(x,y)=9\n$$\n\nWe start by solving the first equation:\n\n$$\n\\begin{aligned}∇f(x,y) & =\\lambda ∇g(x,y,) \\\\ ⟨{f}_{x}(x,y),{f}_{y}(x,y)⟩ & =\\lambda ⟨{g}_{x}(x,y),{g}_{y}(x,y)⟩ \\\\ ⟨2x,2y-2⟩ & =\\lambda ⟨2x,-2y⟩\\end{aligned}\n$$\n\nTherefore, we have the following:\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}2x &=2\\lambda x \\\\ 2y-2 &=-2\\lambda y\\end{aligned}\\right.\\,⇒\\,\\left\\{\\begin{aligned}x(\\lambda -1) &=0 \\\\ y(\\lambda +1) &=1\\end{aligned}\\right.\\end{aligned}\n$$\n\nTo solve this system, we break it up into several cases:\n\n- Assuming $x=0$ in the first equation of the system, the constraint condition $g(x,y)=9$ implies\n\n$$\n\\begin{aligned}-{y}^{2} & =9.\\end{aligned}\n$$\n\nSo, this doesn't give any critical point.\n\n- Assuming $\\lambda =1$ in the first equation of the system, the second equation gives $y=\\frac{1}{2},$ and the constraint condition $g(x,y)=9$ implies\n\n$$\n\\begin{aligned}{x}^{2}-\\frac{1}{4} & =9\\,⇒\\,x=\\pm \\frac{\\sqrt{37}}{2},\\end{aligned}\n$$\n\nThis gives the critical points $(\\pm \\frac{\\sqrt{37}}{2},\\frac{1}{2}).$\n\nTherefore, $f$ has possible extreme values at the points\n\n$$\n(0,1),\\,(\\pm \\frac{\\sqrt{37}}{2},\\frac{1}{2}).\n$$\n\nWe evaluate $f$ at each of these points. These are given in the following table:\n\n| $(x,y)$ | $(0,1)$ | $(\\frac{\\pm \\sqrt{37}}{2},\\frac{1}{2})$ |\n| --- | --- | --- |\n| $f(x,y)$ | $-1$ | $\\frac{17}{2}$ |\n\nTherefore, the function reaches a minimum value at $(0,1),$ and its minimum value is $-1.$" #edb/ref 17592186045443] [17592186389361 #edb/ref 1075 #edb/ref 17592186389362 #edb/ref 17592186045417] [17592186389361 #edb/ref 1075 #edb/ref 17592186389363 #edb/ref 17592186045417] [17592186389361 #edb/ref 1075 #edb/ref 17592186389364 #edb/ref 17592186045417] [17592186389361 #edb/ref 1075 #edb/ref 17592186389365 #edb/ref 17592186045417] [17592186389361 #edb/ref 1075 #edb/ref 17592186389366 #edb/ref 17592186045417] [17592186389361 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186389361 #edb/ref 1077 "selec