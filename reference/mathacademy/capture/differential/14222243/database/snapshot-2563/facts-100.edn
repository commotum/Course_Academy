b/ref 17592186045417] [17592186446805 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186446805 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186446805 #edb/ref 1078 #edb/ref 17592186446798 #edb/ref 17592186045417] [17592186446805 #edb/ref 1079 #uuid "6cb2db16-47e5-539e-a0cd-d00a57818d78" #edb/ref 17592186045417] [17592186446808 #edb/ref 1075 #edb/ref 17592186446751 #edb/ref 17592186045417] [17592186446808 #edb/ref 1075 #edb/ref 17592186446754 #edb/ref 17592186045417] [17592186446808 #edb/ref 1075 #edb/ref 17592186446757 #edb/ref 17592186045417] [17592186446808 #edb/ref 1075 #edb/ref 17592186446767 #edb/ref 17592186045417] [17592186446808 #edb/ref 1075 #edb/ref 17592186446796 #edb/ref 17592186045417] [17592186446808 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186446808 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186446808 #edb/ref 1078 #edb/ref 17592186446754 #edb/ref 17592186045417] [17592186446808 #edb/ref 1079 #uuid "d16c3309-85b6-5b20-bebc-f505a6812eb7" #edb/ref 17592186045417] [17592186446809 #edb/ref 1068 #edb/ref 17592186446802 #edb/ref 17592186045417] [17592186446809 #edb/ref 1069 "q-99235" #edb/ref 17592186045417] [17592186446809 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186446809 #edb/ref 1071 "Using the method of Lagrange multipliers, determine the maximum sum of the square roots of three positive numbers given that the sum of their squares is $27.$" #edb/ref 17592186045417] [17592186446809 #edb/ref 1072 #uuid "1eb20554-7ec2-5620-86b4-093c81339236" #edb/ref 17592186045417] [17592186446809 #edb/ref 1074 "Let $x,$ $y,$ and $z$ be three positive numbers. We wish to maximize the function\n\n$$\nf(x,y,z)=\\sqrt{x}+\\sqrt{y}+\\sqrt{z},\n$$\n\nsubject to the constraint \n\n$$\n{x}^{2}+{y}^{2}+{z}^{2}=27.\n$$\n\nNote that we also have the constraints $x>0,y>0,z>0.$\n\nLet $g(x,y,z)={x}^{2}+{y}^{2}+{z}^{2}.$ Therefore, by the method of Lagrange multipliers, we must solve the following system:\n\n$$\n∇f(x,y,z)=\\lambda ∇g(x,y,z),\\,g(x,y,z)=27\n$$\n\nWe start by solving the first equation:\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\lambda ∇g(x,y,z) \\\\ ⟨{f}_{x}(x,y,z),{f}_{y}(x,y,z),{f}_{z}(x,y,z)⟩ & =\\lambda ⟨{g}_{x}(x,y,z),{g}_{y}(x,y,z),{g}_{z}(x,y,z)⟩ \\\\ ⟨\\frac{1}{2\\sqrt{x}},\\frac{1}{2\\sqrt{y}},\\frac{1}{2\\sqrt{z}}⟩ & =\\lambda ⟨2x,2y,2z⟩\\end{aligned}\n$$\n\nTherefore, we have the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}\\frac{1}{2\\sqrt{x}} &=2\\lambda x \\\\ \\frac{1}{2\\sqrt{y}} &=2\\lambda y \\\\ \\frac{1}{2\\sqrt{z}} &=2\\lambda z\\end{aligned}\\right.\n$$\n\nEquivalently, we have\n\n$$\n\\left\\{\\begin{aligned}{x}^{-3/2} &=4\\lambda \\\\ {y}^{-3/2} &=4\\lambda \\\\ {z}^{-3/2} &=4\\lambda\\end{aligned}\\right.\n$$\n\nThis gives $x=y=z.$\n\nNow, using the constraint equation, we get\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}+{z}^{2} & =27 \\\\ {x}^{2}+{x}^{2}+{x}^{2} & =27 \\\\ 3{x}^{2} & =27 \\\\ {x}^{2} & =9 \\\\ x & =3.\\end{aligned}\n$$\n\nTherefore, the maximum value of $f$ is reached at the point $(3,3,3),$ and the maximum value is \n\n$$\nf(3,3,3)=\\sqrt{3}+\\sqrt{3}+\\sqrt{3}=3\\sqrt{3}.\n$$\n\n**Note:** It's easy to show that the obtained point is indeed the maximum (and not the minimum). To do that, we could compare the value of the function at this point with the value of the function at any other (arbitrary) point belonging to the domain. For example, \n\n$$\n\\begin{aligned}f(5,1,1) & =\\sqrt{5}+1+1 \\\\  & =2+\\sqrt{5} \\\\  & <f(3,3,3).\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186446810 #edb/ref 1068 #edb/ref 17592186446805 #edb/ref 17592186045417] [17592186446810 #edb/ref 1069 "q-99203" #edb/ref 17592186045417] [17592186446810 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186446810 #edb/ref 1071 "Using the method of Lagrange multipliers, determine the maximum value of the sum of the sines of angle measures of a triangle." #edb/ref 17592186045417] [17592186446810 #edb/ref 1072 #uuid "302ed073-7778-5ce1-8530-7759debd7de4" #edb/ref 17592186045417] [17592186446810 #edb/ref 1074 "Let $x,$ $y,$ and $z$ be the measures of the angles of the triangle. We wish to maximize the function\n\n$$\nf(x,y,z)=\\operatorname{sin}⁡x+\\operatorname{sin}⁡y+\\operatorname{sin}⁡z,\n$$\n\nsubject to the constraint\n\n$$\nx+y+z=\\pi .\n$$\n\nNote that we also have the constraints $0<x,y,z<\\pi .$\n\nLet $g(x,y,z)=x+y+z.$ Therefore, by the method of Lagrange multipliers, we must solve the following system:\n\n$$\n∇f(x,y,z)=\\lambda ∇g(x,y,z),\\,g(x,y,z)=\\pi \n$$\n\nWe start by solving the first equation:\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\lambda ∇g(x,y,z) \\\\ ⟨{f}_{x}(x,y,z),{f}_{y}(x,y,z),{f}_{z}(x,y,z)⟩ & =\\lambda ⟨{g}_{x}(x,y,z),{g}_{y}(x,y,z),{g}_{z}(x,y,z)⟩ \\\\ ⟨\\operatorname{cos}⁡x,\\operatorname{cos}⁡y,\\operatorname{cos}⁡z⟩ & =\\lambda ⟨1,1,1⟩\\end{aligned}\n$$\n\nTherefore, we have the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}\\operatorname{cos}⁡x &=\\lambda \\\\ \\operatorname{cos}⁡y &=\\lambda \\\\ \\operatorname{cos}⁡z &=\\lambda\\end{aligned}\\right.\n$$\n\nFrom the first and second equations above, we have\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡x & =\\operatorname{cos}⁡y.\\end{aligned}\n$$\n\nSince the cosine function is one-to-one on the interval $(0,\\pi ),$ we can conclude that $x=y.$\n\nSimilarly, from the second and third equations, we get that $z=y=x.$ So, using the constraint equation, we get\n\n$$\n\\begin{aligned}x+y+z & =\\pi  \\\\ x+x+x & =\\pi  \\\\ 3x & =\\pi  \\\\ x & =\\frac{\\pi }{3}.\\end{aligned}\n$$\n\nTherefore, the maximum value of $f$ is reached at the point $(\\frac{\\pi }{3},\\frac{\\pi }{3},\\frac{\\pi }{3}),$ and the maximum value is \n\n$$\n\\begin{aligned}f(\\frac{\\pi }{3},\\frac{\\pi }{3},\\frac{\\pi }{3}) & =\\operatorname{sin}⁡(\\frac{\\pi }{3})+\\operatorname{sin}⁡(\\frac{\\pi }{3})+\\operatorname{sin}⁡(\\frac{\\pi }{3}) \\\\  & =\\frac{\\sqrt{3}}{2}+\\frac{\\sqrt{3}}{2}+\\frac{\\sqrt{3}}{2} \\\\  & =\\frac{3\\sqrt{3}}{2}.\\end{aligned}\n$$\n\n**Note:** It's easy to show that the obtained point is indeed the maximum (and not the minimum). To do that, we could compare the value of the function at this point with the value of the function at any other (arbitrary) point belonging to the domain. For example, \n\n$$\n\\begin{aligned}f(\\frac{\\pi }{2},\\frac{\\pi }{4},\\frac{\\pi }{4}) & =\\operatorname{sin}⁡(\\frac{\\pi }{2})+\\operatorname{sin}⁡(\\frac{\\pi }{4})+\\operatorname{sin}⁡(\\frac{\\pi }{4}) \\\\  & =1+\\frac{\\sqrt{2}}{2}+\\frac{\\sqrt{2}}{2} \\\\  & =1+\\sqrt{2} \\\\  & <f(\\frac{\\pi }{3},\\frac{\\pi }{3},\\frac{\\pi }{3}).\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186446812 #edb/ref 1068 #edb/ref 17592186446808 #edb/ref 17592186045417] [17592186446812 #edb/ref 1069 "q-162796" #edb/ref 17592186045417] [17592186446812 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186446812 #edb/ref 1071 "Using the method of Lagrange multipliers, find the maximum value of the sum of the cosines of three non-negative angles whose sum is $\\frac{\\pi }{2}.$" #edb/ref 17592186045417] [17592186446812 #edb/ref 1072 #uuid "71aa525f-c293-54c2-9046-61ecb78eb1e5" #edb/ref 17592186045417] [17592186446812 #edb/ref 1074 "Let $x,$ $y,$ and $z$ be the measures of the angles. We wish to minimize the function\n\n$$\nf(x,y,z)=\\operatorname{cos}⁡x+\\operatorname{cos}⁡y+\\operatorname{cos}⁡z,\n$$\n\nsubject to the constraint\n\n$$\nx+y+z=\\frac{\\pi }{2}.\n$$\n\nWe also have the constraints $0\\le x,y,z\\le \\frac{\\pi }{2}.$\n\nLet $g(x,y,z)=x+y+z.$ Therefore, by the method of Lagrange multipliers, we must solve the following system:\n\n$$\n∇f(x,y,z)=\\lambda ∇g(x,y,z),\\,g(x,y,z)=\\frac{\\pi }{2}\n$$\n\nWe start by solving the first equation:\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\lambda ∇g(x,y,z) \\\\ ⟨{f}_{x}(x,y,z),{f}_{y}(x,y,z),{f}_{z}(x,y,z)⟩ & =\\lambda ⟨{g}_{x}(x,y,z),{g}_{y}(x,y,z),{g}_{z}(x,y,z)⟩ \\\\ ⟨-\\operatorname{sin}⁡x,-\\operatorname{sin}⁡y,-\\operatorname{sin}⁡z⟩ & =\\lambda ⟨1,1,1⟩\\end{aligned}\n$$\n\nTherefore, we have the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}-\\operatorname{sin}⁡x &=\\lambda \\\\ -\\operatorname{sin}⁡y &=\\lambda \\\\ -\\operatorname{sin}⁡z &=\\lambda\\end{aligned}\\right.\n$$\n\nFrom the first and second equations above, we have\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡x & =\\operatorname{sin}⁡y.\\end{aligned}\n$$\n\nSince the sine function is one-to-one on the interval $[0,\\frac{\\pi }{2}],$ we can conclude that $x=y.$\n\nSimilarly, from the second and third equations, we get that $z=y=x.$ So, using the constraint equation, we get\n\n$$\n\\begin{aligned}x+y+z & =\\frac{\\pi }{2} \\\\ x+x+x & =\\frac{\\pi }{2} \\\\ 3x & =\\frac{\\pi }{2} \\\\ x & =\\frac{\\pi }{6}.\\end{aligned}\n$$\n\nTherefore, the maximum value of $f$ is reached at the point $(\\frac{\\pi }{6},\\frac{\\pi }{6},\\frac{\\pi }{6}),$ and the maximum value is \n\n$$\n\\begin{aligned}f(\\frac{\\pi }{6},\\frac{\\pi }{6},\\frac{\\pi }{6}) & =\\operatorname{cos}⁡(\\frac{\\pi }{6})+\\operatorname{cos}⁡(\\frac{\\pi }{6})+\\operatorname{cos}⁡(\\frac{\\pi }{6}) \\\\  & =\\frac{3\\sqrt{3}}{2}.\\end{aligned}\n$$\n\n**Note:** It's easy to show that the obtained point is indeed the maximum (and not the minimum). To do that, we could compare the value of the function at this point with the value of the function at any other (arbitrary) point belonging to the domain. For example, \n\n$$\n\\begin{aligned}f(\\frac{\\pi }{2},0,0) & =\\operatorname{cos}⁡(\\frac{\\pi }{2})+\\operatorname{cos}⁡(0)+\\operatorname{cos}⁡(0) \\\\  & =2 \\\\  & <f(\\frac{\\pi }{6},\\frac{\\pi }{6},\\frac{\\pi }{6}).\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186446813 #edb/ref 1068 #edb/ref 17592186446803 #edb/ref 17592186045417] [17592186446813 #edb/ref 1069 "q-162778" #edb/ref 17592186045417] [17592186446813 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186446813 #edb/ref 1071 "Use the method of Lagrange multipliers to find the maximum value of the function $f(x,y)={x}^{2}+2y$ given that ${x}^{2}+2{y}^{2}\\le 1.$" #edb/ref 17592186045417] [17592186446813 #edb/ref 1072 #uuid "74a32659-ab2b-5195-9c2f-351117b323e4" #edb/ref 17592186045417] [17592186446813 #edb/ref 1074 "First, we need to find the critical values of the function in the region's interior. We compute the critical points by solving $∇f=0,$ as follows:\n\n$$\n\\begin{aligned}⟨{f}_{x}(x,y),{f}_{y}(x,y)⟩ & =⟨0,0⟩ \\\\ ⟨2x,2⟩ & =⟨0,0⟩\\end{aligned}\n$$\n\nSince the above equation has no solutions, we conclude that the function does not have critical values in the region's interior.\n\nNext, we need to find the maximum value of $f(x,y)$ subject to the constraint $g(x,y)={x}^{2}+2{y}^{2}=1.$ \n\nSince $f(x,y)$ is continuous and the constraint is closed and bounded, $f(x,y)$ reaches a global maximum and a global minimum on the constraint. \n\nTherefore, by the method of Lagrange multipliers, we must solve the following system:\n\n$$\n∇f(x,y)=\\lambda ∇g(x,y),\\,g(x,y)=1\n$$\n\nWe start by solving the first equation:\n\n$$\n\\begin{aligned}∇f(x,y) & =\\lambda ∇g(x,y) \\\\ ⟨{f}_{x}(x,y),{f}_{y}(x,y)⟩ & =\\lambda ⟨{g}_{x}(x,y),{g}_{y}(x,y)⟩ \\\\ ⟨2x,2⟩ & =\\lambda ⟨2x,4y⟩\\end{aligned}\n$$\n\nTherefore, we have the following:\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}2x &=2\\lambda x \\\\ 2 &=4\\lambda y\\end{aligned}\\right.\\,⇒\\,\\left\\{\\begin{aligned}x(1-\\lambda ) &=0 \\\\ \\lambda y &=\\frac{1}{2}\\end{aligned}\\right.\\end{aligned}\n$$\n\nTo solve this system, we break it up into several cases:\n\n- Assuming $x=0$ in the first equation of the system, the constraint condition $g(x,y)=1$ implies\n\n$$\n\\begin{aligned}{0}^{2}+2{y}^{2}=1\\,⇒\\,y=\\pm \\frac{1}{\\sqrt{2}}.\\end{aligned}\n$$\n\nThis gives the critical points $(0,\\pm \\frac{1}{\\sqrt{2}}).$\n\n- Assuming $\\lambda =1$ in the first equation of the system, the second equation of the system gives \n\n$$\ny=\\frac{1}{2}.\n$$\n\n \nThen, the constraint condition $g(x,y)=1$ implies\n\n$$\n\\begin{aligned}{x}^{2}+2{(\\frac{1}{2})}^{2}=1\\,⇒\\,x=\\pm \\frac{1}{\\sqrt{2}}.\\end{aligned}\n$$\n\nThis gives the critical points $(\\pm \\frac{1}{\\sqrt{2}},\\frac{1}{2}).$\n\nTherefore, $f$ has possible extreme values at the points\n\n$$\n(0,\\pm \\frac{1}{\\sqrt{2}}),\\,(\\pm \\frac{1}{\\sqrt{2}},\\frac{1}{2}).\n$$\n\n \n\nWe evaluate $f$ at each of these points. These are given in the following table:\n\n| $(x,y)$ | $(0,\\frac{1}{\\sqrt{2}})$ | $(0,-\\frac{1}{\\sqrt{2}})$ | $(\\pm \\frac{1}{\\sqrt{2}},\\frac{1}{2})$ |\n| --- | --- | --- | --- |\n| $f(x,y)$ | $\\sqrt{2}$ | $-\\sqrt{2}$ | $\\frac{3}{2}$ |\n\nTherefore, the function reaches a maximum value at $(\\pm \\frac{1}{\\sqrt{2}},\\frac{1}{2}),$ and its maximum value is $\\frac{3}{2}.$" #edb/ref 17592186045443] [17592186495498 #edb/ref 1043 #edb/ref 17592186496336 #edb/ref 17592186045417] [17592186495498 #edb/ref 1043 #edb/ref 17592186496344 #edb/ref 17592186045417] [17592186495498 #edb/ref 1043 #edb/ref 17592186496354 #edb/ref 17592186045417] [17592186495498 #edb/ref 1043 #edb/ref 17592186496355 #edb/ref 17592186045417] [17592186495498 #edb/ref 1043 #edb/ref 17592186496379 #edb/ref 17592186045417] [17592186495498 #edb/ref 1044 #edb/ref 17592186045464 #edb/ref 17592186045417] [17592186495498 #edb/ref 1045 "Optimizing Multivariable Functions Using Lagrange Multipliers" #edb/ref 17592186045417] [17592186495498 #edb/ref 1046 #edb/ref 17592186496354 #edb/ref 17592186045417] [17592186495498 #edb/ref 1048 #edb/ref 17592186046660 #edb/ref 17592186045417] [17592186495498 #edb/ref 1049 #edb/ref 17592186050688 #edb/ref 17592186045417] [17592186495498 #edb/ref 1053 #uuid "5b35fc89-ed07-5713-aff2-bd03957018fe" #edb/ref 17592186045417] [17592186495594 #edb/ref 1080 "50" #edb/ref 17592186045417] [17592186495594 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186495594 #edb/ref 1083 #uuid "2581670b-66e