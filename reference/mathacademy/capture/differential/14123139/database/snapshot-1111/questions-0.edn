#{[{:db/id #edb/ref 17592186054435 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054634 :knowledge-point/id #uuid "a6128eca-7f76-5386-9d67-d81db2943eeb" :knowledge-point/title "Computing a Cartesian Product"}] :question/id #uuid "4f2ec8a1-0ab4-55ea-9472-2dd7b9fa5f8e" :question/math-academy-id "e-13151" :question/problem "For the sets $A = \\{3,4,7\\},$ $B = \\{f,g\\},$ and $C = A \\times B,$ determine which of the following statements are true.\n\n- $(f,4) \\in C$\n\n- $(7,g) \\in C$\n\n- $(3,f) \\in C$" :question/worked-solution "The Cartesian product $A \\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\nIn this case, the schematic for $A \\times B$ is shown below.\n\n![](images/68/683bad9c822cea7218b2fd8a252e46215103c95b3ee9c42e41e7141ed8a40330.png)\n\nHence, the set $C = A \\times B$ is given by\n\n$$\nC = \\big\\{ \\bbox[2pt, Gainsboro]{\\color{blue}(3,f)}, (3, g), (4, f), (4, g), (7, f), \\bbox[2pt, Gainsboro]{\\color{blue}(7,g)}\\big\\}.\n$$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186054436 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054636 :knowledge-point/id #uuid "3fca5176-1359-5ad8-b012-592ffa9b20b5" :knowledge-point/title "Cartesian Products With Three Sets"}] :question/id #uuid "0a101406-0053-5507-8989-3c1cd6e8d4e7" :question/math-academy-id "e-13152" :question/problem "If $A = \\{ p,q \\}$ and $B = \\{ 4,9 \\},$ which of the following elements belong to $(A \\times B) \\times B?$\n\n- $((p,4),9)$\n\n- $((q,9),4)$\n\n- $(p,4,9)$" :question/worked-solution "The Cartesian product $A \\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\nIn this case, $A \\times B$ consists of every combination of $\\{ p,q \\}$ with $\\{ 4,9 \\},$ as shown in the schematic below.\n\n![](images/69/69ff8391a11b7bfa221b6b303f31551288bd969bdeed778fb05d3b7094e027ae.png)\n\nHence, the set $A \\times B$ is given by\n\n$$\nA \\times B = \\{ (p,4), (p,9), (q,4), (q,9)\\}.\n$$\n\nNote that \n\n$$\n|A \\times B| = |A| \\cdot |B| = 2 \\cdot 2 = 4.\n$$\n\nNow, the Cartesian product\n\n$$\n(A \\times B) \\times B\n$$\n\nconsists of every combination of $A \\times B$ and $B,$ as shown in the schematic below.\n\n![](images/5f/5f4a74a98f9df15273d59131eadc1155ff2d1105e1027e7d10b7e2366102e046.png)\n\nNote that \n\n$$\n|(A \\times B) \\times B| = |A \\times B| \\cdot |B| = 4 \\cdot 2 = 8.\n$$\n\nFrom the given options, we see that both $\\bbox[2pt,Gainsboro]{\\color{blue}((p, 4), 9)}$ and $\\bbox[2pt,Gainsboro]{\\color{blue}((q,9),4)}$ are in $(A \\times B) \\times B.$\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186054437 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054635 :knowledge-point/id #uuid "88fb08f1-03f1-5b04-8b48-4b153e522040" :knowledge-point/title "Computing the Cardinality of a Cartesian Product"}] :question/id #uuid "677fc67f-94df-57a7-a804-22337acda702" :question/math-academy-id "e-13154" :question/problem "If $C = \\{ 3, 4, 7, 9, 11 \\}$ and $D  =\\{ 1, 2, 3, \\ldots, 10 \\},$ what is the cardinality of $C \\times D?$" :question/worked-solution "For any two finite sets $C$ and $D,$ the cardinality of $C \\times D$ is\n\n$$\n| C \\times D | = |C| \\cdot |D|.\n$$\n\nIn this case, we have\n\n$$\n\\begin{aligned}|C\\times D| & =|C|\\cdot |D| \\\\  & =5\\cdot 10 \\\\  & =50.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054438 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054633 :knowledge-point/id #uuid "b304527c-5cdc-57df-b118-e555f6f8fa5c" :knowledge-point/title "Creating a Schematic for a Cartesian Product"}] :question/id #uuid "2bc77b3d-fca6-5f66-ac12-e9fedcce15bd" :question/math-academy-id "e-13160" :question/problem "Construct a schematic of the set $A^2$ for $A = \\{0,3 \\}.$" :question/worked-solution "The set $A^2$ is equivalent to the Cartesian product $A^2 = A \\times A.$\n\nThe Cartesian product $A \\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\nTo create a schematic of the Cartesian product $A\\times A$, we create a table and list the elements of the first set $A$ in a row across the top and the elements of the second set $A$ in a column down the left side.\n\n![](images/46/4646235c2009dc45d7d09a52162ec0bdf929d122f450791ae9917b3ad8ef5a43.png)\n\nThen, at each intersection, we write an ordered pair whose first coordinate is the corresponding element of the first set and the second coordinate is the corresponding element of the second set.\n\nOur completed $A \\times A$ schematic is shown below.\n\n![](images/8c/8c9647361885913d2534fefb49a878c2e365cf5be36d1bb4c059d95344dd1a60.png)"}] [{:db/id #edb/ref 17592186241133 :knowledge-point/_questions [{:db/id #edb/ref 17592186054635 :knowledge-point/id #uuid "88fb08f1-03f1-5b04-8b48-4b153e522040" :knowledge-point/title "Computing the Cardinality of a Cartesian Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7601daf4-505f-5b85-9900-c2e781d60fec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186239075} {:answer/id #uuid "80eb5cca-19dd-5665-9172-0751a2db7c9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186239175} {:answer/id #uuid "88e695b7-f066-54e4-9e88-4d0fcd13600e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186239245} {:answer/id #uuid "8a0cc95a-b5f2-5b65-9267-300669970c56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "200" :db/id #edb/ref 17592186239258} {:answer/id #uuid "f0516ae6-281c-5d32-9a76-04b69c31a6d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "100" :db/id #edb/ref 17592186240174}] :answer-field/correct {:answer/id #uuid "f0516ae6-281c-5d32-9a76-04b69c31a6d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "100" :db/id #edb/ref 17592186240174} :answer-field/id #uuid "20d4b560-bfe8-5917-89cd-14118038f008" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240385}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cd02b5f4-878c-58ad-bee8-a569eb23cb62" :question/math-academy-id "q-105862" :question/problem "What is the cardinality of $M\\times M$ for $M={1,2,3…,10}?$" :question/worked-solution "For any two finite sets $A$ and $B,$ the cardinality of $A\\times B$ is\n\n$$\n|A\\times B|=|A|\\cdot |B|.\n$$\n\nIn this case, we have\n\n$$\n\\begin{aligned}|M\\times M| & =|M|\\cdot |M| \\\\  & =10\\cdot 10 \\\\  & =100.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054995 :knowledge-point/_questions [{:db/id #edb/ref 17592186054634 :knowledge-point/id #uuid "a6128eca-7f76-5386-9d67-d81db2943eeb" :knowledge-point/title "Computing a Cartesian Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ae566481-20f8-5e52-99d8-23a6c82691b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186051501} {:answer/id #uuid "cdadc5ef-7415-5dcf-b7cf-505d2e49c925" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186051502} {:answer/id #uuid "d138c6e0-6807-55b7-ab39-2b7416f93002" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186051503} {:answer/id #uuid "4129157c-b81d-59dd-8ec5-f67444db60ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186051504} {:answer/id #uuid "574a525d-c730-52ff-a8ed-06f70442fbc9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186051505}] :answer-field/id #uuid "5dd58087-ae96-5ce0-a2c8-bc32e79b782d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186051500}] :question/id #uuid "1ff208f5-5023-5db1-8017-ca1f7ce1c080" :question/math-academy-id "q-1262" :question/problem "For the sets $Z = {-1, 0, 1}$ and $Y = Z \\cdot Z$, determine which of the following statements are true.\n\n1. $(-1, 0, 1) ∈ Y$\n2. $(-1, 1) ∈ Y$\n3. $(0, 0) ∈ Y$"}] [{:db/id #edb/ref 17592186054996 :knowledge-point/_questions [{:db/id #edb/ref 17592186054635 :knowledge-point/id #uuid "88fb08f1-03f1-5b04-8b48-4b153e522040" :knowledge-point/title "Computing the Cardinality of a Cartesian Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f642563-a576-5ff0-825c-04004184883b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186260302} {:answer/id #uuid "3973907e-2eeb-500a-a040-2c1ffe0643af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186260388} {:answer/id #uuid "3ad08095-a245-5d4a-9284-33ed128ca8b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186260401} {:answer/id #uuid "41d00f27-29cb-5f3b-8b9b-d7c322522ca0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186260452} {:answer/id #uuid "f206e6bb-a67e-5e54-9f36-d8e4c78303e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186261992}] :answer-field/correct {:answer/id #uuid "3ad08095-a245-5d4a-9284-33ed128ca8b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186260401} :answer-field/id #uuid "e76d9e56-5db6-5ef8-abc1-1b8e4e6928c1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262531}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0afacde2-053a-5abf-a5c4-ded995eb51ce" :question/math-academy-id "q-1264" :question/problem "What is the cardinality of $Z\\times Y$ for $Z={1,4,9,16,25,36}$ and $Y={2,3,7,9}?$" :question/worked-solution "For any two finite sets $Z$ and $Y,$ the cardinality of $Z\\times Y$ is\n\n$$\n|Z\\times Y|=|Z|\\cdot |Y|.\n$$\n\nIn this case, we have\n\n$$\n\\begin{aligned}|Z\\times Y| & =|Z|\\cdot |Y| \\\\  & =6\\cdot 4 \\\\  & =24.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186055069 :knowledge-point/_questions [{:db/id #edb/ref 17592186054633 :knowledge-point/id #uuid "b304527c-5cdc-57df-b118-e555f6f8fa5c" :knowledge-point/title "Creating a Schematic for a Cartesian Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c608b12-afcb-5c86-8fa3-ac46cd259c38" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/35/35f98a667c38a148be71b43a22bf942b190ba2ba250f12a05330a04670d49533.png" :db/id #edb/ref 17592186286071} {:answer/id #uuid "917e16be-b6fb-55bf-b6e6-9f925a276695" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/2d/2d7c9c1ab1ff64c53fa4776d988c1023a5b15b3bb09130c4d2d7eade3cf29161.png" :db/id #edb/ref 17592186286111} {:answer/id #uuid "cc40a2ae-70f8-5e95-9b0c-9cc3f9dac56e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/7d/7d2c13c82c3155852a28b02a625f42fd4dfe760664229e74451441af961c9aa6.png" :db/id #edb/ref 17592186286648} {:answer/id #uuid "d9d8c7f8-ae2a-5538-ac5c-36ff32a86a37" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/54/54b9ed6a556e996304d4ee9eb0a6224dee7e3ba55486e9fd7bc4b092f0608c96.png" :db/id #edb/ref 17592186286775} {:answer/id #uuid "ea290e2c-eaee-5749-ad4a-8e4a1d595e54" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/48/484e5e99dd992b80b62c46d59b030da892a391f6ca270c5e0a2751cc6aa3586f.png" :db/id #edb/ref 17592186286931}] :answer-field/correct {:answer/id #uuid "d9d8c7f8-ae2a-5538-ac5c-36ff32a86a37" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/54/54b9ed6a556e996304d4ee9eb0a6224dee7e3ba55486e9fd7bc4b092f0608c96.png" :db/id #edb/ref 17592186286775} :answer-field/id #uuid "47284f5a-3f96-5df7-ade6-b6ed89a2169a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287300}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cbe58d72-4b57-5123-9a28-e962d7450c5f" :question/math-academy-id "q-181287" :question/problem "Which of the following is a schematic of the Cartesian product $A\\times B$ for $A={1,10,100}$ and $B={a,b}?$" :question/worked-solution "The Cartesian product $A\\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\nTo create a schematic of the Cartesian product, we create a table and list the elements of the first set $A$ in a row across the top and the elements of the second set $B$ in a column down the left side.\n\n![](images/aa/aac2b461bef7d5e1a7ae6e4c7b8b50ebeff86f14b45fc3f929a56ebc870e63c3.png)\n\nThen, at each intersection, we write an ordered pair whose first coordinate is the corresponding element of $A$ and the second coordinate is the corresponding element of $B.$\n\nOur completed $A\\times B$ schematic is shown below.\n\n![](images/dd/dd425d5211861a8c1b7944bd787bba5272a4640a61eb39ff63a477741c16fc93.png)"}] [{:db/id #edb/ref 17592186287680 :knowledge-point/_questions [{:db/id #edb/ref 17592186054633 :knowledge-point/id #uuid "b304527c-5cdc-57df-b118-e555f6f8fa5c" :knowledge-point/title "Creating a Schematic for a Cartesian Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02dd5a7a-24e2-5613-8bbd-d67151ed201b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d8/d87ecffd066aa992ba67d4534d72a3c707c3d790e1e8207a20c62a945b96e9c3.png" :db/id #edb/ref 17592186284813} {:answer/id #uuid "02f1e9ac-33fc-522f-b718-f792ed296580" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a0/a00ad979e2f64fd8ae76e7445012bb6fe52b85cb875175356bf000f5fad8a7e5.png" :db/id #edb/ref 17592186284814} {:answer/id #uuid "6ed78a9e-064a-58ca-ba98-4836e1e1adb1" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/2d/2d13f685183fd26ab1ca7220960b1fe354010cf032365236db755c43c0f035ad.png" :db/id #edb/ref 17592186285814} {:answer/id #uuid "8c9f823a-1173-540c-b606-9f5396014906" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e7/e7f23a9adf127f850e960ae921900316bf5f4f246d3861d9317a9b231939c6da.png" :db/id #edb/ref 17592186286074} {:answer/id #uuid "ee83f437-3788-5171-9079-ac6cd477a9a4" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/9e/9e4ce3947ab86e2f54c2db2669cdc58c7d69404445573cf4a6313417cbec7cbf.png" :db/id #edb/ref 17592186286977}] :answer-field/correct {:answer/id #uuid "02f1e9ac-33fc-522f-b718-f792ed296580" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a0/a00ad979e2f64fd8ae76e7445012bb6fe52b85cb875175356bf000f5fad8a7e5.png" :db/id #edb/ref 17592186284814} :answer-field/id #uuid "e8fedcc8-9f79-5505-ad77-2eacc7554cb7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287628}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "486a4e51-6072-57cf-a504-5ca9668cfa66" :question/math-academy-id "q-181292" :question/problem "Which of the following is a schematic of the set ${A}^{2}$ for $A={x,y,z}?$" :question/worked-solution "The set ${A}^{2}$ is equivalent to the Cartesian product ${A}^{2}=A\\times A.$\n\nThe Cartesian product $A\\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\nTo create a schematic of the Cartesian product $A\\times A$, we create a table and list the elements of the first set $A$ in a row across the top and the elements of the second set $A$ in a column down the left side.\n\n![](images/ad/adaba1cfa0f8aaba7638c2b581bf90ce1146f3c6ce91fa79654652bf98a2c011.png)\n\nThen, at each intersection, we write an ordered pair whose first coordinate is the corresponding element of the first set and the second coordinate is the corresponding element of the second set.\n\nOur completed $A\\times A$ schematic is shown below.\n\n![](images/91/9150fac674c8ff0608996224022243ed1a218ce077e7ccd12e7e9c8b12b732c7.png)"}] [{:db/id #edb/ref 17592186055071 :knowledge-point/_questions [{:db/id #edb/ref 17592186054636 :knowledge-point/id #uuid "3fca5176-1359-5ad8-b012-592ffa9b20b5" :knowledge-point/title "Cartesian Products With Three Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2316f533-0e7d-5b77-a8dd-d9c80337923d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186285102} {:answer/id #uuid "2c25e9a3-12f8-5ff9-b8bc-23630a88a7fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186285174} {:answer/id #uuid "5b3b07df-dd5d-5565-a9c1-e98ca207f466" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186285623} {:answer/id #uuid "97d4e979-a44a-50ce-9b33-412cccd7bc2e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186286174} {:answer/id #uuid "d6189dc5-6bc6-5726-a93c-14409fffef6e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186286735}] :answer-field/correct {:answer/id #uuid "5b3b07df-dd5d-5565-a9c1-e98ca207f466" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186285623} :answer-field/id #uuid "864bb7c7-2e83-595f-ad2e-7f0fc29c9ab4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287430}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "59457bab-d41c-5c4d-af91-59c9dc67dad9" :question/math-academy-id "q-181294" :question/problem "If $A={0,1,2}$ and $B={x,y},$ which of the following elements belong to $(A\\times B)\\times A?$\n\n- $(1,y,2)$\n- $((1,y),2)$\n- $((y,1),y)$" :question/worked-solution "The Cartesian product $A\\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\nIn this case, $A\\times B$ consists of every combination of ${0,1,2}$ with ${x,y},$ as shown in the schematic below.\n\n![](images/07/077da578323a686ecf0e07cf0a56030fa4ce128a74d408af95b8a3027ad13f28.png)\n\nHence, the set $A\\times B$ is given by\n\n$$\nA\\times B={(0,x),(0,y),(1,x),(1,y),(2,x),(2,y)}.\n$$\n\nNote that \n\n$$\n|A\\times B|=|A|\\cdot |B|=3\\cdot 2=6.\n$$\n\nNow, the Cartesian product\n\n$$\n(A\\times B)\\times A\n$$\n\nconsists of every combination of $A\\times B$ and $A,$ as shown in the schematic below.\n\n![](images/3a/3a14abffc755dcfccce2d410ea18fbcae42d4afe2fbeffd81e1a291bc9d4968e.png)\n\nNote that \n\n$$\n|(A\\times B)\\times A|=|A\\times B|\\cdot |A|=6\\cdot 3=18.\n$$\n\nFrom the given options, we see that only $((1,y),2)\\in (A\\times B)\\times A.$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186055072 :knowledge-point/_questions [{:db/id #edb/ref 17592186054636 :knowledge-point/id #uuid "3fca5176-1359-5ad8-b012-592ffa9b20b5" :knowledge-point/title "Cartesian Products With Three Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "159275ce-4dc9-57f1-827a-d1275c32d42f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186284979} {:answer/id #uuid "2ec53427-0975-56a7-a33f-29f2ec5b5a85" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186285207} {:answer/id #uuid "377afc5a-c99c-58b1-869c-9949866416fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186285308} {:answer/id #uuid "3cb6250f-9c76-5e92-a1ee-5eedcf4fdb74" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186285360} {:answer/id #uuid "9abd151c-b575-5dc9-a22a-1b6338ae760c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186286206}] :answer-field/correct {:answer/id #uuid "377afc5a-c99c-58b1-869c-9949866416fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186285308} :answer-field/id #uuid "f2f51709-2790-5816-b247-4202c39421bf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287644}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9eac2d72-9d93-50cd-8b4e-008064a9d365" :question/math-academy-id "q-181295" :question/problem "If $A={-1,1}$ and $B={u,v},$ which of the following elements belong to $B\\times B\\times A?$\n\n- $(v,v,1)$\n- $((v,v),1)$\n- $(1,v,u)$" :question/worked-solution "The Cartesian product $A\\times B\\times C$ consists of all ordered triples whose first coordinate belongs to $A,$ second coordinate belongs to $B,$ and third coordinate belongs to $C.$\n\nIn this case, $B\\times B\\times A$ consists of every combination of ${u,v}$ with ${u,v}$ and ${-1,1},$ which results in\n\n$$\n\\begin{aligned}B\\times B\\times A={ & (u,u,-1),(u,u,1),(u,v,-1),(u,v,1), \\\\  & (v,u,-1),(v,u,1),(v,v,-1),(v,v,1)}.\\end{aligned}\n$$\n\nNote that\n\n$$\n|B\\times B\\times A|=|B|\\cdot |B|\\cdot |A|=2\\cdot 2\\cdot 2=8.\n$$\n\nFrom the given options, we see that only $(v,v,1)\\in B\\times B\\times A.$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186389902 :knowledge-point/_questions [{:db/id #edb/ref 17592186054633 :knowledge-point/id #uuid "b304527c-5cdc-57df-b118-e555f6f8fa5c" :knowledge-point/title "Creating a Schematic for a Cartesian Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bc1e2521-377a-583c-ae3c-a594986136a1" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/6c/6cceec57dbf53e768fc290d864fa770c70a6642bdc9df1309119e113241b0f34.png" :db/id #edb/ref 17592186389904} {:answer/id #uuid "6100ffa9-8836-588a-ad6d-756450d570c1" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a5/a52e05a3884e5d62ffaacc73104a4f2e61fb8013fb353c850cdb974e66224a40.png" :db/id #edb/ref 17592186389905} {:answer/id #uuid "1d1f178a-1f6f-5167-8e63-1743c6413ab4" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/51/518415814ddb5483e4649c95e58aa41adc68ad8722279dbf99ac4c10bca206e9.png" :db/id #edb/ref 17592186389906} {:answer/id #uuid "d789365b-3b14-591a-b824-5e4aa2089860" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b7/b7497f60cccce44a008c6550f356d32564c2a15e23d88f9c3764415598dc493b.png" :db/id #edb/ref 17592186389907} {:answer/id #uuid "9b455fb2-a223-572c-adf0-f70bc35f621e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d3/d366ec9f363cf38d84c6d741491f7e218e0bedad335f6fc1f1f954f95516f196.png" :db/id #edb/ref 17592186389908}] :answer-field/correct {:answer/id #uuid "1d1f178a-1f6f-5167-8e63-1743c6413ab4" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/51/518415814ddb5483e4649c95e58aa41adc68ad8722279dbf99ac4c10bca206e9.png" :db/id #edb/ref 17592186389906} :answer-field/id #uuid "202c18dc-b67f-5564-b56a-fe0084384a70" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389903}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "393bef1a-778c-53b8-a73e-75ffc95e3405" :question/math-academy-id "q-181958" :question/problem "Which of the following is a schematic of the Cartesian product $A\\times B$ for $A={p,q}$ and $B={w,z}?$" :question/worked-solution "The Cartesian product $A\\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\nTo create a schematic of the Cartesian product, we create a table and list the elements of the first set $A$ in a row across the top and the elements of the second set $B$ in a column down the left side.\n\n![](images/6b/6baae52e45d00d31eac732a23be655b648765c27cfcdc667c511b176d5bbbc88.png)\n\nThen, at each intersection, we write an ordered pair whose first coordinate is the corresponding element of $A$ and the second coordinate is the corresponding element of $B.$\n\nOur completed $A\\times B$ schematic is shown below.\n\n![](images/38/38e9d12b0c09ae066149d95235a6918712214edc147c57775da2d880b584cb9e.png)"}] [{:db/id #edb/ref 17592186287776 :knowledge-point/_questions [{:db/id #edb/ref 17592186054633 :knowledge-point/id #uuid "b304527c-5cdc-57df-b118-e555f6f8fa5c" :knowledge-point/title "Creating a Schematic for a Cartesian Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0293f2e6-924e-58e9-9d13-9d0d315f9002" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186284809} {:answer/id #uuid "52800430-7da9-5750-957a-fe138372d0bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186285546} {:answer/id #uuid "75d8e253-748f-5343-9c97-cbab141df228" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186285884} {:answer/id #uuid "91d4bc78-d9ae-5a68-921b-13c1a93531d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186286114} {:answer/id #uuid "a29a73b4-ea9e-577c-b53b-8adc8ec0d729" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186286280}] :answer-field/correct {:answer/id #uuid "0293f2e6-924e-58e9-9d13-9d0d315f9002" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186284809} :answer-field/id #uuid "894309b4-f9cd-553e-9900-2f55b6828938" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287437}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "acf6f0a0-0064-5b71-8b07-5e0f0eb96bda" :question/math-academy-id "q-181963" :question/problem "![](images/cb/cb3e6ef6a832f2adbbc5e096bddf2c4f6a0445fbd77a71df5617298f8dad2e51.png)\n\nBy finding the missing entries in the schematic shown above for $A\\times B,$ where $A={a,b,c}$ and $B={2,4,6},$ determine which of the following statements are true.\n\n- $(4,b)\\in A\\times B$\n- $(c,6)\\in A\\times B$\n- $(a,2)\\in A\\times B$" :question/worked-solution "The Cartesian product $A\\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\nTo complete our schematic of $A\\times B,$ we write an ordered pair whose first coordinate is the corresponding element of $A$ and the second coordinate is the corresponding element of $B$ at each intersection.\n\n![](images/57/57d053cca53046f02201540e655030a37ba8f7a2811e7dc724cf30ca9fd3c072.png)\n\nAccording to our diagram:\n\n- $(4,b)\\notin A\\times B\\,\\times $\n\n- $(c,6)\\in A\\times B\\,✓$\n\n- $(a,2)\\in A\\times B\\,✓$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186287778 :knowledge-point/_questions [{:db/id #edb/ref 17592186054636 :knowledge-point/id #uuid "3fca5176-1359-5ad8-b012-592ffa9b20b5" :knowledge-point/title "Cartesian Products With Three Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09004638-b23b-5d7c-bf05-024a92db458c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186284860} {:answer/id #uuid "0ea9a8a6-d04d-5edb-bb85-9aaf504db77a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186284914} {:answer/id #uuid "30140e94-31a6-5e00-8d4d-cdfa8e87a563" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186285225} {:answer/id #uuid "8becfc26-2b75-59e1-b3ad-e02c5059b304" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186286069} {:answer/id #uuid "a01533fc-1265-5dae-9827-96be14f562b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186286246}] :answer-field/correct {:answer/id #uuid "a01533fc-1265-5dae-9827-96be14f562b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186286246} :answer-field/id #uuid "b99f6978-6f4a-52c1-a0cb-1ece2ed27467" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287532}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1ec96a4e-9e05-5335-919b-b747e9d81df8" :question/math-academy-id "q-181969" :question/problem "If $A={p,q,r}$ and $B={3,5},$ which of the following elements belong to $B\\times (A\\times A)?$\n\n- $(5,(r,p))$\n- $(q,(5,3))$\n- $(3,q,p)$" :question/worked-solution "The Cartesian product $A\\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\nIn this case, $A\\times A$ consists of every combination of ${p,q,r}$ with ${p,q,r},$ as shown in the schematic below.\n\n![](images/aa/aad91ef7655fa8a5bf0c9852ee4e5e2166289087a56ac18e932ee3cce17164a0.png)\n\nHence, the set $A\\times A$ is given by\n\n$$\nA\\times A={(p,p),(p,q),(p,r),(q,p),(q,q),(q,r),(r,p),(r,q),(r,r)}.\n$$\n\nNote that \n\n$$\n|A\\times A|=|A|\\cdot |A|=3\\cdot 3=9.\n$$\n\nNow, the Cartesian product\n\n$$\nB\\times (A\\times A)\n$$\n\nconsists of every combination of $B$ and $A\\times A,$ as shown in the schematic below.\n\n![](images/e5/e573cecaa9333e071d980b1b03d65dafadd027506d2c2b9b6e8acfbe15d3be52.png)\n\nNote that \n\n$$\n|B\\times (A\\times A)|=|B|\\cdot |A\\times A|=2\\cdot 9=18.\n$$\n\nFrom the given options, we see that only $(5,(r,p))\\in B\\times (A\\times A).$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186287789 :knowledge-point/_questions [{:db/id #edb/ref 17592186054634 :knowledge-point/id #uuid "a6128eca-7f76-5386-9d67-d81db2943eeb" :knowledge-point/title "Computing a Cartesian Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b32442c-08ba-5d50-8370-b4f7bb2844ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186285346} {:answer/id #uuid "45feb55c-e7bb-5ec4-bd19-6ccbce9dd40d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186285428} {:answer/id #uuid "5938940a-29bf-5630-bd36-aefb018067d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186285604} {:answer/id #uuid "701d78ff-0afb-5095-8913-1e2f45fedc33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186285824} {:answer/id #uuid "f258fef0-e676-5a91-90bd-704c2797ac3d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186287010}] :answer-field/correct {:answer/id #uuid "45feb55c-e7bb-5ec4-bd19-6ccbce9dd40d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186285428} :answer-field/id #uuid "26fdac77-4c39-59a1-bd83-eb6b67c2475f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287230}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4b374349-dba8-556c-833d-28419c5d38a1" :question/math-academy-id "q-182011" :question/problem "For the sets $X={x,z},$ $Y={a,b},$ and $Z=X\\times Y,$ determine which of the following statements are true.\n\n- $(a,x)\\in Z$\n- $(z,a)\\in Z$\n- $(z,z)\\in Z$" :question/worked-solution "The Cartesian product $X\\times Y$ consists of all ordered pairs whose first coordinate belongs to $X$ and whose second coordinate belongs to $Y.$\n\nIn this case, the schematic for $X\\times Y$ is shown below.\n\n![](images/b7/b73e7aeb017bd9f7c50f7d110c7933763834eb391ac4a3e97d25f4e587a8a3d4.png)\n\nHence, the set $Z=X\\times Y$ is given by\n\n$$\nZ={(x,a),(x,b),(z,a),(z,b)}.\n$$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186287791 :knowledge-point/_questions [{:db/id #edb/ref 17592186054634 :knowledge-point/id #uuid "a6128eca-7f76-5386-9d67-d81db2943eeb" :knowledge-point/title "Computing a Cartesian Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15b36e5f-e8a8-5ea9-946e-c4816a26e689" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186284982} {:answer/id #uuid "2d977033-ec3f-53cc-a677-5319105de312" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186285193} {:answer/id #uuid "3418f9d4-3146-507c-b45f-2efcc9ed4974" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186285266} {:answer/id #uuid "65a4153e-cfe4-5447-acfc-d029e30792b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186285710} {:answer/id #uuid "88dd20ce-84ae-5cec-b98c-0addd3860395" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186286041}] :answer-field/correct {:answer/id #uuid "2d977033-ec3f-53cc-a677-5319105de312" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186285193} :answer-field/id #uuid "80e9eb6a-880b-5e87-86c2-04da9fdfec7d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287419}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a2efc8f2-dfe5-5b29-94dc-09dde2c27a4f" :question/math-academy-id "q-182015" :question/problem "For the sets $X={5,10},$ $Y={r,s,t},$ and $Z=X\\times Y,$ determine which of the following statements are true.\n\n- $(5,r)\\in Z$\n- $(r,t)\\in Z$\n- $(10,s)\\in Z$" :question/worked-solution "The Cartesian product $X\\times Y$ consists of all ordered pairs whose first coordinate belongs to $X$ and whose second coordinate belongs to $Y.$\n\nIn this case, the schematic for $X\\times Y$ is shown below.\n\n![](images/1e/1eb13d93fbefc4c7285edef537a9fb3e21339f7a3b37a179eeb150db8d726c1b.png)\n\nHence, the set $Z=X\\times Y$ is given by\n\n$$\nZ={(5,r),(5,s),(5,t),(10,r),(10,s),(10,t)}.\n$$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186287796 :knowledge-point/_questions [{:db/id #edb/ref 17592186054634 :knowledge-point/id #uuid "a6128eca-7f76-5386-9d67-d81db2943eeb" :knowledge-point/title "Computing a Cartesian Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f290c93-ac47-5ece-8232-a9aab64d1850" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186284917} {:answer/id #uuid "adcbc4e9-8658-5f77-8854-9343dfb7438b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186286375} {:answer/id #uuid "cf113239-e2a2-5d50-9a8d-22c7de04539c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186286667} {:answer/id #uuid "ddebc3a1-4716-55ac-b2dd-542d779bfa4e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186286807} {:answer/id #uuid "fe5dd96b-7bcc-566f-a45f-4f5372f9ea96" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186287115}] :answer-field/correct {:answer/id #uuid "0f290c93-ac47-5ece-8232-a9aab64d1850" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186284917} :answer-field/id #uuid "687b2c95-1e6a-58a3-ae37-e9248df20195" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287365}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1a71b6cc-f717-587b-ac69-3fbfad95bd60" :question/math-academy-id "q-182022" :question/problem "For the sets $Z={-3,6,-9}$ and $Y=Z\\times Z,$ determine which of the following statements are true.\n\n- $(-3,6,-3)\\in Y$\n- $(-3,-9)\\in Y$\n- $(-9,6)\\in Y$" :question/worked-solution "The Cartesian product $Z\\times Z$ consists of all ordered pairs whose first coordinate belongs to $Z$ and whose second coordinate belongs to $Z.$\n\nIn this case, the schematic for ${Z}^{2}=Z\\times Z$ is shown below.\n\n![](images/0c/0c58bf1f025cc4960ce3b9dc8e1bc3bf474a521473833b27d136fd77fd6b814a.png)\n\nHence, the set $Y=Z\\times Z$ is given by\n\n$$\nY={(-3,-3),(-3,6),(-3,-9),(6,-3),(6,6),(6,-9),(-9,-3)(-9,6),(-9,-9)}.\n$$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186351180 :knowledge-point/_questions [{:db/id #edb/ref 17592186054635 :knowledge-point/id #uuid "88fb08f1-03f1-5b04-8b48-4b153e522040" :knowledge-point/title "Computing the Cardinality of a Cartesian Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04e51bd9-4d36-5a76-98d7-1e52bb98ec6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186348490} {:answer/id #uuid "1ab8ba58-fe6c-5be4-9d1a-7dfd25e803e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186348672} {:answer/id #uuid "41c40045-c2bf-5d58-935c-d6eeea1554c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186349042} {:answer/id #uuid "98aeffd4-46bd-567d-ae81-6a8491d47731" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186349814} {:answer/id #uuid "fa0b481a-52a4-5310-a133-a9ed3e13b778" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186350646}] :answer-field/correct {:answer/id #uuid "1ab8ba58-fe6c-5be4-9d1a-7dfd25e803e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186348672} :answer-field/id #uuid "5890ad1b-3e98-524f-97ba-e3a8c043bf00" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350855}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5aedcbc3-5480-58bd-92fe-aaa7bf7e52fa" :question/math-academy-id "q-80894" :question/problem "What is the cardinality of $H\\times K$ for $H={1,2,3,…,9}$ and $K={x,y}?$" :question/worked-solution "For any two finite sets $H$ and $K,$ the cardinality of $H\\times K$ is\n\n$$\n|H\\times K|=|H|\\cdot |K|.\n$$\n\nIn this case, we have\n\n$$\n\\begin{aligned}|H\\times K| & =|H|\\cdot |K| \\\\  & =9\\cdot 2 \\\\  & =18.\\end{aligned}\n$$"}]}
