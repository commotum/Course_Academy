[{:db/id 17592186054633 :knowledge-point/questions ["question-01313989-157c-5f5d-bbb7-36ed26661356"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186054435 :question/problem "For the sets $A = \\{3,4,7\\},$ $B = \\{f,g\\},$ and $C = A \\times B,$ determine which of the following statements are true.\n\nI. $(f,4) \\in C$\n\nII. $(7,g) \\in C$\n\nIII. $(3,f) \\in C$" :db/ensure [:question/validate]} {:db/id 17592186054636 :knowledge-point/questions ["question-cd7d0702-ab54-5763-af3c-93c657eacc9b"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186054436 :question/problem "If $A = \\{ p,q \\}$ and $B = \\{ 4,9 \\},$ which of the following elements belong to $(A \\times B) \\times B?$\n\nI. $((p,4),9)$\n\nII. $((q,9),4)$\n\nIII. $(p,4,9)$" :db/ensure [:question/validate]} {:db/id "question-01313989-157c-5f5d-bbb7-36ed26661356" :question/id #uuid "01313989-157c-5f5d-bbb7-36ed26661356" :question/math-academy-id "q-181973" :question/problem "Which of the following is a schematic of the set ${A}^{2}$ for $A=\\{-2,0,2\\}?$" :question/worked-solution "The set ${A}^{2}$ is equivalent to the Cartesian product ${A}^{2}=A\\times A.$\n\nThe Cartesian product $A\\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\nTo create a schematic of the Cartesian product $A\\times A$, we create a table and list the elements of the first set $A$ in a row across the top and the elements of the second set $A$ in a column down the left side.\n\n![](images/61/61e02d0523efb8f8e4107028bec4b47ba6da239648dbd0b9fa7d60377c318291.png)\n\nThen, at each intersection, we write an ordered pair whose first coordinate is the corresponding element of the first set and the second coordinate is the corresponding element of the second set.\n\nOur completed $A\\times A$ schematic is shown below.\n\n![](images/a1/a16c4641e747437df122372d74aefe49298568de826104f89610d4953e6ef16a.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-02e6a651-6148-5a18-a237-4dd2aef7338c"] :db/ensure [:question/validate]} {:db/id "answer-field-02e6a651-6148-5a18-a237-4dd2aef7338c" :answer-field/id #uuid "02e6a651-6148-5a18-a237-4dd2aef7338c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c174618b-9d50-5d03-bcb4-44e31371de0f" :answer-field/choices ["answer-79af4caa-c926-5894-b216-896badc7c752" "answer-b5f3669b-e5c2-5ac4-a551-0f3b19bb478b" "answer-c174618b-9d50-5d03-bcb4-44e31371de0f" "answer-c8e6af1e-d534-5a31-b638-111cf9d6f299" "answer-db442ff8-8bb6-569d-b6da-845981061e13"] :db/ensure [:answer-field/validate]} {:db/id "answer-79af4caa-c926-5894-b216-896badc7c752" :answer/id #uuid "79af4caa-c926-5894-b216-896badc7c752" :answer/type :answer.type/image :answer/value "images/22/22caf64320dd0ba6f6db308e898a2f5cf42235f6cd7f9e238c3e7845713956c0.png" :db/ensure [:answer/validate]} {:db/id "answer-b5f3669b-e5c2-5ac4-a551-0f3b19bb478b" :answer/id #uuid "b5f3669b-e5c2-5ac4-a551-0f3b19bb478b" :answer/type :answer.type/image :answer/value "images/7a/7a97a73a864f95bc74f872ae71d9e5a46f72ddb5add20817fe914e7994b1fbb2.png" :db/ensure [:answer/validate]} {:db/id "answer-c174618b-9d50-5d03-bcb4-44e31371de0f" :answer/id #uuid "c174618b-9d50-5d03-bcb4-44e31371de0f" :answer/type :answer.type/image :answer/value "images/8b/8b9aee39c5edb8bd14955e06d3deae3c3926d185a668e6f7c1eb39cef19d6b07.png" :db/ensure [:answer/validate]} {:db/id "answer-c8e6af1e-d534-5a31-b638-111cf9d6f299" :answer/id #uuid "c8e6af1e-d534-5a31-b638-111cf9d6f299" :answer/type :answer.type/image :answer/value "images/c6/c6f53935d541ea3bece105bc3ce1bda6cdaea162d34061ea175869954c6c4547.png" :db/ensure [:answer/validate]} {:db/id "answer-db442ff8-8bb6-569d-b6da-845981061e13" :answer/id #uuid "db442ff8-8bb6-569d-b6da-845981061e13" :answer/type :answer.type/image :answer/value "images/e8/e8ec205a595c83443926f0a5b54375b5708d2da9c57915e5a473d36959cc473e.png" :db/ensure [:answer/validate]} {:db/id 17592186287776 :question/problem "![](images/cb/cb3e6ef6a832f2adbbc5e096bddf2c4f6a0445fbd77a71df5617298f8dad2e51.png)\n\nBy finding the missing entries in the schematic shown above for $A\\times B,$ where $A=\\{a,b,c\\}$ and $B=\\{2,4,6\\},$ determine which of the following statements are true.\n\nI. $(4,b)\\in A\\times B$\n\nII. $(c,6)\\in A\\times B$\n\nIII. $(a,2)\\in A\\times B$" :db/ensure [:question/validate]} {:db/id 17592186055069 :question/problem "Which of the following is a schematic of the Cartesian product $A\\times B$ for $A=\\{1,10,100\\}$ and $B=\\{a,b\\}?$" :db/ensure [:question/validate]} {:db/id 17592186287680 :question/problem "Which of the following is a schematic of the set ${A}^{2}$ for $A=\\{x,y,z\\}?$" :db/ensure [:question/validate]} {:db/id 17592186389902 :question/problem "Which of the following is a schematic of the Cartesian product $A\\times B$ for $A=\\{p,q\\}$ and $B=\\{w,z\\}?$" :db/ensure [:question/validate]} {:db/id 17592186054995 :question/problem "For the sets $Z=\\{-1,0,1\\}$ and $Y=Z\\times Z,$ determine which of the following statements are true.\n\nI. $(-1,0,1)\\in Y$\n\nII. $(-1,1)\\in Y$\n\nIII. $(0,0)\\in Y$" :db/ensure [:question/validate]} {:db/id 17592186287796 :question/problem "For the sets $Z=\\{-3,6,-9\\}$ and $Y=Z\\times Z,$ determine which of the following statements are true.\n\nI. $(-3,6,-3)\\in Y$\n\nII. $(-3,-9)\\in Y$\n\nIII. $(-9,6)\\in Y$" :db/ensure [:question/validate]} {:db/id 17592186287789 :question/problem "For the sets $X=\\{x,z\\},$ $Y=\\{a,b\\},$ and $Z=X\\times Y,$ determine which of the following statements are true.\n\nI. $(a,x)\\in Z$\n\nII. $(z,a)\\in Z$\n\nIII. $(z,z)\\in Z$" :db/ensure [:question/validate]} {:db/id 17592186287791 :question/problem "For the sets $X=\\{5,10\\},$ $Y=\\{r,s,t\\},$ and $Z=X\\times Y,$ determine which of the following statements are true.\n\nI. $(5,r)\\in Z$\n\nII. $(r,t)\\in Z$\n\nIII. $(10,s)\\in Z$" :db/ensure [:question/validate]} {:db/id 17592186420986 :question/problem "For the sets $A=\\{0,1,2\\},$ $B=\\{4,6,8\\},$ and $C=A\\times B,$ determine which of the following statements are true.\n\nI. $(0,2)\\in C$\n\nII. $(1,8)\\in C$\n\nIII. $(0,6)\\in C$" :db/ensure [:question/validate]} {:db/id 17592186351180 :question/problem "What is the cardinality of $H\\times K$ for $H=\\{1,2,3,…,9\\}$ and $K=\\{x,y\\}?$" :db/ensure [:question/validate]} {:db/id 17592186241133 :question/problem "What is the cardinality of $M\\times M$ for $M=\\{1,2,3…,10\\}?$" :db/ensure [:question/validate]} {:db/id 17592186054996 :question/problem "What is the cardinality of $Z\\times Y$ for $Z=\\{1,4,9,16,25,36\\}$ and $Y=\\{2,3,7,9\\}?$" :db/ensure [:question/validate]} {:db/id 17592186420988 :question/problem "What is the cardinality of $B\\times A$ for $B=\\{1,2,3,...,100\\}$ and $A=\\{a\\}?$" :db/ensure [:question/validate]} {:db/id 17592186420987 :question/problem "What is the cardinality of $Z\\times X$ for $Z=\\{p,q,r\\}$ and $X=\\{-3,-2,-1,0,1,2,3\\}?$" :db/ensure [:question/validate]} {:db/id 17592186055072 :question/problem "If $A=\\{-1,1\\}$ and $B=\\{u,v\\},$ which of the following elements belong to $B\\times B\\times A?$\n\nI. $(v,v,1)$\n\nII. $((v,v),1)$\n\nIII. $(1,v,u)$" :db/ensure [:question/validate]} {:db/id 17592186420985 :question/problem "If $A=\\{-2,2\\}$ and $B=\\{c,d\\},$ which of the following elements belong to $(A\\times B)\\times B?$\n\nI. $(-2,d,c)$\n\nII. $(-2,(c,d))$\n\nIII. $((2,d),c)$" :db/ensure [:question/validate]} {:db/id 17592186287778 :question/problem "If $A=\\{p,q,r\\}$ and $B=\\{3,5\\},$ which of the following elements belong to $B\\times (A\\times A)?$\n\nI. $(5,(r,p))$\n\nII. $(q,(5,3))$\n\nIII. $(3,q,p)$" :db/ensure [:question/validate]} {:db/id 17592186055071 :question/problem "If $A=\\{0,1,2\\}$ and $B=\\{x,y\\},$ which of the following elements belong to $(A\\times B)\\times A?$\n\nI. $(1,y,2)$\n\nII. $((1,y),2)$\n\nIII. $((y,1),y)$" :db/ensure [:question/validate]} {:db/id "question-cd7d0702-ab54-5763-af3c-93c657eacc9b" :question/id #uuid "cd7d0702-ab54-5763-af3c-93c657eacc9b" :question/math-academy-id "q-181974" :question/problem "If $A=\\{1,2,3\\}$ and $B=\\{x,y\\},$ which of the following elements belong to $(B\\times B)\\times A?$\n\nI. $(x,y,1)$\n\nII. $((x,x),1)$\n\nIII. $((y,x),2)$" :question/worked-solution "The Cartesian product $A\\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\nIn this case, $B\\times B$ consists of every combination of ${x,y}$ with ${x,y},$ as shown in the schematic below.\n\n![](images/5a/5af389ab817ce509519af7a3c1a5fdbb583d8e13859b9aa3b6166958f81e3040.png)\n\nHence, the set $B\\times B$ is given by\n\n$$\nB\\times B={(x,x),(x,y),(y,x),(y,y)}.\n$$\n\nNote that \n\n$$\n|B\\times B|=|B|\\cdot |B|=2\\cdot 2=4.\n$$\n\nNow, the Cartesian product\n\n$$\n(B\\times B)\\times A\n$$\n\nconsists of every combination of $B\\times B$ and $A,$ as shown in the schematic below.\n\n![](images/da/dae7febad357be8d9f000c9dc7abfbe97fda34e3e9ff0b0e8ab0289e3c4e782a.png)\n\nNote that \n\n$$\n|(B\\times B)\\times A|=|B\\times B|\\cdot |A|=4\\cdot 3=12.\n$$\n\nFrom the given options, we see that both $((x,x),1)$ and $((y,x),2)$ are in $(B\\times B)\\times A.$\n\nTherefore, the correct answer is \"II and III only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-22e20c2f-0ad2-5c27-92ce-f6cb31d11c7e"] :db/ensure [:question/validate]} {:db/id "answer-field-22e20c2f-0ad2-5c27-92ce-f6cb31d11c7e" :answer-field/id #uuid "22e20c2f-0ad2-5c27-92ce-f6cb31d11c7e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e723cf0c-c777-5b0e-8e18-bb6ad7a41a34" :answer-field/choices ["answer-bf3a5443-4b0e-550e-bf7e-6d0557498925" "answer-ca1e2c2a-e3a1-5fd0-a837-50714e2a444d" "answer-e723cf0c-c777-5b0e-8e18-bb6ad7a41a34" "answer-f574563b-f694-5f1d-9ca7-08a37b989e54" "answer-7bfc8b18-19ed-5d03-a98a-c6f208ab5bbe"] :db/ensure [:answer-field/validate]} {:db/id "answer-bf3a5443-4b0e-550e-bf7e-6d0557498925" :answer/id #uuid "bf3a5443-4b0e-550e-bf7e-6d0557498925" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-ca1e2c2a-e3a1-5fd0-a837-50714e2a444d" :answer/id #uuid "ca1e2c2a-e3a1-5fd0-a837-50714e2a444d" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-e723cf0c-c777-5b0e-8e18-bb6ad7a41a34" :answer/id #uuid "e723cf0c-c777-5b0e-8e18-bb6ad7a41a34" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-f574563b-f694-5f1d-9ca7-08a37b989e54" :answer/id #uuid "f574563b-f694-5f1d-9ca7-08a37b989e54" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-7bfc8b18-19ed-5d03-a98a-c6f208ab5bbe" :answer/id #uuid "7bfc8b18-19ed-5d03-a98a-c6f208ab5bbe" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]}]
