17] [17592186299234 #edb/ref 1075 #edb/ref 17592186297639 #edb/ref 17592186045417] [17592186299234 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186299234 #edb/ref 1077 "field-4" #edb/ref 17592186045417] [17592186299234 #edb/ref 1078 #edb/ref 17592186297639 #edb/ref 17592186045417] [17592186299234 #edb/ref 1079 #uuid "b029a4eb-3160-581a-8813-6eaf9bdeebd7" #edb/ref 17592186045417] [17592186299324 #edb/ref 1075 #edb/ref 17592186298185 #edb/ref 17592186045417] [17592186299324 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186299324 #edb/ref 1077 "field-3" #edb/ref 17592186045417] [17592186299324 #edb/ref 1078 #edb/ref 17592186298185 #edb/ref 17592186045417] [17592186299324 #edb/ref 1079 #uuid "cda9e946-5a85-5e86-9781-1b1870f198bf" #edb/ref 17592186045417] [17592186299537 #edb/ref 1068 #edb/ref 17592186298906 #edb/ref 17592186045417] [17592186299537 #edb/ref 1068 #edb/ref 17592186298994 #edb/ref 17592186045417] [17592186299537 #edb/ref 1068 #edb/ref 17592186299104 #edb/ref 17592186045417] [17592186299537 #edb/ref 1068 #edb/ref 17592186299324 #edb/ref 17592186045417] [17592186299537 #edb/ref 1069 "q-316961" #edb/ref 17592186045417] [17592186299537 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186299537 #edb/ref 1071 "The system of equations\n\n$$\n{\\begin{aligned}3x-y+z=0 \\\\ 5x+y-7z=-2 \\\\ -2x+4y+3z=4\\end{aligned}\n$$\n\ncan be represented using matrix notation as\n\n|  |  | $3$ | $-1$ | $1$ |  |  |  | $x$ |  |  |  | {{field-1}} |  |  |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |\n|  |  | {{field-2}} | $1$ | {{field-3}} |  |  |  | $y$ |  | $=$ |  | $-2$ |  | . |\n|  |  | $-2$ | {{field-4}} | $3$ |  |  |  | $z$ |  |  |  | $4$ |  |  |" #edb/ref 17592186045417] [17592186299537 #edb/ref 1072 #uuid "193f944c-d77c-5446-9a05-12850a3f60de" #edb/ref 17592186045417] [17592186299537 #edb/ref 1074 "First, let's write the system so that $x$, $y$, and $z$ appear in each equation:\n\n$$\n{\\begin{aligned}3x-y+z=0 \\\\ 5x+y-7z=-2 \\\\ -2x+4y+3z=4\\end{aligned}\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=[\\begin{aligned}3 & -1 & 1 \\\\ 5 & 1 & -7 \\\\ -2 & 4 & 3\\end{aligned}]\n$$\n\nis the coefficient matrix,\n\n$$\nb=[\\begin{aligned}0 \\\\ -2 \\\\ 4\\end{aligned}]\n$$\n\nis the column vector of constants, and\n\n$$\nx=[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n[\\begin{aligned}3 & -1 & 1 \\\\ 5 & 1 & -7 \\\\ -2 & 4 & 3\\end{aligned}][\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}0 \\\\ -2 \\\\ 4\\end{aligned}].\n$$" #edb/ref 17592186045417] [17592186299547 #edb/ref 1068 #edb/ref 17592186298661 #edb/ref 17592186045417] [17592186299547 #edb/ref 1068 #edb/ref 17592186298741 #edb/ref 17592186045417] [17592186299547 #edb/ref 1068 #edb/ref 17592186298965 #edb/ref 17592186045417] [17592186299547 #edb/ref 1068 #edb/ref 17592186299221 #edb/ref 17592186045417] [17592186299547 #edb/ref 1069 "q-316998" #edb/ref 17592186045417] [17592186299547 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186299547 #edb/ref 1071 "The system of equations\n\n$$\n{\\begin{aligned}2z-2y-5x=5 \\\\ -3z+3y+4x=1 \\\\ 2z-2x+y=2\\end{aligned}\n$$\n\ncan be represented using matrix notation as\n\n|  |  | $-5$ | {{field-1}} | $2$ |  |  |  | $x$ |  |  |  | $5$ |  |  |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |\n|  |  | $4$ | $3$ | {{field-2}} |  |  |  | $y$ |  | $=$ |  | {{field-3}} |  | . |\n|  |  | $-2$ | {{field-4}} | $2$ |  |  |  | $z$ |  |  |  | $2$ |  |  |" #edb/ref 17592186045417] [17592186299547 #edb/ref 1072 #uuid "05df8d85-d4aa-50db-b657-3624538dbf63" #edb/ref 17592186045417] [17592186299547 #edb/ref 1074 "First, let's write the system so that $x$, $y$, and $z$ appear in each equation in the correct order and all constants are on the right-hand side of t