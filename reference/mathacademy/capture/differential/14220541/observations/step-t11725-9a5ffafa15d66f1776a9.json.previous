6 614 121 583T67 467Q60 445 57 441T43 437H40Z\"></path>\n<path stroke-width=\"1\" id=\"E3-MJMAIN-2C\" d=\"M78 35T78 60T94 103T137 121Q165 121 187 96T210 8Q210 -27 201 -60T180 -117T154 -158T130 -185T117 -194Q113 -194 104 -185T95 -172Q95 -168 106 -156T131 -126T157 -76T173 -3V9L172 8Q170 7 167 6T161 3T152 1T140 0Q113 0 96 17Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E3-MJMATHI-66\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMAIN-28\" x=\"550\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMAINB-78\" x=\"940\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMAIN-29\" x=\"1547\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMAIN-3D\" x=\"2214\" y=\"0\"></use>\n<g transform=\"translate(3271,0)\">\n <use xlink:href=\"#E3-MJMAINB-62\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E3-MJMATHI-54\" x=\"904\" y=\"596\"></use>\n</g>\n <use xlink:href=\"#E3-MJMAINB-78\" x=\"4508\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMAIN-2C\" x=\"5116\" y=\"0\"></use>\n</g>\n</svg></span>\nwhere <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"7.222ex\" height=\"2.343ex\" style=\"vertical-align: -0.338ex;\" viewBox=\"0 -863.1 3109.7 1008.6\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-4-Title\">\n<title id=\"MathJax-SVG-4-Title\">\\mathbf{b} \\in \\mathbb{R}^n</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E4-MJMAINB-62\" d=\"M32 686L123 690Q214 694 215 694H221V409Q289 450 378 450Q479 450 539 387T600 221Q600 122 535 58T358 -6H355Q272 -6 203 53L160 1L129 0H98V301Q98 362 98 435T99 525Q99 591 97 604T83 620Q69 624 42 624H29V686H32ZM227 105L232 99Q237 93 242 87T258 73T280 59T306 49T339 45Q380 45 411 66T451 131Q457 160 457 230Q457 264 456 284T448 329T430 367T396 389T343 398Q282 398 235 355L227 348V105Z\"></path>\n<path stroke-width=\"1\" id=\"E4-MJMAIN-2