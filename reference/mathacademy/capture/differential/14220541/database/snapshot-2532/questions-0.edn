eld/choices [{:answer/id #uuid "22f87356-a267-54a0-ba16-c1efa75b59cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3wx" :db/id #edb/ref 17592186532007} {:answer/id #uuid "33f579a6-f33f-5692-be37-c2a248a144e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x" :db/id #edb/ref 17592186532039} {:answer/id #uuid "56e79ae4-c42d-5590-b5a0-1173d6e6e501" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x-2" :db/id #edb/ref 17592186532124} {:answer/id #uuid "6ae18405-cefd-5d16-a534-187dec9d1497" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x" :db/id #edb/ref 17592186532174} {:answer/id #uuid "93bed4b9-cea3-5925-a181-95a2520a01f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3w" :db/id #edb/ref 17592186532268}] :answer-field/correct {:answer/id #uuid "33f579a6-f33f-5692-be37-c2a248a144e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x" :db/id #edb/ref 17592186532039} :answer-field/id #uuid "5c7f99c8-5b87-5868-bac9-130222bcf4cb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186532534}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bfb0421c-aa0c-535f-b51f-dc865b4acd28" :question/math-academy-id "q-265741" :question/problem "Given the function \n\n$$\nf(x,w)=3{w}^{T}x-2\n$$\n\nthat maps two vectors to a scalar, find ${∇}_{w}f.$" :question/worked-solution "Using the result \n\n$$\n{∇}_{w}({w}^{T}x)=x,\n$$\n\nwe have\n\n$$\n\\begin{aligned}{∇}_{w}f & ={∇}_{w}(3{w}^{T}x-2) \\\\  & =3\\cdot {∇}_{w}({w}^{T}x)-{∇}_{w}(2) \\\\  & =3\\cdot x+0 \\\\  & =3x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186532631 :knowledge-point/_questions [{:db/id #edb/ref 17592186204103 :knowledge-point/id #uuid "b7de7a9a-4848-5590-b066-f746262181e5" :knowledge-point/title "Computing Gradients Including Squared Norms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11c584fd-625d-5a75-9b3f-f0f55a1a7eb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10w+6‖w‖" :db/id #edb/ref 17592186531966} {:answer/id #uuid "31772745-7785-52c8-ba0e-2fa677b1f190" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10x+3w" :db/id #edb/ref 17592186532033} {:answer/id #uuid "47cee7c0-cbb6-5288-b280-1789ccc53d51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10x+6w" :db/id #edb/ref 17592186532079} {:answer/id #uuid "5a133d62-0da5-55b0-b9e0-33c416fc66a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10x+6w-2" :db/id #edb/ref 17592186532132} {:answer/id #uuid "751c670a-5038-517e-aea3-2ec5a4b70826" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10x+6‖w‖" :db/id #edb/ref 17592186532198}] :answer-field/correct {:answer/id #uuid "47cee7c0-cbb6-5288-b280-1789ccc53d51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10x+6w" :db/id #edb/ref 17592186532079} :answer-field/id #uuid "99449935-4cad-5a41-81a3-06a840cfe3db" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186532561}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1c52a19c-5a59-5b47-837b-41939417ff1a" :question/math-academy-id "q-265745" :question/problem "Given the function \n\n$$\nf(x,w)=-10{w}^{T}x+3‖w{‖}^{2}-2\n$$\n\nthat maps two vectors to a scalar, find ${∇}_{w}f.$" :question/worked-solution "Using the results \n\n$$\n{∇}_{w}({w}^{T}x)=x,\\,{∇}_{w}({w}^{T}w)=2w,\n$$\n\nwe have\n\n$$\n\\begin{aligned}{∇}_{w}f & ={∇}_{w}(-10{w}^{T}x+3‖w{‖}^{2}-2) \\\\  & =-10\\cdot {∇}_{w}({w}^{T}x)+3\\cdot {∇}_{w}(‖w{‖}^{2})+{∇}_{w}(4) \\\\  & =-10\\cdot {∇}_{w}({w}^{T}x)+3\\cdot {∇}_{w}({w}^{T}w)+{∇}_{w}(4) \\\\  & =-10\\cdot x+3\\cdot 2w+0 \\\\  & =-10x+6w.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186532649 :knowledge-point/_questions [{:db/id #edb/ref 17592186204104 :knowledge-point/id #uuid "86b3efb7-511d-5da7-92ca-5add976b1ca1" :knowledge-point/title "Computing Gradients of Functions Containing L1 Norms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1333e66f-ee53-5cd8-b2dc-06575ef3d9fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4‖w{‖}_{1}" :db/id #edb/ref 17592186531970} {:answer/id #uuid "144ccf48-6329-5906-8c8e-9c5474729581" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2‖w{‖}_{1}\\cdot \\text{sign}(w)+12" :db/id #edb/ref 17592186531973} {:answer/id #uuid "2cbfe78c-f7fd-507d-bd4e-94484e22ac4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4w\\cdot \\text{sign}(w)" :db/id #edb/ref 17592186532022} {:answer/id #uuid "2e829e7b-f214-5f2c-8bab-217333e0e462" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4‖w{‖}_{1}\\cdot \\text{sign}(w)" :db/id #edb/ref 17592186532026} {:answer/id #uuid "c3419009-82b8-5a56-8c71-d6f51218a10f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2‖w{‖}_{1}" :db/id #edb/ref 17592186532351}] :answer-field/correct {:answer/id #uuid "2e829e7b-f214-5f2c-8bab-217333e0e462" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4‖w{‖}_{1}\\cdot \\text{sign}(w)" :db/id #edb/ref 17592186532026} :answer-field/id #uuid "2fdb0a13-0323-5c3d-8147-f0cc8b8b93ad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186532513}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "451c95de-b4df-5e7d-8a76-df474224e7d9" :question/math-academy-id "q-265748" :question/problem "Given the function \n\n$$\nf(x,w)=-2(‖w{‖}_{1})^{2}+12\n$$\n\nthat maps a vector to a scalar, find ${∇}_{w}f.$ You may assume that $w$ has all nonzero components." :question/worked-solution "Using the result \n\n$$\n{∇}_{w}(‖w{‖}_{1})=\\text{sign}(w),\n$$\n\n we have\n\n$$\n\\begin{aligned}{∇}_{w}f & ={∇}_{w}(-2(‖w{‖}_{1})^{2}+12) \\\\  & =-2\\cdot {∇}_{w}((‖w{‖}_{1})^{2})+{∇}_{w}(12) \\\\  & =-2\\cdot 2\\cdot ‖w{‖}_{1}\\cdot {∇}_{w}(‖w{‖}_{1})+0 \\\\  & =-4‖w{‖}_{1}\\cdot \\text{sign}(w).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186204571 :knowledge-point/_questions [{:db/id #edb/ref 17592186204102 :knowledge-point/id #uuid "6600adba-92a6-523c-b214-9e506bc37cc9" :knowledge-point/title "Computing Gradients of Linear Forms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c112af0-f0a1-5963-a7ae-a3e9879d0f25" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186203368} {:answer/id #uuid "7435d94c-b1a5-5fce-a108-24af294ff83b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186203369} {:answer/id #uuid "38caa28c-728f-5eb5-9e10-21bbf0c1aa3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 2 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186532048} {:answer/id #uuid "71c41df8-afa0-5e4a-abb0-9a56b9c39300" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 \\\\ 0 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186532187} {:answer/id #uuid "c5a28dfc-770a-54c1-8dbb-3b736ea154ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 \\\\ 0 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186532360}] :answer-field/correct {:answer/id #uuid "38caa28c-728f-5eb5-9e10-21bbf0c1aa3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 2 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186532048} :answer-field/id #uuid "ba82a013-ea05-5c74-9e56-9645ee2a03cb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186203364}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "abe0afba-8431-51a9-90a5-dfff60453709" :question/math-academy-id "q-265752" :question/problem "Compute the gradient of the function $f:{R}^{3}\\to R$ defined by \n\n$$\nf(x)=[\\begin{aligned}1 & 2 & 0\\end{aligned}]\\cdot x\n$$\n\n with respect to $x$ at $x=[\\begin{aligned}-2 \\\\ 0 \\\\ 1\\end{aligned}].$" :question/worked-solution "Writing $b=[\\begin{aligned}1 \\\\ 2 \\\\ 0\\end{aligned}]$, we have\n\n$$\nf(x)={b}^{T}x.\n$$\n\nThe gradient of a function $f(x)={b}^{T}x$ with respect to $x\\in {R}^{n}$ is\n\n$$\n{∇}_{x}f(x)=b.\n$$\n\nTherefore, we get\n\n$$\n{∇}_{x}f(x)=b=[\\begin{aligned}1 \\\\ 2 \\\\ 0\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186532622 :knowledge-point/_questions [{:db/id #edb/ref 17592186204102 :knowledge-point/id #uuid "6600adba-92a6-523c-b214-9e506bc37cc9" :knowledge-point/title "Computing Gradients of Linear Forms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a56765c-1fb2-5ac9-b03c-6b91b632cf07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186532084} {:answer/id #uuid "5fa819ef-a851-5a01-9e84-7de7cf518f92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 \\\\ 0 \\\\ -1 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186532145} {:answer/id #uuid "6cc262f1-2338-53de-