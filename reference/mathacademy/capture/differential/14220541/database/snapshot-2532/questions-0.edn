tion "Using the results\n\n$$\n{∇}_{w}(‖w{‖}_{1})=\\text{sign}(w),\\,{∇}_{w}({w}^{T}w)=2w,\n$$\n\n we have\n\n$$\n\\begin{aligned}{∇}_{w}f & ={∇}_{w}(-3‖w{‖}_{1}+4{w}^{T}w) \\\\  & ={∇}_{w}(-3‖w{‖}_{1})+{∇}_{w}(4{w}^{T}w) \\\\  & =-3\\cdot {∇}_{w}(‖w{‖}_{1})+4\\cdot {∇}_{w}({w}^{T}w) \\\\  & =-3\\cdot \\text{sign}(w)+4\\cdot 2w \\\\  & =-3\\,\\text{sign}(w)+8w.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186532720 :knowledge-point/_questions [{:db/id #edb/ref 17592186204104 :knowledge-point/id #uuid "86b3efb7-511d-5da7-92ca-5add976b1ca1" :knowledge-point/title "Computing Gradients of Functions Containing L1 Norms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6dadc6ef-3565-5774-b6f1-e9dd00b7fb52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3(‖w{‖}_{1})^{2}\\cdot \\text{sign}(w)+w" :db/id #edb/ref 17592186532184} {:answer/id #uuid "8b60b92c-493b-5f5c-ad3e-ec48ecf8fd8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3(‖w{‖}_{1})^{3}\\cdot \\text{sign}(w)+x" :db/id #edb/ref 17592186532251} {:answer/id #uuid "8ecca018-c680-5d6e-9d18-c2730e726cf6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(‖w{‖}_{1})^{2}\\cdot \\text{sign}(w)+w" :db/id #edb/ref 17592186532256} {:answer/id #uuid "9f88b11c-be7f-5d58-a56c-690b422d0e1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3(‖w{‖}_{1})^{2}\\cdot \\text{sign}(w)+x" :db/id #edb/ref 17592186532294} {:answer/id #uuid "b87e4086-52ff-5448-b5b1-c77f2a6b9ebb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(‖w{‖}_{1})^{2}\\cdot \\text{sign}(w)+x" :db/id #edb/ref 17592186532337}] :answer-field/correct {:answer/id #uuid "9f88b11c-be7f-5d58-a56c-690b422d0e1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3(‖w{‖}_{1})^{2}\\cdot \\text{sign}(w)+x" :db/id #edb/ref 17592186532294} :answer-field/id #uuid "ef08fff4-ecfa-5edc-bb5b-ed9bbba1d2d1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186532606}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f3cf1839-85e6-5f28-8e77-8fe8ed36b0c8" :question/math-academy-id "q-275977" :question/problem "Given the function \n\n$$\nf(x,w)={(‖w{‖}_{1})}^{3}+{x}^{T}w\n$$\n\nthat maps a vector to a scalar, find ${∇}_{w}f.$ You may assume that $w$ has no zero components." :question/worked-solution "Using the results\n\n$$\n{∇}_{w}(‖w{‖}_{1})=\\text{sign}(w),\\,{∇}_{w}({x}^{T}w)=x,\n$$\n\n we have\n\n$$\n\\begin{aligned}{∇}_{w}f & ={∇}_{w}({(‖w{‖}_{1})}^{3}+{x}^{T}w) \\\\  & ={∇}_{w}({(‖w{‖}_{1})}^{3})+{∇}_{w}({x}^{T}w) \\\\  & =3(‖w{‖}_{1})^{2}\\cdot {∇}_{w}(‖w{‖}_{1})+x \\\\  & =3(‖w{‖}_{1})^{2}\\cdot \\text{sign}(w)+x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186532706 :knowledge-point/_questions [{:db/id #edb/ref 17592186204103 :knowledge-point/id #uuid "b7de7a9a-4848-5590-b066-f746262181e5" :knowledge-point/title "Computing Gradients Including Squared Norms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1921ad72-06b3-5698-9761-9f56c676a53d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2‖w‖+9" :db/id #edb/ref 17592186531984} {:answer/id #uuid "1b0777bd-de6e-52e1-9d60-f6cf2eae97e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4‖w‖" :db/id #edb/ref 17592186531991} {:answer/id #uuid "a3664a5f-20c6-5b00-9b32-cbad35ca0725" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4w" :db/id #edb/ref 17592186532300} {:answer/id #uuid "a768687d-d635-5983-9f47-0c5bdd3fc76d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4w+9" :db/id #edb/ref 17592186532311} {:answer/id #uuid "d298b009-dc87-51bd-81e6-e1eb5cfcbf1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2w" :db/id #edb/ref 17592186532383}] :answer-field/correct {:answer/id #uuid "a3664a5f-20c6-5b00-9b32-cbad35ca0725" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4w" :db/id #edb/ref 17592186532300} :answer-field/id #uuid "3cefc8bc-49cf-5a0e-b525-2eca3feb721e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186532522}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cdabeb8f-7345-59ca-9731-4ee1c58120d8" :question/math-academy-id "q-349237" :question/problem "Given the function \n\n$$\nf(w)=-2‖w{‖}^{2}+9\n$$\n\nthat maps a vector to a scalar, find ${∇}_{w}f.$" :question/worked-solution "Using the result \n\n$$\n{∇}_{w}({w}^{T}w)=2w,\n$$\n\nwe have\n\n$$\n\\begin{aligned}{∇}_{w}f & ={∇}_{w}(-2‖w{‖}^{2}+9) \\\\  & =-2\\cdot {∇}_{w}(‖w{‖}^{2})+{∇}_{w}(9) \\\\  & =-2\\cdot {∇}_{w}({w}^{T}w)+{∇}_{w}(9) \\\\  & =-2\\cdot 2w+0 \\\\  & =-4w.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186532713 :knowledge-point/_questions [{:db/id #edb/ref 17592186204103 :knowledge-point/id #uuid "b7de7a9a-4848-5590-b066-f746262181e5" :knowledge-point/title "Computing Gradients Including Squared Norms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7a78d36b-6081-571b-8e53-0d5774ae9381" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x-8w" :db/id #edb/ref 17592186532207} {:answer/id #uuid "835cb165-83ba-5d4d-9d87-061d4bd3bcc7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x-4w" :db/id #edb/ref 17592186532229} {:answer/id #uuid "8f2c551d-f2ef-551f-8458-885faa6a0933" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-8w" :db/id #edb/ref 17592186532257} {:answer/id #uuid "fa3ac857-54f1-58f3-920d-1ef816579f84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "‖x‖-8‖w‖+8" :db/id #edb/ref 17592186532478} {:answer/id #uuid "fa69530c-321a-5d3f-990d-d55babb827a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+8w" :db/id #edb/ref 17592186532479}] :answer-field/correct {:answer/id #uuid "7a78d36b-6081-571b-8e53-0d5774ae9381" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x-8w" :db/id #edb/ref 17592186532207} :answer-field/id #uuid "0862bffe-39e6-5cf0-a879-662c0e59a7b9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186532494}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ec192a53-8b67-53c4-a3ab-2010430980bc" :question/math-academy-id "q-349240" :question/problem "Given the function \n\n$$\nf(x,w)=2{w}^{T}x-4‖w{‖}^{2}+8\n$$\n\nthat maps two vectors to a scalar, find ${∇}_{w}f.$" :question/worked-solution "Using the results \n\n$$\n{∇}_{w}({w}^{T}x)=x,\\,{∇}_{w}({w}^{T}w)=2w,\n$$\n\nwe have\n\n$$\n\\begin{aligned}{∇}_{w}f & ={∇}_{w}(2{w}^{T}x-4‖w{‖}^{2}+8) \\\\  & ={∇}_{w}(2{w}^{T}x)-4\\cdot {∇}_{w}(‖w{‖}^{2})+{∇}_{w}(8) \\\\  & =2{∇}_{w}({w}^{T}x)-4\\cdot {∇}_{w}({w}^{T}w)+{∇}_{w}(8) \\\\  & =2x-4\\cdot 2w+0 \\\\  & =2x-8w.\\end{aligned}\n$$"}]}
