n" #edb/ref 17592186045417] [17592186532606 #edb/ref 1078 #edb/ref 17592186532294 #edb/ref 17592186045417] [17592186532606 #edb/ref 1079 #uuid "ef08fff4-ecfa-5edc-bb5b-ed9bbba1d2d1" #edb/ref 17592186045417] [17592186532622 #edb/ref 1068 #edb/ref 17592186532587 #edb/ref 17592186045417] [17592186532622 #edb/ref 1069 "q-265756" #edb/ref 17592186045417] [17592186532622 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186532622 #edb/ref 1071 "Compute the gradient of the function $f:{R}^{4}\\to R$ defined by \n\n$$\nf(x)=[\\begin{aligned}-1 & 0 & 1 & -1\\end{aligned}]\\cdot x\n$$\n\n with respect to $x$ at $x=[\\begin{aligned}2 \\\\ 3 \\\\ -1 \\\\ 0\\end{aligned}].$" #edb/ref 17592186045417] [17592186532622 #edb/ref 1072 #uuid "02680e0f-01a2-5039-ae5b-662f20597c66" #edb/ref 17592186045417] [17592186532622 #edb/ref 1074 "Writing $b=[\\begin{aligned}-1 \\\\ 0 \\\\ 1 \\\\ -1\\end{aligned}]$, we have\n\n$$\nf(x)={b}^{T}x.\n$$\n\nThe gradient of a function $f(x)={b}^{T}x$ with respect to $x\\in {R}^{n}$ is\n\n$$\n{∇}_{x}f(x)=b.\n$$\n\nTherefore, we get\n\n$$\n{∇}_{x}f(x)=b=[\\begin{aligned}-1 \\\\ 0 \\\\ 1 \\\\ -1\\end{aligned}].\n$$" #edb/ref 17592186045417] [17592186532624 #edb/ref 1068 #edb/ref 17592186532594 #edb/ref 17592186045417] [17592186532624 #edb/ref 1069 "q-264920" #edb/ref 17592186045417] [17592186532624 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186532624 #edb/ref 1071 "Given the function \n\n$$\nf(x,w)={w}^{T}x+4\n$$\n\nthat maps two vectors to a scalar, find ${∇}_{w}f.$" #edb/ref 17592186045417] [17592186532624 #edb/ref 1072 #uuid "0446f1ce-7aff-5c2b-b94d-259fd188ab51" #edb/ref 17592186045417] [17592186532624 #edb/ref 1074 "Using the result \n\n$$\n{∇}_{w}({w}^{T}x)=x,\n$$\n\nwe have\n\n$$\n\\begin{aligned}{∇}_{w}f & ={∇}_{w}({w}^{T}x+4) \\\\  & ={∇}_{w}({w}^{T}x)+{∇}_{w}(4) \\\\  & =x+0 \\\\  & =x.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186532631 #edb/ref 1068 #edb/ref 17592186532561 #edb/ref 17592186045417] [17592186532631 #edb/ref 1069 "q-265745" #edb/ref 17592186045417] [17592186532631 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186532631 #edb/ref 1071 "Given the function \n\n$$\nf(x,w)=-10{w}^{T}x+3‖w{‖}^{2}-2\n$$\n\nthat maps two vectors to a scalar, find ${∇}_{w}f.$" #edb/ref 17592186045417] [17592186532631 #edb/ref 1072 #uuid "1c52a19c-5a59-5b47-837b-41939417ff1a" #edb/ref 17592186045417] [17592186532631 #edb/ref 1074 "Using the results \n\n$$\n{∇}_{w}({w}^{T}x)=x,\\,{∇}_{w}({w}^{T}w)=2w,\n$$\n\nwe have\n\n$$\n\\begin{aligned}{∇}_{w}f & ={∇}_{w}(-10{w}^{T}x+3‖w{‖}^{2}-2) \\\\  & =-10\\cdot {∇}_{w}({w}^{T}x)+3\\cdot {∇}_{w}(‖w{‖}^{2})+{∇}_{w}(4) \\\\  & =-10\\cdot {∇}_{w}({w}^{T}x)+3\\cdot {∇}_{w}({w}^{T}w)+{∇}_{w}(4) \\\\  & =-10\\cdot x+3\\cdot 2w+0 \\\\  & =-10x+6w.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186532649 #edb/ref 1068 #edb/ref 17592186532513 #edb/ref 17592186045417] [17592186532649 #edb/ref 1069 "q-265748" #edb/ref 17592186045417] [17592186532649 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186532649 #edb/ref 1071 "Given the function \n\n$$\nf(x,w)=-2(‖w{‖}_{1})^{2}+12\n$$\n\nthat maps a vector to a scalar, find ${∇}_{w}f.$ You may assume that $w$ has all nonzero components." #edb/ref 17592186045417] [17592186532649 #edb/ref 1072 #uuid "451c95de-b4df-5e7d-8a76-df474224e7d9" #edb/ref 17592186045417] [17592186532649 #edb/ref 1074 "Using the result \n\n$$\n{∇}_{w}(‖w{‖}_{1})=\\text{sign}(w),\n$$\n\n we have\n\n$$\n\\begin{aligned}{∇}_{w}f & ={∇}_{w}(-2(‖w{‖}_{1})^{2}+12) \\\\  & =-2\\cdot {∇}_{w}((‖w{‖}_{1})^{2})+{∇}_{w}(12) \\\\  & =-2\\cdot 2\\cdot ‖w{‖}_{1}\\cdot {∇}_{w}(‖w{‖}_{1})+0 \\\\  & =-4‖w{‖}_{1}\\cdot \\text{sign}(w).\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186532668 #edb/ref 1068 #edb/ref 17592186532529 #edb/ref 17592186045417] [17592186532668 #edb/ref 1069 "q-265759" #edb/ref 17592186045417] [17592186532668 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186532668 #edb/ref 1071 "Compute the gradient of the function $f:{R}^{4}\\to R$ defined by \n\n$$\nf(x)=[\\begin{aligned}1 & -2 & 3 & -4\\end{aligned}]\\cdot x\n$$\n\n with respect to $x$ at $x=[\\begin{aligned}1 \\\\ 1 \\\\ 1 \\\\ 1\\end{aligned}].$" #edb/ref 17592186045417] [17592186532668 #edb/ref 1072 #uuid "7bcd4936-683c-5a30-8d4e-a52d39fd01ec" #edb/ref 17592186045417] [17592186532668 #edb/ref 1074 "Writing $b=[\\begin{aligned}1 \\\\ -2 \\\\ 3 \\\\ -4\\end{aligned}]$, we have\n\n$$\nf(x)={b}^{T}x.\n$$\n\nThe gradient of a function $f(x)={b}^{T}x$ with respect to $x\\in {R}^{n}$ is\n\n$$\n{∇}_{x}f(x)=b.\n$$\n\nTherefore, we get\n\n$$\n{∇}_{x}f(x)=b=[\\begin{aligned}1 \\\\ -2 \\\\ 3 \\\\ -4\\end{aligned}].\n$$" #edb/ref 17592186045417] [17592186532701 #edb/ref 1068 #edb/ref 17592186532534 #edb/ref 17592186045417] [17592186532701 #edb/ref 1069 "q-265741" #edb/ref 17592186045417] [17592186532701 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186532701 #edb/ref 1071 "Given the function \n\n$$\nf(x,w)=3{w}^{T}x-2\n$$\n\nthat maps two vectors to a scalar, find ${∇}_{w}f.$" #edb/ref 17592186045417] [17592186532701 #edb/ref 1072 #uuid "bfb0421c-aa0c-535f-b51f-dc865b4acd28" #edb/ref 17592186045417] [17592186532701 #edb/ref 1074 "Using the result \n\n$$\n{∇}_{w}({w}^{T}x)=x,\n$$\n\nwe have\n\n$$\n\\begin{aligned}{∇}_{w}f & ={∇}_{w}(3{w}^{T}x-2) \\\\  & =3\\cdot {∇}_{w}({w}^{T}x)-{∇}_{w}(2) \\\\  & =3\\cdot x+0 \\\\  & =3x.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186532705 #edb/ref 1068 #edb/ref 17592186532578 #edb/ref 17592186045417] [17592186532705 #edb/ref 1069 "q-275972" #edb/ref 17592186045417] [17592186532705 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186532705 #edb/ref 1071 "Given the function \n\n$$\nf(w)=(‖w{‖}_{1})^{2}+10\n$$\n\nthat maps a vector to a scalar, find ${∇}_{w}f.$ You may assume that $w$ has all nonzero components." #edb/ref 17592186045417] [17592186532705 #edb/ref 1072 #uuid "cda56dfe-5f02-56af-8d87-05b17e6af869" #edb/ref 17592186045417] [17592186532705 #edb/ref 1074 "Using the result \n\n$$\n{∇}_{w}(‖w{‖}_{1})=\\text{sign}(w),\n$$\n\n we have\n\n$$\n\\begin{aligned}{∇}_{w}f & ={∇}_{w}((‖w{‖}_{1})^{2}+10) \\\\  & ={∇}_{w}((‖w{‖}_{1})^{2})+{∇}_{w}(10) \\\\  & =2\\cdot ‖w{‖}_{1}\\cdot {∇}_{w}(‖w{‖}_{1})+0 \\\\  & =2‖w{‖}_{1}\\cdot \\text{sign}(w).\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186532706 #edb/ref 1068 #edb/ref 17592186532522 #edb/ref 17592186045417] [17592186532706 #edb/ref 1069 "q-349237" #edb/ref 17592186045417] [17592186532706 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186532706 #edb/ref 1071 "Given the function \n\n$$\nf(w)=-2‖w{‖}^{2}+9\n$$\n\nthat maps a vector to a scalar, find ${∇}_{w}f.$" #edb/ref 17592186045417] [17592186532706 #edb/ref 1072 #uuid "cdabeb8f-7345-59ca-9731-4ee1c58120d8" #edb/ref 17592186045417] [17592186532706 #edb/ref 1074 "Using the result \n\n$$\n{∇}_{w}({w}^{T}w)=2w,\n$$\n\nwe have\n\n$$\n\\begin{aligned}{∇}_{w}f & ={∇}_{w}(-2‖w{‖}^{2}+9) \\\\  & =-2\\cdot {∇}_{w}(‖w{‖}^{2})+{∇}_{w}(9) \\\\  & =-2\\cdot {∇}_{w}({w}^{T}w)+{∇}_{w}(9) \\\\  & =-2\\cdot 2w+0 \\\\  & =-4w.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186532713 #edb/ref 1068 #edb/ref 17592186532494 #edb/ref 17592186045417] [17592186532713 #edb/ref 1069 "q-349240" #edb/ref 17592186045417] [17592186532713 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186532713 #edb/ref 1071 "Given the function \n\n$$\nf(x,w)=2{w}^{T}x-4‖w{‖}^{2}+8\n$$\n\nthat maps two vectors to a scalar, find ${∇}_{w}f.$" #edb/ref 17592186045417] [17592186532713 #edb/ref 1072 #uuid "ec192a53-8b67-53c4-a3ab-2010430980bc" #edb/ref 17592186045417] [17592186532713 #edb/ref 1074 "Using the results \n\n$$\n{∇}_{w}({w}^{T}x)=x,\\,{∇}_{w}({w}^{T}w)=2w,\n$$\n\nwe have\n\n$$\n\\begin{aligned}{∇}_{w}f & ={∇}_{w}(2{w}^{T}x-4‖w{‖}^{2}+8) \\\\  & ={∇}_{w}(2{w}^{T}x)-4\\cdot {∇}_{w}(‖w{‖}^{2})+{∇}_{w}(8) \\\\  & =2{∇}_{w}({w}^{T}x)-4\\cdot {∇}_{w}({w}^{T}w)+{∇}_{w}(8) \\\\  & =2x-4\\cdot 2w+0 \\\\  & =2x-8w.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186532717 #edb/ref 1068 #edb/ref 17592186532524 #edb/ref 17592186045417] [17592186532717 #edb/ref 1069 "q-275974" #edb/ref 17592186045417] [17592186532717 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186532717 #edb/ref 1071 "Given the function \n\n$$\nf(w)=-3‖w{‖}_{1}+4{w}^{T}w\n$$\n\nthat maps a vector to a scalar, find ${∇}_{w}f.$ You may assume that $w$ has all nonzero components." #edb/ref 17592186045417] [17592186532717 #edb/ref 1072 #uuid "f23dae50-683b-52ff-a0e9-aa781506dfbd" #edb/ref 17592186045417] [17592186532717 #edb/ref 1074 "Using the results\n\n$$\n{∇}_{w}(‖w{‖}_{1})=\\text{sign}(w),\\,{∇}_{w}({w}^{T}w)=2w,\n$$\n\n we have\n\n$$\n\\begin{aligned}{∇}_{w}f & ={∇}_{w}(-3‖w{‖}_{1}+4{w}^{T}w) \\\\  & ={∇}_{w}(-3‖w{‖}_{1})+{∇}_{w}(4{w}^{T}w) \\\\  & =-3\\cdot {∇}_{w}(‖w{‖}_{1})+4\\cdot {∇}_{w}({w}^{T}w) \\\\  & =-3\\cdot \\text{sign}(w)+4\\cdot 2w \\\\  & =-3\\,\\text{sign}(w)+8w.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186532720 #edb/ref 1068 #edb/ref 17592186532606 #edb/ref 17592186045417] [17592186532720 #edb/ref 1069 "q-275977" #edb/ref 17592186045417] [17592186532720 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186532720 #edb/ref 1071 "Given the function \n\n$$\nf(x,w)={(‖w{‖}_{1})}^{3}+{x}^{T}w\n$$\n\nthat maps a vector to a scalar, find ${∇}_{w}f.$ You may assume that $w$ has no zero components." #edb/ref 17592186045417] [17592186532720 #edb/ref 1072 #uuid "f3cf1839-85e6-5f28-8e77-8fe8ed36b0c8" #edb/ref 17592186045417] [17592186532720 #edb/ref 1074 "Using the results\n\n$$\n{∇}_{w}(‖w{‖}_{1})=\\text{sign}(w),\\,{∇}_{w}({x}^{T}w)=x,\n$$\n\n we have\n\n$$\n\\begin{aligned}{∇}_{w}f & ={∇}_{w}({(‖w{‖}_{1})}^{3}+{x}^{T}w) \\\\  & ={∇}_{w}({(‖w{‖}_{1})}^{3})+{∇}_{w}({x}^{T}w) \\\\  & =3(‖w{‖}_{1})^{2}\\cdot {∇}_{w}(‖w{‖}_{1})+x \\\\  & =3(‖w{‖}_{1})^{2}\\cdot \\text{sign}(w)+x.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186532726 #edb/ref 1068 #edb/ref 17592186532540 #edb/ref 17592186045417] [17592186532726 #edb/ref 1069 "q-275970" #edb/ref 17592186045417] [17592186532726 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186532726 #edb/ref 1071 "Given the function \n\n$$\nf(w)=‖w{‖}^{2}+5\n$$\n\nthat maps a vector to a scalar, find ${∇}_{w}f.$" #edb/ref 17592186045417] [17592186532726 #edb/ref 1072 #uuid "ffb6af35-3127-5869-9aa2-2d05c6e6ebee" #edb/ref 17592186045417] [17592186532726 #edb/ref 1074 "Using the result \n\n$$\n{∇}_{w}({w}^{T}w)=2w,\n$$\n\nwe have\n\n$$\n\\begin{aligned}{∇}_{w}f & ={∇}_{w}(‖w{‖}^{2}+5) \\\\  & ={∇}_{w}(‖w{‖}^{2})+{∇}_{w}(5) \\\\  & ={∇}_{w}({w}^{T}w)+{∇}_{w}(5) \\\\  & =2w+0 \\\\  & =2w.\\end{aligned}\n$$" #edb/ref 17592186045417]}
