nswer-fields "answer-field-2fdb0a13-0323-5c3d-8147-f0cc8b8b93ad"] [17592186204104 :knowledge-point/questions "question-451c95de-b4df-5e7d-8a76-df474224e7d9"] ["question-f3cf1839-85e6-5f28-8e77-8fe8ed36b0c8" :question/id #uuid "f3cf1839-85e6-5f28-8e77-8fe8ed36b0c8"] ["question-f3cf1839-85e6-5f28-8e77-8fe8ed36b0c8" :question/math-academy-id "q-275977"] ["question-f3cf1839-85e6-5f28-8e77-8fe8ed36b0c8" :question/problem "Given the function \n\n$$\nf(x,w)={(‖w{‖}_{1})}^{3}+{x}^{T}w\n$$\n\nthat maps a vector to a scalar, find ${∇}_{w}f.$ You may assume that $w$ has no zero components."] ["question-f3cf1839-85e6-5f28-8e77-8fe8ed36b0c8" :question/worked-solution "Using the results\n\n$$\n{∇}_{w}(‖w{‖}_{1})=\\text{sign}(w),\\,{∇}_{w}({x}^{T}w)=x,\n$$\n\n we have\n\n$$\n\\begin{aligned}{∇}_{w}f & ={∇}_{w}({(‖w{‖}_{1})}^{3}+{x}^{T}w) \\\\  & ={∇}_{w}({(‖w{‖}_{1})}^{3})+{∇}_{w}({x}^{T}w) \\\\  & =3(‖w{‖}_{1})^{2}\\cdot {∇}_{w}(‖w{‖}_{1})+x \\\\  & =3(‖w{‖}_{1})^{2}\\cdot \\text{sign}(w)+x.\\end{aligned}\n$$"] ["question-f3cf1839-85e6-5f28-8e77-8fe8ed36b0c8" :question/difficulty :question.difficulty/hard] ["answer-field-ef08fff4-ecfa-5edc-bb5b-ed9bbba1d2d1" :answer-field/id #uuid "ef08fff4-ecfa-5edc-bb5b-ed9bbba1d2d1"] ["answer-8ecca018-c680-5d6e-9d18-c2730e726cf6" :answer/id #uuid "8ecca018-c680-5d6e-9d18-c2730e726cf6"] ["answer-8ecca018-c680-5d6e-9d18-c2730e726cf6" :answer/type :answer.type/math] ["answer-8ecca018-c680-5d6e-9d18-c2730e726cf6" :answer/value "(‖w{‖}_{1})^{2}\\cdot \\text{sign}(w)+w"] ["answer-b87e4086-52ff-5448-b5b1-c77f2a6b9ebb" :answer/id #uuid "b87e4086-52ff-5448-b5b1-c77f2a6b9ebb"] ["answer-b87e4086-52ff-5448-b5b1-c77f2a6b9ebb" :answer/type :answer.type/math] ["answer-b87e4086-52ff-5448-b5b1-c77f2a6b9ebb" :answer/value "(‖w{‖}_{1})^{2}\\cdot \\text{sign}(w)+x"] ["answer-6dadc6ef-3565-5774-b6f1-e9dd00b7fb52" :answer/id #uuid "6dadc6ef-3565-5774-b6f1-e9dd00b7fb52"] ["answer-6dadc6ef-3565-5774-b6f1-e9dd00b7fb52" :answer/type :answer.type/math] ["answer-6dadc6ef