r-field/choices ["answer-93bed4b9-cea3-5925-a181-95a2520a01f0" "answer-22f87356-a267-54a0-ba16-c1efa75b59cb" "answer-33f579a6-f33f-5692-be37-c2a248a144e0" "answer-56e79ae4-c42d-5590-b5a0-1173d6e6e501" "answer-6ae18405-cefd-5d16-a534-187dec9d1497"] :db/ensure [:answer-field/validate]} {:db/id "answer-93bed4b9-cea3-5925-a181-95a2520a01f0" :answer/id #uuid "93bed4b9-cea3-5925-a181-95a2520a01f0" :answer/type :answer.type/math :answer/value "3w" :db/ensure [:answer/validate]} {:db/id "answer-22f87356-a267-54a0-ba16-c1efa75b59cb" :answer/id #uuid "22f87356-a267-54a0-ba16-c1efa75b59cb" :answer/type :answer.type/math :answer/value "3wx" :db/ensure [:answer/validate]} {:db/id "answer-33f579a6-f33f-5692-be37-c2a248a144e0" :answer/id #uuid "33f579a6-f33f-5692-be37-c2a248a144e0" :answer/type :answer.type/math :answer/value "3x" :db/ensure [:answer/validate]} {:db/id "answer-56e79ae4-c42d-5590-b5a0-1173d6e6e501" :answer/id #uuid "56e79ae4-c42d-5590-b5a0-1173d6e6e501" :answer/type :answer.type/math :answer/value "3x-2" :db/ensure [:answer/validate]} {:db/id "answer-6ae18405-cefd-5d16-a534-187dec9d1497" :answer/id #uuid "6ae18405-cefd-5d16-a534-187dec9d1497" :answer/type :answer.type/math :answer/value "x" :db/ensure [:answer/validate]} {:db/id "question-1c52a19c-5a59-5b47-837b-41939417ff1a" :question/id #uuid "1c52a19c-5a59-5b47-837b-41939417ff1a" :question/math-academy-id "q-265745" :question/problem "Given the function \n\n$$\nf(x,w)=-10{w}^{T}x+3‖w{‖}^{2}-2\n$$\n\nthat maps two vectors to a scalar, find ${∇}_{w}f.$" :question/worked-solution "Using the results \n\n$$\n{∇}_{w}({w}^{T}x)=x,\\,{∇}_{w}({w}^{T}w)=2w,\n$$\n\nwe have\n\n$$\n\\begin{aligned}{∇}_{w}f & ={∇}_{w}(-10{w}^{T}x+3‖w{‖}^{2}-2) \\\\  & =-10\\cdot {∇}_{w}({w}^{T}x)+3\\cdot {∇}_{w}(‖w{‖}^{2})+{∇}_{w}(4) \\\\  & =-10\\cdot {∇}_{w}({w}^{T}x)+3\\cdot {∇}_{w}({w}^{T}w)+{∇}_{w}(4) \\\\  & =-10\\cdot x+3\\cdot 2w+0 \\\\  & =-10x+6w.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer