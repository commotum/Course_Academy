^{T}x-4‖w{‖}^{2}+8) \\\\  & ={∇}_{w}(2{w}^{T}x)-4\\cdot {∇}_{w}(‖w{‖}^{2})+{∇}_{w}(8) \\\\  & =2{∇}_{w}({w}^{T}x)-4\\cdot {∇}_{w}({w}^{T}w)+{∇}_{w}(8) \\\\  & =2x-4\\cdot 2w+0 \\\\  & =2x-8w.\\end{aligned}\n$$"] ["question-ec192a53-8b67-53c4-a3ab-2010430980bc" :question/difficulty :question.difficulty/moderate] ["answer-field-0862bffe-39e6-5cf0-a879-662c0e59a7b9" :answer-field/id #uuid "0862bffe-39e6-5cf0-a879-662c0e59a7b9"] ["answer-fa69530c-321a-5d3f-990d-d55babb827a9" :answer/id #uuid "fa69530c-321a-5d3f-990d-d55babb827a9"] ["answer-fa69530c-321a-5d3f-990d-d55babb827a9" :answer/type :answer.type/math] ["answer-fa69530c-321a-5d3f-990d-d55babb827a9" :answer/value "2x+8w"] ["answer-835cb165-83ba-5d4d-9d87-061d4bd3bcc7" :answer/id #uuid "835cb165-83ba-5d4d-9d87-061d4bd3bcc7"] ["answer-835cb165-83ba-5d4d-9d87-061d4bd3bcc7" :answer/type :answer.type/math] ["answer-835cb165-83ba-5d4d-9d87-061d4bd3bcc7" :answer/value "2x-4w"] ["answer-7a78d36b-6081-571b-8e53-0d5774ae9381" :answer/id #uuid "7a78d36b-6081-571b-8e53-0d5774ae9381"] ["answer-7a78d36b-6081-571b-8e53-0d5774ae9381" :answer/type :answer.type/math] ["answer-7a78d36b-6081-571b-8e53-0d5774ae9381" :answer/value "2x-8w"] ["answer-8f2c551d-f2ef-551f-8458-885faa6a0933" :answer/id #uuid "8f2c551d-f2ef-551f-8458-885faa6a0933"] ["answer-8f2c551d-f2ef-551f-8458-885faa6a0933" :answer/type :answer.type/math] ["answer-8f2c551d-f2ef-551f-8458-885faa6a0933" :answer/value "x-8w"] ["answer-fa3ac857-54f1-58f3-920d-1ef816579f84" :answer/id #uuid "fa3ac857-54f1-58f3-920d-1ef816579f84"] ["answer-fa3ac857-54f1-58f3-920d-1ef816579f84" :answer/type :answer.type/math] ["answer-fa3ac857-54f1-58f3-920d-1ef816579f84" :answer/value "‖x‖-8‖w‖+8"] ["answer-field-0862bffe-39e6-5cf0-a879-662c0e59a7b9" :answer-field/key "selection"] ["answer-field-0862bffe-39e6-5cf0-a879-662c0e59a7b9" :answer-field/type :answer-field.type/radio] ["answer-field-0862bffe-39e6-5cf0-a879-662c0e59a7b9" :answer-field/correct "answer-7a78d36b-6081-571b-8e53-0d5774ae9381"