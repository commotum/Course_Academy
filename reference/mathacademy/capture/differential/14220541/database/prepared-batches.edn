n$$\n\\begin{aligned}{∇}_{w}f & ={∇}_{w}(-2‖w{‖}^{2}+9) \\\\  & =-2\\cdot {∇}_{w}(‖w{‖}^{2})+{∇}_{w}(9) \\\\  & =-2\\cdot {∇}_{w}({w}^{T}w)+{∇}_{w}(9) \\\\  & =-2\\cdot 2w+0 \\\\  & =-4w.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-3cefc8bc-49cf-5a0e-b525-2eca3feb721e"] :db/ensure [:question/validate]} {:db/id "answer-field-3cefc8bc-49cf-5a0e-b525-2eca3feb721e" :answer-field/id #uuid "3cefc8bc-49cf-5a0e-b525-2eca3feb721e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a3664a5f-20c6-5b00-9b32-cbad35ca0725" :answer-field/choices ["answer-d298b009-dc87-51bd-81e6-e1eb5cfcbf1a" "answer-1921ad72-06b3-5698-9761-9f56c676a53d" "answer-a3664a5f-20c6-5b00-9b32-cbad35ca0725" "answer-1b0777bd-de6e-52e1-9d60-f6cf2eae97e0" "answer-a768687d-d635-5983-9f47-0c5bdd3fc76d"] :db/ensure [:answer-field/validate]} {:db/id "answer-d298b009-dc87-51bd-81e6-e1eb5cfcbf1a" :answer/id #uuid "d298b009-dc87-51bd-81e6-e1eb5cfcbf1a" :answer/type :answer.type/math :answer/value "-2w" :db/ensure [:answer/validate]} {:db/id "answer-1921ad72-06b3-5698-9761-9f56c676a53d" :answer/id #uuid "1921ad72-06b3-5698-9761-9f56c676a53d" :answer/type :answer.type/math :answer/value "-2‖w‖+9" :db/ensure [:answer/validate]} {:db/id "answer-a3664a5f-20c6-5b00-9b32-cbad35ca0725" :answer/id #uuid "a3664a5f-20c6-5b00-9b32-cbad35ca0725" :answer/type :answer.type/math :answer/value "-4w" :db/ensure [:answer/validate]} {:db/id "answer-1b0777bd-de6e-52e1-9d60-f6cf2eae97e0" :answer/id #uuid "1b0777bd-de6e-52e1-9d60-f6cf2eae97e0" :answer/type :answer.type/math :answer/value "-4‖w‖" :db/ensure [:answer/validate]} {:db/id "answer-a768687d-d635-5983-9f47-0c5bdd3fc76d" :answer/id #uuid "a768687d-d635-5983-9f47-0c5bdd3fc76d" :answer/type :answer.type/math :answer/value "4w+9" :db/ensure [:answer/validate]} {:db/id "question-ec192a53-8b67-53c4-a3ab-2010430980bc" :question/id #uuid "ec192a53-8b67-53c4-a3ab-2010430980bc" :question/math-academy-id "q-349240" :question/problem "Given the function \n\n$$\nf(x,w)=2{w}^{T}x-4‖w{‖}^{2}+8\n$$\n\nthat maps two vectors to a scalar, find ${∇}_{w}f.$" :question/worked-solution "Using the results \n\n$$\n{∇}_{w}({w}^{T}x)=x,\\,{∇}_{w}({w}^{T}w)=2w,\n$$\n\nwe have\n\n$$\n\\begin{aligned}{∇}_{w}f & ={∇}_{w}(2{w}^{T}x-4‖w{‖}^{2}+8) \\\\  & ={∇}_{w}(2{w}^{T}x)-4\\cdot {∇}_{w}(‖w{‖}^{2})+{∇}_{w}(8) \\\\  & =2{∇}_{w}({w}^{T}x)-4\\cdot {∇}_{w}({w}^{T}w)+{∇}_{w}(8) \\\\  & =2x-4\\cdot 2w+0 \\\\  & =2x-8w.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-0862bffe-39e6-5cf0-a879-662c0e59a7b9"] :db/ensure [:question/validate]} {:db/id "answer-field-0862bffe-39e6-5cf0-a879-662c0e59a7b9" :answer-field/id #uuid "0862bffe-39e6-5cf0-a879-662c0e59a7b9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7a78d36b-6081-571b-8e53-0d5774ae9381" :answer-field/choices ["answer-fa69530c-321a-5d3f-990d-d55babb827a9" "answer-835cb165-83ba-5d4d-9d87-061d4bd3bcc7" "answer-7a78d36b-6081-571b-8e53-0d5774ae9381" "answer-8f2c551d-f2ef-551f-8458-885faa6a0933" "answer-fa3ac857-54f1-58f3-920d-1ef816579f84"] :db/ensure [:answer-field/validate]} {:db/id "answer-fa69530c-321a-5d3f-990d-d55babb827a9" :answer/id #uuid "fa69530c-321a-5d3f-990d-d55babb827a9" :answer/type :answer.type/math :answer/value "2x+8w" :db/ensure [:answer/validate]} {:db/id "answer-835cb165-83ba-5d4d-9d87-061d4bd3bcc7" :answer/id #uuid "835cb165-83ba-5d4d-9d87-061d4bd3bcc7" :answer/type :answer.type/math :answer/value "2x-4w" :db/ensure [:answer/validate]} {:db/id "answer-7a78d36b-6081-571b-8e53-0d5774ae9381" :answer/id #uuid "7a78d36b-6081-571b-8e53-0d5774ae9381" :answer/type :answer.type/math :answer/value "2x-8w" :db/ensure [:answer/validate]} {:db/id "answer-8f2c551d-f2ef-551f-8458-885faa6a0933" :answer/id #uuid "8f2c551d-f2ef-551f-8458-885faa6a0933" :answer/type :answer.type/math :answer/value "