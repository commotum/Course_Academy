d.type/radio :answer-field/correct "answer-083c30b1-6494-5f7f-a514-ca4c654a14b8" :answer-field/choices ["answer-083c30b1-6494-5f7f-a514-ca4c654a14b8" "answer-47f56299-6e42-5254-9516-56c603e5c09b" "answer-a8093673-d050-5c58-a366-237171d4a6fb" "answer-c28f8240-f44e-5faa-96ab-53a10a8bcfbf" "answer-935bd9b2-fb76-558f-97bd-419defc9c8dc"] :db/ensure [:answer-field/validate]} {:db/id "answer-083c30b1-6494-5f7f-a514-ca4c654a14b8" :answer/id #uuid "083c30b1-6494-5f7f-a514-ca4c654a14b8" :answer/type :answer.type/math :answer/value "2w" :db/ensure [:answer/validate]} {:db/id "answer-47f56299-6e42-5254-9516-56c603e5c09b" :answer/id #uuid "47f56299-6e42-5254-9516-56c603e5c09b" :answer/type :answer.type/math :answer/value "2‖w‖" :db/ensure [:answer/validate]} {:db/id "answer-a8093673-d050-5c58-a366-237171d4a6fb" :answer/id #uuid "a8093673-d050-5c58-a366-237171d4a6fb" :answer/type :answer.type/math :answer/value "w" :db/ensure [:answer/validate]} {:db/id "answer-c28f8240-f44e-5faa-96ab-53a10a8bcfbf" :answer/id #uuid "c28f8240-f44e-5faa-96ab-53a10a8bcfbf" :answer/type :answer.type/math :answer/value "‖w‖" :db/ensure [:answer/validate]} {:db/id "answer-935bd9b2-fb76-558f-97bd-419defc9c8dc" :answer/id #uuid "935bd9b2-fb76-558f-97bd-419defc9c8dc" :answer/type :answer.type/math :answer/value "‖w‖+5" :db/ensure [:answer/validate]} {:db/id "question-f23dae50-683b-52ff-a0e9-aa781506dfbd" :question/id #uuid "f23dae50-683b-52ff-a0e9-aa781506dfbd" :question/math-academy-id "q-275974" :question/problem "Given the function \n\n$$\nf(w)=-3‖w{‖}_{1}+4{w}^{T}w\n$$\n\nthat maps a vector to a scalar, find ${∇}_{w}f.$ You may assume that $w$ has all nonzero components." :question/worked-solution "Using the results\n\n$$\n{∇}_{w}(‖w{‖}_{1})=\\text{sign}(w),\\,{∇}_{w}({w}^{T}w)=2w,\n$$\n\n we have\n\n$$\n\\begin{aligned}{∇}_{w}f & ={∇}_{w}(-3‖w{‖}_{1}+4{w}^{T}w) \\\\  & ={∇}_{w}(-3‖w{‖}_{1})+{∇}_{w}(4{w}^{T}w) \\\\  & =-3\\cdot {∇}_{w}(‖w{‖}_{1})+4\\cdot {∇}_{w}({w}^{T}w) \\\\  & =-3\\cdot \\text{sign}(w)+4\\cdot 2w \\\\  & =-3\\,\\text{sign}(w)+8w.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-448996fe-7d15-51b5-8f3e-ca1be20c428a"] :db/ensure [:question/validate]} {:db/id "answer-field-448996fe-7d15-51b5-8f3e-ca1be20c428a" :answer-field/id #uuid "448996fe-7d15-51b5-8f3e-ca1be20c428a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8ce8efbb-4e33-5a7e-bf18-9c80b8c4e113" :answer-field/choices ["answer-66ed4cea-665a-5375-a9b4-cee68cc6509c" "answer-1b454009-16d3-573a-8860-b5f66c0e8574" "answer-8ce8efbb-4e33-5a7e-bf18-9c80b8c4e113" "answer-3de5aed6-adb6-5f7e-a8b9-639422fec946" "answer-91ca6108-da53-5c40-95ca-d19493e3631c"] :db/ensure [:answer-field/validate]} {:db/id "answer-66ed4cea-665a-5375-a9b4-cee68cc6509c" :answer/id #uuid "66ed4cea-665a-5375-a9b4-cee68cc6509c" :answer/type :answer.type/math :answer/value "-3\\,\\text{sign}(w)+2{w}^{T}" :db/ensure [:answer/validate]} {:db/id "answer-1b454009-16d3-573a-8860-b5f66c0e8574" :answer/id #uuid "1b454009-16d3-573a-8860-b5f66c0e8574" :answer/type :answer.type/math :answer/value "-3\\,\\text{sign}(w)+4w" :db/ensure [:answer/validate]} {:db/id "answer-8ce8efbb-4e33-5a7e-bf18-9c80b8c4e113" :answer/id #uuid "8ce8efbb-4e33-5a7e-bf18-9c80b8c4e113" :answer/type :answer.type/math :answer/value "-3\\,\\text{sign}(w)+8w" :db/ensure [:answer/validate]} {:db/id "answer-3de5aed6-adb6-5f7e-a8b9-639422fec946" :answer/id #uuid "3de5aed6-adb6-5f7e-a8b9-639422fec946" :answer/type :answer.type/math :answer/value "-3\\,\\text{sign}(w)+8‖w‖" :db/ensure [:answer/validate]} {:db/id "answer-91ca6108-da53-5c40-95ca-d19493e3631c" :answer/id #uuid "91ca6108-da53-5c40-95ca-d19493e3631c" :answer/type :answer.type/math :answer/value "-3‖w{‖}_{1}\\cdot \\text{sign}(w)+8w" :db/ensure [:answer/validate]} {:db/id "question-451c95de-b4df-5e7d-8a76-df474224e7d9" :question/id #uuid "451c95de-b4df-5e7d-8a76-df474224e7d9" :question/math-academy-id "q-265748" :question/problem "Given the function \n\n$$\nf(x,w)=-2(‖w{‖}_{1})^{2}+12\n$$\n\nthat maps a vector to a scalar, find ${∇}_{w}f.$ You may assume that $w$ has all nonzero components." :question/worked-solution "Using the result \n\n$$\n{∇}_{w}(‖w{‖}_{1})=\\text{sign}(w),\n$$\n\n we have\n\n$$\n\\begin{aligned}{∇}_{w}f & ={∇}_{w}(-2(‖w{‖}_{1})^{2}+12) \\\\  & =-2\\cdot {∇}_{w}((‖w{‖}_{1})^{2})+{∇}_{w}(12) \\\\  & =-2\\cdot 2\\cdot ‖w{‖}_{1}\\cdot {∇}_{w}(‖w{‖}_{1})+0 \\\\  & =-4‖w{‖}_{1}\\cdot \\text{sign}(w).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-2fdb0a13-0323-5c3d-8147-f0cc8b8b93ad"] :db/ensure [:question/validate]} {:db/id "answer-field-2fdb0a13-0323-5c3d-8147-f0cc8b8b93ad" :answer-field/id #uuid "2fdb0a13-0323-5c3d-8147-f0cc8b8b93ad" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2e829e7b-f214-5f2c-8bab-217333e0e462" :answer-field/choices ["answer-c3419009-82b8-5a56-8c71-d6f51218a10f" "answer-144ccf48-6329-5906-8c8e-9c5474729581" "answer-2cbfe78c-f7fd-507d-bd4e-94484e22ac4a" "answer-1333e66f-ee53-5cd8-b2dc-06575ef3d9fa" "answer-2e829e7b-f214-5f2c-8bab-217333e0e462"] :db/ensure [:answer-field/validate]} {:db/id "answer-c3419009-82b8-5a56-8c71-d6f51218a10f" :answer/id #uuid "c3419009-82b8-5a56-8c71-d6f51218a10f" :answer/type :answer.type/math :answer/value "-2‖w{‖}_{1}" :db/ensure [:answer/validate]} {:db/id "answer-144ccf48-6329-5906-8c8e-9c5474729581" :answer/id #uuid "144ccf48-6329-5906-8c8e-9c5474729581" :answer/type :answer.type/math :answer/value "-2‖w{‖}_{1}\\cdot \\text{sign}(w)+12" :db/ensure [:answer/validate]} {:db/id "answer-2cbfe78c-f7fd-507d-bd4e-94484e22ac4a" :answer/id #uuid "2cbfe78c-f7fd-507d-bd4e-94484e22ac4a" :answer/type :answer.type/math :answer/value "-4w\\cdot \\text{sign}(w)" :db/ensure [:answer/validate]} {:db/id "answer-1333e66f-ee53-5cd8-b2dc-06575ef3d9fa" :answer/id #uuid "1333e66f-ee53-5cd8-b2dc-06575ef3d9fa" :answer/type :answer.type/math :answer/value "-4‖w{‖}_{1}" :db/ensure [:answer/validate]} {:db/id "answer-2e829e7b-f214-5f2c-8bab-217333e0e462" :answer/id #uuid "2e829e7b-f214-5f2c-8bab-217333e0e462" :answer/type :answer.type/math :answer/value "-4‖w{‖}_{1}\\cdot \\text{sign}(w)" :db/ensure [:answer/validate]} {:db/id "question-f3cf1839-85e6-5f28-8e77-8fe8ed36b0c8" :question/id #uuid "f3cf1839-85e6-5f28-8e77-8fe8ed36b0c8" :question/math-academy-id "q-275977" :question/problem "Given the function \n\n$$\nf(x,w)={(‖w{‖}_{1})}^{3}+{x}^{T}w\n$$\n\nthat maps a vector to a scalar, find ${∇}_{w}f.$ You may assume that $w$ has no zero components." :question/worked-solution "Using the results\n\n$$\n{∇}_{w}(‖w{‖}_{1})=\\text{sign}(w),\\,{∇}_{w}({x}^{T}w)=x,\n$$\n\n we have\n\n$$\n\\begin{aligned}{∇}_{w}f & ={∇}_{w}({(‖w{‖}_{1})}^{3}+{x}^{T}w) \\\\  & ={∇}_{w}({(‖w{‖}_{1})}^{3})+{∇}_{w}({x}^{T}w) \\\\  & =3(‖w{‖}_{1})^{2}\\cdot {∇}_{w}(‖w{‖}_{1})+x \\\\  & =3(‖w{‖}_{1})^{2}\\cdot \\text{sign}(w)+x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-ef08fff4-ecfa-5edc-bb5b-ed9bbba1d2d1"] :db/ensure [:question/validate]} {:db/id "answer-field-ef08fff4-ecfa-5edc-bb5b-ed9bbba1d2d1" :answer-field/id #uuid "ef08fff4-ecfa-5edc-bb5b-ed9bbba1d2d1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9f88b11c-be7f-5d58-a56c-690b422d0e1a" :answer-field/choices ["answer-8ecca018-c680-5d6e-9d18-c2730e726cf6" "answer-b87e4086-52ff-5448-b5b1-c77f2a6b9ebb" "answer-6dadc6ef-3565-5774-b6f1-e9dd00b7fb52" "answer-9f88b11c-be7f-5d58-a56c-690b422d0e1a" "answer-8b60b92c-493b-5f5c-ad3e-ec48ecf8fd8e"] :db/ensure [:answer-field/validate]} {:db/id "answer-8ecca018-c680-5d6e-9d18-c2730e726cf6" :answer/id #uuid "8ecca018-c680-5d6e-9d18-c2730e726cf6" :answer/type :answer.type/math :answer/value "(‖w{‖}_{1})^{2}\\cdot \\text{sign}(w)+w" :db/ensure [:answer/validate]} {:db/id "answer-b87e4086-52ff-5448-b5b1-c77f2a6b9ebb" :answer/id #uuid "b87e4086-52ff-5448-b5b1-c77f2a6b9ebb" :answer/type :answer.type/math :answer/value "(‖w{‖}_{1})^{2}\\cdot \\text{sign}(w)+x" :db/ensure [:answer/validate]} {:db/id "answer-6dadc6ef-3565-5774-b6f1-e9dd00b7fb52" :answer/id #uuid "6dadc6ef-3565-5774-b6f1-e9dd00b7fb52" :answer/type :answer.type/math :answer/value "3(‖w{‖}_{1})^{2}\\cdot \\text{sign}(w)+w" :db/ensure [:answer/validate]} {:db/id "answer-9f88b11c-be7f-5d58-a56c-690b422d0e1a" :answer/id #uuid "9f88b11c-be7f-5d58-a56c-690b422d0e1a" :answer/type :answer.type/math :answer/value "3(‖w{‖}_{1})^{2}\\cdot \\text{sign}(w)+x" :db/ensure [:answer/validate]} {:db/id "answer-8b60b92c-493b-5f5c-ad3e-ec48ecf8fd8e" :answer/id #uuid "8b60b92c-493b-5f5c-ad3e-ec48ecf8fd8e" :answer/type :answer.type/math :answer/value "3(‖w{‖}_{1})^{3}\\cdot \\text{sign}(w)+x" :db/ensure [:answer/validate]} {:db/id "question-cda56dfe-5f02-56af-8d87-05b17e6af869" :question/id #uuid "cda56dfe-5f02-56af-8d87-05b17e6af869" :question/math-academy-id "q-275972" :question/problem "Given the function \n\n$$\nf(w)=(‖w{‖}_{1})^{2}+10\n$$\n\nthat maps a vector to a scalar, find ${∇}_{w}f.$ You may assume that $w$ has all nonzero components." :question/worked-solution "Using the result \n\n$$\n{∇}_{w}(‖w{‖}_{1})=\\text{sign}(w),\n$$\n\n we have\n\n$$\n\\begin{aligned}{∇}_{w}f & ={∇}_{w}((‖w{‖}_{1})^{2}+10) \\\\  & ={∇}_{w}((‖w{‖}_{1})^{2})+{∇}_{w}(10) \\\\  & =2\\cdot ‖w{‖}_{1}\\cdot {∇}_{w}(‖w{‖}_{1})+0 \\\\  & =2‖w{‖}_{1}\\cdot \\text{sign}(w).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b5b6885e-2fea-5aaf-915f-61d38f648513"] :db/ensure [:question/validate]} {:db/id "answer-field-b5b6885e-2fea-5aaf-915f-61d38f648513" :answer-field/id #uuid "b5b6885e-2fea-5aaf-915f-61d38f648513" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-14d7b38f-883c-5d4e-bd60-5c7049a20338" :answer-field/choices ["answer-802161d0-689b-51c0-9330-d566ec3d4fec" "answer-488de03e-e90a-5d4c-8716-750b763c5dab" "answer-14d7b38f-883c-5d4e-bd60-5c7049a20338" "answer-19d015a4-60a1-57c2-a75b-17cb4d27831a" "answer-20743e67-2178-5d45-9d39-2182ade8f59a"] :db/ensure [:answer-field/validate]} {:db/id "answer-802161d0-689b-51c0-9330-d566ec3d4fec" :answer/id #uuid "802161d0-689b-51c0-9330-d566ec3d4fec" :answer/type :answer.type/math :answer/value "2w\\cdot \\text{sign}(w)" :db/ensure [:answer/validate]} {:db/id "answer-488de03e-e90a-5d4c-8716-750b763c5dab" :answer/id #uuid "488de03e-e90a-5d4c-8716-750b763c5dab" :answer/type :answer.type/math :answer/value "2w\\cdot \\text{sign}(w)+10" :db/ensure [:answer/validate]} {:db/id "answer-14d7b38f-883c-5d4e-bd60-5c7049a20338" :answer/id #uuid "14d7b38f-883c-5d4e-bd60-5c7049a20338" :answer/type :answer.type/math :answer/value "2‖w{‖}_{1}\\cdot \\text{sign}(w)" :db/ensure [:answer/validate]} {:db/id "answer-19d015a4-60a1-57c2-a75b-17cb4d27831a" :answer/id #uuid "19d015a4-60a1-57c2-a75b-17cb4d27831a" :answer/type :answer.type/math :answer/value "2‖w{‖}_{1}\\cdot \\text{sign}(w)+10" :db/ensure [:answer/validate]} {:db/id "answer-20743e67-2178-5d45-9d39-2182ade8f59a" :answer/id #uuid "20743e67-2178-5d45-9d39-2182ade8f59a" :answer/type :answer.type/math :answer/value "‖w{‖}_{1}\\cdot \\text{sign}(w)" :db/ensure [:answer/validate]} {:db/id 17592186204592 :question/problem "Given the function \n\n$$\nf(x,w)=4{(‖w{‖}_{1})}^{3}+{x}^{T}w\n$$\n\nthat maps a vector to a scalar, find ${∇}_{w}f.$ You may assume that $w$ has no zero components." :question/worked-solution "Using the results\n\n$$\n{∇}_{w}(‖w{‖}_{1})=\\text{sign}(w),\\,{∇}_{w}({x}^{T}w)=x,\n$$\n\n we have\n\n$$\n\\begin{aligned}{∇}_{w}f & ={∇}_{w}(4{(‖w{‖}_{1})}^{3}+{x}^{T}w) \\\\  & ={∇}_{w}(4{(‖w{‖}_{1})}^{3})+{∇}_{w}({x}^{T}w) \\\\  & =4\\cdot {∇}_{w}({(‖w{‖}_{1})}^{3})+{∇}_{w}({x}^{T}w) \\\\  & =4\\cdot 3(‖w{‖}_{1})^{2}\\cdot {∇}_{w}(‖w{‖}_{1})+x \\\\  & =4\\cdot 3(‖w{‖}_{1})^{2}\\cdot \\text{sign}(w)+x \\\\  & =12(‖w{‖}_{1})^{2}\\cdot \\text{sign}(w)+x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186203467 :answer-field/correct "answer-e4040a0e-21e7-5bae-a634-08b7855b6c92" :answer-field/choices ["answer-080f7321-9bc8-5ade-99cd-67f832dfd7ee" "answer-e4040a0e-21e7-5bae-a634-08b7855b6c92" "answer-55c18f25-6f5e-5d0b-8df7-f3fa1e5f1ef2" "answer-89f6ccba-5549-5421-855d-3dfda87c6847" "answer-ac994e05-1946-5fd8-9faa-6ab8c770a092"] :db/ensure [:answer-field/validate]} {:db/id "answer-080f7321-9bc8-5ade-99cd-67f832dfd7ee" :answer/id #uuid "080f7321-9bc8-5ade-99cd-67f832dfd7ee" :answer/type :answer.type/math :answer/value "12\\,(‖w{‖}_{1})^{2}\\cdot \\text{sign}(w)+w" :db/ensure [:answer/validate]} {:db/id "answer-e4040a0e-21e7-5bae-a634-08b7855b6c92" :answer/id #uuid "e4040a0e-21e7-5bae-a634-08b7855b6c92" :answer/type :answer.type/math :answer/value "12\\,(‖w{‖}_{1})^{2}\\cdot \\text{sign}(w)+x" :db/ensure [:answer/validate]} {:db/id "answer-55c18f25-6f5e-5d0b-8df7-f3fa1e5f1ef2" :answer/id #uuid "55c18f25-6f5e-5d0b-8df7-f3fa1e5f1ef2" :answer/type :answer.type/math :answer/value "12\\,\\text{sign}(w)+2x" :db/ensure [:answer/validate]} {:db/id "answer-89f6ccba-5549-5421-855d-3dfda87c6847" :answer/id #uuid "89f6ccba-5549-5421-855d-3dfda87c6847" :answer/type :answer.type/math :answer/value "12\\,\\text{sign}(w)+w" :db/ensure [:answer/validate]} {:db/id "answer-ac994e05-1946-5fd8-9faa-6ab8c770a092" :answer/id #uuid "ac994e05-1946-5fd8-9faa-6ab8c770a092" :answer/type :answer.type/math :answer/value "6\\,\\text{sign}(w)+x" :db/ensure [:answer/validate]} {:db/id 17592186205178 :tutorial/content "In this lesson, we'll extend our knowledge of gradients of scalar-valued functions.\n\nRecall that, for a function $f: \\mathbb{R}^n \\to \\mathbb{R}$ that maps a vector $\\mathbf{x} \\in \\mathbb{R}^n$ to a scalar value $f(\\mathbf{x})$, the *gradient* of $f$ with respect to $\\mathbf{x}$ is defined as the column vector of partial derivatives:\n\n![](images/4b/4ba97eb3ffac5de1b569716f0ccaa648749248b62e4918c641f93de84b52b61d.svg)\n\n**Note:** Some resources use $\\dfrac{\\partial f}{\\partial \\mathbf x}$ to denote the gradient. We shall avoid this notation.\n\nRecall that the *total derivative* of a scalar function $f: \\mathbb{R}^n \\to \\mathbb{R}$ with respect to a vector $\\mathbf{x} \\in \\mathbb{R}^n$ is the row vector\n\n![](images/9b/9b02d1184f009b66095b1bfd9be6d4d0f29aeb41a0ba08469b404ffc8ca6e88d.svg)\n\nHence, the gradient is simply the transpose of the total derivative:\n\n$$\n\\nabla f(\\mathbf{x}) = \\left( \\frac{\\textrm{d} f}{\\textrm{d} \\mathbf{x}} \\right)^T\n$$\n\nWe'll now discuss some important results related to gradients widely used in machine learning applications.\n\nLet's see an example." :db/ensure [:tutorial/validate]} {:db/id 17592186205179 :tutorial/content "Let’s derive a general rule for the gradient of a linear function.\n\nSuppose $\\mathbf{x} \\in \\mathbb{R}^n,$ and the scalar function $f$ is given by\n\n$$\nf(\\mathbf{x}) = \\mathbf{b}^T \\mathbf{x},\n$$\n\nwhere $\\mathbf{b} \\in \\mathbb{R}^n$ is a fixed vector. \n\nWe wish to find an expression for the gradient of $f.$\n\n$$\n\\nabla_{\\mathbf{x}} f = \\nabla_{\\mathbf{x}} (\\mathbf{b}^T \\mathbf{x})\n$$\n\nTo do this, let's write our vectors $\\mathbf b$ and $\\mathbf x$ explicitly:\n\n![](images/8a/8a824abda10928a55f4efd94f7c0e4bff0dabf13fc44b789ed53e829971c3471.svg)\n\nThen, $\\mathbf b^T \\mathbf x$ is the scalar function\n\n$$\n\\begin{aligned}{b}^{T}x & =[\\begin{aligned}{b}_{1} & {b}_{2} & … & {b}_{n}\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]\\end{aligned}\n$$\n\nwhich simplifies as\n\n$$\n\\mathbf b^T \\mathbf x\n=b_1x_1+ b_2x_2 + \\cdots + b_nx_n.\n$$\n\nThe partial derivative of $\\mathbf b^T \\mathbf x$ with respect to $x_i$ is $b_i,$ since all the other terms will vanish. \n\n$$\n\\dfrac{\\partial}{\\partial x_i}\\left(\\mathbf b^T\\mathbf x\\right) = \\dfrac{\\partial}{\\partial x_i}\\left(b_1x_1+ b_2x_2 + \\cdots + b_i x_i + \\cdots + b_nx_n\\right) = b_i\n$$\n\nSince this is true for all $1\\leq i\\leq n,$ we have\n\n$$\n\\nabla_{\\mathbf x} \\left(\\mathbf b^T \\mathbf x\\right) = \\mathbf b\n$$\n\nas required.\n\nThis is the multivariable analog of the familiar rule from single-variable calculus:\n\n$$\n\\frac{\\textrm d}{\\textrm dx}(a x) = a\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186205200 :tutorial/content "We have the following result:\n\n$$\n\\nabla_{\\mathbf w} \\left(\\mathbf w^T \\mathbf w\\right) = 2\\mathbf w\n$$\n\nThis result is analogous to the following result from single-variable calculus:\n\n$$\n\\dfrac{\\textrm d}{\\textrm d w}(w^2) = 2w\n$$\n\nTo see why this is true, let $\\mathbf w \\in\\mathbb R^n$ be given by\n![](images/ab/abacc87863d62c768803174901464f57748f1488c3518a25cefc06a411ab31f9.svg)\n\nThen, $\\mathbf w^T \\mathbf w$ is the *scalar* function\n\n$$\n\\begin{aligned}{w}^{T}w & =[\\begin{aligned}{w}_{1} & {w}_{2} & … & {w}_{n}\\end{aligned}][\\begin{aligned}{w}_{1} \\\\ {w}_{2} \\\\ ⋮ \\\\ {w}_{n}\\end{aligned}]\\end{aligned}\n$$\n\nwhich can be written as\n\n$$\n\\mathbf w^T \\mathbf w\n=w_1^2+ w_2^2 + \\cdots + w_n^2.\n$$\n\nThe partial derivative of $\\mathbf w^T \\mathbf w$ with respect to $w_i$ is $2w_i,$ since all the other terms will vanish. Since this is true for all $1\\leq i\\leq n,$ we have\n\n$$\n\\nabla_{\\mathbf w} \\left(\\mathbf w^T \\mathbf w\\right) = 2\\mathbf w\n$$\n\nas required.\n\nFinally, note that since\n\n$$\n\\mathbf w^T \\mathbf w = ||\\mathbf w ||^2\n$$\n\nwe have the following equivalent result:\n\n$$\n\\nabla_{\\mathbf w}(||\\mathbf w ||^2) = 2\\mathbf w\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186205194 :tutorial/content "Consider the $\\textrm{L}_1$ (Manhattan) norm of a vector $\\mathbf{x} \\in \\mathbb{R}^n$, defined as\n\n$$\n\\|\\mathbf{x}\\|_1 = \\sum_{i=1}^n |x_i|.\n$$\n\nWe want to compute the gradient of this function with respect to $\\mathbf{x}$. To do that, let’s focus on finding the partial derivative with respect to a single component $x_k{:}$\n\n$$\n\\begin{aligned}\\frac{∂‖x{‖}_{1}}{∂{x}_{k}} & =\\frac{∂}{∂{x}_{k}}{\\sum }_{i=1}^{n}|{x}_{i}| \\\\  & =\\frac{∂}{∂{x}_{k}}(|{x}_{1}|+|{x}_{2}|+⋯+|{x}_{k}|+⋯+|{x}_{n}|) \\\\  & =\\frac{∂|{x}_{1}|}{∂{x}_{k}}+\\frac{∂|{x}_{2}|}{∂{x}_{k}}+⋯+\\frac{∂|{x}_{k}|}{∂{x}_{k}}+⋯+\\frac{∂|{x}_{n}|}{∂{x}_{k}} \\\\  & =\\frac{∂|{x}_{k}|}{∂{x}_{k}} \\\\  & =\\text{sign}({x}_{k}),\\end{aligned}\n$$\n\nwhere $\\text{sign}(x_k)$ is defined as\n\n![](images/88/88b4650c41c9ab38ea82851481ed720821ad7f93bfeac56a93d70effe680f230.svg)\n\nSo, the full gradient of the $\\textrm{L}_1$ norm is simply\n\n$$\n\\nabla_{\\mathbf{x}} \\|\\mathbf{x}\\|_1 = \\text{sign}(\\mathbf{x}),\n$$\n\nwhich is a vector whose $k$th component is $\\text{sign}(x_k)$. \n\nThe gradient of $\\|\\mathbf x\\|_1$ is not defined at points where any component of $\\mathbf x$ equals zero. This is because the absolute value function has a sharp corner at zero and is therefore not differentiable there. Various methods are available to overcome this difficulty when the derivative of the $\\textrm L1$ norm is used in practice, and we'll discuss these in future lessons." :db/ensure [:tutorial/validate]} {:db/id 17592186205219 :tutorial/content "In many machine learning models, a scalar function depends on a vector that itself depends on another vector.\n\nSuppose $f:\\mathbb{R}^m \\to \\mathbb{R}$ and $\\mathbf g:\\mathbb{R}^n \\to \\mathbb{R}^m,$ and define\n\n$$\nh(\\mathbf x)=f(\\mathbf g(\\mathbf x)).\n$$\n\nThen the **chain rule for gradients** states:\n\n$$\n\\nabla_{\\mathbf x} h(\\mathbf x)\n=\nJ_{\\mathbf g}(\\mathbf x)^T\n\\,\\nabla_{\\mathbf u} f(\\mathbf u)\\Big|_{\\mathbf u=\\mathbf g(\\mathbf x)},\n$$\n\nwhere $J_{\\mathbf g}(\\mathbf x)$ is the Jacobian of $\\mathbf g.$\n\nIn other words, we have  \n\n$$\n\\bigg(\\substack{\\Large \\text{Gradient of} \\[3pt] \\Large\\text{composition}}\\bigg)   \n= \\bigg(\\substack{\\Large \\text{Jacobian of} \\[3pt] \\Large\\text{the inner function}}\\bigg)^T \n\\cdot \\:\\:\n\\bigg(\\substack{\\Large \\text{Gradient of} \\[3pt] \\Large\\text{the outer function}}\\bigg).\n$$\n\nLet’s see this in action." :db/ensure [:tutorial/validate]} {:db/id 17592186204175 :activity/expected-seconds 540.0 :db/ensure [:activity/validate]}] "assertions" [[17592186203856 :question/problem "Compute the gradient of the function $f: \\mathbb{R}^4 \\rightarrow \\mathbb{R}$ defined by ![](images/47/471a898dd8e3dca3d9e0b077a135ac794ef58293dafa33703d23490dd92d12b6.svg) with respect to $\\mathbf{x}$ at ![](images/55/552dda7785a5e118e9ff3afa9bf7e7201e7d3be7454e7e380c42946d60506f31.svg)"] [17592186203856 :question/worked-solution "Writing ![](images/e0/e0ec0bd3b3ed1126735e229d153c206900bdff443354b04700379343ab15e876.svg), we have\n\n$$\nf(\\mathbf{x})= \\mathbf{b}^T\\mathbf{x}.\n$$\n\nThe gradient of a function $f(x) = \\mathbf{b}^T\\mathbf{x}$ with respect to $\\mathbf{x} \\in \\mathbb{R}^n$ is\n\n$$\n\\nabla_{\\mathbf{x}} f(\\mathbf{x}) = \\mathbf{b}.\n$$\n\nTherefore, we get\n![](images/4f/4f11665969b8a11e45fe97ef4f3add0115b365642e92e21172e2245e61147f31.svg)"] [17592186203864 :question/problem "Given the function \n\n$$\nf(\\mathbf{x}, \\mathbf{w}) = -7\\mathbf{w}^T\\mathbf{x} + 3\\|\\mathbf{w}\\|^2 - 2\n$$\n\nthat maps two vectors to a scalar, find $\\nabla_{\\mathbf w} f .$"] [17592186203864 :question/worked-solution "Using the results \n\n$$\n\\nabla_{\\mathbf w}(\\mathbf{w}^T\\mathbf{x}) = \\mathbf{x}, \\qquad \\nabla_{\\mathbf w} (\\mathbf{w}^T\\mathbf{w}) = 2\\mathbf{w},\n$$\n\n \nwe have\n\n$$\n\\begin{aligned}{∇}_{w}f & ={∇}_{w}(-7{w}^{T}x+3‖w{‖}^{2}-2) \\\\  & =-7\\cdot {∇}_{w}({w}^{T}x)+3\\cdot {∇}_{w}(‖w{‖}^{2})-{∇}_{w}(2) \\\\  & =-7\\cdot {∇}_{w}({w}^{T}x)+3\\cdot {∇}_{w}({w}^{T}w)-{∇}_{w}(2) \\\\  & =-7\\cdot x+3\\cdot 2w-0 \\\\  & =-7x+6w.\\end{aligned}\n$$"] [17592186203874 :question/problem "Given the function \n\n$$\nf(\\mathbf{x}, \\mathbf{w}) = -3\\left(\\|\\mathbf{w}\\|_1\\right)^3  - 5\\mathbf x^T\\mathbf w\n$$\n\nthat maps a vector to a scalar, find $\\nabla_{\\mathbf w}f.$ You may assume that $\\mathbf w$ has no zero components."] [17592186203874 :question/worked-solution "Using the results\n\n$$\n\\nabla_{\\mathbf w} (\\|\\mathbf{w}\\|_1) = \\text{sign}(\\mathbf{w}), \\qquad \\nabla_{\\mathbf w}\\left(\\mathbf x^T\\mathbf w\\right) = \\mathbf x,\n$$\n\n we have\n\n$$\n\\begin{aligned}{∇}_{w}f & ={∇}_{w}(-3{(‖w{‖}_{1})}^{3}-5{x}^{T}w) \\\\  & ={∇}_{w}(-3{(‖w{‖}_{1})}^{3})-{∇}_{w}(5{x}^{T}w) \\\\  & =-3\\cdot {∇}_{w}({(‖w{‖}_{1})}^{3})-5\\cdot {∇}_{w}({x}^{T}w) \\\\  & =-3\\cdot 3(‖w{‖}_{1})^{2}\\cdot {∇}_{w}(‖w{‖}_{1})-5\\cdot x \\\\  & =-3\\cdot 3(‖w{‖}_{1})^{2}\\cdot \\text{sign}(w)-5\\cdot x \\\\  & =-9(‖w{‖}_{1})^{2}\\cdot \\text{sign}(w)-5x.\\end{aligned}\n$$"] ["question-02680e0f-01a2-5039-ae5b-662f20597c66" :question/id #uuid "02680e0f-01a2-5039-ae5b-662f20597c66"] ["question-02680e0f-01a2-5039-ae5b-662f20597c66" :question/math-academy-id "q-265756"] ["question-02680e0f-01a2-5039-ae5b-662f20597c66" :question/problem "Compute the gradient of the function $f:{R}^{4}\\to R$ defined by \n\n$$\nf(x)=[\\begin{aligned}-1 & 0 & 1 & -1\\end{aligned}]\\cdot x\n$$\n\n with respect to $x$ at $x=[\\begin{aligned}2 \\\\ 3 \\\\ -1 \\\\ 0\\end{aligned}].$"] ["question-02680e0f-01a2-5039-ae5b-662f20597c66" :question/worked-solution "Writing $b=[\\begin{aligned}-1 \\\\ 0 \\\\ 1 \\\\ -1\\end{aligned}]$, we have\n\n$$\nf(x)={b}^{T}x.\n$$\n\nThe gradient of a function $f(x)={b}^{T}x$ with respect to $x\\in {R}^{n}$ is\n\n$$\n{∇}_{x}f(x)=b.\n$$\n\nTherefore, we get\n\n$$\n{∇}_{x}f(x)=b=[\\begin{aligned}-1 \\\\ 0 \\\\ 1 \\\\ -1\\end{aligned}].\n$$"] ["question-02680e0f-01a2-5039-ae5b-662f20597c66" :question/difficulty :question.difficulty/easy] ["answer-field-c3c062f6-4f73-5b8e-a6b1-c784680f1423" :answer-field/id #uuid "c3c062f6-4f73-5b8e-a6b1-c784680f1423"] ["answer-b68286b5-2fee-590c-b122-56aab19b9484" :answer/id #uuid "b68286b5-2fee-590c-b122-56aab19b9484"] ["answer-b68286b5-2fee-590c-b122-56aab19b9484" :answer/type :answer.type/math] ["answer-b68286b5-2fee-590c-b122-56aab19b9484" :answer/value "-3"] ["answer-4a56765c-1fb2-5ac9-b03c-6b91b632cf07" :answer/id #uuid "4a56765c-1fb2-5ac9-b03c-6b91b632cf07"] ["answer-4a56765c-1fb2-5ac9-b03c-6b91b632cf07" :answer/type :answer.type/math] ["answer-4a56765c-1fb2-5ac9-b03c-6b91b632cf07" :answer/value "0"] ["answer-cd675729-57e9-5d57-88d8-c335295910eb" :answer/id #uuid "cd675729-57e9-5d57-88d8-c335295910eb"] ["answer-cd675729-57e9-5d57-88d8-c335295910eb" :answer/type :answer.type/math] ["answer-cd675729-57e9-5d57-88d8-c335295910eb" :answer/value "[\\begin{aligned}-1 \\\\ 0 \\\\ 1 \\\\ -1\\end{aligned}]"] ["answer-5fa819ef-a851-5a01-9e84-7de7cf518f92" :answer/id #uuid "5fa819ef-a851-5a01-9e84-7de7cf518f92"] ["answer-5fa819ef-a851-5a01-9e84-7de7cf518f92" :answer/type :answer.type/math] ["answer-5fa819ef-a851-5a01-9e84-7de7cf518f92" :answer/value "[\\begin{aligned}0 \\\\ 0 \\\\ -1 \\\\ 0\\end{aligned}]"] ["answer-6cc262f1-2338-53de-80e9-d98a45c66d7e" :answer/id #uuid "6cc262f1-2338-53de-80e9-d98a45c66d7e"] ["answer-6cc262f1-2338-53de-80e9-d98a45c66d7e" :answer/type :answer.type/math] ["answer-6cc262f1-2338-53de-80e9-d98a45c66d7e" :answer/value "[\\begin{aligned}2 \\\\ 3 \\\\ -1 \\\\ 0\\end{aligned}]"] ["answer-field-c3c062f6-4f73-5b8e-a6b1-c784680f1423" :answer-field/key "selection"] ["answer-field-c3c062f6-4f73-5b8e-a6b1-c784680f1423" :answer-field/type :answer-field.type/radio] ["answer-field-c3c062f6-4f73-5b8e-a6b1-c784680f1423" :answer-field/correct "answer-cd675729-57e9-5d57-88d8-c335295910eb"] ["answer-field-c3c062f6-4f73-5b8e-a6b1-c784680f1423" :answer-field/choices "answer-b68286b5-2fee-590c-b122-56aab19b9484"] ["answer-field-c3c062f6-4f73-5b8e-a6b1-c784680f1423" :answer-field/choices "answer-4a56765c-1fb2-5ac9-b03c-6b91b632cf07"] ["answer-field-c3c062f6-4f73-5b8e-a6b1-c784680f1423" :answer-field/choices "answer-cd675729-57e9-5d57-88d8-c335295910eb"] ["answer-field-c3c062f6-4f73-5b8e-a6b1-c784680f1423" :answer-field/choices "answer-5fa819ef-a851-5a01-9e84-7de7cf518f92"] ["answer-field-c3c062f6-4f73-5b8e-a6b1-c784680f1423" :answer-field/choices "answer-6cc262f1-2338-53de-80e9-d98a45c66d7e"] ["question-02680e0f-01a2-5039-ae5b-662f20597c66" :question/answer-fields "answer-field-c3c062f6-4f73-5b8e-a6b1-c784680f1423"] [17592186204102 :knowledge-point/questions "question-02680e0f-01a2-5039-ae5b-662f20597c66"] ["question-7bcd4936-683c-5a30-8d4e-a52d39fd01ec" :question/id #uuid "7bcd4936-683c-5a30-8d4e-a52d39fd01ec"] ["question-7bcd4936-683c-5a30-8d4e-a52d39fd01ec" :question/math-academy-id "q-265759"] ["question-7bcd4936-683c-5a30-8d4e-a52d39fd01ec" :question/problem "Compute the gradient of the function $f:{R}^{4}\\to R$ defined by \n\n$$\nf(x)=[\\begin{aligned}1 & -2 & 3 & -4\\end{aligned}]\\cdot x\n$$\n\n with respect to $x$ at $x=[\\begin{aligned}1 \\\\ 1 \\\\ 1 \\\\ 1\\end{aligned}].$"] ["question-7bcd4936-683c-5a30-8d4e-a52d39fd01ec" :question/worked-solution "Writing $b=[\\begin{aligned}1 \\\\ -2 \\\\ 3 \\\\ -4\\end{aligned}]$, we have\n\n$$\nf(x)={b}^{T}x.\n$$\n\nThe gradient of a function $f(x)={b}^{T}x$ with respect to $x\\in {R}^{n}$ is\n\n$$\n{∇}_{x}f(x)=b.\n$$\n\nTherefore, we get\n\n$$\n{∇}_{x}f(x)=b=[\\begin{aligned}1 \\\\ -2 \\\\ 3 \\\\ -4\\end{aligned}].\n$$"] ["question-7bcd4936-683c-5a30-8d4e-a52d39fd01ec" :question/difficulty :question.difficulty/easy] ["answer-field-4d0e16d2-5532-54aa-a176-c00276ff2a6b" :answer-field/id #uuid "4d0e16d2-5532-54aa-a176-c00276ff2a6b"] ["answer-98a357d1-417a-56f0-84a8-27daff050492" :answer/id #uuid "98a357d1-417a-56f0-84a8-27daff050492"] ["answer-98a357d1-417a-56f0-84a8-27daff050492" :answer/type :answer.type/math] ["answer-98a357d1-417a-56f0-84a8-27daff050492" :answer/value "0"] ["answer-97f4111d-e21a-5f23-9e08-7a5877626445" :answer/id #uuid "97f4111d-e21a-5f23-9e08-7a5877626445"] ["answer