 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467547}] :answer-field/correct {:answer/id #uuid "a49d1e0b-d87d-5990-9f1d-19472bb6081c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467547} :answer-field/id #uuid "e5dbf19f-117b-5de5-8d38-1828f362ece6" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468494}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7f48e886-80d4-5268-94be-6547f7232323" :question/math-academy-id "q-42957" :question/problem "$$\nA=[\\begin{aligned}2 & 0 & 5 & -1 \\\\ 4 & 0 & 10 & 2 \\\\ 2 & 0 & 5 & -1 \\\\ 1 & 0 & 1 & 0\\end{aligned}]\n$$\n\nConsider the matrix given above. Identify **all** of the reasons why one can conclude that $|A|=0?$\n- **I.** $A$ has identical columns\n- **II.** $A$ has a zero column\n- **III.** $A$ has identical rows\n\nSelect all that apply." :question/worked-solution "Let's examine each of the statements in turn.\n\n- $A$ does *not* have identical columns.\n\n- $A$ has a zero column: \n\n$$\nA=[\\begin{aligned}2 & 0 & 5 & -1 \\\\ 4 & 0 & 10 & 2 \\\\ 2 & 0 & 5 & -1 \\\\ 1 & 0 & 1 & 0\\end{aligned}]\\,✓\n$$\n\n- $A$ has identical rows: \n\n$$\nA=[\\begin{aligned}2 & 0 & 5 & -1 \\\\ 4 & 0 & 10 & 2 \\\\ 2 & 0 & 5 & -1 \\\\ 1 & 0 & 1 & 0\\end{aligned}].\\,✓\n$$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186134408 :knowledge-point/_questions [{:db/id #edb/ref 17592186133911 :knowledge-point/id #uuid "28142e26-f6c7-54c9-9c16-035c75f7659f" :knowledge-point/title "Calculating the Determinant of a Matrix With A Zero Row/Column or Two Identical Rows/Columns"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "025d4fe7-912b-5dd2-9e59-0f9e27e42564" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$|A|$ only" :db/id #edb/ref 17592186326959} {:answer/id #uuid "0b78b8cf-6e3b-5e97-89b9-e4607f53b9c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$|A|$ and $|B|$ only" :db/id #edb/ref 17592186327035} {:answer/id #uuid "68941b7c-87c5-5d4d-a0c5-f9192e02ec8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$|B|$ only" :db/id #edb/ref 17592186327836} {:answer/id #uuid "9231df0a-ccd7-5f2a-9501-f2efeb7f0ccf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$|A|$, $|B|$, and $|C|$" :db/id #edb/ref 17592186328205} {:answer/id #uuid "dcc18135-f248-5156-83fe-02e74da6694d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$|A|$ and $|C|$ only" :db/id #edb/ref 17592186328862}] :answer-field/correct {:answer/id #uuid "dcc18135-f248-5156-83fe-02e74da6694d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$|A|$ and $|C|$ only" :db/id #edb/ref 17592186328862} :answer-field/id #uuid "a1401c3e-df25-5867-8647-15f11560a136" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329457}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bf123fc4-eb0a-5072-9e49-491e1d68008c" :question/math-academy-id "q-42959" :question/problem "Which of the following determinants are equal to $0?$\n\n$$\n|A|=|\\begin{aligned}2 & 0 & 1 \\\\ \\sqrt{5} & 0 & 4 \\\\ -1 & 0 & 0\\end{aligned}|,\\,|B|=|\\begin{aligned}3 & 0 & 0 \\\\ 0 & -1 & 0 \\\\ 0 & 0 & 5\\end{aligned}|,\\,|C|=|\\begin{aligned}4 & \\sqrt{3} & 4 \\\\ 2 & 4 & 2 \\\\ 1 & \\sqrt{5} & 1\\end{aligned}|\n$$" :question/worked-solution "Let's examine each of the given determinants in turn.\n\n- The matrix $A$ has a zero column: \n\n$$\nA=[\\begin{aligned}2 & 0 & 1 \\\\ \\sqrt{5} & 0 & 4 \\\\ -1 & 0 & 0\\end{aligned}]\n$$\n\nAs a result, $|A|=0.$\n\n- Since $B$ is a diagonal matrix, we obtain \n\n$$\n|B|=3\\cdot (-1)\\cdot 5=-15\\ne 0.\n$$\n\n- The matrix $C$ has identical columns: \n\n$$\nC=[\\begin{aligned}4 & \\sqrt{3} & 4 \\\\ 2 & 4 & 2 \\\\ 1 & \\sqrt{5} & 1\\end{aligned}]\n$$\n\nAs a result, $|C|=0.$\n\nTherefore, only $|A|$ and $|C|$ are equal to $0.$"}] [{:db/id #edb/ref 17592186402861 :knowledge-point/_questions [{:db/id #edb/ref 17592186133912 :knowledge-point/id #uuid "8aef330a-81b3-56c4-9559-67df673e8687" :knowledge-point/title "Calculating the Determinant of a Matrix With Two Proportional Rows/Columns"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "78b84216-c188-5769-a0cf-2f3c4b5d4fe1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$|B|$ only" :db/id #edb/ref 17592186402863} {:answer/id #uuid "47a2ba38-2156-5dd9-922d-70e7a9112796" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$|A|$ and $|C|$ only" :db/id #edb/ref 17592186402864} {:answer/id #uuid "bf232768-62b0-5a99-b6ae-c2f1d1ac4e96" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$|C|$ only" :db/id #edb/ref 17592186402865} {:answer/id #uuid "5c171a58-43ca-5ac8-896f-be2e38df60c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$|A|$ only" :db/id #edb/ref 17592186402866} {:answer/id #uuid "75bb085b-9153-5df0-9e32-3ce23b5de8fb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$|A|$ and $|B|$ only" :db/id #edb/ref 17592186402867}] :answer-field/correct {:answer/id #uuid "78b84216-c188-5769-a0cf-2f3c4b5d4fe1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$|B|$ only" :db/id #edb/ref 17592186402863} :answer-field/id #uuid "a4619bd4-0fd6-5b0e-85d8-4d713cc4997e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402862}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b44f28c6-ca93-5246-be2b-1a2725d36e07" :question/math-academy-id "q-43057" :question/problem "Which of the following determinants are equal to $0?$\n\n$$\n|A|=|\\begin{aligned}3 & 0 & 0 \\\\ \\sqrt{3} & -6 & 0 \\\\ \\sqrt{5} & 8 & 2\\end{aligned}|,\\,|B|=|\\begin{aligned}1 & \\sqrt{2} & 4 \\\\ 2 & 2\\sqrt{2} & 8 \\\\ 0 & -\\sqrt{3} & 4\\end{aligned}|,\\,|C|=|\\begin{aligned}-1 & \\sqrt{3} & 4 \\\\ 0 & 3 & \\sqrt{3} \\\\ 0 & 0 & 4\\end{aligned}|.\n$$" :question/worked-solution "Let's examine each of the given determinants in turn.\n\n- The matrix $A$ is a triangular matrix, hence \n\n$$\n|A|=3\\cdot (-6)\\cdot 2=-36\\ne 0.\n$$\n\n- The matrix $B$ has proportional rows: \n\n$$\nB=[\\begin{aligned}1 & \\sqrt{2} & 4 \\\\ 2 & 2\\sqrt{2} & 8 \\\\ 0 & -\\sqrt{3} & 4\\end{aligned}]\n$$\n\nAs a result, $|B|=0.$\n\n- The matrix $C$ is a triangular matrix, hence \n\n$$\n|C|=(-1)\\cdot 3\\cdot 4=-12\\ne 0\n$$\n\nTherefore, only $|B|$ is equal to $0.$"}] [{:db/id #edb/ref 17592186402868 :knowledge-point/_questions [{:db/id #edb/ref 17592186133912 :knowledge-point/id #uuid "8aef330a-81b3-56c4-9559-67df673e8687" :knowledge-point/title "Calculating the Determinant of a Matrix With Two Proportional Rows/Columns"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "665b8959-619e-56ef-8580-a1cb1e4b9558" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$|B|$ and $|C|$ only" :db/id #edb/ref 17592186402870} {:answer/id #uuid "64b8f243-2c7b-510f-ba0f-db94cf33bd62" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$|A|$ and $|C|$ only" :db/id #edb/ref 17592186402871} {:answer/id #uuid "d613850c-c563-547d-bf3d-1ebbc2fd8f08" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$|C|$ only" :db/id #edb/ref 17592186402872} {:answer/id #uuid "0b3fe8ae-8e1d-511a-9447-a62e0e89b0d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$|A|$ only" :db/id #edb/ref 17592186402873} {:answer/id #uuid "c240e8d0-5ba7-5ba9-9558-ad9c553e554b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$|A|$ and $|B|$ only" :db/id #edb/ref 17592186402874}] :answer-field/correct {:answer/id #uuid "64b8f243-2c7b-510f-ba0f-db94cf33bd62" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$|A|$ and $|C|$ only" :db/id #edb/ref 17592186402871} :answer-field/id #uuid "2d0cbd0e-5f98-5252-aa48-893e93a173fa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402869}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "56c75f73-8006-5c39-8150-6ad119a3d555" :question/math-academy-id "q-43058" :question/problem "Which of the following determinants are equal to $0?$\n\n$$\n|A|=|\\begin{aligned}\\sqrt{3} & 5 & -1 \\\\ 4 & -3 & 8 \\\\ 0 & 0 & 0\\end{aligned}|,\\,|B|=|\\begin{aligned}2 & 0 & 0 \\\\ 2 & -5 & 0 \\\\ 1 & -\\sqrt{3} & 4\\end{aligned}|,\\,|C|=|\\begin{aligned}-2 & 4 & -1 \\\\ 6 & \\sqrt{3} & 3 \\\\ -4 & \\sqrt{7} & -2\\end{aligned}|.\n$$" :question/worked-solution "Let's examine each of the given determinants in turn.\n\n- The matrix $A$ has a zero row: \n\n$$\nA=[\\begin{aligned}\\sqrt{3} & 5 & -1 \\\\ 4 & -3 & 8 \\\\ 0 & 0 & 0\\end{aligned}]\n$$\n\nAs a result, $|A|=0.$\n\n- The matrix $B$ is a triangular matrix, hence \n\n$$\n|B|=2\\cdot (-5)\\cdot 4=-40\\ne 0.\n$$\n\n- The matrix $C$ has proportional columns: \n\n$$\nC=[\\begin{aligned}-2 & 4 & -1 \\\\ 6 & \\sqrt{3} & 3 \\\\ -4 & \\sqrt{7} & -2\\end{aligned}]\n$$\n\nAs a result, $|C|=0.$\n\nTherefore, only $|A|$ and $|C|$ are equal to $0.$"}] [{:db/id #edb/ref 17592186420352 :knowledge-point/_questions [{:db/id #edb/ref 17592186133911 :knowledge-point/id #uuid "28142e26-f6c7-54c9-9c16-035c75f7659f" :knowledge-point/title "Calculating the Determinant of a Matrix With A Zero Row/Column or Two Identical Rows/Columns"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52a1dbcb-127d-567f-b362-0ca0b1d54e42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186420338} {:answer/id #uuid "748fa6b4-08c9-57b1-9c5f-ace131b66c19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\sqrt{3}" :db/id #edb/ref 17592186420342} {:answer/id #uuid "76cec32a-c27c-5e6c-94e2-bb27825747c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186420343} {:answer/id #uuid "b70ba875-07c9-5c3f-85df-154df641f91f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186420345} {:answer/id #uuid "ec20d6e5-b2d8-5e04-b68d-e1fd68f53231" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\sqrt{3}" :db/id #edb/ref 17592186420347}] :answer-field/correct {:answer/id #uuid "b70ba875-07c9-5c3f-85df-154df641f91f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186420345} :answer-field/id #uuid "ff922856-e3c4-5b40-8d0e-cd85fae942ae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186420350}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "89fae1b5-1405-51b4-b87d-75b6acbbdc2e" :question/math-academy-id "q-82192" :question/problem "Find $7det(A)-2det(B)$, where \n\n$$\nA=[\\begin{aligned}1 & -1 & 2 & -1 \\\\ 0 & 3 & -1 & 3 \\\\ -1 & 0 & 3 & 0 \\\\ 5 & 1 & 3 & 1\\end{aligned}],\\,B=[\\begin{aligned}3 & 0 & 0 & 0 \\\\ 1 & -1 & 0 & 0 \\\\ \\sqrt{3} & 0 & 1 & 0 \\\\ 1 & 2 & -0.5 & 2\\end{aligned}].\n$$" :question/worked-solution "Let's examine each matrix in turn.\n\n- Since $A$ has two identical columns, we obtain\n\n$$\nA=[\\begin{aligned}1 & -1 & 2 & -1 \\\\ 0 & 3 & -1 & 3 \\\\ -1 & 0 & 3 & 0 \\\\ 5 & 1 & 3 & 1\\end{aligned}]\\,⟹\\,det(A)=0.\n$$\n\n- Since $B$ is a triangular matrix, its determinant is given by the product of the elements of the main diagonal: \n\n$$\ndet(B)=3\\cdot (-1)\\cdot 1\\cdot 2=-6\n$$\n\nTherefore, $7det(A)-2det(B)=7\\cdot 0-2\\cdot (-6)=12.$"}] [{:db/id #edb/ref 17592186484278 :knowledge-point/_questions [{:db/id #edb/ref 17592186133911 :knowledge-point/id #uuid "28142e26-f6c7-54c9-9c16-035c75f7659f" :knowledge-point/title "Calculating the Determinant of a Matrix With A Zero Row/Column or Two Identical Rows/Columns"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1567e615-6ab4-5dfa-a4ee-bb5f68553e0c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$|B|$ only" :db/id #edb/ref 17592186483603} {:answer/id #uuid "a382ca9c-09f6-5fe7-ae8f-109968b53e3e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$|B|$ and $|C|$ only" :db/id #edb/ref 17592186483903} {:answer/id #uuid "b4309380-2eb3-5ecd-b864-93456f98633e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$|A|$ and $|B|$" :db/id #edb/ref 17592186483925} {:answer/id #uuid "cda12a20-ad57-5314-886c-4677c2cad21f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$|A|$ and $|C|$" :db/id #edb/ref 17592186483979} {:answer/id #uuid "ea65d58a-0ecc-516b-bd6b-912a169e765a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$|C|$ only" :db/id #edb/ref 17592186484030}] :answer-field/correct {:answer/id #uuid "a382ca9c-09f6-5fe7-ae8f-109968b53e3e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$|B|$ and $|C|$ only" :db/id #edb/ref 17592186483903} :answer-field/id #uuid "a79e0fe4-97d1-5338-b5f9-fcb08969416e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186484165}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cf8a8a57-6cfe-5981-b026-15b496e6e0d3" :question/math-academy-id "q-82193" :question/problem "Which of the following determinants are equal to $0?$\n\n$$\n|A|=|\\begin{aligned}5 & -4 & 0 \\\\ 0 & -1 & \\sqrt{2} \\\\ 0 & 0 & 2\\end{aligned}|,\\,|B|=|\\begin{aligned}1 & 1 & 0 \\\\ -5 & 0 & 0 \\\\ 3 & 1 & 0\\end{aligned}|,\\,|C|=|\\begin{aligned}-3 & 1 & 2 \\\\ -1 & 2 & 3 \\\\ -3 & 1 & 2\\end{aligned}|\n$$" :question/worked-solution "Let's examine each of the given determinants in turn.\n\n- Since $A$ is a triangular matrix, we obtain \n\n$$\n|A|=5\\cdot (-1)\\cdot 2=-10\\ne 0.\n$$\n\n- The matrix $B$ has a zero column: \n\n$$\nB=[\\begin{aligned}1 & 1 & 0 \\\\ -5 & 0 & 0 \\\\ 3 & 1 & 0\\end{aligned}]\n$$\n\nAs a result, $|B|=0.$\n\n- The matrix $C$ has identical rows: \n\n$$\nC=[\\begin{aligned}-3 & 1 & 2 \\\\ -1 & 2 & 3 \\\\ -3 & 1 & 2\\end{aligned}]\n$$\n\nAs a result, $|C|=0.$\n\nTherefore, only $|B|$ and $|C|$ are equal to $0.$"}] [{:db/id #edb/ref 17592186484213 :knowledge-point/_questions [{:db/id #edb/ref 17592186133911 :knowledge-point/id #uuid "28142e26-f6c7-54c9-9c16-035c75f7659f" :knowledge-point/title "Calculating the Determinant of a Matrix With A Zero Row/Column or Two Identical Rows/Columns"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0277c4bf-919b-5267-9625-3ce886304e59" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$|B|$ and $|C|$ only" :db/id #edb/ref 17592186483573} {:answer/id #uuid "2f2d0592-797e-5802-8ca4-8a2a42612d69" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$|A|$ only" :db/id #edb/ref 17592186483647} {:answer/id #uuid "6c724853-4dc1-5954-a54d-2cd8c40b90e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$|A|$ and $|B|$ only" :db/id #edb/ref 17592186483777} {:answer/id #uuid "827c6d51-bd40-574d-b735-ef588e897657" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$|A|$ and $|C|$ only" :db/id #edb/ref 17592186483832} {:answer/id #uuid "f04249bb-8ff4-5ab0-bd54-1f9f6f447fd3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$|B|$ only" :db/id #edb/ref 17592186484043}] :answer-field/correct {:answer/id #uuid "6c724853-4dc1-5954-a54d-2cd8c40b90e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$|A|$ and $|B|$ only" :db/id #edb/ref 17592186483777} :answer-field/id #uuid "23681fe8-270b-5047-9929-75e3e8fd1007" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186484099}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3d069a94-d7d6-5988-ba00-dc610c0a1a5e" :question/math-academy-id "q-82194" :question/problem "Which of the following determinants are equal to $0?$\n\n$$\n|A|=|\\begin{aligned}2 & -1 & 0 & 2 \\\\ 1 & 0 & \\sqrt{3} & 1 \\\\ -7 & 1 & -1 & -7 \\\\ 3 & 0 & \\sqrt{3} & 3\\end{aligned}|,\\,|B|=|\\begin{aligned}0 & -2 & 0.5 \\\\ 3 & -3 & \\sqrt{5} \\\\ 0 & 0 & 0\\end{aligned}|,\\,|C|=|\\begin{aligned}7 & 1 & 0 \\\\ 0 & -1 & \\sqrt{3} \\\\ 0 & 0 & -2\\end{aligned}|\n$$" :question/worked-solution "Let's examine each of the given determinants in turn.\n\n- The matrix $A$ has identical columns: \n\n$$\nA=[\\begin{aligned}2 & -1 & 0 & 2 \\\\ 1 & 0 & \\sqrt{3} & 1 \\\\ -7 & 1 & -1 & -7 \\\\ 3 & 0 & \\sqrt{3} & 3\\end{aligned}]\n$$\n\nAs a result, $|A|=0.$\n\n- The matrix $B$ has a zero row: \n\n$$\nB=[\\begin{aligned}0 & -2 & 0.5 \\\\ 3 & -3 & \\sqrt{5} \\\\ 0 & 0 & 0\\end{aligned}]\n$$\n\nAs a result, $|B|=0.$\n\n- Since $C$ is a triangular matrix, we obtain \n\n$$\n|C|=7\\cdot (-1)\\cdot (-2)=14\\ne 0.\n$$\n\nTherefore, only $|A|$ and $|B|$ are equal to $0.$"}] [{:db/id #edb/ref 17592186484193 :knowledge-point/_questions [{:db/id #edb/ref 17592186133912 :knowledge-point/id #uuid "8aef330a-81b3-56c4-9559-67df673e8687" :knowledge-point/title "Calculating the Determinant of a Matrix With Two Proportional Rows/Columns"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "366bb306-e5b1-5bce-82a8-a14197bda5e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186483664} {:answer/id #uuid "5c836208-8886-5ac5-a42b-bc5298710b67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186483742} {:answer/id #uuid "66dd1cc6-ae10-55ca-805b-f651571a416c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186483766} {:answer/id #uuid "b1e66de3-9711-58eb-a4b6-9c6f7f7d5114" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186483922} {:answer/id #uuid "cf227642-8c60-5fac-8a8c-4941679de5a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186483985}] :answer-field/correct {:answer/id #uuid "b1e66de3-9711-58eb-a4b6-9c6f7f7d5114" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186483922} :answer-field/id #uuid "0ac158dd-e2ea-5d6f-9ec0-895c0248c590" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186484087}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "00ee9625-b07b-5511-af62-7520bef2fbbd" :question/math-academy-id "q-82287" :question/problem "Find $5det(A)+2det(B)$, where \n\n$$\nA=[\\begin{aligned}1 & -3 & 4 \\\\ \\sqrt{3} & -1 & 1.5 \\\\ 3 & -9 & 12\\end{aligned}],\\,B=[\\begin{aligned}2 & \\sqrt{3} \\\\ \\sqrt{3} & 3\\end{aligned}].\n$$" :question/worked-solution "Let's examine each matrix in turn.\n\n- Since $A$ has proportional rows, we obtain\n\n$$\nA=[\\begin{aligned}1 & -3 & 4 \\\\ \\sqrt{3} & -1 & 1.5 \\\\ 3 & -9 & 12\\end{aligned}]\\,⟹\\,det(A)=0.\n$$\n\n- For the matrix $B,$ we have\n\n$$\ndet(B)=2\\cdot 3-\\sqrt{3}\\cdot \\sqrt{3}=3.\n$$\n\nTherefore, $5det(A)+2det(B)=5\\cdot 0+2\\cdot 3=6.$"}]}
