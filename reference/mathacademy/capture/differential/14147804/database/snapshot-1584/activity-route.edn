#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186442994} :activity/id #uuid "b4a03ddd-003b-5e8e-82c8-2cc43b396522" :activity/scope {:db/id #edb/ref 17592186049436 :topic/id #uuid "f5218ca7-a9d3-5ad9-b17a-ee16b6e2b34a" :topic/math-academy-id 1805} :activity/steps [{:db/id #edb/ref 17592186442991 :step/content {:db/id #edb/ref 17592186420153 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b182a09-cc9d-51c4-95fe-e78790ecf72a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186420142} {:answer/id #uuid "36cb63bc-ae79-51e4-b5ab-3039c42340e0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186420143} {:answer/id #uuid "4173b538-e381-5dd5-b0c5-10dc2eaa96c4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186420144} {:answer/id #uuid "502b671f-b1be-5d29-8f96-08571a87d173" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186420145} {:answer/id #uuid "72001519-6957-56f0-b511-f27a9ed3c85f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186420146}] :answer-field/correct {:db/id #edb/ref 17592186420143} :answer-field/id #uuid "f9a0d8dd-871f-5fc8-9699-7a78c5f80aac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186420152}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3fa29ff6-5ae4-5642-82fd-03b1645e810c" :question/math-academy-id "q-127921" :question/problem "A nonzero vector $⟨0,\\,b,\\,c⟩$ is parallel to the plane $r\\cdot ⟨5,-1,3⟩=27.$ What is the value of $\\frac{b}{c}?$" :question/worked-solution "We need a vector $v=⟨{t}_{1},{t}_{2},{t}_{3}⟩$ that is parallel to the given plane. \n\nFrom the equation $r\\cdot ⟨5,-1,3⟩=27$ of the plane, we get the normal vector $n=⟨5,-1,3⟩.$ So, $v⊥n$ and we have the following:\n\n$$\n\\begin{aligned}v\\cdot n & =0 \\\\ ⟨{t}_{1},{t}_{2},{t}_{3}⟩\\cdot ⟨5,-1,3⟩ & =0 \\\\ 5{t}_{1}-{t}_{2}+3{t}_{3} & =0 \\\\ {t}_{2} & =5{t}_{1}+3{t}_{3}\\end{aligned}\n$$\n\nHence, we obtain \n\n$$\nv=⟨{t}_{1},\\,5{t}_{1}+3{t}_{3},\\,{t}_{3}⟩,\n$$\n\nwhere ${t}_{1},{t}_{3}\\in (-\\infty ,\\infty ).$ \n\nWe are told that the first component of $v$ equals $0.$ So, we must set ${t}_{1}=0.$ \n\nSince $v$ is nonzero, we can pick any ${t}_{3}\\ne 0.$ For example, setting ${t}_{3}=1$, we get\n\n$$\nv=⟨0,\\,3,\\,1⟩.\n$$\n\nTherefore, $\\frac{b}{c}=3.$"} :step/id #uuid "3458e62b-8854-5734-859a-ce2619927743" :step/next {:db/id #edb/ref 17592186442995}} {:db/id #edb/ref 17592186442992 :step/content {:db/id #edb/ref 17592186387852 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "901763ea-91a4-5ccc-9fd1-7a5abd771549" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨2,2,3⟩=22" :db/id #edb/ref 17592186387854} {:answer/id #uuid "e471dd7f-cf5c-5449-bdd5-1669c5ee7ff8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨2,3,2⟩=14" :db/id #edb/ref 17592186387855} {:answer/id #uuid "be245f9d-2743-5776-a695-325f9e3f765e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨6,2,2⟩=16" :db/id #edb/ref 17592186387856} {:answer/id #uuid "e50391f5-f264-5d75-924b-8343f68bda37" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨3,2,2⟩=8" :db/id #edb/ref 17592186387857} {:answer/id #uuid "9c146846-53c1-5f64-8789-a2b060a469a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨2,6,2⟩=12" :db/id #edb/ref 17592186387858}] :answer-field/correct {:db/id #edb/ref 17592186387856} :answer-field/id #uuid "60a27afd-b25c-559e-94cd-93712349e320" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186387853}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "78e0dc1f-5e12-54f0-b00c-492a979933d2" :question/math-academy-id "q-127937" :question/problem "Find an equation of the plane that passes through the point $P(2,-1,3)$ and is perpendicular to the line that goes through the points \n$A(-4,1,3)$ and $B(2,3,5).$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨2,-1,3⟩.$\n\nSince the line  passes through the points $A(-4,1,3)$ and $B(2,3,5)$ we can find a vector parallel to the line:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =⟨2,3,5⟩-⟨-4,1,3⟩ \\\\  & =⟨6,2,2⟩.\\end{aligned}\n$$\n\n \n\nSo, a normal vector to the plane is $n=⟨6,2,2⟩.$\n\nTherefore, the equation of the plane is given by\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n-p\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨6,2,2⟩ & =⟨2,-1,3⟩\\cdot ⟨6,2,2⟩ \\\\ r\\cdot ⟨6,2,2⟩ & =16.\\end{aligned}\n$$"} :step/id #uuid "735f1d1f-3dd1-50b8-8d7c-9fcb22c5b1c7"} {:db/id #edb/ref 17592186442993 :step/content {:db/id #edb/ref 17592186338827 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7b4cf333-fb31-53e5-a3b2-4d1da8c129ea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186337143} {:answer/id #uuid "8699f13d-227d-54e9-8db2-f586a65cc4a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186337250} {:answer/id #uuid "8ed87010-5adf-5b37-aeca-2e7df330c813" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186337317} {:answer/id #uuid "92eae00f-5f08-53b6-b534-72b9e6866cbc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186337371} {:answer/id #uuid "a20a8aa3-4bd5-5bea-8e7e-61c74a32567a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186337501}] :answer-field/correct {:db/id #edb/ref 17592186337317} :answer-field/id #uuid "557fd6f3-4749-5c34-935d-a0b820019a0f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186338422}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "22393ec9-8250-54f3-ad30-3ecff187a9da" :question/math-academy-id "q-70814" :question/problem "A nonzero vector $⟨0,\\,b,\\,c⟩$ is parallel to the plane $r\\cdot ⟨1,-2,1⟩=10.$ What is the value of $\\frac{b}{c}?$" :question/worked-solution "We need a vector $v=⟨{t}_{1},{t}_{2},{t}_{3}⟩$ that is parallel to the given plane. \n\nFrom the equation $r\\cdot ⟨1,-2,1⟩=10$ of the plane, we get the normal vector $n=⟨1,-2,1⟩.$ So, $v⊥n$ and we have the following:\n\n$$\n\\begin{aligned}v\\cdot n & =0 \\\\ ⟨{t}_{1},{t}_{2},{t}_{3}⟩\\cdot ⟨1,-2,1⟩ & =0 \\\\ {t}_{1}-2{t}_{2}+{t}_{3} & =0 \\\\ {t}_{3} & =2{t}_{2}-{t}_{1}\\end{aligned}\n$$\n\nHence, we obtain \n\n$$\nv=[\\begin{aligned}{t}_{1} \\\\ {t}_{2} \\\\ 2{t}_{2}-{t}_{1}\\end{aligned}],\n$$\n\nwhere ${t}_{1},{t}_{2}\\in (-\\infty ,\\infty ).$ \n\nWe are told that the first component of $v$ equals $0.$ So, we must set ${t}_{1}=0.$ \n\nSince $v$ is nonzero, we can pick any ${t}_{2}\\ne 0.$ For example, setting ${t}_{2}=1$, we get\n\n$$\nv=⟨0,\\,1,\\,2⟩.\n$$\n\nTherefore, $\\frac{b}{c}=\\frac{1}{2}.$"} :step/id #uuid "9462b507-c0a1-5898-9afa-bb4186df83ec" :step/next {:db/id #edb/ref 17592186442991}} {:db/id #edb/ref 17592186442994 :step/content {:db/id #edb/ref 17592186120222 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1490998e-fd96-558a-92bf-90c3e1b1d823" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot (\\sqrt{2}i+3j+4k)=2\\sqrt{2}i+7j-6k" :db/id #edb/ref 17592186442986} {:answer/id #uuid "24bd5c51-ea5f-55c2-b7cc-0a1c6fdaf3e9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot (2\\sqrt{2}i+7j-6k)=\\sqrt{2}i+3j+4k" :db/id #edb/ref 17592186442987} {:answer/id #uuid "26e81e0f-00be-5150-9e74-fec4066ead13" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot (2\\sqrt{2}i+7j-6k)=1" :db/id #edb/ref 17592186442988} {:answer/id #uuid "d8a2f39f-065a-5b9a-9af2-2369637cc071" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot (2\\sqrt{2}i+7j-6k)=5" :db/id #edb/ref 17592186442989} {:answer/id #uuid "eead13a6-edac-5ccb-bd23-f3ae56dce20e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot (2\\sqrt{2}i+7j-6k)=-5" :db/id #edb/ref 17592186442990}] :answer-field/correct {:db/id #edb/ref 17592186442988} :answer-field/id #uuid "1ea9a67f-f999-5059-be26-16de635db5bd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186117493}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3aea6384-95f5-5566-a595-7a25ca576605" :question/math-academy-id "q-33029" :question/problem "Find an equation of the plane that contains the point $P(\\sqrt{2},3,4)$ and is perpendicular to the vector $n=2\\sqrt{2}i+7j-6k.$" :question/worked-solution "First, we note that the position vector of $P$ is $p=\\sqrt{2}i+3j+4k,$ and $n=2\\sqrt{2}i+7j-6k$ is normal to the plane.\n\nThe equation of the plane that passes through the point $P({x}_{0},{y}_{0},{z}_{0})$ and is perpendicular to the vector $n$ can be given as\n\n$$\n(r-p)\\cdot n=0,\n$$\n\nwhere $r$ is the position vector of any point on the plane, and $p$ is the position vector of $P.$\n\nSo, we have\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n-p\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot (2\\sqrt{2}i+7j-6k) & =(\\sqrt{2}i+3j+4k)\\cdot (2\\sqrt{2}i+7j-6k) \\\\ r\\cdot (2\\sqrt{2}i+7j-6k) & =1.\\end{aligned}\n$$"} :step/id #uuid "ad4d6328-8534-5210-8c4a-365882fe2824" :step/next {:db/id #edb/ref 17592186442993}} {:db/id #edb/ref 17592186442995 :step/content {:db/id #edb/ref 17592186262853 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1aa825cb-f5f2-5941-b18f-a35a9e8ffaab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨-4,-4,3⟩=11" :db/id #edb/ref 17592186260107} {:answer/id #uuid "394ffd1f-3104-5495-902a-37954445a0c9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨-4,3,4⟩=12" :db/id #edb/ref 17592186260385} {:answer/id #uuid "56cda873-6a65-51e4-b130-2eb9c208d8a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨3,4,4⟩=23" :db/id #edb/ref 17592186260617} {:answer/id #uuid "ce2cec22-6b83-56cf-81ae-8596b434a0ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨4,-3,4⟩=11" :db/id #edb/ref 17592186261696} {:answer/id #uuid "e6b3d4ad-159b-554b-a0a1-ef2fb9a85ed2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨3,-4,4⟩=23" :db/id #edb/ref 17592186261900}] :answer-field/correct {:db/id #edb/ref 17592186261900} :answer-field/id #uuid "7f4a93d8-207b-5307-acbb-b861f6a8320e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186262337}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9164c795-7f61-5d54-9538-2653e37cb486" :question/math-academy-id "q-127927" :question/problem "Find an equation of the plane that passes through the point $Q(1,-2,3)$ and is perpendicular to the line that goes through the points \n$A(4,1,-3)$ and $B(7,-3,1).$" :question/worked-solution "First, we note that the position vector of $Q$ is $q=⟨1,-2,3⟩.$\n\nSince the line  passes through the points $A(4,1,-3)$ and $B(7,-3,1)$, we can find a vector that is parallel to the line:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =⟨7,-3,1⟩-⟨4,1,-3⟩ \\\\  & =⟨3,-4,4⟩\\end{aligned}\n$$\n\n \n\nSo, a normal vector to the plane is $n=⟨3,-4,4⟩.$\n\nTherefore, the equation of the plane is given by \n\n$$\n\\begin{aligned}(r-q)\\cdot n & =0 \\\\ r\\cdot n-q\\cdot n & =0 \\\\ r\\cdot n & =q\\cdot n \\\\ r\\cdot ⟨3,-4,4⟩ & =⟨1,-2,3⟩\\cdot ⟨3,-4,4⟩ \\\\ r\\cdot ⟨3,-4,4⟩ & =23.\\end{aligned}\n$$"} :step/id #uuid "fb8f9fe8-2ed4-5d86-8099-75a35919ccad" :step/next {:db/id #edb/ref 17592186442992}}] :activity/title "The Vector Equation of a Plane" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186442985}]}
