-p\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot (2\\sqrt{2}i+7j-6k) & =(\\sqrt{2}i+3j+4k)\\cdot (2\\sqrt{2}i+7j-6k) \\\\ r\\cdot (2\\sqrt{2}i+7j-6k) & =1.\\end{aligned}\n$$" 13194139534896 17592186045417 true] [17592186442985 1043 #edb/ref 17592186442991 13194139534896 17592186045417 true] [17592186442985 1043 #edb/ref 17592186442992 13194139534896 17592186045417 true] [17592186442985 1043 #edb/ref 17592186442993 13194139534896 17592186045417 true] [17592186442985 1043 #edb/ref 17592186442994 13194139534896 17592186045417 true] [17592186442985 1043 #edb/ref 17592186442995 13194139534896 17592186045417 true] [17592186442985 1044 #edb/ref 17592186045464 13194139534896 17592186045417 true] [17592186442985 1045 "The Vector Equation of a Plane" 13194139534896 17592186045417 true] [17592186442985 1046 #edb/ref 17592186442994 13194139534896 17592186045417 true] [17592186442985 1048 #edb/ref 17592186046658 13194139534896 17592186045417 true] [17592186442985 1049 #edb/ref 17592186049436 13194139534896 17592186045417 true] [17592186442985 1053 #uuid "b4a03ddd-003b-5e8e-82c8-2cc43b396522" 13194139534896 17592186045417 true] [17592186442986 1080 "r\\cdot (\\sqrt{2}i+3j+4k)=2\\sqrt{2}i+7j-6k" 13194139534896 17592186045417 true] [17592186442986 1082 #edb/ref 17592186045498 13194139534896 17592186045417 true] [17592186442986 1083 #uuid "1490998e-fd96-558a-92bf-90c3e1b1d823" 13194139534896 17592186045417 true] [17592186442987 1080 "r\\cdot (2\\sqrt{2}i+7j-6k)=\\sqrt{2}i+3j+4k" 13194139534896 17592186045417 true] [17592186442987 1082 #edb/ref 17592186045498 13194139534896 17592186045417 true] [17592186442987 1083 #uuid "24bd5c51-ea5f-55c2-b7cc-0a1c6fdaf3e9" 13194139534896 17592186045417 true] [17592186442988 1080 "r\\cdot (2\\sqrt{2}i+7j-6k)=1" 13194139534896 17592186045417 true] [17592186442988 1082 #edb/ref 17592186045498 13194139534896 17592186045417 true] [17592186442988 1083 #uuid "26e81e0f-00be-5150-9e74-fec4066ead13" 13194139534896 17592186045417 true] [1759218644298