#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186531718} :activity/id #uuid "a41be437-b248-5421-824d-ce132e4011d1" :activity/scope {:db/id #edb/ref 17592186050447 :topic/id #uuid "49c998a8-44ce-526f-ad90-85d8ceda122b" :topic/math-academy-id 3171} :activity/steps [{:db/id #edb/ref 17592186531663 :step/content {:db/id #edb/ref 17592186278199 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09b79818-ec47-55bc-b609-63c6c7f161ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186275560} {:answer/id #uuid "323fcb23-e5ea-5a1e-bc6b-e65f4146ffd7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186275920} {:answer/id #uuid "729259e1-80fc-5388-9d30-d99ee12044d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186276514} {:answer/id #uuid "7da4754f-dbb6-521e-9c6c-fe4033a96679" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186276621} {:answer/id #uuid "fe5b7457-be1f-5d50-8ded-808417ee142a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186277709}] :answer-field/correct {:db/id #edb/ref 17592186275560} :answer-field/id #uuid "0c00b02e-46dc-5d0c-b7da-153ae5f706cb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186277747}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e1c124bc-a836-51e9-a514-6920747fc0ad" :question/math-academy-id "q-158529" :question/problem "Find the minimum value of $Q(x)=-4{x}_{1}^{2}-3{x}_{2}^{2}$ given that $‖x‖=1.$" :question/worked-solution "First, notice that ${x}_{2}^{2}\\ge 0.$ So, we have that\n\n$$\n-3{x}_{2}^{2}\\ge -4{x}_{2}^{2}.\n$$\n\nAs a result, \n\n$$\n\\begin{aligned}Q(x) & =-4{x}_{1}^{2}-3{x}_{2}^{2} \\\\  & \\ge -4{x}_{1}^{2}-4{x}_{2}^{2} \\\\  & =-4({x}_{1}^{2}+{x}_{2}^{2}).\\end{aligned}\n$$\n\nNow, recall that $‖x‖=1$ is equivalent to ${x}_{1}^{2}+{x}_{2}^{2}=1.$ So,  \n\n$$\n\\begin{aligned}-4({x}_{1}^{2}+{x}_{2}^{2})=-4(1)=-4.\\end{aligned}\n$$\n\nand, in turn, $Q(x)\\ge -4.$\n\nSo, the value of $Q(x)$ can be no smaller than $-4.$ But before we conclude that $-4$ is the minimum, we need to find a vector such that $Q(x)=-4.$\n\nNotice that when $x={\\begin{bmatrix}1 & 0\\end{bmatrix}}^{T},$ we get\n\n$$\n\\begin{aligned}Q(x) & =-4{x}_{1}^{2}-3{x}_{2}^{2} \\\\  & =-4(1)^{2}-3(0)^{2} \\\\  & =-4.\\end{aligned}\n$$\n\nTherefore, given that $‖x‖=1,$ the minimum value of $Q(x)$ is equal to $-4.$"} :step/id #uuid "085cdc0b-e1a7-5229-892c-0ef2ac49749e"} {:db/id #edb/ref 17592186531686 :step/content {:db/id #edb/ref 17592186269162 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "426b242e-82e1-5cb1-8e9a-c5f3406c7b6a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186266737} {:answer/id #uuid "a698ddc5-e273-545c-92f3-c9e3a7a2206e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186267651} {:answer/id #uuid "af666caa-2f0b-52bd-b6ae-306a82069c11" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186267723} {:answer/id #uuid "e8263730-14a1-5854-bc66-a40ac358112e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186268202} {:answer/id #uuid "ed865f26-135f-5470-92f3-701998ca3801" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186268254}] :answer-field/correct {:db/id #edb/ref 17592186266737} :answer-field/id #uuid "5cae1c8d-1f0a-50b4-af56-974bf2368c7b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186268573}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c5b94d26-7531-5fec-94da-00c9ed7c30a6" :question/math-academy-id "q-138029" :question/problem "Find the minimum value of $Q(x)=4{x}_{1}^{2}+3{x}_{2}^{2}+2{x}_{3}^{2}$ given that $‖x‖=1.$" :question/worked-solution "First, notice that ${x}_{1}^{2}\\ge 0$ and ${x}_{3}^{2}\\ge 0.$ So, we have that\n\n$$\n4{x}_{1}^{2}\\ge 2{x}_{1}^{2},\\,3{x}_{2}^{2}\\ge 2{x}_{2}^{2}.\n$$\n\nAs a result, \n\n$$\n\\begin{aligned}Q(x) & =4{x}_{1}^{2}+3{x}_{2}^{2}+2{x}_{3}^{2} \\\\  & \\ge 2{x}_{1}^{2}+2{x}_{2}^{2}+2{x}_{3}^{2} \\\\  & =2({x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2}).\\end{aligned}\n$$\n\nNow, recall that $‖x‖=1$ is equivalent to ${x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2}=1.$ So, \n\n$$\n\\begin{aligned}2({x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2})=2(1)=2.\\end{aligned}\n$$\n\nand, in turn, $Q(x)\\ge 2.$\n\nSo, the value of $Q(x)$ can be no smaller than $2.$ But before we conclude that $2$ is the minimum, we need to find a vector such that $Q(x)=2.$\n\nNotice that when  $x={\\begin{bmatrix}0 & 0 & 1\\end{bmatrix}}^{T},$ we get\n\n$$\n\\begin{aligned}Q(x) & =4{x}_{1}^{2}+3{x}_{2}^{2}+2{x}_{3}^{2} \\\\  & =4(0)^{2}+3(0)^{2}+2(1)^{2} \\\\  & =2.\\end{aligned}\n$$\n\nTherefore, given that $‖x‖=1,$ the minimum value of $Q(x)$ is equal to $2.$"} :step/id #uuid "46e11e28-122a-5f86-8bf2-7977b37760ca" :step/next {:db/id #edb/ref 17592186531708}} {:db/id #edb/ref 17592186531690 :step/content {:db/id #edb/ref 17592186269171 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "122eee3a-20b1-5dc1-8032-b0a7364b8fd0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186266297} {:answer/id #uuid "5b986832-b913-5e58-b854-ef43db21ccb0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186266955} {:answer/id #uuid "731a0fbb-6cd3-54a2-a7ff-666306420f9f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186267155} {:answer/id #uuid "89017047-09bb-592f-a23d-58f513967ae1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186267364} {:answer/id #uuid "a2b6d881-d2c4-5ba8-8b1d-c3579ea3869d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186267608}] :answer-field/correct {:db/id #edb/ref 17592186266955} :answer-field/id #uuid "61f57b6d-dac7-57b3-94d1-767059918990" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186268583}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e90ca9ef-a872-5eac-99c1-91a2d454f0ae" :question/math-academy-id "q-138074" :question/problem "Find the maximum value of $Q(x)=3{x}_{1}^{2}+{x}_{2}^{2}+3{x}_{3}^{2}-2{x}_{1}{x}_{3}$ given that $‖x‖=1.$" :question/worked-solution "Let $A$ be the matrix corresponding to our quadratic form. Recall that: \n\n- The maximum value of $Q(x),$ when $‖x‖=1,$ is equal to the largest eigenvalue of $A:$\n\n$$\nmax{Q(x)\\,|\\,‖x‖=1}={\\lambda }_{\\text{max}}\n$$\n\n- The minimum value of $Q(x),$ when $‖x‖=1,$ is equal to the smallest eigenvalue of $A:$\n\n$$\nmin{Q(x)\\,|\\,‖x‖=1}={\\lambda }_{\\text{min}}\n$$\n\nFirst, we write down the matrix of our quadratic form:\n\n$$\nA=\\begin{bmatrix}3 & 0 & -1 \\\\ 0 & 1 & 0 \\\\ -1 & 0 & 3\\end{bmatrix}\n$$\n\nNow, we need to calculate the eigenvalues of the matrix $A:$\n\n$$\n\\begin{aligned}|A-\\lambda I| & =0 \\\\ \\begin{vmatrix}3-\\lambda  & 0 & -1 \\\\ 0 & 1-\\lambda  & 0 \\\\ -1 & 0 & 3-\\lambda \\end{vmatrix} & =0 \\\\ (1-\\lambda )\\begin{vmatrix}3-\\lambda  & -1 \\\\ -1 & 3-\\lambda \\end{vmatrix} & =0 \\\\ (1-\\lambda )((3-\\lambda )(3-\\lambda )-1) & =0 \\\\ (1-\\lambda )({\\lambda }^{2}-6\\lambda +8) & =0 \\\\ (1-\\lambda )(\\lambda -4)(\\lambda -2) & =0 \\\\ \\lambda  & =4,\\,2,\\,1\\end{aligned}\n$$\n\n \n\nTherefore, we have\n\n$$\nmax{Q(x)\\,|\\,‖x‖=1}=4.\n$$"} :step/id #uuid "66cbd984-34bf-5c4b-b040-16117bac09ca" :step/next {:db/id #edb/ref 17592186531663}} {:db/id #edb/ref 17592186531708 :step/content {:db/id #edb/ref 17592186531584 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30d37de0-fa9a-528c-821a-0e1cbd836c93" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186530971} {:answer/id #uuid "95163aca-07b5-596d-b2dd-ec7271cff2ed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186531185} {:answer/id #uuid "9b7e80c1-d411-5f78-8fa9-5b2e23fb8afb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186531197} {:answer/id #uuid "9e6fc084-138a-52e5-98fc-f3ff4df2d844" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186531205} {:answer/id #uuid "b1129f7d-4d42-5274-bad5-368dc2993492" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186531245}] :answer-field/correct {:db/id #edb/ref 17592186530971} :answer-field/id #uuid "55b2d835-40d6-572d-8824-c8db3cfc4a3b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186531451}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3e4f6268-3e58-5684-9bea-f874fd53aaf3" :question/math-academy-id "q-138069" :question/problem "Find the minimum value of $Q(x)=-{x}_{1}^{2}+4{x}_{1}{x}_{2}+2{x}_{2}^{2}$ given that $‖x‖=1.$" :question/worked-solution "Let $A$ be the matrix corresponding to our quadratic form. Recall that: \n\n- The maximum value of $Q(x),$ when $‖x‖=1,$ is equal to the largest eigenvalue of $A:$\n\n$$\nmax\\{Q(x)\\,|\\,‖x‖=1\\}={\\lambda }_{\\text{max}}\n$$\n\n- The minimum value of $Q(x),$ when $‖x‖=1,$ is equal to the smallest eigenvalue of $A:$\n\n$$\nmin\\{Q(x)\\,|\\,‖x‖=1\\}={\\lambda }_{\\text{min}}\n$$\n\nFirst, we write down the matrix of our quadratic form:\n\n$$\nA=[\\begin{aligned}-1 & 2 \\\\ 2 & 2\\end{aligned}]\n$$\n\nNow, we need to calculate the eigenvalues of the matrix $A:$\n\n$$\n\\begin{aligned}|A-\\lambda I| & =0 \\\\ |\\begin{aligned}-1-\\lambda  & 2 \\\\ 2 & 2-\\lambda \\end{aligned}| & =0 \\\\ (-1-\\lambda )(2-\\lambda )-4 & =0 \\\\ {\\lambda }^{2}-\\lambda -6 & =0 \\\\ (\\lambda +2)(\\lambda -3) & =0 \\\\ \\lambda  & =-2,\\,3\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nmin\\{Q(x)\\,|\\,‖x‖=1\\}=-2.\n$$"} :step/id #uuid "b523e58a-cade-5384-8700-ade4a5ce4089" :step/next {:db/id #edb/ref 17592186531690}} {:db/id #edb/ref 17592186531718 :step/content {:db/id #edb/ref 17592186531621 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "216c258d-237e-56bc-84d0-723783afd364" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186530936} {:answer/id #uuid "5f0626f9-e9e4-50c5-b013-a1beded68ff5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186531074} {:answer/id #uuid "7cc3c5b6-4c5a-5c36-a2ed-e4ddbb6fc109" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186531138} {:answer/id #uuid "c5f228cb-9e36-5dd9-b182-62125ce92bee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186531277} {:answer/id #uuid "c8ebcb55-7a36-5694-83c4-9fdbd78afeec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186531283}] :answer-field/correct {:db/id #edb/ref 17592186531138} :answer-field/id #uuid "90167cb7-250b-5746-b04f-a31c7f3561cb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186531481}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "957651b3-45e4-5a93-853b-1785322d0942" :question/math-academy-id "q-138022" :question/problem "Find the maximum value of $Q(x)={x}_{1}^{2}-{x}_{2}^{2}$ given that $‖x‖=1.$" :question/worked-solution "First, notice that ${x}_{2}^{2}\\ge 0.$ So, we have that\n\n$$\n-{x}_{2}^{2}\\le {x}_{2}^{2}.\n$$\n\nAs a result,  \n\n$$\n\\begin{aligned}Q(x) & ={x}_{1}^{2}-{x}_{2}^{2} \\\\  & \\le {x}_{1}^{2}+{x}_{2}^{2} \\\\  & ={x}_{1}^{2}+{x}_{2}^{2}.\\end{aligned}\n$$\n\nNow, recall that $‖x‖=1$ is equivalent to ${x}_{1}^{2}+{x}_{2}^{2}=1.$ So,  in turn, $Q(x)\\le 1.$\n\nSo, the value of $Q(x)$ can be no greater than $1.$ But before we conclude that $1$ is the maximum, we need to find a vector such that $Q(x)=1.$\n\nNotice that when $x={[\\begin{aligned}1 & 0\\end{aligned}]}^{T},$ we get\n\n$$\n\\begin{aligned}Q(x) & ={x}_{1}^{2}-{x}_{2}^{2} \\\\  & =(1)^{2}-(0)^{2} \\\\  & =1.\\end{aligned}\n$$\n\n \n\nTherefore, given that $‖x‖=1,$ the maximum value of $Q(x)$ is equal to $1.$"} :step/id #uuid "d6103cc5-4c4e-5c0f-af10-d73cba662696" :step/next {:db/id #edb/ref 17592186531686}}] :activity/title "Constrained Optimization of Quadratic Forms" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186530860}]}
