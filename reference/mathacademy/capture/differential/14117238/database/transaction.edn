er-0624c52e-1d19-5b3b-ba86-d2f6b9cc8ef9" :answer-field/choices ["answer-e3d08458-0ba1-59ee-877c-a0b12c255dc9" "answer-0624c52e-1d19-5b3b-ba86-d2f6b9cc8ef9" "answer-c363b46a-0dfe-5b02-aa34-a0ac7fb02ba1" "answer-881fa5d4-1c12-5bc5-a457-efc8e41af6ea" "answer-9a61e467-6a0c-55c5-bb23-f1d334a8e5d4"] :db/ensure [:answer-field/validate]} {:db/id "answer-e3d08458-0ba1-59ee-877c-a0b12c255dc9" :answer/id #uuid "e3d08458-0ba1-59ee-877c-a0b12c255dc9" :answer/type :answer.type/math :answer/value "25" :db/ensure [:answer/validate]} {:db/id "answer-0624c52e-1d19-5b3b-ba86-d2f6b9cc8ef9" :answer/id #uuid "0624c52e-1d19-5b3b-ba86-d2f6b9cc8ef9" :answer/type :answer.type/math :answer/value "50" :db/ensure [:answer/validate]} {:db/id "answer-c363b46a-0dfe-5b02-aa34-a0ac7fb02ba1" :answer/id #uuid "c363b46a-0dfe-5b02-aa34-a0ac7fb02ba1" :answer/type :answer.type/math :answer/value "52" :db/ensure [:answer/validate]} {:db/id "answer-881fa5d4-1c12-5bc5-a457-efc8e41af6ea" :answer/id #uuid "881fa5d4-1c12-5bc5-a457-efc8e41af6ea" :answer/type :answer.type/math :answer/value "54" :db/ensure [:answer/validate]} {:db/id "answer-9a61e467-6a0c-55c5-bb23-f1d334a8e5d4" :answer/id #uuid "9a61e467-6a0c-55c5-bb23-f1d334a8e5d4" :answer/type :answer.type/math :answer/value "64" :db/ensure [:answer/validate]} {:db/id "question-e96a222d-7bc2-5df0-a9b1-bdb0a30abe0c" :question/id #uuid "e96a222d-7bc2-5df0-a9b1-bdb0a30abe0c" :question/math-academy-id "q-66422" :question/problem "Given $f(x)=4x-6$ and $g(x)=5x-10,$ find  $(fg)(4).$" :question/worked-solution "The notation $(fg)(x)$ means  the product of the functions  $f(x)$ and $g(x).$\n\n**Method 1**\n\nTo evaluate $(fg)(4),$ we find $f(4)$ and $g(4),$ and then multiply the results.\n\nFirst, we find $f(4)$ and $g(4):$\n\n$$\n\\begin{aligned}f(4) & =4(4)-6=10 \\\\ g(4) & =5(4)-10=10\\end{aligned}\n$$\n\n \n\nNow, we multiply the results:\n\n$$\n(fg)(4)=f(4)g(4)=10\\cdot 10=100\n$$\n\n**Method 2**\n\nFirst, we find $(fg)(x)$ by multiplying the two functions:\n\n$$\n\\begin{aligned}(fg)(x) & =(4x-6)(5x-10) \\\\  & =20{x}^{2}-70x+60\\end{aligned}\n$$\n\n \n\nNow, we evaluate $(fg)(4):$ \n\n$$\n\\begin{aligned}(fg)(4) & =20(4)^{2}-70(4)+60 \\\\  & =320-280+60 \\\\  & =100\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c6c5b78a-506e-5248-bf6a-b9065365cf86"] :db/ensure [:question/validate]} {:db/id "answer-field-c6c5b78a-506e-5248-bf6a-b9065365cf86" :answer-field/id #uuid "c6c5b78a-506e-5248-bf6a-b9065365cf86" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d5863df3-ccee-5d78-a1f6-ffe664b5ed2f" :answer-field/choices ["answer-d5863df3-ccee-5d78-a1f6-ffe664b5ed2f" "answer-99c58b19-affa-5e56-ac31-b7ba0d67c4b7" "answer-d88a8dac-6d79-5f3b-af46-b99926e48769" "answer-84f34919-47cb-54fa-a488-9daaa920449b" "answer-ff7784da-0b8b-5927-98d8-267858c58f6e"] :db/ensure [:answer-field/validate]} {:db/id "answer-d5863df3-ccee-5d78-a1f6-ffe664b5ed2f" :answer/id #uuid "d5863df3-ccee-5d78-a1f6-ffe664b5ed2f" :answer/type :answer.type/math :answer/value "100" :db/ensure [:answer/validate]} {:db/id "answer-99c58b19-affa-5e56-ac31-b7ba0d67c4b7" :answer/id #uuid "99c58b19-affa-5e56-ac31-b7ba0d67c4b7" :answer/type :answer.type/math :answer/value "120" :db/ensure [:answer/validate]} {:db/id "answer-d88a8dac-6d79-5f3b-af46-b99926e48769" :answer/id #uuid "d88a8dac-6d79-5f3b-af46-b99926e48769" :answer/type :answer.type/math :answer/value "135" :db/ensure [:answer/validate]} {:db/id "answer-84f34919-47cb-54fa-a488-9daaa920449b" :answer/id #uuid "84f34919-47cb-54fa-a488-9daaa920449b" :answer/type :answer.type/math :answer/value "450" :db/ensure [:answer/validate]} {:db/id "answer-ff7784da-0b8b-5927-98d8-267858c58f6e" :answer/id #uuid "ff7784da-0b8b-5927-98d8-267858c58f6e" :answer/type :answer.type/math :answer/value "540" :db/ensure [:answer/validate]} {:db/id 17592186054612 :knowledge-point/questions ["question-fe5aa5dd-14e3-52ea-8c5e-90aad88d589b