#{[{:db/id #edb/ref 17592186055450 :knowledge-point/_questions [{:db/id #edb/ref 17592186054628 :knowledge-point/id #uuid "0e8b25b3-5cc4-51b7-8ff9-fc1773797ad4" :knowledge-point/title "Evaluating the Sum or Difference of Two Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "191ed9fb-e1ea-5bef-892a-5baa90256a4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186413837} {:answer/id #uuid "2d90ba2d-f17e-5fdb-9818-2e1002340d59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186413838} {:answer/id #uuid "325859ee-224e-52c1-a505-c5197b9a6558" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186413839} {:answer/id #uuid "65020d93-ef32-58e5-bf24-738b6719f093" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186413841} {:answer/id #uuid "e7666301-e17b-5314-afdb-d7835e5ea1bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186413855}] :answer-field/correct {:answer/id #uuid "65020d93-ef32-58e5-bf24-738b6719f093" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186413841} :answer-field/id #uuid "b4da891c-9eb7-5195-a3f8-0ac1c8c6f04f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186413861}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "23a164f0-a08a-5974-9621-a6231dc1af90" :question/math-academy-id "q-66137" :question/problem "Given $f(x)=2x+1$ and $g(x)=-3x+5,$ find $(f+g)(4).$" :question/worked-solution "The notation $(f+g)(x)$ means the sum of the functions $f(x)$ and $g(x).$\n\n**Method 1**\n\nTo evaluate $(f+g)(4),$ we find $f(4)$ and $g(4),$ and then add the results.\n\nFirst, we find $f(4)$ and $g(4):$\n\n$$\n\\begin{aligned}f(4) & =2(4)+1=9 \\\\ g(4) & =-3(4)+5=-7\\end{aligned}\n$$\n\n \n\nNow, we add the results:\n\n$$\n(f+g)(4)=f(4)+g(4)=9+(-7)=2\n$$\n\n**Method 2**\n\nFirst, we find $(f+g)(x)$ by adding the two functions:\n\n$$\n\\begin{aligned}(f+g)(x) & =(2x+1)+(-3x+5) \\\\  & =-x+6 \\\\  & =6-x\\end{aligned}\n$$\n\nNow, we evaluate $(f+g)(4):$\n\n$$\n\\begin{aligned}(f+g)(4) & =6-4=2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186413864 :knowledge-point/_questions [{:db/id #edb/ref 17592186054611 :knowledge-point/id #uuid "67b307f2-1d37-5741-8972-cbddae50c4c8" :knowledge-point/title "Finding the Product of Two Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0624c52e-1d19-5b3b-ba86-d2f6b9cc8ef9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186413835} {:answer/id #uuid "881fa5d4-1c12-5bc5-a457-efc8e41af6ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "54" :db/id #edb/ref 17592186413845} {:answer/id #uuid "9a61e467-6a0c-55c5-bb23-f1d334a8e5d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "64" :db/id #edb/ref 17592186413848} {:answer/id #uuid "c363b46a-0dfe-5b02-aa34-a0ac7fb02ba1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "52" :db/id #edb/ref 17592186413849} {:answer/id #uuid "e3d08458-0ba1-59ee-877c-a0b12c255dc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186413854}] :answer-field/correct {:answer/id #uuid "0624c52e-1d19-5b3b-ba86-d2f6b9cc8ef9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186413835} :answer-field/id #uuid "fb5f2ce0-c095-5ce3-be9e-db12b1e6fb29" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186413863}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a8d2e394-0754-5534-a3fd-34ae3db4d32c" :question/math-academy-id "q-66348" :question/problem "Given $f(x)={x}^{2}+1$ and $g(x)=2x-1,$ find  $(fg)(3).$" :question/worked-solution "The notation $(fg)(x)$ means  the product of the functions  $f(x)$ and $g(x).$\n\n**Method 1**\n\nTo evaluate $(fg)(3),$ we find $f(3)$ and $g(3),$ and then multiply the results.\n\nFirst, we find $f(3)$ and $g(3):$\n\n$$\n\\begin{aligned}f(3) & =(3)^{2}+1=10 \\\\ g(3) & =2(3)-1=5\\end{aligned}\n$$\n\n \n\nNow, we multiply the results:\n\n$$\n(fg)(3)=f(3)g(3)=10\\cdot 5=50\n$$\n\n**Method 2**\n\nFirst, we find $(fg)(x)$ by multiplying the two functions:\n\n$$\n\\begin{aligned}(fg)(x) & =({x}^{2}+1)(2x-1) \\\\  & =2{x}^{3}-{x}^{2}+2x-1\\end{aligned}\n$$\n\nNow, we evaluate $(fg)(3):$ \n\n$$\n\\begin{aligned}(fg)(3) & =2(3)^{3}-(3)^{2}+2(3)-1 \\\\  & =54-9+6-1 \\\\  & =50\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186413865 :knowledge-point/_questions [{:db/id #edb/ref 17592186054611 :knowledge-point/id #uuid "67b307f2-1d37-5741-8972-cbddae50c4c8" :knowledge-point/title "Finding the Product of Two Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84f34919-47cb-54fa-a488-9daaa920449b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "450" :db/id #edb/ref 17592186413844} {:answer/id #uuid "99c58b19-affa-5e56-ac31-b7ba0d67c4b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "120" :db/id #edb/ref 17592186413847} {:answer/id #uuid "d5863df3-ccee-5d78-a1f6-ffe664b5ed2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "100" :db/id #edb/ref 17592186413850} {:answer/id #uuid "d88a8dac-6d79-5f3b-af46-b99926e48769" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "135" :db/id #edb/ref 17592186413851} {:answer/id #uuid "ff7784da-0b8b-5927-98d8-267858c58f6e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "540" :db/id #edb/ref 17592186413858}] :answer-field/correct {:answer/id #uuid "d5863df3-ccee-5d78-a1f6-ffe664b5ed2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "100" :db/id #edb/ref 17592186413850} :answer-field/id #uuid "c6c5b78a-506e-5248-bf6a-b9065365cf86" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186413862}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e96a222d-7bc2-5df0-a9b1-bdb0a30abe0c" :question/math-academy-id "q-66422" :question/problem "Given $f(x)=4x-6$ and $g(x)=5x-10,$ find  $(fg)(4).$" :question/worked-solution "The notation $(fg)(x)$ means  the product of the functions  $f(x)$ and $g(x).$\n\n**Method 1**\n\nTo evaluate $(fg)(4),$ we find $f(4)$ and $g(4),$ and then multiply the results.\n\nFirst, we find $f(4)$ and $g(4):$\n\n$$\n\\begin{aligned}f(4) & =4(4)-6=10 \\\\ g(4) & =5(4)-10=10\\end{aligned}\n$$\n\n \n\nNow, we multiply the results:\n\n$$\n(fg)(4)=f(4)g(4)=10\\cdot 10=100\n$$\n\n**Method 2**\n\nFirst, we find $(fg)(x)$ by multiplying the two functions:\n\n$$\n\\begin{aligned}(fg)(x) & =(4x-6)(5x-10) \\\\  & =20{x}^{2}-70x+60\\end{aligned}\n$$\n\n \n\nNow, we evaluate $(fg)(4):$ \n\n$$\n\\begin{aligned}(fg)(4) & =20(4)^{2}-70(4)+60 \\\\  & =320-280+60 \\\\  & =100\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186234199 :knowledge-point/_questions [{:db/id #edb/ref 17592186054612 :knowledge-point/id #uuid "55d291ea-d722-5852-9c3a-faaba8e6df3e" :knowledge-point/title "Evaluating the Quotient of Two Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00a971ff-a0ac-5e41-a6f9-de3fae7b9090" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186413834} {:answer/id #uuid "79f9695d-1add-50ce-be55-ea88b6f4de22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186413843} {:answer/id #uuid "970de561-023f-5e4a-8ecd-0cd2dba960b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186413846} {:answer/id #uuid "e137be1f-e344-5693-8401-73a72931c8a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186413852} {:answer/id #uuid "fb2ca1be-c620-54b9-9e8c-878f37709564" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186413857}] :answer-field/correct {:answer/id #uuid "970de561-023f-5e4a-8ecd-0cd2dba960b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186413846} :answer-field/id #uuid "328f71c0-868a-51e6-9077-92f3e52307b3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186413859}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8d54abce-95cd-5dd9-be80-9f173369bea7" :question/math-academy-id "q-66425" :question/problem "Given $f(x)=2{x}^{2}-6$ and $g(x)=-2x+2,$ find  $(f/g)(3).$" :question/worked-solution "The notation $(f/g)(x)$ means the quotient of the functions $f(x)$ and $g(x).$\n\n**Method 1**\n\nTo evaluate $(f/g)(3),$ we find $f(3)$ and $g(3),$ and then divide the results.\n\nFirst, we find $f(3)$ and $g(3):$\n\n$$\n\\begin{aligned}f(3) & =2(3)^{2}-6=12 \\\\ g(3) & =-2(3)+2=-4\\end{aligned}\n$$\n\n \n\nNow, we divide the results:\n\n$$\n(f/g)(3)=\\frac{f(3)}{g(3)}=\\frac{12}{-4}=-3\n$$\n\n**Method 2**\n\nFirst, we find $(f/g)(x)$ by dividing $f$ by $g$:\n\n$$\n\\begin{aligned}(f/g)(x)=\\frac{2{x}^{2}-6}{-2x+2}\\end{aligned}\n$$\n\nNow, we evaluate $(f/g)(3):$ \n\n$$\n\\begin{aligned}(f/g)(3) & =\\frac{2(3)^{2}-6}{-2(3)+2}=\\frac{12}{-4}=-3\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186413866 :knowledge-point/_questions [{:db/id #edb/ref 17592186054612 :knowledge-point/id #uuid "55d291ea-d722-5852-9c3a-faaba8e6df3e" :knowledge-point/title "Evaluating the Quotient of Two Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ace236d-44ca-52a6-8858-d6e6168991a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186413836} {:answer/id #uuid "596e74cb-e10e-56ee-8a2b-0983ab1a5c46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186413840} {:answer/id #uuid "7494fadd-dd07-5f67-a41d-7917f368d4e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186413842} {:answer/id #uuid "e1f2e513-a3ca-5f51-9c1b-c18eeceadd98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186413853} {:answer/id #uuid "f632d377-ac04-57c7-af38-4a82afb34aaa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186413856}] :answer-field/correct {:answer/id #uuid "f632d377-ac04-57c7-af38-4a82afb34aaa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186413856} :answer-field/id #uuid "5a311d46-6876-5cc8-bd29-ac82b7694535" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186413860}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fe5aa5dd-14e3-52ea-8c5e-90aad88d589b" :question/math-academy-id "q-78620" :question/problem "Find  $(f/g)(-1)$  for $f(x)={x}^{2}+2x$ and $g(x)={x}^{2}+x.$" :question/worked-solution "The notation $(f/g)(x)$ means the quotient of the functions $f(x)$ and $g(x).$ \n\nTo evaluate $(f/g)(-1),$ we find $f(-1)$ and $g(-1),$ and then divide the results. \n\nFirst, we find $f(-1)$ and $g(-1):$\n\n$$\n\\begin{aligned}f(-1) & =(-1)^{2}+2(-1)=-1 \\\\ g(-1) & =(-1)^{2}+(-1)=0\\end{aligned}\n$$\n\n \n\nHowever, since the denominator of a fraction can't be zero, we can't divide $f(-1)$ by $g(-1).$\n\nTherefore, the value  $(f/g)(-1)$  is undefined."}]}
