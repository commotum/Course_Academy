jx-c29\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mo><mjx-tstrut></mjx-tstrut></mjx-mtd></mjx-mtr></mjx-itable></mjx-table></mjx-mtable></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mtable columnalign=\"center center left\" columnspacing=\"1em\" rowspacing=\"0.9em 0.4em\"><mtr><mtd><mi>u</mi><mo>=</mo><mn>6</mn><mi>x</mi></mtd><mtd><mo stretchy=\"false\">⇒</mo></mtd><mtd><msup><mi>u</mi><mo data-mjx-alternate=\"1\">′</mo></msup><mo>=</mo><mn>6</mn></mtd></mtr><mtr><mtd><msup><mi>v</mi><mo data-mjx-alternate=\"1\">′</mo></msup><mo>=</mo><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mo stretchy=\"false\">(</mo><mn>3</mn><mi>x</mi><mo stretchy=\"false\">)</mo></mtd><mtd><mo stretchy=\"false\">⇒</mo></mtd><mtd><mi>v</mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mn>3</mn></mfrac></mstyle><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mo stretchy=\"false\">(</mo><mn>3</mn><mi>x</mi><mo stretchy=\"false\">)</mo><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>Substituting the above into the integration by parts formula, we get\n<mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" display=\"true\" tabindex=\"0\" ctxtmenu_counter=\"152\" style=\"font-size: 119.4%; position: relative;\"><mjx-math display=\"true\" class=\"MJX-TEX\" aria-hidden=\"true\" style=\"margin-left: 0px; margin-right: 0px;\"><mjx-mtable style=\"min-width: 23.681em;\"><mjx-table><mjx-itable><mjx-mtr><mjx-mtd style=\"text-align: right; padding-right: 0px; padding-bottom: 0.4em;\"><mjx-mo class=\"mjx-lop\"><mjx-c class=\"mjx-c222B TEX-S2\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-i\" space=\"2\"><mjx-c class=\"mjx-c1D462 TEX-I\"></mjx-c></mjx-mi><mjx-msup><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D463 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: 0.413em;\"><mjx-mo class=\"mjx