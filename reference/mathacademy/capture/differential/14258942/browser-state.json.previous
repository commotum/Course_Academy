ec</mi><mn>2</mn></msup><mo data-mjx-texclass=\"NONE\">⁡</mo><mo stretchy=\"false\">(</mo><mi>x</mi><mo stretchy=\"false\">)</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>d</mtext><mi>x</mi></mtd><mtd><mo>=</mo><mi>x</mi><mi>tan</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi><mo>−</mo><mo data-mjx-texclass=\"OP\">∫</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi></mrow><mrow><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi></mrow></mfrac></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>d</mtext><mi>x</mi></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><mi>x</mi><mi>tan</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi><mo>−</mo><mo data-mjx-texclass=\"OP\">∫</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mi>u</mi></mfrac></mstyle><mo stretchy=\"false\">(</mo><mo>−</mo><mtext>d</mtext><mi>u</mi><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><mi>x</mi><mi>tan</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi><mo>+</mo><mo data-mjx-texclass=\"OP\">∫</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mi>u</mi></mfrac></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>d</mtext><mi>u</mi></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><mi>x</mi><mi>tan</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi><mo>+</mo><mi>ln</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">|</mo></mrow><mi>u</mi><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">|</mo></mrow><mo>+</mo><mi>C</mi></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><mi>x</mi><mi>tan</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi><mo>+</mo><mi>ln</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">|</mo></mrow><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">|</mo></mrow><mo>+</mo><mi>C</mi></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
