3(2)^{2}=-16\\end{aligned}\n$$\n\nFinally, we write down the equation of the tangent hyperplane:\n\n$$\n\\begin{aligned}w-2 & =(x-2)\\frac{∂f}{∂x}(2,-2,1)+(y+2)\\frac{∂f}{∂y}(2,-2,1)+(z-1)\\frac{∂f}{∂z}(2,-2,1) \\\\ w-2 & =-4(x-2)-15(y+2)-16(z-1) \\\\ w-2 & =-4x+8-15y-30-16z+16 \\\\ 4x+15y+16z+w+4 & =0\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186435554 #edb/ref 1058 #edb/ref 17592186435556 #edb/ref 17592186045417] [17592186435554 #edb/ref 1062 #uuid "0af89c86-dd82-51d3-8a60-9428fdaf17c3" #edb/ref 17592186045417] [17592186435554 #edb/ref 1063 #edb/ref 17592186435551 #edb/ref 17592186045417] [17592186435555 #edb/ref 1062 #uuid "52566cd2-c610-5b7e-a93b-8dfb407f2200" #edb/ref 17592186045417] [17592186435555 #edb/ref 1063 #edb/ref 17592186435553 #edb/ref 17592186045417] [17592186435556 #edb/ref 1058 #edb/ref 17592186435557 #edb/ref 17592186045417] [17592186435556 #edb/ref 1062 #uuid "8189ee1b-e555-5395-af62-45720087b2f5" #edb/ref 17592186045417] [17592186435556 #edb/ref 1063 #edb/ref 17592186435550 #edb/ref 17592186045417] [17592186435557 #edb/ref 1058 #edb/ref 17592186435555 #edb/ref 17592186045417] [17592186435557 #edb/ref 1062 #uuid "9be88cd8-1668-517f-a1dd-283be301d1d2" #edb/ref 17592186045417] [17592186435557 #edb/ref 1063 #edb/ref 17592186435549 #edb/ref 17592186045417] [17592186435558 #edb/ref 1058 #edb/ref 17592186435554 #edb/ref 17592186045417] [17592186435558 #edb/ref 1062 #uuid "a871d925-4e2d-5145-8579-f86cf5c4e2f2" #edb/ref 17592186045417] [17592186435558 #edb/ref 1063 #edb/ref 17592186435552 #edb/ref 17592186045417]}
