#{[{:activity/expected-seconds 660.0 :activity/first-step {:db/id #edb/ref 17592186093069} :activity/id #uuid "d0d2bfed-fc08-50a9-93f7-83f4384c1054" :activity/scope {:db/id #edb/ref 17592186050001 :topic/id #uuid "25757680-24c4-582e-828e-48263c608c8b" :topic/math-academy-id 990} :activity/steps [{:db/id #edb/ref 17592186093069 :step/content {:db/id #edb/ref 17592186093438 :tutorial/content "Consider the matrix ![](images/63/63dd03e425762fa8e9e2e0d33ce552245c6d1c00a12022c433329c3c747cdbba.svg) How can we find its eigenvalues?\n\nBy definition, we need to find the value(s) of $\\,\\lambda\\,$ such that $\\,A\\mathbf{\\color{blue}v} = \\lambda \\mathbf{\\color{blue}v}\\,$ is true for some *non-zero* vector $\\mathbf{\\color{blue}v}.$ Let's re-write this equation as follows:\n\n$$\n\\begin{aligned}Av & =\\lambda v \\\\ Av-\\lambda v & =0 \\\\ Av-\\lambda Iv & =0 \\\\ (A-\\lambda I)v & =0\\end{aligned}\n$$\n\nThe final equation above tells us that there should be at least one non-zero vector $\\mathbf{\\color{blue}v}$ that lies in $\\textrm{Null}(A-\\lambda I)$, the null space of the matrix $A-\\lambda I.$ As a result, the invertible matrix theorem tells us that the matrix $\\, A-\\lambda I \\,$ must be singular, meaning $\\det(A-\\lambda I) = 0.$\n\nWe've reduced the problem to finding the values of $\\lambda$ that satisfy the equation\n\n$$\n\\det(A-\\lambda I) = 0,\n$$\n\nwhich is called the **characteristic equation** of the matrix $A$. So, let's solve it!\n\nFirst, we write down the matrix $A-\\lambda I\\mathbin{:}$\n\n$$\n\\begin{aligned}A\\,-\\,\\lambda I & =[\\begin{aligned}2 & 5 \\\\ -1 & -4\\end{aligned}]\\,-\\,\\lambda [\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}2\\,-\\,\\lambda  & 5 \\\\ -1 & -4\\,-\\,\\lambda \\end{aligned}]\\end{aligned}\n$$\n\nThen, we solve the characteristic equation $\\det(A-\\lambda I) = 0\\mathbin{:}$\n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ |\\begin{aligned}2-\\lambda  & 5 \\\\ -1 & -4-\\lambda \\end{aligned}| & =0 \\\\ (2-\\lambda )(-4-\\lambda )-5\\cdot (-1) & =0 \\\\ -8-2\\lambda +4\\lambda +{\\lambda }^{2}+5 & =0 \\\\ {\\lambda }^{2}+2\\lambda -3 & =0 \\\\ (\\lambda +3)(\\lambda -1) & =0\\end{aligned}\n$$\n\nTherefore, the eigenvalues of $A$ are $\\lambda=-3$ and $\\lambda=1.$" :tutorial/id #uuid "992adb24-3547-5b71-bb96-561b2f90f721" :tutorial/math-academy-id 3559 :tutorial/title "Introduction"} :step/id #uuid "aa3f5d68-5f04-578d-b46e-4900e8496c29" :step/math-academy-id 20080 :step/next {:db/id #edb/ref 17592186093070}} {:db/id #edb/ref 17592186093070 :step/content {:db/id #edb/ref 17592186092229 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092074 :question/id #uuid "aebe3048-cc5b-5340-a15e-d577ae2ee72a" :question/math-academy-id "e-5479"} :knowledge-point/id #uuid "cbf5fbb2-688a-5833-87b9-37229c8fb692" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049044}] :knowledge-point/questions [{:db/id #edb/ref 17592186092689} {:db/id #edb/ref 17592186092690} {:db/id #edb/ref 17592186243988} {:db/id #edb/ref 17592186244111} {:db/id #edb/ref 17592186323851} {:db/id #edb/ref 17592186345208} {:db/id #edb/ref 17592186426473} {:db/id #edb/ref 17592186426474}] :knowledge-point/title "Finding the Characteristic Equation of a Matrix"} :step/id #uuid "89493310-e194-5bc4-bea0-893a5af03e16" :step/math-academy-id 20082 :step/next {:db/id #edb/ref 17592186093072}} {:db/id #edb/ref 17592186093071 :step/content {:db/id #edb/ref 17592186092230 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092075 :question/id #uuid "55e695b2-4581-5ba7-9604-506234b88323" :question/math-academy-id "e-5480"} :knowledge-point/id #uuid "0d235bca-d848-5075-affb-09e3103cfc11" :knowledge-point/questions [{:db/id #edb/ref 17592186092691} {:db/id #edb/ref 17592186092903} {:db/id #edb/ref 17592186244110} {:db/id #edb/ref 17592186323849} {:db/id #edb/ref 17592186402502} {:db/id #edb/ref 17592186402509} {:db/id #edb/ref 17592186426470}] :knowledge-point/title "Computing the Eigenvalues of a Matrix With At Most One Distinct Eigenvalue"} :step/id #uuid "04fc546d-cc73-521c-b37b-04a57e324df2" :step/math-academy-id 20083 :step/next {:db/id #edb/ref 17592186093074}} {:db/id #edb/ref 17592186093072 :step/content {:db/id #edb/ref 17592186093439 :tutorial/content "The characteristic equation of any $2 \\!\\times\\! 2$ matrix $A$ is always a quadratic equation, which implies that $A$ has at most $2$ eigenvalues. Here are the all possible cases:\n\n- Two distinct real eigenvalues\n\n- One repeated real eigenvalue (or, equivalently, two real eigenvalues that are the same)\n\n- No real eigenvalues (or, equivalently, two complex eigenvalues)" :tutorial/id #uuid "3ec52280-5c5a-5e6f-bcbe-328634cbfecf" :tutorial/math-academy-id 3560 :tutorial/title "The Number of Real Eigenvalues of a 2x2 Matrix"} :step/id #uuid "75bc9629-a0a2-557a-b062-e66b006ea327" :step/math-academy-id 20084 :step/next {:db/id #edb/ref 17592186093073}} {:db/id #edb/ref 17592186093073 :step/content {:db/id #edb/ref 17592186092231 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092076 :question/id #uuid "a42d0af8-869c-5c2a-8182-22b14b9546e2" :question/math-academy-id "e-5481"} :knowledge-point/id #uuid "864cf210-cbb0-5a79-b90a-33a5df332559" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048774} {:db/id #edb/ref 17592186050465}] :knowledge-point/questions [{:db/id #edb/ref 17592186092529} {:db/id #edb/ref 17592186092902} {:db/id #edb/ref 17592186253608} {:db/id #edb/ref 17592186256754} {:db/id #edb/ref 17592186357549} {:db/id #edb/ref 17592186357550} {:db/id #edb/ref 17592186396223}] :knowledge-point/title "Computing the Eigenvalues of a Matrix With Two Distinct Eigenvalues"} :step/id #uuid "78e02a6a-545a-511e-a2f5-b45e357cb0fe" :step/math-academy-id 20085 :step/next {:db/id #edb/ref 17592186093071}} {:db/id #edb/ref 17592186093074 :step/content {:db/id #edb/ref 17592186092232 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092077 :question/id #uuid "9e40836e-18e9-5df6-a930-05875b920335" :question/math-academy-id "e-5482"} :knowledge-point/id #uuid "6cd4158d-6baf-5a61-96a2-74c66231d082" :knowledge-point/questions [{:db/id #edb/ref 17592186092516} {:db/id #edb/ref 17592186092688} {:db/id #edb/ref 17592186243993} {:db/id #edb/ref 17592186244109} {:db/id #edb/ref 17592186345209} {:db/id #edb/ref 17592186399601} {:db/id #edb/ref 17592186426471} {:db/id #edb/ref 17592186426472}] :knowledge-point/title "Calculating the Eigenvalues of a Triangular/Diagonal Matrix"} :step/id #uuid "75d3f2ae-a3c8-5016-8ccf-895f6655ebd0" :step/math-academy-id 20087}] :activity/title "Calculating the Eigenvalues of a 2x2 Matrix" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186092464}]}
