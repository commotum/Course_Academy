ref 17592186446663} {:answer/id #uuid "956a468e-b06e-5bee-8c3c-ec586866b569" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =-5$ and $\\lambda =-1$" :db/id #edb/ref 17592186446681} {:answer/id #uuid "a173a3e7-290e-5032-aef3-774d0ec21fe5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =5$ (double root)" :db/id #edb/ref 17592186446685} {:answer/id #uuid "d243faea-e0d3-5179-9ed1-a7f88786cefc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =-1$ and $\\lambda =5$" :db/id #edb/ref 17592186446700} {:answer/id #uuid "fa490009-2047-5aaf-930f-ab551852d4a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =1$ (double root)" :db/id #edb/ref 17592186446714}] :answer-field/correct {:answer/id #uuid "d243faea-e0d3-5179-9ed1-a7f88786cefc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =-1$ and $\\lambda =5$" :db/id #edb/ref 17592186446700} :answer-field/id #uuid "3b447c11-2343-5e3b-9317-039ab756a40a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186446719}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0d05d968-12a6-5808-b925-0cd007f4210b" :question/math-academy-id "q-107982" :question/problem "Find all real eigenvalues of the matrix \n$P=[\\begin{aligned}1 & 4 \\\\ 2 & 3\\end{aligned}].$" :question/worked-solution "Let's start by writing the matrix $P-\\lambda I:$\n﻿﻿﻿\n\n$$\nP-\\lambda I=[\\begin{aligned}1-\\lambda  & 4 \\\\ 2 & 3-\\lambda \\end{aligned}]\n$$\n\nNow, let's find and solve the characteristic equation $det(P-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(P-\\lambda I) & =0 \\\\ |\\begin{aligned}1-\\lambda  & 4 \\\\ 2 & 3-\\lambda \\end{aligned}| & =0 \\\\ (1-\\lambda )(3-\\lambda )-2\\cdot 4 & =0 \\\\ 3-\\lambda -3\\lambda +{\\lambda }^{2}-8 & =0 \\\\ {\\lambda }^{2}-4\\lambda -5 & =0\\end{aligned}\n$$\n\nUsing the quadratic formula, we obtain\n\n$$\n\\begin{aligned}\\lambda  & =\\frac{4\\pm \\sqrt{(-4)^{2}-4\\cdot 1\\cdot (-5)}}{2\\cdot 1} \\\\  & =\\frac{4\\pm \\sqrt{36}}{2} \\\\  & =\\frac{4\\pm 6}{2} \\\\  & =5,-1.\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda =-1$ and $\\lambda =5.$"}] [{:db/id #edb/ref 17592186446731 :knowledge-point/_questions [{:db/id #edb/ref 17592186092229 :knowledge-point/id #uuid "cbf5fbb2-688a-5833-87b9-37229c8fb692" :knowledge-point/title "Finding the Characteristic Equation of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0213af8b-e153-5a9f-bcae-d28d03ed5a5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }^{2}-\\lambda +15=0" :db/id #edb/ref 17592186446634} {:answer/id #uuid "09d9b377-d154-58c3-9816-cc93e5ae714f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }^{2}+\\lambda -5=0" :db/id #edb/ref 17592186446635} {:answer/id #uuid "8c1e288e-9f0e-5aa1-a99f-65dcd2f40da3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }^{2}+8\\lambda -35=0" :db/id #edb/ref 17592186446677} {:answer/id #uuid "c55c3bab-e95d-5b9c-87f7-f189a3394e07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }^{2}+8\\lambda +15=0" :db/id #edb/ref 17592186446693} {:answer/id #uuid "eb843c49-7c9d-5188-a745-423ff5070742" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }^{2}+15\\lambda +5=0" :db/id #edb/ref 17592186446705}] :answer-field/correct {:answer/id #uuid "c55c3bab-e95d-5b9c-87f7-f189a3394e07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }^{2}+8\\lambda +15=0" :db/id #edb/ref 17592186446693} :answer-field/id #uuid "7076766c-bcdf-54a7-b381-7806ea7001fb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186446724}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0b0fd647-11bd-5cf6-9bab-c8f19524ee42" :question/math-academy-id "q-107986" :question/problem "Find the characteristic equation of the matrix $A=[\\begin{aligned}2 & -7 \\\\ 5 & -10\\end{aligned}].$" :question/worked-solution "First, we find the matrix $\\,A-\\lambda I:$\n﻿﻿﻿\n\n$$\nA-\\lambda I=[\\begin{aligned}2-\\lambda  & -7 \\\\ 5 & -10-\\lambda \\end{aligned}].\n$$\n\nThen, the characteristic equation is\n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ |\\begin{aligned}2-\\lambda  & -7 \\\\ 5 & -10-\\lambda \\end{aligned}| & =0 \\\\ (2-\\lambda )(-10-\\lambda )-5\\cdot (-7) & =0 \\\\ -20-2\\lambda +10\\lambda +{\\lambda }^{2}+35 & =0 \\\\ {\\lambda }^{2}+8\\lambda +15 & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244111 :knowledge-point/_questions [{:db/id #edb/ref 17592186092229 :knowledge-point/id #uuid "cbf5fbb2-688a-5833-87b9-37229c8fb692" :knowledge-point/title "Finding the Characteristic Equation of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d5cd195-916d-51d3-a145-ac3d8abbdf92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }^{2}-3\\lambda -40=0" :db/id #edb/ref 17592186241427} {:answer/id #uuid "2bdfc526-d86a-5e73-baca-2112c1ad2358" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }^{2}-3\\lambda +40=0" :db/id #edb/ref 17592186241571} {:answer/id #uuid "35403cd9-ea2a-5b57-971f-4e9e59069317" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }^{2}-\\lambda -40=0" :db/id #edb/ref 17592186241646} {:answer/id #uuid "a5cf22be-62ee-5bda-9228-41b20aca0652" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }^{2}+\\lambda -10=0" :db/id #edb/ref 17592186242639} {:answer/id #uuid "dd32357c-ec00-5793-bb30-3f656df8bc88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }^{2}-4\\lambda +10=0" :db/id #edb/ref 17592186243148}] :answer-field/correct {:answer/id #uuid "1d5cd195-916d-51d3-a145-ac3d8abbdf92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }^{2}-3\\lambda -40=0" :db/id #edb/ref 17592186241427} :answer-field/id #uuid "9d00855c-44e0-5a49-b0df-a66417f8be4f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243729}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "11ba9d38-2921-5184-bf8a-8d9ae2f12bf8" :question/math-academy-id "q-107987" :question/problem "Find the characteristic equation of the matrix \n$B=[\\begin{aligned}8 & 0 \\\\ 6 & -5\\end{aligned}].$" :question/worked-solution "First, we find the matrix $\\,B-\\lambda I:$\n﻿﻿﻿\n\n$$\nB-\\lambda I=[\\begin{aligned}8-\\lambda  & 0 \\\\ 6 & -5-\\lambda \\end{aligned}].\n$$\n\nThen, the characteristic equation is\n\n$$\n\\begin{aligned}det(B-\\lambda I) & =0 \\\\ |\\begin{aligned}8-\\lambda  & 0 \\\\ 6 & -5-\\lambda \\end{aligned}| & =0 \\\\ (8-\\lambda )(-5-\\lambda )-6\\cdot 0 & =0 \\\\ -40-8\\lambda +5\\lambda +{\\lambda }^{2} & =0 \\\\ {\\lambda }^{2}-3\\lambda -40 & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186446742 :knowledge-point/_questions [{:db/id #edb/ref 17592186092231 :knowledge-point/id #uuid "864cf210-cbb0-5a79-b90a-33a5df332559" :knowledge-point/title "Computing the Eigenvalues of a Matrix With Two Distinct Eigenvalues"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ee3c296-e699-5a89-9d1d-f1037248664d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186446637} {:answer/id #uuid "82038ac4-a96c-5a3c-b35c-2282a0dcbbe1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =-6$  (double root)" :db/id #edb/ref 17592186446672} {:answer/id #uuid "b88cc7bb-ae8f-5c80-a43e-0886bc245383" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =-6$ and $\\lambda =4$" :db/id #edb/ref 17592186446688} {:answer/id #uuid "beb9ae44-9c2f-5ff1-949c-f0430bfe2729" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =-2$ and $\\lambda =4$" :db/id #edb/ref 17592186446690} {:answer/id #uuid "c7d63c00-47c6-5ea0-81b5-0ff89c996117" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =-6$ and $\\lambda =-4$" :db/id #edb/ref 17592186446694}] :answer-field/correct {:answer/id #uuid "c7d63c00-47c6-5ea0-81b5-0ff89c996117" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =-6$ and $\\lambda =-4$" :db/id #edb/ref 17592186446694} :answer-field/id #uuid "72630b4f-5b3f-5c7f-b8aa-ef29d3000b9a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186446725}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "95ae8df3-3e3d-5382-b3db-f47a4094753f" :question/math-academy-id "q-12293" :question/problem "Find all real eigenvalues of the matrix \n$P=[\\begin{aligned}-5 & 1 \\\\ 1 & -5\\end{aligned}].$" :question/worked-solution "Let's start by writing the matrix $P-\\lambda I:$\n﻿﻿﻿\n\n$$\nP-\\lambda I=[\\begin{aligned}-5-\\lambda  & 1 \\\\ 1 & -5-\\lambda \\end{aligned}].\n$$\n\nNow, let's find and solve the characteristic equation $det(P-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(P-\\lambda I) & =0 \\\\ |\\begin{aligned}-5-\\lambda  & 1 \\\\ 1 & -5-\\lambda \\end{aligned}| & =0 \\\\ (-5-\\lambda )(-5-\\lambda )-1\\cdot 1 & =0 \\\\ 25+5\\lambda +5\\lambda +{\\lambda }^{2}-1 & =0 \\\\ {\\lambda }^{2}+10\\lambda +24 & =0\\end{aligned}\n$$\n\nUsing the quadratic formula, we obtain\n\n$$\n\\begin{aligned}\\lambda  & =\\frac{-10\\pm \\sqrt{{10}^{2}-4\\cdot 1\\cdot 24}}{2} \\\\  & =\\frac{-10\\pm \\sqrt{4}}{2} \\\\  & =\\frac{-10\\pm 2}{2} \\\\  & =-6,-4.\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda =-6$ and $\\lambda =-4.$"}] [{:db/id #edb/ref 17592186446739 :knowledge-point/_questions [{:db/id #edb/ref 17592186092231 :knowledge-point/id #uuid "864cf210-cbb0-5a79-b90a-33a5df332559" :knowledge-point/title "Computing the Eigenvalues of a Matrix With Two Distinct Eigenvalues"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b87526d-2246-50c0-91fd-daa6bec84acf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =1$ and $\\lambda =3$" :db/id #edb/ref 17592186446647} {:answer/id #uuid "6b480b06-9772-5260-8335-48075d9da61c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =-1$ (double root)" :db/id #edb/ref 17592186446662} {:answer/id #uuid "93f12a44-5d1a-5651-a8b8-32b93c9ffdef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186446680} {:answer/id #uuid "b58f6d79-5ae8-55ec-a9dd-9618b7883532" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =3$ and $\\lambda =-1$" :db/id #edb/ref 17592186446687} {:answer/id #uuid "e9f8b635-dc16-5331-b1fb-d3f18e1d1de5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =-1$ and $\\lambda =1$" :db/id #edb/ref 17592186446704}] :answer-field/correct {:answer/id #uuid "e9f8b635-dc16-5331-b1fb-d3f18e1d1de5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =-1$ and $\\lambda =1$" :db/id #edb/ref 17592186446704} :answer-field/id #uuid "4019788e-b3f0-5d69-b057-88ed3798f2cb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186446720}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7beb1182-833d-5c48-8b2c-88ca021df959" :question/math-academy-id "q-12294" :question/problem "Find all real eigenvalues of the matrix \n$B=[\\begin{aligned}-8 & 7 \\\\ -9 & 8\\end{aligned}].$" :question/worked-solution "Let's start by writing the matrix $B-\\lambda I:$\n﻿﻿﻿\n\n$$\nB-\\lambda I=[\\begin{aligned}-8-\\lambda  & 7 \\\\ -9 & 8-\\lambda \\end{aligned}].\n$$\n\nNow, let's find and solve the characteristic equation $det(B-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(B-\\lambda I) & =0 \\\\ |\\begin{aligned}-8-\\lambda  & 7 \\\\ -9 & 8-\\lambda \\end{aligned}| & =0 \\\\ (-8-\\lambda )(8-\\lambda )-7\\cdot (-9) & =0 \\\\ -64+8\\lambda -8\\lambda +{\\lambda }^{2}+63 & =0 \\\\ {\\lambda }^{2}-1 & =0 \\\\ (\\lambda +1)(\\lambda -1) & =0.\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda =-1$ and $\\lambda =1.$"}] [{:db/id #edb/ref 17592186446736 :knowledge-point/_questions [{:db/id #edb/ref 17592186092231 :knowledge-point/id #uuid "864cf210-cbb0-5a79-b90a-33a5df332559" :knowledge-point/title "Computing the Eigenvalues of a Matrix With Two Distinct Eigenvalues"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1de09d46-850c-56fb-987f-3452a117032d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =-7$ and $\\lambda =2$" :db/id #edb/ref 17592186446642} {:answer/id #uuid "74c14f3c-9cab-5b7a-ac87-feb91e66599f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186446667} {:answer/id #uuid "8eb7b9b2-8faa-570c-b54b-291054c89688" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =7$ and $\\lambda =2$" :db/id #edb/ref 17592186446679} {:answer/id #uuid "c805c3e2-c747-567c-9254-772bf262c4ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =-7$ (double root)" :db/id #edb/ref 17592186446695} {:answer/id #uuid "f57eb3c3-c429-58ea-8bc7-183c23c639f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =-6$ and $\\lambda =2$" :db/id #edb/ref 17592186446712}] :answer-field/correct {:answer/id #uuid "1de09d46-850c-56fb-987f-3452a117032d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =-7$ and $\\lambda =2$" :db/id #edb/ref 17592186446642} :answer-field/id #uuid "9dde9c69-e4af-5813-b923-f6b3bb4c7cb4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186446727}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "649da0b4-9af9-52b6-817f-cca5e0eb449f" :question/math-academy-id "q-12298" :question/problem "Find all real eigenvalues of the matrix\n$U=[\\begin{aligned}-2 & 5 \\\\ 4 & -3\\end{aligned}].$" :question/worked-solution "Let's start by writing the matrix $U-\\lambda I:$\n﻿﻿﻿\n\n$$\nU-\\lambda I=[\\begin{aligned}-2-\\lambda  & 5 \\\\ 4 & -3-\\lambda \\end{aligned}].\n$$\n\nNow, let's find and solve the characteristic equation $det(U-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(U-\\lambda I) & =0 \\\\ |\\begin{aligned}-2-\\lambda  & 5 \\\\ 4 & -3-\\lambda \\end{aligned}| & =0 \\\\ (-2-\\lambda )(-3-\\lambda )-5\\cdot 4 & =0 \\\\ 6+2\\lambda +3\\lambda +{\\lambda }^{2}-20 & =0 \\\\ {\\lambda }^{2}+5\\lambda -14 & =0\\end{aligned}\n$$\n\nUsing the quadratic formula, we obtain\n\n$$\n\\begin{aligned}\\lambda  & =\\frac{-5\\pm \\sqrt{{5}^{2}+4\\cdot 1\\cdot 14}}{2} \\\\  & =\\frac{-5\\pm \\sqrt{81}}{2} \\\\  & =\\frac{-5\\pm 9}{2} \\\\  & =-7,2.\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda =-7$ and $\\lambda =2.$"}] [{:db/id #edb/ref 17592186446737 :knowledge-point/_questions [{:db/id #edb/ref 17592186092230 :knowledge-point/id #uuid "0d235bca-d848-5075-affb-09e3103cfc11" :knowledge-point/title "Computing the Eigenvalues of a Matrix With At Most One Distinct Eigenvalue"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1143f7a7-3c20-50bb-b995-564624c93a52" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =9$ and $\\lambda =-6$" :db/id #edb/ref 17592186446639} {:answer/id #uuid "17a34526-21cf-53cf-aa39-d12402af539d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186446640} {:answer/id #uuid "1fdece1b-ac27-5958-a1d9-138dda9c3a7d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =7$  (double root)" :db/id #edb/ref 17592186446643} {:answer/id #uuid "33cfa4f0-b28e-5bca-a516-62e8607d6074" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =4$ and $\\lambda =5$" :db/id #edb/ref 17592186446649} {:answer/id #uuid "43843bb9-eeeb-51b0-be25-7866a7b2aeba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =3$ and $\\lambda =-5$" :db/id #edb/ref 17592186446653}] :answer-field/correct {:answer/id #uuid "17a34526-21cf-53cf-aa39-d12402af539d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186446640} :answer-field/id #uuid "3850d5ad-9421-5f33-bc57-b428d8dacd98" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186446718}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "688b15c3-44c2-5c91-89ca-dd25252cd049" :question/math-academy-id "q-36772" :question/problem "Find all real eigenvalues of the matrix\n$L=[\\begin{aligned}3 & 6 \\\\ -9 & -11\\end{aligned}].$" :question/worked-solution "Let's start by writing the matrix $L-\\lambda I:$\n﻿﻿﻿\n\n$$\nL-\\lambda I=[\\begin{aligned}3-\\lambda  & 6 \\\\ -9 & -11-\\lambda \\end{aligned}].\n$$\n\nNow, let's find and solve the characteristic equation $det(L-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(L-\\lambda I) & =0 \\\\ |\\begin{aligned}3-\\lambda  & 6 \\\\ -9 & -11-\\lambda \\end{aligned}| & =0 \\\\ (3-\\lambda )(-11-\\lambda )-6\\cdot (-9) & =0 \\\\ -33-3\\lambda +11\\lambda +{\\lambda }^{2}+54 & =0 \\\\ {\\lambda }^{2}+8\\lambda +21 & =0\\end{aligned}\n$$\n\nComputing the discriminant of the quadratic equation above, we obtain \n\n$$\n\\begin{aligned}D & ={8}^{2}-4\\cdot 1\\cdot 21 \\\\  & =64-84 \\\\  & =-20 \\\\  & <0.\\end{aligned}\n$$\n\nTherefore, we conclude that the characteristic equation does not have real solutions and therefore $L$ does not have real eigenvalues."}] [{:db/id #edb/ref 17592186402509 :knowledge-point/_questions [{:db/id #edb/ref 17592186092230 :knowledge-point/id #uuid "0d235bca-d848-5075-affb-09e3103cfc11" :knowledge-point/title "Computing the Eigenvalues of a Matrix With At Most One Distinct Eigenvalue"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ad3afc0-1147-5a90-b327-46c419abae45" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =7$ (double root)" :db/id #edb/ref 17592186402511} {:answer/id #uuid "bebf86c2-9d02-56e0-8de7-e3c093fdb99b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =-7$ and $\\lambda =7$" :db/id #edb/ref 17592186402512} {:answer/id #uuid "1fe3b5b3-5b53-5af3-a386-d1a9cac7570e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186402513} {:answer/id #uuid "5e1b2964-fbf6-54e9-a3dc-5eb4004c5b91" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =7$ and $\\lambda =-5$" :db/id #edb/ref 17592186402514} {:answer/id #uuid "00de227b-1e08-5a35-a745-88b3e218426e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =-5$ and $\\lambda =1$" :db/id #edb/ref 17592186402515}] :answer-field/correct {:answer/id #uuid "1fe3b5b3-5b53-5af3-a386-d1a9cac7570e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186402513} :answer-field/id #uuid "9c905a94-1e61-56fb-85f0-520ef6a3631a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402510}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1fda33b2-0f78-5ef6-abce-da9e465c13f7" :question/math-academy-id "q-36780" :question/problem "Find all real eigenvalues of the matrix\n$P=[\\begin{aligned}7 & 1 \\\\ -5 & 7\\end{aligned}].$" :question/worked-solution "Let's start by writing the matrix $P-\\lambda I:$\n﻿﻿﻿\n\n$$\nP-\\lambda I=[\\begin{aligned}7-\\lambda  & 1 \\\\ -5 & 7-\\lambda \\end{aligned}].\n$$\n\nNow, let's find and solve the characteristic equation $det(P-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(P-\\lambda I) & =0 \\\\ |\\begin{aligned}7-\\lambda  & 1 \\\\ -5 & 7-\\lambda \\end{aligned}| & =0 \\\\ (7-\\lambda )(7-\\lambda )-1\\cdot (-5) & =0 \\\\ 49-7\\lambda -7\\lambda +{\\lambda }^{2}+5 & =0 \\\\ {\\lambda }^{2}-14\\lambda +54 & =0\\end{aligned}\n$$\n\nComputing the discriminant of the quadratic equation above, we obtain \n\n$$\n\\begin{aligned}D & =(-14)^{2}-4\\cdot 1\\cdot 54 \\\\  & =196-216 \\\\  & =-20 \\\\  & <0.\\end{aligned}\n$$\n\nTherefore, we conclude that the characteristic equation does not have real solutions and therefore $P$ does not have real eigenvalues."}] [{:db/id #edb/ref 17592186446738 :knowledge-point/_questions [{:db/id #edb/ref 17592186092230 :knowledge-point/id #uuid "0d235bca-d848-5075-affb-09e3103cfc11" :knowledge-point/title "Computing the Eigenvalues of a Matrix With At Most One Distinct Eigenvalue"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22ccfd10-2e0b-576f-8601-ee2b077cab77" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186446644} {:answer/id #uuid "29073a5f-e09c-5fc6-ac4e-971be56c9568" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =7$ and $\\lambda =-5$" :db/id #edb/ref 17592186446645} {:answer/id #uuid "3a1665e4-efa6-5ed5-bd33-ac9a8949a3fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =-7$ and $\\lambda =5$" :db/id #edb/ref 17592186446650} {:answer/id #uuid "7659b379-5d6c-548c-992e-76e7eb504258" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =-5$ and $\\lambda =1$" :db/id #edb/ref 17592186446669} {:answer/id #uuid "edc626a6-c9de-5b6a-9f82-091af50ae152" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =-7$ (double root)" :db/id #edb/ref 17592186446707}] :answer-field/correct {:answer/id #uuid "22ccfd10-2e0b-576f-8601-ee2b077cab77" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186446644} :answer-field/id #uuid "6829d208-f258-5b19-bd9a-4cdd3c37dde5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186446723}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6ff2d918-34fd-53ce-9a32-6157ad95bf62" :question/math-academy-id "q-36781" :question/problem "Find all real eigenvalues of the matrix\n$U=[\\begin{aligned}-7 & 5 \\\\ -1 & -7\\end{aligned}].$" :question/worked-solution "Let's start by writing the matrix $U-\\lambda I:$\n﻿﻿﻿\n\n$$\nU-\\lambda I=[\\begin{aligned}-7-\\lambda  & 5 \\\\ -1 & -7-\\lambda \\end{aligned}].\n$$\n\nNow, let's find and solve the characteristic equation $det(U-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(U-\\lambda I) & =0 \\\\ |\\begin{aligned}-7-\\lambda  & 5 \\\\ -1 & -7-\\lambda \\end{aligned}| & =0 \\\\ (-7-\\lambda )(-7-\\lambda )-5\\cdot (-1) & =0 \\\\ 49+7\\lambda +7\\lambda +{\\lambda }^{2}+5 & =0 \\\\ {\\lambda }^{2}+14\\lambda +54 & =0\\end{aligned}\n$$\n\nComputing the discriminant of the quadratic equation above, we obtain \n\n$$\n\\begin{aligned}D & ={14}^{2}-4\\cdot 1\\cdot 54 \\\\  & =196-216 \\\\  & =-20 \\\\  & <0.\\end{aligned}\n$$\n\nTherefore, we conclude that the characteristic equation does not have real solutions and therefore $U$ does not have real eigenvalues."}] [{:db/id #edb/ref 17592186446735 :knowledge-point/_questions [{:db/id #edb/ref 17592186092229 :knowledge-point/id #uuid "cbf5fbb2-688a-5833-87b9-37229c8fb692" :knowledge-point/title "Finding the Characteristic Equation of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "68d692e8-2c9b-54e7-a366-01c7bd296385" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\sqrt{3}-\\lambda )(1-\\lambda )-\\sqrt{7}=0" :db/id #edb/ref 17592186446661} {:answer/id #uuid "70faf1f1-23c6-58e4-bf59-0e879757a31f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\sqrt{3}+\\lambda )(1-\\lambda )=0" :db/id #edb/ref 17592186446665} {:answer/id #uuid "c9ec6264-3ee5-5365-b892-5188665949f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\sqrt{3}+\\lambda )(1+\\lambda )=0" :db/id #edb/ref 17592186446696} {:answer/id #uuid "f29c22a6-dc15-5878-997c-e48683c9fce5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\sqrt{3}+\\lambda )(1+\\lambda )-\\sqrt{7}=0" :db/id #edb/ref 17592186446710} {:answer/id #uuid "f8320f69-edc7-50c1-b592-2506954adc67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\sqrt{3}-\\lambda )(1-\\lambda )=0" :db/id #edb/ref 17592186446713}] :answer-field/correct {:answer/id #uuid "f8320f69-edc7-50c1-b592-2506954adc67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\sqrt{3}-\\lambda )(1-\\lambda )=0" :db/id #edb/ref 17592186446713} :answer-field/id #uuid "7fe5a947-f078-594e-9bf7-dde3c2b3ec2f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186446726}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "548202ea-0779-523d-b823-a5921b15b56b" :question/math-academy-id "q-76342" :question/problem "Find the characteristic equation of the matrix $M=[\\begin{aligned}\\sqrt{3} & \\sqrt{7} \\\\ 0 & 1\\end{aligned}].$" :question/worked-solution "First, we find the matrix $\\,M-\\lambda I:$\n﻿﻿﻿\n\n$$\nM-\\lambda I=[\\begin{aligned}\\sqrt{3}-\\lambda  & \\sqrt{7} \\\\ 0 & 1-\\lambda \\end{aligned}].\n$$\n\nThen, the characteristic equation is\n\n$$\n\\begin{aligned}det(M-\\lambda I) & =0 \\\\ |\\begin{aligned}\\sqrt{3}-\\lambda  & \\sqrt{7} \\\\ 0 & 1-\\lambda \\end{aligned}| & =0 \\\\ (\\sqrt{3}-\\lambda )(1-\\lambda )-0\\cdot \\sqrt{7} & =0 \\\\ (\\sqrt{3}-\\lambda )(1-\\lambda ) & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186426471 :knowledge-point/_questions [{:db/id #edb/ref 17592186092232 :knowledge-point/id #uuid "6cd4158d-6baf-5a61-96a2-74c66231d082" :knowledge-point/title "Calculating the Eigenvalues of a Triangular/Diagonal Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a25f6950-9088-5ff9-8175-877d50a81da1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =1$ and $\\lambda =\\frac{5}{2}$" :db/id #edb/ref 17592186426452} {:answer/id #uuid "a4036eef-ab8d-5137-83eb-70652e3c8c6d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =0$ and $\\lambda =\\frac{5}{2}$" :db/id #edb/ref 17592186426453} {:answer/id #uuid "d1c7c087-5672-5851-ae11-572422abc236" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186426458} {:answer/id #uuid "d5281683-5678-50f6-a3d4-31872aa9352f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =2$ and $\\lambda =-\\frac{5}{2}$" :db/id #edb/ref 17592186426460} {:answer/id #uuid "f7818e8c-878b-5236-95a6-67cb75479fd9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =\\frac{5}{2}$ (double root)" :db/id #edb/ref 17592186426464}] :answer-field/correct {:answer/id #uuid "a4036eef-ab8d-5137-83eb-70652e3c8c6d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =0$ and $\\lambda =\\frac{5}{2}$" :db/id #edb/ref 17592186426453} :answer-field/id #uuid "6ff870f2-a00f-5d9f-a34a-712ea4371cad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186426466}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "95fd78c2-6907-5df8-b9fe-1452968ce01b" :question/math-academy-id "q-76362" :question/problem "Find all real eigenvalues of the matrix\n$L=[\\begin{aligned}0 & 0 \\\\ 2 & \\frac{5}{2}\\end{aligned}].$" :question/worked-solution "Let's start by writing the matrix $L-\\lambda I:$\n﻿﻿﻿\n\n$$\nL-\\lambda I=[\\begin{aligned}0-\\lambda  & 0 \\\\ 2 & \\frac{5}{2}-\\lambda \\end{aligned}]\n$$\n\nNow, let's find and solve the characteristic equation $det(L-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(L-\\lambda I) & =0 \\\\ |\\begin{aligned}-\\lambda  & 0 \\\\ 2 & \\frac{5}{2}-\\lambda \\end{aligned}| & =0 \\\\ (-\\lambda )(\\frac{5}{2}-\\lambda )-2\\cdot 0 & =0 \\\\ \\lambda (\\lambda -\\frac{5}{2}) & =0\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda =0$ and $\\lambda =\\frac{5}{2}.$\n\n**Note:** The eigenvalues of a triangular (or diagonal) matrix are the entries on the main diagonal."}] [{:db/id #edb/ref 17592186446733 :knowledge-point/_questions [{:db/id #edb/ref 17592186092232 :knowledge-point/id #uuid "6cd4158d-6baf-5a61-96a2-74c66231d082" :knowledge-point/title "Calculating the Eigenvalues of a Triangular/Diagonal Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "311e8f46-648a-5c98-ae9c-c09e69f012d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =\\sqrt{13}$ and $\\lambda =\\sqrt{17}$" :db/id #edb/ref 17592186446648} {:answer/id #uuid "6efd6b7d-bdc0-5be0-b513-c19d0b047800" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =\\sqrt{17}$ and $\\lambda =\\frac{1}{2}$" :db/id #edb/ref 17592186446664} {:answer/id #uuid "84f65cb8-d626-588c-b078-563da250f9ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =\\sqrt{13}$ and $\\lambda =\\frac{1}{2}$" :db/id #edb/ref 17592186446673} {:answer/id #uuid "9954f005-4623-5ab9-8eee-41291e4fa96c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186446682} {:answer/id #uuid "c13f05a3-3e57-51ad-abad-91529834d620" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =\\sqrt{17}$ (double root)" :db/id #edb/ref 17592186446691}] :answer-field/correct {:answer/id #uuid "84f65cb8-d626-588c-b078-563da250f9ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =\\sqrt{13}$ and $\\lambda =\\frac{1}{2}$" :db/id #edb/ref 17592186446673} :answer-field/id #uuid "0dae1e56-95f5-5008-8851-38bbfc769453" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186446717}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "463f0d10-4286-59ff-a21d-e7909700880b" :question/math-academy-id "q-76363" :question/problem "Find all real eigenvalues of the matrix\n$M=[\\begin{aligned}\\sqrt{13} & \\sqrt{17} \\\\ 0 & \\frac{1}{2}\\end{aligned}].$" :question/worked-solution "Let's start by writing the matrix $M-\\lambda I:$\n﻿﻿﻿\n\n$$\nM-\\lambda I=[\\begin{aligned}\\sqrt{13}-\\lambda  & \\sqrt{17} \\\\ 0 & \\frac{1}{2}-\\lambda \\end{aligned}]\n$$\n\nNow, let's find and solve the characteristic equation $det(M-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(M-\\lambda I) & =0 \\\\ |\\begin{aligned}\\sqrt{13}-\\lambda  & \\sqrt{17} \\\\ 0 & \\frac{1}{2}-\\lambda \\end{aligned}| & =0 \\\\ (\\sqrt{13}-\\lambda )(\\frac{1}{2}-\\lambda )-0\\cdot \\sqrt{17} & =0 \\\\ (\\lambda -\\sqrt{13})(\\lambda -\\frac{1}{2}) & =0\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda =\\sqrt{13}$ and $\\lambda =\\frac{1}{2}.$\n\n**Note:** The eigenvalues of a triangular (or diagonal) matrix are the entries on the main diagonal."}] [{:db/id #edb/ref 17592186092902 :knowledge-point/_questions [{:db/id #edb/ref 17592186092231 :knowledge-point/id #uuid "864cf210-cbb0-5a79-b90a-33a5df332559" :knowledge-point/title "Computing the Eigenvalues of a Matrix With Two Distinct Eigenvalues"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "387e4d1f-ffff-549c-ae36-b18c3b2031ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186091616} {:answer/id #uuid "0f9c7839-7769-5b9e-b9cb-6a4582448142" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =8$ and $\\lambda =-5$" :db/id #edb/ref 17592186446638} {:answer/id #uuid "86cab0f8-b15d-5ea1-8e36-97308b179e3a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =-8$ and  $\\lambda =5$" :db/id #edb/ref 17592186446675} {:answer/id #uuid "c3c98ca9-4231-5356-a04c-0710da85992a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =0$ and $\\lambda =-5$" :db/id #edb/ref 17592186446692} {:answer/id #uuid "d968872b-bafd-5fbf-be0b-0478c03ae541" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =-5$ (double root)" :db/id #edb/ref 17592186446701}] :answer-field/correct {:answer/id #uuid "0f9c7839-7769-5b9e-b9cb-6a4582448142" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =8$ and $\\lambda =-5$" :db/id #edb/ref 17592186446638} :answer-field/id #uuid "2fc34f16-51f9-5f2d-8f00-589e55c33860" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186091612}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4ecc70e1-e461-5246-9098-c27aa6c114e3" :question/math-academy-id "q-9341" :question/problem "Find all real eigenvalues of the matrix \n$A=[\\begin{aligned}-4 & 2 \\\\ 6 & 7\\end{aligned}].$" :question/worked-solution "Let's start by writing the matrix $A-\\lambda I:$\n﻿﻿﻿\n\n$$\nA-\\lambda I=[\\begin{aligned}-4-\\lambda  & 2 \\\\ 6 & 7-\\lambda \\end{aligned}]\n$$\n\nNow, let's find and solve the characteristic equation $det(A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ |\\begin{aligned}-4-\\lambda  & 2 \\\\ 6 & 7-\\lambda \\end{aligned}| & =0 \\\\ (-4-\\lambda )(7-\\lambda )-2\\cdot 6 & =0 \\\\ -28-7\\lambda +4\\lambda +{\\lambda }^{2}-12 & =0 \\\\ {\\lambda }^{2}-3\\lambda -40 & =0\\end{aligned}\n$$\n\nUsing the quadratic formula, we obtain\n\n$$\n\\begin{aligned}\\lambda  & =\\frac{3\\pm \\sqrt{(-3)^{2}+4\\cdot 1\\cdot 40}}{2} \\\\  & =\\frac{3\\pm \\sqrt{169}}{2} \\\\  & =\\frac{3\\pm 13}{2} \\\\  & =8,-5.\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda =8$ and $\\lambda =-5.$"}] [{:db/id #edb/ref 17592186092903 :knowledge-point/_questions [{:db/id #edb/ref 17592186092230 :knowledge-point/id #uuid "0d235bca-d848-5075-affb-09e3103cfc11" :knowledge-point/title "Computing the Eigenvalues of a Matrix With At Most One Distinct Eigenvalue"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d80dad0-53c0-5d27-b5bd-04bb58893f9c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186091620} {:answer/id #uuid "18d67bdb-601f-58e7-8b75-d3e4da748215" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =1$ and $\\lambda =4$" :db/id #edb/ref 17592186446641} {:answer/id #uuid "4a33786d-34fc-5151-8170-2a142f2702df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =-2$  (double root)" :db/id #edb/ref 17592186446654} {:answer/id #uuid "89b8c0e6-ae99-51c1-8e85-66f98539ea38" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =2$  (double root)" :db/id #edb/ref 17592186446676} {:answer/id #uuid "f1455b86-25c6-5810-8b96-3462621d7ca7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =4$ and $\\lambda =4$" :db/id #edb/ref 17592186446709}] :answer-field/correct {:answer/id #uuid "89b8c0e6-ae99-51c1-8e85-66f98539ea38" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =2$  (double root)" :db/id #edb/ref 17592186446676} :answer-field/id #uuid "7fe56ff3-6e9f-5f5f-b666-d2ba2dce775a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186091618}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8d64c1c7-5e2c-5d9e-ad36-647b8fb50a8a" :question/math-academy-id "q-9346" :question/problem "Find all real eigenvalues of the matrix\n$A=[\\begin{aligned}3 & 1 \\\\ -1 & 1\\end{aligned}].$" :question/worked-solution "Let's start by writing the matrix $A-\\lambda I:$\n﻿﻿﻿\n\n$$\nA-\\lambda I=[\\begin{aligned}3-\\lambda  & 1 \\\\ -1 & 1-\\lambda \\end{aligned}]\n$$\n\nNow, let's find and solve the characteristic equation $det(A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ |\\begin{aligned}3-\\lambda  & 1 \\\\ -1 & 1-\\lambda \\end{aligned}| & =0 \\\\ (3-\\lambda )(1-\\lambda )+1\\cdot 1 & =0 \\\\ 3-3\\lambda -\\lambda +{\\lambda }^{2}+1 & =0 \\\\ {\\lambda }^{2}-4\\lambda +4 & =0 \\\\ (\\lambda -2)^{2} & =0.\\end{aligned}\n$$\n\nTherefore, the matrix $A$ has only one eigenvalue $\\lambda =2,$ which is a double root of the characteristic equation."}]}
