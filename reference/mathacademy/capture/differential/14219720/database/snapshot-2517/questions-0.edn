field/id #uuid "a8515f8b-2618-5ee6-abbc-c44663bca517" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186205414}] :question/id #uuid "d5a708e9-c589-5fc2-b4d6-ac87be196ece" :question/math-academy-id "q-275331" :question/problem "A surveyor is sent to one of three cities: $A$, $B$, or $C$. She is sent to City $A$ with a probability of $0.4$, City $B$ with a probability of $0.35$, and City $C$ with a probability of $0.25$.\n\nIf the expected number of households visited is $12$ in City $A$, $18$ in City $B$, and $10$ in City $C$, what is the expected number of households visited on a given day?\n\nThe expected number of households visited is\n{{field-1}}."}] [{:db/id #edb/ref 17592186208944 :knowledge-point/_questions [{:db/id #edb/ref 17592186208562 :knowledge-point/id #uuid "ca941236-4ae9-5740-bfbf-d15eb758212a" :knowledge-point/title "Applying the Tower Property"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fd6dc757-233a-599b-bd5c-c9c1f5671465" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186205416} {:answer/id #uuid "0ec876ef-0842-551a-a7c4-183d63812195" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186205417} {:answer/id #uuid "17c18b75-7be5-5753-a8d5-ef94d2555ad6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186205418} {:answer/id #uuid "25673941-b665-51ae-8b20-fffc28c862aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186205419} {:answer/id #uuid "40fa31aa-f5dd-5db5-b73f-e662b6bdf2ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186205420}] :answer-field/id #uuid "c9d8db12-6740-5f7a-8680-be66f91aa038" :answer-field/key