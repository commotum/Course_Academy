 17592186379267 :knowledge-point/_questions [{:db/id #edb/ref 17592186059688 :knowledge-point/id #uuid "0936217d-66d2-5360-b88b-a30683720415" :knowledge-point/title "Expressing Disjunctive Statements as Conditionals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e868b646-15fe-548f-a72f-8ee36770e921" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Refill the gas, and the car won't stop." :db/id #edb/ref 17592186379269} {:answer/id #uuid "80f7cf9e-eb09-518f-9521-39a0d9202ac4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you refill the gas, then the car won't stop." :db/id #edb/ref 17592186379270} {:answer/id #uuid "a978c03f-369f-5a80-92bd-57f628e184dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you don't refill the gas, then the car will stop." :db/id #edb/ref 17592186379271} {:answer/id #uuid "885eb7dc-c6a9-526b-9770-abdefeec79e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you don't refill the gas, then the car won't stop." :db/id #edb/ref 17592186379272} {:answer/id #uuid "655b6822-2da8-54fd-98c3-85d75068c1e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you refill the gas, then the car will stop." :db/id #edb/ref 17592186379273}] :answer-field/correct {:answer/id #uuid "a978c03f-369f-5a80-92bd-57f628e184dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you don't refill the gas, then the car will stop." :db/id #edb/ref 17592186379271} :answer-field/id #uuid "4c2ba26c-4972-5aeb-95e6-6fdc0e9051b2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186379268}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c932ba97-f4d8-5039-85c1-76029cd575f9" :question/math-academy-id "q-182593" :question/problem "$\\,$ Refill the gas, or the car will stop.\n\nWhich conditional statement is logically equivalent to the disjunctive statement above?" :question/worked-solution "Let's denote by $A$ and $B$ the following statements:\n\n- $A:$ Refill the gas.\n\n- $B:$ The car will stop.\n\nThen, our initial statement can be written as $A∨B,$ which is logically equivalent to \n\n$$\n¬A⇒B.\n$$\n\nThe negation of $A$ can be written as\n\n- $¬A:$ You don't refill the gas.\n\nTherefore, the given statement is logically equivalent to the following:\n\n$\\,$ If you don't refill the gas, then the car will stop."}] [{:db/id #edb/ref 17592186411064 :knowledge-point/_questions [{:db/id #edb/ref 17592186059688 :knowledge-point/id #uuid "0936217d-66d2-5360-b88b-a30683720415" :knowledge-point/title "Expressing Disjunctive Statements as Conditionals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50d09d1f-cca0-5966-9603-721e0fd176bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you don't wear a seatbelt, you won't be safe." :db/id #edb/ref 17592186411010} {:answer/id #uuid "54410627-bf6a-5ebd-8c2f-24cf4377b4c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you don't wear a seatbelt, you'll be safe." :db/id #edb/ref 17592186411011} {:answer/id #uuid "63d8127b-ac0b-521d-8659-2c189d0397b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you wear a seatbelt, you won't be safe." :db/id #edb/ref 17592186411015} {:answer/id #uuid "7f017770-d6b6-5bde-a043-0413160c76ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you wear a seatbelt, you'll be safe." :db/id #edb/ref 17592186411021} {:answer/id #uuid "88f19e57-12d9-52cf-9408-6a343c734323" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Wear a seatbelt, and you'll be safe." :db/id #edb/ref 17592186411024}] :answer-field/correct {:answer/id #uuid "7f017770-d6b6-5bde-a043-0413160c76ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you wear a seatbelt, you'll be safe." :db/id #edb/ref 17592186411021} :answer-field/id #uuid "0a91c6d7-ac78-5cf8-b390-0e03441f721f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411048}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "94ae2108-4770-5706-9cb7-823f98b8c863" :question/math-academy-id "q-182596" :question/problem "$\\,$ Either you do not wear a seatbelt, or you'll be safe.\n\nWhich conditional statement is logically equivalent to the disjunctive statement above?" :question/worked-solution "Let's denote by $A$ and $B$ the following statements:\n\n- $A:$ You do not wear a seatbelt.\n\n- $B:$ You'll be safe.\n\nThen, our initial statement can be written as $A∨B,$ which is logically equivalent to \n\n$$\n¬A⇒B.\n$$\n\nThe negation of $A$ can be written as\n\n- $¬A:$ You wear a seatbelt.\n\nTherefore, the given statement is logically equivalent to the following:\n\n$\\,$ If you wear a seatbelt, then you'll be safe.\n\nWe can write this in more everyday language as follows:\n\n$\\,$ If you wear a seatbelt, you'll be safe.\n\n**Note**: \n\nUsing the word \"Either\" helps clarify that the sentence structure presents two alternatives and is particularly useful when employing the disjunctive form $(¬P∨Q)$ in conversational or formal English. So, the phrase effectively conveys that one of the two stated conditions will hold true."}] [{:db/id #edb/ref 17592186411062 :knowledge-point/_questions [{:db/id #edb/ref 17592186059688 :knowledge-point/id #uuid "0936217d-66d2-5360-b88b-a30683720415" :knowledge-point/title "Expressing Disjunctive Statements as Conditionals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b70caa9-c52e-5616-ae35-c8639d9d1cba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you don't study for the test, you will get a good grade." :db/id #edb/ref 17592186411005} {:answer/id #uuid "affeb846-b91e-5e51-8e77-fba87a44b2da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you study for the test, you will get a good grade." :db/id #edb/ref 17592186411033} {:answer/id #uuid "b165de9d-a18f-5228-b9fc-0e478c17f447" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you don't study for the test, you won't get a good grade." :db/id #edb/ref 17592186411034} {:answer/id #uuid "cbd92aa7-078b-5716-ae44-eeaa9ed3fc7d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you study for the test, you won't get a good grade." :db/id #edb/ref 17592186411039} {:answer/id #uuid "fef75f07-1c94-58ee-a596-8d15395ec360" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Study for the test, and you will get a good grade." :db/id #edb/ref 17592186411047}] :answer-field/correct {:answer/id #uuid "affeb846-b91e-5e51-8e77-fba87a44b2da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you study for the test, you will get a good grade." :db/id #edb/ref 17592186411033} :answer-field/id #uuid "70a03950-8512-5382-9871-b92c66b9e568" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411052}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "64778f38-4137-5738-8e84-69949fb75847" :question/math-academy-id "q-182599" :question/problem "$\\,$ Either you do not study for the test, or you will get a good grade.\n\nWhich conditional statement is logically equivalent to the disjunctive statement above?" :question/worked-solution "Let's denote by $A$ and $B$ the following statements:\n\n- $A:$ You do not study for the test.\n\n- $B:$ You will get a good grade.\n\nThen, our initial statement can be written as $A∨B,$ which is logically equivalent to \n\n$$\n¬A⇒B.\n$$\n\nThe negation of $A$ can be written as\n\n- $¬A:$ You study for the test.\n\nTherefore, the given statement is logically equivalent to the following:\n\n$\\,$ If you study for the test, then you will get a good grade.\n\nWe can write this in more everyday language as follows:\n\n$\\,$ If you study for the test, you will get a good grade.\n\n**Note**: \n\nUsing the word \"Either\" helps clarify that the sentence structure presents two alternatives and is particularly useful when employing the disjunctive form $(¬P∨Q)$ in conversational or formal English. So, the phrase effectively conveys that one of the two stated conditions will hold true."}] [{:db/id #edb/ref 17592186409586 :knowledge-point/_questions [{:db/id #edb/ref 17592186059690 :knowledge-point/id #uuid "eec6cf11-74cc-5b3a-b2fe-bd4285fe4a88" :knowledge-point/title "Rewriting Conditional Statement Using the Associative, Commutative, and Absorption Laws"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "191c421c-bbe9-5286-9beb-03027543bcc3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B∨¬C" :db/id #edb/ref 17592186409566} {:answer/id #uuid "33e9615f-fd80-5202-949f-ebfef4f3e8b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬B∨C" :db/id #edb/ref 17592186409569} {:answer/id #uuid "35dc661b-8042-5dd9-ae2c-1ddb0493316b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B∧¬C" :db/id #edb/ref 17592186409570} {:answer/id #uuid "442d26c2-04f3-57d7-adf7-53465469c631" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬B∧C" :db/id #edb/ref 17592186409572} {:answer/id #uuid "4c2b2d55-0e4e-5769-9706-03ec9ecc763c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B∨C" :db/id #edb/ref 17592186409573}] :answer-field/correct {:answer/id #uuid "191c421c-bbe9-5286-9beb-03027543bcc3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B∨¬C" :db/id #edb/ref 17592186409566} :answer-field/id #uuid "eea492f1-156d-5834-96c0-8454fc274282" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186409583}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c7953127-b916-5d8d-98b4-eeece8a2e1ec" :question/math-academy-id "q-81892" :question/problem "Simplify the statement $(¬B∧C)⇒(B∨¬C).$" :question/worked-solution "First, note that\n\n$$\n(¬B∧C)⇒(B∨¬C)≡¬(¬B∧C)∨(B∨¬C).\n$$\n\nWe can distribute the negation over the disjunction using De Morgan's law:\n\n$$\n¬(¬B∧C)∨(B∨¬C)≡(¬(¬B)∨¬C)∨(B∨¬C)\n$$\n\nCanceling out double negations, we reach\n\n$$\n(¬(¬B)∨¬C)∨(B∨¬C)≡(B∨¬C)∨(B∨¬C).\n$$\n\nFinally, we simplify the disjunction of a statement with itself:\n\n$$\n(B∨¬C)∨(B∨¬C)≡B∨¬C\n$$\n\nSo the given statement is equivalent to $B∨¬C.$"}]}
