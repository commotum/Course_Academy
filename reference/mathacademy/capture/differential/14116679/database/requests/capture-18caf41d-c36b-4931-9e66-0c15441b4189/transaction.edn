[[:db/retract 17592186060140 :question/answer-fields 17592186057206] [:db/retract 17592186060139 :question/answer-fields 17592186057200] [:db/retract 17592186060143 :question/answer-fields 17592186057224] [:db/retract 17592186060062 :question/answer-fields 17592186056730] {:db/id 17592186059687 :knowledge-point/questions ["question-879f4dd5-148a-578f-a2fe-b0846abdf946" "question-442f3c28-f104-5684-ab21-f7ea922bad92"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186059688 :knowledge-point/questions ["question-94ae2108-4770-5706-9cb7-823f98b8c863" "question-283e6f42-c6ed-5da0-9085-3d8a16902757" "question-64778f38-4137-5738-8e84-69949fb75847"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186059689 :knowledge-point/questions ["question-c7ec246a-1c3b-5830-ae08-ed99cbcc20da" "question-17e8ba9f-418a-585c-9332-bdf5c1ee589a" "question-cb0a268b-ca46-5b91-9359-0e418e71bab9"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186059690 :knowledge-point/questions ["question-5cc8fa9c-919a-5715-b893-d15125898b55"] :db/ensure [:knowledge-point/validate]} {:db/id "question-879f4dd5-148a-578f-a2fe-b0846abdf946" :question/id #uuid "879f4dd5-148a-578f-a2fe-b0846abdf946" :question/math-academy-id "q-182509" :question/problem "$\\,$ If you follow the recipe, the dish will be delicious.\n\nWhich statement is logically equivalent to the conditional statement above?" :question/worked-solution "Let's denote by $A$ and $B$ the following statements:\n\n- $A:$ You follow the recipe.\n\n- $B:$ The dish will be delicious.\n\nThen, our initial statement can be written as $A⇒B,$ which is logically equivalent to \n\n$$\n¬A∨B.\n$$\n\nThe negation of $A$ can be written as\n\n- $¬A:$ You do not follow the recipe.\n\nTherefore, the given statement is logically equivalent to the following:\n\n$\\,$ You do not follow the recipe, or the dish will be delicious.\n\nWe can write this in more everyday language as follows:\n\n$\\,$ Either you do not follow the recipe, or the dish will be delicious.\n\n**Note**: \n\nUsing the word \"Either\" helps clarify that the sentence structure presents two alternatives and is particularly useful when employing the disjunctive form $(¬P∨Q)$ in conversational or formal English. So, the phrase effectively conveys that one of the two stated conditions will hold true." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-9134464d-6e44-5f65-9ae5-628575a51af6"] :db/ensure [:question/validate]} {:db/id "answer-field-9134464d-6e44-5f65-9ae5-628575a51af6" :answer-field/id #uuid "9134464d-6e44-5f65-9ae5-628575a51af6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0fbae154-dca8-5832-b6f3-6ca25402e83c" :answer-field/choices ["answer-7f9f9df7-1486-526b-82e1-407e863e4309" "answer-0fbae154-dca8-5832-b6f3-6ca25402e83c" "answer-031baea5-6ff9-513e-b2ec-02a90e898fe5" "answer-4c22c6ff-4399-5df2-b80e-59ddc05f68af" "answer-087177ce-72c4-5ef2-938f-b10e9e8b40fc"] :db/ensure [:answer-field/validate]} {:db/id "answer-7f9f9df7-1486-526b-82e1-407e863e4309" :answer/id #uuid "7f9f9df7-1486-526b-82e1-407e863e4309" :answer/type :answer.type/text :answer/value "Don't follow the recipe, or the dish won't be delicious." :db/ensure [:answer/validate]} {:db/id "answer-0fbae154-dca8-5832-b6f3-6ca25402e83c" :answer/id #uuid "0fbae154-dca8-5832-b6f3-6ca25402e83c" :answer/type :answer.type/text :answer/value "Either you do not follow the recipe, or the dish will be delicious." :db/ensure [:answer/validate]} {:db/id "answer-031baea5-6ff9-513e-b2ec-02a90e898fe5" :answer/id #uuid "031baea5-6ff9-513e-b2ec-02a90e898fe5" :answer/type :answer.type/text :answer/value "Either you follow the recipe, or the dish will be delicious." :db/ensure [:answer/validate]} {:db/id "answer-4c22c6ff-4399-5df2-b80e-59ddc05f68af" :answer/id #uuid "4c22c6ff-4399-5df2-b80e-59ddc05f68af" :answer/type :answer.type/text :answer/value "Either you follow the recipe, or the dish won't be delicious." :db/ensure [:answer/validate]} {:db/id "answer-087177ce-72c4-5ef2-938f-b10e9e8b40fc" :answer/id #uuid "087177ce-72c4-5ef2-938f-b10e9e8b40fc" :answer/type :answer.type/text :answer/value "Follow the recipe, and the dish won't be delicious." :db/ensure [:answer/validate]} {:db/id 17592186060139 :question/problem "$\\,$ If you don’t study, then you won't pass the exam.\n\nWhich statement is logically equivalent to the conditional statement above?" :question/worked-solution "Let's denote by $A$ and $B$ the following statements:\n\n- $A:$ You don't study.\n\n- $B:$ You won't pass the exam.\n\nThen, our initial statement can be written as $A⇒B,$ which is logically equivalent to \n\n$$\n¬A∨B.\n$$\n\nThe negation of $A$ can be written as\n\n- $¬A:$ You study.\n\nTherefore, the given statement is logically equivalent to the following:\n\n$\\,$ You study, or you won't pass the exam.\n\nWe can write this in more everyday language as follows:\n\n$\\,$ Study, or you won't pass the exam." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-9cd696de-2baa-518f-9a46-b4c3a6f28345"] :db/ensure [:question/validate]} {:db/id "answer-field-9cd696de-2baa-518f-9a46-b4c3a6f28345" :answer-field/id #uuid "9cd696de-2baa-518f-9a46-b4c3a6f28345" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9f052a76-d5ae-5be9-8f72-62412156c92a" :answer-field/choices ["answer-e9f8fb5e-a233-53f5-8f1c-029c69f30db6" "answer-a0ec8d87-b0ad-57ac-b03e-07c4c8ad6b24" "answer-9dcbcf84-c1f5-5b0f-adcd-61e18ef3dcfa" "answer-7ab520b5-59f6-5feb-953d-189ae99c37f8" "answer-9f052a76-d5ae-5be9-8f72-62412156c92a"] :db/ensure [:answer-field/validate]} {:db/id "answer-e9f8fb5e-a233-53f5-8f1c-029c69f30db6" :answer/id #uuid "e9f8fb5e-a233-53f5-8f1c-029c69f30db6" :answer/type :answer.type/text :answer/value "Don't study, and you won't pass the exam." :db/ensure [:answer/validate]} {:db/id "answer-a0ec8d87-b0ad-57ac-b03e-07c4c8ad6b24" :answer/id #uui