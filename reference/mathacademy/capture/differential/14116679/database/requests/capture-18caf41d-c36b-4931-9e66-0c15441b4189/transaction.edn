1-804e-87170809357c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-151b8ca4-58d5-5c25-9aaa-e1dc70bfd781" :answer-field/choices ["answer-24af826b-425f-56bf-9262-da3d54c093a3" "answer-f62e14c2-d216-5de5-99af-9a4d099a2b00" "answer-47287ee3-35fd-5008-b4df-10ce8e6df1f4" "answer-b6671899-a182-531f-b237-54941551781e" "answer-151b8ca4-58d5-5c25-9aaa-e1dc70bfd781"] :db/ensure [:answer-field/validate]} {:db/id "answer-24af826b-425f-56bf-9262-da3d54c093a3" :answer/id #uuid "24af826b-425f-56bf-9262-da3d54c093a3" :answer/type :answer.type/text :answer/value "Don't wake up early, and you won't have time for breakfast." :db/ensure [:answer/validate]} {:db/id "answer-f62e14c2-d216-5de5-99af-9a4d099a2b00" :answer/id #uuid "f62e14c2-d216-5de5-99af-9a4d099a2b00" :answer/type :answer.type/text :answer/value "Have time for breakfast, or wake up early." :db/ensure [:answer/validate]} {:db/id "answer-47287ee3-35fd-5008-b4df-10ce8e6df1f4" :answer/id #uuid "47287ee3-35fd-5008-b4df-10ce8e6df1f4" :answer/type :answer.type/text :answer/value "Wake up early, and you will have time for breakfast." :db/ensure [:answer/validate]} {:db/id "answer-b6671899-a182-531f-b237-54941551781e" :answer/id #uuid "b6671899-a182-531f-b237-54941551781e" :answer/type :answer.type/text :answer/value "Wake up early, and you won't have time for breakfast." :db/ensure [:answer/validate]} {:db/id "answer-151b8ca4-58d5-5c25-9aaa-e1dc70bfd781" :answer/id #uuid "151b8ca4-58d5-5c25-9aaa-e1dc70bfd781" :answer/type :answer.type/text :answer/value "Wake up early, or you won't have time for breakfast." :db/ensure [:answer/validate]} {:db/id "question-94ae2108-4770-5706-9cb7-823f98b8c863" :question/id #uuid "94ae2108-4770-5706-9cb7-823f98b8c863" :question/math-academy-id "q-182596" :question/problem "$\\,$ Either you do not wear a seatbelt, or you'll be safe.\n\nWhich conditional statement is logically equivalent to the disjunctive statement above?" :question/worked-solution "Let's denote by $A$ and $B$ the following statements:\n\n- $A:$ You do not wear a seatbelt.\n\n- $B:$ You'll be safe.\n\nThen, our initial statement can be written as $A∨B,$ which is logically equivalent to \n\n$$\n¬A⇒B.\n$$\n\nThe negation of $A$ can be written as\n\n- $¬A:$ You wear a seatbelt.\n\nTherefore, the given statement is logically equivalent to the following:\n\n$\\,$ If you wear a seatbelt, then you'll be safe.\n\nWe can write this in more everyday language as follows:\n\n$\\,$ If you wear a seatbelt, you'll be safe.\n\n**Note**: \n\nUsing the word \"Either\" helps clarify that the sentence structure presents two alternatives and is particularly useful when employing the disjunctive form $(¬P∨Q)$ in conversational or formal English. So, the phrase effectively conveys that one of the two stated conditions will hold true." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-0a91c6d7-ac78-5cf8-b390-0e03441f721f"] :db/ensure [:question/validate]} {:db/id "answer-field-0a91c6d7-ac78-5cf8-b390-0e03441f721f" :answer-field/id #uuid "0a91c6d7-ac78-5cf8-b390-0e03441f721f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7f017770-d6b6-5bde-a043-0413160c76ac" :answer-field/choices ["answer-50d09d1f-cca0-5966-9603-721e0fd176bc" "answer-54410627-bf6a-5ebd-8c2f-24cf4377b4c9" "answer-63d8127b-ac0b-521d-8659-2c189d0397b8" "answer-7f017770-d6b6-5bde-a043-0413160c76ac" "answer-88f19e57-12d9-52cf-9408-6a343c734323"] :db/ensure [:answer-field/validate]} {:db/id "answer-50d09d1f-cca0-5966-9603-721e0fd176bc" :answer/id #uuid "50d09d1f-cca0-5966-9603-721e0fd176bc" :answer/type :answer.type/text :answer/value "If you don't wear a seatbelt, you won't be safe." :db/ensure [:answer/validate]} {:db/id "answer-54410627-bf6a-5ebd-8c2f-24cf4377b4c9" :answer/id #uuid "54410627-bf6a-5ebd-8c2f-24cf4377b4c9" :answer/type :answer.type/text :answer/value "If you don't wear a seatbelt, you'll be safe." :db/ensure [:answer/validate]} {:db/id "answer-63d8127b-ac0b-521d-8659-2c189d0397b8" :answer/id #uuid "63d8127b-ac0b-521d-8659-2c189d0397b8" :answer/type :answer.type/text :answer/value "If you wear a seatbelt, you won't be safe." :db/ensure [:answer/validate]} {:db/id "answer-7f017770-d6b6-5bde-a043-0413160c76ac" :answer/id #uuid "7f017770-d6b6-5bde-a043-0413160c76ac" :answer/type :answer.type/text :answer/value "If you wear a seatbelt, you'll be safe." :db/ensure [:answer/validate]} {:db/id "answer-88f19e57-12d9-52cf-9408-6a343c734323" :answer/id #uuid "88f19e57-12d9-52cf-9408-6a343c734323" :answer/type :answer.type/text :answer/value "Wear a seatbelt, and you'll be safe." :db/ensure [:answer/validate]} {:db/id "question-283e6f42-c6ed-5da0-9085-3d8a16902757" :question/id #uuid "283e6f42-c6ed-5da0-9085-3d8a16902757" :question/math-academy-id "q-182589" :question/problem "$\\,$ Win this game, or you won't make it to the playoffs.\n\nWhich conditional statement is logically equivalent to the disjunctive statement above?" :question/worked-solution "Let's denote by $A$ and $B$ the following statements:\n\n- $A:$ Win this game.\n\n- $B:$ You won’t make it to the playoffs.\n\nThen, our initial statement can be written as $A∨B,$ which is logically equivalent to \n\n$$\n¬A⇒B.\n$$\n\nThe negation of $A$ can be written as\n\n- $¬A:$ You don't win this game.\n\nTherefore, the given statement is logically equivalent to the following:\n\n$\\,$ If you don't win this game, then you won't make it to the playoffs." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-234605e9-9e3b-5aee-bd89-a1493234c17c"] :db/ensure [:question/validate]} {:db/id "answer-field-234605e9-9e3b-5aee-bd89-a1493234c17c" :answer-field/id #uuid "234605e9-9e3b-5aee-bd89-a1493234c17c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8ae411bb-3f11-5442-8eba-d9d404fe68e6" :answer-field/choices ["answer-05f48d79-1191-5d91-bccd-c73e834a470c" "answer-8ae411bb-3f11-5442-8eba-d9d404fe68e6" "answer-d52f382a-e459-5416-8be7-d740d5696d6a" "answer-0ce79388-e687-51e4-8c79-52bb8958a2df" "answer-33a5b76d-0c32-5808-9831-19236d7bd6e2"] :db/ensure [:answer-field/validate]} {:db/id "answer-05f48d79-1191-5d91-bccd-c73e834a470c" :answer/id #uuid "05f48d79-1191-5d91-bccd-c73e834a470c" :answer/type :answer.type/text :answer/value "If you don't win this game, then you will make it to the playoffs." :db/ensure [:answer/validate]} {:db/id "answer-8ae411bb-3f11-5442-8eba-d9d404fe68e6" :answer/id #uuid "8ae411bb-3f11-5442-8eba-d9d404fe68e6" :answer/type :answer.type/text :answer/value "If you don't win this game, then you won't make it to the playoffs." :db/ensure [:answer/validate]} {:db/id "answer-d52f382a-e459-5416-8be7-d740d5696d6a" :answer/id #uuid "d52f382a-e459-5416-8be7-d740d5696d6a" :answer/type :answer.type/text :answer/value "If you win this game, then you will make it to the playoffs." :db/ensure [:answer/validate]} {:db/id "answer-0ce79388-e687-51e4-8c79-52bb8958a2df" :answer/id #uuid "0ce79388-e687-51e4-8c79-52bb8958a2df" :answer/type :answer.type/text :answer/value "If you win this game, then you won't make it to the playoffs." :db/ensure [:answer/validate]} {:db/id "answer-33a5b76d-0c32-5808-9831-19236d7bd6e2" :answer/id #uuid "33a5b76d-0c32-5808-9831-19236d7bd6e2" :answer/type :answer.type/text :answer/value "Win this game, and you will make it to the playoffs." :db/ensure [:answer/validate]} {:db/id "question-64778f38-4137-5738-8e84-69949fb75847" :question/id #uuid "64778f38-4137-5738-8e84-69949fb75847" :question/math-academy-id "q-182599" :question/problem "$\\,$ Either you do not study for the test, or you will get a good grade.\n\nWhich conditional statement is logically equivalent to the disjunctive statement above?" :question/worked-solution "Let's denote by $A$ and $B$ the following statements:\n\n- $A:$ You do not study for the test.\n\n- $B:$ You will get a good grade.\n\nThen, our initial statement can be written as $A∨B,$ which is logically equivalent to \n\n$$\n¬A⇒B.\n$$\n\nThe negation of $A$ can be written as\n\n- $¬A:$ You study for the test.\n\nTherefore, the given statement is logically equivalent to the following:\n\n$\\,$ If you study for the test, then you will get a good grade.\n\nWe can write this in more everyday language as follows:\n\n$\\,$ If you study for the test, you will get a good grade.\n\n**Note**: \n\nUsing the word \"Either\" helps clarify that the sentence structure presents two alternatives and is particularly useful when employing the disjunctive form $(¬P∨Q)$ in conversational or formal English. So, the phrase effectively conveys that one of the two stated conditions will hold true." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-70a03950-8512-5382-9871-b92c66b9e568"] :db/ensure [:question/validate]} {:db/id "answer-field-70a03950-8512-5382-9871-b92c66b9e568" :answer-field/id #uuid "70a03950-8512-5382-9871-b92c66b9e568" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-affeb846-b91e-5e51-8e77-fba87a44b2da" :answer-field/choices ["answer-1b70caa9-c52e-5616-ae35-c8639d9d1cba" "answer-b165de9d-a18f-5228-b9fc-0e478c17f447" "answer-affeb846-b91e-5e51-8e77-fba87a44b2da" "answer-cbd92aa7-078b-5716-ae44-eeaa9ed3fc7d" "answer-fef75f07-1c94-58ee-a596-8d15395ec360"] :db/ensure [:answer-field/validate]} {:db/id "answer-1b70caa9-c52e-5616-ae35-c8639d9d1cba" :answer/id #uuid "1b70caa9-c52e-5616-ae35-c8639d9d1cba" :answer/type :answer.type/text :answer/value "If you don't study for the test, you will get a good grade." :db/ensure [:answer/validate]} {:db/id "answer-b165de9d-a18f-5228-b9fc-0e478c17f447" :answer/id #uuid "b165de9d-a18f-5228-b9fc-0e478c17f447" :answer/type :answer.type/text :answer/value "If you don't study for the test, you won't get a good grade." :db/ensure [:answer/validate]} {:db/id "answer-affeb846-b91e-5e51-8e77-fb