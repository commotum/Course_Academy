#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186555888} :activity/id #uuid "143fe4d3-2189-5558-ab34-db30f0c13f2d" :activity/scope {:db/id #edb/ref 17592186049786 :topic/id #uuid "13ff200a-f3dd-575f-8362-6dc70510c750" :topic/math-academy-id 2988} :activity/steps [{:db/id #edb/ref 17592186555877 :step/content {:db/id #edb/ref 17592186555857 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08fdd0c6-1d98-54af-82c9-a3de113fe661" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186555016} {:answer/id #uuid "0ee61fd2-c684-57e7-9ea4-f09a8e349764" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186555027} {:answer/id #uuid "9d9c7297-d71f-5a15-82a4-809b7fbacfeb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{4}" :db/id #edb/ref 17592186555379} {:answer/id #uuid "aa206b43-8b04-5867-a4d8-d7210015326b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186555406} {:answer/id #uuid "cb7d4718-a5a3-5cee-ad89-6d539fb4ecc9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186555488}] :answer-field/correct {:db/id #edb/ref 17592186555488} :answer-field/id #uuid "45b92ccf-c96a-52fb-b618-ecc3a61419d1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186555673}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d36205bb-47f5-5c37-9085-d080474849b2" :question/math-academy-id "q-131169" :question/problem "Given that $X$ is a continuous random variable with the following probability density function, compute $\\text{Var}[X].$ \n\n$$\nf(x)=\\{\\begin{aligned}\\frac{30(x-1)}{{x}^{7}},\\, & x\\ge 1, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the variance using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\n \n\nFirst, we compute $\\text{E}[X]:$\n\n$$\n\\begin{aligned}\\text{E}[X] & ={\\int }_{1}^{\\infty }x\\cdot \\frac{30(x-1)}{{x}^{7}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{30x-30}{{x}^{6}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{30}{{x}^{5}}-\\frac{30}{{x}^{6}}\\,\\text{d}x \\\\  & =-\\frac{30}{4{x}^{4}}+\\frac{30}{5{x}^{5}}{|}_{1}^{\\infty } \\\\  & =-\\frac{15}{2{x}^{4}}+\\frac{6}{{x}^{5}}{|}_{1}^{\\infty } \\\\  & =\\frac{3}{2}\\end{aligned}\n$$\n\nThen, we compute $\\text{E}[{X}^{2}]:$\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{1}^{\\infty }{x}^{2}\\cdot \\frac{30(x-1)}{{x}^{7}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{30x-30}{{x}^{5}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{30}{{x}^{4}}-\\frac{30}{{x}^{5}}\\,\\text{d}x \\\\  & =-\\frac{30}{3{x}^{3}}+\\frac{30}{4{x}^{4}}{|}_{1}^{\\infty } \\\\  & =-\\frac{10}{{x}^{3}}+\\frac{15}{2{x}^{4}}{|}_{1}^{\\infty } \\\\  & =\\frac{5}{2}\\end{aligned}\n$$\n\nTherefore, the variance is given by\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{5}{2}-{(\\frac{3}{2})}^{2} \\\\  & =\\frac{1}{4}.\\end{aligned}\n$$"} :step/id #uuid "0d913b51-4d46-55e2-8d62-53eb1bef16a6"} {:db/id #edb/ref 17592186555888 :step/content {:db/id #edb/ref 17592186157993 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83ee7b07-d301-5da1-a5af-e36cd35ec590" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.271" :db/id #edb/ref 17592186156880} {:answer/id #uuid "b76b9637-103c-5fd5-b42c-a5a93f43452c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.302" :db/id #edb/ref 17592186156881} {:answer/id #uuid "bbf06895-5f31-59b5-aec7-4c7964b34e8b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.557" :db/id #edb/ref 17592186156882} {:answer/id #uuid "ef62e3fb-8b1f-55a1-81a7-840395cf92dc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.168" :db/id #edb/ref 17592186156883} {:answer/id #uuid "167dbf64-784c-5530-ba93-377703c8d7ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.843" :db/id #edb/ref 17592186156884}] :answer-field/correct {:db/id #edb/ref 17592186156880} :answer-field/id #uuid "969fe355-2c93-5de1-81db-4bd4cd7adc54" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186156879}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b701c7c2-e483-50bf-ba24-92741ccf181a" :question/math-academy-id "q-90309" :question/problem "The continuous random variable $X$ has the probability density function $f(x)$ stated below. Given that $\\text{E}[X]≈2.2778,$ compute $\\text{Var}[X].$ Round your answer to $3$ decimal places.\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{{x}^{2}}{12}, & 0<x<2, \\\\ \\frac{7}{9}, & 2\\le x<3, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/requires-calculator true :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the variance using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\n \n\nWe compute $\\text{E}[{X}^{2}],$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{0}^{3}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}{x}^{2}\\cdot f(x)\\,\\text{d}x+{\\int }_{2}^{3}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}{x}^{2}\\cdot \\frac{{x}^{2}}{12}\\,\\text{d}x+{\\int }_{2}^{3}{x}^{2}\\cdot \\frac{7}{9}\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}\\frac{{x}^{4}}{12}\\,\\text{d}x+{\\int }_{2}^{3}\\frac{7{x}^{2}}{9}\\,\\text{d}x \\\\  & ={\\frac{{x}^{5}}{60}|}_{0}^{2}+{\\frac{7{x}^{3}}{27}|}_{2}^{3} \\\\  & ≈5.4593\\end{aligned}\n$$\n\n \n\nTherefore, the variance is given by\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & ≈5.4593-(2.2778)^{2} \\\\  & ≈0.271\\end{aligned}\n$$\n\n \nrounded to three decimal places."} :step/id #uuid "27cb2740-d0d9-5281-bada-08690bd45b88" :step/next {:db/id #edb/ref 17592186555947}} {:db/id #edb/ref 17592186555921 :step/content {:db/id #edb/ref 17592186555796 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d8ed0ae-8c4c-5c40-b9fe-c94e4393c50b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.29" :db/id #edb/ref 17592186555209} {:answer/id #uuid "98cdc799-45df-57d7-9906-2ddedbe7c5bb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.56" :db/id #edb/ref 17592186555369} {:answer/id #uuid "d4ff1634-fce9-5b8f-a582-81c3cab8ed4d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.34" :db/id #edb/ref 17592186555504} {:answer/id #uuid "e04aa9a5-64b5-59f1-8dde-5ebe34bb8a3c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.98" :db/id #edb/ref 17592186555548} {:answer/id #uuid "f8ba96cd-c44c-5515-a683-4d13c806b5c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.46" :db/id #edb/ref 17592186555616}] :answer-field/correct {:db/id #edb/ref 17592186555209} :answer-field/id #uuid "340fc414-84b2-5d60-ae70-bad6cd5d8dc3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186555664}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "42fc75dd-9bd8-5bf5-a346-8dddd7ab3b06" :question/math-academy-id "q-90605" :question/problem "The continuous random variable $X$ has the probability density function $f(x)$ stated below. Given that $\\text{E}[X]≈1.136\\,90,$ compute $\\text{Var}[X].$ Round your answer to $2$ decimal places.\n\n$$\nf(x)=\\{\\begin{aligned}x, & 0\\le x<1, \\\\ \\frac{3{x}^{2}}{14}, & 1\\le x<2, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the variance using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\n \n\nWe compute $\\text{E}[{X}^{2}],$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{0}^{2}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{x}^{2}\\cdot f(x)\\,\\text{d}x+{\\int }_{1}^{2}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{x}^{2}\\cdot x\\,\\text{d}x+{\\int }_{1}^{2}{x}^{2}\\cdot \\frac{3{x}^{2}}{14}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{x}^{3}\\,\\text{d}x+{\\int }_{1}^{2}\\frac{3{x}^{4}}{14}\\,\\text{d}x \\\\  & ={\\frac{{x}^{4}}{4}|}_{0}^{1}+{\\frac{3{x}^{5}}{70}|}_{1}^{2} \\\\  & =1.578\\,57\\end{aligned}\n$$\n\n \n\nTherefore, the variance is given by\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & ≈1.578\\,57-(1.136\\,90)^{2} \\\\  & ≈0.29\\end{aligned}\n$$\n\n \nrounded to $2$ decimal places."} :step/id #uuid "89eecdb2-d635-5827-856f-b37cb0e945a8" :step/next {:db/id #edb/ref 17592186555877}} {:db/id #edb/ref 17592186555932 :step/content {:db/id #edb/ref 17592186555765 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "368e39f4-7c89-5dbe-b59a-90b69ad68444" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2.45" :db/id #edb/ref 17592186555115} {:answer/id #uuid "50907c91-9bbc-55c1-8c7d-3ee9bdffecbd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.78" :db/id #edb/ref 17592186555179} {:answer/id #uuid "b1f51ad0-f017-5334-b1f9-111993585928" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3.12" :db/id #edb/ref 17592186555430} {:answer/id #uuid "d77c1d14-7d11-58f9-9465-73a0b8c60934" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2.09" :db/id #edb/ref 17592186555519} {:answer/id #uuid "fbfc573b-da4d-5a63-a17a-aad20992b7b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.95" :db/id #edb/ref 17592186555626}] :answer-field/correct {:db/id #edb/ref 17592186555519} :answer-field/id #uuid "bb51de07-a3ab-5b3e-aa1b-ded6bbcf5569" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186555731}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "15966dc5-b8d2-54f2-9092-584d157e0965" :question/math-academy-id "q-90603" :question/problem "The continuous random variable $X$ has the probability density function $f(x)$ stated below. Given that $\\text{E}[X]≈3.314\\,81,$ compute $\\text{Var}[X].$ Round your answer to $2$ decimal places.\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{9}, & 0<x<3, \\\\ \\frac{1}{9}(2x-5), & 3\\le x<5, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the variance using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\n \n\nWe compute $\\text{E}[{X}^{2}],$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{0}^{5}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{3}{x}^{2}\\cdot f(x)\\,\\text{d}x+{\\int }_{3}^{5}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{3}{x}^{2}\\cdot \\frac{1}{9}\\,\\text{d}x+{\\int }_{3}^{5}{x}^{2}\\cdot \\frac{1}{9}(2x-5)\\,\\text{d}x \\\\  & ={\\int }_{0}^{3}\\frac{{x}^{2}}{9}\\,\\text{d}x+{\\int }_{3}^{5}\\frac{1}{9}(2{x}^{3}-5{x}^{2})\\,\\text{d}x \\\\  & ={\\frac{{x}^{3}}{27}|}_{0}^{3}+{\\frac{1}{9}(\\frac{{x}^{4}}{2}-\\frac{5{x}^{3}}{3})|}_{3}^{5} \\\\  & ≈13.074\\,07\\end{aligned}\n$$\n\n \n\nTherefore, the variance is given by\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & ≈13.074\\,07-(3.314\\,81)^{2} \\\\  & ≈2.09\\end{aligned}\n$$\n\n \nrounded to $2$ decimal places."} :step/id #uuid "c4b6fd65-5ab7-5aa6-9e67-5234b1c48ef4" :step/next {:db/id #edb/ref 17592186555921}} {:db/id #edb/ref 17592186555947 :step/content {:db/id #edb/ref 17592186444792 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a5575a9f-2ab2-5d7f-a9f8-276caa836627" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186444780} {:answer/id #uuid "d0832666-aa34-5722-9c73-1e8c1c1870ca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186444782} {:answer/id #uuid "dd759a9a-fce0-5c1b-a261-33cbdb2e7216" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{7}" :db/id #edb/ref 17592186444784} {:answer/id #uuid "e1dfce71-5ec8-5a3c-bd1e-1e6fb3662f40" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{9}" :db/id #edb/ref 17592186444785} {:answer/id #uuid "f8e19652-da47-5018-894c-72ff00f667d8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{4}" :db/id #edb/ref 17592186444786}] :answer-field/correct {:db/id #edb/ref 17592186444785} :answer-field/id #uuid "c501e9ae-0a39-5e88-9d3f-80627d2d0978" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186444789}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e581a350-34fb-5bb6-8fc4-e9d06576ecf2" :question/math-academy-id "q-90531" :question/problem "Given that $X$ is a continuous random variable with the following probability density function, compute $\\text{Var}[X].$ \n\n$$\nf(x)=\\{\\begin{aligned}\\frac{4}{{x}^{5}},\\, & x\\ge 1, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the variance using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\n \n\nFirst, we compute $\\text{E}[X]:$\n\n$$\n\\begin{aligned}\\text{E}[X] & ={\\int }_{1}^{\\infty }x\\cdot \\frac{4}{{x}^{5}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{4}{{x}^{4}}\\,\\text{d}x \\\\  & ={(-\\frac{4}{3{x}^{3}})|}_{1}^{\\infty } \\\\  & =\\frac{4}{3}\\end{aligned}\n$$\n\n \n\nThen, we compute $\\text{E}[{X}^{2}]:$\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{1}^{\\infty }{x}^{2}\\frac{4}{{x}^{5}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{4}{{x}^{3}}\\,\\text{d}x \\\\  & ={(-\\frac{2}{{x}^{2}})|}_{1}^{\\infty } \\\\  & =2\\end{aligned}\n$$\n\n \n\nTherefore, the variance is given by\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =2-{(\\frac{4}{3})}^{2} \\\\  & =\\frac{2}{9}.\\end{aligned}\n$$"} :step/id #uuid "dfc975d2-2b17-5834-9ec2-f3d0328a5946" :step/next {:db/id #edb/ref 17592186555932}}] :activity/title "Variance of Continuous Random Variables" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186554989}]}
