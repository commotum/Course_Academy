<mn>1</mn><mn>4</mn></mfrac></mstyle><mo stretchy=\"false\">(</mo><mi>y</mi><mo>−</mo><mn>4</mn><mo stretchy=\"false\">)</mo><mo>+</mo><mn>2</mn><mo stretchy=\"false\">(</mo><mi>z</mi><mo>−</mo><mn>1</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd><mi>w</mi><mo>−</mo><mn>3</mn></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mi>x</mi><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mn>4</mn></mfrac></mstyle><mi>y</mi><mo>+</mo><mn>2</mn><mi>z</mi><mo>−</mo><mn>4</mn></mtd></mtr><mtr><mtd><mi>x</mi><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mn>4</mn></mfrac></mstyle><mi>y</mi><mo>−</mo><mn>2</mn><mi>z</mi><mo>+</mo><mi>w</mi><mo>+</mo><mn>1</mn></mtd><mtd><mi></mi><mo>=</mo><mn>0</mn></mtd></mtr><mtr><mtd><mn>4</mn><mi>x</mi><mo>−</mo><mi>y</mi><mo>−</mo><mn>8</mn><mi>z</mi><mo>+</mo><mn>4</mn><mi>w</mi><mo>+</mo><mn>4</mn></mtd><mtd><mi></mi><mo>=</mo><mn>0</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
