></mtr><mtr><mtd><mi>z</mi><mo>−</mo><mn>6</mn></mtd><mtd><mi></mi><mo>=</mo><mn>8</mn><mo stretchy=\"false\">(</mo><mi>x</mi><mo>−</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mo>−</mo><mn>18</mn><mo stretchy=\"false\">(</mo><mi>y</mi><mo>+</mo><mn>1</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd><mi>z</mi><mo>−</mo><mn>6</mn></mtd><mtd><mi></mi><mo>=</mo><mn>8</mn><mi>x</mi><mo>−</mo><mn>18</mn><mi>y</mi><mo>−</mo><mn>26</mn></mtd></mtr><mtr><mtd><mn>8</mn><mi>x</mi><mo>−</mo><mn>18</mn><mi>y</mi><mo>−</mo><mi>z</mi><mo>−</mo><mn>20</mn></mtd><mtd><mi></mi><mo>=</mo><mn>0</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
