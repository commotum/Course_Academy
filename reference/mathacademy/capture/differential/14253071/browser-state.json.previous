mo stretchy=\"false\">(</mo><mi>y</mi><mo>−</mo><mn>2</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd><mi>z</mi><mo>−</mo><mn>2</mn></mtd><mtd><mi></mi><mo>=</mo><mn>12</mn><mi>x</mi><mo>+</mo><mn>4</mn><mi>y</mi><mo>−</mo><mn>20</mn></mtd></mtr><mtr><mtd><mn>12</mn><mi>x</mi><mo>+</mo><mn>4</mn><mi>y</mi><mo>−</mo><mi>z</mi><mo>−</mo><mn>18</mn></mtd><mtd><mi></mi><mo>=</mo><mn>0</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
