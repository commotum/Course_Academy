 \\\\ w-5 & =2(x-1)+0y+4(z-2) \\\\ w-5 & =2x+4z-10 \\\\ 2x+4z-w-5 & =0\\end{aligned}\n$$"] ["question-6f62591f-ce02-5d1d-a041-40b4fa4f0093" :question/difficulty :question.difficulty/moderate] ["answer-field-d53eb4df-306d-5fe9-a04a-ef268bb57a12" :answer-field/id #uuid "d53eb4df-306d-5fe9-a04a-ef268bb57a12"] ["answer-0d46eb51-fbd4-5527-a391-ea1f1472e1f5" :answer/id #uuid "0d46eb51-fbd4-5527-a391-ea1f1472e1f5"] ["answer-0d46eb51-fbd4-5527-a391-ea1f1472e1f5" :answer/type :answer.type/math] ["answer-0d46eb51-fbd4-5527-a391-ea1f1472e1f5" :answer/value "2x+4z-w-5=0"] ["answer-65d02bda-6ee0-5093-a005-04eff527cec0" :answer/id #uuid "65d02bda-6ee0-5093-a005-04eff527cec0"] ["answer-65d02bda-6ee0-5093-a005-04eff527cec0" :answer/type :answer.type/math] ["answer-65d02bda-6ee0-5093-a005-04eff527cec0" :answer/value "3z-w-1=0"] ["answer-07f2d355-8b47-5410-897b-016de7e6340d" :answer/id #uuid "07f2d355-8b47-5410-897b-016de7e6340d"] ["answer-07f2d355-8b47-5410-897b-016de7e6340d" :answer/type :answer.type/math] ["answer-07f2d355-8b47-5410-897b-016de7e6340d" :answer/value "w-5=0"] ["answer-6ca0d6d0-706e-5535-9a5c-90b235616840" :answer/id #uuid "6ca0d6d0-706e-5535-9a5c-90b235616840"] ["answer-6ca0d6d0-706e-5535-9a5c-90b235616840" :answer/type :answer.type/math] ["answer-6ca0d6d0-706e-5535-9a5c-90b235616840" :answer/value "x+y+2z-w=0"] ["answer-e6c72a8e-2ca4-5b18-9f33-e6a6209fea4f" :answer/id #uuid "e6c72a8e-2ca4-5b18-9f33-e6a6209fea4f"] ["answer-e6c72a8e-2ca4-5b18-9f33-e6a6209fea4f" :answer/type :answer.type/math] ["answer-e6c72a8e-2ca4-5b18-9f33-e6a6209fea4f" :answer/value "x-4y+w-6=0"] ["answer-field-d53eb4df-306d-5fe9-a04a-ef268bb57a12" :answer-field/key "selection"] ["answer-field-d53eb4df-306d-5fe9-a04a-ef268bb57a12" :answer-field/type :answer-field.type/radio] ["answer-field-d53eb4df-306d-5fe9-a04a-ef268bb57a12" :answer-field/correct "answer-0d46eb51-fbd4-5527-a391-ea1f1472e1f5"] ["answer-field-d53eb4df-306d-5fe9-a04a-ef268bb57a12" :answer-field/choices "answer-0d46eb51-fbd4-5527-a3