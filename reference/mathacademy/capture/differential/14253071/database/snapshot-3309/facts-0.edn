186045417] [17592186265569 #edb/ref 1075 #edb/ref 17592186264784 #edb/ref 17592186045417] [17592186265569 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186265569 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186265569 #edb/ref 1078 #edb/ref 17592186263814 #edb/ref 17592186045417] [17592186265569 #edb/ref 1079 #uuid "b8011146-a401-58f3-97b3-4121fbdc7250" #edb/ref 17592186045417] [17592186265728 #edb/ref 1068 #edb/ref 17592186265390 #edb/ref 17592186045417] [17592186265728 #edb/ref 1069 "q-129439" #edb/ref 17592186045417] [17592186265728 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186265728 #edb/ref 1071 "Determine the equation of the tangent plane to the surface $z={x}^{2}-2{y}^{2}+3$ at the point $(0,1,1).$" #edb/ref 17592186045417] [17592186265728 #edb/ref 1072 #uuid "c9c6a200-53f4-5ee2-ac37-189c11ad9a9e" #edb/ref 17592186045417] [17592186265728 #edb/ref 1074 "The Cartesian equation of the tangent plane to the surface $z=f(x,y)$ at the point $({x}_{0},{y}_{0},{z}_{0})$ on the surface can be written as\n\n$$\nz-{z}_{0}=(x-{x}_{0})\\frac{∂f}{∂x}({x}_{0},{y}_{0})+(y-{y}_{0})\\frac{∂f}{∂y}({x}_{0},{y}_{0}).\n$$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}({x}^{2}-2{y}^{2}+3) \\\\  & =2x \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}({x}^{2}-2{y}^{2}+3) \\\\  & =-4y\\end{aligned}\n$$\n\nNext, we evaluate the partial derivatives at $(x,y)=(0,1):$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}(0,1) & =2(0)=0 \\\\ \\frac{∂f}{∂y}(0,1) & =-4(1)=-4\\end{aligned}\n$$\n\nFinally, we write down the equation of the tangent plane:\n\n$$\n\\begin{aligned}z-1 & =(x-0)\\frac{∂f}{∂x}(0,1)+(y-1)\\frac{∂f}{∂y}(0,1) \\\\ z-1 & =0x-4(y-1) \\\\ z-1 & =-4y+4 \\\\ 4y+z-5 & =0\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186265738 #edb/ref 1068 #edb/ref 17592186265569 #edb/ref 17592186045417] [17592186265738 #edb/ref 1069 "q-129483" #edb/ref 17592186045417] [17592186265738 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186265738 #edb/ref 1071 "Find the equation of the tangent hyperplane to the hypersurface $w=z\\sqrt{y}-x$ at the point $(-1,4,1,3).$" #edb/ref 17592186045417] [17592186265738 #edb/ref 1072 #uuid "152fa2a1-ccb2-5b4a-abda-500e8681371b" #edb/ref 17592186045417] [17592186265738 #edb/ref 1074 "The Cartesian equation of the tangent plane to the hypersurface $w=f(x,y,z)$ at the point $({x}_{0},{y}_{0},{z}_{0},{w}_{0})$ on the hypersurface can be written as\n\n$$\nw-{w}_{0}=(x-{x}_{0})\\frac{∂f}{∂x}({x}_{0},{y}_{0},{z}_{0})+(y-{y}_{0})\\frac{∂f}{∂y}({x}_{0},{y}_{0},{z}_{0})+(z-{z}_{0})\\frac{∂f}{∂z}({x}_{0},{y}_{0},{z}_{0}).\n$$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(z\\sqrt{y}-x)=-1 \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}(z\\sqrt{y}-x)=\\frac{z}{2\\sqrt{y}} \\\\ \\frac{∂f}{∂z} & =\\frac{∂}{∂z}(z\\sqrt{y}-x)=\\sqrt{y}\\end{aligned}\n$$\n\nNext, we evaluate the partial derivatives at $(x,y,z)=(-1,4,1):$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}(-1,4,1) & =-1 \\\\ \\frac{∂f}{∂y}(-1,4,1) & =\\frac{1}{2\\sqrt{4}}=\\frac{1}{4} \\\\ \\frac{∂f}{∂z}(-1,4,1) & =\\sqrt{4}=2\\end{aligned}\n$$\n\nFinally, we write down the equation of the tangent hyperplane:\n\n$$\n\\begin{aligned}w-3 & =(x-(-1))\\frac{∂f}{∂x}(-1,4,1)+(y-4)\\frac{∂f}{∂y}(-1,4,1)+(z-1)\\frac{∂f}{∂z}(-1,4,1) \\\\ w-3 & =-(x+1)+\\frac{1}{4}(y-4)+2(z-1) \\\\ w-3 & =-x+\\frac{1}{4}y+2z-4 \\\\ x-\\frac{1}{4}y-2z+w+1 & =0 \\\\ 4x-y-8z+4w+4 & =0\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186265747 #edb/ref 1068 #edb/ref 17592186265382 #edb/ref 17592186045417] [17592186265747 #edb/ref 1069 "q-129554" #edb/ref 17592186045417] [17592186265747 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186265747 #edb/ref 1071 "At which points on the surface $z={x}^{3}+xy$ is the tangent plane horizontal?" #edb/ref 17592186045417] [17592186265747 #edb/ref 1072 #uuid "614f0c59-2007-5d79-93a8-aaee2f0fc248" #edb/ref 17592186045417] [17592186265747 #edb/ref 1074 "The Cartesian equation of the tangent plane to the surface $z=f(x,y)$ at the point $({x}_{0},{y}_{0},{z}_{0})$ on the surface can be written as\n\n$$\nz-{z}_{0}=(x-{x}_{0})\\frac{∂f}{∂x}({x}_{0},{y}_{0})+(y-{y}_{0})\\frac{∂f}{∂y}({x}_{0},{y}_{0}),\n$$\n\nwhere $⟨\\frac{∂f}{∂x}({x}_{0},{y}_{0}),\\frac{∂f}{∂y}({x}_{0},{y}_{0}),-1⟩$ represents a normal vector to the tangent plane.\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}({x}^{3}+xy)=3{x}^{2}+y \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}({x}^{3}+xy)=x\\end{aligned}\n$$\n\n \n\nHence, the normal vector to the tangent plane is \n\n$$\n⟨3{x}^{2}+y,\\,x,\\,-1⟩.\n$$\n\nNote that the tangent plane is horizontal if and only if the normal vector is vertical. This means that the $x$- and $y$-components of the vector must be $0:$\n\n$$\n\\left\\{\\begin{aligned}\\frac{∂f}{∂x} &=0 \\\\ \\frac{∂f}{∂y} &=0\\end{aligned}\\right.\\,⟹\\,\\left\\{\\begin{aligned}3{x}^{2}+y &=0 \\\\ x &=0\\end{aligned}\\right.\n$$\n\n \n\nFrom the second equation we get $x=0.$ Substituting $x=0$ into first equation, we obtain $y=0.$\n\nFinally, substituting $x=0$ and $y=0$ into our function, we get\n\n$$\nz={0}^{3}+0(0)=0.\n$$\n\nTherefore, the point where the tangent plane is horizontal is $(0,0,0).$" #edb/ref 17592186045443] [17592186265748 #edb/ref 1068 #edb/ref 17592186265348 #edb/ref 17592186045417] [17592186265748 #edb/ref 1069 "q-129557" #edb/ref 17592186045417] [17592186265748 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186265748 #edb/ref 1071 "At which point on the surface $z=3{x}^{2}+{y}^{2}$ is the tangent plane perpendicular to the vector  $v=⟨4,-2,-1⟩?$" #edb/ref 17592186045417] [17592186265748 #edb/ref 1072 #uuid "12830aeb-cb43-530e-902c-e52ba9d7524f" #edb/ref 17592186045417] [17592186265748 #edb/ref 1074 "The Cartesian equation of the tangent plane to the surface $z=f(x,y)$ at the point $({x}_{0},{y}_{0},{z}_{0})$ on the surface can be written as\n\n$$\nz-{z}_{0}=(x-{x}_{0})\\frac{∂f}{∂x}({x}_{0},{y}_{0})+(y-{y}_{0})\\frac{∂f}{∂y}({x}_{0},{y}_{0}),\n$$\n\nwhere $⟨\\frac{∂f}{∂x}({x}_{0},{y}_{0}),\\frac{∂f}{∂y}({x}_{0},{y}_{0}),-1⟩$ represents a normal vector to the tangent plane.\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(3{x}^{2}+{y}^{2})=6x \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}(3{x}^{2}+{y}^{2})=2y\\end{aligned}\n$$\n\nHence, the normal vector to the tangent plane is \n\n$$\n⟨6x,\\,2y,\\,-1⟩.\n$$\n\nOur tangent plane should be perpendicular to $⟨4,-2,-1⟩.$ So, the normal vector of that plane must be parallel to that vector. In other words, for some constant $c$, we must have\n\n$$\nc\\cdot ⟨6x,\\,2y,\\,-1⟩=⟨4,-2,-1⟩.\n$$\n\nEquating the corresponding coordinates, we obtain the following system:\n\n$$\n\\left\\{\\begin{aligned}6cx &=4 \\\\ 2cy &=-2 \\\\ -c &=-1\\end{aligned}\\right.\n$$\n\nFrom the third equation, we get $c=1.$ Substituting this into the first equation, we obtain \n\n$$\n6(1)x=4\\,⟹\\,x=\\frac{2}{3}.\n$$\n\nAnd substituting $c=1$ into the second equation, we have \n\n$$\n2(1)y=-2\\,⟹\\,y=-1.\n$$\n\nFinally, substituting $x=\\frac{2}{3}$ and $y=-1$ into our function, we get\n\n$$\n\\begin{aligned}z & =3{(\\frac{2}{3})}^{2}+(-1)^{2} \\\\  & =\\frac{4}{3}+1 \\\\  & =\\frac{7}{3}.\\end{aligned}\n$$\n\nTherefore, the tangent plane is perpendicular to the vector $v$ at $(\\frac{2}{3},-1,\\frac{7}{3}).$" #edb/ref 17592186045443] [17592186321353 #edb/ref 1080 "(1,1,-1)" #edb/ref 17592186045417] [17592186321353 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186321353 #edb/ref 1083 #uuid "1a95c8a6-3c01-5a9e-921c-caa2b833418a" #edb/ref 17592186045417] [17592186321703 #edb/ref 1080 "(2\\pi ,-\\pi ,2\\pi )" #edb/ref 17592186045417] [17592186321703 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186321703 #edb/ref 1083 #uuid "464dff10-0c59-5dad-80a1-2ee16d60dbfa" #edb/ref 17592186045417] [17592186321715 #edb/ref 1080 "(2\\pi ,\\pi ,-1)" #edb/ref 17592186045417] [17592186321715 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186321715 #edb/ref 1083 #uuid "48223b68-6d40-5d37-8bb5-b27364a9cf80" #edb/ref 17592186045417] [17592186321899 #edb/ref 1080 "(0,0,-6)" #edb/ref 17592186045417] [17592186321899 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186321899 #edb/ref 1083 #uuid "5fa273c2-815f-513d-b54f-c29d6f572500" #edb/ref 17592186045417] [17592186322349 #edb/ref 1080 "$(0,0,-6)$, $(1,0,-6)$" #edb/ref 17592186045417] [17592186322349 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186322349 #edb/ref 1083 #uuid "96a14160-ecda-5210-90d5-5bc2eeb9acdf" #edb/ref 17592186045417] [17592186322427 #edb/ref 1080 "(\\pi ,2,-2\\pi )" #edb/ref 17592186045417] [17592186322427 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186322427 #edb/ref 1083 #uuid "a226c677-0c51-577f-b0f5-1b3064cc6815" #edb/ref 17592186045417] [17592186322448 #edb/ref 1080 "$(0,1,-6)$, $(1,0,-6)$" #edb/ref 17592186045417] [17592186322448 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186322448 #edb/ref 1083 #uuid "a656e67e-614a-5d4e-9b20-18e1bc0e66ce" #edb/ref 17592186045417] [17592186322512 #edb/ref 1080 "(2\\pi ,\\pi ,12\\pi )" #edb/ref 17592186045417] [17592186322512 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186322512 #edb/ref 1083 #uuid "adf98dbd-c12a-5550-9749-ddcc015f00fd" #edb/ref 17592186045417] [17592186322607 #edb/ref 1080 "(-1,0,-6)" #edb/ref 17592186045417] [17592186322607 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186322607 #edb/ref 1083 #uuid "bc4d81bd-57b9-5ec9-8c17-620b08113a89" #edb/ref 17592186045417]}
