#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186478491} :activity/id #uuid "b8cd0170-12ba-5a13-8bd5-54a9ef34a08b" :activity/scope {:db/id #edb/ref 17592186048762 :topic/id #uuid "bc92d9a7-3663-5495-a1b9-4cf735034158" :topic/math-academy-id 1865} :activity/steps [{:db/id #edb/ref 17592186478470 :step/content {:db/id #edb/ref 17592186410062 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20bb3464-f73d-5921-8cdf-f112ab14ead9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}4 \\\\ -3\\end{aligned}]" :db/id #edb/ref 17592186410019} {:answer/id #uuid "36299c18-1f12-5691-a4cc-cf600875d435" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}4 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186410022} {:answer/id #uuid "7f7a28ee-dddd-5aff-9301-8500542e8d7c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}-3 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186410031} {:answer/id #uuid "d1ea2e8b-285d-5d4a-86b6-3118e3eacc94" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}3 \\\\ -4\\end{aligned}]" :db/id #edb/ref 17592186410041} {:answer/id #uuid "e5b40102-f333-5f07-9467-4d1fb5ba690a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}5 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186410046}] :answer-field/correct {:db/id #edb/ref 17592186410019} :answer-field/id #uuid "d8e25391-7c4e-5c7c-8ae1-5b47ead04007" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186410055}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f46f0e34-3d5c-5e7a-9fb4-690993802dbe" :question/math-academy-id "q-81230" :question/problem "Let $B=\\{{b}_{1},{b}_{2}\\}$ be a basis of ${R}^{2}$ and $[x]_{B}=[\\begin{aligned}7 \\\\ 1\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C=\\{{c}_{1},{c}_{2}\\},$ where ${c}_{1}={b}_{1}+{b}_{2}$ and ${c}_{2}={b}_{2}-{b}_{1}?$" :question/worked-solution "We are given that\n\n$$\n\\{\\begin{aligned}{c}_{1}={b}_{1}+{b}_{2} \\\\ {c}_{2}={b}_{2}-{b}_{1}.\\end{aligned}\n$$\n\nFirst, we express the $b$'s in terms of $c$'s. By adding the equations, we get \n\n$$\n{c}_{1}+{c}_{2}=2{b}_{2}\\,⟹\\,{b}_{2}=\\frac{1}{2}{c}_{1}+\\frac{1}{2}{c}_{2}.\n$$\n\nSubstituting this into the first equation, we obtain\n\n$$\n{c}_{1}={b}_{1}+(\\frac{1}{2}{c}_{1}+\\frac{1}{2}{c}_{2})\\,⟹\\,{b}_{1}=\\frac{1}{2}{c}_{1}-\\frac{1}{2}{c}_{2}.\n$$\n\nSince $[x]_{B}=[\\begin{aligned}7 \\\\ 1\\end{aligned}]$, we can write the vector $x$ as follows:\n\n$$\n\\begin{aligned}x & =7{b}_{1}+{b}_{2} \\\\  & =7(\\frac{1}{2}{c}_{1}-\\frac{1}{2}{c}_{2})+(\\frac{1}{2}{c}_{1}+\\frac{1}{2}{c}_{2}) \\\\  & =\\frac{7}{2}{c}_{1}-\\frac{7}{2}{c}_{2}+\\frac{1}{2}{c}_{1}+\\frac{1}{2}{c}_{2} \\\\  & =4{c}_{1}-3{c}_{2}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}4 \\\\ -3\\end{aligned}].$"} :step/id #uuid "06723a52-a509-54e8-a958-1ee3d11c3842" :step/next {:db/id #edb/ref 17592186478483}} {:db/id #edb/ref 17592186478475 :step/content {:db/id #edb/ref 17592186247309 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18b734f7-2e56-5969-b91b-fd5d7834144a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}4 \\\\ -2\\end{aligned}]" :db/id #edb/ref 17592186244533} {:answer/id #uuid "55d5c155-aa97-5099-976e-267010b9f696" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}\\frac{1}{7} \\\\ -2\\end{aligned}]" :db/id #edb/ref 17592186245069} {:answer/id #uuid "7fbe273e-6df1-5251-8f0b-69494a5c2141" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}2 \\\\ -7\\end{aligned}]" :db/id #edb/ref 17592186245440} {:answer/id #uuid "8a957706-ca6f-56cc-883e-020725d0d396" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}3 \\\\ -2\\end{aligned}]" :db/id #edb/ref 17592186245527} {:answer/id #uuid "b92afccc-c74b-5377-acc9-db0f72855208" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}7 \\\\ -12\\end{aligned}]" :db/id #edb/ref 17592186245967}] :answer-field/correct {:db/id #edb/ref 17592186245967} :answer-field/id #uuid "e597727d-4abc-5787-967c-bd4759284ec9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186246957}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "9c8b3d18-f99b-57ac-806c-9402fb0d526b" :question/math-academy-id "q-112855" :question/problem "Let $B=\\{{b}_{1},{b}_{2}\\}$ be a basis of ${R}^{2}$ and $[x]_{B}=[\\begin{aligned}2 \\\\ -3\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C=\\{{c}_{1},{c}_{2}\\},$ where ${c}_{1}=2{b}_{1}+3{b}_{2}$ and ${c}_{2}={b}_{1}+2{b}_{2}?$" :question/worked-solution "We are given that\n\n$$\n\\{\\begin{aligned}{c}_{1}=2{b}_{1}+3{b}_{2} \\\\ {c}_{2}={b}_{1}+2{b}_{2}.\\end{aligned}\n$$\n\nFirst, we express the $b$'s in terms of $c$'s. Multiplying the second equation by $-2$ and adding the equations, we get  \n\n$$\n{c}_{1}-2{c}_{2}=-{b}_{2}\\,⟹\\,{b}_{2}=-{c}_{1}+2{c}_{2}.\n$$\n\nSubstituting this into the second equation, we obtain \n\n$$\n{c}_{2}={b}_{1}+2(-{c}_{1}+2{c}_{2})\\,⟹\\,{b}_{1}=2{c}_{1}-3{c}_{2}.\n$$\n\nSince $[x]_{B}=[\\begin{aligned}2 \\\\ -3\\end{aligned}]$, we can write the vector $x$ as follows:\n\n$$\n\\begin{aligned}x & =2{b}_{1}-3{b}_{2} \\\\  & =2(2{c}_{1}-3{c}_{2})-3(-{c}_{1}+2{c}_{2}) \\\\  & =4{c}_{1}-6{c}_{2}+3{c}_{1}-6{c}_{2} \\\\  & =7{c}_{1}-12{c}_{2}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}7 \\\\ -12\\end{aligned}].$"} :step/id #uuid "374bc840-79bd-5b15-a6b4-c10eeb6fda83"} {:db/id #edb/ref 17592186478481 :step/content {:db/id #edb/ref 17592186410061 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4acab282-04ec-5eb0-ae3a-7ab839526ee4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}-2 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186410024} {:answer/id #uuid "ad9fccc8-89c8-5084-95ed-898b492b9317" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}-2 \\\\ \\frac{5}{3}\\end{aligned}]" :db/id #edb/ref 17592186410037} {:answer/id #uuid "af3b103c-e7ac-56f6-8025-6eee882f5637" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}\\frac{5}{3} \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186410038} {:answer/id #uuid "f26fb59e-92cb-5f2d-bb4b-31538da03416" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}3 \\\\ -\\frac{5}{3}\\end{aligned}]" :db/id #edb/ref 17592186410047} {:answer/id #uuid "f9547433-2214-505b-b38c-379846b86b1e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}1 \\\\ -\\frac{5}{3}\\end{aligned}]" :db/id #edb/ref 17592186410049}] :answer-field/correct {:db/id #edb/ref 17592186410049} :answer-field/id #uuid "66650074-ff68-5eca-a6ce-c53f9965f0b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186410051}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c92100bd-871b-5993-bed2-e255a4c7bcbb" :question/math-academy-id "q-35246" :question/problem "Let $B=\\{{b}_{1},{b}_{2}\\}$ be a basis of ${R}^{2}$ and $[x]_{B}=[\\begin{aligned}5 \\\\ -2\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C=\\{{c}_{1},{c}_{2}\\},$ where ${c}_{1}=-2{b}_{2}$ and ${c}_{2}=-3{b}_{1}?$" :question/worked-solution "Since $[x]_{B}=[\\begin{aligned}5 \\\\ -2\\end{aligned}]$, we can write $x$ as follows:\n\n$$\n\\begin{aligned}x & =5{b}_{1}-2{b}_{2} \\\\  & =-2{b}_{2}+5{b}_{1} \\\\  & =-2{b}_{2}-\\frac{5}{3}(-3{b}_{1}) \\\\  & ={c}_{1}-\\frac{5}{3}{c}_{2}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}1 \\\\ -\\frac{5}{3}\\end{aligned}].$"} :step/id #uuid "7fbd79a1-9017-5962-8464-c8335e25c404" :step/next {:db/id #edb/ref 17592186478470}} {:db/id #edb/ref 17592186478483 :step/content {:db/id #edb/ref 17592186247306 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43596b54-0af5-56a0-a954-2be5f40712fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}2 \\\\ 1 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186244900} {:answer/id #uuid "8b479d14-ade5-5b29-9efe-2745148ba46e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}2 \\\\ 1 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186245536} {:answer/id #uuid "be780025-c235-58a6-8299-86b26eaeee98" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}-4 \\\\ 1 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186246012} {:answer/id #uuid "e089e494-fe55-562d-9268-21868311ca66" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}1 \\\\ 1 \\\\ -4\\end{aligned}]" :db/id #edb/ref 17592186246310} {:answer/id #uuid "e8c12ab0-ecc5-5590-8676-6569049bf30f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}2 \\\\ -2 \\\\ -2\\end{aligned}]" :db/id #edb/ref 17592186246374}] :answer-field/correct {:db/id #edb/ref 17592186245536} :answer-field/id #uuid "03d089c3-601c-50be-8dc4-891bcf11d265" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186246555}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f5c48c40-2fd0-5515-867f-1f3be83f3dfb" :question/math-academy-id "q-112656" :question/problem "Let $B=\\{{b}_{1},{b}_{2},{b}_{3}\\}$ be a basis of ${R}^{3}$ and $[x]_{B}=[\\begin{aligned}2 \\\\ 2 \\\\ 8\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C=\\{{c}_{1},{c}_{2},{c}_{3}\\},$ where ${c}_{1}=4{b}_{3}$, ${c}_{2}=2{b}_{1}$ and ${c}_{3}=\\frac{1}{2}{b}_{2}?$" :question/worked-solution "Since $[x]_{B}=[\\begin{aligned}2 \\\\ 2 \\\\ 8\\end{aligned}]$, we can write $x$ as follows:\n\n$$\n\\begin{aligned}x & =2{b}_{1}+2{b}_{2}+8{b}_{3} \\\\  & =8{b}_{3}+2{b}_{1}+2{b}_{2} \\\\  & =2(4{b}_{3})+2{b}_{1}+2\\cdot 2(\\frac{1}{2}{b}_{2}) \\\\  & =2{c}_{1}+{c}_{2}+4{c}_{3}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}2 \\\\ 1 \\\\ 4\\end{aligned}].$"} :step/id #uuid "9647de70-ff9d-5f4b-bc4e-14a190bb842f" :step/next {:db/id #edb/ref 17592186478475}} {:db/id #edb/ref 17592186478491 :step/content {:db/id #edb/ref 17592186120362 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "252cd9d2-cd28-51d0-86dc-f100bfbf8425" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}3 \\\\ 3 \\\\ -4\\end{aligned}]" :db/id #edb/ref 17592186410020} {:answer/id #uuid "65ce31d1-a577-5b44-a7fa-3c3f399d7aa4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}\\frac{4}{3} \\\\ 6 \\\\ -\\frac{3}{4}\\end{aligned}]" :db/id #edb/ref 17592186410028} {:answer/id #uuid "b63f4cd2-57fd-5205-92b4-a5bf14cc8ff8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}\\frac{3}{4} \\\\ 6 \\\\ -\\frac{4}{3}\\end{aligned}]" :db/id #edb/ref 17592186410040} {:answer/id #uuid "e15510ae-a912-51f2-b92f-d981d02b25f9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}4 \\\\ 6 \\\\ -3\\end{aligned}]" :db/id #edb/ref 17592186410045} {:answer/id #uuid "fe8e8b08-4548-5fe8-adbd-3bce3207c85e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}-\\frac{4}{3} \\\\ 6 \\\\ \\frac{3}{4}\\end{aligned}]" :db/id #edb/ref 17592186410050}] :answer-field/correct {:db/id #edb/ref 17592186410028} :answer-field/id #uuid "de484491-607f-5712-bf20-9fe92c23a765" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186410057}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "59ed1787-672a-57bb-b86d-43224b917d2d" :question/math-academy-id "q-34772" :question/problem "Let $B=\\{{b}_{1},{b}_{2},{b}_{3}\\}$ be a basis of ${R}^{3}$ and $[x]_{B}=[\\begin{aligned}-3 \\\\ 4 \\\\ -6\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C=\\{{c}_{1},{c}_{2},{c}_{3}\\},$ where ${c}_{1}=3{b}_{2}$, ${c}_{2}=-{b}_{3}$ and ${c}_{3}=4{b}_{1}?$" :question/worked-solution "Since $[x]_{B}=[\\begin{aligned}-3 \\\\ 4 \\\\ -6\\end{aligned}]$, we can write $x$ as follows:\n\n$$\n\\begin{aligned}x & =-3{b}_{1}+4{b}_{2}-6{b}_{3} \\\\  & =4{b}_{2}-6{b}_{3}-3{b}_{1} \\\\  & =\\frac{4}{3}(3{b}_{2})+6(-{b}_{3})-\\frac{3}{4}(4{b}_{1}) \\\\  & =\\frac{4}{3}{c}_{1}+6{c}_{2}-\\frac{3}{4}{c}_{3}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}\\frac{4}{3} \\\\ 6 \\\\ -\\frac{3}{4}\\end{aligned}].$"} :step/id #uuid "c6f946eb-8d53-5f69-9732-0e531c296bb0" :step/next {:db/id #edb/ref 17592186478481}}] :activity/title "Writing Vectors in Different Bases" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186477731}]}
