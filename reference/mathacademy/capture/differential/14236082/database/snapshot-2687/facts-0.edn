6 #edb/ref 1027 #edb/ref 17592186048898 #edb/ref 17592186045417] [17592186049636 #edb/ref 1027 #edb/ref 17592186050219 #edb/ref 17592186045417] [17592186049636 #edb/ref 1027 #edb/ref 17592186050890 #edb/ref 17592186045417] [17592186049636 #edb/ref 1028 #edb/ref 17592186172015 #edb/ref 17592186045417] [17592186049636 #edb/ref 1028 #edb/ref 17592186172111 #edb/ref 17592186045417] [17592186049636 #edb/ref 1028 #edb/ref 17592186172112 #edb/ref 17592186045417] [17592186049636 #edb/ref 1031 "Further Rules of Absolute Value" #edb/ref 17592186045417] [17592186049636 #edb/ref 1033 3536 #edb/ref 17592186045417] [17592186049636 #edb/ref 1035 #uuid "07291a04-1a38-5ba5-bc33-f7a4e1cf0c19" #edb/ref 17592186045417] [17592186050383 #edb/ref 1027 #edb/ref 17592186048398 #edb/ref 17592186045417] [17592186050383 #edb/ref 1027 #edb/ref 17592186048814 #edb/ref 17592186045417] [17592186050383 #edb/ref 1027 #edb/ref 17592186048891 #edb/ref 17592186045417] [17592186050383 #edb/ref 1027 #edb/ref 17592186048898 #edb/ref 17592186045417] [17592186050383 #edb/ref 1027 #edb/ref 17592186049369 #edb/ref 17592186045417] [17592186050383 #edb/ref 1027 #edb/ref 17592186050135 #edb/ref 17592186045417] [17592186050383 #edb/ref 1027 #edb/ref 17592186050175 #edb/ref 17592186045417] [17592186050383 #edb/ref 1028 #edb/ref 17592186110603 #edb/ref 17592186045417] [17592186050383 #edb/ref 1028 #edb/ref 17592186110604 #edb/ref 17592186045417] [17592186050383 #edb/ref 1028 #edb/ref 17592186110605 #edb/ref 17592186045417] [17592186050383 #edb/ref 1031 "Solving Rational Equations Containing One Fractional Term" #edb/ref 17592186045417] [17592186050383 #edb/ref 1033 1415 #edb/ref 17592186045417] [17592186050383 #edb/ref 1035 #uuid "44b10216-6553-5a54-ba7f-65d318a0317e" #edb/ref 17592186045417] [17592186050908 #edb/ref 1027 #edb/ref 17592186048213 #edb/ref 17592186045417] [17592186050908 #edb/ref 1027 #edb/ref 17592186048661 #edb/ref 17592186045417] [17592186050908 #edb/ref 1027 #edb/ref 17592186050575 #edb/ref 17592186045417] [17592186050908 #edb/ref 1027 #edb/ref 17592186050998 #edb/ref 17592186045417] [17592186050908 #edb/ref 1028 #edb/ref 17592186054777 #edb/ref 17592186045417] [17592186050908 #edb/ref 1028 #edb/ref 17592186054778 #edb/ref 17592186045417] [17592186050908 #edb/ref 1028 #edb/ref 17592186054779 #edb/ref 17592186045417] [17592186050908 #edb/ref 1028 #edb/ref 17592186054780 #edb/ref 17592186045417] [17592186050908 #edb/ref 1031 "Applying the Distributive Law With Linear Expressions" #edb/ref 17592186045417] [17592186050908 #edb/ref 1033 135 #edb/ref 17592186045417] [17592186050908 #edb/ref 1035 #uuid "704c70d6-1bf4-5b23-b4da-d122a744acda" #edb/ref 17592186045417] [17592186051079 #edb/ref 1027 #edb/ref 17592186048530 #edb/ref 17592186045417] [17592186051079 #edb/ref 1027 #edb/ref 17592186048898 #edb/ref 17592186045417] [17592186051079 #edb/ref 1027 #edb/ref 17592186049181 #edb/ref 17592186045417] [17592186051079 #edb/ref 1027 #edb/ref 17592186049266 #edb/ref 17592186045417] [17592186051079 #edb/ref 1027 #edb/ref 17592186049527 #edb/ref 17592186045417] [17592186051079 #edb/ref 1027 #edb/ref 17592186049902 #edb/ref 17592186045417] [17592186051079 #edb/ref 1027 #edb/ref 17592186050788 #edb/ref 17592186045417] [17592186051079 #edb/ref 1027 #edb/ref 17592186050884 #edb/ref 17592186045417] [17592186051079 #edb/ref 1027 #edb/ref 17592186051017 #edb/ref 17592186045417] [17592186051079 #edb/ref 1028 #edb/ref 17592186054828 #edb/ref 17592186045417] [17592186051079 #edb/ref 1028 #edb/ref 17592186054829 #edb/ref 17592186045417] [17592186051079 #edb/ref 1028 #edb/ref 17592186054830 #edb/ref 17592186045417] [17592186051079 #edb/ref 1031 "Factoring Linear Expressions" #edb/ref 17592186045417] [17592186051079 #edb/ref 1033 87 #edb/ref 17592186045417] [17592186051079 #edb/ref 1035 #uuid "7f29909c-8f45-5a17-820a-13a0a327cd5f" #edb/ref 17592186045417] [17592186192405 #edb/ref 1069 "e-10459" #edb/ref 17592186045417] [17592186192405 #edb/ref 1071 "The function $f(x) = \\dfrac{4}{(x-1)^2}$ is defined for $x >1$. Find $f^{-1}(x)$." #edb/ref 17592186045417] [17592186192405 #edb/ref 1072 #uuid "0042ce26-8793-5690-b4ab-9f018afe979a" #edb/ref 17592186045417] [17592186192405 #edb/ref 1074 "To find $f^{-1}(x)$, we start by replacing $f(x)$ with $y{:}$\n\n$$\ny = \\dfrac{4}{(x-1)^2}\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx = \\dfrac{4}{(y-1)^2}\n$$\n\nThen, we make $y$ the subject of the equation, as follows:\n\n$$\n\\begin{aligned}\nx &= (4)/((y - 1)^{2}) \\\\\nx \\cdot (y - 1)^{2} &= 4 \\\\\n(y - 1)^{2} &= \\frac{4}{x} \\\\\n\\sqrt{(y - 1)^{2}} &= \\sqrt{\\frac{4}{x}} \\\\\n\\mid y - 1 \\mid &= \\frac{2}{\\sqrt{x}} \\\\\ny - 1 &= \\frac{2}{\\sqrt{x}} \\\\\ny &= \\frac{2}{\\sqrt{x}} + 1\n\\end{aligned}\n$$\n\nNote that we used the fact that for $y > 1$, we have\n\n$$\n\\mid y-1 \\mid = y-1\n$$\n\nTherefore, the inverse function is\n\n$$\nf^{-1}(x) = \\dfrac{2}{\\sqrt{x}} + 1\n$$" #edb/ref 17592186045417] [17592186192406 #edb/ref 1069 "e-10460" #edb/ref 17592186045417] [17592186192406 #edb/ref 1071 "Find the inverse of the function $f(x) = \\dfrac{2-x}{x+3}$." #edb/ref 17592186045417] [17592186192406 #edb/ref 1072 #uuid "9b149c51-015f-5346-9fca-8da406d0a79a" #edb/ref 17592186045417] [17592186192406 #edb/ref 1074 "To find $f^{-1}(x)$, we start by replacing $f(x)$ with $y{:}$\n\n$$\ny = \\dfrac{2-x}{x+3}\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx = \\dfrac{2-y}{y+3}\n$$\n\nThen, we make $y$ the subject of the equation, as follows:\n\n$$\n\\begin{aligned}\nx &= \\frac{2 - y}{y + 3} \\\\\nx(y + 3) &= 2 - y \\\\\nxy + 3x &= 2 - y \\\\\nxy + y &= 2 - 3x \\\\\ny(x + 1) &= 2 - 3x \\\\\ny &= \\frac{2 - 3x}{x + 1}\n\\end{aligned}\n$$\n\nTherefore, the inverse function is\n\n$$\nf^{-1}(x) = \\dfrac{2-3x}{x+1}\n$$" #edb/ref 17592186045417] [17592186192407 #edb/ref 1069 "e-10461" #edb/ref 17592186045417] [17592186192407 #edb/ref 1071 "The function $f(x)$, defined as\n$f(x) = \\dfrac{kx + 6}{x-4}, \\qquad x\\neq 4$\nhas an inverse function given by\n$f^{-1}(x) = \\dfrac{4x+6}{x-2}, \\qquad x\\neq 2$.\nWhat is the value of $k$?" #edb/ref 17592186045417] [17592186192407 #edb/ref 1072 #uuid "f6ab6606-77ce-583a-9712-175825864612" #edb/ref 17592186045417] [17592186192407 #edb/ref 1074 "To find $f^{-1}(x)$, we start by replacing $f(x)$ with $y{:}$\n\n$$\ny = \\dfrac{kx + 6}{x-4}\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx = \\dfrac{ky+6}{y-4}\n$$\n\nThen, we make $y$ the subject of the equation, as follows:\n\n$$\n\\begin{aligned}\nx &= \\frac{ky + 6}{y - 4} \\\\\nx(y - 4) &= ky + 6 \\\\\nxy - 4x &= ky + 6 \\\\\nxy - ky &= 4x + 6 \\\\\ny(x - k) &= 4x + 6 \\\\\ny &= \\frac{4x + 6}{x - k}\n\\end{aligned}\n$$\n\nTherefore, the inverse function is\n\n$$\nf^{-1}(x) = \\dfrac{4x+6}{x-k}\n$$\n\nComparing our answer with the given expression, we conclude that $k=2$." #edb/ref 17592186045417] [17592186192814 #edb/ref 1037 #edb/ref 17592186048963 #edb/ref 17592186045417] [17592186192814 #edb/ref 1037 #edb/ref 17592186049461 #edb/ref 17592186045417] [17592186192814 #edb/ref 1037 #edb/ref 17592186049636 #edb/ref 17592186045417] [17592186192814 #edb/ref 1037 #edb/ref 17592186050383 #edb/ref 17592186045417] [17592186192814 #edb/ref 1037 #edb/ref 17592186050908 #edb/ref 17592186045417] [17592186192814 #edb/ref 1038 #edb/ref 17592186193007 #edb/ref 17592186045417] [17592186192814 #edb/ref 1038 #edb/ref 17592186193008 #edb/ref 17592186045417] [17592186192814 #edb/ref 1038 #edb/ref 17592186275198 #edb/ref 17592186045417] [17592186192814 #edb/ref 1038 #edb/ref 17592186275199 #edb/ref 17592186045417] [17592186192814 #edb/ref 1039 "Finding the Inverse of a Reciprocal Function" #edb/ref 17592186045417] [17592186192814 #edb/ref 1041 #edb/ref 17592186192405 #edb/ref 17592186045417] [17592186192814 #edb/ref 1042 #uuid "421b9396-2a7b-5c45-897a-9de5f52683de" #edb/ref 17592186045417] [17592186192815 #edb/ref 1037 #edb/ref 17592186051079 #edb/ref 17592186045417] [17592186192815 #edb/ref 1038 #edb/ref 17592186193009 #edb/ref 1759218