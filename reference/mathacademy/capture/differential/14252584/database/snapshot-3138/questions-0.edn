96-a71a-974c272cf869" :question/math-academy-id "q-34248" :question/problem "Find $x$, if $4a+6x=b$ and\n\n$$\na=\\begin{bmatrix}-3 \\\\ 0 \\\\ -7\\end{bmatrix},\\,b=\\begin{bmatrix}24 \\\\ -6 \\\\ -10\\end{bmatrix}.\n$$" :question/worked-solution "Using the properties of addition/subtraction and scalar multiplication of vectors to isolate $x,$ we get\n\n$$\n\\begin{aligned}4a+6x & =b \\\\ 6x & =b-4a \\\\ x & =\\frac{1}{6}(b-4a) \\\\ x & =\\frac{1}{6}(\\begin{bmatrix}24 \\\\ -6 \\\\ -10\\end{bmatrix}-4\\begin{bmatrix}-3 \\\\ 0 \\\\ -7\\end{bmatrix}) \\\\ x & =\\frac{1}{6}\\begin{bmatrix}36 \\\\ -6 \\\\ 18\\end{bmatrix} \\\\ x & =\\begin{bmatrix}6 \\\\ -1 \\\\ 3\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186342110 :knowledge-point/_questions [{:db/id #edb/ref 17592186119806 :knowledge-point/id #uuid "590953b8-2533-5a4b-bf4f-f002b0367919" :knowledge-point/title "Solving for a Vector in a Linear Combination"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a0b569a-8def-5df5-b42f-3135dd4d5db0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ 4 \\\\ 9\\end{bmatrix}" :db/id #edb/ref 17592186339360} {:answer/id #uuid "3896821e-dec7-5884-ad52-5ca3a114b733" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ -5 \\\\ 6\\end{bmatrix}" :db/id #edb/ref 17592186339637} {:answer/id #uuid "3c9d29a7-85be-58bd-8990-c807b06606e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 \\\\ -5 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186339668} {:answer/id #uuid "ab3c29be-4bcc-5dc0-b48a-fbfcfb942938" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ 6 \\\\ -5\\end{bmatrix}" :db/id #edb/ref 17592186340687} {:answer/id #uuid "db5099b6-1298-5164-b17c-d9086cd69a32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ -4 \\\\ -9\\end{bmatrix}" :db/id #edb/ref 17592186341075}] :answer-field/correct {:answer/id #uuid "3896821e-dec7-5884-ad52-5ca3a114b733" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ -5 \\\\ 6\\end{bmatrix}" :db/id #edb/ref 17592186339637} :answer-field/id #uuid "dbf00c01-ca7d-54b8-ace5-516180ba4620" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341767}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0a045a18-4b26-532b-8e6c-7d683732c9ac" :question/math-academy-id "q-73931" :question/problem "Find $x$, if $3a+2x=b$ and\n\n$$\na=\\begin{bmatrix}1 \\\\ 2 \\\\ -5\\end{bmatrix},\\,b=\\begin{bmatrix}9 \\\\ -4 \\\\ -3\\end{bmatrix}.\n$$" :question/worked-solution "Using the properties of addition/subtraction and scalar multiplication of vectors to isolate $x,$ we get  \n\n$$\n\\begin{aligned}3a+2x & =b \\\\ 2x & =b-3a \\\\ x & =\\frac{1}{2}(b-3a) \\\\ x & =\\frac{1}{2}(\\begin{bmatrix}9 \\\\ -4 \\\\ -3\\end{bmatrix}-3\\begin{bmatrix}1 \\\\ 2 \\\\ -5\\end{bmatrix}) \\\\ x & =\\frac{1}{2}\\begin{bmatrix}6 \\\\ -10 \\\\ 12\\end{bmatrix} \\\\ x & =\\begin{bmatrix}3 \\\\ -5 \\\\ 6\\end{bmatrix}.\\end{aligned}\n$$"}]}
