#{[{:activity/expected-seconds 960.0 :activity/first-step {:db/id #edb/ref 17592186120672} :activity/id #uuid "6ede3e68-1ff6-5e3c-afed-499bb387f9a1" :activity/scope {:db/id #edb/ref 17592186048499 :topic/id #uuid "a4bbeec2-7e3f-58f1-87d1-563d58d73752" :topic/math-academy-id 1851} :activity/steps [{:db/id #edb/ref 17592186120672 :step/content {:db/id #edb/ref 17592186121034 :tutorial/content "Consider a vector $\\mathbf{u}$ which is given in terms of the vectors $\\mathbf{v_1}$ and $\\mathbf{v_2}$ as follows:\n\n$$\n{\\color{red}3}{\\color{blue}\\mathbf{v_1}}+({\\color{red}-2}){\\color{blue}\\mathbf{v_2}} = \\mathbf{u}\n$$\n\nHere, we say that $\\mathbf{u}$ is a **linear combination** of the vectors ${\\color{blue}\\mathbf{v_1}}$ and ${\\color{blue}\\mathbf{v_2}}$ with coefficients ${\\color{red}3}$ and ${\\color{red}-2}$ respectively. \n\nIn general, a linear combination of $n$ vectors $\\mathbf{v_1},\\mathbf{v_2},\\dots,\\mathbf{v_n}$ is the *weighted sum*\n\n$$\n{\\color{red}x_1}\\mathbf{\\color{blue}v_1}+{\\color{red}x_2}\\mathbf{\\color{blue}v_2}+\\cdots + {\\color{red}x_n}\\mathbf{\\color{blue}v_n} = \\mathbf{u},\n$$\n\nwhere ${\\color{red}x_1},{\\color{red}x_2},\\dots,{\\color{red}x_n}\\in\\mathbb{R}.$ We say that $\\mathbf{u}$ is a linear combination of the vectors $\\mathbf{\\color{blue}v_1},\\mathbf{\\color{blue}v_2},\\dots,\\mathbf{\\color{blue}v_n}$ with coefficients (or *weights*) ${\\color{red}x_1},{\\color{red}x_2},\\dots,{\\color{red}x_n},$ respectively.\n\nFor instance, \n\n\n$$\n{\\color{red}2} \\cdot \\underbrace{\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}}_{\\large\\color{blue}\\mathbf{v}_1} + {\\color{red}0} \\cdot \\underbrace{\\begin{bmatrix}\\sqrt{2} \\\\ 3\\end{bmatrix}}_{\\large\\color{blue}\\mathbf{v}_2} + {\\color{red}\\dfrac{1}{2}} \\cdot \\underbrace{\\begin{bmatrix}8 \\\\ 0\\end{bmatrix}}_{\\large\\color{blue}\\mathbf{v}_3}\n$$\n\n\nis the linear combination of vectors $\\mathbf{\\color{blue}v_1},\\mathbf{\\color{blue}v_2},\\mathbf{\\color{blue}v_3}$ with coefficients ${\\color{red}2}, {\\color{red}0}, {\\color{red}\\dfrac{1}{2}},$ respectively." :tutorial/id #uuid "229ae855-226b-5f95-b050-b98257747800" :tutorial/math-academy-id 3186 :tutorial/title "Introduction"} :step/id #uuid "b14c637b-1418-59f5-9ac3-37a07d6ad580" :step/math-academy-id 17456 :step/next {:db/id #edb/ref 17592186120673}} {:db/id #edb/ref 17592186120673 :step/content {:db/id #edb/ref 17592186119805 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119616 :question/id #uuid "fd3cb5b1-f16e-5a52-82e4-25bbbd1c4fe7" :question/math-academy-id "e-4789"} :knowledge-point/id #uuid "33586620-e110-5a37-874f-a92103c5e9fb" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048673} {:db/id #edb/ref 17592186049814}] :knowledge-point/question-generator {:db/id #edb/ref 17592186542367} :knowledge-point/questions [{:db/id #edb/ref 17592186120311} {:db/id #edb/ref 17592186120312} {:db/id #edb/ref 17592186240984} {:db/id #edb/ref 17592186240985} {:db/id #edb/ref 17592186314967} {:db/id #edb/ref 17592186317257} {:db/id #edb/ref 17592186319044} {:db/id #edb/ref 17592186319045} {:db/id #edb/ref 17592186319047} {:db/id #edb/ref 17592186419107} {:db/id #edb/ref 17592186542353} {:db/id #edb/ref 17592186542366} {:db/id #edb/ref 17592186562406} {:db/id #edb/ref 17592186562438} {:db/id #edb/ref 17592186562512}] :knowledge-point/title "Solving for One Coefficient in a Linear Combination"} :step/id #uuid "c7323a52-d0b1-55ea-81f4-41623766b9db" :step/math-academy-id 17458 :step/next {:db/id #edb/ref 17592186120674}} {:db/id #edb/ref 17592186120674 :step/content {:db/id #edb/ref 17592186119806 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119617 :question/id #uuid "548ef945-392b-5e75-9b60-14f4e2de6261" :question/math-academy-id "e-4790"} :knowledge-point/id #uuid "590953b8-2533-5a4b-bf4f-f002b0367919" :knowledge-point/question-generator {:db/id #edb/ref 17592186518762} :knowledge-point/questions [{:db/id #edb/ref 17592186120310} {:db