44dc8-4699-519f-8cb1-87ad77471ebe" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049058} {:db/id #edb/ref 17592186050178}] :knowledge-point/question-generator {:db/id #edb/ref 17592186538215} :knowledge-point/questions [{:db/id #edb/ref 17592186120309} {:db/id #edb/ref 17592186120349} {:db/id #edb/ref 17592186240992} {:db/id #edb/ref 17592186240993} {:db/id #edb/ref 17592186240994} {:db/id #edb/ref 17592186240995} {:db/id #edb/ref 17592186342126} {:db/id #edb/ref 17592186342130} {:db/id #edb/ref 17592186342132} {:db/id #edb/ref 17592186342133} {:db/id #edb/ref 17592186342134} {:db/id #edb/ref 17592186342138} {:db/id #edb/ref 17592186371499} {:db/id #edb/ref 17592186573926} {:db/id #edb/ref 17592186573932}] :knowledge-point/title "Solving for Three Coefficients in a Linear Combination"} :step/id #uuid "d59e4b4d-f7e2-5722-8cf4-a309ea8ac925" :step/math-academy-id 23175}] :activity/title "Linear Combinations of Vectors in N-Dimensional Euclidean Space" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186120045}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186435827} :activity/id #uuid "6df862cd-4cbb-5ff7-8a8e-426d6f6d3fd6" :activity/scope {:db/id #edb/ref 17592186048499 :topic/id #uuid "a4bbeec2-7e3f-58f1-87d1-563d58d73752" :topic/math-academy-id 1851} :activity/steps [{:db/id #edb/ref 17592186435826 :step/content {:db/id #edb/ref 17592186240990 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "222862ae-7c2b-5d66-9d9a-f59640c9801e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186238354} {:answer/id #uuid "346bdb71-8966-5ed4-ab2e-83d1ea69e239" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186238507} {:answer/id #uuid "4072326e-9528-5390-aaaa-546988c57563" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186238613} {:answer/id #uuid "4f101a20-f607-5e7e-b164-71aebdad2935" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No solution" :db/id #edb/ref 17592186238733} {:answer/id #uuid "61153d6d-bad7-5e46-a284-cae191fc9a25" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186238908}] :answer-field/correct {:db/id #edb/ref 17592186238507} :answer-field/id #uuid "47a0ee5a-75fc-5e2b-8002-cf62c42bfe1d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240456}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a4963b43-3177-544a-ab68-1ea699a13395" :question/math-academy-id "q-105166" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ -2 \\\\ 3\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}2 \\\\ -3 \\\\ 5\\end{bmatrix},\\,b=\\begin{bmatrix}-3 \\\\ 1 \\\\ -4\\end{bmatrix}.\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=b,$ then what is ${x}_{1}+{x}_{2}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=b$, then we have\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}1 \\\\ -2 \\\\ 3\\end{bmatrix}+{x}_{2}\\begin{bmatrix}2 \\\\ -3 \\\\ 5\\end{bmatrix} & =\\begin{bmatrix}-3 \\\\ 1 \\\\ -4\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1} \\\\ -2{x}_{1} \\\\ 3{x}_{1}\\end{bmatrix}+\\begin{bmatrix}2{x}_{2} \\\\ -3{x}_{2} \\\\ 5{x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-3 \\\\ 1 \\\\ -4\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1}+2{x}_{2} \\\\ -2{x}_{1}-3{x}_{2} \\\\ 3{x}_{1}+5{x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-3 \\\\ 1 \\\\ -4\\end{bmatrix}.\\end{aligned}\n$$\n\n \n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+2{x}_{2} &=-3 \\\\ -2{x}_{1}-3{x}_{2} &=1 \\\\ 3{x}_{1}+5{x}_{2} &=-4\\end{aligned}\\right.\n$$\n\nMultiplying the first equation by $2$ and adding the resulting equations, we obtain \n\n$$\n\\begin{aligned}{x}_{2} & =-5,\\end{aligned}\n$$\n\nwhich we substitute into the second equation to get \n\n$$\n\\begin{aligned}-2{x}_{1}-3{x}_{2}=1 \\\\ -2{x}_{1}-3(-5) & =1 \\\\ -2{x}_{1} & =-14 \\\\ {x}_{1} & =7.\\end{aligned}\n$$\n\nFinally, we substitute ${x}_{1}=7$ and ${x}_{2}=-5$ into the third equation and obtain\n\n$$\n\\begin{aligned}3{x}_{1}+5{x}_{2}=-4 \\\\ 3(7)+5(-5) & =-4 \\\\ -4 & =-4,\\end{aligned}\n$$\n\nwhich gives a true statement. \n\nSo the solution of the system is ${x}_{1}=7$ and ${x}_{2}=-5,$ which means\n\n$$\n7{a}_{1}-5{a}_{2}=b.\n$$\n\nConsequently, \n\n$$\n{x}_{1}+{x}_{2}=7+(-5)=2.\n$$"} :step/id #uuid "130d098a-c26b-57ed-9a17-40b7cc7b707e"} {:db/id #edb/ref 17592186435827 :step/content {:db/id #edb/ref 17592186435824 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b3b3e4e-ca03-5bf0-b918-e879378cf4f9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186435813} {:answer/id #uuid "3e56b548-f823-5efc-89ba-5bfa7fe486df" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11" :db/id #edb/ref 17592186435814} {:answer/id #uuid "62cff3cd-01fc-5c8d-bb73-00c6490598f8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-11" :db/id #edb/ref 17592186435815} {:answer/id #uuid "7f4f8e1e-a357-552c-aea0-48de6f4f316a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-7" :db/id #edb/ref 17592186435817} {:answer/id #uuid "a0c118c7-81b9-5bfc-90ce-dd9634f5f92e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186435820}] :answer-field/correct {:db/id #edb/ref 17592186435814} :answer-field/id #uuid "a66e7a5d-9617-5080-a5e0-b50e86007465" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186435823}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e8bdc664-5423-57fc-a753-871b318d24e0" :question/math-academy-id "q-34598" :question/problem "Find the value of ${x}_{1}-{x}_{2}$ given that  $4a+3x=b$ and\n\n$$\na=\\begin{bmatrix}3 \\\\ 3 \\\\ 3\\end{bmatrix},\\,x=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix},\\,b=\\begin{bmatrix}18 \\\\ -15 \\\\ -9\\end{bmatrix}.\n$$" :question/worked-solution "Using the properties of addition/subtraction and scalar multiplication of vectors to isolate $x,$ we get\n\n$$\n\\begin{aligned}4a+3x & =b \\\\ 3x & =b-4a \\\\ x & =\\frac{1}{3}(b-4a) \\\\ x & =\\frac{1}{3}(\\begin{bmatrix}18 \\\\ -15 \\\\ -9\\end{bmatrix}-4\\begin{bmatrix}3 \\\\ 3 \\\\ 3\\end{bmatrix}) \\\\ x & =\\frac{1}{3}\\begin{bmatrix}6 \\\\ -27 \\\\ -21\\end{bmatrix} \\\\ x & =\\begin{bmatrix}2 \\\\ -9 \\\\ -7\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, ${x}_{1}-{x}_{2}=2-(-9)=11.$"} :step/id #uuid "1ba155e6-7a63-58b8-ae54-fd477a157b3e" :step/next {:db/id #edb/ref 17592186435830}} {:db/id #edb/ref 17592186435828 :step/content {:db/id #edb/ref 17592186342133 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0dd1e2d3-3d25-597c-a847-faa140432c9c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186339255} {:answer/id #uuid "28a2b981-6db8-5f16-b21b-6ae088a23e3d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No solution" :db/id #edb/ref 17592186339484} {:answer/id #uuid "309c51a6-6646-55e5-a9ef-db0cd36bd5b0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186339553} {:answer/id #uuid "732f8930-5de1-53c0-8f9f-0564fc2ea176" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186340149} {:answer/id #uuid "d7a94670-179b-5241-8088-b40d00d22100" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186341041}] :answer-field/correct {:db/id #edb/ref 17592186339553} :answer-field/id #uuid "95f0dc3f-6280-5dbc-ad92-0375cafd9b79" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341644}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "237520c7-3369-5c34-87a7-ba4be3c9b705" :question/math-academy-id "q-74032" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}1 \\\\ -2 \\\\ 2\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}3 \\\\ -11 \\\\ 1\\end{bmatrix},\\,b=\\begin{bmatrix}5 \\\\ -18 \\\\ -1\\end{bmatrix}.\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b,$ then what is ${x}_{1}+{x}_{2}+{x}_{3}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b$, then we have\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}+{x}_{2}\\begin{bmatrix}1 \\\\ -2 \\\\ 2\\end{bmatrix}+{x}_{3}\\begin{bmatrix}3 \\\\ -11 \\\\ 1\\end{bmatrix} & =\\begin{bmatrix}5 \\\\ -18 \\\\ -1\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1} \\\\ 0 \\\\ {x}_{1}\\end{bmatrix}+\\begin{bmatrix}{x}_{2} \\\\ -2{x}_{2} \\\\ 2{x}_{2}\\end{bmatrix}+\\begin{bmatrix}3{x}_{3} \\\\ -11{x}_{3} \\\\ {x}_{3}\\end{bmatrix} & =\\begin{bmatrix}5 \\\\ -18 \\\\ -1\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1}+{x}_{2}+3{x}_{3} \\\\ -2{x}_{2}-11{x}_{3} \\\\ {x}_{1}+2{x}_{2}+{x}_{3}\\end{bmatrix} & =\\begin{bmatrix}5 \\\\ -18 \\\\ -1\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+{x}_{2}+3{x}_{3} &=5 \\\\ -2{x}_{2}-11{x}_{3} &=-18 \\\\ {x}_{1}+2{x}_{2}+{x}_{3} &=-1\\end{aligned}\\right.\n$$\n\nWe will solve this system using Gaussian elimination. First, we write the augmented matrix for this system:\n\n$$\nM=\\begin{bmatrix}1 & 1 & 3 & 5 \\\\ 0 & -2 & -11 & -18 \\\\ 1 & 2 & 1 & -1\\end{bmatrix}.\n$$\n\nRow-reducing the augmented matrix, we get\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 1 & 3 & 5 \\\\ 0 & -2 & -11 & -18 \\\\ 1 & 2 & 1 & -1\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-1){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 1 & 3 & 5 \\\\ 0 & -2 & -11 & -18 \\\\ 0 & 1 & -2 & -6\\end{bmatrix} & {R}_{2} & ↔{R}_{3} \\\\  & ∼\\begin{bmatrix}1 & 1 & 3 & -1 \\\\ 0 & 1 & -2 & -6 \\\\ 0 & -2 & -11 & -18\\end{bmatrix} & {R}_{3} & :={R}_{3}+2{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 1 & 3 & 5 \\\\ 0 & 1 & -2 & -6 \\\\ 0 & 0 & -15 & -30\\end{bmatrix} & {R}_{3} & :=-\\frac{1}{15}{R}_{3} \\\\  & ∼\\begin{bmatrix}1 & 1 & 3 & 5 \\\\ 0 & 1 & -2 & -6 \\\\ 0 & 0 & 1 & 2\\end{bmatrix}.\\end{aligned}\n$$\n\n \n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+{x}_{2}+3{x}_{3} &=5 \\\\ {x}_{2}-2{x}_{3} &=-6 \\\\ {x}_{3} &=2.\\end{aligned}\\right.\n$$\n\n \n\nFrom the third equation, we get ${x}_{3}=2.$ Substituting this value into  the second equation, we get\n\n$$\n{x}_{2}-2(2)=-6\\,⟹\\,{x}_{2}=-2.\n$$\n\n \n\nFinally, by substituting ${x}_{2}=-2$ and ${x}_{3}=2$ into the first equation, we obtain \n\n$$\n\\begin{aligned}{x}_{1}+{x}_{2}+3{x}_{3} & =5 \\\\ {x}_{1}+(-2)+3(2) & =5 \\\\ {x}_{1}+4 & =5 \\\\ {x}_{1} & =1.\\end{aligned}\n$$\n\nSo, the solution of the system is ${x}_{1}=1$, ${x}_{2}=-2$, and ${x}_{3}=2,$ which means \n\n$$\n{a}_{1}-2{a}_{2}+2{a}_{3}=b.\n$$\n\nConsequently, \n\n$$\n{x}_{1}+{x}_{2}+{x}_{3}=1+(-2)+2=1.\n$$"} :step/id #uuid "35ab3d0c-3feb-5eb0-8af0-2d726c5cb861" :step/next {:db/id #edb/ref 17592186435826}} {:db/id #edb/ref 17592186435829 :step/content {:db/id #edb/ref 17592186342130 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ca1e367-7e59-5b69-861b-8c5df685d98a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-12" :db/id #edb/ref 17592186339240} {:answer/id #uuid "70e98200-2ef8-5fee-9135-1a64cdf08565" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186340130} {:answer/id #uuid "a0f91210-c308-5ac5-8b5f-ecea8232309c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14" :db/id #edb/ref 17592186340589} {:answer/id #uuid "cd78319b-964c-5a76-83e0-5cc4ba5b698b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No solution" :db/id #edb/ref 17592186340951} {:answer/id #uuid "d5c0ee9d-d678-5d90-ac70-ae36c44cd666" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-7" :db/id #edb/ref 17592186341020}] :answer-field/correct {:db/id #edb/ref 17592186340951} :answer-field/id #uuid "d6466acd-a8cc-51d2-bb7d-d48bfacf96c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341757}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "ff5142a4-ab7b-5300-baa5-14f6253ed7fa" :question/math-academy-id "q-74006" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}2 \\\\ -1 \\\\ -1\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}0 \\\\ -1 \\\\ -3\\end{bmatrix},\\,b=\\begin{bmatrix}-2 \\\\ 5 \\\\ 1\\end{bmatrix}.\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b,$ then what is ${x}_{1}+{x}_{2}+{x}_{3}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b,$ then   we have\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}+{x}_{2}\\begin{bmatrix}2 \\\\ -1 \\\\ -1\\end{bmatrix}+{x}_{3}\\begin{bmatrix}0 \\\\ -1 \\\\ -3\\end{bmatrix} & =\\begin{bmatrix}-2 \\\\ 5 \\\\ 1\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1} \\\\ 0 \\\\ {x}_{1}\\end{bmatrix}+\\begin{bmatrix}2{x}_{2} \\\\ -{x}_{2} \\\\ -{x}_{2}\\end{bmatrix}+\\begin{bmatrix}0 \\\\ -{x}_{3} \\\\ -3{x}_{3}\\end{bmatrix} & =\\begin{bmatrix}-2 \\\\ 5 \\\\ 1\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1}+2{x}_{2} \\\\ -{x}_{2}-{x}_{3} \\\\ {x}_{1}-{x}_{2}-3{x}_{3}\\end{bmatrix} & =\\begin{bmatrix}-2 \\\\ 5 \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+2{x}_{2} &=-2 \\\\ -{x}_{2}-{x}_{3} &=5 \\\\ {x}_{1}-{x}_{2}-3{x}_{3} &=1\\end{aligned}\\right.\n$$\n\nWe will solve this system using Gaussian elimination. First, we write the augmented matrix for this system:\n\n$$\nM=\\begin{bmatrix}1 & 2 & 0 & -2 \\\\ 0 & -1 & -1 & 5 \\\\ 1 & -1 & -3 & 1\\end{bmatrix}.\n$$\n\nRow-reducing the augmented matrix, we get\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 2 & 0 & -2 \\\\ 0 & -1 & -1 & 5 \\\\ 1 & -1 & -3 & 1\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-1){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & 0 & -2 \\\\ 0 & -1 & -1 & 5 \\\\ 0 & -3 & -3 & 3\\end{bmatrix} & {R}_{2} & :=(-1){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 2 & 0 & -2 \\\\ 0 & 1 & 1 & -5 \\\\ 0 & -3 & -3 & 3\\end{bmatrix} & {R}_{3} & :={R}_{3}+3{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 2 & 0 & -2 \\\\ 0 & 1 & 1 & -5 \\\\ 0 & 0 & 0 & -12\\end{bmatrix}.\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+2{x}_{2} &=-2 \\\\ {x}_{2}+{x}_{3} &=-5 \\\\ 0 &=-12.\\end{aligned}\\right.\n$$\n\nHowever, the final equation $0=-12$  gives a false statement. So the system has no solution."} :step/id #uuid "65c83c6b-907c-5488-b33a-fa5563a73ab2" :step/next {:db/id #edb/ref 17592186435828}} {:db/id #edb/ref 17592186435830 :step/content {:db/id #edb/ref 17592186435825 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fdd8247-3e99-5680-9837-f81ce2e4daa8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186435812} {:answer/id #uuid "6588aecf-5be8-5075-92ab-05e2c0bd205f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No solution" :db/id #edb/ref 17592186435816} {:answer/id #uuid "877b327c-7099-5b51-a1a0-e54f12c801d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186435818} {:answer/id #uuid "9a314fbe-bce0-5c72-becd-d86fdd89cb4c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186435819} {:answer/id #uuid "b6573507-37c6-5328-ab6e-7644606e55a7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186435821}] :answer-field/correct {:db/id #edb/ref 17592186435819} :answer-field/id #uuid "50ab6af3-7838-5baf-b926-7d20ec2e1151" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186435822}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e9e20ff9-23b3-5457-a430-304f98c0d839" :question/math-academy-id "q-73950" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=\\begin{bmatrix}3 \\\\ 4 \\\\ 2\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}-2 \\\\ 3 \\\\ -3\\end{bmatrix},\\,b=\\begin{bmatrix}-11 \\\\ 8 \\\\ -14\\end{bmatrix}.\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=b,$ then what is ${x}_{1}+{x}_{2}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=b$, then we have\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}3 \\\\ 4 \\\\ 2\\end{bmatrix}+{x}_{2}\\begin{bmatrix}-2 \\\\ 3 \\\\ -3\\end{bmatrix} & =\\begin{bmatrix}-11 \\\\ 8 \\\\ -14\\end{bmatrix} \\\\ \\begin{bmatrix}3{x}_{1} \\\\ 4{x}_{1} \\\\ 2{x}_{1}\\end{bmatrix}+\\begin{bmatrix}-2{x}_{2} \\\\ 3{x}_{2} \\\\ -3{x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-11 \\\\ 8 \\\\ -14\\end{bmatrix} \\\\ \\begin{bmatrix}3{x}_{1}-2{x}_{2} \\\\ 4{x}_{1}+3{x}_{2} \\\\ 2{x}_{1}-3{x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-11 \\\\ 8 \\\\ -14\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}3{x}_{1}-2{x}_{2} &=-11 \\\\ 4{x}_{1}+3{x}_{2} &=8 \\\\ 2{x}_{1}-3{x}_{2} &=-14\\end{aligned}\\right.\n$$\n\nAdding the second and the third equations we get \n\n$$\n\\begin{aligned}6{x}_{1} & =-6 \\\\ {x}_{1} & =-1,\\end{aligned}\n$$\n\nwhich we substitute into the second equation to get \n\n$$\n\\begin{aligned}4{x}_{1}+3{x}_{2} & =8 \\\\ 4(-1)+3{x}_{2} & =8 \\\\ 3{x}_{2} & =12 \\\\ {x}_{2} & =4.\\end{aligned}\n$$\n\nFinally, we substitute ${x}_{1}=-1$ and ${x}_{2}=4$ into the first equation to get\n\n$$\n\\begin{aligned}3{x}_{1}-2{x}_{2} & =-11 \\\\ 3(-1)-2(4) & =-11 \\\\ -11 & =-11,\\end{aligned}\n$$\n\nwhich gives a true statement. \n\nSo the solution of the system is ${x}_{1}=-1$ and ${x}_{2}=4,$ which means\n\n$$\n-{a}_{1}+4{a}_{2}=b.\n$$\n\nConsequently, \n\n$$\n{x}_{1}+{x}_{2}=-1+4=3.\n$$"} :step/id #uuid "b586b47f-7e9b-5e1b-a1bb-ec0e1f2e8048" :step/next {:db/id #edb/ref 17592186435829}}] :activity/title "Linear Combinations of Vectors in N-Dimensional Euclidean Space" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186435811}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186573976} :activity/id #uuid "1ded1c4d-35cf-5c32-841c-c252857f08c8" :activity/scope {:db/id #edb/ref 17592186048499 :topic/id #uuid "a4bbeec2-7e3f-58f1-87d1-563d58d73752" :topic/math-academy-id 1851} :activity/steps [{:db/id #edb/ref 17592186573963 :step/content {:db/id #edb/ref 17592186573932 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3612f42b-0a38-5946-b9e8-052f69ef6865" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186573492} {:answer/id #uuid "6951f3cf-b1cc-52f0-8053-481a177d156d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186573552} {:answer/id #uuid "80af8001-4176-59b0-a320-b4d9c58112b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186573593} {:answer/id #uuid "95896ab6-b57c-5779-a69a-7fc7f0cae1d6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No solution" :db/id #edb/ref 17592186573618} {:answer/id #uuid "dbe12096-f5e1-5d5a-bc70-4e3a5e7b7b3e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186573712}] :answer-field/correct {:db/id #edb/ref 17592186573552} :answer-field/id #uuid "cea41100-341d-5e9c-b722-4fac6c11f9fa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186573847}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d6a42f32-3ff1-5799-9155-413fd42c36ff" :question/math-academy-id "q-74043" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ 0 \\\\ 4\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}-2 \\\\ -5 \\\\ -1\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}3 \\\\ 11 \\\\ -2\\end{bmatrix},\\,b=\\begin{bmatrix}2 \\\\ -4 \\\\ 15\\end{bmatrix}.\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b,$ then what is ${x}_{1}+{x}_{2}+{x}_{3}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b$, then we have\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}1 \\\\ 0 \\\\ 4\\end{bmatrix}+{x}_{2}\\begin{bmatrix}-2 \\\\ -5 \\\\ -1\\end{bmatrix}+{x}_{3}\\begin{bmatrix}3 \\\\ 11 \\\\ -2\\end{bmatrix} & =\\begin{bmatrix}2 \\\\ -4 \\\\ 15\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1} \\\\ 0 \\\\ 4{x}_{1}\\end{bmatrix}+\\begin{bmatrix}-2{x}_{2} \\\\ -5{x}_{2} \\\\ -{x}_{2}\\end{bmatrix}+\\begin{bmatrix}3{x}_{3} \\\\ 11{x}_{3} \\\\ -2{x}_{3}\\end{bmatrix} & =\\begin{bmatrix}2 \\\\ -4 \\\\ 15\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1}-2{x}_{2}+3{x}_{3} \\\\ -5{x}_{2}+11{x}_{3} \\\\ 4{x}_{1}-{x}_{2}-2{x}_{3}\\end{bmatrix} & =\\begin{bmatrix}2 \\\\ -4 \\\\ 15\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-2{x}_{2}+3{x}_{3} &=2 \\\\ -5{x}_{2}+11{x}_{3} &=-4 \\\\ 4{x}_{1}-{x}_{2}-2{x}_{3} &=15\\end{aligned}\\right.\n$$\n\nWe will solve this system using Gaussian elimination. First, we write the augmented matrix for this system:\n\n$$\nM=\\begin{bmatrix}1 & -2 & 3 & 2 \\\\ 0 & -5 & 11 & -4 \\\\ 4 & -1 & -2 & 15\\end{bmatrix}\n$$\n\nRow-reducing the augmented matrix, we get\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -2 & 3 & 2 \\\\ 0 & -5 & 11 & -4 \\\\ 4 & -1 & -2 & 15\\end{bmatrix} & {R}_{3} & :={R}_{3}-4{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 & 3 & 2 \\\\ 0 & -5 & 11 & -4 \\\\ 0 & 7 & -14 & -7\\end{bmatrix} & {R}_{3} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -2 & 3 & 2 \\\\ 0 & 7 & -14 & -7 \\\\ 0 & -5 & 11 & -4\\end{bmatrix} & {R}_{2} & :=\\frac{1}{7}{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -2 & 3 & 2 \\\\ 0 & 1 & -2 & 1 \\\\ 0 & -5 & 11 & -4\\end{bmatrix} & {R}_{3} & :={R}_{3}+5{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -2 & 3 & 2 \\\\ 0 & 1 & -2 & 1 \\\\ 0 & 0 & 1 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, the system is now \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-2{x}_{2}+3{x}_{3} &=2 \\\\ {x}_{2}-2{x}_{3} &=1 \\\\ {x}_{3} &=1.\\end{aligned}\\right.\n$$\n\nFrom the third equation, we get ${x}_{3}=1.$ Substituting this value into the second equation, we get\n\n$$\n{x}_{2}-2(1)=1\\,⟹\\,{x}_{2}=3.\n$$\n\nFinally, by substituting ${x}_{2}=3$ and ${x}_{3}=1$  into the first equation, we obtain\n\n$$\n{x}_{1}-2(3)+3(1)=2\\,⟹\\,{x}_{1}=5.\n$$\n\nSo, the solution of the system is ${x}_{1}=5$, ${x}_{2}=3$, and ${x}_{3}=1,$ which means \n\n$$\n5{a}_{1}+3{a}_{2}+{a}_{3}=b.\n$$\n\nConsequently, \n\n$$\n{x}_{1}+{x}_{2}+{x}_{3}=5+3+1=9.\n$$"} :step/id #uuid "5e5dd9e3-c4d1-5b1b-aff0-87ac6ff067cb" :step/next {:db/id #edb/ref 17592186573974}} {:db/id #edb/ref 17592186573965 :step/content {:db/id #edb/ref 17592186342110 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a0b569a-8def-5df5-b42f-3135dd4d5db0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}2 \\\\ 4 \\\\ 9\\end{bmatrix}" :db/id #edb/ref 17592186339360} {:answer/id #uuid "3896821e-dec7-5884-ad52-5ca3a114b733" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3 \\\\ -5 \\\\ 6\\end{bmatrix}" :db/id #edb/ref 17592186339637} {:answer/id #uuid "3c9d29a7-85be-58bd-8990-c807b06606e9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}6 \\\\ -5 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186339668} {:answer/id #uuid "ab3c29be-4bcc-5dc0-b48a-fbfcfb942938" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3 \\\\ 6 \\\\ -5\\end{bmatrix}" :db/id #edb/ref 17592186340687} {:answer/id #uuid "db5099b6-1298-5164-b17c-d9086cd69a32" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3 \\\\ -4 \\\\ -9\\end{bmatrix}" :db/id #edb/ref 17592186341075}] :answer-field/correct {:db/id #edb/ref 17592186339637} :answer-field/id #uuid "dbf00c01-ca7d-54b8-ace5-516180ba4620" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341767}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0a045a18-4b26-532b-8e6c-7d683732c9ac" :question/math-academy-id "q-73931" :question/problem "Find $x$, if $3a+2x=b$ and\n\n$$\na=\\begin{bmatrix}1 \\\\ 2 \\\\ -5\\end{bmatrix},\\,b=\\begin{bmatrix}9 \\\\ -4 \\\\ -3\\end{bmatrix}.\n$$" :question/worked-solution "Using the properties of addition/subtraction and scalar multiplication of vectors to isolate $x,$ we get  \n\n$$\n\\begin{aligned}3a+2x & =b \\\\ 2x & =b-3a \\\\ x & =\\frac{1}{2}(b-3a) \\\\ x & =\\frac{1}{2}(\\begin{bmatrix}9 \\\\ -4 \\\\ -3\\end{bmatrix}-3\\begin{bmatrix}1 \\\\ 2 \\\\ -5\\end{bmatrix}) \\\\ x & =\\frac{1}{2}\\begin{bmatrix}6 \\\\ -10 \\\\ 12\\end{bmatrix} \\\\ x & =\\begin{bmatrix}3 \\\\ -5 \\\\ 6\\end{bmatrix}.\\end{aligned}\n$$"} :step/id #uuid "7d939ecf-f82a-5ec4-a019-879bcb1cd850" :step/next {:db/id #edb/ref 17592186573970}} {:db/id #edb/ref 17592186573970 :step/content {:db/id #edb/ref 17592186573926 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20fa005b-1cd6-5081-9086-3952281151c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186573461} {:answer/id #uuid "57674894-26ce-5222-bc39-0cec6a625ee3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186573535} {:answer/id #uuid "893ad3db-46c5-5114-a0bf-164fbc2e553c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186573603} {:answer/id #uuid "b1679c37-12a9-5a57-8ad6-19234d8f62c4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186573655} {:answer/id #uuid "e47ed6c4-56c5-56bd-aece-e96f46748978" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No solution" :db/id #edb/ref 17592186573723}] :answer-field/correct {:db/id #edb/ref 17592186573723} :answer-field/id #uuid "2e982092-3b3a-580a-859e-11cdf69c0b10" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186573788}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "cc7e6aad-0683-5027-b3d4-db532b43dae8" :question/math-academy-id "q-74011" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ -1 \\\\ 0\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}-2 \\\\ 3 \\\\ -1\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}2 \\\\ 1 \\\\ -3\\end{bmatrix},\\,b=\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}.\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b,$ then what is ${x}_{1}+{x}_{2}+{x}_{3}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b$, then we have\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}1 \\\\ -1 \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}-2 \\\\ 3 \\\\ -1\\end{bmatrix}+{x}_{3}\\begin{bmatrix}2 \\\\ 1 \\\\ -3\\end{bmatrix} & =\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1} \\\\ -{x}_{1} \\\\ 0\\end{bmatrix}+\\begin{bmatrix}-2{x}_{2} \\\\ 3{x}_{2} \\\\ -{x}_{2}\\end{bmatrix}+\\begin{bmatrix}2{x}_{3} \\\\ {x}_{3} \\\\ -3{x}_{3}\\end{bmatrix} & =\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1}-2{x}_{2}+2{x}_{3} \\\\ -{x}_{1}+3{x}_{2}+{x}_{3} \\\\ -{x}_{2}-3{x}_{3}\\end{bmatrix} & =\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-2{x}_{2}+2{x}_{3} &=1 \\\\ -{x}_{1}+3{x}_{2}+{x}_{3} &=0 \\\\ -{x}_{2}-3{x}_{3} &=1\\end{aligned}\\right.\n$$\n\nWe will solve this system using Gaussian elimination. First, we write the augmented matrix for this system:\n\n$$\nM=\\begin{bmatrix}1 & -2 & 2 & 1 \\\\ -1 & 3 & 1 & 0 \\\\ 0 & -1 & -3 & 1\\end{bmatrix}.\n$$\n\nRow-reducing the augmented matrix, we get\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -2 & 2 & 1 \\\\ -1 & 3 & 1 & 0 \\\\ 0 & -1 & -3 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 & 2 & 1 \\\\ 0 & 1 & 3 & 1 \\\\ 0 & -1 & -3 & 1\\end{bmatrix} & {R}_{3} & :={R}_{3}+{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -2 & 2 & 1 \\\\ 0 & 1 & 3 & 1 \\\\ 0 & 0 & 0 & 2\\end{bmatrix}.\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-2{x}_{2}+2{x}_{3} &=1 \\\\ {x}_{2}+3{x}_{3} &=1 \\\\ 0 &=2.\\end{aligned}\\right.\n$$\n\n \n\nHowever, the final equation $0=2$  gives a false statement. So the system has no solution."} :step/id #uuid "9c8193c2-597f-5403-8927-fd9563d2f3f7" :step/next {:db/id #edb/ref 17592186573963}} {:db/id #edb/ref 17592186573974 :step/content {:db/id #edb/ref 17592186573888 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "615f9ea6-bf4a-5c33-97ae-d5fd90fe2025" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186573546} {:answer/id #uuid "bb1cb320-faf4-519e-bb3a-3b286577e104" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186573666} {:answer/id #uuid "e4b02fdc-e26c-51d1-84e4-cd2865691519" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186573724} {:answer/id #uuid "f79ba100-ef34-5438-9bfa-f6eebba5776d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186573759} {:answer/id #uuid "f8d4cf0c-57ba-584b-add2-be80a88fd83d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186573761}] :answer-field/correct {:db/id #edb/ref 17592186573546} :answer-field/id #uuid "c3bef852-1208-5ae1-a04d-1b9e7cc4e7c0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186573841}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5a605eaf-55a3-544d-8186-239316368511" :question/math-academy-id "q-105165" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=\\begin{bmatrix}3 \\\\ 0 \\\\ -2\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}-8 \\\\ -1 \\\\ 4\\end{bmatrix},\\,b=\\begin{bmatrix}-1 \\\\ -2 \\\\ -2\\end{bmatrix}.\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=b,$ then what is ${x}_{1}+{x}_{2}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=b$, then we have\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}3 \\\\ 0 \\\\ -2\\end{bmatrix}+{x}_{2}\\begin{bmatrix}-8 \\\\ -1 \\\\ 4\\end{bmatrix} & =\\begin{bmatrix}-1 \\\\ -2 \\\\ -2\\end{bmatrix} \\\\ \\begin{bmatrix}3{x}_{1} \\\\ 0 \\\\ -2{x}_{1}\\end{bmatrix}+\\begin{bmatrix}-8{x}_{2} \\\\ -{x}_{2} \\\\ 4{x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-1 \\\\ -2 \\\\ -2\\end{bmatrix} \\\\ \\begin{bmatrix}3{x}_{1}-8{x}_{2} \\\\ -{x}_{2} \\\\ -2{x}_{1}+4{x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-1 \\\\ -2 \\\\ -2\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}3{x}_{1}-8{x}_{2} &=-1 \\\\ -{x}_{2} &=-2 \\\\ -2{x}_{1}+4{x}_{2} &=-2\\end{aligned}\\right.\n$$\n\nFrom the second equation we get ${x}_{2}=2$, which we substitute into the first equation to get \n\n$$\n\\begin{aligned}3{x}_{1}-8{x}_{2} & =-1 \\\\ 3{x}_{1}-8(2) & =-1 \\\\ 3{x}_{1} & =15 \\\\ {x}_{1} & =5.\\end{aligned}\n$$\n\nFinally, we substitute ${x}_{1}=5$ and ${x}_{2}=2$ into the third equation to get\n\n$$\n\\begin{aligned}-2{x}_{1}+4{x}_{2} & =-2 \\\\ -2(5)+4(2) & =-2 \\\\ -2 & =-2,\\end{aligned}\n$$\n\nwhich gives a true statement. \n\nSo the solution of the system is ${x}_{1}=5$ and ${x}_{2}=2,$ which means\n\n$$\n5{a}_{1}+2{a}_{2}=b.\n$$\n\nConsequently, \n\n$$\n{x}_{1}+{x}_{2}=5+2=7.\n$$"} :step/id #uuid "d9ae8a2f-caa7-5f55-8846-f4d8b973ca67"} {:db/id #edb/ref 17592186573976 :step/content {:db/id #edb/ref 17592186120310 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a8765e6-0879-5856-ad1b-f5eb1d7789a5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}2 \\\\ -1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186315364} {:answer/id #uuid "40775ed2-c9df-5e2a-a497-29165c069954" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 \\\\ -1 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186315488} {:answer/id #uuid "5aeb048a-16d3-59c4-b03e-ad92c8ce7998" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}6 \\\\ -1 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186315634} {:answer/id #uuid "862e28cf-dd10-5b90-8ece-d08261ca4a6a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}6 \\\\ 0 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186315869} {:answer/id #uuid "d3abbdcf-b73d-5cc1-8e30-ffe65468b6df" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3 \\\\ -2 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186316304}] :answer-field/correct {:db/id #edb/ref 17592186315634} :answer-field/id #uuid "d7098ea9-3079-5fc0-af38-70d2a4655d4b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186317056}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ac599c23-1c9e-5d96-a71a-974c272cf869" :question/math-academy-id "q-34248" :question/problem "Find $x$, if $4a+6x=b$ and\n\n$$\na=\\begin{bmatrix}-3 \\\\ 0 \\\\ -7\\end{bmatrix},\\,b=\\begin{bmatrix}24 \\\\ -6 \\\\ -10\\end{bmatrix}.\n$$" :question/worked-solution "Using the properties of addition/subtraction and scalar multiplication of vectors to isolate $x,$ we get\n\n$$\n\\begin{aligned}4a+6x & =b \\\\ 6x & =b-4a \\\\ x & =\\frac{1}{6}(b-4a) \\\\ x & =\\frac{1}{6}(\\begin{bmatrix}24 \\\\ -6 \\\\ -10\\end{bmatrix}-4\\begin{bmatrix}-3 \\\\ 0 \\\\ -7\\end{bmatrix}) \\\\ x & =\\frac{1}{6}\\begin{bmatrix}36 \\\\ -6 \\\\ 18\\end{bmatrix} \\\\ x & =\\begin{bmatrix}6 \\\\ -1 \\\\ 3\\end{bmatrix}.\\end{aligned}\n$$"} :step/id #uuid "dd0ee9d8-6fde-56c8-9194-642bbfddfb6f" :step/next {:db/id #edb/ref 17592186573965}}] :activity/title "Linear Combinations of Vectors in N-Dimensional Euclidean Space" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186573413}]}
