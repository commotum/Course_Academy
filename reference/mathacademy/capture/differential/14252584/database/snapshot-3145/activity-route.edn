#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186573976} :activity/id #uuid "1ded1c4d-35cf-5c32-841c-c252857f08c8" :activity/scope {:db/id #edb/ref 17592186048499 :topic/id #uuid "a4bbeec2-7e3f-58f1-87d1-563d58d73752" :topic/math-academy-id 1851} :activity/steps [{:db/id #edb/ref 17592186573963 :step/content {:db/id #edb/ref 17592186573932 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3612f42b-0a38-5946-b9e8-052f69ef6865" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186573492} {:answer/id #uuid "6951f3cf-b1cc-52f0-8053-481a177d156d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186573552} {:answer/id #uuid "80af8001-4176-59b0-a320-b4d9c58112b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186573593} {:answer/id #uuid "95896ab6-b57c-5779-a69a-7fc7f0cae1d6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No solution" :db/id #edb/ref 17592186573618} {:answer/id #uuid "dbe12096-f5e1-5d5a-bc70-4e3a5e7b7b3e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186573712}] :answer-field/correct {:db/id #edb/ref 17592186573552} :answer-field/id #uuid "cea41100-341d-5e9c-b722-4fac6c11f9fa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186573847}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d6a42f32-3ff1-5799-9155-413fd42c36ff" :question/math-academy-id "q-74043" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ 0 \\\\ 4\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}-2 \\\\ -5 \\\\ -1\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}3 \\\\ 11 \\\\ -2\\end{bmatrix},\\,b=\\begin{bmatrix}2 \\\\ -4 \\\\ 15\\end{bmatrix}.\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b,$ then what is ${x}_{1}+{x}_{2}+{x}_{3}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b$, then we have\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}1 \\\\ 0 \\\\ 4\\end{bmatrix}+{x}_{2}\\begin{bmatrix}-2 \\\\ -5 \\\\ -1\\end{bmatrix}+{x}_{3}\\begin{bmatrix}3 \\\\ 11 \\\\ -2\\end{bmatrix} & =\\begin{bmatrix}2 \\\\ -4 \\\\ 15\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1} \\\\ 0 \\\\ 4{x}_{1}\\end{bmatrix}+\\begin{bmatrix}-2{x}_{2} \\\\ -5{x}_{2} \\\\ -{x}_{2}\\end{bmatrix}+\\begin{bmatrix}3{x}_{3} \\\\ 11{x}_{3} \\\\ -2{x}_{3}\\end{bmatrix} & =\\begin{bmatrix}2 \\\\ -4 \\\\ 15\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1}-2{x}_{2}+3{x}_{3} \\\\ -5{x}_{2}+11{x}_{3} \\\\ 4{x}_{1}-{x}_{2}-2{x}_{3}\\end{bmatrix} & =\\begin{bmatrix}2 \\\\ -4 \\\\ 15\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-2{x}_{2}+3{x}_{3} &=2 \\\\ -5{x}_{2}+11{x}_{3} &=-4 \\\\ 4{x}_{1}-{x}_{2}-2{x}_{3} &=15\\end{aligned}\\right.\n$$\n\nWe will solve this system using Gaussian elimination. First, we write the augmented matrix for this system:\n\n$$\nM=\\begin{bmatrix}1 & -2 & 3 & 2 \\\\ 0 & -5 & 11 & -4 \\\\ 4 & -1 & -2 & 15\\end{bmatrix}\n$$\n\nRow-reducing the augmented matrix, we get\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -2 & 3 & 2 \\\\ 0 & -5 & 11 & -4 \\\\ 4 & -1 & -2 & 15\\end{bmatrix} & {R}_{3} & :={R}_{3}-4{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 & 3 & 2 \\\\ 0 & -5 & 11 & -4 \\\\ 0 & 7 & -14 & -7\\end{bmatrix} & {R}_{3} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -2 & 3 & 2 \\\\ 0 & 7 & -14 & -7 \\\\ 0 & -5 & 11 & -4\\end{bmatrix} & {R}_{2} & :=\\frac{1}{7}{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -2 & 3 & 2 \\\\ 0 & 1 & -2 & 1 \\\\ 0 & -5 & 11 & -4\\end{bmatrix} & {R}_{3} & :={R}_{3}+5{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -2 & 3 & 2 \\\\ 0 & 1 & -2 & 1 \\\\ 0 & 0 & 1 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, the system is now \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-2{x}_{2}+3{x}_{3} &=2 \\\\ {x}_{2}-2{x}_{3} &=1 \\\\ {x}_{3} &=1.\\end{aligned}\\right.\n$$\n\nFrom the third equation, we get ${x}_{3}=1.$ Substituting this value into the second equation, we get\n\n$$\n{x}_{2}-2(1)=1\\,⟹\\,{x}_{2}=3.\n$$\n\nFinally, by substituting ${x}_{2}=3$ and ${x}_{3}=1$  into the first equation, we obtain\n\n$$\n{x}_{1}-2(3)+3(1)=2\\,⟹\\,{x}_{1}=5.\n$$\n\nSo, the solution of the system is ${x}_{1}=5$, ${x}_{2}=3$, and ${x}_{3}=1,$ which means \n\n$$\n5{a}_{1}+3{a}_{2}+{a}_{3}=b.\n$$\n\nConsequently, \n\n$$\n{x}_{1}+{x}_{2}+{x}_{3}=5+3+1=9.\n$$"} :step/id #uuid "5e5dd9e3-c4d1-5b1b-aff0-87ac6ff067cb" :step/next {:db/id #edb/ref 17592186573974}} {:db/id #edb/ref 17592186573965 :step/content {:db/id #edb/ref 17592186342110 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a0b569a-8def-5df5-b42f-3135dd4d5db0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}2 \\\\ 4 \\\\ 9\\end{bmatrix}" :db/id #edb/ref 17592186339360} {:answer/id #uuid "3896821e-dec7-5884-ad52-5ca3a114b733" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3 \\\\ -5 \\\\ 6\\end{bmatrix}" :db/id #edb/ref 17592186339637} {:answer/id #uuid "3c9d29a7-85be-58bd-8990-c807b06606e9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}6 \\\\ -5 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186339668} {:answer/id #uuid "ab3c29be-4bcc-5dc0-b48a-fbfcfb942938" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3 \\\\ 6 \\\\ -5\\end{bmatrix}" :db/id #edb/ref 17592186340687} {:answer/id #uuid "db5099b6-1298-5164-b17c-d9086cd69a32" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3 \\\\ -4 \\\\ -9\\end{bmatrix}" :db/id #edb/ref 17592186341075}] :answer-field/correct {:db/id #edb/ref 17592186339637} :answer-field/id #uuid "dbf00c01-ca7d-54b8-ace5-516180ba4620" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341767}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0a045a18-4b26-532b-8e6c-7d683732c9ac" :question/math-academy-id "q-73931" :question/problem "Find $x$, if $3a+2x=b$ and\n\n$$\na=\\begin{bmatrix}1 \\\\ 2 \\\\ -5\\end{bmatrix},\\,b=\\begin{bmatrix}9 \\\\ -4 \\\\ -3\\end{bmatrix}.\n$$" :question/worked-solution "Using the properties of addition/subtraction and scalar multiplication of vectors to isolate $x,$ we get  \n\n$$\n\\begin{aligned}3a+2x & =b \\\\ 2x & =b-3a \\\\ x & =\\frac{1}{2}(b-3a) \\\\ x & =\\frac{1}{2}(\\begin{bmatrix}9 \\\\ -4 \\\\ -3\\end{bmatrix}-3\\begin{bmatrix}1 \\\\ 2 \\\\ -5\\end{bmatrix}) \\\\ x & =\\frac{1}{2}\\begin{bmatrix}6 \\\\ -10 \\\\ 12\\end{bmatrix} \\\\ x & =\\begin{bmatrix}3 \\\\ -5 \\\\ 6\\end{bmatrix}.\\end{aligned}\n$$"} :step/id #uuid "7d939ecf-f82a-5ec4-a019-879bcb1cd850" :step/next {:db/id #edb/ref 17592186573970}} {:db/id #edb/ref 17592186573970 :step/content {:db/id #edb/ref 17592186573926 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20fa005b-1cd6-5081-9086-3952281151c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186573461} {:answer/id #uuid "57674894-26ce-5222-bc39-0cec6a625ee3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186573535} {:answer/id #uuid "893ad3db-46c5-5114-a0bf-164fbc2e553c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186573603} {:answer/id #uuid "b1679c37-12a9-5a57-8ad6-19234d8f62c4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186573655} {:answer/id #uuid "e47ed6c4-56c5-56bd-aece-e96f46748978" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No solution" :db/id #edb/ref 17592186573723}] :answer-field/correct {:db/id #edb/ref 17592186573723} :answer-field/id #uuid "2e982092-3b3a-580a-859e-11cdf69c0b10" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186573788}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "cc7e6aad-0683-5027-b3d4-db532b43dae8" :question/math-academy-id "q-74011" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ -1 \\\\ 0\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}-2 \\\\ 3 \\\\ -1\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}2 \\\\ 1 \\\\ -3\\end{bmatrix},\\,b=\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}.\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b,$ then what is ${x}_{1}+{x}_{2}+{x}_{3}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b$, then we have\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}1 \\\\ -1 \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}-2 \\\\ 3 \\\\ -1\\end{bmatrix}+{x}_{3}\\begin{bmatrix}2 \\\\ 1 \\\\ -3\\end{bmatrix} & =\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1} \\\\ -{x}_{1} \\\\ 0\\end{bmatrix}+\\begin{bmatrix}-2{x}_{2} \\\\ 3{x}_{2} \\\\ -{x}_{2}\\end{bmatrix}+\\begin{bmatrix}2{x}_{3} \\\\ {x}_{3} \\\\ -3{x}_{3}\\end{bmatrix} & =\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1}-2{x}_{2}+2{x}_{3} \\\\ -{x}_{1}+3{x}_{2}+{x}_{3} \\\\ -{x}_{2}-3{x}_{3}\\end{bmatrix} & =\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-2{x}_{2}+2{x}_{3} &=1 \\\\ -{x}_{1}+3{x}_{2}+{x}_{3} &=0 \\\\ -{x}_{2}-3{x}_{3} &=1\\end{aligned}\\right.\n$$\n\nWe will solve this system using Gaussian elimination. First, we write the augmented matrix for this system:\n\n$$\nM=\\begin{bmatrix}1 & -2 & 2 & 1 \\\\ -1 & 3 & 1 & 0 \\\\ 0 & -1 & -3 & 1\\end{bmatrix}.\n$$\n\nRow-reducing the augmented matrix, we get\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -2 & 2 & 1 \\\\ -1 & 3 & 1 & 0 \\\\ 0 & -1 & -3 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 & 2 & 1 \\\\ 0 & 1 & 3 & 1 \\\\ 0 & -1 & -3 & 1\\end{bmatrix} & {R}_{3} & :={R}_{3}+{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -2 & 2 & 1 \\\\ 0 & 1 & 3 & 1 \\\\ 0 & 0 & 0 & 2\\end{bmatrix}.\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-2{x}_{2}+2{x}_{3} &=1 \\\\ {x}_{2}+3{x}_{3} &=1 \\\\ 0 &=2.\\end{aligned}\\right.\n$$\n\n \n\nHowever, the final equation $0=2$  gives a false statement. So the system has no solution."} :step/id #uuid "9c8193c2-597f-5403-8927-fd9563d2f3f7" :step/next {:db/id #edb/ref 17592186573963}} {:db/id #edb/ref 17592186573974 :step/content {:db/id #edb/ref 17592186573888 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "615f9ea6-bf4a-5c33-97ae-d5fd90fe2025" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186573546} {:answer/id #uuid "bb1cb320-faf4-519e-bb3a-3b286577e104" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186573666} {:answer/id #uuid "e4b02fdc-e26c-51d1-84e4-cd2865691519" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186573724} {:answer/id #uuid "f79ba100-ef34-5438-9bfa-f6eebba5776d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186573759} {:answer/id #uuid "f8d4cf0c-57ba-584b-add2-be80a88fd83d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186573761}] :answer-field/correct {:db/id #edb/ref 17592186573546} :answer-field/id #uuid "c3bef852-1208-5ae1-a04d-1b9e7cc4e7c0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186573841}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5a605eaf-55a3-544d-8186-239316368511" :question/math-academy-id "q-105165" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=\\begin{bmatrix}3 \\\\ 0 \\\\ -2\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}-8 \\\\ -1 \\\\ 4\\end{bmatrix},\\,b=\\begin{bmatrix}-1 \\\\ -2 \\\\ -2\\end{bmatrix}.\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=b,$ then what is ${x}_{1}+{x}_{2}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=b$, then we have\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}3 \\\\ 0 \\\\ -2\\end{bmatrix}+{x}_{2}\\begin{bmatrix}-8 \\\\ -1 \\\\ 4\\end{bmatrix} & =\\begin{bmatrix}-1 \\\\ -2 \\\\ -2\\end{bmatrix} \\\\ \\begin{bmatrix}3{x}_{1} \\\\ 0 \\\\ -2{x}_{1}\\end{bmatrix}+\\begin{bmatrix}-8{x}_{2} \\\\ -{x}_{2} \\\\ 4{x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-1 \\\\ -2 \\\\ -2\\end{bmatrix} \\\\ \\begin{bmatrix}3{x}_{1}-8{x}_{2} \\\\ -{x}_{2} \\\\ -2{x}_{1}+4{x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-1 \\\\ -2 \\\\ -2\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}3{x}_{1}-8{x}_{2} &=-1 \\\\ -{x}_{2} &=-2 \\\\ -2{x}_{1}+4{x}_{2} &=-2\\end{aligned}\\right.\n$$\n\nFrom the second equation we get ${x}_{2}=2$, which we substitute into the first equation to get \n\n$$\n\\begin{aligned}3{x}_{1}-8{x}_{2} & =-1 \\\\ 3{x}_{1}-8(2) & =-1 \\\\ 3{x}_{1} & =15 \\\\ {x}_{1} & =5.\\end{aligned}\n$$\n\nFinally, we substitute ${x}_{1}=5$ and ${x}_{2}=2$ into the third equation to get\n\n$$\n\\begin{aligned}-2{x}_{1}+4{x}_{2} & =-2 \\\\ -2(5)+4(2) & =-2 \\\\ -2 & =-2,\\end{aligned}\n$$\n\nwhich gives a true statement. \n\nSo the solution of the system is ${x}_{1}=5$ and ${x}_{2}=2,$ which means\n\n$$\n5{a}_{1}+2{a}_{2}=b.\n$$\n\nConsequently, \n\n$$\n{x}_{1}+{x}_{2}=5+2=7.\n$$"} :step/id #uuid "d9ae8a2f-caa7-5f55-8846-f4d8b973ca67"} {:db/id #edb/ref 17592186573976 :step/content {:db/id #edb/ref 17592186120310 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a8765e6-0879-5856-ad1b-f5eb1d7789a5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}2 \\\\ -1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186315364} {:answer/id #uuid "40775ed2-c9df-5e2a-a497-29165c069954" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 \\\\ -1 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186315488} {:answer/id #uuid "5aeb048a-16d3-59c4-b03e-ad92c8ce7998" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}6 \\\\ -1 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186315634} {:answer/id #uuid "862e28cf-dd10-5b90-8ece-d08261ca4a6a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}6 \\\\ 0 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186315869} {:answer/id #uuid "d3abbdcf-b73d-5cc1-8e30-ffe65468b6df" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3 \\\\ -2 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186316304}] :answer-field/correct {:db/id #edb/ref 17592186315634} :answer-field/id #uuid "d7098ea9-3079-5fc0-af38-70d2a4655d4b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186317056}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ac599c23-1c9e-5d96-a71a-974c272cf869" :question/math-academy-id "q-34248" :question/problem "Find $x$, if $4a+6x=b$ and\n\n$$\na=\\begin{bmatrix}-3 \\\\ 0 \\\\ -7\\end{bmatrix},\\,b=\\begin{bmatrix}24 \\\\ -6 \\\\ -10\\end{bmatrix}.\n$$" :question/worked-solution "Using the properties of addition/subtraction and scalar multiplication of vectors to isolate $x,$ we get\n\n$$\n\\begin{aligned}4a+6x & =b \\\\ 6x & =b-4a \\\\ x & =\\frac{1}{6}(b-4a) \\\\ x & =\\frac{1}{6}(\\begin{bmatrix}24 \\\\ -6 \\\\ -10\\end{bmatrix}-4\\begin{bmatrix}-3 \\\\ 0 \\\\ -7\\end{bmatrix}) \\\\ x & =\\frac{1}{6}\\begin{bmatrix}36 \\\\ -6 \\\\ 18\\end{bmatrix} \\\\ x & =\\begin{bmatrix}6 \\\\ -1 \\\\ 3\\end{bmatrix}.\\end{aligned}\n$$"} :step/id #uuid "dd0ee9d8-6fde-56c8-9194-642bbfddfb6f" :step/next {:db/id #edb/ref 17592186573965}}] :activity/title "Linear Combinations of Vectors in N-Dimensional Euclidean Space" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186573413}]}
