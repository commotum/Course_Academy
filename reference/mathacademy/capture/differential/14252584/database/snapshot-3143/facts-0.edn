7] [17592186120673 #edb/ref 1063 #edb/ref 17592186119805 #edb/ref 17592186045417] [17592186120674 #edb/ref 1058 #edb/ref 17592186120675 #edb/ref 17592186045417] [17592186120674 #edb/ref 1061 17460 #edb/ref 17592186045417] [17592186120674 #edb/ref 1062 #uuid "fd939fe8-9699-5d8a-9dce-0e749d48075e" #edb/ref 17592186045417] [17592186120674 #edb/ref 1063 #edb/ref 17592186119806 #edb/ref 17592186045417] [17592186120675 #edb/ref 1058 #edb/ref 17592186120748 #edb/ref 17592186045417] [17592186120675 #edb/ref 1061 17464 #edb/ref 17592186045417] [17592186120675 #edb/ref 1062 #uuid "fd740ffd-227c-5f9c-9418-4c54bf1616ff" #edb/ref 17592186045417] [17592186120675 #edb/ref 1063 #edb/ref 17592186119807 #edb/ref 17592186045417] [17592186120748 #edb/ref 1061 23175 #edb/ref 17592186045417] [17592186120748 #edb/ref 1062 #uuid "d59e4b4d-f7e2-5722-8cf4-a309ea8ac925" #edb/ref 17592186045417] [17592186120748 #edb/ref 1063 #edb/ref 17592186119854 #edb/ref 17592186045417] [17592186121034 #edb/ref 1064 "Consider a vector $\\mathbf{u}$ which is given in terms of the vectors $\\mathbf{v_1}$ and $\\mathbf{v_2}$ as follows:\n\n$$\n{\\color{red}3}{\\color{blue}\\mathbf{v_1}}+({\\color{red}-2}){\\color{blue}\\mathbf{v_2}} = \\mathbf{u}\n$$\n\nHere, we say that $\\mathbf{u}$ is a **linear combination** of the vectors ${\\color{blue}\\mathbf{v_1}}$ and ${\\color{blue}\\mathbf{v_2}}$ with coefficients ${\\color{red}3}$ and ${\\color{red}-2}$ respectively. \n\nIn general, a linear combination of $n$ vectors $\\mathbf{v_1},\\mathbf{v_2},\\dots,\\mathbf{v_n}$ is the *weighted sum*\n\n$$\n{\\color{red}x_1}\\mathbf{\\color{blue}v_1}+{\\color{red}x_2}\\mathbf{\\color{blue}v_2}+\\cdots + {\\color{red}x_n}\\mathbf{\\color{blue}v_n} = \\mathbf{u},\n$$\n\nwhere ${\\color{red}x_1},{\\color{red}x_2},\\dots,{\\color{red}x_n}\\in\\mathbb{R}.$ We say that $\\mathbf{u}$ is a linear combination of the vectors $\\mathbf{\\color{blue}v_1},\\mathbf{\\color{blue}v_2},\\dots,\\mathbf{\\color{blue}v_n}$ with coefficients (or *weights*) ${\\color{red}x_1},{\\color{red}x_2},\\dots,{\\color{red}x_n},$ respectively.\n\nFor instance, \n\n\n$$\n{\\color{red}2} \\cdot \\underbrace{\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}}_{\\large\\color{blue}\\mathbf{v}_1} + {\\color{red}0} \\cdot \\underbrace{\\begin{bmatrix}\\sqrt{2} \\\\ 3\\end{bmatrix}}_{\\large\\color{blue}\\mathbf{v}_2} + {\\color{red}\\dfrac{1}{2}} \\cdot \\underbrace{\\begin{bmatrix}8 \\\\ 0\\end{bmatrix}}_{\\large\\color{blue}\\mathbf{v}_3}\n$$\n\n\nis the linear combination of vectors $\\mathbf{\\color{blue}v_1},\\mathbf{\\color{blue}v_2},\\mathbf{\\color{blue}v_3}$ with coefficients ${\\color{red}2}, {\\color{red}0}, {\\color{red}\\dfrac{1}{2}},$ respectively." #edb/ref 17592186045443] [17592186121034 #edb/ref 1065 3186 #edb/ref 17592186045417] [17592186121034 #edb/ref 1066 #uuid "229ae855-226b-5f95-b050-b98257747800" #edb/ref 17592186045417] [17592186121034 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186238354 #edb/ref 1080 "-1" #edb/ref 17592186045417] [17592186238354 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186238354 #edb/ref 1083 #uuid "222862ae-7c2b-5d66-9d9a-f59640c9801e" #edb/ref 17592186045417] [17592186238507 #edb/ref 1080 "2" #edb/ref 17592186045417] [17592186238507 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186238507 #edb/ref 1083 #uuid "346bdb71-8966-5ed4-ab2e-83d1ea69e239" #edb/ref 17592186045417] [17592186238613 #edb/ref 1080 "-2" #edb/ref 17592186045417] [17592186238613 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186238613 #edb/ref 1083 #uuid "4072326e-9528-5390-aaaa-546988c57563" #edb/ref 17592186045417] [17592186238733 #edb/ref 1080 "No solution" #edb/ref 17592186045417] [17592186238733 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186238733 #edb/ref 1083 #uuid "4f101a20-f607-5e7e-b164-71aebdad2935" #edb/ref 17592186045417] [17592186238908 #edb/ref 1080 "5" #edb/ref 17592186045417] [17592186238908 #