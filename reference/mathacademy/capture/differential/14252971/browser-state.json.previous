i mathvariant=\"bold\">c</mi></mrow><mo>+</mo><mo stretchy=\"false\">(</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">b</mi></mrow><mo>+</mo><mn>3</mn><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">c</mi></mrow><mo stretchy=\"false\">)</mo><mo>⋅</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">d</mi></mrow><mo>=</mo><mn>26.</mn></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
