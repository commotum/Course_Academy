owledge-point/id #uuid "0c105dd8-6739-5889-a529-9182ea814d76" :knowledge-point/title "Calculating the Second Moment of a Random Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fa850acb-3fde-5f4a-bfa9-139a31b031df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{21}{8}" :db/id #edb/ref 17592186367214} {:answer/id #uuid "11016637-5996-50ad-9a83-a0f0f6ad3935" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{21}{4}" :db/id #edb/ref 17592186367215} {:answer/id #uuid "f2a47e01-a255-5a0a-8a9c-bb533a113fba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186367216} {:answer/id #uuid "0f58c812-e9a9-5af9-b4f3-9e914ee43ec5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{41}{2}" :db/id #edb/ref 17592186367217} {:answer/id #uuid "583435ac-e60d-5d39-9b12-410d744b6169" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{21}{2}" :db/id #edb/ref 17592186367218}] :answer-field/correct {:answer/id #uuid "f2a47e01-a255-5a0a-8a9c-bb533a113fba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186367216} :answer-field/id #uuid "0494f5c6-4107-563c-a585-1687bd2827c2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186367213}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2c68c663-d77f-5a12-85f4-75aca5eeb431" :question/math-academy-id "q-126777" :question/problem "A random variable $X$ has the probability distribution given below.\n\n| $x$ | $1$ | $3$ | $5$ | $7$ |\n| --- | --- | --- | --- | --- |\n| $f(x)$ | $\\frac{1}{8}$ | $\\frac{1}{4}$ | $\\frac{1}{2}$ | $\\frac{1}{8}$ |\n\nCalculate $\\text{E}[{X}^{2}].$" :question/worked-solution "If $X$ is a discrete random variable with probability mass function $f(x)$ and sample space $S,$ the expected value of ${X}^{2}$ is given by\n\n$$\n\\text{E}[{X}^{2}]={\\sum }_{x\\in S}{x}^{2}\\cdot f(x).\n$$\n\nSumming up the products of each squared value of $X$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\sum }_{x\\in S}{x}^{2}\\cdot f(x) \\\\  & ={1}^{2}\\cdot \\frac{1}{8}+{3}^{2}\\cdot \\frac{1}{4}+{5}^{2}\\cdot \\frac{1}{2}+{7}^{2}\\cdot \\frac{1}{8} \\\\  & =1\\cdot \\frac{1}{8}+9\\cdot \\frac{1}{4}+25\\cdot \\frac{1}{2}+49\\cdot \\frac{1}{8} \\\\  & =21.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186416522 :knowledge-point/_questions [{:db/id #edb/ref 17592186175991 :knowledge-point/id #uuid "0c105dd8-6739-5889-a529-9182ea814d76" :knowledge-point/title "Calculating the Second Moment of a Random Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27659c3a-1630-525f-9403-71b378299d16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17}{11}" :db/id #edb/ref 17592186416511} {:answer/id #uuid "39031138-657e-5f4b-9c5a-5ffdc8c22c84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{11}" :db/id #edb/ref 17592186416512} {:answer/id #uuid "880594b0-02c0-573e-b57f-4ba4d8c79d1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{15}{11}" :db/id #edb/ref 17592186416514} {:answer/id #uuid "ad40040f-3c97-59ee-99db-2b9157068b63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{10}" :db/id #edb/ref 17592186416515} {:answer/id #uuid "e0aaacd1-dbaa-53a1-b38b-5a10a1d2faee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10}{11}" :db/id #edb/ref 17592186416519}] :answer-field/correct {:answer/id #uuid "39031138-657e-5f4b-9c5a-5ffdc8c22c84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{11}" :db/id #edb/ref 17592186416512} :answer-field/id #uuid "3108c7f3-de2f-5d87-917e-86599d83d83e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186416520}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "63d21bd1-32a2-5018-8996-67c94ddd1ddb" :question/math-academy-id "q-126779" :question/problem "A random variable $X$ has the probability distribution given below.\n\n$$\nf(x)={\\begin{aligned}\\frac{2}{11}, & x=-2 \\\\ \\frac{5}{11}, & x=-1 \\\\ \\frac{4}{11}, & x=0\\end{aligned}\n$$\n\nCalculate $\\text{E}[{X}^{2}].$" :question/worked-solution "If $X$ is a discrete random variable with probability mass function $f(x)$ and sample space $S,$ the expected value of ${X}^{2}$ is given by\n\n$$\n\\text{E}[{X}^{2}]={\\sum }_{x\\in S}{x}^{2}\\cdot f(x).\n$$\n\nSumming up the products of each squared value of $X$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\sum }_{x\\in S}{x}^{2}\\cdot f(x) \\\\  & =(-2)^{2}\\cdot \\frac{2}{11}+(-1)^{2}\\cdot \\frac{5}{11}+{0}^{2}\\cdot \\frac{4}{11} \\\\  & =4\\cdot \\frac{2}{11}+1\\cdot \\frac{5}{11}+0\\cdot \\frac{4}{11} \\\\  & =\\frac{13}{11}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186383487 :knowledge-point/_questions [{:db/id #edb/ref 17592186176042 :knowledge-point/id #uuid "ebfe6309-b8a3-5e4c-b2ae-495a91bcc433" :knowledge-point/title "Calculating Higher Moments of a Random Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5b8a58d0-d24e-5374-9574-b1ac167e3e68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{25}{3}" :db/id #edb/ref 17592186383489} {:answer/id #uuid "a1bf687f-10f9-5412-96b2-c0bb67904953" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{14}{3}" :db/id #edb/ref 17592186383490} {:answer/id #uuid "e4f970e3-1299-5474-a667-e3fb8bfdff41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{23}{6}" :db/id #edb/ref 17592186383491} {:answer/id #uuid "092af51a-8ad8-5776-9591-b1159c8cf01b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{19}{3}" :db/id #edb/ref 17592186383492} {:answer/id #uuid "5abcfbf6-76de-50f9-9a89-80041e3d5998" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{29}{6}" :db/id #edb/ref 17592186383493}] :answer-field/correct {:answer/id #uuid "5b8a58d0-d24e-5374-9574-b1ac167e3e68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{25}{3}" :db/id #edb/ref 17592186383489} :answer-field/id #uuid "646a1a86-23fa-54d0-a9d3-a07a5a07f69f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383488}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a3f5329f-19a3-574e-b0af-bcc718755f36" :question/math-academy-id "q-143821" :question/problem "A random variable $X$ has the probability distribution given below.\n\n$$\nf(x)={\\begin{aligned}\\frac{5}{12}, & x=0 \\\\ \\frac{1}{3}, & x=1 \\\\ \\frac{1}{4}, & x=2\\end{aligned}\n$$\n\nCalculate $\\text{E}[{X}^{5}].$" :question/worked-solution "If $X$ is a discrete random variable with probability mass function $f(x)$ and sample space $S,$ the expected value of ${X}^{5}$ is given by\n\n$$\n\\text{E}[{X}^{5}]={\\sum }_{x\\in S}{x}^{5}\\cdot f(x).\n$$\n\nSumming up the products of each cubed value of $X$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[{X}^{5}] & ={\\sum }_{x\\in S}{x}^{5}\\cdot f(x) \\\\  & ={0}^{5}\\cdot \\frac{5}{12}+{1}^{5}\\cdot \\frac{1}{3}+{2}^{5}\\cdot \\frac{1}{4} \\\\  & =0\\cdot \\frac{5}{12}+1\\cdot \\frac{1}{3}+32\\cdot \\frac{1}{4} \\\\  & =0+\\frac{1}{3}+8 \\\\  & =\\frac{25}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186367582 :knowledge-point/_questions [{:db/id #edb/ref 17592186176042 :knowledge-point/id #uuid "ebfe6309-b8a3-5e4c-b2ae-495a91bcc433" :knowledge-point/title "Calculating Higher Moments of a Random Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a012f21e-3afc-5030-b8ad-63748d81d665" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "39.25" :db/id #edb/ref 17592186367584} {:answer/id #uuid "9da03aa6-5893-582c-87bd-fe896096f6d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "38.25" :db/id #edb/ref 17592186367585} {:answer/id #uuid "f6faf7ac-e710-5e21-a7af-5637e9b7cdce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "37.25" :db/id #edb/ref 17592186367586} {:answer/id #uuid "34ffe0cc-dc6d-5b19-8b18-3856e7ee9292" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "33.75" :db/id #edb/ref 17592186367587} {:answer/id #uuid "b9e3cd07-bc7d-54e2-90b9-e9857cf859d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "35.75" :db/id #edb/ref 17592186367588}] :answer-field/correct {:answer/id #uuid "9da03aa6-5893-582c-87bd-fe896096f6d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "38.25" :db/id #edb/ref 17592186367585} :answer-field/id #uuid "f598da21-4cea-52d4-b619-be8780980c15" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186367583}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b92528f1-22be-5c5f-a1fc-bc9c1f101a38" :question/math-academy-id "q-143825" :question/problem "A random variable $X$ has the probability distribution given below.\n\n| $x$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- |\n| $f(x)$ | $0.25$ | $0.35$ | $0.4$ |\n\nCalculate $\\text{E}[{X}^{4}].$" :question/worked-solution "If $X$ is a discrete random variable with probability mass function $f(x)$ and sample space $S,$ the expected value of ${X}^{4}$ is given by\n\n$$\n\\text{E}[{X}^{4}]={\\sum }_{x\\in S}{x}^{4}\\cdot f(x).\n$$\n\nSumming up the products of each value of ${X}^{4}$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[{X}^{4}] & ={\\sum }_{x\\in S}{x}^{4}\\cdot f(x) \\\\  & ={1}^{4}\\cdot 0.25+{2}^{4}\\cdot 0.35+{3}^{4}\\cdot 0.4 \\\\  & =1\\cdot 0.25+16\\cdot 0.35+81\\cdot 0.4 \\\\  & =0.25+5.6+32.4 \\\\  & =38.25.\\end{aligned}\n$$"}]}
