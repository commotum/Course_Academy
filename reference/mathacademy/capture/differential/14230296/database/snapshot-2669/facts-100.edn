5417] [17592186552307 #edb/ref 1078 #edb/ref 17592186552084 #edb/ref 17592186045417] [17592186552307 #edb/ref 1079 #uuid "57bcc9c4-cdd4-55e6-a5b0-8d30dd034164" #edb/ref 17592186045417] [17592186552316 #edb/ref 1075 #edb/ref 17592186551777 #edb/ref 17592186045417] [17592186552316 #edb/ref 1075 #edb/ref 17592186551845 #edb/ref 17592186045417] [17592186552316 #edb/ref 1075 #edb/ref 17592186552073 #edb/ref 17592186045417] [17592186552316 #edb/ref 1075 #edb/ref 17592186552116 #edb/ref 17592186045417] [17592186552316 #edb/ref 1075 #edb/ref 17592186552245 #edb/ref 17592186045417] [17592186552316 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186552316 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186552316 #edb/ref 1078 #edb/ref 17592186552116 #edb/ref 17592186045417] [17592186552316 #edb/ref 1079 #uuid "6a3f931d-2db0-5acf-8977-4c0279c7518b" #edb/ref 17592186045417] [17592186552342 #edb/ref 1075 #edb/ref 17592186551693 #edb/ref 17592186045417] [17592186552342 #edb/ref 1075 #edb/ref 17592186551786 #edb/ref 17592186045417] [17592186552342 #edb/ref 1075 #edb/ref 17592186551789 #edb/ref 17592186045417] [17592186552342 #edb/ref 1075 #edb/ref 17592186551955 #edb/ref 17592186045417] [17592186552342 #edb/ref 1075 #edb/ref 17592186552025 #edb/ref 17592186045417] [17592186552342 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186552342 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186552342 #edb/ref 1078 #edb/ref 17592186552025 #edb/ref 17592186045417] [17592186552342 #edb/ref 1079 #uuid "9fb91e50-0e51-565e-98f0-4e7b44b96808" #edb/ref 17592186045417] [17592186552368 #edb/ref 1075 #edb/ref 17592186551703 #edb/ref 17592186045417] [17592186552368 #edb/ref 1075 #edb/ref 17592186551717 #edb/ref 17592186045417] [17592186552368 #edb/ref 1075 #edb/ref 17592186551830 #edb/ref 17592186045417] [17592186552368 #edb/ref 1075 #edb/ref 17592186552032 #edb/ref 17592186045417] [17592186552368 #edb/ref 1075 #edb/ref 17592186552049 #edb/ref 17592186045417] [17592186552368 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186552368 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186552368 #edb/ref 1078 #edb/ref 17592186551717 #edb/ref 17592186045417] [17592186552368 #edb/ref 1079 #uuid "c524fbfd-0dc2-5174-8d0f-5797b1138e36" #edb/ref 17592186045417] [17592186552404 #edb/ref 1068 #edb/ref 17592186552316 #edb/ref 17592186045417] [17592186552404 #edb/ref 1069 "q-248223" #edb/ref 17592186045417] [17592186552404 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186552404 #edb/ref 1071 "A newspaper in a town has $100\\,000$ subscribers, and $56\\,000$ of them have a digital subscription. If the newspaper randomly samples $224$ subscribers, find a normal approximation for the probability that between $112$ and $140$ subscribers (inclusive) in the sample have a digital subscription. You may assume that the population size is significantly larger than the sample size.\n\n*Hint: Two tables of values of $Φ(z)$ for different values of $z$ are given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n<table align=\"center\">\n<tbody><tr>\n<th>\n<table align=\"center\" cellpadding=\"5\" rules=\"all\">\n<tbody><tr> <th align=\"center\" bgcolor=\"#D6EAF8\" width=\"25%\">$z$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.00\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.01\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.02\\,$</th>\n</tr><tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-1.8\\,$</th><td align=\"center\"> $\\,0.0359\\,$ </td><td align=\"center\"> $\\,0.0351\\,$ </td><td align=\"center\"> $\\,0.0344\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-1.7\\,$</th><td align=\"center\"> $\\,0.0446\\,$ </td><td align=\"center\"> $\\,0.0436\\,$ </td><td align=\"center\"> $\\,0.0427\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-1.6\\,$</th><td align=\"center\"> $\\,0.0548\\,$ </td><td align=\"center\"> $\\,0.0537\\,$ </td><td align=\"center\"> $\\,0.0526\\,$ </td></tr>\n</tbody></table>\n</th>\n<th width=\"5%\"></th>\n<th>\n<table align=\"center\" cellpadding=\"5\" rules=\"all\">\n<tbody><tr> <th align=\"center\" bgcolor=\"#D6EAF8\" width=\"25%\">$z$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.05\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.06\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.07\\,$</th>\n</tr><tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,1.7\\,$</th><td align=\"center\"> $\\,0.9599\\,$ </td><td align=\"center\"> $\\,0.9608\\,$ </td><td align=\"center\"> $\\,0.9616\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,1.8\\,$</th><td align=\"center\"> $\\,0.9678\\,$ </td><td align=\"center\"> $\\,0.9686\\,$ </td><td align=\"center\"> $\\,0.9693\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,1.9\\,$</th><td align=\"center\"> $\\,0.9744\\,$ </td><td align=\"center\"> $\\,0.9750\\,$ </td><td align=\"center\"> $\\,0.9756\\,$ </td></tr>\n</tbody></table>\n</th>\n</tr>\n</tbody></table>" #edb/ref 17592186045417] [17592186552404 #edb/ref 1072 #uuid "0c142fbc-f51c-5174-b26c-467ddea21c93" #edb/ref 17592186045417] [17592186552404 #edb/ref 1074 "Given a population in which a proportion $p$ of the population has a particular characteristic, the sampling distribution of the sample proportion $\\overset{^}{\\,p}$ can be approximated as\n\n$$\n\\overset{^}{\\,p}∼N(p,\\frac{p(1-p)}{n}),\n$$\n\nwhere the sample size $n$ is much smaller than the population size, $np>5,$ and $n(1-p)>5.$\n\nIn our case\n\n- the sample size is $n=224,$ and\n\n- the population proportion is $p=\\frac{56\\,000}{100\\,000}=0.56.$\n\nNow, since\n\n$$\nnp=224(0.56)=125.44>5\n$$\n\nand\n\n$$\nn(1-p)=224(1-0.56)=98.56>5,\n$$\n\nand the $n=224$ is much smaller than the population size, we can apply the above approximation.\n\nThe sampling distribution of the sample proportion, in this case, can be approximated as\n\n$$\n\\begin{aligned}\\overset{^}{\\,p} & ∼N(p,\\frac{p(1-p)}{n}) \\\\  & ∼N(0.56,\\frac{0.56(1-0.56)}{224}) \\\\  & ∼N(0.56,0.0011).\\end{aligned}\n$$\n\nNext, we determine the probability we wish to find. If between $112$ and $140$ of subscribers in the sample have a digital subscription, then\n\n$$\n\\begin{aligned}\\frac{112}{224}\\le \\overset{^}{\\,p} & \\le \\frac{140}{224} \\\\ 0.5\\le \\overset{^}{\\,p} & \\le 0.625.\\end{aligned}\n$$\n\nHence, the probability we wish to find is\n$P(0.5\\le \\overset{^}{\\,p}\\le 0.625).$\nSo, we convert $\\overset{^}{\\,p}$ to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(0.5\\le \\overset{^}{\\,p}\\le 0.625) & =P(\\frac{0.5-0.56}{\\sqrt{0.0011}}\\le Z\\le \\frac{0.625-0.56}{\\sqrt{0.0011}}) \\\\  & ≈P(-1.81\\le Z\\le 1.96) \\\\  & =P(Z\\le 1.96)-P(Z\\le -1.81) \\\\  & =Φ(1.96)-Φ(-1.81)\\end{aligned}\n$$\n\nFrom the table, we have\n\n$$\n\\begin{aligned}Φ(1.96)=0.9750,\\,Φ(-1.81)=0.0351.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(0.5\\le \\overset{^}{\\,p}\\le 0.625) & =Φ(1.96)-Φ(-1.81) \\\\  & =0.9750-0.0351 \\\\  & =0.9399.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186552426 #edb/ref 1068 #edb/ref 17592186552342 #edb/ref 17592186045417] [17592186552426 #edb/ref 1069 "q-147484" #edb/ref 17592186045417] [17592186552426 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186552426 #edb/ref 1071 "A call center manager knows that $40%$ of the calls are complaints. If the manager randomly samples $80$ calls, find a normal approximation for the probability that more than $32$ but fewer than $36$ of them are complaints. You may assume that the population size is significantly larger than the sample size.\n\n*Note: $Φ(z)$ is the cumulative distribution function for the standard normal distribution.*" #edb/ref 17592186045417] [17592186552426 #edb/ref 1072 #uuid "3b794abe-e844-5b01-84a2-a65b6d920bc6" #edb/ref 17592186045417] [17592186552426 #edb/ref 1074 "Given a population in which a proportion $p$ of the population has a particular characteristic, the sampling distribution of the sample proportion $\\overset{^}{\\,p}$ can be approximated as\n\n$$\n\\overset{^}{\\,p}∼N(p,\\frac{p(1-p)}{n}),\n$$\n\nwhere the sample size $n$ is much smaller than the population size, $np>5,$ and $n(1-p)>5.$\n\nIn our case\n\n- the sample size is $n=80,$ and\n\n- the population proportion is $p=0.4.$\n\nNow, since\n\n$$\nnp=80(0.4)=32>5\n$$\n\nand\n\n$$\nn(1-p)=80(1-0.4)=48>5,\n$$\n\nand $n=80$ is much smaller than the population size, we can apply the above approximation.\n\nThe sampling distribution of the sample proportion, in this case, can be approximated as\n\n$$\n\\begin{aligned}\\overset{^}{\\,p} & ∼N(p,\\frac{p(1-p)}{n}) \\\\  & ∼N(0.4,\\frac{0.4(1-0.4)}{80}) \\\\  & ∼N(0.4,0.0030).\\end{aligned}\n$$\n\nNext, we determine the probability we wish to find. If more than $32$ but fewer than $36$ calls are complaints, then \n\n$$\n\\begin{aligned}\\frac{32}{80}<\\overset{^}{\\,p} & <\\frac{36}{80} \\\\ 0.4\\le \\overset{^}{\\,p} & \\le 0.45.\\end{aligned}\n$$\n\nHence, the probability we wish to find is\n$P(0.4<\\overset{^}{\\,p}<0.45).$\nSo, we convert $\\overset{^}{\\,p}$ to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(0.4\\le \\overset{^}{\\,p}\\le 0.45) & =P(\\frac{0.4-0.4}{\\sqrt{0.0030}}<Z<\\frac{0.45-0.4}{\\sqrt{0.0030}}) \\\\  & ≈P(0<Z<0.91) \\\\  & =P(Z<0.91)-P(Z<0.00) \\\\  & =Φ(0.91)-Φ(0.00)\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(0.4<\\overset{^}{\\,p}<0.45) & =Φ(0.91)-Φ(0).\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186552449 #edb/ref 1068 #edb/ref 17592186552307 #edb/ref 17592186045417] [17592186552449 #edb/ref 1069 "q-146954" #edb/ref 17592186045417] [17592186552449 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186552449 #edb/ref 1071 "Suppose we take a random sample of size $n=60$ from a population where $30%$ of the population has a particular characteristic. Find a normal approximation for the probability that more than $40%$ of the sample has the characteristic. You may assume that the population size is significantly larger than the sample size.\n\n*Hint: $Φ(z)$ is the cumulative distribution function for the standard normal distribution.*" #edb/ref 17592186045417] [17592186552449 #edb/ref 1072 #uuid "690b1c72-fb42-5766-9459-80c219f09698" #edb/ref 17592186045417] [17592186552449 #edb/ref 1074 "Given a population in which a proportion $p$ of the population has a particular characteristic, the sampling distribution of the sample proportion $\\overset{^}{\\,p}$ can be approximated as\n\n$$\n\\overset{^}{\\,p}∼N(p,\\frac{p(1-p)}{n}),\n$$\n\nwhere the sample size $n$ is much smaller than the population size, $np>5,$ and $n(1-p)>5.$\n\nIn our case\n\n- the sample size is $n=60,$ and\n\n- the population proportion is $p=0.3.$\n\nNow, since\n\n$$\nnp=60(0.3)=18>5\n$$\n\nand\n\n$$\nn(1-p)=60(1-0.3)=42>5,\n$$\n\nand $n=60$ is much smaller than the population size, we can apply the above approximation.\n\nThe sampling distribution of the sample proportion, in this case, can be approximated as\n\n$$\n\\begin{aligned}\\overset{^}{\\,p} & ∼N(p,\\frac{p(1-p)}{n}) \\\\  & ∼N(0.3,\\frac{0.3(1-0.3)}{60}) \\\\  & ∼N(0.3,0.0035).\\end{aligned}\n$$\n\nThe probability we wish to find is\n$P(\\overset{^}{\\,p}>0.4).$\nSo, we convert $\\overset{^}{\\,p}$ to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(\\overset{^}{\\,p}>0.4) & =P(Z>\\frac{0.4-0.3}{\\sqrt{0.0035}}) \\\\  & ≈P(Z>1.69) \\\\  & =1-P(Z\\le 1.69) \\\\  & =1-Φ(1.69)\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186552503 #edb/ref 1068 #edb/ref 17592186552368 #edb/ref 17592186045417] [17592186552503 #edb/ref 1069 "q-146831" #edb/ref 17592186045417] [17592186552503 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186552503 #edb/ref 1071 "For which of the following situations can the distribution of the sample proportion $\\overset{^}{\\,p}$ be approximated as\n\n$$\n\\overset{^}{\\,p}∼N(p,\\frac{p(1-p)}{n}),\n$$\n\nwhere $p$ is the population proportion?\n\nI. A sample of $50$ students from a class, where $60%$ of the students in the school have an IQ greater than $105.$\n\nII. A sample of $60$ paid TV customers, where $80%$ of the customers watch TV more than $8$ hours per week.\n\nIII. A sample of $40$ players in a team, $90%$ of the players in the league are right-handed.\n\n*Hint: In each case, you may assume that the population size is significantly larger than the sample size.*" #edb/ref 17592186045417] [17592186552503 #edb/ref 1072 #uuid "c3d4715f-79a5-5718-adbc-5959190456a6" #edb/ref 17592186045417] [17592186552503 #edb/ref 1074 "Given a population in which a proportion $p$ of the population has a particular characteristic, the sampling distribution of the sample proportion $\\overset{^}{\\,p}$ can be approximated as\n\n$$\n\\overset{^}{\\,p}∼N(p,\\frac{p(1-p)}{n}),\n$$\n\nwhere \n\n- $n\\le 5%\\cdot N$ (the sample size is less than (or equal to) $5%$ of the population size),\n\n- $np>5$ (more than $5$ sample elements have the characteristic), and\n\n- $n(1-p)>5$ (more than $5$ sample elements do not have the characteristic).\n\nWe're given that the population is significantly larger than the sample size in each case. Therefore, we may assume that the first condition is satisfied in each case.\n\nLet's now examine each situation.\n\n- In situation I, we have\n\n$$\n\\begin{aligned}np & =50(0.6) \\\\  & =30 \\\\  & >5\\,✓ \\\\ n(1-p) & =50(1-0.6) \\\\  & =20 \\\\  & >5.\\,✓\\end{aligned}\n$$\n\nTherefore, we can approximate the distribution of $\\overset{^}{\\,p}$ using the given model.\n\n- In situation II, we have\n\n$$\n\\begin{aligned}np & =60(0.8) \\\\  & =48 \\\\  & >5\\,✓ \\\\ n(1-p) & =60(1-0.8) \\\\  & =12 \\\\  & >5.\\,✓\\end{aligned}\n$$\n\nTherefore, we can approximate the distribution of $\\overset{^}{\\,p}$ using the given model.\n\n- In situation III, we have\n\n$$\n\\begin{aligned}np & =40(0.9) \\\\  & =36 \\\\  & >5\\,✓ \\\\ n(1-p) & =40(1-0.9) \\\\  & =4 \\\\  & ≯5.\\,\\times \\end{aligned}\n$$\n\nSince $n(1-p)≯5,$ we *cannot* approximate the distribution of $\\overset{^}{\\,p}$ using the given model.\n\nTherefore, the correct answer is \"I and II only.\"" #edb/ref 17592186045417] [17592186552542 #edb/ref 1062 #uuid "1e6af469-3c48-502f-905e-006eddadc5f7" #edb/ref 17592186045417] [17592186552542 #edb/ref 1063 #edb/ref 17592186552404 #edb/ref 17592186045417] [17592186552546 #edb/ref 1058 #edb/ref 17592186552574 #edb/ref 17592186045417] [17592186552546 #edb/ref 1062 #uuid "2771376d-b7ef-5e13-be47-2d41a0e0b7ed" #edb/ref 17592186045417] [17592186552546 #edb/ref 1063 #edb/ref 17592186552449 #edb/ref 17592186045417] [17592186552557 #edb/ref 1058 #edb/ref 17592186552546 #edb/ref 17592186045417] [17592186552557 #edb/ref 1062 #uuid "4b0aa4ac-1003-50f7-8beb-0e192289f5b2" #edb/ref 17592186045417] [17592186552557 #edb/ref 1063 #edb/ref 17592186552503 #edb/ref 17592186045417] [17592186552574 #edb/ref 1058 #edb/ref 17592186552542 #edb/ref 17592186045417] [17592186552574 #edb/ref 1062 #uuid "84cbff4c-5a75-5a51-933a-9d7902aaaddf" #edb/ref 17592186045417] [17592186552574 #edb/ref 1063 #edb/ref 17592186552426 #edb/ref 17592186045417] [17592186552594 #edb/ref 1058 #edb/ref 17592186552557 #edb/ref 17592186045417] [17592186552594 #edb/ref 1062 #uuid "b592bdb7-ec73-5da1-b03e-7cd731635534" #edb/ref 17592186045417] [17592186552594 #edb/ref 1063 #edb/ref 17592186188684 #edb/ref 17592186045417]}
