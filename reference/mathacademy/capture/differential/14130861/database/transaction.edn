choices ["answer-acf11764-516b-5536-8bd0-8896df8ccfb5" "answer-5234a80f-3964-5f6b-929f-0367338cb2a2" "answer-9f118ded-6d77-5044-83fb-ddb49902a5ca" "answer-a6de17e0-e776-5ca1-abdc-1fc86be8571c" "answer-108019a0-46c5-5872-8b39-0d3a33f620c2"] :db/ensure [:answer-field/validate]} {:db/id "answer-acf11764-516b-5536-8bd0-8896df8ccfb5" :answer/id #uuid "acf11764-516b-5536-8bd0-8896df8ccfb5" :answer/type :answer.type/math :answer/value "{180}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-5234a80f-3964-5f6b-929f-0367338cb2a2" :answer/id #uuid "5234a80f-3964-5f6b-929f-0367338cb2a2" :answer/type :answer.type/math :answer/value "{30}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-9f118ded-6d77-5044-83fb-ddb49902a5ca" :answer/id #uuid "9f118ded-6d77-5044-83fb-ddb49902a5ca" :answer/type :answer.type/math :answer/value "{45}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-a6de17e0-e776-5ca1-abdc-1fc86be8571c" :answer/id #uuid "a6de17e0-e776-5ca1-abdc-1fc86be8571c" :answer/type :answer.type/math :answer/value "{60}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-108019a0-46c5-5872-8b39-0d3a33f620c2" :answer/id #uuid "108019a0-46c5-5872-8b39-0d3a33f620c2" :answer/type :answer.type/math :answer/value "{90}^{∘}" :db/ensure [:answer/validate]} {:db/id "question-1b6c5790-6cdf-5b8e-a3f0-2a4d7d5bea22" :question/id #uuid "1b6c5790-6cdf-5b8e-a3f0-2a4d7d5bea22" :question/math-academy-id "q-320655" :question/problem "Expressed in radians, $\\operatorname{arccos}⁡(1)=${{field-1}}." :question/worked-solution "First, note that the range of $\\theta =\\operatorname{arccos}⁡x$ is given by\n\n$$\n0\\le \\theta \\le \\pi .\n$$\n\nNote that the angle $\\theta $ spans the first and second quadrants.\n\nNow, let's take a look at the unit circle.\n\n![](images/db/dbf36192ac332dc49ed75278838e989a37ac7d888311be1b8b059a7b59667aa6.png)\n\nFrom the values in the unit circle, we see that\n\n$$\n\\operatorname{cos}⁡(0)=1.\n$$\n\nTherefore,\n\n$$\n\\operatorname{arccos}⁡(1)=0.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-74919736-ad9c-5028-b680-d5b5ce7007df"] :db/ensure [:question/validate]} {:db/id "answer-field-74919736-ad9c-5028-b680-d5b5ce7007df" :answer-field/id #uuid "74919736-ad9c-5028-b680-d5b5ce7007df" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-ad1c072d-1fdd-5e3a-8540-bf8e8670a3bc" :answer-field/choices ["answer-ad1c072d-1fdd-5e3a-8540-bf8e8670a3bc"] :db/ensure [:answer-field/validate]} {:db/id "answer-ad1c072d-1fdd-5e3a-8540-bf8e8670a3bc" :answer/id #uuid "ad1c072d-1fdd-5e3a-8540-bf8e8670a3bc" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id 17592186060246 :question/problem "$\\operatorname{arcsin}⁡(-1)=$" :question/worked-solution "First, note that the range of $\\theta =\\operatorname{arcsin}⁡x$ is given by\n\n$$\n-\\frac{\\pi }{2}\\le \\theta \\le \\frac{\\pi }{2}.\n$$\n\nNow, let's take a look at the unit circle.\n\n![](images/db/dbf36192ac332dc49ed75278838e989a37ac7d888311be1b8b059a7b59667aa6.png)\n\nFrom the values on the unit circle, we see that\n\n$$\n\\operatorname{sin}⁡(\\frac{3\\pi }{2})=-1.\n$$\n\nHowever, $\\frac{3\\pi }{2}$ does not lie within the range of $\\theta .$ To get an angle that's coterminal with $\\frac{3\\pi }{2}$ that lies within the range of $\\theta ,$ we subtract $2\\pi .$\n\n$$\n\\frac{3\\pi }{2}-2\\pi =-\\frac{\\pi }{2}\n$$\n\nHence,\n\n$$\n\\operatorname{arcsin}⁡(-1)=-\\frac{\\pi }{2}.\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186058113 :answer-field/correct "answer-e642531e-a868-556f-a278-25243d434fda" :answer-field/choices ["answer-e642531e-a868-556f-a278-25243d434fda" "answer-f499bdbb-1a30-5059-8d7c-e95901e28a16" "answer-362fffeb-2576-5d58-b4ac-2e8e14f21e76" "answer-722eb547-e288-5ad4-ab49-790d9559959d" "answer-ecae479f-b48b-5f1e-97cb-6dff17dcea7d"] :db/ensure [:answer-field/validate]} {:db/id "answer-e642531e-a868-556f-a278-25243d434fda" :answer/id #uuid "e642531e-a868-556f-a278-25243d434fda" :answer/type :answer.type/math :answer/value "-\\frac{\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "answer-f499bdbb-1a30-5059-8d7c-e95901e28a16" :answer/id #uuid "f499bdbb-1a30-5059-8d7c-e95901e28a16" :answer/type :answer.type/math :answer/value "-\\frac{\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "answer-362fffeb-2576-5d58-b4ac-2e8e14f21e76" :answer/id #uuid "362fffeb-2576-5d58-b4ac-2e8e14f21e76" :answer/type :answer.type/math :answer/value "-\\pi " :db/ensure [:answer/validate]} {:db/id "answer-722eb547-e288-5ad4-ab49-790d9559959d" :answer/id #uuid "722eb547-e288-5ad4-ab49-790d9559959d" :answer/type :answer.type/math :answer/value "\\frac{3\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "answer-ecae479f-b48b-5f1e-97cb-6dff17dcea7d" :answer/id #uuid "ecae479f-b48b-5f1e-97cb-6dff17dcea7d" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "question-87ec257a-c863-5e49-a8f0-fba4f70038a2" :question/id #uuid "87ec257a-c863-5e49-a8f0-fba4f70038a2" :question/math-academy-id "q-320741" :question/problem "Expressed in degrees, $\\frac{2}{5}\\operatorname{arctan}⁡(1)=${{field-1}}${}^{∘}.$" :question/worked-solution "The range of $\\theta =\\operatorname{arctan}⁡x$ is given by\n\n$$\n-{90}^{∘}<\\theta <{90}^{∘}.\n$$\n\nNote that the angle $\\theta $ spans the first and fourth quadrants.\n\nSince $1$ is positive, our answer is an angle that lies in the first quadrant, where the tangent is positive.\n\nFrom the special values of the trigonometric functions, we know that \n\n$$\n\\operatorname{tan}⁡{45}^{∘}=1.\n$$\n\nSince ${45}^{∘}$ is an angle in the first quadrant that lies within the range of $arctan,$ we conclude that\n\n$$\n\\operatorname{arctan}⁡(1)={45}^{∘}.\n$$\n\nFinally, we get\n\n$$\n\\frac{2}{5}\\operatorname{arctan}⁡(1)=\\frac{2}{5}\\cdot {45}^{∘}={18}^{∘}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-797f7668-4aa0-52d3-afdc-f0d21caa5139"] :db/ensure [:question/validate]} {:db/id "answer-field-797f7668-4aa0-52d3-afdc-f0d21caa5139" :answer-field/id #uuid "797f7668-4aa0-52d3-afdc-f0d21caa5139" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-0e3ea772-e772-52b8-9654-53b9a628393a" :answer-field/choices ["answer-0e3ea772-e772-52b8-9654-53b9a628393a"] :db/ensure [:answer-field/validate]} {:db/id "answer-0e3ea772-e772-52b8-9654-53b9a628393a" :answer/id #uuid "0e3ea772-e772-52b8-9654-53b9a628393a" :answer/type :answer.type/math :answer/value "18" :db/ensure [:answer/validate]} {:db/id "question-182a0a62-9cfb-58e4-8415-cea11f6e4f4a" :question/id #uuid "182a0a62-9cfb-58e4-8415-cea11f6e4f4a" :question/math-academy-id "q-320722" :question/problem "Expressed in radians, $\\operatorname{arctan}⁡(-1)=${{field-1}}." :question/worked-solution "The range of $\\theta =\\operatorname{arctan}⁡x$ is given by\n\n$$\n-\\frac{\\pi }{2}<\\theta <\\frac{\\pi }{2}.\n$$\n\nNote that the angle $\\theta $ spans the first and fourth quadrants.\n\nSince $-1$ is negative, our answer is an angle that lies in the fourth quadrant, where the tangent is negative.\n\nFrom the special values of the trigonometric functions, we know that \n\n$$\n\\operatorname{tan}⁡(-\\frac{\\pi }{4})=-1.\n$$\n\nSince $-\\frac{\\pi }{4}$ is an angle in the fourth quadrant that lies within the range of $arctan,$ we conclude that\n\n$$\n\\operatorname{arctan}⁡(-1)=-\\frac{\\pi }{4}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-4d30847d-c042-5bde-bc2b-fabb63cbc1b6"] :db/ensure [:question/validate]} {:db/id "answer-field-4d30847d-c042-5bde-bc2b-fabb63cbc1b6" :answer-field/id #uuid "4d30847d-c042-5bde-bc2b-fabb63cbc1b6" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-ff26d36c-881d-524c-afc6-e0c4fa3b0fbb" :answer-field/choices ["answer-ff26d36c-881d-524c-afc6-e0c4fa3b0fbb"] :db/ensure [:answer-field/validate]} {:db/id "answer-ff26d36c-881d-524c-afc6-e0c4fa3b0fbb" :answer/id #uuid "ff26d36c-881d-524c-afc6-e0c4fa3b0fbb" :answer/type :answer.type/math :answer/value "-\\frac{\\pi}{4}" :db/ensure [:answer/validate]} {:db/id 17592186059908 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]}]
