#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186060744} :activity/id #uuid "74ecab93-81ae-530d-a3a5-33e8d26e428a" :activity/scope {:db/id #edb/ref 17592186050071 :topic/id #uuid "2ae4627d-ef98-53bb-82d4-2e7dec8bb5d5" :topic/math-academy-id 209} :activity/steps [{:db/id #edb/ref 17592186060744 :step/content {:db/id #edb/ref 17592186060956 :tutorial/content "Let's recall the ranges of the inverse trigonometric functions:\n\n- The range of $\\theta = \\arcsin x$ is given by\n\n$$\n-\\dfrac{\\pi}{2} \\leq \\theta \\leq \\dfrac{\\pi}{2}.\n$$\n\n- The range of $\\theta = \\arccos x$ is given by\n\n$$\n0 \\leq \\theta \\leq \\pi.\n$$\n\n- The range of $\\theta = \\arctan x$ is given by\n\n$$\n-\\dfrac{\\pi}{2} \\lt \\theta \\lt \\dfrac{\\pi}{2}.\n$$\n\nWhen working with inverse trigonometric functions, it's essential to check that any answers we get lie within the permitted range." :tutorial/id #uuid "80f1f954-b41c-5124-a1b3-f250972fbd1b" :tutorial/math-academy-id 4130 :tutorial/title "Introduction"} :step/id #uuid "337f1e8c-a4f4-5bac-bed9-c8d3dfba160e" :step/math-academy-id 24964 :step/next {:db/id #edb/ref 17592186060754}} {:db/id #edb/ref 17592186060745 :step/content {:db/id #edb/ref 17592186059810 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059609 :question/id #uuid "a3f9e797-4bfb-5b2a-b460-98d7def3ae20" :question/math-academy-id "e-6754"} :knowledge-point/id #uuid "9e89b620-641a-5dbf-85f6-ca0f7a2fad80" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048465} {:db/id #edb/ref 17592186048794} {:db/id #edb/ref 17592186050064}] :knowledge-point/questions [{:db/id #edb/ref 17592186060250} {:db/id #edb/ref 17592186060435} {:db/id #edb/ref 17592186233244} {:db/id #edb/ref 17592186233821} {:db/id #edb/ref 17592186290570} {:db/id #edb/ref 17592186290573} {:db/id #edb/ref 17592186294919} {:db/id #edb/ref 17592186299867} {:db/id #edb/ref 17592186299868} {:db/id #edb/ref 17592186299870} {:db/id #edb/ref 17592186299871} {:db/id #edb/ref 17592186299872} {:db/id #edb/ref 17592186299932} {:db/id #edb/ref 17592186357485} {:db/id #edb/ref 17592186357489} {:db/id #edb/ref 17592186427537} {:db/id #edb/ref 17592186427538}] :knowledge-point/title "Evaluating Arcsine or Arccosine"} :step/id #uuid "a29446f7-546f-5226-a2a3-5c83d2fe0b18" :step/math-academy-id 24965 :step/next {:db/id #edb/ref 17592186060753}} {:db/id #edb/ref 17592186060746 :step/content {:db/id #edb/ref 17592186059811 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059610 :question/id #uuid "83fc553b-3ad0-5003-afe3-81204a695162" :question/math-academy-id "e-6755"} :knowledge-point/id #uuid "3878b5fa-fd5e-5984-8516-96ee17bf137b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049656}] :knowledge-point/questions [{:db/id #edb/ref 17592186060245} {:db/id #edb/ref 17592186060248} {:db/id #edb/ref 17592186233822} {:db/id #edb/ref 17592186233824} {:db/id #edb/ref 17592186253348} {:db/id #edb/ref 17592186253349} {:db/id #edb/ref 17592186253350} {:db/id #edb/ref 17592186253351} {:db/id #edb/ref 17592186253352} {:db/id #edb/ref 17592186253353} {:db/id #edb/ref 17592186290571} {:db/id #edb/ref 17592186290574} {:db/id #edb/ref 17592186294920} {:db/id #edb/ref 17592186299885} {:db/id #edb/ref 17592186299886} {:db/id #edb/ref 17592186299896} {:db/id #edb/ref 17592186351397} {:db/id #edb/ref 17592186427536} {:db/id #edb/ref 17592186427539}] :knowledge-point/title "Evaluating Arctangent"} :step/id #uuid "cf59c4d2-4b20-5e45-b48e-dada8fc04e55" :step/math-academy-id 24967} {:db/id #edb/ref 17592186060753 :step/content {:db/id #edb/ref 17592186059816 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059620 :question/id #uuid "a2641aac-7c3a-5a2c-97f0-aca4782c7215" :question/math-academy-id "e-7220"} :knowledge-point/id #uuid "7c2791d4-f801-5555-a859-1d373f91a67e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186051050}] :knowledge-point/questions [{:db/id #edb/ref 17592186060246} {:db/id #edb/ref 17592186060247} {:db/id #edb/ref 17592186233674} {:db/id #edb/ref 17592186234444} {:db/id #edb/ref 17592186253339} {:db/id #edb/ref 17592186253340} {:db/id #edb/ref 17592186253341} {:db/id #edb/ref 17592186299914} {:db/id #edb/ref 17592186299916} {:db/id #edb/ref 17592186299920} {:db/id #edb/ref 17592186299927} {:db/id #edb/ref 17592186299928} {:db/id #edb/ref 17592186351398} {:db/id #edb/ref 17592186351399} {:db/id #edb/ref 17592186351400} {:db/id #edb/ref 17592186357450} {:db/id #edb/ref 17592186357451}] :knowledge-point/title "Evaluating Arcsine When a Coterminal Angle is Required"} :step/id #uuid "39e7a592-a7a2-575f-b8ff-4bafdc702616" :step/math-academy-id 26694 :step/next {:db/id #edb/ref 17592186060746}} {:db/id #edb/ref 17592186060754 :step/content {:db/id #edb/ref 17592186060961 :tutorial/content "Let's use our knowledge of inverse trigonometric functions to go through the steps of how to compute $\\arcsin \\left(\\dfrac {\\sqrt 3} 2\\right).$ \n\nFirst, note that if $\\theta = \\arcsin \\left(\\dfrac{\\sqrt3}{2}\\right),$ then we must have that $\\sin \\theta = \\dfrac{\\sqrt3}{2}.$\n\nSince the range of $\\arcsin x$ is $\\left[-\\dfrac{\\pi}{2}, \\dfrac{\\pi}{2}\\right],$ we need to find an angle $\\theta \\in \\left[-\\dfrac{\\pi}{2}, \\dfrac{\\pi}{2}\\right]$ (i.e., in either the first or fourth quadrants) such that $\\sin \\theta = \\dfrac{\\sqrt3}{2}.$\n\nSince $\\dfrac{\\sqrt3}{2}$ is positive, our answer is an angle that lies in the first quadrant, where sine is positive.\n\nNow, let's take a look at the unit circle to find our angle.\n\n![](images/db/dbf36192ac332dc49ed75278838e989a37ac7d888311be1b8b059a7b59667aa6.png)\n\nFrom the values in the first quadrant, we see that\n\n$$\n\\sin\\left(\\dfrac{\\pi}{3}\\right) = \\dfrac{\\sqrt3}{2}.\n$$\n\nTherefore,\n\n$$\n\\arcsin\\left(\\dfrac{\\sqrt3}{2}\\right) = \\dfrac{\\pi}{3}.\n$$" :tutorial/id #uuid "3b7bba61-2e7b-5fd4-bc89-d6042b7aff40" :tutorial/math-academy-id 4590 :tutorial/title "Computing the Value of an Inverse Trigonometric Function"} :step/id #uuid "47f9d118-f0cc-5452-a937-85425274acb2" :step/math-academy-id 28230 :step/next {:db/id #edb/ref 17592186060745}}] :activity/title "Evaluating Expressions Containing Inverse Trigonometric Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186059908}]}
