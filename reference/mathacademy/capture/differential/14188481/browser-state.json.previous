      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14188481/observations/step-q142574-27bdaf7062001a457b09.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14188481/observations/step-q142574-27bdaf7062001a457b09.png",
      "source_url": "https://mathacademy.com/tasks/14188481/topics/3855/lesson",
