      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14188481/observations/step-q142395-d0699b2492e002b48a87.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14188481/observations/step-q142395-d0699b2492e002b48a87.png",
      "source_url": "https://mathacademy.com/tasks/14188481/topics/3855/lesson",
