      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14188481/observations/step-q142512-f2a4e1e8c05ac8235a60.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14188481/observations/step-q142512-f2a4e1e8c05ac8235a60.png",
