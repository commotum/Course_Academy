[{"source" ":org/Math-Academy" "forms" [{:db/id 17592186096762 :knowledge-point/questions ["question-9b1a0e36-dce4-509e-90b0-4f68fe84ad7d" "question-b28f59d7-76e7-504d-aaab-0c27b75b3222"] :db/ensure [:knowledge-point/validate]} {:db/id "question-9b1a0e36-dce4-509e-90b0-4f68fe84ad7d" :question/id #uuid "9b1a0e36-dce4-509e-90b0-4f68fe84ad7d" :question/math-academy-id "q-84968" :question/problem "What are the coordinates of the vertex of the parabola $(x+5)^{2}=-3(y-6)?$" :question/worked-solution "The standard equation of an upward- or downward-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(x-h)^{2}=4p(y-k),\n$$\n\nwhere $p$ is constant.\n\nWe can rewrite the given equation as\n\n$$\n\\begin{aligned}(x+5)^{2} & =4(-\\frac{3}{4})(y-6).\\end{aligned}\n$$\n\nIt is now clear that our equation is of the standard type with $p=-\\frac{3}{4}.$\n\nComparing our equation with the standard equation, we can see that we have $h=-5$ and $k=6.$ Therefore, the coordinates of the vertex of the parabola are $(-5,6).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-eada811c-d053-5120-a961-fe8ffd045312"] :db/ensure [:question/validate]} {:db/id "answer-field-eada811c-d053-5120-a961-fe8ffd045312" :answer-field/id #uuid "eada811c-d053-5120-a961-fe8ffd045312" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1b92942c-8aba-5aa1-868e-af6ff0b747b3" :answer-field/choices ["answer-6de35bfe-a94a-5f6f-a2a7-be882652597a" "answer-1b92942c-8aba-5aa1-868e-af6ff0b747b3" "answer-f833dfc3-dd27-5cc6-a187-eb5f1348d40e" "answer-6332f8e1-70e3-52dc-ba10-2ad158c200d7" "answer-98125233-946f-554a-8efb-6031235b27b4"] :db/ensure [:answer-field/validate]} {:db/id "answer-6de35bfe-a94a-5f6f-a2a7-be882652597a" :answer/id #uuid "6de35bfe-a94a-5f6f-a2a7-be882652597a" :answer/type :answer.type/math :answer/value "(-3,-6)" :db/ensure [:answer/validate]} {:db/id "answer-1b92942c-8aba-5aa1-868e-af6ff0b747b3" :answer/id #uuid "1b92942c-8aba-5aa1-868e-af6ff0b747b3" :answer/type :answer.type/math :answer/value "(-5,6)" :db/ensure [:answer/validate]} {:db/id "answer-f833dfc3-dd27-5cc6-a187-eb5f1348d40e" :answer/id #uuid "f833dfc3-dd27-5cc6-a187-eb5f1348d40e" :answer/type :answer.type/math :answer/value "(5,-3)" :db/ensure [:answer/validate]} {:db/id "answer-6332f8e1-70e3-52dc-ba10-2ad158c200d7" :answer/id #uuid "6332f8e1-70e3-52dc-ba10-2ad158c200d7" :answer/type :answer.type/math :answer/value "(5,-6)" :db/ensure [:answer/validate]} {:db/id "answer-98125233-946f-554a-8efb-6031235b27b4" :answer/id #uuid "98125233-946f-554a-8efb-6031235b27b4" :answer/type :answer.type/math :answer/value "(6,-5)" :db/ensure [:answer/validate]} {:db/id 17592186096763 :knowledge-point/questions ["question-206046fc-72eb-5e7e-8330-c7dfc01fc134" "question-9b2b25e3-0202-54b4-aedb-ceb8981dd37f"] :db/ensure [:knowledge-point/validate]} {:db/id "question-206046fc-72eb-5e7e-8330-c7dfc01fc134" :question/id #uuid "206046fc-72eb-5e7e-8330-c7dfc01fc134" :question/math-academy-id "q-84976" :question/problem "What are the coordinates of the vertex of the parabola ${y}^{2}=-2(x-1)?$" :question/worked-solution "The standard equation of a left- or right-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(y-k)^{2}=4p(x-h),\n$$\n\nwhere $p$ is constant.\n\nWe can rewrite the given equation as \n\n$$\n(y-0)^{2}=4(-\\frac{2}{4})(x-1),\n$$\n\nwhich simplifies to\n\n$$\n(y-0)^{2}=4(-\\frac{1}{2})(x-1).\n$$\n\nIt is now clear that our equation is of the standard type with $p=-\\frac{1}{2}.$ \n\nComparing our equation with the standard equation, we can see that we have $h=1$ and $k=0.$ Therefore, the coordinates of the vertex of the parabola are $(1,0).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-8abcfe54-e8c7-5c1d-9465-cff1e4813088"] :db/ensure [:question/validate]} {:db/id "answer-field-8abcfe54-e8c7-5c1d-9465-cff1e4813088" :answer-field/id #uuid "8abcfe54-e8c7-5c1d-9465-cff1e4813088" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2718af2e-0e58-5f94-b179-4b6122d8bbc8" :answer-field/choices ["answer-20e4a15a-eda1-52a1-8baa-9cdce6bed32e" "answer-84737793-7f74-5db9-b6ff-72f64548ee3c" "answer-e5f0f01f-aa87-552e-8444-03f833352b21" "answer-2718af2e-0e58-5f94-b179-4b6122d8bbc8" "answer-959f0371-d54d-54ee-88dc-a7c52e86bcd9"] :db/ensure [:answer-field/validate]} {:db/id "answer-20e4a15a-eda1-52a1-8baa-9cdce6bed32e" :answer/id #uuid "20e4a15a-eda1-52a1-8baa-9cdce6bed32e" :answer/type :answer.type/math :answer/value "(-1,-\\frac{1}{2})" :db/ensure [:answer/validate]} {:db/id "answer-84737793-7f74-5db9-b6ff-72f64548ee3c" :answer/id #uuid "84737793-7f74-5db9-b6ff-72f64548ee3c" :answer/type :answer.type/math :answer/value "(-2,0)" :db/ensure [:answer/validate]} {:db/id "answer-e5f0f01f-aa87-552e-8444-03f833352b21" :answer/id #uuid "e5f0f01f-aa87-552e-8444-03f833352b21" :answer/type :answer.type/math :answer/value "(0,-1)" :db/ensure [:answer/validate]} {:db/id "answer-2718af2e-0e58-5f94-b179-4b6122d8bbc8" :answer/id #uuid "2718af2e-0e58-5f94-b179-4b6122d8bbc8" :answer/type :answer.type/math :answer/value "(1,0)" :db/ensure [:answer/validate]} {:db/id "answer-959f0371-d54d-54ee-88dc-a7c52e86bcd9" :answer/id #uuid "959f0371-d54d-54ee-88dc-a7c52e86bcd9" :answer/type :answer.type/math :answer/value "(\\frac{1}{2},1)" :db/ensure [:answer/validate]} {:db/id "question-b28f59d7-76e7-504d-aaab-0c27b75b3222" :question/id #uuid "b28f59d7-76e7-504d-aaab-0c27b75b3222" :question/math-academy-id "q-115904" :question/problem "What are the coordinates of the vertex of the parabola $(x-4)^{2}=-24(y+5)?$" :question/worked-solution "The standard equation of an upward- or downward-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(x-h)^{2}=4p(y-k),\n$$\n\nwhere $p$ is constant.\n\nWe can rewrite the given equation as\n\n$$\n\\begin{aligned}(x-4)^{2} & =4(-6)(y+5).\\end{aligned}\n$$\n\nIt is now clear that our equation is of the standard type with $p=-6.$\n\nComparing our equation with the standard equation, we can see that we have $h=4$ and $k=-5.$ Therefore, the coordinates of the vertex of the parabola are $(4,-5).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d580fbee-d419-5754-8c6e-c8cdde3856be"] :db/ensure [:question/validate]} {:db/id "answer-field-d580fbee-d419-5754-8c6e-c8cdde3856be" :answer-field/id #uuid "d580fbee-d419-5754-8c6e-c8cdde3856be" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d5a81445-6e86-5d1f-baeb-5cb9f1dca3d6" :answer-field/choices ["answer-81efdfb9-02a6-5ea4-a9eb-5456a31d6ea3" "answer-11ba3512-eaa8-5321-aa96-abe2a946d071" "answer-d5a81445-6e86-5d1f-baeb-5cb9f1dca3d6" "answer-95dd750a-51eb-54bf-b675-b53b71df0478" "answer-8406d667-63ff-58a4-a718-2dd90e66256a"] :db/ensure [:answer-field/validate]} {:db/id "answer-81efdfb9-02a6-5ea4-a9eb-5456a31d6ea3" :answer/id #uuid "81efdfb9-02a6-5ea4-a9eb-5456a31d6ea3" :answer/type :answer.type/math :answer/value "(-5,4)" :db/ensure [:answer/validate]} {:db/id "answer-11ba3512-eaa8-5321-aa96-abe2a946d071" :answer/id #uuid "11ba3512-eaa8-5321-aa96-abe2a946d071" :answer/type :answer.type/math :answer/value "(-6,-5)" :db/ensure [:answer/validate]} {:db/id "answer-d5a81445-6e86-5d1f-baeb-5cb9f1dca3d6" :answer/id #uuid "d5a81445-6e86-5d1f-baeb-5cb9f1dca3d6" :answer/type :answer.type/math :answer/value "(4,-5)" :db/ensure [:answer/validate]} {:db/id "answer-95dd750a-51eb-54bf-b675-b53b71df0478" :answer/id #uuid "95dd750a-51eb-54bf-b675-b53b71df0478" :answer/type :answer.type/math :answer/value "(4,-6)" :db/ensure [:answer/validate]} {:db/id "answer-8406d667-63ff-58a4-a718-2dd90e66256a" :answer/id #uuid "8406d667-63ff-58a4-a718-2dd90e66256a" :answer/type :answer.type/math :answer/value "(4,5)" :db/ensure [:answer/validate]} {:db/id "question-9b2b25e3-0202-54b4-aedb-ceb8981dd37f" :question/id #uuid "9b2b25e3-0202-54b4-aedb-ceb8981dd37f" :question/math-academy-id "q-115907" :question/problem "What are the coordinates of the vertex of the parabola ${y}^{2}=16x?$" :question/worked-solution "The standard equation of a left- or right-opening parabola that has its vertex at the origin is\n\n$$\n{y}^{2}=4px,\n$$\n\nwhere $p$ is a constant.\n\nWe can rewrite the given equation as \n\n$$\n{y}^{2}=4(4)x.\n$$\n\nIt is now clear that our equation is of the standard type with $p=4.$ Therefore, our parabola has its vertex at $(0,0).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-38d93762-7c0b-561a-b5d6-707d86a75a3a"] :db/ensure [:question/validate]} {:db/id "answer-field-38d93762-7c0b-561a-b5d6-707d86a75a3a" :answer-field/id #uuid "38d93762-7c0b-561a-b5d6-707d86a75a3a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-87865efc-4d97-556d-b25c-84be8a361ad0" :answer-field/choices ["answer-8a02ee2b-c276-5b3b-b415-d7b395c5780c" "answer-90e56bb0-d61e-5cde-bde8-277de6795d05" "answer-87865efc-4d97-556d-b25c-84be8a361ad0" "answer-6e170e66-986b-586b-aa37-931b2ef7939d" "answer-f5c30631-442c-5970-930d-6fbc7ef97378"] :db/ensure [:answer-field/validate]} {:db/id "answer-8a02ee2b-c276-5b3b-b415-d7b395c5780c" :answer/id #uuid "8a02ee2b-c276-5b3b-b415-d7b395c5780c" :answer/type :answer.type/math :answer/value "(-4,0)" :db/ensure [:answer/validate]} {:db/id "answer-90e56bb0-d61e-5cde-bde8-277de6795d05" :answer/id #uuid "90e56bb0-d61e-5cde-bde8-277de6795d05" :answer/type :answer.type/math :answer/value "(0,-16)" :db/ensure [:answer/validate]} {:db/id "answer-87865efc-4d97-556d-b25c-84be8a361ad0" :answer/id #uuid "87865efc-4d97-556d-b25c-84be8a361ad0" :answer/type :answer.type/math :answer/value "(0,0)" :db/ensure [:answer/validate]} {:db/id "answer-6e170e66-986b-586b-aa37-931b2ef7939d" :answer/id #uuid "6e170e66-986b-586b-aa37-931b2ef7939d" :answer/type :answer.type/math :answer/value "(0,4)" :db/ensure [:answ