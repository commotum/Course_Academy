9b1a0e36-dce4-509e-90b0-4f68fe84ad7d" :question/id #uuid "9b1a0e36-dce4-509e-90b0-4f68fe84ad7d"] ["question-9b1a0e36-dce4-509e-90b0-4f68fe84ad7d" :question/math-academy-id "q-84968"] ["question-9b1a0e36-dce4-509e-90b0-4f68fe84ad7d" :question/problem "What are the coordinates of the vertex of the parabola $(x+5)^{2}=-3(y-6)?$"] ["question-9b1a0e36-dce4-509e-90b0-4f68fe84ad7d" :question/worked-solution "The standard equation of an upward- or downward-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(x-h)^{2}=4p(y-k),\n$$\n\nwhere $p$ is constant.\n\nWe can rewrite the given equation as\n\n$$\n\\begin{aligned}(x+5)^{2} & =4(-\\frac{3}{4})(y-6).\\end{aligned}\n$$\n\nIt is now clear that our equation is of the standard type with $p=-\\frac{3}{4}.$\n\nComparing our equation with the standard equation, we can see that we have $h=-5$ and $k=6.$ Therefore, the coordinates of the vertex of the parabola are $(-5,6).$"] ["question-9b1a0e36-dce4-509e-90b0-4f68fe84ad7d" :question/difficulty :question.difficulty/moderate] ["answer-field-eada811c-d053-5120-a961-fe8ffd045312" :answer-field/id #uuid "eada811c-d053-5120-a961-fe8ffd045312"] ["answer-6de35bfe-a94a-5f6f-a2a7-be882652597a" :answer/id #uuid "6de35bfe-a94a-5f6f-a2a7-be882652597a"] ["answer-6de35bfe-a94a-5f6f-a2a7-be882652597a" :answer/type :answer.type/math] ["answer-6de35bfe-a94a-5f6f-a2a7-be882652597a" :answer/value "(-3,-6)"] ["answer-1b92942c-8aba-5aa1-868e-af6ff0b747b3" :answer/id #uuid "1b92942c-8aba-5aa1-868e-af6ff0b747b3"] ["answer-1b92942c-8aba-5aa1-868e-af6ff0b747b3" :answer/type :answer.type/math] ["answer-1b92942c-8aba-5aa1-868e-af6ff0b747b3" :answer/value "(-5,6)"] ["answer-f833dfc3-dd27-5cc6-a187-eb5f1348d40e" :answer/id #uuid "f833dfc3-dd27-5cc6-a187-eb5f1348d40e"] ["answer-f833dfc3-dd27-5cc6-a187-eb5f1348d40e" :answer/type :answer.type/math] ["answer-f833dfc3-dd27-5cc6-a187-eb5f1348d40e" :answer/value "(5,-3)"] ["answer-6332f8e1-70e3-52dc-ba10-2ad158c200d7" :answer/id #uuid "6332f8e1-70e3-52dc-ba10-