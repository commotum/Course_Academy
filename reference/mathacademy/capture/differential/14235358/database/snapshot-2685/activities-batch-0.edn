#edb/ref 17592186394606}] :knowledge-point/title "Stating the Vertex of a Vertical Parabola Given Its Equation in Standard Form"} :step/id #uuid "b4e927c0-c142-5449-90e2-dad539818e5e" :step/math-academy-id 27755 :step/next {:db/id #edb/ref 17592186097658}} {:db/id #edb/ref 17592186097658 :step/content {:db/id #edb/ref 17592186096763 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096568 :question/id #uuid "258f64db-05c1-5314-a6d8-aa2f604f5c95" :question/math-academy-id "e-7476"} :knowledge-point/id #uuid "9e302810-8b14-5c8c-8bbb-245386a66b7c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049118}] :knowledge-point/questions [{:db/id #edb/ref 17592186097381} {:db/id #edb/ref 17592186097382} {:db/id #edb/ref 17592186250505} {:db/id #edb/ref 17592186250506} {:db/id #edb/ref 17592186250507} {:db/id #edb/ref 17592186250508} {:db/id #edb/ref 17592186354375} {:db/id #edb/ref 17592186354376} {:db/id #edb/ref 17592186377955} {:db/id #edb/ref 17592186377962} {:db/id #edb/ref 17592186394613} {:db/id #edb/ref 17592186398130} {:db/id #edb/ref 17592186440817} {:db/id #edb/ref 17592186440819}] :knowledge-point/title "Stating the Vertex of a Horizontal Parabola Given Its Equation in Standard Form"} :step/id #uuid "a14605b3-0857-56c3-8d01-cd9415a4c5dd" :step/math-academy-id 27756} {:db/id #edb/ref 17592186097661 :step/content {:db/id #edb/ref 17592186097876 :tutorial/content "The standard equation of a left-opening or right-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(y-k)^2 = 4p(x-h).\n$$\n\nThe standard equation of an upward-opening or downward-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(x-h)^2 = 4p(y-k).\n$$\n\nIn either case, we can immediately retrieve the parabola's vertex if we're given an equation in either of these two forms.\n\n**Note:** You might wonder why there is a $4$ in the $4p$ term. It turns out that the $4p$ term is necessary to represent a particular geometric property of the parabola, which we will learn about in the future. In this lesson, we won't do much with the value of $p,$ but it will become relevant in the future." :tutorial/id #uuid "41e07eb0-e473-5751-a42d-759ae09cbfcc" :tutorial/math-academy-id 4581 :tutorial/title "The Standard Equation of a Parabola"} :step/id #uuid "8d77ee2d-8edc-5264-aacd-0369dc3583d2" :step/math-academy-id 28200 :step/next {:db/id #edb/ref 17592186097657}}] :activity/title "The Vertex of a Parabola" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186096900}]}
