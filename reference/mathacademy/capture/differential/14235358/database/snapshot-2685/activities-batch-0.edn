#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186097578} :activity/id #uuid "45111f6d-b67a-590c-9d4f-8a8f65e3e355" :activity/scope {:db/id #edb/ref 17592186049336 :topic/id #uuid "ecb9de68-369a-5f6c-b0fd-aed6ffa5f121" :topic/math-academy-id 1128} :activity/steps [{:db/id #edb/ref 17592186097578 :step/content {:db/id #edb/ref 17592186097857 :tutorial/content "The figure below shows the graph of an upward-opening parabola.\n\n![](images/28/2849c732102f52d5f7f2e0f5e29724560d4d7052df80e90fe8d24b95911f5092.png)\n\nThe point where the parabola makes its sharpest turn is called the **vertex**. In particular:\n\n- The vertex of an *upward-opening* parabola (like the one above) is its *lowest* point.\n\n- The vertex of a *downward-opening* parabola is its *highest* point.\n\n- The vertex of a *left-opening* parabola is its *right-most* point.\n\n- The vertex of a *right-opening* parabola is its *left-most* point." :tutorial/id #uuid "5c65720a-56eb-551f-9ce3-0a9ec6d62671" :tutorial/math-academy-id 3487 :tutorial/title "Introduction"} :step/id #uuid "dc0a8fb8-04ec-5c43-a7cd-3e45ae9cdaeb" :step/math-academy-id 19729 :step/next {:db/id #edb/ref 17592186097656}} {:db/id #edb/ref 17592186097579 :step/content {:db/id #edb/ref 17592186096711 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096509 :question/id #uuid "31dd152b-cab9-5754-9335-42ed830d3c01" :question/math-academy-id "e-5343"} :knowledge-point/id #uuid "61861939-69d4-5b1e-a0f0-6a1b383b775b" :knowledge-point/questions [{:db/id #edb/ref 17592186097013} {:db/id #edb/ref 17592186097014} {:db/id #edb/ref 17592186250503} {:db/id #edb/ref 17592186253482} {:db/id #edb/ref 17592186253483} {:db/id #edb/ref 17592186354362} {:db/id #edb/ref 17592186354363} {:db/id #edb/ref 17592186354364} {:db/id #edb/ref 17592186354365} {:db/id #edb/ref 17592186375755} {:db/id #edb/ref 17592186375762} {:db/id #edb/ref 17592186377941} {:db/id #edb/ref 17592186394599} {:db/id #edb/ref 17592186440818}] :kno