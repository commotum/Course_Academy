i>y</mi><mo stretchy=\"false\">)</mo><mo>=</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">{</mo><mtable columnalign=\"left left\" columnspacing=\"1em\" rowspacing=\"0.7em 0.2em\"><mtr><mtd><mn>1</mn><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><msqrt><mi>x</mi></msqrt></mfrac></mstyle><mo>−</mo><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mn>1</mn><mo>−</mo><mi>y</mi></mrow></msup><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mn>1</mn><mo>−</mo><mi>y</mi></mrow></msup><msqrt><mi>x</mi></msqrt></mfrac></mstyle><mo>,</mo></mtd><mtd><mi>x</mi><mo>≥</mo><mn>1</mn><mo>,</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.278em\"></mspace></mstyle><mi>y</mi><mo>≥</mo><mn>1</mn></mtd></mtr><mtr><mtd><mn>0</mn><mo>,</mo></mtd><mtd><mtext>otherwise</mtext><mo>.</mo></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\" fence=\"true\" stretchy=\"true\" symmetric=\"true\"></mo></mrow></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
