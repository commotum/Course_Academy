#{[{:db/id #edb/ref 17592186374366 :knowledge-point/_questions [{:db/id #edb/ref 17592186152051 :knowledge-point/id #uuid "637030d2-d58f-56af-bf16-f33f755b65f9" :knowledge-point/title "Negating a Plain English Statement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1699e9e8-795a-5ba6-a0ee-4950440932f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-1$ is not greater than $-\\sqrt{2}.$" :db/id #edb/ref 17592186374368} {:answer/id #uuid "22c73b81-84a1-5c4c-97f7-6262b43bda6a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-1$ is greater than $-\\sqrt{2}.$" :db/id #edb/ref 17592186374369} {:answer/id #uuid "9fd81ddb-0ea4-524f-ab98-1388d627c725" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-\\sqrt{2}$ is not greater than $-1.$" :db/id #edb/ref 17592186374370} {:answer/id #uuid "577cf9a8-c082-5003-946d-75e9eb366f80" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-1$ is  equal to $-\\sqrt{2}.$" :db/id #edb/ref 17592186374371} {:answer/id #uuid "afe1efba-82c0-55ef-aecd-5a961863ad14" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-\\sqrt{2}$ is greater than $-1.$" :db/id #edb/ref 17592186374372}] :answer-field/correct {:answer/id #uuid "1699e9e8-795a-5ba6-a0ee-4950440932f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-1$ is not greater than $-\\sqrt{2}.$" :db/id #edb/ref 17592186374368} :answer-field/id #uuid "ea3ba7f3-2de5-5652-942e-f697424cd57a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374367}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9c30bbae-c196-5bdb-9a48-5e29a02258c2" :question/math-academy-id "q-176858" :question/problem "Consider the following statement.\n\n$-1$ is greater than $-\\sqrt{2}.$\n\nWhat is the negation of this statement?" :question/worked-solution "Let's denote the given statement as $P.$\n\nThe symbol \"$¬$\" represents negation. So, our task is to negate the given sentence. \n\nTo negate our plain English sentence, we place the words \"It is not true that\" in front of it. This gives the following:\n\nIt is not true that $-1$ is greater than $-\\sqrt{2}.$\n\nIn other words, $-1$ is *not* greater than $-\\sqrt{2}.$ Therefore, $¬P$ means the following:\n\n$-1$ is **not** greater than $-\\sqrt{2}.$\n\nNote that $P$ is **true,** while $¬P$ is **false.**"}] [{:db/id #edb/ref 17592186410108 :knowledge-point/_questions [{:db/id #edb/ref 17592186152052 :knowledge-point/id #uuid "93415651-fbcb-56d3-ad93-2b7f34e7bf4c" :knowledge-point/title "Expressing a Negated Sentence in Symbolic Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29224407-55cf-551f-b649-9fde0ff90969" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P∨¬Q" :db/id #edb/ref 17592186410065} {:answer/id #uuid "70bc8ea3-93c8-58ea-848f-ec99ae31061f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬(P∧Q)" :db/id #edb/ref 17592186410075} {:answer/id #uuid "72bcfa5c-5b94-5b39-8907-f5e55b173ceb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬P∨Q" :db/id #edb/ref 17592186410076} {:answer/id #uuid "b3a7f504-4ca7-5894-b89f-b544a051e640" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P∧¬Q" :db/id #edb/ref 17592186410085} {:answer/id #uuid "bf299fda-072c-544f-b29f-e8fcc1aa3744" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬(P∨Q)" :db/id #edb/ref 17592186410086}] :answer-field/correct {:answer/id #uuid "bf299fda-072c-544f-b29f-e8fcc1aa3744" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬(P∨Q)" :db/id #edb/ref 17592186410086} :answer-field/id #uuid "3485fc02-497e-5efc-b575-32abe89dc9c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186410095}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e5ae3f5a-c838-553b-8c0d-d176aea1d388" :question/math-academy-id "q-176861" :question/problem "$\\pi $ is **not** a rational or negative number.\n\nExpress the compound statement above in symbolic form given the following:\n\n- $P:\\pi \\text{ is a rational number}$\n\n- $Q:\\pi \\text{ is a negative number}$" :question/worked-solution "The given sentence is the negation of the following sentence: \n\n$\\pi $ is a rational or negative number, \n\nwhich can be expressed symbolically as $P∨Q.$\n\nThe negation is represented by the symbol \"$¬$\".  \n\nTherefore, the given sentence is expressed symbolically as $¬(P∨Q).$"}] [{:db/id #edb/ref 17592186389962 :knowledge-point/_questions [{:db/id #edb/ref 17592186152053 :knowledge-point/id #uuid "7c49d316-3552-5ace-a749-5070b64230c3" :knowledge-point/title "Completing a Truth Table for a Compound Statement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e9be014-2aa3-5bd4-a9e1-e0b0398b7b47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{F}" :db/id #edb/ref 17592186389964} {:answer/id #uuid "dc4716ca-09b5-5696-90a6-d659160241a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{T}" :db/id #edb/ref 17592186389965}] :answer-field/correct {:answer/id #uuid "dc4716ca-09b5-5696-90a6-d659160241a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{T}" :db/id #edb/ref 17592186389965} :answer-field/id #uuid "ad63dd8e-745a-5ee8-ab85-28395d823854" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186389963} {:answer-field/choices [{:answer/id #uuid "5d4799b7-2ec5-55f3-8e94-7c766e2ab8e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{F}" :db/id #edb/ref 17592186389967} {:answer/id #uuid "6202532e-097a-5ed3-9a11-d67cfe7d545c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{T}" :db/id #edb/ref 17592186389968}] :answer-field/correct {:answer/id #uuid "6202532e-097a-5ed3-9a11-d67cfe7d545c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{T}" :db/id #edb/ref 17592186389968} :answer-field/id #uuid "35de7356-6d60-5915-9454-d39af71c2165" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186389966} {:answer-field/choices [{:answer/id #uuid "165a92b6-fdbd-5392-913e-76ef637ef1ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{F}" :db/id #edb/ref 17592186389970} {:answer/id #uuid "13889a96-015c-5f06-b482-d5706952c107" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{T}" :db/id #edb/ref 17592186389971}] :answer-field/correct {:answer/id #uuid "13889a96-015c-5f06-b482-d5706952c107" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{T}" :db/id #edb/ref 17592186389971} :answer-field/id #uuid "409900b9-5f5b-573c-bd21-4aef5cc3bcf9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186389969} {:answer-field/choices [{:answer/id #uuid "98cef5ed-6d56-5d32-bafe-3ba933adf4b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{F}" :db/id #edb/ref 17592186389973} {:answer/id #uuid "4d647a7a-e235-5eb8-b2dc-eb5e14218aa3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{T}" :db/id #edb/ref 17592186389974}] :answer-field/correct {:answer/id #uuid "98cef5ed-6d56-5d32-bafe-3ba933adf4b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{F}" :db/id #edb/ref 17592186389973} :answer-field/id #uuid "bbfcdbd3-d677-5277-a987-cadca5fd31af" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186389972}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4e6b11d0-029c-5a98-b4f3-ce5be3c28699" :question/math-academy-id "q-182356" :question/problem "Find the missing values in the following truth table:\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,¬A∨B\\,$ |\n| --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | {{field-1}} |\n| $\\text{T}$ | $\\text{F}$ | {{field-2}} |\n| $\\text{F}$ | $\\text{T}$ | {{field-3}} |\n| $\\text{F}$ | $\\text{F}$ | {{field-4}} |" :question/worked-solution "First, we add a column for $¬A,$ where the truth values are opposite to the corresponding values in the column for $A.$ \n\n| $\\,A\\,$ | $\\,¬A\\,$ | $\\,B\\,$ |\n| --- | --- | --- |\n| $\\text{T}$ | $\\text{F}$ | $\\text{T}$ |\n| $\\text{T}$ | $\\text{F}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{T}$ | $\\text{T}$ |\n| $\\text{F}$ | $\\text{T}$ | $\\text{F}$ |\n\nThen, we add a column for $¬A∨B.$ Remember that $¬A∨B$ is true if either $¬A$ is true or $B$ is true. \n\n| $\\,A\\,$ | $\\,¬A\\,$ | $\\,B\\,$ | $\\,¬A∨B\\,$ |\n| --- | --- | --- | --- |\n| $\\text{T}$ | $\\text{F}$ | $\\text{T}$ | $\\text{T}$ |\n| $\\text{T}$ | $\\text{F}$ | $\\text{F}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{T}$ | $\\text{T}$ | $\\text{T}$ |\n| $\\text{F}$ | $\\text{T}$ | $\\text{F}$ | $\\text{T}$ |"}]}
