#{[{:activity/first-step {:db/id #edb/ref 17592186152882} :activity/id #uuid "04492e62-1f36-5743-ad74-130604e26e5a" :activity/scope {:db/id #edb/ref 17592186048349 :topic/id #uuid "97a8f3f2-67ab-5291-a6e0-b7d19b4541f0" :topic/math-academy-id 2790} :activity/steps [{:db/id #edb/ref 17592186152882 :step/content {:db/id #edb/ref 17592186153426 :tutorial/content "The **negation** of a mathematical statement is its *opposite* statement. A mathematical statement and its negation have opposite truth values.\n\nFor example:\n\n- The negation of the *true* statement \"$4$ is divisible by $2$\" is the *false* statement \"$4$ is **not** divisible by $2.$\"\n- The negation of the *false* statement \"$5$ is even\" is the *true* statement \"$5$ is odd.\"\n\nWe can express negations using the symbol \"$\\neg$\". The negation of $A$ is denoted $\\neg A,$ and has the opposite truth values as $A{:}$\n\n| $\\,A\\,$ | $\\,\\neg A\\,$ |\n| --- | --- |\n| $\\textrm T$ | $\\textrm F$ |\n| $\\textrm F$ | $\\textrm T$ |\n\nWe can negate compound statements as well. For example, the statement $\\neg (A \\land B)$ has the opposite truth values as the statement $A \\land B{:}$\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\, A \\land B \\,$ | $\\, \\neg (A \\land B) \\,$ |\n| --- | --- | --- | --- |\n| $\\textrm T$ | $\\textrm T$ | $\\textrm T$ | $\\textrm F$ |\n| $\\textrm T$ | $\\textrm F$ | $\\textrm F$ | $\\textrm T$ |\n| $\\textrm F$ | $\\textrm T$ | $\\textrm F$ | $\\textrm T$ |\n| $\\textrm F$ | $\\textrm F$ | $\\textrm F$ | $\\textrm T$ |" :tutorial/id #uuid "65ae07d1-2d1e-5f50-9c5f-4b45ca435aed" :tutorial/math-academy-id 7965 :tutorial/title "Introduction"} :step/id #uuid "d6231d40-48ba-5c9d-855d-04ce17a699e2" :step/math-academy-id 120073 :step/next {:db/id #edb/ref 17592186152883}} {:db/id #edb/ref 17592186152883 :step/content {:db/id #edb/ref 17592186152051 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151803 :question/id #uuid "e803903e-e272-5bd9-97a2-6b7cf12c359c" :question/math-academy-id "e-12702"} :knowledge-point/id #uuid "637030d2-d58f-56af-bf16-f33f755b65f9" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049002}] :knowledge-point/questions [{:db/id #edb/ref 17592186152433} {:db/id #edb/ref 17592186152434} {:db/id #edb/ref 17592186374359} {:db/id #edb/ref 17592186374366} {:db/id #edb/ref 17592186374373} {:db/id #edb/ref 17592186401660} {:db/id #edb/ref 17592186401667}] :knowledge-point/title "Negating a Plain English Statement"} :step/id #uuid "05ea8d4a-447c-5dfe-bc07-9429c6506a99" :step/math-academy-id 120074 :step/next {:db/id #edb/ref 17592186152884}} {:db/id #edb/ref 17592186152884 :step/content {:db/id #edb/ref 17592186152052 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151800 :question/id #uuid "f652a287-03b1-5e0b-9d77-9a681b1bb873" :question/math-academy-id "e-12681"} :knowledge-point/id #uuid "93415651-fbcb-56d3-ad93-2b7f34e7bf4c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048778}] :knowledge-point/questions [{:db/id #edb/ref 17592186152829} {:db/id #edb/ref 17592186152833} {:db/id #edb/ref 17592186374380} {:db/id #edb/ref 17592186374387} {:db/id #edb/ref 17592186375453} {:db/id #edb/ref 17592186398631} {:db/id #edb/ref 17592186399152} {:db/id #edb/ref 17592186399159} {:db/id #edb/ref 17592186410106} {:db/id #edb/ref 17592186410108}] :knowledge-point/title "Expressing a Negated Sentence in Symbolic Form"} :step/id #uuid "1b41146a-7652-5f80-8f71-bd202ae02ffb" :step/math-academy-id 120077 :step/next {:db/id #edb/ref 17592186152885}} {:db/id #edb/ref 17592186152885 :step/content {:db/id #edb/ref 17592186152053 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151801 :question/id #uuid "3e19d03f-5298-52f4-a839-b4b7c5a1a4bf" :question/math-academy-id "e-12682"} :knowledge-point/id #uuid "7c49d316-3552-5ace-a749-5070b64230c3" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049269}] :knowledge-point/questions [{:db/id #edb/ref 17592186152465} {:db/id #edb/ref 17592186152466} {:db/id #edb/ref 17592186374492} {:db/id #edb/ref 17592186374505} {:db/id #edb/ref 17592186374518} {:db/id #edb/ref 17592186381598} {:db/id #edb/ref 17592186389949} {:db/id #edb/ref 17592186389962} {:db/id #edb/ref 17592186389975} {:db/id #edb/ref 17592186410105} {:db/id #edb/ref 17592186410109}] :knowledge-point/title "Completing a Truth Table for a Compound Statement"} :step/id #uuid "88af8584-370e-538d-bc31-ffbea331ec2f" :step/math-academy-id 120080 :step/next {:db/id #edb/ref 17592186152886}} {:db/id #edb/ref 17592186152886 :step/content {:db/id #edb/ref 17592186153427 :tutorial/content "When we have two negations in a row, we can cancel them out.\n\n- For example, $\\neg (\\neg A)$ can be simplified to $A.$\n- Likewise, $\\neg (\\neg (A \\land B))$ can be simplified to $A \\land B.$\n\nTo understand why negations cancel with each other, consider the following statement:\n\n$4$ is divisible by $2.$\n\nThe negation of this statement is\n\n$4$ is **not** divisible by $2.$\n\nIf we negate again, we get back the original sentence:\n\n$4$ divisible by $2.$\n\nSo, if we negate a statement twice, we end up with the original statement.\n\nMore formally, we can prove that $\\neg (\\neg A) \\equiv A$ using a truth table.\n\n| $\\,A\\,$ | $\\,\\neg A\\,$ | $\\,\\neg(\\neg A)\\,$ |\n| --- | --- | --- |\n| $\\textrm T$ | $\\textrm F$ | $\\textrm T$ |\n| $\\textrm F$ | $\\textrm T$ | $\\textrm F$ |\n\nSince $A$ and $\\neg(\\neg A)$ have the same truth values, they are logically equivalent." :tutorial/id #uuid "96c8056f-c1d0-5453-ba7f-71700a48506c" :tutorial/math-academy-id 7966 :tutorial/title "Double Negations"} :step/id #uuid "42a89cf9-ea00-5196-9579-5a0eda504d5a" :step/math-academy-id 120083 :step/next {:db/id #edb/ref 17592186152887}} {:db/id #edb/ref 17592186152887 :step/content {:db/id #edb/ref 17592186152054 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151802 :question/id #uuid "503739b1-ea2e-5c6a-8270-6e1fdc050bc4" :question/math-academy-id "e-12683"} :knowledge-point/id #uuid "69612c9a-699f-5635-8c9c-649a93ab4583" :knowledge-point/questions [{:db/id #edb/ref 17592186152830} {:db/id #edb/ref 17592186152832} {:db/id #edb/ref 17592186373729} {:db/id #edb/ref 17592186373736} {:db/id #edb/ref 17592186375439} {:db/id #edb/ref 17592186375446} {:db/id #edb/ref 17592186380726} {:db/id #edb/ref 17592186380733} {:db/id #edb/ref 17592186410107}] :knowledge-point/title "Simplifying a Double Negation"} :step/id #uuid "4ca4d75a-1805-5443-b3f6-3a98bafec5cc" :step/math-academy-id 120084}] :activity/title "The \"Not\" Connective" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186152374}] [{:activity/course {:db/id #edb/ref 17592186046673} :activity/first-step {:db/id #edb/ref 17592186419030} :activity/id #uuid "bfb8308f-9d2a-5c3b-904c-dfb00bba239f" :activity/scope {:db/id #edb/ref 17592186048349 :topic/id #uuid "97a8f3f2-67ab-5291-a6e0-b7d19b4541f0" :topic/math-academy-id 2790} :activity/steps [{:db/id #edb/ref 17592186419026 :step/content {:db/id #edb/ref 17592186410106 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5cf34be5-c594-5496-aa61-41f145440bc7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬P∨¬Q" :db/id #edb/ref 17592186410072} {:answer/id #uuid "7371329d-96b6-51ea-bfe7-14de7b40abf6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬(P∧Q)" :db/id #edb/ref 17592186410077} {:answer/id #uuid "964b4c56-2ede-5a41-8d97-6bcfd3830f9d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬P∧Q" :db/id #edb/ref 17592186410082} {:answer/id #uuid "9beb2485-dd7e-565f-bf11-7179015d4947" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬(P∨Q)" :db/id #edb/ref 17592186410083} {:answer/id #uuid "cd5a65eb-c2e8-56a1-b5c7-79f43616d6f7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬P∨Q" :db/id #edb/ref 17592186410088}] :answer-field/correct {:db/id #edb/ref 17592186410083} :answer-field/id #uuid "81e17c23-e75b-5224-95d3-5b0d550456c4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186410099}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "bc8abf72-5929-5991-bf8d-19db968b0381" :question/math-academy-id "q-81400" :question/problem "$10$ is **not** divisible by $3$ or $4.$\n\nExpress the compound statement above in symbolic form given the following:\n\n- $P:10\\text{ is divisible by }3$\n\n- $Q:10\\text{ is divisible by }4$" :question/worked-solution "The given sentence is the negation of the following sentence: \n\n$10$ is divisible by $3$ or $4$, \n\nwhich can be expressed symbolically as $P∨Q.$\n\nThe negation is represented by the symbol \"$¬$\". \n\nTherefore, the given sentence is expressed symbolically as $¬(P∨Q).$"} :step/id #uuid "4f1521f4-bf4b-579e-96c7-8716bbb01f24" :step/next {:db/id #edb/ref 17592186419028}} {:db/id #edb/ref 17592186419027 :step/content {:db/id #edb/ref 17592186410109 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4633fe49-2c21-5720-a63c-558f45288fa2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{T}" :db/id #edb/ref 17592186410068} {:answer/id #uuid "4a01d36c-4604-5b36-b3e3-00487d979e7f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{F}" :db/id #edb/ref 17592186410070}] :answer-field/correct {:db/id #edb/ref 17592186410068} :answer-field/id #uuid "5660f069-31c9-5611-ada9-3b00eeb9abf2" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186410097} {:answer-field/choices [{:answer/id #uuid "b14e0483-a372-5fd9-9aac-a4c6418f0a40" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{T}" :db/id #edb/ref 17592186410084} {:answer/id #uuid "e24ff342-e818-59d7-8686-5fbf7bfd82cf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{F}" :db/id #edb/ref 17592186410091}] :answer-field/correct {:db/id #edb/ref 17592186410091} :answer-field/id #uuid "7deb5fe1-b953-59ea-8d33-11d1bf079ff6" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186410098} {:answer-field/choices [{:answer/id #uuid "5aeaae2d-638b-50a2-9bc8-5391e436e264" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{F}" :db/id #edb/ref 17592186410071} {:answer/id #uuid "f725e384-3087-53ec-8dea-0de0981c9118" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{T}" :db/id #edb/ref 17592186410093}] :answer-field/correct {:db/id #edb/ref 17592186410071} :answer-field/id #uuid "9689e0cd-e889-5811-9b2c-26c58d6abd6c" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186410100} {:answer-field/choices [{:answer/id #uuid "68f75dcd-4b71-5caa-9634-a7a3ad02f645" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{T}" :db/id #edb/ref 17592186410074} {:answer/id #uuid "844e1f82-b2f7-50b6-a9e7-d4d1243f25fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{F}" :db/id #edb/ref 17592186410080}] :answer-field/correct {:db/id #edb/ref 17592186410080} :answer-field/id #uuid "e14512f5-568b-572f-88e5-8b63aa118ca8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186410103}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f8845516-a376-50cc-8625-12673b114608" :question/math-academy-id "q-182350" :question/problem "Find the missing values in the following truth table:\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,A∧¬B\\,$ |\n| --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | {{field-1}} |\n| $\\text{T}$ | $\\text{F}$ | {{field-2}} |\n| $\\text{F}$ | $\\text{T}$ | {{field-3}} |\n| $\\text{F}$ | $\\text{F}$ | {{field-4}} |" :question/worked-solution "First, we add a column for $¬B,$ where the truth values are opposite to the corresponding values in the column for $B.$ \n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,¬B\\,$ |\n| --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | $\\text{F}$ |\n| $\\text{T}$ | $\\text{F}$ | $\\text{T}$ |\n| $\\text{F}$ | $\\text{T}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{F}$ | $\\text{T}$ |\n\nThen, we add a column for $A∧¬B.$ Remember that $A∧¬B$ is true if both $A$ and $¬B$ are true.\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,¬B\\,$ | $\\,A∧¬B\\,$ |\n| --- | --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | $\\text{F}$ | $\\text{F}$ |\n| $\\text{T}$ | $\\text{F}$ | $\\text{T}$ | $\\text{T}$ |\n| $\\text{F}$ | $\\text{T}$ | $\\text{F}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{F}$ | $\\text{T}$ | $\\text{F}$ |"} :step/id #uuid "94ad02f3-e1b3-5f12-96c2-27d98011331b" :step/next {:db/id #edb/ref 17592186419029}} {:db/id #edb/ref 17592186419028 :step/content {:db/id #edb/ref 17592186410108 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29224407-55cf-551f-b649-9fde0ff90969" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "P∨¬Q" :db/id #edb/ref 17592186410065} {:answer/id #uuid "70bc8ea3-93c8-58ea-848f-ec99ae31061f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬(P∧Q)" :db/id #edb/ref 17592186410075} {:answer/id #uuid "72bcfa5c-5b94-5b39-8907-f5e55b173ceb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬P∨Q" :db/id #edb/ref 17592186410076} {:answer/id #uuid "b3a7f504-4ca7-5894-b89f-b544a051e640" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "P∧¬Q" :db/id #edb/ref 17592186410085} {:answer/id #uuid "bf299fda-072c-544f-b29f-e8fcc1aa3744" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬(P∨Q)" :db/id #edb/ref 17592186410086}] :answer-field/correct {:db/id #edb/ref 17592186410086} :answer-field/id #uuid "3485fc02-497e-5efc-b575-32abe89dc9c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186410095}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e5ae3f5a-c838-553b-8c0d-d176aea1d388" :question/math-academy-id "q-176861" :question/problem "$\\pi $ is **not** a rational or negative number.\n\nExpress the compound statement above in symbolic form given the following:\n\n- $P:\\pi \\text{ is a rational number}$\n\n- $Q:\\pi \\text{ is a negative number}$" :question/worked-solution "The given sentence is the negation of the following sentence: \n\n$\\pi $ is a rational or negative number, \n\nwhich can be expressed symbolically as $P∨Q.$\n\nThe negation is represented by the symbol \"$¬$\".  \n\nTherefore, the given sentence is expressed symbolically as $¬(P∨Q).$"} :step/id #uuid "94f8a49c-36c4-5117-aef4-ce993a2dc394" :step/next {:db/id #edb/ref 17592186419027}} {:db/id #edb/ref 17592186419029 :step/content {:db/id #edb/ref 17592186410105 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02a760ee-5936-56b4-bcc6-367c6cb4e864" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{F}" :db/id #edb/ref 17592186410063} {:answer/id #uuid "e236a867-6c27-5383-a8c6-c14b93397b44" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{T}" :db/id #edb/ref 17592186410090}] :answer-field/correct {:db/id #edb/ref 17592186410090} :answer-field/id #uuid "2fc94c3d-55a6-52a8-befa-23370d9ac2eb" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186410094} {:answer-field/choices [{:answer/id #uuid "31a1a336-0977-5fd7-b705-264101c48ef3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{T}" :db/id #edb/ref 17592186410067} {:answer/id #uuid "60aec5ee-3aa6-551a-9801-5a69fcafe967" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{F}" :db/id #edb/ref 17592186410073}] :answer-field/correct {:db/id #edb/ref 17592186410073} :answer-field/id #uuid "4559bdf1-e658-5991-973b-1850639db1c5" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186410096} {:answer-field/choices [{:answer/id #uuid "1361bf8f-3f03-5934-b7b4-8ab61ff8a2e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{F}" :db/id #edb/ref 17592186410064} {:answer/id #uuid "c78c7797-b922-549a-9951-a4aa5718fb45" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{T}" :db/id #edb/ref 17592186410087}] :answer-field/correct {:db/id #edb/ref 17592186410087} :answer-field/id #uuid "beaf4f62-b5f6-5599-ada6-b031d8f0f2c8" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186410102} {:answer-field/choices [{:answer/id #uuid "2cfb75b6-b8ba-5513-85da-49f6a4546360" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{T}" :db/id #edb/ref 17592186410066} {:answer/id #uuid "d57eea81-3aed-50fc-b8cb-ac92bc70c961" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{F}" :db/id #edb/ref 17592186410089}] :answer-field/correct {:db/id #edb/ref 17592186410066} :answer-field/id #uuid "ee6c6021-4135-5e83-9510-560eaf4934a5" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186410104}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "594bcd16-11e5-554c-954b-51c8f4ae33f3" :question/math-academy-id "q-182392" :question/problem "Find the missing values in the following truth table:\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,¬(A∧B)\\,$ |\n| --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | {{field-1}} |\n| $\\text{T}$ | $\\text{F}$ | {{field-2}} |\n| $\\text{F}$ | $\\text{T}$ | {{field-3}} |\n| $\\text{F}$ | $\\text{F}$ | {{field-4}} |" :question/worked-solution "First, we add a column for $A∧B.$ Remember that $A∧B$ is true if both $A$ and $B$ are true.\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,A∧B\\,$ |\n| --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | $\\text{T}$ |\n| $\\text{T}$ | $\\text{F}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{T}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{F}$ | $\\text{F}$ |\n\nThen, we add a column for $¬(A∧B).$ Remember that the truth values of $¬(A∧B)$ are opposite those of $A∧B.$\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,A∧B\\,$ | $\\,¬(A∧B)\\,$ |\n| --- | --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | $\\text{T}$ | $\\text{F}$ |\n| $\\text{T}$ | $\\text{F}$ | $\\text{F}$ | $\\text{T}$ |\n| $\\text{F}$ | $\\text{T}$ | $\\text{F}$ | $\\text{T}$ |\n| $\\text{F}$ | $\\text{F}$ | $\\text{F}$ | $\\text{T}$ |"} :step/id #uuid "ab9043b6-86e0-58a1-93e8-67e6dae7f9ec"} {:db/id #edb/ref 17592186419030 :step/content {:db/id #edb/ref 17592186410107 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49aac272-50b1-592b-864f-1a27db474750" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬(P∨Q)" :db/id #edb/ref 17592186410069} {:answer/id #uuid "7f9aec45-b986-56ea-b358-ed7dc5a0050d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "P∧Q" :db/id #edb/ref 17592186410078} {:answer/id #uuid "80e5b503-c1f3-55be-8dcc-bddf5095cdd8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬P∨¬Q" :db/id #edb/ref 17592186410079} {:answer/id #uuid "95f97ab8-d3e1-53de-9f6b-81d4359de9e6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "P∨Q" :db/id #edb/ref 17592186410081} {:answer/id #uuid "ec945e37-e9c4-5c98-af1f-ed01f7eca675" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "P∨¬Q" :db/id #edb/ref 17592186410092}] :answer-field/correct {:db/id #edb/ref 17592186410081} :answer-field/id #uuid "ad0dfdbd-2a82-546a-8ef0-7ca0d999f989" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186410101}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d4b4ae83-c202-571a-9f3a-530441a220fc" :question/math-academy-id "q-81359" :question/problem "Simplify the statement $P∨¬(¬Q).$" :question/worked-solution "Two negations in a row cancel each other out. So, we can simplify $¬(¬Q)$ to $Q.$\n\nTherefore, the given statement can be simplified to \n\n$$\nP∨Q.\n$$"} :step/id #uuid "c154e26d-1951-59a3-8a98-2844d71a28d7" :step/next {:db/id #edb/ref 17592186419026}}] :activity/title "The \"Not\" Connective" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186419025}]}
