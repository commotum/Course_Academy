#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186423181} :activity/id #uuid "68a08d63-69d2-59f4-855e-ab9c40ae1bca" :activity/scope {:db/id #edb/ref 17592186049436 :topic/id #uuid "f5218ca7-a9d3-5ad9-b17a-ee16b6e2b34a" :topic/math-academy-id 1805} :activity/steps [{:db/id #edb/ref 17592186423178 :step/content {:db/id #edb/ref 17592186338831 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ad3af79-fcd3-5749-b0e5-9411379a50d2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186336721} {:answer/id #uuid "886c099c-bd36-506a-9021-b550fe0b57c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186337264} {:answer/id #uuid "926d8af8-a19c-5443-bbf7-6f269886e17b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186337364} {:answer/id #uuid "d60f66f3-48fa-5ebf-837a-e090ca7d3d6a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186337896} {:answer/id #uuid "d99cfee8-de55-5ea6-8c2e-3385468433bb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186337925}] :answer-field/correct {:db/id #edb/ref 17592186337896} :answer-field/id #uuid "7727c896-6f1b-5615-b00c-42ad7fd27f9f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186338483}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e0327785-b28b-5842-b652-0805899123b3" :question/math-academy-id "q-70830" :question/problem "A nonzero vector $⟨a,\\,b,\\,0⟩$ is parallel to the plane $r\\cdot ⟨-1,1,-3⟩=8.$ What is the value of $\\frac{a}{b}?$" :question/worked-solution "We need a vector $v=⟨{t}_{1},{t}_{2},{t}_{3}⟩$ that is parallel to the given plane. \n\nFrom the equation $r\\cdot ⟨-1,1,-3⟩=8$ of the plane, we get the normal vector $n=⟨-1,1,-3⟩.$ So, $v⊥n$ and we have the following:\n\n$$\n\\begin{aligned}v\\cdot n & =0 \\\\ ⟨{t}_{1},{t}_{2},{t}_{3}⟩\\cdot ⟨-1,1,-3⟩ & =0 \\\\ -{t}_{1}+{t}_{2}-3{t}_{3} & =0 \\\\ {t}_{2} & ={t}_{1}+3{t}_{3}\\end{aligned}\n$$\n\nHence, we obtain \n\n$$\nv=⟨{t}_{1},{t}_{1}+3{t}_{3},{t}_{3}⟩,\n$$\n\nwhere ${t}_{1},{t}_{3}\\in (-\\infty ,\\infty ).$ \n\nWe are told that the third component of $v$ equals $0.$ So, we must set ${t}_{3}=0.$ \n\nSince $v$ is nonzero, we can pick any ${t}_{1}\\ne 0.$ For example, setting ${t}_{1}=1$, we get\n\n$$\nv=⟨1,\\,1,\\,0⟩.\n$$\n\nTherefore, $\\frac{a}{b}=1.$"} :step/id #uuid "0ecb2ec2-22d0-5b28-bc73-c57c70725e45" :step/next {:db/id #edb/ref 17592186423179}} {:db/id #edb/ref 17592186423179 :step/content {:db/id #edb/ref 17592186393043 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "493da2a3-c2b1-5d90-946c-32226dc19e64" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨3,-5,-2⟩=⟨-3,4,-1⟩" :db/id #edb/ref 17592186393045} {:answer/id #uuid "dc7fa3af-d391-569e-bc17-106f3e9396bf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨-3,4,-1⟩=⟨3,-5,-2⟩" :db/id #edb/ref 17592186393046} {:answer/id #uuid "8fe2b282-7f73-5949-a7f3-cc5ddf1e2530" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨-3,4,-1⟩=0" :db/id #edb/ref 17592186393047} {:answer/id #uuid "949e581b-c362-5470-828e-687788c962cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨3,-5,-2⟩=-27" :db/id #edb/ref 17592186393048} {:answer/id #uuid "1521f0fb-a511-5bc0-893e-2c6a06cceff9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨-3,4,-1⟩=-27" :db/id #edb/ref 17592186393049}] :answer-field/correct {:db/id #edb/ref 17592186393049} :answer-field/id #uuid "31ef96c8-9198-5e30-8832-aa55a71dc6d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186393044}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "ca2b2271-1ec0-5a3e-b5ac-687d91668797" :question/math-academy-id "q-70895" :question/problem "Find an equation of the plane that passes through the point $P(3,-5,-2)$ and is perpendicular to the line \n\n$$\n\\{\\begin{aligned}x=2-3t \\\\ y=3+4t \\\\ z=4-t.\\end{aligned}\n$$" :question/worked-solution "Note that the position vector of $P$ is $p=⟨3,-5,-2⟩.$ Converting the parametric equations of the line to vector form, we get\n\n$$\n\\{\\begin{aligned}x=2-3t \\\\ y=3+4t \\\\ z=4-t\\end{aligned}\\,⟹\\,⟨x,y,z⟩=⟨2,3,4⟩+t\\text{ }{{⟨-3,4,-1⟩}_{⏟}}_{v}.\n$$\n\n \n\nThe direction vector of the line is $v=⟨-3,4,-1⟩,$ so a normal vector to the plane is \n\n$$\nn=v=⟨-3,4,-1⟩.\n$$\n\nTherefore, the equation of the plane is given by\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n-p\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨-3,4,-1⟩ & =⟨3,-5,-2⟩\\cdot ⟨-3,4,-1⟩ \\\\ r\\cdot ⟨-3,4,-1⟩ & =-27.\\end{aligned}\n$$"} :step/id #uuid "2c8b595f-b1a8-514e-9b95-bb539ab93fc0" :step/next {:db/id #edb/ref 17592186423180}} {:db/id #edb/ref 17592186423180 :step/content {:db/id #edb/ref 17592186262855 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0387b95b-ea4c-5624-9fdd-7d44aae31856" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨3,1,1⟩=12" :db/id #edb/ref 17592186259907} {:answer/id #uuid "ad85ebfc-775c-5bdb-a5e6-836a5963e43c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨1,1,5⟩=9" :db/id #edb/ref 17592186261395} {:answer/id #uuid "b2a79415-12c6-5171-8ecf-e701971bbaad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨1,3,1⟩=12" :db/id #edb/ref 17592186261452} {:answer/id #uuid "d9ba12b0-dcfe-5c43-b282-17a43fb1d275" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨5,1,1⟩=18" :db/id #edb/ref 17592186261796} {:answer/id #uuid "eb666347-2e39-5891-a53f-4830ffc6eb6f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot ⟨1,5,1⟩=9" :db/id #edb/ref 17592186261942}] :answer-field/correct {:db/id #edb/ref 17592186261796} :answer-field/id #uuid "207a2b37-6c4f-5b41-aa59-d8127027f268" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186262177}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "57b46f7d-b75a-5f5c-87e6-c8948d671ea4" :question/math-academy-id "q-127936" :question/problem "Find an equation of the plane that passes through the point $P(3,-2,5)$ and is perpendicular to the line that goes through the points \n$A(-3,0,2)$ and $B(2,1,3).$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨3,-2,5⟩.$\n\nSince the line  passes through the points $A(-3,0,2)$ and $B(2,1,3)$ we can find a vector parallel to the line:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =⟨2,1,3⟩-⟨-3,0,2⟩ \\\\  & =⟨5,1,1⟩.\\end{aligned}\n$$\n\n \n\nSo, a normal vector to the plane is $n=⟨5,1,1⟩.$\n\nTherefore, the equation of the plane is given by\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n-p\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨5,1,1⟩ & =⟨3,-2,5⟩\\cdot ⟨5,1,1⟩ \\\\ r\\cdot ⟨5,1,1⟩ & =18.\\end{aligned}\n$$"} :step/id #uuid "376b1716-abbb-51bb-97e6-b6e06c8b7140"} {:db/id #edb/ref 17592186423181 :step/content {:db/id #edb/ref 17592186423177 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "54c2e93d-88d9-55e5-8da7-a7c8857c95a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot [\\begin{aligned}0 \\\\ 1 \\\\ 1\\end{aligned}]=1" :db/id #edb/ref 17592186423171} {:answer/id #uuid "865e5880-5d6c-5eb8-b605-32023bca731a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot [\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]=0" :db/id #edb/ref 17592186423172} {:answer/id #uuid "88b7b35b-b8a9-55fa-b177-e46dd3a1176a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot [\\begin{aligned}0 \\\\ 1 \\\\ 1\\end{aligned}]=-1" :db/id #edb/ref 17592186423173} {:answer/id #uuid "c899f30d-448a-55d6-a220-50efc27da551" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot [\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]=1" :db/id #edb/ref 17592186423174} {:answer/id #uuid "f42a4087-cff6-5d2b-9264-832562c287ce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\cdot [\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]=[\\begin{aligned}0 \\\\ 1 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186423175}] :answer-field/correct {:db/id #edb/ref 17592186423174} :answer-field/id #uuid "ed6bca43-1900-5519-94be-29cc1bb55d43" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186423176}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9509d4b2-8f43-5f25-8917-81a3d5d9b04d" :question/math-academy-id "q-33195" :question/problem "Find an equation of the plane that contains the point $P(0,1,1)$ and is perpendicular to the vector $n=[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}].$" :question/worked-solution "First, notice that the position vector of $P$ is $p=[\\begin{aligned}0 \\\\ 1 \\\\ 1\\end{aligned}]$ and $n=[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]$ is normal to the plane.\n\nThe equation of the plane that passes though the point $P({x}_{0},{y}_{0},{z}_{0})$ and is perpendicular to the vector $n$ can be given as\n\n$$\n(r-p)\\cdot n=0,\n$$\n\nwhere $r$ is the position vector of any point on the plane, and $p$ is the position vector of $P.$\n\nSo, we have\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n-p\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot [\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}] & =[\\begin{aligned}0 \\\\ 1 \\\\ 1\\end{aligned}]\\cdot [\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}] \\\\ r\\cdot [\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}] & =1.\\end{aligned}\n$$"} :step/id #uuid "3ecf110e-e7e0-5add-b305-ad1bf6c365c5" :step/next {:db/id #edb/ref 17592186423182}} {:db/id #edb/ref 17592186423182 :step/content {:db/id #edb/ref 17592186393029 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c4fb71df-948c-5126-86b0-9d79cb4c0fee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186393031} {:answer/id #uuid "75ed4713-5dc0-5929-8f1a-ae29368dccf9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186393032} {:answer/id #uuid "14d6c7a2-54c1-5ce2-9906-4d55cf87f498" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186393033} {:answer/id #uuid "32938842-cdd7-5118-b60e-0c5d24a27836" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186393034} {:answer/id #uuid "ea4da8ff-198b-50e0-8319-7a9af39b8918" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186393035}] :answer-field/correct {:db/id #edb/ref 17592186393032} :answer-field/id #uuid "b14d7746-5f36-5ef0-9936-be22c8877f39" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186393030}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ee04e6aa-94ba-5e6d-a904-4a34aac7a757" :question/math-academy-id "q-70827" :question/problem "A nonzero vector $⟨0,\\,b,\\,c⟩$ is parallel to the plane $r\\cdot ⟨1,2,-1⟩=7.$ What is the value of $\\frac{b}{c}?$" :question/worked-solution "We need a vector $v=⟨{t}_{1},{t}_{2},{t}_{3}⟩$ that is parallel to the given plane. \n\nFrom the equation $r\\cdot ⟨1,2,-1⟩=7$ of the plane, we get the normal vector $n=⟨1,2,-1⟩.$ So, $v⊥n$ and we have the following:\n\n$$\n\\begin{aligned}v\\cdot n & =0 \\\\ ⟨{t}_{1},{t}_{2},{t}_{3}⟩\\cdot ⟨1,2,-1⟩ & =0 \\\\ {t}_{1}+2{t}_{2}-{t}_{3} & =0 \\\\ {t}_{3} & ={t}_{1}+2{t}_{2}\\end{aligned}\n$$\n\nHence, we obtain \n\n$$\nv=⟨{t}_{1},\\,{t}_{2},\\,{t}_{1}+2{t}_{2}⟩,\n$$\n\nwhere ${t}_{1},{t}_{2}\\in (-\\infty ,\\infty ).$ \n\nWe are told that the first component of $v$ equals $0.$ So, we must set ${t}_{1}=0.$ \n\nSince $v$ is nonzero, we can pick any ${t}_{2}\\ne 0.$ For example, setting ${t}_{2}=1$, we get\n\n$$\nv=⟨0,\\,1,\\,2⟩.\n$$\n\nTherefore, $\\frac{b}{c}=\\frac{1}{2}.$"} :step/id #uuid "55812343-3b60-5de3-98f2-95ffd7bd0ddb" :step/next {:db/id #edb/ref 17592186423178}}] :activity/title "The Vector Equation of a Plane" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186423170}]}
