5ed6-b433-9cd676419b25" #edb/ref 17592186045417] [17592186265732 #edb/ref 1068 #edb/ref 17592186265553 #edb/ref 17592186045417] [17592186265732 #edb/ref 1069 "q-129455" #edb/ref 17592186045417] [17592186265732 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186265732 #edb/ref 1071 "Solve the following system of equations:\n    \n\n$$\n{\\begin{aligned} & {x}_{1}+{x}_{2}-{x}_{3}=2 \\\\  & {x}_{2}-6{x}_{3}=3 \\\\  & {x}_{3}=-\\frac{1}{3}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186265732 #edb/ref 1072 #uuid "bdb97edb-fdd8-52f8-9de8-da5dc252cf96" #edb/ref 17592186045417] [17592186265732 #edb/ref 1074 "The third equation states that ${x}_{3}=-\\frac{1}{3}.$ Substituting this into the second equation, we get\n\n$$\n{x}_{2}-6(-\\frac{1}{3})=3\\,⟹\\,{x}_{2}=3-2=1.\n$$\n\nNow, we substitute ${x}_{3}=-\\frac{1}{3}$ and ${x}_{2}=1$ into the first equation to get\n\n$$\n{x}_{1}+1-(-\\frac{1}{3})=2\\,⟹\\,{x}_{1}=2-1-\\frac{1}{3}=\\frac{2}{3}.\n$$\n\nTherefore, the solution is ${x}_{1}=\\frac{2}{3}$, ${x}_{2}=1$, and ${x}_{3}=-\\frac{1}{3}.$ In vector form, the solution can be written as\n$[\\begin{aligned}\\frac{2}{3} \\\\ 1 \\\\ -\\frac{1}{3}\\end{aligned}].$" #edb/ref 17592186045417] [17592186265750 #edb/ref 1068 #edb/ref 17592186265687 #edb/ref 17592186045417] [17592186265750 #edb/ref 1069 "q-129599" #edb/ref 17592186045417] [17592186265750 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186265750 #edb/ref 1071 "Solve the system of equations represented by the augmented matrix \n\n$$\n[\\begin{aligned}1 & 1 & 2 & -1 \\\\ 0 & 1 & 3 & 2 \\\\ 0 & 0 & 1 & 3\\end{aligned}].\n$$" #edb/ref 17592186045417] [17592186265750 #edb/ref 1072 #uuid "f98c00cd-fa7a-5960-9ffe-f0175b73e871" #edb/ref 17592186045417] [17592186265750 #edb/ref 1074 "The matrix represents a system of three linear equations in three variables, say, $x$, $y$, and $z.$ We obtain the following system of linear equations:\n\n$$\n{\\begin{aligned} & x+y+2z=-1 \\\\  & y+3z=2 \\\\  & z=3\\end{aligned}\n$$\n\nThe third equation states that $z=3.$ Substituting this into the second equation, we get\n\n$$\ny+3(3)=2\\,⟹\\,y=2-9=-7.\n$$\n\nNow, we substitute $z=3$ and $y=-7$ into the first equation to get\n\n$$\nx+(-7)+2(3)=-1\\,⟹\\,x=-1+7-6=0.\n$$\n\nTherefore, the solution is $x=0$, $y=-7$, and $z=3.$ In vector form, the solution can be written as $⟨0,-7,3⟩.$" #edb/ref 17592186045417] [17592186339326 #edb/ref 1080 "[\\begin{aligned}-1 \\\\ 4 \\\\ -2\\end{aligned}]" #edb/ref 17592186045417] [17592186339326 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186339326 #edb/ref 1083 #uuid "165ea2fd-41c0-5400-b24b-77486a19a825" #edb/ref 17592186045417] [17592186340049 #edb/ref 1080 "[\\begin{aligned}2 \\\\ 1 \\\\ -2\\end{aligned}]" #edb/ref 17592186045417] [17592186340049 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186340049 #edb/ref 1083 #uuid "67ae6eb0-f860-56b5-a08f-2f5623a97b3e" #edb/ref 17592186045417] [17592186340833 #edb/ref 1080 "[\\begin{aligned}3 \\\\ 2 \\\\ -2\\end{aligned}]" #edb/ref 17592186045417] [17592186340833 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186340833 #edb/ref 1083 #uuid "bf55a7f8-3683-5adc-8cf6-442d5d29a568" #edb/ref 17592186045417] [17592186341099 #edb/ref 1080 "[\\begin{aligned}4 \\\\ 1 \\\\ -2\\end{aligned}]" #edb/ref 17592186045417] [17592186341099 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186341099 #edb/ref 1083 #uuid "ddecb468-7ba6-5116-8ff8-2b5e7fe02d0c" #edb/ref 17592186045417] [17592186341217 #edb/ref 1080 "[\\begin{aligned}2 \\\\ 1 \\\\ -4\\end{aligned}]" #edb/ref 17592186045417] [17592186341217 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186341217 #edb/ref 1083 #uuid "ecf0aed3-bba1-520d-802b-6e0413c2d5b9" #edb/ref 17592186045417] [17592186341761 #edb/ref 1075 #edb/ref 17592186339326 #edb/ref 17592186045417] [17592186341761 #edb/ref 1075 #edb/ref 17592186340049 #edb/ref 17592186045417] [17592186341761 #edb/ref 1075 #edb/ref 17592186340833 #edb/ref 17592186045417] [17592186341761 #edb/ref 1075 #edb/ref 17592186341099 #edb/ref 17592186045417] [17592186341761 #edb/ref 1075 #edb/ref 17592186341217 #edb/ref 17592186045417] [17592186341761 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186341761 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186341761 #edb/ref 1078 #edb/ref 17592186341099 #edb/ref 17592186045417] [17592186341761 #edb/ref 1079 #uuid "d7e5e5a9-3bd5-5992-93ff-7ad964a75306" #edb/ref 17592186045417] [17592186341892 #edb/ref 1068 #edb/ref 17592186341761 #edb/ref 17592186045417] [17592186341892 #edb/ref 1069 "q-72981" #edb/ref 17592186045417] [17592186341892 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186341892 #edb/ref 1071 "Solve the system of equations represented by the augmented matrix: \n\n$$\n[\\begin{aligned}1 & 0 & 1 & 2 \\\\ 0 & 3 & 2 & -1 \\\\ 0 & 0 & -1 & 2\\end{aligned}].\n$$" #edb/ref 17592186045417] [17592186341892 #edb/ref 1072 #uuid "41fa8809-57ef-578c-b39f-9d0b73e06f90" #edb/ref 17592186045417] [17592186341892 #edb/ref 1074 "The matrix represents a system of three linear equations in three variables, say, $x$, $y$, and $z.$ We obtain the following system of linear equations: \n\n$$\n{\\begin{aligned} & x+z=2 \\\\  & 3y+2z=-1 \\\\  & -z=2\\end{aligned}\n$$\n\nThe third equation states that\n\n$$\n-z=2\\,⟹\\,z=-2.\n$$\n\nSubstituting this into the second equation, we get\n\n$$\n3y+2(-2)=-1\\,⟹\\,y=\\frac{1}{3}(-1+4)=1.\n$$\n\nNow, we substitute $z=-2$ and $y=1$ into the first equation to get\n\n$$\nx+(-2)=2\\,⟹\\,x=2+2=4.\n$$\n\nTherefore, the solution is $x=4$, $y=1$, and $z=-2.$ In vector form, the solution can be written as \n$[\\begin{aligned}4 \\\\ 1 \\\\ -2\\end{aligned}].$" #edb/ref 17592186045417] [17592186413947 #edb/ref 1080 "[\\begin{aligned}5 \\\\ -2 \\\\ 3\\end{aligned}]" #edb/ref 17592186045417] [17592186413947 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186413947 #edb/ref 1083 #uuid "1e1ba396-d863-536b-b63f-89da9c93622a" #edb/ref 17592186045417] [17592186413948 #edb/ref 1080 "[\\begin{aligned}6 \\\\ -1 \\\\ 3\\end{aligned}]" #edb/ref 17592186045417] [17592186413948 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186413948 #edb/ref 1083 #uuid "91fdb22c-ce3c-5047-b232-a746c92c76b2" #edb/ref 17592186045417] [17592186413949 #edb/ref 1080 "[\\begin{aligned}7 \\\\ 0 \\\\ 3\\end{aligned}]" #edb/ref 17592186045417] [17592186413949 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186413949 #edb/ref 1083 #uuid "f25b4ba1-98cc-5dc7-9732-a2c78c54931c" #edb/ref 17592186045417] [17592186413950 #edb/ref 1080 "[\\begin{aligned}8 \\\\ 1 \\\\ 3\\end{aligned}]" #edb/ref 17592186045417] [17592186413950 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186413950 #edb/ref 1083 #uuid "f69db92d-7316-5f7d-b669-23f831b82506" #edb/ref 17592186045417] [17592186413951 #edb/ref 1080 "[\\begin{aligned}2 \\\\ -1 \\\\ -1\\end{aligned}]" #edb/ref 17592186045417] [17592186413951 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186413951 #edb/ref 1083 #uuid "f9dee24f-b474-52fc-80d0-88800792c747" #edb/ref 17592186045417] [17592186413952 #edb/ref 1075 #edb/ref 17592186413947 #edb/ref 17592186045417] [17592186413952 #edb/ref 1075 #edb/ref 17592186413948 #edb/ref 17592186045417] [17592186413952 #edb/ref 1075 #edb/ref 17592186413949 #edb/ref 17592186045417] [17592186413952 #edb/ref 1075 #edb/ref 17592186413950 #edb/ref 17592186045417] [17592186413952 #edb/ref 1075 #edb/ref 17592186413951 #edb/ref 17592186045417] [17592186413952 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186413952 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186413952 #edb/ref 1078 #edb/ref 17592186413948 #edb/ref 17592186045417] [17592186413952 #edb/ref 1079 #uuid "35113197-e3aa-5c52-abd1-3a40104e5631" #edb/ref 17592186045417] [17592186413953 #edb/ref 1068 #edb/ref 17592186413952 #edb/ref 17592186045417] [17592186413953 #edb/ref 1069 "q-20421" #edb/ref 17592186045417] [17592186413953 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186413953 #edb/ref 1071 "Solve the following system of equations:\n    \n\n$$\n{\\begin{aligned} & x-y-z=4 \\\\  & y+z=2 \\\\  & z=3\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186413953 #edb/ref 1072 #uuid "5e70385a-e12c-5845-86a7-e3cc76809c15" #edb/ref 17592186045417] [17592186413953 #edb/ref 1074 "The third equation states that $z=3.$ Substituting this into the second equation, we get  \n\n$$\ny+(3)=2\\,⟹\\,y=2-3=-1.\n$$\n\n \n\nNow, we substitute $z=3$ and $y=-1$ into the first equation to get\n\n$$\nx-(-1)-(3)=4\\,⟹\\,x=4-1+3=6.\n$$\n\n \n\nTherefore, the solution is $x=6$, $y=-1$, and $z=3.$ In vector form, the solution can be written as\n$[\\begin{aligned}6 \\\\ -1 \\\\ 3\\end{aligned}].$" #edb/ref 17592186045417]}
