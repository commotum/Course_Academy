417] [17592186050267 #edb/ref 1028 #edb/ref 17592186096669 #edb/ref 17592186045417] [17592186050267 #edb/ref 1028 #edb/ref 17592186096670 #edb/ref 17592186045417] [17592186050267 #edb/ref 1028 #edb/ref 17592186096671 #edb/ref 17592186045417] [17592186050267 #edb/ref 1031 "Solving Systems of Equations Using Back Substitution" #edb/ref 17592186045417] [17592186050267 #edb/ref 1033 1047 #edb/ref 17592186045417] [17592186050267 #edb/ref 1035 #uuid "3afe28a0-5051-52a1-a085-a06727c301b8" #edb/ref 17592186045417] [17592186050765 #edb/ref 1027 #edb/ref 17592186048980 #edb/ref 17592186045417] [17592186050765 #edb/ref 1027 #edb/ref 17592186049120 #edb/ref 17592186045417] [17592186050765 #edb/ref 1028 #edb/ref 17592186059767 #edb/ref 17592186045417] [17592186050765 #edb/ref 1028 #edb/ref 17592186059768 #edb/ref 17592186045417] [17592186050765 #edb/ref 1028 #edb/ref 17592186059769 #edb/ref 17592186045417] [17592186050765 #edb/ref 1028 #edb/ref 17592186059770 #edb/ref 17592186045417] [17592186050765 #edb/ref 1031 "Systems of Equations as Augmented Matrices" #edb/ref 17592186045417] [17592186050765 #edb/ref 1033 148 #edb/ref 17592186045417] [17592186050765 #edb/ref 1035 #uuid "64dbabd7-08e6-5435-b006-ab4997312f47" #edb/ref 17592186045417] [17592186096456 #edb/ref 1069 "e-4690" #edb/ref 17592186045417] [17592186096456 #edb/ref 1071 "Solve the following system of equations:\n![](images/31/31969ec4b2fc35f5175b3cfd114b79b5b9ba608241aa1d9c45f1a7c37484fd21.svg)" #edb/ref 17592186045417] [17592186096456 #edb/ref 1072 #uuid "201a713a-83ca-5e31-9a4f-257795d7eb1b" #edb/ref 17592186045417] [17592186096456 #edb/ref 1074 "The third equation states that $z=2.$ Substituting this into the second equation, we get\n\n$$\ny+(2)=2 \n\t\\qquad\\Longrightarrow\\qquad\n\ty = 2-2 = 0.\n$$\n\nNow, we substitute both $z=2$ and $y=0$ into the first equation to get\n\n$$\nx+(0)+(2)=3\n\t\\qquad\\Longrightarrow\\qquad\n\tx = 3-2 = 1.\n$$\n\nTherefore, the solution is $x = 1,$ $y=0,$ and $z = 2.$ Or, in vector form, the solution is $\\langle 1,0,2 \\rangle.$" #edb/ref 17592186045417] [17592186096457 #edb/ref 1069 "e-4691" #edb/ref 17592186045417] [17592186096457 #edb/ref 1071 "Solve the system of equations that is represented by the augmented matrix\n![](images/c3/c33de841c5e1997fba4e26afca5750a0125fa1fcd98bd98993feadaab063c1c9.svg)" #edb/ref 17592186045417] [17592186096457 #edb/ref 1072 #uuid "cc8ce97a-3bda-506f-b9d2-98ac7524583a" #edb/ref 17592186045417] [17592186096457 #edb/ref 1074 "The matrix represents a system of three linear equations in three variables, say, $x_1,$ $x_2,$ and $x_3.$ We obtain the following system of linear equations:\n\n![](images/48/484ee8f84ffa8585eb318ce50ab707ddcc13ba695d32100f85850ba5f408725d.svg)\n\nThe third equation states that $x_3=5.$ Substituting this into the second equation, we get\n\n$$\nx_2+(5)=-2\n\t\\qquad\\Longrightarrow\\qquad\n\tx_2=-2-5=-7.\n$$\n\nNow, we substitute both $x_3 = 5$ and $x_2 = -7$ into the first equation to get\n\n$$\nx_1+(-7)-(5) = 1\n\t\\qquad\\Longrightarrow\\qquad\n\tx_1 = 1 + 7 + 5 = 13.\n$$\n\nTherefore, the solution is $x_1 = 13,$ $x_2=-7,$ and $x_3 = 5.$ Or, in vector form, the solution is $\\langle 13,-7,5 \\rangle.$" #edb/ref 17592186045417] [17592186096458 #edb/ref 1069 "e-4692" #edb/ref 17592186045417] [17592186096458 #edb/ref 1071 "Solve the system of equations that is represented by the augmented matrix\n![](images/2f/2fdf3fdd1bcbd2d7133c5e7a124cbe5e28d9eb4429affeb7376178984207ee4b.svg)" #edb/ref 17592186045417] [17592186096458 #edb/ref 1072 #uuid "7b44089c-8ca7-57e5-b390-7900647e3884" #edb/ref 17592186045417] [17592186096458 #edb/ref 1074 "The matrix represents a system of three linear equations in three variables, say, $x_1,$ $x_2,$ and $x_3.$ We obtain the following system of linear equations:\n\n![](images/d3/d319f3db5d82a2076a53b04ac838cc811c9b4adfd65493d5197bf94befd11d44.svg)\n\nThe third equation states that\n\n$$\n3x_3=3 \n\t\\qquad\\Longrightarrow\\qquad \n\tx_3=1.\n$$\n\nSubstituting this into the second equation, we get\n\n$$\nx_2+(1)=-2\n\t\\qquad\\Longrightarrow\\qquad\n\tx_2=-2-1=-3.\n$$\n\nNow, we substitute both $x_3 = 1$ and $x_2 = -3$ into the first equation to get\n\n$$\n2x_1+(-3)-(1) = 0\n\t\\qquad\\Longrightarrow\\qquad\n\tx_1 = \\dfrac{1}{2} (3 + 1) = 2.\n$$\n\nTherefore, the solution is $x_1 = 2,$ $x_2=-3,$ and $x_3 = 1.$ Or, in vector form, the solution is $\\langle 2,-3,1 \\rangle.$" #edb/ref 17592186045417] [17592186096669 #edb/ref 1037 #edb/ref 17592186048826 #edb/ref 17592186045417] [17592186096669 #edb/ref 1038 #edb/ref 17592186097178 #edb/ref 17592186045417] [17592186096669 #edb/ref 1038 #edb/ref 17592186097182 #edb/ref 17592186045417] [17592186096669 #edb/ref 1038 #edb/ref 17592186237857 #edb/ref 17592186045417] [17592186096669 #edb/ref 1038 #edb/ref 17592186237858 #edb/ref 17592186045417] [17592186096669 #edb/ref 1038 #edb/ref 17592186237860 #edb/ref 17592186045417] [17592186096669 #edb/ref 1038 #edb/ref 17592186237861 #edb/ref 17592186045417] [17592186096669 #edb/ref 1038 #edb/ref 17592186237863 #edb/ref 17592186045417] [17592186096669 #edb/ref 1038 #edb/ref 17592186265729 #edb/ref 17592186045417] [17592186096669 #edb/ref 1038 #edb/ref 17592186265730 #edb/ref 17592186045417] [17592186096669 #edb/ref 1038 #edb/ref 17592186265731 #edb/ref 17592186045417] [17592186096669 #edb/ref 1038 #edb/ref 17592186265732 #edb/ref 17592186045417] [17592186096669 #edb/ref 1038 #edb/ref 17592186413953 #edb/ref 17592186045417] [17592186096669 #edb/ref 1039 "Solving a System of Equations Using Back Substitution" #edb/ref 17592186045417] [17592186096669 #edb/ref 1041 #edb/ref 17592186096456 #edb/ref 17592186045417] [17592186096669 #edb/ref 1042 #uuid "b8f8937b-de15-5d4c-aa77-1d45595fc7af" #edb/ref 17592186045417] [17592186096670 #edb/ref 1037 #edb/ref 17592186050765 #edb/ref 17592186045417] [17592186096670 #edb/ref 1038 #edb/ref 17592186096925 #edb/ref 17592186045417] [17592186096670 #edb/ref 1038 #edb/ref 17592186097179 #edb/ref 17592186045417] [17592186096670 #edb/ref 1038 #edb/ref 17592186265733 #edb/ref 17592186045417] [17592186096670 #edb/ref 1038 #edb/ref 17592186265734 #edb/ref 17592186045417] [17592186096670 #edb/ref 1038 #edb/ref 17592186265749 #edb/ref 17592186045417] [17592186096670 #edb/ref 1038 #edb/ref 17592186265750 #edb/ref 17592186045417] [17592186096670 #edb/ref 1038 #edb/ref 17592186287990 #edb/ref 17592186045417] [17592186096670 #edb/ref 1038 #edb/ref 17592186341889 #edb/ref 17592186045417] [17592186096670 #edb/ref 1038 #edb/ref 17592186341890 #edb/ref 17592186045417] [17592186096670 #edb/ref 1039 "Solving a System of Equations Using Back Substitution Given an Augmented Matrix" #edb/ref 17592186045417] [17592186096670 #edb/ref 1041 #edb/ref 17592186096457 #edb/ref 17592186045417] [17592186096670 #edb/ref 1042 #uuid "de05090a-2461-514a-971d-b83c7cea124e" #edb/ref 17592186045417] [17592186096671 #edb/ref 1038 #edb/ref 17592186096923 #edb/ref 17592186045417] [17592186096671 #edb/ref 1038 #edb/ref 17592186096924 #edb/ref 17592186045417] [17592186096671 #edb/ref 1038 #edb/ref 17592186237870 #edb/ref 17592186045417] [17592186096671 #edb/ref 1038 #edb/ref 17592186265751 #edb/ref 17592186045417] [17592186096671 #edb/ref 1038 #edb/ref 17592186265752 #edb/ref 17592186045417] [17592186096671 #edb/ref 1038 #edb/ref 17592186265753 #edb/ref 17592186045417] [17592186096671 #edb/ref 1038 #edb/ref 17592186341891 #edb/ref 17592186045417] [17592186096671 #edb/ref 1038 #edb/ref 17592186341892 #edb/ref 17592186045417] [17592186096671 #edb/ref 1038 #edb/ref 17592186341893 #edb/ref 17592186045417] [17592186096671 #edb/ref 1039 "Solving a System of Equations Given an Augmented Matrix Containing Non-Unit Leading Entries" #edb/ref 17592186045417] [17592186096671 #edb/ref 1041 #edb/ref 17592186096458 #edb/ref 17592186045417] [17592186096671 #edb/ref 1042 #uuid "52e51c9a-6bce-5ea6-a9fe-febb09f8754d" #edb/ref 17592186045417] [17592186096855 #edb/ref 1043 #edb/ref 17592186097514 #edb/ref 17592186045417] [17592186096855 #edb/ref 1043 #edb/ref 17592186097515 #edb/ref 17592186045417] [17592186096855 #edb/ref 1043 #edb/ref 17592186097516 #edb/ref 17592186045417] [17592186096855 #edb/ref 1043 #edb/ref 17592186097517 #edb/ref 17592186045417] [17592186096855 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186096855 #edb/ref 1045 "Solving Systems of Equations Using Back Substitution" #edb/ref 17592186045417] [17592186096855 #edb/ref 1046 #edb/ref 17592186097514 #edb/ref 17592186045417] [17592186096855 #edb/ref 1049 #edb/ref 17592186050267 #edb/ref 17592186045417] [17592186096855 #edb/ref 1050 420.0 #edb/ref 17592186045417] [17592186096855 #edb/ref 1053 #uuid "34909092-851c-5b8f-b289-94633fbc239b" #edb/ref 17592186045417] [17592186096924 #edb/ref 1068 #edb/ref 17592186237594 #edb/ref 17592186045417] [17592186096924 #edb/ref 1069 "q-10204" #edb/ref 17592186045417] [17592186096924 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186096924 #edb/ref 1071 "Solve the following system of equations:\n\n$$\n{\\begin{aligned} & x+2y-z=10 \\\\  & y+5z=15 \\\\  & -z=5\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186096924 #edb/ref 1072 #uuid "5592cf72-9e61-50b5-9aec-b1921100f3dc" #edb/ref 17592186045417] [17592186096924 #edb/ref 1074 "The third equation states that \n\n$$\n-z=5\\,⟹\\,z=-5.\n$$\n\nSubstituting this into the second equation, we get\n\n$$\ny+5(-5)=15\\,⟹\\,y=15+25=40.\n$$\n\nNow, we substitute $z=-5$ and $y=40$ into the first equation to get\n\n$$\nx+2(40)-(-5)=10\\,⟹\\,x=10-80-5=-75.\n$$\n\nTherefore, the solution is $x=-75,y=40$ and $z=-5.$ In vector form, the solution can be written as $⟨-75,40,-5⟩.$" #edb/ref 17592186045417] [17592186096925 #edb/ref 1068 #edb/ref 17592186237622 #edb/ref 17592186045417] [17592186096925 #edb/ref 1069 "q-10205" #edb/ref 17592186045417] [17592186096925 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186096925 #edb/ref 1071 "Solve the system of equations represented by the augmented matrix \n\n$$\n[\\begin{aligned}1 & 1 & 1 & 1 \\\\ 0 & 1 & 1 & 1 \\\\ 0 & 0 & 1 & 1\\end{aligned}].\n$$" #edb/ref 17592186045417] [17592186096925 #edb/ref 1072 #uuid "aaed5b7a-0eac-529c-ad7e-d0cc31abe7a0" #edb/ref 17592186045417] [17592186096925 #edb/ref 1074 "The matrix represents a system of three linear equations in three variables, say, $x$, $y$, and $z.$ We obtain the following system of linear equations:\n\n$$\n{\\begin{aligned} & x+y+z=1 \\\\  & y+z=1 \\\\  & z=1\\end{aligned}\n$$\n\nThe third equation states that $z=1.$ Substituting this into the second equation, we get\n\n$$\ny+(1)=1\\,⟹\\,y=1-1=0.\n$$\n\nNow, we substitute $z=1$ and $y=0$ into the first equation to get\n\n$$\nx+(0)+(1)=1\\,⟹\\,x=1-1=0.\n$$\n\nTherefore, the solution is $x=0$, $y=0$, and $z=1.$ In vector form, the solution can be written as $⟨0,0,1⟩.$" #edb/ref 17592186045417] [17592186097514 #edb/ref 1058 #edb/ref 17592186097515 #edb/ref 17592186045417] [17592186097514 #edb/ref 1061 17179 #edb/ref 17592186045417] [17592186097514 #edb/ref 1062 #uuid "b94c8727-6dff-5c9a-9868-815a8a185978" #edb/ref 17592186045417] [17592186097514 #edb/ref 1063 #edb/ref 17592186097840 #edb/ref 17592186045417] [17592186097515 #edb/ref 1058 #edb/ref 17592186097516 #edb/ref 17592186045417] [17592186097515 #edb/ref 1061 17180 #edb/ref 17592186045417] [17592186097515 #edb/ref 1062 #uuid "47cad0ff-3b21-5238-b205-26619a15e0b5" #edb/ref 17592186045417] [17592186097515 #edb/ref 1063 #edb/ref 17592186096669 #edb/ref 17592186045417] [17592186097516 #edb/ref 1058 #edb/ref 17592186097517 #edb/ref 17592186045417] [17592186097516 #edb/ref 1061 17181 #edb/ref 17592186045417] [17592186097516 #edb/ref 1062 #uuid "4f928835-23b6-530a-b253-305d43df52fa" #edb/ref 17592186045417] [17592186097516 #edb/ref 1063 #edb/ref 17592186096670 #edb/ref 17592186045417] [17592186097517 #edb/ref 1061 17182 #edb/ref 17592186045417] [17592186097517 #edb/ref 1062 #uuid "a07d47d4-76d1-54a2-8790-392a617e65a8" #edb/ref 17592186045417] [17592186097517 #edb/ref 1063 #edb/ref 17592186096671 #edb/ref 17592186045417] [17592186097840 #edb/ref 1064 "Suppose we want to solve the following system of linear equations:\n![](images/b6/b6441688c486562e704a29317847ba53ca5130ff6e35c9d4effdea5ede005d3f.svg)\nThe augmented matrix for this system can be written as \n![](images/b4/b45896f12f8195fcb211411a9a2dcd230cee288822e2d37f2b364f6c1c831c6d.svg)\n\nNotice that the matrix is in *row echelon form* (or REF). Whenever the augmented matrix is in row echelon form, we can solve the system using a method called **back substitution**.\n\nBack substitution involves\n\n- starting with the lowest equation (which is already solved for one variable),\n\n- substituting the result into the next-lowest equation to find the solution for another variable, and\n\n- continuing to substitute the result into the next-lowest equation until the values of all the variables have been found.\n\nHere, the third equation states that $z=3.$ Substituting this into the second equation, we get\n\n$$\ny -(3) = 2 \n\t\\qquad\\Longrightarrow\\qquad\n\ty = 5.\n$$\n\nNow, we substitute both $y=5$ and $z=3$ into the first equation to get\n\n$$\nx + 2(5) + (3) = 1\n\t\\qquad\\Longrightarrow\\qquad\n\tx = -12.\n$$\n\nTherefore, the solution is $x=-12,$ $y=5,$ and $z=3.$ We can write it in vector form, as follows:\n\n![](images/8b/8bbbabd0167fc73c58c095fb11ed5efb2c2dca63ee90e95717e26f30f0f170e9.svg)\n\n**Note:** The values $x=-12,$ $y=5,$ and $z=3$ together form *one* solution. We say that this system has *one* solution, *not* three solutions. A system with three solutions would have three different solution vectors, whereas here, we only have *one* solution vector." #edb/ref 17592186045417] [17592186097840 #edb/ref 1065 3149 #edb/ref 17592186045417] [17592186097840 #edb/ref 1066 #uuid "4d84a9a0-94f9-57e2-a8e6-333ba26d72e4" #edb/ref 17592186045417] [17592186097840 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186235965 #edb/ref 1080 "⟨0,1,1⟩" #edb/ref 175921