            },
            {
              "option": "b",
              "dom_id": "questionWidget-choiceLetterCircle-163778-b",
              "type": "text",
              "value": "I only",
              "html": "I only"
            },
            {
              "option": "c",
              "dom_id": "questionWidget-choiceLetterCircle-163778-c",
              "type": "text",
              "value": "II and III only",
              "html": "II and III only"
            },
            {
              "option": "d",
              "dom_id": "questionWidget-choiceLetterCircle-163778-d",
              "type": "text",
              "value": "I and II only",
              "html": "I and II only"
            },
