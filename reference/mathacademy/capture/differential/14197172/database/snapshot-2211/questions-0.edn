6045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477178}] :answer-field/correct {:answer/id #uuid "20f27812-b4ae-5c70-86be-39936a5a8ad5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477178} :answer-field/id #uuid "6810b078-209d-5aba-bb8f-1806d12074a9" :answer-field/key "D" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477558}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0151a70d-ce12-5172-8abb-638426f2b102" :question/math-academy-id "q-162747" :question/problem "![](images/b6/b698fe735caaf3bc260c1e921bb95596df8869eba67ec9ce72484b4d86cc8c69.png)\n\nThe graph of the function $z=f(x,y)$ is shown above. Which of the points shown are local minimum points?\n\nSelect all that apply." :question/worked-solution "A function $f(x,y)$ has a local minimum point at $(a,b)$ if $f(x,y)\\ge f(a,b)$ for all points $(x,y)$ in a neighborhood of $(a,b).$ \n\nIn other words, we can take a neighborhood of $(x,y)$-values such that the point $(x,y,f(x,y))$ is the lowest point on the graph in the neighborhood.\n\nSuch regions exist for the points $A$ and $D.$ Hence $A$ and $D$ are local minimum points.\n\n**Note**: For the point $D({x}_{D},{y}_{D},{z}_{D}),$ there are points $(x,y)$ in the surrounding regions such that $f({x}_{D},{y}_{D})=f(x,y).$ However, since the definition of local extrema is non-strict, $f(x,y)\\ge f(a,b)$, the point $D$ does satisfy the conditions for a local minimum.\n\n![](images/0a/0a371aa559222bd28c37677bace18eb912bdc978e364bab4cb3d83f7a310de3f.png)"}] [{:db/id #edb/ref 17592186124820 :knowledge-point/_questions [{:db/id #edb/ref 17592186124648 :knowledge-point/id #uuid "233eab4c-ab17-53a8-ae03-f6f28ac78922" :knowledge-point/title "Classifying Local Extrema Using Eigenvalues"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "82b674c8-eb57-5887-8426-8d408fa1479c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "inconclusive" :db/id #edb/ref 17592186121518} {:answer/id #uuid "eb2a4026-9a30-57e8-a31c-3c06788c36b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "not a critical point" :db/id #edb/ref 17592186121519} {:answer/id #uuid "207f2967-8496-5a9e-88f8-aba4ca44f2e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "saddle point" :db/id #edb/ref 17592186121520} {:answer/id #uuid "528656e1-de5b-5574-9c6d-9c343b8f9305" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "local maximum" :db/id #edb/ref 17592186121521} {:answer/id #uuid "58e91dd6-8a5c-5dac-bf79-fcf5d7a52091" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "local minimum" :db/id #edb/ref 17592186121522}] :answer-field/correct {:answer/id #uuid "58e91dd6-8a5c-5dac-bf79-fcf5d7a52091" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "local minimum" :db/id #edb/ref 17592186121522} :answer-field/id #uuid "a2522a01-cce7-51e3-a966-267ce3351d43" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186121517}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e025078b-b821-5afd-8d42-a7c7c420b244" :question/math-academy-id "q-163721" :question/problem "The quadratic Taylor approximation of the function $f(x)$ about $x=a\\in {R}^{2}$ is given by\n\n$$\nf(x)≈-1+\\frac{1}{2}(x-a)^{T}\\begin{bmatrix}4 & 2 \\\\ 2 & 2\\end{bmatrix}(x-a).\n$$\n\nGiven that the eigenvalues of ${f}^{″}(a)$ are ${\\lambda }_{1}=3-\\sqrt{5}$ and ${\\lambda }_{2}=3+\\sqrt{5},$ what type of point is $a?$" :question/worked-solution "The point $a\\in {R}^{n}$ is a critical point of the function $f:{R}^{n}\\to R$ if ${f}^{′}(a)={0}^{T}.$ In such cases, we can classify $a$ as follows:\n\n- if ${f}^{″}(a)$ is positive definite, then $a$ is a local minimum\n\n- if ${f}^{″}(a)$ is negative definite, then $a$ is a local maximum\n\n- if ${f}^{″}(a)$ is neither positive-definite nor negative-definite, then $a$ is a saddle point\n\nThe quadratic Taylor expansion of a function $f:{R}^{n}\\to R$ about $x=a\\in {R}^{n}$ given by\n\n$$\nf(x)≈f(a)+{f}^{′}(a)(x-a)+\\frac{1}{2}(x-a)^{T}{f}^{″}(a)(x-a).\n$$\n\nSince the quadratic Taylor expansion of $f$ has no $(x-a)$ term, we can conclude that ${f}^{′}(a)={0}^{T}.$ Hence, $a$ is a critical point of $f.$\n\nFinally, notice that both the eigenvalues of ${f}^{″}(a)$ are positive:\n\n$$\n\\begin{aligned}{\\lambda }_{1} & =3-\\sqrt{5}>0 \\\\ {\\lambda }_{2} & =3+\\sqrt{5}>0\\end{aligned}\n$$\n\nSo, the matrix is positive definite. Therefore, $a$ is a local minimum of $f.$"}] [{:db/id #edb/ref 17592186401419 :knowledge-point/_questions [{:db/id #edb/ref 17592186124648 :knowledge-point/id #uuid "233eab4c-ab17-53a8-ae03-f6f28ac78922" :knowledge-point/title "Classifying Local Extrema Using Eigenvalues"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a1cab09-af4c-5681-b572-7073c44cadd1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "local maximum" :db/id #edb/ref 17592186401421} {:answer/id #uuid "79bc2964-acb4-51b0-b007-9d90d00e18e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "inconclusive" :db/id #edb/ref 17592186401422} {:answer/id #uuid "17c52ede-9d07-5f7f-8b20-6215a7509689" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "not a critical point" :db/id #edb/ref 17592186401423} {:answer/id #uuid "869eb4f4-f69e-53fa-8018-2d9ffbf80a5f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "local minimum" :db/id #edb/ref 17592186401424} {:answer/id #uuid "e113570c-5c60-57ef-a5c6-a06bf8ad264a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "saddle point" :db/id #edb/ref 17592186401425}] :answer-field/correct {:answer/id #uuid "869eb4f4-f69e-53fa-8018-2d9ffbf80a5f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "local minimum" :db/id #edb/ref 17592186401424} :answer-field/id #uuid "c860e53e-f867-5749-aa4f-e7a554c597fa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401420}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c9ce8c10-95e8-5421-97ed-611d96bbf7c9" :question/math-academy-id "q-163771" :question/problem "The quadratic Taylor approximation of the function $f(x)$ about $x=a\\in {R}^{3}$ is given by\n\n$$\nf(x)≈-\\frac{4}{3}+\\frac{1}{2}(x-a)^{T}\\begin{bmatrix}2 & -1 & 0 \\\\ -1 & 2 & 0 \\\\ 0 & 0 & 2\\end{bmatrix}(x-a).\n$$\n\nGiven that the eigenvalues of ${f}^{″}(a)$ are ${\\lambda }_{1}=1,{\\lambda }_{2}=2,$ and ${\\lambda }_{3}=3,$ what type of point is $a?$" :question/worked-solution "The point $a\\in {R}^{n}$ is a critical point of the function $f:{R}^{n}\\to R$ if ${f}^{′}(a)={0}^{T}.$ In such cases, we can classify $a$ as follows:\n\n- if ${f}^{″}(a)$ is positive definite, then $a$ is a local minimum\n\n- if ${f}^{″}(a)$ is negative definite, then $a$ is a local maximum\n\n- if ${f}^{″}(a)$ is neither positive-definite nor negative-definite, then $a$ is a saddle point\n\nThe quadratic Taylor expansion of a function $f:{R}^{n}\\to R$ about $x=a\\in {R}^{n}$ given by\n\n$$\nf(x)≈f(a)+{f}^{′}(a)(x-a)+\\frac{1}{2}(x-a)^{T}{f}^{″}(a)(x-a).\n$$\n\nSince the quadratic Taylor expansion of $f$ has no $(x-a)$ term, we can conclude that ${f}^{′}(a)={0}^{T}.$ Hence, $a$ is a critical point of $f.$\n\nFinally, notice that all the eigenvalues of ${f}^{″}(a)$ are positive:\n\n$$\n\\begin{aligned}{\\lambda }_{1} & =1>0 \\\\ {\\lambda }_{2} & =2>0 \\\\ {\\lambda }_{3} & =3>0\\end{aligned}\n$$\n\nSo, the matrix is positive definite. Therefore, $a$ is a local minimum of $f.$"}] [{:db/id #edb/ref 17592186434753 :knowledge-point/_questions [{:db/id #edb/ref 17592186124648 :knowledge-point/id #uuid "233eab4c-ab17-53a8-ae03-f6f28ac78922" :knowledge-point/title "Classifying Local Extrema Using Eigenvalues"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "270cb157-312b-598a-a963-8332f3594021" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "local minimum" :db/id #edb/ref 17592186434666} {:answer/id #uuid "5d10f4aa-be44-5d96-9b85-bf9265aaedd3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "inconclusive" :db/id #edb/ref 17592186434679} {:answer/id #uuid "66cf0a35-8b8a-52ab-82bc-4a4518a010c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "local maximum" :db/id #edb/ref 17592186434683} {:answer/id #uuid "a3ac3574-a248-5137-9dca-b1453562f8cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "saddle point" :db/id #edb/ref 17592186434705} {:answer/id #uuid "cd819cdb-57a3-5138-b681-8a96c46bbbb7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "not a critical point" :db/id #edb/ref 17592186434719}] :answer-field/correct {:answer/id #uuid "270cb157-312b-598a-a963-8332f3594021" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "local minimum" :db/id #edb/ref 17592186434666} :answer-field/id #uuid "6988e8b1-324d-5035-b234-84ec660debef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186434741}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4c7c764b-5efc-585f-b1d6-ab32ef1c26ef" :question/math-academy-id "q-163772" :question/problem "The quadratic Taylor approximation of the function $f(x)$ about $x=a\\in {R}^{2}$ is given by\n\n$$\nf(x)≈-\\frac{1}{3}+\\frac{1}{2}(x-a)^{T}\\begin{bmatrix}2 & 1 \\\\ 1 & 2\\end{bmatrix}(x-a).\n$$\n\nGiven that the eigenvalues of ${f}^{″}(a)$ are ${\\lambda }_{1}=1$ and ${\\lambda }_{2}=3,$ what type of point is $a?$" :question/worked-solution "The point $a\\in {R}^{n}$ is a critical point of the function $f:{R}^{n}\\to R$ if ${f}^{′}(a)={0}^{T}.$ In such cases, we can classify $a$ as follows:\n\n- if ${f}^{″}(a)$ is positive definite, then $a$ is a local minimum\n\n- if ${f}^{″}(a)$ is negative definite, then $a$ is a local maximum\n\n- if ${f}^{″}(a)$ is neither positive-definite nor negative-definite, then $a$ is a saddle point\n\nThe quadratic Taylor expansion of a function $f:{R}^{n}\\to R$ about $x=a\\in {R}^{n}$ given by\n\n$$\nf(x)≈f(a)+{f}^{′}(a)(x-a)+\\frac{1}{2}(x-a)^{T}{f}^{″}(a)(x-a).\n$$\n\nSince the quadratic Taylor expansion of $f$ has no $(x-a)$ term, we can conclude that ${f}^{′}(a)={0}^{T}.$ Hence, $a$ is a critical point of $f.$\n\nFinally, notice that both the eigenvalues of ${f}^{″}(a)$ are positive:\n\n$$\n\\begin{aligned}{\\lambda }_{1} & =1>0 \\\\ {\\lambda }_{2} & =3>0\\end{aligned}\n$$\n\nSo, the matrix is positive definite. Therefore, $a$ is a local minimum of $f.$"}] [{:db/id #edb/ref 17592186434752 :knowledge-point/_questions [{:db/id #edb/ref 17592186124648 :knowledge-point/id #uuid "233eab4c-ab17-53a8-ae03-f6f28ac78922" :knowledge-point/title "Classifying Local Extrema Using Eigenvalues"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48aa8c46-39c6-5468-85c5-ec68e86acbdd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "local maximum" :db/id #edb/ref 17592186434676} {:answer/id #uuid "63a1c505-6f99-5e6b-92df-f1c0f1d2c71d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "not a critical point" :db/id #edb/ref 17592186434681} {:answer/id #uuid "9984c603-9561-5d15-a7da-151b72f56966" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "inconclusive" :db/id #edb/ref 17592186434699} {:answer/id #uuid "d563919d-d0e0-5990-917f-9b961dfd1ad5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "local minimum" :db/id #edb/ref 17592186434723} {:answer/id #uuid "ee820c78-33c5-521b-97ae-0bef262419cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "saddle point" :db/id #edb/ref 17592186434728}] :answer-field/correct {:answer/id #uuid "ee820c78-33c5-521b-97ae-0bef262419cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "saddle point" :db/id #edb/ref 17592186434728} :answer-field/id #uuid "812379f4-7ca2-54a9-9137-3e6202ac33a8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186434742}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "463ee037-d37e-5536-bfb1-df9c529010e2" :question/math-academy-id "q-163776" :question/problem "The quadratic Taylor approximation of the function $f(x)$ about $x=a\\in {R}^{2}$ is given by\n\n$$\nf(x)≈1+\\frac{1}{2}(x-a)^{T}\\begin{bmatrix}3 & 1 \\\\ 1 & -1\\end{bmatrix}(x-a).\n$$\n\nGiven that the eigenvalues of ${f}^{″}(a)$ are ${\\lambda }_{1}=1-\\sqrt{5}$ and ${\\lambda }_{2}=1+\\sqrt{5},$ what type of point is $a?$" :question/worked-solution "The point $a\\in {R}^{n}$ is a critical point of the function $f:{R}^{n}\\to R$ if ${f}^{′}(a)={0}^{T}.$ In such cases, we can classify $a$ as follows:\n\n- if ${f}^{″}(a)$ is positive definite, then $a$ is a local minimum\n\n- if ${f}^{″}(a)$ is negative definite, then $a$ is a local maximum\n\n- if ${f}^{″}(a)$ is neither positive-definite nor negative-definite, then $a$ is a saddle point\n\nThe quadratic Taylor expansion of a function $f:{R}^{n}\\to R$ about $x=a\\in {R}^{n}$ given by\n\n$$\nf(x)≈f(a)+{f}^{′}(a)(x-a)+\\frac{1}{2}(x-a)^{T}{f}^{″}(a)(x-a).\n$$\n\nSince the quadratic Taylor expansion of $f$ has no $(x-a)$ term, we can conclude that ${f}^{′}(a)={0}^{T}.$ Hence, $a$ is a critical point of $f.$\n\nFinally, notice that ${f}^{″}(a)$ has both negative and positive eigenvalues:\n\n$$\n\\begin{aligned}{\\lambda }_{1} & =1-\\sqrt{5}<0 \\\\ {\\lambda }_{2} & =1+\\sqrt{5}>0\\end{aligned}\n$$\n\nSo, the matrix is neither positive-definite nor negative-definite. Therefore, $a$ is a saddle point of $f.$"}] [{:db/id #edb/ref 17592186434759 :knowledge-point/_questions [{:db/id #edb/ref 17592186124570 :knowledge-point/id #uuid "40d58ee6-1121-5ddc-a96f-1a7fa7a193dd" :knowledge-point/title "Classifying Local Extrema Using Sylvester's Criterion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7ce264d-034d-56ae-8c45-60644fea8382" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474454} {:answer/id #uuid "b69543a5-9507-55c8-9d7b-79018308daff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474455}] :answer-field/correct {:answer/id #uuid "b69543a5-9507-55c8-9d7b-79018308daff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474455} :answer-field/id #uuid "e8218bbf-3c1e-52b2-9907-9353e67b32bb" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475153} {:answer-field/choices [{:answer/id #uuid "75d60915-0c29-5e83-8567-179f7fad4c42" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474456} {:answer/id #uuid "580aa846-205c-5379-bee6-c4a4934e8662" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474457}] :answer-field/correct {:answer/id #uuid "580aa846-205c-5379-bee6-c4a4934e8662" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474457} :answer-field/id #uuid "ae56fee8-14af-5459-8bea-5957e04be6b3" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475154} {:answer-field/choices [{:answer/id #uuid "70ccbe49-da48-5c61-b5d3-2e63af77af3a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474458} {:answer/id #uuid "fd2b6be1-ff0a-509a-b0c6-aadaf80dbadf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474459}] :answer-field/correct {:answer/id #uuid "70ccbe49-da48-5c61-b5d3-2e63af77af3a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474458} :answer-field/id #uuid "51b57188-14f6-5dd5-b8c7-016e3700f833" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475155}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a6771fc8-6834-5ff6-940e-46f1464b61f6" :question/math-academy-id "q-163778" :question/problem "The quadratic Taylor approximation of the function $f(x)$ about $x=a\\in {R}^{2}$ is given by\n\n$$\nf(x)≈-1+\\frac{1}{2}(x-a)^{T}A(x-a),\n$$\n\nwhere \n\n$$\nA=\\begin{bmatrix}1 & -1 \\\\ -1 & 5\\end{bmatrix}.\n$$\n\n \n\nWhich of the following statements are true?\n\nI. ${a}_{11}=1$ and $det(A)=4$\n\nII. $A$ is positive-definite\n\nIII. $a$ is a local maximum of $f$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "The point $a\\in {R}^{n}$ is a critical point of the function $f:{R}^{n}\\to R$ if ${f}^{′}(a)={0}^{T}.$ In such cases, we can classify $a$ as follows:\n\n- if ${f}^{″}(a)$ is positive definite, then $a$ is a local minimum\n\n- if ${f}^{″}(a)$ is negative definite, then $a$ is a local maximum\n\n- if ${f}^{″}(a)$ is neither positive-definite nor negative-definite, then $a$ is a saddle point\n\nIn this case, we have $A={f}^{″}(a).$ Now, before we examine the statements, let's recall how to categorize quadratic forms.\n\nLet ${Δ}_{i}$ for $i=1,2,…,n$  denote the leading principal minors of an $n\\times n$ matrix $A.$ Then, according to Sylvester's criterion, the quadratic form ${x}^{T}\\,A\\,x$ (as well as the matrix $A$) is \n\n- positive-definite if and only if ${Δ}_{i}>0$ for all $i=1,2,…,n,$\n\n- negative-definite if and only if, for all $i=1,2,…,n,$ we have ${Δ}_{i}<0$ when $i$ is odd, and ${Δ}_{i}>0$ when $i$ is even.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Indeed, ${a}_{11}=1$ and\n\n$$\ndet(A)=|\\begin{aligned}1 & -1 \\\\ -1 & 5\\end{aligned}|=4.\n$$\n\n- Statement II is true. Notice that\n\n$$\n\\begin{aligned}{Δ}_{1} & ={a}_{11}=1>0, \\\\ {Δ}_{2} & =|\\begin{aligned}1 & -1 \\\\ -1 & 5\\end{aligned}|=4>0.\\end{aligned}\n$$\n\nSo, by Sylvester's criterion, the matrix $A$ is positive-definite.\n\n- Statement III is false. Since the matrix $A$ is positive-definite, the critical point $a$ is a local minimum of $f.$\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186284418 :knowledge-point/_questions [{:db/id #edb/ref 17592186124570 :knowledge-point/id #uuid "40d58ee6-1121-5ddc-a96f-1a7fa7a193dd" :knowledge-point/title "Classifying Local Extrema Using Sylvester's Criterion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cb319d62-cd43-5416-b0dd-4e83919c9d00" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465501} {:answer/id #uuid "ccb461ff-be99-576b-bd61-91dd215bc98d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465502}] :answer-field/correct {:answer/id #uuid "cb319d62-cd43-5416-b0dd-4e83919c9d00" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465501} :answer-field/id #uuid "34ad56ac-7ece-5f66-8726-bc1880a95996" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466594} {:answer-field/choices [{:answer/id #uuid "c79f8c24-9355-5076-90c6-a4367316d750" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465503} {:answer/id #uuid "0f345692-7fb4-5ba8-be20-f1cb86aeca50" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465504}] :answer-field/correct {:answer/id #uuid "0f345692-7fb4-5ba8-be20-f1cb86aeca50" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465504} :answer-field/id #uuid "5c07de42-afc1-558c-98b8-9dbe9fa265a9" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466595} {:answer-field/choices [{:answer/id #uuid "5ad342ee-39e5-5988-818a-6cf740e323a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465505} {:answer/id #uuid "61e4a967-940f-553b-b00f-ad2e376fcd6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465506}] :answer-field/correct {:answer/id #uuid "61e4a967-940f-553b-b00f-ad2e376fcd6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465506} :answer-field/id #uuid "66e05cae-0986-5eea-b30c-263f052d000a" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466596}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "59d86f24-1bbb-55d7-8154-a7330272c0b1" :question/math-academy-id "q-163779" :question/problem "The quadratic Taylor approximation of the function $f(x)$ about $x=a\\in {R}^{2}$ is given by\n\n$$\nf(x)≈4+\\frac{1}{2}(x-a)^{T}A(x-a),\n$$\n\nwhere \n\n$$\nA=\\begin{bmatrix}5 & 2 \\\\ 2 & 1\\end{bmatrix}.\n$$\n\n \n\nWhich of the following statements are true?\n- **I.** ${a}_{11}=5$ and $det(A)=2$\n- **II.** $A$ is positive-definite\n- **III.** $a$ is a local minimum of $f$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "The point $a\\in {R}^{n}$ is a critical point of the function $f:{R}^{n}\\to R$ if ${f}^{′}(a)={0}^{T}.$ In such cases, we can classify $a$ as follows:\n\n- if ${f}^{″}(a)$ is positive definite, then $a$ is a local minimum\n\n- if ${f}^{″}(a)$ is negative definite, then $a$ is a local maximum\n\n- if ${f}^{″}(a)$ is neither positive-definite nor negative-definite, then $a$ is a saddle point\n\nIn this case, we have $A={f}^{″}(a).$ Now, before we examine the statements, let's recall how to categorize quadratic forms.\n\nLet ${Δ}_{i}$ for $i=1,2,…,n$  denote the leading principal minors of an $n\\times n$ matrix $A.$ Then, according to Sylvester's criterion, the quadratic form ${x}^{T}\\,A\\,x$ (as well as the matrix $A$) is \n\n- positive-definite if and only if ${Δ}_{i}>0$ for all $i=1,2,…,n,$\n\n- negative-definite if and only if, for all $i=1,2,…,n,$ we have ${Δ}_{i}<0$ when $i$ is odd, and ${Δ}_{i}>0$ when $i$ is even.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. Indeed, ${a}_{11}=5,$ but\n\n$$\ndet(A)=|\\begin{aligned}5 & 2 \\\\ 2 & 1\\end{aligned}|=1.\n$$\n\n- Statement II is true. Notice that\n\n$$\n\\begin{aligned}{Δ}_{1} & ={a}_{11}=5>0, \\\\ {Δ}_{2} & =|\\begin{aligned}5 & 2 \\\\ 2 & 1\\end{aligned}|=1>0.\\end{aligned}\n$$\n\nSo, by Sylvester's criterion, the matrix $A$ is positive-definite.\n\n- Statement III is true. Since the matrix $A$ is positive-definite, the critical point $a$ is a local minimum of $f.$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186284419 :knowledge-point/_questions [{:db/id #edb/ref 17592186124570 :knowledge-point/id #uuid "40d58ee6-1121-5ddc-a96f-1a7fa7a193dd" :knowledge-point/title "Classifying Local Extrema Using Sylvester's Criterion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35364fce-dfa4-57e3-b4b3-7ffde26baef4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465507} {:answer/id #uuid "abe81707-7bee-5f3d-9998-a89d0e5199e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465508}] :answer-field/correct {:answer/id #uuid "35364fce-dfa4-57e3-b4b3-7ffde26baef4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465507} :answer-field/id #uuid "a40580c0-664c-5c83-92d6-b7ba6d5f88f8" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466597} {:answer-field/choices [{:answer/id #uuid "2c4f5088-9b18-50ac-a385-00e43fa6bfd3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465509} {:answer/id #uuid "30bdc7e6-fb2d-5f8e-8626-9b6d3ba37448" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465510}] :answer-field/correct {:answer/id #uuid "30bdc7e6-fb2d-5f8e-8626-9b6d3ba37448" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465510} :answer-field/id #uuid "8d4dbc50-2382-5ace-b738-59f70f7581ec" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466598} {:answer-field/choices [{:answer/id #uuid "35500f5f-9589-57c1-b99a-e40289eb9def" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465511} {:answer/id #uuid "fbbd6160-5664-504d-af50-fadc01831e76" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465512}] :answer-field/correct {:answer/id #uuid "35500f5f-9589-57c1-b99a-e40289eb9def" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465511} :answer-field/id #uuid "fb722114-368c-5b3a-8c4c-b807849699e9" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466599}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "03651691-7356-5261-96f0-0d0badb00da3" :question/math-academy-id "q-163780" :question/problem "The quadratic Taylor approximation of the function $f(x)$ about $x=a\\in {R}^{2}$ is given by\n\n$$\nf(x)≈-8+\\frac{1}{2}(x-a)^{T}A(x-a),\n$$\n\nwhere \n\n$$\nA=\\begin{bmatrix}-1 & 2 \\\\ 2 & -6\\end{bmatrix}.\n$$\n\n \n\nWhich of the following statements are true?\n- **I.** ${a}_{11}=-1$ and $det(A)=4$\n- **II.** $A$ is negative-definite\n- **III.** $a$ is a local minimum of $f$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "The point $a\\in {R}^{n}$ is a critical point of the function $f:{R}^{n}\\to R$ if ${f}^{′}(a)={0}^{T}.$ In such cases, we can classify $a$ as follows:\n\n- if ${f}^{″}(a)$ is positive definite, then $a$ is a local minimum\n\n- if ${f}^{″}(a)$ is negative definite, then $a$ is a local maximum\n\n- if ${f}^{″}(a)$ is neither positive-definite nor negative-definite, then $a$ is a saddle point\n\nIn this case, we have $A={f}^{″}(a).$ Now, before we examine the statements, let's recall how to categorize quadratic forms.\n\nLet ${Δ}_{i}$ for $i=1,2,…,n$  denote the leading principal minors of an $n\\times n$ matrix $A.$ Then, according to Sylvester's criterion, the quadratic form ${x}^{T}\\,A\\,x$ (as well as the matrix $A$) is \n\n- positive-definite if and only if ${Δ}_{i}>0$ for all $i=1,2,…,n,$\n\n- negative-definite if and only if, for all $i=1,2,…,n,$ we have ${Δ}_{i}<0$ when $i$ is odd, and ${Δ}_{i}>0$ when $i$ is even.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. Indeed, ${a}_{11}=-1,$ but\n\n$$\ndet(A)=|\\begin{aligned}-1 & 2 \\\\ 2 & -6\\end{aligned}|=2.\n$$\n\n- Statement II is true. Notice that\n\n$$\n\\begin{aligned}{Δ}_{1} & ={a}_{11}=-1<0, \\\\ {Δ}_{2} & =|\\begin{aligned}-1 & 2 \\\\ 2 & -6\\end{aligned}|=2>0.\\end{aligned}\n$$\n\nSo, by Sylvester's criterion, the matrix $A$ is negative-definite.\n\n- Statement III is false. Since the matrix $A$ is negative-definite, the critical point $a$ is a local maximum of $f.$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186434754 :knowledge-point/_questions [{:db/id #edb/ref 17592186124570 :knowledge-point/id #uuid "40d58ee6-1121-5ddc-a96f-1a7fa7a193dd" :knowledge-point/title "Classifying Local Extrema Using Sylvester's Criterion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7112c714-4962-5b16-8f8d-765d0369b202" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474460} {:answer/id #uuid "7adf6cf4-eabd-52b6-b653-73e0cbfd7368" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474461}] :answer-field/correct {:answer/id #uuid "7adf6cf4-eabd-52b6-b653-73e0cbfd7368" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474461} :answer-field/id #uuid "bd78636a-3835-5942-a3fd-7e0ee14f45cb" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475156} {:answer-field/choices [{:answer/id #uuid "c6df957d-bb38-5c53-b163-e6870f5cb3b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474462} {:answer/id #uuid "91041c6e-f542-5d01-8196-02c9d9d65543" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474463}] :answer-field/correct {:answer/id #uuid "c6df957d-bb38-5c53-b163-e6870f5cb3b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474462} :answer-field/id #uuid "aa8eed09-27d9-5e21-8524-a1932ae87109" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475157} {:answer-field/choices [{:answer/id #uuid "fb30a766-7900-5d50-86d5-89016ad059f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474464} {:answer/id #uuid "02928f92-aad5-5cb3-9006-996e38c094f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474465}] :answer-field/correct {:answer/id #uuid "02928f92-aad5-5cb3-9006-996e38c094f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474465} :answer-field/id #uuid "76d43ab0-6331-5687-9312-3d01a7f01c93" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475158}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5ec0f059-837e-5e3d-9bb4-8d292f2af4e9" :question/math-academy-id "q-163781" :question/problem "The quadratic Taylor approximation of the function $f(x)$ about $x=a\\in {R}^{2}$ is given by\n\n$$\nf(x)≈5+\\frac{1}{2}(x-a)^{T}A(x-a),\n$$\n\nwhere \n\n$$\nA=\\begin{bmatrix}-3 & -1 \\\\ -1 & -3\\end{bmatrix}.\n$$\n\n \n\nWhich of the following statements are true?\n\nI. ${a}_{11}=-3$ and $det(A)=8$\n\nII. $A$ is neither positive-definite nor negative-definite\n\nIII. $a$ is a local maximum of $f$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "The point $a\\in {R}^{n}$ is a critical point of the function $f:{R}^{n}\\to R$ if ${f}^{′}(a)={0}^{T}.$ In such cases, we can classify $a$ as follows:\n\n- if ${f}^{″}(a)$ is positive definite, then $a$ is a local minimum\n\n- if ${f}^{″}(a)$ is negative definite, then $a$ is a local maximum\n\n- if ${f}^{″}(a)$ is neither positive-definite nor negative-definite, then $a$ is a saddle point\n\nIn this case, we have $A={f}^{″}(a).$ Now, before we examine the statements, let's recall how to categorize quadratic forms.\n\nLet ${Δ}_{i}$ for $i=1,2,…,n$  denote the leading principal minors of an $n\\times n$ matrix $A.$ Then, according to Sylvester's criterion, the quadratic form ${x}^{T}\\,A\\,x$ (as well as the matrix $A$) is \n\n- positive-definite if and only if ${Δ}_{i}>0$ for all $i=1,2,…,n,$\n\n- negative-definite if and only if, for all $i=1,2,…,n,$ we have ${Δ}_{i}<0$ when $i$ is odd, and ${Δ}_{i}>0$ when $i$ is even.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Indeed, ${a}_{11}=-3$ and\n\n$$\ndet(A)=|\\begin{aligned}-3 & -1 \\\\ -1 & -3\\end{aligned}|=8.\n$$\n\n- Statement II is false. Notice that\n\n$$\n\\begin{aligned}{Δ}_{1} & ={a}_{11}=-3<0, \\\\ {Δ}_{2} & =|\\begin{aligned}-3 & -1 \\\\ -1 & -3\\end{aligned}|=8>0.\\end{aligned}\n$$\n\nSo, by Sylvester's criterion, the matrix $A$ is negative-definite.\n\n- Statement III is true. Since the matrix $A$ is negative-definite, the critical point $a$ is a local maximum of $f.$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186284421 :knowledge-point/_questions [{:db/id #edb/ref 17592186124648 :knowledge-point/id #uuid "233eab4c-ab17-53a8-ae03-f6f28ac78922" :knowledge-point/title "Classifying Local Extrema Using Eigenvalues"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ea10e1f-ce81-5b81-a050-f67d321d8e92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "local maximum" :db/id #edb/ref 17592186281817} {:answer/id #uuid "23775611-5ec1-536e-a368-f7631073efb7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "saddle point" :db/id #edb/ref 17592186282003} {:answer/id #uuid "34a1b032-0917-5bc2-9368-443a9efff873" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "local minimum" :db/id #edb/ref 17592186282157} {:answer/id #uuid "7b0ae5cd-372a-5f03-ba28-d378c3c5fd4e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "inconclusive" :db/id #edb/ref 17592186282745} {:answer/id #uuid "955fea63-7ba6-5578-af41-a7a1228d5dc6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "not a critical point" :db/id #edb/ref 17592186282978}] :answer-field/correct {:answer/id #uuid "0ea10e1f-ce81-5b81-a050-f67d321d8e92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "local maximum" :db/id #edb/ref 17592186281817} :answer-field/id #uuid "c7c9e8aa-d1c7-5a2a-96d1-342a8e10e7d6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284288}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c58156b9-c2e5-56d6-934d-438ab8169ee9" :question/math-academy-id "q-163784" :question/problem "The quadratic Taylor approximation of the function $f(x)$ about $x=a\\in {R}^{3}$ is given by\n\n$$\nf(x)≈6+\\frac{1}{2}(x-a)^{T}\\begin{bmatrix}-2 & 1 & 0 \\\\ 1 & -2 & -1 \\\\ 0 & -1 & -2\\end{bmatrix}(x-a).\n$$\n\nGiven that the eigenvalues of ${f}^{″}(a)$ are ${\\lambda }_{1}=-2,{\\lambda }_{2}=-2-\\sqrt{2}$ and ${\\lambda }_{3}=-2+\\sqrt{2},$ what type of point is $a?$" :question/worked-solution "The point $a\\in {R}^{n}$ is a critical point of the function $f:{R}^{n}\\to R$ if ${f}^{′}(a)={0}^{T}.$ In such cases, we can classify $a$ as follows:\n\n- if ${f}^{″}(a)$ is positive definite, then $a$ is a local minimum\n\n- if ${f}^{″}(a)$ is negative definite, then $a$ is a local maximum\n\n- if ${f}^{″}(a)$ is neither positive-definite nor negative-definite, then $a$ is a saddle point\n\nThe quadratic Taylor expansion of a function $f:{R}^{n}\\to R$ about $x=a\\in {R}^{n}$ given by\n\n$$\nf(x)≈f(a)+{f}^{′}(a)(x-a)+\\frac{1}{2}(x-a)^{T}{f}^{″}(a)(x-a).\n$$\n\nSince the quadratic Taylor expansion of $f$ has no $(x-a)$ term, we can conclude that ${f}^{′}(a)={0}^{T}.$ Hence, $a$ is a critical point of $f.$\n\nFinally, notice that all the eigenvalues of ${f}^{″}(a)$ are negative:\n\n$$\n\\begin{aligned}{\\lambda }_{1} & =-2<0 \\\\ {\\lambda }_{2} & =-2-\\sqrt{2}<0 \\\\ {\\lambda }_{3} & =-2+\\sqrt{2}<0\\end{aligned}\n$$\n\nSo, the matrix is negative definite. Therefore, $a$ is a local maximum of $f.$"}] [{:db/id #edb/ref 17592186434764 :knowledge-point/_questions [{:db/id #edb/ref 17592186124570 :knowledge-point/id #uuid "40d58ee6-1121-5ddc-a96f-1a7fa7a193dd" :knowledge-point/title "Classifying Local Extrema Using Sylvester's Criterion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cde007a9-b0f6-57f6-b8c8-569dc617a887" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474472} {:answer/id #uuid "14c4e553-7773-5d04-9993-af7dbd1b9557" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474473}] :answer-field/correct {:answer/id #uuid "cde007a9-b0f6-57f6-b8c8-569dc617a887" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474472} :answer-field/id #uuid "e1bb8b62-465b-5b82-ba1a-9d8aa323116d" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475162} {:answer-field/choices [{:answer/id #uuid "9de572aa-0428-548c-97f5-19930fcda97b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474474} {:answer/id #uuid "ce46449c-5f4c-5219-ada2-0e7076d87668" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474475}] :answer-field/correct {:answer/id #uuid "9de572aa-0428-548c-97f5-19930fcda97b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474474} :answer-field/id #uuid "a6b0b738-bbb1-59b2-9af2-7625e85552c1" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475163} {:answer-field/choices [{:answer/id #uuid "5c962c53-221d-56e5-a7ba-4a50b74f26e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474476} {:answer/id #uuid "10fdc2c8-4482-572b-a145-9384b2579ab1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474477}] :answer-field/correct {:answer/id #uuid "5c962c53-221d-56e5-a7ba-4a50b74f26e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474476} :answer-field/id #uuid "28245267-c604-5f8b-af0e-e69a56ca6fbc" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475164}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e5518b1c-8ee2-55b4-900e-3e5d5d3b8c0e" :question/math-academy-id "q-163788" :question/problem "The quadratic Taylor approximation of the function $f(x)$ about $x=a\\in {R}^{3}$ is given by\n\n$$\nf(x)≈1+\\frac{1}{2}(x-a)^{T}A(x-a),\n$$\n\nwhere \n\n$$\nA=\\begin{bmatrix}-1 & 4 & 2 \\\\ 4 & 3 & 0 \\\\ 2 & 0 & 1\\end{bmatrix}.\n$$\n\n \n\nWhich of the following statements are true?\n\nI. ${a}_{11}=-1$ and $det(A)=-15$\n\nII. $A$ is negative-definite\n\nIII. $a$ is a local minimum of $f$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "The point $a\\in {R}^{n}$ is a critical point of the function $f:{R}^{n}\\to R$ if ${f}^{′}(a)={0}^{T}.$ In such cases, we can classify $a$ as follows:\n\n- if ${f}^{″}(a)$ is positive definite, then $a$ is a local minimum\n\n- if ${f}^{″}(a)$ is negative definite, then $a$ is a local maximum\n\n- if ${f}^{″}(a)$ is neither positive-definite nor negative-definite, then $a$ is a saddle point\n\nIn this case, we have $A={f}^{″}(a).$ Now, before we examine the statements, we recall how to categorize quadratic forms.\n\nLet ${Δ}_{i}$ for $i=1,2,…,n$  denote the leading principal minors of an $n\\times n$ matrix $A.$ Then, according to Sylvester's criterion, the quadratic form ${x}^{T}\\,A\\,x$ (as well as the matrix $A$) is \n\n- positive-definite if and only if ${Δ}_{i}>0$ for all $i=1,2,…,n,$\n\n- negative-definite if and only if, for all $i=1,2,…,n,$ we have ${Δ}_{i}<0$ when $i$ is odd, and ${Δ}_{i}>0$ when $i$ is even.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. Indeed, ${a}_{11}=-1,$ but\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}-1 & 4 & 2 \\\\ 4 & 3 & 0 \\\\ 2 & 0 & 1\\end{aligned}| \\\\  & =-1\\cdot |\\begin{aligned}3 & 0 \\\\ 0 & 1\\end{aligned}|-4\\cdot |\\begin{aligned}4 & 0 \\\\ 2 & 1\\end{aligned}|+2\\cdot |\\begin{aligned}4 & 3 \\\\ 2 & 0\\end{aligned}| \\\\  & =-1(3)-4(4)+2(-6) \\\\  & =-31.\\end{aligned}\n$$\n\n- Statement II is false. Notice the following:\n\n$$\n\\begin{aligned}{Δ}_{1} & ={a}_{11}=-1<0 \\\\ {Δ}_{2} & =|\\begin{aligned}-1 & 4 \\\\ 4 & 3\\end{aligned}|=-19<0 \\\\ {Δ}_{3} & =|A|=-31<0\\end{aligned}\n$$\n\nSo, by Sylvester's criterion, the matrix $A$ is neither positive-definite nor negative-definite.\n\n- Statement III is false. Since the matrix $A$ is neither positive-definite nor negative-definite, the critical point $a$ is a saddle point of $f.$\n\nTherefore, the correct answer is \"None of the statements are true.\""}] [{:db/id #edb/ref 17592186433378 :knowledge-point/_questions [{:db/id #edb/ref 17592186124646 :knowledge-point/id #uuid "3ee9cbe8-ad40-5155-b42d-1802f36adf27" :knowledge-point/title "Identifying the Global Extrema of a Multivariable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c750366-87fd-5df1-9550-7377df9d1451" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(1,0,-1)$ only" :db/id #edb/ref 17592186433354} {:answer/id #uuid "48052d29-4422-5f9a-b0b0-95c416d880f9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-1,2,-2.5)$ and $(1,0,-1)$" :db/id #edb/ref 17592186433357} {:answer/id #uuid "981d803b-2b71-589c-9dd7-89b262f35507" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(1,0,-1)$ and $(2,-3,0)$" :db/id #edb/ref 17592186433362} {:answer/id #uuid "c1664007-041b-58fe-aa78-e1585e47911c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-1,2,-2.5)$ only" :db/id #edb/ref 17592186433365} {:answer/id #uuid "eedfc3db-8fe3-54f8-8907-da861cf5c513" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-1,2,-2.5)$ and $(-1,-2,2)$" :db/id #edb/ref 17592186433371}] :answer-field/correct {:answer/id #uuid "c1664007-041b-58fe-aa78-e1585e47911c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-1,2,-2.5)$ only" :db/id #edb/ref 17592186433365} :answer-field/id #uuid "7e92c66f-883a-5be4-b481-34094dc1948a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186433375}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5ccb6a2f-baf3-5789-838a-0e294ce49920" :question/math-academy-id "q-163794" :question/problem "![](images/f8/f82404522255a2e5b8be8b45d39062bd2239c15294024c02d6d4ad3dd3f44809.png)\n\nThe graph $z=f(x,y)$ is shown above. What are the global minimum points of the function?" :question/worked-solution "First, we recall the following definitions:\n\n- The global minimum of a function is the smallest value it attains on its domain. There can only be (at most) one global minimum.\n\n- A global minimum point is a point $(x,y,z)$ where a function reaches a global minimum. There can be zero, one, or many global minimum points.\n\nFor our function, the minimum value reached by the function is $f(x,y)=-2.5.$ Therefore, the global minimum is $-2.5.$ The function reaches this value when $(x,y)=(-1,2),$ so the global minimum point is $(-1,2,-2.5).$\n\n![](images/29/29d2b703b9c17aa69bb41076e4bf40f509af4b44bd3ade14dbdeaec7cad25120.png)"}] [{:db/id #edb/ref 17592186433379 :knowledge-point/_questions [{:db/id #edb/ref 17592186124646 :knowledge-point/id #uuid "3ee9cbe8-ad40-5155-b42d-1802f36adf27" :knowledge-point/title "Identifying the Global Extrema of a Multivariable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "67ace240-ec76-51a3-9237-34363ff229dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(2,-3,0)$ only" :db/id #edb/ref 17592186433358} {:answer/id #uuid "7c661f49-8f75-57c0-807f-bf1886abf88e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-1,2,-2.5)$ only" :db/id #edb/ref 17592186433359} {:answer/id #uuid "927103a8-b10f-5218-a094-fe0cd4985992" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(1,0,1)$ and $(0,2,0)$" :db/id #edb/ref 17592186433360} {:answer/id #uuid "cfc9d090-f059-5d47-bb5f-8ea074628146" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-1,-2,1)$ and $(1,0,1)$" :db/id #edb/ref 17592186433367} {:answer/id #uuid "f027110e-c325-53d5-8b9d-70300263dd44" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-1,-2,1)$ only" :db/id #edb/ref 17592186433372}] :answer-field/correct {:answer/id #uuid "cfc9d090-f059-5d47-bb5f-8ea074628146" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-1,-2,1)$ and $(1,0,1)$" :db/id #edb/ref 17592186433367} :answer-field/id #uuid "8390ddee-9042-5713-b922-461ba822e40f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186433376}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6e0f0650-f17e-5833-8166-da3fd9367f23" :question/math-academy-id "q-163795" :question/problem "![](images/a3/a39696fcb202485b9a58839609ad807e43397fde8df965bed2824f6cdc307703.png)\n\nThe graph $z=f(x,y)$ is shown above. What are the global maximum points of the function?" :question/worked-solution "First, we recall the following definitions:\n\n- The global maximum of a function is the largest value it attains on its domain. There can only be (at most) one global maximum.\n\n- A global maximum point is a point $(x,y,z)$ where a function reaches a global maximum. There can be zero, one, or many global maximum points.\n\nFor our function, the maximum value reached by the function is $f(x,y)=1.$ Therefore, the global maximum is $1.$ The function reaches this value when $(x,y)=(-1,-2)$ and  $(x,y)=(1,0),$so the global maximum points are $(-1,-2,1)$ and $(1,0,1).$\n\n![](images/4a/4a818d3e3e3c6c6a90ff9e69d808803016114894fbc605de5d21c75817eb8cf3.png)"}] [{:db/id #edb/ref 17592186433377 :knowledge-point/_questions [{:db/id #edb/ref 17592186124646 :knowledge-point/id #uuid "3ee9cbe8-ad40-5155-b42d-1802f36adf27" :knowledge-point/title "Identifying the Global Extrema of a Multivariable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "085288bf-eb67-57c6-970e-1441a16de2cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186433353} {:answer/id #uuid "9386da2e-bffa-5ff6-8d56-e057722ac26a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186433361} {:answer/id #uuid "9f6602ae-1519-5c89-b578-5c145b71a62c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186433364} {:answer/id #uuid "d0f6b593-67bc-5463-aa65-5339463d43d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186433368} {:answer/id #uuid "e5115eb5-3e95-5d74-b63f-765192f9ac7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186433370}] :answer-field/correct {:answer/id #uuid "9386da2e-bffa-5ff6-8d56-e057722ac26a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186433361} :answer-field/id #uuid "17c926bd-dbcb-5faf-8bf3-0aee7298ed52" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186433373}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "05d8ae1c-da42-5a43-aa56-47e108152b59" :question/math-academy-id "q-163836" :question/problem "![](images/76/76cbc53a671cb7164352b2c71931379a6dab936a966ded05dc93ba31da013dfe.png)\n\nThe graph of the function $z=f(x,y)$ is shown above.\nWhat is the global minimum of the function?" :question/worked-solution "First, we recall the following definitions:\n\n- The global minimum of a function is the smallest value it attains on its domain. There can only be (at most) one global minimum.\n\n- A global minimum point is a point $(x,y,z)$ where a function reaches a global minimum. There can be zero, one, or many global minimum points.\n\nFor our function, the minimum value reached by the function is $f(x,y)=-4.$ Therefore, the global minimum is $-4.$ The function reaches this value at both $(x,y)=(-3,-6)$ and $(x,y)=(-3,6).$\n\n![](images/78/78348020535973cddc75c2d935c0ed2f0390b5330b4139105be80cb8f6e6032a.png)"}] [{:db/id #edb/ref 17592186398583 :knowledge-point/_questions [{:db/id #edb/ref 17592186124646 :knowledge-point/id #uuid "3ee9cbe8-ad40-5155-b42d-1802f36adf27" :knowledge-point/title "Identifying the Global Extrema of a Multivariable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43d7fcb0-ff70-592c-ad54-21abfd7d0ab1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186398585} {:answer/id #uuid "b69485bc-fe91-5715-a1be-f3a4cae4eec7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186398586} {:answer/id #uuid "0fd4e3aa-8ad0-50a4-8f3f-5869b4c7e1f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186398587} {:answer/id #uuid "5b5ce768-561a-530a-b18b-d90e38f2f278" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186398588} {:answer/id #uuid "1d2fdced-3009-5582-9920-2ae6deb17073" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186398589}] :answer-field/correct {:answer/id #uuid "b69485bc-fe91-5715-a1be-f3a4cae4eec7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186398586} :answer-field/id #uuid "ea34e434-1d65-55e5-98c8-c4dc723100a6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398584}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7c94f5db-a52d-5269-9d70-48b35e30ba08" :question/math-academy-id "q-163839" :question/problem "![](images/b9/b99ff5d9d55de34b2cb3e2176e7c4171a5583e1e010626796c3ca2f9d9ed29cb.png)\n\nThe graph of the function $z=f(x,y)$ is shown above.\nWhat is the global maximum of the function?" :question/worked-solution "First, we recall the following definitions:\n\n- The global maximum of a function is the largest value it attains on its domain. There can only be (at most) one global maximum.\n\n- A global maximum point is a point $(x,y,z)$ where a function reaches a global maximum. There can be zero, one, or many global maximum points.\n\nFor our function, the maximum value reached by the function is $f(x,y)=10.$ Therefore, the global maximum is $10.$ The function reaches this value at both $(x,y)=(2,4)$ and $(x,y)=(-4,4).$\n\n![](images/bf/bf82159ccb39f6c07fa870abe04911847dcbb240bd1cf5e6be8a1216fa9cf327.png)"}] [{:db/id #edb/ref 17592186434756 :knowledge-point/_questions [{:db/id #edb/ref 17592186124647 :knowledge-point/id #uuid "f0fb118f-c1cc-51fd-a8cc-c29cf705acfe" :knowledge-point/title "Identifying the Local Extrema of a Multivariable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d6a8563-51e7-5f75-b1f9-5030c16e40a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186434680} {:answer/id #uuid "671887d0-2723-5a15-b0f2-b1adf3728767" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $D$ only" :db/id #edb/ref 17592186434684} {:answer/id #uuid "7eb013d8-4bec-59b6-be78-16c6b4278be3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The function does not have local minima" :db/id #edb/ref 17592186434688} {:answer/id #uuid "7ec46caa-3ab4-5a82-8cef-51349b889f2b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186434689} {:answer/id #uuid "c579e011-3bca-5b23-92a7-a4c2a45142bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ and $D$ only" :db/id #edb/ref 17592186434716}] :answer-field/correct {:answer/id #uuid "671887d0-2723-5a15-b0f2-b1adf3728767" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $D$ only" :db/id #edb/ref 17592186434684} :answer-field/id #uuid "caaf0180-b775-51a5-8357-5dbad212c145" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186434747}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "73e92678-31f3-525b-9096-a06391739cab" :question/math-academy-id "q-164151" :question/problem "![](images/f7/f7429a2fc291fc9e14685208288f670cca341a260ac13b358c52d99c35e13b4f.png)\n\nThe graph of the function $z=f(x,y)$ is shown above. Which of the points shown are local minimum points?" :question/worked-solution "A function $f(x,y)$ has a local minimum point at $(a,b)$ if $f(x,y)\\ge f(a,b)$ for all points $(x,y)$ in a neighborhood of $(a,b).$ \n\nIn other words, we can take a neighborhood of $(x,y)$-values such that the point $(x,y,f(x,y))$ is the lowest point on the graph in the neighborhood.\n\nSuch neighborhoods exist for the points $A$ and $D.$ Hence, $A$ and $D$ are local minima.\n\n![](images/b8/b8952aa59c9351c9723cd62f35073d46d7ddfd46afa9a9b3ddae7ce149065c59.png)"}] [{:db/id #edb/ref 17592186434765 :knowledge-point/_questions [{:db/id #edb/ref 17592186124647 :knowledge-point/id #uuid "f0fb118f-c1cc-51fd-a8cc-c29cf705acfe" :knowledge-point/title "Identifying the Local Extrema of a Multivariable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d2ed7970-c91d-530d-87fb-03e1fc291d9e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474486} {:answer/id #uuid "52389b06-e83f-5f07-9c86-b7f3c04bb2a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474487}] :answer-field/correct {:answer/id #uuid "52389b06-e83f-5f07-9c86-b7f3c04bb2a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474487} :answer-field/id #uuid "281f1737-8cd3-52cc-ae48-0993e11a43bf" :answer-field/key "A" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475169} {:answer-field/choices [{:answer/id #uuid "3156a58d-b483-59fd-9f91-1d10785ec8d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474488} {:answer/id #uuid "078d28af-2871-5922-a2ea-7506be3a26c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474489}] :answer-field/correct {:answer/id #u