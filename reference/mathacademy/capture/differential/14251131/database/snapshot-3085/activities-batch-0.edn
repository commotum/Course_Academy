#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186120618} :activity/id #uuid "3366a432-0200-5657-84c5-2f4c70949b50" :activity/scope {:db/id #edb/ref 17592186050283 :topic/id #uuid "3cb2a10b-5d06-5efe-b222-3c14b0ccd7c8" :topic/math-academy-id 1777} :activity/steps [{:db/id #edb/ref 17592186120618 :step/content {:db/id #edb/ref 17592186121017 :tutorial/content "Recall that a matrix is square if the number of rows equals the number of columns. There are other types of square matrices with special names.\n\n- An **upper triangular** matrix is a square matrix in which all entries *below* the diagonal are zeros. For example, the following matrices are all upper triangular matrices:\n\n$$\n\\begin{bmatrix}1 & -3 \\\\ 0 & 2\\end{bmatrix}\n$$\n\nNote that we can have any number (including $0$) on the diagonal and above.\n\n- A **lower triangular** matrix is a square matrix in which all entries *above* the diagonal are zeros. For example, the following matrices are all lower triangular matrices:\n\n$$\n\\begin{bmatrix}1 & 0 \\\\ 3 & 1\\end{bmatrix}\n$$\n\nAgain, note that we can have any number (including $0$) on the diagonal and below." :tutorial/id #uuid "658a47dc-4d32-5d9d-a04c-82d683e87739" :tutorial/math-academy-id 2983 :tutorial/title "Introduction"} :step/id #uuid "0875c7e7-20f2-5b83-a1f5-9093d3858f8f" :step/math-academy-id 16111 :step/next {:db/id #edb/ref 17592186120619}} {:db/id #edb/ref 17592186120619 :step/content {:db/id #edb/ref 17592186119771 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119585 :question/id #uuid "fe3edf12-af5b-5bb0-b5b3-efb6cd809134" :question/math-academy-id "e-4394"} :knowledge-point/id #uuid "1cca9b7c-358a-5f62-9a53-a696df0dd0ff" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048252}] :knowledge-point/question-generator {:db/id #edb/ref 17592186487484} :knowledge-point/questions [{:db/id #edb/ref 17592186120120} {:db/id #edb/ref 17592186120121} {:db/id #edb/ref 17592186262602} {:d