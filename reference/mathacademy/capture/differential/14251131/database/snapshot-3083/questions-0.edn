r/value "false" :db/id #edb/ref 17592186438458} {:answer/id #uuid "179fafc0-1ae3-5917-a9f8-eae561e2b95b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438459}] :answer-field/correct {:answer/id #uuid "179fafc0-1ae3-5917-a9f8-eae561e2b95b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438459} :answer-field/id #uuid "d0b333bd-888b-5051-81d0-d4f153ba848c" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439258}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "deb97145-eaf3-5dcc-a36b-24fae2c52b5c" :question/math-academy-id "q-68754" :question/problem "Consider the matrix \n$A=\\begin{bmatrix}0 & -2 & -7 \\\\ 2 & -1 & 8 \\\\ 7 & -8 & 1\\end{bmatrix}.$\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $A$ is upper triangular\n- **II.** $A$ is lower triangular\n- **III.** $A+{A}^{T}$ is upper triangular" :question/worked-solution "Let's analyze each statement in turn.\n\n- Statement I is false, since $A$ has non-zero entries below the main diagonal:\n\n$$\nA=\\begin{bmatrix}0 & -2 & -7 \\\\ 2 & -1 & 8 \\\\ 7 & -8 & 1\\end{bmatrix}\n$$\n\n- Statement II is false, since $A$ has non-zero entries above the main diagonal:\n\n$$\nA=\\begin{bmatrix}0 & -2 & -7 \\\\ 2 & -1 & 8 \\\\ 7 & -8 & 1\\end{bmatrix}\n$$\n\n- Statement III is true, since the result of $A+{A}^{T}$ has all the entries below the main diagonal equal to zero:\n\n$$\nA+{A}^{T}=\\begin{bmatrix}0 & 0 & 0 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & 2\\end{bmatrix}\n$$\n\nTherefore, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186398975 :knowledge-point/_questions [{:db/id #edb/ref 17592186119772 :knowledge-point/id #uuid "b55b50a0-034f-57c0-8a61-883cfb0412dc" :knowledge-point/title "Identifying a Triangular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d64405d0-289f-509a-b6c2-4ddc819a550c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "C=\\begin{bmatrix}0 & 1 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186398977} {:answer/id #uuid "21195042-f7c2-5911-a358-864f5699c6dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}2 & -3 \\\\ 0 & 3\\end{bmatrix}" :db/id #edb/ref 17592186398978} {:answer/id #uuid "daa40cbf-4d3b-590b-81d0-b66a0577167e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A=\\begin{bmatrix}0 & 0 & 1 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 3\\end{bmatrix}" :db/id #edb/ref 17592186398979} {:answer/id #uuid "4b82a1dd-a8a6-5b78-82c9-fa1f39c4845b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "E=\\begin{bmatrix}0 & -4 & 0 \\\\ 5 & 0 & -7 \\\\ 1 & 2 & 0\\end{bmatrix}" :db/id #edb/ref 17592186398980} {:answer/id #uuid "7585a86b-d9f0-55bc-8e6f-efb92e7d43c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\begin{bmatrix}0 & 0 & 0 \\\\ 2 & 5 & 0 \\\\ 1 & 4 & 3\\end{bmatrix}" :db/id #edb/ref 17592186398981}] :answer-field/correct {:answer/id #uuid "7585a86b-d9f0-55bc-8e6f-efb92e7d43c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\begin{bmatrix}0 & 0 & 0 \\\\ 2 & 5 & 0 \\\\ 1 & 4 & 3\\end{bmatrix}" :db/id #edb/ref 17592186398981} :answer-field/id #uuid "29184956-f54b-5670-ad89-7254d448c06c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398976}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9af406e1-4ead-558e-9219-f0bb53a377fc" :question/math-academy-id "q-74316" :question/problem "Which of the following is a lower triangular matrix?" :question/worked-solution "Notice that $B$ is a matrix for which all entries *above* the diagonal are $0$'s:\n\n$$\nB=\\begin{bmatrix}0 & 0 & 0 \\\\ 2 & 5 & 0 \\\\ 1 & 4 & 3\\end{bmatrix}\n$$\n\nHence, it is a lower triangular matrix. \n\nBy contrast, matrices $A$, $C$, $D$, and $E$ each have at least one non-zero entry above the diagonal:\n\n$$\nA=\\begin{bmatrix}0 & 0 & 1 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 3\\end{bmatrix},\\,C=\\begin{bmatrix}0 & 1 \\\\ 0 & 0\\end{bmatrix},\\,D=\\begin{bmatrix}2 & -3 \\\\ 0 & 3\\end{bmatrix},\\,E=\\begin{bmatrix}0 & -4 & 0 \\\\ 5 & 0 & -7 \\\\ 1 & 2 & 0\\end{bmatrix}.\n$$\n\nSo, they are not lower triangular matrices."}] [{:db/id #edb/ref 17592186342195 :knowledge-point/_questions [{:db/id #edb/ref 17592186119784 :knowledge-point/id #uuid "e69a4aee-6e92-598b-99b5-1d830b6dea54" :knowledge-point/title "Identifying Correct Statements About a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31f0fe91-c16f-5c88-98c3-6c20947ef352" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438508} {:answer/id #uuid "e7ecd97a-ece8-52f9-9c37-9224155d587f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438509}] :answer-field/correct {:answer/id #uuid "31f0fe91-c16f-5c88-98c3-6c20947ef352" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438508} :answer-field/id #uuid "2f499a2d-45d0-590b-973b-c8d0cb52b220" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439283} {:answer-field/choices [{:answer/id #uuid "128b04a8-57bd-5b61-874d-aac65e3e9c51" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438510} {:answer/id #uuid "a75398e2-65af-5bac-