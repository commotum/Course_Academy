[{"source" ":org/Math-Academy" "forms" [[:db/retract 17592186121559 :answer-field/choices 17592186121560] [:db/retract 17592186121559 :answer-field/choices 17592186121561] [:db/retract 17592186121559 :answer-field/choices 17592186121562] [:db/retract 17592186121559 :answer-field/choices 17592186121563] [:db/retract 17592186124883 :question/answer-fields 17592186121898] [:db/retract 17592186378921 :answer-field/choices 17592186378922] [:db/retract 17592186378921 :answer-field/choices 17592186378924] [:db/retract 17592186378921 :answer-field/choices 17592186378925] [:db/retract 17592186378921 :answer-field/choices 17592186378926] [:db/retract 17592186284252 :answer-field/choices 17592186282994] [:db/retract 17592186284252 :answer-field/choices 17592186282739] [:db/retract 17592186284252 :answer-field/choices 17592186283613] [:db/retract 17592186284252 :answer-field/choices 17592186282735] [:db/retract 17592186408093 :answer-field/choices 17592186408083] [:db/retract 17592186408093 :answer-field/choices 17592186408084] [:db/retract 17592186408093 :answer-field/choices 17592186408087] [:db/retract 17592186408093 :answer-field/choices 17592186408092] [:db/retract 17592186323405 :answer-field/choices 17592186323104] [:db/retract 17592186323405 :answer-field/choices 17592186321333] [:db/retract 17592186323405 :answer-field/choices 17592186322296] [:db/retract 17592186323405 :answer-field/choices 17592186322511] {:db/id 17592186124650 :knowledge-point/questions ["question-e6548717-af2d-5bfc-9298-8a16a46973b2"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124555 :knowledge-point/questions ["question-1a64d7fd-d80f-53bd-910a-60419647eb47"] :db/ensure [:knowledge-point/validate]} {:db/id "question-e6548717-af2d-5bfc-9298-8a16a46973b2" :question/id #uuid "e6548717-af2d-5bfc-9298-8a16a46973b2" :question/math-academy-id "q-71858" :question/problem "Given the hyperboloid of one sheet $\\frac{(x-2)^{2}}{4}+\\frac{(y-2)^{2}}{4}-\\frac{(z-3)^{2}}{9}=1$, find its $y$-intercepts." :question/worked-solution "To find the $y$-intercepts, we plug $x=0$ and $z=0$ into the equation: \n\n$$\n\\begin{aligned}\\frac{(0-2)^{2}}{4}+\\frac{(y-2)^{2}}{4}-\\frac{(0-3)^{2}}{9} & =1 \\\\ 1+\\frac{(y-2)^{2}}{4}-1 & =1 \\\\ \\frac{(y-2)^{2}}{4} & =1 \\\\ (y-2)^{2} & =4 \\\\ y-2 & =\\pm \\sqrt{4} \\\\ y & =2\\pm 2\\end{aligned}\n$$\n\nHence, we get the solutions $y=0$ and $y=4.$\n\nTherefore, the intercepts with the $y$-axis are $(0,0,0)$ and $(0,4,0).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d7d6da6e-d2bc-559d-a654-e2becdcb61da"] :db/ensure [:question/validate]} {:db/id "answer-field-d7d6da6e-d2bc-559d-a654-e2becdcb61da" :answer-field/id #uuid "d7d6da6e-d2bc-559d-a654-e2becdcb61da" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9dd75581-e364-58bb-8ecc-8010b1071f10" :answer-field/choices ["answer-0b05d521-7d63-5960-a052-63edd7b8a9ff" "answer-e636de43-6150-50b8-95ab-2fe05095f1c9" "answer-a8ecfd2c-d21c-5bab-9bca-e9ac877257e6" "answer-5726b996-61c1-520e-b808-c1131fdf41b0" "answer-9dd75581-e364-58bb-8ecc-8010b1071f10"] :db/ensure [:answer-field/validate]} {:db/id "answer-0b05d521-7d63-5960-a052-63edd7b8a9ff" :answer/id #uuid "0b05d521-7d63-5960-a052-63edd7b8a9ff" :answer/type :answer.type/text :answer/value "$(0,-1,0)$ and $(0,3,0)$" :db/ensure [:answer/validate]} {:db/id "answer-e636de43-6150-50b8-95ab-2fe05095f1c9" :answer/id #uuid "e636de43-6150-50b8-95ab-2fe05095f1c9" :answer/type :answer.type/text :answer/value "$(0,-2,0)$ and $(0,2,0)$" :db/ensure [:answer/validate]} {:db/id "answer-a8ecfd2c-d21c-5bab-9bca-e9ac877257e6" :answer/id #uuid "a8ecfd2c-d21c-5bab-9bca-e9ac877257e6" :answer/type :answer.type/text :answer/value "$(0,-3,0)$ and $(0,1,0)$" :db/ensure [:answer/validate]} {:db/id "answer-5726b996-61c1-520e-b808-c1131fdf41b0" :answer/id #uuid "5726b996-61c1-520e-b808-c1131fdf41b0" :answer/type :answer.type/text :answer/value "$(0,-\\sqrt{2},0)$ and $(0,\\sqrt{2},0)$" :db/ensure [:answer/validate]} {:db/id "answer-9dd75581-e364-58bb-8ecc-8010b1071f10" :answer/id #uuid "9dd75581-e364-58bb-8ecc-8010b1071f10" :answer/type :answer.type/text :answer/value "$(0,0,0)$ and $(0,4,0)$" :db/ensure [:answer/validate]} {:db/id 17592186124827 :question/problem "Given the hyperboloid of two sheets ${x}^{2}+{y}^{2}-{z}^{2}=-1$, find its $x$-intercepts." :question/worked-solution "To find the $x$-intercepts, we plug $y=0$ and $z=0$ into the equation: \n\n$$\n\\begin{aligned}{x}^{2}+{0}^{2}-{0}^{2} & =-1 \\\\ {x}^{2} & =-1\\end{aligned}\n$$\n\nThis equation has no (real) solutions. \n\nTherefore, the hyperboloid does not intersect the $x$-axis." :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186121559 :answer-field/correct 17592186121564 :answer-field/choices ["answer-9c6cc6be-012e-52c4-8117-db08550b642e" "answer-d5af5f9a-bf9d-5e89-b82c-94b8993aa538" "answer-942421f6-0292-584b-9c91-2062001476c1" "answer-b4a70c3e-7778-5f34-82d7-f5260b8d83b1"] :db/ensure [:answer-field/validate]} {:db/id "answer-9c6cc6be-012e-52c4-8117-db08550b642e" :answer/id #uuid "9c6cc6be-012e-52c4-8117-db08550b642e" :answer/type :answer.type/text :answer/value "$(-1,0,0)$ and $(1,0,0)$" :db/ensure [:answer/validate]} {:db/id "answer-d5af5f9a-bf9d-5e89-b82c-94b8993aa538" :answer/id #uuid "d5af5f9a-bf9d-5e89-b82c-94b8993aa538" :answer/type :answer.type/text :answer/value "$(-1,0,0)$ only" :db/ensure [:answer/validate]} {:db/id "answer-942421f6-0292-584b-9c91-2062001476c1" :answer/id #uuid "942421f6-0292-584b-9c91-2062001476c1" :answer/type :answer.type/text :answer/value "$(0,0,0)$ and $(1,0,0)$" :db/ensure [:answer/validate]} {:db/id "answer-b4a70c3e-7778-5f34-82d7-f5260b8d83b1" :answer/id #uuid "b4a70c3e-7778-5f34-82d7-f5260b8d83b1" :answer/type :answer.type/text :answer/value "$(1,0,0)$ only" :db/ensure [:answer/validate]} {:db/id 17592186378921 :answer-field/choices ["answer-19d58279-abc1-50a8-9085-0ebd005374af" "answer-51a5d90e-ca90-5c73-accf-e4213a388f0c" "answer-dc655d9f-5706-5e04-a2b6-a021fd9f2af0" "answer-06f58c8d-dd36-54da-a7cb-4e0680dd8d11"] :db/ensure [:answer-field/validate]} {:db/id "answer-19d58279-abc1-50a8-9085-0ebd005374af" :answer/id #uuid "19d58279-abc1-50a8-9085-0ebd005374af" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,\\frac{(x-1)^{2}}{2}+{y}^{2}<1\\}" :db/ensure [:answer/validate]} {:db/id "answer-51a5d90e-ca90-5c73-accf-e4213a388f0c" :answer/id #uuid "51a5d90e-ca90-5c73-accf-e4213a388f0c" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,\\frac{(x-1)^{2}}{2}+{y}^{2}>1\\}" :db/ensure [:answer/validate]} {:db/id "answer-dc655d9f-5706-5e04-a2b6-a021fd9f2af0" :answer/id #uuid "dc655d9f-5706-5e04-a2b6-a021fd9f2af0" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,\\frac{(x-1)^{2}}{2}+{y}^{2}\\ge 1\\}" :db/ensure [:answer/validate]} {:db/id "answer-06f58c8d-dd36-54da-a7cb-4e0680dd8d11" :answer/id #uuid "06f58c8d-dd36-54da-a7cb-4e0680dd8d11" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,\\frac{(x-1)^{2}}{2}+{y}^{2}\\le 1\\}" :db/ensure [:answer/validate]} {:db/id 17592186284252 :answer-field/choices ["answer-c09c3188-f84e-57d0-8dc1-83f1a60a9756" "answer-d5975ee2-3ecf-500e-8e1c-2962b00ed738" "answer-9967aa49-50aa-5f71-ad63-89982427cb06" "answer-76639164-3dd6-5449-9e16-8c706f2d6c36"] :db/ensure [:answer-field/validate]} {:db/id "answer-c09c3188-f84e-57d0-8dc1-83f1a60a9756" :answer/id #uuid "c09c3188-f84e-57d0-8dc1-83f1a60a9756" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,{x}^{2}+{y}^{2}<1\\}" :db/ensure [:answer/validate]} {:db/id "answer-d5975ee2-3ecf-500e-8e1c-2962b00ed738" :answer/id #uuid "d5975ee2-3ecf-500e-8e1c-2962b00ed738" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,{x}^{2}+{y}^{2}>1\\}" :db/ensure [:answer/validate]} {:db/id "answer-9967aa49-50aa-5f71-ad63-89982427cb06" :answer/id #uuid "9967aa49-50aa-5f71-ad63-89982427cb06" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,{x}^{2}+{y}^{2}\\ge 1\\}" :db/ensure [:answer/validate]} {:db/id "answer-76639164-3dd6-5449-9e16-8c706f2d6c36" :answer/id #uuid "76639164-3dd6-5449-9e16-8c706f2d6c36" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,{x}^{2}+{y}^{2}\\le 1\\}" :db/ensure [:answer/validate]} {:db/id 17592186408093 :answer-field/choices ["answer-f0fd2738-95bc-5ce8-af8a-007c2793d79e" "answer-e88bb104-5429-5d48-9b16-2281d5b1fabf" "answer-53357543-e2c9-531c-90c9-df1aa8ac742f" "answer-6e310c38-d0e1-5c20-a7e8-fcc4464b7b54"] :db/ensure [:answer-field/validate]} {:db/id "answer-f0fd2738-95bc-5ce8-af8a-007c2793d79e" :answer/id #uuid "f0fd2738-95bc-5ce8-af8a-007c2793d79e" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,(x+1)^{2}+(y-2)^{2}<1\\}" :db/ensure [:answer/validate]} {:db/id "answer-e88bb104-5429-5d48-9b16-2281d5b1fabf" :answer/id #uuid "e88bb104-5429-5d48-9b16-2281d5b1fabf" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,(x+1)^{2}+(y-2)^{2}>1\\}" :db/ensure [:answer/validate]} {:db/id "answer-53357543-e2c9-531c-90c9-df1aa8ac742f" :answer/id #uuid "53357543-e2c9-531c-90c9-df1aa8ac742f" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,(x+1)^{2}+(y-2)^{2}\\ge 1\\}" :db/ensure [:answer/validate]} {:db/id "answer-6e310c38-d0e1-5c20-a7e8-fcc4464b7b54" :answer/id #uuid "6e310c38-d0e1-5c20-a7e8-fcc4464b7b54" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,(x+1)^{2}+(y-2)^{2}\\le 1\\}" :db/ensure [:answer/validate]} {:db/id 17592186323801 :question/worked-solution "From the hyperboloid equation, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}-\\frac{(z+1)^{2}}{3} & =1 \\\\ \\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}-1 & =\\frac{(z+1)^{2}}{3} \\\\ (z+1)^{2} & =3(\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}-1) \\\\ (z+1) & =\\pm \\sqrt{3(\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}-1)}\\end{aligned}\n$$\n\n \n\nSince the square root is defined only for non-negative arguments, we have:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}-1 & \\ge 0 \\\\ \\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2} & \\ge 1\\end{aligned}\n$$\n\nwhich gives the exterior of the ellipse $\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}=1$, including its boundary.\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\,:\\,\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}\\ge 1\\}.\n$$" :db/ensure [:question/validate]} {:db/id 17592186323405 :answer-field/correct "answer-8a7e4314-461a-51dd-8e7e-003b239d4df1" :answer-field/choices ["answer-8a23aa13-d540-5d99-be2b-3b822200ad45" "answer-8a7e4314-461a-51dd-8e7e-003b239d4df1" "answer-6d07251a-4f5b-5fe1-a5c8-5c5e4e7f9bfc" "answer-9bc62f3e-4d97-58eb-bb7f-08bb44e41d57"] :db/ensure [:answer-field/validate]} {:db/id "answer-8a23aa13-d540-5d99-be2b-3b822200ad45" :answer/id #uuid "8a23aa13-d540-5d99-be2b-3b822200ad45" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}<1\\}" :db/ensure [:answer/validate]} {:db/id "answer-8a7e4314-461a-51dd-8e7e-003b239d4df1" :answer/id #uuid "8a7e4314-461a-51dd-8e7e-003b239d4df1" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}\\ge 1\\}" :db/ensure [:answer/validate]} {:db/id "answer-6d07251a-4f5b-5fe1-a5c8-5c5e4e7f9bfc" :answer/id #uuid "6d07251a-4f5b-5fe1-a5c8-5c5e4e7f9bfc" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,\\frac{{x}^{2}}{6}-\\frac{{y}^{2}}{2}<0\\}" :db/ensure [:answer/validate]} {:db/id "answer-9bc62f3e-4d97-58eb-bb7f-08bb44e41d57" :answer/id #uuid "9bc62f3e-4d97-58eb-bb7f-08bb44e41d57" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,\\frac{{x}^{2}}{6}-\\frac{{y}^{2}}{2}\\ge 0\\}" :db/ensure [:answer/validate]} {:db/id "question-1a64d7fd-d80f-53bd-910a-60419647eb47" :question/id #uuid "1a64d7fd-d80f-53bd-910a-60419647eb47" :question/math-academy-id "q-36323" :question/problem "What is the trace in the $xz$-plane of the hyperboloid of one sheet $9{x}^{2}+8{y}^{2}-4{z}^{2}=1?$" :question/worked-solution "To find the trace in the $xz$-plane, we substitute $y=0$ into the equation of the hyperboloid. This gives: \n\n$$\n\\begin{aligned}9{x}^{2}+8\\cdot {0}^{2}-4{z}^{2} & =1 \\\\ 9{x}^{2}-4{z}^{2} & =1\\end{aligned}\n$$\n\nwhich is the equation of a hyperbola in $xz$-plane." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-0a302038-8631-5953-a8f8-0cdccc24c035"] :db/ensure [:question/validate]} {:db/id "answer-field-0a302038-8631-5953-a8f8-0cdccc24c035" :answer-field/id #uuid "0a302038-8631-5953-a8f8-0cdccc24c035" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7c79725f-53ef-57ae-9875-557218ef53d4" :answer-field/choices ["answer-ca33020b-9a08-5192-a614-1388ffc83e34" "answer-914100ae-dbbe-52f6-afc8-728db3a0a28f" "answer-2f18a57e-f42f-587e-847b-92b2446cd452" "answer-7c79725f-53ef-57ae-9875-557218ef53d4" "answer-3710bae3-9011-5bcd-9242-2708a46849d8"] :db/ensure [:answer-field/validate]} {:db/id "answer-ca33020b-9a08-5192-a614-1388ffc83e34" :answer/id #uuid "ca33020b-9a08-5192-a614-1388ffc83e34" :answer/type :answer.type/math :answer/value "8{y}^{2}-4{z}^{2}=1" :db/ensure [:answer/validate]} {:db/id "answer-914100ae-dbbe-52f6-afc8-728db3a0a28f" :answer/id #uuid "914100ae-dbbe-52f6-afc8-728db3a0a28f" :answer/type :answer.type/math :answer/value "9{x}^{2}+8{y}^{2}=1" :db/ensure [:answer/validate]} {:db/id "answer-2f18a57e-f42f-587e-847b-92b2446cd452" :answer/id #uuid "2f18a57e-f42f-587e-847b-92b2446cd452" :answer/type :answer.type/math :answer/value "9{x}^{2}-4{z}^{2}=-7" :db/ensure [:answer/validate]} {:db/id "answer-7c79725f-53ef-57ae-9875-557218ef53d4" :answer/id #uuid "7c79725f-53ef-57ae-9875-557218ef53d4" :answer/type :answer.type/math :answer/value "9{x}^{2}-4{z}^{2}=1" :db/ensure [:answer/validate]} {:db/id "answer-3710bae3-9011-5bcd-9242-2708a46849d8" :answer/id #uuid "3710bae3-9011-5bcd-9242-2708a46849d8" :answer/type :answer.type/math :answer/value "9{x}^{2}-4{z}^{2}=8" :db/ensure [:answer/validate]}] "assertions" [["question-e6548717-af2d-5bfc-9298-8a16a46973b2" :question/id #uuid "e6548717-af2d-5bfc-9298-8a16a46973b2"] ["question-e6548717-af2d-5bfc-9298-8a16a46973b2" :question/math-academy-id "q-71858"] ["question-e6548717-af2d-5bfc-9298-8a16a46973b2" :question/problem "Given the hyperboloid of one sheet $\\frac{(x-2)^{2}}{4}+\\frac{(y-2)^{2}}{4}-\\frac{(z-3)^{2}}{9}=1$, find its $y$-intercepts."] ["question-e6548717-af2d-5bfc-9298-8a16a46973b2" :question/worked-solution "To find the $y$-intercepts, we plug $x=0$ and $z=0$ into the equation: \n\n$$\n\\begin{aligned}\\frac{(0-2)^{2}}{4}+\\frac{(y-2)^{2}}{4}-\\frac{(0-3)^{2}}{9} & =1 \\\\ 1+\\frac{(y-2)^{2}}{4}-1 & =1 \\\\ \\frac{(y-2)^{2}}{4} & =1 \\\\ (y-2)^{2} & =4 \\\\ y-2 & =\\pm \\sqrt{4} \\\\ y & =2\\pm 2\\end{aligned}\n$$\n\nHence, we get the solutions $y=0$ and $y=4.$\n\nTherefore, the intercepts with the $y$-axis are $(0,0,0)$ and $(0,4,0).$"] ["question-e6548717-af2d-5bfc-9298-8a16a46973b2" :question/difficulty :question.difficulty/moderate] ["answer-field-d7d6da6e-d2bc-559d-a654-e2becdcb61da" :answer-field/id #uuid "d7d6da6e-d2bc-559d-a654-e2becdcb61da"] ["answer-0b05d521-7d63-5960-a052-63edd7b8a9ff" :answer/id #uuid "0b05d521-7d63-5960-a052-63edd7b8a9ff"] ["answer-0b05d521-7d63-5960-a052-63edd7b8a9ff" :answer/type :answer.type/text] ["answer-0b05d521-7d63-5960-a052-63edd7b8a9ff" :answer/value "$(0,-1,0)$ and $(0,3,0)$"] ["answer-e636de43-6150-50b8-95ab-2fe05095f1c9" :answer/id #uuid "e636de43-6150-50b8-95ab-2fe05095f1c9"] ["answer-e636de43-6150-50b8-95ab-2fe05095f1c9" :answer/type :answer.type/text] ["answer-e636de43-6150-50b8-95ab-2fe05095f1c9" :answer/value "$(0,-2,0)$ and $(0,2,0)$"] ["answer-a8ecfd2c-d21c-5bab-9bca-e9ac877257e6" :answer/id #uuid "a8ecfd2c-d21c-5bab-9bca-e9ac877257e6"] ["answer-a8ecfd2c-d21c-5bab-9bca-e9ac877257e6" :answer/type :answer.type/text] ["answer-a8ecfd2c-d21c-5bab-9bca-e9ac877257e6" :answer/value "$(0,-3,0)$ and $(0,1,0)$"] ["answer-5726b996-61c1-520e-b808-c1131fdf41b0" :answer/id #uuid "5726b996-61c1-520e-b808-c1131fdf41b0"] ["answer-5726b996-61c1-520e-b808-c1131fdf41b0" :answer/type :answer.type/text] ["answer-5726b996-61c1-520e-b808-c1131fdf41b0" :answer/value "$(0,-\\sqrt{2},0)$ and $(0,\\sqrt{2},0)$"] ["answer-9dd75581-e364-58bb-8ecc-8010b1071f10" :answer/id #uuid "9dd75581-e364-58bb-8ecc-8010b1071f10"] ["answer-9dd75581-e364-58bb-8ecc-8010b1071f10" :answer/type :answer.type/text] ["answer-9dd75581-e364-58bb-8ecc-8010b1071f10" :answer/value "$(0,0,0)$ and $(0,4,0)$"] ["answer-field-d7d6da6e-d2bc-559d-a654-e2becdcb61da" :answer-field/key "selection"] ["answer-field-d7d6da6e-d2bc-559d-a654-e2becdcb61da" :answer-field/type :answer-field.type/radio] ["answer-field-d7d6da6e-d2bc-559d-a654-e2becdcb61da" :answer-field/correct "answer-9dd75581-e364-58bb-8ecc-8010b1071f10"] ["answer-field-d7d6da6e-d2bc-559d-a654-e2becdcb61da" :answer-field/choices "answer-0b05d521-7d63-5960-a052-63edd7b8a9ff"] ["answer-field-d7d6da6e-d2bc-559d-a654-e2becdcb61da" :answer-field/choices "answer-e636de43-6150-50b8-95ab-2fe05095f1c9"] ["answer-field-d7d6da6e-d2bc-559d-a654-e2becdcb61da" :answer-field/choices "answer-a8ecfd2c-d21c-5bab-9bca-e9ac877257e6"] ["answer-field-d7d6da6e-d2bc-559d-a654-e2becdcb61da" :answer-field/choices "answer-5726b996-61c1-520e-b808-c1131fdf41b0"] ["answer-field-d7d6da6e-d2bc-559d-a654-e2becdcb61da" :answer-field/choices "answer-9dd75581-e364-58bb-8ecc-8010b1071f10"] ["question-e6548717-af2d-5bfc-9298-8a16a46973b2" :question/answer-fields "answer-field-d7d6da6e-d2bc-559d-a654-e2becdcb61da"] [17592186124650 :knowledge-point/questions "question-e6548717-af2d-5bfc-9298-8a16a46973b2"] [17592186124827 :question/problem "Given the hyperboloid of two sheets ${x}^{2}+{y}^{2}-{z}^{2}=-1$, find its $x$-intercepts."] [17592186124827 :question/worked-solution "To find the $x$-intercepts, we plug $y=0$ and $z=0$ into the equation: \n\n$$\n\\begin{aligned}{x}^{2}+{0}^{2}-{0}^{2} & =-1 \\\\ {x}^{2} & =-1\\end{aligned}\n$$\n\nThis equation has no (real) solutions. \n\nTherefore, the hyperboloid does not intersect the $x$-axis."] [17592186124827 :question/difficulty :question.difficulty/easy] ["answer-9c6cc6be-012e-52c4-8117-db08550b642e" :answer/id #uuid "9c6cc6be-012e-52c4-8117-db08550b642e"] ["answer-9c6cc6be-012e-52c4-8117-db08550b642e" :answer/type :answer.type/text] ["answer-9c6cc6be-012e-52c4-8117-db08550b642e" :answer/value "$(-1,0,0)$ and $(1,0,0)$"] ["answer-d5af5f9a-bf9d-5e89-b82c-94b8993aa538" :answer/id #uuid "d5af5f9a-bf9d-5e89-b82c-94b8993aa538"] ["answer-d5af5f9a-bf9d-5e89-b82c-94b8993aa538" :answer/type :answer.type/text] ["answer-d5af5f9a-bf9d-5e89-b82c-94b8993aa538" :answer/value "$(-1,0,0)$ only"] ["answer-942421f6-0292-584b-9c91-2062001476c1" :answer/id #uuid "942421f6-0292-584b-9c91-2062001476c1"] ["answer-942421f6-0292-584b-9c91-2062001476c1" :answer/type :answer.type/text] ["answer-942421f6-0292-584b-9c91-2062001476c1" :answer/value "$(0,0,0)$ and $(1,0,0)$"] ["answer-b4a70c3e-7778-5f34-82d7-f5260b8d83b1" :answer/id #uuid "b4a70c3e-7778-5f34-82d7-f5260b8d83b1"] ["answer-b4a70c3e-7778-5f34-82d7-f5260b8d83b1" :answer/type :answer.type/text] ["answer-b4a70c3e-7778-5f34-82d7-f5260b8d83b1" :answer/value "$(1,0,0)$ only"] [17592186121559 :answer-field/correct 17592186121564] [17592186121559 :answer-field/choices "answer-9c6cc6be-012e-52c4-8117-db08550b642e"] [17592186121559 :answer-field/choices "answer-d5af5f9a-bf9d-5e89-b82c-94b8993aa538"] [17592186121559 :answer-field/choices "answer-942421f6-0292-584b-9c91-2062001476c1"] [17592186121559 :answer-field/choices "answer-b4a70c3e-7778-5f34-82d7-f5260b8d83b1"] ["answer-19d58279-abc1-50a8-9085-0ebd005374af" :answer/id #uuid "19d58279-abc1-50a8-9085-0ebd005374af"] ["answer-19d58279-abc1-50a8-9085-0ebd005374af" :answer/type :answer.type/math] ["answer-19d58279-abc1-50a8-9085-0ebd005374af" :answer/value "\\{(x,y)\\,:\\,\\frac{(x-1)^{2}}{2}+{y}^{2}<1\\}"] ["answer-51a5d90e-ca90-5c73-accf-e4213a388f0c" :answer/id #uuid "51a5d90e-ca90-5c73-accf-e4213a388f0c"] ["answer-51a5d90e-ca90-5c73-accf-e4213a388f0c" :answer/type :answer.type/math] ["answer-51a5d90e-ca90-5c73-accf-e4213a388f0c" :answer/value "\\{(x,y)\\,:\\,\\frac{(x-1)^{2}}{2}+{y}^{2}>1\\}"] ["answer-dc655d9f-5706-5e04-a2b6-a021fd9f2af0" :answer/id #uuid "dc655d9f-5706-5e04-a2b6-a021fd9f2af0"] ["answer-dc655d9f-5706-5e04-a2b6-a021fd9f2af0" :answer/type :answer.type/math] ["answer-dc655d9f-5706-5e04-a2b6-a021fd9f2af0" :answer/value "\\{(x,y)\\,:\\,\\frac{(x-1)^{2}}{2}+{y}^{2}\\ge 1\\}"] ["answer-06f58c8d-dd36-54da-a7cb-4e0680dd8d11" :answer/id #uuid "06f58c8d-dd36-54da-a7cb-4e0680dd8d11"] ["answer-06f58c8d-dd36-54da-a7cb-4e0680dd8d11" :answer/type :answer.type/math] ["answer-06f58c8d-dd36-54da-a7cb-4e0680dd8d11" :answer/value "\\{(x,y)\\,:\\,\\frac{(x-1)^{2}}{2}+{y}^{2}\\le 1\\}"] [17592186378921 :answer-field/choices "answer-19d58279-abc1-50a8-9085-0ebd005374af"] [17592186378921 :answer-field/choices "answer-51a5d90e-ca90-5c73-accf-e4213a388f0c"] [17592186378921 :answer-field/choices "answer-dc655d9f-5706-5e04-a2b6-a021fd9f2af0"] [17592186378921 :answer-field/choices "answer-06f58c8d-dd36-54da-a7cb-4e0680dd8d11"] ["answer-c09c3188-f84e-57d0-8dc1-83f1a60a9756" :answer/id #uuid "c09c3188-f84e-57d0-8dc1-83f1a60a9756"] ["answer-c09c3188-f84e-57d0-8dc1-83f1a60a9756" :answer/type :answer.type/math] ["answer-c09c3188-f84e-57d0-8dc1-83f1a60a9756" :answer/value "\\{(x,y)\\,:\\,{x}^{2}+{y}^{2}<1\\}"] ["answer-d5975ee2-3ecf-500e-8e1c-2962b00ed738" :answer/id #uuid "d5975ee2-3ecf-500e-8e1c-2962b00ed738"] ["answer-d5975ee2-3ecf-500e-8e1c-2962b00ed738" :answer/type :answer.type/math] ["answer-d5975ee2-3ecf-500e-8e1c-2962b00ed738" :answer/value "\\{(x,y)\\,:\\,{x}^{2}+{y}^{2}>1\\}"] ["answer-9967aa49-50aa-5f71-ad63-89982427cb06" :answer/id #uuid "9967aa49-50aa-5f71-ad63-89982427cb06"] ["answer-9967aa49-50aa-5f71-ad63-89982427cb06" :answer/type :answer.type/math] ["answer-9967aa49-50aa-5f71-ad63-89982427cb06" :answer/value "\\{(x,y)\\,:\\,{x}^{2}+{y}^{2}\\ge 1\\}"] ["answer-76639164-3dd6-5449-9e16-8c706f2d6c36" :answer/id #uuid "76639164-3dd6-5449-9e16-8c706f2d6c36"] ["answer-76639164-3dd6-5449-9e16-8c706f2d6c36" :answer/type :answer.type/math] ["answer-76639164-3dd6-5449-9e16-8c706f2d6c36" :answer/value "\\{(x,y)\\,:\\,{x}^{2}+{y}^{2}\\le 1\\}"] [17592186284252 :answer-field/choices "answer-c09c3188-f84e-57d0-8dc1-83f1a60a9756"] [17592186284252 :answer-field/choices "answer-d5975ee2-3ecf-500e-8e1c-2962b00ed738"] [17592186284252 :answer-field/choices "answer-9967aa49-50aa-5f71-ad63-89982427cb06"] [17592186284252 :answer-field/choices "answer-76639164-3dd6-5449-9e16-8c706f2d6c36"] ["answer-f0fd2738-95bc-5ce8-af8a-007c2793d79e" :answer/id #uuid "f0fd2738-95bc-5ce8-af8a-007c2793d79e"] ["answer-f0fd2738-95bc-5ce8-af8a-007c2793d79e" :answer/type :answer.type/math] ["answer-f0fd2738-95bc-5ce8-af8a-007c2793d79e" :answer/value "\\{(x,y)\\,:\\,(x+1)^{2}+(y-2)^{2}<1\\}"] ["answer-e88bb104-5429-5d48-9b16-2281d5b1fabf" :answer/id #uuid "e88bb104-5429-5d48-9b16-2281d5b1fabf"] ["answer-e88bb104-5429-5d48-9b16-2281d5b1fabf" :answer/type :answer.type/math] ["answer-e88bb104-5429-5d48-9b16-2281d5b1fabf" :answer/value "\\{(x,y)\\,:\\,(x+1)^{2}+(y-2)^{2}>1\\}"] ["answer-53357543-e2c9-531c-90c9-df1aa8ac742f" :answer/id #uuid "53357543-e2c9-531c-90c9-df1aa8ac742f"] ["answer-53357543-e2c9-531c-90c9-df1aa8ac742f" :answer/type :answer.type/math] ["answer-53357543-e2c9-531c-90c9-df1aa8ac742f" :answer/value "\\{(x,y)\\,:\\,(x+1)^{2}+(y-2)^{2}\\ge 1\\}"] ["answer-6e310c38-d0e1-5c20-a7e8-fcc4464b7b54" :answer/id #uuid "6e310c38-d0e1-5c20-a7e8-fcc4464b7b54"] ["answer-6e310c38-d0e1-5c20-a7e8-fcc4464b7b54" :answer/type :answer.type/math] ["answer-6e310c38-d0e1-5c20-a7e8-fcc4464b7b54" :answer/value "\\{(x,y)\\,:\\,(x+1)^{2}+(y-2)^{2}\\le 1\\}"] [17592186408093 :answer-field/choices "answer-f0fd2738-95bc-5ce8-af8a-007c2793d79e"] [17592186408093 :answer-field/choices "answer-e88bb104-5429-5d48-9b16-2281d5b1fabf"] [17592186408093 :answer-field/choices "answer-53357543-e2c9-531c-90c9-df1aa8ac742f"] [17592186408093 :answer-field/choices "answer-6e310c38-d0e1-5c20-a7e8-fcc4464b7b54"] [17592186323801 :question/worked-solution "From the hyperboloid equation, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}-\\frac{(z+1)^{2}}{3} & =1 \\\\ \\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}-1 & =\\frac{(z+1)^{2}}{3} \\\\ (z+1)^{2} & =3(\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}-1) \\\\ (z+1) & =\\pm \\sqrt{3(\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}-1)}\\end{aligned}\n$$\n\n \n\nSince the square root is defined only for non-negative arguments, we have:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}-1 & \\ge 0 \\\\ \\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2} & \\ge 1\\end{aligned}\n$$\n\nwhich gives the exterior of the ellipse $\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}=1$, including its boundary.\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\,:\\,\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}\\ge 1\\}.\n$$"] ["answer-8a23aa13-d540-5d99-be2b-3b822200ad45" :answer/id #uuid "8a23aa13-d540-5d99-be2b-3b822200ad45"] ["answer-8a23aa13-d540-5d99-be2b-3b822200ad45" :answer/type :answer.type/math] ["answer-8a23aa13-d540-5d99-be2b-3b822200ad45" :answer/value "\\{(x,y)\\,:\\,\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}<1\\}"] ["answer-8a7e4314-461a-51dd-8e7e-003b239d4df1" :answer/id #uuid "8a7e4314-461a-51dd-8e7e-003b239d4df1"] ["answer-8a7e4314-461a-51dd-8e7e-003b239d4df1" :answer/type :answer.type/math] ["answer-8a7e4314-461a-51dd-8e7e-003b239d4df1" :answer/value "\\{(x,y)\\,:\\,\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}\\ge 1\\}"] ["answer-6d07251a-4f5b-5fe1-a5c8-5c5e4e7f9bfc" :answer/id #uuid "6d07251a-4f5b-5fe1-a5c8-5c5e4e7f9bfc"] ["answer-6d07251a-4f5b-5fe1-a5c8-5c5e4e7f9bfc" :answer/type :answer.type/math] ["answer-6d07251a-4f5b-5fe1-a5c8-5c5e4e7f9bfc" :answer/value "\\{(x,y)\\,:\\,\\frac{{x}^{2}}{6}-\\frac{{y}^{2}}{2}<0\\}"] ["answer-9bc62f3e-4d97-58eb-bb7f-08bb44e41d57" :answer/id #uuid "9bc62f3e-4d97-58eb-bb7f-08bb44e41d57"] ["answer-9bc62f3e-4d97-58eb-bb7f-08bb44e41d57" :answer/type :answer.type/math] ["answer-9bc62f3e-4d97-58eb-bb7f-08bb44e41d57" :answer/value "\\{(x,y)\\,:\\,\\frac{{x}^{2}}{6}-\\frac{{y}^{2}}{2}\\ge 0\\}"] [17592186323405 :answer-field/correct "answer-8a7e4314-461a-51dd-8e7e-003b239d4df1"] [17592186323405 :answer-field/choices "answer-8a23aa13-d540-5d99-be2b-3b822200ad45"] [17592186323405 :answer-field/choices "answer-8a7e4314-461a-51dd-8e7e-003b239d4df1"] [17592186323405 :answer-field/choices "answer-6d07251a-4f5b-5fe1-a5c8-5c5e4e7f9bfc"] [17592186323405 :answer-field/choices "answer-9bc62f3e-4d97-58eb-bb7f-08bb44e41d57"] ["question-1a64d7fd-d80f-53bd-910a-60419647eb47" :question/id #uuid "1a64d7fd-d80f-53bd-910a-60419647eb47"] ["question-1a64d7fd-d80f-53bd-910a-60419647eb47" :question/math-academy-id "q-36323"] ["question-1a64d7fd-d80f-53bd-910a-60419647eb47" :question/problem "What is the trace in the $xz$-plane of the hyperboloid of one sheet $9{x}^{2}+8{y}^{2}-4{z}^{2}=1?$"] ["question-1a64d7fd-d80f-53bd-910a-60419647eb47" :question/worked-solution "To find the trace in the $xz$-plane, we substitute $y=0$ into the equation of the hyperboloid. This gives: \n\n$$\n\\begin{aligned}9{x}^{2}+8\\cdot {0}^{2}-4{z}^{2} & =1 \\\\ 9{x}^{2}-4{z}^{2} & =1\\end{aligned}\n$$\n\nwhich is the equation of a hyperbola in $xz$-plane."] ["question-1a64d7fd-d80f-53bd-910a-60419647eb47" :question/difficulty :question.difficulty/easy] ["answer-field-0a302038-8631-5953-a8f8-0cdccc24c035" :answer-field/id #uuid "0a302038-8631-5953-a8f8-0cdccc24c035"] ["answer-ca33020b-9a08-5192-a614-1388ffc83e34" :answer/id #uuid "ca33020b-9a08-5192-a614-1388ffc83e34"] ["answer-ca33020b-9a08-5192-a614-1388ffc83e34" :answer/type :answer.type/math] ["answer-ca33020b-9a08-5192-a614-1388ffc83e34" :answer/value "8{y}^{2}-4{z}^{2}=1"] ["answer-914100ae-dbbe-52f6-afc8-728db3a0a28f" :answer/id #uuid "914100ae-dbbe-52f6-afc8-728db3a0a28f"] ["answer-914100ae-dbbe-52f6-afc8-7