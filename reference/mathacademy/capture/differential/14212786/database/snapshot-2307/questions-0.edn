#{[{:db/id #edb/ref 17592186409922 :knowledge-point/_questions [{:db/id #edb/ref 17592186129162 :knowledge-point/id #uuid "77be6032-ec22-5561-94c2-be289e343142" :knowledge-point/title "Finding a Level Surface of a Function Passing Through a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "075b7e9b-145b-5c05-9d44-d25bd4906906" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z={y}^{2}-{x}^{2}" :db/id #edb/ref 17592186409902} {:answer/id #uuid "2ebb8400-2445-5e48-a715-3c49140534aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z={x}^{2}-{y}^{2}" :db/id #edb/ref 17592186409903} {:answer/id #uuid "3e1d8da5-60a8-5dd3-b8c1-c0a4396407a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z={y}^{2}-{x}^{2}+2" :db/id #edb/ref 17592186409904} {:answer/id #uuid "d72a7a8d-f6c0-55af-9c80-47300b8e44cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z={y}^{2}-{x}^{2}-2" :db/id #edb/ref 17592186409911} {:answer/id #uuid "f658e47e-1f73-55ca-b61e-916ac3975ae3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z={y}^{2}-{x}^{2}-4" :db/id #edb/ref 17592186409915}] :answer-field/correct {:answer/id #uuid "075b7e9b-145b-5c05-9d44-d25bd4906906" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z={y}^{2}-{x}^{2}" :db/id #edb/ref 17592186409902} :answer-field/id #uuid "c684e12d-e352-5e5e-a84d-c529f9dea534" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186409918}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ef96fb6f-8651-5bcd-8700-e66e3e1a4bf5" :question/math-academy-id "q-129189" :question/problem "Find the equation of the level surface for the function $f(x,y,z)={y}^{2}-{x}^{2}-z$ that passes through the point $P(0,-2,4).$" :question/worked-solution "First, we find the value of the function at $P:$\n\n$$\n\\begin{aligned}f(0,2,4) & ={2}^{2}-{0}^{2}-4 \\\\  & =4-0-4 \\\\  & =0\\end{aligned}\n$$\n\nRecall that the level surfaces for the function $f(x,y,z)$ are given by the equation\n\n$$\nf(x,y,z)=c.\n$$\n\nIn our case, we're interested in $c=0.$ So, we have\n\n$$\n\\begin{aligned}f(x,y,z) & =c \\\\ {y}^{2}-{x}^{2}-z & =0 \\\\ z & ={y}^{2}-{x}^{2}.\\end{aligned}\n$$\n\nTherefore, the level surface that passes through the point $P(0,-2,4)$ is the hyperbolic paraboloid $z={y}^{2}-{x}^{2}.$"}] [{:db/id #edb/ref 17592186338963 :knowledge-point/_questions [{:db/id #edb/ref 17592186129161 :knowledge-point/id #uuid "5165085e-ffa9-533a-ab7c-c03304fc1489" :knowledge-point/title "Describing a Level Surface of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e089a87-8ff9-53dc-b1d4-1436a3bc6813" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A family of spheres centered at $(0,0,{e}^{-c})$" :db/id #edb/ref 17592186336474} {:answer/id #uuid "7b62d46a-a514-532f-89c7-6d4921bfda44" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A family of surfaces given by ${z}^{2}+c={e}^{{x}^{2}+{y}^{2}}$" :db/id #edb/ref 17592186337147} {:answer/id #uuid "9aeabbcc-2b4a-5ca7-8390-27e5e277c15d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A family of surfaces given by ${z}^{2}+c=\\operatorname{ln}⁡({x}^{2}+{y}^{2})$" :db/id #edb/ref 17592186337437} {:answer/id #uuid "a3d0702a-8a25-5d43-9cda-d825cf24aa17" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A family of spheres centered at the origin" :db/id #edb/ref 17592186337515} {:answer/id #uuid "e562beb6-45a0-5df9-9171-6dbe209c197d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A family of spheres centered at $(0,0,{e}^{c})$" :db/id #edb/ref 17592186338033}] :answer-field/correct {:answer/id #uuid "a3d0702a-8a25-5d43-9cda-d825cf24aa17" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A family of spheres centered at the origin" :db/id #edb/ref 17592186337515} :answer-field/id #uuid "c160b64c-1e42-5f78-9233-e0481eca788e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338621}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7eea4294-ff51-57d4-af2b-6b2d60319123" :question/math-academy-id "q-71578" :question/problem "Which of the following describes the level surfaces of the function $f(x,y,z)=\\operatorname{ln}⁡({x}^{2}+{y}^{2}+{z}^{2})?$" :question/worked-solution "The level surfaces of the function $f(x,y,z)$ are given by the following equation:\n\n$$\n\\begin{aligned}f(x,y,z) & =c \\\\ \\operatorname{ln}⁡({x}^{2}+{y}^{2}+{z}^{2}) & =c \\\\ {x}^{2}+{y}^{2}+{z}^{2} & ={e}^{c}\\end{aligned}\n$$\n\nIf we let ${e}^{c}={r}^{2},$ we get\n\n$$\n{x}^{2}+{y}^{2}+{z}^{2}={r}^{2}.\n$$\n\nTherefore, the level surfaces form a family of spheres centered at the origin."}] [{:db/id #edb/ref 17592186523935 :knowledge-point/_questions [{:db/id #edb/ref 17592186129161 :knowledge-point/id #uuid "5165085e-ffa9-533a-ab7c-c03304fc1489" :knowledge-point/title "Describing a Level Surface of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12c0e790-edc4-5281-84d1-9f28d659a041" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A family of surfaces given by $z=\\frac{8}{3(x-2y)}$" :db/id #edb/ref 17592186523295} {:answer/id #uuid "8d365ca5-d6b7-5a84-ba10-86854503958a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A family of planes: $cx-2cy+cz-5=0$" :db/id #edb/ref 17592186523546} {:answer/id #uuid "9cf199a7-82d2-5691-843f-b4613a15cdc9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A family of planes: $cx-3cz-8=0$" :db/id #edb/ref 17592186523582} {:answer/id #uuid "ad86ebff-441b-5209-b2d3-1c3dab69f227" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A family of planes: $cx-2cy+3cz-8=0$" :db/id #edb/ref 17592186523619} {:answer/id #uuid "ee37a463-0aef-5b56-9825-659d53f1bd2c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A family of surfaces given by $z=\\frac{8}{x-2y+3}$" :db/id #edb/ref 17592186523755}] :answer-field/correct {:answer/id #uuid "ad86ebff-441b-5209-b2d3-1c3dab69f227" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A family of planes: $cx-2cy+3cz-8=0$" :db/id #edb/ref 17592186523619} :answer-field/id #uuid "68ec3658-a0f2-5681-81c6-416ad622e049" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186523841}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1d879b56-35ea-5e82-93d4-20d74ef5904c" :question/math-academy-id "q-71580" :question/problem "Which of the following describes the level surfaces of the function $f(x,y,z)=\\frac{8}{x-2y+3z}?$" :question/worked-solution "The level surfaces of the function $f(x,y,z)$ are given by the following equation:\n\n$$\n\\begin{aligned}f(x,y,z) & =c \\\\ \\frac{8}{x-2y+3z} & =c \\\\ 8 & =c(x-2y+3z) \\\\ cx-2cy+3cz-8 & =0\\end{aligned}\n$$\n\nNotice that $f(x,y,z)$ can't be zero. Therefore, we get a family of planes:\n\n$$\ncx-2cy+3cz-8=0,\\,c\\in (-\\infty ,0)\\cup (0,\\infty ).\n$$"}] [{:db/id #edb/ref 17592186403482 :knowledge-point/_questions [{:db/id #edb/ref 17592186129161 :knowledge-point/id #uuid "5165085e-ffa9-533a-ab7c-c03304fc1489" :knowledge-point/title "Describing a Level Surface of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ec4a428d-e3d3-5679-bb8f-d50463ce62ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A family of hyperboloids of one sheet: $\\frac{{x}^{2}}{{c}^{2}}+\\frac{{y}^{2}}{{c}^{2}}-\\frac{{z}^{2}}{{c}^{2}}=1$" :db/id #edb/ref 17592186403484} {:answer/id #uuid "cf4cbec1-86a0-549a-8343-60b68cea6056" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A family of hyperboloids of one sheet: $cx-2cy+3cz-8=0$" :db/id #edb/ref 17592186403485} {:answer/id #uuid "b102be19-7bf6-5d35-8e89-51622e4a95ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A family of hyperbolic paraboloid: $\\frac{{x}^{2}}{{c}^{2}}-\\frac{{y}^{2}}{{c}^{2}}=z$" :db/id #edb/ref 17592186403486} {:answer/id #uuid "07f280ad-f44d-509c-9e86-7e91f865da5c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A family of spheres: $\\frac{{x}^{2}}{{c}^{2}}+\\frac{{y}^{2}}{{c}^{2}}+\\frac{{z}^{2}}{{c}^{2}}=1$" :db/id #edb/ref 17592186403487} {:answer/id #uuid "ea19eb30-c3d7-5e5b-93d4-22f8d73bf2ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A family of ellipsoids: $\\frac{{x}^{2}}{{c}^{2}}+\\frac{{y}^{2}}{{c}^{2}}+{z}^{2}=1$" :db/id #edb/ref 17592186403488}] :answer-field/correct {:answer/id #uuid "ec4a428d-e3d3-5679-bb8f-d50463ce62ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A family of hyperboloids of one sheet: $\\frac{{x}^{2}}{{c}^{2}}+\\frac{{y}^{2}}{{c}^{2}}-\\frac{{z}^{2}}{{c}^{2}}=1$" :db/id #edb/ref 17592186403484} :answer-field/id #uuid "b461523f-a59b-5dc6-8f0b-36ed850f9a53" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403483}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "196e54b1-6877-5611-9d9d-7ecb8d24abce" :question/math-academy-id "q-71582" :question/problem "Which of the following describes the $c$-level surfaces of the function $f(x,y,z)=\\sqrt{{x}^{2}+{y}^{2}-{z}^{2}},$ where $c>0?$" :question/worked-solution "The level surfaces of the function $f(x,y,z)$ are given by the following equation:\n\n$$\n\\begin{aligned}f(x,y,z) & =c \\\\ \\sqrt{{x}^{2}+{y}^{2}-{z}^{2}} & =c \\\\ {x}^{2}+{y}^{2}-{z}^{2} & ={c}^{2}\\end{aligned}\n$$\n\nTherefore, we get a family of hyperboloids of one sheet:\n\n$$\n\\frac{{x}^{2}}{{c}^{2}}+\\frac{{y}^{2}}{{c}^{2}}-\\frac{{z}^{2}}{{c}^{2}}=1,\\,c\\in (0,\\infty ).\n$$"}] [{:db/id #edb/ref 17592186338965 :knowledge-point/_questions [{:db/id #edb/ref 17592186129162 :knowledge-point/id #uuid "77be6032-ec22-5561-94c2-be289e343142" :knowledge-point/title "Finding a Level Surface of a Function Passing Through a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4deb2113-88f5-5014-825e-f2450862f13f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{12}-\\frac{(y-1)^{2}}{4}-\\frac{{z}^{2}}{12}=1" :db/id #edb/ref 17592186336756} {:answer/id #uuid "77e782ed-ed30-5d10-a950-6c1741f39dc5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{18}+\\frac{(y-1)^{2}}{6}-\\frac{{z}^{2}}{18}=1" :db/id #edb/ref 17592186337112} {:answer/id #uuid "7ab1408e-b7a7-5f0d-9944-324c2dfea208" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{18}+\\frac{(y-1)^{2}}{18}-\\frac{{z}^{2}}{18}=1" :db/id #edb/ref 17592186337138} {:answer/id #uuid "7ab545d2-bbbe-5a89-bcbf-d8d3d9e3143e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{18}+\\frac{(y-1)^{2}}{3}-\\frac{{z}^{2}}{18}=1" :db/id #edb/ref 17592186337139} {:answer/id #uuid "82ea9373-4da5-57f9-b9af-38aa676e9022" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{12}+\\frac{(y-1)^{2}}{8}-\\frac{{z}^{2}}{12}=1" :db/id #edb/ref 17592186337222}] :answer-field/correct {:answer/id #uuid "77e782ed-ed30-5d10-a950-6c1741f39dc5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{18}+\\frac{(y-1)^{2}}{6}-\\frac{{z}^{2}}{18}=1" :db/id #edb/ref 17592186337112} :answer-field/id #uuid "810f53f9-aff2-5824-a90c-5460ee5c8280" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338505}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8ee763a3-710a-5e1f-a2ce-e98f8f8714e0" :question/math-academy-id "q-71596" :question/problem "Find the equation of the level surface for the function $f(x,y,z)={x}^{2}+3(y-1)^{2}-{z}^{2}$ that passes through the point $P(4,2,1).$" :question/worked-solution "First, we find the value of the function at $P$:\n\n$$\n\\begin{aligned}f(4,2,1) & ={4}^{2}+3(2-1)^{2}-{1}^{2}=18\\end{aligned}\n$$\n\nRecall that the level surfaces for the function $f(x,y,z)$ are given by the equation\n\n$$\nf(x,y,z)=c.\n$$\n\nIn our case, we're interested in $c=18.$ So, we have:\n\n$$\n\\begin{aligned}f(x,y,z) & =c \\\\ {x}^{2}+3(y-1)^{2}-{z}^{2} & =18 \\\\ \\frac{{x}^{2}}{18}+\\frac{(y-1)^{2}}{6}-\\frac{{z}^{2}}{18} & =1\\end{aligned}\n$$\n\nTherefore, the level surface that passes through the point $P(4,2,1)$ is the hyperboloid of one sheet $\\frac{{x}^{2}}{18}+\\frac{(y-1)^{2}}{6}-\\frac{{z}^{2}}{18}=1.$"}]}
