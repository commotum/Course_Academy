#{[{:db/id #edb/ref 17592186213823 :knowledge-point/_questions [{:db/id #edb/ref 17592186213018 :knowledge-point/id #uuid "fa5d982f-ff13-5a31-9cd3-d5847ea2790c" :knowledge-point/title "Rationalizing Denominators Containing a Binomial Within the Radical"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09ad033c-9921-501d-9c6b-337f44033228" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x(\\sqrt{x + 2} - 4))/(x - 14)" :db/id #edb/ref 17592186212725} {:answer/id #uuid "2f424442-e493-5375-8db1-751f72ae4728" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x(\\sqrt{x + 2} + 4))/(x + 18)" :db/id #edb/ref 17592186212726} {:answer/id #uuid "5364bbea-5760-5dc6-b0c1-d2e7c552688a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x(\\sqrt{x - 2} - 4))/(x - 18)" :db/id #edb/ref 17592186212727} {:answer/id #uuid "6eb5b95d-52af-537b-9a64-5a5ad3ac60c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x\\sqrt{x - 2} + 4}{x - 14}" :db/id #edb/ref 17592186212728} {:answer/id #uuid "75a39792-880a-595c-bbb0-5c2ac5ce6273" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{x - 14}" :db/id #edb/ref 17592186212729}] :answer-field/id #uuid "07b0ffea-cecd-5abf-8980-0e708de53956" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186212724}] :question/id #uuid "25d93f27-b081-516b-bfe5-d84f1819ebc3" :question/math-academy-id "q-34502" :question/problem "Rationalize the denominator of $\\frac{x}{\\sqrt{x + 2} + 4}$."}] [{:db/id #edb/ref 17592186233966 :knowledge-point/_questions [{:db/id #edb/ref 17592186213018 :knowledge-point/id #uuid "fa5d982f-ff13-5a31-9cd3-d5847ea2790c" :knowledge-point/title "Rationalizing Denominators Containing a Binomial Within the Radical"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "69df2f53-5c50-59ae-8338-33f06671b49c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{y-3}-10}{y-7}" :db/id #edb/ref 17592186512353} {:answer/id #uuid "6c32fdae-9578-5230-9c6a-0030dc42ee0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{y+3}+10}{y-1}" :db/id #edb/ref 17592186512357} {:answer/id #uuid "97224d93-ee75-5b28-87bf-a215b4d67a60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{y+3}-10}{y+7}" :db/id #edb/ref 17592186512455} {:answer/id #uuid "c408e350-5f98-5e07-beed-90e315ab7e7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{y+3}+2}{y+1}" :db/id #edb/ref 17592186512571} {:answer/id #uuid "eb76173e-aa86-561d-80e6-1b55db1b9cdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{y-3}+2}{y-1}" :db/id #edb/ref 17592186512665}] :answer-field/correct {:answer/id #uuid "6c32fdae-9578-5230-9c6a-0030dc42ee0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{y+3}+10}{y-1}" :db/id #edb/ref 17592186512357} :answer-field/id #uuid "767f1526-f555-548a-8c1f-53ab5b15fedc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186512791}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b8bdad77-9abf-5122-8282-321bd75ae69b" :question/math-academy-id "q-34858" :question/problem "Rationalize the denominator of $\\frac{5}{\\sqrt{y+3}-2}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{y+3}+2.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{y+3}+2,$ and simplify:\n\n$$\n\\begin{aligned}\\frac{5}{\\sqrt{y+3}-2} & = \\\\ \\frac{5}{\\sqrt{y+3}-2}\\cdot \\frac{\\sqrt{y+3}+2}{\\sqrt{y+3}+2} & = \\\\ \\frac{5(\\sqrt{y+3}+2)}{(\\sqrt{y+3}-2)(\\sqrt{y+3}+2)} & = \\\\ \\frac{5\\sqrt{y+3}+10}{(\\sqrt{y+3})^{2}-{2}^{2}} & = \\\\ \\frac{5\\sqrt{y+3}+10}{y+3-4} & = \\\\ \\frac{5\\sqrt{y+3}+10}{y-1}\\end{aligned}\n$$"}]}
