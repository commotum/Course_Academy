#{[{:db/id #edb/ref 17592186521532 :knowledge-point/_questions [{:db/id #edb/ref 17592186213019 :knowledge-point/id #uuid "43395cdf-3e16-5147-87fb-371193078b4a" :knowledge-point/title "Rationalizing a Denominator With Two Radicals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7ce9dcd7-1369-5100-b33d-5f23930931b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5(\\sqrt{r+2}+\\sqrt{r+4})" :db/id #edb/ref 17592186521051} {:answer/id #uuid "b53f8a4f-b03c-5aea-a6f2-83a77fe9b67f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10(\\sqrt{r+2}+\\sqrt{r+4})}{r}" :db/id #edb/ref 17592186521169} {:answer/id #uuid "d56d8f89-912d-53cd-a553-2efdf5e9d6c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5(\\sqrt{r+2}+\\sqrt{r+4})}{r}" :db/id #edb/ref 17592186521243} {:answer/id #uuid "f5e09eb6-db36-531d-9813-9dc0cf25461d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5(\\sqrt{r+2}+\\sqrt{r+4})" :db/id #edb/ref 17592186521302} {:answer/id #uuid "fcdb5dd9-42a5-5cbf-ba24-229151615522" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10(\\sqrt{r+2}+\\sqrt{r+4})" :db/id #edb/ref 17592186521319}] :answer-field/correct {:answer/id #uuid "f5e09eb6-db36-531d-9813-9dc0cf25461d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5(\\sqrt{r+2}+\\sqrt{r+4})" :db/id #edb/ref 17592186521302} :answer-field/id #uuid "b36b37fd-6651-507b-9910-0f73d22b7862" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186521416}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "992f7e69-958f-50e1-a735-f09f05b61b6f" :question/math-academy-id "q-111099" :question/problem "Rationalize the denominator of $\\frac{10}{\\sqrt{r+2}-\\sqrt{r+4}}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{r+2}+\\sqrt{r+4}.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{r+2}+\\sqrt{r+4},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{10}{\\sqrt{r+2}-\\sqrt{r+4}} & = \\\\ \\frac{10}{\\sqrt{r+2}-\\sqrt{r+4}}\\cdot \\frac{\\sqrt{r+2}+\\sqrt{r+4}}{\\sqrt{r+2}+\\sqrt{r+4}} & = \\\\ \\frac{10(\\sqrt{r+2}+\\sqrt{r+4})}{(\\sqrt{r+2}-\\sqrt{r+4})(\\sqrt{r+2}+\\sqrt{r+4})} & = \\\\ \\frac{10(\\sqrt{r+2}+\\sqrt{r+4})}{(\\sqrt{r+2})^{2}-(\\sqrt{r+4})^{2}} & = \\\\ \\frac{10(\\sqrt{r+2}+\\sqrt{r+4})}{(r+2)-(r+4)} & = \\\\ \\frac{10(\\sqrt{r+2}+\\sqrt{r+4})}{(-2)} & = \\\\ -5(\\sqrt{r+2}+\\sqrt{r+4})\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186521485 :knowledge-point/_questions [{:db/id #edb/ref 17592186213019 :knowledge-point/id #uuid "43395cdf-3e16-5147-87fb-371193078b4a" :knowledge-point/title "Rationalizing a Denominator With Two Radicals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3209607c-4fd0-5f69-8dbb-841fd6d6a93f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5z(\\sqrt{2}-\\sqrt{10z})}{2-5z}" :db/id #edb/ref 17592186520870} {:answer/id #uuid "92311420-2889-54e9-a9dd-2d80f687d0f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}z-\\sqrt{10z}}{1+5z}" :db/id #edb/ref 17592186521095} {:answer/id #uuid "9535b9e0-b46d-506d-a7b8-72740283f836" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5z(\\sqrt{2}-\\sqrt{10z})}{2(1-5z)}" :db/id #edb/ref 17592186521103} {:answer/id #uuid "c2dbbb0d-019b-5038-acdd-928bb643e139" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5z(\\sqrt{2}+\\sqrt{10z})}{2-5z}" :db/id #edb/ref 17592186521197} {:answer/id #uuid "e61a03b8-2399-5b96-83df-cc93cbd78137" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}z+\\sqrt{10z}}{1-5z}" :db/id #edb/ref 17592186521280}] :answer-field/correct {:answer/id #uuid "9535b9e0-b46d-506d-a7b8-72740283f836" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5z(\\sqrt{2}-\\sqrt{10z})}{2(1-5z)}" :db/id #edb/ref 17592186521103} :answer-field/id #uuid "5ef8731e-9af3-5ebb-ac94-c0117d6e5d8f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186521372}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3a9fdb79-91cf-5159-aced-4b759a444970" :question/math-academy-id "q-296007" :question/problem "Rationalize the denominator of $\\frac{5z}{\\sqrt{2}+\\sqrt{10z}}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{2}-\\sqrt{10z}.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{2}-\\sqrt{10z},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{5z}{\\sqrt{2}+\\sqrt{10z}} & = \\\\ \\frac{5z}{\\sqrt{2}+\\sqrt{10z}}\\cdot \\frac{\\sqrt{2}-\\sqrt{10z}}{\\sqrt{2}-\\sqrt{10z}} & = \\\\ \\frac{5z(\\sqrt{2}-\\sqrt{10z})}{(\\sqrt{2}+\\sqrt{10z})(\\sqrt{2}-\\sqrt{10z})} & = \\\\ \\frac{5z(\\sqrt{2}-\\sqrt{10z})}{(\\sqrt{2})^{2}-(\\sqrt{10z})^{2}} & = \\\\ \\frac{5z(\\sqrt{2}-\\sqrt{10z})}{2-10z} & = \\\\ \\frac{5z(\\sqrt{2}-\\sqrt{10z})}{2(1-5z)}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186521484 :knowledge-point/_questions [{:db/id #edb/ref 17592186213019 :knowledge-point/id #uuid "43395cdf-3e16-5147-87fb-371193078b4a" :knowledge-point/title "Rationalizing a Denominator With Two Radicals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7c2a016e-ad1a-5c19-8891-77f26cce6fc3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3(\\sqrt{5}+\\sqrt{3x})}{5-3x}" :db/id #edb/ref 17592186521047} {:answer/id #uuid "bd4d8cde-eff6-5e7c-a368-c0664c614edd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3x}-\\sqrt{5}}{3x+5}" :db/id #edb/ref 17592186521189} {:answer/id #uuid "ca31bd2f-56b5-56fd-a0c5-eed7fb8fb9e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3x}+\\sqrt{5}}{x-5}" :db/id #edb/ref 17592186521215} {:answer/id #uuid "d7c65232-c686-59ec-910b-ca36f2dc66e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3(\\sqrt{3x}+\\sqrt{5})}{3x-5}" :db/id #edb/ref 17592186521248} {:answer/id #uuid "db7835db-46f2-5180-b58e-a639e5d2d792" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3(\\sqrt{3x}-\\sqrt{5})}{3x-5}" :db/id #edb/ref 17592186521257}] :answer-field/correct {:answer/id #uuid "d7c65232-c686-59ec-910b-ca36f2dc66e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3(\\sqrt{3x}+\\sqrt{5})}{3x-5}" :db/id #edb/ref 17592186521248} :answer-field/id #uuid "d44c3d89-d15d-50e0-8f58-33af07aca530" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186521433}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "39e0f80f-2c55-5d22-8bb4-e3a1b6fcdd0a" :question/math-academy-id "q-296017" :question/problem "Rationalize the denominator of $\\frac{3}{\\sqrt{3x}-\\sqrt{5}}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{3x}+\\sqrt{5}.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{3x}+\\sqrt{5},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{3}{\\sqrt{3x}-\\sqrt{5}} & = \\\\ \\frac{3}{\\sqrt{3x}-\\sqrt{5}}\\cdot \\frac{\\sqrt{3x}+\\sqrt{5}}{\\sqrt{3x}+\\sqrt{5}} & = \\\\ \\frac{3(\\sqrt{3x}+\\sqrt{5})}{(\\sqrt{3x}-\\sqrt{5})(\\sqrt{3x}+\\sqrt{5})} & = \\\\ \\frac{3(\\sqrt{3x}+\\sqrt{5})}{(\\sqrt{3x})^{2}-(\\sqrt{5})^{2}} & = \\\\ \\frac{3(\\sqrt{3x}+\\sqrt{5})}{3x-5}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186213823 :knowledge-point/_questions [{:db/id #edb/ref 17592186213018 :knowledge-point/id #uuid "fa5d982f-ff13-5a31-9cd3-d5847ea2790c" :knowledge-point/title "Rationalizing Denominators Containing a Binomial Within the Radical"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2cb8232e-74ec-5125-9023-35f18e70215d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x(\\sqrt{x+2}+4)}{x+18}" :db/id #edb/ref 17592186520859} {:answer/id #uuid "2fd21317-9259-5e13-8f0c-addab41d0918" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x(\\sqrt{x-2}-4)}{x-18}" :db/id #edb/ref 17592186520865} {:answer/id #uuid "6bed1864-1f50-54e3-8cde-8a57d07fe2d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{x-14}" :db/id #edb/ref 17592186521008} {:answer/id #uuid "c775aed0-24c4-56d0-8bf0-fec61f178576" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x(\\sqrt{x+2}-4)}{x-14}" :db/id #edb/ref 17592186521206} {:answer/id #uuid "fa7bc214-ee6d-5abf-966b-772d87f7e378" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x\\sqrt{x-2}+4}{x-14}" :db/id #edb/ref 17592186521314}] :answer-field/correct {:answer/id #uuid "c775aed0-24c4-56d0-8bf0-fec61f178576" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x(\\sqrt{x+2}-4)}{x-14}" :db/id #edb/ref 17592186521206} :answer-field/id #uuid "07b0ffea-cecd-5abf-8980-0e708de53956" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186212724}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "25d93f27-b081-516b-bfe5-d84f1819ebc3" :question/math-academy-id "q-34502" :question/problem "Rationalize the denominator of $\\frac{x}{\\sqrt{x+2}+4}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{x+2}-4.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{x+2}-4,$ and simplify:\n\n$$\n\\begin{aligned}\\frac{x}{\\sqrt{x+2}+4} & = \\\\ \\frac{x}{\\sqrt{x+2}+4}\\cdot \\frac{\\sqrt{x+2}-4}{\\sqrt{x+2}-4} & = \\\\ \\frac{x(\\sqrt{x+2}-4)}{(\\sqrt{x+2}+4)(\\sqrt{x+2}-4)} & = \\\\ \\frac{x(\\sqrt{x+2}-4)}{(\\sqrt{x+2})^{2}-{4}^{2}} & = \\\\ \\frac{x(\\sqrt{x+2}-4)}{x+2-16} & = \\\\ \\frac{x(\\sqrt{x+2}-4)}{x-14}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233966 :knowledge-point/_questions [{:db/id #edb/ref 17592186213018 :knowledge-point/id #uuid "fa5d982f-ff13-5a31-9cd3-d5847ea2790c" :knowledge-point/title "Rationalizing Denominators Containing a Binomial Within the Radical"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "69df2f53-5c50-59ae-8338-33f06671b49c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{y-3}-10}{y-7}" :db/id #edb/ref 17592186512353} {:answer/id #uuid "6c32fdae-9578-5230-9c6a-0030dc42ee0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{y+3}+10}{y-1}" :db/id #edb/ref 17592186512357} {:answer/id #uuid "97224d93-ee75-5b28-87bf-a215b4d67a60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{y+3}-10}{y+7}" :db/id #edb/ref 17592186512455} {:answer/id #uuid "c408e350-5f98-5e07-beed-90e315ab7e7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{y+3}+2}{y+1}" :db/id #edb/ref 17592186512571} {:answer/id #uuid "eb76173e-aa86-561d-80e6-1b55db1b9cdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{y-3}+2}{y-1}" :db/id #edb/ref 17592186512665}] :answer-field/correct {:answer/id #uuid "6c32fdae-9578-5230-9c6a-0030dc42ee0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{y+3}+10}{y-1}" :db/id #edb/ref 17592186512357} :answer-field/id #uuid "767f1526-f555-548a-8c1f-53ab5b15fedc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186512791}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b8bdad77-9abf-5122-8282-321bd75ae69b" :question/math-academy-id "q-34858" :question/problem "Rationalize the denominator of $\\frac{5}{\\sqrt{y+3}-2}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{y+3}+2.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{y+3}+2,$ and simplify:\n\n$$\n\\begin{aligned}\\frac{5}{\\sqrt{y+3}-2} & = \\\\ \\frac{5}{\\sqrt{y+3}-2}\\cdot \\frac{\\sqrt{y+3}+2}{\\sqrt{y+3}+2} & = \\\\ \\frac{5(\\sqrt{y+3}+2)}{(\\sqrt{y+3}-2)(\\sqrt{y+3}+2)} & = \\\\ \\frac{5\\sqrt{y+3}+10}{(\\sqrt{y+3})^{2}-{2}^{2}} & = \\\\ \\frac{5\\sqrt{y+3}+10}{y+3-4} & = \\\\ \\frac{5\\sqrt{y+3}+10}{y-1}\\end{aligned}\n$$"}]}
