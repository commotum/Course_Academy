9ca0-0b90e5590375" :knowledge-point/title "The Volume of a Cube: Word Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11f1981b-1d53-55ce-a761-5f166e2082c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25\\,\\text{m}" :db/id #edb/ref 17592186538275} {:answer/id #uuid "14dca489-0f91-55a0-bf68-7adcf14ccab0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15\\,\\text{m}" :db/id #edb/ref 17592186538276} {:answer/id #uuid "4b8621c3-6977-5948-b86c-b8688ee5238d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,\\text{m}" :db/id #edb/ref 17592186538388} {:answer/id #uuid "5827a421-dbc9-5d85-8068-f51fdc703eb2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\,\\text{m}" :db/id #edb/ref 17592186538418} {:answer/id #uuid "cf70dc22-eb11-59a8-96a7-db0856889413" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "125\\,\\text{m}" :db/id #edb/ref 17592186538712}] :answer-field/correct {:answer/id #uuid "4b8621c3-6977-5948-b86c-b8688ee5238d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,\\text{m}" :db/id #edb/ref 17592186538388} :answer-field/id #uuid "72e26c69-0806-5cf0-b6e2-a2174a616d79" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186538862}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "20052714-006e-5cb8-9e42-f681fe3b072f" :question/math-academy-id "q-107299" :question/problem "Three identical cubic tanks can hold a combined total of $375\\,{\\text{m}}^{3}$ of water.  Find the side length of a single tank." :question/worked-solution "First, we find the volume of one tank:  \n\n$$\n\\frac{375\\,{\\text{m}}^{3}}{3}=125\\,{\\text{m}}^{3}\n$$\n\nNow, we need to find the side length of a single tank.\n\nSince the volume of a cube is \n\n$$\nV={s}^{3},\n$$\n\nwhere $s$ is the length of a side, we can find $s$ as follows:\n\n$$\ns=\\sqrt[3]{V}=\\sqrt[3]{125}=5\n$$\n\nTherefore, the length of a side is $5\\,\\text{m}.$"}] [{:db/id #edb/ref 17592186539027 :knowledge-point/_questions [{:db/id #edb/ref 17592186110645 :knowledge-point/id #uuid "a98962c0-8e7b-57d7-997f-0369e2991802" :knowledge-point/title "Finding a Side Length of a Cube Given Its Volume"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "96aaa99e-4502-51ec-b979-dfbad980644d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{2}}{3}\\,\\text{yd}" :db/id #edb/ref 17592186538588} {:answer/id #uuid "be1e9eab-e11a-5125-b65e-907dffe78488" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}\\,\\text{yd}" :db/id #edb/ref 17592186538676} {:answer/id #uuid "c4be238d-21bb-523f-8eb3-52d86aa73d5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}\\,\\text{yd}" :db/id #edb/ref 17592186538687} {:answer/id #uuid "c66a3a21-4930-57d9-9299-a633aff26b16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}\\,\\text{yd}" :db/id #edb/ref 17592186538696} {:answer/id #uuid "e1f05b30-0f63-5438-99a3-75f5fa7a6c45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{3}\\,\\text{yd}" :db/id #edb/ref 17592186538749}] :answer-field/correct {:answer/id #uuid "c4be238d-21bb-523f-8eb3-52d86aa73d5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}\\,\\text{yd}" :db/id #edb/ref 17592186538687} :answer-field/id #uuid "4862371a-c7ed-5ad0-9014-0bebc76f26f4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186538841}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f8ed5ffa-b9ea-5302-ac51-cfa35a2f9ca0" :question/math-academy-id "q-118573" :question/problem "The volume of a cube is $\\frac{8}{27}\\,{\\text{yd}}^{3}.$ Find the length of the edges of the cube." :question/worked-solution "Since the volume of a cube is \n\n$$\nV={s}^{3},\n$$\n\nwhere $s$ is the length of an edge, we can find $s$ as follows:\n\n$$\ns=\\sqrt[3]{V}=\\sqrt[3]{\\frac{8}{27}}=\\frac{2}{3}\n$$\n\nTherefore, the length of the edges is $\\frac{2}{3}\\,\\text{yd}.$"}] [{:db/id #edb/ref 17592186538964 :knowledge-point/_questions [{:db/id #edb/ref 17592186110655 :knowledge-point/id #uuid "cca7a0b2-c939-52cc-9ca0-0b90e5590375" :knowledge-point/title "The Volume of a Cube: Word Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e1043c4-9142-52b2-8992-91ad1d63e682" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{21}{2}\\,{\\text{yd}}^{3}" :db/id #edb/ref 17592186538327} {:answer/id #uuid "536a338a-3b08-561d-b437-b32195834bf5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{49}{4}\\,{\\text{yd}}^{3}" :db/id #edb/ref 17592186538411} {:answer/id #uuid "61d84e0f-46af-534f-97ed-8a837fc6090c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{343}{8}\\,{\\text{yd}}^{3}" :db/id #edb/ref 17592186538449} {:answer/id #uuid "66f75452-5479-556a-a5d0-d9bcd562286f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{21}{12}\\,{\\text{yd}}^{3}" :db/id #edb/ref 17592186538462} {:answer/id #uuid "868508cb-90da-5e04-b5e6-299a168b5301" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{49\\sqrt{3}}{3}\\,{\\text{yd}}^{3}" :db/id #edb/ref 17592186538543}] :answer-field/correct {:answer/id #uuid "61d84e0f-46af-534f-97ed-8a837fc6090c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{343}{8}\\,{\\text{yd}}^{3}" :db/id #edb/ref 17592186538449} :answer-field/id #uuid "54f0d882-e045-51e5-805a-be34d10addf7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186538849}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "62d14dcd-2286-5ac0-9da8-8fd4144e472b" :question/math-academy-id "q-118657" :question/problem "Each side of a cubic room has length $\\frac{7}{2}\\,\\text{yd}.$ What is the volume of the room?" :question/worked-solution "We need to find the volume of a cube.\n\nThe volume $V$ of a cube can be found using the formula\n\n$$\nV={s}^{3},\n$$\n\nwhere $s$ is the side length of the cube.\n\nSubstituting $s=\\frac{7}{2}\\,\\text{yd}$ into the formula, we get \n\n$$\nV={(\\frac{7}{2}\\,\\text{yd})}^{3}=\\frac{343}{8}\\,{\\text{yd}}^{3}.\n$$\n\nTherefore, the volume of the room is $\\frac{343}{8}\\,{\\text{yd}}^{3}.$"}] [{:db/id #edb/ref 17592186539030 :knowledge-point/_questions [{:db/id #edb/ref 17592186110644 :knowledge-point/id #uuid "a444c03b-ed56-5331-90c0-40bd2001f980" :knowledge-point/title "Calculating the Volume of a Cube"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "287cfdae-0881-5b65-b8fe-28cebdae66dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16\\,{\\text{ cm}}^{3}" :db/id #edb/ref 17592186538316} {:answer/id #uuid "7626e945-2d11-5357-b47c-3b41a84e658a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\,{\\text{ cm}}^{3}" :db/id #edb/ref 17592186538499} {:answer/id #uuid "841e4ed6-5555-5dd0-93ba-940e7223193e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,{\\text{ 