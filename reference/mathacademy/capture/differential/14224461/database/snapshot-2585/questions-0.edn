#{[{:db/id #edb/ref 17592186110519 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110644 :knowledge-point/id #uuid "a444c03b-ed56-5331-90c0-40bd2001f980" :knowledge-point/title "Calculating the Volume of a Cube"}] :question/id #uuid "333792dd-67b0-5673-821a-304ad5011c62" :question/math-academy-id "e-7177" :question/problem "![](images/3f/3f3ac69cc09fd70f0cbcd67e4b6b64ca1a364be471fda6ccb3a9e42bb991e44c.png)\n\nWhat is the volume of the cube?" :question/worked-solution "The volume $V$ of a cube can be found using the formula\n\n$$\nV = s^3\n$$\n\nwhere $s$ is the side length of the cube.\n\nSubstituting\n\n$$\ns=4\\,\\textrm{cm}\n$$\n\ninto the formula, we get\n\n$$\nV = (4\\, \\textrm{cm})^3 = 64\\, \\textrm{cm}^3\n$$"}] [{:db/id #edb/ref 17592186110520 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110645 :knowledge-point/id #uuid "a98962c0-8e7b-57d7-997f-0369e2991802" :knowledge-point/title "Finding a Side Length of a Cube Given Its Volume"}] :question/id #uuid "0d03e2bd-c8a2-5a16-a5b2-b51dbf9e408a" :question/math-academy-id "e-7178" :question/problem "The volume of a cube is $729\\, \\textrm{cm}^3$. Find the length of the edges of the cube." :question/worked-solution "Since the volume of a cube is\n\n$$\nV = s^3\n$$\n\nwhere $s$ is the length of an edge, we can find $s$ as follows:\n\n$$\ns = \\sqrt[3]{V} = \\sqrt[3]{729} = 9\n$$\n\nTherefore, the length of the edges is $9\\,\\textrm{cm}$."}] [{:db/id #edb/ref 17592186110539 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110655 :knowledge-point/id #uuid "cca7a0b2-c939-52cc-9ca0-0b90e5590375" :knowledge-point/title "The Volume of a Cube: Word Problems"}] :question/id #uuid "f265fcf1-8d50-5908-8df4-6df66cb0673a" :question/math-academy-id "e-8977" :question/problem "Six identical plastic cubic containers have a combined volume of $48 \\: \\textrm{ft}^3$. Find the side length of a single container." :question/worked-solution "First, we find the volume of a single container:\n\n$$\n\\dfrac{48 \\: \\textrm{ft}^3}{6} = 8 \\: \\textrm{ft}^3\n$$\n\nNow, we need to find the side length of one container.\n\nSince the volume of a cube is\n\n$$\nV = s^3\n$$\n\nwhere $s$ is the length of a side, we can find $s$ as follows:\n\n$$\ns = \\sqrt[3]{V} = \\sqrt[3]{8} = 2\n$$\n\nTherefore, the length of a side of a single container is $2\\,\\textrm{ft}$."}] [{:db/id #edb/ref 17592186110884 :knowledge-point/_questions [{:db/id #edb/ref 17592186110644 :knowledge-point/id #uuid "a444c03b-ed56-5331-90c0-40bd2001f980" :knowledge-point/title "Calculating the Volume of a Cube"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bd225fbe-ee1b-5b54-a4fb-48314eb1852d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "400in^{3}" :db/id #edb/ref 17592186107196} {:answer/id #uuid "ce04a3c9-b809-582f-af9a-9baba304801b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4000in^{3}" :db/id #edb/ref 17592186107197} {:answer/id #uuid "cf2ce410-35ef-50d1-a7f5-ed82e5f96ec1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16in^{3}" :db/id #edb/ref 17592186107198} {:answer/id #uuid "d6992582-80fb-5ca0-8a5f-1588fca2c424" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "64in^{3}" :db/id #edb/ref 17592186107199} {:answer/id #uuid "047ec144-13aa-50d5-af87-8297ac786f9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24in^{3}" :db/id #edb/ref 17592186107200}] :answer-field/id #uuid "0d0f2305-80f2-5165-81bc-14e814122e4d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186107195}] :question/id #uuid "6c758199-4cfb-5d27-aa04-39e26323982d" :question/math-academy-id "q-107177" :question/problem "Find the volume of the cube whose sides each have length $4in$."}] [{:db/id #edb/ref 17