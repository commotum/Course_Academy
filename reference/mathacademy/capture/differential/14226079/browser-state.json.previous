tchy=\"false\">⟨</mo><mn>4</mn><mo>,</mo><mn>0</mn><mo>,</mo><mo>−</mo><mn>1</mn><mo fence=\"false\" stretchy=\"false\">⟩</mo></mtd></mtr><mtr><mtd><mover><mrow><mi>A</mi><mi>C</mi></mrow><mo>→</mo></mover></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">c</mi></mrow><mo>−</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">a</mi></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo stretchy=\"false\">(</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">i</mi></mrow><mo>−</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">j</mi></mrow><mo>+</mo><mn>2</mn><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">k</mi></mrow><mo stretchy=\"false\">)</mo><mo>−</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mn>2</mn><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">i</mi></mrow><mo>+</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">j</mi></mrow><mo>+</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">k</mi></mrow><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>3</mn><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">i</mi></mrow><mo>−</mo><mn>2</mn><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">j</mi></mrow><mo>+</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">k</mi></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo fence=\"false\" stretchy=\"false\">⟨</mo><mn>3</mn><mo>,</mo><mo>−</mo><mn>2</mn><mo>,</mo><mn>1</mn><mo fence=\"false\" stretchy=\"false\">⟩</mo></mtd></mtr><mtr><mtd><mover><mrow><mi>A</mi><mi>D</mi></mrow><mo>→</mo></mover></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">d</mi></mrow><mo>−</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">a</mi></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo stretchy=\"false\">(</mo><mn>3</mn><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">i</mi></mrow><mo>−</mo><mn>2</mn><