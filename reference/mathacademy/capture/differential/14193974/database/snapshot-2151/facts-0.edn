45417] [17592186124589 #edb/ref 1041 #edb/ref 17592186124400 #edb/ref 17592186045417] [17592186124589 #edb/ref 1042 #uuid "099e7caf-085a-5fd5-ad3d-1ebf189527b7" #edb/ref 17592186045417] [17592186124628 #edb/ref 1037 #edb/ref 17592186049304 #edb/ref 17592186045417] [17592186124628 #edb/ref 1037 #edb/ref 17592186049755 #edb/ref 17592186045417] [17592186124628 #edb/ref 1037 #edb/ref 17592186050782 #edb/ref 17592186045417] [17592186124628 #edb/ref 1037 #edb/ref 17592186050979 #edb/ref 17592186045417] [17592186124628 #edb/ref 1038 #edb/ref 17592186125240 #edb/ref 17592186045417] [17592186124628 #edb/ref 1038 #edb/ref 17592186125241 #edb/ref 17592186045417] [17592186124628 #edb/ref 1038 #edb/ref 17592186278339 #edb/ref 17592186045417] [17592186124628 #edb/ref 1038 #edb/ref 17592186278340 #edb/ref 17592186045417] [17592186124628 #edb/ref 1038 #edb/ref 17592186278341 #edb/ref 17592186045417] [17592186124628 #edb/ref 1038 #edb/ref 17592186278342 #edb/ref 17592186045417] [17592186124628 #edb/ref 1038 #edb/ref 17592186281458 #edb/ref 17592186045417] [17592186124628 #edb/ref 1038 #edb/ref 17592186323707 #edb/ref 17592186045417] [17592186124628 #edb/ref 1038 #edb/ref 17592186329743 #edb/ref 17592186045417] [17592186124628 #edb/ref 1038 #edb/ref 17592186440653 #edb/ref 17592186045417] [17592186124628 #edb/ref 1038 #edb/ref 17592186440654 #edb/ref 17592186045417] [17592186124628 #edb/ref 1038 #edb/ref 17592186440655 #edb/ref 17592186045417] [17592186124628 #edb/ref 1038 #edb/ref 17592186445223 #edb/ref 17592186045417] [17592186124628 #edb/ref 1039 "Identifying Sets Closed Under Addition and Scalar Multiplication" #edb/ref 17592186045417] [17592186124628 #edb/ref 1041 #edb/ref 17592186124432 #edb/ref 17592186045417] [17592186124628 #edb/ref 1042 #uuid "cb02b67c-90d9-5baf-b00e-590e9271d89e" #edb/ref 17592186045417] [17592186124706 #edb/ref 1043 #edb/ref 17592186125341 #edb/ref 17592186045417] [17592186124706 #edb/ref 1043 #edb/ref 17592186125342 #edb/ref 17592186045417] [17592186124706 #edb/ref 1043 #edb/ref 17592186125521 #edb/ref 17592186045417] [17592186124706 #edb/ref 1043 #edb/ref 17592186125522 #edb/ref 17592186045417] [17592186124706 #edb/ref 1043 #edb/ref 17592186125523 #edb/ref 17592186045417] [17592186124706 #edb/ref 1043 #edb/ref 17592186125590 #edb/ref 17592186045417] [17592186124706 #edb/ref 1043 #edb/ref 17592186125600 #edb/ref 17592186045417] [17592186124706 #edb/ref 1043 #edb/ref 17592186125601 #edb/ref 17592186045417] [17592186124706 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186124706 #edb/ref 1045 "Introduction to Abstract Vector Spaces" #edb/ref 17592186045417] [17592186124706 #edb/ref 1046 #edb/ref 17592186125523 #edb/ref 17592186045417] [17592186124706 #edb/ref 1049 #edb/ref 17592186049737 #edb/ref 17592186045417] [17592186124706 #edb/ref 1050 600.0 #edb/ref 17592186045417] [17592186124706 #edb/ref 1050 600.0 #edb/ref 17592186045436] [17592186124706 #edb/ref 1053 #uuid "27341ce7-bad3-5506-8e90-5fea806b76fd" #edb/ref 17592186045417] [17592186124765 #edb/ref 1068 #edb/ref 17592186121187 #edb/ref 17592186045417] [17592186124765 #edb/ref 1069 "q-106686" #edb/ref 17592186045417] [17592186124765 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186124765 #edb/ref 1071 "Let $D$ be the set of all $2\\times 2$ matrices of the form $[\\begin{aligned}a & 0 \\\\ 0 & a\\end{aligned}],$ where $a\\in R.$ Which of the following statements are true?  \n\nI. The identity matrix ${I}_{2}=[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]$ belongs to $D.$\n\nII. For the zero matrix $O$ and any $A,B\\in D,$ we have $A+O=O.$\n\nIII. For any $A,B\\in D,$ we have $A+B=B+A.$" #edb/ref 17592186045417] [17592186124765 #edb/ref 1072 #uuid "182848d0-78bc-53b7-9635-9bc3cbac2ccc" #edb/ref 17592186045417] [17592186124765 #edb/ref 1074 "Let's examine each statement in turn.\n\n- Statement I is true. Indeed, every element $A$ in $D$ satisfies ${a}_{12}={a}_{21}=0$ and ${a}_{11}={a}_{22}.$ So, ${I}_{2}=[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]\\in D.$\n\n- Statement II is false. For example, consider the identity matrix ${I}_{2}=[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]\\in D.$ Then\n\n$$\n{I}_{2}+O=[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]+[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}]=[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]\\ne O.\n$$\n\n- Statement III is true. Indeed, For any matrices $A,B\\in D,$ we obtain that \n\n$$\nA+B=B+A\n$$\n\nsince matrix addition is commutative.\n\nTherefore, the correct answer is \"I and III only.\"" #edb/ref 17592186045417] [17592186125341 #edb/ref 1058 #edb/ref 17592186125342 #edb/ref 17592186045417] [17592186125341 #edb/ref 1061 17452 #edb/ref 17592186045417] [17592186125341 #edb/ref 1062 #uuid "f746dfa7-8c4b-5575-86b0-34ab4d9d09e6" #edb/ref 17592186045417] [17592186125341 #edb/ref 1063 #edb/ref 17592186125759 #edb/ref 17592186045417] [17592186125342 #edb/ref 1058 #edb/ref 17592186125522 #edb/ref 17592186045417] [17592186125342 #edb/ref 1061 17454 #edb/ref 17592186045417] [17592186125342 #edb/ref 1062 #uuid "22604921-be1a-5e8f-bdd7-8ac9e59c63a0" #edb/ref 17592186045417] [17592186125342 #edb/ref 1063 #edb/ref 17592186124484 #edb/ref 17592186045417] [17592186125521 #edb/ref 1058 #edb/ref 17592186125601 #edb/ref 17592186045417] [17592186125521 #edb/ref 1061 30785 #edb/ref 17592186045417] [17592186125521 #edb/ref 1062 #uuid "7b0d0289-9feb-5b9b-9cdf-8e8bea357afd" #edb/ref 17592186045417] [17592186125521 #edb/ref 1063 #edb/ref 17592186124589 #edb/ref 17592186045417] [17592186125522 #edb/ref 1058 #edb/ref 17592186125521 #edb/ref 17592186045417] [17592186125522 #edb/ref 1061 30789 #edb/ref 17592186045417] [17592186125522 #edb/ref 1062 #uuid "605b2c91-28e4-589e-9ea6-93545635ab1c" #edb/ref 17592186045417] [17592186125522 #edb/ref 1063 #edb/ref 17592186125832 #edb/ref 17592186045417] [17592186125523 #edb/ref 1058 #edb/ref 17592186125600 #edb/ref 17592186045417] [17592186125523 #edb/ref 1061 30790 #edb/ref 17592186045417] [17592186125523 #edb/ref 1062 #uuid "befa8020-1248-59aa-b092-5fd7f5b45c2e" #edb/ref 17592186045417] [17592186125523 #edb/ref 1063 #edb/ref 17592186125833 #edb/ref 17592186045417] [17592186125590 #edb/ref 1058 #edb/ref 17592186125341 #edb/ref 17592186045417] [17592186125590 #edb/ref 1061 37506 #edb/ref 17592186045417] [17592186125590 #edb/ref 1062 #uuid "78f1d4af-7528-5705-8b7b-224b627efd47" #edb/ref 17592186045417] [17592186125590 #edb/ref 1063 #edb/ref 17592186124628 #edb/ref 17592186045417] [17592186125600 #edb/ref 1058 #edb/ref 17592186125590 #edb/ref 17592186045417] [17592186125600 #edb/ref 1061 37838 #edb/ref 17592186045417] [17592186125600 #edb/ref 1062 #uuid "1402186a-b64d-5406-9767-99815ff7ecc1" #edb/ref 17592186045417] [17592186125600 #edb/ref 1063 #edb/ref 17592186125860 #edb/ref 17592186045417] [17592186125601 #edb/ref 1061 37839 #edb/ref 17592186045417] [17592186125601 #edb/ref 1062 #uuid "be30c408-bfbc-549b-b14c-3f8724059c1b" #edb/ref 17592186045417] [17592186125601 #edb/ref 1063 #edb/ref 17592186125861 #edb/ref 17592186045417] [17592186125759 #edb/ref 1064 "Let's now compare some properties of addition in $\\mathbb{R}^2$ and $\\text{M}_2(\\mathbb{R}).$ \nIt turns out that the addition of two matrices in $\\mathrm{M}_2(\\mathbb{R})$ is *very* similar to the addition of two vectors in $\\mathbb{R}^n.$ See the table below.\n\n<table align=\"center\" cellpadding=\"10\" rules=\"all\" width=\"700\">\n<tbody><tr>\n<td align=\"center\" width=\"30\"><b></b></td>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"200\"><b>$\\mathbb{R}^2$</b></td>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"200\"><b>$\\text{M}_2(\\mathbb{R})$</b></td>\n</tr>\n<tr>\n<td align=\"center\" colspan=\"3\"><strong>Addition is Commutative:</strong></td>\n</tr>\n<tr>\n<td align=\"center\" bgcolor=\"#D6EAF8\">A1</td>\n<td align=\"center\">For any vectors $\\mathbf{u}, \\mathbf{v} \\in \\mathbb{R}^2,$ we have $\\color{blue}\\mathbf{u}+\\mathbf{v} = \\mathbf{v}+\\mathbf{u}$</td>\n<td align=\"center\">For any matrices $A, B \\in \\text{M}_2(\\mathbb{R}),$ we have $\\color{blue}A+B = B+A$</td>\n</tr>\n<tr>\n<td align=\"center\" colspan=\"3\"><strong>Addition is Associative:</strong></td>\n</tr>\n<tr>\n<td align=\"center\" bgcolor=\"#D6EAF8\">A2</td>\n<td align=\"center\">For any vectors $\\mathbf{u}, \\mathbf{v}, \\mathbf{w} \\in \\mathbb{R}^2,$ we have $\\color{blue}(\\mathbf{u}+\\mathbf{v})+\\mathbf{w} = \\mathbf{u}+(\\mathbf{v}+\\mathbf{w})$</td>\n<td align=\"center\">For any matrices $A, B, C \\in \\text{M}_2(\\mathbb{R}),$ we have $\\color{blue}(A+B) + C = A + (B+C)$</td>\n</tr>\n<tr>\n<td align=\"center\" colspan=\"3\"><strong>Existence of a Unique Zero Element:</strong></td>\n</tr>\n<tr>\n<td align=\"center\" bgcolor=\"#D6EAF8\">A3</td>\n<td align=\"center\">For the zero-vector $\\mathbf{0}$ and any $\\mathbf{u} \\in \\mathbb{R}^2,$ we have $\\color{blue} \\mathbf{u} + \\mathbf{0} = \\mathbf{u}$</td>\n<td align=\"center\">For the zero-matrix $O$ and any $A \\in \\text{M}_2(\\mathbb{R}),$ we have $\\color{blue} A + O = A$</td>\n</tr>\n<tr>\n<td align=\"center\" colspan=\"3\"><strong>Existence of a Unique Opposite Element:</strong></td>\n</tr>\n<tr><td align=\"center\" bgcolor=\"#D6EAF8\">A4</td>\n<td align=\"center\">For any vector $\\mathbf{u} \\in \\mathbb{R}^2$ we can find the corresponding negative vector $-\\mathbf{u} \\in \\mathbb{R}$ such that $\\color{blue} \\mathbf{u} + (-\\mathbf{u}) = \\mathbf{0}$</td>\n<td align=\"center\">For any matrix $A \\in \\text{M}_2(\\mathbb{R})$ we can find the corresponding negative matrix $-A \\in \\text{M}_2(\\mathbb{R})$ such that $\\color{blue} A + (-A) = O$</td>\n</tr>\n</tbody></table>\n\nAnd it's not just matrices that have additive properties similar to those of $\\mathbb R^n.$ Many mathematical structures do. Let's see some more examples." #edb/ref 17592186045417] [17592186125759 #edb/ref 1065 3184 #edb/ref 17592186045417] [17592186125759 #edb/ref 1066 #uuid "e21e1a72-75b8-5ae3-9b7d-96f08d2ffa86" #edb/ref 17592186045417] [17592186125759 #edb/ref 1067 "Addition of Vectors" #edb/ref 17592186045417] [17592186125832 #edb/ref 1064 "Let's also compare some properties of scalar multiplication in $\\mathbb{R}^2$ and $\\text{M}_2(\\mathbb{R}).$ It turns out that the multiplication of a matrix in $\\mathrm{M}_2(\\mathbb{R})$ by a scalar is *very* similar to the multiplication of a vector in $\\mathbb{R}^n$ by a real number. See the table below.\n\n<table align=\"center\" cellpadding=\"10\" rules=\"all\" width=\"700\">\n<tbody><tr>\n<td align=\"center\" width=\"30\"><b></b></td>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"200\"><b>$\\mathbb{R}^2$</b></td>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"200\"><b>$\\text{M}_2(\\mathbb{R})$</b></td>\n</tr>\n<tr>\n<td align=\"center\" colspan=\"3\"><strong>Invariance Under Multiplication by $1$:</strong></td>\n</tr>\n<tr><td align=\"center\" bgcolor=\"#D6EAF8\">A5</td>\n<td align=\"center\">For any vector $\\mathbf{u} \\in \\mathbb{R}^2$, we have $\\color{blue} 1 \\cdot \\mathbf{u} = \\mathbf{u}$</td>\n<td align=\"center\">For any matrix $A \\in \\text{M}_2(\\mathbb{R})$, we have $\\color{blue} 1 \\cdot A = A$</td>\n</tr>\n<tr>\n<td align=\"center\" colspan=\"3\"><strong>Scalar Multiplication is Associative:</strong></td>\n</tr>\n<tr><td align=\"center\" bgcolor=\"#D6EAF8\">A6</td>\n<td align=\"center\">For any numbers $\\alpha, \\beta$ and any vector $\\mathbf{u} \\in \\mathbb{R}^2$, we have $\\color{blue} \\alpha (\\beta \\mathbf{u}) = (\\alpha\\beta) \\mathbf{u}$</td>\n<td align=\"center\">For any numbers $\\alpha, \\beta$ and any matrix $A \\in \\text{M}_2(\\mathbb{R})$, we have $\\color{blue} \\alpha (\\beta A) = (\\alpha\\beta) A$</td>\n</tr>\n<tr>\n<td align=\"center\" colspan=\"3\"><strong>Distributive Laws:</strong></td>\n</tr>\n<tr><td align=\"center\" bgcolor=\"#D6EAF8\">A7</td>\n<td align=\"center\">For any numbers $\\alpha, \\beta$ and any vector $\\mathbf{u} \\in \\mathbb{R}^2$, we have $\\color{blue} (\\alpha + \\beta)\\mathbf{u} = \\alpha \\mathbf{u} + \\beta \\mathbf{u}$</td>\n<td align=\"center\">For any numbers $\\alpha, \\beta$ and any matrix $A \\in \\text{M}_2(\\mathbb{R})$, we have $\\color{blue} (\\alpha + \\beta)A = \\alpha A + \\beta A$</td>\n</tr>\n<tr><td align=\"center\" bgcolor=\"#D6EAF8\">A8</td>\n<td align=\"center\">For any number $\\alpha$ and any vectors $\\mathbf{u}, \\mathbf{v} \\in \\mathbb{R}^2$, we have $\\color{blue} \\alpha (\\mathbf{u} + \\mathbf{v}) = \\alpha \\mathbf{u} + \\alpha \\mathbf{v}$</td>\n<td align=\"center\">For any number $\\alpha$ and any matrices $A, B \\in \\text{M}_2(\\mathbb{R})$, we have $\\color{blue} \\alpha (A + B) = \\alpha A + \\alpha B$</td>\n</tr>\n</tbody></table>" #edb/ref 17592186045417] [17592186125832 #edb/ref 1065 4934 #edb/ref 17592186045417] [17592186125832 #edb/ref 1066 #uuid "05cdf1b2-a823-5410-8df1-42fa4da19240" #edb/ref 17592186045417] [17592186125832 #edb/ref 1067 "Scalar Multiplication and the Distributive Laws" #edb/ref 17592186045417] [17592186125833 #edb/ref 1064 "The structure $\\mathbb{R}^n$ is called a **vector space**. However, many other structures possess properties similar to $\\mathbb{R}^n.$ These other structures can be called vector spaces too. \n\nIn this lesson, we'll learn about some important properties used to construct vector spaces. We begin by discussing what it means for a set to be **closed** under addition and scalar multiplication.\n\nAs an example, consider the set $\\mathrm{M}_2(\\mathbb{R})$ of all $2 \\times 2$ matrices with real entries:\n\n![](images/a5/a53ec7e9416ae5eee4a1408df358302567a5aa98a393d6ddcb19e861645d2317.svg)\n\nFor this set of matrices, we can define two operations:\n\n- the addition of two matrices, and\n\n- the multiplication of a matrix by a real number (called a scalar).\n\nNow, notice the following:\n\n- $\\mathrm{M}_2(\\mathbb{R})$ is **closed under addition**. This means that the sum of *any* two matrices from $\\mathrm{M}_2(\\mathbb{R})$ is also a matrix in $\\mathrm{M}_2(\\mathbb{R}).$\n\n- $\\mathrm{M}_2(\\mathbb{R})$ is **closed under scalar multiplication**. This means that the product of *any* scalar and *any* matrix from $\\mathrm{M}_2(\\mathbb{R})$ is also a matrix in $\\mathrm{M}_2(\\mathbb{R}).$\n\nIdentifying that a set is closed under addition and scalar multiplication is an essential first step in determining whether a set can form a vector space." #edb/ref 17592186045417] [17592186125833 #edb/ref 1065 4935 #edb/ref 17592186045417] [17592186125833 #edb/ref 1066 #uuid "18653f19-b4cf-5f0f-ab39-b1ae33ecdc6b" #edb/ref 17592186045417] [17592186125833 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186125860 #edb/ref 1064 "It's important to realize that not all sets are closed under addition and scalar multiplication. Sets not closed under addition and scalar multiplication *cannot* be vector spaces. \n\nFor instance, let $S$ be the set of all polynomials with real coefficients whose degree is greater than or equal to $5.$  \n\nWe note that $S$ is not closed under addition. To see why this is the case, let's define the polynomials $p(x),q(x)\\in S$ as \n\n$$\np(x) = x^5, \\qquad q(x) = 1-x^5.\n$$\n\nAdding the two polynomials using regular polynomial addition, we get\n\n$$\np(x) + q(x) = x^5 + (1-x^5) = 1\\notin S\n$$\n\nThe sum $p(x) + q(x)$ is not in $S$ because it is a polynomial of degree zero, which is less than $5.$\n\nTherefore, we conclude that our set $S$ is *not* closed under addition." #edb/ref 17592186045417] [17592186125860 #edb/ref 1065 6230 #edb/ref 17592186045417] [17592186125860 #edb/ref 1066 #uuid "b014039e-61b6-58d7-8f35-a72e6153c126" #edb/ref 17592186045417] [17592186125860 #edb/ref 1067 "Sets That Are Not Closed" #edb/ref 17592186045417] [17592186125861 #edb/ref 1064 "In this lesson, we discussed several properties exhibited by vectors in $\\mathbb R^n$ and other sets.\nLet's consolidate these properties into a single list.\n\n| **Label** | **Name** | **Description** |\n| --- | --- | --- |\n| A1 | **Addition is Commutative** | For any vectors $\\mathbf{u}, \\mathbf{v} \\in \\mathbb{R}^2,$ we have $\\color{blue}\\mathbf{u}+\\mathbf{v} = \\mathbf{v}+\\mathbf{u}$ |\n| A2 | **Addition is Associative** | For any vectors $\\mathbf{u}, \\mathbf{v}, \\mathbf{w} \\in \\mathbb{R}^2,$ we have $\\color{blue}(\\mathbf{u}+\\mathbf{v})+\\mathbf{w} = \\mathbf{u}+(\\mathbf{v}+\\mathbf{w})$ |\n| A3 | **Existence of a Unique Zero Element** | For the zero-vector $\\mathbf{0}$ and any $\\mathbf{u} \\in \\mathbb{R}^2,$ we have $\\color{blue} \\mathbf{u} + \\mathbf{0} = \\mathbf{u}$ |\n| A4 | **Existence of a Unique Opposite Element** | For any vector $\\mathbf{u} \\in \\mathbb{R}^2$ we can find the corresponding negative vector $-\\mathbf{u} \\in \\mathbb{R}$ such that $\\color{blue} \\mathbf{u} + (-\\mathbf{u}) = \\mathbf{0}$ |\n| A5 | **Invariance Under Multiplication by $1$** | For any vector $\\mathbf{u} \\in \\mathbb{R}^2$, we have $\\color{blue} 1 \\cdot \\mathbf{u} = \\mathbf{u}$ |\n| A6 | **Scalar Multiplication is Associative** | For any numbers $\\alpha, \\beta$ and any vector $\\mathbf{u} \\in \\mathbb{R}^2$, we have $\\color{blue} \\alpha (\\beta \\mathbf{u}) = (\\alpha\\beta) \\mathbf{u}$ |\n| A7 | **Distributive Laws:** | For any numbers $\\alpha, \\beta$ and any vector $\\mathbf{u} \\in \\mathbb{R}^2$, we have $\\color{blue} (\\alpha + \\beta)\\mathbf{u} = \\alpha \\mathbf{u} + \\beta \\mathbf{u}$ |\n| A8 | **Distributive Laws:** | For any number $\\alpha$ and any vectors $\\mathbf{u}, \\mathbf{v} \\in \\mathbb{R}^2$, we have $\\color{blue} \\alpha (\\mathbf{u} + \\mathbf{v}) = \\alpha \\mathbf{u} + \\alpha \\mathbf{v}$ |\n\nWe'll meet these properties again in a future lesson, where we'll formally define what we mean by a vector space." #edb/ref 17592186045417] [17592186125861 #edb/ref 1065 6231 #edb/ref 17592186045417] [17592186125861 #edb/ref 1066 #uuid "72e9ea87-7b8e-5d00-821a-31813b203a2b" #edb/ref 17592186045417] [17592186125861 #edb/ref 1067 "A Summary of the Addition and Scalar Multiplication Properties of Euclidian Space" #edb/ref 17592186045417] [17592186281526 #edb/ref 1068 #edb/ref 17592186450990 #edb/ref 17592186045436] [17592186281526 #edb/ref 1068 #edb/ref 17592186450991 #edb/ref 17592186045436] [17592186281526 #edb/ref 1068 #edb/ref 17592186450992 #edb/ref 17592186045436] [17592186281526 #edb/ref 1069 "q-162665" #edb/ref 17592186045417] [17592186281526 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186281526 #edb/ref 1071 "Let $S$ be the set of all polynomials with real coefficients and whose degree is at most $2.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $\\frac{1}{{x}^{2}}\\in S$\n- **II.** For any $p(x)\\in S,$ we have $(-1)\\cdot p(x)\\in S$\n- **III.** For any $p(x),q(x)\\in S$ and $\\alpha \\in R,$ we have $\\alpha (p(x)-q(x))=\\alpha p(x)-\\alpha q(x)$" #edb/ref 17592186045436] [17592186281526 #edb/ref 1072 #uuid "69e25145-91f1-58d1-afd8-be54a0c5863e" #edb/ref 17592186045417] [17592186281526 #edb/ref 1074 "Let's examine each of our statements in turn.\n\n- Statement I is false. The set $S$ contains only polynomials whose degree is at most $2.$ However, $\\frac{1}{{x}^{2}}$ is *not* a polynomial. So, $\\frac{1}{{x}^{2}}\\notin S.$\n\n- Statement II is true. Let $deg(q)$ the degree of a polynomial $q.$ Then, for any $p(x)\\in S$ we have that $(-1)\\cdot p(x)$ is also a polynomial, and that\n\n$$\ndeg((-1)\\cdot p)=deg(-1)+deg(p)=0+deg(p)\\le 2.\n$$\n\nHence, $(-1)p(x)\\in S.$\n\n- Statement III is true. Indeed, for any $p(x),q(x)\\in S$ and for any fixed $x\\in R,$ the values $p(x)$ and $q(x)$ are just real numbers. Thus, for any $\\alpha \\in R,$ we obtain that\n\n$$\n\\alpha (p(x)-q(x))=\\alpha p(x)-\\alpha q(x).\n$$\n\nTherefore, the correct answer is \"II and III only.\"" #edb/ref 17592186045417] [17592186281527 #edb/ref 1068 #edb/ref 17592186450993 #edb/ref 17592186045436] [17592186281527 #edb/ref 1068 #edb/ref 17592186450994 #edb/ref 17592186045436] [17592186281527 #edb/ref 1068 #edb/ref 17592186450995 #edb/ref 17592186045436] [17592186281527 #edb/ref 1069 "q-162668" #edb/ref 17592186045417] [17592186281527 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186281527 #edb/ref 1071 "Let $Y$ be the set of all $2\\times 2$ real matrices with determinant $1.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** For any $A\\in Y,$ we have $(-1)\\cdot A=-A.$\n- **II.** For any $A\\in Y$ and $\\alpha ,\\beta \\in R,$ we have $(\\alpha +\\beta )A=\\alpha A+\\beta A.$\n- **III.** For any $A\\in Y$ we have $2A\\in Y.$" #edb/ref 17592186045436] [17592186281527 #edb/ref 1072 #uuid "2124447c-ee22-58ee-9afe-87a9532907c6" #edb/ref 17592186045417] [17592186281527 #edb/ref 1074 "Let's examine each of our statements in turn.\n\n- Statement I is true. Indeed, for any $2\\times 2$ matrix $A=({a}_{ij})\\in Y,$ the entries are just real numbers. Thus, we have\n\n$$\n(-1)\\cdot {a}_{ij}=-{a}_{ij},\n$$\n\nand hence,\n\n$$\n(-1)\\cdot A=-A.\n$$\n\n- Statement II is true. Indeed, for any $2\\times 2$ matrix $A=({a}_{ij})\\in Y,$ the entries are just real numbers. Thus, for any $\\alpha ,\\beta \\in R,$ we obtain that\n\n$$\n(\\alpha +\\beta ){a}_{ij}=\\alpha {a}_{ij}+\\beta {a}_{ij},\n$$\n\nand hence,\n\n$$\n(\\alpha +\\beta )A=\\alpha A+\\beta A.\n$$\n\n- Statement III is false. For example, the identity matrix ${I}_{2}=[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]\\in Y,$ however $2{I}_{2}\\notin Y$ because\n\n$$\n|2{I}_{2}|=|2[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]|=|\\begin{aligned}2 & 0 \\\\ 0 & 2\\end{aligned}|=2\\cdot 2-0\\cdot 0=4\\ne 1.\n$$\n\nTherefore, the correct answer is \"I and II only.\"" #edb/ref 17592186045417] [17592186360469 #edb/ref 1068 #edb/ref 17592186452856 #edb/ref 17592186045436] [17592186360469 #edb/ref 1068 #edb/ref 17592186452857 #edb/ref 17592186045436] [17592186360469 #edb/ref 1068 #edb/ref 17592186452858 #edb/ref 17592186045436] [17592186360469 #edb/ref 1069 "q-94649" #edb/ref 17592186045417] [17592186360469 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186360469 #edb/ref 1071 "Let $N$ be the set of all functions $f:R\\to R$ such that $f(0)=0.$  Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The constant function $f(x)=1$ for all $x\\in R$ belongs to $N.$\n- **II.** For any $f(t),g(t)\\in N,$ we have $f(t)-g(t)=g(t)-f(t).$\n- **III.** The addition of functions in $N$ is commutative." #edb/ref 17592186045436] [17592186360469 #edb/ref 1072 #uuid "7ff3e8b0-9d12-58ec-aef1-61a782559716" #edb/ref 17592186045417] [17592186360469 #edb/ref 1074 "Let's verify the statements one by one.\n\n- Statement I is false. The set $N$ contains only functions that evaluate to zero at zero. However, the function defined by $f(x)=1$ for all $x\\in R$ satisfies $f(0)=1\\ne 0.$ So, $f\\notin N.$\n\n- Statement II is false. For example, consider functions $f(t)=2t$ and $g(t)=t$ in $N.$ Then:\n\n$$\n\\begin{aligned}f(t)-g(t) & =2t-t \\\\  & =t \\\\ g(t)-f(t) & =t-2t \\\\  & =-t\\end{aligned}\n$$\n\nHence, $f(t)-g(t)\\ne g(t)-f(t).$\n\n- Statement III is true. Indeed, for any functions $f(t),g(t)\\in N,$ we obtain that \n\n$$\nf(t)+g(t)=g(t)+f(t)\n$$\n\nsince the addition of functions is commutative.\n\nTherefore, the correct answer is \"III only.\"" #edb/ref 17592186045417] [17592186408166 #edb/ref 10 :answer-field.type/checkbox #edb/ref 17592186045416] [17592186426537 #edb/ref 1043 #edb/ref 17592186426552 #edb/ref 17592186045417] [17592186426537 #edb/ref 1043 #edb/ref 17592186426553 #edb/ref 17592186045417] [17592186426537 #edb/ref 1043 #edb/ref 17592186426554 #edb/ref 17592186045417] [17592186426537 #edb/ref 1043 #edb/ref 17592186426555 #edb/ref 17592186045417] [17592186426537 #edb/ref 1043 #edb/ref 17592186426556 #edb/ref 17592186045417] [17592186426537 #edb/ref 1044 #edb/ref 17592186045464 #edb/ref 17592186045417] [175921864