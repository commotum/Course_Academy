    "q-71932": {
      "dom_id": "step-q71932",
      "name": "Question 4",
      "problem": "Evaluate the double integral ${∬}_{R}\\operatorname{sin}⁡x\\text{ }{e}^{y}\\,\\text{d}A$ over the rectangle $R=[0,\\pi ]\\times [0,1].$",
      "worked_solution": "We apply the multiplicative property of double integrals and then evaluate each of the integrals separately:\n\n$$\n\\begin{aligned}{∬}_{R}\\operatorname{sin}⁡x\\text{ }{e}^{y}\\,\\text{d}A & ={∬}_{R}(\\operatorname{sin}⁡x)\\text{ }({e}^{y})\\,\\text{d}A \\\\  & =({\\int }_{0}^{\\pi }\\operatorname{sin}⁡x\\,\\text{d}x)({\\int }_{0}^{1}{e}^{y}\\,\\text{d}y) \\\\  & =[-\\operatorname{cos}⁡x]_{0}^{\\pi }\\cdot [{e}^{y}]_{0}^{1} \\\\  & =-(\\operatorname{cos}⁡\\pi -\\operatorname{cos}⁡0)\\cdot ({e}^{1}-{e}^{0}) \\\\  & =-(-1-1)\\cdot (e-1) \\\\  & =2(e-1)\\end{aligned}\n$$",
      "calculator_instructions": "",
