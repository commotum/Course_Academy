  "live_records": {
    "q-129935": {
      "dom_id": "step-q129935",
      "name": "Question 1",
      "problem": "Which of the following gives the value of the double integral ${∬}_{R}y{x}^{2}{3}^{x+y}\\text{ }\\text{d}A$ over the rectangle $R=[1,3]\\times [0,2]?$",
      "worked_solution": "We apply the multiplicative property of double integrals, as follows:\n\n$$\n\\begin{aligned}{∬}_{R}y{x}^{2}{3}^{x+y}\\,\\text{d}A & ={∬}_{R}y\\,{x}^{2}\\,{3}^{x}\\,{3}^{y}\\,\\text{d}A \\\\  & ={∬}_{R}({x}^{2}\\,{3}^{x})\\text{ }(y\\,{3}^{y})\\,\\text{d}A \\\\  & =({\\int }_{1}^{3}{x}^{2}\\,{3}^{x}\\,\\text{d}x)({\\int }_{0}^{2}y\\,{3}^{y}\\,\\text{d}y)\\end{aligned}\n$$",
      "calculator_instructions": "",
