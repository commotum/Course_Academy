      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14227574/observations/step-q133785-47a97711778fbc232fe4.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14227574/observations/step-q133785-47a97711778fbc232fe4.png",
      "source_url": "https://mathacademy.com/tasks/14227574/topics/3753/lesson",
      "captured_at": 1792066114.1715353,
      "math_academy_id": "q-133785",
      "topic_id": "3753",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q133785",
        "placement_id": null,
