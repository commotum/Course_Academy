      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14227574/observations/step-q133943-f3c8f3f65bd92ac0bcf2.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14227574/observations/step-q133943-f3c8f3f65bd92ac0bcf2.png",
      "source_url": "https://mathacademy.com/tasks/14227574/topics/3753/lesson",
      "captured_at": 1792066136.9347563,
      "math_academy_id": "q-133943",
      "topic_id": "3753",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q133943",
        "placement_id": null,
        "content_id": null,
