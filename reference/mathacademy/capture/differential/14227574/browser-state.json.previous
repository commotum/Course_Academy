          "path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14227574/assets/8fb46d101101d3d2bdb4afcfcc1436f1a62137389db2ffc3fde0cff71054e7f1.png",
          "sha256": "8fb46d101101d3d2bdb4afcfcc1436f1a62137389db2ffc3fde0cff71054e7f1",
