      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14227574/observations/step-q133851-cc76864d524e3d22849e.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14227574/observations/step-q133851-cc76864d524e3d22849e.png",
      "source_url": "https://mathacademy.com/tasks/14227574/topics/3753/lesson",
      "captured_at": 1792066045.1068022,
      "math_academy_id": "q-133851",
      "topic_id": "3753",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q133851",
        "placement_id": null,
        "content_id": null,
        "type": null
      },
      "source_example_id": "e-9692",
      "knowledge_point": "Using Trend Line Equations to Make a Prediction",
