6045417] [17592186268721 #edb/ref 1079 #uuid "afbfb3a7-3342-516e-8228-b0c951af2f3f" #edb/ref 17592186045417] [17592186268826 #edb/ref 1075 #edb/ref 17592186266355 #edb/ref 17592186045417] [17592186268826 #edb/ref 1075 #edb/ref 17592186266591 #edb/ref 17592186045417] [17592186268826 #edb/ref 1075 #edb/ref 17592186266663 #edb/ref 17592186045417] [17592186268826 #edb/ref 1075 #edb/ref 17592186266776 #edb/ref 17592186045417] [17592186268826 #edb/ref 1075 #edb/ref 17592186267766 #edb/ref 17592186045417] [17592186268826 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186268826 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186268826 #edb/ref 1078 #edb/ref 17592186266663 #edb/ref 17592186045417] [17592186268826 #edb/ref 1079 #uuid "ef3b9d32-3619-56be-b588-21f8903d05d1" #edb/ref 17592186045417] [17592186268933 #edb/ref 1068 #edb/ref 17592186268826 #edb/ref 17592186045417] [17592186268933 #edb/ref 1069 "q-133880" #edb/ref 17592186045417] [17592186268933 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186268933 #edb/ref 1071 "![](images/4d/4de50fc0b2b2f05b9ca60e28ffc65900a2b0780549fbf1cf32150a903a08faf5.png)\n\nThe scatter plot above gives the correspondence between the variables $x$ and $y$ for some data points.\nUse the trend line to predict the value of $x$ when $y=20.$" #edb/ref 17592186045417] [17592186268933 #edb/ref 1072 #uuid "dd69890e-422d-56db-a361-c19cc01c3d0a" #edb/ref 17592186045417] [17592186268933 #edb/ref 1074 "To make our prediction, we proceed as follows:\n\n- First, we start at $y=20$ on the $y$-axis.\n\n![](images/b6/b614a0ed708e9b0e333c05daf6adde3f4636daebf00f622fc570ade99d8237d8.png)\n\n- Then, we move right until we intersect the trend line.\n\n![](images/d6/d6772acc92fc6b1ed7c9efbeb4a292ec21f5d2b8069bd0fa4ad7a8d5f7d79470.png)\n\n- Finally, we move down until we intersect the $x$-axis.\n\n![](images/39/3916c8c4a6bfa6cb558cfa91e268e66d011659753ca23da0396cf2ed9f8d1a8f.png)\n\nTherefore, when $y=20,$ we obtain $x≈7.$" #edb/ref 17592186045417] [17592186268934 #edb/ref 1068 #edb/ref 17592186268492 #edb/ref 17592186045417] [17592186268934 #edb/ref 1069 "q-133884" #edb/ref 17592186045417] [17592186268934 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186268934 #edb/ref 1071 "![](images/e0/e00248d1dd5cb96a5e0099acf5da41913a805dbc388715f0b542aa821a95efa5.png)\n\nThe scatterplot above shows the relationship between the number of hours $x$ a group of people spend watching TV each night and the time $y$ they sleep each night. The equation of the trend line is $y=10-1.25x.$ \n\nAssuming this trend continues, estimate the time a person sleeps per night if they watch TV for $6$ hours." #edb/ref 17592186045417] [17592186268934 #edb/ref 1072 #uuid "a78cfca9-9001-58c9-bbd8-9235b77891ac" #edb/ref 17592186045417] [17592186268934 #edb/ref 1074 "To predict the number of hours a person sleeps after watching TV for $6$ hours, we need to substitute $x=6$ into the equation of the trend line:\n\n$$\n\\begin{aligned}y & =10-1.25x \\\\  & =10-1.25(6) \\\\  & =10-7.5 \\\\  & =2.5\\end{aligned}\n$$\n\n \n\nTherefore, according to this model, a person watching TV for $6$ hours sleeps for approximately $2.5$ hours.\n\nNote: The point where $x=6$ is not shown on our trend line. Therefore, our result *may* be unreliable." #edb/ref 17592186045417] [17592186268936 #edb/ref 1068 #edb/ref 17592186268522 #edb/ref 17592186045417] [17592186268936 #edb/ref 1069 "q-133943" #edb/ref 17592186045417] [17592186268936 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186268936 #edb/ref 1071 "![](images/7b/7ba7aa1cf49bb5a2dc430d9a21baaa8491aa61d8898f2aad142406c5c569b51b.png)\n\nThe scatter plot above gives the correspondence between the variables $x$ and $y$ for some data points. Estimate the value of $x$ when $y=7.$ \n\n*Hint: Assume the trend is linear, and that the trend line passes through the points $(1,1)$ and $(5,4).$*" #edb/ref 17592186045417] [17592186268936 #edb/ref 1072 #uuid "b4e2e69a-6742-55aa-baed-902f71aaf13b" #edb/ref 17592186045417] [17592186268936 #edb/ref 1074 "First, using the hint, let's draw an approximate trend line for our scatter plot.\n\n![](images/59/59efe1b79b0d032179a5210ee694b0d59ad082853ca9fb80a9d79d9f6444f2bf.png)\n\nOur trend line passes through $({x}_{1},{y}_{1})=(1,1)$ and $({x}_{2},{y}_{2})=(5,4).$\n\nWe will write the equation of the line in the slope-intercept form \n\n$$\ny=mx+b.\n$$\n\nFirst, we calculate the slope $m$ of the line as follows:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{4-1}{5-1} \\\\  & =\\frac{3}{4} \\\\  & =0.75\\end{aligned}\n$$\n\nSubstituting $m=0.75$ into the slope-intercept form above, we get\n\n$$\ny=0.75x+b.\n$$\n\nWe now need to calculate the $y$-intercept $b.$ We can do this by substituting the coordinates of a point on the line. Any point will do, so let's substitute $(1,1):$\n\n$$\n\\begin{aligned}y & =0.75x+b \\\\ 1 & =0.75(1)+b \\\\ 1 & =0.75+b \\\\ b & =0.25\\end{aligned}\n$$\n\nTherefore, the equation of the line is \n\n$$\ny=0.75x+0.25.\n$$\n\nFinally, we substitute $y=7$ into the equation above and solve for $x:$\n\n$$\n\\begin{aligned}y & =0.75x+0.25 \\\\ 7 & =0.75x+0.25 \\\\ 6.75 & =0.75x \\\\ x & =9\\end{aligned}\n$$\n\nTherefore, according to this model, when $y=7$ we have $x≈9.$\n\nNote: The point where $y=7$ is not shown on our trend line. Therefore, our result *may* be unreliable." #edb/ref 17592186045417] [17592186268939 #edb/ref 1068 #edb/ref 17592186268721 #edb/ref 17592186045417] [17592186268939 #edb/ref 1069 "q-133961" #edb/ref 17592186045417] [17592186268939 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186268939 #edb/ref 1071 "![](images/d3/d3d0f871d60b7f7c8280abd7d3eba4337f910bae6b814586b368bbfb0a8dc313.png)\n\nThe scatter plot above shows the weight loss per week (in pounds) vs. the number of hours spent training per week for a group of people. Use the trend line to estimate how much weight a person loses if they train for $4$ hours per week." #edb/ref 17592186045417] [17592186268939 #edb/ref 1072 #uuid "81a0f2ef-8e06-5acd-bc49-13e95e8478d8" #edb/ref 17592186045417] [17592186268939 #edb/ref 1074 "To make our estimation, we proceed as follows:\n\n- We start at $x=4$ on the horizontal axis.\n\n![](images/1e/1e397473de815e2eda88ad33c59e2cf77c336b968ef6a1eeaffa67d9fbc64750.png)\n\n- Then, we move up until we intersect the trend line.\n\n![](images/27/27c8ce8a7a1feadd4ea16d66f6a283fa245fa737036810924ead4b0148c6d6f5.png)\n\n- Finally, we move left until we intersect the vertical axis.\n\n![](images/a1/a178070d1f62538a35e7e4e363a254c2afa776920079618b80b3bff358601871.png)\n\nTherefore, a person training $4$ hours a week will lose around $3$ pounds of weight." #edb/ref 17592186045417] [17592186268943 #edb/ref 1068 #edb/ref 17592186268643 #edb/ref 17592186045417] [17592186268943 #edb/ref 1069 "q-133967" #edb/ref 17592186045417] [17592186268943 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186268943 #edb/ref 1071 "![](images/1d/1d4df2d201ccbaf2305534d61c8a0ed5f7957b1629d8cd2fbd5fff933283c0dc.png)\n\nThe scatter plot above shows the number of matches won by some chess players in a championship and the hours they spend training per day.\nUse the trend line to estimate how much time players need to train each day to win $30$ championship games." #edb/ref 17592186045417] [17592186268943 #edb/ref 1072 #uuid "d6bab4ea-9515-5432-8897-bfe0c69aa515" #edb/ref 17592186045417] [17592186268943 #edb/ref 1074 "To make our estimation, we proceed as follows:\n\n- We start at $y=30$ on the vertical axis.\n\n![](images/26/26ba10258a8794a97dfc5e61c8160b342ed6890f7a9af40c1e21ac814c779188.png)\n\n- Then, we move right until we intersect the trend line.\n\n![](images/e5/e50d79adb9803f6509314cf3512fcd388ccc78b287d6653b9e318ce54ce45022.png)\n\n- Finally, we move down until we intersect the horizontal axis.\n\n![](images/a9/a9bd5a7973ecb2e88c328d0943d4bfebe9862b2cea1abbd0b3fa3665fa177167.png)\n\nTherefore, a chess player that wins $30$ games spends around $5$ hours training per day." #edb/ref 17592186045417] [17592186549337 #edb/ref 1080 "4" #edb/ref 17592186045417] [17592186549337 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186549337 #edb/ref 1083 #uuid "0c57330b-8507-5a3c-9806-0e8c205fd13d" #edb/ref 17592186045417] [17592186549345 #edb/ref 1080 "7" #edb/ref 17592186045417] [17592186549345 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186549345 #edb/ref 1083 #uuid "121e378e-227c-58b4-9178-bd289e4d1481" #edb/ref 17592186045417] [17592186549349 #edb/ref 1080 "1.5" #edb/ref 17592186045417] [17592186549349 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186549349 #edb/ref 1083 #uuid "13f4c61a-c56d-54cd-9ef2-fd5516f7e35b" #edb/ref 17592186045417] [17592186549364 #edb/ref 1080 "4.5" #edb/ref 17592186045417] [17592186549364 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186549364 #edb/ref 1083 #uuid "1803bbd6-5355-5d9a-9fb7-f4cf0aaa465d" #edb/ref 17592186045417] [17592186549371 #edb/ref 1080 "1" #edb/ref 17592186045417] [17592186549371 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186549371 #edb/ref 1083 #uuid "1c1a6631-58bb-5134-9a94-217bbe53ee56" #edb/ref 17592186045417] [17592186549396 #edb/ref 1080 "{31.5}^{∘}\\,\\text{C}" #edb/ref 17592186045417] [17592186549396 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186549396 #edb/ref 1083 #uuid "25c938d8-1dfb-5d3f-8853-61890c9bf0cd" #edb/ref 17592186045417] [17592186549416 #edb/ref 1080 "8" #edb/ref 17592186045417] [17592186549416 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186549416 #edb/ref 1083 #uuid "2e65ceff-fed4-5dfb-bf7c-85e0da5bc187" #edb/ref 17592186045417] [17592186549417 #edb/ref 1080 "3" #edb/ref 17592186045417] [17592186549417 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [175921865494