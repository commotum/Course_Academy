#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186434609} :activity/id #uuid "a877ccc4-a857-576d-8fb3-5ca0090834d7" :activity/scope {:db/id #edb/ref 17592186049186 :topic/id #uuid "e1c10e80-3811-5fcd-98a3-8118c49347e4" :topic/math-academy-id 1737} :activity/steps [{:db/id #edb/ref 17592186434609 :step/content {:db/id #edb/ref 17592186434608 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6073d65a-c468-5d8e-889f-60c5cdb14578" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t\\in (-\\infty ,1)\\cup (1,2)" :db/id #edb/ref 17592186434602} {:answer/id #uuid "6a8722bb-9e6f-55ec-ab0e-abad8cdaebc2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t\\in (-1,1)" :db/id #edb/ref 17592186434603} {:answer/id #uuid "7057b034-c64c-5f7b-a593-a2b44e4f0f7a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t\\in (-\\infty ,-1)" :db/id #edb/ref 17592186434604} {:answer/id #uuid "bec2ac23-2bb3-5a04-b2f4-16915124308c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t\\in (-\\infty ,-1)\\cup (-1,1)" :db/id #edb/ref 17592186434605} {:answer/id #uuid "ea5be08c-d061-5bc5-a2e5-aad2e687d34f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t\\in (-\\infty ,2)" :db/id #edb/ref 17592186434606}] :answer-field/correct {:db/id #edb/ref 17592186434605} :answer-field/id #uuid "be942fb8-f73d-5f54-94c5-d09755cd0c13" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186434607}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7d25096e-7480-5615-8abf-2ab27b49c2cd" :question/math-academy-id "q-160770" :question/problem "Find the domain of the vector-valued function $f(t)=\\operatorname{ln}⁡(1-t)\\,i+\\frac{2}{1+t}\\,j+(2-t)\\,k.$" :question/worked-solution "To find the domain of $f$, we need the intersection of the domains of the individual components.\n\n- The domain of $\\operatorname{ln}⁡(1-t)$ is $t\\in (-\\infty ,1).$\n\n- The domain of $\\frac{2}{1+t}$ is $t\\in (-\\infty ,-1)\\cup (-1,\\infty ).$\n\n- The domain of $(2-t)$ is $t\\in (-\\infty ,\\infty ).$\n\nThe intersection is illustrated in the diagram below.\n\n![](images/4e/4e69cafc31992d97922f7074a5fc211edfca1efe5b4d61f70e946134d52052fb.png)\n\nTherefore, the domain of the vector-valued function $f(t)$ is $t\\in (-\\infty ,-1)\\cup (-1,1).$"} :step/id #uuid "5cc1f657-7b45-509a-a40c-65669163d0fd" :step/next {:db/id #edb/ref 17592186434613}} {:db/id #edb/ref 17592186434610 :step/content {:db/id #edb/ref 17592186281514 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "138b2176-ecc6-57f2-bc6d-f1652a33636a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{6}+\\pi n" :db/id #edb/ref 17592186278767} {:answer/id #uuid "2444e896-56b2-5fe6-9c12-ded17b4df5eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{2}+\\frac{\\pi n}{3}" :db/id #edb/ref 17592186278916} {:answer/id #uuid "5fb99ab6-2b20-5f51-ac07-2107a5729fb6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{3}+\\frac{\\pi n}{2}" :db/id #edb/ref 17592186279469} {:answer/id #uuid "9484619f-2ead-592d-844c-a164a8fc5f1f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2\\pi n}{3}" :db/id #edb/ref 17592186279912} {:answer/id #uuid "d1436dab-1fe3-50c6-a9d0-651b17cd161f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi n}{6}" :db/id #edb/ref 17592186280437}] :answer-field/correct {:db/id #edb/ref 17592186278767} :answer-field/id #uuid "064586b1-f0a2-55e9-ab4f-1edb28541b5f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186280841}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "355588e1-74ab-5c1c-9491-56bf772d1b60" :question/math-academy-id "q-162645" :question/problem "The domain of the vector-valued function $f(t)={t}^{3}\\,i+\\operatorname{sec}⁡(t+\\frac{\\pi }{3})\\,j+\\sqrt{2{t}^{2}+1}\\,k$ is \n\n$$\nt\\in (-\\infty ,\\infty ),\\,t\\ne \\bbox[5pt,border:1pt solid black]{\\phantom{AAAAA}}.\n$$\n\nWhat is the missing expression? You may assume that $n$ is an integer." :question/worked-solution "To find the domain of $f$, we need the intersection of the domains of the individual components.\n\n- The domain of the 1st component ${t}^{3}$ is $t\\in (-\\infty ,\\infty ).$\n\n- The domain of the 2nd component $\\operatorname{sec}⁡(t+\\frac{\\pi }{3})$ is $t\\in (-\\infty ,\\infty ),$ except for the values of $t$ for which\n\n$$\nt+\\frac{\\pi }{3}=\\frac{\\pi }{2}+\\pi n\\,⟹\\,t=\\frac{\\pi }{6}+\\pi n,\n$$\n\nwhere $n$ is an integer.\n\n- The domain of the 3rd component $\\sqrt{2{t}^{2}+1}$ is $t\\in (-\\infty ,\\infty ).$\n\nTherefore, the domain of the vector-valued function $f(t)$ is \n\n$$\nt\\in (-\\infty ,\\infty ),\\,t\\ne \\frac{\\pi }{6}+\\pi n,\n$$\n\nwhere $n$ is an integer."} :step/id #uuid "6d974a30-5451-563e-af63-d68f97380132" :step/next {:db/id #edb/ref 17592186434611}} {:db/id #edb/ref 17592186434611 :step/content {:db/id #edb/ref 17592186281520 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d3e7eb8-45ba-5620-af85-ac5459d2a94c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in (-\\infty ,2)" :db/id #edb/ref 17592186278861} {:answer/id #uuid "5a2158ce-c480-54c2-8ea8-acecce6dfc8a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in (-2,0)\\cup (0,2)" :db/id #edb/ref 17592186279418} {:answer/id #uuid "71d38630-309a-5223-824d-664f60203b0d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in (-\\infty ,-2)" :db/id #edb/ref 17592186279626} {:answer/id #uuid "c363e0ef-c9c8-5006-b261-de03549e33b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in (-2,0)\\cup (0,\\infty )" :db/id #edb/ref 17592186280310} {:answer/id #uuid "fbe76885-9ce8-5403-9f7c-698744d8b32f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in (-2,\\infty )" :db/id #edb/ref 17592186280798}] :answer-field/correct {:db/id #edb/ref 17592186280310} :answer-field/id #uuid "5a212da2-a5f2-57a1-8e82-96959276aaf8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186280987}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0197513a-e58d-59e7-b31b-641cf93f0c11" :question/math-academy-id "q-162657" :question/problem "Find the domain of the vector-valued function $f(s)=\\operatorname{ln}⁡(s+2)\\,i+{e}^{2s}\\,j+\\frac{3}{{s}^{2}}\\,k.$" :question/worked-solution "To find the domain of $f$, we need the intersection of the domains of the individual components.\n\n- The domain of the 1st component $\\operatorname{ln}⁡(s+2)$ is $s\\in (-2,\\infty ).$\n\n- The domain of the 2nd component ${e}^{2s}$ is $s\\in (-\\infty ,\\infty ).$\n\n- The domain of the 3rd component $\\frac{3}{{s}^{2}}$ is $s\\in (-\\infty ,0)\\cup (0,\\infty ).$\n\nThe intersection is illustrated in the diagram below.\n\n![](images/7a/7aacfa509e2e642fd90ef989e4dec3a2f9f5ad1e8def55f894b88d97bcabb971.png)\n\nTherefore, the domain of the vector-valued function $f(s)$ is $s\\in (-2,0)\\cup (0,\\infty ).$"} :step/id #uuid "8fb273d6-8594-5f60-8d7f-4364fd17bdf4" :step/next {:db/id #edb/ref 17592186434612}} {:db/id #edb/ref 17592186434612 :step/content {:db/id #edb/ref 17592186281523 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d70cc6b-bd49-5fad-80dd-107c44a59a26" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in (1,2)" :db/id #edb/ref 17592186278991} {:answer/id #uuid "39fdb5cd-6cc3-529f-b505-53703b5e20d0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in (-\\infty ,1)\\cup (1,\\infty )" :db/id #edb/ref 17592186279104} {:answer/id #uuid "4e468aef-35d1-5ca8-9435-b946edd08ff7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in (2,\\infty )" :db/id #edb/ref 17592186279302} {:answer/id #uuid "7d3e9b8a-bee0-59ae-acb6-e94db4a1db28" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in (1,2)\\cup (2,\\infty )" :db/id #edb/ref 17592186279711} {:answer/id #uuid "91a8bb4c-3e02-54c8-ba2f-ada2f9a6fe60" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in (0,\\infty )" :db/id #edb/ref 17592186279890}] :answer-field/correct {:db/id #edb/ref 17592186279302} :answer-field/id #uuid "7b67c2d1-20af-5e46-8732-2ab3a65c3c67" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186281058}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "7c1f4ba8-733f-52ec-ba54-2cc86581e097" :question/math-academy-id "q-162661" :question/problem "Find the domain of the vector-valued function $f(s)=⟨\\frac{1}{s-1},\\,\\operatorname{ln}⁡s,\\,\\operatorname{ln}⁡(s-2)⟩.$" :question/worked-solution "To find the domain of $f$, we need the intersection of the domains of the individual components. \n\n- The domain of $\\frac{1}{s-1}$ is $s\\in (-\\infty ,1)\\cup (1,\\infty ).$\n\n- The domain of $\\operatorname{ln}⁡s$ is $s\\in (0,\\infty ).$\n\n- The domain of $\\operatorname{ln}⁡(s-2)$ is  $s\\in (2,\\infty ).$\n\nThe intersection is illustrated in the diagram below.\n\n![](images/ac/ac5fed5129673869c7b9e0da3bd46f224aedbfda11b3a26e507b533d66c4e4e9.png)\n\nTherefore, the domain of the vector-valued function $f(s)$ is $s\\in (2,\\infty ).$"} :step/id #uuid "ab7de720-165e-5d5d-a64a-1a64ae913cfe"} {:db/id #edb/ref 17592186434613 :step/content {:db/id #edb/ref 17592186281512 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11188107-8128-5947-9d14-6b2ff56a2513" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186278748} {:answer/id #uuid "792a4a98-c522-5228-85fc-5aac6d5cff61" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{n\\pi }{2}" :db/id #edb/ref 17592186279673} {:answer/id #uuid "bffccb23-963c-523b-b10b-709940b33bf2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2n\\pi " :db/id #edb/ref 17592186280281} {:answer/id #uuid "cdf765d7-ed5e-524a-a27b-5d8678c4f142" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "n\\pi " :db/id #edb/ref 17592186280409} {:answer/id #uuid "f639275c-6781-5bf6-8ee3-3e36faf90d6b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{2}+n\\pi " :db/id #edb/ref 17592186280749}] :answer-field/correct {:db/id #edb/ref 17592186280409} :answer-field/id #uuid "5306462d-65c3-5c3f-b61d-973703c8ad19" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186280970}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "540767cb-cd6f-5ce4-bc0f-7ec2c2e165a4" :question/math-academy-id "q-162636" :question/problem "The domain of the vector-valued function $f(t)=\\operatorname{cot}⁡t\\,i+(t+1)^{2}\\,j+\\operatorname{cos}⁡t\\,k$ is \n\n$$\nt\\in (-\\infty ,\\infty ),\\,t\\ne \\bbox[5pt,border:1pt solid black]{\\phantom{AAAAA}}.\n$$\n\nWhat is the missing expression? You may assume that $n$ is an integer." :question/worked-solution "To find the domain of $f$, we need the intersection of the domains of the individual components.\n\n- The domain of the 1st component $\\operatorname{cot}⁡t$ is $t\\in (-\\infty ,\\infty )$, $t\\ne n\\pi ,$ where $n$ is an integer.\n\n- The domain of the 2nd component $(t+1)^{2}$ is $t\\in (-\\infty ,\\infty ).$\n\n- The domain of the 3rd component $\\operatorname{cos}⁡t$ is $t\\in (-\\infty ,\\infty ).$\n\nTherefore, the domain of the vector-valued function $f(t)$ is \n\n$$\nt\\in (-\\infty ,\\infty ),\\,t\\ne n\\pi ,\n$$\n\nwhere $n$ is an integer."} :step/id #uuid "d102d3e6-4a8f-5810-a213-fcf495285bef" :step/next {:db/id #edb/ref 17592186434610}}] :activity/title "The Domain of a Vector-Valued Function" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186434601}]}
