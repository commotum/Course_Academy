[{:db/id 17592186115355 :knowledge-point/questions ["question-7d25096e-7480-5615-8abf-2ab27b49c2cd"] :db/ensure [:knowledge-point/validate]} {:db/id "question-7d25096e-7480-5615-8abf-2ab27b49c2cd" :question/id #uuid "7d25096e-7480-5615-8abf-2ab27b49c2cd" :question/math-academy-id "q-160770" :question/problem "Find the domain of the vector-valued function $f(t)=\\operatorname{ln}⁡(1-t)\\,i+\\frac{2}{1+t}\\,j+(2-t)\\,k.$" :question/worked-solution "To find the domain of $f$, we need the intersection of the domains of the individual components.\n\n- The domain of $\\operatorname{ln}⁡(1-t)$ is $t\\in (-\\infty ,1).$\n\n- The domain of $\\frac{2}{1+t}$ is $t\\in (-\\infty ,-1)\\cup (-1,\\infty ).$\n\n- The domain of $(2-t)$ is $t\\in (-\\infty ,\\infty ).$\n\nThe intersection is illustrated in the diagram below.\n\n![](images/4e/4e69cafc31992d97922f7074a5fc211edfca1efe5b4d61f70e946134d52052fb.png)\n\nTherefore, the domain of the vector-valued function $f(t)$ is $t\\in (-\\infty ,-1)\\cup (-1,1).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-be942fb8-f73d-5f54-94c5-d09755cd0c13"] :db/ensure [:question/validate]} {:db/id "answer-field-be942fb8-f73d-5f54-94c5-d09755cd0c13" :answer-field/id #uuid "be942fb8-f73d-5f54-94c5-d09755cd0c13" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bec2ac23-2bb3-5a04-b2f4-16915124308c" :answer-field/choices ["answer-6a8722bb-9e6f-55ec-ab0e-abad8cdaebc2" "answer-7057b034-c64c-5f7b-a593-a2b44e4f0f7a" "answer-bec2ac23-2bb3-5a04-b2f4-16915124308c" "answer-6073d65a-c468-5d8e-889f-60c5cdb14578" "answer-ea5be08c-d061-5bc5-a2e5-aad2e687d34f"] :db/ensure [:answer-field/validate]} {:db/id "answer-6a8722bb-9e6f-55ec-ab0e-abad8cdaebc2" :answer/id #uuid "6a8722bb-9e6f-55ec-ab0e-abad8cdaebc2" :answer/type :answer.type/math :answer/value "t\\in (-1,1)" :db/ensure [:answer/validate]} {:db/id "answer-7057b034-c64c-5f7b-a593-a2b44e4f0f7a" :answer/id #uuid "70