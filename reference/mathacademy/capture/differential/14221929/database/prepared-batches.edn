es "answer-825e3c73-ea77-5644-9cd3-b6091c4271ea"] ["answer-field-4fb4d622-2cfe-5123-b12c-76f30da29551" :answer-field/choices "answer-5ef16aa2-7f00-5a11-a5ae-b254c9e3ddaf"] ["answer-field-4fb4d622-2cfe-5123-b12c-76f30da29551" :answer-field/choices "answer-60dc99e9-55cf-552a-875b-3cbcf9519dc0"] ["answer-field-4fb4d622-2cfe-5123-b12c-76f30da29551" :answer-field/choices "answer-28ffe4fa-4124-53f3-9455-23c7dc4b1e77"] ["question-7df7ee25-2f51-5474-8055-7ad2776c92c8" :question/answer-fields "answer-field-4fb4d622-2cfe-5123-b12c-76f30da29551"] [17592186064163 :knowledge-point/questions "question-7df7ee25-2f51-5474-8055-7ad2776c92c8"] ["question-b8cfbdaa-2d28-5714-8504-0797810897ae" :question/id #uuid "b8cfbdaa-2d28-5714-8504-0797810897ae"] ["question-b8cfbdaa-2d28-5714-8504-0797810897ae" :question/math-academy-id "q-344375"] ["question-b8cfbdaa-2d28-5714-8504-0797810897ae" :question/problem "The global maximum value of the function $f(x)=2\\sqrt{x+1}$ on the closed interval $0\\le x\\le 8$ is{{field-1}}."] ["question-b8cfbdaa-2d28-5714-8504-0797810897ae" :question/worked-solution "Let's apply the candidates test step by step.\n\n**Step 1**: We find the critical points. Taking the derivative of $f(x)=2\\sqrt{x+1},$ we get\n\n$$\n{f}^{′}(x)=\\frac{1}{\\sqrt{x+1}}.\n$$\n\nWe can see that ${f}^{′}(x)>0$ for all real values of $x$ in the interval. So there is no solution for ${f}^{′}(x)=0.$\n\nSo, the only critical points are the endpoints $x=0,8$ (since the derivative is not defined at the endpoints).\n\n**Step 2**: We evaluate $f(x)$ at the critical points.\n\n$$\n\\begin{aligned}f(0) & =2\\sqrt{0+1}=2 \\\\ f(8) & =2\\sqrt{8+1}=2\\sqrt{9}=6\\end{aligned}\n$$\n\n**Step 3**: We compare all of the values found in step $2.$\n\n- The greatest value is $f(8)=6,$ so the global maximum is $6.$\n\n- The smallest value is $f(0)=2,$ so the global minimum is $2.$\n\n![](images/de/def7a0e41c8534710eec8bfa3c0f6795b5fbb20ea09058403046be5bef4594fb.png)"] ["question-b8cfbdaa-2d28-5714-8504-0797810897ae" :question/difficulty :question.difficulty/easy] ["answer-field-b88e7600-2c1a-57b5-9965-7ce4ab955ff3" :answer-field/id #uuid "b88e7600-2c1a-57b5-9965-7ce4ab955ff3"] ["answer-2c5dee35-f28d-5bb4-8fe4-b2713d716fc2" :answer/id #uuid "2c5dee35-f28d-5bb4-8fe4-b2713d716fc2"] ["answer-2c5dee35-f28d-5bb4-8fe4-b2713d716fc2" :answer/type :answer.type/math] ["answer-2c5dee35-f28d-5bb4-8fe4-b2713d716fc2" :answer/value "6"] ["answer-field-b88e7600-2c1a-57b5-9965-7ce4ab955ff3" :answer-field/key "field-1"] ["answer-field-b88e7600-2c1a-57b5-9965-7ce4ab955ff3" :answer-field/type :answer-field.type/blank] ["answer-field-b88e7600-2c1a-57b5-9965-7ce4ab955ff3" :answer-field/correct "answer-2c5dee35-f28d-5bb4-8fe4-b2713d716fc2"] ["answer-field-b88e7600-2c1a-57b5-9965-7ce4ab955ff3" :answer-field/choices "answer-2c5dee35-f28d-5bb4-8fe4-b2713d716fc2"] ["question-b8cfbdaa-2d28-5714-8504-0797810897ae" :question/answer-fields "answer-field-b88e7600-2c1a-57b5-9965-7ce4ab955ff3"] [17592186064163 :knowledge-point/questions "question-b8cfbdaa-2d28-5714-8504-0797810897ae"] ["question-7e7a47fb-69a2-506b-bf8c-6f05366124e0" :question/id #uuid "7e7a47fb-69a2-506b-bf8c-6f05366124e0"] ["question-7e7a47fb-69a2-506b-bf8c-6f05366124e0" :question/math-academy-id "q-344385"] ["question-7e7a47fb-69a2-506b-bf8c-6f05366124e0" :question/problem "The exact global minimum value of the function $f(x)=\\sqrt{x+4}$ on the closed interval $-3\\le x\\le 5$ is{{field-1}}."] ["question-7e7a47fb-69a2-506b-bf8c-6f05366124e0" :question/worked-solution "Let's apply the candidates test step by step.\n\n**Step 1**: We find the critical points. Taking the derivative of $f(x)=\\sqrt{x+4},$ we get\n\n$$\n{f}^{′}(x)=\\frac{1}{2\\sqrt{x+4}}.\n$$\n\nWe can see that ${f}^{′}(x)>0$ for all real values of $x$ in the interval. So there is no solution for ${f}^{′}(x)=0.$\n\nSo, the only critical points are the endpoints $x=-3,5$ (since the derivative is not defined at the endpoints).\n\n**Step 2**: We evaluate $f(x)$ at the critical points.\n\n$$\n\\begin{aligned}f(-3) & =\\sqrt{-3+4}=\\sqrt{1}=1 \\\\ f(5) & =\\sqrt{5+4}=\\sqrt{9}=3\\end{aligned}\n$$\n\n**Step 3**: We compare all of the values found in step $2.$\n\n- The greatest value is $f(5)=3,$ so the global maximum is $3.$\n\n- The smallest value is $f(-3)=1,$ so the global minimum is $1.$\n\n![](images/a6/a638683e712156f829a3d6562de44c6c72b7fb6d2c360fa293b3dbaea7297ea9.png)"] ["question-7e7a47fb-69a2-506b-bf8c-6f05366124e0" :question/difficulty :question.difficulty/easy] ["answer-field-5ead7aa1-dd1c-551b-9401-863495d3e597" :answer-field/id #uuid "5ead7aa1-dd1c-551b-9401-863495d3e597"] ["answer-a82340d7-8b4b-58b4-bb04-953eac68b378" :answer/id #uuid "a82340d7-8b4b-58b4-bb04-953eac68b378"] ["answer-a82340d7-8b4b-58b4-bb04-953eac68b378" :answer/type :answer.type/math] ["answer-a82340d7-8b4b-58b4-bb04-953eac68b378" :answer/value "1"] ["answer-field-5ead7aa1-dd1c-551b-9401-863495d3e597" :answer-field/key "field-1"] ["answer-field-5ead7aa1-dd1c-551b-9401-863495d3e597" :answer-field/type :answer-field.type/blank] ["answer-field-5ead7aa1-dd1c-551b-9401-863495d3e597" :answer-field/correct "answer-a82340d7-8b4b-58b4-bb04-953eac68b378"] ["answer-field-5ead7aa1-dd1c-551b-9401-863495d3e597" :answer-field/choices "answer-a82340d7-8b4b-58b4-bb04-953eac68b378"] ["question-7e7a47fb-69a2-506b-bf8c-6f05366124e0" :question/answer-fields "answer-field-5ead7aa1-dd1c-551b-9401-863495d3e597"] [17592186064163 :knowledge-point/questions "question-7e7a47fb-69a2-506b-bf8c-6f05366124e0"] ["question-aa173a50-134e-5fe9-8151-0ed518869f1b" :question/id #uuid "aa173a50-134e-5fe9-8151-0ed518869f1b"] ["question-aa173a50-134e-5fe9-8151-0ed518869f1b" :question/math-academy-id "q-2750"] ["question-aa173a50-134e-5fe9-8151-0ed518869f1b" :question/problem "Find the global minimum value of the function $f(x)=-\\operatorname{cos}⁡x$ on the closed interval $\\frac{\\pi }{2}\\le x\\le \\frac{3\\pi }{2}.$"] ["question-aa173a50-134e-5fe9-8151-0ed518869f1b" :question/worked-solution "Let's apply the candidates test step by step.\n\n**Step 1**: We find the critical points. Taking the derivative of $f(x)=-\\operatorname{cos}⁡x,$ we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\operatorname{sin}⁡x,\\end{aligned}\n$$\n\nand solving ${f}^{′}(x)=0,$ we get \n\n$$\n\\operatorname{sin}⁡x=0\\,⟹\\,x=\\pi n,\n$$\n\nwhere $n$ is an integer. We discard all solutions except $x=\\pi ,$ since it is the only value that belongs to the given interval.\n\nSo, the critical points are $x=\\pi $ and the endpoints $x=\\frac{\\pi }{2},\\,\\frac{3\\pi }{2}$ (since the derivative is not defined at the endpoints).\n\n**Step 2**: We evaluate $f(x)$ at the critical points.\n\n$$\n\\begin{aligned}f(\\frac{\\pi }{2}) & =-\\operatorname{cos}⁡(\\frac{\\pi }{2})=0 \\\\ f(\\pi ) & =-\\operatorname{cos}⁡(\\pi )=1 \\\\ f(\\frac{3\\pi }{2}) & =-\\operatorname{cos}⁡(\\frac{3\\pi }{2})=0\\end{aligned}\n$$\n\n**Step 3**: We compare all of the values found in step $2.$\n\n- The greatest value is $f(\\pi )=1,$ so the global maximum is $1.$\n\n- The least value is $f(\\frac{\\pi }{2})=f(\\frac{3\\pi }{2})=0,$ so the global minimum is $0.$\n\n![](images/7e/7e0008d35355afebc392a4bc508bd2cf2de5dc32a108f9f9c030d75a24ece076.png)"] ["question-aa173a50-134e-5fe9-8151-0ed518869f1b" :question/difficulty :question.difficulty/easy] ["answer-field-4da91bd3-52bf-5e6a-a679-993bbe509e49" :answer-field/id #uuid "4da91bd3-52bf-5e6a-a679-993bbe509e49"] ["answer-a9e86a30-6dd7-5faa-ac75-5295942c7076" :answer/id #uuid "a9e86a30-6dd7-5faa-ac75-5295942c7076"] ["answer-a9e86a30-6dd7-5faa-ac75-5295942c7076" :answer/type :answer.type/math] ["answer-a9e86a30-6dd7-5faa-ac75-5295942c7076" :answer/value "-1"] ["answer-0bd6a7c3-ca56-5d00-ad2a-bfa5230fbbcb" :answer/id #uuid "0bd6a7c3-ca56-5d00-ad2a-bfa5230fbbcb"] ["answer-0bd6a7c3-ca56-5d00-ad2a-bfa5230fbbcb" :answer/type :answer.type/math] ["answer-0bd6a7c3-ca56-5d00-ad2a-bfa5230fbbcb" :answer/value "-\\frac{1}{2}"] ["answer-c476cec3-a40b-571d-9dfd-321c34be4974" :answer/id #uuid "c476cec3-a40b-571d-9dfd-321c34be4974"] ["answer-c476cec3-a40b-571d-9dfd-321c34be4974" :answer/type :answer.type/math] ["answer-c476cec3-a40b-571d-9dfd-321c34be4974" :answer/value "-\\frac{\\sqrt{2}}{2}"] ["answer-5dc5c2dd-7531-574c-aa4e-5aa3dc593b78" :answer/id #uuid "5dc5c2dd-7531-574c-aa4e-5aa3dc593b78"] ["answer-5dc5c2dd-7531-574c-aa4e-5aa3dc593b78" :answer/type :answer.type/math] ["answer-5dc5c2dd-7531-574c-aa4e-5aa3dc593b78" :answer/value "-\\frac{\\sqrt{3}}{2}"] ["answer-bb9b8243-3292-5c0c-9ec7-4d1fa55e8d23" :answer/id #uuid "bb9b8243-3292-5c0c-9ec7-4d1fa55e8d23"] ["answer-bb9b8243-3292-5c0c-9ec7-4d1fa55e8d23" :answer/type :answer.type/math] ["answer-bb9b8243-3292-5c0c-9ec7-4d1fa55e8d23" :answer/value "0"] ["answer-field-4da91bd3-52bf-5e6a-a679-993bbe509e49" :answer-field/key "selection"] ["answer-field-4da91bd3-52bf-5e6a-a679-993bbe509e49" :answer-field/type :answer-field.type/radio] ["answer-field-4da91bd3-52bf-5e6a-a679-993bbe509e49" :answer-field/correct "answer-bb9b8243-3292-5c0c-9ec7-4d1fa55e8d23"] ["answer-field-4da91bd3-52bf-5e6a-a679-993bbe509e49" :answer-field/choices "answer-a9e86a30-6dd7-5faa-ac75-5295942c7076"] ["answer-field-4da91bd3-52bf-5e6a-a679-993bbe509e49" :answer-field/choices "answer-0bd6a7c3-ca56-5d00-ad2a-bfa5230fbbcb"] ["answer-field-4da91bd3-52bf-5e6a-a679-993bbe509e49" :answer-field/choices "answer-c476cec3-a40b-571d-9dfd-321c34be4974"] ["answer-field-4da91bd3-52bf-5e6a-a679-993bbe509e49" :answer-field/choices "answer-5dc5c2dd-7531-574c-aa4e-5aa3dc593b78"] ["answer-field-4da91bd3-52bf-5e6a-a679-993bbe509e49" :answer-field/choices "answer-bb9b8243-3292-5c0c-9ec7-4d1fa55e8d23"] ["question-aa173a50-134e-5fe9-8151-0ed518869f1b" :question/answer-fields "answer-field-4da91bd3-52bf-5e6a-a679-993bbe509e49"] [17592186064164 :knowledge-point/questions "question-aa173a50-134e-5fe9-8151-0ed518869f1b"]] "retractions" []}]