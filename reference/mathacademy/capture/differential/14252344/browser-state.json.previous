/mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo></mjx-mrow><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2212\"></mjx-c></mjx-mo><mjx-msup><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D452 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: 0.413em;\"><mjx-texatom size=\"s\" texclass=\"ORD\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D70B TEX-I\"></mjx-c></mjx-mi></mjx-texatom></mjx-script></mjx-msup></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><msub><mi>f</mi><mrow data-mjx-texclass=\"ORD\"><mi>x</mi><mi>y</mi><mi>x</mi></mrow></msub><mo stretchy=\"false\">(</mo><mn>1</mn><mo>,</mo><mi>π</mi><mo stretchy=\"false\">)</mo><mo>=</mo><msup><mn>1</mn><mn>3</mn></msup><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mn>1</mn><mo>⋅</mo><mi>π</mi></mrow></msup><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mo stretchy=\"false\">(</mo><mn>1</mn><mo>⋅</mo><mi>π</mi><mo stretchy=\"false\">)</mo><mo>−</mo><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mo stretchy=\"false\">(</mo><mn>1</mn><mo>⋅</mo><mi>π</mi><mo stretchy=\"false\">)</mo><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mo>=</mo><mo>−</mo><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mi>π</mi></mrow></msup></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
