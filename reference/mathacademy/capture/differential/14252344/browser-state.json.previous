            },
            {
              "option": "b",
              "dom_id": "questionWidget-choiceLetterCircle-80757-b",
              "type": "text",
              "value": "I and II only",
              "html": "I and II only"
            },
            {
              "option": "c",
              "dom_id": "questionWidget-choiceLetterCircle-80757-c",
              "type": "text",
              "value": "II only",
              "html": "II only"
            },
            {
              "option": "d",
