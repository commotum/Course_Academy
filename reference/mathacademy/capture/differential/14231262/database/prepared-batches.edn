5-523d-8b4f-218a0c887321"] ["answer-field-ea541e01-5fa9-5c1a-9bd5-70920b6a9e22" :answer-field/choices "answer-ee37ca3b-30b3-5807-a624-f62ac29989e2"] ["answer-field-ea541e01-5fa9-5c1a-9bd5-70920b6a9e22" :answer-field/choices "answer-e933345b-51e3-5f41-b177-21de967b42a8"] ["answer-field-ea541e01-5fa9-5c1a-9bd5-70920b6a9e22" :answer-field/choices "answer-76d37b1f-0cae-52e4-bbc9-ab6fd6b7061a"] ["question-f3a2a8f5-8f7b-5578-9df3-f4e28dce2d10" :question/answer-fields "answer-field-ea541e01-5fa9-5c1a-9bd5-70920b6a9e22"] [17592186162047 :knowledge-point/questions "question-f3a2a8f5-8f7b-5578-9df3-f4e28dce2d10"] ["question-1f799a56-7472-58ef-998d-84e22fb88853" :question/id #uuid "1f799a56-7472-58ef-998d-84e22fb88853"] ["question-1f799a56-7472-58ef-998d-84e22fb88853" :question/math-academy-id "q-110126"] ["question-1f799a56-7472-58ef-998d-84e22fb88853" :question/problem "Let $X$ be a continuous random variable with the following probability density function:\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}5{x}^{4},\\, & 0<x<1 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nIf $Y=1-{X}^{5},$ then what is the probability density function of $Y?$"] ["question-1f799a56-7472-58ef-998d-84e22fb88853" :question/worked-solution "To compute the probability density function of a random variable $Y,$ where $Y=u(X)$ is a continuous, strictly monotonic function of a continuous random variable $X,$ we follow two steps:\n\n- First, we find an expression for ${F}_{Y}$ terms of ${F}_{X},$ where ${F}_{Y}$ and ${F}_{X}$ are the cumulative distribution functions of $Y$ and $X,$ respectively.\n\n- Then, we differentiate ${F}_{Y}$ to get the probability density function ${f}_{Y}.$\n\nBefore we start, note that $Y=1-{X}^{5}$ is a strictly decreasing function of $X.$ Moreover, for $0<x<1,$ we have $0<y<1.$\n\n![](images/05/05534475aecc1d0ebad2234f1259d1b6fd1c6183e47ad763f17c87c5fdb06afb.png)\n\nNow, using the definition of the cumulative distribution of $Y,$ for $0<y<1,$ we have\n\n$$\n\\begin{aligned}{F}_{Y}(y) & =P(Y\\le y) \\\\  & =P(1-{X}^{5}\\le y) \\\\  & =P(-{X}^{5}\\le y-1) \\\\  & =P(X\\ge (1-y)^{1/5}) \\\\  & =1-{F}_{X}((1-y)^{1/5})\\end{aligned}\n$$\n\nTo compute the PDF ${f}_{Y}(y)$ for $0<y<1,$ we differentiate ${F}_{Y}$ with respect to $y$ using the chain rule. This gives\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={F}_{Y}^{′}(y) \\\\  & =0-(-\\frac{1}{5(1-y)^{4/5}})\\cdot {F}_{X}^{′}((1-y)^{1/5}) \\\\  & =\\frac{1}{5(1-y)^{4/5}}\\cdot {f}_{X}((1-y)^{1/5}).\\end{aligned}\n$$\n\nApplying the definition of ${f}_{X},$ we finally arrive at\n\n$$\n\\begin{aligned}{f}_{Y}(y) & =\\frac{1}{5(1-y)^{4/5}}\\cdot {f}_{X}((1-y)^{1/5}) \\\\  & =\\frac{1}{5(1-y)^{4/5}}\\cdot 5{((1-y)^{1/5})}^{4} \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, the full expression for the PDF of $Y$ is\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}1,\\, & 0<y<1 \\\\ 0,\\, & \\text{otherwise}.\\end{aligned}\n$$"] ["question-1f799a56-7472-58ef-998d-84e22fb88853" :question/difficulty :question.difficulty/hard] ["answer-field-8bffd42c-4c16-5c26-a4d3-ff06e8bcf1b7" :answer-field/id #uuid "8bffd42c-4c16-5c26-a4d3-ff06e8bcf1b7"] ["answer-d7e7845f-1c6b-5825-bbe7-1626dc1077e1" :answer/id #uuid "d7e7845f-1c6b-5825-bbe7-1626dc1077e1"] ["answer-d7e7845f-1c6b-5825-bbe7-1626dc1077e1" :answer/type :answer.type/math] ["answer-d7e7845f-1c6b-5825-bbe7-1626dc1077e1" :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}0.5,\\, & 0<y<2 \\\\ 0,\\, & \\text{otherwise}\\end{aligned}"] ["answer-52cef4e5-3e19-5e35-bee0-384a657d1c16" :answer/id #uuid "52cef4e5-3e19-5e35-bee0-384a657d1c16"] ["answer-52cef4e5-3e19-5e35-bee0-384a657d1c16" :answer/type :answer.type/math] ["answer-52cef4e5-3e19-5e35-bee0-384a657d1c16" :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}0.5y,\\, & 0<y<2 \\\\ 0,\\, & \\text{otherwise}\\end{aligned}"] ["answer-196dbf90-694f-56e1-bd9a-bacffff31ed3" :answer/id #uuid "196dbf90-694f-56e1-bd9a-bacffff31ed3"] ["answer-196dbf90-694f-56e1-bd9a-bacffff31ed3" :answer/type :answer.type/math] ["answer-196dbf90-694f-56e1-bd9a-bacffff31ed3" :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}1,\\, & 0<y<1 \\\\ 0,\\, & \\text{otherwise}\\end{aligned}"] ["answer-a623ad96-993c-5f91-994d-d43006007fb2" :answer/id #uuid "a623ad96-993c-5f91-994d-d43006007fb2"] ["answer-a623ad96-993c-5f91-994d-d43006007fb2" :answer/type :answer.type/math] ["answer-a623ad96-993c-5f91-994d-d43006007fb2" :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}2y,\\, & 0<y<1 \\\\ 0,\\, & \\text{otherwise}\\end{aligned}"] ["answer-4ca12552-8ad4-5d6a-8884-8f4afde5830a" :answer/id #uuid "4ca12552-8ad4-5d6a-8884-8f4afde5830a"] ["answer-4ca12552-8ad4-5d6a-8884-8f4afde5830a" :answer/type :answer.type/math] ["answer-4ca12552-8ad4-5d6a-8884-8f4afde5830a" :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}5,\\, & 0<y<0.2 \\\\ 0,\\, & \\text{otherwise}\\end{aligned}"] ["answer-field-8bffd42c-4c16-5c26-a4d3-ff06e8bcf1b7" :answer-field/key "selection"] ["answer-field-8bffd42c-4c16-5c26-a4d3-ff06e8bcf1b7" :answer-field/type :answer-field.type/radio] ["answer-field-8bffd42c-4c16-5c26-a4d3-ff06e8bcf1b7" :answer-field/correct "answer-196dbf90-694f-56e1-bd9a-bacffff31ed3"] ["answer-field-8bffd42c-4c16-5c26-a4d3-ff06e8bcf1b7" :answer-field/choices "answer-d7e7845f-1c6b-5825-bbe7-1626dc1077e1"] ["answer-field-8bffd42c-4c16-5c26-a4d3-ff06e8bcf1b7" :answer-field/choices "answer-52cef4e5-3e19-5e35-bee0-384a657d1c16"] ["answer-field-8bffd42c-4c16-5c26-a4d3-ff06e8bcf1b7" :answer-field/choices "answer-196dbf90-694f-56e1-bd9a-bacffff31ed3"] ["answer-field-8bffd42c-4c16-5c26-a4d3-ff06e8bcf1b7" :answer-field/choices "answer-a623ad96-993c-5f91-994d-d43006007fb2"] ["answer-field-8bffd42c-4c16-5c26-a4d3-ff06e8bcf1b7" :answer-field/choices "answer-4ca12552-8ad4-5d6a-8884-8f4afde5830a"] ["question-1f799a56-7472-58ef-998d-84e22fb88853" :question/answer-fields "answer-field-8bffd42c-4c16-5c26-a4d3-ff06e8bcf1b7"] [17592186162047 :knowledge-point/questions "question-1f799a56-7472-58ef-998d-84e22fb88853"] ["question-a4b19843-0372-523c-be3f-e38cf328fccc" :question/id #uuid "a4b19843-0372-523c-be3f-e38cf328fccc"] ["question-a4b19843-0372-523c-be3f-e38cf328fccc" :question/math-academy-id "q-110245"] ["question-a4b19843-0372-523c-be3f-e38cf328fccc" :question/problem "Let $X$ be a continuous random variable with the following probability density function:\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}1,\\, & 0<x<1 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nIf $Y=-\\operatorname{ln}⁡X,$ then what is the probability density function of $Y?$"] ["question-a4b19843-0372-523c-be3f-e38cf328fccc" :question/worked-solution "To compute the probability density function of a random variable $Y,$ where $Y=u(X)$ is a continuous, strictly monotonic function of a continuous random variable $X,$ we follow two steps:\n\n- First, we find an expression for ${F}_{Y}$ terms of ${F}_{X},$ where ${F}_{Y}$ and ${F}_{X}$ are the cumulative distribution functions of $Y$ and $X,$ respectively.\n\n- Then, we differentiate ${F}_{Y}$ to get the probability density function ${f}_{Y}.$\n\nBefore we start, note that since the values of $X$ are $0<x<1,$ $Y=-\\operatorname{ln}⁡X$ is a strictly decreasing function of $X.$ Moreover, for $0<x<1,$ we have $y>0.$\n\n![](images/5a/5a2a6f4c5e26819af509e9347fb7aff230927bdd9192ad10a48ce9c951c7be80.png)\n\nNow, using the definition of the cumulative distribution of $Y,$ for $y>0,$ we have\n\n$$\n\\begin{aligned}{F}_{Y}(y) & =P(Y\\le y) \\\\  & =P(-\\operatorname{ln}⁡X\\le y) \\\\  & =P(\\operatorname{ln}⁡X\\ge -y) \\\\  & =P(X\\ge {e}^{-y}) \\\\  & =1-{F}_{X}({e}^{-y})\\end{aligned}\n$$\n\nTo compute the PDF ${f}_{Y}(y)$ for $y>0,$ we differentiate ${F}_{Y}$ with respect to $y$ using the chain rule. This gives\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={F}_{Y}^{′}(y) \\\\  & =0-(-{e}^{-y})\\cdot {F}_{X}^{′}({e}^{-y}) \\\\  & ={e}^{-y}\\cdot {f}_{X}({e}^{-y}).\\end{aligned}\n$$\n\nApplying the definition of ${f}_{X},$ we finally arrive at\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={e}^{-y}\\cdot {f}_{X}({e}^{-y}) \\\\  & ={e}^{-y}\\cdot 1 \\\\  & ={e}^{-y}.\\end{aligned}\n$$\n\nTherefore, the full expression for the PDF of $Y$ is\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}{e}^{-y}\\, & y>0 \\\\ 0\\, & \\text{otherwise}\\end{aligned}\n$$"] ["question-a4b19843-0372-523c-be3f-e38cf328fccc" :question/difficulty :question.difficulty/hard] ["answer-field-f2a17ede-9d12-55e8-9a15-7ee9a3ba31af" :answer-field/id #uuid "f2a17ede-9d12-55e8-9a15-7ee9a3ba31af"] ["answer-3137f17a-3a0e-5b0c-a694-056680cb7764" :answer/id #uuid "3137f17a-3a0e-5b0c-a694-056680cb7764"] ["answer-3137f17a-3a0e-5b0c-a694-056680cb7764" :answer/type :answer.type/math] ["answer-3137f17a-3a0e-5b0c-a694-056680cb7764" :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}1,\\, & 0<y<1 \\\\ 0, & \\text{otherwise}\\end{aligned}"] ["answer-02cf00d4-bb82-5dd8-a677-72fc28f792e6" :answer/id #uuid "02cf00d4-bb82-5dd8-a677-72fc28f792e6"] ["answer-02cf00d4-bb82-5dd8-a677-72fc28f792e6" :answer/type :answer.type/math] ["answer-02cf00d4-bb82-5dd8-a677-72fc28f792e6" :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}2{e}^{-2y}\\, & y>0 \\\\ 0\\, & \\text{otherwise}\\end{aligned}"] ["answer-59577974-15fa-52fa-8f57-a46673040992" :answer/id #uuid "59577974-15fa-52fa-8f57-a46673040992"] ["answer-59577974-15fa-52fa-8f57-a46673040992" :answer/type :answer.type/math] ["answer-59577974-15fa-52fa-8f57-a46673040992" :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}2{e}^{2y}\\, & y<0 \\\\ 0\\, & \\text{otherwise}\\end{aligned}"] ["answer-98739189-0bce-58a6-b3ce-c59b0a5d2aad" :answer/id #uuid "98739189-0bce-58a6-b3ce-c59b0a5d2aad"] ["answer-98739189-0bce-58a6-b3ce-c59b0a5d2aad" :answer/type :answer.type/math] ["answer-98739189-0bce-58a6-b3ce-c59b0a5d2aad" :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}{e}^{-y}\\, & y>0 \\\\ 0\\, & \\text{otherwise}\\end{aligned}"] ["answer-7105b7b3-58d8-53b8-a82e-927f96c5336f" :answer/id #uuid "7105b7b3-58d8-53b8-a82e-927f96c5336f"] ["answer-7105b7b3-58d8-53b8-a82e-927f96c5336f" :answer/type :answer.type/math] ["answer-7105b7b3-58d8-53b8-a82e-927f96c5336f" :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}{e}^{y}\\, & y<0 \\\\ 0\\, & \\text{otherwise}\\end{aligned}"] ["answer-field-f2a17ede-9d12-55e8-9a15-7ee9a3ba31af" :answer-field/key "selection"] ["answer-field-f2a17ede-9d12-55e8-9a15-7ee9a3ba31af" :answer-field/type :answer-field.type/radio] ["answer-field-f2a17ede-9d12-55e8-9a15-7ee9a3ba31af" :answer-field/correct "answer-98739189-0bce-58a6-b3ce-c59b0a5d2aad"] ["answer-field-f2a17ede-9d12-55e8-9a15-7ee9a3ba31af" :answer-field/choices "answer-3137f17a-3a0e-5b0c-a694-056680cb7764"] ["answer-field-f2a17ede-9d12-55e8-9a15-7ee9a3ba31af" :answer-field/choices "answer-02cf00d4-bb82-5dd8-a677-72fc28f792e6"] ["answer-field-f2a17ede-9d12-55e8-9a15-7ee9a3ba31af" :answer-field/choices "answer-59577974-15fa-52fa-8f57-a46673040992"] ["answer-field-f2a17ede-9d12-55e8-9a15-7ee9a3ba31af" :answer-field/choices "answer-98739189-0bce-58a6-b3ce-c59b0a5d2aad"] ["answer-field-f2a17ede-9d12-55e8-9a15-7ee9a3ba31af" :answer-field/choices "answer-7105b7b3-58d8-53b8-a82e-927f96c5336f"] ["question-a4b19843-0372-523c-be3f-e38cf328fccc" :question/answer-fields "answer-field-f2a17ede-9d12-55e8-9a15-7ee9a3ba31af"] [17592186162047 :knowledge-point/questions "question-a4b19843-0372-523c-be3f-e38cf328fccc"] ["question-75b7b0a4-c7ee-525c-b9ca-1a7df7652ed9" :question/id #uuid "75b7b0a4-c7ee-525c-b9ca-1a7df7652ed9"] ["question-75b7b0a4-c7ee-525c-b9ca-1a7df7652ed9" :question/math-academy-id "q-110343"] ["question-75b7b0a4-c7ee-525c-b9ca-1a7df7652ed9" :question/problem "Let $X$ be a continuous random variable with the following probability density function:\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}4{e}^{-4x},\\, & x>0 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nIf $Y=-\\sqrt[3]{X},$ then what is the probability density function of $Y?$"] ["question-75b7b0a4-c7ee-525c-b9ca-1a7df7652ed9" :question/worked-solution "To compute the probability density function of a random variable $Y,$ where $Y=u(X)$ is a continuous, strictly monotonic function of a continuous random variable $X,$ we follow two steps:\n\n- First, we find an expression for ${F}_{Y}$ terms of ${F}_{X},$ where ${F}_{Y}$ and ${F}_{X}$ are the cumulative distribution functions of $Y$ and $X,$ respectively.\n\n- Then, we differentiate ${F}_{Y}$ to get the probability density function ${f}_{Y}.$\n\nBefore we start, note that $Y=-\\sqrt[3]{X}$ is a strictly decreasing function of $X.$ Moreover, for $x>0,$ we have $y<0.$\n\n![](images/4c/4c2b1503e6624c9060829468c9fa0d49856a2d76131975b6b1e437b7de3285c7.png)\n\nNow, using the definition of the cumulative distribution of $Y,$ for $y<0,$ we have\n\n$$\n\\begin{aligned}{F}_{Y}(y) & =P(Y\\le y) \\\\  & =P(-\\sqrt[3]{X}\\le y) \\\\  & =P(-X\\le {y}^{3}) \\\\  & =P(X\\ge -{y}^{3}) \\\\  & =1-{F}_{X}(-{y}^{3})\\end{aligned}\n$$\n\nTo compute the PDF ${f}_{Y}(y)$ for $y>0,$ we differentiate ${F}_{Y}$ with respect to $y$ using the chain rule. This gives\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={F}_{Y}^{′}(y) \\\\  & =0-(-3{y}^{2})\\cdot {F}_{X}^{′}(-{y}^{3}) \\\\  & =3{y}^{2}\\cdot {f}_{X}(-{y}^{3}).\\end{aligned}\n$$\n\nApplying the definition of ${f}_{X},$ we finally arrive at\n\n$$\n\\begin{aligned}{f}_{Y}(y) & =3{y}^{2}\\cdot {f}_{X}(-{y}^{3}) \\\\  & =3{y}^{2}\\cdot 4{e}^{-4(-{y}^{3})} \\\\  & =12{y}^{2}{e}^{4{y}^{3}}.\\end{aligned}\n$$\n\nTherefore, the full expression for the PDF of $Y$ is\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}12{y}^{2}{e}^{4{y}^{3}},\\, & y<0 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$"] ["question-75b7b0a4-c7ee-525c-b9ca-1a7df7652ed9" :question/difficulty :question.difficulty/hard] ["answer-field-98d1d0c4-c915-5b43-86d2-eae585442104" :answer-field/id #uuid "98d1d0c4-c915-5b43-86d2-eae585442104"] ["answer-f63e4602-5159-57f7-952a-0152cc8abc16" :answer/id #uuid "f63e4602-5159-57f7-952a-0152cc8abc16"] ["answer-f63e4602-5159-57f7-952a-0152cc8abc16" :answer/type :answer.type/math] ["answer-f63e4602-5159-57f7-952a-0152cc8abc16" :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}12{e}^{-12y},\\, & y>0 \\\\ 0, & \\text{otherwise}\\end{aligned}"] ["answer-8f4a131d-65cf-5e71-9eb3-dac170dbbf51" :answer/id #uuid "8f4a131d-65cf-5e71-9eb3-dac170dbbf51"] ["answer-8f4a131d-65cf-5e71-9eb3-dac170dbbf51" :answer/type :answer.type/math] ["answer-8f4a131d-65cf-5e71-9eb3-dac170dbbf51" :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}12{e}^{12y},\\, & y<0 \\\\ 0, & \\text{otherwise}\\end{aligned}"] ["answer-acfa5a4c-add0-565a-9ded-15a152272ac5" :answer/id #uuid "acfa5a4c-add0-565a-9ded-15a152272ac5"] ["answer-acfa5a4c-add0-565a-9ded-15a152272ac5" :answer/type :answer.type/math] ["answer-acfa5a4c-add0-565a-9ded-15a152272ac5" :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}12{y}^{2}{e}^{-4{y}^{3}},\\, & y>0 \\\\ 0, & \\text{otherwise}\\end{aligned}"] ["answer-ce9720cc-9e97-5b98-9dc1-bae43a45708b" :answer/id #uuid "ce9720cc-9e97-5b98-9dc1-bae43a45708b"] ["answer-ce9720cc-9e97-5b98-9dc1-bae43a45708b" :answer/type :answer.type/math] ["answer-ce9720cc-9e97-5b98-9dc1-bae43a45708b" :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}12{y}^{2}{e}^{4{y}^{3}},\\, & y<0 \\\\ 0, & \\text{otherwise}\\end{aligned}"] ["answer-679eafa7-4671-5f81-9026-857bfb15b568" :answer/id #uuid "679eafa7-4671-5f81-9026-857bfb15b568"] ["answer-679eafa7-4671-5f81-9026-857bfb15b568" :answer/type :answer.type/math] ["answer-679eafa7-4671-5f81-9026-857bfb15b568" :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}4{e}^{4y},\\, & y<0 \\\\ 0, & \\text{otherwise}\\end{aligned}"] ["answer-field-98d1d0c4-c915-5b43-86d2-eae585442104" :answer-field/key "selection"] ["answer-field-98d1d0c4-c915-5b43-86d2-eae585442104" :answer-field/type :answer-field.type/radio] ["answer-field-98d1d0c4-c915-5b43-86d2-eae585442104" :answer-field/correct "answer-ce9720cc-9e97-5b98-9dc1-bae43a45708b"] ["answer-field-98d1d0c4-c915-5b43-86d2-eae585442104" :answer-field/choices "answer-f63e4602-5159-57f7-952a-0152cc8abc16"] ["answer-field-98d1d0c4-c915-5b43-86d2-eae585442104" :answer-field/choices "answer-8f4a131d-65cf-5e71-9eb3-dac170dbbf51"] ["answer-field-98d1d0c4-c915-5b43-86d2-eae585442104" :answer-field/choices "answer-acfa5a4c-add0-565a-9ded-15a152272ac5"] ["answer-field-98d1d0c4-c915-5b43-86d2-eae585442104" :answer-field/choices "answer-ce9720cc-9e97-5b98-9dc1-bae43a45708b"] ["answer-field-98d1d0c4-c915-5b43-86d2-eae585442104" :answer-field/choices "answer-679eafa7-4671-5f81-9026-857bfb15b568"] ["question-75b7b0a4-c7ee-525c-b9ca-1a7df7652ed9" :question/answer-fields "answer-field-98d1d0c4-c915-5b43-86d2-eae585442104"] [17592186162047 :knowledge-point/questions "question-75b7b0a4-c7ee-525c-b9ca-1a7df7652ed9"] [17592186163263 :tutorial/content "Let $X$ be a continuous random variable whose probability density function is known. Suppose we want to define a new random variable $Y$ as\n\n$$\nY = u(X),\n$$\n\nwhere $u = u(X)$ is a function of $X.$ How do we find the probability density function of $Y?$\n\nTo find the PDF of $Y,$ we can use the **distribution function method**. The distribution function method consists of two steps:\n\n- First, we find an expression for $F_Y$ in terms of $F_X,$ where $F_Y$ and $F_X$ are the cumulative distribution functions of $Y$ and $X,$ respectively.\n\n- Then, we differentiate $F_Y$ to get the probability density function $f_Y$ of $Y.$\n\nIn this lesson, we'll assume that the function $u$ is strictly monotonic (i.e., strictly increasing or decreasing). The case where $u$ is not monotonic will be dealt with in a future lesson.\n\nLet's see an example of the distribution function method in action."] [17592186163339 :tutorial/content "Suppose the continuous random variable $X$ is defined as\n\n![](images/88/88103878042469595fc8f8243958b44b128c0d38465bfe93a31f83afd6988300.svg)\nLet $Y= 1+2X.$ Let's use the distribution function method to find the probability density function of $Y.$\n\nFirst, note that $Y = 1+2X$ is a strictly increasing function of $X.$ Moreover, for $x > 0,$ we have $y > 1.$\n\n![](images/54/544e551755f4c8a575ef227b77fe520deec203f08654eec31109e496141aa91c.png)\n\nLet's consider $y > 1.$ We write down the definition of the cumulative distribution of $Y,$ and then use our transformation to isolate $X$ in the parentheses. This will allow us to write $F_Y$ in terms of $F_X\\mathbin{:}$\n\n$$\n\\begin{aligned}{F}_{Y}(y) & =P(Y\\le y) \\\\  & =P(2X+1\\le y) \\\\  & =P(2X\\le y-1) \\\\  & =P(X\\le \\frac{y-1}{2}) \\\\  & ={F}_{X}(\\frac{y-1}{2})\\end{aligned}\n$$\n\nNow, to compute the PDF $f_Y(y)$ for $y > 1,$ we differentiate $F_Y$ with respect to $y$ using the chain rule. This gives\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={F}_{Y}^{′}(y) \\\\  & =\\frac{\\text{d}}{\\text{d}y}({F}_{X}(\\frac{y-1}{2})) \\\\  & =\\frac{\\text{d}}{\\text{d}y}(\\frac{y-1}{2})\\cdot {F}_{X}^{′}(\\frac{y-1}{2}) \\\\  & =\\frac{1}{2}\\cdot {F}_{X}^{′}(\\frac{y-1}{2}) \\\\  & =\\frac{1}{2}\\cdot {f}_{X}(\\frac{y-1}{2}).\\end{aligned}\n$$\n\nApplying the definition of $f_X,$ we finally arrive at\n\n$$\n\\begin{aligned}{f}_{Y}(y) & =\\frac{1}{2}\\cdot {f}_{X}(\\frac{y-1}{2}) \\\\  & =\\frac{1}{2}\\cdot {e}^{-(y-1)/2} \\\\  & =\\frac{1}{2}{e}^{(1-y)/2}.\\end{aligned}\n$$\n\nTherefore, the full expression for the PDF of $Y$ is\n\n$$\n\\begin{aligned}{f}_{Y}(y) & =\\{\\begin{aligned}\\frac{1}{2}{e}^{(1-y)/2}, & \\,y>1 \\\\ 0, & \\,\\text{otherwise.}\\end{aligned}\\end{aligned}\n$$\n\nIt's easy (and often worthwhile) to check that this is a valid probability density function."] [17592186162191 :activity/expected-seconds 840.0]] "retractions" [[17592186161846 :question/problem "Let $X$ be a continuous random variable with the following probability density function:\n${2x,\\begin{vmatrix}0 < x < 1 \\\\ 0,\\end{vmatrix}otherwise$\nIf $Y =1-3X$, then what is the probability density function of $Y$?"] [17592186161846 :question/worked-solution "To compute the probability density function of a random variable $Y$, where $Y = u(X)$ is a continuous, strictly monotonic function of a continuous random variable $X$, we follow two steps:\n\n- First, we find an expression for $F_Y$ terms of $F_X$, where $F_Y$ and $F_X$ are the cumulative distribution functions of $Y$ and $X$, respectively.\n- Then, we differentiate $F_Y$ to get the probability density function $f_Y$.\n\nBefore we start, note that $Y = 1-3X$ is a strictly decreasing function of $X$. Moreover, for $0 < x < 1$, we have $-2 \\lt y \\lt 1$.\n\n![](images/3b/3bb641b1920d0ded33e4ffa25f3e0af856550dd3820edf30416bd79c3a6da264.png)\n\nNow, using the definition of the cumulative distribution of $Y$, for $-2 \\lt y \\lt 1$, we have\n\n$$\n\\begin{aligned}\nF_{Y}(y) &= P(Y \\le y) \\\\\n&= P(1 - 3X \\le y) \\\\\n&= P(-3X \\le y - 1) \\\\\n&= P(X \\ge \\frac{1 - y}{3}) \\\\\n&= 1 - F_{X}(\\frac{1 - y}{3})\n\\end{aligned}\n$$\n\nTo compute the PDF $f_Y(y)$ for $-2 \\lt y \\lt 1$, we differentiate $F_Y$ with respect to $y$ using the chain rule. This gives\n\n$$\n\\begin{aligned}\nf_{Y}(y) &= F_{Y}^{′}(y) \\\\\n&= 0 - (-\\frac{1}{3}) \\cdot F_{X}^{′}(\\frac{1 - y}{3}) \\\\\n&= \\frac{1}{3} \\cdot f_{X}(\\frac{1 - y}{3})\n\\end{aligned}\n$$\n\nApplying the definition of $f_X$, we finally arrive at\n\n$$\n\\begin{aligned}\nf_{Y}(y) &= \\frac{1}{3} \\cdot f_{X}(\\frac{1 - y}{3}) \\\\\n&= \\frac{1}{3} \\cdot 2 \\cdot (\\frac{1 - y}{3}) \\\\\n&= \\frac{2}{9}(1 - y)\n\\end{aligned}\n$$\n\nTherefore, the full expression for the PDF of $Y$ is\n\n$$\n{\\frac{2}{9}(1 - y),\\begin{vmatrix}-2 < y < 1 \\\\ 0,\\end{vmatrix}otherwise\n$$"] [17592186161847 :question/problem "Let $X$ be a continuous random variable with the following probability density function:\n${\\frac{3}{8}(2 - x)^{2},\\begin{vmatrix}0 < x < 2 \\\\ 0,\\end{vmatrix}otherwise$\nIf $Y = (2-X)^3$, then what is the probability density function of $Y$?"] [17592186161847 :question/worked-solution "To compute the probability density function of a random variable $Y$, where $Y = u(X)$ is a continuous, strictly monotonic function of a continuous random variable $X$, we follow two steps:\n\n- First, we find an expression for $F_Y$ terms of $F_X$, where $F_Y$ and $F_X$ are the cumulative distribution functions of $Y$ and $X$, respectively.\n- Then, we differentiate $F_Y$ to get the probability density function $f_Y$.\n\nBefore we start, note that $Y = (2-X)^3$ is a strictly decreasing function of $X$. Moreover, for $0 \\lt x \\lt 2$, we have $0 \\lt y \\lt 8$.\n\n![](images/2c/2c07ffe5af282ba1689cb6f49201b979afb4186d0128dd6a97f446b7240d76d6.png)\n\nNow, using the definition of the cumulative distribution of $Y$, for $0 \\lt y \\lt 8$, we have\n\n$$\n\\begin{aligned}\nF_{Y}(y) &= P(Y \\le y) \\\\\n&= P((2 - X)^{3} \\le y) \\\\\n&= P(2 - X \\le y^{1/3}) \\\\\n&= P(-X \\le y^{1/3} - 2) \\\\\n&= P(X \\ge 2 - y^{1/3}) \\\\\n&= 1 - F_{X}(2 - y^{1/3})\n\\end{aligned}\n$$\n\nTo compute the PDF $f_Y(y)$ for $0 \\lt y \\lt 8$, we differentiate $F_Y$ with respect to $y$ using the chain rule. This gives\n\n$$\n\\begin{aligned}\nf_{Y}(y) &= F_{Y}^{′}(y) \\\\\n&= 0 - (-\\frac{1}{3y^{2/3}}) \\cdot F_{X}^{′}(2 - y^{1/3}) \\\\\n&= \\frac{1}{3y^{2/3}} \\cdot f_{X}(2 - y^{1/3})\n\\end{aligned}\n$$\n\nApplying the definition of $f_X$, we finally arrive at\n\n$$\n\\begin{aligned}\nf_{Y}(y) &= \\frac{1}{3y^{2/3}} \\cdot f_{X}(2 - y^{1/3}) \\\\\n&= \\frac{1}{3y^{2/3}} \\cdot \\frac{3}{8}(2 - (2 - y^{1/3}))^{2} \\\\\n&= \\frac{1}{3y^{2/3}} \\cdot \\frac{3}{8}(2 - 2 + y^{1/3})^{2} \\\\\n&= \\frac{1}{3y^{2/3}} \\cdot \\frac{3}{8}(y^{1/3})^{2} \\\\\n&= \\frac{1}{8}\n\\end{aligned}\n$$\n\nTherefore, the full expression for the PDF of $Y$ is\n\n$$\n{\\frac{1}{8},\\begin{vmatrix}0 < y < 8 \\\\ 0,\\end{vmatrix}otherwise\n$$"] [17592186162248 :question/problem "Let $X$ be a continuous random variable with the following probability density function:\n$f_{X}(x) = {4e^{-4x},\\begin{vmatrix}x > 0 \\\\ 0,\\end{vmatrix}otherwise$\nIf $Y = 2X$, then what is the probability density function of $Y$?"] [17592186158690 :answer-field/choices 17592186158691] [17592186158690 :answer-field/choices 17592186158692] [17592186158690 :answer-field/choices 17592186158693] [17592186158690 :answer-field/choices 17592186158694] [17592186158690 :answer-field/choices 17592186158695] [17592186163263 :tutorial/content "Let $X$ be a continuous random variable whose probability density function is known. Suppose we want to define a new random variable $Y$ as\n\n$Y = u(X)$,\nwhere $u = u(X)$ is a function of $X$. How do we find the probability density function of $Y$?\n\nTo find the PDF of $Y$, we can use the **distribution function method**. The distribution function method consists of two steps:\n\n- First, we find an expression for $F_Y$ in terms of $F_X$, where $F_Y$ and $F_X$ are the cumulative distribution functions of $Y$ and $X$, respectively.\n- Then, we differentiate $F_Y$ to get the probability density function $f_Y$ of $Y$.\n\nIn this lesson, we'll assume that the function $u$ is strictly monotonic (i.e., strictly increasing or decreasing). The case where $u$ is not monotonic will be dealt with in a future lesson.\n\nLet's see an example of the distribution function method in action."] [17592186163339 :tutorial/content "Suppose the continuous random variable $X$ is defined as\n\n${e^{-x},\\begin{vmatrix}x > 0 \\\\ 0,\\end{vmatrix}otherwise$.\nLet\n\n$$\nY= 1+2X\n$$\n\nLet's use the distribution function method to find the probability density function of $Y$.\n\nFirst, note that\n\n$$\nY = 1+2X\n$$\n\nis a strictly increasing function of $X$. Moreover, for $x > 0$, we have $y > 1$.\n\n![](images/54/544e551755f4c8a575ef227b77fe520deec203f08654eec31109e496141aa91c.png)\n\nLet's consider $y > 1$. We write down the definition of the cumulative distribution of $Y$, and then use our transformation to isolate $X$ in the parentheses. This will allow us to write $F_Y$ in terms of $F_X$:\n\n$$\n\\begin{aligned}\nF_{Y}(y) &= P(Y \\le y) \\\\\n&= P(2X + 1 \\le y) \\\\\n&= P(2X \\le y - 1) \\\\\n&= P(X \\le \\frac{y - 1}{2}) \\\\\n&= F_{X}(\\frac{y - 1}{2})\n\\end{aligned}\n$$\n\nNow, to compute the PDF $f_Y(y)$ for $y > 1$, we differentiate $F_Y$ with respect to $y$ using the chain rule. This gives\n\n$$\n\\begin{aligned}\nf_{Y}(y) &= F_{Y}^{′}(y) \\\\\n&= \\frac{d}{dy}(F_{X}(\\frac{y - 1}{2})) \\\\\n&= \\frac{d}{dy}(\\frac{y - 1}{2}) \\cdot F_{X}^{′}(\\frac{y - 1}{2}) \\\\\n&= \\frac{1}{2} \\cdot F_{X}^{′}(\\frac{y - 1}{2}) \\\\\n&= \\frac{1}{2} \\cdot f_{X}(\\frac{y - 1}{2})\n\\end{aligned}\n$$\n\nApplying the definition of $f_X$, we finally arrive at\n\n$$\n\\begin{aligned}\nf_{Y}(y) &= \\frac{1}{2} \\cdot f_{X}(\\frac{y - 1}{2}) \\\\\n&= \\frac{1}{2} \\cdot e^{- (y - 1)/2} \\\\\n&= \\frac{1}{2}e^{(1 - y)/2}\n\\end{aligned}\n$$\n\nTherefore, the full expression for the PDF of $Y$ is\n\n$$\n\\begin{aligned}\nf_{Y}(y) &= {\\frac{1}{2}e^{(1 - y)/2},\\begin{vmatrix}y > 1 \\\\ 0,\\end{vmatrix}otherwise\n\\end{aligned}\n$$\n\nIt's easy (and often worthwhile) to check that this is a valid probability density function."]]}]