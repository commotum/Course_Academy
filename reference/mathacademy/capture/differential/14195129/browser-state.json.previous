      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14195129/observations/step-q96358-80762577feacc084d0a0.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14195129/observations/step-q96358-80762577feacc084d0a0.png",
      "source_url": "https://mathacademy.com/tasks/14195129/topics/3132/review",
