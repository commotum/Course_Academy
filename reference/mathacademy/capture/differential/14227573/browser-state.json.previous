mi>ln</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mn>5</mn></mrow><mrow><mi>ln</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mn>4</mn><mo>−</mo><mi>ln</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mn>9</mn></mrow></mfrac></mstyle></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
