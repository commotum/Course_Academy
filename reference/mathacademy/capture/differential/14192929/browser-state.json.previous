m 0.8em 0.3em\"><mtr><mtd><mo stretchy=\"false\">(</mo><mi>y</mi><mo>+</mo><mn>3</mn><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mn>7</mn></mfrac></mstyle></mtd></mtr><mtr><mtd><msqrt><mo stretchy=\"false\">(</mo><mi>y</mi><mo>+</mo><mn>3</mn><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup></msqrt></mtd><mtd><mi></mi><mo>=</mo><msqrt><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mn>7</mn></mfrac></mstyle></msqrt></mtd></mtr><mtr><mtd><mo stretchy=\"false\">|</mo><mi>y</mi><mo>+</mo><mn>3</mn><mo stretchy=\"false\">|</mo></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><msqrt><mn>7</mn></msqrt></mfrac></mstyle></mtd></mtr><mtr><mtd><mi>y</mi><mo>+</mo><mn>3</mn></mtd><mtd><mi></mi><mo>=</mo><mo>±</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><msqrt><mn>7</mn></msqrt></mfrac></mstyle></mtd></mtr><mtr><mtd><mi>y</mi></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mn>3</mn><mo>±</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><msqrt><mn>7</mn></msqrt></mfrac></mstyle></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
