#{[{:db/id #edb/ref 17592186379154 :knowledge-point/_questions [{:db/id #edb/ref 17592186059688 :knowledge-point/id #uuid "0936217d-66d2-5360-b88b-a30683720415" :knowledge-point/title "Expressing Disjunctive Statements as Conditionals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1235b15d-d7d6-5f3a-bf3f-7d77043d7bec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you don't run fast, then you won't catch the bus." :db/id #edb/ref 17592186379156} {:answer/id #uuid "53ab7700-3dfd-5565-9aff-27a9268c913a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you don't run fast, then you will catch the bus." :db/id #edb/ref 17592186379157} {:answer/id #uuid "d09446f0-11c8-538e-a777-a2a00e058550" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Run fast, and you will catch the bus." :db/id #edb/ref 17592186379158} {:answer/id #uuid "f894612a-781a-552e-9304-4d03220c00ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you run fast, then you won't catch the bus." :db/id #edb/ref 17592186379159} {:answer/id #uuid "83883964-8f4c-5ab6-92b8-c04b7db3a85e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you run fast, then you will catch the bus." :db/id #edb/ref 17592186379160}] :answer-field/correct {:answer/id #uuid "1235b15d-d7d6-5f3a-bf3f-7d77043d7bec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you don't run fast, then you won't catch the bus." :db/id #edb/ref 17592186379156} :answer-field/id #uuid "7d14afbb-e097-5b13-8cc9-4dcafbfa01db" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186379155}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f201af53-aacc-5987-a24c-2ae2629eceec" :question/math-academy-id "q-182459" :question/problem "$\\,$ Run fast, or you won’t catch the bus\n\nWhich conditional statement is logically equivalent to the disjunctive statement above?" :question/worked-solution "Let's denote by $A$ and $B$ the following statements:\n\n- $A:$ Run fast.\n\n- $B:$ You won’t catch the bus.\n\nThen, our initial statement can be written as $A∨B,$ which is logically equivalent to \n\n$$\n¬A⇒B.\n$$\n\nThe negation of $A$ can be written as\n\n- $¬A:$ You don't run fast.\n\nTherefore, the given statement is logically equivalent to the following:\n\n$\\,$ If you don't run fast, then you won't catch the bus."}] [{:db/id #edb/ref 17592186379174 :knowledge-point/_questions [{:db/id #edb/ref 17592186059689 :knowledge-point/id #uuid "0d56b033-a2c8-57c7-adde-e574d726ec78" :knowledge-point/title "Rewriting Symbolic Conditional Statements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "103ba745-89da-572a-8645-0e48e298eb69" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453628} {:answer/id #uuid "6db316e3-11cf-581e-aba4-72198d752449" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453629}] :answer-field/correct {:answer/id #uuid "103ba745-89da-572a-8645-0e48e298eb69" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453628} :answer-field/id #uuid "08fbb3c2-9e09-5166-81cf-b13e5f40f715" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454564} {:answer-field/choices [{:answer/id #uuid "f8908055-e767-5cc9-8603-c9755f6acf08" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453630} {:answer/id #uuid "2dee54e9-a7cf-5ff7-8cb7-66dd7d69200c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453631}] :answer-field/correct {:answer/id #uuid "f8908055-e767-5cc9-8603-c9755f6acf08" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453630} :answer-field/id #uuid "605e62e8-9662-50d1-bfd8-1829ceb621ed" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454565} {:answer-field/choices [{:answer/id #uuid "b7adbcc1-3421-5d01-aa06-a9b6e0ef1051" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453632} {:answer/id #uuid "502be7d4-5665-556d-b837-f469b7e58366" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453633}] :answer-field/correct {:answer/id #uuid "502be7d4-5665-556d-b837-f469b7e58366" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453633} :answer-field/id #uuid "d3efa2ca-31f9-5aba-80a2-9f4d61b15725" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454566}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b9dc8cb9-65d8-59f4-a25c-a9f9b514997d" :question/math-academy-id "q-182505" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $¬P⇒Q≡P∨¬Q$\n- **II.** $¬(¬P⇒Q)≡¬P∧Q$\n- **III.** $¬(¬P⇒Q)≡¬P∧¬Q$" :question/worked-solution "Let's examine each of our statements:\n\n- Statement I is false. Indeed, $¬P⇒Q$ is logically equivalent to the disjunction $¬(¬P)∨Q,$ which in turn is equivalent to $P∨Q.$\n\n- Statement II is false, while statement III is true. From part I, we have the following equivalence:\n\n$$\n¬P⇒Q≡P∨Q\n$$\n\nBy negating this statement, we get\n\n$$\n¬(¬P⇒Q)≡¬(P∨Q).\n$$\n\nDistributing the negation over the disjunction using De Morgan's law, we have\n\n$$\n¬(P∨Q)≡¬P∧¬Q.\n$$\n\nSo, $¬(¬P⇒Q)$ is equivalent to $¬P∧¬Q.$\n\nTherefore, the correct answer is \"III only.\""}]}
