#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186522818} :activity/id #uuid "85ade399-3172-5f11-94ba-4d0b307203fb" :activity/scope {:db/id #edb/ref 17592186049805 :topic/id #uuid "155403ed-fbfa-59a9-b928-e762a73145ef" :topic/math-academy-id 247} :activity/steps [{:db/id #edb/ref 17592186522818 :step/content {:db/id #edb/ref 17592186522800 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07d69888-432c-5bfb-a712-e29b248abe25" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(Q∧¬P)∧R" :db/id #edb/ref 17592186522030} {:answer/id #uuid "08c688ff-ba7c-5331-8a9b-c9a3767ff80b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(¬Q∨¬P)∨R" :db/id #edb/ref 17592186522034} {:answer/id #uuid "175de8f6-fada-58f2-9f0c-a6d1bb8cf449" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(Q∧¬P)∨R" :db/id #edb/ref 17592186522069} {:answer/id #uuid "882439eb-c2d0-5721-8c0c-b7d1eae8b316" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(Q∨¬P)∧R" :db/id #edb/ref 17592186522291} {:answer/id #uuid "a11193ee-f395-54ff-ad79-15e460abac8e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(¬Q∧¬P)∨R" :db/id #edb/ref 17592186522354}] :answer-field/correct {:db/id #edb/ref 17592186522069} :answer-field/id #uuid "7f521fe5-d3b7-5494-8542-5d8326f7c090" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186522621}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ec2edb0f-56e4-5a19-b81c-24c586e6f17f" :question/math-academy-id "q-1484" :question/problem "Simplify the statement $(Q⇒P)⇒R.$" :question/worked-solution "First, note that\n\n$$\n\\begin{aligned}(Q⇒P)⇒R & ≡(¬Q∨P)⇒R \\\\  & ≡¬(¬Q∨P)∨R.\\end{aligned}\n$$\n\nWe can distribute the negation over the disjunction using De Morgan's law:\n\n$$\n¬(¬Q∨P)∨R≡(¬(¬Q)∧¬P)∨R\n$$\n\nCanceling out double negations, we reach\n\n$$\n(¬(¬Q)∧¬P)∨R≡(Q∧¬P)∨R.\n$$\n\nSo the given statement is equivalent to $(Q∧¬P)∨R.$"} :step/id #uuid "0450a032-0f52-5ba5-abe8-82e9866f5d76" :step/next {:db/id #edb/ref 17592186522884}} {:db/id #edb/ref 17592186522846 :step/content {:db/id #edb/ref 17592186522795 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07787d1c-e983-5e3a-9efd-7d51b93c7d0f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "If you don't get enough sleep, you will be alert the next day." :db/id #edb/ref 17592186522029} {:answer/id #uuid "20c41708-7e4a-50b6-b570-ad244db5adbb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "If you get enough sleep, you won't be alert the next day." :db/id #edb/ref 17592186522094} {:answer/id #uuid "25b3adf9-102f-5dec-87e1-3682d7ef7ad1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "If you don't get enough sleep, you won't be alert the next day." :db/id #edb/ref 17592186522103} {:answer/id #uuid "37c0d750-a504-554d-9af7-5d196dcd1f7b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "If you get enough sleep, you will be alert the next day." :db/id #edb/ref 17592186522139} {:answer/id #uuid "74deb0e6-4a6b-537f-84cb-6eb03f3d97bd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Get enough sleep, and you will be alert the next day." :db/id #edb/ref 17592186522249}] :answer-field/correct {:db/id #edb/ref 17592186522139} :answer-field/id #uuid "af5a451e-f08e-5116-8e83-974cfab1e7ad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186522645}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e24afd3b-3cd1-54ee-83ee-26ca9c096040" :question/math-academy-id "q-182598" :question/problem "$\\,$ Either you do not get enough sleep, or you will be alert the next day.\n\nWhich conditional statement is logically equivalent to the disjunctive statement above?" :question/worked-solution "Let's denote by $A$ and $B$ the following statements:\n\n- $A:$ You do not get enough sleep.\n\n- $B:$ You will be alert the next day.\n\nThen, our initial statement can be written as $A∨B,$ which is logically equivalent to \n\n$$\n¬A⇒B.\n$$\n\nThe negation of $A$ can be written as\n\n- $¬A:$ You get enough sleep.\n\nTherefore, the given statement is logically equivalent to the following:\n\n$\\,$ If you get enough sleep, then you will be alert the next day.\n\nWe can write this in more everyday language as follows:\n\n$\\,$ If you get enough sleep, you will be alert the next day.\n\n**Note**: \n\nUsing the word \"Either\" helps clarify that the sentence structure presents two alternatives and is particularly useful when employing the disjunctive form $(¬P∨Q)$ in conversational or formal English. So, the phrase effectively conveys that one of the two stated conditions will hold true."} :step/id #uuid "623df059-54b2-5e71-bdb3-85aed237cbf8"} {:db/id #edb/ref 17592186522879 :step/content {:db/id #edb/ref 17592186522788 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "395982bc-f79b-55a2-bcf7-e5b8d3825ce5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬R∧S" :db/id #edb/ref 17592186522143} {:answer/id #uuid "4b875f28-45da-5639-838c-d299811bcdbc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬R∧¬S" :db/id #edb/ref 17592186522180} {:answer/id #uuid "4bc45034-94e0-5586-a3db-a015bd16db0a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "R∨¬S" :db/id #edb/ref 17592186522181} {:answer/id #uuid "813127e8-cce0-5647-ba98-5e64b80842da" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬R∨¬S" :db/id #edb/ref 17592186522277} {:answer/id #uuid "a28b28ee-6b1f-5192-ac45-00c37ca98320" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "R∨S" :db/id #edb/ref 17592186522359}] :answer-field/correct {:db/id #edb/ref 17592186522180} :answer-field/id #uuid "6162e53b-5fec-54de-8f66-17e9b0f8dd66" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186522608}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d4080d1e-e850-5931-bd84-ee951a1d7967" :question/math-academy-id "q-182495" :question/problem "Simplify the statement $¬(¬R⇒S).$" :question/worked-solution "The conditional statement $P⇒Q$ is logically equivalent to the disjunction $¬P∨Q:$\n\nSo, in this case, we have the following equivalence:\n\n$$\n¬(¬R⇒S)≡¬(¬(¬R)∨S)\n$$\n\nCanceling out double negation, we have\n\n$$\n¬(¬(¬R)∨S)≡¬(R∨S).\n$$\n\nDistributing the negation over the disjunction using De Morgan's law, we reach\n\n$$\n¬(R∨S)≡¬R∧¬S.\n$$\n\nSo the given statement is equivalent to $¬R∧¬S.$"} :step/id #uuid "d0d1190b-b886-5957-a70e-937f4c9f20bb" :step/next {:db/id #edb/ref 17592186522881}} {:db/id #edb/ref 17592186522881 :step/content {:db/id #edb/ref 17592186379174 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "103ba745-89da-572a-8645-0e48e298eb69" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186453628} {:answer/id #uuid "6db316e3-11cf-581e-aba4-72198d752449" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186453629}] :answer-field/correct {:db/id #edb/ref 17592186453628} :answer-field/id #uuid "08fbb3c2-9e09-5166-81cf-b13e5f40f715" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186454564} {:answer-field/choices [{:answer/id #uuid "f8908055-e767-5cc9-8603-c9755f6acf08" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186453630} {:answer/id #uuid "2dee54e9-a7cf-5ff7-8cb7-66dd7d69200c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186453631}] :answer-field/correct {:db/id #edb/ref 17592186453630} :answer-field/id #uuid "605e62e8-9662-50d1-bfd8-1829ceb621ed" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186454565} {:answer-field/choices [{:answer/id #uuid "b7adbcc1-3421-5d01-aa06-a9b6e0ef1051" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186453632} {:answer/id #uuid "502be7d4-5665-556d-b837-f469b7e58366" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186453633}] :answer-field/correct {:db/id #edb/ref 17592186453633} :answer-field/id #uuid "d3efa2ca-31f9-5aba-80a2-9f4d61b15725" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186454566}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "b9dc8cb9-65d8-59f4-a25c-a9f9b514997d" :question/math-academy-id "q-182505" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $¬P⇒Q≡P∨¬Q$\n- **II.** $¬(¬P⇒Q)≡¬P∧Q$\n- **III.** $¬(¬P⇒Q)≡¬P∧¬Q$" :question/worked-solution "Let's examine each of our statements:\n\n- Statement I is false. Indeed, $¬P⇒Q$ is logically equivalent to the disjunction $¬(¬P)∨Q,$ which in turn is equivalent to $P∨Q.$\n\n- Statement II is false, while statement III is true. From part I, we have the following equivalence:\n\n$$\n¬P⇒Q≡P∨Q\n$$\n\nBy negating this statement, we get\n\n$$\n¬(¬P⇒Q)≡¬(P∨Q).\n$$\n\nDistributing the negation over the disjunction using De Morgan's law, we have\n\n$$\n¬(P∨Q)≡¬P∧¬Q.\n$$\n\nSo, $¬(¬P⇒Q)$ is equivalent to $¬P∧¬Q.$\n\nTherefore, the correct answer is \"III only.\""} :step/id #uuid "d2245027-bde6-5a7e-a4aa-e79ea31750ed" :step/next {:db/id #edb/ref 17592186522846}} {:db/id #edb/ref 17592186522884 :step/content {:db/id #edb/ref 17592186379154 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1235b15d-d7d6-5f3a-bf3f-7d77043d7bec" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "If you don't run fast, then you won't catch the bus." :db/id #edb/ref 17592186379156} {:answer/id #uuid "53ab7700-3dfd-5565-9aff-27a9268c913a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "If you don't run fast, then you will catch the bus." :db/id #edb/ref 17592186379157} {:answer/id #uuid "d09446f0-11c8-538e-a777-a2a00e058550" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Run fast, and you will catch the bus." :db/id #edb/ref 17592186379158} {:answer/id #uuid "f894612a-781a-552e-9304-4d03220c00ad" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "If you run fast, then you won't catch the bus." :db/id #edb/ref 17592186379159} {:answer/id #uuid "83883964-8f4c-5ab6-92b8-c04b7db3a85e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "If you run fast, then you will catch the bus." :db/id #edb/ref 17592186379160}] :answer-field/correct {:db/id #edb/ref 17592186379156} :answer-field/id #uuid "7d14afbb-e097-5b13-8cc9-4dcafbfa01db" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186379155}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f201af53-aacc-5987-a24c-2ae2629eceec" :question/math-academy-id "q-182459" :question/problem "$\\,$ Run fast, or you won’t catch the bus\n\nWhich conditional statement is logically equivalent to the disjunctive statement above?" :question/worked-solution "Let's denote by $A$ and $B$ the following statements:\n\n- $A:$ Run fast.\n\n- $B:$ You won’t catch the bus.\n\nThen, our initial statement can be written as $A∨B,$ which is logically equivalent to \n\n$$\n¬A⇒B.\n$$\n\nThe negation of $A$ can be written as\n\n- $¬A:$ You don't run fast.\n\nTherefore, the given statement is logically equivalent to the following:\n\n$\\,$ If you don't run fast, then you won't catch the bus."} :step/id #uuid "d6460e76-4f3f-5bce-8f44-b84778fad95a" :step/next {:db/id #edb/ref 17592186522879}}] :activity/title "Logical Equivalence with Conditional Statements" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186522006}]}
