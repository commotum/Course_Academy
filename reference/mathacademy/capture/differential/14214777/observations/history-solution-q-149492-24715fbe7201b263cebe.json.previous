>)</mo><mo>=</mo><mn>0.3</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi>P</mi><mo stretchy=\"false\">(</mo><msub><mi>T</mi><mn>3</mn></msub><mo stretchy=\"false\">)</mo><mo>=</mo><mn>0.14</mn></mtd><mtd></mtd><mtd><mi>P</mi><mo stretchy=\"false\">(</mo><mi>I</mi><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">|</mo></mrow><msub><mi>T</mi><mn>3</mn></msub><mo stretchy=\"false\">)</mo><mo>=</mo><mn>0.15</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container>\nThe disjoint union <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"188\" style=\"font-size: 113.1%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-msub><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D447 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: -0.15em; margin-left: -0.12em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn></mjx-script></mjx-msub><mjx-mo class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c2294\"></mjx-c></mjx-mo><mjx-msub space=\"3\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D447 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: -0.15em; margin-left: -0.12em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-script></mjx-msub><mjx-mo class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c2294\"></mjx-c></mjx-mo><mjx-msub space=\"3\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D447 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: -0.15em; margin-left: -0.12em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c33\"></mjx-c></mjx-mn></mjx-script></mjx-msub></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>T</mi><mn>1</mn></msub><mo>⊔</mo><msub><mi>T</mi><mn>2</mn></msub><mo>⊔</mo><msub><mi>T</mi><mn>3</mn></msub></math></mjx-assistive-mml></mjx-container> covers the entire sample space, and we have\n<mjx-container class=\"