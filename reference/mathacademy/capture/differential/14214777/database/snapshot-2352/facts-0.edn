edb/ref 17592186045417] [17592186487131 #edb/ref 1083 #uuid "faeb72a2-110a-55d3-ba57-0a887a322d2d" #edb/ref 17592186045417] [17592186487137 #edb/ref 1080 "0.740" #edb/ref 17592186045417] [17592186487137 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186487137 #edb/ref 1083 #uuid "ff1bcac5-e08b-5cb7-8e74-64d1c2bee8b5" #edb/ref 17592186045417] [17592186487138 #edb/ref 1075 #edb/ref 17592186486638 #edb/ref 17592186045417] [17592186487138 #edb/ref 1075 #edb/ref 17592186486836 #edb/ref 17592186045417] [17592186487138 #edb/ref 1075 #edb/ref 17592186487127 #edb/ref 17592186045417] [17592186487138 #edb/ref 1075 #edb/ref 17592186487128 #edb/ref 17592186045417] [17592186487138 #edb/ref 1075 #edb/ref 17592186487131 #edb/ref 17592186045417] [17592186487138 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186487138 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186487138 #edb/ref 1078 #edb/ref 17592186486638 #edb/ref 17592186045417] [17592186487138 #edb/ref 1079 #uuid "00cf1d61-f08e-59ba-9b21-977d6711da5a" #edb/ref 17592186045417] [17592186487140 #edb/ref 1075 #edb/ref 17592186486610 #edb/ref 17592186045417] [17592186487140 #edb/ref 1075 #edb/ref 17592186486656 #edb/ref 17592186045417] [17592186487140 #edb/ref 1075 #edb/ref 17592186486692 #edb/ref 17592186045417] [17592186487140 #edb/ref 1075 #edb/ref 17592186486838 #edb/ref 17592186045417] [17592186487140 #edb/ref 1075 #edb/ref 17592186487137 #edb/ref 17592186045417] [17592186487140 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186487140 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186487140 #edb/ref 1078 #edb/ref 17592186487137 #edb/ref 17592186045417] [17592186487140 #edb/ref 1079 #uuid "0a4501a8-443f-5ae0-aa78-dccc204637f1" #edb/ref 17592186045417] [17592186487183 #edb/ref 1075 #edb/ref 17592186486615 #edb/ref 17592186045417] [17592186487183 #edb/ref 1075 #edb/ref 17592186486800 #edb/ref 17592186045417] [17592186487183 #edb/ref 1075 #edb/ref 17592186486848 #edb/ref 17592186045417] [17592186487183 #edb/ref 1075 #edb/ref 17592186486858 #edb/ref 17592186045417] [17592186487183 #edb/ref 1075 #edb/ref 17592186487084 #edb/ref 17592186045417] [17592186487183 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186487183 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186487183 #edb/ref 1078 #edb/ref 17592186486848 #edb/ref 17592186045417] [17592186487183 #edb/ref 1079 #uuid "5b922273-f540-5f67-8f2c-45b151c3e563" #edb/ref 17592186045417] [17592186487194 #edb/ref 1075 #edb/ref 17592186486603 #edb/ref 17592186045417] [17592186487194 #edb/ref 1075 #edb/ref 17592186486669 #edb/ref 17592186045417] [17592186487194 #edb/ref 1075 #edb/ref 17592186486719 #edb/ref 17592186045417] [17592186487194 #edb/ref 1075 #edb/ref 17592186486971 #edb/ref 17592186045417] [17592186487194 #edb/ref 1075 #edb/ref 17592186486988 #edb/ref 17592186045417] [17592186487194 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186487194 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186487194 #edb/ref 1078 #edb/ref 17592186486669 #edb/ref 17592186045417] [17592186487194 #edb/ref 1079 #uuid "698fc6a4-867b-5609-8d53-bcc56debe7fa" #edb/ref 17592186045417] [17592186487277 #edb/ref 1075 #edb/ref 17592186486752 #edb/ref 17592186045417] [17592186487277 #edb/ref 1075 #edb/ref 17592186486795 #edb/ref 17592186045417] [17592186487277 #edb/ref 1075 #edb/ref 17592186486826 #edb/ref 17592186045417] [17592186487277 #edb/ref 1075 #edb/ref 17592186487043 #edb/ref 17592186045417] [17592186487277 #edb/ref 1075 #edb/ref 17592186487075 #edb/ref 17592186045417] [17592186487277 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186487277 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186487277 #edb/ref 1078 #edb/ref 17592186486826 #edb/ref 17592186045417] [17592186487277 #edb/ref 1079 #uuid "f77d5683-3c91-57b4-a6c6-baacce64e39e" #edb/ref 17592186045417] [17592186487321 #edb/ref 1068 #edb/ref 17592186487183 #edb/ref 17592186045417] [17592186487321 #edb/ref 1069 "q-147882" #edb/ref 17592186045417] [17592186487321 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186487321 #edb/ref 1071 "The disjoint union ${A}_{1}⊔{A}_{2}⊔{A}_{3}$ of events ${A}_{1},{A}_{2},{A}_{3}$ covers the entire sample space. Compute $P({A}_{2}|B)$ given the following probabilities:\n\n$$\n\\begin{aligned} & P(B|{A}_{1})=\\frac{1}{5}, & P({A}_{1})=\\frac{1}{4} \\\\  & P(B|{A}_{2})=\\frac{1}{8}, & P({A}_{2})=\\frac{2}{5} \\\\  & P(B|{A}_{3})=1, & P({A}_{3})=\\frac{7}{20}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186487321 #edb/ref 1072 #uuid "43f08f68-330a-59ee-956f-33e7cbacb451" #edb/ref 17592186045417] [17592186487321 #edb/ref 1074 "If the disjoint union ${A}_{1}⊔{A}_{2}⊔…⊔{A}_{n}$ covers the entire sample space, Bayes' theorem combined with the law of total probability gives us the following:\n\n$$\nP({A}_{k}|B)=\\frac{P(B|{A}_{k})P({A}_{k})}{P(B)}=\\frac{P(B|{A}_{k})P({A}_{k})}{{\\sum }_{i=1}^{n}P(B|{A}_{i})P({A}_{i})}\n$$\n\nwhere $k=1,2,…,n.$\n\nIn our case, $n=3,$ and ${A}_{1}⊔{A}_{2}⊔{A}_{3}$ covers the entire sample space. Consequently, we have\n\n$$\nP({A}_{1})+P({A}_{2})+P({A}_{3})=\\frac{1}{4}+\\frac{2}{5}+\\frac{7}{20}=1.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}P({A}_{2}|B) & =\\frac{P(B|{A}_{2})P({A}_{2})}{{\\sum }_{i=1}^{3}P(B|{A}_{i})P({A}_{i})} \\\\  & =\\frac{P(B|{A}_{2})P({A}_{2})}{P(B|{A}_{1})P({A}_{1})+P(B|{A}_{2})P({A}_{2})+P(B|{A}_{3})P({A}_{3})} \\\\  & =\\frac{(\\frac{1}{8})(\\frac{2}{5})}{(\\frac{1}{5})(\\frac{1}{4})+(\\frac{1}{8})(\\frac{2}{5})+(1)(\\frac{7}{20})} \\\\  & =\\frac{(\\frac{1}{20})}{(\\frac{9}{20})} \\\\  & =\\frac{1}{9}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186487326 #edb/ref 1068 #edb/ref 17592186487138 #edb/ref 17592186045417] [17592186487326 #edb/ref 1069 "q-148152" #edb/ref 17592186045417] [17592186487326 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186487326 #edb/ref 1071 "Some researchers want to test the belief that teenagers who play an instrument are more likely to be good at math. They collect data on a large sample of teenagers that play an instrument.\n\n- $30%$ of teenagers play piano, and $50%$ of those teenagers are good at mathematics.\n\n- $20%$ of teenagers play violin, and $60%$ of those teenagers are good at mathematics.\n\n- $50%$ of teenagers play other instruments, and $47%$ of those teenagers are good at mathematics.\n\nIf $10%$ of teenagers started to play music before $6$ years old, and $58%$ of teenagers who started to play before $6$ years old are good at math, what is the probability that a randomly chosen teenager that is good at math started to play music before $6$ years old? Round your answer to $3$ decimal places." #edb/ref 17592186045417] [17592186487326 #edb/ref 1072 #uuid "521e5a18-fa22-58cf-9f82-7b4aa14a1323" #edb/ref 17592186045417] [17592186487326 #edb/ref 1074 "Let $B$ be the event that a teenager started to play music before $6$ years old, $M$ be the event that a teenager is good at math, and ${T}_{1},{T}_{2},{T}_{3}$ be the events that a teenager plays piano, violin, or another instrument, respectively. \n\nLet's break down the information given in the problem statement:\n\n- From the bullet points, we have the following information:\n\n$$\n\\begin{aligned} & P({T}_{1})=0.3 &  & P(M|{T}_{1})=0.5 \\\\  & P({T}_{2})=0.2 &  & P(M|{T}_{2})=0.6 \\\\  & P({T}_{3})=0.5 &  & P(M|{T}_{3})=0.47\\end{aligned}\n$$\n\nThe disjoint union ${T}_{1}⊔{T}_{2}⊔{T}_{3}$ covers the entire sample space, and we have\n\n$$\nP({T}_{1})+P({T}_{2})+P({T}_{3})=0.3+0.2+0.5=1.\n$$\n\n- Since $10%$ of teenagers started to play before $6$ years old, we have\n\n$$\nP(B)=0.1.\n$$\n\n- Since $58%$ of students who started to play before $6$ years old are good at math, we have\n\n$$\nP(M|B)=0.58.\n$$\n\nWe want to find the probability that a randomly chosen teenager who is good at math started to play before $6$ years old, which is represented as $P(B|M).$ \n\nUsing Bayes' theorem combined with the law of total probability, we have\n\n$$\n\\begin{aligned}P(B|M) & =\\frac{P(M|B)P(B)}{P(M)} \\\\  & =\\frac{P(M|B)P(B)}{P(M|{T}_{1})P({T}_{1})+P(M|{T}_{2})P({T}_{2})+P(M|{T}_{3})P({T}_{3})} \\\\  & =\\frac{(0.58)(0.1)}{(0.5)(0.3)+(0.6)(0.2)+(0.47)(0.5)} \\\\  & =\\frac{0.058}{0.505} \\\\  & ≈0.115,\\end{aligned}\n$$\n\nrounded to $3$ decimal places." #edb/ref 17592186045417] [17592186487354 #edb/ref 1068 #edb/ref 17592186487140 #edb/ref 17592186045417] [17592186487354 #edb/ref 1069 "q-148523" #edb/ref 17592186045417] [17592186487354 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186487354 #edb/ref 1071 "A company is selling a new product on three e-commerce platforms, platform $1,$ platform $2,$ and platform $3.$\n\n- $44%$ of customers bought the product on platform $1,$ and $70%$ of those customers were satisfied with the product.\n\n- $25%$ of customers bought the product on platform $2,$ and $85%$ of those customers were satisfied with the product.\n\n- $31%$ of customers bought the product on platform $3.$\n\nIf $25%$ of all customers are teenagers, $60%$ of teenage customers are satisfied with the product, and $20%$ of satisfied customers are teenagers, what is the probability that a randomly chosen customer from platform $3$ is satisfied? Round your answer to $3$ decimal places." #edb/ref 17592186045417] [17592186487354 #edb/ref 1072 #uuid "9b22d29b-922e-508b-b541-5acf3087f769" #edb/ref 17592186045417] [17592186487354 #edb/ref 1074 "Let $T$ be the event that a customer is a teenager, $S$ be the event that a customer is satisfied, and ${P}_{1},{P}_{2},{P}_{3}$ be the event that a customer bought the product on platform $1,$ $2,$ or $3,$ respectively. \n\nLet's break down the information given in the problem statement:\n\n- From the bullet points, we have the following information:\n\n$$\n\\begin{aligned} & P({P}_{1})=0.44 &  & P(S|{P}_{1})=0.7 \\\\  & P({P}_{2})=0.25 &  & P(S|{P}_{2})=0.85 \\\\  & P({P}_{3})=0.31\\end{aligned}\n$$\n\nThe disjoint union ${P}_{1}⊔{P}_{2}⊔{P}_{3}$ covers the entire sample space, and we have\n\n$$\nP({P}_{1})+P({P}_{2})+P({P}_{3})=0.44+0.25+0.31=1.\n$$\n\n- Since $25%$ of all customers are teenagers, we have\n\n$$\nP(T)=0.25.\n$$\n\n- Since $60%$ of teenage customers are satisfied, we have\n\n$$\nP(S|T)=0.6.\n$$\n\n- Since $20%$ of satisfied customers are teenagers, we have\n\n$$\nP(T|S)=0.2.\n$$\n\nWe want to find the probability that a randomly chosen customer from platform $3$ is satisfied with the product, which is represented as $P(S|{P}_{3}).$\n\nUsing Bayes' theorem combined with the law of total probability, we have\n\n$$\n\\begin{aligned}P(T|S) & =\\frac{P(S|T)P(T)}{P(S)} \\\\ 0.2 & =\\frac{P(S|T)P(T)}{P(S|{P}_{1})P({P}_{1})+P(S|{P}_{2})P({P}_{2})+P(S|{P}_{3})P({P}_{3})} \\\\ 0.2 & =\\frac{(0.60)(0.25)}{(0.7)(0.44)+(0.85)(0.25)+P(S|{P}_{3})(0.31)} \\\\ 0.2 & =\\frac{0.15}{0.5205+0.31P(S|{P}_{3})}\\end{aligned}\n$$\n\nSolving this equation for $P(S|{P}_{3}),$ we have\n\n$$\n\\begin{aligned}0.2(0.5205+0.31P(S|{P}_{3})) & =0.15 \\\\ 0.5205+0.31P(S|{P}_{3}) & =\\frac{0.15}{0.2} \\\\ 0.5205+0.31P(S|{P}_{3}) & =\\frac{3}{4} \\\\ 0.31P(S|{P}_{3}) & =\\frac{3}{4}-0.5205 \\\\ P(S|{P}_{3}) & =\\frac{1}{0.31}(\\frac{3}{4}-0.5205) \\\\ P(S|{P}_{3}) & ≈0.740\\end{aligned}\n$$\n\nrounded to three decimal places." #edb/ref 17592186045417] [17592186487380 #edb/ref 1068 #edb/ref 17592186487277 #edb/ref 17592186045417] [17592186487380 #edb/ref 1069 "q-147887" #edb/ref 17592186045417] [17592186487380 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186487380 #edb/ref 1071 "The disjoint union ${A}_{1}⊔{A}_{2}⊔{A}_{3}⊔{A}_{4}$ of events ${A}_{1},{A}_{2},{A}_{3},{A}_{4}$ covers the entire sample space. Compute $P({A}_{1}|B)$ given the following probabilities:\n\n$$\n\\begin{aligned} & P(B|{A}_{1})=\\frac{1}{5}, &  \\\\  & P(B|{A}_{2})=0, & P({A}_{2})=\\frac{1}{4} \\\\  & P(B|{A}_{3})=\\frac{1}{5}, & P({A}_{3})=\\frac{1}{8} \\\\  & P(B|{A}_{4})=\\frac{2}{5}, & P({A}_{4})=\\frac{1}{4}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186487380 #edb/ref 1072 #uuid "c768c6df-9213-55c1-bcb4-06af864aa6e9" #edb/ref 17592186045417] [17592186487380 #edb/ref 1074 "If the disjoint union ${A}_{1}⊔{A}_{2}⊔…⊔{A}_{n}$ covers the entire sample space, Bayes' theorem combined with the law of total probability gives us the following:\n\n$$\nP({A}_{k}|B)=\\frac{P(B|{A}_{k})P({A}_{k})}{P(B)}=\\frac{P(B|{A}_{k})P({A}_{k})}{{\\sum }_{i=1}^{n}P(B|{A}_{i})P({A}_{i})}\n$$\n\nwhere $k=1,2,…,n.$\n\nIn our case, $n=4,$ and ${A}_{1}⊔{A}_{2}⊔{A}_{3}⊔{A}_{4}$ covers the entire sample space. Consequently, we have\n\n$$\nP({A}_{1})+P({A}_{2})+P({A}_{3})+P({A}_{4})=1.\n$$\n\nAs a result,\n\n$$\n\\begin{aligned}P({A}_{1}) & =1-(P({A}_{2})+P({A}_{3})+P({A}_{4})) \\\\  & =1-(\\frac{1}{4}+\\frac{1}{8}+\\frac{1}{4}) \\\\  & =\\frac{3}{8}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P({A}_{1}|B) & =\\frac{P(B|{A}_{1})P({A}_{1})}{{\\sum }_{i=1}^{4}P(B|{A}_{i})P({A}_{i})} \\\\  & =\\frac{P(B|{A}_{1})P({A}_{1})}{P(B|{A}_{1})P({A}_{1})+P(B|{A}_{2})P({A}_{2})+P(B|{A}_{3})P({A}_{3})+P(B|{A}_{4})P({A}_{4})} \\\\  & =\\frac{(\\frac{1}{5})(\\frac{3}{8})}{(\\frac{1}{5})(\\frac{3}{8})+(0)(\\frac{1}{4})+(\\frac{1}{5})(\\frac{1}{8})+(\\frac{2}{5})(\\frac{1}{4})} \\\\  & =\\frac{(\\frac{3}{40})}{(\\frac{1}{5})} \\\\  & =\\frac{3}{8}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186487403 #edb/ref 1068 #edb/ref 17592186487194 #edb/ref 17592186045417] [17592186487403 #edb/ref 1069 "q-159358" #edb/ref 17592186045417] [17592186487403 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186487403 #edb/ref 1071 "A travel agency offers three itineraries, itinerary $1,$ itinerary $2,$ and itinerary $3.$ For each itinerary, customers can decide to travel using their own car or the agency's bus.\n\n- Itinerary $1$ is chosen by $60%$ of the customers, and $10%$ of those customers travel by bus.\n\n- Itinerary $2$ is chosen by $20%$ of the customers, and $25%$ of those customers travel by bus.\n\n- Itinerary $3$ is chosen by $20%$ of the customers.\n\nIf $30%$ of all customers travel with children, $50%$ of customers with children choose the bus, and $83%$ of customers that choose the bus travel with children, what is the probability that a randomly chosen customer that chooses itinerary $3$ takes the bus? Round your answer to $3$ decimal places." #edb/ref 17592186045417] [17592186487403 #edb/ref 1072 #uuid "fa54d1c3-840f-55dc-9c9a-7cb1c9435baf" #edb/ref 17592186045417] [17592186487403 #edb/ref 1074 "Let $C$ be the event that a customer has children, $B$ be the event that a customer takes the bus, and ${I}_{1},{I}_{2},{I}_{3}$ be the event that a customer chooses itinerary $1,$ $2,$ or $3,$ respectively. \n\nLet's break down the information given in the problem statement:\n\n- From the bullet points, we have the following information:\n\n$$\n\\begin{aligned} & P({I}_{1})=0.6 &  & P(B|{I}_{1})=0.1 \\\\  & P({I}_{2})=0.2 &  & P(B|{I}_{2})=0.25 \\\\  & P({I}_{3})=0.2\\end{aligned}\n$$\n\nThe disjoint union ${I}_{1}⊔{I}_{2}⊔{I}_{3}$ covers the entire sample space, and we have\n\n$$\nP({I}_{1})+P({I}_{2})+P({I}_{3})=0.6+0.2+0.2=1.\n$$\n\n- Since $30%$ of customers have children, we have\n\n$$\nP(C)=0.3.\n$$\n\n- Since $50%$ of customers with children choose the bus, we have\n\n$$\nP(B|C)=0.5.\n$$\n\n- Since $83%$ of customers that choose the bus have children, we have\n\n$$\nP(C|B)=0.83.\n$$\n\nWe want to find the probability that a randomly chosen customer that chooses itinerary $3$ travels by bus, which is represented as $P(B|{I}_{3}).$ \n\nUsing Bayes' theorem combined with the law of total probability, we have\n\n$$\n\\begin{aligned}P(C|B) & =\\frac{P(B|C)P(C)}{P(B)} \\\\ P(C|B) & =\\frac{P(B|C)P(C)}{P(B|{I}_{1})P({I}_{1})+P(B|{I}_{2})P({I}_{2})+P(B|{I}_{3})P({I}_{3})} \\\\ 0.83 & =\\frac{(0.5)(0.3)}{(0.1)(0.6)+(0.25)(0.2)+P(B|{I}_{3})(0.2)} \\\\ 0.83 & =\\frac{0.15}{0.11+0.2P(B|{I}_{3})}.\\end{aligned}\n$$\n\nSolving this equation for $P(B|{I}_{3}),$ we have\n\n$$\n\\begin{aligned}0.83(0.11+0.2P(B|{I}_{3})) & =0.15 \\\\ 0.11+0.2P(B|{I}_{3}) & =\\frac{0.15}{0.83} \\\\ 0.11+0.2P(B|{I}_{3}) & =\\frac{15}{83} \\\\ 0.2P(B|{I}_{3}) & =\\frac{15}{83}-0.11 \\\\ P(B|{I}_{3}) & =\\frac{1}{0.2}(\\frac{15}{83}-0.11) \\\\ P(B|{I}_{3}) & ≈0.354\\end{aligned}\n$$\n\nrounded to three decimal places." #edb/ref 17592186045417] [17592186493388 #edb/ref 1043 #edb/ref 17592186493998 #edb/ref 17592186045417] [17592186493388 #edb/ref 1043 #edb/ref 17592186494026 #edb/ref 17592186045417] [17592186493388 #edb/ref 1043 #edb/ref 17592186494049 #edb/ref 17592186045417] [17592186493388 #edb/ref 1043 #edb/ref 17592186494060 #edb/ref 17592186045417] [17592186493388 #edb/ref 1043 #edb/ref 17592186494071 #edb/ref 17592186045417] [17592186493388 #edb/ref 1044 #edb/ref 17592186045464 #edb/ref 17592186045417] [17592186493388 #edb/ref 1045 "Extending Bayes' Theorem" #edb/ref 17592186045417] [17592186493388 #edb/ref 1046 #edb/ref 17592186494026 #edb/ref 17592186045417] [17592186493388 #edb/ref 1048 #edb/ref 17592186046659 #edb/ref 17592186045417] [17592186493388 #edb/ref 1049 #edb/ref 17592186048270 #edb/ref 17592186045417] [17592186493388 #edb/ref 1053 #uuid "cebad3dd-e992-52ed-b284-8c84be80cca2" #edb/ref 17592186045417] [17592186493402 #edb/ref 1080 "0.05" #edb/ref 17592186045417] [17592186493402 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186493402 #edb/ref 1083 #uuid "08123d50-e1d2-5e75-87c8-dc4ecec898fa" #edb/ref 17592186045417] [17592186493415 #edb/ref 1080 "0.08" #edb/ref 17592186045417] [17592186493415 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186493415 #edb/ref 1083 #uuid "0efdb1e8-9c52-52d4-b930-051a0d37a2ac" #edb/ref 17592186045417] [17592186493416 #edb/ref 1080 "0.369" #edb/ref 17592186045417] [17592186493416 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592