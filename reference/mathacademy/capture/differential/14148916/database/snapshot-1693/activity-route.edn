#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186455517} :activity/id #uuid "dd948f84-01c7-51cf-b5c9-f9c00a2b84b8" :activity/scope {:db/id #edb/ref 17592186050638 :topic/id #uuid "5ae18ce0-90c2-55f7-8d81-bd5949f05aa3" :topic/math-academy-id 1864} :activity/steps [{:db/id #edb/ref 17592186455516 :step/content {:db/id #edb/ref 17592186455442 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "066bb7c4-7521-5727-993a-55db17b87282" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186454919} {:answer/id #uuid "49378edd-134f-5712-a720-7f1c131c32c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186455026} {:answer/id #uuid "a6f74b12-935c-5e33-a5e5-220baef222b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\notin \\text{Span}\\{{b}_{1},{b}_{2},{b}_{3}\\}" :db/id #edb/ref 17592186455198} {:answer/id #uuid "b4852b6d-9a78-5d08-bc44-0fc169587a8b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186455217} {:answer/id #uuid "f9fc417c-d758-5208-baf3-43da35bca066" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186455333}] :answer-field/correct {:db/id #edb/ref 17592186455333} :answer-field/id #uuid "8aa3925e-da8c-56e5-b9b6-c047f1edb4c2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186455385}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "3d89aeef-7acc-5575-9764-44e144045f82" :question/math-academy-id "q-75998" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B=\\{{b}_{1},{b}_{2},{b}_{3}\\},$ where\n\n$$\n{b}_{1}=[\\begin{aligned}1 \\\\ 3 \\\\ 2\\end{aligned}],\\,{b}_{2}=[\\begin{aligned}1 \\\\ 2 \\\\ 2\\end{aligned}],\\,{b}_{3}=[\\begin{aligned}1 \\\\ 1 \\\\ -1\\end{aligned}],\\,x=[\\begin{aligned}6 \\\\ 11 \\\\ 6\\end{aligned}].\n$$\n\nIf $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]$ then what is the value of ${x}_{1}?$" :question/worked-solution "We need to find ${x}_{1}$,  ${x}_{2}$, and ${x}_{3}$ such that  \n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2}+{x}_{3}{b}_{3} & =x \\\\ {x}_{1}[\\begin{aligned}1 \\\\ 3 \\\\ 2\\end{aligned}]+{x}_{2}[\\begin{aligned}1 \\\\ 2 \\\\ 2\\end{aligned}]+{x}_{3}[\\begin{aligned}1 \\\\ 1 \\\\ -1\\end{aligned}] & =[\\begin{aligned}6 \\\\ 11 \\\\ 6\\end{aligned}].\\end{aligned}\n$$\n\nFrom this, we get the system with the augmented matrix $M$, which we reduce using Gaussian elimination: \n\n$$\n\\begin{aligned}M= & [\\begin{aligned}1 & 1 & 1 & 6 \\\\ 3 & 2 & 1 & 11 \\\\ 2 & 2 & -1 & -6\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\ ∼ & [\\begin{aligned}1 & 1 & 1 & 6 \\\\ 0 & -1 & -2 & 7 \\\\ 2 & 2 & -1 & -6\\end{aligned}] & {R}_{3} & :={R}_{3}+(-2){R}_{2} \\\\ ∼ & [\\begin{aligned}1 & 1 & 1 & 6 \\\\ 0 & -1 & -2 & -7 \\\\ 0 & 0 & -3 & -6\\end{aligned}]\\end{aligned}\n$$\n\n  \n\nThe system is now \n\n$$\n\\{\\begin{aligned}{x}_{1}+{x}_{2}+{x}_{3}=6 \\\\ -{x}_{2}-2{x}_{3}=-7 \\\\ -3{x}_{3}=-6.\\end{aligned}\n$$\n\nFrom the third equation, we get ${x}_{3}=2.$ Substituting this into the second   equation yields\n\n$$\n-{x}_{2}-2(2)=-7\\,⟹\\,{x}_{2}=3.\n$$\n\n Finally,  by substituting ${x}_{2}=3$ and ${x}_{3}=2$ into the first equation we obtain\n\n$$\n{x}_{1}+(3)+2=6\\,⟹\\,{x}_{1}=1.\n$$\n\nTherefore, $[x]_{B}=[\\begin{aligned}1 \\\\ 3 \\\\ 2\\end{aligned}].$\n\nSo, we have ${x}_{1}=1.$"} :step/id #uuid "3120d902-59cf-52cd-afde-5f7a4f7e1d5f" :step/next {:db/id #edb/ref 17592186455531}} {:db/id #edb/ref 17592186455517 :step/content {:db/id #edb/ref 17592186120352 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "028867b0-8cf6-524a-93e6-8e63fa02e23d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186317580} {:answer/id #uuid "2f329de5-7c1a-5fad-b2d2-f7cc8384731d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186317709} {:answer/id #uuid "5f5bbc70-a2a7-5d4f-9c69-50122cef639d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186317888} {:answer/id #uuid "844d0795-32e6-5eb9-9815-e5906f5fb3e2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186318014} {:answer/id #uuid "c5c361cd-49f5-527f-91c1-eb17cbe67bc5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\notin \\text{Span}\\{{b}_{1},{b}_{2}\\}" :db/id #edb/ref 17592186455244}] :answer-field/correct {:db/id #edb/ref 17592186317580} :answer-field/id #uuid "add90972-43b4-50ff-b652-f7e992bc2ad7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186318801}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f17a8e42-194f-52ed-9136-123dd348b4bc" :question/math-academy-id "q-34617" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B=\\{{b}_{1},{b}_{2}\\},$ where\n\n$$\n{b}_{1}=[\\begin{aligned}1 \\\\ -2\\end{aligned}],\\,{b}_{2}=[\\begin{aligned}2 \\\\ 1\\end{aligned}],\\,x=[\\begin{aligned}2 \\\\ 6\\end{aligned}].\n$$\n\nIf $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$ then what is the value of ${x}_{1}+{x}_{2}?$" :question/worked-solution "We need to find ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2} & =x \\\\ {x}_{1}[\\begin{aligned}1 \\\\ -2\\end{aligned}]+{x}_{2}[\\begin{aligned}2 \\\\ 1\\end{aligned}] & =[\\begin{aligned}2 \\\\ 6\\end{aligned}].\\end{aligned}\n$$\n\nThe equation above gives the system with the augmented matrix\n\n$$\nM=[\\begin{aligned}1 & 2 & 2 \\\\ -2 & 1 & 6\\end{aligned}].\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 2 & 2 \\\\ -2 & 1 & 6\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & 2 \\\\ 0 & 5 & 10\\end{aligned}]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\{\\begin{aligned}{x}_{1}+2{x}_{2}=2 \\\\ 5{x}_{2}=10.\\end{aligned}\n$$\n\nFrom the second equation, we get ${x}_{2}=2.$ Substituting this into the first equation, we obtain\n\n$$\n{x}_{1}+2(2)=2\\,⟹\\,{x}_{1}=-2.\n$$\n\nTherefore, $[x]_{B}=[\\begin{aligned}-2 \\\\ 2\\end{aligned}].$\n\nFinally, ${x}_{1}+{x}_{2}=(-2)+2=0.$"} :step/id #uuid "3d7897f3-95d9-53e4-9b05-08455a50a2b6" :step/next {:db/id #edb/ref 17592186455528}} {:db/id #edb/ref 17592186455527 :step/content {:db/id #edb/ref 17592186409819 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2115aac5-da66-5510-8b11-176ba754f81a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186409789} {:answer/id #uuid "45dbc0e6-16a9-5c62-a183-2dd30e767a3a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186409790} {:answer/id #uuid "60013665-0a5a-5449-9017-6cb6ae7ed2ca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-7" :db/id #edb/ref 17592186409792} {:answer/id #uuid "7ad6f309-f775-5604-ba46-fa9609a5688b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186409798} {:answer/id #uuid "ba977b58-8add-5c57-ae69-640a36ab4ef9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-8" :db/id #edb/ref 17592186409803}] :answer-field/correct {:db/id #edb/ref 17592186409792} :answer-field/id #uuid "fe323417-1cf2-5a08-b6a1-9d36f7d769a5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186409816}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d9b245f0-31aa-56fe-aa26-5663dd9e140f" :question/math-academy-id "q-112211" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B=\\{{b}_{1},{b}_{2}\\},$ where\n\n$$\n{b}_{1}=[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}],\\,{b}_{2}=[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}],\\,x=[\\begin{aligned}-7 \\\\ -8 \\\\ 0\\end{aligned}].\n$$\n\nIf $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$ then what is the value of ${x}_{2}?$" :question/worked-solution "Remember, the order of the vectors in a basis is important.\n\nNotice that \n\n$$\n{{[\\begin{aligned}-7 \\\\ -8 \\\\ 0\\end{aligned}]}_{⏟}}_{x}={{(\\,-8\\,)}_{⏟}}_{{x}_{1}}\\cdot {{[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]}_{⏟}}_{{b}_{1}}+{{(\\,-7\\,)}_{⏟}}_{{x}_{2}}\\cdot {{[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}]}_{⏟}}_{{b}_{2}}\n$$\n\nwhich means that\n\n$$\nx=(-8)\\cdot {b}_{1}+(-7)\\cdot {b}_{2}\n$$\n\nand therefore\n\n$$\n[x]_{B}=[\\begin{aligned}-8 \\\\ -7\\end{aligned}].\n$$\n\nFinally, we have that ${x}_{2}=-7.$"} :step/id #uuid "af36c254-27dd-5c17-9617-e7f9d654737f"} {:db/id #edb/ref 17592186455528 :step/content {:db/id #edb/ref 17592186319175 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28f401e4-eb59-5198-abf4-1458830b331c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186317692} {:answer/id #uuid "55e9e214-e0b3-5771-95e7-5cb487ad7118" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186317852} {:answer/id #uuid "914f6ffc-e4c9-5161-9fde-b475bcf8fceb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186318060} {:answer/id #uuid "e0273188-6c7e-5354-921c-cdc4386a3d9a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186318313} {:answer/id #uuid "32fd85ec-3fca-5fdb-8d41-028482470a84" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\notin \\text{span}\\{{b}_{1},{b}_{2}\\}" :db/id #edb/ref 17592186454982}] :answer-field/correct {:db/id #edb/ref 17592186317852} :answer-field/id #uuid "e0750bff-0d7b-54f9-bc9f-9e5f7a657747" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186318894}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "706ae806-e20f-56d6-9072-359885047529" :question/math-academy-id "q-34738" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B=\\{{b}_{1},{b}_{2}\\},$ where\n\n$$\n{b}_{1}=[\\begin{aligned}-1 \\\\ 5 \\\\ 0\\end{aligned}],\\,{b}_{2}=[\\begin{aligned}4 \\\\ 2 \\\\ -3\\end{aligned}],\\,x=[\\begin{aligned}6 \\\\ -8 \\\\ -3\\end{aligned}].\n$$\n\nIf $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$ then what is the value of ${x}_{1}+{x}_{2}?$" :question/worked-solution "We need to find ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2} & =x \\\\ {x}_{1}[\\begin{aligned}-1 \\\\ 5 \\\\ 0\\end{aligned}]+{x}_{2}[\\begin{aligned}4 \\\\ 2 \\\\ -3\\end{aligned}] & =[\\begin{aligned}6 \\\\ -8 \\\\ -3\\end{aligned}].\\end{aligned}\n$$\n\nThe equation above gives the system with the augmented matrix \n\n$$\nM=[\\begin{aligned}-1 & 4 & 6 \\\\ 5 & 2 & -8 \\\\ 0 & -3 & -3\\end{aligned}].\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following: \n\n$$\n\\begin{aligned}M= & [\\begin{aligned}-1 & 4 & 6 \\\\ 5 & 2 & -8 \\\\ 0 & -3 & -3\\end{aligned}] & {R}_{2}:={R}_{2}+5{R}_{1} \\\\ ∼ & [\\begin{aligned}-1 & 4 & 6 \\\\ 0 & 22 & 22 \\\\ 0 & -3 & -3\\end{aligned}] & {R}_{3}:={R}_{3}+\\frac{3}{22}{R}_{2} \\\\ ∼ & [\\begin{aligned}-1 & 4 & 6 \\\\ 0 & 22 & 22 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\{\\begin{aligned}-{x}_{1}+4{x}_{2}=6 \\\\ 22{x}_{2}=22.\\end{aligned}\n$$\n\nFrom the second equation, we get ${x}_{2}=1.$ Substituting this into the first equation, we obtain\n\n$$\n-{x}_{1}+4(1)=6\\,⟹\\,{x}_{1}=-2.\n$$\n\nTherefore, $[x]_{B}=[\\begin{aligned}-2 \\\\ 1\\end{aligned}].$ \n\nFinally, ${x}_{1}+{x}_{2}=-2+1=-1.$"} :step/id #uuid "bc51db51-8852-5a95-a4d4-b77331fb8d8a" :step/next {:db/id #edb/ref 17592186455516}} {:db/id #edb/ref 17592186455531 :step/content {:db/id #edb/ref 17592186455505 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2679ade7-de7e-5ff4-88c8-94968abbecd0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186454962} {:answer/id #uuid "2e4e66c0-8e5c-5dff-8789-8ac0302fb04b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186454974} {:answer/id #uuid "58225722-5487-53b4-b242-37a168921893" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186455056} {:answer/id #uuid "a19f8251-ccaa-52d8-8b83-bba63f64cb63" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\notin \\text{Span}\\{{b}_{1},{b}_{2},{b}_{3}\\}" :db/id #edb/ref 17592186455191} {:answer/id #uuid "f7cbfdfe-250f-5f75-93f6-f1ca311bd2d2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186455327}] :answer-field/correct {:db/id #edb/ref 17592186454962} :answer-field/id #uuid "8c6024f5-9069-597b-a291-cd59361ac136" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186455386}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e3764343-10e9-5a7d-b034-e095faf7f51c" :question/math-academy-id "q-76054" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B=\\{{b}_{1},{b}_{2},{b}_{3}\\},$ where\n\n$$\n{b}_{1}=[\\begin{aligned}1 \\\\ 0 \\\\ 3\\end{aligned}],\\,{b}_{2}=[\\begin{aligned}-1 \\\\ 2 \\\\ 1\\end{aligned}],\\,{b}_{3}=[\\begin{aligned}1 \\\\ 3 \\\\ 0\\end{aligned}],\\,x=[\\begin{aligned}3 \\\\ 15 \\\\ 12\\end{aligned}].\n$$\n\nIf $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]$ then what is the value of ${x}_{1}+{x}_{2}+{x}_{3}?$" :question/worked-solution "We need to find ${x}_{1}$,  ${x}_{2}$, and ${x}_{3}$ such that\n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2}+{x}_{3}{b}_{3} & =x \\\\ {x}_{1}[\\begin{aligned}1 \\\\ 0 \\\\ 3\\end{aligned}]+{x}_{2}[\\begin{aligned}-1 \\\\ 2 \\\\ 1\\end{aligned}]+{x}_{3}[\\begin{aligned}1 \\\\ 3 \\\\ 0\\end{aligned}] & =[\\begin{aligned}3 \\\\ 15 \\\\ 12\\end{aligned}].\\end{aligned}\n$$\n\nFrom this, we get the system with the augmented matrix $M$, which we reduce using Gaussian elimination: \n\n$$\n\\begin{aligned}M= & [\\begin{aligned}1 & -1 & 1 & 3 \\\\ 0 & 2 & 3 & 15 \\\\ 3 & 1 & 0 & 12\\end{aligned}] & {R}_{3} & :={R}_{3}+(-3){R}_{1} \\\\ ∼ & [\\begin{aligned}1 & -1 & 1 & 3 \\\\ 0 & 2 & 3 & 15 \\\\ 0 & 4 & -3 & 3\\end{aligned}] & {R}_{3} & :={R}_{3}+(-2){R}_{2} \\\\ ∼ & [\\begin{aligned}1 & -1 & 1 & 3 \\\\ 0 & 2 & 3 & 15 \\\\ 0 & 0 & -9 & -27\\end{aligned}]\\end{aligned}\n$$\n\n  \n\nThe system is now \n\n$$\n\\{\\begin{aligned}{x}_{1}-{x}_{2}+{x}_{3}=3 \\\\ 2{x}_{2}+3{x}_{3}=15 \\\\ -9{x}_{3}=-27.\\end{aligned}\n$$\n\nFrom the third equation, we get ${x}_{3}=3.$ Substituting this into the second   equation yields\n\n$$\n2{x}_{2}+3(3)=15\\,⟹\\,{x}_{2}=3.\n$$\n\n Finally,  by substituting ${x}_{2}=3$ and ${x}_{3}=3$ into the first equation we obtain\n\n$$\n{x}_{1}-3+3=3\\,⟹\\,{x}_{1}=3.\n$$\n\nTherefore, $[x]_{B}=[\\begin{aligned}3 \\\\ 3 \\\\ 3\\end{aligned}].$\n\nSo, we have \n\n$$\n{x}_{1}+{x}_{2}+{x}_{3}=3+3+3=9.\n$$"} :step/id #uuid "e175e73c-1506-54af-ab5d-d11256d84f83" :step/next {:db/id #edb/ref 17592186455527}}] :activity/title "Expressing the Coordinates of a Vector in a Given Basis" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186454902}]}
