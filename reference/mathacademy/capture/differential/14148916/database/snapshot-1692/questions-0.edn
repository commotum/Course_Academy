#{[{:db/id #edb/ref 17592186409819 :knowledge-point/_questions [{:db/id #edb/ref 17592186119859 :knowledge-point/id #uuid "a2926764-dfbc-5e4e-a6b0-db24a7298a64" :knowledge-point/title "Finding the Coordinates of a Vector Relative To a Given Basis by Inspection"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2115aac5-da66-5510-8b11-176ba754f81a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186409789} {:answer/id #uuid "45dbc0e6-16a9-5c62-a183-2dd30e767a3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186409790} {:answer/id #uuid "60013665-0a5a-5449-9017-6cb6ae7ed2ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186409792} {:answer/id #uuid "7ad6f309-f775-5604-ba46-fa9609a5688b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186409798} {:answer/id #uuid "ba977b58-8add-5c57-ae69-640a36ab4ef9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186409803}] :answer-field/correct {:answer/id #uuid "60013665-0a5a-5449-9017-6cb6ae7ed2ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186409792} :answer-field/id #uuid "fe323417-1cf2-5a08-b6a1-9d36f7d769a5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186409816}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d9b245f0-31aa-56fe-aa26-5663dd9e140f" :question/math-academy-id "q-112211" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B={{b}_{1},{b}_{2}},$ where\n\n$$\n{b}_{1}=[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}],\\,{b}_{2}=[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}],\\,x=[\\begin{aligned}-7 \\\\ -8 \\\\ 0\\end{aligned}].\n$$\n\nIf $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$ then what is the value of ${x}_{2}?$" :question/worked-solution "Remember, the order of the vectors in a basis is important.\n\nNotice that \n\n$$\n{{[\\begin{aligned}-7 \\\\ -8 \\\\ 0\\end{aligned}]}_{⏟}}_{x}={{(\\,-8\\,)}_{⏟}}_{{x}_{1}}\\cdot {{[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]}_{⏟}}_{{b}_{1}}+{{(\\,-7\\,)}_{⏟}}_{{x}_{2}}\\cdot {{[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}]}_{⏟}}_{{b}_{2}}\n$$\n\nwhich means that\n\n$$\nx=(-8)\\cdot {b}_{1}+(-7)\\cdot {b}_{2}\n$$\n\nand therefore\n\n$$\n[x]_{B}=[\\begin{aligned}-8 \\\\ -7\\end{aligned}].\n$$\n\nFinally, we have that ${x}_{2}=-7.$"}] [{:db/id #edb/ref 17592186120352 :knowledge-point/_questions [{:db/id #edb/ref 17592186119821 :knowledge-point/id #uuid "841f498b-f737-5086-8f79-44f1a143bebb" :knowledge-point/title "Finding the Coordinates of a Vector Relative To a Given Basis Containing Two Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "028867b0-8cf6-524a-93e6-8e63fa02e23d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186317580} {:answer/id #uuid "2f329de5-7c1a-5fad-b2d2-f7cc8384731d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186317709} {:answer/id #uuid "4664a61e-4f05-55cf-baad-caec080b86fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\notin \\text{Span}{{b}_{1},{b}_{2}}" :db/id #edb/ref 17592186317794} {:answer/id #uuid "5f5bbc70-a2a7-5d4f-9c69-50122cef639d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186317888} {:answer/id #uuid "844d0795-32e6-5eb9-9815-e5906f5fb3e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186318014}] :answer-field/correct {:answer/id #uuid "028867b0-8cf6-524a-93e6-8e63fa02e23d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186317580} :answer-field/id #uuid "add90972-43b4-50ff-b652-f7e992bc2ad7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186318801}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f17a8e42-194f-52ed-9136-123dd348b4bc" :question/math-academy-id "q-34617" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B={{b}_{1},{b}_{2}},$ where\n\n$$\n{b}_{1}=[\\begin{aligned}1 \\\\ -2\\end{aligned}],\\,{b}_{2}=[\\begin{aligned}2 \\\\ 1\\end{aligned}],\\,x=[\\begin{aligned}2 \\\\ 6\\end{aligned}].\n$$\n\nIf $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$ then what is the value of ${x}_{1}+{x}_{2}?$" :question/worked-solution "We need to find ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2} & =x \\\\ {x}_{1}[\\begin{aligned}1 \\\\ -2\\end{aligned}]+{x}_{2}[\\begin{aligned}2 \\\\ 1\\end{aligned}] & =[\\begin{aligned}2 \\\\ 6\\end{aligned}].\\end{aligned}\n$$\n\nThe equation above gives the system with the augmented matrix\n\n$$\nM=[\\begin{aligned}1 & 2 & 2 \\\\ -2 & 1 & 6\\end{aligned}].\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 2 & 2 \\\\ -2 & 1 & 6\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & 2 \\\\ 0 & 5 & 10\\end{aligned}]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n{\\begin{aligned}{x}_{1}+2{x}_{2}=2 \\\\ 5{x}_{2}=10.\\end{aligned}\n$$\n\nFrom the second equation, we get ${x}_{2}=2.$ Substituting this into the first equation, we obtain\n\n$$\n{x}_{1}+2(2)=2\\,⟹\\,{x}_{1}=-2.\n$$\n\nTherefore, $[x]_{B}=[\\begin{aligned}-2 \\\\ 2\\end{aligned}].$\n\nFinally, ${x}_{1}+{x}_{2}=(-2)+2=0.$"}] [{:db/id #edb/ref 17592186319175 :knowledge-point/_questions [{:db/id #edb/ref 17592186119821 :knowledge-point/id #uuid "841f498b-f737-5086-8f79-44f1a143bebb" :knowledge-point/title "Finding the Coordinates of a Vector Relative To a Given Basis Containing Two Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28f401e4-eb59-5198-abf4-1458830b331c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186317692} {:answer/id #uuid "55e9e214-e0b3-5771-95e7-5cb487ad7118" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186317852} {:answer/id #uuid "7bb620c1-7d01-5714-8491-57cdf858e33c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\notin \\text{span}{{b}_{1},{b}_{2}}" :db/id #edb/ref 17592186317980} {:answer/id #uuid "914f6ffc-e4c9-5161-9fde-b475bcf8fceb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186318060} {:answer/id #uuid "e0273188-6c7e-5354-921c-cdc4386a3d9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186318313}] :answer-field/correct {:answer/id #uuid "55e9e214-e0b3-5771-95e7-5cb487ad7118" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186317852} :answer-field/id #uuid "e0750bff-0d7b-54f9-bc9f-9e5f7a657747" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186318894}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "706ae806-e20f-56d6-9072-359885047529" :question/math-academy-id "q-34738" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B={{b}_{1},{b}_{2}},$ where\n\n$$\n{b}_{1}=[\\begin{aligned}-1 \\\\ 5 \\\\ 0\\end{aligned}],\\,{b}_{2}=[\\begin{aligned}4 \\\\ 2 \\\\ -3\\end{aligned}],\\,x=[\\begin{aligned}6 \\\\ -8 \\\\ -3\\end{aligned}].\n$$\n\nIf $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$ then what is the value of ${x}_{1}+{x}_{2}?$" :question/worked-solution "We need to find ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2} & =x \\\\ {x}_{1}[\\begin{aligned}-1 \\\\ 5 \\\\ 0\\end{aligned}]+{x}_{2}[\\begin{aligned}4 \\\\ 2 \\\\ -3\\end{aligned}] & =[\\begin{aligned}6 \\\\ -8 \\\\ -3\\end{aligned}].\\end{aligned}\n$$\n\nThe equation above gives the system with the augmented matrix \n\n$$\nM=[\\begin{aligned}-1 & 4 & 6 \\\\ 5 & 2 & -8 \\\\ 0 & -3 & -3\\end{aligned}].\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following: \n\n$$\n\\begin{aligned}M= & [\\begin{aligned}-1 & 4 & 6 \\\\ 5 & 2 & -8 \\\\ 0 & -3 & -3\\end{aligned}] & {R}_{2}:={R}_{2}+5{R}_{1} \\\\ ∼ & [\\begin{aligned}-1 & 4 & 6 \\\\ 0 & 22 & 22 \\\\ 0 & -3 & -3\\end{aligned}] & {R}_{3}:={R}_{3}+\\frac{3}{22}{R}_{2} \\\\ ∼ & [\\begin{aligned}-1 & 4 & 6 \\\\ 0 & 22 & 22 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n{\\begin{aligned}-{x}_{1}+4{x}_{2}=6 \\\\ 22{x}_{2}=22.\\end{aligned}\n$$\n\nFrom the second equation, we get ${x}_{2}=1.$ Substituting this into the first equation, we obtain\n\n$$\n-{x}_{1}+4(1)=6\\,⟹\\,{x}_{1}=-2.\n$$\n\nTherefore, $[x]_{B}=[\\begin{aligned}-2 \\\\ 1\\end{aligned}].$ \n\nFinally, ${x}_{1}+{x}_{2}=-2+1=-1.$"}]}
