m Y]=\\text{Var}[X]+\\text{Var}[Y].\n$$\n\nSubstituting the given data into the formula above, we obtain \n\n$$\n\\text{Var}[X+Y]=2+\\frac{1}{3}=\\frac{7}{3}.\n$$"}] [{:db/id #edb/ref 17592186427838 :knowledge-point/_questions [{:db/id #edb/ref 17592186162068 :knowledge-point/id #uuid "0e3dad37-612c-56f1-a571-360fafe336b4" :knowledge-point/title "Calculating the Variance of a Sum or Difference of Independent Random Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31d074d1-d02d-5121-ba5c-23c0d4e5c250" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{10}" :db/id #edb/ref 17592186427766} {:answer/id #uuid "384396c7-1eb8-5e98-8e27-5b5eb18a8c12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186427771} {:answer/id #uuid "7d75ed4e-50bc-568a-8f29-75582b7204a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186427789} {:answer/id #uuid "88bc0c35-f9a0-58e2-94f9-bdb1d3d3f0dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186427792} {:answer/id #uuid "f42b0837-6e67-588e-9952-d7d42dcd3cca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186427821}] :answer-field/correct {:answer/id #uuid "88bc0c35-f9a0-58e2-94f9-bdb1d3d3f0dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186427792} :answer-field/id #uuid "d062190f-09ff-55d5-a93a-d6e0bc027f6f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186427832}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "18397524-502d-5cf6-a760-495d427a894e" :question/math-academy-id "q-129520" :question/problem "For two independent random variables $X$ and $Y,$ we have $\\text{Var}[X]=0.4$ and $\\text{Var}[Y]=\\frac{3}{5}.$ Find $\\text{Var}[X+Y].$" :question/worked-solution "Recall that if $X$ and $Y$ are independent random variables, then \n\n$$\n\\text{Var}[X\\pm Y]=\\text{Var}[X]+\\text{Var}[Y].\n$$\n\nSubstituting the given data into the formula above, we obtain \n\n$$\n\\text{Var}[X+Y]=0.4+\\frac{3}{5}=\\frac{2}{5}+\\frac{3}{5}=1.\n$$"}] [{:db/id #edb/ref 17592186427841 :knowledge-point/_questions [{:db/id #edb/ref 17592186162068 :knowledge-point/id #uuid "0e3dad37-612c-56f1-a571-360fafe336b4" :knowledge-point/title "Calculating the Variance of a Sum or Difference of Independent Random Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03e0da66-1167-5ea9-876f-bd4cdb5eb51d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{6}" :db/id #edb/ref 17592186427753} {:answer/id #uuid "283b6336-d914-5883-83ba-71fdaa2cf83e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{6}" :db/id #edb/ref 17592186427760} {:answer/id #uuid "59ccb143-3906-5fe2-bb4e-17d74c47ee81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{6}" :db/id #edb/ref 17592186427781} {:answer/id #uuid "743a4e29-4d5e-564c-a51d-e89e8cc24815" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17}{6}" :db/id #edb/ref 17592186427785} {:answer/id #uuid "eb2c8531-ba75-5279-94d4-0ff8f9365e5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17}{3}" :db/id #edb/ref 17592186427818}] :answer-field/correct {:answer/id #uuid "743a4e29-4d5e-564c-a51d-e89e8cc24815" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17}{6}" :db/id #edb/ref 17592186427785} :answer-field/id #uuid "78fc4627-41df-5c0d-a105-9c75ea035401" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186427827}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "285af308-fbc2-5a84-995f-02e44cf826b2" :question/math-academy-id "q-129523" :question/problem "For two independent random variables $X$ and $Y,$ we have $\\text{Var}[X]=\\frac{5}{2}$ and $\\text{Var}[Y]=\\frac{1}{3}.$ Find $\\text{Var}[X-Y].$" :question/worked-solution "Recall that if $X$ and $Y$ are independent random variables, then \n\n$$\n\\text{Var}[X\\pm Y]=\\text{Var}[X]+\\text{Var}[Y].\n$$\n\nSubstituting the given data into the formula above, we obtain \n\n$$\n\\text{Var}[X-Y]=\\frac{5}{2}+\\frac{1}{3}=\\frac{17}{6}.\n$$"}] [{:db/id #edb/ref 17592186427845 :knowledge-point/_questions [{:db/id #edb/ref 17592186162062 :knowledge-point/id #uuid "52596d3a-a7af-55a0-97a8-8a6158b65638" :knowledge-point/title "Calculating the Variance of a Sum of Scaled Random Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c235c8d-eec8-5a1e-b28c-2279e07e7b65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186427763} {:answer/id #uuid "80fe8e0b-a5f2-565c-bb30-f432c1c49c20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186427791} {:answer/id #uuid "96972468-8dab-508e-a200-b2fec236f343" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186427796} {:answer/id #uuid "a646fc0a-e54a-5201-ab39-5e71b30d3697" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186427799} {:answer/id #uuid "e80d0b60-3eba-598b-b3c2-e807987d94fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186427817}] :answer-field/correct {:answer/id #uuid "2c235c8d-eec8-5a1e-b28c-2279e07e7b65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186427763} :answer-field/id #uuid "1f91a37d-713d-5888-8675-68be6e722d60" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186427824}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9eea5393-4f7a-57aa-9f10-8b65e7ac0b0c" :question/math-academy-id "q-129527" :question/problem "For two independent random variables $X$ and $Y,$ we have $\\text{Var}[X]=36$ and $\\text{Var}[Y]=4.$ Find $\\text{Var}[\\frac{1}{3}X-\\frac{1}{2}Y].$" :question/worked-solution "Recall that if $X$ and $Y$ are independent variables, and $a$ and $b$ are constants, then \n\n$$\n\\text{Var}[aX+bY]={a}^{2}\\text{Var}[X]+{b}^{2}\\text{Var}[Y].\n$$\n\nSubstituting the given data into the formula above, we obtain \n\n$$\n\\text{Var}[\\frac{1}{3}X-\\frac{1}{2}Y]={(\\frac{1}{3})}^{2}\\cdot 36+{(-\\frac{1}{2})}^{2}\\cdot 4=5.\n$$"}] [{:db/id #edb/ref 17592186427848 :knowledge-point/_questions [{:db/id #edb/ref 17592186162067 :knowledge-point/id #uuid "0df88138-7309-5a09-9a96-5e26029f0186" :knowledge-point/title "Calculating a Combined Variance Given Some Raw Moments"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ab5abf2-b9aa-5a69-bc33-44e194b4ff31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{3}}{3}-\\frac{4\\sqrt{5}}{25}" :db/id #edb/ref 17592186427762} {:answer/id #uuid "3682530b-b436-568f-b307-329e0510aa8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{14}{5}" :db/id #edb/ref 17592186427769} {:answer/id #uuid "4ee04c81-c182-5581-8df9-84e4bb8ad05f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{12}{5}" :db/id #edb/ref 17592186427777} {:answer/id #uuid "b3ebd8ac-1efb-5b05-b554-562c48b9997c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{5}" :db/id #edb/ref 17592186427802} {:answer/id #uuid "e1e82dcc-220d-59c4-b9f8-50ada26dffbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{3}}{3}+\\frac{4\\sqrt{5}}{25}" :db/id #edb/ref 17592186427816}] :answer-field/correct {:answer/id #uuid "3682530b-b436-568f-b307-329e0510aa8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{14}{5}" :db/id #edb/ref 17592186427769} :answer-field/id #uuid "a27231db-da07-5cba-9ad0-fd18268f97e9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186427828}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c320b889-ae71-5240-8135-8f57da9dfd21" :question/math-academy-id "q-129545" :question/problem "The probability mass function of the independent random variables $X$ and $Y$ are given below.\n\n<table align=\"center\">\n<tbody><tr>\n<th>\n<table align=\"center\" cellpadding=\"10\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"30\">$x$</td>\n<td align=\"center\">$-1$</td>\n<td align=\"center\">$0$</td>\n<td align=\"center\">$1$</td>\n</tr>\n<tr>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"30\">$f(x)$</td>\n<td align=\"center\">$\\frac{1}{3}$</td>\n<td align=\"center\">$\\frac{1}{3}$</td>\n<td align=\"center\">$\\frac{1}{3}$</td>\n</tr>\n</tbody></table>\n<p></p></th>\n<th width=\"5%\"></th>\n<th>\n<table align=\"center\" cellpadding=\"10\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"30\">$y$</td>\n<td align=\"center\">$1$</td>\n<td align=\"center\">$2$</td>\n</tr>\n<tr>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"30\">$f(y)$</td>\n<td align=\"center\">$\\frac{1}{5}$</td>\n<td align=\"center\">$\\frac{4}{5}$</td>\n</tr>\n</tbody></table>\n<p></p></th>\n</tr>\n</tbody></table>\n\n Find $\\text{Var}[\\sqrt{3}X-\\sqrt{5}Y].$" :question/worked-solution "Recall that if $X$ and $Y$ are independent random variables and $a$ and $b$ are constants, then\n\n$$\n\\text{Var}[aX+bY]={a}^{2}\\text{Var}[X]+{b}^{2}\\text{Var}[Y].\n$$\n\nAlso, the variance of $X$ is determined by the formula \n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}.\n$$\n\nFirst, let's find $\\text{Var}[X].$ If $X$ is defined on a sample space ${S}_{X}$, then\n\n$$\n\\begin{aligned}\\text{E}[X] & ={\\sum }_{x\\in {S}_{X}}x\\cdot f(x) \\\\  & =(-1)(\\frac{1}{3})+0(\\frac{1}{3})+1(\\frac{1}{3}) \\\\  & =0\\end{aligned}\n$$\n\nand \n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\sum }_{x\\in {S}_{X}}{x}^{2}\\cdot f(x) \\\\  & =(-1)^{2}\\cdot (\\frac{1}{3})+{0}^{2}\\cdot (\\frac{1}{3})+{1}^{2}\\cdot (\\frac{1}{3}) \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{2}{3}-{0}^{2} \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$\n\nSimilarly, if $Y$ is defined on a sample space ${S}_{Y}$, then\n\n$$\n\\begin{aligned}\\text{E}[Y] & ={\\sum }_{y\\in {S}_{Y}}y\\cdot f(y) \\\\  & =1(\\frac{1}{5})+2(\\frac{4}{5}) \\\\  & =\\frac{9}{5}\\end{aligned}\n$$\n\nand \n\n$$\n\\begin{aligned}\\text{E}[{Y}^{2}] & ={\\sum }_{y\\in {S}_{Y}}{y}^{2}\\cdot f(y) \\\\  & ={1}^{2}\\cdot (\\frac{1}{5})+{2}^{2}\\cdot (\\frac{4}{5}) \\\\  & =\\frac{17}{5}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[Y] & =\\text{E}[{Y}^{2}]-\\text{E}[Y]^{2} \\\\  & =\\frac{17}{5}-{(\\frac{9}{5})}^{2} \\\\  & =\\frac{4}{25}.\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}\\text{Var}[\\sqrt{3}X-\\sqrt{5}Y] & =(\\sqrt{3})^{2}\\text{Var}[X]+(-\\sqrt{5})^{2}\\text{Var}[Y] \\\\  & =3\\cdot \\frac{2}{3}+5\\cdot \\frac{4}{25} \\\\  & =\\frac{14}{5}.\\end{aligned}\n$$"}]}
