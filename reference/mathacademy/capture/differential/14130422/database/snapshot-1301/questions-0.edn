#{[{:db/id #edb/ref 17592186161862 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186162062 :knowledge-point/id #uuid "52596d3a-a7af-55a0-97a8-8a6158b65638" :knowledge-point/title "Calculating the Variance of a Sum of Scaled Random Variables"}] :question/id #uuid "1df04c71-caae-5a7e-83ac-4dd578b7f766" :question/math-academy-id "e-9122" :question/problem "For two independent random variables $X$ and $Y$, we have $\\textrm{Var}[X]=10$ and $\\textrm{Var}[Y]=12$. Find $\\textrm{Var}\\left[X-2Y\\right]$." :question/worked-solution "Recall that if $X$ and $Y$ are independent variables, and $a$ and $b$ are constants, then\n\n$$\n\\textrm{Var}[aX+bY]=a^2\\textrm{Var}[X]+b^2\\textrm{Var}[Y]\n$$\n\nSubstituting the given data into the formula above, we obtain\n\n$$\n\\textrm{Var}\\left[X-2Y\\right]=\\left(1\\right)^2\\cdot 10+\\left(-2\\right)^2\\cdot 12 =58\n$$"}] [{:db/id #edb/ref 17592186161867 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186162067 :knowledge-point/id #uuid "0df88138-7309-5a09-9a96-5e26029f0186" :knowledge-point/title "Calculating a Combined Variance Given Some Raw Moments"}] :question/id #uuid "0c3690cd-f90e-5d82-ba7b-09d52de47b80" :question/math-academy-id "e-9143" :question/problem "Consider two independent random variables $X$ and $Y$ with expectations $\\textrm E[X]=5$, $\\textrm E[Y]=4$\nand second raw moments $\\textrm E[X^2]=30$ and $\\textrm E[Y^2]=18$. Find the variance of $12X-11Y$." :question/worked-solution "Recall that if $X$ and $Y$ are independent random variables and $a$ and $b$ are constants, then\n\n$$\n\\textrm{Var}[aX+bY]=a^2\\textrm{Var}[X]+b^2\\textrm{Var}[Y]\n$$\n\nAlso, the variance of a random variable $X$ is determined by the formula\n\n$$\n\\textrm {Var}[X]=\\textrm E[X^2]-\\textrm E[X]^2\n$$\n\nFirst, let's find $\\textrm{Var}[X]$:\n\n$$\n\\begin{aligned}\nVar[X] &= E[X^{2}] - E[X]^{2} \\\\\n&= 30 - 5^{2} \\\\\n&= 5\n\\end{aligned}\n$$\n\nSimilarly,\n\n$$\n\\begin{aligned}\nVar[Y] &= E[Y^{2}] - E[Y]^{2} \\\\\n&= 18 - 4^{2} \\\\\n&= 2\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\nVar[12X - 11Y] &= 12^{2}Var[X] + (-11)^{2}Var[Y] \\\\\n&= 144(5) + 121(2) \\\\\n&= 962\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186161868 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186162068 :knowledge-point/id #uuid "0e3dad37-612c-56f1-a571-360fafe336b4" :knowledge-point/title "Calculating the Variance of a Sum or Difference of Independent Random Variables"}] :question/id #uuid "70881840-32f1-5bab-947d-00d77f0ff71e" :question/math-academy-id "e-9181" :question/problem "For two independent random variables $X$ and $Y$, we have $\\textrm{Var}[X]=3$ and $\\textrm{Var}[Y]=7$. Find $\\textrm{Var}[X-Y]$." :question/worked-solution "Recall that if $X$ and $Y$ are independent random variables, then\n\n$$\n\\textrm{Var}[X\\pm Y]=\\textrm{Var}[X]+\\textrm{Var}[Y]\n$$\n\nSubstituting the given data into the formula above, we obtain\n\n$$\n\\textrm{Var}[X-Y]= 3 + 7 = 10\n$$"}] [{:db/id #edb/ref 17592186162296 :knowledge-point/_questions [{:db/id #edb/ref 17592186162068 :knowledge-point/id #uuid "0e3dad37-612c-56f1-a571-360fafe336b4" :knowledge-point/title "Calculating the Variance of a Sum or Difference of Independent Random Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9c71cac7-4ef8-5b19-9e0f-fed180f37fb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{12}{5}" :db/id #edb/ref 17592186158979} {:answer/id #uuid "9ddf2406-24aa-5003-b8c5-ac0d53e393d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186158980} {:answer/id #uuid "f9d6cb77-b27a-5466-be85-9bc079c937eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186158981} {:answer/id #uuid "623b1efd-dab2-5ba3-a00f-5b098f3374d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186158982} {:answer/id #uuid "6f79337f-a780-5243-a7f0-865644baf9b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "119" :db/id #edb/ref 17592186158983}] :answer-field/id #uuid "8eab60f4-a494-5f8c-b6a2-4a63c1dcd621" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186158978}] :question/id #uuid "edd072fa-10ff-587e-aaed-cfed735f9f65" :question/math-academy-id "q-110249" :question/problem "For two independent random variables $X$ and $Y$, we have $Var[X] = 12$ and $Var[Y] = 5$. Find $Var[X - Y]$."}]}
