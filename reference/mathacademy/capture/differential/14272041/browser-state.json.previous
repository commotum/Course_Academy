inethickness=\"0\"><mn>5</mn><mn>0</mn></mfrac><mrow data-mjx-texclass=\"CLOSE\"><mo minsize=\"2.047em\" maxsize=\"2.047em\">)</mo></mrow></mrow><mo stretchy=\"false\">(</mo><mn>0.7</mn><msup><mo stretchy=\"false\">)</mo><mn>0</mn></msup><mo stretchy=\"false\">(</mo><mn>0.3</mn><msup><mo stretchy=\"false\">)</mo><mn>5</mn></msup><mo>+</mo><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"OPEN\"><mo minsize=\"2.047em\" maxsize=\"2.047em\">(</mo></mrow><mfrac linethickness=\"0\"><mn>5</mn><mn>1</mn></mfrac><mrow data-mjx-texclass=\"CLOSE\"><mo minsize=\"2.047em\" maxsize=\"2.047em\">)</mo></mrow></mrow><mo stretchy=\"false\">(</mo><mn>0.7</mn><msup><mo stretchy=\"false\">)</mo><mn>1</mn></msup><mo stretchy=\"false\">(</mo><mn>0.3</mn><msup><mo stretchy=\"false\">)</mo><mn>4</mn></msup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>1</mn><mo stretchy=\"false\">(</mo><mn>0.3</mn><msup><mo stretchy=\"false\">)</mo><mn>5</mn></msup><mo>+</mo><mn>5</mn><mo stretchy=\"false\">(</mo><mn>0.7</mn><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><mn>0.3</mn><msup><mo stretchy=\"false\">)</mo><mn>4</mn></msup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>≈</mo><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mn>0.031</mn></mpadded></mstyle><mo>,</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container>\nrounded to <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"85\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c33\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn></math></mjx-assistive-mml></mjx-container> decimal places.</p>\n</div></div>",
