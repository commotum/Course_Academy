      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14147181/observations/step-q161652-237d372920733ffddfb0.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14147181/observations/step-q161652-237d372920733ffddfb0.png",
