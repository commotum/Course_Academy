664 #edb/ref 17592186045417] [17592186192917 #edb/ref 1043 #edb/ref 17592186193696 #edb/ref 17592186045417] [17592186192917 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186192917 #edb/ref 1045 "Interiors and Boundaries of Sets" #edb/ref 17592186045417] [17592186192917 #edb/ref 1046 #edb/ref 17592186193663 #edb/ref 17592186045417] [17592186192917 #edb/ref 1049 #edb/ref 17592186048621 #edb/ref 17592186045417] [17592186192917 #edb/ref 1050 420.0 #edb/ref 17592186045417] [17592186192917 #edb/ref 1053 #uuid "d93075cf-1282-5b7f-b71d-4c5f5fd85e47" #edb/ref 17592186045417] [17592186193324 #edb/ref 1068 #edb/ref 17592186191871 #edb/ref 17592186045417] [17592186193324 #edb/ref 1068 #edb/ref 17592186379785 #edb/ref 17592186045417] [17592186193324 #edb/ref 1069 "q-35879" #edb/ref 17592186045417] [17592186193324 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186193324 #edb/ref 1071 "Consider the set $A,$ defined by \n\n$$\nA={(x,y)\\in {R}^{2}\\,:\\,0\\le x\\le 2,\\,-1\\le y<0}.\n$$\n\nThe interior of $A$ is given by\n\n$$\n\\text{int}\\,A={(x,y)\\in {R}^{2}\\,:\\,0<x<2,\\,\\,}.\n$$\n\nWhat is the missing expression?" #edb/ref 17592186045417] [17592186193324 #edb/ref 1072 #uuid "13c6da4f-5008-5951-9c9e-dc34e9db3f48" #edb/ref 17592186045417] [17592186193324 #edb/ref 1074 "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nThe set $A$ and its boundary $∂A$ are shown below.\n\n![](images/fc/fc71859cb4d1e58ea3d15c2da66bce014898281fe237f2e0c2396f96c84c9e79.png)\n\nThe interior of a set $A,$ denoted $\\text{int}\\,A,$ is the set containing all the interior points of $A.$ It contains every point in $A$ except the boundary points: \n\n$$\n\\text{int}\\,A=A-∂A\n$$\n\nThe interior of $A$ is shown below.\n\n![](images/ef/eff037b96b6a42120fdfa112a98d1e0749cdd56bd89acd647db448b08d7323ad.png)\n\nSo, in this case, the interior of $A$ is given by\n\n$$\n\\text{int}\\,A={(x,y)\\in {R}^{2}\\,:\\,0<x<2,\\,-1<y<0\\,}.\n$$" #edb/ref 17592186045417] [17592186193662 #edb/ref 1061 41922 #edb/ref 17592186045417] [17592186193662 #edb/ref 1062 #uuid "a9a56a41-bd42-55bc-97e0-3044e441a107" #edb/ref 17592186045417] [17592186193662 #edb/ref 1063 #edb/ref 17592186192786 #edb/ref 17592186045417] [17592186193663 #edb/ref 1058 #edb/ref 17592186193696 #edb/ref 17592186045417] [17592186193663 #edb/ref 1061 41923 #edb/ref 17592186045417] [17592186193663 #edb/ref 1062 #uuid "a6d2c5fc-ab0d-5230-b12f-968073fd01a2" #edb/ref 17592186045417] [17592186193663 #edb/ref 1063 #edb/ref 17592186193885 #edb/ref 17592186045417] [17592186193664 #edb/ref 1058 #edb/ref 17592186193662 #edb/ref 17592186045417] [17592186193664 #edb/ref 1061 41924 #edb/ref 17592186045417] [17592186193664 #edb/ref 1062 #uuid "9d5d8127-b825-594a-81df-e04296e04e38" #edb/ref 17592186045417] [17592186193664 #edb/ref 1063 #edb/ref 17592186192787 #edb/ref 17592186045417] [17592186193696 #edb/ref 1058 #edb/ref 17592186193664 #edb/ref 17592186045417] [17592186193696 #edb/ref 1061 44507 #edb/ref 17592186045417] [17592186193696 #edb/ref 1062 #uuid "96d5ce65-6ad2-5f74-bcdb-8d90d0ff8464" #edb/ref 17592186045417] [17592186193696 #edb/ref 1063 #edb/ref 17592186192802 #edb/ref 17592186045417] [17592186193885 #edb/ref 1064 "The **boundary** of a set $S,$ denoted $\\partial S,$ is the set that contains all the boundary points of $S.$\n\nFor example, consider the set $A,$ given by \n\n$$\nA = \\big\\{ (x,y)\\in\\mathbb R^2 \\,:\\, -1 \\lt x \\leq 1, \\, 0 \\lt y \\leq 2 \\big\\}.\n$$\n\nWe can represent this set as the following shaded region.\n\n![](images/50/5033928a09f9c320973a223bfd49b4b67924b433c7ba53e58bc07a95905f4231.png)\n\nThen, the set $\\partial A,$ the boundary of $A,$ has the following representation in the plane.\n\n![](images/e2/e2034b17b6a6834c1d747e2eba4a2522c43e9ff888d5f7feb7bf716b3e2cec00.png)\n\nThe **interior** of a set $S,$ denoted $\\textrm{int}\\, S,$ is the set containing all the interior points of $S.$ It contains every point in $S$ except the boundary points: \n\n$$\n\\textrm{int}\\,S = S - \\partial S\n$$\n\nFor our set $A$ defined above, the interior looks as follows:\n\n![](images/57/57ab8735d761926a36aa0e469b4637482c31880cc446d913f93755a12ec65a8f.png)\n\nMore formally, the interior of $A$ is given by\n\n$$\n\\textrm{int}\\,A = \\big\\{ (x,y)\\in\\mathbb R^2 \\,:\\, -1 \\lt x \\lt 1, \\, 0 \\lt y \\lt 2 \\big\\}.\n$$" #edb/ref 17592186045417] [17592186193885 #edb/ref 1065 6925 #edb/ref 17592186045417] [17592186193885 #edb/ref 1066 #uuid "0e637424-4284-59d5-be69-a86587836ad8" #edb/ref 17592186045417] [17592186193885 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186238491 #edb/ref 1080 "-2<x<2" #edb/ref 17592186045417] [17592186238491 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186238491 #edb/ref 1083 #uuid "3243b0c1-092b-5601-b0a7-3f3c3e1a11a3" #edb/ref 17592186045417] [17592186238495 #edb/ref 1080 "-2<x<0" #edb/ref 17592186045417] [17592186238495 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186238495 #edb/ref 1083 #uuid "3292f4f8-3340-5dcc-8508-318774f90133" #edb/ref 17592186045417] [17592186239391 #edb/ref 1080 "-2\\le x<0" #edb/ref 17592186045417] [17592186239391 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186239391 #edb/ref 1083 #uuid "99e00a77-24b1-59aa-8b87-eeed024a6ac6" #edb/ref 17592186045417] [17592186239697 #edb/ref 1080 "0<x\\le 2" #edb/ref 17592186045417] [17592186239697 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186239697 #edb/ref 1083 #uuid "bc38a932-011d-51ce-8574-ad8d957e354d" #edb/ref 17592186045417] [17592186240146 #edb/ref 1080 "0<x<2" #edb/ref 17592186045417] [17592186240146 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186240146 #edb/ref 1083 #uuid "ed989251-9ebe-5e5b-b96b-de3e3996d705" #edb/ref 17592186045417] [17592186240708 #edb/ref 1075 #edb/ref 17592186238491 #edb/ref 17592186045417] [17592186240708 #edb/ref 107