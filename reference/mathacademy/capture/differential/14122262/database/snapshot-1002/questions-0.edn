#{[{:db/id #edb/ref 17592186083573 :knowledge-point/_questions [{:db/id #edb/ref 17592186083221 :knowledge-point/id #uuid "060e80f0-44bd-5378-9253-999548115dd9" :knowledge-point/title "Calculating the Number of Permutations of Objects Chosen From a Group Fewer Than Ten"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83a899a2-01e7-51e1-97a0-7fb5af02afe7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186080334} {:answer/id #uuid "8528a6a0-4362-5bbb-ae9b-35bf75859f2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "210" :db/id #edb/ref 17592186080335} {:answer/id #uuid "a666991e-236d-5425-b8b6-617ba978b1d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "720" :db/id #edb/ref 17592186080336} {:answer/id #uuid "abdb717b-c681-53a2-99b2-ee2ee784d6c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186080337} {:answer/id #uuid "b3677559-31a9-5adb-8a4c-96bb86c3ad1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "70" :db/id #edb/ref 17592186080338}] :answer-field/correct {:answer/id #uuid "8528a6a0-4362-5bbb-ae9b-35bf75859f2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "210" :db/id #edb/ref 17592186080335} :answer-field/id #uuid "5c35d8bc-e437-5909-9318-fd54b2619f04" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186080333}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a164e34b-9201-592b-aca6-126a5f507b56" :question/math-academy-id "q-1788" :question/problem "Suppose there are $7$ people who enter a race. Assuming there are no ties, in how many ways can the gold, silver, and bronze medals be awarded?" :question/requires-calculator true :question/worked-solution "The number of permutations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{P}_{r}=\\frac{n!}{(n-r)!}.\n$$\n\nThere are $7$ people, so $n=7.$ We want to select $3$ of those people for gold, silver and bronze, so we have $r=3.$ \n\nTherefore, the number of different ways to award the medals is \n\n$$\n\\begin{aligned}{}_{7}{P}_{3} & =\\frac{7!}{(7-3)!} \\\\  & =\\frac{7!}{4!} \\\\  & =\\frac{7\\cdot 6\\cdot 5\\cdot \\cancel{4!}}{\\cancel{4!}} \\\\  & =7\\cdot 6\\cdot 5 \\\\  & =210.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186394620 :knowledge-point/_questions [{:db/id #edb/ref 17592186083221 :knowledge-point/id #uuid "060e80f0-44bd-5378-9253-999548115dd9" :knowledge-point/title "Calculating the Number of Permutations of Objects Chosen From a Group Fewer Than Ten"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aaed84db-333e-5211-84c5-2d24c1d90316" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,016" :db/id #edb/ref 17592186394622} {:answer/id #uuid "e1c1b16c-2ec4-5950-92f8-59f867978e1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,024" :db/id #edb/ref 17592186394623} {:answer/id #uuid "542940cc-ac17-5702-9c22-d185b7bb47c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "120" :db/id #edb/ref 17592186394624} {:answer/id #uuid "2e70f827-6004-57e0-825e-f0e45fc164d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,344" :db/id #edb/ref 17592186394625} {:answer/id #uuid "3d0a0e84-7492-5601-b7a4-02b8e70ea90d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15\\,120" :db/id #edb/ref 17592186394626}] :answer-field/correct {:answer/id #uuid "e1c1b16c-2ec4-5950-92f8-59f867978e1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,024" :db/id #edb/ref 17592186394623} :answer-field/id #uuid "72d9fa78-c6ea-5ff0-a6cb-0b7ec2cbcfc0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394621}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4ef67e9d-56e9-502f-9f38-dd41f4d01e7c" :question/math-academy-id "q-84983" :question/problem "A bag contains $9$ different colored marbles. Jamie takes $4$ marbles from the bag, one at a time, and puts them in the order they were taken from the bag to create a sequence of colors. How many different sequences of colors are possible?" :question/worked-solution "The number of permutations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{P}_{r}=\\frac{n!}{(n-r)!}.\n$$\n\nThere are $9$ colored marbles, so $n=9.$ We want to select $4$ of those marbles to make a sequence of colors, so we have $r=4.$ \n\nTherefore, the number of different ways to choose the marbles is \n\n$$\n\\begin{aligned}{}_{9}{P}_{4} & =\\frac{9!}{(9-4)!} \\\\  & =\\frac{9!}{5!} \\\\  & =\\frac{9\\cdot 8\\cdot 7\\cdot 6\\cdot \\cancel{5!}}{\\cancel{5!}} \\\\  & =9\\cdot 8\\cdot 7\\cdot 6 \\\\  & =3\\,024.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186418414 :knowledge-point/_questions [{:db/id #edb/ref 17592186083222 :knowledge-point/id #uuid "256d3a08-0ade-51e9-887b-67250d5fae21" :knowledge-point/title "Calculating the Number of Permutations of Objects Chosen From a Group of at Least Ten"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4519364a-a039-5b52-8828-103d442a03a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "990" :db/id #edb/ref 17592186418408} {:answer/id #uuid "5456ddc8-8ae6-57cd-97e3-f1eaa26ffc00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,400" :db/id #edb/ref 17592186418409} {:answer/id #uuid "862c4b09-9172-545f-97c9-7f21e79cd3de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,980" :db/id #edb/ref 17592186418410} {:answer/id #uuid "e7a2ab60-18b2-5943-9f8e-856a28f1c403" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "55\\,440" :db/id #edb/ref 17592186418411} {:answer/id #uuid "ea315232-2913-5a30-877a-c82272b5ac01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\,920" :db/id #edb/ref 17592186418412}] :answer-field/correct {:answer/id #uuid "ea315232-2913-5a30-877a-c82272b5ac01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\,920" :db/id #edb/ref 17592186418412} :answer-field/id #uuid "69ac052e-a374-5b6c-af86-f7bda6ec7c19" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186418413}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9a0bfa46-736f-571e-9fd1-af2e7c4186b1" :question/math-academy-id "q-84984" :question/problem "A soccer coach must choose a defensive lineup for each of the $4$ defensive positions from a roster of $11$ defenders. How many potential starting defensive lineups are there?" :question/worked-solution "The number of permutations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{P}_{r}=\\frac{n!}{(n-r)!}.\n$$\n\nThere are $11$ defenders, so $n=11.$ We want to select $4$ of those defenders to play in each of the $4$ positions, so we have $r=4.$\n\nTherefore, the number of different starting defensive lineups is\n\n$$\n\\begin{aligned}{}_{11}{P}_{4} & =\\frac{11!}{(11-4)!} \\\\  & =\\frac{11!}{7!} \\\\  & =\\frac{11\\cdot 10\\cdot 9\\cdot 8\\cdot \\cancel{7!}}{\\cancel{7!}} \\\\  & =11\\cdot 10\\cdot 9\\cdot 8 \\\\  & =7\\,920.\\end{aligned}\n$$"}]}
