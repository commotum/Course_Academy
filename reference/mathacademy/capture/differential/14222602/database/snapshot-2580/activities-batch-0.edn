matrix}1 & 2 \\\\ 3 & \\,\\,-2 \\\\ -1 & 1\\end{bmatrix}\\cdot {\\begin{bmatrix}11 & -5 \\\\ -5 & 9\\end{bmatrix}}^{-1}\\cdot \\begin{bmatrix}6 \\\\ 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 2 \\\\ 3 & \\,\\,-2 \\\\ -1 & 1\\end{bmatrix}\\cdot \\frac{1}{74}\\begin{bmatrix}9 & 5 \\\\ 5 & 11\\end{bmatrix}\\cdot \\begin{bmatrix}6 \\\\ 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 2 \\\\ 3 & \\,\\,-2 \\\\ -1 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 \\\\ 1 \\\\ 0\\end{bmatrix}\\end{aligned}\n$$"} :step/id #uuid "eff9b1cb-cb04-5ebf-80e3-b9dafaf06cbe" :step/next {:db/id #edb/ref 17592186489337}}] :activity/title "Projecting Vectors Onto Subspaces in Euclidean Spaces (Arbitrary Bases)" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186488461}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186504732} :activity/id #uuid "9cda4bd3-cc2b-5f27-8d56-0e6664a2b2ad" :activity/scope {:db/id #edb/ref 17592186049970 :topic/id #uuid "22979210-8cd9-5db4-861d-faf167d0a850" :topic/math-academy-id 2124} :activity/steps [{:db/id #edb/ref 17592186504716 :step/content {:db/id #edb/ref 17592186394511 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44b61f5d-9f26-5dfb-88a2-5bd1553444cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-5 \\\\ 1 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186394513} {:answer/id #uuid "313cef30-0e40-5e19-a20c-d67946ddd914" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-5 \\\\ 2 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186394514} {:answer/id #uuid "fea696ab-d539-5029-98a9-afe7403faef2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}2 \\\\ -5 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186394515} {:answer/id #uuid "2bdc7bae-9c94-54c4-9dd8-3c37a0fc36ca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}2 \\\\ 1 \\\\ -5\\end{bmatrix}" :db/id #edb/ref 17592186394516} {:answer/id #uuid "5f6ab00e-9bd5-5a22-b9a4-3b4ae167be95" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 \\\\ -5 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186394517}] :answer-field/correct {:db/id #edb/ref 17592186394517} :answer-field/id #uuid "b4acddf6-0263-54d3-b64b-9a44d6523c1e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186394512}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d0bf1f01-07c1-5bc9-90e8-13db8dd459d6" :question/math-academy-id "q-83563" :question/problem "Find the orthogonal projection of the vector $x$ onto the plane $r=sv+tw,$ where $s,t\\in R,$ and\n\n$$\nv=\\begin{bmatrix}-1 \\\\ 1 \\\\ 0\\end{bmatrix},\\,w=\\begin{bmatrix}1 \\\\ 1 \\\\ -1\\end{bmatrix},\\,x=\\begin{bmatrix}6 \\\\ 0 \\\\ 12\\end{bmatrix}.\n$$" :question/worked-solution "First, notice that $v$ and $w$ are linearly independent. \n\nThe orthogonal projection of $x$ onto the subspace $S$ spanned by the columns of a matrix $A$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x=A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x.\n$$\n\nSince our plane passes through the origin, it defines the subspace $S=\\text{Span}\\{v,w\\}$ in ${R}^{3}.$ In our case, we have\n\n$$\nA=\\begin{bmatrix}| & | \\\\ v & w \\\\ | & |\\end{bmatrix}=\\begin{bmatrix}-1 & \\text{ }1\\,\\, \\\\ 1 & \\text{ }1\\,\\, \\\\ 0 & \\,\\,\\,-1\\,\\,\\,\\,\\end{bmatrix}\\,⟹\\,{A}^{T}=\\begin{bmatrix}-1 & 1 & 0 \\\\ 1 & 1 & -1\\end{bmatrix}.\n$$\n\nTherefore, we get the following projection:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =\\begin{bmatrix}-1 & \\text{ }1\\,\\, \\\\ 1 & \\text{ }1\\,\\, \\\\ 0 & \\,\\,\\,-1\\,\\,\\,\\,\\end{bmatrix}\\cdot {(\\begin{bmatrix}-1 & 1 & 0 \\\\ 1 & 1 & -1\\end{bmatrix}\\cdot \\begin{bmatrix}-1 & \\text{ }1\\,\\, \\\\ 1 & \\text{ }1\\,\\, \\\\ 0 & \\,\\,\\,-1\\,\\,\\,\\,\\end{bmatrix})}^{-1}\\cdot \\begin{bmatrix}-1 & 1 & 0 \\\\ 1 & 1 & -1\\end{bmatrix}\\cdot \\begin{bmatrix}6 \\\\ 0 \\\\ 12\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 & \\text{ }1\\,\\, \\\\ 1 & \\text{ }1\\,\\, \\\\ 0 & \\,\\,\\,-1\\,\\,\\,\\,\\end{bmatrix}\\cdot {\\begin{bmatrix}2 & 0 \\\\ 0 & 3\\end{bmatrix}}^{-1}\\cdot \\begin{bmatrix}-6 \\\\ -6\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 & 1 \\\\ 1 & 1 \\\\ 0 & \\,\\,-1\\end{bmatrix}\\cdot \\frac{1}{6}\\begin{bmatrix}3 & 0 \\\\ 0 & 2\\end{bmatrix}\\cdot \\begin{bmatrix}-6 \\\\ -6\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 & 1 \\\\ 1 & 1 \\\\ 0 & \\,\\,-1\\end{bmatrix}\\cdot \\begin{bmatrix}-3 \\\\ -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ -5 \\\\ 2\\end{bmatrix}\\end{aligned}\n$$"} :step/id #uuid "29aa6d02-91fd-5979-90db-6f86dd498b05" :step/next {:db/id #edb/ref 17592186504725}} {:db/id #edb/ref 17592186504725 :step/content {:db/id #edb/ref 17592186351518 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "073d74ff-585a-5211-ab42-9064581e88f0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}2 \\\\ 2 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186348509} {:answer/id #uuid "59fc5c2f-0341-50bd-bee7-ed31a5e540a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-2 \\\\ -2 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186349275} {:answer/id #uuid "7a8587e9-698e-5aac-bff3-351d87f2a068" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-2 \\\\ 0 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186349573} {:answer/id #uuid "f8595241-4221-55b2-ab69-0bdadd3f1407" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 \\\\ -2 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186350624} {:answer/id #uuid "fec525da-79fa-5e81-8939-908fa7601311" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}2 \\\\ -2 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186350687}] :answer-field/correct {:db/id #edb/ref 17592186348509} :answer-fie