3\\end{bmatrix}\\cdot \\begin{bmatrix}1 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 \\\\ 2 \\\\ 2\\end{bmatrix}\\end{aligned}\n$$"} :step/id #uuid "5d35991b-d925-5bca-a777-1935eac2dc98" :step/next {:db/id #edb/ref 17592186504730}} {:db/id #edb/ref 17592186504727 :step/content {:db/id #edb/ref 17592186388974 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26b1ea4a-8431-5e9b-892f-bca7c95f80b0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 \\\\ 1 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186388976} {:answer/id #uuid "a5c9edc5-9c1a-5e2a-b1fe-0d7188e07e9a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}2 \\\\ -2 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186388977} {:answer/id #uuid "a1d236a8-2a2f-599a-b81e-073c9d88e925" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-1 \\\\ 7 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186388978} {:answer/id #uuid "e60312e7-b230-5a43-aa7d-233414826603" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-1 \\\\ 7 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186388979} {:answer/id #uuid "82820516-f5de-5854-9a60-bb231ec12fc9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-3 \\\\ 5 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186388980}] :answer-field/correct {:db/id #edb/ref 17592186388977} :answer-field/id #uuid "c310404e-e4a9-55ab-a9ab-4c596d9b583c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186388975}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7f3f0d39-46aa-5c30-a041-815de875f218" :question/math-academy-id "q-158129" :question/problem "Verify whether the vectors ${a}_{1},{a}_{2},{a}_{3}$ are linearly independent, and find the orthogonal projection of $x$ onto the subspace spanned by the vectors $\\{{a}_{1},{a}_{2},{a}_{3}\\},$ where\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ 2 \\\\ 1\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}2 \\\\ 1 \\\\ 2\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}-4 \\\\ 1 \\\\ -4\\end{bmatrix},\\,x=\\begin{bmatrix}-6 \\\\ -2 \\\\ 10\\end{bmatrix}.\n$$" :question/worked-solution "First, we verify whether ${a}_{1},{a}_{2},{a}_{3}$ are linearly independent. So, we start by creating a matrix whose columns are made up of our vectors, and then we reduce the matrix to row echelon form:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}1 & 2 & -4 \\\\ 2 & 1 & 1 \\\\ 1 & 2 & -4\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:={R}_{2}+(-2){R}_{1} \\\\ {R}_{3}:={R}_{3}-{R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 2 & -4 \\\\ 0 & -3 & 9 \\\\ 0 & 0 & 0\\end{bmatrix} &  & \\end{aligned}\n$$\n\nIn the reduced matrix above, the pivot columns correspond to the linearly independent vectors ${a}_{1}$ and ${a}_{2}$ that form the basis of our span.\n\nNow, the orthogonal projection of $x$ onto the subspace spanned by the linearly independent columns of a matrix $A$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x=A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x.\n$$\n\nIn our case, we have\n\n$$\nA=\\begin{bmatrix}| & | \\\\ {a}_{1} & {a}_{2} \\\\ | & |\\end{bmatrix}=\\begin{bmatrix}1 & 2 \\\\ 2 & 1 \\\\ 1 & 2\\end{bmatrix}\\,⟹\\,{A}^{T}=\\begin{bmatrix}1 & 2 & 1 \\\\ 2 & 1 & 2\\end{bmatrix}.\n$$\n\nTherefore, we get the following projection:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =\\begin{bmatrix}1 & 2 \\\\ 2 & 1 \\\\ 1 & 2\\end{bmatrix}\\cdot {(\\begin{bmatrix}1 & 2 & 1 \\\\ 2 & 1 & 2\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 2 \\\\ 2 & 1 \\\\ 1 & 2\\end{bmatrix})}^{-1}\\cdot \\begin{bmatrix}1 & 2 & 1 \\\\ 2 & 1 & 2\\end{bmatrix}\\cdot \\begin{bmatrix}-6 \\\\ -2 \\\\ 10\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 2 \\\\ 2 & 1 \\\\ 1 & 2\\end{bmatrix}\\cdot {\\begin{bmatrix}6 & 6 \\\\ 6 & 9\\end{bmatrix}}^{-1}\\cdot \\begin{bmatrix}0 \\\\ 6\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 2 \\\\ 2 & 1 \\\\ 1 & 2\\end{bmatrix}\\cdot \\frac{1}{18}\\begin{bmatrix}9 & -6 \\\\ -6 & 6\\end{bmatrix}\\cdot \\begin{bmatrix}0 \\\\ 6\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 2 \\\\ 2 & 1 \\\\ 1 & 2\\end{bmatrix}\\begin{bmatrix}-2 \\\\ 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 \\\\ -2 \\\\ 2\\end{bmatrix}\\end{aligned}\n$$"} :step/id #uuid "71bec694-ee30-53a5-a601-06a5e14ae2ed"} {:db/id #edb/ref 17592186504730 :step/content {:db/id #edb/ref 17592186388960 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "466a14af-419f-527e-b9f3-45ccda2c256a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-4 \\\\ 6 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186388962} {:answer/id #uuid "49467b16-c66d-5981-95f1-f41a27d0f189" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-10 \\\\ -2 \\\\ 7\\end{bmatrix}" :db/id #edb/ref 17592186388963} {:answer/id #uuid "33ffe7a1-67d2-5481-b344-193572a6847f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3 \\\\ -2 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186388964} {:answer/id #uuid "a2ab1c71-6000-5675-98fd-db1405a57c38" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3 \\\\ -11 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186388965} {:answer/id #uuid "162444cd-a8a6-5f12-b11d-5f7dc0e0ed43" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}11 \\\\ -10 \\\\ 7\\end{bmatrix}" :db/id #edb/ref 17592186388966}] :answer-field/correct {:db/id #edb/ref 17592186388964} :answer-field/id #uuid "d9b778d9-2ec0-5436-ace6-68397064b26b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186388961}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "bd91585f-60ab-5f83-868d-d63a69da0526" :question/math-academy-id "q-158122" :question/problem "Find the vector in the subspace spanned by $\\{{a}_{1},{a}_{2}\\}$ \nthat is closest to the vector $x,$ where \n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ 0 \\\\ 2\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}0 \\\\ 1 \\\\ 1\\end{bmatrix},\\,x=\\begin{bmatrix}1 \\\\ -3 \\\\ 5\\end{bmatrix}.\n$$" :question/worked-solution "First, notice that ${a}_{1}$ and ${a}_{2}$ are linearly independent. \n\nThe closest vector to $x$ in the subspace spanned by $\\{{a}_{1},{a}_{2}\\}$ is the orthogonal projection of $x$ onto the subspace, which is given by\n\n$$\n{\\text{proj}}_{S}\\,x=A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x.\n$$\n\nIn our case, we have\n\n$$\nA=\\begin{bmatrix}| & | \\\\ {a}_{1} & {a}_{2} \\\\ | & |\\end{bmatrix}=\\begin{bmatrix}1 & 0 \\\\ 0 & 1 \\\\ 2 & 1\\end{bmatrix}\\,⟹\\,{A}^{T}=\\begin{bmatrix}1 & 0 & 2 \\\\ 0 & 1 & 1\\end{bmatrix}.\n$$\n\nTherefore, we get the following projection:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1 \\\\ 2 & 1\\end{bmatrix}\\cdot {(\\begin{bmatrix}1 & 0 & 2 \\\\ 0 & 1 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 \\\\ 0 & 1 \\\\ 2 & 1\\end{bmatrix})}^{-1}\\cdot \\begin{bmatrix}1 & 0 & 2 \\\\ 0 & 1 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 \\\\ -3 \\\\ 5\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1 \\\\ 2 & 1\\end{bmatrix}\\cdot {\\begin{bmatrix}5 & 2 \\\\ 2 & 2\\end{bmatrix}}^{-1}\\cdot \\begin{bmatrix}11 \\\\ 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1 \\\\ 2 & 1\\end{bmatrix}\\cdot \\frac{1}{6}\\begin{bmatrix}2 & -2 \\\\ -2 & 5\\end{bmatrix}\\cdot \\begin{bmatrix}11 \\\\ 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1 \\\\ 2 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}3 \\\\ -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 \\\\ -2 \\\\ 4\\end{bmatrix}\\end{aligned}\n$$"} :step/id #uuid "81d27e89-104f-5902-93dd-75e684050d55" :step/next {:db/id #edb/ref 17592186504727}} {:db/id #edb/ref 17592186504732 :step/content {:db/id #edb/ref 17592186366111 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ce4106d4-3066-525e-9cc4-3cc62600cc77" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}4 \\\\ 2 \\\\ 6\\end{bmatrix}" :db/id #edb/ref 17592186366113} {:answer/id #uuid "30e731b8-e203-5d2a-b715-03aab570da25" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 \\\\ -2 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186366114} {:answer/id #uuid "c0ec102b-6380-5917-b3e8-96986912f2e4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-2 \\\\ -1 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186366115} {:answer/id #uuid "353ce806-e08a-585e-aedc-1f31c4ef4e92" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-2 \\\\ -2 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186366116} {:answer/id #uuid "88d5a945-073b-5c18-9a22-28e2025b07d3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}4 \\\\ 4 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186366117}] :answer-field/correct {:db/id #edb/ref 17592186366117} :answer-field/id #uuid "974cc47c-a0cf-5ce6-8700-2a3f5c0bccd1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186366112}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "efe681da-e463-5585-903f-22f3b4456bf0" :question/math-academy-id "q-39815" :question/problem "Find the vector in the subspace spanned by $\\{{a}_{1},{a}_{2}\\}$ \nthat is closest to the vector $x,$ where \n\n$$\n{a}_{1}=\\begin{bmatrix}2 \\\\ 2 \\\\ 2\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}1 \\\\ -2 \\\\ 1\\end{bmatrix},\\,x=\\begin{bmatrix}2 \\\\ 4 \\\\ 6\\end{bmatrix}.\n$$" :question/worked-solution "First, notice that ${a}_{1}$ and ${a}_{2}$ are linearly independent. \n\nThe closest vector to $x$ in the subspace spanned by $\\{{a}_{1},{a}_{2}\\}$ is orthogonal projection of $x$ onto the subspace, which is given by\n\n$$\n{\\text{proj}}_{S}\\,x=A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x.\n$$\n\nIn our case, we have\n\n$$\nA=\\begin{bmatrix}| & | \\\\ {a}_{1} & {a}_{2} \\\\ | & |\\end{bmatrix}=\\begin{bmatrix}2 & 1 \\\\ 2 & -2 \\\\ 2 & 1\\end{bmatrix}\\,⟹\\,{A}^{T}=\\begin{bmatrix}2 & 2 & 2 \\\\ 1 & -2 & 1\\end{bmatrix}.\n$$\n\nTherefore, we get the following projection:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =\\begin{bmatrix}2 & 1 \\\\ 2 & -2 \\\\ 2 & 1\\end{bmatrix}\\cdot {(\\begin{bmatrix}2 & 2 & 2 \\\\ 1 & -2 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}2 & 1 \\\\ 2 & -2 \\\\ 2 & 1\\end{bmatrix})}^{-1}\\cdot \\begin{bmatrix}2 & 2 & 2 \\\\ 1 & -2 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}2 \\\\ 4 \\\\ 6\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 1 \\\\ 2 & -2 \\\\ 2 & 1\\end{bmatrix}\\cdot {\\begin{bmatrix}12 & 0 \\\\ 0 & 6\\end{bmatrix}}^{-1}\\cdot \\begin{bmatrix}24 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 1 \\\\ 2 & -2 \\\\ 2 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}\\frac{1}{12} & 0 \\\\ 0 & \\frac{1}{6}\\end{bmatrix}\\cdot \\begin{bmatrix}24 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 1 \\\\ 2 & -2 \\\\ 2 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}2 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 \\\\ 4 \\\\ 4\\end{bmatrix}\\end{aligned}\n$$"} :step/id #uuid "a61e26f1-8cde-5341-acd8-7ced8e84a4f1" :step/next {:db/id #edb/ref 17592186504716}}] :activity/title "Projecting Vectors Onto Subspaces in Euclidean Spaces (Arbitrary Bases)" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186504024}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186538034} :activity/id #uuid "e25488af-2216-5d14-88af-1924c26a6fe6" :activity/scope {:db/id #edb/ref 17592186049970 :topic/id #uuid "22979210-8cd9-5db4-861d-faf167d0a850" :topic/math-academy-id 2124} :activity/steps [{:db/id #edb/ref 17592186537995 :step/content {:db/id #edb/ref 17592186537904 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e5a2d37-c4d6-5c27-bc7b-4ea71231b6a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}5 \\\\ -1 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186537359} {:answer/id #uuid "46d8d0ee-ed43-5b82-b677-585c48864035" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}1 \\\\ -5 \\\\ 11\\end{aligned}]" :db/id #edb/ref 17592186537376} {:answer/id #uuid "94896345-dcbf-5311-af2f-0470b2af33bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}1 \\\\ -1 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186537507} {:answer/id #uuid "b31e0d65-4eac-54bf-b80e-d663776fb997" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}2 \\\\ -3 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186537575} {:answer/id #uuid "b91ee488-df0e-59db-a257-d1dabeda41e0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}2 \\\\ -10 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186537588}] :answer-field/correct {:db/id #edb/ref 17592186537376} :answer-field/id #uuid "9313c766-b074-562e-915b-c0a2bae81c97" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186537821}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3a6241f6-827e-5f45-a2f2-3047ca1b82e0" :question/math-academy-id "q-86769" :question/problem "Find the vector in the subspace spanned by $\\{{a}_{1},{a}_{2}\\}$ \nthat is closest to the vector $x,$ where \n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ 1 \\\\ -4\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}],\\,x=[\\begin{aligned}-2 \\\\ -10 \\\\ 9\\end{aligned}].\n$$" :question/worked-solution "First, notice that ${a}_{1}$ and ${a}_{2}$ are linearly independent. \n\nThe closest vector to $x$ in the subspace spanned by $\\{{a}_{1},{a}_{2}\\}$ is orthogonal projection of $x$ onto the subspace, which is given by\n\n$$\n{\\text{proj}}_{S}\\,x=A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x.\n$$\n\nIn our case, we have\n\n$$\nA=[\\begin{aligned}| & | \\\\ {a}_{1} & {a}_{2} \\\\ | & |\\end{aligned}]=[\\begin{aligned}1 & 1 \\\\ 1 & -1 \\\\ -4 & 1\\end{aligned}]\\,⇒\\,{A}^{T}=[\\begin{aligned}1 & 1 & -4 \\\\ 1 & -1 & 1\\end{aligned}].\n$$\n\nTherefore, we get the following projection:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =[\\begin{aligned}1 & 1 \\\\ 1 & -1 \\\\ -4 & 1\\end{aligned}]\\cdot {([\\begin{aligned}1 & 1 & -4 \\\\ 1 & -1 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 1 \\\\ 1 & -1 \\\\ -4 & 1\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}1 & 1 & -4 \\\\ 1 & -1 & 1\\end{aligned}]\\cdot [\\begin{aligned}-2 \\\\ -10 \\\\ 9\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 1 \\\\ 1 & -1 \\\\ -4 & 1\\end{aligned}]\\cdot {[\\begin{aligned}18 & -4 \\\\ -4 & 3\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}-48 \\\\ 17\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 1 \\\\ 1 & -1 \\\\ -4 & 1\\end{aligned}]\\cdot \\frac{1}{38}[\\begin{aligned}3 & 4 \\\\ 4 & 18\\end{aligned}]\\cdot [\\begin{aligned}-48 \\\\ 17\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 1 \\\\ 1 & -1 \\\\ -4 & 1\\end{aligned}]\\cdot [\\begin{aligned}-2 \\\\ 3\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ -5 \\\\ 11\\end{aligned}]\\end{aligned}\n$$"} :step/id #uuid "06674b92-79e6-5824-abba-71763f29a6cc" :step/next {:db/id #edb/ref 17592186538054}} {:db/id #edb/ref 17592186538034 :step/content {:db/id #edb/ref 17592186392354 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "74abe4d7-e589-5617-ab73-5aa70c9a7476" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}4 \\\\ -7 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186392356} {:answer/id #uuid "ffa1264a-2a73-508f-bc53-ad361bb49d45" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 \\\\ -1 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186392357} {:answer/id #uuid "2a9e59f7-854e-5b73-a998-750da087cf90" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3 \\\\ -4 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186392358} {:answer/id #uuid "023b683d-9286-56c1-9880-82005e279d51" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3 \\\\ -5 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186392359} {:answer/id #uuid "6a7a2853-3ab5-5f8f-83a3-978af68e4e67" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}2 \\\\ -2 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186392360}] :answer-field/correct {:db/id #edb/ref 17592186392360} :answer-field/id #uuid "3f5082e4-d9ee-539a-9cb4-b5f824bb8ce6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186392355}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5c071401-3e46-54b6-b9cb-b8280a1a58b2" :question/math-academy-id "q-40630" :question/problem "Verify whether the vectors ${a}_{1},{a}_{2},{a}_{3}$ are linearly independent, and find the orthogonal projection of $x$ onto the subspace spanned by the vectors ${{a}_{1},{a}_{2},{a}_{3}},$ where\n\n$$\n{a}_{1}=\\begin{bmatrix}2 \\\\ -3 \\\\ 1\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}1 \\\\ -2 \\\\ 1\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}0 \\\\ 1 \\\\ -1\\end{bmatrix},\\,x=\\begin{bmatrix}3 \\\\ -1 \\\\ 1\\end{bmatrix}.\n$$" :question/worked-solution "First, we verify whether ${a}_{1},{a}_{2},{a}_{3}$ are linearly independent. So, we start by creating a matrix whose columns are made up of our vectors, and then we reduce the matrix to row echelon form:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}2 & 1 & 0 \\\\ -3 & -2 & 1 \\\\ 1 & 1 & -1\\end{bmatrix} &  & \\begin{aligned}{R}_{1}↔{R}_{3}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 1 & -1 \\\\ -3 & -2 & 1 \\\\ 2 & 1 & 0\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:={R}_{2}+3{R}_{1} \\\\ {R}_{3}:={R}_{3}-2{R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 1 & -1 \\\\ 0 & 1 & -2 \\\\ 0 & -1 & 2\\end{bmatrix} &  & \\begin{aligned}{R}_{3}:={R}_{3}+{R}_{2}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 1 & -1 \\\\ 0 & 1 & -2 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nIn the reduced matrix above, the pivot columns correspond to the linearly independent vectors ${a}_{1}$ and ${a}_{2}$ that form the basis of our span.\n\nNow, the orthogonal projection of $x$ onto the subspace spanned by the linearly independent columns of a matrix $A$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x=A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x.\n$$\n\nIn our case, we have\n\n$$\nA=\\begin{bmatrix}| & | \\\\ {a}_{1} & {a}_{2} \\\\ | & |\\end{bmatrix}=\\begin{bmatrix}2 & 1 \\\\ -3 & -2 \\\\ 1 & 1\\end{bmatrix}\\,⇒\\,{A}^{T}=\\begin{bmatrix}2 & -3 & 1 \\\\ 1 & -2 & 1\\end{bmatrix}.\n$$\n\nTherefore, we get the following projection:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =\\begin{bmatrix}2 & 1 \\\\ -3 & -2 \\\\ 1 & 1\\end{bmatrix}\\cdot {(\\begin{bmatrix}2 & -3 & 1 \\\\ 1 & -2 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}2 & 1 \\\\ -3 & -2 \\\\ 1 & 1\\end{bmatrix})}^{-1}\\cdot \\begin{bmatrix}2 & -3 & 1 \\\\ 1 & -2 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}3 \\\\ -1 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 1 \\\\ -3 & -2 \\\\ 1 & 1\\end{bmatrix}\\cdot {\\begin{bmatrix}14 & 9 \\\\ 9 & 6\\end{bmatrix}}^{-1}\\cdot \\begin{bmatrix}10 \\\\ 6\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 1 \\\\ -3 & -2 \\\\ 1 & 1\\end{bmatrix}\\cdot \\frac{1}{3}\\begin{bmatrix}6 & -9 \\\\ -9 & 14\\end{bmatrix}\\cdot \\begin{bmatrix}10 \\\\ 6\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 1 \\\\ -3 & -2 \\\\ 1 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}2 \\\\ -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 \\\\ -2 \\\\ 0\\end{bmatrix}\\end{aligned}\n$$"} :step/id #uuid "8a025179-4153-59ae-829a-43edf5b908e1" :step/next {:db/id #edb/ref 17592186538053}} {:db/id #edb/ref 17592186538035 :step/content {:db/id #edb/ref 17592186365171 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "af4b666c-66b7-59db-a2c7-375a67faef78" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-1 \\\\ 3 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186365173} {:answer/id #uuid "2491dfc4-81ea-5a89-b8be-feb29fe808fe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3 \\\\ -1 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186365174} {:answer/id #uuid "1d65e323-bafc-5753-acb8-9ac7daf8900d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 \\\\ 2 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186365175} {:answer/id #uuid "e5472a7d-a8ec-53cc-922d-6c6d7cc7492e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 \\\\ 1 \\\\ -3\\end{bmatrix}" :db/id #edb/ref 17592186365176} {:answer/id #uuid "d3b72fcb-1431-51dd-bb92-2f52bbb46be9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 \\\\ 3 \\\\ -3\\end{bmatrix}" :db/id #edb/ref 17592186365177}] :answer-field/correct {:db/id #edb/ref 17592186365173} :answer-field/id #uuid "80f414bd-ce38-5f46-a4ae-f2f0ad8e10ac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186365172}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4f1a2346-136d-53f7-ba3d-f6d83d0dc1db" :question/math-academy-id "q-158299" :question/problem "Find the orthogonal projection of the vector $x$ onto the plane $r=sv+tw,$ where $s,t\\in R,$ and\n\n$$\nv=\\begin{bmatrix}1 \\\\ 2 \\\\ 1\\end{bmatrix},\\,w=\\begin{bmatrix}2 \\\\ -1 \\\\ 2\\end{bmatrix},\\,x=\\begin{bmatrix}1 \\\\ 3 \\\\ -3\\end{bmatrix}.\n$$" :question/worked-solution "First, notice that $v$ and $w$ are linearly independent. \n\nThe orthogonal projection of $x$ onto the subspace spanned by the columns of a matrix $A$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x=A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x.\n$$\n\nSince our plane passes through the origin, it defines the subspace $S=\\text{Span}{v,w}$ in ${R}^{3}.$ In our case, we have\n\n$$\nA=\\begin{bmatrix}| & | \\\\ v & w \\\\ | & |\\end{bmatrix}=\\begin{bmatrix}1 & 2 \\\\ 2 & -1 \\\\ 1 & 2\\end{bmatrix}\\,⟹\\,{A}^{T}=\\begin{bmatrix}1 & 2 & 1 \\\\ 2 & -1 & 2\\end{bmatrix}.\n$$\n\nTherefore, we get the following projection:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =\\begin{bmatrix}1 & 2 \\\\ 2 & -1 \\\\ 1 & 2\\end{bmatrix}\\cdot {(\\begin{bmatrix}1 & 2 & 1 \\\\ 2 & -1 & 2\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 2 \\\\ 2 & -1 \\\\ 1 & 2\\end{bmatrix})}^{-1}\\cdot \\begin{bmatrix}1 & 2 & 1 \\\\ 2 & -1 & 2\\end{bmatrix}\\cdot \\begin{bmatrix}1 \\\\ 3 \\\\ -3\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 2 \\\\ 2 & -1 \\\\ 1 & 2\\end{bmatrix}\\cdot {\\begin{bmatrix}6 & 2 \\\\ 2 & 9\\end{bmatrix}}^{-1}\\cdot \\begin{bmatrix}4 \\\\ -7\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 2 \\\\ 2 & -1 \\\\ 1 & 2\\end{bmatrix}\\cdot \\frac{1}{50}\\begin{bmatrix}9 & -2 \\\\ -2 & 6\\end{bmatrix}\\cdot \\begin{bmatrix}4 \\\\ -7\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 2 \\\\ 2 & -1 \\\\ 1 & 2\\end{bmatrix}\\cdot \\begin{bmatrix}1 \\\\ -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 \\\\ 3 \\\\ -1\\end{bmatrix}\\end{aligned}\n$$"} :step/id #uuid "91f96d99-dd00-555d-a4bd-d5b4d415820a"} {:db/id #edb/ref 17592186538053 :step/content {:db/id #edb/ref 17592186537968 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fad72e3-bee7-5eb3-9828-6bf06dfaa7af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}-1 \\\\ -1 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186537256} {:answer/id #uuid "b435f2e3-4cd8-585d-954c-52f87c1f4746" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}1 \\\\ -4 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186537577} {:answer/id #uuid "cb246cd3-9bbb-53e2-b543-1ad93f9bd8ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}4 \\\\ -1 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186537626} {:answer/id #uuid "f69ae65b-9be7-53cf-91f1-13dc37eb2f46" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}1 \\\\ 4 \\\\ -4\\end{aligned}]" :db/id #edb/ref 17592186537735} {:answer/id #uuid "fb15ad4b-aa77-523c-bd0d-f2171314bac1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}-1 \\\\ -4 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186537747}] :answer-field/correct {:db/id #edb/ref 17592186537626} :answer-field/id #uuid "91e225e4-0bfc-5b26-8ce8-66c5aba780de" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186537820}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cc66ebbe-2cca-5407-87bc-772df677089f" :question/math-academy-id "q-86762" :question/problem "Find the orthogonal projection of the vector $x$ onto the plane $r=sv+tw,$ where $s,t\\in R,$ and\n\n$$\nv=[\\begin{aligned}3 \\\\ -2 \\\\ -2\\end{aligned}],\\,w=[\\begin{aligned}1 \\\\ 1 \\\\ 1\\end{aligned}],\\,x=[\\begin{aligned}4 \\\\ -6 \\\\ 4\\end{aligned}].\n$$" :question/worked-solution "First, notice that $v$ and $w$ are linearly independent. \n\nThe orthogonal projection of $x$ onto the subspace $S$ spanned by the columns of a matrix $A$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x=A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x.\n$$\n\nSince our plane passes through the origin, it defines the subspace $S=\\text{Span}\\{v,w\\}$ in ${R}^{3}.$ In our case, we have\n\n$$\nA=[\\begin{aligned}| & | \\\\ v & w \\\\ | & |\\end{aligned}]=[\\begin{aligned}3 & 1 \\\\ -2 & 1 \\\\ -2 & 1\\end{aligned}]\\,⟹\\,{A}^{T}=[\\begin{aligned}3 & -2 & -2 \\\\ 1 & 1 & 1\\end{aligned}].\n$$\n\nTherefore, we get the following projection:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =[\\begin{aligned}3 & 1 \\\\ -2 & 1 \\\\ -2 & 1\\end{aligned}]\\cdot {([\\begin{aligned}3 & -2 & -2 \\\\ 1 & 1 & 1\\end{aligned}]\\cdot [\\begin{aligned}3 & 1 \\\\ -2 & 1 \\\\ -2 & 1\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}3 & -2 & -2 \\\\ 1 & 1 & 1\\end{aligned}]\\cdot [\\begin{aligned}4 \\\\ -6 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 1 \\\\ -2 & 1 \\\\ -2 & 1\\end{aligned}]\\cdot {[\\begin{aligned}17 & -1 \\\\ -1 & 3\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}16 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 1 \\\\ -2 & 1 \\\\ -2 & 1\\end{aligned}]\\cdot \\frac{1}{50}[\\begin{aligned}3 & 1 \\\\ 1 & 17\\end{aligned}]\\cdot [\\begin{aligned}16 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 1 \\\\ -2 & 1 \\\\ -2 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}4 \\\\ -1 \\\\ -1\\end{aligned}]\\end{aligned}\n$$"} :step/id #uuid "c41a8537-e103-57cd-982b-440dde37abd4" :step/next {:db/id #edb/ref 17592186537995}} {:db/id #edb/ref 17592186538054 :step/content {:db/id #edb/ref 17592186365003 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c8cc9b5-4fea-51be-8530-093f28bb182d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}5 \\\\ -7 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186365005} {:answer/id #uuid "d8437765-1667-5b4a-a2d4-519d741042f9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3 \\\\ -7 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186365006} {:answer/id #uuid "80156ccd-7acc-5a08-958d-43e718870bf6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3 \\\\ -5 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186365007} {:answer/id #uuid "46e97d17-2170-52e4-bae8-f1a4b26c06f1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}5 \\\\ -3 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186365008} {:answer/id #uuid "bb6446d2-ce20-5814-95a8-6fcf987d8011" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 \\\\ 1 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186365009}] :answer-field/correct {:db/id #edb/ref 17592186365005} :answer-field/id #uuid "0051ff91-5982-5f79-8021-15f6e5a79345" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186365004}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b15ae07d-6779-551f-ab28-55256b58c480" :question/math-academy-id "q-140452" :question/problem "Find the orthogonal projection of the vector $x$ onto the plane $r=sv+tw,$ where $s,t\\in R,$ and\n\n$$\nv=\\begin{bmatrix}1 \\\\ 0 \\\\ -1\\end{bmatrix},\\,w=\\begin{bmatrix}1 \\\\ 1 \\\\ -2\\end{bmatrix},\\,x=\\begin{bmatrix}6 \\\\ -6 \\\\ 3\\end{bmatrix}.\n$$" :question/worked-solution "First, notice that $v$ and $w$ are linearly independent. \n\nThe orthogonal projection of $x$ onto the subspace spanned by the columns of a matrix $A$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x=A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x.\n$$\n\nSince our plane passes through the origin, it defines the subspace $S=\\text{Span}{v,w}$ in ${R}^{3}.$ In our case, we have\n\n$$\nA=\\begin{bmatrix}| & | \\\\ v & w \\\\ | & |\\end{bmatrix}=\\begin{bmatrix}1 & 1 \\\\ 0 & 1 \\\\ -1 & -2\\end{bmatrix}\\,⟹\\,{A}^{T}=\\begin{bmatrix}1 & 0 & -1 \\\\ 1 & 1 & -2\\end{bmatrix}.\n$$\n\nTherefore, we get the following projection:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =\\begin{bmatrix}1 & 1 \\\\ 0 & 1 \\\\ -1 & -2\\end{bmatrix}\\cdot {(\\begin{bmatrix}1 & 0 & -1 \\\\ 1 & 1 & -2\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 1 \\\\ 0 & 1 \\\\ -1 & -2\\end{bmatrix})}^{-1}\\cdot \\begin{bmatrix}1 & 0 & -1 \\\\ 1 & 1 & -2\\end{bmatrix}\\cdot \\begin{bmatrix}6 \\\\ -6 \\\\ 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 1 \\\\ 0 & 1 \\\\ -1 & -2\\end{bmatrix}\\cdot {\\begin{bmatrix}2 & 3 \\\\ 3 & 6\\end{bmatrix}}^{-1}\\cdot \\begin{bmatrix}3 \\\\ -6\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 1 \\\\ 0 & 1 \\\\ -1 & -2\\end{bmatrix}\\cdot \\frac{1}{3}\\begin{bmatrix}6 & -3 \\\\ -3 & 2\\end{bmatrix}\\cdot \\begin{bmatrix}3 \\\\ -6\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 1 \\\\ 0 & 1 \\\\ -1 & -2\\end{bmatrix}\\cdot \\begin{bmatrix}12 \\\\ -7\\end{bmatrix} \\\\  & =\\begin{bmatrix}5 \\\\ -7 \\\\ 2\\end{bmatrix}\\end{aligned}\n$$"} :step/id #uuid "c461e720-e126-50ff-b3e3-49b8487aab6f" :step/next {:db/id #edb/ref 17592186538035}}] :activity/title "Projecting Vectors Onto Subspaces in Euclidean Spaces (Arbitrary Bases)" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref