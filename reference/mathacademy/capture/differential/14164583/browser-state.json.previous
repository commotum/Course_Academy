      "source_url": "https://mathacademy.com/tasks/14164583/topics/3036/lesson",
      "captured_at": 1791890444.7565494,
      "math_academy_id": "q-253869",
      "topic_id": "3036",
      "sequence_position": null,
      "source_step": {
