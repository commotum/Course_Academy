      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14164583/observations/step-q253897-ce2b7910f2af7690c63f.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14164583/observations/step-q253897-ce2b7910f2af7690c63f.png",
      "source_url": "https://mathacademy.com/tasks/14164583/topics/3036/lesson",
      "captured_at": 1791890467.1005907,
      "math_academy_id": "q-253897",
      "topic_id": "3036",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q253897",
        "placement_id": null,
        "content_id": null,
        "type": null
