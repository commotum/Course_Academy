 #edb/ref 17592186488601} {:answer/id #uuid "4048a7cf-5e90-517d-b59e-7c8fe9d1d965" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sup(A)=2\\notin A" :db/id #edb/ref 17592186488603} {:answer/id #uuid "e27c7066-6cee-5bf3-8410-52b38d657725" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sup(A)=0\\in A" :db/id #edb/ref 17592186488941}] :answer-field/correct {:answer/id #uuid "4048a7cf-5e90-517d-b59e-7c8fe9d1d965" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sup(A)=2\\notin A" :db/id #edb/ref 17592186488603} :answer-field/id #uuid "c36b9a2c-4e62-5b21-9012-7faf214bd6f7" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186489125} {:answer-field/choices [{:answer/id #uuid "7013dafc-513b-5282-9b6e-8298bbcaa96a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186488693} {:answer/id #uuid "efa4a326-17fa-5372-b69d-5e6405b0fba8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186488974}] :answer-field/correct {:answer/id #uuid "7013dafc-513b-5282-9b6e-8298bbcaa96a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186488693} :answer-field/id #uuid "cfc061c6-f499-57fc-948d-02e770903359" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186489136}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8283d19d-ef90-50f2-bc41-5e0573a21b42" :question/math-academy-id "q-253512" :question/problem "Consider the set $A=(0,2).$ Complete the following reasoning to identify $sup(A).$\n\nThe supremum of a set $A$ is the {{field-1}} of $A.$\n\nThe set of upper bounds of $A$ is as follows:\n\n$$\n\\{x\\in R\\,:\\,x{{field-2}}{{field-3}}\\}\n$$\n\nTherefore, {{field-4}}." :question/worked-solution "The supremum of a set $A$ is the smallest upper bound of $A.$\n\nTo find the supremum of this set, we must find the set containing **all** upper bounds of $A$ (i.e., the set of upper bounds) and take the minimum of this set.\n\nIn our case, we have the following:\n\n- Any number in the set $x\\ge 2$ is greater than or equal to the elements of $A.$ Thus, the set $[2,\\infty )$ contains only upper bounds of $A.$\n\n- Any number in the set $x<2$ is **not** an upper bound of $A.$ In other words, we can always find an element of $A$ that is greater than $x$ for any $x<2.$\n\nTherefore, $[2,\\infty )$ is the set of upper bounds of $A,$ and\n\n$$\nsup(A)=min[2,\\infty )=2.\n$$\n\nNotice that $2\\notin A.$\n\nThe completed reasoning is given below.\n\nThe supremum of $A$ is the $\\text{smallest upper bound}$ of $A.$\n\nThe set of upper bounds of $A$ is as follows:\n\n$$\n\\{x\\in R\\,:\\,x\\ge 2\\}\n$$\n\nTherefore, $sup(A)=2\\notin A.$"}] [{:db/id #edb/ref 17592186489174 :knowledge-point/_questions [{:db/id #edb/ref 17592186162158 :knowledge-point/id #uuid "ffe2b2c0-23a0-5bd0-8bc7-c12139820b61" :knowledge-point/title "Supremum and Infimum of a Sequence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "424cb1f4-7e81-5741-9fea-91a70c42cb72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sup(A)=\\frac{13}{2}\\in A" :db/id #edb/ref 17592186488607} {:answer/id #uuid "4c403958-65ff-5e3d-a88d-eb4c593bbb86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sup(A)=7\\notin A" :db/id #edb/ref 17592186488618} {:answer/id #uuid "590bf0de-aa9c-5cf8-b6b6-eb31e0700ed4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$sup(A)$ does not exist" :db/id #edb/ref 17592186488640} {:answer/id #uuid "a9d0eb3a-5dc4-5b58-944e-b28df01e747b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sup(A)=7\\in A" :db/id #edb/ref 17592186488807} {:answer/id #uuid "b98431df-8366-56c8-bb4a-a0335b0aa79f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sup(A)=\\frac{13}{2}\\notin A" :db/id #edb/ref 17592186488839}] :answer-field/correct {:answer/id #uuid "4c403958-65ff-5e3d-a88d-eb4c593bbb86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sup(A)=7\\notin A" :db/id #edb/ref 17592186488618} :answer-field/id #uuid "11588f66-7282-571e-8e23-97b1f1c241fa" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186489028}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "03070e45-f0e3-5991-b98c-709745709961" :question/math-academy-id "q-253526" :question/problem "Consider the following set.\n\n$$\nA=\\{7-{(\\frac{1}{2})}^{n}\\,:\\,n\\in N\\}\n$$\n\nFor this set, we have {{field-1}}." :question/worked-solution "The supremum of a set $A$ is the smallest upper bound of $A.$\n\nTo find the supremum of this set, we must find the set containing **all** upper bounds of $A$ (i.e., the set of upper bounds) and take the minimum of this set.\n\nThe elements of $A$ are all the terms of the sequence ${a}_{n},$ given by\n\n$$\n{a}_{n}=7-{(\\frac{1}{2})}^{n},\\,n\\in N=\\{1,2,3,4,…\\}.\n$$\n\nLet's draw some points of our sequence on the real line:\n\n![](images/ca/cae6f56db55b49b98df6ce7e3ae0777e725af14de9dedb5b61b54039bac41860.png)\n\nWe see that ${a}_{n}$ is increasing and converges to $7.$ \n\nSo, in our case, we have that\n\n- any number in the set $x\\ge 7$ is an upper bound of $A,$\n\n- any number in the set $x<7$ is **not** an upper bound of $A.$ In other words, we can always find a sufficiently large $n$ so that $7-{(\\frac{1}{2})}^{n}$ is greater than $x$ for any $x<7.$\n\nTherefore, $[7,\\infty )$ is the set of upper bounds of $A,$ and \n\n$$\nsup(A)=min[7,\\infty )=7.\n$$\n\nNotice that $7$ is *not* the maximum of $A$ (the set $A$ has no maximum). Therefore, we conclude that\n\n$$\nsup(A)=7\\notin A.\n$$"}] [{:db/id #edb/ref 17592186162529 :knowledge-point/_questions [{:db/id #edb/ref 17592186162156 :knowledge-point/id #uuid "f950f3da-81c2-574a-b7f7-06d88945c249" :knowledge-point/title "Supremum and Infimum of a Finite Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d8929061-a36b-574c-a4a0-2a9230b65f4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186488919}] :answer-field/correct {:answer/id #uuid "d8929061-a36b-574c-a4a0-2a9230b65f4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186488919} :answer-field/id #uuid "1c762596-2608-5e67-889c-627985c34945" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186160501}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2c1d7015-20c9-5785-8dde-ce877756d0c6" :question/math-academy-id "q-253549" :question/problem "Consider the set $A,$ defined as\n\n$$\nA=\\{\\frac{(-1)^{n}}{{n}^{2}+1}:n\\in \\{1,2,3,4\\}\\}.\n$$\n\nWhat is the supremum of $A?$\n\n$sup(A)=$\n{{field-1}}" :question/worked-solution "The supremum of a set $A$ is the smallest upper bound of $A.$\n\nIf $A$ is a finite set, the supremum of $A$ equals its maximum. \n\nFirst, let's write down all the terms of our set by substituting $n=1,2,3,4$ into the expression for the elements of $A:$\n\n$$\n\\begin{aligned}\\frac{(-1)^{1}}{(1)^{2}+1} & =-\\frac{1}{2} \\\\ \\frac{(-1)^{2}}{(2)^{2}+1} & =\\frac{1}{5} \\\\ \\frac{(-1)^{3}}{(3)^{2}+1} & =-\\frac{1}{10} \\\\ \\frac{(-1)^{4}}{(4)^{2}+1} & =\\frac{1}{17}\\end{aligned}\n$$\n\nSo, we have\n\n$$\nA=\\{-\\frac{1}{2},\\,\\frac{1}{5},\\,-\\frac{1}{10},\\,\\frac{1}{17}\\}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}sup(A) & =max\\{-\\frac{1}{2},\\,\\frac{1}{5},\\,-\\frac{1}{10},\\,\\frac{1}{17}\\}=\\frac{1}{5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186489247 :knowledge-point/_questions [{:db/id #edb/ref 17592186162157 :knowledge-point/id #uuid "fee0e08c-5a7a-5f78-83aa-39679bb3b17b" :knowledge-point/title "Supremum and Infimum of an Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02cd44fe-73ba-5cc5-888a-532c8eaa56c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "inf(A)=5\\in A" :db/id #edb/ref 17592186488474} {:answer/id #uuid "72f49a2a-7e33-5dea-8248-8b07b4770499" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "inf(A)=-5\\notin A" :db/id #edb/ref 17592186488700} {:answer/id #uuid "8695d407-b8e6-5951-8447-a9dc025727b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "inf(A)=5\\notin A" :db/id #edb/ref 17592186488734} {:answer/id #uuid "93a7b3b0-bb34-5a9f-a039-8842eb3f070b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "inf(A)=-5\\in A" :db/id #edb/ref 17592186488766} {:answer/id #uuid "ae14740c-0bec-5b4d-9e98-d2aa11f93eb7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$inf(A)$ does not exist" :db/id #edb/ref 17592186488816}] :answer-field/correct {:answer/id #uuid "72f49a2a-7e33-5dea-8248-8b07b4770499" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "inf(A)=-5\\notin A" :db/id #edb/ref 17592186488700} :answer-field/id #uuid "1e6ccc5e-e2f1-5031-9908-8c3a1cc535d6" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186489037} 