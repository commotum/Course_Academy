1</mn></msub><mo>+</mo><msub><mi>y</mi><mn>2</mn></msub><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup><mo>+</mo><mo stretchy=\"false\">(</mo><mn>5</mn><msub><mi>y</mi><mn>1</mn></msub><mo>+</mo><msub><mi>y</mi><mn>2</mn></msub><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mn>2</mn><msub><mi>y</mi><mn>2</mn></msub><mo stretchy=\"false\">)</mo><mo>−</mo><mn>2</mn><mo stretchy=\"false\">(</mo><mo>−</mo><mn>2</mn><msub><mi>y</mi><mn>2</mn></msub><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>25</mn><msubsup><mi>y</mi><mn>1</mn><mn>2</mn></msubsup><mo>+</mo><mn>10</mn><msub><mi>y</mi><mn>1</mn></msub><msub><mi>y</mi><mn>2</mn></msub><mo>+</mo><msubsup><mi>y</mi><mn>2</mn><mn>2</mn></msubsup><mo>−</mo><mn>10</mn><msub><mi>y</mi><mn>1</mn></msub><msub><mi>y</mi><mn>2</mn></msub><mo>−</mo><mn>2</mn><msubsup><mi>y</mi><mn>2</mn><mn>2</mn></msubsup><mo>−</mo><mn>8</mn><msubsup><mi>y</mi><mn>2</mn><mn>2</mn></msubsup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>25</mn><msubsup><mi>y</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><mn>9</mn><msubsup><mi>y</mi><mn>2</mn><mn>2</mn></msubsup></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
