ef 17592186161991 :knowledge-point/id #uuid "f203c9bf-7d12-56db-aafe-6639162eae93" :knowledge-point/title "Changing Variables in a Quadratic Form Given Old Variables Through New Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47a19732-37e9-5ead-b2de-51ca85ee553f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{1}^{2}-4{y}_{2}{y}_{1}+{y}_{2}^{2}" :db/id #edb/ref 17592186355298} {:answer/id #uuid "62df463c-a867-5e66-a4d9-b896c24bb674" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{1}^{2}+4{y}_{2}{y}_{1}" :db/id #edb/ref 17592186355545} {:answer/id #uuid "77c4cc74-bd29-5c3c-a832-85105e23e87f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{1}^{2}-{y}_{2}^{2}" :db/id #edb/ref 17592186355715} {:answer/id #uuid "d836ead9-5148-5b10-a581-c389b7fa4bcf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{y}_{1}^{2}+2{y}_{2}^{2}" :db/id #edb/ref 17592186356559} {:answer/id #uuid "f9f6cbb3-8dbe-5a4a-a8a7-73b849a1f355" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{y}_{1}^{2}+4{y}_{2}{y}_{1}-{y}_{2}^{2}" :db/id #edb/ref 17592186356850}] :answer-field/correct {:answer/id #uuid "d836ead9-5148-5b10-a581-c389b7fa4bcf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{y}_{1}^{2}+2{y}_{2}^{2}" :db/id #edb/ref 17592186356559} :answer-field/id #uuid "9af5fb0d-88b9-5b1a-94f9-8ce8a2461508" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357193}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e4dd88ed-2abc-54cc-bd19-07fe0403a666" :question/math-academy-id "q-94153" :question/problem "Given that \n\n$$\n[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]=[\\begin{aligned}1 & 1 \\\\ -1 & 1\\end{aligned}][\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}],\n$$\n\n express the quadratic form $Q(x)={x}_{1}^{2}+{x}_{2}^{2}\\,$ in terms of the components of $y.$" :question/worked-solution "First, notice that\n\n$$\n[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]=[\\begin{aligned}1 & 1 \\\\ -1 & 1\\end{aligned}][\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}]\n$$\n\ngives the following expressions for ${x}_{1}$ and ${x}_{2}:$\n\n$$\n\\begin{aligned}{x}_{1} & ={y}_{1}+{y}_{2} \\\\ {x}_{2} & =-{y}_{1}+{y}_{2}\\end{aligned}\n$$\n\nNow, we substitute these into our quadratic form expression:\n\n$$\n\\begin{aligned}Q(x) & ={x}_{1}^{2}+{x}_{2}^{2} \\\\  & =({y}_{1}+{y}_{2})^{2}+(-{y}_{1}+{y}_{2})^{2} \\\\  & ={y}_{1}^{2}+2{y}_{1}{y}_{2}+{y}_{2}^{2}+{y}_{1}^{2}-2{y}_{1}{y}_{2}+{y}_{2}^{2} \\\\  & =2{y}_{1}^{2}+2{y}_{2}^{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186378018 :knowledge-point/_questions [{:db/id #edb/ref 17592186161992 :knowledge-point/id #uuid "9f2a5391-d8bb-5084-941a-bb787e8729f3" :knowledge-point/title "Changing Variables in a Quadratic Form Given New Variables Through Old Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "100560f8-c61b-548b-83b0-fbcdb8ab8be8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{1}^{2}-2{y}_{1}{y}_{2}+{y}_{2}^{2}" :db/id #edb/ref 17592186378020} {:answer/id #uuid "6560fa41-bd9c-546d-a6ce-0e0fde792e9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{1}^{2}-4{y}_{1}{y}_{2}+4{y}_{2}^{2}" :db/id #edb/ref 17592186378021} {:answer/id #uuid "baa90368-0451-5588-9aa7-54ea42698d35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{1}^{2}-6{y}_{1}{y}_{2}+{y}_{2}^{2}" :db/id #edb/ref 17592186378022} {:answer/id #uuid "8a430883-a082-5345-9032-64d559ab84fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{1}^{2}+2{y}_{1}{y}_{2}+2{y}_{2}^{2}" :db/id #edb/ref 17592186378023} {:answer/id #uuid "1084b67f-90f7-5ef8-8b35-8b029050b46f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{1}^{2}-2{y}_{1}{y}_{2}+2{y}_{2}^{2}" :db/id #edb/ref 17592186378024}] :answer-field/correct {:answer/id #uuid "6560fa41-bd9c-546d-a6ce-0e0fde792e9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{1}^{2}-4{y}_{1}{y}_{2}+4{y}_{2}^{2}" :db/id #edb/ref 17592186378021} :answer-field/id #uuid "4300a56d-5e54-5540-af4a-6073862831d4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378019}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "88349410-8bfd-560a-a802-6c2dbf91d963" :question/math-academy-id "q-94164" :question/problem "Given that \n\n$$\n[\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}]=[\\begin{aligned}1 & -1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}],\n$$\n\n express the quadratic form $Q(x)={x}_{1}^{2}+2{x}_{1}{x}_{2}+{x}_{2}^{2}$ in terms of the components of $y.$" :question/worked-solution "First, notice that \n\n$$\n[\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}]=[\\begin{aligned}1 & -1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]\n$$\n\ngives the following expressions for ${y}_{1}$ and ${y}_{2}:$\n\n$$\n\\begin{aligned}{y}_{1} & ={x}_{1}-{x}_{2} \\\\ {y}_{2} & ={x}_{1}\\end{aligned}\n$$\n\nBy solving the second equation for ${x}_{1}$ and substituting it into the first equation, we obtain the following expressions for ${x}_{1}$ and ${x}_{2}:$\n\n$$\n\\begin{aligned}{x}_{1} & ={y}_{2} \\\\ {x}_{2} & =-{y}_{1}+{y}_{2}\\end{aligned}\n$$\n\nNow, we substitute these into our quadratic form expression:\n\n$$\n\\begin{aligned}Q(x) & ={x}_{1}^{2}+2{x}_{1}{x}_{2}+{x}_{2}^{2} \\\\  & ={y}_{2}^{2}+2{y}_{2}(-{y}_{1}+{y}_{2})+(-{y}_{1}+{y}_{2})^{2} \\\\  & ={y}_{2}^{2}+-2{y}_{2}{y}_{1}+2{y}_{2}^{2}+{y}_{1}^{2}-2{y}_{2}{y}_{2}+{y}_{2}^{2} \\\\  & ={y}_{1}^{2}-4{y}_{1}{y}_{2}+4{y}_{2}^{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186357683 :knowledge-point/_questions [{:db/id #edb/ref 17592186161992 :knowledge-point/id #uuid "9f2a5391-d8bb-5084-941a-bb787e8729f3" :knowledge-point/title "Changing Variables in a Quadratic Form Given New Variables Through Old Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2126c9c8-bd57-5e7f-b6a4-8eb1971711e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{1}^{2}-4{y}_{1}{y}_{2}-{y}_{2}^{2}" :db/id #edb/ref 17592186354943} {:answer/id #uuid "48c90089-d7b5-5dd5-9e93-d1a7af54a745" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{y}_{1}{y}_{2}-6{y}_{2}^{2}" :db/id #edb/ref 17592186355309} {:answer/id #uuid "8a200c8a-12b2-50a5-99ba-4cc4e6a787c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{y}_{1}^{2}-4{y}_{1}{y}_{2}+{y}_{2}^{2}" :db/id #edb/ref 17592186355885} {:answer/id #uuid "931f5d3b-ac1a-570e-8282-23f84f96c918" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{1}^{2}-2{y}_{1}{y}_{2}-{y}_{2}^{2}" :db/id #edb/ref 17592186355961} {:answer/id #uuid "f1a67a36-f4c0-5268-aee2-0a338176214c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{1}^{2}+4{y}_{1}{y}_{2}+2{y}_{2}^{2}" :db/id #edb/ref 17592186356778}] :answer-field/correct {:answer/id #uuid "2126c9c8-bd57-5e7f-b6a4-8eb1971711e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{1}^{2}-4{y}_{1}{y}_{2}-{y}_{2}^{2}" :db/id #edb/ref 17592186354943} :answer-field/id #uuid "cee83a5c-fe07-5034-a77a-5e166ec0f34a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357293}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f24e333b-797a-56a0-81db-662b973c9c78" :question/math-academy-id "q-94176" :question/problem "Given that \n\n$$\n[\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}]=[\\begin{aligned}-1 & -1 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}],\n$$\n\n express the quadratic form $Q(x)={x}_{1}^{2}-2{x}_{1}{x}_{2}-4{x}_{2}^{2}$ in terms of the components of $y.$" :question/worked-solution "First, notice that \n\n$$\n[\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}]=[\\begin{aligned}-1 & -1 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]\n$$\n\n \n\ngives the following expressions for ${y}_{1}$ and ${y}_{2}:$\n\n$$\n\\begin{aligned}{y}_{1} & =-{x}_{1}-{x}_{2} \\\\ {y}_{2} & =-{x}_{2}\\end{aligned}\n$$\n\nBy solving the second equation for ${x}_{2}$ and substituting it into the first equation, we obtain the following expressions for ${x}_{1}$ and ${x}_{2}:$\n\n$$\n\\begin{aligned}{x}_{1} & =-{y}_{1}+{y}_{2} \\\\ {x}_{2} & =-{y}_{2}\\end{aligned}\n$$\n\n \n\nNow, we substitute these into our quadratic form expression:\n\n$$\n\\begin{aligned}Q(x) & ={x}_{1}^{2}-2{x}_{1}{x}_{2}-4{x}_{2}^{2} \\\\  & =({y}_{2}-{y}_{1})^{2}-2({y}_{2}-{y}_{1})(-{y}_{2})-4(-{y}_{2})^{2} \\\\  & ={y}_{2}^{2}-2{y}_{1}{y}_{2}+{y}_{1}^{2}+2{y}_{2}^{2}-2{y}_{1}{y}_{2}-4{y}_{2}^{2} \\\\  & ={y}_{1}^{2}-4{y}_{1}{y}_{2}-{y}_{2}^{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186357684 :knowledge-point/_questions [{:db/id #edb/ref 17592186161992 :knowledge-point/id #uuid "9f2a5391-d8bb-5084-941a-bb787e8729f3" :knowledge-point/title "Changing Variables in a Quadratic Form Given New Variables Through Old Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03f4fffd-5cbf-5f13-a009-6a8c3ee18862" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{1}^{2}+2{y}_{1}{y}_{2}+{y}_{2}^{2}" :db/id #edb/ref 17592186354688} {:answer/id #uuid "0a72ac84-1557-5d06-b8bb-4c1cd30100b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7{y}_{1}^{2}-2{y}_{1}{y}_{2}-{y}_{2}^{2}" :db/id #edb/ref 17592186354762} {:answer/id #uuid "66bfabcf-b40a-5ffb-8568-22e940bed3cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{y}_{1}^{2}+2{y}_{1}{y}_{2}-{y}_{2}^{2}" :db/id #edb/ref 17592186355577} {:answer/id #uuid "c70178c9-5109-5db8-b7f6-205a69e2db58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6{y}_{1}^{2}-2{y}_{1}{y}_{2}+{y}_{2}^{2}" :db/id #edb/ref 17592186356407} {:answer/id #uuid "f27cbcb2-2f6f-55d2-af41-9cc74f52a379" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7{y}_{1}^{2}+2{y}_{1}{y}_{2}+{y}_{2}^{2}" :db/id #edb/ref 17592186356782}] :answer-field/correct {:answer/id #uuid "f27cbcb2-2f6f-55d2-af41-9cc74f52a379" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7{y}_{1}^{2}+2{y}_{1}{y}_{2}+{y}_{2}^{2}" :db/id #edb/ref 17592186356782} :answer-field/id #uuid "6d594336-7bd6-50d0-8093-6d8371f677a9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357109}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3578f27c-6253-5208-b109-aa341a946414" :question/math-academy-id "q-94178" :question/problem "Given that \n\n$$\n[\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}]=[\\begin{aligned}-1 & 0 \\\\ -2 & 1\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}],\n$$\n\n express the quadratic form $Q(x)={x}_{1}^{2}-6{x}_{1}{x}_{2}+{x}_{2}^{2}$ in terms of the components of $y.$" :question/worked-solution "First, notice that \n\n$$\n[\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}]=[\\begin{aligned}-1 & 0 \\\\ -2 & 1\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]\n$$\n\ngives the following expressions for ${y}_{1}$ and ${y}_{2}:$\n\n$$\n\\begin{aligned}{y}_{1} & =-{x}_{1} \\\\ {y}_{2} & =-2{x}_{1}+{x}_{2}\\end{aligned}\n$$\n\nBy solving the first equation for ${x}_{1}$ and substituting it into the second equation, we obtain the following expressions for ${x}_{1}$ and ${x}_{2}:$\n\n$$\n\\begin{aligned}{x}_{1} & =-{y}_{1} \\\\ {x}_{2} & =-2{y}_{1}+{y}_{2}\\end{aligned}\n$$\n\nNow, we substitute these into our quadratic form expression:\n\n$$\n\\begin{aligned}Q(x) & ={x}_{1}^{2}-6{x}_{1}{x}_{2}+{x}_{2}^{2} \\\\  & =(-{y}_{1})^{2}-6(-{y}_{1})(-2{y}_{1}+{y}_{2})+(-2{y}_{1}+{y}_{2})^{2} \\\\  & ={y}_{1}^{2}-12{y}_{1}^{2}+6{y}_{1}{y}_{2}+4{y}_{1}^{2}-4{y}_{1}{y}_{2}+{y}_{2}^{2} \\\\  & =-7{y}_{1}^{2}+2{y}_{1}{y}_{2}+{y}_{2}^{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186357685 :knowledge-point/_questions [{:db/id #edb/ref 17592186161993 :knowledge-point/id #uuid "331cb610-6168-5161-b821-237c713dedaa" :knowledge-point/title "Finding the Matrix of a Quadratic Form Given a Change-of-Coordinates Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25e8980a-6248-591d-b12e-5a266b01a3e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}47 & 30 \\\\ 30 & 19\\end{aligned}]" :db/id #edb/ref 17592186354983} {:answer/id #uuid "3ccc795a-5f78-5fb9-b241-d24a6301142a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 & 6 \\\\ 6 & 9\\end{aligned}]" :db/id #edb/ref 17592186355207} {:answer/id #uuid "8309baf8-4437-53a2-bf4b-92ad53e01376" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}12 & 20 \\\\ 20 & 11\\end{aligned}]" :db/id #edb/ref 17592186355818} {:answer/id #uuid "94887fe5-8f25-5ed2-bc10-a58187aa1441" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}27 & 20 \\\\ 20 & 9\\end{aligned}]" :db/id #edb/ref 17592186355974} {:answer/id #uuid "ac69d6d2-287b-5188-89f4-937786829e1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}27 & 15 \\\\ 15 & 10\\end{aligned}]" :db/id #edb/ref 17592186356190}] :answer-field/correct {:answer/id #uuid "25e8980a-6248-591d-b12e-5a266b01a3e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}47 & 30 \\\\ 30 & 19\\end{aligned}]" :db/id #edb/ref 17592186354983} :answer-field/id #uuid "0a9ef1a8-2d50-5a41-89ac-7f2956563ab2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186356936}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d1261eea-4133-5b5e-a7b1-592cd3d923cb" :question/math-academy-id "q-94183" :question/problem "$$\nA=[\\begin{aligned}-1 & 2 \\\\ 2 & 3\\end{aligned}],\\,P=[\\begin{aligned}2 & 1 \\\\ 3 & 2\\end{aligned}]\n$$\n\nConsider the matrices $A$ and $P$ above. Find the matrix of the quadratic form ${x}^{T}\\,Ax$ in the basis that consists of the columns of $P.$" :question/worked-solution "Recall that if $x=[{x}_{1},{x}_{2}]^{T}$ is a vector given by its coordinates in the standard basis and $y=[{y}_{1},{y}_{2}]^{T}$ is the same vector but given in the coordinates relative to the basis that consists of the columns of $P,$ then \n\n$$\nx=Py.\n$$\n\nAs a result, we have \n\n$$\n\\begin{aligned}{x}^{T}\\,Ax & =(Py)^{T}\\,A\\,(Py) \\\\  & =({y}^{T}{P}^{T})\\,A\\,(Py) \\\\  & ={y}^{T}({P}^{T}\\,AP)\\,y,\\end{aligned}\n$$\n\nwhich means that the matrix of our form in the new basis is\n\n$$\n\\begin{aligned}{P}^{T}\\,AP & ={[\\begin{aligned}2 & 1 \\\\ 3 & 2\\end{aligned}]}^{T}[\\begin{aligned}-1 & 2 \\\\ 2 & 3\\end{aligned}][\\begin{aligned}2 & 1 \\\\ 3 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 3 \\\\ 1 & 2\\end{aligned}][\\begin{aligned}-1 & 2 \\\\ 2 & 3\\end{aligned}][\\begin{aligned}2 & 1 \\\\ 3 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}4 & 13 \\\\ 3 & 8\\end{aligned}][\\begin{aligned}2 & 1 \\\\ 3 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}47 & 30 \\\\ 30 & 19\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186357687 :knowledge-point/_questions [{:db/id #edb/ref 17592186161993 :knowledge-point/id #uuid "331cb610-6168-5161-b821-237c713dedaa" :knowledge-point/title "Finding the Matrix of a Quadratic Form Given a Change-of-Coordinates Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d495c25-38bd-51da-99af-58f5dc907681" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 & -5 \\\\ -5 & 4\\end{aligned}]" :db/id #edb/ref 17592186354788} {:answer/id #uuid "1ceff76b-220b-50e3-a3eb-c8906c36cfdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 & 5 \\\\ 5 & -4\\end{aligned}]" :db/id #edb/ref 17592186354913} {:answer/id #uuid "979ae188-5b40-5cab-82c5-4fab109dec69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 3 \\\\ 3 & -4\\end{aligned}]" :db/id #edb/ref 17592186356001} {:answer/id #uuid "be00517f-c0f3-5ac4-a246-8086cd09dfcf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-5 & 4 \\\\ 4 & -5\\end{aligned}]" :db/id #edb/ref 17592186356327} {:answer/id #uuid "f596c681-03b4-569d-882b-7c843c3f78c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 & 5 \\\\ 5 & 4\\end{aligned}]" :db/id #edb/ref 17592186356805}] :answer-field/correct {:answer/id #uuid "1ceff76b-220b-50e3-a3e