[{"source" ":org/Math-Academy" "forms" [{:db/id 17592186184166 :knowledge-point/questions ["question-caaab3b2-6a76-5915-aacc-0fc605ea0da3" "question-b20bccf7-d7c5-5c00-be58-d20d6291b56b"] :db/ensure [:knowledge-point/validate]} {:db/id "question-caaab3b2-6a76-5915-aacc-0fc605ea0da3" :question/id #uuid "caaab3b2-6a76-5915-aacc-0fc605ea0da3" :question/math-academy-id "q-143052" :question/problem "Find the inverse of the function $f(x)=(x-1)^{2}-1$ for $x\\le 1.$" :question/worked-solution "To find the inverse of a function, we follow these steps:\n\n**Step 1:** Replace $f(x)$ with $y:$\n\n$$\ny=(x-1)^{2}-1\n$$\n\n**Step 2:** Swap $x$ and $y:$\n\n$$\nx=(y-1)^{2}-1\n$$\n\n**Step 3:** Solve for $y:$\n\n$$\n\\begin{aligned}x & =(y-1)^{2}-1 \\\\ x+1 & =(y-1)^{2} \\\\ -\\sqrt{x+1} & =y-1 \\\\ 1-\\sqrt{x+1} & =y\\end{aligned}\n$$\n\nNotice that we take the negative square root because if $x\\le 1$ is the domain of $f,$ then the range of the inverse is ${f}^{-1}\\le 1.$\n\n**Step 4:** Replace $y$ with ${f}^{-1}(x):$\n\n$$\n{f}^{-1}(x)=1-\\sqrt{x+1}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-819f5105-b28d-5bf8-9cd7-60f7aa0b0ec1"] :db/ensure [:question/validate]} {:db/id "answer-field-819f5105-b28d-5bf8-9cd7-60f7aa0b0ec1" :answer-field/id #uuid "819f5105-b28d-5bf8-9cd7-60f7aa0b0ec1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-53eaed6b-6aa4-562a-aab3-af6475171331" :answer-field/choices ["answer-025f66dd-3011-5e55-aae5-b34b60ea08e9" "answer-a53e62b0-bbf4-5fea-aa0b-8abca2956503" "answer-53eaed6b-6aa4-562a-aab3-af6475171331" "answer-9b7f44d1-93f2-5240-9fa1-def5a4f13f3f" "answer-49204445-d389-51e4-a1cb-413d980baa01"] :db/ensure [:answer-field/validate]} {:db/id "answer-025f66dd-3011-5e55-aae5-b34b60ea08e9" :answer/id #uuid "025f66dd-3011-5e55-aae5-b34b60ea08e9" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=-\\sqrt{x+1}-1" :db/ensure [:answer/validate]} {:db/id "answer-a53e62b0-bbf4-5fea-aa0b-8abca2956503" :answer/id #uuid "a53e62b0-bbf4-5fea-aa0b-8abca2956503" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=1-\\sqrt{1-x}" :db/ensure [:answer/validate]} {:db/id "answer-53eaed6b-6aa4-562a-aab3-af6475171331" :answer/id #uuid "53eaed6b-6aa4-562a-aab3-af6475171331" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=1-\\sqrt{x+1}" :db/ensure [:answer/validate]} {:db/id "answer-9b7f44d1-93f2-5240-9fa1-def5a4f13f3f" :answer/id #uuid "9b7f44d1-93f2-5240-9fa1-def5a4f13f3f" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=\\sqrt{x+1}-1" :db/ensure [:answer/validate]} {:db/id "answer-49204445-d389-51e4-a1cb-413d980baa01" :answer/id #uuid "49204445-d389-51e4-a1cb-413d980baa01" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=\\sqrt{x-1}-1" :db/ensure [:answer/validate]} {:db/id "question-b20bccf7-d7c5-5c00-be58-d20d6291b56b" :question/id #uuid "b20bccf7-d7c5-5c00-be58-d20d6291b56b" :question/math-academy-id "q-143064" :question/problem "Find the inverse of the function $f(x)=4x-{x}^{2}$ for $x\\le 2.$" :question/worked-solution "First, we complete the square:\n\n$$\n\\begin{aligned}f(x) & =4x-{x}^{2} \\\\  & =-({x}^{2}-4x) \\\\  & =-({x}^{2}-2\\cdot 2x) \\\\  & =-({x}^{2}-2\\cdot 2x+{2}^{2}-{2}^{2}) \\\\  & =-((x-2)^{2}-4) \\\\  & =-(x-2)^{2}+4\\end{aligned}\n$$\n\n    \n\nTo find the inverse of a function, we follow these steps:\n\n**Step 1:** Replace $f(x)$ with $y:$\n\n$$\ny=-(x-2)^{2}+4\n$$\n\n**Step 2:** Swap $x$ and $y:$\n\n$$\nx=-(y-2)^{2}+4\n$$\n\n**Step 3:** Solve for $y:$\n\n$$\n\\begin{aligned}x & =-(y-2)^{2}+4 \\\\ (y-2)^{2} & =4-x \\\\ y-2 & =-\\sqrt{4-x} \\\\ y & =2-\\sqrt{4-x}\\end{aligned}\n$$\n\nNote that we selected the negative square root because if the domain of $f(x)$ is $x\\le 2,$ then the range of ${f}^{-1}(x)$ is  ${f}^{-1}\\le 2.$\n\n**Step 4:** Replace $y$ with ${f}^{-1}(x):$\n\n$$\n{f}^{-1}(x)=2-\\sqrt{4-x}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-ed9666c1-5e34-582c-9b93-504bb7cbd0c8"] :db/ensure [:question/validate]} {:db/id "answer-field-ed9666c1-5e34-582c-9b93-504bb7cbd0c8" :answer-field/id #uuid "ed9666c1-5e34-582c-9b93-504bb7cbd0c8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-91fba2a5-b482-5819-b861-db09e2043b8c" :answer-field/choices ["answer-f223d43d-3c08-5604-b098-d99bfc1d2354" "answer-05aac994-88db-568b-9cbf-2dbfdadace6f" "answer-e99d7162-1345-52fc-886e-1bc5f9ed8f9b" "answer-91fba2a5-b482-5819-b861-db09e2043b8c" "answer-c30bd70e-dd61-5103-b57a-28c060535210"] :db/ensure [:answer-field/validate]} {:db/id "answer-f223d43d-3c08-5604-b098-d99bfc1d2354" :answer/id #uuid "f223d43d-3c08-5604-b098-d99bfc1d2354" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=-2-\\sqrt{x-4}" :db/ensure [:answer/validate]} {:db/id "answer-05aac994-88db-568b-9cbf-2dbfdadace6f" :answer/id #uuid "05aac994-88db-568b-9cbf-2dbfdadace6f" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=-4+\\sqrt{x-2}" :db/ensure [:answer/validate]} {:db/id "answer-e99d7162-1345-52fc-886e-1bc5f9ed8f9b" :answer/id #uuid "e99d7162-1345-52fc-886e-1bc5f9ed8f9b" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=2+\\sqrt{4-x}" :db/ensure [:answer/validate]} {:db/id "answer-91fba2a5-b482-5819-b861-db09e2043b8c" :answer/id #uuid "91fba2a5-b482-5819-b861-db09e2043b8c" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=2-\\sqrt{4-x}" :db/ensure [:answer/validate]} {:db/id "answer-c30bd70e-dd61-5103-b57a-28c060535210" :answer/id #uuid "c30bd70e-dd61-5103-b57a-28c060535210" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=4-\\sqrt{x-2}" :db/ensure [:answer/validate]} {:db/id 17592186184165 :knowledge-point/questions ["question-78fb1a6e-17a5-5dc5-a34e-f2b26dac2b07" "question-c0af0588-6d95-587e-b2d0-7c014fb9577c"] :db/ensure [:knowledge-point/validate]} {:db/id "question-78fb1a6e-17a5-5dc5-a34e-f2b26dac2b07" :question/id #uuid "78fb1a6e-17a5-5dc5-a34e-f2b26dac2b07" :question/math-academy-id "q-143082" :question/problem "Find the inverse of the function $f(x)={x}^{2}-6x+11$ for $x\\ge 3.$" :question/worked-solution "First, we complete the square:\n\n$$\n\\begin{aligned}f(x) & ={x}^{2}-6x+11 \\\\  & =({x}^{2}-2\\cdot 3x+{3}^{2})-{3}^{2}+11 \\\\  & =(x-3)^{2}-9+11 \\\\  & =(x-3)^{2}+2\\end{aligned}\n$$\n\n    \n\nTo find the inverse of a function, we follow these steps:\n\n**Step 1:** Replace $f(x)$ with $y$:\n\n$$\ny=(x-3)^{2}+2\n$$\n\n**Step 2:** Swap $x$ and $y$:\n\n$$\nx=(y-3)^{2}+2\n$$\n\n**Step 3:** Solve for $y$:\n\n$$\n\\begin{aligned}x & =(y-3)^{2}+2 \\\\ x-2 & =(y-3)^{2} \\\\ \\sqrt{x-2} & =y-3 \\\\ \\sqrt{x-2}+3 & =y\\end{aligned}\n$$\n\nNote that we selected the positive square root because if $x\\ge 3$ is the domain of $f,$ then the range of the inverse is ${f}^{-1}\\ge 3.$\n\n**Step 4:** Replace $y$ with ${f}^{-1}(x)$:\n\n$$\n{f}^{-1}(x)=\\sqrt{x-2}+3\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a20ac2fd-f0a8-56d0-b825-05933336bdb3"] :db/ensure [:question/validate]} {:db/id "answer-field-a20ac2fd-f0a8-56d0-b825-05933336bdb3" :answer-field/id #uuid "a20ac2fd-f0a8-56d0-b825-05933336bdb3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d473e132-faff-5175-a5a5-79d6fd719769" :answer-field/choices ["answer-08aff3cf-b8ed-59eb-99f2-cb7270e8f0fb" "answer-ee7a58a2-ee87-5b3f-8d20-0edcee658a3c" "answer-377abd5c-4b35-562a-a42f-6329c78c6e79" "answer-a23ab64c-ce2f-59c6-ac12-efb106c39e90" "answer-d473e132-faff-5175-a5a5-79d6fd719769"] :db/ensure [:answer-field/validate]} {:db/id "answer-08aff3cf-b8ed-59eb-99f2-cb7270e8f0fb" :answer/id #uuid "08aff3cf-b8ed-59eb-99f2-cb7270e8f0fb" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=\\sqrt{2-x}+3" :db/ensure [:answer/validate]} {:db/id "answer-ee7a58a2-ee87-5b3f-8d20-0edcee658a3c" :answer/id #uuid "ee7a58a2-ee87-5b3f-8d20-0edcee658a3c" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=\\sqrt{3-x}-2" :db/ensure [:answer/validate]} {:db/id "answer-377abd5c-4b35-562a-a42f-6329c78c6e79" :answer/id #uuid "377abd5c-4b35-562a-a42f-6329c78c6e79" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=\\sqrt{x+2}-3" :db/ensure [:answer/validate]} {:db/id "answer-a23ab64c-ce2f-59c6-ac12-efb106c39e90" :answer/id #uuid "a23ab64c-ce2f-59c6-ac12-efb106c39e90" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=\\sqrt{x+3}-2" :db/ensure [:answer/validate]} {:db/id "answer-d473e132-faff-5175-a5a5-79d6fd719769" :answer/id #uuid "d473e132-faff-5175-a5a5-79d6fd719769" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=\\sqrt{x-2}+3" :db/ensure [:answer/validate]} {:db/id 17592186184552 :question/problem "Find the inverse of the function $f(x)=4{x}^{2}+5$ for $x\\le 0.$\n\n${f}^{-1}(x)=$\n{{field-1}}" :question/worked-solution "To find the inverse of a function, we follow these steps:\n\n**Step 1:** Replace $f(x)$ with $y:$\n\n$$\ny=4{x}^{2}+5\n$$\n\n**Step 2:** Swap $x$ and $y:$\n\n$$\nx=4{y}^{2}+5\n$$\n\n**Step 3:** Solve for $y:$\n\n$$\n\\begin{aligned}x & =4{y}^{2}+5 \\\\ x-5 & =4{y}^{2} \\\\ \\frac{x-5}{4} & ={y}^{2} \\\\ -\\sqrt{\\frac{x-5}{4}} & =y \\\\ -\\frac{\\sqrt{x-5}}{2} & =y\\end{aligned}\n$$\n\nNotice that we take the negative square root because if $x\\le 0$ is the domain of $f,$ then the range of the inverse is ${f}^{-1}\\le 0.$\n\n**Step 4:** Replace $y$ with ${f}^{-1}(x):$\n\n$$\n{f}^{-1}(x)=-\\frac{\\sqrt{x-5}}{2}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186181475 :answer-field/correct "answer-42f7c904-e0c1-5b2b-8242-f862230b27db" :answer-field/choices ["answer-42f7c904-e0c1-5b2b-8242-f862230b27db"] :db/ensure [:answer-field/validate]} {:db/id "answer-42f7c904-e0c1-5b2b-8242-f862230b27db" :answer/id #uuid "42f7c904-e0c1-5b2b-8242-f862230b27db" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{x-5}}{2}" :db/ensure [:answer/validate]} {:db/id "question-c0af0588-6d95-587e-b2d0-7c014fb9577c" :question/id #uuid "c0af0588-6d95-587e-b2d0-7c014fb9577c" :question/math-academy-id "q-222060" :question/problem "Find the inverse of the function $f(x)=-{x}^{2}+22x-21$ for $x\\ge 11.$\n\n${f}^{-1}(x)=$\n{{field-1}}" :question/worked-solution "First, we complete the square:\n\n$$\n\\begin{aligned}f(x) & =-{x}^{2}+22x-21 \\\\  & =-({x}^{2}-22x)-21 \\\\  & =-({x}^{2}-2\\cdot 11x+{11}^{2}-{11}^{2})-21 \\\\  & =-((x-11)^{2}-121)-21 \\\\  & =-(x-11)^{2}+121-21 \\\\  & =-(x-11)^{2}+100\\end{aligned}\n$$\n\n    \n\nTo find the inverse of a function, we follow these steps:\n\n**Step 1:** Replace $f(x)$ with $y$:\n\n$$\ny=-(x-11)^{2}+100\n$$\n\n**Step 2:** Swap $x$ and $y$:\n\n$$\nx=-(y-11)^{2}+100\n$$\n\n**Step 3:** Solve for $y$:\n\n$$\n\\begin{aligned}x & =-(y-11)^{2}+100 \\\\ x-100 & =-(y-11)^{2} \\\\ 100-x & =(y-11)^{2} \\\\ \\sqrt{100-x} & =y-11 \\\\ \\sqrt{100-x}+11 & =y\\end{aligned}\n$$\n\nNote that we selected the positive square root because if $x\\ge 11$ is the domain of $f,$ then the range of the inverse is ${f}^{-1}\\ge 11.$\n\n**Step 4:** Replace $y$ with ${f}^{-1}(x)$:\n\n$$\n{f}^{-1}(x)=\\sqrt{100-x}+11\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-46fec1de-c8c1-5f33-bb64-7f9cf64038d2"] :db/ensure [:question/validate]} {:db/id "answer-field-46fec1de-c8c1-5f33-bb64-7f9cf64038d2" :answer-field/id #uuid "46fec1de-c8c1-5f33-bb64-7f9cf64038d2" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-eb40b884-5f15-5621-a10f-b2b960d38a63" :answer-field/choices ["answer-eb40b884-5f15-5621-a10f-b2b960d38a63"] :db/ensure [:answer-field/validate]} {:db/id "answer-eb40b884-5f15-5621-a10f-b2b960d38a63" :answer/id #uuid "eb40b884-5f15-5621-a10f-b2b960d38a63" :answer/type :answer.type/math :answer/value "11+\\sqrt{100-x}" :db/ensure [:answer/validate]} {:db/id "activity-e9f9e3dd-f40e-5d53-92c7-77648cd89ad8" :activity/id #uuid "e9f9e3dd-f40e-5d53-92c7-77648cd89ad8" :activity/title "Inverses of Quadratic Functions" :activity/type :activity.type/review :activity/scope 17592186048287 :activity/course 17592186046658 :activity/steps ["step-a988dbe1-422f-523a-82f6-a8083f4e41f1" "step-90f73ac7-ad91-597a-8979-0532f7ca1462" "step-96e63c67-e342-5798-aaf2-08996c9e6f0c" "step-e2137572-10e6-54e7-bb23-fe7fe045f843" "step-ea705f87-83a9-5956-a6e0-c33ee89d091f"] :activity/first-step "step-a988dbe1-422f-523a-82f6-a8083f4e41f1" :db/ensure [:activity/validate]} {:db/id "step-a988dbe1-422f-523a-82f6-a8083f4e41f1" :step/id #uuid "a988dbe1-422f-523a-82f6-a8083f4e41f1" :step/content "question-caaab3b2-6a76-5915-aacc-0fc605ea0da3" :step/next "step-90f73ac7-ad91-597a-8979-0532f7ca1462" :db/ensure [:step/validate]} {:db/id "step-90f73ac7-ad91-597a-8979-0532f7ca1462" :step/id #uuid "90f73ac7-ad91-597a-8979-0532f7ca1462" :step/content "question-b20bccf7-d7c5-5c00-be58-d20d6291b56b" :step/next "step-96e63c67-e342-5798-aaf2-08996c9e6f0c" :db/ensure [:step/validate]} {:db/id "step-96e63c67-e342-5798-aaf2-08996c9e6f0c" :step/id #uuid "96e63c67-e342-5798-aaf2-08996c9e6f0c" :step/content "question-78fb1a6e-17a5-5dc5-a34e-f2b26dac2b07" :step/next "step-e2137572-10e6-54e7-bb23-fe7fe045f843" :db/ensure [:step/validate]} {:db/id "step-e2137572-10e6-54e7-bb23-fe7fe045f843" :step/id #uuid "e2137572-10e6-54e7-bb23-fe7fe045f843" :step/content 17592186184552 :step/next "step-ea705f87-83a9-5956-a6e0-c33ee89d091f" :db/ensure [:step/validate]} {:db/id "step-ea705f87-83a9-5956-a6e0-c33ee89d091f" :step/id #uuid "ea705f87-83a9-5956-a6e0-c33ee89d091f" :step/content "question-c0af0588-6d95-587e-b2d0-7c014fb9577c" :db/ensure [:step/validate]}] "assertions" [["question-caaab3b2-6a76-5915-aacc-0fc605ea0da3" :question/id #uuid "caaab3b2-6a76-5915-aacc-0fc605ea0da3"] ["question-caaab3b2-6a76-5915-aacc-0fc605ea0da3" :question/math-academy-id "q-143052"] ["question-caaab3b2-6a76-5915-aacc-0fc605ea0da3" :question/problem "Find the inverse of the function $f(x)=(x-1)^{2}-1$ for $x\\le 1.$"] ["question-caaab3b2-6a76-5915-aacc-0fc605ea0da3" :question/worked-solution "To find the inverse of a function, we follow these steps:\n\n**Step 1:** Replace $f(x)$ with $y:$\n\n$$\ny=(x-1)^{2}-1\n$$\n\n**Step 2:** Swap $x$ and $y:$\n\n$$\nx=(y-1)^{2}-1\n$$\n\n**Step 3:** Solve for $y:$\n\n$$\n\\begin{aligned}x & =(y-1)^{2}-1 \\\\ x+1 & =(y-1)^{2} \\\\ -\\sqrt{x+1} & =y-1 \\\\ 1-\\sqrt{x+1} & =y\\end{aligned}\n$$\n\nNotice that we take the negative square root because if $x\\le 1$ is the domain of $f,$ then the range of the inverse is ${f}^{-1}\\le 1.$\n\n**Step 4:** Replace $y$ with ${f}^{-1}(x):$\n\n$$\n{f}^{-1}(x)=1-\\sqrt{x+1}\n$$"] ["question-caaab3b2-6a76-5915-aacc-0fc605ea0da3" :question/difficulty :question.difficulty/moderate] ["answer-field-819f5105-b28d-5bf8-9cd7-60f7aa0b0ec1" :answer-field/id #uuid "819f5105-b28d-5bf8-9cd7-60f7aa0b0ec1"] ["answer-025f66dd-3011-5e55-aae5-b34b60ea08e9" :answer/id #uuid "025f66dd-3011-5e55-aae5-b34b60ea08e9"] ["answer-025f66dd-3011-5e55-aae5-b34b60ea08e9" :answer/type :answer.type/math] ["answer-025f66dd-3011-5e55-aae5-b34b60ea08e9" :answer/value "{f}^{-1}(x)=-\\sqrt{x+1}-1"] ["answer-a53e62b0-bbf4-5fea-aa0b-8abca2956503" :answer/id #uuid "a53e62b0-bbf4-5fea-aa0b-8abca2956503"] ["answer-a53e62b0-bbf4-5fea-aa0b-8abca2956503" :answer/type :answer.type/math] ["answer-a53e62b0-bbf4-5fea-aa0b-8abca2956503" :answer/value "{f}^{-1}(x)=1-\\sqrt{1-x}"] ["answer-53eaed6b-6aa4-562a-aab3-af6475171331" :answer/id #uuid "53eaed6b-6aa4-562a-aab3-af6475171331"] ["answer-53eaed6b-6aa4-562a-aab3-af6475171331" :answer/type :answer.type/math] ["answer-53eaed6b-6aa4-562a-aab3-af6475171331" :answer/value "{f}^{-1}(x)=1-\\sqrt{x+1}"] ["answer-9b7f44d1-93f2-5240-9fa1-def5a4f13f3f" :answer/id #uuid "9b7f44d1-93f2-5240-9fa1-def5a4f13f3f"] ["answer-9b7f44d1-93f2-5240-9fa1-def5a4f13f3f" :answer/type :answer.type/math] ["answer-9b7f44d1-93f2-5240-9fa1-def5a4f13f3f" :answer/value "{f}^{-1}(x)=\\sqrt{x+1}-1"] ["answer-49204445-d389-51e4-a1cb-413d980baa01" :answer/id #uuid "49204445-d389-51e4-a1cb-413d980baa01"] ["answer-49204445-d389-51e4-a1cb-413d980baa01" :answer/type :answer.type/math] ["answer-49204445-d389-51e4-a1cb-413d980baa01" :answer/value "{f}^{-1}(x)=\\sqrt{x-1}-1"] ["answer-field-819f5105-b28d-5bf8-9cd7-60f7aa0b0ec1" :answer-field/key "selection"] ["answer-field-819f5105-b28d-5bf8-9cd7-60f7aa0b0ec1" :answer-field/type :answer-field.type/radio] ["answer-field-819f5105-b28d-5bf8-9cd7-60f7aa0b0ec1" :answer-field/correct "answer-53eaed6b-6aa4-562a-aab3-af6475171331"] ["answer-field-819f5105-b28d-5bf8-9cd7-60f7aa0b0ec1" :answer-field/choices "answer-025f66dd-3011-5e55-aae5-b34b60ea08e9"] ["answer-field-819f5105-b28d-5bf8-9cd7-60f7aa0b0ec1" :answer-field/choices "answer-a53e62b0-bbf4-5fea-aa0b-8abca2956503"] ["answer-field-819f5105-b28d-5bf8-9cd7-60f7aa0b0ec1" :answer-field/choices "answer-53eaed6b-6aa4-562a-aab3-af6475171331"] ["answer-field-819f5105-b28d-5bf8-9cd7-60f7aa0b0ec1" :answer-field/choices "answer-9b7f44d1-93f2-5240-9fa1-def5a4f13f3f"] ["answer-field-819f5105-b28d-5bf8-9cd7-60f7aa0b0ec1" :answer-field/choices "answer-49204445-d389-51e4-a1cb-413d980baa01"] ["question-caaab3b2-6a76-5915-aacc-0fc605ea0da3" :question/answer-fields "answer-field-819f5105-b28d-5bf8-9cd7-60f7aa0b0ec1"] [17592186184166 :knowledge-point/questions "question-caaab3b2-6a76-5915-aacc-0fc605ea0da3"] ["question-b20bccf7-d7c5-5c00-be58-d20d6291b56b" :question/id #uuid "b20bccf7-d7c5-5c00-be58-d20d6291b56b"] ["question-b20bccf7-d7c5-5c00-be58-d20d6291b56b" :question/math-academy-id "q-143064"] ["question-b20bccf7-d7c5-5c00-be58-d20d6291b56b" :question/problem "Find the inverse of the function $f(x)=4x-{x}^{2}$ for $x\\le 2.$"] ["question-b20bccf7-d7c5-5c00-be58-d20d6291b56b" :question/worked-solution "First, we complete the square:\n\n$$\n\\begin{aligned}f(x) & =4x-{x}^{2} \\\\  & =-({x}^{2}-4x) \\\\  & =-({x}^{2}-2\\cdot 2x) \\\\  & =-({x}^{2}-2\\cdot 2x+{2}^{2}-{2}^{2}) \\\\  & =-((x-2)^{2}-4) \\\\  & =-(x-2)^{2}+4\\end{aligned}\n$$\n\n    \n\nTo find the inverse of a function, we follow these steps:\n\n**Step 1:** Replace $f(x)$ with $y:$\n\n$$\ny=-(x-2)^{2}+4\n$$\n\n**Step 2:** Swap $x$ and $y:$\n\n$$\nx=-(y-2)^{2}+4\n$$\n\n**Step 3:** Solve for $y:$\n\n$$\n\\begin{aligned}x & =-(y-2)^{2}+4 \\\\ (y-2)^{2} & =4-x \\\\ y-2 & =-\\sqrt{4-x} \\\\ y & =2-\\sqrt{4-x}\\end{aligned}\n$$\n\nNote that we selected the negative square root because if the domain of $f(x)$ is $x\\le 2,$ then the range of ${f}^{-1}(x)$ is  ${f}^{-1}\\le 2.$\n\n**Step 4:** Replace $y$ with ${f}^{-1}(x):$\n\n$$\n{f}^{-1}(x)=2-\\sqrt{4-x}\n$$"] ["question-b20bccf7-d7c5-5c00-be58-d20d6291b56b" :question/difficulty :question.difficulty/hard] ["answer-field-ed9666c1-5e34-582c-9b93-504bb7cbd0c8" :answer-field/id #uuid "ed9666c1-5e34-582c-9b93-504bb7cbd0c8"] ["answer-f223d43d-3c08-5604-b098-d99bfc1d2354" :answer/id #uuid "f223d43d-3c08-5604-b098-d99bfc1d2354"] ["answer-f223d43d-3c08-5604-b098-d99bfc1d2354" :answer/type :answer.type/math] ["answer-f223d43d-3c08-5604-b098-d99bfc1d2354" :answer/value "{f}^{-1}(x)=-2-\\sqrt{x-4}"] ["answer-05aac994-88db-568b-9cbf-2dbfdadace6f" :answer/id #uuid "05aac994-88db-568b-9cbf-2dbfdadace6f"] ["answer-05aac994-88db-568b-9cbf-2dbfdadace6f" :answer/type :answer.type/math] ["answer-05aac994-88db-568b-9cbf-2dbfdadace6f" :answer/value "{f}^{-1}(x)=-4+\\sqrt{x-2}"] ["answer-e99d7162-1345-52fc-886e-1bc5f9ed8f9b" :answer/id #uuid "e99d7162-1345-52fc-886e-1bc5f9ed8f9b"] ["answer-e99d7162-1345-52fc-886e-1bc5f9ed8f9b" :answer/type :answer.type/math] ["answer-e99d7162-1345-52fc-886e-1bc5f9ed8f9b" :answer/value "{f}^{-1}(x)=2+\\sqrt{4-x}"] ["answer-91fba2a5-b482-5819-b861-db09e2043b8c" :answer/id #uuid "91fba2a5-b482-5819-b861-db09e2043b8c"] ["answer-91fba2a5-b482-5819-b861-db09e2043b8c" :answer/type :answer.type/math] ["answer-91fba2a5-b482-5819-b861-db09e2043b8c" :answer/value "{f}^{-1}(x)=2-\\sqrt{4-x}"] ["answer-c30bd70e-dd61-5103-b57a-28c060535210" :answer/id #uuid "c30bd70e-dd61-5103-b57a-28c060535210"] ["answer-c30bd70e-dd61-5103-b57a-28c060535210" :answer/type :answer.type/math] ["answer-c30bd70e-dd61-5103-b57a-28c060535210" :answer/value "{f}^{-1}(x)=4-\\sqrt{x-2}"] ["answer-field-ed9666c1-5e34-582c-9b93-504bb7cbd0c8" :answer-field/key "selection"] ["answer-field-ed9666c1-5e34-582c-9b93-504bb7cbd0c8" :answer-field/type :answer-field.type/radio] ["answer-field-ed9666c1-5e34-582c-9b93-504bb7cbd0c8" :answer-field/correct "answer-91fba2a5-b482-5819-b861-db09e2043b8c"] ["answer-field-ed9666c1-5e34-582c-9b93-504bb7cbd0c8" :answer-field/choices "answer-f223d43d-3c08-5604-b098-d99bfc1d2354"] ["answer-field-ed9666c1-5e34-582c-9b93-504bb7cbd0c8" :answer-field/choices "answer-05aac994-88db-568b-9cbf-2dbfdadace6f"] ["answer-field-ed9666c1-5e34-582c-9b93-504bb7cbd0c8" :answer-field/choices "answer-e99d7162-1345-52fc-886e-1bc5f9ed8f9b"] ["answer-field-ed9666c1-5e34-582c-9b93-504bb7cbd0c8" :answer-field/choices "answer-91fba2a5-b482-5819-b861-db09e2043b8c"] ["answer-field-ed9666c1-5e34-582c-9b93-504bb7cbd0c8" :answer-field/choices "answer-c30bd70e-dd61-5103-b57a-28c060535210"] ["question-b20bccf7-d7c5-5c00-be58-d20d6291b56b" :question/answer-fields "answer-field-ed9666c1-5e34-582c-9b93-504bb7cbd0c8"] [17592186184166 :knowledge-point/questions "question-b20bccf7-d7c5-5c00-be58-d20d6291b56b"] ["question-78fb1a6e-17a5-5dc5-a34e-f2b26dac2b07" :question/id #uuid "78fb1a6e-17a5-5dc5-a34e-f2b26dac2b07"] ["question-78fb1a6e-17a5-5dc5-a34e-f2b26dac2b07" :question/math-academy-id "q-143082"] ["question-78fb1a6e-17a5-5dc5-a34e-f2b26dac2b07" :question/problem "Find the inverse of the function $f(x)={x}^{2}-6x+11$ for $x\\ge 3.$"] ["question-78fb1a6e-17a5-5dc5-a34e-f2b26dac2b07" :question/worked-solution "First, we complete the square:\n\n$$\n\\begin{aligned}f(x) & ={x}^{2}-6x+11 \\\\  & =({x}^{2}-2\\cdot 3x+{3}^{2})-{3}^{2}+11 \\\\  & =(x-3)^{2}-9+11 \\\\  & =(x-3)^{2}+2\\end{aligned}\n$$\n\n    \n\nTo find the inverse of a function, we follow these steps:\n\n**Step 1:** Replace $f(x)$ with $y$:\n\n$$\ny=(x-3)^{2}+2\n$$\n\n**Step 2:** Swap $x$ and $y$:\n\n$$\nx=(y-3)^{2}+2\n$$\n\n**Step 3:** Solve for $y$:\n\n$$\n\\begin{aligned}x & =(y-3)^{2}+2 \\\\ x-2 & =(y-3)^{2} \\\\ \\sqrt{x-2} & =y-3 \\\\ \\sqrt{x-2}+3 & =y\\end{aligned}\n$$\n\nNote that we selected the positive square root because if $x\\ge 3$ is the domain of $f,$ then the range of the inverse is ${f}^{-1}\\ge 3.$\n\n**Step 4:** Replace $y$ with ${f}^{-1}(x)$:\n\n$$\n{f}^{-1}(x)=\\sqrt{x-2}+3\n$$"] ["question-78fb1a6e-17a5-5dc5-a34e-f2b26dac2b07" :question/difficulty :question.difficulty/easy] ["answer-field-a20ac2fd-f0a8-56d0-b825-05933336bdb3" :answer-field/id #uuid "a20ac2fd-f0a8-56d0-b825-05933336bdb3"] ["answer-08aff3cf-b8ed-59eb-99f2-cb7270e8f0fb" :answer/id #uuid "08aff3cf-b8ed-59eb-99f2-cb7270e8f0fb"] ["answer-08aff3cf-b8ed-59eb-99f2-cb7270e8f0fb" :answer/type :answer.type/math] ["answer-08aff3cf-b8ed-59eb-99f2-cb7270e8f0fb" :answer/value "{f}^{-1}(x)=\\sqrt{2-x}+3"] ["answer-ee7a58a2-ee87-5b3f-8d20-0edcee658a3c" :answer/id #uuid "ee7a58a2-ee87-5b3f-8d20-0edcee658a3c"] ["answer-ee7a58a2-ee87-5b3f-8d20-0edcee658a3c" :answer/type :answer.type/math] ["answer-ee7a58a2-ee87-5b3f-8d20-0edcee658a3c" :answer/value "{f}^{-1}(x)=\\sqrt{3-x}-2"] ["answer-377abd5c-4b35-562a-a42f-6329c78c6e79" :answer/id #uuid "377abd5c-4b35-562a-a42f-6329c78c6e79"] ["answer-377abd5c-4b35-562a-a42f-6329c78c6e79" :answer/type :answer.type/math] ["answer-377abd5c-4b35-562a-a42f-6329c78c6e79" :answer/value "{f}^{-1}(x)=\\sqrt{x+2}-3"] ["answer-a23ab64c-ce2f-59c6-ac12-efb106c39e90" :answer/id #uuid "a23ab64c-ce2f-59c6-ac12-efb106c39e90"] ["answer-a23ab64c-ce2f-59c6-ac12-efb106c39e90" :answer/type :answer.type/math] ["answer-a23ab64c-ce2f-59c6-ac12-efb106c39e90" :answer/value "{f}^{-1}(x)=\\sqrt{x+3}-2"] ["answer-d473e132-faff-5175-a5a5-79d6fd719769" :answer/id #uuid "d473e132-faff-5175-a5a5-79d6fd719769"] ["answer-d473e132-faff-5175-a5a5-79d6fd719769" :answer/type :answer.type/math] ["answer-d473e132-faff-5175-a5a5-79d6fd719769" :answer/value "{f}^{-1}(x)=\\sqrt{x-2}+3"] ["answer-field-a20ac2fd-f0a8-56d0-b825-05933336bdb3" :answer-field/key "selection"] ["answer-field-a20ac2fd-f0a8-56d0-b825-05933336bdb3" :answer-field/type :answer-field.type/radio] ["answer-field-a20ac2fd-f0a8-56d0-b825-05933336bdb3" :answer-field/correct "answer-d473e132-faff-5175-a5a5-79d6fd719769"] ["answer-field-a20ac2fd-f0a8-56d0-b825-05933336bdb3" :answer-field/choices "answer-08aff3cf-b8ed-59eb-99f2-cb7270e8f0fb"] ["answer-field-a20ac2fd-f0a8-56d0-b825-05933336bdb3" :answer-field/choices "answer-ee7a58a2-ee87-5b3f-8d20-0edcee658a3c"] ["answer-field-a20ac2fd-f0a8-56d0-b825-05933336bdb3" :answer-field/choices "answer-377abd5c-4b35-562a-a42f-6329c78c6e79"] ["answer-field-a20ac2fd-f0a8-56d0-b825-05933336bdb3" :answer-field/choices "answer-a23ab64c-ce2f-59c6-ac12-efb106c39e90"] ["answer-field-a20ac2fd-f0a8-56d0-b825-05933336bdb3" :answer-field/choices "answer-d473e132-faff-5175-a5a5-79d6fd719769"] ["question-78fb1a6e-17a5-5dc5-a34e-f2b26dac2b07" :question/answer-fields "answer-field-a20ac2fd-f0a8-56d0-b825-05933336bdb3"] [17592186184165 :knowledge-point/questions "question-78fb1a6e-17a5-5dc5-a34e-f2b26dac2b07"] [17592186184552 :question/problem "Find the inverse of the function $f(x)=4{x}^{2}+5$ for $x\\le 0.$\n\n${f}^{-1}(x)=$\n{{field-1}}"] [17592186184552 :question/worked-solution "To find the inverse of a function, we follow these steps:\n\n**Step 1:** Replace $f(x)$ with $y:$\n\n$$\ny=4{x}^{2}+5\n$$\n\n**Step 2:** Swap $x$ and $y:$\n\n$$\nx=4{y}^{2}+5\n$$\n\n**Step 3:** Solve for $y:$\n\n$$\n\\begin{aligned}x & =4{y}^{2}+5 \\\\ x-5 & =4{y}^{2} \\\\ \\frac{x-5}{4} & ={y}^{2} \\\\ -\\sqrt{\\frac{x-5}{4}} & =y \\\\ -\\frac{\\sqrt{x-5}}{2} & =y\\end{aligned}\n$$\n\nNotice that we take the negative square root because if $x\\le 0$ is the domain of $f,$ then the range of the inverse is ${f}^{-1}\\le 0.$\n\n**Step 4:** Replace $y$ with ${f}^{-1}(x):$\n\n$$\n{f}^{-1}(x)=-\\frac{\\sqrt{x-5}}{2}\n$$"] [17592186184552 :question/difficulty :question.difficulty/easy] ["answer-42f7c904-e0c1-5b2b-8242-f862230b27db" :answer/id #uuid "42f7c904-e0c1-5b2b-8242-f862230b27db"] ["answer-42f7c904-e0c1-5b2b-8242-f862230b27db" :answer/type :answer.type/math] ["answer-42f7c904-e0c1-5b2b-8242-f862230b27db" :answer/value "-\\frac{\\sqrt{x-5}}{2}"] [17592186181475 :answer-field/correct "answer-42f7c904-e0c1-5b2b-8242-f862230b27db"] [17592186181475 :answer-field/choices "answer-42f7c904-e0c1-5b2b-8242-f862230b27db"] ["question-c0af0588-6d95-587e-b2d0-7c014fb9577c" :question/id #uuid "c0af0588-6d95-587e-b2d0-7c014fb9577c"] ["question-c0af0588-6d95-587e-b2d0-7c014fb9577c" :question/math-academy-id "q-222060"] ["question-c0af0588-6d95-587e-b2d0-7c014fb9577c" :question/problem "Find the inverse of the function $f(x)=-{x}^{2}+22x-21$ for $x\\ge 11.$\n\n${f}^{-1}(x)=$\n{{field-1}}"] ["question-c0af0588-6d95-587e-b2d0-7c014fb9577c" :question/worked-solution "First, we complete the square:\n\n$$\n\\begin{aligned}f(x) & =-{x}^{2}+22x-21 \\\\  & =-({x}^{2}-22x)-21 \\\\  & =-({x}^{2}-2\\cdot 11x+{11}^{2}-{11}^{2})-21 \\\\  & =-((x-11)^{2}-121)-21 \\\\  & =-(x-11)^{2}+121-21 \\\\  & =-(x-11)^{2}+100\\end{aligned}\n$$\n\n    \n\nTo find the inverse of a function, we follow these steps:\n\n**Step 1:** Replace $f(x)$ with $y$:\n\n$$\ny=-(x-11)^{2}+100\n$$\n\n**Step 2:** Swap $x$ and $y$:\n\n$$\nx=-(y-11)^{2}+100\n$$\n\n**Step 3:** Solve for $y$:\n\n$$\n\\begin{aligned}x & =-(y-11)^{2}+100 \\\\ x-100 & =-(y-11)^{2} \\\\ 100-x & =(y-11)^{2} \\\\ \\sqrt{100-x} & =y-11 \\\\ \\sqrt{100-x}+11 & =y\\end{aligned}\n$$\n\nNote that we selected the positive square root because if $x\\ge 11$ is the domain of $f,$ then the range of the inverse is ${f}^{-1}\\ge 11.$\n\n**Step 4:** Replace $y$ with ${f}^{-1}(x)$:\n\n$$\n{f}^{-1}(x)=\\sqrt{100-x}+11\n$$"] ["question-c0af0588-6d95-587e-b2d0-7c014fb9577c" :question/difficulty :question.difficulty/hard] ["answer-field-46fec1de-c8c1-5f33-bb64-7f9cf64038d2" :answer-field/id #uuid "46fec1de-c8c1-5f33-bb64-7f9cf64038d2"] ["answer-eb40b884-5f15-5621-a10f-b2b960d38a63" :answer/id #uuid "eb40b884-5f15-5621-a10f-b2b960d38a63"] ["answer-eb40b884-5f15-5621-a10f-b2b960d38a63" :answer/type :answer.type/math] ["answer-eb40b884-5f15-5621-a10f-b2b960d38a63" :answer/value "11+\\sqrt{100-x}"] ["answer-field-46fec1de-c8c1-5f33-bb64-7f9cf64038d2" :answer-field/key "field-1"] ["answer-field-46fec1de-c8c1-5f33-bb64-7f9cf64038d2" :answer-field/type :answer-field.type/blank] ["answer-field-46fec1de-c8c1-5f33-bb64-7f9cf64038d2" :answer-field/correct "answer-eb40b884-5f15-5621-a10f-b2b960d38a63"] ["answer-field-46fec1de-c8c1-5f33-bb64-7f9cf64038d2" :answer-field/choices "answer-eb40b884-5f15-5621-a10f-b2b960d38a63"] ["question-c0af0588-6d95-587e-b2d0-7c014fb9577c" :question/answer-fields "answer-field-46fec1de-c8c1-5f33-bb64-7f9cf64038d2"] [17592186184165 :knowledge-point/questions "question-c0af0588-6d95-587e-b2d0-7c014fb9577c"] ["activity-e9f9e3dd-f40e-5d53-92c7-77648cd89ad8" :activity/id #uuid "e9f9e3dd-f40e-5d53-92c7-77648cd89ad8"] ["step-a988dbe1-422f-523a-82f6-a8083f4e41f1" :step/id #uuid "a988dbe1-422f-523a-82f6-a8083f4e41f1"] ["step-90f73ac7-ad91-597a-8979-0532f7ca1462" :step/id #uuid "90f73ac7-ad91-597a-8979-0532f7ca1462"] ["step-96e63c67-e342-5798-aaf2-08996c9e6f0c" :step/id #uuid "96e63c67-e342-5798-aaf2-08996c9e6f0c"] ["step-e2137572-10e6-54e7-bb23-fe7fe045f843" :step/id #uuid "e2137572-10e6-54e7-bb23-fe7fe045f843"] ["step-ea705f87-83a9-5956-a6e0-c33ee89d091f" :step/id #uuid "ea705f87-83a9-5956-a6e0-c33ee89d091f"] ["step-a988dbe1-422f-523a-82f6-a8083f4e41f1" :step/content "question-caaab3b2-6a76-5915-aacc-0fc605ea0da3"] ["step-a988dbe1-422f-523a-82f6-a8083f4e41f1" :step/next "step-90f73ac7-ad91-597a-8979-0532f7ca1462"] ["step-90f73ac7-ad91-597a-8979-0532f7ca1462" :step/content "question-b20bccf7-d7c5-5c00-be58-d20d6291b56b"] ["step-90f73ac7-ad91-597a-8979-0532f7ca1462" :step/next "step-96e63c67