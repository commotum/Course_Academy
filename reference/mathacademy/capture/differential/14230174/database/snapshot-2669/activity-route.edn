#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186552591} :activity/id #uuid "e9f9e3dd-f40e-5d53-92c7-77648cd89ad8" :activity/scope {:db/id #edb/ref 17592186048287 :topic/id #uuid "9128f088-7c43-5d28-a12d-6937728d8449" :topic/math-academy-id 3830} :activity/steps [{:db/id #edb/ref 17592186552579 :step/content {:db/id #edb/ref 17592186552491 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05aac994-88db-568b-9cbf-2dbfdadace6f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{f}^{-1}(x)=-4+\\sqrt{x-2}" :db/id #edb/ref 17592186551675} {:answer/id #uuid "91fba2a5-b482-5819-b861-db09e2043b8c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{f}^{-1}(x)=2-\\sqrt{4-x}" :db/id #edb/ref 17592186552020} {:answer/id #uuid "c30bd70e-dd61-5103-b57a-28c060535210" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{f}^{-1}(x)=4-\\sqrt{x-2}" :db/id #edb/ref 17592186552131} {:answer/id #uuid "e99d7162-1345-52fc-886e-1bc5f9ed8f9b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{f}^{-1}(x)=2+\\sqrt{4-x}" :db/id #edb/ref 17592186552212} {:answer/id #uuid "f223d43d-3c08-5604-b098-d99bfc1d2354" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{f}^{-1}(x)=-2-\\sqrt{x-4}" :db/id #edb/ref 17592186552230}] :answer-field/correct {:db/id #edb/ref 17592186552020} :answer-field/id #uuid "ed9666c1-5e34-582c-9b93-504bb7cbd0c8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186552392}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "b20bccf7-d7c5-5c00-be58-d20d6291b56b" :question/math-academy-id "q-143064" :question/problem "Find the inverse of the function $f(x)=4x-{x}^{2}$ for $x\\le 2.$" :question/worked-solution "First, we complete the square:\n\n$$\n\\begin{aligned}f(x) & =4x-{x}^{2} \\\\  & =-({x}^{2}-4x) \\\\  & =-({x}^{2}-2\\cdot 2x) \\\\  & =-({x}^{2}-2\\cdot 2x+{2}^{2}-{2}^{2}) \\\\  & =-((x-2)^{2}-4) \\\\  & =-(x-2)^{2}+4\\end{aligned}\n$$\n\n    \n\nTo find the inverse of a function, we follow these steps:\n\n**Step 1:** Replace $f(x)$ with $y:$\n\n$$\ny=-(x-2)^{2}+4\n$$\n\n**Step 2:** Swap $x$ and $y:$\n\n$$\nx=-(y-2)^{2}+4\n$$\n\n**Step 3:** Solve for $y:$\n\n$$\n\\begin{aligned}x & =-(y-2)^{2}+4 \\\\ (y-2)^{2} & =4-x \\\\ y-2 & =-\\sqrt{4-x} \\\\ y & =2-\\sqrt{4-x}\\end{aligned}\n$$\n\nNote that we selected the negative square root because if the domain of $f(x)$ is $x\\le 2,$ then the range of ${f}^{-1}(x)$ is  ${f}^{-1}\\le 2.$\n\n**Step 4:** Replace $y$ with ${f}^{-1}(x):$\n\n$$\n{f}^{-1}(x)=2-\\sqrt{4-x}\n$$"} :step/id #uuid "90f73ac7-ad91-597a-8979-0532f7ca1462" :step/next {:db/id #edb/ref 17592186552586}} {:db/id #edb/ref 17592186552586 :step/content {:db/id #edb/ref 17592186552461 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08aff3cf-b8ed-59eb-99f2-cb7270e8f0fb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{f}^{-1}(x)=\\sqrt{2-x}+3" :db/id #edb/ref 17592186551682} {:answer/id #uuid "377abd5c-4b35-562a-a42f-6329c78c6e79" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{f}^{-1}(x)=\\sqrt{x+2}-3" :db/id #edb/ref 17592186551797} {:answer/id #uuid "a23ab64c-ce2f-59c6-ac12-efb106c39e90" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{f}^{-1}(x)=\\sqrt{x+3}-2" :db/id #edb/ref 17592186552057} {:answer/id #uuid "d473e132-faff-5175-a5a5-79d6fd719769" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{f}^{-1}(x)=\\sqrt{x-2}+3" :db/id #edb/ref 17592186552167} {:answer/id #uuid "ee7a58a2-ee87-5b3f-8d20-0edcee658a3c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{f}^{-1}(x)=\\sqrt{3-x}-2" :db/id #edb/ref 17592186552223}] :answer-field/correct {:db/id #edb/ref 17592186552167} :answer-field/id #uuid "a20ac2fd-f0a8-56d0-b825-05933336bdb3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186552345}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "78fb1a6e-17a5-5dc5-a34e-f2b26dac2b07" :question/math-academy-id "q-143082" :question/problem "Find the inverse of the function $f(x)={x}^{2}-6x+11$ for $x\\ge 3.$" :question/worked-solution "First, we complete the square:\n\n$$\n\\begin{aligned}f(x) & ={x}^{2}-6x+11 \\\\  & =({x}^{2}-2\\cdot 3x+{3}^{2})-{3}^{2}+11 \\\\  & =(x-3)^{2}-9+11 \\\\  & =(x-3)^{2}+2\\end{aligned}\n$$\n\n    \n\nTo find the inverse of a function, we follow these steps:\n\n**Step 1:** Replace $f(x)$ with $y$:\n\n$$\ny=(x-3)^{2}+2\n$$\n\n**Step 2:** Swap $x$ and $y$:\n\n$$\nx=(y-3)^{2}+2\n$$\n\n**Step 3:** Solve for $y$:\n\n$$\n\\begin{aligned}x & =(y-3)^{2}+2 \\\\ x-2 & =(y-3)^{2} \\\\ \\sqrt{x-2} & =y-3 \\\\ \\sqrt{x-2}+3 & =y\\end{aligned}\n$$\n\nNote that we selected the positive square root because if $x\\ge 3$ is the domain of $f,$ then the range of the inverse is ${f}^{-1}\\ge 3.$\n\n**Step 4:** Replace $y$ with ${f}^{-1}(x)$:\n\n$$\n{f}^{-1}(x)=\\sqrt{x-2}+3\n$$"} :step/id #uuid "96e63c67-e342-5798-aaf2-08996c9e6f0c" :step/next {:db/id #edb/ref 17592186552614}} {:db/id #edb/ref 17592186552591 :step/content {:db/id #edb/ref 17592186552506 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "025f66dd-3011-5e55-aae5-b34b60ea08e9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{f}^{-1}(x)=-\\sqrt{x+1}-1" :db/id #edb/ref 17592186551668} {:answer/id #uuid "49204445-d389-51e4-a1cb-413d980baa01" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{f}^{-1}(x)=\\sqrt{x-1}-1" :db/id #edb/ref 17592186551842} {:answer/id #uuid "53eaed6b-6aa4-562a-aab3-af6475171331" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{f}^{-1}(x)=1-\\sqrt{x+1}" :db/id #edb/ref 17592186551864} {:answer/id #uuid "9b7f44d1-93f2-5240-9fa1-def5a4f13f3f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{f}^{-1}(x)=\\sqrt{x+1}-1" :db/id #edb/ref 17592186552040} {:answer/id #uuid "a53e62b0-bbf4-5fea-aa0b-8abca2956503" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{f}^{-1}(x)=1-\\sqrt{1-x}" :db/id #edb/ref 17592186552062}] :answer-field/correct {:db/id #edb/ref 17592186551864} :answer-field/id #uuid "819f5105-b28d-5bf8-9cd7-60f7aa0b0ec1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186552329}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "caaab3b2-6a76-5915-aacc-0fc605ea0da3" :question/math-academy-id "q-143052" :question/problem "Find the inverse of the function $f(x)=(x-1)^{2}-1$ for $x\\le 1.$" :question/worked-solution "To find the inverse of a function, we follow these steps:\n\n**Step 1:** Replace $f(x)$ with $y:$\n\n$$\ny=(x-1)^{2}-1\n$$\n\n**Step 2:** Swap $x$ and $y:$\n\n$$\nx=(y-1)^{2}-1\n$$\n\n**Step 3:** Solve for $y:$\n\n$$\n\\begin{aligned}x & =(y-1)^{2}-1 \\\\ x+1 & =(y-1)^{2} \\\\ -\\sqrt{x+1} & =y-1 \\\\ 1-\\sqrt{x+1} & =y\\end{aligned}\n$$\n\nNotice that we take the negative square root because if $x\\le 1$ is the domain of $f,$ then the range of the inverse is ${f}^{-1}\\le 1.$\n\n**Step 4:** Replace $y$ with ${f}^{-1}(x):$\n\n$$\n{f}^{-1}(x)=1-\\sqrt{x+1}\n$$"} :step/id #uuid "a988dbe1-422f-523a-82f6-a8083f4e41f1" :step/next {:db/id #edb/ref 17592186552579}} {:db/id #edb/ref 17592186552614 :step/content {:db/id #edb/ref 17592186184552 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42f7c904-e0c1-5b2b-8242-f862230b27db" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\sqrt{x-5}}{2}" :db/id #edb/ref 17592186551825}] :answer-field/correct {:db/id #edb/ref 17592186551825} :answer-field/id #uuid "10225b4c-8034-58a8-903e-67a062492652" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186181475}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "629de3ed-ef46-5ff0-bd91-8c4fa7e9f037" :question/math-academy-id "q-220374" :question/problem "Find the inverse of the function $f(x)=4{x}^{2}+5$ for $x\\le 0.$\n\n${f}^{-1}(x)=$\n{{field-1}}" :question/worked-solution "To find the inverse of a function, we follow these steps:\n\n**Step 1:** Replace $f(x)$ with $y:$\n\n$$\ny=4{x}^{2}+5\n$$\n\n**Step 2:** Swap $x$ and $y:$\n\n$$\nx=4{y}^{2}+5\n$$\n\n**Step 3:** Solve for $y:$\n\n$$\n\\begin{aligned}x & =4{y}^{2}+5 \\\\ x-5 & =4{y}^{2} \\\\ \\frac{x-5}{4} & ={y}^{2} \\\\ -\\sqrt{\\frac{x-5}{4}} & =y \\\\ -\\frac{\\sqrt{x-5}}{2} & =y\\end{aligned}\n$$\n\nNotice that we take the negative square root because if $x\\le 0$ is the domain of $f,$ then the range of the inverse is ${f}^{-1}\\le 0.$\n\n**Step 4:** Replace $y$ with ${f}^{-1}(x):$\n\n$$\n{f}^{-1}(x)=-\\frac{\\sqrt{x-5}}{2}\n$$"} :step/id #uuid "e2137572-10e6-54e7-bb23-fe7fe045f843" :step/next {:db/id #edb/ref 17592186552615}} {:db/id #edb/ref 17592186552615 :step/content {:db/id #edb/ref 17592186552501 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eb40b884-5f15-5621-a10f-b2b960d38a63" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11+\\sqrt{100-x}" :db/id #edb/ref 17592186552215}] :answer-field/correct {:db/id #edb/ref 17592186552215} :answer-field/id #uuid "46fec1de-c8c1-5f33-bb64-7f9cf64038d2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186552293}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c0af0588-6d95-587e-b2d0-7c014fb9577c" :question/math-academy-id "q-222060" :question/problem "Find the inverse of the function $f(x)=-{x}^{2}+22x-21$ for $x\\ge 11.$\n\n${f}^{-1}(x)=$\n{{field-1}}" :question/worked-solution "First, we complete the square:\n\n$$\n\\begin{aligned}f(x) & =-{x}^{2}+22x-21 \\\\  & =-({x}^{2}-22x)-21 \\\\  & =-({x}^{2}-2\\cdot 11x+{11}^{2}-{11}^{2})-21 \\\\  & =-((x-11)^{2}-121)-21 \\\\  & =-(x-11)^{2}+121-21 \\\\  & =-(x-11)^{2}+100\\end{aligned}\n$$\n\n    \n\nTo find the inverse of a function, we follow these steps:\n\n**Step 1:** Replace $f(x)$ with $y$:\n\n$$\ny=-(x-11)^{2}+100\n$$\n\n**Step 2:** Swap $x$ and $y$:\n\n$$\nx=-(y-11)^{2}+100\n$$\n\n**Step 3:** Solve for $y$:\n\n$$\n\\begin{aligned}x & =-(y-11)^{2}+100 \\\\ x-100 & =-(y-11)^{2} \\\\ 100-x & =(y-11)^{2} \\\\ \\sqrt{100-x} & =y-11 \\\\ \\sqrt{100-x}+11 & =y\\end{aligned}\n$$\n\nNote that we selected the positive square root because if $x\\ge 11$ is the domain of $f,$ then the range of the inverse is ${f}^{-1}\\ge 11.$\n\n**Step 4:** Replace $y$ with ${f}^{-1}(x)$:\n\n$$\n{f}^{-1}(x)=\\sqrt{100-x}+11\n$$"} :step/id #uuid "ea705f87-83a9-5956-a6e0-c33ee89d091f"}] :activity/title "Inverses of Quadratic Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186551663}]}
