/ref 17592186045417] [17592186124638 #edb/ref 1038 #edb/ref 17592186378822 #edb/ref 17592186045417] [17592186124638 #edb/ref 1038 #edb/ref 17592186435810 #edb/ref 17592186045417] [17592186124638 #edb/ref 1039 "Evaluating a Two-Variable Function" #edb/ref 17592186045417] [17592186124638 #edb/ref 1041 #edb/ref 17592186124196 #edb/ref 17592186045417] [17592186124638 #edb/ref 1042 #uuid "f9289c4d-4f7f-5704-a2cb-272f92d8fef3" #edb/ref 17592186045417] [17592186124640 #edb/ref 1037 #edb/ref 17592186048794 #edb/ref 17592186045417] [17592186124640 #edb/ref 1037 #edb/ref 17592186049984 #edb/ref 17592186045417] [17592186124640 #edb/ref 1037 #edb/ref 17592186050064 #edb/ref 17592186045417] [17592186124640 #edb/ref 1037 #edb/ref 17592186050829 #edb/ref 17592186045417] [17592186124640 #edb/ref 1038 #edb/ref 17592186124797 #edb/ref 17592186045417] [17592186124640 #edb/ref 1038 #edb/ref 17592186124798 #edb/ref 17592186045417] [17592186124640 #edb/ref 1038 #edb/ref 17592186124808 #edb/ref 17592186045417] [17592186124640 #edb/ref 1038 #edb/ref 17592186278210 #edb/ref 17592186045417] [17592186124640 #edb/ref 1038 #edb/ref 17592186278212 #edb/ref 17592186045417] [17592186124640 #edb/ref 1038 #edb/ref 17592186278214 #edb/ref 17592186045417] [17592186124640 #edb/ref 1038 #edb/ref 17592186378794 #edb/ref 17592186045417] [17592186124640 #edb/ref 1038 #edb/ref 17592186378808 #edb/ref 17592186045417] [17592186124640 #edb/ref 1038 #edb/ref 17592186378815 #edb/ref 17592186045417] [17592186124640 #edb/ref 1038 #edb/ref 17592186401123 #edb/ref 17592186045417] [17592186124640 #edb/ref 1038 #edb/ref 17592186435806 #edb/ref 17592186045417] [17592186124640 #edb/ref 1038 #edb/ref 17592186435807 #edb/ref 17592186045417] [17592186124640 #edb/ref 1039 "The Domain of a Function Containing Exponential, Logarithmic, and Trigonometric Functions" #edb/ref 17592186045417] [17592186124640 #edb/ref 1041 #edb/ref 17592186124198 #edb/ref 17592186045417] [17592186124640 #edb/ref 1042 #uuid "88f2bc84-03e8-5921-81e2-683a09195279" #edb/ref 17592186045417] [17592186124701 #edb/ref 1043 #edb/ref 17592186125608 #edb/ref 17592186045417] [17592186124701 #edb/ref 1043 #edb/ref 17592186125609 #edb/ref 17592186045417] [17592186124701 #edb/ref 1043 #edb/ref 17592186125610 #edb/ref 17592186045417] [17592186124701 #edb/ref 1043 #edb/ref 17592186125611 #edb/ref 17592186045417] [17592186124701 #edb/ref 1043 #edb/ref 17592186125614 #edb/ref 17592186045417] [17592186124701 #edb/ref 1043 #edb/ref 17592186125620 #edb/ref 17592186045417] [17592186124701 #edb/ref 1043 #edb/ref 17592186125621 #edb/ref 17592186045417] [17592186124701 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186124701 #edb/ref 1045 "The Domain of a Multivariable Function" #edb/ref 17592186045417] [17592186124701 #edb/ref 1046 #edb/ref 17592186125620 #edb/ref 17592186045417] [17592186124701 #edb/ref 1049 #edb/ref 17592186050992 #edb/ref 17592186045417] [17592186124701 #edb/ref 1050 540.0 #edb/ref 17592186045417] [17592186124701 #edb/ref 1053 #uuid "38eb3394-b723-5b5e-b0fc-8803e6b62fac" #edb/ref 17592186045417] [17592186124800 #edb/ref 1068 #edb/ref 17592186274849 #edb/ref 17592186045417] [17592186124800 #edb/ref 1069 "q-158195" #edb/ref 17592186045417] [17592186124800 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186124800 #edb/ref 1071 "Which of the following shaded regions corresponds to the domain of the function $f(x,y)=\\sqrt{{x}^{2}+{y}^{2}-1}?$" #edb/ref 17592186045417] [17592186124800 #edb/ref 1072 #uuid "76db17ba-163a-5fe3-9bd7-63e519e3eab2" #edb/ref 17592186045417] [17592186124800 #edb/ref 1074 "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The expression under the square root is non-negative.\n\nAs a result, the points in the domain must satisfy the following inequalities:\n\n$$\n{x}^{2}+{y}^{2}-1\\ge 0\\,⟹\\,{x}^{2}+{y}^{2}\\ge 1\n$$\n\nTherefore, the domain is\n\n$$\nD=\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}\\ge 1\\}.\n$$\n\nSince the inequality involves the $\\ge $ sign, the curve ${x}^{2}+{y}^{2}=1$ is part of the domain. Therefore, we draw a solid curve ${x}^{2}+{y}^{2}=1$ and shade the area *outside* the curve.\n\nThe resulting domain is as follows:\n\n![](images/ba/ba31bbc16c58860a4bc3c4d33ea1a61cb3d86d0e73d8aa6a67869b3e96a7fe32.png)" #edb/ref 17592186045417] [17592186125608 #edb/ref 1058 #edb/ref 17592186125609 #edb/ref 17592186045417] [17592186125608 #edb/ref 1061 41878 #edb/ref 17592186045417] [17592186125608 #edb/ref 1062 #uuid "fc31f470-ef05-57c5-83e5-74d5c5660924" #edb/ref 17592186045417] [17592186125608 #edb/ref 1063 #edb/ref 17592186125865 #edb/ref 17592186045417] [17592186125609 #edb/ref 1058 #edb/ref 17592186125614 #edb/ref 17592186045417] [17592186125609 #edb/ref 1061 41879 #edb/ref 17592186045417] [17592186125609 #edb/ref 1062 #uuid "7be0d289-aa76-565b-b554-0640ab33fae2" #edb/ref 17592186045417] [17592186125609 #edb/ref 1063 #edb/ref 17592186124636 #edb/ref 17592186045417] [17592186125610 #edb/ref 1061 41882 #edb/ref 17592186045417] [17592186125610 #edb/ref 1062 #uuid "a7e9f458-f87e-5aa2-a10b-9d3c56318005" #edb/ref 17592186045417] [17592186125610 #edb/ref 1063 #edb/ref 17592186124637 #edb/ref 17592186045417] [17592186125611 #edb/ref 1058 #edb/ref 17592186125621 #edb/ref 17592186045417] [17592186125611 #edb/ref 1061 41892 #edb/ref 17592186045417] [17592186125611 #edb/ref 1062 #uuid "7cb633e3-6b78-502b-8402-00d3cc9b88b4" #edb/ref 17592186045417] [17592186125611 #edb/ref 1063 #edb/ref 17592186124638 #edb/ref 17592186045417] [17592186125614 #edb/ref 1058 #edb/ref 17592186125610 #edb/ref 17592186045417] [17592186125614 #edb/ref 1061 41906 #edb/ref 17592186045417] [17592186125614 #edb/ref 1062 #uuid "b55f77a9-8540-5fb3-b460-fd3dba21c5e1" #edb/ref 17592186045417] [17592186125614 #edb/ref 1063 #edb/ref 17592186124640 #edb/ref 17592186045417] [17592186125620 #edb/ref 1058 #edb/ref 17592186125611 #edb/ref 17592186045417] [17592186125620 #edb/ref 1061 42402 #edb/ref 17592186045417] [17592186125620 #edb/ref 1062 #uuid "8bf79d7f-8d55-5330-9913-9bcd94008524" #edb/ref 17592186045417] [17592186125620 #edb/ref 1063 #edb/ref 17592186125868 #edb/ref 17592186045417] [17592186125621 #edb/ref 1058 #edb/ref 17592186125608 #edb/ref 17592186045417] [17592186125621 #edb/ref 1061 42403 #edb/ref 17592186045417] [17592186125621 #edb/ref 1062 #uuid "177400d3-2550-582c-ad75-57483a6bbe30" #edb/ref 17592186045417] [17592186125621 #edb/ref 1063 #edb/ref 17592186125869 #edb/ref 17592186045417] [17592186125865 #edb/ref 1064 "Another way of visualizing a two-variable function is to draw its graph as a **surface** in a three-dimensional coordinate system. \n\nFor example, consider the function\n\n$$\nz = f(x,y) = x^2 +y^2, \\quad (x,y)\\in D\n$$\n\nwhere the (restricted) domain is given by the unit disc \n\n$$\nD = \\big\\{ (x,y)\\in\\mathbb R^2 \\: : \\: x^2+y^2 \\leq 1 \\big\\}.\n$$\n\nThe graph of $f$ is a surface that consists of all the points with coordinates\n\n$$\n(x, \\, y, \\, f(x,y)), \\quad (x,y) \\in D,\n$$\n\nas shown below.\n\n![](images/a3/a3c9c7eca49a0f828e53c0775afac16335033c1a8881367e49098bf7125ee2e6.png)\n\n  \n\nNotice that range of $f$ is represented by the interval $R=[0,1]$ on the vertical $z$-axis. It consists of the possible $z$-coordinates of the points on our surface." #edb/ref 17592186045417] [17592186125865 #edb/ref 1065 6920 #edb/ref 17592186045417] [17592186125865 #edb/ref 1066 #uuid "9bf49e76-e25e-5191-ad7f-95028f749c37" #edb/ref 17592186045417] [17592186125865 #edb/ref 1067 "The Graph of a Two-Variable Function" #edb/ref 17592186045417] [17592186125868 #edb/ref 1064 "A function $f(x,y)$ of two variables is a rule that maps each pair of numbers $(x,y)\\in D$ to a unique real number. Under this notation, $D\\subseteq \\mathbb R^2$ is the **domain** of $f.$\n\nFor instance, consider the following two-variable function: \n\n$$\nf(x,y) = \\dfrac{\\sin(xy)}{\\sqrt{x-1}}\n$$\n\nWe can evaluate this function by substituting concrete pairs of numbers for $x$ and $y{:}$\n\n- Let's evaluate $f(x,y)$ at the point $(2, \\pi).$ To do that, we substitute $x=2$ and $y=\\pi$ into the function expression: \n\n$$\n\\begin{aligned}f(2,\\pi ) & =\\frac{\\operatorname{sin}⁡(xy)}{\\sqrt{x-1}}{|}_{(2,\\pi )} \\\\  & =\\frac{\\operatorname{sin}⁡(2\\cdot \\pi )}{\\sqrt{2-1}} \\\\  & =\\frac{0}{1} \\\\  & =0\\end{aligned}\n$$\n\nSince $f(2,\\pi)$ returned a unique real number, this means that $(2,\\pi)$ belongs to the domain of $f,$ i.e., $(2,\\pi)\\in D.$\n\n- Let's now try to evaluate $f(x,y)$ at the point $(0, \\pi).$ To do that, we substitute $x=0$ and $y=\\pi$ into the function expression: \n\n$$\n\\begin{aligned}f(0,\\pi ) & =\\frac{\\operatorname{sin}⁡(xy)}{\\sqrt{x-1}}{|}_{(0,\\pi )} \\\\  & =\\frac{\\operatorname{sin}⁡(0\\cdot \\pi )}{\\sqrt{0-1}} \\\\  & =\\frac{0}{\\sqrt{-1}}\\end{aligned}\n$$\n\nwhich is undefined over the real numbers.\n\nSince $f(0,\\pi)$ did not return a unique *real* number, this means that $(0,\\pi)\\notin D.$\n\nWe can also have functions of three variables $f(x,y,z),$ functions of four variables, $f(x_1,x_2,x_3,x_4),$ etc. There is no limit to the number of variables a function can have. Functions with more than one variable are called **multivariable functions.**" #edb/ref 17592186045417] [17592186125868 #edb/ref 1065 7034 #edb/ref 17592186045417] [17592186125868 #edb/ref 1066 #uuid "8d127fec-12ff-5644-b095-33e9b94a52d1" #edb/ref 17592186045417] [17592186125868 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186125869 #edb/ref 1064 "The **domain** of a multivariable function is the set of points where the function is defined. \n\nFor example, consider the function \n\n$$\nz = f(x,y) =  \\sqrt{1 -x^2 -y^2}.\n$$\n\nThe function is well-defined at all points $(x,y)$ for which the expression under the square root is non-negative. As a result, the points in the domain must satisfy the following inequality:\n\n$$\n1 - x^2 - y^2 \\geq 0 \n\\qquad\\Longrightarrow\\qquad\nx^2 + y^2 \\leq 1\n$$\n\nTherefore, the domain is\n\n$$\nD = \\big\\{ (x,y)\\in\\mathbb R^2 \\,:\\, x^2 + y^2 \\leq 1 \\big\\}.\n$$\n\nGeometrically, the domain of our function is a disc of radius $1$ centered at the origin in the $xy$-plane, as shown on the left diagram below.\n\n![](images/86/8642db9fd933ec2f15c6712c713cfaec8fb20052066dcca3915904190d3551fa.png)\n\nEach point in this domain is uniquely mapped to a real number $z.$ Possible values of $z$ can be visualized on a separate axis (depicted by the diagram on the right). \n\nIf $(x,y)$ is allowed to run over the entire domain, the set of points on the $z$-axis where the values of $f(x,y)$ land is called the **range** of the function. For this function, the range is $z\\in [0,1].$\n\nNote the following:\n\n- When discussing a function's domain, we usually refer to the so-called **natural domain**, the largest set of values for which the function is defined.\n\n- We can also *restrict* the domain of a function to a subset of the natural domain. For example, we might restrict the domain of $f$ to all values of $y$ in the upper-half plane. In this case, we'd write\n\n$$\nf(x,y) =  \\sqrt{1 -x^2 -y^2}, \\quad (x,y)\\in D, \\quad D = \\big\\{ (x,y)\\in\\mathbb R^2 \\,:\\, x^2 + y^2 \\leq 1, \\: y\\geq 0 \\big\\}.\n$$\n\nThis gives a domain/range diagram that looks as follows.\n\n![](images/fb/fbab832d984232b0b3b951579e5ee2727e92c9f4bf496d4fffe82f7230cfbb14.png)\n\nIn this case, restricting the domain does not affect the range. However, in general, restricting the domain *will* affect the range." #edb/ref 17592186045417] [17592186125869 #edb/ref 1065 7035 #edb/ref 17592186045417] [17592186125869 #edb/ref 1066 #uuid "d81a3bfc-ca0f-528c-ad48-e606581c6d6c" #edb/ref 17592186045417] [17592186125869 #edb/ref 1067 "The Domain and Range of a Two-Variable Function" #edb/ref 17592186045417] [17592186272390 #edb/ref 1080 "{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}<0}" #edb/ref 17592186045417] [17592186272390 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186272390 #edb/ref 1083 #uuid "00bacbcd-590d-557f-a9f4-6a4269e68310" #edb/ref 17592186045417] [17592186272736 #edb/ref 1080 "images/b7/b7cf0f04bb0ac9373b222edef23d2925ea40d06fafa33f03423220f99de7d95f.png" #edb/ref 17592186045417] [17592186272736 #edb/ref 1082 #edb/ref 17592186045497 #edb/ref 17592186045417] [17592186272736 #edb/ref 1083 #uuid "276ef443-515a-5fc5-811c-9fd1a1c9389d" #edb/ref 17592186045417] [17592186273070 #edb/ref 1080 "images/1c/1c1d7ca7d9fdcaa8baeded0408339b29130810c07fb90b27ebc0674f9bffa275.png" #edb/ref 17592186045417] [17592186273070 #edb/ref 1082 #edb/ref 17592186045497 #edb/ref 17592186045417] [17592186273070 #edb/ref 1083 #uuid "50a009e0-93df-51e7-920e-e0763fa10bd8" #edb/ref 17592186045417] [17592186273075 #edb/ref 1080 "images/7a/7afd18ecf16e868bb65e43626144251a1387d3dbbac8ec552ab1f8544b35d6fe.png" #edb/ref 17592186045417] [17592186273075 #edb/ref 1082 #edb/ref 17592186045497 #edb/ref 17592186045417] [17592186273075 #edb/ref 1083 #uuid "510a0b87-4b2e-5a08-98ae-86d141d6ee14" #edb/ref 17592186045417] [17592186273282 #edb/ref 1080 "images/48/488ae413d28377a5dcd8887003e5389c082189867c0d3cdf0564d4a2f351ed56.png" #edb/ref 17592186045417] [17592186273282 #edb/ref 1082 #edb/ref 17592186045497 #edb/ref 17592186045417] [17592186273282 #edb/ref 1083 #uuid "67c03a35-d64e-56cc-b238-c85ee6143494" #edb/ref 17592186045417] [17592186273476 #edb/ref 1080 "{(x,y)\\in {R}^{2}\\,:\\,-1\\le x-y\\le 1}" #edb/ref 17592186045417] [17592186273476 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186273476 #edb/ref 1083 #uuid "7ed55f36-0c59-534d-95e8-07b34cf2dc0d" #edb/ref 17592186045417] [17592186273604 #edb/ref 1080 "{(x,y)\\in {R}^{2}\\,:\\,-\\frac{\\pi }{2}\\le x-y\\le \\frac{\\pi }{2}}" #edb/ref 17592186045417] [17592186273604 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186273604 #edb/ref 1083 #uuid "8cbe26d2-a7ea-57c3-b47a-0b429892c77c" #edb/ref 17592186045417] [1