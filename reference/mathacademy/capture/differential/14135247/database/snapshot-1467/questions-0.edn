#{[{:db/id #edb/ref 17592186124194 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186124636 :knowledge-point/id #uuid "0e593685-f5ca-5501-94bf-7cb4d49e935b" :knowledge-point/title "The Domain of a Function Involving Reciprocals and Radicals"}] :question/id #uuid "a2c947c7-9873-5137-91ca-4fe0b42e9bb7" :question/math-academy-id "e-11021" :question/problem "Find the domain of the function $z = \\dfrac {\\sqrt {y+1}}{x+y}.$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following conditions are satisfied:\n\n- The expression in the denominator is not equal to zero, and\n\n- the expression under the square root is non-negative.\n\nAs a result, the points in the domain must satisfy the following inequalities:\n\n![](images/06/06aff1dae72b170f576a5f2840bed4c57d199b429ec3bf2cc83c6754566bd06c.png)\n\nTherefore, the domain is\n\n$$\n\\big\\{ (x,y)\\in\\mathbb R^2 \\,:\\, y \\geq -1, \\: y \\neq -x \\big\\}.\n$$"}] [{:db/id #edb/ref 17592186124195 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186124637 :knowledge-point/id #uuid "9e4fd256-a726-523c-84dc-f62d4e2711cc" :knowledge-point/title "Sketching the Domain of a Multivariable Function"}] :question/id #uuid "42cbeba7-685e-5782-9695-9671d16b7f80" :question/math-academy-id "e-11022" :question/problem "Sketch the domain of $g(x,y)=\\dfrac{1}{\\ln(x+y)}.$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following conditions are satisfied:\n\n- The expression under the logarithm is positive, and\n\n- the expression in the denominator is not equal to zero.\n\nAs a result, the points in the domain must satisfy the following inequalities:\n\n![](images/ca/caea647efe2231b9293d9f813772c79929229dbc472a2c04c4fb455a343473b5.png)\n\nTherefore, the domain is\n\n$$\nD = \\left \\{ (x,y)\\in\\mathbb R^2 \\, : \\, y \\gt -x, \\, y \\neq 1-x \\right \\}.\n$$\n\nNow, we plot the corresponding domain. \n\n- Starting with $y> -x,$ we draw a dashed line $y=-x$ and shade the region *above* the line.\n\n- Then, we draw a dashed line $y=1-x$ through the shaded region.\n\nThe resulting domain is as follows:\n\n![](images/6a/6aa1aaeadb177cf5a80bcb12a247725cb3396586e7516c3ba30b46b03a9d2612.png)"}] [{:db/id #edb/ref 17592186124196 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186124638 :knowledge-point/id #uuid "f9289c4d-4f7f-5704-a2cb-272f92d8fef3" :knowledge-point/title "Evaluating a Two-Variable Function"}] :question/id #uuid "59fa0287-0562-5cf2-8469-946a69dc8adf" :question/math-academy-id "e-11025" :question/problem "The function $f(x,y)$ is defined as \n\n$$\nf(x,y) = y^2 - \\log_3(x - 7).\n$$\n\nEvaluate this function at the point $(10,3).$" :question/worked-solution "To evaluate our multivariable function at the point $(10,3),$ we substitute $x = 10$ and $y = 3$ into the function expression:\n\n$$\n\\begin{aligned}f(10,3) & =({y}^{2}-{log}_{3}⁡(x-7)){|}_{(10,3)} \\\\  & ={3}^{2}-{log}_{3}⁡(10-7) \\\\  & =9-{log}_{3}⁡(3) \\\\  & =9-1 \\\\  & =8.\\end{aligned}\n$$\n\nTherefore, $f(10,3)=8.$"}] [{:db/id #edb/ref 17592186124198 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186124640 :knowledge-point/id #uuid "88f2bc84-03e8-5921-81e2-683a09195279" :knowledge-point/title "The Domain of a Function Containing Exponential, Logarithmic, and Trigonometric Functions"}] :question/id #uuid "bdae9fe0-a491-531b-ac36-7a37d2c32f16" :question/math-academy-id "e-11029" :question/problem "Find the domain of the function $z= \\dfrac{\\ln (2x+y)}{\\sqrt{x}}.$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following conditions are satisfied:\n\n- The expression under the logarithm is positive,\n\n- the expression in the denominator is not equal to zero, and\n\n- the expression under the square root is non-negative.\n\nAs a result, the points in the domain must satisfy the following inequalities: \n\n$$\n{\\begin{aligned}2x+y>0 \\\\ x>0\\end{aligned}\n$$\n\nTherefore, the domain is\n\n$$\n\\big\\{(x, y)\\in\\mathbb R^2 \\,:\\, 2x+y >0, \\: x > 0 \\big\\}.\n$$"}] [{:db/id #edb/ref 17592186124800 :knowledge-point/_questions [{:db/id #edb/ref 17592186124637 :knowledge-point/id #uuid "9e4fd256-a726-523c-84dc-f62d4e2711cc" :knowledge-point/title "Sketching the Domain of a Multivariable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "276ef443-515a-5fc5-811c-9fd1a1c9389d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b7/b7cf0f04bb0ac9373b222edef23d2925ea40d06fafa33f03423220f99de7d95f.png" :db/id #edb/ref 17592186272736} {:answer/id #uuid "50a009e0-93df-51e7-920e-e0763fa10bd8" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/1c/1c1d7ca7d9fdcaa8baeded0408339b29130810c07fb90b27ebc0674f9bffa275.png" :db/id #edb/ref 17592186273070} {:answer/id #uuid "510a0b87-4b2e-5a08-98ae-86d141d6ee14" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/7a/7afd18ecf16e868bb65e43626144251a1387d3dbbac8ec552ab1f8544b35d6fe.png" :db/id #edb/ref 17592186273075} {:answer/id #uuid "67c03a35-d64e-56cc-b238-c85ee6143494" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/48/488ae413d28377a5dcd8887003e5389c082189867c0d3cdf0564d4a2f351ed56.png" :db/id #edb/ref 17592186273282} {:answer/id #uuid "f1ef31de-ea63-5a11-adb1-d631ad0edd13" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/2d/2ddf4edfd91b14835e7b14ca8cebf08b82b8585d9fd18972c8b065d6153a62f0.png" :db/id #edb/ref 17592186274524}] :answer-field/correct {:answer/id #uuid "276ef443-515a-5fc5-811c-9fd1a1c9389d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b7/b7cf0f04bb0ac9373b222edef23d2925ea40d06fafa33f03423220f99de7d95f.png" :db/id #edb/ref 17592186272736} :answer-field/id #uuid "7c6210ce-a078-5b05-a002-cbeb9bc8a1bb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274849}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "76db17ba-163a-5fe3-9bd7-63e519e3eab2" :question/math-academy-id "q-158195" :question/problem "Which of the following shaded regions corresponds to the domain of the function $f(x,y)=\\sqrt{{x}^{2}+{y}^{2}-1}?$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The expression under the square root is non-negative.\n\nAs a result, the points in the domain must satisfy the following inequalities:\n\n$$\n{x}^{2}+{y}^{2}-1\\ge 0\\,⟹\\,{x}^{2}+{y}^{2}\\ge 1\n$$\n\nTherefore, the domain is\n\n$$\nD={(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}\\ge 1}.\n$$\n\nSince the inequality involves the $\\ge $ sign, the curve ${x}^{2}+{y}^{2}=1$ is part of the domain. Therefore, we draw a solid curve ${x}^{2}+{y}^{2}=1$ and shade the area *outside* the curve.\n\nThe resulting domain is as follows:\n\n![](images/ba/ba31bbc16c58860a4bc3c4d33ea1a61cb3d86d0e73d8aa6a67869b3e96a7fe32.png)"}] [{:db/id #edb/ref 17592186388995 :knowledge-point/_questions [{:db/id #edb/ref 17592186124637 :knowledge-point/id #uuid "9e4fd256-a726-523c-84dc-f62d4e2711cc" :knowledge-point/title "Sketching the Domain of a Multivariable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "613e7132-2128-56b5-bc00-f53656e511b5" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/65/65e29ff9fda5ad25fbbd68121d0c1a86e27a41de8890af31425208d7c38f2c2f.png" :db/id #edb/ref 17592186388997} {:answer/id #uuid "344a137c-9b7d-593b-8372-97e276d83d39" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c3/c30be01de07727a44fce390cfc2c56ddeed8071a7a7d64abec831a31aa2079fe.png" :db/id #edb/ref 17592186388998} {:answer/id #uuid "73c75e4a-3588-5716-a610-2b5c06d6af3b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/47/4789f1e3a4fbe0c6f23980010a0222905cb46b4ef105b02e7fba0b59fc570eeb.png" :db/id #edb/ref 17592186388999} {:answer/id #uuid "0c8633ad-7e8b-588d-bda6-758ae14482e3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/40/402d90507403eabf4cd35cde83a45c9fa2d8080347e1debb0e2463be408b489b.png" :db/id #edb/ref 17592186389000} {:answer/id #uuid "04f3aa5b-1769-54da-88b9-15a178728381" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/fe/fefbca84defd52b9fecd3b13b37cb95a744b4ddedd5a570ad554b6a251cd6077.png" :db/id #edb/ref 17592186389001}] :answer-field/correct {:answer/id #uuid "04f3aa5b-1769-54da-88b9-15a178728381" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/fe/fefbca84defd52b9fecd3b13b37cb95a744b4ddedd5a570ad554b6a251cd6077.png" :db/id #edb/ref 17592186389001} :answer-field/id #uuid "60958810-5683-5293-9f68-2735d4937038" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388996}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9419d3b0-0595-5357-8a67-2ff487c67499" :question/math-academy-id "q-158205" :question/problem "Which of the following shaded regions corresponds to the domain of the function $f(x,y)=\\frac{1}{{x}^{2}+{y}^{2}}?$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The expression in the denominator is not equal to zero.\n\nAs a result, the points in the domain must satisfy the following inequality:\n\n$$\n{x}^{2}+{y}^{2}\\ne 0\\,⟹\\,(x,y)\\ne (0,0)\n$$\n\nTherefore, the domain is\n\n$$\nD={(x,y)\\in {R}^{2}\\,:\\,(x.y)\\ne (0,0)}.\n$$\n\nSince the expression involves the $\\ne $ sign, the point $(0,0)$ is *not* part of the domain. Therefore, we exclude the point $(x,y)=(0,0)$ and shade the plane.\n\nThe resulting domain is as follows:\n\n![](images/70/701c54bff1c431883f21cb980ac43f4f2f6beabb11817066a4e909d5a2663a25.png)"}] [{:db/id #edb/ref 17592186278213 :knowledge-point/_questions [{:db/id #edb/ref 17592186124638 :knowledge-point/id #uuid "f9289c4d-4f7f-5704-a2cb-272f92d8fef3" :knowledge-point/title "Evaluating a Two-Variable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10745616-0602-5d0a-b702-ddf953b4fd38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186275623} {:answer/id #uuid "2eacecbd-7897-59d9-bb65-2d0a2e156dd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186275896} {:answer/id #uuid "49f2e092-d9b4-56d8-a57b-65f1230599e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186276129} {:answer/id #uuid "6c46acf3-b068-5e7a-af82-06cfd2ae6fd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186276450} {:answer/id #uuid "8db0cfa0-69d5-5323-bda4-d39822ec80f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186276761}] :answer-field/correct {:answer/id #uuid "10745616-0602-5d0a-b702-ddf953b4fd38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186275623} :answer-field/id #uuid "36c223f0-1ac5-50b8-bc16-df19662b3923" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277808}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d225e24f-f8fc-5851-bdaa-9e7972c2ed2f" :question/math-academy-id "q-158574" :question/problem "Evaluate $z=x\\operatorname{ln}⁡y-1$ at the point $(3,{e}^{2}).$" :question/worked-solution "To evaluate our multivariable function at the point $(3,{e}^{2}),$ we substitute $x=3$ and $y={e}^{2}$ into the function expression:\n\n$$\n\\begin{aligned}z\\,{|}_{(3,{e}^{2})} & =(x\\operatorname{ln}⁡y-1){|}_{(3,{e}^{2})} \\\\  & =3\\operatorname{ln}⁡({e}^{2})-1 \\\\  & =3(2\\operatorname{ln}⁡e)-1 \\\\  & =3(2)-1 \\\\  & =6-1 \\\\  & =5\\end{aligned}\n$$"}]}
