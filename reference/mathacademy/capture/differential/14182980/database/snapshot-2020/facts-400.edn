171-5ea9-813f-ad2c34f62661" #edb/ref 17592186045417] [17592186496912 #edb/ref 1080 "[\\begin{aligned}\\frac{1}{\\sqrt{6}} \\\\ -\\frac{2}{\\sqrt{6}} \\\\ \\frac{1}{\\sqrt{6}}\\end{aligned}]" #edb/ref 17592186045417] [17592186496912 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186496912 #edb/ref 1083 #uuid "78c5338f-e189-5564-b2bd-1367f0bf0775" #edb/ref 17592186045417] [17592186497022 #edb/ref 1080 "[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]" #edb/ref 17592186045417] [17592186497022 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186497022 #edb/ref 1083 #uuid "b22038de-df21-574b-a2d3-9931b67c69bf" #edb/ref 17592186045417] [17592186497115 #edb/ref 1080 "[\\begin{aligned}\\frac{1}{\\sqrt{3}} \\\\ -\\frac{1}{\\sqrt{3}} \\\\ \\frac{1}{\\sqrt{3}}\\end{aligned}]" #edb/ref 17592186045417] [17592186497115 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186497115 #edb/ref 1083 #uuid "d8e9bd21-b777-5f10-97d3-56334fae5657" #edb/ref 17592186045417] [17592186497150 #edb/ref 1080 "[\\begin{aligned}\\frac{2}{\\sqrt{6}} \\\\ -\\frac{1}{\\sqrt{6}} \\\\ \\frac{1}{\\sqrt{6}}\\end{aligned}]" #edb/ref 17592186045417] [17592186497150 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186497150 #edb/ref 1083 #uuid "e6b4cead-3dc7-5c6a-98ef-f3fe49303b95" #edb/ref 17592186045417] [17592186497315 #edb/ref 1075 #edb/ref 17592186496728 #edb/ref 17592186045417] [17592186497315 #edb/ref 1075 #edb/ref 17592186496912 #edb/ref 17592186045417] [17592186497315 #edb/ref 1075 #edb/ref 17592186497022 #edb/ref 17592186045417] [17592186497315 #edb/ref 1075 #edb/ref 17592186497115 #edb/ref 17592186045417] [17592186497315 #edb/ref 1075 #edb/ref 17592186497150 #edb/ref 17592186045417] [17592186497315 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186497315 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186497315 #edb/ref 1078 #edb/ref 17592186496912 #edb/ref 17592186045417] [17592186497315 #edb/ref 1079 #uuid "f80968a1-b5d3-5a74-a9ab-07fd72693189" #edb/ref 17592186045417] [17592186497345 #edb/ref 1068 #edb/ref 17592186497315 #edb/ref 17592186045417] [17592186497345 #edb/ref 1069 "q-140962" #edb/ref 17592186045417] [17592186497345 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186497345 #edb/ref 1071 "$$\nA=[\\begin{aligned}1 & 3 \\\\ 2 & 2 \\\\ 3 & 1\\end{aligned}],\\,Σ=[\\begin{aligned}2\\sqrt{6} & 0 \\\\ 0 & 2 \\\\ 0 & 0\\end{aligned}],\\,V=[\\begin{aligned}\\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{aligned}]\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ which of the following could be the $3$rd column of the matrix $U?$" #edb/ref 17592186045417] [17592186497345 #edb/ref 1072 #uuid "2c32a996-4944-5e2d-afe2-519907ae493e" #edb/ref 17592186045417] [17592186497345 #edb/ref 1074 "Recall that if  $A=UΣ{V}^{T}$ is a singular value decomposition of a $3\\times 2$ matrix $A,$ then\n\n- $Σ$ is a $3\\times 2$ matrix with nonnegative elements on the main diagonal and zeroes outside the main diagonal,\n\n- $U$ is an orthogonal $3\\times 3$ matrix,\n\n- $V$ is an orthogonal $2\\times 2$ matrix.\n\nFrom the matrix $Σ,$ we deduce that ${\\sigma }_{1}=2\\sqrt{6}$ and ${\\sigma }_{2}=2.$\nAlso, the columns ${v}_{1}$ and ${v}_{2}$ of $V$ give us the right singular vectors of $A.$\n\nTherefore, we can compute the $1$st and $2$nd columns of $U$ as follows:\n\n- First, we compute ${u}_{1}:$\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{2\\sqrt{6}}[\\begin{aligned}1 & 3 \\\\ 2 & 2 \\\\ 3 & 1\\end{aligned}][\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}] \\\\  & =\\frac{1}{2\\sqrt{6}}[\\begin{aligned}2\\sqrt{2} \\\\ 2\\sqrt{2} \\\\ 2\\sqrt{2}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{\\sqrt{3}} \\\\ \\frac{1}{\\sqrt{3}} \\\\ \\frac{1}{\\sqrt{3}}\\end{aligned}]\\end{aligned}\n$$\n\n- Then, we compute ${u}_{2}:$\n\n$$\n\\begin{aligned}{u}_{2} & =\\frac{1}{{\\sigma }_{2}}A{v}_{2} \\\\  & =\\frac{1}{2}[\\begin{aligned}1 & 3 \\\\ 2 & 2 \\\\ 3 & 1\\end{aligned}][\\begin{aligned}-\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}\\sqrt{2} \\\\ 0 \\\\ -\\sqrt{2}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ 0 \\\\ -\\frac{1}{\\sqrt{2}}\\end{aligned}]\\end{aligned}\n$$\n\nSince we do not have the third singular value, we can't use the same formula to find the third column of $U.$ But we know that $U$ must be orthogonal. Hence, we must find a vector \n\n$$\n{u}_{3}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]\n$$\n\nsuch that \n\n$$\n\\{\\begin{aligned}{u}_{1}\\cdot {u}_{3}=0 \\\\ {u}_{2}\\cdot {u}_{3}=0,\\end{aligned}\\,‖{u}_{3}‖=1.\n$$\n\nSolving this system, which is equivalent to\n\n$$\n\\{\\begin{aligned}\\frac{1}{\\sqrt{3}}{x}_{1}+\\frac{1}{\\sqrt{3}}{x}_{2}+\\frac{1}{\\sqrt{3}}{x}_{3}=0 \\\\ \\frac{1}{\\sqrt{2}}{x}_{1}-\\frac{1}{\\sqrt{2}}{x}_{3}=0\\end{aligned}\\,⟹\\,\\{\\begin{aligned}{x}_{1}+{x}_{2}+{x}_{3}=0 \\\\ {x}_{1}-{x}_{3}=0,\\end{aligned}\n$$\n\nwe get the nonzero normalized solution \n\n$$\n{u}_{3}=[\\begin{aligned}\\frac{1}{\\sqrt{6}} \\\\ -\\frac{2}{\\sqrt{6}} \\\\ \\frac{1}{\\sqrt{6}}\\end{aligned}].\n$$\n\nFinally, we construct the matrix $U:$\n\n$$\nU=[\\begin{aligned}\\frac{1}{\\sqrt{3}} & \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{6}} \\\\ \\frac{1}{\\sqrt{3}} & 0 & -\\frac{2}{\\sqrt{6}} \\\\ \\frac{1}{\\sqrt{3}} & -\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{6}}\\end{aligned}]\n$$" #edb/ref 17592186045417]}
