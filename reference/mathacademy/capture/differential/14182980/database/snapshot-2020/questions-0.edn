.type/math} :answer/value "\\frac{1}{\\sqrt{2}}" :db/id #edb/ref 17592186423683} {:answer/id #uuid "1c1b2dc9-90ac-5b88-a3fd-32bdeed794a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{\\sqrt{2}}" :db/id #edb/ref 17592186423689} {:answer/id #uuid "632889c3-4e1e-5d3e-b934-1a2aa906db68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186423728} {:answer/id #uuid "e954c0d9-249a-5fc8-a9a2-20fa0626d8b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186423813}] :answer-field/correct {:answer/id #uuid "632889c3-4e1e-5d3e-b934-1a2aa906db68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186423728} :answer-field/id #uuid "be96bfd5-2620-5ac7-aa9f-1917ba89eb84" :answer-field/key "field-9" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186423843} {:answer-field/choices [{:answer/id #uuid "1cf39c55-ade5-5512-aeae-e8ce09883317" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186423691} {:answer/id #uuid "a1250c4b-23e3-59f3-a490-f89d27cddab2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{2}}" :db/id #edb/ref 17592186423767} {:answer/id #uuid "a39a1597-fd98-5261-9c1a-cffbe2cd582d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186423769} {:answer/id #uuid "f3e0e18f-beed-55ab-95b9-7b8cf6b2e8bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{\\sqrt{2}}" :db/id #edb/ref 17592186423815}] :answer-field/correct {:answer/id #uuid "a39a1597-fd98-5261-9c1a-cffbe2cd582d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186423769} :answer-field/id #uuid "e0b58e38-8d8a-545b-a564-39cbf09af580" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186423851}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bd607d3f-88f1-5057-a261-73a39b9023d2" :question/math-academy-id "q-363834" :question/problem "$$\nA=[\\begin{aligned}\\sqrt{2} & 0 \\\\ \\sqrt{2} & 0 \\\\ 0 & 0\\end{aligned}],\\,Σ=[\\begin{aligned}2 & 0 \\\\ 0 & 0 \\\\ 0 & 0\\end{aligned}],\\,V=[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$  select the correct options in the computations of the matrix $U$ below.\n\nFrom the matrix $Σ,$ we deduce the singular values ${\\sigma }_{1}=2$ and ${\\sigma }_{2}=0.$\n\nNow, we compute the $1$st column of $U.$ It is given by:\n\n|  |  | $\\frac{1}{\\sqrt{2}}$ |  |  |\n| --- | --- | --- | --- | --- |\n| ${u}_{1}=\\,\\,$ |  | {{field-1}} |  |  |\n|  |  | {{field-2}} |  |  |\n\nSince the second singular value is ${\\sigma }_{2}=0$, and we do not have the third singular value, we can't use the same formula to find the second and third columns of $U.$ But we know that $U$ must be orthogonal.\n\nHence, we must find vectors $u=[{x}_{1},{x}_{2},{x}_{3}]^{T}$ such that ${u}_{1}\\cdot u=0,$ which is equivalent to \n\n$$\n{{field-3}}.\n$$\n\nChoosing ${x}_{2}$ and ${x}_{3}$ as free variables, the general solution is given by:\n\n|  |  | {{field-4}} |  |  |\n| --- | --- | --- | --- | --- |\n|  |  | ${x}_{2}$ |  |  |\n|  |  | {{field-5}} |  |  |\n\nthat we can rewrite as\n\n$$\n[\\begin{aligned}-{x}_{2} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]={x}_{2}[\\begin{aligned}-1 \\\\ 1 \\\\ 0\\end{aligned}]+{x}_{3}[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}].\n$$\n\nSince the two linearly independent solutions are already mutually orthogonal, we only need to normalize them. Hence, we obtain the second and third columns of $U:$\n\n<table cellpadding=\"0\">\n<tbody>\n<tr>\n<td>\n<table cellpadding=\"0\">\n<tbody>\n<tr>\n<td align=\"right\" height=\"30px\" rowspan=\"3\" width=\"40px\">\n                ${u}_{2}=\\,\\,$\n              </td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"90px\">\n                {{field-6}}\n              </td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">\n                $\\frac{1}{\\sqrt{2}}$\n              </td>\n<td align=\"center\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">\n                {{field-7}}\n              </td>\n<td align=\"center\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n</tbody>\n</table>\n</td>\n<td>\n<table cellpadding=\"0\">\n<tbody>\n<tr>\n<td align=\"right\" height=\"30px\" rowspan=\"3\" width=\"40px\">\n                ${u}_{3}=\\,\\,$\n              </td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"90px\">\n                $0$\n              </td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">\n                {{field-8}}\n              </td>\n<td align=\"center\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">\n                {{field-9}}\n              </td>\n<td align=\"center\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>" :question/worked-solution "Recall that if  $A=UΣ{V}^{T}$ is a singular value decomposition of a $3\\times 2$ matrix $A,$ then\n\n- $Σ$ is a $3\\times 2$ matrix with nonnegative elements on the main diagonal and zeroes outside the main diagonal,\n\n- $U$ is an orthogonal $3\\times 3$ matrix,\n\n- $V$ is an orthogonal $2\\times 2$ matrix.\n\nFrom the matrix $Σ,$ we deduce that ${\\sigma }_{1}=2$ and ${\\sigma }_{2}=0.$\nAlso, the columns ${v}_{1}$ and ${v}_{2}$ of $V$ give us the right singular vectors of $A.$\n\nTherefore, we can compute the first column of $U$ as follows:\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{2}[\\begin{aligned}\\sqrt{2} & 0 \\\\ \\sqrt{2} & 0 \\\\ 0 & 0\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}\\sqrt{2} \\\\ \\sqrt{2} \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\nSince the second singular value is ${\\sigma }_{2}=0$, and we do not have the third singular value, we can't use the same formula to find the second and third columns of $U.$ But we know that $U$ must be orthogonal. Hence, we must find vectors \n\n$$\nu=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]\n$$\n\nsuch that ${u}_{1}\\cdot u=0$ and $‖u‖=1.$\n\nSolving ${u}_{1}\\cdot u=0,$ which is equivalent to\n\n$$\n\\frac{1}{\\sqrt{2}}{x}_{1}+\\frac{1}{\\sqrt{2}}{x}_{2}=0\\,⟹\\,{x}_{1}+{x}_{2}=0,\n$$\n\nwe get the general solution \n\n$$\n[\\begin{aligned}-{x}_{2} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]={x}_{2}{{[\\begin{aligned}-1 \\\\ 1 \\\\ 0\\end{aligned}]}_{⏟}}_{{b}_{1}}+{x}_{3}{{[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}]}_{⏟}}_{{b}_{2}},\n$$\n\nwhere ${x}_{2}$ and ${x}_{3}$ are free variables.\n\nNotice that the two linearly independent solutions ${b}_{1}$ and ${b}_{2}$ are mutually orthogonal. Therefore, we only need to normalize them. This gives the second and third columns of $U:$   \n\n$$\n{u}_{2}=[\\begin{aligned}-\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} \\\\ 0\\end{aligned}]\\,{u}_{3}=[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}]\n$$\n\nSo, the matrix $U$ could be the following:\n\n$$\nU=[\\begin{aligned}\\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} & 0 \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} & 0 \\\\ 0 & 0 & 1\\end{aligned}]\n$$"}] [{:db/id #edb/ref 17592186370740 :knowledge-point/_questions [{:db/id #edb/ref 17592186162045 :knowledge-point/id #uuid "566bda0f-f62d-581d-936d-baa8ae474e50" :knowledge-point/title "Finding the First Factor in the SVD of a Rectangular Matrix: Cases Requiring Orthogonalization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f74aec7-8abe-5cb4-aef9-610ac59ad5e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{\\sqrt{3}}" :db/id #edb/ref 17592186370742} {:answer/id #uuid "bddd798e-f9eb-52af-894c-1535f9fc9ff6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{3}}" :db/id #edb/ref 17592186370743} {:answer/id #uuid "26467df6-1671-56fb-9dcc-328835e089a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{\\sqrt{3}}" :db/id #edb/ref 17592186370744} {:answer/id #uuid "e2187134-218f-5990-b053-e8207628cb34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{3}}" :db/id #edb/ref 17592186370745}] :answer-field/correct {:answer/id #uuid "e2187134-218f-5990-b053-e8207628cb34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{3}}" :db/id #edb/ref 17592186370745} :answer-field/id #uuid "a22726aa-562f-5f3f-81dc-3afdd76e124b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186370741} {:answer-field/choices [{:answer/id #uuid "9b11a6ee-36d3-50d0-96a0-e25b67a0a5a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{\\sqrt{2}}" :db/id #edb/ref 17592186370747} {:answer/id #uuid "9cb23c3e-67c9-5ed