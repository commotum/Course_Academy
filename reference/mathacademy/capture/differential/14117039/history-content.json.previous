      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14117039/observations/lesson-step-180138-a613ee43d3df3d3a9296.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14117039/observations/lesson-step-180138-a613ee43d3df3d3a9296.png",
