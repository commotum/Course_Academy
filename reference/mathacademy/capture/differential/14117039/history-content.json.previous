4 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo><mjx-texatom texclass=\"ORD\"><mjx-mo class=\"mjx-sop\"><mjx-c class=\"mjx-c5D TEX-S1\"></mjx-c></mjx-mo></mjx-texatom><mjx-mo class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c2227\"></mjx-c></mjx-mo><mjx-mstyle space=\"3\" style=\"border: 1pt solid black; background-color: white;\"><mjx-mpadded><mjx-block style=\"width: 8.1em; margin: 0.3em 0px; position: relative;\"><mjx-rbox style=\"left: 0.3em; top: 0px; max-width: 8.1em;\"><mjx-texatom texclass=\"ORD\"><mjx-mphantom><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D434 TEX-I\"></mjx-c></mjx-mi><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D434 TEX-I\"></mjx-c></mjx-mi><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D434 TEX-I\"></mjx-c></mjx-mi><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D434 TEX-I\"></mjx-c></mjx-mi><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D434 TEX-I\"></mjx-c></mjx-mi><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D434 TEX-I\"></mjx-c></mjx-mi><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D434 TEX-I\"></mjx-c></mjx-mi><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D434 TEX-I\"></mjx-c></mjx-mi><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D434 TEX-I\"></mjx-c></mjx-mi><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D434 TEX-I\"></mjx-c></mjx-mi></mjx-mphantom></mjx-texatom></mjx-rbox></mjx-block></mjx-mpadded></mjx-mstyle></mjx-math><mjx-assistive-mml display=\"block\" unselectable=\"on\"><math display=\"block\" xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">¬</mi><mi>P</mi><mo stretchy=\"false\">⇔</mo><mo stretchy=\"false\">(</mo><mi>P</mi><mo>∨</mo><mi>Q</mi><mo stretchy=\"false\">)</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mo>≡</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mrow data-mjx-texclass=\"ORD\"><mo maxsize=\"1.2em\" minsize=\"1.2em\">[</mo></mrow><mi mathvariant=\"normal\">¬</mi><mi>P</mi><mo stretchy=\"false\">⇒</mo><mo stretchy=\"false\">(</mo><mi>P</mi><mo>∨</mo><mi>Q</mi><mo stretchy=\"false\">)</mo><mrow data-mjx-texclass=\"ORD\"><mo maxsize=\"1.2em\" minsize=\"1.2em\">]</mo></mrow><mo>∧</mo><mstyle mathbackground=\"white\" style=\"border: 1pt solid black\"><mpadded depth=\"+3pt\" height=\"+3pt\" lspace=\"3pt\" width=\"+6pt\"><mrow data-mjx-texclass=\"ORD\"><mphantom><mi>A</mi><mi>A</mi><mi>A</mi><mi>A</mi><mi>A</mi><mi>A</mi><mi>A</mi><mi>A</mi><mi>A</mi><mi>A</mi></mphantom></mrow></mpadded></mstyle></math></mjx-assistive-mml></mjx-container></p>\n<p>What expression should be inserted into the blank space above to give logically equivalent statements?</p>\n</div><div class=\"answerDetails\"><div class=\"questionDifficulty difficultyModerate\">M</div><span class=\"answerCreated\">Sun, Oct 11th @ 5:34 AM</span><span class=\"answerDetailsSeparator\">|</span><span class=\"timeElpased\">Elapsed: 0:18</span><span class=\"answerResult\"><span style=\"color: green;\">Correct</span></span></div></div>"
    },
    {
      "dom_id": "question-1472",
      "name": null,
      "problem": "$R⇔S≡$",
      "worked_solution": "According to the definition of the biconditional, \n\n- $A⇔B$ is true if $A⇒B$ **and** $B⇒A.$ Otherwise, it is false.\n\n- In other words, $A⇔B$ is true if $A$ and $B$ have the same truth values. Otherwise, it is false.\n\nSo in this case, we have\n\n$$\nR⇔S≡(R⇒S)∧(S⇒R).\n$$",
      "calculator_instructions": "",
      "fields": [],
      "answer_fields_complete": null,
      "result": "Correct",
      "proof_feedback": null,
      "html": "<div id=\"question-1472\" class=\"question\"><div class=\"questionHeader\"><span class=\"questionNumber\">8.</span><span class=\"helpButton\" questionid=\"1472\">?</span></div><div class=\"questionText\"><p><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"279\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D445 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c21D4\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-i\" space=\"4\"><mjx-c class=\"mjx-c1D446 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2261\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi><mo stretchy=\"false\">⇔</mo><mi>S</mi><mo>≡</mo></math></mjx-assistive-mml></mjx-container></p>\n</div><div class=\"answerDetails\"><div class=\"questionDifficulty difficultyEasy\">E</div><span class=\"answerCreated\">Sun, Oct 11th @ 5:34 AM</span><span class=\"answerDetailsSeparator\">|</span><span class=\"timeElpased\">Elapsed: 0:15</span><span class=\"answerResult\"><span style=\"color: green;\">Correct</span></span></div></div>",
