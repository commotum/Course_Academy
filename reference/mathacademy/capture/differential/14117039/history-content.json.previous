194Q264 46 283 49T309 63V339V550Q309 620 304 625T271 630H244H224Q154 630 119 601Q101 585 93 554T81 486T76 443V437H36V443Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E24-MJMAIN-54\" x=\"0\" y=\"0\"></use>\n</g>\n</svg></span></td>\n</tr>\n</tbody></table>\n\n\n            </div>           \n        </div>",
