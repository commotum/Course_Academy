      "raw_html": "<div class=\"question\" id=\"question-183359\"><div class=\"questionHeader\"><span class=\"questionNumber\">4.</span><span class=\"helpButton\" questionid=\"183359\">?</span></div><div class=\"questionText\"><p> If <mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"130\" jax=\"CHTML\" style=\"font-size: 119.4%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D434 TEX-I\"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi></math></mjx-assistive-mml></mjx-container> is true and <mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"131\" jax=\"CHTML\" style=\"font-size: 119.4%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D435 TEX-I\"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>B</mi></math></mjx-assistive-mml></mjx-container> is true, then <mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"132\" jax=\"CHTML\" style=\"font-size: 119.4%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\"><mjx-mi class=\"mjx-n\"><mjx-c class=\"mjx-cAC\"></mjx-c></mjx-mi><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D434 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c21D4\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-i\" space=\"4\"><mjx-c class=\"mjx-c1D435 TEX-I\"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">¬</mi><mi>A</mi><mo stretchy=\"false\">⇔</mo><mi>B</mi></math></mjx-assistive-mml></mjx-container> is</p>\n</div><div class=\"questionBody\" id=\"questionBody-183359\"><div