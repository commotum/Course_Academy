      "assets": [],
      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14117039/observations/lesson-step-180146-466200120fa5547da8d9.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14117039/observations/lesson-step-180146-466200120fa5547da8d9.png",
      "source_url": "https://mathacademy.com/topics/248",
