mal\">¬</mi><mi>Y</mi><mo stretchy=\"false\">)</mo></mtd><mtd><mi></mi><mo>≡</mo><mo stretchy=\"false\">(</mo><mi>Y</mi><mo>∧</mo><mi mathvariant=\"normal\">¬</mi><mi>X</mi><mo stretchy=\"false\">)</mo><mo>∨</mo><mo stretchy=\"false\">(</mo><mi>X</mi><mo>∧</mo><mi mathvariant=\"normal\">¬</mi><mi>Y</mi><mo stretchy=\"false\">)</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
