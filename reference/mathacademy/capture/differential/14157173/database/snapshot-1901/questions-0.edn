#{[{:db/id #edb/ref 17592186105488 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105916 :knowledge-point/id #uuid "e598ad1e-cee5-5d5f-b2a9-c067e4625cf6" :knowledge-point/title "Calculating a Scalar Projection Using Angles and Magnitudes"}] :question/id #uuid "1a24b403-754c-5424-8182-8cad3487deed" :question/math-academy-id "e-15606" :question/problem "Suppose $|\\,\\mathbf{a}\\,|=13$ and the angle between vectors $\\mathbf{a}$ and $\\mathbf{b}$ is $\\theta = \\dfrac{2\\pi}{3}.$ Find the scalar projection of $\\mathbf{a}$ onto $\\mathbf{b}.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =|\\,a\\,|\\operatorname{cos}⁡\\theta  \\\\  & =13\\operatorname{cos}⁡(\\frac{2\\pi }{3}) \\\\  & =13\\cdot (-\\frac{1}{2}) \\\\  & =-\\frac{13}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186105489 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105917 :knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036" :knowledge-point/title "Calculating a Scalar Projection Using Components"}] :question/id #uuid "da8a1521-86cc-5747-88a7-e2ec56010c11" :question/math-academy-id "e-15607" :question/problem "Let $\\mathbf{a}=\\langle 3,3,-1 \\rangle$ and $\\mathbf{b}=\\langle 2,-7,0 \\rangle.$ Find the scalar projection of $\\mathbf{a}$ onto $\\mathbf{b}.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{3\\cdot 2+3\\cdot (-7)+(-1)\\cdot 0}{\\sqrt{{2}^{2}+(-7)^{2}+{0}^{2}}} \\\\  & =-\\frac{15}{\\sqrt{53}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186105490 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105918 :knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f" :knowledge-point/title "Projecting a Vector Onto a Perpendicular Vector"}] :question/id #uuid "4693b28f-df75-574e-8e49-bb89e162b107" :question/math-academy-id "e-15608" :question/problem "Let ![](images/bf/bf51b89da6e28b6f6cf620b709298b81b8c202b54a601741b0bed05cd265b3e9.svg) and ![](images/39/39895d1db9365c174ca95dcbd4ba9d374a1c14929859f652e3cfdd07993569ac.svg) Find the scalar projection of $\\mathbf{a}$ onto $\\mathbf{b}.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{c}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{0\\cdot 2+0\\cdot (-4)+1\\cdot 0}{\\sqrt{{2}^{2}+(-4)^{2}+{0}^{2}}} \\\\  & =\\frac{0}{\\sqrt{{2}^{2}+(-4)^{2}+{0}^{2}}} \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186480656 :knowledge-point/_questions [{:db/id #edb/ref 17592186105916 :knowledge-point/id #uuid "e598ad1e-cee5-5d5f-b2a9-c067e4625cf6" :knowledge-point/title "Calculating a Scalar Projection Using Angles and Magnitudes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "311f9824-699a-5a38-83d3-40267dc46ab5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186480190} {:answer/id #uuid "31a44f88-a9d2-5ac1-9074-4eaba651ac12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186480191} {:answer/id #uuid "9f74324e-554a-5e36-8177-d8ee9a8eb1b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{3}" :db/id #edb/ref 17592186480372} {:answer/id #uuid "ce889001-65f4-5414-8ef9-dfcfe539055e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\sqrt{3}" :db/id #edb/ref 17592186480456} {:answer/id #uuid "e8ca569d-59b2-52ea-96f3-06e9ff60d259" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{6}" :db/id #edb/ref 17592186480495}] :answer-field/correct {:answer/id #uuid "31a44f88-a9d2-5ac1-9074-4eaba651ac12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186480191} :answer-field/id #uuid "1e3aefe0-abfb-587a-90a2-c75247bc2342" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186480544}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4f10acf7-191a-5a7b-ad4b-e4a80fb0c241" :question/math-academy-id "q-101521" :question/problem "Suppose $|\\,c\\,|=6\\sqrt{3}$ and the angle between vectors $c$ and $d$ is $\\theta ={30}^{∘}.$ Find the scalar projection of $c$ onto $d.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{d}\\,c & =|\\,c\\,|\\operatorname{cos}⁡\\theta  \\\\  & =6\\sqrt{3}\\operatorname{cos}⁡({30}^{∘}) \\\\  & =6\\sqrt{3}\\cdot \\frac{\\sqrt{3}}{2} \\\\  & =9.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186106098 :knowledge-point/_questions [{:db/id #edb/ref 17592186105917 :knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036" :knowledge-point/title "Calculating a Scalar Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38804ecb-a9e5-5292-83cd-22d2f3dddc02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186285314} {:answer/id #uuid "87af4911-57b8-5d1b-a61c-48885ecb8443" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186286030} {:answer/id #uuid "b25bb67f-9d56-52b5-a4e4-2d21207798bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}-1}{2\\sqrt{3}}" :db/id #edb/ref 17592186286419} {:answer/id #uuid "b647e886-213b-5e34-8574-a0e95f37c1c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186286452} {:answer/id #uuid "db777d82-845a-5914-94e9-dcb99836452f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}-1}{2}" :db/id #edb/ref 17592186286786}] :answer-field/correct {:answer/id #uuid "db777d82-845a-5914-94e9-dcb99836452f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}-1}{2}" :db/id #edb/ref 17592186286786} :answer-field/id #uuid "cc839666-75c3-59d3-a3a7-4e1a2451ad41" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287571}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1e48bd53-4841-5a1d-adee-85eb3b590727" :question/math-academy-id "q-18374" :question/problem "Let $p=⟨\\sqrt{2},1,-1⟩$ and $q=⟨\\sqrt{8},-\\sqrt{3},1⟩.$ Find the scalar projection of $p$ onto $q.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =\\frac{p\\cdot q}{|\\,q\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{\\sqrt{2}\\cdot \\sqrt{8}+1\\cdot (-\\sqrt{3})+(-1)\\cdot 1}{\\sqrt{(\\sqrt{8})^{2}+(-\\sqrt{3})^{2}+{1}^{2}}} \\\\  & =\\frac{3-\\sqrt{3}}{\\sqrt{12}} \\\\  & =\\frac{3-\\sqrt{3}}{2\\sqrt{3}} \\\\  & =\\frac{\\sqrt{3}-1}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287929 :knowledge-point/_questions [{:db/id #edb/ref 17592186105917 :knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036" :knowledge-point/title "Calculating a Scalar Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "878d43a6-d107-5eec-8449-fd467cac8ebd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{23}{3\\sqrt{11}}" :db/id #edb/ref 17592186286029} {:answer/id #uuid "933aaa15-11df-5f3e-ae55-c0208c1380e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{23}{2\\sqrt{11}}" :db/id #edb/ref 17592186286125} {:answer/id #uuid "9d4d067c-ee1e-5639-885e-2771ed5aec7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{23}{\\sqrt{33}}" :db/id #edb/ref 17592186286227} {:answer/id #uuid "df6c1f7d-e888-572e-ae9a-4ca94e13c1c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{23}{\\sqrt{22}}" :db/id #edb/ref 17592186286825} {:answer/id #uuid "f9db8267-d997-5b03-8fb6-b817c07e5f31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{22}{\\sqrt{23}}" :db/id #edb/ref 17592186287072}] :answer-field/correct {:answer/id #uuid "df6c1f7d-e888-572e-ae9a-4ca94e13c1c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{23}{\\sqrt{22}}" :db/id #edb/ref 17592186286825} :answer-field/id #uuid "5e7fbbe9-37af-5f89-a880-f7a5a7a0a366" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287349}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5a770afc-2081-5ea1-a846-77f04dfffce6" :question/math-academy-id "q-19142" :question/problem "Let $p=⟨4,1,4⟩$ and $q=⟨2,3,3⟩.$ Find the scalar projection of $p$ onto $q.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =\\frac{p\\cdot q}{|\\,q\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{4\\cdot 2+1\\cdot 3+4\\cdot 3}{\\sqrt{{2}^{2}+{3}^{2}+{3}^{2}}} \\\\  & =\\frac{23}{\\sqrt{22}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290487 :knowledge-point/_questions [{:db/id #edb/ref 17592186105918 :knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f" :knowledge-point/title "Projecting a Vector Onto a Perpendicular Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f63989c-30f1-5c24-b29f-efbf4137d328" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186288234} {:answer/id #uuid "1fcdfc3c-0b4f-56d0-8865-1174e6c456fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186288238} {:answer/id #uuid "436014ad-b619-5cc4-b0db-f17722d1681a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186288492} {:answer/id #uuid "45206803-f9d0-55fe-be31-cc4c00a72853" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186288501} {:answer/id #uuid "92856ac6-8e97-51a2-9023-612b203bc678" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186289016}] :answer-field/correct {:answer/id #uuid "1f63989c-30f1-5c24-b29f-efbf4137d328" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186288234} :answer-field/id #uuid "094c47e3-6adf-5882-8699-9b8ef4f4d74a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289746}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f879853f-8faf-5226-ac51-81b9eb8102b2" :question/math-academy-id "q-237015" :question/problem "Let $p=[\\begin{aligned}5 \\\\ x \\\\ 2\\end{aligned}]$ and $q=[\\begin{aligned}4 \\\\ -2 \\\\ -3\\end{aligned}].$ Given that the scalar projection of $p$ onto $q$ is $0,$ find the value of $x.$" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =5\\cdot 4+x\\cdot (-2)+2\\cdot (-3) \\\\  & =14-2x.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 14-2x & =0 \\\\ 2x & =14 \\\\ x & =7.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290490 :knowledge-point/_questions [{:db/id #edb/ref 17592186105918 :knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f" :knowledge-point/title "Projecting a Vector Onto a Perpendicular Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dc40103-4688-55dd-8d82-093d855eb2cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186288339} {:answer/id #uuid "4be5c6a7-9473-5f8f-a76d-361e76618b03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186288557} {:answer/id #uuid "969e8fda-7e9c-55a7-bced-44ceb4371dda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186289039} {:answer/id #uuid "cbe15376-5215-5280-ae06-1a3991f84d01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186289384} {:answer/id #uuid "eb4d7bb2-b033-5091-b1bf-ce3cd9d629f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186289590}] :answer-field/correct {:answer/id #uuid "2dc40103-4688-55dd-8d82-093d855eb2cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186288339} :answer-field/id #uuid "0bd2ffd0-af54-5576-8d75-4029636169bd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289757}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "23ed6766-8e64-5c6e-b8a5-b8f25dcf697a" :question/math-academy-id "q-237018" :question/problem "Let $a=5i-4j+3k$ and $b=-7i+xj+k.$ Given that the scalar projection of $a$ onto $b$ is zero, find the value of $x.$" :question/worked-solution "Since $a$ is a nonzero vector, its scalar projection onto another nonzero vector $b$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =5\\cdot (-7)+(-4)\\cdot x+3\\cdot 1 \\\\  & =-4x-32.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ -4x-32 & =0 \\\\ 4x & =-32 \\\\ x & =-8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290492 :knowledge-point/_questions [{:db/id #edb/ref 17592186105918 :knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f" :knowledge-point/title "Projecting a Vector Onto a Perpendicular Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13792421-9275-5651-8409-88c85398dd37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186288166} {:answer/id #uuid "490f58c8-c786-5d31-8e1c-79dccd244271" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186288538} {:answer/id #uuid "710f00a5-6a28-5ddc-bbc9-f671cc856f77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186288818} {:answer/id #uuid "95c00138-66e1-5e8b-a88a-99d98837093b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186289032} {:answer/id #uuid "fc1f4fad-69ca-506c-bf35-61221cd5e6c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186289696}] :answer-field/correct {:answer/id #uuid "13792421-9275-5651-8409-88c85398dd37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186288166} :answer-field/id #uuid "10ff23a8-ea19-544f-b919-18be2538ce3a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289772}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f85820f0-0e97-5a70-b11e-7b663b24839a" :question/math-academy-id "q-237021" :question/problem "Let $c=⟨-3,\\sqrt{3},1⟩$ and $d=⟨x,0,-12⟩.$ Given that the scalar projection of $c$ onto $d$ is zero, find the value of $x.$" :question/worked-solution "Since $c$ is a nonzero vector, its scalar projection onto another nonzero vector $d$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\nc⊥d\\,⟹\\,c\\cdot d=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}c\\cdot d & ={c}_{x}\\cdot {d}_{x}+{c}_{y}\\cdot {d}_{y}+{c}_{z}\\cdot {d}_{z} \\\\  & =(-3)\\cdot x+\\sqrt{3}\\cdot 0+1\\cdot (-12) \\\\  & =-3x-12.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}c\\cdot d & =0 \\\\ -3x-12 & =0 \\\\ 3x & =-12 \\\\ x & =-4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186480689 :knowledge-point/_questions [{:db/id #edb/ref 17592186105916 :knowledge-point/id #uuid "e598ad1e-cee5-5d5f-b2a9-c067e4625cf6" :knowledge-point/title "Calculating a Scalar Projection Using Angles and Magnitudes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28e79a2a-f934-5d02-bb33-fed7a4c61fee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186480179}] :answer-field/correct {:answer/id #uuid "28e79a2a-f934-5d02-bb33-fed7a4c61fee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186480179} :answer-field/id #uuid "6d844d6a-b86e-5583-9197-f2e6b196cc47" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186480569}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b93ffaa5-a268-5040-8e2a-c610ae7ae03c" :question/math-academy-id "q-275242" :question/problem "Suppose $|\\,a\\,|=7$ and the angle between vectors $a$ and $b$ is $\\theta ={90}^{∘}.$ Find the scalar projection of $a$ onto $b.$\n\n${\\text{comp}}_{b}\\,a=$\n{{field-1}}" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =|\\,a\\,|\\operatorname{cos}⁡\\theta  \\\\  & =7\\operatorname{cos}⁡({90}^{∘}) \\\\  & =7\\cdot 0 \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186292826 :knowledge-point/_questions [{:db/id #edb/ref 17592186105917 :knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036" :knowledge-point/title "Calculating a Scalar Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43038c56-d384-5570-86af-704e0880166f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{\\sqrt{13}}" :db/id #edb/ref 17592186290909}] :answer-field/correct {:answer/id #uuid "43038c56-d384-5570-86af-704e0880166f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{\\sqrt{13}}" :db/id #edb/ref 17592186290909} :answer-field/id #uuid "6d92e0bb-bf02-560d-8309-29d74166634f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292073}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5b790374-4bad-5824-af22-323909fd339e" :question/math-academy-id "q-275244" :question/problem "Let $p=⟨2,1,-2⟩$ and $q=⟨3,2,0⟩.$ Find the exact value of the scalar projection of $p$ onto $q.$\n\n${\\text{comp}}_{q}\\,p=$\n{{field-1}}" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =\\frac{p\\cdot q}{|\\,q\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{2\\cdot 3+1\\cdot 2+(-2)\\cdot 0}{\\sqrt{{3}^{2}+{2}^{2}+{0}^{2}}} \\\\  & =\\frac{8}{\\sqrt{13}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186292827 :knowledge-point/_questions [{:db/id #edb/ref 17592186105917 :knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036" :knowledge-point/title "Calculating a Scalar Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7c90fa25-691f-58a4-b734-448a6fca3732" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186291159}] :answer-field/correct {:answer/id #uuid "7c90fa25-691f-58a4-b734-448a6fca3732" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186291159} :answer-field/id #uuid "3c398229-da8b-56ee-b803-4aa60968cde1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291938}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "911cdd8c-0aad-54d0-80d8-17350e5cfd46" :question/math-academy-id "q-275245" :question/problem "Let $c=⟨1,2,-3⟩$ and $d=⟨2,1,2⟩.$ Find the scalar projection of $c$ onto $d.$\n\n${\\text{comp}}_{d}\\,c=$\n{{field-1}}" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{d}\\,c & =\\frac{c\\cdot d}{|\\,d\\,|} \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{\\sqrt{{d}_{x}^{2}+{d}_{y}^{2}+{d}_{z}^{2}}} \\\\  & =\\frac{1\\cdot 2+2\\cdot 1+(-3)\\cdot 2}{\\sqrt{{2}^{2}+{1}^{2}+{2}^{2}}} \\\\  & =-\\frac{2}{\\sqrt{9}} \\\\  & =-\\frac{2}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186379360 :knowledge-point/_questions [{:db/id #edb/ref 17592186105916 :knowledge-point/id #uuid "e598ad1e-cee5-5d5f-b2a9-c067e4625cf6" :knowledge-point/title "Calculating a Scalar Projection Using Angles and Magnitudes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58363d5c-920b-5c26-a09f-feadb48d18af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\sqrt{2}" :db/id #edb/ref 17592186379362}] :answer-field/correct {:answer/id #uuid "58363d5c-920b-5c26-a09f-feadb48d18af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\sqrt{2}" :db/id #edb/ref 17592186379362} :answer-field/id #uuid "569ff198-8871-5c1e-bb50-e29a59fe2e29" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186379361}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "59d8a9a7-8383-53f6-9c1f-7b708ece3184" :question/math-academy-id "q-318969" :question/problem "Suppose $|\\,m\\,|=12$ and the angle between vectors $m$ and $n$ is $\\theta =\\frac{\\pi }{4}.$ Find the scalar projection of $m$ onto $n.$\n\n${\\text{comp}}_{n}\\,m=$\n{{field-1}}" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{n}\\,m & =|\\,m\\,|\\operatorname{cos}⁡\\theta  \\\\  & =12cos\\,(\\frac{\\pi }{4}) \\\\  & =12\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =6\\sqrt{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299704 :knowledge-point/_questions [{:db/id #edb/ref 17592186105916 :knowledge-point/id #uuid "e598ad1e-cee5-5d5f-b2a9-c067e4625cf6" :knowledge-point/title "Calculating a Scalar Projection Using Angles and Magnitudes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e39c7bca-ae4b-503b-9c4a-c72c47f4989e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186298530}] :answer-field/correct {:answer/id #uuid "e39c7bca-ae4b-503b-9c4a-c72c47f4989e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186298530} :answer-field/id #uuid "c1d8a04d-078a-5212-83f2-c8e21cfb63c6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299289}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3704c26f-1804-5b27-a680-7d8f815d3672" :question/math-academy-id "q-318975" :question/problem "Suppose $|\\,t\\,|=\\sqrt{2}$ and the angle between vectors $t$ and $u$ is $\\theta =\\frac{3\\pi }{4}.$ Find the scalar projection of $t$ onto $u.$\n\n${\\text{comp}}_{u}\\,t=$\n{{field-1}}" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{u}\\,t & =|\\,t\\,|\\operatorname{cos}⁡\\theta  \\\\  & =\\sqrt{2}cos\\,(\\frac{3\\pi }{4}) \\\\  & =\\sqrt{2}\\cdot (-\\frac{\\sqrt{2}}{2}) \\\\  & =-1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299709 :knowledge-point/_questions [{:db/id #edb/ref 17592186105917 :knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036" :knowledge-point/title "Calculating a Scalar Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ecac01c-6f18-504a-a708-bcf3faabfed9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{12}{13}" :db/id #edb/ref 17592186297750}] :answer-field/correct {:answer/id #uuid "2ecac01c-6f18-504a-a708-bcf3faabfed9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{12}{13}" :db/id #edb/ref 17592186297750} :answer-field/id #uuid "2737ed18-d118-51f4-b5e7-ebf40846ad60" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298768}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b5e680fa-ce4a-56db-a90a-7d183fdb5f25" :question/math-academy-id "q-318987" :question/problem "Let $m=⟨6,8,0⟩$ and $n=⟨0,5,12⟩.$ Find ${\\text{comp}}_{n}\\,m-{\\text{comp}}_{m}\\,n.$\n\n${\\text{comp}}_{n}\\,m-{\\text{comp}}_{m}\\,n=$\n{{field-1}}" :question/worked-solution "Using the scalar projection formula, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{n}\\,m & =\\frac{m\\cdot n}{|\\,n\\,|} \\\\  & =\\frac{{m}_{x}{n}_{x}+{m}_{y}{n}_{y}+{m}_{z}{n}_{z}}{\\sqrt{{n}_{x}^{2}+{n}_{y}^{2}+{n}_{z}^{2}}} \\\\  & =\\frac{(6)(0)+(8)(5)+(0)(12)}{\\sqrt{{0}^{2}+{5}^{2}+{12}^{2}}} \\\\  & =\\frac{40}{\\sqrt{169}} \\\\  & =\\frac{40}{13}.\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{m}\\,n & =\\frac{m\\cdot n}{|\\,m\\,|} \\\\  & =\\frac{{m}_{x}{n}_{x}+{m}_{y}{n}_{y}+{m}_{z}{n}_{z}}{\\sqrt{{m}_{x}^{2}+{m}_{y}^{2}+{m}_{z}^{2}}} \\\\  & =\\frac{40}{\\sqrt{{6}^{2}+{8}^{2}+{0}^{2}}} \\\\  & =\\frac{40}{\\sqrt{100}} \\\\  & =4.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\text{comp}}_{n}\\,m-{\\text{comp}}_{m}\\,n & =\\frac{40}{13}-4 \\\\  & =\\frac{40-52}{13} \\\\  & =-\\frac{12}{13}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299731 :knowledge-point/_questions [{:db/id #edb/ref 17592186105918 :knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f" :knowledge-point/title "Projecting a Vector Onto a Perpendicular Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a0452a64-927f-5d7d-b07e-4b57abd4d6a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186298259}] :answer-field/correct {:answer/id #uuid "a0452a64-927f-5d7d-b07e-4b57abd4d6a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186298259} :answer-field/id #uuid "0b238f8d-e0d9-5ffc-aee7-5172fbc4d28f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298671}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "252df411-1410-5fbc-a0ba-6a3198b7a34c" :question/math-academy-id "q-319171" :question/problem "Let $p=⟨4,1,-2⟩$ and $q=⟨1,x,3⟩.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =4\\cdot 1+1\\cdot x+(-2)\\cdot 3 \\\\  & =x-2.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ x-2 & =0 \\\\ x & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299736 :knowledge-point/_questions [{:db/id #edb/ref 17592186105918 :knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f" :knowledge-point/title "Projecting a Vector Onto a Perpendicular Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b09c2782-cc5c-5c6b-94f6-5ea932871845" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186298323}] :answer-field/correct {:answer/id #uuid "b09c2782-cc5c-5c6b-94f6-5ea932871845" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186298323} :answer-field/id #uuid "f27bc293-b846-5a95-9571-c426e151ab18" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299451}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "54bac378-b09e-5746-9da1-a5edf37aafcf" :question/math-academy-id "q-319252" :question/problem "Let $p=2i-3j+k$ and $q=xi+4j.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =2\\cdot x+(-3)\\cdot 4+1\\cdot 0 \\\\  & =2x-12.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 2x-12 & =0 \\\\ 2x & =12 \\\\ x & =6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186106478 :knowledge-point/_questions [{:db/id #edb/ref 17592186105916 :knowledge-point/id #uuid "e598ad1e-cee5-5d5f-b2a9-c067e4625cf6" :knowledge-point/title "Calculating a Scalar Projection Using Angles and Magnitudes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41075c73-ac32-50df-b67a-219517ab45b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9\\sqrt{2}" :db/id #edb/ref 17592186336641} {:answer/id #uuid "73b29c73-3eff-5a83-ab61-9d41933b2487" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186337074} {:answer/id #uuid "8850099e-98d9-52f0-8325-be56acb31a03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9\\sqrt{2}}{2}" :db/id #edb/ref 17592186337261} {:answer/id #uuid "e3364816-8691-5913-b547-c8e857be5fd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186338013} {:answer/id #uuid "f99cc284-6430-56f2-8e82-685f9498c0ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\sqrt{2}" :db/id #edb/ref 17592186338220}] :answer-field/correct {:answer/id #uuid "41075c73-ac32-50df-b67a-219517ab45b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9\\sqrt{2}" :db/id #edb/ref 17592186336641} :answer-field/id #uuid "3f5fea84-d7a3-5122-bf16-1ff190f164ea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338392}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7617fec2-cebf-5dcc-8f77-3696984cb4f2" :question/math-academy-id "q-71532" :question/problem "Suppose $|\\,c\\,|=18$ and the angle between vectors $c$ and $d$ is $\\theta =\\frac{3\\pi }{4}.$ Find the scalar projection of $c$ onto $d.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{d}\\,c & =|\\,c\\,|\\operatorname{cos}⁡\\theta  \\\\  & =18\\operatorname{cos}⁡(\\frac{3\\pi }{4}) \\\\  & =18\\cdot (-\\frac{\\sqrt{2}}{2}) \\\\  & =-9\\sqrt{2}.\\end{aligned}\n$$"}]}
