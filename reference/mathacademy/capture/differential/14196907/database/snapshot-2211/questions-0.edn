#{[{:db/id #edb/ref 17592186511585 :knowledge-point/_questions [{:db/id #edb/ref 17592186133770 :knowledge-point/id #uuid "1ea335d6-6ee6-514f-acd4-deb39d50cf81" :knowledge-point/title "Determining Components in Orthogonal Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ef489de-8397-5276-8e40-3eb47ebf67b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k=-5,-3" :db/id #edb/ref 17592186510928} {:answer/id #uuid "5906b509-0f5b-5789-9f64-085720db0c8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k=-1,5" :db/id #edb/ref 17592186510971} {:answer/id #uuid "6e2302e0-f4bc-50ea-baa8-9ed96b988bd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k=-3,5" :db/id #edb/ref 17592186511010} {:answer/id #uuid "ae47675e-e182-568c-9d7f-237b8107f5d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k=-5,-1" :db/id #edb/ref 17592186511145} {:answer/id #uuid "bb0dcb46-938d-5272-bee5-f7421c4009e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k=3,5" :db/id #edb/ref 17592186511166}] :answer-field/correct {:answer/id #uuid "3ef489de-8397-5276-8e40-3eb47ebf67b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k=-5,-3" :db/id #edb/ref 17592186510928} :answer-field/id #uuid "721d2419-eef5-5e91-a81c-c762d04fdf6d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186511367}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fff3565b-721f-5145-afe3-b8fe4b216b1a" :question/math-academy-id "q-140124" :question/problem "Let $u=[\\begin{aligned}7 \\\\ k \\\\ k \\\\ 3\\end{aligned}]$ and $v=[\\begin{aligned}3 \\\\ -k-1 \\\\ -7 \\\\ -12\\end{aligned}]$ be vectors such that  $u⊥v.$ Find the value of $k.$" :question/worked-solution "Since $u$ and $v$ are orthogonal vectors, we have that their dot product is equal to zero.\nFirst, let's calculate the dot product in terms of $k$:\n\n$$\n\\begin{aligned}u\\cdot v & ={u}_{1}\\cdot {v}_{1}+{u}_{2}\\cdot {v}_{2}+{u}_{3}\\cdot {v}_{3}+{u}_{4}\\cdot {v}_{4} \\\\  & =7\\cdot 3+k\\cdot (-k-1)+k\\cdot (-7)+3\\cdot (-12) \\\\  & =21-{k}^{2}-k-7k-36 \\\\  & =-{k}^{2}-8k-15 \\\\  & =-({k}^{2}+8k+15)\\end{aligned}\n$$\n\nEquating the dot product to zero, we have\n\n$$\n\\begin{aligned}-({k}^{2}+8k+15) & =0 \\\\ -(k+5)(k+3) & =0 \\\\ k & =-5,-3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186511476 :knowledge-point/_questions [{:db/id #edb/ref 17592186133771 :knowledge-point/id #uuid "bc757fa2-12ce-5a1c-a524-8eb256842079" :knowledge-point/title "Calculating Dot Products Using Orthogonal Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35773d41-e18d-5fce-a034-669f53d754f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-44" :db/id #edb/ref 17592186510901} {:answer/id #uuid "b40f3ee7-6d48-5c77-8c17-7b2922b35b60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186511155} {:answer/id #uuid "d3ab5e73-3550-5ce2-810e-1d8800b0a15b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-36" :db/id #edb/ref 17592186511218} {:answer/id #uuid "f914dd17-6ae2-5347-bb6e-00d10036b162" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186511291} {:answer/id #uuid "fab371f0-ea2c-5149-a335-661af52e0fef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "46" :db/id #edb/ref 17592186511298}] :answer-field/correct {:answer/id #uuid "35773d41-e18d-5fce-a034-669f53d754f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-44" :db/id #edb/ref 17592186510901} :answer-field/id #uuid "798ee90a-3456-534c-b511-46a11430e83e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186511373}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2cc2023e-80ab-5c70-bfaa-8494aaa05a23" :question/math-academy-id "q-140126" :question/problem "Let $u=[\\begin{aligned}-2 \\\\ 5 \\\\ 7 \\\\ 5\\end{aligned}],v=[\\begin{aligned}3 \\\\ 2 \\\\ -2 \\\\ 2\\end{aligned}]$ and $w=[\\begin{aligned}0 \\\\ 2 \\\\ 0 \\\\ -3\\end{aligned}]$ be vectors such that $u\\,⊥\\,v.$ Find $(u-2v)\\cdot (v+2w).$" :question/worked-solution "Since $u$ and $v$ are orthogonal vectors, we have that $u\\cdot v=0.$ Therefore, using linearity of the dot product to expand the parentheses, we have\n\n$$\n\\begin{aligned}(u-2v)\\cdot (v+2w) & =u\\cdot v-2(v\\cdot v)+2(u\\cdot w)-4(v\\cdot w) \\\\  & =0-2(v\\cdot v)+2(u\\cdot w)-4(v\\cdot w) \\\\  & =-2(3\\cdot 3+2\\cdot 2+(-2)\\cdot (-2)+2\\cdot 2) \\\\  & +2((-2)\\cdot 0+5\\cdot 2+7\\cdot 0+5\\cdot (-3)) \\\\  & -4(3\\cdot 0+2\\cdot 2+(-2)\\cdot 0+2\\cdot (-3)) \\\\  & =-2(21)+2(-5)-4(-2) \\\\  & =-42-10+8 \\\\  & =-44.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186134208 :knowledge-point/_questions [{:db/id #edb/ref 17592186133771 :knowledge-point/id #uuid "bc757fa2-12ce-5a1c-a524-8eb256842079" :knowledge-point/title "Calculating Dot Products Using Orthogonal Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89b6ff85-f42a-56b5-8c0b-fe4957ae33a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-34" :db/id #edb/ref 17592186131288} {:answer/id #uuid "f859d762-d713-5942-8f06-3119864140e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186131289} {:answer/id #uuid "1e47e0e9-d264-5699-b07a-6ff58251473e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "39" :db/id #edb/ref 17592186131290} {:answer/id #uuid "2380e67a-845f-5685-be8d-0605673de67f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186131291} {:answer/id #uuid "6541c1fd-bd8b-5328-ba73-28fec8404165" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186131292}] :answer-field/correct {:answer/id #uuid "6541c1fd-bd8b-5328-ba73-28fec8404165" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186131292} :answer-field/id #uuid "536e73dc-89d8-5e2f-8232-5d569d0b8fe8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186131287}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ae358486-c985-5c1a-bc7b-7505ecc708f0" :question/math-academy-id "q-39322" :question/problem "Let $u=[\\begin{aligned}4 \\\\ -2 \\\\ 1 \\\\ -3\\end{aligned}],v=[\\begin{aligned}-4 \\\\ 3 \\\\ 5 \\\\ 4\\end{aligned}]$ and $w=[\\begin{aligned}2 \\\\ -5 \\\\ 7 \\\\ -3\\end{aligned}]$ be vectors such that $v$ and $w$ are orthogonal. Find $(u+9v)\\cdot w+v\\cdot (u+7w).$" :question/worked-solution "Since $v$ and $w$ are orthogonal vectors, we have that $v\\cdot w=0.$ Therefore, using linearity of the dot product to expand the parentheses, we have\n\n$$\n\\begin{aligned}(u+9v)\\cdot w+v\\cdot (u+7w) & =u\\cdot w+(9v)\\cdot w+v\\cdot u+v\\cdot (7w) \\\\  & =u\\cdot w+9(v\\cdot w)+v\\cdot u+7(v\\cdot w) \\\\  & =u\\cdot w+9\\cdot 0+v\\cdot u+7\\cdot 0 \\\\  & =u\\cdot w+v\\cdot u \\\\  & =(4\\cdot 2+(-2)\\cdot (-5)+1\\cdot 7+(-3)\\cdot (-3)) \\\\  & +((-4)\\cdot 4+3\\cdot (-2)+5\\cdot 1+4\\cdot (-3)) \\\\  & =(8+10+7+9)+(-16-6+5-12) \\\\  & =34-29 \\\\  & =5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186511540 :knowledge-point/_questions [{:db/id #edb/ref 17592186133770 :knowledge-point/id #uuid "1ea335d6-6ee6-514f-acd4-deb39d50cf81" :knowledge-point/title "Determining Components in Orthogonal Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0250a6fc-047f-5134-8219-025d2c93f557" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186510780} {:answer/id #uuid "063cd8a4-7d99-5777-9168-56c532dfaca6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186510789} {:answer/id #uuid "63a57dbb-d4db-55f5-9f59-2754a4ca3e84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186510994} {:answer/id #uuid "7397c384-842b-5369-95fb-1b1cd887ef97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186511024} {:answer/id #uuid "bcbec869-0470-580f-b035-e097fc54e083" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186511169}] :answer-field/correct {:answer/id #uuid "063cd8a4-7d99-5777-9168-56c532dfaca6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186510789} :answer-field/id #uuid "3235cbb9-445e-59a3-8203-e82d292f2f8e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186511340}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a905591c-e962-54f6-a8cc-c6c8bf83d953" :question/math-academy-id "q-39987" :question/problem "If $u=[\\begin{aligned}1 \\\\ -3 \\\\ 2k \\\\ -2\\end{aligned}]$ and $v=[\\begin{aligned}-5 \\\\ 1 \\\\ 4 \\\\ k\\end{aligned}]$ are orthogonal vectors, then $k=$" :question/worked-solution "Since $u⊥v$, they are orthogonal vectors, we have that their dot product is equal to zero.\nFirst, let's calculate the dot product in terms of $k$:\n\n$$\n\\begin{aligned}u\\cdot v & ={u}_{1}\\cdot {v}_{1}+{u}_{2}\\cdot {v}_{2}+{u}_{3}\\cdot {v}_{3}+{u}_{4}\\cdot {v}_{4} \\\\  & =1\\cdot (-5)+(-3)\\cdot 1+2k\\cdot 4+(-2)\\cdot k \\\\  & =-5-3+8k-2k \\\\  & =6k-8\\end{aligned}\n$$\n\nEquating the dot product to zero, we have\n\n$$\n\\begin{aligned}6k-8 & =0 \\\\ 6k & =8 \\\\ k & =\\frac{4}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186511479 :knowledge-point/_questions [{:db/id #edb/ref 17592186133772 :knowledge-point/id #uuid "8e02a242-6ef9-574a-be2a-2b68b35d761c" :knowledge-point/title "Determining Components of a Vector Orthogonal to Two Given Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f1be44e-4c09-570b-900c-d5331c4a7cb2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186510811} {:answer/id #uuid "29d501de-e778-5839-9046-8064ae32b095" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186510868} {:answer/id #uuid "2e6d6850-cb8a-54f6-be70-b9a8c1c07ba7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186510879} {:answer/id #uuid "4bdaf9a0-53ad-54b2-b4b6-e33f7f3ff1c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186510947} {:answer/id #uuid "8f49ce40-633b-5445-b62b-5026574b4cc0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186511076}] :answer-field/correct {:answer/id #uuid "2e6d6850-cb8a-54f6-be70-b9a8c1c07ba7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186510879} :answer-field/id #uuid "c7504c88-811b-566a-be94-9e43fa618465" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186511420}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "308fc3e8-c583-59b4-999d-1160fdbc5784" :question/math-academy-id "q-74190" :question/problem "Let $u=[\\begin{aligned}a \\\\ -1 \\\\ b \\\\ 2\\end{aligned}],v=[\\begin{aligned}2 \\\\ 4 \\\\ -2 \\\\ 5\\end{aligned}],$ and $w=[\\begin{aligned}1 \\\\ -3 \\\\ 1 \\\\ -3\\end{aligned}]$ be vectors such that $u$ is orthogonal to $v$ and $w.$ What is the value of $a-b?$" :question/worked-solution "Given that $u$ is orthogonal to $v$ and $w$, we have\n\n$$\n\\{\\begin{aligned}u\\cdot v=0 \\\\ u\\cdot w=0.\\end{aligned}\n$$\n\nLet's consider the first equation $u\\cdot v=0.$ Calculating the dot product in terms of $a$ and $b$, we get\n\n$$\n\\begin{aligned}u\\cdot v & =0 \\\\ a\\cdot 2+(-1)\\cdot 4+b\\cdot (-2)+2\\cdot 5 & =0 \\\\ 2a-4-2b+10 & =0 \\\\ 2a-2b & =-6.\\end{aligned}\n$$\n\nSimilarly, for the second equation $u\\cdot w=0$, we obtain\n\n$$\n\\begin{aligned}u\\cdot w & =0 \\\\ a\\cdot 1+(-1)\\cdot (-3)+b\\cdot 1+2\\cdot (-3) & =0 \\\\ a+3+b-6 & =0 \\\\ a+b & =3.\\end{aligned}\n$$\n\nSo, to find the values of $a$ and $b$, we need to solve the system\n\n$$\n\\{\\begin{aligned}2a-2b=-6 \\\\ a+b=3.\\end{aligned}\n$$\n\nMultiplying the second equation by $-2$ and adding the result to the first equation, we obtain\n\n$$\n-4b=-12\\,⟹\\,b=3.\n$$\n\nSubstituting $b=3$ into the first equation, we get\n\n$$\n\\begin{aligned}2a-2(3) & =-6 \\\\ 2a-6 & =-6 \\\\ 2a & =0 \\\\ a & =0.\\end{aligned}\n$$\n\nFinally, we have that\n\n$$\na-b=0-3=-3.\n$$"}]}
