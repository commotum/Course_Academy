#{[{:db/id #edb/ref 17592186416356 :knowledge-point/_questions [{:db/id #edb/ref 17592186184207 :knowledge-point/id #uuid "1224e2dd-96bc-5c24-aacf-3c36a7c3a1e1" :knowledge-point/title "Calculating the Acute Angle Between a Vector and a Subspace"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10c81834-42ef-5852-b301-a6d3cbb3c8fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186416327} {:answer/id #uuid "970d7f5e-257f-5c6c-a87e-441a641de9a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186416338} {:answer/id #uuid "9f06a3b6-8e48-5d5d-b47c-2bf33ee89c30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186416339} {:answer/id #uuid "fb4520b1-1d35-57bb-b9ad-3e48af9ee8cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{8}" :db/id #edb/ref 17592186416349} {:answer/id #uuid "fd6421c2-2bc0-520a-be99-675b8f795b1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{12}" :db/id #edb/ref 17592186416350}] :answer-field/correct {:answer/id #uuid "10c81834-42ef-5852-b301-a6d3cbb3c8fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186416327} :answer-field/id #uuid "a54a21cb-93a2-537e-bb2f-71cc7631af9a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186416355}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0f199eb7-3af6-57bb-a681-cef6be591a7a" :question/math-academy-id "q-139476" :question/problem "Find the acute angle between the vector $x$ and the subspace spanned by the linearly independent vectors ${{a}_{1},{a}_{2}},$ where\n\n$$\n{a}_{1}=\\begin{bmatrix}-1 \\\\ 1 \\\\ 1\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}1 \\\\ -4 \\\\ -1\\end{bmatrix},\\,x=\\begin{bmatrix}2 \\\\ 2 \\\\ 0\\end{bmatrix}.\n$$" :question/worked-solution "The orthogonal projection of $x$ onto the subspace spanned by the columns of a matrix $A$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x=A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x.\n$$\n\nIn our case, we have\n\n$$\nA=\\begin{bmatrix}| & | \\\\ {a}_{1} & {a}_{2} \\\\ | & |\\end{bmatrix}=\\begin{bmatrix}-1 & 1 \\\\ 1 & -4 \\\\ 1 & -1\\end{bmatrix}\\,⟹\\,{A}^{T}=\\begin{bmatrix}-1 & 1 & 1 \\\\ 1 & -4 & -1\\end{bmatrix}.\n$$\n\nTherefore, we get the following projection:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =\\begin{bmatrix}-1 & 1 \\\\ 1 & -4 \\\\ 1 & -1\\end{bmatrix}\\cdot {(\\begin{bmatrix}-1 & 1 & 1 \\\\ 1 & -4 & -1\\end{bmatrix}\\cdot \\begin{bmatrix}-1 & 1 \\\\ 1 & -4 \\\\ 1 & -1\\end{bmatrix})}^{-1}\\cdot \\begin{bmatrix}-1 & 1 & 1 \\\\ 1 & -4 & -1\\end{bmatrix}\\cdot \\begin{bmatrix}2 \\\\ 2 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 & 1 \\\\ 1 & -4 \\\\ 1 & -1\\end{bmatrix}\\cdot {\\begin{bmatrix}3 & -6 \\\\ -6 & 18\\end{bmatrix}}^{-1}\\cdot \\begin{bmatrix}0 \\\\ -6\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 & 1 \\\\ 1 & -4 \\\\ 1 & -1\\end{bmatrix}\\cdot \\frac{1}{6}\\begin{bmatrix}6 & 2 \\\\ 2 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}0 \\\\ -6\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 & 1 \\\\ 1 & -4 \\\\ 1 & -1\\end{bmatrix}\\cdot \\begin{bmatrix}-2 \\\\ -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ 2 \\\\ -1\\end{bmatrix}\\end{aligned}\n$$\n\nThe acute angle between $x$ and $S$ is the acute angle between $x$ and ${\\text{proj}}_{S}x.$\n\nComputing the cosine using the dot product, we obtain\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{2\\cdot 1+2\\cdot 2+0\\cdot (-1)}{\\sqrt{{2}^{2}+{2}^{2}+{0}^{2}}\\sqrt{{1}^{2}+{2}^{2}+(-1)^{2}}} \\\\  & =\\frac{6}{\\sqrt{8}\\sqrt{6}} \\\\  & =\\frac{\\sqrt{6}}{2\\sqrt{2}} \\\\  & =\\frac{\\sqrt{3}}{2}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{\\sqrt{3}}{2})=\\frac{\\pi }{6},\n$$\n\nwhich is already an acute angle."}] [{:db/id #edb/ref 17592186184778 :knowledge-point/_questions [{:db/id #edb/ref 17592186184176 :knowledge-point/id #uuid "26b41192-9680-55c3-930c-52ff235e1800" :knowledge-point/title "Finding the Orthogonal Projection of a Vector Onto the Solution Space of a Linear System"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09f25da8-1536-541d-983b-95cee16bd959" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186416326} {:answer/id #uuid "4e40efb6-25f0-52a4-b9bd-0bfe176c7b25" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ 5 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186416331} {:answer/id #uuid "8b4af8f4-7d15-5294-891c-2810e7b0aee5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ 5 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186416337} {:answer/id #uuid "a6a69985-146d-572c-8484-4f24cfb9840f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{3}{5} \\\\ 5 \\\\ \\frac{9}{5}\\end{bmatrix}" :db/id #edb/ref 17592186416341} {:answer/id #uuid "be33eccb-cb9a-5eb3-8bb8-2724f8b921de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ 0 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186416344}] :answer-field/correct {:answer/id #uuid "8b4af8f4-7d15-5294-891c-2810e7b0aee5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ 5 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186416337} :answer-field/id #uuid "4bd4b417-69d9-54a6-aef3-a9bc3d8656f8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186416351}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "857ad938-6f3a-5185-b8e2-e07fd7263904" :question/math-academy-id "q-40213" :question/problem "Given the vector $x$ and the system of linear equations below, find the projection of $x$ onto the solution space of the system.\n\n$$\nx=\\begin{bmatrix}0 \\\\ 5 \\\\ 10\\end{bmatrix},\\,\\left\\{\\begin{aligned}{x}_{1}-3{x}_{3} &=0 \\\\ 3{x}_{1}-9{x}_{3} &=0\\end{aligned}\\right.\n$$" :question/worked-solution "First, we need to find a basis for the solution space of the system. \n\nConsider the augmented matrix $M$ of the system, which we reduce to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 0 & -3 & 0 \\\\ 3 & 0 & -9 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 & -3 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nIn the reduced matrix above, there is $1$ pivot column (the $1$st one). Thus, ${x}_{2},\\,{x}_{3}$ are free variables. Now, from the first equation, we get ${x}_{1}=3{x}_{3}.$ Therefore, the general solution is\n\n$$\n\\begin{bmatrix}3{x}_{3} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}={x}_{2}\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}+{x}_{3}\\begin{bmatrix}3 \\\\ 0 \\\\ 1\\end{bmatrix},\\,{x}_{2},\\,{x}_{3}\\in R.\n$$\n\nConsequently, $B={\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix},\\begin{bmatrix}3 \\\\ 0 \\\\ 1\\end{bmatrix}}$ is the basis of the solution space of the system.\n\nNow, we find the orthogonal projection of $x$ onto the solution space of the system:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x \\\\  & =\\begin{bmatrix}0 & 3 \\\\ 1 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot {(\\begin{bmatrix}0 & 1 & 0 \\\\ 3 & 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}0 & 3 \\\\ 1 & 0 \\\\ 0 & 1\\end{bmatrix})}^{-1}\\cdot \\begin{bmatrix}0 & 1 & 0 \\\\ 3 & 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}0 \\\\ 5 \\\\ 10\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 3 \\\\ 1 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot {\\begin{bmatrix}1 & 0 \\\\ 0 & 10\\end{bmatrix}}^{-1}\\cdot \\begin{bmatrix}5 \\\\ 10\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 3 \\\\ 1 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot \\frac{1}{10}\\begin{bmatrix}10 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}5 \\\\ 10\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 3 \\\\ 1 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}5 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 \\\\ 5 \\\\ 1\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186326865 :knowledge-point/_questions [{:db/id #edb/ref 17592186184176 :knowledge-point/id #uuid "26b41192-9680-55c3-930c-52ff235e1800" :knowledge-point/title "Finding the Orthogonal Projection of a Vector Onto the Solution Space of a Linear System"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ff68ced-affe-5cf1-a209-321681e9cf42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 \\\\ 4 \\\\ 5\\end{bmatrix}" :db/id #edb/ref 17592186324118} {:answer/id #uuid "3fa1b751-24d3-5fa8-9dca-424df4008b99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 \\\\ 2 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186324481} {:answer/id #uuid "5e34c046-3427-5dd1-8f5c-9c9e21ea754f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186324753} {:answer/id #uuid "c184f260-c54c-59a4-8e0e-833ee5bd8bac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 \\\\ 2 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186325635} {:answer/id #uuid "f156c4c0-9394-528f-8104-3954bd7c2c03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 \\\\ 5 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186326099}] :answer-field/correct {:answer/id #uuid "f156c4c0-9394-528f-8104-3954bd7c2c03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 \\\\ 5 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186326099} :answer-field/id #uuid "ba4e1a40-c1ef-5234-8ebc-e44a10f57fd2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326552}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c9d8685d-2896-58f6-9f97-cb8ee658ca47" :question/math-academy-id "q-40619" :question/problem "Given the vector $x$ and the system of linear equations below, find the projection of $x$ onto the solution space of the system.\n\n$$\nx=\\begin{bmatrix}5 \\\\ 5 \\\\ 0\\end{bmatrix},\\,\\left\\{\\begin{aligned}{x}_{1}-2{x}_{3} &=0 \\\\ 2{x}_{1}-4{x}_{3} &=0\\end{aligned}\\right.\n$$" :question/worked-solution "First, we need to find a basis for the solution space of the system. \n\nConsider the augmented matrix $M$ of the system, which we reduce to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 0 & -2 & 0 \\\\ 2 & 0 & -4 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 & -2 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nIn the reduced matrix above, there is $1$ pivot column (the $1$st one). Thus, ${x}_{2},\\,{x}_{3}$ are free variables. Now, from the first equation, we get ${x}_{1}=2{x}_{3}.$ Therefore, the general solution is\n\n$$\n\\begin{bmatrix}2{x}_{3} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}={x}_{2}\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}+{x}_{3}\\begin{bmatrix}2 \\\\ 0 \\\\ 1\\end{bmatrix},\\,{x}_{2},\\,{x}_{3}\\in R.\n$$\n\nConsequently, $B={\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix},\\begin{bmatrix}2 \\\\ 0 \\\\ 1\\end{bmatrix}}$ is the basis of the solution space of the system.\n\nNow, we find the orthogonal projection of $x$ onto the solution space of the system:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x \\\\  & =\\begin{bmatrix}0 & 2 \\\\ 1 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot {(\\begin{bmatrix}0 & 1 & 0 \\\\ 2 & 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}0 & 2 \\\\ 1 & 0 \\\\ 0 & 1\\end{bmatrix})}^{-1}\\cdot \\begin{bmatrix}0 & 1 & 0 \\\\ 2 & 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}5 \\\\ 5 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 2 \\\\ 1 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot {\\begin{bmatrix}1 & 0 \\\\ 0 & 5\\end{bmatrix}}^{-1}\\cdot \\begin{bmatrix}5 \\\\ 10\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 2 \\\\ 1 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot \\frac{1}{5}\\begin{bmatrix}5 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}5 \\\\ 10\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 2 \\\\ 1 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}5 \\\\ 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 \\\\ 5 \\\\ 2\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186351522 :knowledge-point/_questions [{:db/id #edb/ref 17592186184175 :knowledge-point/id #uuid "9d702975-166e-5067-ae3c-1152fade8248" :knowledge-point/title "Calculating the Distance Between a Vector and a Subspace"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19a27c44-5bdc-582c-99b5-93cfbceeaf44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186348660} {:answer/id #uuid "ab7e6a56-308c-5aeb-8c11-c77d5b949aad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186349966} {:answer/id #uuid "aeb41f53-3faf-5107-82c6-96159f3ba28d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186349991} {:answer/id #uuid "cf7c144a-2a57-5cf8-8e22-ad2a90299cbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186350270} {:answer/id #uuid "e31e0c34-f783-5e6a-a474-be334ac50d0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186350444}] :answer-field/correct {:answer/id #uuid "e31e0c34-f783-5e6a-a474-be334ac50d0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186350444} :answer-field/id #uuid "d7c816c8-b02c-5b1a-99fa-799633b36de0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186351082}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8e9c472f-14bb-508b-b17e-473ded83730d" :question/math-academy-id "q-83615" :question/problem "Find the distance between the vector $x$ and the subspace spanned by the linearly independent vectors ${{a}_{1},{a}_{2}},$ where\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ 0 \\\\ 1 \\\\ 0\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}-1 \\\\ 0 \\\\ 1 \\\\ 0\\end{bmatrix},\\,x=\\begin{bmatrix}2 \\\\ 3 \\\\ 5 \\\\ 4\\end{bmatrix}.\n$$" :question/worked-solution "The orthogonal projection of $x$ onto the subspace spanned by the columns of a matrix $A$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x=A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x.\n$$\n\nIn our case, we have \n\n$$\nA=\\begin{bmatrix}| & | \\\\ {a}_{1} & {a}_{2} \\\\ | & |\\end{bmatrix}=\\begin{bmatrix}1 & -1 \\\\ 0 & 0 \\\\ 1 & 1 \\\\ 0 & 0\\end{bmatrix}\\,⟹\\,{A}^{T}=\\begin{bmatrix}1 & 0 & 1 & 0 \\\\ -1 & 0 & 1 & 0\\end{bmatrix}.\n$$\n\nTherefore, we get the following projection:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =\\begin{bmatrix}1 & -1 \\\\ 0 & 0 \\\\ 1 & 1 \\\\ 0 & 0\\end{bmatrix}\\cdot {(\\begin{bmatrix}1 & 0 & -1 & 0 \\\\ -1 & 0 & 1 & 0\\end{bmatrix}\\,\\cdot \\,\\begin{bmatrix}1 & -1 \\\\ 0 & 0 \\\\ 1 & 1 \\\\ 0 & 0\\end{bmatrix})}^{-1}\\,\\,\\,\\,\\cdot \\,\\begin{bmatrix}1 & 0 & -1 & 0 \\\\ -1 & 0 & 1 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}2 \\\\ 3 \\\\ 5 \\\\ 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & -1 \\\\ 0 & 0 \\\\ 1 & 1 \\\\ 0 & 0\\end{bmatrix}\\cdot {\\begin{bmatrix}2 & 0 \\\\ 0 & 2\\end{bmatrix}}^{-1}\\cdot \\begin{bmatrix}7 \\\\ 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & -1 \\\\ 0 & 0 \\\\ 1 & 1 \\\\ 0 & 0\\end{bmatrix}\\cdot \\frac{1}{2}\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}7 \\\\ 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & -1 \\\\ 0 & 0 \\\\ 1 & 1 \\\\ 0 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}\\frac{7}{2} \\\\ \\frac{3}{2}\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 \\\\ 0 \\\\ 5 \\\\ 0\\end{bmatrix}=\\hat{x}\\end{aligned}\n$$\n\nFinally, the distance between $x$ and the subspace $S$ is given by\n\n$$\n\\begin{aligned}d(x,\\hat{x}) & =‖x-\\hat{x}‖ \\\\  & =\\sqrt{({x}_{1}-{\\hat{x}}_{1})^{2}+({x}_{2}-{\\hat{x}}_{2})^{2}+({x}_{3}-{\\hat{x}}_{3})^{2}+({x}_{4}-{\\hat{x}}_{4})^{2}} \\\\  & =\\sqrt{(2-2)^{2}+(3-0)^{2}+(5-5)^{2}+(4-0)^{2}} \\\\  & =\\sqrt{0+9+0+16} \\\\  & =\\sqrt{25} \\\\  & =5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186184854 :knowledge-point/_questions [{:db/id #edb/ref 17592186184207 :knowledge-point/id #uuid "1224e2dd-96bc-5c24-aacf-3c36a7c3a1e1" :knowledge-point/title "Calculating the Acute Angle Between a Vector and a Subspace"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9a0565bb-6aa9-5664-854b-5729adfe3769" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "35.26^{∘}" :db/id #edb/ref 17592186183734} {:answer/id #uuid "9c8da326-b57f-5cf8-bef8-0cea7d5aaece" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32.56^{∘}" :db/id #edb/ref 17592186183735} {:answer/id #uuid "b8661750-4cc0-55d6-a134-6daf4eb1b2de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "26.53^{∘}" :db/id #edb/ref 17592186183736} {:answer/id #uuid "299a5db2-b05f-5ebc-9e1d-b3964886832f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "56.32^{∘}" :db/id #edb/ref 17592186183737} {:answer/id #uuid "437ac4d5-1f5d-5a67-9777-4e11a553652e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "53.26^{∘}" :db/id #edb/ref 17592186183738}] :answer-field/id #uuid "74a712c5-be14-5628-b447-676a38bc98da" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186183733}] :question/id #uuid "c01292af-92a2-5636-a2fa-43836bcbfa48" :question/math-academy-id "q-86826" :question/problem "Find the acute angle between the vector $x$ and the subspace spanned by the linearly independent vectors ${a_{1}, a_{2}}$, where\n$a_{1} = \\begin{bmatrix}3 \\\\ -4 \\\\ 0\\end{bmatrix}, a_{2} = \\begin{bmatrix}4 \\\\ 3 \\\\ 0\\end{bmatrix}, x = \\begin{bmatrix}7 \\\\ -1 \\\\ 5\\end{bmatrix}$.\nRound the answer to $2$ decimal places.\n\n> A scientific calculator is required to answer this question." :question/requires-calculator true}]}
