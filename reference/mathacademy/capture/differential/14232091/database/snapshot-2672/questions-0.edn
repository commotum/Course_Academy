#{[{:db/id #edb/ref 17592186400881 :knowledge-point/_questions [{:db/id #edb/ref 17592186124522 :knowledge-point/id #uuid "289ae874-f555-50ee-896f-eb2188004124" :knowledge-point/title "Calculating the Eigenvalues of a 3x3 Matrix Containing a Block of Zeros"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7c340906-07d4-57b0-9046-295287f1840f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lambda \\in {3,0,6}" :db/id #edb/ref 17592186400883} {:answer/id #uuid "735c9554-2122-554a-9c6d-88f5c542af17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lambda \\in {3,4,9}" :db/id #edb/ref 17592186400884} {:answer/id #uuid "cf676211-b439-541c-a870-387de50e341e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lambda \\in {3,-2,6}" :db/id #edb/ref 17592186400885} {:answer/id #uuid "5f97e983-0e63-57dd-acda-842c7a7cfb12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lambda \\in {3,4,6}" :db/id #edb/ref 17592186400886} {:answer/id #uuid "812db70d-b4af-5153-8bf4-a315c5a42142" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lambda \\in {-3,4,6}" :db/id #edb/ref 17592186400887}] :answer-field/correct {:answer/id #uuid "5f97e983-0e63-57dd-acda-842c7a7cfb12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lambda \\in {3,4,6}" :db/id #edb/ref 17592186400886} :answer-field/id #uuid "8ed14d3f-a85e-59d0-a5e0-cd86b0195649" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400882}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f772a19b-8ab2-5f26-9ef1-47231e01914d" :question/math-academy-id "q-140449" :question/problem "Determine all real eigenvalues $\\lambda $ of the matrix \n$A=\\begin{bmatrix}4 & 0 & 0 \\\\ -5 & 3 & 0 \\\\ -4 & 1 & 6\\end{bmatrix}.$" :question/worked-solution "First, we find the matrix $\\,A-\\lambda I:$\n﻿﻿﻿\n\n$$\nA-\\lambda I=\\begin{bmatrix}4-\\lambda  & 0 & 0 \\\\ -5 & 3-\\lambda  & 0 \\\\ -4 & 1 & 6-\\lambda \\end{bmatrix}\n$$\n\nThe characteristic equation is $det(A-\\lambda I)=0.$ \n\nSince the determinant of a triangular (or diagonal) matrix is given by the product of the entries on the main diagonal, we obtain the following: \n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ \\begin{vmatrix}4-\\lambda  & 0 & 0 \\\\ -5 & 3-\\lambda  & 0 \\\\ -4 & 1 & 6-\\lambda \\end{vmatrix} & =0 \\\\ (4-\\lambda )(3-\\lambda )(6-\\lambda ) & =0 \\\\ (\\lambda -4)(\\lambda -3)(\\lambda -6) & =0\\end{aligned}\n$$\n\nTherefore, the eigenvalues are ${\\lambda }_{1}=3,$ $\\,{\\lambda }_{2}=4,$ and ${\\lambda }_{3}=6.$\n\n**Note:** The eigenvalues of a triangular (or diagonal) matrix are always the entries on the main diagonal."}] [{:db/id #edb/ref 17592186376089 :knowledge-point/_questions [{:db/id #edb/ref 17592186124641 :knowledge-point/id #uuid "64ba57cc-a3eb-582a-963b-b94895a20bac" :knowledge-point/title "Identifying Interior and Boundary Points From Linear Inequalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c2a38983-2ac2-5747-84de-52654204b669" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453442} {:answer/id #uuid "24fa1281-9195-576c-958f-f5a1cd7756b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453443}] :answer-field/correct {:answer/id #uuid "24fa1281-9195-576c-958f-f5a1cd7756b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453443} :answer-field/id #uuid "b974481d-3120-5f01-a603-07099f42a784" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454471} {:answer-field/choices [{:answer/id #uuid "5f4a6e95-fed8-5f60-b3be-40a55090ad74" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453444} {:answer/id #uuid "0fc66c24-39c8-55f8-949a-fd3c22a45e0b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453445}] :answer-field/correct {:answer/id #uuid "5f4a6e95-fed8-5f60-b3be-40a55090ad74" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453444} :answer-field/id #uuid "4ab5754e-a652-5899-87ab-53e612a79fd5" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454472} {:answer-field/choices [{:answer/id #uuid "c545dbcc-3d3d-5d7f-8c9e-39f107e5337c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453446} {:answer/id #uuid "7b177e0f-f566-534e-911c-092b634ea208" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453447}] :answer-field/correct {:answer/id #uuid "c545dbcc-3d3d-5d7f-8c9e-39f107e5337c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453446} :answer-field/id #uuid "7ac4f957-7cd7-55eb-a39f-2fc8342eb8a5" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454473}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7257b8a6-8ea5-5027-98d4-5845f1b59c79" :question/math-academy-id "q-158548" :question/problem "The set $A$ and its boundary $∂A$ are given by\n\n$$\nA={(x,y)\\in {R}^{2}:y<x+3},\\,∂A={(x,y)\\in {R}^{2}:y=x+3}.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The point $P(-2,1)$ lies on the boundary of $A$\n- **II.** The point $P(-2,1)$ belongs to $A$\n- **III.** The point $Q(-2,3)$ is an interior point of $A$" :question/worked-solution "Let $\\delta >0.$ A *neighborhood* of a point ${x}_{0}$ is the set of points whose distance from ${x}_{0}$ is less than $\\delta .$\n\n$$\n{x:|x-{x}_{0}|<\\delta }\n$$\n\nIn two-dimensional space, a neighborhood of ${x}_{0}$ is the open disc $|x-{x}_{0}|<\\delta ,$ as shown below.\n\n![](images/50/50a6c72e169f3104eb0b9958673cc6644f770e6bcc3ebf23360eb20189325a28.png)\n\nFurthermore, we have the following definitions:\n\n- A point ${x}_{0}$ is an *interior point* of a set $S$ if $S$ contains *some* neighborhood of ${x}_{0}.$ The set of all interior points of $S$ is called the *interior* of $S.$\n\n- A point ${x}_{0}$ is a *boundary point* of a set $S$ if *every* neighborhood of ${x}_{0}$ contains points that are in $S$ and points that are not in $S.$ \nThe set of all boundary points of $S$ is called the *boundary* of $S.$\n\nNow, the set $A$ consists of all points that lie below the line $y=x+3.$ A sketch of this region is shown below:\n\n![](images/7a/7a23cbece856b7b842d5907665af5ea593a06faea79283b1be13fc4382e0bf26.png)\n\nLet's add the points $P(-2,1)$ and $Q(-2,3)$ and some neighborhoods of these points to our diagram.\n\n![](images/82/82c921570bbc1ce700db5472871048c14c67df7d6895962f87454c70fc1ce192.png)\n\nLet's examine the statements in turn.\n\n- Statement I is true. The coordinates of $P(-2,1)$ satisfy $y=x+3.$ Hence, $P$ lies in the set $∂A,$ the boundary of $A.$\n\n- Statement II is false. The coordinates of $P(-2,1)$ do not satisfy the inequality $y<x+3.$ Hence, $P$ does not lie in the set $A.$\n\n- Statement III is false. Indeed, $Q$ is not an interior point of $A$ since any neighborhood of $Q$ contains at least one point *outside* the set.\n\nTherefore, the correct answer is 'I only.'"}] [{:db/id #edb/ref 17592186124993 :knowledge-point/_questions [{:db/id #edb/ref 17592186124497 :knowledge-point/id #uuid "7f58bd46-07f7-54a5-8499-5e4e3515b610" :knowledge-point/title "Finding the Coordinates of a Vector in a New Basis Given Its Coordinates in the Standard Basis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1dcd4ef1-4949-58ef-aa67-9540954fdc1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186321374} {:answer/id #uuid "41ecfd30-c58f-5e8b-8238-dbc9493bac67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186321670} {:answer/id #uuid "46420e90-1c10-5b3a-a995-8806f1bcee0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186321702} {:answer/id #uuid "6e560467-13af-562b-ad43-d89f3b3f3260" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ -4\\end{bmatrix}" :db/id #edb/ref 17592186322002} {:answer/id #uuid "d1bf20ff-37e7-5af1-a632-1f6b46091107" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ -4\\end{bmatrix}" :db/id #edb/ref 17592186322785}] :answer-field/correct {:answer/id #uuid "46420e90-1c10-5b3a-a995-8806f1bcee0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186321702} :answer-field/id #uuid "4370689f-d468-5230-a5de-f45535b13a11" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323298}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9b5f682f-a0de-52f6-930d-b54c3a22eede" :question/math-academy-id "q-36488" :question/problem "$$\nB={\\begin{bmatrix}3 \\\\ -2\\end{bmatrix},\\begin{bmatrix}9 \\\\ -8\\end{bmatrix}},\\,[x]_{S}=\\begin{bmatrix}-6 \\\\ 4\\end{bmatrix}\n$$\n\nThe basis $B$ of ${R}^{2}$ and the coordinates of the vector $x$ relative to the standard basis $S$ are given above. Find $[x]_{B}.$" :question/worked-solution "We will use the change-of-coordinates formula in the form\n\n$$\n[\\,x\\,]_{B}={P}_{S\\to B}[\\,x\\,]_{S}.\n$$\n\nFirst, recall that the change-of-coordinates matrix from $B$ to $S$ is the matrix whose columns are the vectors of $B$ relative to the standard basis $S.$ As a result, we have\n\n$$\n{P}_{B\\to S}=\\begin{bmatrix}3 & 9 \\\\ -2 & -8\\end{bmatrix}.\n$$\n\nNow, we need to find the change-of-coordinates matrix ${P}_{S\\to B}$ from $S$ to $B.$ To do that, we compute the inverse of ${P}_{B\\to S}:$\n\n$$\n\\begin{aligned}{P}_{S\\to B} & ={P}_{B\\to S}^{-1} \\\\  & ={\\begin{bmatrix}3 & 9 \\\\ -2 & -8\\end{bmatrix}}^{-1} \\\\  & =\\frac{1}{3\\cdot (-8)-9\\cdot (-2)}\\begin{bmatrix}-8 & -9 \\\\ 2 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{4}{3} & \\frac{3}{2} \\\\ -\\frac{1}{3} & -\\frac{1}{2}\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, we compute $[\\,x\\,]_{B}:$\n\n$$\n\\begin{aligned}[\\,x\\,]_{B} & ={P}_{S\\to B}[\\,x\\,]_{S} \\\\  & =\\begin{bmatrix}\\frac{4}{3} & \\frac{3}{2} \\\\ -\\frac{1}{3} & -\\frac{1}{2}\\end{bmatrix}\\begin{bmatrix}-6 \\\\ 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 \\\\ 0\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186134330 :knowledge-point/_questions [{:db/id #edb/ref 17592186133800 :knowledge-point/id #uuid "d23c4292-6fdd-5cba-a2e7-0f4d770b2309" :knowledge-point/title "Finding the Least-Squares Solution of a Linear System Given in Matrix Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cb5e5021-22ed-5708-8c71-27b446671469" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{4}{3} \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186132020} {:answer/id #uuid "01c37c06-2ef5-5b19-9a94-7df43829df7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ \\frac{2}{3}\\end{bmatrix}" :db/id #edb/ref 17592186132021} {:answer/id #uuid "0a50c4d2-31f3-5acc-8efa-c25a210550e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186132022} {:answer/id #uuid "5ec7fca8-58e8-59ac-88f5-edf5552e52b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ \\frac{4}{3}\\end{bmatrix}" :db/id #edb/ref 17592186132023} {:answer/id #uuid "6c787549-46d0-5175-bb7a-d2602a7e0318" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ \\frac{4}{3}\\end{bmatrix}" :db/id #edb/ref 17592186132024}] :answer-field/id #uuid "15282714-ca78-5daf-8840-109d81c6e157" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186132019}] :question/id #uuid "3c069118-41f8-5f1c-bae8-57e084a8f67d" :question/math-academy-id "q-40892" :question/problem "Given that the columns of $A$ are linearly independent, find the least-squares solution of $Ax = b$, where\n\n$A = \\begin{bmatrix}1 & -1 \\\\ 1 & 0 \\\\ 2 & -1\\end{bmatrix}$ and $b = \\begin{bmatrix}1 \\\\ 2 \\\\ 1\\end{bmatrix}$."}] [{:db/id #edb/ref 17592186351409 :knowledge-point/_questions [{:db/id #edb/ref 17592186133912 :knowledge-point/id #uuid "8aef330a-81b3-56c4-9559-67df673e8687" :knowledge-point/title "Calculating the Determinant of a Matrix With Two Proportional Rows/Columns"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1436ec4c-88ce-5432-b5fc-bcc3977df9e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$|B|$ and $|C|$ only" :db/id #edb/ref 17592186348619} {:answer/id #uuid "342c9e0d-3bc9-5d1a-8dd8-5ffecbcb9eac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$|A|$ and $|C|$ only" :db/id #edb/ref 17592186348914} {:answer/id #uuid "6b821ea4-e43b-587c-b76b-a99bc45b8052" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$|C|$ only" :db/id #edb/ref 17592186349435} {:answer/id #uuid "81799b75-c13d-51a1-8f2d-733e3a588cf6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$|B|$ only" :db/id #edb/ref 17592186349640} {:answer/id #uuid "bd651af3-ee69-50d4-93e1-b295f7f633b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$|A|$ and $|B|$ only" :db/id #edb/ref 17592186350130}] :answer-field/correct {:answer/id #uuid "1436ec4c-88ce-5432-b5fc-bcc3977df9e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$|B|$ and $|C|$ only" :db/id #edb/ref 17592186348619} :answer-field/id #uuid "a5128805-4f2a-5632-93d8-b430aa5f4d2b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350986}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dec8cece-e79e-5652-812a-3c79c57417e9" :question/math-academy-id "q-82289" :question/problem "Which of the following determinants are equal to $0?$\n\n$$\n|A|=|\\begin{aligned}4 & 0 & 0 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & 3\\end{aligned}|,\\,|B|=|\\begin{aligned}0 & -2 & 9 \\\\ 0 & 2 & \\sqrt{3} \\\\ 0 & 1 & -8\\end{aligned}|,\\,|C|=|\\begin{aligned}0 & 2 & -4 \\\\ 1 & \\sqrt{5} & -2\\sqrt{5} \\\\ 0 & -1 & 2\\end{aligned}|\n$$" :question/worked-solution "Let's examine each of the given determinants in turn.\n\n- The matrix $A$ is a diagonal matrix, hence \n\n$$\n|A|=4\\cdot (-2)\\cdot 3=-24\\ne 0.\n$$\n\n- The matrix $B$ has a zero column: \n\n$$\nB=\\begin{bmatrix}0 & -2 & 9 \\\\ 0 & 2 & \\sqrt{3} \\\\ 0 & 1 & -8\\end{bmatrix}\n$$\n\nAs a result, $|B|=0.$\n\n- The matrix $C$ has proportional columns: \n\n$$\nC=\\begin{bmatrix}0 & 2 & -4 \\\\ 1 & \\sqrt{5} & -2\\sqrt{5} \\\\ 0 & -1 & 2\\end{bmatrix}\n$$\n\nAs a result, $|C|=0.$\n\nTherefore, only $|B|$ and $|C|$ are equal to $0.$"}]}
