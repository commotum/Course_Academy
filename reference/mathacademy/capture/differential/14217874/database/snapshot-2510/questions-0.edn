/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186530302} {:answer-field/choices [{:answer/id #uuid "39569a1f-2e66-5384-ace7-da0664c4510c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186529709}] :answer-field/correct {:answer/id #uuid "39569a1f-2e66-5384-ace7-da0664c4510c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186529709} :answer-field/id #uuid "a52a652f-b9e1-519a-bfb0-ecb9365c4180" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186530335}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d8078445-7f57-54e9-9fc5-bfc3757a9189" :question/math-academy-id "q-264884" :question/problem "Given the function $f(x,y,z)={x}^{2}+{y}^{2}+{z}^{2}$, compute ${∇}_{x,z}({∇}_{x,z}\\,f).$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\" width=\"30px\">${∇}_{x,z}({∇}_{x,z}f)=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"30px\">{{field-2}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\" width=\"30px\">{{field-4}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "First, we take the variable subset gradient:\n\n$$\n\\begin{aligned}{∇}_{x,z}\\,f & =[\\begin{aligned}\\frac{∂}{∂x}({x}^{2}+{y}^{2}+{z}^{2}) \\\\ \\frac{∂}{∂z}({x}^{2}+{y}^{2}+{z}^{2})\\end{aligned}]=[\\begin{aligned}2x \\\\ 2z\\end{aligned}]\\end{aligned}\n$$\n\nNext, we compute the second derivatives with respect to $x$ and $z$:\n\n$$\n\\begin{aligned} & \\frac{∂}{∂x}(2x)=2\\,\\, &  & \\frac{∂}{∂z}(2x)=0 \\\\  & \\frac{∂}{∂x}(2z)=0\\,\\, &  & \\frac{∂}{∂z}(2z)=2\\end{aligned}\n$$\n\nTherefore, we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{x,z}({∇}_{x,z}\\,f) & =[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂z} \\\\ \\frac{{∂}^{2}f}{∂z∂x} & \\frac{{∂}^{2}f}{∂{z}^{2}}\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 0 \\\\ 0 & 2\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186530538 :knowledge-point/_questions [{:db/id #edb/ref 17592186204088 :knowledge-point/id #uuid "26c6e982-dcf3-5521-84d9-5d8ca8b51a33" :knowledge-point/title "Computing Second-Order Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a961726f-d2e5-5c4e-aa58-b8b021e50fd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "ze^{yz}" :db/id #edb/ref 17592186530000}] :answer-field/correct {:answer/id #uuid "a961726f-d2e5-5c4e-aa58-b8b021e50fd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "ze^{yz}" :db/id #edb/ref 17592186530000} :answer-field/id #uuid "44a70234-afbd-5b95-b6d0-57f5d9b17da8" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186530268} {:answer-field/choices [{:answer/id #uuid "b9887375-d8c7-5b8f-8932-603f171ad7b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186530046}] :answer-field/correct {:answer/id #uuid "b9887375-d8c7-5b8f-8932-603f171ad7b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186530046} :answer-field/id #uuid "54132b05-6b53-5a59-a55a-32250c5ba899" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186530280} {:answer-field/choices [{:answer/id #uuid "0e1601a7-b20b-5f51-9f9a-5b71e91349ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "xz^2e^{yz}" :db/id #edb/ref 17592186529606}] :answer-field/correct {:answer/id #uuid "0e1601a7-b20b-5f51-9f9a-5b71e91349ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "xz^2e^{yz}" :db/id #edb/ref 17592186529606} :answer-field/id #uuid "7075f514-a4aa-5bcc-8c11-8e3071322458" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186530303} {:answer-field/choices [{:answer/id #uuid "c3559be5-9ddd-5be3-86e4-201b8acfad49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "ze^{yz}" :db/id #edb/ref 17592186530069}] :answer-field/correct {:answer/id #uuid "c3559be5-9ddd-5be3-86e4-201b8acfad49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "ze^{yz}" :db/id #edb/ref 17592186530069} :answer-field/id #uuid "c27b4e5d-55a0-5453-9ef5-40b4c02e0023" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186530358}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ef911a6f-8eaa-541f-ada4-10af4c9994c6" :question/math-academy-id "q-264888" :question/problem "Given the function $f(x,y,z)=x{e}^{yz}$, compute ${∇}_{x,y}({∇}_{x,y}\\,f).$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\" width=\"30px\">${∇}_{x,y}({∇}_{x,y}f)=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"30px\">{{field-2}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\" width=\"30px\">{{field-4}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "First, we take the variable subset gradient:\n\n$$\n\\begin{aligned}{∇}_{x,y}\\,f & =[\\begin{aligned}\\frac{∂}{∂x}(x{e}^{yz}) \\\\ \\frac{∂}{∂y}(x{e}^{yz})\\end{aligned}]=[\\begin{aligned}{e}^{yz} \\\\ xz{e}^{yz}\\end{aligned}]\\end{aligned}\n$$\n\nNext, we compute the second derivatives with respect to $x$ and $y$:\n\n$$\n\\begin{aligned} & \\frac{∂}{∂x}({e}^{yz})=0\\,\\, &  & \\frac{∂}{∂y}({e}^{yz})=z{e}^{yz} \\\\  & \\frac{∂}{∂x}(xz{e}^{yz})=z{e}^{yz}\\,\\, &  & \\frac{∂}{∂y}(xz{e}^{yz})=x{z}^{2}{e}^{yz}\\end{aligned}\n$$\n\nTherefore, we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{x,y}({∇}_{x,y}\\,f) & =[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{aligned}] \\\\  & =[\\begin{aligned}0 & z{e}^{yz} \\\\ z{e}^{yz} & x{z}^{2}{e}^{yz}\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186530460 :knowledge-point/_questions [{:db/id #edb/ref 17592186204088 :knowledge-point/id #uuid "26c6e982-dcf3-5521-84d9-5d8ca8b51a33" :knowledge-point/title "Computing Second-Order Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c17d935-f775-5590-88e7-edcdebf8bd8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}_{1}^{2}{x}_{2}^{2}" :db/id #edb/ref 17592186529762}] :answer-field/correct {:answer/id #uuid "4c17d935-f775-5590-88e7-edcdebf8bd8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}_{1}^{2}{x}_{2}^{2}" :db/id #edb/ref 17592186529762} :answer-field/id #uuid "55bfc75f-a93f-5dfe-96f2-3fb987481cc6" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186530282} {:answer-field/choices [{:answer/id #uuid "739a1a33-00b9-5a65-8501-5416e50ad146" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{x}_{1}{x}_{2}" :db/id #edb/ref 17592186529876}] :answer-field/correct {:answer/id #uuid "739a1a33-00b9-5a65-8501-5416e50ad146" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{x}_{1}{x}_{2}" :db/id #edb/ref 17592186529876} :answer-field/id #uuid "ccec45eb-e36c-58f6-8fd2-058caac8f5c0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186530368}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5ab6642a-36f8-590a-a631-0cf8a7d2875f" :question/math-academy-id "q-264894" :question/problem "Given the function $f(x;w)=({w}_{1}-{w}_{2}{x}_{1}{x}_{2})^{2},$ compute ${∇}_{w}({∇}_{w}\\,f).$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\" width=\"40px\">${∇}_{w}({∇}_{w}\\,f)=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"50px\">$2$</td>\n<td align=\"center\" width=\"50px\">$-2{x}_{1}{x}_{2}$</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\" width=\"30px\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "First, we compute ${∇}_{w}\\,f$:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂{w}_{1}} & =\\frac{∂}{∂{w}_{1}}({w}_{1}-{w}_{2}{x}_{1}{x}_{2})^{2}=2({w}_{1}-{w}_{2}{x}_{1}{x}_{2}) \\\\ \\frac{∂f}{∂{w}_{2}} & =\\frac{∂}{∂{w}_{2}}({w}_{1}-{w}_{2}{x}_{1}{x}_{2})^{2}=-2{x}_{1}{x}_{2}({w}_{1}-{w}_{2}{x}_{1}{x}_{2})\\end{aligned}\n$$\n\nNext, we compute the second derivatives:\n\n$$\n\\begin{aligned} & \\frac{{∂}^{2}f}{∂{w}_{1}^{2}}=2\\,\\, &  & \\frac{{∂}^{2}f}{∂{w}_{1}∂{w}_{2}}=-2{x}_{1}{x}_{2} \\\\  & \\frac{{∂}^{2}f}{∂{w}_{2}∂{w}_{1}}=-2{x}_{1}{x}_{2}\\,\\, &  & \\frac{{∂}^{2}f}{∂{w}_{2}^{2}}=2{x}_{1}^{2}{x}_{2}^{2}\\end{aligned}\n$$\n\nTherefore, we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{w}({∇}_{w}\\,f) & =[\\begin{aligned}\\frac{{∂}^{2}f}{∂{w}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{w}_{1}∂{w}_{2}} \\\\ \\frac{{∂}^{2}f}{∂{w}_{2}∂{w}_{1}} & \\frac{{∂}^{2}f}{∂{w}_{2}^{2}}\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -2{x}_{1}{x}_{2} \\\\ -2{x}_{1}{x}_{2} & 2{x}_{1}^{2}{x}_{2}^{2}\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186530511 :knowledge-point/_questions [{:db/id #edb/ref 17592186204088 :knowledge-point/id #uuid "26c6e982-dcf3-5521-84d9-5d8ca8b51a33" :knowledge-point/title "Computing Second-Order Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "313b6c49-910b-52c6-8051-61e7626042a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2x_1x_2" :db/id #edb/ref 17592186529689}] :answer-field/correct {:answer/id #uuid "313b6c49-910b-52c6-8051-61e7626042a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2x_1x_2" :db/id #edb/ref 17592186529689} :answer-field/id #uuid "4cae36c3-55f0-5e58-bd81-7c16e62cd866" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186530274} {:answer-field/choices [{:answer/id #uuid "a9557a7d-9551-5e98-ae9a-30fb415b45e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186529999}] :answer-field/correct {:answer/id #uuid "a9557a7d-9551-5e98-ae9a-30fb415b45e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186529999} :answer-field/id #uuid "719abbb9-5ca4-5379-92e1-d05725f856bc" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186530306}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b3c9497c-975d-55aa-bb92-1acbe4b3e0fa" :question/math-academy-id "q-264898" :question/problem "Given the function $f(x;w)=({w}_{1}{x}_{1}{x}_{2}-{w}_{2})^{2},$ compute ${∇}_{w}({∇}_{w}\\,f).$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\" width=\"30px\">${∇}_{w}({∇}_{w}\\,f)=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">$2{x}_{1}^{2}{x}_{2}^{2}$</td>\n<td align=\"center\" width=\"30px\">$-2{x}_{1}{x}_{2}$</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\" width=\"30px\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "First, we compute ${∇}_{w}\\,f$:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂{w}_{1}} & =\\frac{∂}{∂{w}_{1}}({w}_{1}{x}_{1}{x}_{2}-{w}_{2})^{2}=2{x}_{1}{x}_{2}({w}_{1}{x}_{1}{x}_{2}-{w}_{2}) \\\\ \\frac{∂f}{∂{w}_{2}} & =\\frac{∂}{∂{w}_{2}}({w}_{1}{x}_{1}{x}_{2}-{w}_{2})^{2}=-2({w}_{1}{x}_{1}{x}_{2}-{w}_{2})\\end{aligned}\n$$\n\nNext, we compute the second derivatives:\n\n$$\n\\begin{aligned} & \\frac{{∂}^{2}f}{∂{w}_{1}^{2}}=2{x}_{1}^{2}{x}_{2}^{2}\\,\\, &  & \\frac{{∂}^{2}f}{∂{w}_{1}∂{w}_{2}}=-2{x}_{1}{x}_{2} \\\\  & \\frac{{∂}^{2}f}{∂{w}_{2}∂{w}_{1}}=-2{x}_{1}{x}_{2}\\,\\, &  & \\frac{{∂}^{2}f}{∂{w}_{2}^{2}}=2\\end{aligned}\n$$\n\nTherefore, we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{w}({∇}_{w}\\,f) & =[\\begin{aligned}\\frac{{∂}^{2}f}{∂{w}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{w}_{1}∂{w}_{2}} \\\\ \\frac{{∂}^{2}f}{∂{w}_{2}∂{w}_{1}} & \\frac{{∂}^{2}f}{∂{w}_{2}^{2}}\\end{aligned}] \\\\  & =[\\begin{aligned}2{x}_{1}^{2}{x}_{2}^{2} & -2{x}_{1}{x}_{2} \\\\ -2{x}_{1}{x}_{2} & 2\\end{aligned}]\\end{aligned}\n$$"}]}
