1}+{w}_{2}{x}_{2}+{w}_{3}{x}_{3})={x}_{2} \\\\ \\frac{∂f}{∂{w}_{3}} & =\\frac{∂}{∂{w}_{3}}({w}_{1}{x}_{1}+{w}_{2}{x}_{2}+{w}_{3}{x}_{3})={x}_{3}\\end{aligned}\n$$\n\nTherefore, with $x={[\\begin{aligned}1,\\,2,\\,3\\end{aligned}]}^{T},$ we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{w}\\,f & =[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 2 \\\\ 3\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186530536 :knowledge-point/_questions [{:db/id #edb/ref 17592186204087 :knowledge-point/id #uuid "64331ffc-80a5-50c1-a7ac-d346458ce997" :knowledge-point/title "Computing Vector Subset Gradients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d22266dc-cfbc-512d-a019-89790bf4b094" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186530106}] :answer-field/correct {:answer/id #uuid "d22266dc-cfbc-512d-a019-89790bf4b094" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186530106} :answer-field/id #uuid "32606a0e-d412-54f9-b88b-46f91f22715a" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186530257} {:answer-field/choices [{:answer/id #uuid "1cabe206-5d13-582b-b17f-73cbfbed6d40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186529637}] :answer-field/correct {:answer/id #uuid "1cabe206-5d13-582b-b17f-73cbfbed6d40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186529637} :answer-field/id #uuid "8d5827b7-8650-5441-839c-9a5f22f87096" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186530325} {:answer-field/choices [{:answer/id #uuid "f35f9211-b4cf-504b-99bc-694fe65a