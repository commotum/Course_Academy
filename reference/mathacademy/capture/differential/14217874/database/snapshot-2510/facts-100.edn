f841eb9-ea63-531b-90a6-805faeb34a87" #edb/ref 17592186045417] [17592186530418 #edb/ref 1068 #edb/ref 17592186530322 #edb/ref 17592186045417] [17592186530418 #edb/ref 1068 #edb/ref 17592186530342 #edb/ref 17592186045417] [17592186530418 #edb/ref 1069 "q-264862" #edb/ref 17592186045417] [17592186530418 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186530418 #edb/ref 1071 "Given the function \n$f(x;w)={w}_{1}{x}_{1}+{w}_{2}{x}_{2},$\ncompute ${∇}_{w}\\,f$ with the input $x={[\\begin{aligned}5,\\,3\\end{aligned}]}^{T}.$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\" width=\"30px\">${∇}_{w}\\,f=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" #edb/ref 17592186045417] [17592186530418 #edb/ref 1072 #uuid "04bbc763-6f33-5643-bfea-ba99c7a847f8" #edb/ref 17592186045417] [17592186530418 #edb/ref 1074 "To compute ${∇}_{w}\\,f$, we take partial derivatives with respect to each component of $w.$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂{w}_{1}} & =\\frac{∂}{∂{w}_{1}}({w}_{1}{x}_{1}+{w}_{2}{x}_{2})={x}_{1} \\\\ \\frac{∂f}{∂{w}_{2}} & =\\frac{∂}{∂{w}_{2}}({w}_{1}{x}_{1}+{w}_{2}{x}_{2})={x}_{2}\\end{aligned}\n$$\n\nTherefore, with $x={[\\begin{aligned}5,\\,3\\end{aligned}]}^{T},$ we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{w}\\,f & =[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] \\\\  & =[\\begin{aligned}5 \\\\ 3\\end{aligned}]\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186530425 #edb/ref 1068 #edb/ref 17592186530218 #edb/ref 17592186045417] [17592186530425 #edb/ref 1068 #edb/ref 17592186530256 #edb/ref 17592186045417] [17592186530425 #edb/ref 1069 "q-264843" #edb/ref 17592186045417] [17592186530425 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186530425 #edb/ref 1071 "Given the quadratic function $f(x;a,b)=a{x}^{2}+bx,$ compute ${∇}_{a,b}\\,f.$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\" width=\"30px\">${∇}_{a,b}\\,f=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" #edb/ref 17592186045417] [17592186530425 #edb/ref 1072 #uuid "15f52165-8151-599f-bfe3-492fccf77d4a" #edb/ref 17592186045417] [17592186530425 #edb/ref 1074 "To compute ${∇}_{a,b}\\,f$, we take partial derivatives with respect to $a$ and $b.$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂a} & =\\frac{∂}{∂a}(a{x}^{2}+bx)={x}^{2} \\\\ \\frac{∂f}{∂b} & =\\frac{∂}{∂b}(a{x}^{2}+bx)=x\\end{aligned}\n$$\n\nTherefore, we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{a,b}\\,f & =[\\begin{aligned}\\frac{∂f}{∂a} \\\\ \\frac{∂f}{∂b}\\end{aligned}] \\\\  & =[\\begin{aligned}{x}^{2} \\\\ x\\end{aligned}]\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186530443 #edb/ref 1068 #edb/ref 17592186530344 #edb/ref 17592186045417] [17592186530443 #edb/ref 1068 #edb/ref 17592186530372 #edb/ref 17592186045417] [17592186530443 #edb/ref 1069 "q-264810" #edb/ref 17592186045417] [17592186530443 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186530443 #edb/ref 1071 "Given the function $f(x,y,z)={e}^{xyz},$ compute ${∇}_{x,y}\\,f.$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\" width=\"30px\">${∇}_{x,y}\\,f=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">\n{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">\n{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" #edb/ref 17592186045417] [17592186530443 #edb/ref 1072 #uuid "30241212-e00e-5866-b2f3-3d6f4d26064b" #edb/ref 17592186045417] [17592186530443 #edb/ref 1074 "To compute ${∇}_{x,y}\\,f$, we take partial derivatives with respect to $x$ and $y$ only.\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=\\frac{∂}{∂x}({e}^{xyz}) & =yz{e}^{xyz} \\\\ \\frac{∂f}{∂y}=\\frac{∂}{∂y}({e}^{xyz}) & =xz{e}^{xyz}\\end{aligned}\n$$\n\nTherefore, we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{x,y}\\,f & =[\\begin{aligned}\\frac{∂f}{∂x} \\\\ \\frac{∂f}{∂y}\\end{aligned}] \\\\  & =[\\begin{aligned}yz{e}^{xyz} \\\\ xz{e}^{xyz}\\end{aligned}]\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186530460 #edb/ref 1068 #edb/ref 17592186530282 #edb/ref 17592186045417] [17592186530460 #edb/ref 1068 #edb/ref 17592186530368 #edb/ref 17592186045417] [17592186530460 #edb/ref 1069 "q-264894" #edb/ref 17592186045417] [17592186530460 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186530460 #edb/ref 1071 "Given the function $f(x;w)=({w}_{1}-{w}_{2}{x}_{1}{x}_{2})^{2},$ compute ${∇}_{w}({∇}_{w}\\,f).$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\" width=\"40px\">${∇}_{w}({∇}_{w}\\,f)=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"50px\">$2$</td>\n<td align=\"center\" width=\"50px\">$-2{x}_{1}{x}_{2}$</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\" width=\"30px\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" #edb/ref 17592186045417] [17592186530460 #edb/ref 1072 #uuid "5ab6642a-36f8-590a-a631-0cf8a7d2875f" #edb/ref 17592186045417] [17592186530460 #edb/ref 1074 "First, we compute ${∇}_{w}\\,f$:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂{w}_{1}} & =\\frac{∂}{∂{w}_{1}}({w}_{1}-{w}_{2}{x}_{1}{x}_{2})^{2}=2({w}_{1}-{w}_{2}{x}_{1}{x}_{2}) \\\\ \\frac{∂f}{∂{w}_{2}} & =\\frac{∂}{∂{w}_{2}}({w}_{1}-{w}_{2}{x}_{1}{x}_{2})^{2}=-2{x}_{1}{x}_{2}({w}_{1}-{w}_{2}{x}_{1}{x}_{2})\\end{aligned}\n$$\n\nNext, we compute the second derivatives:\n\n$$\n\\begin{aligned} & \\frac{{∂}^{2}f}{∂{w}_{1}^{2}}=2\\,\\, &  & \\frac{{∂}^{2}f}{∂{w}_{1}∂{w}_{2}}=-2{x}_{1}{x}_{2} \\\\  & \\frac{{∂}^{2}f}{∂{w}_{2}∂{w}_{1}}=-2{x}_{1}{x}_{2}\\,\\, &  & \\frac{{∂}^{2}f}{∂{w}_{2}^{2}}=2{x}_{1}^{2}{x}_{2}^{2}\\end{aligned}\n$$\n\nTherefore, we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{w}({∇}_{w}\\,f) & =[\\begin{aligned}\\frac{{∂}^{2}f}{∂{w}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{w}_{1}∂{w}_{2}} \\\\ \\frac{{∂}^{2}f}{∂{w}_{2}∂{w}_{1}} & \\frac{{∂}^{2}f}{∂{w}_{2}^{2}}\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -2{x}_{1}{x}_{2} \\\\ -2{x}_{1}{x}_{2} & 2{x}_{1}^{2}{x}_{2}^{2}\\end{aligned}]\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186530461 #edb/ref 1068 #edb/ref 17592186530355 #edb/ref 17592186045417] [17592186530461 #edb/ref 1068 #edb/ref 17592186530359 #edb/ref 17592186045417] [17592186530461 #edb/ref 1069 "q-264857" #edb/ref 17592186045417] [17592186530461 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186530461 #edb/ref 1071 "Given the function $f(x,y;a,b)=axy+b,$ compute ${∇}_{a,b}\\,f.$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\" width=\"30px\">${∇}_{a,b}\\,f=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" #edb/ref 17592186045417] [17592186530461 #edb/ref 1072 #uuid "5cdbbb1b-f40a-59c6-9f85-65d64306e66f" #edb/ref 17592186045417] [17592186530461 #edb/ref 1074 "To compute ${∇}_{a,b}\\,f$, we take partial derivatives with respect to $a$ and $b.$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂a} & =\\frac{∂}{∂a}(axy+b)=xy \\\\ \\frac{∂f}{∂b} & =\\frac{∂}{∂b}(axy+b)=1\\end{aligned}\n$$\n\nTherefore, we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{a,b}\\,f & =[\\begin{aligned}\\frac{∂f}{∂a} \\\\ \\frac{∂f}{∂b}\\end{aligned}] \\\\  & =[\\begin{aligned}xy \\\\ 1\\end{aligned}]\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186530463 #edb/ref 1068 #edb/ref 17592186530343 #edb/ref 17592186045417] [17592186530463 #edb/ref 1068 #edb/ref 17592186530414 #edb/ref 17592186045417] [17592186530463 #edb/ref 1069 "q-264821" #edb/ref 17592186045417] [17592186530463 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186530463 #edb/ref 1071 "Given the function $f(x,y,z,w)=zw{e}^{xy}$, compute ${∇}_{x,z}\\,f.$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\" width=\"30px\">${∇}_{x,z}\\,f=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">\n{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">\n{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" #edb/ref 17592186045417] [17592186530463 #edb/ref 1072 #uuid "5f065247-cbf1-5f49-a2d5-a7f84645d603" #edb/ref 17592186045417] [17592186530463 #edb/ref 1074 "To compute ${∇}_{x,z}\\,f$, we take partial derivatives with respect to $x$ and $z$ only.\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=\\frac{∂}{∂x}(zw{e}^{xy}) & =yzw{e}^{xy} \\\\ \\frac{∂f}{∂z}=\\frac{∂}{∂z}(zw{e}^{xy}) & =w{e}^{xy}\\end{aligned}\n$$\n\nTherefore, we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{x,z}\\,f & =[\\begin{aligned}\\frac{∂f}{∂x} \\\\ \\frac{∂f}{∂z}\\end{aligned}] \\\\  & =[\\begin{aligned}yzw{e}^{xy} \\\\ w{e}^{xy}\\end{aligned}]\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186530466 #edb/ref 1068 #edb/ref 17592186530309 #edb/ref 17592186045417] [17592186530466 #edb/ref 1068 #edb/ref 17592186530354 #edb/ref 17592186045417] [17592186530466 #edb/ref 1069 "q-264847" #edb/ref 17592186045417] [17592186530466 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186530466 #edb/ref 1071 "Given the quadratic function $f(x;a,b,c)=a{x}^{2}+bx+c,$ compute ${∇}_{a,b}\\,f.$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\" width=\"30px\">${∇}_{a,b}\\,f=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" #edb/ref 17592186045417] [17592186530466 #edb/ref 1072 #uuid "653a69c1-9d3e-5dbc-8e82-906415c5f4a6" #edb/ref 17592186045417] [17592186530466 #edb/ref 1074 "To compute ${∇}_{a,b}\\,f$, we take partial derivatives with respect to $a$ and $b.$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂a} & =\\frac{∂}{∂a}(a{x}^{2}+bx+c)={x}^{2} \\\\ \\frac{∂f}{∂b} & =\\frac{∂}{∂b}(a{x}^{2}+bx+c)=x\\end{aligned}\n$$\n\nTherefore, we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{a,b}\\,f & =[\\begin{aligned}\\frac{∂f}{∂a} \\\\ \\frac{∂f}{∂b}\\end{aligned}] \\\\  & =[\\begin{aligned}{x}^{2} \\\\ x\\end{aligned}]\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186530467 #edb/ref 1068 #edb/ref 17592186530266 #edb/ref 17592186045417] [17592186530467 #edb/ref 1068 #edb/ref 17592186530402 #edb/ref 17592186045417] [17592186530467 #edb/ref 1069 "q-264813" #edb/ref 17592186045417] [17592186530467 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186530467 #edb/ref 1071 "Given the function $f(x,y,z)=x{y}^{3}+{y}^{3}z,$ compute ${∇}_{x,z}\\,f.$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\" width=\"30px\">${∇}_{x,z}\\,f=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" #edb/ref 17592186045417] [17592186530467 #edb/ref 1072 #uuid "66151cca-a80c-506c-9bd5-ec5398d6c5c9" #edb/ref 17592186045417] [17592186530467 #edb/ref 1074 "To compute ${∇}_{x,z}\\,f$, we take partial derivatives with respect to $x$ and $z$ only.\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=\\frac{∂}{∂x}(x{y}^{3}+{y}^{3}z) & ={y}^{3} \\\\ \\frac{∂f}{∂z}=\\frac{∂}{∂z}(x{y}^{3}+{y}^{3}z) & ={y}^{3}\\end{aligned}\n$$\n\nTherefore, we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{x,z}\\,f & =[\\begin{aligned}\\frac{∂f}{∂x} \\\\ \\frac{∂f}{∂z}\\end{aligned}] \\\\  & =[\\begin{aligned}{y}^{3} \\\\ {y}^{3}\\end{aligned}]\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186530468 #edb/ref 1068 #edb/ref 17592186530215 #edb/ref 17592186045417] [17592186530468 #edb/ref 1068 #edb/ref 17592186530275 #edb/ref 17592186045417] [17592186530468 #edb/ref 1068 #edb/ref 17592186530334 #edb/ref 17592186045417] [17592186530468 #edb/ref 1069 "q-264880" #edb/ref 17592186045417] [17592186530468 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186530468 #edb/ref 1071 "Given the function \n$f(x;w)={w}_{1}{x}_{1}^{2}+{w}_{2}{x}_{2}^{2}+{w}_{3}{x}_{3}^{2},$\ncompute ${∇}_{w}\\,f$ with the input $x={[\\begin{aligned}-1,\\,-2,\\,-3\\end{aligned}]}^{T}.$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"3\" width=\"30px\">${∇}_{w}\\,f=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" #edb/ref 17592186045417] [17592186530468 #edb/ref 1072 #uuid "6a4dfa9a-b4b5-5892-ac39-cd310c33e22d" #edb/ref 17592186045417] [17592186530468 #edb/ref 1074 "To compute ${∇}_{w}\\,f$, we take partial derivatives with respect to each component of $w.$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂{w}_{1}} & =\\frac{∂}{∂{w}_{1}}({w}_{1}{x}_{1}^{2}+{w}_{2}{x}_{2}^{2}+{w}_{3}{x}_{3}^{2})={x}_{1}^{2} \\\\ \\frac{∂f}{∂{w}_{2}} & =\\frac{∂}{∂{w}_{2}}({w}_{1}{x}_{1}^{2}+{w}_{2}{x}_{2}^{2}+{w}_{3}{x}_{3}^{2})={x}_{2}^{2} \\\\ \\frac{∂f}{∂{w}_{3}} & =\\frac{∂}{∂{w}_{3}}({w}_{1}{x}_{1}^{2}+{w}_{2}{x}_{2}^{2}+{w}_{3}{x}_{3}^{2})={x}_{3}^{2}\\end{aligned}\n$$\n\nTherefore, with $x={[\\begin{aligned}-1,\\,-2,\\,-3\\end{aligned}]}^{T},$ we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{w}\\,f & =[\\begin{aligned}{x}_{1}^{2} \\\\ {x}_{2}^{2} \\\\ {x}_{3}^{2}\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 4 \\\\ 9\\end{aligned}]\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186530474 #edb/ref 1068 #edb/ref 17592186530252 #edb/ref 17592186045417] [17592186530474 #edb/ref 1068 #edb/ref 17592186530323 #edb/ref 17592186045417] [17592186530474 #edb/ref 1069 "q-264817" #edb/ref 17592186045417] [17592186530474 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186530474 #edb/ref 1071 "Given the function $f(x,y,z)=\\frac{xy}{z},$ compute ${∇}_{y,z}\\,f.$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\" width=\"30px\">${∇}_{y,z}\\,f=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" #edb/ref 17592186045417] [17592186530474 #edb/ref 1072 #uuid "6fe4b67e-5906-58ff-aafc-e34173437530" #edb/ref 17592186045417] [17592186530474 #edb/ref 1074 "To compute ${∇}_{y,z}\\,f$, we take partial derivatives with respect to $y$ and $z$ only.\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y}=\\frac{∂}{∂y}(\\frac{xy}{z}) & =\\frac{x}{z} \\\\ \\frac{∂f}{∂z}=\\frac{∂}{∂z}(\\frac{xy}{z}) & =-\\frac{xy}{{z}^{2}}\\end{aligned}\n$$\n\nTherefore, we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{y,z}\\,f & =[\\begin{aligned}\\frac{∂f}{∂y} \\\\ \\frac{∂f}{∂z}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{x}{z} \\\\ -\\frac{xy}{{z}^{2}}\\end{aligned}]\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186530490 #edb/ref 1068 #edb/ref 17592186530269 #edb/ref 17592186045417] [17592186530490 #edb/ref 1068 #edb/ref 17592186530313 #edb/ref 17592186045417] [17592186530490 #edb/ref 1068 #edb/ref 17592186530352 #edb/ref 17592186045417] [17592186530490 #edb/ref 1069 "q-264877" #edb/ref 17592186045417] [17592186530490 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186530490 #edb/ref 1071 "Given the function \n$f(x;w)={w}_{1}{x}_{1}+{w}_{2}{x}_{2}-{w}_{3}{x}_{3},$\ncompute ${∇}_{w}\\,f$ with the input $x={[\\begin{aligned}3,\\,2,\\,1\\end{aligned}]}^{T}.$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"3\" width=\"30px\">${∇}_{w}\\,f=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" #edb/ref 17592186045417] [17592186530490 #edb/ref 1072 #uuid "8df7d96f-d828-5037-823d-2c01daf4d3bd" #edb/ref 17592186045417] [17592186530490 #edb/ref 1074 "To compute ${∇}_{w}\\,f$, we take partial derivatives with respect to each component of $w.$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂{w}_{1}} & =\\frac{∂}{∂{w}_{1}}({w}_{1}{x}_{1}+{w}_{2}{x}_{2}-{w}_{3}{x}_{3})={x}_{1} \\\\ \\frac{∂f}{∂{w}_{2}} & =\\frac{∂}{∂{w}_{2}}({w}_{1}{x}_{1}+{w}_{2}{x}_{2}-{w}_{3}{x}_{3})={x}_{2} \\\\ \\frac{∂f}{∂{w}_{3}} & =\\frac{∂}{∂{w}_{3}}({w}_{1}{x}_{1}+{w}_{2}{x}_{2}-{w}_{3}{x}_{3})=-{x}_{3}\\end{aligned}\n$$\n\nTherefore, with $x={[\\begin{aligned}3,\\,2,\\,1\\end{aligned}]}^{T},$ we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{w}\\,f & =[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ -{x}_{3}\\end{aligned}] \\\\  & =[\\begin{aligned}3 \\\\ 2 \\\\ -1\\end{aligned}]\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186530496 #edb/ref 1068 #edb/ref 17592186530386 #edb/ref 17592186045417] [17592186530496 #edb/ref 1068 #edb/ref 17592186530397 #edb/ref 17592186045417] [17592186530496 #edb/ref 1069 "q-264850" #edb/ref 17592186045417] [17592186530496 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186530496 #edb/ref 1071 "Given the cubic function $f(x;a,b,c)=a{x}^{3}+b{x}^{2}+cx,$ compute ${∇}_{a,c}\\,f.$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\" width=\"30px\">${∇}_{a,c}\\,f=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" #edb/ref 17592186045417] [17592186530496 #edb/ref 1072 #uuid "9a84fcca-bb7c-52d6-bb54-0e47f9a1105b" #edb/ref 17592186045417] [17592186530496 #edb/ref 1074 "To compute ${∇}_{a,c}\\,f$, we take partial derivatives with respect to $a$ and $c.$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂a} & =\\frac{∂}{∂a}(a{x}^{3}+b{x}^{2}+cx)={x}^{3} \\\\ \\frac{∂f}{∂c} & =\\frac{∂}{∂c}(a{x}^{3}+b{x}^{2}+cx)=x\\end{aligned}\n$$\n\nTherefore, we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{a,c}\\,f & =[\\begin{aligned}\\frac{∂f}{∂a} \\\\ \\frac{∂f}{∂c}\\end{aligned}] \\\\  & =[\\begin{aligned}{x}^{3} \\\\ x\\end{aligned}]\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186530511 #edb/ref 1068 #edb/ref 17592186530274 #edb/ref 17592186045417] [17592186530511 #edb/ref 1068 #edb/ref 17592186530306 #edb/ref 17592186045417] [17592186530511 #edb/ref 1069 "q-264898" #edb/ref 17592186045417] [17592186530511 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186530511 #edb/ref 1071 "Given the function $f(x;w)=({w}_{1}{x}_{1}{x}_{2}-{w}_{2})^{2},$ compute ${∇}_{w}({∇}_{w}\\,f).$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\" width=\"30px\">${∇}_{w}({∇}_{w}\\,f)=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">$2{x}_{1}^{2}{x}_{2}^{2}$</td>\n<td align=\"center\" width=\"30px\">$-2{x}_{1}{x}_{2}$</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\" width=\"30px\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" #edb/ref 17592186045417] [17592186530511 #edb/ref 1072 #uuid "b3c9497c-975d-55aa-bb92-1acbe4b3e0fa" #edb/ref 17592186045417] [17592186530511 #edb/ref 1074 "First, we compute ${∇}_{w}\\,f$:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂{w}_{1}} & =\\frac{∂}{∂{w}_{1}}({w}_{1}{x}_{1}{x}_{2}-{w}_{2})^{2}=2{x}_{1}{x}_{2}({w}_{1}{x}_{1}{x}_{2}-{w}_{2}) \\\\ \\frac{∂f}{∂{w}_{2}} & =\\frac{∂}{∂{w}_{2}}({w}_{1}{x}_{1}{x}_{2}-{w}_{2})^{2}=-2({w}_{1}{x}_{1}{x}_{2}-{w}_{2})\\end{aligned}\n$$\n\nNext, we compute the second derivatives:\n\n$$\n\\begin{aligned} & \\frac{{∂}^{2}f}{∂{w}_{1}^{2}}=2{x}_{1}^{2}{x}_{2}^{2}\\,\\, &  & \\frac{{∂}^{2}f}{∂{w}_{1}∂{w}_{2}}=-2{x}_{1}{x}_{2} \\\\  & \\frac{{∂}^{2}f}{∂{w}_{2}∂{w}_{1}}=-2{x}_{1}{x}_{2}\\,\\, &  & \\frac{{∂}^{2}f}{∂{w}_{2}^{2}}=2\\end{aligned}\n$$\n\nTherefore, we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{w}({∇}_{w}\\,f) & =[\\begin{aligned}\\frac{{∂}^{2}f}{∂{w}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{w}_{1}∂{w}_{2}} \\\\ \\frac{{∂}^{2}f}{∂{w}_{2}∂{w}_{1}} & \\frac{{∂}^{2}f}{∂{w}_{2}^{2}}\\end{aligned}] \\\\  & =[\\begin{aligned}2{x}_{1}^{2}{x}_{2}^{2} & -2{x}_{1}{x}_{2} \\\\ -2{x}_{1}{x}_{2} & 2\\end{aligned}]\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186530518 #edb/ref 1068 #edb/ref 17592186530276 #edb/ref 17592186045417] [17592186530518 #edb/ref 1068 #edb/ref 17592186530347 #edb/ref 17592186045417] [17592186530518 #edb/ref 1069 "q-264856" #edb/ref 17592186045417] [17592186530518 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186530518 #edb/ref 1071 "Given the function $f(x,y;a,b)=a{x}^{2}+bxy,$ compute ${∇}_{a,b}\\,f.$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\" width=\"30px\">${∇}_{a,b}\\,f=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" #edb/ref 17592186045417] [17592186530518 #edb/ref 1072 #uuid "c47abb70-6a87-5cce-aa76-b45ab7529754" #edb/ref 17592186045417] [17592186530518 #edb/ref 1074 "To compute ${∇}_{a,b}\\,f$, we take partial derivatives with respect to $a$ and $b.$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂a} & =\\frac{∂}{∂a}(a{x}^{2}+bxy)={x}^{2} \\\\ \\frac{∂f}{∂b} & =\\frac{∂}{∂b}(a{x}^{2}+bxy)=xy\\end{aligned}\n$$\n\nTherefore, we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{a,b}\\,f & =[\\begin{aligned}\\frac{∂f}{∂a} \\\\ \\frac{∂f}{∂b}\\end{aligned}] \\\\  & =[\\begin{aligned}{x}^{2} \\\\ xy\\end{aligned}]\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186530530 #edb/ref 1068 #edb/ref 17592186530226 #edb/ref 17592186045417] [17592186530530 #edb/ref 1068 #edb/ref 17592186530281 #edb/ref 17592186045417] [17592186530530 #edb/ref 1068 #edb/ref 17592186530302 #edb/ref 17592186045417] [17592186530530 #edb/ref 1068 #edb/ref 17592186530335 #edb/ref 17592186045417] [17592186530530 #edb/ref 1069 "q-264884" #edb/ref 17592186045417] [17592186530530 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186530530 #edb/ref 1071 "Given the function $f(x,y,z)={x}^{2}+{y}^{2}+{z}^{2}$, compute ${∇}_{x,z}({∇}_{x,z}\\,f).$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\" width=\"30px\">${∇}_{x,z}({∇}_{x,z}f)=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"30px\">{{field-2}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\" width=\"30px\">{{field-4}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" #edb/ref 17592186045417] [17592186530530 #edb/ref 1072 #uuid "d8078445-7f57-54e9-9fc5-bfc3757a9189" #edb/ref 17592186045417] [17592186530530 #edb/ref 1074 "First, we take the variable subset gradient:\n\n$$\n\\begin{aligned}{∇}_{x,z}\\,f & =[\\begin{aligned}\\frac{∂}{∂x}({x}^{2}+{y}^{2}+{z}^{2}) \\\\ \\frac{∂}{∂z}({x}^{2}+{y}^{2}+{z}^{2})\\end{aligned}]=[\\begin{aligned}2x \\\\ 2z\\end{aligned}]\\end{aligned}\n$$\n\nNext, we compute the second derivatives with respect to $x$ and $z$:\n\n$$\n\\begin{aligned} & \\frac{∂}{∂x}(2x)=2\\,\\, &  & \\frac{∂}{∂z}(2x)=0 \\\\  & \\frac{∂}{∂x}(2z)=0\\,\\, &  & \\frac{∂}{∂z}(2z)=2\\end{aligned}\n$$\n\nTherefore, we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{x,z}({∇}_{x,z}\\,f) & =[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂z} \\\\ \\frac{{∂}^{2}f}{∂z∂x} & \\frac{{∂}^{2}f}{∂{z}^{2}}\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 0 \\\\ 0 & 2\\end{aligned}]\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186530536 #edb/ref 1068 #edb/ref 17592186530257 #edb/ref 17592186045417] [17592186530536 #edb/ref 1068 #edb/ref 17592186530325 #edb/ref 17592186045417] [17592186530536 #edb/ref 1068 #edb/ref 17592186530409 #edb/ref 17592186045417] [17592186530536 #edb/ref 1069 "q-264876" #edb/ref 17592186045417] [17592186530536 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186530536 #edb/ref 1071 "Given the function \n$f(x;w)={w}_{1}{x}_{1}-{w}_{2}{x}_{2}+{w}_{3}{x}_{3},$\ncompute ${∇}_{w}\\,f$ with the input $x={[\\begin{aligned}-1,\\,-2,\\,4\\end{aligned}]}^{T}.$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"3\" width=\"30px\">${∇}_{w}\\,f=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" #edb/ref 17592186045417] [17592186530536 #edb/ref 1072 #uuid "eac2ec24-253b-5adc-871d-0bb7659e7619" #edb/ref 17592186045417] [17592186530536 #edb/ref 1074 "To compute ${∇}_{w}\\,f$, we take partial derivatives with respect to each component of $w.$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂{w}_{1}} & =\\frac{∂}{∂{w}_{1}}({w}_{1}{x}_{1}-{w}_{2}{x}_{2}+{w}_{3}{x}_{3})={x}_{1} \\\\ \\frac{∂f}{∂{w}_{2}} & =\\frac{∂}{∂{w}_{2}}({w}_{1}{x}_{1}-{w}_{2}{x}_{2}+{w}_{3}{x}_{3})=-{x}_{2} \\\\ \\frac{∂f}{∂{w}_{3}} & =\\frac{∂}{∂{w}_{3}}({w}_{1}{x}_{1}-{w}_{2}{x}_{2}+{w}_{3}{x}_{3})={x}_{3}\\end{aligned}\n$$\n\nTherefore, with $x={[\\begin{aligned}-1,\\,-2,\\,4\\end{aligned}]}^{T},$ we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{w}\\,f & =[\\begin{aligned}{x}_{1} \\\\ -{x}_{2} \\\\ {x}_{3}\\end{aligned}] \\\\  & =[\\begin{aligned}-1 \\\\ 2 \\\\ 4\\end{aligned}]\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186530538 #edb/ref 1068 #edb/ref 17592186530268 #edb/ref 17592186045417] [17592186530538 #edb/ref 1068 #edb/ref 17592186530280 #edb/ref 17592186045417] [17592186530538 #edb/ref 1068 #edb/ref 17592186530303 #edb/ref 17592186045417] [17592186530538 #edb/ref 1068 #edb/ref 17592186530358 #edb/ref 17592186045417] [17592186530538 #edb/ref 1069 "q-264888" #edb/ref 17592186045417] [17592186530538 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186530538 #edb/ref 1071 "Given the function $f(x,y,z)=x{e}^{yz}$, compute ${∇}_{x,y}({∇}_{x,y}\\,f).$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\" width=\"30px\">${∇}_{x,y}({∇}_{x,y}f)=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"30px\">{{field-2}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\" width=\"30px\">{{field-4}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" #edb/ref 17592186045417] [17592186530538 #edb/ref 1072 #uuid "ef911a6f-8eaa-541f-ada4-10af4c9994c6" #edb/ref 17592186045417] [17592186530538 #edb/ref 1074 "First, we take the variable subset gradient:\n\n$$\n\\begin{aligned}{∇}_{x,y}\\,f & =[\\begin{aligned}\\frac{∂}{∂x}(x{e}^{yz}) \\\\ \\frac{∂}{∂y}(x{e}^{yz})\\end{aligned}]=[\\begin{aligned}{e}^{yz} \\\\ xz{e}^{yz}\\end{aligned}]\\end{aligned}\n$$\n\nNext, we compute the second derivatives with respect to $x$ and $y$:\n\n$$\n\\begin{aligned} & \\frac{∂}{∂x}({e}^{yz})=0\\,\\, &  & \\frac{∂}{∂y}({e}^{yz})=z{e}^{yz} \\\\  & \\frac{∂}{∂x}(xz{e}^{yz})=z{e}^{yz}\\,\\, &  & \\frac{∂}{∂y}(xz{e}^{yz})=x{z}^{2}{e}^{yz}\\end{aligned}\n$$\n\nTherefore, we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{x,y}({∇}_{x,y}\\,f) & =[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{aligned}] \\\\  & =[\\begin{aligned}0 & z{e}^{yz} \\\\ z{e}^{yz} & x{z}^{2}{e}^{yz}\\end{aligned}]\\end{aligned}\n$$" #edb/ref 17592186045417]}
