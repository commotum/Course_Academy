#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186540118} :activity/id #uuid "03d652f5-8230-5e3b-81da-d535acb54242" :activity/scope {:db/id #edb/ref 17592186050832 :topic/id #uuid "6a24ddaa-5f01-58df-962b-9b8ee39de737" :topic/math-academy-id 5527} :activity/steps [{:db/id #edb/ref 17592186540118 :step/content {:db/id #edb/ref 17592186540056 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9f743137-843f-59c2-bbb5-4cf9167a7f64" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x^{2}" :db/id #edb/ref 17592186539746}] :answer-field/correct {:db/id #edb/ref 17592186539746} :answer-field/id #uuid "59bc1d2d-7c29-5024-8664-09afd9227859" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186539957} {:answer-field/choices [{:answer/id #uuid "032c81c6-185e-5f81-99a7-3ca194e32338" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x^{3}" :db/id #edb/ref 17592186539483}] :answer-field/correct {:db/id #edb/ref 17592186539483} :answer-field/id #uuid "e177c0d9-604c-50b5-9592-24314dee2a81" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186540004}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "69b033a7-d872-59bc-ae3f-9a5bfb186950" :question/math-academy-id "q-264852" :question/problem "Given the quartic function $f(x;a,b,c)=a{x}^{4}+b{x}^{3}+c{x}^{2},$ compute ${∇}_{b,c}\\,f.$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\" width=\"30px\">${∇}_{b,c}\\,f=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "To compute ${∇}_{b,c}\\,f$, we take partial derivatives with respect to $b$ and $c.$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂b} & =\\frac{∂}{∂b}(a{x}^{4}+b{x}^{3}+c{x}^{2})={x}^{3} \\\\ \\frac{∂f}{∂c} & =\\frac{∂}{∂c}(a{x}^{4}+b{x}^{3}+c{x}^{2})={x}^{2}\\end{aligned}\n$$\n\nTherefore, we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{b,c}\\,f & =[\\begin{aligned}\\frac{∂f}{∂b} \\\\ \\frac{∂f}{∂c}\\end{aligned}] \\\\  & =[\\begin{aligned}{x}^{3} \\\\ {x}^{2}\\end{aligned}]\\end{aligned}\n$$"} :step/id #uuid "0e09055a-8ec5-52c2-8a49-3ed30ccb5890" :step/next {:db/id #edb/ref 17592186540153}} {:db/id #edb/ref 17592186540128 :step/content {:db/id #edb/ref 17592186540066 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b6be170-22a5-50c2-b423-ef63a5649a71" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y" :db/id #edb/ref 17592186539502}] :answer-field/correct {:db/id #edb/ref 17592186539502} :answer-field/id #uuid "29c11c41-4251-59f9-a07b-6dd2357b05fe" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186539935} {:answer-field/choices [{:answer/id #uuid "cfe611bb-4ff6-5647-a480-93c4ac02a258" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186539835}] :answer-field/correct {:db/id #edb/ref 17592186539835} :answer-field/id #uuid "2fc216b1-dcc1-5053-b784-b1697b063058" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186539938} {:answer-field/choices [{:answer/id #uuid "6988ec71-c280-5ab5-8895-24dd8a6cb7d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186539653}] :answer-field/correct {:db/id #edb/ref 17592186539653} :answer-field/id #uuid "b586955b-6ca9-5533-8861-e70a511d63db" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186539985} {:answer-field/choices [{:answer/id #uuid "a1dbc036-af8b-5f8a-96be-7cf52a033cef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y" :db/id #edb/ref 17592186539751}] :answer-field/correct {:db/id #edb/ref 17592186539751} :answer-field/id #uuid "f507b184-60c6-57e9-b5d9-709338cca4d7" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186540015}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "892266dd-4065-579e-8406-1b3b7c58257b" :question/math-academy-id "q-264885" :question/problem "Given the function $f(x,y,z)=xyz$, compute ${∇}_{x,z}({∇}_{x,z}\\,f).$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\" width=\"30px\">${∇}_{x,z}({∇}_{x,z}f)=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"30px\">{{field-2}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\" width=\"30px\">{{field-4}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "First, we take the variable subset gradient:\n\n$$\n\\begin{aligned}{∇}_{x,z}\\,f & =[\\begin{aligned}\\frac{∂}{∂x}(xyz) \\\\ \\frac{∂}{∂z}(xyz)\\end{aligned}]=[\\begin{aligned}yz \\\\ xy\\end{aligned}]\\end{aligned}\n$$\n\nNext, we compute the second derivatives with respect to $x$ and $z$:\n\n$$\n\\begin{aligned} & \\frac{∂}{∂x}(yz)=0\\,\\, &  & \\frac{∂}{∂z}(yz)=y \\\\  & \\frac{∂}{∂x}(xy)=y\\,\\, &  & \\frac{∂}{∂z}(xy)=0\\end{aligned}\n$$\n\nTherefore, we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{x,z}({∇}_{x,z}\\,f) & =[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂z} \\\\ \\frac{{∂}^{2}f}{∂z∂x} & \\frac{{∂}^{2}f}{∂{z}^{2}}\\end{aligned}] \\\\  & =[\\begin{aligned}0 & y \\\\ y & 0\\end{aligned}]\\end{aligned}\n$$"} :step/id #uuid "355d476c-23e0-586f-8dde-67e4e54bc6ab" :step/next {:db/id #edb/ref 17592186540172}} {:db/id #edb/ref 17592186540147 :step/content {:db/id #edb/ref 17592186540028 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a932e28-eaed-58b2-9160-b95738ec4281" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-40" :db/id #edb/ref 17592186539499}] :answer-field/correct {:db/id #edb/ref 17592186539499} :answer-field/id #uuid "0520897a-4097-5830-8b06-a11b414ba8b2" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186539920} {:answer-field/choices [{:answer/id #uuid "e1fdefc4-3207-5c16-8acf-87f93d20ab3d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186539865}] :answer-field/correct {:db/id #edb/ref 17592186539865} :answer-field/id #uuid "2e7db6c9-8fee-509b-870a-3fa074ffb816" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186539937}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1a79f623-fca8-50cb-ac85-6ca0845384fa" :question/math-academy-id "q-264870" :question/problem "Given the function \n$f(x;w)=2{w}_{1}{x}_{1}-5{w}_{2}{x}_{2},$\ncompute ${∇}_{w}\\,f$ with the input $x={[\\begin{aligned}-2,\\,8\\end{aligned}]}^{T}.$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\" width=\"30px\">${∇}_{w}\\,f=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "To compute ${∇}_{w}\\,f$, we take partial derivatives with respect to each component of $w.$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂{w}_{1}} & =\\frac{∂}{∂{w}_{1}}(2{w}_{1}{x}_{1}-5{w}_{2}{x}_{2})=2{x}_{1} \\\\ \\frac{∂f}{∂{w}_{2}} & =\\frac{∂}{∂{w}_{2}}(2{w}_{1}{x}_{1}-5{w}_{2}{x}_{2})=-5{x}_{2}\\end{aligned}\n$$\n\nTherefore, with $x={[\\begin{aligned}-2,\\,8\\end{aligned}]}^{T},$ we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{w}\\,f & =[\\begin{aligned}2{x}_{1} \\\\ -5{x}_{2}\\end{aligned}] \\\\  & =[\\begin{aligned}-4 \\\\ -40\\end{aligned}]\\end{aligned}\n$$"} :step/id #uuid "6b3db02c-2be0-5e4a-bda3-708f1cd0d5cc" :step/next {:db/id #edb/ref 17592186540128}} {:db/id #edb/ref 17592186540153 :step/content {:db/id #edb/ref 17592186540034 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5bb37b4c-595b-5767-8df6-2c02873bec6e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y" :db/id #edb/ref 17592186539633}] :answer-field/correct {:db/id #edb/ref 17592186539633} :answer-field/id #uuid "abbf1633-ea12-5087-9624-31bca0dfc695" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186539982} {:answer-field/choices [{:answer/id #uuid "4b6c244a-b2f6-5ab8-a481-52aacac4dd91" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x" :db/id #edb/ref 17592186539614}] :answer-field/correct {:db/id #edb/ref 17592186539614} :answer-field/id #uuid "b5d086f0-9d69-58b3-9c6b-60b0c91a8ff3" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186539986}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "209023bf-0612-560b-b7ed-a33687740998" :question/math-academy-id "q-264855" :question/problem "Given the function $f(x,y;a,b)=ax+by,$ compute ${∇}_{a,b}\\,f.$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\" width=\"30px\">${∇}_{a,b}\\,f=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "To compute ${∇}_{a,b}\\,f$, we take partial derivatives with respect to $a$ and $b.$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂a} & =\\frac{∂}{∂a}(ax+by)=x \\\\ \\frac{∂f}{∂b} & =\\frac{∂}{∂b}(ax+by)=y\\end{aligned}\n$$\n\nTherefore, we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{a,b}\\,f & =[\\begin{aligned}\\frac{∂f}{∂a} \\\\ \\frac{∂f}{∂b}\\end{aligned}] \\\\  & =[\\begin{aligned}x \\\\ y\\end{aligned}]\\end{aligned}\n$$"} :step/id #uuid "81e44b1d-feed-5ed9-a681-6e53a36dabc4" :step/next {:db/id #edb/ref 17592186540147}} {:db/id #edb/ref 17592186540172 :step/content {:db/id #edb/ref 17592186540065 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fc3299c1-7141-5be7-bfe9-a4da090cb231" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186539905}] :answer-field/correct {:db/id #edb/ref 17592186539905} :answer-field/id #uuid "a75257c9-8063-572f-b90b-975bf7853ddd" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186539979} {:answer-field/choices [{:answer/id #uuid "d58aa4b3-dfec-58ba-9003-5a0d9d8feceb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2w_2x_2^2" :db/id #edb/ref 17592186539842}] :answer-field/correct {:db/id #edb/ref 17592186539842} :answer-field/id #uuid "eaa3fc51-52ac-520e-88d7-534ea602e135" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186540009}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "869ee47c-102a-5b9f-9e3a-e75445c641bf" :question/math-academy-id "q-264896" :question/problem "Given the function $f(x;w)={w}_{2}({w}_{1}{x}_{2}-{x}_{1})^{2},$ compute ${∇}_{w}({∇}_{w}\\,f).$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\" width=\"30px\">${∇}_{w}({∇}_{w}\\,f)=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"30px\">$2{x}_{2}({w}_{1}{x}_{2}-{x}_{1})$</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">$2{x}_{2}({w}_{1}{x}_{2}-{x}_{1})$</td>\n<td align=\"center\" width=\"30px\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "First, we compute ${∇}_{w}\\,f$:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂{w}_{1}} & =\\frac{∂}{∂{w}_{1}}({w}_{1}{x}_{1}-{w}_{2}{x}_{2})^{2}=2{w}_{2}{x}_{2}({w}_{1}{x}_{2}-{x}_{1}) \\\\ \\frac{∂f}{∂{w}_{2}} & =\\frac{∂}{∂{w}_{2}}({w}_{1}{x}_{1}-{w}_{2}{x}_{2})^{2}=({w}_{1}{x}_{2}-{x}_{1})^{2}\\end{aligned}\n$$\n\nNext, we compute the second derivatives:\n\n$$\n\\begin{aligned} & \\frac{{∂}^{2}f}{∂{w}_{1}^{2}}=2{w}_{2}{x}_{2}^{2}\\,\\, &  & \\frac{{∂}^{2}f}{∂{w}_{1}∂{w}_{2}}=2{x}_{2}({w}_{1}{x}_{2}-{x}_{1}) \\\\  & \\frac{{∂}^{2}f}{∂{w}_{2}∂{w}_{1}}=2{x}_{2}({w}_{1}{x}_{2}-{x}_{1})\\,\\, &  & \\frac{{∂}^{2}f}{∂{w}_{2}^{2}}=0\\end{aligned}\n$$\n\nTherefore, we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{w}({∇}_{w}\\,f) & =[\\begin{aligned}\\frac{{∂}^{2}f}{∂{w}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{w}_{1}∂{w}_{2}} \\\\ \\frac{{∂}^{2}f}{∂{w}_{2}∂{w}_{1}} & \\frac{{∂}^{2}f}{∂{w}_{2}^{2}}\\end{aligned}] \\\\  & =[\\begin{aligned}2{w}_{2}{x}_{2}^{2} & 2{x}_{2}({w}_{1}{x}_{2}-{x}_{1}) \\\\ 2{x}_{2}({w}_{1}{x}_{2}-{x}_{1}) & 0\\end{aligned}]\\end{aligned}\n$$"} :step/id #uuid "df2d21f7-0fea-5061-9aba-73bfa9e41ff2"}] :activity/title "Gradients With Respect to a Variable Subset" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186539464}]}
