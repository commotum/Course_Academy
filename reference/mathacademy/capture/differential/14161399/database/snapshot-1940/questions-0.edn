td align=\"center\"></td>\n<td align=\"center\">$11$</td>\n<td align=\"center\">$-3$</td>\n<td align=\"center\">\n{{field-5}}\n</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "To find ${B}^{2},$ we multiply $B$ by itself:\n\n$$\n\\begin{aligned}{B}^{2} & =B\\cdot B \\\\  & =[\\begin{aligned}2 & 0 & 1 \\\\ 1 & 1 & 0 \\\\ 3 & -1 & 2\\end{aligned}]\\cdot [\\begin{aligned}2 & 0 & 1 \\\\ 1 & 1 & 0 \\\\ 3 & -1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}7 & -1 & 4 \\\\ 3 & 1 & 1 \\\\ 11 & -3 & 7\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186295080 :knowledge-point/_questions [{:db/id #edb/ref 17592186115230 :knowledge-point/id #uuid "61443225-bc08-5d36-a603-3a1d7e392a98" :knowledge-point/title "Evaluating a Matrix Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a6034546-7d4e-5c51-9fd2-f41fcfef04a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186293585}] :answer-field/correct {:answer/id #uuid "a6034546-7d4e-5c51-9fd2-f41fcfef04a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186293585} :answer-field/id #uuid "1428d1b1-1543-5a2a-9556-2cee443c52dc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186293995} {:answer-field/choices [{:answer/id #uuid "26a75419-4630-5608-bb8c-21f42f59fc89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186293101}] :answer-field/correct {:answer/id #uuid "26a75419-4630-5608-bb8c-21f42f59fc89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186293101} :answer-field/id #uuid "4dd27018-7e5e-55e0-a7db-154856c32454" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-fi