$$\n\\begin{aligned}{B}^{2} & =B\\cdot B \\\\  & =[\\begin{aligned}0 & 4 & 0 \\\\ 2 & 1 & 1 \\\\ -1 & -2 & 1\\end{aligned}]\\cdot [\\begin{aligned}0 & 4 & 0 \\\\ 2 & 1 & 1 \\\\ -1 & -2 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}8 & 4 & 4 \\\\ 1 & 7 & 2 \\\\ -5 & -8 & -1\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393863 :knowledge-point/_questions [{:db/id #edb/ref 17592186115229 :knowledge-point/id #uuid "82e970fe-cff8-50e3-9b94-67ad97b03da7" :knowledge-point/title "Finding a Power of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d718e860-d9b8-5907-8e53-05046524911e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 12 \\\\ 14 & 9\\end{aligned}]" :db/id #edb/ref 17592186393865} {:answer/id #uuid "0b2da8db-419b-5fc2-a2f6-c5d25d2ee8d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 2 \\\\ 4 & 9\\end{aligned}]" :db/id #edb/ref 17592186393866} {:answer/id #uuid "6f8c7ef1-9d5b-59ed-9bfc-b71aaba92cbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 & 12 \\\\ 4 & 19\\end{aligned}]" :db/id #edb/ref 17592186393867} {:answer/id #uuid "41965806-1f4e-5183-9b81-5ddeff998ace" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}8 & 12 \\\\ 1 & 9\\end{aligned}]" :db/id #edb/ref 17592186393868} {:answer/id #uuid "ba1e5569-d116-55e7-87e8-e2b89abc51e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 12 \\\\ 4 & 19\\end{aligned}]" :db/id #edb/ref 17592186393869}] :answer-field/correct {:answer/id #uuid "ba1e5569-d116-55e7-87e8-e2b89abc51e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 12 \\\\ 4 & 19\\end{aligned}]" :db/id #edb/ref 17592186393869} :answer-field/id #uuid "22d67059-f6d7-5521-9126-3196f2ed6789" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393864}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "88934d15-ae66-5c80-a236-6a63bba3d33b" :question/math-academy-id "q-78497" :question/problem "If $F=[\\begin{aligned}0 & 3 \\\\ 1 & 4\\end{aligned}]$, then ${F}^{2}=$" :question/worked-solution "To find ${F}^{2},$ we multiply $F$ by itself:\n\n$$\n\\begin{aligned}{F}^{2} & =F\\cdot F \\\\  & =[\\begin{aligned}0 & 3 \\\\ 1 & 4\\end{aligned}]\\cdot [\\begin{aligned}0 & 3 \\\\ 1 & 4\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 12 \\\\ 4 & 19\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186486363 :knowledge-point/_questions [{:db/id #edb/ref 17592186115230 :knowledge-point/id #uuid "61443225-bc08-5d36-a603-3a1d7e392a98" :knowledge-point/title "Evaluating a Matrix Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22af9faf-479c-5211-b924-d2a2ed0ab1ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 6 \\\\ 6 & 8\\end{aligned}]" :db/id #edb/ref 17592186485823} {:answer/id #uuid "4a573fe0-ecf3-566c-990e-bc2091d59ff5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 & 6 \\\\ 8 & 2\\end{aligned}]" :db/id #edb/ref 17592186485900} {:answer/id #uuid "c787cd72-628c-5183-a122-bb1328cc72f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 & 6 \\\\ 2 & 8\\end{aligned}]" :db/id #edb/ref 17592186486126} {:answer/id #uuid "dd037009-e252-5c9b-a802-118a15252803" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 & 2 \\\\ 6 & 8\\end{aligned}]" :db/id #edb/ref 17592186486169} {:answer/id #uuid "f294d9c4-87c6-5c05-8909-273b2ed