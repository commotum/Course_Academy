#{[{:activity/expected-seconds 600.0 :activity/first-step {:db/id #edb/ref 17592186116102} :activity/id #uuid "18afd5ba-844e-5a0a-b7f3-a142f4f4628b" :activity/scope {:db/id #edb/ref 17592186050446 :topic/id #uuid "49ac363b-d07a-55f5-9f5d-8e58eafc76b5" :topic/math-academy-id 1725} :activity/steps [{:db/id #edb/ref 17592186116102 :step/content {:db/id #edb/ref 17592186116488 :tutorial/content "Powers of matrices are similar to powers of numbers. If $A$ is a matrix, then $A^n$ is $A$ multiplied by itself $n$ times: $$A^n = \\underbrace{A\\:\\cdot\\: A\\:\\cdot\\: \\ldots \\:\\cdot\\: A}_{\\Large{n\\text{ times}}}$$\n\nFor $A$ to be conformable with itself, $A$ needs to be a square matrix. So we can only take powers of square matrices.\n\nTo demonstrate, suppose that $$A=[\\begin{aligned}3 & -1 \\\\ 2 & 1\\end{aligned}].$$\n\nThen we can calculate $A^2$ as follows:\n\n$$\\begin{aligned}{A}^{2} & =A\\cdot A \\\\ & =[\\begin{aligned}3 & -1 \\\\ 2 & 1\\end{aligned}]\\cdot [\\begin{aligned}3 & -1 \\\\ 2 & 1\\end{aligned}] \\\\ & =[\\begin{aligned}3\\cdot 3+(-1)\\cdot 2 & 3\\cdot (-1)+(-1)\\cdot 1 \\\\ 2\\cdot 3+1\\cdot 2 & 2\\cdot (-1)+1\\cdot 1\\end{aligned}] \\\\ & =[\\begin{aligned}7 & -4 \\\\ 8 & -1\\end{aligned}]\\end{aligned}$$\n\nWe say that $A^0 = I,$ the identity matrix of the same dimension as $A.$" :tutorial/id #uuid "ee44491b-6b6b-5f87-9b67-ffc9a32397f7" :tutorial/math-academy-id 2999 :tutorial/title "Introduction"} :step/id #uuid "fb346f38-313a-573c-b90a-fbbe590dbd2f" :step/math-academy-id 16200 :step/next {:db/id #edb/ref 17592186116103}} {:db/id #edb/ref 17592186116103 :step/content {:db/id #edb/ref 17592186115229 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115059 :question/id #uuid "f832e671-b4bd-5d1d-81e7-b215a8ee4e27" :question/math-academy-id "e-4414"} :knowledge-point/id #uuid "82e970fe-cff8-50e3-9b94-67ad97b03da7" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050407} {:db/id #edb/ref 17592186050668}] :knowledge-point/questions [{:db/id #edb/ref 17592186115763} {:db/id #edb/ref 17592186115814} {:db/id #edb/ref 17592186265932} {:db/id #edb/ref 17592186265933} {:db/id #edb/ref 17592186265936} {:db/id #edb/ref 17592186295065} {:db/id #edb/ref 17592186295066} {:db/id #edb/ref 17592186295068} {:db/id #edb/ref 17592186295069} {:db/id #edb/ref 17592186348088} {:db/id #edb/ref 17592186348089} {:db/id #edb/ref 17592186365498} {:db/id #edb/ref 17592186365507} {:db/id #edb/ref 17592186365518} {:db/id #edb/ref 17592186380083} {:db/id #edb/ref 17592186388111} {:db/id #edb/ref 17592186393863}] :knowledge-point/title "Finding a Power of a Matrix"} :step/id #uuid "b7e64a68-2c78-5e75-aff4-57e7b0a1d18e" :step/math-academy-id 16201 :step/next {:db/id #edb/ref 17592186116104}} {:db/id #edb/ref 17592186116104 :step/content {:db/id #edb/ref 17592186116489 :tutorial/content "Now that we know how to compute powers of matrices, we can evaluate polynomials where the input is a square matrix.\n\nFor example, consider the polynomial\n\n$$f(X) = X^2 + 4X + 3.$$\n\nNote that, in order to evaluate this polynomial for an input matrix $X,$ we need to interpret any constants as multiples of the identity matrix. So, we interpret the polynomial as\n\n$$f(X) = X^2 + 4X + 3I.$$\n\nFor example, if $A = [\\begin{aligned}1 & 1 \\\\ 0 & 2\\end{aligned}],$ then\n\n$$\\begin{aligned}{A}^{2} & =[\\begin{aligned}1 & 1 \\\\ 0 & 2\\end{aligned}][\\begin{aligned}1 & 1 \\\\ 0 & 2\\end{aligned}] \\\\ & =[\\begin{aligned}1 & 3 \\\\ 0 & 4\\end{aligned}],\\end{aligned}$$\n\nand we can evaluate $f(A)$ as follows:\n\n$$\\begin{aligned}f(A) & ={A}^{2}+4A+3I \\\\ & =[\\begin{aligned}1 & 3 \\\\ 0 & 4\\end{aligned}]+4[\\begin{aligned}1 & 1 \\\\ 0 & 2\\end{aligned}]+3[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\ & =[\\begin{aligned}1 & 3 \\\\ 0 & 4\\end{aligned}]+[\\begin{aligned}4 & 4 \\\\ 0 & 8\\end{aligned}]+[\\begin{aligned}3 & 0 \\\\ 0 & 3\\end{aligned}] \\\\ & =[\\begin{aligned}1+4+3 & 3+4+0 \\\\ 0+0+0 & 4+8+3\\end{aligned}] \\\\ & =[\\begin{aligned}8 & 7 \\\\ 0 & 15\\end{aligned}]\\end{aligned}$$" :tutorial/id #uuid "ac80f32c-3973-5ae6-b2de-3dcfd8494ec9" :tutorial/math-academy-id 3000 :tutorial/title "Matrix Polynomials"} :step/id #uuid "f5d78f09-ffdb-5e92-a5f6-53a783fa07ca" :step/math-academy-id 16204 :step/next {:db/id #edb/ref 17592186116105}} {:db/id #edb/ref 17592186116105 :step/content {:db/id #edb/ref 17592186115230 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115060 :question/id #uuid "bea8819f-6feb-5de6-a585-4379378ccdbd" :question/math-academy-id "e-4417"} :knowledge-point/id #uuid "61443225-bc08-5d36-a603-3a1d7e392a98" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049304} {:db/id #edb/ref 17592186050396} {:db/id #edb/ref 17592186050979}] :knowledge-point/questions [{:db/id #edb/ref 17592186115815} {:db/id #edb/ref 17592186115954} {:db/id #edb/ref 17592186265959} {:db/id #edb/ref 17592186295078} {:db/id #edb/ref 17592186295079} {:db/id #edb/ref 17592186295080} {:db/id #edb/ref 17592186295081} {:db/id #edb/ref 17592186295082} {:db/id #edb/ref 17592186295083} {:db/id #edb/ref 17592186302133} {:db/id #edb/ref 17592186348102} {:db/id #edb/ref 17592186365529} {:db/id #edb/ref 17592186365538} {:db/id #edb/ref 17592186366302} {:db/id #edb/ref 17592186366309} {:db/id #edb/ref 17592186388132} {:db/id #edb/ref 17592186388139} {:db/id #edb/ref 17592186388146}] :knowledge-point/title "Evaluating a Matrix Polynomial"} :step/id #uuid "f98ae8b7-d09c-5763-8545-e0528e7956df" :step/math-academy-id 16205}] :activity/title "Powers of Matrices" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186115471}]}
