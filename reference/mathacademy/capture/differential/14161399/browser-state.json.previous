d><mn>0</mn><mo>−</mo><mn>2</mn><mo>+</mo><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn><mo>+</mo><mn>4</mn><mo>+</mo><mn>0</mn></mtd><mtd><mn>1</mn><mo>−</mo><mn>3</mn><mo>−</mo><mn>1</mn></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">[</mo><mtable columnalign=\"center\" columnspacing=\"1em\" rowspacing=\"4pt\"><mtr><mtd><mn>3</mn></mtd><mtd><mo>−</mo><mn>2</mn></mtd></mtr><mtr><mtd><mn>4</mn></mtd><mtd><mo>−</mo><mn>3</mn></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container> </p>\n</div></div>",
