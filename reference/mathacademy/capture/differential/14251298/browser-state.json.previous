  "live_records": {
    "q-36221": {
      "dom_id": "step-q36221",
      "name": "Question 1",
      "problem": "$|\\begin{aligned}3 & 1 & 2 & -3 \\\\ 3 & 6 & -4 & 1 \\\\ 0 & -5 & -5 & 0 \\\\ -1 & 1 & 5 & 2\\end{aligned}|=$",
      "worked_solution": "The $3$rd row of the matrix contains two zeros, more than any other row. So using a Laplace expansion along the $3$rd row, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}3 & 1 & 2 & -3 \\\\ 3 & 6 & -4 & 1 \\\\ 0 & -5 & -5 & 0 \\\\ -1 & 1 & 5 & 2\\end{aligned}| & =0\\cdot {C}_{31}+(-5)\\cdot {C}_{32}+(-5)\\cdot {C}_{33}+0\\cdot {C}_{34} \\\\  & =(-5)\\cdot (-1)^{3+2}|\\begin{aligned}3 & 2 & -3 \\\\ 3 & -4 & 1 \\\\ -1 & 5 & 2\\end{aligned}|+(-5)\\cdot (-1)^{3+3}\\cdot |\\begin{aligned}3 & 1 & -3 \\\\ 3 & 6 & 1 \\\\ -1 & 1 & 2\\end{aligned}| \\\\  & =5\\cdot |\\begin{aligned}3 & 2 & -3 \\\\ 3 & -4 & 1 \\\\ -1 & 5 & 2\\end{aligned}|-5\\cdot |\\begin{aligned}3 & 1 & -3 \\\\ 3 & 6 & 1 \\\\ -1 & 1 & 2\\end{aligned}|.\\end{aligned}\n$$",
      "calculator_instructions": "",
      "fields": [
        {
          "key": "selection",
          "type": "radio",
