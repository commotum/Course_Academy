    "q-77481": {
      "dom_id": "step-q77481",
      "name": "Question 2",
      "problem": "$|\\begin{aligned}2 & -1 & 3 & 1 \\\\ -2 & 4 & -2 & 2 \\\\ 0 & 3 & 0 & 0 \\\\ 1 & -3 & -4 & 3\\end{aligned}|=$",
      "worked_solution": "The $3$rd row of the matrix contains three zeros, more than any other row. So using a Laplace expansion along the $3$rd row, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}2 & -1 & 3 & 1 \\\\ -2 & 4 & -2 & 2 \\\\ 0 & 3 & 0 & 0 \\\\ 1 & -3 & -4 & 3\\end{aligned}| & =0\\cdot {C}_{31}+3\\cdot {C}_{32}+0\\cdot {C}_{33}+0\\cdot {C}_{34} \\\\  & =3\\cdot (-1)^{3+2}\\cdot |\\begin{aligned}2 & 3 & 1 \\\\ -2 & -2 & 2 \\\\ 1 & -4 & 3\\end{aligned}| \\\\  & =-3\\cdot |\\begin{aligned}2 & 3 & 1 \\\\ -2 & -2 & 2 \\\\ 1 & -4 & 3\\end{aligned}|.\\end{aligned}\n$$",
      "calculator_instructions": "",
