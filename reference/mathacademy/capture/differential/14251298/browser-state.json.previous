    "q-130016": {
      "dom_id": "step-q130016",
      "name": "Question 5",
      "problem": "$|\\begin{aligned}5 & -2 & 0 & 0 \\\\ 2 & -3 & -2 & 5 \\\\ 7 & 2 & 4 & 3 \\\\ 3 & -6 & 2 & -8\\end{aligned}|=$",
      "worked_solution": "The $1$st row of the matrix contains two zeros, more than any other row. So using a Laplace expansion along the $1$st row, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}5 & -2 & 0 & 0 \\\\ 2 & -3 & -2 & 5 \\\\ 7 & 2 & 4 & 3 \\\\ 3 & -6 & 2 & -8\\end{aligned}| & =5\\cdot {C}_{11}+(-2)\\cdot {C}_{12}+0\\cdot {C}_{13}+0\\cdot {C}_{14} \\\\  & =5\\cdot (-1)^{1+1}|\\begin{aligned}-3 & -2 & 5 \\\\ 2 & 4 & 3 \\\\ -6 & 2 & -8\\end{aligned}|+(-2)\\cdot (-1)^{1+2}\\cdot |\\begin{aligned}2 & -2 & 5 \\\\ 7 & 4 & 3 \\\\ 3 & 2 & -8\\end{aligned}| \\\\  & =5\\cdot |\\begin{aligned}-3 & -2 & 5 \\\\ 2 & 4 & 3 \\\\ -6 & 2 & -8\\end{aligned}|+2\\cdot |\\begin{aligned}2 & -2 & 5 \\\\ 7 & 4 & 3 \\\\ 3 & 2 & -8\\end{aligned}|.\\end{aligned}\n$$",
      "calculator_instructions": "",
      "fields": [
        {
          "key": "selection",
          "type": "radio",
          "choices": [
            {
              "option": "a",
              "dom_id": "questionWidget-choiceLetterCircle-130016-a",
