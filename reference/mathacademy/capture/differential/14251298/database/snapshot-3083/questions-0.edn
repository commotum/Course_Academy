value "5\\cdot |\\begin{aligned}3 & 2 & -3 \\\\ 3 & -4 & 1 \\\\ -1 & 5 & 2\\end{aligned}|-5\\cdot |\\begin{aligned}3 & 1 & -3 \\\\ 3 & 6 & 1 \\\\ -1 & 1 & 2\\end{aligned}|" :db/id #edb/ref 17592186322717} {:answer/id #uuid "ca3de6bd-5cad-5d3f-a265-0f7d2a030b45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5\\cdot |\\begin{aligned}3 & 2 & -3 \\\\ 3 & -4 & 1 \\\\ -1 & 5 & 2\\end{aligned}|-5\\cdot |\\begin{aligned}3 & 1 & -3 \\\\ 3 & 6 & 1 \\\\ -1 & 1 & 2\\end{aligned}|" :db/id #edb/ref 17592186322718} {:answer/id #uuid "caaa81aa-a932-546b-a099-f752c1ad2f52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\cdot |\\begin{aligned}3 & 2 & -3 \\\\ 3 & -4 & 1 \\\\ -1 & 5 & 2\\end{aligned}|+5\\cdot |\\begin{aligned}3 & 1 & -3 \\\\ 3 & 6 & 1 \\\\ -1 & 1 & 2\\end{aligned}|" :db/id #edb/ref 17592186322723} {:answer/id #uuid "fd1959a9-1286-568c-b823-3d8aedb94fa2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5\\cdot |\\begin{aligned}3 & 2 & -3 \\\\ 3 & -4 & 1 \\\\ -1 & 5 & 2\\end{aligned}|" :db/id #edb/ref 17592186323144}] :answer-field/correct {:answer/id #uuid "ca3bc02c-bd7b-56df-8d0d-f0b688490b49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\cdot |\\begin{aligned}3 & 2 & -3 \\\\ 3 & -4 & 1 \\\\ -1 & 5 & 2\\end{aligned}|-5\\cdot |\\begin{aligned}3 & 1 & -3 \\\\ 3 & 6 & 1 \\\\ -1 & 1 & 2\\end{aligned}|" :db/id #edb/ref 17592186322717} :answer-field/id #uuid "9c1fe6f0-fefd-5d07-bd73-536b734ab2ee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323473}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b5116353-6062-5b65-a3e1-05950bfbb7b0" :question/math-academy-id "q-36221" :question/problem "$|\\begin{aligned}3 & 1 & 2 & -3 \\\\ 3 & 6 & -4 & 1 \\\\ 0 & -5 & -5 & 0 \\\\ -1 & 1 & 5 & 2\\end{aligned}|=$" :question/worked-solution "The $3$rd row of the matrix contains two zeros, more than any other row. So using a Laplace expansion along the $3$rd row, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}3 & 1 & 2 & -3 \\\\ 3 & 6 & -4 & 1 \\\\ 0 & -5 & -5 & 0 \\\\ -1 & 1 & 5 & 2\\end{aligned}| & =0\\cdot {C}_{31}+(-5)\\cdot {C}_{32}+(-5)\\cdot {C}_{33}+0\\cdot {C}_{34} \\\\  & =(-5)\\cdot (-1)^{3+2}|\\begin{aligned}3 & 2 & -3 \\\\ 3 & -4 & 1 \\\\ -1 & 5 & 2\\end{aligned}|+(-5)\\cdot (-1)^{3+3}\\cdot |\\begin{aligned}3 & 1 & -3 \\\\ 3 & 6 & 1 \\\\ -1 & 1 & 2\\end{aligned}| \\\\  & =5\\cdot |\\begin{aligned}3 & 2 & -3 \\\\ 3 & -4 & 1 \\\\ -1 & 5 & 2\\end{aligned}|-5\\cdot |\\begin{aligned}3 & 1 & -3 \\\\ 3 & 6 & 1 \\\\ -1 & 1 & 2\\end{aligned}|.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186120424 :knowledge-point/_questions [{:db/id #edb/ref 17592186119773 :knowledge-point/id #uuid "d1637e23-6566-5e45-af4c-b27333f882d1" :knowledge-point/title "Calculating a Determinant Using a Laplace Expansion Across a Row"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2645148c-8f0c-59d8-8328-daf1c11c002e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186324280} {:answer/id #uuid "8423c962-04ae-56a6-a351-28d4870327a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186325084} {:answer/id #uuid "8cbab88f-65b0-53c1-8212-e69a999b2288" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186325165} {:answer/id #uuid "8ed70273-c8e9-55fc-8960-e486a7629dcb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186325182} {:answer/id #uuid "d57a2363-d584-51bb-988e-accd88178c3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186325825}] :answer-field/correct {:answer/id #uuid "2645148c-8f0c-59d8-8328-daf1c11c002e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186324280} :answer-field/id #uuid "60a39b12-5834-56dc-bd92-b12e1a44915e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326386}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "00bb680c-6e72-5c8f-931f-0ff9d17c1cfb" :question/math-academy-id "q-42095" :question/problem "Calculate\n$|\\begin{aligned}1 & 2 & 1 & -1 \\\\ 0 & -4 & -2 & 1 \\\\ 2 & 0 & 0 & 1 \\\\ -3 & 1 & 2 & 0\\end{aligned}|.$" :question/worked-solution "The $3$rd row of the matrix contains two zeros, more than any other row. So using a Laplace expansion along the $3$rd row, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 2 & 1 & -1 \\\\ 0 & -4 & -2 & 1 \\\\ 2 & 0 & 0 & 1 \\\\ -3 & 1 & 2 & 0\\end{aligned}| & =2\\cdot {C}_{31}+0\\cdot {C}_{32}+0\\cdot {C}_{33}+1\\cdot {C}_{34} \\\\  & =2\\cdot (-1)^{3+1}\\cdot |\\begin{aligned}2 & 1 & -1 \\\\ -4 & -2 & 1 \\\\ 1 & 2 & 0\\end{aligned}|+1\\cdot (-1)^{3+4}\\cdot |\\begin{aligned}1 & 2 & 1 \\\\ 0 & -4 & -2 \\\\ -3 & 1 & 2\\end{aligned}| \\\\  & =2|\\begin{aligned}2 & 1 & -1 \\\\ -4 & -2 & 1 \\\\ 1 & 2 & 0\\end{aligned}|-|\\begin{aligned}1 & 2 & 1 \\\\ 0 & -4 & -2 \\\\ -3 & 1 & 2\\end{aligned}|.\\end{aligned}\n$$\n\nNow, computing the first $3\\times 3$ determinant by applying a Laplace expansion along the $3$rd row, we obtain:\n\n$$\n\\begin{aligned}|\\begin{aligned}2 & 1 & -1 \\\\ -4 & -2 & 1 \\\\ 1 & 2 & 0\\end{aligned}| & =1\\cdot {C}_{31}+2\\cdot {C}_{32}+0\\cdot {C}_{33} \\\\  & =1\\cdot (-1)^{3+1}\\cdot |\\begin{aligned}1 & -1 \\\\ -2 & 1\\end{aligned}|+2\\cdot (-1)^{3+2}\\cdot |\\begin{aligned}2 & -1 \\\\ -4 & 1\\end{aligned}| \\\\  & =|\\begin{aligned}1 & -1 \\\\ -2 & 1\\end{aligned}|-2|\\begin{aligned}2 & -1 \\\\ -4 & 1\\end{aligned}| \\\\  & =(1-2)-2(2-4) \\\\  & =-1+4 \\\\  & =3\\end{aligned}\n$$\n\nNow, computing the second $3\\times 3$ determinant by applying a Laplace expansion along the $2$nd row, we obtain:\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 2 & 1 \\\\ 0 & -4 & -2 \\\\ -3 & 1 & 2\\end{aligned}| & =0\\cdot {C}_{21}+(-4)\\cdot {C}_{22}+(-2)\\cdot {C}_{23} \\\\  & =(-4)\\cdot (-1)^{2+2}\\cdot |\\begin{aligned}1 & 1 \\\\ -3 & 2\\end{aligned}|+(-2)\\cdot (-1)^{2+3}\\cdot |\\begin{aligned}1 & 2 \\\\ -3 & 1\\end{aligned}| \\\\  & =-4|\\begin{aligned}1 & 1 \\\\ -3 & 2\\end{aligned}|+2|\\begin{aligned}1 & 2 \\\\ -3 & 1\\end{aligned}| \\\\  & =-4(2+3)+2(1+6) \\\\  & =-20+14 \\\\  & =-6\\end{aligned}\n$$\n\nTherefore,\n\n$$\n|\\begin{aligned}1 & 2 & 1 & -1 \\\\ 0 & -4 & -2 & 1 \\\\ 2 & 0 & 0 & 1 \\\\ -3 & 1 & 2 & 0\\end{aligned}|=2\\cdot 3-(-6)=12.\n$$"}] [{:db/id #edb/ref 17592186392973 :knowledge-point/_questions [{:db/id #edb/ref 17592186119843 :knowledge-point/id #uuid "a88f6712-2115-55ce-abe4-b3c27e2e105f" :knowledge-point/title "Applying a Laplace Expansion Across a Row"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "deea6f11-2212-5136-986d-eb2c6c9161fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\cdot |\\begin{aligned}1 & -2 & 1 \\\\ 4 & 2 & -3 \\\\ 5 & -1 & -2\\end{aligned}|" :db/id #edb/ref 17592186392975} {:answer/id #uuid "dc83f30f-7301-5d68-b5c4-bf0d0381be6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\cdot |\\begin{aligned}1 & -2 & 1 \\\\ 4 & 2 & -3 \\\\ 5 & -1 & -2\\end{aligned}|" :db/id #edb/ref 17592186392976} {:answer/id #uuid "c71fbff2-d8c7-5f96-969d-6b1c6b5f9789" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-|\\begin{aligned}1 & -2 & 1 \\\\ 4 & 2 & -3 \\\\ 5 & -1 & -2\\end{aligned}|" :db/id #edb/ref 17592186392977} {:answer/id #uuid "d75f538e-88e2-521b-8696-849c4f3b1cf8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\cdot |\\begin{aligned}1 & -2 & 1 \\\\ 4 & 2 & -3 \\\\ 5 & -1 & -2\\end{aligned}|" :db/id #edb/ref 17592186392978} {:answer/id #uuid "745346ec-61c9-599a-be09-b23f7093ed5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "|\\begin{aligned}1 & -2 & 1 \\\\ 4 & 2 & -3 \\\\ 5 & -1 & -2\\end{aligned}|" :db/id #edb/ref 17592186392979}] :answer-field/correct {:answer/id #uuid "dc83f30f-7301-5d68-b5c4-bf0d0381be6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\cdot |\\begin{aligned}1 & -2 & 1 \\\\ 4 & 2 & -3 \\\\ 5 & -1 & -2\\end{aligned}|" :db/id #edb/ref 17592186392976} :answer-field/id #uuid "83d6a691-7c53-5720-81d6-4ff94ceac019" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392974}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "77b8f120-b46e-5255-b315-458b6b755462" :question/math-academy-id "q-69950" :question/problem "$|\\begin{aligned}1 & -2 & 1 & 2 \\\\ 4 & 2 & -3 & 1 \\\\ 0 & 0 & 0 & 2 \\\\ 5 & -1 & -2 & 2\\end{aligned}|=$" :question/worked-solution "The $3$rd row of the matrix contains three zeros, more than any other row. So using a Laplace expansion along the $3$rd row, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & -2 & 1 & 2 \\\\ 4 & 2 & -3 & 1 \\\\ 0 & 0 & 0 & 2 \\\\ 5 & -1 & -2 & 2\\end{aligned}| & =0\\cdot {C}_{31}+0\\cdot {C}_{32}+0\\cdot {C}_{33}+2\\cdot {C}_{34} \\\\  & =2\\cdot (-1)^{3+4}\\cdot |\\begin{aligned}1 & -2 & 1 \\\\ 4 & 2 & -3 \\\\ 5 & -1 & -2\\end{aligned}| \\\\  & =-2\\cdot |\\begin{aligned}1 & -2 & 1 \\\\ 4 & 2 & -3 \\\\ 5 & -1 & -2\\end{aligned}|.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338750 :knowledge-point/_questions [{:db/id #edb/ref 17592186119773 :knowledge-point/id #uuid "d1637e23-6566-5e45-af4c-b27333f882d1" :knowledge-point/title "Calculating a Determinant Using a Laplace Expansion Across a Row"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b353273-335f-5780-afb0-be75dcae7075" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186336283} {:answer/id #uuid "2d120b04-e055-5b9e-9000-4eb3aaf2ce01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "72" :db/id #edb/ref 17592186336459} {:answer/id #uuid "40d52219-9a22-5340-9d52-4fb05d2cbce0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "62" :db/id #edb/ref 17592186336640} {:answer/id #uuid "484a4e8b-6df4-53f0-bacc-40a4d9dbcd63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "38" :db/id #edb/ref 17592186336702} {:answer/id #uuid "67b19c38-9273-5308-a318-07e5af5d7a1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "56" :db/id #edb/ref 17592186336958}] :answer-field/correct {:answer/id #uuid "67b19c38-9273-5308-a318-07e5af5d7a1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "56" :db/id #edb/ref 17592186336958} :answer-field/id #uuid "fbaf0ba2-3df2-59a1-a7fc-b27211f32d50" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338725}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6b33eca9-2a94-5443-8eea-bc482a963164" :question/math-academy-id "q-70109" :question/problem "Compute the following determinant using a cofactor expansion along the $4$th row:\n\n$$\n|\\begin{aligned}1 & 4 & 3 & 1 \\\\ 1 & 2 & 0 & 0 \\\\ 0 & 1 & 2 & 3 \\\\ 4 & 0 & 0 & 0\\end{aligned}|.\n$$" :question/worked-solution "Using cofactor expansion along the $4$th row, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 4 & 3 & 1 \\\\ 1 & 2 & 0 & 0 \\\\ 0 & 1 & 2 & 3 \\\\ 4 & 0 & 0 & 0\\end{aligned}| & =4\\cdot {C}_{41}+0\\cdot {C}_{42}+0\\cdot {C}_{43}+0\\cdot {C}_{44} \\\\  & =4\\cdot (-1)^{4+1}\\cdot |\\begin{aligned}4 & 3 & 1 \\\\ 2 & 0 & 0 \\\\ 1 & 2 & 3\\end{aligned}| \\\\  & =-4|\\begin{aligned}4 & 3 & 1 \\\\ 2 & 0 & 0 \\\\ 1 & 2 & 3\\end{aligned}|.\\end{aligned}\n$$\n\nNow, computing the $3\\times 3$ determinant by applying a Laplace expansion along the $2$nd row, we obtain:\n\n$$\n\\begin{aligned}|\\begin{aligned}4 & 3 & 1 \\\\ 2 & 0 & 0 \\\\ 1 & 2 & 3\\end{aligned}| & =2\\cdot {C}_{21}+0\\cdot {C}_{22}+0\\cdot {C}_{23} \\\\  & =2\\cdot (-1)^{2+1}\\cdot |\\begin{aligned}3 & 1 \\\\ 2 & 3\\end{aligned}| \\\\  & =-2|\\begin{aligned}3 & 1 \\\\ 2 & 3\\end{aligned}| \\\\  & =-2(9-2) \\\\  & =-14\\end{aligned}\n$$\n\nTherefore,\n\n$$\n|\\begin{aligned}1 & 4 & 3 & 1 \\\\ 1 & 2 & 0 & 0 \\\\ 0 & 1 & 2 & 3 \\\\ 4 & 0 & 0 & 0\\end{aligned}|=-4\\cdot (-14)=56.\n$$"}] [{:db/id #edb/ref 17592186338751 :knowledge-point/_questions [{:db/id #edb/ref 17592186119773 :knowledge-point/id #uuid "d1637e23-6566-5e45-af4c-b27333f882d1" :knowledge-point/title "Calculating a Determinant Using a Laplace Expansion Across a Row"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "000e1d96-8935-52bc-b473-92fb6b2a631c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186336029} {:answer/id #uuid "66ca18d6-9c9c-5fe7-81e8-baffadbc3312" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186336949} {:answer/id #uuid "784268b3-b15a-510d-b906-29f354e1b2a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186337114} {:answer/id #uuid "7b4e359d-2c20-5e25-a85b-2c50b2ca090a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186337144} {:answer/id #uuid "e28197d9-4a50-5427-a602-17b7dcaf663c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186338004}] :answer-field/correct {:answer/id #uuid "784268b3-b15a-510d-b906-29f354e1b2a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186337114} :answer-field/id #uuid "496c21df-6120-50a3-8f23-74c46cc96ee2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338407}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e26acf58-9de8-5792-a31a-d5cce9613711" :question/math-academy-id "q-70128" :question/problem "Calculate\n$|\\begin{aligned}0 & 1 & 2 & -1 \\\\ 0 & -1 & 0 & 1 \\\\ 2 & 3 & 1 & 1 \\\\ 2 & 0 & -3 & 3\\end{aligned}|.$" :question/worked-solution "The $2$nd row of the given matrix contains two zeros, more than any other row. So, using a Laplace expansion along the $2$nd row, we have   \n\n$$\n\\begin{aligned}|\\begin{aligned}0 & 1 & 2 & -1 \\\\ 0 & -1 & 0 & 1 \\\\ 2 & 3 & 1 & 1 \\\\ 2 & 0 & -3 & 3\\end{aligned}| & =0\\cdot {C}_{21}+(-1)\\cdot {C}_{22}+0\\cdot {C}_{23}+1\\cdot {C}_{24} \\\\  & =(-1)\\cdot (-1)^{2+2}\\cdot |\\begin{aligned}0 & 2 & -1 \\\\ 2 & 1 & 1 \\\\ 2 & -3 & 3\\end{aligned}|+1\\cdot (-1)^{2+4}\\cdot |\\begin{aligned}0 & 1 & 2 \\\\ 2 & 3 & 1 \\\\ 2 & 0 & -3\\end{aligned}| \\\\  & =-|\\begin{aligned}0 & 2 & -1 \\\\ 2 & 1 & 1 \\\\ 2 & -3 & 3\\end{aligned}|+|\\begin{aligned}0 & 1 & 2 \\\\ 2 & 3 & 1 \\\\ 2 & 0 & -3\\end{aligned}|.\\end{aligned}\n$$\n\nNow, computing the first $3\\times 3$  determinant by applying a Laplace expansion along the $1$st row, we obtain:\n\n$$\n\\begin{aligned}|\\begin{aligned}0 & 2 & -1 \\\\ 2 & 1 & 1 \\\\ 2 & -3 & 3\\end{aligned}| & =0\\cdot {C}_{11}+2\\cdot {C}_{12}+(-1)\\cdot {C}_{13} \\\\  & =2\\cdot (-1)^{1+2}\\cdot |\\begin{aligned}2 & 1 \\\\ 2 & 3\\end{aligned}|+(-1)\\cdot (-1)^{1+3}\\cdot |\\begin{aligned}2 & 1 \\\\ 2 & -3\\end{aligned}| \\\\  & =-2|\\begin{aligned}2 & 1 \\\\ 2 & 3\\end{aligned}|-|\\begin{aligned}2 & 1 \\\\ 2 & -3\\end{aligned}| \\\\  & =-2(6-2)-(-6-2) \\\\  & =-8-(-8) \\\\  & =0\\end{aligned}\n$$\n\nFinally, we compute the second $3\\times 3$ determinant by applying a Laplace expansion along the $1$st row:\n\n$$\n\\begin{aligned}|\\begin{aligned}0 & 1 & 2 \\\\ 2 & 3 & 1 \\\\ 2 & 0 & -3\\end{aligned}| & =0\\cdot {C}_{11}+1\\cdot {C}_{12}+2\\cdot {C}_{13} \\\\  & =1\\cdot (-1)^{1+2}\\cdot |\\begin{aligned}2 & 1 \\\\ 2 & -3\\end{aligned}|+(2)\\cdot (-1)^{1+3}\\cdot |\\begin{aligned}2 & 3 \\\\ 2 & 0\\end{aligned}| \\\\  & =-|\\begin{aligned}2 & 1 \\\\ 2 & -3\\end{aligned}|+2|\\begin{aligned}2 & 3 \\\\ 2 & 0\\end{aligned}| \\\\  & =-(-6-2)+2(0-6) \\\\  & =-(-8)+2\\cdot (-6) \\\\  & =8-12 \\\\  & =-4\\end{aligned}\n$$\n\nTherefore,\n\n$$\n|\\begin{aligned}1 & 2 & 1 & -1 \\\\ 0 & -4 & -2 & 1 \\\\ 2 & 0 & 0 & 1 \\\\ -3 & 1 & 2 & 0\\end{aligned}|=-0+(-4)=-4.\n$$"}] [{:db/id #edb/ref 17592186345305 :knowledge-point/_questions [{:db/id #edb/ref 17592186119843 :knowledge-point/id #uuid "a88f6712-2115-55ce-abe4-b3c27e2e105f" :knowledge-point/title "Applying a Laplace Expansion Across a Row"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4181657e-bef8-5bd8-86ba-a0dc4bcb1328" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\cdot |\\begin{aligned}-2 & -2 & 2 \\\\ 2 & 3 & 1 \\\\ 1 & -4 & 3\\end{aligned}|" :db/id #edb/ref 17592186342776} {:answer/id #uuid "8acdc0e6-b529-56de-9823-ca79949873cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "|\\begin{aligned}2 & 3 & 1 \\\\ 1 & -4 & 3 \\\\ -2 & -2 & 2\\end{aligned}|" :db/id #edb/ref 17592186343447} {:answer/id #uuid "8b32d2ac-71ed-5393-9c06-566b463f4b2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\cdot |\\begin{aligned}2 & 3 & 1 \\\\ -2 & -2 & 2 \\\\ 1 & -4 & 3\\end{aligned}|" :db/id #edb/ref 17592186343450} {:answer/id #uuid "990c13b7-95ba-521a-9304-fa8b166a3978" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\cdot |\\begin{aligned}2 & 3 & 1 \\\\ -2 & -2 & 2 \\\\ 0 & 3 & 0\\end{aligned}|" :db/id #edb/ref 17592186343583} {:answer/id #uuid "b8ec4375-4789-59b2-b472-016291083078" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\cdot |\\begin{aligned}2 & -1 & 3 \\\\ -2 & -2 & 2 \\\\ 1 & -3 & -4\\end{aligned}|" :db/id #edb/ref 17592186343861}] :answer-field/correct {:answer/id #uuid "8b32d2ac-71ed-5393-9c06-566b463f4b2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\cdot |\\begin{aligned}2 & 3 & 1 \\\\ -2 & -2 & 2 \\\\ 1 & -4 & 3\\end{aligned}|" :db/id #edb/ref 17592186343450} :answer-field/id #uuid "cca33b3f-5998-5d52-8f34-7de42faab193" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344847}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "64bf6a39-abf5-5018-a960-bf7a8fbd2ffd" :question/math-academy-id "q-77481" :question/problem "$|\\begin{aligned}2 & -1 & 3 & 1 \\\\ -2 & 4 & -2 & 2 \\\\ 0 & 3 & 0 & 0 \\\\ 1 & -3 & -4 & 3\\end{aligned}|=$" :question/worked-solution "The $3$rd row of the matrix contains three zeros, more than any other row. So using a Laplace expansion along the $3$rd row, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}2 & -1 & 3 & 1 \\\\ -2 & 4 & -2 & 2 \\\\ 0 & 3 & 0 & 0 \\\\ 1 & -3 & -4 & 3\\end{aligned}| & =0\\cdot {C}_{31}+3\\cdot {C}_{32}+0\\cdot {C}_{33}+0\\cdot {C}_{34} \\\\  & =3\\cdot (-1)^{3+2}\\cdot |\\begin{aligned}2 & 3 & 1 \\\\ -2 & -2 & 2 \\\\ 1 & -4 & 3\\end{aligned}| \\\\  & =-3\\cdot |\\begin{aligned}2 & 3 & 1 \\\\ -2 & -2 & 2 \\\\ 1 & -4 & 3\\end{aligned}|.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393709 :knowledge-point/_questions [{:db/id #edb/ref 17592186119774 :knowledge-point/id #uuid "db6f57f3-d9f0-5ea7-a557-e729a8c0777f" :knowledge-point/title "Calculating a Determinant Using a Laplace Expansion Across a Column"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f529956a-04b4-5981-a298-2a32bb012c7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\cdot |\\begin{aligned}3 & -1 & 4 \\\\ 1 & 5 & 0 \\\\ 1 & 5 & 4\\end{aligned}|" :db/id #edb/ref 17592186393711} {:answer/id #uuid "62518129-799d-5a5c-b66d-65a30b86adfb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\cdot |\\begin{aligned}3 & -1 & 0 \\\\ 1 & 2 & 5 \\\\ -1 & 2 & 4\\end{aligned}|" :db/id #edb/ref 17592186393712} {:answer/id #uuid "1da5bf0f-3c66-58e0-8dfe-d519a5ec870b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\cdot |\\begin{aligned}3 & -1 & 4 \\\\ 1 & 2 & 0 \\\\ 1 & 2 & 0\\end{aligned}|" :db/id #edb/ref 17592186393713} {:answer/id #uuid "175bfded-3331-5f45-9d21-f820921396c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\cdot |\\begin{aligned}3 & -1 & 4 \\\\ 1 & 2 & 0 \\\\ 1 & 2 & 4\\end{aligned}|" :db/id #edb/ref 17592186393714} {:answer/id #uuid "6fafed7d-7bf8-576f-9c99-c605263173fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\cdot |\\begin{aligned}3 & -1 & 4 \\\\ 2 & 0 & 2 \\\\ 1 & 2 & 4\\end{aligned}|" :db/id #edb/ref 17592186393715}] :answer-field/correct {:answer/id #uuid "175bfded-3331-5f45-9d21-f820921396c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\cdot |\\begin{aligned}3 & -1 & 4 \\\\ 1 & 2 & 0 \\\\ 1 & 2 & 4\\end{aligned}|" :db/id #edb/ref 17592186393714} :answer-field/id #uuid "bed429e7-7e1a-5af7-8bd6-8ff0cb1edcc5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393710}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "23708dd8-2d47-5f1e-8545-2d6c9ad9cd69" :question/math-academy-id "q-77500" :question/problem "$|\\begin{aligned}3 & -1 & 4 & 0 \\\\ 2 & 0 & 2 & 5 \\\\ 1 & 2 & 0 & 0 \\\\ 1 & 2 & 4 & 0\\end{aligned}|=$" :question/worked-solution "Using a cofactor expansion along the $4$th column, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}3 & -1 & 4 & 0 \\\\ 2 & 0 & 2 & 5 \\\\ 1 & 2 & 0 & 0 \\\\ 1 & 2 & 4 & 0\\end{aligned}| & =0\\cdot {C}_{14}+5\\cdot {C}_{24}+0\\cdot {C}_{34}+0\\cdot {C}_{44} \\\\  & =5\\cdot (-1)^{2+4}\\cdot |\\begin{aligned}3 & -1 & 4 \\\\ 1 & 2 & 0 \\\\ 1 & 2 & 4\\end{aligned}| \\\\  & =5\\cdot |\\begin{aligned}3 & -1 & 4 \\\\ 1 & 2 & 0 \\\\ 1 & 2 & 4\\end{aligned}|.\\end{aligned}\n$$"}]}
