\\\\ -7 & 2 & -4 & 1 \\\\ 0 & 7 & 2 & -3 \\\\ 0 & 2 & -3 & -1\\end{aligned}| & =0\\cdot {C}_{11}+-7\\cdot {C}_{21}+0\\cdot {C}_{31}+0\\cdot {C}_{41} \\\\  & =(-7)\\cdot (-1)^{2+1}\\cdot |\\begin{aligned}3 & 1 & 5 \\\\ 7 & 2 & -3 \\\\ 2 & -3 & -1\\end{aligned}| \\\\  & =7\\cdot |\\begin{aligned}3 & 1 & 5 \\\\ 7 & 2 & -3 \\\\ 2 & -3 & -1\\end{aligned}|.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186323769 :knowledge-point/_questions [{:db/id #edb/ref 17592186119774 :knowledge-point/id #uuid "db6f57f3-d9f0-5ea7-a557-e729a8c0777f" :knowledge-point/title "Calculating a Determinant Using a Laplace Expansion Across a Column"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4fac551b-7d4c-565c-a1e9-ea88bd7b2009" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\cdot |\\begin{aligned}1 & -1 & 1 \\\\ -3 & 5 & 1 \\\\ -2 & -1 & -2\\end{aligned}|" :db/id #edb/ref 17592186321771} {:answer/id #uuid "6be3792f-15b6-502f-88f0-9b926d407ce3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-|\\begin{aligned}1 & -1 & 1 \\\\ -3 & 5 & 1 \\\\ -2 & -1 & -2\\end{aligned}|" :db/id #edb/ref 17592186321987} {:answer/id #uuid "703e3a79-4c6b-5707-b99b-9af7e67f2c71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\cdot |\\begin{aligned}1 & -1 & 1 \\\\ -3 & 5 & 1 \\\\ -2 & -1 & -2\\end{aligned}|" :db/id #edb/ref 17592186322020} {:answer/id #uuid "bfac9315-5761-5c50-8513-2a59e0d9f9a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4\\cdot |\\begin{aligned}1 & -1 & 1 \\\\ -3 & 5 & 1 \\\\ -2 & -1 & -2\\end{aligned}|" :db/id #edb/ref 17592186322635} {:answer/id #uuid "d85d3c92-4073-5a64-bb35-3da35e2100e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "|\\begin{aligned}1 & -1 & 1 \\\\ -3 & 5 & 1 \\\\ -2 & -1 & -2\\end{aligned}|" :db/id #edb/ref 17592186322839}] :answer-field/