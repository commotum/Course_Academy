 \\\\ -3 & 0 & 1 & 2 \\\\ -2 & 0 & 3 & -1\\end{vmatrix}=$" #edb/ref 17592186045417] [17592186571396 #edb/ref 1072 #uuid "4f9ad428-3dfc-5d8c-ae39-56b5c0911ce9" #edb/ref 17592186045417] [17592186571396 #edb/ref 1074 "Using a cofactor expansion along the $2$nd column, we have\n\n$$\n\\begin{aligned}\\begin{vmatrix}2 & 0 & -1 & 3 \\\\ 1 & 7 & 2 & -1 \\\\ -3 & 0 & 1 & 2 \\\\ -2 & 0 & 3 & -1\\end{vmatrix} & =0\\cdot {C}_{12}+7\\cdot {C}_{22}+0\\cdot {C}_{32}+0\\cdot {C}_{42} \\\\  & =7\\cdot (-1)^{2+2}\\cdot \\begin{vmatrix}2 & -1 & 3 \\\\ -3 & 1 & 2 \\\\ -2 & 3 & -1\\end{vmatrix} \\\\  & =7\\cdot \\begin{vmatrix}2 & -1 & 3 \\\\ -3 & 1 & 2 \\\\ -2 & 3 & -1\\end{vmatrix}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186571413 #edb/ref 1068 #edb/ref 17592186571318 #edb/ref 17592186045417] [17592186571413 #edb/ref 1069 "q-130016" #edb/ref 17592186045417] [17592186571413 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186571413 #edb/ref 1071 "$\\begin{vmatrix}5 & -2 & 0 & 0 \\\\ 2 & -3 & -2 & 5 \\\\ 7 & 2 & 4 & 3 \\\\ 3 & -6 & 2 & -8\\end{vmatrix}=$" #edb/ref 17592186045417] [17592186571413 #edb/ref 1072 #uuid "6d98c7f4-5b71-5445-b0c2-3ae12d58e232" #edb/ref 17592186045417] [17592186571413 #edb/ref 1074 "The $1$st row of the matrix contains two zeros, more than any other row. So using a Laplace expansion along the $1$st row, we have\n\n$$\n\\begin{aligned}\\begin{vmatrix}5 & -2 & 0 & 0 \\\\ 2 & -3 & -2 & 5 \\\\ 7 & 2 & 4 & 3 \\\\ 3 & -6 & 2 & -8\\end{vmatrix} & =5\\cdot {C}_{11}+(-2)\\cdot {C}_{12}+0\\cdot {C}_{13}+0\\cdot {C}_{14} \\\\  & =5\\cdot (-1)^{1+1}\\begin{vmatrix}-3 & -2 & 5 \\\\ 2 & 4 & 3 \\\\ -6 & 2 & -8\\end{vmatrix}+(-2)\\cdot (-1)^{1+2}\\cdot \\begin{vmatrix}2 & -2 & 5 \\\\ 7 & 4 & 3 \\\\ 3 & 2 & -8\\end{vmatrix} \\\\  & =5\\cdot \\begin{vmatrix}-3 & -2 & 5 \\\\ 2 & 4 & 3 \\\\ -6 & 2 & -8\\end{vmatrix}+2\\cdot \\begin{vmatrix}2 & -2 & 5 \\\\ 7 & 4 & 3 \\\\ 3 & 2 & -8\\end{vmatrix}.\\end{aligned}\n$$" #edb/ref 17592186045417] [175921865