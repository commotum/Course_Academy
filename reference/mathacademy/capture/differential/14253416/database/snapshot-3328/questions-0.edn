eld/choices [{:answer/id #uuid "24f05d09-5866-526f-89e0-015abc3a350f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0,2)$ only" :db/id #edb/ref 17592186507643} {:answer/id #uuid "5d9e09ac-9afa-5c58-a5b6-e260d9ae3735" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The hyperboloid does not intersect the $z$-axis" :db/id #edb/ref 17592186507735} {:answer/id #uuid "7ef7480b-38c1-599a-b433-084149902947" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0,-4)$ and $(0,0,2)$" :db/id #edb/ref 17592186507786} {:answer/id #uuid "9d8befc7-a689-5d26-9fc6-529209bfcbe1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0,-1)$ only" :db/id #edb/ref 17592186507819} {:answer/id #uuid "bbf884f2-f6b1-51b5-8d26-4535c1ab921c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0,-3)$ and $(0,0,3)$" :db/id #edb/ref 17592186507858}] :answer-field/correct {:answer/id #uuid "7ef7480b-38c1-599a-b433-084149902947" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0,-4)$ and $(0,0,2)$" :db/id #edb/ref 17592186507786} :answer-field/id #uuid "41b2046a-1076-5804-ad5b-bbdc2b3b7878" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186507966}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "10b62984-455d-5702-af01-c69ee89bcccb" :question/math-academy-id "q-164281" :question/problem "Given the hyperboloid of two sheets $\\frac{{x}^{2}}{3}+\\frac{{y}^{2}}{5}-\\frac{(z+1)^{2}}{9}=-1,$ find its $z$-intercepts." :question/worked-solution "To find the $z$-intercepts, we plug $x=0$ and $y=0$ into the equation: \n\n$$\n\\begin{aligned}\\frac{{0}^{2}}{3}+\\frac{{0}^{2}}{5}-\\frac{(z+1)^{2}}{9} & =-1 \\\\ -\\frac{(z+1)^{2}}{9} & =-1 \\\\ (z+1)^{2} & =9 \\\\ z+1 & =\\pm 3 \\\\ z & =-1\\pm 3\\end{aligned}\n$$\n\nHence, we get the solutions $z=-4$ and $z=2.$\n\nTherefore, the intercepts with the $z$-axis are $(0,0,-4)$ and $(0,0,2).$"}] [{:db/id #edb/ref 17592186488263 :knowledge-point/_questions [{:db/id #edb/ref 17592186124555 :knowledge-point/id #uuid "d28eda1a-a90b-57e9-969a-eb36552e413e" :knowledge-point/title "Finding Traces of Hyperboloids"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58602c0f-accf-5f29-9ed8-3bc7fca41325" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}-\\frac{{x}^{2}}{4}=1" :db/id #edb/ref 17592186487746} {:answer/id #uuid "9f47998e-e870-56c4-baa4-8f352b659234" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{4}+{z}^{2}=1" :db/id #edb/ref 17592186487862} {:answer/id #uuid "a290ce1e-061b-5f18-9739-ce332aa415a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{z}^{2}-\\frac{{x}^{2}}{4}=1" :db/id #edb/ref 17592186487870} {:answer/id #uuid "cd8afb28-1c32-5f0f-a8c4-af9d56f35d12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{4}-{z}^{2}=1" :db/id #edb/ref 17592186487959} {:answer/id #uuid "ecef13cd-61bd-588f-a9df-6b1c14e317f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{4}-{y}^{2}=1" :db/id #edb/ref 17592186488014}] :answer-field/correct {:answer/id #uuid "cd8afb28-1c32-5f0f-a8c4-af9d56f35d12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{4}-{z}^{2}=1" :db/id #edb/ref 17592186487959} :answer-field/id #uuid "eb913cd1-fa9a-53a5-80ea-84008e65ffbc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186488163}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cfd858a6-a00f-5a94-8347-c41608b62519" :question/math-academy-id "q-164375" :question/problem "What is the trace in the $xz$-plane of the hyperboloid of two sheets $-\\frac{{x}^{2}}{4}+{y}^{2}+{z}^{2}=-1?$" :question/worked-solution "To find the trace in the $xz$-plane, we substitute $y=0$ into the equation of the hyperboloid. This gives:\n\n$$\n\\begin{aligned}-\\frac{{x}^{2}}{4}+{0}^{2}+{z}^{2} & =-1 \\\\ -\\frac{{x}^{2}}{4}+{z}^{2} & =-1 \\\\ \\frac{{x}^{2}}{4}-{z}^{2} & =1\\end{aligned}\n$$\n\nwhich is the equation of a hyperbola in $xz$-plane."}] [{:db/id #edb/ref 17592186323679 :knowledge-point/_questions [{:db/id #edb/ref 17592186124650 :knowledge-point/id #uuid "cf44a846-8458-5e2f-bef3-72cf87a6035f" :knowledge-point/title "Identifying the Intercepts of a Hyperboloid"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50e8e404-1843-5d61-abfa-27a05c72d661" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,1-\\sqrt{5},0)$ and $(0,1+\\sqrt{5},0)$" :db/id #edb/ref 17592186321783} {:answer/id #uuid "87401400-555e-5ae7-9fdc-11eaf7447504" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,4,0)$ and $(0,6,0)$" :db/id #edb/ref 17592186322221} {:answer/id #uuid "9100a4fc-8289-597e-b9e9-805f6d9f5ed7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,-\\sqrt{5},0)$ and $(0,\\sqrt{5},0)$" :db/id #edb/ref 17592186322299} {:answer/id #uuid "9ceca731-44a6-5d00-bfb2-a54ef31c9413" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,-4,0)$ and $(0,6,0)$" :db/id #edb/ref 17592186322385} {:answer/id #uuid "ba6b5100-6fff-587c-97a6-3a56ecebaa52" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,\\sqrt{5}-1,0)$ and $(0,\\sqrt{5}+1,0)$" :db/id #edb/ref 17592186322594}] :answer-field/correct {:answer/id #uuid "50e8e404-1843-5d61-abfa-27a05c72d661" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,1-\\sqrt{5},0)$ and $(0,1+\\sqrt{5},0)$" :db/id #edb/ref 17592186321783} :answer-field/id #uuid "77438571-7f58-53c7-90a5-f500c17a4293" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323402}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "40f09dba-8d73-5062-813a-36456c356837" :question/math-academy-id "q-35489" :question/problem "Given the hyperboloid of one sheet $\\frac{{x}^{2}}{4}+\\frac{(y-1)^{2}}{4}-\\frac{(z-2)^{2}}{16}=1$, find its $y$-intercepts." :question/worked-solution "To find the $y$-intercepts, we plug $x=0$ and $z=0$ into the equation: \n\n$$\n\\begin{aligned}\\frac{{0}^{2}}{4}+\\frac{(y-1)^{2}}{4}-\\frac{(0-2)^{2}}{16} & =1 \\\\ \\frac{(y-1)^{2}}{4}-\\frac{1}{4} & =1 \\\\ (y-1)^{2}-1 & =4 \\\\ (y-1)^{2} & =5 \\\\ y-1 & =\\pm \\sqrt{5} \\\\ y & =1\\pm \\sqrt{5}\\end{aligned}\n$$\n\nHence, we get the solutions $y=1-\\sqrt{5}$ and $1+\\sqrt{5}.$\n\nTherefore, the intercepts with the $y$-axis are $(0,1-\\sqrt{5},0)$ and $(0,1+\\sqrt{5},0).$"}] [{:db/id #edb/ref 17592186380001 :knowledge-point/_questions [{:db/id #edb/ref 17592186124650 :knowledge-point/id #uuid "cf44a846-8458-5e2f-bef3-72cf87a6035f" :knowledge-point/title "Identifying the Intercepts of a Hyperboloid"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f3f82566-5f12-546c-82b0-91ff95280fce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,-7,0)$ only" :db/id #edb/ref 17592186380003} {:answer/id #uuid "ca09d51d-33cd-5025-bec6-bcfc9ed17a7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,5,0)$ only" :db/id #edb/ref 17592186380004} {:answer/id #uuid "95460958-bfac-5c41-b88d-76954762b44d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,7,0)$ only" :db/id #edb/ref 17592186380005} {:answer/id #uuid "60e39317-e833-5b4d-b454-0961afe6241c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,-5,0)$ and $(0,7,0).$" :db/id #edb/ref 17592186380006} {:answer/id #uuid "e331bc87-d63c-5fe2-9e5c-31cb7cae7dec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,-7,0)$ and $(0,5,0)$" :db/id #edb/ref 17592186380007}] :answer-field/correct {:answer/id #uuid "e331bc87-d63c-5fe2-9e5c-31cb7cae7dec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,-7,0)$ and $(0,5,0)$" :db/id #edb/ref 17592186380007} :answer-field/id #uuid "6dcc291c-4954-551e-ad01-f5ae2186972c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186380002}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bf283ca2-929b-5610-b3d7-b10bc3f02ca9" :question/math-academy-id "q-74012" :question/problem "Given the hyperboloid of one sheet $\\frac{{x}^{2}}{6}+\\frac{(y+1)^{2}}{12}-\\frac{(z-2)^{2}}{2}=1$, find its $y$-intercepts." :question/worked-solution "To find the $y$-intercepts, we plug $x=0$ and $z=0$ into the equation:\n\n$$\n\\begin{aligned}\\frac{{0}^{2}}{6}+\\frac{(y+1)^{2}}{12}-\\frac{(0-2)^{2}}{2} & =1 \\\\ \\frac{(y+1)^{2}}{12}-2 & =1 \\\\ \\frac{(y+1)^{2}}{12} & =3 \\\\ (y+1)^{2} & =36 \\\\ y+1 & =\\pm 6 \\\\ y & =-1\\pm 6\\end{aligned}\n$$\n\nHence, we get the solutions $x=-7$ and $x=5.$\n\nTherefore, the intercepts with the $y$-axis are $(0,-7,0)$ and $(0,5,0).$"}]}
