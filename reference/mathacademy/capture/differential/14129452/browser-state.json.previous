ttp://www.w3.org/1998/Math/MathML\" display=\"block\"><mtable displaystyle=\"true\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"0.8em 0.8em 0.8em 0.8em 0.3em\"><mtr><mtd><mi>F</mi><mo stretchy=\"false\">(</mo><mn>1</mn><mo stretchy=\"false\">)</mo></mtd><mtd><mi></mi><mo>=</mo><mi>P</mi><mo stretchy=\"false\">(</mo><mi>X</mi><mo>≤</mo><mn>1</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mi>P</mi><mo stretchy=\"false\">(</mo><mi>X</mi><mo>=</mo><mn>0</mn><mo stretchy=\"false\">)</mo><mo>+</mo><mi>P</mi><mo stretchy=\"false\">(</mo><mi>X</mi><mo>=</mo><mn>1</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"OPEN\"><mo minsize=\"2.047em\" maxsize=\"2.047em\">(</mo></mrow><mfrac linethickness=\"0\"><mn>6</mn><mn>0</mn></mfrac><mrow data-mjx-texclass=\"CLOSE\"><mo minsize=\"2.047em\" maxsize=\"2.047em\">)</mo></mrow></mrow><mo stretchy=\"false\">(</mo><mn>0.26</mn><msup><mo stretchy=\"false\">)</mo><mn>0</mn></msup><mo stretchy=\"false\">(</mo><mn>1</mn><mo>−</mo><mn>0.26</mn><msup><mo stretchy=\"false\">)</mo><mrow data-mjx-texclass=\"ORD\"><mn>6</mn><mo>−</mo><mn>0</mn></mrow></msup><mo>+</mo><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"OPEN\"><mo minsize=\"2.047em\" maxsize=\"2.047em\">(</mo></mrow><mfrac linethickness=\"0\"><mn>6</mn><mn>1</mn></mfrac><mrow data-mjx-texclass=\"CLOSE\"><mo minsize=\"2.047em\" maxsize=\"2.047em\">)</mo></mrow></mrow><mo stretchy=\"false\">(</mo><mn>0.26</mn><msup><mo stretchy=\"false\">)</mo><mn>1</mn></msup><mo stretchy=\"false\">(</mo><mn>1</mn><mo>−</mo><mn>0.26</mn><msup><mo stretchy=\"false\">)</mo><mrow data-mjx-texclass=\"ORD\"><mn>6</mn><mo>−</mo><mn>1</mn></mrow></msup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>1</mn><mo>⋅</mo><mo stretchy=\"false\">(</mo><mn>0.26</mn><msup><mo stretchy=\"false\">)</mo><mn>0</mn></msup><mo>⋅</mo><mo stretchy=\"false\">(</mo><mn>0.74</mn><msup><mo stretchy=\"false\">)</mo><mn>6</mn></msup><mo>+</mo><mn>6</mn><mo>⋅</mo><mo stretchy=\"false\">(</mo><mn>0.26</mn><msup><mo stretchy=\"false\">)</mo><mn>1</mn></msup><mo>⋅</mo><mo stretchy=\"false\">(</mo><mn>0.74</mn><msup><mo stretchy=\"false\">)</mo><mn>5</mn></msup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>≈</mo><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mn>0.5104</mn></mpadded></mstyle><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
