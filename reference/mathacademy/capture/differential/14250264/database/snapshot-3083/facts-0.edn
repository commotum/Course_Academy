f 17592186045417] [17592186570597 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186570597 #edb/ref 1078 #edb/ref 17592186570527 #edb/ref 17592186045417] [17592186570597 #edb/ref 1079 #uuid "2d8564e2-8428-52a2-bc1e-e897b6b73c0b" #edb/ref 17592186045417] [17592186570601 #edb/ref 1075 #edb/ref 17592186570142 #edb/ref 17592186045417] [17592186570601 #edb/ref 1075 #edb/ref 17592186570187 #edb/ref 17592186045417] [17592186570601 #edb/ref 1075 #edb/ref 17592186570334 #edb/ref 17592186045417] [17592186570601 #edb/ref 1075 #edb/ref 17592186570396 #edb/ref 17592186045417] [17592186570601 #edb/ref 1075 #edb/ref 17592186570405 #edb/ref 17592186045417] [17592186570601 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186570601 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186570601 #edb/ref 1078 #edb/ref 17592186570334 #edb/ref 17592186045417] [17592186570601 #edb/ref 1079 #uuid "3c38e3c1-1d1c-5a27-b17b-40b29b8fb328" #edb/ref 17592186045417] [17592186570659 #edb/ref 1075 #edb/ref 17592186570347 #edb/ref 17592186045417] [17592186570659 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186570659 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186570659 #edb/ref 1078 #edb/ref 17592186570347 #edb/ref 17592186045417] [17592186570659 #edb/ref 1079 #uuid "ad2d4819-5891-5f49-ae40-2b183406271e" #edb/ref 17592186045417] [17592186570702 #edb/ref 1068 #edb/ref 17592186570586 #edb/ref 17592186045417] [17592186570702 #edb/ref 1069 "q-46832" #edb/ref 17592186045417] [17592186570702 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186570702 #edb/ref 1071 "Evaluate ${lim}_{x\\to {4}^{-}}\\frac{8-4\\sqrt{x}}{x-4}.$" #edb/ref 17592186045417] [17592186570702 #edb/ref 1072 #uuid "13cd01f5-b70e-51c8-add8-d0b755916801" #edb/ref 17592186045417] [17592186570702 #edb/ref 1074 "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to {4}^{-}}\\frac{8-4\\sqrt{x}}{x-4} & =\\frac{8-4\\sqrt{4}}{4-4}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, we need to first simplify the limit. Since the radical is in the numerator, we can multiply the numerator and the denominator by the conjugate of the numerator. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to {4}^{-}}\\frac{8-4\\sqrt{x}}{x-4} & ={lim}_{x\\to {4}^{-}}\\frac{4(2-\\sqrt{x})}{x-4} \\\\  & ={lim}_{x\\to {4}^{-}}\\frac{4(2-\\sqrt{x})(2+\\sqrt{x})}{(x-4)(2+\\sqrt{x})} \\\\  & ={lim}_{x\\to {4}^{-}}\\frac{4({2}^{2}-{(\\sqrt{x})}^{2})}{(x-4)(2+\\sqrt{x})} \\\\  & ={lim}_{x\\to {4}^{-}}\\frac{4(4-x)}{(x-4)(2+\\sqrt{x})} \\\\  & ={lim}_{x\\to {4}^{-}}\\frac{-4(x-4)}{(x-4)(2+\\sqrt{x})} \\\\  & ={lim}_{x\\to {4}^{-}}\\frac{-4}{2+\\sqrt{x}} \\\\  & =\\frac{-4}{2+\\sqrt{4}} \\\\  & =-1.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186570720 #edb/ref 1068 #edb/ref 17592186570659 #edb/ref 17592186045417] [17592186570720 #edb/ref 1069 "q-338523" #edb/ref 17592186045417] [17592186570720 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186570720 #edb/ref 1071 "Evaluate the following limit:\n\n${lim}_{x\\to 1}\\frac{x-1}{\\sqrt{3x+2}-\\sqrt{4x+1}}=$\n{{field-1}}" #edb/ref 17592186045417] [17592186570720 #edb/ref 1072 #uuid "386a05f8-a2c4-54b1-8442-7cec1d9c62b6" #edb/ref 17592186045417] [17592186570720 #edb/ref 1074 "If we attempt to evaluate the limit by simply evaluating the function at $x=1,$ we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{x-1}{\\sqrt{3x+2}-\\sqrt{4x+1}} & =\\frac{1-1}{\\sqrt{3(1)+2}-\\sqrt{4(1)+1}}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, we need to first simplify the limit. Since the radical is in the denominator, we can multiply the numerator and the denominator by the conjugate of the denominator. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{x-1}{\\sqrt{3x+2}-\\sqrt{4x+1}} & ={lim}_{x\\to 1}\\frac{(x-1)(\\sqrt{3x+2}+\\sqrt{4x+1})}{(\\sqrt{3x+2}-\\sqrt{4x+1})(\\sqrt{3x+2}+\\sqrt{4x+1})} \\\\  & ={lim}_{x\\to 1}\\frac{(x-1)(\\sqrt{3x+2}+\\sqrt{4x+1})}{(\\sqrt{3x+2})^{2}-(\\sqrt{4x+1})^{2}} \\\\  & ={lim}_{x\\to 1}\\frac{(x-1)(\\sqrt{3x+2}+\\sqrt{4x+1})}{(3x+2)-(4x+1)} \\\\  & ={lim}_{x\\to 1}\\frac{-(1-x)(\\sqrt{3x+2}+\\sqrt{4x+1})}{1-x} \\\\  & ={lim}_{x\\to 1}[-(\\sqrt{3x+2}+\\sqrt{4x+1})] \\\\  & =-(\\sqrt{5}+\\sqrt{5}) \\\\  & =-2\\sqrt{5}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186570736 #edb/ref 1068 #edb/ref 17592186570601 #edb/ref 17592186045417] [17592186570736 #edb/ref 1069 "q-46837" #edb/ref 17592186045417] [17592186570736 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186570736 #edb/ref 1071 "Evaluate ${lim}_{x\\to {3}^{-}}\\frac{3-\\sqrt{3x}}{x-3}.$" #edb/ref 17592186045417] [17592186570736 #edb/ref 1072 #uuid "662345c5-cd55-5265-8f67-e438e3ccf7b5" #edb/ref 17592186045417] [17592186570736 #edb/ref 1074 "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to {3}^{-}}\\frac{3-\\sqrt{3x}}{x-3} & =\\frac{3-\\sqrt{3(3)}}{3-3}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, we need to first simplify the limit. Since the radical is in the numerator, we can multiply the numerator and the denominator by the conjugate of the numerator. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to {3}^{-}}\\frac{3-\\sqrt{3x}}{x-3} & ={lim}_{x\\to {3}^{-}}\\frac{(3-\\sqrt{3x})(3+\\sqrt{3x})}{(x-3)(3+\\sqrt{3x})} \\\\  & ={lim}_{x\\to {3}^{-}}\\frac{{3}^{2}-{(\\sqrt{3x})}^{2}}{(x-3)(3+\\sqrt{3x})} \\\\  & ={lim}_{x\\to {3}^{-}}\\frac{9-3x}{(x-3)(3+\\sqrt{3x})} \\\\  & ={lim}_{x\\to {3}^{-}}\\frac{-3(x-3)}{(x-3)(3+\\sqrt{3x})} \\\\  & ={lim}_{x\\to {3}^{-}}\\frac{-3}{3+\\sqrt{3x}} \\\\  & =\\frac{-3}{3+\\sqrt{3\\cdot 3}} \\\\  & =-\\frac{1}{2}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186570745 #edb/ref 1068 #edb/ref 17592186570597 #edb/ref 17592186045417] [17592186570745 #edb/ref 1069 "q-338468" #edb/ref 17592186045417] [17592186570745 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186570745 #edb/ref 1071 "Evaluate the following limit:\n\n${lim}_{x\\to 1}\\frac{\\sqrt{x}-1}{x-1}=$\n{{field-1}}" #edb/ref 17592186045417] [17592186570745 #edb/ref 1072 #uuid "782d71a6-13dd-5aa9-bf77-a0e9f83d71b5" #edb/ref 17592186045417] [17592186570745 #edb/ref 1074 "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{\\sqrt{x}-1}{x-1} & =\\frac{\\sqrt{1}-1}{1-1}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, we need to first simplify the limit. Since the radical is in the numerator, we can multiply the numerator and the denominator by the conjugate of the numerator. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{\\sqrt{x}-1}{x-1} & ={lim}_{x\\to 1}\\frac{(\\sqrt{x}-1)(\\sqrt{x}+1)}{(x-1)(\\sqrt{x}+1)} \\\\  & ={lim}_{x\\to 1}\\frac{{(\\sqrt{x})}^{2}-{1}^{2}}{(x-1)(\\sqrt{x}+1)} \\\\  & ={lim}_{x\\to 1}\\frac{x-1}{(x-1)(\\sqrt{x}+1)} \\\\  & ={lim}_{x\\to 1}\\frac{\\cancel{x-1}}{\\cancel{(x-1)}(\\sqrt{x}+1)} \\\\  & ={lim}_{x\\to 1}\\frac{1}{\\sqrt{x}+1} \\\\  & =\\frac{1}{\\sqrt{1}+1} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$" #edb/ref 17592186045417]}
