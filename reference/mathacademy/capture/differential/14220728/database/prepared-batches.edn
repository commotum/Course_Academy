er-field/id #uuid "81864079-1883-5b8b-8d59-ef9b83084c06" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f0c538f5-e615-5347-ac75-743588bef9e4" :answer-field/choices ["answer-617e9b74-7b40-5151-b5f7-d2c38f23b567" "answer-cf529f56-e92e-5984-9cc7-844c47ce8fe9" "answer-c6039c55-9dd5-533f-aad5-b746c73a3126" "answer-db817b06-48e6-5db7-99e3-d3b7d92b252b" "answer-f0c538f5-e615-5347-ac75-743588bef9e4"] :db/ensure [:answer-field/validate]} {:db/id "answer-617e9b74-7b40-5151-b5f7-d2c38f23b567" :answer/id #uuid "617e9b74-7b40-5151-b5f7-d2c38f23b567" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-cf529f56-e92e-5984-9cc7-844c47ce8fe9" :answer/id #uuid "cf529f56-e92e-5984-9cc7-844c47ce8fe9" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 & 4 & 6 \\\\ 2 & 2 & 0 \\\\ 4 & 0 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-c6039c55-9dd5-533f-aad5-b746c73a3126" :answer/id #uuid "c6039c55-9dd5-533f-aad5-b746c73a3126" :answer/type :answer.type/math :answer/value "[\\begin{aligned}8 \\\\ 0 \\\\ 4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-db817b06-48e6-5db7-99e3-d3b7d92b252b" :answer/id #uuid "db817b06-48e6-5db7-99e3-d3b7d92b252b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}8 \\\\ 2 \\\\ 4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-f0c538f5-e615-5347-ac75-743588bef9e4" :answer/id #uuid "f0c538f5-e615-5347-ac75-743588bef9e4" :answer/type :answer.type/math :answer/value "[\\begin{aligned}8 \\\\ 4 \\\\ 6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-45fa10fd-570c-5dfa-b523-d7d0d1d7035b" :question/id #uuid "45fa10fd-570c-5dfa-b523-d7d0d1d7035b" :question/math-academy-id "q-265769" :question/problem "Compute the gradient of the function $f:{R}^{3}\\to R$ defined by \n\n$$\nf(x)={x}^{T}[\\begin{aligned}0 & 0 & -1 \\\\ 0 & 1 & 0 \\\\ -1 & 0 & 0\\end{aligned}]x\n$$\n\n with respect to $x$ at $x=[\\begin{aligned}1 \\\\ 1 \\\\ -1\\end{aligned}].$" :question/worked-solution "Writing $A=[\\begin{aligned}0 & 0 & -1 \\\\ 0 & 1 & 0 \\\\ -1 & 0 & 0\\end{aligned}]$, we have\n\n$$\nf(x)={x}^{T}Ax.\n$$\n\nFor a symmetric matrix $A$, the gradient of the function $f(x)={x}^{T}Ax$ with respect to $x\\in {R}^{n}$ is\n\n$$\n{∇}_{x}f(x)=2Ax.\n$$\n\nTherefore, since $A$ is symmetric, we get\n\n$$\n{∇}_{x}f(x)=2[\\begin{aligned}0 & 0 & -1 \\\\ 0 & 1 & 0 \\\\ -1 & 0 & 0\\end{aligned}][\\begin{aligned}1 \\\\ 1 \\\\ -1\\end{aligned}]=[\\begin{aligned}2 \\\\ 2 \\\\ -2\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c117a905-5939-59e0-9a30-20c1c80001bb"] :db/ensure [:question/validate]} {:db/id "answer-field-c117a905-5939-59e0-9a30-20c1c80001bb" :answer-field/id #uuid "c117a905-5939-59e0-9a30-20c1c80001bb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c32739f0-0d80-5ef2-8e02-dfabb53b4363" :answer-field/choices ["answer-7b865f86-0d16-5302-9cc6-a10c9f8f37ab" "answer-ecefcf4c-8447-5494-8e2d-cad863dd1b8c" "answer-d42e932d-9ed9-55f9-b7a7-ebf31d9b817a" "answer-3f851010-ea30-50ca-aace-f98e8eb2ec46" "answer-c32739f0-0d80-5ef2-8e02-dfabb53b4363"] :db/ensure [:answer-field/validate]} {:db/id "answer-7b865f86-0d16-5302-9cc6-a10c9f8f37ab" :answer/id #uuid "7b865f86-0d16-5302-9cc6-a10c9f8f37ab" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-ecefcf4c-8447-5494-8e2d-cad863dd1b8c" :answer/id #uuid "ecefcf4c-8447-5494-8e2d-cad863dd1b8c" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 \\\\ 1 \\\\ -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-d42e932d-9ed9-55f9-b7a7-ebf31d9b817a" :answer/id #uuid "d42e932d-9ed9-55f9-b7a7-ebf31d9b817a" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 \\\\ 2 \\\\ -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-3f851010-ea30-50ca-aace-f98e8eb2ec46" :answer/id #uuid "3f851010-ea30-50ca-aace-f98e8eb2ec46" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ 1 \\\\ -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-c32739f0-0d80-5ef2-8e02-dfabb53b4363" :answer/id #uuid "c32739f0-0d80-5ef2-8e02-dfabb53b4363" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 \\\\ 2 \\\\ -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-fd553fc9-eb2f-5541-8477-0b92e94ae292" :question/id #uuid "fd553fc9-eb2f-5541-8477-0b92e94ae292" :question/math-academy-id "q-265768" :question/problem "Compute the gradient of the function $f:{R}^{3}\\to R$ defined by \n\n$$\nf(x)={x}^{T}[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]x\n$$\n\n with respect to $x$ at $x=[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}].$" :question/worked-solution "Writing $A=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]$, we have\n\n$$\nf(x)={x}^{T}Ax.\n$$\n\nFor a symmetric matrix $A$, the gradient of the function $f(x)={x}^{T}Ax$ with respect to $x\\in {R}^{n}$ is\n\n$$\n{∇}_{x}f(x)=2Ax.\n$$\n\nTherefore, since $A$ is symmetric, we get\n\n$$\n{∇}_{x}f(x)=2[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]=[\\begin{aligned}2 \\\\ 2 \\\\ 0\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-4aaed9c4-a4e0-553f-a135-f824dfa18834"] :db/ensure [:question/validate]} {:db/id "answer-field-4aaed9c4-a4e0-553f-a135-f824dfa18834" :answer-field/id #uuid "4aaed9c4-a4e0-553f-a135-f824dfa18834" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-dfedd0c5-ba43-5a1b-9ed6-99bb599b9592" :answer-field/choices ["answer-975432fd-8be5-5dac-b75c-323b7ff0169a" "answer-addd9a17-be40-5bcb-8f55-9c0685e9ead1" "answer-5e8fe610-97bc-5ec7-b3c3-3a9ca69db85d" "answer-dfedd0c5-ba43-5a1b-9ed6-99bb599b9592" "answer-48b8d3bd-6a11-58e6-8539-d23621262558"] :db/ensure [:answer-field/validate]} {:db/id "answer-975432fd-8be5-5dac-b75c-323b7ff0169a" :answer/id #uuid "975432fd-8be5-5dac-b75c-323b7ff0169a" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-addd9a17-be40-5bcb-8f55-9c0685e9ead1" :answer/id #uuid "addd9a17-be40-5bcb-8f55-9c0685e9ead1" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ 1 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-5e8fe610-97bc-5ec7-b3c3-3a9ca69db85d" :answer/id #uuid "5e8fe610-97bc-5ec7-b3c3-3a9ca69db85d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-dfedd0c5-ba43-5a1b-9ed6-99bb599b9592" :answer/id #uuid "dfedd0c5-ba43-5a1b-9ed6-99bb599b9592" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 \\\\ 2 \\\\ 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-48b8d3bd-6a11-58e6-8539-d23621262558" :answer/id #uuid "48b8d3bd-6a11-58e6-8539-d23621262558" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 \\\\ 2 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-6620062e-023f-5c7d-9835-fb1b352d0fc1" :question/id #uuid "6620062e-023f-5c7d-9835-fb1b352d0fc1" :question/math-academy-id "q-276041" :question/problem "Compute the gradient of the function $f:{R}^{2}\\to R$ defined by\n\n$$\nf(x)={x}^{T}[\\begin{aligned}-2 & 2 \\\\ 1 & -2\\end{aligned}]x\n$$\n\nwith respect to $x$ at  $x={[\\begin{aligned}1 & -1\\end{aligned}]}^{T}.$\n\n<table cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"70px\" rowspan=\"3\" width=\"30px\">$\\,{∇}_{x}f=\\,\\,$</td>\n<td align=\"center\" height=\"35px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Defining the matrix $A$ as\n\n$$\nA=[\\begin{aligned}-2 & 2 \\\\ 1 & -2\\end{aligned}],\n$$\n\nwe have $f(x)={x}^{T}Ax.$\n\nSince $A$ is not symmetric, we use the more general formula for the gradient of a quadratic function:\n\n$$\n{∇}_{x}f(x)=({A}^{T}+A)x\n$$\n\nFirst, we compute\n\n$$\n{A}^{T}=[\\begin{aligned}-2 & 1 \\\\ 2 & -2\\end{aligned}],\n$$\n\nwhich gives\n\n$$\n\\begin{aligned}{A}^{T}+A & =[\\begin{aligned}-2 & 1 \\\\ 2 & -2\\end{aligned}]+[\\begin{aligned}-2 & 2 \\\\ 1 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}-4 & 3 \\\\ 3 & -4\\end{aligned}].\\end{aligned}\n$$\n\nNow, compute the gradient at $x=[\\begin{aligned}1 \\\\ -1\\end{aligned}]:$\n\n$$\n\\begin{aligned}{∇}_{x}f(x) & =({A}^{T}+A)x \\\\  & =[\\begin{aligned}-4 & 3 \\\\ 3 & -4\\end{aligned}][\\begin{aligned}1 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}-4-3 \\\\ 3+4\\end{aligned}] \\\\  & =[\\begin{aligned}-7 \\\\ 7\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-3996e568-037c-55af-9d58-338cfb32e23d" "answer-field-32739e0b-ce49-5335-90d2-32e863e2de3f"] :db/ensure [:question/validate]} {:db/id "answer-field-3996e568-037c-55af-9d58-338cfb32e23d" :answer-field/id #uuid "3996e568-037c-55af-9d58-338cfb32e23d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-39c82852-558e-54b0-9642-2d3f9d763221" :answer-field/choices ["answer-39c82852-558e-54b0-9642-2d3f9d763221"] :db/ensure [:answer-field/validate]} {:db/id "answer-39c82852-558e-54b0-9642-2d3f9d763221" :answer/id #uuid "39c82852-558e-54b0-9642-2d3f9d763221" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id "answer-field-32739e0b-ce49-5335-90d2-32e863e2de3f" :answer-field/id #uuid "32739e0b-ce49-5335-90d2-32e863e2de3f" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a2f41369-88fc-57d9-9f6c-32363ff7bcbc" :answer-field/choices ["answer-a2f41369-88fc-57d9-9f6c-32363ff7bcbc"] :db/ensure [:answer-field/validate]} {:db/id "answer-a2f41369-88fc-57d9-9f6c-32363ff7bcbc" :answer/id #uuid "a2f41369-88fc-57d9-9f6c-32363ff7bcbc" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "question-a1a89719-12d3-55da-8498-af0dfd930411" :question/id #uuid "a1a89719-12d3-55da-8498-af0dfd930411" :question/math-academy-id "q-276045" :question/problem "Compute the gradient of the function $f:{R}^{2}\\to R$ defined by\n\n$$\nf(x)={x}^{T}[\\begin{aligned}3 & -3 \\\\ -1 & 1\\end{aligned}]x\n$$\n\nwith respect to $x$ at  $x={[\\begin{aligned}1 & 2\\end{aligned}]}^{T}.$\n\n<table cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"70px\" rowspan=\"3\" width=\"30px\">$\\,{∇}_{x}f=\\,\\,$</td>\n<td align=\"center\" height=\"35px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Defining the matrix $A$ as\n\n$$\nA=[\\begin{aligned}3 & -3 \\\\ -1 & 1\\end{aligned}],\n$$\n\nwe have $f(x)={x}^{T}Ax.$\n\nSince $A$ is not symmetric, we use the more general formula for the gradient of a quadratic function:\n\n$$\n{∇}_{x}f(x)=({A}^{T}+A)x\n$$\n\nFirst, we compute\n\n$$\n{A}^{T}=[\\begin{aligned}3 & -1 \\\\ -3 & 1\\end{aligned}],\n$$\n\nwhich gives\n\n$$\n\\begin{aligned}{A}^{T}+A & =[\\begin{aligned}3 & -1 \\\\ -3 & 1\\end{aligned}]+[\\begin{aligned}3 & -3 \\\\ -1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}6 & -4 \\\\ -4 & 2\\end{aligned}].\\end{aligned}\n$$\n\nNow, compute the gradient at $x=[\\begin{aligned}1 \\\\ 2\\end{aligned}]:$\n\n$$\n\\begin{aligned}{∇}_{x}f(x) & =({A}^{T}+A)x \\\\  & =[\\begin{aligned}6 & -4 \\\\ -4 & 2\\end{aligned}][\\begin{aligned}1 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}6-8 \\\\ -4+4\\end{aligned}] \\\\  & =[\\begin{aligned}-2 \\\\ 0\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-5e2ac6c8-308e-5ccb-b6d7-b77764401e1c" "answer-field-6a3d4772-d0cb-5d4d-8e1f-b23b20b49b43"] :db/ensure [:question/validate]} {:db/id "answer-field-5e2ac6c8-308e-5ccb-b6d7-b77764401e1c" :answer-field/id #uuid "5e2ac6c8-308e-5ccb-b6d7-b77764401e1c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-227e2fbf-1d08-52e2-8bba-7c210918adda" :answer-field/choices ["answer-227e2fbf-1d08-52e2-8bba-7c210918adda"] :db/ensure [:answer-field/validate]} {:db/id "answer-227e2fbf-1d08-52e2-8bba-7c210918adda" :answer/id #uuid "227e2fbf-1d08-52e2-8bba-7c210918adda" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-field-6a3d4772-d0cb-5d4d-8e1f-b23b20b49b43" :answer-field/id #uuid "6a3d4772-d0cb-5d4d-8e1f-b23b20b49b43" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a9a795b8-272f-565d-b750-ab45ec83143c" :answer-field/choices ["answer-a9a795b8-272f-565d-b750-ab45ec83143c"] :db/ensure [:answer-field/validate]} {:db/id "answer-a9a795b8-272f-565d-b750-ab45ec83143c" :answer/id #uuid "a9a795b8-272f-565d-b750-ab45ec83143c" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "question-4ab946d8-2af3-5f4a-a52a-5bbd914240e1" :question/id #uuid "4ab946d8-2af3-5f4a-a52a-5bbd914240e1" :question/math-academy-id "q-276047" :question/problem "Compute the gradient of the function $f:{R}^{3}\\to R$ defined by\n\n$$\nf(x)={x}^{T}[\\begin{aligned}-1 & 1 & 0 \\\\ 0 & 1 & -1 \\\\ 1 & -1 & 1\\end{aligned}]x\n$$\n\nwith respect to $x$ at  $x={[\\begin{aligned}1 & 1 & 1\\end{aligned}]}^{T}.$\n\n<table cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"70px\" rowspan=\"3\" width=\"30px\">$\\,{∇}_{x}f=\\,\\,$</td>\n<td align=\"center\" height=\"35px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Defining the matrix $A$ as\n\n$$\nA=[\\begin{aligned}-1 & 1 & 0 \\\\ 0 & 1 & -1 \\\\ 1 & -1 & 1\\end{aligned}],\n$$\n\nwe have $f(x)={x}^{T}Ax.$\n\nSince $A$ is not symmetric, we use the more general formula for the gradient of a quadratic function:\n\n$$\n{∇}_{x}f(x)=({A}^{T}+A)x\n$$\n\nFirst, we compute\n\n$$\n{A}^{T}=[\\begin{aligned}-1 & 0 & 1 \\\\ 1 & 1 & -1 \\\\ 0 & -1 & 1\\end{aligned}],\n$$\n\nwhich gives\n\n$$\n\\begin{aligned}{A}^{T}+A & =[\\begin{aligned}-1 & 0 & 1 \\\\ 1 & 1 & -1 \\\\ 0 & -1 & 1\\end{aligned}]+[\\begin{aligned}-1 & 1 & 0 \\\\ 0 & 1 & -1 \\\\ 1 & -1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & 1 & 1 \\\\ 1 & 2 & -2 \\\\ 1 & -2 & 2\\end{aligned}].\\end{aligned}\n$$\n\nNow, compute the gradient at $x=[\\begin{aligned}1 \\\\ 1 \\\\ 1\\end{aligned}]:$\n\n$$\n\\begin{aligned}{∇}_{x}f(x) & =({A}^{T}+A)x \\\\  & =[\\begin{aligned}-2 & 1 & 1 \\\\ 1 & 2 & -2 \\\\ 1 & -2 & 2\\end{aligned}][\\begin{aligned}1 \\\\ 1 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}-2+1+1 \\\\ 1+2-2 \\\\ 1-2+2\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 1 \\\\ 1\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9b4eb1e8-7e8f-56fe-9cc5-7c0534c2be46" "answer-field-902e36f6-38d1-549f-a1dc-9a28e448d787" "answer-field-e8327b3c-174b-5286-b01b-5ae9db175fe7"] :db/ensure [:question/validate]} {:db/id "answer-field-9b4eb1e8-7e8f-56fe-9cc5-7c0534c