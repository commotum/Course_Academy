592186045417] [17592186532603 #edb/ref 1075 #edb/ref 17592186532308 #edb/ref 17592186045417] [17592186532603 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186532603 #edb/ref 1077 "field-3" #edb/ref 17592186045417] [17592186532603 #edb/ref 1078 #edb/ref 17592186532308 #edb/ref 17592186045417] [17592186532603 #edb/ref 1079 #uuid "e8327b3c-174b-5286-b01b-5ae9db175fe7" #edb/ref 17592186045417] [17592186532617 #edb/ref 1075 #edb/ref 17592186532141 #edb/ref 17592186045417] [17592186532617 #edb/ref 1075 #edb/ref 17592186532208 #edb/ref 17592186045417] [17592186532617 #edb/ref 1075 #edb/ref 17592186532243 #edb/ref 17592186045417] [17592186532617 #edb/ref 1075 #edb/ref 17592186532325 #edb/ref 17592186045417] [17592186532617 #edb/ref 1075 #edb/ref 17592186532355 #edb/ref 17592186045417] [17592186532617 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186532617 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186532617 #edb/ref 1078 #edb/ref 17592186532141 #edb/ref 17592186045417] [17592186532617 #edb/ref 1079 #uuid "fd1b93f4-6b48-5f90-af0f-e979b93d3583" #edb/ref 17592186045417] [17592186532646 #edb/ref 1068 #edb/ref 17592186532551 #edb/ref 17592186045417] [17592186532646 #edb/ref 1069 "q-269470" #edb/ref 17592186045417] [17592186532646 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186532646 #edb/ref 1071 "Consider the function $L:{R}^{3}\\to R$ defined by $L(x)=(Ax-2b)^{T}(Ax-2b)$ where \n\n$$\nA=[\\begin{aligned}1 & 0 & 3 \\\\ 0 & 1 & 0\\end{aligned}],\\,b=[\\begin{aligned}2 \\\\ 3\\end{aligned}].\n$$\n\nWhat is ${∇}_{x}L(x)$ at $x=[\\begin{aligned}3 \\\\ 1 \\\\ 2\\end{aligned}]?$" #edb/ref 17592186045417] [17592186532646 #edb/ref 1072 #uuid "411aabaa-bd7a-5b74-b0d5-19adca16cb89" #edb/ref 17592186045417] [17592186532646 #edb/ref 1074 "We can solve this problem by applying the chain rule for gradients.\n\nLet $y=Ax-2b.$ Then, $L(x)={y}^{T}y,$ and\n\n$$\n{∇}_{x}L={(\\frac{\\text{d}L}{\\text{d}x})}^{T}={(\\frac{\\text{d}y}{\\text{d}x})}^{T}\\cdot {(\\frac{\\text{d}L}{\\text{d}y})}^{T}.\n$$\n\nNow, since \n\n$$\n\\frac{\\text{d}}{\\text{d}y}({y}^{T}y)=2{y}^{T}\\,\\text{and}\\,\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}}{\\text{d}x}(Ax-2b)=A,\n$$\n\nwe have that \n\n$$\n\\begin{aligned}{∇}_{x}L & ={(\\frac{\\text{d}y}{\\text{d}x})}^{T}\\cdot {(\\frac{\\text{d}L}{\\text{d}y})}^{T} \\\\  & ={A}^{T}\\cdot 2y.\\end{aligned}\n$$\n\nEvaluating at $x=[\\begin{aligned}3 \\\\ 1 \\\\ 2\\end{aligned}]$, we get\n\n$$\n\\begin{aligned}{∇}_{x}L & ={A}^{T}\\cdot 2y \\\\  & =2\\cdot {A}^{T}(Ax-2b) \\\\  & =2\\cdot {[\\begin{aligned}1 & 0 & 3 \\\\ 0 & 1 & 0\\end{aligned}]}^{T}([\\begin{aligned}1 & 0 & 3 \\\\ 0 & 1 & 0\\end{aligned}]\\cdot [\\begin{aligned}3 \\\\ 1 \\\\ 2\\end{aligned}]-2[\\begin{aligned}2 \\\\ 3\\end{aligned}]) \\\\  & =2\\cdot [\\begin{aligned}1 & 0 \\\\ 0 & 1 \\\\ 3 & 0\\end{aligned}]([\\begin{aligned}9 \\\\ 1\\end{aligned}]-[\\begin{aligned}4 \\\\ 6\\end{aligned}]) \\\\  & =[\\begin{aligned}2 & 0 \\\\ 0 & 2 \\\\ 6 & 0\\end{aligned}][\\begin{aligned}5 \\\\ -5\\end{aligned}] \\\\  & =[\\begin{aligned}10 \\\\ -10 \\\\ 30\\end{aligned}].\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186532648 #edb/ref 1068 #edb/ref 17592186532557 #edb/ref 17592186045417] [17592186532648 #edb/ref 1069 "q-269549" #edb/ref 17592186045417] [17592186532648 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186532648 #edb/ref 1071 "Consider the function $L:{R}^{2}\\to R$ defined by $L(x)=(2Ax+b)^{T}(2Ax+b)$ where \n\n$$\nA=[\\begin{aligned}0 & 1 \\\\ 1 & 2 \\\\ 2 & 0\\end{aligned}],\\,b=[\\begin{aligned}-1 \\\\ 2 \\\\ 0\\end{aligned}].\n$$\n\nWhat is ${∇}_{x}L(x)$ at $x=[\\begin{aligned}0 \\\\ -2\\end{aligned}]?$" #edb/ref 17592186045417] [17592186532648 #edb/ref 1072 #uuid "41cc5d66-bf23-517e-b32a-3cd7a74b1b32" #edb/ref 17592186045417] [17592186532648 #edb/ref 1074 "We can solve this problem by applying the chain rule for gradients.\n\nLet $y=2Ax+b.$ Then, $L(x)={y}^{T}y,$ and\n\n$$\n{∇}_{x}L={(\\frac{\\text{d}L}{\\text{d}x})}^{T}={(\\frac{\\text{d}y}{\\text{d}x})}^{T}\\cdot {(\\frac{\\text{d}L}{\\text{d}y})}^{T}.\n$$\n\nNow, since \n\n$$\n\\frac{\\text{d}}{\\text{d}y}({y}^{T}y)=2{y}^{T}\\,\\text{and}\\,\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}}{\\text{d}x}(2Ax+b)=2A,\n$$\n\nwe have that \n\n$$\n\\begin{aligned}{∇}_{x}L & ={(\\frac{\\text{d}y}{\\text{d}x})}^{T}\\cdot {(\\frac{\\text{d}L}{\\text{d}y})}^{T} \\\\  & =(2A)^{T}\\cdot 2y.\\end{aligned}\n$$\n\nEvaluating at $x=[\\begin{aligned}0 \\\\ -2\\end{aligned}]$, we get\n\n$$\n\\begin{aligned}{∇}_{x}L & =(2A)^{T}\\cdot 2y \\\\  & =4\\cdot {A}^{T}(2Ax+b) \\\\  & =4\\cdot {[\\begin{aligned}0 & 1 \\\\ 1 & 2 \\\\ 2 & 0\\end{aligned}]}^{T}(2\\cdot [\\begin{aligned}0 & 1 \\\\ 1 & 2 \\\\ 2 & 0\\end{aligned}]\\cdot [\\begin{aligned}0 \\\\ -2\\end{aligned}]+[\\begin{aligned}-1 \\\\ 2 \\\\ 0\\end{aligned}]) \\\\  & =4\\cdot [\\begin{aligned}0 & 1 & 2 \\\\ 1 & 2 & 0\\end{aligned}](2\\cdot [\\begin{aligned}-2 \\\\ -4 \\\\ 0\\end{aligned}]+[\\begin{aligned}-1 \\\\ 2 \\\\ 0\\end{aligned}]) \\\\  & =[\\begin{aligned}0 & 4 & 8 \\\\ 4 & 8 & 0\\end{aligned}]\\cdot [\\begin{aligned}-5 \\\\ -6 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}-24 \\\\ -68\\end{aligned}].\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186532650 #edb/ref 1068 #edb/ref 17592186532584 #edb/ref 17592186045417] [17592186532650 #edb/ref 1069 "q-265769" #edb/ref 17592186045417] [17592186532650 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186532650 #edb/ref 1071 "Compute the gradient of the function $f:{R}^{3}\\to R$ defined by \n\n$$\nf(x)={x}^{T}[\\begin{aligned}0 & 0 & -1 \\\\ 0 & 1 & 0 \\\\ -1 & 0 & 0\\end{aligned}]x\n$$\n\n with respect to $x$ at $x=[\\begin{aligned}1 \\\\ 1 \\\\ -1\\end{aligned}].$" #edb/ref 17592186045417] [17592186532650 #edb/ref 1072 #uuid "45fa10fd-570c-5dfa-b523-d7d0d1d7035b" #edb/ref 17592186045417] [17592186532650 #edb/ref 1074 "Writing $A=[\\begin{aligned}0 & 0 & -1 \\\\ 0 & 1 & 0 \\\\ -1 & 0 & 0\\end{aligned}]$, we have\n\n$$\nf(x)={x}^{T}Ax.\n$$\n\nFor a symmetric matrix $A$, the gradient of the function $f(x)={x}^{T}Ax$ with respect to $x\\in {R}^{n}$ is\n\n$$\n{∇}_{x}f(x)=2Ax.\n$$\n\nTherefore, since $A$ is symmetric, we get\n\n$$\n{∇}_{x}f(x)=2[\\begin{aligned}0 & 0 & -1 \\\\ 0 & 1 & 0 \\\\ -1 & 0 & 0\\end{aligned}][\\begin{aligned}1 \\\\ 1 \\\\ -1\\end{aligned}]=[\\begin{aligned}2 \\\\ 2 \\\\ -2\\end{aligned}].\n$$" #edb/ref 17592186045417] [17592186532652 #edb/ref 1068 #edb/ref 17592186532560 #edb/ref 17592186045417] [17592186532652 #edb/ref 1068 #edb/ref 17592186532565 #edb/ref 17592186045417] [17592186532652 #edb/ref 1068 #edb/ref 17592186532603 #edb/ref 17592186045417] [17592186532652 #edb/ref 1069 "q-276047" #edb/ref 17592186045417] [17592186532652 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186532652 #edb/ref 1071 "Compute the gradient of the function $f:{R}^{3}\\to R$ defined by\n\n$$\nf(x)={x}^{T}[\\begin{aligned}-1 & 1 & 0 \\\\ 0 & 1 & -1 \\\\ 1 & -1 & 1\\end{aligned}]x\n$$\n\nwith respect to $x$ at  $x={[\\begin{aligned}1 & 1 & 1\\end{aligned}]}^{T}.$\n\n<table cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"70px\" rowspan=\"3\" width=\"30px\">$\\,{∇}_{x}f=\\,\\,$</td>\n<td align=\"center\" height=\"35px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" #edb/ref 17592186045417] [17592186532652 #edb/ref 1072 #uuid "4ab946d8-2af3-5f4a-a52a-5bbd914240e1" #edb/ref 17592186045417] [17592186532652 #edb/ref 1074 "Defining the matrix $A$ as\n\n$$\nA=[\\begin{aligned}-1 & 1 & 0 \\\\ 0 & 1 & -1 \\\\ 1 & -1 & 1\\end{aligned}],\n$$\n\nwe have $f(x)={x}^{T}Ax.$\n\nSince $A$ is not symmetric, we use the more general formula for the gradient of a quadratic function:\n\n$$\n{∇}_{x}f(x)=({A}^{T}+A)x\n$$\n\nFirst, we compute\n\n$$\n{A}^{T}=[\\begin{aligned}-1 & 0 & 1 \\\\ 1 & 1 & -1 \\\\ 0 & -1 & 1\\end{aligned}],\n$$\n\nwhich gives\n\n$$\n\\begin{aligned}{A}^{T}+A & =[\\begin{aligned}-1 & 0 & 1 \\\\ 1 & 1 & -1 \\\\ 0 & -1 & 1\\end{aligned}]+[\\begin{aligned}-1 & 1 & 0 \\\\ 0 & 1 & -1 \\\\ 1 & -1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & 1 & 1 \\\\ 1 & 2 & -2 \\\\ 1 & -2 & 2\\end{aligned}].\\end{aligned}\n$$\n\nNow, compute the gradient at $x=[\\begin{aligned}1 \\\\ 1 \\\\ 1\\end{aligned}]:$\n\n$$\n\\begin{aligned}{∇}_{x}f(x) & =({A}^{T}+A)x \\\\  & =[\\begin{aligned}-2 & 1 & 1 \\\\ 1 & 2 & -2 \\\\ 1 & -2 & 2\\end{aligned}][\\begin{aligned}1 \\\\ 1 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}-2+1+1 \\\\ 1+2-2 \\\\ 1-2+2\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 1 \\\\ 1\\end{aligned}]\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186532660 #edb/ref 1068 #edb/ref 17592186532516 #edb/ref 17592186045417] [17592186532660 #edb/ref 1068 #edb/ref 17592186532520 #edb/ref 17592186045417] [17592186532660 #edb/ref 1069 "q-276041" #edb/ref 17592186045417] [17592186532660 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186532660 #edb/ref 1071 "Compute the gradient of the function $f:{R}^{2}\\to R$ defined by\n\n$$\nf(x)={x}^{T}[\\begin{aligned}-2 & 2 \\\\ 1 & -2\\end{aligned}]x\n$$\n\nwith respect to $x$ at  $x={[\\begin{aligned}1 & -1\\end{aligned}]}^{T}.$\n\n<table cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"70px\" rowspan=\"3\" width=\"30px\">$\\,{∇}_{x}f=\\,\\,$</td>\n<td align=\"center\" height=\"35px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"cent