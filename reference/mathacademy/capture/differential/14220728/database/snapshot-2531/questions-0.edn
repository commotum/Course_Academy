matrix}8 & 32 & 0\\end{bmatrix}" :db/id #edb/ref 17592186205339} {:answer/id #uuid "17b56c8a-4ac6-5688-a967-d4364df321a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}8 \\\\ 32 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186205340}] :answer-field/id #uuid "1ac8dc5d-b24d-5234-9c6b-196229d7d8cd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186205335}] :question/id #uuid "aa5725de-7db0-574b-a1ac-d3be9e0fac87" :question/math-academy-id "q-269389" :question/problem "Consider the function $L: R^{3} → R$ defined by $L(x) = 2(Ax - b)^{T}(Ax - b)$ where\n$A = \\begin{bmatrix}2 & 0 & 3 \\\\ 1 & 4 & 0\\end{bmatrix}, b = \\begin{bmatrix}5 \\\\ 7\\end{bmatrix}$.\nWhat is $∇_{x}L(x)$ at $x = \\begin{bmatrix}1 \\\\ 2 \\\\ 1\\end{bmatrix}$?"}] [{:db/id #edb/ref 17592186208957 :knowledge-point/_questions [{:db/id #edb/ref 17592186208847 :knowledge-point/id #uuid "2198cf08-3a99-5e5d-80af-bbe722b51647" :knowledge-point/title "Computing Gradient of a Quadratic Function"}] :question/answer-fields [{:answer-field/id #uuid "82d0d7d4-31f3-54e7-86b5-9d1ef86a79fa" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186205485} {:answer-field/id #uuid "ca8ad3b1-ab23-5b80-9e34-bf9e8ced4f6b" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186205486}] :question/id #uuid "d373e229-cbc5-5c4a-acf6-948959b19522" :question/math-academy-id "q-276039" :question/problem "Compute the gradient of the function $f: R^{2} → R$ defined by\n$f(x) = x^{T}\\begin{bmatrix}1 & 3 \\\\ 0 & -1\\end{bmatrix}x$\nwith respect to $x$ at $x = \\begin{bmatrix}1 & 0\\end{bmatrix}^{T}$.\n\n| $∇_{x}f =$ |  | {{field-1}} |  |\n| --- | ---: | ---: | ---: |\n|  | {{field-2}} |  |  |"}]}
