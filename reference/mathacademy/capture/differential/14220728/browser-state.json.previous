\"><mn>2</mn></mrow></mpadded></mstyle></mtd></mtr><mtr><mtd><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mrow data-mjx-texclass=\"ORD\"><mn>3</mn></mrow></mpadded></mstyle></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
