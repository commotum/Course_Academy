59a6" :answer-field/choices "answer-01f1e83f-e91e-5090-bc9c-c0d8a5b24dec"] ["question-30a2be53-ad1e-54e7-8cc2-2924faaf8e17" :question/answer-fields "answer-field-2d0df2e4-d380-5912-bac6-465760a259a6"] [17592186129271 :knowledge-point/questions "question-30a2be53-ad1e-54e7-8cc2-2924faaf8e17"] ["question-db419926-6089-5205-b99f-0938320c28f8" :question/id #uuid "db419926-6089-5205-b99f-0938320c28f8"] ["question-db419926-6089-5205-b99f-0938320c28f8" :question/math-academy-id "q-161799"] ["question-db419926-6089-5205-b99f-0938320c28f8" :question/problem "Find the Jacobian determinant of the transformation $T,$ defined as\n\n$$\nT:[\\begin{aligned}u \\\\ v \\\\ w\\end{aligned}]⟶[\\begin{aligned}u+v\\operatorname{cos}⁡\\theta +w\\operatorname{sin}⁡\\theta  \\\\ 3v \\\\ u\\operatorname{sin}⁡\\theta +w\\end{aligned}].\n$$\n\nYou may assume that $\\theta $ is a fixed constant."] ["question-db419926-6089-5205-b99f-0938320c28f8" :question/worked-solution "For a transformation \n\n$$\nT:[\\begin{aligned}u \\\\ v \\\\ w\\end{aligned}]\\to [\\begin{aligned}x(u,v,w) \\\\ y(u,v,w) \\\\ z(u,v,w)\\end{aligned}],\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y,z)}{∂(u,v,w)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} & \\frac{∂x}{∂w} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v} & \\frac{∂y}{∂w} \\\\ \\frac{∂z}{∂u} & \\frac{∂z}{∂v} & \\frac{∂z}{∂w}\\end{aligned}|.\\end{aligned}\n$$\n\nHere, we have \n\n$$\nx(u,v,w)=u+v\\operatorname{cos}⁡\\theta +w\\operatorname{sin}⁡\\theta ,\\,y(u,v,w)=3v,\\,z(u,v,w)=u\\operatorname{sin}⁡\\theta +w.\n$$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & =1 & \\,\\frac{∂x}{∂v} & =\\operatorname{cos}⁡\\theta  & \\,\\frac{∂x}{∂w} & =\\operatorname{sin}⁡\\theta  \\\\ \\frac{∂y}{∂u} & =0 & \\,\\frac{∂y}{∂v} & =3 & \\,\\frac{∂y}{∂w} & =0 \\\\ \\frac{∂z}{∂u} & =\\operatorname{sin}⁡\\theta  & \\,\\frac{∂z}{∂v} & =0, & \\,\\frac{∂z}{∂w} & =1\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =|\\begin{aligned}1 & \\operatorname{cos}⁡\\theta  & \\operatorname{sin}⁡\\theta  \\\\ 0 & 3 & 0 \\\\ \\operatorname{sin}⁡\\theta  & 0 & 1\\end{aligned}| \\\\  & =3(-1)^{2+2}|\\begin{aligned}1 & \\operatorname{sin}⁡\\theta  \\\\ \\operatorname{sin}⁡\\theta  & 1\\end{aligned}| \\\\  & =3(1-{sin}^{2}⁡\\theta ) \\\\  & =3{cos}^{2}⁡\\theta .\\end{aligned}\n$$"] ["question-db419926-6089-5205-b99f-0938320c28f8" :question/difficulty :question.difficulty/easy] ["answer-field-7d304d66-3b35-5b7a-a10d-e4c98f3bf8ff" :answer-field/id #uuid "7d304d66-3b35-5b7a-a10d-e4c98f3bf8ff"] ["answer-d9ee05e3-c0ef-572d-b71a-0521af7c7c51" :answer/id #uuid "d9ee05e3-c0ef-572d-b71a-0521af7c7c51"] ["answer-d9ee05e3-c0ef-572d-b71a-0521af7c7c51" :answer/type :answer.type/math] ["answer-d9ee05e3-c0ef-572d-b71a-0521af7c7c51" :answer/value "3"] ["answer-e13473ff-e770-5bc2-84cc-d2f5a63a463b" :answer/id #uuid "e13473ff-e770-5bc2-84cc-d2f5a63a463b"] ["answer-e13473ff-e770-5bc2-84cc-d2f5a63a463b" :answer/type :answer.type/math] ["answer-e13473ff-e770-5bc2-84cc-d2f5a63a463b" :answer/value "3\\operatorname{cos}⁡\\theta "] ["answer-65eac0db-4498-5219-a599-16571ff5b0ff" :answer/id #uuid "65eac0db-4498-5219-a599-16571ff5b0ff"] ["answer-65eac0db-4498-5219-a599-16571ff5b0ff" :answer/type :answer.type/math] ["answer-65eac0db-4498-5219-a599-16571ff5b0ff" :answer/value "3{cos}^{2}⁡\\theta "] ["answer-f40d8dc6-4b68-5931-af1a-b12969faf5dd" :answer/id #uuid "f40d8dc6-4b68-5931-af1a-b12969faf5dd"] ["answer-f40d8dc6-4b68-5931-af1a-b12969faf5dd" :answer/type :answer.type/math] ["answer-f40d8dc6-4b68-5931-af1a-b12969faf5dd" :answer/value "3{sin}^{2}⁡\\theta "] ["answer-ec060073-eee0-5eb4-a23b-64f1baba3d7d" :answer/id #uuid "ec060073-eee0-5eb4-a23b-64f1baba3d7d"] ["answer-ec060073-eee0-5eb4-a23b-64f1baba3d7d" :answer/type :answer.type/math] ["answer-ec060073-eee0-5eb4-a23b-64f1baba3d7d" :answer/value "\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta "] ["answer-field-7d304d66-3b35-5b7a-a10d-e4c98f3bf8ff" :answer-field/key "selection"] ["answer-field-7d304d66-3b35-5b7a-a10d-e4c98f3bf8ff" :answer-field/type :answer-field.type/radio] ["answer-field-7d304d66-3b35-5b7a-a10d-e4c98f3bf8ff" :answer-field/correct "answer-65eac0db-4498-5219-a599-16571ff5b0ff"] ["answer-field-7d304d66-3b35-5b7a-a10d-e4c98f3bf8ff" :answer-field/choices "answer-d9ee05e3-c0ef-572d-b71a-0521af7c7c51"] ["answer-field-7d304d66-3b35-5b7a-a10d-e4c98f3bf8ff" :answer-field/choices "answer-e13473ff-e770-5bc2-84cc-d2f5a63a463b"] ["answer-field-7d304d66-3b35-5b7a-a10d-e4c98f3bf8ff" :answer-field/choices "answer-65eac0db-4498-5219-a599-16571ff5b0ff"] ["answer-field-7d304d66-3b35-5b7a-a10d-e4c98f3bf8ff" :answer-field/choices "answer-f40d8dc6-4b68-5931-af1a-b12969faf5dd"] ["answer-field-7d304d66-3b35-5b7a-a10d-e4c98f3bf8ff" :answer-field/choices "answer-ec060073-eee0-5eb4-a23b-64f1baba3d7d"] ["question-db419926-6089-5205-b99f-0938320c28f8" :question/answer-fields "answer-field-7d304d66-3b35-5b7a-a10d-e4c98f3bf8ff"] [17592186129271 :knowledge-point/questions "question-db419926-6089-5205-b99f-0938320c28f8"]] "retractions" []}]