#{[{:db/id #edb/ref 17592186265713 :knowledge-point/_questions [{:db/id #edb/ref 17592186124453 :knowledge-point/id #uuid "d5666035-199d-56aa-a6f4-f65a3f847b42" :knowledge-point/title "Calculating Limits of Multivariable Rational Functions by Factoring"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44ad1bd2-8442-5dfe-b6b9-a6a220f4b699" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186263602} {:answer/id #uuid "73354caa-11ab-5a26-90fd-714c92eefd92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186264000} {:answer/id #uuid "a62e5c28-ad0a-52bf-bd5e-b5aca29871b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186264421} {:answer/id #uuid "a7d81618-b514-541a-badf-cb234ce0914d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186264435} {:answer/id #uuid "ab554095-56b3-5440-8583-dc412455d74b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186264471}] :answer-field/correct {:answer/id #uuid "a7d81618-b514-541a-badf-cb234ce0914d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186264435} :answer-field/id #uuid "6f223cdc-4ab9-5d2a-9c8f-fc56257df30b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265436}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8d67ac27-26e1-5580-9eb2-034565720f25" :question/math-academy-id "q-129332" :question/problem "Find ${lim}_{x\\to (-1,1,2)}\\frac{xz+yz}{{x}^{2}-{y}^{2}}.$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0},$ as follows: \n\n$$\n\\begin{aligned}{lim}_{x\\to (-1,1,2)}\\frac{xz+yz}{{x}^{2}-{y}^{2}} & =\\frac{(-1)(2)+1(2)}{(-1)^{2}-{1}^{2}} \\\\  & =\\frac{-2+2}{1-1} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nHowever, we can simplify the limit by canceling common factors in the numerator and denominator:\n\n$$\n\\begin{aligned}{lim}_{x\\to (-1,1,2)}\\frac{xz+yz}{{x}^{2}-{y}^{2}} & ={lim}_{x\\to (-1,1,2)}\\frac{z(x+y)}{(x+y)(x-y)} \\\\  & ={lim}_{x\\to (-1,1,2)}\\frac{z\\cancel{(x+y)}}{\\cancel{(x+y)}(x-y)} \\\\  & ={lim}_{x\\to (-1,1,2)}\\frac{z}{x-y}\\end{aligned}\n$$\n\nNow that the limit has been simplified, we can evaluate it using direct substitution:\n\n$$\n\\begin{aligned}{lim}_{x\\to (-1,1,2)}\\frac{z}{x-y} & =\\frac{2}{-1-1} \\\\  & =\\frac{2}{(-2)} \\\\  & =-1\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $-1.$"}] [{:db/id #edb/ref 17592186265714 :knowledge-point/_questions [{:db/id #edb/ref 17592186124453 :knowledge-point/id #uuid "d5666035-199d-56aa-a6f4-f65a3f847b42" :knowledge-point/title "Calculating Limits of Multivariable Rational Functions by Factoring"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3cd3a569-22f5-58d9-b2f8-184a33be9932" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186263543} {:answer/id #uuid "73948bda-635e-5d60-afcf-95c733c7ad2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186264002} {:answer/id #uuid "ba8ab39b-0d20-5e12-be94-5fb9aa528858" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186264617} {:answer/id #uuid "c4e3ae72-b88f-5f06-b306-aaafce164c0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186264726} {:answer/id #uuid "dc64dec8-2f23-5153-a3b2-2728e3383078" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186264922}] :answer-field/correct {:answer/id #uuid "73948bda-635e-5d60-afcf-95c733c7ad2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186264002} :answer-field/id #uuid "2d1300cc-2bf9-55dc-b250-0c25b95b165f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265326}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "715f6fef-c679-5b35-a9f5-f8ac13307bba" :question/math-academy-id "q-129335" :question/problem "Determine ${lim}_{x\\to (2,2)}\\frac{{x}^{3}-3{x}^{2}y+3x{y}^{2}-{y}^{3}}{{x}^{2}-2xy+{y}^{2}}.$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0},$ as follows: \n\n$$\n\\begin{aligned}{lim}_{x\\to (2,2)}\\frac{{x}^{3}-3{x}^{2}y+3x{y}^{2}-{y}^{3}}{{x}^{2}-2xy+{y}^{2}} & =\\frac{{2}^{3}-3({2}^{2})(2)+3(2)({2}^{2})-{2}^{3}}{{2}^{2}-2(2)(2)+{2}^{2}} \\\\  & =\\frac{8-24+24-8}{4-8+4} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nHowever, we can simplify the limit by canceling common factors in the numerator and denominator:\n\n$$\n\\begin{aligned}{lim}_{x\\to (2,2)}\\frac{{x}^{3}-3{x}^{2}y+3x{y}^{2}-{y}^{3}}{{x}^{2}-2xy+{y}^{2}} & ={lim}_{x\\to (2,2)}\\frac{(x-y)^{3}}{(x-y)^{2}} \\\\  & ={lim}_{x\\to (2,2)}\\frac{(x-y)(x-y)^{2}}{(x-y)^{2}} \\\\  & ={lim}_{x\\to (2,2)}\\frac{(x-y)\\cancel{(x-y)^{2}}}{\\cancel{(x-y)^{2}}} \\\\  & ={lim}_{x\\to (2,2)}(x-y)\\end{aligned}\n$$\n\nNow that the limit has been simplified, we can evaluate it using direct substitution:\n\n$$\n\\begin{aligned}{lim}_{x\\to (2,2)}(x-y) & =2-2=0\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $0.$"}] [{:db/id #edb/ref 17592186265722 :knowledge-point/_questions [{:db/id #edb/ref 17592186124457 :knowledge-point/id #uuid "29610715-333d-5e0c-9328-eec1d45f56ed" :knowledge-point/title "Calculating Limits Along Different Paths for Multivariable Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e982015-e57d-5a0b-a9cf-5d08deab7ed2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448356} {:answer/id #uuid "2459a454-5301-5e77-b21b-b6196bab14e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448357}] :answer-field/correct {:answer/id #uuid "2459a454-5301-5e77-b21b-b6196bab14e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448357} :answer-field/id #uuid "0d95f94d-2076-5218-bb4b-c6ab553eb89a" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449218} {:answer-field/choices [{:answer/id #uuid "8b6df36c-4778-5e0d-8a29-4c2efc4da127" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448358} {:answer/id #uuid "51ef316d-e1c9-5b72-9ff3-7956a1c2c951" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448359}] :answer-field/correct {:answer/id #uuid "8b6df36c-4778-5e0d-8a29-4c2efc4da127" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448358} :answer-field/id #uuid "b396f2c8-dc63-5102-8ab9-0b273481f509" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449219} {:answer-field/choices [{:answer/id #uuid "23411fdc-77e6-57da-b87b-f1f0a95f66cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448360} {:answer/id #uuid "ff37351c-4fe5-5bcc-ab1b-336319013805" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448361}] :answer-field/correct {:answer/id #uuid "ff37351c-4fe5-5bcc-ab1b-336319013805" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448361} :answer-field/id #uuid "f0e78afc-fd6f-5a29-a353-29016479df8c" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449220}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "88abe9a3-7bd6-5ff9-8f3e-e809f8b5b178" :question/math-academy-id "q-129406" :question/problem "Which of the following statements are true regarding the limit given below?\n\n$$\n{lim}_{x\\to (0,0)}\\,\\frac{2xy}{3{y}^{2}-{x}^{2}}\n$$\n\nSelect all that apply.\n\n- **I.** The limit evaluates to $0$ along the path $y=0$\n- **II.** The limit evaluates to $\\frac{2}{3}$ along the path $y=x$\n- **III.** The limit does not exist" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0}:$\n\n$$\n\\begin{aligned}{lim}_{x\\to (0,0)}\\,\\frac{2xy}{3{y}^{2}-{x}^{2}} & =\\frac{2(0)(0)}{3({0}^{2})-{0}^{2}} \\\\  & =\\frac{0}{0-0} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nHowever, the function cannot be simplified by canceling common factors in the numerator and denominator:\n\nWe attempt to evaluate the limit by approaching $(0,0)$ from different paths.\n\n- Statement I is true. Taking $x\\to (0,0)$ along the path $y=0,$ we have\n\n$$\n\\begin{aligned}{lim}_{x\\to (0,0)\\,\\,\\,y=0}\\,\\frac{2xy}{3{y}^{2}-{x}^{2}} & ={lim}_{x\\to 0}\\,\\frac{2x(0)}{3({0}^{2})-{x}^{2}} \\\\  & ={lim}_{x\\to 0}0 \\\\  & =0.\\end{aligned}\n$$\n\n- Statement II is false. Taking $x\\to (0,0)$ along the path $y=x,$ we have\n\n$$\n\\begin{aligned}{lim}_{x\\to (0,0)\\,\\,\\,y=x}\\,\\frac{2xy}{3{y}^{2}-{x}^{2}} & ={lim}_{x\\to 0}\\frac{2x(x)}{3{x}^{2}-{x}^{2}} \\\\  & ={lim}_{x\\to 0}\\frac{2{x}^{2}}{2{x}^{2}} \\\\  & ={lim}_{x\\to 0}1 \\\\  & =1\\end{aligned}\n$$\n\n- Statement III is true. Because the limit evaluates to different results on two different paths, we conclude that the limit does not exist:\n\n$$\n{lim}_{x\\to (0,0)}\\,\\frac{2xy}{3{y}^{2}-{x}^{2}}=\\text{DNE}\n$$"}] [{:db/id #edb/ref 17592186125224 :knowledge-point/_questions [{:db/id #edb/ref 17592186124558 :knowledge-point/id #uuid "7d53554f-6d77-56f9-8950-d8e31a7f4fdb" :knowledge-point/title "Calculating Limits of Multivariable Functions Using Conjugate Multiplication"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "907c8b24-14ed-559c-8b1b-a819efed8b6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186123945} {:answer/id #uuid "96fbb520-5f93-5504-87e0-aa25dea97fc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186123946} {:answer/id #uuid "fb5cbec9-9bb3-5392-a3a0-ea0d2b0b9eee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186123947} {:answer/id #uuid "70fc3b47-ffbe-56d3-b7b9-1921938dd685" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186123948} {:answer/id #uuid "73d82dab-632d-5399-86f9-c24e1e313515" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186123949}] :answer-field/id #uuid "1932e0e7-8c06-5d02-816c-9de59dff87d6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186123944} {:answer-field/choices [{:answer/id #uuid "bbd3afd7-5a69-5bc2-8161-fee77f4632dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186377703} {:answer/id #uuid "f9b0c048-b115-51b0-b2dc-9897de240e0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186377704} {:answer/id #uuid "23b23618-823a-5db2-9ef3-35b32a0c9e44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186377705} {:answer/id #uuid "d8ed3530-f0fa-5d8c-bdb6-2cf6002bca16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186377706} {:answer/id #uuid "bcab442c-986f-5282-b630-dfaf3c36ca2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186377707}] :answer-field/correct {:answer/id #uuid "23b23618-823a-5db2-9ef3-35b32a0c9e44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186377705} :answer-field/id #uuid "fc72be4b-ba1c-5d2a-b23f-ef19af81df35" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186377702}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dfaf27b0-dc8b-5691-99ed-4010ac8fdea0" :question/math-academy-id "q-74954" :question/problem "${lim}_{x\\to (4,4)}\\frac{x-y}{\\sqrt{x}-\\sqrt{y}}=$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0},$ as follows: \n\n$$\n{lim}_{x\\to (4,4)}\\frac{x-y}{\\sqrt{x}-\\sqrt{y}}=\\frac{4-4}{\\sqrt{4}-\\sqrt{4}}=\\frac{0}{0}\n$$\n\nHowever, we can simplify the limit by first multiplying the numerator and denominator by the conjugate of the denominator:\n\n$$\n\\begin{aligned}{lim}_{x\\to (4,4)}\\frac{x-y}{\\sqrt{x}-\\sqrt{y}} & ={lim}_{x\\to (4,4)}\\frac{(x-y)(\\sqrt{x}+\\sqrt{y})}{(\\sqrt{x}-\\sqrt{y})(\\sqrt{x}+\\sqrt{y})} \\\\  & ={lim}_{x\\to (4,4)}\\frac{(x-y)(\\sqrt{x}+\\sqrt{y})}{(\\sqrt{x})^{2}-(\\sqrt{y})^{2}} \\\\  & ={lim}_{x\\to (4,4)}\\frac{(x-y)(\\sqrt{x}+\\sqrt{y})}{x-y} \\\\  & ={lim}_{x\\to (4,4)}(\\sqrt{x}+\\sqrt{y})\\end{aligned}\n$$\n\nNow that the limit has been simplified, we can evaluate it:\n\n$$\n\\begin{aligned}{lim}_{x\\to (4,4)}(\\sqrt{x}+\\sqrt{y}) & =\\sqrt{4}+\\sqrt{4} \\\\  & =2+2 \\\\  & =4\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $4.$"}] [{:db/id #edb/ref 17592186345002 :knowledge-point/_questions [{:db/id #edb/ref 17592186124558 :knowledge-point/id #uuid "7d53554f-6d77-56f9-8950-d8e31a7f4fdb" :knowledge-point/title "Calculating Limits of Multivariable Functions Using Conjugate Multiplication"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24eddf01-84ca-55d1-a380-e9e3dc0ff46c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186342549} {:answer/id #uuid "46dbb611-211c-5a6d-87c1-e6d11b78516f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186342824} {:answer/id #uuid "5b00ef31-06ca-5784-b242-7ba648259786" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{2}" :db/id #edb/ref 17592186342998} {:answer/id #uuid "5f565846-c8fc-53fd-9002-a2c55e2b4a8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186343042} {:answer/id #uuid "740303a6-c0b7-5dc3-b4d8-e1c846a9c24f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186343243}] :answer-field/correct {:answer/id #uuid "5f565846-c8fc-53fd-9002-a2c55e2b4a8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186343042} :answer-field/id #uuid "e02b8a03-215d-5182-84e4-5ebedc1e9c9a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344885}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "324536b7-fcd9-5a5e-87fe-4723a8ba3a5d" :question/math-academy-id "q-74958" :question/problem "${lim}_{x\\to (1,1)}\\frac{\\sqrt{x}-y}{x-{y}^{2}}=$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0},$ as follows: \n\n$$\n{lim}_{x\\to (1,1)}\\frac{\\sqrt{x}-y}{x-{y}^{2}}=\\frac{\\sqrt{1}-1}{1-{1}^{2}}=\\frac{0}{0}\n$$\n\nHowever, we can simplify the limit by first multiplying the numerator and denominator by the conjugate of the numerator: \n\n$$\n\\begin{aligned}{lim}_{x\\to (1,1)}\\frac{\\sqrt{x}-y}{x-{y}^{2}} & ={lim}_{x\\to (1,1)}\\frac{(\\sqrt{x}-y)(\\sqrt{x}+y)}{(x-{y}^{2})(\\sqrt{x}+y)} \\\\  & ={lim}_{x\\to (1,1)}\\frac{(\\sqrt{x})^{2}-{y}^{2}}{(x-{y}^{2})(\\sqrt{x}+y)} \\\\  & ={lim}_{x\\to (1,1)}\\frac{x-{y}^{2}}{(x-{y}^{2})(\\sqrt{x}+y)} \\\\  & ={lim}_{x\\to (1,1)}\\frac{1}{\\sqrt{x}+y}\\end{aligned}\n$$\n\n \n\nNow that the limit has been simplified, we can evaluate it:\n\n$$\n\\begin{aligned}{lim}_{x\\to (1,1)}\\frac{1}{\\sqrt{x}+y} & =\\frac{1}{\\sqrt{1}+1} \\\\  & =\\frac{1}{1+1} \\\\  & =\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $\\frac{1}{2}.$"}]}
