imeElapsed":25402,"question":{"id":31400,"exampleId":14406,"difficulty":2}},{"id":62331814,"studentId":57976,"choices":null,"selectedChoice":3,"selectId":0,"correct":0,"timeElapsed":23823,"question":{"id":31399,"exampleId":14406,"difficulty":3}},{"id":62331870,"studentId":57976,"choices":null,"selectedChoice":1,"selectId":0,"correct":1,"timeElapsed":25952,"question":{"id":73659,"exampleId":14406,"difficulty":3}},{"id":62331908,"studentId":57976,"choices":null,"selectedChoice":1,"selectId":0,"correct":1,"timeElapsed":16255,"question":{"id":31394,"exampleId":14406,"difficulty":1}},{"id":62331949,"studentId":57976,"choices":null,"selectedChoice":1,"selectId":0,"correct":1,"timeElapsed":14417,"question":{"id":31618,"exampleId":14422,"difficulty":2}},{"id":62332012,"studentId":57976,"choices":null,"selectedChoice":null,"selectId":0,"correct":0,"timeElapsed":15263,"question":{"id":351285,"exampleId":14422,"difficulty":1}},{"id":62332044,"studentId":57976,"choices":null,"selectedChoice":null,"selectId":0,"correct":1,"timeElapsed":15494,"question":{"id":350210,"exampleId":14422,"difficulty":1}},{"id":62332090,"studentId":57976,"choices":null,"selectedChoice":3,"selectId":0,"correct":0,"timeElapsed":15892,"question":{"id":49517,"exampleId":14422,"difficulty":3}},{"id":62332121,"studentId":57976,"choices":null,"selectedChoice":1,"selectId":0,"correct":1,"timeElapsed":15290,"question":{"id":13845,"exampleId":14422,"difficulty":3}}],"completedStr":"Completed @ 7:06 AM","exampleAnswers":[{"id":14405,"number":1,"title":"Integrating Functions Containing the Natural Logarithm","answers":[{"id":62331511,"created":"2026-10-16T07:01:37.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":12361,"number":1,"createdStr":"Fri, Oct 16th @ 7:01 AM","timeElapsedFormatted":"0:12","question":{"id":2202,"format":"MC","difficulty":1,"exampleId":14405,"text":"<p>Calculate the integral $\\displaystyle{\\int \\dfrac{4\\ln x}{x} \\, \\textrm{d}x }.$</p>\n","choice1":"$2\\ln^2 x + C$","choice2":"$2\\ln x + C$","choice3":"$\\ln^2 x + C$","choice4":"$\\dfrac {\\ln^2 x}{2} + C$","choice5":"$-\\ln^2 x + C$","freeAnswerChoice":"","explanation":"<p>Let&#39;s set $u = \\ln x.$ Then, we have\n\\[\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}= \\dfrac 1 x\\quad\\Longrightarrow\\quad \\textrm{d}u=\\dfrac 1 x\\,{\\textrm{d}x}.\n\\]</p>\n<p>Using the above, we can write the integral in terms of $u$ and evaluate:\n\\begin{align*}\n\\int\\dfrac{4\\ln x}{x} \\, \\textrm{d}x \n& = 4 \\int \\ln x \\cdot \\dfrac{\\textrm{d}x}{x} \\\\[5pt]\n& = 4 \\int u \\,\\textrm{d}u \\\\[5pt]\n& = 4 \\cdot \\dfrac {u^2}{2} + C \\\\[5pt]\n& = 2u^2 + C \\\\[5pt]\n& = 2\\ln^2 x + C\n\\end{align*}</p>\n","topic":{"id":1161,"name":"Integrating Logarithmic Functions Using Substitution"},"example":{"id":14405,"title":"Integrating Functions Containing the Natural Logarithm"},"group":{"id":98179,"calculator":"None"},"graphics":[],"selects":[{"id":null,"number":null,"answers":[]}],"inputAnswers":[],"body":null,"taskId":14256597,"answer":{"id":62331511,"cread":"2026-10-16T07:01:37.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":12361},"graphic":false,"difficultyClass":"difficultyEasy","difficultySymbol":"E","rendered":true,"testMode":false}},{"id":62331534,"created":"2026-10-16T07:01:53.000Z","choices":null,"correct":0,"selectedChoice":3,"freeResponse":null,"timeElapsed":11441,"number":2,"createdStr":"Fri, Oct 16th @ 7:01 AM","timeElapsedFormatted":"0:11","question":{"id":13813,"format":"MC","difficulty":3,"exampleId":14405,"text":"<p>Calculate the integral $\\displaystyle{\\int \\dfrac{6}{x \\ln^2 x}\\,\\textrm{d}x}.$</p>\n","choice1":" $-\\dfrac{6}{\\ln x}+C$","choice2":" $\\dfrac{6}{\\ln x}+C$","choice3":" $-\\dfrac{6}{\\ln^2 x}+C$","choice4":" $\\dfrac{6}{\\ln^2 x}+C$","choice5":" $\\dfrac{1}{\\ln x}+C$","freeAnswerChoice":"","explanation":"<p>Let&#39;s set $u = \\ln x.$ Then, we have\n\\[\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}= \\dfrac 1 x\\quad\\Longrightarrow\\quad \\textrm{d}u=\\dfrac 1 x\\,{\\textrm{d}x}.\n\\]</p>\n<p>Using the above, we can write the integral in terms of $u$ and evaluate:</p>\n<p>\\[\n\\eqalign{\n\t\\int \\dfrac{6}{x \\ln^2 x}\\,\\textrm{d}x\n\t\t&= 6\\int \\dfrac{1}{(\\ln x)^2}\\cdot \\dfrac{\\textrm{d}x}{x}\\\\[5pt]\n\t\t&= 6\\int \\dfrac{1}{u^2}\\,\\textrm{d}u\\\\[5pt]\n\t\t&= -6\\cdot u^{-1}+C\\\\[5pt]\n\t\t&= -\\dfrac{6}{u}+C\\\\[5pt]\n\t\t&= -\\dfrac{6}{\\ln x}+C\n}\n\\]</p>\n","topic":{"id":1161,"name":"Integrating Logarithmic Functions Using Substitution"},"example":{"id":14405,"title":"Integrating Functions Containing the Natural Logarithm"},"group":{"id":98182,"calculator":"None"},"graphics":[],"selects":[],"inputAnswers":[],"body":null,"taskId":14256597,"answer":{"id":62331534,"cread":"2026-10-16T07:01:53.000Z","choices":null,"correct":0,"selectedChoice":3,"freeResponse":null,"timeElapsed":11441},"graphic":false,"difficultyClass":"difficultyHard","difficultySymbol":"H","rendered":true,"testMode":false}},{"id":62331576,"created":"2026-10-16T07:02:14.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":16626,"number":3,"createdStr":"Fri, Oct 16th @ 7:02 AM","timeElapsedFormatted":"0:17","question":{"id":2380,"format":"MC","difficulty":2,"exampleId":14405,"text":"<p>Calculate the integral $\\displaystyle{\\int \\dfrac{1}{x\\sqrt{\\ln x}}\\,\\textrm{d}x}.$</p>\n","choice1":"$2\\sqrt{\\ln x}+C$","choice2":"$\\ln x + C$","choice3":"$\\dfrac{\\ln x}{x} + C$","choice4":"$\\dfrac {1}{\\ln (\\ln x)} + C$","choice5":"$ \\dfrac {\\sqrt{\\ln (\\ln x)}}{x} + C$","freeAnswerChoice":" ","explanation":"<p>Let&#39;s set $u = \\ln x.$ Then, we have\n\\[\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}= \\dfrac{1}{x}\n\\quad\\Longrightarrow\\quad\n{\\textrm{d}u}=\\dfrac{\\textrm d x}{x}.\n\\]</p>\n<p>Using the above, we can write the integral in terms of $u$ and evaluate:</p>\n<p>\\[\n\t\\eqalign{\n\\displaystyle{\\int \\dfrac{1}{x\\sqrt{\\ln x}}\\,\\textrm{d}x}\n&=\\int \\dfrac{1}{\\sqrt{\\ln x}}\\cdot \\dfrac{\\textrm d x}{x}\\\\[5pt]\n&=\\int \\dfrac{1}{\\sqrt{u}} \\cdot \\textrm{d}u\\\\[5pt]\n&=\\int u^{-1/2} \\, \\textrm{d}u\\\\[5pt]\n&=  2 u^{1/2} + C \\\\[5pt]\n&= 2\\sqrt{\\ln x}+C\n\n\n\n\t}\n\\]</p>\n","topic":{"id":1161,"name":"Integrating Logarithmic Functions Using Substitution"},"example":{"id":14405,"title":"Integrating Functions Containing the Natural Logarithm"},"group":{"id":29402,"calculator":"None"},"graphics":[],"selects":[],"inputAnswers":[],"body":null,"taskId":14256597,"answer":{"id":62331576,"cread":"2026-10-16T07:02:14.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":16626},"graphic":false,"difficultyClass":"difficultyModerate","difficultySymbol":"M","rendered":true,"testMode":false}},{"id":62331608,"created":"2026-10-16T07:02:37.000Z","choices":null,"correct":0,"selectedChoice":2,"freeResponse":null,"timeElapsed":18954,"number":4,"createdStr":"Fri, Oct 16th @ 7:02 AM","timeElapsedFormatted":"0:19","question":{"id":13802,"format":"MC","difficulty":3,"exampleId":14405,"text":"<p>Calculate the integral $\\displaystyle{\\int \\dfrac{2}{x\\ln (2x)}\\,\\textrm{d}x}.$</p>\n","choice1":"$2\\ln|\\ln(2x)|+C$","choice2":"$2\\ln|\\ln(2x)|$","choice3":"$\\ln|\\ln(2x)|+C$","choice4":"$2\\ln|\\ln x|+C$","choice5":"$\\ln|\\ln x|+C$","freeAnswerChoice":"","explanation":"<p>Let&#39;s set $u = \\ln (2x).$ Then, we have\n\\[\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}= \\dfrac{1}{2x} \\cdot 2= \\dfrac 1 x\n\\quad\\Longrightarrow\\quad\n{\\textrm{d}u}=\\dfrac{\\textrm d x}{x}.\n\\]</p>\n<p>Using the above, we can write the integral in terms of $u$ and evaluate:\n\\begin{align*}\n\\int \\dfrac{2}{x\\ln (2x)}\\, \\textrm{d}x\n&=2\\int \\dfrac{1}{\\ln (2x)}\\cdot \\dfrac{\\textrm{d}x}{x}\\\\[5pt]\n&=2\\int \\dfrac{1}{u}\\cdot\\textrm{d}u\\\\[5pt]\n&=2\\ln|u|+C\\\\[5pt]\n&=2\\ln|\\ln(2x)|+C\t\n\\end{align*}</p>\n","topic":{"id":1161,"name":"Integrating Logarithmic Functions Using Substitution"},"example":{"id":14405,"title":"Integrating Functions Containing the Natural Logarithm"},"group":{"id":98182,"calculator":"None"},"graphics":[],"selects":[],"inputAnswers":[],"body":null,"taskId":14256597,"answer":{"id":62331608,"cread":"2026-10-16T07:02:37.000Z","choices":null,"correct":0,"selectedChoice":2,"freeResponse":null,"timeElapsed":18954},"graphic":false,"difficultyClass":"difficultyHard","difficultySymbol":"H","rendered":true,"testMode":false}},{"id":62331643,"created":"2026-10-16T07:02:55.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":13428,"number":5,"createdStr":"Fri, Oct 16th @ 7:02 AM","timeElapsedFormatted":"0:13","question":{"id":2194,"format":"MC","difficulty":3,"exampleId":14405,"text":"<p>Calculate the integral $\\displaystyle{\\int \\dfrac{\\sqrt 2}{x \\ln x} \\, \\textrm{d}x }.$</p>\n","choice1":"$\\sqrt 2 \\ln \\left|\\ln x \\right| + C$","choice2":"$\\dfrac {\\sqrt 2}{\\ln|\\ln x|} + C$","choice3":"$\\dfrac {1}{\\ln|\\ln x|} + C$","choice4":"$ \\ln \\left|\\ln x \\right|+ C$","choice5":"$x\\ln \\left(\\ln \\sqrt 2 \\right) + C$","freeAnswerChoice":"","explanation":"<p>Let&#39;s set $u = \\ln x.$ Then, we have\n\\[\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}= \\dfrac 1 x\\quad\\Longrightarrow\\quad \\textrm{d}u=\\dfrac 1 x\\,{\\textrm{d}x}.\n\\]</p>\n<p>Using the above, we can write the integral in terms of $u$ and evaluate:</p>\n<p>\\begin{eqnarray}\n\\eqalign{\n\\int \\dfrac{\\sqrt 2}{x \\ln x}\\, \\textrm{d}x \n&= \\sqrt{2} \\int \\dfrac{1}{\\ln x} \\cdot \\dfrac{\\textrm{d}x}{x} \\\\[5pt]\n& = \\sqrt 2\\int \\dfrac 1 u \\cdot \\textrm{d}u\\\\[5pt]\n& = \\sqrt 2 \\ln |u| + C \\\\[5pt]\n& = \\sqrt 2 \\ln |\\ln x|  + C\n \t\t\n      \n    }\n\\end{eqnarray}</p>\n","topic":{"id":1161,"name":"Integrating Logarithmic Functions Using Substitution"},"example":{"id":14405,"title":"Integrating Functions Containing the Natural Logarithm"},"group":{"id":98182,"calculator":"None"},"graphics":[],"selects":[],"inputAnswers":[],"body":null,"taskId":14256597,"answer":{"id":62331643,"cread":"2026-10-16T07:02:55.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":13428},"graphic":false,"difficultyClass":"difficultyHard","difficultySymbol":"H","rendered":true,"testMode":false}}]},{"id":14406,"number":2,"title":"Integrating Functions Containing Other Logarithms","answers":[{"id":62331677,"created":"2026-10-16T07:03:18.000Z","choices":null,"correct":0,"selectedChoice":5,"freeResponse":null,"timeElapsed":13009,"number":6,"createdStr":"Fri, Oct 16th @ 7:03 AM","timeElapsedFormatted":"0:13","question":{"id":114021,"format":"MC","difficulty":1,"exampleId":14406,"text":"<p>$\\displaystyle \\int \\dfrac{\\log_7 {x}}{2x}\\,\\textrm{d}x =$</p>\n","choice1":"$\\dfrac{\\ln 7}4\\cdot\\log_7^2{x}+C$","choice2":"$\\dfrac{\\ln 7}2\\cdot\\log_7^2{x}+C$","choice3":"$\\ln 7\\cdot\\log_7^2{x}+C$","choice4":"$4\\cdot\\log_7^2{x}+C$","choice5":"$\\dfrac{\\ln 7}2\\cdot\\log_7{x}+C$","freeAnswerChoice":" ","explanation":"<p>Let $u= \\log_7 x.$ Differentiating, we get\n\\[\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=\\dfrac{1}{x\\ln 7}\n\\quad\\Longrightarrow\\quad\n\\ln 7\\,{\\textrm{d}u}=\\dfrac{\\textrm d x}{x}.\n\\]</p>\n<p>Using the above, we can write the integral in terms of $u$ and evaluate:\n\\[\n\\eqalign{\n\\int \\dfrac{\\log_7 {x}}{2x}\\,\\textrm{d}x\n\t\t& = \\dfrac12\\int \\log_7 {x} \\cdot \\dfrac{\\textrm{d}x}{x}\\\\\n\t\t& = \\dfrac12\\int u \\cdot \\ln 7\\,{\\textrm{d}u}\\\\\n\t\t& = \\dfrac{\\ln 7}2 \\displaystyle \\int u \\, \\textrm{d}u\\\\\n\t\t& = \\dfrac{\\ln 7}2 \\cdot \\dfrac{u^2}{2}+C\\\\\n\t\t& = \\dfrac{\\ln 7}4\\cdot\\log_7^2{x}+C\n\n}\n\\]</p>\n","topic":{"id":1161,"name":"Integrating Logarithmic Functions Using Substitution"},"example":{"id":14406,"title":"Integrating Functions Containing Other Logarithms"},"group":{"id":29414,"calculator":"None"},"graphics":[],"selects":[],"inputAnswers":[],"body":null,"taskId":14256597,"answer":{"id":62331677,"cread":"2026-10-16T07:03:18.000Z","choices":null,"correct":0,"selectedChoice":5,"freeResponse":null,"timeElapsed":13009},"graphic":false,"difficultyClass":"difficultyEasy","difficultySymbol":"E","rendered":true,"testMode":false}},{"id":62331740,"created":"2026-10-16T07:03:48.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":25402,"number":7,"createdStr":"Fri, Oct 16th @ 7:03 AM","timeElapsedFormatted":"0:25","question":{"id":31400,"format":"MC","difficulty":2,"exampleId":14406,"text":"<p>$\\displaystyle \\int \\dfrac{\\log_2 {(x^2)}}{x}\\,\\textrm{d}x=$</p>\n","choice1":"$\\dfrac{\\ln{2}\\log_2^2{(x^2)}}{4}+ C$","choice2":"$\\dfrac{\\ln{2}\\log_2^2{(x^2)}}{2}+ C$","choice3":"$\\dfrac{\\ln{x}\\log_2^2{(x^2)}}{2}+ C$","choice4":"$\\dfrac{\\ln{2}\\log_2{(x^2)}}{4}+ C$","choice5":"$\\dfrac{\\ln{2}\\log_2{(x^2)}}{2}+ C$","freeAnswerChoice":"","explanation":"<p>Let $u= \\log_2 {(x^2)}.$ Differentiating, we get\n\\[\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=\\dfrac{2}{x\\ln{2}}\n\\quad\\Longrightarrow\\quad\n\\dfrac{\\ln{2}}{2} \\textrm d u=\\dfrac{\\textrm d x}{x}.\n\\]</p>\n<p>Using the above, we can write the integral in terms of $u$ and evaluate:\n\\begin{align*}\n\\int \\dfrac{\\log_2 {(x^2)}}{x}\\,\\textrm{d}x\n&= \\int \\log_2 {(x^2)} \\cdot \\dfrac{\\textrm{d}x}{x} \\\\[5pt]\n&= \\int u \\cdot \\left( \\dfrac{\\ln{2}}{2} \\textrm d u \\right) \\\\[5pt]\n& = \\dfrac{\\ln{2}}{2} \\int u \\, \\textrm{d}u \\\\[5pt]\n& = \\dfrac{\\ln{2}}{2}\\cdot \\dfrac{u^2}{2}+C \\\\[5pt]\n& = \\dfrac{\\ln{2}\\log_2^2{(x^2)}}{4}+ C.\n\\end{align*}</p>\n","topic":{"id":1161,"name":"Integrating Logarithmic Functions Using Substitution"},"example":{"id":14406,"title":"Integrating Functions Containing Other Logarithms"},"group":{"id":29415,"calculator":"None"},"graphics":[],"selects":[],"inputAnswers":[],"body":null,"taskId":14256597,"answer":{"id":62331740,"cread":"2026-10-16T07:03:48.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":25402},"graphic":false,"difficultyClass":"difficultyModerate","difficultySymbol":"M","rendered":true,"testMode":false}},{"id":62331814,"created":"2026-10-16T07:04:18.000Z","choices":null,"correct":0,"selectedChoice":3,"freeResponse":null,"timeElapsed":23823,"number":8,"createdStr":"Fri, Oct 16th @ 7:04 AM","timeElapsedFormatted":"0:24","question":{"id":31399,"format":"MC","difficulty":3,"exampleId":14406,"text":"<p>$\\displaystyle \\int \\dfrac{3}{x\\log_5 {x}}\\,\\textrm{d}x=$</p>\n","choice1":"$3\\ln{5} \\ln|\\log_5{x}|+C$","choice2":"$\\dfrac{ \\ln(5)}{5} \\ln|\\log{x}|+C$","choice3":"$ 3\\ln{x} \\ln|\\log{x}|+C$","choice4":"$ \\ln{5} \\ln|\\log_3{x}|+C$","choice5":"$ 3\\ln{3} \\ln|\\log_2{x}|+C$","freeAnswerChoice":"","explanation":"<p>Let $u= \\log_5 x.$ Differentiating, we get</p>\n<p>\\[\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=\\dfrac{1}{x\\ln 5}\n\\quad\\Longrightarrow\\quad\n\\ln 5\\,{\\textrm{d}u}=\\dfrac{\\textrm d x}{x}.\n\\]</p>\n<p>Using the above, we can write the integral in terms of $u$ and evaluate:</p>\n<p>\\[\n\\eqalign{\n\t\\int \\dfrac{3}{x\\log_5 {x}}\\,\\textrm{d}x\n\t\t& = 3\\int \\dfrac{1}{\\log_5 {x}} \\cdot \\dfrac{\\textrm d x}{x}\\\\[5pt]\n\t\t& = 3\\int \\dfrac{1}{u} \\cdot \\ln 5\\,{\\textrm{d}u}\\\\[5pt]\n\t\t& = 3\\ln{5} \\displaystyle \\int \\dfrac{1}{u} \\, \\textrm{d}u\\\\[5pt]\n\t\t& = 3\\ln{5} \\ln|u|+C\\\\[5pt]\n\t\t& = 3\\ln{5} \\ln|\\log_5{x}|+C\n}\n\\]</p>\n","topic":{"id":1161,"name":"Integrating Logarithmic Functions Using Substitution"},"example":{"id":14406,"title":"Integrating Functions Containing Other Logarithms"},"group":{"id":29368,"calculator":"None"},"graphics":[],"selects":[],"inputAnswers":[],"body":null,"taskId":14256597,"answer":{"id":62331814,"cread":"2026-10-16T07:04:18.000Z","choices":null,"correct":0,"selectedChoice":3,"freeResponse":null,"timeElapsed":23823},"graphic":false,"difficultyClass":"difficultyHard","difficultySymbol":"H","rendered":true,"testMode":false}},{"id":62331870,"created":"2026-10-16T07:04:53.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":25952,"number":9,"createdStr":"Fri, Oct 16th @ 7:04 AM","timeElapsedFormatted":"0:26","question":{"id":73659,"format":"MC","difficulty":3,"exampleId":14406,"text":"<p>$\\displaystyle \\int \\dfrac{1}{x\\log_7 (4x)}\\,\\textrm{d}x=$</p>\n","choice1":"$\\ln 7  \\ln|\\log_7(4x)|+C$","choice2":"$x\\ln 7  \\ln|\\log_7 (x^4)|+C$","choice3":"$\\dfrac{\\ln 7}{7}  \\ln|\\log_7(4x)|+C$","choice4":"$\\ln x^7  \\ln|\\log_7(4x)|+C$","choice5":"$\\ln 4  \\ln|\\log_7 x|+C$","freeAnswerChoice":"","explanation":"<p>Let $u= \\log_7 (4x).$ Differentiating, we get\n\\[\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=\\dfrac{1}{x\\ln 7}\n\\quad\\Longrightarrow\\quad\n\\ln 7\\,{\\textrm{d}u}=\\dfrac{\\textrm d x}{x}.\n\\]</p>\n<p>Using the above, we can write the integral in terms of $u$ and evaluate:\n\\begin{align*}\n\\displaystyle \\int \\dfrac{1}{x\\log_7 (4x)}\\,\\textrm{d}x\n& = \\int \\dfrac{1}{\\log_7 (4x)} \\cdot \\dfrac{\\textrm d x}{x}\\\\[5pt]\n& = \\int \\dfrac{1}{u} \\cdot \\ln 7\\,{\\textrm{d}u} \\\\[5pt]\n& = \\ln 7 \\displaystyle \\int \\dfrac{1}{u} \\cdot \\textrm{d}u\\\\[5pt]\n& = \\ln 7 \\ln|u|+C\\\\[5pt]\n& = \\ln 7  \\ln|\\log_7(4x)|+C\n\\end{align*}</p>\n","topic":{"id":1161,"name":"Integrating Logarithmic Functions Using Substitution"},"example":{"id":14406,"title":"Integrating Functions Containing Other Logarithms"},"group":{"id":29421,"calculator":"None"},"graphics":[],"selects":[],"inputAnswers":[],"body":null,"taskId":14256597,"answer":{"id":62331870,"cread":"2026-10-16T07:04:53.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":25952},"graphic":false,"difficultyClass":"difficultyHard","difficultySymbol":"H","rendered":true,"testMode":false}},{"id":62331908,"created":"2026-10-16T07:05:14.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":16255,"number":10,"createdStr":"Fri, Oct 16th @ 7:05 AM","timeElapsedFormatted":"0:16","question":{"id":31394,"format":"MC","difficulty":1,"exampleId":14406,"text":"<p>$\\displaystyle \\int \\dfrac{\\log_5 {x}}{x}\\,\\textrm{d}x=$</p>\n","choice1":"$\\ln 5 \\cdot \\dfrac{\\log_5^2{x}}{2}+C$","choice2":"$\\ln x \\cdot \\dfrac{\\log_5^2{x}}{2}+C$","choice3":"$\\ln 5 \\cdot \\dfrac{\\log_5{x}}{2}+C$","choice4":"$\\ln x \\cdot \\dfrac{\\log_5^2{x}}{x}+C$","choice5":"$\\ln 5 \\cdot \\dfrac{\\log_3{x}}{2}+C$","freeAnswerChoice":"","explanation":"<p>Let $u= \\log_5 x.$ Differentiating, we get\n\\[\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=\\dfrac{1}{x\\ln 5}\n\\quad\\Longrightarrow\\quad\n\\ln 5\\,{\\textrm{d}u}=\\dfrac{\\textrm d x}{x}.\n\\]</p>\n<p>Using the above, we can write the integral in terms of $u$ and evaluate:</p>\n<p>\\[\n\\eqalign{\n\\int \\dfrac{\\log_5 {x}}{x}\\,\\textrm{d}x\n\t\t& = \\int \\log_5 {x} \\cdot \\dfrac{\\textrm{d}x}{x}\\\\\n\t\t& = \\int u \\cdot \\ln 5\\,{\\textrm{d}u}\\\\\n\t\t& = \\ln 5 \\displaystyle \\int u \\, \\textrm{d}u\\\\\n\t\t& = \\ln 5 \\cdot \\dfrac{u^2}{2}+C\\\\\n\t\t& = \\ln 5 \\cdot \\dfrac{\\log_5^2{x}}{2}+C\n\n\n}\n\\]</p>\n","topic":{"id":1161,"name":"Integrating Logarithmic Functions Using Substitution"},"example":{"id":14406,"title":"Integrating Functions Containing Other Logarithms"},"group":{"id":29414,"calculator":"None"},"graphics":[],"selects":[],"inputAnswers":[],"body":null,"taskId":14256597,"answer":{"id":62331908,"cread":"2026-10-16T07:05:14.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":16255},"graphic":false,"difficultyClass":"difficultyEasy","difficultySymbol":"E","rendered":true,"testMode":false}}]},{"id":14422,"number":3,"title":"Evaluating Definite Integrals","answers":[{"id":62331949,"created":"2026-10-16T07:05:40.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":14417,"number":11,"createdStr":"Fri, Oct 16th @ 7:05 AM","timeElapsedFormatted":"0:14","question":{"id":31618,"format":"MC","difficulty":2,"exampleId":14422,"text":"<p>What is the value of $\\displaystyle{\\int_{1}^{e} \\dfrac{\\sqrt{\\ln x}}{2x}\\,\\textrm{d}x}?$</p>\n","choice1":"$\\dfrac{1}{3}$","choice2":"$\\dfrac{1}{2}$","choice3":"$\\dfrac{3}{7}$","choice4":"$\\dfrac{7}{2}$","choice5":"$\\dfrac{3}{2}$","freeAnswerChoice":" ","explanation":"<p>Let&#39;s set $u = \\ln x.$ Then, we have</p>\n<p>\\[\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}= \\dfrac 1 x\\quad\\Longrightarrow\\quad \\textrm{d}u=\\dfrac 1 x\\,{\\textrm{d}x}.\n\\]</p>\n<p>Calculating the limits for $u$ gives the following:</p>\n<table align=\"center\" font-size=inherit style=\"border:1px solid black; margin: auto; margin-bottom: 4mm; margin-top: 4mm\" rules=all cellpadding=5>\n\n<tr>\n     <td style=\"text-align:center; width: 30px;\" bgcolor=\"#D6EAF8\">$x$</td>\n     <td style=\"text-align:center; width: 40px;\">   $1$   </td>\n     <td style=\"text-align:center; width: 40px;\">   $e$   </td>\n</tr>\n<tr>\n        <td style=\"text-align:center\"  bgcolor=\"#D6EAF8\">$u$</td>\n     <td style=\"text-align:center\">   $0$   </td>\n     <td style=\"text-align:center\">   $1$   </td>\n\n\n</tr>\n</table>\n\n\n<p>We now substitute and evaluate as follows:\n\\[\n\t\\eqalign{\n\t\\int_{1}^{e} \\dfrac{\\sqrt{\\ln x}}{2x}\\,\\textrm{d}x\n&= \\dfrac{1}{2}\\int_{1}^{e} \\sqrt{\\ln x}\\cdot \\dfrac{\\textrm{d}x}{x}\\\\[5pt]\n&=\\dfrac{1}{2}\\int_{0}^{1}\\sqrt{u}\\,\\textrm{d}u \\\\[5pt]\n&= \\dfrac{1}{2}\\int_{0}^{1} u^{1/2}\\,\\textrm{d}u\\\\[5pt]\n&= \\dfrac{1}{2}\\cdot \\left.\\dfrac{u^{3/2}}{3/2}\\right|_{0}^{1}\\\\[5pt]\n&=  \\dfrac{1}{3}\\cdot\\left.\\left(\\sqrt{u}\\right)^3\\right|_{0}^{1}\\\\[5pt]\n&=  \\dfrac{1}{3}\\cdot\\left(\\left(\\sqrt{1}\\right)^3 - \\left(\\sqrt{0}\\right)^3\\right) \\\\[5pt]\n&=  \\dfrac{1}{3}\t\n\t}\n\\]</p>\n","topic":{"id":1161,"name":"Integrating Logarithmic Functions Using Substitution"},"example":{"id":14422,"title":"Evaluating Definite Integrals"},"group":{"id":98185,"calculator":"None"},"graphics":[],"selects":[],"inputAnswers":[],"body":null,"taskId":14256597,"answer":{"id":62331949,"cread":"2026-10-16T07:05:40.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":14417},"graphic":false,"difficultyClass":"difficultyModerate","difficultySymbol":"M","rendered":true,"testMode":false}},{"id":62332012,"created":"2026-10-16T07:05:59.000Z","choices":null,"correct":0,"selectedChoice":null,"freeResponse":"[\"0\"]","timeElapsed":15263,"number":12,"createdStr":"Fri, Oct 16th @ 7:05 AM","timeElapsedFormatted":"0:15","question":{"id":351285,"format":"FR","difficulty":1,"exampleId":14422,"text":"Evaluate the following integral. Do not round the answer.","choice1":null,"choice2":null,"choice3":null,"choice4":null,"choice5":null,"freeAnswerChoice":"\\newline\r\n$\\displaystyle{\\int_{3}^{9} \\dfrac{4\\log_3 (x^2)}{x} \\, \\textrm{d}x} = \\Big($\r\n[\r\nanswer: 12;\r\ntype: expression;\r\nwidth: 40;\r\nmargin-left: 0;\r\nmargin-right: 0;\r\nbuttons: sqrt, frac, ln, exp;\r\n]\r\n$\\Big)\\ln{3}$","explanation":"<p>Let $u= \\log_3 (x^2).$ Differentiating, we get\n\\[\r\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=\\dfrac{1}{x^2\\ln 3}\\cdot 2x=\\dfrac{2}{x\\ln 3}\r\n\\quad\\Longrightarrow\\quad\r\n\\dfrac{\\ln 3}{2}\\,{\\textrm{d}u}=\\dfrac{\\textrm d x}{x}.\r\n\\]</p>\n<p>Calculating the limits for $u$ gives the following:</p>\n<table align=\"center\" font-size=inherit style=\"border:1px solid black; margin: auto; margin-bottom: 4mm; margin-top: 4mm\" rules=all cellpadding=5>\n\n<tr>\n<td style=\"text-align:center; width: 30px;\" bgcolor=\"#D6EAF8\">$x$</td>\n<td style=\"text-align:center; width: 40px;\">$3$</td>\n<td style=\"text-align:center; width: 40px;\">$9$</td>\n</tr>\n\n<tr>\n<td style=\"text-align:center\" bgcolor=\"#D6EAF8\">$u$</td>\n<td style=\"text-align:center\">$2$</td>\n<td style=\"text-align:center\">$4$</td>\n</tr>\n\n</table>\n\n<p>We now substitute and evaluate as follows:</p>\n<p>\\begin{align}\r\n\\int_{3}^{9} \\dfrac{4\\log_3 (x^2)}{x} \\, \\textrm{d}x\r\n&=4\\int_{3}^{9}\\log_3(x^2)\\cdot\\dfrac{\\textrm d x}{x}\\\\[5pt]\r\n&=4\\int_{2}^{4}u\\cdot\\dfrac{\\ln3}{2}\\,\\textrm d u\\\\[5pt]\r\n&=2\\ln3\\int_{2}^{4}u\\,\\textrm d u\\\\[5pt]\r\n&=2\\ln3\\cdot\\dfrac{u^2}{2}\\Big|_2^4\\\\[5pt]\r\n&=\\ln3(16-4)\\\\[5pt]\r\n&=\\left(\\bbox[4pt,border: 1px solid lightgray]{12}\\right)\\ln3\r\n\\end{align}</p>\n","topic":{"id":1161,"name":"Integrating Logarithmic Functions Using Substitution"},"example":{"id":14422,"title":"Evaluating Definite Integrals"},"group":{"id":98202,"calculator":"None"},"graphics":[],"selects":[],"inputAnswers":[],"body":null,"taskId":14256597,"answer":{"id":62332012,"cread":"2026-10-16T07:05:59.000Z","choices":null,"correct":0,"selectedChoice":null,"freeResponse":["0"],"timeElapsed":15263},"graphic":false,"freeResponse":{"segments":[{"newline":true},{"text":"$\\displaystyle{\\int_{3}^{9} \\dfrac{4\\log_3 (x^2)}{x} \\, \\textrm{d}x} = \\Big($\r\n"},{"textbox":{"answer":"12","type":"expression","width":40,"margin":{"left":0,"right":0},"buttons":["frac","exp","sqrt","ln"]}},{"text":"\r\n$\\Big)\\ln{3}$"}]},"difficultyClass":"difficultyEasy","difficultySymbol":"E","rendered":true,"testMode":false}},{"id":62332044,"created":"2026-10-16T07:06:18.000Z","choices":null,"correct":1,"selectedChoice":null,"freeResponse":"[\"27\"]","timeElapsed":15494,"number":13,"createdStr":"Fri, Oct 16th @ 7:06 AM","timeElapsedFormatted":"0:15","question":{"id":350210,"format":"FR","difficulty":1,"exampleId":14422,"text":"Evaluate the following integral. Do not round the answer.","choice1":null,"choice2":null,"choice3":null,"choice4":null,"choice5":null,"freeAnswerChoice":"\\newline\n $\\displaystyle{\\int_{1}^{e^3} \\dfrac{3\\ln^2 x}{x}\\,\\textrm{d}x} =$ \n[\n    answer: 27;\n    type: number;\n    width: 35;\n    margin-left: 2;\n    margin-right: 1;\n    buttons: frac, sqrt;\n]","explanation":"<p>Let&#39;s set $u = \\ln x.$ Then, we have</p>\n<p>\\[\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}= \\dfrac 1 x\\quad\\Longrightarrow\\quad \\textrm{d}u=\\dfrac 1 x\\,{\\textrm{d}x}.\n\\]</p>\n<p>Calculating the limits for $u$ gives the following:</p>\n<table align=\"center\" font-size=inherit style=\"border:1px solid black; margin: auto; margin-bottom: 4mm; margin-top: 4mm\" rules=all cellpadding=5>\n\n<tr>\n     <td style=\"text-align:center; width: 30px;\" bgcolor=\"#D6EAF8\">$x$</td>\n     <td style=\"text-align:center; width: 40px;\">   $1$   </td>\n     <td style=\"text-align:center; width: 40px;\">   $e^3$   </td>\n</tr>\n<tr>\n        <td style=\"text-align:center\"  bgcolor=\"#D6EAF8\">$u$</td>\n     <td style=\"text-align:center\">   $0$   </td>\n     <td style=\"text-align:center\">   $3$   </td>\n\n</tr>\n</table>\n\n<p>We now substitute and evaluate as follows:\n\\begin{align}\n\\int_{1}^{e^3} \\dfrac{3\\ln^2 x}{x}\\,\\textrm{d}x\n\n&= 3\\int_{1}^{e^3} \\ln^2{x} \\cdot \\dfrac{1}{x}\\,\\textrm{d}x\\\\[5pt]\n\n&= 3\\int_{0}^{3} u^2\\,\\textrm{d}u\\\\\n\n&= 3\\cdot \\dfrac{u^3}{3} \\, \\Bigg|_{0}^{3}\\\\[5pt]\n\n&= u^3 \\, \\Bigg|_{0}^{3}\\\\[5pt]\n\n&= \\left(3^3-0^3\\right)\\\\[5pt]\n\n&= 27-0\\\\[5pt]\n\n&= \\bbox[4pt,border: 1px solid lightgray]{27}\n\\end{align}</p>\n","topic":{"id":1161,"name":"Integrating Logarithmic Functions Using Substitution"},"example":{"id":14422,"title":"Evaluating Definite Integrals"},"group":{"id":98183,"calculator":"None"},"graphics":[],"selects":[],"inputAnswers":[],"body":null,"taskId":14256597,"answer":{"id":62332044,"cread":"2026-10-16T07:06:18.000Z","choices":null,"correct":1,"selectedChoice":null,"freeResponse":["27"],"timeElapsed":15494},"graphic":false,"freeResponse":{"segments":[{"newline":true},{"text":"$\\displaystyle{\\int_{1}^{e^3} \\dfrac{3\\ln^2 x}{x}\\,\\textrm{d}x} =$ \n"},{"textbox":{"answer":"27","type":"number","width":35,"margin":{"left":2,"right":1},"buttons":["frac","sqrt"]}}]},"difficultyClass":"difficultyEasy","difficultySymbol":"E","rendered":true,"testMode":false}},{"id":62332090,"created":"2026-10-16T07:06:38.000Z","choices":null,"correct":0,"selectedChoice":3,"freeResponse":null,"timeElapsed":15892,"number":14,"createdStr":"Fri, Oct 16th @ 7:06 AM","timeElapsedFormatted":"0:16","question":{"id":49517,"format":"MC","difficulty":3,"exampleId":14422,"text":"<p>What is the value of $\\displaystyle{\\int_e^{e^2} \\dfrac{\\textrm{d}x}{x \\ln x}}?$</p>\n","choice1":"$\\ln{2}$","choice2":"$e$","choice3":"$2\\ln{2}$","choice4":"$0$","choice5":"$1$","freeAnswerChoice":" ","explanation":"<p>Let&#39;s set $u = \\ln x.$ Then, we have</p>\n<p>\\[\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}= \\dfrac 1 x\\quad\\Longrightarrow\\quad \\textrm{d}u=\\dfrac 1 x\\,{\\textrm{d}x}.\n\\]</p>\n<p>Calculating the limits for $u$ gives the following:</p>\n<table align=\"center\" font-size=inherit style=\"border:1px solid black; margin: auto; margin-bottom: 4mm; margin-top: 4mm\" rules=all cellpadding=5>\n\n<tr>\n     <td style=\"text-align:center; width: 30px;\" bgcolor=\"#D6EAF8\">$x$</td>\n     <td style=\"text-align:center; width: 40px;\">   $e$   </td>\n     <td style=\"text-align:center; width: 40px;\">   $e^2$   </td>\n</tr>\n<tr>\n        <td style=\"text-align:center\"  bgcolor=\"#D6EAF8\">$u$</td>\n     <td style=\"text-align:center\">   $1$   </td>\n     <td style=\"text-align:center\">   $2$   </td>\n\n\n</tr>\n</table>\n\n<p>We now substitute and evaluate as follows:</p>\n<p>\\begin{eqnarray}\n\\eqalign{\n\\int_e^{e^2} \\dfrac{\\textrm{d}x}{x \\ln x}\n&= \\int_e^{e^2} \\dfrac{1}{\\ln x} \\cdot \\dfrac{\\textrm{d}x}{x} \\\\[5pt]\n& = \\int_{1}^{2} \\dfrac 1 u \\cdot \\textrm{d}u \\\\[5pt]\n& = \\left( \\ln |u| \\right) \\Big|_1^2 \\\\[5pt]\n& = \\ln{2} - \\ln{1}\\\\[5pt]\n& = \\ln{2}\n}\n\\end{eqnarray}</p>\n","topic":{"id":1161,"name":"Integrating Logarithmic Functions Using Substitution"},"example":{"id":14422,"title":"Evaluating Definite Integrals"},"group":{"id":98186,"calculator":"None"},"graphics":[],"selects":[],"inputAnswers":[],"body":null,"taskId":14256597,"answer":{"id":62332090,"cread":"2026-10-16T07:06:38.000Z","choices":null,"correct":0,"selectedChoice":3,"freeResponse":null,"timeElapsed":15892},"graphic":false,"difficultyClass":"difficultyHard","difficultySymbol":"H","rendered":true,"testMode":false}},{"id":62332121,"created":"2026-10-16T07:06:58.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":15290,"number":15,"createdStr":"Fri, Oct 16th @ 7:06 AM","timeElapsedFormatted":"0:15","question":{"id":13845,"format":"MC","difficulty":3,"exampleId":14422,"text":"<p>What is the value of $\\displaystyle{\\int_{1}^{e/4} \\dfrac{1}{4x\\ln (4x)}\\,\\textrm{d}x}?$</p>\n","choice1":" $-\\dfrac{1}{4}\\ln (\\ln 4)$","choice2":" $\\dfrac{1}{4}\\ln (\\ln 4)$","choice3":" $-\\ln (\\ln 4)$","choice4":" $0$","choice5":" $-\\dfrac{1}{4}\\ln 4$","freeAnswerChoice":" ","explanation":"<p>Let&#39;s set $u = \\ln (4x).$ Then, we have\n\\[\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}= \\dfrac{1}{4x} \\cdot 4=\\dfrac 1 x\n\\quad\\Longrightarrow\\quad\n{\\textrm{d}u}=\\dfrac{\\textrm d x}{x}.\n\\]</p>\n<p>Calculating the limits for $u$ gives the following:</p>\n<table align=\"center\" font-size=inherit style=\"border:1px solid black; margin: auto; margin-bottom: 4mm; margin-top: 4mm\" rules=all cellpadding=5>\n\n<tr>\n     <td style=\"text-align:center; width: 30px;\" bgcolor=\"#D6EAF8\">$x$</td>\n     <td style=\"text-align:center; width: 40px;\">   $1$   </td>\n     <td style=\"text-align:center; width: 40px;\">   $e/4$   </td>\n</tr>\n<tr>\n        <td style=\"text-align:center\"  bgcolor=\"#D6EAF8\">$u$</td>\n     <td style=\"text-align:center\">   $\\ln 4$   </td>\n     <td style=\"text-align:center\">   $1$   </td>\n\n\n</tr>\n</table>\n\n<p>We now substitute and evaluate as follows:\n\\begin{align*}\n\\int_{1}^{e/4} \\dfrac{1}{4x\\ln (4x)}\\,\\textrm{d}x\n&=\\dfrac14\\int_{1}^{e/4} \\dfrac{1}{\\ln (4x)}\\cdot\\dfrac{\\textrm{d}x}{x}\\\\[5pt]\n&=\\dfrac{1}{4}\\int_{\\ln 4}^{1} \\dfrac{1}{u}\\cdot\\textrm{d}u\\\\[5pt]\n&=\\dfrac{1}{4}\\Big.\\left(\\ln|u|\\right)\\Big|_{\\ln 4}^{1}\\\\[5pt]\n&=\\dfrac{1}{4}\\left(\\ln 1 - \\ln (\\ln 4)\\right)\\\\[5pt]\n&=\\dfrac{1}{4}\\left(0 - \\ln (\\ln 4)\\right)\\\\[5pt]\n&=-\\dfrac{1}{4}\\ln (\\ln 4)\n\\end{align*}</p>\n","topic":{"id":1161,"name":"Integrating Logarithmic Functions Using Substitution"},"example":{"id":14422,"title":"Evaluating Definite Integrals"},"group":{"id":98191,"calculator":"None"},"graphics":[],"selects":[],"inputAnswers":[],"body":null,"taskId":14256597,"answer":{"id":62332121,"cread":"2026-10-16T07:06:58.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":15290},"graphic":false,"difficultyClass":"difficultyHard","difficultySymbol":"H","rendered":true,"testMode":false}}]}],"localGraph":{"topicId":1161,"topics":[{"id":335,"name":"Calculating the Position Function of a Particle Using Integration","prerequisites":[1161]},{"id":595,"name":"Integration by Inverse Substitution","prerequisites":[1161]},{"id":1159,"name":"Calculating Definite Integrals Using Substitution","prerequisites":[],"frontier":0,"halfLife":60.87995495553585,"repetition":5,"stability":0.7393403816606737},{"id":1161,"name":"Integrating Logarithmic Functions Using Substitution","prerequisites":[1159],"frontier":0,"halfLife":2.064759609255872,"repetition":2,"stability":0.21317064795629145},{"id":1992,"name":"Double Integrals Over Rectangular Domains","prerequisites":[1161],"frontier":0,"halfLife":5.8173694240599,"repetition":2,"stability":0.314602777198726},{"id":2100,"name":"Orthogonal Vectors in Inner Product Spaces","prerequisites":[1161]}]}}}