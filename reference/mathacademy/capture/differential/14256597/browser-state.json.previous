lass=\"NONE\">⁡</mo><mn>7</mn></mrow><mn>2</mn></mfrac></mstyle><mo>⋅</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><msup><mi>u</mi><mn>2</mn></msup><mn>2</mn></mfrac></mstyle><mo>+</mo><mi>C</mi></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mi>ln</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mn>7</mn></mrow><mn>4</mn></mfrac></mstyle><mo>⋅</mo><msubsup><mi>log</mi><mn>7</mn><mn>2</mn></msubsup><mo data-mjx-texclass=\"NONE\">⁡</mo><mrow data-mjx-texclass=\"ORD\"><mi>x</mi></mrow><mo>+</mo><mi>C</mi></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
