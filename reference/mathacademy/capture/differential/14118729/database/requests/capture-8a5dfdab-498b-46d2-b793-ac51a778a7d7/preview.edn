7592186045417 true] [17592186414030 1075 #edb/ref 17592186414022 13194139534208 17592186045417 true] [17592186414030 1075 #edb/ref 17592186414023 13194139534208 17592186045417 true] [17592186414030 1075 #edb/ref 17592186414025 13194139534208 17592186045417 true] [17592186414030 1075 #edb/ref 17592186414026 13194139534208 17592186045417 true] [17592186414030 1076 #edb/ref 17592186045493 13194139534208 17592186045417 true] [17592186414030 1077 "selection" 13194139534208 17592186045417 true] [17592186414030 1078 #edb/ref 17592186414023 13194139534208 17592186045417 true] [17592186414030 1079 #uuid "8fa000c8-106a-5c36-ab34-ed3791f10731" 13194139534208 17592186045417 true] [17592186414031 1068 #edb/ref 17592186414030 13194139534208 17592186045417 true] [17592186414031 1069 "q-73593" 13194139534208 17592186045417 true] [17592186414031 1070 #edb/ref 17592186045486 13194139534208 17592186045417 true] [17592186414031 1071 "Consider the system of linear equations\n\n$$\n{\\begin{aligned} & x+6y-3z=-1 \\\\  & -2x-12y+8z=1 \\\\  & -x-5y+4z=2.\\end{aligned}\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form." 13194139534208 17592186045417 true] [17592186414031 1072 #uuid "db1a0a35-4ef3-5f5a-8985-ee685a957f6e" 13194139534208 17592186045417 true] [17592186414031 1074 "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}1 & 6 & -3 & -1 \\\\ -2 & -12 & 8 & 1 \\\\ -1 & -5 & 4 & 2\\end{aligned}].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}1 & 6 & -3 & -1 \\\\ -2 & -12 & 8 & 1 \\\\ -1 & -5 & 4 & 2\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 6 & -3 & -1 \\\\ 0 & 0 & 2 & -1 \\\\ -1 & -5 & 4 & 2\\end{aligned}] & {R}_{3} & :={R}_{3}+{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 6 & -3 & -1 \\\\ 0 & 0 & 2 & -1 \\\\ 0 & 1 & 1 & 1\\end{aligned}].\\end{aligned}\n$$\n\nNote that we get ${a}_{22}=0.$ Therefore, we swap the $2$nd and $3$rd rows:\n\n$$\n\\begin{aligned} & ∼[\\begin{aligned}1 & 6 & -3 & -1 \\\\ 0 & 0 & 2 & -1 \\\\ 0 & 1 & 1 & 1\\end{aligned}] & {R}_{2} & ↔{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 6 & -3 & -1 \\\\ 0 & 1 & 1 & 1 \\\\ 0 & 0 & 2 & -1\\end{aligned}]\\end{aligned}\n$$\n\nFinally, we multiply the $3$rd row by $\\frac{1}{2}$ to get\n\n$$\n\\begin{aligned} & ∼[\\begin{aligned}1 & 6 & -3 & -1 \\\\ 0 & 1 & 1 & 1 \\\\ 0 & 0 & 2 & -1\\end{aligned}] & {R}_{3} & :=\\frac{1}{2}{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 6 & -3 & -1 \\\\ 0 & 1 & 1 & 1 \\\\ 0 & 0 & 1 & -\\frac{1}{2}\\end{aligned}].\\end{aligned}\n$$" 13194139534208 17592186045417 true]] :edb/tempids {"answer-1111935c-e645-5bcc-9a24-5310e4abf00c" 17592186414019 "answer-2af7fa69-5175-5f82-abdc-7a83d1c7437a" 17592186414020 "answer-3faa2fb1-77d5-521f-acea-30296fef736c" 17592186414021 "answer-48cbaac4-0396-5dd0-87a0-2f04eaf0760f" 17592186414022 "answer-70ebcddf-aad2-5d94-849a-ae1ae9ab9ed7" 17592186414023 "answer-797daa95-425d-5598-93a6-9f8e22458433" 17592186414024 "answer-8b765cfb-d1ea-559d-a6ff-8457bb546f81" 17592186414025 "answer-979ac4ef-5db7-5cde-816c-7fb542951f8b" 17592186414026 "answer-a48bd680-d71c-5a27-9b6b-4fee3480952d" 17592186414027 "answer-c64960b9-232a-5479-96de-e63c3bb0d15f" 17592186414028 "answer-field-145fd237-737e-5055-9883-501b0228a34c" 17592186414029 "answer-field-8fa000c8-106a-5c36-ab34-ed3791f10731" 17592186414030 "question-db1a0a35-4ef3-5f5a-8985-ee685a957f6e" 17592186414031} :edb/committed false :edb/speculative true}
