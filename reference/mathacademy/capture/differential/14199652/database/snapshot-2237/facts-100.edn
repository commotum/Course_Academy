17] [17592186424176 #edb/ref 1078 #edb/ref 17592186424154 #edb/ref 17592186045417] [17592186424176 #edb/ref 1079 #uuid "d0a37030-5cd9-5e43-a291-e19dfc94c67f" #edb/ref 17592186045417] [17592186424177 #edb/ref 1075 #edb/ref 17592186424165 #edb/ref 17592186045417] [17592186424177 #edb/ref 1075 #edb/ref 17592186424166 #edb/ref 17592186045417] [17592186424177 #edb/ref 1075 #edb/ref 17592186424167 #edb/ref 17592186045417] [17592186424177 #edb/ref 1075 #edb/ref 17592186424170 #edb/ref 17592186045417] [17592186424177 #edb/ref 1075 #edb/ref 17592186424172 #edb/ref 17592186045417] [17592186424177 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186424177 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186424177 #edb/ref 1078 #edb/ref 17592186424165 #edb/ref 17592186045417] [17592186424177 #edb/ref 1079 #uuid "f602c505-c9b2-58a6-873a-3101dc02439a" #edb/ref 17592186045417] [17592186424181 #edb/ref 1068 #edb/ref 17592186424177 #edb/ref 17592186045417] [17592186424181 #edb/ref 1069 "q-161808" #edb/ref 17592186045417] [17592186424181 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186424181 #edb/ref 1071 "Consider the transformation $T:(u,v,w)\\to (x(u,v,w),y(u,v,w),z(u,v,w)).$ The inverse transformation ${T}^{-1}(x,y,z)\\to (u(x,y,z),v(x,y,z),w(x,y,z))$ is given by\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}⟶\\begin{bmatrix}\\frac{z}{y} \\\\ y \\\\ xz\\end{bmatrix}.\n$$\n\nFind the Jacobian determinant of $T.$\n\n*Hint: You can assume that $y,z\\ne 0.$*" #edb/ref 17592186045443] [17592186424181 #edb/ref 1072 #uuid "bbf87425-cede-5e7e-870f-278bd2b11904" #edb/ref 17592186045417] [17592186424181 #edb/ref 1074 "For a transformation \n\n$$\nT:\\begin{bmatrix}u \\\\ v \\\\ w\\end{bmatrix}\\to \\begin{bmatrix}x(u,v,w) \\\\ y(u,v,w) \\\\ z(u,v,w)\\end{bmatrix},\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y,z)}{∂(u,v,w)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} & \\frac{∂x}{∂w} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v} & \\frac{∂y}{∂w} \\\\ \\frac{∂z}{∂u} & \\frac{∂z}{∂v} & \\frac{∂z}{∂w}\\end{vmatrix}.\\end{aligned}\n$$\n\nIn this case, we're only given ${T}^{-1}.$ So, we compute the Jacobian determinant of $T$ as follows:\n\n- First, we compute $\\frac{∂(u,v,w)}{∂(x,y,z)},$ the Jacobian determinant of ${T}^{-1}.$\n\n- Then, we will compute the Jacobian determinant of $T$ using the relation\n\n$$\n\\frac{∂(x,y,z)}{∂(u,v,w)}={(\\frac{∂(u,v,w)}{∂(x,y,z)})}^{-1}.\n$$\n\nHere, we have \n\n$$\nu(x,y,z)=\\frac{z}{y},\\,v(x,y,z)=y,\\,w(x,y,z)=xz.\n$$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂u}{∂x} & =0 & \\,\\frac{∂u}{∂y} & =-\\frac{z}{{y}^{2}} & \\,\\frac{∂u}{∂z} & =\\frac{1}{y} \\\\ \\frac{∂v}{∂x} & =0 & \\,\\frac{∂v}{∂y} & =1 & \\,\\frac{∂v}{∂z} & =0 \\\\ \\frac{∂w}{∂x} & =z & \\,\\frac{∂w}{∂y} & =0 & \\,\\frac{∂w}{∂z} & =x\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant of ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v,w)}{∂(x,y,z)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} & \\frac{∂u}{∂z} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y} & \\frac{∂v}{∂z} \\\\ \\frac{∂w}{∂x} & \\frac{∂w}{∂y} & \\frac{∂w}{∂z}\\end{vmatrix} \\\\  & =\\begin{vmatrix}0 & -\\frac{z}{{y}^{2}} & \\frac{1}{y} \\\\ 0 & 1 & 0 \\\\ z & 0 & x\\end{vmatrix} \\\\  & =z\\begin{vmatrix}-\\frac{z}{{y}^{2}} & \\frac{1}{y} \\\\ 1 & 0\\end{vmatrix} \\\\  & =z(0-\\frac{1}{y}) \\\\  & =-\\frac{z}{y}.\\end{aligned}\n$$\n\nWriting down $\\frac{∂(u,v,w)}{∂(x,y,z)}$ in terms of $u,$ $v,$ and $w,$ we obtain\n\n$$\n\\begin{aligned}-\\frac{z}{y} & =-u.\\end{aligned}\n$$\n\nFinally, we take the reciprocal:\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & ={(\\frac{∂(u,v,w)}{∂(x,y,z)})}^{-1} \\\\  & =\\frac{1}{(-u)} \\\\  & =-\\frac{1}{u}\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186428570 #edb/ref 1030 0.6666666666666666 #edb/ref 17592186045436] [17592186428570 #edb/ref 1032 "Initi