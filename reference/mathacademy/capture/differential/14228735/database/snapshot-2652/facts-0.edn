1b5a" #edb/ref 17592186045417] [17592186353411 #edb/ref 1080 "${f}_{min}=2$ and ${f}_{max}=7$" #edb/ref 17592186045417] [17592186353411 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186353411 #edb/ref 1083 #uuid "d4beecad-5b8a-50ab-b3aa-c19725a94642" #edb/ref 17592186045417] [17592186353526 #edb/ref 1080 "2\\sqrt{e}" #edb/ref 17592186045417] [17592186353526 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186353526 #edb/ref 1083 #uuid "e1bb70c0-87ec-593e-850c-1115f0e6beea" #edb/ref 17592186045417] [17592186353598 #edb/ref 1080 "${f}_{min}=-1$ and ${f}_{max}=7$" #edb/ref 17592186045417] [17592186353598 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186353598 #edb/ref 1083 #uuid "e95fd2c0-5b91-5181-bf86-2c14f39b7349" #edb/ref 17592186045417] [17592186353887 #edb/ref 1075 #edb/ref 17592186352805 #edb/ref 17592186045417] [17592186353887 #edb/ref 1075 #edb/ref 17592186352855 #edb/ref 17592186045417] [17592186353887 #edb/ref 1075 #edb/ref 17592186352863 #edb/ref 17592186045417] [17592186353887 #edb/ref 1075 #edb/ref 17592186353411 #edb/ref 17592186045417] [17592186353887 #edb/ref 1075 #edb/ref 17592186353598 #edb/ref 17592186045417] [17592186353887 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186353887 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186353887 #edb/ref 1078 #edb/ref 17592186352855 #edb/ref 17592186045417] [17592186353887 #edb/ref 1079 #uuid "2b1b2db2-672f-587c-8384-08bd0b27587d" #edb/ref 17592186045417] [17592186354068 #edb/ref 1075 #edb/ref 17592186351746 #edb/ref 17592186045417] [17592186354068 #edb/ref 1075 #edb/ref 17592186351960 #edb/ref 17592186045417] [17592186354068 #edb/ref 1075 #edb/ref 17592186352924 #edb/ref 17592186045417] [17592186354068 #edb/ref 1075 #edb/ref 17592186353362 #edb/ref 17592186045417] [17592186354068 #edb/ref 1075 #edb/ref 17592186353526 #edb/ref 17592186045417] [17592186354068 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186354068 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186354068 #edb/ref 1078 #edb/ref 17592186351746 #edb/ref 17592186045417] [17592186354068 #edb/ref 1079 #uuid "8bd8154f-1898-5372-9fda-b77df68be7d1" #edb/ref 17592186045417] [17592186354504 #edb/ref 1068 #edb/ref 17592186353887 #edb/ref 17592186045417] [17592186354504 #edb/ref 1069 "q-86723" #edb/ref 17592186045417] [17592186354504 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186354504 #edb/ref 1071 "Find the global extrema of the function $f(x,y)={x}^{2}+{y}^{2}-2x-1$ on the closed region $D=\\{(x,y)\\,:\\,{x}^{2}+{y}^{2}\\le 4\\}.$ You are given that the function has a critical point at $(1,0)\\in D.$" #edb/ref 17592186045417] [17592186354504 #edb/ref 1072 #uuid "6872646b-2fa0-5569-8460-8a72ff9bd7ec" #edb/ref 17592186045417] [17592186354504 #edb/ref 1074 "Since $f(x,y)$ is continuous on the closed, bounded region $D,$ the function attains a global maximum and minimum on $D.$\n\nTo find the extreme values, we follow three steps.\n\n**Step 1.** Find the critical points of $f$ that lie inside the region $D.$ \n\nWe have been given that $f$ has a critical point at \n\n$\\,$ $(1,0)$ \n\nwhich belongs to the interior of the region $D.$ So, we include this point in the list of candidates for the extrema. \n\n**Step 2.**  Find the points on the boundary of $D$ that could give rise to extreme values. \n\nTo find the boundary points that could give rise to extreme values, we parametrize the bounding circle ${x}^{2}+{y}^{2}=4.$ This gives\n\n$$\nr=⟨2\\operatorname{cos}⁡t,2\\operatorname{sin}⁡t⟩,\\,t\\in [0,2\\pi ).\n$$\n\nThe values of $f$ on the boundary are given by the function\n\n$$\n\\begin{aligned}F(t) & =f(x(t),y(t)) \\\\  & =f(2\\operatorname{cos}⁡t,2\\operatorname{sin}⁡t) \\\\  & =(2\\operatorname{cos}⁡t)^{2}+(2\\operatorname{sin}⁡t)^{2}-2(2\\operatorname{cos}⁡t)-1 \\\\  & =4{cos}^{2}⁡t+4{sin}^{2}⁡t-4\\operatorname{cos}⁡t-1 \\\\  & =3-4\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nTo find the critical points of $F(t)$ on the open interval $t\\in (0,2\\pi ),$ we solve the following equation:\n\n$$\n\\begin{aligned}{F}^{′}(t) & =0 \\\\ (3-4\\operatorname{cos}⁡t)^{′} & =0 \\\\ 4\\operatorname{sin}⁡t & =0 \\\\ \\operatorname{sin}⁡t & =0\\end{aligned}\n$$\n\nThis equation gives one solution $t=\\pi \\in (0,2\\pi ).$\nWe also have to check the endpoint of the interval $t=0.$ Therefore, the only values of $t$ that can possibly give rise to extreme values are $t=0,\\,\\pi .$ Evaluating the corresponding values of $x$ and $y$ on the boundary, we obtain two candidate points:\n\n$$\n(2,0),\\,(-2,0)\n$$\n\n**Step 3.** Evaluate $f(x,y)$ at each of the candidate points, and compare their values.\n\nLet's compare the values of $f(x,y)$ evaluated at each of the points mentioned above. \n\n$$\n\\begin{aligned}f(1,0) & =(1)^{2}+(0)^{2}-2(1)-1 \\\\  & =1+0-2-1 \\\\  & =-2 \\\\ f(2,0) & =(2)^{2}+(0)^{2}-2(2)-1 \\\\  & =4+0-4-1 \\\\  & =-1 \\\\ f(-2,0) & =(-2)^{2}+(0)^{2}-2(-2)-1 \\\\  & =4+0+4-1 \\\\  & =7\\end{aligned}\n$$\n\nTherefore, on the closed region $D,$ we have that \n\n- $f$ attains the global minimum of $-2$ at the point $(1,0),$ and\n\n- $f$ attains the global maximum of $7$ at the point $(-2,0).$" #edb/ref 17592186045417] [17592186354505 #edb/ref 1068 #edb/ref 17592186354068 #edb/ref 17592186045417] [17592186354505 #edb/ref 1069 "q-86725" #edb/ref 17592186045417] [17592186354505 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186354505 #edb/ref 1071 "Find the global maximum of the function $f(x,y)=2{e}^{xy-x}$ on the closed triangular region  $D=\\{(x,y)\\,:\\,0\\le x\\le 2,\\,0\\le y\\le 2-x\\}.$ You're given that $f$ has a critical point at $(0,1)$ and on the boundary of the triangle the points that could give rise to extreme values are the vertices and the point $(\\frac{1}{2},\\frac{3}{2}).$" #edb/ref 17592186045417] [17592186354505 #edb/ref 1072 #uuid "9e5511a5-af5b-54bb-a9ab-113418cf34fa" #edb/ref 17592186045417] [17592186354505 #edb/ref 1074 "Since $f(x,y)$ is continuous on the closed, bounded region $D,$ the function attains a global maximum and minimum on $D.$\n\nTo find the extreme values, we follow three steps.\n\n**Step 1.** Find the critical points of $f$ that lie inside the region $D.$ \n\nTo determine the critical points, let's first sketch the region:\n\n![](images/42/42b9bcda74e29cf7012fd9576ee7bcea92bfc3f58fab4c43c854892afe3acc44.png)\n\n \n\nSince the point $(0,1)$ does not belong to the interior of $D$, we do not yet include it in the list of candidates for extrema (it lies on the boundary of $D,$ so we will consider it in the next step).\n\n**Step 2.** Find the points on the boundary that could give rise to extreme values. \n\nIn this case, we are *given* the points on the boundary of our region that could potentially be global extrema for $f.$ These are\n\n$$\n(0,0),\\,(2,0),\\,(0,1),\\,(0,2),\\,(\\frac{1}{2},\\frac{3}{2})\n$$\n\n**Step 3.** Evaluate $f(x,y)$ at each of the candidate points, and compare their values. \n\nEvaluating $f(x,y)$ at each of the points mentioned above, we get the following: \n\n$$\n\\begin{aligned}f(0,0) & =2{e}^{(0)(0)-(0)} \\\\  & =2 \\\\ f(2,0) & =2{e}^{(2)(0)-(2)} \\\\  & =2{e}^{-2} \\\\ f(0,1) & =2{e}^{(0)(1)-(0)} \\\\  & =2 \\\\ f(0,2) & =2{e}^{(0)(2)-(0)} \\\\  & =2 \\\\ f(\\frac{1}{2},\\frac{3}{2}) & =2{e}^{(1/2)(3/2)-(1/2)} \\\\  & =2\\sqrt[4]{e}.\\end{aligned}\n$$\n\n \n\nTherefore, on the closed region $D,$ we have that \n\n- $f$ attains the global minimum of $2{e}^{-2}$ at the point $(2,0),$ and\n\n- $f$ attains the global maximum of $2\\sqrt[4]{e}$ at the point $(\\frac{1}{2},\\frac{3}{2}).$" #edb/ref 17592186045417] [17592186363542 #edb/ref 1075 #edb/ref 17592186363543 #edb/ref 17592186045417] [17592186363542 #edb/ref 1075 #edb/ref 17592186363544 #edb/ref 17592186045417] [17592186363542 #edb/ref 1075 #edb/ref 17592186363545 #edb/ref 17592186045417] [17592186363542 #edb/ref 1075 #edb/ref 17592186363546 #edb/ref 17592186045417] [17592186363542 #edb/ref 1075 #edb/ref 17592186363547 #edb/ref 17592186045417] [17592186363542 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186363542 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186363542 #edb/ref 1078 #edb/ref 17592186363545 #edb/ref 17592186045417] [17592186363542 #edb/ref 1079 #uuid "ab3adac3-45ef-501d-ba44-cfa5be5274bd" #edb/ref 17592186045417] [17592186363543 #edb/ref 1080 "${f}_{min}=-\\sqrt{3}$ and ${f}_{max}=\\sqrt{3}$" #edb/ref 17592186045417] [17592186363543 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186363543 #edb/ref 1083 #uuid "3a620cea-c724-5cd1-81af-543f3d2c51dd" #edb/ref 17592186045417] [17592186363544 #edb/ref 1080 "${f}_{min}=3-2\\sqrt{3}$ and ${f}_{max}=3+2\\sqrt{3}$" #edb/ref 17592186045417] [17592186363544 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186363544 #edb/ref 1083 #uuid "2e0d1a43-6f8b-5644-93e8-16948f17dafa" #edb/ref 17592186045417] [17592186363545 #edb/ref 1080 "${f}_{min}=-1$ and ${f}_{max}=3+2\\sqrt{3}$" #edb/ref 17592186045417] [17592186363545 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186363545 #edb/ref 1083 #uuid "81a5b1aa-671f-52ad-9681-35461c2b2509" #edb/ref 17592186045417] [17592186363546 #edb/ref 1080 "${f}_{min}=-1$ and ${f}_{max}=3$" #edb/ref 17592186045417] [17592186363546 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186363546 #edb/ref 1083 #uuid "ddc0f0b2-6ebe-53e9-96ad-e380f02b0b9f" #edb/ref 17592186045417] [17592186363547 #edb/ref 1080 "${f}_{min}=0$ and ${f}_{max}=1$" #edb/ref 17592186045417] [17592186363547 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186363547 #edb/ref 1083 #uuid "eb7e87b5-ff70-5a36-ac7c-77dc99ac2caf" #edb/ref 17592186045417] [17592186364119 #edb/ref 1075 #edb/ref 17592186364120 #edb/ref 17592186045417] [17592186364119 #edb/ref 1075 #edb/ref 17592186364121 #edb/ref 17592186045417] [17592186364119 #edb/ref 1075 #edb/ref 17592186364122 #edb/ref 17592186045417] [17592186364119 #edb/ref 1075 #edb/ref 17592186364123 #edb/ref 17592186045417] [17592186364119 #edb/ref 1075 #edb/ref 17592186364124 #edb/ref 17592186045417] [17592186364119 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186364119 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186364119 #edb/ref 1078 #edb/ref 17592186364120 #edb/ref 17592186045417] [17592186364119 #edb/ref 1079 #uuid "c14f92ef-8118-5f37-a5c2-1ab0743079ba" #edb/ref 17592186045417] [17592186364120 #edb/ref 1080 "\\frac{1}{8}" #edb/ref 17592186045417] [17592186364120 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186364120 #edb/ref 1083 #uuid "a592c81b-9507-5ed5-a235-ff674898a3b1" #edb/ref 17592186045417] [17592186364121 #edb/ref 1080 "1" #edb/ref 17592186045417] [17592186364121 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186364121 #edb/ref 1083 #uuid "a8068d75-9b98-5356-b9c0-4a94d1f35bd1" #edb/ref 17592186045417] [17592186364122 #edb/ref 1080 "0" #edb/ref 17592186045417] [17592186364122 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186364122 #edb/ref 1083 #uuid "cbecbf4e-e9a3-5727-8ec5-378c5c30e8ee" #edb/ref 17592186045417] [17592186364123 #edb/ref 1080 "-\\frac{1}{4}" #edb/ref 17592186045417] [17592186364123 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186364123 #edb/ref 1083 #uuid "f2586639-5408-5c55-83c6-8d828bb66e2f" #edb/ref 17592186045417] [17592186364124 #edb/ref 1080 "-1" #edb/ref 17592186045417] [17592186364124 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186364124 #edb/ref 1083 #uuid "694e1e22-50cc-5d90-8e40-929f98d3e8b7" #edb/ref 17592186045417] [17592186399180 #edb/ref 1068 #edb/ref 17592186399181 #edb/ref 17592186045417] [17592186399180 #edb/ref 1069 "q-83477" #edb/ref 17592186045417] [17592186399180 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186399180 #edb/ref 1071 "Find the global maximum of the function $f(x,y)=xy-x-y$ on the closed triangular region $D$ with vertices $(0,0),\\,(2,0),\\,(0,2).$" #edb/ref 17592186045417] [17592186399180 #edb/ref 1072 #uuid "97e3e680-a9e7-597f-a877-a0daf5245a87" #edb/ref 17592186045417] [17592186399180 #edb/ref 1074 "Since $f(x,y)$ is continuous on the closed, bounded region $D,$ the function attains a global maximum and minimum on $D.$\n\nTo find the extreme values, we follow three steps.\n\n**Step 1.** Find the critical points of $f$ inside the region. \n\nTo determine the critical points, we solve ${f}^{′}=0.$ Computing the derivative gives\n\n$$\n{f}^{′}(x,y)=\\begin{bmatrix}y-1,\\,x-1\\end{bmatrix}.\n$$\n\nThe derivative exists at each point inside $D,$ and it equals zero when\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}y-1 &=0 \\\\ x-1 &=0\\end{aligned}\\right.\\,⟹\\,\\left\\{\\begin{aligned}x &=1 \\\\ y &=1.\\end{aligned}\\right.\\end{aligned}\n$$\n\nThis gives us a single point $(1,1).$ Since the point $(1,1)$ is not in the interior of $D$,  we do not yet include it in the list of candidates for extrema (it lies on the line $y=2-x,$ in the boundary of $D,$ so we will consider it in the next step).\n\n**Step 2.**  Find the points on the boundary of $D$ that could give rise to extreme values. \n\nTo find the points on the boundary that could give rise to extreme values, we parametrize each part of the boundary:\n\n- The line connecting $(0,0)$ and $(2,0)$ can be parametrized as\n\n$$\nr=⟨t,0⟩,\\,t\\in (0,2).\n$$\n\nThe values of $f$ on the boundary are given by the function\n\n$$\n\\begin{aligned}F(t) & =f(x(t),y(t)) \\\\  & =f(t,0) \\\\  & =(t)(0)-(t)-(0) \\\\  & =-t.\\end{aligned}\n$$\n\nNotice that the derivative of $F(t)$ is constant. So, $F(t)$ does not have critical points on the open interval $t\\in (0,1).$\n\n- The line connecting $(0,0)$ and $(0,2)$ can be parametrized as\n\n$$\nr=⟨0,t⟩,\\,t\\in (0,2).\n$$\n\nThe values of $f$ on the boundary are given by the function\n\n$$\n\\begin{aligned}F(t) & =f(x(t),y(t)) \\\\  & =f(0,t) \\\\  & =(0)(t)-(0)-(t) \\\\  & =-t.\\end{aligned}\n$$\n\nNotice that the derivative of $F(t)$ is constant. So, $F(t)$ does not have critical points on the open interval $t\\in (0,2).$\n\n- The line connecting $(2,0)$ and $(0,2)$ can be parametrized as\n\n$$\n\\begin{aligned}r & =⟨2,0⟩+t(⟨0,2⟩-⟨2,0⟩) \\\\  & =⟨2,0⟩+t⟨-2,2⟩ \\\\  & =⟨2-2t,2t⟩,\\,t\\in (0,1).\\end{aligned}\n$$\n\nThe values of $f$ on the boundary are given by the function\n\n$$\n\\begin{aligned}F(t) & =f(x(t),y(t)) \\\\  & =f(2-2t,2t) \\\\  & =(2-2t)(2t)-(2-2t)-(2t) \\\\  & =-4{t}^{2}+4t-2.\\end{aligned}\n$$\n\nTo find the critical points of $F(t)$ on the open interval $t\\in (0,1),$ we solve the following equation:\n\n$$\n\\begin{aligned}{F}^{′}(t) & =0 \\\\ (-4{t}^{2}+4t-2)^{′} & =0 \\\\ -8t+4 & =0 \\\\ t & =\\frac{1}{2}\\end{aligned}\n$$\n\nThis equation gives one solution. Evaluating the corresponding values of $x$ and $y$ on the boundary, we obtain the candidate point $(1,1).$\n\nAlso, we have to include the corner points of the region as candidates for extrema. So, in total we obtain four candidates:\n\n$$\n(0,0),\\,(2,0),\\,(0,2),\\,(1,1)\n$$\n\n**Step 3.** Evaluate $f(x,y)$ at each of the candidate points, and compare their values. \n\nEvaluating $f(x,y)$ at each of the points mentioned above, we get the following: \n\n| $(x,y)$ | $(0,0)$ | $(2,0)$ | $(0,2)$ | $(1,1)$ |\n| --- | --- | --- | --- | --- |\n| $f(x,y)$ | $0$ | $-2$ | $-2$ | $-1$ |\n\nTherefore, on the closed region $D,$ we have that \n\n- $f$ attains the global minimum of $-2$ at the points $(2,0),\\,(0,2),$ and\n\n- $f$ attains the global maximum of $0$ at the point $(0,0).$" #edb/ref 17592186045443] [17592186399181 #edb/ref 1075 #edb/ref 17592186399182 #edb/ref 17592186045417] [17592186399181 #edb/ref 1075 #edb/ref 17592186399183 #edb/ref 17592186045417] [17592186399181 #edb/ref 1075 #edb/ref 17592186399184 #edb/ref 17592186045417] [17592186399181 #edb/ref 1075 #edb/ref 17592186399185 #edb/ref 17592186045417] [17592186399181 #edb/ref 1075 #edb/ref 17592186399186 #edb/ref 17592186045417] [17592186399181 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186399181 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186399181 #edb/ref 1078 #edb/ref 17592186399185 #edb/ref 17592186045417] [17592186399181 #edb/ref 1079 #uuid "249bd719-2909-5d27-a78e-0ce0dd0aaab3" #edb/ref 17592186045417] [17592186399182 #edb/ref 1080 "3" #edb/ref 17592186045417] [17592186399182 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186399182 #edb/ref 1083 #uuid "37d0fe1a-19ca-5f80-a487-821d0d2f05da" #edb/ref 17592186045417]}
