0-5ff2-8042-b2bbeeac6f6d" #edb/ref 17592186045417] [17592186547608 #edb/ref 1080 "\\frac{2}{3}" #edb/ref 17592186045417] [17592186547608 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186547608 #edb/ref 1083 #uuid "8782a4d4-81e3-5eb0-85bd-15bc8474d851" #edb/ref 17592186045417] [17592186547617 #edb/ref 1080 "\\frac{1}{2}" #edb/ref 17592186045417] [17592186547617 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186547617 #edb/ref 1083 #uuid "8a6fa4fc-9ef6-5b97-80a9-85f5119427ad" #edb/ref 17592186045417] [17592186547902 #edb/ref 1075 #edb/ref 17592186547479 #edb/ref 17592186045417] [17592186547902 #edb/ref 1075 #edb/ref 17592186547516 #edb/ref 17592186045417] [17592186547902 #edb/ref 1075 #edb/ref 17592186547569 #edb/ref 17592186045417] [17592186547902 #edb/ref 1075 #edb/ref 17592186547608 #edb/ref 17592186045417] [17592186547902 #edb/ref 1075 #edb/ref 17592186547617 #edb/ref 17592186045417] [17592186547902 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186547902 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186547902 #edb/ref 1078 #edb/ref 17592186547608 #edb/ref 17592186045417] [17592186547902 #edb/ref 1079 #uuid "76f810c9-6c36-550e-ba2c-f211b1f812da" #edb/ref 17592186045417] [17592186548000 #edb/ref 1068 #edb/ref 17592186547902 #edb/ref 17592186045417] [17592186548000 #edb/ref 1069 "q-149608" #edb/ref 17592186045417] [17592186548000 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186548000 #edb/ref 1071 "Let $X$ and $Y$ be two continuous random variables with the joint probability density function\n\n$$\nf(x,y)=\\{\\begin{aligned}2y\\operatorname{cos}⁡x, & \\,0\\le x\\le \\frac{\\pi }{2},\\,0\\le y\\le 1, \\\\ 0, & \\,\\text{otherwise}.\\end{aligned}\n$$\n\nFind the expected value of $Y.$" #edb/ref 17592186045417] [17592186548000 #edb/ref 1072 #uuid "4bc6d1d2-09ee-5cec-a2ab-850e837a407d" #edb/ref 17592186045417] [17592186548000 #edb/ref 1074 "The marginal density function for $Y$ when $0\\le y\\le 1$ is \n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /2}2y\\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =2y[\\operatorname{sin}⁡x]_{0}^{\\pi /2} \\\\  & =2y(\\operatorname{sin}⁡(\\frac{\\pi }{2})-\\operatorname{sin}⁡0) \\\\  & =2y(1-0) \\\\  & =2y.\\end{aligned}\n$$\n\nTherefore, the full expression for ${f}_{X}(x)$ is given by\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}2y, & 0\\le y\\le 1, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nFinally, the  expected value of $Y$ is \n\n$$\n\\begin{aligned}\\text{E}[Y] & ={\\int }_{-\\infty }^{\\infty }y\\cdot {f}_{Y}(y)\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}y\\cdot 2y\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}2{y}^{2}\\,\\text{d}y \\\\  & ={[\\frac{2}{3}{y}^{3}]}_{0}^{1} \\\\  & =(\\frac{2}{3}-0) \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186548099 #edb/ref 1058 #edb/ref 17592186548158 #edb/ref 17592186045417] [17592186548099 #edb/ref 1062 #uuid "4ce4190d-1d21-5630-a29f-46308c8bbae8" #edb/ref 17592186045417] [17592186548099 #edb/ref 1063 #edb/ref 17592186548000 #edb/ref 17592186045417] [17592186548140 #edb/ref 1058 #edb/ref 17592186548099 #edb/ref 17592186045417] [17592186548140 #edb/ref 1062 #uuid "a050145b-b81a-5ea0-b826-8794dc7432ad" #edb/ref 17592186045417] [17592186548140 #edb/ref 1063 #edb/ref 17592186354508 #edb/ref 17592186045417] [17592186548148 #edb/ref 1058 #edb/ref 17592186548182 #edb/ref 17592186045417] [17592186548148 #edb/ref 1062 #uuid "b3060247-9451-5f27-bb96-ae517da19c00" #edb/ref 17592186045417] [17592186548148 #edb/ref 1063 #edb/ref 17592186243955 #edb/ref 17592186045417] [17592186548158 #edb/ref 1058 #edb/ref 17592186548148 #edb/ref 17592186045417] [17592186548158 #edb/ref 1062 #uuid "c61690f5-afb0-5f58-bca3-efbb4bd850bd" #edb/ref 17592186045417] [17592186548158 #edb/ref 1063 #edb/ref 17592186432018 #edb/ref 17592186045417] [17592186548182 #edb/ref 1062 #uuid "ec6e1d95-63bf-57b8-b46d-6b6