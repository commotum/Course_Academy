0 & 2 \\\\ 0 & 1 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 \\\\ 0 & 1 \\\\ 2 & 1\\end{bmatrix})}^{-1}\\cdot \\begin{bmatrix}1 & 0 & 2 \\\\ 0 & 1 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 \\\\ -3 \\\\ 5\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1 \\\\ 2 & 1\\end{bmatrix}\\cdot {\\begin{bmatrix}5 & 2 \\\\ 2 & 2\\end{bmatrix}}^{-1}\\cdot \\begin{bmatrix}11 \\\\ 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1 \\\\ 2 & 1\\end{bmatrix}\\cdot \\frac{1}{6}\\begin{bmatrix}2 & -2 \\\\ -2 & 5\\end{bmatrix}\\cdot \\begin{bmatrix}11 \\\\ 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1 \\\\ 2 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}3 \\\\ -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 \\\\ -2 \\\\ 4\\end{bmatrix}\\end{aligned}\n$$"} :step/id #uuid "81d27e89-104f-5902-93dd-75e684050d55" :step/next {:db/id #edb/ref 17592186504727}} {:db/id #edb/ref 17592186504732 :step/content {:db/id #edb/ref 17592186366111 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ce4106d4-3066-525e-9cc4-3cc62600cc77" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}4 \\\\ 2 \\\\ 6\\end{bmatrix}" :db/id #edb/ref 17592186366113} {:answer/id #uuid "30e731b8-e203-5d2a-b715-03aab570da25" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 \\\\ -2 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186366114} {:answer/id #uuid "c0ec102b-6380-5917-b3e8-96986912f2e4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-2 \\\\ -1 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186366115} {:answer/id #uuid "353ce806-e08a-585e-aedc-1f31c4ef4e92" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-2 \\\\ -2 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186366116} {:answer/id #uuid "88d5a945-073b-5c18-9a22-28e2025b07d3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}4 \\\\ 4 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186366117}] :answer-field/correct