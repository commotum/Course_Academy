17] [17592186280438 #edb/ref 1080 "II and III only" #edb/ref 17592186045417] [17592186280438 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186280438 #edb/ref 1083 #uuid "d1456bc7-eb62-5a81-b906-11f9d53e6ca1" #edb/ref 17592186045417] [17592186280548 #edb/ref 1080 "I, II, and III" #edb/ref 17592186045417] [17592186280548 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186280548 #edb/ref 1083 #uuid "dddcd65b-9ce6-50ce-9228-6bcf5cea7db0" #edb/ref 17592186045417] [17592186280593 #edb/ref 1080 "III only" #edb/ref 17592186045417] [17592186280593 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186280593 #edb/ref 1083 #uuid "e26ca2e7-67dd-5dc7-a4ef-404b70019c20" #edb/ref 17592186045417] [17592186280727 #edb/ref 1080 "I and II only" #edb/ref 17592186045417] [17592186280727 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186280727 #edb/ref 1083 #uuid "f3e1527a-7305-51ee-83a2-83652b17baf3" #edb/ref 17592186045417] [17592186280811 #edb/ref 1080 "III only" #edb/ref 17592186045417] [17592186280811 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186280811 #edb/ref 1083 #uuid "fdae77ea-1bc8-57fa-af15-b2b0fd2f630b" #edb/ref 17592186045417] [17592186280997 #edb/ref 1075 #edb/ref 17592186279375 #edb/ref 17592186045417] [17592186280997 #edb/ref 1075 #edb/ref 17592186279796 #edb/ref 17592186045417] [17592186280997 #edb/ref 1075 #edb/ref 17592186280189 #edb/ref 17592186045417] [17592186280997 #edb/ref 1075 #edb/ref 17592186280375 #edb/ref 17592186045417] [17592186280997 #edb/ref 1075 #edb/ref 17592186280811 #edb/ref 17592186045417] [17592186280997 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186280997 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186280997 #edb/ref 1078 #edb/ref 17592186280375 #edb/ref 17592186045417] [17592186280997 #edb/ref 1079 #uuid "5e076d65-0526-5a07-9c9b-b679b4af936f" #edb/ref 17592186045417] [17592186281114 #edb/ref 1075 #edb/ref 17592186278889 #edb/ref 17592186045417] [17592186281114 #edb/ref 1075 #edb/ref 17592186279000 #edb/ref 17592186045417] [17592186281114 #edb/ref 1075 #edb/ref 17592186279645 #edb/ref 17592186045417] [17592186281114 #edb/ref 1075 #edb/ref 17592186280548 #edb/ref 17592186045417] [17592186281114 #edb/ref 1075 #edb/ref 17592186280593 #edb/ref 17592186045417] [17592186281114 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186281114 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186281114 #edb/ref 1078 #edb/ref 17592186280548 #edb/ref 17592186045417] [17592186281114 #edb/ref 1079 #uuid "9eae0065-06b1-55e5-93fa-33a43fe9d0d3" #edb/ref 17592186045417] [17592186281254 #edb/ref 1075 #edb/ref 17592186278744 #edb/ref 17592186045417] [17592186281254 #edb/ref 1075 #edb/ref 17592186278946 #edb/ref 17592186045417] [17592186281254 #edb/ref 1075 #edb/ref 17592186279670 #edb/ref 17592186045417] [17592186281254 #edb/ref 1075 #edb/ref 17592186280438 #edb/ref 17592186045417] [17592186281254 #edb/ref 1075 #edb/ref 17592186280727 #edb/ref 17592186045417] [17592186281254 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186281254 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186281254 #edb/ref 1078 #edb/ref 17592186280438 #edb/ref 17592186045417] [17592186281254 #edb/ref 1079 #uuid "eccd1f91-0329-5827-8bc7-20841f3abdcb" #edb/ref 17592186045417] [17592186281463 #edb/ref 1068 #edb/ref 17592186281254 #edb/ref 17592186045417] [17592186281463 #edb/ref 1069 "q-162391" #edb/ref 17592186045417] [17592186281463 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186281463 #edb/ref 1071 "Let $S$ be the set of all $2\\times 2$ matrices with real entries and determinant different from $0.$ Which of the following statements are true?  \n\nI. The  matrix $[\\begin{aligned}2 & 2 \\\\ 1 & 1\\end{aligned}]$ belongs to $S.$\n\nII. For any $A\\in S,$ we can find the corresponding negative matrix $-A\\in S$ such that $A+(-A)=O.$\n\nIII. For any $A,B,C\\in S,$ we have $A+(B-C)=(A+B)-C.$" #edb/ref 17592186045417] [17592186281463 #edb/ref 1072 #uuid "f9060a6c-635e-5bea-91ee-1f014ee29783" #edb/ref 17592186045417] [17592186281463 #edb/ref 1074 "Let's examine each statement in turn.\n\n- Statement I is false. Indeed, we have\n\n$$\n|\\begin{aligned}2 & 2 \\\\ 1 & 1\\end{aligned}|=2\\cdot 1-2\\cdot 1=0.\n$$\n\n- Statement II is true. Indeed, for any $2\\times 2$ matrix $A$ with real entries,   there is a corresponding negative matrix $-A$ such that\n\n$$\nA+(-A)=A-A=O.\n$$\n\nNotice if $A\\in S$ then \n\n$$\n|-A|=|-1\\cdot A|=(-1)^{2}\\cdot |A|=1\\cdot |A|=|A|\\ne 0,\n$$\n\nhence $-A\\in S.$\n\n- Statement III is true. Indeed, for any matrices $A,B\\in S,$ we obtain that \n\n$$\nA+(B-C)=A+(B+(-C))=(A+B)+(-C)=(A+B)-C\n$$\n\nsince matrix addition is associative.\n\nTherefore, the correct answer is \"II and III only.\"" #edb/ref 17592186045417] [17592186281464 #edb/ref 1068 #edb/ref 17592186280997 #edb/ref 17592186045417] [17592186281464 #edb/ref 1069 "q-162392" #edb/ref 17592186045417] [17592186281464 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186281464 #edb/ref 1071 "Let $U$ be the set of polynomials of the form $a{x}^{3}+b{x}^{2},$ where $a,b\\in R.$ Which of the following statements are true?\n\nI. The zero-polynomial belongs to $U.$\n\nII. For any $p(x),q(x)\\in U,$ we have $p(x)-q(x)=q(x)-p(x).$\n\nIII. There are polynomials $p(x),q(x),r(x)\\in U$ such that $[p(x)+q(x)]+r(x)\\ne p(x)+[q(x)+r(x)].$" #edb/ref 17592186045417] [17592186281464 #edb/ref 1072 #uuid "5b2f6345-ac14-55a4-a687-5a14893fcf90" #edb/ref 17592186045417] [17592186281464 #edb/ref 1074 "Let's examine each statement in turn.\n\n- Statement I is true. Indeed, the zero-polynomial can be represented as \n\n$$\n0=0\\cdot {x}^{3}+0\\cdot {x}^{2}.\n$$\n\n \nHence, $0\\in U.$\n\n- Statement II is false. For example, consider the polynomials $p(x)={x}^{3}\\in U$ and the zero-polynomial $q(x)=0\\in U.$ Then \n\n$$\np(x)-q(x)=p(x)-0={x}^{3}\n$$\n\nwhile \n\n$$\nq(x)-p(x)=0-p(x)=-{x}^{3}\\ne {x}^{3}.\n$$\n\n- Statement III is false. For any polynomials $p(x),q(x)\\in U,$ we have \n\n$$\n[p(x)+q(x)]+r(x)=p(x)+[q(x)+r(x)],\n$$\n\nsince polynomial addition is associative.\n\nTherefore, the correct answer is \"I only.\"" #edb/ref 17592186045417] [17592186342360 #edb/ref 1080 "III only" #edb/ref 17592186045417] [17592186342360 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186342360 #edb/ref 1083 #uuid "0e69ab93-723d-5565-8b12-c9c9e92f4afe" #edb/ref 17592186045417] [17592186342444 #edb/ref 1080 "I, II, and III" #edb/ref 17592186045417] [17592186342444 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186342444 #edb/ref 1083 #uuid "1766df50-f341-5eb6-89ac-0097e98a3fc8" #edb/ref 17592186045417] [17592186343124 #edb/ref 1080 "I only" #edb/ref 17592186045417] [17592186343124 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186343124 #edb/ref 1083 #uuid "6815ad43-217d-52e9-a8da-0aa78e231e03" #edb/ref 17592186045417] [17592186344018 #edb/ref 1080 "I and II only" #edb/ref 17592186045417] [17592186344018 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186344018 #edb/ref 1083 #uuid "ca897927-fa4a-50ee-97a5-f96cb800a091" #edb/ref 17592186045417] [17592186344388 #edb/ref 1080 "II only" #edb/ref 17592186045417] [17592186344388 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186344388 #edb/ref 1083 #uuid "f42d0555-d3d6-510b-a3a2-94555e1c8df5" #edb/ref 17592186045417] [17592186344725 #edb/ref 1075 #edb/ref 17592186342360 #edb/ref 17592186045417] [17592186344725 #edb/ref 1075 #edb/ref 17592186342444 #edb/ref 17592186045417] [17592186344725 #edb/ref 1075 #edb/ref 17592186343124 #edb/ref 17592186045417] [17592186344725 #edb/ref 1075 #edb/ref 17592186344018 #edb/ref 17592186045417] [17592186344725 #edb/ref 1075 #edb/ref 17592186344388 #edb/ref 17592186045417] [17592186344725 #edb/ref 1076 #edb/ref 