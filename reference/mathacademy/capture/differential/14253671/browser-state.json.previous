</mn></msup><mo>+</mo><msup><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mo>−</mo><mn>6</mn><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mn>2</mn></msup></msqrt></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msqrt><mn>64</mn><mo>+</mo><mn>36</mn></msqrt></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msqrt><mn>100</mn></msqrt></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mn>10</mn></mpadded></mstyle><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
