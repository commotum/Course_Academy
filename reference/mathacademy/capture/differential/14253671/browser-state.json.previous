    "q-130389": {
      "dom_id": "step-q130389",
      "name": "Question 8",
      "problem": "Calculate ${f}^{′}(t)$ given that $f(t)=[\\begin{aligned}{e}^{t+1} \\\\ \\operatorname{cos}⁡t \\\\ \\sqrt{t}\\end{aligned}].$",
      "worked_solution": "We find ${f}^{′}(t)$ by differentiating each component:\n\n$$\n\\begin{aligned}{f}^{′}(t) & =[\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}({e}^{t+1}) \\\\ \\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t) \\\\ \\frac{\\text{d}}{\\text{d}t}(\\sqrt{t})\\end{aligned}]=[\\begin{aligned}{e}^{t+1} \\\\ -\\operatorname{sin}⁡t \\\\ \\frac{1}{2\\sqrt{t}}\\end{aligned}]\\end{aligned}\n$$",
      "calculator_instructions": "",
