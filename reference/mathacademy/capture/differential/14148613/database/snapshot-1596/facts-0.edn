b/ref 1041 #edb/ref 17592186128984 #edb/ref 17592186045417] [17592186129165 #edb/ref 1042 #uuid "d237f9fb-b5d2-53e0-bc28-ee50d9e08852" #edb/ref 17592186045417] [17592186129166 #edb/ref 1038 #edb/ref 17592186129843 #edb/ref 17592186045417] [17592186129166 #edb/ref 1038 #edb/ref 17592186129844 #edb/ref 17592186045417] [17592186129166 #edb/ref 1038 #edb/ref 17592186265759 #edb/ref 17592186045417] [17592186129166 #edb/ref 1038 #edb/ref 17592186265760 #edb/ref 17592186045417] [17592186129166 #edb/ref 1038 #edb/ref 17592186339061 #edb/ref 17592186045417] [17592186129166 #edb/ref 1038 #edb/ref 17592186339067 #edb/ref 17592186045417] [17592186129166 #edb/ref 1038 #edb/ref 17592186342027 #edb/ref 17592186045417] [17592186129166 #edb/ref 1038 #edb/ref 17592186382235 #edb/ref 17592186045417] [17592186129166 #edb/ref 1038 #edb/ref 17592186382277 #edb/ref 17592186045417] [17592186129166 #edb/ref 1038 #edb/ref 17592186442478 #edb/ref 17592186045417] [17592186129166 #edb/ref 1038 #edb/ref 17592186442482 #edb/ref 17592186045417] [17592186129166 #edb/ref 1039 "Changing the Order of Integration" #edb/ref 17592186045417] [17592186129166 #edb/ref 1041 #edb/ref 17592186128985 #edb/ref 17592186045417] [17592186129166 #edb/ref 1042 #uuid "d8f012d0-444a-5035-8a72-a053de312d63" #edb/ref 17592186045417] [17592186129338 #edb/ref 1043 #edb/ref 17592186130020 #edb/ref 17592186045417] [17592186129338 #edb/ref 1043 #edb/ref 17592186130021 #edb/ref 17592186045417] [17592186129338 #edb/ref 1043 #edb/ref 17592186130022 #edb/ref 17592186045417] [17592186129338 #edb/ref 1043 #edb/ref 17592186130029 #edb/ref 17592186045417] [17592186129338 #edb/ref 1043 #edb/ref 17592186130043 #edb/ref 17592186045417] [17592186129338 #edb/ref 1043 #edb/ref 17592186130110 #edb/ref 17592186045417] [17592186129338 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186129338 #edb/ref 1045 "Double Integrals Over Rectangular Domains" #edb/ref 17592186045417] [17592186129338 #edb/ref 1046 #edb/ref 17592186130043 #edb/ref 17592186045417] [17592186129338 #edb/ref 1049 #edb/ref 17592186050207 #edb/ref 17592186045417] [17592186129338 #edb/ref 1050 960.0 #edb/ref 17592186045417] [17592186129338 #edb/ref 1050 960.0 #edb/ref 17592186045436] [17592186129338 #edb/ref 1053 #uuid "7d9fbdd4-9840-5d87-ba9d-a1c1a46d9235" #edb/ref 17592186045417] [17592186129843 #edb/ref 1068 #edb/ref 17592186128539 #edb/ref 17592186045417] [17592186129843 #edb/ref 1069 "q-71930" #edb/ref 17592186045417] [17592186129843 #edb/ref 1071 "Which of the following equalities are true given that\n$D = {(x, y): 0 \\le x \\le 1, 1 \\le y \\le 3}$.\n\n1. $∬_(D)y\\sqrt{x}dA = \\displaystyle \\int_{0}^{1}\\displaystyle \\int_{1}^{3}y\\sqrt{x}dxdy$\n2. $∬_(D)y\\sqrt{x}dA = \\displaystyle \\int_{0}^{1}\\displaystyle \\int_{1}^{3}y\\sqrt{x}dydx$\n3. $∬_(D)y\\sqrt{x}dA = \\displaystyle \\int_{1}^{3}\\displaystyle \\int_{0}^{1}y\\sqrt{x}dydx$" #edb/ref 17592186045417] [17592186129843 #edb/ref 1072 #uuid "fd6a034f-87ae-5507-9abe-98641b443d7e" #edb/ref 17592186045417] [17592186130020 #edb/ref 1058 #edb/ref 17592186130110 #edb/ref 17592186045417] [17592186130020 #edb/ref 1061 22582 #edb/ref 17592186045417] [17592186130020 #edb/ref 1062 #uuid "a902970c-e690-5291-9e44-5c7c70076e17" #edb/ref 17592186045417] [17592186130020 #edb/ref 1063 #edb/ref 17592186129164 #edb/ref 17592186045417] [17592186130021 #edb/ref 1058 #edb/ref 17592186130029 #edb/ref 17592186045417] [17592186130021 #edb/ref 1061 22583 #edb/ref 17592186045417] [17592186130021 #edb/ref 1062 #uuid "07c10315-095f-5ca8-ae6c-b3cafc296205" #edb/ref 17592186045417] [17592186130021 #edb/ref 1063 #edb/ref 17592186129165 #edb/ref 17592186045417] [17592186130022 #edb/ref 1061 22584 #edb/ref 17592186045417] [17592186130022 #edb/ref 1062 #uuid "def04952-960b-574f-ad97-fdf9decfb2de" #edb/ref 17592186045417] [17592186130022 #edb/ref 1063 #edb/ref 17592186129166 #edb/ref 17592186045417] [17592186130029 #edb/ref 1058 #edb/ref 17592186130022 #edb/ref 17592186045417] [17592186130029 #edb/ref 1061 22621 #edb/ref 17592186045417] [17592186130029 #edb/ref 1062 #uuid "e9f89a44-c08e-51d9-95f7-d73be3535606" #edb/ref 17592186045417] [17592186130029 #edb/ref 1063 #edb/ref 17592186130374 #edb/ref 17592186045417] [17592186130043 #edb/ref 1058 #edb/ref 17592186130020 #edb/ref 17592186045417] [17592186130043 #edb/ref 1061 23088 #edb/ref 17592186045417] [17592186130043 #edb/ref 1062 #uuid "b2b10cfb-2130-565a-9f4e-f0f29bef13a2" #edb/ref 17592186045417] [17592186130043 #edb/ref 1063 #edb/ref 17592186130381 #edb/ref 17592186045417] [17592186130110 #edb/ref 1058 #edb/ref 17592186130021 #edb/ref 17592186045417] [17592186130110 #edb/ref 1061 32682 #edb/ref 17592186045417] [17592186130110 #edb/ref 1062 #uuid "dfebef0f-d872-5cc5-bcc5-6e2befa67e6b" #edb/ref 17592186045417] [17592186130110 #edb/ref 1063 #edb/ref 17592186130412 #edb/ref 17592186045417] [17592186130374 #edb/ref 1064 "Let's once again consider the integral \n\n$$\n\\displaystyle \\iint\\limits_{D}{ { (x^2+y^2) \\, \\mathrm{d}A}}\n$$\n\nover the rectangular domain \n\n$$\nD=[0,1] \\times [0,1] = \\big\\{ (x,y) \\: : \\: 0 \\leq x \\leq 1, \\: 0 \\leq y \\leq 1 \\big\\}.\n$$\n\nSimilar to definite integrals of single-variable functions, this double integral can be defined as the limit of a Riemann sum, as follows:\n\n$$\n\\iint\\limits_{D}{{f\\left( {x,y} \\right)\\, \\mathrm{d}A}} = \\mathop {\\lim }\\limits_{n,\\,\\,m \\to \\infty } \\sum\\limits_{j = 1}^n {\\sum\\limits_{i = 1}^m {f\\big( {x_i^*,y_j^*} \\big)\\,\\Delta x_i \\Delta y_j} }\n$$\n\nNotice that in the above summation, we could have instead summed over the $j$'s first and then the $i$'s, giving\n\n$$\n\\iint\\limits_{D}{{f\\left( {x,y} \\right)\\, \\mathrm{d}A}} = \\mathop {\\lim }\\limits_{m,\\,\\,n \\to \\infty } \\sum\\limits_{i = 1}^m {\\sum\\limits_{j = 1}^n {f\\big( {x_i^*,y_j^*} \\big)\\,\\Delta y_j \\Delta x_i} },\n$$\n\nand this would result in an iterated integral in the reverse order: \n\n$$\n\\iint\\limits_{D}{{f\\left( {x,y} \\right)\\, \\mathrm{d}A}}  \n= \\int_0^1\\int_0^1 f(x,y)\\ \\mathrm{d}  y\\,  \\mathrm{d}  x.\n$$\n\n \n\nRegardless of the order in which we carry out the integration, the answer will always be the same!\n\nMoreover, *provided that the region $D$ is rectangular*, we can swap the order of integration. This means that if \n\n$$\nD=[a,b] \\times [c,d] = \\big\\{ (x,y) \\: : \\: a \\leq x \\leq b, \\: c \\leq y \\leq d \\big\\},\n$$\n\nthen\n\n$$\n\\begin{aligned}{∬}_{D}f(x,y)\\,dA & ={\\int }_{c}^{d}{\\int }_{a}^{b}f(x,y)\\text{ }dx\\,dy \\\\  & ={\\int }_{a}^{b}{\\int }_{c}^{d}f(x,y)\\text{ }dy\\,dx\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186130374 #edb/ref 1065 3859 #edb/ref 17592186045417] [17592186130374 #edb/ref 1066 #uuid "21451089-e080-55c2-acf5-60d200c5ee21" #edb/ref 17592186045417] [17592186130374 #edb/ref 1067 "The Order of Integration for Double Integrals on a Rectangular Domain" #edb/ref 17592186045417] [17592186130381 #edb/ref 1064 "A **repeated integral**, also known as an **iterated integral,** is an integral in which we carry out repeated integration with respect to different variables. An example of a repeated integral is as follows:\n\n$$\n\\int_0^1\\int_0^1 ye^{xy}\\,\\textrm d x\\,\\textrm d y\n$$\n\nTo evaluate this integral, we first integrate with respect to the inner variable $x,$ and then with respect to the outer variable $y$. We can write this more explicitly as\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}[{\\int }_{0}^{1}y{e}^{xy}\\,\\text{d}x]\\,\\text{d}y.\\end{aligned}\n$$\n\nWe now carry out the integration. First, we integrate with respect to $x,$ *treating $y$ as a constant*. This gives\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}[{\\int }_{0}^{1}y{e}^{xy}\\,\\text{d}x]\\,\\text{d}y & ={\\int }_{0}^{1}{[\\frac{y{e}^{xy}}{y}]}_{0}^{1}\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}{[{e}^{xy}]}_{0}^{1}\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}{e}^{y}-{e}^{0}\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}{e}^{y}-1\\,\\text{d}y.\\end{aligned}\n$$\n\nFinally, we integrate with respect to $y\\mathbin{:}$ \n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{e}^{y}-1\\,\\text{d}y & ={[{e}^{y}-y]}_{0}^{1} \\\\  & =[e-1]-[1-0] \\\\  & =e-2.\\end{aligned}\n$$\n\nWe conclude that\n\n$$\n\\int_0^1\\int_0^1 ye^{xy}\\,\\textrm d x\\,\\textrm d y = e-2.\n$$" #edb/ref 17592186045417] [17592186130381 #edb/ref 1065 3904 #edb/ref 17592186045417] [17592186130381 #edb/ref 1066 #uuid "ab6d3983-ce7d-5e80-9dfc-ae0644ac5030" #edb/ref 17592186045417] [17592186130381 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186130412 #edb/ref 1064 "Consider the surface $z= f(x,y) = 3-x^2-y^2,$ defined over the following rectangle:\n\n$$\nR=[0,1] \\times [0,1] = \\big\\{ (x,y) \\: : \\: 0 \\leq x \\leq 1, \\: 0 \\leq y \\leq 1 \\big\\}.\n$$\n\nA sketch of our surface and its domain is shown below.\n\n![](images/1f/1fdf4668c7e89a9a32ee8e655fe5c80c899a04d25a0f342365560f4d9abdd8fd.png)\n\n \n\nThe **double integral** of $f(x,y)$ over $R,$ denoted\n\n$$\n\\iint\\limits_{R}{ f(x,y) \\, \\mathrm{d}A},\n$$\n\nrepresents the total *signed* volume bounded between the surface $z=f(x,y)$ and the planes $x=0, x=1, y=0, y=1.$\n\nIt can be shown that the double integral \n\n$$\n\\displaystyle \\iint\\limits_{R} {{(3-x^2-y^2) \\, \\mathrm{d}A}},\n$$\n\ncan be evaluated using the repeated integral \n\n$$\n\\displaystyle \\int_0^1\\int_0^1 (3-x^2-y^2) \\, \\mathrm{d}  x\\,  \\mathrm{d}  y.\n$$\n\nNotice that we replace $\\textrm d A$ with $\\textrm d x\\,\\textrm d y$ when writing our double integral as a repeated integral." #edb/ref 17592186045417] [17592186130412 #edb/ref 1065 5203 #edb/ref 17592186045417] [17592186130412 #edb/ref 1066 #uuid "b04cc8c6-0b4d-5f4e-9027-892d33558737" #edb/ref 17592186045417] [17592186130412 #edb/ref 1067 "Double Integrals" #edb/ref 17592186045417] [17592186336568 #edb/ref 1080 "1+\\sqrt{2}" #edb/ref 17592186045417] [17592186336568 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186336568 #edb/ref 1083 #uuid "3906178d-d2b9-5c1e-8874-62464ff4587d" #edb/ref 17592186045417] [17592186336705 #edb/ref 1080 "2-\\sqrt{2}" #edb/ref 17592186045417] [17592186336705 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186336705 #edb/ref 1083 #uuid "485ed612-6290-5d86-b376-ce0eb70b3fe8" #edb/ref 17592186045417] [17592186336780 #edb/ref 1080 "\\sqrt{2}-1" #edb/ref 17592186045417] [17592186336780 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186336780 #edb/ref 1083 #uuid "51a463d3-0093-55d7-a2ee-8312594e1a86" #edb/ref 17592186045417] [17592186337253 #edb/ref 1080 "\\frac{\\sqrt{2}}{2}" #edb/ref 17592186045417] [17592186337253 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186337253 #edb/ref 1083 #uuid "87045c5e-f1ca-5e3e-850f-ac86db303947" #edb/ref 17592186045417] [17592186337466 #edb/ref 1080 "\\sqrt{2}" #edb/ref 17592186045417] [17592186337466 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186337466 #edb/ref 1083 #uuid "9ea3d299-fb71-5298-b534-c642be602e95" #edb/ref 17592186045417] [17592186338334 #edb/ref 1075 #edb/ref 17592186336568 #edb/ref 17592186045417] [17592186338334 #edb/ref 1075 #edb/ref 17592186336705 #edb/ref 17592186045417] [17592186338334 #edb/ref 1075 #edb/ref 17592186336780 #edb/ref 17592186045417] [17592186338334 #edb/ref 1075 #edb/ref 17592186337253 #edb/ref 17592186045417] [17592186338334 #edb/ref 1075 #edb/ref 17592186337466 #edb/ref 17592186045417] [17592186338334 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186338334 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186338334 #edb/ref 1078 #edb/ref 17592186336705 #edb/ref 17592186045417] [17592186338334 #edb/ref 1079 #uuid "1eab19eb-a5c0-56fa-880c-7541dcfdcaf1" #edb/ref 17592186045417] [17592186339084 #edb/ref 1068 #edb/ref 17592186338334 #edb/ref 17592186045417] [17592186339084 #edb/ref 1069 "q-72268" #edb/ref 17592186045417] [17592186339084 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186339084 #edb/ref 1071 "Evaluate the double integral ${∬}_{D}2\\operatorname{sin}⁡y\\operatorname{cos}⁡x\\,\\text{d}A,$ where \n$D={(x,y)\\,:\\,0\\le x\\le \\frac{\\pi }{2},\\,0\\le y\\le \\frac{\\pi }{4}}.$" #edb/ref 17592186045417] [17592186339084 #edb/ref 1072 #uuid "2290a5a5-423d-532e-a1cb-06c374bf7c6e" #edb/ref 17592186045417] [17592186339084 #edb/ref 1074 "First, we express our double integral as a repeated integral:    \n\n$$\n\\begin{aligned}{∬}_{D}2\\operatorname{sin}⁡y\\operatorname{cos}⁡x\\,\\text{d}A & ={\\int }_{0}^{\\pi /4}[{\\int }_{0}^{\\pi /2}2\\operatorname{sin}⁡y\\operatorname{cos}⁡x\\,\\text{d}x]\\text{d}y\\end{aligned}\n$$\n\nNow, we evaluate the inner integral by integrating with respect to $x$, treating $y$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /4}[{\\int }_{0}^{\\pi /2}2\\operatorname{sin}⁡y\\operatorname{cos}⁡x\\,\\text{d}x]\\text{d}y & ={\\int }_{0}^{\\pi /4}2\\operatorname{sin}⁡y\\,[\\operatorname{sin}⁡x]_{0}^{\\pi /2}\\,\\text{d}y \\\\  & ={\\int }_{0}^{\\pi /4}2\\operatorname{sin}⁡y(\\operatorname{sin}⁡(\\frac{\\pi }{2})-\\operatorname{sin}⁡(0))\\text{d}y \\\\  & ={\\int }_{0}^{\\pi /4}2\\operatorname{sin}⁡y(1-0)\\text{d}y \\\\  & ={\\int }_{0}^{\\pi /4}2\\operatorname{sin}⁡y\\,\\text{d}y\\end{aligned}\n$$\n\nFinally, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /4}2\\operatorname{sin}⁡y\\,\\text{d}y & =-2[\\operatorname{cos}⁡y]_{0}^{\\pi /4} \\\\  & =-2(\\operatorname{cos}⁡(\\frac{\\pi }{4})-\\operatorname{cos}⁡(0)) \\\\  & =-2\\cdot \\frac{\\sqrt{2}}{2}-2\\cdot (-1) \\\\  & =2-\\sqrt{2}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186339428 #edb/ref 1080 "\\frac{\\pi }{6}" #edb/ref 17592186045417] [17592186339428 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186339428 #edb/ref 1083 #uuid "23119422-3823-57bd-ae60-3a70da203882" #edb/ref 17592186045417] [17592186339569 #edb/ref 1080 "\\frac{\\pi }{3}" #edb/ref 17592186045417] [17592186339569 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186339569 #edb/ref 1083 #uuid "3233eb3a-80c4-5e2c-afa0-25c63262aae6" #edb/ref 17592186045417] [17592186340387 #edb/ref 1080 "\\frac{\\pi }{4}" #edb/ref 17592186045417] [17592186340387 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186340387 #edb/ref 1083 #uuid "8c653da2-7477-595d-a51e-c3f66f8b5ff3" #edb/ref 17592186045417] [17592186340942 #edb/ref 1080 "-\\frac{\\pi }{12}" #edb/ref 17592186045417] [17592186340942 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186340942 #edb/ref 1083 #uuid "cce2e1a4-aa36-57b6-badd-2c432cb8566b" #edb/ref 17592186045417] [17592186341185 #edb/ref 1080 "\\frac{3\\pi }{4}" #edb/ref 17592186045417] [17592186341185 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186341185 #edb/ref 1083 #uuid "e95bda4b-27fc-570d-96c8-8ec990cd3092" #edb/ref 17592186045417] [17592186341583 #edb/ref 1075 #edb/ref 17592186339428 #edb/ref 17592186045417] [17592186341583 #edb/ref 1075 #edb/ref 17592186339569 #edb/ref 17592186045417] [17592186341583 #edb/ref 1075 #edb/ref 17592186340387 #edb/ref 17592186045417] [17592186341583 #edb/ref 1075 #edb/ref 17592186340942 #edb/ref 17592186045417] [17592186341583 #edb/ref 1075 #edb/ref 17592186341185 #edb/ref 17592186045417] [17592186341583 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186341583 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186341583 #edb/ref 1078 #edb/ref 17592186340942 #edb/ref 17592186045417] [17592186341583 #edb/ref 1079 #uuid "738ace53-c45e-5df6-a139-2497bca10161" #edb/ref 17592186045417] [17592186342021 #edb/ref 1068 #edb/ref 17592186341583 #edb/ref 17592186045417] [17592186342021 #edb/ref 1069 "q-73583" #edb/ref 17592186045417] [17592186342021 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186342021 #edb/ref 1071 "Evaluate the repeated integral\n${\\int }_{1/3}^{1/4}{\\int }_{1/3}^{\\sqrt{3}/3}\\frac{3}{{y}^{2}(1+9{x}^{2})}\\,\\text{d}x\\,\\text{d}y.$" #edb/ref 17592186045417] [17592186342021 #edb/ref 1072 #uuid "9d286237-0b02-5319-9c6e-7aa25af2bd91" #edb/ref 17592186045417] [17592186342021 #edb/ref 1074 "First, we evaluate the inner integral by integrating with respect to $x$, treating $y$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{1/3}^{1/4}[{\\int }_{1/3}^{\\sqrt{3}/3}\\frac{3}{{y}^{2}(1+9{x}^{2})}\\,\\text{d}x]\\text{d}y & ={\\int }_{1/3}^{1/4}\\frac{1}{{y}^{2}}[{\\int }_{1/3}^{\\sqrt{3}/3}\\frac{3}{(1+(3x)^{2})}\\,\\text{d}x]\\text{d}y \\\\  & ={\\int }_{1/3}^{1/4}\\frac{1}{{y}^{2}}[\\operatorname{arctan}⁡(3x)]_{1/3}^{\\sqrt{3}/3}\\,\\text{d}y \\\\  & ={\\int }_{1/3}^{1/4}\\frac{1}{{y}^{2}}(\\operatorname{arctan}⁡(\\sqrt{3})-\\operatorname{arctan}⁡(1))\\text{d}y \\\\  & ={\\int }_{1/3}^{1/4}\\frac{1}{{y}^{2}}(\\frac{\\pi }{3}-\\frac{\\pi }{4})\\text{d}y \\\\  & ={\\int }_{1/3}^{1/4}\\frac{\\pi }{12{y}^{2}}\\,\\text{d}y\\end{aligned}\n$$\n\nThen, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}{\\int }_{1/3}^{1/4}\\frac{\\pi }{12{y}^{2}}\\,\\text{d}y & ={[-\\frac{\\pi }{12y}]}_{1/3}^{1/4} \\\\  & =-\\frac{\\pi }{12\\cdot \\frac{1}{4}}+\\frac{\\pi }{12\\cdot \\frac{1}{3}} \\\\  & =-\\frac{\\pi }{3}+\\frac{\\pi }{4} \\\\  & =-\\frac{\\pi }{12}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186382263 #edb/ref 1068 #edb/ref 17592186382264 #edb/ref 17592186045417] [17592186382263 #edb/ref 1069 "q-73576" #edb/ref 17592186045417] [17592186382263 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186382263 #edb/ref 1071 "Evaluate \n${\\int }_{0}^{\\pi /12}{\\int }_{\\pi }^{5\\pi /3}\\operatorname{sin}⁡(x+2y)\\,\\text{d}x\\,\\text{d}y.$" #edb/ref 17592186045417] [17592186382263 #edb/ref 1072 #uuid "d0386666-3fac-5a95-aad2-f27d650f7552" #edb/ref 17592186045417] [17592186382263 #edb/ref 1074 "First, we evaluate the inner integral by integrating with respect to $x$, treating $y$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /12}[{\\int }_{\\pi }^{5\\pi /3}\\operatorname{sin}⁡(x+2y)\\,\\text{d}x]\\text{d}y & ={\\int }_{0}^{\\pi /12}[-\\operatorname{cos}⁡(x+2y)]_{\\pi }^{5\\pi /3}\\,\\text{d}y \\\\  & ={\\int }_{0}^{\\pi /12}(-\\operatorname{cos}⁡(2y+\\frac{5\\pi }{3})+\\operatorname{cos}⁡(2y+\\pi ))\\text{d}y\\end{aligned}\n$$\n\nThen, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /12} & (-\\operatorname{cos}⁡(2y+\\frac{5\\pi }{3})+\\operatorname{cos}⁡(2y+\\pi ))\\text{d}y \\\\  & ={[-\\frac{1}{2}\\operatorname{sin}⁡(2y+\\frac{5\\pi }{3})+\\frac{1}{2}\\operatorname{sin}⁡(2y+\\pi )]}_{0}^{\\pi /12} \\\\  & =-\\frac{1}{2}\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{12}+\\frac{5\\pi }{3})+\\frac{1}{2}\\operatorname{sin}⁡(2\\cdot 0+\\frac{5\\pi }{3}) \\\\  & +\\frac{1}{2}\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{12}+\\pi )-\\frac{1}{2}\\operatorname{sin}⁡(2\\cdot 0+\\pi ) \\\\  & =\\frac{1}{2}[-\\operatorname{sin}⁡(\\frac{11\\pi }{6})+\\operatorname{sin}⁡(\\frac{5\\pi }{3})+\\operatorname{sin}⁡(\\frac{7\\pi }{6})-\\operatorname{sin}⁡(\\pi )] \\\\  & =\\frac{1}{2}[\\frac{1}{2}-\\frac{\\sqrt{3}}{2}-\\frac{1}{2}-0] \\\\  & =-\\frac{\\sqrt{3}}{4}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186382264 #edb/ref 1075 #edb/ref 17592186382265 #edb/ref 17592186045417] [17592186382264 #edb/ref 1075 #edb/ref 17592186382266 #edb/ref 17592186045417] [17592186382264 #edb/ref 1075 #edb/ref 17592186382267 #edb/ref 17592186045417] [17592186382264 #edb/ref 1075 #edb/ref 17592186382268 #edb/ref 17592186045417] [17592186382264 #edb/ref 1075 #edb/ref 17592186382269 #edb/ref 17592186045417] [17592186382264 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186382264 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186382264 #edb/ref 1078 #edb/ref 17592186382268 #edb/ref 17592186045417] [17592186382264 #edb/ref 1079 #uuid "cdb31333-a57a-513c-a580-7da1020dfc71" #edb/ref 17592186045417] [17592186382265 #edb/ref 1080 "2\\sqrt{3}" #edb/ref 17592186045417] [17592186382265 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186382265 #edb/ref 1083 #uuid "824359cf-f8f4-52d6-ba3e-38e5e3b7039d" #edb/ref 17592186045417] [17592186382266 #edb/ref 1080 "4\\sqrt{2}" #edb/ref 17592186045417] [17592186382266 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186382266 #edb/ref 1083 #uuid "5d49b3c7-4f50-56c5-914d-a87761849f4a" #edb/ref 17592186045417] [17592186382267 #edb/ref 1080 "-\\frac{\\sqrt{2}}{4}" #edb/ref 17592186045417] [17592186382267 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186382267 #edb/ref 1083 #uuid "49e46a24-677b-55ca-84d4-a49ee89da34b" #edb/ref 17592186045417] [17592186382268 #edb/ref 1080 "-\\frac{\\sqrt{3}}{4}" #edb/ref 17592186045417] [17592186382268 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186382268 #edb/ref 1083 #uuid "dc529383-f4e5-5451-b49b-b79fd5352caf" #edb/ref 17592186045417] [17592186382269 #edb/ref 1080 "-\\frac{\\sqrt{3}}{2}" #edb/ref 17592186045417] [17592186382269 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186382269 #edb/ref 1083 #uuid "adcc0123-a959-56a4-8c2a-3f66fbcf1437" #edb/ref 17592186045417] [17592186382270 #edb/ref 1068 #edb/ref 17592186382271 #edb/ref 17592186045417] [17592186382270 #edb/ref 1069 "q-73586" #edb/ref 17592186045417] [17592186382270 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186382270 #edb/ref 1071 "Evaluate the double integral ${∬}_{D}\\frac{{x}^{2}}{{y}^{3}}\\,\\text{d}A,$ where \n$D={(x,y)\\,:\\,0\\le x\\le 3,\\,-3\\le y\\le -1}.$" #edb/ref 17592186045417] [17592186382270 #edb/ref 1072 #uuid "6487b6b9-d5be-5e16-b654-46f92252f451" #edb/ref 17592186045417] [17592186382270 #edb/ref 1074 "First, we express our double integral as a repeated integral:      \n\n$$\n\\begin{aligned}{∬}_{D}\\frac{{x}^{2}}{{y}^{3}}\\,\\text{d}A & ={\\int }_{-3}^{-1}[{\\int }_{0}^{3}\\frac{{x}^{2}}{{y}^{3}}\\,\\text{d}x]\\text{d}y\\end{aligned}\n$$\n\nNow, we evaluate the inner integral by integrating with respect to $x$, treating $y$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{-3}^{-1}[{\\int }_{0}^{3}\\frac{{x}^{2}}{{y}^{3}}\\,\\text{d}x]\\text{d}y & ={\\int }_{-3}^{3}\\frac{1}{{y}^{3}}[{\\int }_{0}^{3}{x}^{2}\\,\\text{d}x]\\text{d}y \\\\  & ={\\int }_{-3}^{-1}\\frac{1}{{y}^{3}}{[\\frac{{x}^{3}}{3}]}_{0}^{3}\\text{d}y \\\\  & ={\\int }_{-3}^{-1}\\frac{1}{{y}^{3}}(\\frac{{3}^{3}}{3}-\\frac{{0}^{3}}{3})\\,\\text{d}y \\\\  & ={\\int }_{-3}^{-1}\\frac{9}{{y}^{3}}\\,\\text{d}y\\end{aligned}\n$$\n\nFinally, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}{\\int }_{-3}^{-1}\\frac{9}{{y}^{3}}\\,\\text{d}y & =9{[-\\frac{1}{2{y}^{2}}]}_{-3}^{-1} \\\\  & =9(-\\frac{1}{2(-1)^{2}}+\\frac{1}{2(-3)^{2}}) \\\\  & =-4\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186382271 #edb/ref 1075 #edb/ref 17592186382272 #edb/ref 17592186045417] [17592186382271 #edb/ref 1075 #edb/ref 17592186382273 #edb/ref 17592186045417] [17592186382271 #edb/ref 1075 #edb/ref 17592186382274 #edb/ref 17592186045417] [17592186382271 #edb/ref 1075 #edb/ref 17592186382275 #edb/ref 17592186045417] [17592186382271 #edb/ref 1075 #edb/ref 17592186382276 #edb/ref 17592186045417] [17592186382271 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186382271 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186382271 #edb/ref 1078 #edb/ref 17592186382275 #edb/ref 17592186045417] [17592186382271 #edb/ref 1079 #uuid "6a37391c-0888-5ae0-8a15-f1ed7e46bd73" #edb/ref 17592186045417] [17592186382272 #edb/ref 1080 "-8" #edb/ref 17592186045417] [17592186382272 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186382272 #edb/ref 1083 #uuid "c27e5d9e-ecc8-5521-979e-959ae11dfb19" #edb/ref 17592186045417] [17592186382273 #edb/ref 1080 "2" #edb/ref 17592186045417] [17592186382273 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186382273 #edb/ref 1083 #uuid "dcf8410f-256c-5c3a-88a9-1e54c1305a5c" #edb/ref 17592186045417] [17592186382274 #edb