{:edb/committed true :edb/basis-t 1597 :edb/replayed false :edb/tx-hash "c75d96e7a7c2c9d6d9cba4026b74526b1928864e4c237cf91a71d6cd2353e5fc" :edb/db-before-t 1596 :edb/db-after-t 1597 :edb/tx-data [[13194139534909 50 #inst "2026-10-12T22:41:36.327Z" 13194139534909 17592186045417 true] [17592186128539 1078 #edb/ref 17592186128543 13194139534909 17592186045417 true] [17592186129166 1038 #edb/ref 17592186443730 13194139534909 17592186045417 true] [17592186129843 1070 #edb/ref 17592186045485 13194139534909 17592186045417 true] [17592186129843 1071 "Which of the following equalities are true given that\n$D = {(x, y): 0 \\le x \\le 1, 1 \\le y \\le 3}$.\n\n1. $∬_(D)y\\sqrt{x}dA = \\displaystyle \\int_{0}^{1}\\displaystyle \\int_{1}^{3}y\\sqrt{x}dxdy$\n2. $∬_(D)y\\sqrt{x}dA = \\displaystyle \\int_{0}^{1}\\displaystyle \\int_{1}^{3}y\\sqrt{x}dydx$\n3. $∬_(D)y\\sqrt{x}dA = \\displaystyle \\int_{1}^{3}\\displaystyle \\int_{0}^{1}y\\sqrt{x}dydx$" 13194139534909 17592186045417 false] [17592186129843 1071 "Which of the following equalities are true given that\n$D=\\{(x,y)\\,:\\,0\\le x\\le 1,\\,1\\le y\\le 3\\}.$\n\nI. ${∬}_{D}y\\sqrt{x}\\,\\text{d}A={\\int }_{0}^{1}{\\int }_{1}^{3}y\\sqrt{x}\\,\\text{d}x\\,\\text{d}y$\n\nII. ${∬}_{D}y\\sqrt{x}\\,\\text{d}A={\\int }_{0}^{1}{\\int }_{1}^{3}y\\sqrt{x}\\,\\text{d}y\\,\\text{d}x$\n\nIII. ${∬}_{D}y\\sqrt{x}\\,\\text{d}A={\\int }_{1}^{3}{\\int }_{0}^{1}y\\sqrt{x}\\,\\text{d}y\\,\\text{d}x$" 13194139534909 17592186045417 true] [17592186129843 1074 "We notice that:\n\n- the limits for the variable $x$ are from $0$ to $1$, and\n\n- the limits for the variable $y$ are from $1$ to $3.$\n\nTherefore,\n\n$$\n\\begin{aligned}{∬}_{D}y\\sqrt{x}\\,\\text{d}A & ={\\int }_{1}^{3}[{\\int }_{0}^{1}y\\sqrt{x}\\,\\text{d}x]\\text{d}y.\\end{aligned}\n$$\n\nNow, since the region of integration is rectangular, we can simply swap the order of integration. This gives\n\n$$\n{∬}_{D}y\\sqrt{x}\\,\\text{d}A={\\int }_{0}^{1}[{\\int }_{1}^{3}y\\sqrt{x}\\,\\text{d}y]\\text{d}x.\n$$\n\nSo, the correct answer is \"II only\"." 13194139534909 17592186045417 true] [17592186339084 1071 "Evaluate the double integral ${∬}_{D}2\\operatorname{sin}⁡y\\operatorname{cos}⁡x\\,\\text{d}A,$ where \n$D=\\{(x,y)\\,:\\,0\\le x\\le \\frac{\\pi }{2},\\,0\\le y\\le \\frac{\\pi }{4}\\}.$" 13194139534909 17592186045417 true] [17592186339084 1071 "Evaluate the double integral ${∬}_{D}2\\operatorname{sin}⁡y\\operatorname{cos}⁡x\\,\\text{d}A,$ where \n$D={(x,y)\\,:\\,0\\le x\\le \\frac{\\pi }{2},\\,0\\le y\\le \\frac{\\pi }{4}}.$" 13194139534909 17592186045417 false] [17592186382270 1071 "Evaluate the double integral ${∬}_{D}\\frac{{x}^{2}}{{y}^{3}}\\,\\text{d}A,$ where \n$D=\\{(x,y)\\,:\\,0\\le x\\le 3,\\,-3\\le y\\le -1\\}.$" 13194139534909 17592186045417 true] [17592186382270 1071 "Evaluate the double integral ${∬}_{D}\\frac{{x}^{2}}{{y}^{3}}\\,\\text{d}A,$ where \n$D={(x,y)\\,:\\,0\\le x\\le 3,\\,-3\\le y\\le -1}.$" 13194139534909 17592186045417 false] [17592186443724 1080 "II only" 13194139534909 17592186045417 true] [17592186443724 1082 #edb/ref 17592186045499 13194139534909 17592186045417 true] [17592186443724 1083 #uuid "5f04548b-c5b2-5dd6-91f7-ac226f8ce5f1" 13194139534909 17592186045417 true] [17592186443725 1080 "I and II only" 13194139534909 17592186045417 true] [17592186443725 1082 #edb/ref 17592186045499 13194139534909 17592186045417 true] [17592186443725 1083 #uuid "6c9577fe-e0ea-5924-a5a3-56d0d5cd71b2" 13194139534909 17592186045417 true] [17592186443726 1080 "III only" 13194139534909 17592186045417 true] [17592186443726 1082 #edb/ref 17592186045499 13194139534909 17592186045417 true] [17592186443726 1083 #uuid "be4791cb-b433-5220-a3ae-6b3c2cac9bc7" 13194139534909 17592186045417 true] [17592186443727 1080 "II and III only" 13194139534909 17592186045417 true] [17592186443727 1082 #edb/ref 17592186045499 13194139534909 17592186045417 true] [17592186443727 1083 #uuid "dec4c0cb-7929-5b16-9e0e-753322768bf1" 13194139534909 17592186045417 true] [17592186443728 1080 "I only" 13194139534909 17592186045417 true] [17592186443728 1082 #edb/ref 17592186045499 13194139534909 17592186045417 true] [17592186443728 1083 #uuid "f8ea7f02-d0bc-58f0-b333-df298335e3ed" 13194139534909 17592186045417 true] [17592186443729 1075 #edb/ref 17592186443724 13194139534909 17592186045417 true] [17592186443729 1075 #edb/ref 17592186443725 13194139534909 17592186045417 true] [17592186443729 1075 #edb/ref 17592186443726 13194139534909 17592186045417 true] [17592186443729 1075 #edb/ref 17592186443727 13194139534909 17592186045417 true] [17592186443729 1075 #edb/ref 17592186443728 13194139534909 17592186045417 true] [17592186443729 1076 #edb/ref 17592186045493 13194139534909 17592186045417 true] [17592186443729 1077 "selection" 13194139534909 17592186045417 true] [17592186443729 1078 #edb/ref 17592186443728 13194139534909 17592186045417 true] [17592186443729 1079 #uuid "fe184e8e-6c3d-5fe7-aa56-1a1728b67c6b" 13194139534909 17592186045417 true] [17592186443730 1068 #edb/ref 17592186443729 13194139534909 17592186045417 true] [17592186443730 1069 "q-72178" 13194139534909 17592186045417 true] [17592186443730 1070 #edb/ref 17592186045485 13194139534909 17592186045417 true] [17592186443730 1071 "Which of the following equalities are true given that\n$D=\\{(x,y)\\,:\\,-\\frac{1}{2}\\le x\\le \\frac{1}{2},\\,-1\\le y\\le \\frac{1}{3}\\}.$\n\nI. ${∬}_{D}{x}^{2}{y}^{4}\\,\\text{d}A={\\int }_{-1/2}^{1/2}{\\int }_{-1}^{1/3}{x}^{2}{y}^{4}\\,\\text{d}y\\,\\text{d}x$\n\nII. ${∬}_{D}{x}^{2}{y}^{4}\\,\\text{d}A={\\int }_{-1/2}^{1/2}{\\int }_{-1}^{1/3}{x}^{2}{y}^{4}\\,\\text{d}x\\,\\text{d}y$\n\nIII. ${∬}_{D}{x}^{2}{y}^{4}\\,\\text{d}A={\\int }_{-1}^{1/3}{\\int }_{-1/2}^{1/2}{x}^{2}{y}^{4}\\,\\text{d}y\\,\\text{d}x$" 13194139534909 17592186045417 true] [17592186443730 1072 #uuid "1fae684a-7e13-519a-aef1-3caa737a3e69" 13194139534909 17592186045417 true] [17592186443730 1074 "We notice that:      \n\n- the limits for the variable $x$ are from $-\\frac{1}{2}$ to $\\frac{1}{2}$, and\n\n- the limits for the variable $y$ are from $-1$ to $\\frac{1}{3}.$\n\nTherefore,\n\n$$\n\\begin{aligned}{∬}_{D}{x}^{2}{y}^{4}\\,\\text{d}A & ={\\int }_{-1}^{1/3}[{\\int }_{-1/2}^{1/2}{x}^{2}{y}^{4}\\,\\text{d}x]\\text{d}y.\\end{aligned}\n$$\n\n \n\nNow, since the region of integration is rectangular, we can also swap the order of integration. This gives \n\n$$\n{∬}_{D}{x}^{2}{y}^{4}\\,\\text{d}A={\\int }_{-1/2}^{1/2}[{\\int }_{-1}^{1/3}{x}^{2}{y}^{4}\\,\\text{d}y]\\text{d}x.\n$$\n\n \n\nSo, the correct answer is \"I only\"." 13194139534909 17592186045417 true]] :edb/tempids {"answer-5f04548b-c5b2-5dd6-91f7-ac226f8ce5f1" 17592186443724 "answer-6c9577fe-e0ea-5924-a5a3-56d0d5cd71b2" 17592186443725 "answer-be4791cb-b433-5220-a3ae-6b3c2cac9bc7" 17592186443726 "answer-dec4c0cb-7929-5b16-9e0e-753322768bf1" 17592186443727 "answer-f8ea7f02-d0bc-58f0-b333-df298335e3ed" 17592186443728 "answer-field-fe184e8e-6c3d-5fe7-aa56-1a1728b67c6b" 17592186443729 "question-1fae684a-7e13-519a-aef1-3caa737a3e69" 17592186443730}}
