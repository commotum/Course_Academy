#{[{:activity/first-step {:db/id #edb/ref 17592186163005} :activity/id #uuid "07565fa9-9264-561d-8b83-abf20d2a295d" :activity/scope {:db/id #edb/ref 17592186048872 :topic/id #uuid "c848c335-5dd6-5850-850b-068fef29dfba" :topic/math-academy-id 3053} :activity/steps [{:db/id #edb/ref 17592186163005 :step/content {:db/id #edb/ref 17592186163289 :tutorial/content "For discrete random variables $X$ and $Y$, the **conditional expected value of $X$ given $Y=y$** is defined by\n\n$$\n\\textrm E\\begin{bmatrix}X & Y=y\\end{bmatrix}=\\sum_{x}x f_{X\\mid Y}(x \\mid y)\n$$\n\nwhere $f_{X\\mid Y}(x \\mid y)$ is the conditional probability mass function of $X$ given $Y$.\n\nThis definition is similar to that of $\\textrm{E}[X]$. However, we now use the conditional PMF $f_{X\\mid Y}(x \\mid y)$ instead of the marginal PMF $f_X(x)$ in the summation.\n\nNote the following:\n\n- The conditional expectation $\\textrm E\\begin{bmatrix}X & Y = y\\end{bmatrix}$ is (in general) a function of $y$. This makes intuitive sense. If the distribution of $X$ varies with $Y$, then the expected value of $X$ for a given $Y$ must vary with the value of $Y$.\n- If $y$ is replaced with a number, then $\\textrm E\\begin{bmatrix}X & Y = y\\end{bmatrix}$ returns a single value.\n- If $X$ and $Y$ are independent, then $\\textrm E\\begin{bmatrix}X & Y = y\\end{bmatrix} = \\textrm E[X]$ for all $y$. Again, this makes intuitive sense. If the outcome of $Y$ has no influence on the outcome of $X$, then the distribution of $X$ and, consequently, its mean, is also unaffected by $Y$.\n- We sometimes use the notation $\\mu_{X \\mid y}$ to denote $E\\begin{bmatrix}X & Y = y\\end{bmatrix}$.\n\nFinally, we have an analogous definition for\n\n$$\n\\textrm E\\begin{bmatrix}Y & X=x\\end{bmatrix}\n$$\n\n$$\n\\textrm E\\begin{bmatrix}Y & X=x\\end{bmatrix}=\\sum_{y}y f_{Y\\mid X}(y \\mid x)\n$$" :tutorial/id #uuid "952ea536-2bdb-5613-b927-e32a2c37ab95" :tutorial/math-academy-id 5617 :tutorial/title "Introduction"} :step/id #uuid "39445eff-cb02-5c69-9e2d-94f25d4fe565" :step/math-academy-id 34579 :step/next {:db/id #edb/ref 17592186163100}} {:db/id #edb/ref 17592186163100 :step/content {:db/id #edb/ref 17592186162123 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161689 :question/id #uuid "07199b8b-32c6-59f5-b452-da48648cb799" :question/math-academy-id "e-10298"} :knowledge-point/id #uuid "e9040153-b66c-5c55-8854-8c5be0309720" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048317} {:db/id #edb/ref 17592186049149}] :knowledge-point/questions [{:db/id #edb/ref 17592186162409} {:db/id #edb/ref 17592186162410}] :knowledge-point/title "Calculating a Conditional Expected Value Given a Conditional Mass Function"} :step/id #uuid "36a757ed-4395-534d-ad5e-d076e2b870e0" :step/math-academy-id 38825 :step/next {:db/id #edb/ref 17592186163104}} {:db/id #edb/ref 17592186163104 :step/content {:db/id #edb/ref 17592186162126 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161692 :question/id #uuid "2f074ddb-056a-51c6-b307-74df33f135f0" :question/math-academy-id "e-10305"} :knowledge-point/id #uuid "59bd2280-5028-5261-a9ed-61d01d80c29a" :knowledge-point/questions [{:db/id #edb/ref 17592186162408} {:db/id #edb/ref 17592186162428}] :knowledge-point/title "Calculating a Conditional Expectation Using Row Totals"} :step/id #uuid "0f9635fd-5229-5ffb-9a7c-a7ccd41a597c" :step/math-academy-id 38846 :step/next {:db/id #edb/ref 17592186163112}} {:db/id #edb/ref 17592186163112 :step/content {:db/id #edb/ref 17592186162133 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161699 :question/id #uuid "4de21bb7-7f18-56c4-9925-47459df6f049" :question/math-academy-id "e-10350"} :knowledge-point/id #uuid "8e47d5ac-cb51-5259-ba41-6c407a992271" :knowledge-point/questions [{:db/id #edb/ref 17592186162424} {:db/id #edb/ref 17592186162430}] :knowledge-point/title "Calculating a Conditional Expectation Using Column Totals"} :step/id #uuid "e68faebc-808b-5050-8502-149fdb64c803" :step/math-academy-id 38982}] :activity/title "Conditional Expectation for Discrete Random Variables" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186162190}]}
