nswer.type/math} :answer/value "\\frac{11}{3}" :db/id #edb/ref 17592186430479} {:answer/id #uuid "4805957f-3e58-5699-b156-c74126f89c27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186430482} {:answer/id #uuid "669f32a5-42f7-5f36-bed2-8ba0c15fb5dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{4}" :db/id #edb/ref 17592186430486} {:answer/id #uuid "81ce082c-a8e9-5aec-a1e9-a43a2df3f377" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10}{3}" :db/id #edb/ref 17592186430490} {:answer/id #uuid "c2bb301a-985f-5815-8a2b-bec7a9094a3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186430512}] :answer-field/correct {:answer/id #uuid "4805957f-3e58-5699-b156-c74126f89c27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186430482} :answer-field/id #uuid "4d1d31ba-190a-58c9-9a39-b1445a487d80" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186430527}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3339efa3-bc24-59b5-979e-3e7acd556435" :question/math-academy-id "q-146184" :question/problem "| $x$ | $2$ | $5$ |\n| --- | --- | --- |\n| ${f}_{X|Y}(x\\,|\\,0)$ | $\\frac{1}{3}$ | $\\frac{2}{3}$ |\n\nFind the $\\text{E}[X\\,|\\,Y=0]$ given that the conditional probability mass function ${f}_{X|Y}(x\\,|\\,0)$ is shown in the table above." :question/worked-solution "The conditional expected value of  $X$ given $Y=y$ is defined by\n\n$$\n\\text{E}[X\\,|\\,Y=y]={\\sum }_{x}x\\,{f}_{X|Y}(x\\,|\\,y).\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{E}[X\\,|\\,Y=0] & ={\\sum }_{x}x\\,{f}_{X|Y}(x\\,|\\,0) \\\\  & =2\\cdot \\frac{1}{3}+5\\cdot \\frac{2}{3} \\\\  & =\\frac{12}{3} \\\\  & =4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186430549 :knowledge-point/_questions [{:db/id #edb/ref 17592186162123 :knowledge-point/id #uuid "e9040153-b66c-5c55-8854-8c5be0309720" :knowledge-point/title "Calculating a Conditional Expected Value Given a Conditional Mass Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "012ca9e0-686a-5d19-b689-9cff442f5919" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.9" :db/id #edb/ref 17592186430456} {:answer/id #uuid "18750022-8351-5a3e-ae1c-0ae0a5ecd278" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.8" :db/id #edb/ref 17592186430462} {:answer/id #uuid "2b9b402d-5456-5fb4-85a4-bc43a48af4ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.1" :db/id #edb/ref 17592186430473} {:answer/id #uuid "80fe22d6-3fa3-550b-9553-fd0c562a0c4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.4" :db/id #edb/ref 17592186430489} {:answer/id #uuid "ebef240d-f4fa-5c98-be54-34edb0d5f4c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.3" :db/id #edb/ref 17592186430521}] :answer-field/correct {:answer/id #uuid "80fe22d6-3fa3-550b-9553-fd0c562a0c4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.4" :db/id #edb/ref 17592186430489} :answer-field/id #uuid "b303c7aa-5c57-574c-b73d-694f3cc1bba8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186430533}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a9fb15b7-a2f0-5eaf-82a8-f09127855863" :question/math-academy-id "q-146186" :question/problem "$$\n{f}_{X|Y}(x\\,|\\,2)=\\{\\begin{aligned}0.3, & \\,x=3 \\\\ 0.7, & \\,x=5 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nFind $\\text{E}[X\\,|\\,Y=2]$ given that the conditional probability mass function ${f}_{X|Y}(x\\,|\\,2)$ is shown above." :question/worked-solution "Recall that the conditional expected value of  $X$ given $Y=y$ is defined by\n\n$$\n\\text{E}[X\\,|\\,Y=y]={\\sum }_{x}x\\,{f}_{X|Y}(x\\,|\\,y).\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{E}[X\\,|\\,Y=2] & ={\\sum }_{x}x\\,{f}_{X|Y}(x\\,|\\,2) \\\\  & =3\\cdot 0.3+5\\cdot 0.7 \\\\  & =4.4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186430551 :knowledge-point/_questions [{:db/id #edb/ref 17592186162123 :knowledge-point/id #uuid "e9040153-b66c-5c55-8854-8c5be0309720" :knowledge-point/title "Calculating a Conditional Expected Value Given a Conditional Mass Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08a6111f-b56b-5e44-9927-b6464728bb0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.05" :db/id #edb/ref 17592186430458} {:answer/id #uuid "1ae44c12-040b-59bb-ac20-ee680c8d7ad0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.90" :db/id #edb/ref 17592186430465} {:answer/id #uuid "85bb055b-e38e-5b00-90bc-b8ab2dd1d129" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.85" :db/id #edb/ref 17592186430493} {:answer/id #uuid "8eb6531d-a864-5261-aeb8-0bf3307ad32d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.55" :db/id #edb/ref 17592186430497} {:answer/id #uuid "9e1414fa-4702-5667-8953-c2e463f92750" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.15" :db/id #edb/ref 17592186430503}] :answer-field/correct {:answer/id #uuid "08a6111f-b56b-5e44-9927-b6464728bb0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.05" :db/id #edb/ref 17592186430458} :answer-field/id #uuid "ada42878-28c7-51a7-9c8d-0a81ac88a20f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186430531}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ce8c7ab6-3d50-5c46-82fd-86a6317c7440" :question/math-academy-id "q-146190" :question/problem "| $y$ | $2$ | $3$ | $5$ |\n| --- | --- | --- | --- |\n| ${f}_{Y|X}(y\\,|\\,3)$ | $0.25$ | $0.6$ | $0.15$ |\n\nFind the $\\text{E}[Y\\,|\\,X=3]$ given that the conditional probability mass function ${f}_{Y|X}(y\\,|\\,3)$ is shown in the table above." :question/worked-solution "The conditional expected value of  $Y$ given $X=x$ is defined by\n\n$$\n\\text{E}[Y\\,|\\,X=x]={\\sum }_{y}y\\,{f}_{Y|X}(y\\,|\\,x).\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{E}[Y\\,|\\,X=3] & ={\\sum }_{y}y\\,{f}_{Y|X}(y\\,|\\,3) \\\\  & =2\\cdot 0.25+3\\cdot 0.6+5\\cdot 0.15 \\\\  & =3.05.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186430553 :knowledge-point/_questions [{:db/id #edb/ref 17592186162123 :knowledge-point/id #uuid "e9040153-b66c-5c55-8854-8c5be0309720" :knowledge-point/title "Calculating a Conditional Expected Value Given a Conditional Mass Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24bd83e9-4aca-5cee-8abb-c5ef79d6f231" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{5}" :db/id #edb/ref 17592186430469} {:answer/id #uuid "3489b1cd-aa26-5482-95b3-77d7b787acf9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186430474} {:answer/id #uuid "41821c99-6149-54f3-ac01-33b1080a57f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{5}" :db/id #edb/ref 17592186430480} {:answer/id #uuid "860cc4fb-2f2e-5c43-99d8-5e61965e83a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186430494} {:answer/id #uuid "8fcfaa63-b43e-5f80-9493-71e97f97f080" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{12}{5}" :db/id #edb/ref 17592186430499}] :answer-field/correct {:answer/id #uuid "24bd83e9-4aca-5cee-8abb-c5ef79d6f231" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{5}" :db/id #edb/ref 17592186430469} :answer-field/id #uuid "da6775a2-3477-5814-8673-a2afece275be" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186430535}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f28e401e-edf5-5575-9abc-2915f050b3a4" :question/math-academy-id "q-146195" :question/problem "| $y$ | $1$ | $4$ |\n| --- | --- | --- |\n| ${f}_{Y|X}(y\\,|\\,6)$ | $\\frac{3}{5}$ | $\\frac{2}{5}$ |\n\nFind the $\\text{E}[Y\\,|\\,X=6]$ given that the conditional probability mass function ${f}_{Y|X}(y\\,|\\,6)$ is shown in the table above." :question/worked-solution "The conditional expected value of  $Y$ given $X=x$ is defined by\n\n$$\n\\text{E}[Y\\,|\\,X=x]={\\sum }_{y}y\\,{f}_{Y|X}(y\\,|\\,x).\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{E}[Y\\,|\\,X=6] & ={\\sum }_{y}y\\,{f}_{Y|X}(y\\,|\\,6) \\\\  & =1\\cdot \\frac{3}{5}+4\\cdot \\frac{2}{5} \\\\  & =\\frac{11}{5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186430543 :knowledge-point/_questions [{:db/id #edb/ref 17592186162126 :knowledge-point/id #uuid "59bd2280-5028-5261-a9ed-61d01d80c29a" :knowledge-point/title "Calculating a Conditional Expectation Using Row Totals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a27de06-ff08-5464-8433-0375d22e45ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186430459} {:answer/id #uuid "2af21c8e-95b7-50bb-92c2-bf26438c2d6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186430472} {:answer/id #uuid "b4b5981e-4b33-59a8-8753-4b483d248538" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186430507} {:answer/id #uuid "b8343444-95e2-5d43-8ca2-ce7af0708601" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186430509} {:answer/id #uuid "e5ba19c5-3261-564f-82c9-03af59074e8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186430519}] :answer-field/correct {:answer/id #uuid "b4b5981e-4b33-59a8-8753-4b483d248538" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186430507} :answer-field/id #uuid "b446a07a-b5b0-5499-8e0d-3c17c2bc8605" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186430534}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "39351ca5-4e9c-5435-bca1-f99ac80dd168" :question/math-academy-id "q-146217" :question/problem "| $f$ | $Y=1$ | $Y=2$ |\n| --- | --- | --- |\n| $X=1$ | $\\frac{1}{10}$ | $\\frac{1}{10}$ |\n| $X=2$ | $\\frac{2}{5}$ | $\\frac{1}{10}$ |\n| $X=3$ | $\\frac{1}{10}$ | $\\frac{1}{5}$ |\n\nFind $\\text{E}[Y\\,|\\,X=1]$ given that the random variables $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above." :question/worked-solution "Recall that the conditional expected value of  $Y$ given $X=x$ is defined by\n\n$$\n\\text{E}[Y\\,|\\,X=x]={\\sum }_{y}y\\,{f}_{Y|X}(y\\,|\\,x).\n$$\n\nIn order to find ${f}_{Y|X}(y\\,|\\,x),$ let's first find the marginal distribution for $X,$ corresponding to the row totals: \n\n| $f$ | $Y=1$ | $Y=2$ | ${f}_{X}(x)$ |\n| --- | --- | --- | --- |\n| $X=1$ | $\\frac{1}{10}$ | $\\frac{1}{10}$ | $\\frac{1}{5}$ |\n| $X=2$ | $\\frac{2}{5}$ | $\\frac{1}{10}$ | $\\frac{1}{2}$ |\n| $X=3$ | $\\frac{1}{10}$ | $\\frac{1}{5}$ | $\\frac{3}{10}$ |\n\nThe conditional probability mass function of $Y$ given that $X=x$ is\n\n$$\n{f}_{Y|X}(y\\,|\\,x)=\\frac{f(x,y)}{{f}_{X}(x)}.\n$$\n\nTherefore, dividing each joint probability by the corresponding row total, we obtain the conditional probability mass function of $Y$ given that $X=x:$\n\n| ${f}_{Y|X}(y\\,|\\,x)$ | $Y=1$ | $Y=2$ |  |\n| --- | --- | --- | --- |\n| $X=1$ | $\\frac{1}{2}$ | $\\frac{1}{2}$ | $1$ |\n| $X=2$ | $\\frac{4}{5}$ | $\\frac{1}{5}$ | $1$ |\n| $X=3$ | $\\frac{1}{3}$ | $\\frac{2}{3}$ | $1$ |\n\nFinally, we obtain\n\n$$\n\\begin{aligned}\\text{E}[Y\\,|\\,X=1] & ={\\sum }_{y}y\\,{f}_{Y|X}(y\\,|\\,1) \\\\  & =1\\cdot \\frac{1}{2}+2\\cdot \\frac{1}{2} \\\\  & =\\frac{3}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186430550 :knowledge-point/_questions [{:db/id #edb/ref 17592186162126 :knowledge-point/id #uuid "59bd2280-5028-5261-a9ed-61d01d80c29a" :knowledge-point/title "Calculating a Conditional Expectation Using Row Totals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "203a2e87-3d58-5bc6-b6d1-0a9a3a5e40e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186430467} {:answer/id #uuid "8a1066f7-bb78-5f0e-aff8-c601e183c200" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{15}{7}" :db/id #edb/ref 17592186430496} {:answer/id #uuid "b43612d7-bf1e-5f84-8191-a06a292f68a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{7}" :db/id #edb/ref 17592186430506} {:answer/id #uuid "b77fd82b-b377-58e7-a765-bf80768a969f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{5}" :db/id #edb/ref 17592186430508} {:answer/id #uuid "ca63eb7e-3b07-5c85-9289-17dcbe19c2ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186430515}] :answer-field/correct {:answer/id #uuid "b43612d7-bf1e-5f84-8191-a06a292f68a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{7}" :db/id #edb/ref 17592186430506} :answer-field/id #uuid "850ee2d1-bd49-535c-a62b-43d34186ea0e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186430530}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bb7f31f7-87d5-5229-8b2b-b9942d154a36" :question/math-academy-id "q-146228" :question/problem "| $f$ | $Y=1$ | $Y=2$ |\n| --- | --- | --- |\n| $X=2$ | $\\frac{1}{4}$ | $\\frac{1}{16}$ |\n| $X=4$ | $\\frac{3}{16}$ | $\\frac{1}{4}$ |\n| $X=6$ | $\\frac{1}{8}$ | $\\frac{1}{8}$ |\n\nFind $\\text{E}[Y\\,|\\,X=4]$ given that the random variables $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above." :question/worked-solution "Recall that the conditional expected value of  $Y$ given $X=x$ is defined by\n\n$$\n\\text{E}[Y\\,|\\,X=x]={\\sum }_{y}y\\,{f}_{Y|X}(y\\,|\\,x).\n$$\n\nIn order to find ${f}_{Y|X}(y\\,|\\,x),$ let's first find the marginal distribution for $X,$ corresponding to the row totals: \n\n| $f$ | $Y=1$ | $Y=2$ | ${f}_{X}(x)$ |\n| --- | --- | --- | --- |\n| $X=2$ | $\\frac{1}{4}$ | $\\frac{1}{16}$ | $\\frac{5}{16}$ |\n| $X=4$ | $\\frac{3}{16}$ | $\\frac{1}{4}$ | $\\frac{7}{16}$ |\n| $X=16$ | $\\frac{1}{8}$ | $\\frac{1}{8}$ | $\\frac{1}{4}$ |\n\nThe conditional probability mass function of $Y$ given that $X=x$ is\n\n$$\n{f}_{Y|X}(y\\,|\\,x)=\\frac{f(x,y)}{{f}_{X}(x)}.\n$$\n\nTherefore, dividing each joint probability by the corresponding row total, we obtain the conditional probability mass function of $Y$ given that $X=x:$\n\n| ${f}_{Y|X}(y\\,|\\,x)$ | $Y=1$ | $Y=2$ |  |\n| --- | --- | --- | --- |\n| $X=2$ | $\\frac{4}{5}$ | $\\frac{1}{5}$ | $1$ |\n| $X=4$ | $\\frac{3}{7}$ | $\\frac{4}{7}$ | $1$ |\n| $X=6$ | $\\frac{1}{2}$ | $\\frac{1}{2}$ | $1$ |\n\nFinally, we obtain\n\n$$\n\\begin{aligned}\\text{E}[Y\\,|\\,X=4] & ={\\sum }_{y}y\\,{f}_{Y|X}(y\\,|\\,4) \\\\  & =1\\cdot \\frac{3}{7}+2\\cdot \\frac{4}{7} \\\\  & =\\frac{11}{7}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186430541 :knowledge-point/_questions [{:db/id #edb/ref 17592186162126 :knowledge-point/id #uuid "59bd2280-5028-5261-a9ed-61d01d80c29a" :knowledge-point/title "Calculating a Conditional Expectation Using Row Totals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d6b8fe8-56f9-59aa-8b89-fe1537ab4b01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186430487} {:answer/id #uuid "931b6f66-e009-56b0-84c9-c7b511351fcb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{4}" :db/id #edb/ref 17592186430501} {:answer/id #uuid "a028479d-d79f-5a1c-9d56-22c577bb86aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{2}" :db/id #edb/ref 17592186430504} {:answer/id #uuid "ee2c88ed-6294-5eab-8b70-7693a739d009" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186430522} {:answer/id #uuid "faec11ff-711a-5f97-839f-60ad7bc32805" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{4}" :db/id #edb/ref 17592186430524}] :answer-field/correct {:answer/id #uuid "6d6b8fe8-56f9-59aa-8b89-fe1537ab4b01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186430487} :answer-field/id #uuid "835c9abf-c451-5b78-b156-3604c5d60e7c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186430529}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "26cf687b-fdce-54b3-aa67-a91fa8446cfe" :question/math-academy-id "q-146231" :question/problem "| $f$ | $Y=2$ | $Y=4$ | $Y=6$ |\n| --- | --- | --- | --- |\n| $X=1$ | $\\frac{1}{8}$ | $\\frac{1}{8}$ | $\\frac{1}{4}$ |\n| $X=2$ | $\\frac{1}{4}$ | $\\frac{1}{16}$ | $\\frac{3}{16}$ |\n\nFind $\\text{E}[Y\\,|\\,X=1]$ given that the random variables $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above." :question/worked-solution "Recall that the conditional expected value of  $Y$ given $X=x$ is defined by\n\n$$\n\\text{E}[Y\\,|\\,X=x]={\\sum }_{y}y\\,{f}_{Y|X}(y\\,|\\,x).\n$$\n\nIn order to find ${f}_{Y|X}(y\\,|\\,x),$ let's first find the marginal distribution for $X,$ corresponding to the row totals: \n\n| $f$ | $Y=2$ | $Y=4$ | $Y=6$ | ${f}_{X}(x)$ |\n| --- | --- | --- | --- | --- |\n| $X=1$ | $\\frac{1}{8}$ | $\\frac{1}{8}$ | $\\frac{1}{4}$ | $\\frac{1}{2}$ |\n| $X=2$ | $\\frac{1}{4}$ | $\\frac{1}{16}$ | $\\frac{3}{16}$ | $\\frac{1}{2}$ |\n\nThe conditional probability mass function of $Y$ given that $X=x$ is\n\n$$\n{f}_{Y|X}(y\\,|\\,x)=\\frac{f(x,y)}{{f}_{X}(x)}.\n$$\n\nTherefore, dividing each joint probability by the corresponding row total, we obtain the conditional probability mass function of $Y$ given that $X=x:$\n\n| ${f}_{Y|X}(y\\,|\\,x)$ | $Y=2$ | $Y=4$ | $Y=6$ |  |\n| --- | --- | --- | --- | --- |\n| $X=1$ | $\\frac{1}{4}$ | $\\frac{1}{4}$ | $\\frac{1}{2}$ | $1$ |\n| $X=2$ | $\\frac{1}{2}$ | $\\frac{1}{8}$ | $\\frac{3}{8}$ | $1$ |\n\nFinally, we obtain\n\n$$\n\\begin{aligned}\\text{E}[Y\\,|\\,X=1] & ={\\sum }_{y}y\\,{f}_{Y|X}(y\\,|\\,1) \\\\  & =2\\cdot \\frac{1}{4}+4\\cdot \\frac{1}{4}+6\\cdot \\frac{1}{2} \\\\  & =\\frac{1}{2}+1+3 \\\\  & =\\frac{9}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186430540 :knowledge-point/_questions [{:db/id #edb/ref 17592186162126 :knowledge-point/id #uuid "59bd2280-5028-5261-a9ed-61d01d80c29a" :knowledge-point/title "Calculating a Conditional Expectation Using Row Totals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e57c085-bef8-5b19-96ef-660405e46e23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186430477} {:answer/id #uuid "3f535cc8-b1c1-5320-aa7c-2bb3717ae519" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186430478} {:answer/id #uuid "5113d4f2-d040-55bb-8718-e7866220b1a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186430485} {:answer/id #uuid "751bca34-df20-599a-ba4a-2a74babb6229" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186430488} {:answer/id #uuid "b25405f2-5401-55f8-bb8b-3f8bf7ab02cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{3}" :db/id #edb/ref 17592186430505}] :answer-field/correct {:answer/id #uuid "3f535cc8-b1c1-5320-aa7c-2bb3717ae519" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186430478} :answer-field/id #uuid "fb992380-62f1-562c-8eda-7def00bd1a46" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186430539}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "140a6023-d1bd-5fed-ac27-734185236cc4" :question/math-academy-id "q-146243" :question/problem "| $f$ | $Y=1$ | $Y=2$ |\n| --- | --- | --- |\n| $X=0$ | $\\frac{1}{4}$ | $\\frac{1}{2}$ |\n| $X=4$ | $\\frac{1}{8}$ | $\\frac{1}{8}$ |\n\nFind $\\text{E}[Y\\,|\\,X=0]$ given that the random variables $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above." :question/worked-solution "Recall that the conditional expected value of  $Y$ given $X=x$ is defined by\n\n$$\n\\text{E}[Y\\,|\\,X=x]={\\sum }_{y}y\\,{f}_{Y|X}(y\\,|\\,x).\n$$\n\nIn order to find ${f}_{Y|X}(y\\,|\\,x),$ let's first find the marginal distribution for $X,$ corresponding to the row totals: \n\n| $f$ | $Y=1$ | $Y=2$ | ${f}_{X}(x)$ |\n| --- | --- | --- | --- |\n| $X=0$ | $\\frac{1}{4}$ | $\\frac{1}{2}$ | $\\frac{3}{4}$ |\n| $X=4$ | $\\frac{1}{8}$ | $\\frac{1}{8}$ | $\\frac{1}{4}$ |\n\nThe conditional probability mass function of $Y$ given that $X=x$ is\n\n$$\n{f}_{Y|X}(y\\,|\\,x)=\\frac{f(x,y)}{{f}_{X}(x)}.\n$$\n\nTherefore, dividing each joint probability by the corresponding row total, we obtain the conditional probability mass function of $Y$ given that $X=x:$\n\n| ${f}_{Y|X}(y\\,|\\,x)$ | $Y=1$ | $Y=2$ |  |\n| --- | --- | --- | --- |\n| $X=0$ | $\\frac{1}{3}$ | $\\frac{2}{3}$ | $1$ |\n| $X=4$ | $\\frac{1}{2}$ | $\\frac{1}{2}$ | $1$ |\n\nFinally, we obtain\n\n$$\n\\begin{aligned}\\text{E}[Y\\,|\\,X=0] & ={\\sum }_{y}y\\,{f}_{Y|X}(y\\,|\\,0) \\\\  & =1\\cdot \\frac{1}{3}+2\\cdot \\frac{2}{3} \\\\  & =\\frac{5}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186162428 :knowledge-point/_questions [{:db/id #edb/ref 17592186162126 :knowledge-point/id #uuid "59bd2280-5028-5261-a9ed-61d01d80c29a" :knowledge-point/title "Calculating a Conditional Expectation Using Row Totals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d9887025-89a2-5bd7-a74f-b101df7d541c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{6}" :db/id #edb/ref 17592186159771} {:answer/id #uuid "e389798f-f44e-5b5b-afcd-2e7852474619" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{3}" :db/id #edb/ref 17592186159772} {:answer/id #uuid "04531933-c48e-5b18-b0b0-c0907b8ac81a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186159773} {:answer/id #uuid "46a6904a-9a4b-5f70-b8cc-c0f4f9a23923" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10}{3}" :db/id #edb/ref 17592186159774} {:answer/id #uuid "6245a964-4af7-5b27-bc90-58eca4710df2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186159775}] :answer-field/correct {:answer/id #uuid "04531933-c48e-5b18-b0b0-c0907b8ac81a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186159773} :answer-field/id #uuid "e55a32c3-ff9a-5ff5-80ee-6d10e0e5e4ca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186159770}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "449949db-2f44-58fe-9afc-0f4fff6f21fd" :question/math-academy-id "q-146248" :question/problem "| $f$ | $Y=0$ | $Y=2$ | $Y=4$ |\n| --- | --- | --- | --- |\n| $X=0$ | $\\frac{1}{9}$ | $\\frac{3}{18}$ | $\\frac{1}{18}$ |\n| $X=2$ | $\\frac{1}{3}$ | $\\frac{1}{9}$ | $\\frac{2}{9}$ |\n\nFind $\\text{E}[Y\\,|\\,X=2]$ given that the random variables $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above." :question/worked-solution "Recall that the conditional expected value of  $Y$ given $X=x$ is defined by\n\n$$\n\\text{E}[Y\\,|\\,X=x]={\\sum }_{y}y\\,{f}_{Y|X}(y\\,|\\,x).\n$$\n\nIn order to find ${f}_{Y|X}(y\\,|\\,x),$ let's first find the marginal distribution for $X,$ corresponding to the row totals: \n\n| $f$ | $Y=0$ | $Y=2$ | $Y=4$ | ${f}_{X}(x)$ |\n| --- | --- | --- | --- | --- |\n| $X=0$ | $\\frac{1}{9}$ | $\\frac{3}{18}$ | $\\frac{1}{18}$ | $\\frac{1}{3}$ |\n| $X=2$ | $\\frac{1}{3}$ | $\\frac{1}{9}$ | $\\frac{2}{9}$ | $\\frac{2}{3}$ |\n\nThe conditional probability mass function of $Y$ given that $X=x$ is\n\n$$\n{f}_{Y|X}(y\\,|\\,x)=\\frac{f(x,y)}{{f}_{X}(x)}.\n$$\n\nTherefore, dividing each joint probability by the corresponding row total, we obtain the conditional probability mass function of $Y$ given that $X=x:$\n\n| ${f}_{Y|X}(y\\,|\\,x)$ | $Y=0$ | $Y=2$ | $Y=4$ |  |\n| --- | --- | --- | --- | --- |\n| $X=0$ | $\\frac{1}{3}$ | $\\frac{1}{2}$ | $\\frac{1}{6}$ | $1$ |\n| $X=2$ | $\\frac{1}{2}$ | $\\frac{1}{6}$ | $\\frac{1}{3}$ | $1$ |\n\nFinally, we obtain\n\n$$\n\\begin{aligned}\\text{E}[Y\\,|\\,X=2] & ={\\sum }_{y}y\\,{f}_{Y|X}(y\\,|\\,2) \\\\  & =0\\cdot \\frac{1}{2}+2\\cdot \\frac{1}{6}+4\\cdot \\frac{1}{3} \\\\  & =\\frac{5}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186430544 :knowledge-point/_questions [{:db/id #edb/ref 17592186162133 :knowledge-point/id #uuid "8e47d5ac-cb51-5259-ba41-6c407a992271" :knowledge-point/title "Calculating a Conditional Expectation Using Column Totals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b7f7bee-bbb0-5712-93eb-4602e11471f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{31}{23}" :db/id #edb/ref 17592186430460} {:answer/id #uuid "1991bab4-49b8-54dd-b4f6-f2270e903d54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{20}{13}" :db/id #edb/ref 17592186430463} {:answer/id #uuid "4a003ac7-9d7e-557a-a545-ad6ec63a5035" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{27}{13}" :db/id #edb/ref 17592186430483} {:answer/id #uuid "8f463d0f-88db-5888-87fa-99da129c4406" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{25}{13}" :db/id #edb/ref 17592186430498} {:answer/id #uuid "e23a8846-4f4a-5ed8-8760-2d5add78477f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{27}{23}" :db/id #edb/ref 17592186430518}] :answer-field/correct {:answer/id #uuid "4a003ac7-9d7e-557a-a545-ad6ec63a5035" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{27}{13}" :db/id #edb/ref 17592186430483} :answer-field/id #uuid "79907d47-1504-5e91-bf3a-7e83b5cf4a38" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186430528}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5f79f694-778f-5d59-a788-db878bd2c81e" :question/math-academy-id "q-146269" :question/problem "| $f$ | $Y=0$ | $Y=3$ |\n| --- | --- | --- |\n| $X=1$ | $\\frac{1}{6}$ | $\\frac{1}{12}$ |\n| $X=2$ | $\\frac{5}{12}$ | $\\frac{1}{6}$ |\n| $X=3$ | $\\frac{1}{18}$ | $\\frac{1}{9}$ |\n\nFind $\\text{E}[X\\,|\\,Y=3]$ given that the random variables $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above." :question/worked-solution "Recall that the conditional expected value of  $X$ given $Y=y$ is defined by\n\n$$\n\\text{E}[X\\,|\\,Y=y]={\\sum }_{x}x\\,{f}_{X|Y}(x\\,|\\,y).\n$$\n\nIn order to find ${f}_{X|Y}(x\\,|\\,y),$ let's first find the marginal distribution for $Y,$ corresponding to the column totals: \n\n| $f$ | $Y=0$ | $Y=3$ |\n| --- | --- | --- |\n| $X=1$ | $\\frac{1}{6}$ | $\\frac{1}{12}$ |\n| $X=2$ | $\\frac{5}{12}$ | $\\frac{1}{6}$ |\n| $X=3$ | $\\frac{1}{18}$ | $\\frac{1}{9}$ |\n| ${f}_{Y}(y)$ | $\\frac{23}{36}$ | $\\frac{13}{36}$ |\n\nThe conditional probability mass function of $X$ given that $Y=y$ is\n\n$$\n{f}_{X|Y}(x\\,|\\,y)=\\frac{f(x,y)}{{f}_{Y}(y)}.\n$$\n\nTherefore, dividing each joint probability by the corresponding column total, we obtain the conditional probability mass function of $X$ given that $Y=y:$\n\n| ${f}_{X|Y}(x\\,|\\,y)$ | $Y=0$ | $Y=3$ |\n| --- | --- | --- |\n| $X=1$ | $\\frac{6}{23}$ | $\\frac{3}{13}$ |\n| $X=2$ | $\\frac{15}{23}$ | $\\frac{6}{13}$ |\n| $X=3$ | $\\frac{2}{23}$ | $\\frac{4}{13}$ |\n|  | $1$ | $1$ |\n\nFinally, we obtain\n\n$$\n\\begin{aligned}\\text{E}[X\\,|\\,Y=3] & ={\\sum }_{x}x\\,{f}_{X|Y}(x\\,|\\,3) \\\\  & =1\\cdot \\frac{3}{13}+2\\cdot \\frac{6}{13}+3\\cdot \\frac{4}{13} \\\\  & =\\frac{27}{13}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186430546 :knowledge-point/_questions [{:db/id #edb/ref 17592186162133 :knowledge-point/id #uuid "8e47d5ac-cb51-5259-ba41-6c407a992271" :knowledge-point/title "Calculating a Conditional Expectation Using Column Totals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24fc62b0-3dba-54e8-b983-afdecb5c2cdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{23}{17}" :db/id #edb/ref 17592186430470} {:answer/id #uuid "5090b2a9-387a-54aa-9b1e-641e511dd5dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{23}{10}" :db/id #edb/ref 17592186430484} {:answer/id #uuid "850d7772-eb78-5b12-9250-109f9ce8268a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{19}{10}" :db/id #edb/ref 17592186430492} {:answer/id #uuid "ba410149-bfd2-57c3-88d6-f4378e3f5776" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{21}{10}" :db/id #edb/ref 17592186430510} {:answer/id #uuid "c445a323-da65-56bf-92cb-33fca15466a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{21}{17}" :db/id #edb/ref 17592186430513}] :answer-field/correct {:answer/id #uuid "5090b2a9-387a-54aa-9b1e-641e511dd5dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{23}{10}" :db/id #edb/ref 17592186430484} :answer-field/id #uuid "ddbbb6b1-d3fb-55d3-9d3f-866654dc76c0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186430536}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8aa088c8-e9f1-58c7-81a8-b2d5b673243c" :question/math-academy-id "q-146273" :question/problem "| $f$ | $Y=2$ | $Y=4$ |\n| --- | --- | --- |\n| $X=1$ | $\\frac{1}{9}$ | $\\frac{1}{9}$ |\n| $X=2$ | $\\frac{1}{3}$ | $\\frac{1}{27}$ |\n| $X=3$ | $\\frac{5}{27}$ | $\\frac{2}{9}$ |\n\nFind $\\text{E}[X\\,|\\,Y=4]$ given that the random variables $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above." :question/worked-solution "Recall that the conditional expected value of  $X$ given $Y=y$ is defined by\n\n$$\n\\text{E}[X\\,|\\,Y=y]={\\sum }_{x}x\\,{f}_{X|Y}(x\\,|\\,y).\n$$\n\nIn order to find ${f}_{X|Y}(x\\,|\\,y),$ let's first find the marginal distribution for $Y,$ corresponding to the column totals: \n\n| $f$ | $Y=2$ | $Y=4$ |\n| --- | --- | --- |\n| $X=1$ | $\\frac{1}{9}$ | $\\frac{1}{9}$ |\n| $X=2$ | $\\frac{1}{3}$ | $\\frac{1}{27}$ |\n| $X=3$ | $\\frac{5}{27}$ | $\\frac{2}{9}$ |\n| ${f}_{Y}(y)$ | $\\frac{17}{27}$ | $\\frac{10}{27}$ |\n\nThe conditional probability mass function of $X$ given that $Y=y$ is\n\n$$\n{f}_{X|Y}(x\\,|\\,y)=\\frac{f(x,y)}{{f}_{Y}(y)}.\n$$\n\nTherefore, dividing each joint probability by the corresponding column total, we obtain the conditional probability mass function of $X$ given that $Y=y:$\n\n| ${f}_{X|Y}(x\\,|\\,y)$ | $Y=2$ | $Y=4$ |\n| --- | --- | --- |\n| $X=1$ | $\\frac{3}{17}$ | $\\frac{3}{10}$ |\n| $X=2$ | $\\frac{9}{17}$ | $\\frac{1}{10}$ |\n| $X=3$ | $\\frac{5}{17}$ | $\\frac{3}{5}$ |\n|  | $1$ | $1$ |\n\nFinally, we obtain\n\n$$\n\\begin{aligned}\\text{E}[X\\,|\\,Y=4] & ={\\sum }_{x}x\\,{f}_{X|Y}(x\\,|\\,4) \\\\  & =1\\cdot \\frac{3}{10}+2\\cdot \\frac{1}{10}+3\\cdot \\frac{3}{5} \\\\  & =\\frac{3}{10}+2 \\\\  & =\\frac{23}{10}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186430545 :knowledge-point/_questions [{:db/id #edb/ref 17592186162133 :knowledge-point/id #uuid "8e47d5ac-cb51-5259-ba41-6c407a992271" :knowledge-point/title "Calculating a Conditional Expectation Using Column Totals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29ce2577-7b12-5b69-bf4f-e7ef0beae6fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186430471} {:answer/id #uuid "3a42be61-22c5-534f-8367-1f2b6a83efcd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{5}" :db/id #edb/ref 17592186430476} {:answer/id #uuid "89662e88-e4b9-5dff-908a-c5a610a568d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{4}" :db/id #edb/ref 17592186430495} {:answer/id #uuid "c275e15d-7427-5179-9ff7-1b9970ae80ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{12}{5}" :db/id #edb/ref 17592186430511} {:answer/id #uuid "d933d782-b1ae-598e-96f1-84f2b07f3337" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{4}" :db/id #edb/ref 17592186430517}] :answer-field/correct {:answer/id #uuid "3a42be61-22c5-534f-8367-1f2b6a83efcd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{5}" :db/id #edb/ref 17592186430476} :answer-field/id #uuid "af90d537-2226-55dc-b3c7-825175a82cc4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186430532}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "772539cc-05a8-509a-9c28-5f9d52c588ed" :question/math-academy-id "q-146277" :question/problem "| $f$ | $Y=3$ | $Y=5$ |\n| --- | --- | --- |\n| $X=1$ | $\\frac{1}{9}$ | $\\frac{2}{9}$ |\n| $X=3$ | $\\frac{1}{3}$ | $\\frac{1}{3}$ |\n\nFind $\\text{E}[X\\,|\\,Y=5]$ given that the random variables $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above." :question/worked-solution "Recall that the conditional expected value of  $X$ given $Y=y$ is defined by\n\n$$\n\\text{E}[X\\,|\\,Y=y]={\\sum }_{x}x\\,{f}_{X|Y}(x\\,|\\,y).\n$$\n\nIn order to find ${f}_{X|Y}(x\\,|\\,y),$ let's first find the marginal distribution for $Y,$ corresponding to the column totals: \n\n| $f$ | $Y=3$ | $Y=5$ |\n| --- | --- | --- |\n| $X=1$ | $\\frac{1}{9}$ | $\\frac{2}{9}$ |\n| $X=3$ | $\\frac{1}{3}$ | $\\frac{1}{3}$ |\n| ${f}_{Y}(y)$ | $\\frac{4}{9}$ | $\\frac{5}{9}$ |\n\nThe conditional probability mass function of $X$ given that $Y=y$ is\n\n$$\n{f}_{X|Y}(x\\,|\\,y)=\\frac{f(x,y)}{{f}_{Y}(y)}.\n$$\n\nTherefore, dividing each joint probability by the corresponding column total, we obtain the conditional probability mass function of $X$ given that $Y=y:$\n\n| ${f}_{X|Y}(x\\,|\\,y)$ | $Y=3$ | $Y=5$ |\n| --- | --- | --- |\n| $X=1$ | $\\frac{1}{4}$ | $\\frac{2}{5}$ |\n| $X=3$ | $\\frac{3}{4}$ | $\\frac{3}{5}$ |\n|  | $1$ | $1$ |\n\nFinally, we obtain\n\n$$\n\\begin{aligned}\\text{E}[X\\,|\\,Y=5] & ={\\sum }_{x}x\\,{f}_{X|Y}(x\\,|\\,5) \\\\  & =1\\cdot \\frac{2}{5}+3\\cdot \\frac{3}{5} \\\\  & =\\frac{11}{5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186430552 :knowledge-point/_questions [{:db/id #edb/ref 17592186162133 :knowledge-point/id #uuid "8e47d5ac-cb51-5259-ba41-6c407a992271" :knowledge-point/title "Calculating a Conditional Expectation Using Column Totals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1efd0d99-8bf2-51e6-9811-f57601cb3164" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{6}" :db/id #edb/ref 17592186430466} {:answer/id #uuid "24080fff-d155-550a-9fea-c2aa82e94ae7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{14}{3}" :db/id #edb/ref 17592186430468} {:answer/id #uuid "9476e763-4c3c-54c6-a0c8-076e92e15e0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10}{3}" :db/id #edb/ref 17592186430502} {:answer/id #uuid "f27ea431-e80b-53d4-9c3a-bd97a2ed2813" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186430523} {:answer/id #uuid "fda16633-07f3-5c38-b3b7-2e49f834df6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{3}" :db/id #edb/ref 17592186430525}] :answer-field/correct {:answer/id #uuid "9476e763-4c3c-54c6-a0c8-076e92e15e0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10}{3}" :db/id #edb/ref 17592186430502} :answer-field/id #uuid "f8b2222a-a8b2-53ca-a03a-b94a200b38c9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186430538}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d4b4bf79-088a-5fc8-9216-d79eb330f015" :question/math-academy-id "q-146285" :question/problem "| $f$ | $Y=4$ | $Y=5$ |\n| --- | --- | --- |\n| $X=1$ | $\\frac{1}{12}$ | $\\frac{1}{6}$ |\n| $X=3$ | $\\frac{1}{6}$ | $\\frac{1}{12}$ |\n| $X=5$ | $\\frac{1}{4}$ | $\\frac{1}{4}$ |\n\nFind $\\text{E}[X\\,|\\,Y=5]$ given that the random variables $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above." :question/worked-solution "Recall that the conditional expected value of  $X$ given $Y=y$ is defined by\n\n$$\n\\text{E}[X\\,|\\,Y=y]={\\sum }_{x}x\\,{f}_{X|Y}(x\\,|\\,y).\n$$\n\nIn order to find ${f}_{X|Y}(x\\,|\\,y),$ let's first find the marginal distribution for $Y,$ corresponding to the column totals: \n\n| $f$ | $Y=4$ | $Y=5$ |\n| --- | --- | --- |\n| $X=1$ | $\\frac{1}{12}$ | $\\frac{1}{6}$ |\n| $X=3$ | $\\frac{1}{6}$ | $\\frac{1}{12}$ |\n| $X=5$ | $\\frac{1}{4}$ | $\\frac{1}{4}$ |\n| ${f}_{Y}(y)$ | $\\frac{1}{2}$ | $\\frac{1}{2}$ |\n\nThe conditional probability mass function of $X$ given that $Y=y$ is\n\n$$\n{f}_{X|Y}(x\\,|\\,y)=\\frac{f(x,y)}{{f}_{Y}(y)}.\n$$\n\nTherefore, dividing each joint probability by the corresponding column total, we obtain the conditional probability mass function of $X$ given that $Y=y:$\n\n| ${f}_{X|Y}(x\\,|\\,y)$ | $Y=4$ | $Y=5$ |\n| --- | --- | --- |\n| $X=1$ | $\\frac{1}{6}$ | $\\frac{1}{3}$ |\n| $X=3$ | $\\frac{1}{3}$ | $\\frac{1}{6}$ |\n| $X=5$ | $\\frac{1}{2}$ | $\\frac{1}{2}$ |\n|  | $1$ | $1$ |\n\nFinally, we obtain\n\n$$\n\\begin{aligned}\\text{E}[X\\,|\\,Y=5] & ={\\sum }_{x}x\\,{f}_{X|Y}(x\\,|\\,5) \\\\  & =1\\cdot \\frac{1}{3}+3\\cdot \\frac{1}{6}+5\\cdot \\frac{1}{2} \\\\  & =\\frac{1}{3}+3 \\\\  & =\\frac{10}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186430548 :knowledge-point/_questions [{:db/id #edb/ref 17592186162133 :knowledge-point/id #uuid "8e47d5ac-cb51-5259-ba41-6c407a992271" :knowledge-point/title "Calculating a Conditional Expectation Using Column Totals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19f056e4-3325-5f66-8071-2407f11d4bc8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{16}{5}" :db/id #edb/ref 17592186430464} {:answer/id #uuid "3a1fe014-940d-5195-b2a9-07750832a771" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{20}{3}" :db/id #edb/ref 17592186430475} {:answer/id #uuid "84aa4f2d-de88-5e30-8118-904ad76280e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{16}{3}" :db/id #edb/ref 17592186430491} {:answer/id #uuid "c4d4542b-e41d-5aa5-b77f-61338768d4ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{3}" :db/id #edb/ref 17592186430514} {:answer/id #uuid "d5aa0e64-7998-506a-b005-217cd2d97fd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{14}{5}" :db/id #edb/ref 17592186430516}] :answer-field/correct {:answer/id #uuid "84aa4f2d-de88-5e30-8118-904ad76280e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{16}{3}" :db/id #edb/ref 17592186430491} :answer-field/id #uuid "0209e7c1-5b71-52a4-b949-2b70cb41a46a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186430526}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a956b539-c977-51d6-9b04-f769aaa2a1a8" :question/math-academy-id "q-146286" :question/problem "| $f$ | $Y=0$ | $Y=1$ |\n| --- | --- | --- |\n| $X=5$ | $\\frac{1}{5}$ | $\\frac{2}{5}$ |\n| $X=6$ | $\\frac{1}{10}$ | $\\frac{3}{10}$ |\n\nFind $\\text{E}[X\\,|\\,Y=0]$ given that the random variables $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above." :question/worked-solution "Recall that the conditional expected value of  $X$ given $Y=y$ is defined by\n\n$$\n\\text{E}[X\\,|\\,Y=y]={\\sum }_{x}x\\,{f}_{X|Y}(x\\,|\\,y).\n$$\n\nIn order to find ${f}_{X|Y}(x\\,|\\,y),$ let's first find the marginal distribution for $Y,$ corresponding to the column totals: \n\n| $f$ | $Y=0$ | $Y=1$ |\n| --- | --- | --- |\n| $X=5$ | $\\frac{1}{5}$ | $\\frac{2}{5}$ |\n| $X=6$ | $\\frac{1}{10}$ | $\\frac{3}{10}$ |\n| ${f}_{Y}(y)$ | $\\frac{3}{10}$ | $\\frac{7}{10}$ |\n\nThe conditional probability mass function of $X$ given that $Y=y$ is\n\n$$\n{f}_{X|Y}(x\\,|\\,y)=\\frac{f(x,y)}{{f}_{Y}(y)}.\n$$\n\nTherefore, dividing each joint probability by the corresponding column total, we obtain the conditional probability mass function of $X$ given that $Y=y:$\n\n| ${f}_{X|Y}(x\\,|\\,y)$ | $Y=0$ | $Y=1$ |\n| --- | --- | --- |\n| $X=5$ | $\\frac{2}{3}$ | $\\frac{4}{7}$ |\n| $X=6$ | $\\frac{1}{3}$ | $\\frac{3}{7}$ |\n|  | $1$ | $1$ |\n\nFinally, we obtain\n\n$$\n\\begin{aligned}\\text{E}[X\\,|\\,Y=0] & ={\\sum }_{x}x\\,{f}_{X|Y}(x\\,|\\,0) \\\\  & =5\\cdot \\frac{2}{3}+6\\cdot \\frac{1}{3} \\\\  & =\\frac{16}{3}.\\end{aligned}\n$$"}]}
