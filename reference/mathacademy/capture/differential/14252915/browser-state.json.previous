      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14252915/observations/step-q72344-cc0fae2f62fa8c56db5a.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14252915/observations/step-q72344-cc0fae2f62fa8c56db5a.png",
