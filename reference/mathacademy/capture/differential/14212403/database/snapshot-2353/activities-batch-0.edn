Product Form"} :step/id #uuid "213ff9e2-fe7a-528b-b535-4cf580c6aca9" :step/math-academy-id 17942 :step/next {:db/id #edb/ref 17592186120727}} {:db/id #edb/ref 17592186120727 :step/content {:db/id #edb/ref 17592186119841 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119655 :question/id #uuid "1538dde4-ab62-502e-8efe-7f37628ab861" :question/math-academy-id "e-4951"} :knowledge-point/id #uuid "489887a0-7013-5fb2-8f16-d18616196b0f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050830}] :knowledge-point/questions [{:db/id #edb/ref 17592186120250} {:db/id #edb/ref 17592186120296} {:db/id #edb/ref 17592186262956} {:db/id #edb/ref 17592186262958} {:db/id #edb/ref 17592186262959} {:db/id #edb/ref 17592186262960} {:db/id #edb/ref 17592186262961} {:db/id #edb/ref 17592186262962} {:db/id #edb/ref 17592186348333} {:db/id #edb/ref 17592186348334} {:db/id #edb/ref 17592186348335} {:db/id #edb/ref 17592186348336} {:db/id #edb/ref 17592186348337} {:db/id #edb/ref 17592186348338} {:db/id #edb/ref 17592186443266} {:db/id #edb/ref 17592186476957}] :knowledge-point/title "Finding the Shortest Distance Between a Point and a Plane Given in Cartesian Form"} :step/id #uuid "fdb4920a-a24d-544c-bdef-93ed800bfdd9" :step/math-academy-id 17943}] :activity/title "The Shortest Distance Between a Plane and a Point" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186120020}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186477001} :activity/id #uuid "607e9414-4918-5745-b10c-99f76f09cb79" :activity/scope {:db/id #edb/ref 17592186049322 :topic/id #uuid "ebecad61-07fb-5ecb-9dcd-758d5fa56d82" :topic/math-academy-id 1810} :activity/steps [{:db/id #edb/ref 17592186476980 :step/content {:db/id #edb/ref 17592186262962 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b72bdaf-c17d-5a6f-a26c-13328e45c2b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186260407} {:answer/id #uuid "63966b3b-7d0f-548b-957a-4189afb5ebfe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186260734} {:answer/id #uuid "654695db-ae2f-5c0a-8492-ff72aa97f271" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186260751} {:answer/id #uuid "ae41e977-6f41-536e-a881-63dadca54693" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186261412} {:answer/id #uuid "f0ec70a3-7571-53d4-a32a-f4786362a4c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186261986}] :answer-field/correct {:db/id #edb/ref 17592186260734} :answer-field/id #uuid "bc0d9b85-acc6-5956-920a-859f666ff369" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186262466}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8fc468d7-8c5a-51cb-a422-a6e8deebdd30" :question/math-academy-id "q-129166" :question/problem "Find the shortest distance between the point $P(-2,3,-6)$ and the plane $Π$ with equation $-x+2y+2z=8.$" :question/worked-solution "Let's start by picking a point on the plane. To do that, we simply substitute some concrete values for $x$ and $y$ into the equation and solve for $z.$ Let's choose $x=-2$ and $y=1$ (though it doesn't really matter what values we choose). Solving for $z,$ we get \n\n$$\n\\begin{aligned}-x+2y+2z & =8 \\\\ -1(-2)+2(1)+2z & =8 \\\\ 2z & =4 \\\\ z & =2.\\end{aligned}\n$$\n\nSo, we get the point $Q(-2,1,2)$ which lies on the plane.\n\nComputing $\\overset{\\to }{PQ},$ we get\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨-2,1,2⟩-⟨-2,3,-6⟩ \\\\  & =⟨0,-2,8⟩.\\end{aligned}\n$$\n\nWe also need a normal vector to the plane. For any Cartesian equation of a plane $ax+by+cz=d,$ the normal vector is $n=⟨a,b,c⟩.$ So, for the plane $Π,$ we have $n=⟨-1,2,2⟩.$ \n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|0\\cdot (-1)+(-2)\\cdot 2+8\\cdot 2|}{\\sqrt{(-1)^{2}+{2}^{2}+{2}^{2}}} \\\\  & =\\frac{|0-4+16|}{\\sqrt{1+4+4}} \\\\  & =\\frac{|12|}{\\sqrt{9}} \\\\  & =\\frac{12}{3} \\\\  & =4.\\end{aligned}\n$$"} :step/id #uuid "14537fa3-6b22-5ad7-8a11-c7c69ec06d24"} {:db/id #edb/ref 17592186476984 :step/content {:db/id #edb/ref 17592186262941 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "129b0757-3ac6-5753-b6e3-478a8023eb52" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186260037} {:answer/id #uuid "4de222b6-19ed-5d3c-a87c-f1b937df4849" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186260536} {:answer/id #uuid "65ac176a-0b06-5588-9781-22d9e0435725" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186260758} {:answer/id #uuid "816e3b5d-f9fa-5bd9-b29d-3f7e216e3a23" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186261004} {:answer/id #uuid "df122527-7c53-5616-83fd-4d0c7dd7847e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186261846}] :answer-field/correct {:db/id #edb/ref 17592186260536} :answer-field/id #uuid "ffc75d90-c023-5fb9-a940-576505f511c9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186262570}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0498861d-e4e1-5581-aee5-353d6a78f4f9" :question/math-academy-id "q-129102" :question/problem "Given that $Q(4,-2,8)$ lies on the plane $Π:r\\cdot ⟨-3,6,2⟩=-8$, find the shortest distance from $P(3,-4,2)$ to $Π.$" :question/worked-solution "First, we find\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨4,-2,8⟩-⟨3,-4,2⟩ \\\\  & =⟨1,2,6⟩.\\end{aligned}\n$$\n\nFrom the equation of the plane, we get the normal vector $n=⟨-3,6,2⟩.$ \n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|1\\cdot (-3)+2\\cdot 6+6\\cdot 2|}{\\sqrt{(-3)^{2}+{6}^{2}+{2}^{2}}} \\\\  & =\\frac{|-3+12+12|}{\\sqrt{9+36+4}} \\\\  & =\\frac{|21|}{\\sqrt{49}} \\\\  & =\\frac{21}{7} \\\\  & =3.\\end{aligned}\n$$"} :step/id #uuid "40058c5d-013f-5ce7-9c88-237da66a5575" :step/next {:db/id #edb/ref 17592186476987}} {:db/id #edb/ref 17592186476987 :step/content {:db/id #edb/ref 17592186262942 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b8f6350-fb69-5a5b-bb29-e322e7c392a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186260261} {:answer/id #uuid "5f24cf3d-cea3-54d1-9eda-cbee7058c868" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186260695} {:answer/id #uuid "78b2e517-ef5a-50b6-a3c1-b0a7028cba72" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186260933} {:answer/id #uuid "964b77d2-f08c-5b17-8d73-500caab4ed24" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186261176} {:answer/id #uuid "baf43eb1-d821-5887-8947-2e31570cd345" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186261518}] :answer-field/correct {:db/id #edb/ref 17592186260695} :answer-field/id #uuid "bdb5524e-d28d-538f-a91e-26dfa96b9bfb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186262469}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6c91ce04-7e86-5b0f-8e36-5b36844cedf2" :question/math-academy-id "q-129103" :question/problem "Given that $Q(3,-4,5)$ lies on the plane $Π:r\\cdot ⟨-2,4,-4⟩=-42$, find the shortest distance from $P(1,-5,2)$ to $Π.$" :question/worked-solution "First, we find\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨3,-4,5⟩-⟨1,-5,2⟩ \\\\  & =⟨2,1,3⟩.\\end{aligned}\n$$\n\nFrom the equation of the plane, we get the normal vector $n=⟨-2,4,-4⟩.$ \n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|2\\cdot (-2)+1\\cdot 4+3\\cdot (-4)|}{\\sqrt{(-2)^{2}+{4}^{2}+(-4)^{2}}} \\\\  & =\\frac{|-4+4-12|}{\\sqrt{4+16+16}} \\\\  & =\\frac{|-12|}{\\sqrt{36}} \\\\  & =\\frac{12}{6} \\\\  & =2.\\end{aligned}\n$$"} :step/id #uuid "5bfda559-d502-5665-9d67-d803ab540b42" :step/next {:db/id #edb/ref 17592186476996}} {:db/id #edb/ref 17592186476996 :step/content {:db/id #edb/ref 17592186476957 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e1b5af0-a05c-505e-b5bf-10afc44fa4fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186476267} {:answer/id #uuid "3016c831-e8f4-5651-b74c-6377c71dd95f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186476309} {:answer/id #uuid "4275d3b1-6448-558a-b4a5-a4d62b2ac4d8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{7}" :db/id #edb/ref 17592186476347} {:answer/id #uuid "cebc6772-d1ae-5b50-bd1a-7a34f67a24f9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{7}" :db/id #edb/ref 17592186476663} {:answer/id #uuid "dc5a4b5d-4377-54c9-bfe2-c832ba673c98" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186476700}] :answer-field/correct {:db/id #edb/ref 17592186476700} :answer-field/id #uuid "adece7a5-0744-52d2-a422-6e0bf364c79d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186476833}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "bf386a8a-8501-5e3e-a330-283d65ae0e3a" :question/math-academy-id "q-129154" :question/problem "Find the shortest distance between the point $P(5,3,7)$ and the plane $Π$ with equation $-2x-3y+6z=16.$" :question/worked-solution "Let's start by picking a point on the plane. To do that, we simply substitute some concrete values for $x$ and $y$ into the equation and solve for $z.$ Let's choose $x=-2$ and $y=0$ (though it doesn't really matter what values we choose). Solving for $z,$ we get \n\n$$\n\\begin{aligned}-2x-3y+6z & =16 \\\\ -2(-2)-3(0)+6z & =16 \\\\ 6z & =12 \\\\ z & =2.\\end{aligned}\n$$\n\nSo, we get the point $Q(-2,0,2)$ which lies on the plane.\n\nComputing $\\overset{\\to }{PQ},$ we get \n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨-2,0,2⟩-⟨5,3,7⟩ \\\\  & =⟨-7,-3,-5⟩.\\end{aligned}\n$$\n\nWe also need a normal vector to the plane. For any Cartesian equation of a plane $ax+by+cz=d,$ the normal vector is $n=⟨a,b,c⟩.$ So, for the plane $Π,$ we have $n=⟨-2,-3,6⟩.$ \n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|(-7)\\cdot (-2)+(-3)\\cdot (-3)+(-5)\\cdot 6|}{\\sqrt{(-2)^{2}+(-3)^{2}+(6)^{2}}} \\\\  & =\\frac{|14+9-30|}{\\sqrt{4+9+36}} \\\\  & =\\frac{|-7|}{\\sqrt{49}} \\\\  & =\\frac{7}{7} \\\\  & =1.\\end{aligned}\n$$"} :step/id #uuid "c4143c0c-c3e3-5771-b847-04afefbdec44" :step/next {:db/id #edb/ref 17592186476980}} {:db/id #edb/ref 17592186477001 :step/content {:db/id #edb/ref 17592186315010 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23c37932-b8d1-516f-abf3-f1748834a7af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186312239} {:answer/id #uuid "3f3b0406-2681-5fe8-a9d6-e948d2f27a69" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{48}{11}" :db/id #edb/ref 17592186312486} {:answer/id #uuid "6b7e35c1-be2d-55da-bd15-0ac93254cb95" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{43}{11}" :db/id #edb/ref 17592186312817} {:answer/id #uuid "a1272a18-c467-54d3-9f71-ae126c7eade1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186313242} {:answer/id #uuid "e1afee6d-ef0d-5bae-8b1d-2c7e13dcdbb7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{11\\sqrt{26}}{13}" :db/id #edb/ref 17592186313752}] :answer-field/correct {:db/id #edb/ref 17592186312817} :answer-field/id #uuid "c0d43f73-b51f-5e33-b3f5-c33dee8bb5b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186314548}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "245878e4-0685-5305-b361-ba9fd660a2d5" :question/math-academy-id "q-34074" :question/problem "Given that $Q(2,4,1)$ lies on the plane $Π:r\\cdot ⟨-6,2,9⟩=5$, find the shortest distance from $P(6,-1,0)$ to $Π.$" :question/worked-solution "First, we find\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨2,4,1⟩-⟨6,-1,0⟩ \\\\  & =⟨-4,5,1⟩.\\end{aligned}\n$$\n\nFrom the equation of the plane, we get the normal vector $n=⟨-6,2,9⟩.$\n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|(-4)\\cdot (-6)+5\\cdot 2+1\\cdot 9|}{\\sqrt{(-6)^{2}+{2}^{2}+{9}^{2}}} \\\\  & =\\frac{|24+10+9|}{\\sqrt{36+4+81}} \\\\  & =\\frac{|43|}{\\sqrt{121}} \\\\  & =\\frac{43}{11}\\end{aligned}\n$$"} :step/id #uuid "fcc02eae-d041-5167-9e1c-3e49457a629e" :step/next {:db/id #edb/ref 17592186476984}}] :activity/title "The Shortest Distance Between a Plane and a Point" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186476200}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186494044} :activity/id #uuid "3b334ba4-5fdb-57ae-98dd-9bfdc4e4e648" :activity/scope {:db/id #edb/ref 17592186049322 :topic/id #uuid "ebecad61-07fb-5ecb-9dcd-758d5fa56d82" :topic/math-academy-id 1810} :activity/steps [{:db/id #edb/ref 17592186493983 :step/content {:db/id #edb/ref 17592186348337 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10263ca4-b8bb-5a2d-9cb0-a6cb6798e4ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186345488} {:answer/id #uuid "3fee28ed-fd4e-5e57-aea2-936eead49d24" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18" :db/id #edb/ref 17592186345901} {:answer/id #uuid "41336bd9-815f-549b-befc-b646e89179a9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{6}" :db/id #edb/ref 17592186345907} {:answer/id #uuid "b507ac70-f33c-5dda-9141-f543ced2a2ce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186346928} {:answer/id #uuid "f7c2d75f-e4ec-55e7-b876-ff7f73776f7c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186347546}] :answer-field/correct {:db/id #edb/ref 17592186347546} :answer-field/id #uuid "81c6cb45-6adc-5f19-b537-ff2e27ce7534" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186347834}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0953b145-a938-579d-a5dc-6946f5364a06" :question/math-academy-id "q-80122" :question/problem "Find the shortest distance between the point $P(-1,11,10)$ and the plane $Π$ with equation $-2x-4y+4z=16.$" :question/worked-solution "Let's start by picking a point on the plane. To do that, we simply substitute some concrete values for $x$ and $y$ into the equation and solve for $z.$ Let's choose $x=2$ and $y=3$ (though it doesn't really matter what values we choose). Solving for $z,$ we get \n\n$$\n\\begin{aligned}-2x-4y+4z & =16 \\\\ -2(2)-4(3)+4z & =16 \\\\ 4z & =32 \\\\ z & =8.\\end{aligned}\n$$\n\nSo, we get the point $Q(2,3,8)$ which lies on the plane.\n\nComputing $\\overset{\\to }{PQ},$ we get\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨2,3,8⟩-⟨-1,11,10⟩ \\\\  & =⟨3,-8,-2⟩.\\end{aligned}\n$$\n\nWe also need a normal vector to the plane. For any Cartesian equation of a plane $ax+by+cz=d,$ the normal vector is $n=⟨a,b,c⟩.$ So, for the plane $Π,$ we have $n=⟨-2,-4,4⟩.$ \n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|3\\cdot (-2)+(-8)\\cdot (-4)+(-2)\\cdot 4|}{\\sqrt{(-2)^{2}+(-4)^{2}+{4}^{2}}} \\\\  & =\\frac{|-6+32-8|}{\\sqrt{4+16+16}} \\\\  & =\\frac{|\\,18\\,|}{\\sqrt{36}} \\\\  & =3\\end{aligned}\n$$"} :step/id #uuid "1ef6544a-325c-5bf4-ad8a-26a2a5872b84" :step/next {:db/id #edb/ref 17592186494033}} {:db/id #edb/ref 17592186494033 :step/content {:db/id #edb/ref 17592186262946 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a1bf0d7-f3ab-56da-9f69-e8fe7acdca78" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186260643} {:answer/id #uuid "7aa2f25e-eac8-573f-a22c-70c7051fc5ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186260945} {:answer/id #uuid "9e90c74b-9340-5886-925a-6fd3dc9f6d08" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186261250} {:answer/id #uuid "b2e32ad6-74af-5732-bdfa-a17a20a619ee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186261455} {:answer/id #uuid "fac998bb-1203-5d71-bc3a-98304a447645" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186262068}] :answer-field/correct {:db/id #edb/ref 17592186260945} :answer-field/id #uuid "7eac6dd3-6114-5470-be8e-c3ff6f56e4f9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186262335}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7213d75b-15a3-5beb-aba1-e3068433b4a9" :question/math-academy-id "q-129120" :question/problem "Given that $Q(5,-1,9)$ lies on the plane $Π:r\\cdot ⟨3,-6,-2⟩=3$, find the shortest distance from $P(7,-2,8)$ to $Π.$" :question/worked-solution "First, we find\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨5,-1,9⟩-⟨7,-2,8⟩ \\\\  & =⟨-2,1,1⟩.\\end{aligned}\n$$\n\nFrom the equation of a plane, we get a normal vector $n=⟨3,-6,-2⟩.$\n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|(-2)\\cdot 3+1\\cdot (-6)+1\\cdot (-2)|}{\\sqrt{{3}^{2}+(-6)^{2}+(-2)^{2}}} \\\\  & =\\frac{|-6-6-2|}{\\sqrt{9+36+4}} \\\\  & =\\frac{|-14|}{\\sqrt{49}} \\\\  & =\\frac{14}{7} \\\\  & =2.\\end{aligned}\n$$"} :step/id #uuid "8f674b71-819d-50c4-9b12-f63f0a340a25" :step/next {:db/id #edb/ref 17592186494073}} {:db/id #edb/ref 17592186494037 :step/content {:db/id #edb/ref 17592186348336 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00f6631c-af7b-53a2-83af-ac437e78d90b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186345363} {:answer/id #uuid "619b3823-d10c-5f60-8462-b61b0c00f5f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18" :db/id #edb/ref 17592186346199} {:answer/id #uuid "6b2d9bb2-2fd3-5983-804f-4a5cd3d99900" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186346278} {:answer/id #uuid "8ddb3ea6-0413-5720-b61a-ab23c633ab83" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{15}" :db/id #edb/ref 17592186346583} {:answer/id #uuid "eeb2fcdd-6bc9-502b-bf63-760bd1212667" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186347459}] :answer-field/correct {:db/id #edb/ref 17592186345363} :answer-field/id #uuid "9873e119-5653-5fff-9565-620b8e2698f1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186347873}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "32d1647f-476a-5352-bcda-228c154bf2db" :question/math-academy-id "q-80120" :question/problem "Find the shortest distance between the point $P(-11,-8,-4)$ and the plane $Π$ with equation $14x+8y-8z=-6.$" :question/worked-solution "Let's start by picking a point on the plane. To do that, we simply substitute some concrete values for $x$ and $y$ into the equation and solve for $z.$ Let's choose $x=-1$ and $y=-2$ (though it doesn't really matter what values we choose). Solving for $z,$ we get \n\n$$\n\\begin{aligned}14x+8y-8z & =-6 \\\\ 14(-1)+8(-2)-8z & =-6 \\\\ -8z & =24 \\\\ z & =-3.\\end{aligned}\n$$\n\nSo, we get the point $Q(-1,-2,-3)$ which lies on the plane.\n\nComputing $\\overset{\\to }{PQ},$ we get\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨-1,-2,-3⟩-⟨-11,-8,-4⟩ \\\\  & =⟨10,6,1⟩.\\end{aligned}\n$$\n\nWe also need a normal vector to the plane. For any Cartesian equation of a plane $ax+by+cz=d,$ the normal vector is $n=⟨a,b,c⟩.$ So, for the plane $Π,$ we have $n=⟨14,8,-8⟩.$ \n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|10\\cdot 14+6\\cdot 8+1\\cdot (-8)|}{\\sqrt{(14)^{2}+{8}^{2}+(-8)^{2}}} \\\\  & =\\frac{|140+48-8|}{\\sqrt{196+64+64}} \\\\  & =\\frac{|\\,180\\,|}{\\sqrt{324}} \\\\  & =10\\end{aligned}\n$$"} :step/id #uuid "96f5b1a1-014f-5d45-8c0e-94671204d88b" :step/next {:db/id #edb/ref 17592186493983}} {:db/id #edb/ref 17592186494044 :step/content {:db/id #edb/ref 17592186348331 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "529cadbf-44d1-50b2-8c20-a9e272e22eec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "55" :db/id #edb/ref 17592186346057} {:answer/id #uuid "5889a9dd-d93f-5d3e-9d82-5347ba316df9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\sqrt{5}" :db/id #edb/ref 17592186346111} {:answer/id #uuid "88fb52ad-2071-5801-963f-3a749de660f6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15" :db/id #edb/ref 17592186346540} {:answer/id #uuid "967e30a0-e60c-522f-a7eb-07ded0736475" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186346667} {:answer/id #uuid "f5938001-9365-567e-a131-44fd2b8da5e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186347526}] :answer-field/correct {:db/id #edb/ref 17592186346111} :answer-field/id #uuid "4d59c58c-d76d-581e-8244-df4e793dba6c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186347735}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d51e9464-bbda-5ef7-95c6-2040c203954f" :question/math-academy-id "q-80115" :question/problem "Find the shortest distance between the point $P(-2,11,1)$ and the plane $Π$ with equation $r\\cdot ⟨2,-5,4⟩=20.$" :question/worked-solution "First, we need to find a point on the plane. If $r=⟨x,y,z⟩,$ we obtain\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨2,-5,4⟩ & =20 \\\\ 2x-5y+4z & =20 \\\\ 4z & =20-2x+5y \\\\ z & =5-\\frac{1}{2}x+\\frac{5}{4}y.\\end{aligned}\n$$\n\nSetting $x=2$ and $y=4,$ we get \n\n$$\nz=5-\\frac{1}{2}(2)+\\frac{5}{4}(4)=9.\n$$\n\nSo, the point $Q(2,4,9)$ lies on the plane. \n\nNow, we find\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨2,4,9⟩-⟨-2,11,1⟩ \\\\  & =⟨4,-7,8⟩.\\end{aligned}\n$$\n\nFrom the equation of a plane, we get a normal vector $n=⟨2,-5,4⟩.$\n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|(4)\\cdot 2+(-7)\\cdot (-5)+8\\cdot 4|}{\\sqrt{{2}^{2}+(-5)^{2}+{4}^{2}}} \\\\  & =\\frac{|8+35+32|}{\\sqrt{4+25+16}} \\\\  & =\\frac{|75|}{\\sqrt{45}} \\\\  & =5\\sqrt{5}\\end{aligned}\n$$"} :step/id #uuid "a4599a6c-9c22-5014-bf38-93bab9ca1f70" :step/next {:db/id #edb/ref 17592186494037}} {:db/id #edb/ref 17592186494073 :step/content {:db/id #edb/ref 17592186262961 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c91748b-039e-5eb9-a37e-a538a11b547b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186259994} {:answer/id #uuid "5e9b3c3c-b4f8-526a-9901-0c30d02dc50b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{9}" :db/id #edb/ref 17592186260689} {:answer/id #uuid "ad8f1a7d-4a09-5032-a136-33ad7657156e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186261398} {:answer/id #uuid "e02b39e4-a270-5bce-b071-29e9f45c2040" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186261855} {:answer/id #uuid "e9ac539e-67e6-579d-a5b0-ddb5f34a0f13" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186261922}] :answer-field/correct {:db/id #edb/ref 17592186261855} :answer-field/id #uuid "d63e23f4-baa1-51c3-b321-bbcaaaa933a6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186262496}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "358dc254-c65c-55e3-933d-25bd9221af6b" :question/math-academy-id "q-129165" :question/problem "Find the shortest distance between the point $P(-1,4,-5)$ and the plane $Π$ with equation $-2x+2y+z=6.$" :question/worked-solution "Let's start by picking a point on the plane. To do that, we simply substitute some concrete values for $x$ and $y$ into the equation and solve for $z.$ Let's choose $x=1$ and $y=1$ (though it doesn't really matter what values we choose). Solving for $z,$ we get \n\n$$\n\\begin{aligned}-2x+2y+z & =6 \\\\ -2(1)+2(1)+z & =6 \\\\ z & =6.\\end{aligned}\n$$\n\nSo, we get the point $Q(1,1,6)$ which lies on the plane.\n\nComputing $\\overset{\\to }{PQ},$ we get\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨1,1,6⟩-⟨-1,4,-5⟩ \\\\  & =⟨2,-3,11⟩.\\end{aligned}\n$$\n\nWe also need a normal vector to the plane. For any Cartesian equation of a plane $ax+by+cz=d,$ the normal vector is $n=⟨a,b,c⟩.$ So, for the plane $Π,$ we have $n=⟨-2,2,1⟩.$ \n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|2\\cdot (-2)+(-3)\\cdot 2+11\\cdot 1|}{\\sqrt{(-2)^{2}+{2}^{2}+{1}^{2}}} \\\\  & =\\frac{|-4-6+11|}{\\sqrt{4+4+1}} \\\\  & =\\frac{|1|}{\\sqrt{9}} \\\\  & =\\frac{1}{3}.\\end{aligned}\n$$"} :step/id #uuid "fe57e0c2-67ad-59f1-9759-bf1442fb9137"}] :activity/title "The Shortest Distance Between a Plane and a Point" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186493372}]}
