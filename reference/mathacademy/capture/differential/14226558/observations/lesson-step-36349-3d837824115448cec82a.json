use xlink:href=\"#E3-MJMAIN-3D\" x=\"795\" y=\"0\"></use>\n<g transform=\"translate(1851,0)\">\n <use xlink:href=\"#E3-MJMAIN-30\"></use>\n <use xlink:href=\"#E3-MJMAIN-2E\" x=\"500\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMAIN-39\" x=\"779\" y=\"0\"></use>\n</g>\n</g>\n</svg></span> </li>\n</ol>\n            </div>     \n\n            <div class=\"explanationHeader\">EXPLANATION</div>\n\n            <div class=\"exampleExplanation\">\n                <style type=\"text/css\">\n                            .mjpage .MJX-monospace {\n                            font-family: monospace\n                            }\n\n                            .mjpage .MJX-sans-serif {\n                            font-family: sans-serif\n                            }\n\n                            .mjpage {\n                            display: inline;\n                            font-style: normal;\n                            font-weight: normal;\n                            line-height: normal;\n                            font-size: 100%;\n                            font-size-adjust: none;\n                            text-indent: 0;\n                            text-align: left;\n                            text-transform: none;\n                            letter-spacing: normal;\n                            word-spacing: normal;\n                            word-wrap: normal;\n                            white-space: nowrap;\n                            float: none;\n                            direction: ltr;\n                            max-width: none;\n                            max-height: none;\n                            min-width: 0;\n                            min-height: 0;\n                            border: 0;\n                            padding: 0;\n                            margin: 0\n                            }\n\n                            .mjpage * {\n                            transition: none;\n                            -webkit-transition: n