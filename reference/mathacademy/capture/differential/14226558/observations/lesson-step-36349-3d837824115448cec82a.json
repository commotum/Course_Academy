42 412 42 436V444Q42 537 111 606Q171 666 243 666Q245 666 249 666T257 665H261Q273 665 286 663T323 651T370 619T413 560Q456 472 456 334Q456 194 396 97Q361 41 312 10T208 -22Q147 -22 108 7T68 93T121 149Q143 149 158 135T173 96Q173 78 164 65T148 49T135 44L131 43Q131 41 138 37T164 27T206 22H212Q272 22 313 86Q352 142 352 280V287ZM244 248Q292 248 321 297T351 430Q351 508 343 542Q341 552 337 562T323 588T293 615T246 625Q208 625 181 598Q160 576 154 546T147 441Q147 358 152 329T172 282Q197 248 244 248Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E8-MJMATHI-3C1\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E8-MJMAIN-3D\" x=\"795\" y=\"0\"></use>\n<g transform=\"translate(1851,0)\">\n <use xlink:href=\"#E8-MJMAIN-30\"></use>\n <use xlink:href=\"#E8-MJMAIN-2E\" x=\"500\" y=\"0\"></use>\n <use xlink:href=\"#E8-MJMAIN-39\" x=\"779\" y=\"0\"></use>\n <use xlink:href=\"#E8-MJMAIN-2E\" x=\"1279\" y=\"0\"></use>\n</g>\n</g>\n</svg></span></p>\n\n            </div>           \n        </div>",
