oefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c7cb220-5afc-5b19-a7bf-aeaaba188e81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\rho ≈0" :db/id #edb/ref 17592186545221} {:answer/id #uuid "2ecf7776-f06c-5178-9d27-b89b7e8cfb8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\rho ≈0.9" :db/id #edb/ref 17592186545296} {:answer/id #uuid "bf05904c-18b3-52af-a5c3-6e120a983a80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\rho ≈0.1" :db/id #edb/ref 17592186545549} {:answer/id #uuid "cb7ee60a-05da-569e-8c17-f1335eac64cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\rho ≈-0.8" :db/id #edb/ref 17592186545570} {:answer/id #uuid "f5909bb2-0a90-52d9-b686-d0e61412bfbe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\rho ≈-0.2" :db/id #edb/ref 17592186545651}] :answer-field/correct {:answer/id #uuid "cb7ee60a-05da-569e-8c17-f1335eac64cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\rho ≈-0.8" :db/id #edb/ref 17592186545570} :answer-field/id #uuid "5d7eb7fd-32f7-5271-8c12-8630ddb9702e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186080003}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f3e1cea1-0dea-5f3c-a617-a3cfcf6a3eac" :question/math-academy-id "q-133918" :question/problem "![](images/04/0432f45ba5b0652edc7f620233e9d2095c6e6836e98cecddf9ebc6f8c4cf99a5.png)\n\nWhich of the following is the best approximation of the correlation coefficient for the data in the scatter plot above?" :question/worked-solution "Recall that the linear correlation coefficient $\\rho $ satisfies the inequality\n\n$$\n-1\\le \\rho \\le 1,\n$$\n\nwhere $\\rho =1$ indicates a perfect positive correlation, and $\\rho =-1$ indicates a perfect negative correlation.\n\nWith that in mind, let's examine our scatter plot.\n\n![](images/91/91d605a297f2fd3c90c59592cc08184c4201f04ebc69bfc285e4261af8e918d2.png)\n\nWe note the following:\n\n- The points in the scatter plot seem to follow a straight line with a *negative* slope. So, the correlation coefficient must be *negative*. Thus, we disregard the following values:\n\n$$\n\\rho ≈0.9,\\,\\rho ≈0.1,\\,\\rho ≈0\n$$\n\n- The points lie pretty close to the corresponding trend line. So, the correlation coefficient must be closer to $-1.$ Thus, we disregard the following value:\n\n$$\n\\rho ≈-0.2\n$$\n\nTherefore, the best approximation of the correlation coefficient must be $\\rho ≈-0.8.$"}] [{:db/id #edb/ref 17592186083521 :knowledge-point/_questions [{:db/id #edb/ref 17592186083339 :knowledge-point/id #uuid "ebbc6b77-cd04-5509-b344-66feddfed1bb" :knowledge-point/title "Identifying a Scatter Plot Given a Correlation Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93fd8ea2-7862-53ca-acaa-f7e54190b630" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/25/251226a1a24c893a8a093fa8a7ecf68bb107c0265ab526ebdf6655c3d65a4657.png" :db/id #edb/ref 17592186080022} {:answer/id #uuid "99eb8012-1b96-5de5-8d46-cdab89bb819c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a1/a1b0d99c42318245a2e61ae122aabe3e6f30642ba8589c1a4e8d14921d1653a0.png" :db/id #edb/ref 17592186080023} {:answer/id #uuid "a119e827-41ce-5cab-b2db-d70a3daba859" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c8/c8d497a6867f41010998bb7504ae7c9ec34534582e0a41a30b7008a326090416.png" :db/id #edb/ref 17592186080024} {:answer/id #uuid "d01238a9-9418-52ac-ad4c-cd558bd0cc58" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ce/ceb21f25a7484607d1f1015f0d3eece084b9502d986c1615f84d174e772514d8.png" :db/id #edb/ref 17592186080025} {:answer/id #uuid "27769851-5197-5135-98b5-c57d00160af1" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/da/dac12a81adb4559e93171245f3be9a55520017a46218f4945e85044ed0ac4d61.png" :db/id #edb/ref 17592186080026}] :answer-field/correct {:answer/id #uuid "d01238a9-9418-52ac-ad4c-cd558bd0cc58" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ce/ceb21f25a7484607d1f1015f0d3eece084b9502d986c1615f84d174e772514d8.png" :db/id #edb/ref 17592186080025} :answer-field/id #uuid "6e304b1b-71c0-5ef4-8072-ba09849f9e63" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186080021}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "dce7c2f3-5685-5680-ac64-38c6bb59f9b8" :question/math-academy-id "q-133923" :question/problem "It is known that there is a linear correlation between the number of years passed since $2000$ and the population of a particular town. Given that the correlation coefficient is $\\rho ≈0.9,$ which of the following scatter plots corresponds to this situation?" :question/worked-solution "Recall that the linear correlation coefficient $\\rho $ satisfies the inequality\n\n$$\n-1\\le \\rho \\le 1,\n$$\n\nwhere $\\rho =1$ indicates a perfect positive correlation, and $\\rho =-1$ indicates a perfect negative correlation.\n\nTherefore, since $\\rho ≈0.9,$ there is a *strong positive* linear correlation in the data.\n\n- The *positive* linear correlation means that the data points should be scattered along a line with a *positive* slope.\n\n- Since the correlation is *strong*, most of the points should lie *close* to the trend line.\n\nTherefore, this situation corresponds to the following scatter plot.\n\n![](images/aa/aac79b793bde599899ff7ff8ca880e198bd5481178c2c5a0e2ac96acf223bdaa.png)"}] [{:db/id #edb/ref 17592186545794 :knowledge-point/_questions [{:db/id #edb/ref 17592186083339 :knowledge-point/id #uuid "ebbc6b77-cd04-5509-b344-66feddfed1bb" :knowledge-point/title "Identifying a Scatter Plot Given a Correlation Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5945c633-8bc2-5ee0-bc53-00f8c762ef88" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/67/676dd6bfce76b7f3743338c7a5c74bdd6b19e6dcc06bb7ae507099e026fed498.png" :db/id #edb/ref 17592186545371} {:answer/id #uuid "b7c515da-0b10-5b3f-b4bb-59a9caefaf0f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ad/adad3f224d705f4341928547dd0971f9ac9b8fc0705cea3d0e72de2da1ecadb6.png" :db/id #edb/ref 17592186545535} {:answer/id #uuid "e00c6bf5-0f55-5f97-8579-b3ea77041d54" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ec/ec0784db5054c47cfa60ed437b21e836fd39e9e1a64fa5227430249a3b05a749.png" :db/id #edb/ref 17592186545614} {:answer/id #uuid "e6601fe7-4e9c-5edd-b66e-c2e245ea68b7" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8f/8fbe10c5f9013a3ceb408aec32b986bedac02011960845182f20b4a98bc4e4b9.png" :db/id #edb/ref 17592186545627} {:answer/id #uuid "ff8e3165-ed64-5f28-8f2e-1b00d3e8d8c7" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/3a/3ad7850563975ed74e5eaac3ea887bfdb3c93422df7c6f30f9eb77509ece333a.png" :db/id #edb/ref 17592186545671}] :answer-field/correct {:answer/id #uuid "e00c6bf5-0f55-5f97-8579-b3ea77041d54" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ec/ec0784db5054c47cfa60ed437b21e836fd39e9e1a64fa5227430249a3b05a749.png" :db/id #edb/ref 17592186545614} :answer-field/id #uuid "9528ef67-4f45-5de3-aca0-2