0e8bffb-338d-5dfd-b7cd-2a2d079dcde9" :answer-field/choices "answer-68e86fef-4077-5647-96cb-22d0a0d6fe34"] ["question-fdb0f84a-e85a-559c-9fae-e9b6176fb94c" :question/answer-fields "answer-field-50e8bffb-338d-5dfd-b7cd-2a2d079dcde9"] [17592186083339 :knowledge-point/questions "question-fdb0f84a-e85a-559c-9fae-e9b6176fb94c"] ["question-bc9c7169-1131-5a87-93ac-6b79642c5534" :question/id #uuid "bc9c7169-1131-5a87-93ac-6b79642c5534"] ["question-bc9c7169-1131-5a87-93ac-6b79642c5534" :question/math-academy-id "q-134090"] ["question-bc9c7169-1131-5a87-93ac-6b79642c5534" :question/problem "It's known that there is a strong positive linear correlation between the variables $x$ and $y.$ Which of the following scatter plots corresponds to this situation?"] ["question-bc9c7169-1131-5a87-93ac-6b79642c5534" :question/worked-solution "Let's examine the given situation.\n\n- The *positive* linear correlation means that the data points should be scattered along a line with a *positive* slope.\n\n- Since the correlation is *strong*, most of the points should be scattered *close* to the trend line.\n\nTherefore, this situation corresponds to the following scatter plot.\n\n![](images/f9/f918c0b1ec7a3b3969fef43eb60bba0b4d4afba813082d710c456d4c53a49018.png)"] ["question-bc9c7169-1131-5a87-93ac-6b79642c5534" :question/difficulty :question.difficulty/moderate] ["answer-field-4725b4aa-c910-53da-8450-5672f21c1dcd" :answer-field/id #uuid "4725b4aa-c910-53da-8450-5672f21c1dcd"] ["answer-d550fa08-807e-5582-8d13-f5a808bd5ab5" :answer/id #uuid "d550fa08-807e-5582-8d13-f5a808bd5ab5"] ["answer-d550fa08-807e-5582-8d13-f5a808bd5ab5" :answer/type :answer.type/image] ["answer-d550fa08-807e-5582-8d13-f5a808bd5ab5" :answer/value "images/1e/1ef3eba0a815bee2bbe1611ea0330e31c366b758e8306b247701a0a99fc22f20.png"] ["answer-213a7457-0aa0-5582-9c30-27c246a0e264" :answer/id #uuid "213a7457-0aa0-5582-9c30-27c246a0e264"] ["answer-213a7457-0aa0-5582-9c30-27c246a0e264" :answer/type :answer.type/image] ["answer-213a7457-0aa0-5582-9c30-27c246a0e264" :answer/value "images/21/2149ef0c7a9e2acd912081fce8b3a53a57f0d17edcb80842f491f1d0b10eb3e9.png"] ["answer-03b5013b-1b8d-5ea5-acf9-9e6a17e86485" :answer/id #uuid "03b5013b-1b8d-5ea5-acf9-9e6a17e86485"] ["answer-03b5013b-1b8d-5ea5-acf9-9e6a17e86485" :answer/type :answer.type/image] ["answer-03b5013b-1b8d-5ea5-acf9-9e6a17e86485" :answer/value "images/88/8878fd97d3c1ebb87b849bfb1da28b03821dc1f11fecf26fb98386fcbf8e1d83.png"] ["answer-c5f70bb9-2022-5afa-8862-75382ec4e6bb" :answer/id #uuid "c5f70bb9-2022-5afa-8862-75382ec4e6bb"] ["answer-c5f70bb9-2022-5afa-8862-75382ec4e6bb" :answer/type :answer.type/image] ["answer-c5f70bb9-2022-5afa-8862-75382ec4e6bb" :answer/value "images/ba/ba6cc98881a906e2da63d80a971714dcf8c3bf8f425818136624079f8394a981.png"] ["answer-203b2536-d575-5f4e-a892-d7791d774b7c" :answer/id #uuid "203b2536-d575-5f4e-a892-d7791d774b7c"] ["answer-203b2536-d575-5f4e-a892-d7791d774b7c" :answer/type :answer.type/image] ["answer-203b2536-d575-5f4e-a892-d7791d774b7c" :answer/value "images/dc/dc4334cff1d792272fe5fe51b5b3973dd11388d46c5e3960361586b9d5602137.png"] ["answer-field-4725b4aa-c910-53da-8450-5672f21c1dcd" :answer-field/key "selection"] ["answer-field-4725b4aa-c910-53da-8450-5672f21c1dcd" :answer-field/type :answer-field.type/radio] ["answer-field-4725b4aa-c910-53da-8450-5672f21c1dcd" :answer-field/correct "answer-03b5013b-1b8d-5ea5-acf9-9e6a17e86485"] ["answer-field-4725b4aa-c910-53da-8450-5672f21c1dcd" :answer-field/choices "answer-d550fa08-807e-5582-8d13-f5a808bd5ab5"] ["answer-field-4725b4aa-c910-53da-8450-5672f21c1dcd" :answer-field/choices "answer-213a7457-0aa0-5582-9c30-27c246a0e264"] ["answer-field-4725b4aa-c910-53da-8450-5672f21c1dcd" :answer-field/choices "answer-03b5013b-1b8d-5ea5-acf9-9e6a17e86485"] ["answer-field-4725b4aa-c910-53da-8450-5672f21c1dcd" :answer-field/choices "answer-c5f70bb9-2022-5afa-8862-75382ec4e6bb"] ["answer-field-4725b4aa-c910-53da-8450-5672f21c1dcd" :answer-field/choices "answer-203b2536-d575-5f4e-a892-d7791d774b7c"] ["question-bc9c7169-1131-5a87-93ac-6b79642c5534" :question/answer-fields "answer-field-4725b4aa-c910-53da-8450-5672f21c1dcd"] [17592186083339 :knowledge-point/questions "question-bc9c7169-1131-5a87-93ac-6b79642c5534"] ["question-06e32974-1b71-50c8-93f5-929432644d25" :question/id #uuid "06e32974-1b71-50c8-93f5-929432644d25"] ["question-06e32974-1b71-50c8-93f5-929432644d25" :question/math-academy-id "q-134089"] ["question-06e32974-1b71-50c8-93f5-929432644d25" :question/problem "It's known that there is a weak positive linear correlation between the variables $x$ and $y.$ Which of the following scatter plots corresponds to this situation?"] ["question-06e32974-1b71-50c8-93f5-929432644d25" :question/worked-solution "Let's examine the given situation.\n\n- The *positive* linear correlation means that the data points should be scattered along a line with a *positive* slope.\n\n- Since the correlation is *weak*, most of the points should be scattered *far* from the trend line.\n\nTherefore, this situation corresponds to the following scatter plot.\n\n![](images/8c/8c21367686723d7ce1165ec24f569658d77376a39d7962b8a4ed90b06c9e1220.png)"] ["question-06e32974-1b71-50c8-93f5-929432644d25" :question/difficulty :question.difficulty/moderate] ["answer-field-9528ef67-4f45-5de3-aca0-210693a78fb7" :answer-field/id #uuid "9528ef67-4f45-5de3-aca0-210693a78fb7"] ["answer-ff8e3165-ed64-5f28-8f2e-1b00d3e8d8c7" :answer/id #uuid "ff8e3165-ed64-5f28-8f2e-1b00d3e8d8c7"] ["answer-ff8e3165-ed64-5f28-8f2e-1b00d3e8d8c7" :answer/type :answer.type/image] ["answer-ff8e3165-ed64-5f28-8f2e-1b00d3e8d8c7" :answer/value "images/3a/3ad7850563975ed74e5eaac3ea887bfdb3c93422df7c6f30f9eb77509ece333a.png"] ["answer-5945c633-8bc2-5ee0-bc53-00f8c762ef88" :answer/id #uuid "5945c633-8bc2-5ee0-bc53-00f8c762ef88"] ["answer-5945c633-8bc2-5ee0-bc53-00f8c762ef88" :answer/type :answer.type/image] ["answer-5945c633-8bc2-5ee0-bc53-00f8c762ef88" :answer/value "images/67/676dd6bfce76b7f3743338c7a5c74bdd6b19e6dcc06bb7ae507099e026fed498.png"] ["answer-e6601fe7-4e9c-5edd-b66e-c2e245ea68b7" :answer/id #uuid "e6601fe7-4e9c-5edd-b66e-c2e245ea68b7"] ["answer-e6601fe7-4e9c-5edd-b66e-c2e245ea68b7" :answer/type :answer.type/image] ["answer-e6601fe7-4e9c-5edd-b66e-c2e245ea68b7" :answer/value "images/8f/8fbe10c5f9013a3ceb408aec32b986bedac02011960845182f20b4a98bc4e4b9.png"] ["answer-b7c515da-0b10-5b3f-b4bb-59a9caefaf0f" :answer/id #uuid "b7c515da-0b10-5b3f-b4bb-59a9caefaf0f"] ["answer-b7c515da-0b10-5b3f-b4bb-59a9caefaf0f" :answer/type :answer.type/image] ["answer-b7c515da-0b10-5b3f-b4bb-59a9caefaf0f" :answer/value "images/ad/adad3f224d705f4341928547dd0971f9ac9b8fc0705cea3d0e72de2da1ecadb6.png"] ["answer-e00c6bf5-0f55-5f97-8579-b3ea77041d54" :answer/id #uuid "e00c6bf5-0f55-5f97-8579-b3ea77041d54"] ["answer-e00c6bf5-0f55-5f97-8579-b3ea77041d54" :answer/type :answer.type/image] ["answer-e00c6bf5-0f55-5f97-8579-b3ea77041d54" :answer/value "images/ec/ec0784db5054c47cfa60ed437b21e836fd39e9e1a64fa5227430249a3b05a749.png"] ["answer-field-9528ef67-4f45-5de3-aca0-210693a78fb7" :answer-field/key "selection"] ["answer-field-9528ef67-4f45-5de3-aca0-210693a78fb7" :answer-field/type :answer-field.type/radio] ["answer-field-9528ef67-4f45-5de3-aca0-210693a78fb7" :answer-field/correct "answer-e00c6bf5-0f55-5f97-8579-b3ea77041d54"] ["answer-field-9528ef67-4f45-5de3-aca0-210693a78fb7" :answer-field/choices "answer-ff8e3165-ed64-5f28-8f2e-1b00d3e8d8c7"] ["answer-field-9528ef67-4f45-5de3-aca0-210693a78fb7" :answer-field/choices "answer-5945c633-8bc2-5ee0-bc53-00f8c762ef88"] ["answer-field-9528ef67-4f45-5de3-aca0-210693a78fb7" :answer-field/choices "answer-e6601fe7-4e9c-5edd-b66e-c2e245ea68b7"] ["answer-field-9528ef67-4f45-5de3-aca0-210693a78fb7" :answer-field/choices "answer-b7c515da-0b10-5b3f-b4bb-59a9caefaf0f"] ["answer-field-9528ef67-4f45-5de3-aca0-210693a78fb7" :answer-field/choices "answer-e00c6bf5-0f55-5f97-8579-b3ea77041d54"] ["question-06e32974-1b71-50c8-93f5-929432644d25" :question/answer-fields "answer-field-9528ef67-4f45-5de3-aca0-210693a78fb7"] [17592186083339 :knowledge-point/questions "question-06e32974-1b71-50c8-93f5-929432644d25"] ["question-d339220f-f17c-55cf-8865-ba521fdebae7" :question/id #uuid "d339220f-f17c-55cf-8865-ba521fdebae7"] ["question-d339220f-f17c-55cf-8865-ba521fdebae7" :question/math-academy-id "q-134112"] ["question-d339220f-f17c-55cf-8865-ba521fdebae7" :question/problem "It's known that there is a linear correlation between the height (in $\\text{cm}$) and weight (in $\\text{kg}$) of a group of students in a particular class. Given that the correlation coefficient is $\\rho ≈0.45,$ which of the following scatter plots corresponds to this situation?"] ["question-d339220f-f17c-55cf-8865-ba521fdebae7" :question/worked-solution "Recall that the linear correlation coefficient $\\rho $ satisfies the inequality\n\n$$\n-1\\le \\rho \\le 1,\n$$\n\nwhere $\\rho =1$ indicates a perfect positive correlation, and $\\rho =-1$ indicates a perfect negative correlation.\n\nTherefore, since $\\rho ≈0.45,$ there is a *weak positive* linear correlation in the data.\n\n- The *positive* linear correlation means that the data points should be scattered along a line with a *positive* slope.\n\n- Since the correlation is *weak*, most of the points should be scattered *far* from the trend line.\n\nTherefore, this situation corresponds to the following scatter plot.\n\n![](images/31/31aef47ad76d8cd4c7e967ccc7b8ca523eb3a20af440454bc7908bbe9441c918.png)"] ["question-d339220f-f17c-55cf-8865-ba521fdebae7" :question/difficulty :question.difficulty/hard] ["answer-field-2f1ba1af-342f-5fed-bb12-14097b1af01f" :answer-field/id #uuid "2f1ba1af-342f-5fed-bb12-14097b1af01f"] ["answer-be854c2e-00b5-5189-95d0-d391ce579514" :answer/id #uuid "be854c2e-00b5-5189-95d0-d391ce579514"] ["answer-be854c2e-00b5-5189-95d0-d391ce579514" :answer/type :answer.type/image] ["answer-be854c2e-00b5-5189-95d0-d391ce579514" :answer/value "images/10/10408bda83013b4decbf51370d20018004a1086a538322abbd0b9da1b910e4f2.png"] ["answer-8a10c856-18f3-5372-ad82-c037bac0b67c" :answer/id #uuid "8a10c856-18f3-5372-ad82-c037bac0b67c"] ["answer-8a10c856-18f3-5372-ad82-c037bac0b67c" :answer/type :answer.type/image] ["answer-8a10c856-18f3-5372-ad82-c037bac0b67c" :answer/value "images/14/14258fd15361beae5d6e0655e81051b2e4bfd95d20b05dc98113558e43412f41.png"] ["answer-26ccb841-9c61-58c1-b74a-7d6ba6da7857" :answer/id #uuid "26ccb841-9c61-58c1-b74a-7d6ba6da7857"] ["answer-26ccb841-9c61-58c1-b74a-7d6ba6da7857" :answer/type :answer.type/image] ["answer-26ccb841-9c61-58c1-b74a-7d6ba6da7857" :answer/value "images/a8/a866fcee0e975c0741299a5e1504470dbae44e18b541149c7d5e1e2acb9b32bd.png"] ["answer-1cc1444b-fd8c-5102-acf6-a80893a9655f" :answer/id #uuid "1cc1444b-fd8c-5102-acf6-a80893a9655f"] ["answer-1cc1444b-fd8c-5102-acf6-a80893a9655f" :answer/type :answer.type/image] ["answer-1cc1444b-fd8c-5102-acf6-a80893a9655f" :answer/value "images/ec/ec4b106cf763a4c54ee2b1d8eecf6e7b91e371b0dd38198502bd433ef7e6e371.png"] ["answer-9f1744c8-9253-57a1-9385-88741010bd5c" :answer/id #uuid "9f1744c8-9253-57a1-9385-88741010bd5c"] ["answer-9f1744c8-9253-57a1-9385-88741010bd5c" :answer/type :answer.type/image] ["answer-9f1744c8-9253-57a1-9385-88741010bd5c" :answer/value "images/ec/ec7a1b76ebbcc4965824be26bc4b1e630167b032855498df6d492a61461fecf9.png"] ["answer-field-2f1ba1af-342f-5fed-bb12-14097b1af01f" :answer-field/key "selection"] ["answer-field-2f1ba1af-342f-5fed-bb12-14097b1af01f" :answer-field/type :answer-field.type/radio] ["answer-field-2f1ba1af-342f-5fed-bb12-14097b1af01f" :answer-field/correct "answer-9f1744c8-9253-57a1-9385-88741010bd5c"] ["answer-field-2f1ba1af-342f-5fed-bb12-14097b1af01f" :answer-field/choices "answer-be854c2e-00b5-5189-95d0-d391ce579514"] ["answer-field-2f1ba1af-342f-5fed-bb12-14097b1af01f" :answer-field/choices "answer-8a10c856-18f3-5372-ad82-c037bac0b67c"] ["answer-field-2f1ba1af-342f-5fed-bb12-14097b1af01f" :answer-field/choices "answer-26ccb841-9c61-58c1-b74a-7d6ba6da7857"] ["answer-field-2f1ba1af-342f-5fed-bb12-14097b1af01f" :answer-field/choices "answer-1cc1444b-fd8c-5102-acf6-a80893a9655f"] ["answer-field-2f1ba1af-342f-5fed-bb12-14097b1af01f" :answer-field/choices "answer-9f1744c8-9253-57a1-9385-88741010bd5c"] ["question-d339220f-f17c-55cf-8865-ba521fdebae7" :question/answer-fields "answer-field-2f1ba1af-342f-5fed-bb12-14097b1af01f"] [17592186083339 :knowledge-point/questions "question-d339220f-f17c-55cf-8865-ba521fdebae7"] [17592186083521 :question/problem "It is known that there is a linear correlation between the number of years passed since $2000$ and the population of a particular town. Given that the correlation coefficient is $\\rho ≈0.9,$ which of the following scatter plots corresponds to this situation?"] [17592186083521 :question/worked-solution "Recall that the linear correlation coefficient $\\rho $ satisfies the inequality\n\n$$\n-1\\le \\rho \\le 1,\n$$\n\nwhere $\\rho =1$ indicates a perfect positive correlation, and $\\rho =-1$ indicates a perfect negative correlation.\n\nTherefore, since $\\rho ≈0.9,$ there is a *strong positive* linear correlation in the data.\n\n- The *positive* linear correlation means that the data points should be scattered along a line with a *positive* slope.\n\n- Since the correlation is *strong*, most of the points should lie *close* to the trend line.\n\nTherefore, this situation corresponds to the following scatter plot.\n\n![](images/aa/aac79b793bde599899ff7ff8ca880e198bd5481178c2c5a0e2ac96acf223bdaa.png)"] [17592186083521 :question/difficulty :question.difficulty/hard] [17592186080021 :answer-field/correct 17592186080025] [17592186084452 :tutorial/content "There is a **linear correlation** between two sets of paired observations if the data points on the corresponding scatter plot are located along a straight line.\n\nWe say that the correlation is **positive** if the corresponding trend line has a *positive slope*. Similarly, we say that the correlation is **negative** if the corresponding trend line has a *negative slope*.\n\nWe have a **strong** correlation if the data points lie *close* to the corresponding trend line. Similarly, we have a **weak** correlation if the data points are scattered *far* from the corresponding trend line.\n\nLet's see a few examples:\n\n| ![](images/cd/cdd335fda9e91cbf7cdb05ad18065630985c50adb788df980708d822f7a5e8e9.png) | **Strong positive** linear correlation:\n\n- The trend line has a *positive* slope.\n\n- The data points lie *close* to the trend line. |\n| --- | --- |\n| ![](images/9b/9b288c25fb0993a714768e3e2e9caf23a11f2629950eb03b138acfc0aa6c17cf.png) | **Weak positive** linear correlation: \n\n- The trend line has a *positive* slope.\n\n- The data points lie *far* from the trend line. |\n| ![](images/36/3680700a5e4e4e196db6ffe106535ad784567b9fbed85e5005cbb6e49a476860.png) | **Strong negative** linear correlation:\n\n- The trend line has a *negative* slope.\n\n- The data points lie *close* to the trend line. |\n| ![](images/07/076440b257a78474e9f1b3129ec448a407bb1b49215a29251d8e929cadaeb984.png) | **Weak negative** linear correlation:\n\n- The trend line has a *negative* slope.\n\n- The data points lie *far* from the trend line. |\n| ![](images/ed/ed266d09a86d7200c02f004cd9bb3a87f75693462ff8846f7f3cc1ed4b66ed63.png) | **No linear correlation**:\n\n- The data points are scattered randomly. |"] [17592186084490 :tutorial/content "The linear **correlation coefficient** $\\rho$ (the Greek letter rho, pronounced \"row\") is a real number between $-1$ and $1$ that shows the strength of a linear correlation. It has the following properties:\n\n- $\\rho = 1$ indicates a perfect positive correlation\n\n- $\\rho = -1$ indicates a perfect negative correlation\n\n- $\\rho = 0$ indicates no (linear) correlation\n\nThe approximate value of $\\rho$ can be determined from the scatter plot.\n\n| ![](images/09/09d585da995df4e5a67b022816eec246113171d3aad15dcb57d82c766dcb7d18.png) | For a strong positive correlation, we have $0.7 \\leq \\rho \\leq 1.$ |\n| --- | --- |\n| ![](images/9b/9b288c25fb0993a714768e3e2e9caf23a11f2629950eb03b138acfc0aa6c17cf.png) | For a weak positive correlation, we have $0.3 \\leq \\rho \\lt 0.7.$ |\n| ![](images/36/3680700a5e4e4e196db6ffe106535ad784567b9fbed85e5005cbb6e49a476860.png) | For a strong negative correlation, we have $-1 \\leq \\rho \\leq -0.7.$ |\n| ![](images/92/92b65a115fd1621303a248de8ae03d05392827914f5200f267d368867d511ae5.png) | For a weak negative correlation, we have $-0.7 \\lt \\rho \\leq -0.3.$ |\n| ![](images/2c/2cf1e2c3e79940229fc85c10d5bccdfed17afe0759cc897d53e5421328b21466.png) | For little or no correlation, we have $-0.3 < \\rho < 0.3.$ |"] [17592186083427 :activity/expected-seconds 420.0]] "retractions" [[17592186083139 :question/worked-solution "![](images/b9/b970e539af5b695644486ad4eb7c21558c334ffd33c1df1a2343fac493d84389.png)\n\nWe note the following:\n\n- The points in the scatter plot seem to follow a straight line with a *negative* slope. So, we have a *negative* correlation.\n- The points are scattered quite far from the corresponding trend line. So, we have a *weak* correlation.\n\nTherefore, the variables have a *weak negative* linear correlation."] [17592186083140 :question/problem "![](images/4e/4e3c58da0dc7f326497d9a7c1327d6d40f98684089694f9de88f21a64f4b4824.png)\n\nWhich of the following could be the correlation coefficient for the data in the scatter plot above?\n\n1. $\\rho =-0.8$\n2. $\\rho= 0.3$\n3. $\\rho = 0.9$"] [17592186083140 :question/worked-solution "Recall that the linear correlation coefficient $\\rho$ satisfies the inequality\n\n$$\n-1 \\leq \\rho \\leq 1\n$$\n\nwhere $\\rho = 1$ indicates a perfect positive correlation, and $\\rho = -1$ indicates a perfect negative correlation.\n\nWith that in mind, let's examine our scatter plot.\n\n![](images/06/06dcc617bbbc07fea756f35975146a238bd4cb9c4ce437f1b9300a7c05ded7b6.png)\n\nWe note the following:\n\n- The points in the scatter plot seem to follow a straight line with a *positive* slope. So, the correlation coefficient must be *positive*. Thus, we disregard the following value:\n$\\rho = -0.8$\n- The points lie pretty close to the corresponding trend line. So, the correlation coefficient must be closer to $1$. Thus, we disregard the following value:\n$\\rho = 0.3$\n\nTherefore, the best approximation of the correlation coefficient from the given options is $\\rho= 0.9$."] [17592186083141 :question/problem "It is known that there is a linear correlation between the variables $x$ and $y$. Given that the correlation coefficient is $\\rho\\approx -0.85$, sketch a possible scatter plot that corresponds to this situation."] [17592186083141 :question/worked-solution "Recall that the linear correlation coefficient $\\rho$ satisfies the inequality\n\n$$\n-1 \\leq \\rho \\leq 1\n$$\n\nwhere $\\rho = 1$ indicates a perfect positive correlation, and $\\rho = -1$ indicates a perfect negative correlation.\n\nTherefore, since\n\n$$\n\\rho \\approx -0.85\n$$\n\nthere is a *strong negative* linear correlation in the data.\n\n- The *negative* linear correlation means that the data points should be scattered along a line with a *negative* slope.\n- Since the correlation is *strong*, most of the points should lie *close* to the trend line.\n\nTherefore, this situation could correspond to the following scatter plot:\n\n![](images/ad/ad8ff5e49649b5e788b83eb28fa26afae61072d5e63026631a9cd1891be14a0c.png)"] [17592186080003 :answer-field/choices 17592186080004] [17592186080003 :answer-field/choices 17592186080005] [17592186080003 :answer-field/choices 17592186080006] [17592186080003 :answer-field/choices 17592186080007] [17592186080003 :answer-field/choices 17592186080008] [17592186083521 :question/problem "It is known that there is a linear correlation between the number of years passed since $2000$ and the population of a particular town. Given that the correlation coefficient is $ρ \\approx 0.9$, which of the following scatter plots corresponds to this situation?"] [17592186084452 :tutorial/content "There is a **linear correlation** between two sets of paired observations if the data points on the corresponding scatter plot are located along a straight line.\n\nWe say that the correlation is **positive** if the corresponding trend line has a *positive slope*. Similarly, we say that the correlation is **negative** if the corresponding trend line has a *negative slope*.\n\nWe have a **strong** correlation if the data points lie *close* to the corresponding trend line. Similarly, we have a **weak** correlation if the data points are scattered *far* from the corresponding trend line.\n\nLet's see a few examples:\n\n| ![](images/cd/cdd335fda9e91cbf7cdb05ad18065630985c50adb788df980708d822f7a5e8e9.png) | **Strong positive** linear correlation:<br>The trend line has a *positive* slope. The data points lie *close* to the trend line. |\n| --- | ---: |\n| ![](images/9b/9b288c25fb0993a714768e3e2e9caf23a11f2629950eb03b138acfc0aa6c17cf.png) | **Weak positive** linear correlation:<br>The trend line has a *positive* slope. The data points lie *far* from the trend line. |\n| ![](images/36/3680700a5e4e4e196db6ffe106535ad784567b9fbed85e5005cbb6e49a476860.png) | **Strong negative** linear correlation:<br>The trend line has a *negative* slope. The data points lie *close* to the trend line. |\n| ![](images/07/076440b257a78474e9f1b3129ec448a407bb1b49215a29251d8e929cadaeb984.png) | **Weak negative** linear correlation:<br>The trend line has a *negative* slope. The data points lie *far* from the trend line. |\n| ![](images/ed/ed266d09a86d7200c02f004cd9bb3a87f75693462ff8846f7f3cc1ed4b66ed63.png) | **No linear correlation**:<br>The data points are scattered randomly. |"] [17592186084490 :tutorial/content "The linear **correlation coefficient** $\\rho$ (the Greek letter rho, pronounced \"row\") is a real number between $-1$ and $1$ that shows the strength of a linear correlation. It has the following properties:\n\n- $\\rho = 1$ indicates a perfect positive correlation\n- $\\rho = -1$ indicates a perfect negative correlation\n- $\\rho = 0$ indicates no (linear) correlation\n\nThe approximate value of $\\rho$ can be determined from the scatter plot.\n\n| ![](images/09/09d585da995df4e5a67b022816eec246113171d3aad15dcb57d82c766dcb7d18.png) | For a strong positive correlation, we have $0.7 \\leq \\rho \\leq 1$. |\n| --- | ---: |\n| ![](images/9b/9b288c25fb0993a714768e3e2e9caf23a11f2629950eb03b138acfc0aa6c17cf.png) | For a weak positive correlation, we have $0.3 \\leq \\rho \\lt 0.7$. |\n| ![](images/36/3680700a5e4e4e196db6ffe106535ad784567b9fbed85e5005cbb6e49a476860.png) | For a strong negative correlation, we have $-1 \\leq \\rho \\leq -0.7$. |\n| ![](images/92/92b65a115fd1621303a248de8ae03d05392827914f5200f267d368867d511ae5.png) | For a weak negative correlation, we have $-0.7 \\lt \\rho \\leq -0.3$. |\n| ![](images/2c/2cf1e2c3e79940229fc85c10d5bccdfed17afe0759cc897d53e5421328b21466.png) | For little or no correlation, we have $-0.3 < \\rho < 0.3$. |"]]}]