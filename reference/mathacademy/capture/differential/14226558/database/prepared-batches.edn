answer-field/choices "answer-a0758947-9149-585c-80e7-966a2a53f237"] ["answer-field-724bde99-b3bb-58df-81bd-552e8017bb6e" :answer-field/choices "answer-e71cb635-681e-51e0-8351-d1cc6f433ab1"] ["question-e6c59cf1-e1f3-5c09-adfe-bd7d9e53be52" :question/answer-fields "answer-field-724bde99-b3bb-58df-81bd-552e8017bb6e"] [17592186083338 :knowledge-point/questions "question-e6c59cf1-e1f3-5c09-adfe-bd7d9e53be52"] ["question-fdb0f84a-e85a-559c-9fae-e9b6176fb94c" :question/id #uuid "fdb0f84a-e85a-559c-9fae-e9b6176fb94c"] ["question-fdb0f84a-e85a-559c-9fae-e9b6176fb94c" :question/math-academy-id "q-134091"] ["question-fdb0f84a-e85a-559c-9fae-e9b6176fb94c" :question/problem "It's known that there is a strong negative linear correlation between the variables $x$ and $y.$ Which of the following scatter plots corresponds to this situation?"] ["question-fdb0f84a-e85a-559c-9fae-e9b6176fb94c" :question/worked-solution "Let's examine the given situation.\n\n- The *negative* linear correlation means that the data points should be scattered along a line with a *negative* slope.\n\n- Since the correlation is *strong*, most of the points should be scattered *close* to the trend line.\n\nTherefore, this situation corresponds to the following scatter plot.\n\n![](images/8c/8ca401fd830f94dae1f40d024af0362491165f91cbde4cb6fb783124e241ca4b.png)"] ["question-fdb0f84a-e85a-559c-9fae-e9b6176fb94c" :question/difficulty :question.difficulty/moderate] ["answer-field-50e8bffb-338d-5dfd-b7cd-2a2d079dcde9" :answer-field/id #uuid "50e8bffb-338d-5dfd-b7cd-2a2d079dcde9"] ["answer-ac6fd348-05b6-57c8-80de-72b6c4d93b67" :answer/id #uuid "ac6fd348-05b6-57c8-80de-72b6c4d93b67"] ["answer-ac6fd348-05b6-57c8-80de-72b6c4d93b67" :answer/type :answer.type/image] ["answer-ac6fd348-05b6-57c8-80de-72b6c4d93b67" :answer/value "images/06/0601da86b2e188c890aa8bb49d367323f728f5685cbbb2e8297cce974e07221d.png"] ["answer-d931e2c0-63a2-5c15-9102-ba7118697cf0" :answer/id #uuid "d931e2c0-63a2-5c15-9102-ba7118697cf0"] ["answer-d93