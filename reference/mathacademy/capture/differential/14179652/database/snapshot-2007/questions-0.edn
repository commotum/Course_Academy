pe/text} :answer/value "false" :db/id #edb/ref 17592186472584} {:answer/id #uuid "e7fc74ba-8f62-5436-9d2e-3c858d0578e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472585}] :answer-field/correct {:answer/id #uuid "e6738bb8-1870-5396-9a90-bba160d497e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472584} :answer-field/id #uuid "7584f499-906d-554c-842b-3985b246d9ba" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473687}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a2d9404d-2d42-56c6-b91b-5351ccec57cf" :question/math-academy-id "q-128139" :question/problem "Which of the following completes the statement so that it is true:\n\n*If a $2\\times 2$-matrix $A$ is invertible, then $\\text{__________}$ . *\n\nI. $det(A)\\ne 0$\nII. $Ax=b$ has exactly one solution\nIII. $Ax=0$ has infinitely many solutions\n\nSelect all that apply." :question/worked-solution "Since $A$ is invertible, $\\operatorname{det}(A)\\ne 0.$ Also, for each vector $b,$ the equation $Ax=b$ has the unique solution $x=A^{-1}b.$ In particular, $Ax=0$ has only the zero solution. Thus statements I and II are true and statement III is false. The correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186323750 :knowledge-point/_questions [{:db/id #edb/ref 17592186115235 :knowledge-point/id #uuid "9923c6c3-e425-54ae-a533-09421d5578cb" :knowledge-point/title "Identifying a True Statement Given a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f00f19b1-a5d9-5f3f-892f-2e3d8e66d32c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450566} {:answer/id #uuid "f24b70da-3d6e-5768-987e-5a6a1111b77e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450567}] :answer-field/correct {:answer/id #uuid "f00f19b1-a5d9-5f3f-892f-2e3d8e66d32c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450566} :answer-field/id #uuid "ac17f050-593c-55c0-be4c-979e6666933f" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451237} {:answer-field/choices [{:answer/id #uuid "40c3344c-65d7-58be-ae26-42bb9b9f586a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450568} {:answer/id #uuid "740835e0-32e5-50d4-b9e7-dfc4013e2ecf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450569}] :answer-field/correct {:answer/id #uuid "740835e0-32e5-50d4-b9e7-dfc4013e2ecf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450569} :answer-field/id #uuid "c0e7cf2e-0dcc-5b45-a214-fc4802e94260" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451238} {:answer-field/choices [{:answer/id #uuid "1f9e3557-049b-5e3a-bce9-8906dde445a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450570} {:answer/id #uuid "9efcb6d2-5f9b-556f-ba0b-a54c998fb8e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450571}] :answer-field/correct {:answer/id #uuid "1f9e3557-049b-5e3a-bce9-8906dde445a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450570} :answer-field/id #uuid "0fd7516a-09ae-5918-99f5-dc75f2fb3320" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451239}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b252a44d-8417-5bdc-8a9b-ad6e81276b7c" :question/math-academy-id "q-36075" :question/problem "Let \n$A=[\\begin{aligned}3 & 2 \\\\ 0 & -2\\end{aligned}].$\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $det(A)=0$\n- **II.** $Ax=0$ has the unique  solution $⟨0,0⟩$\n- **III.** $⟨5,-4⟩$ is a solution to $Ax=0$" :question/worked-solution "Recall that given $A=[\\begin{aligned}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{aligned}]$, then according to the invertible matrix theorem the following statements are equivalent:    \n\n- $A$ is invertible.\n\n- The system $Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b.$\n\n- The system $Ax=0$ has the unique zero solution.\n\n- The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.\n\n- $det(A)\\ne 0.$\n\nWith that in mind, let's now check our statements.\n\n- Statement I is false. We have\n\n$$\n\\begin{aligned}det(A) & =det[\\begin{aligned}3 & 2 \\\\ 0 & -2\\end{aligned}] \\\\  & =3\\cdot (-2)-2\\cdot 0 \\\\  & =-6\\ne 0.\\end{aligned}\n$$\n\nNow, since the fifth part of the invertible matrix theorem is true, all the other parts of the theorem are true too. Therefore, according to the theorem:\n\n- Statement II is true by the third part of the invertible matrix theorem.\n\n- Statement III is false. Again,  according to the third part of the invertible matrix theorem, the system $Ax=0$ has the unique zero solution.\n\nTherefore, only statement II is true."}] [{:db/id #edb/ref 17592186495058 :knowledge-point/_questions [{:db/id #edb/ref 17592186115236 :knowledge-point/id #uuid "64b2036f-da0f-59de-8a39-6b33e6cbdd04" :knowledge-point/title "Completing a True Statement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3dac26d2-ebbe-5a1e-83fa-4b3b6d5b4e28" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186494448} {:answer/id #uuid "551b68dd-eb85-5e01-8e30-fd3cc7694f1d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186494491} {:answer/id #uuid "939de576-f6fe-534e-bcc7-b91eb70d6b02" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186494656} {:answer/id #uuid "c357f7bd-3a09-51e9-abea-8dc1deeb12c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186494778} {:answer/id #uuid "efaad133-59c6-5b2b-9d22-976c341550bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II  only" :db/id #edb/ref 17592186494886}] :answer-field/correct {:answer/id #uuid "3dac26d2-ebbe-5a1e-83fa-4b3b6d5b4e28" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186494448} :answer-field/id #uuid "273b6a9c-3dfc-5014-9117-506724cb00ae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186494934}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "11aeb2f0-20f1-51d5-8c52-39a1558cd757" :question/math-academy-id "q-47651" :question/problem "Which of the following completes the statement so that it is true:\n\n*If the lines $y-x=1$ and $x+ky=4$, where $k$ is a constant, intersect at exactly one point, then $\\text{__________}$ .*\n\nI. the lines $y-x=0$ and $x+ky=0$ don't intersect\n\nII. the lines $y-x=0$ and $x+ky=0$ intersect at infinitely many points\n\nIII. $det[\\begin{aligned}-1 & 1 \\\\ 1 & k\\end{aligned}]\\ne 0$" :question/worked-solution "Recall that given $A=[\\begin{aligned}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{aligned}]$, then according to the invertible matrix theorem the following statements are equivalent:    \n\n1\\. $A$ is invertible.\n\n2\\. The system $Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b.$\n\n3\\. The system $Ax=0$ has the unique zero solution.\n\n4\\. The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.\n\n5\\. $det(A)\\ne 0.$\n\nWith that in mind, let's now check our statements.\n\nNotice that if we set \n\n$$\nA=[\\begin{aligned}-1 & 1 \\\\ 1 & k\\end{aligned}],\\,x=[\\begin{aligned}x \\\\ y\\end{aligned}],\\,b=[\\begin{aligned}1 \\\\ 4\\end{aligned}]\n$$\n\n  \n\nthen the fourth part of the theorem is true. Hence,  all the other parts of the theorem are true too. Therefore, according to the theorem, only option III give us a true statement: \n\n- *If the lines $y-x=1$ and $x+ky=4$, where $k$ is a constant, intersect at exactly one point, then $det[\\begin{aligned}-1 & 1 \\\\ 1 & k\\end{aligned}]\\ne 0$ .* $\\,✓$"}] [{:db/id #edb/ref 17592186377668 :knowledge-point/_questions [{:db/id #edb/ref 17592186115235 :knowledge-point/id #uuid "9923c6c3-e425-54ae-a533-09421d5578cb" :knowledge-point/title "Identifying a True Statement Given a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6dbd8a41-022e-505a-9a23-5897ee2615d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453946} {:answer/id #uuid "e964dc82-e823-526c-bb4e-d9d86b715c3d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453947}] :answer-field/correct {:answer/id #uuid "6dbd8a41-022e-505a-9a23-5897ee2615d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453946} :answer-field/id #uuid "fd5d2420-05be-505d-a6da-9370564b875a" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454723} {:answer-field/choices [{:answer/id #uuid "5bfaf3e3-c8c3-5b0f-905a-7cfc3c188946" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453948} {:answer/id #uuid "8e7b77cf-0808-52a0-92c8-aef31c85857a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453949}] :answer-field/correct {:answer/id #uuid "8e7b77cf-0808-52a0-92c8-aef31c85857a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453949} :answer-field/id #uuid "b912caf2-b2fa-5b75-b5a5-849cbfd33c40" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454724} {:answer-field/choices [{:answer/id #uuid "581a4ee7-2ef6-5d6a-8a10-f2e80e510c61" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453950} {:answer/id #uuid "b85c6ec3-9718-5d84-925f-86b8f81442df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453951}] :answer-field/correct {:answer/id #uuid "581a4ee7-2ef6-5d6a-8a10-f2e80e510c61" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453950} :answer-field/id #uuid "74197001-61cf-522e-acb4-234d12a1ff07" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454725}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "aafb0544-5c12-5527-bc2a-2417215aad99" :question/math-academy-id "q-73566" :question/problem "Let \n$A=[\\begin{aligned}2 & -3 \\\\ 2 & -2\\end{aligned}].$\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $A$ is **not** invertible\n- **II.** The lines $2x-3y=1$ and $2x-2y=2$ intersect at exactly one point\n- **III.** $Ax=0$ has no solution" :question/worked-solution "Recall that given $A=[\\begin{aligned}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{aligned}]$, then according to the invertible matrix theorem the following statements are equivalent:    \n\n- $A$ is invertible.\n\n- The system $Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b.$\n\n- The system $Ax=0$ has the unique zero solution.\n\n- The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.\n\n- $det(A)\\ne 0.$\n\nNow, we have\n\n$$\n\\begin{aligned}det(A) & =det[\\begin{aligned}2 & -3 \\\\ 2 & -2\\end{aligned}] \\\\  & =2\\cdot (-2)-(-3)\\cdot 2 \\\\  & =2\\ne 0.\\end{aligned}\n$$\n\nNow, since the fifth part of the invertible matrix theorem is true, all the other parts of the theorem are true too. \n\nWith that in mind, let's now check our statements.\n\n- Statement I is false by the first part of the invertible matrix theorem.\n\n- Statement II is true by the fourth part of the invertible matrix theorem.\n\n- Statement III is false since, according to the third part of the invertible matrix theorem, the system $Ax=0$ has the unique zero solution.\n\nTherefore, only statement II is true."}] [{:db/id #edb/ref 17592186342017 :knowledge-point/_questions [{:db/id #edb/ref 17592186115235 :knowledge-point/id #uuid "9923c6c3-e425-54ae-a533-09421d5578cb" :knowledge-point/title "Identifying a True Statement Given a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e722ed3-73e4-52c0-a421-554b9e9509ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 175921