8-9612-0d1c154cab40" :question/answer-fields "answer-field-b6a101ae-6c02-52e5-9871-130a767d9a46"] ["question-9684ce08-aa53-5b58-9612-0d1c154cab40" :question/answer-fields "answer-field-ff075b7b-7ca8-5b8f-88a3-0b6d0e198ed4"] ["question-9684ce08-aa53-5b58-9612-0d1c154cab40" :question/answer-fields "answer-field-0d008ce6-0db4-5560-8335-4e57b2ea4c0d"] [17592186204100 :knowledge-point/questions "question-9684ce08-aa53-5b58-9612-0d1c154cab40"] ["question-8583a74c-8e9b-50f5-aea2-c01f0aa03b2a" :question/id #uuid "8583a74c-8e9b-50f5-aea2-c01f0aa03b2a"] ["question-8583a74c-8e9b-50f5-aea2-c01f0aa03b2a" :question/math-academy-id "q-269803"] ["question-8583a74c-8e9b-50f5-aea2-c01f0aa03b2a" :question/problem "Consider the functions $y(x)=Ax$ and $f(y)=By,$ where $x\\in {R}^{3},y\\in {R}^{2},$ and the matrices $A$ and $B$ are given by\n\n$$\nA=[\\begin{aligned}2 & 4 & 6 \\\\ 2 & -2 & 1\\end{aligned}],\\,B=[\\begin{aligned}1 & 0 \\\\ 0 & 2\\end{aligned}].\n$$\n\nWhat is $\\frac{\\text{d}}{\\text{d}x}f(y(x))$ evaluated at ${x}_{0}=[2,\\,-1,\\,1]^{T}?$\n\n<table cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"70px\" rowspan=\"2\" width=\"30px\">\n${\\frac{\\text{d}}{\\text{d}x}f(y(x))|}_{{x}_{0}}=\\,\\,$\n</td>\n<td align=\"center\" height=\"35px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"30px\">{{field-2}}</td>\n<td align=\"center\" width=\"30px\">$6$</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">\n{{field-3}}\n</td>\n<td align=\"center\">{{field-4}}</td>\n<td align=\"center\">$2$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>"] ["question-8583a74c-8e9b-50f5-aea2-c01f0aa03b2a" :question/worked-solution "Using the chain rule, we have\n\n$$\n\\frac{\\text{d}}{\\text{d}x}f(y(x))=\\frac{\\text{d}f}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x}.\n$$\n\nLet's consider each of the factors in turn.\n\n- The function $f$ acts on a vector $y\\in {R}^{2}$ by multiplying it by $B$ and outputs a vector $f(y)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}f}{\\text{d}y}=B.\n$$\n\n- The function $y$ acts on a vector $x\\in {R}^{3}$ by multiplying it by $A$ and outputs a vector $y(x)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=A.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}f(y(x)) & =\\frac{\\text{d}f}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x} \\\\  & =BA \\\\  & =[\\begin{aligned}1 & 0 \\\\ 0 & 2\\end{aligned}][\\begin{aligned}2 & 4 & 6 \\\\ 2 & -2 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 4 & 6 \\\\ 4 & -4 & 2\\end{aligned}].\\end{aligned}\n$$"] ["question-8583a74c-8e9b-50f5-aea2-c01f0aa03b2a" :question/difficulty :question.difficulty/moderate] ["answer-field-726def4a-0906-5fa9-9043-394665a07fc7" :answer-field/id #uuid "726def4a-0906-5fa9-9043-394665a07fc7"] ["answer-72e6ae6d-bb8d-5cc2-a28a-14459e3d01bb" :answer/id #uuid "72e6ae6d-bb8d-5cc2-a28a-14459e3d01bb"] ["answer-72e6ae6d-bb8d-5cc2-a28a-14459e3d01bb" :answer/type :answer.type/math] ["answer-72e6ae6d-bb8d-5cc2-a28a-14459e3d01bb" :answer/value "2"] ["answer-field-726def4a-0906-5fa9-9043-394665a07fc7" :answer-field/key "field-1"] ["answer-field-726def4a-0906-5fa9-9043-394665a07fc7" :answer-field/type :answer-field.type/blank] ["answer-field-726def4a-0906-5fa9-9043-394665a07fc7" :answer-field/correct "answer-72e6ae6d-bb8d-5cc2-a28a-14459e3d01bb"] ["answer-field-726def4a-0906-5fa9-9043-394665a07fc7" :answer-field/choices "answer-72e6ae6d-bb8d-5cc2-a28a-14459e3d01bb"] ["answer-field-fe571652-a4d2-5aca-a284-5cc14e649fc0" :answer-field/id #uuid "fe571652-a4d2-5aca-a284-5cc14e649fc0"] ["answer-0e09df5c-3585-5850-8211-9855817d7292" :answer/id #uuid "0e09df5c-3585-5850-8211-9855817d7292"] ["answer-0e09df5c-3585-5850-8211-9855817d7292" :answer/type :answer.type/math] ["answer-0e09df5c-3585-5850-8211-9855817d7292" :answer/value "4"] ["answer-field-fe571652-a4d2-5aca-a284-5cc