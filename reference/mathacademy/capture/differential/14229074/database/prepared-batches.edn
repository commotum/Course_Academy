0aa03b2a" :question/answer-fields "answer-field-726def4a-0906-5fa9-9043-394665a07fc7"] ["question-8583a74c-8e9b-50f5-aea2-c01f0aa03b2a" :question/answer-fields "answer-field-fe571652-a4d2-5aca-a284-5cc14e649fc0"] ["question-8583a74c-8e9b-50f5-aea2-c01f0aa03b2a" :question/answer-fields "answer-field-bd92e62f-367e-5106-b7b7-0a4661d602b0"] ["question-8583a74c-8e9b-50f5-aea2-c01f0aa03b2a" :question/answer-fields "answer-field-183c83b2-fe77-525b-a49f-d3a9ba2e786a"] [17592186204100 :knowledge-point/questions "question-8583a74c-8e9b-50f5-aea2-c01f0aa03b2a"] ["question-ed9f515f-42d2-575d-bafa-bcd19e12a760" :question/id #uuid "ed9f515f-42d2-575d-bafa-bcd19e12a760"] ["question-ed9f515f-42d2-575d-bafa-bcd19e12a760" :question/math-academy-id "q-269823"] ["question-ed9f515f-42d2-575d-bafa-bcd19e12a760" :question/problem "For $x,y,z\\in {R}^{2},$ consider the following functions: \n\n$$\n\\begin{aligned} & y(x)=Ax\\,\\text{where}\\,A=[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}] \\\\  & z(y)=[\\begin{aligned}{y}_{1}^{2}+{y}_{2} \\\\ {y}_{2}^{2}-{y}_{1}\\end{aligned}] \\\\  & f(z)=Cz\\,\\text{where}\\,C=[\\begin{aligned}-2 & 1 \\\\ 1 & -2\\end{aligned}]\\end{aligned}\n$$\n\nWhat is $\\frac{\\text{d}}{\\text{d}x}f(z(y(x)))$ evaluated at ${x}_{0}=[\\begin{aligned}1 \\\\ 0\\end{aligned}]?$"] ["question-ed9f515f-42d2-575d-bafa-bcd19e12a760" :question/worked-solution "Using the chain rule, we have\n\n$$\n\\frac{\\text{d}}{\\text{d}x}f(z(y(x)))=\\frac{\\text{d}f}{\\text{d}z}\\cdot \\frac{\\text{d}z}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x}.\n$$\n\nLet's consider each of the factors in turn.\n\n- The function $f$ acts on a vector $z\\in {R}^{2}$ by multiplying it by $C$ and outputs a vector $f(z)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}f}{\\text{d}z}=C.\n$$\n\n- The function $z$ acts on a vector $y\\in {R}^{2}$ and outputs a vector $z(y)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}z}{\\text{d}y}=[\\begin{aligned}\\frac{∂{z}_{1}}{∂{y}_{1}} & \\frac{∂{z}_{1}}{∂{y}_{2}} \\\\ \\frac{∂{z}_{2}}{∂{y}_{1}} & \\frac{∂{z}_{2}}{∂{y}_{2}}\\end{aligned}]=[\\begin{aligned}2{y}_{1} & 1 \\\\ -1 & 2{y}_{2}\\end{aligned}].\n$$\n\nEvaluating at ${y}_{0}=A{x}_{0}=[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}-1 \\\\ 0\\end{aligned}],$ we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}y}{|}_{{y}_{0}}=[\\begin{aligned}2(-1) & 1 \\\\ -1 & 2(0)\\end{aligned}]=[\\begin{aligned}-2 & 1 \\\\ -1 & 0\\end{aligned}].\n$$\n\n- The function $y$ acts on a vector $x\\in {R}^{2}$ by multiplying it by $A$ and outputs a vector $y(x)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=A.\n$$\n\nTherefore, we have \n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}f(z(y(x))){|}_{{x}_{0}} & =\\frac{\\text{d}f}{\\text{d}z}{|}_{{z}_{0}}\\cdot \\frac{\\text{d}z}{\\text{d}y}{|}_{{y}_{0}}\\cdot \\frac{\\text{d}y}{\\text{d}x}{|}_{{x}_{0}} \\\\  & =[\\begin{aligned}-2 & 1 \\\\ 1 & -2\\end{aligned}]\\cdot [\\begin{aligned}-2 & 1 \\\\ -1 & 0\\end{aligned}]\\cdot [\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}3 & -2 \\\\ 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}-3 & 2 \\\\ 0 & -1\\end{aligned}].\\end{aligned}\n$$"] ["question-ed9f515f-42d2-575d-bafa-bcd19e12a760" :question/difficulty :question.difficulty/easy] ["answer-field-34d7e51d-85f2-564b-a3f7-2300578f216d" :answer-field/id #uuid "34d7e51d-85f2-564b-a3f7-2300578f216d"] ["answer-7e1a2103-5199-5776-8be3-a4b90b89af36" :answer/id #uuid "7e1a2103-5199-5776-8be3-a4b90b89af36"] ["answer-7e1a2103-5199-5776-8be3-a4b90b89af36" :answer/type :answer.type/math] ["answer-7e1a2103-5199-5776-8be3-a4b90b89af36" :answer/value "[\\begin{aligned}-2 & 2 \\\\ 0 & -1\\end{aligned}]"] ["answer-80264191-38a9-5a0e-9ad8-7978f8daa096" :answer/id #uuid "80264191-38a9-5a0e-9ad8-7978f8daa096"] ["answer-80264191-38a9-5a0e-9ad8-7978f8daa096" :answer/type :answer.type/math] ["answer-80264191-38a9-5a0e-9ad8-797