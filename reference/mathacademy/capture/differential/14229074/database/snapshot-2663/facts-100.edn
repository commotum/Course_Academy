92186045417] [17592186551230 #edb/ref 1075 #edb/ref 17592186550414 #edb/ref 17592186045417] [17592186551230 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186551230 #edb/ref 1077 "field-3" #edb/ref 17592186045417] [17592186551230 #edb/ref 1078 #edb/ref 17592186550414 #edb/ref 17592186045417] [17592186551230 #edb/ref 1079 #uuid "ff075b7b-7ca8-5b8f-88a3-0b6d0e198ed4" #edb/ref 17592186045417] [17592186551302 #edb/ref 1068 #edb/ref 17592186551073 #edb/ref 17592186045417] [17592186551302 #edb/ref 1068 #edb/ref 17592186551131 #edb/ref 17592186045417] [17592186551302 #edb/ref 1068 #edb/ref 17592186551180 #edb/ref 17592186045417] [17592186551302 #edb/ref 1068 #edb/ref 17592186551229 #edb/ref 17592186045417] [17592186551302 #edb/ref 1069 "q-269803" #edb/ref 17592186045417] [17592186551302 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186551302 #edb/ref 1071 "Consider the functions $y(x)=Ax$ and $f(y)=By,$ where $x\\in {R}^{3},y\\in {R}^{2},$ and the matrices $A$ and $B$ are given by\n\n$$\nA=[\\begin{aligned}2 & 4 & 6 \\\\ 2 & -2 & 1\\end{aligned}],\\,B=[\\begin{aligned}1 & 0 \\\\ 0 & 2\\end{aligned}].\n$$\n\nWhat is $\\frac{\\text{d}}{\\text{d}x}f(y(x))$ evaluated at ${x}_{0}=[2,\\,-1,\\,1]^{T}?$\n\n<table cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"70px\" rowspan=\"2\" width=\"30px\">\n${\\frac{\\text{d}}{\\text{d}x}f(y(x))|}_{{x}_{0}}=\\,\\,$\n</td>\n<td align=\"center\" height=\"35px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"30px\">{{field-2}}</td>\n<td align=\"center\" width=\"30px\">$6$</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">\n{{field-3}}\n</td>\n<td align=\"center\">{{field-4}}</td>\n<td align=\"center\">$2$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" #edb/ref 17592186045417] [17592186551302 #edb/ref 1072 #uuid "8583a74c-8e9b-50f5-aea2-c01f0aa03b2a" #edb/ref 17592186045417] [17592186551302 #edb/ref 1074 "Using the chain rule, we have\n\n$$\n\\frac{\\text{d}}{\\text{d}x}f(y(x))=\\frac{\\text{d}f}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x}.\n$$\n\nLet's consider each of the factors in turn.\n\n- The function $f$ acts on a vector $y\\in {R}^{2}$ by multiplying it by $B$ and outputs a vector $f(y)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}f}{\\text{d}y}=B.\n$$\n\n- The function $y$ acts on a vector $x\\in {R}^{3}$ by multiplying it by $A$ and outputs a vector $y(x)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=A.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}f(y(x)) & =\\frac{\\text{d}f}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x} \\\\  & =BA \\\\  & =[\\begin{aligned}1 & 0 \\\\ 0 & 2\\end{aligned}][\\begin{aligned}2 & 4 & 6 \\\\ 2 & -2 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 4 & 6 \\\\ 4 & -4 & 2\\end{aligned}].\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186551311 #edb/ref 1068 #edb/ref 17592186551071 #edb/ref 17592186045417] [17592186551311 #edb/ref 1068 #edb/ref 17592186551154 #edb/ref 17592186045417] [17592186551311 #edb/ref 1068 #edb/ref 17592186551177 #edb/ref 17592186045417] [17592186551311 #edb/ref 1068 #edb/ref 17592186551230 #edb/ref 17592186045417] [17592186551311 #edb/ref 1069 "q-269802" #edb/ref 17592186045417] [17592186551311 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186551311 #edb/ref 1071 "Consider the functions $y(x)=Ax$ and $f(y)=By,$ where $x\\in {R}^{3},y\\in {R}^{2},$ and the matrices $A$ and $B$ are given by\n\n$$\nA=[\\begin{aligned}-1 & 2 & -3 \\\\ 2 & 2 & 0\\end{aligned}],\\,B=[\\begin{aligned}-2 & 1 \\\\ 1 & -3\\end{aligned}].\n$$\n\nWhat is $\\frac{\\text{d}}{\\text{d}x}f(y(x))$ evaluated at ${x}_{0}=[1,\\,-1,\\,3]^{T}?$\n\n<table cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"70px\" rowspan=\"2\" width=\"30px\">\n${\\frac{\\text{d}}{\\text{d}x}f(y(x))|}_{{x}_{0}}=\\,\\,$\n</td>\n<td align=\"center\" height=\"35px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"30px\">{{field-2}}</td>\n<td align=\"center\" width=\"30px\">{{field-3}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">$-7$</td>\n<td align=\"center\">{{field-4}}</td>\n<td align=\"center\">$-3$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" #edb/ref 17592186045417] [17592186551311 #edb/ref 1072 #uuid "9684ce08-aa53-5b58-9612-0d1c154cab40" #edb/ref 17592186045417] [17592186551311 #edb/ref 1074 "Using the chain rule, we have\n\n$$\n\\frac{\\text{d}}{\\text{d}x}f(y(x))=\\frac{\\text{d}f}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x}.\n$$\n\nLet's consider each of the factors in turn.\n\n- The function $f$ acts on a vector $y\\in {R}^{2}$ by multiplying it by $B$ and outputs a vector $f(y)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}f}{\\text{d}y}=B.\n$$\n\n- The function $y$ acts on a vector $x\\in {R}^{3}$ by multiplying it by $A$ and outputs a vector $y(x)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=A.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}f(y(x)) & =\\frac{\\text{d}f}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x} \\\\  & =BA \\\\  & =[\\begin{aligned}-2 & 1 \\\\ 1 & -3\\end{aligned}][\\begin{aligned}-1 & 2 & -3 \\\\ 2 & 2 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}4 & -2 & 6 \\\\ -7 & -4 & -3\\end{aligned}].\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186551349 #edb/ref 1068 #edb/ref 17592186551098 #edb/ref 17592186045417] [17592186551349 #edb/ref 1069 "q-269823" #edb/ref 17592186045417] [17592186551349 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186551349 #edb/ref 1071 "For $x,y,z\\in {R}^{2},$ consider the following functions: \n\n$$\n\\begin{aligned} & y(x)=Ax\\,\\text{where}\\,A=[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}] \\\\  & z(y)=[\\begin{aligned}{y}_{1}^{2}+{y}_{2} \\\\ {y}_{2}^{2}-{y}_{1}\\end{aligned}] \\\\  & f(z)=Cz\\,\\text{where}\\,C=[\\begin{aligned}-2 & 1 \\\\ 1 & -2\\end{aligned}]\\end{aligned}\n$$\n\nWhat is $\\frac{\\text{d}}{\\text{d}x}f(z(y(x)))$ evaluated at ${x}_{0}=[\\begin{aligned}1 \\\\ 0\\end{aligned}]?$" #edb/ref 17592186045417] [17592186551349 #edb/ref 1072 #uuid "ed9f515f-42d2-575d-bafa-bcd19e12a760" #edb/ref 17592186045417] [17592186551349 #edb/ref 1074 "Using the chain rule, we have\n\n$$\n\\frac{\\text{d}}{\\text{d}x}f(z(y(x)))=\\frac{\\text{d}f}{\\text{d}z}\\cdot \\frac{\\text{d}z}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x}.\n$$\n\nLet's consider each of the factors in turn.\n\n- The function $f$ acts on a vector $z\\in {R}^{2}$ by multiplying it by $C$ and outputs a vector $f(z)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}f}{\\text{d}z}=C.\n$$\n\n- The function $z$ acts on a vector $y\\in {R}^{2}$ and outputs a vector $z(y)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}z}{\\text{d}y}=[\\begin{aligned}\\frac{∂{z}_{1}}{∂{y}_{1}} & \\frac{∂{z}_{1}}{∂{y}_{2}} \\\\ \\frac{∂{z}_{2}}{∂{y}_{1}} & \\frac{∂{z}_{2}}{∂{y}_{2}}\\end{aligned}]=[\\begin{aligned}2{y}_{1} & 1 \\\\ -1 & 2{y}_{2}\\end{aligned}].\n$$\n\nEvaluating at ${y}_{0}=A{x}_{0}=[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}-1 \\\\ 0\\end{aligned}],$ we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}y}{|}_{{y}_{0}}=[\\begin{aligned}2(-1) & 1 \\\\ -1 & 2(0)\\end{aligned}]=[\\begin{aligned}-2 & 1 \\\\ -1 & 0\\end{aligned}].\n$$\n\n- The function $y$ acts on a vector $x\\in {R}^{2}$ by multiplying it by $A$ and outputs a vector $y(x)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=A.\n$$\n\nTherefore, we have \n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}f(z(y(x))){|}_{{x}_{0}} & =\\frac{\\text{d}f}{\\text{d}z}{|}_{{z}_{0}}\\cdot \\frac{\\text{d}z}{\\text{d}y}{|}_{{y}_{0}}\\cdot \\frac{\\text{d}y}{\\text{d}x}{|}_{{x}_{0}} \\\\  & =[\\begin{aligned}-2 & 1 \\\\ 1 & -2\\end{aligned}]\\cdot [\\begin{aligned}-2 & 1 \\\\ -1 & 0\\end{aligned}]\\cdot [\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}3 & -2 \\\\ 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}-3 & 2 \\\\ 0 & -1\\end{aligned}].\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186551360 #edb/ref 1058 #edb/ref 17592186551428 #edb/ref 17592186045417] [17592186551360 #edb/ref 1062 #uuid "01c39290-cd5a-5aa1-8a59-9cbfefffe951" #edb/ref 17592186045417] [17592186551360 #edb/ref 1063 #edb/ref 17592186551311 #edb/ref 17592186045417] [17592186551410 #edb/ref 1062 #uuid "6ceaa452-9af3-59b8-a7ac-18a86e3a74a0" #edb/ref 17592186045417] [17592186551410 #edb/ref 1063 #edb/ref 17592186551349 #edb/ref 17592186045417] [17592186551428 #edb/ref 1058 #edb/ref 17592186551410 #edb/ref 17592186045417] [17592186551428 #edb/ref 1062 #uuid "99a98175-6d17-5897-8ff6-309efa769d68" #edb/ref 17592186045417] [17592186551428 #edb/ref 1063 #edb/ref 17592186551302 #edb/ref 17592186045417] [17592186551436 #edb/ref 1058 #edb/ref 17592186551438 #edb/ref 17592186045417] [17592186551436 #edb/ref 1062 #uuid "aeffc49e-02fd-5851-a96c-59f1d28fc3f8" #edb/ref 17592186045417] [17592186551436 #edb/ref 1063 #edb/ref 17592186204581 #edb/ref 17592186045417] [17592186551438 #edb/ref 1058 #edb/ref 17592186551360 #edb/ref 17592186045417] [17592186551438 #edb/ref 1062 #uuid "b0e4ff39-21d5-5469-8555-eb4203698626" #edb/ref 17592186045417] [17592186551438 #edb/ref 1063 #edb/ref 17592186204589 #edb/ref 17592186045417]}
