17592186045492} :db/id #edb/ref 17592186551230}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9684ce08-aa53-5b58-9612-0d1c154cab40" :question/math-academy-id "q-269802" :question/problem "Consider the functions $y(x)=Ax$ and $f(y)=By,$ where $x\\in {R}^{3},y\\in {R}^{2},$ and the matrices $A$ and $B$ are given by\n\n$$\nA=[\\begin{aligned}-1 & 2 & -3 \\\\ 2 & 2 & 0\\end{aligned}],\\,B=[\\begin{aligned}-2 & 1 \\\\ 1 & -3\\end{aligned}].\n$$\n\nWhat is $\\frac{\\text{d}}{\\text{d}x}f(y(x))$ evaluated at ${x}_{0}=[1,\\,-1,\\,3]^{T}?$\n\n<table cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"70px\" rowspan=\"2\" width=\"30px\">\n${\\frac{\\text{d}}{\\text{d}x}f(y(x))|}_{{x}_{0}}=\\,\\,$\n</td>\n<td align=\"center\" height=\"35px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"30px\">{{field-2}}</td>\n<td align=\"center\" width=\"30px\">{{field-3}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">$-7$</td>\n<td align=\"center\">{{field-4}}</td>\n<td align=\"center\">$-3$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Using the chain rule, we have\n\n$$\n\\frac{\\text{d}}{\\text{d}x}f(y(x))=\\frac{\\text{d}f}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x}.\n$$\n\nLet's consider each of the factors in turn.\n\n- The function $f$ acts on a vector $y\\in {R}^{2}$ by multiplying it by $B$ and outputs a vector $f(y)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}f}{\\text{d}y}=B.\n$$\n\n- The function $y$ acts on a vector $x\\in {R}^{3}$ by multiplying it by $A$ and outputs a vector $y(x)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=A.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}f(y(x)) & =\\frac{\\text{d}f}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x} \\\\  & =BA \\\\  & =[\\begin{aligned}-2 & 1 \\\\ 1 & -3\\end{aligned}][\\begin{aligned}-1 & 2 & -3 \\\\ 2 & 2 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}4 & -2 & 6 \\\\ -7 & -4 & -3\\end{aligned}].\\end{aligned}\n$$"} :step/id #uuid "01c39290-cd5a-5aa1-8a59-9cbfefffe951" :step/next {:db/id #edb/ref 17592186551428}} {:db/id #edb/ref 17592186551410 :step/content {:db/id #edb/ref 17592186551349 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22bf0f43-71c0-5fe6-8a9c-db88987e135d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}-3 & 2 \\\\ 0 & -2\\end{aligned}]" :db/id #edb/ref 17592186550446} {:answer/id #uuid "7e1a2103-5199-5776-8be3-a4b90b89af36" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}-2 & 2 \\\\ 0 & -1\\end{aligned}]" :db/id #edb/ref 17592186550681} {:answer/id #uuid "80264191-38a9-5a0e-9ad8-7978f8daa096" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}-3 & 2 \\\\ 0 & -1\\end{aligned}]" :db/id #edb/ref 17592186550692} {:answer/id #uuid "88597b94-66f0-5510-9176-e7d043bbb584" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}-3 & 2 \\\\ 1 & -1\\end{aligned}]" :db/id #edb/ref 17592186550714} {:answer/id #uuid "b3d925c6-ea55-56ff-b092-6a1d99103f84" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}-3 & 3 \\\\ 0 & -1\\end{aligned}]" :db/id #edb/ref 17592186550856}] :answer-field/correct {:db/id #edb/ref 17592186550692} :answer-field/id #uuid "34d7e51d-85f2-564b-a3f7-2300578f216d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186551098}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ed9f515f-42d2-575d-bafa-bcd19e12a760" :question/math-academy-id "q-269823" :question/problem "For $x,y,z\\in {R}^{2},$ consider the following functions: \n\n$$\n\\begin{aligned} & y(x)=Ax\\,\\text{where}\\,A=[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}] \\\\  & z(y)=[\\begin{aligned}{y}_{1}^{2}+{y}_{2} \\\\ {y}_{2}^{2}-{y}_{1}\\end{aligned}] \\\\  & f(z)=Cz\\,\\text{where}\\,C=[\\begin{aligned}-2 & 1 \\\\ 1 & -2\\end{aligned}]\\end{aligned}\n$$\n\nWhat is $\\frac{\\text{d}}{\\text{d}x}f(z(y(x)))$ evaluated at ${x}_{0}=[\\begin{aligned}1 \\\\ 0\\end{aligned}]?$" :question/worked-solution "Using the chain rule, we have\n\n$$\n\\frac{\\text{d}}{\\text{d}x}f(z(y(x)))=\\frac{\\text{d}f}{\\text{d}z}\\cdot \\frac{\\text{d}z}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x}.\n$$\n\nLet's consider each of the factors in turn.\n\n- The function $f$ acts on a vector $z\\in {R}^{2}$ by multiplying it by $C$ and outputs a vector $f(z)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}f}{\\text{d}z}=C.\n$$\n\n- The function $z$ acts on a vector $y\\in {R}^{2}$ and outputs a vector $z(y)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}z}{\\text{d}y}=[\\begin{aligned}\\frac{∂{z}_{1}}{∂{y}_{1}} & \\frac{∂{z}_{1}}{∂{y}_{2}} \\\\ \\frac{∂{z}_{2}}{∂{y}_{1}} & \\frac{∂{z}_{2}}{∂{y}_{2}}\\end{aligned}]=[\\begin{aligned}2{y}_{1} & 1 \\\\ -1 & 2{y}_{2}\\end{aligned}].\n$$\n\nEvaluating at ${y}_{0}=A{x}_{0}=[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}-1 \\\\ 0\\end{aligned}],$ we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}y}{|}_{{y}_{0}}=[\\begin{aligned}2(-1) & 1 \\\\ -1 & 2(0)\\end{aligned}]=[\\begin{aligned}-2 & 1 \\\\ -1 & 0\\end{aligned}].\n$$\n\n- The function $y$ acts on a vector $x\\in {R}^{2}$ by multiplying it by $A$ and outputs a vector $y(x)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=A.\n$$\n\nTherefore, we have \n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}f(z(y(x))){|}_{{x}_{0}} & =\\frac{\\text{d}f}{\\text{d}z}{|}_{{z}_{0}}\\cdot \\frac{\\text{d}z}{\\text{d}y}{|}_{{y}_{0}}\\cdot \\frac{\\text{d}y}{\\text{d}x}{|}_{{x}_{0}} \\\\  & =[\\begin{aligned}-2 & 1 \\\\ 1 & -2\\end{aligned}]\\cdot [\\begin{aligned}-2 & 1 \\\\ -1 & 0\\end{aligned}]\\cdot [\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}3 & -2 \\\\ 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}-3 & 2 \\\\ 0 & -1\\end{aligned}].\\end{aligned}\n$$"} :step/id #uuid "6ceaa452-9af3-59b8-a7ac-18a86e3a74a0"} {:db/id #edb/ref 17592186551428 :step/content {:db/id #edb/ref 17592186551302 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09b99397-4784-52a1-bc2e-c34d594af14b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186550393}] :answer-field/correct {:db/id #edb/ref 17592186550393} :answer-field/id #uuid "183c83b2-fe77-525b-a49f-d3a9ba2e786a" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186551073} {:answer-field/choices [{:answer/id #uuid "72e6ae6d-bb8d-5cc2-a28a-14459e3d01bb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186550657}] :answer-field/correct {:db/id #edb/ref 17592186550657} :answer-field/id #uuid "726def4a-0906-5fa9-9043-394665a07fc7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186551131} {:answer-field/choices [{:answer/id #uuid "3f6bd7f7-3c1a-5787-a2e8-9c30e81f2652" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186550512}] :answer-field/correct {:db/id #edb/ref 17592186550512} :answer-field/id #uuid "bd92e62f-367e-5106-b7b7-0a4661d602b0" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186551180} {:answer-field/choices [{:answer/id #uuid "0e09df5c-3585-5850-8211-9855817d7292" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186550405}] :answer-field/correct {:db/id #edb/ref 17592186550405} :answer-field/id #uuid "fe571652-a4d2-5aca-a284-5cc14e649fc0" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186551229}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8583a74c-8e9b-50f5-aea2-c01f0aa03b2a" :question/math-academy-id "q-269803" :question/problem "Consider the functions $y(x)=Ax$ and $f(y)=By,$ where $x\\in {R}^{3},y\\in {R}^{2},$ and the matrices $A$ and $B$ are given by\n\n$$\nA=[\\begin{aligned}2 & 4 & 6 \\\\ 2 & -2 & 1\\end{aligned}],\\,B=[\\begin{aligned}1 & 0 \\\\ 0 & 2\\end{aligned}].\n$$\n\nWhat is $\\frac{\\text{d}}{\\text{d}x}f(y(x))$ evaluated at ${x}_{0}=[2,\\,-1,\\,1]^{T}?$\n\n<table cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"70px\" rowspan=\"2\" width=\"30px\">\n${\\frac{\\text{d}}{\\text{d}x}f(y(x))|}_{{x}_{0}}=\\,\\,$\n</td>\n<td align=\"center\" height=\"35px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"30px\">{{field-2}}</td>\n<td align=\"center\" width=\"30px\">$6$</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">\n{{field-3}}\n</td>\n<td align=\"center\">{{field-4}}</td>\n<td align=\"center\">$2$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Using the chain rule, we have\n\n$$\n\\frac{\\text{d}}{\\text{d}x}f(y(x))=\\frac{\\text{d}f}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x}.\n$$\n\nLet's consider each of the factors in turn.\n\n- The function $f$ acts on a vector $y\\in {R}^{2}$ by multiplying it by $B$ and outputs a vector $f(y)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}f}{\\text{d}y}=B.\n$$\n\n- The function $y$ acts on a vector $x\\in {R}^{3}$ by multiplying it by $A$ and outputs a vector $y(x)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=A.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}f(y(x)) & =\\frac{\\text{d}f}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x} \\\\  & =BA \\\\  & =[\\begin{aligned}1 & 0 \\\\ 0 & 2\\end{aligned}][\\begin{aligned}2 & 4 & 6 \\\\ 2 & -2 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 4 & 6 \\\\ 4 & -4 & 2\\end{aligned}].\\end{aligned}\n$$"} :step/id #uuid "99a98175-6d17-5897-8ff6-309efa769d68" :step/next {:db/id #edb/ref 17592186551410}} {:db/id #edb/ref 17592186551436 :step/content {:db/id #edb/ref 17592186204581 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "316633d4-c832-597f-bfdd-ba8fe21eae33" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186550486}] :answer-field/correct {:db/id #edb/ref 17592186550486} :answer-field/id #uuid "b0873e6b-ac32-5906-9ff1-6249bdd1cbd5" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186203419} {:answer-field/choices [{:answer/id #uuid "dcc67051-2347-5c4e-9e43-c494abdd7e5e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186550969}] :answer-field/correct {:db/id #edb/ref 17592186550969} :answer-field/id #uuid "b969bb55-bc5a-5945-b3df-c8d2456f4c6d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186203420} {:answer-field/choices [{:answer/id #uuid "f5702173-007e-5e88-ab6b-3cfa857c23be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "24" :db/id #edb/ref 17592186551024}] :answer-field/correct {:db/id #edb/ref 17592186551024} :answer-field/id #uuid "49fc9d7d-9dc9-5e03-aa43-00a50baae4b0" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186203421} {:answer-field/choices [{:answer/id #uuid "d6616688-0122-57c7-8244-6a4ed78090eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186550949}] :answer-field/correct {:db/id #edb/ref 17592186550949} :answer-field/id #uuid "677c6ddc-f060-517c-9870-bde56ed7bc70" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186203422}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "368352a6-b376-537f-a20c-679a2f14ab27" :question/math-academy-id "q-269238" :question/problem "Consider the functions $y:{R}^{3}\\to {R}^{2}$ and $f:{R}^{2}\\to {R}^{2},$ defined by\n\n$$\ny(x)=[\\begin{aligned}{x}_{1}{x}_{2}{x}_{3} \\\\ {x}_{1}+{x}_{2}+{x}_{3}\\end{aligned}],\\,f(y)=[\\begin{aligned}{y}_{1}+{y}_{2} \\\\ {y}_{1}{y}_{2}\\end{aligned}].\n$$\n\nWhat is \n$\\frac{\\text{d}}{\\text{d}x}f(y(x))$ evaluated at \n${x}_{0}=[\\begin{aligned}1 \\\\ 2 \\\\ 3\\end{aligned}]?$\n\n<table cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"70px\" rowspan=\"2\" width=\"30px\">\n${\\frac{\\text{d}}{\\text{d}x}f(y(x))|}_{{x}_{0}}=\\,\\,$\n</td>\n<td align=\"center\" height=\"35px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"30px\">{{field-2}}</td>\n<td align=\"center\" width=\"30px\">{{field-3}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">$42$</td>\n<td align=\"center\">{{field-4}}</td>\n<td align=\"center\">$18$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Using the chain rule, we have\n\n$$\n\\frac{\\text{d}}{\\text{d}x}f(y(x))=\\frac{\\text{d}f}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x}.\n$$\n\nLet's consider each of the factors in turn.\n\n- The function $f$ acts on a vector $y\\in {R}^{2}$ and outputs a vector $f(y)\\in {R}^{2}.$ Thus, the total derivative of $f$ with respect to $y$ is a $2\\times 2$ matrix \n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}y} & =[\\begin{aligned}\\frac{∂{f}_{1}}{∂{y}_{1}} & \\frac{∂{f}_{1}}{∂{y}_{2}} \\\\ \\frac{∂{f}_{2}}{∂{y}_{1}} & \\frac{∂{f}_{2}}{∂{y}_{2}}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{∂}{∂{y}_{1}}({y}_{1}+{y}_{2}) & \\frac{∂}{∂{y}_{2}}({y}_{1}+{y}_{2}) \\\\ \\frac{∂}{∂{y}_{1}}({y}_{1}{y}_{2}) & \\frac{∂}{∂{y}_{2}}({y}_{1}{y}_{2})\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 1 \\\\ {y}_{2} & {y}_{1}\\end{aligned}].\\end{aligned}\n$$\n\nEvaluating at ${y}_{0}=y({x}_{0})=[\\begin{aligned}1\\cdot 2\\cdot 3 \\\\ 1+2+3\\end{aligned}]=[\\begin{aligned}6 \\\\ 6\\end{aligned}],$ we get\n\n$$\n\\frac{\\text{d}f}{\\text{d}y}{|}_{{y}_{0}}=[\\begin{aligned}1 & 1 \\\\ 6 & 6\\end{aligned}].\n$$\n\n- The function $y$ acts on a vector $x\\in {R}^{3}$ and outputs a vector $y(x)\\in {R}^{2}.$ Thus, the total derivative of $y$ with respect to $x$ is a $2\\times 3$ matrix\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =[\\begin{aligned}\\frac{∂{y}_{1}}{∂{x}_{1}} & \\frac{∂{y}_{1}}{∂{x}_{2}} & \\frac{∂{y}_{1}}{∂{x}_{3}} \\\\ \\frac{∂{y}_{2}}{∂{x}_{1}} & \\frac{∂{y}_{2}}{∂{x}_{2}} & \\frac{∂{y}_{2}}{∂{x}_{3}}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{∂}{∂{x}_{1}}({x}_{1}{x}_{2}{x}_{3}) & \\frac{∂}{∂{x}_{2}}({x}_{1}{x}_{2}{x}_{3}) & \\frac{∂}{∂{x}_{3}}({x}_{1}{x}_{2}{x}_{3}) \\\\ \\frac{∂}{∂{x}_{1}}({x}_{1}+{x}_{2}+{x}_{3}) & \\frac{∂}{∂{x}_{2}}({x}_{1}+{x}_{2}+{x}_{3}) & \\frac{∂}{∂{x}_{3}}({x}_{1}+{x}_{2}+{x}_{3})\\end{aligned}] \\\\  & =[\\begin{aligned}{x}_{2}{x}_{3} & {x}_{1}{x}_{3} & {x}_{1}{x}_{2} \\\\ 1 & 1 & 1\\end{aligned}].\\end{aligned}\n$$\n\nEvaluating at ${x}_{0}=[\\begin{aligned}1 \\\\ 2 \\\\ 3\\end{aligned}],$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}{|}_{{x}_{0}}=[\\begin{aligned}6 & 3 & 2 \\\\ 1 & 1 & 1\\end{aligned}].\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}f(y(x)){|}_{{x}_{0}} & =\\frac{\\text{d}f}{\\text{d}y}{|}_{{y}_{0}}\\cdot \\frac{\\text{d}y}{\\text{d}x}{|}_{{x}_{0}} \\\\  & =[\\begin{aligned}1 & 1 \\\\ 6 & 6\\end{aligned}]\\cdot [\\begin{aligned}6 & 3 & 2 \\\\ 1 & 1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}7 & 4 & 3 \\\\ 42 & 24 & 18\\end{aligned}].\\end{aligned}\n$$"} :step/id #uuid "aeffc49e-02fd-5851-a96c-59f1d28fc3f8" :step/next {:db/id #edb/ref 17592186551438}} {:db/id #edb/ref 17592186551438 :step/content {:db/id #edb/ref 17592186204589 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ec5a3336-3253-558e-8eea-a50f43e5289c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186551008}] :answer-field/correct {:db/id #edb/ref 17592186551008} :answer-field/id #uuid "0f73e036-475e-5687-853e-9785d38d4e1d" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186203454} {:answer-field/choices [{:answer/id #uuid "a6a5ce82-7ccb-54b4-abfb-a30641f2c77e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186550807}] :answer-field/correct {:db/id #edb/ref 17592186550807} :answer-field/id #uuid "6d909db8-6eaa-5ec5-a6a8-827060dc9d3a" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186203455} {:answer-field/choices [{:answer/id #uuid "6f15b05f-36f5-5ea3-9bed-f930f886c722" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186550645}] :answer-field/correct {:db/id #edb/ref 17592186550645} :answer-field/id #uuid "7500859b-5950-57ad-a96f-d5c5744bf3cd" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186203456}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f58fff21-d3fb-52ca-9d37-4bc6136c058d" :question/math-academy-id "q-269780" :question/problem "Consider the functions $y:{R}^{2}\\to {R}^{2}$ and $f:{R}^{2}\\to {R}^{2},$ defined by\n\n$$\ny(x)=[\\begin{aligned}\\frac{1}{2}({x}_{1}^{2}+{x}_{2}^{2}) \\\\ {x}_{1}+{x}_{2}\\end{aligned}],\\,f(y)=[\\begin{aligned}{y}_{1}{y}_{2} \\\\ {y}_{1}^{2}+{y}_{2}^{2}\\end{aligned}].\n$$\n\nWhat is \n$\\frac{\\text{d}}{\\text{d}x}f(y(x))$ evaluated at \n${x}_{0}=[\\begin{aligned}0 \\\\ 2\\end{aligned}]?$\n\n<table cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"70px\" rowspan=\"2\" width=\"30px\">\n${\\frac{\\text{d}}{\\text{d}x}f(y(x))|}_{{x}_{0}}=\\,\\,$\n</td>\n<td align=\"center\" height=\"35px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"30px\">{{field-2}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">$4$</td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Using the chain rule, we have\n\n$$\n\\frac{\\text{d}}{\\text{d}x}f(y(x))=\\frac{\\text{d}f}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x}.\n$$\n\nLet's consider each of the factors in turn.\n\n- The function $f$ acts on a vector $y\\in {R}^{2}$ and outputs a vector $f(y)\\in {R}^{2}.$ Thus, the total derivative of $f$ with respect to $y$ is a $2\\times 2$ matrix \n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}y} & =[\\begin{aligned}\\frac{∂{f}_{1}}{∂{y}_{1}} & \\frac{∂{f}_{1}}{∂{y}_{2}} \\\\ \\frac{∂{f}_{2}}{∂{y}_{1}} & \\frac{∂{f}_{2}}{∂{y}_{2}}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{∂}{∂{y}_{1}}({y}_{1}{y}_{2}) & \\frac{∂}{∂{y}_{2}}({y}_{1}{y}_{2}) \\\\ \\frac{∂}{∂{y}_{1}}({y}_{1}^{2}+{y}_{2}^{2}) & \\frac{∂}{∂{y}_{2}}({y}_{1}^{2}+{y}_{2}^{2})\\end{aligned}] \\\\  & =[\\begin{aligned}{y}_{2} & {y}_{1} \\\\ 2{y}_{1} & 2{y}_{2}\\end{aligned}].\\end{aligned}\n$$\n\nEvaluating at ${y}_{0}=y({x}_{0})=[\\begin{aligned}\\frac{1}{2}({0}^{2}+{2}^{2}) \\\\ 0+2\\end{aligned}]=[\\begin{aligned}2 \\\\ 2\\end{aligned}],$ we get\n\n$$\n\\frac{\\text{d}f}{\\text{d}y}{|}_{{y}_{0}}=[\\begin{aligned}2 & 2 \\\\ 4 & 4\\end{aligned}].\n$$\n\n- The function $y$ acts on a vector $x\\in {R}^{2}$ and outputs a vector $y(x)\\in {R}^{2}.$ Thus, the total derivative of $y$ with respect to $x$ is a $2\\times 2$ matrix\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =[\\begin{aligned}\\frac{∂{y}_{1}}{∂{x}_{1}} & \\frac{∂{y}_{1}}{∂{x}_{2}} \\\\ \\frac{∂{y}_{2}}{∂{x}_{1}} & \\frac{∂{y}_{2}}{∂{x}_{2}}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{∂}{∂{x}_{1}}(\\frac{1}{2}({x}_{1}^{2}+{x}_{2}^{2})) & \\frac{∂}{∂{x}_{2}}(\\frac{1}{2}({x}_{1}^{2}+{x}_{2}^{2})) \\\\ \\frac{∂}{∂{x}_{1}}({x}_{1}+{x}_{2}) & \\frac{∂}{∂{x}_{2}}({x}_{1}+{x}_{2})\\end{aligned}] \\\\  & =[\\begin{aligned}{x}_{1} & {x}_{2} \\\\ 1 & 1\\end{aligned}].\\end{aligned}\n$$\n\nEvaluating at ${x}_{0}=[\\begin{aligned}0 \\\\ 2\\end{aligned}],$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}{|}_{{x}_{0}}=[\\begin{aligned}0 & 2 \\\\ 1 & 1\\end{aligned}].\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}f(y(x)){|}_{{x}_{0}} & =\\frac{\\text{d}f}{\\text{d}y}{|}_{{y}_{0}}\\cdot \\frac{\\text{d}y}{\\text{d}x}{|}_{{x}_{0}} \\\\  & =[\\begin{aligned}2 & 2 \\\\ 4 & 4\\end{aligned}]\\cdot [\\begin{aligned}0 & 2 \\\\ 1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 6 \\\\ 4 & 12\\end{aligned}].\\end{aligned}\n$$"} :step/id #uuid "b0e4ff39-21d5-5469-8555-eb4203698626" :step/next {:db/id #edb/ref 17592186551360}}] :activity/title "The Chain Rule for Total Derivatives" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186550365}]}
