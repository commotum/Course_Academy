#{[{:db/id #edb/ref 17592186435769 :knowledge-point/_questions [{:db/id #edb/ref 17592186119779 :knowledge-point/id #uuid "164c56ea-afbb-5ce4-800a-19002695db76" :knowledge-point/title "Calculating the Determinant of the Inverse of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d19261f-2d17-5ce6-a528-357db19c92fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{76}" :db/id #edb/ref 17592186435743} {:answer/id #uuid "44e2e6b4-ad39-5370-b46a-da247adce9ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{82}" :db/id #edb/ref 17592186435745} {:answer/id #uuid "4bc3f9d6-53b9-5b49-91f9-095f7560a365" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{84}" :db/id #edb/ref 17592186435748} {:answer/id #uuid "505a34ac-ba5d-5a72-8645-7ed3b579499e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{64}" :db/id #edb/ref 17592186435750} {:answer/id #uuid "ce24b16c-5b82-5027-a711-29aa725ec9c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{48}" :db/id #edb/ref 17592186435760}] :answer-field/correct {:answer/id #uuid "4bc3f9d6-53b9-5b49-91f9-095f7560a365" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{84}" :db/id #edb/ref 17592186435748} :answer-field/id #uuid "a2f79099-495d-5b97-91da-18a1c01e2ef1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186435764}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8501cdd8-7879-5e81-a6ba-962c1d7f9129" :question/math-academy-id "q-130532" :question/problem "Find $|{A}^{-1}|,$ if $A=\\begin{bmatrix}-5 & -3 & 4 \\\\ -2 & 1 & 2 \\\\ 1 & -4 & 6\\end{bmatrix}.$" :question/worked-solution "Given an invertible $n\\times n$ matrix $A,$ we have\n\n$$\n|{A}^{-1}|=\\frac{1}{|A|}.\n$$\n\nFirst, we find $|A|$ using a Laplace expansion across the $2$nd row:\n\n$$\n\\begin{aligned}|A| & =|\\begin{aligned}-5 & -3 & 4 \\\\ -2 & 1 & 2 \\\\ 1 & -4 & 6\\end{aligned}| \\\\  & =-2(-1)^{2+1}|\\begin{aligned}-3 & 4 \\\\ -4 & 6\\end{aligned}|+1(-1)^{2+2}|\\begin{aligned}-5 & 4 \\\\ 1 & 6\\end{aligned}|+2(-1)^{2+3}|\\begin{aligned}-5 & -3 \\\\ 1 & -4\\end{aligned}| \\\\  & =2(-18+16)+(-30-4)-2(20+3) \\\\  & =-4-34-46 \\\\  & =-84\\end{aligned}\n$$\n\nTherefore, we obtain \n\n$$\n|{A}^{-1}|=\\frac{1}{|A|}=-\\frac{1}{84}.\n$$"}] [{:db/id #edb/ref 17592186354639 :knowledge-point/_questions [{:db/id #edb/ref 17592186119780 :knowledge-point/id #uuid "6e4dd07e-475b-5c89-883b-0e4adcf6a723" :knowledge-point/title "Calculating a Determinant Using the Linearity of the Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "356b3816-6db1-52b5-bb62-b3c3cf31be2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "282" :db/id #edb/ref 17592186352065} {:answer/id #uuid "4961badc-1952-50cf-a3aa-c27c2154e001" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "447" :db/id #edb/ref 17592186352242} {:answer/id #uuid "7e93fedb-8a75-5259-a81d-4a24a5c3ba66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "372" :db/id #edb/ref 17592186352678} {:answer/id #uuid "b7b4f3fb-84a7-5faa-a662-e6383aedf972" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "273" :db/id #edb/ref 17592186353139} {:answer/id #uuid "d43b6429-3ee0-5e37-bfcf-0795e21063ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "327" :db/id #edb/ref 17592186353406}] :answer-field/correct {:answer/id #uuid "b7b4f3fb-84a7-5faa-a662-e6383aedf972" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "273" :db/id #edb/ref 17592186353139} :answer-field/id #uuid "d31711c3-cb15-50d5-862f-d3265b1300b3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354174}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "26f8d807-4854-5fae-88e0-bb503698def0" :question/math-academy-id "q-88301" :question/problem "Find\n$|\\begin{aligned}1 & 3 & 6 \\\\ 91 & 92 & 93 \\\\ 90 & 92 & 93\\end{aligned}|.$" :question/worked-solution "First, notice that the $2$nd row of our determinant is almost equal to the $3$rd row. So, we can rewrite the given determinant, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 3 & 6 \\\\ 91 & 92 & 93 \\\\ 90 & 92 & 93\\end{aligned}| & =|\\begin{aligned}1 & 3 & 6 \\\\ 90+1 & 92+0 & 93+0 \\\\ 90 & 92 & 93\\end{aligned}|\\end{aligned}\n$$\n\nNext, using the linearity property of determinants, we obtain\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 3 & 6 \\\\ 90+1 & 92+0 & 93+0 \\\\ 90 & 92 & 93\\end{aligned}| & =|\\begin{aligned}1 & 3 & 6 \\\\ 90 & 92 & 93 \\\\ 90 & 92 & 93\\end{aligned}|+|\\begin{aligned}1 & 3 & 6 \\\\ 1 & 0 & 0 \\\\ 90 & 92 & 93\\end{aligned}|.\\end{aligned}\n$$\n\nThe first determinant must be zero since it has two identical rows, while the second determinant can be expanded across the $2$nd row, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 3 & 6 \\\\ 90 & 92 & 93 \\\\ 90 & 92 & 93\\end{aligned}|+|\\begin{aligned}1 & 3 & 6 \\\\ 1 & 0 & 0 \\\\ 90 & 92 & 93\\end{aligned}| & =0+1(-1)^{2+1}|\\begin{aligned}3 & 6 \\\\ 92 & 93\\end{aligned}| \\\\  & =-(3\\cdot 93-6\\cdot 92) \\\\  & =-(279-552) \\\\  & =273\\end{aligned}\n$$"}]}
