 #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=3" :db/id #edb/ref 17592186561646} {:answer/id #uuid "84bf8d4b-e1dd-5e39-91e0-bbd4bed49d5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-3" :db/id #edb/ref 17592186561915} {:answer/id #uuid "a2a68c09-e561-5972-b1de-a377a2d7493c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=24" :db/id #edb/ref 17592186561989} {:answer/id #uuid "c52e69c8-55d9-5e0a-ae2c-31c8ac9b5e86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-2" :db/id #edb/ref 17592186562076}] :answer-field/correct {:answer/id #uuid "84bf8d4b-e1dd-5e39-91e0-bbd4bed49d5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-3" :db/id #edb/ref 17592186561915} :answer-field/id #uuid "3f86bbaa-01ae-54d7-9a11-3fded039a7a6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186562265}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4df53049-83f0-5413-984e-828686fce8c5" :question/math-academy-id "q-46173" :question/problem "What is the axis of symmetry of the parabola $y=-2(x+3)^{2}+24?$" :question/worked-solution "The axis of symmetry of the parabola is the vertical line that passes through the vertex of the parabola. To find the axis of symmetry, we need to compute the $x$-coordinate of the vertex of the parabola.\n\nRemember that the vertex form of a parabola is \n\n$$\ny=a(x-h)^{2}+k,\n$$\n\nwhere $(h,k)$ are the coordinates of the vertex of the parabola.\n\nThe given parabola\n\n$$\ny=-2(x+3)^{2}+24\n$$\n\nis written in vertex form with $h=-3$ and $k=24.$ Therefore, the vertex of the parabola is at $(-3,24),$ and the axis of symmetry is $x=-3.$"}] [{:db/id #edb/ref 17592186562492 :knowledge-point/_questions [{:db/id #edb/