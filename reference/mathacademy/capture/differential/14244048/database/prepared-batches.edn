[{"source" ":org/Math-Academy" "forms" [{:db/id 17592186087831 :knowledge-point/questions ["question-c582f0f1-f871-50b8-b88f-03165acfd197" "question-00a59ef1-c144-5d9f-b94c-7d377a8424ae" "question-23728b9f-173c-56ba-ae78-f4addd3b788e" "question-1ef76044-e494-5a9c-b8eb-8a5d68b12c3b" "question-e7468eec-835f-58ac-adfb-8c025bf94873"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186087436 :question/problem "What are the coordinates of the vertex of the parabola $y=-3(x+5)^2-4?$" :question/worked-solution "Remember that the vertex form of a parabola is \n\n$$\ny=a(x-h)^2 + k,\n$$\n\nwhere $(h,k)$ are the coordinates of the vertex of the parabola.\n\nThe given parabola\n\n$$\ny=-3(x+5)^2-4\n$$\n\nis written in vertex form with $h=-5$ and $k=-4.$ To see this clearly, note that we can write the parabola as follows:\n\n$$\ny=-3(x-(-5))^2-4\n$$\n\nTherefore, the vertex of the parabola is at $(-5,-4).$" :db/ensure [:question/validate]} {:db/id 17592186087885 :knowledge-point/questions ["question-791380d3-6e81-592a-9d95-9f0a6153a5e2" "question-4df53049-83f0-5413-984e-828686fce8c5" "question-29b03696-3c9f-5636-9c19-2a6a7c7c486b" "question-0632da5c-9a68-5b87-b79c-de6c52b69ed8" "question-8594afb6-5972-53f6-b33b-4159f91dec13"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186087445 :question/problem "What is the axis of symmetry of the parabola $y=4(x-3)^2+2?$" :question/worked-solution "The axis of symmetry of the parabola is the vertical line that passes through the vertex of the parabola. To find the axis of symmetry, we need to compute the $x$-coordinate of the vertex of the parabola.\n\nRemember that the vertex form of a parabola is \n\n$$\ny=a(x-h)^2 + k,\n$$\n\nwhere $(h,k)$ are the coordinates of the vertex of the parabola.\n\nThe given parabola\n\n$$\ny=4(x-3)^2+2\n$$\n\nis written in vertex form with $h=3$ and $k=2.$ Therefore, the vertex of the parabola is at $(3,2),$ and the axis of symmetry is $x=3.$" :db/ensure [:question/validate]} {:db/id 17592186087803 :knowledge-point/questions ["question-44eed42c-2275-58db-b76f-79ce8ef867da" "question-6d0de4b8-6fc5-5dcf-a220-ce0c3dea2116" "question-ecb40e2d-67b0-50de-be66-e4bed789b5a0" "question-b8aee55c-aa76-53a1-afb7-e8a42dc37dcd" "question-3968dfc0-a6cb-5c0d-a0d8-393a6ade59fc"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186087631 :question/problem "Find the minimum value of the parabola ![](images/d3/d30006cd23eb5bc4fab41b442fa7559a396842e82c35c3a481533208827abe28.svg) sketched below.\n\n![](images/1a/1af23738cbe57195d1bf4dc223c37fab61cb89058388445a67eadeaab88a14bd.png)" :question/worked-solution "The minimum value of the parabola is the ![](images/1d/1d9b846cface9f9348e4081a0dd87dd254bf26663c12aa0d1a15aa24d2393261.svg)-coordinate of the vertex of the parabola. \n\nRemember that the vertex form of a parabola is\n\n![](images/c5/c53ff35f8ae40bcb44f4cf26ad7f0d1bed0dabc73298562d7041cc90a0b1de3c.svg)\n\nwhere ![](images/3a/3a6333dccc007be0992f95974a58ce3d652e5ecafcaaa865a24ff8b42bcfc37a.svg) are the coordinates of the vertex of the parabola.\n\nThe given parabola\n\n![](images/21/211afc137cc4072f18eb008836b3f2d8c231aa5ae017476147b0b50014525f39.svg)\n\nis written in vertex form with ![](images/03/033a93fcdc4a0358a5de03cbdda9860a8ac6aa6a735f3681a6477c3a3e52ea55.svg) and ![](images/10/1027d08706beef7b1afa836932edaac3ebad0885bb8a2be54860dc768d431ff9.svg) Therefore, the vertex of the parabola is at ![](images/79/795920c332cb28b6b824a8b84b1226b6d1e5b5f890e16ecd6752ce6fd619e37e.svg) and its minimum value is ![](images/d4/d44d7e189fa83441142c19838f09553ff4b73fba09689c5a04d1a6eaf5fef088.svg)" :db/ensure [:question/validate]} {:db/id "question-c582f0f1-f871-50b8-b88f-03165acfd197" :question/id #uuid "c582f0f1-f871-50b8-b88f-03165acfd197" :question/math-academy-id "q-46174" :question/problem "What are the coordinates of the vertex of the parabola $y=-(x+2)^{2}+3?$" :question/worked-solution "Remember that the vertex form of a parabola is \n\n$$\ny=a(x-h)^{2}+k,\n$$\n\nwhere $(h,k)$ are the coordinates of the vertex of the parabola.\n\nThe given parabola\n\n$$\ny=-(x+2)^{2}+3\n$$\n\nis written in vertex form with $h=-2$ and $k=3.$ To see this clearly, note that we can write the parabola as follows:\n\n$$\ny=-(x-(-2))^{2}+3\n$$\n\nTherefore, the vertex of the parabola is at $(-2,3).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-4c32a66a-9074-5966-b6db-d71011681b35"] :db/ensure [:question/validate]} {:db/id "answer-field-4c32a66a-9074-5966-b6db-d71011681b35" :answer-field/id #uuid "4c32a66a-9074-5966-b6db-d71011681b35" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-04e8a8a8-3706-59fe-a287-2a770b8419fa" :answer-field/choices ["answer-1eff41e0-f9b3-51c5-a29a-c4ce22da8c59" "answer-04e8a8a8-3706-59fe-a287-2a770b8419fa" "answer-002bd208-8560-5adc-9a07-c761d0d84b1e" "answer-10cee7e7-895a-5600-9a5e-f6a9b7a42e32" "answer-4499f164-f227-50e5-9214-5ca31d20414f"] :db/ensure [:answer-field/validate]} {:db/id "answer-1eff41e0-f9b3-51c5-a29a-c4ce22da8c59" :answer/id #uuid "1eff41e0-f9b3-51c5-a29a-c4ce22da8c59" :answer/type :answer.type/math :answer/value "(-2,-3)" :db/ensure [:answer/validate]} {:db/id "answer-04e8a8a8-3706-59fe-a287-2a770b8419fa" :answer/id #uuid "04e8a8a8-3706-59fe-a287-2a770b8419fa" :answer/type :answer.type/math :answer/value "(-2,3)" :db/ensure [:answer/validate]} {:db/id "answer-002bd208-8560-5adc-9a07-c761d0d84b1e" :answer/id #uuid "002bd208-8560-5adc-9a07-c761d0d84b1e" :answer/type :answer.type/math :answer/value "(2,3)" :db/ensure [:answer/validate]} {:db/id "answer-10cee7e7-895a-5600-9a5e-f6a9b7a42e32" :answer/id #uuid "10cee7e7-895a-5600-9a5e-f6a9b7a42e32" :answer/type :answer.type/math :answer/value "(3,-2)" :db/ensure [:answer/validate]} {:db/id "answer-4499f164-f227-50e5-9214-5ca31d20414f" :answer/id #uuid "4499f164-f227-50e5-9214-5ca31d20414f" :answer/type :answer.type/math :answer/value "(3,2)" :db/ensure [:answer/validate]