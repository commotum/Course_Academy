field-3f86bbaa-01ae-54d7-9a11-3fded039a7a6"] [17592186087885 :knowledge-point/questions "question-4df53049-83f0-5413-984e-828686fce8c5"] ["question-29b03696-3c9f-5636-9c19-2a6a7c7c486b" :question/id #uuid "29b03696-3c9f-5636-9c19-2a6a7c7c486b"] ["question-29b03696-3c9f-5636-9c19-2a6a7c7c486b" :question/math-academy-id "q-85125"] ["question-29b03696-3c9f-5636-9c19-2a6a7c7c486b" :question/problem "What is the axis of symmetry of the parabola $y=(x+2)^{2}-5?$"] ["question-29b03696-3c9f-5636-9c19-2a6a7c7c486b" :question/worked-solution "The axis of symmetry of the parabola is the vertical line that passes through the vertex of the parabola. To find the axis of symmetry, we need to compute the $x$-coordinate of the vertex of the parabola.\n\nRemember that the vertex form of a parabola is \n\n$$\ny=a(x-h)^{2}+k,\n$$\n\nwhere $(h,k)$ are the coordinates of the vertex of the parabola.\n\nThe given parabola\n\n$$\ny=(x+2)^{2}-5\n$$\n\nis written in vertex form with $h=-2$ and $k=-5.$ Therefore, the vertex of the parabola is at $(-2,-5),$ and the axis of symmetry is $x=-2.$"] ["question-29b03696-3c9f-5636-9c19-2a6a7c7c486b" :question/difficulty :question.difficulty/easy] ["answer-field-c2724c69-1aad-5ad0-812d-b8b17762a961" :answer-field/id #uuid "c2724c69-1aad-5ad0-812d-b8b17762a961"] ["answer-3316555a-d4cb-5dcc-940e-1a646035997f" :answer/id #uuid "3316555a-d4cb-5dcc-940e-1a646035997f"] ["answer-3316555a-d4cb-5dcc-940e-1a646035997f" :answer/type :answer.type/math] ["answer-3316555a-d4cb-5dcc-940e-1a646035997f" :answer/value "x=-2"] ["answer-f131f073-0c8a-5b82-8169-39a7ca28063f" :answer/id #uuid "f131f073-0c8a-5b82-8169-39a7ca28063f"] ["answer-f131f073-0c8a-5b82-8169-39a7ca28063f" :answer/type :answer.type/math] ["answer-f131f073-0c8a-5b82-8169-39a7ca28063f" :answer/value "x=-5"] ["answer-baac87ea-9f41-579b-937f-e5308ffecab7" :answer/id #uuid "baac87ea-9f41-579b-937f-e5308ffecab7"] ["answer-baac87ea-9f41-579b-937f-e5308ffecab7" :answer/type :answer.type/math] ["answer-baac87ea