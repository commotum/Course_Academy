016221" :answer-field/choices "answer-627534d8-9259-57c6-8e45-94a1948f847d"] ["question-44eed42c-2275-58db-b76f-79ce8ef867da" :question/answer-fields "answer-field-ed326daf-c793-50e2-8958-689529016221"] [17592186087803 :knowledge-point/questions "question-44eed42c-2275-58db-b76f-79ce8ef867da"] ["question-6d0de4b8-6fc5-5dcf-a220-ce0c3dea2116" :question/id #uuid "6d0de4b8-6fc5-5dcf-a220-ce0c3dea2116"] ["question-6d0de4b8-6fc5-5dcf-a220-ce0c3dea2116" :question/math-academy-id "q-85131"] ["question-6d0de4b8-6fc5-5dcf-a220-ce0c3dea2116" :question/problem "Find the maximum value of the parabola $y=-4(x+5)^{2}-3.$"] ["question-6d0de4b8-6fc5-5dcf-a220-ce0c3dea2116" :question/worked-solution "The maximum value of the parabola is the $y$-coordinate of the vertex of the parabola. \n\nRemember that the vertex form of a parabola is\n\n$$\ny=a(x-h)^{2}+k\n$$\n\nwhere $(h,k)$ are the coordinates of the vertex of the parabola.\n\nThe given parabola\n\n$$\ny=-4(x+5)^{2}-3\n$$\n\nis written in vertex form with $h=-5$ and $k=-3.$ Therefore, the vertex of the parabola is at $(-5,-3),$ and its maximum value is $-3.$"] ["question-6d0de4b8-6fc5-5dcf-a220-ce0c3dea2116" :question/difficulty :question.difficulty/moderate] ["answer-field-215a268f-4f2f-5250-bcca-1acc469f1269" :answer-field/id #uuid "215a268f-4f2f-5250-bcca-1acc469f1269"] ["answer-6b340ba5-0086-5d04-b040-68dac39650de" :answer/id #uuid "6b340ba5-0086-5d04-b040-68dac39650de"] ["answer-6b340ba5-0086-5d04-b040-68dac39650de" :answer/type :answer.type/math] ["answer-6b340ba5-0086-5d04-b040-68dac39650de" :answer/value "-3"] ["answer-d14661e2-0f7a-555a-81e1-ef563d09f2c1" :answer/id #uuid "d14661e2-0f7a-555a-81e1-ef563d09f2c1"] ["answer-d14661e2-0f7a-555a-81e1-ef563d09f2c1" :answer/type :answer.type/math] ["answer-d14661e2-0f7a-555a-81e1-ef563d09f2c1" :answer/value "-5"] ["answer-19c36781-3c1e-5113-9ce9-df536c37ec80" :answer/id #uuid "19c36781-3c1e-5113-9ce9-df536c37ec80"] ["answer-19c36781-3c1e-5113-9ce9-df536c37ec80" :answer/type :ans