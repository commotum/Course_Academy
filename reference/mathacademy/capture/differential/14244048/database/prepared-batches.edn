abola\n\n$$\ny=6(x-4)^{2}-7\n$$\n\nis written in vertex form with $h=4$ and $k=-7.$ Therefore, the vertex of the parabola is at $(4,-7),$ and the axis of symmetry is $x=4.$"] ["question-8594afb6-5972-53f6-b33b-4159f91dec13" :question/difficulty :question.difficulty/moderate] ["answer-field-5210d6fc-62ed-5538-bea7-c1bbadf45b6d" :answer-field/id #uuid "5210d6fc-62ed-5538-bea7-c1bbadf45b6d"] ["answer-09054d20-782a-5afe-b1b2-eaca3c0030a8" :answer/id #uuid "09054d20-782a-5afe-b1b2-eaca3c0030a8"] ["answer-09054d20-782a-5afe-b1b2-eaca3c0030a8" :answer/type :answer.type/math] ["answer-09054d20-782a-5afe-b1b2-eaca3c0030a8" :answer/value "x=-4"] ["answer-57570136-28db-5e5c-8a9a-e69c65121f90" :answer/id #uuid "57570136-28db-5e5c-8a9a-e69c65121f90"] ["answer-57570136-28db-5e5c-8a9a-e69c65121f90" :answer/type :answer.type/math] ["answer-57570136-28db-5e5c-8a9a-e69c65121f90" :answer/value "x=-7"] ["answer-d85316aa-884f-5d60-82ac-c2726a928dc8" :answer/id #uuid "d85316aa-884f-5d60-82ac-c2726a928dc8"] ["answer-d85316aa-884f-5d60-82ac-c2726a928dc8" :answer/type :answer.type/math] ["answer-d85316aa-884f-5d60-82ac-c2726a928dc8" :answer/value "x=4"] ["answer-704151e4-4e4a-50e3-af7c-6a6a09e0a63b" :answer/id #uuid "704151e4-4e4a-50e3-af7c-6a6a09e0a63b"] ["answer-704151e4-4e4a-50e3-af7c-6a6a09e0a63b" :answer/type :answer.type/math] ["answer-704151e4-4e4a-50e3-af7c-6a6a09e0a63b" :answer/value "x=6"] ["answer-20ce2090-0c6f-539b-b740-0c9d5fb8317e" :answer/id #uuid "20ce2090-0c6f-539b-b740-0c9d5fb8317e"] ["answer-20ce2090-0c6f-539b-b740-0c9d5fb8317e" :answer/type :answer.type/math] ["answer-20ce2090-0c6f-539b-b740-0c9d5fb8317e" :answer/value "x=7"] ["answer-field-5210d6fc-62ed-5538-bea7-c1bbadf45b6d" :answer-field/key "selection"] ["answer-field-5210d6fc-62ed-5538-bea7-c1bbadf45b6d" :answer-field/type :answer-field.type/radio] ["answer-field-5210d6fc-62ed-5538-bea7-c1bbadf45b6d" :answer-field/correct "answer-d85316aa-884f-5d60-82ac-c2726a928dc8"] ["answer-field-5210d6fc-62ed-5538-bea7-c1bbadf4