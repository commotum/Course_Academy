-field-4dde9ca0-28bb-51d6-a6cf-f4dd71d957a4" :answer-field/choices "answer-fbeb0983-eed9-5f08-a59b-0c62eb545f90"] ["answer-field-4dde9ca0-28bb-51d6-a6cf-f4dd71d957a4" :answer-field/choices "answer-48402f88-74b4-5f3b-9927-2ab9ef4eaf26"] ["answer-field-4dde9ca0-28bb-51d6-a6cf-f4dd71d957a4" :answer-field/choices "answer-de8133b5-8269-5a00-905a-8e9b736e3eae"] ["question-791380d3-6e81-592a-9d95-9f0a6153a5e2" :question/answer-fields "answer-field-4dde9ca0-28bb-51d6-a6cf-f4dd71d957a4"] [17592186087885 :knowledge-point/questions "question-791380d3-6e81-592a-9d95-9f0a6153a5e2"] ["question-4df53049-83f0-5413-984e-828686fce8c5" :question/id #uuid "4df53049-83f0-5413-984e-828686fce8c5"] ["question-4df53049-83f0-5413-984e-828686fce8c5" :question/math-academy-id "q-46173"] ["question-4df53049-83f0-5413-984e-828686fce8c5" :question/problem "What is the axis of symmetry of the parabola $y=-2(x+3)^{2}+24?$"] ["question-4df53049-83f0-5413-984e-828686fce8c5" :question/worked-solution "The axis of symmetry of the parabola is the vertical line that passes through the vertex of the parabola. To find the axis of symmetry, we need to compute the $x$-coordinate of the vertex of the parabola.\n\nRemember that the vertex form of a parabola is \n\n$$\ny=a(x-h)^{2}+k,\n$$\n\nwhere $(h,k)$ are the coordinates of the vertex of the parabola.\n\nThe given parabola\n\n$$\ny=-2(x+3)^{2}+24\n$$\n\nis written in vertex form with $h=-3$ and $k=24.$ Therefore, the vertex of the parabola is at $(-3,24),$ and the axis of symmetry is $x=-3.$"] ["question-4df53049-83f0-5413-984e-828686fce8c5" :question/difficulty :question.difficulty/moderate] ["answer-field-3f86bbaa-01ae-54d7-9a11-3fded039a7a6" :answer-field/id #uuid "3f86bbaa-01ae-54d7-9a11-3fded039a7a6"] ["answer-c52e69c8-55d9-5e0a-ae2c-31c8ac9b5e86" :answer/id #uuid "c52e69c8-55d9-5e0a-ae2c-31c8ac9b5e86"] ["answer-c52e69c8-55d9-5e0a-ae2c-31c8ac9b5e86" :answer/type :answer.type/math] ["answer-c52e69c8-55d9-5e0a-ae2c-31c8ac9b5e86" :answer/value "x=-2"] ["a