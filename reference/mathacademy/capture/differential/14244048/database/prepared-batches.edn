tion.difficulty/moderate :question/answer-fields ["answer-field-5210d6fc-62ed-5538-bea7-c1bbadf45b6d"] :db/ensure [:question/validate]} {:db/id "answer-field-5210d6fc-62ed-5538-bea7-c1bbadf45b6d" :answer-field/id #uuid "5210d6fc-62ed-5538-bea7-c1bbadf45b6d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d85316aa-884f-5d60-82ac-c2726a928dc8" :answer-field/choices ["answer-09054d20-782a-5afe-b1b2-eaca3c0030a8" "answer-57570136-28db-5e5c-8a9a-e69c65121f90" "answer-d85316aa-884f-5d60-82ac-c2726a928dc8" "answer-704151e4-4e4a-50e3-af7c-6a6a09e0a63b" "answer-20ce2090-0c6f-539b-b740-0c9d5fb8317e"] :db/ensure [:answer-field/validate]} {:db/id "answer-09054d20-782a-5afe-b1b2-eaca3c0030a8" :answer/id #uuid "09054d20-782a-5afe-b1b2-eaca3c0030a8" :answer/type :answer.type/math :answer/value "x=-4" :db/ensure [:answer/validate]} {:db/id "answer-57570136-28db-5e5c-8a9a-e69c65121f90" :answer/id #uuid "57570136-28db-5e5c-8a9a-e69c65121f90" :answer/type :answer.type/math :answer/value "x=-7" :db/ensure [:answer/validate]} {:db/id "answer-d85316aa-884f-5d60-82ac-c2726a928dc8" :answer/id #uuid "d85316aa-884f-5d60-82ac-c2726a928dc8" :answer/type :answer.type/math :answer/value "x=4" :db/ensure [:answer/validate]} {:db/id "answer-704151e4-4e4a-50e3-af7c-6a6a09e0a63b" :answer/id #uuid "704151e4-4e4a-50e3-af7c-6a6a09e0a63b" :answer/type :answer.type/math :answer/value "x=6" :db/ensure [:answer/validate]} {:db/id "answer-20ce2090-0c6f-539b-b740-0c9d5fb8317e" :answer/id #uuid "20ce2090-0c6f-539b-b740-0c9d5fb8317e" :answer/type :answer.type/math :answer/value "x=7" :db/ensure [:answer/validate]} {:db/id "question-44eed42c-2275-58db-b76f-79ce8ef867da" :question/id #uuid "44eed42c-2275-58db-b76f-79ce8ef867da" :question/math-academy-id "q-85134" :question/problem "![](images/d8/d805cc4e6c4b817cc4a00d4cccfca59a8bb89ba49442b01deaed3ec75c2ffc1b.png)\n\nFind the minimum value of the parabola $y=3(x+5)^{2}-6$, sketched above." :question/worked-solution "The minimum value of the parabola is the $y$-coordinate of the vertex of the parabola. \n\nRemember that the vertex form of a parabola is\n\n$$\ny=a(x-h)^{2}+k\n$$\n\nwhere $(h,k)$ are the coordinates of the vertex of the parabola.\n\nThe given parabola\n\n$$\ny=3(x+5)^{2}-6\n$$\n\nis written in vertex form with $h=-5$ and $k=-6.$ Therefore, the vertex of the parabola is at $(-5,-6),$ and its minimum value is $-6.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ed326daf-c793-50e2-8958-689529016221"] :db/ensure [:question/validate]} {:db/id "answer-field-ed326daf-c793-50e2-8958-689529016221" :answer-field/id #uuid "ed326daf-c793-50e2-8958-689529016221" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4a2b7bc8-41fc-550c-b56c-d1d9568a0eb7" :answer-field/choices ["answer-58805847-e5ac-5345-89bb-b21c27b57781" "answer-0ac1c35a-bafe-5ad3-b28d-d8b0ce41d37e" "answer-4a2b7bc8-41fc-550c-b56c-d1d9568a0eb7" "answer-7e1bf146-5664-5571-a9a3-eb3c65161d88" "answer-627534d8-9259-57c6-8e45-94a1948f847d"] :db/ensure [:answer-field/validate]} {:db/id "answer-58805847-e5ac-5345-89bb-b21c27b57781" :answer/id #uuid "58805847-e5ac-5345-89bb-b21c27b57781" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-0ac1c35a-bafe-5ad3-b28d-d8b0ce41d37e" :answer/id #uuid "0ac1c35a-bafe-5ad3-b28d-d8b0ce41d37e" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "answer-4a2b7bc8-41fc-550c-b56c-d1d9568a0eb7" :answer/id #uuid "4a2b7bc8-41fc-550c-b56c-d1d9568a0eb7" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "answer-7e1bf146-5664-5571-a9a3-eb3c65161d88" :answer/id #uuid "7e1bf146-5664-5571-a9a3-eb3c65161d88" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-627534d8-9259-57c6-8e45-94a1948f847d" :answer/id #uuid "627534d8-9259-57c6-8e45-94a1948f847d" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "question-6d0de4b8-6fc5-5dcf-a220-ce0c3dea2116" :question/id #uuid "6d0de4b8-6fc5-5dcf-a220-ce0c3dea2116" :question/math-academy-id "q-85131" :question/problem "Find the maximum value of the parabola $y=-4(x+5)^{2}-3.$" :question/worked-solution "The maximum value of the parabola is the $y$-coordinate of the vertex of the parabola. \n\nRemember that the vertex form of a parabola is\n\n$$\ny=a(x-h)^{2}+k\n$$\n\nwhere $(h,k)$ are the coordinates of the vertex of the parabola.\n\nThe given parabola\n\n$$\ny=-4(x+5)^{2}-3\n$$\n\nis written in vertex form with $h=-5$ and $k=-3.$ Therefore, the vertex of the parabola is at $(-5,-3),$ and its maximum value is $-3.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-215a268f-4f2f-5250-bcca-1acc469f1269"] :db/ensure [:question/validate]} {:db/id "answer-field-215a268f-4f2f-5250-bcca-1acc469f1269" :answer-field/id #uuid "215a268f-4f2f-5250-bcca-1acc469f1269" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6b340ba5-0086-5d04-b040-68dac39650de" :answer-field/choices ["answer-6b340ba5-0086-5d04-b040-68dac39650de" "answer-d14661e2-0f7a-555a-81e1-ef563d09f2c1" "answer-19c36781-3c1e-5113-9ce9-df536c37ec80" "answer-494482c5-bc27-566a-9dcd-a7be70402440" "answer-0ac0d35b-4ef7-58d9-ba51-feda32aabec2"] :db/ensure [:answer-field/validate]} {:db/id "answer-6b340ba5-0086-5d04-b040-68dac39650de" :answer/id #uuid "6b340ba5-0086-5d04-b040-68dac39650de" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-d14661e2-0f7a-555a-81e1-ef563d09f2c1" :answer/id #uuid "d14661e2-0f7a-555a-81e1-ef563d09f2c1" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "answer-19c36781-3c1e-5113-9ce9-df536c37ec80" :answer/id #uuid "19c36781-3c1e-5113-9ce9-df536c37ec80" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-494482c5-bc27-566a-9dcd-a7be70402440" :answer/id #uuid "494482c5-bc27-566a-9dcd-a7be70402440" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-0ac0d35b-4ef7-58d9-ba51-feda32aabec2" :answer/id #uuid "0ac0d35b-4ef7-58d9-ba51-feda32aabec2" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "question-ecb40e2d-67b0-50de-be66-e4bed789b5a0" :question/id #uuid "ecb40e2d-67b0-50de-be66-e4bed789b5a0" :question/math-academy-id "q-46169" :question/problem "![](images/aa/aa4fdc44e56d2e6b55bc649f97dace1d9a270f8212f3a28da962059f9f1a6ad7.png)\n\nFind the minimum value of the parabola $y=(x-5)^{2}-5$, sketched above." :question/worked-solution "The minimum value of the parabola is the $y$-coordinate of the vertex of the parabola. \n\nRemember that the vertex form of a parabola is\n\n$$\ny=a(x-h)^{2}+k\n$$\n\nwhere $(h,k)$ are the coordinates of the vertex of the parabola.\n\nThe given parabola\n\n$$\ny=(x-5)^{2}-5\n$$\n\nis written in vertex form with $h=5$ and $k=-5.$ Therefore, the vertex of the parabola is at $(5,-5),$ and its minimum value is $-5.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-7c7c3f4c-2644-5973-a5e9-158bd96739b6"] :db/ensure [:question/validate]} {:db/id "answer-field-7c7c3f4c-2644-5973-a5e9-158bd96739b6" :answer-field/id #uuid "7c7c3f4c-2644-5973-a5e9-158bd96739b6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ee43b3ab-3ae9-56b0-889d-5b4544f936b6" :answer-field/choices ["answer-660923f0-ae1b-56d3-b4ef-4ceb27802fda" "answer-f5f003b1-42da-5dd8-91a2-319030e9a4c2" "answer-ee43b3ab-3ae9-56b0-889d-5b4544f936b6" "answer-d2fd642a-c21c-57bd-bc62-b55691d0af0e" "answer-1008e2c3-118b-56f9-b31f-46fa861bd2d1"] :db/ensure [:answer-field/validate]} {:db/id "answer-660923f0-ae1b-56d3-b4ef-4ceb27802fda" :answer/id #uuid "660923f0-ae1b-56d3-b4ef-4ceb27802fda" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-f5f003b1-42da-5dd8-91a2-319030e9a4c2" :answer/id #uuid "f5f003b1-42da-5dd8-91a2-319030e9a4c2" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "answer-ee43b3ab-3ae9-56b0-889d-5b4544f936b6" :answer/id #uuid "ee43b3ab-3ae9-56b0-889d-5b4544f936b6" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "answer-d2fd642a-c21c-57bd-bc62-b55691d0af0e" :answer/id #uuid "d2fd642a-c21c-57bd-bc62-b55691d0af0e" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-1008e2c3-118b-56f9-b31f-46fa861bd2d1" :answer/id #uuid "1008e2c3-118b-56f9-b31f-46fa861bd2d1" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "question-b8aee55c-aa76-53a1-afb7-e8a42dc37dcd" :question/id #uuid "b8aee55c-aa76-53a1-afb7-e8a42dc37dcd" :question/math-academy-id "q-106247" :question/problem "![](images/3f/3f07f2e5473df35b47f3033428fee4ae9b38cf554c00f0ddd1cb12a40d981710.png)\n\nFind the minimum value of the parabola $y=(x+1)^{2}+5$, sketched above." :question/worked-solution "The minimum value of the parabola is the $y$-coordinate of the vertex of the parabola. \n\nRemember that the vertex form of a parabola is\n\n$$\ny=a(x-h)^{2}+k\n$$\n\nwhere $(h,k)$ are the coordinates of the vertex of the parabola.\n\nThe given parabola\n\n$$\ny=(x+1)^{2}+5\n$$\n\nis written in vertex form with $h=-1$ and $k=5.$ Therefore, the vertex of the parabola is at $(-1,5),$ and its minimum value is $5.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-182db2a7-120c-575a-b697-10dbc867e038"] :db/ensure [:question/validate]} {:db/id "answer-field-182db2a7-120c-575a-b697-10dbc867e038" :answer-field/id #uuid "182db2a7-120c-575a-b697-10dbc867e038" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b2363633-4b4a-52b6-a1e8-74d6417cb54d" :answer-field/choices ["answer-2dd87c5f-688e-591f-8a52-8150a12a9667" "answer-e9dab541-f6ea-5af9-a097-2799d5494452" "answer-61eff8b4-3b45-53c5-b90f-57c84a4ca251" "answer-680c6546-17a4-56c9-bab0-a73030879071" "answer-b2363633-4b4a-52b6-a1e8-74d6417cb54d"] :db/ensure [:answer-field/validate]} {:db/id "answer-2dd87c5f-688e-591f-8a52-8150a12a9667" :answer/id #uuid "2dd87c5f-688e-591f-8a52-8150a12a9667" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-e9dab541-f6ea-5af9-a097-2799d5494452" :answer/id #uuid "e9dab541-f6ea-5af9-a097-2799d5494452" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "answer-61eff8b4-3b45-53c5-b90f-57c84a4ca251" :answer/id #uuid "61eff8b4-3b45-53c5-b90f-57c84a4ca251" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-680c6546-17a4-56c9-bab0-a73030879071" :answer/id #uuid "680c6546-17a4-56c9-bab0-a73030879071" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-b2363633-4b4a-52b6-a1e8-74d6417cb54d" :answer/id #uuid "b2363633-4b4a-52b6-a1e8-74d6417cb54d" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "question-3968dfc0-a6cb-5c0d-a0d8-393a6ade59fc" :question/id #uuid "3968dfc0-a6cb-5c0d-a0d8-393a6ade59fc" :question/math-academy-id "q-46111" :question/problem "![](images/f6/f68edc3f727f56d9cb88b2812600e89d985a494b736e75b9ecc86ee7a9e9a278.png)\n\nFind the maximum value of the parabola $y=-(x-2)^{2}+5$, sketched above." :question/worked-solution "The maximum value of the parabola is the $y$-coordinate of the vertex of the parabola. \n\nRemember that the vertex form of a parabola is\n\n$$\ny=a(x-h)^{2}+k\n$$\n\nwhere $(h,k)$ are the coordinates of the vertex of the parabola.\n\nThe given parabola\n\n$$\ny=-(x-2)^{2}+5\n$$\n\nis written in vertex form with $h=2$ and $k=5.$ Therefore, the vertex of the parabola is at $(2,5),$ and its maximum value is $5.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-82ef5680-ece9-5685-94ac-2157be8d10db"] :db/ensure [:question/validate]} {:db/id "answer-field-82ef5680-ece9-5685-94ac-2157be8d10db" :answer-field/id #uuid "82ef5680-ece9-5685-94ac-2157be8d10db" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0d4152be-7b9d-5747-b16b-5954539d8872" :answer-field/choices ["answer-e4fcbbcd-789c-5058-9a7d-5def3b745cfe" "answer-954aa467-9af7-5120-bc56-8b6c2fb39aa3" "answer-91e40f28-0701-51f6-bc0e-55efb0a1c4fa" "answer-b872f23c-eb67-568f-9ee1-244b8203c4fc" "answer-0d4152be-7b9d-5747-b16b-5954539d8872"] :db/ensure [:answer-field/validate]} {:db/id "answer-e4fcbbcd-789c-5058-9a7d-5def3b745cfe" :answer/id #uuid "e4fcbbcd-789c-5058-9a7d-5def3b745cfe" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-954aa467-9af7-5120-bc56-8b6c2fb39aa3" :answer/id #uuid "954aa467-9af7-5120-bc56-8b6c2fb39aa3" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "answer-91e40f28-0701-51f6-bc0e-55efb0a1c4fa" :answer/id #uuid "91e40f28-0701-51f6-bc0e-55efb0a1c4fa" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-b872f23c-eb67-568f-9ee1-244b8203c4fc" :answer/id #uuid "b872f23c-eb67-568f-9ee1-244b8203c4fc" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-0d4152be-7b9d-5747-b16b-5954539d8872" :answer/id #uuid "0d4152be-7b9d-5747-b16b-5954539d8872" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id 17592186088870 :tutorial/content "Up to now, all the parabolas we've seen have been written in **standard form**.\n\n![](images/e3/e3fb2f9598362bc373e475faf19bb84623a73281da549bf85018f22b7f8a095d.svg)\n\nWe can also write the equation of a parabola in the so-called **vertex form,** given by\n\n![](images/4d/4dc70525f24857744b03c32f2f558b27691c823f17bab16a569d3bbdadab732b.svg)\n\nWhen a parabola is written in vertex form, the pair ![](images/3a/3a6333dccc007be0992f95974a58ce3d652e5ecafcaaa865a24ff8b42bcfc37a.svg) gives the coordinates of its vertex.\n\nFor example, consider the following parabola: \n\n![](images/23/2366bd4f3ea2bcb500a85b13c29a3b512d0529ffc82e507c81dae3df96176981.svg)\n\nThis parabola is written in vertex form with ![](images/b4/b4edfee225234d67bf8c5a1f8283fe3eb5edba258f6268e9ffe7e604def55858.svg) and ![](images/6f/6fa7648f1eeb4effdf9b60cf5199b0ac26e1c1d57c0f05d9e9bd895e5c277c21.svg) Therefore, the vertex of the parabola is at ![](images/2b/2bea2c53403b70e552b749cbbf6a3eba65ebdf56f2028ee7907a6700bbedafc4.svg)\n\n![](images/4e/4e050c9f52965d9682cae055c1264ac2db9a58b09557f6e15f0178e9375b3872.png)\n\nIn future lessons, we'll learn how to express any parabola in vertex form. For now, let's get some practice working with this form." :db/ensure [:tutorial/validate]} {:db/id 17592186088990 :tutorial/content "Let's consider our first example once more.\n\n![](images/bc/bc15538fc507a42e4ef0cde0798d90cafca6d3d02e5e7c1630c6fc3e4a1e306b.png)\n\nYou might be wondering how we can tell that the vertex coordinates are ![](images/e2/e2002597cf3d8b01e24e7b4d2c6daf6fc9afb0afb3c6140877abfc3bf1be02c4.svg) just from looking at the equation. \n\nTo see this, let's label the two terms in our parabola formula:\n\n![](images/03/03e67590d6a4c3f9257b2330fcce119e3710397453b36fb0f9486964259ba40b.svg)\n\nNow, note the following:\n\n- The quadratic part ![](images/36/3658549ec19c3c38654ef48e3982b82008b2630ebd0de7f5fe04bd7d4d7073ef.svg) is a *squared* quantity. Therefore, it can only be *positive* or *zero*.\n\n- Moreover, the quadratic part *equals* zero when ![](images/d3/d3f2aa545ab3eb25dc10571bd58aefec57b90fbf67e3281039c937b753b48a6a.svg)\n\n- Since the constant part ![](images/07/07e82ee914d3f32c77556663cbc38417dc5f057c180e58a1fb4230bb364f5c25.svg) does not vary with ![](images/5a/5aac2c81021f3f9e468e7840c5f95ece35c10b894bdae19ec1d247bdeb47ac6f.svg) the entire expression is *minimized* when ![](images/d3/d3f2aa545ab3eb25dc10571bd58aefec57b90fbf67e3281039c937b753b48a6a.svg) Therefore, the ![](images/fc/fcc5df999e3b49fae1685ee0ab5bd03709804e1dd49f2ee722c4269eb0f5506d.svg)-coordinate of the minimum point (i.e., the vertex) is ![](images/27/270d33581e0657a10d567c6cfaa529521b34e20a39c9a29550698cbf252fabfa.svg)\n\n- When ![](images/48/480183a1321e5b4fdff9500a551818f6fb0ab2713c0fdd8fa9df88a640394af9.svg) the quadratic part is zero, giving ![](images/21/2182a4d19eb1c758d967edc4951247e3d512519ac6d8b95676bc51eb2fe57d1c.svg) Therefore, the ![](images/1d/1d9b846cface9f9348e4081a0dd87dd254bf26663c12aa0d1a15aa24d2393261.svg)-coordinate of the vertex is ![](images/da/daae2fd3251c4ba175906af980d1c33d4db057c616509ec6a146307d64417228.svg)\n\nFollowing this logic, we conclude that the coordinates of the vertex are ![](images/2b/2bea2c53403b70e552b749cbbf6a3eba65ebdf56f2028ee7907a6700bbedafc4.svg)\n\nFinally, it's possible to generalize this argument to any parabola. For ![](images/28/28e6012b2b10c0a7f40681ab8a73666a12afd6e976c59f536ed30d1defca5f64.svg) the coordinates ![](images/3a/3a6333dccc007be0992f95974a58ce3d652e5ecafcaaa865a24ff8b42bcfc37a.svg) give the maximum of the parabola." :db/ensure [:tutorial/validate]} {:db/id 17592186087900 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]}] "assertions" [[17592186087436 :question/problem "What are the coordinates of the vertex of the parabola $y=-3(x+5)^2-4?$"] [17592186087436 :question/worked-solution "Remember that the vertex form of a parabola is \n\n$$\ny=a(x-h)^2 + k,\n$$\n\nwhere $(h,k)$ are the coordinates of the vertex of the parabola.\n\nThe given parabola\n\n$$\ny=-3(x+5)^2-4\n$$\n\nis written in vertex form with $h=-5$ and $k=-4.$ To see this clearly, note that we can write the parabola as follows:\n\n$$\ny=-3(x-(-5))^2-4\n$$\n\nTherefore, the vertex of the parabola is at $(-5,-4).$"] [17592186087445 :question/problem "What is the axis of symmetry of the parabola $y=4(x-3)^2+2?$"] [17592186087445 :question/worked-solution "The axis of symmetry of the parabola is the vertical line that passes through the vertex of the parabola. To find the axis of symmetry, we need to compute the $x$-coordinate of the vertex of the parabola.\n\nRemember that the vertex form of a parabola is \n\n$$\ny=a(x-h)^2 + k,\n$$\n\nwhere $(h,k)$ are the coordinates of the vertex of the parabola.\n\nThe given parabola\n\n$$\ny=4(x-3)^2+2\n$$\n\nis written in vertex form with $h=3$ and $k=2.$ Therefore, the vertex of the parabola is at $(3,2),$ and the axis of symmetry is $x=3.$"] [17592186087631 :question/problem "Find the minimum value of the parabola ![](images/d3/d30006cd23eb5bc4fab41b442fa7559a396842e82c35c3a481533208827abe28.svg) sketched below.\n\n![](images/1a/1af23738cbe57195d1bf4dc223c37fab61cb89058388445a67eadeaab88a14bd.png)"] [17592186087631 :question/worked-solution "The minimum value of the parabola is the ![](images/1d/1d9b846cface9f9348e4081a0dd87dd254bf26663c12aa0d1a15aa24d2393261.svg)-coordinate of the vertex of the parabola. \n\nRemember that the vertex form of a parabola is\n\n![](images/c5/c53ff35f8ae40bcb44f4cf26ad7f0d1bed0dabc73298562d7041cc90a0b1de3c.svg)\n\nwhere ![](images/3a/3a6333dccc007be0992f95974a58ce3d652e5ecafcaaa865a24ff8b42bcfc37a.svg) are the coordinates of the vertex of the parabola.\n\nThe given parabola\n\n![](images/21/211afc137cc4072f18eb008836b3f2d8c231aa5ae017476147b0b50014525f39.svg)\n\nis written in vertex form with ![](images/03/033a93fcdc4a0358a5de03cbdda9860a8ac6aa6a735f3681a6477c3a3e52ea55.svg) and ![](images/10/1027d08706beef7b1afa836932edaac3ebad0885bb8a2be54860dc768d431ff9.svg) Therefore, the vertex of the parabola is at ![](images/79/795920c332cb28b6b824a8b84b1226b6d1e5b5f890e16ecd6752ce6fd619e37e.svg) and its minimum value is ![](images/d4/d44d7e189fa83441142c19838f09553ff4b73fba09689c5a04d1a6eaf5fef088.svg)"] ["question-c582f0f1-f871-50b8-b88f-03165acfd197" :question/id #uuid "c582f0f1-f871-50b8-b88f-03165acfd197"] ["question-c582f0f1-f871-50b8-b88f-03165acfd197" :question/math-academy-id "q-46174"] ["question-c582f0f1-f871-50b8-b88f-03165acfd197" :question/problem "What are the coordinates of the vertex of the parabola $y=-(x+2)^{2}+3?$"] ["question-c582f0f1-f871-50b8-b88f-03165acfd197" :question/worked-solution "Remember that the vertex form of a parabola is \n\n$$\ny=a(x-h)^{2}+k,\n$$\n\nwhere $(h,k)$ are the coordinates of the vertex of the parabola.\n\nThe given parabola\n\n$$\ny=-(x+2)^{2}+3\n$$\n\nis written in vertex form with $h=-2$ and $k=3.$ To see this clearly, note that we can write the parabola as follows:\n\n$$\ny=-(x-(-2))^{2}+3\n$$\n\nTherefore, the vertex of the parabola is at $(-2,3).$"] ["question-c582f0f1-f871-50b8-b88f-03165acfd197" :question/difficulty :question.difficulty/moderate] ["answer-field-4c32a66a-9074-5966-b6db-d71011681b35" :answer-field/id #uuid "4c32a66a-9074-5966-b6db-d71011681b35"] ["answer-1eff41e0-f9b3-51c5-a29a-c4ce22da8c59" :answer/id #uuid "1eff41e0-f9b3-51c5-a29a-c4ce22da8c59"] ["answer-1eff41e0-f9b3-51c5-a29a-c4ce22da8c59" :answer/type :answer.type/math] ["answer-1eff41e0-f9b3-51c5-a29a-c4ce22da8c59" :answer/value "(-2,-3)"] ["answer-04e8a8a8-3706-59fe-a287-2a770b8419fa" :answer/id #uuid "04e8a8a8-3706-59fe-a287-2a770b8419fa"] ["answer-04e8a8a8-3706-59fe-a287-2a770b8419fa" :answer/type :answer.type/math] ["answer-04e8a8a8-3706-59fe-a287-2a770b8419fa" :answer/value "(-2,3)"] ["answer-002bd208-8560-5adc-9a07-c761d0d84b1e" :answer/id #uuid "002bd208-8560-5adc-9a07-c761d0d84b1e"] ["answer-002bd208-8560-5adc-9a07-c761d0d84b1e" :answer/type :answer.type/math] ["answer-002bd208-8560-5adc-9a07-c761d0d84b1e" :answer/value "(2,3)"] ["answer-10cee7e7-895a-5600-9a5e-f6a9b7a42e32" :answer/id #uuid "10cee7e7-895a-5600-9a5e-f6a9b7a42e32"] ["answer-10cee7e7-895a-5600-9a5e-f6a9b7a42e32" :answer/type :answer.type/math] ["answer-10cee7e7-895a-5600-9a5e-f6a9b7a42e32" :answer/value "(3,-2)"] ["answer-4499f164-f227-50e5-9214-5ca31d20414f" :answer/id #uuid "4499f164-f227-50e5-9214-5ca31d20414f"] ["answer-4499f164-f227-50e5-9214-5ca31d20414f" :answer/type :answer.type/math] ["answer-4499f164-f227-50e5-9214-5ca31d20414f" :answer/value "(3,2)"] ["answer-field-4c32a66a-9074-5966-b6db-d71011681b35" :answer-field/key "selection"] ["answer-field-4c32a66a-9074-5966-b6db-d71011681b35" :answer-field/type :answer-field.type/radio] ["answer-field-4c32a66a-9074-5966-b6db-d71011681b35" :answer-field/correct "answer-04e8a8a8-3706-59fe-a287-2a770b8419fa"] ["answer-field-4c32a66a-9074-5966-b6db-d71011681b35" :answer-field/choices "answer-1eff41e0-f9b3-51c5-a29a-c4ce22da8c59"] ["answer-field-4c32a66a-9074-5966-b6db-d71011681b35" :answer-field/choices "answer-04e8a8a8-3706-59fe-a287-2a770b8419fa"] ["answer-field-4c32a66a-9074-5966-b6db-d71011681b35" :answer-field/choices "answer-002bd208-8560-5adc-9a07-c761d0d84b1e"] ["answer-field-4c32a66a-9074-5966-b6db-d71011681b35" :answer-field/choices "answer-10cee7e7-895a-5600-9a5e-f6a9b7a42e32"] ["answer-field-4c32a66a-9074-5966-b6db-d71011681b35" :answer-field/choices "answer-4499f164-f227-50e5-9214-5ca31d20414f"] ["question-c582f0f1-f871-50b8-b88f-03165acfd197" :question/answer-fields "answer-field-4c32a66a-9074-5966-b6db-d71011681b35"] [17592186087831 :knowledge-point/questions "question-c582f0f1-f871-50b8-b88f-03165acfd197"] ["question-00a59ef1-c144-5d9f-b94c-7d377a8424ae" :question/id #uuid "00a59ef1-c144-5d9f-b94c-7d377a8424ae"] ["question-00a59ef1-c144-5d9f-b94c-7d377a8424ae" :question/math-academy-id "q-46168"] ["question-00a59ef1-c144-5d9f-b94c-7d377a8424ae" :question/problem "What are the coordinates of the vertex of the parabola $y=(x-3)^{2}-7?$"] ["question-00a59ef1-c144-5d9f-b94c-7d377a8424ae" :question/worked-solution "Remember that the vertex form of a parabola is \n\n$$\ny=a(x-h)^{2}+k,\n$$\n\nwhere $(h,k)$ are the coordinates of the vertex of the parabola.\n\nThe given parabola\n\n$$\ny=(x-3)^{2}-7\n$$\n\nis written in vertex form with $h=3$ and $k=-7.$ \n\nTherefore, the vertex of the parabola is at $(3,-7).$"] ["question-00a59ef1-c144-5d9f-b94c-7d377a8424ae" :question/difficulty :question.difficulty/easy] ["answer-field-e4a61f4a-cdf5-5b1e-a913-da940deffdac" :answer-field/id #uuid "e4a61f4a-cdf5-5b1e-a913-da940deffdac"] ["answer-dbcb5b73-ccdf-50e6-a5d9-9be753c71500" :answer/id #uuid "dbcb5b73-ccdf-50e6-a5d9-9be753c71500"] ["answer-dbcb5b73-ccdf-50e6-a5d9-9be753c71500" :answer/type :answer.type/math] ["answer-dbcb5b73-ccdf-50e6-a5d9-9be753c71500" :answer/value "(-3,-7)"] ["answer-fd670847-6f26-5713-a3a4-14b58688883d" :answer/id #uuid "fd670847-6f26-5713-a3a4-14b58688883d"] ["answer-fd670847-6f26-5713-a3a4-14b58688883d" :answer/type :answer.type/math] ["answer-fd670847-6f26-5713-a3a4-14b58688883d" :answer/value "(-3,7)"] ["answer-0603c23e-6365-5923-80df-9a710170b017" :answer/id #uuid "0603c23e-6365-5923-80df-9a710170b017"] ["answer-0603c23e-6365-5923-80df-9a710170b017" :answer/type :answer.type/math] ["answer-0603c23e-6365-5923-80df-9a710170b017" :answer/value "(2,-1)"] ["answer-0a27d457-a824-5a0e-90fb-49c3f33cad64" :answer/id #uuid "0a27d457-a824-5a0e-90fb-49c3f33cad64"] ["answer-0a27d457-a824-5a0e-90fb-49c3f33cad64" :answer/type :answer.type/math] ["answer-0a27d457-a824-5a0e-90fb-49c3f33cad64" :answer/value "(3,-7)"] ["answer-ff52ffb3-b85f-5f8f-bc98-5efb01834e07" :answer/id #uuid "ff52ffb3-b85f-5f8f-bc98-5efb01834e07"] ["answer-ff52ffb3-b85f-5f8f-bc98-5efb01834e07" :answer/type :answer.type/math] ["answer-ff52ffb3-b85f-5f8f-bc98-5efb01834e07" :answer/value "(3,7)"] ["answer-field-e4a61f4a-cdf5-5b1e-a913-da940deffdac" :answer-field/key "selection"] ["answer-field-e4a61f4a-cdf5-5b1e-a913-da940deffdac" :answer-field/type :answer-field.type/radio] ["answer-field-e4a61f4a-cdf5-5b1e-a913-da940deffdac" :answer-field/correct "answer-0a27d457-a824-5a0e-90fb-49c3f33cad64"] ["answer