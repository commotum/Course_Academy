db/ref 17592186350277 #edb/ref 17592186045417] [17592186350929 #edb/ref 1075 #edb/ref 17592186350496 #edb/ref 17592186045417] [17592186350929 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186350929 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186350929 #edb/ref 1078 #edb/ref 17592186349245 #edb/ref 17592186045417] [17592186350929 #edb/ref 1079 #uuid "80b343ea-0943-5bf0-b6d2-b14961b4e1a4" #edb/ref 17592186045417] [17592186350997 #edb/ref 1075 #edb/ref 17592186348779 #edb/ref 17592186045417] [17592186350997 #edb/ref 1075 #edb/ref 17592186348780 #edb/ref 17592186045417] [17592186350997 #edb/ref 1075 #edb/ref 17592186348805 #edb/ref 17592186045417] [17592186350997 #edb/ref 1075 #edb/ref 17592186348807 #edb/ref 17592186045417] [17592186350997 #edb/ref 1075 #edb/ref 17592186349130 #edb/ref 17592186045417] [17592186350997 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186350997 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186350997 #edb/ref 1078 #edb/ref 17592186348807 #edb/ref 17592186045417] [17592186350997 #edb/ref 1079 #uuid "a9bcc58f-cf39-5a29-98cc-d059c827153d" #edb/ref 17592186045417] [17592186351108 #edb/ref 1075 #edb/ref 17592186348945 #edb/ref 17592186045417] [17592186351108 #edb/ref 1075 #edb/ref 17592186349859 #edb/ref 17592186045417] [17592186351108 #edb/ref 1075 #edb/ref 17592186350212 #edb/ref 17592186045417] [17592186351108 #edb/ref 1075 #edb/ref 17592186350312 #edb/ref 17592186045417] [17592186351108 #edb/ref 1075 #edb/ref 17592186350610 #edb/ref 17592186045417] [17592186351108 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186351108 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186351108 #edb/ref 1078 #edb/ref 17592186348945 #edb/ref 17592186045417] [17592186351108 #edb/ref 1079 #uuid "e498f2cb-485a-533b-8cc9-3a693e233bae" #edb/ref 17592186045417] [17592186351280 #edb/ref 1068 #edb/ref 17592186351108 #edb/ref 17592186045417] [17592186351280 #edb/ref 1069 "q-81260" #edb/ref 17592186045417] [17592186351280 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186351280 #edb/ref 1071 "Consider the finite region $D$ in the $xy$-plane enclosed between the curves $y={x}^{2}$ and $y=\\sqrt{x-2}$ from $y=0$ to $y=1.$ What is ${∬}_{D}\\frac{xy}{1+{y}^{2}}\\,dA$ expressed as a repeated integral?" #edb/ref 17592186045417] [17592186351280 #edb/ref 1072 #uuid "be18145a-4015-5280-9fff-16f18aff3c3d" #edb/ref 17592186045417] [17592186351280 #edb/ref 1074 "First, let's represent $D$ as a type II region. Writing $y={x}^{2}$ and $y=\\sqrt{x-2}$ in terms of $y,$ we obtain\n\n$$\n\\begin{aligned}y={x}^{2} & \\,⟹\\,x=\\sqrt{y} \\\\ y=\\sqrt{x-2} & \\,⟹\\,x={y}^{2}+2\\end{aligned}\n$$\n\nTo determine the left and right functions, we draw a horizontal arrow from left to right through the region, as usual.\n\n![](images/bb/bb3249a9580e754c4ef9c33239c2a51a9b57ca9032a6acbeef7bbc532b2d4345.png)\n\nAs a result, we get\n\n$$\nD=\\{(x,y)\\,:\\,0\\le y\\le 1,\\,\\sqrt{y}\\le x\\le {y}^{2}+2\\}.\n$$\n\nTherefore, we can express the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}\\frac{xy}{1+{y}^{2}}\\,dA & ={\\int }_{0}^{1}{\\int }_{\\sqrt{y}}^{{y}^{2}+2}\\frac{xy}{1+{y}^{2}}\\,dx\\,dy\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186351283 #edb/ref 1068 #edb/ref 17592186350904 #edb/ref 17592186045417] [17592186351283 #edb/ref 1069 "q-81291" #edb/ref 17592186045417] [17592186351283 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186351283 #edb/ref 1071 "Consider the finite region $D$ in the $xy$-plane enclosed between the curves $y=\\frac{1}{x}$ where $x>0,$ and $y=\\frac{x}{2},$ below the line $y=2.$ What is ${∬}_{D}f(x,y)\\,dA\\,$ expressed as a repeated integral?" #edb/ref 17592186045417] [17592186351283 #edb/ref 1072 #uuid "acecd55c-92a5-5c62-a1ac-e63916806f3d" #edb/ref 17592186045417] [17592186351283 #edb/ref 1074 "First, let's make a sketch of our region.\n\n![](images/22/2209e57f8cbe84ccf2f930c5cd3004ff5009dfb72f3e4b3262517cf9b8f2b119.png)\n\nWe need to represent $D$ as a type II region. Writing $y=\\frac{1}{x}$ and $y=\\frac{x}{2}$ in terms of $y,$ we obtain\n\n$$\n\\begin{aligned}y=\\frac{1}{x} & \\,⟹\\,x=\\frac{1}{y} \\\\ y=\\frac{x}{2} & \\,⟹\\,x=2y\\end{aligned}\n$$\n\nNow, let's determine the limits of integration.\n\n- To determine the $y$-limits, we need to find the $y$-coordinates of the points at which the curves intersect. So, we set the following equation and solve it for $y:$\n\n$$\n\\begin{aligned}\\frac{1}{y} & =2y \\\\ 2y-\\frac{1}{y} & =0 \\\\ \\frac{2{y}^{2}-1}{y} & =0 \\\\ 2{y}^{2}-1 & =0 \\\\ {y}^{2} & =\\frac{1}{2} \\\\ y & =\\pm \\frac{\\sqrt{2}}{2}\\end{aligned}\n$$\n\nSo, since our region lies in the first quadrant below the line $y=2$ the $y$-limits are \n$\\frac{\\sqrt{2}}{2}\\le y\\le 2.$\n\n- To determine the left and right functions, we draw a horizontal arrow from left to right through the region, as usual.\n\n![](images/1b/1b03741537734087836c22dbb40e2e188825bade657cff129374efe1596bcb3c.png)\n\nAs a result, we get\n\n$$\nD=\\{(x,y)\\,:\\,\\frac{\\sqrt{2}}{2}\\le y\\le 2,\\,\\frac{1}{y}\\le x\\le 2y\\}.\n$$\n\nTherefore, we can express the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}f(x,y)\\,dA & ={\\int }_{\\sqrt{2}/2}^{2}{\\int }_{1/y}^{2y}f(x,y)\\,dx\\,dy\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186351287 #edb/ref 1068 #edb/ref 17592186350929 #edb/ref 17592186045417] [17592186351287 #edb/ref 1069 "q-81309" #edb/ref 17592186045417] [17592186351287 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186351287 #edb/ref 1071 "${\\int }_{0}^{1}{\\int }_{y-1}^{0}\\operatorname{sin}⁡x\\,dx\\,dy=$" #edb/ref 17592186045417] [17592186351287 #edb/ref 1072 #uuid "c88bbbaa-afbc-50f2-9c9a-541dff759c54" #edb/ref 17592186045417] [17592186351287 #edb/ref 1074 "The integral is defined over a type II region.\n\nFirst, we evaluate the inner integral by integrating with respect to $x$, treating $y$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{y-1}^{0}\\operatorname{sin}⁡x\\,dx\\,dy & ={\\int }_{0}^{1}[{\\int }_{y-1}^{0}\\operatorname{sin}⁡x\\,dx]\\,dy \\\\  & ={\\int }_{0}^{1}[-\\operatorname{cos}⁡x]_{y-1}^{0}\\,dy \\\\  & =-{\\int }_{0}^{1}(\\operatorname{cos}⁡0-\\operatorname{cos}⁡(y-1))\\,dy \\\\  & ={\\int }_{0}^{1}(\\operatorname{cos}⁡(y-1)-1)\\,dy\\end{aligned}\n$$\n\nThen, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}(\\operatorname{cos}⁡(y-1)-1)\\,dy & =[\\operatorname{sin}⁡(y-1)-y]_{0}^{1} \\\\  & =(\\operatorname{sin}⁡(0)-1)-(\\operatorname{sin}⁡(-1)-0) \\\\  & =\\operatorname{sin}⁡(1)-1\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186351289 #edb/ref 1068 #edb/ref 17592186350997 #edb/ref 17592186045417] [17592186351289 #edb/ref 1069 "q-81320" #edb/ref 17592186045417] [17592186351289 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186351289 #edb/ref 1071 "Calculate ${\\int }_{1}^{4}{\\int }_{1}^{{y}^{3}}\\frac{1}{{y}^{2}}\\,dx\\,dy.$" #edb/ref 17592186045417] [17592186351289 #edb/ref 1072 #uuid "80f565d3-72fd-5b66-9620-41422767e4db" #edb/ref 17592186045417] [17592186351289 #edb/ref 1074 "The integral is defined over a type II region.\n\nFirst, we evaluate the inner integral by integrating with respect to $x$, treating $y$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{1}^{4}{\\int }_{1}^{{y}^{3}}\\frac{1}{{y}^{2}}\\,dx\\,dy & ={\\int }_{1}^{4}\\frac{1}{{y}^{2}}[{\\int }_{1}^{{y}^{3}}dx]\\,dy \\\\  & ={\\int }_{1}^{4}\\frac{1}{{y}^{2}}[x]_{1}^{{y}^{3}}\\,dy \\\\  & ={\\int }_{1}^{4}\\frac{1}{{y}^{2}}({y}^{3}-1)\\,dy \\\\  & ={\\int }_{1}^{4}(y-\\frac{1}{{y}^{2}})\\,dy\\end{aligned}\n$$\n\nThen, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}{\\int }_{1}^{4}(y-\\frac{1}{{y}^{2}})\\,dy & ={[\\frac{{y}^{2}}{2}+\\frac{1}{y}]}_{1}^{4} \\\\  & =(8+\\frac{1}{4})-(\\frac{1}{2}+1) \\\\  & =\\frac{27}{4}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186380985 #edb/ref 1068 #edb/ref 17592186380986 #edb/ref 17592186045417] [17592186380985 #edb/ref 1069 "q-132384" #edb/ref 17592186045417] [17592186380985 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186380985 #edb/ref 1071 "![](images/2a/2aaf1935bfd8e079782249df3e230ceb40719ac48d0f5d36dd5e1419499771a7.png)\n\nIf $D$ is the finite region enclosed by the lines $x=1,$ $y=0$ and $y=2,$ and the curve $x=(y-1)^{2}+2,$ as shown above, then ${∬}_{D}xy\\,dA=$" #edb/ref 17592186045417] [17592186380985 #edb/ref 1072 #uuid "5c9859c1-e939-5417-af18-fab39253454a" #edb/ref 17592186045417] [17592186380985 #edb/ref 1074 "First, let's represent $D$ as a type II region. To determine the left and right functions, we draw a horizontal arrow from left to right through the region, as usual.\n\n![](images/72/72cf3a4044e83e63e579b00d3ca246071787ed4d6b44e4e22fcf963dc10917b4.png)\n\nAs a result, we get\n\n$$\nD=\\{(x,y)\\,:\\,0\\le y\\le 2,\\,1\\le x\\le (y-1)^{2}+2\\}.\n$$\n\nTherefore, we can express the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}f(x,y)\\,dA & ={\\int }_{0}^{2}{\\int }_{1}^{(y-1)^{2}+2}xy\\,dx\\,dy \\\\  & ={\\int }_{0}^{2}[{\\int }_{1}^{(y-1)^{2}+2}xy\\,dx]dy\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186380986 #edb/ref 1075 #edb/ref 17592186380987 #edb/ref 17592186045417] [17592186380986 #edb/ref 1075 #edb/ref 17592186380988 #edb/ref 17592186045417] [17592186380986 #edb/ref 1075 #edb/ref 17592186380989 #edb/ref 17592186045417] [17592186380986 #edb/ref 1075 #edb/ref 17592186380990 #edb/ref 17592186045417] [17592186380986 #edb/ref 1075 #edb/ref 17592186380991 #edb/ref 17592186045417] [17592186380986 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186380986 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186380986 #edb/ref 1078 #edb/ref 17592186380988 #edb/ref 17592186045417] [17592186380986 #edb/ref 1079 #uuid "fd9ae505-6caf-5d53-988d-3ff8f5ae28d3" #edb/ref 17592186045417] [17592186380987 #edb/ref 1080 "{\\int }_{0}^{(y-1)^{2}+2}[{\\int }_{1}^{2}xy\\,dx]dy" #edb/ref 17592186045417] [17592186380987 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186380987 #edb/ref 1083 #uuid "389c89b0-6f78-515d-b02c-c50614aa0a47" #edb/ref 17592186045417] [17592186380988 #edb/ref 1080 "{\\int }_{0}^{2}[{\\int }_{1}^{(y-1)^{2}+2}xy\\,dx]dy" #edb/ref 17592186045417] [17592186380988 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186380988 #edb/ref 1083 #uuid "26a55a09-a269-513d-9fef-14a7053e3105" #edb/ref 17592186045417] [17592186380989 #edb/ref 1080 "{\\int }_{0}^{2}[{\\int }_{(y-1)^{2}+2}^{1}xy\\,dx]dy" #edb/ref 17592186045417] [17592186380989 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186380989 #edb/ref 1083 #uuid "3e5b81eb-e01f-5254-a2ec-460fb6a2508a" #edb/ref 17592186045417] [17592186380990 #edb/ref 1080 "{\\int }_{1}^{2}[{\\int }_{0}^{(y-1)^{2}+2}xy\\,dx]dy" #edb/ref 17592186045417] [17592186380990 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186380990 #edb/ref 1083 #uuid "c4a9a48e-3d2f-5df9-87f7-3d40b452ff4a" #edb/ref 17592186045417] [17592186380991 #edb/ref 1080 "{\\int }_{1}^{(y-1)^{2}+2}[{\\int }_{0}^{2}xy\\,dx]dy" #edb/ref 17592186045417] [17592186380991 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186380991 #edb/ref 1083 #uuid "ee636de4-c87d-5565-b132-6c0707e44a4e" #edb/ref 17592186045417] [17592186380999 #edb/ref 1068 #edb/ref 17592186381000 #edb/ref 17592186045417] [17592186380999 #edb/ref 1069 "q-132414" #edb/ref 17592186045417] [17592186380999 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186380999 #edb/ref 1071 "${\\int }_{0}^{3}{\\int }_{0}^{3y}({x}^{2}+{y}^{2})\\,dx\\,dy=$" #edb/ref 17592186045417] [17592186380999 #edb/ref 1072 #uuid "7f81302b-c373-529b-a5a0-1251b4805ba1" #edb/ref 17592186045417] [17592186380999 #edb/ref 1074 "The integral is defined over a type II region.\n\nFirst, we evaluate the inner integral by integrating with respect to $x$, treating $y$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{0}^{3}{\\int }_{0}^{3y}({x}^{2}+{y}^{2})\\,dx\\,dy & ={\\int }_{0}^{3}[{\\int }_{0}^{3y}({x}^{2}+{y}^{2})\\,dx]dy \\\\  & ={\\int }_{0}^{3}{[\\frac{1}{3}{x}^{3}+x{y}^{2}]}_{0}^{3y}\\,dy \\\\  & ={\\int }_{0}^{3}(\\frac{1}{3}(3y)^{3}+(3y){y}^{2})dy \\\\  & ={\\int }_{0}^{3}(9{y}^{3}+3{y}^{3})\\,dy \\\\  & ={\\int }_{0}^{3}12{y}^{3}\\,dy\\end{aligned}\n$$\n\nThen, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{3}12{y}^{3}\\,dy & ={[3{y}^{4}]}_{0}^{3} \\\\  & =3(3)^{4} \\\\  & =3(81) \\\\  & =243\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186381000 #edb/ref 1075 #edb/ref 17592186381001 #edb/ref 17592186045417] [17592186381000 #edb/ref 1075 #edb/ref 17592186381002 #edb/ref 17592186045417] [17592186381000 #edb/ref 1075 #edb/ref 17592186381003 #edb/ref 17592186045417] [17592186381000 #edb/ref 1075 #edb/ref 17592186381004 #edb/ref 17592186045417] [17592186381000 #edb/ref 1075 #edb/ref 17592186381005 #edb/ref 17592186045417] [17592186381000 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186381000 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186381000 #edb/ref 1078 #edb/ref 17592186381005 #edb/ref 17592186045417] [17592186381000 #edb/ref 1079 #uuid "59883c48-3e71-5cdb-8cbd-e6b235b24ad4" #edb/ref 17592186045417] [17592186381001 #edb/ref 1080 "343" #edb/ref 17592186045417] [17592186381001 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186381001 #edb/ref 1083 #uuid "26a7dd9b-e017-5f3a-8ac2-116d68520887" #edb/ref 17592186045417] [17592186381002 #edb/ref 1080 "207" #edb/ref 17592186045417] [17592186381002 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186381002 #edb/ref 1083 #uuid "6842fe58-1814-5da0-b2b5-e8aa3f1ea7d0" #edb/ref 17592186045417] [17592186381003 #edb/ref 1080 "125" #edb/ref 17592186045417] [17592186381003 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186381003 #edb/ref 1083 #uuid "357c1cd9-e42d-5c09-