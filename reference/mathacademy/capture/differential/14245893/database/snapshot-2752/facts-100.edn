86045417] [17592186341732 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186341732 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186341732 #edb/ref 1078 #edb/ref 17592186339367 #edb/ref 17592186045417] [17592186341732 #edb/ref 1079 #uuid "c8ed9efb-9d03-53c8-9fad-57fa155b57a6" #edb/ref 17592186045417] [17592186341751 #edb/ref 1075 #edb/ref 17592186339771 #edb/ref 17592186045417] [17592186341751 #edb/ref 1075 #edb/ref 17592186340284 #edb/ref 17592186045417] [17592186341751 #edb/ref 1075 #edb/ref 17592186340703 #edb/ref 17592186045417] [17592186341751 #edb/ref 1075 #edb/ref 17592186340987 #edb/ref 17592186045417] [17592186341751 #edb/ref 1075 #edb/ref 17592186341247 #edb/ref 17592186045417] [17592186341751 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186341751 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186341751 #edb/ref 1078 #edb/ref 17592186340987 #edb/ref 17592186045417] [17592186341751 #edb/ref 1079 #uuid "d24716d5-0fd3-56ef-817c-00602c395b53" #edb/ref 17592186045417] [17592186342230 #edb/ref 1068 #edb/ref 17592186341709 #edb/ref 17592186045417] [17592186342230 #edb/ref 1069 "q-74558" #edb/ref 17592186045417] [17592186342230 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186342230 #edb/ref 1071 "Find the values of $k$ such that the vector $b$ lies in $\\text{Span}\\{{a}_{1},{a}_{2}\\},$ where\n\n$$\n{a}_{1}=\\begin{bmatrix}2 \\\\ 3 \\\\ 2\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}-4 \\\\ -5 \\\\ -4\\end{bmatrix},\\,b=\\begin{bmatrix}0 \\\\ 1 \\\\ k\\end{bmatrix}.\n$$" #edb/ref 17592186045443] [17592186342230 #edb/ref 1072 #uuid "cef0a842-c20f-55db-9989-525f1aca72a5" #edb/ref 17592186045417] [17592186342230 #edb/ref 1074 "We know that $b\\in \\text{Span}\\{{a}_{1},{a}_{2}\\}$ if there exist ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2} & =b \\\\ {x}_{1}\\begin{bmatrix}2 \\\\ 3 \\\\ 2\\end{bmatrix}+{x}_{2}\\begin{bmatrix}-4 \\\\ -5 \\\\ -4\\end{bmatrix} & =\\begin{bmatrix}0 \\\\ 1 \\\\ k\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}2{x}_{1}-4{x}_{2} &=0 \\\\ 3{x}_{1}-5{x}_{2} &=1 \\\\ 2{x}_{1}-4{x}_{2} &=k\\end{aligned}\\right.\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}2 & -4 & 0 \\\\ 3 & -5 & 1 \\\\ 2 & -4 & k\\end{bmatrix} & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 & 0 \\\\ 3 & -5 & 1 \\\\ 2 & -4 & k\\end{bmatrix} & {R}_{2} & :={R}_{2}-3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 & 0 \\\\ 0 & 1 & 1 \\\\ 2 & -4 & k\\end{bmatrix} & {R}_{3} & :={R}_{3}-2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 & 0 \\\\ 0 & 1 & 1 \\\\ 0 & 0 & k\\end{bmatrix}\\end{aligned}\n$$\n\nThe third row of the augmented matrix now corresponds to the equation $0{x}_{1}+0{x}_{2}=k.$ Therefore, the system has a solution only if\n\n$$\nk=0.\n$$" #edb/ref 17592186045443] [17592186342238 #edb/ref 1068 #edb/ref 17592186341722 #edb/ref 17592186045417] [17592186342238 #edb/ref 1069 "q-74596" #edb/ref 17592186045417] [17592186342238 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186342238 #edb/ref 1071 "Find the values of $k$ such that the vector $b$ lies in $\\text{Span}{{a}_{1},{a}_{2}},$ where\n\n$$\n{a}_{1}=\\begin{bmatrix}6 \\\\ -2 \\\\ 10\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}-8 \\\\ 3 \\\\ -12\\end{bmatrix},\\,b=\\begin{bmatrix}-3 \\\\ -9 \\\\ k\\end{bmatrix}.\n$$" #edb/ref 17592186045443] [17592186342238 #edb/ref 1072 #uuid "329f79c0-9230-5c7a-8435-3cce24f63578" #edb/ref 17592186045417] [17592186342238 #edb/ref 1074 "We know that $b\\in \\text{Span}{{a}_{1},{a}_{2}}$ if there exist ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2} & =b \\\\ {x}_{1}\\begin{bmatrix}6 \\\\ -2 \\\\ 10\\end{bmatrix}+{x}_{2}\\begin{bmatrix}-8 \\\\ 3 \\\\ -12\\end{bmatrix} & =\\begin{bmatrix}-3 \\\\ -9 \\\\ k\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}6{x}_{1}-8{x}_{2} &=-3 \\\\ -2{x}_{1}+3{x}_{2} &=-9 \\\\ 10{x}_{1}-12{x}_{2} &=k\\end{aligned}\\right.\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}6 & -8 & -3 \\\\ -2 & 3 & -9 \\\\ 10 & -12 & k\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}-2 & 3 & -9 \\\\ 6 & -8 & -3 \\\\ 10 & -12 & k\\end{bmatrix} & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}-2 & 3 & -9 \\\\ 0 & 1 & -30 \\\\ 10 & -12 & k\\end{bmatrix} & {R}_{3} & :={R}_{3}+5{R}_{1} \\\\  & ∼\\begin{bmatrix}-2 & 3 & -9 \\\\ 0 & 1 & -30 \\\\ 0 & 3 & k-45\\end{bmatrix} & {R}_{3} & :={R}_{3}-3{R}_{2} \\\\  & ∼\\begin{bmatrix}-2 & 3 & -9 \\\\ 0 & 1 & -30 \\\\ 0 & 0 & k+45\\end{bmatrix}\\end{aligned}\n$$\n\nThe third row of the augmented matrix now corresponds to the equation $0{x}_{1}+0{x}_{2}=k+45.$ Therefore, the system has a solution only if\n\n$$\n0=k+45\\,⟹\\,k=-45.\n$$" #edb/ref 17592186045443] [17592186342241 #edb/ref 1068 #edb/ref 17592186341528 #edb/ref 17592186045417] [17592186342241 #edb/ref 1069 "q-74599" #edb/ref 17592186045417] [17592186342241 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186342241 #edb/ref 1071 "Determine if the vector $u$ lies on the plane $Π:r=sb+tc$, $t,s\\in R$, where  $b=⟨-1,4,3⟩$, $c=⟨1,-6,-7⟩$, and  $u=⟨1,-10,-15⟩.$ In the affirmative case, find the value of $s\\cdot t$ from the decomposition $u=sb+tc.$" #edb/ref 17592186045417] [17592186342241 #edb/ref 1072 #uuid "d6c3f74b-5a27-519e-8d22-1736702759dc" #edb/ref 17592186045417] [17592186342241 #edb/ref 1074 "By definition, $u\\in Π$ if there exist $t$ and $s$ such that\n\n$$\n\\begin{aligned}sb+tc & =u \\\\ s\\begin{bmatrix}-1 \\\\ 4 \\\\ 3\\end{bmatrix}+t\\begin{bmatrix}1 \\\\ -6 \\\\ -7\\end{bmatrix} & =\\begin{bmatrix}1 \\\\ -10 \\\\ -15\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}-s+t &=1 \\\\ 4s-6t &=-10 \\\\ 3s-7t &=-15\\end{aligned}\\right.\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}-1 & 1 & 1 \\\\ 4 & -6 & -10 \\\\ 3 & -7 & -15\\end{bmatrix} & {R}_{2} & :={R}_{2}+4{R}_{1} \\\\  & ∼\\begin{bmatrix}-1 & 1 & 1 \\\\ 0 & -2 & -6 \\\\ 3 & -7 & -15\\end{bmatrix} & {R}_{3} & :={R}_{3}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}-1 & 1 & 1 \\\\ 0 & -2 & -6 \\\\ 0 & -4 & -12\\end{bmatrix} & {R}_{3} & :={R}_{3}-2{R}_{2} \\\\  & ∼\\begin{bmatrix}-1 & 1 & 1 \\\\ 0 & -2 & -6 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n\\left\\{\\begin{aligned}-s+t &=1 \\\\ -2t &=-6 \\\\ 0 &=0.\\end{aligned}\\right.\n$$\n\nFrom the second equation, we get\n\n$$\n-2t=-6\\,⟹\\,t=3.\n$$\n\nSubstituting into the first equation, we get\n\n$$\n\\begin{aligned}-s+t & =1 \\\\ -s+3 & =1 \\\\ -s & =-2 \\\\ s & =2.\\end{aligned}\n$$\n\nSince we found a solution $s=2,\\,t=3,$ we conclude that $u$ does indeed lie on the plane $Π.$ In fact, we have\n\n$$\nu=2b+3c.\n$$\n\nFinally, $s\\cdot t=2\\cdot 3=6.$" #edb/ref 17592186045443] [17592186343109 #edb/ref 1080 "-4" #edb/ref 17592186045417] [17592186343109 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186343109 #edb/ref 1083 #uuid "66b81663-6e80-51d7-a913-48b15173205e" #edb/ref 17592186045417] [17592186343405 #edb/ref 1080 "2" #edb/ref 17592186045417] [17592186343405 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186343405 #edb/ref 1083 #uuid "8714c620-1893-528d-8182-61236ee13206" #edb/ref 17592186045417] [17592186343824 #edb/ref 1080 "-6" #edb/ref 17592186045417] [17592186343824 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186343824 #edb/ref 1083 #uuid "b53eaae6-d50b-5fbe-95be-daf4107639c7" #edb/ref 17592186045417] [17592186344311 #edb/ref 1080 "24" #edb/ref 17592186045417] [17592186344311 #edb/ref 1082 #edb/ref 17592