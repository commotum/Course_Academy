#{[{:activity/first-step {:db/id #edb/ref 17592186152988} :activity/id #uuid "867309ee-c854-554c-b2ec-82c116f57f1a" :activity/scope {:db/id #edb/ref 17592186049103 :topic/id #uuid "dacf8e9b-9edd-529a-94c7-c0ef301aee1e" :topic/math-academy-id 2550} :activity/steps [{:db/id #edb/ref 17592186152976 :step/content {:db/id #edb/ref 17592186152104 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151914 :question/id #uuid "67b3b574-0346-5133-9f0b-303bc00ace78" :question/math-academy-id "e-4450"} :knowledge-point/id #uuid "2e3e8809-2164-543d-bb0a-c6a20cc7de6b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049357} {:db/id #edb/ref 17592186050195}] :knowledge-point/questions [{:db/id #edb/ref 17592186152646} {:db/id #edb/ref 17592186152648}] :knowledge-point/title "Calculating a Unit Rate as the Quotient of an Integer and a Fraction"} :step/id #uuid "ae0023c5-cca8-5fd0-91af-d8282fa626c9" :step/math-academy-id 16261 :step/next {:db/id #edb/ref 17592186152977}} {:db/id #edb/ref 17592186152977 :step/content {:db/id #edb/ref 17592186152105 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151915 :question/id #uuid "1d6f2a78-51e4-55cf-9c75-79a4624d630c" :question/math-academy-id "e-4451"} :knowledge-point/id #uuid "b04f86ac-4028-5df6-8913-44ef091ed396" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049046}] :knowledge-point/questions [{:db/id #edb/ref 17592186152647} {:db/id #edb/ref 17592186152649}] :knowledge-point/title "Calculating a Unit Rate as the Quotient of a Fraction and an Integer"} :step/id #uuid "7b658789-5260-5641-a7c7-e20247b9fe57" :step/math-academy-id 16262 :step/next {:db/id #edb/ref 17592186152978}} {:db/id #edb/ref 17592186152978 :step/content {:db/id #edb/ref 17592186152106 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151916 :question/id #uuid "f830d531-b8f0-5b62-88a5-38edf6459b55" :question/math-academy-id "e-4452"} :knowledge-point/id #uuid "87385cd2-8143-54de-9995-e1cc2ecf06c0" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049616}] :knowledge-point/questions [{:db/id #edb/ref 17592186152650} {:db/id #edb/ref 17592186152651}] :knowledge-point/title "Calculating a Unit Rate as the Quotient of a Fraction and a Fraction"} :step/id #uuid "e7d1d769-c6b4-5bf2-9949-638b782007aa" :step/math-academy-id 16263} {:db/id #edb/ref 17592186152988 :step/content {:db/id #edb/ref 17592186153341 :tutorial/content "A **unit rate** is a ratio of two quantities stated as some amount of one quantity per unit of the other quantity.\n\nFor example, suppose that Carl can run $100$ meters in $20$ seconds. The unit rate is how many meters Carl can run in $1$ second. To compute Carl's unit rate, we divide the number of meters by the number of seconds:\n\n$$\n100 \\div 20 = 5\n$$\n\nSo, the unit rate is $5$ meters per second. In other words, Carl can run $5$ meters in $1$ second.\n\nUnit rates do not always come out to whole numbers. For example, suppose Jamie can run $100$ meters in $15$ seconds. To compute Jamie's unit rate, we again divide the number of meters by the number of seconds:\n\n$$\n\\begin{aligned}\n100 \\div 15 &= \\frac{100}{15} \\\\\n&= \\frac{100 \\div 5}{15 \\div 5} \\\\\n&= \\frac{20}{3}\n\\end{aligned}\n$$\n\nWriting the resulting improper fraction as a mixed number, we get\n\n$$\n\\dfrac{20}{3} = 6 \\, \\textrm{R} 2 = 6 \\, \\dfrac{2}{3}\n$$\n\nTherefore, Jamie can run\n\n$$\n6 \\, \\dfrac{2}{3}\n$$\n\nmeters per second." :tutorial/id #uuid "9f08d42f-43a3-595e-92b3-d634f656ce2e" :tutorial/math-academy-id 3073 :tutorial/title "Introduction"} :step/id #uuid "33197a11-fb17-59b2-b2dc-f9c9927714b9" :step/math-academy-id 16684 :step/next {:db/id #edb/ref 17592186152976}}] :activity/title "Unit Rates Associated With Ratios of Fractions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186152308}]}
