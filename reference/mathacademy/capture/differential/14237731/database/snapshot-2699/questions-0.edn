ac{5}{4} \\\\  & =\\frac{24}{1}\\times \\frac{5}{4} \\\\  & =\\frac{24\\times 5}{1\\times 4} \\\\  & =\\frac{120}{4} \\\\  & =30\\end{aligned}\n$$\n\nTherefore, Owen can do $30$ exercises in $1$ hour."}] [{:db/id #edb/ref 17592186152646 :knowledge-point/_questions [{:db/id #edb/ref 17592186152104 :knowledge-point/id #uuid "2e3e8809-2164-543d-bb0a-c6a20cc7de6b" :knowledge-point/title "Calculating a Unit Rate as the Quotient of an Integer and a Fraction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ea38938-101c-5627-b633-5ed8a7a16e24" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$48$ feet per second" :db/id #edb/ref 17592186150384} {:answer/id #uuid "b3688ffd-9141-591e-b0a7-5a2afb425c3e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$52$ feet per second" :db/id #edb/ref 17592186150385} {:answer/id #uuid "b9ffc2d8-74a2-541b-90c6-32b27b02168d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$46$ feet per second" :db/id #edb/ref 17592186150386} {:answer/id #uuid "c7515aae-c4ad-5d67-9431-e0caf81d5091" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$42$ feet per second" :db/id #edb/ref 17592186150387} {:answer/id #uuid "42f32271-86ab-5546-9fe1-7079e8fbd060" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$44$ feet per second" :db/id #edb/ref 17592186150388}] :answer-field/correct {:answer/id #uuid "8ea38938-101c-5627-b633-5ed8a7a16e24" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$48$ feet per second" :db/id #edb/ref 17592186150384} :answer-field/id #uuid "28ad58b4-b6cf-57e3-ac26-291900a23a7b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186150383}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3d1cba23-ee84-559a-950a-b7d528c5c6c3" :question/math-academy-id "q-67813" :question/problem "A skydiver falls $40$ feet in $\\frac{5}{6}$ seconds. What is the unit rate of feet fallen per second?" :question/worked-solution "To compute the unit rate of feet per second, we divide the number of feet, $40,$ by the number of seconds, $\\frac{5}{6}$, as follows: \n\n$$\n40÷\\frac{5}{6}\n$$\n\nTo divide by a fraction, we multiply by the fraction's reciprocal:\n\n$$\n\\begin{aligned}40÷\\frac{5}{6} & =40\\times \\frac{6}{5} \\\\  & =\\frac{40}{1}\\times \\frac{6}{5} \\\\  & =\\frac{40\\times 6}{1\\times 5} \\\\  & =\\frac{240}{5} \\\\  & =48\\end{aligned}\n$$\n\nTherefore, the unit rate in this situation is $48$ feet per second."}] [{:db/id #edb/ref 17592186152647 :knowledge-point/_questions [{:db/id #edb/ref 17592186152105 :knowledge-point/id #uuid "b04f86ac-4028-5df6-8913-44ef091ed396" :knowledge-point/title "Calculating a Unit Rate as the Quotient of a Fraction and an Integer"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ad02509e-6cdf-50f8-ab35-d0ff4e6fa3b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{10}{27}$ gallons per minute" :db/id #edb/ref 17592186150390} {:answer/id #uuid "b59a8bbd-a979-5d5e-a42f-753f23b68c0a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{3}{10}$ gallons per minute" :db/id #edb/ref 17592186150391} {:answer/id #uuid "06c5fd06-fa00-5a26-9c2f-a883805f3e6a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{3}{7}$ gallons per minute" :db/id #edb/ref 17592186150392} {:answer/id #uuid "17a3ca96-9272-50f5-9a5d-02753ebbeb33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{1}{3}$ gallons per minute" :db/id #edb/ref 17592186150393} {:answer/id #uuid "7809cee6-0697-5c5e-8963-2ebb647b3f70" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{2}{9}$ gallons per minute" :db/id #edb/ref 17592186150394}] :answer-field/correct {:answer/id #uuid "b59a8bbd-a979-5d5e-a42f-753f23b68c0a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{3}{10}$ gallons per minute" :db/id #edb/ref 17592186150391} :answer-field/id #uuid "44b6f0e4-9b98-5fa4-8624-94593dbd8b21" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186150389}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ea2bddd6-202c-5cca-ba91-9cd2b70baf28" :question/math-academy-id "q-67814" :question/problem "A pump moves $\\frac{9}{10}$ gallons of water in three minutes. Find the unit rate of gallons per minute." :question/worked-solution "To compute the unit rate of gallons per minute, we divide the number of gallons, $\\frac{9}{10},$ by the number of minutes, $3$, as follows:   \n\n$$\n\\frac{9}{10}÷3\n$$\n\nDividing a fraction by a whole number is equivalent to multiplying the fraction by the reciprocal of that whole number:\n\n$$\n\\begin{aligned}\\frac{9}{10}÷3 & =\\frac{9}{10}÷\\frac{3}{1} \\\\  & =\\frac{9}{10}\\times \\frac{1}{3} \\\\  & =\\frac{9\\times 1}{10\\times 3} \\\\  & =\\frac{3\\times 3}{10\\times 3} \\\\  & =\\frac{3\\times \\cancel{3}}{10\\times \\cancel{3}} \\\\  & =\\frac{3}{10}\\end{aligned}\n$$\n\nTherefore, the unit rate in this situation is $\\frac{3}{10}$ gallons per minute."}] [{:db/id #edb/ref 17592186152651 :knowledge-point/_questions [{:db/id #edb/ref 17592186152106 :knowledge-point/id #uuid "87385cd2-8143-54de-9995-e1cc2ecf06c0" :knowledge-point/title "Calculating a Unit Rate as the Quotient of a Fraction and a Fraction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d5747382-778d-5aef-bc47-1305a53de870" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186150417} {:answer/id #uuid "fed1b810-85ef-5011-b00f-2930e8117be4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186150418} {:answer/id #uuid "0153e8af-7940-50ee-90ef-b1dfd0e45b5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,\\frac{1}{3}" :db/id #edb/ref 17592186556431} {:answer/id #uuid "148f688d-3a85-57a5-b966-a8820f8f1a74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,\\frac{1}{6}" :db/id #edb/ref 17592186556473} {:answer/id #uuid "d04bb74e-c21f-56f1-9310-a6adde831b6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,\\frac{3}{6}" :db/id #edb/ref 17592186556933}] :answer-field/correct {:answer/id #uuid "148f688d-3a85-57a5-b966-a8820f8f1a74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,\\frac{1}{6}" :db/id #edb/ref 17592186556473} :answer-field/id #uuid "284d2c18-88a4-50e8-a2d2-75fa19b0e1f7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186150413}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2761f039-d13a-562d-9bd0-6270f04a74fe" :question/math-academy-id "q-67829" :question/problem "Jim ran $\\frac{5}{6}$ of a mile in $\\frac{1}{5}$ of an hour. How many miles can Jim run in $1$ hour?" :question/worked-solution "To find the number of miles Jim can run in $1$ hour, we can compute the unit rate of miles per hour. We do this by dividing the number of miles, $\\frac{5}{6},$ by the number of hours, $\\frac{1}{5},$ as follows:  \n\n$$\n\\frac{5}{6}÷\\frac{1}{5}\n$$\n\nDividing a fraction by another fraction is equivalent to multiplying the first fraction by the reciprocal of the second fraction:\n\n$$\n\\begin{aligned}\\frac{5}{6}÷\\frac{1}{5} & =\\frac{5}{6}\\times \\frac{5}{1} \\\\  & =\\frac{5\\times 5}{6\\times 1} \\\\  & =\\frac{25}{6}\\end{aligned}\n$$\n\nFinally, we write the resulting improper fraction as a mixed number:\n\n$$\n\\frac{25}{6}=4\\,\\text{R}1=4\\,\\frac{1}{6}\n$$\n\nTherefore, Jim can run $4\\,\\frac{1}{6}$ miles in $1$ hour."}] [{:db/id #edb/ref 17592186557268 :knowledge-point/_questions [{:db/id #edb/ref 17592186152105 :knowledge-point/id #uuid "b04f86ac-4028-5df6-8913-44ef091ed396" :knowledge-point/title "Calculating a Unit Rate as the Quotient of a Fraction and an Integer"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a8ec316-eac3-5582-ac9e-9d0ecabb5dd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{56}" :db/id #edb/ref 17592186556521} {:answer/id #uuid "5454a88a-d451-5112-aaba-edf60456ae48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{49}" :db/id #edb/ref 17592186556623} {:answer/id #uuid "60efeb69-2291-5ab8-97b8-0921d4ea912c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{25}" :db/id #edb/ref 17592186556649} {:answer/id #uuid "8a15ef33-1e8c-55f7-81a5-4f5dc6a79003" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{56}" :db/id #edb/ref 17592186556759} {:answer/id #uuid "ab7954bb-6098-5d17-87fa-f7398cad0ac1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{16}" :db/id #edb/ref 17592186556852}] :answer-field/correct {:answer/id #uuid "2a8ec316-eac3-5582-ac9e-9d0ecabb5dd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{56}" :db/id #edb/ref 17592186556521} :answer-field/id #uuid "a1b78218-0d64-5b00-9db3-4a0b69af469e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557157}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "71f0d135-eabe-57fb-ab96-cf20fb60fc0a" :question/math-academy-id "q-67840" :question/problem "Johnny walked $\\frac{3}{8}$ of a mile in  $7$ minutes, keeping an even pace. How many miles did he walk in $1$ minute?" :question/worked-solution "To compute the number of miles Johnny  walked in $1$ minute, we can compute the unit rate of miles per minute. We do this by dividing the number of miles, $\\frac{3}{8},$ by the number of minute, as follows:   \n\n$$\n\\frac{3}{8}÷7\n$$\n\nDividing a fraction by a whole number is equivalent to multiplying the fraction by the reciprocal of that whole number:\n\n$$\n\\begin{aligned}\\frac{3}{8}÷7 & =\\frac{3}{8}\\times \\frac{1}{7} \\\\  & =\\frac{3\\times 1}{8\\times 7} \\\\  & =\\frac{3}{56}\\end{aligned}\n$$\n\nSo, Johnny walked  $\\frac{3}{56}$ miles in $1$ minute."}] [{:db/id #edb/ref 17592186557279 :knowledge-point/_questions [{:db/id #edb/ref 17592186152105 :knowledge-point/id #uuid "b04f86ac-4028-5df6-8913-44ef091ed396" :knowledge-point/title "Calculating a Unit Rate as the Quotient of a Fraction and an Integer"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ac93665-3485-5b87-afe8-8a6c218d990f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{7}{10}$ miles per second" :db/id #edb/ref 17592186556557} {:answer/id #uuid "4fe3b194-43a2-5bcb-be96-d93b17b67cb8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{1}{10}$ miles per second" :db/id #edb/ref 17592186556608} {:answer/id #uuid "56c3a097-3da8-592f-839d-534722217b99" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{1}{12}$ miles per second" :db/id #edb/ref 17592186556629} {:answer/id #uuid "74859d4c-493a-53d5-b8ba-de3078dd8c92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{3}{10}$ miles per second" :db/id #edb/ref 17592186556694} {:answer/id #uuid "e4b5b4be-4671-5f9e-9df6-8769608166bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{5}{12}$ miles per second" :db/id #edb/ref 17592186556995}] :answer-field/correct {:answer/id #uuid "4fe3b194-43a2-5bcb-be96-d93b17b67cb8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{1}{10}$ miles per second" :db/id #edb/ref 17592186556608} :answer-field/id #uuid "cde096b2-00d6-5b15-9126-741eaff0be29" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557181}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8c31a83a-d0fb-50d8-8958-8a93c295b8d7" :question/math-academy-id "q-67843" :question/problem "A plane can travel $\\frac{3}{5}$ of a mile in $6$ seconds.  What is the unit rate of miles traveled per second?" :question/worked-solution "To compute the unit rate of miles per second, we divide the number of miles, $\\frac{3}{5},$ by the number of seconds, $6$, as follows:    \n\n$$\n\\frac{3}{5}÷6\n$$\n\nDividing a fraction by a whole number is equivalent to multiplying the fraction by the reciprocal of that whole number:\n\n$$\n\\begin{aligned}\\frac{3}{5}÷6 & =\\frac{3}{5}÷\\frac{6}{1} \\\\  & =\\frac{3}{5}\\times \\frac{1}{6} \\\\  & =\\frac{3\\times 1}{5\\times 6} \\\\  & =\\frac{3\\times 1}{5\\times 2\\times 3} \\\\  & =\\frac{\\cancel{3}\\times 1}{5\\times 2\\times \\cancel{3}} \\\\  & =\\frac{1}{10}\\end{aligned}\n$$\n\n \n\nTherefore, the unit rate in this situation is $\\frac{1}{10}$ miles per second."}] [{:db/id #edb/ref 17592186557267 :knowledge-point/_questions [{:db/id #edb/ref 17592186152105 :knowledge-point/id #uuid "b04f86ac-4028-5df6-8913-44ef091ed396" :knowledge-point/title "Calculating a Unit Rate as the Quotient of a Fraction and an Integer"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31a2c1e0-465b-5463-ada3-ebc481d00702" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{1}{10}$ laps per minute" :db/id #edb/ref 17592186556534} {:answer/id #uuid "3b52d182-7e17-5949-be54-a233c9d261b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{2}{10}$ laps per minute" :db/id #edb/ref 17592186556559} {:answer/id #uuid "9a01ebef-f9b5-5146-8ea2-b0be45e8fdd3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1\\frac{3}{5}$ laps per minute" :db/id #edb/ref 17592186556801} {:answer/id #uuid "aec67466-3054-5dc0-beb6-55abf9092bc6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{2}{5}$ laps per minute" :db/id #edb/ref 17592186556859} {:answer/id #uuid "c5f5b6f1-8864-5516-86ca-c909870e413c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{3}{5}$ laps per minute" :db/id #edb/ref 17592186556906}] :answer-field/correct {:answer/id #uuid "aec67466-3054-5dc0-beb6-55abf9092bc6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{2}{5}$ laps per minute" :db/id #edb/ref 17592186556859} :answer-field/id #uuid "728455ea-fb60-53bd-a006-dfa511296e5c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557131}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "70693bce-1563-5043-b145-f1732cc4b8df" :question/math-academy-id "q-67874" :question/problem "A race car covers $\\frac{4}{5}$ of a lap in  $2$ minutes.  What is the unit rate of laps covered per minute?" :question/worked-solution "To compute the unit rate of laps per minute, we divide the number of laps, $\\frac{4}{5},$ by the number of seconds, $2$, as follows:     \n\n$$\n\\frac{4}{5}÷2\n$$\n\nDividing a fraction by a whole number is equivalent to multiplying the fraction by the reciprocal of that whole number:\n\n$$\n\\begin{aligned}\\frac{4}{5}÷2 & =\\frac{4}{5}÷\\frac{2}{1} \\\\  & =\\frac{4}{5}\\times \\frac{1}{2} \\\\  & =\\frac{4\\times 1}{5\\times 2} \\\\  & =\\frac{2\\times 2}{2\\times 5} \\\\  & =\\frac{\\cancel{2}\\times 2}{\\cancel{2}\\times 5} \\\\  & =\\frac{2}{5}\\end{aligned}\n$$\n\n \n\nTherefore, the unit rate in this situation is $\\frac{2}{5}$ laps per minute."}] [{:db/id #edb/ref 17592186557231 :knowledge-point/_questions [{:db/id #edb/ref 17592186152104 :knowledge-point/id #uuid "2e3e8809-2164-543d-bb0a-c6a20cc7de6b" :knowledge-point/title "Calculating a Unit Rate as the Quotient of an Integer and a Fraction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23801a00-f920-5878-a54b-0e06f4704881" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,\\frac{1}{2}" :db/id #edb/ref 17592186556511} {:answer/id #uuid "24c31280-ecb5-58d8-bd23-e18274f8038d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,\\frac{1}{4}" :db/id #edb/ref 17592186556515} {:answer/id #uuid "4dd185bc-1d53-5d06-af55-d197af516931" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186556601} {:answer/id #uuid "791d18e1-4093-5dab-80b1-2cdeeec278b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186556711} {:answer/id #uuid "d14f5c60-8845-5e03-9980-e5ba4292d37b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186556934}] :answer-field/correct {:answer/id #uuid "791d18e1-4093-5dab-80b1-2cdeeec278b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186556711} :answer-field/id #uuid "b3b22992-4d44-561b-9f44-cf2d5dba8e93" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557167}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "33c6a696-2687-53cf-91b5-ae5c51099777" :question/math-academy-id "q-67896" :question/problem "At a fair, a carousel makes $3$ revolutions in  $\\frac{3}{5}$ minutes. How many revolutions does it make in $1$ minute?" :question/worked-solution "To find out the number of revolutions the carousel makes in $1$ minute, we can compute the unit rate of revolutions per minute. We do this by dividing the number of revolutions, $3,$ by the number of minutes, $\\frac{3}{5}$, as follows:  \n\n$$\n3÷\\frac{3}{5}\n$$\n\nTo divide by a fraction, we multiply by the fraction's reciprocal:\n\n$$\n\\begin{aligned}3÷\\frac{3}{5} & =3\\times \\frac{5}{3} \\\\  & =\\frac{3}{1}\\times \\frac{5}{3} \\\\  & =\\frac{3\\times 5}{1\\times 3} \\\\  & =\\frac{15}{3} \\\\  & =5\\end{aligned}\n$$\n\nTherefore, the carousel makes  $5$ revolutions in $1$ minute."}] [{:db/id #edb/ref 17592186557306 :knowledge-point/_questions [{:db/id #edb/ref 17592186152104 :knowledge-point/id #uuid "2e3e8809-2164-543d-bb0a-c6a20cc7de6b" :knowledge-point/title "Calculating a Unit Rate as the Quotient of an Integer and a Fraction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f040a93-6f4b-5c58-ad19-03b03ef0421d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$36$ liters" :db/id #edb/ref 17592186556459} {:answer/id #uuid "2bd953d5-ff42-579c-acb2-def35c667d27" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$9$ liters" :db/id #edb/ref 17592186556524} {:answer/id #uuid "45dc3045-0571-5014-a74d-81cdca7770a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$8$ liters" :db/id #edb/ref 17592186556584} {:answer/id #uuid "6754d3ae-b8b9-53e9-9b8a-a331a071d537" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4$ liters" :db/id #edb/ref 17592186556674} {:answer/id #uuid "897c8d4f-efc3-5482-98f8-433b96884808" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$7$ liters" :db/id #edb/ref 17592186556756}] :answer-field/correct {:answer/id #uuid "2bd953d5-ff42-579c-acb2-def35c667d27" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$9$ liters" :db/id #edb/ref 17592186556524} :answer-field/id #uuid "fd0af01a-73e4-519b-b081-ca37b5a21db0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557207}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c922cf86-366d-5b96-b6c8-e7d64dc90ff6" :question/math-academy-id "q-67905" :question/problem "A leaking paddling pool loses $6$ liters of water in  $\\frac{2}{3}$ hours. How much water will it lose in $1$ hour?" :question/worked-solution "To find out how much water the pool will lose in $1$ hour, we can compute the unit rate of liters of water lost per hour. We do this by dividing  the number of liters, $6,$ by the number of hours, $\\frac{2}{3}$, as follows:     \n\n$$\n6÷\\frac{2}{3}\n$$\n\nTo divide by a fraction, we multiply by the fraction's reciprocal:\n\n$$\n\\begin{aligned}6÷\\frac{2}{3} & =6\\times \\frac{3}{2} \\\\  & =\\frac{6}{1}\\times \\frac{3}{2} \\\\  & =\\frac{6\\times 3}{1\\times 2} \\\\  & =\\frac{18}{2} \\\\  & =9\\end{aligned}\n$$\n\nTherefore, the pool will lose $9$ liters of water in $1$ hour."}] [{:db/id #edb/ref 17592186557233 :knowledge-point/_questions [{:db/id #edb/ref 17592186152106 :knowledge-point/id #uuid "87385cd2-8143-54de-9995-e1cc2ecf06c0" :knowledge-point/title "Calculating a Unit Rate as the Quotient of a Fraction and a Fraction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "493940a9-253b-5a45-a88e-7e139a8230c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{3}{10}$ miles per minute" :db/id #edb/ref 17592186556594} {:answer/id #uuid "70090ca7-e591-51bc-b92a-43641ff66542" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{1}{2}$ miles per minute" :db/id #edb/ref 17592186556686} {:answer/id #uuid "a70b8aba-2006-588a-9b36-9664101c1dc6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$ miles per minute" :db/id #edb/ref 17592186556840} {:answer/id #uuid "d42f7600-375a-59ca-9455-2853caf93570" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{1}{10}$ miles per minute" :db/id #edb/ref 17592186556944} {:answer/id #uuid "d43afe7e-a4ce-5422-b4f9-1126acce88dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{4}{5}$ miles per minute" :db/id #edb/ref 17592186556945}] :answer-field/correct {:answer/id #uuid "a70b8aba-2006-588a-9b36-9664101c1dc6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$ miles per minute" :db/id #edb/ref 17592186556840} :answer-field/id #uuid "f44b7de9-d96a-53e8-a12e-ce4a8ea8e840" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557202}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "37159145-3e5f-53f2-822d-4367df7cb7bc" :question/math-academy-id "q-67957" :question/problem "A skydiver falls $\\frac{4}{5}$ of a mile in $\\frac{2}{5}$ minutes. What is the unit rate of miles fallen per minute?" :question/worked-solution "To compute the unit rate of miles per minute, we divide the number of miles, $\\frac{4}{5},$ by the number of minutes, $\\frac{2}{5}$, as follows: \n\n$$\n\\frac{4}{5}÷\\frac{2}{5}\n$$\n\nDividing a fraction by another fraction is equivalent to multiplying the first fraction by the reciprocal of the second fraction:\n\n$$\n\\begin{aligned}\\frac{4}{5}÷\\frac{2}{5} & =\\frac{4}{5}\\times \\frac{5}{2} \\\\  & =\\frac{4\\times 5}{5\\times 2} \\\\  & =\\frac{2\\times 2\\times 5}{5\\times 2} \\\\  & =\\frac{\\cancel{2}\\times \\cancel{5}\\times 2}{\\cancel{2}\\times \\cancel{5}} \\\\  & =2\\end{aligned}\n$$\n\nTherefore, the unit rate is $2$ miles per minute."}] [{:db/id #edb/ref 17592186557262 :knowledge-point/_questions [{:db/id #edb/ref 17592186152106 :knowledge-point/id #uuid "87385cd2-8143-54de-9995-e1cc2ecf06c0" :knowledge-point/title "Calculating a Unit Rate as the Quotient of a Fraction and a Fraction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41a64a33-32be-5dd3-a470-cc04307cda2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186556573} {:answer/id #uuid "506250f5-ba3b-5016-bdc4-5b2f75606b96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186556612} {:answer/id #uuid "663127ee-ca61-54fd-bd7a-e8c3c21cf07f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186556670} {:answer/id #uuid "8d0a7fb2-745a-5a4b-8c76-c522f2f54c2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186556770} {:answer/id #uuid "926c20da-babe-5216-892f-00c1074d45bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186556782}] :answer-field/correct {:answer/id #uuid "41a64a33-32be-5dd3-a470-cc04307cda2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186556573} :answer-field/id #uuid "3ec2a288-b18b-538e-8e74-f5770e5218c5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557100}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6aea863a-357f-52de-8ad7-b9c9c32993ae" :question/math-academy-id "q-67962" :question/problem "A certain satellite makes $\\frac{1}{3}$  of its orbit around the Earth in $\\frac{1}{6}$ of a day. How many times can it orbit Earth in $1$ day?" :question/worked-solution "To find how many  times the satellite  can go around the Earth in $1$ day, we can compute the orbital unit rate per day. We do this by dividing the amount of the orbit the satellite travels, $\\frac{1}{3},$ by the corresponding fraction of a day, $\\frac{1}{6},$ as follows:  \n\n$$\n\\frac{1}{3}÷\\frac{1}{6}\n$$\n\nDividing a fraction by another fraction is equivalent to multiplying the first fraction by the reciprocal of the second fraction:\n\n$$\n\\begin{aligned}\\frac{1}{3}÷\\frac{1}{6} & =\\frac{1}{3}\\times \\frac{6}{1} \\\\  & =\\frac{1\\times 6}{3\\times 1} \\\\  & =\\frac{6}{3} \\\\  & =2\\end{aligned}\n$$\n\nTherefore, the satellite can orbit Earth $2$ times in $1$ day."}] [{:db/id #edb/ref 17592186557263 :knowledge-point/_questions [{:db/id #edb/ref 17592186152106 :knowledge-point/id #uuid "87385cd2-8143-54de-9995-e1cc2ecf06c0" :knowledge-point/title "Calculating a Unit Rate as the Quotient of a Fraction and a Fraction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08d6df6d-3090-5380-af3f-b6a2c1297623" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{2}{3}$ miles per minute" :db/id #edb/ref 17592186556450} {:answer/id #uuid "34d51373-e059-5bb2-b915-ea1bf3300d5d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{1}{2}$ mile per minute" :db/id #edb/ref 17592186556543} {:answer/id #uuid "4bc6dd10-ce27-56ea-8697-58814869e5a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{4}{5}$ miles per minute" :db/id #edb/ref 17592186556598} {:answer/id #uuid "a26136a8-2a89-5671-9dc1-9250849e70bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{5}{6}$ miles per minute" :db/id #edb/ref 17592186556827} {:answer/id #uuid "d6bb8ba7-cf6b-5bb3-aa7f-0dc97af0d2b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{3}{4}$ miles per minute" :db/id #edb/ref 17592186556955}] :answer-field/correct {:answer/id #uuid "08d6df6d-3090-5380-af3f-b6a2c1297623" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{2}{3}$ miles per minute" :db/id #edb/ref 17592186556450} :answer-field/id #uuid "80a2f73d-2fec-566e-a93a-03901ddd1e55" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557140}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6cccdce8-916f-545e-8523-5e2c1794424a" :question/math-academy-id "q-67967" :question/problem "Riding his electric bike, Matt can go $\\frac{1}{2}$ of a mile in $\\frac{3}{4}$  minutes. What is the unit rate of miles covered per minute?" :question/worked-solution "To compute the unit rate of miles per minute, we divide the number of miles, $\\frac{1}{2},$ by the number of minutes, $\\frac{3}{4}$, as follows: \n\n$$\n\\frac{1}{2}÷\\frac{3}{4}\n$$\n\nDividing a fraction by another fraction is equivalent to multiplying the first fraction by the reciprocal of the second fraction:\n\n$$\n\\begin{aligned}\\frac{1}{2}÷\\frac{3}{4} & =\\frac{1}{2}\\times \\frac{4}{3} \\\\  & =\\frac{1\\times 4}{2\\times 3} \\\\  & =\\frac{2\\times 2}{2\\times 3} \\\\  & =\\frac{\\cancel{2}\\times 2}{\\cancel{2}\\times 3} \\\\  & =\\frac{2}{3}\\end{aligned}\n$$\n\n \n\nTherefore, the unit rate is $\\frac{2}{3}$ miles per minute."}] [{:db/id #edb/ref 17592186557332 :knowledge-point/_questions [{:db/id #edb/ref 17592186152104 :knowledge-point/id #uuid "2e3e8809-2164-543d-bb0a-c6a20cc7de6b" :knowledge-point/title "Calculating a Unit Rate as the Quotient of an Integer and a Fraction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00dc0803-4289-5d10-9911-65583cfc3728" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$38$ pages" :db/id #edb/ref 17592186556430} {:answer/id #uuid "72410a5d-4ed2-589c-9a96-915c6691fadf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$32\\,\\frac{1}{2}$ pages" :db/id #edb/ref 17592186556689} {:answer/id #uuid "7331676a-b6b0-50c8-abb5-bc1399ef4d38" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$30$ pages" :db/id #edb/ref 17592186556691} {:answer/id #uuid "95fb0629-d415-573c-9722-1d179bf8863b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$33$ pages" :db/id #edb/ref 17592186556792} {:answer/id #uuid "b1c7732a-c197-5e0d-8737-34107092414f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$31\\,\\frac{3}{4}$ pages" :db/id #edb/ref 17592186556866}] :answer-field/correct {:answer/id #uuid "95fb0629-d415-573c-9722-1d179bf8863b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$33$ pages" :db/id #edb/ref 17592186556792} :answer-field/id #uuid "2744fc75-9aee-5472-b571-e924eb38f9e9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557090}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fab8d7a2-8042-5e4e-8fd9-ae407a4d21d4" :question/math-academy-id "q-71430" :question/problem "Suzie takes $\\frac{2}{3}$ hours to read $22$ pages of a certain book. How many pages can she read in $1$ hour?" :question/worked-solution "To find the number of pages Suzie can read in $1$ hour, we compute the unit rate of pages per hour. We do this by dividing the number of pages Suzie reads, $22,$ by the number of hours, $\\frac{2}{3},$ as follows:\n\n$$\n22÷\\frac{2}{3}\n$$\n\nDividing a fraction by a whole number is equivalent to multiplying the fraction by the reciprocal of that whole number:\n\n$$\n\\begin{aligned}22÷\\frac{2}{3} & =22\\times \\frac{3}{2} \\\\  & =\\frac{22}{1}\\times \\frac{3}{2} \\\\  & =\\frac{22\\times 3}{1\\times 2} \\\\  & =\\frac{66}{2} \\\\  & =33\\end{aligned}\n$$\n\nTherefore, Suzie can read $33$ pages in $1$ hour."}] [{:db/id #edb/ref 17592186557296 :knowledge-point/_questions [{:db/id #edb/ref 17592186152105 :knowledge-point/id #uuid "b04f86ac-4028-5df6-8913-44ef091ed396" :knowledge-point/title "Calculating a Unit Rate as the Quotient of a Fraction and an Integer"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8cc41ae4-5ed6-5660-bbbc-4a08a3bf722b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{1}{5}$ gallons per second" :db/id #edb/ref 17592186556768} {:answer/id #uuid "8d75af3a-b98d-5d57-aa31-3ac9a9e6b286" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{7}{15}$ gallons per second" :db/id #edb/ref 17592186556771} {:answer/id #uuid "8ea4677e-c8ef-54b9-a15a-630f36cbe00b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{1}{3}$ gallons per second" :db/id #edb/ref 17592186556777} {:answer/id #uuid "9b42d88b-d93e-501b-b9d6-31e30b995f77" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{4}{15}$ gallons per second" :db/id #edb/ref 17592186556808} {:answer/id #uuid "cbc7a1c4-f866-5d17-a6b7-c95942a60d35" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{2}{15}$ gallons per second" :db/id #edb/ref 17592186556920}] :answer-field/correct {:answer/id #uuid "cbc7a1c4-f866-5d17-a6b7-c95942a60d35" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{2}{15}$ gallons per second" :db/id #edb/ref 17592186556920} :answer-field/id #uuid "3757453c-451a-533e-89bf-ae008505f529" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557097}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bde894c0-0f60-52a1-8f53-44362f2c04ac" :question/math-academy-id "q-71431" :question/problem "An air compressor moves $\\frac{8}{15}$ gallons of air in four seconds. Find the unit rate of gallons per second." :question/worked-solution "To compute the unit rate of gallons per second, we divide the number of gallons, $\\frac{8}{15},$ by the number of seconds, $4$, as follows:   \n\n$$\n\\frac{8}{15}÷4\n$$\n\nDividing a fraction by a whole number is equivalent to multiplying the fraction by the reciprocal of that whole number:\n\n$$\n\\begin{aligned}\\frac{8}{15}÷4 & =\\frac{8}{15}÷\\frac{4}{1} \\\\  & =\\frac{8}{15}\\times \\frac{1}{4} \\\\  & =\\frac{8\\times 1}{15\\times 4} \\\\  & =\\frac{2\\times 4}{15\\times 4} \\\\  & =\\frac{2\\times \\cancel{4}}{15\\times \\cancel{4}} \\\\  & =\\frac{2}{15}\\end{aligned}\n$$\n\nTherefore, the unit rate in this situation is $\\frac{2}{15}$ gallons per second."}] [{:db/id #edb/ref 17592186557210 :knowledge-point/_questions [{:db/id #edb/ref 17592186152106 :knowledge-point/id #uuid "87385cd2-8143-54de-9995-e1cc2ecf06c0" :knowledge-point/title "Calculating a Unit Rate as the Quotient of a Fraction and a Fraction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01f2bbf6-d10e-547b-9978-414fb88af65f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{7}{3}$ gallons per lawn" :db/id #edb/ref 17592186556435} {:answer/id #uuid "1005ee30-9311-5fb9-a232-e0178b92429a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$7$ gallons per lawn" :db/id #edb/ref 17592186556462} {:answer/id #uuid "16a97f78-f4fe-5855-b81b-381b3a37c9e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3$ gallons per lawn" :db/id #edb/ref 17592186556477} {:answer/id #uuid "7ebc5524-a707-5058-b0e2-7b06a1664d65" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{3}{7}$ gallons per lawn" :db/id #edb/ref 17592186556721} {:answer/id #uuid "ff687e65-7e6f-5e64-a0f5-de85e7a030e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{5}{7}$ gallons per lawn" :db/id #edb/ref 17592186557060}] :answer-field/correct {:answer/id #uuid "7ebc5524-a707-5058-b0e2-7b06a1664d65" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{3}{7}$ gallons per lawn" :db/id #edb/ref 17592186556721} :answer-field/id #uuid "09020a00-7821-5c7f-a323-c2393071bde1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557067}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "06090a54-3bf7-5dce-b7f7-51954f025453" :question/math-academy-id "q-71434" :question/problem "A container with $\\frac{3}{4}$ gallons of weed killer can spray $\\frac{7}{4}$ lawns. What is the unit rate of gallons per lawn?" :question/worked-solution "To compute the unit rate of gallons per lawn, we divide the number of gallons, $\\frac{3}{4},$ by the number of lawns, $\\frac{7}{4}$, as follows: \n\n$$\n\\frac{3}{4}÷\\frac{7}{4}\n$$\n\nDividing a fraction by another fraction is equivalent to multiplying the first fraction by the reciprocal of the second fraction:\n\n$$\n\\begin{aligned}\\frac{3}{4}÷\\frac{7}{4} & =\\frac{3}{4}\\times \\frac{4}{7} \\\\  & =\\frac{3\\times 4}{4\\times 7} \\\\  & =\\frac{3\\times \\cancel{4}}{\\cancel{4}\\times 7} \\\\  & =\\frac{3}{7}\\end{aligned}\n$$\n\nTherefore, the unit rate is $\\frac{3}{7}$ gallons per lawn."}]}
