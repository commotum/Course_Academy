    "q-32417": {
      "dom_id": "step-q32417",
      "name": "Question 9",
      "problem": "Find the derivative of  $f(t)=\\operatorname{arccos}⁡3t\\,i-5{t}^{4}\\,j+\\frac{2}{{t}^{3}}\\,k$ with respect to $t.$",
      "worked_solution": "We find the derivative of $f(t)$  by differentiating each component:\n\n$$\n\\begin{aligned}{f}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{arccos}⁡3t)\\,i-\\frac{\\text{d}}{\\text{d}t}(5{t}^{4})\\,j+\\frac{\\text{d}}{\\text{d}t}(\\frac{2}{{t}^{3}})\\,k \\\\  & =-\\frac{3}{\\sqrt{1-9{t}^{2}}}\\,i-20{t}^{3}\\,j-\\frac{6}{{t}^{4}}\\,k\\end{aligned}\n$$",
      "calculator_instructions": "",
