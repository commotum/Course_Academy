}^{5-2t}\\,i+\\operatorname{sin}⁡(3t)\\,j-3{t}^{4}\\,k.$\n\n${f}^{″}(t)=$\n{{field-1}}\n$i\\,\\,-$\n{{field-2}}\n$j\\,\\,-$\n{{field-3}}\n$k$" :question/worked-solution "First, we find the derivative of $f(t)$ by differentiating each component:\n\n$$\n\\begin{aligned}{f}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({e}^{5-2t})\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡(3t))\\,j+\\frac{\\text{d}}{\\text{d}t}(-3{t}^{4})\\,k \\\\  & =-2{e}^{5-2t}\\,i+3\\operatorname{cos}⁡(3t)\\,j-12{t}^{3}\\,k\\end{aligned}\n$$\n\n  \n\nThen, we calculate ${f}^{″}(t)$ by differentiating ${f}^{′}(t):$\n\n$$\n\\begin{aligned}{f}^{″}(t) & =\\frac{\\text{d}}{\\text{d}t}(-2{e}^{5-2t})\\,i+\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{cos}⁡(3t))\\,j+\\frac{\\text{d}}{\\text{d}t}(-12{t}^{3})\\,k \\\\  & =-2(-2{e}^{5-2t})\\,i+3(-3\\operatorname{sin}⁡(3t))\\,j-12(3{t}^{2})\\,k \\\\  & =4{e}^{5-2t}\\,i-9\\operatorname{sin}⁡(3t)\\,j-36{t}^{2}\\,k\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186501147 :knowledge-point/_questions [{:db/id #edb/ref 17592186198355 :knowledge-point/id #uuid "072ad553-dd0b-58e0-b3e2-082c6d9866dd" :knowledge-point/title "Finding the Derivative of a Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6736b43c-00dc-58a4-b07e-13bb811a478e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12{t}^{3}-7" :db/id #edb/ref 17592186500683}] :answer-field/correct {:answer/id #uuid "6736b43c-00dc-58a4-b07e-13bb811a478e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12{t}^{3}-7" :db/id #edb/ref 17592186500683} :answer-field/id #uuid "076d86ba-a029-593b-a409-24685a0fec46" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186501017} {:answer-field/choices [{:answer/id #uuid "c6135c28-1b5c-55ad-9ba6-dfb9a75e1b3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\operatorname{cos}⁡t" :db/id #edb/ref 17592186500888}] :answer-field/correct {:answer/id #uuid "c6135c28-1b5c-55ad-9ba6-dfb9a75e1b3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\operatorname{cos}⁡t" :db/id #edb/ref 17592186500888} :answer-field/id #uuid "b0c96d28-1366-5868-a326-9af707a402ca" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186501098}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "19691404-0bb9-5165-a3cc-ce9a79557b1b" :question/math-academy-id "q-349464" :question/problem "Given that $r(t)=⟨3{t}^{4}-7t+1,\\,8\\operatorname{sin}⁡t⟩,$ what is ${r}^{′}(t)?$\n\n${r}^{′}(t)=⟨${{field-1}}$,$\n{{field-2}}$⟩$" :question/worked-solution "We differentiate each component separately.\n\n- For the $x$-component $x(t)=3{t}^{4}-7t+1,$ we have\n\n$$\n{x}^{′}(t)=12{t}^{3}-7.\n$$\n\n- For the $y$-component $y(t)=8\\operatorname{sin}⁡t,$ we have\n\n$$\n{y}^{′}(t)=8\\operatorname{cos}⁡t.\n$$\n\nSo, we conclude that\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨{x}^{′}(t),\\,{y}^{′}(t)⟩ \\\\  & =⟨12{t}^{3}-7,\\,8\\operatorname{cos}⁡t⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186501223 :knowledge-point/_questions [{:db/id #edb/ref 17592186198355 :knowledge-point/id #uuid "072ad553-dd0b-58e0-b3e2-082c6d9866dd" :knowledge-point/title "Finding the Derivative of a Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e8ebedb0-f624-5092-8452-0e8ea51ac053" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2t+4" :db/id #edb/ref 17592186500964}] :answer-field/correct {:answer/id #uuid "e8ebedb0-f624-5092-8452-0e8ea51ac053" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2t+4" :db/id #edb/ref 17592186500964} :answer-field/id #uuid "41888a9a-6