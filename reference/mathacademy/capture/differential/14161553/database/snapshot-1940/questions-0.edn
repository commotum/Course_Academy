#{[{:db/id #edb/ref 17592186486430 :knowledge-point/_questions [{:db/id #edb/ref 17592186162120 :knowledge-point/id #uuid "d3e51358-060a-5117-bd7d-8909e695af48" :knowledge-point/title "Applying the Rule to Continuous Random Variables: Non-Rectangular Domains"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15d62574-5135-5ee2-98ac-fbd52149ff4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2}+\\frac{2}{3}e" :db/id #edb/ref 17592186485802} {:answer/id #uuid "3c8fc363-c3d7-5b52-8ce7-0c5155a2ede2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{4}}{3}-{e}^{2}+\\frac{2}{3}e" :db/id #edb/ref 17592186485881} {:answer/id #uuid "4c27f43c-7bf7-5350-bb36-6f94522b814a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{4}+2{e}^{2}-3" :db/id #edb/ref 17592186485904} {:answer/id #uuid "66876a52-b756-5569-ad24-5c61115dd2fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{4}}{3}+\\frac{2}{3}e" :db/id #edb/ref 17592186485939} {:answer/id #uuid "c1a0be36-7fd5-5956-bc6c-39bb19ba46df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{4}}{3}-{e}^{2}" :db/id #edb/ref 17592186486112}] :answer-field/correct {:answer/id #uuid "3c8fc363-c3d7-5b52-8ce7-0c5155a2ede2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{4}}{3}-{e}^{2}+\\frac{2}{3}e" :db/id #edb/ref 17592186485881} :answer-field/id #uuid "da8d8e35-f3a0-568a-a543-4b0ff0ce195c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186486330}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b6992831-85a4-570c-8e6c-b6898df7292a" :question/math-academy-id "q-143834" :question/problem "Find $\\text{E}[XY],$ given that random variables $X$ and $Y$ have the joint probability density function\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{2}{3xy},\\, & 1\\le x\\le y,\\,e\\le y\\le {e}^{2}, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$" :question/worked-solution "Suppose $X$ and $Y$ are continuous random variables, and $f(x,y)$ is their joint probability density function. If $r:{R}^{2}\\to R$ is a function of two variables, then the rule of the lazy statistician states that\n\n$$\n\\text{E}[r(X,Y)]={∬}_{{R}^{2}}r(x,y)\\,f(x,y)\\,\\text{d}x\\text{d}y.\n$$\n\nIn our case, we have\n\n$$\nr(x,y)=xy.\n$$\n\nNow, let's sketch the region $D=\\{(x,y)\\,:\\,1\\le x\\le y,\\,e\\le y\\le {e}^{2}\\},$ where $f(x,y)$ is nonzero.\n\n![](images/09/09bf58b8505f860709d705f128b2bafbd6916382de56ba66d26a1a56319f0141.png)\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{E}[XY] & ={∬}_{{R}^{2}}xy\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={∬}_{D}xy\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{e}^{{e}^{2}}{\\int }_{1}^{y}xy\\cdot \\frac{2}{3xy}\\,\\text{d}x\\,\\text{d}y \\\\  & =\\frac{2}{3}{\\int }_{e}^{{e}^{2}}{\\int }_{1}^{y}\\,\\text{d}x\\,\\text{d}y \\\\  & =\\frac{2}{3}{\\int }_{e}^{{e}^{2}}[x]_{x=1}^{x=y}\\,\\text{d}y \\\\  & =\\frac{2}{3}{\\int }_{e}^{{e}^{2}}(y-1)\\text{d}y \\\\  & =\\frac{2}{3}{[\\frac{{y}^{2}}{2}-y]}_{y=e}^{y={e}^{2}} \\\\  & =\\frac{2}{3}[(\\frac{{e}^{4}}{2}-{e}^{2})-(\\frac{{e}^{2}}{2}-e)] \\\\  & =\\frac{2}{3}(\\frac{{e}^{4}}{2}-\\frac{3}{2}{e}^{2}+e) \\\\  & =\\frac{{e}^{4}}{3}-{e}^{2}+\\frac{2}{3}e.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186162403 :knowledge-point/_questions [{:db/id #edb/ref 17592186162117 :knowledge-point/id #uuid "600fd48d-930b-5f4e-b800-8992ab381285" :knowledge-point/title "Applying the Rule to Discrete Random Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87e9c4d4-14b3-51b0-b290-b89ce0ce0dbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.8" :db/id #edb/ref 17592186159621} {:answer/id #uuid "a5f47d6f-1f84-515e-a1ec-853f89053fb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.2" :db/id #edb/ref 17592186159622} {:answer/id #uuid "ad352708-8b1e-5672-99f1-d1293ac8dd12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.3" :db/id #edb/ref 17592186159623} {:answer/id #uuid "d25fd0d4-015b-53bd-8e65-b4c85b429335" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.4" :db/id #edb/ref 17592186159624} {:answer/id #uuid "19d24784-01d9-52ac-9f78-d050b184581a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.6" :db/id #edb/ref 17592186159625}] :answer-field/correct {:answer/id #uuid "a5f47d6f-1f84-515e-a1ec-853f89053fb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.2" :db/id #edb/ref 17592186159622} :answer-field/id #uuid "b33b66d4-6aaa-597a-952b-62ceedec3c9d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186159620}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ec7f3a9c-e00e-51eb-a0a7-9ea186999fce" :question/math-academy-id "q-143861" :question/problem "The joint probability mass function $f(x,y)$ for the discrete random variables $X$ and $Y$ is given in the table below. Find $\\text{E}[X{e}^{Y}].$\n\n| $f$ | $Y=0$ | $Y=\\operatorname{ln}⁡3$ |\n| --- | --- | --- |\n| $X=1$ | $0.3$ | $0.1$ |\n| $X=2$ | $0.5$ | $0.1$ |" :question/requires-calculator true :question/worked-solution "Suppose $X$ and $Y$ are discrete random variables with supports ${S}_{X}$ and ${S}_{Y},$ respectively, and $f(x,y)$ is their joint probability mass function with support $S={S}_{X}\\times {S}_{Y}.$ If $r:{R}^{2}\\to R$ is a function of two variables, then the rule of the lazy statistician states that\n\n$$\n\\text{E}[r(X,Y)]={\\sum }_{(x,y)\\in S}r(x,y)\\,f(x,y).\n$$\n\nIn our case, we have\n\n$$\nr(x,y)=x{e}^{y}.\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{E}[X{e}^{Y}] & ={\\sum }_{(x,y)\\in S}r(x,y)\\,f(x,y) \\\\  & =(1\\cdot {e}^{0})\\cdot f(1,0)+(1\\cdot {e}^{\\operatorname{ln}⁡3})\\cdot f(1,\\operatorname{ln}⁡3)+(2\\cdot {e}^{0})\\cdot f(2,0)+(2\\cdot {e}^{\\operatorname{ln}⁡3})\\cdot f(2,\\operatorname{ln}⁡3) \\\\  & =1\\cdot f(1,0)+3\\cdot f(1,\\operatorname{ln}⁡3)+2\\cdot f(2,0)+6\\cdot f(2,\\operatorname{ln}⁡3) \\\\  & =1\\cdot 0.3+3\\cdot 0.1+2\\cdot 0.5+6\\cdot 0.1 \\\\  & =0.3+0.3+1+0.6 \\\\  & =2.2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186162404 :knowledge-point/_questions [{:db/id #edb/ref 17592186162120 :knowledge-point/id #uuid "d3e51358-060a-5117-bd7d-8909e695af48" :knowledge-point/title "Applying the Rule to Continuous Random Variables: Non-Rectangular Domains"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c1c0b73-5ac1-5777-bfdf-58a4281c67b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{243}{4}" :db/id #edb/ref 17592186159627} {:answer/id #uuid "9bcad6a1-0066-5ef5-bcff-fc5fb045253b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{729}{8}" :db/id #edb/ref 17592186159628} {:answer/id #uuid "f6a4ab47-6d4d-5808-9250-ca3607411754" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{81}{8}" :db/id #edb/ref 17592186159629} {:answer/id #uuid "47618d4a-1e91-5292-bb29-a4af40c4182f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186159630} {:answer/id #uuid "50715a91-1def-5134-8929-3c112d077fa5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{27}{4}" :db/id #edb/ref 17592186159631}] :answer-field/correct {:answer/id #uuid "9bcad6a1-0066-5ef5-bcff-fc5fb045253b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{729}{8}" :db/id #edb/ref 17592186159628} :answer-field/id #uuid "3a3029e5-63e4-5b34-a3fc-488089fe2e1a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186159626}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dae29a86-3127-5375-982e-23502adaa206" :question/math-academy-id "q-143870" :question/problem "Find $\\text{E}[X{Y}^{3}],$ given that random variables $X$ and $Y$ have the joint probability density function\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{2}{9{y}^{2}},\\, & 0\\le x\\le {y}^{3},\\,0\\le y\\le 3; \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$" :question/worked-solution "Suppose $X$ and $Y$ are continuous random variables, and $f(x,y)$ is their joint probability density function. If $r:{R}^{2}\\to R$ is a function of two variables, then the rule of the lazy statistician states that\n\n$$\n\\text{E}[r(X,Y)]={∬}_{{R}^{2}}r(x,y)\\,f(x,y)\\,\\text{d}x\\text{d}y.\n$$\n\nIn our case, we have\n\n$$\nr(x,y)=x{y}^{3}.\n$$\n\nNow, let's sketch the region $D=\\{(x,y)\\,:\\,0\\le x\\le {y}^{3},\\,0\\le y\\le 3\\},$ where $f(x,y)$ is nonzero.\n\n![](images/68/68da52d856f882614241d72cff4dc3f5947cf16a6c9f58b0aea1c58d7eb375cc.png)\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{E}[X{Y}^{3}] & ={∬}_{{R}^{2}}x{y}^{3}\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={∬}_{D}x{y}^{3}\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{0}^{3}{\\int }_{0}^{{y}^{3}}x{y}^{3}\\cdot \\frac{2}{9{y}^{2}}\\,\\text{d}x\\,\\text{d}y \\\\  & =\\frac{2}{9}{\\int }_{0}^{3}y{\\int }_{0}^{{y}^{3}}x\\,\\text{d}x\\,\\text{d}y \\\\  & =\\frac{2}{9}{\\int }_{0}^{3}y{[\\frac{{x}^{2}}{2}]}_{x=0}^{x={y}^{3}}\\,\\text{d}y \\\\  & =\\frac{1}{9}{\\int }_{0}^{3}{y}^{7}\\text{ }\\text{d}y \\\\  & =\\frac{1}{9}{[\\frac{{y}^{8}}{8}]}_{y=0}^{y=3} \\\\  & =\\frac{1}{9}(\\frac{{3}^{8}}{8}) \\\\  & =\\frac{729}{8}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186486383 :knowledge-point/_questions [{:db/id #edb/ref 17592186162118 :knowledge-point/id #uuid "a64476b6-48ab-5533-8274-364a5decb3c2" :knowledge-point/title "Applying the Rule to Continuous Random Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04917684-3038-5e71-9f60-4e0cd96fb9d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186485775} {:answer/id #uuid "2fde4923-7da4-5a76-9103-bb5dec58b09a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186485855} {:answer/id #uuid "8db935a4-9e65-5534-8fcb-a44043a7dd25" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186486017} {:answer/id #uuid "9f2c9a38-93c6-5b27-b1f9-4d8c6ff8fdbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186486049} {:answer/id #uuid "fa2609b5-9caa-53f9-aea8-d0a896aed0e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186486217}] :answer-field/correct {:answer/id #uuid "fa2609b5-9caa-53f9-aea8-d0a896aed0e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186486217} :answer-field/id #uuid "c4ad49b2-0cc7-539b-b32f-b7d844fbe92b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186486318}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "55430d88-2391-56d3-99b1-0b7835164965" :question/math-academy-id "q-143874" :question/problem "Find $\\text{E}[\\frac{1}{XY}],$ given that random variables $X$ and $Y$ have the joint probability density function\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{3}{4}{x}^{2}{y}^{3},\\, & 0<x<1,\\,0<y<2, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$" :question/worked-solution "Suppose $X$ and $Y$ are continuous random variables, and $f(x,y)$ is their joint probability density function. If $r:{R}^{2}\\to R$ is a function of two variables, then the rule of the lazy statistician states that\n\n$$\n\\text{E}[r(X,Y)]={∬}_{{R}^{2}}r(x,y)\\,f(x,y)\\,\\text{d}x\\text{d}y.\n$$\n\nIn our case, we have\n\n$$\nr(x,y)=\\frac{1}{xy}.\n$$\n\nNotice that $f(x,y)$ is nonzero only in the rectangular region $D=\\{(x,y)\\,:\\,0\\le x\\le 1,\\,0\\le y\\le 2\\}.$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{E}[\\frac{1}{XY}] & ={∬}_{{R}^{2}}\\frac{1}{xy}\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={∬}_{D}\\frac{1}{xy}\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1}\\frac{1}{xy}\\cdot \\frac{3}{4}{x}^{2}{y}^{3}\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{2}\\frac{3}{4}{y}^{2}{\\int }_{0}^{1}x\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{2}\\frac{3}{4}{y}^{2}{[\\frac{{x}^{2}}{2}]}_{0}^{1}\\,\\text{d}y \\\\  & ={\\int }_{0}^{2}\\frac{3{y}^{2}}{8}\\,\\text{d}y \\\\  & =[\\frac{{y}^{3}}{8}]_{0}^{2} \\\\  & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186486412 :knowledge-point/_questions [{:db/id #edb/ref 17592186162120 :knowledge-point/id #uuid "d3e51358-060a-5117-bd7d-8909e695af48" :knowledge-point/title "Applying the Rule to Continuous Random Variables: Non-Rectangular Domains"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "229eafe1-24fb-552a-9117-a7fa14447b18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{121}{2}" :db/id #edb/ref 17592186485822} {:answer/id #uuid "55f3e41b-c1ec-5a55-bfc6-d4f47c03e528" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{363}{4}" :db/id #edb/ref 17592186485916} {:answer/id #uuid "77fbb658-cabf-571c-998f-24429c73e55e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{121}{10}" :db/id #edb/ref 17592186485974} {:answer/id #uuid "881a60af-adf5-5e87-afec-cbdae3c947af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{52}{3}" :db/id #edb/ref 17592186486004} {:answer/id #uuid "e5aa2ec3-55fd-5125-8765-b0a5ef54e5b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{363}{2}" :db/id #edb/ref 17592186486185}] :answer-field/correct {:answer/id #uuid "77fbb658-cabf-571c-998f-24429c73e55e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{121}{10}" :db/id #edb/ref 17592186485974} :answer-field/id #uuid "e4dfdca8-bd20-538c-8d34-664a31d6e354" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186486335}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8f9d70b5-8ba3-5fd2-851b-442924453b0a" :question/math-academy-id "q-143891" :question/problem "Find $\\text{E}[X+3{Y}^{2}],$ given that random variables $X$ and $Y$ have the joint probability density function\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{2}{15},\\, & 0\\le x\\le 3,\\,\\frac{x}{3}\\le y\\le 3; \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$" :question/worked-solution "Suppose $X$ and $Y$ are continuous random variables, and $f(x,y)$ is their joint probability density function. If $r:{R}^{2}\\to R$ is a function of two variables, then the rule of the lazy statistician states that\n\n$$\n\\text{E}[r(X,Y)]={∬}_{{R}^{2}}r(x,y)\\,f(x,y)\\,\\text{d}x\\text{d}y.\n$$\n\nIn our case, we have\n\n$$\nr(x,y)=x+3{y}^{2}.\n$$\n\nNow, let's sketch the region $D=\\{(x,y)\\,:\\,0\\le x\\le 3,\\,\\frac{x}{3}\\le y\\le 3\\},$ where $f(x,y)$ is nonzero.\n\n![](images/bc/bc454de7a5ef0a9b0e2620bb44a0d0b481638ca04905bf6d986a52715a95c3db.png)\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{E}[X+3{Y}^{2}] & ={∬}_{{R}^{2}}(x+3{y}^{2})\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={∬}_{D}(x+3{y}^{2})\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{0}^{3}{\\int }_{x/3}^{3}(x+3{y}^{2})\\cdot \\frac{2}{15}\\,\\text{d}y\\,\\text{d}x \\\\  & =\\frac{2}{15}{\\int }_{0}^{3}[xy+{y}^{3}]_{y=x/3}^{y=3}\\,\\text{d}x \\\\  & =\\frac{2}{15}{\\int }_{0}^{3}[3x+27-\\frac{{x}^{2}}{3}-\\frac{{x}^{3}}{27}]\\,\\text{d}x \\\\  & =\\frac{2}{15}{[\\frac{3}{2}{x}^{2}+27x-\\frac{{x}^{3}}{9}-\\frac{{x}^{4}}{108}]}_{x=0}^{x=3} \\\\  & =\\frac{2}{15}[\\frac{27}{2}+81-3-\\frac{3}{4}] \\\\  & =\\frac{363}{30} \\\\  & =\\frac{121}{10}.\\end{aligned}\n$$"}]}
