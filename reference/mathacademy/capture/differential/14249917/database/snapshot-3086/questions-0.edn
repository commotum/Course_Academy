}$ | $\\text{T}$ | $\\text{T}$ |\n| $\\text{T}$ | $\\text{F}$ | $\\text{T}$ | $\\text{F}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{T}$ | $\\text{T}$ | $\\text{F}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{F}$ | $\\text{F}$ | $\\text{F}$ | $\\text{F}$ |"}] [{:db/id #edb/ref 17592186572192 :knowledge-point/_questions [{:db/id #edb/ref 17592186198250 :knowledge-point/id #uuid "f14ab339-1aa8-51a1-ac86-dc780120657c" :knowledge-point/title "Completing a Truth Table for a Compound Statement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86b21a0b-305b-5ae7-98fb-cdfefbb8ad95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{F}" :db/id #edb/ref 17592186571770} {:answer/id #uuid "b99feb04-578a-5a4e-b242-dbc726999685" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{T}" :db/id #edb/ref 17592186571867}] :answer-field/correct {:answer/id #uuid "b99feb04-578a-5a4e-b242-dbc726999685" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{T}" :db/id #edb/ref 17592186571867} :answer-field/id #uuid "1ad6ce46-eaef-5d97-a0e5-89ca0748ff9c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186571993} {:answer-field/choices [{:answer/id #uuid "3667e379-779b-50d7-9b55-fd10bb665783" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{F}" :db/id #edb/ref 17592186571635} {:answer/id #uuid "bad54385-b42c-5e08-89cb-4c777562e235" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{T}" :db/id #edb/ref 17592186571871}] :answer-field/correct {:answer/id #uuid "bad54385-b42c-5e08-89cb-4c777562e235" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{T}" :db/id #edb/ref 17592186571871} :answer-field/id #uuid "86071375-1bf2-5750-881