ld-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186572084} {:answer-field/choices [{:answer/id #uuid "85fb08d5-61cf-5a37-97cc-16103e574535" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{T}" :db/id #edb/ref 17592186571768} {:answer/id #uuid "ce1fb4ab-22c7-55a5-a431-900a8e9db511" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{F}" :db/id #edb/ref 17592186571910}] :answer-field/correct {:answer/id #uuid "ce1fb4ab-22c7-55a5-a431-900a8e9db511" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{F}" :db/id #edb/ref 17592186571910} :answer-field/id #uuid "ff31c793-d272-5b5a-84c4-702d95e9a393" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186572106}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "197b2260-e498-5693-bf75-d3ebdb0f1d7f" :question/math-academy-id "q-182405" :question/problem "Find the missing values in the following truth table:\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,((A∧B)∨A)∧B\\,$ |\n| --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | {{field-1}} |\n| $\\text{T}$ | $\\text{F}$ | {{field-2}} |\n| $\\text{F}$ | $\\text{T}$ | {{field-3}} |\n| $\\text{F}$ | $\\text{F}$ | {{field-4}} |" :question/worked-solution "First, we complete a truth table for the part in the inner-most parentheses, $A∧B.$ The statement $A∧B$ is true if both $A$ and $B$ are true.\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,A∧B\\,$ |\n| --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | $\\text{T}$ |\n| $\\text{T}$ | $\\text{F}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{T}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{F}$ | $\\text{F}$ |\n\nNext, we look at the columns labeled $A$ and $A∧B$ to complete a truth table for the part in the parentheses, $(A∧B)∨A.$ The statement $(A∧B)∨A$ is true if either $A∧B$ is true, $A$ is true, or both $A∧B$ and $A$ are true.\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,A∧B\\,$ | $\\,(A∧B)∨A\\,$ |\n| --- | --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | $\\text{T}$ | $\\text{T}$ |\n| $\\text{T}$ | $\\text{F}$ | $\\text{F}$ | $\\text{T}$ |\n| $\\text{F}$ | $\\text{T}$ | $\\text{F}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{F}$ | $\\text{F}$ | $\\text{F}$ |\n\nFinally, we look at the columns labeled $B$ and $(A∧B)∨A$ to complete the column $((A∧B)∨A)∧B.$ The statement $((A∧B)∨A)∧B$ is true if both $(A∧B)∨A$ and $B$ are true.\n\nThe completed truth table is shown below:\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,A∧B\\,$ | $\\,(A∧B)∨A\\,$ | $\\,((A∧B)∨A)∧B\\,$ |\n| --- | --- | --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | $\\text{T}$ | $\\text{T}$ | $\\text{T}$ |\n| $\\text{T}$ | $\\text{F}$ | $\\text{F}$ | $\\text{T}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{T}$ | $\\text{F}$ | $\\text{F}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{F}$ | $\\text{F}$ | $\\text{F}$ | $\\text{F}$ |"}] [{:db/id #edb/ref 17592186572184 :knowledge-point/_questions [{:db/id #edb/ref 17592186198249 :knowledge-point/id #uuid "21fd31e7-1eed-5dad-aff2-691ba1737b92" :knowledge-point/title "Completing a Truth Table"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "82e794bc-9177-5423-8c01-49887be1677a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{F}" :db/id #edb/ref 17592186571761} {:answer/id #uuid "f7b492e4-9e47-5db4-ac6d-a3dc6bbed3a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{T}" :db/id #edb/ref 17592186571965}] :answer-field/correct {:answer/id #uuid "f7b492e4-9e47-5db4-ac6d-a3dc6bbed3a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{T}" :db/id #edb/ref 17592186571965} :answer-field/id #uuid "2ba19352-5fe4-5180-b3e2-c7521e2de411" :answer-field/key "field-2" :ans