#{[{:db/id #edb/ref 17592186262934 :knowledge-point/_questions [{:db/id #edb/ref 17592186124475 :knowledge-point/id #uuid "74f126da-5f3b-5af8-9aee-d6f0a4c61c49" :knowledge-point/title "Determining the Shape of a Level Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "179db532-d9e6-5e2e-91f3-aade01e0ddb0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463676} {:answer/id #uuid "b3485b61-e757-5360-a24b-e5e8e1510cb3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463677}] :answer-field/correct {:answer/id #uuid "179db532-d9e6-5e2e-91f3-aade01e0ddb0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463676} :answer-field/id #uuid "cd745651-984a-5d60-a190-cb171692cead" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464772} {:answer-field/choices [{:answer/id #uuid "05537b17-7ec7-5fc9-bc2c-6afa58fbf701" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463678} {:answer/id #uuid "503c7eee-dfea-59ab-9897-fba0a24aa061" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463679}] :answer-field/correct {:answer/id #uuid "05537b17-7ec7-5fc9-bc2c-6afa58fbf701" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463678} :answer-field/id #uuid "538c309f-7174-5be3-8c40-ec951dfef7f2" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464773} {:answer-field/choices [{:answer/id #uuid "b488c30c-d8bb-5f46-b3aa-6f3e7348f877" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463680} {:answer/id #uuid "0377582f-387c-5883-9a77-bf51a5c48a80" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463681}] :answer-field/correct {:answer/id #uuid "b488c30c-d8bb-5f46-b3aa-6f3e7348f877" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463680} :answer-field/id #uuid "7bce9543-3652-5444-87d3-b92041c327f4" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464774}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9b3926e5-b3cd-5c3a-a183-ad2104ed74d9" :question/math-academy-id "q-129062" :question/problem "The level curves of the function $f(x,y)=\\frac{{y}^{2}}{{x}^{2}+{y}^{2}}$ are given by $f(x,y)=c.$ Which of the following statements are true?\n- **I.** $c=0$ gives a parabola\n- **II.** $c=1$ gives an ellipse\n- **III.** $c=2$ gives a hyperbola\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Setting $f(x,y)=c$ gives:\n\n$$\n\\begin{aligned}\\frac{{y}^{2}}{{x}^{2}+{y}^{2}} & =c \\\\ {y}^{2} & =c({x}^{2}+{y}^{2}) \\\\ c{x}^{2}+(c-1){y}^{2} & =0\\end{aligned}\n$$\n\nTherefore:\n\n- If $c=0,$ the level curve is the line $y=0,$ which is the $x$-axis. So, I is false.\n\n- If $c=1,$ the level curve is the line $x=0,$ which is the $y$-axis. So, II is false.\n\n- If $c=2,$  then we obtain \n\n$$\n\\frac{{y}^{2}}{{x}^{2}+{y}^{2}}=2\\,⟹\\,2{x}^{2}+{y}^{2}=0.\n$$\n\nHowever, the only real solution to this equation is  $(x,y)=(0,0),$ which is not in the domain of $f(x,y)$ because it would result in division by zero. Thus, III is false.\n\nSo, the correct answer is \"None of the listed\"."}] [{:db/id #edb/ref 17592186530432 :knowledge-point/_questions [{:db/id #edb/ref 17592186124475 :knowledge-point/id #uuid "74f126da-5f3b-5af8-9aee-d6f0a4c61c49" :knowledge-point/title "Determining the Shape of a Level Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49976768-431c-507e-a6c7-d2d95eebbbf7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II and III" :db/id #edb/ref 17592186529754} {:answer/id #uuid "58bb366b-a9d7-55ba-9cad-0fd6b63a25f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186529793} {:answer/id #uuid "5b93773f-b140-52dc-ab08-af172348d56d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186529801} {:answer/id #uuid "e0f729d2-960c-5f9c-be65-97c3cbad4b0c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186530141} {:answer/id #uuid "e73ba0dc-dc17-54e6-8c52-71c213062fd1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186530158}] :answer-field/correct {:answer/id #uuid "5b93773f-b140-52dc-ab08-af172348d56d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186529801} :answer-field/id #uuid "90762acc-754a-5149-93b4-5bc79b9c05e9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186530328}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "20cfcb32-46de-59b7-8990-d20e7a58a53a" :question/math-academy-id "q-36467" :question/problem "The level curves of the function $f(x,y)=4{x}^{2}-{y}^{2}$ are given by $f(x,y)=c.$ Which of the following statements are true?\n\nI. $c=0$ gives two lines\n\nII. $c=1$ gives a circle\n\nIII. $c=2$ gives a hyperbola" :question/worked-solution "Setting $f(x,y)=c$ gives:\n\n$$\n\\begin{aligned}4{x}^{2}-{y}^{2} & =c\\end{aligned}\n$$\n\nTherefore:\n\n- If $c=0$ the level curves are $y=\\pm 2x,$ which consists of two lines.\n\n- If $c=1$ the level curve is $4{x}^{2}-{y}^{2}=1,$ which is a hyperbola.\n\n- If $c=2$ the level curve is $2{x}^{2}-\\frac{{y}^{2}}{2}=1,$ which is a hyperbola.\n\nSo, only statements I and III are true."}] [{:db/id #edb/ref 17592186530438 :knowledge-point/_questions [{:db/id #edb/ref 17592186124476 :knowledge-point/id #uuid "dfd8982d-d859-5eb2-9f35-69af39c04822" :knowledge-point/title "Sketching Level Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5b8518d8-9401-5fbb-80b4-3637c13a5c3f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/84/844b92278c8b945a68104629b8dcb14d1b41c6875677ffda4da9615363e55221.png" :db/id #edb/ref 17592186529800} {:answer/id #uuid "af41d1db-4df3-5f82-8a52-be9e6a8e128a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/82/824e2fb10927e9ac63fc6e57c15efb94af3100d89a06db8bad63752e232e5a7b.png" :db/id #edb/ref 17592186530017} {:answer/id #uuid "f7438267-12f3-5bc5-8c7f-3213295c7e92" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/92/9259f6992539edaa9997b167a894fcd8f60ec25978a6bf0c6d7e70b46a5bc056.png" :db/id #edb/ref 17592186530194} {:answer/id #uuid "f930bbbc-48b4-54bf-8000-807c4b6018dc" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/fa/fa880cc10c7f9f1532e4fd92093b8d9ff47ab32a220a2c4277ecccabb6788334.png" :db/id #edb/ref 17592186530198} {:answer/id #uuid "f978f806-3849-540f-afee-4d73d3644018" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/81/81e763cf8b1bf3a6cd2681876642778e97eb4db915373cd07149c42b2e424c65.png" :db/id #edb/ref 17592186530199}] :answer-field/correct {:answer/id #uuid "5b8518d8-9401-5fbb-80b4-3637c13a5c3f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/84/844b92278c8b945a68104629b8dcb14d1b41c6875677ffda4da9615363e55221.png" :db/id #edb/ref 17592186529800} :answer-field/id #uuid "41ce99e3-3910-54c5-acc5-a4b9b347da9d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186530264}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "248c7282-1f4b-5be4-93d4-cb424b9138b8" :question/math-academy-id "q-64978" :question/problem "![](images/63/634a863f2154398762af17da40b22d303b10b8846c90fa2021148779e1d1fa97.png)\n\nWhich of the following could represent the level curves of the surface $z=2{x}^{2}$ shown above?" :question/worked-solution "First, notice that the range of $f(x,y)$ is $[0,\\infty ).$ So, we will consider only $c$-level curves for $c\\ge 0.$\n\nThe level curves for the function $f(x,y)$ are given by the equations \n\n$$\nf(x,y)=c.\n$$\n\nTherefore, we have:\n\n$$\n\\begin{aligned}f(x,y) & =c \\\\ 2{x}^{2} & =c \\\\ x & =\\pm \\sqrt{\\frac{c}{2}}\\end{aligned}\n$$\n\nNotice that in the equations $x=\\pm \\sqrt{\\frac{c}{2}}$ do not depend on $y.$ So, for a given $c\\ge 0$, the right-hand side of the equation is constant. As a result, we obtain a family of vertical lines, as shown below.\n\n$$\n\n$$\n\n![](images/84/844b92278c8b945a68104629b8dcb14d1b41c6875677ffda4da9615363e55221.png)"}] [{:db/id #edb/ref 17592186338935 :knowledge-point/_questions [{:db/id #edb/ref 17592186124475 :knowledge-point/id #uuid "74f126da-5f3b-5af8-9aee-d6f0a4c61c49" :knowledge-point/title "Determining the Shape of a Level Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "97b5337a-3e06-5fca-8dee-9ccb9bb3e791" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467842} {:answer/id #uuid "ca10f725-532e-52f8-b216-80660df1aff0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467843}] :answer-field/correct {:answer/id #uuid "97b5337a-3e06-5fca-8dee-9ccb9bb3e791" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467842} :answer-field/id #uuid "6f26b394-09a9-58cd-8127-d23fbca6af8c" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468642} {:answer-field/choices [{:answer/id #uuid "572c0f09-8cda-57e4-84ee-e9bf11b0969a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467844} {:answer/id #uuid "3debfd10-6252-58a8-80d0-0fe4ad6b3d4c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467845}] :answer-field/correct {:answer/id #uuid "3debfd10-6252-58a8-80d0-0fe4ad6b3d4c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467845} :answer-field/id #uuid "a4b044d1-ec5c-5118-ba8c-99f2a5e9c147" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468643} {:answer-field/choices [{:answer/id #uuid "d92d5ae0-bdbf-5aac-a192-d4634abd4820" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467846} {:answer/id #uuid "80aced54-71e3-53cc-8d38-ae55e211374c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467847}] :answer-field/correct {:answer/id #uuid "80aced54-71e3-53cc-8d38-ae55e211374c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467847} :answer-field/id #uuid "7551102b-2721-527c-a9e6-1c6948d2bf34" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468644}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e04ff7ee-ed94-5861-b7e8-a3f79254490c" :question/math-academy-id "q-71391" :question/problem "For the function $f(x,y)=\\frac{2{x}^{2}+3{y}^{2}-4}{{y}^{2}}$, clear the denominator in $f(x,y)=c$ and classify the resulting conic equation in the entire $xy$-plane, including points excluded from the function's domain. Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $c=3$ gives a hyperbola\n- **II.** $c=0$ gives an ellipse\n- **III.** $c=1$ gives a circle" :question/worked-solution "Setting $f(x,y)=c$ gives:\n\n$$\n\\begin{aligned}\\frac{2{x}^{2}+3{y}^{2}-4}{{y}^{2}} & =c \\\\ 2{x}^{2}+3{y}^{2}-4 & =c{y}^{2} \\\\ 2{x}^{2}+(3-c){y}^{2} & =4\\end{aligned}\n$$\n\nTherefore:\n\n- If $c=3$ then the level curves are $x=\\pm \\sqrt{2},$ which consists of two vertical lines.\n\n- If $c=0$ then the level curve is $2{x}^{2}+3{y}^{2}=4,$ which is an ellipse.\n\n- If $c=1$ then the level curve is ${x}^{2}+{y}^{2}=2,$ which is a circle.\n\nSo, only statements II and III are true."}] [{:db/id #edb/ref 17592186379910 :knowledge-point/_questions [{:db/id #edb/ref 17592186124476 :knowledge-point/id #uuid "dfd8982d-d859-5eb2-9f35-69af39c04822" :knowledge-point/title "Sketching Level Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8f17d518-60b8-544c-92f5-2cf0aab0557b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/65/6521da99a82e38a68a5aa87a0c7c88eacf4ed7b78351af594ec309fa2cb7f57b.png" :db/id #edb/ref 17592186379912} {:answer/id #uuid "6196a8f6-ab71-5465-a24f-af55f550e44b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/cc/cccaa6d7f554076b3a79364e1f2c4c061ae7cd86f7f0064e3861ba3b035b6a3e.png" :db/id #edb/ref 17592186379913} {:answer/id #uuid "0f21dd87-4625-5c1a-ad37-6386c8fedd7d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/7c/7c4530dc74747fc0bdae0ca4c8608a72dbf03ca413d4479c8a4b9224246ac01f.png" :db/id #edb/ref 17592186379914} {:answer/id #uuid "fcc62c66-3d50-525b-b466-4341bcf3773b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/7a/7ab95ed367277627d5baf535db74994d7d02cd41deae939d76ed08e22799ff40.png" :db/id #edb/ref 17592186379915} {:answer/id #uuid "32bd84ff-54ed-577c-bae9-a5c917d68e95" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/1b/1b1cd5983d4a19990cc5e82726bb8cd8101dbab0f2dc7c9934a64c45e6126ee4.png" :db/id #edb/ref 17592186379916}] :answer-field/correct {:answer/id #uuid "6196a8f6-ab71-5465-a24f-af55f550e44b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/cc/cccaa6d7f554076b3a79364e1f2c4c061ae7cd86f7f0064e3861ba3b035b6a3e.png" :db/id #edb/ref 17592186379913} :answer-field/id #uuid "15955093-e5c1-50f6-b2be-d700cd4f9e99" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186379911}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "94f47fe3-89d1-5943-be21-5cabcd5b8b5e" :question/math-academy-id "q-71409" :question/problem "Which of the following represents the level curves of $f(x,y)=\\sqrt{3{x}^{2}+2{y}^{2}}?$" :question/worked-solution "The level curves for the function $f(x,y)$ are given by the equations \n\n$$\nf(x,y)=c.\n$$\n\nNotice that the range of $f(x,y)$ is $[0,\\infty ).$ So, we will consider only level curves for $c\\ge 0.$\n\nTherefore, we have:\n\n$$\n\\begin{aligned}f(x,y) & =c \\\\ \\sqrt{3{x}^{2}+2{y}^{2}} & =c \\\\ 3{x}^{2}+2{y}^{2} & ={c}^{2}\\end{aligned}\n$$\n\nThe equation above gives us a family of ellipses centered at the origin. Therefore, the correct graph is as follows:\n\n$$\n\n$$\n\n![](images/cc/cccaa6d7f554076b3a79364e1f2c4c061ae7cd86f7f0064e3861ba3b035b6a3e.png)"}]}
