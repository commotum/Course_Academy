      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14207428/observations/step-q162753-9e8747369737ea2f06c2.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14207428/observations/step-q162753-9e8747369737ea2f06c2.png",
      "source_url": "https://mathacademy.com/tasks/14207428/topics/1948/lesson",
