7592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465439} {:answer/id #uuid "846db8be-caad-5745-895f-689617b7f5c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465440}] :answer-field/correct {:answer/id #uuid "846db8be-caad-5745-895f-689617b7f5c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465440} :answer-field/id #uuid "df4315f2-baaa-5c79-a8b7-fbae16322963" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466563}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "168b395c-d069-5c8f-9acc-5bed4b37b963" :question/math-academy-id "q-161642" :question/problem "Which of the following sets are closed?\n- **I.** ${(x,y)\\in {R}^{2}\\,:\\,4{x}^{2}+3{y}^{2}\\le 1}$\n- **II.** ${(x,y)\\in {R}^{2}\\,:\\,0\\le x\\le 2,\\,0\\le y\\le 2x-{x}^{2}}$\n- **III.** ${(x,y)\\in {R}^{2}\\,:\\,0\\le x\\le 1,\\,1\\le y\\le 3}$\n\nSelect all that apply." :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nLet's examine our sets in turn.\n\n- The first set is *closed* since it contains all of its boundary points (all the corresponding inequalities are not strict).\n\n- The second set is *closed* since it contains all of its boundary points (all the corresponding inequalities are not strict).\n\n- The third set is *closed* since it contains all of its boundary points (all the corresponding inequalities are not strict).\n\nTherefore, the correct answer is \"I, II, and III.\""}] [{:db/id #edb/ref 17592186278581 :knowledge-point/_questions [{:db/id #edb/ref 17592186192767 :knowledge-point/id #uuid "7adf2c3e-4a73-5098-ab60-790d637728cf" :knowledge-point/title "Identifying Open and Closed Sets in the Plane in Set Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6bb52348-a50b-5509-94d7-e312e15e922b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465441} {:answer/id #uuid "c5d1d18c-2c18-5ba9-a875-75dec189ca03" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465442}] :answer-field/correct {:answer/id #uuid "c5d1d18c-2c18-5ba9-a875-75dec189ca03" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465442} :answer-field/id #uuid "5d0a0fc8-fc1c-5e05-86df-321963effe9c" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466564} {:answer-field/choices [{:answer/id #uuid "8e179f35-3e64-5a2d-bdbd-cec179c87f47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465443} {:answer/id #uuid "45531787-af9f-5f77-a4c4-b03440b8640e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465444}] :answer-field/correct {:answer/id #uuid "8e179f35-3e64-5a2d-bdbd-cec179c87f47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465443} :answer-field/id #uuid "89701a6c-6d0c-5c54-be79-8e42f1681ba3" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466565} {:answer-field/choices [{:answer/id #uuid "1bd1affc-9370-5696-bd27-febdf87917ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465445} {:answer/id #uuid "bce5f56d-f9db-58ab-8ded-169f93431baa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465446}] :answer-field/correct {:answer/id #uuid "bce5f56d-f9db-58ab-8ded-169f93431baa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465446} :answer-field/id #uuid "c1bdf075-be73-58e7-822c-d788c0385547" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466566}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c3f47e10-181c-587e-a0be-2b1e263782c0" :question/math-academy-id "q-161646" :question/problem "Which of the following sets are open?\n- **I.** ${(x,y)\\in {R}^{2}:\\text{ }-3<x<3,\\,0<y<|2x|}$\n- **II.** ${(x,y)\\in {R}^{2}:\\text{ }{x}^{2}+{y}^{2}\\le 1}$\n- **III.** ${(x,y)\\in {R}^{2}:\\text{ }-1<x<1,\\,1<y<3-{x}^{2}}$\n\nSelect all that apply." :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nLet's examine our sets in turn.\n\n- The first set is *open* since it doesn't contain any of its boundary points (all the corresponding inequalities are strict).\n\n- The second set is *closed* since it contains all of its boundary points (all the corresponding inequalities are not strict).\n\n- The third set is *open* since it doesn't contain any of its boundary points (all the corresponding inequalities are strict).\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186193377 :knowledge-point/_questions [{:db/id #edb/ref 17592186192767 :knowledge-point/id #uuid "7adf2c3e-4a73-5098-ab60-790d637728cf" :knowledge-point/title "Identifying Open and Closed Sets in the Plane in Set Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a79b038c-fe01-5ebc-866e-1019c3411829" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460161} {:answer/id #uuid "7e520372-4f2a-52fe-80ef-779b4c47f5ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460162}] :answer-field/correct {:answer/id #uuid "7e520372-4f2a-52fe-80ef-779b4c47f5ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460162} :answer-field/id #uuid "0f28ff6b-8064-54e6-ac2a-cbfc20687b92" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460947} {:answer-field/choices [{:answer/id #uuid "ebc8c9ed-7eb1-530d-8dc2-74b72a9c7683" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460163} {:answer/id #uuid "c32fe42f-7550-5e6f-89b8-a8cf262268b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460164}] :answer-field/correct {:answer/id #uuid "ebc8c9ed-7eb1-530d-8dc2-74b72a9c7683" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460163} :answer-field/id #uuid "a6c4ff18-793c-5bf5-b61b-dc2775e56694" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460948} {:answer-field/choices [{:answer/id #uuid "0832d56b-30c1-5f4f-a9de-e199bf8d8ced" :answer/type