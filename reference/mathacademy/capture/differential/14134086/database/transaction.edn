egin{aligned}7 & 4 \\\\ 12 & 7\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{7\\cdot 7-12\\cdot 4}[\\begin{aligned}7 & -4 \\\\ -12 & 7\\end{aligned}] \\\\  & =[\\begin{aligned}7 & -4 \\\\ -12 & 7\\end{aligned}]\\end{aligned}\n$$\n\nNow, we compute $[\\,x\\,]_{B}:$\n\n$$\n\\begin{aligned}[\\,x\\,]_{B} & ={P}_{C\\to B}[\\,x\\,]_{C} \\\\  & =[\\begin{aligned}7 & -4 \\\\ -12 & 7\\end{aligned}][\\begin{aligned}4 \\\\ 5\\end{aligned}] \\\\  & =[\\begin{aligned}8 \\\\ -13\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ca6335cf-a241-5413-8b14-741fb6ccabc6"] :db/ensure [:question/validate]} {:db/id "answer-field-ca6335cf-a241-5413-8b14-741fb6ccabc6" :answer-field/id #uuid "ca6335cf-a241-5413-8b14-741fb6ccabc6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-05a2a04d-6fe7-5a0d-8718-80558dc272b6" :answer-field/choices ["answer-cfa60034-0dcd-5f83-8b52-44d789dd2759" "answer-50b3b88a-a623-50e5-b968-d9227a27e597" "answer-05a2a04d-6fe7-5a0d-8718-80558dc272b6" "answer-c51f010d-b055-55be-a901-8dda67213b6b" "answer-4b07ccd2-15b5-5fe4-9051-5d908e60ebd4"] :db/ensure [:answer-field/validate]} {:db/id "answer-cfa60034-0dcd-5f83-8b52-44d789dd2759" :answer/id #uuid "cfa60034-0dcd-5f83-8b52-44d789dd2759" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-6 \\\\ 7\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-50b3b88a-a623-50e5-b968-d9227a27e597" :answer/id #uuid "50b3b88a-a623-50e5-b968-d9227a27e597" :answer/type :answer.type/math :answer/value "[\\begin{aligned}18 \\\\ 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-05a2a04d-6fe7-5a0d-8718-80558dc272b6" :answer/id #uuid "05a2a04d-6fe7-5a0d-8718-80558dc272b6" :answer/type :answer.type/math :answer/value "[\\begin{aligned}8 \\\\ -13\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-c51f010d-b055-55be-a901-8dda67213b6b" :answer/id #uuid "c51f010d-b055-55be-a901-8dda67213b6b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}8 \\\\ -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-4b07ccd2-15b5-5fe4-9051-5d908e60ebd4" :answer/id #uuid "4b07ccd2-15b5-5fe4-9051-5d908e60ebd4" :answer/type :answer.type/math :answer/value "[\\begin{aligned}8 \\\\ -8\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id 17592186125034 :question/problem "The change-of-coordinates matrix from $B=\\{{b}_{1},{b}_{2}\\}$ to $C=\\{{c}_{1},{c}_{2}\\}$ is given below. Find $[x]_{B}$ given that $x=-3{c}_{1}-2{c}_{2}.$\n\n$$\n{P}_{B\\to C}=[\\begin{aligned}1 & 3 \\\\ -2 & -4\\end{aligned}]\n$$" :db/ensure [:question/validate]} {:db/id 17592186394442 :question/problem "The change-of-coordinates matrix from $B=\\{{b}_{1},{b}_{2}\\}$ to $C=\\{{c}_{1},{c}_{2}\\}$ is given below. Find $[x]_{B}$ given that $x=5{c}_{1}-{c}_{2}.$\n\n$$\n{P}_{B\\to C}=[\\begin{aligned}5 & 10 \\\\ 2 & 5\\end{aligned}]\n$$" :db/ensure [:question/validate]} {:db/id "question-7107964a-37f7-5d19-a3ab-82f544f38d24" :question/id #uuid "7107964a-37f7-5d19-a3ab-82f544f38d24" :question/math-academy-id "q-113593" :question/problem "The change-of-coordinates matrix from $B=\\{{b}_{1},{b}_{2}\\}$ to $C=\\{{c}_{1},{c}_{2}\\}$ is given below. Find $[x]_{B}$ given that $x=2{c}_{1}-2{c}_{2}.$\n\n$$\n{P}_{B\\to C}=[\\begin{aligned}3 & -4 \\\\ -5 & 6\\end{aligned}]\n$$" :question/worked-solution "We will use the change-of-coordinates formula in the form\n\n$$\n[\\,x\\,]_{B}={P}_{C\\to B}[\\,x\\,]_{C}.\n$$\n\nFirst, we need to find the change-of-coordinates matrix ${P}_{C\\to B}$ from $C$ to $B.$ To do that, we compute the inverse of ${P}_{B\\to C}:$\n\n$$\n\\begin{aligned}{P}_{C\\to B} & ={P}_{B\\to C}^{-1} \\\\  & ={[\\begin{aligned}3 & -4 \\\\ -5 & 6\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{3\\cdot 6-(-4)\\cdot (-5)}[\\begin{aligned}6 & 4 \\\\ 5 & 3\\end{aligned}] \\\\  & =[\\begin{aligned}-3 & -2 \\\\ -\\frac{5}{2} & -\\frac{3}{2}\\end{aligned}]\\end{aligned}\n$$\n\nNotice that since $x=2{c}_{1}-2{c}_{2},$ we obtain\n\n$$\n[x]_{C}=[\\begin{aligned}2 \\\\ -2\\end{aligned}].\n$$\n\nNow, we compute $[\\,x\\,]_{B}:$\n\n$$\n\\begin{aligned}[\\,x\\,]_{B} & ={P}_{C\\to B}[\\,x\\,]_{C} \\\\  & =[\\begin{aligned}-3 & -2 \\\\ -\\frac{5}{2} & -\\frac{3}{2}\\end{aligned}][\\begin{aligned}2 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}-2 \\\\ -2\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-db389e57-4899-5138-b87d-2318a36bc5bc"] :db/ensure [:question/validate]} {:db/id "answer-field-db389e57-4899-5138-b87d-2318a36bc5bc" :answer-field/id #uuid "db389e57-4899-5138-b87d-2318a36bc5bc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-fb09d36c-bb40-569c-94ed-c0a08e942a34" :answer-field/choices ["answer-fb09d36c-bb40-569c-94ed-c0a08e942a34" "answer-f07972b5-b529-5e8a-8ee6-b20071370ee9" "answer-07df0399-5b7b-513e-bfe4-682fc2093392" "answer-1f5c1c5a-e4ea-5d65-95cb-9752b676bf64" "answer-c77af8ac-86cc-50b1-9ef0-e91ba1f365af"] :db/ensure [:answer-field/validate]} {:db/id "answer-fb09d36c-bb40-569c-94ed-c0a08e942a34" :answer/id #uuid "fb09d36c-bb40-569c-94ed-c0a08e942a34" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 \\\\ -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-f07972b5-b529-5e8a-8ee6-b20071370ee9" :answer/id #uuid "f07972b5-b529-5e8a-8ee6-b20071370ee9" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 \\\\ \\frac{1}{2}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-07df0399-5b7b-513e-bfe4-682fc2093392" :answer/id #uuid "07df0399-5b7b-513e-bfe4-682fc2093392" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-\\frac{5}{2} \\\\ -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-1f5c1c5a-e4ea-5d65-95cb-9752b676bf64" :answer/id #uuid "1f5c1c5a-e4ea-5d65-95cb-9752b676bf64" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-c77af8ac-86cc-50b1-9ef0-e91ba1f365af" :answer/id #uuid "c77af8ac-86cc-50b1-9ef0-e91ba1f365af" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-b6330ac1-ad9e-564b-a472-75f385cd01df" :question/id #uuid "b6330ac1-ad9e-564b-a472-75f385cd01df" :question/math-academy-id "q-113599" :question/problem "$$\nB=\\{[\\begin{aligned}4 \\\\ 3\\end{aligned}],[\\begin{aligned}6 \\\\ 5\\end{aligned}]\\},\\,[x]_{S}=[\\begin{aligned}2 \\\\ 0\\end{aligned}]\n$$\n\nThe basis $B$ of ${R}^{2}$ and the coordinates of the vector $x$ relative to the standard basis $S$ are given above. Find $[x]_{B}.$" :question/worked-solution "We will use the change-of-coordinates formula in the form\n\n$$\n[\\,x\\,]_{B}={P}_{S\\to B}[\\,x\\,]_{S}.\n$$\n\nFirst, recall that the change-of-coordinates matrix from $B$ to $S$ is the matrix whose columns are the vectors of $B$ relative to the standard basis $S.$ As a result, we have\n\n$$\n{P}_{B\\to S}=[\\begin{aligned}4 & 6 \\\\ 3 & 5\\end{aligned}].\n$$\n\nNow, we need to find the change-of-coordinates matrix ${P}_{S\\to B}$ from $S$ to $B.$ To do that, we compute the inverse of ${P}_{B\\to S}:$\n\n$$\n\\begin{aligned}{P}_{S\\to B} & ={P}_{B\\to S}^{-1} \\\\  & ={[\\begin{aligned}4 & 6 \\\\ 3 & 5\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{4\\cdot 5-6\\cdot 3}[\\begin{aligned}5 & -6 \\\\ -3 & 4\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{5}{2} & -3 \\\\ -\\frac{3}{2} & 2\\end{aligned}]\\end{aligned}\n$$\n\nFinally, we compute $[\\,x\\,]_{B}:$\n\n$$\n\\begin{aligned}[\\,x\\,]_{B} & ={P}_{S\\to B}[\\,x\\,]_{S} \\\\  & =[\\begin{aligned}\\frac{5}{2} & -3 \\\\ -\\frac{3}{2} & 2\\end{aligned}][\\begin{aligned}2 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}5 \\\\ -3\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b8a2471b-4cb7-5a36-8100-83473b7cc0c0"] :db/ensure [:question/validate]} {:db/id "answer-field-b8a2471b-4cb7-5a36-8100-83473b7cc0c0" :answer-field/id #uuid "b8a2471b-4cb7-5a36-8100-83473b7cc0c0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9ec51647-d0a5-5325-a518-840d3a070f89" :answer-field/choices ["answer-3371709f-eb7b-58f8-93cb-bb7d689a3fbb" "answer-6e3b207a-4928-510d-a62a-dee0e13ac5c8" "answer-8a4c2018-80ac-5e49-b28f-484e2ec7a8ac" "answer-3fffbe35-a610-576c-8afc-bc0238c80168" "answer-9ec51647-d0a5-5325-a518-840d3a070f89"] :db/ensure [:answer-field/validate]} {:db/id "answer-3371709f-eb7b-58f8-93cb-bb7d689a3fbb" :answer/id #uuid "3371709f-eb7b-58f8-93cb-bb7d689a3fbb" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 \\\\ -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-6e3b207a-4928-510d-a62a-dee0e13ac5c8" :answer/id #uuid "6e3b207a-4928-510d-a62a-dee0e13ac5c8" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 \\\\ -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-8a4c2018-80ac-5e49-b28f-484e2ec7a8ac" :answer/id #uuid "8a4c2018-80ac-5e49-b28f-484e2ec7a8ac" :answer/type :answer.type/math :answer/value "[\\begin{aligned}4 \\\\ -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-3fffbe35-a610-576c-8afc-bc0238c80168" :answer/id #uuid "3fffbe35-a610-576c-8afc-bc0238c80168" :answer/type :answer.type/math :answer/value "[\\begin{aligned}5 \\\\ -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-9ec51647-d0a5-5325-a518-840d3a070f89" :answer/id #uuid "9ec51647-d0a5-5325-a518-840d3a070f89" :answer/type :answer.type/math :answer/value "[\\begin{aligned}5 \\\\ -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id 17592186394421 :question/problem "$$\nB=\\{[\\begin{aligned}7 \\\\ -2\\end{aligned}],[\\begin{aligned}-4 \\\\ 1\\end{aligned}]\\},\\,[x]_{S}=[\\begin{aligned}2 \\\\ 2\\end{aligned}]\n$$\n\nThe basis $B$ of ${R}^{2}$ and the coordinates of the vector $x$ relative to the standard basis $S$ are given above. Find $[x]_{B}.$" :db/ensure [:question/validate]} {:db/id 17592186394414 :question/problem "$$\nB=\\{[\\begin{aligned}5 \\\\ 1\\end{aligned}],[\\begin{aligned}9 \\\\ 2\\end{aligned}]\\},\\,[x]_{S}=[\\begin{aligned}4 \\\\ 1\\end{aligned}]\n$$\n\nThe basis $B$ of ${R}^{2}$ and the coordinates of the vector $x$ relative to the standard basis $S$ are given above. Find $[x]_{B}.$" :db/ensure [:question/validate]} {:db/id 17592186417184 :question/problem "$$\nB=\\{[\\begin{aligned}7 \\\\ 3\\end{aligned}],[\\begin{aligned}5 \\\\ 2\\end{aligned}]\\},\\,[x]_{S}=[\\begin{aligned}-2 \\\\ -1\\end{aligned}]\n$$\n\nThe basis $B$ of ${R}^{2}$ and the coordinates of the vector $x$ relative to the standard basis $S$ are given above. Find $[x]_{B}.$" :db/ensure [:question/validate]} {:db/id 17592186351443 :question/problem "$$\nB=\\{[\\begin{aligned}1 \\\\ 3\\end{aligned}],[\\begin{aligned}3 \\\\ 10\\end{aligned}]\\},\\,C=\\{[\\begin{aligned}3 \\\\ 4\\end{aligned}],[\\begin{aligned}-2 \\\\ 3\\end{aligned}]\\},\\,[x]_{C}=[\\begin{aligned}1 \\\\ 1\\end{aligned}]\n$$\n\nThe bases $B$ and $C$ of ${R}^{2}$ and the coordinates of the vector $x$ relative to the basis $C$ are given above. Find $[x]_{B}.$" :question/worked-solution "Let's denote the vectors of $B$ and $C$ as $\\{{b}_{1},{b}_{2}\\}$ and $\\{{c}_{1},{c}_{2}\\}$, respectively.\n\nThe change-of-coordinates matrix from $C$ to $B$ is a matrix whose columns are the vectors of $C$ relative to the basis $B.$\n\nHence, we need to find the coordinates of ${c}_{1}$ and ${c}_{2}$ relative to the basis $B.$ We can do this simultaneously by considering the matrix\n\n$$\nM=[\\begin{aligned}| & | & | & | \\\\ {b}_{1} & {b}_{2} & {c}_{1} & {c}_{2} \\\\ | & | & | & |\\end{aligned}].\n$$\n\nNow, we simply reduce the left-hand side to reduced row-echelon form using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 3 & 3 & -2 \\\\ 3 & 10 & 4 & 3\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 3 & 3 & -2 \\\\ 0 & 1 & -5 & 9\\end{aligned}] & {R}_{1} & :={R}_{1}+(-3){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 18 & -29 \\\\ 0 & 1 & -5 & 9\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the change-of-coordinates matrix ${P}_{C\\to B}$ is\n\n$$\n{P}_{C\\to B}=[\\begin{aligned}18 & -29 \\\\ -5 & 9\\end{aligned}].\n$$\n\nFinally, we compute $[\\,x\\,]_{B}:$\n\n$$\n\\begin{aligned}[\\,x\\,]_{B} & ={P}_{C\\to B}[\\,x\\,]_{C} \\\\  & =[\\begin{aligned}18 & -29 \\\\ -5 & 9\\end{aligned}][\\begin{aligned}1 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}-11 \\\\ 4\\end{aligned}]\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-7ff42b5f-a341-579b-8b7f-9bd10f63610f" :question/id #uuid "7ff42b5f-a341-579b-8b7f-9bd10f63610f" :question/math-academy-id "q-113694" :question/problem "$$\nB=\\{[\\begin{aligned}1 \\\\ 3\\end{aligned}],[\\begin{aligned}2 \\\\ 5\\end{aligned}]\\},\\,C=\\{[\\begin{aligned}-1 \\\\ 0\\end{aligned}],[\\begin{aligned}3 \\\\ 1\\end{aligned}]\\},\\,[x]_{C}=[\\begin{aligned}3 \\\\ 1\\end{aligned}]\n$$\n\nThe bases $B$ and $C$ of ${R}^{2}$ and the coordinates of the vector $x$ relative to the basis $C$ are given above. Find $[x]_{B}.$" :question/worked-solution "Let's denote the vectors of $B$ and $C$ as $\\{{b}_{1},{b}_{2}\\}$ and $\\{{c}_{1},{c}_{2}\\}$, respectively.\n\nThe change-of-coordinates matrix from $C$ to $B$ is a matrix whose columns are the vectors of $C$ relative to the basis $B.$\n\nHence, we need to find the coordinates of ${c}_{1}$ and ${c}_{2}$ relative to the basis $B.$ We can do this simultaneously by considering the matrix\n\n$$\nM=[\\begin{aligned}| & | & | & | \\\\ {b}_{1} & {b}_{2} & {c}_{1} & {c}_{2} \\\\ | & | & | & |\\end{aligned}].\n$$\n\nNow, we simply reduce the left-hand side to reduced row-echelon form using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 2 & -1 & 3 \\\\ 3 & 5 & 0 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & -1 & 3 \\\\ 0 & -1 & 3 & -8\\end{aligned}] & {R}_{2} & :=(-1){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 2 & -1 & 3 \\\\ 0 & 1 & -3 & 8\\end{aligned}] & {R}_{1} & :={R}_{1}+(-2){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 5 & -13 \\\\ 0 & 1 & -3 & 8\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the change-of-coordinates matrix ${P}_{C\\to B}$ is\n\n$$\n{P}_{C\\to B}=[\\begin{aligned}-5 & -13 \\\\ -3 & 8\\end{aligned}].\n$$\n\nFinally, we compute $[\\,x\\,]_{B}:$\n\n$$\n\\begin{aligned}[\\,x\\,]_{B} & ={P}_{C\\to B}[\\,x\\,]_{C} \\\\  & =[\\begin{aligned}5 & -13 \\\\ -3 & 8\\end{aligned}][\\begin{aligned}3 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ -1\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-bb22dba9-7d4a-5544-a86b-ad8fa73d5975"] :db/ensure [:question/validate]} {:db/id "answer-field-bb22dba9-7d4a-5544-a86b-ad8fa73d5975" :answer-field/id #uuid "bb22dba9-7d4a-5544-a86b-ad8fa73d5975" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-17b92d00-0a4a-59f6-a147-1be3ac44c4da" :answer-field/choices ["answer-507e0790-a1c9-534c-b2c6-1884ab0a08e2" "answer-10cf25e0-86f0-5251-8e30-bdb8e6de1aee" "answer-d8411715-1012-54e7-9e54-4b60a0e318b7" "answer-27f96cc5-65da-5d59-b093-95e1e75c4935" "answer-17b92d00-0a4a-59f6-a147-1be3ac44c4da"] :db/ensure [:answer-field/validate]} {:db/id "answer-507e0790-a1c9-534c-b2c6-1884ab0a08e2" :answer/id #uuid "507e0790-a1c9-534c-b2c6-1884ab0a08e2" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 \\\\ -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-10cf25e0-86f0-5251-8e30-bdb8e6de1aee" :answer/id #uuid "10cf25e0-86f0-5251-8e30-bdb8e6de1aee" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-d8411715-1012-54e7-9e54-4b60a0e318b7" :answer/id #uuid "d8411715-1012-54e7-9e54-4b60a0e318b7" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-27f96cc5-65da-5d59-b093-95e1e75c4935" :answer/id #uuid "27f96cc5-65da-5d59-b093-95e1e75c4935" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-17b92d00-0a4a-59f6-a147-1be3ac44c4da" :answer/id #uuid "17b92d00-0a4a-59f6-a147-1be3ac44c4da" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 \\\\ -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-92fb3400-1e9e-5f15-b0ad-6ea07e725536" :question/id #uuid "92fb3400-1e9e-5f15-b0ad-6ea07e725536" :question/math-academy-id "q-82620" :question/problem "$$\nB=\\{[\\begin{aligned}0 \\\\ -2\\end{aligned}],[\\begin{aligned}1 \\\\ 0\\end{aligned}]\\},\\,C=\\{[\\begin{aligned}1 \\\\ 4\\end{aligned}],[\\begin{aligned}3 \\\\ 13\\end{aligned}]\\},\\,[x]_{B}=[\\begin{aligned}3 \\\\ -1\\end{aligned}].\n$$\n\n \n\nThe bases $B$ and $C$ of ${R}^{2}$ and the coordinates of the vector $x$ relative to the basis $B$ are given above. Find $[x]_{C}.$" :question/worked-solution "Let's denote the vectors of $B$ and $C$ as $\\{{b}_{1},{b}_{2}\\}$ and $\\{{c}_{1},{c}_{2}\\}$, respectively.\n\nThe change-of-coordinates matrix from $B$ to $C$ is a matrix whose columns are the vectors of $B$ relative to the basis $C.$\n\nHence, we need to find the coordinates of ${b}_{1}$ and ${b}_{2}$ relative to the basis $C.$ We can do this simultaneously by considering the matrix\n\n$$\nM=[\\begin{aligned}| & | & | & | \\\\ {c}_{1} & {c}_{2} & {b}_{1} & {b}_{2} \\\\ | & | & | & |\\end{aligned}].\n$$\n\nNow, we simply reduce the left-hand side to reduced row-echelon form using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 3 & 0 & 1 \\\\ 4 & 13 & -2 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+(-4){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 3 & 0 & 1 \\\\ 0 & 1 & -2 & -4\\end{aligned}] & {R}_{1} & :={R}_{1}+(-3){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 6 & 13 \\\\ 0 & 1 & -2 & -4\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the change-of-coordinates matrix ${P}_{B\\to C}$ is\n\n$$\n{P}_{B\\to C}=[\\begin{aligned}6 & 13 \\\\ -2 & -4\\end{aligned}].\n$$\n\nFinally, we compute $[\\,x\\,]_{C}:$\n\n$$\n\\begin{aligned}[\\,x\\,]_{C} & ={P}_{B\\to C}[\\,x\\,]_{B} \\\\  & =[\\begin{aligned}6 & 13 \\\\ -2 & -4\\end{aligned}][\\begin{aligned}3 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}5 \\\\ -2\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-4922efa6-bafc-57b9-a817-72a740df2719"] :db/ensure [:question/validate]} {:db/id "answer-field-4922efa6-bafc-57b9-a817-72a740df2719" :answer-field/id #uuid "4922efa6-bafc-57b9-a817-72a740df2719" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-18dc48a1-5985-578f-8b5e-9016d734956d" :answer-field/choices ["answer-2c1b735c-b2d7-53c7-85cc-47c1e2305f6d" "answer-1b76988c-1557-52a5-91a3-c4a65053602e" "answer-1bceb481-65f5-5e67-97b5-3ca99d15ac64" "answer-9d360efc-d5a1-5ea4-8321-aa2b837cea50" "answer-18dc48a1-5985-578f-8b5e-9016d734956d"] :db/ensure [:answer-field/validate]} {:db/id "answer-2c1b735c-b2d7-53c7-85cc-47c1e2305f6d" :answer/id #uuid "2c1b735c-b2d7-53c7-85cc-47c1e2305f6d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 \\\\ 5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-1b76988c-1557-52a5-91a3-c4a65053602e" :answer/id #uuid "1b76988c-1557-52a5-91a3-c4a65053602e" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-3 \\\\ -5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-1bceb481-65f5-5e67-97b5-3ca99d15ac64" :answer/id #uuid "1bceb481-65f5-5e67-97b5-3ca99d15ac64" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 \\\\ -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "ans