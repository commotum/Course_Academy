dinates matrix ${P}_{B\\to C}$ is\n\n$$\n{P}_{B\\to C}=[\\begin{aligned}6 & 4 \\\\ -2 & -1\\end{aligned}].\n$$\n\nFinally, we compute $[\\,x\\,]_{C}:$\n\n$$\n\\begin{aligned}[\\,x\\,]_{C} & ={P}_{B\\to C}[\\,x\\,]_{B} \\\\  & =[\\begin{aligned}6 & 4 \\\\ -2 & -1\\end{aligned}][\\begin{aligned}-3 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}-2 \\\\ 2\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-821658a6-a7cf-5368-b555-fe934cdee688"] :db/ensure [:question/validate]} {:db/id "answer-field-821658a6-a7cf-5368-b555-fe934cdee688" :answer-field/id #uuid "821658a6-a7cf-5368-b555-fe934cdee688" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-66289914-3007-51f5-9e3c-d8f37baa6eeb" :answer-field/choices ["answer-50b8fde9-b1bf-55f1-85e4-62be49bc498f" "answer-66289914-3007-51f5-9e3c-d8f37baa6eeb" "answer-fc23b863-6877-5fc4-a239-7a47d1c36069" "answer-9c7464c3-9605-587f-8a52-c4730e9f6f4b" "answer-9393ea56-5979-5ca9-9da8-6c232698d570"] :db/ensure [:answer-field/validate]} {:db/id "answer-50b8fde9-b1bf-55f1-85e4-62be49bc498f" :answer/id #uuid "50b8fde9-b1bf-55f1-85e4-62be49bc498f" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-66289914-3007-51f5-9e3c-d8f37baa6eeb" :answer/id #uuid "66289914-3007-51f5-9e3c-d8f37baa6eeb" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-fc23b863-6877-5fc4-a239-7a47d1c36069" :answer/id #uuid "fc23b863-6877-5fc4-a239-7a47d1c36069" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-4 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-9c7464c3-9605-587f-8a52-c4730e9f6f4b" :answer/id #uuid "9c7464c3-9605-587f-8a52-c4730e9f6f4b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ -4\\end{aligned}]" :db/ensur