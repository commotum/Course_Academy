56eb-8f7a-6aa51afc8a2a" :question/math-academy-id "q-113539" :question/problem "The change-of-coordinates matrix from the basis $B$ to the basis $C$ and the coordinates of the vector $x$ relative to the basis $B$ are given below. What is $[x]_{C}?$ \n\n$$\n{P}_{B\\to C}=[\\begin{aligned}-2 & 2 \\\\ -3 & 1\\end{aligned}],\\,[x]_{B}=[\\begin{aligned}2 \\\\ 5\\end{aligned}]\n$$" :question/worked-solution "Given the coordinates of $x$ relative to $B$ and the change-of-coordinates matrix from $B$ to $C,$ we find the coordinates of $x$ relative to $C$ as follows:\n\n$$\n\\begin{aligned}[\\,x\\,]_{C} & ={P}_{B\\to C}[\\,x\\,]_{B} \\\\  & =[\\begin{aligned}-2 & 2 \\\\ -3 & 1\\end{aligned}][\\begin{aligned}2 \\\\ 5\\end{aligned}] \\\\  & =[\\begin{aligned}6 \\\\ -1\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-33e79f79-0984-59ea-b9d7-5fe66d3a3c37"] :db/ensure [:question/validate]} {:db/id "answer-field-33e79f79-0984-59ea-b9d7-5fe66d3a3c37" :answer-field/id #uuid "33e79f79-0984-59ea-b9d7-5fe66d3a3c37" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-de0299ce-78dd-576d-89cc-ca65aafc4c70" :answer-field/choices ["answer-aa87788a-652c-5c09-96d7-b1ceb5b7f4ba" "answer-5583d439-4b26-52b3-9794-1635eb018312" "answer-5ed1a788-27da-548c-9bec-4712cdd0d589" "answer-cfd42ca8-7e84-5bc0-81bc-00e0d590afe7" "answer-de0299ce-78dd-576d-89cc-ca65aafc4c70"] :db/ensure [:answer-field/validate]} {:db/id "answer-aa87788a-652c-5c09-96d7-b1ceb5b7f4ba" :answer/id #uuid "aa87788a-652c-5c09-96d7-b1ceb5b7f4ba" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 \\\\ -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-5583d439-4b26-52b3-9794-1635eb018312" :answer/id #uuid "5583d439-4b26-52b3-9794-1635eb018312" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-5ed1a788-