#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186527247} :activity/id #uuid "2cd388bd-d3e4-5270-8c71-7d4eecc1b15e" :activity/scope {:db/id #edb/ref 17592186050368 :topic/id #uuid "43c8acd9-2549-595b-b25f-fa9322986113" :topic/math-academy-id 3061} :activity/steps [{:db/id #edb/ref 17592186527238 :step/content {:db/id #edb/ref 17592186527187 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "419508b7-b598-5bac-aefc-71912a4034c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1+\\operatorname{ln}⁡2}{2}" :db/id #edb/ref 17592186526631} {:answer/id #uuid "52e29e0e-3acf-5e78-b135-92a31a0d1a0a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e+\\operatorname{ln}⁡2" :db/id #edb/ref 17592186526669} {:answer/id #uuid "a5bb0ace-70a3-52eb-95ec-8d06773149b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(e-1)\\operatorname{ln}⁡2" :db/id #edb/ref 17592186526820} {:answer/id #uuid "b2538d50-74dd-5675-80ce-ae08eaba9106" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{e-1}{4}" :db/id #edb/ref 17592186526844} {:answer/id #uuid "fda9eb6e-8342-5d4d-a8b8-51e569d33bde" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{(e-1)^{2}\\operatorname{ln}⁡2}{2}" :db/id #edb/ref 17592186527005}] :answer-field/correct {:db/id #edb/ref 17592186526820} :answer-field/id #uuid "b806adf7-55c6-5e96-8591-27f8f3de0558" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527089}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9ba35bb1-196e-51b8-b71e-102fe895702c" :question/math-academy-id "q-143884" :question/problem "Find $\\text{E}[{e}^{X-Y}],$ given that random variables $X$ and $Y$ have the joint probability density function\n\n$$\nf(x,y)=\\{\\begin{aligned}{e}^{y},\\, & 0\\le x\\le 1,\\,0\\le y\\le \\operatorname{ln}⁡2, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$" :question/worked-solution "Suppose $X$ and $Y$ are continuous random variables, and $f(x,y)$ is their joint probability density function. If $r:{R}^{2}\\to R$ is a function of two variables, then the rule of the lazy statistician states that\n\n$$\n\\text{E}[r(X,Y)]={∬}_{{R}^{2}}r(x,y)\\,f(x,y)\\,\\text{d}x\\text{d}y.\n$$\n\nIn our case, we have\n\n$$\nr(x,y)={e}^{x-y}.\n$$\n\nNotice that $f(x,y)$ is nonzero only in the rectangular region $D=\\{(x,y)\\,:\\,0\\le x\\le 1,\\,0\\le y\\le \\operatorname{ln}⁡2\\}.$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{E}[{e}^{X-Y}] & ={∬}_{{R}^{2}}{e}^{x-y}\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={∬}_{D}{e}^{x-y}\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{0}^{\\operatorname{ln}⁡2}{\\int }_{0}^{1}{e}^{x-y}\\cdot {e}^{y}\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{\\operatorname{ln}⁡2}{\\int }_{0}^{1}{e}^{x}\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{\\operatorname{ln}⁡2}[{e}^{x}]_{0}^{1}\\,\\text{d}y \\\\  & ={\\int }_{0}^{\\operatorname{ln}⁡2}(e-1)\\,\\text{d}y \\\\  & =[(e-1)y]_{0}^{\\operatorname{ln}⁡2} \\\\  & =(e-1)\\operatorname{ln}⁡2.\\end{aligned}\n$$"} :step/id #uuid "2059c6c7-dfef-5a9d-83eb-99b192520566"} {:db/id #edb/ref 17592186527247 :step/content {:db/id #edb/ref 17592186527217 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0094f649-619d-53d4-bd4a-599974a79f65" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186526499} {:answer/id #uuid "0b87866d-7ca3-5ffe-9bf1-7ca2dbed6087" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{13}{4}" :db/id #edb/ref 17592186526527} {:answer/id #uuid "617c7900-1787-5067-bf53-b914ea33d964" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186526697} {:answer/id #uuid "88871071-0592-5a72-9ee4-9896fb71c1b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186526774} {:answer/id #uuid "d153fc31-a51b-5ff0-a56d-5400a28d1dca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{11}{4}" :db/id #edb/ref 17592186526906}] :answer-field/correct {:db/id #edb/ref 17592186526906} :answer-field/id #uuid "4a370ffb-9f03-59b2-ac60-62d599bab917" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527050}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "da99206a-ee96-54b9-a8bb-1c95438c5559" :question/math-academy-id "q-143850" :question/problem "Find $\\text{E}[4(X-1)],$ given that random variables $X$ and $Y$ have the joint probability density function\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{3}{4},\\, & 1\\le x\\le 2,\\,1\\le y\\le {x}^{2}; \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$" :question/worked-solution "Suppose $X$ and $Y$ are continuous random variables, and $f(x,y)$ is their joint probability density function. If $r:{R}^{2}\\to R$ is a function of two variables, then the rule of the lazy statistician states that\n\n$$\n\\text{E}[r(X,Y)]={∬}_{{R}^{2}}r(x,y)\\,f(x,y)\\,\\text{d}x\\text{d}y.\n$$\n\nIn our case, we have\n\n$$\nr(x,y)=4(x-1).\n$$\n\nNow, let's sketch the region $D=\\{(x,y)\\,:\\,1\\le x\\le 2,\\,1\\le y\\le {x}^{2}\\},$ where $f(x,y)$ is nonzero.\n\n![](images/bd/bd8d2d36a0fe570e6ccdb096c6c39bc9c9edeed9b008dada504801025055438f.png)\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{E}[4(X-1)] & ={∬}_{{R}^{2}}4(x-1)\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={∬}_{D}4(x-1)\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{1}^{2}{\\int }_{1}^{{x}^{2}}4(x-1)\\cdot \\frac{3}{4}\\,\\text{d}y\\,\\text{d}x \\\\  & =3{\\int }_{1}^{2}(x-1){\\int }_{1}^{{x}^{2}}\\,\\text{d}y\\,\\text{d}x \\\\  & =3{\\int }_{1}^{2}(x-1)[y]_{y=1}^{y={x}^{2}}\\,\\text{d}x \\\\  & =3{\\int }_{1}^{2}(x-1)({x}^{2}-1)\\text{d}x \\\\  & =3{\\int }_{1}^{2}({x}^{3}-{x}^{2}-x+1)\\text{d}x \\\\  & =3{[\\frac{1}{4}{x}^{4}-\\frac{1}{3}{x}^{3}-\\frac{1}{2}{x}^{2}+x]}_{x=1}^{x=2} \\\\  & =3[(4-\\frac{8}{3}-2+2)-(\\frac{1}{4}-\\frac{1}{3}-\\frac{1}{2}+1)] \\\\  & =3(\\frac{4}{3}-\\frac{5}{12}) \\\\  & =\\frac{11}{4}.\\end{aligned}\n$$"} :step/id #uuid "45242d45-bd36-5121-80cd-9ac928d0a8f1" :step/next {:db/id #edb/ref 17592186527267}} {:db/id #edb/ref 17592186527265 :step/content {:db/id #edb/ref 17592186162405 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7721745-ad03-53db-a815-6aaeca788eec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{64}{3}" :db/id #edb/ref 17592186159633} {:answer/id #uuid "eb8f3173-a188-595a-abc3-d496d03ab864" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{25}{3}" :db/id #edb/ref 17592186159634} {:answer/id #uuid "1c3b3bb2-3c37-58d3-8bb6-9561ffa9021e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{55}{9}" :db/id #edb/ref 17592186159635} {:answer/id #uuid "4cb2a5b0-428d-55cf-81b7-d5911e995dc8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{59}{9}" :db/id #edb/ref 17592186159636} {:answer/id #uuid "56df325d-37a0-555d-a11a-1c1a0e813f23" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{46}{3}" :db/id #edb/ref 17592186159637}] :answer-field/correct {:db/id #edb/ref 17592186159637} :answer-field/id #uuid "f2d24abc-d1b0-58d4-a70a-977fc4027a7b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186159632}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e5885563-4db5-59bf-bd48-8bd78d146772" :question/math-academy-id "q-143880" :question/problem "Find $\\text{E}[{X}^{3}(Y+1)],$ given that random variables $X$ and $Y$ have the joint probability density function\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{y}{{x}^{2}},\\, & 1\\le x\\le 3,\\,1\\le y\\le 2, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$" :question/worked-solution "Suppose $X$ and $Y$ are continuous random variables, and $f(x,y)$ is their joint probability density function. If $r:{R}^{2}\\to R$ is a function of two variables, then the rule of the lazy statistician states that\n\n$$\n\\text{E}[r(X,Y)]={∬}_{{R}^{2}}r(x,y)\\,f(x,y)\\,\\text{d}x\\text{d}y.\n$$\n\nIn our case, we have\n\n$$\nr(x,y)={x}^{3}(y+1).\n$$\n\nNotice that $f(x,y)$ is nonzero only in the rectangular region $D=\\{(x,y)\\,:\\,1\\le x\\le 3,\\,1\\le y\\le 2\\}.$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{E}[{X}^{3}(Y+1)] & ={∬}_{{R}^{2}}{x}^{3}(y+1)\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={∬}_{D}{x}^{3}(y+1)\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{1}^{2}{\\int }_{1}^{3}{x}^{3}(y+1)\\cdot \\frac{y}{{x}^{2}}\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{1}^{2}y(y+1){\\int }_{1}^{3}x\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{1}^{2}y(y+1){[\\frac{{x}^{2}}{2}]}_{1}^{3}\\,\\text{d}y \\\\  & ={\\int }_{1}^{2}4y(y+1)\\,\\text{d}y \\\\  & ={[\\frac{4{y}^{3}}{3}+2{y}^{2}]}_{1}^{2} \\\\  & ={[\\frac{4{y}^{3}}{3}+2{y}^{2}]}_{1}^{2} \\\\  & =(\\frac{32}{3}+8)-(\\frac{4}{3}+2) \\\\  & =\\frac{46}{3}.\\end{aligned}\n$$"} :step/id #uuid "813ce03b-2bc9-56d9-bce8-95ab823f7304" :step/next {:db/id #edb/ref 17592186527238}} {:db/id #edb/ref 17592186527267 :step/content {:db/id #edb/ref 17592186527186 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48289cb0-2db9-541c-ba9b-d4327439a579" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186526645} {:answer/id #uuid "626f8019-c00b-5e2b-9eae-917eb16fcd3d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186526700} {:answer/id #uuid "77cd1431-7dea-5816-88cc-589a8ce57085" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8}{3}" :db/id #edb/ref 17592186526737} {:answer/id #uuid "ce683808-6c11-54ae-bb49-f99568096871" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186526898} {:answer/id #uuid "ee5a9688-f2d5-553e-872b-13b2824acaba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16" :db/id #edb/ref 17592186526973}] :answer-field/correct {:db/id #edb/ref 17592186526645} :answer-field/id #uuid "92fcb5de-d0cd-5bb2-911a-0615ed463dd0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527075}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9a19ca23-6c60-5d6e-8799-38d55529cc16" :question/math-academy-id "q-143871" :question/problem "Find $\\text{E}[{(X+Y)}^{2}],$ given that random variables $X$ and $Y$ have the joint probability density function\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{1}{4},\\, & y\\le x\\le 4-y,\\,0\\le y\\le 2; \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$" :question/worked-solution "Suppose $X$ and $Y$ are continuous random variables, and $f(x,y)$ is their joint probability density function. If $r:{R}^{2}\\to R$ is a function of two variables, then the rule of the lazy statistician states that\n\n$$\n\\text{E}[r(X,Y)]={∬}_{{R}^{2}}r(x,y)\\,f(x,y)\\,\\text{d}x\\text{d}y.\n$$\n\nIn our case, we have\n\n$$\nr(x,y)=(x+y)^{2}.\n$$\n\nNow, let's sketch the region $D=\\{(x,y)\\,:\\,y\\le x\\le 4-y,\\,0\\le y\\le 2\\},$ where $f(x,y)$ is nonzero.\n\n![](images/8d/8d1935944ffa0017da736fc540ff823df8a052c2c32c985553cde08ea5fce8da.png)\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{E}[{(X+Y)}^{2}] & ={∬}_{{R}^{2}}(x+y)^{2}\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={∬}_{D}(x+y)^{2}\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{0}^{2}{\\int }_{y}^{4-y}(x+y)^{2}\\cdot \\frac{1}{4}\\,\\text{d}x\\,\\text{d}y \\\\  & =\\frac{1}{4}{\\int }_{0}^{2}{[\\frac{1}{3}(x+y)^{3}]}_{x=y}^{x=4-y}\\,\\text{d}y \\\\  & =\\frac{1}{4}{\\int }_{0}^{2}[\\frac{1}{3}(4-y+y)^{3}-\\frac{1}{3}(y+y)^{3}]\\,\\text{d}y \\\\  & =\\frac{1}{12}{\\int }_{0}^{2}({4}^{3}-(2y)^{3})\\,\\text{d}y \\\\  & =\\frac{1}{12}{\\int }_{0}^{2}(64-8{y}^{3})\\,\\text{d}y \\\\  & =\\frac{1}{12}{[64y-2{y}^{4}]}_{y=0}^{y=2} \\\\  & =\\frac{1}{12}(128-32) \\\\  & =8.\\end{aligned}\n$$"} :step/id #uuid "8cf947ae-27ad-584f-9aba-1879a81641dc" :step/next {:db/id #edb/ref 17592186527270}} {:db/id #edb/ref 17592186527270 :step/content {:db/id #edb/ref 17592186527227 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58ac6aa4-3187-51f4-8986-37a77eb9556e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186526684} {:answer/id #uuid "67d3f414-e5a3-5a85-86ff-7be8a7d0d430" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186526708} {:answer/id #uuid "6ddc4b8b-fe6b-5cab-a0b5-82d769645de3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186526718} {:answer/id #uuid "b6768082-39bc-5d53-bad6-15fd36ca45b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186526853} {:answer/id #uuid "cfcead82-4acf-5200-8fd5-75bb552b7196" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186526901}] :answer-field/correct {:db/id #edb/ref 17592186526901} :answer-field/id #uuid "719de611-fe3d-510b-8ec3-a7dea6d0ecc5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527069}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f125a564-9e7e-50c1-b77c-f6cbd0ae6169" :question/math-academy-id "q-143879" :question/problem "Find $\\text{E}[{X}^{2}+{Y}^{2}],$ given that random variables $X$ and $Y$ have the joint probability density function\n\n$$\nf(x,y)=\\{\\begin{aligned}xy,\\, & 0\\le x\\le 1,\\,0\\le y\\le 2, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$" :question/worked-solution "Suppose $X$ and $Y$ are continuous random variables, and $f(x,y)$ is their joint probability density function. If $r:{R}^{2}\\to R$ is a function of two variables, then the rule of the lazy statistician states that\n\n$$\n\\text{E}[r(X,Y)]={∬}_{{R}^{2}}r(x,y)\\,f(x,y)\\,\\text{d}x\\text{d}y.\n$$\n\nIn our case, we have\n\n$$\nr(x,y)={x}^{2}+{y}^{2}.\n$$\n\nNotice that $f(x,y)$ is nonzero only in the rectangular region $D=\\{(x,y)\\,:\\,0\\le x\\le 1,\\,0\\le y\\le 2\\}.$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}+{Y}^{2}] & ={∬}_{{R}^{2}}({x}^{2}+{y}^{2})\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={∬}_{D}({x}^{2}+{y}^{2})\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1}({x}^{2}+{y}^{2})\\cdot xy\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{2}[{\\int }_{0}^{1}({x}^{3}y+x{y}^{3})\\,\\text{d}x]\\,\\text{d}y \\\\  & ={\\int }_{0}^{2}{[\\frac{y{x}^{4}}{4}+\\frac{{y}^{3}{x}^{2}}{2}]}_{x=0}^{x=1}\\,\\text{d}y \\\\  & ={\\int }_{0}^{2}(\\frac{y}{4}+\\frac{{y}^{3}}{2})\\,\\text{d}y \\\\  & =[\\frac{{y}^{2}}{8}+\\frac{{y}^{4}}{8}]_{0}^{2} \\\\  & =\\frac{1}{2}+2-0 \\\\  & =\\frac{5}{2}.\\end{aligned}\n$$"} :step/id #uuid "9e2158cb-c797-5395-8f29-3423911f68bf" :step/next {:db/id #edb/ref 17592186527265}}] :activity/title "The Rule of the Lazy Statistician for Two Random Variables" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186526488}]}
