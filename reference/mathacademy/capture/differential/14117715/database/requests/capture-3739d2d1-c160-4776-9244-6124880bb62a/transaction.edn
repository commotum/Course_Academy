sure [:answer/validate]} {:db/id "question-45d2a435-85e0-592b-9299-7b84a59c9bdc" :question/id #uuid "45d2a435-85e0-592b-9299-7b84a59c9bdc" :question/math-academy-id "q-181552" :question/problem "If $A={0,x,x}$, then $|A|=${{field-1}}." :question/worked-solution "The cardinality of a finite set $A$ is the number of elements in $A.$ \n\nLet's start by listing all the elements of $A:$\n\n$$\n0,\\,x\n$$\n\nNote that only *unique* elements are counted. In other words, duplicate elements are *not* counted separately.\n\nSince $A$ has $2$ elements, its cardinality is $|A|=\\text{2}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-ff261a70-dd77-5829-9611-1d18424c5b72"] :db/ensure [:question/validate]} {:db/id "answer-field-ff261a70-dd77-5829-9611-1d18424c5b72" :answer-field/id #uuid "ff261a70-dd77-5829-9611-1d18424c5b72" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-5a4dc4eb-4c61-5f77-a929-aa88f5f467a7" :answer-field/choices ["answer-5a4dc4eb-4c61-5f77-a929-aa88f5f467a7"] :db/ensure [:answer-field/validate]} {:db/id "answer-5a4dc4eb-4c61-5f77-a929-aa88f5f467a7" :answer/id #uuid "5a4dc4eb-4c61-5f77-a929-aa88f5f467a7" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "question-00c868e4-a1bc-57e3-ba66-bbd09a287031" :question/id #uuid "00c868e4-a1bc-57e3-ba66-bbd09a287031" :question/math-academy-id "q-1165" :question/problem "If $T={x,{x}^{2},{x}^{3},y,{x,{x}^{2}},{x,y,y}}$, then $|T|=$" :question/worked-solution "The cardinality of a finite set $T$ is the number of elements in $T.$ \n\nLet's start by listing all the elements of $T:$\n\n$$\nx,\\,{x}^{2},\\,{x}^{3},\\,y,\\,{x,{x}^{2}},\\,{x,y,y}\n$$\n\nNote that ${x,{x}^{2}}$ and ${x,y,y}$ each count as single elements of $T.$\n\nSince $T$ has $6$ elements, the cardinality is $|T|=6.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f597df4c-b9ee-5086-95b7-695