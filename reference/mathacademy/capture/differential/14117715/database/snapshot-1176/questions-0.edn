f 17592186045498 :db/ident :answer.type/math} :answer/value "99" :db/id #edb/ref 17592186412771} :answer-field/id #uuid "6d1ecda9-5e5d-5279-94e3-8d19798d2cd7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186412776}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e4a961ab-1e3c-56b0-9cba-38118e88cc97" :question/math-academy-id "q-181457" :question/problem "If $A=\\{1,4,7,…,295\\},$ then $|A|=${{field-1}}." :question/requires-calculator true :question/worked-solution "The cardinality of a finite set $A$ is the number of elements in $A.$ \n\nNotice that the elements of our set \n\n$$\n1,\\,4,\\,7,\\,…\n$$\n\nform an arithmetic sequence with a common difference $d=3:$\n\n$$\n\\begin{aligned}d & =3 \\\\  & =4-1 \\\\  & =7-4 \\\\  & =⋯\\end{aligned}\n$$\n\nThe $n$th term of our arithmetic sequence, denoted ${a}_{n},$ is given by\n\n$$\n\\begin{aligned}{a}_{n} & =1+(n-1)\\cdot 3 \\\\  & =1+3n-3 \\\\  & =3n-2.\\end{aligned}\n$$\n\nTherefore, we can express $A$ in set-builder notation as follows:\n\n$$\n\\begin{aligned}A & =\\{3n-2:n\\in N,\\,1\\le n\\le N\\}\\end{aligned}\n$$\n\nwhere $N\\in N$ is to be determined.\n\nTo find $N,$ we solve the following equation:\n\n$$\n\\begin{aligned}3N-2 & =295 \\\\ 3N & =297 \\\\ N & =\\frac{297}{3} \\\\ N & =99\\end{aligned}\n$$\n\nTherefore, our set $A$ can be expressed as\n\n$$\nA=\\{3n-2:n\\in N,\\,1\\le n\\le 99\\}.\n$$\n\nFinally, since $A$ has $99$ elements, we must have $|A|=99.$"}] [{:db/id #edb/ref 17592186055076 :knowledge-point/_questions [{:db/id #edb/ref 17592186054825 :knowledge-point/id #uuid "24ce056e-1fe1-55d4-b88c-62629435003b" :knowledge-point/title "Finding the Cardinality of a Set With Set Elements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d5fe4e1c-ab5b-5ec1-a3db-1c6ca03e2bb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186286733}] :answer-field/correct {:answer/id #uuid "d5fe4e1c-ab5b-5ec1-a3db-1c6ca03e2bb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186286733} :answer-field/id #uuid "b658ec00-a2a3-50cb-9e81-58ac6d728c4b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186287525}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d27ca9c4-9e63-5953-904c-030d6ce1eeb0" :question/math-academy-id "q-181469" :question/problem "If $S=\\{1,\\{2,3\\},4,\\{5,6\\}\\}$, then $|S|=${{field-1}}." :question/worked-solution "The cardinality of a finite set $S$ is the number of elements in $S.$ \n\nLet's start by listing all the elements of $S:$\n\n$$\n1,\\,\\{2,3\\},\\,4,\\,\\{5,6\\}\n$$\n\nNote that $\\{2,3\\}$ and $\\{5,6\\}$ each count as single elements of $S.$\n\nSince $S$ has $4$ elements, the cardinality is $|S|=4.$"}] [{:db/id #edb/ref 17592186413066 :knowledge-point/_questions [{:db/id #edb/ref 17592186054824 :knowledge-point/id #uuid "eb35fcff-d9f0-5ae8-999e-7e8bbc0b0919" :knowledge-point/title "Finding the Cardinality of a Finite Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a4dc4eb-4c61-5f77-a929-aa88f5f467a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186413047}] :answer-field/correct {:answer/id #uuid "5a4dc4eb-4c61-5f77-a929-aa88f5f467a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186413047} :answer-field/id #uuid "ff261a70-dd77-5829-9611-1d18424c5b72" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186413062}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "45d2a435-85e0-592b-9299-7b84a59c9bdc" :question/math-academy-id "q-181552" :question/problem "If $A=\\{0,x,x\\}$, then $|A|=${{field-1}}." :question/worked-solution "The cardinality of a finite set $A$ is the number of elements in $A.$ \n\nLet's start by listing all the elements of $A:$\n\n$$\n0,\\,x\n$$\n\nNote that only *unique* elements are counted. In other words, duplicate elements are *not* counted separately.\n\nSince $A$ has $2$ elements, its cardinality is $|A|=\\text{2}.$"}] [{:db/id #edb/ref 17592186413067 :knowledge-point/_questions [{:db/id #edb/ref 17592186054824 :knowledge-point/id #uuid "eb35fcff-d9f0-5ae8-999e-7e8bbc0b0919" :knowledge-point/title "Finding the Cardinality of a Finite Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e5a4c643-55b6-5140-9564-389a9d7a1b66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186413055}] :answer-field/correct {:answer/id #uuid "e5a4c643-55b6-5140-9564-389a9d7a1b66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186413055} :answer-field/id #uuid "3f5f187f-e2be-5835-81da-60d4d67fb8e3" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186413056}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "591c6195-4764-59fa-b788-00497885e74b" :question/math-academy-id "q-181555" :question/problem "If $B=\\{1,2,2,3,4,5,5\\}$, then $|B|=${{field-1}}." :question/worked-solution "The cardinality of a finite set $B$ is the number of elements in $B.$ \n\nLet's start by listing all the elements of $B:$\n\n$$\n1,\\,2,\\,3,\\,4,\\,5\n$$\n\nNote that only *unique* elements are counted. In other words, duplicate elements are *not* counted separately.\n\nSince $B$ has $5$ elements, its cardinality is $|B|=\\text{5}.$"}] [{:db/id #edb/ref 17592186287693 :knowledge-point/_questions [{:db/id #edb/ref 17592186054826 :knowledge-point/id #uuid "8374fcf7-6bb2-52a9-9949-20b50d7081b1" :knowledge-point/title "Sets Defined Using Arithmetic Sequences"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "febdc1f1-acd5-57f3-9817-f81f64c78b2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12552" :db/id #edb/ref 17592186287120}] :answer-field/correct {:answer/id #uuid "febdc1f1-acd5-57f3-9817-f81f64c78b2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12552" :db/id #edb/ref 17592186287120} :answer-field/id #uuid "c58e3ffa-ebd0-51f6-8bc9-7b92600f5e9b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186287550}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7be63408-71f9-55bf-92f0-6202b5253d25" :question/math-academy-id "q-181562" :question/problem "If $A=\\{2,10,18,…,100410\\},$ then $|A|=${{field-1}}." :question/worked-solution "The cardinality of a finite set $A$ is the number of elements in $A.$ \n\nNotice that the elements of our set \n\n$$\n2,\\,10,\\,18,\\,…\n$$\n\nform an arithmetic sequence with a common difference $d=8:$\n\n$$\n\\begin{aligned}d & =8 \\\\  & =10-2 \\\\  & =18-10 \\\\  & =⋯\\end{aligned}\n$$\n\nThe $n$th term of our arithmetic sequence, denoted ${a}_{n},$ is given by\n\n$$\n\\begin{aligned}{a}_{n} & =2+(n-1)\\cdot 8 \\\\  & =2+8n-8 \\\\  & =8n-6.\\end{aligned}\n$$\n\nTherefore, we can express $A$ in set-builder notation as follows:\n\n$$\n\\begin{aligned}A & =\\{8n-6:n\\in N,\\,1\\le n\\le N\\}\\end{aligned}\n$$\n\nwhere $N\\in N$ is to be determined.\n\nTo find $N,$ we solve the following equation:\n\n$$\n\\begin{aligned}8N-6 & =100\\,410 \\\\ 8N & =100\\,416 \\\\ N & =\\frac{100\\,416}{8} \\\\ N & =12\\,552\\end{aligned}\n$$\n\nTherefore, our set $A$ can be expressed as\n\n$$\nA=\\{8n-6:n\\in N,\\,1\\le n\\le 12\\,552\\}.\n$$\n\nFinally, since $A$ has $12\\,552$ elements, we must have $|A|=12\\,552.$"}] [{:db/id #edb/ref 17592186287695 :knowledge-point/_questions [{:db/id #edb/ref 17592186054826 :knowledge-point/id #uuid "8374fcf7-6bb2-52a9-9949-20b50d7081b1" :knowledge-point/title "Sets Defined Using Arithmetic Sequences"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ae43780d-d381-53a3-8d6b-71a453f52f73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,371" :db/id #edb/ref 17592186413053}] :answer-field/correct {:answer/id #uuid "ae43780d-d381-53a3-8d6b-71a453f52f73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,371" :db/id #edb/ref 17592186413053} :answer-field/id #uuid "526a4e40-b433-5ae4-b0d0-076b0cc4ea5c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186413057}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "239ea00a-c040-5335-8509-ddfe5520b423" :question/math-academy-id "q-181565" :question/problem "If $A=\\{-1\\,250,-1\\,235,-1\\,220,…,19\\,300\\},$ then $|A|=${{field-1}}." :question/worked-solution "The cardinality of a finite set $A$ is the number of elements in $A.$ \n\nNotice that the elements of our set \n\n$$\n-1\\,250,\\,-1\\,235,\\,-1\\,220,\\,…\n$$\n\nform an arithmetic sequence with a common difference $d=15:$\n\n$$\n\\begin{aligned}d & =15 \\\\  & =-1\\,235-(-1\\,250) \\\\  & =-1\\,220-(-1\\,235) \\\\  & =⋯\\end{aligned}\n$$\n\nThe $n$th term of our arithmetic sequence, denoted ${a}_{n},$ is given by\n\n$$\n\\begin{aligned}{a}_{n} & =-1\\,250\\,+(n-1)\\cdot 15 \\\\  & =-1\\,250+15n-15 \\\\  & =15n-1\\,265.\\end{aligned}\n$$\n\nTherefore, we can express $A$ in set-builder notation as follows:\n\n$$\n\\begin{aligned}A & =\\{15n-1\\,265:n\\in N,\\,1\\le n\\le N\\}\\end{aligned}\n$$\n\nwhere $N\\in N$ is to be determined.\n\nTo find $N,$ we solve the following equation:\n\n$$\n\\begin{aligned}15N-1\\,265 & =19\\,300 \\\\ 15N & =20\\,565 \\\\ N & =\\frac{20\\,565}{15} \\\\ N & =1\\,371\\end{aligned}\n$$\n\nTherefore, our set $A$ can be expressed as\n\n$$\nA=\\{15n-1\\,265:n\\in N,\\,1\\le n\\le 1\\,371\\}.\n$$\n\nFinally, since $A$ has $1\\,371$ elements, we must have $|A|=1\\,371.$"}] [{:db/id #edb/ref 17592186413065 :knowledge-point/_questions [{:db/id #edb/ref 17592186054826 :knowledge-point/id #uuid "8374fcf7-6bb2-52a9-9949-20b50d7081b1" :knowledge-point/title "Sets Defined Using Arithmetic Sequences"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "72e15f12-6167-53da-861e-1377f406055a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "515" :db/id #edb/ref 17592186413050}] :answer-field/correct {:answer/id #uuid "72e15f12-6167-53da-861e-1377f406055a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "515" :db/id #edb/ref 17592186413050} :answer-field/id #uuid "ab48e01b-c429-5203-be5f-b45cb0385cc3" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186413060}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2b21ae17-0868-5072-9b17-bf467647c322" :question/math-academy-id "q-181572" :question/problem "If $A=\\{-3\\,322,-3\\,311,-3\\,300,…,2\\,332\\},$ then $|A|=${{field-1}}." :question/worked-solution "The cardinality of a finite set $A$ is the number of elements in $A.$ \n\nNotice that the elements of our set \n\n$$\n-3\\,322,\\,-3\\,311,\\,-3\\,300,\\,…\n$$\n\nform an arithmetic sequence with a common difference $d=11:$\n\n$$\n\\begin{aligned}d & =11 \\\\  & =-3\\,311-(-3\\,322) \\\\  & =-3\\,300-(-3\\,311) \\\\  & =⋯\\end{aligned}\n$$\n\nThe $n$th term of our arithmetic sequence, denoted ${a}_{n},$ is given by\n\n$$\n\\begin{aligned}{a}_{n} & =-3\\,322\\,+(n-1)\\cdot 11 \\\\  & =-3\\,322+11n-11 \\\\  & =11n-3\\,333.\\end{aligned}\n$$\n\nTherefore, we can express $A$ in set-builder notation as follows:\n\n$$\n\\begin{aligned}A & =\\{11n-3\\,333:n\\in N,\\,1\\le n\\le N\\}\\end{aligned}\n$$\n\nwhere $N\\in N$ is to be determined.\n\nTo find $N,$ we solve the following equation:\n\n$$\n\\begin{aligned}11N-3\\,333 & =2\\,332 \\\\ 11N & =5\\,665 \\\\ N & =\\frac{5\\,665}{11} \\\\ N & =515\\end{aligned}\n$$\n\nTherefore, our set $A$ can be expressed as\n\n$$\nA=\\{11n-3\\,333:n\\in N,\\,1\\le n\\le 515\\}.\n$$\n\nFinally, since $A$ has $515$ elements, we must have $|A|=515.$"}] [{:db/id #edb/ref 17592186287697 :knowledge-point/_questions [{:db/id #edb/ref 17592186054826 :knowledge-point/id #uuid "8374fcf7-6bb2-52a9-9949-20b50d7081b1" :knowledge-point/title "Sets Defined Using Arithmetic Sequences"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "acf1bbc0-6834-528a-a563-56ccd5b2f1a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2609" :db/id #edb/ref 17592186286369}] :answer-field/correct {:answer/id #uuid "acf1bbc0-6834-528a-a563-56ccd5b2f1a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2609" :db/id #edb/ref 17592186286369} :answer-field/id #uuid "3ec5f3d1-082c-5bac-a775-9a54e6596149" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186287279}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "10f81a25-f3cd-52f3-9019-daf8c62b406b" :question/math-academy-id "q-181573" :question/problem "If $A=\\{-615,-610,-605,…,12\\,425\\},$ then $|A|=${{field-1}}." :question/worked-solution "The cardinality of a finite set $A$ is the number of elements in $A.$ \n\nNotice that the elements of our set \n\n$$\n-615,\\,-610,\\,-605,\\,…\n$$\n\nform an arithmetic sequence with a common difference $d=5:$\n\n$$\n\\begin{aligned}d & =5 \\\\  & =-610-(-615) \\\\  & =-605-(-610) \\\\  & =⋯\\end{aligned}\n$$\n\nThe $n$th term of our arithmetic sequence, denoted ${a}_{n},$ is given by\n\n$$\n\\begin{aligned}{a}_{n} & =-615+(n-1)\\cdot 5 \\\\  & =-615+5n-5 \\\\  & =5n-620.\\end{aligned}\n$$\n\nTherefore, we can express $A$ in set-builder notation as follows:\n\n$$\n\\begin{aligned}A & =\\{5n-620:n\\in N,\\,1\\le n\\le N\\}\\end{aligned}\n$$\n\nwhere $N\\in N$ is to be determined.\n\nTo find $N,$ we solve the following equation:\n\n$$\n\\begin{aligned}5N-620 & =12\\,425 \\\\ 5N & =13\\,045 \\\\ N & =\\frac{13\\,045}{5} \\\\ N & =2\\,609\\end{aligned}\n$$\n\nTherefore, our set $A$ can be expressed as\n\n$$\nA=\\{5n-620:n\\in N,\\,1\\le n\\le 2\\,609\\}.\n$$\n\nFinally, since $A$ has $2\\,609$ elements, we must have $|A|=2\\,609.$"}] [{:db/id #edb/ref 17592186287699 :knowledge-point/_questions [{:db/id #edb/ref 17592186054827 :knowledge-point/id #uuid "ebc025a5-9c66-5ddc-a12c-42595f905c17" :knowledge-point/title "Sets Defined Using Geometric Sequences"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a2217fe-dcb0-50c0-a6fb-3520c1b699bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186285758}] :answer-field/correct {:answer/id #uuid "6a2217fe-dcb0-50c0-a6fb-3520c1b699bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186285758} :answer-field/id #uuid "4edde710-adcb-56b7-b1ea-8ff3a64cc3b2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186287322}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0f3f92d9-7968-5a40-b27d-a5448f33107a" :question/math-academy-id "q-181576" :question/problem "If $A=\\{2,10,50,250,…,2\\,441\\,406\\,250\\},$ then $|A|=${{field-1}}." :question/worked-solution "The cardinality of a finite set $A$ is the number of elements in $A.$ \n\nNotice that the elements of our set \n\n$$\n2,\\,10,\\,50,\\,250,\\,…\n$$\n\nform a geometric sequence with a common ratio $r=5:$\n\n$$\n\\begin{aligned}r & =5 \\\\  & =\\frac{10}{2} \\\\  & =\\frac{50}{10} \\\\  & =⋯\\end{aligned}\n$$\n\nThe $n$th term of our geometric sequence, denoted ${a}_{n},$ is given by\n\n$$\n{a}_{n}={a}_{1}{r}^{n-1}=2({5}^{n-1})=\\frac{2}{5}(5)^{n}.\n$$\n\nTherefore, we can express $A$ in set-builder notation as follows:\n\n$$\nA=\\{\\frac{2}{5}(5)^{n}:n\\in N,\\,1\\le n\\le N\\}\n$$\n\nwhere $N\\in N$ is to be determined.\n\nTo find $N,$ we solve the following equation:\n\n$$\n\\begin{aligned}\\frac{2}{5}(5)^{N} & =2\\,441\\,406\\,250 \\\\ {5}^{N} & =6\\,103\\,515\\,625 \\\\ N & ={log}_{5}⁡(6\\,103\\,515\\,625) \\\\ N & =\\frac{{log}_{10}⁡(6\\,103\\,515\\,625)}{{log}_{10}⁡(5)} \\\\ N & =14\\end{aligned}\n$$\n\nTherefore, our set $A$ can be expressed as\n\n$$\nA=\\{\\frac{2}{5}(5)^{n}:n\\in N,\\,1\\le n\\le 14\\}.\n$$\n\nFinally, since $A$ has $14$ elements, we must have $|A|=14.$"}] [{:db/id #edb/ref 17592186413064 :knowledge-point/_questions [{:db/id #edb/ref 17592186054827 :knowledge-point/id #uuid "ebc025a5-9c66-5ddc-a12c-42595f905c17" :knowledge-point/title "Sets Defined Using Geometric Sequences"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d7b2fd89-a660-5176-a690-d8f8260781b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186413054}] :answer-field/correct {:answer/id #uuid "d7b2fd89-a660-5176-a690-d8f8260781b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186413054} :answer-field/id #uuid "757b53fd-f4bb-5830-9604-cf22f83bd7d5" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186413059}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0347061a-970d-5566-8d6a-57e3c30b6fb2" :question/math-academy-id "q-181577" :question/problem "If $A=\\{5,20,80,320,…,5\\,368\\,709\\,120\\},$ then $|A|=${{field-1}}." :question/worked-solution "The cardinality of a finite set $A$ is the number of elements in $A.$ \n\nNotice that the elements of our set \n\n$$\n5,\\,20,\\,80,\\,320,\\,…\n$$\n\nform a geometric sequence with a common ratio $r=4:$\n\n$$\n\\begin{aligned}r & =4 \\\\  & =\\frac{20}{5} \\\\  & =\\frac{80}{20} \\\\  & =⋯\\end{aligned}\n$$\n\nThe $n$th term of our geometric sequence, denoted ${a}_{n},$ is given by\n\n$$\n{a}_{n}={a}_{1}{r}^{n-1}=5({4}^{n-1})=\\frac{5}{4}(4)^{n}.\n$$\n\nTherefore, we can express $A$ in set-builder notation as follows:\n\n$$\nA=\\{\\frac{5}{4}(4)^{n}:n\\in N,\\,1\\le n\\le N\\}\n$$\n\nwhere $N\\in N$ is to be determined.\n\nTo find $N,$ we solve the following equation:\n\n$$\n\\begin{aligned}\\frac{5}{4}(4)^{N} & =5\\,368\\,709\\,120 \\\\ {4}^{N} & =4\\,294\\,967\\,296 \\\\ N & ={log}_{4}⁡(4\\,294\\,967\\,296) \\\\ N & =\\frac{{log}_{10}⁡(4\\,294\\,967\\,296)}{{log}_{10}⁡(4)} \\\\ N & =16\\end{aligned}\n$$\n\nTherefore, our set $A$ can be expressed as\n\n$$\nA=\\{\\frac{5}{4}(4)^{n}:n\\in N,\\,1\\le n\\le 16\\}.\n$$\n\nFinally, since $A$ has $16$ elements, we must have $|A|=16.$"}] [{:db/id #edb/ref 17592186287700 :knowledge-point/_questions [{:db/id #edb/ref 17592186054827 :knowledge-point/id #uuid "ebc025a5-9c66-5ddc-a12c-42595f905c17" :knowledge-point/title "Sets Defined Using Geometric Sequences"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d5127f79-84ec-5a63-9053-8fc55f00b0c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186286727}] :answer-field/correct {:answer/id #uuid "d5127f79-84ec-5a63-9053-8fc55f00b0c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186286727} :answer-field/id #uuid "d0da287a-f97d-535e-8052-a16a00840c54" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186287576}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9b8a1a95-0f23-5970-9fcd-2420a63c21a8" :question/math-academy-id "q-181578" :question/problem "If $A=\\{3,18,108,648,…,181\\,398\\,528\\},$ then $|A|=${{field-1}}." :question/worked-solution "The cardinality of a finite set $A$ is the number of elements in $A.$ \n\nNotice that the elements of our set \n\n$$\n3,\\,18,\\,108,\\,648,\\,…\n$$\n\nform a geometric sequence with a common ratio $r=6:$\n\n$$\n\\begin{aligned}r & =6 \\\\  & =\\frac{18}{3} \\\\  & =\\frac{108}{18} \\\\  & =⋯\\end{aligned}\n$$\n\nThe $n$th term of our geometric sequence, denoted ${a}_{n},$ is given by\n\n$$\n{a}_{n}={a}_{1}{r}^{n-1}=3({6}^{n-1})=\\frac{1}{2}(6)^{n}.\n$$\n\nTherefore, we can express $A$ in set-builder notation as follows:\n\n$$\nA=\\{\\frac{1}{2}(6)^{n}:n\\in N,\\,1\\le n\\le N\\}\n$$\n\nwhere $N\\in N$ is to be determined.\n\nTo find $N,$ we solve the following equation:\n\n$$\n\\begin{aligned}\\frac{1}{2}(6)^{N} & =181\\,398\\,528 \\\\ {6}^{N} & =362\\,797\\,056 \\\\ N & ={log}_{6}⁡(362\\,797\\,056) \\\\ N & =\\frac{{log}_{10}⁡(362\\,797\\,056)}{{log}_{10}⁡(6)} \\\\ N & =11\\end{aligned}\n$$\n\nTherefore, our set $A$ can be expressed as\n\n$$\nA=\\{\\frac{1}{2}(6)^{n}:n\\in N,\\,1\\le n\\le 11\\}.\n$$\n\nFinally, since $A$ has $11$ elements, we must have $|A|=11.$"}] [{:db/id #edb/ref 17592186413068 :knowledge-point/_questions [{:db/id #edb/ref 17592186054827 :knowledge-point/id #uuid "ebc025a5-9c66-5ddc-a12c-42595f905c17" :knowledge-point/title "Sets Defined Using Geometric Sequences"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "393db834-e593-560c-987f-8e69f57279cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186413045}] :answer-field/correct {:answer/id #uuid "393db834-e593-560c-987f-8e69f57279cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186413045} :answer-field/id #uuid "6003be51-464a-5fff-b640-c989db581606" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186413058}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9bc860de-458f-50fe-a95e-897939b46d0f" :question/math-academy-id "q-181581" :question/problem "If $A=\\{1,5,25,125,…,30\\,517\\,578\\,125\\},$ then $|A|=${{field-1}}." :question/worked-solution "The cardinality of a finite set $A$ is the number of elements in $A.$ \n\nNotice that the elements of our set \n\n$$\n1,\\,5,\\,25,\\,125,\\,…\n$$\n\nform a geometric sequence with a common ratio $r=5:$\n\n$$\n\\begin{aligned}r & =5 \\\\  & =\\frac{5}{1} \\\\  & =\\frac{25}{5} \\\\  & =⋯\\end{aligned}\n$$\n\nThe $n$th term of our geometric sequence, denoted ${a}_{n},$ is given by\n\n$$\n{a}_{n}={a}_{1}{r}^{n-1}=1\\cdot {5}^{n-1}={5}^{n-1}.\n$$\n\nTherefore, we can express $A$ in set-builder notation as follows:\n\n$$\nA=\\{{5}^{n-1}:n\\in N,\\,1\\le n\\le N\\}\n$$\n\nwhere $N\\in N$ is to be determined.\n\nTo find $N,$ we solve the following equation:\n\n$$\n\\begin{aligned}{5}^{N-1} & =30\\,517\\,578\\,125 \\\\ N-1 & ={log}_{5}⁡(30\\,517\\,578\\,125) \\\\ N-1 & =\\frac{{log}_{10}⁡(30\\,517\\,578\\,125)}{{log}_{10}⁡(5)} \\\\ N-1 & =15 \\\\ N & =16\\end{aligned}\n$$\n\nTherefore, our set $A$ can be expressed as\n\n$$\nA=\\{{5}^{n-1}:n\\in N,\\,1\\le n\\le 16\\}.\n$$\n\nFinally, since $A$ has $16$ elements, we must have $|A|=16.$"}] [{:db/id #edb/ref 17592186287702 :knowledge-point/_questions [{:db/id #edb/ref 17592186054827 :knowledge-point/id #uuid "ebc025a5-9c66-5ddc-a12c-42595f905c17" :knowledge-point/title "Sets Defined Using Geometric Sequences"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c04387e-2de4-5007-8a28-35e3647172d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186285629}] :answer-field/correct {:answer/id #uuid "5c04387e-2de4-5007-8a28-35e3647172d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186285629} :answer-field/id #uuid "fa2f9327-45dd-55ee-a150-8f7cf0251230" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186287655}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dce5ff3b-6287-5298-b5a6-85554a4237ac" :question/math-academy-id "q-181583" :question/problem "If $A=\\{1,11,121,1\\,331,…,214\\,358\\,881\\},$ then $|A|=${{field-1}}." :question/worked-solution "The cardinality of a finite set $A$ is the number of elements in $A.$ \n\nNotice that the elements of our set \n\n$$\n1,\\,11,\\,121,\\,1\\,331,\\,…\n$$\n\nform a geometric sequence with a common ratio $r=11:$\n\n$$\n\\begin{aligned}r & =11 \\\\  & =\\frac{11}{1} \\\\  & =\\frac{121}{11} \\\\  & =⋯\\end{aligned}\n$$\n\nThe $n$th term of our geometric sequence, denoted ${a}_{n},$ is given by\n\n$$\n{a}_{n}={a}_{1}{r}^{n-1}=1\\cdot {11}^{n-1}={11}^{n-1}.\n$$\n\nTherefore, we can express $A$ in set-builder notation as follows:\n\n$$\nA=\\{{11}^{n-1}:n\\in N,\\,1\\le n\\le N\\}\n$$\n\nwhere $N\\in N$ is to be determined.\n\nTo find $N,$ we solve the following equation:\n\n$$\n\\begin{aligned}{11}^{N-1} & =214\\,358\\,881 \\\\ N-1 & ={log}_{11}⁡(214\\,358\\,881) \\\\ N-1 & =\\frac{{log}_{10}⁡(214\\,358\\,881)}{{log}_{10}⁡(11)} \\\\ N-1 & =8 \\\\ N & =9\\end{aligned}\n$$\n\nTherefore, our set $A$ can be expressed as\n\n$$\nA=\\{{11}^{n-1}:n\\in N,\\,1\\le n\\le 9\\}.\n$$\n\nFinally, since $A$ has $9$ elements, we must have $|A|=9.$"}] [{:db/id #edb/ref 17592186055084 :knowledge-point/_questions [{:db/id #edb/ref 17592186054825 :knowledge-point/id #uuid "24ce056e-1fe1-55d4-b88c-62629435003b" :knowledge-point/title "Finding the Cardinality of a Set With Set Elements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "96c624a4-33e9-50f1-b149-8677232ff800" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186286159}] :answer-field/correct {:answer/id #uuid "96c624a4-33e9-50f1-b149-8677232ff800" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186286159} :answer-field/id #uuid "250f5b78-87ba-51e2-bbed-2bacf98c1ca1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186287228}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0cc7fe95-b089-501e-a708-9894e7faa612" :question/math-academy-id "q-181589" :question/problem "If $T=\\{\\{\\},x,y,\\{v,x,\\{w\\}\\}\\},$ then $|T|=${{field-1}}." :question/worked-solution "The cardinality of a finite set $T$ is the number of elements in $T.$ \n\nLet's start by listing all the elements of $T:$\n\n$$\n\\{\\},\\,x,\\,y,\\,\\{v,x,\\{w\\}\\},\n$$\n\nNote that $\\{v,x,\\{w\\}\\}$ and $\\{\\}$ count as single elements of $T.$\n\nSince $T$ has $3$ elements, the cardinality is $|T|=4.$"}] [{:db/id #edb/ref 17592186348380 :knowledge-point/_questions [{:db/id #edb/ref 17592186054825 :knowledge-point/id #uuid "24ce056e-1fe1-55d4-b88c-62629435003b" :knowledge-point/title "Finding the Cardinality of a Set With Set Elements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c68dbc2-e6b7-501d-b25e-6bd6f0fd1caf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186345748} {:answer/id #uuid "b21b3f90-2f3c-5581-8c4d-00da7e3bd18e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186346904} {:answer/id #uuid "c575442d-0eec-5eb3-910d-3a5d3655b372" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186347064} {:answer/id #uuid "fa792f2f-9ce2-56d5-99f7-a013c1d0680e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186347564} {:answer/id #uuid "fe92b363-d9f3-5ed4-9317-408d9b4f2fc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186347589}] :answer-field/correct {:answer/id #uuid "fe92b363-d9f3-5ed4-9317-408d9b4f2fc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186347589} :answer-field/id #uuid "b5bf5b9c-f27b-5975-9cf3-615c32854daf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347924}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c70367e7-3689-592b-be67-c8b4a8c81e8b" :question/math-academy-id "q-80447" :question/problem "If $Y=\\{1,2,\\{\\{2\\}\\},3,2,4,\\{\\{∅\\}\\},4\\}$, then $|Y|=$" :question/worked-solution "The cardinality of a finite set $Y$ is the number of elements in $Y.$ \n\nLet's start by listing all the elements of $Y:$\n\n$$\n1,\\,2,\\,\\{\\{2\\}\\},\\,3,\\,4,\\,\\{\\{∅\\}\\}\n$$\n\nNote the following:\n\n- Only *unique* elements are counted. In other words, duplicate elements are *not* counted separately.\n\n- $\\{\\{2\\}\\}$ and $\\{\\{∅\\}\\}$ each count as single elements of $Y.$\n\nSince $Y$ has $6$ elements, the cardinality is $|Y|=6.$"}]}
