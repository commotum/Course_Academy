#{[{:db/id #edb/ref 17592186233196 :knowledge-point/_questions [{:db/id #edb/ref 17592186096633 :knowledge-point/id #uuid "29b136d3-69bc-51ef-a262-dbee8af377d2" :knowledge-point/title "Expressing a Definite Integral as the Limit of a Right Riemann Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9848c8b6-63aa-585c-9c3f-f09cf6a49bc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[{e}^{k/n}\\cdot \\frac{4}{n}]" :db/id #edb/ref 17592186386725} {:answer/id #uuid "4af5c4a2-1d06-5974-840c-84a0c9369afb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[{e}^{4k/n}\\cdot \\frac{1}{n}]" :db/id #edb/ref 17592186386726} {:answer/id #uuid "0436ef1f-f984-5be7-bbed-df86ab8e327f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[{e}^{2k/n}\\cdot \\frac{1}{2n}]" :db/id #edb/ref 17592186386727} {:answer/id #uuid "e02ec00a-498c-51f8-80b1-0c65fcdd05c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[{e}^{2k/n}\\cdot \\frac{2}{n}]" :db/id #edb/ref 17592186386728} {:answer/id #uuid "092157f2-38d5-50ad-be92-7e9d8c56698d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[{e}^{k/n}\\cdot \\frac{2}{n}]" :db/id #edb/ref 17592186386729}] :answer-field/correct {:answer/id #uuid "e02ec00a-498c-51f8-80b1-0c65fcdd05c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[{e}^{2k/n}\\cdot \\frac{2}{n}]" :db/id #edb/ref 17592186386728} :answer-field/id #uuid "a11b3b07-1feb-5e0e-9468-621e3b27f6c7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386724}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4385816f-7b9c-5f55-bc1f-96c9f8bc0f20" :question/math-academy-id "q-113927" :question/problem "What is ${\\int }_{0}^{2}{e}^{x}\\,\\text{d}x$ expressed as the limit of a right Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a right Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}f({x}_{k})\\cdot Δx,\n$$\n\nwhere ${x}_{k}=a+kΔx$ and $Δx=\\frac{b-a}{n}.$\n\nIn the definite integral\n\n$$\n{\\int }_{0}^{2}{e}^{x}\\,\\text{d}x,\n$$\n\nthe function is $f(x)={e}^{x},$ the lower bound is $a=0$ and the upper bound is $b=2.$ So, we have\n\n$$\nΔx=\\frac{2-0}{n}=\\frac{2}{n}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}{e}^{x}\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}f({x}_{k})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[f(0+k\\cdot \\frac{2}{n})\\cdot \\frac{2}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[f(\\frac{2k}{n})\\cdot \\frac{2}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[{e}^{2k/n}\\cdot \\frac{2}{n}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186097262 :knowledge-point/_questions [{:db/id #edb/ref 17592186096632 :knowledge-point/id #uuid "4f663b0b-9b5e-512c-92bb-0ea84d5baac5" :knowledge-point/title "Expressing the Limit of a Left Riemann Sum as a Definite Integral"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "df5173ee-d58e-5502-9f55-40f02b3cb645" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(x) = (x + 7)^{2}$ and $b = 7$" :db/id #edb/ref 17592186095497} {:answer/id #uuid "1cf19a3a-226b-5d38-9f2b-d0acc2bf86e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(x) = (x + 5)^{2}$ and $b = 7$" :db/id #edb/ref 17592186095498} {:answer/id #uuid "3cb7358e-b887-5610-afc0-15427e1caa61" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(x) = x^{2}$ and $b = 7$" :db/id #edb/ref 17592186095499} {:answer/id #uuid "4fcc362d-f631-5a5d-a178-3df03826f7e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(x) = (x + 5)^{2}$ and $b = 5$" :db/id #edb/ref 17592186095500} {:answer/id #uuid "57123e6b-d11d-5bf8-80ec-4751c9b3bf05" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(x) = x^{2}$ and $b = 5$" :db/id #edb/ref 17592186095501}] :answer-field/id #uuid "43b321c2-9077-5149-9560-7176040f6a14" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186095496} {:answer-field/choices [{:answer/id #uuid "4a60d2e3-526f-5102-9725-20adf27ff09f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(x)=(x+5)^{2}$ and $b=5$" :db/id #edb/ref 17592186366153} {:answer/id #uuid "956bfc43-cbe9-5c70-afb3-2ec9e07e4855" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(x)={x}^{2}$ and $b=5$" :db/id #edb/ref 17592186366154} {:answer/id #uuid "0e292bf6-f233-544c-be90-3f443f1e8745" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(x)={x}^{2}$ and $b=7$" :db/id #edb/ref 17592186366155} {:answer/id #uuid "e542d1e2-f6ee-58c6-9b96-6f23061dda78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(x)=(x+7)^{2}$ and $b=7$" :db/id #edb/ref 17592186366156} {:answer/id #uuid "d569e473-f85e-560f-9a93-2537c1213925" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(x)=(x+5)^{2}$ and $b=7$" :db/id #edb/ref 17592186366157}] :answer-field/correct {:answer/id #uuid "0e292bf6-f233-544c-be90-3f443f1e8745" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(x)={x}^{2}$ and $b=7$" :db/id #edb/ref 17592186366155} :answer-field/id #uuid "2cb235b7-5aa3-5617-a84a-c783d3c7a7ff" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366152}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6798d466-87fa-5086-ac4a-cf1eac1b223b" :question/math-academy-id "q-49141" :question/problem "Find the function $f(x)$ and the value of $b,$ given that ${\\int }_{2}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}[{(2+\\frac{5k}{n})}^{2}\\cdot \\frac{5}{n}].$" :question/worked-solution "A definite integral can be defined as the limit of a left Riemann sum as follows:\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}f({x}_{k})\\cdot Δx\n$$\n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{k}=a+kΔx.$\n\nNotice that we're given that the lower limit $a=2.$ \n\nComparing the given summation with the general expression above, we see that $Δx=\\frac{5}{n}.$ Therefore, \n\n$$\n\\frac{5}{n}=\\frac{b-2}{n}\\,⟹\\,b=7.\n$$\n\nConsequently, ${x}_{k}=2+\\frac{5k}{n}$ and $f({x}_{k})={x}_{k}^{2}.$\n\nHence,\n\n$$\n{\\int }_{2}^{7}{x}^{2}\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}[{(2+\\frac{5k}{n})}^{2}\\cdot \\frac{5}{n}].\n$$\n\nTherefore, the correct answer is $f(x)={x}^{2}$ and $b=7.$"}] [{:db/id #edb/ref 17592186393250 :knowledge-point/_questions [{:db/id #edb/ref 17592186096631 :knowledge-point/id #uuid "cdc82e49-5df6-5096-a8fd-e00017fb1e3a" :knowledge-point/title "Expressing a Definite Integral as the Limit of a Left Riemann Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ce3626c4-68fc-5111-92bb-c6a72ef04b3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[ln⁡(e+\\frac{4ie}{n})\\cdot \\frac{4e}{n}]" :db/id #edb/ref 17592186393252} {:answer/id #uuid "51976397-23e1-57d8-a039-644bf6317f62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{(-2i/n)}\\cdot \\frac{1}{n}]" :db/id #edb/ref 17592186393253} {:answer/id #uuid "9d2df163-f8cb-55a5-aa92-94fe12f6f8d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[ln⁡(e+\\frac{2ie}{n})\\cdot \\frac{2e}{n}]" :db/id #edb/ref 17592186393254} {:answer/id #uuid "680c2096-a3a6-56c7-af41-ad8e3a2a9b3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{(2i/n)}\\cdot \\frac{2}{n}]" :db/id #edb/ref 17592186393255} {:answer/id #uuid "7e48b7d1-54ea-5e38-b291-212dbf407565" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[ln⁡(e+\\frac{ie}{n})\\cdot \\frac{e}{n}]" :db/id #edb/ref 17592186393256}] :answer-field/correct {:answer/id #uuid "9d2df163-f8cb-55a5-aa92-94fe12f6f8d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[ln⁡(e+\\frac{2ie}{n})\\cdot \\frac{2e}{n}]" :db/id #edb/ref 17592186393254} :answer-field/id #uuid "ae6ae5ee-b93f-55d8-b530-ad34a29b014a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393251}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d2f3eda7-3ae2-5c51-adcd-171934d8313e" :question/math-academy-id "q-73156" :question/problem "What is ${\\int }_{e}^{3e}ln⁡x\\,\\text{d}x$ expressed as the limit of a left Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a left Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx,\n$$\n\n    \n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{i}=a+iΔx.$\n\nIn the definite integral\n\n$$\n{\\int }_{e}^{3e}ln⁡x\\,\\text{d}x,\n$$\n\nthe function is $f(x)=ln⁡x,$ the lower bound is $a=e,$ and the upper bound is $b=3e.$ So, we have\n\n$$\nΔx=\\frac{3e-e}{n}=\\frac{2e}{n},\n$$\n\nand therefore\n\n$$\n\\begin{aligned}{\\int }_{e}^{3e}ln⁡x\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[f(e+i\\cdot \\frac{2e}{n})\\cdot \\frac{2e}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[f(e+\\frac{2ie}{n})\\cdot \\frac{2e}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[ln⁡(e+\\frac{2ie}{n})\\cdot \\frac{2e}{n}].\\end{aligned}\n$$"}]}
