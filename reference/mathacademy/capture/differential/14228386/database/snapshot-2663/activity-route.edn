#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186551464} :activity/id #uuid "8c741e1d-cd57-5c83-a8c8-16d24858c4c6" :activity/scope {:db/id #edb/ref 17592186048862 :topic/id #uuid "c7162eba-3656-5b62-8b28-391c01075d02" :topic/math-academy-id 1086} :activity/steps [{:db/id #edb/ref 17592186551393 :step/content {:db/id #edb/ref 17592186551357 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28f1f4b7-57c0-56e1-a117-8415a85c841e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{(3+\\frac{2i}{n})}^{2}\\cdot \\frac{3}{n}]" :db/id #edb/ref 17592186550468} {:answer/id #uuid "34501985-19ea-50dc-8d60-3b788c0405c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{(3+\\frac{2i}{n})}^{2}\\cdot \\frac{2}{n}]" :db/id #edb/ref 17592186550497} {:answer/id #uuid "51e949c9-0d0e-5fdb-bb95-ab16798be0f2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{(1+\\frac{2i}{n})}^{2}\\cdot \\frac{2}{n}]" :db/id #edb/ref 17592186550562} {:answer/id #uuid "6591ea6e-2346-5c79-acf4-89b87782b7b7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{(1+\\frac{i}{n})}^{2}\\cdot \\frac{1}{n}]" :db/id #edb/ref 17592186550616} {:answer/id #uuid "dfa0ac59-d407-5702-ab18-aa0299efd7dc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{(1+\\frac{4i}{n})}^{2}\\cdot \\frac{4}{n}]" :db/id #edb/ref 17592186550978}] :answer-field/correct {:db/id #edb/ref 17592186550497} :answer-field/id #uuid "2bc5e161-63d6-5b2f-8b4b-8f2692b551e3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186551091}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "fea7dc0c-332b-5e65-b34c-aa74602e656a" :question/math-academy-id "q-113885" :question/problem "What is ${\\int }_{2}^{4}(x+1)^{2}\\,\\text{d}x$ expressed as the limit of a left Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a left Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx,\n$$\n\n    \n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{i}=a+iΔx.$\n\nIn the definite integral\n\n$$\n{\\int }_{2}^{4}(x+1)^{2}\\,\\text{d}x,\n$$\n\nthe function is $f(x)=(x+1)^{2},$ the lower bound is $a=2,$ and the upper bound is $b=4.$ So, we have\n\n$$\nΔx=\\frac{4-2}{n}=\\frac{2}{n},\n$$\n\nand therefore\n\n$$\n\\begin{aligned}{\\int }_{2}^{4}(x+1)^{2}\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[f(2+i\\cdot \\frac{2}{n})\\,\\cdot \\frac{2}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[f(2+\\frac{2i}{n})\\cdot \\frac{2}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{(2+\\frac{2i}{n}+1)}^{2}\\cdot \\frac{2}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{(3+\\frac{2i}{n})}^{2}\\cdot \\frac{2}{n}].\\end{aligned}\n$$"} :step/id #uuid "41bf41e2-b064-5bb6-9ccc-30e9675ed161" :step/next {:db/id #edb/ref 17592186551452}} {:db/id #edb/ref 17592186551414 :step/content {:db/id #edb/ref 17592186551235 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "67ea339c-2b2b-5d4d-87b1-7c6bc85069c4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$f(x)={x}^{3}$ and $b=3$" :db/id #edb/ref 17592186550624} {:answer/id #uuid "726d3224-ba57-579d-ae29-183da135a7ac" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$f(x)=x$ and $b=5$" :db/id #edb/ref 17592186550655} {:answer/id #uuid "a2a12a2b-40b0-5e22-9231-966dc3b78cb8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$f(x)=4{x}^{3}$ and $b=3$" :db/id #edb/ref 17592186550789} {:answer/id #uuid "ace7f773-c717-5546-8619-944725dddd02" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$f(x)=4{x}^{3}$ and $b=5$" :db/id #edb/ref 17592186550834} {:answer/id #uuid "b72f4429-d885-5f60-880a-67e28d6f6c64" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$f(x)=4x$ and $b=3$" :db/id #edb/ref 17592186550869}] :answer-field/correct {:db/id #edb/ref 17592186550789} :answer-field/id #uuid "0a33f6fd-b93c-5b4f-b219-979a3489cf29" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186551067}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "0eabe319-fbfe-5f66-832c-db699322266a" :question/math-academy-id "q-114899" :question/problem "Find the function $f(x)$ and the value of $b,$ given that ${\\int }_{2}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}[4{(2+\\frac{k}{n})}^{3}\\cdot \\frac{1}{n}].$" :question/worked-solution "A definite integral can be defined as the limit of a left Riemann sum as follows:\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}f({x}_{k})\\cdot Δx\n$$\n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{k}=a+kΔx.$\n\nNotice that we're given that the lower limit $a=2.$ \n\nComparing the given summation with the general expression above, we see that $Δx=\\frac{1}{n}.$ Therefore, \n\n$$\n\\frac{1}{n}=\\frac{b-2}{n}\\,⟹\\,b=3.\n$$\n\nConsequently,  ${x}_{k}=2+\\frac{k}{n}$ and $f({x}_{k})=4{x}_{k}^{3}.$\n\nHence,\n\n$$\n{\\int }_{2}^{3}4{x}^{3}\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}[4{(2+\\frac{k}{n})}^{3}\\cdot \\frac{1}{n}].\n$$\n\nTherefore, the correct answer is $f(x)=4{x}^{3}$ and $b=3.$"} :step/id #uuid "7a912a6d-06e4-5b08-99d4-ffcd3c9c8150"} {:db/id #edb/ref 17592186551423 :step/content {:db/id #edb/ref 17592186393250 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ce3626c4-68fc-5111-92bb-c6a72ef04b3f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[\\operatorname{ln}⁡(e+\\frac{4ie}{n})\\cdot \\frac{4e}{n}]" :db/id #edb/ref 17592186393252} {:answer/id #uuid "51976397-23e1-57d8-a039-644bf6317f62" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{(-2i/n)}\\cdot \\frac{1}{n}]" :db/id #edb/ref 17592186393253} {:answer/id #uuid "9d2df163-f8cb-55a5-aa92-94fe12f6f8d2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[\\operatorname{ln}⁡(e+\\frac{2ie}{n})\\cdot \\frac{2e}{n}]" :db/id #edb/ref 17592186393254} {:answer/id #uuid "680c2096-a3a6-56c7-af41-ad8e3a2a9b3e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{(2i/n)}\\cdot \\frac{2}{n}]" :db/id #edb/ref 17592186393255} {:answer/id #uuid "7e48b7d1-54ea-5e38-b291-212dbf407565" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[\\operatorname{ln}⁡(e+\\frac{ie}{n})\\cdot \\frac{e}{n}]" :db/id #edb/ref 17592186393256}] :answer-field/correct {:db/id #edb/ref 17592186393254} :answer-field/id #uuid "ae6ae5ee-b93f-55d8-b530-ad34a29b014a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186393251}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d2f3eda7-3ae2-5c51-adcd-171934d8313e" :question/math-academy-id "q-73156" :question/problem "What is ${\\int }_{e}^{3e}\\operatorname{ln}⁡x\\,\\text{d}x$ expressed as the limit of a left Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a left Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx,\n$$\n\n    \n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{i}=a+iΔx.$\n\nIn the definite integral\n\n$$\n{\\int }_{e}^{3e}\\operatorname{ln}⁡x\\,\\text{d}x,\n$$\n\nthe function is $f(x)=\\operatorname{ln}⁡x,$ the lower bound is $a=e,$ and the upper bound is $b=3e.$ So, we have\n\n$$\nΔx=\\frac{3e-e}{n}=\\frac{2e}{n},\n$$\n\nand therefore\n\n$$\n\\begin{aligned}{\\int }_{e}^{3e}\\operatorname{ln}⁡x\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[f(e+i\\cdot \\frac{2e}{n})\\cdot \\frac{2e}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[f(e+\\frac{2ie}{n})\\cdot \\frac{2e}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[\\operatorname{ln}⁡(e+\\frac{2ie}{n})\\cdot \\frac{2e}{n}].\\end{aligned}\n$$"} :step/id #uuid "8a4c4ba2-931e-5de8-95fc-f866b5f90f9a" :step/next {:db/id #edb/ref 17592186551393}} {:db/id #edb/ref 17592186551452 :step/content {:db/id #edb/ref 17592186233196 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9848c8b6-63aa-585c-9c3f-f09cf6a49bc9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[{e}^{k/n}\\cdot \\frac{4}{n}]" :db/id #edb/ref 17592186386725} {:answer/id #uuid "4af5c4a2-1d06-5974-840c-84a0c9369afb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[{e}^{4k/n}\\cdot \\frac{1}{n}]" :db/id #edb/ref 17592186386726} {:answer/id #uuid "0436ef1f-f984-5be7-bbed-df86ab8e327f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[{e}^{2k/n}\\cdot \\frac{1}{2n}]" :db/id #edb/ref 17592186386727} {:answer/id #uuid "e02ec00a-498c-51f8-80b1-0c65fcdd05c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[{e}^{2k/n}\\cdot \\frac{2}{n}]" :db/id #edb/ref 17592186386728} {:answer/id #uuid "092157f2-38d5-50ad-be92-7e9d8c56698d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[{e}^{k/n}\\cdot \\frac{2}{n}]" :db/id #edb/ref 17592186386729}] :answer-field/correct {:db/id #edb/ref 17592186386728} :answer-field/id #uuid "a11b3b07-1feb-5e0e-9468-621e3b27f6c7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186386724}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4385816f-7b9c-5f55-bc1f-96c9f8bc0f20" :question/math-academy-id "q-113927" :question/problem "What is ${\\int }_{0}^{2}{e}^{x}\\,\\text{d}x$ expressed as the limit of a right Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a right Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}f({x}_{k})\\cdot Δx,\n$$\n\nwhere ${x}_{k}=a+kΔx$ and $Δx=\\frac{b-a}{n}.$\n\nIn the definite integral\n\n$$\n{\\int }_{0}^{2}{e}^{x}\\,\\text{d}x,\n$$\n\nthe function is $f(x)={e}^{x},$ the lower bound is $a=0$ and the upper bound is $b=2.$ So, we have\n\n$$\nΔx=\\frac{2-0}{n}=\\frac{2}{n}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}{e}^{x}\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}f({x}_{k})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[f(0+k\\cdot \\frac{2}{n})\\cdot \\frac{2}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[f(\\frac{2k}{n})\\cdot \\frac{2}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[{e}^{2k/n}\\cdot \\frac{2}{n}].\\end{aligned}\n$$"} :step/id #uuid "d3e0a0e9-2ae7-5e40-acb0-bc04b722390d" :step/next {:db/id #edb/ref 17592186551414}} {:db/id #edb/ref 17592186551464 :step/content {:db/id #edb/ref 17592186097262 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a60d2e3-526f-5102-9725-20adf27ff09f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$f(x)=(x+5)^{2}$ and $b=5$" :db/id #edb/ref 17592186366153} {:answer/id #uuid "956bfc43-cbe9-5c70-afb3-2ec9e07e4855" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$f(x)={x}^{2}$ and $b=5$" :db/id #edb/ref 17592186366154} {:answer/id #uuid "0e292bf6-f233-544c-be90-3f443f1e8745" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$f(x)={x}^{2}$ and $b=7$" :db/id #edb/ref 17592186366155} {:answer/id #uuid "e542d1e2-f6ee-58c6-9b96-6f23061dda78" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$f(x)=(x+7)^{2}$ and $b=7$" :db/id #edb/ref 17592186366156} {:answer/id #uuid "d569e473-f85e-560f-9a93-2537c1213925" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$f(x)=(x+5)^{2}$ and $b=7$" :db/id #edb/ref 17592186366157}] :answer-field/correct {:db/id #edb/ref 17592186366155} :answer-field/id #uuid "2cb235b7-5aa3-5617-a84a-c783d3c7a7ff" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186366152}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "6798d466-87fa-5086-ac4a-cf1eac1b223b" :question/math-academy-id "q-49141" :question/problem "Find the function $f(x)$ and the value of $b,$ given that ${\\int }_{2}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}[{(2+\\frac{5k}{n})}^{2}\\cdot \\frac{5}{n}].$" :question/worked-solution "A definite integral can be defined as the limit of a left Riemann sum as follows:\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}f({x}_{k})\\cdot Δx\n$$\n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{k}=a+kΔx.$\n\nNotice that we're given that the lower limit $a=2.$ \n\nComparing the given summation with the general expression above, we see that $Δx=\\frac{5}{n}.$ Therefore, \n\n$$\n\\frac{5}{n}=\\frac{b-2}{n}\\,⟹\\,b=7.\n$$\n\nConsequently, ${x}_{k}=2+\\frac{5k}{n}$ and $f({x}_{k})={x}_{k}^{2}.$\n\nHence,\n\n$$\n{\\int }_{2}^{7}{x}^{2}\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}[{(2+\\frac{5k}{n})}^{2}\\cdot \\frac{5}{n}].\n$$\n\nTherefore, the correct answer is $f(x)={x}^{2}$ and $b=7.$"} :step/id #uuid "ec476d83-723f-5784-843f-4fdb55768d1b" :step/next {:db/id #edb/ref 17592186551423}}] :activity/title "Defining Definite Integrals Using Left and Right Riemann Sums" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186550354}]}
