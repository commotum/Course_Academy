wer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le " :db/id #edb/ref 17592186490586} {:answer/id #uuid "29c6e317-fe8a-56af-8810-7117add868e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ge " :db/id #edb/ref 17592186490590} {:answer/id #uuid "4f6b8a8a-40ed-5dd0-a2f6-a02a642e8607" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186490664} {:answer/id #uuid "5d8840cc-c3df-51e0-b001-0912f0be89ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186490684}] :answer-field/correct {:answer/id #uuid "28b78a28-349b-5303-910f-ce3bc79d8e3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le " :db/id #edb/ref 17592186490586} :answer-field/id #uuid "b0cf17cb-025b-52d2-912c-740839b549f4" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186491073} {:answer-field/choices [{:answer/id #uuid "36bc5db3-af7b-5305-9c8d-45cf07dc2412" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "smallest lower bound" :db/id #edb/ref 17592186490615} {:answer/id #uuid "57300ad8-badb-5bbe-b24f-e8176eabcae0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "greatest lower bound" :db/id #edb/ref 17592186490675} {:answer/id #uuid "5f934523-88a0-57a6-a5d7-43b4d9f08e90" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "smallest upper bound" :db/id #edb/ref 17592186490688} {:answer/id #uuid "c4627033-258c-5ca6-9279-415bae73026a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "greatest upper bound" :db/id #edb/ref 17592186490888}] :answer-field/correct {:answer/id #uuid "57300ad8-badb-5bbe-b24f-e8176eabcae0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "greatest lower bound" :db/id #edb/ref 17592186490675} :answer-field/id #uuid "d643483d-5fbe-5334-8c77-295c62b8921e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186491088}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0ca69e5c-83dc-519f-8c14-c4c499eb6220" :question/math-academy-id "q-253558" :question/problem "Consider the set $B=(\\pi ,4).$ Complete the following reasoning to identify $inf(B).$\n\nThe infimum of $B$ is the {{field-1}} of $B.$\n\nThe set of lower bounds of $B$ is as follows:\n\n$$\n\\{x\\in R\\,:\\,x{{field-2}}{{field-3}}\\}\n$$\n\nTherefore, {{field-4}}." :question/worked-solution "The infimum of $B$ is the greatest lower bound of $B.$\n\nTo find the infimum of this set, we must find the set containing **all** lower bounds of $B$ (i.e., the set of lower bounds) and take the maximum of this set.\n\nIn our case, we have the following:\n\n- Any number in the set $x\\le \\pi $ is smaller than or equal to the elements of $B.$ Thus, the set $(-\\infty ,\\pi ]$ contains only lower bounds of $B.$\n\n- Any number in the set $x>\\pi $ is **not** a lower bound of $B.$ In other words, we can always find an element of $B$ that is smaller than $x$ for any $x>\\pi .$\n\nTherefore, $(-\\infty ,\\pi ]$ is the set of lower bounds of $B,$ and\n\n$$\ninf(B)=max(-\\infty ,\\pi ]=\\pi .\n$$\n\nNotice that $\\pi \\notin B.$\n\nThe completed reasoning is given below.\n\nThe infimum of $B$ is the $\\text{greatest lower bound}$ of $B.$\n\nThe set of lower bounds of $B$ is as follows:\n\n$$\n\\{x\\in R\\,:\\,x\\le \\pi \\}\n$$\n\nTherefore, $inf(B)=\\pi \\notin B.$"}] [{:db/id #edb/ref 17592186491151 :knowledge-point/_questions [{:db/id #edb/ref 17592186162157 :knowledge-point/id #uuid "fee0e08c-5a7a-5f78-83aa-39679bb3b17b" :knowledge-point/title "Supremum and Infimum of an Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1eb116da-9df3-555f-baf3-f38a3417b2ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le " :db/id #edb/ref 17592186490567} {:answer/id #uuid "4b8ffe60-36fa-5b57-a95b-d911f94b7da3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186490656} {:answer/id #uuid "790bc354-260c-50f7-a9db-e386374e2b31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ge " :db/id #edb/ref 17592186490752} {:answer/id #uuid "9bae201d-e39c-5894-809b-11e1a6cee72c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186490832}] :answer-field/correct {:answer/id #uuid "790bc354-260c-50f7-a9db-e386374e2b31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ge " :db/id #edb/ref 17592186490752} :answer-field/id #uuid "06681f56-8e44-5c9b-abc0-048c45068df5" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186491001} {:answer-field/choices [{:answer/id #uuid "538bc321-2afe-5e04-bf3f-9fe5dd74a2a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186490671} {:answer/id #uuid "9612ba99-43f2-5f93-bd7b-a3623ee633de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186490814}] :answer-field/correct {:answer/id #uuid "538bc321-2afe-5e04-bf3f-9fe5dd74a2a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186490671} :answer-field/id #uuid "10208c50-6eb7-5089-a728-c5981c202c93" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answ