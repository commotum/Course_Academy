>C</mi></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><msqrt><mn>3</mn></msqrt><mi>arcsin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><msqrt><mn>3</mn></msqrt><mi>x</mi><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mo>+</mo><mi>C</mi></mtd></mtr></mtable></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
