<mtr><mtd></mtd><mtd><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><msqrt><mn>6</mn></msqrt><mn>6</mn></mfrac></mstyle><mi>arctan</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mo stretchy=\"false\">(</mo><msqrt><mn>6</mn></msqrt><mi>x</mi><mo stretchy=\"false\">)</mo><mo>+</mo><mi>C</mi></mtd></mtr></mtable></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
