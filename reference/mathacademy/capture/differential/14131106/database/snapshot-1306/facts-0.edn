9458-f3312a599e31" #edb/ref 17592186045417] [17592186065077 #edb/ref 1063 #edb/ref 17592186064218 #edb/ref 17592186045417] [17592186065078 #edb/ref 1058 #edb/ref 17592186065124 #edb/ref 17592186045417] [17592186065078 #edb/ref 1061 641168 #edb/ref 17592186045417] [17592186065078 #edb/ref 1062 #uuid "a6a53452-9624-525f-9b54-d025309e71da" #edb/ref 17592186045417] [17592186065078 #edb/ref 1063 #edb/ref 17592186064219 #edb/ref 17592186045417] [17592186065079 #edb/ref 1058 #edb/ref 17592186065182 #edb/ref 17592186045417] [17592186065079 #edb/ref 1061 641174 #edb/ref 17592186045417] [17592186065079 #edb/ref 1062 #uuid "e5a617a2-9f5d-550f-a473-195c08b4798c" #edb/ref 17592186045417] [17592186065079 #edb/ref 1063 #edb/ref 17592186064220 #edb/ref 17592186045417] [17592186065124 #edb/ref 1058 #edb/ref 17592186065079 #edb/ref 17592186045417] [17592186065124 #edb/ref 1061 641171 #edb/ref 17592186045417] [17592186065124 #edb/ref 1062 #uuid "1c6cd5c4-2775-585d-9234-d995757ade98" #edb/ref 17592186045417] [17592186065124 #edb/ref 1063 #edb/ref 17592186064250 #edb/ref 17592186045417] [17592186065182 #edb/ref 1061 641177 #edb/ref 17592186045417] [17592186065182 #edb/ref 1062 #uuid "b420ebdd-a5d6-5ce1-8cde-23990b2968f7" #edb/ref 17592186045417] [17592186065182 #edb/ref 1063 #edb/ref 17592186065381 #edb/ref 17592186045417] [17592186065381 #edb/ref 1064 "In this lesson, we learned how to use substitution to evaluate integrals that give rise to inverse trigonometric functions.\n\nAlthough you can always solve these integrals by going through the substitution process, it is convenient to remember the following key results:\n\n$$\n\\begin{aligned}\\int \\frac{1}{\\sqrt{1-(ax)^{2}}}\\,\\text{d}x & =\\frac{1}{a}\\operatorname{arcsin}⁡(ax)+C \\\\ \\int \\frac{1}{\\sqrt{{a}^{2}-{x}^{2}}}\\,\\text{d}x & =\\operatorname{arcsin}⁡(\\frac{x}{a})+C \\\\ \\int \\frac{1}{1+(ax)^{2}}\\,\\text{d}x & =\\frac{1}{a}\\operatorname{arctan}⁡(ax)+C \\\\ \\int \\frac{1}{{a}^{2}+{x}^{2}}\\,\\text{d}x & =\\frac{1}{a}\\operatorname{arctan}⁡(\\frac{x}{a})+C \\\\ \\int \\frac{1}{|ax|\\sqrt{(ax)^{2}-1}}\\,\\text{d}x & =\\frac{1}{a}\\text{arcsec}(ax)+C\\end{aligned}\n$$\n\nTo remember the results above, note the following:\n\n- Whenever the integrand has an $ax$ term, the argument of the resulting inverse trigonometric function is $ax.$\n\n- Otherwise, if the $a$ and $x$ are separated, then the argument of the resulting inverse trigonometric function is $\\dfrac{x}{a}.$\n\n- All the results are multiplied by $\\dfrac{1}{a},$ except for $\\arcsin \\left( \\dfrac{x}{a} \\right) + C.$" #edb/ref 17592186045417] [17592186065381 #edb/ref 1065 4800 #edb/ref 17592186045417] [17592186065381 #edb/ref 1066 #uuid "02539765-4345-5409-87f9-9901a59b7ebf" #edb/ref 17592186045417] [17592186065381 #edb/ref 1067 "Summary of Key Results" #edb/ref 17592186045417] [17592186065433 #edb/ref 1064 "Consider the integral\n\n$$\n\\int \\dfrac{1}{\\sqrt{1-4x^2}} \\, \\textrm{d}x.\n$$\n\nThis integral, apart from the coefficient of $4$ in the denominator, resembles the basic integral\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^2}}\\textrm{d}u = \\arcsin(u)+C.\n$$\n\nIn fact, they look almost the same, but instead of $u^2$ as the variable, we have $4x^2 = (2x)^2.$\n\nSo, let's substitute $u=2x.$ Differentiating, we get\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=2\\quad\\Longrightarrow\\quad \\dfrac 1 2 \\textrm d u = \\textrm d x.\n$$\n\nWe can now write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{1}{\\sqrt{1-4{x}^{2}}}\\,\\text{d}x & =\\int \\frac{1}{\\sqrt{1-(2x)^{2}}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\operatorname{arcsin}⁡(u)+C \\\\  & =\\frac{1}{2}\\operatorname{arcsin}⁡(2x)+C.\\end{aligned}\n$$\n\nWe can often use this trick whenever we see an integral that closely resembles an integral for an inverse trigonometric function.\n\n**Note:** As always, after solving an integral using substitution, we should always double-check that our result is correct. If we differentiate the result, then it should come out to the original integrand:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[\\frac{1}{2}\\operatorname{arcsin}⁡(2x)+C] & =\\frac{1}{2}\\cdot \\frac{\\text{d}}{\\text{d}x}[\\operatorname{arcsin}⁡(2x)]+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =\\frac{1}{2}\\cdot \\frac{1}{\\sqrt{1-(2x)^{2}}}\\cdot \\frac{\\text{d}}{\\text{d}x}(2x)+0 \\\\  & =\\frac{1}{2}\\cdot \\frac{1}{\\sqrt{1-4{x}^{2}}}\\cdot 2 \\\\  & =\\frac{1}{\\sqrt{1-4{x}^{2}}}\\,✓\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186065433 #edb/ref 1065 863 #edb/ref 17592186045417] [17592186065433 #edb/ref 1066 #uuid "53af5e98-4580-5243-a97c-de9e0d5f8fab" #edb/ref 17592186045417] [17592186065433 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186247445 #edb/ref 1080 "\\sqrt{2}\\operatorname{arcsin}⁡(x)+C" #edb/ref 17592186045417] [17592186247445 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186247445 #edb/ref 1083 #uuid "02cd4706-704b-5191-9295-cd464731fc6a" #edb/ref 17592186045417] [17592186247464 #edb/ref 1080 "5\\operatorname{arctan}⁡(\\sqrt{5}x)+C" #edb/ref 17592186045417] [17592186247464 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186247464 #edb/ref 1083 #uuid "0539dfbd-c13f-5910-83ae-6847aafc2ffa" #edb/ref 17592186045417] [17592186247554 #edb/ref 1080 "\\frac{\\sqrt{5}}{5}\\operatorname{arctan}⁡(\\sqrt{5}x)+C" #edb/ref 17592186045417] [17592186247554 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186247554 #edb/ref 1083 #uuid "0e2ff00e-68bf-502d-98ea-81a253a73c45" #edb/ref 17592186045417] [17592186247745 #edb/ref 1080 "3\\operatorname{arcsin}⁡(\\sqrt{3}x)+C" #edb/ref 17592186045417] [17592186247745 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186247745 #edb/ref 1083 #uuid "2488cb64-1bbf-52da-a312-e3caf405d555" #edb/ref 17592