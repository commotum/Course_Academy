2)$ and $(-1,-2)$" #edb/ref 17592186045417] [17592186434964 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186434964 #edb/ref 1083 #uuid "af3044d7-995b-5b31-911a-1432e5fb9524" #edb/ref 17592186045417] [17592186434973 #edb/ref 1080 "$(-1,2)$ and $(1,2)$" #edb/ref 17592186045417] [17592186434973 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186434973 #edb/ref 1083 #uuid "ef89c4a6-451f-5b35-895b-c5f4bf15a46a" #edb/ref 17592186045417] [17592186434974 #edb/ref 1080 "(1,-2)" #edb/ref 17592186045417] [17592186434974 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186434974 #edb/ref 1083 #uuid "f0c1486d-d897-5524-a326-f95ed8d30db0" #edb/ref 17592186045417] [17592186434977 #edb/ref 1075 #edb/ref 17592186434952 #edb/ref 17592186045417] [17592186434977 #edb/ref 1075 #edb/ref 17592186434963 #edb/ref 17592186045417] [17592186434977 #edb/ref 1075 #edb/ref 17592186434964 #edb/ref 17592186045417] [17592186434977 #edb/ref 1075 #edb/ref 17592186434973 #edb/ref 17592186045417] [17592186434977 #edb/ref 1075 #edb/ref 17592186434974 #edb/ref 17592186045417] [17592186434977 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186434977 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186434977 #edb/ref 1078 #edb/ref 17592186434952 #edb/ref 17592186045417] [17592186434977 #edb/ref 1079 #uuid "4639d8d2-4eac-541e-8594-82bea3d94f3f" #edb/ref 17592186045417] [17592186434983 #edb/ref 1068 #edb/ref 17592186454693 #edb/ref 17592186045436] [17592186434983 #edb/ref 1068 #edb/ref 17592186454694 #edb/ref 17592186045436] [17592186434983 #edb/ref 1068 #edb/ref 17592186454695 #edb/ref 17592186045436] [17592186434983 #edb/ref 1069 "q-37589" #edb/ref 17592186045417] [17592186434983 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186434983 #edb/ref 1071 "The function \n$f(x,y)$ \nhas the second derivative\n\n$$\n{f}^{″}(x,y)=\\begin{bmatrix}12{x}^{2}-4 & 0 \\\\ 0 & 2\\end{bmatrix}\n$$\n\nand has a stationary point at $(-1,0).$ If $H$ denotes the Hessian determinant of $f,$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $H(-1,0)>0$\n\n- **II.** $\\frac{{∂}^{2}f}{∂{x}^{2}}(-1,0)>0$\n\n- **III.** The point $(-1,0)$ is a local maximum of $f$" #edb/ref 17592186045443] [17592186434983 #edb/ref 1072 #uuid "b007310c-a11f-531c-b695-1febe8ef0462" #edb/ref 17592186045417] [17592186434983 #edb/ref 1074 "The second partial derivative test states that if $a\\in {R}^{2}$ is a stationary point of $f(x,y)$ with Hessian determinant $H(a),$ we have the following:\n\n- If $H(a)>0,$ then:\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)<0,$ then $f$ has a local maximum at $a$\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)>0,$ then $f$ has a local minimum at $a$\n\n- If $H(a)<0,$ then $f$ has a saddle point at $a$\n\n- If $H(a)=0,$ then the second partial derivatives test is inconclusive.\n\nEvaluating the second derivative at $(-1,0),$ we obtain \n\n$$\n\\begin{aligned}{f}^{″}(-1,0)=\\begin{bmatrix}8 & 0 \\\\ 0 & 2\\end{bmatrix}.\\end{aligned}\n$$\n\nNow, let's examine our statements in turn.\n\n- Statement I is true. Indeed, computing the determinant of ${f}^{″}(-1,0),$ we get\n\n$$\nH(-1,0)=det({f}^{″}(-1,0))=8\\cdot 2-{0}^{2}=16>0.\n$$\n\n- Statement II is true. Indeed, we have $\\frac{{∂}^{2}f}{∂{x}^{2}}(-1,0)=({f}^{″}(-1,0))_{11}=8>0.$\n\n- Statement III is false. Since $H(-1,0)>0$ and $\\frac{{∂}^{2}f}{∂{x}^{2}}(-1,0)>0,$ the point $(-1,0)$ is a local minimum by the second partial derivative test.\n\nTherefore, the correct answer is \"I and II only.\"" #edb/ref 17592186045443] [17592186434984 #edb/ref 1068 #edb/ref 17592186434977 #edb/ref 17592186045417] [17592186434984 #edb/ref 1069 "q-80605" #edb/ref 17592186045417] [17592186434984 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186434984 #edb/ref 1071 "Determine the stationary points of $f(x,y)={x}^{2}+xy+2\\operatorname{ln}⁡y.$" #edb/ref 17592186045417] [17592186434984 #edb/ref 1072 #uuid "e309db36-c1df-54f7-9f6d-2cd23acc2d7b" #edb/ref 17592186045417] [17592186434984 #edb/ref 1074 "The stationary points of a multivariable function $f$ are the points $a$ in the domain of $f$ such that ${f}^{′}(a)={0}^{T},$ where\n\n$$\n{f}^{′}(a)={\\begin{bmatrix}\\frac{∂f}{∂{x}_{1}} & \\frac{∂f}{∂{x}_{2}} & ⋯ & \\frac{∂f}{∂{x}_{n}}\\end{bmatrix}|}_{x=a}.\n$$\n\nIn this case, the domain of $f$ is $D=\\{(x,y)\\in {R}^{2}∣y>0\\},$ and the first partial derivatives of $f$ are\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =2x+y \\\\ \\frac{∂f}{∂y} & =x+\\frac{2}{y}.\\end{aligned}\n$$\n\n \n\nSo, the first derivative of $f$ is\n\n$$\n{f}^{′}(x,y)=\\begin{bmatrix}2x+y & x+\\frac{2}{y}\\end{bmatrix}.\n$$\n\nTo find the stationary points, we need to find the points where ${f}^{′}(x,y)={0}^{T}.$\nSetting ${f}^{′}(x,y)={0}^{T},$ we have the following system:\n\n$$\n\\{\\begin{aligned}2x+y=0 \\\\ x+\\frac{2}{y}=0\\end{aligned}\n$$\n\nSolving for $y$ in the first equation, we get\n\n$$\n2x+y=0\\,⟹\\,y=-2x.\n$$\n\nThen, substituting into the second equation, we obtain\n\n$$\n\\begin{aligned}x+\\frac{2}{-2x} & =0 \\\\ x-\\frac{1}{x} & =0 \\\\ x & =\\frac{1}{x} \\\\ x & =\\pm 1.\\end{aligned}\n$$\n\nBack-substituting these values into $y=-2x,$ we get\n\n$$\n\\begin{aligned}x=-1 & \\,⟹\\,y=-2(-1)=2 \\\\ x=1 & \\,⟹\\,y=-2(1)=-2.\\end{aligned}\n$$\n\nTherefore, our system has two solutions, $(-1,2)$ and $(1,-2).$ We reject the point $(1,-2)$ because it does not lie in the domain of $f(x,y).$\n\nIn conclusion, $f$ has one stationary point, $(-1,2).$" #edb/ref 17592186045443] [17592186447690 #edb/ref 1080 "false" #edb/ref 17592186045436] [17592186447690 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045436] [17592186447690 #edb/ref 1083 #uuid "61346844-f5db-5d81-988d-5f22f99364e2" #edb/ref 17592186045436] [17592186447691 #edb/ref 1080 "true" #edb/ref 17592186045436] [17592186447691 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045436] [17592186447691 #edb/ref 1083 #uui