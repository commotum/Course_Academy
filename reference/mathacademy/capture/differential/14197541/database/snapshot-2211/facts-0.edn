bc5e1f0984618c97e85e812fca6.svg) we get\n![](images/f0/f0f000997b9e965a8280f51619abfc3c9f6574fbaa6292f045c7d03720693bd9.svg)\nTherefore, ![](images/52/52c679e6f9a0ed40ecf5652d769a673a1cf842a1816d913ddc4e6a3356dc43af.svg) is a saddle point.\n\nIn conclusion, ![](images/a2/a2dcac06a4cf671df0fa43cef1727449fb2ebc57fb824d19cc07da5e75d12176.svg) has a local minimum at ![](images/dc/dcc19bac01833ff23365244490e52b2722741da56e804e9a95b5b264f23216bf.svg) and a saddle point at ![](images/89/897570ce172a9f169127c297c355bc7a446b1df6ee78afe238f5b53dde75a85c.svg)" #edb/ref 17592186045417] [17592186124653 #edb/ref 1037 #edb/ref 17592186048385 #edb/ref 17592186045417] [17592186124653 #edb/ref 1037 #edb/ref 17592186049676 #edb/ref 17592186045417] [17592186124653 #edb/ref 1037 #edb/ref 17592186049962 #edb/ref 17592186045417] [17592186124653 #edb/ref 1038 #edb/ref 17592186125004 #edb/ref 17592186045417] [17592186124653 #edb/ref 1038 #edb/ref 17592186125006 #edb/ref 17592186045417] [17592186124653 #edb/ref 1038 #edb/ref 17592186235545 #edb/ref 17592186045417] [17592186124653 #edb/ref 1038 #edb/ref 17592186237887 #edb/ref 17592186045417] [17592186124653 #edb/ref 1038 #edb/ref 17592186238078 #edb/ref 17592186045417] [17592186124653 #edb/ref 1038 #edb/ref 17592186348429 #edb/ref 17592186045417] [17592186124653 #edb/ref 1038 #edb/ref 17592186348435 #edb/ref 17592186045417] [17592186124653 #edb/ref 1038 #edb/ref 17592186434984 #edb/ref 17592186045417] [17592186124653 #edb/ref 1038 #edb/ref 17592186511482 #edb/ref 17592186045417] [17592186124653 #edb/ref 1038 #edb/ref 17592186511496 #edb/ref 17592186045417] [17592186124653 #edb/ref 1038 #edb/ref 17592186511526 #edb/ref 17592186045417] [17592186124653 #edb/ref 1038 #edb/ref 17592186511549 #edb/ref 17592186045417] [17592186124653 #edb/ref 1039 "Finding the Critical Points of a Function" #edb/ref 17592186045417] [17592186124653 #edb/ref 1041 #edb/ref 17592186124216 #edb/ref 17592186045417] [17592186124653 #edb/ref 1042 #uuid "045854fc-9cad-5005-