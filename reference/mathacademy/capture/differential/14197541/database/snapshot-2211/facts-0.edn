86045417] [17592186124655 #edb/ref 1038 #edb/ref 17592186399468 #edb/ref 17592186045417] [17592186124655 #edb/ref 1038 #edb/ref 17592186399475 #edb/ref 17592186045417] [17592186124655 #edb/ref 1038 #edb/ref 17592186434981 #edb/ref 17592186045417] [17592186124655 #edb/ref 1038 #edb/ref 17592186434982 #edb/ref 17592186045417] [17592186124655 #edb/ref 1038 #edb/ref 17592186511466 #edb/ref 17592186045417] [17592186124655 #edb/ref 1039 "Finding and Classifying All Critical Points Using the Second Partial Derivatives Test" #edb/ref 17592186045417] [17592186124655 #edb/ref 1041 #edb/ref 17592186124218 #edb/ref 17592186045417] [17592186124655 #edb/ref 1042 #uuid "61cadd46-5fae-51c6-8e5b-8114e48b12da" #edb/ref 17592186045417] [17592186124735 #edb/ref 1043 #edb/ref 17592186125649 #edb/ref 17592186045417] [17592186124735 #edb/ref 1043 #edb/ref 17592186125650 #edb/ref 17592186045417] [17592186124735 #edb/ref 1043 #edb/ref 17592186125651 #edb/ref 17592186045417] [17592186124735 #edb/ref 1043 #edb/ref 17592186125652 #edb/ref 17592186045417] [17592186124735 #edb/ref 1043 #edb/ref 17592186125653 #edb/ref 17592186045417] [17592186124735 #edb/ref 1043 #edb/ref 17592186125654 #edb/ref 17592186045417] [17592186124735 #edb/ref 1043 #edb/ref 17592186125661 #edb/ref 17592186045417] [17592186124735 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186124735 #edb/ref 1045 "The Second Partial Derivatives Test" #edb/ref 17592186045417] [17592186124735 #edb/ref 1046 #edb/ref 17592186125649 #edb/ref 17592186045417] [17592186124735 #edb/ref 1049 #edb/ref 17592186051048 #edb/ref 17592186045417] [17592186124735 #edb/ref 1050 960.0 #edb/ref 17592186045417] [17592186124735 #edb/ref 1053 #uuid "ec39ccfa-c0bc-5c06-b1ec-f08770e57898" #edb/ref 17592186045417] [17592186125067 #edb/ref 1068 #edb/ref 17592186449341 #edb/ref 17592186045436] [17592186125067 #edb/ref 1068 #edb/ref 17592186449342 #edb/ref 17592186045436] [17592186125067 #edb/ref 1068 #edb/ref 17592186449343 #edb/ref 17592186045436] [17592186125067 #edb/ref 1069 "q-37378" #edb/ref 17592186045417] [17592186125067 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186125067 #edb/ref 1071 "The function \n$f(x,y)$\nhas the second derivative\n\n$$\n{f}^{″}(x,y)=\\begin{bmatrix}\\frac{2(1+\\operatorname{ln}⁡x)}{x} & 2y \\\\ 2y & 2x\\end{bmatrix}\n$$\n\nand has a stationary point at $(1,0).$ If $H$ denotes the Hessian determinant of $f,$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $H(1,0)>0$\n\n- **II.** $\\frac{{∂}^{2}f}{∂{x}^{2}}(1,0)>0$\n\n- **III.** The point $(1,0)$ is a local maximum of $f$" #edb/ref 17592186045443] [17592186125067 #edb/ref 1072 #uuid "8a07adee-cd5f-5906-86f1-fee57d6ba6a8" #edb/ref 17592186045417] [17592186125067 #edb/ref 1074 "The second partial derivative test states that if $a\\in {R}^{2}$ is a stationary point of $f(x,y)$ with Hessian determinant $H(a),$ we have the following:\n\n- If $H(a)>0,$ then:\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)<0,$ then $f$ has a local maximum at $a$\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)>0,$ then $f$ has a local minimum at $a$\n\n- If $H(a)<0,$ then $f$ has a saddle point at $a$\n\n- If $H(a)=0,$ then the second partial derivatives test is inconclusive.\n\nEvaluating the second derivative at $(1,0),$ we obtain\n\n$$\n\\begin{aligned}{f}^{″}(1,0)=\\begin{bmatrix}2 & 0 \\\\ 0 & 2\\end{bmatrix}.\\end{aligned}\n$$\n\nNow, let's examine our statements in turn.\n\n- Statement I is true. Indeed, computing the determinant of ${f}^{″}(1,0),$ we get\n\n$$\nH(1,0)=det({f}^{″}(1,0))=2\\cdot 2-{0}^{2}=4>0.\n$$\n\n- Statement II is true. Indeed, we have $\\frac{{∂}^{2}f}{∂{x}^{2}}(1,0)=({f}^{″}(1,0))_{11}=2.$\n\n- Statement III is false. Since $H(1,0)>0$ and $\\frac{{∂}^{2}f}{∂{x}^{2}}(1,0)>0,$ the point $(1,0)$ is a local minimum by the second partial derivative test.\n\nTherefore, the correct answer is, \"I and II only.\"" #edb/ref 17592186045443] [17592186125649 #edb/ref 1058 #edb/ref 17592186125650 #edb/ref 17592186045417] [17592186125649 #edb/ref 1061 45414 #edb/ref 17592186045417] [17592186125649 #edb/ref 1062 #uuid "59e0e71c-41de-59e8-af18-15eaf180ea00" #edb/ref 17592186045417] [17592186125649 #edb/ref 1063 #edb/ref 17592186125889 #edb/ref 17592186045417] [17592186125650 #edb/ref 1058 #edb/ref 17592186125651 #edb/ref 17592186045417] [17592186125650 #edb/ref 1061 45415 #edb/ref 17592186045417] [17592186125650 #edb/ref 1062 #uuid "c1edc476-8e7a-5e8a-83d5-126f47cd2bfb" #edb/ref 17592186045417] [17592186125650 #edb/ref 1063 #edb/ref 17592186124653 #edb/ref 17592186045417] [17592186125651 #edb/ref 1058 #edb/ref 17592186125652 #edb/ref 17592186045417] [17592186125651 #edb/ref 1061 45418 #edb/ref 17592186045417] [17592186125651 #edb/ref 1062 #uuid "c5093fcf-6163-5240-9022-125813bd45bf" #edb/ref 17592186045417] [17592186125651 #edb/ref 1063 #edb/ref 17592186125890 #edb/ref 17592186045417] [17592186125652 #edb/ref 1058 #edb/ref 17592186125653 #edb/ref 17592186045417] [17592186125652 #edb/ref 1061 45419 #edb/ref 17592186045417] [17592186125652 #edb/ref 1062 #uuid "f1821258-7802-571e-a84f-0738986e608c" #edb/ref 17592186045417] [17592186125652 #edb/ref 1063 #edb/ref 17592186125891 #edb/ref 17592186045417] [17592186125653 #edb/ref 1058 #edb/ref 17592186125654 #edb/ref 17592186045417] [17592186125653 #edb/ref 1061 45420 #edb/ref 17592186045417] [17592186125653 #edb/ref 1062 #uuid "4f254984-e6a9-5246-b99d-34252f2d1d87" #edb/ref 17592186045417] [17592186125653 #edb/ref 1063 #edb/ref 17592186124654 #edb/ref 17592186045417] [17592186125654 #edb/ref 1058 #edb/ref 17592186125661 #edb/ref 17592186045417] [17592186125654 #edb/ref 1061 45423 #edb/ref 17592186045417] [17592186125654 #edb/ref 1062 #uuid "9c6b333c-1f09-554a-8089-06e97c78f009" #edb/ref 17592186045417] [17592186125654 #edb/ref 1063 #edb/ref 17592186124655 #edb/ref 17592186045417] [17592186125661 #edb/ref 1061 45457 #edb/ref 17592186045417] [17592186125661 #edb/ref 1062 #uuid "408587e1-74bc-5208-80a7-5977f2bc1961" #edb/ref 17592186045417] [17592186125661 #edb/ref 1063 #edb/ref 17592186125895 #edb/ref 17592186045417] [17592186125889 #edb/ref 1064 "The **critical points** of a function $f(\\mathbf x)$ are the points $\\mathbf x = \\mathbf a$ in the domain of $f$ such that $\\boldsymbol f'(\\mathbf a) =\\mathbf 0^T$ or $\\boldsymbol f'(\\mathbf a)$ does not exist. A critical point such that $\\boldsymbol f'(\\mathbf a) = \\mathbf 0^T$ is called a **stationary point**.\n\nFor example, consider the function $f(x,y) = x^2 - 2x + y^2+6y.$ The domain of $f$ is $\\mathbb{R}^2,$ and the first partial derivatives of $f$ are\n\n$$\n\\dfrac {\\partial f}{\\partial x} = 2x-2,\n\\qquad\n\\dfrac {\\partial f}{\\partial y} = 2y+6.\n$$\n\nSo, the first derivative of $f$ is\n![](images/9e/9ea3f2d1dd0994be64602aeaffcf5d8424f52daa03844e21e65469f779d9b009.svg)\n\nTo find the critical points, we need to find the points $(x,y) \\in \\mathbb{R}^2$ such that ![](images/23/23faa4c01362cad11c2ab6ad19045ca44a09460da1c719c8212480f27f21c5b1.svg) or $\\boldsymbol f'(x,y)$ does not exist:\n\n- Setting $\\boldsymbol f'(x,y) = \\mathbf{0}^T,$ we obtain the following system:\n\n$$\n\\{\\begin{aligned}2x-2=0 \\\\ 2y+6=0\\end{aligned}\n$$\n\nThis system has the solution $x=1$ and $y=-3.$ Consequently, $(1,-3)$ is a critical point of $f.$\n\n- $\\boldsymbol f'(x,y)$ exists everywhere, so there are no more critical points to be found.\n\nTherefore, the only critical point of $f$ is $(1,-3).$" #edb/ref 17592186045417] [17592186125889 #edb/ref 1065 7876 #edb/ref 17592186045417] [17592186125889 #edb/ref 1066 #uuid "66c2c3d5-6a0a-561b-81c6-ba81419caa61" #edb/ref 17592186045417] [17592186125889 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186125890 #edb/ref 1064 "Recall that, for functions of two variables $f(x,y)$, there are typically three possible types of critical points that can occur:\n\n- Local minimum points. For example, the elliptic paraboloid $z = f(x,y) = x^2+y^2$ has a minimum point at $(0,0),$ as shown below.\n\n![](images/14/14e8d23a4bc649257c2f7351e0d2c1d62e39a8cd8eed1467e65853ee121b836e.png)\n\n- Local maximum points. For example, the elliptic paraboloid $z = f(x,y) = -x^2-y^2$ has a maximum point at $(0,0),$ as shown below.\n\n![](images/00/008803f43cb2161624f8ef295c70a125b8be64d93184928bd2176a6debaa9f85.png)\n\n- Saddle points. For example, the hyperbolic paraboloid $z = f(x,y) = y^2-x^2$ has a saddle point at $(0,0),$ as shown below.\n\n![](images/12/1214b413073ad87a302fb1297cef47208a922e368d680a9f69ec8fb18d9ca8a0.png)\n\nLocal maximum and local minimum points are analogous to what you would have seen in single-variable calculus. \n\nA saddle point occurs when the slopes are zero in all directions, yet it is not a local maximum or minimum. The hyperbolic paraboloid shown above reaches a local maximum at $(0,0)$ along the $xz$-plane, yet this is a local minimum along the $yz$-plane." #edb/ref 17592186045417] [17592186125890 #edb/ref 1065 7877 #edb/ref 17592186045417] [17592186125890 #edb/ref 1066 #uuid "fe3c5f00-f720-5573-a01f-c37f0a3e447f" #edb/ref 17592186045417] [17592186125890 #edb/ref 1067 "Classifying Stationary Points" #edb/ref 17592186045417] [17592186125891 #edb/ref 1064 "The **second partial derivatives test** helps to determine whether a stationary point of a function of two variables gives rise to a local maximum, a local minimum, or a saddle point.\n\nSuppose that $\\mathbf x = \\mathbf{a}$ is a critical point of $f(\\mathbf x),$ and let $H(\\mathbf{a})$ denote the determinant of $\\boldsymbol f''(x,y)$ evaluated at $\\mathbf{a}$ (recall that $H(\\mathbf a)$ is called the *Hessian determinant* of $f$ at $\\mathbf a$).\n\nThe second partial derivative test states the following:\n\n- If $H(\\mathbf{a}) > 0,$ then:\n\n- if $\\dfrac{\\partial^2 f}{\\partial x^2}(\\mathbf{a}) < 0,$  then $f$ has a local maximum at $\\mathbf{a},$ and\n\n- if $\\dfrac{\\partial^2 f}{\\partial x^2}(\\mathbf{a}) > 0,$  then $f$ has a local minimum at $\\mathbf{a}.$\n\n- If $H(\\mathbf{a}) < 0,$ then $f$ has a saddle point at $\\mathbf{a}.$\n\n- If $H(\\mathbf{a}) = 0,$ then the second partial derivatives test is inconclusive, and we need to classify the point using some other method.\n\nAs an example, consider the function $f (x, y) = 3 + 2x^2 - x y + y^2.$ Let's find the critical points of this function and then classify them using the second partial derivatives test.\n\nWe start by computing the partial derivatives:\n\n$$\n\\dfrac{\\partial f}{\\partial x} = 4x -y, \\qquad \\dfrac{\\partial f}{\\partial y} = 2y -x\n$$\n\nThe first derivative exists for any $(x,y)$ in the domain of the function, so we only need to find the stationary points. Setting $\\boldsymbol f'(x,y) = \\mathbf{0}^T,$ we obtain the following system:\n\n$$\n\\{\\begin{aligned}4x-y=0 \\\\ 2y-x=0,\\end{aligned}\n$$\n\nThe solution to this system is $x=0, y=0.$ Hence, $(0,0)$ is the only stationary point.  \n\nTo classify this stationary point, we use the second partial derivative test.\n\nFirst, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(4x-y)=4 \\\\ \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(2y-x)=2 \\\\ \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{{∂}^{2}f}{∂y∂x}=\\frac{∂}{∂x}(2y-x)=-1\\end{aligned}\n$$\n\nSo, the second derivative is \n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{aligned}]=[\\begin{aligned}4 & -1 \\\\ -1 & 2\\end{aligned}].\\end{aligned}\n$$\n\nFinally, we evaluate the second derivative at each of the stationary points and use it to categorize them:\n\n- Evaluating the second derivative at $(0,0),$ we obtain\n\n$$\n\\begin{aligned}{f}^{″}(0,0)=[\\begin{aligned}4 & -1 \\\\ -1 & 2\\end{aligned}].\\end{aligned}\n$$\n\nComputing the determinant $H(0,0),$ we get\n\n$$\nH(0,0) = \\det(\\boldsymbol f''(0,0)) = 4 \\cdot 2 - (-1)^2 = 7 > 0.\n$$\n\nFinally, since $H(0,0) > 0$ and $\\dfrac{\\partial^2 f}{\\partial x^2}(0,0) = (\\boldsymbol f''(0,0))_{11}= 4 >0,$ the function $f$ has a local minimum at $(0,0).$\n\nIn conclusion, $f(x,y)$ has a local minimum at $(0,0).$" #edb/ref 17592186045417] [17592186125891 #edb/ref 1065 7878 #edb/ref 17592186045417] [17592186125891 #edb/ref 1066 #uuid "8248e727-7421-5535-ba58-b5ed98f7ac38" #edb/ref 17592186045417] [17592186125891 #edb/ref 1067 "The Second Partial Derivatives Test" #edb/ref 17592186045417] [17592186125895 #edb/ref 1064 "Suppose $\\mathbf{a} \\in \\mathbb{R}^2$ is a stationary point of a function $f(\\mathbf x).$\n\nIn a previous lesson, we saw that if $H(\\mathbf{a}) = \\det(\\boldsymbol{f}''(\\mathbf{a})) \\neq 0$, then we can classify $\\mathbf{a}$ as follows:\n\n- if $\\boldsymbol{f}''(\\mathbf{a})$ is positive definite, then $\\mathbf{a}$ is a local minimum\n\n- if $\\boldsymbol{f}''(\\mathbf{a})$ is negative definite, then $\\mathbf{a}$ is a local maximum\n\n- if $\\boldsymbol{f}''(\\mathbf{a})$ is neither positive-definite nor negative-definite, then $\\mathbf{a}$ is a saddle point\n\nThe second derivatives test follows from these facts. To see why, we first recall Sylvester's criterion:\n\nThe quadratic form $\\mathbf{x}^TA\\mathbf{x}$ (as well as the $2\\times 2$ matrix $A$) is\n\n- positive definite if and only if $\\Delta_1 > 0$ and $\\Delta_2 > 0,$ and\n\n- negative definite if and only if $\\Delta_1 < 0$ and $\\Delta_2 > 0,$\n\nwhere $\\Delta_1$ and $\\Delta_2$ are the first and second principle minors of $A,$ respectively.\n\nFirst, notice the following:\n\n- The first principal minor of $\\boldsymbol f''(\\mathbf a)$ is\n\n$$\n\\Delta_1 = (\\boldsymbol{f}''(\\mathbf{a}))_{11} = \\dfrac{\\partial^2 f}{\\partial x^2}.\n$$\n\n- The second principal minor of $\\boldsymbol f''(\\mathbf a)$ is the Hessian determinant\n\n$$\n\\Delta_2 = \\det(\\boldsymbol{f}''(\\mathbf{a})) = H(\\mathbf{a}).\n$$\n\nKnowing this, we can go through each case:\n\n- If $H(\\mathbf a) < 0,$ then $\\Delta_2 < 0.$ Hence, by Sylvester's criterion, the Hessian matrix $\\boldsymbol f''(\\mathbf{a})$ is neither positive definite nor negative definite, and we conclude that $f$ has a saddle point at $\\mathbf{a}.$\n\n- If $H(\\mathbf a) > 0,$ then $\\Delta_2 > 0.$ Then:\n\n- If $\\Delta_1 = \\dfrac{\\partial^2 f}{\\partial x^2} < 0,$ then $\\boldsymbol f''(\\mathbf{a})$ is negative definite by Sylvester's criterion, and we conclude that $f$ has a local maximum at $\\mathbf{a}.$\n\n- If $\\Delta_1 = \\dfrac{\\partial^2 f}{\\partial x^2} > 0,$ then $\\boldsymbol f''(\\mathbf{a})$ is positive definite by Sylvester's criterion, and we conclude that $f$ has a local minimum at $\\mathbf{a}.$" #edb/ref 17592186045417] [17592186125895 #edb/ref 1065 7886 #edb/ref 17592186045417] [17592186125895 #edb/ref 1066 #uuid "0bcd9133-9025-5637-8956-90a3b84934a5" #edb/ref 17592186045417] [17592186125895 #edb/ref 1067 "Relating the Second Partial Derivatives Test to the Taylor Polynomial Classification" #edb/ref 17592186045417] [17592186240969 #edb/ref 1068 #edb/ref 17592186448885 #edb/ref 17592186045436] [17592186240969 #edb/ref 1068 #edb/ref 17592186448886 #edb/ref 17592186045436] [17592186240969 #edb/ref 1068 #edb/ref 17592186448887 #edb/ref 17592186045436] [17592186240969 #edb/ref 1069 "q-104984" #edb/ref 17592186045417] [17592186240969 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186240969 #edb/ref 1071 "The function \n$f(x,y)$ \nhas the second derivative\n\n$$\n{f}^{″}(x,y)=\\begin{bmatrix}{e}^{-({x}^{2}+{y}^{2})}(2{x}^{2}-1) & 2xy{e}^{-({x}^{2}+{y}^{2})} \\\\ 2xy{e}^{-({x}^{2}+{y}^{2})} & {e}^{-({x}^{2}+{y}^{2})}(2{y}^{2}-1)\\end{bmatrix}\n$$\n\nand has a stationary point at $(0,0).$ If $H$ denotes the Hessian determinant of $f,$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $H(0,0)>0$\n- **II.** $\\frac{{∂}^{2}f}{∂{x}^{2}}(0,0)>0$\n- **III.** The point $(0,0)$ is a local maximum of $f$" #edb/ref 17592186045443] [17592186240969 #edb/ref 1072 #uuid "bcc06ba1-1065-5981-a107-14dc46cea80e" #edb/ref 17592186045417] [17592186240969 #edb/ref 1074 "The second partial derivative test states that if $a\\in {R}^{2}$ is a stationary point of $f(x,y)$ with Hessian determinant $H(a),$ we have the following:\n\n- If $H(a)>0,$ then:\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)<0,$ then $f$ has a local maximum at $a$\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)>0,$ then $f$ has a local minimum at $a$\n\n- If $H(a)<0,$ then $f$ has a saddle point at $a$\n\n- If $H(a)=0,$ then the second partial derivatives test is inconclusive.\n\nEvaluating the second derivative at $(0,0),$ we obtain\n\n$$\n\\begin{aligned}{f}^{″}(0,0)=\\begin{bmatrix}-1 & 0 \\\\ 0 & -1\\end{bmatrix}.\\end{aligned}\n$$\n\nNow, let's examine our statements in turn.\n\n- Statement I is true. Indeed, computing the determinant of ${f}^{″}(0,0),$ we get\n\n$$\nH(0,0)=det({f}^{″}(0,0))=(-1)^{2}-{0}^{2}=1>0.\n$$\n\n- Statement II is false. We have $\\frac{{∂}^{2}f}{∂{x}^{2}}(0,0)=({f}^{″}(0,0))_{11}=-1<0.$\n\n- Statement III is true. Indeed, since $H(0,0)>0$ and $\\frac{{∂}^{2}f}{∂{x}^{2}}(0,0)<0,$ the point $(0,0)$ is a local maximum by the second partial derivative test.\n\nTherefore, the correct answer is \"I and III only.\"" #edb/ref 17592186045443] [17592186323917 #edb/ref 1068 #edb/ref 17592186451251 #edb/ref 17592186045436] [17592186323917 #edb/ref 1068 #edb/ref 17592186451252 #edb/ref 17592186045436] [17592186323917 #edb/ref 1068 #edb/ref 17592186451253 #edb/ref 17592186045436] [17592186323917 #edb/ref 1069 "q-37449" #edb/ref 17592186045417] [17592186323917 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186323917 #edb/ref 1071 "The function   $f(x,y)$\nhas the first derivative\n\n$$\n{f}^{′}(x,y)=\\begin{bmatrix}-{x}^{3}+2{x}^{2}+4y & 4x-2y\\end{bmatrix}\n$$\n\nand has a stationary point at $(4,8).$ If $H$ denotes the Hessian determinant of $f,$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $H(4,8)>0$\n- **II.** $\\frac{{∂}^{2}f}{∂{x}^{2}}(4,8)>0$\n- **III.** The point $(4,8)$ is a saddle point of $f$" #edb/ref 17592186045443] [17592186323917 #edb/ref 1072 #uuid "14dd51d6-4da8-56bc-8036-6e67390713d4" #edb/ref 17592186045417] [17592186323917 #edb/ref 1074 "The second partial derivative test states that if $a\\in {R}^{2}$ is a stationary point of $f(x,y)$ with Hessian determinant $H(a),$ we have the following:\n\n- If $H(a)>0,$ then:\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)<0,$ then $f$ has a local maximum at $a$\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)>0,$ then $f$ has a local minimum at $a$\n\n- If $H(a)<0,$ then $f$ has a saddle point at $a$\n\n- If $H(a)=0,$ then the second partial derivatives test is inconclusive.\n\nFirst, we notice that since ${f}^{′}(x,y)=\\begin{bmatrix}-{x}^{3}+2{x}^{2}+4y & 4x-2y\\end{bmatrix},$ we must have \n\n$$\n\\frac{∂f}{∂x}=-{x}^{3}+2{x}^{2}+4y,\\,\\frac{∂f}{∂y}=4x-2y.\n$$\n\nNow, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(-{x}^{3}+2{x}^{2}+4y)=-3{x}^{2}+4x \\\\ \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(4x-2y)=-2 \\\\ \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{{∂}^{2}f}{∂y∂x}=\\frac{∂}{∂x}(4x-2y)=4\\end{aligned}\n$$\n\nSo, the second derivative is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =\\begin{bmatrix}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂x∂y}\\end{bmatrix}=\\begin{bmatrix}-3{x}^{2}+4x & 4 \\\\ 4 & -2\\end{bmatrix}.\\end{aligned}\n$$\n\nEvaluating the second derivative at $(4,8),$ we obtain\n\n$$\n\\begin{aligned}{f}^{″}(4,8)=\\begin{bmatrix}-32 & 4 \\\\ 4 & -2\\end{bmatrix}.\\end{aligned}\n$$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Indeed, computing the determinant of ${f}^{″}(4,8),$ we get\n\n$$\nH(4,8)=det({f}^{″}(4,8))=(-32)\\cdot (-2)-{4}^{2}=48>0.\n$$\n\n- Statement II is false. We have $\\frac{{∂}^{2}f}{∂{x}^{2}}(4,8)=({f}^{″}(4,8))_{11}=-32<0.$\n\n- Statement III is false. Since $H(4,8)>0$ and $\\frac{{∂}^{2}f}{∂{x}^{2}}(4,8)<0,$ the point $(4,8)$ is a local maximum by the second partial derivative test.\n\nTherefore, the correct answer is \"I only.\"" #edb/ref 17592186045443] [17592186348468 #edb/ref 1080 "$f(x,y)$ has a saddle point at $(-1,0)$" #edb/ref 17592186045417] [17592186348468 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186348468 #edb/ref 1083 #uuid "01c2b295-c40e-5849-bc0a-6ab90895eafc" #edb/ref 17592186045417] [17592186349139 #edb/ref 1080 "$f(x,y)$ has a local minimum at $(1,-1)$" #edb/ref 17592186045417] [17592186349139 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186349139 #edb/ref 1083 #uuid "4b98d01b-612c-5ed2-ab6c-3b61169ae757" #edb/ref 17592186045417] [17592186349309 #edb/ref 1080 "$f(x,y)$ has a saddle point at $(0,0)$" #edb/ref 17592186045417] [17592186349309 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186349309 #edb/ref 1083 #uuid "5ddcfc4f-27c5-55c4-ba9c-c1904e0e2050" #edb/ref 17592186045417] [17592186349619 #edb/ref 1080 "$f(x,y)$ has a local maximum at $(0,0)$" #edb/ref 17592186045417] [17592186349619 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186349619 #edb/ref 1083 #uuid "7f92b2d4-abd6-5a84-8fd0-d31b55f917b8" #edb/ref 17592186045417] [17592186349832 #edb/ref 1080 "$f(x,y)$ has a local maximum at $(-1,1)$" #edb/ref 17592186045417] [17592186349832 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186349832 #edb/ref 1083 #uuid "9b87623d-950c-5a5a-bf68-191eabe7390b" #edb/ref 17592186045417] [17592186349890 #edb/ref 1080 "$f(x,y)$ has a saddle point at $(0,0)$" #edb/ref 17592186045417] [17592186349890 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186349890 #edb/ref 1083 #uuid "a1ff7f0e-06dd-5409-86c5-c1a27b7ccac8" #edb/ref 17592186045417] [17592186349977 #edb/ref 1080 "$f(x,y)$ has a local maximum at $(1,-1)$" #edb/ref 17592186045417] [17592186349977 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186349977 #edb/ref 1083 #uuid "aca6c54b-336c-50d0-ab3a-ecba1f3352d4" #edb/ref 17592186045417] [17592186350210 #edb/ref 1080 "$f(x,y)$ has a local minimum at $(0,0)$" #edb/ref 17592186045417] [17592186350210 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186350210 #edb/ref 1083 #uuid "c882bd9a-b5e1-53bc-ab01-c27aef9ae89e" #edb/ref 17592186045417] [17592186350309 #edb/ref 1080 "$f(x,y)$ has a local minimum at $(0,0)$" #edb/ref 17592186045417] [17592186350309 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186350309 #edb/ref 1083 #uuid "d43d1028-d984-5010-bd02-d37d3bcc5bcf" #edb/ref 17592186045417] [17592186350595 #edb/ref 1080 "$f(x,y)$ has a local minimum at $(1,0)$" #edb/ref 17592186045417] [17592186350595 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186350595 #edb/ref 1083 #uuid "f59bdfc1-0e7e-55ea-b183-dde5021e752f" #edb/ref 17592186045417] [17592186350885 #edb/ref 1075 #edb/ref 17592186349139 #edb/ref 17592186045417] [17592186350885 #edb/ref 1075 #edb/ref 17592186349309 #edb/ref 17592186045417] [17592186350885 #edb/ref 1075 #edb/ref 17592186349619 #edb/ref 17592186045417] [17592186350885 #edb/ref 1075 #edb/ref 17592186349977 #edb/ref 17592186045417] [17592186350885 #edb/ref 1075 #edb/ref 17592186350309 #edb/ref 17592186045417] [17592186350885 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186350885 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186350885 #edb/ref 1078 #edb/ref 17592186350309 #edb/ref 17592186045417] [17592186350885 #edb/ref 1079 #uuid "6a680eee-1a4f-5a68-8eb3-d37da5296409" #edb/ref 17592186045417] [17592186351112 #edb/ref 1075 #edb/ref 17592186348468 #edb/ref 17592186045417] [17592186351112 #edb/ref 1075 #edb/ref 17592186349832 #edb/ref 17592186045417] [17592186351112 #edb/ref 1075 #edb/ref 17592186349890 #edb/ref 17592186045417] [17592186351112 #edb/ref 1075 #edb/ref 17592186350210 #edb/ref 17592186045417] [17592186351112 #edb/ref 1075 #edb/ref 17592186350595 #edb/ref 17592186045417] [17592186351112 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186351112 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186351112 #edb/ref 1078 #edb/ref 17592186350210 #edb/ref 17592186045417] [17592186351112 #edb/ref 1079 #uuid "e6d87167-b609-5f30-9204-abd258af2b5c" #edb/ref 17592186045417] [17592186351207 #edb/ref 1068 #edb/ref 17592186351112 #edb/ref 17592186045417] [17592186351207 #edb/ref 1069 "q-81043" #edb/ref 17592186045417] [17592186351207 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186351207 #edb/ref 1071 "Find and categorize all local the extrema of the function $f(x,y)={e}^{x}-x+{y}^{2},$ and determine which of the following statements is true." #edb/ref 17592186045417] [17592186351207 #edb/ref 1072 #uuid "6d35a3af-0061-562b-9545-45ddd0993045" #edb/ref 17592186045417] [17592186351207 #edb/ref 1074 "The local extrema of $f$ occur at its critical points. A point $a$ in the domain of $f$ is a critical point of $f$ if ${f}^{′}(a)={0}^{T}$ (for stationary points) or ${f}^{′}(a)$ doesn't exist.\n\nThe second partial derivative test states that if $a\\in {R}^{2}$ is a stationary point of $f(x,y)$ with Hessian determinant $H(a),$ we have the following:\n\n- If $H(a)>0,$ then:\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)<0,$ then $f$ has a local maximum at $a$\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)>0,$ then $f$ has a local minimum at $a$\n\n- If $H(a)<0,$ then $f$ has a saddle point at $a$\n\n- If $H(a)=0,$ then the second partial derivatives test is inconclusive.\n\nFirst, we compute the first derivative of $f(x,y),$ as follows:\n\n$$\n\\begin{aligned}f′(x,y) & =\\begin{bmatrix}\\frac{∂f}{∂x} & \\frac{∂f}{∂y}\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{∂}{∂x}({e}^{x}-x+{y}^{2}) & \\frac{∂}{∂y}({e}^{x}-x+{y}^{2})\\end{bmatrix} \\\\  & =\\begin{bmatrix}{e}^{x}-1 & 2y\\end{bmatrix}\\end{aligned}\n$$\n\nThe first derivative exists for any $(x,y)$ in the domain of the function, so we only need to find the stationary points. Setting $f′(x,y)={0}^{T},$ we obtain the following system:\n\n$$\n{\\begin{aligned}{e}^{x}-1=0 \\\\ 2y=0.\\end{aligned}\n$$\n\nSolving the first equation for $x$, we get\n\n$$\n{e}^{x}-1=0\\,⟹\\,x=0.\n$$\n\nSolving the second equation for $y,$ we get\n\n$$\n2y=0\\,⟹\\,y=0.\n$$\n\nHence, $(0,0)$ is a stationary point of $f(x,y).$  \n\nTo classify this stationary point, we use the second partial derivative test.\n\nFirst, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}({e}^{x}-1)={e}^{x}\\, & \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(2y)=0 \\\\ \\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}({e}^{x}-1)=0\\, & \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(2y)=2\\end{aligned}\n$$\n\nSo, the second derivative  is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =\\begin{bmatrix}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{bmatrix}=\\begin{bmatrix}{e}^{x} & 0 \\\\ 0 & 2\\end{bmatrix}.\\end{aligned}\n$$\n\nEvaluating the second derivative at $(0,0),$ we obtain\n\n$$\n\\begin{aligned}{f}^{″}(0,0)=\\begin{bmatrix}1 & 0 \\\\ 0 & 2\\end{bmatrix}.\\end{aligned}\n$$\n\nComputing the determinant $H(0,0),$ we get\n\n$$\nH(0,0)=det({f}^{″}(0,0))=1\\cdot 2-{0}^{2}=2>0.\n$$\n\nFinally, notice that \n\n$$\n\\frac{{∂}^{2}f}{∂{x}^{2}}(0,0)=({f}^{″}(0,0))_{11}=1>0.\n$$\n\nTherefore, applying the second partial derivative test, we have that $f(x,y)$ has a local minimum at $(0,0).$" #edb/ref 17592186045443] [17592186351245 #edb/ref 1068 #edb/ref 17592186350885 #edb/ref 17592186045417] [17592186351245 #edb/ref 1069 "q-81167" #edb/ref 17592186045417] [17592186351245 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186351245 #edb/ref 1071 "Find and categorize all local the extrema of the function $f(x,y)={e}^{{x}^{2}+{y}^{2}},$ and determine which of the following statements is true." #edb/ref 17592186045417] [17592186351245 #edb/ref 1072 #uuid "ee951228-2bde-5532-9c92-cd8f867b2b2e" #edb/ref 17592186045417] [17592186351245 #edb/ref 1074 "The local extrema of $f$ occur at its critical points. A point $a$ in the domain of $f$ is a critical point of $f$ if ${f}^{′}(a)={0}^{T}$ (for stationary points) or ${f}^{′}(a)$ doesn't exist.\n\nThe second partial derivative test states that if $a\\in {R}^{2}$ is a stationary point of $f(x,y)$ with Hessian determinant $H(a),$ we have the following:\n\n- If $H(a)>0,$ then:\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)<0,$ then $f$ has a local maximum at $a$\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)>0,$ then $f$ has a local minimum at $a$\n\n- If $H(a)<0,$ then $f$ has a saddle point at $a$\n\n- If $H(a)=0,$ then the second partial derivatives test is inconclusive.\n\nFirst, we compute the first derivative of $f(x,y),$ as follows:\n\n$$\n\\begin{aligned}f′(x,y) & =\\begin{bmatrix}\\frac{∂f}{∂x} & \\frac{∂f}{∂y}\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{∂}{∂x}({e}^{{x}^{2}+{y}^{2}}) & \\frac{∂}{∂y}({e}^{{x}^{2}+{y}^{2}})\\end{bmatrix} \\\\  & =\\begin{bmatrix}2x{e}^{{x}^{2}+{y}^{2}} & 2y{e}^{{x}^{2}+{y}^{2}}\\end{bmatrix}\\end{aligned}\n$$\n\nThe first derivative exists for any $(x,y)$ in the domain of the function, so we only need to find the stationary points. Setting $f′(x,y)={0}^{T},$ we obtain the following system:\n\n$$\n{\\begin{aligned}2x{e}^{{x}^{2}+{y}^{2}}=0 \\\\ 2y{e}^{{x}^{2}+{y}^{2}}=0\\end{aligned}\n$$\n\nSolving the first equation for $x,$ we get\n\n$$\n2x{e}^{{x}^{2}+{y}^{2}}=0\\,⟹\\,x=0.\n$$\n\nSolving the second equation for $y,$ we get\n\n$$\n2y{e}^{{x}^{2}+{y}^{2}}=0\\,⟹\\,y=0.\n$$\n\nHence, $(0,0)$ is a stationary point of $f(x,y).$\n\nTo classify this stationary point, we use the second partial derivative test.\n\nFirst, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(2x{e}^{{x}^{2}+{y}^{2}})=(4{x}^{2}+2){e}^{{x}^{2}+{y}^{2}}\\, & \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(2y{e}^{{x}^{2}+{y}^{2}})=4xy{e}^{{x}^{2}+{y}^{2}} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}(2x{e}^{{x}^{2}+{y}^{2}})=4xy{e}^{{x}^{2}+{y}^{2}}\\, & \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(2y{e}^{{x}^{2}+{y}^{2}})=(4{y}^{2}+2){e}^{{x}^{2}+{y}^{2}}\\end{aligned}\n$$\n\nSo, the second derivative  is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =\\begin{bmatrix}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{bmatrix}=\\begin{bmatrix}(4{x}^{2}+2){e}^{{x}^{2}+{y}^{2}} & 4xy{e}^{{x}^{2}+{y}^{2}} \\\\ 4xy{e}^{{x}^{2}+{y}^{2}} & (4{y}^{2}+2){e}^{{x}^{2}+{y}^{2}}\\end{bmatrix}.\\end{aligned}\n$$\n\nEvaluating the second derivative at $(0,0),$ we obtain\n\n$$\n\\begin{aligned}{f}^{″}(0,0)=\\begin{bmatrix}2 & 0 \\\\ 0 & 2\\end{bmatrix}.\\end{aligned}\n$$\n\nComputing the determinant $H(0,0),$ we get\n\n$$\nH(0,0)=det({f}^{″}(0,0))=2\\cdot 2-{0}^{2}=4>0.\n$$\n\nFinally, notice that \n\n$$\n\\frac{{∂}^{2}f}{∂{x}^{2}}(0,0)=({f}^{″}(0,0))_{11}=2>0.\n$$\n\nTherefore, applying the second partial derivative test, we have that $f(x,y)$ has a local minimum at $(0,0).$" #edb/ref 17592186045443] [17592186364681 #edb/ref 1068 #edb/ref 17592186452497 #edb/ref 17592186045436] [17592186364681 #edb/ref 1068 #edb/ref 17592186452498 #edb/ref 17592186045436] [17592186364681 #edb/ref 1068 #edb/ref 17592186452499 #edb/ref 17592186045436] [17592186364681 #edb/ref 1069 "q-104980" #edb/ref 17592186045417] [17592186364681 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186364681 #edb/ref 1071 "The function $f(x,y)$ has Hessian matrix\n\n$$\n{∇}^{2}f(x,y)=\\begin{bmatrix}{x}^{2}+2(y-3) & 2(x+1) \\\\ 2(x+1) & (y-3)^{2}\\end{bmatrix}\n$$\n\nand has a stationary point at $(-1,3).$ If $H$ denotes the Hessian determinant of $f,$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $H(-1,3)<0$\n- **II.** $\\frac{{∂}^{2}f}{∂{x}^{2}}(-1,3)>0$\n- **III.** The second partial derivative test is inconclusive" #edb/ref 17592186045443] [17592186364681 #edb/ref 1072 #uuid "a2adfa73-7e18-5d5d-8163-694e5efa8a14" #edb/ref 17592186045417] [17592186364681 #edb/ref 1074 "The second partial derivative test states that if $a\\in {R}^{2}$ is a stationary point of $f(x,y)$ with Hessian determinant $H(a),$ then:\n\n- If $H(a)>0,$ then:\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)<0,$ then $f$ has a local maximum at $a$;\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)>0,$ then $f$ has a local minimum at $a.$\n\n- If $H(a)<0,$ then $f$ has a saddle point at $a.$\n\n- If $H(a)=0,$ then the second partial derivative test is inconclusive.\n\nEvaluating the Hessian at $(-1,3),$ we obtain\n\n$$\n{∇}^{2}f(-1,3)=\\begin{bmatrix}(-1)^{2}+2(3-3) & 2(-1+1) \\\\ 2(-1+1) & (3-3)^{2}\\end{bmatrix}=\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix}.\n$$\n\nNow, let's examine the statements.\n\n- Statement I is false. The Hessian determinant is\n\n$$\nH(-1,3)=det({∇}^{2}f(-1,3))=1(0)-0(0)=0.\n$$\n\n- Statement II is true because\n\n$$\n\\frac{{∂}^{2}f}{∂{x}^{2}}(-1,3)=1>0.\n$$\n\n- Statement III is true because $H(-1,3)=0,$ so the second partial derivative test is inconclusive.\n\nTherefore, the correct answer is \"II and III only.\"" #edb/ref 17592186045443] [17592186364688 #edb/ref 1068 #edb/ref 17592186364689 #edb/ref 17592186045417] [17592186364688 #edb/ref 1069 "q-105284" #edb/ref 17592186045417] [17592186364688 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186364688 #edb/ref 1071 "Find and categorize all local the extrema of the function $f(x,y)={x}^{2}+3{y}^{2}-4x+4,$ and determine which of the following statements is true." #edb/ref 17592186045417] [17592186364688 #edb/ref 1072 #uuid "265e39ea-f8c9-5146-9ac4-7988205838c0" #edb/ref 17592186045417] [17592186364688 #edb/ref 1074 "The local extrema of $f$ occur at its critical points. A point $a$ in the domain of $f$ is a critical point of $f$ if ${f}^{′}(a)={0}^{T}$ (for stationary points) or ${f}^{′}(a)$ doesn't exist.\n\nThe second partial derivative test states that if $a\\in {R}^{2}$ is a stationary point of $f(x,y)$ with Hessian determinant $H(a),$ we have the following:\n\n- If $H(a)>0,$ then:\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)<0,$ then $f$ has a local maximum at $a$\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)>0,$ then $f$ has a local minimum at $a$\n\n- If $H(a)<0,$ then $f$ has a saddle point at $a$\n\n- If $H(a)=0,$ then the second partial derivatives test is inconclusive.\n\nFirst, we compute the first derivative of $f(x,y),$ as follows:\n\n$$\n\\begin{aligned}f′(x,y) & =\\begin{bmatrix}\\frac{∂f}{∂x} & \\frac{∂f}{∂y}\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{∂}{∂x}({x}^{2}+3{y}^{2}-4x+4) & \\frac{∂}{∂y}({x}^{2}+3{y}^{2}-4x+4)\\end{bmatrix} \\\\  & =\\begin{bmatrix}2x-4 & 6y\\end{bmatrix}\\end{aligned}\n$$\n\nThe first derivative exists for any $(x,y)$ in the domain of the function, so we only need to find the stationary points. Setting $f′(x,y)={0}^{T},$ we obtain the following system:\n\n$$\n{\\begin{aligned}2x-4=0 \\\\ 6y=0\\end{aligned}\n$$\n\nSolving the first equation for $x,$ we get\n\n$$\n2x-4=0\\,⟹\\,x=2.\n$$\n\nSolving the second equation for $y,$ we get\n\n$$\n6y=0\\,⟹\\,y=0.\n$$\n\nHence, $(2,0)$ is a stationary point of $f(x,y).$\n\nTo classify this stationary point, we use the second partial derivative test.\n\nFirst, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(2x-4)=2\\, & \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(6y)=0 \\\\ \\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}(2x-4)=0\\, & \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(6y)=6\\end{aligned}\n$$\n\nSo, the second derivative  is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =\\begin{bmatrix}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{bmatrix}=\\begin{bmatrix}2 & 0 \\\\ 0 & 6\\end{bmatrix}.\\end{aligned}\n$$\n\nEvaluating the second derivative at $(2,0),$ we obtain\n\n$$\n\\begin{aligned}{f}^{″}(2,0)=\\begin{bmatrix}2 & 0 \\\\ 0 & 6\\end{bmatrix}.\\end{aligned}\n$$\n\nComputing the determinant $H(2,0),$ we get\n\n$$\nH(2,0)=det({f}^{″}(2,0))=2\\cdot 6-{0}^{2}=12>0.\n$$\n\nFinally, notice that \n\n$$\n\\frac{{∂}^{2}f}{∂{x}^{2}}(2,0)=({f}^{″}(2,0))_{11}=2>0.\n$$\n\nTherefore, applying the second partial derivative test, we have that $f(x,y)$ has a local minimum at $(2,0).$" #edb/ref 17592186045443] [17592186364689 #edb/ref 1075 #edb/ref 17592186364690 #edb/ref 17592186045417] [17592186364689 #edb/ref 1075 #edb/ref 17592186364691 #edb/ref 17592186045417] [17592186364689 #edb/ref 1075 #edb/ref 17592186364692 #edb/ref 17592186045417] [17592186364689 #edb/ref 1075 #edb/ref 17592186364693 #edb/ref 17592186045417] [17592186364689 #edb/ref 1075 #edb/ref 17592186364694 #edb/ref 17592186045417] [17592186364689 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186364689 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186364689 #edb/ref 1078 #edb/ref 17592186364692 #edb/ref 17592186045417] [17592186364689 #edb/ref 1079 #uuid "a892e43b-67a8-5cd6-aed3-b41a3dd2b871" #edb/ref 17592186045417] [17592186364690 #edb/ref 1080 "$f(x,y)$ has a local minimum at $(1,2)$" #edb/ref 17592186045417] [17592186364690 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186364690 #edb/ref 1083 #uuid "e870df35-a29a-5740-b1a9-fc27a59659f0" #edb/ref 17592186045417] [17592186364691 #edb/ref 1080 "$f(x,y)$ has a saddle point at $(2,0)$" #edb/ref 17592186045417] [17592186364691 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186364691 #edb/ref 1083 #uuid "3dc15fc6-ed64-52d5-ac6c-18f4a5d6f76d" #edb/ref 17592186045417] [17592186364692 #edb/ref 1080 "$f(x,y)$ has a local minimum at $(2,0)$" #edb/ref 17592186045417] [17592186364692 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186364692 #edb/ref 1083 #uuid "e5d211e6-d042-5039-a26f-2a692ad7c3f1" #edb/ref 17592186045417] [17592186364693 #edb/ref 1080 "$f(x,y)$ has a local maximum at $(1,2)$" #edb/ref 17592186045417] [17592186364693 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186364693 #edb/ref 1083 #uuid "ffcc138d-043f-51f3-9bd9-aad344676fad" #edb/ref 17592186045417] [17592186364694 #edb/ref 1080 "$f(x,y)$ has a local maximum at $(2,0)$" #edb/ref 17592186045417] [17592186364694 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186364694 #edb/ref 1083 #uuid "1188a71b-6d30-5d7c-b671-eeb3e30204cb" #edb/ref 17592186045417] [17592186366372 #edb/ref 1068 #edb/ref 17592186366373 #edb/ref 17592186045417] [17592186366372 #edb/ref 1069 "q-81041" #edb/ref 17592186045417] [17592186366372 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186366372 #edb/ref 1071 "Find and categorize all the local extrema of the function \n$f(x,y)$ \ngiven that\n\n$$\n{f}^{′}(x,y)=\\begin{bmatrix}4x & 2{y}^{2}-2\\end{bmatrix}.\n$$" #edb/ref 17592186045443] [17592186366372 #edb/ref 1072 #uuid "16f8ddbb-3563-5450-8b85-07ba89da4f50" #edb/ref 17592186045417] [17592186366372 #edb/ref 1074 "The local extrema of $f$ occur at its critical points. A point $a$ in the domain of $f$ is a critical point of $f$ if ${f}^{′}(a)={0}^{T}$ (for stationary points) or ${f}^{′}(a)$ doesn't exist.\n\nThe second partial derivative test states that if $a\\in {R}^{2}$ is a stationary point of $f(x,y)$ with Hessian determinant $H(a),$ we have the following:\n\n- If $H(a)>0,$ then:\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)<0,$ then $f$ has a local maximum at $a$\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)>0,$ then $f$ has a local minimum at $a$\n\n- If $H(a)<0,$ then $f$ has a saddle point at $a$\n\n- If $H(a)=0,$ then the second partial derivatives test is inconclusive.\n\nFirst, notice that since ${f}^{′}(x,y)=\\begin{bmatrix}4x & 2{y}^{2}-2\\end{bmatrix},$ we must have \n\n$$\n\\frac{∂f}{∂x}=4x,\\,\\frac{∂f}{∂y}=2{y}^{2}-2.\n$$\n\nThe first derivative exists for any $(x,y)$ in the domain of the function, so we only need to find the stationary points. Setting ${f}^{′}(x,y)={0}^{T},$ we obtain the following system:\n\n$$\n{\\begin{aligned}4x=0 \\\\ 2{y}^{2}=2\\end{aligned}\\,⟹\\,{\\begin{aligned}x=0 \\\\ y=\\pm 1\\end{aligned}\n$$\n\nHence, $(0,1)$ and $(0,-1)$ are the stationary points of $f(x,y).$\n\nTo classify these stationary points, we use the second partial derivative test.\n\nFirst, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(4x)=4\\, & \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(2{y}^{2}-2)=0 \\\\ \\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}(4x)=0\\, & \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(2{y}^{2}-2)=4y\\end{aligned}\n$$\n\nSo, the second derivative is \n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =\\begin{bmatrix}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{bmatrix}=\\begin{bmatrix}4 & 0 \\\\ 0 & 4y\\end{bmatrix}.\\end{aligned}\n$$\n\nFinally, we evaluate the second derivative at each of the stationary points and use it to categorize them:\n\n- Evaluating the second derivative at $(0,1),$ we obtain\n\n$$\n\\begin{aligned}{f}^{″}(0,1)=\\begin{bmatrix}4 & 0 \\\\ 0 & 4\\end{bmatrix}.\\end{aligned}\n$$\n\nComputing the determinant $H(0,1),$ we get\n\n$$\ndet(H(0,1))=4\\cdot 4-{0}^{2}=16>0.\n$$\n\nNow, since $H(0,1)>0$ and $\\frac{{∂}^{2}f}{∂{x}^{2}}(0,1)=({f}^{″}(0,1))_{11}=4>0,$ the function $f$ has a local minimum at $(0,1).$\n\n- Evaluating the second derivative at $(0,-1),$ we obtain\n\n$$\n\\begin{aligned}{f}^{″}(0,-1)=\\begin{bmatrix}4 & 0 \\\\ 0 & -4\\end{bmatrix}.\\end{aligned}\n$$\n\nComputing the determinant of $H(0,-1),$ we get\n\n$$\ndet(H(-1,0))=4\\cdot (-4)-{0}^{2}=-16<0\n$$\n\nTherefore, $f(0,-1)$ is saddle point.\n\nIn conclusion, $f(x,y)$ has a saddle point at $(0,-1)$ and a local minimum at $(0,1).$" #edb/ref 17592186045443] [17592186366373 #edb/ref 1075 #edb/ref 