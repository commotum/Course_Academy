ow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mo stretchy=\"false\">(</mo><mi>z</mi><mo>+</mo><mn>7</mn><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup><mo>+</mo><mn>30</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>30</mn><mo>−</mo><mo stretchy=\"false\">(</mo><mi>z</mi><mo>+</mo><mn>7</mn><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
