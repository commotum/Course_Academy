/mi></mrow><mrow><mi>∂</mi><mi>v</mi></mrow></mfrac></mstyle></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">|</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">|</mo><mtable columnalign=\"center\" columnspacing=\"1em\" rowspacing=\"4pt\"><mtr><mtd><mi>ln</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>v</mi></mtd><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mi>u</mi><mi>v</mi></mfrac></mstyle></mtd></mtr><mtr><mtd><mn>2</mn><mi>u</mi><msup><mi>v</mi><mn>2</mn></msup></mtd><mtd><mn>2</mn><msup><mi>u</mi><mn>2</mn></msup><mi>v</mi></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">|</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mi>ln</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>v</mi><mo>⋅</mo><mn>2</mn><msup><mi>u</mi><mn>2</mn></msup><mi>v</mi><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mi>u</mi><mi>v</mi></mfrac></mstyle><mo>⋅</mo><mn>2</mn><mi>u</mi><msup><mi>v</mi><mn>2</mn></msup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>2</mn><msup><mi>u</mi><mn>2</mn></msup><mi>v</mi><mo stretchy=\"false\">(</mo><mi>ln</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>v</mi><mo>−</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
