"OPEN\">|</mo><mtable columnalign=\"center\" columnspacing=\"1em\" rowspacing=\"4pt\"><mtr><mtd><mo>−</mo><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mo stretchy=\"false\">(</mo><mi>u</mi><mo>+</mo><mi>v</mi><mo stretchy=\"false\">)</mo></mtd><mtd><mo>−</mo><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mo stretchy=\"false\">(</mo><mi>u</mi><mo>+</mo><mi>v</mi><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd><mstyle scriptlevel=\"0\"><mspace width=\"1em\"></mspace></mstyle><mtext>&nbsp;</mtext><mn>4</mn><mstyle scriptlevel=\"0\"><mspace width=\"1em\"></mspace></mstyle></mtd><mtd><mstyle scriptlevel=\"0\"><mspace width=\"1em\"></mspace></mstyle><mtext>&nbsp;</mtext><mn>6</mn></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">|</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mo stretchy=\"false\">(</mo><mi>u</mi><mo>+</mo><mi>v</mi><mo stretchy=\"false\">)</mo><mo>⋅</mo><mn>6</mn><mo>−</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mo stretchy=\"false\">(</mo><mi>u</mi><mo>+</mo><mi>v</mi><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">)</mo><mo>⋅</mo><mn>4</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mn>2</mn><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mo stretchy=\"false\">(</mo><mi>u</mi><mo>+</mo><mi>v</mi><mo stretchy=\"false\">)</mo><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
