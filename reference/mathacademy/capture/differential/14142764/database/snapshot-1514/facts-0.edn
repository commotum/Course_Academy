ef 17592186045417] [17592186129263 #edb/ref 1038 #edb/ref 17592186383515 #edb/ref 17592186045417] [17592186129263 #edb/ref 1038 #edb/ref 17592186417356 #edb/ref 17592186045417] [17592186129263 #edb/ref 1039 "Evaluating a Jacobian Determinant" #edb/ref 17592186045417] [17592186129263 #edb/ref 1041 #edb/ref 17592186128838 #edb/ref 17592186045417] [17592186129263 #edb/ref 1042 #uuid "ab643519-92a4-5ccf-b826-fb2a68b36534" #edb/ref 17592186045417] [17592186129282 #edb/ref 1037 #edb/ref 17592186049035 #edb/ref 17592186045417] [17592186129282 #edb/ref 1038 #edb/ref 17592186129525 #edb/ref 17592186045417] [17592186129282 #edb/ref 1038 #edb/ref 17592186129527 #edb/ref 17592186045417] [17592186129282 #edb/ref 1038 #edb/ref 17592186281348 #edb/ref 17592186045417] [17592186129282 #edb/ref 1038 #edb/ref 17592186281366 #edb/ref 17592186045417] [17592186129282 #edb/ref 1038 #edb/ref 17592186281367 #edb/ref 17592186045417] [17592186129282 #edb/ref 1038 #edb/ref 17592186281368 #edb/ref 17592186045417] [17592186129282 #edb/ref 1038 #edb/ref 17592186281371 #edb/ref 17592186045417] [17592186129282 #edb/ref 1038 #edb/ref 17592186281372 #edb/ref 17592186045417] [17592186129282 #edb/ref 1038 #edb/ref 17592186383568 #edb/ref 17592186045417] [17592186129282 #edb/ref 1038 #edb/ref 17592186383575 #edb/ref 17592186045417] [17592186129282 #edb/ref 1038 #edb/ref 17592186389216 #edb/ref 17592186045417] [17592186129282 #edb/ref 1039 "Identifying the Local Area Scale Factor of a Transformation" #edb/ref 17592186045417] [17592186129282 #edb/ref 1041 #edb/ref 17592186128860 #edb/ref 17592186045417] [17592186129282 #edb/ref 1042 #uuid "6d82be73-0720-5267-8698-427641b0e66e" #edb/ref 17592186045417] [17592186129283 #edb/ref 1037 #edb/ref 17592186050992 #edb/ref 17592186045417] [17592186129283 #edb/ref 1038 #edb/ref 17592186129503 #edb/ref 17592186045417] [17592186129283 #edb/ref 1038 #edb/ref 17592186129509 #edb/ref 17592186045417] [17592186129283 #edb/ref 1038 #edb/ref 17592186281352 #edb/ref 17592186045417] [17592186129283 #edb/ref 1038 #edb/ref 17592186281353 #edb/ref 17592186045417] [17592186129283 #edb/ref 1038 #edb/ref 17592186281354 #edb/ref 17592186045417] [17592186129283 #edb/ref 1038 #edb/ref 17592186281360 #edb/ref 17592186045417] [17592186129283 #edb/ref 1038 #edb/ref 17592186383547 #edb/ref 17592186045417] [17592186129283 #edb/ref 1038 #edb/ref 17592186389181 #edb/ref 17592186045417] [17592186129283 #edb/ref 1038 #edb/ref 17592186389188 #edb/ref 17592186045417] [17592186129283 #edb/ref 1038 #edb/ref 17592186389195 #edb/ref 17592186045417] [17592186129283 #edb/ref 1038 #edb/ref 17592186389202 #edb/ref 17592186045417] [17592186129283 #edb/ref 1038 #edb/ref 17592186389209 #edb/ref 17592186045417] [17592186129283 #edb/ref 1039 "Finding Regions Where a Transformation is Orientation-Preserving or Reversing" #edb/ref 17592186045417] [17592186129283 #edb/ref 1041 #edb/ref 17592186128861 #edb/ref 17592186045417] [17592186129283 #edb/ref 1042 #uuid "091b8235-56d8-5a08-bc95-08c99772cfd8" #edb/ref 17592186045417] [17592186129344 #edb/ref 1043 #edb/ref 17592186130064 #edb/ref 17592186045417] [17592186129344 #edb/ref 1043 #edb/ref 17592186130065 #edb/ref 17592186045417] [17592186129344 #edb/ref 1043 #edb/ref 17592186130202 #edb/ref 17592186045417] [17592186129344 #edb/ref 1043 #edb/ref 17592186130225 #edb/ref 17592186045417] [17592186129344 #edb/ref 1043 #edb/ref 17592186130226 #edb/ref 17592186045417] [17592186129344 #edb/ref 1043 #edb/ref 17592186130227 #edb/ref 17592186045417] [17592186129344 #edb/ref 1043 #edb/ref 17592186130230 #edb/ref 17592186045417] [17592186129344 #edb/ref 1043 #edb/ref 17592186130231 #edb/ref 17592186045417] [17592186129344 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186129344 #edb/ref 1045 "The Jacobian" #edb/ref 17592186045417] [17592186129344 #edb/ref 1046 #edb/ref 17592186130064 #edb/ref 17592186045417] [17592186129344 #edb/ref 1049 #edb/ref 17592186048219 #edb/ref 17592186045417] [17592186129344 #edb/ref 1050 900.0 #edb/ref 17592186045417] [17592186129344 #edb/ref 1053 #uuid "24e4f3d3-57f6-51a9-afd6-0c3e9a2f8f97" #edb/ref 17592186045417] [17592186129507 #edb/ref 1068 #edb/ref 17592186277874 #edb/ref 17592186045417] [17592186129507 #edb/ref 1069 "q-160380" #edb/ref 17592186045417] [17592186129507 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186129507 #edb/ref 1071 "For the transformation $T,$ defined as\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}2u\\operatorname{cos}⁡v \\\\ 3u\\operatorname{sin}⁡v\\end{aligned}]\n$$\n\ncompute the value of the Jacobian determinant at the point where $[\\begin{aligned}u \\\\ v\\end{aligned}]=[\\begin{aligned}1 \\\\ 2\\end{aligned}].$" #edb/ref 17592186045417] [17592186129507 #edb/ref 1072 #uuid "ba3c81ec-9070-50b3-af3a-82e4e50bb35c" #edb/ref 17592186045417] [17592186129507 #edb/ref 1074 "Given a transformation \n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]\\to [\\begin{aligned}x(u,v) \\\\ y(u,v)\\end{aligned}],\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y)}{∂(u,v)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}|.\\end{aligned}\n$$\n\nHere, we have $x(u,v)=2u\\operatorname{cos}⁡v$ and $y(u,v)=3u\\operatorname{sin}⁡v.$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & =2\\operatorname{cos}⁡v & \\,\\frac{∂x}{∂v} & =-2u\\operatorname{sin}⁡v \\\\ \\frac{∂y}{∂u} & =3\\operatorname{sin}⁡v & \\,\\frac{∂y}{∂v} & =3u\\operatorname{cos}⁡v\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}2\\operatorname{cos}⁡v & -2u\\operatorname{sin}⁡v \\\\ 3\\operatorname{sin}⁡v & 3u\\operatorname{cos}⁡v\\end{aligned}| \\\\  & =2\\operatorname{cos}⁡v\\cdot 3u\\operatorname{cos}⁡v-(-2u\\operatorname{sin}⁡v)\\cdot 3\\operatorname{sin}⁡v \\\\  & =6u({cos}^{2}⁡v+{cos}^{2}⁡v) \\\\  & =6u.\\end{aligned}\n$$\n\nFinally, when $[\\begin{aligned}u \\\\ v\\end{aligned}]=[\\begin{aligned}1 \\\\ 2\\end{aligned}],$ the value of our Jacobian determinant is\n\n$$\n{\\frac{∂(x,y)}{∂(u,v)}|}_{(1,2)}=6(1)=6.\n$$" #edb/ref 17592186045417] [17592186129509 #edb/ref 1068 #edb/ref 17592186389029 #edb/ref 17592186045417] [17592186129509 #edb/ref 1069 "q-160601" #edb/ref 17592186045417] [17592186129509 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186129509 #edb/ref 1071 "Which of the following shows the region in the $uv$-plane where the transformation $T,$ given by\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}{u}^{2}-v \\\\ 4u-{v}^{2}\\end{aligned}],\n$$\n\nis (locally) orientation-preserving?" #edb/ref 17592186045417] [17592186129509 #edb/ref 1072 #uuid "4471fd6f-9a7d-5e2e-b974-bcbd5ed1ceb0" #edb/ref 17592186045417] [17592186129509 #edb/ref 1074 "Recall that a transformation is (locally) orientation-preserving at the points where the Jacobian determinant is positive:\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}>0.\n$$\n\nWe have\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}{u}^{2}-v \\\\ 4u-{v}^{2}\\end{aligned}].\n$$\n\nComputing the corresponding Jacobian determinant, we obtain \n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}2u & -1 \\\\ 4 & -2v\\end{aligned}| \\\\  & =2u\\cdot (-2v)-4\\cdot (-1) \\\\  & =-4uv+4.\\end{aligned}\n$$\n\nTo find the required regions, we solve the following inequality:\n\n$$\n\\begin{aligned}-4uv+4 & >0 \\\\ -4uv & >-4 \\\\ uv & <1\\end{aligned}\n$$\n\n \n\nThis gives the solution $v<\\frac{1}{u}$ for $u>0$ and $v>\\frac{1}{u}$ for $u<0.$\n\nNotice that the equation \n\n$$\nv=\\frac{1}{u}\n$$\n\ndefines a hyperbola, and the coordinates of, say, $(1,-1)$ satisfy the inequality. \n\nTherefore, the region where the transformation is (locally) orientation-preserving must be the following:\n\n![](images/fe/fe7bb422a3f992ea88a900e63b2c55df99bce3a785929901c248abadfadf23f1.png)" #edb/ref 17592186045417] [17592186129525 #edb/ref 1068 #edb/ref 17592186383529 #edb/ref 17592186045417] [17592186129525 #edb/ref 1069 "q-161788" #edb/ref 17592186045417] [17592186129525 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186129525 #edb/ref 1071 "Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(1,2)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $T,$ given by\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}{u}^{2}+v \\\\ 2u-{v}^{3}\\end{aligned}]?\n$$" #edb/ref 17592186045417] [17592186129525 #edb/ref 1072 #uuid "fff1ef63-7fa2-5e33-aa47-b4df6f56d662" #edb/ref 17592186045417] [17592186129525 #edb/ref 1074 "Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\n\n$$\n\\text{Area}(T(Δ))≈|\\frac{∂(x,y)}{∂(u,v)}|\\cdot {{\\text{Area}(Δ)}_{⏟}}_{\\delta A}\n$$\n\n \n\nComputing the corresponding Jacobian determinant, we obtain the following:\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}2u & 1 \\\\ 2 & -3{v}^{2}\\end{aligned}| \\\\  & =2u\\cdot (-3{v}^{2})-1\\cdot 2 \\\\  & =-6u{v}^{2}-2 \\\\ {\\frac{∂(x,y)}{∂(u,v)}|}_{(1,2)} & =(-6u{v}^{2}-2)\\,{|}_{u=1\\,v=2} \\\\  & =-6(1)(2)^{2}-2 \\\\  & =-26\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\text{Area}(T(Δ)) & ≈|-26|\\cdot \\delta A \\\\  & =26\\,\\delta A.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186130064 #edb/ref 1058 #edb/ref 17592186130225 #edb/ref 17592186045417] [17592186130064 #edb/ref 1061 25202 #edb/ref 17592186045417] [17592186130064 #edb/ref 1062 #uuid "5564d0a2-de60-5f46-b603-c6061aab85f2" #edb/ref 17592186045417] [17592186130064 #edb/ref 1063 #edb/ref 17592186130392 #edb/ref 17592186045417] [17592186130065 #edb/ref 1058 #edb/ref 17592186130202 #edb/ref 17592186045417] [17592186130065 #edb/ref 1061 25204 #edb/ref 17592186045417] [17592186130065 #edb/ref 1062 #uuid "838542bc-20ad-57ca-b114-1923593d1021" #edb/ref 17592186045417] [17592186130065 #edb/ref 1063 #edb/ref 17592186129187 #edb/ref 17592186045417] [17592186130202 #edb/ref 1058 #edb/ref 17592186130226 #edb/ref 17592186045417] [17592186130202 #edb/ref 1061 42421 #edb/ref 17592186045417] [17592186130202 #edb/ref 1062 #uuid "0954c2f4-d0e0-56be-8d88-2f803b4f5152" #edb/ref 17592186045417] [17592186130202 #edb/ref 1063 #edb/ref 17592186129263 #edb/ref 17592186045417] [17592186130225 #edb/ref 1058 #edb/ref 17592186130065 #edb/ref 17592186045417] [17592186130225 #edb/ref 1061 44550 #edb/ref 17592186045417] [17592186130225 #edb/ref 1062 #uuid "eadcf9f2-f662-5ba3-8bbc-b9166dfa1142" #edb/ref 17592186045417] [17592186130225 #edb/ref 1063 #edb/ref 17592186130460 #edb/ref 17592186045417] [17592186130226 #edb/ref 1058 #edb/ref 17592186130227 #edb/ref 17592186045417] [17592186130226 #edb/ref 1061 44557 #edb/ref 17592186045417] [17592186130226 #edb/ref 1062 #uuid "c956f456-bd29-5cf7-83bd-de9b757b718f" #edb/ref 17592186045417] [17592186130226 #edb/ref 1063 #edb/ref 17592186130461 #edb/ref 17592186045417] [17592186130227 #edb/ref 1058 #edb/ref 17592186130230 #edb/ref 17592186045417] [17592186130227 #edb/ref 1061 44558 #edb/ref 17592186045417] [17592186130227 #edb/ref 1062 #uuid "0e6a94d3-c32f-5582-98ea-69a8605ef653" #edb/ref 17592186045417] [17592186130227 #edb/ref 1063 #edb/ref 17592186130462 #edb/ref 17592186045417] [17592186130230 #edb/ref 1058 #edb/ref 17592186130231 #edb/ref 17592186045417] [17592186130230 #edb/ref 1061 44604 #edb/ref 17592186045417] [17592186130230 #edb/ref 1062 #uuid "4b57bfb4-8aa6-5afc-b54b-581e471d245a" #edb/ref 17592186045417] [17592186130230 #edb/ref 1063 #edb/ref 17592186129282 #edb/ref 17592186045417] [17592186130231 #edb/ref 1061 44605 #edb/ref 17592186045417] [17592186130231 #edb/ref 1062 #uuid "3dc69ec2-a31b-570c-8cf5-3d69b616fa0a" #edb/ref 17592186045417] [17592186130231 #edb/ref 1063 #edb/ref 17592186129283 #edb/ref 17592186045417] [17592186130392 #edb/ref 1064 "We have explored linear and affine transformations in the plane. We'll now begin to explore nonlinear transformations of plane regions. \n\nLet  $\\mathbf{T}: U \\to \\mathbb{R}^2$ be a **transformation** on an open set $U\\subseteq \\mathbb R^2.$ We write\n![](images/11/1137221ffc72c194aba941eaee899cc0a4134a92e92e86cfa65c88acd5f702ec.svg) \n\nRecall that, under this notation, \n\n- ![](images/0d/0decb326ae66f97fb75a8df874479061fb1557b0437ca8ea1e7c5ed645db4b19.svg) represents vectors belonging to the input space (i.e., the $uv$-plane), and\n\n- ![](images/09/091b7a3ddf6ad7dc35360e728c2946481b3a17f60525d09676eb469ebd518a4d.svg) represents vectors belonging to the output space (i.e., the $xy$-plane).\n\nFor example, consider the following transformation:\n\n![](images/23/239781240f2def3a5adf5331f36fa6dbdd3657ab431195c30cf3ede49d2ef3e2.svg) \n\nGeometrically, this transformation maps the rectangular region in the $uv$-plane below to a circular sector in the $xy$-plane.\n\n![](images/dc/dcc80fe1271d560e9f958eba9454761d56f936567dc439853bc4181cccc3f76f.png)\n\nWe'll explore how to compute the image of a nonlinear transformation in future lessons. But for now, it is sufficient to know that \n\n- $\\mathbf T$ takes points (or vectors) from the $uv$-plane as input and maps them to points (vectors) in the $xy$-plane, and\n\n- rectangular regions in the $uv$-plane are mapped to regions in the $xy$-plane that are not necessarily parallelograms." #edb/ref 17592186045417] [17592186130392 #edb/ref 1065 4147 #edb/ref 17592186045417] [17592186130392 #edb/ref 1066 #uuid "c831da3f-8fff-5c5b-8be5-f3602a7303ba" #edb/ref 17592186045417] [17592186130392 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186130460 #edb/ref 1064 "Suppose that $\\mathbf{T}: U \\to \\mathbb{R}^2$ is a transformation given by\n\n![](images/f9/f9a1c3375eed570284c4e001f119f21901f4493a0b851919b92b678a74187444.svg) \n\nWe'll assume that $\\mathbf T$ is a $\\boldsymbol{C}^1$ **transformation**, which means that  $x$ and $y$ have continuous first-order partial derivatives on an open set $U$ contained in $\\Bbb R^2.$ \n\nThe **Jacobian determinant** of $\\mathbf T,$ denoted $\\dfrac{\\partial (x, y)}{\\partial (u, v)} ,$ is defined as\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}|=\\frac{∂x}{∂u}\\cdot \\frac{∂y}{∂v}-\\frac{∂x}{∂v}\\cdot \\frac{∂y}{∂u}\\end{aligned}\n$$\n\n  \n\nWe sometimes refer to the Jacobian determinant simply as the **Jacobian.**\n\nLet's compute the Jacobian determinant of the following transformation:\n\n![](images/b4/b433bcafea1c84c67f2fb65ac8343a4d8401ce6d4e745f6d464b010a4258164a.svg) \n\nTo compute the Jacobian determinant of this function, we first calculate the required partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & =\\operatorname{cos}⁡v & \\,\\frac{∂x}{∂v} & =-u\\operatorname{sin}⁡v \\\\ \\frac{∂y}{∂u} & =\\operatorname{sin}⁡v & \\,\\frac{∂y}{∂v} & =u\\operatorname{cos}⁡v\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\operatorname{cos}⁡v & -u\\operatorname{sin}⁡v \\\\ \\operatorname{sin}⁡v & u\\operatorname{cos}⁡v\\end{aligned}| \\\\  & =\\operatorname{cos}⁡v\\cdot (u\\operatorname{cos}⁡v)-(-u\\operatorname{sin}⁡v)\\cdot \\operatorname{sin}⁡v \\\\  & =u{cos}^{2}⁡v+u{sin}^{2}⁡v \\\\  & =u({cos}^{2}⁡v+{sin}^{2}⁡v) \\\\  & =u.\\end{aligned}\n$$\n\n \n\nWe'll spend some time discussing the meaning behind the Jacobian shortly. But for now, let's get some practice at computing it." #edb/ref 17592186045417] [17592186130460 #edb/ref 1065 7668 #edb/ref 17592186045417] [17592186130460 #edb/ref 1066 #uuid "f0ea7366-d3d6-5645-99d8-72f7febb8d19" #edb/ref 17592186045417] [17592186130460 #edb/ref 1067 "The Jacobian Determinant" #edb/ref 17592186045417] [17592186130461 #edb/ref 1064 "To understand what the Jacobian describes, we recall our knowledge of affine transformations.\n\nConsider the affine transformation $\\mathbf T:\\Bbb R^2 \\to \\Bbb R^2,$ defined by the matrix equation \n\n$$\n\\mathbf x = T\\mathbf u + \\mathbf b,\n$$\n\nwhere $\\mathbf u, \\mathbf b,$ and $\\mathbf x$ are vectors from $\\mathbb R^2,$ and $T$ is a $2\\times 2$ matrix. \n\nFor an affine transformation, the determinant of $T$ gives us the following information:\n\n- The *area scale factor* of the transformation:\n\nIf a rectangle in the $uv$-plane has area $A,$ its image in the $xy$-plane is a parallelogram of area $|\\det(T)|\\cdot A.$\n\n![](images/04/04f36d98bf7589d1faadeffee0812590337fd36d8bb44f5abe1920948dee5bb0.png)\n\n- Whether the transformation is *orientation-preserving* or *orientation-reversing:*\n\nIf $\\textrm{det}(T) > 0,$ the transformation is orientation-preserving.\n\n![](images/49/496a49ee541eab31f69f9c571e450547b0c6942b100bc8e24fbd927dd43e4d33.png)\n\nIf $\\textrm{det}(T) < 0,$ the transformation is orientation-reversing.\n\n![](images/21/211369d6f3fc70bcf7cf40f3270c24c245d306247efc429cb85589e42c19ee07.png)\n\n- Whether the transformation is *invertible* or *non-invertible:*\n\nIf $\\textrm{det}(T) \\neq 0,$ the transformation is invertible.\n\n![](images/e4/e4b840ad5a3efa082ac4056d1d9b7c03d2e3e11e016e053df055dbb2b39f0d1f.png)\n\nIf $\\textrm{det}(T) = 0,$ the transformation is non-invertible. In such cases, a rectangle in the $uv$-plane collapses to either a line segment or point in the $xy$-plane.\n\n![](images/9a/9a038c5de0e9f3205194fd7941a4b371c695c51c294f2ad5ac0b8fc1015811d1.png)\n\n![](images/98/9813ba294a0242abbfb885ebd3e82505d05a2f8a1cfa3975c7859f9530cac8b1.png)\n\nAffine transformations are special because these properties are *global*. In other words, they apply *everywhere* in the plane. So, for example, if $\\textrm{det}(T) = 2$, then the image of *every* rectangle in the $uv$-plane is a parallelogram with double the area of its preimage." #edb/ref 17592186045417] [17592186130461 #edb/ref 1065 7672 #edb/ref 17592186045417] [17592186130461 #edb/ref 1066 #uuid "4dcb1ce1-bfad-524c-a89a-a589532a1067" #edb/ref 17592186045417] [17592186130461 #edb/ref 1067 "A Review of Affine Transformations" #edb/ref 17592186045417] [17592186130462 #edb/ref 1064 "The Jacobian determinant gives information about nonlinear transformations similar to that described by the determinant properties of affine transformations.\n\nThe critical difference is that, in general, the Jacobian describes *local* effects, not global ones. \n\nTo understand what this means, suppose that $\\mathbf{T}: U \\to \\mathbb{R}^2$ is a transformation, where\n![](images/d0/d0149013f12e5cdad31611d4c64489c0aaf6049707e9eed22202ae70d2d8a38a.svg) \n\nand we assume that $x(u,v)$ and $y(u,v)$ have continuous first-order partial derivatives on $U.$\n\nFor ease of notation, let's introduce $J(u_0,v_0)$ to denote the Jacobian determinant of $\\mathbf T$ evaluated at $(u_0, v_0){:}$\n\n$$\nJ(u_0,v_0) = \\left.\\dfrac{\\partial(x,y)}{\\partial(u,v)}\\right|_{(u_0,v_0)}\n$$\n\nLet's describe $\\mathbf T$'s effect on a *tiny* rectangle in the $uv$-plane whose bottom-left corner is the point $(u_0,v_0).$\n\n![](images/dc/dc084ec02cd0c4fac71379590e8dc4973354cacc898e267a0eb15a6e8500f31f.png)\n\nIt's important to note that the image of our rectangle in the $xy$-plane is typically *not* a parallelogram! However, provided that our rectangle is very small, its image can be *approximated* by a parallelogram (we'll justify this in a future lesson). \n\nThe Jacobian determinant of $\\mathbf T$ evaluated at $(u_0,v_0)$ describes the following key features between our tiny rectangle and its (approximate) image:\n\n- The *local* area scale factor of $\\mathbf T$. \n\nSuppose the length and width of our rectangle are $\\delta u$ and $\\delta v,$ so its area is $\\delta A = \\delta u\\delta v.$ Then, it can be shown that the parallelogram in the $xy$-plane has an area equal to $\\left|J(u_0,v_0)\\right| \\cdot \\delta A.$\n\n![](images/be/be1771ebb041c418c58d7d5615510e2fcacfeaf3677fbace739498ef1998ef11.png)\n\nNote the similarity of this formula with that of affine transformations described earlier (we've simply replaced $\\det(T)$ with the Jacobian).\n\n- Whether the transformation is *locally* orientation-preserving or *locally* orientation-reversing.\n\nIf $J(u_0,v_0)> 0,$ the transformation is (locally) orientation-preserving.\n\n![](images/8c/8c649fdd526a831fb990393b292fb4582dad14c2391d129e9ed59792ebb8ac31.png)\n\nIf $J(u_0,v_0)<  0,$ the transformation is (locally) orientation-reversing.\n\n![](images/ae/ae5a3d0a42e1c4b9f692994b89815382a30cdf3e676bbd9844258ad2a6961608.png)\n\n- Whether the transformation is *locally* invertible or *locally* non-invertible.\n\nIf $J(u_0,v_0)\\neq 0,$ the transformation is (locally) invertible.\n\n![](images/33/33ca98206a347e13aa8ec179a52dd755008d9a7d74882391e0c3f2344f6f6641.png)\n\nIf $J(u_0,v_0)= 0,$ the transformation is (locally) non-invertible.\n\n![](images/3d/3d4534c263a9a5bb26ba35ce8f879cf01db741441d948c023acaa9407d58e6e0.png)\n\n![](images/65/659f26ac6aba808d66a760d5683f265fd7c54431d894b2eabdc255b46368fc24.png)\n\nPoints $(u_0,v_0)$ such that $J(u_0,v_0)=0$ are called **critical points.** Critical points are very important. We'll discuss these in more detail in future lessons.\n\nWe again stress that the Jacobian describes *local* properties, that is, local to the point $(u_0,v_0).$ The effect of a nonlinear transformation on an object varies as we move around the $uv$-plane, so its local properties also vary. So, for example, if a transformation is orientation-preserving at one point, it does *not* mean it's orientation-preserving everywhere!" #edb/ref 17592186045417] [17592186130462 #edb/ref 1065 7673 #edb/ref 17592186045417] [17592186130462 #edb/ref 1066 #uuid "3f6a2c63-d9fc-533c-8c4b-fd822216f0f1" #edb/ref 17592186045417] [17592186130462 #edb/ref 1067 "Intuition Behind the Jacobian" #edb/ref 17592186045417] [17592186275562 #edb/ref 1080 "4" #edb/ref 17592186045417] [17592186275562 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186275562 #edb/ref 1083 #uuid "09e0e11f-ca64-573d-aa4a-39c0085748ca" #edb/ref 17592186045417] [17592186275817 #edb/ref 1080 "6" #edb/ref 17592186045417] [17592186275817 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186275817 #edb/ref 1083 #uuid "2571ec42-1410-5512-abb4-5d9f33e67cf4" #edb/ref 17592186045417] [17592186275833 #edb/ref 1080 "-4" #edb/ref 17592186045417] [17592186275833 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186275833 #edb/ref 1083 #uuid "27184dd5-9306-5151-ba71-71c0184555b9" #edb/ref 17592186045417] [17592186275988 #edb/ref 1080 "16" #edb/ref 17592186045417] [17592186275988 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186275988 #edb/ref 1083 #uuid "3a030248-80e5-5392-828d-2bf5b0f34c56" #edb/ref 17592186045417] [17592186276099 #edb/ref 1080 "-8" #edb/ref 17592186045417] [17592186276099 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186276099 #edb/ref 1083 #uuid "46441063-cd17-57f8-93da-47999b8389f3" #edb/ref 17592186045417] [17592186276158 #edb/ref 1080 "14" #edb/ref 17592186045417] [17592186276158 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186276158 #edb/ref 1083 #uuid "4d076db5-f0b8-5a55-b9f9-a751427c3ef4" #edb/ref 17592186045417] [17592186276167 #edb/ref 1080 "4\\operatorname{sin}⁡(u-v)" #edb/ref 17592186045417] [17592186276167 #