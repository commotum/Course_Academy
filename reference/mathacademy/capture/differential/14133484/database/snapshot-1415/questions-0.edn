#{[{:db/id #edb/ref 17592186284499 :knowledge-point/_questions [{:db/id #edb/ref 17592186087840 :knowledge-point/id #uuid "de557d1d-5f27-50e3-bcba-22b21f83267f" :knowledge-point/title "Determining the Equation of a Tall Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0890c131-5eeb-5f67-aa90-086374575a9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{12}=1" :db/id #edb/ref 17592186281763} {:answer/id #uuid "18e0c24c-52d2-5c41-a933-2d13b3e8afa8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{36}=1" :db/id #edb/ref 17592186281913} {:answer/id #uuid "1ebf50dd-9fc4-55fb-91d9-28de2bacb253" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{3}+\\frac{{y}^{2}}{6}=1" :db/id #edb/ref 17592186281964} {:answer/id #uuid "6ba9ca97-13f2-5cf7-9f0e-df8b3d876788" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{3}=1" :db/id #edb/ref 17592186282614} {:answer/id #uuid "97883037-baea-5b8b-9a40-b05574105c17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{36}+\\frac{{y}^{2}}{9}=1" :db/id #edb/ref 17592186282999}] :answer-field/correct {:answer/id #uuid "18e0c24c-52d2-5c41-a933-2d13b3e8afa8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{36}=1" :db/id #edb/ref 17592186281913} :answer-field/id #uuid "63fe44b0-587e-52d7-9525-c7108d7f5367" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284099}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fdeb0ff5-45e6-5343-a0cd-f339e82d372b" :question/math-academy-id "q-16451" :question/problem "![](images/61/6116ecf00a26d9828b238879b61385c1296f33ff863dbb8337a3b22be5981f10.png)\n\nWhat is the equation of the ellipse given above?" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the horizontal radius has length $a=3$ and the vertical radius has length $b=6.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}} & =1 \\\\ \\frac{{x}^{2}}{{3}^{2}}+\\frac{{y}^{2}}{{6}^{2}} & =1 \\\\ \\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{36} & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186434278 :knowledge-point/_questions [{:db/id #edb/ref 17592186087840 :knowledge-point/id #uuid "de557d1d-5f27-50e3-bcba-22b21f83267f" :knowledge-point/title "Determining the Equation of a Tall Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "224b79cf-bf9d-546e-92e5-652da96853b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{3}=1" :db/id #edb/ref 17592186434264} {:answer/id #uuid "239820f5-492c-5074-bb16-a6af5ed54f89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{3}+\\frac{{y}^{2}}{2}=1" :db/id #edb/ref 17592186434265} {:answer/id #uuid "53b5a01d-de71-5112-abcb-3f57176855d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{4}=1" :db/id #edb/ref 17592186434267} {:answer/id #uuid "64c8fe0e-8e01-5ebd-869d-3e05d36b78cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{2}+\\frac{{y}^{2}}{3}=1" :db/id #edb/ref 17592186434269} {:answer/id #uuid "9428f7fa-4636-5ad9-ac5c-92e2a7fbe6ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{9}=1" :db/id #edb/ref 17592186434270}] :answer-field/correct {:answer/id #uuid "9428f7fa-4636-5ad9-ac5c-92e2a7fbe6ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{9}=1" :db/id #edb/ref 17592186434270} :answer-field/id #uuid "29540716-87b2-5957-a8c4-7141164fdefb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186434273}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5fbef9b7-68b9-5b6d-beff-b38a63574b1c" :question/math-academy-id "q-16458" :question/problem "![](images/2a/2adb84964a605495c84921943ec76f9820ba18851cda817037dd6022808d1fd7.png)\n\nWhat is the equation of the ellipse given above?" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the horizontal radius has length $a=2$ and the vertical radius has length $b=3.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}} & =1 \\\\ \\frac{{x}^{2}}{{2}^{2}}+\\frac{{y}^{2}}{{3}^{2}} & =1 \\\\ \\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{9} & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186434279 :knowledge-point/_questions [{:db/id #edb/ref 17592186087841 :knowledge-point/id #uuid "4e43e393-8752-58bc-b87c-b72f679cbfd9" :knowledge-point/title "Determining the Lengths of the Major and Minor Axes Given the Equation of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bb06d992-e82f-5977-a714-2f2fd87616b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186434271}] :answer-field/correct {:answer/id #uuid "bb06d992-e82f-5977-a714-2f2fd87616b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186434271} :answer-field/id #uuid "13f8d6b7-9861-51ad-96d2-5cd3b96789b2" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186434272} {:answer-field/choices [{:answer/id #uuid "56513915-f193-5d63-936d-07a8b133ceae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186434268}] :answer-field/correct {:answer/id #uuid "56513915-f193-5d63-936d-07a8b133ceae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186434268} :answer-field/id #uuid "878be2a7-5abd-5dc4-9fe0-30ce370e3435" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186434276}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cb8398f9-e97a-58eb-bd8b-b49ccd2d689d" :question/math-academy-id "q-279167" :question/problem "For the ellipse $\\frac{{x}^{2}}{49}+\\frac{{y}^{2}}{25}=1,$ find the lengths of its major and minor axes.\n\n$\\,$ The length of the major axis is \n{{field-1}}.\n\n$\\,$ The length of the minor axis is \n{{field-2}}." :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nIn the given equation, we have ${a}^{2}=49$ and ${b}^{2}=25.$\n\n- Since ${a}^{2}=49,$ the length of the horizontal radius must be $a=\\sqrt{49}=7.$\n\n- Since ${b}^{2}=25,$ the length of the vertical radius must be $b=\\sqrt{25}=5.$\n\nThus, the semi-major axis has length $a=7,$ and the semi-minor axis has length $b=5.$\n\nTherefore, the major axis has length $2a=2\\cdot 7=14,$ and the minor axis has length $2b=2\\cdot 5=10.$"}] [{:db/id #edb/ref 17592186434277 :knowledge-point/_questions [{:db/id #edb/ref 17592186087841 :knowledge-point/id #uuid "4e43e393-8752-58bc-b87c-b72f679cbfd9" :knowledge-point/title "Determining the Lengths of the Major and Minor Axes Given the Equation of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1dcd62ed-d1d5-5d66-b9a7-d3752b72ffcb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186434263}] :answer-field/correct {:answer/id #uuid "1dcd62ed-d1d5-5d66-b9a7-d3752b72ffcb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186434263} :answer-field/id #uuid "5f59ee40-6a49-5f76-9b09-b56f1e7b8c65" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186434274} {:answer-field/choices [{:answer/id #uuid "2cb3f03d-cfef-5f9f-b396-26b221d4f856" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{13}" :db/id #edb/ref 17592186434266}] :answer-field/correct {:answer/id #uuid "2cb3f03d-cfef-5f9f-b396-26b221d4f856" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{13}" :db/id #edb/ref 17592186434266} :answer-field/id #uuid "62dc0b83-a470-59d2-b62b-b5ccbaa907c1" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186434275}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3c46acbe-8af8-5805-a582-9ade9300c9a5" :question/math-academy-id "q-279199" :question/problem "For the ellipse $\\frac{{x}^{2}}{13}+\\frac{{y}^{2}}{36}=1,$ find the lengths of its major and minor axes.\n\n$\\,$ The length of the major axis is \n{{field-1}}.\n\n$\\,$ The length of the minor axis is \n{{field-2}}." :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nIn the given equation, we have ${a}^{2}=13$ and ${b}^{2}=36.$\n\n- Since ${a}^{2}=13,$ the length of the horizontal radius must be $a=\\sqrt{13}.$\n\n- Since ${b}^{2}=36,$ the length of the vertical radius must be $b=\\sqrt{36}=6.$\n\nThus, the semi-major axis has length $b=6,$ and the semi-minor axis has length $a=\\sqrt{13}.$\n\nTherefore, the major axis has length $2b=2\\cdot 6=12,$ and the minor axis has length $2a=2\\cdot \\sqrt{13}=2\\sqrt{13}.$"}] [{:db/id #edb/ref 17592186342039 :knowledge-point/_questions [{:db/id #edb/ref 17592186087840 :knowledge-point/id #uuid "de557d1d-5f27-50e3-bcba-22b21f83267f" :knowledge-point/title "Determining the Equation of a Tall Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "264c8e91-4c93-5aee-ba55-bd907c4a3b8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{36}+\\frac{{y}^{2}}{16}=1" :db/id #edb/ref 17592186339459} {:answer/id #uuid "320f7703-8c4f-5dc9-8624-856e513ecd8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{16}=1" :db/id #edb/ref 17592186339568} {:answer/id #uuid "60bbf1c4-341f-50ef-8931-5d66a4141ef9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{16}+\\frac{{y}^{2}}{16}=1" :db/id #edb/ref 17592186339990} {:answer/id #uuid "ba485f5d-a19d-569b-ac5d-342a12dfefea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{16}+\\frac{{y}^{2}}{36}=1" :db/id #edb/ref 17592186340797} {:answer/id #uuid "e1dcb36b-eef4-548f-8678-715a402e7c8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{12}+\\frac{{y}^{2}}{32}=1" :db/id #edb/ref 17592186341129}] :answer-field/correct {:answer/id #uuid "ba485f5d-a19d-569b-ac5d-342a12dfefea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{16}+\\frac{{y}^{2}}{36}=1" :db/id #edb/ref 17592186340797} :answer-field/id #uuid "d755d6a9-5867-59b0-abe9-3aa060579222" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341759}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "72c0e5d1-5884-5875-91c7-7d9b69f20798" :question/math-academy-id "q-73627" :question/problem "![](images/37/377a871e9328e0a8b3c12d8904ecc16a2e6e3a17fa7dba05925bb6f2e5d7e4ad.png)\n\nWhat is the equation of the ellipse given above?" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the horizontal radius has length $a=4$ and the vertical radius has length $b=6.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}} & =1 \\\\ \\frac{{x}^{2}}{{4}^{2}}+\\frac{{y}^{2}}{{6}^{2}} & =1 \\\\ \\frac{{x}^{2}}{16}+\\frac{{y}^{2}}{36} & =1.\\end{aligned}\n$$"}]}
