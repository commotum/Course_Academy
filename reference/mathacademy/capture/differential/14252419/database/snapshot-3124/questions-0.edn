\\frac{1}{{a}_{nn}}\\end{bmatrix}\n$$\n\nIn our case, we obtain\n\n$$\n{A}^{-1}={\\begin{bmatrix}\\frac{\\sqrt{2}}{2} & 0 & 0 & 0 \\\\ 0 & 1 & 0 & 0 \\\\ 0 & 0 & -2 & 0 \\\\ 0 & 0 & 0 & \\frac{1}{2}\\end{bmatrix}}^{-1}=\\begin{bmatrix}\\sqrt{2} & 0 & 0 & 0 \\\\ 0 & 1 & 0 & 0 \\\\ 0 & 0 & -\\frac{1}{2} & 0 \\\\ 0 & 0 & 0 & 2\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186388328 :knowledge-point/_questions [{:db/id #edb/ref 17592186054696 :knowledge-point/id #uuid "6eea26e0-2a9c-5d4c-91d3-12e7682e1858" :knowledge-point/title "Inverting a Diagonal Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ae64e00f-248f-5416-a7d7-f63abd460d89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\sqrt{5} & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & 6\\end{bmatrix}" :db/id #edb/ref 17592186388330} {:answer/id #uuid "0ca42262-1856-5fae-96d8-21a6b1bbb5ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{\\sqrt{5}}{5} & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & -6\\end{bmatrix}" :db/id #edb/ref 17592186388331} {:answer/id #uuid "7891ed69-db39-56d8-9b5d-8c5c52ec5455" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{\\sqrt{5}}{5} & 0 & 0 \\\\ 0 & -\\frac{1}{2} & 0 \\\\ 0 & 0 & 6\\end{bmatrix}" :db/id #edb/ref 17592186388332} {:answer/id #uuid "af60b232-b43d-5148-acd4-6766dd50925f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\sqrt{5} & 0 & 0 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & -\\frac{1}{6}\\end{bmatrix}" :db/id #edb/ref 17592186388333} {:answer/id #uuid "f5d5d26b-c0d3-5eb3-9f7e-65cf2e302193" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\sqrt{5} & 0 & 0 \\\\ 0 & -\\frac{1}{2} & 0 \\\\ 0 & 0 & \\frac{1}{6}\\end{bmatrix}" :db/id #edb/ref 17592186388334}] :answer-field/correct {:answer