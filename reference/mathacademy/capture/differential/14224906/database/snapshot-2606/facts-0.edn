b/ref 17592186541615 #edb/ref 17592186045417] [17592186542099 #edb/ref 1075 #edb/ref 17592186541669 #edb/ref 17592186045417] [17592186542099 #edb/ref 1075 #edb/ref 17592186541703 #edb/ref 17592186045417] [17592186542099 #edb/ref 1075 #edb/ref 17592186541812 #edb/ref 17592186045417] [17592186542099 #edb/ref 1075 #edb/ref 17592186541847 #edb/ref 17592186045417] [17592186542099 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186542099 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186542099 #edb/ref 1078 #edb/ref 17592186541615 #edb/ref 17592186045417] [17592186542099 #edb/ref 1079 #uuid "f75f0550-f223-5620-afe3-60a4b1e7b6bb" #edb/ref 17592186045417] [17592186542116 #edb/ref 1068 #edb/ref 17592186542024 #edb/ref 17592186045417] [17592186542116 #edb/ref 1069 "q-26830" #edb/ref 17592186045417] [17592186542116 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186542116 #edb/ref 1071 "Given that $\\frac{{3}^{x}}{5}=3\\cdot {4}^{x},$ what is the value of $x?$ Round your answer to $3$ decimal places." #edb/ref 17592186045417] [17592186542116 #edb/ref 1072 #uuid "1016352e-7a56-5245-a46f-5f32ded11ee4" #edb/ref 17592186045417] [17592186542116 #edb/ref 1074 "First, notice that, by multiplying by $5$ on both sides,  the given equation is equivalent to\n\n$$\n{3}^{x}=15\\cdot {4}^{x}\n$$\n\nNow, we take ${log}_{3}$ on both sides of the equation: \n\n$$\n{log}_{3}⁡({3}^{x})={log}_{3}⁡(15\\cdot {4}^{x})\n$$\n\nThen, we use the fact that ${log}_{b}⁡({b}^{c})=c$ to simplify the left-hand side:\n\n$$\n\\begin{aligned}x & ={log}_{3}⁡(15\\cdot {4}^{x})\\end{aligned}\n$$\n\nNext, we use  the product law and the power law of logarithms to simplify the right-hand side:\n\n$$\n\\begin{aligned}x & ={log}_{3}⁡(15\\cdot {4}^{x}) \\\\  & ={log}_{3}⁡(15)+{log}_{3}⁡({4}^{x}) \\\\  & ={log}_{3}⁡(15)+x{log}_{3}⁡4\\end{aligned}\n$$\n\nFinally, we solve for $x,$ as follows:\n\n$$\n\\begin{aligned}x & ={log}_{3}⁡(15)+x{log}_{3}⁡4 \\\\ x-x{log}_{3}⁡4 & ={log}_{3}⁡(15) \\\\ x(1-{log}_{3}⁡4) & ={log}_{3}⁡(15) \\\\ x & =\\frac{{log}_{3}⁡(15)}{1-{log}_{3}⁡4}\\end{aligned}\n$$\n\nUsing the change of base formula, we have\n\n$$\n\\begin{aligned}{log}_{3}⁡(15)=\\frac{\\operatorname{ln}⁡15}{\\operatorname{ln}⁡3}≈2.464\\,974, \\\\ {log}_{3}⁡4=\\frac{\\operatorname{ln}⁡4}{\\operatorname{ln}⁡3}≈1.261\\,860.\\end{aligned}\n$$\n\nFinally, we can approximate $x$ as\n\n$$\nx≈\\frac{2.464\\,974}{1-1.261\\,860}≈-9.413,\n$$\n\nrounded to $3$ decimal places." #edb/ref 17592186045417] [17592186542119 #edb/ref 1068 #edb/ref 17592186541973 #edb/ref 17592186045417] [17592186542119 #edb/ref 1069 "q-242915" #edb/ref 17592186045417] [17592186542119 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186542119 #edb/ref 1071 "Expressed in terms of natural logarithms, determine the value of $x$ that satisfies the equation ${2}^{6x+1}={6}^{x+7}.$\n\n$x=$\n{{field-1}}" #edb/ref 17592186045417] [17592186542119 #edb/ref 1072 #uuid "144d3b46-ddcf-55fb-8478-125713df09d1" #edb/ref 17592186045417] [17592186542119 #edb/ref 1074 "First, we take the natural logarithm $(ln)$ of both sides of the equation:\n\n$$\n\\begin{aligned}{2}^{6x+1} & ={6}^{x+7} \\\\ \\operatorname{ln}⁡({2}^{6x+1}) & =\\operatorname{ln}⁡({6}^{x+7})\\end{aligned}\n$$\n\nNow, we use the power law of logarithms to simplify both sides of the equation. This gives\n\n$$\n(6x+1)\\operatorname{ln}⁡(2)=(x+7)\\operatorname{ln}⁡(6).\n$$\n\nFinally, we solve for $x$, as follows:\n\n$$\n\\begin{aligned}(6x+1)\\operatorname{ln}⁡(2) & =(x+7)\\operatorname{ln}⁡(6) \\\\ 6x\\operatorname{ln}⁡(2)+\\operatorname{ln}⁡(2) & =x\\operatorname{ln}⁡(6)+7\\operatorname{ln}⁡(6) \\\\ 6x\\operatorname{ln}⁡(2)-x\\operatorname{ln}⁡(6) & =7\\operatorname{ln}⁡(6)-\\operatorname{ln}⁡(2) \\\\ x(6\\operatorname{ln}⁡(2)-\\operatorname{ln}⁡(6)) & =7\\operatorname{ln}⁡(6)-\\operatorname{ln}⁡(2) \\\\ x & =\\frac{7\\operatorname{ln}⁡(6)-\\operatorname{ln}⁡(2)}{6\\operatorname{ln}⁡(2)-\\operatorname{ln}⁡(6)}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186542149 #edb/ref 1068 #edb/ref 17592186542074 #edb/ref 17592186045417] [17592186542149 #edb/ref 1069 "q-66873" #edb/ref 17592186045417] [17592186542149 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186542149 #edb/ref 1071 "Expressed in terms of common logarithms, what value of $x$ satisfies the equation ${10}^{x-2}={3}^{x}?$" #edb/ref 17592186045417] [17592186542149 #edb/ref 1072 #uuid "5c4b6334-f991-59a6-8939-03bf51753adb" #edb/ref 17592186045417] [17592186542149 #edb/ref 1074 "First, we take the common logarithm $(log)$ of both sides of the equation: \n\n$$\n\\begin{aligned}{10}^{x-2} & ={3}^{x} \\\\ \\operatorname{log}⁡({10}^{x-2}) & =\\operatorname{log}⁡({3}^{x})\\end{aligned}\n$$\n\nNow, we use the fact that ${log}_{b}⁡({b}^{c})=c$ to simplify the left-hand side. This gives:\n\n$$\nx-2=\\operatorname{log}⁡({3}^{x})\n$$\n\nNext, we use the power law of logarithms to simplify the right-hand side:\n\n$$\nx-2=x\\operatorname{log}⁡(3)\n$$\n\nFinally, we solve for $x,$ as follows:\n\n$$\n\\begin{aligned}x-2 & =x\\operatorname{log}⁡(3) \\\\ x-x\\operatorname{log}⁡(3) & =2 \\\\ x(1-\\operatorname{log}⁡(3)) & =2 \\\\ x & =\\frac{2}{1-\\operatorname{log}⁡(3)}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186542150 #edb/ref 1068 #edb/ref 17592186542077 #edb/ref 17592186045417] [17592186542150 #edb/ref 1069 "q-79363" #edb/ref 17592186045417] [17592186542150 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186542150 #edb/ref 1071 "Expressed in terms of natural logarithms, what value of $x$ satisfies the equation ${e}^{x+2}=5\\cdot {6}^{x}?$" #edb/ref 17592186045417] [17592186542150 #edb/ref 1072 #uuid "5e9937d3-e10e-5251-81d5-87fad6e6c69a" #edb/ref 17592186045417] [17592186542150 #edb/ref 1074 "First, we take the natural logarithm $(ln)$ of both sides of the equation:\n\n$$\n\\begin{aligned}{e}^{x+2} & =5\\cdot {6}^{x} \\\\ \\operatorname{ln}⁡({e}^{x+2}) & =\\operatorname{ln}⁡(5\\cdot {6}^{x})\\end{aligned}\n$$\n\nNow, we use the fact that $\\operatorname{ln}⁡({e}^{a})=a$ to simplify the left-hand side. This gives:\n\n$$\nx+2=\\operatorname{ln}⁡(5\\cdot {6}^{x})\\,\n$$\n\nNext, we use the power and product laws of logarithms to simplify the right-hand side:\n\n$$\n\\begin{aligned}x+2 & =\\operatorname{ln}⁡(5)+\\operatorname{ln}⁡({6}^{x}) \\\\ x+2 & =\\operatorname{ln}⁡(5)+x\\operatorname{ln}⁡(6)\\end{aligned}\n$$\n\nFinally, we solve for $x$, as follows:\n\n$$\n\\begin{aligned}x+2 & =\\operatorname{ln}⁡(5)+x\\operatorname{ln}⁡(6) \\\\ x-x\\operatorname{ln}⁡(6) & =\\operatorname{ln}⁡(5)-2 \\\\ x(1-\\operatorname{ln}⁡(6)) & =\\operatorname{ln}⁡(5)-2 \\\\ x & =\\frac{\\operatorname{ln}⁡(5)-2}{1-\\operatorname{ln}⁡(6)}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186542160 #edb/ref 1068 #edb/ref 17592186541981 #edb/ref 17592186045417] [17592186542160 #edb/ref 1069 "q-242900" #edb/ref 17592186045417] [17592186542160 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186542160 #edb/ref 1071 "Given that ${5}^{x+4}={2}^{2-x},$ what is the value of $x?$ Round your answer to $3$ decimal places.\n\n$x≈$\n{{field-1}}" #edb/ref 17592186045417] [17592186542160 #edb/ref 1072 #uuid "7088fa93-cf81-5263-ba93-771873a7af12" #edb/ref 17592186045417] [17592186542160 #edb/ref 1074 "First, we take ${log}_{5}$ on both sides of the equation: \n\n$$\n\\begin{aligned}{5}^{x+4} & ={2}^{2-x} \\\\ {log}_{5}⁡({5}^{x+4}) & ={log}_{5}⁡({2}^{2-x})\\end{aligned}\n$$\n\nNow, we use the fact that ${log}_{b}⁡({b}^{c})=c$ to simplify the left-hand side:\n\n$$\nx+4={log}_{5}⁡({2}^{2-x})\n$$\n\nNext, we use the power law of logarithms to simplify the right-hand side:\n\n$$\nx+4=(2-x){log}_{5}⁡(2)\n$$\n\nFinally, we solve for $x,$ as follows:\n\n$$\n\\begin{aligned}x+4 & =(2-x){log}_{5}⁡(2) \\\\ x+4 & =2{log}_{5}⁡(2)-x{log}_{5}⁡(2) \\\\ x+x{log}_{5}⁡(2) & =2{log}_{5}⁡(2)-4 \\\\ x(1+{log}_{5}⁡(2)) & =2{log}_{5}⁡(2)-4 \\\\ x & =\\frac{2{log}_{5}⁡(2)-4}{1+{log}_{5}⁡(2)}\\end{aligned}\n$$\n\nUsing the change of base formula, we have\n\n$$\n{log}_{5}⁡(2)=\\frac{\\operatorname{ln}⁡(2)}{\\operatorname{ln}⁡(5)}≈0.430\\,677.\n$$\n\nFinally, we can approximate $x$ as\n\n$$\nx≈\\frac{2\\cdot 0.430\\,677-4}{1+0.430\\,677}≈-2.194,\n$$\n\nrounded to $3$ decimal places." #edb/ref 17592186045417]}
