/ref 17592186110698 #edb/ref 17592186045417] [17592186050375 #edb/ref 1028 #edb/ref 17592186110699 #edb/ref 17592186045417] [17592186050375 #edb/ref 1031 "The Product Rule for Logarithms" #edb/ref 17592186045417] [17592186050375 #edb/ref 1033 1473 #edb/ref 17592186045417] [17592186050375 #edb/ref 1035 #uuid "442f2129-23ce-53eb-9f85-7f9a3ae22164" #edb/ref 17592186045417] [17592186050649 #edb/ref 1027 #edb/ref 17592186048385 #edb/ref 17592186045417] [17592186050649 #edb/ref 1027 #edb/ref 17592186048441 #edb/ref 17592186045417] [17592186050649 #edb/ref 1027 #edb/ref 17592186048787 #edb/ref 17592186045417] [17592186050649 #edb/ref 1027 #edb/ref 17592186049095 #edb/ref 17592186045417] [17592186050649 #edb/ref 1027 #edb/ref 17592186049527 #edb/ref 17592186045417] [17592186050649 #edb/ref 1027 #edb/ref 17592186050209 #edb/ref 17592186045417] [17592186050649 #edb/ref 1027 #edb/ref 17592186050797 #edb/ref 17592186045417] [17592186050649 #edb/ref 1027 #edb/ref 17592186051065 #edb/ref 17592186045417] [17592186050649 #edb/ref 1028 #edb/ref 17592186087689 #edb/ref 17592186045417] [17592186050649 #edb/ref 1028 #edb/ref 17592186087690 #edb/ref 17592186045417] [17592186050649 #edb/ref 1028 #edb/ref 17592186087691 #edb/ref 17592186045417] [17592186050649 #edb/ref 1029 #edb/ref 17592186429668 #edb/ref 17592186045436] [17592186050649 #edb/ref 1029 #edb/ref 17592186429669 #edb/ref 17592186045436] [17592186050649 #edb/ref 1029 #edb/ref 17592186429670 #edb/ref 17592186045436] [17592186050649 #edb/ref 1031 "Solving Equations Containing the Exponential Function" #edb/ref 17592186045417] [17592186050649 #edb/ref 1033 870 #edb/ref 17592186045417] [17592186050649 #edb/ref 1035 #uuid "5c4bc59d-ac0f-5225-a803-5b20b7524274" #edb/ref 17592186045417] [17592186051079 #edb/ref 1027 #edb/ref 17592186048530 #edb/ref 17592186045417] [17592186051079 #edb/ref 1027 #edb/ref 17592186048898 #edb/ref 17592186045417] [17592186051079 #edb/ref 1027 #edb/ref 17592186049181 #edb/ref 17592186045417] [17592186051079 #edb/ref 1027 #edb/ref 17592186049266 #edb/ref 17592186045417] [17592186051079 #edb/ref 1027 #edb/ref 17592186049527 #edb/ref 17592186045417] [17592186051079 #edb/ref 1027 #edb/ref 17592186049902 #edb/ref 17592186045417] [17592186051079 #edb/ref 1027 #edb/ref 17592186050788 #edb/ref 17592186045417] [17592186051079 #edb/ref 1027 #edb/ref 17592186050884 #edb/ref 17592186045417] [17592186051079 #edb/ref 1027 #edb/ref 17592186051017 #edb/ref 17592186045417] [17592186051079 #edb/ref 1028 #edb/ref 17592186054828 #edb/ref 17592186045417] [17592186051079 #edb/ref 1028 #edb/ref 17592186054829 #edb/ref 17592186045417] [17592186051079 #edb/ref 1028 #edb/ref 17592186054830 #edb/ref 17592186045417] [17592186051079 #edb/ref 1031 "Factoring Linear Expressions" #edb/ref 17592186045417] [17592186051079 #edb/ref 1033 87 #edb/ref 17592186045417] [17592186051079 #edb/ref 1035 #uuid "7f29909c-8f45-5a17-820a-13a0a327cd5f" #edb/ref 17592186045417] [17592186178420 #edb/ref 1075 #edb/ref 17592186541637 #edb/ref 17592186045417] [17592186178420 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186178420 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186178420 #edb/ref 1078 #edb/ref 17592186541637 #edb/ref 17592186045417] [17592186178420 #edb/ref 1079 #uuid "30df98ac-26e2-575f-9740-2cdd94af54be" #edb/ref 17592186045417] [17592186179490 #edb/ref 1069 "e-18776" #edb/ref 17592186045417] [17592186179490 #edb/ref 1071 "Expressed in terms of natural logarithms, determine the value of $x$ that satisfies the equation $5^{x+2}=9^{x-2}.$" #edb/ref 17592186045417] [17592186179490 #edb/ref 1072 #uuid "ccfb8833-f270-5855-8c49-fb3b6b6662d5" #edb/ref 17592186045417] [17592186179490 #edb/ref 1074 "First, we take the natural logarithm $\\left(\\ln\\right)$ of both sides of the equation:\n\n$$\n\\begin{aligned}{5}^{x+2} & ={9}^{x-2} \\\\ \\operatorname{ln}⁡({5}^{x+2}) & =\\operatorname{ln}⁡({9}^{x-2})\\end{aligned}\n$$\n\nNow, we use the power law of logarithms to simplify both sides of the equation. This gives\n\n$$\n(x+2)\\ln(5) = (x-2)\\ln(9).\n$$\n\nFinally, we solve for $x$, as follows:\n\n$$\n\\begin{aligned}(x+2)\\operatorname{ln}⁡(5) & =(x-2)\\operatorname{ln}⁡(9) \\\\ x\\operatorname{ln}⁡(5)+2\\operatorname{ln}⁡(5) & =x\\operatorname{ln}⁡(9)-2\\operatorname{ln}⁡(9) \\\\ x\\operatorname{ln}⁡(5)-x\\operatorname{ln}⁡(9) & =-2\\operatorname{ln}⁡(9)-2\\operatorname{ln}⁡(5) \\\\ x\\operatorname{ln}⁡(9)-x\\operatorname{ln}⁡(5) & =2\\operatorname{ln}⁡(9)+2\\operatorname{ln}⁡(5) \\\\ x(\\operatorname{ln}⁡(9)-\\operatorname{ln}⁡(5)) & =2(\\operatorname{ln}⁡(5)+\\operatorname{ln}⁡(9)) \\\\ x & =\\frac{2(\\operatorname{ln}⁡(5)+\\operatorname{ln}⁡(9))}{\\operatorname{ln}⁡(9)-\\operatorname{ln}⁡(5)}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186179505 #edb/ref 1069 "e-4097" #edb/ref 17592186045417] [17592186179505 #edb/ref 1071 "Expressed in terms of $\\log_2,$ what value of $x$ satisfies the equation $2^{x+1}=3^x?$" #edb/ref 17592186045417] [17592186179505 #edb/ref 1072 #uuid "453d4ec3-98f5-5db1-a046-a6b15c13049d" #edb/ref 17592186045417] [17592186179505 #edb/ref 1074 "First, we take $\\log_2$ on both sides of the equation: \n\n$$\n\\begin{aligned}{2}^{x+1} & ={3}^{x} \\\\ {log}_{2}⁡({2}^{x+1}) & ={log}_{2}⁡({3}^{x})\\end{aligned}\n$$\n\nNow, we use the fact that $\\log_b \\left( b^c \\right) = c$ to simplify the left-hand side. This gives:\n\n$$\nx+1 = \\log_2 \\left(3^{x}\\right)\n$$\n\nNext, we use the power law of logarithms to simplify the right-hand side:\n\n$$\nx+1 = x \\log_2 \\left(3\\right)\n$$\n\nFinally, we solve for $x,$ as follows: \n\n$$\n\\begin{aligned}x+1 & =x{log}_{2}⁡(3) \\\\ x{log}_{2}⁡(3)-x & =1 \\\\ x({log}_{2}⁡(3)-1) & =1 \\\\ x & =\\frac{1}{{log}_{2}⁡(3)-1}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186179506 #edb/ref 1069 "e-4098" #edb/ref 17592186045417] [17592186179506 #edb/ref 1071 "Expressed in terms of natural logarithms, what value of $x$ satisfies the equation $e^{x+1}=2^x\\cdot 5?$" #edb/ref 17592186045417] [17592186179506 #edb/ref 1072 #uuid "fbb90aa1-5adf-5c6d-8499-68eea953cc42" #edb/ref 17592186045417] [17592186179506 #edb/ref 1074 "First, we take the natural logarithm $\\left(\\ln\\right)$ of both sides of the equation:\n\n$$\n\\begin{aligned}{e}^{x+1} & ={2}^{x}\\cdot 5 \\\\ \\operatorname{ln}⁡({e}^{x+1}) & =\\operatorname{ln}⁡({2}^{x}\\cdot 5)\\end{aligned}\n$$\n\nNow, we use the fact that $\\ln \\left( e^a \\right) = a$ to simplify the left-hand side. This gives:\n\n$$\nx+1 =\\ln \\left(2^{x}\\cdot 5\\right)\n$$\n\nNext, we use the power and product laws of logarithms to simplify the right-hand side:\n\n$$\n\\begin{aligned}x+1 & =\\operatorname{ln}⁡({2}^{x})+\\operatorname{ln}⁡(5) \\\\ x+1 & =x\\operatorname{ln}⁡(2)+\\operatorname{ln}⁡(5)\\end{aligned}\n$$\n\nFinally, we solve for $x,$ as follows:\n\n$$\n\\begin{aligned}x+1 & =x\\operatorname{ln}⁡(2)+\\operatorname{ln}⁡(5) \\\\ x-x\\operatorname{ln}⁡(2) & =\\operatorname{ln}⁡(5)-1 \\\\ x(1-\\operatorname{ln}⁡(2)) & =\\operatorname{ln}⁡(5)-1 \\\\ x & =\\frac{\\operatorname{ln}⁡(5)-1}{1-\\operatorname{ln}⁡(2)}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186179787 #edb/ref 1037 #edb/ref 17592186049053 #edb/ref 17592186045417] [17592186179787 #edb/ref 1037 #edb/ref 17592186049527 #edb/ref 17592186045417] [17592186179787 #edb/ref 1037 #edb/ref 17592186049879 #edb/ref 17592186045417] [17592186179787 #edb/ref 1037 #edb/ref 17592186051079 #edb/ref 17592186045417] [17592186179787 #edb/ref 1038 #edb/ref 17592186180140 #edb/ref 17592186045417] [17592186179787 #edb/ref 1038 #edb/ref 17592186180156 #edb/ref 17592186045417] [17592186179787 #edb/ref 1038 #edb/ref 17592186233697 #edb/ref 17592186045417] [17592186179787 #edb/ref 1038 #edb/ref 17592186290532 #edb/ref 17592186045417] [17592186179787 #edb/ref 1038 #edb/ref 17592186290544 #edb/ref 17592186045417] [17592186179787 #edb/ref 1038 #edb/ref 17592186292646 #edb/ref 17592186045417] [17592186179787 #edb/ref 1038 #edb/ref 17592186292682 #edb/ref 17592186045417] 