92186265307}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b6b1e4d2-2558-5a17-9d34-9f5f93546f16" :question/math-academy-id "q-130907" :question/problem "Find the cofactor of ${p}_{35}$ in \n$P=\\begin{bmatrix}3 & -8 & 2 & 1 & 0 \\\\ 3 & 5 & \\sqrt{13} & 0 & 1 \\\\ -25 & -1 & -5 & 6 & -4 \\\\ 4 & 8 & 3 & 8 & 3 \\\\ 11 & 3 & \\sqrt{2} & -9 & 7\\end{bmatrix}.$" :question/worked-solution "First, to get the minor of ${p}_{35}$, we remove the $3$rd row and $5$th column: \n\n$$\nP=\\begin{bmatrix}3 & -8 & 2 & 1 & ∗ \\\\ 3 & 5 & \\sqrt{13} & 0 & ∗ \\\\ ∗ & ∗ & ∗ & ∗ & -4 \\\\ 4 & 8 & 3 & 8 & ∗ \\\\ 11 & 3 & \\sqrt{2} & -9 & ∗\\end{bmatrix}\n$$\n\nSo, the minor is \n\n$$\n{M}_{35}=\\begin{vmatrix}3 & -8 & 2 & 1 \\\\ 3 & 5 & \\sqrt{13} & 0 \\\\ 4 & 8 & 3 & 8 \\\\ 11 & 3 & \\sqrt{2} & -9\\end{vmatrix}.\n$$\n\nNow, the cofactor of ${p}_{35}$ is\n\n$$\n\\begin{aligned}{C}_{35} & =(-1)^{3+5}{M}_{35} \\\\  & ={M}_{35} \\\\  & =\\begin{vmatrix}3 & -8 & 2 & 1 \\\\ 3 & 5 & \\sqrt{13} & 0 \\\\ 4 & 8 & 3 & 8 \\\\ 11 & 3 & \\sqrt{2} & -9\\end{vmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186571404 :knowledge-point/_questions [{:db/id #edb/ref 17592186119783 :knowledge-point/id #uuid "055b3809-f9aa-5dcc-8c1a-b0eb71020d7e" :knowledge-point/title "Calculating the Determinant of a NxN Matrix Using Cofactor Expansion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b6bd69d-eb28-52f2-9e31-c5b78c1f5326" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-56" :db/id #edb/ref 17592186570980} {:answer/id #uuid "7df978ee-1cba-5e6d-a0df-7a5d2c0faa72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-40" :db/id #edb/ref 17592186571088} {:answer/id #uuid "b58b8460-eabb-5831-9222-ae5190c87747" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186571171} {:answer/id #uuid "e4b666c4-2e1e-5e88-95b7-208ffe3d3b53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186571247} {:answer/id #uuid "fd9e80fa-761b-575b-8358-1633af610880" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "100" :db/id #edb/ref 17592186571278}] :answer-field/correct {:answer/id #uuid "7df978ee-1cba-5e6d-a0df-7a5d2c0faa72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-40" :db/id #edb/ref 17592186571088} :answer-field/id #uuid "2984758c-d2d0-5408-9558-da3f2d0bbdb7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186571300}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5f805a2f-454d-5b6b-b94e-f4a78a778d84" :question/math-academy-id "q-131099" :question/problem "Calculate the determinant of the matrix\n$T=\\begin{bmatrix}0 & 0 & 0 & -10 \\\\ 0 & 4 & 0 & -5 \\\\ 1 & 3 & 2 & 0 \\\\ 1 & 2 & 3 & -25\\end{bmatrix}$" :question/worked-solution "We use the cofactor expansion along the first row:\n\n$$\n\\begin{aligned}det(T) & ={t}_{11}{C}_{11}+{t}_{12}{C}_{12}+{t}_{13}{C}_{13}+{t}_{14}{C}_{14} \\\\  & =0\\cdot {C}_{11}+0\\cdot {C}_{12}+0\\cdot {C}_{13}-10\\cdot {C}_{14} \\\\  & =-10{C}_{14} \\\\  & =-10\\cdot \\begin{vmatrix}∗ & ∗ & ∗ & -10 \\\\ 0 & 4 & 0 & ∗ \\\\ 1 & 3 & 2 & ∗ \\\\ 1 & 2 & 3 & ∗\\end{vmatrix} \\\\  & =-10(-1)^{1+4}\\begin{vmatrix}0 & 4 & 0 \\\\ 1 & 3 & 2 \\\\ 1 & 2 & 3\\end{vmatrix} \\\\  & =10(0\\cdot \\begin{vmatrix}3 & 2 \\\\ 2 & 3\\end{vmatrix}-4\\cdot \\begin{vmatrix}1 & 2 \\\\ 1 & 3\\end{vmatrix}+0\\cdot \\begin{vmatrix}1 & 3 \\\\ 1 & 2\\end{vmatrix}) \\\\  & =10(0-4(1\\cdot 3-1\\cdot 2)+0) \\\\  & =10\\cdot (-4) \\\\  & =-40\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186266048 :knowledge-point/_questions [{:db/id #edb/ref 17592186119783 :knowledge-point/id #uuid "055b3809-f9aa-5dcc-8c1a-b0eb71020d7e" :knowledge-point/title "Calculating the Determinant of a NxN Matrix Using Cofactor Expansion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10ad7fbd-daaf-5638-b84c-e71398abac22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186263153} {:answer/id #uuid "1bafca79-f3d5-5d3c-94b1-acb828f5d148" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "99" :db/id #edb/ref 17592186263260} {:answer/id #uuid "4cf09706-5715-5579-bf1d-d65287fd8c53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "45" :db/id #edb/ref 17592186263666} {:answer/id #uuid "d4648e08-8d5c-5a1c-9f99-ddecfd09c9a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "61" :db/id #edb/ref 17592186264849} {:answer/id #uuid "f09fabd2-0746-5418-a46d-e35f208be02e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186265110}] :answer-field/correct {:answer/id #uuid "1bafca79-f3d5-5d3c-94b1-acb828f5d148" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "99" :db/id #edb/ref 17592186263260} :answer-field/id #uuid "79a1e1f3-7831-5686-8eed-cf31e6adf808" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265451}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "868d3e09-dc03-51a5-9f3e-bb57d096be39" :question/math-academy-id "q-131122" :question/problem "Calculate the determinant of the matrix\n$W=\\begin{bmatrix}0 & -1 & 0 & 2 \\\\ 0 & 5 & 0 & 1 \\\\ 3 & 2 & 1 & 0 \\\\ 0 & 4 & 3 & 6\\end{bmatrix}.$" :question/worked-solution "We use the cofactor expansion along the first row:\n\n$$\n\\begin{aligned}det(W) & ={w}_{11}{C}_{11}+{w}_{12}{C}_{12}+{w}_{13}{C}_{13}+{w}_{14}{C}_{14} \\\\  & =0\\cdot {C}_{11}+(-1)\\cdot {C}_{12}+0\\cdot {C}_{13}+2\\cdot {C}_{14} \\\\  & =-{C}_{12}+2{C}_{14} \\\\  & =-1\\cdot |\\begin{aligned}∗ & -1 & ∗ & ∗ \\\\ 0 & ∗ & 0 & 1 \\\\ 3 & ∗ & 1 & 0 \\\\ 0 & ∗ & 3 & 6\\end{aligned}|+2\\cdot |\\begin{aligned}∗ & ∗ & ∗ & 2 \\\\ 0 & 5 & 0 & ∗ \\\\ 3 & 2 & 1 & ∗ \\\\ 0 & 4 & 3 & ∗\\end{aligned}| \\\\  & =-1\\cdot (-1)^{1+2}|\\begin{aligned}0 & 0 & 1 \\\\ 3 & 1 & 0 \\\\ 0 & 3 & 6\\end{aligned}|+2\\cdot (-1)^{4+1}|\\begin{aligned}0 & 5 & 0 \\\\ 3 & 2 & 1 \\\\ 0 & 4 & 3\\end{aligned}| \\\\  & =|\\begin{aligned}0 & 0 & 1 \\\\ 3 & 1 & 0 \\\\ 0 & 3 & 6\\end{aligned}|-2|\\begin{aligned}0 & 5 & 0 \\\\ 3 & 2 & 1 \\\\ 0 & 4 & 3\\end{aligned}| \\\\  & =0\\cdot |\\begin{aligned}1 & 0 \\\\ 3 & 6\\end{aligned}|-0\\cdot |\\begin{aligned}3 & 0 \\\\ 0 & 6\\end{aligned}|+1\\cdot |\\begin{aligned}3 & 1 \\\\ 0 & 3\\end{aligned}|-2(0\\cdot |\\begin{aligned}2 & 1 \\\\ 4 & 3\\end{aligned}|-5\\cdot |\\begin{aligned}3 & 1 \\\\ 0 & 3\\end{aligned}|+0\\cdot |\\begin{aligned}3 & 2 \\\\ 0 & 4\\end{aligned}|) \\\\  & =9-2\\cdot (-5)\\cdot 9 \\\\  & =9+90 \\\\  & =99\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186302331 :knowledge-point/_questions [{:db/id #edb/ref 17592186119783 :knowledge-point/id #uuid "055b3809-f9aa-5dcc-8c1a-b0eb71020d7e" :knowledge-point/title "Calculating the Determinant of a NxN Matrix Using Cofactor Expansion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3bec7eef-98ab-50a1-a827-b84e71a0b5c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186300251} {:answer/id #uuid "3f84bdbb-e043-5047-a36e-5da69a5c79e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186300274} {:answer/id #uuid "48bd8464-99de-5369-8e7b-9fe677ea1700" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186300331} {:answer/id #uuid "a04b15ad-a1bc-5b8c-b98c-a273e45d97d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186300771} {:answer/id #uuid "a93e42c1-d25f-5c74-aa8c-ac931bf2b4fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-19" :db/id #edb/ref 17592186300810}] :answer-field/correct {:answer/id #uuid "3bec7eef-98ab-50a1-a827-b84e71a0b5c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186300251} :answer-field/id #uuid "bf01f982-1095-5239-a807-cfb6858ba6e5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301851}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f43456bf-f295-5e3b-a9b3-15b153a5e800" :question/math-academy-id "q-32727" :question/problem "Calculate the determinant of the matrix\n$S=\\begin{bmatrix}0 & 2 & 0 & 0 \\\\ 1 & 0 & 0 & 0 \\\\ 1 & 2 & -5 & 4 \\\\ 4 & 0 & 2 & 2\\end{bmatrix}.$" :question/worked-solution "We use the cofactor expansion along the first row:\n\n$$\n\\begin{aligned}det(S) & ={s}_{11}{C}_{11}+{s}_{12}{C}_{12}+{s}_{13}{C}_{13}+{s}_{14}{C}_{14} \\\\  & =0\\cdot {C}_{11}+2\\cdot {C}_{12}+0\\cdot {C}_{13}+0\\cdot {C}_{14} \\\\  & =2{C}_{12} \\\\  & =2\\cdot |\\begin{aligned}∗ & 2 & ∗ & ∗ \\\\ 1 & ∗ & 0 & 0 \\\\ 1 & ∗ & -5 & 4 \\\\ 4 & ∗ & 2 & 2\\end{aligned}| \\\\  & =2(-1)^{1+2}|\\begin{aligned}1 & 0 & 0 \\\\ 1 & -5 & 4 \\\\ 4 & 2 & 2\\end{aligned}| \\\\  & =-2(1\\cdot |\\begin{aligned}-5 & 4 \\\\ 2 & 2\\end{aligned}|-0\\cdot |\\begin{aligned}1 & 4 \\\\ 4 & 2\\end{aligned}|+0\\cdot |\\begin{aligned}1 & -5 \\\\ 4 & 2\\end{aligned}|) \\\\  & =-2((-5\\cdot 2-4\\cdot 2)-0+0) \\\\  & =-2\\cdot (-18) \\\\  & =36\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186571443 :knowledge-point/_questions [{:db/id #edb/ref 17592186119783 :knowledge-point/id #uuid "055b3809-f9aa-5dcc-8c1a-b0eb71020d7e" :knowledge-point/title "Calculating the Determinant of a NxN Matrix Using Cofactor Expansion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c409eaf-a88b-52d0-93e4-e06a7fbd8275" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186570931} {:answer/id #uuid "460aef30-08cb-5a20-8328-3ae1a8f946cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-60" :db/id #edb/ref 17592186571000} {:answer/id #uuid "929a7047-4cab-559a-b902-fb43e8ec1d1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186571119} {:answer/id #uuid "e1597bd3-5f9c-5dd4-9a8d-382a63c04f0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186571237} {:answer/id #uuid "f7b70f72-82d4-57c3-b86c-4d54f9b46376" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186571267}] :answer-field/correct {:answer/id #uuid "460aef30-08cb-5a20-8328-3ae1a8f946cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-60" :db/id #edb/ref 17592186571000} :answer-field/id #uuid "cfe34648-d2b0-538a-b862-47f017b7fd97" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186571357}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d888b8b4-33e2-5465-96a7-f2cf43e527f2" :question/math-academy-id "q-32746" :question/problem "Calculate the determinant of the matrix\n$W=\\begin{bmatrix}1 & 0 & 5 & 0 \\\\ 2 & 0 & 0 & 0 \\\\ -1 & 3 & 0 & 4 \\\\ 8 & 0 & 1 & -2\\end{bmatrix}.$" :question/worked-solution "We use the cofactor expansion along the first row:\n\n$$\n\\begin{aligned}det(W) & ={w}_{11}{C}_{11}+{w}_{12}{C}_{12}+{w}_{13}{C}_{13}+{w}_{14}{C}_{14} \\\\  & =1\\cdot {C}_{11}+0\\cdot {C}_{12}+5\\cdot {C}_{13}+0\\cdot {C}_{14} \\\\  & ={C}_{11}+5{C}_{13} \\\\  & =1\\cdot \\begin{vmatrix}1 & ∗ & ∗ & ∗ \\\\ ∗ & 0 & 0 & 0 \\\\ ∗ & 3 & 0 & 4 \\\\ ∗ & 0 & 1 & -2\\end{vmatrix}+5\\cdot \\begin{vmatrix}∗ & ∗ & 5 & ∗ \\\\ 2 & 0 & ∗ & 0 \\\\ -1 & 3 & ∗ & 4 \\\\ 8 & 0 & ∗ & -2\\end{vmatrix} \\\\  & =1\\cdot (-1)^{1+1}\\begin{vmatrix}0 & 0 & 0 \\\\ 3 & 0 & 4 \\\\ 0 & 1 & -2\\end{vmatrix}+5\\cdot (-1)^{1+3}\\begin{vmatrix}2 & 0 & 0 \\\\ -1 & 3 & 4 \\\\ 8 & 0 & -2\\end{vmatrix} \\\\  & =\\begin{vmatrix}0 & 0 & 0 \\\\ 3 & 0 & 4 \\\\ 0 & 1 & -2\\end{vmatrix}+5\\begin{vmatrix}2 & 0 & 0 \\\\ -1 & 3 & 4 \\\\ 8 & 0 & -2\\end{vmatrix} \\\\  & =0\\cdot \\begin{vmatrix}0 & 4 \\\\ 1 & -2\\end{vmatrix}-0\\cdot \\begin{vmatrix}3 & 4 \\\\ 0 & -2\\end{vmatrix}+0\\cdot \\begin{vmatrix}3 & 0 \\\\ 0 & 1\\end{vmatrix}+5(2\\cdot \\begin{vmatrix}3 & 4 \\\\ 0 & -2\\end{vmatrix}-0\\cdot \\begin{vmatrix}-1 & 4 \\\\ 8 & -2\\end{vmatrix}+0\\cdot \\begin{vmatrix}-1 & 3 \\\\ 8 & 0\\end{vmatrix}) \\\\  & =10(3\\cdot (-2)-4\\cdot 0) \\\\  & =10\\cdot (-6) \\\\  & =-60\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186390791 :knowledge-point/_questions [{:db/id #edb/ref 17592186119781 :knowledge-point/id #uuid "ecdc6a5a-5aba-5547-97aa-db3cd2e90ae6" :knowledge-point/title "Calculating a Minor in a NxN Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f17fc7e8-0774-59d5-a669-3e615ebed902" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "|\\begin{aligned}0 & 2 & 0 & 3 \\\\ 1 & 8 & 4 & -1 \\\\ 5 & 2 & 1 & 0 \\\\ -1 & 3 & 11 & 2\\end{aligned}|" :db/id #edb/ref 17592186390793} {:answer/id #uuid "7d69e951-e796-50a9-a627-4fb7fb34ee61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "|\\begin{aligned}0 & -1 & 5 & 2 \\\\ 1 & 2 & 4 & -1 \\\\ 5 & -5 & 1 & 0 \\\\ -1 & 4 & 11 & 2\\end{aligned}|" :db/id #edb/ref 17592186390794} {:answer/id #uuid "a45cf9ed-3b1e-55c6-ba3a-363e374ea92c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "|\\begin{aligned}0 & 7 & 0 & 3 \\\\ 1 & 2 & 4 & -1 \\\\ 5 & -5 & 1 & 0 \\\\ -1 & 4 & 11 & 2\\end{aligned}|" :db/id #edb/ref 17592186390795} {:answer/id #uuid "61e4c71a-7cef-57c7-9149-cd6ab16e2522" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "|\\begin{aligned}-1 & 5 & -2 & 2 \\\\ 7 & 2 & 0 & 3 \\\\ -5 & 2 & 1 & 0 \\\\ 4 & 3 & 11 & 2\\end{aligned}|" :db/id #edb/ref 17592186390796} {:answer/id #uuid "746c7662-4e89-51c6-9606-f2a483de8fdc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "|\\begin{aligned}7 & 2 & 0 & 3 \\\\ 2 & 8 & 4 & -1 \\\\ -5 & 2 & 1 & 0 \\\\ 4 & 3 & 11 & 2\\end{aligned}|" :db/id #edb/ref 17592186390797}] :answer-field/correct {:answer/id #uuid "a45cf9ed-3b1e-55c6-ba3a-363e374ea92c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "|\\begin{aligned}0 & 7 & 0 & 3 \\\\ 1 & 2 & 4 & -1 \\\\ 5 & -5 & 1 & 0 \\\\ -1 & 4 & 11 & 2\\end{aligned}|" :db/id #edb/ref 17592186390795} :answer-field/id #uuid "6021bbc8-aef4-542e-be1f-f2189f2911eb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390792}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c52202b7-1fa1-5c69-a358-e874710d6248" :question/math-academy-id "q-32798" :question/problem "What is the minor of ${f}_{13}$ in  $F=\\begin{bmatrix}0 & -1 & 5 & -2 & 2 \\\\ 0 & 7 & 2 & 0 & 3 \\\\ 1 & 2 & 8 & 4 & -1 \\\\ 5 & -5 & 2 & 1 & 0 \\\\ -1 & 4 & 3 & 11 & 2\\end{bmatrix}?$" :question/worked-solution "To get the minor of ${f}_{13}$, we remove the $1$st row and $3$rd column:\n\n$$\nF=\\begin{bmatrix}∗ & ∗ & 5 & ∗ & ∗ \\\\ 0 & 7 & ∗ & 0 & 3 \\\\ 1 & 2 & ∗ & 4 & -1 \\\\ 5 & -5 & ∗ & 1 & 0 \\\\ -1 & 4 & ∗ & 11 & 2\\end{bmatrix}\n$$\n\n   \n\nSo, the minor is\n\n$$\n{M}_{13}=\\begin{vmatrix}0 & 7 & 0 & 3 \\\\ 1 & 2 & 4 & -1 \\\\ 5 & -5 & 1 & 0 \\\\ -1 & 4 & 11 & 2\\end{vmatrix}.\n$$"}] [{:db/id #edb/ref 17592186120207 :knowledge-point/_questions [{:db/id #edb/ref 17592186119783 :knowledge-point/id #uuid "055b3809-f9aa-5dcc-8c1a-b0eb71020d7e" :knowledge-point/title "Calculating the Determinant of a NxN Matrix Using Cofactor Expansion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0843f07d-7e63-5667-aa53-1128919652ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-112" :db/id #edb/ref 17592186299971} {:answer/id #uuid "0cd7cf2f-5a7d-5888-8851-073bfc651c1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186299999} {:answer/id #uuid "279ddaf4-4285-58dd-9d16-ab377c009e2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "112" :db/id #edb/ref 17592186300151} {:answer/id #uuid "2c0fdb8f-cde8-5eb3-81e4-70beaa668e51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "80" :db/id #edb/ref 17592186300176} {:answer/id #uuid "3243cc72-8722-5358-b43b-c8b6ceed365e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186300211}] :answer-field/correct {:answer/id #uuid "279ddaf4-4285-58dd-9d16-ab377c009e2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "112" :db/id #edb/ref 17592186300151} :answer-field/id #uuid "6b52385f-d14f-5531-974a-819f1b812a30" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301564}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4807bb32-2a62-536d-a90f-b629a70d8fa6" :question/math-academy-id "q-32800" :question/problem "Calculate the determinant of the matrix\n$A=\\begin{bmatrix}0 & 8 & 0 & 0 \\\\ -1 & 0 & 0 & 0 \\\\ 3 & 1 & 6 & 2 \\\\ 1 & 0 & -1 & 2\\end{bmatrix}$" :question/worked-solution "We use the cofactor expansion along the first row:\n\n$$\n\\begin{aligned}det(A) & ={a}_{11}{C}_{11}+{a}_{12}{C}_{12}+{a}_{13}{C}_{13}+{a}_{14}{C}_{14} \\\\  & =0\\cdot {C}_{11}+8\\cdot {C}_{12}+0\\cdot {C}_{13}+0\\cdot {C}_{14} \\\\  & =8{C}_{12} \\\\  & =8\\cdot |\\begin{aligned}∗ & 8 & ∗ & ∗ \\\\ -1 & ∗ & 0 & 0 \\\\ 3 & ∗ & 6 & 2 \\\\ 1 & ∗ & -1 & 2\\end{aligned}| \\\\  & =8(-1)^{1+2}|\\begin{aligned}-1 & 0 & 0 \\\\ 3 & 6 & 2 \\\\ 1 & -1 & 2\\end{aligned}| \\\\  & =-8((-1)\\cdot |\\begin{aligned}6 & 2 \\\\ -1 & 2\\end{aligned}|-0\\cdot |\\begin{aligned}3 & 2 \\\\ 1 & 2\\end{aligned}|+0\\cdot |\\begin{aligned}3 & 6 \\\\ 1 & -1\\end{aligned}|) \\\\  & =8(6\\cdot 2-(-1)\\cdot 2)-0+0 \\\\  & =8\\cdot 14 \\\\  & =112\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186323744 :knowledge-point/_questions [{:db/id #edb/ref 17592186119782 :knowledge-point/id #uuid "58148550-e41f-5df0-80dc-e783619cf87d" :knowledge-point/title "Calculating a Cofactor in a NxN Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "147888b7-3be1-5c61-a527-09bd238c54f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-|\\begin{aligned}-2 & 2 & 0 \\\\ 1 & 3 & 5 \\\\ 0 & 2 & -2\\end{aligned}|" :db/id #edb/ref 17592186321314} {:answer/id #uuid "57a12085-d4fa-57ec-8059-de705274f776" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "|\\begin{aligned}-2 & 2 & 0 \\\\ 1 & 3 & 5 \\\\ 0 & 2 & -2\\end{aligned}|" :db/id #edb/ref 17592186321836} {:answer/id #uuid "8f51fed1-08a6-55a3-a261-1c9416d371f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "|\\begin{aligned}-2 & 3 & 0 \\\\ 1 & 0 & 5 \\\\ -7 & 0 & 3\\end{aligned}|" :db/id #edb/ref 17592186322285} {:answer/id #uuid "ab001798-4c95-52c6-8bb5-a0283265953d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-|\\begin{aligned}-2 & 2 & 3 \\\\ 1 & 3 & 0 \\\\ -7 & 0 & 0\\end{aligned}|" :db/id #edb/ref 17592186322489} {:answer/id #uuid "de5ed94a-712c-5cd7-b285-0cdfce1efa19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "|\\begin{aligned}-2 & 2 & 0 \\\\ 0 & 2 & -2 \\\\ -7 & 0 & 3\\end{aligned}|" :db/id #edb/ref 17592186322884}] :answer-field/correct {:answer/id #uuid "ab001798-4c95-52c6-8bb5-a0283265953d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-|\\begin{aligned}-2 & 2 & 3 \\\\ 1 & 3 & 0 \\\\ -7 & 0 & 0\\end{aligned}|" :db/id #edb/ref 17592186322489} :answer-field/id #uuid "910c107e-8209-55ad-aaee-2dfef20df5ee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323452}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9ae55842-6a04-591a-82b0-c1e71e70c4a5" :question/math-academy-id "q-36043" :question/problem "Find the cofactor of ${b}_{34}$ in \n$B=\\begin{bmatrix}-2 & 2 & 3 & 0 \\\\ 1 & 3 & 0 & 5 \\\\ 0 & 2 & 1 & -2 \\\\ -7 & 0 & 0 & 3\\end{bmatrix}.$" :question/worked-solution "First, to get the minor of ${b}_{34}$, we remove the $3$rd row and the $4$th column: \n\n$$\nB=\\begin{bmatrix}-2 & 2 & 3 & ∗ \\\\ 1 & 3 & 0 & ∗ \\\\ ∗ & ∗ & ∗ & -2 \\\\ -7 & 0 & 0 & ∗\\end{bmatrix}\n$$\n\nSo, the minor is \n\n$$\n{M}_{34}=\\begin{vmatrix}-2 & 2 & 3 \\\\ 1 & 3 & 0 \\\\ -7 & 0 & 0\\end{vmatrix}.\n$$\n\nTherefore, the cofactor of ${b}_{34}$ is\n\n$$\n\\begin{aligned}{C}_{34} & =(-1)^{3+4}{M}_{34} \\\\  & =-{M}_{34} \\\\  & =-\\begin{vmatrix}-2 & 2 & 3 \\\\ 1 & 3 & 0 \\\\ -7 & 0 & 0\\end{vmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186571421 :kno