2-2312-545a-8955-97b0d65f236d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{vmatrix}0 & 2 & 3 \\\\ 5 & 2 & 0 \\\\ -6 & 1 & 0\\end{vmatrix}" :db/id #edb/ref 17592186571035} {:answer/id #uuid "8d105c7c-f6d4-5e71-9c7c-4dc0c9b642d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\begin{vmatrix}0 & 5 & 2 \\\\ 5 & 0 & 2 \\\\ -5 & 6 & -2\\end{vmatrix}" :db/id #edb/ref 17592186571110} {:answer/id #uuid "c32a0d09-0b2d-5a3b-9258-984ea01ca297" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\begin{vmatrix}0 & 2 & 3 \\\\ 5 & 2 & 0 \\\\ -6 & 1 & 0\\end{vmatrix}" :db/id #edb/ref 17592186571191} {:answer/id #uuid "c4808a90-10c0-5c25-923b-83c194b3406e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{vmatrix}0 & 5 & 2 \\\\ 5 & 0 & 2 \\\\ -5 & 6 & -2\\end{vmatrix}" :db/id #edb/ref 17592186571196} {:answer/id #uuid "d4adf8be-5589-54a4-9376-a8eed3ab727e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\begin{vmatrix}0 & 2 & 0 \\\\ 6 & -2 & 8 \\\\ 3 & 1 & 0\\end{vmatrix}" :db/id #edb/ref 17592186571219}] :answer-field/correct {:answer/id #uuid "c32a0d09-0b2d-5a3b-9258-984ea01ca297" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\begin{vmatrix}0 & 2 & 3 \\\\ 5 & 2 & 0 \\\\ -6 & 1 & 0\\end{vmatrix}" :db/id #edb/ref 17592186571191} :answer-field/id #uuid "a2272371-24d5-5f31-83e4-a4207fd7fa8d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186571345}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "64da2690-5503-52bf-8b2b-4188c9d74be7" :question/math-academy-id "q-71016" :question/problem "Find the cofactor of ${x}_{32}$ in \n$X=\\begin{bmatrix}0 & 5 & 2 & 3 \\\\ 5 & 0 & 2 & 0 \\\\ -5 & 6 & -2 & 8 \\\\ -6 & 3 & 1 & 0\\end{bmatrix}.$" :question/worked-solution "First, to get the minor of ${x}_{32}$, we remove the $3$rd row and $2$nd column: \n\n$$\nX=\\begin{bmatrix}0 & ∗ & 2 & 3 \\\\ 5 & ∗ & 2 & 0 \\\\ ∗ & 6 & ∗ & ∗ \\\\ -6 & ∗ & 1 & 0\\end{bmatrix}\n$$\n\nSo, the minor is \n\n$$\n{M}_{32}=\\begin{vmatrix}0 & 2 & 3 \\\\ 5 & 2 & 0 \\\\ -6 & 1 & 0\\end{vmatrix}\n$$\n\n  \n\nTherefore, the cofactor of ${x}_{32}$ is\n\n$$\n\\begin{aligned}{C}_{32} & =(-1)^{3+2}{M}_{32} \\\\  & =-{M}_{32} \\\\  & =-\\begin{vmatrix}0 & 2 & 3 \\\\ 5 & 2 & 0 \\\\ -6 & 1 & 0\\end{vmatrix}.\\end{aligned}\n$$"}]}
