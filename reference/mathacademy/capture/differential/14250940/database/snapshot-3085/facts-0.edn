f 17592186045417] [17592186119596 #edb/ref 1069 "e-4448" #edb/ref 17592186045417] [17592186119596 #edb/ref 1071 "Find the cofactor of $d_{23}$ in \n![](images/2b/2b1ce867c1ddc7bfe6e1dcb94594dc529038f48755077e551f6ac6fd5709bd6c.png)" #edb/ref 17592186045417] [17592186119596 #edb/ref 1072 #uuid "8e61e639-f165-5157-91c0-e9a6faf734a6" #edb/ref 17592186045417] [17592186119596 #edb/ref 1074 "First, to get the minor of $d_{23}$, we remove the $2$nd row and $3$rd column:\n\n![](images/80/80c7234f95b4814f64435f32fbd627fabbd0564d7d2f97f69c003c644d96663e.png)\n\nSo, the minor is \n\n![](images/d4/d4b6ca5c1dad2c83a0f7d76f82099645fb1cfb2db3fb7c552f6b8b9a95684b42.png)\n\nNow, the cofactor of $d_{23}$ is\n\n$$\n\\begin{aligned}{C}_{23} & =(-1)^{2+3}{M}_{23} \\\\  & =-{M}_{23} \\\\  & =-|\\begin{aligned}0 & 2 & -6 \\\\ 6 & 0 & 9 \\\\ 5 & 4 & 0\\end{aligned}|.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186119597 #edb/ref 1069 "e-4449" #edb/ref 17592186045417] [17592186119597 #edb/ref 1071 "Calculate the determinant of the matrix\n![](images/8a/8af3a07c6f7c326656a7be442b2bdec7e51e63c80d19213727494fce9c7cb720.png)" #edb/ref 17592186045417] [17592186119597 #edb/ref 1072 #uuid "3e091496-053c-59fb-90d6-d8fb89ea6004" #edb/ref 17592186045417] [17592186119597 #edb/ref 1074 "We use the cofactor expansion along the first row:\n\n$$\n\\begin{aligned}det(A) & ={a}_{11}{C}_{11}+{a}_{12}{C}_{12}+{a}_{13}{C}_{13}+{a}_{14}{C}_{14} \\\\  & =0\\cdot {C}_{11}+0\\cdot {C}_{12}+2\\cdot {C}_{13}+0\\cdot {C}_{14} \\\\  & =2{C}_{13} \\\\  & =2\\cdot |\\begin{aligned}∗ & ∗ & 2 & ∗ \\\\ 5 & 1 & ∗ & 0 \\\\ 1 & 6 & ∗ & -1 \\\\ -6 & 3 & ∗ & 0\\end{aligned}| \\\\  & =2(-1)^{1+3}|\\begin{aligned}5 & 1 & 0 \\\\ 1 & 6 & -1 \\\\ -6 & 3 & 0\\end{aligned}| \\\\  & =2(5|\\begin{aligned}6 & -1 \\\\ 3 & 0\\end{aligned}|-1|\\begin{aligned}1 & -1 \\\\ -6 & 0\\end{aligned}|+0|\\begin{aligned}1 & 6 \\\\ -6 & 3\\end{aligned}|) \\\\  & =2(5(6\\cdot 0+1\\cdot 3)-(1\\cdot 0-(-1)\\cdot (-6))+0(1\\cdot 3-6\\cdot (-6))) \\\\  & =2(15+6+0) \\\\  & =2\\cdot 21 \\\\  & =42\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186119781 #edb/ref 1037 #edb/ref 17592186048146 #edb/ref 17592186045417] [17592186119781 #edb/ref 1038 #edb/ref 17592186120509 #edb/ref 17592186045417] [17592186119781 #edb/ref 1038 #edb/ref 17592186120510 #edb/ref 17592186045417] [17592186119781 #edb/ref 1038 #edb/ref 17592186265949 #edb/ref 17592186045417] [17592186119781 #edb/ref 1038 #edb/ref 17592186265979 #edb/ref 17592186045417] [17592186119781 #edb/ref 1038 #edb/ref 17592186265981 #edb/ref 17592186045417] [17592186119781 #edb/ref 1038 #edb/ref 17592186388174 #edb/ref 17592186045417] [17592186119781 #edb/ref 1038 #edb/ref 17592186390791 #edb/ref 17592186045417] [17592186119781 #edb/ref 1038 #edb/ref 17592186391944 #edb/ref 17592186045417] [17592186119781 #edb/ref 1038 #edb/ref 17592186393091 #edb/ref 17592186045417] [17592186119781 #edb/ref 1038 #edb/ref 17592186393098 #edb/ref 17592186045417] [17592186119781 #edb/ref 1038 #edb/ref 17592186571421 #edb/ref 17592186045417] [17592186119781 #edb/ref 1039 "Calculating a Minor in a NxN Matrix" #edb/ref 17592186045417] [17592186119781 #edb/ref 1041 #edb/ref 17592186119595 #edb/ref 17592186045417] [17592186119781 #edb/ref 1042 #uuid "ecdc6a5a-5aba-5547-97aa-db3cd2e90ae6" #edb/ref 17592186045417] [17592186119782 #edb/ref 1038 #edb/ref 17592186120400 #edb/ref 17592186045417] [17592186119782 #edb/ref 1038 #edb/ref 17592186120505 #edb/ref 17592186045417] [17592186119782 #edb/ref 1038 #edb/ref 17592186266007 #edb/ref 17592186045417] [17592186119782 #edb/ref 1038 #edb/ref 17592186266008 #edb/ref 17592186045417] [17592186119782 #edb/ref 1038 #edb/ref 17592186266009 #edb/ref 17592186045417] [17592186119782 #edb/ref 1038 #edb/ref 17592186302373 #edb/ref 17592186045417] [17592186119782 #edb/ref 1038 #edb/ref 17592186323744 #edb/ref 17592186045417] [17592186119782 #edb/ref 1038 #edb/ref 17592186326843 #edb/ref 17592186045417] [17592186119782 #edb/ref 1038 #edb/ref 17592186364112 #ed