 1075 #edb/ref 17592186548653 #edb/ref 17592186045417] [17592186548973 #edb/ref 1075 #edb/ref 17592186548863 #edb/ref 17592186045417] [17592186548973 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186548973 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186548973 #edb/ref 1078 #edb/ref 17592186548578 #edb/ref 17592186045417] [17592186548973 #edb/ref 1079 #uuid "f77f73c8-a6f1-5686-8eae-81626a3ac1d9" #edb/ref 17592186045417] [17592186549053 #edb/ref 1068 #edb/ref 17592186548973 #edb/ref 17592186045417] [17592186549053 #edb/ref 1069 "q-79345" #edb/ref 17592186045417] [17592186549053 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186549053 #edb/ref 1071 "Consider the matrices given below. Find $\\text{dim(Null}(A))+\\text{dim(Null}(B))+\\text{dim(Null}(C)).$\n\n$$\nA=[\\begin{aligned}1 & -1 & 5 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}],\\,B=[\\begin{aligned}1 & -2 & 4 & 0 \\\\ 0 & 1 & 3 & 0 \\\\ 0 & 0 & 1 & 0\\end{aligned}],\\,C=[\\begin{aligned}1 & 0 & -4 & 1 \\\\ 0 & 1 & 0 & 1 \\\\ 0 & 0 & 0 & 1\\end{aligned}]\n$$" #edb/ref 17592186045417] [17592186549053 #edb/ref 1072 #uuid "d68af87f-be02-55a7-9b78-0da04db4e309" #edb/ref 17592186045417] [17592186549053 #edb/ref 1074 "The dimension of the null space of a matrix is the number of non-pivot columns in the matrix. \n\nAlso, all of the given matrices are in row echelon form.\n\nWith that in mind, let's consider each of the statements.\n\n- The matrix $A$ has $1$ pivot column and $2$ non-pivot columns (namely, the $2$nd and $3$rd columns). So, \n\n$$\n\\text{dim(Null}(A))=2.\n$$\n\n- The matrix $B$ has $3$ pivot columns and $1$ non-pivot column (namely, the $4$th column). So, \n\n$$\n\\text{dim(Null}(B))=1.\n$$\n\n- The matrix $C$ has $3$ pivot columns and $1$ non-pivot column (namely, the $3$rd column). So, \n\n$$\n\\text{dim(Null}(C))=1.\n$$\n\nTherefore,\n\n$$\n\\text{dim(Null}(A))+\\text{dim(Null}(B))+\\text{dim(Null}(C))=2+1+1=4.\n$$" #edb/ref 17592186045417] [17592186549071 #edb/ref 1058 #edb/ref 17592186549075 #edb/ref 17592186045417] [17592186549071 #edb/ref 1062 #uuid "00e75ee6-51f2-5e0e-83f6-e87b9422ad7c" #edb/ref 17592186045417] [17592186549071 #edb/ref 1063 #edb/ref 17592186124867 #edb/ref 17592186045417] [17592186549075 #edb/ref 1058 #edb/ref 17592186549137 #edb/ref 17592186045417] [17592186549075 #edb/ref 1062 #uuid "0aa973af-27e4-5410-b0a4-b621f52c8916" #edb/ref 17592186045417] [17592186549075 #edb/ref 1063 #edb/ref 17592186124868 #edb/ref 17592186045417] [17592186549125 #edb/ref 1058 #edb/ref 17592186549139 #edb/ref 17592186045417] [17592186549125 #edb/ref 1062 #uuid "8ef6e9a0-a726-58b5-b34b-a12fe19773a7" #edb/ref 17592186045417] [17592186549125 #edb/ref 1063 #edb/ref 17592186425404 #edb/ref 17592186045417] [17592186549137 #edb/ref 1058 #edb/ref 17592186549125 #edb/ref 17592186045417] [17592186549137 #edb/ref 1062 #uuid "b5d981f1-253c-5ca8-ac7c-2553c528663e" #edb/ref 17592186045417] [17592186549137 #edb/ref 1063 #edb/ref 17592186319318 #edb/ref 17592186045417] [17592186549139 #edb/ref 1062 #uuid "c00cfbd0-d98b-5d36-a27e-24a7e17590cf" #edb/ref 17592186045417] [17592186549139 #edb/ref 1063 #edb/ref 17592186549053 #edb/ref 17592186045417]}
