:answer/id #uuid "15f82c38-57d7-5235-83eb-302196ff1750" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186319454} {:answer/id #uuid "3f67abcd-6c02-50c4-acb1-27ca9fadc6b6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186319583} {:answer/id #uuid "49c006d4-4694-5f18-8c18-fd8cb1aef987" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186319610} {:answer/id #uuid "4a702616-0a66-569b-9818-fc0d52dc4b39" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186319613} {:answer/id #uuid "c8259aac-72ac-5cc7-a879-c8c2f0167118" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186320001}] :answer-field/correct {:db/id #edb/ref 17592186320001} :answer-field/id #uuid "694b1ea3-a3d2-5e40-bfa3-982b01e9a940" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186320383}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "687cbaa7-684a-507a-80f4-6f515d95364b" :question/math-academy-id "q-35318" :question/problem "If $A=\\begin{bmatrix}2 & -1 & 3 \\\\ 0 & 9 & -5 \\\\ -4 & 2 & 7 \\\\ 6 & -3 & 9\\end{bmatrix},\\,$ then $\\text{nullity}(A)=$" :question/worked-solution "Recall that by definition, $\\text{nullity}(A)=\\text{dim}(\\text{Null}(A)).$\n\nTo find $\\text{dim}(\\text{Null}(A))$, we reduce $A$ to row echelon form, as follows:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}2 & -1 & 3 \\\\ 0 & 9 & -5 \\\\ -4 & 2 & 7 \\\\ 6 & -3 & 9\\end{bmatrix} & {R}_{3} & :={R}_{3}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}2 & -1 & 3 \\\\ 0 & 9 & -5 \\\\ 0 & 0 & 13 \\\\ 6 & -3 & 9\\end{bmatrix} & {R}_{4} & :={R}_{4}+(-3){R}_{1} \\\\  & ∼\\begin{bmatrix}2 & -1 & 3 \\\\ 0 & 9 & -5 \\\\ 0 & 0 & 13 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix has $3$ pivot columns and no non-pivot columns. \n\nTherefore,\n\n$$\n\\text{nullity}(A)=\\text{dim}(\\text{Null}(A))=0.\n$$"} :step/id #uuid "e7731db1-e241-5345-b7cc-1ded044b9fdc" :step/next {:db/id #edb/ref 17592186491277}} {:db/id #edb/ref 17592186491277 :step/content {:db/id #edb/ref 17592186124877 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0aa598fb-5b9e-5eab-8d75-ba9506c4ca84" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186319419} {:answer/id #uuid "22844e7a-ef6b-57a6-8284-3bbb51cbd945" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186319498} {:answer/id #uuid "9b20d76c-e6ca-5977-8498-bd058294bd37" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186319857} {:answer/id #uuid "c9d88661-d88d-54c8-9c09-88200cbc595f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186320008} {:answer/id #uuid "d82e6665-8a18-5233-bacf-3d6116645e11" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186320051}] :answer-field/correct {:db/id #edb/ref 17592186320051} :answer-field/id #uuid "60a491e9-6bdb-50a9-8234-00b00fcda03e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186320365}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1eb36ea9-01c5-5b94-89ae-678eeae6fd31" :question/math-academy-id "q-35349" :question/problem "Consider the matrices given below. Find $\\text{dim(Null}(A))+\\text{dim(Null}(B))+\\text{dim(Null}(C)).$\n\n$$\nA=\\begin{bmatrix}1 & -1 & 5 \\\\ 0 & 0 & -7 \\\\ 0 & 0 & 0\\end{bmatrix},\\,B=\\begin{bmatrix}2 & -4 & 7 & 2 \\\\ 0 & 0 & 5 & 3 \\\\ 0 & 0 & 0 & 0\\end{bmatrix},\\,C=\\begin{bmatrix}1 & 0 & -4 & 3 \\\\ 0 & 2 & 1 & 0 \\\\ 0 & 0 & -7 & 9 \\\\ 0 & 0 & 0 & 2\\end{bmatrix}\n$$" :question/worked-solution "The dimension of the null space of a matrix is the number of non-pivot columns in the matrix. \n\nAlso, all of the given matrices are in row echelon form.\n\nWith that in mind, let's consider each of the statements.\n\n- The matrix $A$ has $2$ pivot columns and $1$ non-pivot column (namely, the $2$nd column). So, \n\n$$\n\\text{dim(Null}(A))=1.\n$$\n\n- The matrix $B$ has $2$ pivot columns and $2$ non-pivot columns (namely, the $2$nd and $4$th columns). So, \n\n$$\n\\text{dim(Null}(B))=2.\n$$\n\n- The matrix $C$ has $4$ pivot columns and no non-pivot columns. So, \n\n$$\n\\text{dim(Null}(C))=0.\n$$\n\nTherefore,\n\n$$\n\\text{dim(Null}(A))+\\text{dim(Null}(B))+\\text{dim(Null}(C))=1+2+0=3.\n$$"} :step/id #uuid "f9c127f3-2bcc-5095-b4d4-d32b14bde02a" :step/next {:db/id #edb/ref 17592186491238}}] :activity/title "The Dimension of the Null Space of a Matrix" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186490500}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186549071} :activity/id #uuid "9ba31b31-2601-5ef2-b2a4-48c8b616b8cf" :activity/scope {:db/id #edb/ref 17592186050996 :topic/id #uuid "7821b684-8118-5d42-9459-ebb20010e0ff" :topic/math-academy-id 1868} :activity/steps [{:db/id #edb/ref 17592186549071 :step/content {:db/id #edb/ref 17592186124867 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04ce1481-190f-575a-96b6-e4fa6be7e03c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186317586} {:answer/id #uuid "15da5400-88f1-54b9-96b8-131f7cdd6a4b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186317633} {:answer/id #uuid "3bfe7c60-15a0-58c7-9be9-c8bbb837d28b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186317758} {:answer/id #uuid "89a813fe-bb75-5bd5-851b-9535301eabf3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186318029} {:answer/id #uuid "9b884dc9-1967-564e-816c-9d633a733872" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186318097}] :answer-field/correct {:db/id #edb/ref 17592186318029} :answer-field/id #uuid "a1955ab2-4846-5ce8-93a1-fbddc2e4deb8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186318780}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "574853c6-277a-5d86-89c4-02f84dccc61a" :question/math-academy-id "q-34900" :question/problem "Let $R$ be a $8\\times 12$ matrix that has $8$ pivot columns. What is the dimension of the null space of $R?$" :question/worked-solution "We know that $\\text{dim(Null}(R))$ is the number of non-pivot columns in $R.$ \n\nSince $R$ has $12$ columns and $8$ of them are pivots, then the number of non-pivot columns in $R$ is \n\n$$\n12-8=4.\n$$\n\nTherefore, $\\text{dim(Null}(R))=4.$"} :step/id #uuid "00e75ee6-51f2-5e0e-83f6-e87b9422ad7c" :step/next {:db/id #edb/ref 17592186549075}} {:db/id #edb/ref 17592186549075 :step/content {:db/id #edb/ref 17592186124868 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3fc909b1-8785-5945-9459-d053d2c7079c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186459835} {:answer/id #uuid "52c418de-d88b-5235-9bf5-be2556fb9846" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186459836}] :answer-field/correct {:db/id #edb/ref 17592186459836} :answer-field/id #uuid "55564640-7655-5d3c-bf63-8297180991a2" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186460784} {:answer-field/choices [{:answer/id #uuid "169e939e-6301-511d-8c0c-090a2f18ccdd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186459837} {:answer/id #uuid "9fd9e1cc-c00a-5419-a142-d9bc5d4f5345" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186459838}] :answer-field/correct {:db/id #edb/ref 17592186459837} :answer-field/id #uuid "aca7871e-e659-5912-aa33-fc7d1986742f" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186460785} {:answer-field/choices [{:answer/id #uuid "97736f06-c485-5e15-91c2-2eba3c226429" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186459839} {:answer/id #uuid "0670e564-4f2a-597b-bb60-ec48ef5ea2c1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186459840}] :answer-field/correct {:db/id #edb/ref 17592186459840} :answer-field/id #uuid "6a13967f-4100-5e9e-a96a-a678a0efc380" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186460786}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5f568aea-24ab-542a-9112-9bb117e4fc0c" :question/math-academy-id "q-34904" :question/problem "Which of the following statements are true?\n- **I.** If $A=\\begin{bmatrix}1 & 1 \\\\ 0 & 3\\end{bmatrix}$ then $\\text{dim(Null}(A))=0.$\n- **II.** If $B=\\begin{bmatrix}2 & 0 & 4 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & 0\\end{bmatrix}$ then $\\text{dim(Null}(B))=2.$\n- **III.** If $C=\\begin{bmatrix}5 & 4 & 0 \\\\ 0 & 0 & 1 \\\\ 0 & 0 & 0\\end{bmatrix}$ then $\\text{dim(Null}(C))=1.$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "The dimension of the null space of a matrix is the number of non-pivot columns in the matrix. \n\nAlso, all of the given matrices are in row echelon form.\n\nWith that in mind, let's consider each of the statements.\n\n- Statement I is true. The matrix $A$ has $2$ pivot columns and no non-pivot columns. So, \n\n$$\n\\text{dim(Null}(A))=0.\n$$\n\n- Statement II is false. The matrix $B$ has $2$ pivot column and $1$ non-pivot column (namely, the $3$rd column). So, \n\n$$\n\\text{dim(Null}(B))=1.\n$$\n\n- Statement III is true. The matrix $C$ has $2$ pivot columns and $1$ non-pivot column (namely, the $2$nd column). So, \n\n$$\n\\text{dim(Null}(C))=1.\n$$\n\nTherefore, the correct answer is \"I and III only.\""} :step/id #uuid "0aa973af-27e4-5410-b0a4-b621f52c8916" :step/next {:db/id #edb/ref 17592186549137}} {:db/id #edb/ref 17592186549125 :step/content {:db/id #edb/ref 17592186425404 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01b39024-8f98-5edf-93f7-04a64ee7b6c0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186425380} {:answer/id #uuid "48411ad1-c867-5f45-b8c7-ce3589fd2218" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186425384} {:answer/id #uuid "69951a24-a52b-5841-8392-9e70e2c63d9d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186425388} {:answer/id #uuid "7ac52ed7-ea31-518a-95fb-dc6ea725ad9d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186425390} {:answer/id #uuid "d56c921a-e74a-5b91-bee7-d13092469fb1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186425397}] :answer-field/correct {:db/id #edb/ref 17592186425384} :answer-field/id #uuid "2c9771c3-f30b-56b9-83e9-dd0e274a3d9d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186425400}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "83850766-9b1b-5a37-bf38-12d47d12c4d5" :question/math-academy-id "q-35347" :question/problem "Given $G=\\begin{bmatrix}2 & 5 & 4 & 3 \\\\ -2 & 3 & -6 & 4 \\\\ 0 & -2 & 5 & 1 \\\\ -6 & -15 & -12 & -16\\end{bmatrix},\\,$ what is $\\text{dim}(\\text{Null}(G))?$" :question/worked-solution "To find $\\text{dim}(\\text{Null}(G))$, we reduce $G$ to row echelon form, as follows:\n\n$$\n\\begin{aligned}G & =\\begin{bmatrix}2 & 5 & 4 & 3 \\\\ -2 & 3 & -6 & 4 \\\\ 0 & -2 & 5 & 1 \\\\ -6 & -15 & -12 & -16\\end{bmatrix} & {R}_{2} & :={R}_{2}+{R}_{1} \\\\  & ∼\\begin{bmatrix}2 & 5 & 4 & 3 \\\\ 0 & 8 & -2 & 7 \\\\ 0 & -2 & 5 & 1 \\\\ -6 & -15 & -12 & -16\\end{bmatrix} & {R}_{4} & :={R}_{4}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}2 & 5 & 4 & 3 \\\\ 0 & 8 & -2 & 7 \\\\ 0 & -2 & 5 & 1 \\\\ 0 & 0 & 0 & -7\\end{bmatrix} & {R}_{3} & :={R}_{3}+\\frac{1}{4}{R}_{2} \\\\  & ∼\\begin{bmatrix}2 & 5 & 4 & 3 \\\\ 0 & 8 & -2 & 7 \\\\ 0 & 0 & \\frac{9}{2} & \\frac{11}{4} \\\\ 0 & 0 & 0 & -7\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix has $4$ pivot columns and no non-pivot columns. \n\nTherefore,\n\n$$\n\\text{dim}(\\text{Null}(G))=0.\n$$"} :step/id #uuid "8ef6e9a0-a726-58b5-b34b-a12fe19773a7" :step/next {:db/id #edb/ref 17592186549139}} {:db/id #edb/ref 17592186549137 :step/content {:db/id #edb/ref 17592186319318 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38fc6530-da0e-5ef8-9489-487b09a244dc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186317749} {:answer/id #uuid "56588881-20d6-50d9-9ff9-b07f78c8d62a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186317854} {:answer/id #uuid "74eb3b2a-e28b-5f5f-8bad-16800439d2bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186317966} {:answer/id #uuid "c40e8a26-c0ea-5391-8ea7-86af9f58fbcf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186318213} {:answer/id #uuid "d79b5d41-92e6-55a5-93af-01f4431ff8c9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186318281}] :answer-field/correct {:db/id #edb/ref 17592186317966} :answer-field/id #uuid "f7f6e57d-01d6-53e7-aeb3-fe75d269ce0e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186318941}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "831c003e-6ab4-5abb-a995-8aece30d7ab6" :question/math-academy-id "q-34906" :question/problem "Given $A=\\begin{bmatrix}4 & 2 & 1 & 2 \\\\ 0 & 4 & 2 & 0 \\\\ 8 & 0 & 3 & 5 \\\\ 0 & 2 & 1 & 0\\end{bmatrix},\\,$ what is $\\text{dim}(\\text{Null}(A))?$" :question/worked-solution "To find $\\text{dim}(\\text{Null}(A))$, we reduce $A$ to row echelon form, as follows:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}4 & 2 & 1 & 2 \\\\ 0 & 4 & 2 & 0 \\\\ 8 & 0 & 3 & 5 \\\\ 0 & 2 & 1 & 0\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}4 & 2 & 1 & 2 \\\\ 0 & 4 & 2 & 0 \\\\ 0 & -4 & 1 & 1 \\\\ 0 & 2 & 1 & 0\\end{bmatrix} & {R}_{3} & :={R}_{3}+{R}_{2} \\\\  & ∼\\begin{bmatrix}4 & 2 & 1 & 2 \\\\ 0 & 4 & 2 & 0 \\\\ 0 & 0 & 3 & 1 \\\\ 0 & 2 & 1 & 0\\end{bmatrix} & {R}_{4} & :={R}_{4}+(-\\frac{1}{2}){R}_{2} \\\\  & ∼\\begin{bmatrix}4 & 2 & 1 & 2 \\\\ 0 & 4 & 2 & 0 \\\\ 0 & 0 & 3 & 1 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix has $3$ pivot columns and $1$ non-pivot column (namely, the $4$th column). \n\nTherefore,\n\n$$\n\\text{dim}(\\text{Null}(A))=1.\n$$"} :step/id #uuid "b5d981f1-253c-5ca8-ac7c-2553c528663e" :step/next {:db/id #edb/ref 17592186549125}} {:db/id #edb/ref 17592186549139 :step/content {:db/id #edb/ref 17592186549053 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "223b7f24-1bf6-5866-97dd-305c2bfc6faa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186548422} {:answer/id #uuid "75415968-8129-50a3-b6ce-101666b52758" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186548568} {:answer/id #uuid "787219f1-94ee-53fb-a49b-8777fcdb7957" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186548578} {:answer/id #uuid "982cdb38-b85b-58e9-9088-665bbeac8223" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186548653} {:answer/id #uuid "feb82dbb-03db-5058-b53a-495b57a7a067" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186548863}] :answer-field/correct {:db/id #edb/ref 17592186548578} :answer-field/id #uuid "f77f73c8-a6f1-5686-8eae-81626a3ac1d9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186548973}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d68af87f-be02-55a7-9b78-0da04db4e309" :question/math-academy-id "q-79345" :question/problem "Consider the matrices given below. Find $\\text{dim(Null}(A))+\\text{dim(Null}(B))+\\text{dim(Null}(C)).$\n\n$$\nA=[\\begin{aligned}1 & -1 & 5 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}],\\,B=[\\begin{aligned}1 & -2 & 4 & 0 \\\\ 0 & 1 & 3 & 0 \\\\ 0 & 0 & 1 & 0\\end{aligned}],\\,C=[\\begin{aligned}1 & 0 & -4 & 1 \\\\ 0 & 1 & 0 & 1 \\\\ 0 & 0 & 0 & 1\\end{aligned}]\n$$" :question/worked-solution "The dimension of the null space of a matrix is the number of non-pivot columns in the matrix. \n\nAlso, all of the given matrices are in row echelon form.\n\nWith that in mind, let's consider each of the statements.\n\n- The matrix $A$ has $1$ pivot column and $2$ non-pivot columns (namely, the $2$nd and $3$rd columns). So, \n\n$$\n\\text{dim(Null}(A))=2.\n$$\n\n- The matrix $B$ has $3$ pivot columns and $1$ non-pivot column (namely, the $4$th column). So, \n\n$$\n\\text{dim(Null}(B))=1.\n$$\n\n- The matrix $C$ has $3$ pivot columns and $1$ non-pivot column (namely, the $3$rd column). So, \n\n$$\n\\text{dim(Null}(C))=1.\n$$\n\nTherefore,\n\n$$\n\\text{dim(Null}(A))+\\text{dim(Null}(B))+\\text{dim(Null}(C))=2+1+1=4.\n$$"} :step/id #uuid "c00cfbd0-d98b-5d36-a27e-24a7e17590cf"}] :activity/title "The Dimension of the Null Space of a Matrix" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186548348}]}
