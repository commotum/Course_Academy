#{[{:db/id #edb/ref 17592186272029 :knowledge-point/_questions [{:db/id #edb/ref 17592186133771 :knowledge-point/id #uuid "bc757fa2-12ce-5a1c-a524-8eb256842079" :knowledge-point/title "Calculating Dot Products Using Orthogonal Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "856764cd-371b-5661-95e2-1ca7d73c0b46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186270421} {:answer/id #uuid "b3ae8646-b264-53b3-b5c3-a47ea6c1e44f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186270871} {:answer/id #uuid "b7bab78e-4f41-5e95-8013-7c9905aaa3eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-62" :db/id #edb/ref 17592186270895} {:answer/id #uuid "ee6b0155-53c8-5e6a-87f6-c3c6555e1651" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186271361} {:answer/id #uuid "f443c93c-ad87-527d-95fb-af4ea2a24b95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-58" :db/id #edb/ref 17592186271411}] :answer-field/correct {:answer/id #uuid "b3ae8646-b264-53b3-b5c3-a47ea6c1e44f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186270871} :answer-field/id #uuid "853c38fa-0fbb-5a69-95c8-64b42bef328c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271740}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a7f3874f-2914-5813-be9d-8b4e590254ca" :question/math-academy-id "q-140125" :question/problem "Let $u=\\begin{bmatrix}5 \\\\ 1 \\\\ -3 \\\\ 3\\end{bmatrix},v=\\begin{bmatrix}-4 \\\\ -2 \\\\ 2 \\\\ -4\\end{bmatrix}$ and $w=\\begin{bmatrix}1 \\\\ -5 \\\\ 2 \\\\ 2\\end{bmatrix}$ be vectors such that $u\\,⊥\\,w.$ Find $(w+v)\\cdot (2u+3w).$" :question/worked-solution "Since $u$ and $w$ are orthogonal vectors, we have that $u\\cdot w=0.$ Therefore, using linearity of the dot product to expand the parentheses, we have\n\n$$\n\\begin{aligned}(w+v)\\cdot (2u+3w) & =2(w\\cdot u)+2(v\\cdot u)+3(w\\cdot w)+3(v\\cdot w) \\\\  & =0+2(v\\cdot u)+3(w\\cdot w)+3(v\\cdot w) \\\\  & =2(v\\cdot u)+3(w\\cdot w)+3(v\\cdot w) \\\\  & =2(-4\\cdot 5+(-2)\\cdot 1+2\\cdot (-3)+(-4)\\cdot 3) \\\\  & +3(1\\cdot 1+(-5)\\cdot (-5)+2\\cdot 2+2\\cdot 2) \\\\  & +3(-4\\cdot 1+(-2)\\cdot (-5)+2\\cdot 2+(-4)\\cdot 2) \\\\  & =2(-40)+3(34)+3(2) \\\\  & =-80+102+6 \\\\  & =28.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186342160 :knowledge-point/_questions [{:db/id #edb/ref 17592186133824 :knowledge-point/id #uuid "837e0fa4-b8d3-59c1-87c7-44317adafaf9" :knowledge-point/title "Factoring a Constant Out of the Norm"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "160738a7-be12-58cf-a80f-a94a6a2f1227" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186339322} {:answer/id #uuid "1d09c49a-a2d4-5104-9f39-aeb7d04a9c7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186339380} {:answer/id #uuid "27b08816-b56d-56af-836b-7def3de74374" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186339471} {:answer/id #uuid "5f9046e3-4b75-5ec7-85ea-9c533359e0ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{5}" :db/id #edb/ref 17592186339978} {:answer/id #uuid "f5b4b4ce-5fc0-52c4-b98f-6b5653f025a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186341296}] :answer-field/correct {:answer/id #uuid "27b08816-b56d-56af-836b-7def3de74374" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186339471} :answer-field/id #uuid "5b4d815c-aca6-5656-b032-a10aa3df9d2c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341542}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2c5e4c59-1c43-52e6-80bc-95dc392cac10" :question/math-academy-id "q-74131" :question/problem "Given the vector $w=\\begin{bmatrix}-2 \\\\ -4 \\\\ 2 \\\\ 1\\end{bmatrix}$, find $‖-\\frac{w}{5}‖.$" :question/worked-solution "Remember that we can factor a constant out of the norm, provided that we take the absolute value of the constant:\n\n$$\n‖kw‖=|k|\\cdot ‖w‖\n$$\n\nUsing this fact and the formula for the norm, we have\n\n$$\n\\begin{aligned}‖-\\frac{w}{5}‖ & =|-\\frac{1}{5}|\\cdot ‖w‖ \\\\  & =\\frac{1}{5}\\sqrt{{w}_{1}^{2}+{w}_{2}^{2}+{w}_{3}^{2}+{w}_{4}^{2}} \\\\  & =\\frac{1}{5}\\sqrt{(-2)^{2}+(-4)^{2}+{2}^{2}+{1}^{2}} \\\\  & =\\frac{1}{5}\\sqrt{4+16+4+1} \\\\  & =\\frac{1}{5}\\sqrt{25} \\\\  & =\\frac{1}{5}\\cdot 5 \\\\  & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186134541 :knowledge-point/_questions [{:db/id #edb/ref 17592186133727 :knowledge-point/id #uuid "7b0ce833-e045-5aff-94a4-f9ad56cdb904" :knowledge-point/title "Computing a CDF Given a PDF That’s Nonzero Over All Real Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84639246-60cf-50d4-874a-b2166ddf8829" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2} - \\frac{e^{-x/2}}{2}" :db/id #edb/ref 17592186133285} {:answer/id #uuid "a5c60b0a-4da8-5fa8-93b6-45d924a57ba3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1 - \\frac{e^{-x/2}}{2}" :db/id #edb/ref 17592186133286} {:answer/id #uuid "e2e78026-6d4e-5180-baaf-d3fa1dae931e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{e^{-x/2}}{2} + \\frac{1}{2}" :db/id #edb/ref 17592186133287} {:answer/id #uuid "5d0e3bb7-c3a7-5606-b66c-0257d6a52f35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{e^{-x/2}}{2}" :db/id #edb/ref 17592186133288} {:answer/id #uuid "7d27c7df-0148-58fb-bf9f-35c06f77e520" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{e^{-x/2}}{2} - 1" :db/id #edb/ref 17592186133289}] :answer-field/id #uuid "d29670cd-928f-556c-8bb7-ed0713850686" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186133284}] :question/id #uuid "19449960-eb0d-5a46-a0bc-2a9ba0310c4e" :question/math-academy-id "q-89726" :question/problem "Given that the random variable $X$ has the probability density function\n$f(x) = \\frac{e^{-\\mid x/2 \\mid}}{4}, x ∈ (- ∞, ∞)$,\nits cumulative distribution function is\n$F(x) = {\\frac{e^{x/2}}{2},\\begin{vmatrix}x < 0 \\\\ h(x),\\end{vmatrix}x \\ge 0$.\nFind the function $h(x)$."}]}
