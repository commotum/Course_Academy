#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186511630} :activity/id #uuid "c1660eca-e139-5686-9782-99e1cae0d92e" :activity/steps [{:db/id #edb/ref 17592186511602 :step/content {:db/id #edb/ref 17592186511559 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4617d3d0-3ffa-59f8-bebe-9f1b4563ee42" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(¬P∨R)∧Q" :db/id #edb/ref 17592186510939} {:answer/id #uuid "62bb9ba1-65af-5dbd-86ad-fd392199db41" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬P∨(Q∧R)" :db/id #edb/ref 17592186510991} {:answer/id #uuid "7189fd7d-69c5-59f4-9504-860c0442c666" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(¬P∨Q)∧R" :db/id #edb/ref 17592186511018} {:answer/id #uuid "9a4ce621-af37-5381-8d15-204b6ac865ce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(¬P∨Q)∨R" :db/id #edb/ref 17592186511103} {:answer/id #uuid "cf19757d-7c06-5aab-9d24-02031f634cd9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(¬P∧Q)∨R" :db/id #edb/ref 17592186511213}] :answer-field/correct {:db/id #edb/ref 17592186510939} :answer-field/id #uuid "06d4bdc0-e1ff-51f8-8af7-e05172cc66eb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186511312}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d785d990-0971-50ad-9ff0-c1525a2beb2a" :question/math-academy-id "q-128641" :question/problem "Which statement is equivalent to $(¬P∧Q)∨(R∧Q)?$" :question/worked-solution "We can factor out the conjunction with $Q,$ as follows:\n\n$$\n(¬P∧Q)∨(R∧Q)≡(¬P∨R)∧Q\n$$"} :step/id #uuid "282fa0dd-941b-516f-838f-7d24582c01b9"} {:db/id #edb/ref 17592186511604 :step/content {:db/id #edb/ref 17592186511502 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "135c1c58-72fd-5e33-bb89-e656d31fd58a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "13" :db/id #edb/ref 17592186510820} {:answer/id #uuid "8b3283bc-9a97-5ab1-beab-d6945922e38d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186511070} {:answer/id #uuid "8f64f0ed-c125-50ec-80b4-0baad2e5331e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "19" :db/id #edb/ref 17592186511077} {:answer/id #uuid "8fdbc633-5f94-527c-beb7-ec30a2b7cea8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186511079} {:answer/id #uuid "f93f673f-1cdf-5fcb-8a52-d4d7a60f012f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186511293}] :answer-field/correct {:db/id #edb/ref 17592186510820} :answer-field/id #uuid "cb74bb6d-eb9e-5168-b33b-f718103e0618" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186511423}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "62a31be5-1f88-5fce-bc3d-c7a604a6e638" :question/math-academy-id "q-72402" :question/problem "${\\sum }_{i=1}^{3}{\\sum }_{j=1}^{2}({i}^{2}-{j}^{2})=$" :question/worked-solution "First, we write out the inner summation by summing over the index $j:$\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{3}{\\sum }_{j=1}^{2}({i}^{2}-{j}^{2}) & ={\\sum }_{i=1}^{3}[{\\sum }_{j=1}^{2}({i}^{2}-{j}^{2})] \\\\  & ={\\sum }_{i=1}^{3}(({i}^{2}-{1}^{2})+({i}^{2}-{2}^{2})) \\\\  & ={\\sum }_{i=1}^{3}(({i}^{2}-1)+({i}^{2}-4)) \\\\  & ={\\sum }_{i=1}^{3}(2{i}^{2}-5)\\end{aligned}\n$$\n\nNext, we sum over the index $i:$\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{3}(2{i}^{2}-5) & =(2(1)^{2}-5)+(2(2)^{2}-5)+(2(3)^{2}-5) \\\\  & =-3+3+13 \\\\  & =13\\end{aligned}\n$$"} :step/id #uuid "2ba69236-63ce-5e86-bc2d-fc9e6a6ed08f" :step/next {:db/id #edb/ref 17592186511639}} {:db/id #edb/ref 17592186511607 :step/content {:db/id #edb/ref 17592186511527 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10f69397-caa8-5d90-9585-243065e0aedd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186510814} {:answer/id #uuid "155ac80b-d257-59db-8d11-526c13b72b8a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186510828} {:answer/id #uuid "1ab35478-39a1-5c45-b7c4-35b9df820448" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{5}" :db/id #edb/ref 17592186510843} {:answer/id #uuid "999ce95f-9709-5859-80e2-0586b0162a35" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186511102} {:answer/id #uuid "d870d643-7767-5376-bad6-e82c7fce52c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186511225}] :answer-field/correct {:db/id #edb/ref 17592186510828} :answer-field/id #uuid "e4c5e0e7-c0ac-54ef-a1ca-a2167b6452cc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186511437}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8da6073f-aed1-5284-a635-95231dda9375" :question/math-academy-id "q-152896" :question/problem "A continuous random variable $X$ has the probability density function \n\n$$\nf(x)=3{x}^{2},\\,0\\le x\\le 1.\n$$\n\nCalculate $\\text{E}[{X}^{2}].$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ the expected value of ${X}^{2}$ is given by\n\n$$\n\\text{E}[{X}^{2}]={\\int }_{S}{x}^{2}\\cdot f(x)\\,\\text{d}x.\n$$\n\nWe compute the expected value of ${X}^{2}$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{0}^{1}{x}^{2}\\cdot 3{x}^{2}\\,\\text{d}x \\\\  & =3{\\int }_{0}^{1}{x}^{4}\\,\\text{d}x \\\\  & =\\frac{3}{5}\\,{x}^{5}\\,{|}_{0}^{1} \\\\  & =\\frac{3}{5}(1-0) \\\\  & =\\frac{3}{5}\\end{aligned}\n$$"} :step/id #uuid "33347817-cc49-5766-869f-ba7c79f13e79" :step/next {:db/id #edb/ref 17592186511602}} {:db/id #edb/ref 17592186511630 :step/content {:db/id #edb/ref 17592186134541 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "128e3b85-4be0-58d5-9120-cf5364e7369e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}-\\frac{{e}^{-x/2}}{2}" :db/id #edb/ref 17592186510819} {:answer/id #uuid "82c39e58-8d46-563b-b847-882b5527d6e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{e}^{-x/2}}{2}" :db/id #edb/ref 17592186511050} {:answer/id #uuid "9b72f51e-b7fa-5eaa-b4a9-881ec5d3b1ce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{e}^{-x/2}}{2}-1" :db/id #edb/ref 17592186511108} {:answer/id #uuid "b905210f-a059-572c-8e25-2b36e139ca53" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-\\frac{{e}^{-x/2}}{2}" :db/id #edb/ref 17592186511162} {:answer/id #uuid "c09d67cf-c692-53b9-9009-9755c3847a2d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{e}^{-x/2}}{2}+\\frac{1}{2}" :db/id #edb/ref 17592186511181}] :answer-field/correct {:db/id #edb/ref 17592186511162} :answer-field/id #uuid "d29670cd-928f-556c-8bb7-ed0713850686" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186133284}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "19449960-eb0d-5a46-a0bc-2a9ba0310c4e" :question/math-academy-id "q-89726" :question/problem "Given that the random variable $X$ has the probability density function\n\n$$\nf(x)=\\frac{{e}^{-|x/2|}}{4},\\,x\\in (-\\infty ,\\infty ),\n$$\n\nits cumulative distribution function is \n\n$$\nF(x)=\\{\\begin{aligned}\\frac{{e}^{x/2}}{2},\\, & x<0 \\\\ h(x),\\, & x\\ge 0.\\end{aligned}\n$$\n\nFind the function $h(x).$" :question/worked-solution "Since our random variable $X$ has a probability distribution function $f(x)$ that involves an absolute value, the cumulative distribution function takes the following form:\n\n$$\nF(x)=P(X\\le x)=\\{\\begin{aligned}{\\int }_{-\\infty }^{x}\\frac{{e}^{t/2}}{4}\\,\\text{d}t, & x<0 \\\\ {\\int }_{-\\infty }^{0}\\frac{{e}^{t/2}}{4}\\,\\text{d}t+{\\int }_{0}^{x}\\frac{{e}^{-t/2}}{4}\\,\\text{d}t, & x\\ge 0\\end{aligned}\n$$\n\nLet's compute the integrals.\n\n- If $x\\le 0,$ we have\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{x}\\frac{{e}^{t/2}}{4}\\,\\text{d}t & ={\\frac{{e}^{t/2}}{2}|}_{-\\infty }^{x} \\\\  & =\\frac{{e}^{x/2}}{2},\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}\\frac{{e}^{t/2}}{4}\\,\\text{d}t & ={\\frac{{e}^{t/2}}{2}|}_{x=0} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\n- If $x>0,$ we have\n\n$$\n\\begin{aligned}{\\int }_{0}^{x}\\frac{{e}^{-t/2}}{4}\\,\\text{d}t & =-{\\frac{{e}^{-t/2}}{2}|}_{0}^{x} \\\\  & =-\\frac{{e}^{-x/2}}{2}+\\frac{1}{2}.\\end{aligned}\n$$\n\nAs a result, we get\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}\\frac{{e}^{-t/2}}{4}\\,\\text{d}t+{\\int }_{0}^{x}\\frac{{e}^{-t/2}}{4}\\,\\text{d}t & =\\frac{1}{2}+(-\\frac{{e}^{-x/2}}{2}+\\frac{1}{2}) \\\\  & =1-\\frac{{e}^{-x/2}}{2}.\\end{aligned}\n$$\n\nSo, the cumulative distribution function is given by\n\n$$\nF(x)=\\{\\begin{aligned}\\frac{{e}^{x/2}}{2}, & x<0 \\\\ 1-\\frac{{e}^{-x/2}}{2}, & x\\ge 0.\\end{aligned}\n$$"} :step/id #uuid "773ecc3f-347e-51a4-aa4e-8e6fe98247d8" :step/next {:db/id #edb/ref 17592186511604}} {:db/id #edb/ref 17592186511639 :step/content {:db/id #edb/ref 17592186511507 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14d3b9a6-b42e-5d81-b5e8-d7e65c357f71" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186510826} {:answer/id #uuid "5a089876-2b6c-5a99-9e81-d189370977ea" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186510972} {:answer/id #uuid "6e02d051-6b0a-5a1c-8d4f-65d665e53a26" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186511009} {:answer/id #uuid "b1e669dd-ebc9-5d9b-a6c3-bf1f63c51806" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186511150} {:answer/id #uuid "d63d1670-ebb4-54f4-afea-a48835538de1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186511221}] :answer-field/correct {:db/id #edb/ref 17592186511150} :answer-field/id #uuid "993bd62a-640e-5656-8035-d20d8bad796e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186511391}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "6d3ae80f-587f-5674-9679-5efb33bf0d2c" :question/math-academy-id "q-157227" :question/problem "Consider the following vectors:\n\n$$\n{a}_{1}=[\\begin{aligned}4 \\\\ -1 \\\\ 0\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}0 \\\\ 6 \\\\ 0\\end{aligned}],\\,{a}_{3}=[\\begin{aligned}1 \\\\ 2 \\\\ 5\\end{aligned}].\n$$\n\nWhich of the following statements are true?\n\nI. $-3{a}_{1}+{a}_{2}+2{a}_{3}=0.$\n\nII. ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ only if ${x}_{1}={x}_{2}={x}_{3}=0.$\n\nIII. The set $\\{{a}_{1},{a}_{2},{a}_{3}\\}$ is linearly independent." :question/worked-solution "We say that three vectors ${v}_{1},{v}_{2}$ and ${v}_{3}$ are *linearly independent* if the only solution to the equation\n\n$$\n{x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}=0\n$$\n\nis ${x}_{1}={x}_{2}={x}_{3}=0.$ Otherwise, the vectors are *linearly dependent*.\n\nWith that in mind, let's look at each statement in turn.\n\n- Statement I is false. Indeed:\n\n$$\n\\begin{aligned}-3{a}_{1}+{a}_{2}+2{a}_{3} & =-3[\\begin{aligned}4 \\\\ -1 \\\\ 0\\end{aligned}]+[\\begin{aligned}0 \\\\ 6 \\\\ 0\\end{aligned}]+2[\\begin{aligned}1 \\\\ 2 \\\\ 5\\end{aligned}] \\\\  & =[\\begin{aligned}-12 \\\\ 3 \\\\ 0\\end{aligned}]+[\\begin{aligned}0 \\\\ 6 \\\\ 0\\end{aligned}]+[\\begin{aligned}2 \\\\ 4 \\\\ 10\\end{aligned}] \\\\  & =[\\begin{aligned}-12+0+2 \\\\ 3+6+4 \\\\ 0+0+10\\end{aligned}] \\\\  & =[\\begin{aligned}-10 \\\\ 13 \\\\ 10\\end{aligned}] \\\\  & \\ne 0\\end{aligned}\n$$\n\n- Statement II is true. The equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ corresponds to the system\n\n$$\n\\{\\begin{aligned}4{x}_{1}+{x}_{3}=0 \\\\ -{x}_{1}+6{x}_{2}+2{x}_{3}=0 \\\\ 5{x}_{3}=0.\\end{aligned}\n$$\n\nNotice that we can reorder the equations in this system as follows:\n\n$$\n\\{\\begin{aligned}-{x}_{1}+6{x}_{2}+2{x}_{3}=0 \\\\ 4{x}_{1}+{x}_{3}=0 \\\\ 5{x}_{3}=0\\end{aligned}\n$$\n\nSolving this system using back substitution, we find that the solution is ${x}_{1}={x}_{2}={x}_{3}=0.$\n\n- Statement III is true. Since statement II is true, the set $\\{{a}_{1},{a}_{2},{a}_{3}\\}$ is linearly independent.\n\nTherefore, the correct answer is \"II and III only.\""} :step/id #uuid "8d34645a-0ab4-52e4-8b35-bc0e3d610aa7" :step/next {:db/id #edb/ref 17592186511640}} {:db/id #edb/ref 17592186511640 :step/content {:db/id #edb/ref 17592186342160 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "160738a7-be12-58cf-a80f-a94a6a2f1227" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186339322} {:answer/id #uuid "1d09c49a-a2d4-5104-9f39-aeb7d04a9c7d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186339380} {:answer/id #uuid "27b08816-b56d-56af-836b-7def3de74374" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186339471} {:answer/id #uuid "5f9046e3-4b75-5ec7-85ea-9c533359e0ed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{5}" :db/id #edb/ref 17592186339978} {:answer/id #uuid "f5b4b4ce-5fc0-52c4-b98f-6b5653f025a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186341296}] :answer-field/correct {:db/id #edb/ref 17592186339471} :answer-field/id #uuid "5b4d815c-aca6-5656-b032-a10aa3df9d2c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341542}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2c5e4c59-1c43-52e6-80bc-95dc392cac10" :question/math-academy-id "q-74131" :question/problem "Given the vector $w=\\begin{bmatrix}-2 \\\\ -4 \\\\ 2 \\\\ 1\\end{bmatrix}$, find $‖-\\frac{w}{5}‖.$" :question/worked-solution "Remember that we can factor a constant out of the norm, provided that we take the absolute value of the constant:\n\n$$\n‖kw‖=|k|\\cdot ‖w‖\n$$\n\nUsing this fact and the formula for the norm, we have\n\n$$\n\\begin{aligned}‖-\\frac{w}{5}‖ & =|-\\frac{1}{5}|\\cdot ‖w‖ \\\\  & =\\frac{1}{5}\\sqrt{{w}_{1}^{2}+{w}_{2}^{2}+{w}_{3}^{2}+{w}_{4}^{2}} \\\\  & =\\frac{1}{5}\\sqrt{(-2)^{2}+(-4)^{2}+{2}^{2}+{1}^{2}} \\\\  & =\\frac{1}{5}\\sqrt{4+16+4+1} \\\\  & =\\frac{1}{5}\\sqrt{25} \\\\  & =\\frac{1}{5}\\cdot 5 \\\\  & =1.\\end{aligned}\n$$"} :step/id #uuid "8fdb4546-c1ce-56f8-99f7-175189831b5c" :step/next {:db/id #edb/ref 17592186511674}} {:db/id #edb/ref 17592186511674 :step/content {:db/id #edb/ref 17592186272029 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "856764cd-371b-5661-95e2-1ca7d73c0b46" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "13" :db/id #edb/ref 17592186270421} {:answer/id #uuid "b3ae8646-b264-53b3-b5c3-a47ea6c1e44f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "28" :db/id #edb/ref 17592186270871} {:answer/id #uuid "b7bab78e-4f41-5e95-8013-7c9905aaa3eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-62" :db/id #edb/ref 17592186270895} {:answer/id #uuid "ee6b0155-53c8-5e6a-87f6-c3c6555e1651" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-12" :db/id #edb/ref 17592186271361} {:answer/id #uuid "f443c93c-ad87-527d-95fb-af4ea2a24b95" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-58" :db/id #edb/ref 17592186271411}] :answer-field/correct {:db/id #edb/ref 17592186270871} :answer-field/id #uuid "853c38fa-0fbb-5a69-95c8-64b42bef328c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186271740}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "a7f3874f-2914-5813-be9d-8b4e590254ca" :question/math-academy-id "q-140125" :question/problem "Let $u=\\begin{bmatrix}5 \\\\ 1 \\\\ -3 \\\\ 3\\end{bmatrix},v=\\begin{bmatrix}-4 \\\\ -2 \\\\ 2 \\\\ -4\\end{bmatrix}$ and $w=\\begin{bmatrix}1 \\\\ -5 \\\\ 2 \\\\ 2\\end{bmatrix}$ be vectors such that $u\\,⊥\\,w.$ Find $(w+v)\\cdot (2u+3w).$" :question/worked-solution "Since $u$ and $w$ are orthogonal vectors, we have that $u\\cdot w=0.$ Therefore, using linearity of the dot product to expand the parentheses, we have\n\n$$\n\\begin{aligned}(w+v)\\cdot (2u+3w) & =2(w\\cdot u)+2(v\\cdot u)+3(w\\cdot w)+3(v\\cdot w) \\\\  & =0+2(v\\cdot u)+3(w\\cdot w)+3(v\\cdot w) \\\\  & =2(v\\cdot u)+3(w\\cdot w)+3(v\\cdot w) \\\\  & =2(-4\\cdot 5+(-2)\\cdot 1+2\\cdot (-3)+(-4)\\cdot 3) \\\\  & +3(1\\cdot 1+(-5)\\cdot (-5)+2\\cdot 2+2\\cdot 2) \\\\  & +3(-4\\cdot 1+(-2)\\cdot (-5)+2\\cdot 2+(-4)\\cdot 2) \\\\  & =2(-40)+3(34)+3(2) \\\\  & =-80+102+6 \\\\  & =28.\\end{aligned}\n$$"} :step/id #uuid "e8e35945-97d6-5cc1-b14c-bebae6d5504a" :step/next {:db/id #edb/ref 17592186511607}}] :activity/title "Quiz 5" :activity/type {:db/id #edb/ref 17592186045460 :db/ident :activity.type/assessment} :db/id #edb/ref 17592186510769}]}
