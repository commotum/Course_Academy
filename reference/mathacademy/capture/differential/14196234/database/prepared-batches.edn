s "question-6d3ae80f-587f-5674-9679-5efb33bf0d2c"] ["question-8da6073f-aed1-5284-a635-95231dda9375" :question/id #uuid "8da6073f-aed1-5284-a635-95231dda9375"] ["question-8da6073f-aed1-5284-a635-95231dda9375" :question/math-academy-id "q-152896"] ["question-8da6073f-aed1-5284-a635-95231dda9375" :question/problem "A continuous random variable $X$ has the probability density function \n\n$$\nf(x)=3{x}^{2},\\,0\\le x\\le 1.\n$$\n\nCalculate $\\text{E}[{X}^{2}].$"] ["question-8da6073f-aed1-5284-a635-95231dda9375" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ the expected value of ${X}^{2}$ is given by\n\n$$\n\\text{E}[{X}^{2}]={\\int }_{S}{x}^{2}\\cdot f(x)\\,\\text{d}x.\n$$\n\nWe compute the expected value of ${X}^{2}$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{0}^{1}{x}^{2}\\cdot 3{x}^{2}\\,\\text{d}x \\\\  & =3{\\int }_{0}^{1}{x}^{4}\\,\\text{d}x \\\\  & =\\frac{3}{5}\\,{x}^{5}\\,{|}_{0}^{1} \\\\  & =\\frac{3}{5}(1-0) \\\\  & =\\frac{3}{5}\\end{aligned}\n$$"] ["question-8da6073f-aed1-5284-a635-95231dda9375" :question/difficulty :question.difficulty/easy] ["answer-field-e4c5e0e7-c0ac-54ef-a1ca-a2167b6452cc" :answer-field/id #uuid "e4c5e0e7-c0ac-54ef-a1ca-a2167b6452cc"] ["answer-10f69397-caa8-5d90-9585-243065e0aedd" :answer/id #uuid "10f69397-caa8-5d90-9585-243065e0aedd"] ["answer-10f69397-caa8-5d90-9585-243065e0aedd" :answer/type :answer.type/math] ["answer-10f69397-caa8-5d90-9585-243065e0aedd" :answer/value "3"] ["answer-d870d643-7767-5376-bad6-e82c7fce52c8" :answer/id #uuid "d870d643-7767-5376-bad6-e82c7fce52c8"] ["answer-d870d643-7767-5376-bad6-e82c7fce52c8" :answer/type :answer.type/math] ["answer-d870d643-7767-5376-bad6-e82c7fce52c8" :answer/value "\\frac{1}{5}"] ["answer-155ac80b-d257-59db-8d11-526c13b72b8a" :answer/id #uuid "155ac80b-d257-59db-8d11-526c13b72b8a"] ["answer-155ac80b-d257-59db-8d11-526c13b72b8a" :answer/type :answer.type/math] ["answer-155ac80b-d257-59db-8d11-526c13b72b8a" :answer/value "\\frac{3}{5}"] ["answer-999ce95f-9709-5859-80e2-0586b0162a35" :answer/id #uuid "999ce95f-9709-5859-80e2-0586b0162a35"] ["answer-999ce95f-9709-5859-80e2-0586b0162a35" :answer/type :answer.type/math] ["answer-999ce95f-9709-5859-80e2-0586b0162a35" :answer/value "\\frac{5}{3}"] ["answer-1ab35478-39a1-5c45-b7c4-35b9df820448" :answer/id #uuid "1ab35478-39a1-5c45-b7c4-35b9df820448"] ["answer-1ab35478-39a1-5c45-b7c4-35b9df820448" :answer/type :answer.type/math] ["answer-1ab35478-39a1-5c45-b7c4-35b9df820448" :answer/value "\\frac{9}{5}"] ["answer-field-e4c5e0e7-c0ac-54ef-a1ca-a2167b6452cc" :answer-field/key "selection"] ["answer-field-e4c5e0e7-c0ac-54ef-a1ca-a2167b6452cc" :answer-field/type :answer-field.type/radio] ["answer-field-e4c5e0e7-c0ac-54ef-a1ca-a2167b6452cc" :answer-field/correct "answer-155ac80b-d257-59db-8d11-526c13b72b8a"] ["answer-field-e4c5e0e7-c0ac-54ef-a1ca-a2167b6452cc" :answer-field/choices "answer-10f69397-caa8-5d90-9585-243065e0aedd"] ["answer-field-e4c5e0e7-c0ac-54ef-a1ca-a2167b6452cc" :answer-field/choices "answer-d870d643-7767-5376-bad6-e82c7fce52c8"] ["answer-field-e4c5e0e7-c0ac-54ef-a1ca-a2167b6452cc" :answer-field/choices "answer-155ac80b-d257-59db-8d11-526c13b72b8a"] ["answer-field-e4c5e0e7-c0ac-54ef-a1ca-a2167b6452cc" :answer-field/choices "answer-999ce95f-9709-5859-80e2-0586b0162a35"] ["answer-field-e4c5e0e7-c0ac-54ef-a1ca-a2167b6452cc" :answer-field/choices "answer-1ab35478-39a1-5c45-b7c4-35b9df820448"] ["question-8da6073f-aed1-5284-a635-95231dda9375" :question/answer-fields "answer-field-e4c5e0e7-c0ac-54ef-a1ca-a2167b6452cc"] [17592186157394 :knowledge-point/questions "question-8da6073f-aed1-5284-a635-95231dda9375"] ["question-d785d990-0971-50ad-9ff0-c1525a2beb2a" :question/id #uuid "d785d990-0971-50ad-9ff0-c1525a2beb2a"] ["question-d785d990-0971-50ad-9ff0-c1525a2beb2a" :question/math-academy-id "q-128641"] ["question-d785d990-0971-50ad-9ff0-c1525a2beb2a" :question/problem "Which statement is equivalent to $(¬P∧Q)∨(R∧Q)?$"] ["question-d785d990-0971-50ad-9ff0-c1525a2beb2a" :question/worked-solution "We can factor out the conjunction with $Q,$ as follows:\n\n$$\n(¬P∧Q)∨(R∧Q)≡(¬P∨R)∧Q\n$$"] ["question-d785d990-0971-50ad-9ff0-c1525a2beb2a" :question/difficulty :question.difficulty/easy] ["answer-field-06d4bdc0-e1ff-51f8-8af7-e05172cc66eb" :answer-field/id #uuid "06d4bdc0-e1ff-51f8-8af7-e05172cc66eb"] ["answer-cf19757d-7c06-5aab-9d24-02031f634cd9" :answer/id #uuid "cf19757d-7c06-5aab-9d24-02031f634cd9"] ["answer-cf19757d-7c06-5aab-9d24-02031f634cd9" :answer/type :answer.type/math] ["answer-cf19757d-7c06-5aab-9d24-02031f634cd9" :answer/value "(¬P∧Q)∨R"] ["answer-7189fd7d-69c5-59f4-9504-860c0442c666" :answer/id #uuid "7189fd7d-69c5-59f4-9504-860c0442c666"] ["answer-7189fd7d-69c5-59f4-9504-860c0442c666" :answer/type :answer.type/math] ["answer-7189fd7d-69c5-59f4-9504-860c0442c666" :answer/value "(¬P∨Q)∧R"] ["answer-9a4ce621-af37-5381-8d15-204b6ac865ce" :answer/id #uuid "9a4ce621-af37-5381-8d15-204b6ac865ce"] ["answer-9a4ce621-af37-5381-8d15-204b6ac865ce" :answer/type :answer.type/math] ["answer-9a4ce621-af37-5381-8d15-204b6ac865ce" :answer/value "(¬P∨Q)∨R"] ["answer-4617d3d0-3ffa-59f8-bebe-9f1b4563ee42" :answer/id #uuid "4617d3d0-3ffa-59f8-bebe-9f1b4563ee42"] ["answer-4617d3d0-3ffa-59f8-bebe-9f1b4563ee42" :answer/type :answer.type/math] ["answer-4617d3d0-3ffa-59f8-bebe-9f1b4563ee42" :answer/value "(¬P∨R)∧Q"] ["answer-62bb9ba1-65af-5dbd-86ad-fd392199db41" :answer/id #uuid "62bb9ba1-65af-5dbd-86ad-fd392199db41"] ["answer-62bb9ba1-65af-5dbd-86ad-fd392199db41" :answer/type :answer.type/math] ["answer-62bb9ba1-65af-5dbd-86ad-fd392199db41" :answer/value "¬P∨(Q∧R)"] ["answer-field-06d4bdc0-e1ff-51f8-8af7-e05172cc66eb" :answer-field/key "selection"] ["answer-field-06d4bdc0-e1ff-51f8-8af7-e05172cc66eb" :answer-field/type :answer-field.type/radio] ["answer-field-06d4bdc0-e1ff-51f8-8af7-e05172cc66eb" :answer-field/correct "answer-4617d3d0-3ffa-59f8-bebe-9f1b4563ee42"] ["answer-