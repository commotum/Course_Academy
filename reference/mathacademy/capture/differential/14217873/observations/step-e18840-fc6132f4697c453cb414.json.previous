MAIN-32\"></use>\n <use xlink:href=\"#E2-MJMAIN-2E\" x=\"500\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-32\" x=\"779\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-37\" x=\"1279\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-32\" x=\"1780\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E2-MJMAIN-2C\" x=\"4639\" y=\"0\"></use>\n<g transform=\"translate(7085,0)\">\n <use xlink:href=\"#E2-MJMATHI-3C3\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E2-MJMAIN-32\" x=\"808\" y=\"-213\"></use>\n</g>\n <use xlink:href=\"#E2-MJMAIN-3D\" x=\"8388\" y=\"0\"></use>\n<g transform=\"translate(9444,0)\">\n <use xlink:href=\"#E2-MJMAIN-32\"></use>\n <use xlink:href=\"#E2-MJMAIN-2E\" x=\"500\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-30\" x=\"779\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-33\" x=\"1279\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-31\" x=\"1780\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E2-MJMAIN-2C\" x=\"11725\" y=\"0\"></use>\n<g transform=\"translate(14170,0)\">\n <use xlink:href=\"#E2-MJMATHI-3C3\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E2-MJMAIN-33\" x=\"808\" y=\"-213\"></use>\n</g>\n <use xlink:href=\"#E2-MJMAIN-3D\" x=\"15473\" y=\"0\"></use>\n<g transform=\"translate(16529,0)\">\n <use xlink:href=\"#E2-MJMAIN-31\"></use>\n <use xlink:href=\"#E2-MJMAIN-2E\" x=\"500\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-36\" x=\"779\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-35\" x=\"1279\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-39\" x=\"1780\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-2E\" x=\"2280\" y=\"0\"></use>\n</g>\n</g>\n</svg></span></p>\n<p>Let us now compute the cumulative variance preserved for different numbers of components.</p>\n<ul>\n<li><p>The fraction of variance preserved by projecting the data onto the first principal component is \n<span class=\"mjpage mjpage__block\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"44.759ex\" height=\"10.176ex\" style=\"vertical-align: -6.171ex;\" viewBox=\"0 -1724.2 19271.3 4381.3\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-3-Title\">\n<title id=\"MathJax-SVG-3-Title\">\n\\dfrac{\\sigma_1^2}{\\sum\\limits_{i=1}^3 \\sigma_i^2} =\n\\dfrac{2.272^2}{2.272^2 + 2.031^2 + 1.659^2} \\approx 42.9\\%.\n</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E3-MJMATHI-3C3\" d=\"M184 -11Q116 -11 74 34T31 147Q31 247 104 333T274 430Q275 431 414 431H552Q553 430 555 429T559 427T562 425T565 422T567 420T569 416T570 412T571 407T572 401Q572 357 507 357Q500 357 490 357T476 358H416L421 348Q439 310 439 263Q439 153 359 71T184 -11ZM361 278Q361 358 276 358Q152 358 115 184Q114 180 114 178Q106 141 106 117Q106 67 131 47T188 26Q242 26 287 73Q316 103 334 153T356 233T361 278Z\"></path>\n<path stroke-width=\"1\" id=\"E3-MJMAIN-32\" d=\"M109 429Q82 429 66 447T50 491Q50 562 103 614T235 666Q326 666 387 610T449 465Q449 422 429 383T381 315T301 241Q265 210 201 149L142 93L218 92Q375 92 385 97Q392 99 409 186V189H449V186Q448 183 436 95T421 3V0H50V19V31Q50 38 56 46T86 81Q115 113 136 137Q145 147 170 174T204 211T233 244T261 278T284 308T305 340T320 369T333 401T340 431T343 464Q343 527 309 573T212 619Q179 619 154 602T119 569T109 550Q109 549 114 549Q132 549 151 535T170 489Q170 464 154 447T109 429Z\"></path>\n<path stroke-width=\"1\" id=\"E3-MJMAIN-31\" d=\"M213 578L200 573Q186 568 160 563T102 556H83V602H102Q149 604 189 617T245 641T273 663Q275 666 285 666Q294 666 302 660V361L303 61Q310 54 315 52T339 48T401 46H427V0H416Q395 3 257 3Q121 3 100 0H88V46H114Q136 46 152 46T177 47T193 50T201 52T207 57T213 61V578Z\"></path>\n<path stroke-width=\"1\" id=\"E3-MJSZ1-2211\" d=\"M61 748Q64 750 489 750H913L954 640Q965 609 976 579T993 533T999 516H979L959 517Q936 579 886 621T777 682Q724 700 655 705T436 710H319Q183 710 183 709Q186 706 348 484T511 259Q517 250 513 244L490 216Q466 188 420 134T330 27L149 -187Q149 -188 362 -188Q388 -188 436 -188T506 -189Q679 -189 778 -162T936