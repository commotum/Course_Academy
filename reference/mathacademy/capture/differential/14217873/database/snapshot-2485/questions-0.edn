5a8a-a096-4ec3499695fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "99.5%" :db/id #edb/ref 17592186528588} {:answer/id #uuid "ac253440-b7d5-519b-a983-1f68bd27a9cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "86.0%" :db/id #edb/ref 17592186528720}] :answer-field/correct {:answer/id #uuid "7adcdcf4-8f99-5a8a-a096-4ec3499695fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "99.5%" :db/id #edb/ref 17592186528588} :answer-field/id #uuid "ff4301ae-bf90-5f16-a0cd-99a316c4b8d2" :answer-field/key "field-7" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186529086}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e5a752c5-890a-5f08-b05f-1f3c318cda03" :question/math-academy-id "q-355955" :question/problem "Suppose we have a dataset consisting of $5$ datapoints with $3$ features in the form of the $5\\times 3$ matrix\n\n$$\nX=[\\begin{aligned}5.659 & 2.361 & 1.245 \\\\ 2.543 & 0.071 & -1.476 \\\\ -1.128 & -4.766 & -4.235 \\\\ 5.697 & -3.658 & -1.704 \\\\ 1.099 & -4.975 & -3.309\\end{aligned}]\n$$\n\nWe wish to reduce the dimensionality of the dataset while still preserving as much variance as possible.\n\nSelect the correct options in the following reasoning that walks through the process of reducing the dimensionality of the dataset.\n\nWe will use principal component analysis to reduce the dimensionality of the dataset. The first principal component is \n{{field-1}} \nwith the \n{{field-2}} \nvariance.\n\nThe second principal component is the direction in feature space \n{{field-3}} \nto the first\n{{field-4}}. \n\nIn order to reduce the dimensionality of the dataset, we will project the data onto the first few principal components, picking the number of components based on the amount of cumulative variance preserved.\n\nThe first step is to {{field-5}}.\n\nThe standardized data matrix is\n\n$$\n{X}_{\\text{std}}=[\\begin{aligned}0.98 & 1.40 & 1.50 \\\\ -0.08 & 0.70 & 0.20 \\\\ -1.32 & -0.79 & -1.12 \\\\ 0.99 & -0.45 & 0.09 \\\\ -0.57 & -0.85 & -0.67\\end{aligned}].\n$$\n\nThe SVD of the standardized data matrix is\n\n$$\n\\begin{aligned}{X}_{\\text{std}} & =UΣ{V}^{T},\\,\\text{where} \\\\ U & =[\\begin{aligned}-0.701 & 0.221 & -0.466 & 0.493 & 0.003 \\\\ -0.148 & 0.419 & 0.689 & 0.249 & 0.516 \\\\ 0.579 & 0.314 & -0.029 & 0.657 & -0.367 \\\\ -0.107 & -0.812 & 0.296 & 0.492 & -0.005 \\\\ 0.375 & -0.137 & -0.469 & 0.146 & 0.774\\end{aligned}], \\\\ Σ & =[\\begin{aligned}3.215 & 0 & 0 \\\\ 0 & 1.273 & 0 \\\\ 0 & 0 & 0.238 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}], \\\\ V & =[\\begin{aligned}-0.547 & -0.751 & 0.370 \\\\ -0.564 & 0.657 & 0.500 \\\\ -0.619 & 0.065 & -0.783\\end{aligned}].\\end{aligned}\n$$\n\nWe compute the cumulative variance preserved for different numbers of components.\n\nThe fraction of variance preserved by projecting the data onto the first principal component is \n{{field-6}}.\n\nThe fraction of variance preserved by projecting the data onto the first two principal components is \n{{field-7}}.\n\nIf we wish to preserve $90%$ of the variance, we should reduce the dataset to \n{{field-8}}.\n\nWriting ${v}_{1},{v}_{2},{v}_{3}$ for the columns of $V$ and ${u}_{1},{u}_{2},{u}_{3},{u}_{4},{u}_{5}$ for the columns of $U$, the reduced dataset is\n\n$$\n{X}_{\\text{red}}={{field-9}}.\n$$" :question/worked-solution "We will use principal component analysis to reduce the dimensionality of the dataset. The first principal component is $\\text{the direction in feature space}$ with the $\\text{most}$ variance.\n\nThe second principal component is the direction $\\text{orthogonal}$ to the first $\\text{principal component}.$\n\nIn order to reduce the dimensionality of the dataset, we will project the data onto the first few principal components, picking the number of components based on the amount of cumulative variance preserved.\n\nThe first step is to $\\text{standardize the data}.$\n\nThe standardized data matrix is\n\n$$\n{X}_{\\text{std}}=[\\begin{aligned}0.98 & 1.40 & 1.50 \\\\ -0.08 & 0.70 & 0.20 \\\\ -1.32 & -0.79 & -1.12 \\\\ 0.99 & -0.45 & 0.09 \\\\ -0.57 & -0.85 & -0.67\\end{aligned}].\n$$\n\nThe SVD of the standardized data matrix is\n\n$$\n\\begin{aligned}{X}_{\\text{std}} & =UΣ{V}^{T},\\,\\text{where} \\\\ U & =[\\begin{aligned}-0.701 & 0.221 & -0.466 & 0.493 & 0.003 \\\\ -0.148 & 0.419 & 0.689 & 0.249 & 0.516 \\\\ 0.579 & 0.314 & -0.029 & 0.657 & -0.367 \\\\ -0.107 & -0.812 & 0.296 & 0.492 & -0.005 \\\\ 0.375 & -0.137 & -0.469 & 0.146 & 0.774\\end{aligned}], \\\\ Σ & =[\\begin{aligned}3.215 & 0 & 0 \\\\ 0 & 1.273 & 0 \\\\ 0 & 0 & 0.238 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}], \\\\ V & =[\\begin{aligned}-0.547 & -0.751 & 0.370 \\\\ -0.564 & 0.657 & 0.500 \\\\ -0.619 & 0.065 & -0.783\\end{aligned}].\\end{aligned}\n$$\n\nWe compute the cumulative variance preserved for different numbers of components.\n\nThe variance along a principal component is equal to the corresponding eigenvalue of the covariance matrix, which is proportional to the square of the corresponding singular value of the data matrix.\n\n- The fraction of variance preserved by projecting the data onto the first principal component is \n\n$$\n\\frac{{3.215}^{2}}{{3.215}^{2}+{1.273}^{2}+{0.238}^{2}}≈86.0%.\n$$\n\n- The fraction of variance preserved by projecting the data onto the first two principal components is \n\n$$\n\\frac{{3.215}^{2}+{1.273}^{2}}{{3.215}^{2}+{1.273}^{2}+{0.238}^{2}}≈99.5%.\n$$\n\nThus, we have that \n\n- reducing the dataset to $1$ dimension would preserve $86.0%$ of the variance, while\n\n- reducing the dataset to $2$ dimensions would preserve $99.5%$ of the variance.\n\nIf we wish to preserve $90%$ of the variance, we should reduce the dataset to $2\\text{ dimensions}$ , since this is the minimum number of components that preserves at least $90%$ of the variance.\n\nWriting ${v}_{1},{v}_{2},{v}_{3}$ for the columns of $V$ and ${u}_{1},{u}_{2},{u}_{3},{u}_{4},{u}_{5}$ for the columns of $U$, the reduced dataset is\n\n$$\n{X}_{\\text{red}}={X}_{\\text{std}}\\cdot [\\begin{aligned}{v}_{1} & {v}_{2}\\end{aligned}],\n$$\n\nsince we need to project the data onto the first two principal components, which are the first two columns of $V.$\n\n**Note:** In order to invert the projection and interpret any further analysis in terms of the original features, we need to know the means and standard deviations of the original dataset $X.$ Additionally, in case we have more data, we can use the means and standard deviations of the original dataset to map the new data into the original feature space."}] [{:db/id #edb/ref 17592186529174 :knowledge-point/_questions [{:db/id #edb/ref 17592186204107 :knowledge-point/id #uuid "45f11c96-89e5-5662-81b6-06cff80a4cf2" :knowledge-point/title "Using PCA to Dimensionally Reduce an Uncentered Dataset"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f522d33-447f-5a33-87f8-afec283b06d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "the direction in feature space" :db/id #edb/ref 17592186528524} {:answer/id #uuid "e21e9b71-d5fe-5002-bbf9-c83a592a7e5c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "the datapoint" :db/id #edb/ref 17592186528856}] :answer-field/correct {:answer/id #uuid "5f522d33-447f-5a33-87f8-afec283b06d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "the direction in feature space" :db/id #edb/ref 17592186528524} :answer-field/id #uuid "1e39ffb1-f164-5926-be82-036b34a8c594" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186528955} {:answer-field/choices [{:answer/id #uuid "382eef9d-426a-51e6-9e4c-911bfc44034c" :answer/type 