37\"></mjx-c><mjx-c class=\"mjx-c38\"></mjx-c></mjx-mn><mjx-tstrut></mjx-tstrut></mjx-mtd></mjx-mtr><mjx-mtr><mjx-mtd style=\"padding-right: 0.5em; padding-top: 0.2em;\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c34\"></mjx-c><mjx-c class=\"mjx-c2E\"></mjx-c><mjx-c class=\"mjx-c30\"></mjx-c><mjx-c class=\"mjx-c38\"></mjx-c><mjx-c class=\"mjx-c38\"></mjx-c></mjx-mn><mjx-tstrut></mjx-tstrut></mjx-mtd><mjx-mtd style=\"padding-left: 0.5em; padding-right: 0.5em; padding-top: 0.2em;\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c34\"></mjx-c><mjx-c class=\"mjx-c2E\"></mjx-c><mjx-c class=\"mjx-c35\"></mjx-c><mjx-c class=\"mjx-c30\"></mjx-c><mjx-c class=\"mjx-c38\"></mjx-c></mjx-mn><mjx-tstrut></mjx-tstrut></mjx-mtd><mjx-mtd style=\"padding-left: 0.5em; padding-top: 0.2em;\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c35\"></mjx-c><mjx-c class=\"mjx-c2E\"></mjx-c><mjx-c class=\"mjx-c36\"></mjx-c><mjx-c class=\"mjx-c38\"></mjx-c><mjx-c class=\"mjx-c38\"></mjx-c></mjx-mn><mjx-tstrut></mjx-tstrut></mjx-mtd></mjx-mtr></mjx-itable></mjx-table></mjx-mtable><mjx-mo class=\"mjx-n\"><mjx-stretchy-v class=\"mjx-c5D\" style=\"height: 6.6em; vertical-align: -3.05em;\"><mjx-beg><mjx-c></mjx-c></mjx-beg><mjx-ext><mjx-c></mjx-c></mjx-ext><mjx-end><mjx-c></mjx-c></mjx-end><mjx-mark></mjx-mark></mjx-stretchy-v></mjx-mo></mjx-texatom></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mi>X</mi><mo>=</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">[</mo><mtable columnspacing=\"1em\" rowspacing=\"4pt\"><mtr><mtd><mo>−</mo><mn>2.506</mn></mtd><mtd><mn>4.309</mn></mtd><mtd><mn>6.738</mn></mtd></mtr><mtr><mtd><mn>0.552</mn></mtd><mtd><mn>4.174</mn></mtd><mtd><mn>1.558</mn></mtd></mtr><mtr><mtd><mn>0.175</mn></mtd><mtd><mn>3.635</mn></mtd><mtd><mn>2.487</mn></mtd></mtr><mtr><mtd><mn>1.127</mn></mtd><mtd><mn>4.541</mn></mtd><mtd><mn>5.878</mn></mtd></mtr><mtr><mtd><mn>4.088</mn></mtd><mtd><mn>4.508</mn></mtd><mtd><mn>5.688</mn></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow></math></mjx-assistive-mml></mjx-container></mjx-assistive-mml></mjx-container></mjx-assistive-mml></mjx-container></mjx-assistive-mml></mjx-container></mjx-assistive-mml></mjx-container></mjx-assistive-mml></mjx-container></mjx-assistive-mml></mjx-container></p>\n<p>We wish to reduce the dimensionality of the dataset while still preserving as much variance as possible.</p>\n<p>Select the correct options in the following reasoning that walks through the process of reducing the dimensionality of the dataset.</p>We will use principal component analysis to reduce the dimensionality of the dataset. The first principal component is \n<div id=\"selectList-355960-0\" class=\"selectList\" style=\"margin: 0px 4px 2px;\"><div class=\"selectListFrameDisabled correctSelection\" id=\"selectListFrame-355960-0\" style=\"width: 211px; height: 17px; line-height: 17px;\">the direction in feature space</div><div class=\"selectListOptions\" style=\"visibility: hidden; z-index: 1; left: 467px; top: 29867px;\"><div class=\"selectListOption selected\" style=\"height: 17px;\">the direction in feature space</div><div class=\"selectListOption\" style=\"height: 17px;\">the datapoint</div></div></div> \nwith the \n<div id=\"selectList-355960-1\" class=\"selectList\" style=\"margin: 0px 4px 2px;\"><div class=\"selectListFrameDisabled correctSelection\" id=\"selectListFrame-355960-1\" style=\"width: 51px; height: 17px; line-height: 17px;\">most</div><div class=\"selectListOptions\" style=\"visibility: hidden; z-index: 1; left: 762px; top: 29867px;\"><div class=\"selectListOption\" style=\"height: 17px;\">least</div><div class=\"selectListOption selected\" style=\"height: 17px;\">most</div></div></div> \nvariance.<span class=\"proofSection\"></span><span class=\"proofSection\"><p></p>The second principal component is the direction in feature space \n<div id=\"selectList-355960-2\" class=\"selectList\" style=\"margin: 0px 4px 2px;\"><div class=\"selectListFrameDisabled correctSelection\" id=\"selectListFrame-355960-2\" style=\"width: 89px; height: 17px; line-height: 17px;\">orthogonal</div><div class=\"selectListOptions\" style=\"visibility: hidden; z-index: 1; left: 807px; top: 29911px;\"><div class=\"selectListOption\" style=\"height: 17px;\">parallel</div><div class=\"selectListOption selected\" style=\"height: 17px;\">orthogonal</div></div></div> \nto the first\n<div id=\"selectList-355960-3\" class=\"selectList\" style=\"margin: 0px 4px 2px;\"><div class=\"selectListFrameDisabled correctSelection\" id=\"selectListFrame-355960-3\" style=\"width: 152px; height: 17px; line-height: 17px;\">principal component</div><div class=\"selectListOptions\" style=\"visibility: hidden; z-index: 1; left: 374px; top: 29946px;\"><div class=\"selectListOption\" style=\"height: 17px;\">datapoint</div><div class=\"selectListOption selected\" style=\"height: 17px;\">principal component</div></div></div>. </span><span class=\"proofSection\"></span><span class=\"proofSection\"><p></p>In order to reduce the dimensionality of the dataset, we will project the data onto the first few principal components, picking the number of components based on the amount of cumulative variance preserved.<p></p>The first step is to <div id=\"selectList-355960-4\" class=\"selectList\" style=\"margin: 0px;\"><div class=\"selectListFrameDisabled correctSelection\" id=\"selectListFrame-355960-4\" style=\"width: 222px; height: 17px; line-height: 17px;\">standardize the data</div><div class=\"selectListOptions\" style=\"visibility: hidden; z-index: 1; left: 493px; top: 30033px;\"><div class=\"selectListOption\" style=\"height: 17px;\">center the data</div><div class=\"selectListOption\" style=\"height: 17px;\">find the SVD of the data matrix</div><div class=\"selectListOption selected\" style=\"height: 17px;\">standardize the data</div></div></div>.</span><span class=\"proofSection\"></span><span class=\"proofSection\"><p></p>The standardized data matrix is<p></p><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" display=\"true\" tabindex=\"0\" ctxtmenu_counter=\"422\" style=\"font-size: 119.4%; position: relative;\"><mjx-math display=\"true\" class=\"MJX-TEX\" aria-hidden=\"true\" style=\"margin-left: 0px; margin-right: 0px;\"><mjx-msub><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D44B TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: -0.15em; margin-left: -0.024em;\"><mjx-texatom size=\"s\" texclass=\"ORD\"><mjx-mtext class=\"mjx-n\"><mjx-c class=\"mjx-c73\"></mjx-c><mjx-c class=\"mjx-c74\"></mjx-c><mjx-c class=\"mjx-c64\"></mjx-c></mjx-mtext></mjx-texatom></mjx-script></mjx-msub><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mrow space=\"4\"><mjx-mo class=\"mjx-n\"><mjx-stretchy-v class=\"mjx-c5B\" style=\"height: 6.6em; vertical-align: -3.05em;\"><mjx-beg><mjx-c></mjx-c></mjx-beg><mjx-ext><mjx-c></mjx-c></mjx-ext><mjx-end><mjx-c></mjx-c></mjx-end><mjx-mark></mjx-mark></mjx-stretchy-v></mjx-mo><mjx-mtable style=\"min-width: 9.668em;\"><mjx-table><mjx-itable><mjx-mtr><mjx-mtd style=\"padding-right: 0.5em; padding-bottom: 0.2em;\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2212\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c31\"></mjx-c><mjx-c class=\"mjx-c2E\"></mjx-c><mjx-c class=\"mjx-c33\"></mjx-c><mjx-c class=\"mjx-c35\"></mjx-c></mjx-mn><mjx-tstrut></mjx-tstrut></mjx-mtd><mjx-mtd style=\"padding-left: 0.5em; padding-right: 0.5em; padding-bottom: 0.2em;\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c30\"></mjx-c><mjx-c class=\"mjx-c2E\"></mjx-c><mjx-c class=\"mjx-c32\"></mjx-c><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn><mjx-tstrut></mjx-tstrut></mjx-mtd><mjx-mtd style=\"padding-left: 0.5em; padding-bottom: 0.2em;\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c30\"></mjx-c><mjx-c class=\"mjx-c2E\"></mjx-c><mjx-c class=\"mjx-c39\"></mjx-c><mjx-c class=\"mjx-c39\"></mjx-c></mjx-mn><mjx