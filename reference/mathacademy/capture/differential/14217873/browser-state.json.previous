      "assets": [],
      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14217873/observations/step-q355831-327b9d031a7b7def9acb.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14217873/observations/step-q355831-327b9d031a7b7def9acb.png",
      "source_url": "https://mathacademy.com/tasks/14217873/topics/5289/lesson",
      "captured_at": 1792018075.2037928,
      "math_academy_id": "q-355831",
