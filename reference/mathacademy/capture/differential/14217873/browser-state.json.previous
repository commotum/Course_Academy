      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14217873/observations/step-q355899-c839243c4b994964b80d.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14217873/observations/step-q355899-c839243c4b994964b80d.png",
