cel{{y}_{1}^{2}})+⋯+({y}_{n}^{2}-\\cancel{{y}_{n-1}^{2}}) \\\\  & =-{y}_{0}^{2}+{y}_{n}^{2} \\\\  & ={y}_{n}^{2}-{y}_{0}^{2} \\\\  & ={2}^{2}-{0}^{2} \\\\  & =4\\end{aligned}\n$$\n\nCombining our results, we finally arrive at\n\n$$\n{\\sum }_{i=1}^{m}Δ{x}_{i}\\cdot {\\sum }_{j=1}^{n}({y}_{j}+{y}_{j-1})Δ{y}_{j}=3\\cdot 4=12.\n$$"}] [{:db/id #edb/ref 17592186339124 :knowledge-point/_questions [{:db/id #edb/ref 17592186179722 :knowledge-point/id #uuid "9f913fab-d0b5-5e9e-b292-039afe4a148c" :knowledge-point/title "Computing a Double Sum Over a Rectangular Partition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f340918-7d6f-57a3-802c-2a1453e19f4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186336176} {:answer/id #uuid "1e6713dd-9c1e-5e34-9885-5b2724869b1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186336312} {:answer/id #uuid "23b4bd72-02b7-51b2-b68b-faa59bb1d133" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186336368} {:answer/id #uuid "7f353096-d48c-53d2-aa18-aad41c76beaa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186337186} {:answer/id #uuid "ed6bd1da-b395-52c6-a69f-b695cbeea7dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186338103}] :answer-field/correct {:answer/id #uuid "7f353096-d48c-53d2-aa18-aad41c76beaa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186337186} :answer-field/id #uuid "bc552339-f759-5a74-96f9-f40e0ccdedae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338616}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9f73aa4c-df24-5091-bd74-35aefea94a85" :question/math-academy-id "q-72476" :question/problem "Consider the following partitions:\n\n- ${P}_{1}=\\{{x}_{0},{x}_{1},…,{x}_{m}\\}$ is a partition of the interval $[0,1]$\n\n- ${P}_{2}=\\{{y}_{0},{y}_{1},…,{y}_{n}\\}$ is a partition of the interval $[1,2]$\n\nCalculate ${\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}3Δ{x}_{i}Δ{y}_{j},$ where $Δ{x}_{i}={x}_{i}-{x}_{i-1}$ and $Δ{y}_{j}={y}_{j}-{y}_{j-1}.$" :question/worked-solution "Using the constant multiple and product rules, we can write the summation as\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}3Δ{x}_{i}Δ{y}_{j} & =3{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}Δ{x}_{i}Δ{y}_{j} \\\\  & =3{\\sum }_{i=1}^{m}Δ{x}_{i}{\\sum }_{j=1}^{n}Δ{y}_{j}.\\end{aligned}\n$$\n\nNote that ${\\sum }_{i=1}^{m}Δ{x}_{i}$ and ${\\sum }_{j=1}^{n}Δ{y}_{j}$ are just the lengths of the intervals $[0,1]$ and $[1,2]$ respectively. So, we have\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}Δ{x}_{i} & =1-0=1, \\\\ {\\sum }_{j=1}^{n}Δ{y}_{j} & =2-1=1.\\end{aligned}\n$$\n\nCombining our results, we have \n\n$$\n3{\\sum }_{i=1}^{m}Δ{x}_{i}{\\sum }_{j=1}^{n}Δ{y}_{j}=3\\cdot 1\\cdot 1=3.\n$$"}] [{:db/id #edb/ref 17592186526001 :knowledge-point/_questions [{:db/id #edb/ref 17592186179666 :knowledge-point/id #uuid "d5ee41f2-7116-52f4-b1f7-923997d994ab" :knowledge-point/title "Computing a Double Sum Over a Rectangular Partition Using a Difference of Squares"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2288ceae-bccd-555e-852b-d54d20d7465a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186525285} {:answer/id #uuid "6d520518-024b-5c87-8d9b-bdd4f819d974" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186525485} {:answer/id #uuid "83857cd1-0447-5514-b59b-9e058c20cf67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "45" :db/id #edb/ref 17592186525537} {:answer/id #uuid "c724e10a-0795-560a-9303-b93484f316b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186525709} {:answer/id #uuid "f2208e57-a97a-50ba-a7cb-11e1e3dbad41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186525808}] :answer-field/correct {:answer/id #uuid "f2208e57-a97a-50ba-a7cb-11e1e3dbad41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186525808} :answer-field/id #uuid "4cba2621-98fe-52b1-97f8-c3f0fc1f4705" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186525884}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2eda7c70-df6a-5426-8bab-8b4a22231bc8" :question/math-academy-id "q-72482" :question/problem "Consider the following partitions:\n\n- ${P}_{1}=\\{{x}_{0},{x}_{1},…,{x}_{m}\\}$ is a partition of the interval $[1,4]$\n\n- ${P}_{2}=\\{{y}_{0},{y}_{1},…,{y}_{n}\\}$ is a partition of the interval $[1,5]$\n\nCalculate  ${\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}({x}_{i}+{x}_{i-1})Δ{x}_{i}Δ{y}_{j},$ where $Δ{x}_{i}={x}_{i}-{x}_{i-1}$ and $Δ{y}_{j}={y}_{j}-{y}_{j-1}.$" :question/worked-solution "Using the product rule, we can write the summation as\n\n$$\n{\\sum }_{i=1}^{m}({x}_{i}+{x}_{i-1})Δ{x}_{i}\\cdot {\\sum }_{j=1}^{n}Δ{y}_{j}.\n$$\n\nNote that ${\\sum }_{j=1}^{n}Δ{y}_{j}$ is just the length of the interval $[1,5].$ So, we have\n\n$$\n\\begin{aligned}{\\sum }_{j=1}^{n}Δ{y}_{j}=5-1=4.\\end{aligned}\n$$\n\nFor the sum over $i,$ we can evaluate as follows:\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}({x}_{i}+{x}_{i-1})Δ{x}_{i} & =({x}_{1}+{x}_{0})Δ{x}_{1}+({x}_{2}+{x}_{1})Δ{x}_{2}+⋯+({x}_{m}+{x}_{m-1})Δ{x}_{n} \\\\  & =({x}_{1}+{x}_{0})({x}_{1}-{x}_{0})+({x}_{2}+{x}_{1})({x}_{2}-{x}_{1})+⋯+({x}_{m}+{x}_{m-1})({x}_{m}-{x}_{m-1}) \\\\  & =({x}_{1}^{2}-{x}_{0}^{2})+({x}_{2}^{2}-{x}_{1}^{2})+⋯+({x}_{m}^{2}-{x}_{m-1}^{2}) \\\\  & =(\\cancel{{x}_{1}^{2}}-{x}_{0}^{2})+(\\cancel{{x}_{2}^{2}}-\\cancel{{x}_{1}^{2}})+⋯+({x}_{m}^{2}-\\cancel{{x}_{m-1}^{2}}) \\\\  & =-{x}_{0}^{2}+{x}_{m}^{2} \\\\  & ={x}_{m}^{2}-{x}_{0}^{2} \\\\  & ={4}^{2}-{1}^{2} \\\\  & =15\\end{aligned}\n$$\n\nCombining our results, we finally arrive at\n\n$$\n{\\sum }_{i=1}^{m}({x}_{i}+{x}_{i-1})Δ{x}_{i}\\cdot {\\sum }_{j=1}^{n}Δ{y}_{j}=15\\cdot 4=60.\n$$"}]}
