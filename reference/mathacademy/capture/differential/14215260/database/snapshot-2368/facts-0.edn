-9369-9bc7fd6b6f83" #edb/ref 17592186045417] [17592186274123 #edb/ref 1080 "12" #edb/ref 17592186045417] [17592186274123 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186274123 #edb/ref 1083 #uuid "c78f5abc-91a5-5d22-90f0-86f9268bdd7d" #edb/ref 17592186045417] [17592186274360 #edb/ref 1080 "32" #edb/ref 17592186045417] [17592186274360 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186274360 #edb/ref 1083 #uuid "df8a276c-dfc4-5935-b89d-f9fbf1bb8487" #edb/ref 17592186045417] [17592186274523 #edb/ref 1080 "48" #edb/ref 17592186045417] [17592186274523 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186274523 #edb/ref 1083 #uuid "f1550d82-2633-5abb-9927-288d0904b5b1" #edb/ref 17592186045417] [17592186274820 #edb/ref 1075 #edb/ref 17592186273394 #edb/ref 17592186045417] [17592186274820 #edb/ref 1075 #edb/ref 17592186273422 #edb/ref 17592186045417] [17592186274820 #edb/ref 1075 #edb/ref 17592186273910 #edb/ref 17592186045417] [17592186274820 #edb/ref 1075 #edb/ref 17592186274123 #edb/ref 17592186045417] [17592186274820 #edb/ref 1075 #edb/ref 17592186274360 #edb/ref 17592186045417] [17592186274820 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186274820 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186274820 #edb/ref 1078 #edb/ref 17592186273422 #edb/ref 17592186045417] [17592186274820 #edb/ref 1079 #uuid "6d718573-0055-5ccf-8a08-cae2d3f001ae" #edb/ref 17592186045417] [17592186274949 #edb/ref 1075 #edb/ref 17592186272806 #edb/ref 17592186045417] [17592186274949 #edb/ref 1075 #edb/ref 17592186272985 #edb/ref 17592186045417] [17592186274949 #edb/ref 1075 #edb/ref 17592186273738 #edb/ref 17592186045417] [17592186274949 #edb/ref 1075 #edb/ref 17592186274064 #edb/ref 17592186045417] [17592186274949 #edb/ref 1075 #edb/ref 17592186274523 #edb/ref 17592186045417] [17592186274949 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186274949 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186274949 #edb/ref 1078 #edb/ref 17592186272985 #edb/ref 17592186045417] [17592186274949 #edb/ref 1079 #uuid "b4f7deb4-d91c-5fde-bcfe-1de4ed02beac" #edb/ref 17592186045417] [17592186275216 #edb/ref 1068 #edb/ref 17592186274820 #edb/ref 17592186045417] [17592186275216 #edb/ref 1069 "q-149628" #edb/ref 17592186045417] [17592186275216 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186275216 #edb/ref 1071 "Consider the following partitions:\n\n- ${P}_{1}=\\{{x}_{0},{x}_{1},…,{x}_{m}\\}$ is a partition of the interval $[2,3]$\n\n- ${P}_{2}=\\{{y}_{0},{y}_{1},…,{y}_{n}\\}$ is a partition of the interval $[3,8]$\n\nCalculate ${\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}4Δ{x}_{i}Δ{y}_{j},$ where $Δ{x}_{i}={x}_{i}-{x}_{i-1}$ and $Δ{y}_{j}={y}_{j}-{y}_{j-1}.$" #edb/ref 17592186045417] [17592186275216 #edb/ref 1072 #uuid "ba5f3cf2-5db7-5ec1-b7c9-a70950beee5d" #edb/ref 17592186045417] [17592186275216 #edb/ref 1074 "Using the constant multiple and product rules, we can write the summation as\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}4Δ{x}_{i}Δ{y}_{j} & =4{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}Δ{x}_{i}Δ{y}_{j} \\\\  & =4{\\sum }_{i=1}^{m}Δ{x}_{i}{\\sum }_{j=1}^{n}Δ{y}_{j}.\\end{aligned}\n$$\n\nNote that ${\\sum }_{i=1}^{m}Δ{x}_{i}$ and ${\\sum }_{j=1}^{n}Δ{y}_{j}$ are just the lengths of the intervals $[2,3]$ and $[3,8]$ respectively. So, we have\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}Δ{x}_{i} & =3-2=1, \\\\ {\\sum }_{j=1}^{n}Δ{y}_{j} & =8-3=5.\\end{aligned}\n$$\n\nCombining our results, we have\n\n$$\n4{\\sum }_{i=1}^{m}Δ{x}_{i}{\\sum }_{j=1}^{n}Δ{y}_{j}=4\\cdot 1\\cdot 5=20.\n$$" #edb/ref 17592186045417] [17592186275218 #edb/ref 1068 #edb/ref 17592186274949 #edb/ref 17592186045417] [17592186275218 #edb/ref 1069 "q-149631" #edb/ref 17592186045417] [17592186275218 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186275218 #edb/ref 1071 "Consider the following partitions:\n\n- ${P}_{1}=\\{{x}_{0},{x}_{1},…,{x}_{m}\\}$ is a partition of the interval $[3,5]$\n\n- ${P}_{2}=\\{{y}_{0},{y}_{1},…,{y}_{n}\\}$ is a partition of the interval $[-1,2]$\n\nCalculate ${\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}({y}_{j}+{y}_{j-1})Δ{x}_{i}Δ{y}_{j},$ where $Δ{x}_{i}={x}_{i}-{x}_{i-1}$ and $Δ{y}_{j}={y}_{j}-{y}_{j-1}.$" #edb/ref 17592186045417] [17592186275218 #edb/ref 1072 #uuid "05d90303-b25e-5d42-93e9-d95362fdcd2f" #edb/ref 17592186045417] [17592186275218 #edb/ref 1074 "Using the product rule, we can write the summation as\n\n$$\n{\\sum }_{i=1}^{m}Δ{x}_{i}\\cdot {\\sum }_{j=1}^{n}({y}_{j}+{y}_{j-1})Δ{y}_{j}.\n$$\n\nNote that ${\\sum }_{i=1}^{m}Δ{x}_{i}$ is just the length of the interval $[3,5].$ So, we have\n\n$$\n{\\sum }_{i=1}^{m}Δ{x}_{i}=5-3=2.\n$$\n\nFor the sum over $j,$ we evaluate it as follows:\n\n$$\n\\begin{aligned}{\\sum }_{j=1}^{n}({y}_{j}+{y}_{j-1})Δ{y}_{j} & =({y}_{1}+{y}_{0})Δ{y}_{1}+({y}_{2}+{y}_{1})Δ{y}_{2}+⋯+({y}_{n}+{x}_{n-1})Δ{y}_{n} \\\\  & =({y}_{1}+{y}_{0})({y}_{1}-{y}_{0})+({y}_{2}+{y}_{1})({y}_{2}-{y}_{1})+⋯+({y}_{n}+{x}_{n-1})({y}_{n}-{y}_{n-1}) \\\\  & =({y}_{1}^{2}-{y}_{0}^{2})+({y}_{2}^{2}-{y}_{1}^{2})+⋯+({y}_{n}^{2}-{y}_{n-1}^{2}) \\\\  & =(\\cancel{{y}_{1}^{2}}-{y}_{0}^{2})+(\\cancel{{y}_{2}^{2}}-\\cancel{{y}_{1}^{2}})+⋯+({y}_{n}^{2}-\\cancel{{y}_{n-1}^{2}}) \\\\  & =-{y}_{0}^{2}+{y}_{n}^{2} \\\\  & ={y}_{n}^{2}-{y}_{0}^{2} \\\\  & ={2}^{2}-(-1)^{2} \\\\  & =3\\end{aligned}\n$$\n\nCombining our results, we finally arrive at \n\n$$\n{\\sum }_{i=1}^{m}Δ{x}_{i}\\cdot {\\sum }_{j=1}^{n}({y}_{j}+{y}_{j-1})Δ{y}_{j}=2\\cdot 3=6.\n$$" #edb/ref 17592186045417] [17592186336176 #edb/ref 1080 "12" #edb/ref 17592186045417] [17592186336176 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186336176 #edb/ref 1083 #uuid "0f340918-7d6f-57a3-802c-2a1453e19f4d" #edb/ref 17592186045417] [17592186336312 #edb/ref 1080 "2" #edb/ref 17592186045417] [17592186336312 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186336312 #edb/ref 1083 #u