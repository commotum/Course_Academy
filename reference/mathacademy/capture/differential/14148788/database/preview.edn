6447187 13194139534994 17592186045417 true] [17592186447203 1075 #edb/ref 17592186447190 13194139534994 17592186045417 true] [17592186447203 1075 #edb/ref 17592186447194 13194139534994 17592186045417 true] [17592186447203 1075 #edb/ref 17592186447198 13194139534994 17592186045417 true] [17592186447203 1076 #edb/ref 17592186045493 13194139534994 17592186045417 true] [17592186447203 1077 "selection" 13194139534994 17592186045417 true] [17592186447203 1078 #edb/ref 17592186447190 13194139534994 17592186045417 true] [17592186447203 1079 #uuid "b9ef3f22-a619-5b50-8f97-3dc74dbda9d2" 13194139534994 17592186045417 true] [17592186447204 1075 #edb/ref 17592186447175 13194139534994 17592186045417 true] [17592186447204 1075 #edb/ref 17592186447180 13194139534994 17592186045417 true] [17592186447204 1075 #edb/ref 17592186447184 13194139534994 17592186045417 true] [17592186447204 1075 #edb/ref 17592186447189 13194139534994 17592186045417 true] [17592186447204 1075 #edb/ref 17592186447195 13194139534994 17592186045417 true] [17592186447204 1076 #edb/ref 17592186045493 13194139534994 17592186045417 true] [17592186447204 1077 "selection" 13194139534994 17592186045417 true] [17592186447204 1078 #edb/ref 17592186447180 13194139534994 17592186045417 true] [17592186447204 1079 #uuid "e27dc486-028e-5b85-8121-cb4f3fc8a15b" 13194139534994 17592186045417 true] [17592186447205 1068 #edb/ref 17592186447202 13194139534994 17592186045417 true] [17592186447205 1069 "q-84695" 13194139534994 17592186045417 true] [17592186447205 1070 #edb/ref 17592186045485 13194139534994 17592186045417 true] [17592186447205 1071 "A processor manufacturer determines that $2%$ of the processors it produces are defective. A quality control officer inspects a random sample of $500$ processors. What is the standard deviation of the number of defective processors found in the sample? Round your answer to $2$ decimal places." 13194139534994 17592186045417 true] [17592186447205 1072 #uuid "1bcd51a1-0665-5138-a53c-48e05f564d89" 13194139534994 17592186045417 true] [17592186447205 1074 "Let the random variable $X$ be equal to the number of defective processors.\n\nHere, we have the following information:\n\n- there are $n=500$ processors\n\n- the probability of a processor being defective is $p=2%=0.02$\n\nSo, $X$ follows a binomial distribution, where $X∼B(500,0.02).$\n\nFor a binomial random variable $X,$ the standard deviation is given by\n\n$$\n\\text{SD}[X]=\\sqrt{\\text{Var}[X]}=\\sqrt{np(1-p)}\n$$\n\nwhere $n$ is the number of experiments, and $p$ is the probability of success on each experiment.\n\nSo, the standard deviation of the number of defective processors is\n\n$$\n\\begin{aligned}\\text{SD}[X] & =\\sqrt{np(1-p)} \\\\  & =\\sqrt{(500)(0.02)(1-0.02)} \\\\  & =\\sqrt{9.8} \\\\  & =3.13\\end{aligned}\n$$\n\nrounded to $2$ decimal places." 13194139534994 17592186045417 true] [17592186447206 1068 #edb/ref 17592186447204 13194139534994 17592186045417 true] [17592186447206 1069 "q-84763" 13194139534994 17592186045417 true] [17592186447206 1070 #edb/ref 17592186045487 13194139534994 17592186045417 true] [17592186447206 1071 "A fair $8$-sided die with numbers $1$ through $8$ is rolled $12$ times. What is the standard deviation of the number of times we get an even number? Round your answer to $3$ decimal places." 13194139534994 17592186045417 true] [17592186447206 1072 #uuid "47805108-6203-5bb3-98d1-dea670ffc279" 13194139534994 17592186045417 true] [17592186447206 1074 "Let the random variable $X$ be equal to the number of times we get an even number.\n\nHere, we have the following information:\n\n- there are $n=12$ rolls of the die\n\n- the probability of getting an even number (i.e., a $2,$ $4,$ $6,$ or $8$) on any roll of the die is\n\n$$\np=\\frac{4}{8}=\\frac{1}{2}.\n$$\n\nSo, $X$ follows a binomial distribution, where $X∼B(12,\\frac{1}{2}).$\n\nFor a binomial random variable $X,$ the standard deviation is given by\n\n$$\n\\text{SD}[X]=\\sqrt{\\text{Var}[X]}=\\sqrt{np(1-p)},\n$$\n\nwhere $n$ is the number of experiments, and $p$ is the probability of success on each experiment.\n\nSo, the standard deviation of the number of times we get an even number is\n\n$$\n\\begin{aligned}\\text{SD}[X] & =\\sqrt{np(1-p)} \\\\  & =\\sqrt{12\\cdot \\frac{1}{2}\\cdot (1-\\frac{1}{2})} \\\\  & =\\sqrt{3} \\\\  & =1.732\\end{aligned}\n$$\n\nrounded to $3$ decimal places." 13194139534994 17592186045417 true] [17592186447207 1068 #edb/ref 17592186447200 13194139534994 17592186045417 true] [17592186447207 1069 "q-84696" 13194139534994 17592186045417 true] [17592186447207 1070 #edb/ref 17592186045485 13194139534994 17592186045417 true] [17592186447207 1071 "A fair spinner is designed so that $30%$ of its surface area is painted in red. Tom spins the spinner $15$ times. What is the standard deviation of the number of times the spinner lands on red? Round your answer to $3$ decimal places." 13194139534994 17592186045417 true] [17592186447207 1072 #uuid "5b0b4129-44a0-54cb-bf0f-c1b1c637d428" 13194139534994 17592186045417 true] [17592186447207 1074 "Let the random variable $X$ be equal to the number of times the spinner lands on red.\n\nHere, we have the following information:\n\n- there are $n=15$ spins\n\n- the probability of landing on red is $p=30%=0.3$\n\nSo, $X$ follows a binomial distribution, where $X∼B(15,0.3).$\n\nFor a binomial random variable $X,$ the standard deviation is given by\n\n$$\n\\text{SD}[X]=\\sqrt{\\text{Var}[X]}=\\sqrt{np(1-p)}\n$$\n\nwhere $n$ is the number of experiments, and $p$ is the probability of success on each experiment.\n\nSo, the standard deviation of the number of times the spinner lands on red is\n\n$$\n\\begin{aligned}\\text{SD}[X] & =\\sqrt{np(1-p)} \\\\  & =\\sqrt{(15)(0.3)(1-0.3)} \\\\  & =\\sqrt{3.15} \\\\  & =1.775\\end{aligned}\n$$\n\nrounded to $3$ decimal places." 13194139534994 17592186045417 true] [17592186447208 1068 #edb/ref 17592186447201 13194139534994 17592186045417 true] [17592186447208 1069 "q-89407" 13194139534994 17592186045417 true] [17592186447208 1070 #edb/ref 17592186045485 13194139534994 17592186045417 true] [17592186447208 1071 "It is known that $40%$ of a given population have blood type O$+.$ What is the variance of the number of people in a random sample of $100$ people having blood type O$+?$" 13194139534994 17592186045417 true] [17592186447208 1072 #uuid "66116800-3925-5364-86bb-866dbabfb7d6" 13194139534994 17592186045417 true] [17592186447208 1074 "Let the random variable $X$ be equal to the number of people having blood type O$+.$\n\nHere, we have the following information:\n\n- there are $n=100$ people\n\n- the probability of finding a person with blood type O$+$ is $p=40%=0.4$\n\nSo, $X$ follows a binomial distribution, where $X∼B(100,0.4).$\n\nFor a binomial random variable $X,$ the variance is given by\n\n$$\n\\text{Var}[X]=np(1-p),\n$$\n\nwhere $n$ is the number of experiments and $p$ is the probability of success on each experiment.\n\nSo, the variance of the number of people with blood type O$+$ is\n\n$$\n\\begin{aligned}\\text{Var}[X] & =np(1-p) \\\\  & =(100)(0.4)(1-0.4) \\\\  & =(40)(0.6) \\\\  & =24.\\end{aligned}\n$$" 13194139534994 17592186045417 true] [17592186447209 1068 #edb/ref 17592186447203 13194139534994 17592186045417 true] [17592186447209 1069 "q-130761" 13194139534994 17592186045417 true] [17592186447209 1070 #edb/ref 17592186045485 13194139534994 17592186045417 true] [17592186447209 1071 "A new drug has a $75%$ probability of curing a patient within a week. If $50$ patients are treated, what is the variance of the number of cured patients within a week?" 13194139534994 17592186045417 true] [17592186447209 1072 #uuid "ca0fbb1f-e0c9-5b4f-9fe5-ceb4b1f414a7" 13194139534994 17592186045417 true] [17592186447209 1074 "Let the random variable $X$ be the number of cured patients within a week.\n\nHere, we have the following information:\n\n- there are $n=50$ patients in the sample\n\n- the probability that the new drug cures a patient within a week is $p=75%=0.75$\n\nSo, $X$ follows a binomial distribution, where $X∼B(50,0.75).$ \n\nFor a binomial random variable $X,$ the variance is given by\n\n$$\n\\text{Var}[X]=np(1-p),\n$$\n\nwhere $n$ is the number of experiments and $p$ is the probability of success on each experiment.\n\n So, the variance of the number of cured patients within a week is\n\n$$\n\\begin{aligned}\\text{Var}[X] & =np(1-p) \\\\  & =(50)(0.75)(1-0.75) \\\\  & =(50)(0.75)(0.25) \\\\  & =9.375.\\end{aligned}\n$$" 13194139534994 17592186045417 true] [17592186447210 1058 #edb/ref 17592186447214 13194139534994 17592186045417 true] [17592186447210 1062 #uuid "048a1307-200e-5108-a025-827c957dc173" 13194139534994 17592186045417 true] [17592186447210 1063 #edb/ref 17592186447205 13194139534994 17592186045417 true] [17592186447211 1058 #edb/ref 17592186447212 13194139534994 17592186045417 true] [17592186447211 1062 #uuid "281fc6c5-f0d6-53e7-acdb-64ce6dd2027e" 13194139534994 17592186045417 true] [17592186447211 1063 #edb/ref 17592186447206 13194139534994 17592186045417 true] [17592186447212 1058 #edb/ref 17592186447213 13194139534994 17592186045417 true] [17592186447212 1062 #uuid "2a403e6a-cb61-53cc-8787-e8ddb2f89be6" 13194139534994 17592186045417 true] [17592186447212 1063 #edb/ref 17592186447208 13194139534994 17592186045417 true] [17592186447213 1062 #uuid "3e456f34-784c-5b15-be45-6dc17016e9ad" 13194139534994 17592186045417 true] [17592186447213 1063 #edb/ref 17592186447209 13194139534994 17592186045417 true] [17592186447214 1058 #edb/ref 17592186447211 13194139534994 17592186045417 true] [17592186447214 1062 #uuid "7b808605-f501-5056-8071-6d7f1c92fb43" 13194139534994 17592186045417 true] [17592186447214 1063 #edb/ref 17592186447207 13194139534994 17592186045417 true]] :edb/tempids {"activity-67edc56b-a9ee-5fab-b142-813c8f1ec3bc" 17592186447174 "answer-04c30f5a-bf33-559a-b8a4-5e69bbf5720d" 17592186447175 "answer-0be445e0-0375-5ea8-9459-c53e6d50f177" 17592186447176 "answer-1584bfe0-d966