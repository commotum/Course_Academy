#{[{:db/id #edb/ref 17592186447209 :knowledge-point/_questions [{:db/id #edb/ref 17592186133846 :knowledge-point/id #uuid "f9e1f419-8442-5192-a1fa-44b5bedeff56" :knowledge-point/title "Finding the Variance of a Binomial Random Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5abfb6fc-60ea-572f-ac7e-6a6e6c6c8fc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8.875" :db/id #edb/ref 17592186447185} {:answer/id #uuid "695a0aa4-a1fe-5cfe-b2b6-0c3978ac7745" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9.355" :db/id #edb/ref 17592186447187} {:answer/id #uuid "7eb92730-9656-59a5-a7c5-6a2dcae9c03e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9.375" :db/id #edb/ref 17592186447190} {:answer/id #uuid "bc2e1e19-49ff-5edf-a50a-d36611e5e680" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8.575" :db/id #edb/ref 17592186447194} {:answer/id #uuid "d42c80c4-5881-571e-8e6e-4dd57a871e0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9.575" :db/id #edb/ref 17592186447198}] :answer-field/correct {:answer/id #uuid "7eb92730-9656-59a5-a7c5-6a2dcae9c03e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9.375" :db/id #edb/ref 17592186447190} :answer-field/id #uuid "b9ef3f22-a619-5b50-8f97-3dc74dbda9d2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186447203}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ca0fbb1f-e0c9-5b4f-9fe5-ceb4b1f414a7" :question/math-academy-id "q-130761" :question/problem "A new drug has a $75%$ probability of curing a patient within a week. If $50$ patients are treated, what is the variance of the number of cured patients within a week?" :question/worked-solution "Let the random variable $X$ be the number of cured patients within a week.\n\nHere, we have the following information:\n\n- there are $n=50$ patients in the sample\n\n- the probability that the new drug cures a patient within a week is $p=75%=0.75$\n\nSo, $X$ follows a binomial distribution, where $X∼B(50,0.75).$ \n\nFor a binomial random variable $X,$ the variance is given by\n\n$$\n\\text{Var}[X]=np(1-p),\n$$\n\nwhere $n$ is the number of experiments and $p$ is the probability of success on each experiment.\n\n So, the variance of the number of cured patients within a week is\n\n$$\n\\begin{aligned}\\text{Var}[X] & =np(1-p) \\\\  & =(50)(0.75)(1-0.75) \\\\  & =(50)(0.75)(0.25) \\\\  & =9.375.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186447205 :knowledge-point/_questions [{:db/id #edb/ref 17592186133847 :knowledge-point/id #uuid "c66a7ba5-1019-56bd-b915-bb725ee4a499" :knowledge-point/title "Finding the Standard Deviation of a Binomial Random Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0be445e0-0375-5ea8-9459-c53e6d50f177" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.33" :db/id #edb/ref 17592186447176} {:answer/id #uuid "1584bfe0-d966-5daa-998c-79952fa3b326" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.31" :db/id #edb/ref 17592186447177} {:answer/id #uuid "2aff8426-f35a-554a-8a66-38d43ce76d6e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.33" :db/id #edb/ref 17592186447178} {:answer/id #uuid "47c31032-8b56-50f5-af9a-6bf5990b3a5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.13" :db/id #edb/ref 17592186447181} {:answer/id #uuid "a7256240-6989-55a6-87d8-09e0234b61e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.13" :db/id #edb/ref 17592186447193}] :answer-field/correct {:answer/id #uuid "47c31032-8b56-50f5-af9a-6bf5990b3a5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.13" :db/id #edb/ref 17592186447181} :answer-field/id #uuid "74ad51d2-25d4-59e0-a633-9b2e1070afdd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186447202}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1bcd51a1-0665-5138-a53c-48e05f564d89" :question/math-academy-id "q-84695" :question/problem "A processor manufacturer determines that $2%$ of the processors it produces are defective. A quality control officer inspects a random sample of $500$ processors. What is the standard deviation of the number of defective processors found in the sample? Round your answer to $2$ decimal places." :question/worked-solution "Let the random variable $X$ be equal to the number of defective processors.\n\nHere, we have the following information:\n\n- there are $n=500$ processors\n\n- the probability of a processor being defective is $p=2%=0.02$\n\nSo, $X$ follows a binomial distribution, where $X∼B(500,0.02).$\n\nFor a binomial random variable $X,$ the standard deviation is given by\n\n$$\n\\text{SD}[X]=\\sqrt{\\text{Var}[X]}=\\sqrt{np(1-p)}\n$$\n\nwhere $n$ is the number of experiments, and $p$ is the probability of success on each experiment.\n\nSo, the standard deviation of the number of defective processors is\n\n$$\n\\begin{aligned}\\text{SD}[X] & =\\sqrt{np(1-p)} \\\\  & =\\sqrt{(500)(0.02)(1-0.02)} \\\\  & =\\sqrt{9.8} \\\\  & =3.13\\end{aligned}\n$$\n\nrounded to $2$ decimal places."}] [{:db/id #edb/ref 17592186447207 :knowledge-point/_questions [{:db/id #edb/ref 17592186133847 :knowledge-point/id #uuid "c66a7ba5-1019-56bd-b915-bb725ee4a499" :knowledge-point/title "Finding the Standard Deviation of a Binomial Random Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49f3e3ee-5aef-556d-85bb-ab132171fd77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15.77" :db/id #edb/ref 17592186447182} {:answer/id #uuid "507f6b15-d100-55b8-b5e7-f81ff6635824" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.557" :db/id #edb/ref 17592186447183} {:answer/id #uuid "5cfc7388-da64-5a3f-998a-1a44096afad4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.755" :db/id #edb/ref 17592186447186} {:answer/id #uuid "92f9993e-cd44-5db5-bae3-94facbcc06d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17.75" :db/id #edb/ref 17592186447191} {:answer/id #uuid "96b119d8-e7fe-5c56-b4a4-0f900739f445" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.775" :db/id #edb/ref 17592186447192}] :answer-field/correct {:answer/id #uuid "96b119d8-e7fe-5c56-b4a4-0f900739f445" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.775" :db/id #edb/ref 17592186447192} :answer-field/id #uuid "071baea7-b677-5ff5-ad57-c766dc91d228" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186447200}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5b0b4129-44a0-54cb-bf0f-c1b1c637d428" :question/math-academy-id "q-84696" :question/problem "A fair spinner is designed so that $30%$ of its surface area is painted in red. Tom spins the spinner $15$ times. What is the standard deviation of the number of times the spinner lands on red? Round your answer to $3$ decimal places." :question/worked-solution "Let the random variable $X$ be equal to the number of times the spinner lands on red.\n\nHere, we have the following information:\n\n- there are $n=15$ spins\n\n- the probability of landing on red is $p=30%=0.3$\n\nSo, $X$ follows a binomial distribution, where $X∼B(15,0.3).$\n\nFor a binomial random variable $X,$ the standard deviation is given by\n\n$$\n\\text{SD}[X]=\\sqrt{\\text{Var}[X]}=\\sqrt{np(1-p)}\n$$\n\nwhere $n$ is the number of experiments, and $p$ is the probability of success on each experiment.\n\nSo, the standard deviation of the number of times the spinner lands on red is\n\n$$\n\\begin{aligned}\\text{SD}[X] & =\\sqrt{np(1-p)} \\\\  & =\\sqrt{(15)(0.3)(1-0.3)} \\\\  & =\\sqrt{3.15} \\\\  & =1.775\\end{aligned}\n$$\n\nrounded to $3$ decimal places."}] [{:db/id #edb/ref 17592186447206 :knowledge-point/_questions [{:db/id #edb/ref 17592186133847 :knowledge-point/id #uuid "c66a7ba5-1019-56bd-b915-bb725ee4a499" :knowledge-point/title "Finding the Standard Deviation of a Binomial Random Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04c30f5a-bf33-559a-b8a4-5e69bbf5720d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.923" :db/id #edb/ref 17592186447175} {:answer/id #uuid "3ff7dee6-d555-52cc-9d52-dea07a26c3b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.732" :db/id #edb/ref 17592186447180} {:answer/id #uuid "50c8789a-ed1d-5026-941b-7b2b50d0c177" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.702" :db/id #edb/ref 17592186447184} {:answer/id #uuid "7b195181-6ca7-5730-8661-e95dd7cb57ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.023" :db/id #edb/ref 17592186447189} {:answer/id #uuid "bec1fd83-dfc0-5da0-b29c-9bbb9be7c789" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.903" :db/id #edb/ref 17592186447195}] :answer-field/correct {:answer/id #uuid "3ff7dee6-d555-52cc-9d52-dea07a26c3b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.732" :db/id #edb/ref 17592186447180} :answer-field/id #uuid "e27dc486-028e-5b85-8121-cb4f3fc8a15b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186447204}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "47805108-6203-5bb3-98d1-dea670ffc279" :question/math-academy-id "q-84763" :question/problem "A fair $8$-sided die with numbers $1$ through $8$ is rolled $12$ times. What is the standard deviation of the number of times we get an even number? Round your answer to $3$ decimal places." :question/worked-solution "Let the random variable $X$ be equal to the number of times we get an even number.\n\nHere, we have the following information:\n\n- there are $n=12$ rolls of the die\n\n- the probability of getting an even number (i.e., a $2,$ $4,$ $6,$ or $8$) on any roll of the die is\n\n$$\np=\\frac{4}{8}=\\frac{1}{2}.\n$$\n\nSo, $X$ follows a binomial distribution, where $X∼B(12,\\frac{1}{2}).$\n\nFor a binomial random variable $X,$ the standard deviation is given by\n\n$$\n\\text{SD}[X]=\\sqrt{\\text{Var}[X]}=\\sqrt{np(1-p)},\n$$\n\nwhere $n$ is the number of experiments, and $p$ is the probability of success on each experiment.\n\nSo, the standard deviation of the number of times we get an even number is\n\n$$\n\\begin{aligned}\\text{SD}[X] & =\\sqrt{np(1-p)} \\\\  & =\\sqrt{12\\cdot \\frac{1}{2}\\cdot (1-\\frac{1}{2})} \\\\  & =\\sqrt{3} \\\\  & =1.732\\end{aligned}\n$$\n\nrounded to $3$ decimal places."}] [{:db/id #edb/ref 17592186447208 :knowledge-point/_questions [{:db/id #edb/ref 17592186133846 :knowledge-point/id #uuid "f9e1f419-8442-5192-a1fa-44b5bedeff56" :knowledge-point/title "Finding the Variance of a Binomial Random Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d7bac8f-9400-5b68-a61f-a99ce6b49dd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186447179} {:answer/id #uuid "760a9935-e1d0-5e24-b023-e735d9955b4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186447188} {:answer/id #uuid "c055988d-f3bd-553d-8e1a-22088530e411" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186447196} {:answer/id #uuid "cd2d6056-d2b9-56b3-a91d-fd1294acea48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186447197} {:answer/id #uuid "e069e05b-9f37-5c93-86b4-5b5e0d856a6e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186447199}] :answer-field/correct {:answer/id #uuid "cd2d6056-d2b9-56b3-a91d-fd1294acea48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186447197} :answer-field/id #uuid "6cf5258d-4410-5e8c-87c9-4f4a5aa05a93" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186447201}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "66116800-3925-5364-86bb-866dbabfb7d6" :question/math-academy-id "q-89407" :question/problem "It is known that $40%$ of a given population have blood type O$+.$ What is the variance of the number of people in a random sample of $100$ people having blood type O$+?$" :question/worked-solution "Let the random variable $X$ be equal to the number of people having blood type O$+.$\n\nHere, we have the following information:\n\n- there are $n=100$ people\n\n- the probability of finding a person with blood type O$+$ is $p=40%=0.4$\n\nSo, $X$ follows a binomial distribution, where $X∼B(100,0.4).$\n\nFor a binomial random variable $X,$ the variance is given by\n\n$$\n\\text{Var}[X]=np(1-p),\n$$\n\nwhere $n$ is the number of experiments and $p$ is the probability of success on each experiment.\n\nSo, the variance of the number of people with blood type O$+$ is\n\n$$\n\\begin{aligned}\\text{Var}[X] & =np(1-p) \\\\  & =(100)(0.4)(1-0.4) \\\\  & =(40)(0.6) \\\\  & =24.\\end{aligned}\n$$"}]}
