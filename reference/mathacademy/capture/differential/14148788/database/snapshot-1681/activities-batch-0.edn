#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186134774} :activity/id #uuid "c8768805-6c91-5b41-a3a9-4287350b3afa" :activity/scope {:db/id #edb/ref 17592186050425 :topic/id #uuid "47bc97de-e4cb-5992-8c54-201c61752e0a" :topic/math-academy-id 2149} :activity/steps [{:db/id #edb/ref 17592186134774 :step/content {:db/id #edb/ref 17592186135091 :tutorial/content "Remember that if $X$ is a binomial random variable in which there are $n$ experiments and $p$ is the probability of success on each experiment, then $X$ has the following probability mass function:\n\n$$\nf(x) = \\binom{n}{x} p^x (1-p)^{n-x}.\n$$\n\nIt can be shown that the expected value, variance, and standard deviation of a binomial random variable $X$ can be computed as follows:\n\n$$\n\\begin{aligned}\\text{E}[X] & =np \\\\ \\text{Var}[X] & =np(1-p) \\\\ \\text{SD}[X] & =\\sqrt{np(1-p)}\\end{aligned}\n$$" :tutorial/id #uuid "872af947-d3c7-525f-8bb9-21d55de36921" :tutorial/math-academy-id 4452 :tutorial/title "Introduction"} :step/id #uuid "0b2b3592-e0b4-5a5e-93ad-e27455156dd3" :step/math-academy-id 27404 :step/next {:db/id #edb/ref 17592186134775}} {:db/id #edb/ref 17592186134775 :step/content {:db/id #edb/ref 17592186133845 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133660 :question/id #uuid "da211af4-8acc-56f9-9b5f-8f2d9b026c70" :question/math-academy-id "e-7395"} :knowledge-point/id #uuid "eb06ab09-4bf5-5f87-a6cf-d71c2c9d3296" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050651}] :knowledge-point/questions [{:db/id #edb/ref 17592186134522} {:db/id #edb/ref 17592186134523} {:db/id #edb/ref 17592186421983} {:db/id #edb/ref 17592186421985} {:db/id #edb/ref 17592186421987}] :knowledge-point/title "Finding the Mean of a Binomial Random Variable"} :step/id #uuid "5d083e48-b0c1-507e-980f-a93e7c776da4" :step/math-academy-id 27405 :step/next {:db/id #edb/ref 17592186134776}} {:db/id #edb/ref 17592186134776 :step/content {:db/id #edb/ref 1759218613