ass=\"ORD\"><mn>11</mn></mrow></msub><mo>+</mo><mn>2</mn><msub><mi>m</mi><mrow data-mjx-texclass=\"ORD\"><mn>21</mn></mrow></msub><mo>+</mo><msub><mi>m</mi><mrow data-mjx-texclass=\"ORD\"><mn>12</mn></mrow></msub><mo>+</mo><msub><mi>m</mi><mrow data-mjx-texclass=\"ORD\"><mn>22</mn></mrow></msub><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
