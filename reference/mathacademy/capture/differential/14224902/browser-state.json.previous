      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14224902/observations/step-q122876-fc6f9fe5d8f14f9d48c6.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14224902/observations/step-q122876-fc6f9fe5d8f14f9d48c6.png",
      "source_url": "https://mathacademy.com/tasks/14224902/topics/2613/lesson",
      "captured_at": 1792046001.5024395,
      "math_academy_id": "q-122876",
      "topic_id": "2613",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q122876",
        "placement_id": null,
