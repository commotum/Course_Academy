</mi><mo>=</mo><mn>3</mn><mo>⋅</mo><msub><mi>m</mi><mrow data-mjx-texclass=\"ORD\"><mn>11</mn></mrow></msub><mo>+</mo><mn>3</mn><mo>⋅</mo><msub><mi>m</mi><mrow data-mjx-texclass=\"ORD\"><mn>12</mn></mrow></msub><mo>+</mo><mn>3</mn><mo>⋅</mo><msub><mi>m</mi><mrow data-mjx-texclass=\"ORD\"><mn>13</mn></mrow></msub></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>3</mn><mo stretchy=\"false\">(</mo><msub><mi>m</mi><mrow data-mjx-texclass=\"ORD\"><mn>11</mn></mrow></msub><mo>+</mo><msub><mi>m</mi><mrow data-mjx-texclass=\"ORD\"><mn>12</mn></mrow></msub><mo>+</mo><msub><mi>m</mi><mrow data-mjx-texclass=\"ORD\"><mn>13</mn></mrow></msub><mo stretchy=\"false\">)</mo><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
