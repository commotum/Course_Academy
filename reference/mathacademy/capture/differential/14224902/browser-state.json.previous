      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14224902/observations/step-q122874-16bbe257fca12a275cf1.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14224902/observations/step-q122874-16bbe257fca12a275cf1.png",
      "source_url": "https://mathacademy.com/tasks/14224902/topics/2613/lesson",
      "captured_at": 1792046022.6654227,
      "math_academy_id": "q-122874",
      "topic_id": "2613",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q122874",
        "placement_id": null,
        "content_id": null,
