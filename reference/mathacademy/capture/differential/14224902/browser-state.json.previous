      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14224902/observations/step-q122885-8a62befd632a2dbd2b5e.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14224902/observations/step-q122885-8a62befd632a2dbd2b5e.png",
      "source_url": "https://mathacademy.com/tasks/14224902/topics/2613/lesson",
      "captured_at": 1792046062.7681098,
      "math_academy_id": "q-122885",
      "topic_id": "2613",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q122885",
        "placement_id": null,
