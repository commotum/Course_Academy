#{[{:db/id #edb/ref 17592186124244 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186124440 :knowledge-point/id #uuid "7ea31275-77bd-59c7-8e1d-96e2e4b252a4" :knowledge-point/title "Finding Mixed Second-Order Partial Derivatives"}] :question/id #uuid "0a8f5141-941d-5059-9d9f-bf9e5b09096f" :question/math-academy-id "e-3127" :question/problem "Find $\\dfrac {\\partial^2 f }{\\partial x\\partial y}$ given that $\\dfrac {\\partial f}{\\partial y} =  \\dfrac {2y} {x + y^2}.$" :question/worked-solution "To find $\\dfrac {\\partial^2 f }{\\partial x\\partial y},$ we differentiate the given first-order partial derivative $\\dfrac {\\partial f}{\\partial y}$ with respect to $x\\mathbin{:}$\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(\\frac{∂f}{∂y}) \\\\  & =\\frac{∂}{∂x}(\\frac{2y}{x+{y}^{2}}) \\\\  & =2y\\cdot \\frac{∂}{∂x}({(x+{y}^{2})}^{-1}) \\\\  & =-2y(x+{y}^{2})^{-2}\\cdot 1 \\\\  & =-\\frac{2y}{{(x+{y}^{2})}^{2}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186124245 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186124441 :knowledge-point/id #uuid "503a0bfe-7c69-5ad0-ad1d-aa8692dae673" :knowledge-point/title "Computing Expressions Involving Second-Order Partial Derivatives"}] :question/id #uuid "e16f6686-dffb-554e-a50a-8760e818439f" :question/math-academy-id "e-3129" :question/problem "Find $f_{xy}(x,y)+f_{yx}(x,y)$ given that  $f_x(x,y)=y\\cos(xy)$ and $f_y(x,y)=x\\cos(xy).$" :question/worked-solution "To find $f_{xy}(x,y),$ we differentiate the given first-order partial derivative $f_{x}(x,y)$ with respect to $y\\mathbin{:}$\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}({f}_{x}(x,y)) \\\\  & =\\frac{∂}{∂y}(y\\operatorname{cos}⁡(xy)) \\\\  & =1\\cdot \\operatorname{cos}⁡(xy)+y(-\\operatorname{sin}⁡(xy)\\cdot x) \\\\  & =\\operatorname{cos}⁡(xy)-xy\\operatorname{sin}⁡(xy)\\end{aligned}\n$$\n\n \n\nSimilarly, to find $f_{yx}(x,y),$ we differentiate the given first-order partial derivative $f_{y}(x,y)$ with respect to $x\\mathbin{:}$\n\n$$\n\\begin{aligned}{f}_{yx}(x,y) & =\\frac{∂}{∂x}({f}_{y}(x,y)) \\\\  & =\\frac{∂}{∂x}(x\\operatorname{cos}⁡(xy)) \\\\  & =1\\cdot \\operatorname{cos}⁡(xy)+x(-\\operatorname{sin}⁡(xy)\\cdot y) \\\\  & =\\operatorname{cos}⁡(xy)-xy\\operatorname{sin}⁡(xy)\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y)+{f}_{yx}(x,y) & =\\operatorname{cos}⁡(xy)-xy\\operatorname{sin}⁡(xy)+\\operatorname{cos}⁡(xy)-xy\\operatorname{sin}⁡(xy) \\\\  & =2(\\operatorname{cos}⁡(xy)-xy\\operatorname{sin}⁡(xy)).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186124246 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186124442 :knowledge-point/id #uuid "83724b66-0f15-5b94-9576-76e9dfd56d38" :knowledge-point/title "Finding Higher-Order Derivatives"}] :question/id #uuid "a41bfb06-4372-5124-b910-4b35f19d148b" :question/math-academy-id "e-3130" :question/problem "Evaluate $g_{xyz}(x,y,z)$ at $(1,2,3)$ if $g_x(x,y,z) = 2x y z +  y^3.$" :question/worked-solution "First, we find $g_{xy}(x,y,z)$ by differentiating $g_{x}(x,y,z)$ with respect to $y\\mathbin{:}$\n\n$$\n\\begin{aligned}{g}_{xy}(x,y,z) & =\\frac{∂}{∂y}(2xyz+{y}^{3}) \\\\  & =2xz+3{y}^{2}\\end{aligned}\n$$\n\nNext, we find $g_{xyz}(x,y,z)$ by differentiating $g_{xy}(x,y,z)$ with respect to $z\\mathbin{:}$\n\n$$\n\\begin{aligned}{g}_{xyz}(x,y,z) & =\\frac{∂}{∂z}(2xz+3{y}^{2}) \\\\  & =2x\\end{aligned}\n$$\n\nFinally, we obtain \n\n$$\n\\begin{aligned}{g}_{xyz}(1,2,3) & =2(1) \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186436905 :knowledge-point/_questions [{:db/id #edb/ref 17592186124440 :knowledge-point/id #uuid "7ea31275-77bd-59c7-8e1d-96e2e4b252a4" :knowledge-point/title "Finding Mixed Second-Order Partial Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1121a6b7-cfce-5dfc-b0da-6a636079944b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3({y}^{2}+2)}{{x}^{4}}" :db/id #edb/ref 17592186436865} {:answer/id #uuid "45f532dc-3af3-545d-ad50-9441c35b268b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2{y}^{2}}{{x}^{3}}" :db/id #edb/ref 17592186436873} {:answer/id #uuid "8fa0781f-79fb-5a91-89a4-463f367087e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3({y}^{2}+2)}{{x}^{6}}" :db/id #edb/ref 17592186436882} {:answer/id #uuid "af81e540-e582-501b-a54d-b8e1344a873b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{y}^{2}+2}{{x}^{4}}" :db/id #edb/ref 17592186436886} {:answer/id #uuid "df46ef7d-d47b-5fd1-b697-103b12930ca6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3({y}^{2}+2)}{{x}^{6}}" :db/id #edb/ref 17592186436894}] :answer-field/correct {:answer/id #uuid "1121a6b7-cfce-5dfc-b0da-6a636079944b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3({y}^{2}+2)}{{x}^{4}}" :db/id #edb/ref 17592186436865} :answer-field/id #uuid "9c76001b-f692-5359-886d-d1e457bed120" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186436901}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0e8c2128-4248-5b42-9124-e32c52ba652f" :question/math-academy-id "q-132766" :question/problem "For the function $f(x,y),$ calculate $\\frac{{∂}^{2}f}{∂{x}^{2}}$ given that $\\frac{∂f}{∂x}=-\\frac{{y}^{2}+2}{{x}^{3}}.$" :question/worked-solution "To find $\\frac{{∂}^{2}f}{∂{x}^{2}}$ we differentiate the given first-order partial derivative $\\frac{∂f}{∂x}$ with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(\\frac{∂f}{∂x}) \\\\  & =\\frac{∂}{∂x}(-\\frac{{y}^{2}+2}{{x}^{3}}) \\\\  & =-({y}^{2}+2)\\cdot (-\\frac{3}{{x}^{4}}) \\\\  & =\\frac{3({y}^{2}+2)}{{x}^{4}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186436907 :knowledge-point/_questions [{:db/id #edb/ref 17592186124440 :knowledge-point/id #uuid "7ea31275-77bd-59c7-8e1d-96e2e4b252a4" :knowledge-point/title "Finding Mixed Second-Order Partial Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3288153e-27f3-5222-851e-a6b3e5822126" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\operatorname{cos}⁡(2x-y)-x\\operatorname{sin}⁡(2x-y)}{{x}^{2}y}" :db/id #edb/ref 17592186436871} {:answer/id #uuid "53fc4b27-5931-514e-ac5a-d3a502d333bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{y\\operatorname{cos}⁡(2x-y)+\\operatorname{sin}⁡(2x-y)}{x{y}^{2}}" :db/id #edb/ref 17592186436874} {:answer/id #uuid "6e16fead-d7a4-5f11-af57-d52230ead1dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x\\operatorname{cos}⁡(2x-y)-\\operatorname{sin}⁡(2x-y)}{{x}^{2}y}" :db/id #edb/ref 17592186436877} {:answer/id #uuid "72704398-44ea-5224-9ffc-3f29a7a9b2b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cos}⁡(2x-y)+2x\\operatorname{sin}⁡(2x-y)}{{x}^{2}y}" :db/id #edb/ref 17592186436878} {:answer/id #uuid "dd8d7902-7b74-5922-be87-0951b9ee8845" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cos}⁡(2x-y)-2x\\operatorname{sin}⁡(2x-y)}{{x}^{2}y}" :db/id #edb/ref 17592186436892}] :answer-field/correct {:answer/id #uuid "6e16fead-d7a4-5f11-af57-d52230ead1dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x\\operatorname{cos}⁡(2x-y)-\\operatorname{sin}⁡(2x-y)}{{x}^{2}y}" :db/id #edb/ref 17592186436877} :answer-field/id #uuid "b088d621-a153-59a3-b489-cec7c0d60c3e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186436902}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cca3fd6b-4c7e-554a-be83-06e03ae9adfd" :question/math-academy-id "q-132801" :question/problem "For the function $f(x,y),$ calculate $\\frac{{∂}^{2}f}{∂{x}^{2}}$ given that $\\frac{∂f}{∂x}=\\frac{\\operatorname{sin}⁡(2x-y)}{xy}.$" :question/worked-solution "To find $\\frac{{∂}^{2}f}{∂{x}^{2}}$ we differentiate the given first-order partial derivative $\\frac{∂f}{∂x}$ with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(\\frac{∂f}{∂x}) \\\\  & =\\frac{∂}{∂x}(\\frac{\\operatorname{sin}⁡(2x-y)}{xy}) \\\\  & =\\frac{1}{y}\\cdot (\\frac{2\\operatorname{cos}⁡(2x-y)\\cdot x-\\operatorname{sin}⁡(2x-y)\\cdot 1}{{x}^{2}}) \\\\  & =\\frac{2x\\operatorname{cos}⁡(2x-y)-\\operatorname{sin}⁡(2x-y)}{{x}^{2}y}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186436904 :knowledge-point/_questions [{:db/id #edb/ref 17592186124441 :knowledge-point/id #uuid "503a0bfe-7c69-5ad0-ad1d-aa8692dae673" :knowledge-point/title "Computing Expressions Involving Second-Order Partial Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "73c25a30-7b77-51c9-b420-ba135dbcd471" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y(2x+y)}{(x-{y}^{2})^{2}}" :db/id #edb/ref 17592186436879} {:answer/id #uuid "952f8752-f377-5815-9aa1-8c3f1ffd9a60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y(2x-y)}{(x-{y}^{2})^{2}}" :db/id #edb/ref 17592186436885} {:answer/id #uuid "b79801c6-fc3f-56c0-b92d-bee8cdce573c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x-y}{(x-{y}^{2})^{2}}" :db/id #edb/ref 17592186436887} {:answer/id #uuid "d27f13da-e7e3-56ca-9de8-a5af29c4d179" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x-{y}^{2}}{(x-{y}^{2})^{2}}" :db/id #edb/ref 17592186436888} {:answer/id #uuid "d28548cb-cc1a-5f3a-a5c8-7ddc23cddc53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x+y}{(x-{y}^{2})^{2}}" :db/id #edb/ref 17592186436889}] :answer-field/correct {:answer/id #uuid "952f8752-f377-5815-9aa1-8c3f1ffd9a60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y(2x-y)}{(x-{y}^{2})^{2}}" :db/id #edb/ref 17592186436885} :answer-field/id #uuid "0cbecb11-fc1e-5429-8a31-6669c257052c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186436898}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "073f1d9a-253b-5fca-9478-5f95eebb298d" :question/math-academy-id "q-132874" :question/problem "Find ${g}_{xy}(x,y)+{g}_{xx}(x,y)$ given that  ${g}_{x}(x,y)=\\frac{x}{x-{y}^{2}}.$" :question/worked-solution "To find ${g}_{xy}(x,y)$ we differentiate the given first-order partial derivative ${g}_{x}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{g}_{xy}(x,y) & =\\frac{∂}{∂y}({g}_{x}(x,y)) \\\\  & =\\frac{∂}{∂y}(\\frac{x}{x-{y}^{2}}) \\\\  & =\\frac{2xy}{(x-{y}^{2})^{2}}\\end{aligned}\n$$\n\nTo find ${g}_{xx}(x,y)$ we differentiate the given first-order partial derivative ${g}_{x}(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{g}_{xx}(x,y) & =\\frac{∂}{∂x}({g}_{x}(x,y)) \\\\  & =\\frac{∂}{∂x}(\\frac{x}{x-{y}^{2}}) \\\\  & =\\frac{(x-{y}^{2})-x}{(x-{y}^{2})^{2}} \\\\  & =-\\frac{{y}^{2}}{(x-{y}^{2})^{2}}\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{g}_{xy}(x,y)+{g}_{xx}(x,y) & =\\frac{2xy}{(x-{y}^{2})^{2}}+(-\\frac{{y}^{2}}{(x-{y}^{2})^{2}}) \\\\  & =\\frac{2xy-{y}^{2}}{(x-{y}^{2})^{2}} \\\\  & =\\frac{y(2x-y)}{(x-{y}^{2})^{2}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186436908 :knowledge-point/_questions [{:db/id #edb/ref 17592186124441 :knowledge-point/id #uuid "503a0bfe-7c69-5ad0-ad1d-aa8692dae673" :knowledge-point/title "Computing Expressions Involving Second-Order Partial Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b6c9b46-c3c9-5483-8476-52cbdd59ac4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{{e}^{x+2y}}" :db/id #edb/ref 17592186436863} {:answer/id #uuid "244430db-783b-5513-8f92-180fb3fb6d6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{{e}^{x+2y}}" :db/id #edb/ref 17592186436868} {:answer/id #uuid "9138702f-62d8-5c8c-8589-5657bfa2f9d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{{e}^{x+2y}}" :db/id #edb/ref 17592186436884} {:answer/id #uuid "defd66f9-2cdd-5a46-b6fa-affd8cc6128d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{{e}^{x+2y}}" :db/id #edb/ref 17592186436893} {:answer/id #uuid "f0ca5008-806b-567a-b135-7a08f2d5620c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2xy}{{e}^{x+2y}}" :db/id #edb/ref 17592186436895}] :answer-field/correct {:answer/id #uuid "9138702f-62d8-5c8c-8589-5657bfa2f9d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{{e}^{x+2y}}" :db/id #edb/ref 17592186436884} :answer-field/id #uuid "4d617cd6-186e-5d2d-a053-2c09090395a0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186436899}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "df95e8a9-100a-5208-bae6-3713a6f72f62" :question/math-academy-id "q-132888" :question/problem "Find ${f}_{xy}(x,y)+{f}_{yx}(x,y)$ given that  ${f}_{x}(x,y)=\\frac{1}{{e}^{x+2y}}$ and ${f}_{y}(x,y)=\\frac{2}{{e}^{x+2y}}.$" :question/worked-solution "To find ${f}_{xy}(x,y)$ we differentiate the given first-order partial derivative ${f}_{x}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}({f}_{x}(x,y)) \\\\  & =\\frac{∂}{∂y}(\\frac{1}{{e}^{x+2y}}) \\\\  & =-\\frac{2}{{e}^{x+2y}}\\end{aligned}\n$$\n\nTo find ${f}_{yx}(x,y)$ we differentiate the given first-order partial derivative ${f}_{y}(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{f}_{yx}(x,y) & =\\frac{∂}{∂x}({f}_{y}(x,y)) \\\\  & =\\frac{∂}{∂x}(\\frac{2}{{e}^{x+2y}}) \\\\  & =-\\frac{2}{{e}^{x+2y}}\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y)+{f}_{yx}(x,y) & =-\\frac{2}{{e}^{x+2y}}-\\frac{2}{{e}^{x+2y}} \\\\  & =-\\frac{4}{{e}^{x+2y}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186268921 :knowledge-point/_questions [{:db/id #edb/ref 17592186124441 :knowledge-point/id #uuid "503a0bfe-7c69-5ad0-ad1d-aa8692dae673" :knowledge-point/title "Computing Expressions Involving Second-Order Partial Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "425cb3a9-f31d-5278-9378-bf08a38df305" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186266736} {:answer/id #uuid "9699bfda-ed01-5720-9988-afda1b34872c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186267488} {:answer/id #uuid "990d9a0d-8a39-5f51-984b-24694aab44b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{9}" :db/id #edb/ref 17592186267524} {:answer/id #uuid "da971629-e1c3-50eb-9d91-0e12040ebfe3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{9}" :db/id #edb/ref 17592186268079} {:answer/id #uuid "e9be40d0-3c94-561e-8513-6c2f10a0b74b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{9}" :db/id #edb/ref 17592186268223}] :answer-field/correct {:answer/id #uuid "da971629-e1c3-50eb-9d91-0e12040ebfe3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{9}" :db/id #edb/ref 17592186268079} :answer-field/id #uuid "baf0e05b-fa61-5e4e-9f86-28b1336165d5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268736}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "619c15a9-a007-5612-9fb8-0f8afb4a8030" :question/math-academy-id "q-132897" :question/problem "Find ${g}_{xy}(x,y)+{g}_{yx}(x,y)$ at $(-1,2)$ given that ${g}_{x}(x,y)=\\frac{1}{x+2y}$ and ${g}_{y}(x,y)=\\frac{2}{x+2y}.$" :question/worked-solution "To find ${g}_{xy}(x,y)$ we differentiate the given first-order partial derivative ${g}_{x}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{g}_{xy}(x,y) & =\\frac{∂}{∂y}({g}_{x}(x,y)) \\\\  & =\\frac{∂}{∂y}(\\frac{1}{x+2y}) \\\\  & =-\\frac{2}{(x+2y)^{2}}\\end{aligned}\n$$\n\n \n\nTo find ${g}_{yx}(x,y)$ we differentiate the given first-order partial derivative ${g}_{y}(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{g}_{yx}(x,y) & =\\frac{∂}{∂x}({g}_{y}(x,y)) \\\\  & =\\frac{∂}{∂x}(\\frac{2}{x+2y}) \\\\  & =-\\frac{2}{(x+2y)^{2}}\\end{aligned}\n$$\n\n \n\nNext, we evaluate ${g}_{xy}(x,y)$ and ${g}_{yx}(x,y)$ at $(-1,2):$\n\n$$\n\\begin{aligned}{g}_{xy}(-1,2) & =-\\frac{2}{((-1)+2(2))^{2}}=-\\frac{2}{9} \\\\ {g}_{yx}(-1,2) & =-\\frac{2}{((-1)+2(2))^{2}}=-\\frac{2}{9}\\end{aligned}\n$$\n\nFinally, we have\n\n$$\n{g}_{xy}(-1,2)+{g}_{yx}(-1,2)=-\\frac{4}{9}.\n$$"}] [{:db/id #edb/ref 17592186436906 :knowledge-point/_questions [{:db/id #edb/ref 17592186124442 :knowledge-point/id #uuid "83724b66-0f15-5b94-9576-76e9dfd56d38" :knowledge-point/title "Finding Higher-Order Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11de066d-e9e2-5d24-a361-76b8dd01b39d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{e}^{2x}" :db/id #edb/ref 17592186436866} {:answer/id #uuid "25385035-93dd-5e7e-9e2e-385ef7c008a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{2x}" :db/id #edb/ref 17592186436869} {:answer/id #uuid "6d8c9b27-0381-54e8-bb1c-7c96aeb216a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2y{e}^{2x}" :db/id #edb/ref 17592186436876} {:answer/id #uuid "d2c77cb4-0a48-56ef-9208-44ab43d1f3fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{e}^{2x}+\\frac{1}{2\\sqrt{\\operatorname{ln}⁡y}}" :db/id #edb/ref 17592186436890} {:answer/id #uuid "f9dbfa95-399f-56ca-90aa-62c4f3c1c9c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{2x}+\\frac{1}{2\\operatorname{ln}⁡y}" :db/id #edb/ref 17592186436897}] :answer-field/correct {:answer/id #uuid "11de066d-e9e2-5d24-a361-76b8dd01b39d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{e}^{2x}" :db/id #edb/ref 17592186436866} :answer-field/id #uuid "7c0dcfcc-85cf-5a26-b153-8427ed1851d9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186436900}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ab886db8-155f-5495-98ff-0f64afbbb0bd" :question/math-academy-id "q-132929" :question/problem "Calculate ${f}_{xyx}(x,y)$ given that $f(x,y)=y{e}^{2x}+\\sqrt{\\operatorname{ln}⁡y}.$" :question/worked-solution "First, we find the first-order derivative ${f}_{x}(x,y):$\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}(y{e}^{2x}+\\sqrt{\\operatorname{ln}⁡y}) \\\\  & =2y{e}^{2x}\\end{aligned}\n$$\n\nNext, we find ${f}_{xy}(x,y)$ by differentiating ${f}_{x}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}({f}_{x}(x,y)) \\\\  & =\\frac{∂}{∂y}(2y{e}^{2x}) \\\\  & =2{e}^{2x}\\end{aligned}\n$$\n\nFinally, we find ${f}_{xyx}(x,y)$ by differentiating ${f}_{xy}(x,y)$ with respect to $x:$ \n\n$$\n\\begin{aligned}{f}_{xyx}(x,y) & =\\frac{∂}{∂x}({f}_{xy}(x,y)) \\\\  & =\\frac{∂}{∂x}(2{e}^{2x}) \\\\  & =4{e}^{2x}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186436909 :knowledge-point/_questions [{:db/id #edb/ref 17592186124442 :knowledge-point/id #uuid "83724b66-0f15-5b94-9576-76e9dfd56d38" :knowledge-point/title "Finding Higher-Order Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18c37a0f-f8cb-5b42-a75e-149ceaf31b64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{cos}⁡y\\,(\\operatorname{sin}⁡{x}^{2}-2{x}^{2}\\operatorname{cos}⁡{x}^{2})" :db/id #edb/ref 17592186436867} {:answer/id #uuid "389d3dc9-f2d9-529c-b7ea-c8cccd9b9758" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\operatorname{cos}⁡y\\,(\\operatorname{sin}⁡{x}^{2}+2{x}^{2}\\operatorname{cos}⁡{x}^{2})" :db/id #edb/ref 17592186436872} {:answer/id #uuid "8fa64353-98e4-5b27-b477-8f4a86a4d387" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\operatorname{cos}⁡y\\,(\\operatorname{sin}⁡{x}^{2}+{x}^{2}\\operatorname{cos}⁡{x}^{2})" :db/id #edb/ref 17592186436883} {:answer/id #uuid "d92842af-236c-5961-af7b-7944f52022a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\operatorname{cos}⁡y\\,(\\operatorname{sin}⁡{x}^{2}+2\\operatorname{cos}⁡{x}^{2})" :db/id #edb/ref 17592186436891} {:answer/id #uuid "f25d4dc9-4e5b-55b9-b305-70d9c342d681" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\operatorname{sin}⁡y\\,(\\operatorname{cos}⁡{x}^{2}+2{x}^{2}\\operatorname{sin}⁡{x}^{2})" :db/id #edb/ref 17592186436896}] :answer-field/correct {:answer/id #uuid "389d3dc9-f2d9-529c-b7ea-c8cccd9b9758" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\operatorname{cos}⁡y\\,(\\operatorname{sin}⁡{x}^{2}+2{x}^{2}\\operatorname{cos}⁡{x}^{2})" :db/id #edb/ref 17592186436872} :answer-field/id #uuid "bcde5f17-b09d-5acb-97f8-219e272aac7c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186436903}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e658e0b8-0325-5757-88c4-d4fe9ead78af" :question/math-academy-id "q-132930" :question/problem "Calculate ${f}_{yxx}(x,y)$ given that $f(x,y)=\\operatorname{sin}⁡y\\operatorname{cos}⁡{x}^{2}.$" :question/worked-solution "First, we find the first-order derivative ${f}_{y}(x,y):$ \n\n$$\n\\begin{aligned}{f}_{y}(x,y) & =\\frac{∂}{∂y}(\\operatorname{sin}⁡y\\operatorname{cos}⁡{x}^{2}) \\\\  & =\\operatorname{cos}⁡{x}^{2}\\frac{∂}{∂y}(\\operatorname{sin}⁡y) \\\\  & =\\operatorname{cos}⁡{x}^{2}\\operatorname{cos}⁡y\\end{aligned}\n$$\n\nNext, we find ${f}_{yx}(x,y)$ by differentiating ${f}_{y}(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{f}_{yx}(x,y) & =\\frac{∂}{∂x}({f}_{y}(x,y)) \\\\  & =\\frac{∂}{∂x}(\\operatorname{cos}⁡{x}^{2}\\operatorname{cos}⁡y) \\\\  & =\\operatorname{cos}⁡y\\cdot (-2x\\operatorname{sin}⁡{x}^{2}) \\\\  & =-2x\\operatorname{sin}⁡{x}^{2}\\operatorname{cos}⁡y\\end{aligned}\n$$\n\nFinally, we find ${f}_{yxx}(x,y)$ by differentiating ${f}_{yx}(x,y)$ with respect to $x:$ \n\n$$\n\\begin{aligned}{f}_{yxx}(x,y) & =\\frac{∂}{∂x}({f}_{yx}(x,y)) \\\\  & =\\frac{∂}{∂x}(-2x\\operatorname{sin}⁡{x}^{2}\\operatorname{cos}⁡y) \\\\  & =\\operatorname{cos}⁡y\\cdot (-2\\operatorname{sin}⁡{x}^{2}-4{x}^{2}\\operatorname{cos}⁡{x}^{2}) \\\\  & =-2\\operatorname{cos}⁡y\\,(\\operatorname{sin}⁡{x}^{2}+2{x}^{2}\\operatorname{cos}⁡{x}^{2})\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186381069 :knowledge-point/_questions [{:db/id #edb/ref 17592186124442 :knowledge-point/id #uuid "83724b66-0f15-5b94-9576-76e9dfd56d38" :knowledge-point/title "Finding Higher-Order Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03d5b128-9cff-50f7-92d3-d12b64c6681f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186381071} {:answer/id #uuid "a441ccb0-2f8a-535a-ad8a-583f492794d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{9}" :db/id #edb/ref 17592186381072} {:answer/id #uuid "a34ca82a-d861-5b5f-9369-497429efb02c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{8}" :db/id #edb/ref 17592186381073} {:answer/id #uuid "005be97c-3318-5160-8963-0e2dca0a9c0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{16}" :db/id #edb/ref 17592186381074} {:answer/id #uuid "84c1f9d1-ec7c-53d8-90d2-3e9b6975372f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{16}" :db/id #edb/ref 17592186381075}] :answer-field/correct {:answer/id #uuid "a34ca82a-d861-5b5f-9369-497429efb02c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{8}" :db/id #edb/ref 17592186381073} :answer-field/id #uuid "3208b2b5-bf53-54c6-b739-ef239137d627" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381070}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "928e0d06-b25e-50d0-bfa3-2bcab1a87684" :question/math-academy-id "q-132973" :question/problem "Evaluate ${f}_{zxx}(1,0,1)$ for $f(x,y,z)=\\frac{z}{x+z}.$" :question/worked-solution "First, we find the first-order derivative ${f}_{z}(x,y,z):$\n\n$$\n\\begin{aligned}{f}_{z}(x,y,z) & =\\frac{∂}{∂z}(\\frac{z}{x+z}) \\\\  & =\\frac{x}{(x+z)^{2}}\\end{aligned}\n$$\n\nNow, we find ${f}_{zx}(x,y,z)$ by differentiating ${f}_{z}(x,y,z)$ with respect to $x:$\n\n$$\n\\begin{aligned}{f}_{zx}(x,y,z) & =\\frac{∂}{∂x}({f}_{z}(x,y,z)) \\\\  & =\\frac{∂}{∂x}(\\frac{x}{(x+z)^{2}}) \\\\  & =\\frac{(x+z)^{2}-2x(x+z)}{(x+z)^{4}} \\\\  & =\\frac{z-x}{(x+z)^{3}}\\end{aligned}\n$$\n\nNext, we find ${f}_{zxx}(x,y,z)$ by differentiating ${f}_{zx}(x,y,z)$ with respect to $x:$ \n\n$$\n\\begin{aligned}{f}_{zxx}(x,y,z) & =\\frac{∂}{∂x}({f}_{zy}(x,y,z)) \\\\  & =\\frac{∂}{∂x}(\\frac{z-x}{(x+z)^{3}}) \\\\  & =\\frac{-(x+z)^{3}-3(z-x)(x+z)^{2}}{(x+z)^{6}} \\\\  & =\\frac{2(x-2z)}{(x+z)^{4}}\\end{aligned}\n$$\n\n \n\nFinally, we evaluate ${f}_{zxx}(x,y,z)$ at $(1,0,1):$  \n\n$$\n\\begin{aligned}{f}_{zxx}(1,0,1) & =\\frac{2(1-2(1))}{(1+1)^{4}}=\\frac{-2}{16}=-\\frac{1}{8}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186124946 :knowledge-point/_questions [{:db/id #edb/ref 17592186124441 :knowledge-point/id #uuid "503a0bfe-7c69-5ad0-ad1d-aa8692dae673" :knowledge-point/title "Computing Expressions Involving Second-Order Partial Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f05c210-c0a0-5abb-b730-98796dd2186c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{(x-3y)^{2}}" :db/id #edb/ref 17592186436864} {:answer/id #uuid "28922764-7076-5aaf-bcbd-67e10b791794" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{(x-3y)^{2}}" :db/id #edb/ref 17592186436870} {:answer/id #uuid "5c5ccad9-69a4-5358-b839-33102f74fe79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3y-x}" :db/id #edb/ref 17592186436875} {:answer/id #uuid "87935253-16b1-59b3-afab-76bf68e9cd2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{(x-3y)^{2}}" :db/id #edb/ref 17592186436880} {:answer/id #uuid "8bbe0f5b-fa62-5197-8866-5256f43411b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{(x-3y)^{2}}" :db/id #edb/ref 17592186436881}] :answer-field/correct {:answer/id #uuid "8bbe0f5b-fa62-5197-8866-5256f43411b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{(x-3y)^{2}}" :db/id #edb/ref 17592186436881} :answer-field/id #uuid "c063a337-38aa-5596-b563-e9c7e99c9b17" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122276}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cb7a21d3-592c-577d-91a2-7365e19df69d" :question/math-academy-id "q-36014" :question/problem "Find ${g}_{xy}(x,y)+{g}_{xx}(x,y)$ given that  ${g}_{x}(x,y)=\\frac{1}{x-3y}.$" :question/worked-solution "To find ${g}_{xy}(x,y)$ we differentiate the given first-order partial derivative ${g}_{x}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{g}_{xy}(x,y) & =\\frac{∂}{∂y}({g}_{x}(x,y)) \\\\  & =\\frac{∂}{∂y}(\\frac{1}{x-3y}) \\\\  & =\\frac{3}{(x-3y)^{2}}\\end{aligned}\n$$\n\nTo find ${g}_{xx}(x,y)$ we differentiate the given first-order partial derivative ${g}_{x}(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{g}_{xx}(x,y) & =\\frac{∂}{∂x}({g}_{x}(x,y)) \\\\  & =\\frac{∂}{∂x}(\\frac{1}{x-3y}) \\\\  & =-\\frac{1}{(x-3y)^{2}}\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{g}_{xy}(x,y)+{g}_{xx}(x,y) & =\\frac{3}{(x-3y)^{2}}+(-\\frac{1}{(x-3y)^{2}}) \\\\  & =\\frac{2}{(x-3y)^{2}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186124948 :knowledge-point/_questions [{:db/id #edb/ref 17592186124442 :knowledge-point/id #uuid "83724b66-0f15-5b94-9576-76e9dfd56d38" :knowledge-point/title "Finding Higher-Order Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ac03de1-652b-5985-829a-d4f563b4f013" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186321231} {:answer/id #uuid "185580bd-9cc6-5540-8ee1-1837bdfe77d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186321341} {:answer/id #uuid "22497853-7a4b-5053-82a4-7c884988d174" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186321407} {:answer/id #uuid "68d3f72b-f450-57bb-a925-2dc21238378a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186321966} {:answer/id #uuid "e54d78bf-547b-50fd-9032-1d545e85b3e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186322943}] :answer-field/correct {:answer/id #uuid "22497853-7a4b-5053-82a4-7c884988d174" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186321407} :answer-field/id #uuid "a755a285-5a12-5e67-b7c4-bee828c410d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323491}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "83167862-effb-539c-8ffb-5705b88d44f1" :question/math-academy-id "q-36019" :question/problem "Evaluate ${f}_{xyz}(1,1,1)$ for $f(x,y,z)=\\frac{yz}{x-2z}.$" :question/worked-solution "First, we find the first-order derivative ${f}_{x}(x,y,z):$\n\n$$\n\\begin{aligned}{f}_{x}(x,y,z) & =\\frac{∂}{∂x}(\\frac{yz}{x-2z}) \\\\  & =-\\frac{yz}{(x-2z)^{2}}\\end{aligned}\n$$\n\nNow, we find ${f}_{xy}(x,y,z)$ by differentiating ${f}_{x}(x,y,z)$ with respect to $y:$\n\n$$\n\\begin{aligned}{f}_{xy}(x,y,z) & =\\frac{∂}{∂y}({f}_{x}(x,y,z)) \\\\  & =\\frac{∂}{∂y}(-\\frac{yz}{(x-2z)^{2}}) \\\\  & =-\\frac{z}{(x-2z)^{2}}\\end{aligned}\n$$\n\nNext, we find ${f}_{xyz}(x,y,z)$ by differentiating ${f}_{xy}(x,y,z)$ with respect to $z:$ \n\n$$\n\\begin{aligned}{f}_{xyz}(x,y,z) & =\\frac{∂}{∂z}({f}_{xy}(x,y,z)) \\\\  & =\\frac{∂}{∂z}(-\\frac{z}{(x-2z)^{2}}) \\\\  & =-\\frac{1\\cdot (x-2z)^{2}-z\\cdot 2(x-2z)\\cdot (-2)}{(x-2z)^{4}} \\\\  & =-\\frac{(x-2z)^{2}+4z(x-2z)}{(x-2z)^{4}} \\\\  & =-\\frac{x-2z+4z}{(x-2z)^{3}} \\\\  & =-\\frac{x+2z}{(x-2z)^{3}}\\end{aligned}\n$$\n\nFinally, we evaluate ${f}_{xyz}(x,y,z)$ at $(1,1,1):$\n\n$$\n\\begin{aligned}{f}_{xyz}(1,1,1) & =-\\frac{1+2\\cdot 1}{(1-2\\cdot 1)^{3}}=3\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186382138 :knowledge-point/_questions [{:db/id #edb/ref 17592186124440 :knowledge-point/id #uuid "7ea31275-77bd-59c7-8e1d-96e2e4b252a4" :knowledge-point/title "Finding Mixed Second-Order Partial Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86e47b3c-f8f9-5e18-9d28-6f36b2c27a42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{3}-{y}^{3}}{{x}^{3}+{y}^{3}}" :db/id #edb/ref 17592186382140} {:answer/id #uuid "6188f36a-ac69-5d7a-b9fc-397b48fca9ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{3}}{{({x}^{3}+{y}^{3})}^{2}}" :db/id #edb/ref 17592186382141} {:answer/id #uuid "291c128e-6369-5cd6-aadd-033a32d1485e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y({x}^{3}-{y}^{3})}{{({x}^{3}+{y}^{3})}^{2}}" :db/id #edb/ref 17592186382142} {:answer/id #uuid "ed41aa2c-c8b0-5b09-a441-f7cad2ab71a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3y(2{x}^{3}-{y}^{3})}{{({x}^{3}+{y}^{3})}^{2}}" :db/id #edb/ref 17592186382143} {:answer/id #uuid "dcba6b3f-e253-5f01-8e9a-cad9140c3ae4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-{y}^{3}}{{x}^{3}+{y}^{3}}" :db/id 