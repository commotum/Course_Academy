436872 #edb/ref 17592186045417] [17592186436903 #edb/ref 1075 #edb/ref 17592186436883 #edb/ref 17592186045417] [17592186436903 #edb/ref 1075 #edb/ref 17592186436891 #edb/ref 17592186045417] [17592186436903 #edb/ref 1075 #edb/ref 17592186436896 #edb/ref 17592186045417] [17592186436903 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186436903 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186436903 #edb/ref 1078 #edb/ref 17592186436872 #edb/ref 17592186045417] [17592186436903 #edb/ref 1079 #uuid "bcde5f17-b09d-5acb-97f8-219e272aac7c" #edb/ref 17592186045417] [17592186436904 #edb/ref 1068 #edb/ref 17592186436898 #edb/ref 17592186045417] [17592186436904 #edb/ref 1069 "q-132874" #edb/ref 17592186045417] [17592186436904 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186436904 #edb/ref 1071 "Find ${g}_{xy}(x,y)+{g}_{xx}(x,y)$ given that  ${g}_{x}(x,y)=\\frac{x}{x-{y}^{2}}.$" #edb/ref 17592186045417] [17592186436904 #edb/ref 1072 #uuid "073f1d9a-253b-5fca-9478-5f95eebb298d" #edb/ref 17592186045417] [17592186436904 #edb/ref 1074 "To find ${g}_{xy}(x,y)$ we differentiate the given first-order partial derivative ${g}_{x}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{g}_{xy}(x,y) & =\\frac{∂}{∂y}({g}_{x}(x,y)) \\\\  & =\\frac{∂}{∂y}(\\frac{x}{x-{y}^{2}}) \\\\  & =\\frac{2xy}{(x-{y}^{2})^{2}}\\end{aligned}\n$$\n\nTo find ${g}_{xx}(x,y)$ we differentiate the given first-order partial derivative ${g}_{x}(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{g}_{xx}(x,y) & =\\frac{∂}{∂x}({g}_{x}(x,y)) \\\\  & =\\frac{∂}{∂x}(\\frac{x}{x-{y}^{2}}) \\\\  & =\\frac{(x-{y}^{2})-x}{(x-{y}^{2})^{2}} \\\\  & =-\\frac{{y}^{2}}{(x-{y}^{2})^{2}}\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{g}_{xy}(x,y)+{g}_{xx}(x,y) & =\\frac{2xy}{(x-{y}^{2})^{2}}+(-\\frac{{y}^{2}}{(x-{y}^{2})^{2}}) \\\\  & =\\frac{2xy-{y}^{2}}{(x-{y}^{2})^{2}} \\\\  & =\\frac{y(2x-y)}{(x-{y}^{2})^{2}}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186436905 #edb/ref 1068 #edb/ref 17592186436901 #edb/ref 17592186045417] [17592186436905 #edb/ref 1069 "q-132766" #edb/ref 17592186045417] [17592186436905 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186436905 #edb/ref 1071 "For the function $f(x,y),$ calculate $\\frac{{∂}^{2}f}{∂{x}^{2}}$ given that $\\frac{∂f}{∂x}=-\\frac{{y}^{2}+2}{{x}^{3}}.$" #edb/ref 17592186045417] [17592186436905 #edb/ref 1072 #uuid "0e8c2128-4248-5b42-9124-e32c52ba652f" #edb/ref 17592186045417] [17592186436905 #edb/ref 1074 "To find $\\frac{{∂}^{2}f}{∂{x}^{2}}$ we differentiate the given first-order partial derivative $\\frac{∂f}{∂x}$ with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(\\frac{∂f}{∂x}) \\\\  & =\\frac{∂}{∂x}(-\\frac{{y}^{2}+2}{{x}^{3}}) \\\\  & =-({y}^{2}+2)\\cdot (-\\frac{3}{{x}^{4}}) \\\\  & =\\frac{3({y}^{2}+2)}{{x}^{4}}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186436906 #edb/ref 1068 #edb/ref 17592186436900 #edb/ref 17592186045417] [17592186436906 #edb/ref 1069 "q-132929" #edb/ref 17592186045417] [17592186436906 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186436906 #edb/ref 1071 "Calculate ${f}_{xyx}(x,y)$ given that $f(x,y)=y{e}^{2x}+\\sqrt{\\operatorname{ln}⁡y}.$" #edb/ref 17592186045417] [17592186436906 #edb/ref 1072 #uuid "ab886db8-155f-5495-98ff-0f64afbbb0bd" #edb/ref 17592186045417] [17592186436906 #edb/ref 1074 "First, we find the first-order derivative ${f}_{x}(x,y):$\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}(y{e}^{2x}+\\sqrt{\\operatorname{ln}⁡y}) \\\\  & =2y{e}^{2x}\\end{aligned}\n$$\n\nNext, we find ${f}_{xy}(x,y)$ by differentiating ${f}_{x}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}({f}_{x}(x,y)) \\\\  & =\\frac{∂}{∂y}(2y{e}^{2x}) \\\\  & =2{e}^{2x}\\end{aligned}\n$$\n\nFinally, we find ${f}_{xyx}(x,y)$ by differentiating ${f}_{xy}(x,y)$ with respect to $x:$ \n\n$$\n\\begin{aligned}{f}_{xyx}(x,y) & =\\frac{∂}{∂x}({f}_{xy}(x,y)) \\\\  & =\\frac{∂}{∂x}(2{e}^{2x}) \\\\  & =4{e}^{2x}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186436907 #edb/ref 1068 #edb/ref 17592186436902 #edb/ref 17592186045417] [17592186436907 #edb/ref 1069 "q-132801" #edb/ref 17592186045417] [17592186436907 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186436907 #edb/ref 1071 "For the function $f(x,y),$ calculate $\\frac{{∂}^{2}f}{∂{x}^{2}}$ given that $\\frac{∂f}{∂x}=\\frac{\\operatorname{sin}⁡(2x-y)}{xy}.$" #edb/ref 17592186045417] [17592186436907 #edb/ref 1072 #uuid "cca3fd6b-4c7e-554a-be83-06e03ae9adfd" #edb/ref 17592186045417] [17592186436907 #edb/ref 1074 "To find $\\frac{{∂}^{2}f}{∂{x}^{2}}$ we differentiate the given first-order partial derivative $\\frac{∂f}{∂x}$ with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(\\frac{∂f}{∂x}) \\\\  & =\\frac{∂}{∂x}(\\frac{\\operatorname{sin}⁡(2x-y)}{xy}) \\\\  & =\\frac{1}{y}\\cdot (\\frac{2\\operatorname{cos}⁡(2x-y)\\cdot x-\\operatorname{sin}⁡(2x-y)\\cdot 1}{{x}^{2}}) \\\\  & =\\frac{2x\\operatorname{cos}⁡(2x-y)-\\operatorname{sin}⁡(2x-y)}{{x}^{2}y}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186436908 #edb/ref 1068 #edb/ref 17592186436899 #edb/ref 17592186045417] [17592186436908 #edb/ref 1069 "q-132888" #edb/ref 17592186045417] [17592186436908 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186436908 #edb/ref 1071 "Find ${f}_{xy}(x,y)+{f}_{yx}(x,y)$ given that  ${f}_{x}(x,y)=\\frac{1}{{e}^{x+2y}}$ and ${f}_{y}(x,y)=\\frac{2}{{e}^{x+2y}}.$" #edb/ref 17592186045417] [17592186436908 #edb/ref 1072 #uuid "df95e8a9-100a-5208-bae6-3713a6f72f62" #edb/ref 17592186045417] [17592186436908 #edb/ref 1074 "To find ${f}_{xy}(x,y)$ we differentiate the given first-order partial derivative ${f}_{x}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}({f}_{x}(x,y)) \\\\  & =\\frac{∂}{∂y}(\\frac{1}{{e}^{x+2y}}) \\\\  & =-\\frac{2}{{e}^{x+2y}}\\end{aligned}\n$$\n\nTo find ${f}_{yx}(x,y)$ we differentiate the given first-order partial derivative ${f}_{y}(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{f}_{yx}(x,y) & =\\frac{∂}{∂x}({f}_{y}(x,y)) \\\\  & =\\frac{∂}{∂x}(\\frac{2}{{e}^{x+2y}}) \\\\  & =-\\frac{2}{{e}^{x+2y}}\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y)+{f}_{yx}(x,y) & =-\\frac{2}{{e}^{x+2y}}-\\frac{2}{{e}^{x+2y}} \\\\  & =-\\frac{4}{{e}^{x+2y}}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186436909 #edb/ref 1068 #edb/ref 17592186436903 #edb/ref 17592186045417] [17592186436909 #edb/ref 1069 "q-132930" #edb/ref 17592186045417] [17592186436909 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186436909 #edb/ref 1071 "Calculate ${f}_{yxx}(x,y)$ given that $f(x,y)=\\operatorname{sin}⁡y\\operatorname{cos}⁡{x}^{2}.$" #edb/ref 17592186045417] [17592186436909 #edb/ref 1072 #uuid "e658e0b8-0325-5757-88c4-d4fe9ead78af" #edb/ref 17592186045417] [17592186436909 #edb/ref 1074 "First, we find the first-order derivative ${f}_{y}(x,y):$ \n\n$$\n\\begin{aligned}{f}_{y}(x,y) & =\\frac{∂}{∂y}(\\operatorname{sin}⁡y\\operatorname{cos}⁡{x}^{2}) \\\\  & =\\operatorname{cos}⁡{x}^{2}\\frac{∂}{∂y}(\\operatorname{sin}⁡y) \\\\  & =\\operatorname{cos}⁡{x}^{2}\\operatorname{cos}⁡y\\end{aligned}\n$$\n\nNext, we find ${f}_{yx}(x,y)$ by differentiating ${f}_{y}(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{f}_{yx}(x,y) & =\\frac{∂}{∂x}({f}_{y}(x,y)) \\\\  & =\\frac{∂}{∂x}(\\operatorname{cos}⁡{x}^{2}\\operatorname{cos}⁡y) \\\\  & =\\operatorname{cos}⁡y\\cdot (-2x\\operatorname{sin}⁡{x}^{2}) \\\\  & =-2x\\operatorname{sin}⁡{x}^{2}\\operatorname{cos}⁡y\\end{aligned}\n$$\n\nFinally, we find ${f}_{yxx}(x,y)$ by differentiating ${f}_{yx}(x,y)$ with respect to $x:$ \n\n$$\n\\begin{aligned}{f}_{yxx}(x,y) & =\\frac{∂}{∂x}({f}_{yx}(x,y)) \\\\  & =\\frac{∂}{∂x}(-2x\\operatorname{sin}⁡{x}^{2}\\operatorname{cos}⁡y) \\\\  & =\\operatorname{cos}⁡y\\cdot (-2\\operatorname{sin}⁡{x}^{2}-4{x}^{2}\\operatorname{cos}⁡{x}^{2}) \\\\  & =-2\\operatorname{cos}⁡y\\,(\\operatorname{sin}⁡{x}^{2}+2{x}^{2}\\operatorname{cos}⁡{x}^{2})\\end{aligned}\n$$" #edb/ref 17592186045417]}
