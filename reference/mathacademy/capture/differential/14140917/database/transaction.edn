 \\\\  & =\\frac{1}{y}\\cdot (\\frac{2\\operatorname{cos}⁡(2x-y)\\cdot x-\\operatorname{sin}⁡(2x-y)\\cdot 1}{{x}^{2}}) \\\\  & =\\frac{2x\\operatorname{cos}⁡(2x-y)-\\operatorname{sin}⁡(2x-y)}{{x}^{2}y}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b088d621-a153-59a3-b489-cec7c0d60c3e"] :db/ensure [:question/validate]} {:db/id "answer-field-b088d621-a153-59a3-b489-cec7c0d60c3e" :answer-field/id #uuid "b088d621-a153-59a3-b489-cec7c0d60c3e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6e16fead-d7a4-5f11-af57-d52230ead1dd" :answer-field/choices ["answer-53fc4b27-5931-514e-ac5a-d3a502d333bd" "answer-3288153e-27f3-5222-851e-a6b3e5822126" "answer-6e16fead-d7a4-5f11-af57-d52230ead1dd" "answer-72704398-44ea-5224-9ffc-3f29a7a9b2b8" "answer-dd8d7902-7b74-5922-be87-0951b9ee8845"] :db/ensure [:answer-field/validate]} {:db/id "answer-53fc4b27-5931-514e-ac5a-d3a502d333bd" :answer/id #uuid "53fc4b27-5931-514e-ac5a-d3a502d333bd" :answer/type :answer.type/math :answer/value "-\\frac{y\\operatorname{cos}⁡(2x-y)+\\operatorname{sin}⁡(2x-y)}{x{y}^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-3288153e-27f3-5222-851e-a6b3e5822126" :answer/id #uuid "3288153e-27f3-5222-851e-a6b3e5822126" :answer/type :answer.type/math :answer/value "\\frac{2\\operatorname{cos}⁡(2x-y)-x\\operatorname{sin}⁡(2x-y)}{{x}^{2}y}" :db/ensure [:answer/validate]} {:db/id "answer-6e16fead-d7a4-5f11-af57-d52230ead1dd" :answer/id #uuid "6e16fead-d7a4-5f11-af57-d52230ead1dd" :answer/type :answer.type/math :answer/value "\\frac{2x\\operatorname{cos}⁡(2x-y)-\\operatorname{sin}⁡(2x-y)}{{x}^{2}y}" :db/ensure [:answer/validate]} {:db/id "answer-72704398-44ea-5224-9ffc-3f29a7a9b2b8" :answer/id #uuid "72704398-44ea-5224-9ffc-3f29a7a9b2b8" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{cos}⁡(2x-y)+2x\\operatorname{sin}⁡(2x-y)}{{x}^{2}y}" :db/ensure [:answer/validate]} {:db/id "answer-dd8d7902-7b74-5922-be87-0951b9ee8845" :answer/id #uuid "dd8d7902-7b74-5922-be87-0951b9ee8845" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{cos}⁡(2x-y)-2x\\operatorname{sin}⁡(2x-y)}{{x}^{2}y}" :db/ensure [:answer/validate]} {:db/id "question-073f1d9a-253b-5fca-9478-5f95eebb298d" :question/id #uuid "073f1d9a-253b-5fca-9478-5f95eebb298d" :question/math-academy-id "q-132874" :question/problem "Find ${g}_{xy}(x,y)+{g}_{xx}(x,y)$ given that  ${g}_{x}(x,y)=\\frac{x}{x-{y}^{2}}.$" :question/worked-solution "To find ${g}_{xy}(x,y)$ we differentiate the given first-order partial derivative ${g}_{x}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{g}_{xy}(x,y) & =\\frac{∂}{∂y}({g}_{x}(x,y)) \\\\  & =\\frac{∂}{∂y}(\\frac{x}{x-{y}^{2}}) \\\\  & =\\frac{2xy}{(x-{y}^{2})^{2}}\\end{aligned}\n$$\n\nTo find ${g}_{xx}(x,y)$ we differentiate the given first-order partial derivative ${g}_{x}(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{g}_{xx}(x,y) & =\\frac{∂}{∂x}({g}_{x}(x,y)) \\\\  & =\\frac{∂}{∂x}(\\frac{x}{x-{y}^{2}}) \\\\  & =\\frac{(x-{y}^{2})-x}{(x-{y}^{2})^{2}} \\\\  & =-\\frac{{y}^{2}}{(x-{y}^{2})^{2}}\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{g}_{xy}(x,y)+{g}_{xx}(x,y) & =\\frac{2xy}{(x-{y}^{2})^{2}}+(-\\frac{{y}^{2}}{(x-{y}^{2})^{2}}) \\\\  & =\\frac{2xy-{y}^{2}}{(x-{y}^{2})^{2}} \\\\  & =\\frac{y(2x-y)}{(x-{y}^{2})^{2}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-0cbecb11-fc1e-5429-8a31-6669c257052c"] :db/ensure [:question/validate]} {:db/id "answer-field-0cbecb11-fc1e-5429-8a31-6669c257052c" :answer-field/id #uuid "0cbecb11-fc1e-5429-8a31-6669c257052c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-952f8752-f377-5815-9aa1-8c3f1ffd9a60" :answer-field/choices ["answer-d28548cb-cc1a-5f3a-a5c8-7ddc23cddc53" "answer-b79801c6-fc3f-56c0-b92d-bee8cdce573c" "answer-d27f13da-e7e3-56ca-9de8-a5af29c4d179" "answer-73c25a30-7b77-51c9-b420-ba135dbcd471" "answer-952f8752-f377-5815-9aa1-8c3f1ffd9a60"] :db/ensure [:answer-field/validate]} {:db/id "answer-d28548cb-cc1a-5f3a-a5c8-7ddc23cddc53" :answer/id #uuid "d28548cb-cc1a-5f3a-a5c8-7ddc23cddc53" :answer/type :answer.type/math :answer/value "\\frac{2x+y}{(x-{y}^{2})^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-b79801c6-fc3f-56c0-b92d-bee8cdce573c" :answer/id #uuid "b79801c6-fc3f-56c0-b92d-bee8cdce573c" :answer/type :answer.type/math :answer/value "\\frac{2x-y}{(x-{y}^{2})^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-d27f13da-e7e3-56ca-9de8-a5af29c4d179" :answer/id #uuid "d27f13da-e7e3-56ca-9de8-a5af29c4d179" :answer/type :answer.type/math :answer/value "\\frac{2x-{y}^{2}}{(x-{y}^{2})^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-73c25a30-7b77-51c9-b420-ba135dbcd471" :answer/id #uuid "73c25a30-7b77-51c9-b420-ba135dbcd471" :answer/type :answer.type/math :answer/value "\\frac{y(2x+y)}{(x-{y}^{2})^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-952f8752-f377-5815-9aa1-8c3f1ffd9a60" :answer/id #uuid "952f8752-f377-5815-9aa1-8c3f1ffd9a60" :answer/type :answer.type/math :answer/value "\\frac{y(2x-y)}{(x-{y}^{2})^{2}}" :db/ensure [:answer/validate]} {:db/id 17592186124946 :question/problem "Find ${g}_{xy}(x,y)+{g}_{xx}(x,y)$ given that  ${g}_{x}(x,y)=\\frac{1}{x-3y}.$" :question/worked-solution "To find ${g}_{xy}(x,y)$ we differentiate the given first-order partial derivative ${g}_{x}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{g}_{xy}(x,y) & =\\frac{∂}{∂y}({g}_{x}(x,y)) \\\\  & =\\frac{∂}{∂y}(\\frac{1}{x-3y}) \\\\  & =\\frac{3}{(x-3y)^{2}}\\end{aligned}\n$$\n\nTo find ${g}_{xx}(x,y)$ we differentiate the given first-order partial derivative ${g}_{x}(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{g}_{xx}(x,y) & =\\frac{∂}{∂x}({g}_{x}(x,y)) \\\\  & =\\frac{∂}{∂x}(\\frac{1}{x-3y}) \\\\  & =-\\frac{1}{(x-3y)^{2}}\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{g}_{xy}(x,y)+{g}_{xx}(x,y) & =\\frac{3}{(x-3y)^{2}}+(-\\frac{1}{(x-3y)^{2}}) \\\\  & =\\frac{2}{(x-3y)^{2}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186122276 :answer-field/correct "answer-8bbe0f5b-fa62-5197-8866-5256f43411b4" :answer-field/choices ["answer-87935253-16b1-59b3-afab-76bf68e9cd2f" "answer-5c5ccad9-69a4-5358-b839-33102f74fe79" "answer-0f05c210-c0a0-5abb-b730-98796dd2186c" "answer-8bbe0f5b-fa62-5197-8866-5256f43411b4" "answer-28922764-7076-5aaf-bcbd-67e10b791794"] :db/ensure [:answer-field/validate]} {:db/id "answer-87935253-16b1-59b3-afab-76bf68e9cd2f" :answer/id #uuid "87935253-16b1-59b3-afab-76bf68e9cd2f" :answer/type :answer.type/math :answer/value "-\\frac{1}{(x-3y)^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-5c5ccad9-69a4-5358-b839-33102f74fe79" :answer/id #uuid "5c5ccad9-69a4-5358-b839-33102f74fe79" :answer/type :answer.type/math :answer/value "-\\frac{1}{3y-x}" :db/ensure [:answer/validate]} {:db/id "answer-0f05c210-c0a0-5abb-b730-98796dd2186c" :answer/id #uuid "0f05c210-c0a0-5abb-b730-98796dd2186c" :answer/type :answer.type/math :answer/value "-\\frac{3}{(x-3y)^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-8bbe0f5b-fa62-5197-8866-5256f43411b4" :answer/id #uuid "8bbe0f5b-fa62-5197-8866-5256f43411b4" :answer/type :answer.type/math :answer/value "\\frac{2}{(x-3y)^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-28922764-7076-5aaf-bcbd-67e10b791794" :answer/id #uuid "28922764-7076-5aaf-bcbd-67e10b791794" :answer/type :answer.type/math :answer/value "\\frac{6}{(x-3y)^{2}}" :db/ensure [:answer/validate]} {:db/id "question-df95e8a9-100a-5208-bae6-3713a6f72f62" :question/id #uuid "df95e8a9-100a-5208-bae6-3713a6f72f62" :question/math-academy-id "q-132888" :question/problem "Find ${f}_{xy}(x,y)+{f}_{yx}(x,y)$ given that  ${f}_{x}(x,y)=\\frac{1}{{e}^{x+2y}}$ and ${f}_{y}(x,y)=\\frac{2}{{e}^{x+2y}}.$" :question/worked-solution "To find ${f}_{xy}(x,y)$ we differentiate the given first-order partial derivative ${f}_{x}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}({f}_{x}(x,y)) \\\\  & =\\frac{∂}{∂y}(\\frac{1}{{e}^{x+2y}}) \\\\  & =-\\frac{2}{{e}^{x+2y}}\\end{aligned}\n$$\n\nTo find ${f}_{yx}(x,y)$ we differentiate the given first-order partial derivative ${f}_{y}(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{f}_{yx}(x,y) & =\\frac{∂}{∂x}({f}_{y}(x,y)) \\\\  & =\\frac{∂}{∂x}(\\frac{2}{{e}^{x+2y}}) \\\\  & =-\\frac{2}{{e}^{x+2y}}\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y)+{f}_{yx}(x,y) & =-\\frac{2}{{e}^{x+2y}}-\\frac{2}{{e}^{x+2y}} \\\\  & =-\\frac{4}{{e}^{x+2y}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-4d617cd6-186e-5d2d-a053-2c09090395a0"] :db/ensure [:question/validate]} {:db/id "answer-field-4d617cd6-186e-5d2d-a053-2c09090395a0" :answer-field/id #uuid "4d617cd6-186e-5d2d-a053-2c09090395a0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9138702f-62d8-5c8c-8589-5657bfa2f9d6" :answer-field/choices ["answer-f0ca5008-806b-567a-b135-7a08f2d5620c" "answer-defd66f9-2cdd-5a46-b6fa-affd8cc6128d" "answer-9138702f-62d8-5c8c-8589-5657bfa2f9d6" "answer-0b6c9b46-c3c9-5483-8476-52cbdd59ac4c" "answer-244430db-783b-5513-8f92-180fb3fb6d6c"] :db/ensure [:answer-field/validate]} {:db/id "answer-f0ca5008-806b-567a-b135-7a08f2d5620c" :answer/id #uuid "f0ca5008-806b-567a-b135-7a08f2d5620c" :answer/type :answer.type/math :answer/value "-\\frac{2xy}{{e}^{x+2y}}" :db/ensure [:answer/validate]} {:db/id "answer-defd66f9-2cdd-5a46-b6fa-affd8cc6128d" :answer/id #uuid "defd66f9-2cdd-5a46-b6fa-affd8cc6128d" :answer/type :answer.type/math :answer/value "-\\frac{2}{{e}^{x+2y}}" :db/ensure [:answer/validate]} {:db/id "answer-9138702f-62d8-5c8c-8589-5657bfa2f9d6" :answer/id #uuid "9138702f-62d8-5c8c-8589-5657bfa2f9d6" :answer/type :answer.type/math :answer/value "-\\frac{4}{{e}^{x+2y}}" :db/ensure [:answer/validate]} {:db/id "answer-0b6c9b46-c3c9-5483-8476-52cbdd59ac4c" :answer/id #uuid "0b6c9b46-c3c9-5483-8476-52cbdd59ac4c" :answer/type :answer.type/math :answer/value "\\frac{2}{{e}^{x+2y}}" :db/ensure [:answer/validate]} {:db/id "answer-244430db-783b-5513-8f92-180fb3fb6d6c" :answer/id #uuid "244430db-783b-5513-8f92-180fb3fb6d6c" :answer/type :answer.type/math :answer/value "\\frac{4}{{e}^{x+2y}}" :db/ensure [:answer/validate]} {:db/id "question-e658e0b8-0325-5757-88c4-d4fe9ead78af" :question/id #uuid "e658e0b8-0325-5757-88c4-d4fe9ead78af" :question/math-academy-id "q-132930" :question/problem "Calculate ${f}_{yxx}(x,y)$ given that $f(x,y)=\\operatorname{sin}⁡y\\operatorname{cos}⁡{x}^{2}.$" :question/worked-solution "First, we find the first-order derivative ${f}_{y}(x,y):$ \n\n$$\n\\begin{aligned}{f}_{y}(x,y) & =\\frac{∂}{∂y}(\\operatorname{sin}⁡y\\operatorname{cos}⁡{x}^{2}) \\\\  & =\\operatorname{cos}⁡{x}^{2}\\frac{∂}{∂y}(\\operatorname{sin}⁡y) \\\\  & =\\operatorname{cos}⁡{x}^{2}\\operatorname{cos}⁡y\\end{aligned}\n$$\n\nNext, we find ${f}_{yx}(x,y)$ by differentiating ${f}_{y}(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{f}_{yx}(x,y) & =\\frac{∂}{∂x}({f}_{y}(x,y)) \\\\  & =\\frac{∂}{∂x}(\\operatorname{cos}⁡{x}^{2}\\operatorname{cos}⁡y) \\\\  & =\\operatorname{cos}⁡y\\cdot (-2x\\operatorname{sin}⁡{x}^{2}) \\\\  & =-2x\\operatorname{sin}⁡{x}^{2}\\operatorname{cos}⁡y\\end{aligned}\n$$\n\nFinally, we find ${f}_{yxx}(x,y)$ by differentiating ${f}_{yx}(x,y)$ with respect to $x:$ \n\n$$\n\\begin{aligned}{f}_{yxx}(x,y) & =\\frac{∂}{∂x}({f}_{yx}(x,y)) \\\\  & =\\frac{∂}{∂x}(-2x\\operatorname{sin}⁡{x}^{2}\\operatorname{cos}⁡y) \\\\  & =\\operatorname{cos}⁡y\\cdot (-2\\operatorname{sin}⁡{x}^{2}-4{x}^{2}\\operatorname{cos}⁡{x}^{2}) \\\\  & =-2\\operatorname{cos}⁡y\\,(\\operatorname{sin}⁡{x}^{2}+2{x}^{2}\\operatorname{cos}⁡{x}^{2})\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-bcde5f17-b09d-5acb-97f8-219e272aac7c"] :db/ensure [:question/validate]} {:db/id "answer-field-bcde5f17-b09d-5acb-97f8-219e272aac7c" :answer-field/id #uuid "bcde5f17-b09d-5acb-97f8-219e272aac7c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-389d3dc9-f2d9-529c-b7ea-c8cccd9b9758" :answer-field/choices ["answer-d92842af-236c-5961-af7b-7944f52022a3" "answer-389d3dc9-f2d9-529c-b7ea-c8cccd9b9758" "answer-8fa64353-98e4-5b27-b477-8f4a86a4d387" "answer-f25d4dc9-4e5b-55b9-b305-70d9c342d681" "answer-18c37a0f-f8cb-5b42-a75e-149ceaf31b64"] :db/ensure [:answer-field/validate]} {:db/id "answer-d92842af-236c-5961-af7b-7944f52022a3" :answer/id #uuid "d92842af-236c-5961-af7b-7944f52022a3" :answer/type :answer.type/math :answer/value "-2\\operatorname{cos}⁡y\\,(\\operatorname{sin}⁡{x}^{2}+2\\operatorname{cos}⁡{x}^{2})" :db/ensure [:answer/validate]} {:db/id "answer-389d3dc9-f2d9-529c-b7ea-c8cccd9b9758" :answer/id #uuid "389d3dc9-f2d9-529c-b7ea-c8cccd9b9758" :answer/type :answer.type/math :answer/value "-2\\operatorname{cos}⁡y\\,(\\operatorname{sin}⁡{x}^{2}+2{x}^{2}\\operatorname{cos}⁡{x}^{2})" :db/ensure [:answer/validate]} {:db/id "answer-8fa64353-98e4-5b27-b477-8f4a86a4d387" :answer/id #uuid "8fa64353-98e4-5b27-b477-8f4a86a4d387" :answer/type :answer.type/math :answer/value "-2\\operatorname{cos}⁡y\\,(\\operatorname{sin}⁡{x}^{2}+{x}^{2}\\operatorname{cos}⁡{x}^{2})" :db/ensure [:answer/validate]} {:db/id "answer-f25d4dc9-4e5b-55b9-b305-70d9c342d681" :answer/id #uuid "f25d4dc9-4e5b-55b9-b305-70d9c342d681" :answer/type :answer.type/math :answer/value "-2\\operatorname{sin}⁡y\\,(\\operatorname{cos}⁡{x}^{2}+2{x}^{2}\\operatorname{sin}⁡{x}^{2})" :db/ensure [:answer/validate]} {:db/id "answer-18c37a0f-f8cb-5b42-a75e-149ceaf31b64" :answer/id #uuid "18c37a0f-f8cb-5b42-a75e-149ceaf31b64" :answer/type :answer.type/math :answer/value "2\\operatorname{cos}⁡y\\,(\\operatorname{sin}⁡{x}^{2}-2{x}^{2}\\operatorname{cos}⁡{x}^{2})" :db/ensure [:answer/validate]} {:db/id "question-ab886db8-155f-5495-98ff-0f64afbbb0bd" :question/id #uuid "ab886db8-155f-5495-98ff-0f64afbbb0bd" :question/math-academy-id "q-132929" :question/problem "Calculate ${f}_{xyx}(x,y)$ given that $f(x,y)=y{e}^{2x}+\\sqrt{\\operatorname{ln}⁡y}.$" :question/worked-solution "First, we find the first-order derivative ${f}_{x}(x,y):$\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}(y{e}^{2x}+\\sqrt{\\operatorname{ln}⁡y}) \\\\  & =2y{e}^{2x}\\end{aligned}\n$$\n\nNext, we find ${f}_{xy}(x,y)$ by differentiating ${f}_{x}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}({f}_{x}(x,y)) \\\\  & =\\frac{∂}{∂y}(2y{e}^{2x}) \\\\  & =2{e}^{2x}\\end{aligned}\n$$\n\nFinally, we find ${f}_{xyx}(x,y)$ by differentiating ${f}_{xy}(x,y)$ with respect to $x:$ \n\n$$\n\\begin{aligned}{f}_{xyx}(x,y) & =\\frac{∂}{∂x}({f}_{xy}(x,y)) \\\\  & =\\frac{∂}{∂x}(2{e}^{2x}) \\\\  & =4{e}^{2x}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-7c0dcfcc-85cf-5a26-b153-8427ed1851d9"] :db/ensure [:question/validate]} {:db/id "answer-field-7c0dcfcc-85cf-5a26-b153-8427ed1851d9" :answer-field/id #uuid "7c0dcfcc-85cf-5a26-b153-8427ed1851d9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-11de066d-e9e2-5d24-a361-76b8dd01b39d" :answer-field/choices ["answer-6d8c9b27-0381-54e8-bb1c-7c96aeb216a2" "answer-25385035-93dd-5e7e-9e2e-385ef7c008a0" "answer-f9dbfa95-399f-56ca-90aa-62c4f3c1c9c7" "answer-11de066d-e9e2-5d24-a361-76b8dd01b39d" "answer-d2c77cb4-0a48-56ef-9208-44ab43d1f3fe"] :db/ensure [:answer-field/validate]} {:db/id "answer-6d8c9b27-0381-54e8-bb1c-7c96aeb216a2" :answer/id #uuid "6d8c9b27-0381-54e8-bb1c-7c96aeb216a2" :answer/type :answer.type/math :answer/value "2y{e}^{2x}" :db/ensure [:answer/validate]} {:db/id "answer-25385035-93dd-5e7e-9e2e-385ef7c008a0" :answer/id #uuid "25385035-93dd-5e7e-9e2e-385ef7c008a0" :answer/type :answer.type/math :answer/value "2{e}^{2x}" :db/ensure [:answer/validate]} {:db/id "answer-f9dbfa95-399f-56ca-90aa-62c4f3c1c9c7" :answer/id #uuid "f9dbfa95-399f-56ca-90aa-62c4f3c1c9c7" :answer/type :answer.type/math :answer/value "2{e}^{2x}+\\frac{1}{2\\operatorname{ln}⁡y}" :db/ensure [:answer/validate]} {:db/id "answer-11de066d-e9e2-5d24-a361-76b8dd01b39d" :answer/id #uuid "11de066d-e9e2-5d24-a361-76b8dd01b39d" :answer/type :answer.type/math :answer/value "4{e}^{2x}" :db/ensure [:answer/validate]} {:db/id "answer-d2c77cb4-0a48-56ef-9208-44ab43d1f3fe" :answer/id #uuid "d2c77cb4-0a48-56ef-9208-44ab43d1f3fe" :answer/type :answer.type/math :answer/value "4{e}^{2x}+\\frac{1}{2\\sqrt{\\operatorname{ln}⁡y}}" :db/ensure [:answer/validate]} {:db/id 17592186125725 :tutorial/content "We can also define other **higher order partial derivatives** such as $f_{xxy}, \\, f_{xxyy}, \\, f_{xyxy},$ etc. \n\nFor instance, the function $f(x,y,z)= z\\cos(xy)$ has the first-order partial derivative\n\n$$\nf_y(x,y,z) = -xz \\sin(xy)\n$$\n\nand the second-order partial derivative\n\n$$\nf_{yx}(x,y,z)= -x yz \\cos{\\left(x y \\right)} - z\\sin{\\left(x y \\right)}.\n$$\n\nIf we differentiate again, with respect to $x,$ then we get the **third-order partial derivative** $f_{yxx}\\mathbin{:}$ \n\n$$\n\\begin{aligned}{f}_{yxx}(x,y,z) & =\\frac{∂}{∂x}({f}_{yx}(x,y)) \\\\  & =\\frac{∂}{∂x}(-xyz\\operatorname{cos}⁡(xy)-z\\operatorname{sin}⁡(xy)) \\\\  & =-yz\\operatorname{cos}⁡(xy)-xyz(-\\operatorname{sin}⁡(xy)\\cdot y)-z\\operatorname{cos}⁡(xy)\\cdot y \\\\  & =x{y}^{2}z\\operatorname{sin}⁡(xy)-2yz\\operatorname{cos}⁡(xy)\\end{aligned}\n$$\n\nIn general, to compute a $n$th-order partial derivative, we need to compute a sequence of $n$ individual derivatives." :db/ensure [:tutorial/validate]} {:db/id 17592186124726 :activity/expected-seconds 960.0 :db/ensure [:activity/validate]}]
