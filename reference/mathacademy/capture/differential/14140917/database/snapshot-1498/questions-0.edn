#{[{:db/id #edb/ref 17592186124244 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186124440 :knowledge-point/id #uuid "7ea31275-77bd-59c7-8e1d-96e2e4b252a4" :knowledge-point/title "Finding Mixed Second-Order Partial Derivatives"}] :question/id #uuid "0a8f5141-941d-5059-9d9f-bf9e5b09096f" :question/math-academy-id "e-3127" :question/problem "Find $\\dfrac {\\partial^2 f }{\\partial x\\partial y}$ given that $\\dfrac {\\partial f}{\\partial y} =  \\dfrac {2y} {x + y^2}.$" :question/worked-solution "To find $\\dfrac {\\partial^2 f }{\\partial x\\partial y},$ we differentiate the given first-order partial derivative $\\dfrac {\\partial f}{\\partial y}$ with respect to $x\\mathbin{:}$\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(\\frac{∂f}{∂y}) \\\\  & =\\frac{∂}{∂x}(\\frac{2y}{x+{y}^{2}}) \\\\  & =2y\\cdot \\frac{∂}{∂x}({(x+{y}^{2})}^{-1}) \\\\  & =-2y(x+{y}^{2})^{-2}\\cdot 1 \\\\  & =-\\frac{2y}{{(x+{y}^{2})}^{2}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186124245 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186124441 :knowledge-point/id #uuid "503a0bfe-7c69-5ad0-ad1d-aa8692dae673" :knowledge-point/title "Computing Expressions Involving Second-Order Partial Derivatives"}] :question/id #uuid "e16f6686-dffb-554e-a50a-8760e818439f" :question/math-academy-id "e-3129" :question/problem "Find $f_{xy}(x,y)+f_{yx}(x,y)$ given that  $f_x(x,y)=y\\cos(xy)$ and $f_y(x,y)=x\\cos(xy).$" :question/worked-solution "To find $f_{xy}(x,y),$ we differentiate the given first-order partial derivative $f_{x}(x,y)$ with respect to $y\\mathbin{:}$\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}({f}_{x}(x,y)) \\\\  & =\\frac{∂}{∂y}(y\\operatorname{cos}⁡(xy)) \\\\  & =1\\cdot \\operatorname{cos}⁡(xy)+y(-\\operatorname{sin}⁡(xy)\\cdot x) \\\\  & =\\operatorname{cos}⁡(xy)-xy\\operatorname{sin}⁡(xy)\\end{aligned}\n$$\n\n \n\nSimilarly, to find $f_{yx}(x,y),$ we differentiate the given first-order partial derivative $f_{y}(x,y)$ with respect to $x\\mathbin{:}$\n\n$$\n\\begin{aligned}{f}_{yx}(x,y) & =\\frac{∂}{∂x}({f}_{y}(x,y)) \\\\  & =\\frac{∂}{∂x}(x\\operatorname{cos}⁡(xy)) \\\\  & =1\\cdot \\operatorname{cos}⁡(xy)+x(-\\operatorname{sin}⁡(xy)\\cdot y) \\\\  & =\\operatorname{cos}⁡(xy)-xy\\operatorname{sin}⁡(xy)\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y)+{f}_{yx}(x,y) & =\\operatorname{cos}⁡(xy)-xy\\operatorname{sin}⁡(xy)+\\operatorname{cos}⁡(xy)-xy\\operatorname{sin}⁡(xy) \\\\  & =2(\\operatorname{cos}⁡(xy)-xy\\operatorname{sin}⁡(xy)).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186124246 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186124442 :knowledge-point/id #uuid "83724b66-0f15-5b94-9576-76e9dfd56d38" :knowledge-point/title "Finding Higher-Order Derivatives"}] :question/id #uuid "a41bfb06-4372-5124-b910-4b35f19d148b" :question/math-academy-id "e-3130" :question/problem "Evaluate $g_{xyz}(x,y,z)$ at $(1,2,3)$ if $g_x(x,y,z) = 2x y z +  y^3.$" :question/worked-solution "First, we find $g_{xy}(x,y,z)$ by differentiating $g_{x}(x,y,z)$ with respect to $y\\mathbin{:}$\n\n$$\n\\begin{aligned}{g}_{xy}(x,y,z) & =\\frac{∂}{∂y}(2xyz+{y}^{3}) \\\\  & =2xz+3{y}^{2}\\end{aligned}\n$$\n\nNext, we find $g_{xyz}(x,y,z)$ by differentiating $g_{xy}(x,y,z)$ with respect to $z\\mathbin{:}$\n\n$$\n\\begin{aligned}{g}_{xyz}(x,y,z) & =\\frac{∂}{∂z}(2xz+3{y}^{2}) \\\\  & =2x\\end{aligned}\n$$\n\nFinally, we obtain \n\n$$\n\\begin{aligned}{g}_{xyz}(1,2,3) & =2(1) \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186268921 :knowledge-point/_questions [{:db/id #edb/ref 17592186124441 :knowledge-point/id #uuid "503a0bfe-7c69-5ad0-ad1d-aa8692dae673" :knowledge-point/title "Computing Expressions Involving Second-Order Partial Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "425cb3a9-f31d-5278-9378-bf08a38df305" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186266736} {:answer/id #uuid "9699bfda-ed01-5720-9988-afda1b34872c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186267488} {:answer/id #uuid "990d9a0d-8a39-5f51-984b-24694aab44b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{9}" :db/id #edb/ref 17592186267524} {:answer/id #uuid "da971629-e1c3-50eb-9d91-0e12040ebfe3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{9}" :db/id #edb/ref 17592186268079} {:answer/id #uuid "e9be40d0-3c94-561e-8513-6c2f10a0b74b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{9}" :db/id #edb/ref 17592186268223}] :answer-field/correct {:answer/id #uuid "da971629-e1c3-50eb-9d91-0e12040ebfe3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{9}" :db/id #edb/ref 17592186268079} :answer-field/id #uuid "baf0e05b-fa61-5e4e-9f86-28b1336165d5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268736}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "619c15a9-a007-5612-9fb8-0f8afb4a8030" :question/math-academy-id "q-132897" :question/problem "Find ${g}_{xy}(x,y)+{g}_{yx}(x,y)$ at $(-1,2)$ given that ${g}_{x}(x,y)=\\frac{1}{x+2y}$ and ${g}_{y}(x,y)=\\frac{2}{x+2y}.$" :question/worked-solution "To find ${g}_{xy}(x,y)$ we differentiate the given first-order partial derivative ${g}_{x}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{g}_{xy}(x,y) & =\\frac{∂}{∂y}({g}_{x}(x,y)) \\\\  & =\\frac{∂}{∂y}(\\frac{1}{x+2y}) \\\\  & =-\\frac{2}{(x+2y)^{2}}\\end{aligned}\n$$\n\n \n\nTo find ${g}_{yx}(x,y)$ we differentiate the given first-order partial derivative ${g}_{y}(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{g}_{yx}(x,y) & =\\frac{∂}{∂x}({g}_{y}(x,y)) \\\\  & =\\frac{∂}{∂x}(\\frac{2}{x+2y}) \\\\  & =-\\frac{2}{(x+2y)^{2}}\\end{aligned}\n$$\n\n \n\nNext, we evaluate ${g}_{xy}(x,y)$ and ${g}_{yx}(x,y)$ at $(-1,2):$\n\n$$\n\\begin{aligned}{g}_{xy}(-1,2) & =-\\frac{2}{((-1)+2(2))^{2}}=-\\frac{2}{9} \\\\ {g}_{yx}(-1,2) & =-\\frac{2}{((-1)+2(2))^{2}}=-\\frac{2}{9}\\end{aligned}\n$$\n\nFinally, we have\n\n$$\n{g}_{xy}(-1,2)+{g}_{yx}(-1,2)=-\\frac{4}{9}.\n$$"}] [{:db/id #edb/ref 17592186381069 :knowledge-point/_questions [{:db/id #edb/ref 17592186124442 :knowledge-point/id #uuid "83724b66-0f15-5b94-9576-76e9dfd56d38" :knowledge-point/title "Finding Higher-Order Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03d5b128-9cff-50f7-92d3-d12b64c6681f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186381071} {:answer/id #uuid "a441ccb0-2f8a-535a-ad8a-583f492794d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{9}" :db/id #edb/ref 17592186381072} {:answer/id #uuid "a34ca82a-d861-5b5f-9369-497429efb02c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{8}" :db/id #edb/ref 17592186381073} {:answer/id #uuid "005be97c-3318-5160-8963-0e2dca0a9c0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{16}" :db/id #edb/ref 17592186381074} {:answer/id #uuid "84c1f9d1-ec7c-53d8-90d2-3e9b6975372f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{16}" :db/id #edb/ref 17592186381075}] :answer-field/correct {:answer/id #uuid "a34ca82a-d861-5b5f-9369-497429efb02c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{8}" :db/id #edb/ref 17592186381073} :answer-field/id #uuid "3208b2b5-bf53-54c6-b739-ef239137d627" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381070}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "928e0d06-b25e-50d0-bfa3-2bcab1a87684" :question/math-academy-id "q-132973" :question/problem "Evaluate ${f}_{zxx}(1,0,1)$ for $f(x,y,z)=\\frac{z}{x+z}.$" :question/worked-solution "First, we find the first-order derivative ${f}_{z}(x,y,z):$\n\n$$\n\\begin{aligned}{f}_{z}(x,y,z) & =\\frac{∂}{∂z}(\\frac{z}{x+z}) \\\\  & =\\frac{x}{(x+z)^{2}}\\end{aligned}\n$$\n\nNow, we find ${f}_{zx}(x,y,z)$ by differentiating ${f}_{z}(x,y,z)$ with respect to $x:$\n\n$$\n\\begin{aligned}{f}_{zx}(x,y,z) & =\\frac{∂}{∂x}({f}_{z}(x,y,z)) \\\\  & =\\frac{∂}{∂x}(\\frac{x}{(x+z)^{2}}) \\\\  & =\\frac{(x+z)^{2}-2x(x+z)}{(x+z)^{4}} \\\\  & =\\frac{z-x}{(x+z)^{3}}\\end{aligned}\n$$\n\nNext, we find ${f}_{zxx}(x,y,z)$ by differentiating ${f}_{zx}(x,y,z)$ with respect to $x:$ \n\n$$\n\\begin{aligned}{f}_{zxx}(x,y,z) & =\\frac{∂}{∂x}({f}_{zy}(x,y,z)) \\\\  & =\\frac{∂}{∂x}(\\frac{z-x}{(x+z)^{3}}) \\\\  & =\\frac{-(x+z)^{3}-3(z-x)(x+z)^{2}}{(x+z)^{6}} \\\\  & =\\frac{2(x-2z)}{(x+z)^{4}}\\end{aligned}\n$$\n\n \n\nFinally, we evaluate ${f}_{zxx}(x,y,z)$ at $(1,0,1):$  \n\n$$\n\\begin{aligned}{f}_{zxx}(1,0,1) & =\\frac{2(1-2(1))}{(1+1)^{4}}=\\frac{-2}{16}=-\\frac{1}{8}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186124946 :knowledge-point/_questions [{:db/id #edb/ref 17592186124441 :knowledge-point/id #uuid "503a0bfe-7c69-5ad0-ad1d-aa8692dae673" :knowledge-point/title "Computing Expressions Involving Second-Order Partial Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83707e27-9888-5a05-b515-c16b124dc827" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2)/((x - 3y)^{2})" :db/id #edb/ref 17592186122277} {:answer/id #uuid "b422ff4b-d728-5732-b61e-5bf8aa48c847" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3y - x}" :db/id #edb/ref 17592186122278} {:answer/id #uuid "c4822b37-84fb-530e-9f0a-09e21f75552d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(6)/((x - 3y)^{2})" :db/id #edb/ref 17592186122279} {:answer/id #uuid "dc568bf8-5611-5d70-bcbc-66e61b626e1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- (3)/((x - 3y)^{2})" :db/id #edb/ref 17592186122280} {:answer/id #uuid "7c6cc276-2145-57b2-9886-61cb61e2147a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- (1)/((x - 3y)^{2})" :db/id #edb/ref 17592186122281}] :answer-field/id #uuid "c063a337-38aa-5596-b563-e9c7e99c9b17" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122276}] :question/id #uuid "cb7a21d3-592c-577d-91a2-7365e19df69d" :question/math-academy-id "q-36014" :question/problem "Find $g_{xy}(x, y) + g_{xx}(x, y)$ given that $g_{x}(x, y) = \\frac{1}{x - 3y}$."}] [{:db/id #edb/ref 17592186124948 :knowledge-point/_questions [{:db/id #edb/ref 17592186124442 :knowledge-point/id #uuid "83724b66-0f15-5b94-9576-76e9dfd56d38" :knowledge-point/title "Finding Higher-Order Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ac03de1-652b-5985-829a-d4f563b4f013" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186321231} {:answer/id #uuid "185580bd-9cc6-5540-8ee1-1837bdfe77d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186321341} {:answer/id #uuid "22497853-7a4b-5053-82a4-7c884988d174" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186321407} {:answer/id #uuid "68d3f72b-f450-57bb-a925-2dc21238378a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186321966} {:answer/id #uuid "e54d78bf-547b-50fd-9032-1d545e85b3e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186322943}] :answer-field/correct {:answer/id #uuid "22497853-7a4b-5053-82a4-7c884988d174" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186321407} :answer-field/id #uuid "a755a285-5a12-5e67-b7c4-bee828c410d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323491}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "83167862-effb-539c-8ffb-5705b88d44f1" :question/math-academy-id "q-36019" :question/problem "Evaluate ${f}_{xyz}(1,1,1)$ for $f(x,y,z)=\\frac{yz}{x-2z}.$" :question/worked-solution "First, we find the first-order derivative ${f}_{x}(x,y,z):$\n\n$$\n\\begin{aligned}{f}_{x}(x,y,z) & =\\frac{∂}{∂x}(\\frac{yz}{x-2z}) \\\\  & =-\\frac{yz}{(x-2z)^{2}}\\end{aligned}\n$$\n\nNow, we find ${f}_{xy}(x,y,z)$ by differentiating ${f}_{x}(x,y,z)$ with respect to $y:$\n\n$$\n\\begin{aligned}{f}_{xy}(x,y,z) & =\\frac{∂}{∂y}({f}_{x}(x,y,z)) \\\\  & =\\frac{∂}{∂y}(-\\frac{yz}{(x-2z)^{2}}) \\\\  & =-\\frac{z}{(x-2z)^{2}}\\end{aligned}\n$$\n\nNext, we find ${f}_{xyz}(x,y,z)$ by differentiating ${f}_{xy}(x,y,z)$ with respect to $z:$ \n\n$$\n\\begin{aligned}{f}_{xyz}(x,y,z) & =\\frac{∂}{∂z}({f}_{xy}(x,y,z)) \\\\  & =\\frac{∂}{∂z}(-\\frac{z}{(x-2z)^{2}}) \\\\  & =-\\frac{1\\cdot (x-2z)^{2}-z\\cdot 2(x-2z)\\cdot (-2)}{(x-2z)^{4}} \\\\  & =-\\frac{(x-2z)^{2}+4z(x-2z)}{(x-2z)^{4}} \\\\  & =-\\frac{x-2z+4z}{(x-2z)^{3}} \\\\  & =-\\frac{x+2z}{(x-2z)^{3}}\\end{aligned}\n$$\n\nFinally, we evaluate ${f}_{xyz}(x,y,z)$ at $(1,1,1):$\n\n$$\n\\begin{aligned}{f}_{xyz}(1,1,1) & =-\\frac{1+2\\cdot 1}{(1-2\\cdot 1)^{3}}=3\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186382138 :knowledge-point/_questions [{:db/id #edb/ref 17592186124440 :knowledge-point/id #uuid "7ea31275-77bd-59c7-8e1d-96e2e4b252a4" :knowledge-point/title "Finding Mixed Second-Order Partial Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86e47b3c-f8f9-5e18-9d28-6f36b2c27a42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{3}-{y}^{3}}{{x}^{3}+{y}^{3}}" :db/id #edb/ref 17592186382140} {:answer/id #uuid "6188f36a-ac69-5d7a-b9fc-397b48fca9ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{3}}{{({x}^{3}+{y}^{3})}^{2}}" :db/id #edb/ref 17592186382141} {:answer/id #uuid "291c128e-6369-5cd6-aadd-033a32d1485e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y({x}^{3}-{y}^{3})}{{({x}^{3}+{y}^{3})}^{2}}" :db/id #edb/ref 17592186382142} {:answer/id #uuid "ed41aa2c-c8b0-5b09-a441-f7cad2ab71a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3y(2{x}^{3}-{y}^{3})}{{({x}^{3}+{y}^{3})}^{2}}" :db/id #edb/ref 17592186382143} {:answer/id #uuid "dcba6b3f-e253-5f01-8e9a-cad9140c3ae4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-{y}^{3}}{{x}^{3}+{y}^{3}}" :db/id #edb/ref 17592186382144}] :answer-field/correct {:answer/id #uuid "ed41aa2c-c8b0-5b09-a441-f7cad2ab71a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3y(2{x}^{3}-{y}^{3})}{{({x}^{3}+{y}^{3})}^{2}}" :db/id #edb/ref 17592186382143} :answer-field/id #uuid "b09ec52c-6763-5e59-8f36-60c753f9258b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382139}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ca9f5fb8-f9bc-5351-b359-d64e2aa35cc6" :question/math-academy-id "q-65065" :question/problem "For the function $f(x,y),$ calculate $\\frac{{∂}^{2}f}{∂{y}^{2}}$ given that $\\frac{∂f}{∂y}=\\frac{3{y}^{2}}{{x}^{3}+{y}^{3}}.$" :question/worked-solution "To find $\\frac{{∂}^{2}f}{∂{y}^{2}}$ we differentiate the given first-order partial derivative $\\frac{∂f}{∂y}$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(\\frac{∂f}{∂y}) \\\\  & =\\frac{∂}{∂y}(\\frac{3{y}^{2}}{{x}^{3}+{y}^{3}}) \\\\  & =\\frac{6y({x}^{3}+{y}^{3})-3{y}^{2}(3{y}^{2})}{{({x}^{3}+{y}^{3})}^{2}} \\\\  & =\\frac{6y{x}^{3}+6{y}^{4}-9{y}^{4}}{{({x}^{3}+{y}^{3})}^{2}} \\\\  & =\\frac{6y{x}^{3}-3{y}^{4}}{{({x}^{3}+{y}^{3})}^{2}} \\\\  & =\\frac{3y(2{x}^{3}-{y}^{3})}{{({x}^{3}+{y}^{3})}^{2}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186382365 :knowledge-point/_questions [{:db/id #edb/ref 17592186124440 :knowledge-point/id #uuid "7ea31275-77bd-59c7-8e1d-96e2e4b252a4" :knowledge-point/title "Finding Mixed Second-Order Partial Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ab3f9a2-c043-533c-ad7b-13b9b79758f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "xy(y+2){e}^{{x}^{2}+2y}" :db/id #edb/ref 17592186382367} {:answer/id #uuid "3110f91f-c3d2-5e2b-91df-c4a5c455454f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y(x+y){e}^{{x}^{2}+2y}" :db/id #edb/ref 17592186382368} {:answer/id #uuid "54f651dc-5268-59e5-9c63-07f1939806db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2y(y+1){e}^{{x}^{2}+2y}" :db/id #edb/ref 17592186382369} {:answer/id #uuid "c910c31d-50d6-5437-9055-00c5404b90a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2y{e}^{{x}^{2}+2y}" :db/id #edb/ref 17592186382370} {:answer/id #uuid "7cf17aee-0b17-5afe-b71a-fd27bd564088" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x{y}^{2}{e}^{{x}^{2}+2y}" :db/id #edb/ref 17592186382371}] :answer-field/correct {:answer/id #uuid "54f651dc-5268-59e5-9c63-07f1939806db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2y(y+1){e}^{{x}^{2}+2y}" :db/id #edb/ref 17592186382369} :answer-field/id #uuid "73748794-1a7d-52b6-9351-18509da54bfc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382366}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "27410c7b-bcd3-51b0-ad2f-12407bb83068" :question/math-academy-id "q-80398" :question/problem "For the function $f(x,y),$ calculate $\\frac{{∂}^{2}f}{∂y∂x}$ given that $\\frac{∂f}{∂x}={y}^{2}{e}^{{x}^{2}+2y}.$" :question/worked-solution "To find $\\frac{{∂}^{2}f}{∂y∂x}$ we differentiate the given first-order partial derivative $\\frac{∂f}{∂x}$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}(\\frac{∂f}{∂x}) \\\\  & =\\frac{∂}{∂y}({y}^{2}{e}^{{x}^{2}+2y}) \\\\  & =2y{e}^{{x}^{2}+2y}+2{y}^{2}{e}^{{x}^{2}+2y} \\\\  & =2y(y+1){e}^{{x}^{2}+2y}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186382372 :knowledge-point/_questions [{:db/id #edb/ref 17592186124440 :knowledge-point/id #uuid "7ea31275-77bd-59c7-8e1d-96e2e4b252a4" :knowledge-point/title "Finding Mixed Second-Order Partial Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e58bf6d-3e4e-5572-9962-d490c5a3b0a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{y}^{2}\\operatorname{sin}⁡(1+3xy)+3x{y}^{3}\\operatorname{cos}⁡(1+3xy)" :db/id #edb/ref 17592186382374} {:answer/id #uuid "d4d8c30b-3915-553d-8991-17f87e207e0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}\\operatorname{sin}⁡(1+3xy)+3x\\operatorname{cos}⁡(1+3xy)" :db/id #edb/ref 17592186382375} {:answer/id #uuid "673a978b-9841-53b4-bef5-1b693ae22128" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{y}^{2}\\operatorname{sin}⁡(1+3xy)" :db/id #edb/ref 17592186382376} {:answer/id #uuid "b47f7690-45d6-5927-b4de-fbb481a6e51b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{y}^{4}\\operatorname{cos}⁡(1+3xy)" :db/id #edb/ref 17592186382377} {:answer/id #uuid "6c776c6f-3449-5764-964f-10c8b07bc334" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{y}^{2}\\operatorname{sin}⁡(1+3xy)+xy\\operatorname{cos}⁡(1+3xy)" :db/id #edb/ref 17592186382378}] :answer-field/correct {:answer/id #uuid "0e58bf6d-3e4e-5572-9962-d490c5a3b0a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{y}^{2}\\operatorname{sin}⁡(1+3xy)+3x{y}^{3}\\operatorname{cos}⁡(1+3xy)" :db/id #edb/ref 17592186382374} :answer-field/id #uuid "cbfda208-0f47-5e6c-bbd8-4a6e0990b991" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382373}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4c8f7a87-99bf-5a7c-8050-3b38476efcc1" :question/math-academy-id "q-80400" :question/problem "For the function $f(x,y),$ calculate $\\frac{{∂}^{2}f}{∂{y}^{2}}$ given that $\\frac{∂f}{∂y}={y}^{3}\\operatorname{sin}⁡(1+3xy).$" :question/worked-solution "To find $\\frac{{∂}^{2}f}{∂{y}^{2}}$ we differentiate the given first-order partial derivative $\\frac{∂f}{∂y}$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(\\frac{∂f}{∂y}) \\\\  & =\\frac{∂}{∂y}({y}^{3}\\operatorname{sin}⁡(1+3xy)) \\\\  & =3{y}^{2}\\operatorname{sin}⁡(1+3xy)+3x{y}^{3}\\operatorname{cos}⁡(1+3xy)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186382386 :knowledge-point/_questions [{:db/id #edb/ref 17592186124441 :knowledge-point/id #uuid "503a0bfe-7c69-5ad0-ad1d-aa8692dae673" :knowledge-point/title "Computing Expressions Involving Second-Order Partial Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ef4a7ac8-061e-5af9-9fb0-ab5773165579" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{3}" :db/id #edb/ref 17592186382388} {:answer/id #uuid "c4001b21-7575-5835-8086-75b8d29921b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186382389} {:answer/id #uuid "5d0ca7b1-e77a-5b9b-b8a5-4b9e8d84089f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186382390} {:answer/id #uuid "41d02635-e49d-571a-96b0-1ac0a22b8838" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{9}" :db/id #edb/ref 17592186382391} {:answer/id #uuid "6d245bf1-3343-5515-adf6-f1ffb3caa8af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{9}" :db/id #edb/ref 17592186382392}] :answer-field/correct {:answer/id #uuid "6d245bf1-3343-5515-adf6-f1ffb3caa8af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{9}" :db/id #edb/ref 17592186382392} :answer-field/id #uuid "2cf99c29-b792-5f2e-8440-d3e8129e97bc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382387}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0d39e98a-42b8-56d2-88b4-63d088086c8a" :question/math-academy-id "q-80473" :question/problem "Find ${g}_{xx}(x,y)+{g}_{yy}(x,y)$ at $(1,-1)$ given that ${g}_{x}(x,y)=\\frac{2}{2x-y}$ and ${g}_{y}(x,y)=-\\frac{1}{2x-y}.$" :question/worked-solution "To find ${g}_{xx}(x,y)$ we differentiate the given first-order partial derivative ${g}_{x}(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{g}_{xx}(x,y) & =\\frac{∂}{∂x}({g}_{x}(x,y)) \\\\  & =\\frac{∂}{∂x}(\\frac{2}{2x-y}) \\\\  & =-\\frac{4}{(2x-y)^{2}}\\end{aligned}\n$$\n\n \n\nTo find ${g}_{yy}(x,y)$ we differentiate the given first-order partial derivative ${g}_{y}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{g}_{yy}(x,y) & =\\frac{∂}{∂y}({g}_{y}(x,y)) \\\\  & =\\frac{∂}{∂y}(-\\frac{1}{2x-y}) \\\\  & =-\\frac{1}{(2x-y)^{2}}\\end{aligned}\n$$\n\n \n\nNext, we evaluate ${g}_{xx}(x,y)$ and ${g}_{yy}(x,y)$ at $(1,-1):$\n\n$$\n\\begin{aligned}{g}_{xx}(1,-1) & =-\\frac{4}{(2(1)-(-1))^{2}}=-\\frac{4}{9} \\\\ {g}_{yy}(1,-1) & =-\\frac{1}{(2(1)-(-1))^{2}}=-\\frac{1}{9}\\end{aligned}\n$$\n\nFinally, we have\n\n$$\n{g}_{xx}(1,-1)+{g}_{yy}(1,-1)=-\\frac{4}{9}-\\frac{1}{9}=-\\frac{5}{9}.\n$$"}] [{:db/id #edb/ref 17592186422011 :knowledge-point/_questions [{:db/id #edb/ref 17592186124442 :knowledge-point/id #uuid "83724b66-0f15-5b94-9576-76e9dfd56d38" :knowledge-point/title "Finding Higher-Order Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c70e303-c80e-51d2-8821-2af0cf8b3950" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2y\\operatorname{cos}⁡({y}^{2})-x\\operatorname{sin}⁡({y}^{2})" :db/id #edb/ref 17592186421995} {:answer/id #uuid "92245356-2a0e-55cd-8484-17313be9c3ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}\\operatorname{cos}⁡({y}^{2})-2x\\operatorname{sin}⁡({y}^{2})" :db/id #edb/ref 17592186422003} {:answer/id #uuid "992b5993-493b-561e-9033-5437b3de59e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}\\operatorname{cos}⁡({y}^{2})" :db/id #edb/ref 17592186422004} {:answer/id #uuid "ca872c1a-6f89-5f8b-8336-d7cb854e1bcb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4x{y}^{2}\\operatorname{sin}⁡({y}^{2})" :db/id #edb/ref 17592186422005} {:answer/id #uuid "d1afdc0c-1cf1-54cf-9c95-d81dfb59dc49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4y\\operatorname{cos}⁡({y}^{2})" :db/id #edb/ref 17592186422006}] :answer-field/correct {:answer/id #uuid "d1afdc0c-1cf1-54cf-9c95-d81dfb59dc49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4y\\operatorname{cos}⁡({y}^{2})" :db/id #edb/ref 17592186422006} :answer-field/id #uuid "1a95cb7d-93f6-5084-ade9-1c85a3b6b1f1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186422008}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fdce2d33-30de-52e0-89c4-590147a8c4ea" :question/math-academy-id "q-80479" :question/problem "Calculate ${g}_{xxy}(x,y)$ given that $g(x,y)=({x}^{2}+y)\\operatorname{sin}⁡({y}^{2}).$" :question/worked-solution "First, we find the first-order derivative ${g}_{x}(x,y):$ \n\n$$\n\\begin{aligned}{g}_{x}(x,y) & =\\frac{∂}{∂x}(({x}^{2}+y)\\operatorname{sin}⁡({y}^{2})) \\\\  & =2x\\operatorname{sin}⁡({y}^{2})\\end{aligned}\n$$\n\nNext, we find ${g}_{x}(x,y)$ by differentiating ${g}_{x}(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{g}_{xx}(x,y) & =\\frac{∂}{∂x}({g}_{x}(x,y)) \\\\  & =\\frac{∂}{∂x}(2x\\operatorname{sin}⁡({y}^{2})) \\\\  & =2\\operatorname{sin}⁡({y}^{2})\\end{aligned}\n$$\n\nFinally, we find ${g}_{xxy}(x,y)$ by differentiating ${g}_{xx}(x,y)$ with respect to $y:$ \n\n$$\n\\begin{aligned}{g}_{xxy}(x,y) & =\\frac{∂}{∂y}({g}_{xx}(x,y)) \\\\  & =\\frac{∂}{∂y}(2\\operatorname{sin}⁡({y}^{2})) \\\\  & =4y\\operatorname{cos}⁡({y}^{2})\\end{aligned}\n$$"}]}
