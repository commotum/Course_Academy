 1 & 0 \\\\ -12 & 0 & 14\\end{aligned}]\n$$\n\nNow, we need the unit eigenvector that corresponds to the eigenvalue ${\\lambda }_{\\text{max}}=20:$\n\n$$\n\\begin{aligned}A-20I & =[\\begin{aligned}-4 & 0 & -12 \\\\ 0 & 1 & 0 \\\\ -12 & 0 & 14\\end{aligned}]-20[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]=[\\begin{aligned}-24 & 0 & -12 \\\\ 0 & -19 & 0 \\\\ -12 & 0 & -6\\end{aligned}]\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-20I)x=0$ gives the eigenvector $v=[\\begin{aligned}-1 \\\\ 0 \\\\ 2\\end{aligned}].$ \n\nFinally, dividing $v$ by its norm $‖v‖=\\sqrt{5},$ we get \n\n$$\n{u}_{\\text{max}}=\\frac{v}{‖v‖}=\\frac{1}{\\sqrt{5}}[\\begin{aligned}-1 \\\\ 0 \\\\ 2\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186378955 :knowledge-point/_questions [{:db/id #edb/ref 17592186198442 :knowledge-point/id #uuid "a9d4e49c-202b-564f-839d-64b5d71a3783" :knowledge-point/title "Finding Where the Extrema of a Quadratic Form Are Attained on the Unit Sphere"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d1abf8ba-5015-5e34-9d28-40c9e16c5051" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{10}}[\\begin{aligned}0 \\\\ 3 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186378957} {:answer/id #uuid "7e25a544-0386-5dd2-90b3-f72b783a6d7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 \\\\ 0 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186378958} {:answer/id #uuid "8dc40c71-4e19-5d2e-9a55-2819fdf76de2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{10}}[\\begin{aligned}1 \\\\ 0 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186378959} {:answer/id #uuid "837c2e94-e346-5431-b6dc-4355f5750761" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{10}}[\\begin{aligned}1 \\\\ 3 \\\\ 0\\end{aligned}]" :db/id #edb/re