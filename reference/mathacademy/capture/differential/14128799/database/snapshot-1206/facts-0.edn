ref 17592186045417] [17592186049717 #edb/ref 1035 #uuid "0daf753f-de2f-53fe-95a5-971ccb2eada4" #edb/ref 17592186045417] [17592186082733 #edb/ref 1075 #edb/ref 17592186082734 #edb/ref 17592186045417] [17592186082733 #edb/ref 1075 #edb/ref 17592186082735 #edb/ref 17592186045417] [17592186082733 #edb/ref 1075 #edb/ref 17592186082736 #edb/ref 17592186045417] [17592186082733 #edb/ref 1075 #edb/ref 17592186082737 #edb/ref 17592186045417] [17592186082733 #edb/ref 1075 #edb/ref 17592186082738 #edb/ref 17592186045417] [17592186082733 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186082733 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186082733 #edb/ref 1078 #edb/ref 17592186082738 #edb/ref 17592186045417] [17592186082733 #edb/ref 1079 #uuid "436fc283-a91a-5b4c-9586-c4469b903e88" #edb/ref 17592186045417] [17592186082734 #edb/ref 1080 "\\frac{1}{10}" #edb/ref 17592186045417] [17592186082734 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186082734 #edb/ref 1083 #uuid "b4680c3d-3921-51a2-92b4-89d2f9691331" #edb/ref 17592186045417] [17592186082735 #edb/ref 1080 "\\frac{5}{6}" #edb/ref 17592186045417] [17592186082735 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186082735 #edb/ref 1083 #uuid "ce88e91c-f478-5942-a90e-98b2284dea88" #edb/ref 17592186045417] [17592186082736 #edb/ref 1080 "\\frac{3}{10}" #edb/ref 17592186045417] [17592186082736 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186082736 #edb/ref 1083 #uuid "f263a90e-d78e-5150-aba9-3fcdf9180cef" #edb/ref 17592186045417] [17592186082737 #edb/ref 1080 "\\frac{1}{5}" #edb/ref 17592186045417] [17592186082737 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186082737 #edb/ref 1083 #uuid "3a2c5fb4-2b01-523b-ba0b-e75d8e08fb42" #edb/ref 17592186045417] [17592186082738 #edb/ref 1080 "\\frac{4}{5}" #edb/ref 17592186045417] [17592186082738 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186082738 #edb/ref 1083 #uuid "56070d4e-9d2e-5df5-a16e-9ccdd49a3c3a" #edb/ref 17592186045417] [17592186083123 #edb/ref 1069 "e-7951" #edb/ref 17592186045417] [17592186083123 #edb/ref 1071 "Given that the continuous random variable $X$ is uniformly distributed on the interval $[-1, 4],$ compute $P(0<   X <  3).$" #edb/ref 17592186045417] [17592186083123 #edb/ref 1072 #uuid "0b1a7f5b-f778-5202-90d8-1dd3f30fbf0d" #edb/ref 17592186045417] [17592186083123 #edb/ref 1074 "The probability density function for a uniformly distributed continuous random variable $X$ on an interval $[a,b]$ is given by\n\n![](images/e8/e8a1e7972e4e4a543c2e774894f83ec38755e7b2145a5b301e44906affac9c15.svg)\n\nOur random variable $X$ is uniformly distributed on the interval $[-1,4],$ so it has the following probability density function:\n\n![](images/5c/5ca4ceb0bed3882328dbfa8fb54eb9de948a53d66d9850b8d40781d19f50f4fc.svg)\n\nSo, we have\n\n$$\n\\begin{aligned}P(0<X<3) & =P(0<X<3) \\\\  & ={\\int }_{0}^{3}f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{3}\\frac{1}{5}\\,\\text{d}x \\\\  & =\\frac{3-0}{5} \\\\  & =\\frac{3}{5}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186083129 #edb/ref 1069 "e-8429" #edb/ref 17592186045417] [17592186083129 #edb/ref 1071 "Given that the continuous random variable $X$ is uniformly distributed on the interval $\\left[0, 10\\right],$ compute $P\\left(X \\leq 7\\right).$" #edb/ref 17592186045417] [17592186083129 #edb/ref 1072 #uuid "d1eacdc7-3c90-5351-9dec-0e13bbe2b749" #edb/ref 17592186045417] [17592186083129 #edb/ref 1074 "The probability density function for a uniformly distributed continuous random variable $X$ on an interval $[a,b]$ is given by\n\n![](images/e7/e76831e0e537ad6fdd429115b56034f54f9071574430c41fb9fe5b4888a72b48.svg)\n\nOur random variable $X$ is uniformly distributed on the interval $\\left[0, 10\\right],$ so it has the following probability density function:\n\n![](images/7a/7a7bfa98d0a54a198c0050e763a2f1ac75bca751063b9ea20ec6979163049c6f.svg)\n\nSo, we have\n\n$$\n\\begin{aligned}P(X\\le 7) & =P(0\\le X\\le 7) \\\\  & ={\\int }_{0}^{7}f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{7}\\frac{1}{10}\\,\\text{d}x \\\\  & =\\frac{7-0}{10} \\\\  & =\\frac{7}{10}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186083130 #edb/ref 1069 "e-8430" #edb/ref 17592186045417] [17592186083130 #edb/ref 1071 "Given that the continuous random variable $Y$ is uniformly distributed on the interval $\\left[1, 16\\right],$ compute $P\\left(Y  \\geq  10\\right).$" #edb/ref 17592186045417] [17592186083130 #edb/ref 1072 #uuid "76cfb8dc-6197-5ab9-bebf-1d306b6c13a6" #edb/ref 17592186045417] [17592186083130 #edb/ref 1074 "The probability density function for a uniformly distributed continuous random variable $Y$ on an interval $[a,b]$ is given by\n\n![](images/64/64661e76a430c63a3ba74d43f3d074e43d5c03a1a09c39d714a087d5fb8b5afa.svg)\n\nOur random variable $Y$ is uniformly distributed on the interval $\\left[1, 16\\right],$ so it has the following probability density function:\n\n![](images/bd/bd2bfc727ccdaeb4d0912640c12fa99900db52102aefe3a3dce46ad2e2cbfef0.svg)\n\nSo, we have\n\n$$\n\\begin{aligned}P(Y\\ge 10) & =P(10\\le Y\\le 16) \\\\  & ={\\int }_{10}^{16}f(y)\\,\\text{d}y \\\\  & ={\\int }_{10}^{16}\\frac{1}{15}\\,\\text{d}y \\\\  & =\\frac{16-10}{15} \\\\  & =\\frac{6}{15} \\\\  & =\\frac{2}{5}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186083321 #edb/ref 1038 #edb/ref 17592186083966 #edb/ref 17592186045417] [17592186083321 #edb/ref 1038 #edb/ref 17592186083979 #edb/ref 17592186045417] [17592186083321 #edb/ref 1038 #edb/ref 17592186424050 #edb/ref 17592186045417] [17592186083321 #edb/ref 1038 #edb/ref 17592186424054 #edb/ref 17592186045417] [17592186083321 #edb/ref 1039 "Computing the Probability of a Uniformly Distributed Random Variable Over an Interval" #edb/ref 17592186045417] [17592186083321 #edb/ref 1041 #edb/ref 17592186083123 #edb/ref 17592186045417] [17592186083321 #edb/ref 1042 #uuid "84a86dfc-17d0-56a0-840c-3d2da28c55ad" #edb/ref 17592186045417] [17592186083327 #edb/ref 1037 #edb/ref 17592186049638 #edb/ref 17592186045417] [17592186083327 #edb/ref 1038 #edb/ref 17592186083965 #edb/ref 17592186045417] [17592186083327 #edb/ref 1038 #edb/ref 17592186083978 #edb/ref 17592186045417] [17592186083327 #edb/ref 1038 #edb/ref 17592186424052 #edb/ref 17592186045417] [17592186083327 #edb/ref 1038 #edb/ref 17592186424053 #edb/ref 17592186045417] [17592186083327 #edb/ref 1039 "Computing a \"Less Than\" Probability for a Uniformly Distributed Continuous Random Variable" #edb/ref 17592186045417] [17592186083327 #edb/ref 1041 #edb/ref 17592186083129 #edb/ref 17592186045417] [17592186083327 #edb/ref 1042 #uuid "0c61646d-b52c-5bf3-8406-6a27aeb5a927" #edb/ref 17592186045417] [17592186083328 #edb/ref 1038 #edb/ref 17592186083964 #edb/ref 17592186045417] [17592186083328 #edb/ref 1038 #edb/ref 17592186083967 #edb/ref 17592186045417] [17592186083328 #edb/ref 1038 #edb/ref 17592186424051 #edb/ref 17592186045417] [17592186083328 #edb/ref 1039 "Computing a \"Greater Than\" Probability for a Uniformly Distributed Continuous Random Variable" #edb/ref 17592186045417] [17592186083328 #edb/ref 1041 #edb/ref 17592186083130 #edb/ref 17592186045417] [17592186083328 #edb/ref 1042 #uuid "2305155b-680d-57a6-a342-302e8603172a" #edb/ref 17592186045417] [17592186083469 #edb/ref 1043 #edb/ref 17592186084265 #edb/ref 17592186045417] [17592186083469 #edb/ref 1043 #edb/ref 17592186084266 #edb/ref 17592186045417] [17592186083469 #edb/ref 1043 #edb/ref 17592186084274 #edb/ref 17592186045417] [17592186083469 #edb/ref 1043 #edb/ref 17592186084275 #edb/ref 17592186045417] [17592186083469 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186083469 #edb/ref 1045 "The Continuous Uniform Distribution" #edb/ref 17592186045417] [17592186083469 #edb/ref 1046 #edb/ref 17592186084265 #edb/ref 17592186045417] [17592186083469 #edb/ref 1049 #edb/ref 17592186049239 #edb/ref 17592186045417] [17592186083469 #edb/ref 1050 420.0 #edb/ref 17592186045417] [17592186083469 #edb/ref 1053 #uuid "76dc7a93-1370-590c-9701-644c875c28d4" #edb/ref 17592186045417] [17592186083967 #edb/ref 1068 #edb/ref 17592186082733 #edb/ref 17592186045417] [17592186083967 #edb/ref 1069 "q-90631" #edb/ref 17592186045417] [17592186083967 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186083967 #edb/ref 1071 "Given that the continuous random variable $Y$ is uniformly distributed on the interval $[-6,-1],$ compute $P(Y>-5).$" #edb/ref 17592186045417] [17592186083967 #edb/ref 1072 #uuid "2ed3fbec-ded2-5759-bf07-e69171b2d9fa" #edb/ref 17592186045417] [17592186083967 #edb/ref 1074 "The probability density function for a uniformly distributed continuous random variable $Y$ on an interval $[a,b]$ is given by\n\n$$\nf(y)=\\{\\begin{aligned}\\frac{1}{b-a},\\, & a\\le y\\le b, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$\n\nOur random variable $Y$ is uniformly distributed on the interval $[-6,-1],$ so it has the following probability density function:\n\n$$\nf(y)=\\{\\begin{aligned}\\frac{1}{5},\\, & -6\\le y\\le -1, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}P(Y>-5) & =P(-5<Y<-1) \\\\  & ={\\int }_{-5}^{-1}f(y)\\,\\text{d}y \\\\  & ={\\int }_{-5}^{-1}\\frac{1}{5}\\,\\text{d}y \\\\  & =\\frac{-1-(-5)}{5} \\\\  & =\\frac{4}{5}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186084265 #edb/ref 1058 #edb/ref 17592186084274 #edb/ref 17592186045417] [17592186084265 #edb/ref 1061 29657 #edb/ref 17592186045417] [17592186084265 #edb/ref 1062 #uuid "02caea11-acdc-5962-9b53-fea8e193059d" #edb/ref 17592186045417] [17592186084265 #edb/ref 1063 #edb/ref 17592186084481 #edb/ref 17592186045417] [17592186084266 #edb/ref 1058 #edb/ref 17592186084275 #edb/ref 17592186045417] [17592186084266 #edb/ref 1061 29658 #edb/ref 17592186045417] [17592186084266 #edb/ref 1062 #uuid "666ef1c7-0dc0-57dd-90f5-5867ae079896" #edb/ref 17592186045417] [17592186084266 #edb/ref 1063 #edb/ref 17592186083321 #edb/ref 17592186045417] [17592186084274 #edb/ref 1058 #edb/ref 17592186084266 #edb/ref 17592186045417] [17592186084274 #edb/ref 1061 31402 #edb/ref 17592186045417] [17592186084274 #edb/ref 1062 #uuid "fa69d6a2-d837-5a66-9f5d-15186ee1924e" #edb/ref 17592186045417] [17592186084274 #edb/ref 1063 #edb/ref 17592186083327 #edb/ref 17592186045417] [17592186084275 #edb/ref 1061 31403 #edb/ref 17592186045417] [17592186084275 #edb/ref 1062 #uuid "02f4b85d-4ee5-5cce-beba-1bde9dda8228" #edb/ref 17592186045417] [17592186084275 #edb/ref 1063 #edb/ref 17592186083328 #edb/ref 17592186045417] [17592186084481 #edb/ref 1064 "A continuous random variable $X$ follows a **continuous uniform distribution** on the interval $[a,b]$ if all values of $X$ are equally likely on $[a,b].$\n\nIntuitively, the familiar statement \"choose a random number between $a$ and $b$\" can be translated as \"observe a value from the continuous uniform distribution on $[a,b].$\" \n\nThe probability density function for the continuous uniform distribution on an interval $[a,b]$ takes the following form:\n\n![](images/a2/a247cacd484a99d579d2a30245d7ab495f6d0d116fbf02e2fe8a95fa658df9c6.svg)\n\nThis corresponds to the following graph:\n\n![](images/9d/9d077084b025c673533cefc52b7d2e7bfe90e8f903e926a27ce8d1207a0d4e79.png)\n\nNotice that the probability density of the continuous uniform distribution on $[a,b]$ is just $1$ divided by the length of the interval. This ensures that our probability density function has the same value everywhere in the interval and integrates to $1{:}$\n\n$$\n\\begin{aligned}{\\int }_{a}^{b}\\frac{1}{b-a}\\,\\text{d}x & ={\\frac{x}{b-a}|}_{a}^{b} \\\\  & =\\frac{b-a}{b-a} \\\\  & =1\\,✓\\end{aligned}\n$$\n\nWhen a random variable $X$ follows a continuous uniform distribution on the interval $[a,b],$ we often write\n\n$$\nX\\sim U[a,b]\n$$\n\n \n\nand say that \"$X$ is uniformly distributed on the interval $[a,b].$\"" #edb/ref 17592186045417] [17592186084481 #edb/ref 1065 4784 #edb/ref 17592186045417] [17592186084481 #edb/ref 1066 #uuid "59338dfe-e264-5d82-b493-441669f9a755" #edb/ref 17592186045417] [17592186084481 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186424020 #edb/ref 1080 "\\frac{3}{4}" #edb/ref 17592186045417] [17592186424020 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186424020 #edb/ref 1083 #uuid "0e3d93ec-eb09-56cb-a416-5e2e7bec5a82" #edb/ref 17592186045417] [17592186424021 #edb/ref 1080 "\\frac{3\\pi }{8}" #edb/ref 17592186045417] [17592186424021 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186424021 #edb/ref 1083 #uuid "107d2581-115e-5fcf-a7ba-4b8a4e067792" #edb/ref 17592186045417] [17592186424022 #edb/ref 1080 "\\frac{1}{2}" #edb/ref 17592186045417] [17592186424022 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186424022 #edb/ref 1083 #uuid "160a5126-2e24-5c1b-be6a-a06e49dea788" #edb/ref 17592186045417] [17592186424023 #edb/ref 1080 "\\frac{3}{8}" #edb/ref 17592186045417] [17592186424023 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186424023 #edb/ref 1083 #uuid "19b9c547-b3de-5a3b-af9a-1d4bd21add26" #edb/ref 17592186045417] [17592186424024 #edb/ref 1080 "0" #edb/ref 17592186045417] [17592186424024 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186424024 #edb/ref 1083 #uuid "19f85468-debe-56c4-9c7b-72ce62714596" #edb/ref 17592186045417] [17592186424025 #edb/ref 1080 "\\frac{1}{10}" #edb/ref 17592186045417] [17592186424025 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186424025 #edb/ref 1083 #uuid "1acc037d-bce5-53b6-8323-1b252862f034" #edb/ref 17592186045417] [17592186424026 #edb/ref 1080 "\\frac{3}{7}" #edb/ref 17592186045417] [17592186424026 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186424026 #edb/ref 1083 #uuid "1e99867f-cfc9-54c7-b348-5f78d1c3d9fa" #edb/ref 17592186045417] [17592186424027 #edb/ref 1080 "\\frac{3}{10}" #edb/ref 17592186045417] 