#{[{:db/id #edb/ref 17592186083123 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186083321 :knowledge-point/id #uuid "84a86dfc-17d0-56a0-840c-3d2da28c55ad" :knowledge-point/title "Computing the Probability of a Uniformly Distributed Random Variable Over an Interval"}] :question/id #uuid "0b1a7f5b-f778-5202-90d8-1dd3f30fbf0d" :question/math-academy-id "e-7951" :question/problem "Given that the continuous random variable $X$ is uniformly distributed on the interval $[-1, 4]$, compute $P(0< X < 3)$." :question/worked-solution "The probability density function for a uniformly distributed continuous random variable $X$ on an interval $[a,b]$ is given by\n\n$$\n{\\frac{1}{b - a},\\begin{vmatrix}a \\le x \\le b, \\\\ 0,\\end{vmatrix}otherwise\n$$\n\nOur random variable $X$ is uniformly distributed on the interval $[-1,4]$, so it has the following probability density function:\n\n$$\n{\\frac{1}{5},\\begin{vmatrix}-1 \\le x \\le 4, \\\\ 0,\\end{vmatrix}otherwise\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}\nP(0 < X < 3) &= P(0 < X < 3) \\\\\n&= \\int_{0}^{3}f(x)dx \\\\\n&= \\int_{0}^{3}\\frac{1}{5}dx \\\\\n&= \\frac{3 - 0}{5} \\\\\n&= \\frac{3}{5}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186083129 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186083327 :knowledge-point/id #uuid "0c61646d-b52c-5bf3-8406-6a27aeb5a927" :knowledge-point/title "Computing a \"Less Than\" Probability for a Uniformly Distributed Continuous Random Variable"}] :question/id #uuid "d1eacdc7-3c90-5351-9dec-0e13bbe2b749" :question/math-academy-id "e-8429" :question/problem "Given that the continuous random variable $X$ is uniformly distributed on the interval $\\left[0, 10\\right]$, compute $P\\left(X \\leq 7\\right)$." :question/worked-solution "The probability density function for a uniformly distributed continuous random variable $X$ on an interval $[a,b]$ is given by\n\n$$\n{\\frac{1}{b - a},\\begin{vmatrix}a \\le x \\le b, \\\\ 0,\\end{vmatrix}otherwise\n$$\n\nOur random variable $X$ is uniformly distributed on the interval\n\n$$\n\\left[0, 10\\right]\n$$\n\nso it has the following probability density function:\n\n$$\n{\\frac{1}{10},\\begin{vmatrix}0 \\le x \\le 10, \\\\ 0,\\end{vmatrix}otherwise\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}\nP(X \\le 7) &= P(0 \\le X \\le 7) \\\\\n&= \\int_{0}^{7}f(x)dx \\\\\n&= \\int_{0}^{7}\\frac{1}{10}dx \\\\\n&= \\frac{7 - 0}{10} \\\\\n&= \\frac{7}{10}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186083130 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186083328 :knowledge-point/id #uuid "2305155b-680d-57a6-a342-302e8603172a" :knowledge-point/title "Computing a \"Greater Than\" Probability for a Uniformly Distributed Continuous Random Variable"}] :question/id #uuid "76cfb8dc-6197-5ab9-bebf-1d306b6c13a6" :question/math-academy-id "e-8430" :question/problem "Given that the continuous random variable $Y$ is uniformly distributed on the interval $\\left[1, 16\\right]$, compute $P\\left(Y \\geq 10\\right)$." :question/worked-solution "The probability density function for a uniformly distributed continuous random variable $Y$ on an interval $[a,b]$ is given by\n\n$$\n{\\frac{1}{b - a},\\begin{vmatrix}a \\le y \\le b, \\\\ 0,\\end{vmatrix}otherwise\n$$\n\nOur random variable $Y$ is uniformly distributed on the interval\n\n$$\n\\left[1, 16\\right]\n$$\n\nso it has the following probability density function:\n\n$$\n{\\frac{1}{15},\\begin{vmatrix}1 \\le y \\le 16, \\\\ 0,\\end{vmatrix}otherwise\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}\nP(Y \\ge 10) &= P(10 \\le Y \\le 16) \\\\\n&= \\int_{10}^{16}f(y)dy \\\\\n&= \\int_{10}^{16}\\frac{1}{15}dy \\\\\n&= \\frac{16 - 10}{15} \\\\\n&= \\frac{6}{15} \\\\\n&= \\frac{2}{5}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186083967 :knowledge-point/_questions [{:db/id #edb/ref 17592186083328 :knowledge-point/id #uuid "2305155b-680d-57a6-a342-302e8603172a" :knowledge-point/title "Computing a \"Greater Than\" Probability for a Uniformly Distributed Continuous Random Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b4680c3d-3921-51a2-92b4-89d2f9691331" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{10}" :db/id #edb/ref 17592186082734} {:answer/id #uuid "ce88e91c-f478-5942-a90e-98b2284dea88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186082735} {:answer/id #uuid "f263a90e-d78e-5150-aba9-3fcdf9180cef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{10}" :db/id #edb/ref 17592186082736} {:answer/id #uuid "3a2c5fb4-2b01-523b-ba0b-e75d8e08fb42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186082737} {:answer/id #uuid "56070d4e-9d2e-5df5-a16e-9ccdd49a3c3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186082738}] :answer-field/id #uuid "436fc283-a91a-5b4c-9586-c4469b903e88" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186082733}] :question/id #uuid "2ed3fbec-ded2-5759-bf07-e69171b2d9fa" :question/math-academy-id "q-90631" :question/problem "Given that the continuous random variable $Y$ is uniformly distributed on the interval $[- 6,-1]$, compute $P(Y > - 5)$."}]}
