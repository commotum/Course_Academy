.type/radio} :db/id #edb/ref 17592186249703}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8a80168e-4de0-55ab-b42f-115076b5300e" :question/math-academy-id "q-115898" :question/problem "What are the coordinates of the vertex of the parabola ${x}^{2}=6y?$" :question/worked-solution "The standard equation of an upward- or downward-opening parabola that has its vertex at the origin is\n\n$$\n{x}^{2}=4py,\n$$\n\nwhere $p$ is a constant.\n\nWe can rewrite the given equation as \n\n$$\n{x}^{2}=4(\\frac{3}{2})y.\n$$\n\nIt is now clear that our equation is of the standard type with $p=\\frac{3}{2}.$ Therefore, our parabola has its vertex at $(0,0).$"}] [{:db/id #edb/ref 17592186375769 :knowledge-point/_questions [{:db/id #edb/ref 17592186096762 :knowledge-point/id #uuid "67455965-c9d3-5ae8-8b56-2a58af95df0a" :knowledge-point/title "Stating the Vertex of a Vertical Parabola Given Its Equation in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ff3f417-3eb7-578f-abd5-834be46bc2fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186375771} {:answer/id #uuid "5e1f3322-cc54-50b1-bdd9-ecd36b711cc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(10,0)" :db/id #edb/ref 17592186375772} {:answer/id #uuid "3cf824d4-fe5b-5e61-a294-c20d75a16ae6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-\\frac{5}{2})" :db/id #edb/ref 17592186375773} {:answer/id #uuid "226b0174-c841-5a2b-b822-94c43761ed3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,10)" :db/id #edb/ref 17592186375774} {:answer/id #uuid "1cc0d7df-1601-5d99-89b2-1bbbd7a32a1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{5}{2},0)" :db/id #edb/ref 17592186375775}] :answer-field/corre