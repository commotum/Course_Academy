edb/ref 17592186354373 :knowledge-point/_questions [{:db/id #edb/ref 17592186096762 :knowledge-point/id #uuid "67455965-c9d3-5ae8-8b56-2a58af95df0a" :knowledge-point/title "Stating the Vertex of a Vertical Parabola Given Its Equation in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "454a079a-3b5d-5568-a29d-6f2901c3f216" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,0)" :db/id #edb/ref 17592186352210} {:answer/id #uuid "66130b54-d958-5449-b32e-e09731f751e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-3)" :db/id #edb/ref 17592186352466} {:answer/id #uuid "72d2ceff-58e4-5cc6-ae01-b9e7dcc9c275" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,5)" :db/id #edb/ref 17592186352571} {:answer/id #uuid "75807951-bdad-56c4-9ac3-85b96c3b3874" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,0)" :db/id #edb/ref 17592186352599} {:answer/id #uuid "bf82ba33-b385-51d9-aff0-7b68257c69a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,5)" :db/id #edb/ref 17592186353211}] :answer-field/correct {:answer/id #uuid "75807951-bdad-56c4-9ac3-85b96c3b3874" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,0)" :db/id #edb/ref 17592186352599} :answer-field/id #uuid "46991009-d0a6-523f-9684-9c96c88c491a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186353940}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f2eb1bd6-8295-533c-aa8b-65d0d7da5480" :question/math-academy-id "q-84967" :question/problem "What are the coordinates of the vertex of the parabola $(x+3)^{2}=5y?$" :question/worked-solution "The standard equation of an upward- or downward-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(x-h)^{2}=4p(y-k),\n$$\n\nwhere $p$ is constant.\n\nWe can rewrite the given equation as\n\n$$\n\\begin{aligned}(x+3)^{2} & =4(\\frac{5}{4})(y-0).\\end{aligned}\n$$\n\nIt is now clear that our equation is of the standard type with $p=\\frac{5}{4}.$\n\nComparing our equation with the standard equation, we can see that we have $h=-3$ and $k=0.$ Therefore, the coordinates of the vertex of the parabola are $(-3,0).$"}] [{:db/id #edb/ref 17592186354374 :knowledge-point/_questions [{:db/id #edb/ref 17592186096762 :knowledge-point/id #uuid "67455965-c9d3-5ae8-8b56-2a58af95df0a" :knowledge-point/title "Stating the Vertex of a Vertical Parabola Given Its Equation in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "742410bb-2ab4-57fc-913b-6ecb343888eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,4)" :db/id #edb/ref 17592186352584} {:answer/id #uuid "84abaa01-9fbd-5cb5-a110-dcc1e511092a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,2)" :db/id #edb/ref 17592186352725} {:answer/id #uuid "afe794dc-0003-5e72-acfa-870268283669" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,2)" :db/id #edb/ref 17592186353071} {:answer/id #uuid "e1fc4087-72ff-5a59-852b-7f1da6c1324a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,-4)" :db/id #edb/ref 17592186353528} {:answer/id #uuid "ee9f7a1f-9be0-5f40-943b-68f3ef3bf9b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,-4)" :db/id #edb/ref 17592186353646}] :answer-field/correct {:answer/id #uuid "742410bb-2ab4-57fc-913b-6ecb343888eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,4)" :db/id #edb/ref 17592186352584} :answer-field/id #uuid "bbf587d9-0a1e-5a18-ae07-ecc0a460ff07" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354138}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "86b88f9c-a48e-50fc-bffe-5ae45a172150" :question/math-academy-id "q-84969" :question/problem "What are the coordinates of the vertex of the parabola $(x-1)^{2}=2(y-4)?$" :question/worked-solution "The standard equation of an upward- or downward-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(x-h)^{2}=4p(y-k),\n$$\n\nwhere $p$ is constant.\n\nWe can rewrite the given equation as\n\n$$\n\\begin{aligned}(x-1)^{2} & =4(\\frac{1}{2})(y-4).\\end{aligned}\n$$\n\nIt is now clear that our equation is of the standard type with $p=\\frac{1}{2}.$\n\nComparing our equation with the standard equation, we can see that we have $h=1$ and $k=4.$ Therefore, the coordinates of the vertex of the parabola are $(1,4).$"}] [{:db/id #edb/ref 17592186377948 :knowledge-point/_questions [{:db/id #edb/ref 17592186096762 :knowledge-point/id #uuid "67455965-c9d3-5ae8-8b56-2a58af95df0a" :knowledge-point/title "Stating the Vertex of a Vertical Parabola Given Its Equation in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8eda6d29-40ac-5738-a2f2-c97e5bb47358" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,-20)" :db/id #edb/ref 17592186377950} {:answer/id #uuid "20ee1b63-d016-56fb-838e-47b0aaa5dd6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-5,-2)" :db/id #edb/ref 17592186377951} {:answer/id #uuid "62eb4e3a-9539-55d7-abee-32386932d38d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,2)" :db/id #edb/ref 17592186377952} {:answer/id #uuid "0ed5ca01-e421-591f-8ec6-a29c43e5ac15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,-10)" :db/id #edb/ref 17592186377953} {:answer/id #uuid "6b93ae74-b02d-5715-b225-97f3a7ceb59c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-10,2)" :db/id #edb/ref 17592186377954}] :answer-field/correct {:answer/id #uuid "20ee1b63-d016-56fb-838e-47b0aaa5dd6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-5,-2)" :db/id #edb/ref 17592186377951} :answer-field/id #uuid "dc02e9af-d9a2-5171-b2d2-ec27c9ca85be" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186377949}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6325964c-099b-5c05-b2a1-5fc5ca3bed2a" :question/math-academy-id "q-84970" :question/problem "What are the coordinates of the vertex of the parabola $(x+5)^{2}=-20(y+2)?$" :question/worked-solution "The standard equation of an upward- or downward-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(x-h)^{2}=4p(y-k),\n$$\n\nwhere $p$ is constant.\n\nWe can rewrite the given equation as\n\n$$\n\\begin{aligned}(x+5)^{2} & =4(-5)(y+2).\\end{aligned}\n$$\n\nIt is now clear that our equation is of the standard type with $p=-5.$\n\nComparing our equation with the standard equation, we can see that we have $h=-5$ and $k=-2.$ Therefore, the coordinates of the vertex of the parabola are $(-5,-2).$"}] [{:db/id #edb/ref 17592186440817 :knowledge-point/_questions [{:db/id #edb/ref 17592186096763 :knowledge-point/id #uuid "9e302810-8b14-5c8c-8bbb-245386a66b7c" :knowledge-point/title "Stating the Vertex of a Horizontal Parabola Given Its Equation in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e158221-97dc-5854-80a8-edc02578c681" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(15,3)" :db/id #edb/ref 17592186440784} {:answer/id #uuid "606fc074-de50-5