/ref 17592186096763 :knowledge-point/id #uuid "9e302810-8b14-5c8c-8bbb-245386a66b7c" :knowledge-point/title "Stating the Vertex of a Horizontal Parabola Given Its Equation in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7cfad461-790b-5508-af1b-6805aadb0289" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(8,6)" :db/id #edb/ref 17592186377964} {:answer/id #uuid "f6fc8ada-4f57-5d87-b517-21a3ca68e2c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-16,-6)" :db/id #edb/ref 17592186377965} {:answer/id #uuid "c494714f-7193-5ec7-876c-fe6709380caf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-6,-8)" :db/id #edb/ref 17592186377966} {:answer/id #uuid "62e00f58-5de6-5179-8ad6-0280cff2533e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-8,-6)" :db/id #edb/ref 17592186377967} {:answer/id #uuid "96b22878-a540-53b9-9f81-9ee8775c3d20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(6,8)" :db/id #edb/ref 17592186377968}] :answer-field/correct {:answer/id #uuid "62e00f58-5de6-5179-8ad6-0280cff2533e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-8,-6)" :db/id #edb/ref 17592186377967} :answer-field/id #uuid "fda3649a-ac4e-51ba-8f62-cf9e13c454ee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186377963}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a9071e54-31a2-59dd-bc25-80b2c2dae136" :question/math-academy-id "q-85064" :question/problem "What are the coordinates of the vertex of the parabola $(y+6)^{2}=-6(x+8)?$" :question/worked-solution "The standard equation of a left- or right-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(y-k)^{2}=4p(x-h),\n$$\n\nwhere $p$ is constant.\n\nWe can rewrite the given equation as \n\n$$\n(y+6)^{2}=4(-\\frac{6}{4})(x+8),\n$$\n\nwhich simplifies to\n\n$$\n(y+6)^{2}=4(-\\frac{3}{2})(x+8).\n$$\n\nIt is now clear that our equation is of the standard type with $p=-\\frac{3}{2}.$ \n\nComparing our equation with the standard equation, we can see that we have $h=-8$ and $k=-6.$ Therefore, the coordinates of the vertex of the parabola are $(-8,-6).$"}]}
