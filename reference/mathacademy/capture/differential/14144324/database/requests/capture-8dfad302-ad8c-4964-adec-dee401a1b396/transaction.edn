-4271-553b-b7f0-321ce1a2a15a" :answer-field/id #uuid "eb3bf028-4271-553b-b7f0-321ce1a2a15a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-54e965b8-c1a9-58ba-b962-2f2f97706924" :answer-field/choices ["answer-b71cc527-2eec-5519-8c8f-e29beb7f83ea" "answer-08f5d885-41b3-5ff4-99ec-f4526e1acc1c" "answer-54e965b8-c1a9-58ba-b962-2f2f97706924" "answer-a499074e-c3d2-5f6f-b5c5-473981372526" "answer-bfb9b3cc-e65c-5801-9dbf-ca4e28846ee3"] :db/ensure [:answer-field/validate]} {:db/id "answer-b71cc527-2eec-5519-8c8f-e29beb7f83ea" :answer/id #uuid "b71cc527-2eec-5519-8c8f-e29beb7f83ea" :answer/type :answer.type/math :answer/value "(-\\frac{3}{4},0)" :db/ensure [:answer/validate]} {:db/id "answer-08f5d885-41b3-5ff4-99ec-f4526e1acc1c" :answer/id #uuid "08f5d885-41b3-5ff4-99ec-f4526e1acc1c" :answer/type :answer.type/math :answer/value "(0,-3)" :db/ensure [:answer/validate]} {:db/id "answer-54e965b8-c1a9-58ba-b962-2f2f97706924" :answer/id #uuid "54e965b8-c1a9-58ba-b962-2f2f97706924" :answer/type :answer.type/math :answer/value "(0,0)" :db/ensure [:answer/validate]} {:db/id "answer-a499074e-c3d2-5f6f-b5c5-473981372526" :answer/id #uuid "a499074e-c3d2-5f6f-b5c5-473981372526" :answer/type :answer.type/math :answer/value "(0,\\frac{3}{4})" :db/ensure [:answer/validate]} {:db/id "answer-bfb9b3cc-e65c-5801-9dbf-ca4e28846ee3" :answer/id #uuid "bfb9b3cc-e65c-5801-9dbf-ca4e28846ee3" :answer/type :answer.type/math :answer/value "(3,0)" :db/ensure [:answer/validate]} {:db/id "question-8beb7550-388c-58d2-8337-e23626a88235" :question/id #uuid "8beb7550-388c-58d2-8337-e23626a88235" :question/math-academy-id "q-85063" :question/problem "What are the coordinates of the vertex of the parabola $(y-3)^{2}=3(x-5)?$" :question/worked-solution "The standard equation of a left- or right-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(y-k)^{2}=4p(x-h),\n$$\n\nwhere $p$ is constant.\n\nWe can rewrite the given equation as \n\n$$\n(y-3)^{2}=4(\\frac{3}{4})(x-5).\n$$\n\nIt is now clear that our equation is of the standard type with $p=\\frac{3}{4}.$ \n\nComparing our equation with the standard equation, we can see that we have $h=5$ and $k=3.$ Therefore, the coordinates of the vertex of the parabola are $(5,3).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-3dd43e9f-cccf-595f-a366-4aa91709a6c3"] :db/ensure [:question/validate]} {:db/id "answer-field-3dd43e9f-cccf-595f-a366-4aa91709a6c3" :answer-field/id #uuid "3dd43e9f-cccf-595f-a366-4aa91709a6c3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-606fc074-de50-51a1-b962-f210edc955f2" :answer-field/choices ["answer-ab388d78-1ba1-5417-bc08-3ef95393a85b" "answer-e17d625d-8595-57de-bf78-10bee40bbf00" "answer-0e158221-97dc-5854-80a8-edc02578c681" "answer-e98f94f6-3536-5a8d-b442-523918ef0a79" "answer-606fc074-de50-51a1-b962-f210edc955f2"] :db/ensure [:answer-field/validate]} {:db/id "answer-ab388d78-1ba1-5417-bc08-3ef95393a85b" :answer/id #uuid "ab388d78-1ba1-5417-bc08-3ef95393a85b" :answer/type :answer.type/math :answer/value "(-3,-5)" :db/ensure [:answer/validate]} {:db/id "answer-e17d625d-8595-57de-bf78-10bee40bbf00" :answer/id #uuid "e17d625d-8595-57de-bf78-10bee40bbf00" :answer/type :answer.type/math :answer/value "(-5,-3)" :db/ensure [:answer/validate]} {:db/id "answer-0e158221-97dc-5854-80a8-edc02578c681" :answer/id #uuid "0e158221-97dc-5854-80a8-edc02578c681" :answer/type :answer.type/math :answer/value "(15,3)" :db/ensure [:answer/validate]} {:db/id "answer-e98f94f6-3536-5a8d-b442-523918ef0a79" :answer/id #uuid "e98f94f6-3536-5a8d-b442-523918ef0a79" :answer/type :answer.type/math :answer/value "(3,5)" :db/ensure [:answer/validate]} {:db/id "answer-606fc074-de50-51a1-b962-f210edc955f2" :answer/id #uuid "606fc074-de50-51a1-b962-f210edc955f2" :answer/type :answer.type/math :answer/value "(5,3)" :db/ensure [:answer/validate]} {:db/id 17592186096900 :activity/