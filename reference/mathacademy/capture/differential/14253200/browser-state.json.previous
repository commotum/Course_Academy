mo fence=\"false\" stretchy=\"false\">⟩</mo><mo>⋅</mo><mo fence=\"false\" stretchy=\"false\">⟨</mo><mn>0.01</mn><mo>,</mo><mn>0.01</mn><mo fence=\"false\" stretchy=\"false\">⟩</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mn>3</mn><mo>+</mo><mn>1</mn><mo stretchy=\"false\">(</mo><mn>0.01</mn><mo stretchy=\"false\">)</mo><mo>+</mo><mn>0</mn><mo stretchy=\"false\">(</mo><mn>0.01</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mn>3</mn><mo>+</mo><mn>0.01</mn><mo>+</mo><mn>0</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mn>2.99</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
