/mo><mo fence=\"false\" stretchy=\"false\">⟨</mo><mn>2</mn><mo>,</mo><mn>1</mn><mo fence=\"false\" stretchy=\"false\">⟩</mo><mo>⋅</mo><mo fence=\"false\" stretchy=\"false\">⟨</mo><mo>−</mo><mn>0.05</mn><mo>,</mo><mn>2.9</mn><mo>−</mo><mn>3</mn><mo fence=\"false\" stretchy=\"false\">⟩</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>8</mn><mo>+</mo><mo fence=\"false\" stretchy=\"false\">⟨</mo><mn>2</mn><mo>,</mo><mn>1</mn><mo fence=\"false\" stretchy=\"false\">⟩</mo><mo>⋅</mo><mo fence=\"false\" stretchy=\"false\">⟨</mo><mo>−</mo><mn>0.05</mn><mo>,</mo><mo>−</mo><mn>0.1</mn><mo fence=\"false\" stretchy=\"false\">⟩</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>8</mn><mo>−</mo><mn>0.1</mn><mo>−</mo><mn>0.1</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>7.8</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
