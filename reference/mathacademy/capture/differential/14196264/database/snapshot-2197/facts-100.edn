rname{sin}⁡y & x\\operatorname{cos}⁡y\\end{bmatrix}.\n$$" #edb/ref 17592186045443] [17592186389389 #edb/ref 1075 #edb/ref 17592186389390 #edb/ref 17592186045417] [17592186389389 #edb/ref 1075 #edb/ref 17592186389391 #edb/ref 17592186045417] [17592186389389 #edb/ref 1075 #edb/ref 17592186389392 #edb/ref 17592186045417] [17592186389389 #edb/ref 1075 #edb/ref 17592186389393 #edb/ref 17592186045417] [17592186389389 #edb/ref 1075 #edb/ref 17592186389394 #edb/ref 17592186045417] [17592186389389 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186389389 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186389389 #edb/ref 1078 #edb/ref 17592186389393 #edb/ref 17592186045417] [17592186389389 #edb/ref 1079 #uuid "1904f0bd-e59f-53c2-902e-e5c624a33494" #edb/ref 17592186045417] [17592186389390 #edb/ref 1080 "\\begin{bmatrix}\\operatorname{sin}⁡y \\\\ \\operatorname{sin}⁡y\\end{bmatrix}" #edb/ref 17592186045443] [17592186389390 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186389390 #edb/ref 1083 #uuid "837de383-8a59-5e3e-b44b-4a83acba37f5" #edb/ref 17592186045417] [17592186389391 #edb/ref 1080 "\\begin{bmatrix}x\\operatorname{sin}⁡y & x\\operatorname{cos}⁡y\\end{bmatrix}" #edb/ref 17592186045443] [17592186389391 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186389391 #edb/ref 1083 #uuid "1476b37b-ce46-5ab0-aecb-36dc6b67bf4e" #edb/ref 17592186045417] [17592186389392 #edb/ref 1080 "\\begin{bmatrix}\\operatorname{cos}⁡y & x\\operatorname{sin}⁡y\\end{bmatrix}" #edb/ref 17592186045443] [17592186389392 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186389392 #edb/ref 1083 #uuid "9267d816-5255-57ea-9f4e-ac44e66b36b9" #edb/ref 17592186045417] [17592186389393 #edb/ref 1080 "\\begin{bmatrix}\\operatorname{sin}⁡y & x\\operatorname{cos}⁡y\\end{bmatrix}" #edb/ref 17592186045443] [17592186389393 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186389393 #edb/ref 1083 #uuid "cb2c5