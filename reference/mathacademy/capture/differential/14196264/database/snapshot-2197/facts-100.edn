∂{f}_{2}}{∂x} & \\frac{∂{f}_{2}}{∂y}\\end{bmatrix}\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & =\\frac{∂}{∂x}(\\operatorname{ln}⁡(xy))=\\frac{1}{x},\\, & \\frac{∂{f}_{1}}{∂y} & =\\frac{∂}{∂y}(\\operatorname{ln}⁡(xy))=\\frac{1}{y} \\\\ \\frac{∂{f}_{2}}{∂x} & =\\frac{∂}{∂x}(\\frac{y}{x})=-\\frac{y}{{x}^{2}},\\, & \\frac{∂{f}_{2}}{∂y} & =\\frac{∂}{∂y}(\\frac{y}{x})=\\frac{1}{x}\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n{f}^{′}(x)=\\begin{bmatrix}\\frac{1}{x} & \\frac{1}{y} \\\\ -\\frac{y}{{x}^{2}} & \\frac{1}{x}\\end{bmatrix}.\n$$" #edb/ref 17592186045443] [17592186389403 #edb/ref 1075 #edb/ref 17592186389404 #edb/ref 17592186045417] [17592186389403 #edb/ref 1075 #edb/ref 17592186389405 #edb/ref 17592186045417] [17592186389403 #edb/ref 1075 #edb/ref 17592186389406 #edb/ref 17592186045417] [17592186389403 #edb/ref 1075 #edb/ref 17592186389407 #edb/ref 17592186045417] [17592186389403 #edb/ref 1075 #edb/ref 17592186389408 #edb/ref 17592186045417] [17592186389403 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186389403 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186389403 #edb/ref 1078 #edb/ref 17592186389408 #edb/ref 17592186045417] [17592186389403 #edb/ref 1079 #uuid "090b72a8-f15b-5bfd-adae-9afc07d8a51e" #edb/ref 17592186045417] [17592186389404 #edb/ref 1080 "\\begin{bmatrix}\\frac{1}{y} & \\frac{y}{{x}^{2}} \\\\ \\frac{1}{y} & \\frac{1}{y}\\end{bmatrix}" #edb/ref 17592186045443] [17592186389404 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186389404 #edb/ref 1083 #uuid "df3378a4-f098-5dd2-8ca5-d33c2875b948" #edb/ref 17592186045417] [17592186389405 #edb/ref 1080 "\\begin{bmatrix}\\frac{1}{y} & \\frac{1}{x} \\\\ \\frac{y}{{x}^{2}} & \\frac{1}{y}\\end{bmatrix}" #edb/ref 17592186045443] [17592186389405 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186389405 #edb/ref 1083 #uuid "ba36a6bb-461b-576b-a8b0-07e2ea3c3d49" #edb/ref 1759218604541