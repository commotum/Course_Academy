{2}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ ⋮ \\\\ {f}_{m}({x}_{1},{x}_{2},…,{x}_{n})\\end{bmatrix},\n$$\n\n \n\nwhere ${f}_{1},{f}_{2},…,{f}_{m}$ are scalar functions with $n$ variables. If $f$ is differentiable at $x,$ then the total derivative of $f$ at $x,$ denoted ${f}^{′}(x),$ is given by the $m\\times n$ matrix\n\n$$\n{f}^{′}(x)=\\begin{bmatrix}\\frac{∂{f}_{1}}{∂{x}_{1}} & \\frac{∂{f}_{1}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{1}}{∂{x}_{n}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & \\frac{∂{f}_{2}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{2}}{∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{∂{f}_{m}}{∂{x}_{1}} & \\frac{∂{f}_{m}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{m}}{∂{x}_{n}}\\end{bmatrix}.\n$$\n\nIn our case, we have the following:\n\n$$\n{f}^{′}(x)=\\begin{bmatrix}\\frac{∂f}{∂x} & \\frac{∂f}{∂y}\\end{bmatrix}\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}({e}^{xy})=y{e}^{xy}, & \\,\\frac{∂f}{∂y} & =\\frac{∂}{∂y}({e}^{xy})=x{e}^{xy}\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n{f}^{′}(x)=\\begin{bmatrix}y{e}^{xy} & x{e}^{xy}\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186281581 :knowledge-point/_questions [{:db/id #edb/ref 17592186198411 :knowledge-point/id #uuid "d912b296-6fd0-57c2-84e8-ca0b56549756" :knowledge-point/title "Finding the Derivative of a Scalar Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00ed9573-8587-5e43-a015-cff05f479c86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2x & 3{y}^{2}\\end{bmatrix}" :db/id #edb/ref 17592186278592} {:answer/id #uuid "1b6be9b8-eeaf-5a68-b5e8-3e05681a5002" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2x{y}^{3} & 2{x}^{2}{y}^{2}\\end{bmatrix}" :db/id #edb/ref 17592186278845} {:answer/id #uuid "45f448cc-d89e-56f7-a4ed-7714c5d8bb7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}xy & {x}^{2}{y}^{2}\\end{bmatrix}" :db/id #edb/ref 17592186279215} {:answer/id #uuid "e350ff90-cfa2-5ab7-b75c-03d3b22ae22e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2xy & 3xy\\end{bmatrix}" :db/id #edb/ref 17592186280596} {:answer/id #uuid "f9d258dd-1677-5820-bd55-ad5e920dbf0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2x{y}^{3} & 3{x}^{2}{y}^{2}\\end{bmatrix}" :db/id #edb/ref 17592186280785}] :answer-field/correct {:answer/id #uuid "f9d258dd-1677-5820-bd55-ad5e920dbf0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2x{y}^{3} & 3{x}^{2}{y}^{2}\\end{bmatrix}" :db/id #edb/ref 17592186280785} :answer-field/id #uuid "e951bb64-925f-5cce-b0d3-156f8ace9ad6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281249}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b80ece25-e7d4-5756-bce7-b1813e029457" :question/math-academy-id "q-163047" :question/problem "For the function $f:{R}^{2}\\to R,$ defined as\n\n$$\nf(x)={x}^{2}{y}^{3},\\,x=\\begin{bmatrix}x \\\\ y\\end{bmatrix},\n$$\n\ncalculate ${f}^{′}(x).$" :question/worked-solution "Suppose a transformation $f:{R}^{n}\\to {R}^{m}$ is defined by \n\n$$\nf:\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{bmatrix}⟶\\begin{bmatrix}{f}_{1}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ {f}_{2}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ ⋮ \\\\ {f}_{m}({x}_{1},{x}_{2},…,{x}_{n})\\end{bmatrix},\n$$\n\n \n\nwhere ${f}_{1},{f}_{2},…,{f}_{m}$ are scalar functions with $n$ variables. If $f$ is differentiable at $x,$ then the total derivative of $f$ at $x,$ denoted ${f}^{′}(x),$ is given by the $m\\times n$ matrix\n\n$$\n{f}^{′}(x)=\\begin{bmatrix}\\frac{∂{f}_{1}}{∂{x}_{1}} & \\frac{∂{f}_{1}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{1}}{∂{x}_{n}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & \\frac{∂{f}_{2}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{2}}{∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{∂{f}_{m}}{∂{x}_{1}} & \\frac{∂{f}_{m}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{m}}{∂{x}_{n}}\\end{bmatrix}.\n$$\n\nIn our case, we have the following:\n\n$$\n{f}^{′}(x)=\\begin{bmatrix}\\frac{∂f}{∂x} & \\frac{∂f}{∂y}\\end{bmatrix}\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}({x}^{2}{y}^{3})=2x{y}^{3}, & \\,\\frac{∂f}{∂y} & =\\frac{∂}{∂y}({x}^{2}{y}^{3})=3{x}^{2}{y}^{2}\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n{f}^{′}(x)=\\begin{bmatrix}2x{y}^{3} & 3{x}^{2}{y}^{2}\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186510373 :knowledge-point/_questions [{:db/id #edb/ref 17592186198412 :knowledge-point/id #uuid "6a818e04-786a-56b6-90cf-dcb573ccfa64" :knowledge-point/title "Finding the Derivative of a Vector Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b47e061-fca8-5295-adef-032c9c071ddf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}{e}^{x}\\operatorname{cos}⁡y & {e}^{x}\\operatorname{sin}⁡y \\\\ {e}^{x}\\operatorname{cos}⁡y & {e}^{x}\\operatorname{sin}⁡y\\end{aligned}]" :db/id #edb/ref 17592186509714} {:answer/id #uuid "22517a46-9e06-5b23-9c60-a096babd6902" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}{e}^{x}\\operatorname{cos}⁡y & -{e}^{x}\\operatorname{sin}⁡y \\\\ {e}^{x}\\operatorname{sin}⁡y & {e}^{x}\\operatorname{cos}⁡y\\end{aligned}]" :db/id #edb/ref 17592186509758} {:answer/id #uuid "2ef889ac-2980-5e6c-98ea-cb7cf876863a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}{e}^{x}\\operatorname{cos}⁡y & \\operatorname{sin}⁡y \\\\ \\operatorname{sin}⁡y & {e}^{x}\\operatorname{cos}⁡y\\end{aligned}]" :db/id #edb/ref 17592186509789} {:answer/id #uuid "55b220b0-4440-5962-b48e-b368d091875f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}{e}^{x}\\operatorname{sin}⁡y & -{e}^{x}\\operatorname{cos}⁡y \\\\ -{e}^{x}\\operatorname{sin}⁡y & {e}^{x}\\operatorname{cos}⁡y\\end{aligned}]" :db/id #edb/ref 17592186509863} {:answer/id #uuid "8f3826df-e89c-574b-869e-aafefa7eef5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}{e}^{x}\\operatorname{sin}⁡y & {e}^{x}\\operatorname{sin}⁡y \\\\ {e}^{x}\\operatorname{cos}⁡y & -{e}^{x}\\operatorname{cos}⁡y\\end{aligned}]" :db/id #edb/ref 17592186509995}] :answer-field/correct {:answer/id #uuid "22517a46-9e06-5b23-9c60-a096babd6902" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}{e}^{x}\\operatorname{cos}⁡y & -{e}^{x}\\operatorname{sin}⁡y \\\\ {e}^{x}\\operatorname{sin}⁡y & {e}^{x}\\operatorname{cos}⁡y\\end{aligned}]" :db/id #edb/ref 17592186509758} :answer-field/id #uuid "35fee1ea-d13a-5c7a-abbe-6f0b8b9ab409" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186510266}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "233a01ce-8236-503f-8343-bf44a66e9626" :question/math-academy-id "q-163051" :question/problem "For the transformation $f:{R}^{2}\\to {R}^{2},$ defined as\n\n$$\nf(x)=[\\begin{aligned}{e}^{x}\\operatorname{cos}⁡y \\\\ {e}^{x}\\operatorname{sin}⁡y\\end{aligned}],\\,x=[\\begin{aligned}x \\\\ y\\end{aligned}],\n$$\n\ncalculate ${f}^{′}(x).$" :question/worked-solution "Suppose a transformation $f:{R}^{n}\\to {R}^{m}$ is defined by \n\n$$\nf:[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]⟶[\\begin{aligned}{f}_{1}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ {f}_{2}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ ⋮ \\\\ {f}_{m}({x}_{1},{x}_{2},…,{x}_{n})\\end{aligned}],\n$$\n\n \n\nwhere ${f}_{1},{f}_{2},…,{f}_{m}$ are scalar functions with $n$ variables. If $f$ is differentiable at $x,$ then the total derivative of $f$ at $x,$ denoted ${f}^{′}(x),$ is given by the $m\\times n$ matrix\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{∂{f}_{1}}{∂{x}_{1}} & \\frac{∂{f}_{1}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{1}}{∂{x}_{n}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & \\frac{∂{f}_{2}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{2}}{∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{∂{f}_{m}}{∂{x}_{1}} & \\frac{∂{f}_{m}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{m}}{∂{x}_{n}}\\end{aligned}].\n$$\n\nIn our case, we have the following:\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & \\frac{∂{f}_{1}}{∂y} \\\\ \\frac{∂{f}_{2}}{∂x} & \\frac{∂{f}_{2}}{∂y}\\end{aligned}]\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & =\\frac{∂}{∂x}({e}^{x}\\operatorname{cos}⁡y)={e}^{x}\\operatorname{cos}⁡y,\\, & \\frac{∂{f}_{1}}{∂y} & =\\frac{∂}{∂y}({e}^{x}\\operatorname{cos}⁡y)=-{e}^{x}\\operatorname{sin}⁡y \\\\ \\frac{∂{f}_{2}}{∂x} & =\\frac{∂}{∂x}({e}^{x}\\operatorname{sin}⁡y)={e}^{x}\\operatorname{sin}⁡y,\\, & \\frac{∂{f}_{2}}{∂y} & =\\frac{∂}{∂y}({e}^{x}\\operatorname{sin}⁡y)={e}^{x}\\operatorname{cos}⁡y\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n{f}^{′}(x)=[\\begin{aligned}{e}^{x}\\operatorname{cos}⁡y & -{e}^{x}\\operatorname{sin}⁡y \\\\ {e}^{x}\\operatorname{sin}⁡y & {e}^{x}\\operatorname{cos}⁡y\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186198653 :knowledge-point/_questions [{:db/id #edb/ref 17592186198413 :knowledge-point/id #uuid "0e90349c-33ae-5b60-9d0d-7542dfebbbc7" :knowledge-point/title "Finding the Tangent Plane to the Graph of a Scalar Function in Matrix Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8f0af6f4-8846-5cc9-b0d0-ef675db7ecfa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186194550} {:answer/id #uuid "93e51430-7515-5ea7-b676-8718aa40b834" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186194551} {:answer/id #uuid "f248937d-3d19-5f99-a0d4-d58ced4eba66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186194552} {:answer/id #uuid "15e93809-1fc8-5035-b5b6-cb4d0ca11d45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186194553} {:answer/id #uuid "263c53e8-2f06-5be5-9f6a-884b62308d77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186194554}] :answer-field/correct {:answer/id #uuid "15e93809-1fc8-5035-b5b6-cb4d0ca11d45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186194553} :answer-field/id #uuid "dbabfec0-d273-5628-a4d6-fe7beb8d8851" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186194549}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1286acb9-42cc-5da3-a992-0e5c7b3d2c79" :question/math-academy-id "q-163057" :question/problem "Consider the function $f:{R}^{2}\\to R,$ defined as\n\n$$\nf(x)={e}^{x}+y,\\,x=\\begin{bmatrix}x \\\\ y\\end{bmatrix}.\n$$\n\nIf the tangent to $f$ at $a=\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}$ is given by\n\n$$\nz-∗=\\begin{bmatrix}∗ & ∗\\end{bmatrix}(\\begin{bmatrix}x \\\\ y\\end{bmatrix}-\\begin{bmatrix}0 \\\\ 1\\end{bmatrix})\n$$\n\nwhat is the sum of the missing values?" :question/worked-solution "Suppose a transformation $f:{R}^{n}\\to {R}^{m}$ is defined by \n\n$$\nf:\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{bmatrix}⟶\\begin{bmatrix}{f}_{1}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ {f}_{2}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ ⋮ \\\\ {f}_{m}({x}_{1},{x}_{2},…,{x}_{n})\\end{bmatrix},\n$$\n\n \n\nwhere ${f}_{1},{f}_{2},…,{f}_{m}$ are scalar functions with $n$ variables. If $f$ is differentiable at $x,$ then the total derivative of $f$ at $x,$ denoted ${f}^{′}(x),$ is given by the $m\\times n$ matrix\n\n$$\n{f}^{′}(x)=\\begin{bmatrix}\\frac{∂{f}_{1}}{∂{x}_{1}} & \\frac{∂{f}_{1}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{1}}{∂{x}_{n}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & \\frac{∂{f}_{2}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{2}}{∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{∂{f}_{m}}{∂{x}_{1}} & \\frac{∂{f}_{m}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{m}}{∂{x}_{n}}\\end{bmatrix}.\n$$\n\nIn our case, we have the following:\n\n$$\n{f}^{′}(x)=\\begin{bmatrix}\\frac{∂f}{∂x} & \\frac{∂f}{∂y}\\end{bmatrix}\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}({e}^{x}+y)={e}^{x},\\, & \\frac{∂f}{∂y} & =\\frac{∂}{∂y}({e}^{x}+y)=1\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n{f}^{′}(x)=\\begin{bmatrix}{e}^{x} & 1\\end{bmatrix}.\n$$\n\nEvaluating $f$ and its derivative at $x=a=\\begin{bmatrix}0 \\\\ 1\\end{bmatrix},$ we have\n\n$$\nf(a)=2,\\,{f}^{′}(a)=\\begin{bmatrix}1 & 1\\end{bmatrix}.\n$$\n\nThe tangent to $f$ at $x=a$ is given by\n\n$$\nz-f(a)={f}^{′}(a)(x-a).\n$$\n\nSubstituting $f(a),$ ${f}^{′}(a),$ and $a$ in the equation above, we obtain\n\n$$\nz-2=\\begin{bmatrix}1 & 1\\end{bmatrix}(\\begin{bmatrix}x \\\\ y\\end{bmatrix}-\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}).\n$$\n\nTherefore, the sum of the missing values is\n\n$$\n2+1+1=4.\n$$"}] [{:db/id #edb/ref 17592186510385 :knowledge-point/_questions [{:db/id #edb/ref 17592186198413 :knowledge-point/id #uuid "0e90349c-33ae-5b60-9d0d-7542dfebbbc7" :knowledge-point/title "Finding the Tangent Plane to the Graph of a Scalar Function in Matrix Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f7594d4-8ebb-59a3-b3a9-1b3956c96f5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186509790} {:answer/id #uuid "9a750e94-0425-5e6a-9e86-ff988b0a821f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186510011} {:answer/id #uuid "b96dff26-09a1-53b6-80bd-bf9b4effbbec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186510083} {:answer/id #uuid "dc58ca95-eb79-5822-8857-92d798da6418" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186510158} {:answer/id #uuid "e23686e8-e6e0-5d6f-9b01-569d4870e8ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186510170}] :answer-field/correct {:answer/id #uuid "2f7594d4-8ebb-59a3-b3a9-1b3956c96f5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186509790} :answer-field/id #uuid "ac4ab69d-722b-5430-b62d-48dc3d21f50c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186510329}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "41ff97cf-642e-5207-833e-62b8b292b55c" :question/math-academy-id "q-163071" :question/problem "Consider the function $f:{R}^{2}\\to R,$ defined as\n\n$$\nf(x)={e}^{x+{y}^{2}},\\,x=[\\begin{aligned}x \\\\ y\\end{aligned}].\n$$\n\nIf the tangent to $f$ at $a=[\\begin{aligned}-1 \\\\ 1\\end{aligned}]$ is given by\n\n$$\nz-∗=[\\begin{aligned}∗ & ∗\\end{aligned}]([\\begin{aligned}x \\\\ y\\end{aligned}]-[\\begin{aligned}-1 \\\\ 1\\end{aligned}])\n$$\n\nwhat is the sum of the missing values?" :question/worked-solution "Suppose a transformation $f:{R}^{n}\\to {R}^{m}$ is defined by \n\n$$\nf:[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]⟶[\\begin{aligned}{f}_{1}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ {f}_{2}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ ⋮ \\\\ {f}_{m}({x}_{1},{x}_{2},…,{x}_{n})\\end{aligned}],\n$$\n\n \n\nwhere ${f}_{1},{f}_{2},…,{f}_{m}$ are scalar functions with $n$ variables. If $f$ is differentiable at $x,$ then the total derivative of $f$ at $x,$ denoted ${f}^{′}(x),$ is given by the $m\\times n$ matrix\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{∂{f}_{1}}{∂{x}_{1}} & \\frac{∂{f}_{1}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{1}}{∂{x}_{n}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & \\frac{∂{f}_{2}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{2}}{∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{∂{f}_{m}}{∂{x}_{1}} & \\frac{∂{f}_{m}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{m}}{∂{x}_{n}}\\end{aligned}].\n$$\n\nIn our case, we have the following:\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{∂f}{∂x} & \\frac{∂f}{∂y}\\end{aligned}]\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}({e}^{x+{y}^{2}})={e}^{x+{y}^{2}},\\, & \\frac{∂f}{∂y} & =\\frac{∂}{∂y}({e}^{x+{y}^{2}})=2y{e}^{x+{y}^{2}}\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n{f}^{′}(x)=[\\begin{aligned}{e}^{x+{y}^{2}} & 2y{e}^{x+{y}^{2}}\\end{aligned}].\n$$\n\nEvaluating $f$ and its derivative at $x=a=[\\begin{aligned}-1 \\\\ 1\\end{aligned}],$ we have\n\n$$\nf(a)=1,\\,{f}^{′}(a)=[\\begin{aligned}1 & 2\\end{aligned}].\n$$\n\nThe tangent to $f$ at $x=a$ is given by\n\n$$\nz-f(a)={f}^{′}(a)(x-a).\n$$\n\nSubstituting $f(a),$ ${f}^{′}(a),$ and $a$ in the equation above, we obtain\n\n$$\nz-1=[\\begin{aligned}1 & 2\\end{aligned}]([\\begin{aligned}x \\\\ y\\end{aligned}]-[\\begin{aligned}-1 \\\\ 1\\end{aligned}]).\n$$\n\nTherefore, the sum of the missing values is\n\n$$\n1+1+2=4.\n$$"}] [{:db/id #edb/ref 17592186434998 :knowledge-point/_questions [{:db/id #edb/ref 17592186198413 :knowledge-point/id #uuid "0e90349c-33ae-5b60-9d0d-7542dfebbbc7" :knowledge-point/title "Finding the Tangent Plane to the Graph of a Scalar Function in Matrix Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7054d950-8f37-587d-a33e-968d65e47cb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡4+1" :db/id #edb/ref 17592186434987} {:answer/id #uuid "7643073f-ce44-57df-9282-30a16459d53b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡6-\\frac{1}{3}" :db/id #edb/ref 17592186434988} {:answer/id #uuid "b7f059d2-e77c-5931-aa43-e92b03f2ab7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡6+\\frac{1}{3}" :db/id #edb/ref 17592186434991} {:answer/id #uuid "cf609f5e-73ea-5693-ba97-16c620f066fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡6+1" :db/id #edb/ref 17592186434993} {:answer/id #uuid "f3ddf159-b8c5-5358-82de-10f08389dfb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡4+\\frac{1}{3}" :db/id #edb/ref 17592186434994}] :answer-field/correct {:answer/id #uuid "b7f059d2-e77c-5931-aa43-e92b03f2ab7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡6+\\frac{1}{3}" :db/id #edb/ref 17592186434991} :answer-field/id #uuid "be799441-b520-5409-95fd-e9decc4e3407" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186434995}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "df9f8fb7-c1aa-51d4-afc9-10cbbb747f39" :question/math-academy-id "q-163077" :question/problem "Consider the function $f:{R}^{2}\\to R,$ defined as\n\n$$\nf(x)=\\operatorname{ln}⁡({x}^{2}+{y}^{2}+1),\\,x=\\begin{bmatrix}x \\\\ y\\end{bmatrix}.\n$$\n\nIf the tangent to $f$ at $a=\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}$ is given by\n\n$$\nz-∗=\\begin{bmatrix}∗ & ∗\\end{bmatrix}(\\begin{bmatrix}x \\\\ y\\end{bmatrix}-\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix})\n$$\n\nwhat is the sum of the missing values?" :question/worked-solution "Suppose a transformation $f:{R}^{n}\\to {R}^{m}$ is defined by \n\n$$\nf:\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{bmatrix}⟶\\begin{bmatrix}{f}_{1}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ {f}_{2}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ ⋮ \\\\ {f}_{m}({x}_{1},{x}_{2},…,{x}_{n})\\end{bmatrix},\n$$\n\n \n\nwhere ${f}_{1},{f}_{2},…,{f}_{m}$ are scalar functions with $n$ variables. If $f$ is differentiable at $x,$ then the total derivative of $f$ at $x,$ denoted ${f}^{′}(x),$ is given by the $m\\times n$ matrix\n\n$$\n{f}^{′}(x)=\\begin{bmatrix}\\frac{∂{f}_{1}}{∂{x}_{1}} & \\frac{∂{f}_{1}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{1}}{∂{x}_{n}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & \\frac{∂{f}_{2}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{2}}{∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{∂{f}_{m}}{∂{x}_{1}} & \\frac{∂{f}_{m}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{m}}{∂{x}_{n}}\\end{bmatrix}.\n$$\n\nIn our case, we have the following:\n\n$$\n{f}^{′}(x)=\\begin{bmatrix}\\frac{∂f}{∂x} & \\frac{∂f}{∂y}\\end{bmatrix}\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}\\operatorname{ln}⁡({x}^{2}+{y}^{2}+1)=\\frac{2x}{{x}^{2}+{y}^{2}+1},\\, & \\frac{∂f}{∂y} & =\\frac{∂}{∂y}\\operatorname{ln}⁡({x}^{2}+{y}^{2}+1)=\\frac{2y}{{x}^{2}+{y}^{2}+1}\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n{f}^{′}(x)=\\begin{bmatrix}\\frac{2x}{{x}^{2}+{y}^{2}+1} & \\frac{2y}{{x}^{2}+{y}^{2}+1}\\end{bmatrix}.\n$$\n\nEvaluating $f$ and its derivative at $x=a=\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix},$ we have\n\n$$\nf(a)=\\operatorname{ln}⁡6,\\,{f}^{′}(a)=\\begin{bmatrix}-\\frac{1}{3} & \\frac{2}{3}\\end{bmatrix}.\n$$\n\nThe tangent to $f$ at $x=a$ is given by\n\n$$\nz-f(a)={f}^{′}(a)(x-a).\n$$\n\nSubstituting $f(a),$ ${f}^{′}(a),$ and $a$ in the equation above, we obtain\n\n$$\nz-\\operatorname{ln}⁡6=\\begin{bmatrix}-\\frac{1}{3} & \\frac{2}{3}\\end{bmatrix}(\\begin{bmatrix}x \\\\ y\\end{bmatrix}-\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}).\n$$\n\nTherefore, the sum of the missing values is\n\n$$\n\\operatorname{ln}⁡6+(-\\frac{1}{3})+\\frac{2}{3}=\\operatorname{ln}⁡6+\\frac{1}{3}.\n$$"}] [{:db/id #edb/ref 17592186281591 :knowledge-point/_questions [{:db/id #edb/ref 17592186198413 :knowledge-point/id #uuid "0e90349c-33ae-5b60-9d0d-7542dfebbbc7" :knowledge-point/title "Finding the Tangent Plane to the Graph of a Scalar Function in Matrix Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f88b0ce-cd12-57a2-ada9-e17ffbb3dfce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186279008} {:answer/id #uuid "367082cc-a111-5632-9966-6e0379e23b29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186279067} {:answer/id #uuid "3cee07d8-519e-5ab6-b7d4-36449ca2b9b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186279128} {:answer/id #uuid "a93f5414-c769-5bf4-8e20-8ee2bcd8bc57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186280094} {:answer/id #uuid "ae303b7c-341e-559b-bf25-a4ca6c37fbd8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186280135}] :answer-field/correct {:answer/id #uuid "2f88b0ce-cd12-57a2-ada9-e17ffbb3dfce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186279008} :answer-field/id #uuid "3cda02f6-149c-5bf3-821e-c0b55d3c3fd6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280938}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c2ef07bc-cc92-59f4-ab07-cedcba745cfb" :question/math-academy-id "q-163078" :question/problem "Consider the function $f:{R}^{2}\\to R,$ defined as\n\n$$\nf(x)={x}^{2}+xy,\\,x=\\begin{bmatrix}x \\\\ y\\end{bmatrix}.\n$$\n\nIf the tangent to $f$ at $a=\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix}$ is given by\n\n$$\nz-∗=\\begin{bmatrix}∗ & ∗\\end{bmatrix}(\\begin{bmatrix}x \\\\ y\\end{bmatrix}-\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix})\n$$\n\nwhat is the sum of the missing values?" :question/worked-solution "Suppose a transformation $f:{R}^{n}\\to {R}^{m}$ is defined by \n\n$$\nf:\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{bmatrix}⟶\\begin{bmatrix}{f}_{1}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ {f}_{2}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ ⋮ \\\\ {f}_{m}({x}_{1},{x}_{2},…,{x}_{n})\\end{bmatrix},\n$$\n\n \n\nwhere ${f}_{1},{f}_{2},…,{f}_{m}$ are scalar functions with $n$ variables. If $f$ is differentiable at $x,$ then the total derivative of $f$ at $x,$ denoted ${f}^{′}(x),$ is given by the $m\\times n$ matrix\n\n$$\n{f}^{′}(x)=\\begin{bmatrix}\\frac{∂{f}_{1}}{∂{x}_{1}} & \\frac{∂{f}_{1}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{1}}{∂{x}_{n}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & \\frac{∂{f}_{2}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{2}}{∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{∂{f}_{m}}{∂{x}_{1}} & \\frac{∂{f}_{m}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{m}}{∂{x}_{n}}\\end{bmatrix}.\n$$\n\nIn our case, we have the following:\n\n$$\n{f}^{′}(x)=\\begin{bmatrix}\\frac{∂f}{∂x} & \\frac{∂f}{∂y}\\end{bmatrix}\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}({x}^{2}+xy)=2x+y,\\, & \\frac{∂f}{∂y} & =\\frac{∂}{∂y}({x}^{2}+xy)=x\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n{f}^{′}(x)=\\begin{bmatrix}2x+y & x\\end{bmatrix}.\n$$\n\nEvaluating $f$ and its derivative at $x=a=\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix},$ we have\n\n$$\nf(a)=2,\\,{f}^{′}(a)=\\begin{bmatrix}-3 & -2\\end{bmatrix}.\n$$\n\nThe tangent to $f$ at $x=a$ is given by\n\n$$\nz-f(a)={f}^{′}(a)(x-a).\n$$\n\nSubstituting $f(a),$ ${f}^{′}(a),$ and $a$ in the equation above, we obtain\n\n$$\nz-2=\\begin{bmatrix}-3 & -2\\end{bmatrix}(\\begin{bmatrix}x \\\\ y\\end{bmatrix}-\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix}).\n$$\n\nTherefore, the sum of the missing values is\n\n$$\n2+(-3)+(-2)=-3.\n$$"}] [{:db/id #edb/ref 17592186281598 :knowledge-point/_questions [{:db/id #edb/ref 17592186198414 :knowledge-point/id #uuid "9f09fc28-bdce-554f-98f5-019d34542a13" :knowledge-point/title "Finding an Affine Approximation of a Vector Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45c9a58e-8d3b-57b6-8e91-04a87d006dce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{-1}+1" :db/id #edb/ref 17592186279213} {:answer/id #uuid "4e4851dc-cb60-52d4-87b2-4e53e8822302" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{-1}-2" :db/id #edb/ref 17592186279303} {:answer/id #uuid "ad842f7f-8b8c-5df0-a4bc-a9a5bf5e717d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e-1" :db/id #edb/ref 17592186280128} {:answer/id #uuid "d8c2ad7f-d4de-5ea6-8438-e45d2c59cd73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-1}-2" :db/id #edb/ref 17592186280507} {:answer/id #uuid "fea2d41b-5110-5c5b-bb69-ea4bae3b6011" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-1}-1" :db/id #edb/ref 17592186280817}] :answer-field/correct {:answer/id #uuid "d8c2ad7f-d4de-5ea6-8438-e45d2c59cd73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-1}-2" :db/id #edb/ref 17592186280507} :answer-field/id #uuid "65aecb01-e734-56a3-bd50-7ea519b4880f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281006}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "47bfa96d-bfdf-5b9f-a011-3a66ebe7f2b8" :question/math-academy-id "q-163093" :question/problem "Consider the transformation $f:{R}^{2}\\to {R}^{2},$ defined as\n\n$$\nf(x)=\\begin{bmatrix}\\operatorname{ln}⁡({x}_{1})+{x}_{2} \\\\ {x}_{2}^{2}+1\\end{bmatrix},\\,x=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}.\n$$\n\nIf the linear approximation of $f$ at  $a=\\begin{bmatrix}e \\\\ -1\\end{bmatrix}$ is given by\n\n$$\nf(x)≈\\begin{bmatrix}∗ \\\\ 2\\end{bmatrix}+\\begin{bmatrix}∗ & 1 \\\\ 0 & ∗\\end{bmatrix}(x-\\begin{bmatrix}e \\\\ -1\\end{bmatrix}),\n$$\n\nwhat is the sum of the missing values?" :question/worked-solution "Suppose a transformation $f:{R}^{n}\\to {R}^{m}$ is defined by \n\n$$\nf:\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{bmatrix}⟶\\begin{bmatrix}{f}_{1}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ {f}_{2}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ ⋮ \\\\ {f}_{m}({x}_{1},{x}_{2},…,{x}_{n})\\end{bmatrix},\n$$\n\n \n\nwhere ${f}_{1},{f}_{2},…,{f}_{m}$ are scalar functions with $n$ variables. If $f$ is differentiable at $x,$ then the total derivative of $f$ at $x,$ denoted ${f}^{′}(x),$ is given by the $m\\times n$ matrix\n\n$$\n{f}^{′}(x)=\\begin{bmatrix}\\frac{∂{f}_{1}}{∂{x}_{1}} & \\frac{∂{f}_{1}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{1}}{∂{x}_{n}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & \\frac{∂{f}_{2}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{2}}{∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{∂{f}_{m}}{∂{x}_{1}} & \\frac{∂{f}_{m}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{m}}{∂{x}_{n}}\\end{bmatrix}.\n$$\n\nIn our case, we have the following:\n\n$$\n{f}^{′}(x)=\\begin{bmatrix}\\frac{∂{f}_{1}}{∂{x}_{1}} & \\frac{∂{f}_{1}}{∂{x}_{2}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & \\frac{∂{f}_{2}}{∂{x}_{2}}\\end{bmatrix}\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂{f}_{1}}{∂{x}_{1}} & =\\frac{∂}{∂{x}_{1}}(\\operatorname{ln}⁡({x}_{1})+{x}_{2})=\\frac{1}{{x}_{1}},\\, & \\frac{∂{f}_{1}}{∂{x}_{2}} & =\\frac{∂}{∂{x}_{2}}(\\operatorname{ln}⁡({x}_{1})+{x}_{2})=1 \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & =\\frac{∂}{∂{x}_{1}}({x}_{2}^{2}+1)=0,\\, & \\frac{∂{f}_{2}}{∂{x}_{2}} & =\\frac{∂}{∂{x}_{2}}({x}_{2}^{2}+1)=2{x}_{2}\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n{f}^{′}(x)=\\begin{bmatrix}{x}_{1}^{-1} & 1 \\\\ 0 & 2{x}_{2}\\end{bmatrix}.\n$$\n\nEvaluating $f$ and its derivative at $x=a=\\begin{bmatrix}e \\\\ -1\\end{bmatrix},$ we have\n\n$$\nf(a)=\\begin{bmatrix}0 \\\\ 2\\end{bmatrix},\\,{f}^{′}(a)=\\begin{bmatrix}{e}^{-1} & 1 \\\\ 0 & -2\\end{bmatrix}.\n$$\n\nThe linear approximation of $f$ at $x=a$ is given by\n\n$$\nf(x)≈f(a)+{f}^{′}(a)(x-a).\n$$\n\nSubstituting $f(a),$ ${f}^{′}(a),$ and $a$ in the equation above, we obtain\n\n$$\nf(x)≈\\begin{bmatrix}0 \\\\ 2\\end{bmatrix}+\\begin{bmatrix}{e}^{-1} & 1 \\\\ 0 & -2\\end{bmatrix}(x-\\begin{bmatrix}e \\\\ -1\\end{bmatrix}).\n$$\n\nTherefore, the sum of the missing values is\n\n$$\n0+{e}^{-1}+(-2)={e}^{-1}-2.\n$$"}] [{:db/id #edb/ref 17592186281601 :knowledge-point/_questions [{:db/id #edb/ref 17592186198412 :knowledge-point/id #uuid "6a818e04-786a-56b6-90cf-dcb573ccfa64" :knowledge-point/title "Finding the Derivative of a Vector Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a2159cd-ca1d-52a3-8158-711386d7dc3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{y} & {e}^{x-y} \\\\ -\\frac{x}{{y}^{2}} & -{e}^{x-y}\\end{bmatrix}" :db/id #edb/ref 17592186278824} {:answer/id #uuid "265096a0-323d-5747-bf84-d4b8bad05502" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{x}{{y}^{2}} & \\frac{1}{{y}^{2}} \\\\ -y{e}^{x-y} & x{e}^{x-y}\\end{bmatrix}" :db/id #edb/ref 17592186278932} {:answer/id #uuid "2d50d60a-ea1f-5bd9-a908-51ae26d6e264" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{y} & \\frac{x}{{y}^{2}} \\\\ -{e}^{x-y} & {e}^{x-y}\\end{bmatrix}" :db/id #edb/ref 17592186278990} {:answer/id #uuid "45213a92-906d-5fea-858d-97190bb5ed5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{y} & -\\frac{x}{{y}^{2}} \\\\ {e}^{x-y} & -{e}^{x-y}\\end{bmatrix}" :db/id #edb/ref 17592186279207} {:answer/id #uuid "65338b33-5b54-5452-be8c-4b4d0c1eedfd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{y} & \\frac{1}{{y}^{2}} \\\\ {e}^{x-y} & -{e}^{x-y}\\end{bmatrix}" :db/id #edb/ref 17592186279510}] :answer-field/correct {:answer/id #uuid "45213a92-906d-5fea-858d-97190bb5ed5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{y} & -\\frac{x}{{y}^{2}} \\\\ {e}^{x-y} & -{e}^{x-y}\\end{bmatrix}" :db/id #edb/ref 17592186279207} :answer-field/id #uuid "7cc55c89-7ca3-5217-803e-3b345111a52c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281061}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "754cc616-7c79-55a6-8b43-74dd54ff339a" :question/math-academy-id "q-163099" :question/problem "For the transformation $f:{R}^{2}\\to {R}^{2},$ defined as\n\n$$\nf(x)=\\begin{bmatrix}\\frac{x}{y} \\\\ {e}^{x-y}\\end{bmatrix},\\,x=\\begin{bmatrix}x \\\\ y\\end{bmatrix},\n$$\n\ncalculate ${f}^{′}(x).$" :question/worked-solution "Suppose a transformation $f:{R}^{n}\\to {R}^{m}$ is defined by \n\n$$\nf:\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{bmatrix}⟶\\begin{bmatrix}{f}_{1}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ {f}_{2}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ ⋮ \\\\ {f}_{m}({x}_{1},{x}_{2},…,{x}_{n})\\end{bmatrix},\n$$\n\n \n\nwhere ${f}_{1},{f}_{2},…,{f}_{m}$ are scalar functions with $n$ variables. If $f$ is differentiable at $x,$ then the total derivative of $f$ at $x,$ denoted ${f}^{′}(x),$ is given by the $m\\times n$ matrix\n\n$$\n{f}^{′}(x)=\\begin{bmatrix}\\frac{∂{f}_{1}}{∂{x}_{1}} & \\frac{∂{f}_{1}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{1}}{∂{x}_{n}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & \\frac{∂{f}_{2}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{2}}{∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{∂{f}_{m}}{∂{x}_{1}} & \\frac{∂{f}_{m}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{m}}{∂{x}_{n}}\\end{bmatrix}.\n$$\n\nIn our case, we have the following:\n\n$$\n{f}^{′}(x)=\\begin{bmatrix}\\frac{∂{f}_{1}}{∂x} & \\frac{∂{f}_{1}}{∂y} \\\\ \\frac{∂{f}_{2}}{∂x} & \\frac{∂{f}_{2}}{∂y}\\end{bmatrix}\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & =\\frac{∂}{∂x}(\\frac{x}{y})=\\frac{1}{y},\\, & \\frac{∂{f}_{1}}{∂y} & =\\frac{∂}{∂y}(\\frac{x}{y})=-\\frac{x}{{y}^{2}} \\\\ \\frac{∂{f}_{2}}{∂x} & =\\frac{∂}{∂x}({e}^{x-y})={e}^{x-y},\\, & \\frac{∂{f}_{2}}{∂y} & =\\frac{∂}{∂y}({e}^{x-y})=-{e}^{x-y}\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n{f}^{′}(x)=\\begin{bmatrix}\\frac{1}{y} & -\\frac{x}{{y}^{2}} \\\\ {e}^{x-y} & -{e}^{x-y}\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186510464 :knowledge-point/_questions [{:db/id #edb/ref 17592186198412 :knowledge-point/id #uuid "6a818e04-786a-56b6-90cf-dcb573ccfa64" :knowledge-point/title "Finding the Derivative of a Vector Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e6d2172-6c9d-5544-87e6-2d6bfa9d6ce3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1,\\,$ $y{e}^{x+y},$ and $1$" :db/id #edb/ref 17592186509852} {:answer/id #uuid "5ab7b9b5-4008-5e6e-8865-0f92a0579f0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-1,\\,$ ${e}^{x+y},$ and $1$" :db/id #edb/ref 17592186509876} {:answer/id #uuid "a2e0fd02-52d6-5108-b58e-81e5f92525e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1,\\,$ ${e}^{x+y},$ and $1$" :db/id #edb/ref 17592186510027} {:answer/id #uuid "a937722a-014a-5b62-9578-a0d76b204dbd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1,\\,$ $y{e}^{x+y},$ and $2y$" :db/id #edb/ref 17592186510051} {:answer/id #uuid "ac0d31a6-90de-5ed5-abf3-0ec64309b574" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-1,\\,$ ${e}^{x+y},$ and $2y$" :db/id #edb/ref 17592186510055}] :answer-field/correct {:answer/id #uuid "a2e0fd02-52d6-5108-b58e-81e5f92525e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1,\\,$ ${e}^{x+y},$ and $1$" :db/id #edb/ref 17592186510027} :answer-field/id #uuid "0742372b-5487-5dd8-bf84-219c793b3af2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186510243}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e4c8c472-15d1-572f-9440-48aac06cd29f" :question/math-academy-id "q-163107" :question/problem "For the transformation $f:{R}^{2}\\to {R}^{3},$ defined as\n\n$$\nf(x)=[\\begin{aligned}y-x \\\\ {e}^{x+y} \\\\ {x}^{2}+y\\end{aligned}],\\,x=[\\begin{aligned}x \\\\ y\\end{aligned}],\n$$\n\nthe total derivative ${f}^{′}$ is given by \n\n$$\n{f}^{′}(x)=[\\begin{aligned}-1 & \\bbox[3pt,border:1pt solid black]{\\phantom{AA}} \\\\ \\bbox[3pt,border:1pt solid black]{\\phantom{AA}} & {e}^{x+y} \\\\ 2x & \\bbox[3pt,border:1pt solid black]{\\phantom{AA}}\\end{aligned}].\n$$\n\nFrom top to bottom, what are the missing entries?" :question/worked-solution "Suppose a transformation $f:{R}^{n}\\to {R}^{m}$ is defined by \n\n$$\nf:[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]⟶[\\begin{aligned}{f}_{1}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ {f}_{2}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ ⋮ \\\\ {f}_{m}({x}_{1},{x}_{2},…,{x}_{n})\\end{aligned}],\n$$\n\n \n\nwhere ${f}_{1},{f}_{2},…,{f}_{m}$ are scalar functions with $n$ variables. If $f$ is differentiable at $x,$ then the total derivative of $f$ at $x,$ denoted ${f}^{′}(x),$ is given by the $m\\times n$ matrix\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{∂{f}_{1}}{∂{x}_{1}} & \\frac{∂{f}_{1}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{1}}{∂{x}_{n}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & \\frac{∂{f}_{2}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{2}}{∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{∂{f}_{m}}{∂{x}_{1}} & \\frac{∂{f}_{m}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{m}}{∂{x}_{n}}\\end{aligned}].\n$$\n\nIn our case, we have the following:\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & \\frac{∂{f}_{1}}{∂y} \\\\ \\frac{∂{f}_{2}}{∂x} & \\frac{∂{f}_{2}}{∂y} \\\\ \\frac{∂{f}_{3}}{∂x} & \\frac{∂{f}_{3}}{∂y}\\end{aligned}]\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & =\\frac{∂}{∂x}(y-x)=-1,\\, & \\frac{∂{f}_{1}}{∂y} & =\\frac{∂}{∂y}(y-x)=1, \\\\ \\frac{∂{f}_{2}}{∂x} & =\\frac{∂}{∂x}({e}^{x+y})={e}^{x+y},\\, & \\frac{∂{f}_{2}}{∂y} & =\\frac{∂}{∂y}({e}^{x+y})={e}^{x+y}, \\\\ \\frac{∂{f}_{3}}{∂x} & =\\frac{∂}{∂x}({x}^{2}+y)=2x,\\, & \\frac{∂{f}_{3}}{∂y} & =\\frac{∂}{∂y}({x}^{2}+y)=1\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n{f}^{′}(x)=[\\begin{aligned}-1 & 1 \\\\ {e}^{x+y} & {e}^{x+y} \\\\ 2x & 1\\end{aligned}].\n$$\n\nThus, the missing entries are $1,\\,$ ${e}^{x+y},$ and $1.$"}] [{:db/id #edb/ref 17592186389402 :knowledge-point/_questions [{:db/id #edb/ref 17592186198412 :knowledge-point/id #uuid "6a818e04-786a-56b6-90cf-dcb573ccfa64" :knowledge-point/title "Finding the Derivative of a Vector Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "df3378a4-f098-5dd2-8ca5-d33c2875b948" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{y} & \\frac{y}{{x}^{2}} \\\\ \\frac{1}{y} & \\frac{1}{y}\\end{bmatrix}" :db/id #edb/ref 17592186389404} {:answer/id #uuid "ba36a6bb-461b-576b-a8b0-07e2ea3c3d49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{y} & \\frac{1}{x} \\\\ \\frac{y}{{x}^{2}} & \\frac{1}{y}\\end{bmatrix}" :db/id #edb/ref 17592186389405} {:answer/id #uuid "a27b4618-4b71-59b7-bacf-d0230094bfab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{x} & \\frac{1}{y} \\\\ \\frac{y}{{x}^{2}} & -\\frac{1}{{x}^{2}}\\end{bmatrix}" :db/id #edb/ref 17592186389406} {:answer/id #uuid "d29cf603-32b4-509c-97ca-bbaca8f5bc45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{x} & \\frac{y}{{x}^{2}} \\\\ \\frac{1}{y} & \\frac{1}{x}\\end{bmatrix}" :db/id #edb/ref 17592186389407} {:answer/id #uuid "aa56a467-d2f5-5753-b23e-6ee51008dcc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{x} & \\frac{1}{y} \\\\ -\\frac{y}{{x}^{2}} & \\frac{1}{x}\\end{bmatrix}" :db/id #edb/ref 17592186389408}] :answer-field/correct {:answer/id #uuid "aa56a467-d2f5-5753-b23e-6ee51008dcc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{x} & \\frac{1}{y} \\\\ -\\frac{y}{{x}^{2}} & \\frac{1}{x}\\end{bmatrix}" :db/id #edb/ref 17592186389408} :answer-field/id #uuid "090b72a8-f15b-5bfd-adae-9afc07d8a51e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389403}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6490b2e2-ebe2-52cf-9741-542b7f4cc483" :question/math-academy-id "q-163110" :question/problem "For the transformation $f:{R}^{2}\\to {R}^{2},$ defined as\n\n$$\nf(x)=\\begin{bmatrix}\\operatorname{ln}⁡(xy) \\\\ \\frac{y}{x}\\end{bmatrix},\\,x=\\begin{bmatrix}x \\\\ y\\end{bmatrix},\n$$\n\ncalculate ${f}^{′}(x).$" :question/worked-solution "Suppose a transformation $f:{R}^{n}\\to {R}^{m}$ is defined by \n\n$$\nf:\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{bmatrix}⟶\\begin{bmatrix}{f}_{1}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ {f}_{2}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ ⋮ \\\\ {f}_{m}({x}_{1},{x}_{2},…,{x}_{n})\\end{bmatrix},\n$$\n\n \n\nwhere ${f}_{1},{f}_{2},…,{f}_{m}$ are scalar functions with $n$ variables. If $f$ is differentiable at $x,$ then the total derivative of $f$ at $x,$ denoted ${f}^{′}(x),$ is given by the $m\\times n$ matrix\n\n$$\n{f}^{′}(x)=\\begin{bmatrix}\\frac{∂{f}_{1}}{∂{x}_{1}} & \\frac{∂{f}_{1}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{1}}{∂{x}_{n}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & \\frac{∂{f}_{2}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{2}}{∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{∂{f}_{m}}{∂{x}_{1}} & \\frac{∂{f}_{m}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{m}}{∂{x}_{n}}\\end{bmatrix}.\n$$\n\nIn our case, we have the following:\n\n$$\n{f}^{′}(x)=\\begin{bmatrix}\\frac{∂{f}_{1}}{∂x} & \\frac{∂{f}_{1}}{∂y} \\\\ \\frac{∂{f}_{2}}{∂x} & \\frac{∂{f}_{2}}{∂y}\\end{bmatrix}\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & =\\frac{∂}{∂x}(\\operatorname{ln}⁡(xy))=\\frac{1}{x},\\, & \\frac{∂{f}_{1}}{∂y} & =\\frac{∂}{∂y}(\\operatorname{ln}⁡(xy))=\\frac{1}{y} \\\\ \\frac{∂{f}_{2}}{∂x} & =\\frac{∂}{∂x}(\\frac{y}{x})=-\\frac{y}{{x}^{2}},\\, & \\frac{∂{f}_{2}}{∂y} & =\\frac{∂}{∂y}(\\frac{y}{x})=\\frac{1}{x}\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n{f}^{′}(x)=\\begin{bmatrix}\\frac{1}{x} & \\frac{1}{y} \\\\ -\\frac{y}{{x}^{2}} & \\frac{1}{x}\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186510445 :knowledge-point/_questions [{:db/id #edb/ref 17592186198414 :knowledge-point/id #uuid "9f09fc28-bdce-554f-98f5-019d34542a13" :knowledge-point/title "Finding an Affine Approximation of a Vector Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04006744-1bae-5bb4-accb-e390d3f45ea7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186509703} {:answer/id #uuid "0ec31ce9-c00a-5bd1-8daf-af84138f2b38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186509717} {:answer/id #uuid "2c6b6852-32ef-51ce-9d42-6fe9f0a29caf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186509779} {:answer/id #uuid "be150c75-3596-5565-b705-b3e774648191" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186510089} {:answer/id #uuid "d7c6cb25-2f85-50fe-b3a9-1118046f2bf2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186510145}] :answer-field/correct {:answer/id #uuid "d7c6cb25-2f85-50fe-b3a9-1118046f2bf2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186510145} :answer-field/id #uuid "7ae93f63-1fd3-519e-8190-4b93e47d0816" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186510302}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "bc54e1e5-dbca-5fc5-bf13-79bd1c80e680" :question/math-academy-id "q-163115" :question/problem "Consider the transformation $f:{R}^{2}\\to {R}^{2},$ defined as\n\n$$\nf(x)=[\\begin{aligned}\\operatorname{ln}⁡(2{x}_{1}+{x}_{2}) \\\\ 2{x}_{1}+5{x}_{2}\\end{aligned}],\\,x=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}].\n$$\n\nIf the linear approximation of $f$ at $a=[\\begin{aligned}2 \\\\ -3\\end{aligned}]$ is given by\n\n$$\nf(x)≈[\\begin{aligned}∗ \\\\ -11\\end{aligned}]+[\\begin{aligned}∗ & 1 \\\\ 2 & ∗\\end{aligned}](x-[\\begin{aligned}2 \\\\ -3\\end{aligned}]),\n$$\n\nwhat is the sum of the missing values?" :question/worked-solution "Suppose a transformation $f:{R}^{n}\\to {R}^{m}$ is defined by \n\n$$\nf:[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]⟶[\\begin{aligned}{f}_{1}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ {f}_{2}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ ⋮ \\\\ {f}_{m}({x}_{1},{x}_{2},…,{x}_{n})\\end{aligned}],\n$$\n\n \n\nwhere ${f}_{1},{f}_{2},…,{f}_{m}$ are scalar functions with $n$ variables. If $f$ is differentiable at $x,$ then the total derivative of $f$ at $x,$ denoted ${f}^{′}(x),$ is given by the $m\\times n$ matrix\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{∂{f}_{1}}{∂{x}_{1}} & \\frac{∂{f}_{1}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{1}}{∂{x}_{n}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & \\frac{∂{f}_{2}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{2}}{∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{∂{f}_{m}}{∂{x}_{1}} & \\frac{∂{f}_{m}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{m}}{∂{x}_{n}}\\end{aligned}].\n$$\n\nIn our case, we have the following:\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{∂{f}_{1}}{∂{x}_{1}} & \\frac{∂{f}_{1}}{∂{x}_{2}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & \\frac{∂{f}_{2}}{∂{x}_{2}}\\end{aligned}]\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂{f}_{1}}{∂{x}_{1}} & =\\frac{∂}{∂{x}_{1}}\\operatorname{ln}⁡(2{x}_{1}+{x}_{2})=\\frac{2}{2{x}_{1}+{x}_{2}},\\, & \\frac{∂{f}_{1}}{∂{x}_{2}} & =\\frac{∂}{∂{x}_{2}}\\operatorname{ln}⁡(2{x}_{1}+{x}_{2})=\\frac{1}{2{x}_{1}+{x}_{2}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & =\\frac{∂}{∂{x}_{1}}(2{x}_{1}+5{x}_{2})=2,\\, & \\frac{∂{f}_{2}}{∂{x}_{2}} & =\\frac{∂}{∂{x}_{2}}(2{x}_{1}+5{x}_{2})=5\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{2}{2{x}_{1}+{x}_{2}} & \\frac{1}{2{x}_{1}+{x}_{2}} \\\\ 2 & 5\\end{aligned}].\n$$\n\nEvaluating $f$ and its derivative at $x=a=[\\begin{aligned}2 \\\\ -3\\end{aligned}],$ we have\n\n$$\nf(a)=[\\begin{aligned}0 \\\\ -11\\end{aligned}],\\,{f}^{′}(a)=[\\begin{aligned}2 & 1 \\\\ 2 & 5\\end{aligned}].\n$$\n\nThe linear approximation of $f$ at $x=a$ is given by\n\n$$\nf(x)≈f(a)+{f}^{′}(a)(x-a).\n$$\n\nSubstituting $f(a),$ ${f}^{′}(a),$ and $a$ in the equation above, we obtain\n\n$$\nf(x)≈[\\begin{aligned}0 \\\\ -11\\end{aligned}]+[\\begin{aligned}2 & 1 \\\\ 2 & 5\\end{aligned}](x-[\\begin{aligned}2 \\\\ -3\\end{aligned}]).\n$$\n\nTherefore, the sum of the missing values is\n\n$$\n0+2+5=7.\n$$"}] [{:db/id #edb/ref 17592186510466 :knowledge-point/_questions [{:db/id #edb/ref 17592186198414 :knowledge-point/id #uuid "9f09fc28-bdce-554f-98f5-019d34542a13" :knowledge-point/title "Finding an Affine Approximation of a Vector Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7824eaf9-cd23-55b4-9fd6-76d9b52cc30d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡6+3\\operatorname{cos}⁡6" :db/id #edb/ref 17592186509942} {:answer/id #uuid "ba23c5ce-b11d-501d-b14c-4c4d08d14c26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡5+2\\operatorname{cos}⁡5" :db/id #edb/ref 17592186510084} {:answer/id #uuid "c1b5a290-a6c3-5e27-ae81-c0fb5e23fb17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186510095} {:answer/id #uuid "f3e53c85-f2b8-58f8-8b33-f1eca57834dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡4+5\\operatorname{cos}⁡4" :db/id #edb/ref 17592186510208} {:answer/id #uuid "fea47a30-e99a-5e73-998f-db22092d213e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186510235}] :answer-field/correct {:answer/id #uuid "7824eaf9-cd23-55b4-9fd6-76d9b52cc30d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡6+3\\operatorname{cos}⁡6" :db/id #edb/ref 17592186509942} :answer-field/id #uuid "c2600867-21b3-5594-bb4f-ca47a76745c8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186510337}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e574592a-62af-5f54-90e2-87d7393db0a8" :question/math-academy-id "q-163117" :question/problem "Consider the transformation $f:{R}^{2}\\to {R}^{2},$ defined as\n\n$$\nf(x)=[\\begin{aligned}{x}_{2}{e}^{{x}_{1}} \\\\ \\operatorname{sin}⁡(3{x}_{2})\\end{aligned}],\\,x=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}].\n$$\n\nIf the linear approximation of $f$ at $a=[\\begin{aligned}0 \\\\ 2\\end{aligned}]$ is given by\n\n$$\nf(x)≈[\\begin{aligned}2 \\\\ ∗\\end{aligned}]+[\\begin{aligned}2 & 1 \\\\ ∗ & ∗\\end{aligned}](x-[\\begin{aligned}0 \\\\ 2\\end{aligned}]),\n$$\n\nwhat is the sum of the missing values?" :question/worked-solution "Suppose a transformation $f:{R}^{n}\\to {R}^{m}$ is defined by \n\n$$\nf:[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]⟶[\\begin{aligned}{f}_{1}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ {f}_{2}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ ⋮ \\\\ {f}_{m}({x}_{1},{x}_{2},…,{x}_{n})\\end{aligned}],\n$$\n\n \n\nwhere ${f}_{1},{f}_{2},…,{f}_{m}$ are scalar functions with $n$ variables. If $f$ is differentiable at $x,$ then the total derivative of $f$ at $x,$ denoted ${f}^{′}(x),$ is given by the $m\\times n$ matrix\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{∂{f}_{1}}{∂{x}_{1}} & \\frac{∂{f}_{1}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{1}}{∂{x}_{n}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & \\frac{∂{f}_{2}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{2}}{∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{∂{f}_{m}}{∂{x}_{1}} & \\frac{∂{f}_{m}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{m}}{∂{x}_{n}}\\end{aligned}].\n$$\n\nIn our case, we have the following:\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{∂{f}_{1}}{∂{x}_{1}} & \\frac{∂{f}_{1}}{∂{x}_{2}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & \\frac{∂{f}_{2}}{∂{x}_{2}}\\end{aligned}]\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂{f}_{1}}{∂{x}_{1}} & =\\frac{∂}{∂{x}_{1}}({x}_{2}{e}^{{x}_{1}})={x}_{2}{e}^{{x}_{1}},\\, & \\frac{∂{f}_{1}}{∂{x}_{2}} & =\\frac{∂}{∂{x}_{2}}({x}_{2}{e}^{{x}_{1}})={e}^{{x}_{1}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & =\\frac{∂}{∂{x}_{1}}\\operatorname{sin}⁡(3{x}_{2})=0,\\, & \\frac{∂{f}_{2}}{∂{x}_{2}} & =\\frac{∂}{∂{x}_{2}}\\operatorname{sin}⁡(3{x}_{2})=3\\operatorname{cos}⁡(3{x}_{2})\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n{f}^{′}(x)=[\\begin{aligned}{x}_{2}{e}^{{x}_{1}} & {e}^{{x}_{1}} \\\\ 0 & 3\\operatorname{cos}⁡(3{x}_{2})\\end{aligned}].\n$$\n\nEvaluating $f$ and its derivative at $x=a=[\\begin{aligned}0 \\\\ 2\\end{aligned}],$ we have\n\n$$\nf(a)=[\\begin{aligned}2 \\\\ \\operatorname{sin}⁡6\\end{aligned}],\\,{f}^{′}(a)=[\\begin{aligned}2 & 1 \\\\ 0 & 3\\operatorname{cos}⁡6\\end{aligned}].\n$$\n\nThe linear approximation of $f$ at $x=a$ is given by\n\n$$\nf(x)≈f(a)+{f}^{′}(a)(x-a).\n$$\n\nSubstituting $f(a),$ ${f}^{′}(a),$ and $a$ in the equation above, we obtain\n\n$$\nf(x)≈[\\begin{aligned}2 \\\\ \\operatorname{sin}⁡6\\end{aligned}]+[\\begin{aligned}2 & 1 \\\\ 0 & 3\\operatorname{cos}⁡6\\end{aligned}](x-[\\begin{aligned}0 \\\\ 2\\end{aligned}]).\n$$\n\nTherefore, the sum of the missing values is\n\n$$\n\\operatorname{sin}⁡6+0+3\\operatorname{cos}⁡6=\\operatorname{sin}⁡6+3\\operatorname{cos}⁡6.\n$$"}] [{:db/id #edb/ref 17592186442218 :knowledge-point/_questions [{:db/id #edb/ref 17592186198414 :knowledge-point/id #uuid "9f09fc28-bdce-554f-98f5-019d34542a13" :knowledge-point/title "Finding an Affine Approximation of a Vector Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18b3a6d3-2922-5952-9dd5-688afdd0e22e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186442212} {:answer/id #uuid "3b47b2e0-7b7d-5338-9d25-ced74e84a6e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186442213} {:answer/id #uuid "5f1bfc1c-98a1-5b2b-8c25-93072e2631fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2}+4" :db/id #edb/ref 17592186442214} {:answer/id #uuid "ec4d1f97-e95b-5ef1-8ea5-17d2a475dba0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2}" :db/id #edb/ref 17592186442215} {:answer/id #uuid "f115dc76-a7c4-5fcd-bfa9-03dec29e7b4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186442216}] :answer-field/correct {:answer/id #uuid "18b3a6d3-2922-5952-9dd5-688afdd0e22e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186442212} :answer-field/id #uuid "d6d03c68-c527-56d7-8eec-20b909744859" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186442217}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "afc538b7-6818-5bf5-a45c-82af4af91e85" :question/math-academy-id "q-163159" :question/problem "Consider the transformation $f:{R}^{2}\\to {R}^{2},$ defined as\n\n$$\nf(x)=\\begin{bmatrix}{e}^{{x}_{1}^{2}+{x}_{2}} \\\\ {e}^{{x}_{1}-{x}_{2}^{2}}\\end{bmatrix},\\,x=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}.\n$$\n\nIf the linear approximation of $f$ at  $a=\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}$ is given by\n\n$$\nf(x)≈\\begin{bmatrix}1 \\\\ ∗\\end{bmatrix}+\\begin{bmatrix}∗ & 1 \\\\ 1 & ∗\\end{bmatrix}(x-\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}),\n$$\n\nwhat is the sum of the missing values?" :question/worked-solution "Suppose a transformation $f:{R}^{n}\\to {R}^{m}$ is defined by \n\n$$\nf:\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{bmatrix}⟶\\begin{bmatrix}{f}_{1}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ {f}_{2}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ ⋮ \\\\ {f}_{m}({x}_{1},{x}_{2},…,{x}_{n})\\end{bmatrix},\n$$\n\n \n\nwhere ${f}_{1},{f}_{2},…,{f}_{m}$ are scalar functions with $n$ variables. If $f$ is differentiable at $x,$ then the total derivative of $f$ at $x,$ denoted ${f}^{′}(x),$ is given by the $m\\times n$ matrix\n\n$$\n{f}^{′}(x)=\\begin{bmatrix}\\frac{∂{f}_{1}}{∂{x}_{1}} & \\frac{∂{f}_{1}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{1}}{∂{x}_{n}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & \\frac{∂{f}_{2}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{2}}{∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{∂{f}_{m}}{∂{x}_{1}} & \\frac{∂{f}_{m}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{m}}{∂{x}_{n}}\\end{bmatrix}.\n$$\n\nIn our case, we have the following:\n\n$$\n{f}^{′}(x)=\\begin{bmatrix}\\frac{∂{f}_{1}}{∂{x}_{1}} & \\frac{∂{f}_{1}}{∂{x}_{2}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & \\frac{∂{f}_{2}}{∂{x}_{2}}\\end{bmatrix}\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂{f}_{1}}{∂{x}_{1}} & =\\frac{∂}{∂{x}_{1}}({e}^{{x}_{1}^{2}+{x}_{2}})=2{x}_{1}{e}^{{x}_{1}^{2}+{x}_{2}},\\, & \\frac{∂{f}_{1}}{∂{x}_{2}} & =\\frac{∂}{∂{x}_{2}}({e}^{{x}_{1}^{2}+{x}_{2}})={e}^{{x}_{1}^{2}+{x}_{2}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & =\\frac{∂}{∂{x}_{1}}({e}^{{x}_{1}-{x}_{2}^{2}})={e}^{{x}_{1}-{x}_{2}^{2}},\\, & \\frac{∂{f}_{2}}{∂{x}_{2}} & =\\frac{∂}{∂{x}_{2}}({e}^{{x}_{1}-{x}_{2}^{2}})=-2{x}_{2}{e}^{{x}_{1}-{x}_{2}^{2}}\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n{f}^{′}(x)=\\begin{bmatrix}2{x}_{1}{e}^{{x}_{1}^{2}+{x}_{2}} & {e}^{{x}_{1}^{2}+{x}_{2}} \\\\ {e}^{{x}_{1}-{x}_{2}^{2}} & -2{x}_{2}{e}^{{x}_{1}-{x}_{2}^{2}}\\end{bmatrix}.\n$$\n\nEvaluating $f$ and its derivative at $x=a=\\begin{bmatrix}1 \\\\ -1\\end{bmatrix},$ we have\n\n$$\nf(a)=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix},\\,{f}^{′}(a)=\\begin{bmatrix}2 & 1 \\\\ 1 & 2\\end{bmatrix}.\n$$\n\nThe linear approximation of $f$ at $x=a$ is given by\n\n$$\nf(x)≈f(a)+{f}^{′}(a)(x-a).\n$$\n\nSubstituting $f(a),$ ${f}^{′}(a),$ and $a$ in the equation above, we obtain\n\n$$\nf(x)≈\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}+\\begin{bmatrix}2 & 1 \\\\ 1 & 2\\end{bmatrix}(x-\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}).\n$$\n\nTherefore, the sum of the missing values is\n\n$$\n1+2+2=5.\n$$"}]}
