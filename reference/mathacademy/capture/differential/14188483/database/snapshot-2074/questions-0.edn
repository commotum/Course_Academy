n/requires-calculator true}] [{:db/id #edb/ref 17592186268970 :knowledge-point/_questions [{:db/id #edb/ref 17592186175936 :knowledge-point/id #uuid "a2ac0065-9315-547a-a9cf-c6a5abea1aed" :knowledge-point/title "Computing Covariance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2abb3e57-6c18-5cbe-9233-1f7dff0ba7f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186266518} {:answer/id #uuid "7a784d8b-0b8c-5ef0-9db2-d2593bb0dd92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186267223} {:answer/id #uuid "7b020242-cf34-58b4-a71b-25b91f10f584" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186267228} {:answer/id #uuid "c6932afe-b15f-59fc-993a-036295583695" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186267924} {:answer/id #uuid "e3ca87a7-bf7c-585a-bb13-bc033c473031" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186268154}] :answer-field/correct {:answer/id #uuid "2abb3e57-6c18-5cbe-9233-1f7dff0ba7f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186266518} :answer-field/id #uuid "1d6442bc-67d2-5f57-b056-a09655f8413f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268455}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0f16abcc-1df4-5043-b12f-f3b3089b65c2" :question/math-academy-id "q-134156" :question/problem "Consider the following data sets:\n\n$$\nx={6,\\,4,\\,6,\\,8},\\,y={3,\\,4,\\,5,\\,8}\n$$\n\nYou're given that $\\overset{―}{x}=6$ and $\\overset{―}{y}=5.$ Calculate $\\text{Cov}(x,y).$" :question/worked-solution "The (population) covariance of the data sets $x={{x}_{1},{x}_{2},…,{x}_{n}}$ and $y={{y}_{1},{y}_{2},…,{y}_{n}}$ is given by \n\n$$\n\\text{Cov}(x,y)=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}),\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ and $\\overset{―}{y}=\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i}$ are the means of the data sets.\n\nTherefore, the covariance of our data sets is\n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(6-6)(3-5)+(4-6)(4-5)+(6-6)(5-5)+(8-6)(8-5)] \\\\  & =\\frac{1}{4}[(0)(-2)+(-2)(-1)+(0)(0)+(2)(3)] \\\\  & =\\frac{1}{4}[0+2+0+6] \\\\  & =\\frac{1}{4}\\cdot 8 \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186268976 :knowledge-point/_questions [{:db/id #edb/ref 17592186175936 :knowledge-point/id #uuid "a2ac0065-9315-547a-a9cf-c6a5abea1aed" :knowledge-point/title "Computing Covariance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1734a15f-874d-52cb-8d30-537856adcf27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186266335} {:answer/id #uuid "309a7988-0056-5a91-9b26-9a7b3519e0b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8.5" :db/id #edb/ref 17592186266573} {:answer/id #uuid "3ec15ade-734f-5f08-ba36-35c627ef7aaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.5" :db/id #edb/ref 17592186266703} {:answer/id #uuid "705e7a42-43a7-5e4c-a8c2-9f9d96502073" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186267134} {:answer/id #uuid "e61a6207-fc30-52f4-95a9-3b512b98a5eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186268185}] :answer-field/correct {:answer/id #uuid "e61a6207-fc30-52f4-95a9-3b512b98a5eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186268185} :answer-field/id #uuid "c8753d47-2823-5959-a5f0-f5cdc3afcd3c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268766}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a837e578-9d21-592b-8de3-2aa17ce381f9" :question/math-academy-id "q-134165" :question/problem "Consider the following data sets:\n\n$$\nx=\\{1,\\,4,\\,7,\\,12\\},\\,y=\\{2,\\,4,\\,2,\\,8\\}\n$$\n\nYou're given that $\\overset{―}{x}=6$ and $\\overset{―}{y}=4.$ Calculate $\\text{Cov}(x,y).$" :question/worked-solution "The (population) covariance of the data sets $x=\\{{x}_{1},{x}_{2},…,{x}_{n}\\}$ and $y=\\{{y}_{1},{y}_{2},…,{y}_{n}\\}$ is given by \n\n$$\n\\text{Cov}(x,y)=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}),\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ and $\\overset{―}{y}=\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i}$ are the means of the data sets.\n\nTherefore, the covariance of our data sets is\n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(1-6)(2-4)+(4-6)(4-4)+(7-6)(2-4)+(12-6)(8-4)] \\\\  & =\\frac{1}{4}[(-5)(-2)+(-2)(0)+(1)(-2)+(6)(4)] \\\\  & =\\frac{1}{4}[10+0-2+24] \\\\  & =\\frac{1}{4}\\cdot 32 \\\\  & =8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186268987 :knowledge-point/_questions [{:db/id #edb/ref 17592186175937 :knowledge-point/id #uuid "cee807c1-dd86-5b0e-a595-5c5754c47e4c" :knowledge-point/title "Computing Covariance in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36e40c67-45a4-512e-a473-ebda00025d75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186266616} {:answer/id #uuid "399bc011-b7fb-50c1-b770-c9da8a8f742a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186266650} {:answer/id #uuid "4ab7bc67-c820-5fc1-b2ff-7ca2dbb175bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186266806} {:answer/id #uuid "6271ff61-8795-5996-a19a-b22624dcfc2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20.3" :db/id #edb/ref 17592186267010} {:answer/id #uuid "e0a8db04-4c29-5aab-a4e4-246529826ee7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25.75" :db/id #edb/ref 17592186268126}] :answer-field/correct {:answer/id #uuid "4ab7bc67-c820-5fc1-b2ff-7ca2dbb175bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186266806} :answer-field/id #uuid "f3263194-075f-5c09-bdb3-2c0d1914e17e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268833}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e60aa99a-1f45-5524-89ca-0cc07165db5c" :question/math-academy-id "q-134211" :question/problem "| **Time Watching TV per Week, \nin hours ($x$)** | $4$ | $8$ | $12$ | $16$ |\n| --- | --- | --- | --- | --- |\n| **Grades, in percents ($y$)** | $64$ | $78$ | $76$ | $82$ |\n\nThe table above shows the relationship between the amount of time four of Mike's classmates watch TV per week and their overall math scores. Compute the covariance of the data sets given that the means are $\\overset{―}{x}=10$ and $\\overset{―}{y}=75.$" :question/worked-solution "The (population) covariance of the data sets $x={{x}_{1},{x}_{2},…,{x}_{n}}$ and $y={{y}_{1},{y}_{2},…,{y}_{n}}$ is given by \n\n$$\n\\text{Cov}(x,y)=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}),\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ and $\\overset{―}{y}=\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i}$ are the means of the data sets.\n\nTherefore, the covariance of our data sets is\n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(4\\,-\\,10)(64\\,-\\,75)+(8\\,-\\,10)(78\\,-\\,75)+(12\\,-\\,10)(76\\,-\\,75)+(16\\,-\\,10)(82\\,-\\,75)] \\\\  & =\\frac{1}{4}[(-6)(-11)+(-2)(3)+(2)(1)+(6)(7)] \\\\  & =\\frac{1}{4}[66-6+2+42] \\\\  & =\\frac{1}{4}\\cdot 104 \\\\  & =26.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275207 :knowledge-point/_questions [{:db/id #edb/ref 17592186175937 :knowledge-point/id #uuid "cee807c1-dd86-5b0e-a595-5c5754c47e4c" :knowledge-point/title "Computing Covariance in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "71eb6389-7689-5c9a-8297-31ca7235e0c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186273365} {:answer/id #uuid "8c8a22fc-2cb4-50d7-b1cb-cbbb5405f8f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186273600} {:answer/id #uuid "979a3301-3284-5c50-9cf0-11bb57f89e08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186273700} {:answer/id #uuid "de6bddb3-b0cd-5329-8192-716656e98f11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186274345} {:answer/id #uuid "f842d563-0f57-5149-ba6a-41f64ea2acdf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.5" :db/id #edb/ref 17592186274564}] :answer-field/correct {:answer/id #uuid "71eb6389-7689-5c9a-8297-31ca7235e0c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186273365} :answer-field/id #uuid "a56c7314-1e3c-587a-ae5f-7840c37f76ba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274924}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "478c2f5a-fb6f-5ae6-b9eb-deeec3c02c64" :question/math-academy-id "q-149564" :question/problem "| **Number of Members ($x$)** | $3$ | $4$ | $4$ | $5$ |\n| --- | --- | --- | --- | --- |\n| **Number of Cars ($y$)** | $2$ | $2$ | $2$ | $6$ |\n\nIn a survey of $4$ families, the number of members in each family was recorded as well as the number of cars owned by that family. The data is shown in the table above.\nCompute the covariance of the data sets given that the means are $\\overset{―}{x}=4$ and $\\overset{―}{y}=3.$" :question/worked-solution "The (population) covariance of the data sets $x={{x}_{1},{x}_{2},…,{x}_{n}}$ and $y={{y}_{1},{y}_{2},…,{y}_{n}}$ is given by \n\n$$\n\\text{Cov}(x,y)=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}),\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ and $\\overset{―}{y}=\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i}$ are the means of the data sets.\n\nTherefore, the covariance of our data sets is\n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(3-4)(2-3)+(4-4)(2-3)+(4-4)(2-3)+(5-4)(6-3)] \\\\  & =\\frac{1}{4}[(-1)(-1)+(0)(-1)+(0)(-1)+(1)(3)] \\\\  & =\\frac{1}{4}[1+0+0+3] \\\\  & =\\frac{1}{4}\\cdot 4 \\\\  & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275208 :knowledge-point/_questions [{:db/id #edb/ref 17592186175937 :knowledge-point/id #uuid "cee807c1-dd86-5b0e-a595-5c5754c47e4c" :knowledge-point/title "Computing Covariance in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59ad31d0-4980-5939-8503-0e6b72b000ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186273153} {:answer/id #uuid "5daaab97-11d4-5c1d-a61d-8460e4871b0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186273191} {:answer/id #uuid "66094942-1fcc-5110-bd92-1786cbd6684d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.5" :db/id #edb/ref 17592186273262} {:answer/id #uuid "9d5dcf7b-d5ef-5791-9786-1f4b9daf3ecc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2.5" :db/id #edb/ref 17592186273747} {:answer/id #uuid "a6a6c132-1602-57cd-8d33-d39c78a799ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.5" :db/id #edb/ref 17592186273830}] :answer-field/correct {:answer/id #uuid "9d5dcf7b-d5ef-5791-9786-1f4b9daf3ecc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2.5" :db/id #edb/ref 17592186273747} :answer-field/id #uuid "909a9619-c6b0-5d02-8b81-b7f5f009f565" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274881}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d4368ff5-6ce7-5044-aed6-ebdab8009258" :question/math-academy-id "q-149570" :question/problem "| **Years in the 1st division ($x$)** | $44$ | $38$ | $32$ | $30$ |\n| --- | --- | --- | --- | --- |\n| **Number of Championships ($y$)** | $4$ | $3$ | $3$ | $6$ |\n\nThe table above shows the number of years four English soccer teams have been in the top division and the number of national championships they have won. \nCompute the covariance of the data sets." :question/worked-solution "The (population) covariance of the data sets $x=\\{{x}_{1},{x}_{2},…,{x}_{n}\\}$ and $y=\\{{y}_{1},{y}_{2},…,{y}_{n}\\}$ is given by \n\n$$\n\\text{Cov}(x,y)=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}),\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ and $\\overset{―}{y}=\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i}$ are the means of the data sets.\n\nFirst, we need to compute the means:\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i} \\\\  & =\\frac{1}{4}\\cdot (44+38+32+30) \\\\  & =\\frac{1}{4}\\cdot 144 \\\\  & =36 \\\\ \\overset{―}{y} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i} \\\\  & =\\frac{1}{4}\\cdot (4+3+3+6) \\\\  & =\\frac{1}{4}\\cdot 16 \\\\  & =4\\end{aligned}\n$$\n\nTherefore, the covariance of our data sets is \n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(44\\,-\\,36)(4\\,-\\,4)+(38\\,-\\,36)(3\\,-\\,4)+(32\\,-\\,36)(3\\,-\\,4)+(30\\,-\\,36)(6\\,-\\,4)] \\\\  & =\\frac{1}{4}[(8)(0)+(2)(-1)+(-4)(-1)+(-6)(2)] \\\\  & =\\frac{1}{4}[0+(-2)+4+(-12)] \\\\  & =\\frac{1}{4}\\cdot (-10) \\\\  & =-2.5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275214 :knowledge-point/_questions [{:db/id #edb/ref 17592186175936 :knowledge-point/id #uuid "a2ac0065-9315-547a-a9cf-c6a5abea1aed" :knowledge-point/title "Computing Covariance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f5e9ece-9a87-5054-8ed0-0e3968f7e786" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186273208} {:answer/id #uuid "7be7f640-87ec-538f-b7cb-1d5c9ca6d396" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186273451} {:answer/id #uuid "86a68a8c-c5d0-52d8-b452-f9cd176c9a5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186273541} {:answer/id #uuid "aa92d71f-4404-50a8-ac36-286273fb47d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186273860} {:answer/id #uuid "e345be0c-e480-5b52-9594-53531742421e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186274397}] :answer-field/correct {:answer/id #uuid "7be7f640-87ec-538f-b7cb-1d5c9ca6d396" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186273451} :answer-field/id #uuid "8961d711-317f-5070-bbb5-79330b1171d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274870}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f9c47870-1c3c-5cbd-a10d-e30d2edb18f8" :question/math-academy-id "q-149617" :question/problem "Consider the following data sets:\n\n$$\nx=\\{6,\\,4,\\,8,\\,6\\},\\,y=\\{4,\\,7,\\,11,\\,14\\}\n$$\n\nYou're given that $\\overset{―}{x}=6$ and $\\overset{―}{y}=9.$ Calculate $\\text{Cov}(x,y).$" :question/worked-solution "The (population) covariance of the data sets $x=\\{{x}_{1},{x}_{2},…,{x}_{n}\\}$ and $y=\\{{y}_{1},{y}_{2},…,{y}_{n}\\}$ is given by \n\n$$\n\\text{Cov}(x,y)=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}),\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ and $\\overset{―}{y}=\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i}$ are the means of the data sets.\n\nTherefore, the covariance of our data sets is\n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(6-6)(4-9)+(4-6)(7-9)+(8-6)(11-9)+(6-6)(14-9)] \\\\  & =\\frac{1}{4}[(0)(-5)+(-2)(-2)+(2)(2)+(0)(5)] \\\\  & =\\frac{1}{4}[0+4+4+0] \\\\  & =\\frac{1}{4}\\cdot 8 \\\\  & =2.\\end{aligned}\n$$"}]}
