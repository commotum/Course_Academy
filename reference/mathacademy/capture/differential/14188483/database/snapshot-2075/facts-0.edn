7] [17592186174270 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186174270 #edb/ref 1083 #uuid "caaf81a9-a943-54a0-870a-d117dd946a28" #edb/ref 17592186045417] [17592186174271 #edb/ref 1080 "8.5" #edb/ref 17592186045417] [17592186174271 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186174271 #edb/ref 1083 #uuid "f621b923-d136-5bb2-93dd-bd0a11dcee65" #edb/ref 17592186045417] [17592186174272 #edb/ref 1080 "13.5" #edb/ref 17592186045417] [17592186174272 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186174272 #edb/ref 1083 #uuid "00bb18e0-d159-5339-a1de-8278df118689" #edb/ref 17592186045417] [17592186174273 #edb/ref 1080 "13" #edb/ref 17592186045417] [17592186174273 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186174273 #edb/ref 1083 #uuid "66cff592-58f2-5a82-be01-0cf2cda0a8b2" #edb/ref 17592186045417] [17592186174274 #edb/ref 1075 #edb/ref 17592186174275 #edb/ref 17592186045417] [17592186174274 #edb/ref 1075 #edb/ref 17592186174276 #edb/ref 17592186045417] [17592186174274 #edb/ref 1075 #edb/ref 17592186174277 #edb/ref 17592186045417] [17592186174274 #edb/ref 1075 #edb/ref 17592186174278 #edb/ref 17592186045417] [17592186174274 #edb/ref 1075 #edb/ref 17592186174279 #edb/ref 17592186045417] [17592186174274 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186174274 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186174274 #edb/ref 1079 #uuid "3eebfd3c-e03e-52d4-a692-cce7f964772a" #edb/ref 17592186045417] [17592186174275 #edb/ref 1080 "14" #edb/ref 17592186045417] [17592186174275 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186174275 #edb/ref 1083 #uuid "82caa3c3-ae62-529c-86fb-7c7eaef94d57" #edb/ref 17592186045417] [17592186174276 #edb/ref 1080 "8" #edb/ref 17592186045417] [17592186174276 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186174276 #edb/ref 1083 #uuid "d3ef48db-2995-5e31-bcc4-6518144b0412" #edb/ref 17592186045417] [17592186174277 #edb/ref 1080 "10" #edb/ref 17592186045417] [17592186174277 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186174277 #edb/ref 1083 #uuid "0a4607e4-ba61-5415-bde6-5098b248e056" #edb/ref 17592186045417] [17592186174278 #edb/ref 1080 "12.5" #edb/ref 17592186045417] [17592186174278 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186174278 #edb/ref 1083 #uuid "126345d5-933e-5e3a-a5f3-2d73cf0cfee9" #edb/ref 17592186045417] [17592186174279 #edb/ref 1080 "17" #edb/ref 17592186045417] [17592186174279 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186174279 #edb/ref 1083 #uuid "25bc5ad0-2c30-5362-965a-c96f317dff27" #edb/ref 17592186045417] [17592186175746 #edb/ref 1069 "e-16134" #edb/ref 17592186045417] [17592186175746 #edb/ref 1071 "Calculate $\\textrm{Cov}(x,y)$ for the following data sets:\n\n$$\nx = \\big\\{ 6, \\: -2, \\: 7, \\: 1 \\big\\},\\qquad\ny = \\big\\{ 5, \\: -1, \\: 4, \\: 0 \\big\\}\n$$" #edb/ref 17592186045417] [17592186175746 #edb/ref 1072 #uuid "ef520918-4e4b-516b-acaa-57a14b5c1405" #edb/ref 17592186045417] [17592186175746 #edb/ref 1074 "The (population) covariance of the data sets $x=\\big\\{ x_1,x_2, \\ldots, x_n \\big\\}$ and $y=\\big\\{ y_1,y_2, \\ldots, y_n \\big\\}$ is given by \n\n$$\n\\textrm{Cov}(x,y) =  \\dfrac{1}{n} \\sum\\limits_{i=1}^n (x_i - \\overline{x})(y_i - \\overline{y}),\n$$\n\nwhere $\\overline{x} = \\dfrac{1}{n} \\displaystyle \\sum_{i=1}^n x_i$ and $\\overline{y} = \\dfrac{1}{n} \\displaystyle \\sum_{i=1}^n y_i$ are the means of the data sets.\n\nFirst, we need to compute the means:\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i} \\\\  & =\\frac{1}{4}\\cdot (6+(-2)+7+1) \\\\  & =\\frac{1}{4}\\cdot 12 \\\\  & =3 \\\\ \\overset{―}{y} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i} \\\\  & =\\frac{1}{4}\\cdot (5+(-1)+4+0) \\\\  & =\\frac{1}{4}\\cdot 8 \\\\  & =2\\end{aligned}\n$$\n\nTherefore, the covariance of our data sets is\n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(6-3)(5-2)+(-2-3)(-1-2)+(7-3)(4-2)+(1-3)(0-2)] \\\\  & =\\frac{1}{4}[(3)(3)+(-5)(-3)+(4)(2)+(-2)(-2)] \\\\  & =\\frac{1}{4}[9+15+8+4] \\\\  & =\\frac{1}{4}\\cdot 36 \\\\  & =9.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186175747 #edb/ref 1069 "e-16136" #edb/ref 17592186045417] [17592186175747 #edb/ref 1071 "| **Number of Hours of Sleep ($x$)** | $2$ | $4$ | $6$ | $8$ |\n| --- | --- | --- | --- | --- |\n| **Points Scored ($y$)** | $54$ | $68$ | $80$ | $90$ |\n\nA math teacher asked four of her students how many hours they had slept the night before an exam. The information she received is shown in the table above. Compute the covariance of the data sets given that the means are $\\overline{x}=5$ and $\\overline{y}=73.$" #edb/ref 17592186045417] [17592186175747 #edb/ref 1072 #uuid "33adfe2b-297e-5c52-8c4f-088d0c2b66e8" #edb/ref 17592186045417] [17592186175747 #edb/ref 1074 "The (population) covariance of the data sets $x=\\big\\{ x_1,x_2, \\ldots, x_n \\big\\}$ and $y=\\big\\{ y_1,y_2, \\ldots, y_n \\big\\}$ is given by \n\n$$\n\\textrm{Cov}(x,y) =  \\dfrac{1}{n} \\sum\\limits_{i=1}^n (x_i - \\overline{x})(y_i - \\overline{y}),\n$$\n\nwhere $\\overline{x} = \\dfrac{1}{n} \\displaystyle \\sum_{i=1}^n x_i$ and $\\overline{y} = \\dfrac{1}{n} \\displaystyle \\sum_{i=1}^n y_i$ are the means of the data sets.\n\nTherefore, the covariance of our data sets is\n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(2-5)(54-73)+(4-5)(68-73)+(6-5)(80-73)+(8-5)(90-73)] \\\\  & =\\frac{1}{4}[(-3)(-19)+(-1)(-5)+(1)(7)+(3)(17)] \\\\  & =\\frac{1}{4}[57+5+7+51] \\\\  & =\\frac{1}{4}\\cdot 120 \\\\  & =30.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186175936 #edb/ref 1037 #edb/ref 17592186050862 #edb/ref 17592186045417] [17592186175936 #edb/ref 1038 #edb/ref 17592186176333 #edb/ref 17592186045417] [17592186175936 #edb/ref 1038 #edb/ref 17592186176334 #edb/ref 17592186045417] [17592186175936 #edb/ref 1038 #edb/ref 17592186268969 #edb/ref 17592186045417] [17592186175936 #edb/ref 1038 #edb/ref 17592186268970 #edb/ref 17592186045417] [17592186175936 #edb/ref 1038 #edb/ref 17592186268972 #edb/ref 17592186045417] [17592186175936 #edb/ref 1038 #edb/ref 17592186268973 #edb/ref 17592186045417] [17592186175936 #edb/ref 1038 #edb/ref 17592186268974 #edb/ref 17592186045417] [17592186175936 #edb/ref 1038 #edb/ref 17592186268976 #edb/ref 17592186045417] [17592186175936 #edb/ref 1038 #edb/ref 17592186268978 #edb/ref 17592186045417] [17592186175936 #edb/ref 1038 #edb/ref 17592186268979 #edb/ref 17592186045417] [17592186175936 #edb/ref 1038 #edb/ref 17592186275213 #edb/ref 17592186045417] [17592186175936 #edb/ref 1038 #edb/ref 17592186275214 #edb/ref 17592186045417] [17592186175936 #edb/ref 1038 #edb/ref 17592186275215 #edb/ref 17592186045417] [17592186175936 #edb/ref 1039 "Computing Covariance" #edb/ref 17592186045417] [17592186175936 #edb/ref 1041 #edb/ref 17592186175746 #edb/ref 17592186045417] [17592186175936 #edb/ref 1042 #uuid "a2ac0065-9315-547a-a9cf-c6a5abea1aed" #edb/ref 17592186045417] [17592186175937 #edb/ref 1038 #edb/ref 17592186176335 #edb/ref 17592186045417] [17592186175937 #edb/ref 1038 #edb/ref 17592186176336 #edb/ref 17592186045417] [17592186175937 #edb/ref 1038 #edb/ref 17592186268981 #edb/ref 17592186045417] [17592186175937 #edb/ref 1038 #edb/ref 17592186268985 #edb/ref 17592186045417] [17592186175937 #edb/ref 1038 #edb/ref 17592186268986 #edb/ref 17592186045417] [17592186175937 #edb/ref 1038 #edb/ref 17592186268987 #edb/ref 17592186045417] [17592186175937 #edb/ref 1038 #edb/ref 17592186268988 #edb/ref 17592186045417] [17592186175937 #edb/ref 1038 #edb/ref 17592186268989 #edb/ref 17592186045417] [17592186175937 #edb/ref 1038 #edb/ref 17592186268991 #edb/ref 17592186045417] [17592