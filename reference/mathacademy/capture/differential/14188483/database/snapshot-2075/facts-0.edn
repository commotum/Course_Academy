f 17592186266806 #edb/ref 17592186045417] [17592186268833 #edb/ref 1075 #edb/ref 17592186267010 #edb/ref 17592186045417] [17592186268833 #edb/ref 1075 #edb/ref 17592186268126 #edb/ref 17592186045417] [17592186268833 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186268833 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186268833 #edb/ref 1078 #edb/ref 17592186266806 #edb/ref 17592186045417] [17592186268833 #edb/ref 1079 #uuid "f3263194-075f-5c09-bdb3-2c0d1914e17e" #edb/ref 17592186045417] [17592186268970 #edb/ref 1068 #edb/ref 17592186268455 #edb/ref 17592186045417] [17592186268970 #edb/ref 1069 "q-134156" #edb/ref 17592186045417] [17592186268970 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186268970 #edb/ref 1071 "Consider the following data sets:\n\n$$\nx={6,\\,4,\\,6,\\,8},\\,y={3,\\,4,\\,5,\\,8}\n$$\n\nYou're given that $\\overset{―}{x}=6$ and $\\overset{―}{y}=5.$ Calculate $\\text{Cov}(x,y).$" #edb/ref 17592186045417] [17592186268970 #edb/ref 1072 #uuid "0f16abcc-1df4-5043-b12f-f3b3089b65c2" #edb/ref 17592186045417] [17592186268970 #edb/ref 1074 "The (population) covariance of the data sets $x={{x}_{1},{x}_{2},…,{x}_{n}}$ and $y={{y}_{1},{y}_{2},…,{y}_{n}}$ is given by \n\n$$\n\\text{Cov}(x,y)=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}),\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ and $\\overset{―}{y}=\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i}$ are the means of the data sets.\n\nTherefore, the covariance of our data sets is\n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(6-6)(3-5)+(4-6)(4-5)+(6-6)(5-5)+(8-6)(8-5)] \\\\  & =\\frac{1}{4}[(0)(-2)+(-2)(-1)+(0)(0)+(2)(3)] \\\\  & =\\frac{1}{4}[0+2+0+6] \\\\  & =\\frac{1}{4}\\cdot 8 \\\\  & =2.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186268976 #edb/ref 1068 #edb/ref 17592186268766 #edb/ref 17592186045417] [17592186268976 #edb/ref 1069 "q-134165" #edb/ref 17592186045417] [17592186268976 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186268976 #edb/ref 1071 "Consider the following data sets:\n\n$$\nx=\\{1,\\,4,\\,7,\\,12\\},\\,y=\\{2,\\,4,\\,2,\\,8\\}\n$$\n\nYou're given that $\\overset{―}{x}=6$ and $\\overset{―}{y}=4.$ Calculate $\\text{Cov}(x,y).$" #edb/ref 17592186045417] [17592186268976 #edb/ref 1072 #uuid "a837e578-9d21-592b-8de3-2aa17ce381f9" #edb/ref 17592186045417] [17592186268976 #edb/ref 1074 "The (population) covariance of the data sets $x=\\{{x}_{1},{x}_{2},…,{x}_{n}\\}$ and $y=\\{{y}_{1},{y}_{2},…,{y}_{n}\\}$ is given by \n\n$$\n\\text{Cov}(x,y)=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}),\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ and $\\overset{―}{y}=\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i}$ are the means of the data sets.\n\nTherefore, the covariance of our data sets is\n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(1-6)(2-4)+(4-6)(4-4)+(7-6)(2-4)+(12-6)(8-4)] \\\\  & =\\frac{1}{4}[(-5)(-2)+(-2)(0)+(1)(-2)+(6)(4)] \\\\  & =\\frac{1}{4}[10+0-2+24] \\\\  & =\\frac{1}{4}\\cdot 32 \\\\  & =8.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186268987 #edb/ref 1068 #edb/ref 17592186268833 #edb/ref 17592186045417] [17592186268987 #edb/ref 1069 "q-134211" #edb/ref 17592186045417] [17592186268987 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186268987 #edb/ref 1071 "| **Time Watching TV per Week, \nin hours ($x$)** | $4$ | $8$ | $12$ | $16$ |\n| --- | --- | --- | --- | --- |\n| **Grades, in percents ($y$)** | $64$ | $78$ | $76$ | $82$ |\n\nThe table above shows the relationship between the amount of time four of Mike's classmates watch TV per week and their overall math scores. Compute the covariance of the data sets given that the means are $\\overset{―}{x}=10$ and $\\overset{―}{y}=75.$" #edb/ref 17592186045417] [17592186268987 #edb/ref 1072 #uuid "e60aa99a-1f45-5524-89ca-0cc07165db5c" #edb/ref 17592186045417] [17592186268987 #edb/ref 1074 "The (population) covariance of the data sets $x={{x}_{1},{x}_{2},…,{x}_{n}}$ and $y={{y}_{1},{y}_{2},…,{y}_{n}}$ is given by \n\n$$\n\\text{Cov}(x,y)=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}),\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ and $\\overset{―}{y}=\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i}$ are the means of the data sets.\n\nTherefore, the covariance of our data sets is\n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(4\\,-\\,10)(64\\,-\\,75)+(8\\,-\\,10)(78\\,-\\,75)+(12\\,-\\,10)(76\\,-\\,75)+(16\\,-\\,10)(82\\,-\\,75)] \\\\  & =\\frac{1}{4}[(-6)(-11)+(-2)(3)+(2)(1)+(6)(7)] \\\\  & =\\frac{1}{4}[66-6+2+42] \\\\  & =\\frac{1}{4}\\cdot 104 \\\\  & =26.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186273153 #edb/ref 1080 "3" #edb/ref 17592186045417] [17592186273153 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186273153 #edb/ref 1083 #uuid "59ad31d0-4980-5939-8503-0e6b72b000ce" #edb/ref 17592186045417] [17592186273191 #edb/ref 1080 "-3" #edb/ref 17592186045417] [17592186273191 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186273191 #edb/ref 1083 #uuid "5daaab97-11d4-5c1d-a61d-8460e4871b0e" #edb/ref 17592186045417] [17592186273208 #edb/ref 1080 "1" #edb/ref 17592186045417] [17592186273208 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186273208 #edb/ref 1083 #uuid "5f5e9ece-9a87-5054-8ed0-0e3968f7e786" #edb/ref 17592186045417] [17592186273262 #edb/ref 1080 "3.5" #edb/ref 17592186045417] [17592186273262 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186273262 #edb/ref 1083 #uuid "66094942-1fcc-5110-bd92-1786cbd6684d" #edb/