\" scriptlevel=\"0\"><mfrac><mn>1</mn><mrow><msup><mi>f</mi><mo data-mjx-alternate=\"1\">′</mo></msup><mo stretchy=\"false\">(</mo><msup><mi>f</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy=\"false\">(</mo><mn>10</mn><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">)</mo></mrow></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mrow><msup><mi>f</mi><mo data-mjx-alternate=\"1\">′</mo></msup><mo stretchy=\"false\">(</mo><mn>0</mn><mo stretchy=\"false\">)</mo></mrow></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mn>4</mn></mfrac></mstyle><mo>.</mo></mtd></mtr></mtable></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
