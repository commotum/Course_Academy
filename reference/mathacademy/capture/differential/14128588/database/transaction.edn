[{:db/id 17592186054698 :knowledge-point/questions ["question-6c923c04-595e-5b89-9e36-615f924682f7"] :db/ensure [:knowledge-point/validate]} {:db/id "question-6c923c04-595e-5b89-9e36-615f924682f7" :question/id #uuid "6c923c04-595e-5b89-9e36-615f924682f7" :question/math-academy-id "q-135398" :question/problem "Find the inverse of the following matrix:\n\n$$\nA=[\\begin{aligned}1 & 0 & 0 & 0 \\\\ 0 & 1 & 0 & 0 \\\\ 0 & \\frac{1}{4} & 1 & 0 \\\\ 0 & -8 & 0 & 1\\end{aligned}]\n$$" :question/worked-solution "Notice that we're given a Frobenius matrix:\n\n- all entries on the main diagonal are ones\n\n- the matrix has only one column (the $2$nd column) where some entries below the main diagonal are not zeros\n\n- all the other entries outside the main diagonal are zeros\n\nTo find the inverse of a Frobenius matrix, we simply take the non-zero entries outside the main diagonal with opposite signs. \n\nIn our case, we obtain\n\n$$\n\\begin{aligned}{A}^{-1}={[\\begin{aligned}1 & 0 & 0 & 0 \\\\ 0 & 1 & 0 & 0 \\\\ 0 & \\frac{1}{4} & 1 & 0 \\\\ 0 & -8 & 0 & 1\\end{aligned}]}^{-1}=[\\begin{aligned}1 & 0 & 0 & 0 \\\\ 0 & 1 & 0 & 0 \\\\ 0 & -\\frac{1}{4} & 1 & 0 \\\\ 0 & 8 & 0 & 1\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-61441954-c7fc-5ef0-9a6b-24fb2c47909b"] :db/ensure [:question/validate]} {:db/id "answer-field-61441954-c7fc-5ef0-9a6b-24fb2c47909b" :answer-field/id #uuid "61441954-c7fc-5ef0-9a6b-24fb2c47909b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-fa0af12f-c969-5d5b-9aea-d2eb372f1847" :answer-field/choices ["answer-8cec96a9-0200-560d-b96c-38c90ea667a8" "answer-8fae7340-6e28-5c68-b320-f02b1b9ec60a" "answer-d5e47ff6-28fb-5454-9b4c-76a088f298a8" "answer-fa0af12f-c969-5d5b-9aea-d2eb372f1847" "answer-c36b4bbc-e8a1-5d32-8dfe-7790ebbd7295"] :db/ensure [:answer-field/validate]} {:db/id "answer-8cec96a9-0200-560d-b96c-38c90ea667a8" :answer/i