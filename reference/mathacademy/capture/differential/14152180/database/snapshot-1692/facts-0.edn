2186045417] [17592186124602 #edb/ref 1038 #edb/ref 17592186348376 #edb/ref 17592186045417] [17592186124602 #edb/ref 1038 #edb/ref 17592186404086 #edb/ref 17592186045417] [17592186124602 #edb/ref 1038 #edb/ref 17592186404093 #edb/ref 17592186045417] [17592186124602 #edb/ref 1038 #edb/ref 17592186404100 #edb/ref 17592186045417] [17592186124602 #edb/ref 1039 "Diagonalizing a 2x2 Matrix Given Its Eigenvalues" #edb/ref 17592186045417] [17592186124602 #edb/ref 1041 #edb/ref 17592186124414 #edb/ref 17592186045417] [17592186124602 #edb/ref 1042 #uuid "5164c6cb-aef0-554b-b361-77245991c0ea" #edb/ref 17592186045417] [17592186124753 #edb/ref 1043 #edb/ref 17592186125538 #edb/ref 17592186045417] [17592186124753 #edb/ref 1043 #edb/ref 17592186125539 #edb/ref 17592186045417] [17592186124753 #edb/ref 1043 #edb/ref 17592186125540 #edb/ref 17592186045417] [17592186124753 #edb/ref 1043 #edb/ref 17592186125541 #edb/ref 17592186045417] [17592186124753 #edb/ref 1043 #edb/ref 17592186125542 #edb/ref 17592186045417] [17592186124753 #edb/ref 1043 #edb/ref 17592186125543 #edb/ref 17592186045417] [17592186124753 #edb/ref 1043 #edb/ref 17592186125544 #edb/ref 17592186045417] [17592186124753 #edb/ref 1043 #edb/ref 17592186125545 #edb/ref 17592186045417] [17592186124753 #edb/ref 1043 #edb/ref 17592186125662 #edb/ref 17592186045417] [17592186124753 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186124753 #edb/ref 1045 "Diagonalizing a 2x2 Matrix" #edb/ref 17592186045417] [17592186124753 #edb/ref 1046 #edb/ref 17592186125538 #edb/ref 17592186045417] [17592186124753 #edb/ref 1049 #edb/ref 17592186049113 #edb/ref 17592186045417] [17592186124753 #edb/ref 1050 1080.0 #edb/ref 17592186045417] [17592186124753 #edb/ref 1053 #uuid "c3fad3be-1ce2-5167-98d1-4498a125e7e9" #edb/ref 17592186045417] [17592186125019 #edb/ref 1068 #edb/ref 17592186122714 #edb/ref 17592186045417] [17592186125019 #edb/ref 1069 "q-36908" #edb/ref 17592186045417] [17592186125019 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186125019 #edb/ref 1071 "Consider the following matrices:\n\n$$\nA=[\\begin{aligned}-5 & -2 \\\\ 12 & 5\\end{aligned}],\\,D=[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}],\\,P=[\\begin{aligned}1 & ∗ \\\\ -3 & ∗\\end{aligned}]\n$$\n\nGiven that $A=PD{P}^{-1},$ find the second column of the matrix $P.$" #edb/ref 17592186045417] [17592186125019 #edb/ref 1072 #uuid "47e69096-fce9-5678-91d0-dfdd65324d6f" #edb/ref 17592186045417] [17592186125019 #edb/ref 1074 "From the diagonal matrix $D=[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}]$, we deduce that the eigenvalues of the matrix $A$ are ${\\lambda }_{1}=1$ and ${\\lambda }_{2}=-1.$\n\nSo, the second column of $P$ corresponds to the eigenvalue ${\\lambda }_{2}=-1.$ \n\nNow, we simply need to find an eigenvector that corresponds to ${\\lambda }_{2}=-1.$ Computing $A-(-1)I,$ we get\n\n$$\n\\begin{aligned}A-(-1)I & =[\\begin{aligned}-5 & -2 \\\\ 12 & 5\\end{aligned}]-(-1)[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-4 & -2 \\\\ 12 & 6\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M$ which we reduce to its row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}-4 & -2 & 0 \\\\ 12 & 6 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼[\\begin{aligned}-4 & -2 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we obtain ${x}_{1}=-\\frac{1}{2}{x}_{2}.$ Hence, the general solution is\n\n$$\n[\\begin{aligned}-\\frac{1}{2}{x}_{2} \\\\ {x}_{2}\\end{aligned}],\\,{x}_{2}\\in R.\n$$\n\nTherefore, setting ${x}_{2}=2,$ we get the eigenvector \n\n$$\n{v}_{2}=[\\begin{aligned}-1 \\\\ 2\\end{aligned}].\n$$\n\nFinally, $P=[\\begin{aligned}1 & -1 \\\\ -3 & 2\\end{aligned}].$" #edb/ref 17592186045417] [17592186125030 #edb/ref 1068 #edb/ref 17592186323596 #edb/ref 17592186045417] [17592186125030 #edb/ref 1069 "q-37084" #edb/ref 17592186045417] [17592186125030 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186125030 #edb/ref 1071 "Consider the following matrices:\n\n$$\nA=[\\begin{aligned}-1 & 2 \\\\ -6 & 6\\end{aligned}],\\,D=[\\begin{aligned}2 & 0 \\\\ 0 & 3\\end{aligned}],\\,P=[\\begin{aligned}2 & a \\\\ 3 & b\\end{aligned}]\n$$\n\nGiven that $D={P}^{-1}AP,$ find the value of $\\frac{b}{a}.$" #edb/ref 17592186045417] [17592186125030 #edb/ref 1072 #uuid "6f7410b2-d03a-51b8-bc6b-c6a21e9f2fab" #edb/ref 17592186045417] [17592186125030 #edb/ref 1074 "From the diagonal matrix $D=[\\begin{aligned}2 & 0 \\\\ 0 & 3\\end{aligned}]$, we deduce that the eigenvalues of $A$ are ${\\lambda }_{1}=2$ and ${\\lambda }_{2}=3.$\n\nSo, the second column of $P$ corresponds to the eigenvalue ${\\lambda }_{2}=3.$ \n\nNow, we simply need to find an eigenvector that corresponds to ${\\lambda }_{2}=3.$ Computing $A-3I,$ we get\n\n$$\n\\begin{aligned}A-3I & =[\\begin{aligned}-1 & 2 \\\\ -6 & 6\\end{aligned}]-(3)[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-4 & 2 \\\\ -6 & 3\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M$ which we reduce to its row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}-4 & 2 & 0 \\\\ -6 & 3 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+(-\\frac{3}{2}){R}_{1} \\\\  & ∼[\\begin{aligned}-4 & 2 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we obtain ${x}_{1}=\\frac{1}{2}{x}_{2}.$ Hence, the general solution is\n\n$$\n[\\begin{aligned}\\frac{1}{2}{x}_{2} \\\\ {x}_{2}\\end{aligned}],\\,{x}_{2}\\in R.\n$$\n\nTherefore, setting ${x}_{2}=2,$ we get the eigenvector \n\n$$\n{v}_{2}=[\\begin{aligned}a \\\\ b\\end{aligned}]=[\\begin{aligned}1 \\\\ 2\\end{aligned}].\n$$\n\nFinally, $\\frac{b}{a}=\\frac{2}{1}=2.$" #edb/ref 17592186045417] [17592186125031 #edb/ref 1068 #edb/ref 17592186323207 #edb/ref 17592186045417] [17592186125031 #edb/ref 1069 "q-37086" #edb/ref 17592186045417] [17592186125031 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186125031 #edb/ref 1071 "Given the matrix \n$A=[\\begin{aligned}-1 & -6 \\\\ 0 & 3\\end{aligned}]$, \nfind a diagonal matrix $D$ and an invertible matrix $P$ such that $D={P}^{-1}AP.$" #edb/ref 17592186045417] [17592186125031 #edb/ref 1072 #uuid "f2c822bf-c206-5550-8452-95d9e9a3c934" #edb/ref 17592186045417] [17592186125031 #edb/ref 1074 "We apply the diagonalization algorithm.\n\n**Step 1.**  We need to find the eigenvalues of the matrix. Since matrix $A$ is triangular, its eigenvalues are the entries on the main diagonal: \n\n$\\,$ ${\\lambda }_{1}=-1\\,$ and $\\,{\\lambda }_{2}=3$\n\n**Step 2.** Now, we need to find an eigenvector basis of $A.$\n\n- For ${\\lambda }_{1}=-1,$ we have\n\n$$\n\\begin{aligned}A-(-1)I & =[\\begin{aligned}-1 & -6 \\\\ 0 & 3\\end{aligned}]-(-1)[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}0 & -6 \\\\ 0 & 4\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M$ which we reduce to its row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}0 & -6 & 0 \\\\ 0 & 4 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+\\frac{2}{3}{R}_{1} \\\\  & ∼[\\begin{aligned}0 & -6 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $2$nd one). Thus, ${x}_{1}$ is a free variable. From the first equation, we obtain ${x}_{2}=0.$ Hence, the general solution is\n\n$$\n[\\begin{aligned}{x}_{1} \\\\ 0\\end{aligned}],\\,{x}_{1}\\in R.\n$$\n\nSetting ${x}_{1}=1,$ we get the eigenvector ${v}_{1}=[\\begin{aligned}1 \\\\ 0\\end{aligned}].$\n\n- For ${\\lambda }_{2}=3,$ we have\n\n$$\n\\begin{aligned}A-3I & =[\\begin{aligned}-1 & -6 \\\\ 0 & 3\\end{aligned}]-3[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-4 & -6 \\\\ 0 & 0\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have a homogeneous system of linear equations with the matrix as above. Note, the matrix is already in row echelon form. There is one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we obtain ${x}_{1}=-\\frac{3}{2}{x}_{2}.$ Hence, the general solution is\n\n$$\n[\\begin{aligned}-\\frac{3}{2}{x}_{2} \\\\ {x}_{2}\\end{aligned}],\\,{x}_{2}\\in R.\n$$\n\nSetting ${x}_{2}=2,$ we get the eigenvector ${v}_{2}=[\\begin{aligned}-3 \\\\ 2\\end{aligned}].$\n\n**Step 3.** We construct the diagonal matrix $D$ and the invertible matrix $P$ as follows:\n\n$$\nD=[\\begin{aligned}-1 & 0 \\\\ 0 & 3\\end{aligned}],\\,P=[\\begin{aligned}1 & -3 \\\\ 0 & 2\\end{aligned}]\n$$" #edb/ref 17592186045417] [17592186125086 #edb/ref 1068 #edb/ref 17592186323274 #edb/ref 17592186045417] [17592186125086 #edb/ref 1069 "q-37599" #edb/ref 17592186045417] [17592186125086 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186125086 #edb/ref 1071 "Determine if the matrix \n$A=[\\begin{aligned}10 & -4 \\\\ 24 & -10\\end{aligned}]$ \nis diagonalizable or not, and if it is diagonalizable, find a corresponding diagonal matrix $D.$" #edb/ref 17592186045417] [17592186125086 #edb/ref 1072 #uuid "474a90c6-ac56-574a-b515-a9ddafabb1ff" #edb/ref 17592186045417] [17592186125086 #edb/ref 1074 "First, we find the eigenvalues of the matrix $A$ by solving $det(A-\\lambda I)=0$:\n\n$$\n\\begin{aligned}|\\begin{aligned}10-\\lambda  & -4 \\\\ 24 & -10-\\lambda \\end{aligned}| & =0 \\\\ (10-\\lambda )(-10-\\lambda )-24\\cdot (-4) & =0 \\\\ {\\lambda }^{2}-4 & =0 \\\\ (\\lambda +2)(\\lambda -2) & =0\\end{aligned}\n$$\n\nSo, the eigenvalues are ${\\lambda }_{1}=2$ and ${\\lambda }_{2}=-2.$ Since we get two distinct eigenvalues, the matrix $A$ is diagonalizable.\n\nNow, we construct the diagonal matrix $D,$ as follows:\n\n$$\nD=[\\begin{aligned}2 & 0 \\\\ 0 & -2\\end{aligned}]\n$$" #edb/ref 17592186045417] [17592186125538 #edb/ref 1058 #edb/ref 17592186125544 #edb/ref 17592186045417] [17592186125538 #edb/ref 1061 31836 #edb/ref 17592186045417] [17592186125538 #edb/ref 1062 #uuid "0dec286b-a54f-500f-b0be-886c4e33f4ba" #edb/ref 17592186045417] [17592186125538 #edb/ref 1063 #edb/ref 17592186125839 #edb/ref 17592186045417] [17592186125539 #edb/ref 1058 #edb/ref 17592186125540 #edb/ref 17592186045417] [17592186125539 #edb/ref 1061 31837 #edb/ref 17592186045417] [17592186125539 #edb/ref 1062 #uuid "620e7d54-99b9-517c-83f8-d408a4768c65" #edb/ref 17592186045417] [17592186125539 #edb/ref 1063 #edb/ref 17592186125840 #edb/ref 17592186045417] [17592186125540 #edb/ref 1058 #edb/ref 17592186125541 #edb/ref 17592186045417] [17592186125540 #edb/ref 1061 31838 #edb/ref 17592186045417] [17592186125540 #edb/ref 1062 #uuid "62cef711-c61d-5145-9dcc-a1e378b6208e" #edb/ref 17592186045417] [17592186125540 #edb/ref 1063 #edb/ref 17592186124599 #edb/ref 17592186045417] [17592186125541 #edb/ref 1058 #edb/ref 17592186125542 #edb/ref 17592186045417] [17592186125541 #edb/ref 1061 31841 #edb/ref 17592186045417] [17592186125541 #edb/ref 1062 #uuid "0692f7d4-6f83-540e-bf5f-78b4908292bd" #edb/ref 17592186045417] [17592186125541 #edb/ref 1063 #edb/ref 17592186125841 #edb/ref 17592186045417] [17592186125542 #edb/ref 1058 #edb/ref 17592186125543 #edb/ref 17592186045417] [17592186125542 #edb/ref 1061 31842 #edb/ref 17592186045417] [17592186125542 #edb/ref 1062 #uuid "232d082f-7199-5eb9-b914-190d04e57153" #edb/ref 17592186045417] [17592186125542 #edb/ref 1063 #edb/ref 17592186124600 #edb/ref 17592186045417] [17592186125543 #edb/ref 1058 #edb/ref 17592186125545 #edb/ref 17592186045417] [17592186125543 #edb/ref 1061 31845 #edb/ref 17592186045417] [17592186125543 #edb/ref 1062 #uuid "09beebc7-7088-5b66-8674-578c829c0cb9" #edb/ref 17592186045417] [17592186125543 #edb/ref 1063 #edb/ref 17592186124601 #edb/ref 17592186045417] [17592186125544 #edb/ref 1058 #edb/ref 17592186125539 #edb/ref 17592186045417] [17592186125544 #edb/ref 1061 31848 #edb/ref 17592186045417] [17592186125544 #edb/ref 1062 #uuid "552c7c49-4812-5279-9818-9d8769362100" #edb/ref 17592186045417] [17592186125544 #edb/ref 1063 #edb/ref 17592186124602 #edb/ref 17592186045417] [17592186125545 #edb/ref 1058 #edb/ref 17592186125662 #edb/ref 17592186045417] [17592186125545 #edb/ref 1061 31854 #edb/ref 17592186045417] [17592186125545 #edb/ref 1062 #uuid "a11b9aec-3c2f-5a01-8b7c-600351ec33e2" #edb/ref 17592186045417] [17592186125545 #edb/ref 1063 #edb/ref 17592186125842 #edb/ref 17592186045417] [17592186125662 #edb/ref 1061 45769 #edb/ref 17592186045417] [17592186125662 #edb/ref 1062 #uuid "831d0bbd-aa17-5012-9d8b-073e0d2d67a6" #edb/ref 17592186045417] [17592186125662 #edb/ref 1063 #edb/ref 17592186125896 #edb/ref 17592186045417] [17592186125839 #edb/ref 1064 "A square matrix $A$ is called **diagonalizable** if there exists a diagonal matrix $D$ and an invertible matrix $P$ such that\n\n$$\nA = PDP^{-1}.\n$$\n\nSo, to **diagonalize** a matrix $A,$ we need to find a diagonal matrix $D$ and an invertible matrix $P$ that satisfy the equation above.\n\nFor example, let's diagonalize the matrix $A,$ given by\n\n![](images/9d/9dee6d9184932a79f36305b9fca2bbb5a2a18bc79b49ad97038f780a2f125e49.svg)\n\nTo diagonalize a $2\\times 2$ matrix, we follow a three-step **diagonalization algorithm.**\n\n**Step 1:** Find the eigenvalues of the matrix.\n\nWe solve the characteristic equation $\\vert A - \\lambda I \\vert = 0.$ For the given matrix, the eigenvalues are $\\color{red}\\lambda_1 =2$ and $\\color{blue}\\lambda_2 =3.$\n\n**Step 2:** Find a basis of $\\mathbb{R}^2$ consisting of eigenvectors of the matrix.\n\nFollowing the usual method for computing eigenvectors, we get \n\n![](images/ca/caa7716ce45eef38d92092d27827d30fd539fca27067c1e12f485a719b4f37ae.svg)\n\ncorresponding to the eigenvalues $\\color{red}\\lambda_1 =2$ and $\\color{blue}\\lambda_2 =3,$ respectively.\n\nNote that $\\left\\{ {\\color{red}\\mathbf{v_1}}, {\\color{blue}\\mathbf{v_2}}\\right\\}$ is a basis of $\\mathbb{R}^2$ since eigenvectors corresponding to distinct eigenvalues are linearly independent. This becomes important later.\n\n**Step 3: ** Construct the matrices $D$ and $P.$\n\nNow that we have our eigenvalues and corresponding eigenvectors, we can construct the diagonal matrix $D$ and invertible matrix $P.$\n\nThe matrix $D$ has the eigenvalues of the matrix as its entries on the diagonal. For now, we can write them in any order. So, we let\n\n![](images/3e/3e0df792d822773528cb07cceb39fcb98b7397ae70ab4f114e1450f1d91256d1.svg)\n\nThen, the columns of $P$ are the corresponding eigenvectors. We need to write each eigenvector in the *same* column as its respective eigenvalue in the matrix $D.$ So, we get\n\n![](images/86/869a05b6273dbbb1b53d9f842d8b2c612017517a0b007c1c5f494f55439a11b4.svg)\n\nFinally, we obtain\n\n$$\n\\begin{aligned}A=PD{P}^{-1} & =[\\begin{aligned}3 & -2 \\\\ -1 & 1\\end{aligned}][\\begin{aligned}2 & 0 \\\\ 0 & 3\\end{aligned}]{[\\begin{aligned}3 & -2 \\\\ -1 & 1\\end{aligned}]}^{-1}.\\end{aligned}\n$$\n\nWe can check our solution by computing the product on the right-hand side:\n\n$$\n\\begin{aligned}[\\begin{aligned}3 & -2 \\\\ -1 & 1\\end{aligned}][\\begin{aligned}2 & 0 \\\\ 0 & 3\\end{aligned}]{[\\begin{aligned}3 & -2 \\\\ -1 & 1\\end{aligned}]}^{-1} & =[\\begin{aligned}6 & -6 \\\\ -2 & 3\\end{aligned}][\\begin{aligned}1 & 2 \\\\ 1 & 3\\end{aligned}] \\\\  & =[\\begin{aligned}0 & -6 \\\\ 1 & 5\\end{aligned}] \\\\  & =A\\,✓\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186125839 #edb/ref 1065 5083 #edb/ref 17592186045417] [17592186125839 #edb/ref 1066 #uuid "1f56a4e0-1c9c-573c-95a9-92a93682f0a2" #edb/ref 17592186045417] [17592186125839 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186125840 #edb/ref 1064 "There is a theorem that states the following:\n\n*If $A$ is a $2 \\times 2$ matrix, then it is diagonalizable if and only if there exists a basis of $\\mathbb{R}^2$ that consists of eigenvectors of $A.$*\n\nWe can break this down into two possible cases:\n\n- If $A$ has two distinct eigenvalues, then it is indeed diagonalizable. This is because two distinct eigenvalues will give rise to two linearly independent eigenvectors (one for each eigenvalue). \n\nSo, for a matrix $A$ with eigenvalues $\\color{red}\\lambda_1$ and $\\color{blue}\\lambda_2$ and corresponding eigenvectors $\\color{red}\\mathbf{v_1}$ and $\\color{blue}\\mathbf{v_2},$ we have\n![](images/e1/e1468bc5ccdff43e33587c7b4b500bc527ab0ac7e74410ea53df1f803a19b520.svg)\n\n- If we get a double root $\\lambda$ of the characteristic equation, the matrix will be diagonalizable *only if* we can find exactly two linearly independent eigenvectors corresponding to $\\lambda,$ which may or may not be possible. Another way of saying this is that the corresponding eigenspace $V_\\lambda$ must be of dimension $2.$" #edb/ref 17592186045417] [17592186125840 #edb/ref 1065 5084 #edb/ref 17592186045417] [17592186125840 #edb/ref 1066 #uuid "fbab2132-0247-5376-a13b-df70908230d9" #edb/ref 17592186045417] [17592186125840 #edb/ref 1067 "Diagonalizable vs. Non-Diagonalizable Matrices" #edb/ref 17592186045417] [17592186125841 #edb/ref 1064 "If $A$ is a diagonalizable matrix, then we can write\n\n$$\nA=PDP^{-1}.\n$$\n\n \n\nWe can write this equation in an equivalent form, making $D$ the subject.\n\nFirst, we left-multiply both sides of the equation by $P^{-1}\\mathbin{:}$ \n\n$$\n\\begin{aligned}A & =PD{P}^{-1} \\\\ {P}^{-1}\\cdot A & ={P}^{-1}\\cdot PD{P}^{-1} \\\\ {P}^{-1}A & ={I}_{2}D{P}^{-1} \\\\ {P}^{-1}A & =D{P}^{-1}\\end{aligned}\n$$\n\nThen, we right-multiply both sides of the equation by $P{:}$\n\n$$\n\\begin{aligned}{P}^{-1}A\\cdot P & =D{P}^{-1}\\cdot P \\\\ {P}^{-1}AP & =D{I}_{2} \\\\ {P}^{-1}AP & =D\\end{aligned}\n$$\n\nTherefore, \n\n$$\nA=PDP^{-1}\n\\qquad\\Longleftrightarrow\\qquad\nD = P^{-1}A P.\n$$" #edb/ref 17592186045417] [17592186125841 #edb/ref 1065 5085 #edb/ref 17592186045417] [17592186125841 #edb/ref 1066 #uuid "6e0a81c7-a393-5e5d-b8c1-16d982404f1a" #edb/ref 17592186045417] [17592186125841 #edb/ref 1067 "The Connection Between a Matrix and Its Diagonal Form" #edb/ref 17592186045417] [17592186125842 #edb/ref 1064 "Given a matrix $A,$ the diagonalization \n\n![](images/76/76843143729d2bc62fc74dc6f03c24eb6a12dfc16a2609a8f2b36499cf39ce90.svg)\n\nis almost unique, but not quite.\n\nWhen we construct the diagonal matrix $D,$ we can put the eigenvalues in any order. So this matrix is unique up to permutations of the order of the eigenvalues. Note that by swapping the eigenvalues in $D,$ we then have to swap the corresponding eigenvectors (columns) in $P{:}$\n\n![](images/de/dec5fece3d89eaa022b4e951e63259b0f87213997397b1f8a91fb8fdabed0f74.svg)\n\nAlso, since any non-zero multiple of an eigenvector is an eigenvector as well, the eigenvector basis of $\\mathbb{R}^2$ can consist of these multiples instead. So the invertible matrix $P$ is unique up to multiples of its columns." #edb/ref 17592186045417] [17592186125842 #edb/ref 1065 5086 #edb/ref 17592186045417] [17592186125842 #edb/ref 1066 #uuid "eb055132-9c7d-55a5-a2c6-0bcb54877c1c" #edb/ref 17592186045417] [17592186125842 #edb/ref 1067 "Uniqueness of the Diagonalization" #edb/ref 17592186045417] [17592186125896 #edb/ref 1064 "Let ![](images/32/3207697e43e4f88223ad85c16964c3103a50c0c999a4ca14417695158d45526b.svg) be a diagonalizable ![](images/25/2521651122403a440e682fef383af333958f5b0d1334abe8b0771865d4daf100.svg) matrix. Then we can write\n![](images/d8/d8f75220bef8327a8dfc49a6ae22e79c6f1649aefdc8fb43065e0616975a8c5c.svg)\nwhere\n\n- ![](images/1a/1aaddf0d4be4d873ff6c0600b0b239e0565a05ca8daaff7ca92bd5c70bebcf03.svg) is an invertible matrix whose columns are eigenvectors ![](images/13/13cfebc7f22b3c6cfe7a66492040f9c7682e27e72b0a9adbc033e6a815c68fd9.svg) and ![](images/d0/d0c6e1eed1577bd5d71e38657d494bf53798b9c1f52c54e4a270e200df1cc351.svg) of ![](images/c2/c2c85081d1f89d74b8ebb2761496d211d7052193809b7864e7983437f5d0b80f.svg) and\n\n- ![](images/59/5914524b1d3db63c66998b75ca1d00a5dc4e294d2a8f10fe384d2b2ebf2af38e.svg) is a diagonal matrix whose diagonal entries are the corresponding eigenvalues ![](images/ff/ff5243fdeda78658220d1bcd4ac9b5963157b5e1f8b6a31231c68a6743248b19.svg) and ![](images/4a/4a2dd44cea07e06ccec03fff120c7fdbcebe19ad7a31d8abde1ab95c8a6b53a1.svg)\n\nTo understand this better, we need to distinguish between two coordinate systems.\n\nIn ![](images/fb/fb3130e489fdca80d1a077702861c20532fe613f9942d48fa1ec24055494a383.svg) the **standard basis** is\n![](images/d2/d29d3ee4ae42a8d4ee5304cb0d29c6c811838d7b893a3a831b1b1b8b3af12561.svg)\n\nSo, if a vector is written as\n![](images/bb/bbbc0379f1691a30dec4c34ec6171db1f116bec12a24891169957af68164f8d3.svg)\nthen ![](images/12/12adb8ba7ed45d89c9d9a80eb7c06616c41999e9fac57732bc24d2b55e1f8073.svg) The numbers ![](images/34/349015631ec44ef653936c85586d2c5ef56ba64392b3f92b4b92cbef3e731bc5.svg) and ![](images/a7/a77a353782459b753313d80235712695d65dc4a44d8d357aa41add6729f81d8f.svg) are the *standard coordinates* of ![](images/1f/1f3d1a60926323e963d7563529669e5cf8210771c8cbb0379f7a7d90e7c6aeec.svg)\n\nNow let\n![](images/58/58cdfb66e4c93d643fb97273610b3bbf67c8831516d4ccfc5b7790d55a169b28.svg)\n\nSince the columns of ![](images/1a/1aaddf0d4be4d873ff6c0600b0b239e0565a05ca8daaff7ca92bd5c70bebcf03.svg) are ![](images/13/13cfebc7f22b3c6cfe7a66492040f9c7682e27e72b0a9adbc033e6a815c68fd9.svg) and ![](images/d0/d0c6e1eed1577bd5d71e38657d494bf53798b9c1f52c54e4a270e200df1cc351.svg) written in standard coordinates, the matrix ![](images/1a/1aaddf0d4be4d873ff6c0600b0b239e0565a05ca8daaff7ca92bd5c70bebcf03.svg) converts coordinates from the basis ![](images/be/be2d796b77bebb31c0c06cef6af82bc9fb606a584a52cc5385cd32c4e143236c.svg) to the standard basis.\n\nSo, for any vector ![](images/b2/b2cb236f7a7f426f303b1391f76900b47f7d2fa1ad9c8110d8584182559017fd.svg)\n![](images/7e/7e5a6a4b9bee9550e68c75a3945ad25d41f1de6dd3b089ce89005428da169f9d.svg)\n\nHere, ![](images/4f/4fa2300af121b336bb0d7845b8e2b3e34be5a517a1bca45b4ec7b6514b2c544d.svg) denotes the standard-coordinate column of the vector, while ![](images/3f/3f7132e53e5a27bee4c84bdddbac07971ec44ce12539c0e0c23bf0006057e199.svg) denotes the coordinate column of the same vector in the eigenvector basis ![](images/8d/8d16f7d70344ddea7a4fe48105e5ea75b984f48fd77f6f6eb89d26ad91b65805.svg)\n\nAlso, in the basis ![](images/da/dab6f1afbeb705eef0eaf1a338c977e9cf6578010ebf95a6fccd1a4a4610dcd4.svg) the eigenvectors have especially simple coordinate columns:\n![](images/9f/9f5fec87a4253a3a1741c3380e2c6f9331928883ab2083dc02bf0e8efda6a98a.svg)\n\nThis is because\n![](images/30/306d2bb3211dac2883b1eb6abaed54259272a8bcc6a4e562ff5da6fc52dee520.svg)\n\nSo, in the basis ![](images/da/dab6f1afbeb705eef0eaf1a338c977e9cf6578010ebf95a6fccd1a4a4610dcd4.svg) the matrix ![](images/59/5914524b1d3db63c66998b75ca1d00a5dc4e294d2a8f10fe384d2b2ebf2af38e.svg) acts by scaling the first coordinate by ![](images/ff/ff5243fdeda78658220d1bcd4ac9b5963157b5e1f8b6a31231c68a6743248b19.svg) and the second coordinate by ![](images/4a/4a2dd44cea07e06ccec03fff120c7fdbcebe19ad7a31d8abde1ab95c8a6b53a1.svg)\n\nWe can summarize this process for any vector ![](images/4f/4fa2300af121b336bb0d7845b8e2b3e34be5a517a1bca45b4ec7b6514b2c544d.svg) as a sequence of three steps:\n\n- first, rewrite ![](images/4f/4fa2300af121b336bb0d7845b8e2b3e34be5a517a1bca45b4ec7b6514b2c544d.svg) in the eigenvector basis ![](images/da/dab6f1afbeb705eef0eaf1a338c977e9cf6578010ebf95a6fccd1a4a4610dcd4.svg)\n\n- then, apply the diagonal matrix ![](images/59/5914524b1d3db63c66998b75ca1d00a5dc4e294d2a8f10fe384d2b2ebf2af38e.svg) in that basis,\n\n- finally, convert the result back to standard coordinates.\n\nThe diagram below shows this sequence.\n\n![](images/14/1459b0643f99c186f9710118617f89f34a601526e7154213471404d2feb2aaeb.svg)" #edb/ref 17592186045417] [17592186125896 #edb/ref 1065 7958 #edb/ref 17592186045417] [17592186125896 #edb/ref 1066 #uuid "61524e43-2735-5e5a-904b-2c4973df94a9" #edb/ref 17592186045417] [17592186125896 #edb/ref 1067 "Diagonalization as a Change of Coordinates" #edb/ref 17592186045417] [17592186269373 #edb/ref 1080 "$a=-2,$ $b=3,$ and $c=-2$" #edb/ref 17592186045417] [17592186269373 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186269373 #edb/ref 1083 #uuid "0bd27f46-0fd2-5037-bc41-fd2cfcbdcc9e" #edb/ref 17592186045417] [17592186269627 #edb/ref 1080 "D=[\\begin{aligned}1 & 0 \\\\ 0 & 8\\end{aligned}]" #edb/ref 17592186045417] [17592186269627 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186269627 #edb/ref 1083 #uuid "283c9b8d-0bc6-5f6d-ab75-b05ebf7c10b0" #edb/ref 17592186045417] [17592186269782 #edb/ref 1080 "$a=-2,$ $b=-2,$ and $c=3$" #edb/ref 17592186045417] [17592186269782 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186269782 #edb/ref 1083 #uuid "3898e3de-9814-57b1-8159-d04b73eb79b1" #edb/ref 17592186045417] [17592186269876 #edb/ref 1080 "$D=[\\begin{aligned}-1 & 0 \\\\ 0 & 1\\end{aligned}]$\nand\n$P=[\\begin{aligned}1 & 4 \\\\ 1 & 3\\end{aligned}]$" #edb/ref 17592186045417] [17592186269876 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186269876 #edb/ref 1083 #uuid "434859e0-5b7a-524b-8296-6aa41ec7669b" #edb/ref 17592186045417] [17592186270434 #edb/ref 1080 "$A$ is not diagonalizable" #edb/ref 17592186045417] [17592186270434 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186270434 #edb/ref 1083 #uuid "863c0960-56c9-5f0d-8a3f-18dcf4f448c4" #edb/ref 17592186045417] [17592186270760 #edb/ref 1080 "$B$ is not diagonalizable" #edb/ref 17592186045417] [17592186270760 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186270760 #edb/ref 1083 #uuid "a69d7ffb-2348-5