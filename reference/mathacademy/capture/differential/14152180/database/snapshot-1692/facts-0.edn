17] [17592186271430 #edb/ref 1083 #uuid "f62d17fd-cfe8-5ddc-a914-06afc790f393" #edb/ref 17592186045417] [17592186271460 #edb/ref 1080 "D=[\\begin{aligned}-6 & 0 \\\\ 0 & 8\\end{aligned}]" #edb/ref 17592186045417] [17592186271460 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186271460 #edb/ref 1083 #uuid "fa9c478f-a619-5b23-b921-3dd46f2480b7" #edb/ref 17592186045417] [17592186271483 #edb/ref 1080 "$D=[\\begin{aligned}-2 & 0 \\\\ 0 & 2\\end{aligned}]$\nand\n$P=[\\begin{aligned}4 & 3 \\\\ 1 & 1\\end{aligned}]$" #edb/ref 17592186045417] [17592186271483 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186271483 #edb/ref 1083 #uuid "fd1e6265-66d6-501e-844e-d925219ae749" #edb/ref 17592186045417] [17592186271770 #edb/ref 1075 #edb/ref 17592186269373 #edb/ref 17592186045417] [17592186271770 #edb/ref 1075 #edb/ref 17592186269782 #edb/ref 17592186045417] [17592186271770 #edb/ref 1075 #edb/ref 17592186270992 #edb/ref 17592186045417] [17592186271770 #edb/ref 1075 #edb/ref 17592186271387 #edb/ref 17592186045417] [17592186271770 #edb/ref 1075 #edb/ref 17592186271430 #edb/ref 17592186045417] [17592186271770 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186271770 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186271770 #edb/ref 1078 #edb/ref 17592186269373 #edb/ref 17592186045417] [17592186271770 #edb/ref 1079 #uuid "91b1c54a-7ee2-538d-9d29-f08a44ec3c35" #edb/ref 17592186045417] [17592186271818 #edb/ref 1075 #edb/ref 17592186269876 #edb/ref 17592186045417] [17592186271818 #edb/ref 1075 #edb/ref 17592186270760 #edb/ref 17592186045417] [17592186271818 #edb/ref 1075 #edb/ref 17592186271145 #edb/ref 17592186045417] [17592186271818 #edb/ref 1075 #edb/ref 17592186271359 #edb/ref 17592186045417] [17592186271818 #edb/ref 1075 #edb/ref 17592186271483 #edb/ref 17592186045417] [17592186271818 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186271818 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186271818 #edb/ref 1078 #edb/ref 17592186271359 #edb/ref 17592186045417] [17592186271818 #edb/ref 1079 #uuid "aaf04191-f697-50a2-b21d-5e1af7e197d6" #edb/ref 17592186045417] [17592186271864 #edb/ref 1075 #edb/ref 17592186269627 #edb/ref 17592186045417] [17592186271864 #edb/ref 1075 #edb/ref 17592186270434 #edb/ref 17592186045417] [17592186271864 #edb/ref 1075 #edb/ref 17592186270965 #edb/ref 17592186045417] [17592186271864 #edb/ref 1075 #edb/ref 17592186271391 #edb/ref 17592186045417] [17592186271864 #edb/ref 1075 #edb/ref 17592186271460 #edb/ref 17592186045417] [17592186271864 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186271864 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186271864 #edb/ref 1078 #edb/ref 17592186270965 #edb/ref 17592186045417] [17592186271864 #edb/ref 1079 #uuid "c2ecc330-5bb1-57c3-85e6-604377b79cc0" #edb/ref 17592186045417] [17592186272004 #edb/ref 1068 #edb/ref 17592186271770 #edb/ref 17592186045417] [17592186272004 #edb/ref 1069 "q-140039" #edb/ref 17592186045417] [17592186272004 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186272004 #edb/ref 1071 "Consider the matrix $A$ for which ${\\lambda }_{1}=-2$ and ${\\lambda }_{2}=-1$ are eigenvalues, and\n\n$$\n{v}_{1}=[\\begin{aligned}1 \\\\ -2\\end{aligned}],\\,{v}_{2}=[\\begin{aligned}3 \\\\ -4\\end{aligned}]\n$$\n\nare the respective eigenvectors. What are the values of $a,b,c$ given that\n\n$$\nA=[\\begin{aligned}1 & b \\\\ c & -4\\end{aligned}][\\begin{aligned}a & 0 \\\\ 0 & -1\\end{aligned}]{[\\begin{aligned}1 & b \\\\ c & -4\\end{aligned}]}^{-1}?\n$$" #edb/ref 17592186045417] [17592186272004 #edb/ref 1072 #uuid "fbc0242d-25c0-5562-9348-36ca1c8266af" #edb/ref 17592186045417] [17592186272004 #edb/ref 1074 "Since the eigenvalues of the matrix are ${\\lambda }_{1}=-2$ and ${\\lambda }_{2}=-1,$ we construct the diagonal matrix $D$ by writing the eigenvalues in the main diagonal:\n\n$$\nD=[\\begin{aligned}-2 & 0 \\\\ 0 & -1\\end{aligned}].\n$$\n\nNow, to construct the matrix $P,$ we simply write the respective eigenvectors as columns: \n\n- the $1$st column is the eigenvector corresponding to ${\\lambda }_{1}=-2,$ and\n\n- the $2$nd column is the eigenvector corresponding to ${\\lambda }_{2}=-1.$\n\nTherefore, we get\n\n$$\nP=[\\begin{aligned}1 & 3 \\\\ -2 & -4\\end{aligned}].\n$$\n\nFinally, we obtain\n\n$$\nA=[\\begin{aligned}1 & 3 \\\\ -2 & -4\\end{aligned}][\\begin{aligned}-2 & 0 \\\\ 0 & -1\\end{aligned}]{[\\begin{aligned}1 & 3 \\\\ -2 & -4\\end{aligned}]}^{-1}.\n$$\n\n \n\nIn conclusion, we get $a=-2,$ $b=3,$ and $c=-2.$" #edb/ref 17592186045417] [17592186272006 #edb/ref 1068 #edb/ref 17592186271864 #edb/ref 17592186045417] [17592186272006 #edb/ref 1069 "q-140041" #edb/ref 17592186045417] [17592186272006 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186272006 #edb/ref 1071 "Determine if the matrix \n$A=[\\begin{aligned}1 & 1 \\\\ -3 & 5\\end{aligned}]$ \nis diagonalizable or not, and if it is diagonalizable, find a corresponding diagonal matrix $D.$" #edb/ref 17592186045417] [17592186272006 #edb/ref 1072 #uuid "f32897c4-518a-5afa-9fd8-47a52f4a97c0" #edb/ref 17592186045417] [17592186272006 #edb/ref 1074 "First, we find the eigenvalues of the matrix $A$ by solving $det(A-\\lambda I)=0$:\n\n$$\n\\begin{aligned}|\\begin{aligned}1-\\lambda  & 1 \\\\ -3 & 5-\\lambda \\end{aligned}| & =0 \\\\ (1-\\lambda )(5-\\lambda )-(1)(-3) & =0 \\\\ {\\lambda }^{2}-6\\lambda +5+3 & =0 \\\\ {\\lambda }^{2}-6\\lambda +8 & =0 \\\\ (\\lambda -2)(\\lambda -4) & =0\\end{aligned}\n$$\n\n \n\nSo, the eigenvalues are ${\\lambda }_{1}=2$ and ${\\lambda }_{2}=4.$ Since we get two distinct eigenvalues, the matrix $A$ is diagonalizable.\n\nNow, we construct the diagonal matrix $D,$ as follows:\n\n$$\nD=[\\begin{aligned}2 & 0 \\\\ 0 & 4\\end{aligned}]\n$$" #edb/ref 17592186045417] [17592186272016 #edb/ref 1068 #edb/ref 17592186271818 #edb/ref 17592186045417] [17592186272016 #edb/ref 1069 "q-140054" #edb/ref 17592186045417] [17592186272016 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186272016 #edb/ref 1071 "Find matrices $P$ and $D$ such that $PD{P}^{-1}=B,$ where $D$ is a diagonal matrix and $B=[\\begin{aligned}7 & -6 \\\\ 8 & -7\\end{aligned}].$" #edb/ref 17592186045417] [17592186272016 #edb/ref 1072 #uuid "0f3dda67-4437-5ed9-8f86-30b8b0141d47" #edb/ref 17592186045417] [17592186272016 #edb/ref 1074 "We apply the diagonalization algorithm.\n\n**Step 1.** We need to find the eigenvalues of the matrix $B$ using its characteristic equation $det(B-\\lambda I)=0:$\n\n$$\n\\begin{aligned}|\\begin{aligned}7-\\lambda  & -6 \\\\ 8 & -7-\\lambda \\end{aligned}| & =0 \\\\ (7-\\lambda )(-7-\\lambda )-(-6)\\cdot 8 & =0 \\\\ {\\lambda }^{2}-49+48 & =0 \\\\ {\\lambda }^{2}-1 & =0 \\\\ (\\lambda +1)(\\lambda -1) & =0\\end{aligned}\n$$\n\nSo, the eigenvalues of $B$ are ${\\lambda }_{1}=-1$ and ${\\lambda }_{2}=1.$\n\n**Step 2.** Now, we need to find an eigenvector basis of $B.$\n\n- For ${\\lambda }_{1}=-1,$ we have\n\n$$\n\\begin{aligned}B-(-1)I & =[\\begin{aligned}7 & -6 \\\\ 8 & -7\\end{aligned}]-(-1)[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}8 & -6 \\\\ 8 & -6\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M$ which we reduce to its row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}8 & -6 & 0 \\\\ 8 & -6 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\  & ∼[\\begin{aligned}8 & -6 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we obtain ${x}_{1}=\\frac{3}{4}{x}_{2}.$ Hence, the general solution is\n\n$$\n[\\begin{aligned}\\frac{3}{4}{x}_{2} \\\\ {x}_{2}\\end{aligned}],\\,{x}_{2}\\in R.\n$$\n\nSetting ${x}_{2}=4,$ we get the eigenvector ${v}_{1}=[\\begin{aligned}3 \\\\ 4\\end{aligned}].$\n\n- For ${\\lambda }_{2}=1,$ we have\n\n$$\n\\begin{aligned}B-1I & =[\\begin{aligned}7 & -6 \\\\ 8 & -7\\end{aligned}]-1[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}6 & -6 \\\\ 8 & -8\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M$ which we reduce to its row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}6 & -6 & 0 \\\\ 8 & -8 & 0\\end{aligned}] & {R}_{2} & ={R}_{2}+(-\\frac{4}{3}){R}_{1} \\\\  & ∼[\\begin{aligned}6 & -6 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we obtain ${x}_{1}={x}_{2}.$ Hence, the general solution is\n\n$$\n[\\begin{aligned}{x}_{2} \\\\ {x}_{2}\\end{aligned}],\\,{x}_{2}\\in R.\n$$\n\nSetting ${x}_{2}=1,$ we get the eigenvector ${v}_{2}=[\\begin{aligned}1 \\\\ 1\\end{aligned}].$\n\n**Step 3.** We construct the diagonal matrix $D$ and the invertible matrix $P$ as follows:\n\n$$\nD=[\\begin{aligned}-1 & 0 \\\\ 0 & 1\\end{aligned}],\\,P=[\\begin{aligned}3 & 1 \\\\ 4 & 1\\end{aligned}]\n$$" #edb/ref 17592186045417] [17592186321219 #edb/ref 1080 "$A$ is not diagonalizable" #edb/ref 17592186045417] [17592186321219 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186321219 #edb/ref 1083 #uuid "091ed9c8-701c-5cb1-b4b2-8dafbd6659dd" #edb/ref 17592186045417] [17592186321251 #edb/ref 1080 "D=[\\begin{aligned}-4 & 0 \\\\ 0 & 4\\end{aligned}]" #edb/ref 17592186045417] [17592186321251 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186321251 #edb/ref 1083 #uuid "0d4e4736-139c-5bc4-aa44-e138e20e88fa" #edb/ref 17592186045417] [17592186321275 #edb/ref 1080 "-3" #edb/ref 17592186045417] [17592186321275 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186321275 #edb/ref 1083 #uuid "103a0ee6-425a-5938-bce0-fcc173a3e