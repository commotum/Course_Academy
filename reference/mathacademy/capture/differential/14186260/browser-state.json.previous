      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14186260/observations/step-q142973-887a6a14ac56959e93db.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14186260/observations/step-q142973-887a6a14ac56959e93db.png",
      "source_url": "https://mathacademy.com/tasks/14186260/topics/260/lesson",
      "captured_at": 1791922341.2893264,
      "math_academy_id": "q-142973",
      "topic_id": "260",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q142973",
