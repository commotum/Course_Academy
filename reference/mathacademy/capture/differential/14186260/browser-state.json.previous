      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14186260/observations/step-q142523-4de8d3ae0a29cf073c54.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14186260/observations/step-q142523-4de8d3ae0a29cf073c54.png",
