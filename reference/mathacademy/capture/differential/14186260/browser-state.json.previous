      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14186260/observations/step-q142971-dc397ab584ba91ecf6a6.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14186260/observations/step-q142971-dc397ab584ba91ecf6a6.png",
      "source_url": "https://mathacademy.com/tasks/14186260/topics/260/lesson",
      "captured_at": 1791922319.2513533,
      "math_academy_id": "q-142971",
      "topic_id": "260",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q142971",
