      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14186260/observations/step-q142974-8344fe8a55f6d4270eee.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14186260/observations/step-q142974-8344fe8a55f6d4270eee.png",
      "source_url": "https://mathacademy.com/tasks/14186260/topics/260/lesson",
      "captured_at": 1791922387.4757094,
      "math_academy_id": "q-142974",
      "topic_id": "260",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q142974",
