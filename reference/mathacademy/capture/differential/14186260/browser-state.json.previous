      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14186260/observations/step-q142987-5c85ab49f8b0404011e2.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14186260/observations/step-q142987-5c85ab49f8b0404011e2.png",
      "source_url": "https://mathacademy.com/tasks/14186260/topics/260/lesson",
      "captured_at": 1791922297.73909,
      "math_academy_id": "q-142987",
