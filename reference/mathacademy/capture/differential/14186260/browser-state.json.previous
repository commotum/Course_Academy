      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14186260/observations/step-q142502-d0bf93a0a3e1dc6b2716.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14186260/observations/step-q142502-d0bf93a0a3e1dc6b2716.png",
      "source_url": "https://mathacademy.com/tasks/14186260/topics/260/lesson",
      "captured_at": 1791922445.466219,
      "math_academy_id": "q-142502",
      "topic_id": "260",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q142502",
