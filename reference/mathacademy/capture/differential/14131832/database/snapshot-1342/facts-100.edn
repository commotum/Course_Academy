] [17592186431109 #edb/ref 1075 #edb/ref 17592186431069 #edb/ref 17592186045417] [17592186431109 #edb/ref 1075 #edb/ref 17592186431089 #edb/ref 17592186045417] [17592186431109 #edb/ref 1075 #edb/ref 17592186431095 #edb/ref 17592186045417] [17592186431109 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186431109 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186431109 #edb/ref 1078 #edb/ref 17592186431068 #edb/ref 17592186045417] [17592186431109 #edb/ref 1079 #uuid "ec74a8fe-dc16-5d8a-9024-ad8266707d7b" #edb/ref 17592186045417] [17592186431110 #edb/ref 1068 #edb/ref 17592186431109 #edb/ref 17592186045417] [17592186431110 #edb/ref 1069 "q-114301" #edb/ref 17592186045417] [17592186431110 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186431110 #edb/ref 1071 "$\\int \\operatorname{cot}⁡x(3\\operatorname{sin}⁡x-2\\operatorname{csc}⁡x)\\,\\text{d}x=$" #edb/ref 17592186045417] [17592186431110 #edb/ref 1072 #uuid "0c4f53f7-a91f-5a87-b60c-2cd20463d6e9" #edb/ref 17592186045417] [17592186431110 #edb/ref 1074 "We multiply out the parentheses and then use the identity $\\operatorname{cot}⁡x=\\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x},$ as follows:\n\n$$\n\\begin{aligned}\\int \\operatorname{cot}⁡x(3\\operatorname{sin}⁡x-2\\operatorname{csc}⁡x)\\,\\text{d}x & =\\int (\\operatorname{cot}⁡x\\cdot 3\\operatorname{sin}⁡x-\\operatorname{cot}⁡x\\cdot 2\\operatorname{csc}⁡x)\\text{d}x \\\\  & =\\int (\\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}\\cdot 3\\operatorname{sin}⁡x-\\operatorname{cot}⁡x\\cdot 2\\operatorname{csc}⁡x)\\text{d}x \\\\  & =\\int (3\\operatorname{cos}⁡x-2\\operatorname{csc}⁡x\\operatorname{cot}⁡x)\\text{d}x \\\\  & =3\\int \\operatorname{cos}⁡x\\,\\text{d}x-2\\int \\operatorname{csc}⁡x\\operatorname{cot}⁡x\\,\\text{d}x \\\\  & =3\\operatorname{sin}⁡x-2(-\\operatorname{csc}⁡x)+C \\\\  & =3\\operatorname{sin}⁡x+2\\operatorname{csc}⁡x+C\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186431111 #edb/ref 1068 #edb/ref 17592186431105 #edb/ref 17592186045417] [17592186431111 #edb/ref 1069 "q-114308" #edb/ref 17592186045417] [17592186431111 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186431111 #edb/ref 1071 "$\\int \\frac{{tan}^{2}⁡x-{sin}^{3}⁡x}{{sin}^{2}⁡x}\\,\\text{d}x=$" #edb/ref 17592186045417] [17592186431111 #edb/ref 1072 #uuid "1a4cd24e-1cbf-547b-aab3-c78dc742ec94" #edb/ref 17592186045417] [17592186431111 #edb/ref 1074 "We can write the integral as\n\n$$\n\\int \\frac{{tan}^{2}⁡x-{sin}^{3}⁡x}{{sin}^{2}⁡x}\\,\\text{d}x=\\int \\frac{1}{{sin}^{2}⁡x}({tan}^{2}⁡x-{sin}^{3}⁡x)\\text{d}x.\n$$\n\nWe then use the fact that ${tan}^{2}⁡x=\\frac{{sin}^{2}⁡x}{{cos}^{2}⁡x}$ to express this as\n\n$$\n\\int \\frac{1}{{sin}^{2}⁡x}(\\frac{{sin}^{2}⁡x}{{cos}^{2}⁡x}-{sin}^{3}⁡x)\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int \\frac{{tan}^{2}⁡x-{sin}^{3}⁡x}{{sin}^{2}⁡x}\\,\\text{d}x & =\\int \\frac{1}{{sin}^{2}⁡x}(\\frac{{sin}^{2}⁡x}{{cos}^{2}⁡x}-{sin}^{3}⁡x)\\text{d}x \\\\  & =\\int (\\frac{1}{{sin}^{2}⁡x}\\cdot \\frac{{sin}^{2}⁡x}{{cos}^{2}⁡x}-\\frac{1}{{sin}^{2}⁡x}\\cdot {sin}^{3}⁡x)\\text{d}x \\\\  & =\\int (\\frac{1}{{cos}^{2}⁡x}-\\operatorname{sin}⁡x)\\text{d}x \\\\  & =\\int ({sec}^{2}⁡x-\\operatorname{sin}⁡x)\\text{d}x \\\\  & =\\operatorname{tan}⁡x-(-\\operatorname{cos}⁡x)+C \\\\  & =\\operatorname{tan}⁡x+\\operatorname{cos}⁡x+C.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186431112 #edb/ref 1068 #edb/ref 17592186431108 #edb/ref 17592186045417] [17592186431112 #edb/ref 1069 "q-73365" #edb/ref 17592186045417] [17592186431112 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186431112 #edb/ref 1071 "Calculate ${\\int }_{0}^{\\pi /6}\\frac{1-{tan}^{2}⁡x}{{cos}^{2}⁡x-{sin}^{2}⁡x}\\,\\text{d}x.$" #edb/ref 17592186045417] [17592186431112 #edb/ref 1072 #uuid "49b73c78-3335-57b5-a631-c7f8dd771090" #edb/ref 17592186045417] [17592186431112 #edb/ref 1074 "We can write the integral as\n\n$$\n{\\int }_{0}^{\\pi /6}\\frac{1-{tan}^{2}⁡x}{{cos}^{2}⁡x-{sin}^{2}⁡x}\\,\\text{d}x={\\int }_{0}^{\\pi /6}(1-{tan}^{2}⁡x)\\cdot \\frac{1}{{cos}^{2}⁡x-{sin}^{2}⁡x}\\,\\text{d}x\n$$\n\nThen, we use the fact that $\\operatorname{tan}⁡x=\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /6}(1-{tan}^{2}⁡x)\\cdot \\frac{1}{{cos}^{2}⁡x-{sin}^{2}⁡x}\\,\\text{d}x & ={\\int }_{0}^{\\pi /6}(1-\\frac{{sin}^{2}⁡x}{{cos}^{2}⁡x})\\cdot \\frac{1}{{cos}^{2}⁡x-{sin}^{2}⁡x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /6}(\\frac{{cos}^{2}⁡x-{sin}^{2}⁡x}{{cos}^{2}⁡x})\\cdot \\frac{1}{{cos}^{2}⁡x-{sin}^{2}⁡x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /6}\\frac{1}{{cos}^{2}⁡x}\\,\\text{d}x\\end{aligned}\n$$\n\nNow we use the fact that $\\frac{1}{\\operatorname{cos}⁡x}=\\operatorname{sec}⁡x$ to express this as\n\n$$\n{\\int }_{0}^{\\pi /6}{sec}^{2}⁡x\\text{d}x.\n$$\n\nHence,\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /6}\\frac{1-{tan}^{2}⁡x}{{cos}^{2}⁡x-{sin}^{2}⁡x}\\,\\text{d}x & ={\\int }_{0}^{\\pi /6}{sec}^{2}⁡x\\text{d}x \\\\  & =\\operatorname{tan}⁡x{|}_{0}^{\\pi /6} \\\\  & =\\operatorname{tan}⁡(\\frac{\\pi }{6})-\\operatorname{tan}⁡0 \\\\  & =\\frac{\\sqrt{3}}{3}-0 \\\\  & =\\frac{\\sqrt{3}}{3}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186431113 #edb/ref 1068 #edb/ref 17592186431102 #edb/ref 17592186045417] [17592186431113 #edb/ref 1069 "q-352711" #edb/ref 17592186045417] [17592186431113 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186431113 #edb/ref 1071 "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\pi /6}\\frac{\\operatorname{sin}⁡x}{{cos}^{2}⁡x}\\,\\text{d}x=$\n{{field-1}}" #edb/ref 17592186045417] [17592186431113 #edb/ref 1072 #uuid "77e54e57-de69-5688-a9c9-dfe71c2ce5e6" #edb/ref 17592186045417] [17592186431113 #edb/ref 1074 "We use the identities $\\frac{1}{\\operatorname{cos}⁡x}=\\operatorname{sec}⁡x$ and $\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}=\\operatorname{tan}⁡x,$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /6}\\frac{\\operatorname{sin}⁡x}{{cos}^{2}⁡x}\\text{d}x & ={\\int }_{0}^{\\pi /6}\\frac{1}{\\operatorname{cos}⁡x}\\cdot \\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /6}\\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x \\\\  & =\\operatorname{sec}⁡x{|}_{0}^{\\pi /6} \\\\  & =(\\operatorname{sec}⁡(\\frac{\\pi }{6})-\\operatorname{sec}⁡(0)) \\\\  & =\\frac{2}{\\sqrt{3}}-1\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186431114 #edb/ref 1068 #edb/ref 17592186431099 #edb/ref 17592186045417] [17592186431114 #edb/ref 1069 "q-114319" #edb/ref 17592186045417] [17592186431114 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186431114 #edb/ref 1071 "${\\int }_{0}^{\\pi /3}\\frac{\\operatorname{tan}⁡x}{\\operatorname{sec}⁡x}\\,\\text{d}x=$" #edb/ref 17592186045417] [17592186431114 #edb/ref 1072 #uuid "8cd683e0-e43d-570b-a907-b426c76c1c6f" #edb/ref 17592186045417] [17592186431114 #edb/ref 1074 "We can write the integral as\n\n$$\n{\\int }_{0}^{\\pi /3}\\frac{\\operatorname{tan}⁡x}{\\operatorname{sec}⁡x}\\,\\text{d}x={\\int }_{0}^{\\pi /3}\\frac{1}{\\operatorname{sec}⁡x}\\cdot \\operatorname{tan}⁡x\\,\\text{d}x.\n$$\n\nWe then use the fact that $\\operatorname{sec}⁡x=\\frac{1}{\\operatorname{cos}⁡x}$ and $\\operatorname{tan}⁡x=\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}$ to express this as\n\n$$\n{\\int }_{0}^{\\pi /3}\\operatorname{cos}⁡x\\cdot \\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /3}\\frac{1}{\\operatorname{sec}⁡x}\\cdot \\operatorname{tan}⁡x\\,\\text{d}x & ={\\int }_{0}^{\\pi /3}\\operatorname{cos}⁡x\\cdot \\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /3}\\operatorname{sin}⁡x\\,\\text{d}x \\\\  & =-\\operatorname{cos}⁡x\\,{|}_{0}^{\\pi /3} \\\\  & =-[\\operatorname{cos}⁡(\\frac{\\pi }{3})-\\operatorname{cos}⁡0] \\\\  & =-[\\frac{1}{2}-1] \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186431115 #edb/ref 1068 #edb/ref 17592186431104 #edb/ref 17592186045417] [17592186431115 #edb/ref 1069 "q-10040" #edb/ref 17592186045417] [17592186431115 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186431115 #edb/ref 1071 "${\\int }_{0}^{1}\\operatorname{tan}⁡x\\,\\text{d}x=$" #edb/ref 17592186045417] [17592186431115 #edb/ref 1072 #uuid "a60367e9-cec6-56ff-bdf1-1a7368d63d95" #edb/ref 17592186045417] [17592186431115 #edb/ref 1074 "We use the identity $\\operatorname{tan}⁡x=\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}$ and rewrite the integral as\n\n$$\n{\\int }_{0}^{1}\\operatorname{tan}⁡x\\,\\text{d}x={\\int }_{0}^{1}\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\\,\\text{d}x.\n$$\n\nWe can solve this by substitution. Let $u=\\operatorname{cos}⁡x.$ Then \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-\\operatorname{sin}⁡x\\,⟹\\,\\text{d}u=-\\operatorname{sin}⁡x\\,\\text{d}x.\n$$\n\nNow, we fill the table for the limits of integration, according to the rule $u=\\operatorname{cos}⁡x.$\n\n| $x$ | $0$ | $1$ |\n| --- | --- | --- |\n| $u$ | $1$ | $\\operatorname{cos}⁡(1)$ |\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\nHence\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}\\operatorname{tan}⁡x\\,\\text{d}x & =-{\\int }_{1}^{\\operatorname{cos}⁡(1)}\\frac{1}{u}\\text{d}u \\\\  & =-\\operatorname{ln}⁡|u|{|}_{1}^{\\operatorname{cos}⁡(1)} \\\\  & =-\\operatorname{ln}⁡|\\operatorname{cos}⁡(1)|+\\operatorname{ln}⁡|1| \\\\  & =-\\operatorname{ln}⁡|\\operatorname{cos}⁡(1)|.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186431116 #edb/ref 1068 #edb/ref 17592186431103 #edb/ref 17592186045417] [17592186431116 #edb/ref 1069 "q-49279" #edb/ref 17592186045417] [17592186431116 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186431116 #edb/ref 1071 "${\\int }_{\\pi /6}^{\\pi /3}\\frac{{tan}^{2}⁡x}{{cos}^{2}⁡x}\\,\\text{d}x=$" #edb/ref 17592186045417] [17592186431116 #edb/ref 1072 #uuid "c26cdc41-d401-5858-96e0-ffa4a20294ca" #edb/ref 17592186045417] [17592186431116 #edb/ref 1074 "We use the identity $\\frac{1}{\\operatorname{cos}⁡x}=\\operatorname{sec}⁡x$ and rewrite the integral as\n\n$$\n{\\int }_{\\pi /6}^{\\pi /3}\\frac{{tan}^{2}⁡x}{{cos}^{2}⁡x}\\,\\text{d}x={\\int }_{\\pi /6}^{\\pi /3}{tan}^{2}⁡x\\cdot {sec}^{2}⁡x\\,\\text{d}x.\n$$\n\nWe can solve this by substitution. Let $u=\\operatorname{tan}⁡x.$ Then,\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}={sec}^{2}⁡x\\,⟹\\,du={sec}^{2}⁡x\\,\\text{d}x.\n$$\n\nNow, we fill the table for the limits of integration, according to the rule $u=\\operatorname{tan}⁡x.$\n\n| $x$ | $\\frac{\\pi }{6}$ | $\\frac{\\pi }{3}$ |\n| --- | --- | --- |\n| $u$ | $\\frac{\\sqrt{3}}{3}$ | $\\sqrt{3}$ |\n\nTherefore, the integral in terms of the new variable is\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{\\pi /6}^{\\pi /3}{tan}^{2}⁡x\\cdot {sec}^{2}⁡x\\,\\text{d}x & ={\\int }_{\\sqrt{3}/3}^{\\sqrt{3}}{u}^{2}\\,\\cdot \\text{d}u \\\\  & =\\frac{{u}^{3}}{3}{|}_{\\sqrt{3}/3}^{\\sqrt{3}} \\\\  & =\\frac{1}{3}({(\\sqrt{3})}^{3}-{(\\frac{\\sqrt{3}}{3})}^{3}) \\\\  & =\\frac{1}{3}(3\\sqrt{3}-\\frac{\\sqrt{3}}{9}) \\\\  & =\\frac{\\sqrt{3}}{3}(3-\\frac{1}{9}) \\\\  & =\\frac{26\\sqrt{3}}{27}.\\end{aligned}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186431117 #edb/ref 1068 #edb/ref 17592186431106 #edb/ref 17592186045417] [17592186431117 #edb/ref 1069 "q-358219" #edb/ref 17592186045417] [17592186431117 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186431117 #edb/ref 1071 "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\pi /6}3\\operatorname{sec}⁡2x{cos}^{2}⁡2x\\,\\text{d}x=$\n{{field-1}}" #edb/ref 17592186045417] [17592186431117 #edb/ref 1072 #uuid "cdc94a5e-ffa3-5e3c-b067-8b7e71e5c799" #edb/ref 17592186045417] [17592186431117 #edb/ref 1074 "We use the identity $\\operatorname{sec}⁡x=\\frac{1}{\\operatorname{cos}⁡x},$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /6}3\\operatorname{sec}⁡2x{cos}^{2}⁡2x\\,\\text{d}x & =3{\\int }_{0}^{\\pi /6}\\frac{1}{\\operatorname{cos}⁡2x}\\cdot {cos}^{2}⁡2x\\,\\text{d}x \\\\  & =3{\\int }_{0}^{\\pi /6}\\operatorname{cos}⁡2x\\,\\text{d}x\\end{aligned}\n$$\n\nWe can solve this by substitution. Let $u=2x.$ Then $\\text{d}x=\\frac{1}{2}\\text{d}u.$ \n\nNow, we fill the table for the limits of integration, according to the rule $u=2x.$\n\n| $x$ | $0$ | $\\frac{\\pi }{6}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\frac{\\pi }{3}$ |\n\nTherefore, the integral in terms of the new variable is\n\n$$\n\\begin{aligned}\\begin{aligned}3{\\int }_{0}^{\\pi /6}\\operatorname{cos}⁡2x\\,\\text{d}x & =3{\\int }_{0}^{\\pi /3}\\operatorname{cos}⁡u\\,\\cdot \\frac{1}{2}\\text{d}u \\\\  & =\\frac{3}{2}{\\int }_{0}^{\\pi /3}\\operatorname{cos}⁡u\\,\\text{d}u \\\\  & =\\frac{3}{2}\\cdot \\operatorname{sin}⁡u{|}_{0}^{\\pi /3} \\\\  & =\\frac{3}{2}(sin\\,(\\frac{\\pi }{3})-sin\\,(0)) \\\\  & =\\frac{3}{2}(\\frac{\\sqrt{3}}{2}-0) \\\\  & =\\frac{3\\sqrt{3}}{4}.\\end{aligned}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186431118 #edb/ref 1068 #edb/ref 17592186431100 #edb/ref 17592186045417] [17592186431118 #edb/ref 1069 "q-358220" #edb/ref 17592186045417] [17592186431118 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186431118 #edb/ref 1071 "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{\\pi /12}^{\\pi /9}\\frac{9}{{cos}^{2}⁡(3x)}\\,\\text{d}x=$\n{{field-1}}" #edb/ref 17592186045417] [17592186431118 #edb/ref 1072 #uuid "d54d59da-aeb4-5592-b790-f9a9feee5b10" #edb/ref 17592186045417] [17592186431118 #edb/ref 1074 "First, we use the identity $\\frac{1}{\\operatorname{cos}⁡3x}=\\operatorname{sec}⁡3x$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{\\pi /12}^{\\pi /9}\\frac{9}{{cos}^{2}⁡(3x)}\\,\\text{d}x & ={\\int }_{\\pi /12}^{\\pi /9}9{(\\frac{1}{\\operatorname{cos}⁡(3x)})}^{2}\\,\\text{d}x \\\\  & ={\\int }_{\\pi /12}^{\\pi /9}9{sec}^{2}⁡(3x)\\,\\text{d}x \\\\  & =9{\\int }_{\\pi /12}^{\\pi /9}{sec}^{2}⁡(3x)\\,\\text{d}x\\end{aligned}\n$$\n\nWe can solve this by substitution. Let $u=3x.$ Then $\\text{d}x=\\frac{1}{3}\\text{d}u.$ \n\nNow, we fill the table for the limits of integration, according to the rule $u=3x.$\n\n| $x$ | $\\frac{\\pi }{12}$ | $\\frac{\\pi }{9}$ |\n| --- | --- | --- |\n| $u$ | $\\frac{\\pi }{4}$ | $\\frac{\\pi }{3}$ |\n\nTherefore, the integral in terms of the new variable is\n\n$$\n\\begin{aligned}\\begin{aligned}9{\\int }_{\\pi /12}^{\\pi /9}{sec}^{2}⁡(3x)\\,\\text{d}x & =9{\\int }_{\\pi /4}^{\\pi /3}{sec}^{2}⁡u\\,\\cdot \\frac{1}{3}\\text{d}u \\\\  & =3{\\int }_{\\pi /4}^{\\pi /3}{sec}^{2}⁡u\\,\\text{d}u \\\\  & =3\\operatorname{tan}⁡u{|}_{\\pi /4}^{\\pi /3} \\\\  & =3(\\operatorname{tan}⁡(\\frac{\\pi }{3})-\\operatorname{tan}⁡(\\frac{\\pi }{4})) \\\\  & =3(\\sqrt{3}-1) \\\\  & =3\\sqrt{3}-3.\\end{aligned}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186431119 #edb/ref 1068 #edb/ref 17592186431101 #edb/ref 17592186045417] [17592186431119 #edb/ref 1069 "q-362158" #edb/ref 17592186045417] [17592186431119 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186431119 #edb/ref 1071 "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{\\pi /24}^{\\pi /8}\\operatorname{cot}⁡(4x)\\,\\text{d}x=$\n{{field-1}}" #edb/ref 17592186045417] [17592186431119 #edb/ref 1072 #uuid "dadcc805-1744-58ea-b449-313016666d23" #edb/ref 17592186045417] [17592186431119 #edb/ref 1074 "We can solve this by substitution. Let $u=\\operatorname{sin}⁡4x.$ Then \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=4\\operatorname{cos}⁡4x\\,⟹\\,\\frac{1}{4}\\text{d}u=\\operatorname{cos}⁡4x\\,\\text{d}x.\n$$\n\nNow, we fill the table for the limits of integration, according to the rule $u=\\operatorname{sin}⁡4x.$\n\n| $x$ | $\\frac{\\pi }{24}$ | $\\frac{\\pi }{8}$ |\n| --- | --- | --- |\n| $u$ | $\\frac{1}{2}$ | $1$ |\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{\\pi /24}^{\\pi /8}\\operatorname{cot}⁡(4x)\\,\\text{d}x & ={\\int }_{\\pi /24}^{\\pi /8}\\frac{\\operatorname{cos}⁡(4x)}{\\operatorname{sin}⁡(4x)}\\,\\text{d}x \\\\  & =\\frac{1}{4}{\\int }_{1/2}^{1}\\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{4}\\operatorname{ln}⁡|u|{|}_{1/2}^{1} \\\\  & =\\frac{1}{4}(\\operatorname{ln}⁡(1)-\\operatorname{ln}⁡(\\frac{1}{2})) \\\\  & =\\frac{\\operatorname{ln}⁡2}{4}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186431120 #edb/ref 1068 #edb/ref 17592186431107 #edb/ref 17592186045417] [17592186431120 #edb/ref 1069 "q-114295" #edb/ref 17592186045417] [17592186431120 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186431120 #edb/ref 1071 "$\\int \\operatorname{tan}⁡(\\frac{x}{2})\\text{d}x=$" #edb/ref 17592186045417] [17592186431120 #edb/ref 1072 #uuid "f01d9ac9-bb7d-5b0c-be19-2dc05bc65cd7" #edb/ref 17592186045417] [17592186431120 #edb/ref 1074 "We use the identity $\\operatorname{tan}⁡(\\frac{x}{2})=\\frac{\\operatorname{sin}⁡(\\frac{x}{2})}{\\operatorname{cos}⁡(\\frac{x}{2})}$ and rewrite the integral as\n\n$$\n\\int \\operatorname{tan}⁡(\\frac{x}{2})\\text{d}x=\\int \\frac{\\operatorname{sin}⁡(\\frac{x}{2})}{\\operatorname{cos}⁡(\\frac{x}{2})}\\,\\text{d}x.\n$$\n\nWe can solve this by substitution. Let $u=\\operatorname{cos}⁡(\\frac{x}{2}).$ Then \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-\\frac{1}{2}\\operatorname{sin}⁡(\\frac{x}{2})\\,⟹\\,-2\\text{d}u=\\operatorname{sin}⁡(\\frac{x}{2})\\,\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{\\operatorname{sin}⁡(\\frac{x}{2})}{\\operatorname{cos}⁡(\\frac{x}{2})}\\,\\text{d}x & =-2\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =-2\\operatorname{ln}⁡|u|+C \\\\  & =-2\\operatorname{ln}⁡|\\operatorname{cos}⁡(\\frac{x}{2})|+C\\end{aligned}\n$$" #edb/ref 17592186045417]}
