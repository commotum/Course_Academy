⁡x\\cdot \\operatorname{csc}⁡x)\\text{d}x \\\\  & =\\int (\\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}\\cdot \\operatorname{sin}⁡x-\\operatorname{cot}⁡x\\cdot \\operatorname{csc}⁡x)\\text{d}x \\\\  & =\\int (\\operatorname{cos}⁡x-\\operatorname{csc}⁡x\\operatorname{cot}⁡x)\\text{d}x.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int \\frac{\\operatorname{sin}⁡x-\\operatorname{csc}⁡x}{\\operatorname{tan}⁡x}\\,\\text{d}x & =\\int (\\operatorname{cos}⁡x-\\operatorname{csc}⁡x\\operatorname{cot}⁡x)\\text{d}x \\\\  & =\\operatorname{sin}⁡x-(-\\operatorname{csc}⁡x)+C \\\\  & =\\operatorname{sin}⁡x+\\operatorname{csc}⁡x+C.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186319573 #edb/ref 1080 "\\operatorname{ln}(\\frac{3}{2})" #edb/ref 17592186045417] [17592186319573 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186319573 #edb/ref 1083 #uuid "3c4c17b5-6041-5b4a-921e-16d5b13a2a5f" #edb/ref 17592186045417] [17592186320413 #edb/ref 1075 #edb/ref 17592186319573 #edb/ref 17592186045417] [17592186320413 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186320413 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186320413 #edb/ref 1078 #edb/ref 17592186319573 #edb/ref 17592186045417] [17592186320413 #edb/ref 1079 #uuid "786408a1-4911-5c78-8041-0f51f924f24b" #edb/ref 17592186045417] [17592186321041 #edb/ref 1068 #edb/ref 17592186320413 #edb/ref 17592186045417] [17592186321041 #edb/ref 1069 "q-352797" #edb/ref 17592186045417] [17592186321041 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186321041 #edb/ref 1071 "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\pi /12}\\frac{2\\operatorname{cos}⁡(2x)}{1+\\operatorname{sin}⁡(2x)}\\,\\text{d}x=$\n{{field-1}}" #edb/ref 17592186045417] [17592186321041 #edb/ref 1072 #uuid "00fe6411-9f3d-58f9-a531-7305d81e2e57" #edb/ref 17592186045417] [17592186321041 #edb/ref 1074 "We can solve this by substitution. Let $u=1+\\operatorname{sin}⁡2x.$ Then \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2\\operatorname{cos}⁡2x\\,⟹\\,\\text{d}u=2\\operatorname{cos}⁡2x\\,\\text{d}x.\n$$\n\nNow, we fill the table for the limits of integration, according to the rule $u=1+\\operatorname{sin}⁡2x.$\n\n| $x$ | $0$ | $\\frac{\\pi }{12}$ |\n| --- | --- | --- |\n| $u$ | $1$ | $\\frac{3}{2}$ |\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{0}^{\\pi /12}\\frac{2\\operatorname{cos}⁡(2x)}{1+\\operatorname{sin}⁡(2x)}\\,\\text{d}x & ={\\int }_{1}^{3/2}\\frac{1}{u}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡|u|{|}_{1}^{3/2} \\\\  & =\\operatorname{ln}⁡(\\frac{3}{2})-\\operatorname{ln}⁡(1) \\\\  & =\\operatorname{ln}⁡(\\frac{3}{2})\\end{aligned}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186330371 #edb/ref 1080 "-\\operatorname{cos}⁡x+C" #edb/ref 17592186045417] [17592186330371 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186330371 #edb/ref 1083 #uuid "2fc5237a-c69b-55ae-b866-010d3f7a5bd4" #edb/ref 17592186045417] [17592186330489 #edb/ref 1080 "-\\frac{1}{2}\\operatorname{sin}⁡x+C" #edb/ref 17592186045417] [17592186330489 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186330489 #edb/ref 1083 #uuid "3cd1cdcd-2921-5ddc-b909-e7e993685c9a" #edb/ref 17592186045417] [17592186330683 #edb/ref 1080 "\\operatorname{sin}⁡x+C" #edb/ref 17592186045417] [17592186330683 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186330683 #edb/ref 1083 #uuid "50fef89f-04e0-57c1-8ae4-fc0b3a91c400" #edb/ref 17592186045417] [17592186331100 #edb/ref 1080 "-\\frac{1}{2}\\operatorname{cos}⁡x+C" #edb/ref 17592186045417] [17592186331100 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186331100 #edb/ref 1083 #uuid "8245d36a-a259-5c47-8ea5-6c5ffebba5d7" #edb/ref 17592186045417] [17592186331240 #edb/ref 1080 "\\frac{1}{2}\\operatorname{cos}⁡x+C" #edb/ref 17592186045417] [17592186331240 #edb/ref 10