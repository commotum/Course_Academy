    "q-36023": {
      "dom_id": "step-q36023",
      "name": "Question 2",
      "problem": "Consider the straight line given by the following parametric equations:\n\n$$\n{\\begin{aligned}x=5 \\\\ y=4t \\\\ z=7\\end{aligned}\n$$\n\nWhat would be the vector equation of the line?",
      "worked_solution": "These parametric equations are equivalent to\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}5 \\\\ 4t \\\\ 7\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}5 \\\\ 0 \\\\ 7\\end{aligned}]+[\\begin{aligned}0 \\\\ 4t \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}5 \\\\ 0 \\\\ 7\\end{aligned}]+t[\\begin{aligned}0 \\\\ 4 \\\\ 0\\end{aligned}] \\\\ r & =[\\begin{aligned}5 \\\\ 0 \\\\ 7\\end{aligned}]+t[\\begin{aligned}0 \\\\ 4 \\\\ 0\\end{aligned}],\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$",
      "calculator_instructions": "",
      "fields": [
        {
          "key": "selection",
          "type": "radio",
          "choices": [
            {
              "option": "a",
              "dom_id": "questionWidget-choiceLetterCircle-36023-a",
              "type": "math",
