              "value": "r=[\\begin{aligned}-3 \\\\ 0 \\\\ -2\\end{aligned}]+t[\\begin{aligned}0 \\\\ 5 \\\\ 0\\end{aligned}],\\,t\\in (-\\infty ,\\infty )",
