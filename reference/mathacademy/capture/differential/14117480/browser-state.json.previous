    "q-126997": {
      "dom_id": "step-q126997",
      "name": "Question 1",
      "problem": "Consider the straight line given by the following parametric equations:\n\n$$\n{\\begin{aligned}x=-3 \\\\ y=5t \\\\ z=-2\\end{aligned}\n$$\n\nWhat would be the vector equation of the line?",
      "worked_solution": "These parametric equations are equivalent to\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}-3 \\\\ 5t \\\\ -2\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}-3 \\\\ 0 \\\\ -2\\end{aligned}]+[\\begin{aligned}0 \\\\ 5t \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}-3 \\\\ 0 \\\\ -2\\end{aligned}]+t[\\begin{aligned}0 \\\\ 5 \\\\ 0\\end{aligned}] \\\\ r & =[\\begin{aligned}-3 \\\\ 0 \\\\ -2\\end{aligned}]+t[\\begin{aligned}0 \\\\ 5 \\\\ 0\\end{aligned}],\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$",
      "calculator_instructions": "",
      "fields": [
        {
          "key": "selection",
          "type": "radio",
          "choices": [
            {
              "option": "a",
              "dom_id": "questionWidget-choiceLetterCircle-126997-a",
