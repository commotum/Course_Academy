      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14117480/observations/step-q127065-fe97052b64a4b9ed2c0b.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14117480/observations/step-q127065-fe97052b64a4b9ed2c0b.png",
      "source_url": "https://mathacademy.com/tasks/14117480/topics/1920/lesson",
