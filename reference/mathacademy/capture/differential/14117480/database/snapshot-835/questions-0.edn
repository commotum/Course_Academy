{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186402485} {:answer/id #uuid "9d828f3b-5ac7-5510-af91-3c48513bcd3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=t[\\begin{aligned}5 \\\\ 0 \\\\ 7\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186402486} {:answer/id #uuid "adf2184f-2ab7-5a41-899d-7af938d2d615" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}5 \\\\ 0 \\\\ 7\\end{aligned}]+t[\\begin{aligned}0 \\\\ 4 \\\\ 0\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186402487}] :answer-field/correct {:answer/id #uuid "adf2184f-2ab7-5a41-899d-7af938d2d615" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}5 \\\\ 0 \\\\ 7\\end{aligned}]+t[\\begin{aligned}0 \\\\ 4 \\\\ 0\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186402487} :answer-field/id #uuid "7ab63e7a-abce-576e-813c-95b8e9f02934" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402482}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9efb0092-3045-58e2-bed4-ca88fc8fe6c0" :question/math-academy-id "q-36023" :question/problem "Consider the straight line given by the following parametric equations:\n\n$$\n{\\begin{aligned}x=5 \\\\ y=4t \\\\ z=7\\end{aligned}\n$$\n\nWhat would be the vector equation of the line?" :question/worked-solution "These parametric equations are equivalent to\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}5 \\\\ 4t \\\\ 7\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}5 \\\\ 0 \\\\ 7\\end{aligned}]+[\\begin{aligned}0 \\\\ 4t \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}5 \\\\ 0 \\\\ 7\\end{aligned}]+t[\\begin{aligned}0 \\\\ 4 \\\\ 0\\end{aligned}] \\\\ r & =[\\begin{aligned}5 \\\\ 0 \\\\ 7\\end{aligned}]+t[\\begin{aligned}0 \\\\ 4 \\\\ 0\\end{aligned}],\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$"}] [{:db/id #edb/ref 17592186338810 :knowledge-point/_questions [{:db/id #edb/ref 17592186124499 :knowledge-point/id #uuid "b3699391-68e8-5c59-8ca2-83fded9f22de" :knowledge-point/title "Finding a Vector Parallel To a Straight Line Given Parametrically"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c314c11-ff96-52aa-9c41-1e5203e845b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 \\\\ 2 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186336147} {:answer/id #uuid "280ee01f-e0ec-58cc-86af-3a090407f842" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186336406} {:answer/id #uuid "3c2ada18-8fc9-55de-8d2a-f0515ce3e573" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ -1 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186336599} {:answer/id #uuid "415002f1-ed87-5b2d-9195-31d3b5aef208" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 3 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186336646} {:answer/id #uuid "7e11a8cb-e5dc-55f2-881d-8e03410848a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 \\\\ 4 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186337172}] :answer-field/correct {:answer/id #uuid "3c2ada18-8fc9-55de-8d2a-f0515ce3e573" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ -1 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186336599} :answer-field/id #uuid "b2453786-4280-5536-b1cd-5be4de9977ad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338604}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "16ba2f9d-591a-54f5-9c7d-d4c5f3dfb24c" :question/math-academy-id "q-70716" :question/problem "Consider the straight line given by the following parametric equations:\n\n$$\n{\\begin{aligned}x=2t+1 \\\\ y=3-t \\\\ z=t+2\\end{aligned}\n$$\n\nFind a vector that is parallel to the line." :question/worked-solution "First, let's find the corresponding vector equation:\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}2t+1 \\\\ 3-t \\\\ t+2\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}1 \\\\ 3 \\\\ 2\\end{aligned}]+[\\begin{aligned}2t \\\\ -t \\\\ t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}1 \\\\ 3 \\\\ 2\\end{aligned}]+t[\\begin{aligned}2 \\\\ -1 \\\\ 1\\end{aligned}] \\\\ r & =[\\begin{aligned}1 \\\\ 3 \\\\ 2\\end{aligned}]+t[\\begin{aligned}2 \\\\ -1 \\\\ 1\\end{aligned}],\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$  \n\nThis implies that the straight line passes through the point $(1,3,2)$  and is parallel to the vector $v=[\\begin{aligned}2 \\\\ -1 \\\\ 1\\end{aligned}].$"}]}
