d6-f3b32cbf67e2" #edb/ref 17592186045417] [17592186401544 #edb/ref 1068 #edb/ref 17592186401545 #edb/ref 17592186045417] [17592186401544 #edb/ref 1069 "q-164553" #edb/ref 17592186045417] [17592186401544 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186401544 #edb/ref 1071 "Identify the surface $5{x}^{2}-{y}^{2}-5{z}^{2}+20x+10z+15=0.$" #edb/ref 17592186045417] [17592186401544 #edb/ref 1072 #uuid "040e9acf-1af9-5813-86f6-e469cb0eecc9" #edb/ref 17592186045417] [17592186401544 #edb/ref 1074 "First, we complete the square in the $x$ and $z$ terms:\n\n$$\n\\begin{aligned}5{x}^{2}-{y}^{2}-5{z}^{2}+20x+10z+15 & =0 \\\\ 5({x}^{2}+4x)-{y}^{2}-5({z}^{2}-2z)+15 & =0 \\\\ 5[(x+2)^{2}-4]-{y}^{2}-5[(z-1)^{2}-1]+15 & =0 \\\\ 5(x+2)^{2}-20-{y}^{2}-5(z-1)^{2}+5+15 & =0 \\\\ 5(x+2)^{2}-{y}^{2}-5(z-1)^{2} & =0 \\\\ -5(x+2)^{2}+{y}^{2}+5(z-1)^{2} & =0\\end{aligned}\n$$\n\nThis is the equation of an elliptic cone centered at $(-2,0,1).$" #edb/ref 17592186045417] [17592186401545 #edb/ref 1075 #edb/ref 17592186401546 #edb/ref 17592186045417] [17592186401545 #edb/ref 1075 #edb/ref 17592186401547 #edb/ref 17592186045417] [17592186401545 #edb/ref 1075 #edb/ref 17592186401548 #edb/ref 17592186045417] [17592186401545 #edb/ref 1075 #edb/ref 17592186401549 #edb/ref 17592186045417] [17592186401545 #edb/ref 1075 #edb/ref 17592186401550 #edb/ref 17592186045417] [17592186401545 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186401545 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186401545 #edb/ref 1078 #edb/ref 17592186401547 #edb/ref 17592186045417] [17592186401545 #edb/ref 1079 #uuid "fffbfe5a-e6b2-509f-a19b-67c3c7c49922" #edb/ref 17592186045417] [17592186401546 #edb/ref 1080 "An elliptic cone centered at $(-2,0,-1)$" #edb/ref 17592186045417] [17592186401546 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186401546 #edb/ref 1083 #uuid "f1243d3b-361e-5bdf-975f-049a3ec6fa01" #edb/ref 17592186045417] [17592186401547 #edb/ref