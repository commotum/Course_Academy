#{[{:db/id #edb/ref 17592186124214 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186124651 :knowledge-point/id #uuid "9840265f-02bf-58fa-94fd-77fb970af297" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders"}] :question/id #uuid "58055e3d-a903-5b8d-8d65-241cfc118218" :question/math-academy-id "e-12559" :question/problem "Identify the surface $z -1 = \\dfrac{(x-3)^2}{4} - \\dfrac{(y+2)^2}4.$" :question/worked-solution "Recall that the equation of a hyperbolic paraboloid centered at $O$ is given by\n\n$$\nz = \\dfrac{x^2}{a^2}-\\dfrac{y^2}{b^2},\n$$\n\nand a hyperbolic paraboloid centered at $(x_0,y_0,z_0)$ is given by\n\n$$\nz - z_0 = \\dfrac{(x-x_0)^2}{a^2}-\\dfrac{(y-y_0)^2}{b^2}.\n$$\n\nThus, our equation is a hyperbolic paraboloid with the following parameters:\n\n$$\n(x_0,y_0,z_0) = (3, -2, 1), \\quad a= b=2.\n$$"}] [{:db/id #edb/ref 17592186124215 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186124652 :knowledge-point/id #uuid "89fbf42b-d171-5772-87ce-cf622b720963" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders With Alternative Orientations"}] :question/id #uuid "badbbddb-cfe9-589c-becd-d863b061ac6f" :question/math-academy-id "e-12560" :question/problem "Identify the surface $x = \\dfrac{y^2}{4} - 4z^2.$" :question/worked-solution "Recall that the equation of a hyperbolic paraboloid centered at $O$ whose axis of symmetry is the $z$-axis is given by\n\n$$\nz = \\dfrac{x^2}{a^2}-\\dfrac{y^2}{b^2}.\n$$\n\nThus, a hyperbolic paraboloid centered at $O$ whose axis of symmetry is the $\\boldsymbol x$**-axis** is given by\n\n$$\nx = \\dfrac{y^2}{b^2} - \\dfrac{z^2}{c^2}.\n$$\n\nTherefore, our equation is a hyperbolic paraboloid whose axis of symmetry is the $x$-axis, and $b=2, \\: c=\\dfrac 12.$"}] [{:db/id #edb/ref 17592186124409 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186124597 :knowledge-point/id #uuid "549870ce-a18a-5a94-a9ea-f3de72aaac1f" :knowledge-point/title "Identifying Quadric Surfaces by Completing the Square"}] :question/id #uuid "50223d8d-b31c-5895-ab0b-178258fea716" :question/math-academy-id "e-8313" :question/problem "Identify the surface $-x^2 + z^2 + 2x + y=0.$" :question/worked-solution "First, we complete the square in the $x$ term:\n\n$$\n\\begin{aligned}-{x}^{2}+{z}^{2}+2x+y & =0 \\\\ -({x}^{2}-2x)+{z}^{2}+y & =0 \\\\ -(x-1)^{2}+1+{z}^{2}+y & =0\\end{aligned}\n$$\n\nNow, by rearranging, we get the equation\n\n$$\n\\begin{aligned}-(x-1)^{2}+1+{z}^{2}+y & =0 \\\\ -(x-1)^{2}+{z}^{2} & =-y-1 \\\\ (x-1)^{2}-{z}^{2} & =y+1.\\end{aligned}\n$$\n\nThis is the equation of a hyperbolic paraboloid centered at $(1, -1, 0).$"}] [{:db/id #edb/ref 17592186124830 :knowledge-point/_questions [{:db/id #edb/ref 17592186124651 :knowledge-point/id #uuid "9840265f-02bf-58fa-94fd-77fb970af297" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a2ddb42c-5afe-5e50-9b5e-9c1de812259c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cone" :db/id #edb/ref 17592186121578} {:answer/id #uuid "b7c5a220-fea4-57c2-9414-a76d3ffa67c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic paraboloid" :db/id #edb/ref 17592186121579} {:answer/id #uuid "b85f2e0a-10bc-57d5-85db-9dc98c6f8015" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid" :db/id #edb/ref 17592186121580} {:answer/id #uuid "c73ab1e2-c41c-597f-a984-0cce63425073" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbolic cylinder" :db/id #edb/ref 17592186121581} {:answer/id #uuid "4fc4e76d-5522-5d38-97ed-5b95c3888b82" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An ellipsoid" :db/id #edb/ref 17592186121582}] :answer-field/id #uuid "44e7345c-4fe4-58a9-bde2-b1c792e317a3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186121577}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dbb45b0a-f118-5453-afa5-1b781b1e8005" :question/math-academy-id "q-164372" :question/problem "Identify the following surface:\n$(z - 1)^{2} = x^{2} + ((y - 2)^{2})/(4)$"}] [{:db/id #edb/ref 17592186401502 :knowledge-point/_questions [{:db/id #edb/ref 17592186124651 :knowledge-point/id #uuid "9840265f-02bf-58fa-94fd-77fb970af297" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "917478a6-9f85-5c2f-9abc-0e94e7aaed04" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets" :db/id #edb/ref 17592186401504} {:answer/id #uuid "1549a164-9e45-5667-87ff-e1b8a78bcfbb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cone" :db/id #edb/ref 17592186401505} {:answer/id #uuid "2993d1fe-f7db-55c9-8175-8657b7efaf2a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet" :db/id #edb/ref 17592186401506} {:answer/id #uuid "b72085af-190b-5b99-82c7-f2f831e98d50" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbolic cylinder" :db/id #edb/ref 17592186401507} {:answer/id #uuid "c6b6af54-c6f0-5204-a41b-545422423ddc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An ellipsoid" :db/id #edb/ref 17592186401508}] :answer-field/correct {:answer/id #uuid "917478a6-9f85-5c2f-9abc-0e94e7aaed04" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets" :db/id #edb/ref 17592186401504} :answer-field/id #uuid "25021911-f878-5c6e-8755-61db8e40936f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401503}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1cc40487-6e8d-55c3-bbc9-868108f22530" :question/math-academy-id "q-164476" :question/problem "Identify the following surface: \n\n$$\n\\frac{(x+1)^{2}}{3}+\\frac{{y}^{2}}{4}-(z-2)^{2}=-1\n$$" :question/worked-solution "Recall that the equation of a hyperboloid of two sheets centered at $O$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}-\\frac{{z}^{2}}{{c}^{2}}=-1,\n$$\n\nand a hyperboloid of two sheets centered at $({x}_{0},{y}_{0},{z}_{0})$ is given by\n\n$$\n\\frac{(x-{x}_{0})^{2}}{{a}^{2}}+\\frac{(y-{y}_{0})^{2}}{{b}^{2}}-\\frac{(z-{z}_{0})^{2}}{{c}^{2}}=-1,\n$$\n\nThus, our equation is a hyperboloid of two sheets with the following parameters:\n\n$$\n({x}_{0},{y}_{0},{z}_{0})=(-1,0,2),\\,a=\\sqrt{3},\\,b=2,\\,c=1.\n$$"}] [{:db/id #edb/ref 17592186401509 :knowledge-point/_questions [{:db/id #edb/ref 17592186124651 :knowledge-point/id #uuid "9840265f-02bf-58fa-94fd-77fb970af297" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a76405be-1788-5e72-94d6-117c29e7aadb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cone" :db/id #edb/ref 17592186401511} {:answer/id #uuid "f9d6b36f-0169-5c05-b658-232c406af7ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid" :db/id #edb/ref 17592186401512} {:answer/id #uuid "548a6000-5c46-5dd3-9714-417aaea346a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cylinder" :db/id #edb/ref 17592186401513} {:answer/id #uuid "d5e1f556-c2cb-575c-8407-5c88361da39e" :answer/type {:db/id #edb/ref 17592186045499 :db/ide