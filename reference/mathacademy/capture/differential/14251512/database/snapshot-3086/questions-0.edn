:answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cylinder" :db/id #edb/ref 17592186401520} {:answer/id #uuid "8f342e45-8c79-5472-a082-fe42127fb510" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid" :db/id #edb/ref 17592186401521} {:answer/id #uuid "6db8c8a8-71c1-5bf5-8418-3d407d9ca9f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbolic cylinder" :db/id #edb/ref 17592186401522}] :answer-field/correct {:answer/id #uuid "6db8c8a8-71c1-5bf5-8418-3d407d9ca9f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbolic cylinder" :db/id #edb/ref 17592186401522} :answer-field/id #uuid "4009320d-45e7-537c-bae9-47fb3fceb5ac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401517}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7a3947ec-3744-5af7-8ce2-1be319e6d154" :question/math-academy-id "q-164479" :question/problem "Identify the following surface: \n\n$$\n\\frac{{x}^{2}}{9}-\\frac{{y}^{2}}{16}=1,\\,-\\infty <z<\\infty .\n$$" :question/worked-solution "Recall that the equation of a hyperbolic cylinder, whose axis of symmetry is the $z$-axis, is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\nThus, our equation is a hyperbolic cylinder with $a=3,\\,b=4.$"}] [{:db/id #edb/ref 17592186284495 :knowledge-point/_questions [{:db/id #edb/ref 17592186124651 :knowledge-point/id #uuid "9840265f-02bf-58fa-94fd-77fb970af297" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06e3d4c7-4748-549f-968e-1806720f6660" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A parabolic cylinder" :db/id #edb/ref 17592186281752} {:answer/id #uuid "141ec499-62fb-5d2a-8a88-296753017639" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbolic cylinder" :db/id #edb/ref 17592186281879} {:answer/id #uuid "6a8149b0-d42c-5634-b1f5-380ab933b5b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A couple of incident planes" :db/id #edb/ref 17592186282603} {:answer/id #uuid "fa48e1fb-6ac1-5f03-92a3-446a3b3ac89b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cylinder" :db/id #edb/ref 17592186283877} {:answer/id #uuid "fcd54832-bcba-5665-ab44-3a8101fa5b85" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A paraboloid" :db/id #edb/ref 17592186283905}] :answer-field/correct {:answer/id #uuid "06e3d4c7-4748-549f-968e-1806720f6660" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A parabolic cylinder" :db/id #edb/ref 17592186281752} :answer-field/id #uuid "02b4879c-ee5a-5ff6-8d4f-9660c95c938d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186283937}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1c75c1ea-55b3-574e-8866-696724a9a0aa" :question/math-academy-id "q-164480" :question/problem "Identify the following surface:\n\n$$\n{x}^{2}=8y,\\,-\\infty <z<\\infty .\n$$" :question/worked-solution "Recall that the equation of a parabolic cylinder, whose axis is the $z$-axis, is given by\n\n$$\n{x}^{2}=4py.\n$$\n\nThus, our equation is a parabolic cylinder with $p=2.$"}] [{:db/id #edb/ref 17592186572185 :knowledge-point/_questions [{:db/id #edb/ref 17592186124652 :knowledge-point/id #uuid "89fbf42b-d171-5772-87ce-cf622b720963" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders With Alternative Orientations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11484c0a-6862-568a-998d-b190bffcf298" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cone whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186571569} {:answer/id #uuid "37d095c4-1954-539c-9e8c-23b2f57b10c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186571637} {:answer/id #uuid "7d5c6829-06b3-5d76-956e-16a1425ca2d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186571756} {:answer/id #uuid "9230d30e-7426-5f9c-8875-b2c2a3c7acac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic paraboloid whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186571796} {:answer/id #uuid "d3c13d35-d511-5a2a-860f-58bc0932b6f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cone whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186571918}] :answer-field/correct {:answer/id #uuid "7d5c6829-06b3-5d76-956e-16a1425ca2d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186571756} :answer-field/id #uuid "a4898bb5-0016-51ea-8187-300cb32c4e12" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572057}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dae52465-95e6-5f7d-bba9-49c42a3d03c8" :question/math-academy-id "q-164512" :question/problem "Identify the surface $x=\\frac{{y}^{2}}{8}-\\frac{{z}^{2}}{9}.$" :question/worked-solution "Recall that the equation of a hyperbolic paraboloid centered at $O$ whose axis of symmetry is the $z$-axis is given by\n\n$$\nz=\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}.\n$$\n\nThus, a hyperbolic paraboloid centered at $O$ whose axis of symmetry is the $x$**-axis** is given by\n\n$$\nx=\\frac{{y}^{2}}{{b}^{2}}-\\frac{{z}^{2}}{{c}^{2}}.\n$$\n\nTherefore, our equation is a hyperbolic paraboloid whose axis of symmetry is the $x$-axis and $b=2\\sqrt{2},\\,c=3.$"}] [{:db/id #edb/ref 17592186406708 :knowledge-point/_questions [{:db/id #edb/ref 17592186124652 :knowledge-point/id #uuid "89fbf42b-d171-5772-87ce-cf622b720963" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders With Alternative Orientations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c3ab956-770c-53a8-9eae-f40c61e6c769" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cone whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186406702} {:answer/id #uuid "3ecb645c-1e57-5c3b-b1b2-ed0e71e55fd5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic paraboloid whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186406703} {:answer/id #uuid "e04fe96a-a5e5-509f-b5fc-299d30d29c7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cone whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186406704} {:answer/id #uuid "ebb132bf-25ae-5df7-92f2-c8b762f82e71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic paraboloid whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186406705} {:answer/id #uuid "f356ea58-4f17-52df-9c6d-71add425ebf1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbolic cylinder whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186406706}] :answer-field/correct {:answer/id #uuid "e04fe96a-a5e5-509f-b5fc-299d30d29c7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cone whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186406704} :answer-field/id #uuid "c5993f8a-2816-578b-805e-be93a0d45e93" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186406707}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b09b4d78-7ddd-5094-835d-967fc1cbc732" :question/math-academy-id "q-164515" :question/problem "Identify the surface $\\frac{{y}^{2}}{5}=\\frac{{x}^{2}}{2}+\\frac{{z}^{2}}{2}.$" :question/worked-solution "Recall that the equation of an elliptic cone centered at $O$ whose axis of symmetry is the $z$-axis is given by\n\n$$\n\\frac{{z}^{2}}{{c}^{2}}=\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}.\n$$\n\nThus, an elliptic cone centered at $O$ whose axis of symmetry is the $y$**-axis** is given by\n\n$$\n\\frac{{y}^{2}}{{b}^{2}}=\\frac{{x}^{2}}{{a}^{2}}+\\frac{{z}^{2}}{{c}^{2}}.\n$$\n\nTherefore, our equation is an elliptic cone whose axis of symmetry is the $y$-axis and $b=\\sqrt{5},\\,a=c=\\sqrt{2}.$"}] [{:db/id #edb/ref 17592186284509 :knowledge-point/_questions [{:db/id #edb/ref 17592186124652 :knowledge-point/id #uuid "89fbf42b-d171-5772-87ce-cf622b720963" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders With Alternative Orientations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ed8708a-539b-5dc4-aeb2-fc6af330696d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbolic cylinder whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186281821} {:answer/id #uuid "6ce0758d-7294-5d05-b56c-13fc4f0f6385" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/valu