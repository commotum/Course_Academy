#{[{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186125648} :activity/id #uuid "128c541d-1422-5228-a02e-c5d080886a64" :activity/scope {:db/id #edb/ref 17592186050005 :topic/id #uuid "25b1fb2e-aa54-5955-88cd-263118f65faa" :topic/math-academy-id 1898} :activity/steps [{:db/id #edb/ref 17592186125536 :step/content {:db/id #edb/ref 17592186124597 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124409 :question/id #uuid "50223d8d-b31c-5895-ab0b-178258fea716" :question/math-academy-id "e-8313"} :knowledge-point/id #uuid "549870ce-a18a-5a94-a9ea-f3de72aaac1f" :knowledge-point/questions [{:db/id #edb/ref 17592186124833} {:db/id #edb/ref 17592186124947} {:db/id #edb/ref 17592186284511} {:db/id #edb/ref 17592186284512} {:db/id #edb/ref 17592186323754} {:db/id #edb/ref 17592186323755} {:db/id #edb/ref 17592186323841} {:db/id #edb/ref 17592186381348} {:db/id #edb/ref 17592186401544} {:db/id #edb/ref 17592186401551} {:db/id #edb/ref 17592186402488} {:db/id #edb/ref 17592186411870}] :knowledge-point/title "Identifying Quadric Surfaces by Completing the Square"} :step/id #uuid "c326de48-b43d-56d2-9c9e-007c179f58ec" :step/math-academy-id 31030} {:db/id #edb/ref 17592186125641 :step/content {:db/id #edb/ref 17592186124651 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124214 :question/id #uuid "58055e3d-a903-5b8d-8d65-241cfc118218" :question/math-academy-id "e-12559"} :knowledge-point/id #uuid "9840265f-02bf-58fa-94fd-77fb970af297" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048510} {:db/id #edb/ref 17592186048527} {:db/id #edb/ref 17592186049477} {:db/id #edb/ref 17592186050123} {:db/id #edb/ref 17592186050456}] :knowledge-point/questions [{:db/id #edb/ref 17592186124829} {:db/id #edb/ref 17592186124830} {:db/id #edb/ref 17592186284494} {:db/id #edb/ref 17592186284495} {:db/id #edb/ref 17592186284496} {:db/id #edb/ref 17592186372321} {:db/id #edb/ref 17592186381327} {:db/id #edb/ref 17592186401481} {:db/id #edb/ref 17592186401502} {:db/id #edb/ref 17592186401509} {:db/id #edb/ref 17592186401516} {:db/id #edb/ref 17592186401523} {:db/id #edb/ref 17592186499518} {:db/id #edb/ref 17592186508993} {:db/id #edb/ref 17592186508999} {:db/id #edb/ref 17592186512936}] :knowledge-point/title "Identifying Quadric Surfaces and Cylinders"} :step/id #uuid "c5b55480-9dcd-56e9-acf7-87ada2ec2005" :step/math-academy-id 45294 :step/next {:db/id #edb/ref 17592186125643}} {:db/id #edb/ref 17592186125642 :step/content {:db/id #edb/ref 17592186125883 :tutorial/content "A table showing the most common cylinders whose base curve is centered at the origin in the $xy$-plane is given below.\n\n| Surface | Equation | Image |\n| --- | --- | --- |\n| Elliptic Cylinder | $\\dfrac{x^2}{a^2}+\\dfrac{y^2}{b^2} = 1$ | ![](images/2b/2b8788f027b93593a025542face33546425b057d1eb3b8e18da26e7774f6ed20.png) |\n| Parabolic Cylinder | $x^2=4py$\n\n$y^2=4px$ | ![](images/d3/d3f31aae01222e6a63e5de185c5b9f5a8af5aed8a750c6bc230e20e9fd93871a.png) |\n| Hyperbolic Cylinder | $\\dfrac{x^2}{a^2}-\\dfrac{y^2}{b^2}=1$\n\n$\\dfrac{y^2}{b^2}-\\dfrac{x^2}{a^2}=1$ | ![](images/15/159bb67600e079d9943ba6f79fcc6e580e3718f822dce50620c2bb6d2d9b76c8.png) |\n\nSimilar to quadric surfaces:\n\n- We can generate cylinders with alternative orientation axes by describing a base curve in the $xz$-or $yz$-planes. \n\nFor example, the equation of an elliptic cylinder with its axis of symmetry along the $y$-axis is given by\n\n$$\n\\dfrac{x^2}{a^2} + \\dfrac{z^2}{c^2} = 1.\n$$\n\n- We can shift the center/vertex of the base curve in the usual way." :tutorial/id #uuid "41c3acb2-b2af-59b4-a6bb-3883e59406f4" :tutorial/math-academy-id 7843 :tutorial/title "A Table of Common Cylinders"} :step/id #uuid "b00e77f6-434b-5bca-9612-5405fa8cbcd1" :step/math-academy-id 45296 :step/next {:db/id #edb/ref 17592186125641}} {:db/id #edb/ref 17592186125643 :step/content {:db/id #edb/ref 17592186124652 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124215 :question/id #uuid "badbbddb-cfe9-589c-becd-d863b061ac6f" :question/math-academy-id "e-12560"} :knowledge-point/id #uuid "89fbf42b-d171-5772-87ce-cf622b720963" :knowledge-point/questions [{:db/id #edb/ref 17592186124831} {:db/id #edb/ref 17592186124832} {:db/id #edb/ref 17592186284497} {:db/id #edb/ref 17592186284498} {:db/id #edb/ref 17592186284500} {:db/id #edb/ref 17592186284501} {:db/id #edb/ref 17592186284502} {:db/id #edb/ref 17592186284509} {:db/id #edb/ref 17592186284510} {:db/id #edb/ref 17592186381334} {:db/id #edb/ref 17592186381341} {:db/id #edb/ref 17592186401530} {:db/id #edb/ref 17592186406708} {:db/id #edb/ref 17592186424291} {:db/id #edb/ref 17592186499521} {:db/id #edb/ref 17592186508945} {:db/id #edb/ref 17592186526061} {:db/id #edb/ref 17592186572185}] :knowledge-point/title "Identifying Quadric Surfaces and Cylinders With Alternative Orientations"} :step/id #uuid "45bf287e-52f8-5fe1-a4fe-73b8c92a2ec7" :step/math-academy-id 45300 :step/next {:db/id #edb/ref 17592186125536}} {:db/id #edb/ref 17592186125648 :step/content {:db/id #edb/ref 17592186125888 :tutorial/content "The most common quadric surfaces are those centered at the origin. We describe these common surfaces in the table below.\n\n| Surface | Equation | Image |\n| --- | --- | --- |\n| Ellipsoid | $\\dfrac{x^2}{a^2}+\\dfrac{y^2}{b^2}+\\dfrac{z^2}{c^2} = 1$ | ![](images/09/09dc100248a28a5518bcd8428368edefc7c3ee8d5ef0e50515cb7552ee54a376.png) |\n| Elliptic Paraboloid | $z = \\dfrac{x^2}{a^2}+\\dfrac{y^2}{b^2}$ | ![](images/76/76e4ad8cb1e83eadae4dce865e100c9a716f9830e7f12adb367b2a9b74d1a651.png) |\n| Hyperbolic Paraboloid | $z = \\dfrac{x^2}{a^2}-\\dfrac{y^2}{b^2}$ | ![](images/cb/cbc04d7f98e1bb7ce0d62eda71102a6abad708dfcedd7aabee8fff23281471dd.png) |\n| Hyperboloid of One Sheet | $\\dfrac{x^2}{a^2}+\\dfrac{y^2}{b^2}-\\dfrac{z^2}{c^2}=1$ | ![](images/df/df6ef914bc78e121d75baf9f5147784d0e6e434d76800eff60dcb3c3d764477c.png) |\n| Hyperboloid of Two Sheets | $\\dfrac{x^2}{a^2}+\\dfrac{y^2}{b^2}-\\dfrac{z^2}{c^2}=-1$ | ![](images/08/0870b95c5ce1133d6645e3063174157e36c4354df370c05e48218111ea714838.png) |\n| Elliptic Cone | $\\dfrac{z^2}{c^2}=\\dfrac{x^2}{a^2}+\\dfrac{y^2}{b^2}$ | ![](images/0f/0f492bf07e573ec7858977e48fa4bf81635e61520b5caa9edef14bd259184347.png) |\n\nAlso, recall the following from previous lessons:\n\n- We can generate paraboloids, hyperboloids, and cones with alternative orientation axes by permuting the variables in the corresponding equation. \n\nFor example, the equation of an elliptic cone with its vertex at $O$ and axis of symmetry along the $y$-axis is given by\n\n$$\n\\dfrac{y^2}{b^2} = \\dfrac{x^2}{a^2} + \\dfrac{z^2}{c^2}.\n$$\n\n- We can shift the center/vertex/saddle point of a quadric surface to $(x_0,y_0,z_0)$ using the usual coordinate transformation:\n\n$$\n(x,y,z) \\longrightarrow (x-x_0,y-y_0,z-z_0)\n$$\n\nFinally, there is a simple way to distinguish between hyperboloids with one and two sheets by simply looking at the equations:\n\n- *one* minus sign indicates hyperboloids of *one* sheet:\n\n$$\n\\dfrac{x^2}{a^2}+\\dfrac{y^2}{b^2} \\bbox[3pt,Gainsboro]{\\color{red}-} \\dfrac{z^2}{c^2}=1\n$$\n\n- *two* minus signs indicate hyperboloids of *two* sheets:\n\n$$\n\\dfrac{x^2}{a^2}+\\dfrac{y^2}{b^2} \\bbox[3pt,Gainsboro]{\\color{red}-} \\dfrac{z^2}{c^2}= \\bbox[3pt,Gainsboro]{\\color{red}-}1\n$$" :tutorial/id #uuid "e806c3d0-0e3e-584e-93eb-1406ac607ad3" :tutorial/math-academy-id 7860 :tutorial/title "Introduction"} :step/id #uuid "7440cca3-653a-5d59-a5d4-2b047f4c7357" :step/math-academy-id 45333 :step/next {:db/id #edb/ref 17592186125642}}] :activity/title "Identifying Quadric Surfaces" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186124700}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186406711} :activity/id #uuid "75844770-2009-58f0-837f-3b53539c54cc" :activity/scope {:db/id #edb/ref 17592186050005 :topic/id #uuid "25b1fb2e-aa54-5955-88cd-263118f65faa" :topic/math-academy-id 1898} :activity/steps [{:db/id #edb/ref 17592186406709 :step/content {:db/id #edb/ref 17592186284510 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "232f26c9-79a9-5402-b0f7-63e58ec7851c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A parabolic cylinder whose axis is the $x$-axis" :db/id #edb/ref 17592186282000} {:answer/id #uuid "7c568ec1-5072-5178-846a-7f2b606d9954" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A couple of planes" :db/id #edb/ref 17592186282761} {:answer/id #uuid "9283fa33-e3d9-51e6-a60b-d84331b8323d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An elliptic cylinder whose axis is the $x$-axis" :db/id #edb/ref 17592186282952} {:answer/id #uuid "ce57cf6e-a823-5536-bf65-94a57901af34" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An elliptic cylinder whose axis is the $y$-axis" :db/id #edb/ref 17592186283492} {:answer/id #uuid "eefd41c3-ba1b-5b3d-8bc1-3c2122e2528a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A parabolic cylinder whose axis is the $y$-axis" :db/id #edb/ref 17592186283772}] :answer-field/correct {:db/id #edb/ref 17592186282000} :answer-field/id #uuid "05d7e5ed-5266-504a-b7eb-960c915d96ad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186283943}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "fe349944-268d-5340-92ca-d28764061da5" :question/math-academy-id "q-164548" :question/problem "Identify the following surface:\n\n$$\n{z}^{2}=-12y,\\,-\\infty <x<\\infty .\n$$" :question/worked-solution "Recall that the equation of a parabolic cylinder whose axis is the $z$-axis is given by\n\n$$\n{x}^{2}=4py.\n$$\n\nThus, a parabolic cylinder whose axis is the $x$**-axis** is given by\n\n$$\n{z}^{2}=4py.\n$$\n\nTherefore, our equation is a parabolic cylinder whose axis is the $x$-axis and $p=-3.$"} :step/id #uuid "51825ebc-a150-59a7-947c-57e352dcf16a" :step/next {:db/id #edb/ref 17592186406710}} {:db/id #edb/ref 17592186406710 :step/content {:db/id #edb/ref 17592186284511 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10cde161-28f6-55e5-986b-ad9855da614a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperbolic paraboloid centered at $(-1,2,3)$" :db/id #edb/ref 17592186281844} {:answer/id #uuid "122b7f1a-d06c-5752-b881-d3aaf0a1f656" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperbolic paraboloid centered at $(1,-2,3)$" :db/id #edb/ref 17592186281863} {:answer/id #uuid "49873a52-1e06-5d10-9048-c31a56b3f6fa" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An ellipsoid centered at $(1,2,-3)$" :db/id #edb/ref 17592186282313} {:answer/id #uuid "ca420948-0b66-53de-bd82-72e7dc4965ff" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperbolic paraboloid centered at $(1,2,-3)$" :db/id #edb/ref 17592186283457} {:answer/id #uuid "d9275452-1c1f-54aa-9f44-b0b79feef1b1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An elliptic paraboloid centered at $(1,2,-3)$" :db/id #edb/ref 17592186283580}] :answer-field/correct {:db/id #edb/ref 17592186283457} :answer-field/id #uuid "fd434c9b-d384-57dd-8332-85e7b5ec2000" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186284382}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1b66372b-0da7-5bff-8ad5-ecdf16f5fac5" :question/math-academy-id "q-164549" :question/problem "Identify the surface ${y}^{2}-{z}^{2}-x-4y-6z-4=0.$" :question/worked-solution "First, we complete the square in the $y$ and $z$ terms:\n\n$$\n\\begin{aligned}{y}^{2}-{z}^{2}-x-4y-6z-4 & =0 \\\\ ({y}^{2}-4y)-({z}^{2}+6z)-x-4 & =0 \\\\ (y-2)^{2}-4-(z+3)^{2}+9-x-4 & =0 \\\\ (y-2)^{2}-(z+3)^{2}+1-x & =0\\end{aligned}\n$$\n\nNow, by rearranging, we get the equation\n\n$$\n\\begin{aligned}(y-2)^{2}-(z+3)^{2}+1-x & =0 \\\\ (y-2)^{2}-(z+3)^{2} & =x-1\\end{aligned}\n$$\n\nThis is the equation of a hyperbolic paraboloid centered at $(1,2,-3).$"} :step/id #uuid "665f3a47-aeb6-5a7d-a9e0-03a57d44f9e3"} {:db/id #edb/ref 17592186406711 :step/content {:db/id #edb/ref 17592186406708 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c3ab956-770c-53a8-9eae-f40c61e6c769" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An elliptic cone whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186406702} {:answer/id #uuid "3ecb645c-1e57-5c3b-b1b2-ed0e71e55fd5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An elliptic paraboloid whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186406703} {:answer/id #uuid "e04fe96a-a5e5-509f-b5fc-299d30d29c7c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An elliptic cone whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186406704} {:answer/id #uuid "ebb132bf-25ae-5df7-92f2-c8b762f82e71" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An elliptic paraboloid whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186406705} {:answer/id #uuid "f356ea58-4f17-52df-9c6d-71add425ebf1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperbolic cylinder whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186406706}] :answer-field/correct {:db/id #edb/ref 17592186406704} :answer-field/id #uuid "c5993f8a-2816-578b-805e-be93a0d45e93" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186406707}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b09b4d78-7ddd-5094-835d-967fc1cbc732" :question/math-academy-id "q-164515" :question/problem "Identify the surface $\\frac{{y}^{2}}{5}=\\frac{{x}^{2}}{2}+\\frac{{z}^{2}}{2}.$" :question/worked-solution "Recall that the equation of an elliptic cone centered at $O$ whose axis of symmetry is the $z$-axis is given by\n\n$$\n\\frac{{z}^{2}}{{c}^{2}}=\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}.\n$$\n\nThus, an elliptic cone centered at $O$ whose axis of symmetry is the $y$**-axis** is given by\n\n$$\n\\frac{{y}^{2}}{{b}^{2}}=\\frac{{x}^{2}}{{a}^{2}}+\\frac{{z}^{2}}{{c}^{2}}.\n$$\n\nTherefore, our equation is an elliptic cone whose axis of symmetry is the $y$-axis and $b=\\sqrt{5},\\,a=c=\\sqrt{2}.$"} :step/id #uuid "ab2c596e-de3a-5f30-b94c-c0be5480593a" :step/next {:db/id #edb/ref 17592186406709}}] :activity/title "Identifying Quadric Surfaces" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186406701}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186424293} :activity/id #uuid "fc978768-ab3a-5ac5-8530-659f75bf3bf6" :activity/scope {:db/id #edb/ref 17592186050005 :topic/id #uuid "25b1fb2e-aa54-5955-88cd-263118f65faa" :topic/math-academy-id 1898} :activity/steps [{:db/id #edb/ref 17592186424292 :step/content {:db/id #edb/ref 17592186401544 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f1243d3b-361e-5bdf-975f-049a3ec6fa01" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An elliptic cone centered at $(-2,0,-1)$" :db/id #edb/ref 17592186401546} {:answer/id #uuid "fa487f89-3be7-5d40-961d-7546309e11de" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An elliptic cone centered at $(-2,0,1)$" :db/id #edb/ref 17592186401547} {:answer/id #uuid "025044f2-a8e8-56c9-abcc-e56e1609a263" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid of two sheet centered at $(-2,0,1)$" :db/id #edb/ref 17592186401548} {:answer/id #uuid "1c63b753-83a9-5faf-9522-2b10200701ec" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid of one sheet centered at $(-2,0,1)$" :db/id #edb/ref 17592186401549} {:answer/id #uuid "a76c934a-6a50-5b6b-97fe-08774387e03f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An elliptic cone centered at $(-2,1,1)$" :db/id #edb/ref 17592186401550}] :answer-field/correct {:db/id #edb/ref 17592186401547} :answer-field/id #uuid "fffbfe5a-e6b2-509f-a19b-67c3c7c49922" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186401545}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "040e9acf-1af9-5813-86f6-e469cb0eecc9" :question/math-academy-id "q-164553" :question/problem "Identify the surface $5{x}^{2}-{y}^{2}-5{z}^{2}+20x+10z+15=0.$" :question/worked-solution "First, we complete the square in the $x$ and $z$ terms:\n\n$$\n\\begin{aligned}5{x}^{2}-{y}^{2}-5{z}^{2}+20x+10z+15 & =0 \\\\ 5({x}^{2}+4x)-{y}^{2}-5({z}^{2}-2z)+15 & =0 \\\\ 5[(x+2)^{2}-4]-{y}^{2}-5[(z-1)^{2}-1]+15 & =0 \\\\ 5(x+2)^{2}-20-{y}^{2}-5(z-1)^{2}+5+15 & =0 \\\\ 5(x+2)^{2}-{y}^{2}-5(z-1)^{2} & =0 \\\\ -5(x+2)^{2}+{y}^{2}+5(z-1)^{2} & =0\\end{aligned}\n$$\n\nThis is the equation of an elliptic cone centered at $(-2,0,1).$"} :step/id #uuid "2cc6ab31-f267-588e-ac94-b20d067888cf"} {:db/id #edb/ref 17592186424293 :step/content {:db/id #edb/ref 17592186402488 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "adf28e93-9856-5b88-a118-c7fdc1ed380b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperbolic paraboloid centered at $(-1,0,1)$" :db/id #edb/ref 17592186402490} {:answer/id #uuid "d6d90baa-2f68-5b86-bc0d-0f5ed5239cce" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An elliptic paraboloid centered at $(-1,1,0)$" :db/id #edb/ref 17592186402491} {:answer/id #uuid "09418836-8d85-5969-8422-a7c16a4c010f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An elliptic paraboloid centered at $(1,-1,0)$" :db/id #edb/ref 17592186402492} {:answer/id #uuid "2604ccf1-dbcb-5550-afc6-5a2d18ea1503" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperbolic paraboloid centered at $(1,-1,0)$" :db/id #edb/ref 17592186402493} {:answer/id #uuid "13ce61ca-12c4-556e-a368-7a6ff53f5341" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An elliptic cone centered at $(1,-1,0)$" :db/id #edb/ref 17592186402494}] :answer-field/correct {:db/id #edb/ref 17592186402492} :answer-field/id #uuid "c51d387c-bf0a-5c35-97a8-9dc15337e4ac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186402489}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e6d1bbdf-cfcb-54f3-b97f-c63787cc6751" :question/math-academy-id "q-36107" :question/problem "Identify the surface $4{y}^{2}+8y+9{z}^{2}-5x+9=0.$" :question/worked-solution "First, we complete the square in the $y$ term:\n\n$$\n\\begin{aligned}4{y}^{2}+8y+9{z}^{2}-5x+9 & =0 \\\\ 4({y}^{2}+2y)+9{z}^{2}-5x+9 & =0 \\\\ 4[(y+1)^{2}-1]+9{z}^{2}-5x+9 & =0 \\\\ 4(y+1)^{2}-4+9{z}^{2}-5x+9 & =0 \\\\ 4(y+1)^{2}+9{z}^{2}-5x+5 & =0\\end{aligned}\n$$\n\nNow, by rearranging, we get the equation\n\n$$\n\\begin{aligned}4(y+1)^{2}+9{z}^{2}-5x+5 & =0 \\\\ 4(y+1)^{2}+9{z}^{2} & =5(x-1) \\\\ \\frac{4(y+1)^{2}}{5}+\\frac{9{z}^{2}}{5} & =x-1.\\end{aligned}\n$$\n\nThis is the equation of an elliptic paraboloid centered at $(1,-1,0).$"} :step/id #uuid "54314abe-e612-59a7-a227-fbd2c4097e85" :step/next {:db/id #edb/ref 17592186424296}} {:db/id #edb/ref 17592186424294 :step/content {:db/id #edb/ref 17592186284509 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ed8708a-539b-5dc4-aeb2-fc6af330696d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperbolic cylinder whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186281821} {:answer/id #uuid "6ce0758d-7294-5d05-b56c-13fc4f0f6385" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An elliptic cylinder whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186282621} {:answer/id #uuid "6f9f9c26-5c32-5a2c-84d7-43b1c3ee806b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An elliptic cylinder whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186282643} {:answer/id #uuid "af7f7724-53c4-5017-aa18-cddcab68aba1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperbolic cylinder whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186283204} {:answer/id #uuid "fab7a9b7-07be-5a7b-a93a-2fed20308834" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An elliptic cone whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186283882}] :answer-field/correct {:db/id #edb/ref 17592186283204} :answer-field/id #uuid "5a71416d-3a97-52be-8397-a3db5f2cce08" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186284084}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8f6408ec-2d9a-573b-91f2-4270763372c3" :question/math-academy-id "q-164543" :question/problem "Identify the following surface:\n\n$$\n4{y}^{2}-3{z}^{2}=1,\\,-\\infty <x<\\infty .\n$$" :question/worked-solution "Recall that the equation of a hyperbolic cylinder whose axis of symmetry is the $z$-axis is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\nThus, a hyperbolic cylinder whose axis of symmetry is the $x$**-axis** is given by\n\n$$\n\\frac{{y}^{2}}{{b}^{2}}-\\frac{{z}^{2}}{{c}^{2}}=1.\n$$\n\nTherefore, our equation is a hyperbolic cylinder whose axis of symmetry is the $x$-axis and $b=\\frac{1}{2},\\,c=\\frac{1}{\\sqrt{3}}.$"} :step/id #uuid "64df74d6-150b-5917-893e-904bb776c807" :step/next {:db/id #edb/ref 17592186424292}} {:db/id #edb/ref 17592186424295 :step/content {:db/id #edb/ref 17592186284502 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ec10b85-158a-537f-8f3b-7e461f364450" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperbolic cylinder whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186282102} {:answer/id #uuid "312d414b-5db9-57e9-84e6-360219089048" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An elliptic cylinder whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186282130} {:answer/id #uuid "95cd6ae2-2d5d-52f3-aec7-fe144815e805" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An elliptic cylinder whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186282982} {:answer/id #uuid "9ba9cfde-201a-5af6-befd-71848e48b210" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperbolic cylinder whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186283049} {:answer/id #uuid "d9f6b844-3abd-5b20-a453-cdc1c62602dc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperbolic paraboloid whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186283590}] :answer-field/correct {:db/id #edb/ref 17592186282130} :answer-field/id #uuid "89171ada-3e2f-5819-a223-5db3a30c8df0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186284171}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "555cf7a1-a40b-509e-b58a-e7cfea474b5b" :question/math-academy-id "q-164516" :question/problem "Identify the following surface: \n\n$$\n{y}^{2}+{z}^{2}=1,\\,-\\infty <x<\\infty .\n$$" :question/worked-solution "Recall that the equation of an elliptic cylinder whose axis of symmetry is the $z$-axis is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\nThus, an elliptic cylinder whose axis of symmetry is the $x$**-axis** is given by\n\n$$\n\\frac{{y}^{2}}{{b}^{2}}+\\frac{{z}^{2}}{{c}^{2}}=1.\n$$\n\nTherefore, our equation is an elliptic cylinder whose axis of symmetry is the $x$-axis and $b=c=1.$"} :step/id #uuid "78787bfc-f256-56d0-9ef3-d379e5e6b14c" :step/next {:db/id #edb/ref 17592186424294}} {:db/id #edb/ref 17592186424296 :step/content {:db/id #edb/ref 17592186424291 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "504a831f-3e0c-5d06-a8d1-be9b4ba80039" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperbolic paraboloid whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186424285} {:answer/id #uuid "58c388d4-2855-5447-9674-2cb26cd08e75" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An elliptic cone whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186424286} {:answer/id #uuid "6b38cf9a-4a51-5286-8901-945e5c525367" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid of two sheets whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186424287} {:answer/id #uuid "c5cf1042-b2aa-561a-8222-86a9a28715cb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperbolic paraboloid whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186424288} {:answer/id #uuid "d23fdde4-ee5e-5374-a3f3-a99631c545b8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid of two sheets whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186424289}] :answer-field/correct {:db/id #edb/ref 17592186424289} :answer-field/id #uuid "1dd15534-4a61-5493-b4d2-d4158ff665f2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186424290}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2369f308-07c0-5960-a63e-ec69f7d6d0c6" :question/math-academy-id "q-164509" :question/problem "Identify the surface $\\frac{{x}^{2}}{4}-\\frac{{y}^{2}}{4}+{z}^{2}=-1.$" :question/worked-solution "Recall that the equation of a hyperboloid of two sheets centered at $O$ whose axis of symmetry is the $z$-axis is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}-\\frac{{z}^{2}}{{c}^{2}}=-1.\n$$\n\nThus, a hyperboloid of two sheets centered at $O$ whose axis of symmetry is the $y$**-axis** is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}+\\frac{{z}^{2}}{{c}^{2}}=-1.\n$$\n\nTherefore, our equation is a hyperboloid of two sheets whose axis of symmetry is the $y$-axis and $a=b=2,\\,c=1.$"} :step/id #uuid "950b38d2-130e-590e-bac3-c7658b8a7f74" :step/next {:db/id #edb/ref 17592186424295}}] :activity/title "Identifying Quadric Surfaces" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186424284}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186499589} :activity/id #uuid "36149860-d4ac-5977-bb67-7aa72386654c" :activity/scope {:db/id #edb/ref 17592186050005 :topic/id #uuid "25b1fb2e-aa54-5955-88cd-263118f65faa" :topic/math-academy-id 1898} :activity/steps [{:db/id #edb/ref 17592186499575 :step/content {:db/id #edb/ref 17592186499518 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "021522e8-a9df-59e6-b84b-91834f2968d3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A cylinder" :db/id #edb/ref 17592186498735} {:answer/id #uuid "1c777e07-effa-5159-bdca-6498cfc63f89" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A paraboloid" :db/id #edb/ref 17592186498790} {:answer/id #uuid "a63234ad-3ec9-5fca-ae38-85b9a41f3dfa" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An ellipsoid" :db/id #edb/ref 17592186499093} {:answer/id #uuid "d7b37c1b-e271-50f4-b1c0-d70da4980e40" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid of two sheets" :db/id #edb/ref 17592186499213} {:answer/id #uuid "fa72b501-4cb3-5f6c-8dfe-1efa05d79c7d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid of one sheet" :db/id #edb/ref 17592186499291}] :answer-field/correct {:db/id #edb/ref 17592186499093} :answer-field/id #uuid "ea6e680c-b0bb-5dbd-a194-b67f3d2e815c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186499419}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a43bb9df-6cd4-59cd-9e78-40afc4cecca9" :question/math-academy-id "q-164396" :question/problem "Identify the surface $4{x}^{2}+\\frac{{y}^{2}}{9}+{z}^{2}=1.$" :question/worked-solution "Recall that the equation of an ellipsoid centered at $O$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}+\\frac{{z}^{2}}{{c}^{2}}=1.\n$$\n\nThus, our equation is an ellipsoid with $a=\\frac{1}{2},\\,b=3,\\,c=1.$"} :step/id #uuid "2899eb8d-728e-5caa-a932-24666f3bf8fd" :step/next {:db/id #edb/ref 17592186499604}} {:db/id #edb/ref 17592186499589 :step/content {:db/id #edb/ref 17592186323754 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e2cc085-a59d-56dd-81bb-d07371a2a8a7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid of two sheets centered at $(1,0,5)$" :db/id #edb/ref 17592186321763} {:answer/id #uuid "9f341fa3-f683-52a6-b968-2e33e82139a1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid of two sheets centered at $(-2,0,1)$" :db/id #edb/ref 17592186322401} {:answer/id #uuid "a2aefb17-f02a-54e5-8595-b45603b4b42b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An elliptic cone centered at $(-2,0,1)$" :db/id #edb/ref 17592186322431} {:answer/id #uuid "e4541fbb-55e3-509e-9780-1f3f16ce74e6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid of one sheet centered at $(-2,0,1)$" :db/id #edb/ref 17592186322935} {:answer/id #uuid "f0ba0df8-5f49-5933-bd23-7a1a9d327e7f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid of one sheet centered at $(2,0,-1)$" :db/id #edb/ref 17592186323041}] :answer-field/correct {:db/id #edb/ref 17592186322401} :answer-field/id #uuid "3aeb3d56-ad05-5134-a623-f1ab028e5a1a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186323285}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e8b7d35e-9f56-5494-bc85-89ac721410ae" :question/math-academy-id "q-36110" :question/problem "Identify the surface $4{x}^{2}+{y}^{2}-25{z}^{2}+16x+50z+91=0.$" :question/worked-solution "First, we complete the square in the $x$ and $z$ terms:\n\n$$\n\\begin{aligned}4{x}^{2}+{y}^{2}-25{z}^{2}+16x+50z+91 & =0 \\\\ 4({x}^{2}+4x)+{y}^{2}-25({z}^{2}-2z)+91 & =0 \\\\ 4[(x+2)^{2}-4]+{y}^{2}-25[(z-1)^{2}-1]+91 & =0 \\\\ 4(x+2)^{2}-16+{y}^{2}-25(z-1)^{2}+25+91 & =0 \\\\ 4(x+2)^{2}+{y}^{2}-25(z-1)^{2}+100 & =0\\end{aligned}\n$$\n\nNow, by rearranging, we get the equation\n\n$$\n\\begin{aligned}4(x+2)^{2}+{y}^{2}-25(z-1)^{2}+100 & =0 \\\\ 4(x+2)^{2}+{y}^{2}-25(z-1)^{2} & =-100 \\\\ \\frac{(x+2)^{2}}{25}+\\frac{{y}^{2}}{100}-\\frac{(z-1)^{2}}{4} & =-1.\\end{aligned}\n$$\n\nThis is the equation of a hyperboloid of two sheets centered at $(-2,0,1).$"} :step/id #uuid "5c548eb8-9df3-51c7-a5ac-8d8c6f9aee14" :step/next {:db/id #edb/ref 17592186499599}} {:db/id #edb/ref 17592186499599 :step/content {:db/id #edb/ref 17592186323841 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "085048d0-926b-5cca-8dfa-e564cb57a41d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid of one sheet centered at $(1,1,0)$" :db/id #edb/ref 17592186321212} {:answer/id #uuid "59e40a15-5394-58c4-b924-308e77435252" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A ellipsoid centered at $(1,1,0)$" :db/id #edb/ref 17592186321857} {:answer/id #uuid "8b3ddbd9-4ea0-5b22-a0c5-e552e87f5792" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid of two sheets centered at $(-1,-1,0)$" :db/id #edb/ref 17592186322257} {:answer/id #uuid "9970b56a-c70b-5b74-8a21-fe6b144df410" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid of one sheet centered at $(1,-1,0)$" :db/id #edb/ref 17592186322366} {:answer/id #uuid "d89ab1f0-2498-5ec5-92c0-660bf25388b7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid of two sheets centered at $(1,1,0)$" :db/id #edb/ref 17592186322844}] :answer-field/correct {:db/id #edb/ref 17592186322844} :answer-field/id #uuid "0ddf6d6f-5de6-54dd-86ec-e6eca647c352" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186323193}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9efad2cb-65ec-5d4c-8ad1-c965cc267177" :question/math-academy-id "q-36666" :question/problem "Identify the surface $6{x}^{2}-4{y}^{2}-6{z}^{2}-12x+8y-10=0.$" :question/worked-solution "First, we complete the square in the $x$ and $y$ terms:\n\n$$\n\\begin{aligned}6{x}^{2}-4{y}^{2}-6{z}^{2}-12x+8y-10 & =0 \\\\ 6({x}^{2}-2x)-4({y}^{2}-2y)-6{z}^{2}-10 & =0 \\\\ 6[(x-1)^{2}-1]-4[(y-1)^{2}-1]-6{z}^{2}-10 & =0 \\\\ 6(x-1)^{2}-6-4(y-1)^{2}+4-6{z}^{2}-10 & =0 \\\\ 6(x-1)^{2}-4(y-1)^{2}-6{z}^{2}-12 & =0\\end{aligned}\n$$\n\nNow, by rearranging, we get the equation\n\n$$\n\\begin{aligned}6(x-1)^{2}-4(y-1)^{2}-6{z}^{2}-12 & =0 \\\\ 6(x-1)^{2}-4(y-1)^{2}-6{z}^{2} & =12 \\\\ \\frac{(x-1)^{2}}{2}-\\frac{(y-1)^{2}}{3}-\\frac{{z}^{2}}{2} & =1 \\\\ \\frac{(y-1)^{2}}{3}+\\frac{{z}^{2}}{2}-\\frac{(x-1)^{2}}{2} & =-1.\\end{aligned}\n$$\n\nThis is the equation of a hyperboloid of two sheets centered at $(1,1,0).$"} :step/id #uuid "89ae8bd8-6821-50c2-ae85-b282e63cacb4" :step/next {:db/id #edb/ref 17592186499601}} {:db/id #edb/ref 17592186499601 :step/content {:db/id #edb/ref 17592186124831 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34a585bb-74c5-510e-a245-f4082f4c3979" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An elliptic cone whose axis of symmetry is the $x$-axis." :db/id #edb/ref 17592186282158} {:answer/id #uuid "44a458c1-9084-54b2-b8ff-98063908189d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid of one sheet whose axis of symmetry is the $z$-axis" :db/id #edb/ref 17592186282270} {:answer/id #uuid "b1022887-6bfe-52a6-a0a8-8e1ab06354d9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid of two sheets whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186283222} {:answer/id #uuid "b3c4e925-9bac-5dc9-a77e-70b58c292a9e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid of two sheets whose axis of symmetry is the $z$-axis" :db/id #edb/ref 17592186283248} {:answer/id #uuid "cc208067-f320-5874-a23a-5da28c9ea960" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid of one sheet whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186283473}] :answer-field/correct {:db/id #edb/ref 17592186283473} :answer-field/id #uuid "d3fd279c-bf2c-5eeb-b5e8-70142503f169" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186284303}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a4c96dde-6df8-575b-bdd9-f49e9283853d" :question/math-academy-id "q-164373" :question/problem "Identify the surface ${z}^{2}+{y}^{2}-{x}^{2}=1.$" :question/worked-solution "Recall that the equation of a hyperboloid of one sheet centered at $O$ whose axis of symmetry is the $z$-axis is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}-\\frac{{z}^{2}}{{c}^{2}}=-1.\n$$\n\nThus, a hyperboloid of one sheet centered at $O$ whose axis of symmetry is the $x$**-axis** is given by\n\n$$\n-\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}+\\frac{{z}^{2}}{{c}^{2}}=-1.\n$$\n\nTherefore, our equation is a hyperboloid of one sheet whose axis of symmetry is the $x$-axis and $a=b=c=1.$"} :step/id #uuid "922bfb7c-f62a-573a-8240-5f30e75ef4b9" :step/next {:db/id #edb/ref 17592186499575}} {:db/id #edb/ref 17592186499604 :step/content {:db/id #edb/ref 17592186499521 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "389ea0f9-8a1f-5cb1-ad91-524b12efbd32" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An elliptic cone whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186498854} {:answer/id #uuid "6ff2e8e7-86f1-53c7-b6c0-8eaa30d0d9e8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperbolic paraboloid whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186498980} {:answer/id #uuid "750ac996-47c9-5708-8786-361c28fa8bcb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperbolic paraboloid whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186498989} {:answer/id #uuid "c9c9013c-3150-59d3-828f-685becb59007" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid with one sheet whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186499171} {:answer/id #uuid "df499b4c-c6a3-5ad4-a3fc-438688b9685f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid with one sheet whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186499227}] :answer-field/correct {:db/id #edb/ref 17592186498980} :answer-field/id #uuid "ef272bc8-d53b-5b80-88af-a0c05c5cfeb7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186499423}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "aac5719a-7a14-5fc9-ab07-f4320aad4083" :question/math-academy-id "q-164513" :question/problem "Identify the surface $y={x}^{2}-\\frac{{z}^{2}}{4}.$" :question/worked-solution "Recall that the equation of a hyperbolic paraboloid centered at $O$ whose axis of symmetry is the $z$-axis is given by\n\n$$\nz=\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}.\n$$\n\nThus, a hyperbolic paraboloid centered at $O$ whose axis of symmetry is the $y$**-axis** is given by\n\n$$\ny=\\frac{{x}^{2}}{{a}^{2}}-\\frac{{z}^{2}}{{c}^{2}}.\n$$\n\nTherefore, our equation is a hyperbolic paraboloid whose axis of symmetry is the $y$-axis and $a=1,\\,c=2.$"} :step/id #uuid "98a0cfb3-88e2-53f4-9c05-0b0a0c14511d"}] :activity/title "Identifying Quadric Surfaces" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186498719}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186512971} :activity/id #uuid "f9ebf790-6022-5a93-b998-ec0444d26510" :activity/scope {:db/id #edb/ref 17592186050005 :topic/id #uuid "25b1fb2e-aa54-5955-88cd-263118f65faa" :topic/math-academy-id 1898} :activity/steps [{:db/id #edb/ref 17592186512969 :step/content {:db/id #edb/ref 17592186124831 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34a585bb-74c5-510e-a245-f4082f4c3979" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An elliptic cone whose axis of symmetry is the $x$-axis." :db/id #edb/ref 17592186282158} {:answer/id #uuid "44a458c1-9084-54b2-b8ff-98063908189d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid of one sheet whose axis of symmetry is the $z$-axis" :db/id #edb/ref 17592186282270} {:answer/id #uuid "b1022887-6bfe-52a6-a0a8-8e1ab06354d9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid of two sheets whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186283222} {:answer/id #uuid "b3c4e925-9bac-5dc9-a77e-70b58c292a9e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid of two sheets whose axis of symmetry is the $z$-axis" :db/id #edb/ref 17592186283248} {:answer/id #uuid "cc208067-f320-5874-a23a-5da28c9ea960" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid of one sheet whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186283473}] :answer-field/correct {:db/id #edb/ref 17592186283473} :answer-field/id #uuid "d3fd279c-bf2c-5eeb-b5e8-70142503f169" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186284303}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a4c96dde-6df8-575b-bdd9-f49e9283853d" :question/math-academy-id "q-164373" :question/problem "Identify the surface ${z}^{2}+{y}^{2}-{x}^{2}=1.$" :question/worked-solution "Recall that the equation of a hyperboloid of one sheet centered at $O$ whose axis of symmetry is the $z$-axis is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}-\\frac{{z}^{2}}{{c}^{2}}=-1.\n$$\n\nThus, a hyperboloid of one sheet centered at $O$ whose axis of symmetry is the $x$**-axis** is given by\n\n$$\n-\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}+\\frac{{z}^{2}}{{c}^{2}}=-1.\n$$\n\nTherefore, our equation is a hyperboloid of one sheet whose axis of symmetry is the $x$-axis and $a=b=c=1.$"} :step/id #uuid "271e1473-cf3a-502d-8643-f9fbecb2a725" :step/next {:db/id #edb/ref 17592186513007}} {:db/id #edb/ref 17592186512971 :step/content {:db/id #edb/ref 17592186323755 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b28e9b1-a006-5803-ab0b-9ba3ba019bd9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperbolic paraboloid centered at $(0,-2,1)$" :db/id #edb/ref 17592186321601} {:answer/id #uuid "5325c83c-39e2-53ea-83b5-5254ced19457" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An elliptic cone centered at $(0,-2,1)$" :db/id #edb/ref 17592186321802} {:answer/id #uuid "d23a03a3-c7b0-5c4e-911b-d7b37bbb5bdf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An elliptic paraboloid centered at $(0,-2,1)$" :db/id #edb/ref 17592186322789} {:answer/id #uuid "d78d5857-c3ff-5e46-b0d0-174bb7dd79a9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An elliptic cone centered at $(1,-2,0)$" :db/id #edb/ref 17592186322830} {:answer/id #uuid "da030a33-c2a6-5772-8783-4eccde66ee7d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An elliptic paraboloid centered at $(1,-2,0)$" :db/id #edb/ref 17592186322854}] :answer-field/correct {:db/id #edb/ref 17592186322789} :answer-field/id #uuid "09f76668-5d4a-50c5-b668-d9e2e9822722" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186323187}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "76019938-2501-5ea7-9720-1dd685a8604d" :question/math-academy-id "q-36111" :question/problem "Identify the surface ${x}^{2}+3{y}^{2}+12y-z+13=0.$" :question/worked-solution "First, we complete the square in the $y$ term:\n\n$$\n\\begin{aligned}{x}^{2}+3{y}^{2}+12y-z+13 & =0 \\\\ {x}^{2}+3({y}^{2}+4y)-z+13 & =0 \\\\ {x}^{2}+3[(y+2)^{2}-4]-z+13 & =0 \\\\ {x}^{2}+3(y+2)^{2}-12-z+13 & =0 \\\\ {x}^{2}+3(y+2)^{2}-z+1 & =0\\end{aligned}\n$$\n\nNow, by rearranging, we get the equation\n\n$$\n\\begin{aligned}{x}^{2}+3(y+2)^{2}-z+1 & =0 \\\\ {x}^{2}+3(y+2)^{2} & =z-1.\\end{aligned}\n$$\n\nThis is the equation of an elliptic paraboloid centered at $(0,-2,1).$"} :step/id #uuid "284d8b01-2f97-5ebe-9ab6-41f17bf5767e" :step/next {:db/id #edb/ref 17592186512969}} {:db/id #edb/ref 17592186512986 :step/content {:db/id #edb/ref 17592186284500 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cd6eaa8-586c-5103-b0cc-92a8aaaf1a7e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An elliptic cone whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186281807} {:answer/id #uuid "2556d713-7643-5e10-b347-3ff594c56f13" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An elliptic paraboloid whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186282014} {:answer/id #uuid "2b318cd8-3045-5788-9bb8-ab1134992947" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperbolic paraboloid whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186282069} {:answer/id #uuid "56d2cf8c-c2ea-5087-9d96-d9a6dcd9d5dd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An elliptic paraboloid whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186282426} {:answer/id #uuid "eafb0571-17a8-5784-a800-513c70030f56" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperbolic paraboloid whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186283743}] :answer-field/correct {:db/id #edb/ref 17592186282014} :answer-field/id #uuid "09284adb-1272-5cf4-81c3-aa20d058b0a0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186283949}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e28adc4e-c42a-55a7-ab38-db39626f07cf" :question/math-academy-id "q-164510" :question/problem "Identify the surface $x=\\frac{{y}^{2}}{2}+\\frac{{z}^{2}}{4}.$" :question/worked-solution "Recall that the equation of an elliptic paraboloid centered at $O$ whose axis of symmetry is the $z$-axis is given by\n\n$$\nz=\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}.\n$$\n\nThus, an elliptic paraboloid centered at $O$ whose axis of symmetry is the $x$**-axis** is given by\n\n$$\nx=\\frac{{y}^{2}}{{b}^{2}}+\\frac{{z}^{2}}{{c}^{2}}.\n$$\n\nTherefore, our equation is an elliptic paraboloid whose axis of symmetry is the $x$-axis and $b=\\sqrt{2},\\,c=2.$"} :step/id #uuid "55aa02b0-039f-58cd-ae44-5767ea8c3cbb" :step/next {:db/id #edb/ref 17592186513027}} {:db/id #edb/ref 17592186513007 :step/content {:db/id #edb/ref 17592186512936 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56ef26e6-92c5-5ea5-b133-22f7b64a33e2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An elliptic paraboloid" :db/id #edb/ref 17592186512296} {:answer/id #uuid "68d13e64-6b65-563f-999b-e9e60dd96c22" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperbolic paraboloid" :db/id #edb/ref 17592186512352} {:answer/id #uuid "95e635ba-07ae-51b7-9591-773690c09952" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An elliptic cone" :db/id #edb/ref 17592186512452} {:answer/id #uuid "dcb21376-02e4-57eb-9eae-d7276dc0e580" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid of two sheets" :db/id #edb/ref 17592186512626} {:answer/id #uuid "de32f43e-77ab-55e0-8416-a6838959b401" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid of one sheet" :db/id #edb/ref 17592186512633}] :answer-field/correct {:db/id #edb/ref 17592186512296} :answer-field/id #uuid "f79d7671-2b5b-530a-ae16-c53529846a84" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186512859}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c44a3fc0-0b84-5773-98c9-aa672df4ee82" :question/math-academy-id "q-164407" :question/problem "Identify the following surface: \n\n$$\nz=1+(x-1)^{2}+\\frac{(y-2)^{2}}{9}\n$$" :question/worked-solution "Recall that the equation of an elliptic paraboloid centered at $O$ is given by\n\n$$\nz=\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}},\n$$\n\nand an elliptic paraboloid centered at $({x}_{0},{y}_{0},{z}_{0})$ is given by\n\n$$\nz-{z}_{0}=\\frac{(x-{x}_{0})^{2}}{{a}^{2}}+\\frac{(y-{y}_{0})^{2}}{{b}^{2}},\n$$\n\nThus, our equation is an elliptic paraboloid with the following parameters:\n\n$$\n({x}_{0},{y}_{0},{z}_{0})=(1,2,1),\\,a=1,\\,b=3.\n$$"} :step/id #uuid "9a570ba4-3fc5-59c3-8513-ce917bdc7167" :step/next {:db/id #edb/ref 17592186512986}} {:db/id #edb/ref 17592186513027 :step/content {:db/id #edb/ref 17592186381348 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d4b7f14-8321-55e3-8547-b5e4dcca9e51" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid of one sheet centered at $(-1,0,1)$" :db/id #edb/ref 17592186381350} {:answer/id #uuid "28f36501-dfe4-5bae-a8dc-97c146169521" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid of one sheet centered at $(-1,0,-1)$" :db/id #edb/ref 17592186381351} {:answer/id #uuid "67877beb-bf36-58d4-8b66-f851c5c4483f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid of two sheet centered at $(1,0,-1)$" :db/id #edb/ref 17592186381352} {:answer/id #uuid "2bf53fd3-9386-5a4c-a79f-f3a6af4d6a45" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A ellipsoid centered at $(-1,0,1)$" :db/id #edb/ref 17592186381353} {:answer/id #uuid "0e9ad2a9-9bf4-5355-ae68-2624b7e68903" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid of two sheets centered at $(-1,0,1)$" :db/id #edb/ref 17592186381354}] :answer-field/correct {:db/id #edb/ref 17592186381350} :answer-field/id #uuid "e941d950-316e-5e7e-8eb1-513344452c65" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186381349}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0ee70413-f7e5-5d0a-806c-10db20253a9c" :question/math-academy-id "q-164551" :question/problem "Identify the surface $2{x}^{2}+{y}^{2}-4{z}^{2}+4x+8z-10=0.$" :question/worked-solution "First, we complete the square in the $x$ and $z$ terms:\n\n$$\n\\begin{aligned}2{x}^{2}+{y}^{2}-4{z}^{2}+4x+8z-10 & =0 \\\\ 2({x}^{2}+2x)+{y}^{2}-4({z}^{2}-2z)-10 & =0 \\\\ 2[(x+1)^{2}-1]+{y}^{2}-4[(z-1)^{2}-1]-10 & =0 \\\\ 2(x+1)^{2}-2+{y}^{2}-4(z-1)^{2}+4-10 & =0 \\\\ 2(x+1)^{2}+{y}^{2}-4(z-1)^{2}-8 & =0\\end{aligned}\n$$\n\nNow, by rearranging, we get the equation\n\n$$\n\\begin{aligned}2(x+1)^{2}+{y}^{2}-4(z-1)^{2}-8 & =0 \\\\ 2(x+1)^{2}+{y}^{2}-4(z-1)^{2} & =8 \\\\ \\frac{(x+1)^{2}}{4}+\\frac{{y}^{2}}{8}-\\frac{(z-1)^{2}}{2} & =1.\\end{aligned}\n$$\n\nThis is the equation of a hyperboloid of one sheet centered at $(-1,0,1).$"} :step/id #uuid "f6db678b-c89a-5ef1-8eab-c2e37f3bbe22"}] :activity/title "Identifying Quadric Surfaces" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186512094}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186526138} :activity/id #uuid "96566b5d-67e5-5dbc-b09c-a6f3c4571522" :activity/scope {:db/id #edb/ref 17592186050005 :topic/id #uuid "25b1fb2e-aa54-5955-88cd-263118f65faa" :topic/math-academy-id 1898} :activity/steps [{:db/id #edb/ref 17592186526111 :step/content {:db/id #edb/ref 17592186411870 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0171cec4-3060-54fe-b331-7b0cb56feb0e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An elliptic cone centered at $(-3,0,1)$" :db/id #edb/ref 17592186411682} {:answer/id #uuid "383f6ed0-5fb4-59d2-b70a-efaec189d129" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid of two sheets centered at $(3,0,-1)$" :db/id #edb/ref 17592186411708} {:answer/id #uuid "5618185e-e1f3-562e-9bda-391291612de3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An elliptic cone centered at $(3,0,-1)$" :db/id #edb/ref 17592186411724} {:answer/id #uuid "7b843362-d96d-5169-8747-167de74eaed4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid of one sheet centered at $(3,0,-1)$" :db/id #edb/ref 17592186411743} {:answer/id #uuid "ebb80510-3271-536a-ba4e-07dbc48d8ccc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An elliptic cone centered at $(3,4,1)$" :db/id #edb/ref 17592186411810}] :answer-field/correct {:db/id #edb/ref 17592186411724} :answer-field/id #uuid "dcd694e5-15ab-54db-83e7-909825ce1c4f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186411846}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b34cb85d-113c-5f8c-bb3f-86df801d970e" :question/math-academy-id "q-164552" :question/problem "Identify the surface ${x}^{2}+4{y}^{2}-{z}^{2}-6x-2z+8=0.$" :question/worked-solution "First, we complete the square in the $x$ and $z$ terms:\n\n$$\n\\begin{aligned}{x}^{2}+4{y}^{2}-{z}^{2}-6x-2z+8 & =0 \\\\ ({x}^{2}-6x)+4{y}^{2}-({z}^{2}+2z)+8 & =0 \\\\ (x-3)^{2}-9+4{y}^{2}-(z+1)^{2}+1+8 & =0 \\\\ (x-3)^{2}+4{y}^{2}-(z+1)^{2} & =0\\end{aligned}\n$$\n\nThis is the equation of an elliptic cone centered at $(3,0,-1).$"} :step/id #uuid "2818d7eb-9015-51f2-a283-63090dd5892c"} {:db/id #edb/ref 17592186526112 :step/content {:db/id #edb/ref 17592186284494 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03dda863-9cba-5ac7-b163-95b61c7a3ee5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An elliptic paraboloid" :db/id #edb/ref 17592186281725} {:answer/id #uuid "16d5551d-3d24-5dac-b97c-bc7e162ca09e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid of one sheet" :db/id #edb/ref 17592186281901} {:answer/id #uuid "5d9a7237-f69d-50a6-b871-d9b1e6e46923" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A sphere" :db/id #edb/ref 17592186282482} {:answer/id #uuid "d3260eaa-d1a9-5a45-9f05-0463b59bbd09" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperboloid of two sheets" :db/id #edb/ref 17592186283532} {:answer/id #uuid "e932d761-78b0-531a-aa87-9ee121dc8267" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An ellipsoid" :db/id #edb/ref 17592186283724}] :answer-field/correct {:db/id #edb/ref 17592186281901} :answer-field/id #uuid "bceab84c-9b8c-5f9d-b3b9-e91d20b3f572" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186284271}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d1da5d09-9bba-571b-a103-055c209c6aeb" :question/math-academy-id "q-164474" :question/problem "Identify the following surface: \n\n$$\n(x+1)^{2}+(y-3)^{2}-(z-1)^{2}=1\n$$" :question/worked-solution "Recall that the equation of a hyperboloid of one sheet centered at $O$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}-\\frac{{z}^{2}}{{c}^{2}}=1,\n$$\n\nand a hyperboloid of one sheet centered at $({x}_{0},{y}_{0},{z}_{0})$ is given by\n\n$$\n\\frac{(x-{x}_{0})^{2}}{{a}^{2}}+\\frac{(y-{y}_{0})^{2}}{{b}^{2}}-\\frac{(z-{z}_{0})^{2}}{{c}^{2}}=1,\n$$\n\nThus, our equation is a hyperboloid of one sheet with the following parameters:\n\n$$\n({x}_{0},{y}_{0},{z}_{0})=(-1,3,1),\\,a=b=c=1.\n$$"} :step/id #uuid "320adc8c-5d60-58a7-ab61-8934e7131f77" :step/next {:db/id #edb/ref 17592186526127}} {:db/id #edb/ref 17592186526115 :step/content {:db/id #edb/ref 17592186401530 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ed669204-c56c-5225-aefc-956037ae0d37" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperbolic cylinder whose axis is the $x$-axis" :db/id #edb/ref 17592186401532} {:answer/id #uuid "359f70ba-f3cf-563a-9d19-52e3ff5fe27b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A parabolic cylinder whose axis is the $x$-axis" :db/id #edb/ref 17592186401533} {:answer/id #uuid "d5285b0d-7ee4-5490-8561-775dea047606" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A parabolic cylinder whose axis is the $y$-axis" :db/id #edb/ref 17592186401534} {:answer/id #uuid "74313148-6534-5531-9101-2416622ea616" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An elliptic cone whose axis is the $z$-axis" :db/id #edb/ref 17592186401535} {:answer/id #uuid "d9ce9479-a493-554f-88d6-f3b32cbf67e2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperbolic cylinder whose axis is the $y$-axis" :db/id #edb/ref 17592186401536}] :answer-field/correct {:db/id #edb/ref 17592186401533} :answer-field/id #uuid "fa665e14-2670-50c6-9aa4-6148466ac38d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186401531}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "50443007-c819-5285-a74f-1d6dfd323e6d" :question/math-academy-id "q-164547" :question/problem "Identify the following surface:\n\n$$\n{y}^{2}=2z,\\,-\\infty <x<\\infty .\n$$" :question/worked-solution "Recall that the equation of a parabolic cylinder whose axis is the $z$-axis is given by\n\n$$\n{x}^{2}=4py.\n$$\n\nThus, a parabolic cylinder whose axis is the $x$**-axis** is given by\n\n$$\n{y}^{2}=4pz.\n$$\n\nTherefore, our equation is a parabolic cylinder whose axis is the $x$-axis and $p=\\frac{1}{2}.$"} :step/id #uuid "4601a680-89df-54f2-bdc4-1c4b070f88c7" :step/next {:db/id #edb/ref 17592186526111}} {:db/id #edb/ref 17592186526127 :step/content {:db/id #edb/ref 17592186526061 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07bd3b87-098d-5e30-a48a-957d181fe801" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperbolic cylinder whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186525225} {:answer/id #uuid "808fb0d1-ad78-599b-a391-fdb1b7f250e7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A parabolic cylinder whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186525525} {:answer/id #uuid "94aa8e1e-3d28-56ee-a76e-79962ce8e0f1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An elliptic cylinder whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186525586} {:answer/id #uuid "c4e1ed92-617d-591d-bdac-7bb8438832c9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperbolic cylinder whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186525703} {:answer/id #uuid "e902d22d-f1d2-5a47-a1f3-96b7c83228b7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An elliptic cylinder whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186525783}] :answer-field/correct {:db/id #edb/ref 17592186525225} :answer-field/id #uuid "cccec8b5-48b7-5ec4-baff-35f1a5f70872" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186525944}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a09c6c30-99d7-5001-884d-f495ecae121d" :question/math-academy-id "q-164542" :question/problem "Identify the following surface:\n\n$$\n{x}^{2}-\\frac{{z}^{2}}{5}=1,\\,-\\infty <y<\\infty .\n$$" :question/worked-solution "Recall that the equation of a hyperbolic cylinder whose axis of symmetry is the $z$-axis is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\nThus, a hyperbolic cylinder whose axis of symmetry is the $y$**-axis** is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}-\\frac{{z}^{2}}{{c}^{2}}=1.\n$$\n\nTherefore, our equation is a hyperbolic cylinder whose axis of symmetry is the $y$-axis and $a=1,\\,c=\\sqrt{5}.$"} :step/id #uuid "7fc70a2d-f29b-5e57-9850-feb1b1995bed" :step/next {:db/id #edb/ref 17592186526115}} {:db/id #edb/ref 17592186526138 :step/content {:db/id #edb/ref 17592186402488 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "adf28e93-9856-5b88-a118-c7fdc1ed380b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperbolic paraboloid centered at $(-1,0,1)$" :db/id #edb/ref 17592186402490} {:answer/id #uuid "d6d90baa-2f68-5b86-bc0d-0f5ed5239cce" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An elliptic paraboloid centered at $(-1,1,0)$" :db/id #edb/ref 17592186402491} {:answer/id #uuid "09418836-8d85-5969-8422-a7c16a4c010f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An elliptic paraboloid centered at $(1,-1,0)$" :db/id #edb/ref 17592186402492} {:answer/id #uuid "2604ccf1-dbcb-5550-afc6-5a2d18ea1503" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperbolic paraboloid centered at $(1,-1,0)$" :db/id #edb/ref 17592186402493} {:answer/id #uuid "13ce61ca-12c4-556e-a368-7a6ff53f5341" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An elliptic cone centered at $(1,-1,0)$" :db/id #edb/ref 17592186402494}] :answer-field/correct {:db/id #edb/ref 17592186402492} :answer-field/id #uuid "c51d387c-bf0a-5c35-97a8-9dc15337e4ac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186402489}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e6d1bbdf-cfcb-54f3-b97f-c63787cc6751" :question/math-academy-id "q-36107" :question/problem "Identify the surface $4{y}^{2}+8y+9{z}^{2}-5x+9=0.$" :question/worked-solution "First, we complete the square in the $y$ term:\n\n$$\n\\begin{aligned}4{y}^{2}+8y+9{z}^{2}-5x+9 & =0 \\\\ 4({y}^{2}+2y)+9{z}^{2}-5x+9 & =0 \\\\ 4[(y+1)^{2}-1]+9{z}^{2}-5x+9 & =0 \\\\ 4(y+1)^{2}-4+9{z}^{2}-5x+9 & =0 \\\\ 4(y+1)^{2}+9{z}^{2}-5x+5 & =0\\end{aligned}\n$$\n\nNow, by rearranging, we get the equation\n\n$$\n\\begin{aligned}4(y+1)^{2}+9{z}^{2}-5x+5 & =0 \\\\ 4(y+1)^{2}+9{z}^{2} & =5(x-1) \\\\ \\frac{4(y+1)^{2}}{5}+\\frac{9{z}^{2}}{5} & =x-1.\\end{aligned}\n$$\n\nThis is the equation of an elliptic paraboloid centered at $(1,-1,0).$"} :step/id #uuid "aca7698a-292b-55cf-a330-3f07aa2e8df2" :step/next {:db/id #edb/ref 17592186526112}}] :activity/title "Identifying Quadric Surfaces" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186525203}]}
