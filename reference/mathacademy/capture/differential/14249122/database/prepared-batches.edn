5373e9f" :answer-field/choices "answer-46294241-6d76-5660-8308-b704b82c7087"] ["question-151c9aa4-1f7d-5ae4-bc54-fb829989618a" :question/answer-fields "answer-field-02a5f76b-f604-59fe-97b6-05e2a5373e9f"] [17592186198274 :knowledge-point/questions "question-151c9aa4-1f7d-5ae4-bc54-fb829989618a"] ["activity-b6e9d445-0ba2-5cbc-973a-1de35aa7f2c5" :activity/id #uuid "b6e9d445-0ba2-5cbc-973a-1de35aa7f2c5"] ["step-8b7cd465-a531-5b2c-aa31-225a1dbba8b6" :step/id #uuid "8b7cd465-a531-5b2c-aa31-225a1dbba8b6"] ["step-40115689-6ef7-5297-b4cc-659f1af4234d" :step/id #uuid "40115689-6ef7-5297-b4cc-659f1af4234d"] ["step-929b7ead-827c-5b82-82c3-38ca98ce721d" :step/id #uuid "929b7ead-827c-5b82-82c3-38ca98ce721d"] ["step-9b20313e-470b-5bfd-bcdb-18795605d3de" :step/id #uuid "9b20313e-470b-5bfd-bcdb-18795605d3de"] ["step-25a9e4f2-d080-581c-9f8c-5e235244e694" :step/id #uuid "25a9e4f2-d080-581c-9f8c-5e235244e694"] ["step-8b7cd465-a531-5b2c-aa31-225a1dbba8b6" :step/content 17592186198717] ["step-8b7cd465-a531-5b2c-aa31-225a1dbba8b6" :step/next "step-40115689-6ef7-5297-b4cc-659f1af4234d"] ["step-40115689-6ef7-5297-b4cc-659f1af4234d" :step/content "question-e159fb00-748b-54e2-99d5-3850d85771a3"] ["step-40115689-6ef7-5297-b4cc-659f1af4234d" :step/next "step-929b7ead-827c-5b82-82c3-38ca98ce721d"] ["step-929b7ead-827c-5b82-82c3-38ca98ce721d" :step/content 17592186287775] ["step-929b7ead-827c-5b82-82c3-38ca98ce721d" :step/next "step-9b20313e-470b-5bfd-bcdb-18795605d3de"] ["step-9b20313e-470b-5bfd-bcdb-18795605d3de" :step/content "question-025f0441-54cd-515d-9989-fed405f3f4cc"] ["step-9b20313e-470b-5bfd-bcdb-18795605d3de" :step/next "step-25a9e4f2-d080-581c-9f8c-5e235244e694"] ["step-25a9e4f2-d080-581c-9f8c-5e235244e694" :step/content "question-151c9aa4-1f7d-5ae4-bc54-fb829989618a"] ["activity-b6e9d445-0ba2-5cbc-973a-1de35aa7f2c5" :activity/title "Visualizing Cartesian Products"] ["activity-b6e9d445-0ba2-5cbc-973a-1de35aa7f2c5" :activity/type :activity.type/review] ["activity-b6e9d445-0ba2-5cbc-973a-1de35aa7f2c5" :activity/scope 17592186048206] ["activity-b6e9d445-0ba2-5cbc-973a-1de35aa7f2c5" :activity/course 17592186046658] ["activity-b6e9d445-0ba2-5cbc-973a-1de35aa7f2c5" :activity/steps "step-8b7cd465-a531-5b2c-aa31-225a1dbba8b6"] ["activity-b6e9d445-0ba2-5cbc-973a-1de35aa7f2c5" :activity/steps "step-40115689-6ef7-5297-b4cc-659f1af4234d"] ["activity-b6e9d445-0ba2-5cbc-973a-1de35aa7f2c5" :activity/steps "step-929b7ead-827c-5b82-82c3-38ca98ce721d"] ["activity-b6e9d445-0ba2-5cbc-973a-1de35aa7f2c5" :activity/steps "step-9b20313e-470b-5bfd-bcdb-18795605d3de"] ["activity-b6e9d445-0ba2-5cbc-973a-1de35aa7f2c5" :activity/steps "step-25a9e4f2-d080-581c-9f8c-5e235244e694"] ["activity-b6e9d445-0ba2-5cbc-973a-1de35aa7f2c5" :activity/first-step "step-8b7cd465-a531-5b2c-aa31-225a1dbba8b6"]] "retractions" [[17592186287775 :question/problem "Which of the following is a representation of the set $S=[0,2]\\times {-1,0,1}$ in the Cartesian plane?"] [17592186287775 :question/worked-solution "The Cartesian product $A\\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\n$$\nA\\times B={(a,b)\\,:\\,a\\in A,\\,b\\in B}\n$$\n\nIn this case, the set \n\n$$\nS=[0,2]\\times {-1,0,1}\n$$\n\ncontains every point in ${R}^{2}$ whose $x$-coordinate is any real number in the interval $[0,2]$ and whose $y$-coordinate is either $-1,0,$ or $1.$\n\n$$\nS={(x,y)\\,:\\,x\\in [0,2],\\,y\\in {-1,0,1}}.\n$$\n\nTo visualize $S$, consider ${S}_{1}⊂S$ containing all points whose $x$-coordinate is any real number in the interval $[0,2]$ and whose $y$-coordinate equals $-1$\n\n$$\n{S}_{1}={(x,-1)\\,:\\,x\\in [0,2]}\n$$\n\nThis set is represented by the line segment shown below.\n\n![](images/de/de9bd6dc79cabf8230b0cec26233958aa0fbb001875b9942cbb7f4d36e6b08fb.png)\n\nNext, consider ${S}_{2}⊂S$ containing all points whose $x$-coordinate is any real number in the interval $[0,2]$ and whose $y$-coordinate equals $0.$\n\n$$\n{S}_{2}={(x,0)\\,:\\,x\\in [0,2]}.\n$$\n\nThis set is represented by the line segment shown below.\n\n![](images/81/819c31e4d29dbd3e18c7dea8df495a565d2ede866ec019c764704d6dc47f5c70.png)\n\nNow, consider ${S}_{3}⊂S$ containing all points whose $x$-coordinate is any real number in the interval $[0,2]$ and whose $y$-coordinate equals $1.$\n\n$$\n{S}_{3}={(x,1)\\,:\\,x\\in [0,2]}.\n$$\n\nThis set is represented by the line segment shown below.\n\n![](images/3f/3f335df98dc9cb33ccc96f87d24efa3bd78a4d4c271d0fbaf7ae5e8c30916d9e.png)\n\nOur Cartesian product is the *union* of these subsets:\n\n$$\nS={S}_{1}\\cup {S}_{2}\\cup {S}_{3}\n$$\n\nTherefore, $S$ can be represented by the three line segments shown below.\n\n![](images/a1/a1a9065f9dbb6648100bc6a22bff367916c241dc2eba5f3878d6cf1b9821d4e8.png)"]]}]