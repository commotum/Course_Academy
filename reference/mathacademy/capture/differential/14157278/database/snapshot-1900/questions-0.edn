#{[{:db/id #edb/ref 17592186105478 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105701 :knowledge-point/id #uuid "7c9317eb-d1ce-5f42-b69b-a37e643b865b" :knowledge-point/title "Calculating a Vector Projection Using Angle and Magnitude"}] :question/id #uuid "3278333b-a29e-54c5-bc94-b5525bc6f751" :question/math-academy-id "e-14617" :question/problem "Suppose that $|\\,\\mathbf{a}\\,|=8,|\\,\\mathbf{b}\\,|=4$ and that the angle between the vectors is $\\theta = \\dfrac{5\\pi}{6}.$ Find the vector projection of $\\mathbf{a}$ onto $\\mathbf{b}$ in terms of the vector $\\mathbf{b}.$" :question/worked-solution "First, we find the scalar projection as follows:\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =|\\,a\\,|\\operatorname{cos}⁡\\theta  \\\\  & =8\\operatorname{cos}⁡(\\frac{5\\pi }{6}) \\\\  & =8\\cdot (-\\frac{\\sqrt{3}}{2}) \\\\  & =-4\\sqrt{3}\\end{aligned}\n$$\n\nNow, we find the unit vector that is parallel to $\\mathbf{b}\\mathbin{:}$\n\n$$\n\\mathbf{u} = \\dfrac{\\mathbf{b}}{|\\,\\mathbf{b}\\,|} = \\dfrac{\\mathbf{b}}{4} = \\dfrac{1}{4} \\mathbf{b}\n$$\n\nFinally, we compute the vector projection as follows:\n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,a & ={\\text{comp}}_{b}\\,a\\cdot u \\\\  & =-4\\sqrt{3}\\cdot \\frac{1}{4}b \\\\  & =-\\sqrt{3}b\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186105479 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105702 :knowledge-point/id #uuid "c0670172-77cb-5e88-b78d-e5136c06095f" :knowledge-point/title "Calculating a Vector Projection Using Components"}] :question/id #uuid "58b2269d-f998-5ba5-9df8-54ea422c43aa" :question/math-academy-id "e-14618" :question/problem "Let $\\mathbf{a}=\\langle 1,-3,5 \\rangle$ and $\\mathbf{b}=\\langle 5,-4,0 \\rangle$. Find the vector projection of $\\mathbf{a}$ onto $\\mathbf{b}$." :question/worked-solution "Using the formula for the vector projection, we obtain\n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,a & =\\frac{a\\cdot b}{b\\cdot b}b \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}b \\\\  & =\\frac{1\\cdot 5+(-3)\\cdot (-4)+5\\cdot 0}{{5}^{2}+(-4)^{2}+{0}^{2}}b \\\\  & =\\frac{17}{41}⟨5,-4,0⟩ \\\\  & =⟨\\frac{85}{41},-\\frac{68}{41},0⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186105480 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105703 :knowledge-point/id #uuid "84c96375-27d5-5ada-a952-34e09b3e92bf" :knowledge-point/title "Perpendicular Vectors"}] :question/id #uuid "663f3f5e-56cf-5517-ba1e-d1a355767e0b" :question/math-academy-id "e-14619" :question/problem "Let ![](images/98/984a6c85f7337efcad03af6e6b7af44340243770ade690e383c286154ca9024c.svg) and ![](images/82/825255386c414868f28d139cdc3e50a2b8252fc0c6ad09de579119092afadb9c.svg). Find the vector projection of $\\mathbf{a}$ onto $\\mathbf{b}$." :question/worked-solution "Using the formula for the vector projection, we obtain\n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,a & =\\frac{a\\cdot b}{b\\cdot b}b \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}b \\\\  & =\\frac{1\\cdot 1+0\\cdot 5+1\\cdot (-1)}{{1}^{2}+{5}^{2}+(-1)^{2}}b \\\\  & =\\frac{0}{{1}^{2}+{5}^{2}+(-1)^{2}}b \\\\  & =⟨0,0,0⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186237848 :knowledge-point/_questions [{:db/id #edb/ref 17592186105702 :knowledge-point/id #uuid "c0670172-77cb-5e88-b78d-e5136c06095f" :knowledge-point/title "Calculating a Vector Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b320351-bc5f-5d30-8e1b-115490175e6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,\\frac{2}{13},\\frac{3}{13}⟩" :db/id #edb/ref 17592186235874} {:answer/id #uuid "29861cc0-282e-55e8-bb73-6b1c84f3194b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,\\frac{2}{73},\\frac{3}{73}⟩" :db/id #edb/ref 17592186236077} {:answer/id #uuid "3aa6322d-6e21-5ba1-8a56-0d7256be7736" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,0,0⟩" :db/id #edb/ref 17592186236186} {:answer/id #uuid "7ec4107b-3b2f-5d39-9dc6-6d7a9eda213d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,\\frac{4}{13},\\frac{6}{13}⟩" :db/id #edb/ref 17592186236603} {:answer/id #uuid "88a89953-8437-5bb0-bfe1-f370c45a6462" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,\\frac{4}{73},\\frac{6}{73}⟩" :db/id #edb/ref 17592186236671}] :answer-field/correct {:answer/id #uuid "7ec4107b-3b2f-5d39-9dc6-6d7a9eda213d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,\\frac{4}{13},\\frac{6}{13}⟩" :db/id #edb/ref 17592186236603} :answer-field/id #uuid "6b5736ba-ea23-5e79-9cac-607c5a0cd1a0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237579}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9c17c0ad-57b9-5e4e-96cf-a2591d364b0a" :question/math-academy-id "q-101541" :question/problem "Let $a=[\\begin{aligned}9 \\\\ 7 \\\\ -4\\end{aligned}]$ and $b=[\\begin{aligned}0 \\\\ 2 \\\\ 3\\end{aligned}].$ Find the vector projection of $a$ onto $b.$" :question/worked-solution "Using the formula for the vector projection, we obtain \n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,a & =\\frac{a\\cdot b}{b\\cdot b}b \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}b \\\\  & =\\frac{9\\cdot 0+7\\cdot 2+(-4)\\cdot 3}{{0}^{2}+{2}^{2}+{3}^{2}}b \\\\  & =\\frac{2}{13}⟨0,2,3⟩ \\\\  & =⟨0,\\frac{4}{13},\\frac{6}{13}⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287937 :knowledge-point/_questions [{:db/id #edb/ref 17592186105702 :knowledge-point/id #uuid "c0670172-77cb-5e88-b78d-e5136c06095f" :knowledge-point/title "Calculating a Vector Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b553699-5a2a-55ea-a60a-4950dd9ea937" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-\\frac{7}{9},\\frac{2}{9},-\\frac{1}{9}⟩" :db/id #edb/ref 17592186285488} {:answer/id #uuid "6ac1aeed-3d56-5091-b3b9-4d438a865c4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,0,0⟩" :db/id #edb/ref 17592186285767} {:answer/id #uuid "99864ad9-d222-5dec-953f-0ff7b38374cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-\\frac{7}{54},\\frac{2}{9},-\\frac{1}{54}⟩" :db/id #edb/ref 17592186286194} {:answer/id #uuid "c649cebf-97ec-55c8-82e9-a38e4ff0da6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{2}{9},-\\frac{7}{9},\\frac{1}{9}⟩" :db/id #edb/ref 17592186286608} {:answer/id #uuid "cb7b80c5-846e-55a0-b89e-5f5227e956c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-\\frac{7}{54},\\frac{2}{54},-\\frac{1}{54}⟩" :db/id #edb/ref 17592186286644}] :answer-field/correct {:answer/id #uuid "4b553699-5a2a-55ea-a60a-4950dd9ea937" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-\\frac{7}{9},\\frac{2}{9},-\\frac{1}{9}⟩" :db/id #edb/ref 17592186285488} :answer-field/id #uuid "9623588b-21ab-50f1-82dd-2c0b6cf81182" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287456}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4fa8486b-1650-59d8-9ca6-220eba05e705" :question/math-academy-id "q-19211" :question/problem "Let $a=[\\begin{aligned}1 \\\\ 8 \\\\ 3\\end{aligned}]$ and $b=[\\begin{aligned}7 \\\\ -2 \\\\ 1\\end{aligned}].$ Find the vector projection of $a$ onto $b.$" :question/worked-solution "Using the formula for the vector projection, we obtain \n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,a & =\\frac{a\\cdot b}{b\\cdot b}b \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}b \\\\  & =\\frac{1\\cdot 7+8\\cdot (-2)+3\\cdot 1}{{7}^{2}+(-2)^{2}+{1}^{2}}b \\\\  & =-\\frac{6}{54}⟨7,-2,1⟩ \\\\  & =-\\frac{1}{9}⟨7,-2,1⟩ \\\\  & =⟨-\\frac{7}{9},\\frac{2}{9},-\\frac{1}{9}⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186106111 :knowledge-point/_questions [{:db/id #edb/ref 17592186105701 :knowledge-point/id #uuid "7c9317eb-d1ce-5f42-b69b-a37e643b865b" :knowledge-point/title "Calculating a Vector Projection Using Angle and Magnitude"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "99da3635-566f-5765-b4bb-5db656f08004" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}b" :db/id #edb/ref 17592186102543} {:answer/id #uuid "a9b723d1-f5fb-51e3-9135-465c4772aa13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8b" :db/id #edb/ref 17592186102544} {:answer/id #uuid "b5619a26-804e-57ec-8332-e8692f55d683" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}b" :db/id #edb/ref 17592186102545} {:answer/id #uuid "14c7ede5-c41b-5947-a26e-695077fa52be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4b" :db/id #edb/ref 17592186102546} {:answer/id #uuid "243fbd8e-0144-51a3-8153-80a1ed4c17b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2b" :db/id #edb/ref 17592186102547}] :answer-field/id #uuid "560b009d-6e9d-5143-9cd0-ea5a2d4e225d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186102542}] :question/id #uuid "923b55ee-6062-5c44-a28a-51ce2a7ca4a2" :question/math-academy-id "q-19219" :question/problem "Suppose that $\\mid a|= 8$, $\\mid b|= 2$ and that the angle between the vectors is $θ = 120^{∘}$. Find the vector projection of $a$ onto $b$ in terms of the vector $b$."}] [{:db/id #edb/ref 17592186290292 :knowledge-point/_questions [{:db/id #edb/ref 17592186105703 :knowledge-point/id #uuid "84c96375-27d5-5ada-a952-34e09b3e92bf" :knowledge-point/title "Perpendicular Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a67a98b-9d27-5d0c-a979-f1bba44de4ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186288201} {:answer/id #uuid "323998bc-c04c-5b38-b918-20a2979f151c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186288359} {:answer/id #uuid "a508270f-e9a6-5d36-a61c-dd6ccc9f7ba7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186289130} {:answer/id #uuid "d41a4ecb-8e5c-5061-afd7-682a98a80d0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186289434} {:answer/id #uuid "fd8c3a95-84ac-503c-a9b8-3804c2b06e52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186289706}] :answer-field/correct {:answer/id #uuid "323998bc-c04c-5b38-b918-20a2979f151c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186288359} :answer-field/id #uuid "1681fc33-0498-5371-ba65-e1edcfc9a7cc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289784}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a84da237-d454-5c5c-975c-b8671954490c" :question/math-academy-id "q-212206" :question/problem "Let $a=⟨1,2,3⟩$ and $b=⟨2,-3,x⟩.$ Given that the projection of $a$ onto $b$ is the zero vector, find the value of $x.$" :question/worked-solution "Since $a$ is a nonzero vector, its projection onto another nonzero vector $b$ equals the zero vector only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =1\\cdot 2+2\\cdot (-3)+3\\cdot x \\\\  & =3x-4.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ 3x-4 & =0 \\\\ 3x & =4 \\\\ x & =\\frac{4}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186106172 :knowledge-point/_questions [{:db/id #edb/ref 17592186105703 :knowledge-point/id #uuid "84c96375-27d5-5ada-a952-34e09b3e92bf" :knowledge-point/title "Perpendicular Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1cfcb707-f673-5120-bdaf-5ec14993c5ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186288218} {:answer/id #uuid "28e5ae1b-51fb-5cd4-bcf7-8b9ab1ac5e58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186288305} {:answer/id #uuid "2d098e5b-459d-5b9c-b2df-0b4279386ce5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186288327} {:answer/id #uuid "3796f6a5-3405-5a89-b45f-0038864205c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186288409} {:answer/id #uuid "40305955-8026-5260-903e-2a5733060cd1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186288470}] :answer-field/correct {:answer/id #uuid "40305955-8026-5260-903e-2a5733060cd1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186288470} :answer-field/id #uuid "a8110895-53af-595b-a638-2a32bf432a34" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290105}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "88b493a3-ac09-5d83-bae2-26aab369c0d4" :question/math-academy-id "q-212461" :question/problem "Let $a=[\\begin{aligned}-4 \\\\ 4 \\\\ 1\\end{aligned}]$ and $b=[\\begin{aligned}4 \\\\ -1 \\\\ x\\end{aligned}].$ Given that the projection of $a$ onto $b$ is the zero vector, find the value of $x.$" :question/worked-solution "Since $a$ is a nonzero vector, its projection onto another nonzero vector $b$ equals the zero vector only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =-4\\cdot 4+4\\cdot (-1)+1\\cdot x \\\\  & =x-20.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ x-20 & =0 \\\\ x & =20.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290297 :knowledge-point/_questions [{:db/id #edb/ref 17592186105703 :knowledge-point/id #uuid "84c96375-27d5-5ada-a952-34e09b3e92bf" :knowledge-point/title "Perpendicular Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c7ef318-2fcb-5abc-8a64-d58156e31752" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186288215} {:answer/id #uuid "5c11b723-d398-54b7-a85d-9a83c61b10d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186288673} {:answer/id #uuid "5dc7f785-7e44-5d1c-b5f4-fda66276cfbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186288688} {:answer/id #uuid "9955ee51-0d6d-5dfb-98be-feb9ccd48fbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186289058} {:answer/id #uuid "d81110dc-6d84-5507-8cfa-a7555e54190e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186289470}] :answer-field/correct {:answer/id #uuid "5c11b723-d398-54b7-a85d-9a83c61b10d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186288673} :answer-field/id #uuid "8c5922bf-d851-5e5c-8bcd-35ace642db54" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290040}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6c452b5c-8f3c-5759-a6a2-00c200b73978" :question/math-academy-id "q-212462" :question/problem "Let $a=[\\begin{aligned}1 \\\\ 3 \\\\ 2\\end{aligned}]$ and $b=[\\begin{aligned}1 \\\\ -2 \\\\ x\\end{aligned}].$ Given that the projection of $a$ onto $b$ is the zero vector, find the value of $x.$" :question/worked-solution "Since $a$ is a nonzero vector, its projection onto another nonzero vector $b$ equals the zero vector only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =1\\cdot 1+3\\cdot (-2)+2\\cdot x \\\\  & =2x-5.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ 2x-5 & =0 \\\\ 2x & =5 \\\\ x & =\\frac{5}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186292821 :knowledge-point/_questions [{:db/id #edb/ref 17592186105702 :knowledge-point/id #uuid "c0670172-77cb-5e88-b78d-e5136c06095f" :knowledge-point/title "Calculating a Vector Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ba44b3f3-6bd6-597b-89fb-265b4431caa0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186291437}] :answer-field/correct {:answer/id #uuid "ba44b3f3-6bd6-597b-89fb-265b4431caa0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186291437} :answer-field/id #uuid "2c61ba6e-77ec-5fbb-8933-eec037081ec9" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291882} {:answer-field/choices [{:answer/id #uuid "e3e8095f-3d51-5f54-8b4e-b27089d59b52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186291583}] :answer-field/correct {:answer/id #uuid "e3e8095f-3d51-5f54-8b4e-b27089d59b52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186291583} :answer-field/id #uuid "4e072deb-f97c-53ef-b1cd-e9141e30c7d8" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291977} {:answer-field/choices [{:answer/id #uuid "6b2f8463-684a-51b6-b307-1b42f3e3157f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186291094}] :answer-field/correct {:answer/id #uuid "6b2f8463-684a-51b6-b307-1b42f3e3157f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186291094} :answer-field/id #uuid "8cccd5b2-82c3-5d41-be67-bad465e6fb84" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292178}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8de6cc29-a041-5100-9a63-1d88e1f3b437" :question/math-academy-id "q-275232" :question/problem "Let $p=⟨-1,1,1⟩$ and $q=⟨4,8,2⟩.$ Find the vector projection of $q$ onto $p.$\n\n${\\text{proj}}_{p}\\,q=⟨$  \n\n{{field-1}},\n\n{{field-2}},\n\n{{field-3}}\n\n$⟩$" :question/worked-solution "Using the formula for the vector projection, we obtain \n\n$$\n\\begin{aligned}{\\text{proj}}_{p}\\,q & =\\frac{p\\cdot q}{p\\cdot p}p \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{{p}_{x}^{2}+{p}_{y}^{2}+{p}_{z}^{2}}p \\\\  & =\\frac{(-1)\\cdot 4+1\\cdot 8+1\\cdot 2}{(-1)^{2}+{1}^{2}+{1}^{2}}p \\\\  & =\\frac{6}{3}⟨-1,1,1⟩ \\\\  & =⟨-2,2,2⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186292822 :knowledge-point/_questions [{:db/id #edb/ref 17592186105703 :knowledge-point/id #uuid "84c96375-27d5-5ada-a952-34e09b3e92bf" :knowledge-point/title "Perpendicular Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a7dc270-f137-54cf-9419-46838c6c877f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186290949}] :answer-field/correct {:answer/id #uuid "4a7dc270-f137-54cf-9419-46838c6c877f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186290949} :answer-field/id #uuid "883276a2-43a4-5c16-8317-46284932dbc1" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292156} {:answer-field/choices [{:answer/id #uuid "a0d8b789-cf9a-5585-bf99-8b3562a45fd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186291332}] :answer-field/correct {:answer/id #uuid "a0d8b789-cf9a-5585-bf99-8b3562a45fd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186291332} :answer-field/id #uuid "a43378fa-0872-5abb-8d07-8d9690e14cb0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292256} {:answer-field/choices [{:answer/id #uuid "5d5388db-d9ca-5e4a-b927-ca4eff155a48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186291031}] :answer-field/correct {:answer/id #uuid "5d5388db-d9ca-5e4a-b927-ca4eff155a48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186291031} :answer-field/id #uuid "cdfe206c-5aee-5730-bda5-ddefb012b2b0" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292357}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "42205966-0418-52d2-acb8-9c430cb90d52" :question/math-academy-id "q-275234" :question/problem "Let $a=⟨1,-2,3⟩$ and $b=⟨1,-1,-1⟩.$ Find the vector projection of $a$ onto $b.$\n\n${\\text{proj}}_{b}\\,a=⟨$\n\n{{field-1}},\n\n{{field-2}},\n\n{{field-3}}\n\n$⟩$" :question/worked-solution "Using the formula for the vector projection, we obtain\n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,a & =\\frac{a\\cdot b}{b\\cdot b}b \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}b \\\\  & =\\frac{1\\cdot 1+(-2)\\cdot (-1)+3\\cdot (-1)}{{1}^{2}+(-1)^{2}+(-1)^{2}}b \\\\  & =\\frac{0}{3}b \\\\  & =⟨0,0,0⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186441580 :knowledge-point/_questions [{:db/id #edb/ref 17592186105701 :knowledge-point/id #uuid "7c9317eb-d1ce-5f42-b69b-a37e643b865b" :knowledge-point/title "Calculating a Vector Projection Using Angle and Magnitude"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ae82f23-3f33-55f8-b143-c4e2aa44358a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186441535}] :answer-field/correct {:answer/id #uuid "0ae82f23-3f33-55f8-b143-c4e2aa44358a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186441535} :answer-field/id #uuid "42723228-7b18-5999-8f79-63b014252842" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186441572}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "24948042-4caf-54ad-85ae-20d1f75949ff" :question/math-academy-id "q-316438" :question/problem "Suppose that $|\\,x\\,|=9$, $|\\,y\\,|=6$ and that the angle between the vectors is $\\theta =\\pi .$ Find the vector projection of $x$ onto $y$ in terms of the vector $y.$\n\n${\\text{proj}}_{y}\\,x=$\n{{field-1}}\n$y$" :question/worked-solution "First, we find the scalar projection as follows:\n\n$$\n\\begin{aligned}{\\text{comp}}_{y}\\,x & =|\\,x\\,|\\operatorname{cos}⁡\\theta  \\\\  & =9\\operatorname{cos}⁡(\\pi ) \\\\  & =9\\cdot (-1) \\\\  & =-9\\end{aligned}\n$$\n\nNow, we find the unit vector that is parallel to $y:$\n\n$$\nu=\\frac{y}{|\\,y\\,|}=\\frac{y}{6}=\\frac{1}{6}y\n$$\n\nFinally, we compute the vector projection as follows:\n\n$$\n\\begin{aligned}{\\text{proj}}_{y}\\,x & ={\\text{comp}}_{y}\\,x\\cdot u \\\\  & =-9\\cdot \\frac{1}{6}y \\\\  & =-\\frac{3}{2}\\,y\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299636 :knowledge-point/_questions [{:db/id #edb/ref 17592186105702 :knowledge-point/id #uuid "c0670172-77cb-5e88-b78d-e5136c06095f" :knowledge-point/title "Calculating a Vector Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "406c9253-8200-5ad3-8d4b-33726202a988" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{23}{15}" :db/id #edb/ref 17592186297809}] :answer-field/correct {:answer/id #uuid "406c9253-8200-5ad3-8d4b-33726202a988" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{23}{15}" :db/id #edb/ref 17592186297809} :answer-field/id #uuid "5d8666c5-0963-50a4-bc97-4b5c38053501" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298959} {:answer-field/choices [{:answer/id #uuid "1df406d7-a2cd-566a-9e5c-dbf376476be5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{23}{6}" :db/id #edb/ref 17592186297681}] :answer-field/correct {:answer/id #uuid "1df406d7-a2cd-566a-9e5c-dbf376476be5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{23}{6}" :db/id #edb/ref 17592186297681} :answer-field/id #uuid "d08d1232-d14d-502d-8d1a-ea40bec46176" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299341} {:answer-field/choices [{:answer/id #uuid "74ad9205-623c-5b5c-8b1b-874ef60380c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{23}{30}" :db/id #edb/ref 17592186298055}] :answer-field/correct {:answer/id #uuid "74ad9205-623c-5b5c-8b1b-874ef60380c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{23}{30}" :db/id #edb/ref 17592186298055} :answer-field/id #uuid "e9147c73-f105-5d8b-83ed-2692f2208968" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299426}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1656678a-52ed-5990-af8d-fd8bfe8d48c4" :question/math-academy-id "q-317658" :question/problem "Let $c=⟨-2,1,5⟩$ and $d=⟨4,0,-3⟩.$ Find the vector projection of $d$ onto $c.$\n\n${\\text{proj}}_{c}\\,d=⟨$\n{{field-1}}$,$\n{{field-2}}$,$\n{{field-3}}\n$⟩$" :question/worked-solution "Using the formula for the vector projection, we obtain \n\n$$\n\\begin{aligned}{\\text{proj}}_{c}\\,d & =\\frac{c\\cdot d}{c\\cdot c}c \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{{c}_{x}^{2}+{c}_{y}^{2}+{c}_{z}^{2}}c \\\\  & =\\frac{(-2)\\cdot 4+1\\cdot 0+5\\cdot (-3)}{(-2)^{2}+{1}^{2}+{5}^{2}}c \\\\  & =\\frac{-8+0-15}{4+1+25}⟨-2,1,5⟩ \\\\  & =\\frac{-23}{30}⟨-2,1,5⟩ \\\\  & =⟨\\,\\frac{23}{15},-\\frac{23}{30},-\\frac{23}{6}\\,⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339000 :knowledge-point/_questions [{:db/id #edb/ref 17592186105701 :knowledge-point/id #uuid "7c9317eb-d1ce-5f42-b69b-a37e643b865b" :knowledge-point/title "Calculating a Vector Projection Using Angle and Magnitude"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c0b97a6b-e1ff-50f5-ab1f-37b3ab282c83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}q" :db/id #edb/ref 17592186337742} {:answer/id #uuid "c2e7480f-dbd5-5885-8503-7a72787be86f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2q" :db/id #edb/ref 17592186337763} {:answer/id #uuid "d0bdf6fc-3892-5112-a046-b04e54d7df85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}q" :db/id #edb/ref 17592186337858} {:answer/id #uuid "d0d3c6c7-ecd4-50be-8fef-f7432eaa4b10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{2}q" :db/id #edb/ref 17592186337860} {:answer/id #uuid "d629248a-72f1-5ef2-a0a0-24852eab0c8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}q" :db/id #edb/ref 17592186337897}] :answer-field/correct {:answer/id #uuid "d629248a-72f1-5ef2-a0a0-24852eab0c8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}q" :db/id #edb/ref 17592186337897} :answer-field/id #uuid "d281a134-374b-5aef-8d0d-6fbd0b5e1009" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338649}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "47b269c9-2c28-5ab1-9f15-6a708a836ca9" :question/math-academy-id "q-71835" :question/problem "Suppose that $|\\,p\\,|=8$, $|\\,q\\,|=4$ and that the angle between the vectors is $\\theta =\\frac{\\pi }{4}.$ Find the vector projection of $p$ onto $q$ in terms of the vector $q.$" :question/worked-solution "First, we find the scalar projection as follows:\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =|\\,p\\,|\\operatorname{cos}⁡\\theta  \\\\  & =8\\operatorname{cos}⁡(\\frac{\\pi }{4}) \\\\  & =8\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =4\\sqrt{2}\\end{aligned}\n$$\n\nNow, we find the unit vector that is parallel to $q:$\n\n$$\nu=\\frac{q}{|\\,q\\,|}=\\frac{q}{4}=\\frac{1}{4}q\n$$\n\nFinally, we compute the vector projection as follows:\n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,p & ={\\text{comp}}_{q}\\,p\\cdot u \\\\  & =4\\sqrt{2}\\cdot \\frac{1}{4}q \\\\  & =\\sqrt{2}q\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339002 :knowledge-point/_questions [{:db/id #edb/ref 17592186105701 :knowledge-point/id #uuid "7c9317eb-d1ce-5f42-b69b-a37e643b865b" :knowledge-point/title "Calculating a Vector Projection Using Angle and Magnitude"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25466e04-4156-5b4c-8c94-6ad96f5422dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}p" :db/id #edb/ref 17592186336382} {:answer/id #uuid "3b9f9291-1a79-5586-ae99-c669c0e89bf9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2p" :db/id #edb/ref 17592186336592} {:answer/id #uuid "7ed5854a-8b65-56d0-bac1-5014999eac3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4p" :db/id #edb/ref 17592186337180} {:answer/id #uuid "dab71ec9-ff6d-5be9-aff0-f244b1f57e34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{2}p" :db/id #edb/ref 17592186337936} {:answer/id #uuid "feae0e87-fadb-53ae-b428-1b01718923fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}p" :db/id #edb/ref 17592186338267}] :answer-field/correct {:answer/id #uuid "3b9f9291-1a79-5586-ae99-c669c0e89bf9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2p" :db/id #edb/ref 17592186336592} :answer-field/id #uuid "6cfa46b9-e94d-5521-9b5b-c6ac38531617" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338466}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "405bd8b0-536b-5f37-9b2a-88044b8dd73a" :question/math-academy-id "q-71839" :question/problem "Suppose that $|\\,p\\,|=4\\sqrt{2}$, $|\\,q\\,|=16$ and that the angle between the vectors is $\\theta ={45}^{∘}.$ Find the vector projection of $q$ onto $p$ in terms of the vector $p.$" :question/worked-solution "First, we find the scalar projection as follows:\n\n$$\n\\begin{aligned}{\\text{comp}}_{p}\\,q & =|\\,q\\,|\\operatorname{cos}⁡\\theta  \\\\  & =16\\operatorname{cos}⁡({45}^{∘}) \\\\  & =16\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =8\\sqrt{2}\\end{aligned}\n$$\n\nNow, we find the unit vector that is parallel to $p:$\n\n$$\nu=\\frac{p}{|\\,p\\,|}=\\frac{p}{4\\sqrt{2}}=\\frac{1}{4\\sqrt{2}}p\n$$\n\nFinally, we compute the vector projection as follows:\n\n$$\n\\begin{aligned}{\\text{proj}}_{p}\\,q & ={\\text{comp}}_{p}\\,q\\cdot u \\\\  & =8\\sqrt{2}\\cdot \\frac{1}{4\\sqrt{2}}p \\\\  & =2p\\end{aligned}\n$$"}]}
