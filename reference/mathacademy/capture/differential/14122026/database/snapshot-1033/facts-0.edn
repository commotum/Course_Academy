5493 #edb/ref 17592186045417] [17592186274828 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186274828 #edb/ref 1078 #edb/ref 17592186273485 #edb/ref 17592186045417] [17592186274828 #edb/ref 1079 #uuid "728cf5fb-d73b-54ad-9dcc-88cfd652ebc3" #edb/ref 17592186045417] [17592186275029 #edb/ref 1075 #edb/ref 17592186272556 #edb/ref 17592186045417] [17592186275029 #edb/ref 1075 #edb/ref 17592186272990 #edb/ref 17592186045417] [17592186275029 #edb/ref 1075 #edb/ref 17592186273652 #edb/ref 17592186045417] [17592186275029 #edb/ref 1075 #edb/ref 17592186274343 #edb/ref 17592186045417] [17592186275029 #edb/ref 1075 #edb/ref 17592186274609 #edb/ref 17592186045417] [17592186275029 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186275029 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186275029 #edb/ref 1078 #edb/ref 17592186274343 #edb/ref 17592186045417] [17592186275029 #edb/ref 1079 #uuid "e19d5f24-a4a0-53f9-8783-bde0e7951f0c" #edb/ref 17592186045417] [17592186275465 #edb/ref 1068 #edb/ref 17592186274828 #edb/ref 17592186045417] [17592186275465 #edb/ref 1069 "q-158363" #edb/ref 17592186045417] [17592186275465 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186275465 #edb/ref 1071 "Compute $P(X\\le 2)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{1}{72}({x}^{3}+x),\\, & 0\\le x\\le 4, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186275465 #edb/ref 1072 #uuid "edf8c68d-b48c-5470-88a8-57b4271b4291" #edb/ref 17592186045417] [17592186275465 #edb/ref 1074 "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a\\le X\\le b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSince $f(x)$ is identical to zero for all $x<0,$ we have\n\n$$\n\\begin{aligned}P(X\\le 2) & ={\\int }_{0}^{2}f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}\\frac{1}{72}({x}^{3}+x)\\,\\text{d}x \\\\  & =\\frac{1}{72}{\\int }_{0}^{2}{x}^{3}+x\\,\\text{d}x \\\\  & =\\frac{1}{72}{[\\frac{1}{4}{x}^{4}+\\frac{1}{2}{x}^{2}]}_{0}^{2} \\\\  & =\\frac{1}{72}([\\frac{1}{4}(2)^{4}+\\frac{1}{2}(2)^{2}]-[\\frac{1}{4}(0)^{4}+\\frac{1}{2}(0)^{2}]) \\\\  & =\\frac{1}{72}(4+2-0) \\\\  & =\\frac{6}{72} \\\\  & =\\frac{1}{12}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186275477 #edb/ref 1068 #edb/ref 17592186275029 #edb/ref 17592186045417] [17592186275477 #edb/ref 1069 "q-158420" #edb/ref 17592186045417] [17592186275477 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186275477 #edb/ref 1071 "Compute $P(3<X<4)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{3}{4}{x}^{2},\\, & -1\\le x\\le 1, \\\\ \\frac{1}{9}(x-1) & 1<x\\le 4, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186275477 #edb/ref 1072 #uuid "1fa2bcf9-069e-5cbf-8261-5732b1e8e1ad" #edb/ref 17592186045417] [17592186275477 #edb/ref 1074 "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X<b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(3<X<4) & ={\\int }_{3}^{4}f(x)\\,\\text{d}x \\\\  & ={\\int }_{3}^{4}\\frac{1}{9}(x-1)\\,\\text{d}x \\\\  & =\\frac{1}{9}{[\\frac{1}{2}{x}^{2}-x]}_{3}^{4} \\\\  & =\\frac{1}{9}([\\frac{1}{2}(4)^{2}-(4)]-[\\frac{1}{2}(3)^{2}-(3)]) \\\\  & =\\frac{1}{9}(8-4-\\frac{9}{2}+3) \\\\  & =\\frac{1}{9}(\\frac{5}{2}) \\\\  & =\\frac{5}{18}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186352152 #edb/ref 1080 "\\frac{3}{10}" #edb/ref 17592186045417] [17592186352152 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186352152 #edb/ref 1083 #uuid "3f055877-0f31-5f67-ae7f-ea2f3b1d02cc" #edb/ref 17592186045417] [17592186352259 #edb/ref 1080 "\\frac{3}{4}" #edb/ref 17592186045417] [17592186352259 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186352259 #edb/ref 1083 #uuid "4b49524e-9841-54f3-be9a-fcc6b96d35cd" #edb/ref 17592186045417] [17592186353166 #edb/ref 1080 "\\frac{1}{4}" #edb/ref 17592186045417] [17592186353166 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186353166 #edb/ref 1083 #uuid "bbfb4004-fec4-5bb2-949e-a98556753b8d" #edb/ref 17592186045417] [17592186353279 #edb/ref 1080 "\\frac{2}{5}" #edb/ref 17592186045417] [17592186353279 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186353279 #edb/ref 1083 #uuid "c5b58843-4e07-5fd9-8d86-d003d67b7728" #edb/ref 17592186045417] [17592186353770 #edb/ref 1080 "\\frac{3}{5}" #edb/ref 17592186045417] [17592186353770 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186353770 #edb/ref 1083 #uuid "fbb325b2-0686-54be-9f29-5d8d80927bbe" #edb/ref 17592186045417] [17592186354232 #edb/ref 1075 #edb/ref 17592186352152 #edb/ref 17592186045417] [17592186354232 #edb/ref 1075 #edb/ref 17592186352259 #edb/ref 17592186045417] [17592186354232 #edb/ref 1075 #edb/ref 17592186353166 #edb/ref 17592186045417] [17592186354232 #edb/ref 1075 #edb/ref 17592186353279 #edb/ref 17592186045417] [17592186354232 #edb/ref 1075 #edb/ref 17592186353770 #edb/ref 17592186045417] [17592186354232 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186354232 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186354232 #edb/ref 1078 #edb/ref 17592186353770 #edb/ref 17592186045417] [17592186354232 #edb/ref 1079 #uuid "efa286bb-faff-5ac7-b54e-135fdabf727b" #edb/ref 17592186045417]}
