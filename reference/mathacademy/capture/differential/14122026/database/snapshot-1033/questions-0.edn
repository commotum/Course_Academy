#{[{:db/id #edb/ref 17592186192472 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186192753 :knowledge-point/id #uuid "fe4b690c-94a9-5a27-b0e8-5583ba6dba19" :knowledge-point/title "Computing the Probability That a Random Variable Lies Within a Bounded Interval"}] :question/id #uuid "65070836-e061-5fec-ae8d-263ef0c32659" :question/math-academy-id "e-10839" :question/problem "Compute $P\\left( 1 \\lt   X \\lt 3 \\right)$ given that the random variable $X$ has the probability density function\n\n![](images/70/7059e7c4cb42e405342d34cd53ee7852f8abfffff2c3f54a95df30cdd44ef3c8.svg)" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a \\lt   X \\lt      b) = \\int_a^b f(x) \\, \\textrm dx.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(1<X<3) & ={\\int }_{1}^{3}f(x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{3}\\frac{1}{18}({x}^{2}-1)\\,\\text{d}x \\\\  & =\\frac{1}{18}{\\int }_{1}^{3}({x}^{2}-1)\\,\\text{d}x \\\\  & =\\frac{1}{18}{[\\frac{1}{3}{x}^{3}-x]}_{1}^{3} \\\\  & =\\frac{1}{18}([\\frac{1}{3}(3)^{3}-(3)]-[\\frac{1}{3}(1)^{3}-(1)]) \\\\  & =\\frac{1}{18}([9-3]-[\\frac{1}{3}-1]) \\\\  & =\\frac{1}{18}(6+\\frac{2}{3}) \\\\  & =\\frac{1}{18}\\cdot \\frac{20}{3} \\\\  & =\\frac{10}{27}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186192512 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186192788 :knowledge-point/id #uuid "1e723a34-c6e1-5827-87ad-866cbaeef98c" :knowledge-point/title "Computing the Probability That a Random Variable Lies Within an Unbounded Interval"}] :question/id #uuid "d8425df8-1fb2-5f59-a034-2b30f14b9b4b" :question/math-academy-id "e-11036" :question/problem "Compute $P\\left(  X \\leq 3 \\right)$ given that the random variable $X$ has the probability density function\n\n![](images/b0/b083c72bc5c3bb6ea1a4f5036a57e5671c884d585def9e71f17a1ac72845d984.svg)" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a \\leq X \\leq  b) = \\int_a^b f(x) \\, \\textrm dx.\n$$\n\nSince $f(x)$ is identical to zero for all $x \\lt  2,$ we have\n\n$$\n\\begin{aligned}P(X\\le 3) & ={\\int }_{2}^{3}f(x)\\,\\text{d}x \\\\  & ={\\int }_{2}^{3}\\frac{2x}{45}\\,\\text{d}x \\\\  & ={[\\frac{1}{45}\\,{x}^{2}]}_{2}^{3} \\\\  & =\\frac{1}{45}({3}^{2}-{2}^{2}) \\\\  & =\\frac{1}{45}\\cdot 5 \\\\  & =\\frac{1}{9}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186192513 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186192789 :knowledge-point/id #uuid "17408f35-ef57-5eb2-8cb6-3a946194d2d3" :knowledge-point/title "Calculating Probabilities With Piecewise PDFs"}] :question/id #uuid "4baa68f1-2f68-5df5-936a-aff56605ed8e" :question/math-academy-id "e-11038" :question/problem "Compute $P\\left( 2 \\leq          X \\leq          4 \\right)$ given that the random variable $X$ has the probability density function\n\n![](images/b4/b4da93ec01e058c31044ba7022c1e7109a7bacd4fd56c264df2ccfad5fbe2457.svg)" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a \\leq        X \\leq        b) = \\int_a^b f(x) \\, \\textrm dx.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(2\\le X\\le 4) & ={\\int }_{2}^{4}f(x)\\,\\text{d}x \\\\  & ={\\int }_{2}^{3}\\frac{1}{9}x\\,\\text{d}x+{\\int }_{3}^{4}(x-3)\\,\\text{d}x \\\\  & ={[\\frac{1}{18}{x}^{2}]}_{2}^{3}+{[\\frac{1}{2}{x}^{2}-3x]}_{3}^{4} \\\\  & =\\frac{1}{18}[{3}^{2}-{2}^{2}]+([\\frac{1}{2}(4)^{2}-3(4)]-[\\frac{1}{2}(3)^{2}-3(3)]) \\\\  & =\\frac{5}{18}-4+\\frac{9}{2} \\\\  & =\\frac{14}{18} \\\\  & =\\frac{7}{9}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275465 :knowledge-point/_questions [{:db/id #edb/ref 17592186192788 :knowledge-point/id #uuid "1e723a34-c6e1-5827-87ad-866cbaeef98c" :knowledge-point/title "Computing the Probability That a Random Variable Lies Within an Unbounded Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d2809d8-203c-5893-a099-43303ed8f126" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{24}" :db/id #edb/ref 17592186272790} {:answer/id #uuid "80120326-e152-59d7-bf14-ba6c1bce3b2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{12}" :db/id #edb/ref 17592186273485} {:answer/id #uuid "d7b18a60-c7ae-5796-afaf-868e6c0d8acf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{24}" :db/id #edb/ref 17592186274274} {:answer/id #uuid "e01f7a31-782e-5455-9aa6-b46b4f1275d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{12}" :db/id #edb/ref 17592186274366} {:answer/id #uuid "fd3d480d-bbd9-5d62-ade6-1fcbb2f7c5b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186274612}] :answer-field/correct {:answer/id #uuid "80120326-e152-59d7-bf14-ba6c1bce3b2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{12}" :db/id #edb/ref 17592186273485} :answer-field/id #uuid "728cf5fb-d73b-54ad-9dcc-88cfd652ebc3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274828}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "edf8c68d-b48c-5470-88a8-57b4271b4291" :question/math-academy-id "q-158363" :question/problem "Compute $P(X\\le 2)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{1}{72}({x}^{3}+x),\\, & 0\\le x\\le 4, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a\\le X\\le b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSince $f(x)$ is identical to zero for all $x<0,$ we have\n\n$$\n\\begin{aligned}P(X\\le 2) & ={\\int }_{0}^{2}f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}\\frac{1}{72}({x}^{3}+x)\\,\\text{d}x \\\\  & =\\frac{1}{72}{\\int }_{0}^{2}{x}^{3}+x\\,\\text{d}x \\\\  & =\\frac{1}{72}{[\\frac{1}{4}{x}^{4}+\\frac{1}{2}{x}^{2}]}_{0}^{2} \\\\  & =\\frac{1}{72}([\\frac{1}{4}(2)^{4}+\\frac{1}{2}(2)^{2}]-[\\frac{1}{4}(0)^{4}+\\frac{1}{2}(0)^{2}]) \\\\  & =\\frac{1}{72}(4+2-0) \\\\  & =\\frac{6}{72} \\\\  & =\\frac{1}{12}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275477 :knowledge-point/_questions [{:db/id #edb/ref 17592186192789 :knowledge-point/id #uuid "17408f35-ef57-5eb2-8cb6-3a946194d2d3" :knowledge-point/title "Calculating Probabilities With Piecewise PDFs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12b8b202-7725-53aa-b893-d1b69f0354a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{9}" :db/id #edb/ref 17592186272556} {:answer/id #uuid "46adcefc-4dfa-5a5c-b624-02599ee711d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{12}" :db/id #edb/ref 17592186272990} {:answer/id #uuid "91a497ff-0914-55cf-9351-4ba1b7653f7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186273652} {:answer/id #uuid "de619e13-5828-5f8f-bf98-8bebe07fa6a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{18}" :db/id #edb/ref 17592186274343} {:answer/id #uuid "fcc857e1-a971-55cf-a14e-2327b3c60869" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{18}" :db/id #edb/ref 17592186274609}] :answer-field/correct {:answer/id #uuid "de619e13-5828-5f8f-bf98-8bebe07fa6a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{18}" :db/id #edb/ref 17592186274343} :answer-field/id #uuid "e19d5f24-a4a0-53f9-8783-bde0e7951f0c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275029}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1fa2bcf9-069e-5cbf-8261-5732b1e8e1ad" :question/math-academy-id "q-158420" :question/problem "Compute $P(3<X<4)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{3}{4}{x}^{2},\\, & -1\\le x\\le 1, \\\\ \\frac{1}{9}(x-1) & 1<x\\le 4, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X<b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(3<X<4) & ={\\int }_{3}^{4}f(x)\\,\\text{d}x \\\\  & ={\\int }_{3}^{4}\\frac{1}{9}(x-1)\\,\\text{d}x \\\\  & =\\frac{1}{9}{[\\frac{1}{2}{x}^{2}-x]}_{3}^{4} \\\\  & =\\frac{1}{9}([\\frac{1}{2}(4)^{2}-(4)]-[\\frac{1}{2}(3)^{2}-(3)]) \\\\  & =\\frac{1}{9}(8-4-\\frac{9}{2}+3) \\\\  & =\\frac{1}{9}(\\frac{5}{2}) \\\\  & =\\frac{5}{18}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186193389 :knowledge-point/_questions [{:db/id #edb/ref 17592186192753 :knowledge-point/id #uuid "fe4b690c-94a9-5a27-b0e8-5583ba6dba19" :knowledge-point/title "Computing the Probability That a Random Variable Lies Within a Bounded Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f055877-0f31-5f67-ae7f-ea2f3b1d02cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{10}" :db/id #edb/ref 17592186352152} {:answer/id #uuid "4b49524e-9841-54f3-be9a-fcc6b96d35cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186352259} {:answer/id #uuid "bbfb4004-fec4-5bb2-949e-a98556753b8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186353166} {:answer/id #uuid "c5b58843-4e07-5fd9-8d86-d003d67b7728" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186353279} {:answer/id #uuid "fbb325b2-0686-54be-9f29-5d8d80927bbe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186353770}] :answer-field/correct {:answer/id #uuid "fbb325b2-0686-54be-9f29-5d8d80927bbe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186353770} :answer-field/id #uuid "efa286bb-faff-5ac7-b54e-135fdabf727b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354232}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7d522d4b-cd13-5ffd-9293-3255ca27b6de" :question/math-academy-id "q-86913" :question/problem "Compute $P(2<X<8)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{1}{50}x,\\, & 0\\le x\\le 10, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X<b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(2<X<8) & ={\\int }_{2}^{8}f(x)\\,\\text{d}x \\\\  & ={\\int }_{2}^{8}\\frac{1}{50}x\\,\\text{d}x \\\\  & ={[\\frac{1}{100}{x}^{2}]}_{2}^{8} \\\\  & =\\frac{3}{5}.\\end{aligned}\n$$"}]}
