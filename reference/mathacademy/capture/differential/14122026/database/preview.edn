5}" 13194139534346 17592186045417 true] [17592186419849 1082 #edb/ref 17592186045498 13194139534346 17592186045417 true] [17592186419849 1083 #uuid "fab029a1-53e8-5c09-b2e6-2e023aa011da" 13194139534346 17592186045417 true] [17592186419850 1075 #edb/ref 17592186419835 13194139534346 17592186045417 true] [17592186419850 1075 #edb/ref 17592186419840 13194139534346 17592186045417 true] [17592186419850 1075 #edb/ref 17592186419842 13194139534346 17592186045417 true] [17592186419850 1075 #edb/ref 17592186419844 13194139534346 17592186045417 true] [17592186419850 1075 #edb/ref 17592186419847 13194139534346 17592186045417 true] [17592186419850 1076 #edb/ref 17592186045493 13194139534346 17592186045417 true] [17592186419850 1077 "selection" 13194139534346 17592186045417 true] [17592186419850 1078 #edb/ref 17592186419840 13194139534346 17592186045417 true] [17592186419850 1079 #uuid "20c4e209-e663-5abe-a7e4-efeeee1e6a67" 13194139534346 17592186045417 true] [17592186419851 1075 #edb/ref 17592186419838 13194139534346 17592186045417 true] [17592186419851 1075 #edb/ref 17592186419841 13194139534346 17592186045417 true] [17592186419851 1075 #edb/ref 17592186419846 13194139534346 17592186045417 true] [17592186419851 1075 #edb/ref 17592186419848 13194139534346 17592186045417 true] [17592186419851 1075 #edb/ref 17592186419849 13194139534346 17592186045417 true] [17592186419851 1076 #edb/ref 17592186045493 13194139534346 17592186045417 true] [17592186419851 1077 "selection" 13194139534346 17592186045417 true] [17592186419851 1078 #edb/ref 17592186419841 13194139534346 17592186045417 true] [17592186419851 1079 #uuid "975944ff-c1bd-5b70-9eec-fdb4a7dcd566" 13194139534346 17592186045417 true] [17592186419852 1075 #edb/ref 17592186419836 13194139534346 17592186045417 true] [17592186419852 1075 #edb/ref 17592186419837 13194139534346 17592186045417 true] [17592186419852 1075 #edb/ref 17592186419839 13194139534346 17592186045417 true] [17592186419852 1075 #edb/ref 17592186419843 13194139534346 17592186045417 true] [17592186419852 1075 #edb/ref 17592186419845 13194139534346 17592186045417 true] [17592186419852 1076 #edb/ref 17592186045493 13194139534346 17592186045417 true] [17592186419852 1077 "selection" 13194139534346 17592186045417 true] [17592186419852 1078 #edb/ref 17592186419839 13194139534346 17592186045417 true] [17592186419852 1079 #uuid "d0b9338f-ce76-54a7-9f1b-a16c716aaa54" 13194139534346 17592186045417 true] [17592186419853 1068 #edb/ref 17592186419852 13194139534346 17592186045417 true] [17592186419853 1069 "q-158421" 13194139534346 17592186045417 true] [17592186419853 1070 #edb/ref 17592186045485 13194139534346 17592186045417 true] [17592186419853 1071 "Compute $P(-1<X<0)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{1}{12}({x}^{2}+2),\\, & -2\\le x\\le 1, \\\\ \\frac{1}{8} & 1<x\\le 3, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" 13194139534346 17592186045417 true] [17592186419853 1072 #uuid "a05ac3ca-da7d-5bdc-b9ed-2ee65cee279b" 13194139534346 17592186045417 true] [17592186419853 1074 "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X<b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(-1<X<0) & ={\\int }_{-1}^{0}f(x)\\,\\text{d}x \\\\  & ={\\int }_{-1}^{0}\\frac{1}{12}({x}^{2}+2)\\,\\text{d}x \\\\  & =\\frac{1}{12}{[\\frac{1}{3}{x}^{3}+2x]}_{-1}^{0} \\\\  & =\\frac{1}{12}([\\frac{1}{3}(0)^{3}+2(0)]-[\\frac{1}{3}(-1)^{3}+2(-1)]) \\\\  & =\\frac{1}{12}(0+\\frac{1}{3}+2) \\\\  & =\\frac{1}{12}(\\frac{7}{3}) \\\\  & =\\frac{7}{36}.\\end{aligned}\n$$" 13194139534346 17592186045417 true] [17592186419854 1068 #edb/ref 17592186419851 13194139534346 17592186045417 true] [17592186419854 1069 "q-158459" 13194139534346 17592186045417 true] [17592186419854 1070 #edb/ref 17592186045487 13194139534346 17592186045417 true] [17592186419854 1071 "Compute $P(X<2)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{4}{225}({x}^{3}-x),\\, & 1\\le x\\le 4, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" 13194139534346 17592186045417 true] [17592186419854 1072 #uuid "a3bc7141-c1a8-5cbc-848c-a007152181e1" 13194139534346 17592186045417 true] [17592186419854 1074 "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a\\le X<b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSince $f(x)$ is identical to zero for all $x<1,$ we have\n\n$$\n\\begin{aligned}P(X<2) & ={\\int }_{1}^{2}f(x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}\\frac{4}{225}({x}^{3}-x)\\,\\text{d}x \\\\  & =\\frac{4}{225}{\\int }_{1}^{2}{x}^{3}-x\\,\\text{d}x \\\\  & =\\frac{4}{225}{[\\frac{1}{4}{x}^{4}-\\frac{1}{2}{x}^{2}]}_{1}^{2} \\\\  & =\\frac{4}{225}([\\frac{1}{4}(2)^{4}-\\frac{1}{2}(2)^{2}]-[\\frac{1}{4}(1)^{4}-\\frac{1}{2}(1)^{2}]) \\\\  & =\\frac{4}{225}(4-2-\\frac{1}{4}+\\frac{1}{2}) \\\\  & =\\frac{4}{225}\\cdot \\frac{9}{4} \\\\  & =\\frac{1}{25}.\\end{aligned}\n$$" 13194139534346 17592186045417 true] [17592186419855 1068 #edb/ref 17592186419850 13194139534346 17592186045417 true] [17592186419855 1069 "q-87211" 13194139534346 17592186045417 true] [17592186419855 1070 #edb/ref 17592186045485 13194139534346 17592186045417 true] [17592186419855 1071 "Compute $P(4\\le X<5)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{1}{36}x,\\, & 3\\le x\\le 9, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" 13194139534346 17592186045417 true] [17592186419855 1072 #uuid "ede51055-5b5a-5878-ba82-9ac8687dc145" 13194139534346 17592186045417 true] [17592186419855 1074 "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a\\le X<b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(4\\le X<5) & ={\\int }_{4}^{5}f(x)\\,\\text{d}x \\\\  & ={\\int }_{4}^{5}\\frac{1}{36}x\\,\\text{d}x \\\\  & ={[\\frac{1}{72}{x}^{2}]}_{4}^{5} \\\\  & =\\frac{1}{8}.\\end{aligned}\n$$" 13194139534346 17592186045417 true]] :edb/tempids {"answer-2cd1e3fe-f43e-53fb-8bc0-024a1be5512a" 17592186419835 "answer-384b21df-8a7c-5b30-9125-1330da362a5b" 17592186419836 "answer-3e21377a-680e-57d6-80e2-410c96b326e9" 17592186419837 "answer-4f26d7f1-c022-5659-bc20-fa461d0a022d" 17592186419838 "answer-6c20cdc4-8968-5346-8c22-76a6ecf55625" 17592186419839 "answer-ace61419-2834-5550-8a4a-355662dfbe3c" 17592186419840 "answer-bd067b86-c4e8-5816-83ca-9de842651e91" 17592186419841 "answer-c078e511-1510-59b2-8b82-4b6e73c302f1" 17592186419842 "answer-e2afce84-edf6-5026-8a56-a45c4ffb8701" 17592186419843 "answer-e9840860-92c3-5f70-87cf-5e47a525789c" 17592186419844 "answer-f1943a76-0ce9-5efd-8b74-da642c9f9e88" 17592186419845 "answer-f422e282-b77c-5a6a-a505-0044c35f1997" 17592186419846 "answer-f7ee2a4e-3aad-50e9-b149-55104c2e1800" 17592186419847 "answer-f8ecd07d-b247-51bd-a8c2-a9927c076572" 17592186419848 "answer-fab029a1-53e8-5c09-b2e6-2e023aa011da" 17592186419849 "answer-field-20c4e209-e663-5abe-a7e4-efeeee1e6a67" 17592186419850 "answer-field-975944ff-c1bd-5b70-9eec-fdb4a7dcd566" 17592186419851 "answer-field-d0b9338f-ce76-54a7-9f1b-a16c716aaa54" 17592186419852 "question-a05ac3ca-da7d-5bdc-b9ed-2ee65cee279b" 17592186419853 "question-a3bc7141-c1a8-5cbc-848c-a007152181e1" 17592186419854 "question-ede51055-5b5a-5878-ba82-9ac8687dc145" 17592186419855} :edb/committed false :edb/speculative true}
