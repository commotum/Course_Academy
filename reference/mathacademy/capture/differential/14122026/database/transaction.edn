[{:db/id 17592186192753 :knowledge-point/questions ["question-ede51055-5b5a-5878-ba82-9ac8687dc145"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186192788 :knowledge-point/questions ["question-a3bc7141-c1a8-5cbc-848c-a007152181e1"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186192789 :knowledge-point/questions ["question-a05ac3ca-da7d-5bdc-b9ed-2ee65cee279b"] :db/ensure [:knowledge-point/validate]} {:db/id "question-ede51055-5b5a-5878-ba82-9ac8687dc145" :question/id #uuid "ede51055-5b5a-5878-ba82-9ac8687dc145" :question/math-academy-id "q-87211" :question/problem "Compute $P(4\\le X<5)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{1}{36}x,\\, & 3\\le x\\le 9, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a\\le X<b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(4\\le X<5) & ={\\int }_{4}^{5}f(x)\\,\\text{d}x \\\\  & ={\\int }_{4}^{5}\\frac{1}{36}x\\,\\text{d}x \\\\  & ={[\\frac{1}{72}{x}^{2}]}_{4}^{5} \\\\  & =\\frac{1}{8}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-20c4e209-e663-5abe-a7e4-efeeee1e6a67"] :db/ensure [:question/validate]} {:db/id "answer-field-20c4e209-e663-5abe-a7e4-efeeee1e6a67" :answer-field/id #uuid "20c4e209-e663-5abe-a7e4-efeeee1e6a67" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ace61419-2834-5550-8a4a-355662dfbe3c" :answer-field/choices ["answer-f7ee2a4e-3aad-50e9-b149-55104c2e1800" "answer-2cd1e3fe-f43e-53fb-8bc0-024a1be5512a" "answer-c078e511-1510-59b2-8b82-4b6e73c302f1" "answer-ace61419-2834-5550-8a4a-355662dfbe3c" "answer-e9840860-92c3-5f70-87cf-5e47a525789c"] :db/ensure [:answer-field/validate]} {:db/id "answer-f7ee2a4e-3aad-50e9-b149-55104c2e1800" :answer/id #uuid "f7ee2a4e-3aad-50e9-b149-55104c2e1800" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-2cd1e3fe-f43e-53fb-8bc0-024a1be5512a" :answer/id #uuid "2cd1e3fe-f43e-53fb-8bc0-024a1be5512a" :answer/type :answer.type/math :answer/value "\\frac{1}{36}" :db/ensure [:answer/validate]} {:db/id "answer-c078e511-1510-59b2-8b82-4b6e73c302f1" :answer/id #uuid "c078e511-1510-59b2-8b82-4b6e73c302f1" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "answer-ace61419-2834-5550-8a4a-355662dfbe3c" :answer/id #uuid "ace61419-2834-5550-8a4a-355662dfbe3c" :answer/type :answer.type/math :answer/value "\\frac{1}{8}" :db/ensure [:answer/validate]} {:db/id "answer-e9840860-92c3-5f70-87cf-5e47a525789c" :answer/id #uuid "e9840860-92c3-5f70-87cf-5e47a525789c" :answer/type :answer.type/math :answer/value "\\frac{3}{8}" :db/ensure [:answer/validate]} {:db/id "question-a3bc7141-c1a8-5cbc-848c-a007152181e1" :question/id #uuid "a3bc7141-c1a8-5cbc-848c-a007152181e1" :question/math-academy-id "q-158459" :question/problem "Compute $P(X<2)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{4}{225}({x}^{3}-x),\\, & 1\\le x\\le 4, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a\\le X<b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSince $f(x)$ is identical to zero for all $x<1,$ we have\n\n$$\n\\begin{aligned}P(X<2) & ={\\int }_{1}^{2}f(x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}\\frac{4}{225}({x}^{3}-x)\\,\\text{d}x \\\\  & =\\frac{4}{225}{\\int }_{1}^{2}{x}^{3}-x\\,\\text{d}x \\\\  & =\\frac{4}{225}{[\\frac{1}{4}{x}^{4}-\\frac{1}{2}{x}^{2}]}_{1}^{2} \\\\  & =\\frac{4}{225}([\\frac{1}{4}(2)^{4}-\\frac{1}{2}(2)^{2}]-[\\frac{1}{4}(1)^{4}-\\frac{1}{2}(1)^{2}]) \\\\  & =\\frac{4}{225}(4-2-\\frac{1}{4}+\\frac{1}{2}) \\\\  & =\\frac{4}{225}\\cdot \\frac{9}{4} \\\\  & =\\frac{1}{25}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-975944ff-c1bd-5b70-9eec-fdb4a7dcd566"] :db/ensure [:question/validate]} {:db/id "answer-field-975944ff-c1bd-5b70-9eec-fdb4a7dcd566" :answer-field/id #uuid "975944ff-c1bd-5b70-9eec-fdb4a7dcd566" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bd067b86-c4e8-5816-83ca-9de842651e91" :answer-field/choices ["answer-bd067b86-c4e8-5816-83ca-9de842651e91" "answer-fab029a1-53e8-5c09-b2e6-2e023aa011da" "answer-f422e282-b77c-5a6a-a505-0044c35f1997" "answer-f8ecd07d-b247-51bd-a8c2-a9927c076572" "answer-4f26d7f1-c022-5659-bc20-fa461d0a022d"] :db/ensure [:answer-field/validate]} {:db/id "answer-bd067b86-c4e8-5816-83ca-9de842651e91" :answer/id #uuid "bd067b86-c4e8-5816-83ca-9de842651e91" :answer/type :answer.type/math :answer/value "\\frac{1}{25}" :db/ensure [:answer/validate]} {:db/id "answer-fab029a1-53e8-5c09-b2e6-2e023aa011da" :answer/id #uuid "fab029a1-53e8-5c09-b2e6-2e023aa011da" :answer/type :answer.type/math :answer/value "\\frac{1}{5}" :db/ensure [:answer/validate]} {:db/id "answer-f422e282-b77c-5a6a-a505-0044c35f1997" :answer/id #uuid "f422e282-b77c-5a6a-a505-0044c35f1997" :answer/type :answer.type/math :answer/value "\\frac{3}{5}" :db/ensure [:answer/validate]} {:db/id "answer-f8ecd07d-b247-51bd-a8c2-a9927c076572" :answer/id #uuid "f8ecd07d-b247-51bd-a8c2-a9927c076572" :answer/type :answer.type/math :answer/value "\\frac{4}{9}" :db/ensure [:answer/validate]} {:db/id "answer-4f26d7f1-c022-5659-bc20-fa461d0a022d" :answer/id #uuid "4f26d7f1-c022-5659-bc20-fa461d0a022d" :answer/type :answer.type/math :answer/value "\\frac{9}{25}" :db/ensure [:answer/validate]} {:db/id "question-a05ac3ca-da7d-5bdc-b9ed-2ee65cee279b" :question/id #uuid "a05ac3ca-da7d-5bdc-b9ed-2ee65cee279b" :question/math-academy-id "q-158421" :question/problem "Compute $P(-1<X<0)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{1}{12}({x}^{2}+2),\\, & -2\\le x\\le 1, \\\\ \\frac{1}{8} & 1<x\\le 3, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X<b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(-1<X<0) & ={\\int }_{-1}^{0}f(x)\\,\\text{d}x \\\\  & ={\\int }_{-1}^{0}\\frac{1}{12}({x}^{2}+2)\\,\\text{d}x \\\\  & =\\frac{1}{12}{[\\frac{1}{3}{x}^{3}+2x]}_{-1}^{0} \\\\  & =\\frac{1}{12}([\\frac{1}{3}(0)^{3}+2(0)]-[\\frac{1}{3}(-1)^{3}+2(-1)]) \\\\  & =\\frac{1}{12}(0+\\frac{1}{3}+2) \\\\  & =\\frac{1}{12}(\\frac{7}{3}) \\\\  & =\\frac{7}{36}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d0b9338f-ce76-54a7-9f1b-a16c716aaa54"] :db/ensure [:question/validate]} {:db/id "answer-field-d0b9338f-ce76-54a7-9f1b-a16c716aaa54" :answer-field/id #uuid "d0b9338f-ce76-54a7-9f1b-a16c716aaa54" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6c20cdc4-8968-5346-8c22-76a6ecf55625" :answer-field/choices ["answer-e2afce84-edf6-5026-8a56-a45c4ffb8701" "answer-f1943a76-0ce9-5efd-8b74-da642c9f9e88" "answer-384b21df-8a7c-5b30-9125-1330da362a5b" "answer-3e21377a-680e-57d6-80e2-410c96b326e9" "answer-6c20cdc4-8968-5346-8c22-76a6ecf55625"] :db/ensure [:answer-field/validate]} {:db/id "answer-e2afce84-edf6-5026-8a56-a45c4ffb8701" :answer/id #uuid "e2afce84-edf6-5026-8a56-a45c4ffb8701" :answer/type :answer.type/math :answer/value "\\frac{11}{36}" :db/ensure [:answer/validate]} {:db/id "answer-f1943a76-0ce9-5efd-8b74-da642c9f9e88" :answer/id #uuid "f1943a76-0ce9-5efd-8b74-da642c9f9e88" :answer/type :answer.type/math :answer/value "\\frac{5}{18}" :db/ensure [:answer/validate]} {:db/id "answer-384b21df-8a7c-5b30-9125-1330da362a5b" :answer/id #uuid "384b21d