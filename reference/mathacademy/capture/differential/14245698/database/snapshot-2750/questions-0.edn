c02-55dc-ad14-ef68af4fe858" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2<x<0" :db/id #edb/ref 17592186407103} {:answer/id #uuid "c0c3ae09-1abc-5587-9c24-5fe509b146bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\le x\\le 0" :db/id #edb/ref 17592186407104} {:answer/id #uuid "f99af401-4a27-5bd3-bd62-ea126d8fc033" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0\\le x\\le 0" :db/id #edb/ref 17592186407105}] :answer-field/correct {:answer/id #uuid "75e8591a-dc02-55dc-ad14-ef68af4fe858" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2<x<0" :db/id #edb/ref 17592186407103} :answer-field/id #uuid "8f40a659-1e0d-5b32-94de-7b630e906f3f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186407106}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8b1bfea3-dfec-5d1e-9126-a29ce02c9c56" :question/math-academy-id "q-64991" :question/problem "Consider the set $A,$ defined by \n\n$$\nA={(x,y)\\in {R}^{2}\\,:\\,-2\\le x<0,\\,0\\le y<2}\n$$\n\nThe interior of $A$ is given by\n\n$$\n\\text{int}\\,A={(x,y)\\in {R}^{2}\\,:\\,,\\,0<y<2\\,}.\n$$\n\nWhat is the missing expression?" :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nThe set $A$ and its boundary $∂A$ are shown below.\n\n![](images/71/71851a12f638da9604450cae0d50ed15187e850368890845d60b16b89e728bcf.png)\n\nThe interior of a set $A,$ denoted $\\text{int}\\,A,$ is the set containing all the interior points of $A.$ It contains every point in $A$ except the boundary points: \n\n$$\n\\text{int}\\,A=A-∂A\n$$\n\nThe interior of $A$ is shown below.\n\n![](images/ab/abdd434da59bb3a1bdc0ee7de398d7ea4aeae2f617f54b5a26a5bad871ba0ac4.png)\n\nSo, in this case, the interior of $A$ is given by\n\n$$\n\\text{int}\\,A={(x,y)\\in {R}^{2}\\,:\\,-2<x<0,\\,0<y<2\\,}.\n$$"}] [{:db/id #edb/ref 17592186379973 :knowledge-point/_questions [{:db/id #edb/ref 17592186192787 :knowledge-point/id #uuid "f89386f9-8a2b-56eb-8521-7c1ddafcfd96" :knowledge-point/title "Identifying the Interior of a Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d45f5dce-fcd5-570f-8c31-3764767c0f91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-x<y<0" :db/id #edb/ref 17592186379975} {:answer/id #uuid "0f01e28b-52d6-5e0a-8ffd-a45d4df949a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0\\le y\\le -x" :db/id #edb/ref 17592186379976} {:answer/id #uuid "06cc12c1-1f6e-5156-a18b-4ebea4dadd4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0<y\\le -x" :db/id #edb/ref 17592186379977} {:answer/id #uuid "aa30e3db-c47d-5d33-9a49-d7ba9c6e61f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0<y<-x" :db/id #edb/ref 17592186379978} {:answer/id #uuid "860d3ddb-5c51-56aa-8d19-8e1116fb9fae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-x\\le y<0" :db/id #edb/ref 17592186379979}] :answer-field/correct {:answer/id #uuid "aa30e3db-c47d-5d33-9a49-d7ba9c6e61f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0<y<-x" :db/id #edb/ref 17592186379978} :answer-field/id #uuid "62bd90ab-e399-5c06-9682-cc9127123490" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186379974}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7861d2f7-e3b6-5b7c-a05b-2009b500c4e2" :question/math-academy-id "q-71889" :question/problem "Consider the set $A,$ defined by \n\n$$\nA={(x,y)\\in {R}^{2}\\,:\\,-2<x<0,\\,0<y<-x}.\n$$\n\nThe interior of $A$ is given by\n\n$$\n\\text{int}\\,A={(x,y)\\in {R}^{2}\\,:\\,-2<x<0,\\,\\,}.\n$$\n\nWhat is the missing expression?" :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nThe set $A$ and its boundary $∂A$ are shown below.\n\n![](images/40/4073e99607c1e824f67b24bc93955b39c5b320901cd391ff3adb51444d1e1416.png)\n\nThe interior of a set $A,$ denoted $\\text{int}\\,A,$ is the set containing all the interior points of $A.$ It contains every point in $A$ except the boundary points: \n\n$$\n\\text{int}\\,A=A-∂A\n$$\n\nThe interior of $A$ is shown below.\n\n![](images/79/79e005cc03bb625657c652324db58db653882c640e94ea4b21a386676745bd14.png)\n\nSo, in this case, the interior of $A$ is given by\n\n$$\n\\text{int}\\,A={(x,y)\\in {R}^{2}\\,:\\,-2<x<0,\\,0<y<-x}.\n$$"}]}
