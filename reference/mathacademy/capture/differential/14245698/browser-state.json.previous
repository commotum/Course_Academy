      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14245698/observations/step-q35879-8a5781ebae5a60924ba3.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14245698/observations/step-q35879-8a5781ebae5a60924ba3.png",
      "source_url": "https://mathacademy.com/tasks/14245698/topics/4063/lesson",
      "captured_at": 1792105768.2242785,
      "math_academy_id": "q-35879",
      "topic_id": "4063",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q35879",
        "placement_id": null,
