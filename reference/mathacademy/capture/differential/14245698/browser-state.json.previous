      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14245698/observations/step-q161586-f7810a66d5eb9d2f4b59.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14245698/observations/step-q161586-f7810a66d5eb9d2f4b59.png",
