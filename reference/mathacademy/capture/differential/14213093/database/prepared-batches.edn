a51-2b25-530e-bc34-f2b29d7db7d9" :question/id #uuid "aa5d7a51-2b25-530e-bc34-f2b29d7db7d9"] ["question-aa5d7a51-2b25-530e-bc34-f2b29d7db7d9" :question/math-academy-id "q-94788"] ["question-aa5d7a51-2b25-530e-bc34-f2b29d7db7d9" :question/problem "Which of the following quadratic forms over ${R}^{3}$ are negative-definite?\n\nI. ${x}^{T}\\,Qx,$ where the eigenvalues of $Q$ are ${\\lambda }_{1}={\\lambda }_{2}=-3$ and ${\\lambda }_{3}=-9$\n\nII. ${x}^{T}\\,Rx,$ where the eigenvalues of $R$ are ${\\lambda }_{1}=0,$ ${\\lambda }_{2}=5$ and ${\\lambda }_{3}=-5$\n\nIII. ${x}^{T}\\,Sx,$ where the eigenvalues of $S$ are ${\\lambda }_{1}=-6,$ ${\\lambda }_{2}=10$ and ${\\lambda }_{3}=-3$"] ["question-aa5d7a51-2b25-530e-bc34-f2b29d7db7d9" :question/worked-solution "Given a quadratic form $Q(x)={x}^{T}Ax,$ we have the following theorem:\n\n- $Q$ is positive-definite if and only if all the eigenvalues of $A$ are positive,\n\n- $Q$ is positive semi-definite if and only if all the eigenvalues of $A$ are non-negative (note that positive semi-definite quadratic forms include all positive-definite quadratic forms),\n\n- $Q$ is negative-definite if and only if all the eigenvalues of $A$ are negative,\n\n- $Q$ is negative semi-definite if and only if all the eigenvalues of $A$ are non-positive (note that negative semi-definite quadratic forms include all negative-definite quadratic forms), and\n\n- $Q$ is indefinite if and only if $A$ has both positive and negative eigenvalues.\n\nWith that in mind, let's examine our quadratic forms in turn. \n\n- Quadratic form I is negative-definite. Indeed, all of the eigenvalues of $Q$ are negative.\n\n- Quadratic form II is *not* negative-definite since not all of the eigenvalues of $R$ are negative (for example, ${\\lambda }_{2}=5$ is not negative).\n\n- Quadratic form III is *not* negative-definite since not all of the eigenvalues of $S$ are negative (${\\lambda }_{2}=10$ is not negative).\n\nTherefore, the correct answer is \"I only.\""] ["question-aa5d7a51-2b25-530e-bc34-f2b29d7db7d9" :question/difficulty :question.difficulty/easy] ["answer-field-feddc0fa-b88d-5ca9-bd43-99d017ae0768" :answer-field/id #uuid "feddc0fa-b88d-5ca9-bd43-99d017ae0768"] ["answer-2274a1ba-cb09-551d-a264-6a5d4c0e37fd" :answer/id #uuid "2274a1ba-cb09-551d-a264-6a5d4c0e37fd"] ["answer-2274a1ba-cb09-551d-a264-6a5d4c0e37fd" :answer/type :answer.type/text] ["answer-2274a1ba-cb09-551d-a264-6a5d4c0e37fd" :answer/value "I and II only"] ["answer-2dffc13b-109f-56f9-902b-d52e5de34dcf" :answer/id #uuid "2dffc13b-109f-56f9-902b-d52e5de34dcf"] ["answer-2dffc13b-109f-56f9-902b-d52e5de34dcf" :answer/type :answer.type/text] ["answer-2dffc13b-109f-56f9-902b-d52e5de34dcf" :answer/value "I and III only"] ["answer-12d6028b-8c3e-5aba-826a-b147b99e2f9c" :answer/id #uuid "12d6028b-8c3e-5aba-826a-b147b99e2f9c"] ["answer-12d6028b-8c3e-5aba-826a-b147b99e2f9c" :answer/type :answer.type/text] ["answer-12d6028b-8c3e-5aba-826a-b147b99e2f9c" :answer/value "I only"] ["answer-1b4abab5-df3e-5347-99fb-84fa6de03a5e" :answer/id #uuid "1b4abab5-df3e-5347-99fb-84fa6de03a5e"] ["answer-1b4abab5-df3e-5347-99fb-84fa6de03a5e" :answer/type :answer.type/text] ["answer-1b4abab5-df3e-5347-99fb-84fa6de03a5e" :answer/value "II only"] ["answer-bca55a76-d282-5f41-9c77-abe46819afe7" :answer/id #uuid "bca55a76-d282-5f41-9c77-abe46819afe7"] ["answer-bca55a76-d282-5f41-9c77-abe46819afe7" :answer/type :answer.type/text] ["answer-bca55a76-d282-5f41-9c77-abe46819afe7" :answer/value "III only"] ["answer-field-feddc0fa-b88d-5ca9-bd43-99d017ae0768" :answer-field/key "selection"] ["answer-field-feddc0fa-b88d-5ca9-bd43-99d017ae0768" :answer-field/type :answer-field.type/radio] ["answer-field-feddc0fa-b88d-5ca9-bd43-99d017ae0768" :answer-field/correct "answer-12d6028b-8c3e-5aba-826a-b147b99e2f9c"] ["answer-field-feddc0fa-b88d-5ca9-bd43-99d017ae0768" :answer-field/choices "answer-2274a1ba-cb09-551d-a264-6a5d4c0e37fd"] ["answer-field-feddc0fa-b88d-5ca9-bd43-99d017ae0768" :answer-field/choices "answer-2dffc13b-109f-56f9-902b-d52e5de34dcf"] ["answer-field-feddc0fa-b88d-5ca9-bd43-99d017ae0768" :answer-field/choices "answer-12d6028b-8c3e-5aba-826a-b147b99e2f9c"] ["answer-field-feddc0fa-b88d-5ca9-bd43-99d017ae0768" :answer-field/choices "answer-1b4abab5-df3e-5347-99fb-84fa6de03a5e"] ["answer-field-feddc0fa-b88d-5ca9-bd43-99d017ae0768" :answer-field/choices "answer-bca55a76-d282-5f41-9c77-abe46819afe7"] ["question-aa5d7a51-2b25-530e-bc34-f2b29d7db7d9" :question/answer-fields "answer-field-feddc0fa-b88d-5ca9-bd43-99d017ae0768"] [17592186162009 :knowledge-point/questions "question-aa5d7a51-2b25-530e-bc34-f2b29d7db7d9"] ["question-95072baf-8f6f-5ac9-b278-bac347e84d65" :question/id #uuid "95072baf-8f6f-5ac9-b278-bac347e84d65"] ["question-95072baf-8f6f-5ac9-b278-bac347e84d65" :question/math-academy-id "q-94796"] ["question-95072baf-8f6f-5ac9-b278-bac347e84d65" :question/problem "Consider the matrix $A=[\\begin{aligned}-5 & 1 \\\\ 1 & -5\\end{aligned}].$ Which of the following statements are true?\n\nI. The eigenvalues of $A$ are ${\\lambda }_{1}=4$ and ${\\lambda }_{2}=6$\n\nII. ${x}^{T}\\,A\\,x$ is negative-definite\n\nIII. $A$ is positive-definite"] ["question-95072baf-8f6f-5ac9-b278-bac347e84d65" :question/worked-solution "Given a quadratic form $Q(x)={x}^{T}Ax,$ we have the following theorem:\n\n- $Q$ is positive-definite if and only if all the eigenvalues of $A$ are positive,\n\n- $Q$ is positive semi-definite if and only if all the eigenvalues of $A$ are non-negative (note that positive semi-definite quadratic forms include all positive-definite quadratic forms),\n\n- $Q$ is negative-definite if and only if all the eigenvalues of $A$ are negative,\n\n- $Q$ is negative semi-definite if and only if all the eigenvalues of $A$ are non-positive (note that negative semi-definite quadratic forms include all negative-definite quadratic forms), and\n\n- $Q$ is indefinite if and only if $A$ has both positive and negative eigenvalues.\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is false. Computing the characteristic equation of $A,$ we obtain\n\n$$\n\\begin{aligned}|A-\\lambda I| & =0 \\\\ |\\begin{aligned}-5-\\lambda  & 1 \\\\ 1 & -5-\\lambda \\end{aligned}| & =0 \\\\ (-5-\\lambda )(-5-\\lambda )-1 & =0 \\\\ {\\lambda }^{2}+10\\lambda +24 & =0 \\\\ \\lambda  & =-6,\\,-4.\\end{aligned}\n$$\n\n- Statement II is true, while statement III is false. Since all the eigenvalues of $A$ are negative, the quadratic form ${x}^{T}\\,A\\,x$ (as well as the matrix $A$) is negative-definite.\n\nTherefore, the correct answer is \"II only.\""] ["question-95072baf-8f6f-5ac9-b278-bac347e84d65" :question/difficulty :question.difficulty/moderate] ["answer-field-fc3a16ca-ab9d-5910-8403-1994cf7ec17a" :answer-field/id #uuid "fc3a16ca-ab9d-5910-8403-1994cf7ec17a"] ["answer-a5a717d0-ad06-5979-9d2e-d3fb8cedc6ac" :answer/id #uuid "a5a717d0-ad06-5979-9d2e-d3fb8cedc6ac"] ["answer-a5a717d0-ad06-5979-9d2e-d3fb8cedc6ac" :answer/type :answer.type/text] ["answer-a5a717d0-ad06-5979-9d2e-d3fb8cedc6ac" :answer/value "I and II only"] ["answer-4c8fe2d0-662b-51dd-836f-b0095a0df130" :answer/id #uuid "4c8fe2d0-662b-51dd-836f-b0095a0df130"] ["answer-4c8fe2d0-662b-51dd-836f-b0095a0df130" :answer/type :answer.type/text] ["answer-4c8fe2d0-662b-51dd-836f-b0095a0df130" :answer/value "I and III only"] ["answer-df3ce743-bd9f-55c4-aa50-daa5ef48006d" :answer/id #uuid "df3ce743-bd9f-55c4-aa50-daa5ef48006d"] ["answer-df3ce743-bd9f-55c4-aa50-daa5ef48006d" :answer/type :answer.type/text] ["answer-df3ce743-bd9f-55c4-aa50-daa5ef48006d" :answer/value "I only"] ["answer-34e801a5-3875-5ecd-b05f-15545a5c3b9f" :answer/id #uuid "34e801a5-3875-5ecd-b05f-15545a5c3b9f"] ["answer-34e801a5-3875-5ecd-b05f-15545a5c3b9f" :answer/type :answer.type/text] ["answer-34e801a5-3875-5ecd-b05f-15545a5c3b9f" :answer/value "II only"] ["answer-342fba80-10c2-55b1-8abf-7ff9c9e264ed" :answer/id #uuid "342fba80-10c2-55b1-8abf-7ff9c9e264ed"] ["answer-342fba80-10c2-55b1-8abf-7ff9c9e264ed" :answer/type :answer.type/text] ["answer-342fba80-10c2-55b1-8abf-7ff9c9e264ed" :answer/value "III only"] ["answer-field-fc3a16ca-ab9d-5910-8403-1994cf7ec17a" :answer-field/key "selection"] ["answer-field-fc3a16ca-ab9d-5910-8403-1994cf7ec17a" :answer-field/type :answer-field.type/radio] ["answer-field-fc3a16ca-ab9d-5910-8403-1994cf7ec17a" :answer-field/correct "answer-34e801a5-3875-5ecd-b05f-15545a5c3b9f"] ["answer-field-fc3a16ca-ab9d-5910-8403-1994cf7ec17a" :answer-field/choices "answer-a5a717d0-ad06-5979-9d2e-d3fb8cedc6ac"] ["answer-field-fc3a16ca-ab9d-5910-8403-1994cf7ec17a" :answer-field/choices "answer-4c8fe2d0-662b-51dd-836f-b0095a0df130"] ["answer-field-fc3a16ca-ab9d-5910-8403-1994cf7ec17a" :answer-field/choices "answer-df3ce743-bd9f-55c4-aa50-daa5ef48006d"] ["answer-field-fc3a16ca-ab9d-5910-8403-1994cf7ec17a" :answer-field/choices "answer-34e801a5-3875-5ecd-b05f-15545a5c3b9f"] ["answer-field-fc3a16ca-ab9d-5910-8403-1994cf7ec17a" :answer-field/choices "answer-342fba80-10c2-55b1-8abf-7ff9c9e264ed"] ["question-95072baf-8f6f-5ac9-b278-bac347e84d65" :question/answer-fields "answer-field-fc3a16ca-ab9d-5910-8403-1994cf7ec17a"] [17592186162009 :knowledge-point/questions "question-95072baf-8f6f-5ac9-b278-bac347e84d65"] ["question-7aa930b4-3c77-5008-aaf5-9bbf298703c7" :question/id #uuid "7aa930b4-3c77-5008-aaf5-9bbf298703c7"] ["question-7aa930b4-3c77-5008-aaf5-9bbf298703c7" :question/math-academy-id "q-94800"] ["question-7aa930b4-3c77-5008-aaf5-9bbf298703c7" :question/problem "Consider the matrix $A=[\\begin{aligned}-7 & 2 \\\\ 2 & -1\\end{aligned}].$ Which of the following statements are true?\n\nI. ${a}_{11}=-7$ and $det(A)=-3$\n\nII. ${x}^{T}\\,A\\,x$ is negative-definite\n\nIII. $A$ is positive-definite"] ["question-7aa930b4-3c77-5008-aaf5-9bbf298703c7" :question/worked-solution "Let ${Δ}_{i}$ for $i=1,2,…,n$  denote the leading principal minors of an $n\\times n$ matrix $A.$ Then, according to Sylvester's criterion, the quadratic form ${x}^{T}\\,A\\,x$ (as well as the matrix $A$) is \n\n- positive-definite if and only if ${Δ}_{i}>0$ for all $i=1,2,…,n,$\n\n- negative-definite if and only if, for all $i=1,2,…,n,$ we have ${Δ}_{i}<0$ when $i$ is odd, and ${Δ}_{i}>0$ when $i$ is even.\n\nWith that in mind, let's examine each of the statements in turn.\n\n- Statement I is false. Indeed, ${a}_{11}=-7$ and \n\n$$\ndet(A)=|\\begin{aligned}-7 & 2 \\\\ 2 & -1\\end{aligned}|=3.\n$$\n\n- Statement II is true, while statement III is false. Notice that\n\n$$\n\\begin{aligned}{Δ}_{1} & ={a}_{11}=-7<0, \\\\ {Δ}_{2} & =|\\begin{aligned}-7 & 2 \\\\ 2 & -1\\end{aligned}|=3>0.\\end{aligned}\n$$\n\nSo, by Sylvester's criterion, the quadratic form ${x}^{T}\\,A\\,x,$ and the matrix $A,$ are negative-definite.\n\nTherefore, the correct answer is \"II only.\""] ["question-7aa930b4-3c77-5008-aaf5-9bbf298703c7" :question/difficulty :question.difficulty/moderate] ["answer-field-079db36a-f121-5453-be8e-d40d62051237" :answer-field/id #uuid "079db36a-f121-5453-be8e-d40d62051237"] ["answer-a1ff6a24-e096-5a38-adf3-8f6baa63dc90" :answer/id #uuid "a1ff6a24-e096-5a38-adf3-8f6baa63dc90"] ["answer-a1ff6a24-e096-5a38-adf3-8f6baa63dc90" :answer/type :answer.type/text] ["answer-a1ff6a24-e096-5a38-adf3-8f6baa63dc90" :answer/value "I and II only"] ["answer-3543723c-355b-52c7-b10b-104509d59ebd" :answer/id #uuid "3543723c-355b-52c7-b10b-104509d59ebd"] ["answer-3543723c-355b-52c7-b10b-104509d59ebd" :answer/type :answer.type/text] ["answer-3543723c-355b-52c7-b10b-104509d59ebd" :answer/value "I and III only"] ["answer-1c770309-60dd-57d9-8388-da614d588229" :answer/id #uuid "1c770309-60dd-57d9-8388-da614d588229"] ["answer-1c770309-60dd-57d9-8388-da614d588229" :answer/type :answer.type/text] ["answer-1c770309-60dd-57d9-8388-da614d588229" :answer/value "I only"] ["answer-f936acee-b9ba-5a2d-aab8-0d02b6a64ffc" :answer/id #uuid "f936acee-b9ba-5a2d-aab8-0d02b6a64ffc"] ["answer-f936acee-b9ba-5a2d-aab8-0d02b6a64ffc" :answer/type :answer.type/text] ["answer-f936acee-b9ba-5a2d-aab8-0d