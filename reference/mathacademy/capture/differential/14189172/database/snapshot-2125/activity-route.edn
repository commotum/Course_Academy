#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186503807} :activity/id #uuid "a0a97922-c29e-5eb9-a00b-a08031d2cade" :activity/scope {:db/id #edb/ref 17592186049899 :topic/id #uuid "1cb109e6-3987-5c41-9a55-81f03d70697e" :topic/math-academy-id 3274} :activity/steps [{:db/id #edb/ref 17592186503771 :step/content {:db/id #edb/ref 17592186503735 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "380c1b05-6c1c-5ffd-bc5c-a04c05c5c687" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.6288" :db/id #edb/ref 17592186503080} {:answer/id #uuid "5577f8d1-9f94-5c6f-ba9c-92f1736f818d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.4558" :db/id #edb/ref 17592186503144} {:answer/id #uuid "6e80960c-3886-58dd-b64a-4e2557138902" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.6512" :db/id #edb/ref 17592186503203} {:answer/id #uuid "d2d579dc-32ed-5798-98c2-1ace09760f2a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.3516" :db/id #edb/ref 17592186503400} {:answer/id #uuid "d834d903-ffee-58a0-92db-9ab0051f1e9d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.5470" :db/id #edb/ref 17592186503412}] :answer-field/correct {:db/id #edb/ref 17592186503412} :answer-field/id #uuid "a20cf601-9154-52ab-ba75-6f001245e333" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186503597}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "b92762e3-576d-55cb-b009-a97e0be6338a" :question/math-academy-id "q-225067" :question/problem "Using the cumulative distribution function table of the Poisson random variable $X∼\\text{Po}(4)$ given below, compute $P(3\\le X<6).$\n\n| $\\,x\\,$ | $1$ | $2$ | $3$ | $4$ | $5$ | $6$ | $7$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $P(X\\le x)$ | $\\,0.0916\\,$ | $\\,0.2381\\,$ | $\\,0.4335\\,$ | $\\,0.6288\\,$ | $\\,0.7851\\,$ | $\\,0.8893\\,$ | $\\,0.9489\\,$ |" :question/worked-solution "The cumulative distribution function of a discrete random variable $X$ is a function $F(x)$ such that\n\n$$\nF(x)=P(X\\le x).\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}F(5) & =P(X<6) \\\\  & =P(X\\in \\{0,1,2,3,4,5\\}) \\\\  & =P(X\\in \\{0,1,2\\})+P(X\\in \\{3,4,5\\}) \\\\  & =P(X\\le 2)+P(3\\le X<6) \\\\  & =F(2)+P(3\\le X<6).\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(3\\le X<6) & =F(5)-F(2) \\\\  & =0.7851-0.2381 \\\\  & =0.5470.\\end{aligned}\n$$"} :step/id #uuid "21d06828-9a3e-5396-9154-89624675cb97" :step/next {:db/id #edb/ref 17592186503827}} {:db/id #edb/ref 17592186503803 :step/content {:db/id #edb/ref 17592186503678 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "79a1b4b4-0c8f-509b-96be-e81e96d0cf38" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.4001" :db/id #edb/ref 17592186503229}] :answer-field/correct {:db/id #edb/ref 17592186503229} :answer-field/id #uuid "8bb07aaf-fd25-5aa9-a148-43a824ecca08" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186503584}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3df054eb-2d42-57cd-ac48-5335659c80b9" :question/math-academy-id "q-225055" :question/problem "Using the cumulative distribution function table of the Poisson random variable $X∼\\text{Po}(5)$ given below, compute $P(2\\le X\\le 4).$\n\n| $\\,x\\,$ | $0$ | $1$ | $2$ | $3$ | $4$ | $5$ | $6$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $P(X\\le x)$ | $\\,0.0067\\,$ | $\\,0.0404\\,$ | $\\,0.1247\\,$ | $\\,0.2650\\,$ | $\\,0.4405\\,$ | $\\,0.6160\\,$ | $\\,0.7622\\,$ |\n\n$P(2\\le X\\le 4)=$\n{{field-1}}" :question/worked-solution "The cumulative distribution function of a discrete random variable $X$ is a function $F(x)$ such that\n\n$$\nF(x)=P(X\\le x).\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}F(4) & =P(X\\le 4) \\\\  & =P(X\\in \\{0,1,2,3,4\\}) \\\\  & =P(X\\in \\{0,1\\})+P(X\\in \\{2,3,4\\}) \\\\  & =P(X\\le 1)+P(2\\le X\\le 4) \\\\  & =F(1)+P(2\\le X\\le 4).\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(2\\le X\\le 4) & =F(4)-F(1) \\\\  & =0.4405-0.0404 \\\\  & =0.4001.\\end{aligned}\n$$"} :step/id #uuid "84e1ee1a-4b89-5aa4-b30a-3a5d79ef978f" :step/next {:db/id #edb/ref 17592186503771}} {:db/id #edb/ref 17592186503807 :step/content {:db/id #edb/ref 17592186503716 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "072af78c-0cf5-586f-bc53-ad8197623ca0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.3239" :db/id #edb/ref 17592186502995} {:answer/id #uuid "23093e91-9f8a-526f-b9fe-a4c366c326dc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.2068" :db/id #edb/ref 17592186503048} {:answer/id #uuid "a6c5ad47-e307-560d-aa30-f635fcf6ddd7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.1171" :db/id #edb/ref 17592186503318} {:answer/id #uuid "ddc0b37a-e911-5ce6-b543-981451964978" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.5307" :db/id #edb/ref 17592186503430} {:answer/id #uuid "fe79ce86-a670-57ab-ab9f-302046099afd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.4557" :db/id #edb/ref 17592186503508}] :answer-field/correct {:db/id #edb/ref 17592186502995} :answer-field/id #uuid "03d92468-cb05-508e-bcd0-42d2b482d3c9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186503515}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "951aecd2-9a03-5921-a647-8badf487101e" :question/math-academy-id "q-224995" :question/problem "Using the cumulative distribution function table of the Poisson random variable $X∼\\text{Po}(9)$ given below, find the value of $P(X\\le 7).$\n\n| $\\,x\\,$ | $3$ | $4$ | $5$ | $6$ | $7$ | $8$ | $9$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $P(X\\le x)$ | $\\,0.0212\\,$ | $\\,0.0550\\,$ | $\\,0.1157\\,$ | $\\,0.2068\\,$ | $\\,0.3239\\,$ | $\\,0.4557\\,$ | $\\,0.5874\\,$ |" :question/worked-solution "The cumulative distribution function of a discrete random variable $X$ is a function $F(x)$ such that\n\n$$\nF(x)=P(X\\le x).\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(X\\le 7) & =F(7) \\\\  & =0.3239.\\end{aligned}\n$$"} :step/id #uuid "8fc62da4-3a4c-5a53-bfc2-793fee1d81cb" :step/next {:db/id #edb/ref 17592186503815}} {:db/id #edb/ref 17592186503815 :step/content {:db/id #edb/ref 17592186503704 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "871b12f6-b300-5aad-9c37-0f6b3ba75025" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.7664" :db/id #edb/ref 17592186503257} {:answer/id #uuid "b364a7c4-21e7-540e-8e24-cda36eac8906" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.5925" :db/id #edb/ref 17592186503347} {:answer/id #uuid "bf85c091-12aa-55ce-9c65-94896b0eada1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.7166" :db/id #edb/ref 17592186503363} {:answer/id #uuid "e4a0a61b-0e09-5891-9fdf-a1c86f0ad38d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.1241" :db/id #edb/ref 17592186503448} {:answer/id #uuid "f31f3176-4cec-53f7-9c8b-c339b62c86e0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.8159" :db/id #edb/ref 17592186503476}] :answer-field/correct {:db/id #edb/ref 17592186503347} :answer-field/id #uuid "b0b47d28-52ea-5db5-8d68-c29eb95437d3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186503605}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7c63f903-029e-5df7-9333-d7481c32658b" :question/math-academy-id "q-224997" :question/problem "Using the cumulative distribution function table of the Poisson random variable $X∼\\text{Po}(8)$ given below, compute $P(X<9).$\n\n| $\\,x\\,$ | $4$ | $5$ | $6$ | $7$ | $8$ | $9$ | $10$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $P(X\\le x)$ | $\\,0.0996\\,$ | $\\,0.1912\\,$ | $\\,0.3134\\,$ | $\\,0.4530\\,$ | $\\,0.5925\\,$ | $\\,0.7166\\,$ | $\\,0.8159\\,$ |" :question/worked-solution "The cumulative distribution function of a discrete random variable $X$ is a function $F(x)$ such that\n\n$$\nF(x)=P(X\\le x).\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(X<9) & =P(X\\in \\{0,1,…,8\\}) \\\\  & =P(X\\le 8) \\\\  & =F(8) \\\\  & =0.5925.\\end{aligned}\n$$"} :step/id #uuid "b2ab6c64-abb3-5af6-ae48-fa7ca76e80c7" :step/next {:db/id #edb/ref 17592186503803}} {:db/id #edb/ref 17592186503827 :step/content {:db/id #edb/ref 17592186503693 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d77a7660-717e-5f04-b7b5-229f67d8428a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.2936" :db/id #edb/ref 17592186503408}] :answer-field/correct {:db/id #edb/ref 17592186503408} :answer-field/id #uuid "7dda7cdb-4dec-5905-b4f9-bd936abe49ba" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186503572}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5f03e36d-2709-59cb-981a-892881905e64" :question/math-academy-id "q-225087" :question/problem "Using the cumulative distribution function table of the Poisson random variable $X∼\\text{Po}(3.6)$ given below, compute $P(X\\ge 5).$\n\n| $\\,x\\,$ | $3$ | $4$ | $5$ | $6$ | $7$ | $8$ | $9$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $P(X\\le x)$ | $\\,0.5152\\,$ | $\\,0.7064\\,$ | $\\,0.8441\\,$ | $\\,0.9267\\,$ | $\\,0.9692\\,$ | $\\,0.9883\\,$ | $\\,0.9960\\,$ |\n\n$P(X\\ge 5)=$\n{{field-1}}" :question/worked-solution "The cumulative distribution function of a discrete random variable $X$ is a function $F(x)$ such that\n\n$$\nF(x)=P(X\\le x).\n$$\n\nTo solve the given problem, we can use the rule\n\n$$\nP(X>a)=1-P(X\\le a)=1-F(a).\n$$\n\nNow, note that \n\n$$\nP(X\\ge 5)=P(X>4).\n$$\n\n \n\nTherefore, we have\n\n$$\n\\begin{aligned}P(X\\ge 5) & =P(X>4) \\\\  & =1-P(X\\le 4) \\\\  & =1-F(4) \\\\  & =1-0.7064 \\\\  & =0.2936.\\end{aligned}\n$$"} :step/id #uuid "cea9281b-2c6b-5557-b332-58513c78c6dd"}] :activity/title "The CDF of the Poisson Distribution" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186502972}]}
