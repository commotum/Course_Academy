\"false\">)</mo><mn>2</mn></msup></mrow><mn>5</mn></mfrac></mstyle></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mn>1</mn></mtd></mtr><mtr><mtd><mo stretchy=\"false\">(</mo><mi>x</mi><mo>+</mo><mn>4</mn><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mn>5</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>This equation has no (real) solutions.</p>\n<p>Therefore, the hyperboloid does not intersect the <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"24\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D465 TEX-I\"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math></mjx-assistive-mml></mjx-container>-axis.</p>\n</div></div>",
