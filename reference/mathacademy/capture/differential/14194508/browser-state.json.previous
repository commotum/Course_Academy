jx-c></mjx-mo><mjx-msup space=\"3\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D465 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: 0.413em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-script></mjx-msup><mjx-tstrut></mjx-tstrut></mjx-mtd><mjx-mtd style=\"text-align: left; padding-left: 0px; padding-top: 0.4em;\"><mjx-mi class=\"mjx-n\"></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn><mjx-tstrut></mjx-tstrut></mjx-mtd></mjx-mtr></mjx-itable></mjx-table></mjx-mtable></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mtable displaystyle=\"true\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"0.8em 0.8em 0.3em\"><mtr><mtd><msup><mi>x</mi><mn>2</mn></msup><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><msup><mi>y</mi><mn>2</mn></msup><mn>6</mn></mfrac></mstyle><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><msup><mn>0</mn><mn>2</mn></msup><mn>4</mn></mfrac></mstyle></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mn>1</mn></mtd></mtr><mtr><mtd><msup><mi>x</mi><mn>2</mn></msup><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><msup><mi>y</mi><mn>2</mn></msup><mn>6</mn></mfrac></mstyle></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mn>1</mn></mtd></mtr><mtr><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><msup><mi>y</mi><mn>2</mn></msup><mn>6</mn></mfrac></mstyle><mo>−</mo><msup><mi>x</mi><mn>2</mn></msup></mtd><mtd><mi></mi><mo>=</mo><mn>1</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>This gives us the equation of the hyperbola in <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"229\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=