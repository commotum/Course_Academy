mo><mtable columnspacing=\"1em\" rowspacing=\"4pt\"><mtr><mtd><mn>15</mn></mtd></mtr><mtr><mtd><mo>−</mo><mn>3</mn></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow><mo data-mjx-texclass=\"CLOSE\">}</mo></mrow><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mo>=</mo><mn>2.</mn></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
