4a4f-5258-bc4b-8b18611c412d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3(1+\\sqrt{1-t})" :db/id #edb/ref 17592186569559} {:answer/id #uuid "90e3da05-aacf-5f13-859e-cd646558384f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1+\\sqrt{1-t}}{3}" :db/id #edb/ref 17592186569672} {:answer/id #uuid "c4784f20-700b-5193-9d79-5c5d10119b44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3t(1+\\sqrt{1-t})}{2}" :db/id #edb/ref 17592186569752} {:answer/id #uuid "dad32430-bd0b-52bf-9c2e-17412e09f115" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1+\\sqrt{1-t}}{2}" :db/id #edb/ref 17592186569789}] :answer-field/correct {:answer/id #uuid "4f7f5fd8-4a4f-5258-bc4b-8b18611c412d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3(1+\\sqrt{1-t})" :db/id #edb/ref 17592186569559} :answer-field/id #uuid "cc06a8d8-50aa-5640-bc51-88b6bf88a0d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569927}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ad79abb9-c428-5a43-aa85-5dde8ceb1da4" :question/math-academy-id "q-111086" :question/problem "Rationalize the denominator of $\\frac{3t}{1-\\sqrt{1-t}}.$" :question/worked-solution "First, note that the denominator's conjugate is $1+\\sqrt{1-t}.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $1+\\sqrt{1-t},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{3t}{1-\\sqrt{1-t}} & = \\\\ \\frac{3t}{1-\\sqrt{1-t}}\\cdot \\frac{1+\\sqrt{1-t}}{1+\\sqrt{1-t}} & = \\\\ \\frac{3t(1+\\sqrt{1-t})}{(1-\\sqrt{1-t})(1+\\sqrt{1-t})} & = \\\\ \\frac{3t(1+\\sqrt{1-t})}{{1}^{2}-(\\sqrt{1-t})^{2}} & = \\\\ \\frac{3t(1+\\sqrt{1-t})}{1-(1-t)} & = \\\\ \\frac{3\\cancel{t}(1+\\sqrt{1-t})}{\\cancel{t}} & = \\\\ 3(1+\\sqrt{1-t}) & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186569992 :knowledge-point/_questions [{:db/id #edb/ref 17592186213018 :knowledge-point/id #uuid "fa5d982f-ff13-5a31-9cd3-d5847ea2790c" :knowledge-point/title "Rationalizing Denominators Containing a Binomial Within the Radical"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0273e2de-cefa-57b0-ad98-a84b729c417a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2{r}^{2}(\\sqrt{2r-1}+1)}{r-1}" :db/id #edb/ref 17592186569449} {:answer/id #uuid "5cc92496-09f1-5f1a-8946-cc0ca6917179" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{r}^{2}(\\sqrt{2r-1}+1)}{r-4}" :db/id #edb/ref 17592186569579} {:answer/id #uuid "84fb11aa-f083-582f-84d7-266a467070fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4{r}^{2}(\\sqrt{2r-1}+1)}{r-1}" :db/id #edb/ref 17592186569663} {:answer/id #uuid "e69b51c1-8417-56a6-934c-f1efd30054b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{r}^{2}(\\sqrt{2r-1}+1)}{r-2}" :db/id #edb/ref 17592186569809} {:answer/id #uuid "e7997637-1b0c-51ea-8e35-3be1310d3e9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2{r}^{2}(\\sqrt{2r-1}+1)}{r-2}" :db/id #edb/ref 17592186569812}] :answer-field/correct {:answer/id #uuid "0273e2de-cefa-57b0-ad98-a84b729c417a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2{r}^{2}(\\sqrt{2r-1}+1)}{r-1}" :db/id #edb/ref 17592186569449} :answer-field/id #uuid "62a892d6-ff55-5220-9118-e2d113d46140" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569886}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "57f8edcf-bb4c-5c62-90a9-46d6df888cba" :question/math-academy-id "q-111087" :question/problem "Rationalize the denominator of $\\frac{4{r}^{2}}{\\sqrt{2r-1}-1}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{2r-1}+1.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{2r-1}+1,$ and simplify:\n\n$$\n\\begin{aligned}\\frac{4{r}^{2}}{\\sqrt{2r-1}-1} & = \\\\ \\frac{4{r}^{2}}{\\sqrt{2r-1}-1}\\cdot \\frac{\\sqrt{2r-1}+1}{\\sqrt{2r-1}+1} & = \\\\ \\frac{4{r}^{2}(\\sqrt{2r-1}+1)}{(\\sqrt{2r-1}-1)(\\sqrt{2r-1}+1)} & = \\\\ \\frac{4{r}^{2}(\\sqrt{2r-1}+1)}{(\\sqrt{2r-1})^{2}-{1}^{2}} & = \\\\ \\frac{4{r}^{2}(\\sqrt{2r-1}+1)}{2r-1-1} & = \\\\ \\frac{4{r}^{2}(\\sqrt{2r-1}+1)}{2r-2} & = \\\\ \\frac{2{r}^{2}(\\sqrt{2r-1}+1)}{r-1} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186570014 :knowledge-point/_questions [{:db/id #edb/ref 17592186213019 :knowledge-point/id #uuid "43395cdf-3e16-5147-87fb-371193078b4a" :knowledge-point/title "Rationalizing a Denominator With Two Radicals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f1bbe86-ce5f-55c6-8bed-f62f18b202e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{t}+\\sqrt{t-2}}{t}" :db/id #edb/ref 17592186569510} {:answer/id #uuid "4a192ac0-05c0-5288-be68-d3263570531f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2(\\sqrt{t}+\\sqrt{t-2})}{t}" :db/id #edb/ref 17592186569543} {:answer/id #uuid "511af3b2-ea1f-55c1-89be-5b613e2e87d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4(\\sqrt{t}+\\sqrt{t-2})}{t}" :db/id #edb/ref 17592186569562} {:answer/id #uuid "6129f7be-7cf7-5ba4-b20f-0e5ef3758570" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4(\\sqrt{t}+\\s