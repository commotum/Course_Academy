#{[{:db/id #edb/ref 17592186212794 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186213017 :knowledge-point/id #uuid "e9139c75-1189-5b78-9d82-023f5208a490" :knowledge-point/title "Rationalizing Denominators Containing Two Terms"}] :question/id #uuid "659e7fd3-3502-5a47-a54c-3d0c33150d73" :question/math-academy-id "e-18928" :question/problem "Rationalize the denominator of $\\dfrac{1}{3-\\sqrt a}$." :question/worked-solution "First, note that the denominator's conjugate is $3+\\sqrt a$.\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $3+\\sqrt a$, and simplify:\n\n$$\n\\begin{aligned}\n\\frac{1}{3 - \\sqrt{a}} &=  \\\\\n\\frac{1}{3 - \\sqrt{a}} \\cdot \\frac{3 + \\sqrt{a}}{3 + \\sqrt{a}} &=  \\\\\n(3 + \\sqrt{a})/((3 - \\sqrt{a})(3 + \\sqrt{a})) &=  \\\\\n(3 + \\sqrt{a})/(3^{2} - (\\sqrt{a})^{2}) &=  \\\\\n&= \\frac{3 + \\sqrt{a}}{9 - a}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186212795 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186213018 :knowledge-point/id #uuid "fa5d982f-ff13-5a31-9cd3-d5847ea2790c" :knowledge-point/title "Rationalizing Denominators Containing a Binomial Within the Radical"}] :question/id #uuid "dfb7701e-d11b-52a0-97fb-8363b1ff0901" :question/math-academy-id "e-18929" :question/problem "Rationalize the denominator of $\\dfrac {x} {\\sqrt{x+1}+1}$." :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{x+1}-1$.\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{x+1}-1$, and simplify:\n\n$$\n\\begin{aligned} \\dfrac {x} {\\sqrt{x+1}+1} \\\\[5pt] &= \\dfrac {x} {\\sqrt{x+1}+1}\\cdot \\dfrac{\\sqrt{x+1}-1}{\\sqrt{x+1}-1} \\\\[5pt] &= \\dfrac {x(\\sqrt{x+1}-1)} {(\\sqrt{x+1}+1)(\\sqrt{x+1}-1)} \\\\[5pt] &= \\dfrac {x(\\sqrt{x+1}-1)} {(\\sqrt{x+1})^2-1^2} \\\\[5pt] &= \\dfrac {x(\\sqrt{x+1}-1)} {x+1-1} \\\\[5pt] &= \\dfrac {x(\\sqrt{x+1}-1)} {x} \\\\[5pt] &= \\sqrt{x+1}-1 \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186212796 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186213019 :knowledge-point/id #uuid "43395cdf-3e16-5147-87fb-371193078b4a" :knowledge-point/title "Rationalizing a Denominator With Two Radicals"}] :question/id #uuid "4bcf9ec5-b5a1-5ab2-bb9f-f22280e072ae" :question/math-academy-id "e-18930" :question/problem "Rationalize the denominator of $\\dfrac{x}{\\sqrt{2}-\\sqrt{x}}$." :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{2}+\\sqrt{x}$.\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{2}+\\sqrt{x}$, and simplify:\n\n$$\n\\begin{aligned} \\dfrac{x}{\\sqrt{2}-\\sqrt{x}} \\\\[5pt] &= \\dfrac{x}{\\sqrt{2}-\\sqrt{x}} \\cdot \\dfrac{\\sqrt{2}+\\sqrt{x}}{\\sqrt{2}+\\sqrt{x}} \\\\[5pt] &= \\dfrac{x(\\sqrt{2}+\\sqrt{x})}{(\\sqrt{2}-\\sqrt{x})(\\sqrt{2}+\\sqrt{x})} \\\\[5pt] &= \\dfrac{x(\\sqrt{2}+\\sqrt{x})}{(\\sqrt{2})^2-(\\sqrt{x})^2} \\\\[5pt] &= \\dfrac{x(\\sqrt{2}+\\sqrt{x})}{2-x} \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186570031 :knowledge-point/_questions [{:db/id #edb/ref 17592186213017 :knowledge-point/id #uuid "e9139c75-1189-5b78-9d82-023f5208a490" :knowledge-point/title "Rationalizing Denominators Containing Two Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07490dcd-1d48-5d43-b184-f74901680c80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{t(\\sqrt{t}-2)}{{t}^{2}-4}" :db/id #edb/ref 17592186569457} {:answer/id #uuid "3b01c92b-0e73-5e47-985c-a0f88f58ee99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{t}^{2}(\\sqrt{t}-2)}{{t}^{2}-4}" :db/id #edb/ref 17592186569524} {:answer/id #uuid "881aef92-cb00-57f1-a26c-bbcc579a0047" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{t(\\sqrt{t}-2)}{t-4}" :db/id #edb/ref 17592186569667} {:answer/id #uuid "9da858ca-2c7e-50ba-bdf0-dace67270f08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{t}^{2}(\\sqrt{t}-2)}{t-2}" :db/id #edb/ref 17592186569695} {:answer/id #uuid "bdcfb4fe-239c-5f02-aef3-366ababc7e75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{t(\\sqrt{t}-2)}{t-2}" :db/id #edb/ref 17592186569746}] :answer-field/correct {:answer/id #uuid "881aef92-cb00-57f1-a26c-bbcc579a0047" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{t(\\sqrt{t}-2)}{t-4}" :db/id #edb/ref 17592186569667} :answer-field/id #uuid "58d07260-1021-54bf-a6eb-cc2bfc3a0615" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569880}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dad03d87-b391-52d0-a812-6cdef4bf6aad" :question/math-academy-id "q-111070" :question/problem "Rationalize the denominator of $\\frac{t}{\\sqrt{t}+2}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{t}-2.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{t}-2,$ and simplify:\n\n$$\n\\begin{aligned}\\frac{t}{\\sqrt{t}+2} & = \\\\ \\frac{t}{\\sqrt{t}+2}\\cdot \\frac{\\sqrt{t}-2}{\\sqrt{t}-2} & = \\\\ \\frac{t(\\sqrt{t}-2)}{(\\sqrt{t}+2)(\\sqrt{t}-2)} & = \\\\ \\frac{t(\\sqrt{t}-2)}{(\\sqrt{t})^{2}-{2}^{2}} & = \\\\ \\frac{t(\\sqrt{t}-2)}{t-4} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186213326 :knowledge-point/_questions [{:db/id #edb/ref 17592186213017 :knowledge-point/id #uuid "e9139c75-1189-5b78-9d82-023f5208a490" :knowledge-point/title "Rationalizing Denominators Containing Two Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d2a705b9-46d1-5b3f-9718-dd479f54d54a" :answer/type {:db/id #edb