frac{\\cancel{m}(\\sqrt{m}-m)}{\\cancel{m}(1-m)} & = \\\\ \\frac{\\sqrt{m}-m}{1-m}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186570008 :knowledge-point/_questions [{:db/id #edb/ref 17592186213017 :knowledge-point/id #uuid "e9139c75-1189-5b78-9d82-023f5208a490" :knowledge-point/title "Rationalizing Denominators Containing Two Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1210df57-e67c-591e-853e-f366af5fe6a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{a}+2}{a-4}" :db/id #edb/ref 17592186569470} {:answer/id #uuid "3ff4e421-7a8e-5dab-94d7-0ab518f1e766" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{a}+2}{a+2}" :db/id #edb/ref 17592186569528} {:answer/id #uuid "4d91c8dd-a38c-5dee-bd68-0b344a9f5c8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{a}+4}{a-4}" :db/id #edb/ref 17592186569551} {:answer/id #uuid "d216d8db-12cb-5b4f-8606-256ce552eb03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{a}-2}{a+4}" :db/id #edb/ref 17592186569772} {:answer/id #uuid "ffb17e41-8330-5e0e-b46c-af5fb670df17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{a}+2}{a-2}" :db/id #edb/ref 17592186569844}] :answer-field/correct {:answer/id #uuid "1210df57-e67c-591e-853e-f366af5fe6a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{a}+2}{a-4}" :db/id #edb/ref 17592186569470} :answer-field/id #uuid "e334166a-4c51-5693-8a67-91594d7b8111" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569939}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "899489ed-bce7-5e1a-a61e-2e188dc20acb" :question/math-academy-id "q-85320" :question/problem "Rationalize the denominator of $\\frac{1}{\\sqrt{a}-2}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{a}+2.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{a}+2,$ and simplify:\n\n$$\n\\begin{aligned}\\frac{1}{\\sqrt{a}-2} & = \\\\ \\frac{1}{\\sqrt{a}-2}\\cdot \\frac{\\sqrt{a}+2}{\\sqrt{a}+2} & = \\\\ \\frac{\\sqrt{a}+2}{(\\sqrt{a}-2)(\\sqrt{a}+2)} & = \\\\ \\frac{\\sqrt{a}+2}{(\\sqrt{a})^{2}-{2}^{2}} & = \\\\ \\frac{\\sqrt{a}+2}{a-4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186569969 :knowledge-point/_questions [{:db/id #edb/ref 17592186213017 :knowledge-point/id #uuid "e9139c75-1189-5b78-9d82-023f5208a490" :knowledge-point/title "Rationalizing Denominators Containing Two Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30188f5f-9a8c-5a2e-bb7f-17ac473dcc94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{w}+1}{{w}^{2}-1}" :db/id #edb/ref 17592186569512} {:answer/id #uuid "3e17be7b-71d9-531e-9e23-2a887af86afb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{w}-1}{{w}^{2}-1}" :db/id #edb/ref 17592186569527} {:answer/id #uuid "6666040b-ee0e-5ca9-9d87-09de21f3571e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{w}-1}{w-1}" :db/id #edb/ref 17592186569602} {:answer/id #uuid "932371f4-fde9-55f2-b9db-f53acbb01913" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{w\\sqrt{w}+1}{w-1}" :db/id #edb/ref 17592186569674} {:answer/id #uuid "b8de0369-bf9b-5b19-ad7f-8ab6818094ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{w\\sqrt{w}-1}{w-1}" :db/id #edb/ref 17592186569737}] :answer-field/correct {:answer/id #uuid "6666040b-ee0e-5ca9-9d87-09de21f3571e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{w}-1}{w-1}" :db/id #edb/ref 17592186569602} :answer-field/id #uuid "9a720dff-cbbe-5a63-8f0f-44d10d647c99" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569903}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "25064e53-93b3-52b6-af27-2a0003a93f3f" :question/math-academy-id "q-85321" :question/problem "Rationalize the denominator of $\\frac{1}{\\sqrt{w}+1}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{w}-1.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{w}-1,$ and simplify:\n\n$$\n\\begin{aligned}\\frac{1}{\\sqrt{w}+1} & = \\\\ \\frac{1}{\\sqrt{w}+1}\\cdot \\frac{\\sqrt{w}-1}{\\sqrt{w}-1} & = \\\\ \\frac{\\sqrt{w}-1}{(\\sqrt{w}+1)(\\sqrt{w}-1)} & = \\\\ \\frac{\\sqrt{w}-1}{(\\sqrt{w})^{2}-{1}^{2}} & = \\\\ \\frac{\\sqrt{w}-1}{w-1}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186570038 :knowledge-point/_questions [{:db/id #edb/ref 17592186213018 :knowledge-point/id #uuid "fa5d982f-ff13-5a31-9cd3-d5847ea2790c" :knowledge-point/title "Rationalizing Denominators Containing a Binomial Within the Radical"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e5aa24a-40ad-54c1-ac48-1556e82c4564" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1+2\\sqrt{1-2w}}{w}" :db/id #edb/ref 17592186569586} {:answer/id #uuid "7f8c1f90-43e4-5654-845d-4116ec994488" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1-\\sqrt{1-2w}}{w}" :db/id #edb/ref 17592186569655} {:answer/id #uuid "83afa538-5275-50c6-985d-07cbd1e01393" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2-2\\sqrt{1-2w}}{w}" :db/id #edb/ref 17592186569659} {:answer/id #uuid "c70653d1-4c66-5b9a-aaf5-222808226c0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1-\\sqrt{1-2w}}{1+w}" :db/id #edb/ref 17592186569759} {:answer/id #uuid "d7ceee2c-5737-50d2-8e0b-837aedd0d714" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2+2\\sqrt{1-2w}}{1+w}" :db/id #edb/ref 17592186569782}] :answer-field/correct {:answer/id #uuid "7f8c1f90-43e4-5654-845d-4116ec994488" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1-\\sqrt{1-2w}}{w}" :db/id #edb/ref 17592186569655} :answer-field/id #uuid "6438280a-ee3f-52a1-9aff-83da651ba794" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569887}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e9419475-d219-538e-ac38-b80302aae79f" :question/math-academy-id "q-85376" :question/problem "Rationalize the denominator of $\\frac{2}{1+\\sqrt{1-2w}}.$" :question/worked-solution "First, note that the denominator's conjugate is $1-\\sqrt{1-2w}.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $1-\\sqrt{1-2w},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{2}{1+\\sqrt{1-2w}} & = \\\\ \\frac{2}{1+\\sqrt{1-2w}}\\cdot \\frac{1-\\sqrt{1-2w}}{1-\\sqrt{1-2w}} & = \\\\ \\frac{2(1-\\sqrt{1-2w})}{(1+\\sqrt{1-2w})(1-\\sqrt{1-2w})} & = \\\\ \\frac{2(1-\\sqrt{1-2w})}{{1}^{2}-(\\sqrt{1-2w})^{2}} & = \\\\ \\frac{2(1-\\sqrt{1-2w})}{1-(1-2w)} & = \\\\ \\frac{2(1-\\sqrt{1-2w})}{2w} & = \\\\ \\frac{1-\\sqrt{1-2w}}{w}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186570007 :knowledge-point/_questions [{:db/id #edb/ref 17592186213019 :knowledge-point/id #uuid "43395cdf-3e16-5147-87fb-371193078b4a" :knowledge-point/title "Rationalizing a Denominator With Two Radicals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20d26f86-2dc9-5463-bba9-a9c64837cfba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3w}+\\sqrt{2}}{w-2}" :db/id #edb/ref 17592186569489} {:answer/id #uuid "2cc75ee0-7521-5750-8f0f-3f1a36938006" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{w+2}" :db/id #edb/ref 17592186569506} {:answer/id #uuid "4188c38e-2d83-5519-96c9-a6eb79f16eb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3w}}{3w-2}" :db/id #edb/ref 17592186569533} {:answer/id #uuid "4f30b0d7-48f8-5ace-8f0f-4568d9df43f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3w}-\\sqrt{2}}{3w-2}" :db/id #edb/ref 17592186569557} {:answer/id #uuid "f1dc7873-f819-53f3-a6f8-115519757005" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3w}-\\sqrt{2}}{3w-4}" :db/id #edb/ref 17592186569825}] :answer-field/correct {:answer/id #uuid "4f30b0d7-48f8-5ace-8f0f-4568d9df43f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3w}-\\sqrt{2}}{3w-2}" :db/id #edb/ref 17592186569557} :answer-field/id #uuid "0f562f05-e64d-5189-84cb-9fa3a27158ee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569852}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "87b6f4b7-9188-5e3b-b5e9-cf42f85068fb" :question/math-academy-id "q-85406" :question/problem "Rationalize the denominator of $\\frac{1}{\\sqrt{3w}+\\sqrt{2}}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{3w}-\\sqrt{2}.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{3w}-\\sqrt{2},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{1}{\\sqrt{3w}+\\sqrt{2}} & = \\\\ \\frac{1}{\\sqrt{3w}+\\sqrt{2}}\\cdot \\frac{\\sqrt{3w}-\\sqrt{2}}{\\sqrt{3w}-\\sqrt{2}} & = \\\\ \\frac{\\sqrt{3w}-\\sqrt{2})}{(\\sqrt{3w}+\\sqrt{2})(\\sqrt{3w}-\\sqrt{2})} & = \\\\ \\frac{\\sqrt{3w}-\\sqrt{2}}{(\\sqrt{3w})^{2}-(\\sqrt{2})^{2}} & = \\\\ \\frac{\\sqrt{3w}-\\sqrt{2}}{3w-2}\\end{aligned}\n$$"}]}
