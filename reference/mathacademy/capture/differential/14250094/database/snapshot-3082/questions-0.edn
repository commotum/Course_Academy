y}-\\sqrt{y-4}}{(\\sqrt{y}+\\sqrt{y-4})(\\sqrt{y}-\\sqrt{y-4})} & = \\\\ \\frac{\\sqrt{y}-\\sqrt{y-4}}{(\\sqrt{y})^{2}-(\\sqrt{y-4})^{2}} & = \\\\ \\frac{\\sqrt{y}-\\sqrt{y-4}}{y-(y-4)} & = \\\\ \\frac{\\sqrt{y}-\\sqrt{y-4}}{4} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186570025 :knowledge-point/_questions [{:db/id #edb/ref 17592186213019 :knowledge-point/id #uuid "43395cdf-3e16-5147-87fb-371193078b4a" :knowledge-point/title "Rationalizing a Denominator With Two Radicals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "577f1978-28ee-500b-afa8-1a8ac4bd93cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{x-2}-\\sqrt{x-3}" :db/id #edb/ref 17592186569571} {:answer/id #uuid "5b8e10bd-69c0-5e63-b024-1ff745bea904" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\sqrt{x-2}+3\\sqrt{x-3}" :db/id #edb/ref 17592186569577} {:answer/id #uuid "a18fb80d-85d6-5638-abcc-79aac05f2512" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{x-2}-3\\sqrt{x-3}" :db/id #edb/ref 17592186569700} {:answer/id #uuid "ecc80fb0-df28-5c6d-b00a-f863b6c4153f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3(\\sqrt{x-2}+\\sqrt{x-3})" :db/id #edb/ref 17592186569817} {:answer/id #uuid "f61a4d96-d1b8-552e-b8b3-6cd378a8add8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3(\\sqrt{x-3}+\\sqrt{x-2})" :db/id #edb/ref 17592186569828}] :answer-field/correct {:answer/id #uuid "a18fb80d-85d6-5638-abcc-79aac05f2512" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{x-2}-3\\sqrt{x-3}" :db/id #edb/ref 17592186569700} :answer-field/id #uuid "f4bcca3d-b352-5572-98c7-6dddf7325a1d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569949}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d0a87847-eb14-5299-88a2-d7b26adced93" :question/math-academy-id "q-296038" :question/problem "Rationalize the denominator of $\\frac{3}{\\sqrt{x-3}+\\sqrt{x-2}}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{x-3}-\\sqrt{x-2}.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{x-3}-\\sqrt{x-2},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{3}{\\sqrt{x-3}+\\sqrt{x-2}} & = \\\\ \\frac{3}{\\sqrt{x-3}+\\sqrt{x-2}}\\cdot \\frac{\\sqrt{x-3}-\\sqrt{x-2}}{\\sqrt{x-3}-\\sqrt{x-2}} & = \\\\ \\frac{3(\\sqrt{x-3}-\\sqrt{x-2})}{(\\sqrt{x-3}+\\sqrt{x-2})(\\sqrt{x-3}-\\sqrt{x-2})} & = \\\\ \\frac{3(\\sqrt{x-3}-\\sqrt{x-2})}{(\\sqrt{x-3})^{2}-(\\sqrt{x-2})^{2}} & = \\\\ \\frac{3(\\sqrt{x-3}-\\sqrt{x-2})}{x-3-(x-2)} & = \\\\ \\frac{3(\\sqrt{x-3}-\\sqrt{x-2})}{-1} & = \\\\ 3\\sqrt{x-2}-3\\sqrt{x-3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186569985 :knowledge-point/_questions [{:db/id #edb/ref 17592186213018 :knowledge-point/id #uuid "fa5d982f-ff13-5a31-9cd3-d5847ea2790c" :knowledge-point/title "Rationalizing Denominators Containing a Binomial Within the Radical"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f3d87ed-6d1b-59e1-804f-6d88c18f0d35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7x-x\\sqrt{x-5}}{54-x}" :db/id #edb/ref 17592186569558} {:answer/id #uuid "7e5d7b09-683b-594e-8b0f-376f8798f202" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{54x-\\sqrt{x+5}}{7+x}" :db/id #edb/ref 17592186569653} {:answer/id #uuid "9250b5d5-33a4-5499-98ec-c4d7925dc243" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+\\sqrt{x-5}}{27-x}" :db/id #edb/ref 17592186569673} {:answer/id #uuid "943625b0-79ef-584c-bf14-a5e5ac076