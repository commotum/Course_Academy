n/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "992f7e69-958f-50e1-a735-f09f05b61b6f" :question/math-academy-id "q-111099" :question/problem "Rationalize the denominator of $\\frac{10}{\\sqrt{r+2}-\\sqrt{r+4}}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{r+2}+\\sqrt{r+4}.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{r+2}+\\sqrt{r+4},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{10}{\\sqrt{r+2}-\\sqrt{r+4}} & = \\\\ \\frac{10}{\\sqrt{r+2}-\\sqrt{r+4}}\\cdot \\frac{\\sqrt{r+2}+\\sqrt{r+4}}{\\sqrt{r+2}+\\sqrt{r+4}} & = \\\\ \\frac{10(\\sqrt{r+2}+\\sqrt{r+4})}{(\\sqrt{r+2}-\\sqrt{r+4})(\\sqrt{r+2}+\\sqrt{r+4})} & = \\\\ \\frac{10(\\sqrt{r+2}+\\sqrt{r+4})}{(\\sqrt{r+2})^{2}-(\\sqrt{r+4})^{2}} & = \\\\ \\frac{10(\\sqrt{r+2}+\\sqrt{r+4})}{(r+2)-(r+4)} & = \\\\ \\frac{10(\\sqrt{r+2}+\\sqrt{r+4})}{(-2)} & = \\\\ -5(\\sqrt{r+2}+\\sqrt{r+4})\\end{aligned}\n$$"} :step/id #uuid "07d130dd-3700-52b3-9d3d-940cb9caaef0" :step/next {:db/id #edb/ref 17592186521627}} {:db/id #edb/ref 17592186521606 :step/content {:db/id #edb/ref 17592186213823 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2cb8232e-74ec-5125-9023-35f18e70215d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x(\\sqrt{x+2}+4)}{x+18}" :db/id #edb/ref 17592186520859} {:answer/id #uuid "2fd21317-9259-5e13-8f0c-addab41d0918" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x(\\sqrt{x-2}-4)}{x-18}" :db/id #edb/ref 17592186520865} {:answer/id #uuid "6bed1864-1f50-54e3-8cde-8a57d07fe2d0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x}{x-14}" :db/id #edb/ref 17592186521008} {:answer/id #uuid "c775aed0-24c4-56d0-8bf0-fec61f178576" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x(\\sqrt{x+2}-4)}{x-14}" :db/id #edb/ref 17592186521206} {:answer/id #uuid "fa7bc214-ee6d-5abf-966b-772d87f7e378" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x\\sqrt{x-2}+4}{x-14}" :db/id #edb/ref 17592186521314}] :answer-field/correct {:db/id #edb/ref 17592186521206} :answer-field/id #uuid "07b0ffea-cecd-5abf-8980-0e708de53956" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186212724}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "25d93f27-b081-516b-bfe5-d84f1819ebc3" :question/math-academy-id "q-34502" :question/problem "Rationalize the denominator of $\\frac{x}{\\sqrt{x+2}+4}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{x+2}-4.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{x+2}-4,$ and simplify:\n\n$$\n\\begin{aligned}\\frac{x}{\\sqrt{x+2}+4} & = \\\\ \\frac{x}{\\sqrt{x+2}+4}\\cdot \\frac{\\sqrt{x+2}-4}{\\sqrt{x+2}-4} & = \\\\ \\frac{x(\\sqrt{x+2}-4)}{(\\sqrt{x+2}+4)(\\sqrt{x+2}-4)} & = \\\\ \\frac{x(\\sqrt{x+2}-4)}{(\\sqrt{x+2})^{2}-{4}^{2}} & = \\\\ \\frac{x(\\sqrt{x+2}-4)}{x+2-16} & = \\\\ \\frac{x(\\sqrt{x+2}-4)}{x-14}\\end{aligned}\n$$"} :step/id #uuid "62818f69-eeae-50e0-81e1-c5bff1a5b643" :step/next {:db/id #edb/ref 17592186521649}} {:db/id #edb/ref 17592186521627 :step/content {:db/id #edb/ref 17592186521485 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3209607c-4fd0-5f69-8dbb-841fd6d6a93f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5z(\\sqrt{2}-\\sqrt{10z})}{2-5z}" :db/id #edb/ref 17592186520870} {:answer/id #uuid "92311420-2889-54e9-a9dd-2d80f687d0f3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2}z-\\sqrt{10z}}{1+5z}" :db/id #edb/ref 17592186521095} {:answer/id #uuid "9535b9e0-b46d-506d-a7b8-72740283f836" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5z(\\sqrt{2}-\\sqrt{10z})}{2(1-5z)}" :db/id #edb/ref 17592186521103} {:answer/id #uuid "c2dbbb0d-019b-5038-acdd-928bb643e139" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5z(\\sqrt{2}+\\sqrt{10z})}{2-5z}" :db/id #edb/ref 17592186521197} {:answer/id #uuid "e61a03b8-2399-5b96-83df-cc93cbd78137" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2}z+\\sqrt{10z}}{1-5z}" :db/id #edb/ref 17592186521280}] :answer-field/correct {:db/id #edb/ref 17592186521103} :answer-field/id #uuid "5ef8731e-9af3-5ebb-ac94-c0117d6e5d8f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186521372}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3a9fdb79-91cf-5159-aced-4b759a444970" :question/math-academy-id "q-296007" :question/problem "Rationalize the denominator of $\\frac{5z}{\\sqrt{2}+\\sqrt{10z}}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{2}-\\sqrt{10z}.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{2}-\\sqrt{10z},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{5z}{\\sqrt{2}+\\sqrt{10z}} & = \\\\ \\frac{5z}{\\sqrt{2}+\\sqrt{10z}}\\cdot \\frac{\\sqrt{2}-\\sqrt{10z}}{\\sqrt{2}-\\sqrt{10z}} & = \\\\ \\frac{5z(\\sqrt{2}-\\sqrt{10z})}{(\\sqrt{2}+\\sqrt{10z})(\\sqrt{2}-\\sqrt{10z})} & = \\\\ \\frac{5z(\\sqrt{2}-\\sqrt{10z})}{(\\sqrt{2})^{2}-(\\sqrt{10z})^{2}} & = \\\\ \\frac{5z(\\sqrt{2}-\\sqrt{10z})}{2-10z} & = \\\\ \\frac{5z(\\sqrt{2}-\\sqrt{10z})}{2(1-5z)}\\end{aligned}\n$$"} :step/id #uuid "a2bfbd34-58b2-5080-ba93-ed039d0f0805" :step/next {:db/id #edb/ref 17592186521635}} {:db/id #edb/ref 17592186521635 :step/content {:db/id #edb/ref 17592186521484 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7c2a016e-ad1a-5c19-8891-77f26cce6fc3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3(\\sqrt{5}+\\sqrt{3x})}{5-3x}" :db/id #edb/ref 17592186521047} {:answer/id #uuid "bd4d8cde-eff6-5e7c-a368-c0664c614edd" :answer/type {:db/id #edb/ref 1759218