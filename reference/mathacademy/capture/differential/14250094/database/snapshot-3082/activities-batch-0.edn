db/id #edb/ref 17592186045498} :answer/value "\\frac{5\\sqrt{y-3}-10}{y-7}" :db/id #edb/ref 17592186512353} {:answer/id #uuid "6c32fdae-9578-5230-9c6a-0030dc42ee0a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5\\sqrt{y+3}+10}{y-1}" :db/id #edb/ref 17592186512357} {:answer/id #uuid "97224d93-ee75-5b28-87bf-a215b4d67a60" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5\\sqrt{y+3}-10}{y+7}" :db/id #edb/ref 17592186512455} {:answer/id #uuid "c408e350-5f98-5e07-beed-90e315ab7e7d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5\\sqrt{y+3}+2}{y+1}" :db/id #edb/ref 17592186512571} {:answer/id #uuid "eb76173e-aa86-561d-80e6-1b55db1b9cdb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5\\sqrt{y-3}+2}{y-1}" :db/id #edb/ref 17592186512665}] :answer-field/correct {:db/id #edb/ref 17592186512357} :answer-field/id #uuid "767f1526-f555-548a-8c1f-53ab5b15fedc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186512791}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b8bdad77-9abf-5122-8282-321bd75ae69b" :question/math-academy-id "q-34858" :question/problem "Rationalize the denominator of $\\frac{5}{\\sqrt{y+3}-2}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{y+3}+2.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{y+3}+2,$ and simplify:\n\n$$\n\\begin{aligned}\\frac{5}{\\sqrt{y+3}-2} & = \\\\ \\frac{5}{\\sqrt{y+3}-2}\\cdot \\frac{\\sqrt{y+3}+2}{\\sqrt{y+3}+2} & = \\\\ \\frac{5(\\sqrt{y+3}+2)}{(\\sqrt{y+3}-2)(\\sqrt{y+3}+2)} & = \\\\ \\frac{5\\sqrt{y+3}+10}{(\\sqrt{y+3})^{2}-{2}^{2}} & = \\\\ \\frac{5\\sqrt{y+3}+10}{y+3-4} & = \\\\ \\frac{5\\sqrt{y+3}+10}{y-1}\\end{aligned}\n$$"} :step/id #uuid "ded7d104-608d-5295-b9d2-dc886b061230" :step/next {:db/id #edb/ref 17592186521573}}] :activity/title "Further Rationalizing