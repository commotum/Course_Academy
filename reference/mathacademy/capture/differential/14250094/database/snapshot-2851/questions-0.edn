#{[{:db/id #edb/ref 17592186212794 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186213017 :knowledge-point/id #uuid "e9139c75-1189-5b78-9d82-023f5208a490" :knowledge-point/title "Rationalizing Denominators Containing Two Terms"}] :question/id #uuid "659e7fd3-3502-5a47-a54c-3d0c33150d73" :question/math-academy-id "e-18928" :question/problem "Rationalize the denominator of $\\dfrac{1}{3-\\sqrt a}$." :question/worked-solution "First, note that the denominator's conjugate is $3+\\sqrt a$.\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $3+\\sqrt a$, and simplify:\n\n$$\n\\begin{aligned}\n\\frac{1}{3 - \\sqrt{a}} &=  \\\\\n\\frac{1}{3 - \\sqrt{a}} \\cdot \\frac{3 + \\sqrt{a}}{3 + \\sqrt{a}} &=  \\\\\n(3 + \\sqrt{a})/((3 - \\sqrt{a})(3 + \\sqrt{a})) &=  \\\\\n(3 + \\sqrt{a})/(3^{2} - (\\sqrt{a})^{2}) &=  \\\\\n&= \\frac{3 + \\sqrt{a}}{9 - a}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186212795 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186213018 :knowledge-point/id #uuid "fa5d982f-ff13-5a31-9cd3-d5847ea2790c" :knowledge-point/title "Rationalizing Denominators Containing a Binomial Within the Radical"}] :question/id #uuid "dfb7701e-d11b-52a0-97fb-8363b1ff0901" :question/math-academy-id "e-18929" :question/problem "Rationalize the denominator of $\\dfrac {x} {\\sqrt{x+1}+1}$." :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{x+1}-1$.\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{x+1}-1$, and simplify:\n\n$$\n\\begin{aligned} \\dfrac {x} {\\sqrt{x+1}+1} \\\\[5pt] &= \\dfrac {x} {\\sqrt{x+1}+1}\\cdot \\dfrac{\\sqrt{x+1}-1}{\\sqrt{x+1}-1} \\\\[5pt] &= \\dfrac {x(\\sqrt{x+1}-1)} {(\\sqrt{x+1}+1)(\\sqrt{x+1}-1)} \\\\[5pt] &= \\dfrac {x(\\sqrt{x+1}-1)} {(\\sqrt{x+1})^2-1^2} \\\\[5pt] &= \\dfrac {x(\\sqrt{x+1}-1)} {x+1-1} \\\\[5pt] &= \\dfrac {x(\\sqrt{x+1}-1)} {x} \\\\[5pt] &= \\sqrt{x+1}-1 \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186212796 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186213019 :knowledge-point/id #uuid "43395cdf-3e16-5147-87fb-371193078b4a" :knowledge-point/title "Rationalizing a Denominator With Two Radicals"}] :question/id #uuid "4bcf9ec5-b5a1-5ab2-bb9f-f22280e072ae" :question/math-academy-id "e-18930" :question/problem "Rationalize the denominator of $\\dfrac{x}{\\sqrt{2}-\\sqrt{x}}$." :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{2}+\\sqrt{x}$.\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{2}+\\sqrt{x}$, and simplify:\n\n$$\n\\begin{aligned} \\dfrac{x}{\\sqrt{2}-\\sqrt{x}} \\\\[5pt] &= \\dfrac{x}{\\sqrt{2}-\\sqrt{x}} \\cdot \\dfrac{\\sqrt{2}+\\sqrt{x}}{\\sqrt{2}+\\sqrt{x}} \\\\[5pt] &= \\dfrac{x(\\sqrt{2}+\\sqrt{x})}{(\\sqrt{2}-\\sqrt{x})(\\sqrt{2}+\\sqrt{x})} \\\\[5pt] &= \\dfrac{x(\\sqrt{2}+\\sqrt{x})}{(\\sqrt{2})^2-(\\sqrt{x})^2} \\\\[5pt] &= \\dfrac{x(\\sqrt{2}+\\sqrt{x})}{2-x} \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186213326 :knowledge-point/_questions [{:db/id #edb/ref 17592186213017 :knowledge-point/id #uuid "e9139c75-1189-5b78-9d82-023f5208a490" :knowledge-point/title "Rationalizing Denominators Containing Two Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d2a705b9-46d1-5b3f-9718-dd479f54d54a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "((d + 1)(\\sqrt{2d} - 1))/(d - 1)" :db/id #edb/ref 17592186209964} {:answer/id #uuid "e6a9bf61-4b70-561d-a288-b3b5439a1b3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "((2d + 1)(\\sqrt{2d} - 1))/(d - 1)" :db/id #edb/ref 17592186209965} {:answer/id #uuid "58c40514-8e59-5092-9f1f-e9f38219ae0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "((d + 1)(\\sqrt{d} - 1))/(2d - 1)" :db/id #edb/ref 17592186209966} {:answ