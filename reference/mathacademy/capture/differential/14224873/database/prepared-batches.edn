orname{cos}⁡(x-y)\\,\\text{d}A.\\end{aligned}\n$$"] ["question-66ff7371-5323-5876-b071-49b4ca2a6463" :question/difficulty :question.difficulty/easy] ["answer-field-c22f973c-4187-5d34-928b-a206bc95c78a" :answer-field/id #uuid "c22f973c-4187-5d34-928b-a206bc95c78a"] ["answer-27dab55e-2a07-5559-adf9-474a787ae042" :answer/id #uuid "27dab55e-2a07-5559-adf9-474a787ae042"] ["answer-27dab55e-2a07-5559-adf9-474a787ae042" :answer/type :answer.type/math] ["answer-27dab55e-2a07-5559-adf9-474a787ae042" :answer/value "{∬}_{(0,\\pi )\\times (-\\pi /2,0)}\\operatorname{cos}⁡(x+y)\\,\\text{d}A+{∬}_{(0,\\pi )\\times (0,\\pi /2)}\\operatorname{sin}⁡(x-y)\\,\\text{d}A"] ["answer-ff3ec6df-aa0b-5131-ba4c-022b02da3f60" :answer/id #uuid "ff3ec6df-aa0b-5131-ba4c-022b02da3f60"] ["answer-ff3ec6df-aa0b-5131-ba4c-022b02da3f60" :answer/type :answer.type/math] ["answer-ff3ec6df-aa0b-5131-ba4c-022b02da3f60" :answer/value "{∬}_{(0,\\pi )\\times (-\\pi /2,0)}\\operatorname{sin}⁡(x+y)\\,\\text{d}A+{∬}_{(0,\\pi )\\times (0,\\pi /2)}\\operatorname{cos}⁡(x-y)\\,\\text{d}A"] ["answer-db274e58-8e5f-5077-88fc-c9024b1f6057" :answer/id #uuid "db274e58-8e5f-5077-88fc-c9024b1f6057"] ["answer-db274e58-8e5f-5077-88fc-c9024b1f6057" :answer/type :answer.type/math] ["answer-db274e58-8e5f-5077-88fc-c9024b1f6057" :answer/value "{∬}_{(0,\\pi )\\times (-\\pi /2,0)}\\operatorname{sin}⁡(x+y)\\operatorname{cos}⁡(x-y)\\,\\text{d}A"] ["answer-4a503419-3b03-55f7-a026-c71a3cdf1fda" :answer/id #uuid "4a503419-3b03-55f7-a026-c71a3cdf1fda"] ["answer-4a503419-3b03-55f7-a026-c71a3cdf1fda" :answer/type :answer.type/math] ["answer-4a503419-3b03-55f7-a026-c71a3cdf1fda" :answer/value "{∬}_{(0,\\pi )\\times (-\\pi /2,0)}\\operatorname{sin}⁡(x-y)\\,\\text{d}A+{∬}_{(0,\\pi )\\times (0,\\pi /2)}\\operatorname{cos}⁡(x+y)\\,\\text{d}A"] ["answer-cf8aa907-71bd-57bd-b9b0-a791585844c8" :answer/id #uuid "cf8aa907-71bd-57bd-b9b0-a791585844c8"] ["answer-cf8aa907-71bd-57bd-b9b0-a791585844c8" :answer/type :answer.type/math] ["answer-cf8aa907-71bd-57bd-b9b0-a791585844c8" :answer/value "{∬}_{(0,\\pi )\\times (-\\pi /2,\\pi /2)}(\\operatorname{sin}⁡(x+y)-\\operatorname{cos}⁡(x-y))\\text{ }\\text{d}A"] ["answer-field-c22f973c-4187-5d34-928b-a206bc95c78a" :answer-field/key "selection"] ["answer-field-c22f973c-4187-5d34-928b-a206bc95c78a" :answer-field/type :answer-field.type/radio] ["answer-field-c22f973c-4187-5d34-928b-a206bc95c78a" :answer-field/correct "answer-ff3ec6df-aa0b-5131-ba4c-022b02da3f60"] ["answer-field-c22f973c-4187-5d34-928b-a206bc95c78a" :answer-field/choices "answer-27dab55e-2a07-5559-adf9-474a787ae042"] ["answer-field-c22f973c-4187-5d34-928b-a206bc95c78a" :answer-field/choices "answer-ff3ec6df-aa0b-5131-ba4c-022b02da3f60"] ["answer-field-c22f973c-4187-5d34-928b-a206bc95c78a" :answer-field/choices "answer-db274e58-8e5f-5077-88fc-c9024b1f6057"] ["answer-field-c22f973c-4187-5d34-928b-a206bc95c78a" :answer-field/choices "answer-4a503419-3b03-55f7-a026-c71a3cdf1fda"] ["answer-field-c22f973c-4187-5d34-928b-a206bc95c78a" :answer-field/choices "answer-cf8aa907-71bd-57bd-b9b0-a791585844c8"] ["question-66ff7371-5323-5876-b071-49b4ca2a6463" :question/answer-fields "answer-field-c22f973c-4187-5d34-928b-a206bc95c78a"] [17592186129172 :knowledge-point/questions "question-66ff7371-5323-5876-b071-49b4ca2a6463"] ["question-1d37bcc4-0c9f-508d-8122-95d6a1703d93" :question/id #uuid "1d37bcc4-0c9f-508d-8122-95d6a1703d93"] ["question-1d37bcc4-0c9f-508d-8122-95d6a1703d93" :question/math-academy-id "q-130018"] ["question-1d37bcc4-0c9f-508d-8122-95d6a1703d93" :question/problem "Given that $C$ and $D$ are finite, non-overlapping regions and that\n\n$$\n{∬}_{C}f(x,y)\\text{ }\\text{d}A=-5,\\,{∬}_{D}f(x,y)\\text{ }\\text{d}A=-10,\n$$\n\nfind the value of \n\n$$\n{∬}_{C\\cup D}2f(x,y)\\text{ }\\text{d}A.\n$$"] ["question-1d37bcc4-0c9f-508d-8122-95d6a1703d93" :question/worked-solution "Using the linearity and additivity of double integrals, we get the following:\n\n$$\n\\begin{aligned}{∬}_{C\\cup D}2f(x,y)\\text{ }\\text{d}A & =2{∬}_{C\\cup D}f(x,y)\\text{ }\\text{d}A \\\\  & =2({∬}_{C}f(x,y)\\text{ }\\text{d}A+{∬}_{D}f(x,y)\\text{ }\\text{d}A) \\\\  & =2(-5-10) \\\\  & =-30\\end{aligned}\n$$"] ["question-1d37bcc4-0c9f-508d-8122-95d6a1703d93" :question/difficulty :question.difficulty/easy] ["answer-field-f08a4b5c-ff94-5bb7-9fc3-45c47e3170dd" :answer-field/id #uuid "f08a4b5c-ff94-5bb7-9fc3-45c47e3170dd"] ["answer-408ff810-6b9d-5b26-be6c-01ffe1516381" :answer/id #uuid "408ff810-6b9d-5b26-be6c-01ffe1516381"] ["answer-408ff810-6b9d-5b26-be6c-01ffe1516381" :answer/type :answer.type/math] ["answer-408ff810-6b9d-5b26-be6c-01ffe1516381" :answer/value "-10"] ["answer-983a9eb5-d569-52ad-9779-68218cfae321" :answer/id #uuid "983a9eb5-d569-52ad-9779-68218cfae321"] ["answer-983a9eb5-d569-52ad-9779-68218cfae321" :answer/type :answer.type/math] ["answer-983a9eb5-d569-52ad-9779-68218cfae321" :answer/value "-15"] ["answer-46d7da2f-b178-5341-932f-188c6b740b71" :answer/id #uuid "46d7da2f-b178-5341-932f-188c6b740b71"] ["answer-46d7da2f-b178-5341-932f-188c6b740b71" :answer/type :answer.type/math] ["answer-46d7da2f-b178-5341-932f-188c6b740b71" :answer/value "-30"] ["answer-66769113-8309-511d-b9f9-0e68f7f4b5a4" :answer/id #uuid "66769113-8309-511d-b9f9-0e68f7f4b5a4"] ["answer-66769113-8309-511d-b9f9-0e68f7f4b5a4" :answer/type :answer.type/math] ["answer-66769113-8309-511d-b9f9-0e68f7f4b5a4" :answer/value "15"] ["answer-744ab5e2-ab3a-5799-8335-66148f7759ef" :answer/id #uuid "744ab5e2-ab3a-5799-8335-66148f7759ef"] ["answer-744ab5e2-ab3a-5799-8335-66148f7759ef" :answer/type :answer.type/math] ["answer-744ab5e2-ab3a-5799-8335-66148f7759ef" :answer/value "20"] ["answer-field-f08a4b5c-ff94-5bb7-9fc3-45c47e3170dd" :answer-field/key "selection"] ["answer-field-f08a4b5c-ff94-5bb7-9fc3-45c47e3170dd" :answer-field/type :answer-field.type/radio] ["answer-field-f08a4b5c-ff94-5bb7-9fc3-45c47e3170dd" :answer-field/correct "answer-46d7da2f-b178-5341-932f-188c6b740b71"] ["answer-field-f08a4b5c-ff94-5bb7-9fc3-45c47e3170dd" :ans