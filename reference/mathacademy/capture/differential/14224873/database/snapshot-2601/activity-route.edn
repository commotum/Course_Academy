#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186541220} :activity/id #uuid "d5e426ab-ae67-5398-8c45-a2967a7a35dc" :activity/scope {:db/id #edb/ref 17592186050546 :topic/id #uuid "5269dbdc-fe3c-5ce7-b18c-f9aa0c7f6711" :topic/math-academy-id 2000} :activity/steps [{:db/id #edb/ref 17592186541167 :step/content {:db/id #edb/ref 17592186380894 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a2e15614-cf10-5035-a3e9-1e74b5a8b0de" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{∬}_{S\\cup T}(\\frac{x}{y}+{x}^{2}-x{y}^{3})\\text{d}A" :db/id #edb/ref 17592186380896} {:answer/id #uuid "d9b88361-c3e7-5541-acf8-ca9ffbbb62e2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{∬}_{S\\cup T}\\frac{x}{y}({x}^{2}-x{y}^{3})\\,\\text{d}A" :db/id #edb/ref 17592186380897} {:answer/id #uuid "180eeba2-deb2-5cf1-b167-3418a77c6df3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{∬}_{S}\\frac{x}{y}\\,\\text{d}A+{∬}_{U}({x}^{2}-x{y}^{3})\\,\\text{d}A" :db/id #edb/ref 17592186380898} {:answer/id #uuid "92d66543-c3a6-5f98-bd86-be2ec63d6e7a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{∬}_{S}\\frac{x}{y}\\,\\text{d}A+{∬}_{T}({x}^{2}-x{y}^{3})\\,\\text{d}A+{∬}_{U}\\,\\text{d}A" :db/id #edb/ref 17592186380899} {:answer/id #uuid "5e937bea-7600-5aff-bb43-6733c9d40198" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{∬}_{S}\\frac{x}{y}\\,\\text{d}A+{∬}_{T}({x}^{2}-x{y}^{3})\\,\\text{d}A" :db/id #edb/ref 17592186380900}] :answer-field/correct {:db/id #edb/ref 17592186380900} :answer-field/id #uuid "e64f7bef-5384-5c7a-9b11-57463fc18d7e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186380895}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9798be4b-01fe-51e0-b1bf-171e60296bfd" :question/math-academy-id "q-130023" :question/problem "![](images/e5/e50797d61a59cf8533e86695c03da168bff7e59ce363e0ee42bb700de515385f.png)\n\nConsider the region $R$ shown above. Let the function $f(x,y)$ be defined as\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{x}{y}, & (x,y)\\in S, \\\\ {x}^{2}-x{y}^{3}, & (x,y)\\in T, \\\\ 0, & (x,y)\\in U.\\end{aligned}\n$$\n\nThen,\n\n$$\n{∬}_{R}f(x,y)\\text{ }\\text{d}A=\n$$" :question/worked-solution "First, notice that the domain $R$ can be represented as a union of three sub-domains, as follows:\n\n$$\n\\begin{aligned}R & =S\\cup T\\cup U.\\end{aligned}\n$$\n\nSo, we can write\n\n$$\n\\begin{aligned}{∬}_{R}f(x,y)\\,\\text{d}A & ={∬}_{S}f(x,y)\\,\\text{d}A+{∬}_{T}f(x,y)\\,\\text{d}A+{∬}_{U}f(x,y)\\,\\text{d}A \\\\  & ={∬}_{S}\\frac{x}{y}\\,\\text{d}A+{∬}_{T}({x}^{2}-x{y}^{3})\\,\\text{d}A+{∬}_{U}0\\,\\text{d}A \\\\  & ={∬}_{S}\\frac{x}{y}\\,\\text{d}A+{∬}_{T}({x}^{2}-x{y}^{3})\\,\\text{d}A.\\end{aligned}\n$$"} :step/id #uuid "2a278359-e48b-574c-8558-aec54e3db4bf"} {:db/id #edb/ref 17592186541192 :step/content {:db/id #edb/ref 17592186541066 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "408ff810-6b9d-5b26-be6c-01ffe1516381" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-10" :db/id #edb/ref 17592186540636} {:answer/id #uuid "46d7da2f-b178-5341-932f-188c6b740b71" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-30" :db/id #edb/ref 17592186540651} {:answer/id #uuid "66769113-8309-511d-b9f9-0e68f7f4b5a4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15" :db/id #edb/ref 17592186540702} {:answer/id #uuid "744ab5e2-ab3a-5799-8335-66148f7759ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "20" :db/id #edb/ref 17592186540728} {:answer/id #uuid "983a9eb5-d569-52ad-9779-68218cfae321" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-15" :db/id #edb/ref 17592186540780}] :answer-field/correct {:db/id #edb/ref 17592186540651} :answer-field/id #uuid "f08a4b5c-ff94-5bb7-9fc3-45c47e3170dd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186541046}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1d37bcc4-0c9f-508d-8122-95d6a1703d93" :question/math-academy-id "q-130018" :question/problem "Given that $C$ and $D$ are finite, non-overlapping regions and that\n\n$$\n{∬}_{C}f(x,y)\\text{ }\\text{d}A=-5,\\,{∬}_{D}f(x,y)\\text{ }\\text{d}A=-10,\n$$\n\nfind the value of \n\n$$\n{∬}_{C\\cup D}2f(x,y)\\text{ }\\text{d}A.\n$$" :question/worked-solution "Using the linearity and additivity of double integrals, we get the following:\n\n$$\n\\begin{aligned}{∬}_{C\\cup D}2f(x,y)\\text{ }\\text{d}A & =2{∬}_{C\\cup D}f(x,y)\\text{ }\\text{d}A \\\\  & =2({∬}_{C}f(x,y)\\text{ }\\text{d}A+{∬}_{D}f(x,y)\\text{ }\\text{d}A) \\\\  & =2(-5-10) \\\\  & =-30\\end{aligned}\n$$"} :step/id #uuid "76b49b70-28b4-5fb8-b154-916347e649e4" :step/next {:db/id #edb/ref 17592186541167}} {:db/id #edb/ref 17592186541198 :step/content {:db/id #edb/ref 17592186380873 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a2b5bd46-9ad9-5287-8540-de4fec5b349c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16" :db/id #edb/ref 17592186380875} {:answer/id #uuid "f9b9919a-def8-55b0-b9c2-b44fc832ab35" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14" :db/id #edb/ref 17592186380876} {:answer/id #uuid "831f7c88-e098-5c1f-a8e5-ccb34b89df28" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186380877} {:answer/id #uuid "67ea11e1-25b5-553f-9220-1d54bd8cbd08" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "32" :db/id #edb/ref 17592186380878} {:answer/id #uuid "14b66f59-cdaf-5100-99dd-152700887b12" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18" :db/id #edb/ref 17592186380879}] :answer-field/correct {:db/id #edb/ref 17592186380879} :answer-field/id #uuid "4f5de000-5e2e-5293-bbbc-fea0dfb73f12" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186380874}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2a641d94-d436-5610-8401-c196fdb866a7" :question/math-academy-id "q-129953" :question/problem "Calculate ${∬}_{R}(3{x}^{2}+6{y}^{2})\\,\\text{d}A$,  where $R=[-1,0]\\times [0,2].$" :question/worked-solution "Using the linearity property of double integrals, we can write\n\n$$\n\\begin{aligned}{∬}_{R}(3{x}^{2}+6{y}^{2})\\text{d}A & ={∬}_{R}3{x}^{2}\\text{ }\\text{d}A+{∬}_{R}6{y}^{2}\\text{ }\\text{d}A.\\end{aligned}\n$$\n\nThe function under the first integral is independent of $y.$ So, we have \n\n$$\n\\begin{aligned}{∬}_{R}3{x}^{2}\\text{ }\\text{d}A & =(2-0){\\int }_{-1}^{0}3{x}^{2}\\,\\text{d}x \\\\  & =2({x}^{3}{|}_{-1}^{0}) \\\\  & =2({0}^{3}-(-1)^{3}) \\\\  & =2.\\end{aligned}\n$$\n\nThe function under the second integral is independent of $x.$ So, we have \n\n$$\n\\begin{aligned}{∬}_{R}6{y}^{2}\\text{ }\\text{d}A & =(0-(-1)){\\int }_{0}^{2}6{y}^{2}\\,\\text{d}y \\\\  & =2{y}^{3}{|}_{0}^{2} \\\\  & =2\\cdot {2}^{3}-0 \\\\  & =16.\\end{aligned}\n$$\n\nFinally, combining our results, we obtain\n\n$$\n\\begin{aligned}{∬}_{R}(3{x}^{2}+6{y}^{2})\\,\\text{d}A=2+16=18.\\end{aligned}\n$$"} :step/id #uuid "893db046-3a6d-56c7-8f63-bc9d855915b3" :step/next {:db/id #edb/ref 17592186541192}} {:db/id #edb/ref 17592186541219 :step/content {:db/id #edb/ref 17592186541090 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27dab55e-2a07-5559-adf9-474a787ae042" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{∬}_{(0,\\pi )\\times (-\\pi /2,0)}\\operatorname{cos}⁡(x+y)\\,\\text{d}A+{∬}_{(0,\\pi )\\times (0,\\pi /2)}\\operatorname{sin}⁡(x-y)\\,\\text{d}A" :db/id #edb/ref 17592186540597} {:answer/id #uuid "4a503419-3b03-55f7-a026-c71a3cdf1fda" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{∬}_{(0,\\pi )\\times (-\\pi /2,0)}\\operatorname{sin}⁡(x-y)\\,\\text{d}A+{∬}_{(0,\\pi )\\times (0,\\pi /2)}\\operatorname{cos}⁡(x+y)\\,\\text{d}A" :db/id #edb/ref 17592186540660} {:answer/id #uuid "cf8aa907-71bd-57bd-b9b0-a791585844c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{∬}_{(0,\\pi )\\times (-\\pi /2,\\pi /2)}(\\operatorname{sin}⁡(x+y)-\\operatorname{cos}⁡(x-y))\\text{ }\\text{d}A" :db/id #edb/ref 17592186540878} {:answer/id #uuid "db274e58-8e5f-5077-88fc-c9024b1f6057" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{∬}_{(0,\\pi )\\times (-\\pi /2,0)}\\operatorname{sin}⁡(x+y)\\operatorname{cos}⁡(x-y)\\,\\text{d}A" :db/id #edb/ref 17592186540901} {:answer/id #uuid "ff3ec6df-aa0b-5131-ba4c-022b02da3f60" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{∬}_{(0,\\pi )\\times (-\\pi /2,0)}\\operatorname{sin}⁡(x+y)\\,\\text{d}A+{∬}_{(0,\\pi )\\times (0,\\pi /2)}\\operatorname{cos}⁡(x-y)\\,\\text{d}A" :db/id #edb/ref 17592186540940}] :answer-field/correct {:db/id #edb/ref 17592186540940} :answer-field/id #uuid "c22f973c-4187-5d34-928b-a206bc95c78a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186541027}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "66ff7371-5323-5876-b071-49b4ca2a6463" :question/math-academy-id "q-80674" :question/problem "Let the function $f(x,y)$ be defined as\n\n$$\nf(x,y)=\\{\\begin{aligned}\\operatorname{sin}⁡(x+y),\\, & \\text{if}\\,0<x<\\pi ,\\,-\\frac{\\pi }{2}<y<0, \\\\ \\operatorname{cos}⁡(x-y),\\, & \\text{if}\\,0<x<\\pi ,\\,0<y<\\frac{\\pi }{2}.\\end{aligned}\n$$\n\nThen,\n\n$$\n{∬}_{(0,\\pi )\\times (-\\pi /2,\\pi /2)}f(x,y)\\text{ }\\text{d}A=\n$$" :question/worked-solution "First, notice that the rectangle $R$ can be represented as a union of two smaller rectangles, as follows:\n\n$$\n\\begin{aligned}R & =(0,\\pi )\\times ((-\\frac{\\pi }{2},0)\\cup (0,\\frac{\\pi }{2})) \\\\  & =((0,\\pi )\\times (-\\frac{\\pi }{2},0))\\cup ((0,\\pi )\\times (0,\\frac{\\pi }{2})).\\end{aligned}\n$$\n\nSo, we can write\n\n$$\n\\begin{aligned}{∬}_{R}f(x,y)\\,\\text{d}A & ={∬}_{(0,\\pi )\\times (-\\pi /2,0)}f(x,y)\\,\\text{d}A+{∬}_{(0,\\pi )\\times (0,\\pi /2)}f(x,y)\\,\\text{d}A \\\\  & ={∬}_{(0,\\pi )\\times (-\\pi /2,0)}\\operatorname{sin}⁡(x+y)\\,\\text{d}A+{∬}_{(0,\\pi )\\times (0,\\pi /2)}\\operatorname{cos}⁡(x-y)\\,\\text{d}A.\\end{aligned}\n$$"} :step/id #uuid "ca77b050-7163-5e44-bed7-5cbfe6365a13" :step/next {:db/id #edb/ref 17592186541198}} {:db/id #edb/ref 17592186541220 :step/content {:db/id #edb/ref 17592186129872 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34b43744-10b8-5bdd-86b0-6a7b66637027" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{∬}_{(0,2)}(x+y)\\,\\text{d}A+{∬}_{(-1,1)}\\operatorname{sin}⁡(x+y)\\,\\text{d}A" :db/id #edb/ref 17592186540609} {:answer/id #uuid "48d84918-aaf4-5e48-802a-eb621ffae666" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{∬}_{(0,1)\\times (-1,1)}(x+y)\\,\\text{d}A+{∬}_{(1,2)\\times (-1,1)}\\operatorname{sin}⁡(x+y)\\,\\text{d}A" :db/id #edb/ref 17592186540658} {:answer/id #uuid "5ba92148-b911-57fa-bcc8-d6592d9da4b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{∬}_{(-1,1)}(x+y)\\,\\text{d}A+{∬}_{(0,2)}\\operatorname{sin}⁡(x+y)\\,\\text{d}A" :db/id #edb/ref 17592186540682} {:answer/id #uuid "822a278f-47f8-5535-9796-535bd9d05cea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{∬}_{(0,2)\\times (-1,1)}(x+y)\\,\\text{d}A+{∬}_{(0,2)\\times (-1,1)}\\operatorname{sin}⁡(x+y)\\,\\text{d}A" :db/id #edb/ref 17592186540750} {:answer/id #uuid "c5b9d0b8-9a3f-5bdc-b4d0-bb4eb57acfcf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{∬}_{(0,2)\\times (-1,0)}(x+y)\\,\\text{d}A+{∬}_{(0,2)\\times (0,1)}\\operatorname{sin}⁡(x+y)\\,\\text{d}A" :db/id #edb/ref 17592186540857}] :answer-field/correct {:db/id #edb/ref 17592186540857} :answer-field/id #uuid "24968e69-4fb3-5ca6-888b-ea79f8a7f6b2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186128713}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "66b7b545-f5c5-56eb-bf68-00d58148275e" :question/math-academy-id "q-80449" :question/problem "Let the function $f(x,y)$ be defined as\n\n$$\nf(x,y)=\\{\\begin{aligned}x+y,\\, & \\text{if}\\,0<x<2,\\,-1<y<0, \\\\ \\operatorname{sin}⁡(x+y),\\, & \\text{if}\\,0<x<2,\\,0<y<1.\\end{aligned}\n$$\n\nThen,\n\n$$\n{∬}_{(0,2)\\times (-1,1)}f(x,y)\\text{ }\\text{d}A=\n$$" :question/worked-solution "First, notice that the rectangle $R$ can be represented as a union of two smaller rectangles, as follows:\n\n$$\n\\begin{aligned}R & =(0,2)\\times ((-1,0)\\cup (0,1)) \\\\  & =((0,2)\\times (-1,0))\\cup ((0,2)\\times (0,1)).\\end{aligned}\n$$\n\nSo, we can write\n\n$$\n\\begin{aligned}{∬}_{R}f(x,y)\\,\\text{d}A & ={∬}_{(0,2)\\times (-1,0)}f(x,y)\\,\\text{d}A+{∬}_{(0,2)\\times (0,1)}f(x,y)\\,\\text{d}A \\\\  & ={∬}_{(0,2)\\times (-1,0)}(x+y)\\,\\text{d}A+{∬}_{(0,2)\\times (0,1)}\\operatorname{sin}⁡(x+y)\\,\\text{d}A.\\end{aligned}\n$$"} :step/id #uuid "cd03560a-f875-5516-bfa6-d69e8b5f5aca" :step/next {:db/id #edb/ref 17592186541219}}] :activity/title "Properties of Double Integrals" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186540526}]}
