      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14122998/observations/lesson-step-152956-da1c81d93a835a236584.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14122998/observations/lesson-step-152956-da1c81d93a835a236584.png",
      "source_url": "https://mathacademy.com/topics/4386",
