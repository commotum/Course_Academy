cfae548a" #edb/ref 17592186045417] [17592186173974 #edb/ref 1075 #edb/ref 17592186173975 #edb/ref 17592186045417] [17592186173974 #edb/ref 1075 #edb/ref 17592186173976 #edb/ref 17592186045417] [17592186173974 #edb/ref 1075 #edb/ref 17592186173977 #edb/ref 17592186045417] [17592186173974 #edb/ref 1075 #edb/ref 17592186173978 #edb/ref 17592186045417] [17592186173974 #edb/ref 1075 #edb/ref 17592186173979 #edb/ref 17592186045417] [17592186173974 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186173974 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186173974 #edb/ref 1079 #uuid "1aeedcef-fc68-5134-bce1-dbbbab9c2929" #edb/ref 17592186045417] [17592186173975 #edb/ref 1080 "Y∼N(9, 9)" #edb/ref 17592186045417] [17592186173975 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186173975 #edb/ref 1083 #uuid "eafbe7fd-c9f3-555d-b5d3-988eb336d81a" #edb/ref 17592186045417] [17592186173976 #edb/ref 1080 "Y∼N(9, 70)" #edb/ref 17592186045417] [17592186173976 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186173976 #edb/ref 1083 #uuid "1beac005-50c0-555e-b873-b27a959619ea" #edb/ref 17592186045417] [17592186173977 #edb/ref 1080 "Y∼N(9, 3)" #edb/ref 17592186045417] [17592186173977 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186173977 #edb/ref 1083 #uuid "29f4b3fe-c4e1-513a-bb9d-c1e66cf22ddb" #edb/ref 17592186045417] [17592186173978 #edb/ref 1080 "Y∼N(3, 72)" #edb/ref 17592186045417] [17592186173978 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186173978 #edb/ref 1083 #uuid "2cce066f-9d8c-5216-bb5e-0d53e95a8175" #edb/ref 17592186045417] [17592186173979 #edb/ref 1080 "Y∼N(9, 73)" #edb/ref 17592186045417] [17592186173979 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186173979 #edb/ref 1083 #uuid "51eecc28-8d6c-5268-aeb9-6674ebbde2d4" #edb/ref 17592186045417] [17592186173992 #edb/ref 1075 #edb/ref 17592186173993 #edb/ref 17592186045417] [17592186173992 #edb/ref 1075 #edb/ref 17592186173994 #edb/ref 17592186045417] [17592186173992 #edb/ref 1075 #edb/ref 17592186173995 #edb/ref 17592186045417] [17592186173992 #edb/ref 1075 #edb/ref 17592186173996 #edb/ref 17592186045417] [17592186173992 #edb/ref 1075 #edb/ref 17592186173997 #edb/ref 17592186045417] [17592186173992 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186173992 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186173992 #edb/ref 1079 #uuid "2b327c0a-88c1-5e92-8e65-9c6e5d5bea32" #edb/ref 17592186045417] [17592186173993 #edb/ref 1080 "0.0272" #edb/ref 17592186045417] [17592186173993 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186173993 #edb/ref 1083 #uuid "8041b8be-8957-5a2c-846c-ea79936b4958" #edb/ref 17592186045417] [17592186173994 #edb/ref 1080 "0.1505" #edb/ref 17592186045417] [17592186173994 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186173994 #edb/ref 1083 #uuid "8e220953-d7e1-5e87-8c43-b3066bfd9c9d" #edb/ref 17592186045417] [17592186173995 #edb/ref 1080 "0.1212" #edb/ref 17592186045417] [17592186173995 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186173995 #edb/ref 1083 #uuid "97d525b7-7e77-5d0e-91ef-2632f7d5f49d" #edb/ref 17592186045417] [17592186173996 #edb/ref 1080 "0.7007" #edb/ref 17592186045417] [17592186173996 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186173996 #edb/ref 1083 #uuid "a08990c7-9968-5dee-9bd6-9c1068336a1e" #edb/ref 17592186045417] [17592186173997 #edb/ref 1080 "0.0207" #edb/ref 17592186045417] [17592186173997 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186173997 #edb/ref 1083 #uuid "38620165-1626-58f3-a1d2-fde318ff74c8" #edb/ref 17592186045417] [17592186175685 #edb/ref 1069 "e-10064" #edb/ref 17592186045417] [17592186175685 #edb/ref 1071 "Given that the random variables\n$X_1 \\sim N(-1,3), \\qquad X_2 \\sim N(3,2), \\qquad X_3 \\sim N(2,1)$\nare mutually independent, what is the distribution of $Y = X_1 - 2X_2 - X_3$?" #edb/ref 17592186045417] [17592186175685 #edb/ref 1072 #uuid "441d6816-7c83-52aa-b225-f2b108d4c906" #edb/ref 17592186045417] [17592186175685 #edb/ref 1074 "Recall that if $X_1, X_2$, and $X_3$ are mutually independent random variables, where\n$X_1\\sim N(\\mu_1,\\sigma^2_1), \\qquad X_2\\sim N(\\mu_2,\\sigma^2_2), \\qquad X_3\\sim N(\\mu_3,\\sigma^2_3)$,\n\nand $a_1,a_2,a_3$ are real constants, then\n\n$$\n\\begin{aligned}\nY &= a_{1}X_{1} + a_{2}X_{2} + a_{3}X_{3} \\\\\n&= ∼N(a_{1}μ_{1} + a_{2}μ_{2} + a_{3}μ_{3}, a_{1}^{2}σ_{1}^{2} + a_{2}^{2}σ_{2}^{2} + a_{3}^{2}σ_{3}^{2})\n\\end{aligned}\n$$\n\nIn our case, we have\n$X_1 \\sim N(-1,3), \\qquad X_2 \\sim N(3,2), \\qquad X_3 \\sim N(2,1)$,\nand\n\n$$\nY = X_1 - 2X_2 - X_3\n$$\n\nSince $X_1, X_2$, and $X_3$ are mutually independent, we have\n\n$$\n\\begin{aligned}\nE[Y] &= a_{1}μ_{1} + a_{2}μ_{2} + a_{3}μ_{3} \\\\\n&= 1 \\cdot (-1) + (-2) \\cdot 3 + (-1) \\cdot 2 \\\\\n&=-1 - 6 - 2 \\\\\n&=-9, \\\\\nVar[Y] &= a_{1}^{2}σ_{1}^{2} + a_{2}^{2}σ_{2}^{2} + a_{3}^{2}σ_{3}^{2} \\\\\n&= 1^{2} \\cdot 3 + (-2)^{2} \\cdot 2 + (-1)^{2} \\cdot 1 \\\\\n&= 1 \\cdot 3 + 4 \\cdot 2 + 1 \\cdot 1 \\\\\n&= 3 + 8 + 1 \\\\\n&= 12\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\nY = X_{1} - 2X_{2} - X_{3} \\mid ∼N(-9, 12)\n$$" #edb/ref 17592186045417] [17592186175686 #edb/ref 1069 "e-10065" #edb/ref 17592186045417] [17592186175686 #edb/ref 1071 "A shop sells $2$ types of rice, Type $A$ and Type $B$. The volume per packet for Type $A$ rice is normally distributed with a mean of $1$ liter and a variance of $0.01$ liters2, while the volume per packet for Type $B$ rice is normally distributed with a mean of $0.7$ liters and a variance of $0.02$ liters2. During cooking, it is known that Type $A$ rice quadruples in volume, while Type $B$ rice triples in volume.\n\nIf a single package of Type $A$ rice and $2$ packages of Type $B$ rice are randomly selected and cooked, what is the probability that the resulting rice volume is less than $8$ liters? You may assume that the volumes of rice in the packages are mutually independent.\n\n*Hint: A table of values of $\\Phi(z)$ for different values of $z$ is given below, where $\\Phi(z)$ is the cumulative distribution function for the standard normal distribution.*\n\n| $z$ | $\\, 0.06 \\,$ | $\\, 0.07 \\,$ | $\\, 0.08 \\,$ | $\\, 0.09 \\,$ |\n| --- | ---: | ---: | ---: | ---: |\n| $\\, -0.3 \\,$ | $\\, 0.3594 \\,$ | $\\, 0.3557 \\,$ | $\\, 0.3520 \\,$ | $\\, 0.3483 \\,$ |\n| $\\, -0.2 \\,$ | $\\, 0.3974 \\,$ | $\\, 0.3936 \\,$ | $\\, 0.3897 \\,$ | $\\, 0.3859 \\,$ |\n| $\\, -0.1 \\,$ | $\\, 0.4364 \\,$ | $\\, 0.4325 \\,$ | $\\, 0.4286 \\,$ | $\\, 0.4247 \\,$ |" #edb/ref 17592186045417] [17592186175686 #edb/ref 1072 #uuid "4b936a95-2418-5350-bef1-e13867b85bb3" #edb/ref 17592186045417] [17592186175686 #edb/ref 1074 "Let $X_1$ denote the volume of the Type $A$ rice package, and let $X_2$ and $X_3$ denote the volumes of the Type $B$ rice packages. Then, we have\n\n$$\nX_1\\sim N(1, 0.01), \\qquad X_2\\sim N(0.7, 0.02), \\qquad X_3\\sim N(0.7, 0.02)\n$$\n\nLet the random variable $Y$ denote the total resulting volume of rice after cooking. Since the Type $A$ rice quadruples in volume, while the type $B$ rice triples in volume, we have\n\n$$\nY= 4X_1+3X_2 + 3X_3\n$$\n\nThe random variable $Y$ is normally distributed, where\n\n$$\n\\begin{aligned}\nE[Y] &= (4 \\cdot 1 + 3 \\cdot 0.7 + 3 \\cdot 0.7) \\\\\n&= 8.2 \\\\\nVar[Y] &= 4^{2} \\cdot 0.01 + 3^{2} \\cdot 0.02 + 3^{2} \\cdot 0.02 \\\\\n&= 16 \\cdot 0.01 + 9 \\cdot 0.02 + 9 \\cdot 0.02 \\\\\n&= 0.52\n\\end{aligned}\n$$\n\nTherefore,\n$Y \\sim N(8.2, 0.52)$.\n\nIn order to find $P(Y \\lt 8)$, we convert $Y$ to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}\nP(Y < 8) &= P(Z < \\frac{8 - 8.2}{\\sqrt{0.52}}) \\\\\n&\\approx P(Z < - 0.28) \\\\\n&= Φ(-0.28)\n\\end{aligned}\n$$\n\nUsing the $z$-table, we see that\n\n$$\n\\Phi(-0.28)\\approx 0.3897\n$$\n\nTherefore,\n\n$$\nP(Y < 8) \\mid \\approx Φ(-0.28); \\approx 0.3897\n$$" #edb/ref 17592186045417] [17592186175865 #edb/ref 1069 "e-9265" #edb/ref 17592186045417] [17592186175865 #edb/ref 1071 "Given that the random variables\n$X_1\\sim N(-1,2^2), \\qquad X_2\\sim N(3, 3^2), \\qquad X_3\\sim N(4,2)$\nare mutually independent, what is the distribution of $Y = X_1 + X_2 + X_3$?" #edb/ref 17592186045417] [17592186175865 #edb/ref 1072 #uuid "6e7d897d-a59c-5944-b515-81132fd17715" #edb/ref 17592186045417] [17592186175865 #edb/ref 1074 "Recall that if $X_1, X_2$, and $X_3$ are mutually independent random variables, where\n$X_1\\sim N(\\mu_1,\\sigma^2_1),\\qquad X_2\\sim N(\\mu_2,\\sigma^2_2),\\qquad X_3\\sim N(\\mu_3,\\sigma^2_3)$,\n\nthen\n\n$$\n\\begin{aligned}\nY &= X_{1} + X_{2} + X_{3} \\\\\n&= ∼N(μ_{1} + μ_{2} + μ_{3}, σ_{1}^{2} + σ_{2}^{2} + σ_{3}^{2})\n\\end{aligned}\n$$\n\nIn our case, we have\n$X_1\\sim N(-1,2^2), \\qquad X_2\\sim N(3, 3^2), \\qquad X_3\\sim N(4,2)$,\n\nand\n\n$$\nY = X_1 + X_2 + X_3\n$$\n\nSince $X_1, X_2$, and $X_3$ are mutually independent, we have\n\n$$\n\\begin{aligned}\nE[Y] &= μ_{1} + μ_{2} + μ_{3} \\\\\n&=-1 + 3 + 4 \\\\\n&= 6, \\\\\nVar[Y] &= σ_{1}^{2} + σ_{2}^{2} + σ_{3}^{2} \\\\\n&= 2^{2} + 3^{2} + 2 \\\\\n&= 4 + 9 + 2 \\\\\n&= 15\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\nY = X_{1} + X_{2} + X_{3} \\mid ∼N(6, 15)\n$$" #edb/ref 17592186045417] [17592186175866 #edb/ref 1069 "e-9266" #edb/ref 17592186045417] [17592186175866 #edb/ref 1071 "Given that the random variables\n$X_1\\sim N(4,5), \\qquad X_2\\sim N(-2,2), \\qquad X_3\\sim N(3,1)$\nare mutually independent and $Y=3X_1-3X_2-X_3$, calculate $P(\\mid Y \\mid \\lt 3)$.\n\n*Hint: A table of values of $\\Phi(z)$ for different values of $z$ is given below, where $\\Phi(z)$ is the cumulative distribution function for the standard normal distribution.*\n\n| $z$$\\, 0.03 \\,$$\\, 0.04 \\,$$\\, 0.05 \\,$$\\, -2.2 \\,$ $\\, 0.0129 \\,$ $\\, 0.0125 \\,$ $\\, 0.0122 \\,$ $\\, -2.1 \\,$ $\\, 0.0166 \\,$ $\\, 0.0162 \\,$ $\\, 0.0158 \\,$ $\\, -2.0 \\,$ $\\, 0.0212 \\,$ $\\, 0.0207 \\,$ $\\, 0.0202 \\,$ |  | $z$$\\, 0.00 \\,$$\\, 0.01 \\,$$\\, 0.02 \\,$$\\, -1.5 \\,$ $\\, 0.0668 \\,$ $\\, 0.0655 \\,$ $\\, 0.0643 \\,$ $\\, -1.4 \\,$ $\\, 0.0808 \\,$ $\\, 0.0793 \\,$ $\\, 0.0778 \\,$ $\\, -1.3 \\,$ $\\, 0.0968 \\,$ $\\, 0.0951 \\,$ $\\, 0.0934 \\,$ |\n| --- | ---: | ---: |" #edb/ref 17592186045417] [17592186175866 #edb/ref 1072 #uuid "722126ae-cdef-5c3f-a031-f4ccefdc6fe9" #edb/ref 17592186045417] [17592186175866 #edb/ref 1074 "Recall that if $X_1, X_2$, and $X_3$ are mutually independent random variables, where\n\n$$\nX_1\\sim N(\\mu_1,\\sigma^2_1), \\qquad X_2\\sim N(\\mu_2,\\sigma^2_2), \\qquad X_3\\sim N(\\mu_3,\\sigma^2_3)\n$$\n\nand $a_1,a_2,a_3$ are real constants, then\n\n$$\n\\begin{aligned}\nY &= a_{1}X_{1} + a_{2}X_{2} + a_{3}X_{3} \\\\\n&= ∼N(a_{1}μ_{1} + a_{2}μ_{2} + a_{3}μ_{3}, a_{1}^{2}σ_{1}^{2} + a_{2}^{2}σ_{2}^{2} + a_{3}^{2}σ_{3}^{2})\n\\end{aligned}\n$$\n\nIn our case, we have\n$X_1\\sim N(4,5), \\qquad X_2\\sim N(-2,2), \\qquad X_3\\sim N(3,1)$,\nand\n\n$$\nY=3X_1-3X_2-X_3\n$$\n\nSince $X_1, X_2$, and $X_3$ are mutually independent, we have\n\n$$\n\\begin{aligned}\nE[Y] &= a_{1}μ_{1} + a_{2}μ_{2} + a_{3}μ_{3} \\\\\n&= 3 \\cdot 4 + (-3) \\cdot (-2) + (-1) \\cdot 3 \\\\\n&= 15, \\\\\nVar[Y] &= a_{1}^{2}σ_{1}^{2} + a_{2}^{2}σ_{2}^{2} + a_{3}^{2}σ_{3}^{2} \\\\\n&= 3^{2} \\cdot 5 + (-3)^{2} \\cdot 2 + (-1)^{2} \\cdot 1 \\\\\n&= 9 \\cdot 5 + 9 \\cdot 2 + 1 \\cdot 1 \\\\\n&= 64\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\nY∼N(15, 64)\n$$\n\nWe want to find\n\n$$\nP(\\mid Y \\mid \\lt 3)=P(-3 < Y \\lt 3)\n$$\n\nThus, we convert $Y$ to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}\nP(-3 < Y < 3) &= P(\\frac{-3 - 15}{\\sqrt{64}} < Z < \\frac{3 - 15}{\\sqrt{64}}) \\\\\n&\\approx P(-2.25 < Z < - 1.5) \\\\\n&= P(Z < - 1.5) - P(Z < - 2.25) \\\\\n&= Φ(-1.5) - Φ(-2.25)\n\\end{aligned}\n$$\n\nUsing the $z$-table, we see that\n\n$$\nΦ(-1.5) \\approx 0.0668, Φ(-2.25) \\approx 0.0122\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\nP(\\mid Y \\mid < 3) &= Φ(-1.5) - Φ(-2.25) \\\\\n&\\approx 0.0668 - 0.0122 \\\\\n&= 0.0546\n\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186176012 #edb/ref 1037 #edb/ref 17592186049812 #edb/ref 17592186045417] [17592186176012 #edb/ref 1038 #edb/ref 17592186176285 #edb/ref 17592186045417] [17592186176012 #edb/ref 1038 #edb/ref 17592186176367 #edb/ref 17592186045417] [17592186176012 #edb/ref 1039 "Finding the Distribution of a Sum of Normal Random Variables" #edb/ref 17592186045417] [17592186176012 #edb/ref 1041 #edb/ref 17592186175865 #edb/ref 17592186045417] [17592186176012 #edb/ref 1042 #uuid "3414fb92-7c59-5e59-af67-5c57b75d759f" #edb/ref 17592186045417] [17592186176013 #edb/ref 1038 #edb/ref 17592186176287 #edb/ref 17592186045417] [17592186176013 #edb/ref 1038 #edb/ref 17592186176288 #edb/ref 17592186045417] [17592186176013 #edb/ref 1039 "Calculating Probabilities Involving Linear Combinations of Normally Distributed Random Variables" #edb/ref 17592186045417] [17592186176013 #edb/ref 1041 #edb/ref 17592186175866 #edb/ref 17592186045417] [17592186176013 #edb/ref 1042 #uuid "cc2565c7-5dcd-5573-9231-26c26cdae18c" #edb/ref 17592186045417] [17592186176038 #edb/ref 1038 #edb/ref 17592186176286 #edb/ref 17592186045417] [17592186176038 #edb/ref 1038 #edb/ref 17592186176365 #edb/ref 17592186045417] [17592186176038 #edb/ref 1039 "Finding the Distribution of a Linear Combination of Normal Random Variables" #edb/ref 17592186045417] [17592186176038 #edb/ref 1041 #edb/ref 17592186175685 #edb/ref 17592186045417] [17592186176038 #edb/ref 1042 #uuid "71acfb6e-910a-5b33-8a4c-45867c3d69c3" #edb/ref 17592186045417] [17592186176039 #edb/ref 1038 #edb/ref 17592186176256 #edb/ref 17592186045417] [17592186176039 #edb/ref 1038 #edb/ref 17592186176289 #edb/ref 17592186045417] [17592186176039 #edb/ref 1039 "Combinations of Normally Distributed Random Variables in Context" #edb/ref 17592186045417] [175921