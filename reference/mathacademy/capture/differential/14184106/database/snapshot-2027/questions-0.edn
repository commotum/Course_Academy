25+9 \\\\  & =38.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}Y={X}_{1}+{X}_{2}+{X}_{3} & ∼N(-3,38).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186498572 :knowledge-point/_questions [{:db/id #edb/ref 17592186176038 :knowledge-point/id #uuid "71acfb6e-910a-5b33-8a4c-45867c3d69c3" :knowledge-point/title "Finding the Distribution of a Linear Combination of Normal Random Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10652dea-2c37-5230-ab53-c2da7979eb90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Y∼N(4,16)" :db/id #edb/ref 17592186497837} {:answer/id #uuid "678ed4a4-a210-5418-bafb-e9fb208b7a5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Y∼N(8,8)" :db/id #edb/ref 17592186498046} {:answer/id #uuid "804d5824-d20f-5d52-b8a4-16b2a23fa651" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Y∼N(4,64)" :db/id #edb/ref 17592186498098} {:answer/id #uuid "9067e4f6-6f04-5f8e-81a0-7af959bff50d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Y∼N(4,8)" :db/id #edb/ref 17592186498130} {:answer/id #uuid "bc0d36eb-a442-553d-9ae9-de94dca3ec26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Y∼N(8,64)" :db/id #edb/ref 17592186498218}] :answer-field/correct {:answer/id #uuid "9067e4f6-6f04-5f8e-81a0-7af959bff50d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Y∼N(4,8)" :db/id #edb/ref 17592186498130} :answer-field/id #uuid "60288c73-7b67-5d87-86dd-51846dedd4fa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186498400}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b4dc7b39-09f7-500e-8d29-5718ad3819f8" :question/math-academy-id "q-142956" :question/problem "Given that the random variables \n\n$$\n{X}_{1}∼N(-1,4),\\,{X}_{2}∼N(2,2),\\,{X}_{3}∼N(-5,2)\n$$\n\nare mutually independent, what is the distribution of $Y=-{X}_{1}-{X}_{2}-{X}_{3}?$" :question/worked-solution "Recall that if ${X}_{1},{X}_{2},$ and ${X}_{3}$ are mutually independent random variables, where \n\n$$\n{X}_{1}∼N({\\mu }_{1},{\\sigma }_{1}^{2}),\\,{X}_{2}∼N({\\mu }_{2},{\\sigma }_{2}^{2}),\\,{X}_{3}∼N({\\mu }_{3},{\\sigma }_{3}^{2}),\n$$\n\nand ${a}_{1},{a}_{2},{a}_{3}$ are real constants,  then \n\n$$\n\\begin{aligned}Y & ={a}_{1}{X}_{1}+{a}_{2}{X}_{2}+{a}_{3}{X}_{3} \\\\  & ∼N({a}_{1}{\\mu }_{1}+{a}_{2}{\\mu }_{2}+{a}_{3}{\\mu }_{3},\\,{a}_{1}^{2}{\\sigma }_{1}^{2}+{a}_{2}^{2}{\\sigma }_{2}^{2}+{a}_{3}^{2}{\\sigma }_{3}^{2}).\\end{aligned}\n$$\n\nIn our case, we have\n\n$$\n{X}_{1}∼N(-1,4),\\,{X}_{2}∼N(2,2),\\,{X}_{3}∼N(-5,2),\n$$\n\nand\n\n$$\nY=-{X}_{1}-{X}_{2}-{X}_{3}.\n$$\n\nSince ${X}_{1},{X}_{2},$ and ${X}_{3}$ are mutually independent, we have \n\n$$\n\\begin{aligned}\\text{E}[Y] & ={a}_{1}{\\mu }_{1}+{a}_{2}{\\mu }_{2}+{a}_{3}{\\mu }_{3} \\\\  & =(-1)\\cdot (-1)+(-1)\\cdot 2+(-1)\\cdot (-5) \\\\  & =1-2+5 \\\\  & =4, \\\\ \\text{Var}[Y] & ={a}_{1}^{2}{\\sigma }_{1}^{2}+{a}_{2}^{2}{\\sigma }_{2}^{2}+{a}_{3}^{2}{\\sigma }_{3}^{2} \\\\  & =(-1)^{2}\\cdot 4+(-1)^{2}\\cdot 2+(-1)^{2}\\cdot 2 \\\\  & =1\\cdot 4+1\\cdot 2+1\\cdot 2 \\\\  & =4+2+2 \\\\  & =8.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}Y=-{X}_{1}-{X}_{2}-{X}_{3} & ∼N(4,8).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186498493 :knowledge-point/_questions [{:db/id #edb/ref 17592186176038 :knowledge-point/id #uuid "71acfb6e-910a-5b33-8a4c-45867c3d69c3" :knowledge-point/title "Finding the Distribution of a Linear Combination of Normal Random Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "016485c7-6e1f-54a9-a843-134f180623fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Y∼N(13,12)" :db/id