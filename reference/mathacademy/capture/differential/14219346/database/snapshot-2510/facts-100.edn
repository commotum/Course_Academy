6045417] [17592186530412 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186530412 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186530412 #edb/ref 1078 #edb/ref 17592186529960 #edb/ref 17592186045417] [17592186530412 #edb/ref 1079 #uuid "fe95487d-a357-5109-9ec1-41b889997c44" #edb/ref 17592186045417] [17592186530417 #edb/ref 1068 #edb/ref 17592186530307 #edb/ref 17592186045417] [17592186530417 #edb/ref 1069 "q-149411" #edb/ref 17592186045417] [17592186530417 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186530417 #edb/ref 1071 "$$\n{f}_{Y|X}(y\\,|\\,-1)=\\{\\begin{aligned}\\frac{9}{4{y}^{13/4}}, & \\,1\\le y \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nLet $X$ and $Y$ be continuous random variables. \nFind the conditional variance $\\text{Var}[Y\\,|\\,X=-1]$ given that the conditional probability density function ${f}_{Y|X}(y\\,|\\,-1)$ is shown above and the corresponding expected value is ${\\mu }_{Y|-1}=\\frac{9}{5}.$" #edb/ref 17592186045417] [17592186530417 #edb/ref 1072 #uuid "04b02bf9-cae6-594f-ac96-340afba92b08" #edb/ref 17592186045417] [17592186530417 #edb/ref 1074 "Recall that the conditional variance of $Y$ given $X=x$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=x] & =\\text{E}[(Y-{\\mu }_{Y|x})^{2}\\,|\\,X=x] \\\\  & =\\text{E}[{Y}^{2}\\,|\\,X=x]-{\\mu }_{Y|x}^{2},\\end{aligned}\n$$\n\nwhere \n\n$$\n\\text{E}[{Y}^{2}\\,|\\,X=x]={\\int }_{-\\infty }^{\\infty }{y}^{2}\\,{f}_{Y|X}(y\\,|\\,x)\\,\\text{d}y.\n$$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}\\text{E}[{Y}^{2}\\,|\\,X=-1] & ={\\int }_{-\\infty }^{\\infty }{y}^{2}\\,{f}_{Y|X}(y\\,|\\,-1)\\,\\text{d}y \\\\  & ={\\int }_{1}^{\\infty }{y}^{2}\\cdot \\frac{9}{4{y}^{13/4}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{9}{4{y}^{5/4}}\\,\\text{d}y \\\\  & ={\\int }_{1}^{\\infty }\\frac{9}{4}{y}^{-5/4}\\,\\text{d}y \\\\  & ={[\\frac{9}{4}\\cdot (-4)\\cdot {y}^{-1/4}]}_{1}^{\\infty } \\\\  & ={[-\\frac{9}{\\sqrt[4]{y}}]}_{1}^{\\infty } \\\\  & =0-(-9) \\\\  & =9.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=-2] & =\\text{E}[{Y}^{2}\\,|\\,X=-2]-{\\mu }_{Y|-2}^{2} \\\\  & =9-{(\\frac{9}{5})}^{2} \\\\  & =9-\\frac{81}{25} \\\\  & =\\frac{144}{25}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186530439 #edb/ref 1068 #edb/ref 17592186530406 #edb/ref 17592186045417] [17592186530439 #edb/ref 1069 "q-146760" #edb/ref 17592186045417] [17592186530439 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186530439 #edb/ref 1071 "$$\n\\begin{aligned}f(x,y)=\\{\\begin{aligned}\\frac{3(x+y)}{4}, & 0<x\\le 2y,\\,\\,0<y\\le 1, \\\\ 0, & \\text{otherwise}\\end{aligned}\\,{f}_{Y}(y)=\\{\\begin{aligned}3{y}^{2}, & 0<y\\le 1, \\\\ 0, & \\text{otherwise}\\end{aligned}\\end{aligned}\n$$\n\n \n\nLet $X$ and $Y$  be continuous random variables. Their joint probability density function and the marginal probability density function of $Y$ are shown above. Find the conditional variance $\\text{Var}[X\\,|\\,Y=1]$ given that the corresponding expected value is ${\\mu }_{X|1}=\\frac{7}{6}.$" #edb/ref 17592186045417] [17592186530439 #edb/ref 1072 #uuid "25e1f7ba-cab0-5f7d-b69c-953924c5cba0" #edb/ref 17592186045417] [17592186530439 #edb/ref 1074 "Recall that the conditional variance of $X$ given $Y=y$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=y] & =\\text{E}[(X-{\\mu }_{X|y})^{2}\\,|\\,Y=y] \\\\  & =\\text{E}[{X}^{2}\\,|\\,Y=y]-{\\mu }_{X|y}^{2},\\end{aligned}\n$$\n\nwhere \n\n$$\n\\text{E}[{X}^{2}\\,|\\,Y=y]={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,y)\\,\\text{d}x.\n$$\n\nNote that $\\text{E}[X\\,|\\,Y=y]$ is a function of $y.$ \n\nThe conditional density function of $X$ given $Y=y$ can be computed as \n\n$$\n\\begin{aligned}{f}_{X|Y}(x\\,|\\,y) & =\\frac{f(x,y)}{{f}_{Y}(y)} \\\\  & =\\frac{(\\frac{3(x+y)}{4})}{3{y}^{2}} \\\\  & =\\frac{x+y}{4{y}^{2}},\\end{aligned}\n$$\n\nwhere $0<x\\le 2y,\\,0<y\\le 1.$ Outside this domain, we have ${f}_{X|Y}(x\\,|\\,y)=0.$ \n\nNow, substituting $y=1$ into the expression for ${f}_{X|Y}(x\\,|\\,y),$ we get\n\n$$\n{f}_{X|Y}(x\\,|\\,1)=\\frac{x+1}{4}.\n$$\n\n \n\nTherefore, we obtain \n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}\\,|\\,Y=1]{\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,1)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}{x}^{2}\\cdot \\frac{(x+1)}{4}\\text{d}x \\\\  & =\\frac{1}{4}{\\int }_{0}^{2}({x}^{3}+{x}^{2})\\,\\text{d}x \\\\  & =\\frac{1}{4}{[\\frac{{x}^{4}}{4}+\\frac{{x}^{3}}{3}]}_{0}^{2} \\\\  & =\\frac{1}{4}(4+\\frac{8}{3})-0 \\\\  & =\\frac{1}{4}(\\frac{20}{3}) \\\\  & =\\frac{5}{3}\\end{aligned}\n$$\n\n \n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=1] & =\\text{E}[{X}^{2}\\,|\\,Y=1]-{\\mu }_{X|1}^{2} \\\\  & =\\frac{5}{3}-{(\\frac{7}{6})}^{2} \\\\  & =\\frac{5}{3}-\\frac{49}{36} \\\\  & =\\frac{11}{36}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186530440 #edb/ref 1068 #edb/ref 17592186530305 #edb/ref 17592186045417] [17592186530440 #edb/ref 1069 "q-146395" #edb/ref 17592186045417] [17592186530440 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186530440 #edb/ref 1071 "$$\n{f}_{Y|X}(y\\,|\\,1)=\\{\\begin{aligned}2y, & \\,0\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nLet $X$ and $Y$ be continuous random variables. \nFind the conditional variance $\\text{Var}[Y\\,|\\,X=1]$ given that the conditional probability density function ${f}_{Y|X}(y\\,|\\,1)$ is shown above and the corresponding expected value is ${\\mu }_{Y|1}=\\frac{2}{3}.$" #edb/ref 17592186045417] [17592186530440 #edb/ref 1072 #uuid "2866f3dd-6eaf-53a1-aed5-f4ad68a3ab1f" #edb/ref 17592186045417] [17592186530440 #edb/ref 1074 "Recall that the conditional variance of $Y$ given $X=x$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=x] & =\\text{E}[(Y-{\\mu }_{Y|x})^{2}\\,|\\,X=x] \\\\  & =\\text{E}[{Y}^{2}\\,|\\,X=x]-{\\mu }_{Y|x}^{2},\\end{aligned}\n$$\n\nwhere \n\n$$\n\\text{E}[{Y}^{2}\\,|\\,X=x]={\\int }_{-\\infty }^{\\infty }{y}^{2}\\,{f}_{Y|X}(y\\,|\\,x)\\,\\text{d}y.\n$$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}\\text{E}[{Y}^{2}\\,|\\,X=1] & ={\\int }_{-\\infty }^{\\infty }{y}^{2}\\,{f}_{Y|X}(y\\,|\\,1)\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}{y}^{2}\\cdot 2y\\,\\text{d}x \\\\  & =2{\\int }_{0}^{1}{y}^{3}\\,\\text{d}y \\\\  & ={[\\frac{2{y}^{4}}{4}]}_{0}^{1} \\\\  & =\\frac{1}{2}-0 \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=1] & =\\text{E}[{Y}^{2}\\,|\\,X=1]-{\\mu }_{Y|1}^{2} \\\\  & =\\frac{1}{2}-{(\\frac{2}{3})}^{2} \\\\  & =\\frac{1}{2}-\\frac{4}{9} \\\\  & =\\frac{1}{18}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186530444 #edb/ref 1068 #edb/ref 17592186530291 #edb/ref 17592186045417] [17592186530444 #edb/ref 1069 "q-146976" #edb/ref 17592186045417] [17592186530444 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186530444 #edb/ref 1071 "$$\n\\begin{aligned}f(x,y)=\\{\\begin{aligned}3x(1-{y}^{2}), & 0\\le x\\le 1,\\,0\\le y\\le 1, \\\\ 0, & \\text{otherwise}\\end{aligned}\\,{f}_{X}(x)=\\{\\begin{aligned}2x, & 0\\le x\\le 1, \\\\ 0, & \\text{otherwise}\\end{aligned}\\end{aligned}\n$$\n\nLet $X$ and $Y$  be continuous random variables. Their joint probability density function and the marginal probability density function of $X$ are shown above. Find the conditional variance $\\text{Var}[Y\\,|\\,X=1]$ given that the corresponding expected value is ${\\mu }_{Y|1}=\\frac{3}{8}.$" #edb/ref 17592186045417] [17592186530444 #edb/ref 1072 #uuid "37a3fb25-8245-5c86-91e5-a1e534022eb1" #edb/ref 17592186045417] [17592186530444 #edb/ref 1074 "Recall that the conditional variance of $Y$ given $X=x$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=x] & =\\text{E}[(Y-{\\mu }_{Y|x})^{2}\\,|\\,X=x] \\\\  & =\\text{E}[{Y}^{2}\\,|\\,X=x]-{\\mu }_{Y|x}^{2},\\end{aligned}\n$$\n\nwhere \n\n$$\n\\text{E}[{Y}^{2}\\,|\\,X=x]={\\int }_{-\\infty }^{\\infty }{y}^{2}\\,{f}_{Y|X}(y\\,|\\,x)\\,\\text{d}y.\n$$\n\nNote that $\\text{E}[Y\\,|\\,X=x]$ is a function of $x.$ \n\nThe conditional density function of $Y$ given $X=x$ can be computed as \n\n$$\n\\begin{aligned}{f}_{Y|X}(y\\,|\\,x) & =\\frac{f(x,y)}{{f}_{X}(x)} \\\\  & =\\frac{3x(1-{y}^{2})}{2x} \\\\  & =\\frac{3(1-{y}^{2})}{2}\\end{aligned}\n$$\n\nwhere $0\\le x\\le 1,\\,0\\le y\\le 1.$ Outside this domain, we have ${f}_{Y|X}(y\\,|\\,x)=0.$\n\nNotice that the factor of $x$ cancels out, leaving an expression that does not depend on $x.$ Therefore, substituting $x=1$ into the expression for ${f}_{Y|X}(y\\,|\\,x)$ has no effect:\n\n$$\n{f}_{Y|X}(y\\,|\\,1)=\\frac{3(1-{y}^{2})}{2}\n$$\n\nThen, we obtain \n\n$$\n\\begin{aligned}\\text{E}[{Y}^{2}\\,|\\,X=1] & ={\\int }_{-\\infty }^{\\infty }{y}^{2}\\,{f}_{Y|X}(y\\,|\\,1)\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}{y}^{2}\\cdot \\frac{3(1-{y}^{2})}{2}\\text{d}y \\\\  & =\\frac{3}{2}{\\int }_{0}^{1}({y}^{2}-{y}^{4})\\text{d}y \\\\  & =\\frac{3}{2}[\\frac{{y}^{3}}{3}-\\frac{{y}^{5}}{5}]_{0}^{1} \\\\  & =\\frac{3}{2}[(\\frac{1}{3}-\\frac{1}{5})-0] \\\\  & =\\frac{1}{5}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=1] & =\\text{E}[{Y}^{2}\\,|\\,X=1]-{\\mu }_{Y|1}^{2} \\\\  & =\\frac{1}{5}-{(\\frac{3}{8})}^{2} \\\\  & =\\frac{1}{5}-\\frac{9}{64} \\\\  & =\\frac{19}{320}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186530445 #edb/ref 1068 #edb/ref 17592186530383 #edb/ref 17592186045417] [17592186530445 #edb/ref 1069 "q-146761" #edb/ref 17592186045417] [17592186530445 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186530445 #edb/ref 1071 "$$\n{f}_{X|Y}(x\\,|\\,0)=\\{\\begin{aligned}\\frac{3}{14}\\sqrt{x}, & \\,1\\le x\\le 4 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nLet $X$ and $Y$ be continuous random variables. \nFind the conditional variance $\\text{Var}[X\\,|\\,Y=0]$ given that the conditional probability density function ${f}_{X|Y}(x\\,|\\,0)$ is shown above and the corresponding expected value is ${\\mu }_{X|0}=\\frac{\\sqrt{3}}{7}.$" #edb/ref 17592186045417] [17592186530445 #edb/ref 1072 #uuid "3b4c1a29-e4bc-58eb-ae8a-170f49cecb2b" #edb/ref 17592186045417] [17592186530445 #edb/ref 1074 "Recall that the conditional variance of $X$ given $Y=y$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=y] & =\\text{E}[(X-{\\mu }_{X|y})^{2}\\,|\\,Y=y] \\\\  & =\\text{E}[{X}^{2}\\,|\\,Y=y]-{\\mu }_{X|y}^{2},\\end{aligned}\n$$\n\nwhere \n\n$$\n\\text{E}[{X}^{2}\\,|\\,Y=y]={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,y)\\,\\text{d}x.\n$$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}\\,|\\,Y=0] & ={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,0)\\,\\text{d}x \\\\  & ={\\int }_{1}^{4}{x}^{2}\\cdot \\frac{3}{14}\\sqrt{x}\\,\\text{d}x \\\\  & ={\\int }_{1}^{4}\\frac{3}{14}{x}^{5/2}\\,\\text{d}x \\\\  & ={[\\frac{3}{49}{x}^{7/2}]}_{1}^{4} \\\\  & =\\frac{3}{49}(128-1) \\\\  & =\\frac{381}{49}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=0] & =\\text{E}[{X}^{2}\\,|\\,Y=0]-{\\mu }_{X|0}^{2} \\\\  & =\\frac{381}{49}-{(\\frac{\\sqrt{3}}{7})}^{2} \\\\  & =\\frac{381}{49}-\\frac{3}{49} \\\\  & =\\frac{378}{49} \\\\  & =\\frac{54}{7}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186530448 #edb/ref 1068 #edb/ref 17592186530400 #edb/ref 17592186045417] [17592186530448 #edb/ref 1069 "q-147052" #edb/ref 17592186045417] [17592186530448 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186530448 #edb/ref 1071 "$$\n\\begin{aligned}f(x,y)=\\{\\begin{aligned}x-y, & 0\\le x\\le 1,\\,-1\\le y\\le 0, \\\\ 0, & \\text{otherwise}\\end{aligned}\\,{f}_{X}(x)=\\{\\begin{aligned}x+\\frac{1}{2}, & 0\\le x\\le 1, \\\\ 0, & \\text{otherwise}\\end{aligned}\\end{aligned}\n$$\n\nLet $X$ and $Y$  be continuous random variables. Their joint probability density function and the marginal probability density function of $X$ are shown above. Find the conditional variance $\\text{Var}[Y\\,|\\,X=\\frac{1}{2}]