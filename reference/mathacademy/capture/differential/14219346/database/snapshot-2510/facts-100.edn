17] [17592186530459 #edb/ref 1069 "q-149357" #edb/ref 17592186045417] [17592186530459 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186530459 #edb/ref 1071 "$$\n{f}_{X|Y}(x\\,|\\,0)=\\{\\begin{aligned}\\frac{12}{7{x}^{5/2}}, & \\,1\\le x\\le 4 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nLet $X$ and $Y$ be continuous random variables. \nFind the conditional variance $\\text{Var}[X\\,|\\,Y=0]$ given that the conditional probability density function ${f}_{X|Y}(x\\,|\\,0)$ is shown above and the corresponding expected value is ${\\mu }_{X|0}=\\frac{12}{7}.$" #edb/ref 17592186045417] [17592186530459 #edb/ref 1072 #uuid "59aca6d9-1752-57b6-a727-2d8a95f6602b" #edb/ref 17592186045417] [17592186530459 #edb/ref 1074 "Recall that the conditional variance of $X$ given $Y=y$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=y] & =\\text{E}[(X-{\\mu }_{X|y})^{2}\\,|\\,Y=y] \\\\  & =\\text{E}[{X}^{2}\\,|\\,Y=y]-{\\mu }_{X|y}^{2},\\end{aligned}\n$$\n\nwhere \n\n$$\n\\text{E}[{X}^{2}\\,|\\,Y=y]={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,y)\\,\\text{d}x.\n$$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}\\,|\\,Y=0] & ={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,0)\\,\\text{d}x \\\\  & ={\\int }_{1}^{4}{x}^{2}\\cdot \\frac{12}{7{x}^{5/2}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{4}\\frac{12}{7\\sqrt{x}}\\,\\text{d}x \\\\  & ={[\\frac{24\\sqrt{x}}{7}]}_{1}^{4} \\\\  & =\\frac{48}{7}-\\frac{24}{7} \\\\  & =\\frac{24}{7}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=0] & =\\text{E}[{X}^{2}\\,|\\,Y=0]-{\\mu }_{X|0}^{2} \\\\  & =\\frac{24}{7}-{(\\frac{12}{7})}^{2} \\\\  & =\\frac{24}{7}-\\frac{144}{49} \\\\  & =\\frac{24}{49}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186530464 #edb/ref 1068 #edb/ref 17592186530221 #edb/ref 17592186045417] [17592186530464 #edb/ref 1069 "q-149399" #edb/ref 17592186045417] [17592186530464 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186530464 #edb/ref 1071 "$$\n{f}_{X|Y}(x\\,|\\,5)=\\{\\begin{aligned}\\frac{3}{{x}^{4}}, & \\,x\\le -1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nLet $X$ and $Y$ be continuous random variables. \nFind the conditional variance $\\text{Var}[X\\,|\\,Y=5]$ given that the conditional probability density function ${f}_{X|Y}(x\\,|\\,5)$ is shown above and the corresponding expected value is ${\\mu }_{X|5}=-\\frac{3}{2}.$" #edb/ref 17592186045417] [17592186530464 #edb/ref 1072 #uuid "6104314b-b213-5403-b96a-2e0ddf20d4ca" #edb/ref 17592186045417] [17592186530464 #edb/ref 1074 "Recall that the conditional variance of $X$ given $Y=y$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=y] & =\\text{E}[(X-{\\mu }_{X|y})^{2}\\,|\\,Y=y] \\\\  & =\\text{E}[{X}^{2}\\,|\\,Y=y]-{\\mu }_{X|y}^{2},\\end{aligned}\n$$\n\nwhere \n\n$$\n\\text{E}[{X}^{2}\\,|\\,Y=y]={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,y)\\,\\text{d}x.\n$$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}\\,|\\,Y=5] & ={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,5)\\,\\text{d}x \\\\  & ={\\int }_{-\\infty }^{-1}{x}^{2}\\cdot \\frac{3}{{x}^{4}}\\,\\text{d}x \\\\  & ={\\int }_{-\\infty }^{-1}\\frac{3}{{x}^{2}}\\,\\text{d}x \\\\  & ={\\int }_{-\\infty }^{-1}3{x}^{-2}\\,\\text{d}x \\\\  & ={[-3\\cdot {x}^{-1}]}_{-\\infty }^{-1} \\\\  & ={[-\\frac{3}{x}]}_{-\\infty }^{-1} \\\\  & =3-0 \\\\  & =3.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=5] & =\\text{E}[{X}^{2}\\,|\\,Y=5]-{\\mu }_{X|5}^{2} \\\\  & =3-{(-\\frac{3}{2})}^{2} \\\\  & =3-\\frac{9}{4} \\\\  & =\\frac{3}{4}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186530488 #edb/ref 1068 #edb/ref 17592186530310 #edb/ref 17592186045417] [17592186530488 #edb/ref 1069 "q-146807" #edb/ref 17592186045417] [17592186530488 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186530488 #edb/ref 1071 "$$\n{f}_{X|Y}(x\\,|\\,4)=\\{\\begin{aligned}\\frac{3}{{x}^{3/2}}, & \\,4\\le x\\le 9 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nLet $X$ and $Y$ be continuous random variables. \nFind the conditional variance $\\text{Var}[X\\,|\\,Y=4]$ given that the conditional probability density function ${f}_{X|Y}(x\\,|\\,4)$ is shown above and the corresponding expected value is ${\\mu }_{X|4}=6.$" #edb/ref 17592186045417] [17592186530488 #edb/ref 1072 #uuid "8cb1a10c-eb8d-5503-81eb-a44381451337" #edb/ref 17592186045417] [17592186530488 #edb/ref 1074 "Recall that the conditional variance of $X$ given $Y=y$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=y] & =\\text{E}[(X-{\\mu }_{X|y})^{2}\\,|\\,Y=y] \\\\  & =\\text{E}[{X}^{2}\\,|\\,Y=y]-{\\mu }_{X|y}^{2},\\end{aligned}\n$$\n\nwhere \n\n$$\n\\text{E}[{X}^{2}\\,|\\,Y=y]={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,y)\\,\\text{d}x.\n$$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}\\,|\\,Y=4] & ={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,4)\\,\\text{d}x \\\\  & ={\\int }_{4}^{9}{x}^{2}\\cdot \\frac{3}{{x}^{3/2}}\\,\\text{d}x \\\\  & ={\\int }_{4}^{9}3\\sqrt{x}\\,\\text{d}x \\\\  & ={[2{x}^{3/2}]}_{4}^{9} \\\\  & =2(27-8) \\\\  & =38.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=4] & =\\text{E}[{X}^{2}\\,|\\,Y=4]-{\\mu }_{X|4}^{2} \\\\  & =38-{6}^{2} \\\\  & =2.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186530494 #edb/ref 1068 #edb/ref 17592186530357 #edb/ref 17592186045417] [17592186530494 #edb/ref 1069 "q-149406" #edb/ref 17592186045417] [17592186530494 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186530494 #edb/ref 1071 "$$\n{f}_{X|Y}(x\\,|\\,-4)=\\{\\begin{aligned}\\frac{7}{2{x}^{9/2}}, & \\,x\\ge 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nLet $X$ and $Y$ be continuous random variables. \nFind the conditional variance $\\text{Var}[X\\,|\\,Y=-4]$ given that the conditional probability density function ${f}_{X|Y}(x\\,|\\,-4)$ is shown above and the corresponding expected value is ${\\mu }_{X|-4}=\\frac{7}{5}.$" #edb/ref 17592186045417] [17592186530494 #edb/ref 1072 #uuid "988b2bee-8b04-51ca-a9c5-c53fb0470471" #edb/ref 17592186045417] [17592186530494 #edb/ref 1074 "Recall that the conditional variance of $X$ given $Y=y$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=y] & =\\text{E}[(X-{\\mu }_{X|y})^{2}\\,|\\,Y=y] \\\\  & =\\text{E}[{X}^{2}\\,|\\,Y=y]-{\\mu }_{X|y}^{2},\\end{aligned}\n$$\n\nwhere \n\n$$\n\\text{E}[{X}^{2}\\,|\\,Y=y]={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,y)\\,\\text{d}x.\n$$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}\\,|\\,Y=-4] & ={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,-4)\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }{x}^{2}\\cdot \\frac{7}{2{x}^{9/2}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{7}{2{x}^{5/2}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{7}{2}{x}^{-5/2}\\,\\text{d}x \\\\  & ={[\\frac{7}{2}\\cdot (-\\frac{2}{3})\\cdot {x}^{-3/2}]}_{1}^{\\infty } \\\\  & ={[-\\frac{7}{3{x}^{3/2}}]}_{1}^{\\infty } \\\\  & =0-(-\\frac{7}{3}) \\\\  & =\\frac{7}{3}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=-4] & =\\text{E}[{X}^{2}\\,|\\,Y=-4]-{\\mu }_{X|-4}^{2} \\\\  & =\\frac{7}{3}-{(\\frac{7}{5})}^{2} \\\\  & =\\frac{7}{3}-\\frac{49}{25} \\\\  & =\\frac{28}{75}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186530502 #edb/ref 1068 #edb/ref 17592186530361 #edb/ref 17592186045417] [17592186530502 #edb/ref 1069 "q-146771" #edb/ref 17592186045417] [17592186530502 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186530502 #edb/ref 1071 "$$\n{f}_{X|Y}(x\\,|\\,-1)=\\{\\begin{aligned}\\frac{24}{7{x}^{4}}, & \\,1\\le x\\le 2 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nLet $X$ and $Y$ be continuous random variables. \nFind the conditional variance $\\text{Var}[X\\,|\\,Y=-1]$ given that the conditional probability density function ${f}_{X|Y}(x\\,|\\,-1)$ is shown above and the corresponding expected value is ${\\mu }_{X|-1}=\\frac{9}{7}.$" #edb/ref 17592186045417] [17592186530502 #edb/ref 1072 #uuid "a618ef53-1eb4-5d7e-994a-cd43bde62157" #edb/ref 17592186045417] [17592186530502 #edb/ref 1074 "Recall that the conditional variance of $X$ given $Y=y$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=y] & =\\text{E}[(X-{\\mu }_{X|y})^{2}\\,|\\,Y=y] \\\\  & =\\text{E}[{X}^{2}\\,|\\,Y=y]-{\\mu }_{X|y}^{2},\\end{aligned}\n$$\n\nwhere \n\n$$\n\\text{E}[{X}^{2}\\,|\\,Y=y]={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,y)\\,\\text{d}x.\n$$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}\\,|\\,Y=-1] & ={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,-1)\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}{x}^{2}\\cdot \\frac{24}{7{x}^{4}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}\\frac{24}{7{x}^{2}}\\,\\text{d}x \\\\  & =\\frac{24}{7}{[-\\frac{1}{x}]}_{1}^{2} \\\\  & =\\frac{24}{7}[(-\\frac{1}{2})-(-1)] \\\\  & =\\frac{12}{7}\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=-1] & =\\text{E}[{X}^{2}\\,|\\,Y=-1]-{\\mu }_{X|-1}^{2} \\\\  & =\\frac{12}{7}-{(\\frac{9}{7})}^{2} \\\\  & =\\frac{12}{7}-\\frac{81}{49} \\\\  & =\\frac{3}{49}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186530508 #edb/ref 1068 #edb/ref 17592186530295 #edb/ref 17592186045417] [17592186530508 #edb/ref 1069 "q-149407" #edb/ref 17592186045417] [17592186530508 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186530508 #edb/ref 1071 "$$\n{f}_{X|Y}(x\\,|\\,6)=\\{\\begin{aligned}-\\frac{6}{{x}^{7}}, & \\,x\\le -1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nLet $X$ and $Y$ be continuous random variables. \nFind the conditional variance $\\text{Var}[X\\,|\\,Y=6]$ given that the conditional probability density function ${f}_{X|Y}(x\\,|\\,6)$ is shown above and the corresponding expected value is ${\\mu }_{X|6}=-\\frac{6}{5}.$" #edb/ref 17592186045417] [17592186530508 #edb/ref 1072 #uuid "aa39286d-2046-5d16-b60c-2e22bf1173b7" #edb/ref 17592186045417] [17592186530508 #edb/ref 1074 "Recall that the conditional variance of $X$ given $Y=y$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=y] & =\\text{E}[(X-{\\mu }_{X|y})^{2}\\,|\\,Y=y] \\\\  & =\\text{E}[{X}^{2}\\,|\\,Y=y]-{\\mu }_{X|y}^{2},\\end{aligned}\n$$\n\nwhere \n\n$$\n\\text{E}[{X}^{2}\\,|\\,Y=y]={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,y)\\,\\text{d}x.\n$$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}\\,|\\,Y=6] & ={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,6)\\,\\text{d}x \\\\  & ={\\int }_{-\\infty }^{-1}{x}^{2}\\cdot (-\\frac{6}{{x}^{7}})\\,\\text{d}x \\\\  & ={\\int }_{-\\infty }^{-1}-\\frac{6}{{x}^{5}}\\,\\text{d}x \\\\  & ={\\int }_{-\\infty }^{-1}-6{x}^{-5}\\,\\text{d}x \\\\  & ={[\\frac{(-6)}{(-4)}\\cdot {x}^{-4}]}_{-\\infty }^{-1} \\\\  & ={[\\frac{3}{2{x}^{4}}]}_{-\\infty }^{-1} \\\\  & =\\frac{3}{2}-0 \\\\  & =\\frac{3}{2}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=6] & =\\text{E}[{X}^{2}\\,|\\,Y=6]-{\\mu }_{X|6}^{2} \\\\  & =\\frac{3}{2}-{(-\\frac{6}{5})}^{2} \\\\  & =\\frac{3}{2}-\\frac{36}{25} \\\\  & =\\frac{3}{50}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186530535 #edb/ref 1068 #edb/ref 17592186530412 #edb/ref 17592186045417] [17592186530535 #edb/ref 1069 "q-146981" #edb/ref 17592186045417] [17592186530535 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186530535 #edb/ref 1071 "$$\n\\begin{aligned}f(x,y)=\\{\\begin{aligned}\\frac{3({x}^{2}y+y)}{2}, & 0\\le x\\le 1,\\,0\\le y\\le 1, \\\\ 0, & \\text{otherwise}\\end{aligned}\\,{f}_{X}(x)=\\{\\begin{aligned}\\frac{3(1+{x}^{2})}{4}, & 0\\le x\\le 1, \\\\ 0, & \\text{otherwise}\\end{aligned}\\end{aligned}\n$$\n\nLet $X$ and $Y$  be continuous random variables. Their joint probability density function and the marginal probability density function of $X$ are shown above. Find the conditional variance $\\text{Var}[Y\\,|\\,X=1]$ given that the corresponding expected value is ${\\mu }_{Y|1}=\\frac{2}{3}.$" #edb/ref 17592186045417] [17592186530535 #edb/ref 1072 #uuid "e74c735c-6d68-5fb5-ad5e-520e538fc830" #edb/ref 17592186045417] [17592186530535 #edb/ref 1074 "Recall that the conditional variance of $Y$ given $X=x$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=x] & =\\text{E}[(Y-{\\mu }_{Y|x})^{2}\\,|\\,X=x] \\\\  & =\\text{E}[{Y}^{2}\\,|\\,X=x]-{\\mu }_{Y|x}^{2},\\end{aligned}\n$$\n\nwhere \n\n$$\n\\text{E}[{Y}^{2}\\,|\\,X=x]={\\int }_{-\\infty }^{\\infty }{y}^{2}\\,{f}_{Y|X}(y\\,|\\,x)\\,\\text{d}y.\n$$\n\nNote that $\\text{E}[Y\\,|\\,X=x]$ is a function of $x.$ \n\nThe conditional density function of $Y$ given $X=x$ can be computed as \n\n$$\n\\begin{aligned}{f}_{Y|X}(y\\,|\\,x) & =\\frac{f(x,y)}{{f}_{X}(x)} \\\\  & =\\frac{\\frac{3({x}^{2}y+y)}{2}}{\\frac{3(1+{x}^{2})}{4}} \\\\  & =\\frac{2({x}^{2}y+y)}{(1+{x}^{2})},\\end{aligned}\n$$\n\nwhere $0\\le x\\le 1,\\,0\\le y\\le 1.$ Outside this domain, we have ${f}_{Y|X}(y\\,|\\,x)=0.$\n\nNow, substituting $x=1$ into the expression for ${f}_{Y|X}(y\\,|\\,x),$ we get\n\n$$\n{f}_{Y|X}(y\\,|\\,1)=\\frac{2({1}^{2}\\cdot y+y)}{(1+{1}^{2})}=2y.\n$$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}\\text{E}[{Y}^{2}\\,|\\,X=1] & ={\\int }_{-\\infty }^{\\infty }{y}^{2}\\,{f}_{Y|X}(y\\,|\\,1)\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}{y}^{2}(2y)\\text{d}y \\\\  & =2{\\int }_{0}^{1}{y}^{3}\\text{d}y \\\\  & =2[\\frac{{y}^{4}}{4}]_{0}^{1} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=1] & =\\text{E}[{Y}^{2}\\,|\\,X=1]-{\\mu }_{Y|1}^{2} \\\\  & =\\frac{1}{2}-{(\\frac{2}{3})}^{2} \\\\  & =\\frac{1}{2}-\\frac{4}{9} \\\\  & =\\frac{1}{18}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186530546 #edb/ref 1068 #edb/ref 17592186530236 #edb/ref 17592186045417] [17592186530546 #edb/ref 1069 "q-146867" #edb/ref 17592186045417] [17592186530546 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186530546 #edb/ref 1071 "$$\n\\begin{aligned}f(x,y)=\\{\\begin{aligned}2-x-y, & 0\\le x\\le 1,\\,0\\le y\\le 1, \\\\ 0, & \\text{otherwise}\\end{aligned}\\,{f}_{Y}(y)=\\{\\begin{aligned}\\frac{3}{2}-y, & 0\\le y\\le 1, \\\\ 0, & \\text{otherwise}\\end{aligned}\\end{aligned}\n$$\n\n \n\nLet $X$ and $Y$  be continuous random variables. Their joint probability density function and the marginal probability density function of $Y$ are shown above. Find the conditional variance $\\text{Var}[X\\,|\\,Y=1]$ given that the corresponding expected value is ${\\mu }_{X|1}=\\frac{1}{3}.$" #edb/ref 17592186045417] [17592186530546 #edb/ref 1072 #uuid "febad6f8-061f-513c-bf3e-fbe38a2e6b2e" #edb/ref 17592186045417] [17592186530546 #edb/ref 1074 "Recall that the conditional variance of $X$ given $Y=y$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=y] & =\\text{E}[(X-{\\mu }_{X|y})^{2}\\,|\\,Y=y] \\\\  & =\\text{E}[{X}^{2}\\,|\\,Y=y]-{\\mu }_{X|y}^{2},\\end{aligned}\n$$\n\nwhere \n\n$$\n\\text{E}[{X}^{2}\\,|\\,Y=y]={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,y)\\,\\text{d}x.\n$$\n\nNote that $\\text{E}[X\\,|\\,Y=y]$ is a function of $y.$ \n\nThe conditional density function of $X$ given $Y=y$ can be computed as \n\n$$\n\\begin{aligned}{f}_{X|Y}(x\\,|\\,y) & =\\frac{f(x,y)}{{f}_{Y}(y)} \\\\  & =\\frac{(2-x-y)}{(\\frac{3}{2}-y)} \\\\  & =\\frac{4-2x-2y}{3-2y},\\end{aligned}\n$$\n\n \n\nwhere $0\\le x\\le 1,\\,0\\le y\\le 1.$ Outside this domain, we have ${f}_{X|Y}(x\\,|\\,y)=0.$\n\nNow, substituting $y=1$ into the expression for ${f}_{X|Y}(x\\,|\\,y),$ we get\n\n$$\n{f}_{X|Y}(x\\,|\\,1)=\\frac{4-2x-2\\cdot 1}{3-2\\cdot 1}=\\frac{4-2x-2}{3-2}=2-2x.\n$$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}\\,|\\,Y=1] & ={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,1)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{x}^{2}(2-2x)\\text{d}x \\\\  & ={\\int }_{0}^{1}(2{x}^{2}-2{x}^{3})\\,\\text{d}x \\\\  & ={[\\frac{2{x}^{3}}{3}-\\frac{{x}^{4}}{2}]}_{0}^{1} \\\\  & =(\\frac{2}{3}-\\frac{1}{2}-0) \\\\  & =\\frac{4-3}{6} \\\\  & =\\frac{1}{6}.\\end{aligned}\n$$\n\n \n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=1] & =\\text{E}[{X}^{2}\\,|\\,Y=1]-{\\mu }_{X|1}^{2} \\\\  & =\\frac{1}{6}-{(\\frac{1}{3})}^{2} \\\\  & =\\frac{1}{6}-\\frac{1}{9} \\\\  & =\\frac{1}{18}.\\end{aligned}\n$$" #edb/ref 17592186045417]}
