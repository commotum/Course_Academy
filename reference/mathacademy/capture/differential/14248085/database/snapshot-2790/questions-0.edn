6}\n$$\n\nEvaluating the last two terms, we get\n\n$$\n{(x+\\frac{5}{6})}^{2}-1.\n$$\n\nFinally, we substitute this result back into our original expression::\n\n$$\n\\begin{aligned}6({x}^{2}+\\frac{5}{3}x-\\frac{11}{36}) & =6({(x+\\frac{5}{6})}^{2}-1) \\\\  & =6{(x+\\frac{5}{6})}^{2}-6\\cdot 1 \\\\  & =6{(x+\\frac{5}{6})}^{2}-6\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186184485 :knowledge-point/_questions [{:db/id #edb/ref 17592186184322 :knowledge-point/id #uuid "2a85fece-e40f-543c-b3c3-ae43a5175808" :knowledge-point/title "Completing the Square When the Leading Coefficient is Negative One: Odd Linear Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ed635517-1e2e-5055-bfef-ec4ab55d6015" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4} - (x + \\frac{1}{2})^{2}" :db/id #edb/ref 17592186181088} {:answer/id #uuid "1d3e14f7-178c-52e2-928c-b3db73315056" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{4} - (x + \\frac{1}{2})^{2}" :db/id #edb/ref 17592186181089} {:answer/id #uuid "22b6d492-b75e-59f9-bd17-30e8a9998118" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1 - (x + 2)^{2}" :db/id #edb/ref 17592186181090} {:answer/id #uuid "31e7dd93-022e-5efb-84aa-21eb584e49ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{11}{4} - (x + \\frac{1}{2})^{2}" :db/id #edb/ref 17592186181091} {:answer/id #uuid "623a38cf-c149-5a8f-9c35-bae705634607" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10}{4} - (x - \\frac{1}{2})^{2}" :db/id #edb/ref 17592186181092}] :answer-field/id #uuid "8091fb4f-3520-5238-a1fe-8deaeb6d643a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186181087}] :question/id #uuid "67f49a8a-532a-55d5-814b-4932396dbbeb" :question/math-academy-id "q-140406" :question/problem "Rewrite $-x^{2} - x - 3$ by completing the square."}] [{:db/id #edb/ref 17592186272127 :knowledge-point/_questions [{:db/id #edb/ref 17592186184212 :knowledge-point/id #uuid "3202d7cc-541b-553b-8ec1-d4ea85dd0590" :knowledge-point/title "Completing the Square on an Expression With a Negative Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d5e40a0-bb1b-5159-95df-8a81f60527ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5{(x+4)}^{2}+20" :db/id #edb/ref 17592186269676} {:answer/id #uuid "67107a8a-2dd9-5dbc-b0a4-79d01366d76a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5{(x+4)}^{2}-5" :db/id #edb/ref 17592186270186} {:answer/id #uuid "e5de3296-93d1-57f6-a0c1-155f521a694c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5{(x+4)}^{2}+16" :db/id #edb/ref 17592186271292} {:answer/id #uuid "ee9bacd1-e2fe-51ca-b317-8cb0d98826a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5{(x-4)}^{2}-16" :db/id #edb/ref 17592186271365} {:answer/id #uuid "efc066ec-cde9-533c-9085-bb96bb129a27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{(5x+4)}^{2}-4" :db/id #edb/ref 17592186271377}] :answer-field/correct {:answer/id #uuid "2d5e40a0-bb1b-5159-95df-8a81f60527ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5{(x+4)}^{2}+20" :db/id #edb/ref 17592186269676} :answer-field/id #uuid "127abff6-4446-5351-8594-23776f79806f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271538}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "11a225fd-d96c-5a5e-9031-b51e03cdd249" :question/math-academy-id "q-140532" :question/problem "Rewrite $-5{x}^{2}-40x-60$ by completing the square." :question/worked-solution "Notice that the leading coefficient is $-5.$ So, we take out a factor of $-5$ from the entire expression:\n\n$$\n-5({x}^{2}+8x+12)\n$$\n\nLet's now complete the square for the expression inside the parentheses:\n\n$$\n{x}^{2}+8x+12\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{x}^{2}+2\\cdot 4x+12\n$$\n\nThen, we *add* and *then subtract* ${4}^{2},$ writing the constant term $12$ last:\n\n$$\n{{x}^{2}+2\\cdot 4x+{4}^{2}}_{⏟}-{4}^{2}+12\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n(x+4)^{2}-{4}^{2}+12\n$$\n\nEvaluating the last two terms, we get\n\n$$\n(x+4)^{2}-4\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}-5({x}^{2}+8x+12) & =-5((x+4)^{2}-4) \\\\  & =-5{(x+4)}^{2}+(-5)\\cdot (-4) \\\\  & =-5{(x+4)}^{2}+20\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272329 :knowledge-point/_questions [{:db/id #edb/ref 17592186184322 :knowledge-point/id #uuid "2a85fece-e40f-543c-b3c3-ae43a5175808" :knowledge-point/title "Completing the Square When the Leading Coefficient is Negative One: Odd Linear Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f430bea-8bdc-5c1d-ad5c-0fb423bfc8b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{91}{4}-{(y-\\frac{11}{2})}^{2}" :db/id #edb/ref 17592186270254} {:answer/id #uuid "7d098b28-9b36-5a5a-a306-848196bbfbd2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}-{(y+\\frac{11}{2})}^{2}" :db/id #edb/ref 17592186270364} {:answer/id #uuid "c20ec7e5-a2f5-52cc-b689-4b8b3c3e13ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{91}{4}-{(y+\\frac{11}{2})}^{2}" :db/id #edb/ref 17592186270986} {:answer/id #uuid "f5575521-acc6-52d8-8ef0-33c9633f2919" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{109}{4}-{(y-\\frac{11}{2})}^{2}" :db/id #edb/ref 17592186271424} {:answer/id #uuid "f7f0d581-4e01-550f-8515-51c1277eb311" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}-{(y-\\frac{11}{2})}^{2}" :db/id #edb/ref 17592186271443}] :answer-field/correct {:answer/id #uuid "f7f0d581-4e01-550f-8515-51c1277eb311" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}-{(y-\\frac{11}{2})}^{2}" :db/id #edb/ref 17592186271443} :answer-field/id #uuid "05fb4a22-6bc6-599f-9a3e-03db139590ca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271513}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "801928f5-f859-5bec-ad10-ef9e1c04ab4f" :question/math-academy-id "q-142071" :question/problem "Rewrite $-({y}^{2}-11y+30)$ by completing the square." :question/worked-solution "We begin by completing the square for the expression inside the parentheses:\n\n$$\n{y}^{2}-11y+30\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{y}^{2}-2\\cdot \\frac{11}{2}y+30\n$$\n\nThen, we *add* and *then subtract* ${(\\frac{11}{2})}^{2},$ writing the constant term $30$ last:\n\n$$\n{{y}^{2}-2\\cdot \\frac{11}{2}y+{(\\frac{11}{2})}^{2}}_{⏟}-{(\\frac{11}{2})}^{2}+30\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(y-\\frac{11}{2})}^{2}-{(\\frac{11}{2})}^{2}+30\n$$\n\nEvaluating the last two terms, we get\n\n$$\n{(y-\\frac{11}{2})}^{2}-\\frac{1}{4}.\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}-({y}^{2}-11y+30) & =-({(y-\\frac{11}{2})}^{2}-\\frac{1}{4}) \\\\  & =-{(y-\\frac{11}{2})}^{2}+\\frac{1}{4} \\\\  & =\\frac{1}{4}-{(y-\\frac{11}{2})}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290359 :knowledge-point/_questions [{:db/id #edb/ref 17592186184212 :knowledge-point/id #uuid "3202d7cc-541b-553b-8ec1-d4ea85dd0590" :knowledge-point/title "Completing the Square on an Expression With a Negative Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c14db59a-5903-5eb2-a881-001d6a5d5e64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186289311}] :answer-field/correct {:answer/id #uuid "c14db59a-5903-5eb2-a881-001d6a5d5e64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186289311} :answer-field/id #uuid "02af0bbe-51a6-5d5a-8c08-cd4c322fac91" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289734} {:answer-field/choices [{:answer/id #uuid "a1f1c3a8-e3fd-557c-98d8-6af928d2c7f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186289113}] :answer-field/correct {:answer/id #uuid "a1f1c3a8-e3fd-557c-98d8-6af928d2c7f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186289113} :answer-field/id #uuid "1a2b726d-3532-55e2-ab3b-c21e3a83a5cf" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289793} {:answer-field/choices [{:answer/id #uuid "c2207dc9-eda4-56d0-ba73-d6dcca1b8315" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186289316}] :answer-field/correct {:answer/id #uuid "c2207dc9-eda4-56d0-ba73-d6dcca1b8315" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186289316} :answer-field/id #uuid "61042d02-bc0e-5fb3-8749-0a4f5cca1d61" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289939}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4b993c3c-e8bb-5de5-8511-a2d9d6d2b174" :question/math-academy-id "q-218759" :question/problem "Rewrite $-8{x}^{2}+32x-29$ by completing the square.\n\n$-8{x}^{2}+32x-29=$\n{{field-1}}\n$-\\,$\n{{field-2}}\n$(x\\,-$\n{{field-3}}\n$)^{2}$" :question/worked-solution "Notice that the leading coefficient is $-8.$ So, we take out a factor of $-8$ from the entire expression:\n\n$$\n-8({x}^{2}-4x+\\frac{29}{8})\n$$\n\nLet's now complete the square for the expression inside the parentheses:\n\n$$\n{x}^{2}-4x+\\frac{29}{8}\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{x}^{2}-2\\cdot 2x+\\frac{29}{8}\n$$\n\nThen, we *add* and *then subtract* ${2}^{2},$ writing the constant term $\\frac{29}{8}$ last:\n\n$$\n{{x}^{2}-2\\cdot 2x+{2}^{2}}_{⏟}-\\,{2}^{2}-\\frac{29}{8}\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n(x-2)^{2}-{2}^{2}-\\frac{29}{8}\n$$\n\nEvaluating the last two terms, we get\n\n$$\n(x-2)^{2}-\\frac{3}{8}.\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}-8({x}^{2}-4x+\\frac{29}{8}) & =-8({(x-2)}^{2}-\\frac{3}{8}) \\\\  & =-8{(x-2)}^{2}+(-8)\\cdot (-\\frac{3}{8}) \\\\  & =-8{(x-2)}^{2}+3 \\\\  & =3-8{(x-2)}^{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186332892 :knowledge-point/_questions [{:db/id #edb/ref 17592186184323 :knowledge-point/id #uuid "564f2cf7-aaaf-5dea-b619-a560c3151fcc" :knowledge-point/title "Completing the Square on an Expression With a Positive Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11a795cb-9f0e-5939-900e-adafa303f8bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6{(x-\\frac{1}{6})}^{2}-\\frac{1}{9}" :db/id #edb/ref 17592186330103} {:answer/id #uuid "586c59c4-4661-5f6d-8c14-a8719591fc01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6{(x-\\frac{1}{6})}^{2}-\\frac{1}{6}" :db/id #edb/ref 17592186330738} {:answer/id #uuid "72076787-7552-58b8-8ad4-00b516cbaf7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(6x-\\frac{1}{3})}^{2}+\\frac{1}{9}" :db/id #edb/ref 17592186330976} {:answer/id #uuid "98ee28e9-1737-5e3b-81c5-05141104f588" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(6x-\\frac{1}{3})}^{2}+\\frac{1}{6}" :db/id #edb/ref 17592186331315} {:answer/id #uuid "f630c36b-13b8-5df3-93c0-7e5b92d1a0cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6{(x-\\frac{1}{6})}^{2}+\\frac{1}{3}" :db/id #edb/ref 17592186332110}] :answer-field/correct {:answer/id #uuid "586c59c4-4661-5f6d-8c14-a8719591fc01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6{(x-\\frac{1}{6})}^{2}-\\frac{1}{6}" :db/id #edb/ref 17592186330738} :answer-field/id #uuid "3d388fcd-2c84-5c86-86ee-03feb01e614c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332301}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "38a732d9-8b0e-58f3-ab88-f23eff634c61" :question/math-academy-id "q-52537" :question/problem "Rewrite $6{x}^{2}-2x$ by completing the square." :question/worked-solution "Notice that the leading coefficient is $6.$ So, we take out a factor of $6$ from the entire expression:\n\n$$\n6({x}^{2}-\\frac{1}{3}x)\n$$\n\nLet's now complete the square for the expression inside the parentheses:\n\n$$\n{x}^{2}-\\frac{1}{3}x\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{x}^{2}-2\\cdot \\frac{1}{6}x\n$$\n\nThen, we *add* and *then subtract* ${(\\frac{1}{6})}^{2}:$ \n\n$$\n{{x}^{2}-2\\cdot \\frac{1}{6}x+{(\\frac{1}{6})}^{2}}_{⏟}-{(\\frac{1}{6})}^{2}\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(x-\\frac{1}{6})}^{2}-{(\\frac{1}{6})}^{2}\n$$\n\nEvaluating the last term, we get\n\n$$\n{(x-\\frac{1}{6})}^{2}-\\frac{1}{36}\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}6({x}^{2}-\\frac{1}{3}x) & =6({(x-\\frac{1}{6})}^{2}-\\frac{1}{36}) \\\\  & =6{(x-\\frac{1}{6})}^{2}-6\\cdot \\frac{1}{36} \\\\  & =6{(x-\\frac{1}{6})}^{2}-\\frac{1}{6}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186184806 :knowledge-point/_questions [{:db/id #edb/ref 17592186184212 :knowledge-point/id #uuid "3202d7cc-541b-553b-8ec1-d4ea85dd0590" :knowledge-point/title "Completing the Square on an Expression With a Negative Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01ddff9c-ac54-5bdb-8e05-4c9e80b9afd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3{(y+1)}^{2}+\\frac{4}{3}" :db/id #edb/ref 17592186329975} {:answer/id #uuid "30d8498f-8b3e-524c-b327-f7f1af56ad01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3{(y-1)}^{2}-\\frac{4}{3}" :db/id #edb/ref 17592186330381} {:answer/id #uuid "4d8ac45d-48a3-5d22-9f35-e862992b052f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3{(y+1)}^{2}-4" :db/id #edb/ref 17592186330655} {:answer/id #uuid "f1e12e2d-9ac1-56f3-b293-e94794a6a02c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3{(y-\\frac{1}{3})}^{2}+4" :db/id #edb/ref 17592186332078} {:answer/id #uuid "fcb7f176-7c6f-5b6e-950c-ed129b00ef62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3{(y-1)}^{2}+4" :db/id #edb/ref 17592186332171}] :answer-field/correct {:answer/id #uuid "fcb7f176-7c6f-5b6e-950c-ed129b00ef62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3{(y-1)}^{2}+4" :db/id #edb/ref 17592186332171} :answer-field/id #uuid "064cff71-f6ed-52e2-8855-063c335fc1b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332205}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f4b82526-21d1-5906-b903-379b7a33781d" :question/math-academy-id "q-52544" :question/problem "Rewrite $-3{y}^{2}+6y+1$ by completing the square." :question/worked-solution "Notice that the leading coefficient is $-3.$ So, we take out a factor of $-3$ from the entire expression:\n\n$$\n-3({y}^{2}-2y-\\frac{1}{3})\n$$\n\nLet's now complete the square for the expression inside the parentheses:\n\n$$\n{y}^{2}-2y-\\frac{1}{3}\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{y}^{2}-2\\cdot 1y-\\frac{1}{3}\n$$\n\nThen, we *add* and *then subtract* ${1}^{2},$ writing the constant term $\\frac{1}{3}$ last:\n\n$$\n{{y}^{2}-2\\cdot 1y+{1}^{2}}_{⏟}-{1}^{2}-\\frac{1}{3}\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n(y-1)^{2}-{1}^{2}-\\frac{1}{3}\n$$\n\nEvaluating the last two terms, we get\n\n$$\n(y-1)^{2}-\\frac{4}{3}.\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}-3({y}^{2}-2y-\\frac{1}{3}) & =-3({(y-1)}^{2}-\\frac{4}{3}) \\\\  & =-3{(y-1)}^{2}+(-3)\\cdot (-\\frac{4}{3}) \\\\  & =-3{(y-1)}^{2}+4\\end{aligned}\n$$"}]}
