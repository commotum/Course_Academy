[{"source" ":org/Math-Academy" "forms" [[:db/retract 17592186181075 :answer-field/choices 17592186181076] [:db/retract 17592186181075 :answer-field/choices 17592186181077] [:db/retract 17592186181075 :answer-field/choices 17592186181078] [:db/retract 17592186181075 :answer-field/choices 17592186181079] [:db/retract 17592186181075 :answer-field/choices 17592186181080] [:db/retract 17592186181087 :answer-field/choices 17592186181088] [:db/retract 17592186181087 :answer-field/choices 17592186181089] [:db/retract 17592186181087 :answer-field/choices 17592186181090] [:db/retract 17592186181087 :answer-field/choices 17592186181091] [:db/retract 17592186181087 :answer-field/choices 17592186181092] {:db/id 17592186184211 :knowledge-point/questions ["question-71c17160-e343-5b78-8eee-e55ba4967a40" "question-bb8a5938-134a-51c9-838d-3e4010a8ca50" "question-e52c4055-fdc4-580f-9736-b9940edca056"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186184322 :knowledge-point/questions ["question-52455c8c-f427-542e-9cf2-e8b407fdf74f"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186184323 :knowledge-point/questions ["question-6fcb379b-2e62-54ea-ab65-5d0b75f0dbcd" "question-a3f44aac-b56c-541f-849d-0822403501d2" "question-5eff477c-d77b-5edc-9e57-fb4474642e96"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186184212 :knowledge-point/questions ["question-d53c2052-a67a-5988-8f1a-4c9a720c7a75" "question-71daf213-45ae-576f-97ae-9ffbff2f758a"] :db/ensure [:knowledge-point/validate]} {:db/id "question-71c17160-e343-5b78-8eee-e55ba4967a40" :question/id #uuid "71c17160-e343-5b78-8eee-e55ba4967a40" :question/math-academy-id "q-140322" :question/problem "Rewrite $-({x}^{2}-12x+35)$ by completing the square." :question/worked-solution "We begin by completing the square for the expression inside the parentheses:\n\n$$\n{x}^{2}-12x+35\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{x}^{2}-2\\cdot 6x+35\n$$\n\nThen, we *add* and *then subtract* ${6}^{2},$ writing the constant term $35$ last:\n\n$$\n{{x}^{2}-2\\cdot 6x+{6}^{2}}_{⏟}-{6}^{2}+35\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n(x-6)^{2}-{6}^{2}+35\n$$\n\nEvaluating the last two terms, we get\n\n$$\n(x-6)^{2}-1.\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}-({x}^{2}-12x+35) & =-({(x-6)}^{2}-1) \\\\  & =-{(x-6)}^{2}+1 \\\\  & =1-(x-6)^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-0e21de81-a1b0-5b51-8bf2-2764e594128c"] :db/ensure [:question/validate]} {:db/id "answer-field-0e21de81-a1b0-5b51-8bf2-2764e594128c" :answer-field/id #uuid "0e21de81-a1b0-5b51-8bf2-2764e594128c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-12fd1b63-f3c4-5f58-9b24-c3b8e327902e" :answer-field/choices ["answer-b7dc3995-7e49-5218-bd7f-84bc849ae212" "answer-ab8f5a47-f218-5790-b0cf-2c6bd714ec14" "answer-12fd1b63-f3c4-5f58-9b24-c3b8e327902e" "answer-f44e234d-afc4-503a-ae90-2371906eb7fb" "answer-2def7528-a392-5c38-a317-849706e41d62"] :db/ensure [:answer-field/validate]} {:db/id "answer-b7dc3995-7e49-5218-bd7f-84bc849ae212" :answer/id #uuid "b7dc3995-7e49-5218-bd7f-84bc849ae212" :answer/type :answer.type/math :answer/value "-1-(x+6)^{2}" :db/ensure [:answer/validate]} {:db/id "answer-ab8f5a47-f218-5790-b0cf-2c6bd714ec14" :answer/id #uuid "ab8f5a47-f218-5790-b0cf-2c6bd714ec14" :answer/type :answer.type/math :answer/value "-36-(x-6)^{2}" :db/ensure [:answer/validate]} {:db/id "answer-12fd1b63-f3c4-5f58-9b24-c3b8e327902e" :answer/id #uuid "12fd1b63-f3c4-5f58-9b24-c3b8e327902e" :answer/type :answer.type/math :answer/value "1-(x-6)^{2}" :db/ensure [:answer/validate]} {:db/id "answer-f44e234d-afc4-503a-ae90-2371906eb7fb" :answer/id #uuid "f44e234d-afc4-503a-ae90-2371906eb7fb" :answer/type :answer.type/math :answer/value "35-(x+6)^{2}" :db/ensure [:answer/validate]} {:db/id "answer-2def7528-a392-5c38-a317-849706e41d62" :answer/id #uuid "2def7528-a392-5c38-a317-849706e41d62" :answer/type :answer.type/math :answer/value "71-(x-6)^{2}" :db/ensure [:answer/validate]} {:db/id "question-bb8a5938-134a-51c9-838d-3e4010a8ca50" :question/id #uuid "bb8a5938-134a-51c9-838d-3e4010a8ca50" :question/math-academy-id "q-140319" :question/problem "Rewrite $-({y}^{2}-8y+60)$ by completing the square." :question/worked-solution "We begin by completing the square for the expression inside the parentheses:\n\n$$\n{y}^{2}-8y+60\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{y}^{2}-2\\cdot 4y+60\n$$\n\nThen, we *add* and *then subtract* ${4}^{2},$ writing the constant term $60$ last:\n\n$$\n{{y}^{2}-2\\cdot 4y+{4}^{2}}_{⏟}-{4}^{2}+60\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n(y-4)^{2}-{4}^{2}+60\n$$\n\nEvaluating the last two terms, we get\n\n$$\n(y-4)^{2}+44.\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}-({y}^{2}-8y+60) & =-({(y-4)}^{2}+44) \\\\  & =-{(y-4)}^{2}-44 \\\\  & =-44-(y-4)^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f3ff7a4b-bfcf-57eb-b578-4dd542e44b32"] :db/ensure [:question/validate]} {:db/id "answer-field-f3ff7a4b-bfcf-57eb-b578-4dd542e44b32" :answer-field/id #uuid "f3ff7a4b-bfcf-57eb-b578-4dd542e44b32" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b2f33409-e27b-5ceb-ba94-f59981011277" :answer-field/choices ["answer-b2f33409-e27b-5ceb-ba94-f59981011277" "answer-4b141f66-de8e-506c-a57a-d99a3a23fc93" "answer-3662e5af-46a7-5722-9ccd-5d2228b374fe" "answer-ec3c2400-2c72-5f8d-b4b6-ba5f48a46492" "answer-354b6c4f-e84d-5b59-96f6-ec5ff4ca3b16"] :db/ensure [:answer-field/validate]} {:db/id "answer-b2f33409-e27b-5ceb-ba94-f59981011277" :answer/id #uuid "b2f33409-e2