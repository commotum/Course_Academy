      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14161266/observations/step-q160577-b329ca18f7d6ef371ee4.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14161266/observations/step-q160577-b329ca18f7d6ef371ee4.png",
      "source_url": "https://mathacademy.com/tasks/14161266/topics/4149/review",
      "captured_at": 1791880345.1992915,
      "math_academy_id": "q-160577",
