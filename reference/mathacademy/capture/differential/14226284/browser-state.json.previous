under><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mrow data-mjx-texclass=\"OPEN\"><mo minsize=\"1.623em\" maxsize=\"1.623em\">(</mo></mrow><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>8</mn><msup><mi>x</mi><mn>6</mn></msup></mrow><msup><mi>x</mi><mn>5</mn></msup></mfrac></mstyle><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>5</mn><msup><mi>x</mi><mn>5</mn></msup></mfrac></mstyle><mrow data-mjx-texclass=\"CLOSE\"><mo minsize=\"1.623em\" maxsize=\"1.623em\">)</mo></mrow></mrow><mrow><mrow data-mjx-texclass=\"OPEN\"><mo minsize=\"1.623em\" maxsize=\"1.623em\">(</mo></mrow><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>2</mn><msup><mi>x</mi><mn>5</mn></msup></mrow><msup><mi>x</mi><mn>5</mn></msup></mfrac></mstyle><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>7</mn><mi>x</mi></mrow><msup><mi>x</mi><mn>5</mn></msup></mfrac></mstyle><mrow data-mjx-texclass=\"CLOSE\"><mo minsize=\"1.623em\" maxsize=\"1.623em\">)</mo></mrow></mrow></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><munder><mo data-mjx-texclass=\"OP\" movablelimits=\"true\">lim</mo><mrow data-mjx-texclass=\"ORD\"><mi>x</mi><mo accent=\"false\" stretchy=\"false\">→</mo><mi mathvariant=\"normal\">∞</mi></mrow></munder><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mrow data-mjx-texclass=\"OPEN\"><mo minsize=\"1.623em\" maxsize=\"1.623em\">(</mo></mrow><mn>8</mn><mi>x</mi><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>5</mn><msup><mi>x</mi><mn>5</mn></msup></mfrac></mstyle><mrow data-mjx-texclass=\"CLOSE\"><mo minsize=\"1.623em\" maxsize=\"1.623em\">)</mo></mrow></mrow><mrow><m