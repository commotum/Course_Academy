86045417] [17592186124911 #edb/ref 1069 "q-35763" #edb/ref 17592186045417] [17592186124911 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186124911 #edb/ref 1071 "Find the horizontal asymptote of the function $f(x)=\\frac{2x+5}{2{x}^{3}+2x+6}.$" #edb/ref 17592186045417] [17592186124911 #edb/ref 1072 #uuid "24c1ddd3-5086-5a99-bc61-14c84e2545e8" #edb/ref 17592186045417] [17592186124911 #edb/ref 1074 "The horizontal asymptote is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is ${x}^{3}.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{2x+5}{2{x}^{3}+2x+6} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{2x}{{x}^{3}}+\\frac{5}{{x}^{3}})}{(\\frac{2{x}^{3}}{{x}^{3}}+\\frac{2x}{{x}^{3}}+\\frac{6}{{x}^{3}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{2}{{x}^{2}}+\\frac{5}{{x}^{3}})}{(2+\\frac{2}{{x}^{2}}+\\frac{6}{{x}^{3}})} \\\\  & =\\frac{0+0}{2+0+0} \\\\  & =0.\\end{aligned}\n$$\n\n \n\nTherefore, the horizontal asymptote of $f(x)$ is $y=0.$" #edb/ref 17592186045417] [17592186125668 #edb/ref 1058 #edb/ref 17592186125669 #edb/ref 17592186045417] [17592186125668 #edb/ref 1061 471 #edb/ref 17592186045417] [17592186125668 #edb/ref 1062 #uuid "6cb8d91a-6de6-5bd6-878e-78ec12b7fedf" #edb/ref 17592186045417] [17592186125668 #edb/ref 1063 #edb/ref 17592186125743 #edb/ref 17592186045417] [17592186125669 #edb/ref 1058 #edb/ref 17592186125670 #edb/ref 17592186045417] [17592186125669 #edb/ref 1061 472 #edb/ref 17592186045417] [17592186125669 #edb/ref 1062 #uuid "eb8b99ee-a21a-5d00-8571-260574714375" #edb/ref 17592186045417] [17592186125669 #edb/ref 1063 #edb/ref 17592186124661 #edb/ref 17592186045417] [17592186125670 #edb/ref 1058 #edb/ref 17592186125671 #edb/ref 17592186045417] [17592186125670 #edb/ref 1061 475 #edb/ref 17592186045417] [17592186125670 #edb/ref 1062 #uuid "98d0d8f6-bd8d-5c4f-811f-469eaac31888" #edb/ref 17592186045417] [17592186125670 #edb/ref 1063 #edb/ref 17592186124662 #edb/ref 17592186045417] [17592186125671 #edb/ref 1058 #edb/ref 17592186125672 #edb/ref 17592186045417] [17592186125671 #edb/ref 1061 477 #edb/ref 17592186045417] [17592186125671 #edb/ref 1062 #uuid "22bf77c7-a859-5972-9d3a-30c0590708ed" #edb/ref 17592186045417] [17592186125671 #edb/ref 1063 #edb/ref 17592186125748 #edb/ref 17592186045417] [17592186125672 #edb/ref 1058 #edb/ref 17592186125673 #edb/ref 17592186045417] [17592186125672 #edb/ref 1061 478 #edb/ref 17592186045417] [17592186125672 #edb/ref 1062 #uuid "f59b9e85-79cc-5fcd-b7a2-da25e2aeac81" #edb/ref 17592186045417] [17592186125672 #edb/ref 1063 #edb/ref 17592186124663 #edb/ref 17592186045417] [17592186125673 #edb/ref 1061 480 #edb/ref 17592186045417] [17592186125673 #edb/ref 1062 #uuid "f3b88a81-a304-57e3-a798-5432c418d285" #edb/ref 17592186045417] [17592186125673 #edb/ref 1063 #edb/ref 17592186124664 #edb/ref 17592186045417] [17592186125743 #edb/ref 1064 "To calculate the limit at infinity of a rational function, such as\n\n$$\n\\lim_\\limits{x\\rightarrow \\infty}\\left(\\dfrac{x^4}{x^5-x^2}\\right),\n$$\n\n we apply the following procedure:\n\n**Step 1:** Divide both the numerator and the denominator by the highest power of $x$ in the *denominator*.\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }(\\frac{{x}^{4}}{{x}^{5}-{x}^{2}}) & ={lim}_{x\\to \\infty }(\\frac{{x}^{4}÷{x}^{5}}{({x}^{5}-{x}^{2})÷{x}^{5}}) \\\\  & ={lim}_{x\\to \\infty }(\\frac{\\frac{{x}^{4}}{{x}^{5}}}{\\frac{{x}^{5}}{{x}^{5}}-\\frac{{x}^{2}}{{x}^{5}}}) \\\\  & ={lim}_{x\\to \\infty }(\\frac{\\frac{1}{x}}{1-\\frac{1}{{x}^{3}}})\\end{aligned}\n$$\n\n**Step 2:** Apply the rule that if $n$ is any positive integer then $\\displaystyle \\lim_\\limits{x\\rightarrow \\infty}\\left(\\dfrac{1}{x^n}\\right)=0.$ Evaluate the remaining expression to obtain the answer.\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }(\\frac{{x}^{4}}{{x}^{5}-{x}^{2}}) & ={lim}_{x\\to \\infty }(\\frac{\\frac{1}{x}}{1-\\frac{1}{{x}^{3}}}) \\\\  & =\\frac{0}{1-0} \\\\  & =\\frac{0}{1} \\\\  & =0\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186125743 #edb/ref 1065 258 #edb/ref 17592186045417] [17592186125743 #edb/ref 1066 #uuid "ed558480-81a6-5baf-ab3a-f19468f77d72" #edb/ref 17592186045417] [17592186125743 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186125748 #edb/ref 1064 "The horizontal asymptotes of a rational function $y=f(x)$ coincide with the infinite limits of $f(x).$\n\nFor example, we can use the same procedure as before to find the horizontal asymptote of $y=f(x) = \\dfrac{x+1}{x^2+2}.$ As a result, we get \n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{x+1}{{x}^{2}+2} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{x}{{x}^{2}}+\\frac{1}{{x}^{2}})}{(\\frac{{x}^{2}}{{x}^{2}}+\\frac{2}{{x}^{2}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{1}{x}+\\frac{1}{{x}^{2}})}{(1+\\frac{2}{{x}^{2}})} \\\\  & =\\frac{0+0}{1+0} \\\\  & =0.\\end{aligned}\n$$\n\nSo the horizontal asymptote of the graph $y=f(x)$ is $y=0$, as shown below.\n\n![](images/27/27c77f2d6a06bad338982d000f916811201c45e9b16713caf40cc4d5bcf911bd.png)" #edb/ref 17592186045417] [17592186125748 #edb/ref 1065 261 #edb/ref 17592186045417] [17592186125748 #edb/ref 1066 #uuid "298d636c-df6c-580c-adce-c09a77dec64a" #edb/ref 17592186045417] [17592186125748 #edb/ref 1067 "Horizontal Asymptotes of Rational Functions" #edb/ref 17592186045417] [17592186241645 #edb/ref 1080 "-2" #edb/ref 17592186045417] [17592186241645 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186241645 #edb/ref 1083 #uuid "352e8e6d-fa19-5cbd-8e92-c4682160ca0a" #edb/ref 17592186045417] [17592186241871 #edb/ref 1080 "No horizontal asymptote" #edb/ref 17592186045417] [17592186241871 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186241871 #edb/ref 1083 #uuid "4d1c0329-a613-5272-9a63-a6e238be8953" #edb/ref 17592186045417] [17592186241990 #edb/ref 1080 "y=2" #edb/ref 17592186045417] [17592186241990 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186241990 #edb/ref 1083 #uuid "59e8cb2f-0971-535b-a035-9589c97a12c9" #edb/ref 17592186045417] [17592186242596 #edb/ref 1080 "y=\\frac{11}{2}" #edb/ref 17592186045417] [17592186242596 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186242596 #edb/ref 1083 #uuid "a1cb6b1c-61b6-5856-b1ed-04d251c29aba" #edb/ref 17592186045417] [17592186243234 #edb/ref 1080 "y=-\\frac{11}{2}" #edb/ref 17592186045417] [17592186243234 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186243234 #edb/ref 1083 #uuid "e7ef5bdd-829e-537d-83ec-bc9ecff4547a" #edb/ref 17592186045417] [17592186243665 #edb/ref 1075 #edb/ref 17592186241645 #edb/ref 17592186045417] [17592186243665 #edb/ref 1075 #edb/ref 17592186241871 #edb/ref 17592186045417] [17592186243665 #edb/ref 1075 #edb/ref 17592186241990 #edb/ref 17592186045417] [17592186243665 #edb/ref 1075 #edb/ref 17592186242596 #edb/ref 17592186045417] [17592186243665 #edb/ref 1075 #edb/ref 17592186243234 #edb/ref 17592186045417] [17592186243665 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186243665 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186243665 #edb/ref 1078 #edb/ref 17592186241871 #edb/ref 17592186045417] [17592186243665 #edb/ref 1079 #uuid "73a678c0-082f-5bd1-8bd2-7d653d132e5f" #edb/ref 17592186045417] [17592186243928 #edb/ref 1068 #edb/ref 17592186243665 #edb/ref 17592186045417] [17592186243928 #edb/ref 1069 "q-106702" #edb/ref 17592186045417] [17592186243928 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186243928 #edb/ref 1071 "Find the horizontal asymptote of $y=f(x)$ where $f(x)=\\frac{11{x}^{5}-9{x}^{6}}{2{x}^{5}-1}.$" #edb/ref 17592186045417] [17592186243928 #edb/ref 1072 #uuid "ad026744-5a39-53f7-ada7-a9cd94dba36b" #edb/ref 17592186045417] [17592186243928 #edb/ref 1074 "The horizontal asymptote is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is ${x}^{5}.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{11{x}^{5}-9{x}^{6}}{2{x}^{5}-1} \\\\  & {lim}_{x\\to \\infty }\\frac{(\\frac{11{x}^{5}}{{x}^{5}}-\\frac{9{x}^{6}}{{x}^{5}})}{(\\frac{2{x}^{5}}{{x}^{5}}-\\frac{1}{{x}^{5}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(11-9x)}{(2-\\frac{1}{{x}^{5}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{11-9x}{2-0} \\\\  & =\\frac{1}{2}{lim}_{x\\to \\infty }(11-9x) \\\\  & =-\\infty .\\end{aligned}\n$$\n\n \n\nThe limit does not come out to a finite number. Therefore, there is no horizontal asymptote." #edb/ref 17592186045417] [17592186295311 #edb/ref 1080 "\\infty " #edb/ref 17592186045417] [17592186295311 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186295311 #edb/ref 1083 #uuid "08e4bf07-38dc-56de-a3d2-ac26590ef035" #edb/ref 17592186045417] [17592186296844 #edb/ref 1075 #edb/ref 17592186295311 #edb/ref 17592186045417] [17592186296844 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186296844 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186296844 #edb/ref 1078 #edb/ref 17592186295311 #edb/ref 17592186045417] [17592186296844 #edb/ref 1079 #uuid "653c8cb4-516c-5c19-b1da-afc41d292473" #edb/ref 17592186045417] [17592186297270 #edb/ref 1068 #edb/ref 17592186296844 #edb/ref 17592186045417] [17592186297270 #edb/ref 1069 "q-302235" #edb/ref 17592186045417] [17592186297270 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186297270 #edb/ref 1071 "Evaluate the limit:\n\n${lim}_{x\\to \\infty }\\,\\,\\frac{8{x}^{6}+5}{2{x}^{5}-7x}=$\n\n{{field-1}}" #edb/ref 17592186045417] [17592186297270 #edb/ref 1072 #uuid "58972e97-803a-5a72-ad54-417f9bf3a2a1" #edb/ref 17592186045417] [17592186297270 #edb/ref 1074 "First, we divide both the numerator and the denominator by the highest power of $x$ in the denominator, which is ${x}^{5}.$ Then, by noting that the reciprocals shrink to $0$ in the limit, we can then evaluate the resulting expression.\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\,\\,\\frac{8{x}^{6}+5}{2{x}^{5}-7x} & ={lim}_{x\\to \\infty }\\,\\,\\frac{(\\frac{8{x}^{6}}{{x}^{5}}+\\frac{5}{{x}^{5}})}{(\\frac{2{x}^{5}}{{x}^{5}}-\\frac{7x}{{x}^{5}})} \\\\  & ={lim}_{x\\to \\infty }\\,\\,\\frac{(8x+\\frac{5}{{x}^{5}})}{(2-\\frac{7}{{x}^{4}})} \\\\  & =\\frac{8x+0}{2-0} \\\\  & ={lim}_{x\\to \\infty }\\,\\,4x \\\\  & =\\infty .\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186321451 #edb/ref 1080 "20" #edb/ref 17592186045417] [17592186321451 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186321451 #edb/ref 1083 #uuid "26aeb3ab-394a-5cf2-b4ac-30a122ddf731" #edb/ref 17592186045417] [17592186321547 #edb/ref 1080 "y=0" #edb/ref 17592186045417] [17592186321547 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186321547 #edb/ref 1083 #uuid "349d6fca-cfd5-5899-97f9-619f38ffc399" #edb/ref 17592186045417] [17592186321767 #edb/ref 1080 "0" #edb/ref 17592186045417] [17592186321767 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186321767 #edb/ref 1083 #uuid "4f307ef7-c3ab-5b1f-bdb1-c251f8808928" #edb/ref 17592186045417] [17592186321810 #edb/ref 1080 "No horizontal asymptote" #edb/ref 17592186045417] [17592186321810 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186321810 #edb/ref 1083 #uuid "544fe8c0-00d7-5582-9b43-a7537bdb2cd4" #edb/ref 17592186045417] [17592186322274 #edb/ref 1080 "y=-1" #edb/ref 17592186045417] [17592186322274 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186322274 #edb/ref 1083 #uuid "8d44af16-7047-5688-8bee-4018f24233a6" #edb/ref 17592186045417] [17592186322534 #edb/ref 1080 "y=1" #edb/ref 17592186045417] [17592186322534 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17