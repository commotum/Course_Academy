#{[{:db/id #edb/ref 17592186243928 :knowledge-point/_questions [{:db/id #edb/ref 17592186124664 :knowledge-point/id #uuid "bde258b7-1654-5e73-8703-0e42371db8f4" :knowledge-point/title "Identifying When a Rational Function has No Horizontal Asymptote"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "352e8e6d-fa19-5cbd-8e92-c4682160ca0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186241645} {:answer/id #uuid "4d1c0329-a613-5272-9a63-a6e238be8953" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186241871} {:answer/id #uuid "59e8cb2f-0971-535b-a035-9589c97a12c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2" :db/id #edb/ref 17592186241990} {:answer/id #uuid "a1cb6b1c-61b6-5856-b1ed-04d251c29aba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{11}{2}" :db/id #edb/ref 17592186242596} {:answer/id #uuid "e7ef5bdd-829e-537d-83ec-bc9ecff4547a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{11}{2}" :db/id #edb/ref 17592186243234}] :answer-field/correct {:answer/id #uuid "4d1c0329-a613-5272-9a63-a6e238be8953" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186241871} :answer-field/id #uuid "73a678c0-082f-5bd1-8bd2-7d653d132e5f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243665}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ad026744-5a39-53f7-ada7-a9cd94dba36b" :question/math-academy-id "q-106702" :question/problem "Find the horizontal asymptote of $y=f(x)$ where $f(x)=\\frac{11{x}^{5}-9{x}^{6}}{2{x}^{5}-1}.$" :question/worked-solution "The horizontal asymptote is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is ${x}^{5}.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{11{x}^{5}-9{x}^{6}}{2{x}^{5}-1} \\\\  & {lim}_{x\\to \\infty }\\frac{(\\frac{11{x}^{5}}{{x}^{5}}-\\frac{9{x}^{6}}{{x}^{5}})}{(\\frac{2{x}^{5}}{{x}^{5}}-\\frac{1}{{x}^{5}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(11-9x)}{(2-\\frac{1}{{x}^{5}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{11-9x}{2-0} \\\\  & =\\frac{1}{2}{lim}_{x\\to \\infty }(11-9x) \\\\  & =-\\infty .\\end{aligned}\n$$\n\n \n\nThe limit does not come out to a finite number. Therefore, there is no horizontal asymptote."}] [{:db/id #edb/ref 17592186297270 :knowledge-point/_questions [{:db/id #edb/ref 17592186124662 :knowledge-point/id #uuid "020c3de3-bcaf-5ade-ba50-2f15e344157d" :knowledge-point/title "Evaluating a Limit at Infinity: Infinite Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08e4bf07-38dc-56de-a3d2-ac26590ef035" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186295311} {:answer/id #uuid "90e243fd-b4a7-5bb3-b6f7-98ba2d532cd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty" :db/id #edb/ref 17592186546569}] :answer-field/correct {:answer/id #uuid "90e243fd-b4a7-5bb3-b6f7-98ba2d532cd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty" :db/id #edb/ref 17592186546569} :answer-field/id #uuid "653c8cb4-516c-5c19-b1da-afc41d292473" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296844}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "58972e97-803a-5a72-ad54-417f9bf3a2a1" :question/math-academy-id "q-302235" :question/problem "Evaluate the limit:\n\n${lim}_{x\\to \\infty }\\,\\,\\frac{8{x}^{6}+5}{2{x}^{5}-7x}=$\n\n{{field-1}}" :question/worked-solution "First, we divide both the numerator and the denominator by the highest power of $x$ in the denominator, which is ${x}^{5}.$ Then, by noting that the reciprocals shrink to $0$ in the limit, we can then evaluate the resulting expression.\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\,\\,\\frac{8{x}^{6}+5}{2{x}^{5}-7x} & ={lim}_{x\\to \\infty }\\,\\,\\frac{(\\frac{8{x}^{6}}{{x}^{5}}+\\frac{5}{{x}^{5}})}{(\\frac{2{x}^{5}}{{x}^{5}}-\\frac{7x}{{x}^{5}})} \\\\  & ={lim}_{x\\to \\infty }\\,\\,\\frac{(8x+\\frac{5}{{x}^{5}})}{(2-\\frac{7}{{x}^{4}})} \\\\  & =\\frac{8x+0}{2-0} \\\\  & ={lim}_{x\\to \\infty }\\,\\,4x \\\\  & =\\infty .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186546967 :knowledge-point/_questions [{:db/id #edb/ref 17592186124662 :knowledge-point/id #uuid "020c3de3-bcaf-5ade-ba50-2f15e344157d" :knowledge-point/title "Evaluating a Limit at Infinity: Infinite Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e93e7701-2e6f-5fed-a8e4-049ca8293fd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty" :db/id #edb/ref 17592186546774}] :answer-field/correct {:answer/id #uuid "e93e7701-2e6f-5fed-a8e4-049ca8293fd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty" :db/id #edb/ref 17592186546774} :answer-field/id #uuid "47f4facf-bcde-5c7b-98da-d06ed85acb33" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186546857}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1544d2ec-f693-56d4-9990-975c61a78ee3" :question/math-academy-id "q-339624" :question/problem "Evaluate the limit:\n\n${lim}_{x\\to -\\infty }\\,\\,\\frac{6{x}^{7}-3{x}^{3}-4}{2{x}^{5}+7}=$\n\n{{field-1}}" :question/worked-solution "First, we divide both the numerator and the denominator by the highest power of $x$ in the denominator, which is ${x}^{5}.$ Then, by noting that the reciprocals shrink to $0$ in the limit, we can then evaluate the resulting expression.\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }\\,\\,\\frac{6{x}^{7}-3{x}^{3}-4}{2{x}^{5}+7} & ={lim}_{x\\to -\\infty }\\,\\,\\frac{(\\frac{6{x}^{7}}{{x}^{5}}-\\frac{3{x}^{3}}{{x}^{5}}-\\frac{4}{{x}^{5}})}{(\\frac{2{x}^{5}}{{x}^{5}}+\\frac{7}{{x}^{5}})} \\\\  & ={lim}_{x\\to -\\infty }\\,\\,\\frac{(6{x}^{2}-\\frac{3}{{x}^{2}}-\\frac{4}{{x}^{3}})}{(2+\\frac{7}{{x}^{5}})} \\\\  & ={lim}_{x\\to -\\infty }\\,\\,\\frac{6{x}^{2}-0-0}{2+0} \\\\  & ={lim}_{x\\to -\\infty }3{x}^{2} \\\\  & =\\infty .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186124911 :knowledge-point/_questions [{:db/id #edb/ref 17592186124663 :knowledge-point/id #uuid "ee15db10-b92c-5f48-8983-e602068c7e08" :knowledge-point/title "Identifying the Horizontal Asymptote of a Rational Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "349d6fca-cfd5-5899-97f9-619f38ffc399" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=0" :db/id #edb/ref 17592186321547} {:answer/id #uuid "ce6ce2ac-2a25-54b2-839c-b1cc6290b561" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2" :db/id #edb/ref 17592186322759} {:answer/id #uuid "d539cb73-cc46-54a7-951a-365d9f621a83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=1" :db/id #edb/ref 17592186322807} {:answer/id #uuid "e2c15bef-666c-5440-98b0-35f3376a287f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186322920} {:answer/id #uuid "ebb9dd70-fd1d-55b4-8e19-6849ed66d65b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{2}" :db/id #edb/ref 17592186322993}] :answer-field/correct {:answer/id #uuid "349d6fca-cfd5-5899-97f9-619f38ffc399" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=0" :db/id #edb/ref 17592186321547} :answer-field/id #uuid "d568f8c0-9a4c-5bd9-a0d2-159cca6bb4c9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323591}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "24c1ddd3-5086-5a99-bc61-14c84e2545e8" :question/math-academy-id "q-35763" :question/problem "Find the horizontal asymptote of the function $f(x)=\\frac{2x+5}{2{x}^{3}+2x+6}.$" :question/worked-solution "The horizontal asymptote is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is ${x}^{3}.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{2x+5}{2{x}^{3}+2x+6} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{2x}{{x}^{3}}+\\frac{5}{{x}^{3}})}{(\\frac{2{x}^{3}}{{x}^{3}}+\\frac{2x}{{x}^{3}}+\\frac{6}{{x}^{3}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{2}{{x}^{2}}+\\frac{5}{{x}^{3}})}{(2+\\frac{2}{{x}^{2}}+\\frac{6}{{x}^{3}})} \\\\  & =\\frac{0+0}{2+0+0} \\\\  & =0.\\end{aligned}\n$$\n\n \n\nTherefore, the horizontal asymptote of $f(x)$ is $y=0.$"}] [{:db/id #edb/ref 17592186323718 :knowledge-point/_questions [{:db/id #edb/ref 17592186124663 :knowledge-point/id #uuid "ee15db10-b92c-5f48-8983-e602068c7e08" :knowledge-point/title "Identifying the Horizontal Asymptote of a Rational Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26aeb3ab-394a-5cf2-b4ac-30a122ddf731" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186321451} {:answer/id #uuid "4f307ef7-c3ab-5b1f-bdb1-c251f8808928" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186321767} {:answer/id #uuid "c8a305cd-b8da-5232-86d2-571c8fe12041" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186322705} {:answer/id #uuid "d51c13df-cd4c-5704-805a-f05ad2f42fb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186322806} {:answer/id #uuid "fc12ba27-2ab2-5738-a6cf-79ea9b4cad8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186323137}] :answer-field/correct {:answer/id #uuid "26aeb3ab-394a-5cf2-b4ac-30a122ddf731" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186321451} :answer-field/id #uuid "71452ba7-fb16-5e42-b8e8-7ec7856f919d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323396}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "bc7d38da-33e4-58e3-8444-bc9bb098458a" :question/math-academy-id "q-35829" :question/problem "Given that the horizontal asymptote of the function $f(x)=\\frac{5{x}^{2}-6}{c{x}^{2}+32x+8}$ is $y=\\frac{1}{4},$ find the value of $c.$" :question/worked-solution "The horizontal asymptote is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is ${x}^{2}.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{5{x}^{2}-6}{c{x}^{2}+32x+8} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{5{x}^{2}}{{x}^{2}}-\\frac{6}{{x}^{2}})}{(\\frac{c{x}^{2}}{{x}^{2}}+\\frac{32x}{{x}^{2}}+\\frac{8}{{x}^{2}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(5-\\frac{6}{{x}^{2}})}{(c+\\frac{32}{x}+\\frac{8}{{x}^{2}})} \\\\  & =\\frac{5-0}{c+0+0} \\\\  & =\\frac{5}{c}.\\end{aligned}\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{5}{c} & =\\frac{1}{4} \\\\ c & =20.\\end{aligned}\n$$"}]}
