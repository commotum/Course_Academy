#{[{:db/id #edb/ref 17592186272102 :knowledge-point/_questions [{:db/id #edb/ref 17592186124571 :knowledge-point/id #uuid "ef311af0-0e95-5574-a151-2971ad66bd08" :knowledge-point/title "Calculating the Eigenvalues of a 4x4 Matrix Containing a Block of Zeros"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44aa4cfa-3180-5442-8e75-ba1c05ae3cc5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\lambda -1)(\\lambda +4)(\\lambda -8)(\\lambda +5)=0" :db/id #edb/ref 17592186269895} {:answer/id #uuid "591dd63a-d199-5e93-bfbb-a40b87a92c10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\lambda -7)(\\lambda +4)(\\lambda +5)=0" :db/id #edb/ref 17592186270057} {:answer/id #uuid "6e9bd84c-c861-54af-897d-8ef317304806" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\lambda -7)(\\lambda +4)(\\lambda -3)(\\lambda -5)=0" :db/id #edb/ref 17592186270251} {:answer/id #uuid "8e737deb-7b2b-5c10-a2f1-ff581e3be55f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\lambda -7)(\\lambda +4)(\\lambda -3)(\\lambda +5)=0" :db/id #edb/ref 17592186270503} {:answer/id #uuid "fa8c69b0-ffdb-53b4-9343-e90d90da6e9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\lambda +7)(\\lambda +4)(\\lambda -3)(\\lambda -2)=0" :db/id #edb/ref 17592186271458}] :answer-field/correct {:answer/id #uuid "8e737deb-7b2b-5c10-a2f1-ff581e3be55f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\lambda -7)(\\lambda +4)(\\lambda -3)(\\lambda +5)=0" :db/id #edb/ref 17592186270503} :answer-field/id #uuid "95b21e22-4684-5abe-87a1-7e9e493eb9bd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271775}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "61624282-afa1-5aa5-87a3-f50541d7253a" :question/math-academy-id "q-140471" :question/problem "Find the characteristic equation of the matrix \n$P=[\\begin{aligned}7 & 6 & -1 & 0 \\\\ 0 & -4 & 0 & 8 \\\\ 0 & 0 & 3 & 11 \\\\ 0 & 0 & 0 & -5\\end{aligned}].$" :question/worked-solution "First, we find the matrix $\\,P-\\lambda I:$\n﻿﻿﻿\n\n$$\nP-\\lambda I=[\\begin{aligned}7-\\lambda  & 6 & -1 & 0 \\\\ 0 & -4-\\lambda  & 0 & 8 \\\\ 0 & 0 & 3-\\lambda  & 11 \\\\ 0 & 0 & 0 & -5-\\lambda \\end{aligned}]\n$$\n\nThe characteristic equation is $det(P-\\lambda I)=0.$ \n\nSince the determinant of a triangular (or diagonal) matrix is given by the product of the entries on the main diagonal, we obtain the following: \n\n$$\n\\begin{aligned}det(P-\\lambda I) & =0 \\\\ |\\begin{aligned}7-\\lambda  & 6 & -1 & 0 \\\\ 0 & -4-\\lambda  & 0 & 8 \\\\ 0 & 0 & 3-\\lambda  & 11 \\\\ 0 & 0 & 0 & -5-\\lambda \\end{aligned}| & =0 \\\\ (7-\\lambda )(-4-\\lambda )(3-\\lambda )(-5-\\lambda ) & =0 \\\\ (\\lambda -7)(\\lambda +4)(\\lambda -3)(\\lambda +5) & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186125013 :knowledge-point/_questions [{:db/id #edb/ref 17592186124523 :knowledge-point/id #uuid "5abea3ab-76a7-5598-8ede-b4cf88dd47d7" :knowledge-point/title "Finding the Eigenvalues of a General 3x3 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dc50313-1349-57e5-bd5b-c32ef21846c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{\\lambda }^{2}-2\\lambda -4=0" :db/id #edb/ref 17592186427375} {:answer/id #uuid "ba3bf449-9417-55d8-bda3-bcdf2a3abb0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }^{3}+2{\\lambda }^{2}-\\lambda -2=0" :db/id #edb/ref 17592186427378} {:answer/id #uuid "bb4847f7-518c-5520-9f7b-8f055c77b9d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }^{3}-5{\\lambda }^{2}-2\\lambda =0" :db/id #edb/ref 17592186427379} {:answer/id #uuid "c9d9c2bc-05e4-5243-ab8a-17562b551bd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }^{3}-5{\\lambda }^{2}+2\\lambda -2=0" :db/id #edb/ref 17592186427380} {:answer/id #uuid "f431214a-fe2c-58fb-acc6-9d70412cfbb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }^{3}-2\\lambda -2=0" :db/id #edb/ref 17592186427383}] :answer-field/correct {:answer/id #uuid "ba3bf449-9417-55d8-bda3-bcdf2a3abb0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }^{3}+2{\\lambda }^{2}-\\lambda -2=0" :db/id #edb/ref 17592186427378} :answer-field/id #uuid "b55f74a2-418f-5fce-b67f-29118bc0950f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122678}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f39262c6-06ce-51e6-92a2-5f2acfb813a4" :question/math-academy-id "q-36824" :question/problem "Find the characteristic equation of the matrix \n$A=[\\begin{aligned}0 & -2 & -3 \\\\ -2 & 3 & 6 \\\\ 2 & -2 & -5\\end{aligned}].$" :question/worked-solution "First, we find the matrix $\\,A-\\lambda I:$\n﻿﻿﻿\n\n$$\nA-\\lambda I=[\\begin{aligned}-\\lambda  & -2 & -3 \\\\ -2 & 3-\\lambda  & 6 \\\\ 2 & -2 & -5-\\lambda \\end{aligned}]\n$$\n\nThe characteristic equation is $det(A-\\lambda I)=0.$ \n\nExpanding the determinant across the $1$st row, we get the following:\n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ |\\begin{aligned}-\\lambda  & -2 & -3 \\\\ -2 & 3-\\lambda  & 6 \\\\ 2 & -2 & -5-\\lambda \\end{aligned}| & =0 \\\\ -\\lambda |\\begin{aligned}3-\\lambda  & 6 \\\\ -2 & -5-\\lambda \\end{aligned}|-(-2)|\\begin{aligned}-2 & 6 \\\\ 2 & -5-\\lambda \\end{aligned}|+(-3)|\\begin{aligned}-2 & 3-\\lambda  \\\\ 2 & -2\\end{aligned}| & =0 \\\\ -\\lambda ({\\lambda }^{2}+2\\lambda -3)+2(2\\lambda -2)-3(2\\lambda -2) & =0 \\\\ (-{\\lambda }^{3}-2{\\lambda }^{2}+3\\lambda )+(4\\lambda -4)-(6\\lambda -6) & =0 \\\\ -{\\lambda }^{3}-2{\\lambda }^{2}+\\lambda +2 & =0 \\\\ {\\lambda }^{3}+2{\\lambda }^{2}-\\lambda -2 & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186442271 :knowledge-point/_questions [{:db/id #edb/ref 17592186124571 :knowledge-point/id #uuid "ef311af0-0e95-5574-a151-2971ad66bd08" :knowledge-point/title "Calculating the Eigenvalues of a 4x4 Matrix Containing a Block of Zeros"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0069a32c-24a8-592d-aebc-701756d8bdcd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186442259} {:answer/id #uuid "8e52e58b-8a75-5be5-b33c-025f9395fdc7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186442264} {:answer/id #uuid "95f7c606-fabc-51e1-8528-9632cdd50f62" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186442265} {:answer/id #uuid "c80a4f86-8e3e-57b3-9a46-45e60e433bf6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186442267} {:answer/id #uuid "f29dc51e-2c92-5c6d-8ac3-24dd5e961743" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186442268}] :answer-field/correct {:answer/id #uuid "95f7c606-fabc-51e1-8528-9632cdd50f62" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186442265} :answer-field/id #uuid "24804dcb-504d-588f-82a7-fb6fe2bd5e63" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186442269}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "970b7afa-4ca1-5d4a-a4eb-b7279227d558" :question/math-academy-id "q-37356" :question/problem "$$\nB=[\\begin{aligned}-5 & 1 & 0 & -1 \\\\ 0 & 3 & 0 & -2 \\\\ 0 & 7 & -3 & 4 \\\\ 0 & 5 & 0 & -1\\end{aligned}].\n$$\n\nConsider the matrix $B$ given above. Which of the following statements are true?\n\nI. $\\lambda =-5$ is an eigenvalue of $B$\n\nII. $\\lambda =-1$ is an eigenvalue of $B$\n\nIII. The eigenvalue $\\lambda =-3$ has algebraic multiplicity $2$" :question/worked-solution "First, we find the matrix $\\,B-\\lambda I:$\n﻿﻿﻿\n\n$$\nB-\\lambda I=[\\begin{aligned}-5-\\lambda  & 1 & 0 & -1 \\\\ 0 & 3-\\lambda  & 0 & -2 \\\\ 0 & 7 & -3-\\lambda  & 4 \\\\ 0 & 5 & 0 & -1-\\lambda \\end{aligned}]\n$$\n\nThe characteristic equation is $det(B-\\lambda I)=0.$ \n\nNotice that we can expand the $4\\times 4$ determinant across the $1$st column, as follows:\n\n$$\n\\begin{aligned}det(B-\\lambda I) & =0 \\\\ |\\begin{aligned}-5-\\lambda  & 1 & 0 & -1 \\\\ 0 & 3-\\lambda  & 0 & -2 \\\\ 0 & 7 & -3-\\lambda  & 4 \\\\ 0 & 5 & 0 & -1-\\lambda \\end{aligned}| & =0 \\\\ (-5-\\lambda )|\\begin{aligned}3-\\lambda  & 0 & -2 \\\\ 7 & -3-\\lambda  & 4 \\\\ 5 & 0 & -1-\\lambda \\end{aligned}| & =0\\end{aligned}\n$$\n\nNow, expanding the $3\\times 3$ determinant across the $2$nd column, we obtain the following:\n\n$$\n\\begin{aligned}(-5-\\lambda )\\cdot (-3-\\lambda )|\\begin{aligned}3-\\lambda  & -2 \\\\ 5 & -1-\\lambda \\end{aligned}| & =0 \\\\ (-5-\\lambda )\\cdot (-3-\\lambda )((3-\\lambda )(-1-\\lambda )+10) & =0 \\\\ (\\lambda +5)(\\lambda +3)({\\lambda }^{2}-2\\lambda +7) & =0\\end{aligned}\n$$\n\nSince $D<0$ for the polynomial ${\\lambda }^{2}-2\\lambda +7$, we have that the only real eigenvalues are $\\lambda =-5$ and $\\lambda =-3$ (both with algebraic multiplicity $1$).\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186366518 :knowledge-point/_questions [{:db/id #edb/ref 17592186124523 :knowledge-point/id #uuid "5abea3ab-76a7-5598-8ede-b4cf88dd47d7" :knowledge-point/title "Finding the Eigenvalues of a General 3x3 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5fb7b1df-59af-5c98-b200-8e2db9ace225" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }^{3}-3{\\lambda }^{2}+2\\lambda -10=0" :db/id #edb/ref 17592186366520} {:answer/id #uuid "780e1a23-2b19-569c-80de-ba05aa572a33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }^{3}-4{\\lambda }^{2}+3\\lambda -6=0" :db/id #edb/ref 17592186366521} {:answer/id #uuid "1e23239c-8a66-52b7-8ebb-bb679392ff42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }^{3}+4{\\lambda }^{2}+3\\lambda +10=0" :db/id #edb/ref 17592186366522} {:answer/id #uuid "d9d592de-a8e2-59d7-af6e-a3bf5bfd67b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }^{3}-3{\\lambda }^{2}+2\\lambda -6=0" :db/id #edb/ref 17592186366523} {:answer/id #uuid "023efe6a-1a85-50a5-b630-83708ee21893" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }^{3}-4{\\lambda }^{2}+3\\lambda -10=0" :db/id #edb/ref 17592186366524}] :answer-field/correct {:answer/id #uuid "023efe6a-1a85-50a5-b630-83708ee21893" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }^{3}-4{\\lambda }^{2}+3\\lambda -10=0" :db/id #edb/ref 17592186366524} :answer-field/id #uuid "9a1a646e-8c46-51ec-bc79-a886445b9b9d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366519}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "09a3b9db-e65e-598f-9745-d20fbdbcba69" :question/math-academy-id "q-86753" :question/problem "Find the characteristic equation of the matrix \n$R=[\\begin{aligned}1 & 2 & -1 \\\\ -2 & 0 & 4 \\\\ 0 & 1 & 3\\end{aligned}].$" :question/worked-solution "First, we find the matrix $\\,R-\\lambda I:$\n﻿﻿﻿\n\n$$\nR-\\lambda I=[\\begin{aligned}1-\\lambda  & 2 & -1 \\\\ -2 & -\\lambda  & 4 \\\\ 0 & 1 & 3-\\lambda \\end{aligned}]\n$$\n\nThe characteristic equation is $det(R-\\lambda I)=0.$ \n\nExpanding the determinant across the $1$st column, we get the following:\n\n$$\n\\begin{aligned}det(R-\\lambda I) & =0 \\\\ |\\begin{aligned}1-\\lambda  & 2 & -1 \\\\ -2 & -\\lambda  & 4 \\\\ 0 & 1 & 3-\\lambda \\end{aligned}| & =0 \\\\ (1-\\lambda )|\\begin{aligned}-\\lambda  & 4 \\\\ 1 & 3-\\lambda \\end{aligned}|-(-2)|\\begin{aligned}2 & -1 \\\\ 1 & 3-\\lambda \\end{aligned}| & =0 \\\\ (1-\\lambda )({\\lambda }^{2}-3\\lambda -4)+2(-2\\lambda +7) & =0 \\\\ (-{\\lambda }^{3}+4{\\lambda }^{2}+\\lambda -4)+(-4\\lambda +14) & =0 \\\\ -{\\lambda }^{3}+4{\\lambda }^{2}-3\\lambda +10 & =0 \\\\ {\\lambda }^{3}-4{\\lambda }^{2}+3\\lambda -10 & =0\\end{aligned}\n$$"}]}
