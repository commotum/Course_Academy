#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186551431} :activity/id #uuid "539d761e-4a66-5a50-b7b6-b417f5df20a3" :activity/scope {:db/id #edb/ref 17592186049322 :topic/id #uuid "ebecad61-07fb-5ecb-9dcd-758d5fa56d82" :topic/math-academy-id 1810} :activity/steps [{:db/id #edb/ref 17592186551375 :step/content {:db/id #edb/ref 17592186348338 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "176d1602-8bf5-5374-a9e6-a11eb56ac6e7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{6}" :db/id #edb/ref 17592186345558} {:answer/id #uuid "83e40ffd-82c5-58c3-8195-51839d2315b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{6}" :db/id #edb/ref 17592186346497} {:answer/id #uuid "ad8eab09-cf42-5d1f-8fb8-df0aa5204ee7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186346865} {:answer/id #uuid "b94ca2ef-7b7e-5956-9d9f-d401dbbd3af3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186346961} {:answer/id #uuid "d59bd84a-2cfd-5ffe-8072-125a2f3ba837" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\sqrt{6}" :db/id #edb/ref 17592186347230}] :answer-field/correct {:db/id #edb/ref 17592186346497} :answer-field/id #uuid "736791d0-361f-54ac-a1c5-a82daca0b4af" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186347811}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "972f430d-f05f-5657-9e37-d9ee4828f532" :question/math-academy-id "q-80123" :question/problem "Find the shortest distance between the point $P(-4,-1,5)$ and the plane $Π$ with equation $-4x-2y+2z=16.$" :question/worked-solution "Let's start by picking a point on the plane. To do that, we simply substitute some concrete values for $x$ and $y$ into the equation and solve for $z.$ Let's choose $x=-1$ and $y=2$ (though it doesn't really matter what values we choose). Solving for $z,$ we get \n\n$$\n\\begin{aligned}-4x-2y+2z & =16 \\\\ -4(-1)-2(2)+2z & =16 \\\\ 2z & =16 \\\\ z & =8.\\end{aligned}\n$$\n\nSo, we get the point $Q(-1,2,8)$ which lies on the plane.\n\nComputing $\\overset{\\to }{PQ},$ we get\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨-1,2,8⟩-⟨-4,-1,5⟩ \\\\  & =⟨3,3,3⟩.\\end{aligned}\n$$\n\nWe also need a normal vector to the plane. For any Cartesian equation of a plane $ax+by+cz=d,$ the normal vector is $n=⟨a,b,c⟩.$ So, for the plane $Π,$ we have $n=⟨-4,-2,2⟩.$ \n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|3\\cdot (-4)+3\\cdot (-2)+3\\cdot 2|}{\\sqrt{(-4)^{2}+(-2)^{2}+{2}^{2}}} \\\\  & =\\frac{|-12-6+6|}{\\sqrt{16+4+4}} \\\\  & =\\frac{|\\,-12\\,|}{\\sqrt{24}} \\\\  & =\\sqrt{6}\\end{aligned}\n$$"} :step/id #uuid "22a4c316-56c0-5848-adb3-ad83851869be" :step/next {:db/id #edb/ref 17592186551465}} {:db/id #edb/ref 17592186551427 :step/content {:db/id #edb/ref 17592186120297 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "197bde4a-499b-599d-85d4-fececf5a4c86" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{26}}{2}" :db/id #edb/ref 17592186312157} {:answer/id #uuid "39dd64e5-e64f-52c7-a252-928ef189f344" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{26}" :db/id #edb/ref 17592186312446} {:answer/id #uuid "852ee814-04e9-5368-9076-4b3fcebb9c13" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3\\sqrt{26}}{5}" :db/id #edb/ref 17592186313046} {:answer/id #uuid "cac3a008-d07d-5f6d-820b-f9604469598b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{26}}{3}" :db/id #edb/ref 17592186313558} {:answer/id #uuid "f017a355-98b1-5291-af6b-152a8f2467c6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186313899}] :answer-field/correct {:db/id #edb/ref 17592186312446} :answer-field/id #uuid "1d1fda63-5573-5ee3-9a63-c10505b09ac7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186314085}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c2558d4d-1eea-5e1f-b2f5-44cc93092823" :question/math-academy-id "q-34075" :question/problem "Given that $Q(1,3,5)$ lies on the plane $Π:r\\cdot ⟨-4,1,-3⟩=-16$, find the shortest distance from $P(-3,7,3)$ to $Π.$" :question/worked-solution "First, we find\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨1,3,5⟩-⟨-3,7,3⟩ \\\\  & =⟨4,-4,2⟩.\\end{aligned}\n$$\n\nFrom the equation of the plane, we get the normal vector $n=⟨-4,1,-3⟩.$ \n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|4\\cdot (-4)+(-4)\\cdot 1+2\\cdot (-3)|}{\\sqrt{(-4)^{2}+{1}^{2}+(-3)^{2}}} \\\\  & =\\frac{|-16-4-6|}{\\sqrt{16+1+9}} \\\\  & =\\frac{|-26|}{\\sqrt{26}} \\\\  & =\\sqrt{26}\\end{aligned}\n$$"} :step/id #uuid "95635de5-b7cc-5b55-b41d-de111b9362f2" :step/next {:db/id #edb/ref 17592186551375}} {:db/id #edb/ref 17592186551431 :step/content {:db/id #edb/ref 17592186365883 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59951a54-81a6-5810-af8e-c4fdad49ec94" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{15}{7}" :db/id #edb/ref 17592186365885} {:answer/id #uuid "a90ec159-7db0-5edb-89ff-ff9b5943472c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{18}{7}" :db/id #edb/ref 17592186365886} {:answer/id #uuid "fb5bdcd7-37da-5f22-aead-d95e3ecf08f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{61}" :db/id #edb/ref 17592186365887} {:answer/id #uuid "c4c49b79-c479-5e32-8877-9be777b5b8ea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186365888} {:answer/id #uuid "1dacb56b-d8ef-5624-9327-cee1233132b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{23}{7}" :db/id #edb/ref 17592186365889}] :answer-field/correct {:db/id #edb/ref 17592186365885} :answer-field/id #uuid "d7ca0aa0-a220-5bdc-b0d2-65b3a735f48d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186365884}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7a0536ad-4890-5a1a-ae11-f816e5c8b4de" :question/math-academy-id "q-34073" :question/problem "Given that $Q(0,5,2)$ lies on the plane $Π:r\\cdot ⟨-6,2,3⟩=16$, find the shortest distance from $P(1,-4,5)$ to $Π.$" :question/worked-solution "First, we find\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨0,5,2⟩-⟨1,-4,5⟩ \\\\  & =⟨-1,9,-3⟩.\\end{aligned}\n$$\n\nFrom the equation of the plane, we get the normal vector $n=⟨-6,2,3⟩.$ \n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|(-1)\\cdot (-6)+9\\cdot 2+(-3)\\cdot 3|}{\\sqrt{(-6)^{2}+{2}^{2}+{3}^{2}}} \\\\  & =\\frac{|6+18-9|}{\\sqrt{36+4+9}} \\\\  & =\\frac{|15|}{\\sqrt{49}} \\\\  & =\\frac{15}{7}\\end{aligned}\n$$"} :step/id #uuid "a2aa3b79-c6a6-59a0-ad57-3c97a3628133" :step/next {:db/id #edb/ref 17592186551427}} {:db/id #edb/ref 17592186551454 :step/content {:db/id #edb/ref 17592186262956 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "396b6e30-20dc-505a-a011-b9a1c89898fe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186260387} {:answer/id #uuid "a3012ac3-d9a2-5ff4-a1ed-0eb949759b36" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186261297} {:answer/id #uuid "c2b0aa32-5925-507f-9087-7ad6312dd4d3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{30}{7}" :db/id #edb/ref 17592186261593} {:answer/id #uuid "cddd5a3e-4436-57c5-884b-22c96aa491db" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186261693} {:answer/id #uuid "ddeb2cc5-b0c3-5e7a-a0e2-5c557307f90f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186261837}] :answer-field/correct {:db/id #edb/ref 17592186261297} :answer-field/id #uuid "d5c4d58e-7136-568a-902e-1affdf5888ab" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186262494}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "04f29aba-0bc5-533b-80be-91fd747ce6a1" :question/math-academy-id "q-129158" :question/problem "Find the shortest distance between the point $P(-1,3,-4)$ and the plane $Π$ with equation $6x+2y+3z=9.$" :question/worked-solution "Let's start by picking a point on the plane. To do that, we simply substitute some concrete values for $x$ and $y$ into the equation and solve for $z.$ Let's choose $x=1$ and $y=0$ (though it doesn't really matter what values we choose). Solving for $z,$ we get \n\n$$\n\\begin{aligned}6x+2y+3z & =9 \\\\ 6(1)+2(0)+3z & =9 \\\\ 3z & =3 \\\\ z & =1.\\end{aligned}\n$$\n\nSo, we get the point $Q(1,0,1)$ which lies on the plane.\n\nComputing $\\overset{\\to }{PQ},$ we get \n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨1,0,1⟩-⟨-1,3,-4⟩ \\\\  & =⟨2,-3,5⟩.\\end{aligned}\n$$\n\nWe also need a normal vector to the plane. For any Cartesian equation of a plane $ax+by+cz=d,$ the normal vector is $n=⟨a,b,c⟩.$ So, for the plane $Π,$ we have $n=⟨6,2,3⟩.$ \n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|2\\cdot 6+(-3)\\cdot 2+5\\cdot 3|}{\\sqrt{{6}^{2}+{2}^{2}+{3}^{2}}} \\\\  & =\\frac{|12-6+15|}{\\sqrt{36+4+9}} \\\\  & =\\frac{|21|}{\\sqrt{49}} \\\\  & =\\frac{21}{7} \\\\  & =3.\\end{aligned}\n$$"} :step/id #uuid "d7e7fe84-9da4-5fb8-b4d8-3230d5d24a65"} {:db/id #edb/ref 17592186551465 :step/content {:db/id #edb/ref 17592186262945 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e9e69ab-b00a-5f83-86a8-b4708dff104a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186260136} {:answer/id #uuid "253b574b-5f0b-579f-93ef-65a2ff360ea4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186260198} {:answer/id #uuid "4a93d3f3-1c72-5baf-8f80-e4e2091cc5c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186260516} {:answer/id #uuid "ba31d7f4-c8e0-58a1-8d13-abb4b39225bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186261509} {:answer/id #uuid "e34fe396-22d3-55fc-ad47-2c6af61b5bb3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186261872}] :answer-field/correct {:db/id #edb/ref 17592186261509} :answer-field/id #uuid "ae129e17-84fe-5fe6-a754-7cfbb90c8057" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186262436}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "70fdcc6d-7515-5a08-8576-979fc8c2e25e" :question/math-academy-id "q-129119" :question/problem "Given that $Q(1,-3,7)$ lies on the plane $Π:r\\cdot ⟨6,3,-2⟩=-17$, find the shortest distance from $P(2,-6,2)$ to $Π.$" :question/worked-solution "First, we find\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨1,-3,7⟩-⟨2,-6,2⟩ \\\\  & =⟨-1,3,5⟩.\\end{aligned}\n$$\n\nFrom the equation of the plane, we get the normal vector $n=⟨6,3,-2⟩.$ \n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|(-1)\\cdot 6+3\\cdot 3+5\\cdot (-2)|}{\\sqrt{{6}^{2}+{3}^{2}+(-2)^{2}}} \\\\  & =\\frac{|-6+9-10|}{\\sqrt{36+9+4}} \\\\  & =\\frac{|-7|}{\\sqrt{49}} \\\\  & =\\frac{7}{7} \\\\  & =1.\\end{aligned}\n$$"} :step/id #uuid "f12b15ef-1bbe-5947-b51e-ebdfbe5010c6" :step/next {:db/id #edb/ref 17592186551454}}] :activity/title "The Shortest Distance Between a Plane and a Point" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186550347}]}
