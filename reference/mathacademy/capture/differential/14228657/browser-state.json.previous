td><mjx-mtd style=\"text-align: left; padding-left: 0px; padding-top: 0.4em;\"><mjx-mi class=\"mjx-n\"></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-msqrt space=\"4\"><mjx-sqrt><mjx-surd><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c221A\"></mjx-c></mjx-mo></mjx-surd><mjx-box style=\"padding-top: 0.211em;\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c32\"></mjx-c><mjx-c class=\"mjx-c36\"></mjx-c></mjx-mn></mjx-box></mjx-sqrt></mjx-msqrt><mjx-tstrut></mjx-tstrut></mjx-mtd></mjx-mtr></mjx-itable></mjx-table></mjx-mtable></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mtable displaystyle=\"true\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"0.8em 0.8em 0.8em 0.8em 0.8em 0.3em\"><mtr><mtd><mi>d</mi></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">|</mo></mrow><msub><mtext>comp</mtext><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">n</mi></mrow></mrow></msub><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mover><mrow><mi>P</mi><mi>Q</mi></mrow><mo>→</mo></mover><mo stretchy=\"false\">|</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mo stretchy=\"false\">|</mo><mover><mrow><mi>P</mi><mi>Q</mi></mrow><mo>→</mo></mover><mo>⋅</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">n</mi></mrow><mo stretchy=\"false\">|</mo></mrow><mrow><mo stretchy=\"false\">|</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">n</mi></mrow><mo stretchy=\"false\">|</mo></mrow></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mo stretchy=\"false\">|</mo><mn>4</mn><mo>⋅</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mn>4</mn><mo stretchy=\"false\">)</mo><mo>+</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mn>4</mn><mo stretchy=\"false\">)</mo><mo>⋅</mo><mn>1</mn><mo>+</mo><mn>2</mn><mo>⋅</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mn>3</mn><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">|</mo></mrow><msqrt><mo stretchy=\"false\">(</mo><mo>−</mo><mn>4</mn><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup><mo>+</mo><msup><mn>1</mn><mn>2</mn></msup><mo>+</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mn>3</mn><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup></msqrt></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mo stretchy=\"false\">|</mo><mo>−</mo><mn>16</mn><mo>−</mo><mn>4</mn><mo>−</mo><mn>6</mn><mo stretchy=\"false\">|</mo></mrow><msqrt><mn>16</mn><mo>+</mo><mn>1</mn><mo>+</mo><mn>9</mn></msqrt></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mo stretchy=\"false\">|</mo><mo>−</mo><mn>26</mn><mo stretchy=\"false\">|</mo></mrow><msqrt><mn>26</mn></msqrt></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msqrt><mn>26</mn></msqrt></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
