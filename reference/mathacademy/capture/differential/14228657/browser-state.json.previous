ta-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">n</mi></mrow></mrow></msub><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mover><mrow><mi>P</mi><mi>Q</mi></mrow><mo>→</mo></mover><mo stretchy=\"false\">|</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mo stretchy=\"false\">|</mo><mover><mrow><mi>P</mi><mi>Q</mi></mrow><mo>→</mo></mover><mo>⋅</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">n</mi></mrow><mo stretchy=\"false\">|</mo></mrow><mrow><mo stretchy=\"false\">|</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">n</mi></mrow><mo stretchy=\"false\">|</mo></mrow></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mo stretchy=\"false\">|</mo><mn>3</mn><mo>⋅</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mn>4</mn><mo stretchy=\"false\">)</mo><mo>+</mo><mn>3</mn><mo>⋅</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mn>2</mn><mo stretchy=\"false\">)</mo><mo>+</mo><mn>3</mn><mo>⋅</mo><mn>2</mn><mo stretchy=\"false\">|</mo></mrow><msqrt><mo stretchy=\"false\">(</mo><mo>−</mo><mn>4</mn><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup><mo>+</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mn>2</mn><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup><mo>+</mo><msup><mn>2</mn><mn>2</mn></msup></msqrt></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mo stretchy=\"false\">|</mo><mo>−</mo><mn>12</mn><mo>−</mo><mn>6</mn><mo>+</mo><mn>6</mn><mo stretchy=\"false\">|</mo></mrow><msqrt><mn>16</mn><mo>+</mo><mn>4</mn><mo>+</mo><mn>4</mn></msqrt></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mo stretchy=\"false\">|</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mo>−</mo><mn>12</mn><mstyle scriptlevel=\"0\"><