\"false\">)</mo><mn>2</mn></msup><mo>+</mo><mo stretchy=\"false\">(</mo><msub><mi>x</mi><mn>3</mn></msub><mo>−</mo><msub><mrow data-mjx-texclass=\"ORD\"><mstyle mathsize=\"1.44em\"><mrow data-mjx-texclass=\"ORD\"><mover><mstyle mathsize=\"1em\"><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">x</mi></mrow></mstyle><mo stretchy=\"false\">^</mo></mover></mrow></mstyle></mrow><mn>3</mn></msub><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup></msqrt></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msqrt><mo stretchy=\"false\">(</mo><mo>−</mo><mn>2</mn><mo>−</mo><mn>0</mn><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup><mo>+</mo><mo stretchy=\"false\">(</mo><mn>6</mn><mo>−</mo><mn>0</mn><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup><mo>+</mo><mo stretchy=\"false\">(</mo><mn>2</mn><mo>−</mo><mn>0</mn><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup></msqrt></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msqrt><mn>4</mn><mo>+</mo><mn>36</mn><mo>+</mo><mn>4</mn></msqrt></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msqrt><mn>44</mn></msqrt></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>2</mn><msqrt><mn>11</mn></msqrt><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container> </p>\n</div></div>",
