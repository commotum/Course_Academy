o><mo stretchy=\"false\">(</mo><msub><mi>x</mi><mn>3</mn></msub><mo>−</mo><msub><mrow data-mjx-texclass=\"ORD\"><mstyle mathsize=\"1.44em\"><mrow data-mjx-texclass=\"ORD\"><mover><mstyle mathsize=\"1em\"><mi>x</mi></mstyle><mo stretchy=\"false\">^</mo></mover></mrow></mstyle></mrow><mn>3</mn></msub><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup><mo>+</mo><mo stretchy=\"false\">(</mo><msub><mi>x</mi><mn>4</mn></msub><mo>−</mo><msub><mrow data-mjx-texclass=\"ORD\"><mstyle mathsize=\"1.44em\"><mrow data-mjx-texclass=\"ORD\"><mover><mstyle mathsize=\"1em\"><mi>x</mi></mstyle><mo stretchy=\"false\">^</mo></mover></mrow></mstyle></mrow><mn>4</mn></msub><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup></msqrt></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msqrt><mo stretchy=\"false\">(</mo><mn>0</mn><mo>−</mo><mn>1</mn><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup><mo>+</mo><mo stretchy=\"false\">(</mo><mn>0</mn><mo>−</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mn>1</mn><mo stretchy=\"false\">)</mo><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup><mo>+</mo><mo stretchy=\"false\">(</mo><mn>3</mn><mo>−</mo><mn>2</mn><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup><mo>+</mo><mo stretchy=\"false\">(</mo><mn>1</mn><mo>−</mo><mn>0</mn><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup></msqrt></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msqrt><mn>1</mn><mo>+</mo><mn>1</mn><mo>+</mo><mn>1</mn><mo>+</mo><mn>1</mn></msqrt></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msqrt><mn>4</mn></msqrt></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>2.</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
