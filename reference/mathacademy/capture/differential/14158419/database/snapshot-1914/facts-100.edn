 =A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x \\\\  & =[\\begin{aligned}4 & -3 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot {([\\begin{aligned}4 & 1 & 0 \\\\ -3 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}4 & -3 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}4 & 1 & 0 \\\\ -3 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}0 \\\\ 13 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}4 & -3 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot {[\\begin{aligned}17 & -12 \\\\ -12 & 10\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}13 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}4 & -3 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot \\frac{1}{26}[\\begin{aligned}10 & 12 \\\\ 12 & 17\\end{aligned}]\\cdot [\\begin{aligned}13 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}4 & -3 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}5 \\\\ 6\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ 5 \\\\ 6\\end{aligned}]\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186392362 #edb/ref 1075 #edb/ref 17592186392363 #edb/ref 17592186045417] [17592186392362 #edb/ref 1075 #edb/ref 17592186392364 #edb/ref 17592186045417] [17592186392362 #edb/ref 1075 #edb/ref 17592186392365 #edb/ref 17592186045417] [17592186392362 #edb/ref 1075 #edb/ref 17592186392366 #edb/ref 17592186045417] [17592186392362 #edb/ref 1075 #edb/ref 17592186392367 #edb/ref 17592186045417] [17592186392362 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186392362 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186392362 #edb/ref 1078 #edb/ref 17592186392365 #edb/ref 17592186045417] [17592186392362 #edb/ref 1079 #uuid "7ca78264-e6c8-572f-88da-a3f19c5a8e15" #edb/ref 17592186045417] [17592186392363 #edb/ref 1080 "[\\begin{aligned}5 \\\\ 5 \\\\ 2\\end{aligned}]" #edb/ref 17592186045417] [17592186392363 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186392363 #edb/ref 1083 #uuid "c77eba07-dc07-589f-8884-be6f0d03ee21" #edb/ref 17592186045417] [17592186392364 #edb/ref 1080 "[\\beg