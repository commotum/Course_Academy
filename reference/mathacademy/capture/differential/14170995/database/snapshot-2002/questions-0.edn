#{[{:db/id #edb/ref 17592186272027 :knowledge-point/_questions [{:db/id #edb/ref 17592186133786 :knowledge-point/id #uuid "1cae73a3-842e-5a1a-8774-35bba342845c" :knowledge-point/title "Finding the Orthogonal Projection of a Vector Onto a Subspace Spanned by Orthogonal Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9579ba9f-4993-5923-aa2e-30446e774e93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 \\\\ 3 \\\\ -1 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186270582} {:answer/id #uuid "ab202d02-1c51-5086-a554-d8b2bc5e1350" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 \\\\ 1 \\\\ 0 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186270797} {:answer/id #uuid "d2e8fac6-54da-5d4d-a896-efbb467aade2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3 \\\\ -1 \\\\ 2 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186271125} {:answer/id #uuid "eb77d43d-483f-5926-82a2-e0f053ddcdb0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 \\\\ -1 \\\\ 3 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186271333}] :answer-field/correct {:answer/id #uuid "9579ba9f-4993-5923-aa2e-30446e774e93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 \\\\ 3 \\\\ -1 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186270582} :answer-field/id #uuid "a2d867e0-3f81-5ffe-9afd-4d9c3ebaa53e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271804}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "053d8d52-df05-599e-8f48-3e2ea796587b" :question/math-academy-id "q-140120" :question/problem "Consider the vector $x$ and the subspace $S=\\text{Span}\\{{a}_{1},{a}_{2},{a}_{3}\\},$ where\n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ -1 \\\\ 1 \\\\ 0\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}1 \\\\ 1 \\\\ 0 \\\\ 2\\end{aligned}],\\,{a}_{3}=[\\begin{aligned}-3 \\\\ -1 \\\\ 2 \\\\ 2\\end{aligned}],\\,\\,x=[\\begin{aligned}7 \\\\ 3 \\\\ -1 \\\\ 4\\end{aligned}].\n$$\n\nFind the orthogonal projection of $x$ onto the subspace $S$ given that the set $\\{{a}_{1},{a}_{2},{a}_{3}\\}$ is orthogonal." :question/worked-solution "Since the set $\\{{a}_{1},{a}_{2},{a}_{3}\\}$ is orthogonal, the orthogonal projection of $x$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x+{\\text{proj}}_{{a}_{3}}x.\n$$\n\nSo, we first find the orthogonal projections of $x$ onto $\\text{Span}\\{{a}_{1}\\},$ $\\text{Span}\\{{a}_{2}\\},$ and $\\text{Span}\\{{a}_{3}\\}:$\n\n$$\n\\begin{aligned}{\\text{proj}}_{{a}_{1}}x & =\\frac{x\\cdot {a}_{1}}{{a}_{1}\\cdot {a}_{1}}{a}_{1}=\\frac{7\\cdot 1+3\\cdot (-1)+(-1)\\cdot 1+4\\cdot 0}{{1}^{2}+(-1)^{2}+{1}^{2}+{0}^{2}}{a}_{1}=[\\begin{aligned}1 \\\\ -1 \\\\ 1 \\\\ 0\\end{aligned}] \\\\ {\\text{proj}}_{{a}_{2}}x & =\\frac{x\\cdot {a}_{2}}{{a}_{2}\\cdot {a}_{2}}{a}_{2}=\\frac{7\\cdot 1+3\\cdot 1+(-1)\\cdot 0+4\\cdot 2}{{1}^{2}+{1}^{2}+{0}^{2}+{2}^{2}}{a}_{2}=3[\\begin{aligned}1 \\\\ 1 \\\\ 0 \\\\ 2\\end{aligned}] \\\\ {\\text{proj}}_{{a}_{3}}x & =\\frac{x\\cdot {a}_{3}}{{a}_{3}\\cdot {a}_{3}}{a}_{3}=\\frac{7\\cdot (-3)+3\\cdot (-1)+(-1)\\cdot 2+4\\cdot 2}{(-3)^{2}+(-1)^{2}+{2}^{2}+{2}^{2}}{a}_{2}=-[\\begin{aligned}-3 \\\\ -1 \\\\ 2 \\\\ 2\\end{aligned}]\\end{aligned}\n$$\n\n  \n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x+{\\text{proj}}_{{a}_{3}}x \\\\  & =[\\begin{aligned}1 \\\\ -1 \\\\ 1 \\\\ 0\\end{aligned}]+3[\\begin{aligned}1 \\\\ 1 \\\\ 0 \\\\ 2\\end{aligned}]+(-1)[\\begin{aligned}-3 \\\\ -1 \\\\ 2 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ -1 \\\\ 1 \\\\ 0\\end{aligned}]+[\\begin{aligned}3 \\\\ 3 \\\\ 0 \\\\ 6\\end{aligned}]+[\\begin{aligned}3 \\\\ 1 \\\\ -2 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}7 \\\\ 3 \\\\ -1 \\\\ 4\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186392340 :knowledge-point/_questions [{:db/id #edb/ref 17592186133842 :knowledge-point/id #uuid "acb4bd03-9b89-5775-a700-e1f3ea9fa62e" :knowledge-point/title "Finding the Orthogonal Projection of a Vector Onto a Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b3e41f35-f9a3-51af-aed3-cadc7a55cbe9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 \\\\ 5 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186392342} {:answer/id #uuid "c12aa19b-3eaf-56cc-9bcd-1fd70423d422" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 \\\\ \\frac{5}{2} \\\\ \\frac{5}{2}\\end{aligned}]" :db/id #edb/ref 17592186392343} {:answer/id #uuid "e98668e4-b7b4-5165-b775-abfba03a29a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{5}{2} \\\\ 3 \\\\ \\frac{5}{2}\\end{aligned}]" :db/id #edb/ref 17592186392344} {:answer/id #uuid "8c313108-7af6-5d44-bf88-3edd8fa13470" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ \\frac{5}{4} \\\\ \\frac{5}{4}\\end{aligned}]" :db/id #edb/ref 17592186392345} {:answer/id #uuid "79d86d3a-5442-5662-ab8e-bda1a724f157" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 \\\\ \\frac{2}{5} \\\\ \\frac{2}{5}\\end{aligned}]" :db/id #edb/ref 17592186392346}] :answer-field/correct {:answer/id #uuid "c12aa19b-3eaf-56cc-9bcd-1fd70423d422" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 \\\\ \\frac{5}{2} \\\\ \\frac{5}{2}\\end{aligned}]" :db/id #edb/ref 17592186392343} :answer-field/id #uuid "622b7cda-79c9-5c80-96ea-60d2acfa05fd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392341}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b8a18aba-5bf5-5598-9a5a-e92c825d1e00" :question/math-academy-id "q-40192" :question/problem "Consider the vector $x$ and the plane $r=sv+tw,$ where $s,t\\in R,$ and\n\n$$\nv=[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}],\\,w=[\\begin{aligned}2 \\\\ 1 \\\\ 1\\end{aligned}],\\,\\,x=[\\begin{aligned}3 \\\\ 1 \\\\ 4\\end{aligned}].\n$$\n\nFind the orthogonal projection of $x$ onto the plane given that $v⊥w.$" :question/worked-solution "Since our plane passes through the origin, it defines the subspace $S=\\text{Span}\\{v,w\\}$ in ${R}^{3}.$ \nAnd, since the set $\\{v,w\\}$ is orthogonal, the orthogonal projection of $x$ onto the subspace $S$ is given by \n\n$$\n{\\text{proj}}_{S}\\,x={\\text{proj}}_{v}\\,x+{\\text{proj}}_{w}\\,x.\n$$\n\nSo, we first find the orthogonal projections of $x$ onto $\\text{Span}\\{{a}_{1}\\}$ and $\\text{Span}\\{{a}_{2}\\}:$\n\n$$\n\\begin{aligned}{\\text{proj}}_{v}\\,x & =\\frac{x\\cdot v}{v\\cdot v}v=\\frac{3\\cdot (-1)+1\\cdot 1+4\\cdot 1}{(-1)^{2}+{1}^{2}+{1}^{2}}v=\\frac{2}{3}[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}] \\\\ {\\text{proj}}_{w}\\,x & =\\frac{x\\cdot w}{w\\cdot w}w=\\frac{3\\cdot 2+1\\cdot 1+4\\cdot 1}{{2}^{2}+{1}^{2}+{1}^{2}}w=\\frac{11}{6}[\\begin{aligned}2 \\\\ 1 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{v}\\,x+{\\text{proj}}_{w}\\,x \\\\  & =\\frac{2}{3}[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}]+\\frac{11}{6}[\\begin{aligned}2 \\\\ 1 \\\\ 1\\end{aligned}] \\\\  & =\\frac{1}{6}(4[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}]+11[\\begin{aligned}2 \\\\ 1 \\\\ 1\\end{aligned}]) \\\\  & =[\\begin{aligned}3 \\\\ \\frac{5}{2} \\\\ \\frac{5}{2}\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186134262 :knowledge-point/_questions [{:db/id #edb/ref 17592186133786 :knowledge-point/id #uuid "1cae73a3-842e-5a1a-8774-35bba342845c" :knowledge-point/title "Finding the Orthogonal Projection of a Vector Onto a Subspace Spanned by Orthogonal Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ae601ce-d869-51e6-80bc-284407e6a410" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 4 \\\\ 6 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186324067} {:answer/id #uuid "6b523d3f-6e02-5836-b2ce-6c263620bbb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 2 \\\\ 2 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186324865} {:answer/id #uuid "8617a91d-f64d-5379-8961-e1523a360528" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 \\\\ 1 \\\\ 4 \\\\ \\frac{1}{2}\\end{aligned}]" :db/id #edb/ref 17592186325107} {:answer/id #uuid "91b91370-ff8c-5ef3-a9f6-ff6553d43072" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ 3 \\\\ \\frac{1}{4} \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186325205} {:answer/id #uuid "d9ac762d-1b6e-5391-a5ea-18b12add63fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 4 \\\\ 2 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186325867}] :answer-field/correct {:answer/id #uuid "d9ac762d-1b6e-5391-a5ea-18b12add63fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 4 \\\\ 2 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186325867} :answer-field/id #uuid "0afa59ab-9a94-500b-b0cc-385510a24ddb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326238}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "27fc7f62-58d5-5ef7-b202-bc3a925043e0" :question/math-academy-id "q-40194" :question/problem "Consider the vector $x$ and the subspace $S=\\text{Span}\\{{a}_{1},{a}_{2},{a}_{3}\\},$ where\n\n$$\n{a}_{1}=[\\begin{aligned}-1 \\\\ 1 \\\\ 1 \\\\ 1\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}3 \\\\ 1 \\\\ 1 \\\\ 1\\end{aligned}],\\,{a}_{3}=[\\begin{aligned}0 \\\\ -2 \\\\ 1 \\\\ 1\\end{aligned}],\\,\\,x=[\\begin{aligned}1 \\\\ 4 \\\\ 3 \\\\ 1\\end{aligned}].\n$$\n\nFind the orthogonal projection of $x$ onto the subspace $S$ given that the set $\\{{a}_{1},{a}_{2},{a}_{3}\\}$ is orthogonal." :question/worked-solution "Since the set $\\{{a}_{1},{a}_{2},{a}_{3}\\}$ is orthogonal, the orthogonal projection of $x$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x+{\\text{proj}}_{{a}_{3}}x.\n$$\n\nSo, we first find the orthogonal projections of $x$ onto $\\text{Span}\\{{a}_{1}\\},$ $\\text{Span}\\{{a}_{2}\\},$ and $\\text{Span}\\{{a}_{3}\\}:$\n\n$$\n\\begin{aligned}{\\text{proj}}_{{a}_{1}}x & =\\frac{x\\cdot {a}_{1}}{{a}_{1}\\cdot {a}_{1}}{a}_{1}=\\frac{1\\cdot (-1)+4\\cdot 1+3\\cdot 1+1\\cdot 1}{(-1)^{2}+{1}^{2}+{1}^{2}+{1}^{2}}{a}_{1}=\\frac{7}{4}[\\begin{aligned}-1 \\\\ 1 \\\\ 1 \\\\ 1\\end{aligned}] \\\\ {\\text{proj}}_{{a}_{2}}x & =\\frac{x\\cdot {a}_{2}}{{a}_{2}\\cdot {a}_{2}}{a}_{2}=\\frac{1\\cdot 3+4\\cdot 1+3\\cdot 1+1\\cdot 1}{{3}^{2}+{1}^{2}+{1}^{2}+{1}^{2}}{a}_{2}=\\frac{11}{12}[\\begin{aligned}3 \\\\ 1 \\\\ 1 \\\\ 1\\end{aligned}] \\\\ {\\text{proj}}_{{a}_{3}}x & =\\frac{x\\cdot {a}_{3}}{{a}_{3}\\cdot {a}_{3}}{a}_{3}=\\frac{1\\cdot 0+4\\cdot (-2)+3\\cdot 1+1\\cdot 1}{{0}^{2}+(-2)^{2}+{1}^{2}+{1}^{2}}{a}_{2}=-\\frac{2}{3}[\\begin{aligned}0 \\\\ -2 \\\\ 1 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x+{\\text{proj}}_{{a}_{3}}x \\\\  & =\\frac{7}{4}[\\begin{aligned}-1 \\\\ 1 \\\\ 1 \\\\ 1\\end{aligned}]+\\frac{11}{12}[\\begin{aligned}3 \\\\ 1 \\\\ 1 \\\\ 1\\end{aligned}]-\\frac{2}{3}[\\begin{aligned}0 \\\\ -2 \\\\ 1 \\\\ 1\\end{aligned}] \\\\  & =\\frac{1}{12}(21[\\begin{aligned}-1 \\\\ 1 \\\\ 1 \\\\ 1\\end{aligned}]+11[\\begin{aligned}3 \\\\ 1 \\\\ 1 \\\\ 1\\end{aligned}]-8[\\begin{aligned}0 \\\\ -2 \\\\ 1 \\\\ 1\\end{aligned}]) \\\\  & =[\\begin{aligned}1 \\\\ 4 \\\\ 2 \\\\ 2\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186351311 :knowledge-point/_questions [{:db/id #edb/ref 17592186133786 :knowledge-point/id #uuid "1cae73a3-842e-5a1a-8774-35bba342845c" :knowledge-point/title "Finding the Orthogonal Projection of a Vector Onto a Subspace Spanned by Orthogonal Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27b82414-74c1-5544-b30e-ddd2ce021c54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 \\\\ 0 \\\\ 3 \\\\ -3\\end{aligned}]" :db/id #edb/ref 17592186348789} {:answer/id #uuid "4fd8c6cb-3a96-578f-b2a9-ef7282b4d01c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 \\\\ -1 \\\\ 0 \\\\ -12\\end{aligned}]" :db/id #edb/ref 17592186349168} {:answer/id #uuid "7eadf76b-0b7f-5519-8f83-c78f340e603e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 \\\\ 0 \\\\ -3 \\\\ -12\\end{aligned}]" :db/id #edb/ref 17592186349607} {:answer/id #uuid "d5d514c7-4c99-5779-b25c-30bbeb2dbecb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 1 \\\\ -3 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186350325} {:answer/id #uuid "e1900fb2-02e4-590c-a21d-1384d20d2199" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 0 \\\\ -1 \\\\ -12\\end{aligned}]" :db/id #edb/ref 17592186350429}] :answer-field/correct {:answer/id #uuid "7eadf76b-0b7f-5519-8f83-c78f340e603e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 \\\\ 0 \\\\ -3 \\\\ -12\\end{aligned}]" :db/id #edb/ref 17592186349607} :answer-field/id #uuid "4df8697c-19ab-5320-a7f6-eea91212521d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350840}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f5a26e7c-2fff-5f64-bdf0-4a1fa47a2fd4" :question/math-academy-id "q-81472" :question/problem "Consider the vector $x$ and the subspace $S=\\text{Span}\\{{a}_{1},{a}_{2},{a}_{3}\\},$ where\n\n$$\n{a}_{1}=[\\begin{aligned}-1 \\\\ 0 \\\\ 2 \\\\ -2\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}2 \\\\ 0 \\\\ 2 \\\\ 1\\end{aligned}],\\,{a}_{3}=[\\begin{aligned}2 \\\\ 0 \\\\ -1 \\\\ -2\\end{aligned}],\\,\\,x=[\\begin{aligned}0 \\\\ -1 \\\\ -3 \\\\ -12\\end{aligned}].\n$$\n\nFind the orthogonal projection of $x$ onto the subspace $S$ given that the set $\\{{a}_{1},{a}_{2},{a}_{3}\\}$ is orthogonal." :question/worked-solution "Since the set $\\{{a}_{1},{a}_{2},{a}_{3}\\}$ is orthogonal, the orthogonal projection of $x$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x+{\\text{proj}}_{{a}_{3}}x.\n$$\n\nSo, we first find the orthogonal projections of $x$ onto $\\text{Span}\\{{a}_{1}\\},$ $\\text{Span}\\{{a}_{2}\\},$ and $\\text{Span}\\{{a}_{3}\\}:$\n\n$$\n\\begin{aligned}{\\text{proj}}_{{a}_{1}}x & =\\frac{x\\cdot {a}_{1}}{{a}_{1}\\cdot {a}_{1}}{a}_{1}=\\frac{0\\cdot (-1)+(-1)\\cdot 0+(-3)\\cdot 2+(-12)\\cdot (-2)}{(-1)^{2}+{0}^{2}+{2}^{2}+(-2)^{2}}{a}_{1}=[\\begin{aligned}-2 \\\\ 0 \\\\ 4 \\\\ -4\\end{aligned}] \\\\ {\\text{proj}}_{{a}_{2}}x & =\\frac{x\\cdot {a}_{2}}{{a}_{2}\\cdot {a}_{2}}{a}_{2}=\\frac{0\\cdot 2+(-1)\\cdot 0+(-3)\\cdot 2+(-12)\\cdot 1}{{2}^{2}+{0}^{2}+{2}^{2}+{1}^{2}}{a}_{2}=[\\begin{aligned}-4 \\\\ 0 \\\\ -4 \\\\ -2\\end{aligned}] \\\\ {\\text{proj}}_{{a}_{3}}x & =\\frac{x\\cdot {a}_{3}}{{a}_{3}\\cdot {a}_{3}}{a}_{3}=\\frac{0\\cdot 2+(-1)\\cdot 0+(-3)\\cdot (-1)+(-12)\\cdot (-2)}{{2}^{2}+{0}^{2}+(-1)^{2}+(-2)^{2}}{a}_{2}=[\\begin{aligned}6 \\\\ 0 \\\\ -3 \\\\ -6\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x+{\\text{proj}}_{{a}_{3}}x \\\\  & =[\\begin{aligned}-2 \\\\ 0 \\\\ 4 \\\\ -4\\end{aligned}]+[\\begin{aligned}-4 \\\\ 0 \\\\ -4 \\\\ -2\\end{aligned}]+[\\begin{aligned}6 \\\\ 0 \\\\ -3 \\\\ -6\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 0 \\\\ -3 \\\\ -12\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186134521 :knowledge-point/_questions [{:db/id #edb/ref 17592186133842 :knowledge-point/id #uuid "acb4bd03-9b89-5775-a700-e1f3ea9fa62e" :knowledge-point/title "Finding the Orthogonal Projection of a Vector Onto a Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44c00e40-9e42-5c90-a6ed-b06bba2b0f1c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$\n[\\begin{aligned}2 \\\\ 10 \\\\ 12\\end{aligned}]\n$$" :db/id #edb/ref 17592186394189} {:answer/id #uuid "d3018d74-c6a7-5472-b968-ca076d6dfada" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$\n[\\begin{aligned}2 \\\\ 4 \\\\ -6\\end{aligned}]\n$$" :db/id #edb/ref 17592186394190} {:answer/id #uuid "f105f49b-5c70-5ed5-973a-919189de75f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ -4 \\\\ 12\\end{aligned}]" :db/id #edb/ref 17592186394191} {:answer/id #uuid "0de00c93-be79-5d81-9e17-d6e0e12b193c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$\n[\\begin{aligned}8 \\\\ -4 \\\\ 2\\end{aligned}]\n$$" :db/id #edb/ref 17592186394192} {:answer/id #uuid "4ee83998-becb-5e4e-b7f8-f1ca321c259b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$\n[\\begin{aligned}8 \\\\ 10 \\\\ 2\\end{aligned}]\n$$" :db/id #edb/ref 17592186394193}] :answer-field/correct {:answer/id #uuid "f105f49b-5c70-5ed5-973a-919189de75f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ -4 \\\\ 12\\end{aligned}]" :db/id #edb/ref 17592186394191} :answer-field/id #uuid "56bdb373-be42-59d0-b26d-244add5ae8da" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394188}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "03ed8717-eae6-5c45-8807-fcef562fad7a" :question/math-academy-id "q-81511" :question/problem "Consider the vector $x$ and the plane $r=sv+tw,$ where $s,t\\in R,$ and\n\n$$\nv=[\\begin{aligned}-2 \\\\ 1 \\\\ 3\\end{aligned}],\\,w=[\\begin{aligned}2 \\\\ -2 \\\\ 2\\end{aligned}],\\,\\,x=[\\begin{aligned}10 \\\\ 6 \\\\ 14\\end{aligned}].\n$$\n\nFind the orthogonal projection of $x$ onto the plane given that $v⊥w.$" :question/worked-solution "Since our plane passes through the origin, it defines the subspace $S=\\text{Span}\\{v,w\\}$ in ${R}^{3}.$ \nAnd, since the set $\\{v,w\\}$ is orthogonal, the orthogonal projection of $x$ onto the subspace $S$ is given by \n\n$$\n{\\text{proj}}_{S}\\,x={\\text{proj}}_{v}\\,x+{\\text{proj}}_{w}\\,x.\n$$\n\nSo, we first find the orthogonal projections of $x$ onto $\\text{Span}\\{{a}_{1}\\}$ and $\\text{Span}\\{{a}_{2}\\}:$\n\n$$\n\\begin{aligned}{\\text{proj}}_{v}\\,x & =\\frac{x\\cdot v}{v\\cdot v}v=\\frac{10\\cdot (-2)+6\\cdot 1+14\\cdot 3}{(-2)^{2}+{1}^{2}+{3}^{2}}v=2[\\begin{aligned}-2 \\\\ 1 \\\\ 3\\end{aligned}]=[\\begin{aligned}-4 \\\\ 2 \\\\ 6\\end{aligned}] \\\\ {\\text{proj}}_{w}\\,x & =\\frac{x\\cdot w}{w\\cdot w}w=\\frac{10\\cdot 2+6\\cdot (-2)+14\\cdot 2}{{2}^{2}+(-2)^{2}+{2}^{2}}w=3[\\begin{aligned}2 \\\\ -2 \\\\ 2\\end{aligned}]=[\\begin{aligned}6 \\\\ -6 \\\\ 6\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{v}\\,x+{\\text{proj}}_{w}\\,x \\\\  & =[\\begin{aligned}-4 \\\\ 2 \\\\ 6\\end{aligned}]+[\\begin{aligned}6 \\\\ -6 \\\\ 6\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ -4 \\\\ 12\\end{aligned}].\\end{aligned}\n$$"}]}
