2},{a}_{3}},$ where\n\n$$\n{a}_{1}=[\\begin{aligned}-1 \\\\ 1 \\\\ 1 \\\\ 1\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}3 \\\\ 1 \\\\ 1 \\\\ 1\\end{aligned}],\\,{a}_{3}=[\\begin{aligned}0 \\\\ -2 \\\\ 1 \\\\ 1\\end{aligned}],\\,\\,x=[\\begin{aligned}1 \\\\ 4 \\\\ 3 \\\\ 1\\end{aligned}].\n$$\n\nFind the orthogonal projection of $x$ onto the subspace $S$ given that the set ${{a}_{1},{a}_{2},{a}_{3}}$ is orthogonal." #edb/ref 17592186045417] [17592186134262 #edb/ref 1072 #uuid "27fc7f62-58d5-5ef7-b202-bc3a925043e0" #edb/ref 17592186045417] [17592186134262 #edb/ref 1074 "Since the set ${{a}_{1},{a}_{2},{a}_{3}}$ is orthogonal, the orthogonal projection of $x$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x+{\\text{proj}}_{{a}_{3}}x.\n$$\n\nSo, we first find the orthogonal projections of $x$ onto $\\text{Span}{{a}_{1}},$ $\\text{Span}{{a}_{2}},$ and $\\text{Span}{{a}_{3}}:$\n\n$$\n\\begin{aligned}{\\text{proj}}_{{a}_{1}}x & =\\frac{x\\cdot {a}_{1}}{{a}_{1}\\cdot {a}_{1}}{a}_{1}=\\frac{1\\cdot (-1)+4\\cdot 1+3\\cdot 1+1\\cdot 1}{(-1)^{2}+{1}^{2}+{1}^{2}+{1}^{2}}{a}_{1}=\\frac{7}{4}[\\begin{aligned}-1 \\\\ 1 \\\\ 1 \\\\ 1\\end{aligned}] \\\\ {\\text{proj}}_{{a}_{2}}x & =\\frac{x\\cdot {a}_{2}}{{a}_{2}\\cdot {a}_{2}}{a}_{2}=\\frac{1\\cdot 3+4\\cdot 1+3\\cdot 1+1\\cdot 1}{{3}^{2}+{1}^{2}+{1}^{2}+{1}^{2}}{a}_{2}=\\frac{11}{12}[\\begin{aligned}3 \\\\ 1 \\\\ 1 \\\\ 1\\end{aligned}] \\\\ {\\text{proj}}_{{a}_{3}}x & =\\frac{x\\cdot {a}_{3}}{{a}_{3}\\cdot {a}_{3}}{a}_{3}=\\frac{1\\cdot 0+4\\cdot (-2)+3\\cdot 1+1\\cdot 1}{{0}^{2}+(-2)^{2}+{1}^{2}+{1}^{2}}{a}_{2}=-\\frac{2}{3}[\\begin{aligned}0 \\\\ -2 \\\\ 1 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x+{\\text{proj}}_{{a}_{3}}x \\\\  & =\\frac{7}{4}[\\begin{aligned}-1 \\\\ 1 \\\\ 1 \\\\ 1\\end{aligned}]+\\frac{11}{12}[\\begin{aligned}3 \\\\ 1 \\\\ 1 \\\\ 1\\end{aligned}]-\\frac{2}{3}[\\begin{aligned}0 \\\\ -2 \\\\ 1 \\\\ 1\\end{aligned}] \\\\  & =\\frac{1}{12}(21[\\begin{aligned}-1 \\\\ 1 \\\\ 1 \\\\ 1\\end{aligned}]+11[\\begin{aligned}3 \\\\ 1 \\\\ 1 \\\\ 1\\end{aligned}]-8[\\begin{aligned}0 \\\\ -2 \\\\ 1 \\\\ 1\\end{aligned}]) \\\\  & =[\\begin{aligned}1 \\\\ 4 \\\\ 2 \\\\ 2\\end{aligned}].\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186134521 #edb/ref 1068 #edb/ref 17592186133164 #edb/ref 17592186045417] [17592186134521 #edb/ref 1068 #edb/ref 17592186394188 #edb/ref 17592186045417] [17592186134521 #edb/ref 1069 "q-81511" #edb/ref 17592186045417] [17592186134521 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186134521 #edb/ref 1071 "Consider the vector $x$ and the plane $r=sv+tw,$ where $s,t\\in R,$ and\n\n$$\nv=[\\begin{aligned}-2 \\\\ 1 \\\\ 3\\end{aligned}],\\,w=[\\begin{aligned}2 \\\\ -2 \\\\ 2\\end{aligned}],\\,\\,x=[\\begin{aligned}10 \\\\ 6 \\\\ 14\\end{aligned}].\n$$\n\nFind the orthogonal projection of $x$ onto the plane given that $v⊥w.$" #edb/ref 17592186045417] [17592186134521 #edb/ref 1072 #uuid "03ed8717-eae6-5c45-8807-fcef562fad7a" #edb/ref 17592186045417] [17592186134521 #edb/ref 1074 "Since our plane passes through the origin, it defines the subspace $S=\\text{Span}{v,w}$ in ${R}^{3}.$ \nAnd, since the set ${v,w}$ is orthogonal, the orthogonal projection of $x$ onto the subspace $S$ is given by \n\n$$\n{\\text{proj}}_{S}\\,x={\\text{proj}}_{v}\\,x+{\\text{proj}}_{w}\\,x.\n$$\n\nSo, we first find the orthogonal projections of $x$ onto $\\text{Span}{{a}_{1}}$ and $\\text{Span}{{a}_{2}}:$\n\n$$\n\\begin{aligned}{\\text{proj}}_{v}\\,x & =\\frac{x\\cdot v}{v\\cdot v}v=\\frac{10\\cdot (-2)+6\\cdot 1+14\\cdot 3}{(-2)^{2}+{1}^{2}+{3}^{2}}v=2[\\begin{aligned}-2 \\\\ 1 \\\\ 3\\end{aligned}]=[\\begin{aligned}-4 \\\\ 2 \\\\ 6\\end{aligned}] \\\\ {\\text{proj}}_{w}\\,x & =\\frac{x\\cdot w}{w\\cdot w}w=\\frac{10\\cdot 2+6\\cdot (-2)+14\\cdot 2}{{2}^{2}+(-2)^{2}+{2}^{2}}w=3[\\begin{aligned}2 \\\\ -2 \\\\ 2\\end{aligned}]=[\\begin{aligned}6 \\\\ -6 \\\\ 6\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{v}\\,x+{\\text{proj}}_{w}\\,x \\\\  & =[\\begin{aligned}-4 \\\\ 2 \\\\ 6\\end{aligned}]+[\\begin{aligned}6 \\\\ -6 \\\\ 6\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ -4 \\\\ 12\\end{aligned}].\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186134671 #edb/ref 1058 #edb/ref 17592186134767 #edb/ref 17592186045417] [17592186134671 #edb/ref 1061 20243 #edb/ref 17592186045417] [17592186134671 #edb/ref 1062 #uuid "3723cbb7-65e2-58df-a3bc-b3e44a4dbf6d" #edb/ref 17592186045417] [17592186134671 #edb/ref 1063 #edb/ref 17592186133786 #edb/ref 17592186045417] [17592186134672 #edb/ref 1058 #edb/ref 17592186134671 #edb/ref 17592186045417] [17592186134672 #edb/ref 1061 20244 #edb/ref 17592186045417] [17592186134672 #edb/ref 1062 #uuid "bc352e2b-a661-5eae-80e6-33a272fb3132" #edb/ref 17592186045417] [17592186134672 #edb/ref 1063 #edb/ref 17592186135048 #edb/ref 17592186045417] [17592186134673 #edb/ref 1058 #edb/ref 17592186134773 #edb/ref 17592186045417] [17592186134673 #edb/ref 1061 20245 #edb/ref 17592186045417] [17592186134673 #edb/ref 1062 #uuid "ea84ca60-824b-5c39-820b-45e1a3de351a" #edb/ref 17592186045417] [17592186134673 #edb/ref 1063 #edb/ref 17592186133787 #edb/ref 17592186045417] [17592186134767 #edb/ref 1058 #edb/ref 17592186134769 #edb/ref 17592186045417] [17592186134767 #edb/ref 1061 26414 #edb/ref 17592186045417] [17592186134767 #edb/ref 1062 #uuid "2ffcde54-4ad3-5c96-bc53-f1313d194004" #edb/ref 17592186045417] [17592186134767 #edb/ref 1063 #edb/ref 17592186133842 #edb/ref 17592186045417] [17592186134768 #edb/ref 1061 26425 #edb/ref 17592186045417] [17592186134768 #edb/ref 1062 #uuid "5dcbfead-f350-544f-a0c0-5ef1f197ee0f" #edb/ref 17592186045417] [17592186134768 #edb/ref 1063 #edb/ref 17592186135087 #edb/ref 17592186045417] [17592186134769 #edb/ref 1058 #edb/ref 17592186134673 #edb/ref 17592186045417] [17592186134769 #edb/ref 1061 26428 #edb/ref 17592186045417] [17592186134769 #edb/ref 1062 #uuid "6328b011-7457-5a1a-b13f-1e2b37822525" #edb/ref 17592186045417] [17592186134769 #edb/ref 1063 #edb/ref 17592186135088 #edb/ref 17592186045417] [17592186134773 #edb/ref 1058 #edb/ref 17592186134768 #edb/ref 17592186045417] [17592186134773 #edb/ref 1061 27054 #edb/ref 17592186045417] [17592186134773 #edb/ref 1062 #uuid "42dfcb52-37d6-5cd0-9c79-bb0c59437b69" #edb/ref 17592186045417] [17592186134773 #edb/ref 1063 #edb/ref 17592186133844 #edb/ref 17592186045417] [17592186135048 #edb/ref 1064 "If $\\big\\{ \\mathbf{a}_1, \\mathbf{a}_2 , \\ldots, \\mathbf{a}_n \\big\\}$ is a set of orthogonal vectors, then the **orthogonal projection of a vector $\\mathbf{x}$ onto the subspace $S = \\textrm{Span}\\{ \\mathbf{a}_1, \\mathbf{a}_2 , \\ldots, \\mathbf{a}_n \\}$** is given by\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x+⋯+{\\text{proj}}_{{a}_{n}}x \\\\  & =\\frac{x\\cdot {a}_{1}}{{a}_{1}\\cdot {a}_{1}}{a}_{1}+\\frac{x\\cdot {a}_{2}}{{a}_{2}\\cdot {a}_{2}}{a}_{2}+⋯+\\frac{x\\cdot {a}_{n}}{{a}_{n}\\cdot {a}_{n}}{a}_{n}.\\end{aligned}\n$$\n\nIn other words, the orthogonal projection of $\\mathbf{x}$ onto $S = \\textrm{Span}\\{ \\mathbf{a}_1, \\mathbf{a}_2 , \\ldots, \\mathbf{a}_n \\}$ is the sum of the orthogonal projections of $\\mathbf{x}$ onto each one-dimensional subspace of $\\textrm{Span}\\big\\{ \\mathbf{a}_1, \\mathbf{a}_2 , \\ldots, \\mathbf{a}_n \\big\\}.$\n\n**Watch out!** The formula works *only* when the set of vectors $\\{ \\mathbf{a}_1, \\mathbf{a}_2 , \\ldots, \\mathbf{a}_n \\}$ is orthogonal!\n\nIn case of a $2$-dimensional subspace $S=\\textrm{Span} \\big\\{ \\mathbf{a}_1,\\mathbf{a}_2 \\big\\},$ we can visualize the orthogonal projection geometrically, as follows:\n\n$$\n{\\color{blue}\\textrm{proj}_{S} \\: \\mathbf{x}} \n\t= \n\t{\\color{red}\\textrm{proj}_{\\mathbf{a}_1}\\mathbf{x}} + {\\color{red}\\textrm{proj}_{\\mathbf{a}_2}\\mathbf{x}}\n$$\n\n![](images/7d/7d27747451504c7244ddac4609c9c205c60cd525de2cfd364c20e90c1655ef4e.png)\n\n**Note:** A proof of the formula will be provided at the end of the lesson. But first, let's get some practice using the formula." #edb/ref 17592186045417] [17592186135048 #edb/ref 1065 3625 #edb/ref 17592186045417] [17592186135048 #edb/ref 1066 #uuid "52ad8222-2949-5d1f-b34c-ea06e2a98ddc" #edb/ref 17592186045417] [17592186135048 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186135087 #edb/ref 1064 "Let's now prove the formula for the orthogonal projection of a vector $\\mathbf{x}$ onto the subspaces $\\textrm{Span}\\{ \\mathbf{a}_1 \\}$ and $\\textrm{Span}\\{ \\mathbf{a}_2 \\}$ given that $\\mathbf{a}_1\\perp \\mathbf{a}_2.$ \n\nWe start by writing $\\mathbf{x}$ as a sum of two vectors\n\n$$\n\\mathbf{x} = \\mathbf{x}_S + \\mathbf{x}_{S^\\perp},\n$$\n\nwhere $\\mathbf{x}_S=\\text{proj}_S\\,\\mathbf{x}$ is in $\\textrm{Span}\\{\\mathbf{a}_1,\\mathbf{a}_2\\},$ and $\\mathbf{x}_{S^\\perp}$ is in the orthogonal complement of $\\textrm{Span}\\{\\mathbf{a}_1,\\mathbf{a}_2\\}$. That is, $\\mathbf{x}_S=k_1\\mathbf{a}_1+k_2\\mathbf{a}_2\\in S\\,$ and $\\mathbf{x}_{S^\\perp} \\in S^\\perp.$\n\nFrom the equation above, we get\n\n$$\n\\begin{aligned}{x}_{{S}^{⊥}} & =x-{x}_{S} \\\\  & =x-({k}_{1}{a}_{1}+{k}_{2}{a}_{2}) \\\\  & =x-{k}_{1}{a}_{1}-{k}_{2}{a}_{2}.\\end{aligned}\n$$\n\nNow, using the fact that $\\mathbf{x}_{S^\\perp}$ is orthogonal to $S,$ and the fact that $\\mathbf{a}_1\\cdot\\mathbf{a}_2=0,$ we obtain\n\n$$\n\\begin{aligned}\\{\\begin{aligned}{x}_{{S}^{⊥}}\\cdot {a}_{1}=0 \\\\ {x}_{{S}^{⊥}}\\cdot {a}_{2}=0\\end{aligned} & \\,\\,\\,⟹\\,\\,\\,\\{\\begin{aligned}(x-{k}_{1}{a}_{1}-{k}_{2}{a}_{2})\\cdot {a}_{1}=0 \\\\ (x-{k}_{1}{a}_{1}-{k}_{2}{a}_{2})\\cdot {a}_{2}=0\\end{aligned} \\\\  & \\,\\,\\,⟹\\,\\,\\,\\{\\begin{aligned}x\\cdot {a}_{1}-{k}_{1}({a}_{1}\\cdot {a}_{1})-{k}_{2}({a}_{2}\\cdot {a}_{1})=0 \\\\ x\\cdot {a}_{2}-{k}_{1}({a}_{1}\\cdot {a}_{2})-{k}_{2}({a}_{2}\\cdot {a}_{2})=0\\end{aligned} \\\\  & \\,\\,\\,⟹\\,\\,\\,\\{\\begin{aligned}{k}_{1}({a}_{1}\\cdot {a}_{1})=x\\cdot {a}_{1} \\\\ {k}_{2}({a}_{2}\\cdot {a}_{2})=x\\cdot {a}_{2}\\end{aligned} \\\\  & \\,\\,\\,⟹\\,\\,\\,\\{\\begin{aligned}{k}_{1}=\\frac{x\\cdot {a}_{1}}{{a}_{1}\\cdot {a}_{1}} \\\\ {k}_{2}=\\frac{x\\cdot {a}_{2}}{{a}_{2}\\cdot {a}_{2}}.\\end{aligned}\\end{aligned}\n$$\n\nAs a result, we obtain our formula \n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={k}_{1}{a}_{1}+{k}_{2}{a}_{2} \\\\  & =\\frac{x\\cdot {a}_{1}}{{a}_{1}\\cdot {a}_{1}}{a}_{1}+\\frac{x\\cdot {a}_{2}}{{a}_{2}\\cdot {a}_{2}}{a}_{2} \\\\  & ={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186135087 #edb/ref 1065 4345 #edb/ref 17592186045417] [17592186135087 #edb/ref 1066 #uuid "adabdbc0-f726-5b67-81e5-73ef172ea7cf" #edb/ref 17592186045417] [17592186135087 #edb/ref 1067 "Justification of the Formula" #edb/ref 17592186045417] [17592186135088 #edb/ref 1064 "Let $n,m$ be positive integers such that $n\\leq m.$ Given an orthogonal set $\\big\\{ \\mathbf{a}_1, \\mathbf{a}_2 , \\ldots, \\mathbf{a}_n \\big\\} \\subset  \\Bbb R^m$ and a vector $\\mathbf x \\in \\Bbb R^m,$ we define the **distance between the vector $\\mathbf{x}$ and the vector space $S=\\textrm{Span}\\{ \\mathbf{a}_1,\\mathbf{a}_2,  \\ldots, \\mathbf{a}_n \\}$** as\n\n$$\n\\Vert{ \\color{purple} \\mathbf{x} - \\text{proj}_{S}\\,\\mathbf{x} }\\Vert.\n$$\n\nWe can also define the **angle between the vector $\\mathbf{x}$ and the subspace $S$** to be the acute angle $\\theta$ between the vector $\\mathbf{x}$ and its orthogonal projection $\\text{proj}_{S}\\,\\mathbf{x},$ as shown in the diagram below.\n\n![](images/07/07fa0d011bbfd49f89ddc5035a27839640a0c2624046d39fbfe8f57c476b5b25.png)\n\n \n\nFinally, notice that we can represent the vector $\\mathbf{x}$ as a sum of two orthogonal vectors:\n\n$$\n\\mathbf{x} = \\underbrace{\\textrm{proj}_{S}\\mathbf{x}}_{\\large \\in S} + \\underbrace{(\\mathbf{x}-\\textrm{proj}_{S}\\mathbf{x})}_{\\large \\in S^\\perp}\n$$\n\n \n\n**Note:** The vector $\\textbf{x}-\\textrm{proj}_{S}\\,\\mathbf{x},$ whose norm $\\| \\textbf{x}-\\textrm{proj}_{S}\\,\\mathbf{x} \\|$ represents the distance from $\\mathbf{x}$ to $S,$ is sometimes called the **vector rejection of $\\mathbf{x}$ from $S.$**" #edb/ref 17592186045417] [17592186135088 #edb/ref 1065 4346 #edb/ref 17592186045417] [17592186135088 #edb/ref 1066 #uuid "0c1861f6-1be0-5e7e-88be-6186634715ef" #edb/ref 17592186045417] [17592186135088 #edb/ref 1067 "The Distance Between a Vector and a Subspace" #edb/ref 17592186045417] [17592186270582 #edb/ref 1080 "[\\begin{aligned}7 \\\\ 3 \\\\ -1 \\\\ 4\\end{aligned}]" #edb/ref 17592186045417] [17592186270582 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186270582 #edb/ref 1083 #uuid "9579ba9f-4993-5923-aa2e-30446e774e93" #edb/ref 17592186045417] [17592186270797 #edb/ref 1080 "[\\begin{aligned}-1 \\\\ 1 \\\\ 0 \\\\ 2\\end{aligned}]" #edb/ref 17592186045417] [17592186270797 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186270797 #edb/ref 1083 #uuid "ab202d02-1c51-5086-a554-d8b2bc5e1350" #edb/ref 17592186045417] [17592186271125 #edb/ref 1080 "[\\begin{aligned}-3 \\\\ -1 \\\\ 2 \\\\ 2\\end{aligned}]" #edb/ref 17592186045417] [17592186271125 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186271125 #edb/ref 1083 #uuid "d2e8fac6-54da-5d4d-a896-efbb467aade2" #edb/ref 17592186045417] [17592186271333 #edb/ref 1080 "[\\begin{aligned}-1 \\\\ -1 \\\\ 3 \\\\ 2\\end{aligned}]" #edb/ref 17592186045417] [17592186271333 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186271333 #edb/ref 1083 #uuid "eb77d43d-483f-5926-82a2-e0f053ddcdb0" #edb/ref 17592186045417] [17592186271804 #edb/ref 1075 #edb/ref 17592186270582 #edb/ref 17592186045417] [17592186271804 #edb/ref 1075 #edb/ref 17592186270797 #edb/ref 17592186045417] [17592186271804 #edb/ref 1075 #edb/ref 17592186271125 #edb/ref 17592186045417] [17592186271804 #edb/ref 1075 #edb/ref 17592186271333 #edb/ref 17592186045417] [17592186271804 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186271804 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186271804 #edb/ref 1078 #edb/ref 17592186270582 #edb/ref 17592186045417] [17592186271804 #edb/ref 1079 #uuid "a2d867e0-3f81-5ffe-9afd-4d9c3ebaa53e" #edb/ref 17592186045417] [17592186272027 #edb/ref 1068 #edb/ref 17592186271804 #edb/ref 17592186045417] [17592186272027 #edb/ref 1069 "q-140120" #edb/ref 17592186045417] [17592186272027 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186272027 #edb/ref 1071 "Consider the vector $x$ and the subspace $S=\\text{Span}{{a}_{1},{a}_{2},{a}_{3}},$ where\n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ -1 \\\\ 1 \\\\ 0\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}1 \\\\ 1 \\\\ 0 \\\\ 2\\end{aligned}],\\,{a}_{3}=[\\begin{aligned}-3 \\\\ -1 \\\\ 2 \\\\ 2\\end{aligned}],\\,\\,x=[\\begin{aligned}7 \\\\ 3 \\\\ -1 \\\\ 4\\end{aligned}].\n$$\n\nFind the orthogonal projection of $x$ onto the subspace $S$ given that the set ${{a}_{1},{a}_{2},{a}_{3}}$ is orthogonal." #edb/ref 17592186045417] [17592186272027 #edb/ref 1072 #uuid "053d8d52-df05-599e-8f48-3e2ea796587b" #edb/ref 17592186045417] [17592186272027 #edb/ref 1074 "Since the set ${{a}_{1},{a}_{2},{a}_{3}}$ is orthogonal, the orthogonal projection of $x$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x+{\\text{proj}}_{{a}_{3}}x.\n$$\n\nSo, we first find the orthogonal projections of $x$ onto $\\text{Span}{{a}_{1}},$ $\\text{Span}{{a}_{2}},$ and $\\text{Span}{{a}_{3}}:$\n\n$$\n\\begin{aligned}{\\text{proj}}_{{a}_{1}}x & =\\frac{x\\cdot {a}_{1}}{{a}_{1}\\cdot {a}_{1}}{a}_{1}=\\frac{7\\cdot 1+3\\cdot (-1)+(-1)\\cdot 1+4\\cdot 0}{{1}^{2}+(-1)^{2}+{1}^{2}+{0}^{2}}{a}_{1}=[\\begin{aligned}1 \\\\ -1 \\\\ 1 \\\\ 0\\end{aligned}] \\\\ {\\text{proj}}_{{a}_{2}}x & =\\frac{x\\cdot {a}_{2}}{{a}_{2}\\cdot {a}_{2}}{a}_{2}=\\frac{7\\cdot 1+3\\cdot 1+(-1)\\cdot 0+4\\cdot 2}{{1}^{2}+{1}^{2}+{0}^{2}+{2}^{2}}{a}_{2}=3[\\begin{aligned}1 \\\\ 1 \\\\ 0 \\\\ 2\\end{aligned}] \\\\ {\\text{proj}}_{{a}_{3}}x & =\\frac{x\\cdot {a}_{3}}{{a}_{3}\\cdot {a}_{3}}{a}_{3}=\\frac{7\\cdot (-3)+3\\cdot (-1)+(-1)\\cdot 2+4\\cdot 2}{(-3)^{2}+(-1)^{2}+{2}^{2}+{2}^{2}}{a}_{2}=-[\\begin{aligned}-3 \\\\ -1 \\\\ 2 \\\\ 2\\end{aligned}]\\end{aligned}\n$$\n\n  \n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x+{\\text{proj}}_{{a}_{3}}x \\\\  & =[\\begin{aligned}1 \\\\ -1 \\\\ 1 \\\\ 0\\end{aligned}]+3[\\begin{aligned}1 \\\\ 1 \\\\ 0 \\\\ 2\\end{aligned}]+(-1)[\\begin{aligned}-3 \\\\ -1 \\\\ 2 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ -1 \\\\ 1 \\\\ 0\\end{aligned}]+[\\begin{aligned}3 \\\\ 3 \\\\ 0 \\\\ 6\\end{aligned}]+[\\begin{aligned}3 \\\\ 1 \\\\ -2 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}7 \\\\ 3 \\\\ -1 \\\\ 4\\end{aligned}].\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186323990 #edb/ref 1080 "[\\begin{aligned}4 \\\\ 2 \\\\ 2\\end{aligned}]" #edb/ref 17592186045417] [17592186323990 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186323990 #edb/ref 1083 #uuid "0212ab39-d874-5d7c-ad86-c2241618470a" #edb/ref 17592186045417] [17592186324006 #edb/ref 1080 "[\\begin{aligned}20 \\\\ 20 \\\\ 0\\end{aligned}]" #edb/ref 17592186045417] [17592186324006 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186324006 #edb/ref 1083 #uuid "0368bac0-984e-5787-80ab-57f2797279e0" #edb/ref 17592186045417] [17592186324067 #edb/ref 1080 "[\\begin{aligned}1 \\\\ 4 \\\\ 6 \\\\ 2\\end{aligned}]" #edb/ref 17592186045417] [17592186324067 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186324067 #edb/ref 1083 #uuid "0ae601ce-