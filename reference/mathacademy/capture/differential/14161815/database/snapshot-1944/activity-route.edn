id #uuid "3372a2b1-d89c-5ea5-ae2d-dc597ba5d5b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{15\\sqrt{\\pi }}{7}" :db/id #edb/ref 17592186486704} {:answer/id #uuid "580968ec-8d67-5eee-8ed5-dc153c668ede" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{17\\pi }{6}" :db/id #edb/ref 17592186486787} {:answer/id #uuid "636f9395-da30-5934-b0e7-87be6c2499c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{17\\sqrt{\\pi }}{4}" :db/id #edb/ref 17592186486812} {:answer/id #uuid "93cccf53-80db-5897-ab51-a8e524781991" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{15\\pi }{8}" :db/id #edb/ref 17592186486919} {:answer/id #uuid "fa8079d4-cfe9-5db0-8ed9-f1196344fbb6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{17\\pi }{8}" :db/id #edb/ref 17592186487130}] :answer-field/correct {:db/id #edb/ref 17592186486919} :answer-field/id #uuid "6aa87497-13d4-5b82-adae-cac5f16dbe31" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186487195}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "dcd3058f-0b72-5c3c-b3c8-705d9f7da27d" :question/math-academy-id "q-107857" :question/problem "Evaluate $\\sqrt{\\pi }\\,Γ(\\frac{7}{2}).$" :question/worked-solution "To evaluate the gamma function at multiples of one-half, we use the following recursive formula:\n\n$$\nΓ(z+1)=zΓ(z),\\,Γ(\\frac{1}{2})=\\sqrt{\\pi }\n$$\n\nSo, we have the following:\n\n$$\n\\begin{aligned}\\sqrt{\\pi }\\,Γ(\\frac{7}{2}) & =\\sqrt{\\pi }\\cdot \\frac{5}{2}Γ(\\frac{5}{2}) \\\\  & =\\sqrt{\\pi }\\cdot \\frac{5}{2}\\cdot \\frac{3}{2}Γ(\\frac{3}{2}) \\\\  & =\\sqrt{\\pi }\\cdot \\frac{5}{2}\\cdot \\frac{3}{2}\\cdot \\frac{1}{2}Γ(\\frac{1}{2}) \\\\  & =\\sqrt{\\pi }\\cdot \\frac{5}{2}\\cdot \\frac{3}{2}\\cdot \\frac{1}{2}\\sqrt{\\pi } \\\\  & =\\frac{15\\pi }{8}\\end{aligned}\n$$"} :step/id #uuid "32dda758-1c10-5e03-9107-ca2708d04732" :step/next {:db/id #edb/ref 17592186487456}} {:db/id #edb/ref 17592186487438 :step/content {:db/id #edb/ref 17592186487293 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00754836-f0cd-50e5-aa02-7d189b80edae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{\\pi }" :db/id #edb/ref 17592186486596} {:answer/id #uuid "6bc959a4-5056-5435-b552-7ae39524df65" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6\\sqrt{\\pi }" :db/id #edb/ref 17592186486827} {:answer/id #uuid "731dc778-4a1e-5474-afe6-d3d089ddf682" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\sqrt{\\pi }" :db/id #edb/ref 17592186486843} {:answer/id #uuid "7d43dd58-4629-52b1-8528-64bea432b08f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\sqrt{\\pi }" :db/id #edb/ref 17592186486866} {:answer/id #uuid "c7ee9600-62e5-57c5-a87c-047a37f4904a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8\\sqrt{\\pi }" :db/id #edb/ref 17592186487037}] :answer-field/correct {:db/id #edb/ref 17592186486596} :answer-field/id #uuid "68ee2d15-0779-5b6d-a0a3-58d2b6c1ee1b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186487191}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1397b57e-0338-5e52-920b-2086a4adac56" :question/math-academy-id "q-107861" :question/problem "$2\\,Γ(\\frac{5}{2})+Γ(\\frac{3}{2})=$" :question/worked-solution "To evaluate the gamma function at multiples of one-half, we use the following recursive formula:\n\n$$\nΓ(z+1)=zΓ(z),\\,Γ(\\frac{1}{2})=\\sqrt{\\pi }\n$$\n\nSo, we have the following:\n\n$$\nΓ(\\frac{3}{2})=\\frac{1}{2}Γ(\\frac{1}{2})=\\frac{1}{2}\\sqrt{\\pi },\n$$\n\n$$\n\\begin{aligned}Γ(\\frac{5}{2})=\\frac{3}{2}Γ(\\frac{3}{2})=\\frac{3}{2}\\cdot \\frac{1}{2}\\sqrt{\\pi }=\\frac{3}{4}\\sqrt{\\pi }\\end{aligned}\n$$\n\nTherefore,\n\n$$\n2\\,Γ(\\frac{5}{2})+Γ(\\frac{3}{2})=2\\cdot \\frac{3}{4}\\sqrt{\\pi }+\\frac{1}{2}\\sqrt{\\pi }=2\\sqrt{\\pi }.\n$$"} :step/id #uuid "c203f272-1a4b-54ae-b93f-7712948cad73"} {:db/id #edb/ref 17592186487440 :step/content {:db/id #edb/ref 17592186487302 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "206fa060-e5b7-5b92-9899-8411d25fd4d2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\,040" :db/id #edb/ref 17592186486659} {:answer/id #uuid "98d40466-0fee-5000-9a4e-74165fc45aba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "720" :db/id #edb/ref 17592186486940} {:answer/id #uuid "9ff974d8-7678-510e-a50c-d042422993ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "40\\,320" :db/id #edb/ref 17592186486956} {:answer/id #uuid "c305fd9c-6218-528d-9a5f-49bc8d25aa53" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10\\,080" :db/id #edb/ref 17592186487025} {:answer/id #uuid "e98f9aaf-ae44-57d2-b3aa-a7763efa9ced" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "120" :db/id #edb/ref 17592186487093}] :answer-field/correct {:db/id #edb/ref 17592186486659} :answer-field/id #uuid "22c5e926-ac1f-5f05-944d-e1b4e4b09520" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186487149}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1f98d6c6-9c7c-5432-abf6-c7066e09f238" :question/math-academy-id "q-107851" :question/problem "Evaluate $Γ(8).$" :question/worked-solution "For any natural number $n\\ge 1,$ we have\n\n$$\nΓ(n)=(n-1)!.\n$$\n\nTherefore, \n\n$$\nΓ(8)=7!=5\\,040.\n$$"} :step/id #uuid "cb0e3217-8975-5e32-8519-6af77622bccf" :step/next {:db/id #edb/ref 17592186487416}} {:db/id #edb/ref 17592186487456 :step/content {:db/id #edb/ref 17592186487391 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0998b024-6768-582f-945a-d5609ee9f1a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186486614} {:answer/id #uuid "2cb28415-d03e-5dc3-8cb7-b89810a39b9f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186486680} {:answer/id #uuid "8908fc27-a7eb-5475-8abd-39bad6c188d9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{10}{\\sqrt{\\pi }}" :db/id #edb/ref 17592186486891} {:answer/id #uuid "961cc474-dd53-5341-baee-0b7c843c8e47" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\pi " :db/id #edb/ref 17592186486927} {:answer/id #uuid "f0a2c475-4407-520d-aa2c-30700dd13b24" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\pi " :db/id #edb/ref 17592186487109}] :answer-field/correct {:db/id #edb/ref 17592186486680} :answer-field/id #uuid "58b55a76-73d7-558c-b98f-2fa3e367ce2b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186487179}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "df3869ef-efb9-5577-906d-3eff34aa9ab8" :question/math-academy-id "q-107859" :question/problem "Evaluate $\\frac{4}{\\sqrt{\\pi }}Γ(\\frac{5}{2}).$" :question/worked-solution "To evaluate the gamma function at multiples of one-half, we use the following recursive formula:\n\n$$\nΓ(z+1)=zΓ(z),\\,Γ(\\frac{1}{2})=\\sqrt{\\pi }\n$$\n\nSo, we have the following:\n\n$$\n\\begin{aligned}\\frac{4}{\\sqrt{\\pi }}Γ(\\frac{5}{2}) & =\\frac{4}{\\sqrt{\\pi }}\\cdot \\frac{3}{2}Γ(\\frac{3}{2}) \\\\  & =\\frac{4}{\\sqrt{\\pi }}\\cdot \\frac{3}{2}\\cdot \\frac{1}{2}\\cdot Γ(\\frac{1}{2}) \\\\  & =3\\end{aligned}\n$$"} :step/id #uuid "fd8c07fe-0842-5d46-b2b5-014a37a09eba" :step/next {:db/id #edb/ref 17592186487438}}] :activity/title "The Gamma Function" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186486586}]}
