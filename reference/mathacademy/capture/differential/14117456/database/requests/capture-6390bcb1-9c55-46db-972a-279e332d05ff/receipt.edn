74 17592186045417 true] [17592186416977 1075 #edb/ref 17592186416959 13194139534274 17592186045417 true] [17592186416977 1075 #edb/ref 17592186416961 13194139534274 17592186045417 true] [17592186416977 1075 #edb/ref 17592186416972 13194139534274 17592186045417 true] [17592186416977 1076 #edb/ref 17592186045493 13194139534274 17592186045417 true] [17592186416977 1077 "selection" 13194139534274 17592186045417 true] [17592186416977 1078 #edb/ref 17592186416954 13194139534274 17592186045417 true] [17592186416977 1079 #uuid "f521befc-49de-525d-bb6c-09034e61c454" 13194139534274 17592186045417 true] [17592186416978 1075 #edb/ref 17592186416956 13194139534274 17592186045417 true] [17592186416978 1075 #edb/ref 17592186416962 13194139534274 17592186045417 true] [17592186416978 1075 #edb/ref 17592186416963 13194139534274 17592186045417 true] [17592186416978 1075 #edb/ref 17592186416964 13194139534274 17592186045417 true] [17592186416978 1075 #edb/ref 17592186416969 13194139534274 17592186045417 true] [17592186416978 1076 #edb/ref 17592186045493 13194139534274 17592186045417 true] [17592186416978 1077 "selection" 13194139534274 17592186045417 true] [17592186416978 1078 #edb/ref 17592186416956 13194139534274 17592186045417 true] [17592186416978 1079 #uuid "f680b101-94a2-558f-9708-756d2ba22da2" 13194139534274 17592186045417 true] [17592186416979 1068 #edb/ref 17592186416973 13194139534274 17592186045417 true] [17592186416979 1068 #edb/ref 17592186416976 13194139534274 17592186045417 true] [17592186416979 1069 "q-350412" 13194139534274 17592186045417 true] [17592186416979 1070 #edb/ref 17592186045487 13194139534274 17592186045417 true] [17592186416979 1071 "$$\nA=[\\begin{aligned}0 & 2 \\\\ 6 & -6\\end{aligned}],\\,B=[\\begin{aligned}1 & -1 \\\\ 1 & 0\\end{aligned}],\\,y=[\\begin{aligned}4 \\\\ 1\\end{aligned}].\n$$\n\nGiven the matrices above, write the following expression as a Hadamard product. Here $(\\,\\cdot \\,)$ denotes matrix multiplication.\n\n| $(AB)\\cdot (By)=\\,\\,$ |  | {{field-1}} |  | $⊙$ |  | {{field-2}} |  |  |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n|  | $-6$ |  |  | $4$ |  |  |  |  |" 13194139534274 17592186045417 true] [17592186416979 1072 #uuid "0f56bf75-c034-5aab-87bb-3f506f067872" 13194139534274 17592186045417 true] [17592186416979 1074 "The Hadamard product of two compatible vectors $u$ and $v$ can be expressed as the matrix product\n\n$$\nv⊙u=\\text{diag}(v)u.\n$$\n\nIn our case, we have\n\n$$\nAB=[\\begin{aligned}0 & 2 \\\\ 6 & -6\\end{aligned}][\\begin{aligned}1 & -1 \\\\ 1 & 0\\end{aligned}]=[\\begin{aligned}2 & 0 \\\\ 0 & -6\\end{aligned}]\n$$\n\nand\n\n$$\nBy=[\\begin{aligned}1 & -1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}4 \\\\ 1\\end{aligned}]=[\\begin{aligned}3 \\\\ 4\\end{aligned}].\n$$\n\nHence, \n\n$$\n\\begin{aligned}(AB)\\cdot (By) & =[\\begin{aligned}2 & 0 \\\\ 0 & -6\\end{aligned}][\\begin{aligned}3 \\\\ 4\\end{aligned}] \\\\  & =\\text{diag}([\\begin{aligned}2 \\\\ -6\\end{aligned}])[\\begin{aligned}3 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ -6\\end{aligned}]⊙[\\begin{aligned}3 \\\\ 4\\end{aligned}]\\end{aligned}\n$$" 13194139534274 17592186045417 true] [17592186416980 1068 #edb/ref 17592186416975 13194139534274 17592186045417 true] [17592186416980 1069 "q-350504" 13194139534274 17592186045417 true] [17592186416980 1070 #edb/ref 17592186045487 13194139534274 17592186045417 true] [17592186416980 1071 "Given that\n\n$$\nA⊙B=[\\begin{aligned}-4 & 2 \\\\ 3 & -1\\end{aligned}]\\,A⊙C=[\\begin{aligned}5 & 0 \\\\ -2 & 4\\end{aligned}]\\,\\text{and}\\,C=[\\begin{aligned}-1 & 3 \\\\ 2 & -2\\end{aligned}]\n$$\n\nfind $A⊙(B+C)+A⊙(B⊙C).$" 13194139534274 17592186045417 true] [17592186416980 1072 #uuid "68db0f47-da70-5824-b3d3-6f9cad326490" 13194139534274 17592186045417 true] [17592186416980 1074 "For compatible matrices $A,$ $B,$ and $C,$ and scalar $\\alpha ,$ the Hadamard product has the following properties:\n\n- Commutativity:\n\n$$\nA⊙B=B⊙A\n$$\n\n- Associativity:\n\n$$\n(A⊙B)⊙C=A⊙(B⊙C)\n$$\n\n- Distributivity over Addition:\n\n$$\nA⊙(B+C)=A⊙B+A⊙C\n$$\n\n- Scalar Distributivity:\n\n$$\n\\alpha (A⊙B)=(\\alpha A)⊙B=A⊙(\\alpha B)\n$$\n\nIn this case, by the associativity and distributivity over addition of the Hadamard product, we have\n\n$$\n\\begin{aligned}A⊙(B+C)+A⊙(B⊙C) & =A⊙B+A⊙C+(A⊙B)⊙C \\\\  & =[\\begin{aligned}-4 & 2 \\\\ 3 & -1\\end{aligned}]+[\\begin{aligned}5 & 0 \\\\ -2 & 4\\end{aligned}]+[\\begin{aligned}-4 & 2 \\\\ 3 & -1\\end{aligned}]⊙[\\begin{aligned}-1 & 3 \\\\ 2 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 2 \\\\ 1 & 3\\end{aligned}]+[\\begin{aligned}4 & 6 \\\\ 6 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}1+4 & 2+6 \\\\ 1+6 & 3+2\\end{aligned}] \\\\  & =[\\begin{aligned}5 & 8 \\\\ 7 & 5\\end{aligned}].\\end{aligned}\n$$" 13194139534274 17592186045417 true] [17592186416981 1068 #edb/ref 17592186416977 13194139534274 17592186045417 true] [17592186416981 1069 "q-350493" 13194139534274 17592186045417 true] [17592186416981 1070 #edb/ref 17592186045485 13194139534274 17592186045417 true] [17592186416981 1071 "Given that\n\n$$\nA⊙B=[\\begin{aligned}-1 & 4 \\\\ 3 & -2\\end{aligned}]\\,\\text{and}\\,A⊙C=[\\begin{aligned}5 & -3 \\\\ 2 & 6\\end{aligned}],\n$$\n\nfind $A⊙(B+C).$" 13194139534274 17592186045417 true] [17592186416981 1072 #uuid "949652ef-4c40-590b-96ed-3051cee3c306" 13194139534274 17592186045417 true] [17592186416981 1074 "For compatible matrices $A,$ $B,$ and $C,$ and scalar $\\alpha ,$ the Hadamard product has the following properties:\n\n- Commutativity:\n\n$$\nA⊙B=B⊙A\n$$\n\n- Associativity:\n\n$$\n(A⊙B)⊙C=A⊙(B⊙C)\n$$\n\n- Distributivity over Addition:\n\n$$\nA⊙(B+C)=A⊙B+A⊙C\n$$\n\n- Scalar Distributivity:\n\n$$\n\\alpha (A⊙B)=(\\alpha A)⊙B=A⊙(\\alpha B)\n$$\n\nIn this case, by the distributivity over the addition of the Hadamard product, we have\n\n$$\n\\begin{aligned}A⊙(B+C) & =A⊙B+A⊙C \\\\  & =[\\begin{aligned}-1 & 4 \\\\ 3 & -2\\end{aligned}]+[\\begin{aligned}5 & -3 \\\\ 2 & 6\\end{aligned}] \\\\  & =[\\begin{aligned}-1+5 & 4+(-3) \\\\ 3+2 & -2+6\\end{aligned}] \\\\  & =[\\begin{aligned}4 & 1 \\\\ 5 & 4\\end{aligned}].\\end{aligned}\n$$" 13194139534274 17592186045417 true] [17592186416982 1068 #edb/ref 17592186416978 13194139534274 17592186045417 true] [17592186416982 1069 "q-274938" 13194139534274 17592186045417 true] [17592186416982 1070 #edb/ref 17592186045487 13194139534274 17592186045417 true] [17592186416982 1071 "Given the matrices\n\n$$\nX=[\\begin{aligned}4 & 5 \\\\ 0 & 2 \\\\ 7 & 6\\end{aligned}]\\,Y=[\\begin{aligned}1 & 3 & 4 \\\\ 2 & 1 & 5\\end{aligned}]\\,u=[\\begin{aligned}1 \\\\ 0 \\\\ 8\\end{aligned}]\n$$\n\n in which of the following expressions is the Hadamard product well-defined?\n\n- $YX⊙Y\\,\\text{diag}(u)$\n- $X⊙Yu$\n- $Y\\,\\text{diag}(u)⊙YX{X}^{T}$\n\n*Hint: Here, $\\text{diag}(v)$ is a diagonal matrix with the entries of $v$ on the diagonal.*" 13194139534274 17592186045417 true] [17592186416982 1072 #uuid "d6deba07-cdc0-5243-9183-e0064a49692b" 13194139534274 17592186045417 true] [17592186416982 1074 "The Hadamard product of two matrices (or vectors) is only defined if they have the same dimensions.\n\nFirst, notice that $X$ is a $3\\times 2$ matrix, $Y$ is a $2\\times 3$ matrix, and $u$ is a $3\\times 1$ column vector.\n\nNow, let's consider each expression in turn:\n\n- The dimensions of $YX$ are $2\\times 2,$ and the dimensions of $Y\\,\\text{diag}(u)$ are $2\\times 3.$ Hence, the Hadamard product in expression I is *not* well-defined.\n\n- The dimensions of $X$ are $3\\times 2,$ and the dimensions of $Yu$ are $2\\times 1.$ Hence, the Hadamard product in expression II is *not* well-defined.\n\n- The dimensions of $Y\\,\\text{diag}(u)$ are $2\\times 3,$ and the dimensions of $YX{X}^{T}$ are $2\\times 3.$ Hence, the Hadamard product in expression III is well-defined.\n\nTherefore, the correct answer is \"III only\"." 13194139534274 17592186045417 true] [17592186416983 1058 #edb/ref 17592186416985 13194139534274 17592186045417 true] [17592186416983 1062 #uuid "0d3e84d2-d953-558b-af01-c028d4c99ee0" 13194139534274 17592186045417 true] [17592186416983 1063 #edb/ref 17592186416982 13194139534274 17592186045417 true] [17592186416984 1058 #edb/ref 17592186416983 13194139534274 17592186045417 true] [17592186416984 1062 #uuid "6b8c916d-3e6f-50e3-93f9-beef5bb82a7c" 13194139534274 17592186045417 true] [17592186416984 1063 #edb/ref 17592186208935 13194139534274 17592186045417 true] [17592186416985 1058 #edb/ref 17592186416986 13194139534274 17592186045417 true] [17592186416985 1062 #uuid "b3f26575-c797-522f-a200-4644a0a00043" 13194139534274 17592186045417 true] [17592186416985 1063 #edb/ref 17592186416979 13194139534274 17592186045417 true] [17592186416986 1058 #edb/ref 17592186416987 13194139534274 17592186045417 true] [17592186416986 1062 #uuid "c1071696-e655-5ecd-afd6-5b8d5ab025f4" 13194139534274 17592186045417 true] [17592186416986 1063 #edb/ref 17592186416981 13194139534274 17592186045417 true] [17592186416987 1062 #uuid "d82ccbfe-c2d4-5293-84fe-d7f1b4c1a6eb" 13194139534274 17592186045417 true] [17592186416987 1063 #edb/ref 17592186416980 13194139534274 17592186045417 true]] :edb/tempids {"activity-b99ebc85-8cef-5385-a2b1-1c327e93470d" 17592186416950 "answer-121e66b4-70e7-5b38-a11e-65d067c24a87" 17592186416951 "answer-17423c56-ad3b-5cbd-b3f2-198c80452668" 17592186416952 "answer-22840a97-d87c-5db3-8cc7-9618322ae020" 17592186416953 "answer-2828159a-8410-56f3-9efb-1ceb5129dd0f" 17592186416954 "answer-2d8df6e2-fe2b-50c4-8d6d-bfcfdcb03b07" 17592186416955 "answer-368e5c38-687c-5476-a766-53fe59679efb" 17592186416956 "answer-5e6c4830-f8dc-59ec-afda-b68feab4a6a7" 17592186416957 "answer-72743300-9d7b-58b0-b57f-66ae1fc05f7c" 17592186416958 "answer-8439cea5-6452-5e18-b89d-aa00cedaf1de" 17592186416959 "answer-988fbd19-775b-5a10-882a-1f3f552febcb" 17592186416960 "answer-99e69295-3d01-5049-930d-3445788a8790" 17592186416961 "answer-a2de33de-7c02-5cb9-b000-8fd4ffa0668b" 17592186416962 "answer-a81f915c-2e4f-5036-ade2-5fb225