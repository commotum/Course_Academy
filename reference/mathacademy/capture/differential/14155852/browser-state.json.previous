      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14155852/observations/step-q344888-45e09384d0f4c29a76ab.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14155852/observations/step-q344888-45e09384d0f4c29a76ab.png",
