      "source_url": "https://mathacademy.com/tasks/14155852/topics/1117/lesson",
      "captured_at": 1791857963.6973553,
      "math_academy_id": "q-104795",
      "topic_id": "1117",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q104795",
        "placement_id": null,
        "content_id": null,
