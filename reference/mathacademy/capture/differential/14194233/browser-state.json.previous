    "q-70653": {
      "dom_id": "step-q70653",
      "name": "Question 20",
      "problem": "What is the trace in the $yz$-plane of the sphere ${x}^{2}+(y-2)^{2}+{z}^{2}=4?$",
      "worked_solution": "To find the trace in the $yz$-plane, we substitute $x=0$ into the equation of the sphere:\n\n$$\n\\begin{aligned}(0)^{2}+(y-2)^{2}+{z}^{2} & =4 \\\\ (y-2)^{2}+{z}^{2} & =4\\end{aligned}\n$$",
