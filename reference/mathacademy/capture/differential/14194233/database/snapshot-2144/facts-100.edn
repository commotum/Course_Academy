ef 1072 #uuid "fc3f69db-faba-5b23-aeec-3cea350fe1f0" #edb/ref 17592186045417] [17592186403613 #edb/ref 1074 "To find the $x$-intercepts, we plug $y=0$ and $z=0$ into the equation:\n\n$$\n\\begin{aligned}\\frac{(x-1)^{2}}{18}+\\frac{(0+2)^{2}}{8}+\\frac{{0}^{2}}{16} & =1 \\\\ \\frac{(x-1)^{2}}{18}+\\frac{1}{2}+0 & =1 \\\\ \\frac{(x-1)^{2}}{18} & =\\frac{1}{2} \\\\ (x-1)^{2} & =9 \\\\ x-1 & =\\pm 3 \\\\ x & =1\\pm 3\\end{aligned}\n$$\n\nHence, we get the solutions $x=4$ and $x=-2.$\n\nTherefore, the intercepts with the $x$-axis are $(-2,0,0)$ and $(4,0,0).$" #edb/ref 17592186045417] [17592186403614 #edb/ref 1075 #edb/ref 17592186403615 #edb/ref 17592186045417] [17592186403614 #edb/ref 1075 #edb/ref 17592186403616 #edb/ref 17592186045417] [17592186403614 #edb/ref 1075 #edb/ref 17592186403617 #edb/ref 17592186045417] [17592186403614 #edb/ref 1075 #edb/ref 17592186403618 #edb/ref 17592186045417] [17592186403614 #edb/ref 1075 #edb/ref 17592186403619 #edb/ref 17592186045417] [17592186403614 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186403614 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186403614 #edb/ref 1078 #edb/ref 17592186403616 #edb/ref 17592186045417] [17592186403614 #edb/ref 1079 #uuid "d82b2d36-5f6d-5949-984e-5d1d9ec7556d" #edb/ref 17592186045417] [17592186403615 #edb/ref 1080 "$(0,0,0)$ and $(2,0,0)$" #edb/ref 17592186045417] [17592186403615 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186403615 #edb/ref 1083 #uuid "adcb33db-de68-50f5-9cbe-6b7d8f84aaae" #edb/ref 17592186045417] [17592186403616 #edb/ref 1080 "$(-2,0,0)$ and $(4,0,0)$" #edb/ref 17592186045417] [17592186403616 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186403616 #edb/ref 1083 #uuid "ee548906-3638-5d51-96d2-b358b4a1f8b6" #edb/ref 17592186045417] [17592186403617 #edb/ref 1080 "$(-4,0,0)$ and $(4,0,0)$" #edb/ref 17592186045417] [17592186403617 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [175921864