ent :answer.type/text} :answer/value "$r=2\\sqrt{2}$ and $C(-1,1,0)$" :db/id #edb/ref 17592186506788} {:answer/id #uuid "50eb711d-49e1-52ef-a713-29958c8bd820" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$r=2\\sqrt{2}$ and $C(1,1,0)$" :db/id #edb/ref 17592186506863} {:answer/id #uuid "ddd2b34d-8cad-5ab7-952c-317d0f8edb69" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$r=2\\sqrt{2}$ and $C(1,-1,0)$" :db/id #edb/ref 17592186507158} {:answer/id #uuid "f6a49a77-1313-5ccb-b4c9-680ed1a343ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$r=8$ and $C(1,1,0)$" :db/id #edb/ref 17592186507222}] :answer-field/correct {:answer/id #uuid "ddd2b34d-8cad-5ab7-952c-317d0f8edb69" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$r=2\\sqrt{2}$ and $C(1,-1,0)$" :db/id #edb/ref 17592186507158} :answer-field/id #uuid "1d7ee726-aa87-5bf9-ab12-c8a5dbd19f04" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186507259}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3c1ae5e1-e0dd-5c7b-a210-a9ab2fb7f3cd" :question/math-academy-id "q-71943" :question/problem "What are the radius $r$ and the coordinates of the center $C$ for the sphere $(x-1)^{2}+(y+1)^{2}+{z}^{2}=8?$" :question/worked-solution "Remember that the equation of a sphere centered at $({x}_{0},{y}_{0},{z}_{0})$ with radius $r>0$ is given by\n\n$$\n(x-{x}_{0})^{2}+(y-{y}_{0})^{2}+(z-{z}_{0})^{2}={r}^{2}.\n$$\n\nWe can write our equation as\n\n$$\n(x-1)^{2}+(y-(-1))^{2}+{z}^{2}=(\\sqrt{8})^{2},\n$$\n\nwhich gives us the center at the point point $C(1,-1,0)$ and the radius $r=\\sqrt{8}=2\\sqrt{2}.$"}] [{:db/id #edb/ref 17592186507505 :knowledge-point/_questions [{:db/id #edb/ref 17592186124506 :knowledge-point/id #uuid "304a85ac-e980-5081-8f2b-20df471c30fc" :knowledge-point/title "Identifying the Center and Radius of a Sphere"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "007dae28-6186-535e-80fe-e29249f65211" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186506679} {:answer/id #uuid "1c1cde7a-7994-5077-804f-cd9fc7de15b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{23}" :db/id #edb/ref 17592186506730} {:answer/id #uuid "477b7483-844d-5004-a21b-1120bc312d38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186506844} {:answer/id #uuid "56be8c4c-7eb0-5721-96c6-8e8f2b6fcca3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{6}" :db/id #edb/ref 17592186506878} {:answer/id #uuid "844e2bbe-9af9-5527-9601-2dd601166f0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186506971}] :answer-field/correct {:answer/id #uuid "007dae28-6186-535e-80fe-e29249f65211" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186506679} :answer-field/id #uuid "48f0dd72-8137-5edb-bf5c-9167ff0fe965" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186507279}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d2a5a0df-a4bf-58c3-8d59-4e8c846dde92" :question/math-academy-id "q-71946" :question/problem "What is the radius of the sphere $(x-2)^{2}+{y}^{2}-2y+{z}^{2}=24?$" :question/worked-solution "Remember that the equation of a sphere centered at $({x}_{0},{y}_{0},{z}_{0})$ with radius $r>0$ is given by\n\n$$\n(x-{x}_{0})^{2}+(y-{y}_{0})^{2}+(z-{z}_{0})^{2}={r}^{2}.\n$$\n\nBy completing the square for the variable $y$, we have:\n\n$$\n\\begin{aligned}(x-2)^{2}+{y}^{2}-2y+{z}^{2} & =24 \\\\ (x-2)^{2}+({y}^{2}-2y+1)+{z}^{2} & =24+1 \\\\ (x-2)^{2}+(y-1)^{2}+{z}^{2} & =25\\end{aligned}\n$$\n\nNow, we can write our equation as\n\n$$\n(x-2)^{2}+(y-1)^{2}+{z}^{2}={5}^{2},\n$$\n\nwhich gives us a radius of $5.$"}] [{:db/id #edb/ref 17592186339018 :knowledge-point/_questions [{:db/id #edb/ref 17592186124507 :knowledge-point/id #uuid "8db2909b-26fd-53bf-8ce2-9fca4451efc3" :knowledge-point/title "Describing Traces of Ellipsoids"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "572ddd40-8679-5198-b9d6-f4db2a7838d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}+(z-1)^{2}=9" :db/id #edb/ref 17592186336832} {:answer/id #uuid "714c612a-e639-5e65-bb3f-eb12152c55f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}+(z+1)^{2}=3" :db/id #edb/ref 17592186337044} {:answer/id #uuid "81a670a9-b024-5136-80ec-fd25c71d23bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}+(z-1)^{2}=36" :db/id #edb/ref 17592186337209} {:answer/id #uuid "b436f023-060b-5354-9f1c-0dc1682a2c3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}+(z+1)^{2}=9" :db/id #edb/ref 17592186337632} {:answer/id #uuid "e4acb98f-accf-5e18-82c5-10ffd96a9be7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}+(z+1)^{2}=41" :db/id #edb/ref 17592186338026}] :answer-field/correct {:answer/id #uuid "b436f023-060b-5354-9f1c-0dc1682a2c3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}+(z+1)^{2}=9" :db/id #edb/ref 17592186337632} :answer-field/id #uuid "c11c86a5-f436-5d1a-8f41-6ed3efce843e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338620}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "73a6f932-1d38-5734-a9eb-076d70aa6439" :question/math-academy-id "q-71947" :question/problem "What is the trace in the $yz$-plane of the sphere $(x-4)^{2}+{y}^{2}+(z+1)^{2}=25?$" :question/worked-solution "To find the trace in the $yz$-plane, we substitute $x=0$ into the equation of the sphere:\n\n$$\n\\begin{aligned}(0-4)^{2}+{y}^{2}+(z+1)^{2} & =25 \\\\ 16+{y}^{2}+(z+1)^{2} & =25 \\\\ {y}^{2}+(z+1)^{2} & =9\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186403523 :knowledge-point/_questions [{:db/id #edb/ref 17592186124507 :knowledge-point/id #uuid "8db2909b-26fd-53bf-8ce2-9fca4451efc3" :knowledge-point/title "Describing Traces of Ellipsoids"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "70e9bd71-5d88-5167-90c2-169b49327300" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The circle of radius $16$ centered at $(-1,0)$" :db/id #edb/ref 17592186403525} {:answer/id #uuid "23f8b5ef-a6d7-5886-b4e8-fde2fff6e26e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The circle of radius $4$ centered at $(1,0)$" :db/id #edb/ref 17592186403526} {:answer/id #uuid "21d82f56-9813-5d47-8969-ee3b39871961" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The circle of radius $4$ centered at $(-1,0)$" :db/id #edb/ref 17592186403527} {:answer/id #uuid "c2da5d34-ebd9-5b2f-ba20-8c77a7870bb9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The circle of radius $\\sqrt{17}$ centered at $(1,0)$" :db/id #edb/ref 17592186403528} {:answer/id #uuid "331daaa1-32e0-5fc0-ab96-15e14ef79e5b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The circle of radius $16$ centered at $(1,0)$" :db/id #edb/ref 17592186403529}] :answer-field/correct {:answer/id #uuid "23f8b5ef-a6d7-5886-b4e8-fde2fff6e26e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The circle of radius $4$ centered at $(1,0)$" :db/id #edb/ref 17592186403526} :answer-field/id #uuid "c4f59e4b-4277-5493-8d81-a85578c12018" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403524}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6d8b4045-9642-5938-bbc6-e68bf8139eaf" :question/math-academy-id "q-71948" :question/problem "What is the projection of the intersection between the sphere $(x-1)^{2}+(y-6)^{2}+{z}^{2}=17$ and the plane $y=5$ onto the $xz$-plane." :question/worked-solution "To find the intersection of the sphere and the plane $y=5$, we substitute $y=5$ into the equation of the sphere:\n\n$$\n\\begin{aligned}(x-1)^{2}+(5-6)^{2}+{z}^{2} & =17 \\\\ (x-1)^{2}+1+{z}^{2} & =17 \\\\ (x-1)^{2}+{z}^{2} & =16 \\\\ (x-1)^{2}+{z}^{2} & ={4}^{2}\\end{aligned}\n$$\n\nProjecting this onto the $xz$-plane gives us the equation of the circle of radius $4$ centered at $(1,0).$"}] [{:db/id #edb/ref 17592186403613 :knowledge-point/_questions [{:db/id #edb/ref 17592186124502 :knowledge-point/id #uuid "64e7d2fb-003c-58c0-ab80-159e50748cc7" :knowledge-point/title "Calculating Intercepts of Spheres and Ellipsoids"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "adcb33db-de68-50f5-9cbe-6b7d8f84aaae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0,0)$ and $(2,0,0)$" :db/id #edb/ref 17592186403615} {:answer/id #uuid "ee548906-3638-5d51-96d2-b358b4a1f8b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-2,0,0)$ and $(4,0,0)$" :db/id #edb/ref 17592186403616} {:answer/id #uuid "81a50ee6-a29f-5cf2-ba44-251758623d8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-4,0,0)$ and $(4,0,0)$" :db/id #edb/ref 17592186403617} {:answer/id #uuid "ef09c53b-97f7-594e-a8f7-fee68af6a063" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(4,0,0)$ only" :db/id #edb/ref 17592186403618} {:answer/id #uuid "b4640bb5-2749-5d8c-bb08-ee4349a6f316" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-3\\sqrt{2},0,0)$ and $(3\\sqrt{2},0,0)$" :db/id #edb/ref 17592186403619}] :answer-field/correct {:answer/id #uuid "ee548906-3638-5d51-96d2-b358b4a1f8b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-2,0,0)$ and $(4,0,0)$" :db/id #edb/ref 17592186403616} :answer-field/id #uuid "d82b2d36-5f6d-5949-984e-5d1d9ec7556d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403614}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fc3f69db-faba-5b23-aeec-3cea350fe1f0" :question/math-academy-id "q-73190" :question/problem "Given the ellipsoid $\\frac{(x-1)^{2}}{18}+\\frac{(y+2)^{2}}{8}+\\frac{{z}^{2}}{16}=1$, find its intercepts with the $x$-axis." :question/worked-solution "To find the $x$-intercepts, we plug $y=0$ and $z=0$ into the equation:\n\n$$\n\\begin{aligned}\\frac{(x-1)^{2}}{18}+\\frac{(0+2)^{2}}{8}+\\frac{{0}^{2}}{16} & =1 \\\\ \\frac{(x-1)^{2}}{18}+\\frac{1}{2}+0 & =1 \\\\ \\frac{(x-1)^{2}}{18} & =\\frac{1}{2} \\\\ (x-1)^{2} & =9 \\\\ x-1 & =\\pm 3 \\\\ x & =1\\pm 3\\end{aligned}\n$$\n\nHence, we get the solutions $x=4$ and $x=-2.$\n\nTherefore, the intercepts with the $x$-axis are $(-2,0,0)$ and $(4,0,0).$"}]}
