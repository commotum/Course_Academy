c" :question/math-academy-id "q-70648" :question/problem "What are the radius $r$ and the coordinates of the center $C$ for the sphere $(x+2)^{2}+{y}^{2}+(z-3)^{2}=4?$" :question/worked-solution "Remember that the equation of a sphere centered at $({x}_{0},{y}_{0},{z}_{0})$ with radius $r>0$ is given by\n\n$$\n(x-{x}_{0})^{2}+(y-{y}_{0})^{2}+(z-{z}_{0})^{2}={r}^{2}.\n$$\n\nWe can write our equation as\n\n$$\n(x-(-2))^{2}+{y}^{2}+(z-3)^{2}={2}^{2},\n$$\n\nwhich gives us the center at the point point $C(-2,0,3)$ and the radius $r=2.$"}] [{:db/id #edb/ref 17592186403370 :knowledge-point/_questions [{:db/id #edb/ref 17592186124506 :knowledge-point/id #uuid "304a85ac-e980-5081-8f2b-20df471c30fc" :knowledge-point/title "Identifying the Center and Radius of a Sphere"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31387237-56d6-52c2-9715-e7aa1debedf0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$r=\\sqrt{10}$ and $C(0,5,0)$" :db/id #edb/ref 17592186403372} {:answer/id #uuid "634baf73-26e0-5f65-be9f-a93d12600043" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$r=10$ and $C(0,0,-5)$" :db/id #edb/ref 17592186403373} {:answer/id #uuid "7979aab2-f218-59e3-9e9f-303812b87e70" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$r=10$ and $C(0,5,0)$" :db/id #edb/ref 17592186403374} {:answer/id #uuid "a8e33acb-8e20-521a-af19-148dd60198c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$r=\\sqrt{10}$ and $C(-5,0,0)$" :db/id #edb/ref 17592186403375} {:answer/id #uuid "dbb53620-476d-5ae9-ad63-21ba59d0bc6a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$r=\\sqrt{10}$ and $C(0,-5,0)$" :db/id #edb/ref 17592186403376}] :answer-field/correct {:answer/id #uuid "dbb53620-476d-5ae9-ad63-21ba59d0bc6a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$r=\\sqrt{10}$ and $C(0,-5,0)$" :db/id #edb/ref 17592186403376} :answer-field/id #uuid "8139d71c-70dc-59f4-9860-d5ad6c1654cc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403371}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "69541963-bfeb-5f91-b675-aa9309c1e160" :question/math-academy-id "q-70649" :question/problem "What are the radius $r$ and the coordinates of the center $C$ for the sphere ${x}^{2}+(y+5)^{2}+{z}^{2}=10?$" :question/worked-solution "Remember that the equation of a sphere centered at $({x}_{0},{y}_{0},{z}_{0})$ with radius $r>0$ is given by\n\n$$\n(x-{x}_{0})^{2}+(y-{y}_{0})^{2}+(z-{z}_{0})^{2}={r}^{2}.\n$$\n\nWe can write our equation as\n\n$$\n{x}^{2}+(y-(-5))^{2}+{z}^{2}=(\\sqrt{10})^{2},\n$$\n\nwhich gives us the center at the point point $C(0,-5,0)$ and the radius $r=\\sqrt{10}.$"}] [{:db/id #edb/ref 17592186507403 :knowledge-point/_questions [{:db/id #edb/ref 17592186124507 :knowledge-point/id #uuid "8db2909b-26fd-53bf-8ce2-9fca4451efc3" :knowledge-point/title "Describing Traces of Ellipsoids"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27d51d47-0ced-5e8c-bf3b-49cc1787c4f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}+{z}^{2}=2" :db/id #edb/ref 17592186506767} {:answer/id #uuid "43623d2c-9b19-5cdc-a17d-8389decf2cd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+(y-2)^{2}=4" :db/id #edb/ref 17592186506836} {:answer/id #uuid "5a059ca5-b57f-5fa3-8926-1fcee923a0d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{z}^{2}=4" :db/id #edb/ref 17592186506889} {:answer/id #uuid "9e723f8f-8733-537a-a98b-f7d2f93e4b45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/v