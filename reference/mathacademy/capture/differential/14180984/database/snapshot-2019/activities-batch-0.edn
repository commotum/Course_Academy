#{[{:activity/first-step {:db/id #edb/ref 17592186213857} :activity/id #uuid "b8af5a55-31af-5f64-8ca5-6aa369cb9ea8" :activity/scope {:db/id #edb/ref 17592186048758 :topic/id #uuid "bc0baf51-6352-5e73-9783-27ae4241c004" :topic/math-academy-id 6185} :activity/steps [{:db/id #edb/ref 17592186213857 :step/content {:db/id #edb/ref 17592186214235 :tutorial/content "Rationalizing the denominator works similarly for algebraic expressions as it does for numerical ones. When the denominator contains two terms and includes radicals, we multiply both the numerator and the denominator by the *conjugate* of the denominator to eliminate the radical.\n\nFor example, consider the following expression:\n\n$$\n\\dfrac{1}{1+\\sqrt{x}}\n$$\n\nTo find the conjugate of the denominator $1+\\sqrt{x}$, all we have to do is flip the sign between the two terms. So, the conjugate of the denominator is\n\n$$\n1\\,{\\color{blue}{-}}\\,\\sqrt{x}\n$$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by $1-\\sqrt{x}$ and simplify:\n\n$$\n\\begin{aligned}\n\\frac{1}{1 + \\sqrt{x}} &=  \\\\\n\\frac{1}{1 + \\sqrt{x}} \\cdot \\frac{1 - \\sqrt{x}}{1 - \\sqrt{x}} &=  \\\\\n(1 - \\sqrt{x})/((1 + \\sqrt{x})(1 - \\sqrt{x})) &=  \\\\\n(1 - \\sqrt{x})/(1^{2} - (\\sqrt{x})^{2}) &=  \\\\\n&= \\frac{1 - \\sqrt{x}}{1 - x}\n\\end{aligned}\n$$" :tutorial/id #uuid "8dde46d5-669e-5c3a-b471-7541b1824862" :tutorial/math-academy-id 13464 :tutorial/title "Introduction"} :step/id #uuid "7c88995e-61d0-5dad-a452-dff7902b363d" :step/math-academy-id 478497 :step/next {:db/id #edb/ref 17592186213858}} {:db/id #edb/ref 17592186213858 :step/content {:db/id #edb/ref 17592186213017 :knowledge-point/canonical-example {:db/id #edb/ref 17592186212794 :question/id #uuid "659e7fd3-3502-5a47-a54c-3d0c33150d73" :question/math-academy-id "e-18928"} :knowledge-point/id #uuid "e9139c75-1189-5b78-9d82-023f5208a490" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048229} {:db/id #edb/ref 175921