#{[{:db/id #edb/ref 17592186497336 :knowledge-point/_questions [{:db/id #edb/ref 17592186213018 :knowledge-point/id #uuid "fa5d982f-ff13-5a31-9cd3-d5847ea2790c" :knowledge-point/title "Rationalizing Denominators Containing a Binomial Within the Radical"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24902765-f87a-52d2-8aed-b72916532c51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2(\\sqrt{q+1}+2)" :db/id #edb/ref 17592186496737} {:answer/id #uuid "59034b89-95f0-5bee-a19c-3cc11e74e14e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4(\\sqrt{q+1}+2)}{q}" :db/id #edb/ref 17592186496848} {:answer/id #uuid "7afbc696-174b-5aa6-a361-d4fb1513898f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2(\\sqrt{q+1}+2)}{q-3}" :db/id #edb/ref 17592186496916} {:answer/id #uuid "beea4dc9-8883-552c-ac78-4a1888f63aac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4(\\sqrt{q+1}+2)" :db/id #edb/ref 17592186497047} {:answer/id #uuid "c5c5c02f-1750-5fe2-84d3-9f069116c389" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4(\\sqrt{q+1}+2)}{q-3}" :db/id #edb/ref 17592186497063}] :answer-field/correct {:answer/id #uuid "c5c5c02f-1750-5fe2-84d3-9f069116c389" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4(\\sqrt{q+1}+2)}{q-3}" :db/id #edb/ref 17592186497063} :answer-field/id #uuid "352e22d3-3322-5945-aacd-bbb5be700ed3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186497240}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1c076968-69eb-5008-a15f-3101901a7753" :question/math-academy-id "q-111085" :question/problem "Rationalize the denominator of $\\frac{4}{\\sqrt{q+1}-2}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{q+1}+2.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{q+1}+2,$ and simplify:\n\n$$\n\\begin{aligned}\\frac{4}{\\sqrt{q+1}-2} & = \\\\ \\frac{4}{\\sqrt{q+1}-2}\\cdot \\frac{\\sqrt{q+1}+2}{\\sqrt{q+1}+2} & = \\\\ \\frac{4(\\sqrt{q+1}+2)}{(\\sqrt{q+1}-2)(\\sqrt{q+1}+2)} & = \\\\ \\frac{4(\\sqrt{q+1}+2)}{(\\sqrt{q+1})^{2}-{2}^{2}} & = \\\\ \\frac{4(\\sqrt{q+1}+2)}{q+1-4} & = \\\\ \\frac{4(\\sqrt{q+1}+2)}{q-3} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186497392 :knowledge-point/_questions [{:db/id #edb/ref 17592186213018 :knowledge-point/id #uuid "fa5d982f-ff13-5a31-9cd3-d5847ea2790c" :knowledge-point/title "Rationalizing Denominators Containing a Binomial Within the Radical"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59c0abeb-efea-5346-a12d-6aceb41e5d82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(2c+5)(2c-5)(\\sqrt{2c-1}-2)}{c}" :db/id #edb/ref 17592186496852} {:answer/id #uuid "5b6d0a3a-7076-5fdb-9621-e69c7e602ff2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(2c+5)(2c-5)(\\sqrt{2c-1}-2)}{c-1}" :db/id #edb/ref 17592186496858} {:answer/id #uuid "6b4043b8-d542-56a8-94c3-4a171b378921" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2c-5)(\\sqrt{2c-1}-2)" :db/id #edb/ref 17592186496889} {:answer/id #uuid "d09d9917-b956-5f74-8457-7b67b79b18b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(2c+5)(2c-5)(\\sqrt{2c-1}-2)}{c+2}" :db/id #edb/ref 17592186497090} {:answer/id #uuid "e3220828-f713-5b43-83e7-461b5c071967" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2c+5)(\\sqrt{2c-1}-2)" :db/id #edb/ref 17592186497145}] :answer-field/correct {:answer/id #uuid "e3220828-f713-5b43-83e7-461b5c071967" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2c+5)(\\sqrt{2c-1}-2)" :db/id #edb/ref 17592186497145} :answer-field/id #uuid "0b21d62e-53c1-50ce-9ab2-68ee95cacfa9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186497214}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b52a407e-c533-5755-83ae-d5bfaf9c5559" :question/math-academy-id "q-111090" :question/problem "Rationalize the denominator of $\\frac{4{c}^{2}-25}{\\sqrt{2c-1}+2}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{2c-1}-2.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{2c-1}-2,$ and simplify:\n\n$$\n\\begin{aligned}\\frac{4{c}^{2}-25}{\\sqrt{2c-1}+2} & = \\\\ \\frac{4{c}^{2}-25}{\\sqrt{2c-1}+2}\\cdot \\frac{\\sqrt{2c-1}-2}{\\sqrt{2c-1}-2} & = \\\\ \\frac{(4{c}^{2}-25)(\\sqrt{2c-1}-2)}{(\\sqrt{2c-1}+2)(\\sqrt{2c-1}-2)} & = \\\\ \\frac{(4{c}^{2}-25)(\\sqrt{2c-1}-2)}{(\\sqrt{2c-1})^{2}-{2}^{2}} & = \\\\ \\frac{(2c+5)(2c-5)(\\sqrt{2c-1}-2)}{2c-1-4} & = \\\\ \\frac{(2c+5)(2c-5)(\\sqrt{2c-1}-2)}{2c-5} & = \\\\ \\frac{(2c+5)\\cancel{(2c-5)}(\\sqrt{2c-1}-2)}{\\cancel{2c-5}} & = \\\\ (2c+5)(\\sqrt{2c-1}-2)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186497360 :knowledge-point/_questions [{:db/id #edb/ref 17592186213018 :knowledge-point/id #uuid "fa5d982f-ff13-5a31-9cd3-d5847ea2790c" :knowledge-point/title "Rationalizing Denominators Containing a Binomial Within the Radical"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bb361c6-6dd5-552c-a427-a36cf070b655" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{w(\\sqrt{2w+3}+1)}{w+1}" :db/id #edb/ref 17592186496679} {:answer/id #uuid "4881d5c1-1bbc-586e-9272-b79e718a7ae0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{w(\\sqrt{2w+3}+1)}{w+4}" :db/id #edb/ref 17592186496822} {:answer/id #uuid "58b04e7f-48fb-5d60-9894-e699ad85fce0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2w+3}+2}{4}" :db/id #edb/ref 17592186496845} {:answer/id #uuid "59ba9695-6e1c-5180-8ee9-758ebad42ea3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2w+3}+4}{2}" :db/id #edb/ref 17592186496851} {:answer/id #uuid "9fc00c71-a5e7-57f3-b1b5-fd9dc5eab57b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2w+3}+1}{2}" :db/id #edb/ref 17592186496991}] :answer-field/correct {:answer/id #uuid "9fc00c71-a5e7-57f3-b1b5-fd9dc5eab57b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2w+3}+1}{2}" :db/id #edb/ref 17592186496991} :answer-field/id #uuid "5bc4d4eb-b093-5f42-bf15-0372a2d6d50b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186497258}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "58d0d2af-1f8e-5b5b-ada1-d6636471e4c9" :question/math-academy-id "q-111092" :question/problem "Rationalize the denominator of $\\frac{w+1}{\\sqrt{2w+3}-1}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{2w+3}+1.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{2w+3}+1,$ and simplify:\n\n$$\n\\begin{aligned}\\frac{w+1}{\\sqrt{2w+3}-1} & = \\\\ \\frac{w+1}{\\sqrt{2w+3}-1}\\cdot \\frac{\\sqrt{2w+3}+1}{\\sqrt{2w+3}+1} & = \\\\ \\frac{(w+1)(\\sqrt{2w+3}+1)}{(\\sqrt{2w+3}-1)(\\sqrt{2w+3}+1)} & = \\\\ \\frac{(w+1)(\\sqrt{2w+3}+1)}{(\\sqrt{2w+3})^{2}-{1}^{2}} & = \\\\ \\frac{(w+1)(\\sqrt{2w+3}+1)}{2w+3-1} & = \\\\ \\frac{(w+1)(\\sqrt{2w+3}+1)}{2w+2} & = \\\\ \\frac{\\cancel{(w+1)}(\\sqrt{2w+3}+1)}{2\\cancel{(w+1)}} & = \\\\ \\frac{\\sqrt{2w+3}+1}{2} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186497354 :knowledge-point/_questions [{:db/id #edb/ref 17592186213019 :knowledge-point/id #uuid "43395cdf-3e16-5147-87fb-371193078b4a" :knowledge-point/title "Rationalizing a Denominator With Two Radicals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b65670a-a896-5610-82ac-5751ceff85c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{12(\\sqrt{x+3}+\\sqrt{x+5})}{2}" :db/id #edb/ref 17592186496715} {:answer/id #uuid "4ef52864-87e6-5b65-8775-27fca6c3a068" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6(\\sqrt{x+3}+\\sqrt{x+5})}{x}" :db/id #edb/ref 17592186496832} {:answer/id #uuid "82b190a0-3b5e-5790-9137-dada26dc5d6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12(\\sqrt{x+3}+\\sqrt{x+5})" :db/id #edb/ref 17592186496925} {:answer/id #uuid "cff26320-aaef-57fe-a31f-7c3b21af878a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6(\\sqrt{x+3}+\\sqrt{x+5})" :db/id #edb/ref 17592186497087} {:answer/id #uuid "d2128cd1-c593-59ee-8c09-21ce7bd84ce2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6(\\sqrt{x+3}+\\sqrt{x+5})" :db/id #edb/ref 17592186497096}] :answer-field/correct {:answer/id #uuid "d2128cd1-c593-59ee-8c09-21ce7bd84ce2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6(\\sqrt{x+3}+\\sqrt{x+5})" :db/id #edb/ref 17592186497096} :answer-field/id #uuid "e48e28cb-69c5-5ec3-b0b0-45cd22625ed2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186497310}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "48232a69-9972-5f32-be1d-adbffa500e27" :question/math-academy-id "q-296049" :question/problem "Rationalize the denominator of $\\frac{12}{\\sqrt{x+3}-\\sqrt{x+5}}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{x+3}+\\sqrt{x+5}.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{x+3}+\\sqrt{x+5},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{12}{\\sqrt{x+3}-\\sqrt{x+5}} & = \\\\ \\frac{12}{\\sqrt{x+3}-\\sqrt{x+5}}\\cdot \\frac{\\sqrt{x+3}+\\sqrt{x+5}}{\\sqrt{x+3}+\\sqrt{x+5}} & = \\\\ \\frac{12(\\sqrt{x+3}+\\sqrt{x+5})}{(\\sqrt{x+3}+\\sqrt{x+5})(\\sqrt{x+3}+\\sqrt{x+5})} & = \\\\ \\frac{12(\\sqrt{x+3}+\\sqrt{x+5})}{(\\sqrt{x+3})^{2}-(\\sqrt{x+5})^{2}} & = \\\\ \\frac{12(\\sqrt{x+3}+\\sqrt{x+5})}{(x+3)-(x+5)} & = \\\\ \\frac{12(\\sqrt{x+3}+\\sqrt{x+5})}{-2} & = \\\\ -6(\\sqrt{x+3}+\\sqrt{x+5})\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186497414 :knowledge-point/_questions [{:db/id #edb/ref 17592186213019 :knowledge-point/id #uuid "43395cdf-3e16-5147-87fb-371193078b4a" :knowledge-point/title "Rationalizing a Denominator With Two Radicals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ed6f177-f0a7-51b5-91f1-45cc3525ec42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2w}+\\sqrt{6}}{w-3}" :db/id #edb/ref 17592186496724} {:answer/id #uuid "297af7c5-9d20-5ec8-b43e-b61d43129d8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2(\\sqrt{2w}-\\sqrt{6})}{w-3}" :db/id #edb/ref 17592186496749} {:answer/id #uuid "2f7e0d94-a5f9-5adf-866f-e3b8e6f6df78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2w}-\\sqrt{6}}{w-6}" :db/id #edb/ref 17592186496762} {:answer/id #uuid "89c3d947-dd0c-55f3-b1d7-b34cdac78a47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2w}+\\sqrt{6}}{w-6}" :db/id #edb/ref 17592186496946} {:answer/id #uuid "d6e1d989-f66b-52e3-97f0-bbb5658af8d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2(\\sqrt{2w}+\\sqrt{6})}{w-3}" :db/id #edb/ref 17592186497110}] :answer-field/correct {:answer/id #uuid "1ed6f177-f0a7-51b5-91f1-45cc3525ec42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2w}+\\sqrt{6}}{w-3}" :db/id #edb/ref 17592186496724} :answer-field/id #uuid "9306fa45-f979-577d-88b6-95185ddf9d49" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186497285}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f7189aac-304f-5339-9ec2-dd1037933cdd" :question/math-academy-id "q-85407" :question/problem "Rationalize the denominator of $\\frac{2}{\\sqrt{2w}-\\sqrt{6}}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{2w}+\\sqrt{6}.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{2w}+\\sqrt{6},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{2}{\\sqrt{2w}-\\sqrt{6}} & = \\\\ \\frac{2}{\\sqrt{2w}-\\sqrt{6}}\\cdot \\frac{\\sqrt{2w}+\\sqrt{6}}{\\sqrt{2w}+\\sqrt{6}} & = \\\\ \\frac{2(\\sqrt{2w}+\\sqrt{6})}{(\\sqrt{2w}-\\sqrt{6})(\\sqrt{2w}+\\sqrt{6})} & = \\\\ \\frac{2(\\sqrt{2w}+\\sqrt{6})}{(\\sqrt{2w})^{2}-(\\sqrt{6})^{2}} & = \\\\ \\frac{2(\\sqrt{2w}+\\sqrt{6})}{2w-6} & = \\\\ \\frac{2(\\sqrt{2w}+\\sqrt{6})}{2(w-3)} & = \\\\ \\frac{\\sqrt{2w}+\\sqrt{6}}{w-3}\\end{aligned}\n$$"}]}
