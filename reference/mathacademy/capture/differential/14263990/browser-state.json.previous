\" space=\"4\"><mjx-c class=\"mjx-c1D467 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c30\"></mjx-c><mjx-c class=\"mjx-c2E\"></mjx-c><mjx-c class=\"mjx-c30\"></mjx-c><mjx-c class=\"mjx-c38\"></mjx-c><mjx-c class=\"mjx-c36\"></mjx-c><mjx-c class=\"mjx-c30\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>P</mi><mo stretchy=\"false\">(</mo><mi>Z</mi><mo>≤</mo><mi>z</mi><mo stretchy=\"false\">)</mo><mo>=</mo><mn>0.0860</mn></math></mjx-assistive-mml></mjx-container> using interval bisection and the above table</p><div class=\"freeResponseLine\"><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"-1\" ctxtmenu_counter=\"81\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D467 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2248\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>z</mi><mo>≈</mo></math></mjx-assistive-mml></mjx-container>\n<div id=\"freeResponseTextbox-1\" class=\"matheditor-wrapper-answer\" ;=\"\" style=\"min-width:60px;\n                                        margin-left:2px;\n                                        margin-right:1px;\n                                        background:;\"><div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"5\"><span mathquill-command