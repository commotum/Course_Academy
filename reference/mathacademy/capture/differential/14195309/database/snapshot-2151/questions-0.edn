#{[{:db/id #edb/ref 17592186124214 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186124651 :knowledge-point/id #uuid "9840265f-02bf-58fa-94fd-77fb970af297" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders"}] :question/id #uuid "58055e3d-a903-5b8d-8d65-241cfc118218" :question/math-academy-id "e-12559" :question/problem "Identify the surface $z -1 = \\dfrac{(x-3)^2}{4} - \\dfrac{(y+2)^2}4.$" :question/worked-solution "Recall that the equation of a hyperbolic paraboloid centered at $O$ is given by\n\n$$\nz = \\dfrac{x^2}{a^2}-\\dfrac{y^2}{b^2},\n$$\n\nand a hyperbolic paraboloid centered at $(x_0,y_0,z_0)$ is given by\n\n$$\nz - z_0 = \\dfrac{(x-x_0)^2}{a^2}-\\dfrac{(y-y_0)^2}{b^2}.\n$$\n\nThus, our equation is a hyperbolic paraboloid with the following parameters:\n\n$$\n(x_0,y_0,z_0) = (3, -2, 1), \\quad a= b=2.\n$$"}] [{:db/id #edb/ref 17592186124215 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186124652 :knowledge-point/id #uuid "89fbf42b-d171-5772-87ce-cf622b720963" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders With Alternative Orientations"}] :question/id #uuid "badbbddb-cfe9-589c-becd-d863b061ac6f" :question/math-academy-id "e-12560" :question/problem "Identify the surface $x = \\dfrac{y^2}{4} - 4z^2.$" :question/worked-solution "Recall that the equation of a hyperbolic paraboloid centered at $O$ whose axis of symmetry is the $z$-axis is given by\n\n$$\nz = \\dfrac{x^2}{a^2}-\\dfrac{y^2}{b^2}.\n$$\n\nThus, a hyperbolic paraboloid centered at $O$ whose axis of symmetry is the $\\boldsymbol x$**-axis** is given by\n\n$$\nx = \\dfrac{y^2}{b^2} - \\dfrac{z^2}{c^2}.\n$$\n\nTherefore, our equation is a hyperbolic paraboloid whose axis of symmetry is the $x$-axis, and $b=2, \\: c=\\dfrac 12.$"}] [{:db/id #edb/ref 17592186124409 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186124597 :knowledge-point/id #uuid "549870ce-a18a-5a94-a9ea-f3de72aaac1f" :knowledge-point/title "Identifying Quadric Surfaces by Completing the Square"}] :question/id #uuid "50223d8d-b31c-5895-ab0b-178258fea716" :question/math-academy-id "e-8313" :question/problem "Identify the surface $-x^2 + z^2 + 2x + y=0.$" :question/worked-solution "First, we complete the square in the $x$ term:\n\n$$\n\\begin{aligned}-{x}^{2}+{z}^{2}+2x+y & =0 \\\\ -({x}^{2}-2x)+{z}^{2}+y & =0 \\\\ -(x-1)^{2}+1+{z}^{2}+y & =0\\end{aligned}\n$$\n\nNow, by rearranging, we get the equation\n\n$$\n\\begin{aligned}-(x-1)^{2}+1+{z}^{2}+y & =0 \\\\ -(x-1)^{2}+{z}^{2} & =-y-1 \\\\ (x-1)^{2}-{z}^{2} & =y+1.\\end{aligned}\n$$\n\nThis is the equation of a hyperbolic paraboloid centered at $(1, -1, 0).$"}] [{:db/id #edb/ref 17592186401481 :knowledge-point/_questions [{:db/id #edb/ref 17592186124651 :knowledge-point/id #uuid "9840265f-02bf-58fa-94fd-77fb970af297" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "91eeb41c-1501-568e-81cf-b44bd4f6787f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A paraboloid" :db/id #edb/ref 17592186401483} {:answer/id #uuid "2b39f102-3558-5351-90f8-01a7c7dbb286" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A cylinder" :db/id #edb/ref 17592186401484} {:answer/id #uuid "9d64cbe0-4403-549f-94d2-cf3c73ceb779" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid" :db/id #edb/ref 17592186401485} {:answer/id #uuid "6ffa2b0d-b957-5c7c-a016-40f0594d1ea0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A sphere" :db/id #edb/ref 17592186401486} {:answer/id #uuid "01e9c23e-64f6-5d8c-a235-0d406e419811" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An ellipsoid" :db/id #edb/ref 17592186401487}] :answer-field/correct {:answer/id #uuid "01e9c23e-64f6-5d8c-a235-0d406e419811" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An ellipsoid" :db/id #edb/ref 17592186401487} :answer-field/id #uuid "903d6dd5-4634-519d-8334-fc52eabb5e80" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401482}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1ef46611-6066-5608-b7b6-cb53d9ef1a50" :question/math-academy-id "q-164403" :question/problem "Identify the following surface: \n\n$$\n\\frac{(x-1)^{2}}{9}+\\frac{(y+2)^{2}}{7}+\\frac{{z}^{2}}{4}=1\n$$" :question/worked-solution "Recall that the equation of an ellipsoid centered at $O$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}+\\frac{{z}^{2}}{{c}^{2}}=1,\n$$\n\nand an ellipsoid centered at $({x}_{0},{y}_{0},{z}_{0})$ is given by\n\n$$\n\\frac{(x-{x}_{0})^{2}}{{a}^{2}}+\\frac{(y-{y}_{0})^{2}}{{b}^{2}}+\\frac{(z-{z}_{0})^{2}}{{c}^{2}}=1,\n$$\n\nThus, our equation is an ellipsoid with the following parameters:\n\n$$\n({x}_{0},{y}_{0},{z}_{0})=(1,-2,0),\\,a=3,\\,b=\\sqrt{7},\\,c=2.\n$$"}] [{:db/id #edb/ref 17592186508993 :knowledge-point/_questions [{:db/id #edb/ref 17592186124651 :knowledge-point/id #uuid "9840265f-02bf-58fa-94fd-77fb970af297" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a290a76-571a-572b-970a-a7b94abaf475" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A sphere" :db/id #edb/ref 17592186508403} {:answer/id #uuid "27489e9f-c2eb-558f-939e-5dd34b995e02" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A cylinder" :db/id #edb/ref 17592186508450} {:answer/id #uuid "7935dad6-005d-5185-a923-ca88faca7e6d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid" :db/id #edb/ref 175