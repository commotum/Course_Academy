b/id #edb/ref 17592186372324} {:answer/id #uuid "0db9e390-7be7-5570-9d97-7b82c83ea920" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cylinder" :db/id #edb/ref 17592186372325} {:answer/id #uuid "ccc499ec-42b9-5656-8096-e0e8e6657b02" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid" :db/id #edb/ref 17592186372326} {:answer/id #uuid "9c4c25b7-56dc-50c8-9b48-ed4ad3fab3c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbolic cylinder" :db/id #edb/ref 17592186372327}] :answer-field/correct {:answer/id #uuid "ccc499ec-42b9-5656-8096-e0e8e6657b02" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid" :db/id #edb/ref 17592186372326} :answer-field/id #uuid "798f1b60-69c5-522e-b6e6-b8a464f27287" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186372322}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "959722e2-9e2f-57fb-a069-bc3b5299d0b3" :question/math-academy-id "q-164471" :question/problem "Identify the surface $z=\\frac{{x}^{2}}{4}-9{y}^{2}.$" :question/worked-solution "Recall that the equation of a hyperbolic paraboloid centered at $O$ is given by\n\n$$\nz=\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}.\n$$\n\nThus, our equation is a hyperbolic paraboloid with $a=2,\\,b=\\frac{1}{3}.$"}] [{:db/id #edb/ref 17592186508999 :knowledge-point/_questions [{:db/id #edb/ref 17592186124651 :knowledge-point/id #uuid "9840265f-02bf-58fa-94fd-77fb970af297" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4afa42bc-1bc6-55a1-836f-02d7bfe3748d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An ellipsoid" :db/id #edb/ref 17592186508499} {:answer/id #uuid "548e73f6-f1a1-5e49-a0bb-8083290eeb6e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cylinder" :db/id #edb/ref 17592186508513} {:answer/id #uuid "689b393f-cf28-5e91-8ee1-b5e413b6e464" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A parabolic cylinder" :db/id #edb/ref 17592186508546} {:answer/id #uuid "ce6d9bd6-cb84-5c92-9e76-0e8f8e539455" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbolic cylinder" :db/id #edb/ref 17592186508717} {:answer/id #uuid "efe9a0ac-dcaa-5d9e-a1d5-9f71fcce64ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cone" :db/id #edb/ref 17592186508775}] :answer-field/correct {:answer/id #uuid "548e73f6-f1a1-5e49-a0bb-8083290eeb6e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cylinder" :db/id #edb/ref 17592186508513} :answer-field/id #uuid "ca554985-239e-5793-9c9c-69a9311b055f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186508884}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fcd8e2d4-6c09-5241-9d34-1a3c5fb626c5" :question/math-academy-id "q-164478" :question/problem "Identify the following surface: \n\n$$\n25(x-1)^{2}+16(y-2)^{2}=1,\\,-\\infty <z<\\infty \n$$" :question/worked-solution "Recall that the equation of an elliptic cylinder, whose axis of symmetry is the $z$-axis, is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1,\n$$\n\nand an elliptic cylinder, whose axis of symmetry is parallel to the $z$-axis and passes through the point $({x}_{0},{y}_{0})$ in the $xy$-plane, is given by\n\n$$\n\\frac{(x-{x}_{0})^{2}}{{a}^{2}}+\\frac{(y-{y}_{0})^{2}}{{b}^{2}}=1.\n$$\n\nThus, our equation is an elliptic cylinder with the following parameters:\n\n$$\n({x}_{0},{y}_{0})=(1,2),\\,a=\\frac{1}{5},\\,b=\\frac{1}{4}.\n$$"}] [{:db/id #edb/ref 17592186284496 :knowledge-point/_questions [{:db/id #edb/ref 17592186124651 :knowledge-point/id #uuid "9840265f-02bf-58fa-94fd-77fb970af297" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b497d73-d180-5624-9234-8fcf3cd10d7a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cylinder" :db/id #edb/ref 17592186282070} {:answer/id #uuid "2f8ab53a-1d39-5af8-b2c3-17de4b8491e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A plane" :db/id #edb/ref 17592186282111} {:answer/id #uuid "949f00dc-c91c-531e-a22c-a7960aaa2b5f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A parabolic cylinder" :db/id #edb/ref 17592186282969} {:answer/id #uuid "d2ae3727-446b-5fe8-a879-e24130ca0f36" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid" :db/id #edb/ref 17592186283528} {:answer/id #uuid "dc54ee15-35f5-55e7-8fc0-e7c1307a29ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic paraboloid" :db/id #edb/ref 17592186283611}] :answer-field/correct {:answer/id #uuid "949f00dc-c91c-531e-a22c-a7960aaa2b5f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A parabolic cylinder" :db/id #edb/ref 17592186282969} :answer-field/id #uuid "ac58e3c9-8da3-52fe-a464-4680f800df3e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284234}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e7fed2b4-bf9a-591c-9b0c-e5b5d111888d" :question/math-academy-id "q-164482" :question/problem "Identify the following surface: \n\n$$\n(x+2)^{2}=-y,\\,-\\infty <z<\\infty \n$$" :question/worked-solution "Recall that the equation of a parabolic cylinder, whose axis is the $z$-axis, is given by\n\n$$\n{x}^{2}=4py,\n$$\n\nand a parabolic cylinder, shifted ${x}_{0}$ along the x-axis and ${y}_{0}$ along the y-axis, is given by\n\n$$\n(x-{x}_{0})^{2}=4p(y-{y}_{0}).\n$$\n\nThus, our equation is a parabolic cylinder with the following parameters:\n\n$$\n({x}_{0},{y}_{0})=(-2,0),\\,p=-\\frac{1}{4}.\n$$"}] [{:db/id #edb/ref 17592186284498 :knowledge-point/_questions [{:db/id #edb/ref 17592186124652 :knowledge-point/id #uuid "89fbf42b-d171-5772-87ce-cf622b720963" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders With Alternative Orientations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08b50f31-38a4-5964-91ad-572c8d4adc0d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186281764} {:answer/id #uuid "9b5664f7-6232-59c6-bc09-9ad18d4a5789" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186283042} {:answer/id #uuid "9fb16d3a-f0aa-57d7-abdb-4fff753a33c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186283078} {:answer/id #uuid "c2d5fa07-4608-5481-adad-e24a8144a577" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186283386} {:answer/id #uuid "de806c0a-5391-5f3c-9c53-8567da9fac3f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186283633}] :answer-field/correct {:answer/id #uuid "9fb16d3a-f0aa-57d7-abdb-4fff753a33c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186283078} :answer-field/id #uuid "a875bf6d-8f64-5cc1-bf44-6fc66f40a132" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284229}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e5b08a4f-9048-55ee-bcba-020f5d7e830c" :question/math-academy-id "q-164508" :question/problem "Identify the surface $\\frac{{z}^{2}}{9}+{y}^{2}-{x}^{2}=-1.$" :question/worked-solution "Recall that the equation of a hyperboloid of two sheets centered at $O$ whose axis of symmetry is the $z$-axis is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}-\\frac{{z}^{2}}{{c}^{2}}=-1.\n$$\n\nThus, a hyperboloid of two sheets centered at $O$ whose axis of symmetry is the $x$**-axis** is given by\n\n$$\n-\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}+\\frac{{z}^{2}}{{c}^{2}}=-1.\n$$\n\nTherefore, our equation is a hyperboloid of two sheets whose axis of symmetry is the $x$-axis and $a=b=1,\\,c=3.$"}] [{:db/id #edb/ref 17592186424291 :knowledge-point/_questions [{:db/id #edb/ref 17592186124652 :knowledge-point/id #uuid "89fbf42b-d171-5772-87ce-cf622b720963" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders With Alternative Orientations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "504a831f-3e0c-5d06-a8d1-be9b4ba80039" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186424285} {:answer/id #uuid "58c388d4-2855-5447-9674-2cb26cd08e75" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cone whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186424286} {:answer/id #uuid "6b38cf9a-4a51-5286-8901-945e5c525367" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186424287} {:answer/id #uuid "c5cf1042-b2aa-561a-8222-86a9a28715cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186424288} {:answer/id #uuid "d23fdde4-ee5e-5374-a3f3-a99631c545b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186424289}] :answer-field/correct {:answer/id #uuid "d23fdde4-ee5e-5374-a3f3-a99631c545b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186424289} :answer-field/id #uuid "1dd15534-4a61-5493-b4d2-d4158ff665f2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186424290}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2369f308-07c0-5960-a63e-ec69f7d6d0c6" :question/math-academy-id "q-164509" :question/problem "Identify the surface $\\frac{{x}^{2}}{4}-\\frac{{y}^{2}}{4}+{z}^{2}=-1.$" :question/worked-solution "Recall that the equation of a hyperboloid of two sheets centered at $O$ whose axis of symmetry is the $z$-axis is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}-\\frac{{z}^{2}}{{c}^{2}}=-1.\n$$\n\nThus, a hyperboloid of two sheets centered at $O$ whose axis of symmetry is the $y$**-axis** is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}+\\frac{{z}^{2}}{{c}^{2}}=-1.\n$$\n\nTherefore, our equation is a hyperboloid of two sheets whose axis of symmetry is the $y$-axis and $a=b=2,\\,c=1.$"}] [{:db/id #edb/ref 17592186381334 :knowledge-point/_questions [{:db/id #edb/ref 17592186124652 :knowledge-point/id #uuid "89fbf42b-d171-5772-87ce-cf622b720963" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders With Alternative Orientations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bb526e8-da57-518a-836e-2f345a03dfcd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186381336} {:answer/id #uuid "4778a235-b8b3-5763-b868-0f8643e9758c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic paraboloid whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186381337} {:answer/id #uuid "b38e121f-5a99-5559-b163-8f04aa87b0ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic paraboloid whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186381338} {:answer/id #uuid "f182da28-7d76-541b-bd44-0c2982e9b0a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cone whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186381339} {:answer/id #uuid "4f6c92b6-7617-5e01-91cd-a264fd7fc4d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cone whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186381340}] :answer-field/correct {:answer/id #uuid "4778a235-b8b3-5763-b868-0f8643e9758c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic paraboloid whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186381337} :answer-field/id #uuid "c433d84b-b68c-545c-b8dc-7d282d4eb95e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381335}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4204bbcc-a1ea-508e-b3fb-52f42a2c149f" :question/math-academy-id "q-164511" :question/problem "Identify the surface $y=\\frac{{x}^{2}}{16}+\\frac{{z}^{2}}{25}.$" :question/worked-solution "Recall that the equation of an elliptic paraboloid centered at $O$ whose axis of symmetry is the $z$-axis is given by\n\n$$\nz=\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}.\n$$\n\nThus, an elliptic paraboloid centered at $O$ whose axis of symmetry is the $y$**-axis** is given by\n\n$$\ny=\\frac{{x}^{2}}{{a}^{2}}+\\frac{{z}^{2}}{{c}^{2}}.\n$$\n\nTherefore, our equation is an elliptic paraboloid whose axis of symmetry is the $y$-axis and $a=4,\\,c=5.$"}] [{:db/id #edb/ref 17592186381341 :knowledge-point/_questions [{:db/id #edb/ref 17592186124652 :knowledge-point/id #uuid "89fbf42b-d171-5772-87ce-cf622b720963" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders With Alternative Orientations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "67c1753a-2ec8-57b6-90b2-f3e9290c36f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cylinder whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186381343} {:answer/id #uuid "e59d0521-9453-5d23-9d0b-63fc30e4b04c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cylinder whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186381344} {:answer/id #uuid "7adf68e0-97af-59e9-8764-045285768c7e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A parabolic cylinder whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186381345} {:answer/id #uuid "915c3324-9b00-5d77-b9be-37f4acfd5401" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cone whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186381346} {:answer/id #uuid "c4c42182-d493-5d96-aa01-f614facf8bef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A parabolic cylinder whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186381347}] :answer-field/correct {:answer/id #uuid "e59d0521-9453-5d23-9d0b-63fc30e4b04c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cylinder whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186381344} :answer-field/id #uuid "43c8dfda-6cef-5087-93b4-33239a4ddcbe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381342}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "254575a6-b38a-59ce-b27e-2f87e3bd1e11" :question/math-academy-id "q-164517" :question/problem "Identify the following surface:\n\n$$\n4{x}^{2}+{z}^{2}=1,\\,-\\infty <y<\\infty .\n$$" :question/worked-solution "Recall that the equation of an elliptic cylinder whose axis of symmetry is the $z$-axis is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\nThus, an elliptic cylinder whose axis of symmetry is the $y$**-axis** is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{z}^{2}}{{c}^{2}}=1.\n$$\n\nTherefore, our equation is an elliptic cylinder whose axis of symmetry is the $y$-axis and $a=\\frac{1}{2},\\,c=1.$"}] [{:db/id #edb/ref 17592186508945 :knowledge-point/_questions [{:db/id #edb/ref 17592186124652 :knowledge-point/id #uuid "89fbf42b-d171-5772-87ce-cf622b720963" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders With Alternative Orientations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "297953e7-2272-5f4c-8f5d-c7a5ba63a267" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cylinder whose axis is the $x$-axis" :db/id #edb/ref 17592186508453} {:answer/id #uuid "954d555a-b828-5a64-8e5f-985796f531d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A couple of planes" :db/id #edb/ref 17592186508613} {:answer/id #uuid "bc0a3e75-2d22-5d28-a469-369d9ac74889" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cylinder whose axis is the $y$-axis" :db/id #edb/ref 17592186508674} {:answer/id #uuid "e2ecc1df-530c-5316-a1e3-995deb117c17" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A parabolic cylinder whose axis is the $x$-axis" :db/id #edb/ref 17592186508751} {:answer/id #uuid "e384968e-2b68-56ca-ac8a-00e5e9f4fac0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A parabolic cylinder whose axis is the $y$-axis" :db/id #edb/ref 17592186508753}] :answer-field/correct {:answer/id #uuid "e384968e-2b68-56ca-ac8a-00e5e9f4fac0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A parabolic cylinder whose axis is the $y$-axis" :db/id #edb/ref 17592186508753} :answer-field/id #uuid "f07fcd87-80e3-5f3c-9725-097e537688aa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186508902}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "77084529-91b2-5a0f-94a4-b8df58237bc4" :question/math-academy-id "q-164545" :question/problem "Identify the following surface:\n\n$$\n{x}^{2}=-z,\\,-\\infty <y<\\infty .\n$$" :question/worked-solution "Recall that the equation of a parabolic cylinder whose axis is the $z$-axis is given by\n\n$$\n{x}^{2}=4py.\n$$\n\nThus, a parabolic cylinder whose axis is the $y$**-axis** is given by\n\n$$\n{x}^{2}=4pz.\n$$\n\nTherefore, our equation is a parabolic cylinder whose axis is the $y$-axis and $p=-\\frac{1}{4}.$"}] [{:db/id #edb/ref 17592186284511 :knowledge-point/_questions [{:db/id #edb/ref 17592186124597 :knowledge-point/id #uuid "549870ce-a18a-5a94-a9ea-f3de72aaac1f" :knowledge-point/title "Identifying Quadric Surfaces by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10cde161-28f6-55e5-986b-ad9855da614a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid centered at $(-1,2,3)$" :db/id #edb/ref 17592186281844} {:answer/id #uuid "122b7f1a-d06c-5752-b881-d3aaf0a1f656" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid centered at $(1,-2,3)$" :db/id #edb/ref 17592186281863} {:answer/id #uuid "49873a52-1e06-5d10-9048-c31a56b3f6fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An ellipsoid centered at $(1,2,-3)$" :db/id #edb/ref 17592186282313} {:answer/id #uuid "ca420948-0b66-53de-bd82-72e7dc4965ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid centered at $(1,2,-3)$" :db/id #edb/ref 17592186283457} {:answer/id #uuid "d9275452-1c1f-54aa-9f44-b0b79feef1b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic paraboloid centered at $(1,2,-3)$" :db/id #edb/ref 17592186283580}] :answer-field/correct {:answer/id #uuid "ca420948-0b66-53de-bd82-72e7dc4965ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid centered at $(1,2,-3)$" :db/id #edb/ref 17592186283457} :answer-field/id #uuid "fd434c9b-d384-57dd-8332-85e7b5ec2000" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284382}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1b66372b-0da7-5bff-8ad5-ecdf16f5fac5" :question/math-academy-id "q-164549" :question/problem "Identify the surface ${y}^{2}-{z}^{2}-x-4y-6z-4=0.$" :question/worked-solution "First, we complete the square in the $y$ and $z$ terms:\n\n$$\n\\begin{aligned}{y}^{2}-{z}^{2}-x-4y-6z-4 & =0 \\\\ ({y}^{2}-4y)-({z}^{2}+6z)-x-4 & =0 \\\\ (y-2)^{2}-4-(z+3)^{2}+9-x-4 & =0 \\\\ (y-2)^{2}-(z+3)^{2}+1-x & =0\\end{aligned}\n$$\n\nNow, by rearranging, we get the equation\n\n$$\n\\begin{aligned}(y-2)^{2}-(z+3)^{2}+1-x & =0 \\\\ (y-2)^{2}-(z+3)^{2} & =x-1\\end{aligned}\n$$\n\nThis is the equation of a hyperbolic paraboloid centered at $(1,2,-3).$"}] [{:db/id #edb/ref 17592186124833 :knowledge-point/_questions [{:db/id #edb/ref 17592186124597 :knowledge-point/id #uuid "549870ce-a18a-5a94-a9ea-f3de72aaac1f" :knowledge-point/title "Identifying Quadric Surfaces by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fa81a3d-635f-57e1-9a94-bf37f98dfd3f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cone centered at $(1,2,-2).$" :db/id #edb/ref 17592186281973} {:answer/id #uuid "2e173800-0b97-51fd-afb1-068806054b3a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic paraboloid centered at $(1,2,-2)$" :db/id #edb/ref 17592186282092} {:answer/id #uuid "64aae431-c6e3-5110-b292-f1311622a080" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid centered at $(1,2,-2).$" :db/id #edb/ref 17592186282552} {:answer/id #uuid "a78cb202-bdaf-5810-a67e-f452bfe11a16" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid centered at $(-1,-2,2).$" :db/id #edb/ref 17592186283145} {:answer/id #uuid "c435a85b-2eaa-5f57-9889-bdeb2d10e25e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic paraboloid centered at $(-1,-2,2)$" :db/id #edb/ref 17592186283401}] :answer-field/correct {:answer/id #uuid "64aae431-c6e3-5110-b292-f1311622a080" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid centered at $(1,2,-2).$" :db/id #edb/ref 17592186282552} :answer-field/id #uuid "bc88e78b-63ab-59c2-8f80-b4d0d1a43dd2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284270}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "acd3345e-478a-507e-b6c0-b18910d49c60" :question/math-academy-id "q-164554" :question/problem "Identify the surface $2{x}^{2}-4{z}^{2}-4x-y-16z-12=0.$" :question/worked-solution "First, we complete the square in the $x$ and $z$ terms:\n\n$$\n\\begin{aligned}2{x}^{2}-4{z}^{2}-4x-y-16z-12 & =0 \\\\ 2({x}^{2}-2x)-4({z}^{2}+4z)-y-12 & =0 \\\\ 2[(x-1)^{2}-1]-4[(z+2)^{2}-4]-y-12 & =0 \\\\ 2(x-1)^{2}-2-4(z+2)^{2}+16-y-12 & =0 \\\\ 2(x-1)^{2}-4(z+2)^{2}-y+2 & =0\\end{aligned}\n$$\n\nNow, by rearranging, we get the equation\n\n$$\n\\begin{aligned}2(x-1)^{2}-4(z+2)^{2}-y+2 & =0 \\\\ 2(x-1)^{2}-4(z+2)^{2} & =y-2\\end{aligned}\n$$\n\nThis is the equation of a hyperbolic paraboloid centered at $(1,2,-2).$"}] [{:db/id #edb/ref 17592186401551 :knowledge-point/_questions [{:db/id #edb/ref 17592186124597 :knowledge-point/id #uuid "549870ce-a18a-5a94-a9ea-f3de72aaac1f" :knowledge-point/title "Identifying Quadric Surfaces by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ff8dd7e4-d04f-54e0-9c82-7503faa98408" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An ellipsoid centered at $(1,-2,0)$" :db/id #edb/ref 17592186401553} {:answer/id #uuid "6ee2009b-db2c-5ad5-a30f-47e82534faf3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cone centered at $(1,-2,0)$" :db/id #edb/ref 17592186401554} {:answer/id #uuid "0eacccc9-5134-5c35-b00f-adda5251c8bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cone centered at $(1,2,1)$" :db/id #edb/ref 17592186401555} {:answer/id #uuid "1d5f9579-d5b4-564c-9ff2-31895a46959d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet centered at $(1,-2,0)$" :db/id #edb/ref 17592186401556} {:answer/id #uuid "c2873b29-87cc-5f23-93ab-b79ab215b691" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An ellipsoid centered at $(1,2,1)$" :db/id #edb/ref 17592186401557}] :answer-field/correct {:answer/id #uuid "ff8dd7e4-d04f-54e0-9c82-7503faa98408" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An ellipsoid centered at $(1,-2,0)$" :db/id #edb/ref 17592186401553} :answer-field/id #uuid "f0d3a90f-543b-5602-bf42-4796008282b3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401552}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "84fd9eec-1cf5-594c-8917-00bf240277f1" :question/math-academy-id "q-164555" :question/problem "Identify the surface ${x}^{2}+5{y}^{2}+{z}^{2}-2x+20y+11=0.$" :question/worked-solution "First, we complete the square in the $x$ and $y$ terms:\n\n$$\n\\begin{aligned}{x}^{2}+5{y}^{2}+{z}^{2}-2x+20y+11 & =0 \\\\ ({x}^{2}-2x)+5({y}^{2}+4y)+{z}^{2}+11 & =0 \\\\ (x-1)^{2}-1+5([y+2)^{2}-4]+{z}^{2}+11 & =0 \\\\ (x-1)^{2}-1+5(y+2)^{2}-20+{z}^{2}+11 & =0 \\\\ (x-1)^{2}+5(y+2)^{2}+{z}^{2}-10 & =0\\end{aligned}\n$$\n\nNow, by rearranging, we get the equation\n\n$$\n\\begin{aligned}(x-1)^{2}+5(y+2)^{2}+{z}^{2}-10 & =0 \\\\ (x-1)^{2}+5(y+2)^{2}+{z}^{2} & =10 \\\\ \\frac{(x-1)^{2}}{10}+\\frac{(y+2)^{2}}{2}+\\frac{{z}^{2}}{10} & =1.\\end{aligned}\n$$\n\nThis is the equation of an ellipsoid centered at $(1,-2,0).$"}] [{:db/id #edb/ref 17592186124947 :knowledge-point/_questions [{:db/id #edb/ref 17592186124597 :knowledge-point/id #uuid "549870ce-a18a-5a94-a9ea-f3de72aaac1f" :knowledge-point/title "Identifying Quadric Surfaces by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22046d0d-c804-5b61-a22a-97c6e40d6ecd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An ellipsoid centered at $(-1,0,2)$" :db/id #edb/ref 17592186321404} {:answer/id #uuid "3cd0e8d8-8901-5e6e-9ff0-c54ef1a6933f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An ellipsoid centered at $(1,0,2)$" :db/id #edb/ref 17592186321620} {:answer/id #uuid "4d54f44e-38a6-5842-a5f8-a881870c55f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An ellipsoid centered at $(1,0,-2)$" :db/id #edb/ref 17592186321758} {:answer/id #uuid "aefa2470-65f9-5af8-9297-ca8a552566e6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets centered at $(1,0,-2)$" :db/id #edb/ref 17592186322521} {:answer/id #uuid "e3a1ddb9-f8cb-5aef-ac4c-40464ad49aea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet centered at $(1,0,-2)$" :db/id #edb/ref 17592186322929}] :answer-field/correct {:answer/id #uuid "4d54f44e-38a6-5842-a5f8-a881870c55f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An ellipsoid centered at $(1,0,-2)$" :db/id #edb/ref 17592186321758} :answer-field/id #uuid "88dcdb73-6555-5edb-a676-ba7301ba14c2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323440}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b89a321a-d26e-5cd5-a353-0b2111467458" :question/math-academy-id "q-36015" :question/problem "Identify the surface $4{x}^{2}+8{y}^{2}+2{z}^{2}-8x+8z+4=0.$" :question/worked-solution "First, we complete the square in the $x$ and $z$ terms:\n\n$$\n\\begin{aligned}4{x}^{2}+8{y}^{2}+2{z}^{2}-8x+8z+4 & =0 \\\\ 4({x}^{2}-2x)+8{y}^{2}+2({z}^{2}+4z)+4 & =0 \\\\ 4[(x-1)^{2}-1]+8{y}^{2}+2[(z+2)^{2}-4]+4 & =0 \\\\ 4(x-1)^{2}-4+8{y}^{2}+2(z+2)^{2}-8+4 & =0 \\\\ 4(x-1)^{2}+8{y}^{2}+2(z+2)^{2}-8 & =0\\end{aligned}\n$$\n\nNow, by rearranging, we get the equation\n\n$$\n\\begin{aligned}4(x-1)^{2}+8{y}^{2}+2(z+2)^{2}-8 & =0 \\\\ 4(x-1)^{2}+8{y}^{2}+2(z+2)^{2} & =8 \\\\ \\frac{4(x-1)^{2}}{8}+\\frac{8{y}^{2}}{8}+\\frac{2(z+2)^{2}}{8} & =1 \\\\ \\frac{(x-1)^{2}}{2}+{y}^{2}+\\frac{(z+2)^{2}}{4} & =1.\\end{aligned}\n$$\n\nThis is the equation of an ellipsoid centered at $(1,0,-2).$"}] [{:db/id #edb/ref 17592186323841 :knowledge-point/_questions [{:db/id #edb/ref 17592186124597 :knowledge-point/id #uuid "549870ce-a18a-5a94-a9ea-f3de72aaac1f" :knowledge-point/title "Identifying Quadric Surfaces by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "085048d0-926b-5cca-8dfa-e564cb57a41d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet centered at $(1,1,0)$" :db/id #edb/ref 17592186321212} {:answer/id #uuid "59e40a15-5394-58c4-b924-308e77435252" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A ellipsoid centered at $(1,1,0)$" :db/id #edb/ref 17592186321857} {:answer/id #uuid "8b3ddbd9-4ea0-5b22-a0c5-e552e87f5792" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets centered at $(-1,-1,0)$" :db/id #edb/ref 17592186322257} {:answer/id #uuid "9970b56a-c70b-5b74-8a21-fe6b144df410" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet centered at $(1,-1,0)$" :db/id #edb/ref 17592186322366} {:answer/id #uuid "d89ab1f0-2498-5ec5-92c0-660bf25388b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets centered at $(1,1,0)$" :db/id #edb/ref 17592186322844}] :answer-field/correct {:answer/id #uuid "d89ab1f0-2498-5ec5-92c0-660bf25388b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets centered at $(1,1,0)$" :db/id #edb/ref 17592186322844} :answer-field/id #uuid "0ddf6d6f-5de6-54dd-86ec-e6eca647c352" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323193}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9efad2cb-65ec-5d4c-8ad1-c965cc267177" :question/math-academy-id "q-36666" :question/problem "Identify the surface $6{x}^{2}-4{y}^{2}-6{z}^{2}-12x+8y-10=0.$" :question/worked-solution "First, we complete the square in the $x$ and $y$ terms:\n\n$$\n\\begin{aligned}6{x}^{2}-4{y}^{2}-6{z}^{2}-12x+8y-10 & =0 \\\\ 6({x}^{2}-2x)-4({y}^{2}-2y)-6{z}^{2}-10 & =0 \\\\ 6[(x-1)^{2}-1]-4[(y-1)^{2}-1]-6{z}^{2}-10 & =0 \\\\ 6(x-1)^{2}-6-4(y-1)^{2}+4-6{z}^{2}-10 & =0 \\\\ 6(x-1)^{2}-4(y-1)^{2}-6{z}^{2}-12 & =0\\end{aligned}\n$$\n\nNow, by rearranging, we get the equation\n\n$$\n\\begin{aligned}6(x-1)^{2}-4(y-1)^{2}-6{z}^{2}-12 & =0 \\\\ 6(x-1)^{2}-4(y-1)^{2}-6{z}^{2} & =12 \\\\ \\frac{(x-1)^{2}}{2}-\\frac{(y-1)^{2}}{3}-\\frac{{z}^{2}}{2} & =1 \\\\ \\frac{(y-1)^{2}}{3}+\\frac{{z}^{2}}{2}-\\frac{(x-1)^{2}}{2} & =-1.\\end{aligned}\n$$\n\nThis is the equation of a hyperboloid of two sheets centered at $(1,1,0).$"}]}
