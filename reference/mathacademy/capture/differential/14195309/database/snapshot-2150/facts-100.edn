edb/ref 1078 #edb/ref 17592186321758 #edb/ref 17592186045417] [17592186323440 #edb/ref 1079 #uuid "88dcdb73-6555-5edb-a676-ba7301ba14c2" #edb/ref 17592186045417] [17592186323841 #edb/ref 1068 #edb/ref 17592186323193 #edb/ref 17592186045417] [17592186323841 #edb/ref 1069 "q-36666" #edb/ref 17592186045417] [17592186323841 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186323841 #edb/ref 1071 "Identify the surface $6{x}^{2}-4{y}^{2}-6{z}^{2}-12x+8y-10=0.$" #edb/ref 17592186045417] [17592186323841 #edb/ref 1072 #uuid "9efad2cb-65ec-5d4c-8ad1-c965cc267177" #edb/ref 17592186045417] [17592186323841 #edb/ref 1074 "First, we complete the square in the $x$ and $y$ terms:\n\n$$\n\\begin{aligned}6{x}^{2}-4{y}^{2}-6{z}^{2}-12x+8y-10 & =0 \\\\ 6({x}^{2}-2x)-4({y}^{2}-2y)-6{z}^{2}-10 & =0 \\\\ 6[(x-1)^{2}-1]-4[(y-1)^{2}-1]-6{z}^{2}-10 & =0 \\\\ 6(x-1)^{2}-6-4(y-1)^{2}+4-6{z}^{2}-10 & =0 \\\\ 6(x-1)^{2}-4(y-1)^{2}-6{z}^{2}-12 & =0\\end{aligned}\n$$\n\nNow, by rearranging, we get the equation\n\n$$\n\\begin{aligned}6(x-1)^{2}-4(y-1)^{2}-6{z}^{2}-12 & =0 \\\\ 6(x-1)^{2}-4(y-1)^{2}-6{z}^{2} & =12 \\\\ \\frac{(x-1)^{2}}{2}-\\frac{(y-1)^{2}}{3}-\\frac{{z}^{2}}{2} & =1 \\\\ \\frac{(y-1)^{2}}{3}+\\frac{{z}^{2}}{2}-\\frac{(x-1)^{2}}{2} & =-1.\\end{aligned}\n$$\n\nThis is the equation of a hyperboloid of two sheets centered at $(1,1,0).$" #edb/ref 17592186045417] [17592186372321 #edb/ref 1068 #edb/ref 17592186372322 #edb/ref 17592186045417] [17592186372321 #edb/ref 1069 "q-164471" #edb/ref 17592186045417] [17592186372321 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186372321 #edb/ref 1071 "Identify the surface $z=\\frac{{x}^{2}}{4}-9{y}^{2}.$" #edb/ref 17592186045417] [17592186372321 #edb/ref 1072 #uuid "959722e2-9e2f-57fb-a069-bc3b5299d0b3" #edb/ref 17592186045417] [17592186372321 #edb/ref 1074 "Recall that the equation of a hyperbolic paraboloid centered at $O$ is given by\n\n$$\nz=\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}.\n$$\n\nThus, our equation is a hyperbolic paraboloid with $a=2,\\,b=\\frac{1}{3}.$" #edb/ref 17592186045417] [17592186372322 #edb/ref 1075 #edb/ref 17592186372323 #edb/ref 17592186045417] [17592186372322 #edb/ref 1075 #edb/ref 17592186372324 #edb/ref 17592186045417] [17592186372322 #edb/ref 1075 #edb/ref 17592186372325 #edb/ref 17592186045417] [17592186372322 #edb/ref 1075 #edb/ref 17592186372326 #edb/ref 17592186045417] [17592186372322 #edb/ref 1075 #edb/ref 17592186372327 #edb/ref 17592186045417] [17592186372322 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186372322 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186372322 #edb/ref 1078 #edb/ref 17592186372326 #edb/ref 17592186045417] [17592186372322 #edb/ref 1079 #uuid "798f1b60-69c5-522e-b6e6-b8a464f27287" #edb/ref 17592186045417] [17592186372323 #edb/ref 1080 "An elliptic cone" #edb/ref 17592186045417] [17592186372323 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186372323 #edb/ref 1083 #uuid "b4bb51d2-3c24-5582-8535-d4bcf0185cd1" #edb/ref 17592186045417] [17592186372324 #edb/ref 1080 "An elliptic paraboloid" #edb/ref 17592186045417] [17592186372324 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186372324 #edb/ref 1083 #uuid "70c336ea-5c9f-53a0-81b3-3cc9b44928b1" #edb/ref 17592186045417] [17592186372325 #edb/ref 1080 "An elliptic cylinder" #edb/ref 17592186045417] [17592186372325 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186372325 #edb/ref 1083 #uuid "0db9e390-7be7-5570-9d97-7b82c83ea920" #edb/ref 17592186045417] [17592186372326 #edb/ref 1080 "A hyperbolic paraboloid" #edb/ref 17592186045417] [17592186372326 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186372326 #edb/ref 1083 #uuid "ccc499ec-42b9-5656-8096-e0e8e6657b02" #edb/ref 17592186045417] [17592186372327 #edb/ref 1080 "A hyperbolic cylinder" #edb/ref 17592186045417] [17592186372327 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045