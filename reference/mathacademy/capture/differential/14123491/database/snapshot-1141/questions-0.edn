ng equivalence:\n\n$$\n¬A⇒B≡¬(¬A)∨B\n$$\n\nCanceling out double negations, we reach\n\n$$\n¬(¬A)∨B≡A∨B.\n$$\n\nSo the given statement is equivalent to $A∨B.$"}] [{:db/id #edb/ref 17592186409585 :knowledge-point/_questions [{:db/id #edb/ref 17592186059689 :knowledge-point/id #uuid "0d56b033-a2c8-57c7-adde-e574d726ec78" :knowledge-point/title "Rewriting Symbolic Conditional Statements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b57f374-7974-5938-b11d-cfd731887fe8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬X∨¬Y" :db/id #edb/ref 17592186409567} {:answer/id #uuid "33e6f69b-ceb9-546e-bc81-3a178a362d67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬Y∨X" :db/id #edb/ref 17592186409568} {:answer/id #uuid "42a65b2d-e5f8-5a76-b55d-46a8613eea7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬Y∧X" :db/id #edb/ref 17592186409571} {:answer/id #uuid "a433720c-898a-5e82-b529-c83bbf9df930" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬X∧Y" :db/id #edb/ref 17592186409577} {:answer/id #uuid "d0b85a9a-afc4-5057-b50b-a3fabfd591bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬X∨Y" :db/id #edb/ref 17592186409579}] :answer-field/correct {:answer/id #uuid "33e6f69b-ceb9-546e-bc81-3a178a362d67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬Y∨X" :db/id #edb/ref 17592186409568} :answer-field/id #uuid "bc790e07-5a28-514e-aa55-ed9af585fbba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186409582}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6b7c7494-65e2-5888-808a-8604d9b7cfa1" :question/math-academy-id "q-182492" :question/problem "$Y⇒X\\,≡$" :questi