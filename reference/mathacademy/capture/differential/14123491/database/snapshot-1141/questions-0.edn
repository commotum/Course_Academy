id #edb/ref 17592186394327} {:answer/id #uuid "8476685e-e104-531e-86f2-c09e6663f600" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬X∨Y" :db/id #edb/ref 17592186394328} {:answer/id #uuid "eee8dbbe-fc4d-5c20-9c21-6ae1d839c1fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Y" :db/id #edb/ref 17592186394329} {:answer/id #uuid "77a3543d-dc9d-5f25-b6e9-2b5f550e3919" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "X∧¬Y" :db/id #edb/ref 17592186394330}] :answer-field/correct {:answer/id #uuid "eee8dbbe-fc4d-5c20-9c21-6ae1d839c1fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Y" :db/id #edb/ref 17592186394329} :answer-field/id #uuid "b6f0c2ff-63c9-5651-8370-33bd7ba743eb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394325}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0467eb40-db5b-5041-af5a-7039ef1e5d68" :question/math-academy-id "q-81891" :question/problem "Simplify the statement $¬(X∧Y)⇒Y.$" :question/worked-solution "First, note that\n\n$$\n¬(X∧Y)⇒Y≡¬(¬(X∧Y))∨Y.\n$$\n\nCanceling out double negations, we reach\n\n$$\n¬(¬(X∧Y))∨Y≡(X∧Y)∨Y.\n$$\n\nFinally, by the absorption law, we have\n\n$$\n(X∧Y)∨Y≡Y.\n$$\n\nSo the given statement is equivalent to $Y.$"}]}
