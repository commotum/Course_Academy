#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186422172} :activity/id #uuid "ad31faf4-6ba4-59e5-b6eb-0f068c9137a4" :activity/scope {:db/id #edb/ref 17592186049805 :topic/id #uuid "155403ed-fbfa-59a9-b928-e762a73145ef" :topic/math-academy-id 247} :activity/steps [{:db/id #edb/ref 17592186422172 :step/content {:db/id #edb/ref 17592186378712 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "98d0148c-06ef-5117-bace-03063dd6360d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "A∨B" :db/id #edb/ref 17592186378714} {:answer/id #uuid "f9df4014-2df2-5124-bf2b-638e928d7002" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬B∨A" :db/id #edb/ref 17592186378715} {:answer/id #uuid "39a579bf-496b-548c-bd9f-6607183041f4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬B∧A" :db/id #edb/ref 17592186378716} {:answer/id #uuid "c70b7f6e-bb66-5469-8638-e480696d51ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬A∧B" :db/id #edb/ref 17592186378717} {:answer/id #uuid "469bc761-0a98-5c2a-9f58-31c271c74501" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "A∨¬B" :db/id #edb/ref 17592186378718}] :answer-field/correct {:db/id #edb/ref 17592186378714} :answer-field/id #uuid "bef1e854-dcf0-5bf2-bce1-3c3b1e51137e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186378713}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fe611b4a-33af-5b80-a6da-077998756db6" :question/math-academy-id "q-1469" :question/problem "Simplify the statement $¬A⇒B.$" :question/worked-solution "The conditional statement $P⇒Q$ is logically equivalent to the disjunction $¬P∨Q:$\n\nSo, in this case, we have the following equivalence:\n\n$$\n¬A⇒B≡¬(¬A)∨B\n$$\n\nCanceling out double negations, we reach\n\n$$\n¬(¬A)∨B≡A∨B.\n$$\n\nSo the given statement is equivalent to $A∨B.$"} :step/id #uuid "12d4c7cd-cbe3-5cf6-98ac-5ef2b58306b0" :step/next {:db/id #edb/ref 17592186422174}} {:db/id #edb/ref 17592186422173 :step/content {:db/id #edb/ref 17592186409585 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b57f374-7974-5938-b11d-cfd731887fe8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬X∨¬Y" :db/id #edb/ref 17592186409567} {:answer/id #uuid "33e6f69b-ceb9-546e-bc81-3a178a362d67" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬Y∨X" :db/id #edb/ref 17592186409568} {:answer/id #uuid "42a65b2d-e5f8-5a76-b55d-46a8613eea7f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬Y∧X" :db/id #edb/ref 17592186409571} {:answer/id #uuid "a433720c-898a-5e82-b529-c83bbf9df930" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬X∧Y" :db/id #edb/ref 17592186409577} {:answer/id #uuid "d0b85a9a-afc4-5057-b50b-a3fabfd591bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬X∨Y" :db/id #edb/ref 17592186409579}] :answer-field/correct {:db/id #edb/ref 17592186409568} :answer-field/id #uuid "bc790e07-5a28-514e-aa55-ed9af585fbba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186409582}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6b7c7494-65e2-5888-808a-8604d9b7cfa1" :question/math-academy-id "q-182492" :question/problem "$Y⇒X\\,≡$" :question/worked-solution "The conditional statement $P⇒Q$ is logically equivalent to the disjunction $¬P∨Q:$\n\nSo, in this case, we have the following equivalence:\n\n$$\nY⇒X\\,≡\\,¬Y∨X\n$$"} :step/id #uuid "992a12e5-4030-5d06-bfe4-99bff662d13d" :step/next {:db/id #edb/ref 17592186422176}} {:db/id #edb/ref 17592186422174 :step/content {:db/id #edb/ref 17592186060412 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "911a45b8-ba13-5065-bb06-c450effaabf2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "X∨Y" :db/id #edb/ref 17592186394326} {:answer/id #uuid "95480722-7569-5083-8b58-56b83301d195" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "X∧Y" :db/id #edb/ref 17592186394327} {:answer/id #uuid "8476685e-e104-531e-86f2-c09e6663f600" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬X∨Y" :db/id #edb/ref 17592186394328} {:answer/id #uuid "eee8dbbe-fc4d-5c20-9c21-6ae1d839c1fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "Y" :db/id #edb/ref 17592186394329} {:answer/id #uuid "77a3543d-dc9d-5f25-b6e9-2b5f550e3919" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "X∧¬Y" :db/id #edb/ref 17592186394330}] :answer-field/correct {:db/id #edb/ref 17592186394329} :answer-field/id #uuid "b6f0c2ff-63c9-5651-8370-33bd7ba743eb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186394325}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0467eb40-db5b-5041-af5a-7039ef1e5d68" :question/math-academy-id "q-81891" :question/problem "Simplify the statement $¬(X∧Y)⇒Y.$" :question/worked-solution "First, note that\n\n$$\n¬(X∧Y)⇒Y≡¬(¬(X∧Y))∨Y.\n$$\n\nCanceling out double negations, we reach\n\n$$\n¬(¬(X∧Y))∨Y≡(X∧Y)∨Y.\n$$\n\nFinally, by the absorption law, we have\n\n$$\n(X∧Y)∨Y≡Y.\n$$\n\nSo the given statement is equivalent to $Y.$"} :step/id #uuid "a4bf2a7e-915f-5aaa-9350-9113ac1d5a6e" :step/next {:db/id #edb/ref 17592186422175}} {:db/id #edb/ref 17592186422175 :step/content {:db/id #edb/ref 17592186422170 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "173a22f9-03eb-5f52-84a2-64add79bb270" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "P∧(Q∧R)" :db/id #edb/ref 17592186422158} {:answer/id #uuid "2655898f-0ab3-55b9-b970-24883e6a1310" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "P∨(Q∨R)" :db/id #edb/ref 17592186422159} {:answer/id #uuid "666720f8-ee5e-5a0c-9eff-9b28566b29c6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "P∧(Q∨¬R)" :db/id #edb/ref 17592186422161} {:answer/id #uuid "be278a98-7931-527b-9249-5fe023ad7c54" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "P∧(Q∨R)" :db/id #edb/ref 17592186422166} {:answer/id #uuid "d2702799-977f-5026-b7cd-3d37fe168a4b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬P∧(Q∨R)" :db/id #edb/ref 17592186422167}] :answer-field/correct {:db/id #edb/ref 17592186422166} :answer-field/id #uuid "f19fca36-2b89-53ba-85fc-7765f2211e66" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186422169}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2bdcd5e4-a0e7-512a-97bb-f847c06388f4" :question/math-academy-id "q-82451" :question/problem "Simplify the statement $¬(P∧Q)⇒(P∧R).$" :question/worked-solution "First, note that\n\n$$\n¬(P∧Q)⇒(P∧R)≡¬(¬(P∧Q))∨(P∧R).\n$$\n\nCanceling out double negations, we reach\n\n$$\n¬(¬(P∧Q))∨(P∧R)≡(P∧Q)∨(P∧R).\n$$\n\nFinally, by the distributive laws, we have\n\n$$\n(P∧Q)∨(P∧R)≡P∧(Q∨R).\n$$\n\nSo the given statement is equivalent to $P∧(Q∨R).$"} :step/id #uuid "b4e7f46a-d2bb-5a13-8fe3-d393ec767bb7" :step/next {:db/id #edb/ref 17592186422173}} {:db/id #edb/ref 17592186422176 :step/content {:db/id #edb/ref 17592186422171 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38c9c24e-3b55-56ca-86a7-b2ce01e8f281" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "If you don't apologize, then she won't forgive you." :db/id #edb/ref 17592186422160} {:answer/id #uuid "719cf9b3-0ac6-54a8-b955-880ab8843c40" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "If you apologize, then she will forgive you." :db/id #edb/ref 17592186422162} {:answer/id #uuid "8213100f-0dc7-5d4d-b8fd-6e029e273dc5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "If you apologize, then she won't forgive you." :db/id #edb/ref 17592186422163} {:answer/id #uuid "a2794c58-1f77-5658-9986-016411aec9fd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "If you don't apologize, then she will forgive you." :db/id #edb/ref 17592186422164} {:answer/id #uuid "a2993367-1981-5e54-b3ef-99b9be03f44e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Apologize, and she will forgive you." :db/id #edb/ref 17592186422165}] :answer-field/correct {:db/id #edb/ref 17592186422160} :answer-field/id #uuid "e83d217a-41be-555a-a16a-343371ec8880" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186422168}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c4482556-1279-5932-bd2e-cbe957830200" :question/math-academy-id "q-182574" :question/problem "$\\,$ Either apologize, or she won't forgive you.\n\nWhich conditional statement is logically equivalent to the disjunctive statement above?" :question/worked-solution "Let's denote by $A$ and $B$ the following statements:\n\n- $A:$ Apologize.\n\n- $B:$ She won't forgive you.\n\nThen, our initial statement can be written as $A∨B,$ which is logically equivalent to \n\n$$\n¬A⇒B.\n$$\n\nThe negation of $A$ can be written as\n\n- $¬A:$ You don't apologize.\n\nTherefore, the given statement is logically equivalent to the following:\n\n$\\,$ If you don't apologize, then she won't forgive you.\n\n**Note**: \n\nUsing the word \"Either\" helps clarify that the sentence structure presents two alternatives and is particularly useful when employing the disjunctive form $(¬P∨Q)$ in conversational or formal English. So, the phrase effectively conveys that one of the two stated conditions will hold true."} :step/id #uuid "ec1c4e29-ed0c-5082-8077-e13084a4137b"}] :activity/title "Logical Equivalence with Conditional Statements" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186422157}]}
