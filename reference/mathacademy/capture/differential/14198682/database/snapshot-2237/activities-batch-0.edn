#{[{:activity/expected-seconds 600.0 :activity/first-step {:db/id #edb/ref 17592186189095} :activity/id #uuid "35cac34d-08b2-58e8-9601-d836880ca5df" :activity/scope {:db/id #edb/ref 17592186048466 :topic/id #uuid "a1f79e8d-032f-59f2-bf48-1433971eb75e" :topic/math-academy-id 3856} :activity/steps [{:db/id #edb/ref 17592186189081 :step/content {:db/id #edb/ref 17592186188276 :knowledge-point/canonical-example {:db/id #edb/ref 17592186188211 :question/id #uuid "136ceff6-b85b-5686-a69b-5d39ff70d3dd" :question/math-academy-id "e-9191"} :knowledge-point/id #uuid "1892c89c-8343-57ff-8c7e-e6edb35bb7c6" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048317} {:db/id #edb/ref 17592186048325} {:db/id #edb/ref 17592186049412}] :knowledge-point/questions [{:db/id #edb/ref 17592186188536} {:db/id #edb/ref 17592186188537} {:db/id #edb/ref 17592186478400} {:db/id #edb/ref 17592186478429} {:db/id #edb/ref 17592186478433} {:db/id #edb/ref 17592186478440} {:db/id #edb/ref 17592186515528} {:db/id #edb/ref 17592186515546}] :knowledge-point/title "Finding the Expected Value of a Discrete Random Variable From a Joint Distribution"} :step/id #uuid "24560547-2ea6-5ad9-9bbb-ff6eb26fcf18" :step/math-academy-id 34281 :step/next {:db/id #edb/ref 17592186189120}} {:db/id #edb/ref 17592186189095 :step/content {:db/id #edb/ref 17592186189371 :tutorial/content "To compute the expected value of a discrete random variable $X$ given a joint mass function $f(x,y),$ we must first find its marginal mass function $f_X.$ Once the marginal mass function is known, we can then compute $\\textrm{E}[X]$ using the formula\n\n$$\n\\textrm{E}[X]\n= \\sum\\limits_{i=1}^n x_i \\, f_X(x_i).\n$$\n\nFor example, consider the joint probability mass function $f(x,y)$ for the discrete random variables $X$ and $Y,$ shown below.\n\n| $f$ | $Y=1$ | $Y=2$ |\n| --- | --- | --- |\n| $X=1$ | $0.05$ | $0.15$ |\n| $X=2$ | $0.7$ | $0.1$ |\n\nRecall that the marginal distribution for $X$ corresponds to the row totals, and the marginal distribution for $Y$ corresponds to the column totals. Since we're only interested in the expected value of $X,$ let's compute the row totals only.\n\n| $f$ | $Y=1$ | $Y=2$ | $f_X$ |\n| --- | --- | --- | --- |\n| $X=1$ | $0.05$ | $0.15$ | $\\bbox[2pt,Gainsboro]{\\color{blue}0.20}$ |\n| $X=2$ | $0.7$ | $0.1$ | $\\bbox[2pt,Gainsboro]{\\color{blue}0.80}$ |\n\nTherefore, the marginal mass function of $X$ is as follows:\n\n| $x$ | $1$ | $2$ |\n| --- | --- | --- |\n| $f_X(x)$ | $0.20$ | $0.80$ |\n|  |  |  |\n\nWe can now compute the expected value of $X\\mathbin{:}$\n\n$$\n\\begin{aligned}\\text{E}[X] & ={\\sum }_{i=1}^{n}{x}_{i}\\,{f}_{X}({x}_{i}) \\\\  & =1\\cdot 0.2+2\\cdot 0.8 \\\\  & =0.2+1.6 \\\\  & =1.8\\end{aligned}\n$$\n\nTherefore, we conclude that $\\textrm{E}[X] = 1.8.$" :tutorial/id #uuid "0512a52f-ccb2-56a2-b436-f49ec9cb4916" :tutorial/math-academy-id 6253 :tutorial/title "Introduction"} :step/id #uuid "3c190be0-696c-59a8-9758-3931bd0f72ac" :step/math-academy-id 37912 :step/next {:db/id #edb/ref 17592186189081}} {:db/id #edb/ref 17592186189115 :step/content {:db/id #edb/ref 17592186188296 :knowledge-point/canonical-example {:db/id #edb/ref 17592186188003 :question/id #uuid "f32f96bc-b02a-54fe-b370-8a384c6ae67e" :question/math-academy-id "e-10102"} :knowledge-point/id #uuid "7447ccfe-83a7-59d4-8386-c74a3ab47b89" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049553} {:db/id #edb/ref 17592186049801}] :knowledge-point/questions [{:db/id #edb/ref 17592186188538} {:db/id #edb/ref 17592186188564} {:db/id #edb/ref 17592186478374} {:db/id #edb/ref 17592186478405} {:db/id #edb/ref 17592186478427} {:db/id #edb/ref 17592186478451} {:db/id #edb/ref 17592186478463} {:db/id #edb/ref 17592186515544}] :knowledge-point/title "Finding the Expected Value of a Continuous Random Variable From a Joint Distribution"} :step/id #uuid "595885fa-5146-5a3a-8643-30f924026039" :step/math-academy-id 38102} {:db/id #edb/ref 17592186189120 :step/content {:db/id #edb/ref 17592186189382 :tutorial/content "To compute the expected value of a *continuous* random variable $X$ given a joint density function $f(x,y),$ we must first find its marginal density function $f_X.$ Once the marginal density function is known, we can then compute $\\textrm{E}[X]$ using the formula\n\n$$\n\\textrm{E}[X]\n= \\int_{-\\infty}^\\infty x \\cdot f_X(x)\\,\\textrm d x.\n$$\n\nLet's see an example." :tutorial/id #uuid "9ed12512-4300-57a6-b68d-2cacfa2f3488" :tutorial/math-academy-id 6320 :tutorial/title "Continuous Random Variables"} :step/id #uuid "daffc16b-1f95-542f-8a1a-225169b2cb6e" :step/math-academy-id 38236 :step/next {:db/id #edb/ref 17592186189115}}] :activity/title "Computing Expected Values From Joint Distributions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186188451}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186515682} :activity/id #uuid "827978e3-994c-5c29-a170-80728a4bfa3b" :activity/scope {:db/id #edb/ref 17592186048466 :topic/id #uuid "a1f79e8d-032f-59f2-bf48-1433971eb75e" :topic/math-academy-id 3856} :activity/steps [{:db/id #edb/ref 17592186515628 :step/content {:db/id #edb/ref 17592186188538 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b91c41cc-51b6-5e81-94b5-47e53eefedb5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15" :db/id #edb/ref 17592186185509} {:answer/id #uuid "de2b3a92-bca2-5955-9f57-985d493d01c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186185510} {:answer/id #uuid "1149e63f-1791-5d3e-9b6e-48e6553bdacc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11" :db/id #edb/ref 17592186185511} {:answer/id #uuid "364e336f-8c62-54e4-a088-dac539c2c563" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186185512} {:answer/id #uuid "5f3f60e0-b192-58fc-95d2-6460f2bd7ca5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186185513}] :answer-field/correct {:db/id #edb/ref 17592186185511} :answer-field/id #uuid "e5b94b62-4b4a-5bbe-b08a-36b39f4d7d53" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186185508}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "24fd9d96-138b-563d-a252-06faa557f32d" :question/math-academy-id "q-110420" :question/problem "Let $X$ and $Y$ be two continuous random variables with the joint probability density function\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{3}{2}{x}^{2}y, & 0\\le x\\le 1,\\,0\\le y\\le 2, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nGiven that $\\text{E}[X]=\\frac{3}{4},$ find $\\text{E}[4X+6Y].$" :question/worked-solution "We're given $\\text{E}[X].$ So, we first need to compute $\\text{E}[Y].$\n\nThe marginal density function for $Y$ when $0\\le y\\le 2$ is \n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{3}{2}{x}^{2}y\\,\\text{d}x \\\\  & =\\frac{1}{2}y[{x}^{3}]_{0}^{1} \\\\  & =\\frac{1}{2}y({1}^{3}-0) \\\\  & =\\frac{y}{2}.\\end{aligned}\n$$\n\nTherefore, the  expected value of $Y$ is \n\n$$\n\\begin{aligned}\\text{E}[Y] & ={\\int }_{-\\infty }^{\\infty }y\\,{f}_{Y}(y)\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}y\\cdot \\frac{y}{2}\\,\\text{d}y \\\\  & =\\frac{1}{2}{\\int }_{0}^{2}{y}^{2}\\,\\text{d}y \\\\  & =\\frac{1}{6}[{y}^{3}]_{0}^{2} \\\\  & =\\frac{1}{6}(8-0) \\\\  & =\\frac{4}{3}.\\end{aligned}\n$$\n\nFinally, we obtain \n\n$$\n\\begin{aligned}\\text{E}[4X+6Y] & =4\\,\\text{E}[X]+6\\,\\text{E}[Y] \\\\  & =4(\\frac{3}{4})+6(\\frac{4}{3}) \\\\  & =3+8 \\\\  & =11.\\end{aligned}\n$$"} :step/id #uuid "0dca7aaf-6bc5-5c2a-8c78-4a283b1cbdad" :step/next {:db/id #edb/ref 17592186515660}} {:db/id #edb/ref 17592186515660 :step/content {:db/id #edb/ref 17592186515544 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "320777af-ae37-523c-bacf-e28e66480cc3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186514983} {:answer/id #uuid "7852e317-6684-5e8f-b211-c3d2fd1b2920" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{15}" :db/id #edb/ref 17592186515122} {:answer/id #uuid "9cdb3a18-70b7-5be8-85e6-7d754574d6e7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186515204} {:answer/id #uuid "bd2ebd72-45b1-5c05-82b9-a266f54fe224" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{15}" :db/id #edb/ref 17592186515274} {:answer/id #uuid "d551241c-84d6-5150-94ac-c0e6751dcdf3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186515322}] :answer-field/correct {:db/id #edb/ref 17592186515274} :answer-field/id #uuid "b3819eb9-9cd0-5d3c-852e-6d38178d3c62" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186515482}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "57c74959-06e0-5008-b9fc-e618f65747e4" :question/math-academy-id "q-143584" :question/problem "Let $X$ and $Y$ be two continuous random variables with the joint probability density function\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{2}{9}({x}^{3}+{y}^{3}), & 0\\le x\\le 1,\\,0\\le y\\le 2, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nGiven that $\\text{E}[Y]=\\frac{23}{15},$ find $\\text{E}[3X-Y].$" :question/worked-solution "We're given $\\text{E}[Y].$ So, we first need to compute $\\text{E}[X].$\n\nThe marginal density function for $X$ when $0\\le x\\le 1$ is \n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y \\\\  & ={\\int }_{0}^{2}\\frac{2}{9}({x}^{3}+{y}^{3})\\,\\text{d}y \\\\  & =\\frac{2}{9}{[{x}^{3}y+\\frac{{y}^{4}}{4}]}_{y=0}^{y=2} \\\\  & =\\frac{2}{9}(2{x}^{3}+\\frac{{2}^{4}}{4}-0) \\\\  & =\\frac{4}{9}({x}^{3}+2).\\end{aligned}\n$$\n\nTherefore, the  expected value of $X$ is \n\n$$\n\\begin{aligned}\\text{E}[X] & ={\\int }_{-\\infty }^{\\infty }x\\,{f}_{X}(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}x\\cdot \\frac{4}{9}({x}^{3}+2)\\,\\text{d}x \\\\  & =\\frac{4}{9}{\\int }_{0}^{1}({x}^{4}+2x)\\,\\text{d}x \\\\  & =\\frac{4}{9}{[\\frac{{x}^{5}}{5}+{x}^{2}]}_{0}^{1} \\\\  & =\\frac{4}{9}(\\frac{1}{5}+1-0) \\\\  & =\\frac{8}{15}.\\end{aligned}\n$$\n\nFinally, we obtain \n\n$$\n\\begin{aligned}\\text{E}[3X-Y] & =3\\,\\text{E}[X]+(-1)\\,\\text{E}[Y] \\\\  & =3\\,(\\frac{8}{15})-(\\frac{23}{15}) \\\\  & =\\frac{1}{15}.\\end{aligned}\n$$"} :step/id #uuid "6611e889-3327-54b2-b32f-c65fbae23e9b" :step/next {:db/id #edb/ref 17592186515710}} {:db/id #edb/ref 17592186515682 :step/content {:db/id #edb/ref 17592186188536 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a558b7e5-c3d1-52a0-958f-c16f3262e4d9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.15" :db/id #edb/ref 17592186185497} {:answer/id #uuid "ee07b541-1156-514e-8a52-3c4d8d4449aa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4.92" :db/id #edb/ref 17592186185498} {:answer/id #uuid "45b5da22-03ed-50ae-a11c-ba7ab0a6c909" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.9" :db/id #edb/ref 17592186185499} {:answer/id #uuid "507f77fc-0914-533e-8a1f-50a54da9727f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.2" :db/id #edb/ref 17592186185500} {:answer/id #uuid "7fe1fb56-e4d8-56d2-b8c3-17038ceabee2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.09" :db/id #edb/ref 17592186185501}] :answer-field/correct {:db/id #edb/ref 17592186185497} :answer-field/id #uuid "7131eaa9-a5b7-5fc9-aee0-c41dbcd479c5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186185496}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "98c1d783-b707-50c1-a161-c295243e0cf9" :question/math-academy-id "q-110403" :question/problem "Given the joint probability distribution for two discrete random variables $X$ and $Y$ below, find $\\text{E}[Y].$\n\n| $f$ | $Y=0$ | $Y=1$ | $Y=2$ |\n| --- | --- | --- | --- |\n| $X=0$ | $0.05$ | $0.1$ | $0.25$ |\n| $X=1$ | $0.25$ | $0.15$ | $0.2$ |" :question/requires-calculator true :question/worked-solution "Recall that the marginal distribution for $X$ corresponds to the row totals, and the marginal distribution for $Y$ corresponds to the column totals.\n\n| $f(x,y)$ | $Y=0$ | $Y=1$ | $Y=2$ | ${f}_{X}$ |\n| --- | --- | --- | --- | --- |\n| $X=0$ | $0.05$ | $0.1$ | $0.25$ | $…$ |\n| $X=1$ | $0.25$ | $0.15$ | $0.2$ | $…$ |\n| ${f}_{Y}$ | $0.3$ | $0.25$ | $0.45$ | $1$ |\n\nTherefore, the probability mass function for  $Y$ is given by the following table:\n\n| $y$ | $0$ | $1$ | $2$ |\n| --- | --- | --- | --- |\n| ${f}_{Y}(y)$ | $0.3$ | $0.25$ | $0.45$ |\n\nFinally, the  expected value of $Y$ is \n\n$$\n\\begin{aligned}\\text{E}[Y] & ={\\sum }_{i=1}^{n}{y}_{i}\\,{f}_{Y}({y}_{i}) \\\\  & =0\\cdot 0.3+1\\cdot 0.25+2\\cdot 0.45 \\\\  & =0+0.25+0.9 \\\\  & =1.15.\\end{aligned}\n$$"} :step/id #uuid "b0485605-8f6d-579c-978c-558250074dc2" :step/next {:db/id #edb/ref 17592186515628}} {:db/id #edb/ref 17592186515704 :step/content {:db/id #edb/ref 17592186515528 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "54921f49-41bd-59ea-87fa-1aa8a31bf9f6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1.4" :db/id #edb/ref 17592186515060} {:answer/id #uuid "8af359a3-0397-596f-9263-82e98df0c5e7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1.5" :db/id #edb/ref 17592186515162} {:answer/id #uuid "b6ef201f-91de-5739-8423-ca5f69f9f69b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1.8" :db/id #edb/ref 17592186515259} {:answer/id #uuid "c6bc73a6-19e3-5079-8075-c87f32448b75" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1.2" :db/id #edb/ref 17592186515295} {:answer/id #uuid "e6ed4ece-6571-5aa6-a239-9c83bba0bbb7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1.6" :db/id #edb/ref 17592186515357}] :answer-field/correct {:db/id #edb/ref 17592186515060} :answer-field/id #uuid "c8ce17d4-130c-5b9e-a7e1-458cb727bad8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186515493}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1e85b0be-111d-5b57-b950-c149f90f77dc" :question/math-academy-id "q-149599" :question/problem "Given the joint probability distribution for two discrete random variables $X$ and $Y$ below, find $\\text{E}[Y].$\n\n| $f$ | $Y=-2$ | $Y=-1$ |\n| --- | --- | --- |\n| $X=1$ | $0.1$ | $0.3$ |\n| $X=2$ | $0.25$ | $0.2$ |\n| $X=3$ | $0.05$ | $0.1$ |" :question/worked-solution "Recall that the marginal distribution for $X$ corresponds to the row totals, and the marginal distribution for $Y$ corresponds to the column totals.\n\n| $f(x,y)$ | $Y=-2$ | $Y=-1$ | ${f}_{X}$ |\n| --- | --- | --- | --- |\n| $X=1$ | $0.1$ | $0.3$ | $…$ |\n| $X=2$ | $0.25$ | $0.2$ | $…$ |\n| $X=3$ | $0.05$ | $0.1$ | $…$ |\n| ${f}_{Y}$ | $0.4$ | $0.6$ | $1$ |\n\nTherefore, the probability mass function for  $Y$ is given by the following table:\n\n| $y$ | $-2$ | $-1$ |\n| --- | --- | --- |\n| ${f}_{Y}(y)$ | $0.4$ | $0.6$ |\n\nFinally, the  expected value of $Y$ is \n\n$$\n\\begin{aligned}\\text{E}[Y] & ={\\sum }_{i=1}^{n}{y}_{i}\\,{f}_{Y}({y}_{i}) \\\\  & =(-2)\\cdot 0.4+(-1)\\cdot 0.6 \\\\  & =-0.8-0.6 \\\\  & =-1.4.\\end{aligned}\n$$"} :step/id #uuid "e610be17-d713-5476-8573-4ab202853156"} {:db/id #edb/ref 17592186515710 :step/content {:db/id #edb/ref 17592186515546 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "221fa59d-39a2-5c91-a249-8862c6b794b6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7.4" :db/id #edb/ref 17592186514950} {:answer/id #uuid "3e0b2a8d-ea50-5575-ae8b-df8e61b4fd0a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9.2" :db/id #edb/ref 17592186515005} {:answer/id #uuid "82e3153b-16a6-58ac-b3a6-8a86fae4ce60" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9.05" :db/id #edb/ref 17592186515143} {:answer/id #uuid "a02fd45f-1410-54c4-bb64-034b16bd73d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6.5" :db/id #edb/ref 17592186515213} {:answer/id #uuid "a166d431-6741-566e-a4d1-3e91ef5f0388" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5.9" :db/id #edb/ref 17592186515215}] :answer-field/correct {:db/id #edb/ref 17592186514950} :answer-field/id #uuid "5c3d7ec3-2b65-5d8c-8b98-80722d885c87" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186515443}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "58e1bdfb-9550-5950-b391-e8892b95af10" :question/math-academy-id "q-143604" :question/problem "Given the joint probability distribution for two discrete random variables $X$ and $Y$ below, find $\\text{E}[2X+4Y].$\n\n| $f$ | $Y=-2$ | $Y=0$ | $Y=2$ | $Y=4$ |\n| --- | --- | --- | --- | --- |\n| $X=-1$ | $0.05$ | $0.1$ | $0.05$ | $0.1$ |\n| $X=1$ | $0.1$ | $0.05$ | $0.15$ | $0.05$ |\n| $X=3$ | $0.05$ | $0.05$ | $0.15$ | $0.1$ |" :question/worked-solution "Recall that the marginal distribution for $X$ corresponds to the row totals, and the marginal distribution for $Y$ corresponds to the column totals.\n\n| $f$ | $Y=-2$ | $Y=0$ | $Y=2$ | $Y=4$ | ${f}_{X}$ |\n| --- | --- | --- | --- | --- | --- |\n| $X=-1$ | $0.05$ | $0.1$ | $0.05$ | $0.1$ | $0.3$ |\n| $X=1$ | $0.1$ | $0.05$ | $0.15$ | $0.05$ | $0.35$ |\n| $X=3$ | $0.05$ | $0.05$ | $0.15$ | $0.1$ | $0.35$ |\n| ${f}_{Y}$ | $0.2$ | $0.2$ | $0.35$ | $0.25$ | $1$ |\n\nTherefore,  the probability mass functions for  $X$ and $Y$ are given by the following tables:\n\n<table align=\"center\">\n<tbody><tr>\n<th>\n<table align=\"center\" cellpadding=\"10\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"30\">$x$</td>\n<td align=\"center\">$-1$</td>\n<td align=\"center\">$1$</td>\n<td align=\"center\">$3$</td>\n</tr>\n<tr>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"30\">${f}_{X}(x)$</td>\n<td align=\"center\">$0.3$</td>\n<td align=\"center\">$0.35$</td>\n<td align=\"center\">$0.35$</td>\n</tr>\n</tbody></table>\n<p></p></th>\n<th width=\"50\"></th>\n<th>\n<table align=\"center\" cellpadding=\"10\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"30\">$y$</td>\n<td align=\"center\">$-2$</td>\n<td align=\"center\">$0$</td>\n<td align=\"center\">$2$</td>\n<td align=\"center\">$4$</td>\n</tr>\n<tr>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"30\">${f}_{Y}(y)$</td>\n<td align=\"center\">$0.2$</td>\n<td align=\"center\">$0.2$</td>\n<td align=\"center\">$0.35$</td>\n<td align=\"center\">$0.25$</td>\n</tr>\n</tbody></table>\n<p></p></th>\n</tr>\n</tbody></table>\n\nNow, we can compute the expected values for $X$ and $Y:$\n\n$$\n\\begin{aligned}\\text{E}[X] & ={\\sum }_{i=1}^{n}{x}_{i}\\,{f}_{X}({x}_{i}) \\\\  & =(-1)\\cdot 0.3+1\\cdot 0.35+3\\cdot 0.35 \\\\  & =-0.3+0.35+1.05 \\\\  & =1.1\\end{aligned}\n$$\n\n$$\n\\begin{aligned}\\text{E}[Y] & ={\\sum }_{i=1}^{n}{y}_{i}\\,{f}_{Y}({y}_{i}) \\\\  & =(-2)\\cdot 0.2+0\\cdot 0.2+2\\cdot 0.35+4\\cdot 0.25 \\\\  & =-0.4+0+0.7+1 \\\\  & =1.3.\\end{aligned}\n$$\n\nFinally, using the properties of expectation, we obtain \n\n$$\n\\begin{aligned}\\text{E}[2X+4Y] & =2\\text{E}[X]+4\\,\\text{E}[Y] \\\\  & =2(1.1)+4(1.3) \\\\  & =2.2+5.2 \\\\  & =7.4.\\end{aligned}\n$$"} :step/id #uuid "febeff6c-5ada-57a3-a1f8-8bc1079ec0d0" :step/next {:db/id #edb/ref 17592186515704}}] :activity/title "Computing Expected Values From Joint Distributions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186514860}]}
