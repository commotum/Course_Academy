b/ref 17592186045498 #edb/ref 17592186045417] [17592186515295 #edb/ref 1083 #uuid "c6bc73a6-19e3-5079-8075-c87f32448b75" #edb/ref 17592186045417] [17592186515322 #edb/ref 1080 "\\frac{1}{3}" #edb/ref 17592186045417] [17592186515322 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186515322 #edb/ref 1083 #uuid "d551241c-84d6-5150-94ac-c0e6751dcdf3" #edb/ref 17592186045417] [17592186515357 #edb/ref 1080 "-1.6" #edb/ref 17592186045417] [17592186515357 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186515357 #edb/ref 1083 #uuid "e6ed4ece-6571-5aa6-a239-9c83bba0bbb7" #edb/ref 17592186045417] [17592186515443 #edb/ref 1075 #edb/ref 17592186514950 #edb/ref 17592186045417] [17592186515443 #edb/ref 1075 #edb/ref 17592186515005 #edb/ref 17592186045417] [17592186515443 #edb/ref 1075 #edb/ref 17592186515143 #edb/ref 17592186045417] [17592186515443 #edb/ref 1075 #edb/ref 17592186515213 #edb/ref 17592186045417] [17592186515443 #edb/ref 1075 #edb/ref 17592186515215 #edb/ref 17592186045417] [17592186515443 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186515443 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186515443 #edb/ref 1078 #edb/ref 17592186514950 #edb/ref 17592186045417] [17592186515443 #edb/ref 1079 #uuid "5c3d7ec3-2b65-5d8c-8b98-80722d885c87" #edb/ref 17592186045417] [17592186515482 #edb/ref 1075 #edb/ref 17592186514983 #edb/ref 17592186045417] [17592186515482 #edb/ref 1075 #edb/ref 17592186515122 #edb/ref 17592186045417] [17592186515482 #edb/ref 1075 #edb/ref 17592186515204 #edb/ref 17592186045417] [17592186515482 #edb/ref 1075 #edb/ref 17592186515274 #edb/ref 17592186045417] [17592186515482 #edb/ref 1075 #edb/ref 17592186515322 #edb/ref 17592186045417] [17592186515482 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186515482 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186515482 #edb/ref 1078 #edb/ref 17592186515274 #edb/ref 17592186045417] [17592186515482 #edb/ref 1079 #uuid "b3819eb9-9cd0-5d3c-852e-6d38178d3c62" #edb/ref 17592186045417] [17592186515493 #edb/ref 1075 #edb/ref 17592186515060 #edb/ref 17592186045417] [17592186515493 #edb/ref 1075 #edb/ref 17592186515162 #edb/ref 17592186045417] [17592186515493 #edb/ref 1075 #edb/ref 17592186515259 #edb/ref 17592186045417] [17592186515493 #edb/ref 1075 #edb/ref 17592186515295 #edb/ref 17592186045417] [17592186515493 #edb/ref 1075 #edb/ref 17592186515357 #edb/ref 17592186045417] [17592186515493 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186515493 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186515493 #edb/ref 1078 #edb/ref 17592186515060 #edb/ref 17592186045417] [17592186515493 #edb/ref 1079 #uuid "c8ce17d4-130c-5b9e-a7e1-458cb727bad8" #edb/ref 17592186045417] [17592186515528 #edb/ref 1068 #edb/ref 17592186515493 #edb/ref 17592186045417] [17592186515528 #edb/ref 1069 "q-149599" #edb/ref 17592186045417] [17592186515528 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186515528 #edb/ref 1071 "Given the joint probability distribution for two discrete random variables $X$ and $Y$ below, find $\\text{E}[Y].$\n\n| $f$ | $Y=-2$ | $Y=-1$ |\n| --- | --- | --- |\n| $X=1$ | $0.1$ | $0.3$ |\n| $X=2$ | $0.25$ | $0.2$ |\n| $X=3$ | $0.05$ | $0.1$ |" #edb/ref 17592186045417] [17592186515528 #edb/ref 1072 #uuid "1e85b0be-111d-5b57-b950-c149f90f77dc" #edb/ref 17592186045417] [17592186515528 #edb/ref 1074 "Recall that the marginal distribution for $X$ corresponds to the row totals, and the marginal distribution for $Y$ corresponds to the column totals.\n\n| $f(x,y)$ | $Y=-2$ | $Y=-1$ | ${f}_{X}$ |\n| --- | --- | --- | --- |\n| $X=1$ | $0.1$ | $0.3$ | $…$ |\n| $X=2$ | $0.25$ | $0.2$ | $…$ |\n| $X=3$ | $0.05$ | $0.1$ | $…$ |\n| ${f}_{Y}$ | $0.4$ | $0.6$ | $1$ |\n\nTherefore, the probability mass function for  $Y$ is given by the following table:\n\n| $y$ | $-2$ | $-1$ |\n| --- | --- | --- |\n| ${f}_{Y}(y)$ | $0.4$ | $0.6$ |\n\nFinally, the  expected value of $Y$ is \n\n$$\n\\begin{aligned}\\text{E}[Y] & ={\\sum }_{i=1}^{n}{y}_{i}\\,{f}_{Y}({y}_{i}) \\\\  & =(-2)\\cdot 0.4+(-1)\\cdot 0.6 \\\\  & =-0.8-0.6 \\\\  & =-1.4.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186515544 #edb/ref 1068 #edb/ref 17592186515482 #edb/ref 17592186045417] [17592186515544 #edb/ref 1069 "q-143584" #edb/ref 17592186045417] [17592186515544 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186515544 #edb/ref 1071 "Let $X$ and $Y$ be two continuous random variables with the joint probability density function\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{2}{9}({x}^{3}+{y}^{3}), & 0\\le x\\le 1,\\,0\\le y\\le 2, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nGiven that $\\text{E}[Y]=\\frac{23}{15},$ find $\\text{E}[3X-Y].$" #edb/ref 17592186045417] [17592186515544 #edb/ref 1072 #uuid "57c74959-06e0-5008-b9fc-e618f65747e4" #edb/ref 17592186045417] [17592186515544 #edb/ref 1074 "We're given $\\text{E}[Y].$ So, we first need to compute $\\text{E}[X].$\n\nThe marginal density function for $X$ when $0\\le x\\le 1$ is \n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y \\\\  & ={\\int }_{0}^{2}\\frac{2}{9}({x}^{3}+{y}^{3})\\,\\text{d}y \\\\  & =\\frac{2}{9}{[{x}^{3}y+\\frac{{y}^{4}}{4}]}_{y=0}^{y=2} \\\\  & =\\frac{2}{9}(2{x}^{3}+\\frac{{2}^{4}}{4}-0) \\\\  & =\\frac{4}{9}({x}^{3}+2).\\end{aligned}\n$$\n\nTherefore, the  expected value of $X$ is \n\n$$\n\\begin{aligned}\\text{E}[X] & ={\\int }_{-\\infty }^{\\infty }x\\,{f}_{X}(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}x\\cdot \\frac{4}{9}({x}^{3}+2)\\,\\text{d}x \\\\  & =\\frac{4}{9}{\\int }_{0}^{1}({x}^{4}+2x)\\,\\text{d}x \\\\  & =\\frac{4}{9}{[\\frac{{x}^{5}}{5}+{x}^{2}]}_{0}^{1} \\\\  & =\\frac{4}{9}(\\frac{1}{5}+1-0) \\\\  & =\\frac{8}{15}.\\end{aligned}\n$$\n\nFinally, we obtain \n\n$$\n\\begin{aligned}\\text{E}[3X-Y] & =3\\,\\text{E}[X]+(-1)\\,\\text{E}[Y] \\\\  & =3\\,(\\frac{8}{15})-(\\frac{23}{15}) \\\\  & =\\frac{1}{15}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186515546 #edb/ref 1068 #edb/ref 17592186515443 #edb/ref 17592186045417] [17592186515546 #edb/ref 1069 "q-143604" #edb/ref 17592186045417] [17592186515546 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186515546 #edb/ref 1071 "Given the joint probability distribution for two discrete random variables $X$ and $Y$ below, find $\\text{E}[2X+4Y].$\n\n| $f$ | $Y=-2$ | $Y=0$ | $Y=2$ | $Y=4$ |\n| --- | --- | --- | --- | --- |\n| $X=-1$ | $0.05$ | $0.1$ | $0.05$ | $0.1$ |\n| $X=1$ | $0.1$ | $0.05$ | $0.15$ | $0.05$ |\n| $X=3$ | $0.05$ | $0.05$ | $0.15$ | $0.1$ |" #edb/ref 17592186045417] [17592186515546 #edb/ref 1072 #uuid "58e1bdfb-9550-5950-b391-e8892b95af10" #edb/ref 17592186045417] [17592186515546 #edb/ref 1074 "Recall that the marginal distribution for $X$ corresponds to the row totals, and the marginal distribution for $Y$ corresponds to the column totals.\n\n| $f$ | $Y=-2$ | $Y=0$ | $Y=2$ | $Y=4$ | ${f}_{X}$ |\n| --- | --- | --- | --- | --- | --- |\n| $X=-1$ | $0.05$ | $0.1$ | $0.05$ | $0.1$ | $0.3$ |\n| $X=1$ | $0.1$ | $0.05$ | $0.15$ | $0.05$ | $0.35$ |\n| $X=3$ | $0.05$ | $0.05$ | $0.15$ | $0.1$ | $0.35$ |\n| ${f}_{Y}$ | $0.2$ | $0.2$ | $0.35$ | $0.25$ | $1$ |\n\nTherefore,  the probability mass functions for  $X$ and $Y$ are given by the following tables:\n\n<table align=\"center\">\n<tbody><tr>\n<th>\n<table align=\"center\" cellpadding=\"10\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"30\">$x$</td>\n<td align=\"center\">$-1$</td>\n<td align=\"center\">$1$</td>\n<td align=\"center\">$3$</td>\n</tr>\n<tr>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"30\">${f}_{X}(x)$</td>\n<td align=\"center\">$0.3$</td>\n<td align=\"center\">$0.35$</td>\n<td align=\"center\">$0.35$</td>\n</tr>\n</tbody></table>\n<p></p></th>\n<th width=\"50\"></th>\n<th>\n<table align=\"center\" cellpadding=\"10\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"30\">$y$</td>\n<td align=\"center\">$-2$</td>\n<td align=\"center\">$0$</td>\n<td align=\"center\">$2$</td>\n<td align=\"center\">$4$</td>\n</tr>\n<tr>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"30\">${f}_{Y}(y)$</td>\n<td align=\"center\">$0.2$</td>\n<td align=\"center\">$0.2$</td>\n<td align=\"center\">$0.35$</td>\n<td align=\"center\">$0.25$</td>\n</tr>\n</tbody></table>\n<p></p></th>\n</tr>\n</tbody></table>\n\nNow, we can compute the expected values for $X$ and $Y:$\n\n$$\n\\begin{aligned}\\text{E}[X] & ={\\sum }_{i=1}^{n}{x}_{i}\\,{f}_{X}({x}_{i}) \\\\  & =(-1)\\cdot 0.3+1\\cdot 0.35+3\\cdot 0.35 \\\\  & =-0.3+0.35+1.05 \\\\  & =1.1\\end{aligned}\n$$\n\n$$\n\\begin{aligned}\\text{E}[Y] & ={\\sum }_{i=1}^{n}{y}_{i}\\,{f}_{Y}({y}_{i}) \\\\  & =(-2)\\cdot 0.2+0\\cdot 0.2+2\\cdot 0.35+4\\cdot 0.25 \\\\  & =-0.4+0+0.7+1 \\\\  & =1.3.\\end{aligned}\n$$\n\nFinally, using the properties of expectation, we obtain \n\n$$\n\\begin{aligned}\\text{E}[2X+4Y] & =2\\text{E}[X]+4\\,\\text{E}[Y] \\\\  & =2(1.1)+4(1.3) \\\\  & =2.2+5.2 \\\\  & =7.4.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186515628 #edb/ref 1058 #edb/ref 17592186515660 #edb/ref 17592186045417] [17592186515628 #edb/ref 1062 #uuid "0dca7aaf-6bc5-5c2a-8c78-4a283b1cbdad" #edb/ref 17592186045417] [17592186515628 #edb/ref 1063 #edb/ref 17592186188538 #edb/ref 17592186045417] [17592186515660 #edb/ref 1058 #edb/ref 17592186515710 #edb/ref 17592186045417] [17592186515660 #edb/ref 1062 #uuid "6611e889-3327-54b2-b32f-c65fbae23e9b" #edb/ref 17592186045417] [17592186515660 #edb/ref 1063 #edb/ref 17592186515544 #edb/ref 17592186045417] [17592186515682 #edb/ref 1058 #edb/ref 17592186515628 #edb/ref 17592186045417] [17592186515682 #edb/ref 1062 #uuid "b0485605-8f6d-579c-978c-558250074dc2" #edb/ref 17592186045417] [17592186515682 #edb/ref 1063 #edb/ref 17592186188536 #edb/ref 17592186045417] [17592186515704 #edb/ref 1062 #uuid "e610be17-d713-5476-8573-4ab202853156" #edb/ref 17592186045417] [17592186515704 #edb/ref 1063 #edb/ref 17592186515528 #edb/ref 17592186045417] [17592186515710 #edb/ref 1058 #edb/ref 17592186515704 #edb/ref 17592186045417] [17592186515710 #edb/ref 1062 #uuid "febeff6c-5ada-57a3-a1f8-8bc1079ec0d0" #edb/ref 17592186045417] [17592186515710 #edb/ref 1063 #edb/ref 17592186515546 #edb/ref 17592186045417]}
