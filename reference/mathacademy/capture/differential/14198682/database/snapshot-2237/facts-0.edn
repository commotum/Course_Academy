b/ref 17592186045417] [17592186188296 #edb/ref 1038 #edb/ref 17592186515544 #edb/ref 17592186045417] [17592186188296 #edb/ref 1039 "Finding the Expected Value of a Continuous Random Variable From a Joint Distribution" #edb/ref 17592186045417] [17592186188296 #edb/ref 1041 #edb/ref 17592186188003 #edb/ref 17592186045417] [17592186188296 #edb/ref 1042 #uuid "7447ccfe-83a7-59d4-8386-c74a3ab47b89" #edb/ref 17592186045417] [17592186188451 #edb/ref 1043 #edb/ref 17592186189081 #edb/ref 17592186045417] [17592186188451 #edb/ref 1043 #edb/ref 17592186189095 #edb/ref 17592186045417] [17592186188451 #edb/ref 1043 #edb/ref 17592186189115 #edb/ref 17592186045417] [17592186188451 #edb/ref 1043 #edb/ref 17592186189120 #edb/ref 17592186045417] [17592186188451 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186188451 #edb/ref 1045 "Computing Expected Values From Joint Distributions" #edb/ref 17592186045417] [17592186188451 #edb/ref 1046 #edb/ref 17592186189095 #edb/ref 17592186045417] [17592186188451 #edb/ref 1049 #edb/ref 17592186048466 #edb/ref 17592186045417] [17592186188451 #edb/ref 1050 600.0 #edb/ref 17592186045417] [17592186188451 #edb/ref 1053 #uuid "35cac34d-08b2-58e8-9601-d836880ca5df" #edb/ref 17592186045417] [17592186188536 #edb/ref 1068 #edb/ref 17592186185496 #edb/ref 17592186045417] [17592186188536 #edb/ref 1069 "q-110403" #edb/ref 17592186045417] [17592186188536 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186188536 #edb/ref 1071 "Given the joint probability distribution for two discrete random variables $X$ and $Y$ below, find $\\text{E}[Y].$\n\n| $f$ | $Y=0$ | $Y=1$ | $Y=2$ |\n| --- | --- | --- | --- |\n| $X=0$ | $0.05$ | $0.1$ | $0.25$ |\n| $X=1$ | $0.25$ | $0.15$ | $0.2$ |" #edb/ref 17592186045417] [17592186188536 #edb/ref 1072 #uuid "98c1d783-b707-50c1-a161-c295243e0cf9" #edb/ref 17592186045417] [17592186188536 #edb/ref 1073 true #edb/ref 17592186045417] [17592186188536 #edb/ref 1074 "Recall that the marginal distribution for $X$ corresponds to the row totals, and the marginal distribution for $Y$ corresponds to the column totals.\n\n| $f(x,y)$ | $Y=0$ | $Y=1$ | $Y=2$ | ${f}_{X}$ |\n| --- | --- | --- | --- | --- |\n| $X=0$ | $0.05$ | $0.1$ | $0.25$ | $…$ |\n| $X=1$ | $0.25$ | $0.15$ | $0.2$ | $…$ |\n| ${f}_{Y}$ | $0.3$ | $0.25$ | $0.45$ | $1$ |\n\nTherefore, the probability mass function for  $Y$ is given by the following table:\n\n| $y$ | $0$ | $1$ | $2$ |\n| --- | --- | --- | --- |\n| ${f}_{Y}(y)$ | $0.3$ | $0.25$ | $0.45$ |\n\nFinally, the  expected value of $Y$ is \n\n$$\n\\begin{aligned}\\text{E}[Y] & ={\\sum }_{i=1}^{n}{y}_{i}\\,{f}_{Y}({y}_{i}) \\\\  & =0\\cdot 0.3+1\\cdot 0.25+2\\cdot 0.45 \\\\  & =0+0.25+0.9 \\\\  & =1.15.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186188538 #edb/ref 1068 #edb/ref 17592186185508 #edb/ref 17592186045417] [17592186188538 #edb/ref 1069 "q-110420" #edb/ref 17592186045417] [17592186188538 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186188538 #edb/ref 1071 "Let $X$ and $Y$ be two continuous random variables with the joint probability density function\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{3}{2}{x}^{2}y, & 0\\le x\\le 1,\\,0\\le y\\le 2, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nGiven that $\\text{E}[X]=\\frac{3}{4},$ find $\\text{E}[4X+6Y].$" #edb/ref 17592186045417] [17592186188538 #edb/ref 1072 #uuid "24fd9d96-138b-563d-a252-06faa557f32d" #edb/ref 17592186045417] [17592186188538 #edb/ref 1074 "We're given $\\text{E}[X].$ So, we first need to compute $\\text{E}[Y].$\n\nThe marginal density function for $Y$ when $0\\le y\\le 2$ is \n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{3}{2}{x}^{2}y\\,\\text{d}x \\\\  & =\\frac{1}{2}y[{x}^{3}]_{0}^{1} \\\\  & =\\frac{1}{2}y({1}^{3}-0) \\\\  & =\\frac{y}{2}.\\end{aligned}\n$$\n\nTherefore, the  expected value of $Y$ is \n\n$$\n\\begin{aligned}\\text{E}[Y] & ={\\int }_{-\\infty }^{\\infty }y\\,{f}_{Y}(y)\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}y\\cdot \\frac{y}{2}\\,\\text{d}y \\\\  & =\\frac{1}{2}{\\int }_{0}^{2}{y}^{2}\\,\\text{d}y \\\\  & =\\frac{1}{6}[{y}^{3}]_{0}^{2} \\\\  & =\\frac{1}{6}(8-0) \\\\  & =\\frac{4}{3}.\\end{aligned}\n$$\n\nFinally, we obtain \n\n$$\n\\begin{aligned}\\text{E}[4X+6Y] & =4\\,\\text{E}[X]+6\\,\\text{E}[Y] \\\\  & =4(\\frac{3}{4})+6(\\frac{4}{3}) \\\\  & =3+8 \\\\  & =11.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186189081 #edb/ref 1058 #edb/ref 17592186189120 #edb/ref 17592186045417] [17592186189081 #edb/ref 1061 34281 #edb/ref 17592186045417] [17592186189081 #edb/ref 1062 #uuid "24560547-2ea6-5ad9-9bbb-ff6eb26fcf18" #edb/ref 17592186045417] [17592186189081 #edb/ref 1063 #edb/ref 17592186188276 #edb/ref 17592186045417] [17592186189095 #edb/ref 1058 #edb/ref 17592186189081 #edb/ref 17592186045417] [17592186189095 #edb/ref 1061 37912 #edb/ref 17592186045417] [17592186189095 #edb/ref 1062 #uuid "3c190be0-696c-59a8-9758-3931bd0f72ac" #edb/ref 17592186045417] [17592186189095 #edb/ref 1063 #edb/ref 17592186189371 #edb/ref 17592186045417] [17592186189115 #edb/ref 1061 38102 #edb/ref 17592186045417] [17592186189115 #edb/ref 1062 #uuid "595885fa-5146-5a3a-8643-30f924026039" #edb/ref 17592186045417] [17592186189115 #edb/ref 1063 #edb/ref 17592186188296 #edb/ref 17592186045417] [17592186189120 #edb/ref 1058 #edb/ref 17592186189115 #edb/ref 17592186045417] [17592186189120 #edb/ref 1061 38236 #edb/ref 17592186045417] [17592186189120 #edb/ref 1062 #uuid "daffc16b-1f95-542f-8a1a-225169b2cb6e" #edb/ref 17592186045417] [17592186189120 #edb/ref 1063 #edb/ref 17592186189382 #edb/ref 17592186045417] [17592186189371 #edb/ref 1064 "To compute the expected value of a discrete random variable $X$ given a joint mass function $f(x,y),$ we must first find its marginal mass function $f_X.$ Once the marginal mass function is known, we can then compute $\\textrm{E}[X]$ using the formula\n\n$$\n\\textrm{E}[X]\n= \\sum\\limits_{i=1}^n x_i \\, f_X(x_i).\n$$\n\nFor example, consider the joint probability mass function $f(x,y)$ for the discrete random variables $X$ and $Y,$ shown below.\n\n| $f$ | $Y=1$ | $Y=2$ |\n| --- | --- | --- |\n| $X=1$ | $0.05$ | $0.15$ |\n| $X=2$ | $0.7$ | $0.1$ |\n\nRecall that the marginal distribution for $X$ corresponds to the row totals, and the marginal distribution for $Y$ corresponds to the column totals. Since we're only interested in the expected value of $X,$ let's compute the row totals only.\n\n| $f$ | $Y=1$ | $Y=2$ | $f_X$ |\n| --- | --- | --- | --- |\n| $X=1$ | $0.05$ | $0.15$ | $\\bbox[2pt,Gainsboro]{\\color{blue}0.20}$ |\n| $X=2$ | $0.7$ | $0.1$ | $\\bbox[2pt,Gainsboro]{\\color{blue}0.80}$ |\n\nTherefore, the marginal mass function of $X$ is as follows:\n\n| $x$ | $1$ | $2$ |\n| --- | --- | --- |\n| $f_X(x)$ | $0.20$ | $0.80$ |\n|  |  |  |\n\nWe can now compute the expected value of $X\\mathbin{:}$\n\n$$\n\\begin{aligned}\\text{E}[X] & ={\\sum }_{i=1}^{n}{x}_{i}\\,{f}_{X}({x}_{i}) \\\\  & =1\\cdot 0.2+2\\cdot 0.8 \\\\  & =0.2+1.6 \\\\  & =1.8\\end{aligned}\n$$\n\nTherefore, we conclude that $\\textrm{E}[X] = 1.8.$" #edb/ref 17592186045417] [17592186189371 #edb/ref 1065 6253 #edb/ref 17592186045417] [17592186189371 #edb/ref 1066 #uuid "0512a52f-ccb2-56a2-b436-f49ec9cb4916" #edb/ref 17592186045417] [17592186189371 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186189382 #edb/ref 1064 "To compute the expected value of a *continuous* random variable $X$ given a joint density function $f(x,y),$ we must first find its marginal density function $f_X.$ Once the marginal density function is known, we can then compute $\\textrm{E}[X]$ using the formula\n\n$$\n\\textrm{E}[X]\n= \\int_{-\\infty}^\\infty x \\cdot f_X(x)\\,\\textrm d x.\n$$\n\nLet's see an example." #edb/ref 17592186045417] [17592186189382 #edb/ref 1065 6320 #edb/ref 17592186045417] [17592186189382 #edb/ref 1066 #uuid "9ed12512-4300-57a6-b68d-2cacfa2f3488" #edb/ref 17592186045417] [17592186189382 #edb/