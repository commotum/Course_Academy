b/id #edb/ref 17592186119848 :knowledge-point/id #uuid "1d847ec9-c379-5013-ab77-a9b92dc8ca27" :knowledge-point/title "Identifying the Matrix With a Given Rank by Inspection"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ded1fff-9517-5427-baeb-9e6226b1a956" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=[\\begin{aligned}5 & -1 \\\\ 0 & 3\\end{aligned}]" :db/id #edb/ref 17592186425022} {:answer/id #uuid "c56ff60f-9868-5d39-a38d-a5e22b0c66cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A=[\\begin{aligned}2 & 1 & 0 & 1 & 0 \\\\ 0 & -1 & 0 & 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186425038} {:answer/id #uuid "c9c751ce-2bdb-5742-bae8-b0d52ba986db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "C=[\\begin{aligned}2 & 1 & 3 & 1 & 0 \\\\ 0 & -1 & 0 & 2 & 1 \\\\ 0 & 0 & 0 & 0 & 2 \\\\ 0 & 0 & 0 & 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186425039} {:answer/id #uuid "dc879383-a282-5736-9d82-b936dcdd959d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "E=[\\begin{aligned}-1 & 2 \\\\ 0 & 1 \\\\ 0 & 0 \\\\ 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186425043} {:answer/id #uuid "fd4e3c03-ae1c-5130-988c-c64b1fac85e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D=[\\begin{aligned}3 & 2 & 1 \\\\ 0 & -1 & 2 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186425046}] :answer-field/correct {:answer/id #uuid "c9c751ce-2bdb-5742-bae8-b0d52ba986db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "C=[\\begin{aligned}2 & 1 & 3 & 1 & 0 \\\\ 0 & -1 & 0 & 2 & 1 \\\\ 0 & 0 & 0 & 0 & 2 \\\\ 0 & 0 & 0 & 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186425039} :answer-field/id #uuid "6c3c987d-47cd-5e40-a273-46742d15f9a1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186425049}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8c046845-0154-54e8-9266-c14fc31a0fbc" :question/math-academy-id "q-79560" :question/problem "Which of the following matrices has a rank of $3?$" :question/worked-solution "First, notice that a matrix of rank $3$ must have at least $3$ columns and at least $3$ rows. \nSo, we disregard the following matrices:\n\n- $A$ since it has only $2$ rows.\n\n- $B$ since it has only $2$ rows (and only $2$ columns).\n\n- $E$ since it has only $2$ columns.\n\nAlso, the matrix must have $3$ pivot columns. As we can see, the matrix $C$ has exactly $3$ pivot columns, while the matrix $D$ has only $2$ pivot columns. So, $\\text{rank}(C)=3$ and $\\text{rank}(D)=2.$\n\nTherefore, the correct answer is the matrix $C.$"}] [{:db/id #edb/ref 17592186348236 :knowledge-point/_questions [{:db/id #edb/ref 17592186119848 :knowledge-point/id #uuid "1d847ec9-c379-5013-ab77-a9b92dc8ca27" :knowledge-point/title "Identifying the Matrix With a Given Rank by Inspection"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29a67d7d-2e25-5590-abde-d1402ec76c73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D=[\\begin{aligned}1 & -1 & 0 & -2 & 2 \\\\ 0 & 2 & 1 & -1 & 0 \\\\ 0 & 0 & 3 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186345721} {:answer/id #uuid "29f33f9e-9e08-5db0-b36d-be6f1dd9ec29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A=[\\begin{aligned}-4 & 3 & -1 \\\\ 0 & 2 & -3 \\\\ 0 & 0 & -2\\end{aligned}]" :db/id #edb/ref 17592186345724} {:answer/id #uuid "2c9743d4-2101-5a2c-afc8-37f657505898" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "C=[\\begin{aligned}1 & 2 & -1 \\\\ 0 & 1 & -2 \\\\ 0 & 0 & 1 \\\\ 0 & 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186345751} {:answer/id #u