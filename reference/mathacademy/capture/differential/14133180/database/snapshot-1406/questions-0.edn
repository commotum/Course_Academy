tions [{:db/id #edb/ref 17592186087659 :knowledge-point/id #uuid "a9faf6d8-0c06-5bf4-bc41-6d68d3d414c6" :knowledge-point/title "Identifying When a Circle Does Not Intersect an Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35ea24b1-8fec-5fbf-bac8-b70728f1a2c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\sqrt{5},0)" :db/id #edb/ref 17592186433786} {:answer/id #uuid "82ec903c-18e3-515b-833a-9f806a1c6d50" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The circle has no $x$-intercepts" :db/id #edb/ref 17592186433792} {:answer/id #uuid "8fe743b2-ec2c-5b87-bcb3-7c47f54196e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(2+\\sqrt{5},0)$ and $(2-\\sqrt{5},0)$" :db/id #edb/ref 17592186433796} {:answer/id #uuid "c1e68abc-b50c-59f6-b845-cd12375b06b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,0)" :db/id #edb/ref 17592186433802} {:answer/id #uuid "dd1e41fb-ca63-5f83-99ef-f59b500e7871" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,0)" :db/id #edb/ref 17592186433806}] :answer-field/correct {:answer/id #uuid "82ec903c-18e3-515b-833a-9f806a1c6d50" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The circle has no $x$-intercepts" :db/id #edb/ref 17592186433792} :answer-field/id #uuid "22dc9cbf-6ba7-5e19-980b-fcba481da97a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186433812}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3df7ca0c-a7bc-5b5f-9b3f-4b5360131dc4" :question/math-academy-id "q-79042" :question/problem "Calculate the $x$-intercepts of the circle $(x-2)^{2}+(y-3)^{2}=4$" :question/worked-solution "We must have $y=0$ at the $x$-intercepts.  \n\nSo, we need to substitute $y=0$ into the equation of the circle and solve the resulting equation for $x,$ if possible:\n\n$$\n\\begin{aligned}(x-2)^{2}+(y-3)^{2} & =4 \\\\ (x-2)^{2}+(0-3)^{2} & =4 \\\\ (x-2)^{2}+9 & =4 \\\\ (x-2)^{2} & =-5.\\end{aligned}\n$$\n\nSince $(x-2)^{2}\\ge 0$ for all values of $x,$ there is no $x$ such that $(x-2)^{2}=-5.$ Therefore, circle has no $x$-intercepts, as shown below.\n\n![](images/4b/4b56ce205a771f9683aefb65f1953aab927cf3388f7f9375a6146dc4300a67a9.png)"}]}
