h the Y-Axis"} :step/id #uuid "5aaacc41-f5a7-59fe-a267-6e005f6a2cc8" :step/math-academy-id 10949 :step/next {:db/id #edb/ref 17592186088470}} {:db/id #edb/ref 17592186088468 :step/content {:db/id #edb/ref 17592186087659 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087467 :question/id #uuid "905861f1-14b5-59f8-980e-6bd962740620" :question/math-academy-id "e-3232"} :knowledge-point/id #uuid "a9faf6d8-0c06-5bf4-bc41-6d68d3d414c6" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049668}] :knowledge-point/questions [{:db/id #edb/ref 17592186088442} {:db/id #edb/ref 17592186088443} {:db/id #edb/ref 17592186278280} {:db/id #edb/ref 17592186278281} {:db/id #edb/ref 17592186278282} {:db/id #edb/ref 17592186405153} {:db/id #edb/ref 17592186433818} {:db/id #edb/ref 17592186433820}] :knowledge-point/title "Identifying When a Circle Does Not Intersect an Axis"} :step/id #uuid "2e4c0ded-b8fe-5ff0-82c8-766b31842f8d" :step/math-academy-id 10950} {:db/id #edb/ref 17592186088470 :step/content {:db/id #edb/ref 17592186087660 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087468 :question/id #uuid "31c41251-e19b-5933-b5f5-6cee31f7f633" :question/math-academy-id "e-3233"} :knowledge-point/id #uuid "e6f0c89e-fe19-5aaf-9f85-b5f0ff7a344e" :knowledge-point/questions [{:db/id #edb/ref 17592186088212} {:db/id #edb/ref 17592186088213} {:db/id #edb/ref 17592186275369} {:db/id #edb/ref 17592186345084} {:db/id #edb/ref 17592186354617} {:db/id #edb/ref 17592186354618} {:db/id #edb/ref 17592186401076} {:db/id #edb/ref 17592186433819} {:db/id #edb/ref 17592186433822}] :knowledge-point/title "Calculating the Intersection of a Circle With the Y-Axis"} :step/id #uuid "cd93a6cd-77b4-505c-b858-f85dfe81d0f8" :step/math-academy-id 10952 :step/next {:db/id #edb/ref 17592186088468}}] :activity/title "Calculating Circle Intercepts" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186087915}]}
