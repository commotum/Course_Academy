4e-97c3-2bf871a01466" :answer/id #uuid "44f524b7-2c29-504e-97c3-2bf871a01466" :answer/type :answer.type/text :answer/value "$(0,-3)$ and $(0,3)$" :db/ensure [:answer/validate]} {:db/id "answer-e5d85322-d824-50ae-9040-be749e7db932" :answer/id #uuid "e5d85322-d824-50ae-9040-be749e7db932" :answer/type :answer.type/text :answer/value "$(0,-4)$ and $(0,4)$" :db/ensure [:answer/validate]} {:db/id "answer-22988273-1e27-5f75-910a-b7e682e7ba27" :answer/id #uuid "22988273-1e27-5f75-910a-b7e682e7ba27" :answer/type :answer.type/text :answer/value "$(0,-\\sqrt{10})$ and $(0,\\sqrt{10})$" :db/ensure [:answer/validate]} {:db/id "answer-44ea5368-7419-5357-8d4c-960daf0aea88" :answer/id #uuid "44ea5368-7419-5357-8d4c-960daf0aea88" :answer/type :answer.type/text :answer/value "$(0,-\\sqrt{5})$ and $(0,\\sqrt{5})$" :db/ensure [:answer/validate]} {:db/id "question-85a89c6d-abe9-53d6-8315-1fd338cd6cd0" :question/id #uuid "85a89c6d-abe9-53d6-8315-1fd338cd6cd0" :question/math-academy-id "q-160269" :question/problem "Calculate the $x$-intercepts of the circle $(x+2)^{2}+(y+2)^{2}=2$" :question/worked-solution "We must have $y=0$ at the $x$-intercepts.  \n\nSo, we need to substitute $y=0$ into the equation of the circle and solve the resulting equation for $x,$ if possible:\n\n$$\n\\begin{aligned}(x+2)^{2}+(y+2)^{2} & =2 \\\\ (x+2)^{2}+(0+2)^{2} & =2 \\\\ (x+2)^{2}+4 & =2 \\\\ (x+2)^{2} & =-2.\\end{aligned}\n$$\n\nSince $(x+2)^{2}\\ge 0$ for all values of $x,$ there is no $x$ such that $(x+2)^{2}=-2.$ Therefore, circle has no $x$-intercepts, as shown below.\n\n![](images/e5/e57f57f3e0cff36d9cc89a8889fa2f7fa5f4e8f9ceb5703c2d16f4ea16f38174.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-e83768a9-6631-50c8-9658-6b75b2051928"] :db/ensure [:question/validate]} {:db/id "answer-field-e83768a9-6631-50c8-9658-6b75b2051928" :answer-field/id #uuid "e83768a9-6631-50c8-9658-6b75b2051928" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c68ed067-a5a1-5fbb-a232-736d2bd95ef9" :answer-field/choices ["answer-0d31dc8e-0c35-5fd0-abcd-c7628cdd0a04" "answer-97ea5387-37c5-52b8-8290-aadaa4e30264" "answer-f1ce6827-b377-535f-a602-e31fd5957524" "answer-11293f8e-d2f0-55f3-9e5f-9ac836a5188b" "answer-c68ed067-a5a1-5fbb-a232-736d2bd95ef9"] :db/ensure [:answer-field/validate]} {:db/id "answer-0d31dc8e-0c35-5fd0-abcd-c7628cdd0a04" :answer/id #uuid "0d31dc8e-0c35-5fd0-abcd-c7628cdd0a04" :answer/type :answer.type/math :answer/value "(-2,0)" :db/ensure [:answer/validate]} {:db/id "answer-97ea5387-37c5-52b8-8290-aadaa4e30264" :answer/id #uuid "97ea5387-37c5-52b8-8290-aadaa4e30264" :answer/type :answer.type/math :answer/value "(2,0)" :db/ensure [:answer/validate]} {:db/id "answer-f1ce6827-b377-535f-a602-e31fd5957524" :answer/id #uuid "f1ce6827-b377-535f-a602-e31fd5957524" :answer/type :answer.type/text :answer/value "$(-2,0)$ and $(0,0)$" :db/ensure [:answer/validate]} {:db/id "answer-11293f8e-d2f0-55f3-9e5f-9ac836a5188b" :answer/id #uuid "11293f8e-d2f0-55f3-9e5f-9ac836a5188b" :answer/type :answer.type/text :answer/value "$(-\\sqrt{2},0)$ and $(\\sqrt{2},0)$" :db/ensure [:answer/validate]} {:db/id "answer-c68ed067-a5a1-5fbb-a232-736d2bd95ef9" :answer/id #uuid "c68ed067-a5a1-5fbb-a232-736d2bd95ef9" :answer/type :answer.type/text :answer/value "The circle has no $x$-intercepts" :db/ensure [:answer/validate]} {:db/id "question-3df7ca0c-a7bc-5b5f-9b3f-4b5360131dc4" :question/id #uuid "3df7ca0c-a7bc-5b5f-9b3f-4b5360131dc4" :question/math-academy-id "q-79042" :question/problem "Calculate the $x$-intercepts of the circle $(x-2)^{2}+(y-3)^{2}=4$" :question/worked-solution "We must have $y=0$ at the $x$-intercepts.  \n\nSo, we need to substitute $y=0$ into the equation of the circle and solve the resulting equation for $x,$ if possible:\n\n$$\n\\begin{aligned}(x-2)^{2}+(y-3)^{2} & =4 \\\\ (x-2)^{2}+(0-3)^{2} & =4 \\\\ (x-2)^{2}+9 & =4 \\\\ (x-2)^{2} & =-5.\\end{aligned}\n$$\n\nSince $(x-2)^{2}\\ge 0$ for all values of $x,$ there is no $x$ such that $(x-2)^{2}=-5.$ Therefore, circle has no $x$-intercepts, as shown below.\n\n![](images/4b/4b56ce205a771f9683aefb65f1953aab927cf3388f7f9375a6146dc4300a67a9.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-22dc9cbf-6ba7-5e19-980b-fcba481da97a"] :db/ensure [:question/validate]} {:db/id "answer-field-22dc9cbf-6ba7-5e19-980b-fcba481da97a" :answer-field/id #uuid "22dc9cbf-6ba7-5e19-980b-fcba481da97a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-82ec903c-18e3-515b-833a-9f806a1c6d50" :answer-field/choices ["answer-c1e68abc-b50c-59f6-b845-cd12375b06b7" "answer-dd1e41fb-ca63-5f83-99ef-f59b500e7871" "answer-35ea24b1-8fec-5fbf-bac8-b70728f1a2c3" "answer-8fe743b2-ec2c-5b87-bcb3-7c47f54196e2" "answer-82ec903c-18e3-515b-833a-9f806a1c6d50"] :db/ensure [:answer-field/validate]} {:db/id "answer-c1e68abc-b50c-59f6-b845-cd12375b06b7" :answer/id #uuid "c1e68abc-b50c-59f6-b845-cd12375b06b7" :answer/type :answer.type/math :answer/value "(2,0)" :db/ensure [:answer/validate]} {:db/id "answer-dd1e41fb-ca63-5f83-99ef-f59b500e7871" :answer/id #uuid "dd1e41fb-ca63-5f83-99ef-f59b500e7871" :answer/type :answer.type/math :answer/value "(3,0)" :db/ensure [:answer/validate]} {:db/id "answer-35ea24b1-8fec-5fbf-bac8-b70728f1a2c3" :answer/id #uuid "35ea24b1-8fec-5fbf-bac8-b70728f1a2c3" :answer/type :answer.type/math :answer/value "(\\sqrt{5},0)" :db/ensure [:answer/validate]} {:db/id "answer-8fe743b2-ec2c-5b87-bcb3-7c47f54196e2" :answer/id #uuid "8fe743b2-ec2c-5b87-bcb3-7c47f54196e2" :answer/type :answer.type/text :answer/value "$(2+\\sqrt{5},0)$ and $(2-\\sqrt{5},0)$" :db/ensure [:answer/validate]} {:db/id "answer-82ec903c-18e3-515b-833a-9f806a1c6d50" :answer/id #uuid "82ec903c-18e3-515b-833a-9f806a1c6d50" :answer/type :answer.type/text :answer/value "The circle has no $x$-intercepts" :db/ensure [:answer/validate]} {:db/id 17592186088875 :tutorial/content "Consider the circle with equation \n\n$$\n(x - 2)^2 + (y - 1)^2 = 3^2,\n$$\n\nas shown below. How can we calculate the points where the circle intercepts the $x$-axis?\n\n![](images/6b/6b80fa5fc106a8a78ba46e71ad8649da731a14777449b092f982e34138353b0a.png)\n\n  \n\nRemember, when the circle intercepts the $x$-axis, we must have $y = 0.$\n\nTherefore, to find the $x$-intercepts of the circle, we need to set $y = 0$ in the equation of the circle and solve for $x$ as follows:\n\n$$\n\\begin{aligned}(x-2)^{2}+(y-1)^{2} & ={3}^{2} \\\\ (x-2)^{2}+(0-1)^{2} & ={3}^{2} \\\\ (x-2)^{2}+1 & =9 \\\\ (x-2)^{2} & =8 \\\\ x-2 & =\\pm \\sqrt{8} \\\\ x-2 & =\\pm 2\\sqrt{2} \\\\ x & =2\\pm 2\\sqrt{2}\\end{aligned}\n$$\n\nTherefore, the circle intercepts the $x$-axis at $(2-2\\sqrt{2},0)$ and $(2+2\\sqrt{2},0).$" :db/ensure [:tutorial/validate]} {:db/id 17592186088876 :tutorial/content "Consider the circle with equation \n![](images/04/04942c0d9aa30a9c5730d1e16a580d9352f71ae539072e45a9c027f2c2a24e23.svg)\nas shown below. How can we calculate the points where the circle intercepts the ![](images/1d/1d9b846cface9f9348e4081a0dd87dd254bf26663c12aa0d1a15aa24d2393261.svg)-axis?\n\n![](images/9f/9f288ed4c4bf402576e0af193128e3a72866b4333be46b7cd7294e0e703cc8d4.png)\n\n \n\nWhen the circle intercepts the ![](images/1d/1d9b846cface9f9348e4081a0dd87dd254bf26663c12aa0d1a15aa24d2393261.svg)-axis, we must have ![](images/29/29da0a4605613d6a7fd9e7bb2f4fb45cbabe8a47109971682844cb222486a20c.svg)\n\nTherefore, to find the ![](images/1d/1d9b846cface9f9348e4081a0dd87dd254bf26663c12aa0d1a15aa24d2393261.svg)-intercepts of the circle, we need to set ![](images/51/51a24269e3f466a9c7b886bcab70a365576b28534e323a55aec8b3ebe8d14571.svg) in the equation of the circle and solve for ![](images/1d/1d9b846cface9f9348e4081a0dd87dd254bf26663c12aa0d1a15aa24d2393261.svg) as follows:\n\n![](images/c0/c0d3f8274a97b11ec1b29e9ac6f1594f153a558c54d40f3b0fe0a11cfc92ed34.svg)\n\nSo, the circle intercepts the ![](images/1d/1d9b846cface9f9348e4081a0dd87dd254bf26663c12aa0d1a15aa24d2393261.svg)-axis at ![](images/02/02009543b06c29977f90e4d9650dae5609d3dc21630daf575e791866a131b661.svg) and ![](images/80/809ca990d60556175140938d3a8f1c4a52048f8993899089f6f1dce4ea6b69aa.svg)" :db/ensure [:tutorial/validate]} {:db/id 17592186087915 :activity/expected-seconds 540.0 :db/ensure [:activity/validate]}]
