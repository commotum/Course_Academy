:knowledge-point/title "Identifying Properties of a Hyperbolic Paraboloid"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25240732-5524-552b-88f5-304b915b524f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,4,0)" :db/id #edb/ref 17592186382251} {:answer/id #uuid "4c125e87-4084-5251-9aaa-bd5dec4933de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0,0)$ and $(0,4,0)$" :db/id #edb/ref 17592186382252} {:answer/id #uuid "29317211-34dc-507a-b150-6dc85c6050c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,0,0)" :db/id #edb/ref 17592186382253} {:answer/id #uuid "c06b6458-aba8-51f9-bc99-8712ca8143da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,2,0)" :db/id #edb/ref 17592186382254} {:answer/id #uuid "9fc238d9-1552-5ec2-9691-0a1f6f81afba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-4,0)" :db/id #edb/ref 17592186382255}] :answer-field/correct {:answer/id #uuid "25240732-5524-552b-88f5-304b915b524f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,4,0)" :db/id #edb/ref 17592186382251} :answer-field/id #uuid "9cfa4b00-e44b-55c9-8e94-8b91a3040461" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382250}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cbb10cd7-0b44-507f-90e1-ff2f6d34dce7" :question/math-academy-id "q-72304" :question/problem "Given the hyperbolic paraboloid $(x-2)^{2}-2(y-4)^{2}=z+4$, find its intercepts with the $y$-axis." :question/worked-solution "To find the $y$-intercepts of the paraboloid, we substitute $x=0$ and $z=0$ in the equation of the paraboloid:\n\n$$\n\\begin{aligned}(0-2)^{2}-2(y-4)^{2} & =0+4 \\\\ 4-2(y-4)^{2} & =4 \\\\ 2(y-4)^{2} & =0 \\\\ y-4 & =0 \\\\ y & =4\\end{aligned}\n$$\n\nTherefore, the intercept with the $y$-axis is $(0,4,0).$"}] [{:db/id #edb/ref 17592186339088 :knowledge-point/_questions [{:db/id #edb/ref 17592186124505 :knowledge-point/id #uuid "e9078ab1-37a4-5e96-ae12-a83d5cd8804e" :knowledge-point/title "Identifying Properties of a Hyperbolic Paraboloid"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c67b3b1-ca17-50d9-826b-aa84c548da4d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-7,0,0)$ and $(1,0,0)$" :db/id #edb/ref 17592186336743} {:answer/id #uuid "767a3d83-a217-545e-829c-803f0a2e5f93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,0,0)" :db/id #edb/ref 17592186337098} {:answer/id #uuid "7d9dcfbc-5db8-52dc-aa70-3ce3548a031a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-7,0,0)$ and $(-1,0,0)$" :db/id #edb/ref 17592186337168} {:answer/id #uuid "cd3c3792-dfb7-53e4-8d4f-f13a6930b54d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-7,0,0)$ only" :db/id #edb/ref 17592186337832} {:answer/id #uuid "fb10441f-5dc2-53c4-8a56-253eb94e9ba8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-1,0,0)$ and $(7,0,0)$" :db/id #edb/ref 17592186338235}] :answer-field/correct {:answer/id #uuid "4c67b3b1-ca17-50d9-826b-aa84c548da4d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-7,0,0)$ and $(1,0,0)$" :db/id #edb/ref 17592186336743} :answer-field/id #uuid "5a0d88c8-d602-5247-ade9-89205172c789" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338432}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0b363aae-9a1a-5bd8-a7ce-6affaf56df43" :question/math-academy-id "q-72305" :question/problem "Given the hyperbolic paraboloid $(x+3)^{2}-2(y-3)^{2}=z-2$, find its intercepts with the $x$-axis." :question/worked-solution "To find the $x$-intercepts of the paraboloid, we substitute $y=0$ and $z=0$ in the equation of the paraboloid:\n\n$$\n\\begin{aligned}(x+3)^{2}-2(0-3)^{2} & =0-2 \\\\ (x+3)^{2}-18 & =-2 \\\\ (x+3)^{2} & =16 \\\\ x+3 & =\\pm 4 \\\\ x & =-3\\pm 4\\end{aligned}\n$$\n\nThis gives the solutions $x=-7$ and $x=1.$\n\nTherefore, the intercepts with the $x$-axis are $(-7,0,0)$ and $(1,0,0).$"}] [{:db/id #edb/ref 17592186525044 :knowledge-point/_questions [{:db/id #edb/ref 17592186124505 :knowledge-point/id #uuid "e9078ab1-37a4-5e96-ae12-a83d5cd8804e" :knowledge-point/title "Identifying Properties of a Hyperbolic Paraboloid"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27aec271-8375-514d-93f8-b0fd659cac22" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,1,0)$ only" :db/id #edb/ref 17592186524456} {:answer/id #uuid "c76196c7-5bd8-564e-ab0c-1aa19bb1b301" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,13,0)$ only" :db/id #edb/ref 17592186524704} {:answer/id #uuid "daa884be-dd4f-502c-ad7e-8f18e4feeeb2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,-15,0)$ and $(0,13,0)$" :db/id #edb/ref 17592186524748} {:answer/id #uuid "df704459-6416-5914-ac68-faa71d081a15" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,1,0)$ and $(0,3,0)$" :db/id #edb/ref 17592186524766} {:answer/id #uuid "ea74f780-c5a4-51a5-8a9e-88c3509c0e76" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,-15,0)$ only" :db/id #edb/ref 17592186524795}] :answer-field/correct {:answer/id #uuid "daa884be-dd4f-502c-ad7e-8f18e4feeeb2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,-15,0)$ and $(0,13,0)$" :db/id #edb/ref 17592186524748} :answer-field/id #uuid "3925c411-60a1-5817-a407-541f7c2a0413" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524865}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cb8dda76-cb23-5b23-b067-bd505ebd9a72" :question/math-academy-id "q-73861" :question/problem "Given the hyperbolic paraboloid $(x-4)^{2}-\\frac{(y+1)^{2}}{7}=z-12$, find its intercepts with the $y$-axis." :question/worked-solution "To find the $y$-intercepts of the paraboloid, we substitute $x=0$ and $z=0$ in the equation of the paraboloid:\n\n$$\n\\begin{aligned}(0-4)^{2}-\\frac{(y+1)^{2}}{7} & =0-12 \\\\ 16-\\frac{(y+1)^{2}}{7} & =-12 \\\\ \\frac{(y+1)^{2}}{7} & =28 \\\\ (y+1)^{2} & =196 \\\\ y+1 & =\\pm 14 \\\\ y & =-1\\pm 14\\end{aligned}\n$$\n\nThis gives the solutions $y=-15$ and $y=13.$\n\nTherefore, the intercepts with the $y$-axis are $(0,-15,0)$ and $(0,13,0).$"}]}
