{2}=-4(z-8)$" :db/id #edb/ref 17592186381926} {:answer/id #uuid "5260c4fc-ea46-5b91-b8c1-6846601af0cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A parabola: ${y}^{2}=4(z-3)$" :db/id #edb/ref 17592186381927} {:answer/id #uuid "6d02a9fa-2023-5471-bc81-cbcf43b8c8a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbola: $4{x}^{2}-{y}^{2}=1$" :db/id #edb/ref 17592186381928} {:answer/id #uuid "76002e70-47af-5243-bce7-2ec88177b443" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Two parallel lines: $y=4(x\\pm 5)$" :db/id #edb/ref 17592186381929}] :answer-field/correct {:answer/id #uuid "93c0cdd3-d051-5fd8-90d6-035561d8fb25" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A parabola: ${y}^{2}=-4(z-8)$" :db/id #edb/ref 17592186381926} :answer-field/id #uuid "18464e40-2827-5e2f-8b8f-b0d86ca73863" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381924}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "675d871f-22c6-5fe3-b40e-bf98ef3dc757" :question/math-academy-id "q-35844" :question/problem "What is the trace in the $yz$-plane of the hyperbolic paraboloid $z-3=\\frac{(x-5)^{2}}{5}-\\frac{{y}^{2}}{4}?$" :question/worked-solution "To find the trace in the $yz$-plane, we substitute $x=0$ into the equation of the paraboloid, and simplify:\n\n$$\n\\begin{aligned}z-3 & =\\frac{(0-5)^{2}}{5}-\\frac{{y}^{2}}{4} \\\\ z-3 & =\\frac{25}{5}-\\frac{{y}^{2}}{4} \\\\ z-3 & =5-\\frac{{y}^{2}}{4} \\\\ z-8 & =-\\frac{{y}^{2}}{4} \\\\ {y}^{2} & =-4(z-8)\\end{aligned}\n$$\n\n \n\nThis gives us the equation of the parabola in $yz$-plane."}] [{:db/id #edb/ref 17592186381935 :knowledge-point/_questions [{:db/id #edb/ref 17592186124556 :knowledge-point/id #uuid "dff86a8b-7966-53f7-a7bc-287990fb611d" :knowledge-point/title "Finding Traces of Paraboloids"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9cf51fce-06fb-5014-bcaf-542a56ea3db1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Two intersecting lines: $x=\\pm \\frac{y}{4}$" :db/id #edb/ref 17592186381937} {:answer/id #uuid "a5405574-1201-5d3d-a0b5-fab41d27a150" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A parabola: $z=1-\\frac{{x}^{2}}{4}$" :db/id #edb/ref 17592186381938} {:answer/id #uuid "a8231a12-a687-5f03-a661-bb6ba8338e8c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbola: $\\frac{{x}^{2}}{4}-{z}^{2}=1$" :db/id #edb/ref 17592186381939} {:answer/id #uuid "ae23a75c-2bb5-5a81-bc35-deb72bcec601" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Two parallel lines: $y=\\frac{1}{4}(z\\pm 3)$" :db/id #edb/ref 17592186381940} {:answer/id #uuid "689d060a-b492-51b7-b38d-ec57b98f07c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A parabola: $z=\\frac{{x}^{2}}{4}+1$" :db/id #edb/ref 17592186381941}] :answer-field/correct {:answer/id #uuid "689d060a-b492-51b7-b38d-ec57b98f07c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A parabola: $z=\\frac{{x}^{2}}{4}+1$" :db/id #edb/ref 17592186381941} :answer-field/id #uuid "fdf65d41-199a-5c7b-8443-408885e6dc48" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381936}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1adbfc1c-cffb-5c8a-9c1f-9353aa055253" :question/math-academy-id "q-35907" :question/problem "What is the trace in the $xz$-plane of the elliptic paraboloid $z-1=\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{2}.$" :question/worked-solution "To find the trace in the $xz$-plane, we substitute $y=0$ into the equation of the paraboloid, and simplify:\n\n$$\n\\begin{aligned}z-1 & =\\frac{{x}^{2}}{4}+\\frac{{0}^{2}}{2} \\\\ z-1 & =\\frac{{x}^{2}}{4} \\\\ z & =\\frac{{x}^{2}}{4}+1\\end{aligned}\n$$\n\n \n\nThis gives us the equation of the parabola in $xz$-plane."}] [{:db/id #edb/ref 17592186124931 :knowledge-point/_questions [{:db/id #edb/ref 17592186124504 :knowledge-point/id #uuid "ddf82ff9-ea7c-5f7f-ac18-07f8e75b717e" :knowledge-point/title "Identifying Properties of an Elliptic Paraboloid"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "229c5763-40a0-5a3b-aa7a-5dd0c1c290e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0,0)$ only" :db/id #edb/ref 17592186321410} {:answer/id #uuid "3f5cd4d0-5e71-57f3-8ebb-3f4773f2347a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0,0)$ and $(16,0,0)$" :db/id #edb/ref 17592186321644} {:answer/id #uuid "821b3175-93e0-56b4-ae4d-3965cce2d21c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(2,0,0)$ only" :db/id #edb/ref 17592186322172} {:answer/id #uuid "9966c711-a0af-5791-8a2d-c9fa47364e04" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-2,0,0)$ and $(2,0,0)$" :db/id #edb/ref 17592186322365} {:answer/id #uuid "bfb2bb8d-2ef0-5b35-b27c-e1f1f0138455" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-2,0,0)$ only" :db/id #edb/ref 17592186322636}] :answer-field/correct {:answer/id #uuid "229c5763-40a0-5a3b-aa7a-5dd0c1c290e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0,0)$ only" :db/id #edb/ref 17592186321410} :answer-field/id #uuid "29489a37-0ad9-5e04-b0bf-538d9c382759" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323257}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "938dd95e-5436-5743-9e59-f40c992dba34" :question/math-academy-id "q-35927" :question/problem "Given the elliptic paraboloid $z+4=\\frac{{x}^{2}}{4}+\\frac{(y-4)^{2}}{4}$, find its intercepts with the $x$-axis." :question/worked-solution "To find the $x$-intercepts of the paraboloid, we substitute $y=0$ and $z=0$ into the equation of the paraboloid and solve for $x:$\n\n$$\n\\begin{aligned}0+4 & =\\frac{{x}^{2}}{4}+\\frac{(0-4)^{2}}{4} \\\\ 4 & =\\frac{{x}^{2}}{4}+\\frac{16}{4} \\\\ 4 & =\\frac{{x}^{2}}{4}+4 \\\\ \\frac{{x}^{2}}{4} & =0\\end{aligned}\n$$\n\nThis gives the solution $x=0$\n\nTherefore, the intercept with the $x$-axis is $(0,0,0)$ only."}] [{:db/id #edb/ref 17592186323730 :knowledge-point/_questions [{:db/id #edb/ref 17592186124556 :knowledge-point/id #uuid "dff86a8b-7966-53f7-a7bc-287990fb611d" :knowledge-point/title "Finding Traces of Paraboloids"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "234053a9-0712-5f7f-9f6c-bd63270d963d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbola: ${x}^{2}-3(y-1)^{2}=1$" :db/id #edb/ref 17592186321416} {:answer/id #uuid "3039419b-9807-5636-9c00-7d1fc78f5c07" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A parabola: $z=3(y-1)^{2}$" :db/id #edb/ref 17592186321517} {:answer/id #uuid "c0d77298-cbb4-59f1-a1f7-f81530eabe0a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Two parallel lines: $y=(z\\pm 3)$" :db/id #edb/ref 17592186322647} {:answer/id #uuid "e1e3d9ba-71ea-5899-b5c5-ecb483cb1895" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A parabola: $z=\\frac{1}{3}(y-1)^{2}$" :db/id #edb/ref 17592186322912} {:answer/id #uuid "f328b6c6-3cbd-5c90-901d-bca72bd7309c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Two intersecting lines: $y=\\pm (x-1)$" :db/id #edb/ref 17592186323055}] :answer-field/correct {:answer/id #uuid "e1e3d9ba-71ea-5899-b5c5-ecb483cb1895" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A parabola: $z=\\frac{1}{3}(y-1)^{2}$" :db/id #edb/ref 17592186322912} :answer-field/id #uuid "6b4497af-4149-5201-80ca-d6a9ed7ca7dc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323384}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2de6f5d2-dd01-5d13-9acf-e0d1ce1480d6" :question/math-academy-id "q-35931" :question/problem "What is the trace in the $yz$-plane of the elliptic paraboloid $z+1=\\frac{(x-2)^{2}}{4}+\\frac{(y-1)^{2}}{3}.$" :question/worked-solution "To find the trace in the $yz$-plane, we substitute $x=0$ into the equation of the paraboloid, and simplify:\n\n$$\n\\begin{aligned}z+1 & =\\frac{(0-2)^{2}}{4}+\\frac{(y-1)^{2}}{3} \\\\ z+1 & =\\frac{4}{4}+\\frac{(y-1)^{2}}{3} \\\\ z+1 & =1+\\frac{(y-1)^{2}}{3} \\\\ z & =\\frac{1}{3}(y-1)^{2}\\end{aligned}\n$$\n\n \n\nThis gives us the equation of the parabola in $yz$-plane."}] [{:db/id #edb/ref 17592186339087 :knowledge-point/_questions [{:db/id #edb/ref 17592186124505 :knowledge-point/id #uuid "e9078ab1-37a4-5e96-ae12-a83d5cd8804e" :knowledge-point/title "Identifying Properties of a Hyperbolic Paraboloid"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41853b1b-f128-539e-ab88-ca5d59dc0e05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,-4,5)" :db/id #edb/ref 17592186336650} {:answer/id #uuid "70528fdb-7a33-5672-975b-ede680fbc8ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,-4,5)" :db/id #edb/ref 17592186337032}