#{[{:db/id #edb/ref 17592186398624 :knowledge-point/_questions [{:db/id #edb/ref 17592186124585 :knowledge-point/id #uuid "2e0b4012-403b-5739-8f33-3c79111129fd" :knowledge-point/title "Identifying Properties of Elliptic Cones"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "61541d10-8686-53a1-b1bf-94e0ef8661d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,5,0)" :db/id #edb/ref 17592186398626} {:answer/id #uuid "57cf4f60-5a5b-5023-8efc-4c4539d402c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,3,1)" :db/id #edb/ref 17592186398627} {:answer/id #uuid "8ec42430-265d-5e60-ab37-b8ed51e07c2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,2,1)" :db/id #edb/ref 17592186398628} {:answer/id #uuid "1bb43111-b5c6-506a-9572-f434c68db87b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,-2,1)" :db/id #edb/ref 17592186398629} {:answer/id #uuid "7a27a7e6-a9f2-5d69-9ce2-25ac6a1448c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,2,-3)" :db/id #edb/ref 17592186398630}] :answer-field/correct {:answer/id #uuid "1bb43111-b5c6-506a-9572-f434c68db87b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,-2,1)" :db/id #edb/ref 17592186398629} :answer-field/id #uuid "98a42fbd-b4c4-5033-b650-f9ced006793a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398625}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9ba92e56-0c67-534f-87e7-bf0cdfa829cc" :question/math-academy-id "q-176834" :question/problem "Find the center of the elliptic cone $4(x-3)^{2}+5(y+2)^{2}=20(z-1)^{2}.$" :question/worked-solution "The general equation of an elliptic cone with center at the point $({x}_{0},{y}_{0},{z}_{0})$ is\n\n$$\n\\frac{(x-{x}_{0})^{2}}{{a}^{2}}+\\frac{(y-{y}_{0})^{2}}{{b}^{2}}=\\frac{(z-{z}_{0})^{2}}{{c}^{2}}.\n$$\n\nTo find the center, we rewrite our equation in standard form, as follows:\n\n$$\n\\begin{aligned}4(x-3)^{2}+5(y+2)^{2} & =20(z-1)^{2} \\\\ \\frac{(x-3)^{2}}{1/4}+\\frac{(y+2)^{2}}{1/5} & =\\frac{(z-1)^{2}}{1/20} \\\\ \\frac{(x-3)^{2}}{1/4}+\\frac{(y-(-2))^{2}}{1/5} & =\\frac{(z-1)^{2}}{1/20}\\end{aligned}\n$$\n\nThis gives us the equation of an elliptic cone that has its center at $(3,-2,1).$"}] [{:db/id #edb/ref 17592186321020 :knowledge-point/_questions [{:db/id #edb/ref 17592186124586 :knowledge-point/id #uuid "fb7148a2-58cc-5023-845c-435b47e31c83" :knowledge-point/title "Finding Traces of Elliptic Cones"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46e63f99-8f14-5080-9a2e-a03f67b6f5db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,1,\\frac{\\sqrt{3}}{2})" :db/id #edb/ref 17592186319604} {:answer/id #uuid "682d8bcb-bb0a-5b03-84fe-94c34cbeb032" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,0,2)" :db/id #edb/ref 17592186319711} {:answer/id #uuid "9f857228-b831-5b0a-ae8c-f7da0874af6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,0,0)" :db/id #edb/ref 17592186319867} {:answer/id #uuid "a6841569-84af-5be4-9d81-2ecad2a172f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\sqrt{2}+1,1,1)" :db/id #edb/ref 17592186319888} {:answer/id #uuid "b27e7f2e-0e94-55d0-b201-8607ca8c4da2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,\\sqrt{2},\\sqrt{2})" :db/id #edb/ref 17592186319937}] :answer-field/correct {:answer/id #uuid "9f857228-b831-5b0a-ae8c-f7da0874af6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,0,0)" :db/id #edb/ref 17592186319867} :answer-field/id #uuid "9ec7c853-e0da-5ec1-be58-35c4e6defe4a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186320483}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "986a46a0-87d4-5e95-a284-ff13a2e0b6b0" :question/math-academy-id "q-35266" :question/problem "Given that the trace of the elliptic cone $\\frac{(x-1)^{2}}{4}+\\frac{{y}^{2}}{2}={z}^{2}$ and the $xz$-plane are two lines, what is the intersection point of these lines?" :question/worked-solution "To find the trace in the $xz$-plane, we substitute $y=0$ into the equation of the elliptic cone, as follows:\n\n$$\n\\begin{aligned}\\frac{(x-1)^{2}}{4}+\\frac{(0)^{2}}{2} & ={z}^{2} \\\\ \\frac{(x-1)^{2}}{4} & ={z}^{2} \\\\ \\pm \\frac{x-1}{2} & =z\\end{aligned}\n$$\n\nThis gives us two lines in the $xz$-plane with equations $z=\\frac{x-1}{2}$ and $z=\\frac{1-x}{2}.$ \n\nTo find the point of intersection of both lines, we equate the right-hand sides. This gives\n\n$$\n\\begin{aligned}\\frac{x-1}{2} & =\\frac{1-x}{2} \\\\ x-1 & =1-x \\\\ 2x & =2 \\\\ x & =1.\\end{aligned}\n$$\n\nSubstituting $x=1$ in the equation of the first line and solving for $z,$ we obtain $z=\\frac{1-1}{2}=0.$\n\nTherefore, the point of intersection is $(1,0,0).$"}] [{:db/id #edb/ref 17592186125239 :knowledge-point/_questions [{:db/id #edb/ref 17592186124585 :knowledge-point/id #uuid "2e0b4012-403b-5739-8f33-3c79111129fd" :knowledge-point/title "Identifying Properties of Elliptic Cones"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "431915b2-15e4-559a-9ff5-a1abef76b999" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,-1,0)" :db/id #edb/ref 17592186355262} {:answer/id #uuid "69b4bd2c-81f2-5ad5-b932-fc660accbada" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,1,0)" :db/id #edb/ref 17592186355596} {:answer/id #uuid "976223ef-b049-5a60-8175-d7ccdf55f16f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,-1,0)" :db/id #edb/ref 17592186355995} {:answer/id #uuid "a7cb07b7-3acf-5d59-ba6d-f563d82a166a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,0,0)" :db/id #edb/ref 17592186356150} {:answer/id #uuid "eb3da815-6277-5b7a-9d14-81d8eb8cfaf1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,1,0)" :db/id #edb/ref 17592186356718}] :answer-field/correct {:answer/id #uuid "eb3da815-6277-5b7a-9d14-81d8eb8cfaf1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,1,0)" :db/id #edb/ref 17592186356718} :answer-field/id #uuid "b2daa040-b350-5a0f-89d7-1814b47a133e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357242}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6dbbc8b0-b994-5e7b-854a-3bf51bb1a258" :question/math-academy-id "q-94082" :question/problem "Find the center of the elliptic cone $2(x+2)^{2}+3(y-1)^{2}={z}^{2}.$" :question/worked-solution "The general equation of an elliptic cone with center at the point $({x}_{0},{y}_{0},{z}_{0})$ is\n\n$$\n\\frac{(x-{x}_{0})^{2}}{{a}^{2}}+\\frac{(y-{y}_{0})^{2}}{{b}^{2}}=\\frac{(z-{z}_{0})^{2}}{{c}^{2}}.\n$$\n\nTo find the center, we rewrite our equation in standard form, as follows:\n\n$$\n\\begin{aligned}2(x+2)^{2}+3(y-1)^{2} & =(z-0)^{2} \\\\ \\frac{(x+2)^{2}}{1/2}+\\frac{(y-1)^{2}}{1/3} & =(z-0)^{2} \\\\ \\frac{(x-(-2))^{2}}{1/2}+\\frac{(y-1)^{2}}{1/3} & =(z-0)^{2}\\end{aligned}\n$$\n\nThis gives us the equation of an elliptic cone that has its center at $(-2,1,0).$"}] [{:db/id #edb/ref 17592186520496 :knowledge-point/_questions [{:db/id #edb/ref 17592186124585 :knowledge-point/id #uuid "2e0b4012-403b-5739-8f33-3c79111129fd" :knowledge-point/title "Identifying Properties of Elliptic Cones"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "149d7ad3-6a01-5174-82bf-5d60b9244ab5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(2,0,0)$ and $(8,0,0)$" :db/id #edb/ref 17592186520018} {:answer/id #uuid "200ae72a-6343-55a0-bb64-42d0cfc2e032" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(2,0,0)$ and $(10,0,0)$" :db/id #edb/ref 17592186520036} {:answer/id #uuid "7bdd0c2a-eed2-5368-b2da-6b29b25677d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(4,0,0)$ and $(10,0,0)$" :db/id #edb/ref 17592186520170} {:answer/id #uuid "c850056d-98c5-53e9-817e-b69ff41dd285" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(2,0,0)$ and $(6,0,0)$" :db/id #edb/ref 17592186520271} {:answer/id #uuid "eee23346-be71-5a2e-883c-63ac858b2a5b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(4,0,0)$ and $(8,0,0)$" :db/id #edb/ref 17592186520343}] :answer-field/correct {:answer/id #uuid "eee23346-be71-5a2e-883c-63ac858b2a5b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(4,0,0)$ and $(8,0,0)$" :db/id #edb/ref 17592186520343} :answer-field/id #uuid "7b271f10-b638-58d9-8c15-6f54a2760bc2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186520402}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c06702a9-7f9f-5ebf-bbd9-2e359cfd7640" :question/math-academy-id "q-94606" :question/problem "Given the elliptic cone $\\frac{(x-6)^{2}}{2}+\\frac{(y-4)^{2}}{8}=(z-2)^{2},$ find its intercepts with the $x$-axis." :question/worked-solution "To find the $x$-intercepts of the elliptic cone, we plug $y=0$ and $z=0$ into the equation and solve for $x:$\n\n$$\n\\begin{aligned}\\frac{(x-6)^{2}}{2}+\\frac{(0-4)^{2}}{8} & =(0-2)^{2} \\\\ \\frac{(x-6)^{2}}{2}+\\frac{16}{8} & =4 \\\\ \\frac{(x-6)^{2}}{2}+2 & =4 \\\\ \\frac{(x-6)^{2}}{2} & =2 \\\\ (x-6)^{2} & =4 \\\\ x-6 & =\\pm 2 \\\\ x & =6\\pm 2 \\\\ x & =4,8\\end{aligned}\n$$\n\nTherefore, the intercepts with the $x$-axis are $(4,0,0)$ and $(8,0,0).$"}] [{:db/id #edb/ref 17592186360601 :knowledge-point/_questions [{:db/id #edb/ref 17592186124586 :knowledge-point/id #uuid "fb7148a2-58cc-5023-845c-435b47e31c83" :knowledge-point/title "Finding Traces of Elliptic Cones"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ce436d1-a9c1-525b-a0b3-0ec1173836fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\pm \\frac{1}{4}(x+1)" :db/id #edb/ref 17592186358002} {:answer/id #uuid "4856d8fc-d720-5b06-83ea-aae77c408c5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=4x+1" :db/id #edb/ref 17592186358371} {:answer/id #uuid "4ad2e3a4-9385-5c7f-9bd1-08c990264005" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\pm 4(x-1)" :db/id #edb/ref 17592186358392} {:answer/id #uuid "af8462af-f75c-5645-b5c3-7168a1d4b045" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=-4x+4" :db/id #edb/ref 17592186359278} {:answer/id #uuid "e9f4fad8-ff94-5047-96b6-9810538bd050" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=-\\frac{1}{4}x-1" :db/id #edb/ref 17592186359832}] :answer-field/correct {:answer/id #uuid "4ad2e3a4-9385-5c7f-9bd1-08c990264005" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\pm 4(x-1)" :db/id #edb/ref 17592186358392} :answer-field/id #uuid "e1f85999-f4fb-5e4b-82da-6df883efe9f3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360397}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8d65c16f-ccd9-5975-b9f2-fd4e5517583b" :question/math-academy-id "q-95462" :question/problem "What is the trace in the $xz$-plane of the elliptic cone $(x-1)^{2}+7{y}^{2}=\\frac{1}{16}{z}^{2}\\,?$" :question/worked-solution "To find the trace in the $xz$-plane, we substitute $y=0$ into the equation of the elliptic cone, as follows:\n\n$$\n\\begin{aligned}(x-1)^{2}+7(0)^{2} & =\\frac{1}{16}{z}^{2} \\\\ (x-1)^{2} & =\\frac{1}{16}{z}^{2} \\\\ \\frac{1}{4}z & =\\pm (x-1) \\\\ z & =\\pm 4(x-1)\\end{aligned}\n$$\n\nThis gives us two lines in the $xz$-plane with equations $z=\\pm 4(x-1).$"}]}
