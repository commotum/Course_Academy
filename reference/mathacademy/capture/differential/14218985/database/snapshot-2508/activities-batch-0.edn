#{[{:activity/expected-seconds 720.0 :activity/first-step {:db/id #edb/ref 17592186097633} :activity/id #uuid "f97acdea-187e-5327-a13f-1e14931b5e5f" :activity/scope {:db/id #edb/ref 17592186048350 :topic/id #uuid "97af7835-46ed-5be6-8581-1612329913e7" :topic/math-academy-id 1132} :activity/steps [{:db/id #edb/ref 17592186097571 :step/content {:db/id #edb/ref 17592186097855 :tutorial/content "Suppose we want to know what are the $x$-intercepts of the parabola below.\n\n![](images/5d/5d3493115eb11315849d3d7c247b9f63a399c6ab7ba2c226b0b84958a47d3a21.png)\n\nThen, we proceed as follows: \n\nFirst, we find the equation of the parabola. From the diagram, we see that the parabola has its vertex at $\\displaystyle\\left(\\frac 32, -1\\right)$ and passes through the point $\\displaystyle\\left(1,-\\frac 34\\right).$\n\nThe general standard equation of an up- or down-opening parabola with vertex $(h,k)$ is given by\n\n$$\n(x-h)^2 = 4p(y-k).\n$$\n\nSubstituting $(h,k) = \\left(\\dfrac 32, -1\\right)$ into the above gives\n\n$$\n\\begin{aligned}{(x-\\frac{3}{2})}^{2} & =4p(y+1).\\end{aligned}\n$$\n\nNow, we need to find $p.$ Since the parabola passes through the point $\\displaystyle\\left(1,-\\frac 34\\right),$ we substitute $x= 1$ and $y=-\\dfrac34$ into the equation and get\n\n$$\n\\begin{aligned}{(1-\\frac{3}{2})}^{2} & =4p(-\\frac{3}{4}+1) \\\\ \\frac{1}{4} & =4p(\\frac{1}{4}) \\\\ p & =\\frac{1}{4}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is\n\n$$\n\\begin{aligned}{(x-\\frac{3}{2})}^{2} & =(y+1).\\end{aligned}\n$$\n\nWhen the parabola intersects the $x$-axis, we must have $y= 0.$ So, we substitute $y=0$ into the equation of the parabola and solve for $x{:}$\n\n$$\n\\begin{aligned}{(x-\\frac{3}{2})}^{2} & =(0+1) \\\\ {(x-\\frac{3}{2})}^{2} & =1 \\\\ x-\\frac{3}{2} & =\\pm 1 \\\\ x & =\\frac{3}{2}\\pm 1\\end{aligned}\n$$\n\nTherefore, the $x$-intercepts are $\\dfrac12$ and $\\dfrac52.$" :tutorial/id #uuid "04c720cc-0a5d-5a6c-acf5-65c378ef274b" :tutorial/math-academy-id 3484 :tutorial/title "Calculating the Intercepts of a Parabola Given a Graph of the Parabola"} :step/id #uuid "47e80884-1762-5551-9161-e2231dbed002" :step/math-academy-id 19720 :step/next {:db/id #edb/ref 17592186097572}} {:db/id #edb/ref 17592186097572 :step/content {:db/id #edb/ref 17592186096706 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096504 :question/id #uuid "1456cdfb-6ae9-5439-8ebe-e5b41687dfa9" :question/math-academy-id "e-5337"} :knowledge-point/id #uuid "8c990d69-54da-5541-948f-0d5eff96feb5" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048366} {:db/id #edb/ref 17592186048963} {:db/id #edb/ref 17592186049118}] :knowledge-point/questions [{:db/id #edb/ref 17592186097108} {:db/id #edb/ref 17592186097113} {:db/id #edb/ref 17592186290524} {:db/id #edb/ref 17592186292529} {:db/id #edb/ref 17592186292530} {:db/id #edb/ref 17592186292533} {:db/id #edb/ref 17592186342087} {:db/id #edb/ref 17592186342088} {:db/id #edb/ref 17592186348183} {:db/id #edb/ref 17592186348184} {:db/id #edb/ref 17592186376138} {:db/id #edb/ref 17592186376980} {:db/id #edb/ref 17592186376983} {:db/id #edb/ref 17592186376986} {:db/id #edb/ref 17592186376989} {:db/id #edb/ref 17592186396052} {:db/id #edb/ref 17592186403703} {:db/id #edb/ref 17592186441435} {:db/id #edb/ref 17592186492872} {:db/id #edb/ref 17592186492926} {:db/id #edb/ref 17592186492928} {:db/id #edb/ref 17592186495095} {:db/id #edb/ref 17592186495151}] :knowledge-point/title "Calculating the X-Intercepts of a Parabola Given Its Graph"} :step/id #uuid "fd6bd854-7c41-5db8-95d8-5be58a99e006" :step/math-academy-id 19721 :step/next {:db/id #edb/ref 17592186097574}} {:db/id #edb/ref 17592186097573 :step/content {:db/id #edb/ref 17592186096707 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096505 :question/id #uuid "77303537-c614-5269-a22e-0bd412e7fa99" :question/math-academy-id "e-5339"} :knowledge-point/id #uuid "ddc6c4b1-b4c4-52f8-9f25-feda3130e358" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048187} {:db/id #edb/ref 17592186048774}] :knowledge-point/questions [{:db/id #edb/ref 17592186097114} {:db/id #edb/ref 17592186097120} {:db/id #edb/ref 17592186272314} {:db/id #edb/ref 17592186272317} {:db/id #edb/ref 17592186292525} {:db/id #edb/ref 17592186342082} {:db/id #edb/ref 17592186342083} {:db/id #edb/ref 17592186342092} {:db/id #edb/ref 17592186376975} {:db/id #edb/ref 17592186377681} {:db/id #edb/ref 17592186377688} {:db/id #edb/ref 17592186395755} {:db/id #edb/ref 17592186403696} {:db/id #edb/ref 17592186441437} {:db/id #edb/ref 17592186441438} {:db/id #edb/ref 17592186441440} {:db/id #edb/ref 17592186441442}] :knowledge-point/title "Calculating the Intercepts of a Parabola Given Its Equation"} :step/id #uuid "003b2c9e-f558-5f16-ae29-70cb592bdea5" :step/math-academy-id 19724 :step/next {:db/id #edb/ref 17592186097571}} {:db/id #edb/ref 17592186097574 :step/content {:db/id #edb/ref 17592186096708 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096506 :question/id #uuid "4ce7b936-de41-5aeb-b980-80d9fa91314f" :question/math-academy-id "e-5340"} :knowledge-point/id #uuid "5e182f71-db24-5c29-9c8b-2fc4b5ab5dd8" :knowledge-point/questions [{:db/id #edb/ref 17592186097117} {:db/id #edb/ref 17592186097119} {:db/id #edb/ref 17592186284548} {:db/id #edb/ref 17592186284549} {:db/id #edb/ref 17592186292534} {:db/id #edb/ref 17592186292535} {:db/id #edb/ref 17592186292536} {:db/id #edb/ref 17592186292537} {:db/id #edb/ref 17592186348195} {:db/id #edb/ref 17592186376994} {:db/id #edb/ref 17592186376999} {:db/id #edb/ref 17592186377742} {:db/id #edb/ref 17592186377749} {:db/id #edb/ref 17592186396059} {:db/id #edb/ref 17592186404016} {:db/id #edb/ref 17592186441436} {:db/id #edb/ref 17592186441439} {:db/id #edb/ref 17592186441441} {:db/id #edb/ref 17592186492924} {:db/id #edb/ref 17592186495148}] :knowledge-point/title "Calculating the Y-Intercepts of a Parabola Given Its Graph"} :step/id #uuid "82273a54-9ebb-549c-bc34-a98726936b3c" :step/math-academy-id 19725} {:db/id #edb/ref 17592186097633 :step/content {:db/id #edb/ref 17592186097868 :tutorial/content "Let's consider the parabola $(x-1)^2 = \\dfrac 1 2 (y+3) ,$ shown below.\n\n![](images/bb/bbe360c9580cab435e5b737c80c5381f039d1871250cdae3c16bc686e3d0a53d.png)\n\n  \n\nTo calculate the $y$-intercept of the parabola (shown as the point $A$ in the diagram), we set $x=0$ and solve for $y.$ In our case, this gives\n\n$$\n\\begin{aligned}(x-1)^{2} & =\\frac{1}{2}(y+3) \\\\ (0-1)^{2} & =\\frac{1}{2}(y+3) \\\\ (-1)^{2} & =\\frac{1}{2}(y+3) \\\\ 1 & =\\frac{1}{2}(y+3) \\\\ 2 & =y+3 \\\\ y & =2-3 \\\\ y & =-1.\\end{aligned}\n$$\n\nSo the coordinates of the $y$-intercept are $(0,-1).$\n\nOn the other hand, to find the $x$-intercepts (shown as the points $B$ and $C$ in the diagram), we set $y=0$ and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}(x-1)^{2} & =\\frac{1}{2}(y+3) \\\\ (x-1)^{2} & =\\frac{1}{2}(0+3) \\\\ (x-1)^{2} & =\\frac{3}{2} \\\\ x-1 & =\\pm \\sqrt{\\frac{3}{2}} \\\\ x & =1\\pm \\sqrt{\\frac{3}{2}}.\\end{aligned}\n$$\n\nSo, the coordinates of $B$ are $\\left(1-\\sqrt{\\dfrac{3}{2}},0\\right)$ and the coordinates of $C$ are $\\left(1+\\sqrt{\\dfrac{3}{2}},0\\right).$" :tutorial/id #uuid "f9511803-ede3-5b03-b34f-87d1bb050901" :tutorial/math-academy-id 3905 :tutorial/title "Introduction"} :step/id #uuid "3eccc6e2-615b-5126-b1a2-9f9bb514c40d" :step/math-academy-id 23091 :step/next {:db/id #edb/ref 17592186097573}}] :activity/title "Calculating Intercepts of Parabolas" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186096904}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186493003} :activity/id #uuid "3866c2aa-e5f1-566e-84b6-7cace07a50a6" :activity/scope {:db/id #edb/ref 17592186048350 :topic/id #uuid "97af7835-46ed-5be6-8581-1612329913e7" :topic/math-academy-id 1132} :activity/steps [{:db/id #edb/ref 17592186492971 :step/content {:db/id #edb/ref 17592186492928 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d6f31a7-12c7-533a-a616-32df997a304f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186492237}] :answer-field/correct {:db/id #edb/ref 17592186492237} :answer-field/id #uuid "6377b71b-3301-54ad-85e4-81211618a817" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186492747} {:answer-field/choices [{:answer/id #uuid "1d14f365-3431-51a2-85f1-fb6aa4f3083e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186492273}] :answer-field/correct {:db/id #edb/ref 17592186492273} :answer-field/id #uuid "d11afbdb-9351-5d55-af3d-0ebc6b7799e3" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186492790}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "fdc8ed74-44a5-549d-abf7-39e6c995f550" :question/math-academy-id "q-251773" :question/problem "![](images/75/7515041ccdceb8d13e4e718bda12af7535cfbb4a37b0180b04f88a08db4947b2.png)\n\n**From left to right**, the values of the $x$-intercepts of the parabola shown above are{{field-1}}\nand \n{{field-2}}." :question/worked-solution "First, we need to find the equation of the parabola. From the diagram, we see that the parabola has a vertex at $(3,-1)$ and passes through the point $(0,\\frac{5}{4}).$\n\nThe general standard equation of an up- or down-opening parabola with vertex $(h,k)$ is given by\n\n$$\n(x-h)^{2}=4p(y-k).\n$$\n\nSubstituting $(h,k)=(3,-1)$ into the above gives\n\n$$\n\\begin{aligned}(x-3)^{2} & =4p(y+1).\\end{aligned}\n$$\n\nNow, we need to find $p.$ Since the parabola passes through the point $(0,\\frac{5}{4}),$ we substitute $x=0$ and $y=\\frac{5}{4}$ into the equation and get\n\n$$\n\\begin{aligned}(0-3)^{2} & =4p(\\frac{5}{4}+1) \\\\ 9 & =4p(\\frac{9}{4}) \\\\ p & =1.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is\n\n$$\n\\begin{aligned}(x-3)^{2} & =4(y+1).\\end{aligned}\n$$\n\nWhen the parabola intersects the $x$-axis, we must have $y=0.$ So, we substitute $y=0$ into the equation of the parabola and solve for $x:$\n\n$$\n\\begin{aligned}(x-3)^{2} & =4(0+1) \\\\ (x-3)^{2} & =4 \\\\ x-3 & =\\pm \\sqrt{4} \\\\ x & =\\pm 2+3\\end{aligned}\n$$\n\nTherefore, from left to right, the $x$-intercepts are $1$  and $5.$"} :step/id #uuid "96d654a5-c93d-56e0-932c-bfd42b4b3f25" :step/next {:db/id #edb/ref 17592186492993}} {:db/id #edb/ref 17592186492979 :step/content {:db/id #edb/ref 17592186441439 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3326bfbc-602b-5b97-a232-910eb4540d34" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5" :db/id #edb/ref 17592186441399}] :answer-field/correct {:db/id #edb/ref 17592186441399} :answer-field/id #uuid "78edd9c5-7539-5d54-8eb1-437fb325e3d3" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186441425} {:answer-field/choices [{:answer/id #uuid "c1fd71a3-f959-5632-b94a-c770e9c6d2a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186441414}] :answer-field/correct {:db/id #edb/ref 17592186441414} :answer-field/id #uuid "91e3b777-9db3-51a5-ab92-8bddd54cd065" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186441428}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a25c3b40-7f3b-57d8-a341-b7f66aac34c1" :question/math-academy-id "q-251826" :question/problem "![](images/0e/0e95f9087b5b607f2d33d49c0f5db123eede589e53adc94747f3a33c1fe68f90.png)\n\n**From top to bottom**, the **exact** values of the $y$-intercepts of the parabola shown above are{{field-1}}\nand \n{{field-2}}." :question/worked-solution "First, we need to find the equation of the parabola. From the diagram, we see that the parabola has a vertex at $(-8,-1)$ and passes through the point $(-6,1).$\n\nThe general standard equation of a left- or right-opening parabola with vertex at $(h,k)$ is given by\n\n$$\n(y-k)^{2}=4p(x-h),\n$$\n\nand substituting $(h,k)=(-8,-1)$ into the above gives\n\n$$\n(y+1)^{2}=4p(x+8).\n$$\n\nNow, we need to find $p.$ Since the parabola passes through the point $(-6,1),$ we substitute $x=-6$ and $y=1$ into the equation and get\n\n$$\n\\begin{aligned}(1+1)^{2} & =4p(-6+8) \\\\ 4 & =4p(2) \\\\ p & =\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is\n\n$$\n\\begin{aligned}(y+1)^{2} & =2(x+8).\\end{aligned}\n$$\n\nWhen the parabola intersects the $y$-axis, we must have $x=0.$ So, we substitute $x=0$ into the equation of the parabola and solve for $y:$\n\n$$\n\\begin{aligned}(y+1)^{2} & =2(0+8) \\\\ (y+1)^{2} & =16 \\\\ y+1 & =\\pm \\sqrt{16} \\\\ y & =\\pm 4-1 \\\\ y & =-5,3\\end{aligned}\n$$\n\nTherefore, from top to bottom, the $y$-intercepts are $3$ and  $-5.$"} :step/id #uuid "a55bc8a3-ad49-5dfc-b4d0-974e21a65508"} {:db/id #edb/ref 17592186492993 :step/content {:db/id #edb/ref 17592186492872 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "608d4538-0b4d-5182-94b8-be0b177bf697" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186492412}] :answer-field/correct {:db/id #edb/ref 17592186492412} :answer-field/id #uuid "4b765fc4-4996-5266-90d9-3a4e2f7f9f25" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186492734} {:answer-field/choices [{:answer/id #uuid "c48e924c-701d-5314-92e8-98bc2d3981c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186492609}] :answer-field/correct {:db/id #edb/ref 17592186492609} :answer-field/id #uuid "933aac48-b970-5148-a237-e6565ad9de8d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186492762}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "735e4f99-1ffc-57e4-b137-966d99c9aba8" :question/math-academy-id "q-251783" :question/problem "![](images/7a/7ac752bbc51ea08ba8723fa0aba111d3f302cc149db8762208ae18ed31be02d1.png)\n\n**From left to right**, the values of the $x$-intercepts of the parabola shown above are{{field-1}}\nand \n{{field-2}}." :question/worked-solution "First, we need to find the equation of the parabola. From the diagram, we see that the parabola has a vertex at $(1,-4)$ and passes through the point $(0,-3).$\n\nThe general standard equation of an up- or down-opening parabola with vertex $(h,k)$ is given by\n\n$$\n(x-h)^{2}=4p(y-k).\n$$\n\nSubstituting $(h,k)=(1,-4)$ into the above gives\n\n$$\n\\begin{aligned}(x-1)^{2} & =4p(y+4).\\end{aligned}\n$$\n\nNow, we need to find $p.$ Since the parabola passes through the point $(0,-3),$ we substitute $x=0$ and $y=-3$ into the equation and get\n\n$$\n\\begin{aligned}(0-1)^{2} & =4p(-3+4) \\\\ 1 & =4p(1) \\\\ p & =\\frac{1}{4}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is\n\n$$\n\\begin{aligned}(x-1)^{2} & =y+4.\\end{aligned}\n$$\n\nWhen the parabola intersects the $x$-axis, we must have $y=0.$ So, we substitute $y=0$ into the equation of the parabola and solve for $x:$\n\n$$\n\\begin{aligned}(x-1)^{2} & =0+4 \\\\ (x-1)^{2} & =4 \\\\ x-1 & =\\pm \\sqrt{4} \\\\ x & =\\pm 2+1\\end{aligned}\n$$\n\nTherefore, from left to right, the $x$-intercepts are $-1$  and $3.$"} :step/id #uuid "ca9516a2-5640-5521-9384-7fc046858e73" :step/next {:db/id #edb/ref 17592186492979}} {:db/id #edb/ref 17592186493003 :step/content {:db/id #edb/ref 17592186492924 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9f61033c-bec0-5a9b-aaf9-ae37b563257c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186492532} {:answer/id #uuid "a4366df5-83ab-5bf1-a218-b427953b47ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{7}{2}" :db/id #edb/ref 17592186492547} {:answer/id #uuid "b078e7a8-a8b1-5f0a-8d3b-7817778a5e09" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186492570} {:answer/id #uuid "c192c3f6-fee4-5de2-baf8-b83ae6c0b752" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186492603} {:answer/id #uuid "e6374016-52a5-5c7e-89fb-b178fcb7aab0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186492663}] :answer-field/correct {:db/id #edb/ref 17592186492532} :answer-field/id #uuid "b313a6a7-5aef-5eef-9fdc-9a3f6384635e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186492777}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f789e17e-9222-50f7-90e6-3a489f3b51f3" :question/math-academy-id "q-79303" :question/problem "![](images/84/84fa3bc1d70144b0fd2d1865e784ed1cee9d8b83633547f2e62be1a30e4242aa.png)\n\nWhat is the $y$-intercept of the parabola shown above?" :question/worked-solution "First, we need to find the equation of the parabola. From the diagram, we see that the parabola has a vertex at $(2,-5)$ and passes through the point $(-2,3).$\n\nThe general standard equation of an up- or down-opening parabola with vertex at $(h,k)$ is given by\n\n$$\n(x-h)^{2}=4p(y-k),\n$$\n\nand substituting $(h,k)=(2,-5)$ into the above gives\n\n$$\n(x-2)^{2}=4p(y+5).\n$$\n\nNow, we need to find $p.$ Since the parabola passes through the point $(-2,3),$ we substitute $x=-2$ and $y=3$ into the equation and get\n\n$$\n\\begin{aligned}(-2-2)^{2} & =4p(3+5) \\\\ 16 & =4p(8) \\\\ p & =\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is\n\n$$\n\\begin{aligned}(x-2)^{2} & =2(y+5).\\end{aligned}\n$$\n\nWhen the parabola intersects the $y$-axis, we must have $x=0.$ So, we substitute $x=0$ into the equation of the parabola and solve for $y:$\n\n$$\n\\begin{aligned}(0-2)^{2} & =2(y+5) \\\\ 4 & =2(y+5) \\\\ y & =2-5 \\\\ y & =-3\\end{aligned}\n$$\n\nTherefore, the $y$-intercept is $-3.$"} :step/id #uuid "ec4c1f2e-ee02-534f-8b4d-4d02bf4356e6" :step/next {:db/id #edb/ref 17592186493005}} {:db/id #edb/ref 17592186493005 :step/content {:db/id #edb/ref 17592186492926 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "168bd404-2959-5371-bc5c-7fbba3473aa1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1+\\sqrt{6}" :db/id #edb/ref 17592186492259}] :answer-field/correct {:db/id #edb/ref 17592186492259} :answer-field/id #uuid "34e53936-bbb9-5fb0-9b7e-e35958cdf4b9" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186492726} {:answer-field/choices [{:answer/id #uuid "46bda047-ac5b-540d-b339-64ed2abef508" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1-\\sqrt{6}" :db/id #edb/ref 17592186492357}] :answer-field/correct {:db/id #edb/ref 17592186492357} :answer-field/id #uuid "b06a318c-820e-5ff0-97ca-8c71655f9348" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186492775}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f822983e-1d14-50b6-989d-68e7f1c76860" :question/math-academy-id "q-240667" :question/problem "![](images/ac/ac9ee9825678ad3ba815204c39ac2fe4ea85972cc60458251fcc9e9fdb4ba0f7.png)\n\n**From left to right**, the **exact values** of the $x$-intercepts of the parabola shown above are{{field-1}}and{{field-2}}." :question/worked-solution "First, we need to find the equation of the parabola. From the diagram, we see that the parabola has a vertex at $(-1,3)$ and passes through the point $(-2,\\frac{5}{2}).$\n\nThe general standard equation of an up- or down-opening parabola with vertex $(h,k)$ is given by\n\n$$\n(x-h)^{2}=4p(y-k).\n$$\n\nSubstituting $(h,k)=(-1,3)$ into the above gives\n\n$$\n\\begin{aligned}(x+1)^{2} & =4p(y-3).\\end{aligned}\n$$\n\nNow, we need to find $p.$ Since the parabola passes through the point $(-2,\\frac{5}{2}),$ we substitute $x=-2$ and $y=\\frac{5}{2}$ into the equation and get\n\n$$\n\\begin{aligned}(-2+1)^{2} & =4p(\\frac{5}{2}-3) \\\\ (-1)^{2} & =4p(-\\frac{1}{2}) \\\\ 1 & =-2p \\\\ p & =-\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is\n\n$$\n\\begin{aligned}(x+1)^{2} & =-2(y-3).\\end{aligned}\n$$\n\nWhen the parabola intersects the $x$-axis, we must have $y=0.$ So, we substitute $y=0$ into the equation of the parabola and solve for $x:$\n\n$$\n\\begin{aligned}(x+1)^{2} & =-2(0-3) \\\\ (x+1)^{2} & =6 \\\\ x+1 & =\\pm \\sqrt{6} \\\\ x & =-1\\pm \\sqrt{6}\\end{aligned}\n$$\n\nTherefore, from left to right, the $x$-intercepts are $-1-\\sqrt{6}$ and $-1+\\sqrt{6}.$"} :step/id #uuid "f42eea9a-325b-5c56-95b4-dc3b76529b04" :step/next {:db/id #edb/ref 17592186492971}}] :activity/title "Calculating Intercepts of Parabolas" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186492207}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186495271} :activity/id #uuid "faaf5678-c9e5-5976-961c-e2fbc44826c4" :activity/scope {:db/id #edb/ref 17592186048350 :topic/id #uuid "97af7835-46ed-5be6-8581-1612329913e7" :topic/math-academy-id 1132} :activity/steps [{:db/id #edb/ref 17592186495202 :step/content {:db/id #edb/ref 17592186292537 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b11eb3e0-5429-5dbf-9eb9-2fe0147cd44a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186291404}] :answer-field/correct {:db/id #edb/ref 17592186291404} :answer-field/id #uuid "c7824f56-f0d4-5e6a-aab1-6508db9a964a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186292343}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2ccfe5a9-f5ef-5f9b-aef4-c87ce64bd0db" :question/math-academy-id "q-251810" :question/problem "![](images/31/31618ee78ebe4834cf76aedebce7c25eca8413c6a4b9d91761ccc38dbd32b01d.png)\n\nThe value of the $y$-intercept of the parabola shown above  is{{field-1}}." :question/worked-solution "First, we need to find the equation of the parabola. From the diagram, we see that the parabola has a vertex at $(2,2)$ and passes through the point $(-2,-2).$\n\nThe general standard equation of an up- or down-opening parabola with vertex at $(h,k)$ is given by\n\n$$\n(x-h)^{2}=4p(y-k),\n$$\n\nand substituting $(h,k)=(2,2)$ into the above gives\n\n$$\n(x-2)^{2}=4p(y-2).\n$$\n\nNow, we need to find $p.$ Since the parabola passes through the point $(-2,-2),$ we substitute $x=-2$ and $y=-2$ into the equation and get\n\n$$\n\\begin{aligned}(-2-2)^{2} & =4p(-2-2) \\\\ 16 & =4p(-4) \\\\ p & =-1.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is\n\n$$\n\\begin{aligned}(x-2)^{2} & =-4(y-2).\\end{aligned}\n$$\n\nWhen the parabola intersects the $y$-axis, we must have $x=0.$ So, we substitute $x=0$ into the equation of the parabola and solve for $y:$\n\n$$\n\\begin{aligned}(0-2)^{2} & =-4(y-2) \\\\ 4 & =-4(y-2) \\\\ -1 & =y-2 \\\\ y & =1\\end{aligned}\n$$\n\nTherefore, the $y$-intercept is $1.$"} :step/id #uuid "4c426ccb-6df2-54c6-bf9e-14c12edc8adc"} {:db/id #edb/ref 17592186495213 :step/content {:db/id #edb/ref 17592186290524 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "adec1f59-4414-5eba-a9d0-0be0539bcf76" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-8" :db/id #edb/ref 17592186289184}] :answer-field/correct {:db/id #edb/ref 17592186289184} :answer-field/id #uuid "12a4955b-1b39-5914-8df2-241e9e148d62" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186289773}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b992bd0f-c103-5e7d-8240-431930cfc4f1" :question/math-academy-id "q-240666" :question/problem "![](images/d4/d4c21d6ce09ff32004a28d18d223fef7858c377bccb0eb532cf2dda29a545f5e.png)\n\nThe value of the $x$-intercept of the parabola shown above is{{field-1}}." :question/worked-solution "First, we need to find the equation of the parabola. From the diagram, we see that the parabola has a vertex at $(-7,-2)$ and passes through the point $(-11,-6).$\n\nThe general standard equation of a left- or right-opening parabola with vertex $(h,k)$ is given by\n\n$$\n(y-k)^{2}=4p(x-h).\n$$\n\nSubstituting $(h,k)=(-7,-2)$ into the above gives\n\n$$\n(y+2)^{2}=4p(x+7).\n$$\n\nNow, we need to find $p.$ Since the parabola passes through the point $(-11,-6),$ we substitute $x=-11$ and $y=-6$ into the equation and get\n\n$$\n\\begin{aligned}(-6+2)^{2} & =4p(-11+7) \\\\ (-4)^{2} & =4p\\cdot (-4) \\\\ 16 & =-16p \\\\ p & =-1.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is\n\n$$\n\\begin{aligned}(y+2)^{2} & =-4(x+7).\\end{aligned}\n$$\n\nWhen the parabola intersects the $x$-axis, we must have $y=0.$ So, we substitute $y=0$ into the equation of the parabola and solve for $x:$\n\n$$\n\\begin{aligned}(0+2)^{2} & =-4(x+7) \\\\ 4 & =-4(x+7) \\\\ -1 & =x+7 \\\\ x & =-8\\end{aligned}\n$$\n\nTherefore, the $x$-intercept is $-8.$"} :step/id #uuid "75a1ff4f-96ae-55ce-832c-1ac2a8ea2583" :step/next {:db/id #edb/ref 17592186495227}} {:db/id #edb/ref 17592186495227 :step/content {:db/id #edb/ref 17592186495148 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9a6a9d26-433a-5092-af7f-f5759c6b0c0d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186494670}] :answer-field/correct {:db/id #edb/ref 17592186494670} :answer-field/id #uuid "6c9e3b73-c2d8-584a-94b4-ea5f381f00cf" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186494965}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d42d975f-c622-5e1c-8f09-860b1ab55e6f" :question/math-academy-id "q-251808" :question/problem "![](images/8f/8f138ed24e1fa76264b344faf3d1a91082b5d0ecc76b66f069939c358176438f.png)\n\nThe value of the $y$-intercept of the parabola shown above  is{{field-1}}." :question/worked-solution "First, we need to find the equation of the parabola. From the diagram, we see that the parabola has a vertex at $(4,5)$ and passes through the point $(6,3).$\n\nThe general standard equation of an up- or down-opening parabola with vertex at $(h,k)$ is given by\n\n$$\n(x-h)^{2}=4p(y-k),\n$$\n\nand substituting $(h,k)=(4,5)$ into the above gives\n\n$$\n(x-4)^{2}=4p(y-5).\n$$\n\nNow, we need to find $p.$ Since the parabola passes through the point $(6,3),$ we substitute $x=6$ and $y=3$ into the equation and get\n\n$$\n\\begin{aligned}(6-4)^{2} & =4p(3-5) \\\\ 4 & =4p(-2) \\\\ p & =-\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is\n\n$$\n\\begin{aligned}(x-4)^{2} & =-2(y-5).\\end{aligned}\n$$\n\nWhen the parabola intersects the $y$-axis, we must have $x=0.$ So, we substitute $x=0$ into the equation of the parabola and solve for $y:$\n\n$$\n\\begin{aligned}(0-4)^{2} & =-2(y-5) \\\\ 16 & =-2(y-5) \\\\ -8 & =y-5 \\\\ y & =-3\\end{aligned}\n$$\n\nTherefore, the $y$-intercept is $-3.$"} :step/id #uuid "960da46e-e772-553c-8034-951c971e908d" :step/next {:db/id #edb/ref 17592186495202}} {:db/id #edb/ref 17592186495233 :step/content {:db/id #edb/ref 17592186495151 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16a63b0f-5612-5697-9957-612d1afe2968" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186494361} {:answer/id #uuid "4e986982-9ed8-549e-8c70-12068b401fa8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186494477} {:answer/id #uuid "bdd1f648-8d54-565c-aea2-285561a08bbe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186494761} {:answer/id #uuid "e0b6c92a-bb8f-5e61-895e-e5d4cb68972d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186494850} {:answer/id #uuid "eb93ffdc-f3a1-5a8a-add9-8b3ab4687a54" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186494877}] :answer-field/correct {:db/id #edb/ref 17592186494877} :answer-field/id #uuid "442e0f0e-7158-585e-a6f1-74b91f5e78ad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186494946}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "da7d6a02-447c-52f1-87f8-add9a2f9923e" :question/math-academy-id "q-73835" :question/problem "![](images/89/8965c5f1d97491db6ab606adf083d0d19d1a5812e7cd8060019b8253e9b726cd.png)\n\nWhat is the $x$-intercept of the parabola shown above?" :question/worked-solution "First, we need to find the equation of the parabola. From the diagram, we see that the parabola has a vertex at $(-2,2)$ and passes through the point $(7,5).$\n\nThe general standard equation of a left- or right-opening parabola with vertex $(h,k)$ is given by\n\n$$\n(y-k)^{2}=4p(x-h).\n$$\n\nSubstituting $(h,k)=(-2,2)$ into the above gives\n\n$$\n(y-2)^{2}=4p(x+2).\n$$\n\nNow, we need to find $p.$ Since the parabola passes through the point $(7,5),$ we substitute $x=7$ and $y=5$ into the equation and get\n\n$$\n\\begin{aligned}(5-2)^{2} & =4p(7+2) \\\\ 9 & =4p(9) \\\\ p & =\\frac{1}{4}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is\n\n$$\n\\begin{aligned}(y-2)^{2} & =(x+2).\\end{aligned}\n$$\n\nWhen the parabola intersects the $x$-axis, we must have $y=0.$ So, we substitute $y=0$ into the equation of the parabola and solve for $x:$\n\n$$\n\\begin{aligned}(0-2)^{2} & =(x+2) \\\\ 4 & =x+2 \\\\ x & =4-2 \\\\ x & =2\\end{aligned}\n$$\n\nTherefore, the $x$-intercept is $2.$"} :step/id #uuid "a17d4a2d-9cd6-514d-9640-3a0c7e5237bc" :step/next {:db/id #edb/ref 17592186495213}} {:db/id #edb/ref 17592186495271 :step/content {:db/id #edb/ref 17592186495095 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39666ba2-d1b2-597c-b370-bacf043984d9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186494437} {:answer/id #uuid "88a7cf58-d916-590f-9785-5e3e2335fcc8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186494621} {:answer/id #uuid "91de9c2e-7046-525e-8743-3f166f6387d8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186494649} {:answer/id #uuid "bef9eaf4-0153-5684-97cd-4baabb718807" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186494765} {:answer/id #uuid "f4fccee5-efce-59e3-b554-79d8ba6b664a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186494901}] :answer-field/correct {:db/id #edb/ref 17592186494437} :answer-field/id #uuid "f352a4e4-ace7-5237-beb9-55b20b2b14aa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186495037}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "67e144f2-2a3f-5e5b-9938-978ba91cf547" :question/math-academy-id "q-14160" :question/problem "![](images/2a/2a195992bbda673f38856ee5b5ea6f0f14f6cf1303df200d0125e29f365a51e3.png)\n\nWhat is the $x$-intercept of the parabola shown above?" :question/worked-solution "First, we need to find the equation of the parabola. From the diagram, we see that the parabola has a vertex at $(1,-2)$ and passes through the point $(5,2).$\n\nThe general standard equation of a left- or right-opening parabola with vertex $(h,k)$ is given by\n\n$$\n(y-k)^{2}=4p(x-h).\n$$\n\nSubstituting $(h,k)=(1,-2)$ into the above gives\n\n$$\n(y+2)^{2}=4p(x-1).\n$$\n\nNow, we need to find $p.$ Since the parabola passes through the point $(5,2),$ we substitute $x=5$ and $y=2$ into the equation and get\n\n$$\n\\begin{aligned}(2+2)^{2} & =4p(5-1) \\\\ 16 & =4p(4) \\\\ p & =1.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is\n\n$$\n\\begin{aligned}(y+2)^{2} & =4(x-1).\\end{aligned}\n$$\n\nWhen the parabola intersects the $x$-axis, we must have $y=0.$ So, we substitute $y=0$ into the equation of the parabola  and solve for $x:$\n\n$$\n\\begin{aligned}(0+2)^{2} & =4(x-1) \\\\ 4 & =4(x-1) \\\\ 1 & =x-1 \\\\ x & =1+1 \\\\ x & =2\\end{aligned}\n$$\n\nTherefore, the $x$-intercept is $2.$"} :step/id #uuid "f9932df0-eac7-523c-8872-a1bb24c06acd" :step/next {:db/id #edb/ref 17592186495233}}] :activity/title "Calculating Intercepts of Parabolas" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186494319}]}
