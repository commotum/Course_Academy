86045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467949}] :answer-field/correct {:answer/id #uuid "72991cce-897b-580a-82d9-a6ea9e4374ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467948} :answer-field/id #uuid "05c578b4-fa57-5327-837b-e40c8423b3ba" :answer-field/key "C" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468695}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "937eaf0d-76e6-56ec-a651-23458856322a" :question/math-academy-id "q-72498" :question/problem "Which of the following matrices are in row echelon form?\n\n$$\nA=\\begin{bmatrix}1 & 3 & 5 \\\\ 0 & 2 & 0 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & 1\\end{bmatrix}\n$$\n\n$$\nB=\\begin{bmatrix}0 & 4 & 6 & 10 \\\\ 0 & 0 & 6 & 7 \\\\ 0 & 0 & 0 & 1\\end{bmatrix}\n$$\n\n$$\nC=\\begin{bmatrix}3 & 5 & 0 & 2 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 3 & 4 & 1\\end{bmatrix}.\n$$\n\nSelect all that apply." :question/worked-solution "Remember that a matrix is in row echelon form if it satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n- Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$  is not in row echelon form since ${a}_{32}\\ne 0$ (condition II is violated). \n\n$$\nA=\\begin{bmatrix}1 & 3 & 5 \\\\ 0 & 2 & 0 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & 1\\end{bmatrix}\n$$\n\n- The matrix $B$ is in row echelon form (both conditions are satisfied).\n\n$$\nB=\\begin{bmatrix}0 & 4 & 6 & 10 \\\\ 0 & 0 & 6 & 7 \\\\ 0 & 0 & 0 & 1\\end{bmatrix}\n$$\n\n- The matrix $C$ is not in row echelon form since the second row contains only zeros and it is not at the bottom of the matrix (condition I is violated).\n\n$$\nC=\\begin{bmatrix}3 & 5 & 0 & 2 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 3 & 4 & 1\\end{bmatrix}\n$$\n\nTherefore, only $B$ is in row echelon form."}] [{:db/id #edb/ref 17592186341835 :knowledge-point/_questions [{:db/id #edb/ref 17592186129113 :knowledge-point/id #uuid "f5d1d859-0b86-5507-a7bf-3d805a85adf3" :knowledge-point/title "Identifying Augmented Matrices in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7311cb50-f585-5f8b-8c7c-43ea3935ca30" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467950} {:answer/id #uuid "5df8e8f3-9308-5944-af31-4d14c71a9d43" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467951}] :answer-field/correct {:answer/id #uuid "7311cb50-f585-5f8b-8c7c-43ea3935ca30" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467950} :answer-field/id #uuid "00781771-aeb9-5835-884e-fa3c06c40e7e" :answer-field/key "A" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468696} {:answer-field/choices [{:answer/id #uuid "b1ee2b9e-ef1d-59cf-bd65-2b7d6a2bf08f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467952} {:answer/id #uuid "d81beee0-f7cd-5ee1-a153-c2609ec12ad8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467953}] :answer-field/correct {:answer/id #uuid "d81beee0-f7cd-5ee1-a153-c2609ec12ad8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467953} :answer-field/id #uuid "625436a2-9099-57c0-a144-3cefd737c380" :answer-field/key "B" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468697} {:answer-field/choices [{:answer/id #uuid "a341d39f-fed1-52da-a5bf-5551842652b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467954} {:answer/id #uuid "5061ada4-2851-5b12-9dcc-a52396a7b645" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467955}] :answer-field/correct {:answer/id #uuid "5061ada4-2851-5b12-9dcc-a52396a7b645" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467955} :answer-field/id #uuid "4691ceca-21a9-5d3f-be55-1f587cc36770" :answer-field/key "C" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468698}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4f7d9000-6b1e-59bb-84e6-86f972afc228" :question/math-academy-id "q-72570" :question/problem "Which of the following augmented matrices are in row echelon form?\n\n$$\nA=\\left[\\begin{array}{ccc|c}1 & 0 & 1 & 4 \\\\ 0 & 0 & 0 & 3 \\\\ 0 & -4 & 9 & 7 \\\\ 0 & 0 & 5 & 3\\end{array}\\right]\n$$\n\n$$\nB=\\left[\\begin{array}{cccc|c}0 & 2 & 0 & 2 & 5 \\\\ 0 & 0 & 1 & 0 & 3 \\\\ 0 & 0 & 0 & 11 & 1\\end{array}\\right]\n$$\n\n$$\nC=\\left[\\begin{array}{cccc|c}7 & 6 & 6 & 8 & 2 \\\\ 0 & 1 & 3 & 6 & 3 \\\\ 0 & 0 & 0 & 4 & 6\\end{array}\\right].\n$$\n\nSelect all that apply." :question/worked-solution "Remember that an augmented matrix is in row echelon form if its coefficient matrix satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the bottom of the matrix.\n- Each leading entry of a row is in a column to the right of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is not in row echelon form since the second row contains only zeros and it is not at the bottom of the matrix (condition I is violated).\n\n$$\nA=\\left[\\begin{array}{ccc|c}1 & 0 & 1 & 4 \\\\ 0 & 0 & 0 & 3 \\\\ 0 & -4 & 9 & 7 \\\\ 0 & 0 & 5 & 3\\end{array}\\right]\n$$\n\n- The matrix $B$  is in row echelon form (both conditions are satisfied).\n\n$$\nB=\\left[\\begin{array}{cccc|c}0 & 2 & 0 & 2 & 5 \\\\ 0 & 0 & 1 & 0 & 3 \\\\ 0 & 0 & 0 & 11 & 1\\end{array}\\right]\n$$\n\n- The matrix $C$ is in row echelon form (both conditions are satisfied).\n\n$$\nC=\\left[\\begin{array}{cccc|c}7 & 6 & 6 & 8 & 2 \\\\ 0 & 1 & 3 & 6 & 3 \\\\ 0 & 0 & 0 & 4 & 6\\end{array}\\right]\n$$\n\nTherefore, only $B$ and $C$ are in row echelon form."}] [{:db/id #edb/ref 17592186341912 :knowledge-point/_questions [{:db/id #edb/ref 17592186129176 :knowledge-point/id #uuid "31c3678b-4f00-54d6-bb84-c7718fd622cb" :knowledge-point/title "Identifying the Leading Entries of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f4e341c-3d98-5b25-89d4-d22cc7d833da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186339541} {:answer/id #uuid "4ca90275-1867-5588-92e4-c504069e453d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186339823} {:answer/id #uuid "d83362ef-2e49-5554-adbe-d990d07055ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186341047 :task-item/_responses [{:db/id #edb/ref 17592186526377}]} {:answer/id #uuid "ec02ca2e-05e7-5239-8830-86756a101aa2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186341208} {:answer/id #uuid "ee593e53-439e-5886-9175-95bb3c75d6ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186341230}] :answer-field/correct {:answer/id #uuid "d83362ef-2e49-5554-adbe-d990d07055ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186341047} :answer-field/id #uuid "f911437e-8954-5fac-bd5b-2b1dad53e9a1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341824}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a5a8f2f1-6cb7-517c-b610-e099919e39b1" :question/math-academy-id "q-73145" :question/problem "What is the sum of the leading entries of the $1$st and $4$th rows in the matrix $A,$ given below?\n\n$$\nA=\\begin{bmatrix}0 & 0 & 1 & 3 \\\\ 4 & 3 & 0 & 0 \\\\ -2 & 0 & -1 & 8 \\\\ 0 & -3 & 0 & 2\\end{bmatrix}\n$$" :question/worked-solution "The first non-zero entry of each row (from left to right) is the leading entry. \n\nTherefore, the leading entries of the $1$st and $4$th rows of $A$ are $1$ and $-3$, respectively.\n\n$$\nA=\\begin{bmatrix}0 & 0 & 1 & 3 \\\\ 4 & 3 & 0 & 0 \\\\ -2 & 0 & -1 & 8 \\\\ 0 & -3 & 0 & 2\\end{bmatrix}\n$$\n\nSo, the answer is $1+(-3)=-2.$"}]}
