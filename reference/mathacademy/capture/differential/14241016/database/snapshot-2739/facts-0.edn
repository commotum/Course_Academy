5417] [17592186129939 #edb/ref 1061 17176 #edb/ref 17592186045417] [17592186129939 #edb/ref 1062 #uuid "9da7e60b-1218-59ef-a17a-68019b1df9c5" #edb/ref 17592186045417] [17592186129939 #edb/ref 1063 #edb/ref 17592186129113 #edb/ref 17592186045417] [17592186129940 #edb/ref 1058 #edb/ref 17592186129939 #edb/ref 17592186045417] [17592186129940 #edb/ref 1061 17177 #edb/ref 17592186045417] [17592186129940 #edb/ref 1062 #uuid "d00efb7b-6c6d-5f75-a839-fd2c4b29adfc" #edb/ref 17592186045417] [17592186129940 #edb/ref 1063 #edb/ref 17592186129114 #edb/ref 17592186045417] [17592186129941 #edb/ref 1061 17178 #edb/ref 17592186045417] [17592186129941 #edb/ref 1062 #uuid "ed25462b-dcf5-53b8-af91-93afa32dea4c" #edb/ref 17592186045417] [17592186129941 #edb/ref 1063 #edb/ref 17592186129115 #edb/ref 17592186045417] [17592186130041 #edb/ref 1058 #edb/ref 17592186129940 #edb/ref 17592186045417] [17592186130041 #edb/ref 1061 23024 #edb/ref 17592186045417] [17592186130041 #edb/ref 1062 #uuid "1430eddc-7fc0-5265-81de-85b9a44bbf70" #edb/ref 17592186045417] [17592186130041 #edb/ref 1063 #edb/ref 17592186130380 #edb/ref 17592186045417] [17592186130042 #edb/ref 1058 #edb/ref 17592186130041 #edb/ref 17592186045417] [17592186130042 #edb/ref 1061 23025 #edb/ref 17592186045417] [17592186130042 #edb/ref 1062 #uuid "f062c6b3-17e0-57cb-a070-e9edcc0af6c8" #edb/ref 17592186045417] [17592186130042 #edb/ref 1063 #edb/ref 17592186129176 #edb/ref 17592186045417] [17592186130339 #edb/ref 1064 "Consider the following matrices:\n\n$$\nA = \\begin{bmatrix}2 & 6 & 7 & 8 \\\\ 0 & 3 & 6 & 9 \\\\ 0 & 1 & 4 & 7 \\\\ 0 & 0 & 5 & 8\\end{bmatrix}\n$$\n\n$$\nB = \\begin{bmatrix}1 & 5 & 2 & 0 \\\\ 0 & 3 & 4 & 3 \\\\ 0 & 0 & -2 & 1 \\\\ 0 & 0 & 0 & 2 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}.\n$$\n\nThe first non-zero entry on each row (from left to right) is called the **leading entry** of that row.\n\n- In the matrix $A,$ the leading entries are $a_{11}=2,$ $a_{22}=3,$ $a_{32}=1,$ and $a_{43}=5.$\n\n- In the matrix $B,$ the leading entries are $b_{11}=1,$ $b_{22}=3,$ $b_{33}=-2,$ and $b_{44}=2.$ The $5$th row has no leading entry.\n\nThe leading entries are highlighted below.\n\n$$\nA = \\begin{bmatrix}\\bbox[lightgray, 2pt]{2} & 6 & 7 & 8 \\\\ {\\color{blue}0} & \\bbox[lightgray, 2pt]{3} & 6 & 9 \\\\ {\\color{blue}0} & \\bbox[lightgray, 2pt]{{\\color{red}1}} & 4 & 7 \\\\ {\\color{blue}0} & {\\color{blue}0} & \\bbox[lightgray, 2pt]{5} & 8\\end{bmatrix}\n$$\n\n$$\nB = \\begin{bmatrix}\\bbox[lightgray, 2pt]{1} & 5 & 2 & 0 \\\\ {\\color{blue}0} & \\bbox[lightgray, 2pt]{3} & 4 & 3 \\\\ {\\color{blue}0} & {\\color{blue}0} & \\bbox[lightgray, 2pt]{-2} & 1 \\\\ {\\color{blue}0} & {\\color{blue}0} & {\\color{blue}0} & \\bbox[lightgray, 2pt]{2} \\\\ {\\color{blue}0} & {\\color{blue}0} & {\\color{blue}0} & {\\color{blue}0}\\end{bmatrix}\n$$\n\n" #edb/ref 17592186045443] [17592186130339 #edb/ref 1065 3148 #edb/ref 17592186045417] [17592186130339 #edb/ref 1066 #uuid "24451a80-db9f-5a0f-a591-41500a69774c" #edb/ref 17592186045417] [17592186130339 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186130380 #edb/ref 1064 "Let's consider our matrices $A$ and $B$ once more, with the leading entries highlighted.\n\n$$\nA = \\begin{bmatrix}\\bbox[lightgray, 2pt]{2} & 6 & 7 & 8 \\\\ {\\color{blue}0} & \\bbox[lightgray, 2pt]{3} & 6 & 9 \\\\ {\\color{blue}0} & \\bbox[lightgray, 2pt]{{\\color{red}1}} & 4 & 7 \\\\ {\\color{blue}0} & {\\color{blue}0} & \\bbox[lightgray, 2pt]{5} & 8\\end{bmatrix}\n$$\n\n$$\nB = \\begin{bmatrix}\\bbox[lightgray, 2pt]{1} & 5 & 2 & 0 \\\\ {\\color{blue}0} & \\bbox[lightgray, 2pt]{3} & 4 & 3 \\\\ {\\color{blue}0} & {\\color{blue}0} & \\bbox[lightgray, 2pt]{-2} & 1 \\\\ {\\color{blue}0} & {\\color{blue}0} & {\\color{blue}0} & \\bbox[lightgray, 2pt]{2} \\\\ {\\color{blue}0} & {\\color{blue}0} & {\\color{blue}0} & {\\color{blue}0}\\end{bmatrix}\n$$\n\nWe say that a matrix is in **row echelon form** if it satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n\n- Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nHere, $B$ is in row echelon form since both conditions are satisfied. However, $A$ is not in row echelon form since condition II is violated: the leading entry of the third row $(a_{32}={\\color{red}1})$ is placed just below the leading entry of the second row $(a_{22}=3).$\n\nGenerally speaking, row echelon form means that we have *stairs* where each step (represented by a leading entry $\\bbox[lightgray, 3pt]{\\large\\ast}$) has a height of $1.$\n\n![](images/67/67f83c454e59d16ae80cf67a19b19f968182251a2e5d1b405e2c422e0313d5b7.png)\n\nFinally, an *augmented* matrix is in row echelon form if the coefficient matrix (i.e., the part that is to the left of the vertical bar) is in row echelon form." #edb/ref 17592186045443] [17592186130380 #edb/ref 1065 3896 #edb/ref 17592186045417] [17592186130380 #edb/ref 1066 #uuid "137b0909-9a5e-5edf-8019-24e803307903" #edb/ref 17592186045417] [17592186130380 #edb/ref 1067 "Row Echelon Form" #edb/ref 17592186045417] [17592186259883 #edb/ref 1080 "2" #edb/ref 17592186045417] [17592186259883 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186259883 #edb/ref 1083 #uuid "01b07e7c-2479-5481-937b-546fce0e0e8b" #edb/ref 17592186045417] [17592186259919 #edb/ref 1080 "-5" #edb/ref 17592186045417] [17592186259919 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186259919 #edb/ref 1083 #uuid "05056a18-4a1b-56ae-9146-37d93d4da44e" #edb/ref 17592186045417] [17592186260117 #edb/ref 1080 "4" #edb/ref 17592186045417] [17592186260117 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186260117 #edb/ref 1083 #uuid "1c6d52d6-d447-5c0f-9c71-fcb0e8a001a5" #edb/ref 17592186045417] [17592186260231 #edb/ref 1080 "-8" #edb/ref 17592186045417] [17592186260231 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186260231 #edb