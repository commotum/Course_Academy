      "assets": [],
      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14275528/observations/lesson-step-33902-ad3715f7bde4e7c08507.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14275528/observations/lesson-step-33902-ad3715f7bde4e7c08507.png",
      "source_url": "https://mathacademy.com/topics/3009",
      "captured_at": 1792227814.8890533,
      "math_academy_id": 5442,
