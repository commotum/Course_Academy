MJMAIN-34\" x=\"2280\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E21-MJMAIN-2212\" x=\"4337\" y=\"0\"></use>\n<g transform=\"translate(5338,0)\">\n <use xlink:href=\"#E21-MJMAIN-30\"></use>\n <use xlink:href=\"#E21-MJMAIN-2E\" x=\"500\" y=\"0\"></use>\n <use xlink:href=\"#E21-MJMAIN-39\" x=\"779\" y=\"0\"></use>\n <use xlink:href=\"#E21-MJMAIN-30\" x=\"1279\" y=\"0\"></use>\n <use xlink:href=\"#E21-MJMAIN-36\" x=\"1780\" y=\"0\"></use>\n <use xlink:href=\"#E21-MJMAIN-36\" x=\"2280\" y=\"0\"></use>\n</g>\n</g>\n<g transform=\"translate(0,-1776)\">\n <use xlink:href=\"#E21-MJMAIN-2248\" x=\"277\" y=\"0\"></use>\n<g transform=\"translate(1334,0)\">\n <use xlink:href=\"#E21-MJMAIN-30\"></use>\n <use xlink:href=\"#E21-MJMAIN-2E\" x=\"500\" y=\"0\"></use>\n <use xlink:href=\"#E21-MJMAIN-30\" x=\"779\" y=\"0\"></use>\n <use xlink:href=\"#E21-MJMAIN-39\" x=\"1279\" y=\"0\"></use>\n <use xlink:href=\"#E21-MJMAIN-2E\" x=\"1780\" y=\"0\"></use>\n</g>\n</g>\n</g>\n</g>\n</g>\n</svg></span></p>\n\n            </div>           \n        </div>",
      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14275528/observations/lesson-step-33986-318704b52e43cd2cf195.html",
