mjx-c2E\"></mjx-c><mjx-c class=\"mjx-c31\"></mjx-c><mjx-c class=\"mjx-c39\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mo><mjx-tstrut></mjx-tstrut></mjx-mtd></mjx-mtr></mjx-itable></mjx-table></mjx-mtable></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mtable displaystyle=\"true\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"0.8em 0.6em 0.3em\"><mtr><mtd><mi>P</mi><mo stretchy=\"false\">(</mo><mo>−</mo><mn>1.9</mn><mo>≤</mo><mi>Y</mi><mo>&lt;</mo><mn>0.49</mn><mo stretchy=\"false\">)</mo></mtd><mtd><mi></mi><mo>=</mo><mi mathvariant=\"normal\">Φ</mi><mo stretchy=\"false\">(</mo><mn>0.17</mn><mo stretchy=\"false\">)</mo><mo>−</mo><mi mathvariant=\"normal\">Φ</mi><mo stretchy=\"false\">(</mo><mo>−</mo><mn>0.3</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>≈</mo><mn>0.5675</mn><mo>−</mo><mn>0.3821</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>≈</mo><mn>0.19</mn><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
