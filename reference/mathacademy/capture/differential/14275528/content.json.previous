26 666 387 610T449 465Q449 422 429 383T381 315T301 241Q265 210 201 149L142 93L218 92Q375 92 385 97Q392 99 409 186V189H449V186Q448 183 436 95T421 3V0H50V19V31Q50 38 56 46T86 81Q115 113 136 137Q145 147 170 174T204 211T233 244T261 278T284 308T305 340T320 369T333 401T340 431T343 464Q343 527 309 573T212 619Q179 619 154 602T119 569T109 550Q109 549 114 549Q132 549 151 535T170 489Q170 464 154 447T109 429Z\"></path>\n<path stroke-width=\"1\" id=\"E11-MJMAIN-29\" d=\"M60 749L64 750Q69 750 74 750H86L114 726Q208 641 251 514T294 250Q294 182 284 119T261 12T224 -76T186 -143T145 -194T113 -227T90 -246Q87 -249 86 -250H74Q66 -250 63 -250T58 -247T55 -238Q56 -237 66 -225Q221 -64 221 250T66 725Q56 737 55 738Q55 746 60 749Z\"></path>\n<path stroke-width=\"1\" id=\"E11-MJMAIN-2E\" d=\"M78 60Q78 84 95 102T138 120Q162 120 180 104T199 61Q199 36 182 18T139 0T96 17T78 60Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E11-MJMATHI-59\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E11-MJMAIN-223C\" x=\"1041\" y=\"0\"></use>\n <use xlink:href=\"#E11-MJMATHI-4E\" x=\"2097\" y=\"0\"></use>\n <use xlink:href=\"#E11-MJMAIN-28\" x=\"2986\" y=\"0\"></use>\n <use xlink:href=\"#E11-MJMAIN-2212\" x=\"3375\" y=\"0\"></use>\n <use xlink:href=\"#E11-MJMAIN-31\" x=\"4154\" y=\"0\"></use>\n <use xlink:href=\"#E11-MJMAIN-2C\" x=\"4654\" y=\"0\"></use>\n<g transform=\"translate(5099,0)\">\n <use xlink:href=\"#E11-MJMAIN-33\"></use>\n <use xlink:href=\"#E11-MJMAIN-32\" x=\"500\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E11-MJMAIN-29\" x=\"6100\" y=\"0\"></use>\n <use xlink:href=\"#E11-MJMAIN-2E\" x=\"6490\" y=\"0\"></use>\n</g>\n</svg></span></p>\n\n            </div>           \n        </div>",
      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14275528/observations/lesson-step-33983-60ee15b5f57dfae4430a.html",
