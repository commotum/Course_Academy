        "html": "<div id=\"step-q109750\" class=\"step questionWidget\" style=\"display: block;\"><div class=\"questionWidget-header\"><div class=\"questionWidget-title\">Question 17</div><div class=\"questionWidget-calculatorIcon\"><svg enable-background=\"new 0 0 128 128\" viewBox=\"0 0 128 128\" xmlns=\"http://www.w3.org/2000/svg\"><g><path d=\"m102.11.5h-76.22c-5.75 0-10.43 4.68-10.43 10.43v106.14c0 5.75 4.68 10.43 10.43 10.43h76.22c5.75 0 10.43-4.68 10.43-10.43v-106.14c0-5.75-4.68-10.43-10.43-10.43zm6.43 116.57c0 3.55-2.88 6.43-6.43 6.43h-76.22c-3.55 0-6.43-2.88-6.43-6.43v-106.14c0-3.55 2.88-6.43 6.43-6.43h76.22c3.55 0 6.43 2.88 6.43 6.43z\"></path><path d=\"m93.96 12.83h-59.92c-2.76 0-5 2.24-5 5v16.57c0 2.76 2.24 5 5 5h59.92c2.76 0 5-2.24 5-5v-16.57c0-2.76-2.25-5-5-5zm1 21.57c0 .55-.45 1-1 1h-59.92c-.55 0-1-.45-1-1v-16.57c0-.55.45-1 1-1h59.92c.55 0 1 .45 1 1z\"></path><path d=\"m43.86 45.14h-9.82c-2.76 0-5 2.24-5 5v9.82c0 2.76 2.24 5 5 5h9.82c2.76 0 5-2.24 5-5v-9.82c0-2.76-2.24-5-5-5zm1 14.82c0 .55-.45 1-1 1h-9.82c-.55 0-1-.45-1-1v-9.82c0-.55.45-1 1-1h9.82c.55 0 1 .45 1 1z\"></path><path d=\"m68.91 45.14h-9.82c-2.76 0-5 2.24-5 5v9.82c0 2.76 2.24 5 5 5h9.82c2.76 0 5-2.24 5-5v-9.82c0-2.76-2.24-5-5-5zm1 14.82c0 .55-.45 1-1 1h-9.82c-.55 0-1-.45-1-1v-9.82c0-.55.45-1 1-1h9.82c.55 0 1 .45 1 1z\"></path><path d=\"m93.96 45.14h-9.82c-2.76 0-5 2.24-5 5v9.82c0 2.76 2.24 5 5 5h9.82c2.76 0 5-2.24 5-5v-9.82c0-2.76-2.25-5-5-5zm1 14.82c0 .55-.45 1-1 1h-9.82c-.55 0-1-.45-1-1v-9.82c0-.55.45-1 1-1h9.82c.55 0 1 .45 1 1z\"></path><path d=\"m43.86 70.7h-9.82c-2.76 0-5 2.24-5 5v9.82c0 2.76 2.24 5 5 5h9.82c2.76 0 5-2.24 5-5v-9.82c0-2.76-2.24-5-5-5zm1 14.82c0 .55-.45 1-1 1h-9.82c-.55 0-1-.45-1-1v-9.82c0-.55.45-1 1-1h9.82c.55 0 1 .45 1 1z\"></path><path d=\"m68.91 70.7h-9.82c-2.76 0-5 2.24-5 5v9.82c0 2.76 2.24 5 5 5h9.82c2.76 0 5-2.24 5-5v-9.82c0-2.76-2.24-5-5-5zm1 14.82c0 .55-.45 1-1 1h-9.82c-.55 0-1-.45-1-1v-9.82c0-.55.45-1 1-1h9.82c.55 0 1 .45 1 1z\"></path><path d=\"m43.86 96.26h-9