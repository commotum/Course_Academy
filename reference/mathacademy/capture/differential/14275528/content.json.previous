      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14275528/observations/step-t5523-b13654bdc8772d37cfef.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14275528/observations/step-t5523-b13654bdc8772d37cfef.png",
      "worked_solution": "",
