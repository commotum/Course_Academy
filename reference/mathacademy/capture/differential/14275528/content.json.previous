                  "option": "a",
                  "dom_id": "questionWidget-choiceLetterCircle-109673-a",
                  "type": "math",
                  "value": "0.32",
                  "html": "  <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"208\" style=\"font-size: 119.6%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c30\"></mjx-c><mjx-c class=\"mjx-c2E\"></mjx-c><mjx-c class=\"mjx-c33\"></mjx-c><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0.32</mn></math></mjx-assistive-mml></mjx-container>"
                },
                {
                  "option": "b",
                  "dom_id": "questionWidget-choiceLetterCircle-109673-b",
