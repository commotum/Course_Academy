#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186526110} :activity/id #uuid "b62731e5-2656-5f89-807e-c9a762affcc6" :activity/scope {:db/id #edb/ref 17592186049303 :topic/id #uuid "eae67b9f-eeff-516d-8910-5ef24609f9ed" :topic/math-academy-id 1038} :activity/steps [{:db/id #edb/ref 17592186526110 :step/content {:db/id #edb/ref 17592186250301 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "049104f3-f0f9-54a7-b34b-435d0972bf29" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2\\operatorname{sin}⁡4x+2x+C" :db/id #edb/ref 17592186247457} {:answer/id #uuid "a4eaf12f-fe73-5186-a4a3-9f8f03675c77" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2}\\operatorname{sin}⁡4x-x+C" :db/id #edb/ref 17592186248897} {:answer/id #uuid "a8ff8b54-32a2-5896-b5ee-9f76878d8456" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{sin}⁡4x-x+C" :db/id #edb/ref 17592186248926} {:answer/id #uuid "bdae4aa9-7adc-544f-8974-b9d6969f616e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}\\operatorname{sin}⁡4x-2x+C" :db/id #edb/ref 17592186249110} {:answer/id #uuid "beaa505f-9480-5438-ad07-7fb3d61dda35" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}\\operatorname{sin}⁡4x+2x+C" :db/id #edb/ref 17592186249118}] :answer-field/correct {:db/id #edb/ref 17592186249118} :answer-field/id #uuid "a9060f05-b9b2-57a4-af25-27550214ecdc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186249967}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "87059ed3-91f0-5463-8df6-00c144965662" :question/math-academy-id "q-114691" :question/problem "$\\int 4{cos}^{2}⁡2x\\,\\text{d}x=$" :question/worked-solution "Here, we use the double-angle formula for cosine that involves the ${cos}^{2}⁡\\theta $ term, given by\n\n$$\n\\operatorname{cos}⁡2\\theta =2{cos}^{2}⁡\\theta -1.\n$$\n\n \n\nRearranging, we have\n\n$$\n{cos}^{2}⁡\\theta =\\frac{1}{2}(\\operatorname{cos}⁡2\\theta +1).\n$$\n\n \n\nLetting $\\theta =2x,$ we have\n\n$$\n{cos}^{2}⁡2x=\\frac{1}{2}(\\operatorname{cos}⁡4x+1).\n$$\n\nSubstituting this into our integral, we get\n\n$$\n\\begin{aligned}\\int 4{cos}^{2}⁡2x\\,\\text{d}x & =\\int 4\\cdot \\frac{1}{2}(\\operatorname{cos}⁡4x+1)\\text{d}x \\\\  & =2\\int (\\operatorname{cos}⁡4x+1)\\text{d}x \\\\  & =2(\\frac{1}{4}\\operatorname{sin}⁡4x+x)+C \\\\  & =\\frac{1}{2}\\operatorname{sin}⁡4x+2x+C.\\end{aligned}\n$$"} :step/id #uuid "22c9038a-77de-5265-acd7-65600a8a79a2" :step/next {:db/id #edb/ref 17592186526117}} {:db/id #edb/ref 17592186526117 :step/content {:db/id #edb/ref 17592186525986 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41a6c98c-df20-52e9-b020-5b29c2031ff2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sin}⁡(\\frac{x}{2})-\\frac{x}{2}+C" :db/id #edb/ref 17592186525369} {:answer/id #uuid "5f74a86d-e3cc-5dbf-bdd7-a4113fc9ffda" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{sin}⁡(\\frac{x}{4})-\\frac{x}{4}+C" :db/id #edb/ref 17592186525448} {:answer/id #uuid "8bc4bc64-d436-586c-8553-f98dd5c6afbd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sin}⁡(\\frac{x}{4})+\\frac{x}{4}+C" :db/id #edb/ref 17592186525555} {:answer/id #uuid "8dd11786-9c3e-599a-8f4c-3162daf243f4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\operatorname{sin}⁡(\\frac{x}{2})+2x+C" :db/id #edb/ref 17592186525560} {:answer/id #uuid "f633a7e0-a621-5680-81e8-02a8418234da" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sin}⁡(\\frac{x}{2})-x+C" :db/id #edb/ref 17592186525818}] :answer-field/correct {:db/id #edb/ref 17592186525369} :answer-field/id #uuid "ffb0e851-b32c-55d6-a987-0e041012f9ec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186525982}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0dd7b4b0-db82-575a-9dad-d6a7735e5596" :question/math-academy-id "q-114700" :question/problem "$\\int [{cos}^{2}⁡(\\frac{x}{4})-1]\\text{d}x=$" :question/worked-solution "Here, we use the double-angle formula for cosine that involves the ${cos}^{2}⁡\\theta $ term, given by\n\n$$\n\\operatorname{cos}⁡2\\theta =2{cos}^{2}⁡\\theta -1.\n$$\n\n \n\nRearranging, we have\n\n$$\n{cos}^{2}⁡\\theta =\\frac{1}{2}(\\operatorname{cos}⁡2\\theta +1).\n$$\n\nLetting $\\theta =\\frac{x}{4},$ we have\n\n$$\n{cos}^{2}⁡(\\frac{x}{4})=\\frac{1}{2}[\\operatorname{cos}⁡(\\frac{x}{2})+1].\n$$\n\nSubstituting this into our integral, we get\n\n$$\n\\begin{aligned}\\int [{cos}^{2}⁡(\\frac{x}{4})-1]\\text{d}x & =\\int [\\frac{1}{2}[\\operatorname{cos}⁡(\\frac{x}{2})+1]-1]\\text{d}x \\\\  & =\\int [\\frac{1}{2}\\operatorname{cos}⁡(\\frac{x}{2})+\\frac{1}{2}-1]\\text{d}x \\\\  & =\\int [\\frac{1}{2}\\operatorname{cos}⁡(\\frac{x}{2})-\\frac{1}{2}]\\text{d}x \\\\  & =\\frac{1}{2}[2\\operatorname{sin}⁡(\\frac{x}{2})]-\\frac{1}{2}x+C \\\\  & =\\operatorname{sin}⁡(\\frac{x}{2})-\\frac{x}{2}+C.\\end{aligned}\n$$"} :step/id #uuid "4ea8b3f4-bf76-5e1c-81ed-9047be56891b" :step/next {:db/id #edb/ref 17592186526124}} {:db/id #edb/ref 17592186526123 :step/content {:db/id #edb/ref 17592186526048 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a8caffdc-7547-5a6e-a21b-aebd9ee316b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6\\pi" :db/id #edb/ref 17592186525633}] :answer-field/correct {:db/id #edb/ref 17592186525633} :answer-field/id #uuid "4a8bb75e-79be-5239-bdbe-829119163778" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186525882}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "85abb599-4be2-577d-9d0b-59402cc7e2bf" :question/math-academy-id "q-348918" :question/problem "![](images/28/28be65f566e93427105af6c87c46fa51f1a473363247f35a4aa481b93dc70090.png)\n\nA region in the $xy$-plane is bounded by the curve $y=6{sin}^{2}\\,(\\frac{x}{2}),$ the $x$-axis and the lines $x=\\frac{\\pi }{2}$ and $x=\\frac{5\\pi }{2}.$ The area of the region is\n\n$A=$\n{{field-1}}" :question/worked-solution "The area of the region bounded by the curve $y=6{sin}^{2}\\,(\\frac{x}{2}),$ the $x$-axis and the lines $x=\\frac{\\pi }{2}$ and $x=\\frac{5\\pi }{2}$ is \n\n$$\nA={\\int }_{\\pi /2}^{5\\pi /2}6{sin}^{2}\\,(\\frac{x}{2})\\,\\text{d}x.\n$$\n\nLet's recall the double-angle formula for cosine that involves the ${sin}^{2}$ term: \n\n$$\n\\operatorname{cos}⁡2\\theta =1-2{sin}^{2}⁡\\theta .\n$$\n\nWe can rearrange the above formula as\n\n$$\n\\frac{1}{2}(1-\\operatorname{cos}⁡2\\theta )={sin}^{2}⁡\\theta .\n$$\n\nLetting $\\theta =\\frac{x}{2},$ we have\n\n$$\n\\frac{1}{2}(1-\\operatorname{cos}⁡(x))={sin}^{2}\\,(\\frac{x}{2}).\n$$\n\nWe can now integrate as follows:\n\n$$\n\\begin{aligned}A & ={\\int }_{\\pi /2}^{5\\pi /2}6{sin}^{2}\\,(\\frac{x}{2})\\,\\text{d}x \\\\  & =6{\\int }_{\\pi /2}^{5\\pi /2}\\frac{1}{2}(1-\\operatorname{cos}⁡x)\\,\\text{d}x \\\\  & =3{\\int }_{\\pi /2}^{5\\pi /2}(1-\\operatorname{cos}⁡x)\\,\\text{d}x \\\\  & =3{(x-\\operatorname{sin}⁡x)|}_{\\pi /2}^{5\\pi /2} \\\\  & =3[(\\frac{5\\pi }{2}-\\operatorname{sin}⁡(\\frac{5\\pi }{2}))-(\\frac{\\pi }{2}-\\operatorname{sin}⁡(\\frac{\\pi }{2}))] \\\\  & =3[(\\frac{5\\pi }{2}-1)-(\\frac{\\pi }{2}-1)] \\\\  & =3(2\\pi ) \\\\  & =6\\pi .\\end{aligned}\n$$"} :step/id #uuid "63732813-7684-5c71-8431-64fe3a49a9ad"} {:db/id #edb/ref 17592186526124 :step/content {:db/id #edb/ref 17592186526034 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b737d1d-48cd-5a7e-b7bb-f5db76229dd4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{\\pi }^{3}}{12}+3\\pi" :db/id #edb/ref 17592186525263}] :answer-field/correct {:db/id #edb/ref 17592186525263} :answer-field/id #uuid "3fb31870-9443-5984-b41f-efc5c4e135b0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186525878}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "6c56b3c3-015d-5836-a8b0-fb20b975ad9b" :question/math-academy-id "q-347204" :question/problem "![](images/c9/c91e196377aad64db49224cb5e38c1c8336171649708ec78b9cb80ebe6803128.png)\n\nFind the area $A$ of the region in the $xy$-plane that is bounded by the curve $y=-3{cos}^{2}⁡x+3{sin}^{2}⁡x+{x}^{2}+3,$ the $x$-axis and the lines $x=-\\frac{\\pi }{2}$ and $x=\\frac{\\pi }{2},$ as shown above. Do not round the answer.\n\n$A=$\n{{field-1}}" :question/worked-solution "The area of the region is given by\n\n$$\nA={\\int }_{-\\pi /2}^{\\pi /2}(-3{cos}^{2}⁡x+3{sin}^{2}⁡x+{x}^{2}+3)\\,\\text{d}x.\n$$\n\nTo calculate this integral, we use the double-angle formula for cosine:\n\n$$\n\\operatorname{cos}⁡2x={cos}^{2}⁡x-{sin}^{2}⁡x\n$$\n\nWe can rewrite the above formula as\n\n$$\n-3\\operatorname{cos}⁡2x=-3{cos}^{2}⁡x+3{sin}^{2}⁡x.\n$$\n\nHence, the area of the region is\n\n$$\n\\begin{aligned}A & ={\\int }_{-\\pi /2}^{\\pi /2}(-3{cos}^{2}⁡x+3{sin}^{2}⁡x+{x}^{2}+3)\\,\\text{d}x \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}(-3\\operatorname{cos}⁡2x+{x}^{2}+3)\\,\\text{d}x \\\\  & =(-\\frac{3}{2}\\operatorname{sin}⁡2x+\\frac{{x}^{3}}{3}+3x)\\,{|}_{-\\pi /2}^{\\pi /2} \\\\  & =[-\\frac{3}{2}\\operatorname{sin}⁡\\pi +\\frac{(\\pi /2)^{3}}{3}+3\\cdot \\frac{\\pi }{2}]-[-\\frac{3}{2}\\operatorname{sin}⁡(-\\pi )+\\frac{(-\\pi /2)^{3}}{3}+3(-\\frac{\\pi }{2})] \\\\  & =(\\frac{{\\pi }^{3}}{24}+\\frac{3\\pi }{2})-(-\\frac{{\\pi }^{3}}{24}-\\frac{3\\pi }{2}) \\\\  & =\\frac{{\\pi }^{3}}{12}+3\\pi .\\end{aligned}\n$$"} :step/id #uuid "65228533-a96b-5158-86ba-62d6bfdac685" :step/next {:db/id #edb/ref 17592186526140}} {:db/id #edb/ref 17592186526140 :step/content {:db/id #edb/ref 17592186368397 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "da77e706-d9a4-5b1c-9d4a-e19e0cda0c6e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186368399}] :answer-field/correct {:db/id #edb/ref 17592186368399} :answer-field/id #uuid "7405319f-4787-5647-96ba-2e54876bea29" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186368398}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e44476e7-943a-5749-9df9-89cf4f9e209a" :question/math-academy-id "q-348718" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\pi /16}({cos}^{2}⁡(4x)-{sin}^{2}⁡(4x))\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Here, we use the double-angle formula for cosine:\n\n$$\n\\operatorname{cos}⁡2\\theta ={cos}^{2}⁡\\theta -{sin}^{2}⁡\\theta \n$$\n\nLetting $\\theta =4x,$ we get\n\n$$\n\\operatorname{cos}⁡(8x)={cos}^{2}⁡(4x)-{sin}^{2}⁡(4x).\n$$\n\nSubstituting this into our integral, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /16}({cos}^{2}⁡(4x)-{sin}^{2}⁡(4x))\\,\\text{d}x & ={\\int }_{0}^{\\pi /16}\\operatorname{cos}⁡(8x)\\,\\text{d}x \\\\  & =\\frac{1}{8}\\operatorname{sin}⁡(8x)\\,{|}_{0}^{\\pi /16} \\\\  & =\\frac{1}{8}[\\operatorname{sin}⁡(8\\cdot \\frac{\\pi }{16})-\\operatorname{sin}⁡(0)] \\\\  & =\\frac{1}{8}[\\operatorname{sin}⁡(\\frac{\\pi }{2})] \\\\  & =\\frac{1}{8}.\\end{aligned}\n$$"} :step/id #uuid "bd15feb8-6052-5d36-bdfc-8720cfdd00de" :step/next {:db/id #edb/ref 17592186526123}}] :activity/title "Integration Using the Double-Angle Formulas" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186525205}]}
