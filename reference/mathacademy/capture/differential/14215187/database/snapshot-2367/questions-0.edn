#{[{:db/id #edb/ref 17592186250301 :knowledge-point/_questions [{:db/id #edb/ref 17592186096666 :knowledge-point/id #uuid "b466bd78-724b-51b2-8fee-7991bf7b60d2" :knowledge-point/title "Integrating Using the Squared Cosine Variant of the Cosine Double-Angle Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "049104f3-f0f9-54a7-b34b-435d0972bf29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\operatorname{sin}⁡4x+2x+C" :db/id #edb/ref 17592186247457} {:answer/id #uuid "a4eaf12f-fe73-5186-a4a3-9f8f03675c77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\operatorname{sin}⁡4x-x+C" :db/id #edb/ref 17592186248897} {:answer/id #uuid "a8ff8b54-32a2-5896-b5ee-9f76878d8456" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡4x-x+C" :db/id #edb/ref 17592186248926} {:answer/id #uuid "bdae4aa9-7adc-544f-8974-b9d6969f616e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{sin}⁡4x-2x+C" :db/id #edb/ref 17592186249110} {:answer/id #uuid "beaa505f-9480-5438-ad07-7fb3d61dda35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{sin}⁡4x+2x+C" :db/id #edb/ref 17592186249118}] :answer-field/correct {:answer/id #uuid "beaa505f-9480-5438-ad07-7fb3d61dda35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{sin}⁡4x+2x+C" :db/id #edb/ref 17592186249118} :answer-field/id #uuid "a9060f05-b9b2-57a4-af25-27550214ecdc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249967}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "87059ed3-91f0-5463-8df6-00c144965662" :question/math-academy-id "q-114691" :question/problem "$\\int 4{cos}^{2}⁡2x\\,\\text{d}x=$" :question/worked-solution "Here, we use the double-angle formula for cosine that involves the ${cos}^{2}⁡\\theta $ term, given by\n\n$$\n\\operatorname{cos}⁡2\\theta =2{cos}^{2}⁡\\theta -1.\n$$\n\n \n\nRearranging, we have\n\n$$\n{cos}^{2}⁡\\theta =\\frac{1}{2}(\\operatorname{cos}⁡2\\theta +1).\n$$\n\n \n\nLetting $\\theta =2x,$ we have\n\n$$\n{cos}^{2}⁡2x=\\frac{1}{2}(\\operatorname{cos}⁡4x+1).\n$$\n\nSubstituting this into our integral, we get\n\n$$\n\\begin{aligned}\\int 4{cos}^{2}⁡2x\\,\\text{d}x & =\\int 4\\cdot \\frac{1}{2}(\\operatorname{cos}⁡4x+1)\\text{d}x \\\\  & =2\\int (\\operatorname{cos}⁡4x+1)\\text{d}x \\\\  & =2(\\frac{1}{4}\\operatorname{sin}⁡4x+x)+C \\\\  & =\\frac{1}{2}\\operatorname{sin}⁡4x+2x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186368397 :knowledge-point/_questions [{:db/id #edb/ref 17592186096668 :knowledge-point/id #uuid "064d3c62-5cfc-502b-aba4-48e40042593f" :knowledge-point/title "Integrating Expressions Using the Double-Angle Formula for Cosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "da77e706-d9a4-5b1c-9d4a-e19e0cda0c6e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186368399}] :answer-field/correct {:answer/id #uuid "da77e706-d9a4-5b1c-9d4a-e19e0cda0c6e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186368399} :answer-field/id #uuid "7405319f-4787-5647-96ba-2e54876bea29" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186368398}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e44476e7-943a-5749-9df9-89cf4f9e209a" :question/math-academy-id "q-348718" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\pi /16}({cos}^{2}⁡(4x)-{sin}^{2}⁡(4x))\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Here, we use the double-angle formula for cosine:\n\n$$\n\\operatorname{cos}⁡2\\theta ={cos}^{2}⁡\\theta -{sin}^{2}⁡\\theta \n$$\n\nLetting $\\theta =4x,$ we get\n\n$$\n\\operatorname{cos}⁡(8x)={cos}^{2}⁡(4x)-{sin}^{2}⁡(4x).\n$$\n\nSubstituting this into our integral, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /16}({cos}^{2}⁡(4x)-{sin}^{2}⁡(4x))\\,\\text{d}x & ={\\int }_{0}^{\\pi /16}\\operatorname{cos}⁡(8x)\\,\\text{d}x \\\\  & =\\frac{1}{8}\\operatorname{sin}⁡(8x)\\,{|}_{0}^{\\pi /16} \\\\  & =\\frac{1}{8}[\\operatorname{sin}⁡(8\\cdot \\frac{\\pi }{16})-\\operatorname{sin}⁡(0)] \\\\  & =\\frac{1}{8}[\\operatorname{sin}⁡(\\frac{\\pi }{2})] \\\\  & =\\frac{1}{8}.\\end{aligned}\n$$"}]}
