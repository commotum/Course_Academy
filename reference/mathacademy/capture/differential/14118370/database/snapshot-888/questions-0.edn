on form."}] [{:db/id #edb/ref 17592186341911 :knowledge-point/_questions [{:db/id #edb/ref 17592186129176 :knowledge-point/id #uuid "31c3678b-4f00-54d6-bb84-c7718fd622cb" :knowledge-point/title "Identifying the Leading Entries of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e91a3af-86df-59c5-8a37-2f12fc58c402" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186339395} {:answer/id #uuid "2dd4dd8e-8964-56db-b148-79e66ceb0f6e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186339531} {:answer/id #uuid "78519f26-f869-54b2-b128-24fc64cb9fb0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186340202} {:answer/id #uuid "9e00dcce-1529-5935-b71c-eed477dc8d58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186340552} {:answer/id #uuid "bec360f7-3028-58e9-a136-96375a206547" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186340828}] :answer-field/correct {:answer/id #uuid "1e91a3af-86df-59c5-8a37-2f12fc58c402" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186339395} :answer-field/id #uuid "015d858b-54ff-587e-8c9f-8f990f164c0d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341386}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9b6b5339-4232-5551-9dd0-10e8019e2d36" :question/math-academy-id "q-73143" :question/problem "What is the sum of the leading entries of the $1$st and $3$rd rows in the matrix $A,$ given below?\n\n$$\nA=[\\begin{aligned}0 & 4 & 1 & -3 \\\\ 1 & 0 & 2 & 1 \\\\ 0 & 0 & -1 & 1 \\\\ -1 & 1 & 0 & 0\\end{aligned}]\n$$" :question/worked-solution "The first non-zero entry of each row (from left to right) is the leading entry. \n\nTherefore, the leading entries of the $1$st and $3$rd rows of $A$ are $4$ and $-1$, respectively.\n\n$$\nA=[\\begin{aligned}0 & 4 & 1 & -3 \\\\ 1 & 0 & 2 & 1 \\\\ 0 & 0 & -1 & 1 \\\\ -1 & 1 & 0 & 0\\end{aligned}]\n$$\n\nSo, the answer is $4+(-1)=3.$"}]}
