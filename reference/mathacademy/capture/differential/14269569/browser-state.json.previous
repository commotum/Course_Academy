mo>⋅</mo><mn>0.1</mn><mo>+</mo><mn>1</mn><mo>⋅</mo><mn>0.3</mn><mo>+</mo><mn>4</mn><mo>⋅</mo><mn>0.6</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>0</mn><mo>+</mo><mn>0.3</mn><mo>+</mo><mn>2.4</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>2.7</mn><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
