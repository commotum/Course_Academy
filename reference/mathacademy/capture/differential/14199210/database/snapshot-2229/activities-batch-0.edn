e "Finding the Center of a Horizontal Hyperbola Given an Equation in Expanded Form"} :step/id #uuid "b1dc8460-f660-58e3-8762-125899c7b30a" :step/math-academy-id 25040 :step/next {:db/id #edb/ref 17592186084095}}] :activity/title "Equations of Hyperbolas Centered at a General Point" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186083426}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186514540} :activity/id #uuid "70bed377-303f-52ed-ba33-64c27a0f6c4c" :activity/scope {:db/id #edb/ref 17592186048866 :topic/id #uuid "c7b52193-6d93-5bed-93f0-854df4061118" :topic/math-academy-id 733} :activity/steps [{:db/id #edb/ref 17592186514497 :step/content {:db/id #edb/ref 17592186514435 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4bb0fc0f-bf85-5518-928f-1cafb2c16529" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3,0)" :db/id #edb/ref 17592186513737} {:answer/id #uuid "50670be3-e6f8-5681-b49f-24e8d755ea39" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(4,-2)" :db/id #edb/ref 17592186513751} {:answer/id #uuid "96bf2692-6abc-5e43-bb6a-a762a71a5d9f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2,4)" :db/id #edb/ref 17592186513921} {:answer/id #uuid "9c303c00-caa4-5f9d-8c1a-1ca9c6fcd03b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,-3)" :db/id #edb/ref 17592186513937} {:answer/id #uuid "cdd4a15f-4c53-5773-bc25-202bcb38bcc4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,3)" :db/id #edb/ref 17592186514065}] :answer-field/correct {:db/id #edb/ref 17592186513737} :answer-field/id #uuid "7ab6b180-5886-5fce-b593-a7f57abd9934" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186514284}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8b1e4f44-4956-589a-9c17-f83b0ba4a3a8" :question/math-academy-id "q-78875" :question/problem "What is the center of the hyperbola \n$-2{x}^{2}+{y}^{2}+12x=22?$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in the above form, we need to group $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}-2{x}^{2}+{y}^{2}+12x & =22 \\\\ {y}^{2}-2{x}^{2}+12x & =22 \\\\ {y}^{2}-2[{x}^{2}-6x] & =22 \\\\ {y}^{2}-2[(x-3)^{2}-9] & =22 \\\\ {y}^{2}-2(x-3)^{2}+18 & =22 \\\\ {y}^{2}-2(x-3)^{2} & =4 \\\\ \\frac{{y}^{2}}{4}-\\frac{(x-3)^{2}}{2} & =1.\\end{aligned}\n$$\n\nHence, the center is $(3,0).$"} :step/id #uuid "32d10c9d-46da-51f3-9257-1ce9131f007f" :step/next {:db/id #edb/ref 17592186514527}} {:db/id #edb/ref 17592186514500 :step/content {:db/id #edb/ref 17592186302439 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fab5b792-fe8a-5bf3-b4d9-010cc6a573d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186301202}] :answer-field/correct {:db/id #edb/ref 17592186301202} :answer-field/id #uuid "1360cd82-fb0b-57f8-91d5-aaa62d62524f" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186301289} {:answer-field/choices [{:answer/id #uuid "1b3a9dd1-6a77-5d0a-9cc0-431ccb0f6884" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186300088}] :answer-field/correct {:db/id #edb/ref 17592186300088} :answer-field/id #uuid "310a9df5-0f92-5142-9433-0c26f67aad66" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186301382}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e24c2ffc-0e54-5b21-812d-3a6dbc07b16e" :question/math-academy-id "q-328392" :question/problem "The center of the hyperbola $-{x}^{2}+16{y}^{2}-32y-8x=16$ is$\\,\\,($\n{{field-1}}$,$\n{{field-2}}\n$).$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in the above form, we need to group $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}-{x}^{2}+16{y}^{2}-32y-8x & =16 \\\\ 16{y}^{2}-32y-{x}^{2}-8x & =16 \\\\ 16[{y}^{2}-2y]-[{x}^{2}+8x] & =16 \\\\ 16[(y-1)^{2}-1]-[(x+4)^{2}-16] & =16 \\\\ 16(y-1)^{2}-16-(x+4)^{2}+16 & =16 \\\\ 16(y-1)^{2}-(x+4)^{2} & =16 \\\\ \\frac{(y-1)^{2}}{1}-\\frac{(x+4)^{2}}{16} & =1 \\\\ \\frac{(y-1)^{2}}{1}-\\frac{(x-(-4))^{2}}{16} & =1\\end{aligned}\n$$\n\nHence, the center of the hyperbola is $(\\,-4,1\\,).$"} :step/id #uuid "5023a990-c640-5750-a60e-6cca22cae8a6" :step/next {:db/id #edb/ref 17592186514517}} {:db/id #edb/ref 17592186514517 :step/content {:db/id #edb/ref 17592186304771 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "df1947c2-4c5f-56bf-9d0b-4973c8828c0c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186303855}] :answer-field/correct {:db/id #edb/ref 17592186303855} :answer-field/id #uuid "56d7251c-a1cf-598b-9655-1e2c61452751" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186304313} {:answer-field/choices [{:answer/id #uuid "41d2e0a6-a4d1-57d7-8789-ce431b87534a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186302871}] :answer-field/correct {:db/id #edb/ref 17592186302871} :answer-field/id #uuid "ed914e8b-dcac-57a8-86f0-9d5dbbc7cd7e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186304717}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9a7281ca-5d52-5291-98ac-5167d073adb4" :question/math-academy-id "q-328439" :question/problem "The center of the hyperbola $16{x}^{2}-9{y}^{2}-54y=-63$ is$\\,\\,($\n{{field-1}}$,$\n{{field-2}}\n$).$" :question/worked-solution "The equation of a horizontal hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in standard form, we need to group $x$ and $y$ terms and complete the squares as follows:\n\n$$\n\\begin{aligned}16{x}^{2}-9{y}^{2}-54y & =-63 \\\\ 16{x}^{2}-[\\,9{y}^{2}+54y\\,] & =-63 \\\\ 16{x}^{2}-[\\,9({y}^{2}+6y)\\,] & =-63 \\\\ 16{x}^{2}-[\\,9((y+3)^{2}-9)\\,] & =-63 \\\\ 16{x}^{2}-9(y+3)^{2}+81 & =-63 \\\\ 16{x}^{2}-9(y+3)^{2} & =-63-81 \\\\ 16{x}^{2}-9(y+3)^{2} & =-144 \\\\ \\frac{(y+3)^{2}}{{4}^{2}}-\\frac{{x}^{2}}{{3}^{2}} & =1 \\\\ \\frac{(y-(-3))^{2}}{{4}^{2}}-\\frac{{x}^{2}}{{3}^{2}} & =1\\end{aligned}\n$$\n\nHence, the center of the hyperbola is $(\\,0,-3\\,).$"} :step/id #uuid "873f02d4-780d-556f-85c8-e028c9f3e094"} {:db/id #edb/ref 17592186514527 :step/content {:db/id #edb/ref 17592186514362 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ebed1d30-fad8-5df1-9e58-87c5b6d27c3d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186514150}] :answer-field/correct {:db/id #edb/ref 17592186514150} :answer-field/id #uuid "23bd27e0-e3b8-5bc4-b875-9e4e847fe61f" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186514236} {:answer-field/choices [{:answer/id #uuid "8dae7fc1-bd49-5916-99bf-03b7065df2d0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186513898}] :answer-field/correct {:db/id #edb/ref 17592186513898} :answer-field/id #uuid "e97b146a-e8c3-55b4-8e8f-3964de4d579f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186514335}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "087134b9-662e-5552-a87e-db77c3a63f60" :question/math-academy-id "q-328385" :question/problem "The center of the hyperbola ${x}^{2}-4{y}^{2}-10x-16y=-5$ is$\\,\\,($\n{{field-1}}$,$\n{{field-2}}\n$).$" :question/worked-solution "The equation of a horizontal hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in standard form, we need to group $x$ and $y$ terms and complete the squares as follows:\n\n$$\n\\begin{aligned}{x}^{2}-4{y}^{2}-10x-16y & =-5 \\\\ ({x}^{2}-10x)-4({y}^{2}+4y) & =-5 \\\\ [(x-5)^{2}-25]-4[(y+2)^{2}-4] & =-5 \\\\ (x-5)^{2}-25-4(y+2)^{2}+16 & =-5 \\\\ (x-5)^{2}-4(y+2)^{2} & =-5+25-16 \\\\ (x-5)^{2}-4(y+2)^{2} & =4 \\\\ \\frac{(x-5)^{2}}{{2}^{2}}-\\frac{(y+2)^{2}}{{1}^{2}} & =1 \\\\ \\frac{(x-5)^{2}}{{2}^{2}}-\\frac{(y-(-2))^{2}}{{1}^{2}} & =1\\end{aligned}\n$$\n\nHence, the center of the hyperbola is $(\\,5,-2\\,).$"} :step/id #uuid "b97c8dac-8e2f-5613-956d-8cb23b94c77e" :step/next {:db/id #edb/ref 17592186514500}} {:db/id #edb/ref 17592186514540 :step/content {:db/id #edb/ref 17592186348116 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29fc55dd-0a36-5fe9-8afa-a412f482184f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,-7)" :db/id #edb/ref 17592186345725} {:answer/id #uuid "45477369-5cfb-5838-ac7c-8a2039b5ae82" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(5,6)" :db/id #edb/ref 17592186345954} {:answer/id #uuid "c9d93a45-833b-5819-891f-525832fa5ae3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-6,5)" :db/id #edb/ref 17592186347111} {:answer/id #uuid "f04d4f7f-3a1f-527e-a272-eac0df528d0a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(7,0)" :db/id #edb/ref 17592186347471} {:answer/id #uuid "fa816857-2377-506d-99ed-1824f154cdbd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-7,0)" :db/id #edb/ref 17592186347565}] :answer-field/correct {:db/id #edb/ref 17592186347565} :answer-field/id #uuid "5a7d1a45-67a4-53d7-8863-acb9f9e0da58" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186347763}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b13a790f-750b-5102-942f-27086fde32a7" :question/math-academy-id "q-78869" :question/problem "What is the center of the hyperbola $\\frac{{y}^{2}}{5}-\\frac{(x+7)^{2}}{6}=1?$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nNote that the given equation can be rewritten as follows:\n\n$$\n\\frac{(y-0)^{2}}{5}-\\frac{(x-(-7))^{2}}{6}=1\n$$\n\nIn this case, we have $h=-7$ and $k=0.$\n\nTherefore, the center of the hyperbola is $(-7,0).$"} :step/id #uuid "e0c9e754-560b-5677-918d-6b010c51852e" :step/next {:db/id #edb/ref 17592186514497}}] :activity/title "Equations of Hyperbolas Centered at a General Point" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186513516}]}
