/mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mtable displaystyle=\"true\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"0.8em 0.3em\"><mtr><mtd><mi>P</mi><mo stretchy=\"false\">(</mo><mn>2</mn><mo>≤</mo><mi>X</mi><mo>≤</mo><mn>4</mn><mo stretchy=\"false\">)</mo></mtd><mtd><mi></mi><mo>≈</mo><mi>P</mi><mo stretchy=\"false\">(</mo><mn>2</mn><mo>−</mo><mn>0.5</mn><mo>≤</mo><mi>Y</mi><mo>≤</mo><mn>4</mn><mo>+</mo><mn>0.5</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mi>P</mi><mo stretchy=\"false\">(</mo><mn>1.5</mn><mo>≤</mo><mi>Y</mi><mo>≤</mo><mn>4.5</mn><mo stretchy=\"false\">)</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
