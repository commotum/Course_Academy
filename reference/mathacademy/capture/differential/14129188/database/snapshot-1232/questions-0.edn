er/value "P(-7\\le Y\\le -6)" :db/id #edb/ref 17592186423872} {:answer/id #uuid "5aaa8fbe-c71d-5ef9-bcf8-eda3e50e0a7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P(-6\\le Y\\le -5.5)" :db/id #edb/ref 17592186423876} {:answer/id #uuid "c22abeff-6519-5c1c-b37c-17d8868df498" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P(-6.5\\le Y\\le -5)" :db/id #edb/ref 17592186423891} {:answer/id #uuid "c57399ae-8b01-53a4-8e86-b563135edb9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P(-6\\le Y\\le -5)" :db/id #edb/ref 17592186423892} {:answer/id #uuid "dbf5b6ea-b43d-5f57-aefc-8ec56c32af9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P(-6.5\\le Y\\le -5.5)" :db/id #edb/ref 17592186423894}] :answer-field/correct {:answer/id #uuid "dbf5b6ea-b43d-5f57-aefc-8ec56c32af9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P(-6.5\\le Y\\le -5.5)" :db/id #edb/ref 17592186423894} :answer-field/id #uuid "a6b743bc-d9c8-56fe-8d5e-f7334892b2c2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186423900}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "39bb09ec-48b5-5f33-adde-628ba380f524" :question/math-academy-id "q-96575" :question/problem "The discrete random variable $X\\in Z$ can be approximated by the continuous random variable $Y.$ By applying an appropriate continuity correction, $P(X=-6)$ can be approximated as" :question/worked-solution "We construct an interval around $X=-6$ with a radius of $0.5:$\n\n![](images/9f/9f21d7fe3ba1f4efa7b4e24e3d096d84825ff3712f5854c76dabccf0477f503c.png)\n\nThis gives\n\n$$\n\\begin{aligned}P(X=-6) & ≈P(-6-0.5\\le Y\\le -6+0.5) \\\\  & =P(-6.5\\le Y\\le -5.5).\\end{aligned}\n$$"}]}
