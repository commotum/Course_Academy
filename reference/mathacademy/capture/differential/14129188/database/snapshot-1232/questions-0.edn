#{[{:db/id #edb/ref 17592186161817 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186162025 :knowledge-point/id #uuid "7be1caf7-728f-5c51-b3da-64f3f7ff6fa9" :knowledge-point/title "Approximating a Probability Involving a Discrete Random Variable at a Single Point"}] :question/id #uuid "0e332257-0d6f-59e6-a2cd-8cc53dd50173" :question/math-academy-id "e-8491" :question/problem "The discrete random variable $X\\in \\mathbb Z$ can be approximated by the continuous random variable $Y.$ By applying an appropriate continuity correction, $P(X = -1)$ can be approximated as $P(a\\leq Y \\leq b).$ Find the values of $a$ and $b.$" :question/worked-solution "We construct an interval around $X=-1$ with a radius of $0.5{:}$\n\n![](images/e9/e92a0fb229125f6a9cd27c96629cd1851f3356ece0bca6aa77b8393f7a0dfd90.png)\n\nThis gives\n\n$$\n\\begin{aligned}P(X=-1) & ≈P(-1-0.5\\le Y\\le -1+0.5) \\\\  & =P(-1.5\\le Y\\le -0.5).\\end{aligned}\n$$\n\nTherefore, $a=-1.5$ and $b=-0.5.$"}] [{:db/id #edb/ref 17592186161818 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186162026 :knowledge-point/id #uuid "2d41f010-e1b6-5da8-ab37-c584d84dd5b6" :knowledge-point/title "Approximating a Probability Involving a Discrete Random Variable Over an Interval"}] :question/id #uuid "eb9d63bd-dfbb-5c37-bdd0-2dc0b9d5ac6b" :question/math-academy-id "e-8492" :question/problem "The discrete random variable $X\\in \\mathbb  Z$ can be approximated by the continuous random variable $Y.$ By applying an appropriate continuity correction, $P(-1 \\lt X \\lt 2)$ can be approximated as $P(a\\leq Y \\leq b).$ Find the values of $a$ and $b.$" :question/worked-solution "To apply the appropriate continuity correction, we first rewrite the strict inequalities using non-strict inequalities, as follows:\n\n$$\n\\begin{aligned}P(-1<X<2) & =P(0\\le X\\le 1)\\end{aligned}\n$$\n\nThen, we extend the endpoints of the interval $0 \\leq X \\leq 1$ by $0.5.$ This gives\n\n$$\n\\begin{aligned}P(0\\le X\\le 1) & ≈P(0-0.5\\le Y\\le 1+0.5) \\\\  & =P(-0.5\\le Y\\le 1.5).\\end{aligned}\n$$\n\nTherefore, $a=-0.5$ and $b=1.5.$\n\n![](images/52/52e5ddb2af86cba41ad9b05001e6a8720b973492f4cf5239031b972c5bcf2afb.png)"}] [{:db/id #edb/ref 17592186161819 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186162027 :knowledge-point/id #uuid "5d691e3a-f9c5-5c9d-863c-533abdebb948" :knowledge-point/title "Approximating a Probability Involving a Discrete Random Variable Over an Unbounded Interval"}] :question/id #uuid "a6430e40-7b8f-5d1b-a842-ec7cc6013abe" :question/math-academy-id "e-8493" :question/problem "The discrete random variable $X\\in \\mathbb Z$ can be approximated by the continuous random variable $Y.$ By applying an appropriate continuity correction, $P(X > 5)$ can be approximated as $P(Y\\geq a).$ Find the value of $a.$" :question/worked-solution "To apply the appropriate continuity correction, we first rewrite the strict inequalities using non-strict inequalities, as follows:\n\n$$\nP(X > 5) =P(X \\geq 6)\n$$\n\nThen, we extend the endpoints of the interval $X \\geq 6$ by $0.5.$ This gives\n\n$$\n\\begin{aligned}P(X\\ge 6) & ≈P(Y\\ge 6-0.5) \\\\  & =P(Y\\ge 5.5).\\end{aligned}\n$$\n\nTherefore, $a=5.5.$\n\n![](images/4b/4b6c945ad08ff50b4d306e1952947cb55d5a05899e91f254f3dde3edde9f6523.png)"}] [{:db/id #edb/ref 17592186423904 :knowledge-point/_questions [{:db/id #edb/ref 17592186162026 :knowledge-point/id #uuid "2d41f010-e1b6-5da8-ab37-c584d84dd5b6" :knowledge-point/title "Approximating a Probability Involving a Discrete Random Variable Over an Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f6c0067-ea4d-59fa-8a3a-c55e51a9774c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P(3.5\\le Y\\le 10.5)" :db/id #edb/ref 17592186423868} {:answer/id #uuid "62b2ffe4-e2bc-55b7-9142-b927851f6559" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P(3.5\\le Y\\le 11.5)" :db/id #edb/ref 17592186423878} {:answer/id #uuid "7ec0215e-cf0e-52e8-b5d2-776ea0823a8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P(4\\le Y\\le 11)" :db/id #edb/ref 17592186423882} {:answer/id #uuid "91c2b6df-1f62-55b3-84dd-69ad22009d28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P(4.5\\le Y\\le 11.5)" :db/id #edb/ref 17592186423885} {:answer/id #uuid "df77e3cb-a46c-5c4c-90d1-7a2242e8fe18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P(3\\le Y\\le 12)" :db/id #edb/ref 17592186423895}] :answer-field/correct {:answer/id #uuid "62b2ffe4-e2bc-55b7-9142-b927851f6559" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P(3.5\\le Y\\le 11.5)" :db/id #edb/ref 17592186423878} :answer-field/id #uuid "a5340225-a4b2-5d96-82e7-b3802dacd406" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186423899}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "acbfdb28-97bf-5853-92f1-7b02234a722c" :question/math-academy-id "q-132226" :question/problem "The discrete random variable $X\\in Z$ can be approximated by the continuous random variable $Y.$ By applying an appropriate continuity correction, $P(4\\le X\\le 11)$ can be approximated as" :question/worked-solution "To apply the appropriate continuity correction, we extend the endpoints of the interval $4\\le X\\le 11$ by $0.5:$\n\n$$\n\\begin{aligned}P(4\\le X\\le 11) & ≈P(4-0.5\\le Y\\le 11+0.5) \\\\  & =P(3.5\\le Y\\le 11.5)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186162679 :knowledge-point/_questions [{:db/id #edb/ref 17592186162026 :knowledge-point/id #uuid "2d41f010-e1b6-5da8-ab37-c584d84dd5b6" :knowledge-point/title "Approximating a Probability Involving a Discrete Random Variable Over an Interval"}] :question/answer-f