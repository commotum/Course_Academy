er-field/validate]} {:db/id "answer-b4a26668-5f4b-5cc5-bd3b-0f6627b55524" :answer/id #uuid "b4a26668-5f4b-5cc5-bd3b-0f6627b55524" :answer/type :answer.type/math :answer/value "P(4.5\\le Y\\le 5)" :db/ensure [:answer/validate]} {:db/id "answer-b8439328-6909-5b99-807f-3c207a09c9ff" :answer/id #uuid "b8439328-6909-5b99-807f-3c207a09c9ff" :answer/type :answer.type/math :answer/value "P(4.5\\le Y\\le 5.5)" :db/ensure [:answer/validate]} {:db/id "answer-c7e6822b-04c7-5aa7-af4d-8a07b0a0c783" :answer/id #uuid "c7e6822b-04c7-5aa7-af4d-8a07b0a0c783" :answer/type :answer.type/math :answer/value "P(4\\le Y\\le 5)" :db/ensure [:answer/validate]} {:db/id "answer-200fbb3c-40ed-5f05-be1e-0229439b9ea6" :answer/id #uuid "200fbb3c-40ed-5f05-be1e-0229439b9ea6" :answer/type :answer.type/math :answer/value "P(5\\le Y\\le 5.5)" :db/ensure [:answer/validate]} {:db/id "answer-aea03d54-47ff-5704-91a4-d89cf538b880" :answer/id #uuid "aea03d54-47ff-5704-91a4-d89cf538b880" :answer/type :answer.type/math :answer/value "P(5\\le Y\\le 6)" :db/ensure [:answer/validate]} {:db/id 17592186162679 :question/problem "The discrete random variable $X\\in Z$ can be approximated by the continuous random variable $Y.$ By applying an appropriate continuity correction, $P(1<X<5)$ can be approximated as" :question/worked-solution "To apply the appropriate continuity correction, we first rewrite the strict inequalities as follows:\n\n$$\n\\begin{aligned}P(1<X<5) & =P(2\\le X\\le 4)\\end{aligned}\n$$\n\nThen, we extend the endpoints of the interval $2\\le X\\le 4$ by $0.5:$\n\n$$\n\\begin{aligned}P(2\\le X\\le 4) & ≈P(2-0.5\\le Y\\le 4+0.5) \\\\  & =P(1.5\\le Y\\le 4.5)\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186161366 :answer-field/correct "answer-b729172a-2775-5903-9a85-cf462a6f041e" :answer-field/choices ["answer-01d60f05-c149-5def-b6ca-6ac37c02ecce" "answer-36c79b55-d3d7-513c-bea5-e6b4e2f37fb2" "answer-b729172a-2775-5903-9a85-cf462a6f04