#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186551448} :activity/id #uuid "5cfa171d-648e-5b65-a7a3-0d1f2fa3f65e" :activity/scope {:db/id #edb/ref 17592186050758 :topic/id #uuid "64548ccd-8386-51d3-93a4-ad6b2dfb666c" :topic/math-academy-id 2915} :activity/steps [{:db/id #edb/ref 17592186551361 :step/content {:db/id #edb/ref 17592186551242 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b5f2e898-94b7-5374-b014-a462691ec07c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2.520" :db/id #edb/ref 17592186550864}] :answer-field/correct {:db/id #edb/ref 17592186550864} :answer-field/id #uuid "9e82930e-38a6-55d5-be72-bb77c24e88a9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186551160}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1902a701-3e4f-5245-87f9-f7a41d88dc2e" :question/math-academy-id "q-254896" :question/problem "Suppose $a=[3,\\,2]^{T},$ and $b=[1,\\,0]^{T},$ and $p=3.$ Find the Minkowski distance between $a$ and $b.$\n\nRounded to three decimal places, ${d}_{p}(a,b)≈$\n{{field-1}}." :question/worked-solution "Recall that the Minkowski distance is defined as\n\n$$\n{d}_{p}(a,b)=‖a-b{‖}_{p}\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{p}={({\\sum }_{i=1}^{N}|{v}_{i}{|}^{p})}^{1/p}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{3}(a,b) & =‖a-b{‖}_{3} \\\\  & ={‖[\\begin{aligned}3 \\\\ 2\\end{aligned}]-[\\begin{aligned}1 \\\\ 0\\end{aligned}]‖}_{3} \\\\  & ={(|3-1{|}^{3}+|2-0{|}^{3})}^{1/3} \\\\  & ={16}^{1/3} \\\\  & ≈2.520.\\end{aligned}\n$$"} :step/id #uuid "02cb4930-9c19-5e79-99d9-884aeb31e740" :step/next {:db/id #edb/ref 17592186551443}} {:db/id #edb/ref 17592186551377 :step/content {:db/id #edb/ref 17592186551338 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93af4894-4929-5ba8-9e52-45ac424912a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186550738}] :answer-field/correct {:db/id #edb/ref 17592186550738} :answer-field/id #uuid "a03b69e0-c573-57f3-bd3a-5e82ec61e1fc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186551161}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d6f36bc2-1e9d-59b6-b406-9f6515dd271d" :question/math-academy-id "q-254908" :question/problem "Suppose $a=[2,\\,-7,\\,1]^{T}$ and $b=[-3,\\,-1,\\,5]^{T}.$ Find the Chebyshev distance between $a$ and $b.$\n\n${d}_{\\infty }(a,b)=$\n{{field-1}}" :question/worked-solution "Recall that the Chebyshev distance is defined as\n\n$$\n{d}_{\\infty }(a,b)=‖a-b{‖}_{\\infty }\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{\\infty }=max(|{v}_{1}|,|{v}_{2}|,…,|{v}_{N}|).\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{\\infty }(a,b) & =‖a-b{‖}_{\\infty } \\\\  & ={‖[\\begin{aligned}2 \\\\ -7 \\\\ 1\\end{aligned}]-[\\begin{aligned}-3 \\\\ -1 \\\\ 5\\end{aligned}]‖}_{\\infty } \\\\  & =max(|2-(-3)|,|-7-(-1)|,|1-5|) \\\\  & =max(5,6,4) \\\\  & =6.\\end{aligned}\n$$"} :step/id #uuid "26dd523e-2570-57bc-9b19-e96332194fb9" :step/next {:db/id #edb/ref 17592186551434}} {:db/id #edb/ref 17592186551434 :step/content {:db/id #edb/ref 17592186157711 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f6122a7a-6b67-5f19-8a75-76dd0a6dbb78" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186551027}] :answer-field/correct {:db/id #edb/ref 17592186551027} :answer-field/id #uuid "84463c14-3d13-5d9c-958d-8e0ba67632ec" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186154801}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3f3dda19-f980-5165-8e4e-967243f6660c" :question/math-academy-id "q-254912" :question/problem "Suppose $a=[1,\\,-2]^{T}$ and $b=[-7,\\,8]^{T}.$ Find the Chebyshev distance between $a$ and $b.$\n\n${d}_{\\infty }(a,b)=$\n{{field-1}}" :question/worked-solution "Recall that the Chebyshev distance is defined as\n\n$$\n{d}_{\\infty }(a,b)=‖a-b{‖}_{\\infty }\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{\\infty }=max(|{v}_{1}|,|{v}_{2}|,…,|{v}_{N}|).\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{\\infty }(a,b) & =‖a-b{‖}_{\\infty } \\\\  & ={‖[\\begin{aligned}1 \\\\ -2\\end{aligned}]-[\\begin{aligned}-7 \\\\ 8\\end{aligned}]‖}_{\\infty } \\\\  & =max(|1-(-7)|,|-2-8|) \\\\  & =max(8,10) \\\\  & =10.\\end{aligned}\n$$"} :step/id #uuid "a804594d-fc98-5747-be7f-efa9fc4ebf6a"} {:db/id #edb/ref 17592186551443 :step/content {:db/id #edb/ref 17592186551272 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c4e00a7-9e21-5e82-95d0-df00dc452258" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3.009" :db/id #edb/ref 17592186550506}] :answer-field/correct {:db/id #edb/ref 17592186550506} :answer-field/id #uuid "01fb3d47-a00b-57d3-a31e-ce5dfb54248f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186551059}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "462b7d51-6045-5919-bcf3-708ab4590d36" :question/math-academy-id "q-254906" :question/problem "Suppose $a=[4,\\,3,\\,1]^{T},$ and $b=[5,\\,3,\\,4]^{T},$ and $p=4.$ Find the Minkowski distance between $a$ and $b.$\n\nRounded to three decimal places, ${d}_{p}(a,b)≈$\n{{field-1}}." :question/worked-solution "Recall that the Minkowski distance is defined as\n\n$$\n{d}_{p}(a,b)=‖a-b{‖}_{p}\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{p}={({\\sum }_{i=1}^{N}|{v}_{i}{|}^{p})}^{1/p}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{4}(a,b) & =‖a-b{‖}_{4} \\\\  & ={‖[\\begin{aligned}4 \\\\ 3 \\\\ 1\\end{aligned}]-[\\begin{aligned}5 \\\\ 3 \\\\ 4\\end{aligned}]‖}_{4} \\\\  & ={(|4-5{|}^{4}+|3-3{|}^{4}+|1-4{|}^{4})}^{1/4} \\\\  & ={82}^{1/4} \\\\  & ≈3.009.\\end{aligned}\n$$"} :step/id #uuid "bd5a0f87-45ff-50ef-be33-1a497ab9f146" :step/next {:db/id #edb/ref 17592186551377}} {:db/id #edb/ref 17592186551448 :step/content {:db/id #edb/ref 17592186157704 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "563e6698-12e7-517c-80a3-ae3b8a7dbd5d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186550576}] :answer-field/correct {:db/id #edb/ref 17592186550576} :answer-field/id #uuid "232d99e7-69e3-51ba-8ae4-e89e38df88b6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186154794}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b4e0864b-df2d-5e1a-8a6f-ca4a24fdd958" :question/math-academy-id "q-254752" :question/problem "Suppose $a=[1,\\,2]^{T}$ and $b=[-1,\\,-1]^{T}.$ Find the Manhattan distance between $a$ and $b.$\n\n${d}_{1}(a,b)=$ {{field-1}}" :question/worked-solution "Recall that the Manhattan distance is defined as\n\n$$\n{d}_{1}(a,b)=‖a-b{‖}_{1}\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{1}={\\sum }_{i=1}^{N}|{v}_{i}|.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{1}(a,b) & =‖a-b{‖}_{1} \\\\  & ={‖[\\begin{aligned}1 \\\\ 2\\end{aligned}]-[\\begin{aligned}-1 \\\\ -1\\end{aligned}]‖}_{1} \\\\  & =|1-(-1)|+|2-(-1)| \\\\  & =5.\\end{aligned}\n$$"} :step/id #uuid "c444da4c-44ac-5f49-8b70-be92ed835d02" :step/next {:db/id #edb/ref 17592186551361}}] :activity/title "Euclidean, Manhattan, and Minkowski Distance" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186550351}]}
