#{[{:db/id #edb/ref 17592186157704 :knowledge-point/_questions [{:db/id #edb/ref 17592186157434 :knowledge-point/id #uuid "38d1bdc1-006f-5efa-a4b0-380bd2d331c4" :knowledge-point/title "Computing the Manhattan Distance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "563e6698-12e7-517c-80a3-ae3b8a7dbd5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186550576}] :answer-field/correct {:answer/id #uuid "563e6698-12e7-517c-80a3-ae3b8a7dbd5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186550576} :answer-field/id #uuid "232d99e7-69e3-51ba-8ae4-e89e38df88b6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186154794}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b4e0864b-df2d-5e1a-8a6f-ca4a24fdd958" :question/math-academy-id "q-254752" :question/problem "Suppose $a=[1,\\,2]^{T}$ and $b=[-1,\\,-1]^{T}.$ Find the Manhattan distance between $a$ and $b.$\n\n${d}_{1}(a,b)=$ {{field-1}}" :question/worked-solution "Recall that the Manhattan distance is defined as\n\n$$\n{d}_{1}(a,b)=‖a-b{‖}_{1}\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{1}={\\sum }_{i=1}^{N}|{v}_{i}|.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{1}(a,b) & =‖a-b{‖}_{1} \\\\  & ={‖[\\begin{aligned}1 \\\\ 2\\end{aligned}]-[\\begin{aligned}-1 \\\\ -1\\end{aligned}]‖}_{1} \\\\  & =|1-(-1)|+|2-(-1)| \\\\  & =5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186551242 :knowledge-point/_questions [{:db/id #edb/ref 17592186157435 :knowledge-point/id #uuid "5a3f27e0-ef39-5965-9fe1-d141c944ac66" :knowledge-point/title "Computing the Minkowski Distance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b5f2e898-94b7-5374-b014-a462691ec07c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.520" :db/id #edb/ref 17592186550864}] :answer-field/correct {:answer/id #uuid "b5f2e898-94b7-5374-b014-a462691ec07c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.520" :db/id #edb/ref 17592186550864} :answer-field/id #uuid "9e82930e-38a6-55d5-be72-bb77c24e88a9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186551160}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1902a701-3e4f-5245-87f9-f7a41d88dc2e" :question/math-academy-id "q-254896" :question/problem "Suppose $a=[3,\\,2]^{T},$ and $b=[1,\\,0]^{T},$ and $p=3.$ Find the Minkowski distance between $a$ and $b.$\n\nRounded to three decimal places, ${d}_{p}(a,b)≈$\n{{field-1}}." :question/worked-solution "Recall that the Minkowski distance is defined as\n\n$$\n{d}_{p}(a,b)=‖a-b{‖}_{p}\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{p}={({\\sum }_{i=1}^{N}|{v}_{i}{|}^{p})}^{1/p}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{3}(a,b) & =‖a-b{‖}_{3} \\\\  & ={‖[\\begin{aligned}3 \\\\ 2\\end{aligned}]-[\\begin{aligned}1 \\\\ 0\\end{aligned}]‖}_{3} \\\\  & ={(|3-1{|}^{3}+|2-0{|}^{3})}^{1/3} \\\\  & ={16}^{1/3} \\\\  & ≈2.520.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186551272 :knowledge-point/_questions [{:db/id #edb/ref 17592186157435 :knowledge-point/id #uuid "5a3f27e0-ef39-5965-9fe1-d141c944ac66" :knowledge-point/title "Computing the Minkowski Distance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c4e00a7-9e21-5e82-95d0-df00dc452258" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.009" :db/id #edb/ref 17592186550506}] :answer-field/correct {:answer/id #uuid "3c4e00a7-9e21-5e82-95d0-df00dc452258" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.009" :db/id #edb/ref 17592186550506} :answer-field/id #uuid "01fb3d47-a00b-57d3-a31e-ce5dfb54248f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186551059}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "462b7d51-6045-5919-bcf3-708ab4590d36" :question/math-academy-id "q-254906" :question/problem "Suppose $a=[4,\\,3,\\,1]^{T},$ and $b=[5,\\,3,\\,4]^{T},$ and $p=4.$ Find the Minkowski distance between $a$ and $b.$\n\nRounded to three decimal places, ${d}_{p}(a,b)≈$\n{{field-1}}." :question/worked-solution "Recall that the Minkowski distance is defined as\n\n$$\n{d}_{p}(a,b)=‖a-b{‖}_{p}\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{p}={({\\sum }_{i=1}^{N}|{v}_{i}{|}^{p})}^{1/p}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{4}(a,b) & =‖a-b{‖}_{4} \\\\  & ={‖[\\begin{aligned}4 \\\\ 3 \\\\ 1\\end{aligned}]-[\\begin{aligned}5 \\\\ 3 \\\\ 4\\end{aligned}]‖}_{4} \\\\  & ={(|4-5{|}^{4}+|3-3{|}^{4}+|1-4{|}^{4})}^{1/4} \\\\  & ={82}^{1/4} \\\\  & ≈3.009.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186551338 :knowledge-point/_questions [{:db/id #edb/ref 17592186157436 :knowledge-point/id #uuid "9c9c3102-21e9-590d-ad14-c09baba8b4cf" :knowledge-point/title "Computing the Chebyshev Distance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93af4894-4929-5ba8-9e52-45ac424912a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186550738}] :answer-field/correct {:answer/id #uuid "93af4894-4929-5ba8-9e52-45ac424912a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186550738} :answer-field/id #uuid "a03b69e0-c573-57f3-bd3a-5e82ec61e1fc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186551161}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d6f36bc2-1e9d-59b6-b406-9f6515dd271d" :question/math-academy-id "q-254908" :question/problem "Suppose $a=[2,\\,-7,\\,1]^{T}$ and $b=[-3,\\,-1,\\,5]^{T}.$ Find the Chebyshev distance between $a$ and $b.$\n\n${d}_{\\infty }(a,b)=$\n{{field-1}}" :question/worked-solution "Recall that the Chebyshev distance is defined as\n\n$$\n{d}_{\\infty }(a,b)=‖a-b{‖}_{\\infty }\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{\\infty }=max(|{v}_{1}|,|{v}_{2}|,…,|{v}_{N}|).\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{\\infty }(a,b) & =‖a-b{‖}_{\\infty } \\\\  & ={‖[\\begin{aligned}2 \\\\ -7 \\\\ 1\\end{aligned}]-[\\begin{aligned}-3 \\\\ -1 \\\\ 5\\end{aligned}]‖}_{\\infty } \\\\  & =max(|2-(-3)|,|-7-(-1)|,|1-5|) \\\\  & =max(5,6,4) \\\\  & =6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186157711 :knowledge-point/_questions [{:db/id #edb/ref 17592186157436 :knowledge-point/id #uuid "9c9c3102-21e9-590d-ad14-c09baba8b4cf" :knowledge-point/title "Computing the Chebyshev Distance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f6122a7a-6b67-5f19-8a75-76dd0a6dbb78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186551027}] :answer-field/correct {:answer/id #uuid "f6122a7a-6b67-5f19-8a75-76dd0a6dbb78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186551027} :answer-field/id #uuid "84463c14-3d13-5d9c-958d-8e0ba67632ec" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186154801}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3f3dda19-f980-5165-8e4e-967243f6660c" :question/math-academy-id "q-254912" :question/problem "Suppose $a=[1,\\,-2]^{T}$ and $b=[-7,\\,8]^{T}.$ Find the Chebyshev distance between $a$ and $b.$\n\n${d}_{\\infty }(a,b)=$\n{{field-1}}" :question/worked-solution "Recall that the Chebyshev distance is defined as\n\n$$\n{d}_{\\infty }(a,b)=‖a-b{‖}_{\\infty }\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{\\infty }=max(|{v}_{1}|,|{v}_{2}|,…,|{v}_{N}|).\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{\\infty }(a,b) & =‖a-b{‖}_{\\infty } \\\\  & ={‖[\\begin{aligned}1 \\\\ -2\\end{aligned}]-[\\begin{aligned}-7 \\\\ 8\\end{aligned}]‖}_{\\infty } \\\\  & =max(|1-(-7)|,|-2-8|) \\\\  & =max(8,10) \\\\  & =10.\\end{aligned}\n$$"}]}
