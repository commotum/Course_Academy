77c24e88a9" :answer-field/choices "answer-b5f2e898-94b7-5374-b014-a462691ec07c"] ["question-1902a701-3e4f-5245-87f9-f7a41d88dc2e" :question/answer-fields "answer-field-9e82930e-38a6-55d5-be72-bb77c24e88a9"] [17592186157435 :knowledge-point/questions "question-1902a701-3e4f-5245-87f9-f7a41d88dc2e"] ["question-462b7d51-6045-5919-bcf3-708ab4590d36" :question/id #uuid "462b7d51-6045-5919-bcf3-708ab4590d36"] ["question-462b7d51-6045-5919-bcf3-708ab4590d36" :question/math-academy-id "q-254906"] ["question-462b7d51-6045-5919-bcf3-708ab4590d36" :question/problem "Suppose $a=[4,\\,3,\\,1]^{T},$ and $b=[5,\\,3,\\,4]^{T},$ and $p=4.$ Find the Minkowski distance between $a$ and $b.$\n\nRounded to three decimal places, ${d}_{p}(a,b)≈$\n{{field-1}}."] ["question-462b7d51-6045-5919-bcf3-708ab4590d36" :question/worked-solution "Recall that the Minkowski distance is defined as\n\n$$\n{d}_{p}(a,b)=‖a-b{‖}_{p}\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{p}={({\\sum }_{i=1}^{N}|{v}_{i}{|}^{p})}^{1/p}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{4}(a,b) & =‖a-b{‖}_{4} \\\\  & ={‖[\\begin{aligned}4 \\\\ 3 \\\\ 1\\end{aligned}]-[\\begin{aligned}5 \\\\ 3 \\\\ 4\\end{aligned}]‖}_{4} \\\\  & ={(|4-5{|}^{4}+|3-3{|}^{4}+|1-4{|}^{4})}^{1/4} \\\\  & ={82}^{1/4} \\\\  & ≈3.009.\\end{aligned}\n$$"] ["question-462b7d51-6045-5919-bcf3-708ab4590d36" :question/difficulty :question.difficulty/moderate] ["answer-field-01fb3d47-a00b-57d3-a31e-ce5dfb54248f" :answer-field/id #uuid "01fb3d47-a00b-57d3-a31e-ce5dfb54248f"] ["answer-3c4e00a7-9e21-5e82-95d0-df00dc452258" :answer/id #uuid "3c4e00a7-9e21-5e82-95d0-df00dc452258"] ["answer-3c4e00a7-9e21-5e82-95d0-df00dc452258" :answer/type :answer.type/math] ["answer-3c4e00a7-9e21-5e82-95d0-df00dc452258" :answer/value "3.009"] ["answer-field-01fb3d47-a00b-57d3-a31e-ce5dfb54248f" :answer-field/key "field-1"] ["answer-field-01fb3d47-a00b-57d3-a31e-ce5dfb54248f" :answer-field/type :answer-field.type/blank] ["answer-field-01fb3d47-a00b-57d3-