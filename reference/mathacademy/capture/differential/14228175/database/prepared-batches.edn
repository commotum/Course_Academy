573-57f3-bd3a-5e82ec61e1fc" :answer-field/type :answer-field.type/blank] ["answer-field-a03b69e0-c573-57f3-bd3a-5e82ec61e1fc" :answer-field/correct "answer-93af4894-4929-5ba8-9e52-45ac424912a6"] ["answer-field-a03b69e0-c573-57f3-bd3a-5e82ec61e1fc" :answer-field/choices "answer-93af4894-4929-5ba8-9e52-45ac424912a6"] ["question-d6f36bc2-1e9d-59b6-b406-9f6515dd271d" :question/answer-fields "answer-field-a03b69e0-c573-57f3-bd3a-5e82ec61e1fc"] [17592186157436 :knowledge-point/questions "question-d6f36bc2-1e9d-59b6-b406-9f6515dd271d"] [17592186157711 :question/problem "Suppose $a=[1,\\,-2]^{T}$ and $b=[-7,\\,8]^{T}.$ Find the Chebyshev distance between $a$ and $b.$\n\n${d}_{\\infty }(a,b)=$\n{{field-1}}"] [17592186157711 :question/worked-solution "Recall that the Chebyshev distance is defined as\n\n$$\n{d}_{\\infty }(a,b)=‖a-b{‖}_{\\infty }\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{\\infty }=max(|{v}_{1}|,|{v}_{2}|,…,|{v}_{N}|).\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{\\infty }(a,b) & =‖a-b{‖}_{\\infty } \\\\  & ={‖[\\begin{aligned}1 \\\\ -2\\end{aligned}]-[\\begin{aligned}-7 \\\\ 8\\end{aligned}]‖}_{\\infty } \\\\  & =max(|1-(-7)|,|-2-8|) \\\\  & =max(8,10) \\\\  & =10.\\end{aligned}\n$$"] [17592186157711 :question/difficulty :question.difficulty/easy] ["answer-f6122a7a-6b67-5f19-8a75-76dd0a6dbb78" :answer/id #uuid "f6122a7a-6b67-5f19-8a75-76dd0a6dbb78"] ["answer-f6122a7a-6b67-5f19-8a75-76dd0a6dbb78" :answer/type :answer.type/math] ["answer-f6122a7a-6b67-5f19-8a75-76dd0a6dbb78" :answer/value "10"] [17592186154801 :answer-field/correct "answer-f6122a7a-6b67-5f19-8a75-76dd0a6dbb78"] [17592186154801 :answer-field/choices "answer-f6122a7a-6b67-5f19-8a75-76dd0a6dbb78"] ["activity-5cfa171d-648e-5b65-a7a3-0d1f2fa3f65e" :activity/id #uuid "5cfa171d-648e-5b65-a7a3-0d1f2fa3f65e"] ["step-c444da4c-44ac-5f49-8b70-be92ed835d02" :step/id #uuid "c444da4c-44ac-5f49-8b70-be92ed835d02"] ["step-02cb4930-9c19-5e79-99d9-884aeb31e740" :step/id #uuid "02cb4930-