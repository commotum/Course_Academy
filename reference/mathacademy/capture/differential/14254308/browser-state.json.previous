\"><mtable displaystyle=\"true\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"0.8em 0.3em\"><mtr><mtd><mo fence=\"false\" stretchy=\"false\">{</mo><mo>−</mo><mn>6</mn><mo>,</mo><mn>6</mn><mo fence=\"false\" stretchy=\"false\">}</mo><mo>⊔</mo><mo fence=\"false\" stretchy=\"false\">{</mo><mo>−</mo><mn>3</mn><mo>,</mo><mn>3</mn><mo fence=\"false\" stretchy=\"false\">}</mo></mtd><mtd><mi></mi><mo>=</mo><mo fence=\"false\" stretchy=\"false\">{</mo><mo>−</mo><mn>6</mn><mo>,</mo><mn>6</mn><mo fence=\"false\" stretchy=\"false\">}</mo><mo>∪</mo><mo fence=\"false\" stretchy=\"false\">{</mo><mo>−</mo><mn>3</mn><mo>,</mo><mn>3</mn><mo fence=\"false\" stretchy=\"false\">}</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo fence=\"false\" stretchy=\"false\">{</mo><mo>−</mo><mn>6</mn><mo>,</mo><mo>−</mo><mn>3</mn><mo>,</mo><mn>3</mn><mo>,</mo><mn>6</mn><mo fence=\"false\" stretchy=\"false\">}</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
