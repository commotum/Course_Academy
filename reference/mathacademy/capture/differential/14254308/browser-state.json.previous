mjx-itable></mjx-table></mjx-mtable></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mtable displaystyle=\"true\" columnalign=\"right left right left right left\" columnspacing=\"0em 2em 0em 2em 0em\" rowspacing=\"0.8em 0.3em\"><mtr><mtd></mtd><mtd><msub><mi>A</mi><mn>1</mn></msub></mtd><mtd></mtd><mtd><mstyle scriptlevel=\"0\"><mspace width=\"1em\"></mspace></mstyle><mo stretchy=\"false\">→</mo><mstyle scriptlevel=\"0\"><mspace width=\"1em\"></mspace></mstyle></mtd><mtd></mtd><mtd><msubsup><mi>A</mi><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"blue\"><mn>1</mn></mstyle></mrow><mo>∗</mo></msubsup><mo>=</mo><mo fence=\"false\" stretchy=\"false\">{</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mn>2</mn><mo>,</mo><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"blue\"><mn>1</mn></mstyle></mrow><mo stretchy=\"false\">)</mo><mo>,</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mn>1</mn><mo>,</mo><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"blue\"><mn>1</mn></mstyle></mrow><mo stretchy=\"false\">)</mo><mo>,</mo><mo stretchy=\"false\">(</mo><mn>0</mn><mo>,</mo><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"blue\"><mn>1</mn></mstyle></mrow><mo stretchy=\"false\">)</mo><mo fence=\"false\" stretchy=\"false\">}</mo></mtd></mtr><mtr><mtd></mtd><mtd><msub><mi>A</mi><mn>2</mn></msub></mtd><mtd></mtd><mtd><mstyle scriptlevel=\"0\"><mspace width=\"1em\"></mspace></mstyle><mo stretchy=\"false\">→</mo><mstyle scriptlevel=\"0\"><mspace width=\"1em\"></mspace></mstyle></mtd><mtd></mtd><mtd><msubsup><mi>A</mi><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"red\"><mn>2</mn></mstyle></mrow><mo>∗</mo></msubsup><mo>=</mo><mo fence=\"false\" stretchy=\"false\">{</mo><mo stretchy=\"false\">(</mo><mn>0</mn><mo>,</mo><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"red\"><mn>2</mn></mstyle></mrow><mo stretchy=\"false\">)</mo><mo>,</mo><mo stretchy=\"false\">(</mo><mn>1</mn><mo>,</mo><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"red\"><mn>2</mn></mstyle></mrow><mo stretchy=\"false\">)</mo><mo>,</mo><mo stretchy=\"false\">(</mo><mn>2</mn><mo>,</mo><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"red\"><mn>2</mn></mstyle></mrow><mo stretchy=\"false\">)</mo><mo fence=\"false\" stretchy=\"false\">}</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>Now, the disjoint union of our sets is simply the union of the associated tagged sets:\n<mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" display=\"true\" tabindex=\"0\" ctxtmenu_counter=\"148\" style=\"font-size: 119.4%; position: relative;\"><mjx-math display=\"true\" class=\"MJX-TEX\" aria-hidden=\"true\" style=\"margin-left: 0px; margin-right: 0px;\"><mjx-mtable style=\"min-width: 24.6em;\"><mjx-table><mjx-itable><mjx-mtr><mjx-mtd style=\"text-align: right; padding-right: 0px; padding-bottom: 0.4em;\"><mjx-msub><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D434 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: -0.15em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn></mjx-script></mjx-msub><mjx-mo class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c2294\"></mjx-c></mjx-mo><mjx-msub space=\"3\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D434 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: -0.15em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-script></mjx-msub><mjx-tstrut></mjx-tstrut></mjx-mtd><mjx-mtd style=\"text-align: left; padding-left: 0px; padding-bottom: 0.4em;\"><mjx-mi class=\"mjx-n\"></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c7B\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2212\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo><mjx-mo c