#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186516975} :activity/id #uuid "134b7c36-e3d4-5ff3-967c-1af7c2f8479d" :activity/scope {:db/id #edb/ref 17592186050394 :topic/id #uuid "455f5bc8-b430-5c8e-bb46-a11907e59c78" :topic/math-academy-id 1295} :activity/steps [{:db/id #edb/ref 17592186516894 :step/content {:db/id #edb/ref 17592186516794 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a2a25d0-fade-5da7-98d3-71d579549d21" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186516262} {:answer/id #uuid "53138d0d-94ec-533d-b5de-57a8e1562435" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186516287} {:answer/id #uuid "5354d7be-d996-5b5d-9ca6-24a10a4fbd73" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186516289} {:answer/id #uuid "aed3df03-2c3b-5c10-a310-ac9a1632c9c6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186516477} {:answer/id #uuid "f42861f6-846f-5a1a-8226-366618cfad81" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186516617}] :answer-field/correct {:db/id #edb/ref 17592186516289} :answer-field/id #uuid "4525fe90-b193-5b48-b3bb-abdfaeefdf59" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186516674}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3e9794d9-d867-58d6-b0bf-dba6e4bdc40f" :question/math-academy-id "q-212468" :question/problem "Let $a=[\\begin{aligned}2 \\\\ 1 \\\\ -2\\end{aligned}]$ and $b=[\\begin{aligned}x \\\\ 2 \\\\ -1\\end{aligned}].$ Given that the projection of $a$ onto $b$ is the zero vector, find the value of $x.$" :question/worked-solution "Since $a$ is a nonzero vector, its projection onto another nonzero vector $b$ equals the zero vector only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =2\\cdot x+1\\cdot 2+(-2)\\cdot (-1) \\\\  & =2x+4.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ 2x+4 & =0 \\\\ 2x & =-4 \\\\ x & =-2.\\end{aligned}\n$$"} :step/id #uuid "3c4ec6fe-fb11-5a18-8ebf-e8780276a7b7" :step/next {:db/id #edb/ref 17592186516961}} {:db/id #edb/ref 17592186516926 :step/content {:db/id #edb/ref 17592186106039 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88939758-204a-5ab7-9034-d60450399204" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨6,-2,-4⟩" :db/id #edb/ref 17592186102121} {:answer/id #uuid "961648e4-28c2-5e4c-b1db-911f5dc3af63" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{3}{2},-\\frac{1}{2},-1⟩" :db/id #edb/ref 17592186102122} {:answer/id #uuid "d1e6cd7d-a0ac-535d-a191-e4e8ca0b8b80" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨1,-\\frac{1}{3},-\\frac{2}{3}⟩" :db/id #edb/ref 17592186102123} {:answer/id #uuid "3a24079c-4167-5a11-8ac4-eef372c7c1ea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨3,-1,-2⟩" :db/id #edb/ref 17592186102124} {:answer/id #uuid "4cebf518-3e02-5857-bd19-66186fda3a11" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{3}{14},-\\frac{1}{14},-\\frac{1}{7}⟩" :db/id #edb/ref 17592186102125}] :answer-field/correct {:db/id #edb/ref 17592186102121} :answer-field/id #uuid "cf6bf71d-d3d5-59b2-ab41-dbacd3e86d0d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186102120}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f4a36c0d-31cb-5d2a-9226-813c0858b9b0" :question/math-academy-id "q-126508" :question/problem "Let $c=[\\begin{aligned}8 \\\\ -2 \\\\ -1\\end{aligned}]$ and $d=[\\begin{aligned}3 \\\\ -1 \\\\ -2\\end{aligned}].$ Find the vector projection of $c$ onto $d.$" :question/worked-solution "Using the formula for the vector projection, we obtain\n\n$$\n\\begin{aligned}{\\text{proj}}_{d}\\,c & =\\frac{c\\cdot d}{d\\cdot d}d \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{{d}_{x}^{2}+{d}_{y}^{2}+{d}_{z}^{2}}d \\\\  & =\\frac{8\\cdot 3+(-2)\\cdot (-1)+(-1)\\cdot (-2)}{{3}^{2}+(-1)^{2}+(-2)^{2}}d \\\\  & =\\frac{28}{14}⟨3,-1,-2⟩ \\\\  & =2⟨3,-1,-2⟩ \\\\  & =⟨6,-2,-4⟩.\\end{aligned}\n$$"} :step/id #uuid "7fdea43e-2ef3-540c-8eb6-285efc757bcc" :step/next {:db/id #edb/ref 17592186516894}} {:db/id #edb/ref 17592186516939 :step/content {:db/id #edb/ref 17592186297546 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ac4a220c-4b44-5159-b7eb-8c2b1ab68fba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186296175}] :answer-field/correct {:db/id #edb/ref 17592186296175} :answer-field/id #uuid "de1d1458-9eb2-52b6-8719-b51e8ec5d0d9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186297094}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "10cb6fed-87b6-5198-aad0-5655fbefff1f" :question/math-academy-id "q-316761" :question/problem "Let $r=⟨-5,1,3⟩$ and $s=⟨n,-2,4⟩.$ Given that the projection of $r$ onto $s$ is the zero vector, find the value of $n.$\n\n$n=$\n{{field-1}}" :question/worked-solution "Since $r$ is a nonzero vector, its projection onto another nonzero vector $s$ equals the zero vector only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\nr⊥s\\,⟹\\,r\\cdot s=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}r\\cdot s & ={r}_{x}\\cdot {s}_{x}+{r}_{y}\\cdot {s}_{y}+{r}_{z}\\cdot {s}_{z} \\\\  & =(-5)\\cdot n+1\\cdot (-2)+3\\cdot 4 \\\\  & =-5n-2+12 \\\\  & =10-5n.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}r\\cdot s & =0 \\\\ 10-5n & =0 \\\\ n & =2.\\end{aligned}\n$$"} :step/id #uuid "9d3d55fd-f06c-5f15-ae5b-beb6a1f0e922"} {:db/id #edb/ref 17592186516961 :step/content {:db/id #edb/ref 17592186292823 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c9690f30-61cb-55e3-b3be-9423412ca4dc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186291498}] :answer-field/correct {:db/id #edb/ref 17592186291498} :answer-field/id #uuid "5ded3ba6-b873-5edc-ad42-ba3dbe34bda9" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186292018} {:answer-field/choices [{:answer/id #uuid "b85c5fac-bb6e-52ba-91d4-28a35f00c3bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186291431}] :answer-field/correct {:db/id #edb/ref 17592186291431} :answer-field/id #uuid "a00b0035-0375-545b-9efb-1242506efe16" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186292243} {:answer-field/choices [{:answer/id #uuid "b743e448-25a3-5ca3-8f21-1794d2e50f98" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186291426}] :answer-field/correct {:db/id #edb/ref 17592186291426} :answer-field/id #uuid "d598532f-3135-56fd-b85c-ccd4cd9d4e39" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186292383}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f45b2481-615d-5372-8079-012bb701a004" :question/math-academy-id "q-275235" :question/problem "Let $c=\\begin{bmatrix}-2 \\\\ 0 \\\\ 1\\end{bmatrix}$ and $d=\\begin{bmatrix}2 \\\\ 3 \\\\ 4\\end{bmatrix}.$ Find the vector projection of $c$ onto $d.$\n\n${\\text{proj}}_{d}\\,c=⟨$\n\n{{field-1}},\n\n{{field-2}},\n\n{{field-3}}\n\n$⟩$" :question/worked-solution "Using the formula for the vector projection, we obtain\n\n$$\n\\begin{aligned}{\\text{proj}}_{d}\\,c & =\\frac{c\\cdot d}{d\\cdot d}d \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{{d}_{x}^{2}+{d}_{y}^{2}+{d}_{z}^{2}}d \\\\  & =\\frac{(-2)\\cdot 2+0\\cdot 3+1\\cdot 4}{{2}^{2}+{3}^{2}+{4}^{2}}d \\\\  & =\\frac{0}{29}d \\\\  & =⟨0,0,0⟩.\\end{aligned}\n$$"} :step/id #uuid "c6467b08-7b58-5ad5-af76-05af741961e6" :step/next {:db/id #edb/ref 17592186516939}} {:db/id #edb/ref 17592186516975 :step/content {:db/id #edb/ref 17592186441587 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47726351-7b47-5626-bb7b-c86df88ec37f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨0,0,0⟩" :db/id #edb/ref 17592186441543} {:answer/id #uuid "5f7f0f17-57fa-52b7-993d-3b6b9a55e712" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{3}{13},0,\\frac{2}{13}⟩" :db/id #edb/ref 17592186441546} {:answer/id #uuid "6ce967b6-1408-5524-8f74-a23b08c8dddb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{3}{13},\\frac{2}{13},0⟩" :db/id #edb/ref 17592186441548} {:answer/id #uuid "77159c13-4761-5c51-8623-db6f3303931c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{3}{11},0,\\frac{2}{11}⟩" :db/id #edb/ref 17592186441550} {:answer/id #uuid "c53001d4-9eb2-5ad7-92c6-63c38e3c778d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{2}{13},0,\\frac{3}{13}⟩" :db/id #edb/ref 17592186441564}] :answer-field/correct {:db/id #edb/ref 17592186441546} :answer-field/id #uuid "bba96ab3-dc17-5fca-8684-49c3032dcc63" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186441576}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c0976e49-e373-59e5-b244-6a3f86c33d78" :question/math-academy-id "q-19213" :question/problem "Let $a=\\begin{bmatrix}3 \\\\ 0 \\\\ 2\\end{bmatrix}$ and $b=\\begin{bmatrix}1 \\\\ 14 \\\\ -1\\end{bmatrix}.$ Find the vector projection of $b$ onto $a.$" :question/worked-solution "Using the formula for the vector projection, we obtain \n\n$$\n\\begin{aligned}{\\text{proj}}_{a}\\,b & =\\frac{a\\cdot b}{a\\cdot a}a \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{{a}_{x}^{2}+{a}_{y}^{2}+{a}_{z}^{2}}a \\\\  & =\\frac{3\\cdot 1+0\\cdot 14+2\\cdot (-1)}{{3}^{2}+{0}^{2}+{2}^{2}}a \\\\  & =\\frac{1}{13}⟨3,0,2⟩ \\\\  & =⟨\\frac{3}{13},0,\\frac{2}{13}⟩.\\end{aligned}\n$$"} :step/id #uuid "e3d8663d-8e07-5d28-a2bb-2551ee604b3e" :step/next {:db/id #edb/ref 17592186516926}}] :activity/title "Calculating a Vector Projection" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186516087}]}
