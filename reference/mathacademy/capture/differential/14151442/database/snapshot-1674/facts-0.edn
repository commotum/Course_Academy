92234 #edb/ref 1038 #edb/ref 17592186357565 #edb/ref 17592186045417] [17592186092234 #edb/ref 1038 #edb/ref 17592186357567 #edb/ref 17592186045417] [17592186092234 #edb/ref 1038 #edb/ref 17592186426811 #edb/ref 17592186045417] [17592186092234 #edb/ref 1038 #edb/ref 17592186446963 #edb/ref 17592186045417] [17592186092234 #edb/ref 1039 "Calculating the Components of an Eigenvector Corresponding to an Eigenvalue" #edb/ref 17592186045417] [17592186092234 #edb/ref 1041 #edb/ref 17592186092079 #edb/ref 17592186045417] [17592186092234 #edb/ref 1042 #uuid "cc3c9f32-7ac7-5c2c-b337-70fcfbc802b9" #edb/ref 17592186045417] [17592186092235 #edb/ref 1038 #edb/ref 17592186092905 #edb/ref 17592186045417] [17592186092235 #edb/ref 1038 #edb/ref 17592186092906 #edb/ref 17592186045417] [17592186092235 #edb/ref 1038 #edb/ref 17592186244043 #edb/ref 17592186045417] [17592186092235 #edb/ref 1038 #edb/ref 17592186244044 #edb/ref 17592186045417] [17592186092235 #edb/ref 1038 #edb/ref 17592186244113 #edb/ref 17592186045417] [17592186092235 #edb/ref 1038 #edb/ref 17592186348362 #edb/ref 17592186045417] [17592186092235 #edb/ref 1038 #edb/ref 17592186348363 #edb/ref 17592186045417] [17592186092235 #edb/ref 1038 #edb/ref 17592186357576 #edb/ref 17592186045417] [17592186092235 #edb/ref 1038 #edb/ref 17592186357584 #edb/ref 17592186045417] [17592186092235 #edb/ref 1038 #edb/ref 17592186426812 #edb/ref 17592186045417] [17592186092235 #edb/ref 1038 #edb/ref 17592186426813 #edb/ref 17592186045417] [17592186092235 #edb/ref 1038 #edb/ref 17592186444364 #edb/ref 17592186045417] [17592186092235 #edb/ref 1038 #edb/ref 17592186444366 #edb/ref 17592186045417] [17592186092235 #edb/ref 1038 #edb/ref 17592186446962 #edb/ref 17592186045417] [17592186092235 #edb/ref 1039 "Finding Two Linearly Independent Eigenvectors of a 2x2 Matrix" #edb/ref 17592186045417] [17592186092235 #edb/ref 1041 #edb/ref 17592186092080 #edb/ref 17592186045417] [17592186092235 #edb/ref 1042 #uuid "022c4cb4-d6f6-56a5-a6dc-3adfc5aabda7" #edb/ref 17592186045417] [17592186092465 #edb/ref 1043 #edb/ref 17592186093075 #edb/ref 17592186045417] [17592186092465 #edb/ref 1043 #edb/ref 17592186093076 #edb/ref 17592186045417] [17592186092465 #edb/ref 1043 #edb/ref 17592186093077 #edb/ref 17592186045417] [17592186092465 #edb/ref 1043 #edb/ref 17592186093078 #edb/ref 17592186045417] [17592186092465 #edb/ref 1043 #edb/ref 17592186093079 #edb/ref 17592186045417] [17592186092465 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186092465 #edb/ref 1045 "Calculating the Eigenvectors of a 2x2 Matrix" #edb/ref 17592186045417] [17592186092465 #edb/ref 1046 #edb/ref 17592186093075 #edb/ref 17592186045417] [17592186092465 #edb/ref 1049 #edb/ref 17592186048775 #edb/ref 17592186045417] [17592186092465 #edb/ref 1050 660.0 #edb/ref 17592186045417] [17592186092465 #edb/ref 1053 #uuid "e1c96bbd-1fde-5a80-973f-5b7f6ca284d0" #edb/ref 17592186045417] [17592186092687 #edb/ref 1068 #edb/ref 17592186090322 #edb/ref 17592186045417] [17592186092687 #edb/ref 1069 "q-36749" #edb/ref 17592186045417] [17592186092687 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186092687 #edb/ref 1071 "If $v=[\\begin{aligned}a \\\\ b\\end{aligned}]$ is an eigenvector of \n$A=[\\begin{aligned}7 & 5 \\\\ -4 & -5\\end{aligned}]$\nthat corresponds to the eigenvalue $\\lambda =5,$\nthen what is the value of $\\frac{a}{b}?$" #edb/ref 17592186045417] [17592186092687 #edb/ref 1072 #uuid "1dbb2180-f084-5fd4-8f75-1faa7ff7aa82" #edb/ref 17592186045417] [17592186092687 #edb/ref 1074 "To compute the eigenvectors of a matrix, we need to find non-zero solutions of the matrix equation \n\n$$\n(A-\\lambda I)\\text{x}=0.\n$$\n\n \n\nIn our case, we have $\\,\\lambda =5.$ So, we get \n\n$$\n\\begin{aligned}A-\\lambda I & =[\\begin{aligned}7 & 5 \\\\ -4 & -5\\end{aligned}]-5[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 5 \\\\ -4 & -10\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have a system of linear equations \n\n$$\n\\{\\begin{aligned}2{x}_{1}+5{x}_{2}=0 \\\\ -4{x}_{1}-10{x}_{2}=0\\end{aligned}\n$$\n\nwith the augmented matrix $M$ which we reduce to row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}2 & 5 & 0 \\\\ -4 & -10 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}2 & 5 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nIn the reduced matrix above, there is one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. \n\nFrom the first equation, we obtain \n\n$$\n2{x}_{1}+5{x}_{2}=0\\,⟹\\,{x}_{1}=-\\frac{5}{2}{x}_{2}.\n$$\n\nHence, the general solution is\n\n$$\n[\\begin{aligned}-\\frac{5}{2}{x}_{2} \\\\ {x}_{2}\\end{aligned}],\\,{x}_{2}\\in R.\n$$\n\nSetting, for instance, ${x}_{2}=2,$ we get the eigenvector \n\n$$\nv=[\\begin{aligned}a \\\\ b\\end{aligned}]=[\\begin{aligned}-5 \\\\ 2\\end{aligned}].\n$$\n\nFinally, $\\frac{a}{b}=\\frac{-5}{2}=-\\frac{5}{2}.$" #edb/ref 17592186045417] [17592186093075 #edb/ref 1058 #edb/ref 17592186093077 #edb/ref 17592186045417] [17592186093075 #edb/ref 1061 20088 #edb/ref 17592186045417] [17592186093075 #edb/ref 1062 #uuid "a47c9656-c51a-58d2-a0dd-f88dacd21b14" #edb/ref 17592186045417] [17592186093075 #edb/ref 1063 #edb/ref 17592186093440 #edb/ref 17592186045417] [17592186093076 #edb/ref 1058 #edb/ref 17592186093078 #edb/ref 17592186045417] [17592186093076 #edb/ref 1061 20089 #edb/ref 17592186045417] [17592186093076 #edb/ref 1062 #uuid "96b57363-6414-5170-aa47-40a20b85159c" #edb/ref 17592186045417] [17592186093076 #edb/ref 1063 #edb/ref 17592186092233 #edb/ref 17592186045417] [17592186093077 #edb/ref 1058 #edb/ref 17592186093076 #edb/ref 17592186045417] [17592186093077 #edb/ref 1061 20090 #edb/ref 17592186045417] [17592186093077 #edb/ref 1062 #uuid "4346b6e9-b1f3-5e72-a0bc-acca6bf07e34" #edb/ref 17592186045417] [17592186093077 #edb/ref 1063 #edb/ref 17592186092234 #edb/ref 17592186045417] [17592186093078 #edb/ref 1058 #edb/ref 17592186093079 #edb/ref 17592186045417] [17592186093078 #edb/ref 1061 20091 #edb/ref 17592186045417] [17592186093078 #edb/ref 1062 #uuid "b551a89c-7046-5a16-b776-1bf76d285e27" #edb/ref 17592186045417] [17592186093078 #edb/ref 1063 #edb/ref 17592186093441 #edb/ref 17592186045417] [17592186093079 #edb/ref 1061 20092 #edb/ref 17592186045417] [17592186093079 #edb/ref 1062 #uuid "80c21f2c-61fd-5d44-98f9-6a51e9812c73" #edb/ref 17592186045417] [17592186093079 #edb/ref 1063 #edb/ref 17592186092235 #edb/ref 17592186045417] [17592186093440 #edb/ref 1064 "Consider the matrix ![](images/30/30880937eed54b00cb0ebe13bd2a46e2634e4193343b1db552b30836ed1e055b.svg) Given that $\\lambda=3$ is an eigenvalue of $A,$ how can we find an eigenvector that corresponds to this eigenvalue?\n\nRecall that a non-zero vector $\\color{blue}\\mathbf{v}$ is an eigenvector of $A$ with corresponding eigenvalue $\\lambda$ if \n\n$$\nA{\\color{blue}\\mathbf{v}}={\\color{red}\\lambda}{\\color{blue}\\mathbf{v}}.\n$$\n\nWe can rewrite this equation, substituting ${\\color{red}{\\lambda = 3}},$ as follows:\n\n$$\n\\begin{aligned}Av & =3v \\\\ Av-3v & =0 \\\\ Av-3Iv & =0 \\\\ (A-3I)v & =0\\end{aligned}\n$$\n\nSo, to find an eigenvector of $A$ that corresponds to $\\lambda = {\\color{red}3},$ we need to find a non-zero solution of the equation \n\n$$\n(A- {\\color{red}3} I){\\color{blue}\\mathbf{v}} = \\mathbf{0}.\n$$\n\nIn our case, we have\n\n$$\n\\begin{aligned}A-3I & =[\\begin{aligned}2 & 6 \\\\ 0 & 3\\end{aligned}]-3[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & 6 \\\\ 0 & 0\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the equation $(A- {\\color{red}3} I){\\color{blue}\\mathbf{v}} = \\mathbf{0}$ corresponds to the following homogeneous system of linear equations:\n\n$$\n\\{\\begin{aligned}-{x}_{1}+6{x}_{2}=0 \\\\ 0=0.\\end{aligned}\n$$\n\nNotice that $A-{\\color{red}3}I$ is already in row echelon form, and it has one pivot column (the $1$st one). So, $x_2$ is a free variable. Moreover, from the first equation, we get $x_1=6x_2,$ which implies that the general solution is\n\n![](images/fa/fa0625bc99de3a27874b5695e72c9fd2e41ab618e49228086df7efcf7e1bb04f.svg)\n\nWe only require one eigenvector corresponding to $\\lambda={\\color{red}3}.$ Setting $x_2=1,$ we obtain the eigenvector\n\n![](images/bc/bcd87529387e7c400b7f5ccd896cfcbe3e42ab386a5b9d84b565f12752e2c4c3.svg) \n\n**Note:** If we set $x_2=2,$ we'll get a different eigenvector, namely\n![](images/83/83541fd42d19f0e3b17be1c36983d50d1382f36352168bce2d148126db7bf265.svg)\nNote that $\\mathbf w$ is also an eigenvector that corresponds to $\\lambda=3.$ In fact, we can choose any real $x_2 \\neq 0$ to generate an eigenvector corresponding to $\\lambda = 3.$ \n\n**Watch out!** In the case of $x_2=0,$ we get the zero vector, but this is not an eigenvector. Remember that eigenvectors must be non-zero vectors." #edb/ref 17592186045417] [17592186093440 #edb/ref 1065 3562 #edb/ref 17592186045417] [17592186093440 #edb/ref 1066 #uuid "c585e113-f22f-5b5f-bfef-b3b81cd21acc" #edb/ref 17592186045417] [17592186093440 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186093441 #edb/ref 1064 "Given a matrix $A$ with an eigenvalue $\\lambda$, the **eigenspace** $V_\\lambda$ can be defined as the set of all possible eigenvectors corresponding to $\\lambda$ plus the vector $\\mathbf{0}{:}$\n![](images/78/78c2c84d57ef00f32675c6d56fa91af39e0680eadf05ec266b0bdab9a57a8388.svg)\n\nNote that the eigenspace consists of *all* (not only non-zero) solutions of the equation $(A-\\lambda I)\\mathbf{x}=\\mathbf{0}.$ So, the eigenspace can also be viewed as the *null space* of the matrix $A-\\lambda I,$ as follows:\n\n$$\nV_{\\color{red}\\lambda} = \\textrm{Null}(A - {\\color{red}\\lambda} I).\n$$\n\nWe also have the following theorem:\n\n*Eigenvectors that correspond to different eigenvalues are always linearly independent.*\n\nFor example, the matrix \n\n![](images/e3/e3c63b7efcb927079757e6f0e3e008a6f5038e11957524f51e1b1f45fdecd5f7.svg)\n\nhas eigenvalues $\\lambda_1=-2$ and $\\lambda_2=-1,$ for which the corresponding eigenvectors are \n\n![](images/1c/1c5df8239dae6efdd15a27498a9535b855004e3570c8eff46534993b9ec1e75f.svg) \n\nHere, $\\mathbf{v}_1$ and $\\mathbf{v}_2$ are linearly independent (they are not collinear).\n\n**Watch out!** Eigenvectors that correspond to the *same* eigenvalue *can be* (and very often *will* be) linearly dependent. For example, the vectors\n\n![](images/c3/c303fb73d6fc039bfa536d6f7de3103e774d913d2514c10c17d59fcf48d5bf00.svg)\n\nare collinear eigenvectors of the matrix $A$ above that correspond to $\\lambda_2=-1.$" #edb/ref 17592186045417] [17592186093441 #edb/ref 1065 3563 #edb/ref 17592186045417] [17592186093441 #edb/ref 1066 #uuid "98b63ece-dfc2-522f-bf9d-260df06b75a7" #edb/ref 17592186045417] [17592186093441 #edb/ref 1067 "Connection Between Eigenspaces and Null Spaces" #edb/ref 17592186045417] [17592186241223 #edb/ref 1080 "[\\begin{aligned}3 \\\\ -2\\end{aligned}],[\\begin{aligned}-1 \\\\ 3\\end{aligned}]" #edb/ref 17592186045417] [17592186241223 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186241223 #edb/ref 1083 #uuid "05115124-1a53-5cb6-8003-cea6ff11b78c" #edb/ref 17592186045417] [17592186241750 #edb/ref 1080 "[\\begin{aligned}-3 \\\\ 1\\end{aligned}],[\\begin{aligned}2 \\\\ 1\\end{aligned}]" #edb/ref 17592186045417] [17592186241750 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186241750 #edb/ref 1083 #uuid "3f893330-42b5-56f2-9220-00273e71b609" #edb/ref 17592186045417] [17592186241786 #edb/ref 1080 "[\\begin{aligned}3 \\\\ 2\\end{aligned}],[\\begin{aligned}-1 \\\\ 3\\end{aligned}]" #edb/ref 17592186045417] [17592186241786 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186241786 #edb/ref 1083 #uuid "435f1850-d288-523b-a8aa-8916b569250c" #edb/ref 17592186045417] [17592186241931 #edb/ref 1080 "[\\begin{aligned}-3 \\\\ 0\\end{aligned}],[\\begin{aligned}-1 \\\\ 2\\end{aligned}]" #edb/ref 17592186045417] [17592186241931 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186241931 #edb/ref 1083 #uuid "53dd0cbf-1108-5612-85c1-5408607627c4" #edb/ref 17592186045417] [17592186242036 #edb/ref 1080 "[\\begin{aligned}3 \\\\ 2\\end{aligned}],[\\begin{aligned}2 \\\\ 3\\end{aligned}]" #edb/ref 17592186045417] [17592186242036 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186242036 #edb/ref 1083 #uuid "5f1fcf80-617c-5563-90ed-1451b4a3cf47" #edb/ref 17592186045417] [17592186242178 #edb/ref 1080 "[\\begin{aligned}-9 \\\\ 1\\end{aligned}],[\\begin{aligned}1 \\\\ 2\\end{aligned}]" #edb/ref 17592186045417] [17592186242178 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186242178 #edb/ref 1083 #uuid "7007dddf-e54c-5993-b095-65efb51f09ad" #edb/ref 17592186045417] [17592186242746 #edb/ref 1080 "[\\begin{aligned}-3 \\\\ 1\\end{aligned}],[\\begin{aligned}1 \\\\ 2\\end{aligned}]" #edb/ref 17592186045417] [17592186242746 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186242746 #edb/ref 1083 #uuid "b389358f-191d-50dd-bbca-67f426593422" #edb/ref 17592186045417] [17592186242942 #edb/ref 1080 "[\\begin{aligned}-1 \\\\ 3\\end{aligned}],[\\begin{aligned}1 \\\\ -2\\end{aligned}]" #edb/ref 17592186045417] [17592186242942 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186242942 #edb/ref 1083 #uuid "c7204dd1-3ec6-5487-b47e-cf21b00eaf28" #edb/ref 17592186045417] [17592186243150 #edb/ref 1080 "[\\begin{aligned}3 \\\\ 4\\end{aligned}],[\\begin{aligned}1 \\\\ 3\\end{aligned}]" #edb/ref 17592186045417] [17592186243150 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186243150 #edb/ref 1083 #uuid "dd949d5d-2970-50bd-9492-7fd82465e0d4" #edb/ref 17592186045417] [17592186243333 #edb/ref 1080 "[\\begin{aligned}3 \\\\ 2\\end{aligned}],[\\begin{aligned}-1 \\\\ 9\\end{aligned}]" #edb/ref 17592186045417] [17592186243333 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186243333 #edb/ref 1083 #uuid "f2fc166d-04ae-54f0-a64b-80c5d6d1ff2f" #edb/ref 17592186045417] [17592186243477 #edb/ref 1075 #edb/ref 17592186241750 #edb/ref 17592186045417] [17592186243477 #edb/ref 1075 #edb/ref 17592186241931 #edb/ref 17592186045417] [17592186243477 #edb/ref 1075 #edb/ref 17592186242178 #edb/ref 17592186045417] [17592186243477 #edb/ref 1075 #edb/ref 17592186242746 #edb/ref 17592186045417] [17592186243477 #edb/ref 1075 #edb/ref 17592186242942 #edb/ref 17592186045417] [17592186243477 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186243477 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186243477 #edb/ref 1078 #edb/ref 17592186242746 #edb/ref 17592186045417] [17592186243477 #edb/ref 1079 #uuid "1736c56f-53d5-57a8-ab4b-915da45ce5e0" #edb/ref 17592186045417] [17592186243529 #edb/ref 1075 #edb/ref 17592186241223 #edb/ref 17592186045417] [17592186243529 #edb/ref 1075 #edb/ref 17592186241786 #edb/ref 17592186045417] [17592186243529 #edb/ref 1075 #edb/ref 17592186242036 #edb/ref 17592186045417] [17592186243529 #edb/ref 1075 #edb/ref 17592186243150 #edb/ref 17592186045417] [17592186243529 #edb/ref 1075 #edb/ref 17592186243333 #edb/ref 17592186045417] [17592186243529 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186243529 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186243529 #edb/ref 1078 #edb/ref 17592186241786 #edb/ref 17592186045417] [17592186243529 #edb/ref 1079 #uuid "301ea14a-63b8-59ee-a296-94bb1854e12e" #edb/ref 17592186045417] [17592186244043 #edb/ref 1068 #edb/ref 17592186243477 #edb/ref 17592186045417] [17592186244043 #edb/ref 1069 "q-107305" #edb/ref 17592186045417] [17592186244043 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186244043 #edb/ref 1071 "Given that $\\lambda =3$ and $\\lambda =10$ are the eigenvalues of the matrix\n$A=[\\begin{aligned}4 & 3 \\\\ 2 & 9\\end{aligned}]$,\nfind two linearly independent eigenvectors of $A.$" #edb/ref 17592186045417] [17592186244043 #edb/ref 1072 #uuid "5874be66-1b30-5ade-b2d0-93cee1c2df7e" #edb/ref 17592186045417] [17592186244043 #edb/ref 1074 "To compute the eigenvectors of a matrix, we need to find non-zero solutions of the matrix equation \n\n$$\n(A-\\lambda I)\\text{x}=0.\n$$\n\nWith that in mind, let's consider each of the eigenvalues separately. \n\n- For $\\lambda =3,$ we have\n\n$$\n\\begin{aligned}A-\\lambda I & =[\\begin{aligned}4 & 3 \\\\ 2 & 9\\end{aligned}]-3[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 3 \\\\ 2 & 6\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have a system of linear equations \n\n$$\n\\{\\begin{aligned}{x}_{1}+3{x}_{2}=0 \\\\ 2{x}_{1}+6{x}_{2}=0\\end{aligned}\n$$\n\nwith the augmented matrix $M$ which we reduce to row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 3 & 0 \\\\ 2 & 6 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 3 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nIn the reduced matrix above, there is one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. \nFrom the first equation, we obtain  ${x}_{1}=-3{x}_{2}.$ Hence, the general solution is\n\n$$\n[\\begin{aligned}-3{x}_{2} \\\\ {x}_{2}\\end{aligned}],\\,{x}_{2}\\in R.\n$$\n\nSetting, for instance, ${x}_{2}=1,$ we get the eigenvector \n${v}_{1}=[\\begin{aligned}-3 \\\\ 1\\end{aligned}].$\n\n- For $\\lambda =10,$ we have\n\n$$\n\\begin{aligned}A-\\lambda I & =[\\begin{aligned}4 & 3 \\\\ 2 & 9\\end{aligned}]-10[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-6 & 3 \\\\ 2 & -1\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have a system of linear equations \n\n$$\n\\{\\begin{aligned}-6{x}_{1}+3{x}_{2}=0 \\\\ 2{x}_{1}-{x}_{2}=0\\end{aligned}\n$$\n\nwith the augmented matrix $M$ which we reduce to row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}-6 & 3 & 0 \\\\ 2 & -1 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+\\frac{1}{3}{R}_{1} \\\\  & ∼[\\begin{aligned}-6 & 3 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nIn the reduced matrix above, there is one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. \nFrom the first equation, we obtain ${x}_{1}=\\frac{1}{2}{x}_{2}.$ Hence, the general solution is\n\n$$\n[\\begin{aligned}\\frac{1}{2}{x}_{2} \\\\ {x}_{2}\\end{aligned}],\\,{x}_{2}\\in R.\n$$\n\nSetting, for instance, ${x}_{2}=2,$ we get the eigenvector \n${v}_{2}=[\\begin{aligned}1 \\\\ 2\\end{aligned}].$\n\nTherefore, two linearly independent eigenvectors of the matrix $A$ are\n\n$$\n[\\begin{aligned}-3 \\\\ 1\\end{aligned}],[\\begin{aligned}1 \\\\ 2\\end{aligned}].\n$$" #edb/ref 17592186045417] [17592186244044 #edb/ref 1068 #edb/ref 17592186243529 #edb/ref 17592186045417] [17592186244044 #edb/ref 1069 "q-107311" #edb/ref 17592186045417] [17592186244044 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186244044 #edb/ref 1071 "Given that $\\lambda =7$ and $\\lambda =29$ are the eigenvalues of the matrix\n$A=[\\begin{aligned}11 & -6 \\\\ -12 & 25\\end{aligned}]$,\nfind two linearly independent eigenvectors of $A.$" #edb/ref 17592186045417] [17592186244044 #edb/ref 1072 #uuid "7ec17ca8-f488-5d0d-a6c8-da1edb5aec33" #edb/ref 17592186045417] [17592186244044 #edb/ref 1074 "To compute the eigenvectors of a matrix, we need to find non-zero solutions of the matrix equation \n\n$$\n(A-\\lambda I)\\text{x}=0.\n$$\n\nWith that in mind, let's consider each of the eigenvalues separately. \n\n- For $\\lambda =7,$ we have\n\n$$\n\\begin{aligned}A-\\lambda I & =[\\begin{aligned}11 & -6 \\\\ -12 & 25\\end{aligned}]-7[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}4 & -6 \\\\ -12 & 18\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have a system of linear equations \n\n$$\n\\{\\begin{aligned}4{x}_{1}-6{x}_{2}=0 \\\\ -12{x}_{1}+18{x}_{2}=0\\end{aligned}\n$$\n\nwith the augmented matrix $M$ which we reduce to row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}4 & -6 & 0 \\\\ -12 & 18 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼[\\begin{aligned}4 & -6 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nIn the reduced matrix above, there is one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. \nFrom the first equation, we obtain  ${x}_{1}=\\frac{3}{2}{x}_{2}.$ Hence, the general solution is\n\n$$\n[\\begin{aligned}\\frac{3}{2}{x}_{2} \\\\ {x}_{2}\\end{aligned}],\\,{x}_{2}\\in R.\n$$\n\nSetting, for instance, ${x}_{2}=2,$ we get the eigenvector \n${v}_{1}=[\\begin{aligned}3 \\\\ 2\\end{aligned}].$\n\n- For $\\lambda =29,$ we have\n\n$$\n\\begin{aligned}A-\\lambda I & =[\\begin{aligned}11 & -6 \\\\ -12 & 25\\end{aligned}]-29[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-18 & -6 \\\\ -12 & -4\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have a system of linear equations \n\n$$\n\\{\\begin{aligned}-18{x}_{1}-6{x}_{2}=0 \\\\ -12{x}_{1}-4{x}_{2}=0\\end{aligned}\n$$\n\nwith the augmented matrix $M$ which we reduce to row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}-18 & -6 & 0 \\\\ -12 & -4 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+(-\\frac{2}{3}){R}_{1} \\\\  & ∼[\\begin{aligned}-18 & -6 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nIn the reduced matrix above, there is one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. \nFrom the first equation, we obtain ${x}_{1}=-\\frac{1}{3}{x}_{2}.$ Hence, the general solution is\n\n$$\n[\\begin{aligned}-\\frac{1}{3}{x}_{2} \\\\ {x}_{2}\\end{aligned}],\\,{x}_{2}\\in R.\n$$\n\nSetting, for instance, ${x}_{2}=3,$ we get the eigenvector \n${v}_{2}=[\\begin{aligned}-1 \\\\ 3\\end{aligned}].$\n\nTherefore, two linearly independent eigenvectors of the matrix $A$ are\n\n$$\n[\\begin{aligned}3 \\\\ 2\\end{aligned}],[\\begin{aligned}-1 \\\\ 3\\end{aligned}].\n$$" #edb/ref 17592186045417] [17592186285151 #edb/ref 1080 "\\frac{2}{3}" #edb/ref 17592186045417] [17592186285151 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186285151 #edb/ref 1083 #uuid "2979d6f9-9e8b-5c2a-bbd2-6cb6ea061202" #edb/ref 17592186045417] [17592186285597 #edb/ref 1080 "4" #edb/ref 17592186045417] [17592186285597 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186285597 #edb/ref 1083 #uuid "5833a572-9e0e-5859-ad31-d96beeb25e9b" #edb/ref 17592186045417] [17592186286284 #edb/ref 1080 "-4" #edb/ref 17592186045417] [17592186286284 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186286284 #edb/ref 1083 #uuid "a34e68f3-1c22-52d8-ace0-254e11465787" #edb/ref 17592186045417] [17592186286613 #edb/ref 1080 "1" #edb/ref 17592186045417] [17592186286613 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186286613 #edb/ref 1083 #uuid "c76196eb-778f-5f6b-9a91-4232d319cce8" #edb/ref 17592186045417] [17592186286618 #edb/ref 1080 "-3" #edb/ref 17592186045417] [17592186286618 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186286618 #edb/ref 1083 #uuid "c7dfc3f8-ec72-5328-9ecb-22f2661d9d27" #edb/ref 17592186045417] [17592186287207 #edb/ref 1075 #edb/ref 17592186285151 #edb/ref 17592186045417] [17592186287207 #edb/ref 1075 #edb/ref 17592186285597 #edb/ref 17592186045417] [17592186287207 #edb/ref 1075 #edb/ref 17592186286284 #edb/ref 17592186045417] [17592186287207 #edb/ref 1075 #edb/ref 17592186286613 #edb/ref 17592186045417] [17592186287207 #edb/ref 1075 #edb/ref 17592186286618 #edb/ref 17592186045417] [17592186287207 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186287207 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186287207 #edb/ref 1078 #edb/ref 17592186286618 #edb/ref 17592186045417] [17592186287207 #edb/ref 1079 #uuid "1c50ba8d-7a5d-59de-ba5a-875076c13339" #edb/ref 175921860