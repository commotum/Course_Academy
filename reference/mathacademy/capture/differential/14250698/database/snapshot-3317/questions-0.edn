#{[{:db/id #edb/ref 17592186575543 :knowledge-point/_questions [{:db/id #edb/ref 17592186083227 :knowledge-point/id #uuid "2169053d-78fc-5714-82f4-d89fc36ff695" :knowledge-point/title "Finding the Value of an Observation, Standard Deviation, or Mean Given a Z-Score"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6137d563-5854-54cb-a38e-1055473864b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.2" :db/id #edb/ref 17592186575123}] :answer-field/correct {:answer/id #uuid "6137d563-5854-54cb-a38e-1055473864b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.2" :db/id #edb/ref 17592186575123} :answer-field/id #uuid "1c5c354f-b3fb-557e-b2a1-3bac47f270b9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186575421}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "50d225de-7004-5810-a19e-8625e7e461c1" :question/math-academy-id "q-332028" :question/problem "A data set has a standard deviation $\\sigma =2.4$ and an unknown mean. An observation of the data set has the value $x=5.4$ and $z$-score $z=0.5.$ Find the mean $\\overset{―}{x}$ of the data set.\n\n$\\overset{―}{x}=$\n{{field-1}}" :question/worked-solution "To compute the value of an observation $x$ which yields a given $z$-score in a data set with mean $\\overset{―}{x}$ and standard deviation $\\sigma ,$ we can use the following formula:\n\n$$\nx=\\overset{―}{x}+z\\cdot \\sigma\n$$\n\nSubstituting $x=5.4,$ $z=0.5,$ and $\\sigma =2.4$ into the formula and solving for $\\overset{―}{x},$ we get\n\n$$\n\\begin{aligned}x & =\\overset{―}{x}+z\\cdot \\sigma  \\\\ 5.4 & =\\overset{―}{x}+0.5\\cdot 2.4 \\\\ 5.4 & =\\overset{―}{x}+1.2 \\\\ \\overset{―}{x} & =4.2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186305007 :knowledge-point/_questions [{:db/id #edb/ref 17592186083323 :knowledge-point/id #uuid "01100ea8-2ab9-511e-8321-6ef5588c4417" :knowledge-point/title "Solving a System of Equations to Compute an Unknown Mean or Standard Deviation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40a8a690-0e17-513a-9759-e2c32710072c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186302862}] :answer-field/correct {:answer/id #uuid "40a8a690-0e17-513a-9759-e2c32710072c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186302862} :answer-field/id #uuid "c1c1b1da-a3d8-5b1d-9536-eeb4e916f1d1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186304605}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cbfb0339-7153-551d-aafb-c429f4a2a68d" :question/math-academy-id "q-332239" :question/problem "A data set contains the observations ${x}_{1}=3.08,{x}_{2}=8.68$ with $z$-scores ${z}_{1}=-1.2$ and ${z}_{2}=2.3,$ respectively. Find the mean $\\overset{¯}{x}$ of the data set.\n\n$\\overset{¯}{x}=$\n{{field-1}}" :question/worked-solution "To compute the value of an observation $x$ which yields a given $z$-score in a data set with mean $\\overset{―}{x}$ and standard deviation $\\sigma ,$ we can use the following formula:\n\n$$\nx=\\overset{―}{x}+z\\cdot \\sigma \n$$\n\nFrom the first observation, we have\n\n$$\n3.08=\\overset{¯}{x}+(-1.2)\\cdot \\sigma .\n$$\n\nFrom the second observation, we have\n\n$$\n8.68=\\overset{¯}{x}+2.3\\cdot \\sigma .\n$$\n\nSubtracting the first equation from the second and solving for $\\sigma ,$ we get\n\n$$\n\\begin{aligned}8.68-3.08 & =(2.3-(-1.2))\\cdot \\sigma  \\\\ 5.6 & =3.5\\cdot \\sigma  \\\\ \\sigma  & =1.6.\\end{aligned}\n$$\n\nFinally, substituting this value back into our first equation and solving for $\\overset{¯}{x},$ we get\n\n$$\n\\begin{aligned}3.08 & =\\overset{¯}{x}+(-1.2)\\cdot \\sigma  \\\\ 3.08 & =\\overset{¯}{x}+(-1.2)\\cdot 1.6 \\\\ 3.08 & =\\overset{¯}{x}-1.92 \\\\ \\overset{¯}{x} & =5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186575609 :knowledge-point/_questions [{:db/id #edb/ref 17592186083323 :knowledge-point/id #uuid "01100ea8-2ab9-511e-8321-6ef5588c4417" :knowledge-point/title "Solving a System of Equations to Compute an Unknown Mean or Standard Deviation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d31a8c1-021c-5a4c-876f-09f1568ff61b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.4" :db/id #edb/ref 17592186575147}] :answer-field/correct {:answer/id #uuid "6d31a8c1-021c-5a4c-876f-09f1568ff61b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.4" :db/id #edb/ref 17592186575147} :answer-field/id #uuid "332a9a32-3521-5a06-a046-98035661faf9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186575441}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e17b593f-806a-5407-8b55-7558d69aa888" :question/math-academy-id "q-332244" :question/problem "A data set contains the observations ${x}_{1}=3.1,{x}_{2}=7.9$ with $z$-scores ${z}_{1}=-0.5$ and ${z}_{2}=1.5,$ respectively. Find the standard deviation $\\sigma$ of the data set.\n\n$\\sigma =$\n{{field-1}}" :question/worked-solution "To compute the value of an observation $x$ which yields a given $z$-score in a data set with mean $\\overset{―}{x}$ and standard deviation $\\sigma ,$ we can use the following formula:\n\n$$\nx=\\overset{―}{x}+z\\cdot \\sigma\n$$\n\nFrom the first observation, we have\n\n$$\n3.1=\\overset{¯}{x}+(-0.5)\\cdot \\sigma .\n$$\n\nFrom the second observation, we have\n\n$$\n7.9=\\overset{¯}{x}+1.5\\cdot \\sigma .\n$$\n\nSubtracting the first equation from the second and solving for $\\sigma ,$ we get\n\n$$\n\\begin{aligned}7.9-3.1 & =(1.5-(-0.5))\\cdot \\sigma  \\\\ 4.8 & =2\\cdot \\sigma  \\\\ \\sigma  & =2.4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186575587 :knowledge-point/_questions [{:db/id #edb/ref 17592186083227 :knowledge-point/id #uuid "2169053d-78fc-5714-82f4-d89fc36ff695" :knowledge-point/title "Finding the Value of an Observation, Standard Deviation, or Mean Given a Z-Score"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9a53cb31-bc17-5daf-8994-cbb6560d170a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14.2" :db/id #edb/ref 17592186575213} {:answer/id #uuid "ae404e3a-dbf6-5282-b23e-6e487d6722fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186575260} {:answer/id #uuid "c3652fcb-627b-5e2d-87c4-3c8135bc864b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186575295} {:answer/id #uuid "d0d16dea-91d4-5e65-88b9-96458855ddc7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15.1" :db/id #edb/ref 17592186575319} {:answer/id #uuid "e8b2b3cc-8ebe-5843-8f10-433a90a3310c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13.6" :db/id #edb/ref 17592186575361}] :answer-field/correct {:answer/id #uuid "c3652fcb-627b-5e2d-87c4-3c8135bc864b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186575295} :answer-field/id #uuid "d3433b4b-8883-5522-b986-cd5716b0db79" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186575507}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "af87d523-ac60-5aec-8cf6-a5f255a961ed" :question/math-academy-id "q-94473" :question/problem "A data set has mean $\\overset{¯}{x}=16$ and standard deviation $\\sigma =2.5.$ Find the value of an observation that has $z$-score $z=-0.4.$" :question/worked-solution "To compute the value of an observation $x$ which yields a given $z$-score in a data set with mean $\\overset{―}{x}$ and standard deviation $\\sigma ,$ we can use the following formula:\n\n$$\nx=\\overset{―}{x}+z\\cdot \\sigma\n$$\n\nSubstituting $\\overset{¯}{x}=16,$ $z=-0.4,$ and $\\sigma =2.5$ into the formula, we get\n\n$$\n\\begin{aligned}x & =\\overset{―}{x}+z\\cdot \\sigma  \\\\  & =16+(-0.4)\\cdot 2.5 \\\\  & =16-1 \\\\  & =15.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186575544 :knowledge-point/_questions [{:db/id #edb/ref 17592186083322 :knowledge-point/id #uuid "d7e9daa2-4aaa-5c33-b611-231f3d0e4782" :knowledge-point/title "Z-Score: Word Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ad868d2-4b59-59e5-af41-cdcaa965a99b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.81" :db/id #edb/ref 17592186575049} {:answer/id #uuid "526b6aa7-3f19-53ef-a532-7f9286139f53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.81" :db/id #edb/ref 17592186575092} {:answer/id #uuid "b75010ed-05a2-5fae-94e7-e38cb062d94a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.26" :db/id #edb/ref 17592186575275} {:answer/id #uuid "d87a2113-3ca9-5e90-9173-5ef22a26472f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3.81" :db/id #edb/ref 17592186575338} {:answer/id #uuid "dc6c033b-6092-5094-8efd-03c857a491a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2.56" :db/id #edb/ref 17592186575342}] :answer-field/correct {:answer/id #uuid "3ad868d2-4b59-59e5-af41-cdcaa965a99b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.81" :db/id #edb/ref 17592186575049} :answer-field/id #uuid "df0001ec-e44a-52b2-ad04-aa3230b4f04d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186575512}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "543c2585-7af9-533a-a269-b37c45eeb579" :question/math-academy-id "q-9787" :question/problem "The owner of a restaurant noted that $145$ vegetarian customers visited his restaurant during a particular week. On a particular day of the same week, he noted that $x=15$ vegetarian customers visited the restaurant, corresponding to a $z$-score of $z=-1.5.$ Find the standard deviation of the number of vegetarian customers per day, giving your answer to $2$ decimal places." :question/worked-solution "First, we need to find the mean number of vegetarian customers for each day:\n\n$$\n\\overset{¯}{x}=\\frac{145}{7}=20.71\n$$\n\nto $2$ decimal places.\n\nThe $z$-score of an observation $x$ is defined by\n\n$$\nz=\\frac{x-\\overset{―}{x}}{\\sigma }.\n$$\n\nThe $z$-score represents how many standard deviations an observation is above or below the mean of the data set. Rewriting this in terms of $\\sigma ,$ we get\n\n$$\n\\sigma =\\frac{x-\\overset{―}{x}}{z}.\n$$\n\nSo, the standard deviation $\\sigma$ is given by\n\n$$\n\\begin{aligned}\\sigma  & =\\frac{x-\\overset{¯}{x}}{z} \\\\  & =\\frac{15-20.71}{-1.5} \\\\  & =3.81\\end{aligned}\n$$\n\n \nto $2$ decimal places."}]}
