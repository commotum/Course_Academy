 3 & 0 & 1\\end{aligned}| \\\\  & =t\\cdot |\\begin{aligned}-1 & -1 \\\\ 0 & 1\\end{aligned}|-1\\cdot |\\begin{aligned}2 & -1 \\\\ 3 & 1\\end{aligned}|+t\\cdot |\\begin{aligned}2 & -1 \\\\ 3 & 0\\end{aligned}| \\\\  & =t((-1)\\cdot 1-0\\cdot (-1))-(2\\cdot 1-3\\cdot (-1))+t(2\\cdot 0-3\\cdot (-1)) \\\\  & =-t-5+3t \\\\  & =2t-5.\\end{aligned}\n$$\n\n    \n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}p\\cdot (q\\times r) & =0 \\\\ 2t-5 & =0 \\\\ 2t & =5 \\\\ t & =\\frac{5}{2}\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $t=\\frac{5}{2}.$" #edb/ref 17592186045417] [17592186342076 #edb/ref 1068 #edb/ref 17592186341645 #edb/ref 17592186045417] [17592186342076 #edb/ref 1069 "q-73745" #edb/ref 17592186045417] [17592186342076 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186342076 #edb/ref 1071 "Calculate the volume of the parallelepiped spanned by $\\overset{\\to }{AB}$, $\\overset{\\to }{AC}$ and $\\overset{\\to }{AD}$, given the points $A(1,-1,2)$, $B(-2,2,3)$, $C(1,1,1)$, and $D(-1,3,-2).$" #edb/ref 17592186045417] [17592186342076 #edb/ref 1072 #uuid "d447f611-67a9-5187-a844-7f81dc30a0cc" #edb/ref 17592186045417] [17592186342076 #edb/ref 1074 "First, we find the displacement vectors $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ that span the parallelepiped:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =(-2i+2j+3k)-(i-j+2k) \\\\  & =-3i+3j+k \\\\  & =⟨-3,3,1⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =(i+j+k)-(i-j+2k) \\\\  & =2j-k \\\\  & =⟨0,2,-1⟩ \\\\ \\overset{\\to }{AD} & =d-a \\\\  & =(-i+3j-2k)-(i-j+2k) \\\\  & =-2i+4j-4k \\\\  & =⟨-2,4,-4⟩\\end{aligned}\n$$\n\nNow, to find the volume of the parallelepiped, we need to take the absolute value of the triple product of the above vectors.\n\nComputing the triple product, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot (\\overset{\\to }{AC}\\times \\overset{\\to }{AD}) & =|\\begin{aligned}-3 & 3 & 1 \\\\ 0 & 2 & -1 \\\\ -2 & 4 & -4\\end{aligned}| \\\\  & =(-3)\\cdot |\\begin{aligned}2 & -1 \\\\ 4 & -4\\end{aligned}|-3\\cdot |\\begin{aligned}0 & -1 \\\\ -2 & -4\\end{aligned}|+1\\cdot |\\begin{aligned}0 & 2 \\\\ -2 & 4\\end{aligned}| \\\\  & =-3(2\\cdot (-4)-4\\cdot (-1))-3(0\\cdot (-4)-(-2)\\cdot (-1))+(0\\cdot 4-(-2)\\cdot 2) \\\\  & =12+6+4 \\\\  & =22.\\end{aligned}\n$$\n\nTherefore, the volume of the corresponding parallelpiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ is\n\n$$\nV=|22|=22.\n$$" #edb/ref 17592186045417] [17592186458621 #edb/ref 1080 "15" #edb/ref 17592186045417] [17592186458621 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186458621 #edb/ref 1083 #uuid "030d4dbf-31a4-5c0b-ac81-fba854373f33" #edb/ref 17592186045417] [17592186458758 #edb/ref 1080 "1" #edb/ref 17592186045417] [17592186458758 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186458758 #edb/ref 1083 #uuid "4745fa01-7267-5d7d-80a7-da776c08b11f" #edb/ref 17592186045417] [17592186458815 #edb/ref 1080 "16" #edb/ref 17592186045417] [17592186458815 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186458815 #edb/ref 1083 #uuid "6a6770d3-5bd6-55b6-b578-032b42984508" #edb/ref 17592186045417] [17592186458830 #edb/ref 1080 "11" #edb/ref 17592186045417] [17592186458830 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186458830 #edb/ref 1083 #uuid "73574c6b-9bf8-53da-8eb4-4206538d870d" #edb/ref 17592186045417] [17592186458866 #edb/ref 1080 "2" #edb/ref 17592186045417] [17592186458866 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186458866 #edb/ref 1083 #uuid "87767553-4117-55d5-ab34-eebfa1e2b999" #edb/ref 17592186045417] [17592186458902 #edb/ref 1080 "6" #edb/ref 17592186045417] [17592186458902 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186458902 #edb/ref 1083 #uuid "9b91be34-01c4-5