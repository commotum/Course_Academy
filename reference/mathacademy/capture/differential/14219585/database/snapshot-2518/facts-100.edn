7] [17592186531554 #edb/ref 1075 #edb/ref 17592186531263 #edb/ref 17592186045417] [17592186531554 #edb/ref 1075 #edb/ref 17592186531320 #edb/ref 17592186045417] [17592186531554 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186531554 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186531554 #edb/ref 1078 #edb/ref 17592186531320 #edb/ref 17592186045417] [17592186531554 #edb/ref 1079 #uuid "fd196ff8-da06-5ece-8bd7-2692100d1ca4" #edb/ref 17592186045417] [17592186531563 #edb/ref 1068 #edb/ref 17592186531391 #edb/ref 17592186045417] [17592186531563 #edb/ref 1068 #edb/ref 17592186531444 #edb/ref 17592186045417] [17592186531563 #edb/ref 1068 #edb/ref 17592186531457 #edb/ref 17592186045417] [17592186531563 #edb/ref 1069 "q-269811" #edb/ref 17592186045417] [17592186531563 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186531563 #edb/ref 1071 "Consider the functions $y(x)=Ax$ and $f(y)=By,$ where $x\\in {R}^{2},y\\in {R}^{3},$ and the matrices $A$ and $B$ are given by\n\n$$\nA=[\\begin{aligned}2 & -2 \\\\ 3 & 3 \\\\ -3 & -2\\end{aligned}],\\,B=[\\begin{aligned}2 & 1 & 4 \\\\ 5 & 2 & 1\\end{aligned}].\n$$\n\nWhat is $\\frac{\\text{d}}{\\text{d}x}f(y(x))$ evaluated at ${x}_{0}=[3,\\,1]^{T}?$\n\n<table cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"70px\" rowspan=\"2\" width=\"30px\">\n${\\frac{\\text{d}}{\\text{d}x}f(y(x))|}_{{x}_{0}}=\\,\\,$\n</td>\n<td align=\"center\" height=\"35px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"30px\">{{field-2}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\">$-6$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" #edb/ref 17592186045417] [17592186531563 #edb/ref 1072 #uuid "19d96d91-ae11-5a12-a4f6-96b41a2e839b" #edb/ref 17592186045417] [17592186531563 #edb/ref 1074 "Using the chain rule, we have\n\n$$\n\\frac{\\text{d}}{\\text{d}x}f(y(x))=\\frac{\\text{d}f}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x}.\n$$\n\nLet's consider each of the factors in turn.\n\n- The function $f$ acts on a vector $y\\in {R}^{3}$ by multiplying it by $B$ and outputs a vector $f(y)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}f}{\\text{d}y}=B.\n$$\n\n- The function $y$ acts on a vector $x\\in {R}^{2}$ by multiplying it by $A$ and outputs a vector $y(x)\\in {R}^{3}.$ Thus,\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=A.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}f(y(x)) & =\\frac{\\text{d}f}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x} \\\\  & =BA \\\\  & =[\\begin{aligned}2 & 1 & 4 \\\\ 5 & 2 & 1\\end{aligned}][\\begin{aligned}2 & -2 \\\\ 3 & 3 \\\\ -3 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}-5 & -9 \\\\ 13 & -6\\end{aligned}].\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186531566 #edb/ref 1068 #edb/ref 17592186531406 #edb/ref 17592186045417] [17592186531566 #edb/ref 1069 "q-270277" #edb/ref 17592186045417] [17592186531566 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186531566 #edb/ref 1071 "For $x,y,z\\in {R}^{2},$ consider the following functions: \n\n$$\n\\begin{aligned} & y(x)=Ax\\,\\text{where}\\,A=[\\begin{aligned}0 & 1 \\\\ 2 & 1\\end{aligned}] \\\\  & z(y)=[\\begin{aligned}{y}_{1}-{y}_{2} \\\\ {y}_{1}^{2}\\end{aligned}] \\\\  & f(z)=Cz\\,\\text{where}\\,C=[\\begin{aligned}2 & -1 \\\\ 1 & 2\\end{aligned}]\\end{aligned}\n$$\n\nWhat is $\\frac{\\text{d}}{\\text{d}x}f(z(y(x)))$ evaluated at ${x}_{0}=[\\begin{aligned}1 \\\\ 0\\end{aligned}]?$" #edb/ref 17592186045417] [17592186531566 #edb/ref 1072 #uuid "1c1ab071-19e5-52c5-b033-ca671fa83041" #edb/ref 17592186045417] [17592186531566 #edb/ref 1074 "Using the chain rule, we have\n\n$$\n\\frac{\\text{d}}{\\text{d}x}f(z(y(x)))=\\frac{\\text{d}f}{\\text{d}z}\\cdot \\frac{\\text{d}z}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x}.\n$$\n\nLet's consider each of the factors in turn.\n\n- The function $f$ acts on a vector $z\\in {R}^{2}$ by multiplying it by $C$ and outputs a vector $f(z)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}f}{\\text{d}z}=C.\n$$\n\n- The function $z$ acts on a vector $y\\in {R}^{2}$ and outputs a vector $z(y)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}z}{\\text{d}y}=[\\begin{aligned}\\frac{∂{z}_{1}}{∂{y}_{1}} & \\frac{∂{z}_{1}}{∂{y}_{2}} \\\\ \\frac{∂{z}_{2}}{∂{y}_{1}} & \\frac{∂{z}_{2}}{∂{y}_{2}}\\end{aligned}]=[\\begin{aligned}1 & -1 \\\\ 2{y}_{1} & 0\\end{aligned}].\n$$\n\nEvaluating at ${y}_{0}=A{x}_{0}=[\\begin{aligned}0 & 1 \\\\ 2 & 1\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}0 \\\\ 2\\end{aligned}],$ we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}y}{|}_{{y}_{0}}=[\\begin{aligned}1 & -1 \\\\ 0 & 0\\end{aligned}].\n$$\n\n- The function $y$ acts on a vector $x\\in {R}^{2}$ by multiplying it by $A$ and outputs a vector $y(x)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=A.\n$$\n\nTherefore, we have \n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}f(z(y(x))){|}_{{x}_{0}} & =\\frac{\\text{d}f}{\\text{d}z}{|}_{{z}_{0}}\\cdot \\frac{\\text{d}z}{\\text{d}y}{|}_{{y}_{0}}\\cdot \\frac{\\text{d}y}{\\text{d}x}{|}_{{x}_{0}} \\\\  & =[\\begin{aligned}2 & -1 \\\\ 1 & 2\\end{aligned}]\\cdot [\\begin{aligned}1 & -1 \\\\ 0 & 0\\end{aligned}]\\cdot [\\begin{aligned}0 & 1 \\\\ 2 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -2 \\\\ 1 & -1\\end{aligned}]\\cdot [\\begin{aligned}0 & 1 \\\\ 2 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-4 & 0 \\\\ -2 & 0\\end{aligned}].\\end{aligned}\n$$" #edb/ref 17592186045417]}
