=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"30px\">{{field-2}}</td>\n<td align=\"center\" width=\"30px\">{{field-3}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">$6$</td>\n<td align=\"center\">{{field-4}}</td>\n<td align=\"center\">$3$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>"] [17592186204590 :question/worked-solution "Using the chain rule, we have\n\n$$\n\\frac{\\text{d}}{\\text{d}x}f(y(x))=\\frac{\\text{d}f}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x}.\n$$\n\nLet's consider each of the factors in turn.\n\n- The function $f$ acts on a vector $y\\in {R}^{2}$ by multiplying it by $B$ and outputs a vector $f(y)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}f}{\\text{d}y}=B.\n$$\n\n- The function $y$ acts on a vector $x\\in {R}^{3}$ by multiplying it by $A$ and outputs a vector $y(x)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=A.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}f(y(x)) & =\\frac{\\text{d}f}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x} \\\\  & =BA \\\\  & =[\\begin{aligned}2 & -1 \\\\ 0 & 3\\end{aligned}][\\begin{aligned}4 & -2 & 5 \\\\ 2 & 3 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}6 & -7 & 9 \\\\ 6 & 9 & 3\\end{aligned}].\\end{aligned}\n$$"] [17592186204590 :question/difficulty :question.difficulty/moderate] ["answer-1aaa93cb-9bae-57f3-aafb-1f6b7516aa22" :answer/id #uuid "1aaa93cb-9bae-57f3-aafb-1f6b7516aa22"] ["answer-1aaa93cb-9bae-57f3-aafb-1f6b7516aa22" :answer/type :answer.type/math] ["answer-1aaa93cb-9bae-57f3-aafb-1f6b7516aa22" :answer/value "6"] [17592186203459 :answer-field/correct "answer-1aaa93cb-9bae-57f3-aafb-1f6b7516aa22"] [17592186203459 :answer-field/choices "answer-1aaa93cb-9bae-57f3-aafb-1f6b7516aa22"] ["answer-463df682-92d8-56d8-92fc-869f6526ae63" :answer/id #uuid "463df682-92d8-56d8-92fc-869f6526ae63"] ["answer-463df682-92d8-56d8-92fc-869f6526ae63" :answer/type :answer.type/math] ["answer-463df682-92d8-56d8-92fc-869f6526ae63" :answer/value "-7"] [17592186203458 :answer-field/correct "answer-463df682-92d8-56d8-92fc-869f6526ae63"] [17592186203458 :answer-field/choices "answer-463df682-92d8-56d8-92fc-869f6526ae63"] ["answer-ecb98ecb-5d5e-5050-a3f9-48d2a87aeb75" :answer/id #uuid "ecb98ecb-5d5e-5050-a3f9-48d2a87aeb75"] ["answer-ecb98ecb-5d5e-5050-a3f9-48d2a87aeb75" :answer/type :answer.type/math] ["answer-ecb98ecb-5d5e-5050-a3f9-48d2a87aeb75" :answer/value "9"] [17592186203460 :answer-field/correct "answer-ecb98ecb-5d5e-5050-a3f9-48d2a87aeb75"] [17592186203460 :answer-field/choices "answer-ecb98ecb-5d5e-5050-a3f9-48d2a87aeb75"] ["answer-be4fe82c-92fb-5f8f-90d3-234e29b3c139" :answer/id #uuid "be4fe82c-92fb-5f8f-90d3-234e29b3c139"] ["answer-be4fe82c-92fb-5f8f-90d3-234e29b3c139" :answer/type :answer.type/math] ["answer-be4fe82c-92fb-5f8f-90d3-234e29b3c139" :answer/value "9"] [17592186203457 :answer-field/correct "answer-be4fe82c-92fb-5f8f-90d3-234e29b3c139"] [17592186203457 :answer-field/choices "answer-be4fe82c-92fb-5f8f-90d3-234e29b3c139"] [17592186204582 :question/problem "Consider the functions $y(x)=Ax$ and $f(y)=By,$ where $x\\in {R}^{3},y\\in {R}^{2},$ and the matrices $A$ and $B$ are given by\n\n$$\nA=[\\begin{aligned}1 & 2 & 3 \\\\ 2 & 4 & 6\\end{aligned}],\\,B=[\\begin{aligned}0 & 1 \\\\ 1 & 1 \\\\ 2 & 3\\end{aligned}].\n$$\n\nWhat is $\\frac{\\text{d}}{\\text{d}x}f(y(x))$ evaluated at ${x}_{0}=[1,\\,0,\\,1]^{T}?$\n\n<table cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"70px\" rowspan=\"3\" width=\"30px\">\n${\\frac{\\text{d}}{\\text{d}x}f(y(x))|}_{{x}_{0}}=\\,\\,$\n</td>\n<td align=\"center\" height=\"35px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"30px\">{{field-2}}</td>\n<td align=\"center\" width=\"30px\">{{field-3}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">$3$</td>\n<td align=\"center\">{{field-4}}</td>\n<td align=\"center\">$9$</td>\n<td align=\"center\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">$8$</td>\n<td align=\"center\">{{field-5}}</td>\n<td align=\"center\">$24$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>"] [17592186204582 :question/worked-solution "Using the chain rule, we have\n\n$$\n\\frac{\\text{d}}{\\text{d}x}f(y(x))=\\frac{\\text{d}f}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x}.\n$$\n\nLet's consider each of the factors in turn.\n\n- The function $f$ acts on a vector $y\\in {R}^{2}$ by multiplying it by $B$ and outputs a vector $f(y)\\in {R}^{3}.$ Thus,\n\n$$\n\\frac{\\text{d}f}{\\text{d}y}=B.\n$$\n\n- The function $y$ acts on a vector $x\\in {R}^{3}$ by multiplying it by $A$ and outputs a vector $y(x)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=A.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}f(y(x)) & =\\frac{\\text{d}f}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x} \\\\  & =BA \\\\  & =[\\begin{aligned}0 & 1 \\\\ 1 & 1 \\\\ 2 & 3\\end{aligned}][\\begin{aligned}1 & 2 & 3 \\\\ 2 & 4 & 6\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 4 & 6 \\\\ 3 & 6 & 9 \\\\ 8 & 16 & 24\\end{aligned}].\\end{aligned}\n$$"] [17592186204582 :question/difficulty :question.difficulty/hard] ["answer-8f93605a-da0e-549c-b764-c0d84e5801bf" :answer/id #uuid "8f93605a-da0e-549c-b764-c0d84e5801bf"] ["answer-8f93605a-da0e-549c-b764-c0d84e5801bf" :answer/type :answer.type/math] ["answer-8f93605a-da0e-549c-b764-c0d84e5801bf" :answer/value "2"] [17592186203424 :answer-field/correct "answer-8f93605a-da0e-549c-b764-c0d84e5801bf"] [17592186203424 :answer-field/choices "answer-8f93605a-da0e-549c-b764-c0d84e5801bf"] ["answer-25ddbd4f-c089-554f-8752-bca2aefecb84" :answer/id #uuid "25ddbd4f-c089-554f-8752-bca2aefecb84"] ["answer-25ddbd4f-c089-554f-8752-bca2aefecb84" :answer/type :answer.type/math] ["answer-25ddbd4f-c089-554f-8752-bca2aefecb84" :answer/value "4"] [17592186203423 :answer-field/correct "answer-25ddbd4f-c089-554f-8752-bca2aefecb84"] [17592186203423 :answer-field/choices "answer-25ddbd4f-c089-554f-8752-bca2aefecb84"] ["answer-27537bcf-01d8-5279-b7c5-d8bcb39361eb" :answer/id #uuid "27537bcf-01d8-5279-b7c5-d8bcb39361eb"] ["answer-27537bcf-01d8-5279-b7c5-d8bcb39361eb" :answer/type :answer.type/math] ["answer-27537bcf-01d8-5279-b7c5-d8bcb39361eb" :answer/value "6"] [17592186203427 :answer-field/correct "answer-27537bcf-01d8-5279-b7c5-d8bcb39361eb"] [17592186203427 :answer-field/choices "answer-27537bcf-01d8-5279-b7c5-d8bcb39361eb"] ["answer-e0b711b8-90eb-5c9a-bf0b-e912d2cf977d" :answer/id #uuid "e0b711b8-90eb-5c9a-bf0b-e912d2cf977d"] ["answer-e0b711b8-90eb-5c9a-bf0b-e912d2cf977d" :answer/type :answer.type/math] ["answer-e0b711b8-90eb-5c9a-bf0b-e912d2cf977d" :answer/value "6"] [17592186203425 :answer-field/correct "answer-e0b711b8-90eb-5c9a-bf0b-e912d2cf977d"] [17592186203425 :answer-field/choices "answer-e0b711b8-90eb-5c9a-bf0b-e912d2cf977d"] ["answer-ab09796d-e835-5a4b-80f8-cb91d15672b5" :answer/id #uuid "ab09796d-e835-5a4b-80f8-cb91d15672b5"] ["answer-ab09796d-e835-5a4b-80f8-cb91d15672b5" :answer/type :answer.type/math] ["answer-ab09796d-e835-5a4b-80f8-cb91d15672b5" :answer/value "16"] [17592186203426 :answer-field/correct "answer-ab09796d-e835-5a4b-80f8-cb91d15672b5"] [17592186203426 :answer-field/choices "answer-ab09796d-e835-5a4b-80f8-cb91d15672b5"] ["question-b20e05f8-4c24-503b-a4d3-441eb6663ecb" :question/id #uuid "b20e05f8-4c24-503b-a4d3-441eb6663ecb"] ["question-b20e05f8-4c24-503b-a4d3-441eb6663ecb" :question/math-academy-id "q-269827"] ["question-b20e05f8-4c24-503b-a4d3-441eb6663ecb" :question/problem "For $x,y,z\\in {R}^{2},$ consider the following functions: \n\n$$\n\\begin{aligned} & y(x)=Ax\\,\\text{where}\\,A=[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}] \\\\  & z(y)=[\\begin{aligned}{y}_{1}+{y}_{2} \\\\ {y}_{1}{y}_{2}\\end{aligned}] \\\\  & f(z)=Cz\\,\\text{where}\\,C=[\\begin{aligned}-1 & 2 \\\\ 2 & -1\\end{aligned}]\\end{aligned}\n$$\n\nWhat is $\\frac{\\text{d}}{\\text{d}x}f(z(y(x)))$ evaluated at ${x}_{0}=[\\begin{aligned}1 \\\\ 1\\end{aligned}]?$"] ["question-b20e05f8-4c24-503b-a4d3-441eb6663ecb" :question/worked-solution "Using the chain rule, we have\n\n$$\n\\frac{\\text{d}}{\\text{d}x}f(z(y(x)))=\\frac{\\text{d}f}{\\text{d}z}\\cdot \\frac{\\text{d}z}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x}.\n$$\n\nLet's consider each of the factors in turn.\n\n- The function $f$ acts on a vector $z\\in {R}^{2}$ by multiplying it by $C$ and outputs a vector $f(z)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}f}{\\text{d}z}=C.\n$$\n\n- The function $z$ acts on a vector $y\\in {R}^{2}$ and outputs a vector $z(y)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}z}{\\text{d}y}=[\\begin{aligned}\\frac{∂{z}_{1}}{∂{y}_{1}} & \\frac{∂{z}_{1}}{∂{y}_{2}} \\\\ \\frac{∂{z}_{2}}{∂{y}_{1}} & \\frac{∂{z}_{2}}{∂{y}_{2}}\\end{aligned}]=[\\begin{aligned}1 & 1 \\\\ {y}_{2} & {y}_{1}\\end{aligned}].\n$$\n\nEvaluating at ${y}_{0}=A{x}_{0}=[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}1 \\\\ 1\\end{aligned}]=[\\begin{aligned}1 \\\\ -1\\end{aligned}],$ we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}y}{|}_{{y}_{0}}=[\\begin{aligned}1 & 1 \\\\ -1 & 1\\end{aligned}].\n$$\n\n- The function $y$ acts on a vector $x\\in {R}^{2}$ by multiplying it by $A$ and outputs a vector $y(x)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=A.\n$$\n\nTherefore, we have \n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}f(z(y(x))){|}_{{x}_{0}} & =\\frac{\\text{d}f}{\\text{d}z}{|}_{{z}_{0}}\\cdot \\frac{\\text{d}z}{\\text{d}y}{|}_{{y}_{0}}\\cdot \\frac{\\text{d}y}{\\text{d}x}{|}_{{x}_{0}} \\\\  & =[\\begin{aligned}-1 & 2 \\\\ 2 & -1\\end{aligned}]\\cdot [\\begin{aligned}1 & 1 \\\\ -1 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}-3 & 1 \\\\ 3 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}-3 & -1 \\\\ 3 & -1\\end{aligned}].\\end{aligned}\n$$"] ["question-b20e05f8-4c24-503b-a4d3-441eb6663ecb" :question/difficulty :question.difficulty/easy] ["answer-field-c755d686-d2d4-566f-b38a-59bbea939df7" :answer-field/id #uuid "c755d686-d2d4-566f-b38a-59bbea939df7"] ["answer-5c7514df-e1bc-5812-a620-8cfb7a50c83d" :answer/id #uuid "5c7514df-e1bc-5812-a620-8cfb7a50c83d"] ["answer-5c7514df-e1bc-5812-a620-8cfb7a50c83d" :answer/type :answer.type/math] ["answer-5c7514df-e1bc-5812-a620-8cfb7a50c83d" :answer/value "[\\begin{aligned}-1 & -3 \\\\ -1 & -3\\end{aligned}]"] ["answer-b27ede5d-7af1-5bce-8fc7-0ccefaa4d417" :answer/id #uuid "b27ede5d-7af1-5bce-8fc7-0ccefaa4d417"] ["answer-b27ede5d-7af1-5bce-8fc7-0ccefaa4d417" :answer/type :answer.type/math] ["answer-b27ede5d-7af1-5bce-8fc7-0ccefaa4d417" :answer/value "[\\begin{aligned}-3 & -1 \\\\ 1 & 3\\end{aligned}]"] ["answer-943602fe-250f-5da7-8665-bfa193685cee" :answer/id #uuid "943602fe-250f-5da7-8665-bfa193685cee"] ["answer-943602fe-250f-5da7-8665-bfa193685cee" :answer/type :answer.type/math] ["answer-943602fe-250f-5da7-8665-bfa193685cee" :answer/value "[\\begin{aligned}-3 & -1 \\\\ 3 & -1\\end{aligned}]"] ["answer-8b6d48ab-68bb-5c1b-8407-c446fe6de522" :answer/id #uuid "8b6d48ab-68bb-5c1b-8407-c446fe6de522"] ["answer-8b6d48ab-68bb-5c1b-8407-c446fe6de522" :answer/type :answer.type/math] ["answer-8b6d48ab-68bb-5c1b-8407-c446fe6de522" :answer/value "[\\begin{aligned}1 & -3 \\\\ 3 & -1\\end{aligned}]"] ["answer-dabf1b1a-c13a-50b4-9b8f-2cf8417ce8c4" :answer/id #uuid "dabf1b1a-c13a-50b4-9b8f-2cf8417ce8c4"] ["answer-dabf1b1a-c13a-50b4-9b8f-2cf8417ce8c4" :answer/type :answer.type/math] ["answer-dabf1b1a-c13a-50b4-9b8f-2cf8417ce8c4" :answer/value "[\\begin{aligned}1 & 1 \\\\ -3 & -3\\end{aligned}]"] ["answer-field-c755d686-d2d4-566f-b38a-59bbea939df7" :answer-field/key "selection"] ["answer-field-c755d686-d2d4-566f-b38a-59bbea939df7" :answer-field/type :answer-field.type/radio] ["answer-f