rrect "answer-81e06170-94bb-57c5-8a48-ffd04497f5e6"] ["answer-field-3b9e8840-aaa6-5d7d-9128-b8163c8808ca" :answer-field/choices "answer-81e06170-94bb-57c5-8a48-ffd04497f5e6"] ["answer-field-d909fbcb-d827-5b40-9359-4b2948795876" :answer-field/id #uuid "d909fbcb-d827-5b40-9359-4b2948795876"] ["answer-a27c0df3-4d1c-54e1-9219-aeb6df7ad819" :answer/id #uuid "a27c0df3-4d1c-54e1-9219-aeb6df7ad819"] ["answer-a27c0df3-4d1c-54e1-9219-aeb6df7ad819" :answer/type :answer.type/math] ["answer-a27c0df3-4d1c-54e1-9219-aeb6df7ad819" :answer/value "4"] ["answer-field-d909fbcb-d827-5b40-9359-4b2948795876" :answer-field/key "field-6"] ["answer-field-d909fbcb-d827-5b40-9359-4b2948795876" :answer-field/type :answer-field.type/blank] ["answer-field-d909fbcb-d827-5b40-9359-4b2948795876" :answer-field/correct "answer-a27c0df3-4d1c-54e1-9219-aeb6df7ad819"] ["answer-field-d909fbcb-d827-5b40-9359-4b2948795876" :answer-field/choices "answer-a27c0df3-4d1c-54e1-9219-aeb6df7ad819"] ["question-5b9f6727-3d7f-553c-90bd-4d6b87d491ad" :question/answer-fields "answer-field-97c12cb8-5725-50f2-aa29-32cc8b67a848"] ["question-5b9f6727-3d7f-553c-90bd-4d6b87d491ad" :question/answer-fields "answer-field-f3e88de5-3537-5d05-b414-2095d1fba253"] ["question-5b9f6727-3d7f-553c-90bd-4d6b87d491ad" :question/answer-fields "answer-field-a058cc13-5200-5985-ace8-aa6e1663852a"] ["question-5b9f6727-3d7f-553c-90bd-4d6b87d491ad" :question/answer-fields "answer-field-1a17a647-d699-507a-84b6-ca789a2ab305"] ["question-5b9f6727-3d7f-553c-90bd-4d6b87d491ad" :question/answer-fields "answer-field-3b9e8840-aaa6-5d7d-9128-b8163c8808ca"] ["question-5b9f6727-3d7f-553c-90bd-4d6b87d491ad" :question/answer-fields "answer-field-d909fbcb-d827-5b40-9359-4b2948795876"] [17592186204098 :knowledge-point/questions "question-5b9f6727-3d7f-553c-90bd-4d6b87d491ad"] ["question-43f51336-4d87-5e3a-8c17-d2fcf2b0a3a3" :question/id #uuid "43f51336-4d87-5e3a-8c17-d2fcf2b0a3a3"] ["question-43f51336-4d87-5e3a-8c17-d2fcf2b0a3a3" :question/math-academy-id "q-268179"] ["question-43f51336-4d87-5e3a-8c17-d2fcf2b0a3a3" :question/problem "Consider the functions $y:{R}^{3}\\to {R}^{2}$ and $f:{R}^{2}\\to {R}^{2},$ defined by\n\n$$\ny(x)=[\\begin{aligned}{x}_{1}{x}_{2}{x}_{3} \\\\ {x}_{1}+{x}_{2}+{x}_{3}\\end{aligned}].\\,f(y)=[\\begin{aligned}{y}_{1}+{y}_{2} \\\\ {y}_{1}{y}_{2}\\end{aligned}]\n$$\n\nAccording to the chain rule, the derivative \n\n$$\n\\frac{\\text{d}}{\\text{d}x}f(y(x))\n$$\n\nis the product of a$\\,\\,${{field-1}}$\\times ${{field-2}} \nmatrix with a \n{{field-3}} $\\times $ {{field-4}} \nmatrix, which results in a \n{{field-5}} $\\times $ {{field-6}} \nmatrix."] ["question-43f51336-4d87-5e3a-8c17-d2fcf2b0a3a3" :question/worked-solution "Using the chain rule, we have\n\n$$\n\\frac{\\text{d}}{\\text{d}x}f(y(x))=\\frac{\\text{d}f}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x}.\n$$\n\nLet's consider each of the factors in turn.\n\n- The function $f$ acts on a vector $y\\in {R}^{2}$ and outputs a vector $f(y)\\in {R}^{2}.$ Thus, the total derivative of $f$ with respect to $y$ is a $2\\times 2$ matrix.\n\n- The function $y$ acts on a vector $x\\in {R}^{3}$ and outputs a vector $y(x)\\in {R}^{2}.$ Thus, the total derivative of $y$ with respect to $x$ is a $2\\times 3$ matrix.\n\nTherefore, the product\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x}\n$$\n\nof a $2\\times 2$ matrix with a $2\\times 3$ matrix is a $2\\times 3$ matrix."] ["question-43f51336-4d87-5e3a-8c17-d2fcf2b0a3a3" :question/difficulty :question.difficulty/easy] ["answer-field-06e8af08-6f3d-542f-9c27-ac0092d1e952" :answer-field/id #uuid "06e8af08-6f3d-542f-9c27-ac0092d1e952"] ["answer-829eaf69-efe6-543a-8e00-aaeeb5a7bff9" :answer/id #uuid "829eaf69-efe6-543a-8e00-aaeeb5a7bff9"] ["answer-829eaf69-efe6-543a-8e00-aaeeb5a7bff9" :answer/type :answer.type/math] ["answer-829eaf69-efe6-543a-8e00-aaeeb5a7bff9" :answer/value "2"] ["answer-field-06e8af08-6f3d-542f-9c27-ac0092d1e952" :answer-field/key