d #uuid "6f00946b-80d3-591e-9f55-4d7a50d7a967"] ["answer-a551f62f-d8ff-5c79-9764-9e1a62f3bcb1" :answer/id #uuid "a551f62f-d8ff-5c79-9764-9e1a62f3bcb1"] ["answer-a551f62f-d8ff-5c79-9764-9e1a62f3bcb1" :answer/type :answer.type/math] ["answer-a551f62f-d8ff-5c79-9764-9e1a62f3bcb1" :answer/value "3"] ["answer-field-6f00946b-80d3-591e-9f55-4d7a50d7a967" :answer-field/key "field-4"] ["answer-field-6f00946b-80d3-591e-9f55-4d7a50d7a967" :answer-field/type :answer-field.type/blank] ["answer-field-6f00946b-80d3-591e-9f55-4d7a50d7a967" :answer-field/correct "answer-a551f62f-d8ff-5c79-9764-9e1a62f3bcb1"] ["answer-field-6f00946b-80d3-591e-9f55-4d7a50d7a967" :answer-field/choices "answer-a551f62f-d8ff-5c79-9764-9e1a62f3bcb1"] ["answer-field-37608c1b-6b71-5eee-be39-b1d5820e3583" :answer-field/id #uuid "37608c1b-6b71-5eee-be39-b1d5820e3583"] ["answer-1401d1ad-903b-53db-9c28-7363827d3400" :answer/id #uuid "1401d1ad-903b-53db-9c28-7363827d3400"] ["answer-1401d1ad-903b-53db-9c28-7363827d3400" :answer/type :answer.type/math] ["answer-1401d1ad-903b-53db-9c28-7363827d3400" :answer/value "2"] ["answer-field-37608c1b-6b71-5eee-be39-b1d5820e3583" :answer-field/key "field-5"] ["answer-field-37608c1b-6b71-5eee-be39-b1d5820e3583" :answer-field/type :answer-field.type/blank] ["answer-field-37608c1b-6b71-5eee-be39-b1d5820e3583" :answer-field/correct "answer-1401d1ad-903b-53db-9c28-7363827d3400"] ["answer-field-37608c1b-6b71-5eee-be39-b1d5820e3583" :answer-field/choices "answer-1401d1ad-903b-53db-9c28-7363827d3400"] ["answer-field-273ae1bc-6569-51f3-9b52-35e60079ae43" :answer-field/id #uuid "273ae1bc-6569-51f3-9b52-35e60079ae43"] ["answer-99131c34-2864-51f3-a766-2f1711213fb8" :answer/id #uuid "99131c34-2864-51f3-a766-2f1711213fb8"] ["answer-99131c34-2864-51f3-a766-2f1711213fb8" :answer/type :answer.type/math] ["answer-99131c34-2864-51f3-a766-2f1711213fb8" :answer/value "3"] ["answer-field-273ae1bc-6569-51f3-9b52-35e60079ae43" :answer-field/key "field-6"] ["answer-field-273ae1bc-6569-51f3-9b52-35e60079ae43" :answer-field/type :answer-field.type/blank] ["answer-field-273ae1bc-6569-51f3-9b52-35e60079ae43" :answer-field/correct "answer-99131c34-2864-51f3-a766-2f1711213fb8"] ["answer-field-273ae1bc-6569-51f3-9b52-35e60079ae43" :answer-field/choices "answer-99131c34-2864-51f3-a766-2f1711213fb8"] ["question-43f51336-4d87-5e3a-8c17-d2fcf2b0a3a3" :question/answer-fields "answer-field-06e8af08-6f3d-542f-9c27-ac0092d1e952"] ["question-43f51336-4d87-5e3a-8c17-d2fcf2b0a3a3" :question/answer-fields "answer-field-3b10feee-49bf-5f48-a752-82ca217efd7c"] ["question-43f51336-4d87-5e3a-8c17-d2fcf2b0a3a3" :question/answer-fields "answer-field-ce46bf49-6669-5133-a050-5509d649b2d1"] ["question-43f51336-4d87-5e3a-8c17-d2fcf2b0a3a3" :question/answer-fields "answer-field-6f00946b-80d3-591e-9f55-4d7a50d7a967"] ["question-43f51336-4d87-5e3a-8c17-d2fcf2b0a3a3" :question/answer-fields "answer-field-37608c1b-6b71-5eee-be39-b1d5820e3583"] ["question-43f51336-4d87-5e3a-8c17-d2fcf2b0a3a3" :question/answer-fields "answer-field-273ae1bc-6569-51f3-9b52-35e60079ae43"] [17592186204098 :knowledge-point/questions "question-43f51336-4d87-5e3a-8c17-d2fcf2b0a3a3"] ["question-dac59390-e4c1-5a03-ac45-73be8ac0d42f" :question/id #uuid "dac59390-e4c1-5a03-ac45-73be8ac0d42f"] ["question-dac59390-e4c1-5a03-ac45-73be8ac0d42f" :question/math-academy-id "q-270271"] ["question-dac59390-e4c1-5a03-ac45-73be8ac0d42f" :question/problem "Consider the functions $y:{R}^{2}\\to {R}^{2}$ and $f:{R}^{2}\\to {R}^{2},$ defined by\n\n$$\ny(x)=[\\begin{aligned}2{x}_{2} \\\\ {x}_{2}-3{x}_{1}\\end{aligned}],\\,f(y)=[\\begin{aligned}{y}_{1}^{2}+{y}_{2} \\\\ {y}_{1}+{y}_{2}^{2}\\end{aligned}].\n$$\n\nWhat is \n$\\frac{\\text{d}}{\\text{d}x}f(y(x))$ evaluated at \n${x}_{0}=[\\begin{aligned}0 \\\\ 1\\end{aligned}]?$\n\n<table cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"70px\" rowspan=\"2\" width=\"30px\">\n${\\frac{\\text{d}}{\\text{d}x}f(y(x))|}_{{x}_{0}}=\\,\\,$\n</td>\n<td align=\"center\" height=\"35px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"30px\">$9$</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>"] ["question-dac59390-e4c1-5a03-ac45-73be8ac0d42f" :question/worked-solution "Using the chain rule, we have\n\n$$\n\\frac{\\text{d}}{\\text{d}x}f(y(x))=\\frac{\\text{d}f}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x}.\n$$\n\nLet's consider each of the factors in turn.\n\n- The function $f$ acts on a vector $y\\in {R}^{2}$ and outputs a vector $f(y)\\in {R}^{2}.$ Thus, the total derivative of $f$ with respect to $y$ is a $2\\times 2$ matrix \n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}y} & =[\\begin{aligned}\\frac{∂{f}_{1}}{∂{y}_{1}} & \\frac{∂{f}_{1}}{∂{y}_{2}} \\\\ \\frac{∂{f}_{2}}{∂{y}_{1}} & \\frac{∂{f}_{2}}{∂{y}_{2}}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{∂}{∂{y}_{1}}({y}_{1}^{2}+{y}_{2}) & \\frac{∂}{∂{y}_{2}}({y}_{1}^{2}+{y}_{2}) \\\\ \\frac{∂}{∂{y}_{1}}({y}_{1}+{y}_{2}^{2}) & \\frac{∂}{∂{y}_{2}}({y}_{1}+{y}_{2}^{2})\\end{aligned}] \\\\  & =[\\begin{aligned}2{y}_{1} & 1 \\\\ 1 & 2{y}_{2}\\end{aligned}].\\end{aligned}\n$$\n\nEvaluating at ${y}_{0}=y({x}_{0})=[\\begin{aligned}2(1) \\\\ 1-3(0)\\end{aligned}]=[\\begin{aligned}2 \\\\ 1\\end{aligned}],$ we get\n\n$$\n\\frac{\\text{d}f}{\\text{d}y}{|}_{{y}_{0}}=[\\begin{aligned}4 & 1 \\\\ 1 & 2\\end{aligned}].\n$$\n\n- The function $y$ acts on a vector $x\\in {R}^{2}$ and outputs a vector $y(x)\\in {R}^{2}.$ Thus, the total derivative of $y$ with respect to $x$ is a $2\\times 2$ matrix\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =[\\begin{aligned}\\frac{∂{y}_{1}}{∂{x}_{1}} & \\frac{∂{y}_{1}}{∂{x}_{2}} \\\\ \\frac{∂{y}_{2}}{∂{x}_{1}} & \\frac{∂{y}_{2}}{∂{x}_{2}}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{∂}{∂{x}_{1}}(2{x}_{2}) & \\frac{∂}{∂{x}_{2}}(2{x}_{2}) \\\\ \\frac{∂}{∂{x}_{1}}({x}_{2}-3{x}_{1}) & \\frac{∂}{∂{x}_{2}}({x}_{2}-3{x}_{1})\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 2 \\\\ -3 & 1\\end{aligned}].\\end{aligned}\n$$\n\nEvaluating at ${x}_{0}=[\\begin{aligned}0 \\\\ 1\\end{aligned}],$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}{|}_{{x}_{0}}=[\\begin{aligned}0 & 2 \\\\ -3 & 1\\end{aligned}].\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}f(y(x)){|}_{{x}_{0}} & =\\frac{\\text{d}f}{\\text{d}y}{|}_{{y}_{0}}\\cdot \\frac{\\text{d}y}{\\text{d}x}{|}_{{x}_{0}} \\\\  & =[\\begin{aligned}4 & 1 \\\\ 1 & 2\\end{aligned}]\\cdot [\\begin{aligned}0 & 2 \\\\ -3 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-3 & 9 \\\\ -6 & 4\\end{aligned}].\\end{aligned}\n$$"] ["question-dac59390-e4c1-5a03-ac45-73be8ac0d42f" :question/difficulty :question.difficulty/easy] ["answer-field-3703a9d4-39d0-52e0-b2bc-ee344c22c3a9" :answer-field/id #uuid "3703a9d4-39d0-52e0-b2bc-ee344c22c3a9"] ["answer-21a18e2b-10b2-54ed-a6ac-5c17d190f8ab" :answer/id #uuid "21a18e2b-10b2-54ed-a6ac-5c17d190f8ab"] ["answer-21a18e2b-10b2-54ed-a6ac-5c17d190f8ab" :answer/type :answer.type/math] ["answer-21a18e2b-10b2-54ed-a6ac-5c17d190f8ab" :answer/value "-3"] ["answer-field-3703a9d4-39d0-52e0-b2bc-ee344c22c3a9" :answer-field/key "field-1"] ["answer-field-3703a9d4-39d0-52e0-b2bc-ee344c22c3a9" :answer-field/type :answer-field.type/blank] ["answer-field-3703a9d4-39d0-52e0-b2bc-ee344c22c3a9" :answer-field/correct "answer-21a18e2b-10b2-54ed-a6ac-5c17d190f8ab"] ["answer-field-3703a9d4-39d0-52e0-b2bc-ee344c22c3a9" :answer-field/choices "answer-21a18e2b-10b2-54ed-a6ac-5c17d190f8ab"] ["answer-field-488426ab-dda7-531e-996c-ff2ec4f75627" :answer-field/id #uuid "488426ab-dda7-531e-996c-ff2ec4f75627"] ["answer-5292515c-0fe0-52f1-9eb1-46ebf48da0df" :answer/id #uuid "5292515c-0fe0-52f1-9eb1-46ebf48da0df"] ["answer-5292515c-0fe0-52f1-9eb1-46ebf48da0df" :answer/type :answer.type/math] ["answer-5292515c-0fe0-52f1-9eb1-46ebf48da0df" :answer/value "-6"] ["answer-field-488426ab-dda7-531e-996c-ff2ec4f75627" :answer-field/key "field-2"] ["answer-field-488426ab-dda7-531e-996c-ff2ec4f75627" :answer-field/type :answer-field.type/blank] ["answer-field-488426ab-dda7-531e-996c-ff2ec4f75627" :answer-field/correct "answer-5292515c-0fe0-52f1-9eb1-46ebf48da0df"] ["answer-field-488426ab-dda7-531e-996c-ff2ec4f75627" :answer-field/choices "answer-5292515c-0fe0-52f1-9eb1-46ebf48da0df"] ["answer-field-d3e8934b-c392-5107-ac80-32d083b1ab1b" :answer-field/id #uuid "d3e8934b-c392-5107-ac80-32d083b1ab1b"] ["answer-44580490-2fa0-570f-bccb-1ec9835cc25e" :answer/id #uuid "44580490-2fa0-570f-bccb-1ec9835cc25e"] ["answer-44580490-2fa0-570f-bccb-1ec9835cc25e" :answer/type :answer.type/math] ["answer-44580490-2fa0-570f-bccb-1ec9835cc25e" :answer/value "4"] ["answer-field-d3e8934b-c392-5107-ac80-32d083b1ab1b" :answer-field/key "field-3"] ["answer-field-d3e8934b-c392-5107-ac80-32d083b1ab1b" :answer-field/type :answer-field.type/blank] ["answer-field-d3e8934b-c392-5107-ac80-32d083b1ab1b" :answer-field/correct "answer-44580490-2fa0-570f-bccb-1ec9835cc25e"] ["answer-field-d3e8934b-c392-5107-ac80-32d083b1ab1b" :answer-field/choices "answer-44580490-2fa0-570f-bccb-1ec9835cc25e"] ["question-dac59390-e4c1-5a03-ac45-73be8ac0d42f" :question/answer-fields "answer-field-3703a9d4-39d0-52e0-b2bc-ee344c22c3a9"] ["question-dac59390-e4c1-5a03-ac45-73be8ac0d42f" :question/answer-fields "answer-field-488426ab-dda7-531e-996c-ff2ec4f75627"] ["question-dac59390-e4c1-5a03-ac45-73be8ac0d42f" :question/answer-fields "answer-field-d3e8934b-c392-5107-ac80-32d083b1ab1b"] [17592186204099 :knowledge-point/questions "question-dac59390-e4c1-5a03-ac45-73be8ac0d42f"] ["question-78eabbdb-ae14-5218-80c9-de54367d95a9" :question/id #uuid "78eabbdb-ae14-5218-80c9-de54367d95a9"] ["question-78eabbdb-ae14-5218-80c9-de54367d95a9" :question/math-academy-id "q-270274"] ["question-78eabbdb-ae14-5218-80c9-de54367d95a9" :question/problem "Consider the functions $y:{R}^{2}\\to {R}^{2}$ and $f:{R}^{2}\\to {R}^{3},$ defined by\n\n$$\ny(x)=[\\begin{aligned}{x}_{1}{x}_{2} \\\\ -{x}_{1}^{2}\\end{aligned}],\\,f(y)=[\\begin{aligned}{y}_{1}^{2} \\\\ {y}_{1}^{2}+{y}_{2} \\\\ {y}_{1}^{2}{y}_{2}^{3}\\end{aligned}].\n$$\n\nWhat is \n$\\frac{\\text{d}}{\\text{d}x}f(y(x))$ evaluated at \n${x}_{0}=[\\begin{aligned}1 \\\\ -1\\end{aligned}]?$\n\n<table cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"70px\" rowspan=\"3\" width=\"30px\">\n${\\frac{\\text{d}}{\\text{d}x}f(y(x))|}_{{x}_{0}}=\\,\\,$\n</td>\n<td align=\"center\" height=\"35px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"30px\">{{field-2}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\" width=\"5px\"></td>\n<td align=\"center\">$0$</td>\n<td align=\"center\">$-2$</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">$-8$</td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>"] ["question-78eabbdb-ae14-5218-80c9-de54367d95a9" :question/worked-solution "Using the chain rule, we have\n\n$$\n\\frac{\\text{d}}{\\text{d}x}f(y(x))=\\frac{\\text{d}f}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x}.\n$$\n\nLet's consider each of the factors in turn.\n\n- The function $f$ acts on a vector $y\\in {R}^{2}$ and outputs a vector $f(y)\\in {R}^{3}.$ Thus, the total derivative of $f$ with respect to $y$ is a $3\\times 2$ matrix \n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}y} & =[\\begin{aligned}\\frac{∂{f}_{1}}{∂{y}_{1}} & \\frac{∂{f}_{1}}{∂{y}_{2}} \\\\ \\frac{∂{f}_{2}}{∂{y}_{1}} & \\frac{∂{f}_{2}}{∂{y}_{2}} \\\\ \\frac{∂{f}_{3}}{∂{y}_{1}} & \\frac{∂{f}_{3}}{∂{y}_{2}}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{∂}{∂{y}_{1}}({y}_{1}^{2}) & \\frac{∂}{∂{y}_{2}}({y}_{1}^{2}) \\\\ \\frac{∂}{∂{y}_{1}}({y}_{1}^{2}+{y}_{2}) & \\frac{∂}{∂{y}_{2}}({y}_{1}^{2}+{y}_{2}) \\\\ \\frac{∂}{∂{y}_{1}}({y}_{1}^{2}{y}_{2}^{3}) & \\frac{∂}{∂{y}_{2}}({y}_{1}^{2}{y}_{2}^{3})\\end{aligned}] \\\\  & =[\\begin{aligned}2{y}_{1} & 0 \\\\ 2{y}_{1} & 1 \\\\ 2{y}_{1}{y}_{2}^{3} & 3{y}_{1}^{2}{y}_{2}^{2}\\end{aligned}].\\end{aligned}\n$$\n\nEvaluating at ${y}_{0}=y({x}_{0})=[\\begin{aligned}1\\cdot (-1) \\\\ -{1}^{2}\\end{aligned}]=[\\begin{aligned}-1 \\\\ -1\\end{aligned}],$ we get\n\n$$\n\\frac{\\text{d}f}{\\text{d}y}{|}_{{y}_{0}}=[\\begin{aligned}-2 & 0 \\\\ -2 & 1 \\\\ 2 & 3\\end{aligned}].\n$$\n\n- The function $y$ acts on a vector $x\\in {R}^{2}$ and outputs a vector $y(x)\\in {R}^{2}.$ Thus, the total derivative of $y$ with respect to $x$ is a $2\\times 2$ matrix\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =[\\begin{aligned}\\frac{∂{y}_{1}}{∂{x}_{1}} & \\frac{∂{y}_{1}}{∂{x}_{2}} \\\\ \\frac{∂{y}_{2}}{∂{x}_{1}} & \\frac{∂{y}_{2}}{∂{x}_{2}}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{∂}{∂{x}_{1}}({x}_{1}{x}_{2}) & \\frac{∂}{∂{x}_{2}}({x}_{1}{x}_{2}) \\\\ \\frac{∂}{∂{x}_{1}}(-{x}_{1}^{2}) & \\frac{∂}{∂{x}_{2}}(-{x}_{1}^{2})\\end{aligned}] \\\\  & =[\\begin{aligned}{x}_{2} & {x}_{1} \\\\ -2{x}_{1} & 0\\end{aligned}].\\end{aligned}\n$$\n\nEvaluating at ${x}_{0}=[\\begin{aligned}1 \\\\ -1\\end{aligned}],$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}{|}_{{x}_{0}}=[\\begin{aligned}-1 & 1 \\\\ -2 & 0\\end{aligned}].\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}f(y(x)){|}_{{x}_{0}} & =\\frac{\\text{d}f}{\\text{d}y}{|}_{{y}_{0}}\\cdot \\frac{\\text{d}y}{\\text{d}x}{|}_{{x}_{0}} \\\\  & =[\\begin{aligned}-2 & 0 \\\\ -2 & 1 \\\\ 2 & 3\\end{aligned}]\\cdot [\\begin{aligned}-1 & 1 \\\\ -2 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -2 \\\\ 0 & -2 \\\\ -8 & 2\\end{aligned}].\\end{aligned}\n$$"] ["question-78eabbdb-ae14-5218-80c9-de54367d95a9" :question/difficulty :question.difficulty/hard] ["answer-field-0c22a089-927d-5420-ba5b-9d5a307d76f3" :answer-field/id #uuid "0c22a089-927d-5420-ba5