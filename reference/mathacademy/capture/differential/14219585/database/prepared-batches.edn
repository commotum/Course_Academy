d030-ce88-5d03-9b99-a627f5567a44" :answer-field/key "field-5" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-8b0c82a2-43e2-5e74-ab73-5dbf5726f9f1" :answer-field/choices ["answer-8b0c82a2-43e2-5e74-ab73-5dbf5726f9f1"] :db/ensure [:answer-field/validate]} {:db/id "answer-8b0c82a2-43e2-5e74-ab73-5dbf5726f9f1" :answer/id #uuid "8b0c82a2-43e2-5e74-ab73-5dbf5726f9f1" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-field-17626623-6533-5b07-939c-3abf99298482" :answer-field/id #uuid "17626623-6533-5b07-939c-3abf99298482" :answer-field/key "field-6" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-4f229e92-fe66-5af9-b60e-239b7802621b" :answer-field/choices ["answer-4f229e92-fe66-5af9-b60e-239b7802621b"] :db/ensure [:answer-field/validate]} {:db/id "answer-4f229e92-fe66-5af9-b60e-239b7802621b" :answer/id #uuid "4f229e92-fe66-5af9-b60e-239b7802621b" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id 17592186204588 :question/problem "Consider the functions $y:{R}^{2}\\to {R}^{2}$ and $f:{R}^{2}\\to {R}^{3},$ defined by\n\n$$\ny(x)=[\\begin{aligned}{x}_{2} \\\\ -{x}_{1}\\end{aligned}],\\,f(y)=[\\begin{aligned}{y}_{1} \\\\ {y}_{2} \\\\ {y}_{1}{y}_{2}\\end{aligned}].\n$$\n\nAccording to the chain rule, the derivative \n\n$$\n\\frac{\\text{d}}{\\text{d}x}f(y(x))\n$$\n\nis the product of a$\\,\\,${{field-1}}$\\times ${{field-2}} \nmatrix with a \n{{field-3}} $\\times $ {{field-4}} \nmatrix, which results in a \n{{field-5}} $\\times $ {{field-6}} \nmatrix." :question/worked-solution "Using the chain rule, we have\n\n$$\n\\frac{\\text{d}}{\\text{d}x}f(y(x))=\\frac{\\text{d}f}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x}.\n$$\n\nLet's consider each of the factors in turn.\n\n- The function $f$ acts on a vector $y\\in {R}^{2}$ and outputs a vector $f(y)\\in {R}^{3}.$ Thus, the total derivative of $f$ with respect to $y$ is a $3\\times 2$ matrix.\n\n- The function $y$ acts on a vector $x\\in {R}^{2}$ and outputs a vector $y(x)\\in {R}^{2}.$ Thus, the total derivative of $y$ with respect to $x$ is a $2\\times 2$ matrix.\n\nTherefore, the product\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x}\n$$\n\nof a $3\\times 2$ matrix with a $2\\times 2$ matrix is a $3\\times 2$ matrix." :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186203453 :answer-field/correct "answer-cb36d833-b394-57b0-9ea8-b980654e0a31" :answer-field/choices ["answer-cb36d833-b394-57b0-9ea8-b980654e0a31"] :db/ensure [:answer-field/validate]} {:db/id "answer-cb36d833-b394-57b0-9ea8-b980654e0a31" :answer/id #uuid "cb36d833-b394-57b0-9ea8-b980654e0a31" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id 17592186203448 :answer-field/correct "answer-d2a15cab-22a4-5667-9025-a13fecb07f29" :answer-field/choices ["answer-d2a15cab-22a4-5667-9025-a13fecb07f29"] :db/ensure [:answer-field/validate]} {:db/id "answer-d2a15cab-22a4-5667-9025-a13fecb07f29" :answer/id #uuid "d2a15cab-22a4-5667-9025-a13fecb07f29" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id 17592186203451 :answer-field/correct "answer-90adcee0-6574-5642-a3fb-858f2b17987c" :answer-field/choices ["answer-90adcee0-6574-5642-a3fb-858f2b17987c"] :db/ensure [:answer-field/validate]} {:db/id "answer-90adcee0-6574-5642-a3fb-858f2b17987c" :answer/id #uuid "90adcee0-6574-5642-a3fb-858f2b17987c" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id 17592186203452 :answer-field/correct "answer-b6bd040d-ba52-5de1-910d-4fc6ea69bd63" :answer-field/choices ["answer-b6bd040d-ba52-5de1-910d-4fc6ea69bd63"] :db/ensure [:answer-field/validate]} {:db/id "answer-b6bd040d-ba52-5de1-910d-4fc6ea69bd63" :answer/id #uuid "b6bd040d-ba52-5de1-910d-4fc6ea69bd63" :answer/type :answer.type/math :answer/value "2" :db/ensu