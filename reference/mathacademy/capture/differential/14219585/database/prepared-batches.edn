d}2 & 1 & 4 \\\\ 5 & 2 & 1\\end{aligned}][\\begin{aligned}2 & -2 \\\\ 3 & 3 \\\\ -3 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}-5 & -9 \\\\ 13 & -6\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-0ac0a5ce-5861-5053-9728-8c4fd1cb5e8f" "answer-field-46bae893-4ebe-51de-9570-54b7da87315d" "answer-field-62a00025-1e2a-56c1-80cf-393becfa5240"] :db/ensure [:question/validate]} {:db/id "answer-field-0ac0a5ce-5861-5053-9728-8c4fd1cb5e8f" :answer-field/id #uuid "0ac0a5ce-5861-5053-9728-8c4fd1cb5e8f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-3eb6efb2-996e-5718-b658-df34c48f6590" :answer-field/choices ["answer-3eb6efb2-996e-5718-b658-df34c48f6590"] :db/ensure [:answer-field/validate]} {:db/id "answer-3eb6efb2-996e-5718-b658-df34c48f6590" :answer/id #uuid "3eb6efb2-996e-5718-b658-df34c48f6590" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "answer-field-46bae893-4ebe-51de-9570-54b7da87315d" :answer-field/id #uuid "46bae893-4ebe-51de-9570-54b7da87315d" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-ec845946-3714-52e3-84bc-89dc914bbef4" :answer-field/choices ["answer-ec845946-3714-52e3-84bc-89dc914bbef4"] :db/ensure [:answer-field/validate]} {:db/id "answer-ec845946-3714-52e3-84bc-89dc914bbef4" :answer/id #uuid "ec845946-3714-52e3-84bc-89dc914bbef4" :answer/type :answer.type/math :answer/value "-9" :db/ensure [:answer/validate]} {:db/id "answer-field-62a00025-1e2a-56c1-80cf-393becfa5240" :answer-field/id #uuid "62a00025-1e2a-56c1-80cf-393becfa5240" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-da82b557-c258-5e35-96bb-e77807d62b45" :answer-field/choices ["answer-da82b557-c258-5e35-96bb-e77807d62b45"] :db/ensure [:answer-field/validate]} {:db/id "answer-da82b557-c258-5e35-96bb-e77807d62b45" :answer/id #uuid "da82b557-c258-5e35-96bb-e77807d62b45" :answer/type :answer.type/math :answer/value "13" :db/ensure [:answer/validate]} {:db/id 17592186204590 :question/problem "Consider the functions $y(x)=Ax$ and $f(y)=By,$ where $x\\in {R}^{3},y\\in {R}^{2},$ and the matrices $A$ and $B$ are given by\n\n$$\nA=[\\begin{aligned}4 & -2 & 5 \\\\ 2 & 3 & 1\\end{aligned}],\\,B=[\\begin{aligned}2 & -1 \\\\ 0 & 3\\end{aligned}].\n$$\n\nWhat is $\\frac{\\text{d}}{\\text{d}x}f(y(x))$ evaluated at ${x}_{0}=[0,\\,-1,\\,1]^{T}?$\n\n<table cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"70px\" rowspan=\"2\" width=\"30px\">\n${\\frac{\\text{d}}{\\text{d}x}f(y(x))|}_{{x}_{0}}=\\,\\,$\n</td>\n<td align=\"center\" height=\"35px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"30px\">{{field-2}}</td>\n<td align=\"center\" width=\"30px\">{{field-3}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">$6$</td>\n<td align=\"center\">{{field-4}}</td>\n<td align=\"center\">$3$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Using the chain rule, we have\n\n$$\n\\frac{\\text{d}}{\\text{d}x}f(y(x))=\\frac{\\text{d}f}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x}.\n$$\n\nLet's consider each of the factors in turn.\n\n- The function $f$ acts on a vector $y\\in {R}^{2}$ by multiplying it by $B$ and outputs a vector $f(y)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}f}{\\text{d}y}=B.\n$$\n\n- The function $y$ acts on a vector $x\\in {R}^{3}$ by multiplying it by $A$ and outputs a vector $y(x)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=A.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}f(y(x)) & =\\frac{\\text{d}f}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x} \\\\  & =BA \\\\  & =[\\begin{aligned}2 & -1 \\\\ 0 & 3\\end{aligned}][\\begin{aligned}4 & -2 & 5 \\\\ 2 & 3 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}6 & -7 & 9 \\\\ 6 & 9 & 3\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186203459 :answer-field/correct "answer-1aaa93cb-9bae-57f3-aafb-1f6b7516aa22" :answer-field/choices ["answer-1aaa93cb-9bae-57f3-aafb-1f6b7516aa22"] :db/ensure [:answer-field/validate]} {:db/id "answer-1aaa93cb-9bae-57f3-aafb-1f6b7516aa22" :answer/id #uuid "1aaa93cb-9bae-57f3-aafb-1f6b7516aa22" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id 17592186203458 :answer-field/correct "answer-463df682-92d8-56d8-92fc-869f6526ae63" :answer-field/choices ["answer-463df682-92d8-56d8-92fc-869f6526ae63"] :db/ensure [:answer-field/validate]} {:db/id "answer-463df682-92d8-56d8-92fc-869f6526ae63" :answer/id #uuid "463df682-92d8-56d8-92fc-869f6526ae63" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id 17592186203460 :answer-field/correct "answer-ecb98ecb-5d5e-5050-a3f9-48d2a87aeb75" :answer-field/choices ["answer-ecb98ecb-5d5e-5050-a3f9-48d2a87aeb75"] :db/ensure [:answer-field/validate]} {:db/id "answer-ecb98ecb-5d5e-5050-a3f9-48d2a87aeb75" :answer/id #uuid "ecb98ecb-5d5e-5050-a3f9-48d2a87aeb75" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id 17592186203457 :answer-field/correct "answer-be4fe82c-92fb-5f8f-90d3-234e29b3c139" :answer-field/choices ["answer-be4fe82c-92fb-5f8f-90d3-234e29b3c139"] :db/ensure [:answer-field/validate]} {:db/id "answer-be4fe82c-92fb-5f8f-90d3-234e29b3c139" :answer/id #uuid "be4fe82c-92fb-5f8f-90d3-234e29b3c139" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id 17592186204582 :question/problem "Consider the functions $y(x)=Ax$ and $f(y)=By,$ where $x\\in {R}^{3},y\\in {R}^{2},$ and the matrices $A$ and $B$ are given by\n\n$$\nA=[\\begin{aligned}1 & 2 & 3 \\\\ 2 & 4 & 6\\end{aligned}],\\,B=[\\begin{aligned}0 & 1 \\\\ 1 & 1 \\\\ 2 & 3\\end{aligned}].\n$$\n\nWhat is $\\frac{\\text{d}}{\\text{d}x}f(y(x))$ evaluated at ${x}_{0}=[1,\\,0,\\,1]^{T}?$\n\n<table cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"70px\" rowspan=\"3\" width=\"30px\">\n${\\frac{\\text{d}}{\\text{d}x}f(y(x))|}_{{x}_{0}}=\\,\\,$\n</td>\n<td align=\"center\" height=\"35px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"30px\">{{field-2}}</td>\n<td align=\"center\" width=\"30px\">{{field-3}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">$3$</td>\n<td align=\"center\">{{field-4}}</td>\n<td align=\"center\">$9$</td>\n<td align=\"center\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">$8$</td>\n<td align=\"center\">{{field-5}}</td>\n<td align=\"center\">$24$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Using the chain rule, we have\n\n$$\n\\frac{\\text{d}}{\\text{d}x}f(y(x))=\\frac{\\text{d}f}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x}.\n$$\n\nLet's consider each of the factors in turn.\n\n- The function $f$ acts on a vector $y\\in {R}^{2}$ by multiplying it by $B$ and outputs a vector $f(y)\\in {R}^{3}.$ Thus,\n\n$$\n\\frac{\\text{d}f}{\\text{d}y}=B.\n$$\n\n- The function $y$ acts on a vector $x\\in {R}^{3}$ by multiplying it by $A$ and outputs a vector $y(x)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=A.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}f(y(x)) & =\\frac{\\text{d}f}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x} \\\\  & =BA \\\\  & =[\\begin{aligned}0 & 1 \\\\ 1 & 1 \\\\ 2 & 3\\end{aligned}][\\begin{aligned}1 & 2 & 3 \\\\ 2 & 4 & 6\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 4 & 6 \\\\ 3 & 6 & 9 \\\\ 8 & 16 & 24\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186203424 :answer-field/correct "answer-8f93605a-da0e-549c-b764-c0d84e5801bf" :answer-field/choices ["answer-8f93605a-da0e-549c-b764-c0d84e5801bf"] :db/ensure [:answer-field/validate]} {:db/id "answer-8f93605a-da0e-549c-b764-c0d84e5801bf" :answer/id #uuid "8f93605a-da0e-549c-b764-c0d84e5801bf" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id 17592186203423 :answer-field/correct "answer-25ddbd4f-c089-554f-8752-bca2aefecb84" :answer-field/choices ["answer-25ddbd4f-c089-554f-8752-bca2aefecb84"] :db/ensure [:answer-field/validate]} {:db/id "answer-25ddbd4f-c089-554f-8752-bca2aefecb84" :answer/id #uuid "25ddbd4f-c089-554f-8752-bca2aefecb84" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id 17592186203427 :answer-field/correct "answer-27537bcf-01d8-5279-b7c5-d8bcb39361eb" :answer-field/choices ["answer-27537bcf-01d8-5279-b7c5-d8bcb39361eb"] :db/ensure [:answer-field/validate]} {:db/id "answer-27537bcf-01d8-5279-b7c5-d8bcb39361eb" :answer/id #uuid "27537bcf-01d8-5279-b7c5-d8bcb39361eb" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id 17592186203425 :answer-field/correct "answer-e0b711b8-90eb-5c9a-bf0b-e912d2cf977d" :answer-field/choices ["answer-e0b711b8-90eb-5c9a-bf0b-e912d2cf977d"] :db/ensure [:answer-field/validate]} {:db/id "answer-e0b711b8-90eb-5c9a-bf0b-e912d2cf977d" :answer/id #uuid "e0b711b8-90eb-5c9a-bf0b-e912d2cf977d" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id 17592186203426 :answer-field/correct "answer-ab09796d-e835-5a4b-80f8-cb91d15672b5" :answer-field/choices ["answer-ab09796d-e835-5a4b-80f8-cb91d15672b5"] :db/ensure [:answer-field/validate]} {:db/id "answer-ab09796d-e835-5a4b-80f8-cb91d15672b5" :answer/id #uuid "ab09796d-e835-5a4b-80f8-cb91d15672b5" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "question-b20e05f8-4c24-503b-a4d3-441eb6663ecb" :question/id #uuid "b20e05f8-4c24-503b-a4d3-441eb6663ecb" :question/math-academy-id "q-269827" :question/problem "For $x,y,z\\in {R}^{2},$ consider the following functions: \n\n$$\n\\begin{aligned} & y(x)=Ax\\,\\text{where}\\,A=[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}] \\\\  & z(y)=[\\begin{aligned}{y}_{1}+{y}_{2} \\\\ {y}_{1}{y}_{2}\\end{aligned}] \\\\  & f(z)=Cz\\,\\text{where}\\,C=[\\begin{aligned}-1 & 2 \\\\ 2 & -1\\end{aligned}]\\end{aligned}\n$$\n\nWhat is $\\frac{\\text{d}}{\\text{d}x}f(z(y(x)))$ evaluated at ${x}_{0}=[\\begin{aligned}1 \\\\ 1\\end{aligned}]?$" :question/worked-solution "Using the chain rule, we have\n\n$$\n\\frac{\\text{d}}{\\text{d}x}f(z(y(x)))=\\frac{\\text{d}f}{\\text{d}z}\\cdot \\frac{\\text{d}z}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x}.\n$$\n\nLet's consider each of the factors in turn.\n\n- The function $f$ acts on a vector $z\\in {R}^{2}$ by multiplying it by $C$ and outputs a vector $f(z)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}f}{\\text{d}z}=C.\n$$\n\n- The function $z$ acts on a vector $y\\in {R}^{2}$ and outputs a vector $z(y)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}z}{\\text{d}y}=[\\begin{aligned}\\frac{∂{z}_{1}}{∂{y}_{1}} & \\frac{∂{z}_{1}}{∂{y}_{2}} \\\\ \\frac{∂{z}_{2}}{∂{y}_{1}} & \\frac{∂{z}_{2}}{∂{y}_{2}}\\end{aligned}]=[\\begin{aligned}1 & 1 \\\\ {y}_{2} & {y}_{1}\\end{aligned}].\n$$\n\nEvaluating at ${y}_{0}=A{x}_{0}=[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}1 \\\\ 1\\end{aligned}]=[\\begin{aligned}1 \\\\ -1\\end{aligned}],$ we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}y}{|}_{{y}_{0}}=[\\begin{aligned}1 & 1 \\\\ -1 & 1\\end{aligned}].\n$$\n\n- The function $y$ acts on a vector $x\\in {R}^{2}$ by multiplying it by $A$ and outputs a vector $y(x)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=A.\n$$\n\nTherefore, we have \n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}f(z(y(x))){|}_{{x}_{0}} & =\\frac{\\text{d}f}{\\text{d}z}{|}_{{z}_{0}}\\cdot \\frac{\\text{d}z}{\\text{d}y}{|}_{{y}_{0}}\\cdot \\frac{\\text{d}y}{\\text{d}x}{|}_{{x}_{0}} \\\\  & =[\\begin{aligned}-1 & 2 \\\\ 2 & -1\\end{aligned}]\\cdot [\\begin{aligned}1 & 1 \\\\ -1 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}-3 & 1 \\\\ 3 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}-3 & -1 \\\\ 3 & -1\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c755d686-d2d4-566f-b38a-59bbea939df7"] :db/ensure [:question/validate]} {:db/id "answer-field-c755d686-d2d4-566f-b38a-59bbea939df7" :answer-field/id #uuid "c755d686-d2d4-566f-b38a-59bbea939df7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-943602fe-250f-5da7-8665-bfa193685cee" :answer-field/choices ["answer-5c7514df-e1bc-5812-a620-8cfb7a50c83d" "answer-b27ede5d-7af1-5bce-8fc7-0ccefaa4d417" "answer-943602fe-250f-5da7-8665-bfa193685cee" "answer-8b6d48ab-68bb-5c1b-8407-c446fe6de522" "answer-dabf1b1a-c13a-50b4-9b8f-2cf8417ce8c4"] :db/ensure [:answer-field/validate]} {:db/id "answer-5c7514df-e1bc-5812-a620-8cfb7a50c83d" :answer/id #uuid "5c7514df-e1bc-5812-a620-8cfb7a50c83d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 & -3 \\\\ -1 & -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-b27ede5d-7af1-5bce-8fc7-0ccefaa4d417" :answer/id #uuid "b27ede5d-7af1-5bce-8fc7-0ccefaa4d417" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-3 & -1 \\\\ 1 & 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-943602fe-250f-5da7-8665-bfa193685cee" :answer/id #uuid "943602fe-250f-5da7-8665-bfa193685cee" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-3 & -1 \\\\ 3 & -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-8b6d48ab-68bb-5c1b-8407-c446fe6de522" :answer/id #uuid "8b6d48ab-68bb-5c1b-8407-c446fe6de522" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & -3 \\\\ 3 & -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-dabf1b1a-c13a-50b4-9b8f-2cf8417ce8c4" :answer/id #uuid "dabf1b1a-c13a-50b4-9b8f-2cf8417ce8c4" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 1 \\\\ -3 & -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-c217a4e9-7d66-55f8-9bd7-c609e2aa5841" :question/id #uuid "c217a4e9-7d66-55f8-9bd7-c609e2aa5841" :question/math-academy-id "q-269825" :question/problem "For $x,y,z\\in {R}^{2},$ consider the following functions: \n\n$$\n\\begin{aligned} & y(x)=Ax\\,\\text{where}\\,A=[\\begin{aligned}5 & 3 \\\\ 3 & 4\\end{aligned}] \\\\  & z(y)=[\\begin{aligned}5{y}_{1}-3{y}_{2} \\\\ 4{y}_{1}+6{y}_{2}\\end{aligned}] \\\\  & f(z)=Cz\\,\\text{where}\\,C=[\\begin{aligned}-3 & 2 \\\\ 2 & -3\\end{aligned}]\\end{aligned}\n$$\n\nWhat is $\\frac{\\text{d}}{\\text{d}x}f(z(y(x)))$ evaluated at ${x}_{0}=[\\begin{aligned}-1 \\\\ 1\\end{aligned}]?$" :question/worked-solution "Using the chain rule, we have\n\n$$\n\\frac{\\text{d}}{\\text{d}x}f(z(y(x)))=\\frac{\\text{d}f}{\\text{d}z}\\cdot \\frac{\\text{d}z}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x}.\n$$\n\nLet's consider each of the factors in turn.\n\n- The function $f$ acts on a vector $z\\in {R}^{2}$ by multiplying it by $C$ and outputs a vector $f(z)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}f}{\\text{d}z}=C.\n$$\n\n- The function $z$ acts on a vector $y\\in {R}^{2}$ and outputs a vector $z(y)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}z}{\\text{d}y}=[\\begin{aligned}\\frac{∂{z}_{1}}{∂{y}_{1}} & \\frac{∂{z}_{1}}{∂{y}_{2}} \\\\ \\frac{∂{z}_{2}}{∂{y}_{1}} & \\frac{∂{z}_{2}}{∂{y}_{2}}\\end{aligned}]=[\\begin{aligned}5 & -3 \\\\ 4 & 6\\end{aligned}].\n$$\n\nEvaluating at ${y}_{0}=A{x}_{0}=[\\begin{aligned}5 & 3 \\\\ 3 & 4\\end{aligned}][\\begin{aligned}-1 \\\\ 1\\end{aligned}]=[\\begin{aligned}-2 \\\\ 1\\end{aligned}],$ we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}y}{|}_{{y}_{0}}=[\\begin{aligned}5 & -3 \\\\ 4 & 6\\end{aligned}].\n$$\n\n- The function $y$ acts on a vector $x\\in {R}^{2}$ by multiplying it by $A$ and outputs a vector $y(x)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=A.\n$$\n\nTherefore, we have \n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}f(z(y(x))){|}_{{x}_{0}} & =\\frac{\\text{d}f}{\\text{d}z}{|}_{{z}_{0}}\\cdot \\frac{\\text{d}z}{\\text{d}y}{|}_{{y}_{0}}\\cdot \\frac{\\text{d}y}{\\text{d}x}{|}_{{x}_{0}} \\\\  & =[\\begin{aligned}-3 & 2 \\\\ 2 & -3\\end{aligned}]\\cdot [\\begin{aligned}5 & -3 \\\\ 4 & 6\\end{aligned}]\\cdot [\\begin{aligned}5 & 3 \\\\ 3 & 4\\end{aligned}] \\\\  & =[\\begin{aligned}-7 & 21 \\\\ -2 & -24\\end{aligned}]\\cdot [\\begin{aligned}5 & 3 \\\\ 3 & 4\\end{aligned}] \\\\  & =[\\begin{aligned}28 & 63 \\\\ -82 & -102\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-9995b9e8-664d-5abc-9320-d2d470edb6d8"] :db/ensure [:question/validate]} {:db/id "answer-field-9995b9e8-664d-5abc-9320-d2d470edb6d8" :answer-field/id #uuid "9995b9e8-664d-5abc-9320-d2d470edb6d8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-53a94891-9fff-54e9-9526-058c5c41499e" :answer-field/choices ["answer-91f65eed-1275-5875-bff6-728f5637d753" "answer-086b120f-84b6-5efb-ac6c-fdd6070d629a" "answer-53a94891-9fff-54e9-9526-058c5c41499e" "answer-f9268e4f-998a-54d3-9a35-6e0114243c06" "answer-80dc457b-40f0-5416-88c9-738158bc9b61"] :db/ensure [:answer-field/validate]} {:db/id "answer-91f65eed-1275-5875-bff6-728f5637d753" :answer/id #uuid "91f65eed-1275-5875-bff6-728f5637d753" :answer/type :answer.type/math :answer/value "[\\begin{aligned}28 & 63 \\\\ -80 & -102\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-086b120f-84b6-5efb-ac6c-fdd6070d629a" :answer/id #uuid "086b120f-84b6-5efb-ac6c-fdd6070d629a" :answer/type :answer.type/math :answer/value "[\\begin{aligned}28 & 63 \\\\ -82 & -100\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-53a94891-9fff-54e9-9526-058c5c41499e" :answer/id #uuid "53a94891-9fff-54e9-9526-058c5c41499e" :answer/type :answer.type/math :answer/value "[\\begin{aligned}28 & 63 \\\\ -82 & -102\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-f9268e4f-998a-54d3-9a35-6e0114243c06" :answer/id #uuid "f9268e4f-998a-54d3-9a35-6e0114243c06" :answer/type :answer.type/math :answer/value "[\\begin{aligned}28 & 64 \\\\ -82 & -102\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-80dc457b-40f0-5416-88c9-738158bc9b61" :answer/id #uuid "80dc457b-40f0-5416-88c9-738158bc9b61" :answer/type :answer.type/math :answer/value "[\\begin{aligned}30 & 63 \\\\ -82 & -102\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-84a8217d-9b8f-5f74-ba0c-1dc1b7379e21" :question/id #uuid "84a8217d-9b8f-5f74-ba0c-1dc1b7379e21" :question/math-academy-id "q-269816" :question/problem "For $x,y,z\\in {R}^{2},$ consider the following functions: \n\n$$\n\\begin{aligned} & y(x)=Ax\\,\\text{where}\\,A=[\\begin{aligned}2 & 3 \\\\ -1 & 4\\end{aligned}] \\\\  & z(y)=[\\begin{aligned}2{y}_{1} \\\\ {y}_{1}-{y}_{2}\\end{aligned}] \\\\  & f(z)=Cz\\,\\text{where}\\,C=[\\begin{aligned}5 & 0 \\\\ 2 & 4\\end{aligned}]\\end{aligned}\n$$\n\nWhat is $\\frac{\\text{d}}{\\text{d}x}f(z(y(x)))$ evaluated at ${x}_{0}=[\\begin{aligned}1 \\\\ 1\\end{aligned}]?$" :question/worked-solution "Using the chain rule, we have\n\n$$\n\\frac{\\text{d}}{\\text{d}x}f(z(y(x)))=\\frac{\\text{d}f}{\\text{d}z}\\cdot \\frac{\\text{d}z}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x}.\n$$\n\nLet's consider each of the factors in turn.\n\n- The function $f$ acts on a vector $z\\in {R}^{2}$ by multiplying it by $C$ and outputs a vector $f(z)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}f}{\\text{d}z}=C.\n$$\n\n- The function $z$ acts on a vector $y\\in {R}^{2}$ and outputs a vector $z(y)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}z}{\\text{d}y}=[\\begin{aligned}\\frac{∂{z}_{1}}{∂{y}_{1}} & \\frac{∂{z}_{1}}{∂{y}_{2}} \\\\ \\frac{∂{z}_{2}}{∂{y}_{1}} & \\frac{∂{z}_{2}}{∂{y}_{2}}\\end{aligned}]=[\\begin{aligned}2 & 0 \\\\ 1 & -1\\end{aligned}].\n$$\n\nEvaluating at ${y}_{0}=A{x}_{0}=[\\begin{aligned}2 & 3 \\\\ -1 & 4\\end{aligned}][\\begin{aligned}1 \\\\ 1\\end{aligned}]=[\\begin{aligned}5 \\\\ 3\\end{aligned}],$ we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}y}{|}_{{y}_{0}}=[\\begin{aligned}2 & 0 \\\\ 1 & -1\\end{aligned}].\n$$\n\n- The function $y$ acts on a vector $x\\in {R}^{2}$ by multiplying it by $A$ and outputs a vector $y(x)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=A.\n$$\n\nTherefore, we have \n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}f(z(y(x))){|}_{{x}_{0}} & =\\frac{\\text{d}f}{\\text{d}z}{|}_{{z}_{0}}\\cdot \\frac{\\text{d}z}{\\text{d}y}{|}_{{y}_{0}}\\cdot \\frac{\\text{d}y}{\\text{d}x}{|}_{{x}_{0}} \\\\  & =[\\begin{aligned}5 & 0 \\\\ 2 & 4\\end{aligned}]\\cdot [\\begin{aligned}2 & 0 \\\\ 1 & -1\\end{aligned}]\\cdot [\\begin{aligned}2 & 3 \\\\ -1 & 4\\end{aligned}] \\\\  & =[\\begin{aligned}10 & 0 \\\\ 8 & -4\\end{aligned}]\\cdot [\\begin{aligned}2 & 3 \\\\ -1 & 4\\end{aligned}] \\\\  & =[\\begin{aligned}20 & 30 \\\\ 20 & 8\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-fd196ff8-da06-5ece-8bd7-2692100d1ca4"] :db/ensure [:question/validate]} {:db/id "answer-field-fd196ff8-da06-5ece-8bd7-2692100d1ca4" :answer-field/id #uuid "fd196ff8-da06-5ece-8bd7-2692100d1ca4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-df39de81-d0d3-5654-a882-36abf60eaa20" :answer-field/choices ["answer-1a94cb7e-93fa-5ae6-867e-dd055216d295" "answer-4e5f0dcf-acb7-567f-b3d0-d286714d4078" "answer-b72d5e70-4fb9-584a-8ad9-758dba2d99ac" "answer-bc5cce69-f255-593b-8730-23f6d96f322f" "answer-df39de81-d0d3-5654-a882-36abf60eaa20"] :db/ensure [:answer-field/validate]} {:db/id "answer-1a94cb7e-93fa-5ae6-867e-dd055216d295" :answer/id #uuid "1a94cb7e-93fa-5ae6-867e-dd055216d295" :answer/type :answer.type/math :answer/value "[\\begin{aligned}10 & 20 \\\\ 20 & 8\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-4e5f0dcf-acb7-567f-b3d0-d286714d4078" :answer/id #uuid "4e5f0dcf-acb7-567f-b3d0-d286714d4078" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 & 30 \\\\ 20 & 8\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-b72d5e70-4fb9-584a-8ad9-758dba2d99ac" :answer/id #uuid "b72d5e70-4fb9-584a-8ad9-758dba2d99ac" :answer/type :answer.type/math :answer/value "[\\begin{aligned}20 & 3 \\\\ 20 & 8\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-bc5cce69-f255-593b-8730-23f6d96f322f" :answer/id #uuid "bc5cce69-f255-593b-8730-23f6d96f322f" :answer/type :answer.type/math :answer/value "[\\begin{aligned}20 & 30 \\\\ 2 & 8\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-df39de81-d0d3-5654-a882-36abf60eaa20" :answer/id #uuid "df39de81-d0d3-5654-a882-36abf60eaa20" :answer/type :answer.type/math :answer/value "[\\begin{aligned}20 & 30 \\\\ 20 & 8\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-92b16d62-78ea-5a5a-bcd9-f319e1b69729" :question/id #uuid "92b16d62-78ea-5a5a-bcd9-f319e1b69729" :question/math-academy-id "q-269831" :question/problem "For $x,y,z\\in {R}^{2},$ consider the following functions: \n\n$$\n\\begin{aligned} & y(x)=Ax\\,\\text{where}\\,A=[\\begin{aligned}-1 & 2 \\\\ 0 & -2\\end{aligned}] \\\\  & z(y)=[\\begin{aligned}{y}_{1}{y}_{2} \\\\ {y}_{1}-{y}_{2}\\end{aligned}] \\\\  & f(z)=Cz\\,\\text{where}\\,C=[\\begin{aligned}3 & -1 \\\\ -1 & 3\\end{aligned}]\\end{aligned}\n$$\n\nWhat is $\\frac{\\text{d}}{\\text{d}x}f(z(y(x)))$ evaluated at ${x}_{0}=[\\begin{aligned}-2 \\\\ 3\\end{aligned}]?$" :question/worked-solution "Using the chain rule, we have\n\n$$\n\\frac{\\text{d}}{\\text{d}x}f(z(y(x)))=\\frac{\\text{d}f}{\\text{d}z}\\cdot \\frac{\\text{d}z}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x}.\n$$\n\nLet's consider each of the factors in turn.\n\n- The function $f$ acts on a vector $z\\in {R}^{2}$ by multiplying it by $C$ and outputs a vector $f(z)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}f}{\\text{d}z}=C.\n$$\n\n- The function $z$ acts on a vector $y\\in {R}^{2}$ and outputs a vector $z(y)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}z}{\\text{d}y}=[\\begin{aligned}\\frac{∂{z}_{1}}{∂{y}_{1}} & \\frac{∂{z}_{1}}{∂{y}_{2}} \\\\ \\frac{∂{z}_{2}}{∂{y}_{1}} & \\frac{∂{z}_{2}}{∂{y}_{2}}\\end{aligned}]=[\\begin{aligned}{y}_{2} & {y}_{1} \\\\ 1 & -1\\end{aligned}].\n$$\n\nEvaluating at ${y}_{0}=A{x}_{0}=[\\begin{aligned}-1 & 2 \\\\ 0 & -2\\end{aligned}][\\begin{aligned}-2 \\\\ 3\\end{aligned}]=[\\begin{aligned}8 \\\\ -6\\end{aligned}],$ we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}y}{|}_{{y}_{0}}=[\\begin{aligned}-6 & 8 \\\\ 1 & -1\\end{aligned}].\n$$\n\n- The function $y$ acts on a vector $x\\in {R}^{2}$ by multiplying it by $A$ and outputs a vector $y(x)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=A.\n$$\n\nTherefore, we have \n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}f(z(y(x))){|}_{{x}_{0}} & =\\frac{\\text{d}f}{\\text{d}z}{|}_{{z}_{0}}\\cdot \\frac{\\text{d}z}{\\text{d}y}{|}_{{y}_{0}}\\cdot \\frac{\\text{d}y}{\\text{d}x}{|}_{{x}_{0}} \\\\  & =[\\begin{aligned}3 & -1 \\\\ -1 & 3\\end{aligned}]\\cdot [\\begin{aligned}-6 & 8 \\\\ 1 & -1\\end{aligned}]\\cdot [\\begin{aligned}-1 & 2 \\\\ 0 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}-19 & 25 \\\\ 9 & -11\\end{aligned}]\\cdot [\\begin{aligned}-1 & 2 \\\\ 0 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}19 & -88 \\\\ -9 & 40\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-347be00c-b7a3-5258-b597-ed873c7cf1f0"] :db/ensure [:question/validate]} {:db/id "answer-field-347be00c-b7a3-5258-b597-ed873c7cf1f0" :answer-field/id #uuid "347be00c-b7a3-5258-b597-ed873c7cf1f0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7150f9f0-8b3a-58b9-b7ab-c5f3540c3446" :answer-field/choices ["answer-d0b2be93-0231-5ce8-91b0-c35a6853faec" "answer-ec440382-15ec-58b7-9144-6804e270724d" "answer-9abc5a7f-6578-582f-9791-8f55685a31b1" "answer-7150f9f0-8b3a-58b9-b7ab-c5f3540c3446" "answer-34758535-7d4d-5931-8a1f-911be1bf1e6f"] :db/ensure [:answer-field/validate]} {:db/id "answer-d0b2be93-0231-5ce8-91b0-c35a6853faec" :answer/id #uuid "d0b2be93-0231-5ce8-91b0-c35a6853faec" :answer/type :answer.type/math :answer/value "[\\begin{aligned}19 & -87 \\\\ -9 & 40\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-ec440382-15ec-58b7-9144-6804e270724d" :answer/id #uuid "ec440382-15ec-58b7-9144-6804e270724d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}19 & -88 \\\\ -10 & 40\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-9abc5a7f-6578-582f-9791-8f55685a31b1" :answer/id #uuid "9abc5a7f-6578-582f-9791-8f55685a31b1" :answer/type :answer.type/math :answer/value "[\\begin{aligned}19 & -88 \\\\ -9 & 30\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-7150f9f0-8b3a-58b9-b7ab-c5f3540c3446" :answer/id #uuid "7150f9f0-8b3a-58b9-b7ab-c5f3540c3446" :answer/type :answer.type/math :answer/value "[\\begin{aligned}19 & -88 \\\\ -9 & 40\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-34758535-7d4d-5931-8a1f-911be1bf1e6f" :answer/id #uuid "34758535-7d4d-5931-8a1f-911be1bf1e6f" :answer/type :answer.type/math :answer/value "[\\begin{aligned}20 & -88 \\\\ -9 & 40\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-1c1ab071-19e5-52c5-b033-ca671fa83041" :question/id #uuid "1c1ab071-19e5-52c5-b033-ca671fa83041" :question/math-academy-id "q-270277" :question/problem "For $x,y,z\\in {R}^{2},$ consider the following functions: \n\n$$\n\\begin{aligned} & y(x)=Ax\\,\\text{where}\\,A=[\\begin{aligned}0 & 1 \\\\ 2 & 1\\end{aligned}] \\\\  & z(y)=[\\begin{aligned}{y}_{1}-{y}_{2} \\\\ {y}_{1}^{2}\\end{aligned}] \\\\  & f(z)=Cz\\,\\text{where}\\,C=[\\begin{aligned}2 & -1 \\\\ 1 & 2\\end{aligned}]\\end{aligned}\n$$\n\nWhat is $\\frac{\\text{d}}{\\text{d}x}f(z(y(x)))$ evaluated at ${x}_{0}=[\\begin{aligned}1 \\\\ 0\\end{aligned}]?$" :question/worked-solution "Using the chain rule, we have\n\n$$\n\\frac{\\text{d}}{\\text{d}x}f(z(y(x)))=\\frac{\\text{d}f}{\\text{d}z}\\cdot \\frac{\\text{d}z}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x}.\n$$\n\nLet's consider each of the factors in turn.\n\n- The function $f$ acts on a vector $z\\in {R}^{2}$ by multiplying it by $C$ and outputs a vector $f(z)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}f}{\\text{d}z}=C.\n$$\n\n- The function $z$ acts on a vector $y\\in {R}^{2}$ and outputs a vector $z(y)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}z}{\\text{d}y}=[\\begin{aligned}\\frac{∂{z}_{1}}{∂{y}_{1}} & \\frac{∂{z}_{1}}{∂{y}_{2}} \\\\ \\frac{∂{z}_{2}}{∂{y}_{1}} & \\frac{∂{z}_{2}}{∂{y}_{2}}\\end{aligned}]=[\\begin{aligned}1 & -1 \\\\ 2{y}_{1} & 0\\end{aligned}].\n$$\n\nEvaluating at ${y}_{0}=A{x}_{0}=[\\begin{aligned}0 & 1 \\\\ 2 & 1\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}0 \\\\ 2\\end{aligned}],$ we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}y}{|}_{{y}_{0}}=[\\begin{aligned}1 & -1 \\\\ 0 & 0\\end{aligned}].\n$$\n\n- The function $y$ acts on a vector $x\\in {R}^{2}$ by multiplying it by $A$ and outputs a vector $y(x)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=A.\n$$\n\nTherefore, we have \n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}f(z(y(x))){|}_{{x}_{0}} & =\\frac{\\text{d}f}{\\text{d}z}{|}_{{z}_{0}}\\cdot \\frac{\\text{d}z}{\\text{d}y}{|}_{{y}_{0}}\\cdot \\frac{\\text{d}y}{\\text{d}x}{|}_{{x}_{0}} \\\\  & =[\\begin{aligned}2 & -1 \\\\ 1 & 2\\end{aligned}]\\cdot [\\begin{aligned}1 & -1 \\\\ 0 & 0\\end{aligned}]\\cdot [\\begin{aligned}0 & 1 \\\\ 2 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -2 \\\\ 1 & -1\\end{aligned}]\\cdot [\\begin{aligned}0 & 1 \\\\ 2 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-4 & 0 \\\\ -2 & 0\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-1a50b086-39a9-589d-8647-5c9e75a1557c"] :db/ensure [:question/validate]} {:db/id "answer-field-1a50b086-39a9-589d-8647-5c9e75a1557c" :answer-field/id #uuid "1a50b086-39a9-589d-8647-5c9e75a1557c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-83f3c631-6095-5bc6-9751-a09c65e0edda" :answer-field/choices ["answer-87da04e6-f999-5cb3-9b1f-26be1f323217" "answer-83f3c631-6095-5bc6-9751-a09c65e0edda" "answer-18a20064-991f-5f64-8730-30df670fc1ae" "answer-6be24f52-d6d5-5cdd-935d-3a061620637f" "answer-8ca00293-83cc-5c71-9ca0-c51f74e8d83c"] :db/ensure [:answer-field/validate]} {:db/id "answer-87da04e6-f999-5cb3-9b1f-26be1f323217" :answer/id #uuid "87da04e6-f999-5cb3-9b1f-26be1f323217" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-3 & 0 \\\\ -2 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-83f3c631-6095-5bc6-9751-a09c65e0edda" :answer/id #uuid "83f3c631-6095-5bc6-9751-a09c65e0edda" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-4 & 0 \\\\ -2 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-18a20064-991f-5f64-8730-30df670fc1ae" :answer/id #uuid "18a20064-991f-5f64-8730-30df670fc1ae" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-4 & 0 \\\\ -2 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-6be24f52-d6d5-5cdd-935d-3a061620637f" :answer/id #uuid "6be24f52-d6d5-5cdd-935d-3a061620637f" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-4 & 0 \\\\ -3 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-8ca00293-83cc-5c71-9ca0-c51f74e8d83c" :answer/id #uuid "8ca00293-83cc-5c71-9ca0-c51f74e8d83c" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-4 & 1 \\\\ -2 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id 17592186205190 :tutorial/content "Consider the multivariable function $f:\\mathbb R^n \\to\\mathbb R,$ defined by\n\n$$\nf(\\mathbf y) = f(y_1,y_2, \\ldots, y_n)\n$$\n\nwith $n$ independent variables, and $\\mathbf{y}: \\mathbb R \\to \\mathbb R^n,$ defined by\n\n![](images/af/afa5940765a9d39d7f8ab5aeefd4b550434adc0497b1b65845b00e30dd83d1f5.svg)\n\nwhich is a vector-valued function of a variable $x.$ \n\nIn a previous lesson, we saw that the derivative of $f(\\mathbf{y}(x))$ with respect to $x$ is given by the multivariable chain rule.\n\n$$\n\\dfrac{\\textrm{d} f}{\\textrm{d}x}= \\dfrac{\\partial f}{\\partial y_1} \\cdot \\dfrac{\\partial y_1}{\\partial x} + \\dfrac{\\partial f}{\\partial y_2} \\cdot \\dfrac{\\partial y_2}{\\partial x} + \\dots + \\dfrac{\\partial f}{\\partial y_n} \\cdot \\dfrac{\\partial y_n}{\\partial x}\n$$\n\nThis can be written as a product of matrices as follows:\n\n![](images/14/1482285b6db08d8b944fd98871736ffebd912d78842ceac6fbad959b9b9e9e6d.svg)\n\nNow, notice that this can be written as\n\n$$\n\\dfrac{\\textrm{d} f}{\\textrm{d}x}\n= \\underbrace{\\dfrac{\\textrm{d}f}{\\textrm{d}\\mathbf y}}_{1\\times n} \\cdot \\underbrace{\\dfrac{\\textrm{d}\\mathbf y}{\\textrm{d}x}}_{n\\times 1}\n$$\n\nwhere\n\n- $\\dfrac{\\textrm{d}f}{\\textrm{d}\\mathbf y}$ is the *total derivative* of $f$ with respect to $\\mathbf y$, which is a row vector of size $1\\times n$, and\n\n- $\\dfrac{\\textrm{d}\\mathbf y}{\\textrm{d}x}$ is the *total derivative* of $\\mathbf y$ with respect to $x$, which is a column vector of size $n\\times 1.$\n\nIn the next slides, we will apply this matrix formulation to a concrete example." :db/ensure [:tutorial/validate]} {:db/id 17592186205191 :tutorial/content "Let $\\mathbf{y}: \\mathbb{R}^n \\to \\mathbb{R}^q$ and $\\mathbf{f}: \\mathbb{R}^q \\to \\mathbb{R}^m$ be two differentiable vector-valued functions. We want to compute the derivative of the composition $\\mathbf{f}(\\mathbf{y}(\\mathbf{x}))$ with respect to $\\mathbf{x} \\in \\mathbb{R}^n.$\n\nThe **chain rule for total derivatives** tells us that\n\n$$\n\\underbrace{\\dfrac{\\textrm{d}\\mathbf{f}}{\\textrm{d} \\mathbf{x}}}_{m \\times n}\n=\n\\underbrace{\\dfrac{\\textrm{d}\\mathbf{f}}{\\textrm{d} \\mathbf{y}}}_{m \\times q}\n\\cdot\n\\underbrace{\\dfrac{\\textrm{d}\\mathbf{y}}{\\textrm{d} \\mathbf{x}}}_{q \\times n}.\n$$\n\nHere, the dot denotes matrix multiplication. The inner matrix dimensions match, so this is a valid matrix product.\n\n**Watch Out!** When applying the chain rule for total derivatives, the *order of multiplication matters!* For example, if we swap the order of the matrix products, we'd get an incorrect result:\n\n$$\n\\dfrac{\\textrm{d}\\mathbf{f}}{\\textrm{d} \\mathbf{x}} = \n\\underbrace{\\dfrac{\\textrm{d}\\mathbf{y}}{\\textrm{d} \\mathbf{x}}}_{q \\times n}\n\\cdot\n\\underbrace{\\dfrac{\\textrm{d}\\mathbf{f}}{\\textrm{d} \\mathbf{y}}}_{m \\times q}\n\\qquad \\text{(WRONG!)}\n$$\n\nThis is incorrect because the inner matrix dimensions do not agree, making it an invalid matrix product.\n\nLet's take a look at a concrete example." :db/ensure [:tutorial/validate]} {:db/id 17592186205198 :tutorial/content "Suppose we define\n![](images/11/11259475d7bcdbbdf2d28e6540f1af92282a188d05dd6d70038b00ec5ab611a5.svg)\n\nThen, we have $\\mathbf{f}: \\mathbb{R}^2 \\to \\mathbb{R}^2$ and $\\mathbf{y}: \\mathbb{R}^2 \\to \\mathbb{R}^2.$ \n\nLet's see how to compute the derivative for the composition $\\mathbf{f}(\\mathbf{y}(\\mathbf{x})).$\n\nThe chain rule states that\n\n$$\n\\dfrac{\\textrm{d} \\mathbf{f}}{\\textrm{d} \\mathbf{x}} \n= \\dfrac{\\textrm{d}\\mathbf{f}}{\\textrm{d} \\mathbf{y}}\n\\cdot\n\\dfrac{\\textrm{d}\\mathbf{y}}{\\textrm{d} \\mathbf{x}}.\n$$\n\nLet's consider each of the factors in turn.\n\n- The function $\\mathbf{f}$ acts on a vector $\\mathbf{y} \\in \\mathbb{R}^2$ and outputs a vector $\\mathbf{f}(\\mathbf{y}) \\in \\mathbb{R}^2.$ Thus, the total derivative of $\\mathbf{f}$ with respect to $\\mathbf{y}$ is a $2\\times 2$ matrix.\n\n- The function $\\mathbf{y}$ acts on a vector $\\mathbf{x} \\in \\mathbb{R}^2$ and outputs a vector $\\mathbf{y}(\\mathbf{x}) \\in \\mathbb{R}^2.$ Thus, the total derivative of $\\mathbf{y}$ with respect to $\\mathbf{x}$ is also a $2\\times 2$ matrix.\n\nComputing our derivatives, we get\n![](images/91/918c4e1af2c1f33f6d056843ee0d038b4b91dc67e8c112c899a05c273d5fcd89.svg)\n\nThen, by the chain rule, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x} \\\\  & =[\\begin{aligned}1 & 1 \\\\ 1 & -2\\end{aligned}]\\cdot [\\begin{aligned}2{x}_{1} & 0 \\\\ 0 & 2{x}_{2}\\end{aligned}] \\\\  & =[\\begin{aligned}2{x}_{1} & 2{x}_{2} \\\\ 2{x}_{1} & -4{x}_{2}\\end{aligned}].\\end{aligned}\n$$\n\nThis matrix gives us the total derivative of $\\mathbf f$ with respect to $\\mathbf x.$" :db/ensure [:tutorial/validate]} {:db/id 17592186205217 :tutorial/content "Let's *verify* that our result from the previous slide is correct by computing the derivative directly.\n\nRecall that\n![](images/3e/3e421d8e8fdac73c75fbec18f98a7b338ac46083ea0c4d07cd8f07121420dac1.svg)\n\nFirst, we substitute $\\mathbf{y}$ into $\\mathbf{f}$ to write $\\mathbf{f}$ explicitly in terms of $\\mathbf{x}{:}$\n![](images/58/58f11371168007d979c4ffeae1e6643441459b015d7cf7a08e60c5b05e4f93a1.svg) \n\nNow, we compute the derivative of $\\mathbf f$ with respect to $\\mathbf x{:}$\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =[\\begin{aligned}\\frac{∂{f}_{1}}{∂{x}_{1}} & \\frac{∂{f}_{1}}{∂{x}_{2}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & \\frac{∂{f}_{2}}{∂{x}_{2}}\\end{aligned}] \\\\  & =[\\begin{aligned}2{x}_{1} & 2{x}_{2} \\\\ 2{x}_{1} & -4{x}_{2}\\end{aligned}].\\end{aligned}\n$$\n\nThis agrees with the result we obtained using the chain rule." :db/ensure [:tutorial/validate]} {:db/id 17592186205218 :tutorial/content "We can use the chain rule for functions that use matrices in their definition.\n\nFor example, consider the functions $\\mathbf{y}(\\mathbf{x}) = \\mathbf{A}\\mathbf{x}$ and $\\mathbf{f}(\\mathbf{y}) = \\mathbf{B}\\mathbf{y},$ where $\\mathbf x\\in \\mathbb R^3, \\mathbf y\\in\\mathbb R^2,$ and the matrices $\\mathbf{A}$ and $\\mathbf{B}$ are given by\n![](images/c7/c721b41403d149ac6d97e543aabb22dec2ce200c99e4dccdae09204eb520b555.svg)\nWhat is $\\dfrac{\\textrm d}{\\textrm d \\mathbf x} \\mathbf{f}(\\mathbf{y}(\\mathbf x))$ evaluated at $\\mathbf{x}_0 = [2, \\, 0, \\, -1]^T?$\n\nUsing the chain rule, we have\n\n$$\n\\dfrac{\\textrm d}{\\textrm d \\mathbf x} \\mathbf{f}(\\mathbf{y}(\\mathbf x)) = \\dfrac{\\textrm d\\mathbf f}{\\textrm d \\mathbf y} \\cdot \\dfrac{\\textrm d\\mathbf y}{\\textrm d \\mathbf x}.\n$$\n\nLet's consider each of the factors in turn.\n\n- The function $\\mathbf{f}$ acts on a vector $\\mathbf{y} \\in \\mathbb{R}^2$ by multiplying it by $\\mathbf{B}$ and outputs a vector $\\mathbf{f}(\\mathbf{y}) \\in \\mathbb{R}^2.$ Thus,\n\n$$\n\\dfrac{\\textrm d\\mathbf f}{\\textrm d \\mathbf y} = \\mathbf{B}.\n$$\n\n- The function $\\mathbf{y}$ acts on a vector $\\mathbf{x} \\in \\mathbb{R}^3$ by multiplying it by $\\mathbf{A}$ and outputs a vector $\\mathbf{y}(\\mathbf{x}) \\in \\mathbb{R}^2.$ Thus,\n\n$$\n\\dfrac{\\textrm d\\mathbf y}{\\textrm d \\mathbf x} = \\mathbf{A}.\n$$\n\nSince these derivatives are constant matrices, the value at $\\mathbf{x}_0$ is simply their product. Therefore, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}f(y(x)) & =\\frac{\\text{d}f}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x} \\\\  & =BA \\\\  & =[\\begin{aligned}3 & 2 \\\\ 1 & -1\\end{aligned}][\\begin{aligned}1 & 0 & 2 \\\\ -1 & 3 & 4\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 6 & 14 \\\\ 2 & -3 & -2\\end{aligned}].\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186205199 :tutorial/content "Suppose we have the following differentiable functions:\n\n$$\n\\mathbf{y}: \\mathbb{R}^n \\to \\mathbb{R}^p, \\qquad\n\n\\mathbf{z}: \\mathbb{R}^p \\to \\mathbb{R}^q, \\qquad \\mathbf{f}: \\mathbb{R}^q \\to \\mathbb{R}^m\n$$\n\nThe chain rule can be extended in the natural way as follows:\n\n$$\n\\dfrac{\\textrm d}{\\textrm d \\mathbf x} \\mathbf{f}(\\mathbf{z}(\\mathbf{y}(\\mathbf x))) \n= \n\\underbrace{\\dfrac{\\textrm d\\mathbf f}{\\textrm d \\mathbf z}}_{m\\times q} \n\\cdot \n\\underbrace{\\dfrac{\\textrm d\\mathbf z}{\\textrm d \\mathbf y}}_{q\\times p} \n\\cdot \n\\underbrace{\\dfrac{\\textrm d\\mathbf y}{\\textrm d \\mathbf x}}_{p\\times n}\n$$\n\nLet's see an example." :db/ensure [:tutorial/validate]} {:db/id 17592186204181 :activity/expected-seconds 1440.0 :db/ensure [:activity/validate]}] "assertions" [[17592186203868 :question/problem "Consider the functions $\\mathbf y: \\mathbb R^3\\to \\mathbb R^2$ and $\\mathbf f: \\mathbb R^2\\to \\mathbb R^2,$ defined by\n![](images/cd/cd2fdbccada4cc5278411db56d86dc72e44aa183fbe9a0c564c4eee587072fef.svg)\n\nDetermine the dimensions of the matrix representing the derivative\n\n$$\n\\dfrac{\\textrm d}{\\textrm d \\mathbf x} \\mathbf{f}(\\mathbf{y}(\\mathbf x)) .\n$$"] [17592186203868 :question/worked-solution "Using the chain rule, we have\n\n$$\n\\dfrac{\\textrm d}{\\textrm d \\mathbf x} \\mathbf{f}(\\mathbf{y}(\\mathbf x)) = \\dfrac{\\textrm d\\mathbf f}{\\textrm d \\mathbf y} \\cdot \\dfrac{\\textrm d\\mathbf y}{\\textrm d \\mathbf x}.\n$$\n\nLet's consider each of the factors in turn.\n\n- The function $\\mathbf{f}$ acts on a vector $\\mathbf{y} \\in \\mathbb{R}^2$ and outputs a vector $\\mathbf{f}(\\mathbf{y}) \\in \\mathbb{R}^2.$ Thus, the total derivative of $\\mathbf{f}$ with respect to $\\mathbf{y}$ is a $2\\times 2$ matrix.\n\n- The function $\\mathbf{y}$ acts on a vector $\\mathbf{x} \\in \\mathbb{R}^3$ and outputs a vector $\\mathbf{y}(\\mathbf{x}) \\in \\mathbb{R}^2.$ Thus, the total derivative of $\\mathbf{y}$ with respect to $\\mathbf{x}$ is a $2\\times 3$ matrix.\n\nTherefore, the product\n\n$$\n\\dfrac{\\textrm d\\mathbf f}{\\textrm d \\mathbf x}= \\dfrac{\\textrm d\\mathbf f}{\\textrm d \\mathbf y} \\cdot \\dfrac{\\textrm d\\mathbf y}{\\textrm d \\mathbf x}\n$$\n\nof a $2\\times 2$ matrix with a $2\\times 3$ matrix is a $2\\times 3$ matrix."] [17592186203869 :question/problem "Consider the functions $\\mathbf y: \\mathbb R^3\\to \\mathbb R^2$ and $\\mathbf f: \\mathbb R^2\\to \\mathbb R^2,$ defined by\n![](images/82/823c7500670ec7deeb16b8f656904010f2a579d40f8967ee5f9948f93a2d0c3d.svg)\nWhat is \n$\\dfrac{\\textrm d}{\\textrm d \\mathbf x} \\mathbf{f}(\\mathbf{y}(\\mathbf x))$ evaluated at \n![](images/31/311debaad69f328c5e9acc9ec0b218eded626be5a9e93f5b07837dc4c296fdaa.svg)"] [17592186203869 :question/worked-solution "Using the chain rule, we have\n\n$$\n\\dfrac{\\textrm d}{\\textrm d \\mathbf x} \\mathbf{f}(\\mathbf{y}(\\mathbf x)) = \\dfrac{\\textrm d\\mathbf f}{\\textrm d \\mathbf y} \\cdot \\dfrac{\\textrm d\\mathbf y}{\\textrm d \\mathbf x}.\n$$\n\nLet's consider each of the factors in turn.\n\n- The function $\\mathbf{f}$ acts on a vector $\\mathbf{y} \\in \\mathbb{R}^2$ and outputs a vector $\\mathbf{f}(\\mathbf{y}) \\in \\mathbb{R}^2.$ Thus, the total derivative of $\\mathbf{f}$ with respect to $\\mathbf{y}$ is a $2\\times 2$ matrix \n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}y} & =[\\begin{aligned}\\frac{∂{f}_{1}}{∂{y}_{1}} & \\frac{∂{f}_{1}}{∂{y}_{2}} \\\\ \\frac{∂{f}_{2}}{∂{y}_{1}} & \\frac{∂{f}_{2}}{∂{y}_{2}}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{∂}{∂{y}_{1}}({y}_{1}+{y}_{2}) & \\frac{∂}{∂{y}_{2}}({y}_{1}+{y}_{2}) \\\\ \\frac{∂}{∂{y}_{1}}({y}_{1}-{y}_{2}) & \\frac{∂}{∂{y}_{2}}({y}_{1}-{y}_{2})\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 1 \\\\ 1 & -1\\end{aligned}].\\end{aligned}\n$$\n\nEvaluating at ![](images/46/46e607310554414649de798f3b01d1965364d6d652e2ab308d4e5c2647d93ca2.svg) we get\n![](images/95/950fed4e51766a66f71026c05093c38764bc1f0bc9c4c5136015a4187c2c1154.svg)\n\n- The function $\\mathbf{y}$ acts on a vector $\\mathbf{x} \\in \\mathbb{R}^3$ and outputs a vector $\\mathbf{y}(\\mathbf{x}) \\in \\mathbb{R}^2.$ Thus, the total derivative of $\\mathbf{y}$ with respect to $\\mathbf{x}$ is a $2\\times 3$ matrix\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =[\\begin{aligned}\\frac{∂{y}_{1}}{∂{x}_{1}} & \\frac{∂{y}_{1}}{∂{x}_{2}} & \\frac{∂{y}_{1}}{∂{x}_{3}} \\\\ \\frac{∂{y}_{2}}{∂{x}_{1}} & \\frac{∂{y}_{2}}{∂{x}_{2}} & \\frac{∂{y}_{2}}{∂{x}_{3}}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{∂}{∂{x}_{1}}({x}_{1}-{x}_{2}{x}_{3}) & \\frac{∂}{∂{x}_{2}}({x}_{1}-{x}_{2}{x}_{3}) & \\frac{∂}{∂{x}_{3}}({x}_{1}-{x}_{2}{x}_{3}) \\\\ \\frac{∂}{∂{x}_{1}}({x}_{1}+{x}_{2}{x}_{3}) & \\frac{∂}{∂{x}_{2}}({x}_{1}+{x}_{2}{x}_{3}) & \\frac{∂}{∂{x}_{3}}({x}_{1}+{x}_{2}{x}_{3})\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -{x}_{3} & -{x}_{2} \\\\ 1 & {x}_{3} & {x}_{2}\\end{aligned}].\\end{aligned}\n$$\n\nEvaluating at ![](images/54/547759836320b9850df4a70d8ba19a05741412cc0935dcc43caf8224da07fdce.svg) we get\n![](images/94/94bf8ffbcce681efde92719b220545ac89cdee324cd4dedf391b62e916a3ee8e.svg)\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}f(y(x)){|}_{{x}_{0}} & =\\frac{\\text{d}f}{\\text{d}y}{|}_{{y}_{0}}\\cdot \\frac{\\text{d}y}{\\text{d}x}{|}_{{x}_{0}} \\\\  & =[\\begin{aligned}1 & 1 \\\\ 1 & -1\\end{aligned}]\\cdot [\\begin{aligned}1 & 1 & -1 \\\\ 1 & -1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 0 & 0 \\\\ 0 & 2 & -2\\end{aligned}].\\end{aligned}\n$$"] [17592186203873 :question/problem "Consider the functions $\\mathbf{y}(\\mathbf{x}) = \\mathbf{A}\\mathbf{x}$ and $\\mathbf{f}(\\mathbf{y}) = \\mathbf{B}\\mathbf{y},$ where $\\mathbf x\\in \\mathbb R^3, \\mathbf y\\in\\mathbb R^2,$ and the matrices $\\mathbf{A}$ and $\\mathbf{B}$ are given by\n![](images/93/93f1a584378171c20649f8c1505162f580fad7074bbb73a571b2eff1ef53b57e.svg)\nWhat is $\\dfrac{\\textrm d}{\\textrm d \\mathbf x} \\mathbf{f}(\\mathbf{y}(\\mathbf x))$ evaluated at $\\mathbf{x}_0 = [1, \\, 0, \\, -2]^T?$"] [17592186203873 :question/worked-solution "Using the chain rule, we have\n\n$$\n\\dfrac{\\textrm d}{\\textrm d \\mathbf x} \\mathbf{f}(\\mathbf{y}(\\mathbf x)) = \\dfrac{\\textrm d\\mathbf f}{\\textrm d \\mathbf y} \\cdot \\dfrac{\\textrm d\\mathbf y}{\\textrm d \\mathbf x}.\n$$\n\nLet's consider each of the factors in turn.\n\n- The function $\\mathbf{f}$ acts on a vector $\\mathbf{y} \\in \\mathbb{R}^2$ by multiplying it by $\\mathbf{B}$ and outputs a vector $\\mathbf{f}(\\mathbf{y}) \\in \\mathbb{R}^3.$ Thus,\n\n$$\n\\dfrac{\\textrm d\\mathbf f}{\\textrm d \\mathbf y} = \\mathbf{B}.\n$$\n\n- The function $\\mathbf{y}$ acts on a vector $\\mathbf{x} \\in \\mathbb{R}^3$ by multiplying it by $\\mathbf{A}$ and outputs a vector $\\mathbf{y}(\\mathbf{x}) \\in \\mathbb{R}^2.$ Thus,\n\n$$\n\\dfrac{\\textrm d\\mathbf y}{\\textrm d \\mathbf x} = \\mathbf{A}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}f(y(x)) & =\\frac{\\text{d}f}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x} \\\\  & =BA \\\\  & =[\\begin{aligned}-1 & 0 \\\\ -3 & 1 \\\\ 2 & 4\\end{aligned}][\\begin{aligned}2 & 1 & 0 \\\\ 4 & -3 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & -1 & 0 \\\\ -2 & -6 & 1 \\\\ 20 & -10 & 4\\end{aligned}].\\end{aligned}\n$$"] [17592186203870 :question/problem "For $\\mathbf x, \\mathbf y, \\mathbf z\\in\\mathbb R^2,$ consider the following functions: \n\n$$\n\\begin{aligned} & y(x)=Ax\\,\\text{where}\\,A=[\\begin{aligned}-1 & 1 \\\\ 0 & -1\\end{aligned}] \\\\  & z(y)=[\\begin{aligned}{y}_{1}-{y}_{2} \\\\ {y}_{1}{y}_{2}\\end{aligned}] \\\\  & f(z)=Cz\\,\\text{where}\\,C=[\\begin{aligned}2 & -1 \\\\ -1 & 2\\end{aligned}]\\end{aligned}\n$$\n\nWhat is $\\dfrac{\\textrm d}{\\textrm d \\mathbf x} \\mathbf{f}(\\mathbf{z}(\\mathbf{y}(\\mathbf x)))$ evaluated at ![](images/76/7625625edbb65c637775812baec802a512b580b45e94c896764377cd23a0f946.svg)"] [17592186203870 :question/worked-solution "Using the chain rule, we have\n\n$$\n\\dfrac{\\textrm d}{\\textrm d \\mathbf x} \\mathbf{f}(\\mathbf{z}(\\mathbf{y}(\\mathbf x))) = \\dfrac{\\textrm d\\mathbf f}{\\textrm d \\mathbf z} \\cdot \\dfrac{\\textrm d\\mathbf z}{\\textrm d \\mathbf y} \\cdot \\dfrac{\\textrm d\\mathbf y}{\\textrm d \\mathbf x}.\n$$\n\nLet's consider each of the factors in turn.\n\n- The function $\\mathbf{f}$ acts on a vector $\\mathbf{z} \\in \\mathbb{R}^2$ by multiplying it by $\\mathbf{C}$ and outputs a vector $\\mathbf{f}(\\mathbf{z}) \\in \\mathbb{R}^2.$ Thus,\n\n$$\n\\dfrac{\\textrm d\\mathbf f}{\\textrm d \\mathbf z} = \\mathbf{C}.\n$$\n\n- The function $\\mathbf{z}$ acts on a vector $\\mathbf{y} \\in \\mathbb{R}^2$ and outputs a vector $\\mathbf{z}(\\mathbf{y}) \\in \\mathbb{R}^2.$ Thus,\n![](images/aa/aa560155df00efd7959768d56e38ef7fea999b06d2bfe5515b1af01f2184aaf4.svg)\nEvaluating at ![](images/9e/9ee03503efd8d3da6a4aa7e012eef1d0e390d014aa6ceae1b0f18acd82b5c08f.svg) we get\n![](images/73/73522ffceb4c0e0f4d3cad330414660ad822609c67a0a0024cdab2cb62c13778.svg)\n\n- The function $\\mathbf{y}$ acts on a vector $\\mathbf{x} \\in \\mathbb{R}^2$ by multiplying it by $\\mathbf{A}$ and outputs a vector $\\mathbf{y}(\\mathbf{x}) \\in \\mathbb{R}^2.$ Thus,\n\n$$\n\\dfrac{\\textrm d\\mathbf y}{\\textrm d \\mathbf x} = \\mathbf{A}.\n$$\n\nTherefore, we have \n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}f(z(y(x))){|}_{{x}_{0}} & =\\frac{\\text{d}f}{\\text{d}z}{|}_{{z}_{0}}\\cdot \\frac{\\text{d}z}{\\text{d}y}{|}_{{y}_{0}}\\cdot \\frac{\\text{d}y}{\\text{d}x}{|}_{{x}_{0}} \\\\  & =[\\begin{aligned}2 & -1 \\\\ -1 & 2\\end{aligned}]\\cdot [\\begin{aligned}1 & -1 \\\\ -1 & 2\\end{aligned}]\\cdot [\\begin{aligned}-1 & 1 \\\\ 0 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}3 & -4 \\\\ -3 & 5\\end{aligned}]\\cdot [\\begin{aligned}-1 & 1 \\\\ 0 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}-3 & 7 \\\\ 3 & -8\\end{aligned}].\\end{aligned}\n$$"] ["question-3cd8cc0b-abb0-561c-b8fb-73430e8105db" :question/id #uuid "3cd8cc0b-abb0-561c-b8fb-73430e8105db"] ["question-3cd8cc0b-abb0-561c-b8fb-73430e8105db" :question/math-academy-id "q-270266"] ["question-3cd8cc0b-abb0-561c-b8fb-73430e8105db" :question/problem "Consider the functions $y:{R}^{3}\\to {R}^{2}$ and $f:{R}^{2}\\to {R}^{2},$ defined by\n\n$$\ny(x)=[\\begin{aligned}{x}_{1}^{3}+2{x}_{2}^{2} \\\\ 4{x}_{2}^{3}-5{x}_{3}\\end{aligned}].\\,f(y)=[\\begin{aligned}{y}_{1}^{5} \\\\ 3{y}_{2}^{3}-{y}_{1}\\end{aligned}]\n$$\n\nAccording to the chain rule, the derivative \n\n$$\n\\frac{\\text{d}}{\\text{d}x}f(y(x))\n$$\n\nis the product of a$\\,\\,${{field-1}}$\\times ${{field-2}} \nmatrix with a \n{{field-3}} $\\times $ {{field-4}} \nmatrix, which results in a \n{{field-5}} $\\times $ {{field-6}} \nmatrix."] ["question-3cd8cc0b-abb0-561c-b8fb-73430e8105db" :question/worked-solution "Using the chain rule, we have\n\n$$\n\\frac{\\text{d}}{\\text{d}x}f(y(x))=\\frac{\\text{d}f}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x}.\n$$\n\nLet's consider each of the factors in turn.\n\n- The function $f$ acts on a vector $y\\in {R}^{2}$ and outputs a vector $f(y)\\in {R}^{2}.$ Thus, the total derivative of $f$ with respect to $y$ is a $2\\times 2$ matrix.\n\n- The function $y$ acts on a vector $x\\in {R}^{3}$ and outputs a vector $y(x)\\in {R}^{2}.$ Thus, the total derivative of $y$ with respect to $x$ is a $2\\times 3$ matrix.\n\nTherefore, the product\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x}\n$$\n\nof a $2\\times 2$ matrix with a $2\\times 3$ matrix is a $2\\times 3$ matrix."] ["question-3cd8cc0b-abb0-561c-b8fb-73430e8105db" :question/difficulty :question.difficulty/easy] ["answer-field-d2fdc84c-26a3-52ee-83fa-56334143f205" :answer-field/id #uuid "d2fdc84c-26a3-52ee-83fa-56334143f205"] ["answer-4cbfad5d-2e5e-5ad2-9a54-aab932b7eb19" :answer/id #uuid "4cbfad5d-2e5e-5ad2-9a54-aab932b7eb19"] ["answer-4cbfad5d-2e5e-5ad2-9a54-aab932b7eb19" :answer/type :answer.type/math] ["answer-4cbfad5d-2e5e-5ad2-9a54-aab932b7eb19" :answer