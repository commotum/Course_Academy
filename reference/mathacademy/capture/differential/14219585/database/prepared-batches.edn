text{d}y}{\\text{d}x}=A.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}f(y(x)) & =\\frac{\\text{d}f}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x} \\\\  & =BA \\\\  & =[\\begin{aligned}2 & 1 & 4 \\\\ 5 & 2 & 1\\end{aligned}][\\begin{aligned}2 & -2 \\\\ 3 & 3 \\\\ -3 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}-5 & -9 \\\\ 13 & -6\\end{aligned}].\\end{aligned}\n$$"] ["question-19d96d91-ae11-5a12-a4f6-96b41a2e839b" :question/difficulty :question.difficulty/easy] ["answer-field-0ac0a5ce-5861-5053-9728-8c4fd1cb5e8f" :answer-field/id #uuid "0ac0a5ce-5861-5053-9728-8c4fd1cb5e8f"] ["answer-3eb6efb2-996e-5718-b658-df34c48f6590" :answer/id #uuid "3eb6efb2-996e-5718-b658-df34c48f6590"] ["answer-3eb6efb2-996e-5718-b658-df34c48f6590" :answer/type :answer.type/math] ["answer-3eb6efb2-996e-5718-b658-df34c48f6590" :answer/value "-5"] ["answer-field-0ac0a5ce-5861-5053-9728-8c4fd1cb5e8f" :answer-field/key "field-1"] ["answer-field-0ac0a5ce-5861-5053-9728-8c4fd1cb5e8f" :answer-field/type :answer-field.type/blank] ["answer-field-0ac0a5ce-5861-5053-9728-8c4fd1cb5e8f" :answer-field/correct "answer-3eb6efb2-996e-5718-b658-df34c48f6590"] ["answer-field-0ac0a5ce-5861-5053-9728-8c4fd1cb5e8f" :answer-field/choices "answer-3eb6efb2-996e-5718-b658-df34c48f6590"] ["answer-field-46bae893-4ebe-51de-9570-54b7da87315d" :answer-field/id #uuid "46bae893-4ebe-51de-9570-54b7da87315d"] ["answer-ec845946-3714-52e3-84bc-89dc914bbef4" :answer/id #uuid "ec845946-3714-52e3-84bc-89dc914bbef4"] ["answer-ec845946-3714-52e3-84bc-89dc914bbef4" :answer/type :answer.type/math] ["answer-ec845946-3714-52e3-84bc-89dc914bbef4" :answer/value "-9"] ["answer-field-46bae893-4ebe-51de-9570-54b7da87315d" :answer-field/key "field-2"] ["answer-field-46bae893-4ebe-51de-9570-54b7da87315d" :answer-field/type :answer-field.type/blank] ["answer-field-46bae893-4ebe-51de-9570-54b7da87315d" :answer-field/correct "answer-ec845946-3714-52e3-84bc-89dc914bbef4"] ["answer-field-46bae893-4ebe-51de-9570-5