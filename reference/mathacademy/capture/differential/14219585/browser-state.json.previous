mjx-texclass=\"CLOSE\">]</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">[</mo><mtable columnalign=\"center\" columnspacing=\"1em\" rowspacing=\"4pt\"><mtr><mtd><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mrow data-mjx-texclass=\"ORD\"><mn>6</mn></mrow></mpadded></mstyle></mtd><mtd><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>7</mn></mrow></mpadded></mstyle></mtd><mtd><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mrow data-mjx-texclass=\"ORD\"><mn>9</mn></mrow></mpadded></mstyle></mtd></mtr><mtr><mtd><mn>6</mn></mtd><mtd><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mrow data-mjx-texclass=\"ORD\"><mn>9</mn></mrow></mpadded></mstyle></mtd><mtd><mn>3</mn></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
