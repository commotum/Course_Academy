#{[{:activity/first-step {:db/id #edb/ref 17592186193689} :activity/id #uuid "1ee2078f-2d7b-5d91-844b-dd810c5980c9" :activity/scope {:db/id #edb/ref 17592186049417 :topic/id #uuid "f3354023-39f0-527c-b9e3-f3dced711198" :topic/math-academy-id 4125} :activity/steps [{:db/id #edb/ref 17592186193507 :step/content {:db/id #edb/ref 17592186192686 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192391 :question/id #uuid "19e7744e-9d87-5ad1-9648-029e7dc8e565" :question/math-academy-id "e-10113"} :knowledge-point/id #uuid "a9d0e7a8-77d1-58d7-b7f7-a820942ece69" :knowledge-point/questions [{:db/id #edb/ref 17592186192984} {:db/id #edb/ref 17592186193198}] :knowledge-point/title "Log-Likelihood Functions for Normal Random Variables"} :step/id #uuid "5e40004b-0de5-5409-b9f6-66d7010235cf" :step/math-academy-id 38135} {:db/id #edb/ref 17592186193686 :step/content {:db/id #edb/ref 17592186192798 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192522 :question/id #uuid "f2a062b5-e42e-5c05-9bc1-cbbe7a10baac" :question/math-academy-id "e-11122"} :knowledge-point/id #uuid "7981ed99-ef47-5b86-9f92-bce4d45d9767" :knowledge-point/questions [{:db/id #edb/ref 17592186193199} {:db/id #edb/ref 17592186193200}] :knowledge-point/title "Log-Likelihood Functions for Exponential Random Variables"} :step/id #uuid "cd1280e1-8556-53f3-b24b-45e447786baf" :step/math-academy-id 42290 :step/next {:db/id #edb/ref 17592186193507}} {:db/id #edb/ref 17592186193688 :step/content {:db/id #edb/ref 17592186192800 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192524 :question/id #uuid "ac9e9734-fb34-59e4-bbe2-a2e55196f0c1" :question/math-academy-id "e-11124"} :knowledge-point/id #uuid "cce53189-83e8-5ab9-9abc-cb159f761f55" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048346} {:db/id #edb/ref 17592186049217}] :knowledge-point/questions [{:db/id #edb/ref 17592186193202} {:db/id #edb/ref 17592186193203}] :knowledge-point/title "Log-Likelihood Functions for Continuous Random Variables"} :step/id #uuid "d277bc8e-9565-50d6-8915-76af5cc26d62" :step/math-academy-id 42304 :step/next {:db/id #edb/ref 17592186193686}} {:db/id #edb/ref 17592186193689 :step/content {:db/id #edb/ref 17592186193899 :tutorial/content "Recall that if $X_1, X_2, \\ldots, X_{n}$ are independent and identically distributed *continuous* random variables with probability density function $f(x; \\theta)$, then the likelihood function $L(\\theta)$ of a random sample $x_1, x_2, \\ldots, x_n$ is given by\n\n$$\nL(\\theta) = \\displaystyle\\prod_{i=1}^n f(x_i;\\,\\theta)\n$$\n\nwhere $f(x;\\theta)$ is the probability density function of $X_i$ for\n\n$$\ni=1,2,\\ldots, n\n$$\n\nand $\\theta$ is an unknown parameter.\n\nSimilar to the case of discrete random variables, the **log-likelihood function** is given by\n\n$$\n\\begin{aligned}\nl(θ) &= \\ln (L(θ)) \\\\\n&= \\ln (∏_(i = 1)^(n)f(x_{i} \\\\\n&= θ)) \\\\\n&= \\ln (f(x_{1} \\\\\n&= θ) \\cdot f(x_{2} \\\\\n&= θ)⋯f(x_{n} \\\\\n&= θ)) \\\\\n&= \\ln (f(x_{1} \\\\\n&= θ)) + \\ln (f(x_{2} \\\\\n&= θ)) + ⋯ + \\ln (f(x_{n} \\\\\n&= θ)) \\\\\n&= ∑_(i = 1)^(n)\\ln (f(x_{i} \\\\\n&= θ))\n\\end{aligned}\n$$\n\nLet's get some practice at calculating log-likelihood functions for some continuous random variables." :tutorial/id #uuid "c0170775-4a1b-50a6-8f90-446fcc21a159" :tutorial/math-academy-id 7005 :tutorial/title "Introduction"} :step/id #uuid "4f38c06c-0588-54af-b61c-d056d9ae479e" :step/math-academy-id 42305 :step/next {:db/id #edb/ref 17592186193688}}] :activity/title "Log-Likelihood Functions for Continuous Probability Distributions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186192934}]}
