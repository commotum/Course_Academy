#{[{:db/id #edb/ref 17592186351219 :knowledge-point/_questions [{:db/id #edb/ref 17592186157276 :knowledge-point/id #uuid "15b92bed-c97f-5b87-9811-fbfc5c03314d" :knowledge-point/title "Finding a Component of a Vector With Respect to a Given Orthogonal Basis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ecf8788-69f4-5834-812b-5702d49e4f4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186348862} {:answer/id #uuid "7038e2ce-8c22-56c7-bce9-4531c5d29eef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186349480} {:answer/id #uuid "741b3734-968c-5909-903f-3a1aadd10955" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186349513} {:answer/id #uuid "ad057dc2-b49e-5c5b-8cd2-a865922a7c52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186349981} {:answer/id #uuid "df7ddcb6-3b2b-5373-bd11-799c6429dd8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186350405}] :answer-field/correct {:answer/id #uuid "ad057dc2-b49e-5c5b-8cd2-a865922a7c52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186349981} :answer-field/id #uuid "d2b38458-09c8-5aec-b568-d48ebb9481a8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186351072}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a0ea9087-dcb2-563d-a61a-22e857198678" :question/math-academy-id "q-81103" :question/problem "Given the orthogonal basis $B$ of ${R}^{2}$ and the vector $x$ below, find the value of $15{x}_{1},$ where ${x}_{1}$ is the first component of $[x]_{B}.$\n\n$$\nB={[\\begin{aligned}1 \\\\ -3\\end{aligned}],[\\begin{aligned}-6 \\\\ -2\\end{aligned}]},\\,x=[\\begin{aligned}2 \\\\ -4\\end{aligned}]\n$$" :question/worked-solution "Let's denote the vectors of $B$ as ${q}_{1},\\,{q}_{2}.$ \n\nSince $B$ is an orthogonal basis, we have that $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$, where ${x}_{i}=\\frac{x\\cdot {q}_{i}}{{q}_{i}\\cdot {q}_{i}}.$ Computing ${x}_{1},$ we obtain \n\n$$\n\\begin{aligned}{x}_{1} & =\\frac{x\\cdot {q}_{1}}{{q}_{1}\\cdot {q}_{1}} \\\\  & =\\frac{2\\cdot 1+(-4)\\cdot (-3)}{{1}^{2}+(-3)^{2}} \\\\  & =\\frac{2+12}{1+9} \\\\  & =\\frac{7}{5}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n15{x}_{1}=15\\cdot \\frac{7}{5}=21.\n$$"}]}
