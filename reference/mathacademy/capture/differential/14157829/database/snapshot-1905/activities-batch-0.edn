#{[{:activity/first-step {:db/id #edb/ref 17592186158103} :activity/id #uuid "3237638b-b8fc-5ada-8f93-3509e05153ed" :activity/scope {:db/id #edb/ref 17592186050366 :topic/id #uuid "4395903b-598c-5c34-b488-0d6a79550dd7" :topic/math-academy-id 2825} :activity/steps [{:db/id #edb/ref 17592186158103 :step/content {:db/id #edb/ref 17592186158470 :tutorial/content "Given an orthogonal basis $\\mathcal{B}=\\{\\mathbf{q}_1, \\mathbf{q}_2, \\ldots, \\mathbf{q}_n\\}$ of $S=\\textrm{Span}\\{\\mathcal{B}\\},$ there is an easy way to find the components of a vector $\\mathbf{x}\\in S$ with respect to this basis. The vector $\\mathbf{x}$ with respect to the basis $\\mathcal{B}$ is\n\n$$\n[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]\n$$\n\nFurthermore, if the basis is *orthonormal*, then we know that $\\mathbf{q}_i\\cdot\\mathbf{q}_i=1$. So, the formula for each component is\n\n$$\n[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]\n$$" :tutorial/id #uuid "67f07988-4aba-56fb-b9e7-aef39a3de89b" :tutorial/math-academy-id 4302 :tutorial/title "Introduction"} :step/id #uuid "4accdfe0-74c3-5830-95d3-ff10c16738c1" :step/math-academy-id 26151 :step/next {:db/id #edb/ref 17592186158104}} {:db/id #edb/ref 17592186158104 :step/content {:db/id #edb/ref 17592186157276 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157080 :question/id #uuid "5f10a215-83bb-545a-a0e1-ce702f773e6d" :question/math-academy-id "e-7112"} :knowledge-point/id #uuid "15b92bed-c97f-5b87-9811-fbfc5c03314d" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048762} {:db/id #edb/ref 17592186049811} {:db/id #edb/ref 17592186050394}] :knowledge-point/questions [{:db/id #edb/ref 17592186157768} {:db/id #edb/ref 17592186157771} {:db/id #edb/ref 17592186237889} {:db/id #edb/ref 17592186237890} {:db/id #edb/ref 17592186237891} {:db/id #edb/ref 17592186237893} {:db/id #edb/ref 17592186326837} {:db/id #edb/ref 17592186351219} {:db/id #edb/ref 17592186351220} {:db/id #edb/ref 17592186351221} {:db/id #edb/ref 17592186351233} {:db/id #edb/ref 17592186373463} {:db/id #edb/ref 17592186375425}] :knowledge-point/title "Finding a Component of a Vector With Respect to a Given Orthogonal Basis"} :step/id #uuid "de4c2603-0fe6-5fca-ad09-e02417514da9" :step/math-academy-id 26152 :step/next {:db/id #edb/ref 17592186158105}} {:db/id #edb/ref 17592186158105 :step/content {:db/id #edb/ref 17592186157277 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157081 :question/id #uuid "d7df79a9-2489-5fed-9e00-29890bd01f82" :question/math-academy-id "e-7113"} :knowledge-point/id #uuid "39b12711-22c8-5cb7-bd61-e128734e7e6f" :knowledge-point/questions [{:db/id #edb/ref 17592186157769} {:db/id #edb/ref 17592186157770} {:db/id #edb/ref 17592186237886} {:db/id #edb/ref 17592186237888} {:db/id #edb/ref 17592186326838} {:db/id #edb/ref 17592186351222} {:db/id #edb/ref 17592186351234} {:db/id #edb/ref 17592186351235} {:db/id #edb/ref 17592186373449} {:db/id #edb/ref 17592186373456} {:db/id #edb/ref 17592186375418} {:db/id #edb/ref 17592186386000} {:db/id #edb/ref 17592186392347}] :knowledge-point/title "Calculating the Components of a Vector With Respect to a Given Orthonormal Basis"} :step/id #uuid "f247c384-fdd7-5b12-a6d5-f04393f4df78" :step/math-academy-id 26153 :step/next {:db/id #edb/ref 17592186158106}} {:db/id #edb/ref 17592186158106 :step/content {:db/id #edb/ref 17592186158471 :tutorial/content "Given any vector $\\mathbf{x}$ and any subspace $W$ in $\\mathbb{R}^n,$ we can always write $\\mathbf{x}$ as a sum of a vector from $W$ and a vector from $W^{\\perp}.$ This fact is known as the **orthogonal decomposition theorem.** We can state it formally as follows:\n\n> *Let $W$ be a subspace of $\\mathbb{R}^n.$ Then each $\\mathbf{x}\\in\\mathbb{R}^n$ can be written uniquely in the form\n> \n> \n> $$\n> \\mathbf{x}= \\mathbf{y}+\\mathbf{z}\n> $$\n> \n> \n> where $\\mathbf{y} \\in W$ and $\\mathbf{z} \\in W^{\\perp}.$*\n\n> *Moreover, since $\\mathbf y$ is the orthogonal projection of $\\mathbf x$ onto the subspace $W,$ if $\\{\\mathbf{u}_1\\,\\dots,\\mathbf{u}_p\\}$ is any orthogonal basis of $W,$ then*\n> \n> \n> $$\n> \\begin{aligned}y & ={\\text{proj}}_{W}\\,x \\\\  & ={\\text{proj}}_{{u}_{1}}\\,x+{\\text{proj}}_{{u}_{2}}\\,x+⋯+{\\text{proj}}_{{u}_{p}}\\,x \\\\  & =\\frac{x\\cdot {u}_{1}}{{u}_{1}\\cdot {u}_{1}}{u}_{1}+\\frac{x\\cdot {u}_{2}}{{u}_{2}\\cdot {u}_{2}}{u}_{2}+⋯+\\frac{x\\cdot {u}_{p}}{{u}_{p}\\cdot {u}_{p}}{u}_{p}.\\end{aligned}\n> $$" :tutorial/id #uuid "789dc38d-c1e0-5bdc-9f01-5940371a326b" :tutorial/math-academy-id 4304 :tutorial/title "The Orthogonal Decomposition Theorem"} :step/id #uuid "450eea64-01cc-591d-9042-fba21e4feb99" :step/math-academy-id 26173}] :activity/title "The Components of a Vector with Respect to an Orthogonal or Orthonormal Basis" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186157482}]}
