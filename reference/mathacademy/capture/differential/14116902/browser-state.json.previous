              "value": "II only",
              "html": "II only"
            },
            {
              "option": "d",
              "dom_id": "questionWidget-choiceLetterCircle-47657-d",
              "type": "text",
              "value": "III only",
              "html": "III only"
            },
            {
              "option": "e",
