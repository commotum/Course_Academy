c><mn>5</mn><mn>2</mn></mfrac></mstyle><mo>,</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mn>10</mn><mo>⋅</mo><mn>1</mn><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mi>N</mi><mo stretchy=\"false\">(</mo><mn>25</mn><mo>,</mo><mn>10</mn><mo stretchy=\"false\">)</mo><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
