#{[{:db/id #edb/ref 17592186120225 :knowledge-point/_questions [{:db/id #edb/ref 17592186119935 :knowledge-point/id #uuid "3061cb06-f57f-57c8-8821-dbd962b1e78e" :knowledge-point/title "Finding the Parametric Equation of the Plane Parallel To Two Lines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bd010f61-f497-566f-ac0f-c50c695f2870" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The plane is undefined" :db/id #edb/ref 17592186390876} {:answer/id #uuid "e4fe09e5-ac83-5e62-97ff-7cc91f6b67c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨0,6,2⟩+s⟨3,2,5⟩+t⟨6,-5,10⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186390877} {:answer/id #uuid "5b991d71-53b1-55cf-8e90-ebe111f71f38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨5,-3,1⟩+s⟨8,1,0⟩+t⟨0,6,2⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186390878} {:answer/id #uuid "c86fee90-6ade-5c0b-9714-4278894c742b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨5,-3,1⟩+s⟨8,1,0⟩+t⟨6,-5,10⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186390879} {:answer/id #uuid "db01346f-8d56-5827-aa82-3725170f51a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨5,-3,1⟩+s⟨3,2,5⟩+t⟨0,6,2⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186390880}] :answer-field/correct {:answer/id #uuid "db01346f-8d56-5827-aa82-3725170f51a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨5,-3,1⟩+s⟨3,2,5⟩+t⟨0,6,2⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186390880} :answer-field/id #uuid "cf886e4d-3534-5b42-92f4-88d2e9d1dbe7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390875}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0602f3f6-acc2-53ef-a72e-b71caa5d5289" :question/math-academy-id "q-33066" :question/problem "Find a parametric equation of the plane that passes through the point $A(5,-3,1)$ and is parallel to the lines $r=⟨8,1,0⟩+s⟨3,2,5⟩$ and $r=⟨6,-5,10⟩+t⟨0,6,2⟩.$" :question/worked-solution "The direction vectors of the lines are ${v}_{1}=⟨3,2,5⟩$ and ${v}_{2}=⟨0,6,2⟩$, respectively. These vectors are parallel to the plane but not to each other.\n\nWe also know that the point $A(5,-3,1)$ lies on the plane and its position vector is $a=⟨5,-3,1⟩.$  \n\nSo, the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =a+s{v}_{1}+t{v}_{2} \\\\ r & =⟨5,-3,1⟩+s⟨3,2,5⟩+t⟨0,6,2⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338862 :knowledge-point/_questions [{:db/id #edb/ref 17592186119934 :knowledge-point/id #uuid "62196ae9-df2e-5a3a-bc0a-1c0f4c40af3e" :knowledge-point/title "Finding a Normal Vector To a Plane Given by Parametric Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "027279ba-c86b-5b53-9b4f-d91a6c95b4d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨1,2,-1⟩" :db/id #edb/ref 17592186336052} {:answer/id #uuid "2b335037-3eda-5eb1-a665-40e27aacca2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-5,3,1⟩" :db/id #edb/ref 17592186336439} {:answer/id #uuid "3cc9ad4f-0956-53af-9375-a4dc1247e499" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-5,3,0⟩" :db/id #edb/ref 17592186336605} {:answer/id #uuid "924674c9-4ac4-5fac-bce9-febfcdbeeeee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨7,-3,1⟩" :db/id #edb/ref 17592186337359} {:answer/id #uuid "faf5ff12-8cff-5606-9806-8c51dfe352b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,-1,3⟩" :db/id #edb/ref 17592186338232}] :answer-field/correct {:answer/id #uuid "2b335037-3eda-5eb1-a665-40e27aacca2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-5,3,1⟩" :db/id #edb/ref 17592186336439} :answer-field/id #uuid "0006422d-58d9-51c7-8d8f-f4fd7450f036" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338278}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b2e1c378-a183-516b-92fd-1753dcbc375f" :question/math-academy-id "q-70972" :question/problem "Find a normal vector to the plane\n\n$$\nr=[\\begin{aligned}\\frac{1}{2} \\\\ -1 \\\\ 13\\end{aligned}]+t[\\begin{aligned}0 \\\\ -1 \\\\ 3\\end{aligned}]+s[\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}],\\,t,\\,s\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "From the parametric equation, we have that $v=⟨0,-1,3⟩$ and $w=⟨1,2,-1⟩$ are parallel to the plane.\n\nNow, we need to find a normal vector of the plane. To do that, we use the cross product of $v$ and $w$ as follows:\n\n$$\n\\begin{aligned}n & =v\\times w \\\\  & =[\\begin{aligned}0 \\\\ -1 \\\\ 3\\end{aligned}]\\times [\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}] \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 0 & -1 & 3 \\\\ 1 & 2 & -1\\end{aligned}\\right| \\\\  & =-5i+3j+k \\\\  & =⟨-5,3,1⟩.\\end{aligned}\n$$\n\nTherefore, a normal vector to the plane is $n=⟨-5,3,1⟩.$"}] [{:db/id #edb/ref 17592186338865 :knowledge-point/_questions [{:db/id #edb/ref 17592186119935 :knowledge-point/id #uuid "3061cb06-f57f-57c8-8821-dbd962b1e78e" :knowledge-point/title "Finding the Parametric Equation of the Plane Parallel To Two Lines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7586c1e4-84f3-5128-898b-c5e464276c0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨6,2,1⟩+s⟨4,-1,5⟩+t⟨0,2,3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186337090} {:answer/id #uuid "82d1d2de-9e64-5f24-9d44-872a4f4b17ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨4,-1,5⟩+s⟨6,2,1⟩+t⟨0,2,3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186337221} {:answer/id #uuid "85ed694c-09f9-5528-8f94-aa3dcea698e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨0,2,3⟩+s⟨4,-1,5⟩+t⟨6,2,1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186337243} {:answer/id #uuid "9294f976-ff7c-58c2-93a2-681c99675cba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The plane is undefined" :db/id #edb/ref 17592186337366} {:answer/id #uuid "d0355145-d653-5b7e-b879-a79de4840c7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨6,2,1⟩+s⟨\\frac{1}{2},1,9⟩+t⟨3,10,-1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186337854}] :answer-field/correct {:answer/id #uuid "7586c1e4-84f3-5128-898b-c5e464276c0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨6,2,1⟩+s⟨4,-1,5⟩+t⟨0,2,3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186337090} :answer-field/id #uuid "cb6f8717-8af1-5d47-bcaf-6f6357145f42" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338642}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "63af645f-746e-5e92-b7a0-0217edd376c0" :question/math-academy-id "q-70977" :question/problem "Find a parametric equation of the plane that passes through the point $D(6,2,1)$ and is parallel to the lines $r=⟨\\frac{1}{2},1,9⟩+s⟨4,-1,5⟩$ and $r=⟨\\sqrt{3},10,-1⟩+t⟨0,2,3⟩.$" :question/worked-solution "The direction vectors of the lines are ${v}_{1}=⟨4,-1,5⟩$ and ${v}_{2}=⟨0,2,3⟩$, respectively. These vectors are parallel to the plane but not to each other.\n\nWe also know that the point $D(6,2,1)$ lies on the plane and its position vector is $d=⟨6,2,1⟩.$  \n\nSo, the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =d+s{v}_{1}+t{v}_{2} \\\\ r & =⟨6,2,1⟩+s⟨4,-1,5⟩+t⟨0,2,3⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}]}
