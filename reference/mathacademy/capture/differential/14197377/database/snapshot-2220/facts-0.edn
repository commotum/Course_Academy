b/ref 17592186045417] [17592186512865 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186512865 #edb/ref 1071 "Let $V=C[0,2\\pi ],$ the vector space of all functions that are continuous on $[0,2\\pi ].$ Find $⟨\\operatorname{cos}⁡(2t),\\operatorname{cos}⁡(4t)⟩$ if the inner product on $V$ is defined as\n\n$$\n⟨x(t),y(t)⟩={\\int }_{0}^{2\\pi }x(t)y(t)\\,\\text{d}t.\n$$\n\n*Hint: You may wish to make use of the identity $\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta =\\frac{1}{2}(\\operatorname{cos}⁡(\\alpha -\\beta )+\\operatorname{cos}⁡(\\alpha +\\beta )).$*" #edb/ref 17592186045417] [17592186512865 #edb/ref 1072 #uuid "04de5946-03c2-52be-a91c-cc43fa9abf34" #edb/ref 17592186045417] [17592186512865 #edb/ref 1074 "We need to evaluate\n\n$$\n⟨\\operatorname{cos}⁡(2t),\\operatorname{cos}⁡(4t)⟩={\\int }_{0}^{2\\pi }\\operatorname{cos}⁡(2t)\\,\\operatorname{cos}⁡(4t)\\,\\text{d}t.\n$$\n\nWe can evaluate this integral using the identity $\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta =\\frac{1}{2}(\\operatorname{cos}⁡(\\alpha -\\beta )+\\operatorname{cos}⁡(\\alpha +\\beta ))$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2\\pi }\\operatorname{cos}⁡(2t)\\,\\operatorname{cos}⁡(4t)\\,\\text{d}t & =\\frac{1}{2}{\\int }_{0}^{2\\pi }\\operatorname{cos}⁡(2t-4t)+\\operatorname{cos}⁡(2t+4t)\\,\\text{d}t \\\\  & =\\frac{1}{2}{\\int }_{0}^{2\\pi }\\operatorname{cos}⁡(-2t)+\\operatorname{cos}⁡(6t)\\,\\text{d}t \\\\  & =\\frac{1}{2}{\\int }_{0}^{2\\pi }\\operatorname{cos}⁡(2t)+\\operatorname{cos}⁡(6t)\\,\\text{d}t \\\\  & =\\frac{1}{2}(\\frac{\\operatorname{sin}⁡(2t)}{2}+\\frac{\\operatorname{sin}⁡(6t)}{6}){|}_{0}^{2\\pi } \\\\  & =\\frac{1}{2}[\\frac{\\operatorname{sin}⁡(4\\pi )}{2}+\\frac{\\operatorname{sin}⁡(12\\pi )}{6}]-\\frac{1}{2}[-\\frac{\\operatorname{sin}⁡0}{2}+\\frac{\\operatorname{sin}⁡0}{6}] \\\\  & =\\frac{1}{2}\\cdot 0-\\frac{1}{2}\\cdot 0 \\\\  & =0\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186512895 #edb/ref 1068 #edb/ref 17592186512778 #edb/ref 17592186045417] [17592186512895 #edb/ref 1069 "q-76442" #edb/ref 17592186045417] [17592186512895 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186512895 #edb/ref 1071 "Let $V={R}_{2}[t]$ be the vector space of all polynomials of degree at most $2$, equipped with the inner product \n\n$$\n⟨x(t),y(t)⟩=x(0)y(0)+x(1)y(1)+x(2)y(2).\n$$\n\n Find $⟨x(t),y(t)⟩$, if\n\n$$\nx(t)=t-1,\\,y(t)=t+2.\n$$" #edb/ref 17592186045417] [17592186512895 #edb/ref 1072 #uuid "6a15f1db-7af4-5426-9f16-816905676768" #edb/ref 17592186045417] [17592186512895 #edb/ref 1074 "Computing the inner product according to the definition, we get\n\n$$\n\\begin{aligned}⟨x(t),y(t)⟩ & =x(0)y(0)+x(1)y(1)+x(2)y(2) \\\\  & =(-1)\\cdot 2+0\\cdot 3+1\\cdot 4 \\\\  & =-2+0+4 \\\\  & =2.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186512906 #edb/ref 1068 #edb/ref 17592186512776 #edb/ref 17592186045417] [17592186512906 #edb/ref 1069 "q-43813" #edb/ref 17592186045417] [17592186512906 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186512906 #edb/ref 1071 "Let $V={R}_{2}[t]$ be the vector space of all polynomials of degree at most $2$, equipped with the inner product\n\n$$\n⟨x(t),y(t)⟩=x(0)y(0)+x(-1)y(-1)+x(2)y(2).\n$$\n\nFind $⟨x(t),y(t)⟩$, if\n\n$$\nx(t)=3+t-2{t}^{2},\\,y(t)=t-3.\n$$" #edb/ref 17592186045417] [17592186512906 #edb/ref 1072 #uuid "890c5dfd-af10-56f3-b11c-f667a9950308" #edb/ref 17592186045417] [17592186512906 #edb/ref 1074 "Computing the inner product according to the definition, we get\n\n$$\n\\begin{aligned}⟨x(t),y(t)⟩ & =x(0)y(0)+x(-1)y(-1)+x(2)y(2) \\\\  & =3\\cdot (-3)+0\\cdot (-4)+(-3)\\cdot (-1) \\\\  & =-9+0+3 \\\\  & =-6.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186512979 #edb/ref 1062 #uuid "3dbec995-d7b1-5d9d-9fb5-ba6abfa94b3e" #edb/ref 17592186045417] [17592186512979 #edb/ref 1063 #edb/ref 17592186512865 #edb/ref 17592186045417] [17592186512984 #edb/ref 1058 #edb/ref 17592186513004 #edb/ref 17592186045417] 