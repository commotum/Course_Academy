#{[{:db/id #edb/ref 17592186329639 :knowledge-point/_questions [{:db/id #edb/ref 17592186133764 :knowledge-point/id #uuid "4c553cb8-9f5c-5fa5-bc43-db7d7b64755f" :knowledge-point/title "Calculating the Inner Product of Two Vectors in a Vector Space of Continuous Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20ba600e-0358-513c-9008-d4164bd322af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186327215} {:answer/id #uuid "7d5d4c0c-e9e9-5fde-8a0d-8854cd85cbf4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{2}" :db/id #edb/ref 17592186328015} {:answer/id #uuid "8e92535a-d563-54ca-91ef-e0c126aef3fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186328174} {:answer/id #uuid "ac342d67-73ca-57ea-b00b-d2af7ff07ba2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186328429} {:answer/id #uuid "f88f22bf-caeb-53aa-96f2-904a0b368b2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186329113}] :answer-field/correct {:answer/id #uuid "ac342d67-73ca-57ea-b00b-d2af7ff07ba2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186328429} :answer-field/id #uuid "76480884-9973-5d4d-b09e-9119b17f3377" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329381}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "75517719-307f-569b-90da-09de54805f02" :question/math-academy-id "q-42255" :question/problem "Let $V=C[-\\frac{\\pi }{2},0],$ the vector space of all functions that are continuous on $[-\\frac{\\pi }{2},0].$ Find $⟨\\operatorname{sin}⁡t,{cos}^{2}⁡t⟩$ if the inner product on $V$ is defined as\n\n$$\n⟨x(t),y(t)⟩={\\int }_{-\\pi /2}^{0}x(t)y(t)\\,\\text{d}t.\n$$" :question/worked-solution "We need to evaluate\n\n$$\n⟨\\operatorname{sin}⁡t,{cos}^{2}⁡t⟩={\\int }_{-\\pi /2}^{0}\\operatorname{sin}⁡t{cos}^{2}⁡t\\,\\text{d}t.\n$$\n\nWe can evaluate this integral using the substitution $u=\\operatorname{cos}⁡t,$ $\\text{d}u=-\\operatorname{sin}⁡t\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{-\\pi /2}^{0}\\operatorname{sin}⁡t{cos}^{2}⁡t\\,\\text{d}t & =-{\\int }_{0}^{1}{u}^{2}\\,\\text{d}u \\\\  & =-\\frac{{u}^{3}}{3}{|}_{0}^{1} \\\\  & =[-\\frac{(1)^{3}}{3}]-[-\\frac{(0)^{3}}{3}] \\\\  & =-\\frac{1}{3}+0 \\\\  & =-\\frac{1}{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186134385 :knowledge-point/_questions [{:db/id #edb/ref 17592186133764 :knowledge-point/id #uuid "4c553cb8-9f5c-5fa5-bc43-db7d7b64755f" :knowledge-point/title "Calculating the Inner Product of Two Vectors in a Vector Space of Continuous Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44900815-93d0-5419-bda4-15f71f1c2ebc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2}-2" :db/id #edb/ref 17592186327533} {:answer/id #uuid "8e2a67c3-6516-5ef0-8910-205fb5e42518" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{t}+1" :db/id #edb/ref 17592186328165} {:answer/id #uuid "919c9679-b1d6-53d8-ba04-8bb16361e1db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{t}-t+1" :db/id #edb/ref 17592186328202} {:answer/id #uuid "b8bf4da2-ee9f-5281-99ba-7b938e201031" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2}" :db/id #edb/ref 17592186328542} {:answer/id #uuid "d0bd2329-945b-550c-9f1d-b21cc4aa33ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2}+1" :db/id #edb/ref 17592186328767}] :answer-field/correct {:answer/id #uuid "d0bd2329-945b-550c-9f1d-b21cc4aa33ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2}+1" :db/id #edb/ref 17592186328767} :answer-field/id #uuid "914fc28e-fc9f-53b3-abf8-9222f8795d35" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329426}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "71904bfc-c560-50f5-ac2b-41eb0a528292" :question/math-academy-id "q-42256" :question/problem "Let $V=C[0,2],$ the vector space of all functions that are continuous on $[0,2].$ Find $⟨t,{e}^{t}⟩$ if the inner product on $V$ is defined as\n\n$$\n⟨x(t),y(t)⟩={\\int }_{0}^{2}x(t)y(t)\\,\\text{d}t.\n$$" :question/worked-solution "We need to evaluate\n\n$$\n⟨t,{e}^{t}⟩={\\int }_{0}^{2}t{e}^{t}\\,\\text{d}t.\n$$\n\nLet's use integration by parts. We denote\n\n$$\n\\begin{aligned}u=t & ⟹ & {u}^{′}=1, \\\\ {v}^{′}={e}^{t} & ⟹ & v=\\int {v}^{′}\\,\\text{d}t=\\int {e}^{t}\\,\\text{d}t={e}^{t}.\\end{aligned}\n$$\n\nNow, substituting into the formula for the integration by parts, we obtain \n\n$$\n\\begin{aligned}{\\int }_{0}^{2}t{e}^{t}\\,\\text{d}t & =uv{|}_{0}^{2}-{\\int }_{0}^{2}v{u}^{′}\\,\\text{d}t \\\\  & =(t{e}^{t}){|}_{0}^{2}-{\\int }_{0}^{2}{e}^{t}\\,\\text{d}t \\\\  & =(2{e}^{2}-0{e}^{0})-{e}^{t}{|}_{0}^{2} \\\\  & =2{e}^{2}-({e}^{2}-1) \\\\  & ={e}^{2}+1.\\end{aligned}\n$$"}]}
