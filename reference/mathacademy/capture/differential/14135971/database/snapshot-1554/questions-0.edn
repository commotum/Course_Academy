igned}S & ={\\sum }_{i=1}^{n}{x}_{i} \\\\  & =2.3+4.3+5.6+1.2+2.4 \\\\  & =15.8\\end{aligned}\n$$\n\nand $n=5.$ Therefore, \n\n$$\n\\begin{aligned}L(\\theta ) & ={\\theta }^{5}\\,{e}^{-15.8\\theta }.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186441785 :knowledge-point/_questions [{:db/id #edb/ref 17592186192797 :knowledge-point/id #uuid "6068f85b-0ea6-5161-a8d1-d4eb2504852b" :knowledge-point/title "Likelihood Functions for Exponential Random Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e735132-ec76-5ebf-9166-5f920cfcbc62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\theta }^{-8}\\,{e}^{3\\theta }" :db/id #edb/ref 17592186441696} {:answer/id #uuid "5f67f625-631a-5c31-9b60-cad24a6f0f98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta \\,{e}^{-3\\theta }" :db/id #edb/ref 17592186441702} {:answer/id #uuid "632257d9-5cc1-53a1-9dc8-ceee85e61198" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\theta }^{8}\\,{e}^{-3\\theta }" :db/id #edb/ref 17592186441703} {:answer/id #uuid "bedd018d-8650-53e3-9c59-beed8134ed2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\theta }^{3}\\,{e}^{-8\\theta }" :db/id #edb/ref 17592186441740} {:answer/id #uuid "f7567dde-66a3-5e2a-add8-45f5e13e4a89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\theta }^{-3}\\,{e}^{8\\theta }" :db/id #edb/ref 17592186441758}] :answer-field/correct {:answer/id #uuid "bedd018d-8650-53e3-9c59-beed8134ed2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\theta }^{3}\\,{e}^{-8\\theta }" :db/id #edb/ref 17592186441740} :answer-field/id #uuid "3a602c36-55a2-5253-a9ad-88a05a90b82f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 