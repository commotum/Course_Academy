a +5{\\theta }^{2})/2} \\\\  & =\\frac{1}{(2\\pi )^{5/2}}\\,{e}^{\\,-4.105\\,+\\,3.9\\theta \\,-\\,2.5{\\theta }^{2}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\ng(\\theta )=-4.105+3.9\\theta -2.5{\\theta }^{2}.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-49fac689-4301-5155-9be8-96fed20b8ce2"] :db/ensure [:question/validate]} {:db/id "answer-field-49fac689-4301-5155-9be8-96fed20b8ce2" :answer-field/id #uuid "49fac689-4301-5155-9be8-96fed20b8ce2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a2d5f930-5de7-504a-bfcf-3a923de2aa5e" :answer-field/choices ["answer-e90e3529-22dd-5488-a4ce-851007409b8d" "answer-02dfe485-a3ef-5ca5-9606-172c70f16f48" "answer-a2d5f930-5de7-504a-bfcf-3a923de2aa5e" "answer-c8204f0e-e592-502d-9b91-227ddf053f1e" "answer-d2c2b2c6-6249-52fc-a148-e813f1621718"] :db/ensure [:answer-field/validate]} {:db/id "answer-e90e3529-22dd-5488-a4ce-851007409b8d" :answer/id #uuid "e90e3529-22dd-5488-a4ce-851007409b8d" :answer/type :answer.type/math :answer/value "-2.45+3.9\\theta -2.5{\\theta }^{2}" :db/ensure [:answer/validate]} {:db/id "answer-02dfe485-a3ef-5ca5-9606-172c70f16f48" :answer/id #uuid "02dfe485-a3ef-5ca5-9606-172c70f16f48" :answer/type :answer.type/math :answer/value "-3.78+3.9\\theta -2.5{\\theta }^{2}" :db/ensure [:answer/validate]} {:db/id "answer-a2d5f930-5de7-504a-bfcf-3a923de2aa5e" :answer/id #uuid "a2d5f930-5de7-504a-bfcf-3a923de2aa5e" :answer/type :answer.type/math :answer/value "-4.105+3.9\\theta -2.5{\\theta }^{2}" :db/ensure [:answer/validate]} {:db/id "answer-c8204f0e-e592-502d-9b91-227ddf053f1e" :answer/id #uuid "c8204f0e-e592-502d-9b91-227ddf053f1e" :answer/type :answer.type/math :answer/value "-7.57+3.9\\theta -2.5{\\theta }^{2}" :db/ensure [:answer/validate]} {:db/id "answer-d2c2b2c6-6249-52fc-a148-e813f1621718" :answer/id #uuid "d2c2b2c6-6249-52fc-a148-e813f1621718" :answer/type :answer.type/math :answer/value "-7.57+3.9\\theta -5{\\theta }^{2}" :db/ensure [:answer/validate]} {:db/id "question-2f4678d5-a087-5e11-90cc-f482d76b03ff" :question/id #uuid "2f4678d5-a087-5e11-90cc-f482d76b03ff" :question/math-academy-id "q-159955" :question/problem "Suppose ${X}_{1},{X}_{2},{X}_{3},{X}_{4},{X}_{5}$ is an I.I.D random sample with ${X}_{i}∼N(\\theta ,1),$  where $\\theta $ is an unknown mean.  Given that the likelihood function of the sample $1.3,\\,0.2,\\,2.3,\\,-0.7,\\,0.9$ is\n\n$$\nL(\\theta )=\\frac{1}{(2\\pi )^{5/2}}\\,{e}^{\\,g(\\theta )},\n$$\n\nwhat is the expression for $g(\\theta )?$" :question/worked-solution "Recall that if ${X}_{1},{X}_{2},…,{X}_{n}$ are independent and identically distributed continuous random variables with probability density function $f(x;\\theta ),$ where $\\theta $ is an unknown parameter, then the likelihood function of a random sample ${x}_{1},{x}_{2},…,{x}_{n}$ is\n\n$$\nL(\\theta )=P({X}_{1}={x}_{1},{X}_{2}={x}_{2},…,{X}_{n}={x}_{n})={\\prod }_{i=1}^{n}f({x}_{i};\\,\\theta ).\n$$\n\nIn our case, we are given a sample of $n=5$ independent normal random variables with unknown mean $\\theta $ and variance ${\\sigma }^{2}=1,$ for which the probability density function is\n\n$$\nf(x;\\theta )=\\frac{1}{\\sigma \\sqrt{2\\pi }}{e}^{-\\frac{1}{2}{(\\frac{x-\\theta }{\\sigma })}^{2}}=\\frac{1}{\\sqrt{2\\pi }}{e}^{-(x-\\theta )^{2}/2},\\,x\\in (-\\infty ,\\infty ).\n$$\n\nWe can calculate the likelihood function as follows:\n\n$$\n\\begin{aligned}L(\\theta ) & ={\\prod }_{i=1}^{n}(\\frac{1}{\\sqrt{2\\pi }}{e}^{-({x}_{i}-\\theta )^{2}/2}) \\\\  & =(2\\pi )^{-n/2}\\,{e}^{-\\sum ({x}_{i}-\\theta )^{2}/2} \\\\  & =(2\\pi )^{-n/2}\\,{e}^{-(\\sum {x}_{i}^{2}-2\\theta \\sum {x}_{i}+n{\\theta }^{2})/2} \\\\  & =(2\\pi )^{-n/2}\\,{e}^{-(C-2S\\theta +n{\\theta }^{2})/2}\\end{aligned}\n$$\n\nwhere $S={\\sum }_{i=1}^{n}{x}_{i}$ and $C={\\sum }_{i=1}^{n}{x}_{i}^{2}.$\n\nFor our sample, we have that\n\n$$\n\\begin{aligned}S & ={\\sum }_{i=1}^{n}{x}_{i} \\\\  & =1.3+0.2+2.7+(-0.7)+0.9 \\\\  & =4 \\\\ C & ={\\sum }_{i=1}^{n}{x}_{i}^{2} \\\\  & =(1.3)^{2}+(0.2)^{2}+(2.3)^{2}+(-0.7)^{2}+(0.9)^{2} \\\\  & =8.32\\end{aligned}\n$$\n\nand $n=5.$ Therefore, \n\n$$\n\\begin{aligned}L(\\theta ) & =(2\\pi )^{-5/2}\\,{e}^{-(8.32-2(4)\\theta +5{\\theta }^{2})/2} \\\\  & =\\frac{1}{(2\\pi )^{5/2}}\\,{e}^{\\,-4.16\\,+\\,4\\theta \\,-\\,2.5{\\theta }^{2}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\ng(\\theta )=-4.16+4\\theta -2.5{\\theta }^{2}.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-f3360e07-7504-5830-8a53-b33be132c97b"] :db/ensure [:question/validate]} {:db/id "answer-field-f3360e07-7504-5830-8a53-b33be132c97b" :answer-field/id #uuid "f3360e07-7504-5830-8a53-b33be132c97b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-946fb421-d9f8-515c-ac0d-2febe8130990" :answer-field/choices ["answer-d02565f7-fd05-587b-984b-2ec02701ae9c" "answer-ac7b1eee-2e2d-566b-b6cb-2cd855b3f405" "answer-c57acc65-7f21-5f64-86dc-1d888225d7cf" "answer-946fb421-d9f8-515c-ac0d-2febe8130990" "answer-ee68ad46-6e17-52dc-b4f9-939c7a0635ea"] :db/ensure [:answer-field/validate]} {:db/id "answer-d02565f7-fd05-587b-984b-2ec02701ae9c" :answer/id #uuid "d02565f7-fd05-587b-984b-2ec02701ae9c" :answer/type :answer.type/math :answer/value "-1+4\\theta -2.5{\\theta }^{2}" :db/ensure [:answer/validate]} {:db/id "answer-ac7b1eee-2e2d-566b-b6cb-2cd855b3f405" :answer/id #uuid "ac7b1eee-2e2d-566b-b6cb-2cd855b3f405" :answer/type :answer.type/math :answer/value "-1+4\\theta -5{\\theta }^{2}" :db/ensure [:answer/validate]} {:db/id "answer-c57acc65-7f21-5f64-86dc-1d888225d7cf" :answer/id #uuid "c57acc65-7f21-5f64-86dc-1d888225d7cf" :answer/type :answer.type/math :answer/value "-4+5\\theta -{\\theta }^{2}" :db/ensure [:answer/validate]} {:db/id "answer-946fb421-d9f8-515c-ac0d-2febe8130990" :answer/id #uuid "946fb421-d9f8-515c-ac0d-2febe8130990" :answer/type :answer.type/math :answer/value "-4.16+4\\theta -2.5{\\theta }^{2}" :db/ensure [:answer/validate]} {:db/id "answer-ee68ad46-6e17-52dc-b4f9-939c7a0635ea" :answer/id #uuid "ee68ad46-6e17-52dc-b4f9-939c7a0635ea" :answer/type :answer.type/math :answer/value "-8.32+5\\theta -{\\theta }^{2}" :db/ensure [:answer/validate]} {:db/id 17592186193897 :tutorial/content "Likelihood functions of samples drawn from populations modeled using continuous random variables are defined similarly to discrete variables. The only difference is that we use probability density functions instead of probability mass functions.\n\nIf $X_1, X_2, \\ldots, X_{n}$ are independent and identically distributed *continuous* random variables with probability density function $f(x; \\theta),$ then the likelihood function of a random sample $x_1, x_2, \\ldots, x_n$ is given by\n\n$$\nL(\\theta) = P(X_1=x_1, X_2=x_2, \\ldots , X_n = x_n) = \\displaystyle\\prod_{i=1}^n f(x_i;\\,\\theta).\n$$\n\nFor example, let $X_1, X_2, X_3$ be continuous, I.I.D. random variables with the following probability density function:\n\n$$\nf(x; \\theta) = \\theta x^{-\\theta-1}, \\qquad x \\geq 1\n$$\n\nHere, $\\theta$ is an unknown parameter. Suppose we conduct our random sample and get the following results:\n\n$$\nx_1 = 2.5, \\qquad x_2 = 3.2, \\qquad x_3 = 1.2.\n$$\n\n \n\nIn this case, we compute the likelihood function as follows:\n\n$$\n\\begin{aligned}L(\\theta ) & ={\\prod }_{i=1}^{n}(\\theta {x}_{i}^{-\\theta -1}) \\\\  & =(\\theta {x}_{1}^{-\\theta -1})\\cdot (\\theta {x}_{2}^{-\\theta -1})⋯(\\theta {x}_{n}^{-\\theta -1}) \\\\  & ={\\theta }^{n}({x}_{1}^{-\\theta -1})\\cdot ({x}_{2}^{-\\theta -1})⋯({x}_{n}^{-\\theta -1}) \\\\  & ={\\theta }^{n}{({x}_{1}\\cdot {x}_{2}⋯{x}_{n})}^{-\\theta -1} \\\\  & ={\\theta }^{n}({\\prod }_{i=1}^{n}{x}_{i})^{-\\theta -1}\\end{aligned}\n$$\n\nFor our sample, we have $n=3$, and\n\n$$\n\\begin{aligned}{\\prod }_{i=1}^{n}{x}_{i} & =2.5\\cdot 3.2\\cdot 1.2=9.6.\\end{aligned}\n$$\n\nTherefore, \n\n$$\nL(\\theta) = \\theta^{3} ( 9.6 )^{-\\theta-1}.\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186193902 :tutorial/content "The probability density function of a normally distributed random variable $X\\sim N(\\mu,\\sigma^2)$ is given by\n\n$$\nf(x) = \\dfrac{1}{\\sigma\\sqrt{2\\pi}}e^{-\\frac12\\left(\\frac{x-\\mu}{\\sigma}\\right)^2}.\n$$\n\nSome example normal distribution curves are shown below. \n\n![](images/c9/c9359fc84401aabb19e526755b70647cb0496fa8ddba65974466e0ffc3dbbbdc.png)\n\nIf we set $\\sigma=1,$ then $f(x)$ simplifies as follows:\n\n$$\nf(x) = \\dfrac{1}{\\sqrt{2\\pi}}e^{-(x-\\mu)^2/2}.\n$$\n\nThis is a standard normal random variable whose mean is shifted right by $\\mu$ units.\n\nFinally, setting the unknown parameter as $\\theta$ when discussing likelihood functions is common. Following this convention, we set $\\mu=\\theta,$ and we get\n\n$$\nf(x;\\theta) =  \\dfrac{1}{\\sqrt{2\\pi}}e^{-(x-\\theta)^2/2}.\n$$\n\nLet's use this to compute some likelihood functions of some normally distributed sample data." :db/ensure [:tutorial/validate]} {:db/id 17592186192932 :activity/expected-seconds 660.0 :db/ensure [:activity/validate]}]
