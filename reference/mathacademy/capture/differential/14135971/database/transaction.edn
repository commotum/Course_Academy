}{x}_{i} \\\\  & =2.3+4.3+5.6+1.2+2.4 \\\\  & =15.8\\end{aligned}\n$$\n\nand $n=5.$ Therefore, \n\n$$\n\\begin{aligned}L(\\theta ) & ={\\theta }^{5}\\,{e}^{-15.8\\theta }.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f16d5cf2-9777-5c71-b0b5-144662b7db85"] :db/ensure [:question/validate]} {:db/id "answer-field-f16d5cf2-9777-5c71-b0b5-144662b7db85" :answer-field/id #uuid "f16d5cf2-9777-5c71-b0b5-144662b7db85" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-dea83a2e-94b9-5271-9924-01ac2c1ec476" :answer-field/choices ["answer-e94fa2bc-b583-577a-bd8e-a65df54b0519" "answer-26dca0f2-85d0-5ea1-ac50-5d89df476c2c" "answer-699a5a51-d732-56cb-a463-1fddf35d3809" "answer-dea83a2e-94b9-5271-9924-01ac2c1ec476" "answer-fa0e647a-a2d7-59e4-a4bd-0b321ff12df5"] :db/ensure [:answer-field/validate]} {:db/id "answer-e94fa2bc-b583-577a-bd8e-a65df54b0519" :answer/id #uuid "e94fa2bc-b583-577a-bd8e-a65df54b0519" :answer/type :answer.type/math :answer/value "\\theta \\,{e}^{-5\\theta }" :db/ensure [:answer/validate]} {:db/id "answer-26dca0f2-85d0-5ea1-ac50-5d89df476c2c" :answer/id #uuid "26dca0f2-85d0-5ea1-ac50-5d89df476c2c" :answer/type :answer.type/math :answer/value "{\\theta }^{-5}\\,{e}^{15.8\\theta }" :db/ensure [:answer/validate]} {:db/id "answer-699a5a51-d732-56cb-a463-1fddf35d3809" :answer/id #uuid "699a5a51-d732-56cb-a463-1fddf35d3809" :answer/type :answer.type/math :answer/value "{\\theta }^{15.8}\\,{e}^{-5\\theta }" :db/ensure [:answer/validate]} {:db/id "answer-dea83a2e-94b9-5271-9924-01ac2c1ec476" :answer/id #uuid "dea83a2e-94b9-5271-9924-01ac2c1ec476" :answer/type :answer.type/math :answer/value "{\\theta }^{5}\\,{e}^{-15.8\\theta }" :db/ensure [:answer/validate]} {:db/id "answer-fa0e647a-a2d7-59e4-a4bd-0b321ff12df5" :answer/id #uuid "fa0e647a-a2d7-59e4-a4bd-0b321ff12df5" :answer/type :answer.type/math :answer/value "{\\theta }^{5}\\,{e}^{-\\theta }" :db/ensure [:answer/validate]} {:db/id "question-7d257a6c-5e5c-58a0-af13-fdf60799b0d8" :question/id #uuid "7d257a6c-5e5c-58a0-af13-fdf60799b0d8" :question/math-academy-id "q-159884" :question/problem "Suppose ${X}_{1},{X}_{2},…,{X}_{6}$ is an I.I.D random sample with ${X}_{i}∼\\text{Exp}(\\theta )$ and unknown rate parameter $\\theta .$ Find the likelihood function of the sample $2.2,\\,1.4,\\,0.7,\\,1.5,\\,2.3,\\,1.7.$" :question/worked-solution "Recall that if ${X}_{1},{X}_{2},…,{X}_{n}$ are independent and identically distributed continuous random variables with probability density function $f(x;\\theta ),$ where $\\theta $ is an unknown parameter, then the likelihood function of a random sample ${x}_{1},{x}_{2},…,{x}_{n}$ is\n\n$$\nL(\\theta )=P({X}_{1}={x}_{1},{X}_{2}={x}_{2},…,{X}_{n}={x}_{n})={\\prod }_{i=1}^{n}f({x}_{i};\\,\\theta ).\n$$\n\nIn our case, we are given a sample of $n=6$ independent exponential random variables with unknown parameter $\\theta ,$ for which the probability density function is\n\n$$\nf(x;\\theta )=\\theta {e}^{-\\theta x},\\,x\\ge 0.\n$$\n\nWe can calculate the likelihood function as follows:\n\n$$\n\\begin{aligned}L(\\theta ) & ={\\prod }_{i=1}^{n}\\theta {e}^{-\\theta {x}_{i}} \\\\  & ={\\theta }^{n}\\,{e}^{-\\theta \\sum {x}_{i}} \\\\  & ={\\theta }^{n}\\,{e}^{-S\\theta }\\end{aligned}\n$$\n\nwhere $S={\\sum }_{i=1}^{n}{x}_{i}.$ \n\nFor our sample, we have that\n\n$$\n\\begin{aligned}S & ={\\sum }_{i=1}^{n}{x}_{i} \\\\  & =2.2+1.4+0.7+1.5+2.3+1.7 \\\\  & =9.8\\end{aligned}\n$$\n\nand $n=6.$ Therefore, \n\n$$\n\\begin{aligned}L(\\theta ) & ={\\theta }^{6}\\,{e}^{-9.8\\theta }.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f31cb1f8-abf8-5006-9a42-b344782adb47"] :db/ensure [:question/validate]} {:db/id "answer-field-f31cb1f8-abf8-5006-9a42-b344782adb47" :answer-field/id #uuid "f31cb1f8-abf8-5006-9a42-b344782adb47" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8cb41e59-7d72-5ef0-a7d9-ebbd92a49049" :answer-field/choices ["answer-8bd43606-b6e8-5e63-b55b-e10d2de2600c" "answer-d89f9578-f310-589b-84b5-8f2c3f634699" "answer-40e3c516-ab91-5e00-8e8a-7acdf5546163" "answer-8cb41e59-7d72-5ef0-a7d9-ebbd92a49049" "answer-eb507c98-41f6-55f2-a7da-d1acbc806762"] :db/ensure [:answer-field/validate]} {:db/id "answer-8bd43606-b6e8-5e63-b55b-e10d2de2600c" :answer/id #uuid "8bd43606-b6e8-5e63-b55b-e10d2de2600c" :answer/type :answer.type/math :answer/value "{\\theta }^{-6}\\,{e}^{9.8\\theta }" :db/ensure [:answer/validate]} {:db/id "answer-d89f9578-f310-589b-84b5-8f2c3f634699" :answer/id #uuid "d89f9578-f310-589b-84b5-8f2c3f634699" :answer/type :answer.type/math :answer/value "{\\theta }^{-9.8}\\,{e}^{6\\theta }" :db/ensure [:answer/validate]} {:db/id "answer-40e3c516-ab91-5e00-8e8a-7acdf5546163" :answer/id #uuid "40e3c516-ab91-5e00-8e8a-7acdf5546163" :answer/type :answer.type/math :answer/value "{\\theta }^{6}\\,{e}^{-8.8\\theta }" :db/ensure [:answer/validate]} {:db/id "answer-8cb41e59-7d72-5ef0-a7d9-ebbd92a49049" :answer/id #uuid "8cb41e59-7d72-5ef0-a7d9-ebbd92a49049" :answer/type :answer.type/math :answer/value "{\\theta }^{6}\\,{e}^{-9.8\\theta }" :db/ensure [:answer/validate]} {:db/id "answer-eb507c98-41f6-55f2-a7da-d1acbc806762" :answer/id #uuid "eb507c98-41f6-55f2-a7da-d1acbc806762" :answer/type :answer.type/math :answer/value "{\\theta }^{8.8}\\,{e}^{-6\\theta }" :db/ensure [:answer/validate]} {:db/id "question-bc819016-9ccb-568a-b71d-77c2cc9598ca" :question/id #uuid "bc819016-9ccb-568a-b71d-77c2cc9598ca" :question/math-academy-id "q-159881" :question/problem "Suppose ${X}_{1},{X}_{2},{X}_{3}$ is an I.I.D random sample with ${X}_{i}∼\\text{Exp}(\\theta )$ and unknown rate parameter $\\theta .$ Find the likelihood function of the sample $1.3,\\,4.3,\\,2.4.$" :question/worked-solution "Recall that if ${X}_{1},{X}_{2},…,{X}_{n}$ are independent and identically distributed continuous random variables with probability density function $f(x;\\theta ),$ where $\\theta $ is an unknown parameter, then the likelihood function of a random sample ${x}_{1},{x}_{2},…,{x}_{n}$ is\n\n$$\nL(\\theta )=P({X}_{1}={x}_{1},{X}_{2}={x}_{2},…,{X}_{n}={x}_{n})={\\prod }_{i=1}^{n}f({x}_{i};\\,\\theta ).\n$$\n\nIn our case, we are given a sample of $n=3$ independent exponential random variables with unknown parameter $\\theta ,$ for which the probability density function is\n\n$$\nf(x;\\theta )=\\theta {e}^{-\\theta x},\\,x\\ge 0.\n$$\n\nWe can calculate the likelihood function as follows:\n\n$$\n\\begin{aligned}L(\\theta ) & ={\\prod }_{i=1}^{n}\\theta {e}^{-\\theta {x}_{i}} \\\\  & ={\\theta }^{n}\\,{e}^{-\\theta \\sum {x}_{i}} \\\\  & ={\\theta }^{n}\\,{e}^{-S\\theta }\\end{aligned}\n$$\n\nwhere $S={\\sum }_{i=1}^{n}{x}_{i}.$ \n\nFor our sample, we have that\n\n$$\n\\begin{aligned}S & ={\\sum }_{i=1}^{n}{x}_{i} \\\\  & =1.3+4.3+2.4 \\\\  & =8.0\\end{aligned}\n$$\n\nand $n=3.$ Therefore, \n\n$$\n\\begin{aligned}L(\\theta ) & ={\\theta }^{3}\\,{e}^{-8\\theta }.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-3a602c36-55a2-5253-a9ad-88a05a90b82f"] :db/ensure [:question/validate]} {:db/id "answer-field-3a602c36-55a2-5253-a9ad-88a05a90b82f" :answer-field/id #uuid "3a602c36-55a2-5253-a9ad-88a05a90b82f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bedd018d-8650-53e3-9c59-beed8134ed2e" :answer-field/choices ["answer-5f67f625-631a-5c31-9b60-cad24a6f0f98" "answer-f7567dde-66a3-5e2a-add8-45f5e13e4a89" "answer-3e735132-ec76-5ebf-9166-5f920cfcbc62" "answer-bedd018d-8650-53e3-9c59-beed8134ed2e" "answer-632257d9-5cc1-53a1-9dc8-ceee85e61198"] :db/ensure [:answer-field/validate]} {:db/id "answer-5f67f625-631a-5c31-9b60-cad24a6f0f98" :answer/id #uuid "5f67f625-631a-5c31-9b60-cad24a6f0f98" :answer/type :answer.type/math :answer/value "\\theta \\,{e}^{-3\\theta }" :db/ensure [:answer/validate]} {:db/id "answer-f7567dde-66a3-5e2a-add8-45f5e13e4a89" :answer/id #uuid "f7567dde-66a3-5e2a-add8-45f5e13e4a89" :answer/type :answer.type/math :answer/value "{\\theta }^{-3}\\,{e}^{8\\theta }" :db/ensure [:answer/validate]} {:db/id "answer-3e735132-ec76-5ebf-9166-5f920cfcbc62" :answer/id #uuid "3e735132-ec76-5ebf-9166-5f920cfcbc62" :answer/type :answer.type/math :answer/value "{\\theta }^{-8}\\,{e}^{3\\theta }" :db/ensure [:answer/validate]} {:db/id "answer-bedd018d-8650-53e3-9c59-beed8134ed2e" :answer/id #uuid "bedd018d-8650-53e3-9c59-beed8134ed2e" :answer/type :answer.type/math :answer/value "{\\theta }^{3}\\,{e}^{-8\\theta }" :db/ensure [:answer/validate]} {:db/id "answer-632257d9-5cc1-53a1-9dc8-ceee85e61198" :answer/id #uuid "632257d9-5cc1-53a1-9dc8-ceee85e61198" :answer/type :answer.type/math :answer/value "{\\theta }^{8}\\,{e}^{-3\\theta }" :db/ensure [:answer/validate]} {:db/id "question-5ede7a13-53b1-5dcd-b174-1b2115493b08" :question/id #uuid "5ede7a13-53b1-5dcd-b174-1b2115493b08" :question/math-academy-id "q-159953" :question/problem "Suppose ${X}_{1},{X}_{2},…,{X}_{10}$ is an I.I.D random sample with ${X}_{i}∼N(\\theta ,1),$ where $\\theta $ is an unknown mean. For a particular sample ${x}_{1},{x}_{2},…,{x}_{10},$ you're given that \n\n$$\n{\\sum }_{i=1}^{10}{x}_{i}=-2.8,\\,{\\sum }_{i=1}^{10}{x}_{i}^{2}=14.24.\n$$\n\nGiven that the likelihood function of the sample is\n\n$$\nL(\\theta )=\\frac{1}{32{\\pi }^{5}}\\,{e}^{\\,g(\\theta )},\n$$\n\nwhat is the expression for $g(\\theta )?$\n\n*Hint: The probability density function for a normal random variable with mean $\\theta $ and variance $1$ is given by* \n\n$$\nf(x;\\theta )=\\frac{1}{\\sqrt{2\\pi }}{e}^{-(x-\\theta )^{2}/2},\\,x\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "Recall that if ${X}_{1},{X}_{2},…,{X}_{n}$ are independent and identically distributed continuous random variables with probability density function $f(x;\\theta ),$ where $\\theta $ is an unknown parameter, then the likelihood function of a random sample ${x}_{1},{x}_{2},…,{x}_{n}$ is\n\n$$\nL(\\theta )=P({X}_{1}={x}_{1},{X}_{2}={x}_{2},…,{X}_{n}={x}_{n})={\\prod }_{i=1}^{n}f({x}_{i};\\,\\theta ).\n$$\n\nIn our case, we are given a sample of $n=10$ independent normal random variables with unknown mean $\\theta $ and variance ${\\sigma }^{2}=1,$ for which the probability density function is\n\n$$\nf(x;\\theta )=\\frac{1}{\\sqrt{2\\pi }}{e}^{-(x-\\theta )^{2}/2},\\,x\\in (-\\infty ,\\infty ).\n$$\n\nWe can calculate the likelihood function as follows:\n\n$$\n\\begin{aligned}L(\\theta ) & ={\\prod }_{i=1}^{n}(\\frac{1}{\\sqrt{2\\pi }}{e}^{-({x}_{i}-\\theta )^{2}/2}) \\\\  & =(2\\pi )^{-n/2}\\,{e}^{-\\sum ({x}_{i}-\\theta )^{2}/2} \\\\  & =(2\\pi )^{-n/2}\\,{e}^{-(\\sum {x}_{i}^{2}-2\\theta \\sum {x}_{i}+n{\\theta }^{2})/2} \\\\  & =(2\\pi )^{-n/2}\\,{e}^{-(C-2S\\theta +n{\\theta }^{2})/2}\\end{aligned}\n$$\n\nwhere $S={\\sum }_{i=1}^{n}{x}_{i}$ and $C={\\sum }_{i=1}^{n}{x}_{i}^{2}.$\n\nWe are told that $S={\\sum }_{i=1}^{n}{x}_{i}=-2.8,$ $C={\\sum }_{i=1}^{n}{x}_{i}^{2}=14.24,$ and $n=10.$ Therefore, \n\n$$\n\\begin{aligned}L(\\theta ) & =(2\\pi )^{-10/2}\\,{e}^{-(14.24-2(-2.8)\\theta +10{\\theta }^{2})/2} \\\\  & =\\frac{1}{32{\\pi }^{5}}\\,{e}^{\\,-7.12\\,-\\,2.8\\theta \\,-\\,5{\\theta }^{2}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\ng(\\theta )=-7.12-2.8\\theta -5{\\theta }^{2}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b6084e73-2e8b-5dd9-9cce-558327c71c52"] :db/ensure [:question/validate]} {:db/id "answer-field-b6084e73-2e8b-5dd9-9cce-558327c71c52" :answer-field/id #uuid "b6084e73-2e8b-5dd9-9cce-558327c71c52" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-35e5737f-3a2e-5e55-98b5-0eae615d6728" :answer-field/choices ["answer-9a404fb7-6bd1-52f4-9bac-d331160861e5" "answer-6c0cf2ea-a653-5d37-abfc-d145715d04f3" "answer-6d89a108-45ae-5bcf-b3d8-e0b9c2d510ea" "answer-a269c21