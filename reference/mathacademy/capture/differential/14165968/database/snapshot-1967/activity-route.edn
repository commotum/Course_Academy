#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186490353} :activity/id #uuid "a4407aef-3121-52a9-b946-f3e8ebff0a98" :activity/scope {:db/id #edb/ref 17592186050580 :topic/id #uuid "557f8b58-be49-555e-8162-3d1448eaff0c" :topic/math-academy-id 3728} :activity/steps [{:db/id #edb/ref 17592186490330 :step/content {:db/id #edb/ref 17592186490222 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "077fd3b6-a66f-5992-89ff-f734285036e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1<f(x)<2" :db/id #edb/ref 17592186489533} {:answer/id #uuid "7bd4f26c-68d7-508b-ae68-df55769b27e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\infty <f(x)<1" :db/id #edb/ref 17592186489797} {:answer/id #uuid "85a2736a-d41e-5e05-9a88-0d47451e0a05" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1<f(x)<\\infty " :db/id #edb/ref 17592186489820} {:answer/id #uuid "a7ab8a0a-f5d1-5b79-8ad9-de72a82f973b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\infty <f(x)\\le 1" :db/id #edb/ref 17592186489884} {:answer/id #uuid "c20f2f3c-997e-5379-8c75-90a1c8d674a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1\\le f(x)<\\infty " :db/id #edb/ref 17592186489935}] :answer-field/correct {:db/id #edb/ref 17592186489797} :answer-field/id #uuid "e7dd7694-ccde-505f-9224-5e793348c4a2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186490197}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "24be045a-a1e0-562b-a001-f17a0f6f12b3" :question/math-academy-id "q-79997" :question/problem "![](images/ac/acbf4ae592e7912e6e27415ce99f872c4c0ec1737cfa3269635f37f7fa0fe5db.png)\n\nWhat is the range of the function $f(x),$ shown above?" :question/worked-solution "First, we find the smallest and largest $y$-values in the graph.\n\n- There is no smallest $y$-value.\n\n- The largest $y$-value is $1.$ This occurs when $x\\to -\\infty .$ However, note that this point is not included in the graph.\n\nThe function covers all the $y$-values between $-\\infty $ and $1,$ but not including $1.$\n\nTherefore, the range is $-\\infty <y<1,$ which can also be written as  $-\\infty <f(x)<1.$"} :step/id #uuid "027ab44b-48d6-5961-8e71-f93826f26196" :step/next {:db/id #edb/ref 17592186490379}} {:db/id #edb/ref 17592186490348 :step/content {:db/id #edb/ref 17592186490228 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b3e2fe1e-5ce8-5259-883a-e27ba55b0ebc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\infty" :db/id #edb/ref 17592186489908}] :answer-field/correct {:db/id #edb/ref 17592186489908} :answer-field/id #uuid "2356dd8e-95af-53aa-99c1-588dd0a4fe73" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186490089} {:answer-field/choices [{:answer/id #uuid "42a84cca-e35f-5c4a-b07e-845a7d28433f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\le" :db/id #edb/ref 17592186489667}] :answer-field/correct {:db/id #edb/ref 17592186489667} :answer-field/id #uuid "3443567b-7d91-5f03-9d4e-6b2b217a9066" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186490103} {:answer-field/choices [{:answer/id #uuid "80e903e5-f2b3-5ed4-a09b-70f4dda6a048" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186489807}] :answer-field/correct {:db/id #edb/ref 17592186489807} :answer-field/id #uuid "9abeb5f8-371d-515e-a1f6-7daf65af6f1e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186490163}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2c426db9-03a0-51ed-9522-bdc02ff647af" :question/math-academy-id "q-236388" :question/problem "![](images/49/49288e2c082854cfc27a2d48af2d82a96016a3c1394066471d49873e4c75878e.png)\n\nWhat is the range of the function $f(x),$ shown above?\n\nThe range is \n{{field-1}}{{field-2}}\n$f(x)<$\n{{field-3}}." :question/worked-solution "First, we find the smallest and largest $y$-values in the graph.\n\n- The smallest $y$-value is $1.$ This occurs when $x=0.$\n\n- There is no largest $y$-value.\n\nThe function covers all the $y$-values between $1$ and $\\infty ,$ including $1.$\n\nTherefore, the range is $1\\le y<\\infty ,$ which can also be written as \n$1\\le f(x)<\\infty .$"} :step/id #uuid "356e531e-4a8b-5a5a-96af-77c558013231" :step/next {:db/id #edb/ref 17592186490375}} {:db/id #edb/ref 17592186490353 :step/content {:db/id #edb/ref 17592186490278 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39cc2ab9-0e69-5e63-9804-2b53b2eb63cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[-2,4]" :db/id #edb/ref 17592186489645} {:answer/id #uuid "5825da8a-a8cd-5ffe-bc88-0e82b360e91d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-2,3)" :db/id #edb/ref 17592186489725} {:answer/id #uuid "698e15a5-80be-55ee-8a03-6ab33045d444" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[0,4)" :db/id #edb/ref 17592186489769} {:answer/id #uuid "b168c6fa-3346-5972-afe9-b5a59f8ae3c9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[-2,3)\\cup (3,4]" :db/id #edb/ref 17592186489903} {:answer/id #uuid "b8291b42-df3a-58f9-a0f8-316a3f99fa6a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[-2,0]" :db/id #edb/ref 17592186489920}] :answer-field/correct {:db/id #edb/ref 17592186489645} :answer-field/id #uuid "61208644-8c5b-5f4d-81d6-4e752cb4edbf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186490132}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9d214df3-aafe-5a52-bd67-2c23fbad240f" :question/math-academy-id "q-34734" :question/problem "![](images/58/582236fbb64c0ebeda310cb0007435d4044295b232499ff5771ede846a1b6d05.png)\n\nWhat is the range of the function shown above?" :question/worked-solution "We find the ranges of the individual pieces, and then calculate their union:\n\n- The range of the branch defined on $x\\in [-4,-1)$ is $[0,4]$\n\n- The range of the branch defined on $x\\in [-1,1)$ is $[-2,2)$\n\nTherefore, the range of $f(x)$ is $[0,4]\\cup [-2,2)=[-2,4].$"} :step/id #uuid "537a7146-75a4-56c9-a7db-1e94a31e5c00" :step/next {:db/id #edb/ref 17592186490330}} {:db/id #edb/ref 17592186490375 :step/content {:db/id #edb/ref 17592186490322 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b528277-bd1d-5076-b163-8f585cd1adce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\cap " :db/id #edb/ref 17592186489649} {:answer/id #uuid "52b3e7b8-7456-581e-bfd1-f45bbe1051d9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\cup " :db/id #edb/ref 17592186489710}] :answer-field/correct {:db/id #edb/ref 17592186489710} :answer-field/id #uuid "4c1a5b0b-3cf6-5be3-bc9c-ae896e933954" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186490118} {:answer-field/choices [{:answer/id #uuid "0a2e451d-3033-5f0d-89f1-815a64077872" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[-2,0]" :db/id #edb/ref 17592186489537} {:answer/id #uuid "3294b297-4b44-5f75-9b72-739bc720849c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-2,0)" :db/id #edb/ref 17592186489628} {:answer/id #uuid "da0ff875-c917-5972-a3c4-675de3efc1b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-2,0]" :db/id #edb/ref 17592186489995} {:answer/id #uuid "f543cbe4-e2c6-5a46-b0cd-da91aa24619c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[-2,0)" :db/id #edb/ref 17592186490046}] :answer-field/correct {:db/id #edb/ref 17592186490046} :answer-field/id #uuid "c1dd13d9-fa2a-56fa-b820-f5ccac336683" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186490179} {:answer-field/choi