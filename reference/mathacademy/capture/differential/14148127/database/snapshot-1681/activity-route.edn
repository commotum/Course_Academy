#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186447173} :activity/id #uuid "2f3ba771-5853-531e-b5df-7ce8360fb615" :activity/scope {:db/id #edb/ref 17592186049674 :topic/id #uuid "09e82368-7656-5709-b72f-b4db605d6406" :topic/math-academy-id 3013} :activity/steps [{:db/id #edb/ref 17592186447169 :step/content {:db/id #edb/ref 17592186425754 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a2ebf1d-6b21-517e-8473-6b5520ced24c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.17" :db/id #edb/ref 17592186425730} {:answer/id #uuid "25a99cc8-8701-579f-b7ef-cb9e7b7f1e7c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.22" :db/id #edb/ref 17592186425736} {:answer/id #uuid "55e8daa5-4432-5f7f-b7b9-25ac21b5f238" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.50" :db/id #edb/ref 17592186425738} {:answer/id #uuid "785ab3f2-459a-5180-8933-34aa9440618c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.05" :db/id #edb/ref 17592186425740} {:answer/id #uuid "92d71196-a3a0-5ab1-b5f5-5721df71e75d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.71" :db/id #edb/ref 17592186425744}] :answer-field/correct {:db/id #edb/ref 17592186425736} :answer-field/id #uuid "5943d631-1c0b-56a0-a90d-e9d31d030f54" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186425751}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "748a2779-e90d-59a2-9916-b0ad2a8182a7" :question/math-academy-id "q-143423" :question/problem "If ${X}_{1},{X}_{2},…,{X}_{20}$ is a sample of size $n=20$ drawn from a population with mean $\\mu =6$ and variance ${\\sigma }^{2}=1,$ calculate the standard error of $\\overset{―}{X}.$ Round your answer to two decimal places." :question/worked-solution "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ from a population with population mean $\\mu $ and population variance ${\\sigma }^{2},$ then\n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu ,\\,\\text{Var}[\\overset{―}{X}]=\\frac{{\\sigma }^{2}}{n},\n$$\n\nand the standard error is given by\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{\\text{Var}[\\overset{―}{X}]}=\\frac{\\sigma }{\\sqrt{n}}.\n$$\n\nSince the population variance is ${\\sigma }^{2}=1$ and the sample size is $n=20,$ we have that \n\n$$\n\\begin{aligned}\\text{Var}[\\overset{―}{X}] & =\\frac{1}{20} \\\\  & =0.05.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{0.05}≈0.22.\n$$"} :step/id #uuid "2f448fd7-9340-59cd-a3ee-bfee3dc9c099" :step/next {:db/id #edb/ref 17592186447172}} {:db/id #edb/ref 17592186447170 :step/content {:db/id #edb/ref 17592186447168 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52aca894-e775-54c1-8b43-216acbc28ba1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "50" :db/id #edb/ref 17592186447162} {:answer/id #uuid "99113dff-3b5a-5c2f-a393-160c589b1310" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "201" :db/id #edb/ref 17592186447163} {:answer/id #uuid "bc3f329b-2d56-5c65-8fd5-ce307d766978" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "21" :db/id #edb/ref 17592186447164} {:answer/id #uuid "c6919965-008c-583a-804a-02b29893ad0a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "401" :db/id #edb/ref 17592186447165} {:answer/id #uuid "f7eb1986-1eeb-5a7e-94d4-f2aae2d2a16c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "901" :db/id #edb/ref 17592186447166}] :answer-field/correct {:db/id #edb/ref 17592186447165} :answer-field/id #uuid "962adc96-285b-55db-b3b2-45bc705d2628" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186447167}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "74bfeec3-3f4e-5c4f-b7e4-18502ff50810" :question/math-academy-id "q-143443" :question/problem "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ drawn from a population with mean $\\mu =100$ and variance ${\\sigma }^{2}=25,$  determine the smallest sample size required so that the standard error of the mean is less than $0.25.$" :question/worked-solution "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ from a population with population mean $\\mu $ and population variance ${\\sigma }^{2},$ then\n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu ,\\,\\text{Var}[\\overset{―}{X}]=\\frac{{\\sigma }^{2}}{n},\n$$\n\nand the standard error is given by\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{\\text{Var}[\\overset{―}{X}]}=\\frac{\\sigma }{\\sqrt{n}}\n$$\n\nSince the population standard deviation is $\\sigma =\\sqrt{25}=5,$ we have that \n\n$$\n\\text{SE}[\\overset{―}{X}]=\\frac{5}{\\sqrt{n}}.\n$$\n\nWe require that the standard error is less than $0.25.$ Therefore\n\n$$\n\\begin{aligned}\\frac{5}{\\sqrt{n}} & <0.25 \\\\ \\sqrt{n} & >\\frac{5}{0.25} \\\\ \\sqrt{n} & >20 \\\\ n & >{20}^{2} \\\\ n & >400.\\end{aligned}\n$$\n\nTherefore, the smallest sample size is $n=401.$"} :step/id #uuid "5815b438-b2dd-53fb-b220-9ae07c35776e"} {:db/id #edb/ref 17592186447171 :step/content {:db/id #edb/ref 17592186418454 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "353a41d3-498d-5a8a-a9e6-efadecfbdf97" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "101" :db/id #edb/ref 17592186418422} {:answer/id #uuid "51e57186-4049-585f-8889-b1eedaf9cb49" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "251" :db/id #edb/ref 17592186418426} {:answer/id #uuid "772d9248-19f9-5fe6-9b77-c1a0f57c290b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "62\\,501" :db/id #edb/ref 17592186418430} {:answer/id #uuid "8a57d240-911f-55ae-81aa-4c9727b14650" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10\\,001" :db/id #edb/ref 17592186418432} {:answer/id #uuid "bb42c329-8069-528c-b75c-f226cec7f9fc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1\\,001" :db/id #edb/ref 17592186418440}] :answer-field/correct {:db/id #edb/ref 17592186418432} :answer-field/id #uuid "795337c1-be28-5aa3-ba9d-a058d2de96cf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186418450}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0c52d3d8-d8c0-58d1-b731-d5f1789535ad" :question/math-academy-id "q-143439" :question/problem "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ drawn from a population with mean $\\mu =5$ and variance ${\\sigma }^{2}=4,$  determine the smallest sample size required so that the standard error of the mean is less than $0.02.$" :question/worked-solution "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ from a population with population mean $\\mu $ and population variance ${\\sigma }^{2},$ then\n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu ,\\,\\text{Var}[\\overset{―}{X}]=\\frac{{\\sigma }^{2}}{n},\n$$\n\nand the standard error is given by\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{\\text{Var}[\\overset{―}{X}]}=\\frac{\\sigma }{\\sqrt{n}}\n$$\n\nSince the population standard deviation is $\\sigma =\\sqrt{4}=2,$ we have that \n\n$$\n\\text{SE}[\\overset{―}{X}]=\\frac{2}{\\sqrt{n}}.\n$$\n\nWe require that the standard error is less than $0.02.$ Therefore\n\n$$\n\\begin{aligned}\\frac{2}{\\sqrt{n}} & <0.02 \\\\ \\sqrt{n} & >\\frac{2}{0.02} \\\\ \\sqrt{n} & >100 \\\\ n & >{100}^{2} \\\\ n & >10\\,000.\\end{aligned}\n$$\n\nTherefore, the smallest sample size is $n=10\\,001.$"} :step/id #uuid "86db7aa4-526f-594e-98bb-07bf1f02e96b" :step/next {:db/id #edb/ref 17592186447170}} {:db/id #edb/ref 17592186447172 :step/content {:db/id #edb/ref 17592186425753 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "116200b8-f0e0-5d54-986b-cdb0d1f93684" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3.13" :db/id #edb/ref 17592186425732} {:answer/id #uuid "19e33d38-75d1-531e-92cf-f39947aea28c" :answer/type {:db/id #edb/ref 17592186045498} :answer