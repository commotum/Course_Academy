stion/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a2ebf1d-6b21-517e-8473-6b5520ced24c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.17" :db/id #edb/ref 17592186425730} {:answer/id #uuid "25a99cc8-8701-579f-b7ef-cb9e7b7f1e7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.22" :db/id #edb/ref 17592186425736} {:answer/id #uuid "55e8daa5-4432-5f7f-b7b9-25ac21b5f238" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.50" :db/id #edb/ref 17592186425738} {:answer/id #uuid "785ab3f2-459a-5180-8933-34aa9440618c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.05" :db/id #edb/ref 17592186425740} {:answer/id #uuid "92d71196-a3a0-5ab1-b5f5-5721df71e75d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.71" :db/id #edb/ref 17592186425744}] :answer-field/correct {:answer/id #uuid "25a99cc8-8701-579f-b7ef-cb9e7b7f1e7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.22" :db/id #edb/ref 17592186425736} :answer-field/id #uuid "5943d631-1c0b-56a0-a90d-e9d31d030f54" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186425751}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "748a2779-e90d-59a2-9916-b0ad2a8182a7" :question/math-academy-id "q-143423" :question/problem "If ${X}_{1},{X}_{2},…,{X}_{20}$ is a sample of size $n=20$ drawn from a population with mean $\\mu =6$ and variance ${\\sigma }^{2}=1,$ calculate the standard error of $\\overset{―}{X}.$ Round your answer to two decimal places." :question/worked-solution "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ from a population with population mean $\\mu $ and population variance ${\\sigma }^{2},$ then\n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu ,\\,\\text{Var}[\\overset{―}{X}]=\\frac{{\\sigma }^{2}}{n},\n$$\n\nand the standard error is given by\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{\\text{Var}[\\overset{―}{X}]}=\\frac{\\sigma }{\\sqrt{n}}.\n$$\n\nSince the population variance is ${\\sigma }^{2}=1$ and the sample size is $n=20,$ we have that \n\n$$\n\\begin{aligned}\\text{Var}[\\overset{―}{X}] & =\\frac{1}{20} \\\\  & =0.05.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{0.05}≈0.22.\n$$"}] [{:db/id #edb/ref 17592186425753 :knowledge-point/_questions [{:db/id #edb/ref 17592186162107 :knowledge-point/id #uuid "6eac4a2e-cfa8-5476-919e-fd3c26d01d75" :knowledge-point/title "Finding the Standard Error"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "116200b8-f0e0-5d54-986b-cdb0d1f93684" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.13" :db/id #edb/ref 17592186425732} {:answer/id #uuid "19e33d38-75d1-531e-92cf-f39947aea28c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.41" :db/id #edb/ref 17592186425734} {:answer/id #uuid "3e89daf0-19fa-53f4-b72d-31d6ed1621bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.77" :db/id #edb/ref 17592186425737} {:answer/id #uuid "84db3eb9-187b-5476-8ae3-4fc97bb737af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.12" :db/id #edb/ref 17592186425742} {:answer/id #uuid "b7436ec0-730a-5723-89b9-c51e09d25df2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.33" :db/id #edb/ref 17592186425746}] :answer-field/correct {:answer/id #uuid "19e33d38-75d1-531e-92cf-f39947aea28c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.41" :db/id #edb/ref 17592186425734} :answer-field/id #uuid "5fa84345-5063-5b45-a9a8-f4e3ac36fb05" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186425752}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "27d2a840-69cf-5325-b960-367fa82827bd" :question/math-academy-id "q-143424" :question/problem "If ${X}_{1},{X}_{2},…,{X}_{8}$ is a sample of size $n=8$ drawn from a population with mean $\\mu =30$ and variance ${\\sigma }^{2}=16,$ calculate the standard error of $\\overset{―}{X}.$ Round your answer to two decimal places." :question/worked-solution "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ from a population with population mean $\\mu $ and population variance ${\\sigma }^{2},$ then\n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu ,\\,\\text{Var}[\\overset{―}{X}]=\\frac{{\\sigma }^{2}}{n},\n$$\n\nand the standard error is given by\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{\\text{Var}[\\overset{―}{X}]}=\\frac{\\sigma }{\\sqrt{n}}.\n$$\n\nSince the population variance is ${\\sigma }^{2}=16$ and the sample size is $n=8,$ we have that \n\n$$\n\\begin{aligned}\\text{Var}[\\overset{―}{X}] & =\\frac{16}{8} \\\\  & =2.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{2}≈1.41.\n$$"}] [{:db/id #edb/ref 17592186418454 :knowledge-point/_questions [{:db/id #edb/ref 17592186162108 :knowledge-point/id #uuid "9453a0f1-029b-5436-94c1-47ee311f6e4d" :knowledge-point/title "Calculating an Appropriate Sample Size"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "353a41d3-498d-5a8a-a9e6-efadecfbdf97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "101" :db/id #edb/ref 17592186418422} {:answer/id #uuid "51e57186-4049-585f-8889-b1eedaf9cb49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "251" :db/id #edb/ref 17592186418426} {:answer/id #uuid "772d9248-19f9-5fe6-9b77-c1a0f57c290b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "62\\,501" :db/id #edb/ref 17592186418430} {:answer/id #uuid "8a57d240-911f-55ae-81aa-4c9727b14650" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\,001" :db/id #edb/ref 17592186418432} {:answer/id #uuid "bb42c329-8069-528c-b75c-f226cec7f9fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,001" :db/id #edb/ref 17592186418440}] :answer-field/correct {:answer/id #uuid "8a57d240-911f-55ae-81aa-4c9727b14650" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\,001" :db/id #edb/ref 17592186418432} :answer-field/id #uuid "795337c1-be28-5aa3-ba9d-a058d2de96cf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186418450}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0c52d3d8-d8c0-58d1-b731-d5f1789535ad" :question/math-academy-id "q-143439" :question/problem "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ drawn from a population with mean $\\mu =5$ and variance ${\\sigma }^{2}=4,$  determine the smallest sample size required so that the standard error of the mean is less than $0.02.$" :question/worked-solution "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ from a population with population mean $\\mu $ and population variance ${\\sigma }^{2},$ then\n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu ,\\,\\text{Var}[\\overset{―}{X}]=\\frac{{\\sigma }^{2}}{n},\n$$\n\nand the standard error is given by\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{\\text{Var}[\\overset{―}{X}]}=\\frac{\\sigma }{\\sqrt{n}}\n$$\n\nSince the population standard deviation is $\\sigma =\\sqrt{4}=2,$ we have that \n\n$$\n\\text{SE}[\\overset{―}{X}]=\\frac{2}{\\sqrt{n}}.\n$$\n\nWe require that the standard error is less than $0.02.$ Therefore\n\n$$\n\\begin{aligned}\\frac{2}{\\sqrt{n}} & <0.02 \\\\ \\sqrt{n} & >\\frac{2}{0.02} \\\\ \\sqrt{n} & >100 \\\\ n & >{100}^{2} \\\\ n & >10\\,000.\\end{aligned}\n$$\n\nTherefore, the smallest sample size is $n=10\\,001.$"}]}
