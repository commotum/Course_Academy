c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448690} {:answer/id #uuid "74213575-ddc8-5213-b2ce-a59e501dc1ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448691}] :answer-field/correct {:answer/id #uuid "74213575-ddc8-5213-b2ce-a59e501dc1ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448691} :answer-field/id #uuid "4cebde04-2f8f-5849-8618-d6c2a4e0afbc" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449385} {:answer-field/choices [{:answer/id #uuid "49fafbe7-10fb-5c34-b26c-5b9891c6d338" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448692} {:answer/id #uuid "041b9065-8c9f-5ab2-b38c-d4d4aa44d1c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448693}] :answer-field/correct {:answer/id #uuid "041b9065-8c9f-5ab2-b38c-d4d4aa44d1c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448693} :answer-field/id #uuid "4867348a-6919-5bb7-95d2-3a16f8877ca0" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449386} {:answer-field/choices [{:answer/id #uuid "7a7cf8c7-d729-5add-8df3-4fe73a945535" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448694} {:answer/id #uuid "e6f0d748-cf94-5065-86a9-c7923f501c4c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448695}] :answer-field/correct {:answer/id #uuid "7a7cf8c7-d729-5add-8df3-4fe73a945535" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448694} :answer-field/id #uuid "9e31e2bd-4923-5578-a451-2148c2c56f5a" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449387}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "14d8b1c2-9248-513d-b061-309a07f2a6a7" :question/math-academy-id "q-47458" :question/problem "Which of the following statements are true regarding the orthogonal matrix $Q?$\n\nSelect all that apply.\n\n- **I.** ${Q}^{T}$ is orthogonal\n- **II.** The identity matrix $I$ is orthogonal\n- **III.** $2Q$ is orthogonal" :question/worked-solution "Recall that a matrix $Q$ is orthogonal if and only if\n\n$$\nQ{Q}^{T}={Q}^{T}Q=I.\n$$\n\nTo check that a matrix is orthogonal, it is sufficient to check that the above equation is satisfied.\n\nMoreover, we have the following properties:\n\n- For any orthogonal matrix $Q,$ we have ${Q}^{-1}={Q}^{T}.$\n\n- $(AB)^{T}={B}^{T}{A}^{T}$ for conformable matrices $A$ and $B.$\n\nWith that in mind, let's inspect each of the statements in turn.\n\n- Statement I is true. Computing the product ${Q}^{T}\\cdot ({Q}^{T})^{T},$ we obtain\n\n$$\n\\begin{aligned}{Q}^{T}\\cdot ({Q}^{T})^{T} & ={Q}^{T}Q \\\\  & =I.\\end{aligned}\n$$\n\n- Statement II is true. The columns of the identity matrix are orthonormal. Therefore, $I$ is an orthogonal matrix.\n\n- Statement III is false. Computing the product $2Q\\cdot (2Q)^{T},$ we obtain\n\n$$\n\\begin{aligned}2Q\\cdot (2Q)^{T} & =2Q\\cdot 2{Q}^{T} \\\\  & =4Q{Q}^{T} \\\\  & =4I \\\\  & \\ne I.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186354294 :knowledge-point/_questions [{:db/id #edb/ref 17592186133949 :knowledge-point/id #uuid "ee00be0e-f6a2-5269-a36d-1eeaf1b32344" :knowledge-point/title "Calculating the Determinant of a Product of Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a47111d-6c23-5b0a-91f9-9bb04923dabf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25-\\sqrt{33}" :db/id #edb/ref 17592186351802} {:answer/id #uuid "29ce09dc-21df-5eb3-a895-49c7aebe4105" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186351952} {:answer/id #uuid "2f429717-4c5f-5e0a-a416-5943a1f7e75a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186352002} {:answer/id #uuid "b67b2975-b129-51c2-a7fa-c3fb89bbbec7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186353132} {:answer/id #uuid "d1b042d5-c51b-5d9e-a235-9626ad575cff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186353382}] :answer-field/correct {:answer/id #uuid "b67b2975-b129-51c2-a7fa-c3fb89bbbec7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186353132} :answer-field/id #uuid "ed11a05b-d987-571f-866e-9395d8d74355" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354223}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ca01bd52-5594-59b2-b1c6-fbcc08e19094" :question/math-academy-id "q-84242" :question/problem "$$\nP=[\\begin{aligned}\\frac{1}{\\sqrt{17}} & \\frac{4}{\\sqrt{17}} \\\\ -\\frac{4}{\\sqrt{17}} & \\frac{1}{\\sqrt{17}}\\end{aligned}],\\,Q=[\\begin{aligned}5 & \\sqrt{2} \\\\ 4\\sqrt{2} & 5\\end{aligned}]\n$$\n\nFind $|\\text{det}(PQ)|$ given that $P$ is an orthogonal matrix." :question/worked-solution "We use the following facts: \n\n- The determinant of a product is equal to the product of the determinants.\n\n- The determinant of an orthogonal matrix $P$ is equal to $\\pm 1.$\n\nApplying these ideas, we get the following:\n\n$$\n\\begin{aligned}|\\text{det}(PQ)| & =|\\text{det}(P)\\cdot \\text{det}(Q)| \\\\  & =|(\\pm 1)\\cdot \\text{det}(Q)| \\\\  & =|\\pm 1|\\cdot |\\text{det}(Q)| \\\\  & =|\\text{det}(Q)| \\\\  & =|5\\cdot 5-\\sqrt{2}\\cdot 4\\sqrt{2}| \\\\  & =17\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186354304 :knowledge-point/_questions [{:db/id #edb/ref 17592186133951 :knowledge-point/id #uuid "da20ffe7-173b-5fc0-8629-3b9b70222860" :knowledge-point/title "Identifying True Statements About Orthogonal Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bb81d4ca-b624-5bd6-b5d6-8848a582c1a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451851} {:answer/id #uuid "072d8636-45df-522c-a21c-11c80be3c9aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451852}] :answer-field/correct {:answer/id #uuid "072d8636-45df-522c-a21c-11c80be3c9aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451852} :answer-field/id #uuid "2ead3048-fa8d-5561-beeb-c20e86a46f07" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452773} {:answer-field/choices [{:answer/id #uuid "19f8ac0c-f828-5cbe-b1a1-9ac2fe52a581" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451853} {:answer/id #uuid "78608524-9f24-5352-8c0a-c522e7bb20f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451854}] :answer-field/correct {:answer/id #uuid "19f8ac0c-f828-5cbe-b1a1-9ac2fe52a581" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451853} :answer-field/id #uuid "416ea6c4-aa3e-5622-ad1a-5f5c04bbc3f8" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452774} {:answer-field/choices [{:answer/id #uuid "fa1ef54f-6746-5e13-8812-1a43c4af52f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451855} {:answer/id #uuid "258461fb-779d-533f-b3c8-2a096b2dcdc5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451856}] :answer-field/correct {:answer/id #uuid "258461fb-779d-533f-b3c8-2a096b2dcdc5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451856} :answer-field/id #uuid "7bed2a41-9fc5-5095-9e22-bb769fd4e778" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452775}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f6582765-66f3-5651-9e94-833ca793221c" :question/math-academy-id "q-84347" :question/problem "Which of the following statements are true regarding the orthogonal matrix $P?$\n\nSelect all that apply.\n\n- **I.** ${P}^{T}$ is orthogonal\n- **II.** ${P}^{-1}$ is **not** orthogonal\n- **III.** $-P$ is orthogonal" :question/worked-solution "Recall that a matrix $Q$ is orthogonal if and only if\n\n$$\nQ{Q}^{T}={Q}^{T}Q=I.\n$$\n\nTo check that a matrix is orthogonal, it is sufficient to check that the above equation is satisfied.\n\nMoreover, we have the following properties:\n\n- For any orthogonal matrix $Q,$ we have ${Q}^{-1}={Q}^{T}.$\n\n- $(AB)^{T}={B}^{T}{A}^{T}$ for conformable matrices $A$ and $B.$\n\nWith that in mind, let's inspect each of the statements in turn.\n\n- Statement I is true. Computing the product ${P}^{T}\\cdot ({P}^{T})^{T},$ we obtain\n\n$$\n\\begin{aligned}{P}^{T}\\cdot ({P}^{T})^{T} & ={P}^{T}\\cdot P \\\\  & =I.\\end{aligned}\n$$\n\n- Statement II is false. Computing the product ${P}^{-1}\\cdot ({P}^{-1})^{T},$ we obtain\n\n$$\n\\begin{aligned}{P}^{-1}\\cdot ({P}^{-1})^{T} & ={P}^{T}\\cdot ({P}^{T})^{T} \\\\  & ={P}^{T}P \\\\  & =I.\\end{aligned}\n$$\n\n- Statement III is true. Computing the product $(-P)\\cdot (-P)^{T},$ we obtain\n\n$$\n\\begin{aligned}(-P)\\cdot (-P)^{T} & =(-P)\\cdot (-{P}^{T}) \\\\  & =P{P}^{T} \\\\  & =I.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186354335 :knowledge-point/_questions [{:db/id #edb/ref 17592186133949 :knowledge-point/id #uuid "ee00be0e-f6a2-5269-a36d-1eeaf1b32344" :knowledge-point/title "Calculating the Determinant of a Product of Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09afd030-d523-5b84-b318-b7f9daa2d4fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186351650} {:answer/id #uuid "23ce1a71-450b-582b-aba9-d4c9c5378632" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186351892} {:answer/id #uuid "83459103-ad6d-52dd-9171-fbd36f5eccd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "90" :db/id #edb/ref 17592186352714} {:answer/id #uuid "934a1a17-1804-55a3-a25a-8e863d3f52e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "120" :db/id #edb/ref 17592186352843} {:answer/id #uuid "d8935925-a13d-5330-babc-5c8208927e2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "70" :db/id #edb/ref 17592186353448}] :answer-field/correct {:answer/id #uuid "09afd030-d523-5b84-b318-b7f9daa2d4fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186351650} :answer-field/id #uuid "aac9bbfd-da1f-5dc0-a202-5eb96f0371fa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354117}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "821d4670-7f65-59e3-8def-f1e5c07f50f6" :question/math-academy-id "q-84778" :question/problem "$$\nP=[\\begin{aligned}\\frac{4}{\\sqrt{17}} & -\\frac{1}{\\sqrt{17}} \\\\ \\frac{1}{\\sqrt{17}} & \\frac{4}{\\sqrt{17}}\\end{aligned}],\\,Q=[\\begin{aligned}2\\sqrt{7} & \\sqrt{5} \\\\ 4\\sqrt{5} & 5\\sqrt{7}\\end{aligned}]\n$$\n\nFind $|\\text{det}(PQ)|$ given that $P$ is an orthogonal matrix." :question/worked-solution "We use the following facts: \n\n- The determinant of a product is equal to the product of the determinants.\n\n- The determinant of an orthogonal matrix $P$ is equal to $\\pm 1.$\n\nApplying these ideas, we get the following:\n\n$$\n\\begin{aligned}|\\text{det}(PQ)| & =|\\text{det}(P)\\cdot \\text{det}(Q)| \\\\  & =|(\\pm 1)\\cdot \\text{det}(Q)| \\\\  & =|\\pm 1|\\cdot |\\text{det}(Q)| \\\\  & =|\\text{det}(Q)| \\\\  & =|2\\sqrt{7}\\cdot 5\\sqrt{7}-\\sqrt{5}\\cdot 4\\sqrt{5}| \\\\  & =50\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186354337 :knowledge-point/_questions [{:db/id #edb/ref 17592186133950 :knowledge-point/id #uuid "f2a22cfc-9a78-57ab-93a4-3c3255c34bf7" :knowledge-point/title "Calculating the Inverse of an Orthogonal Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09dcffe0-ee7a-5e63-8278-dca38632fe98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\sqrt{10} & -\\sqrt{10} \\\\ \\sqrt{10} & -\\sqrt{10}\\end{aligned}]" :db/id #edb/ref 17592186351652} {:answer/id #uuid "20da2b06-38a4-5f6f-bd3b-23e027784978" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\sqrt{10} & \\sqrt{10} \\\\ -\\sqrt{10} & -\\sqrt{10}\\end{aligned}]" :db/id #edb/ref 17592186351862} {:answer/id #uuid "3c0842ed-cdfa-501d-926c-0f64071688a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{3}{\\sqrt{10}} & -\\frac{1}{\\sqrt{10}} \\\\ \\frac{1}{\\sqrt{10}} & -\\frac{3}{\\sqrt{10}}\\end{aligned}]" :db/id #edb/ref 17592186352124} {:answer/id #uuid "a960c5de-6970-5dbc-9644-409ecdc07fdd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$D$ is not invertible" :db/id #edb/ref 17592186353004} {:answer/id #uuid "effacf4a-06ee-5f96-940d-3f6cb94b7ab3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}} \\\\ -\\frac{1}{\\sqrt{10}} & -\\frac{3}{\\sqrt{10}}\\end{aligned}]" :db/id #edb/ref 17592186353655}] :answer-field/correct {:answer/id #uuid "effacf4a-06ee-5f96-940d-3f6cb94b7ab3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}} \\\\ -\\frac{1}{\\sqrt{10}} & -\\frac{3}{\\sqrt{10}}\\end{aligned}]" :db/id #edb/ref 17592186353655} :answer-field/id #uuid "6417dc6c-e541-5ba1-aeb0-7ae4aea638c6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186353999}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1f1af0b2-5114-5eff-85ec-5880244e7da3" :question/math-academy-id "q-84780" :question/problem "Find the inverse of the orthogonal matrix $D=[\\begin{aligned}-\\frac{3}{\\sqrt{10}} & -\\frac{1}{\\sqrt{10}} \\\\ \\frac{1}{\\sqrt{10}} & -\\frac{3}{\\sqrt{10}}\\end{aligned}].$" :question/worked-solution "The inverse of an orthogonal matrix is equal to its transpose.\n\nTherefore, since $D$ is orthogonal, we have \n\n$$\n\\begin{aligned}{D}^{-1} & ={D}^{T}=[\\begin{aligned}-\\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}} \\\\ -\\frac{1}{\\sqrt{10}} & -\\frac{3}{\\sqrt{10}}\\end{aligned}].\\end{aligned}\n$$"}]}
