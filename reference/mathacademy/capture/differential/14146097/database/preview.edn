t{d}x}{x} \\\\  & =\\sqrt{3}\\int \\frac{1}{u}\\cdot (\\frac{1}{2}\\text{d}u) \\\\  & =\\frac{\\sqrt{3}}{2}\\int \\frac{\\text{d}u}{u} \\\\  & =\\frac{\\sqrt{3}}{2}\\operatorname{ln}⁡|u|+C \\\\  & =\\frac{\\sqrt{3}}{2}\\operatorname{ln}⁡|\\operatorname{ln}⁡({x}^{2})|+C\\end{aligned}\n$$" 13194139534869 17592186045417 true] [17592186441899 1068 #edb/ref 17592186441897 13194139534869 17592186045417 true] [17592186441899 1069 "q-13822" 13194139534869 17592186045417 true] [17592186441899 1070 #edb/ref 17592186045486 13194139534869 17592186045417 true] [17592186441899 1071 "Calculate the integral $\\int \\frac{1}{3x\\operatorname{ln}⁡(3x)}\\,\\text{d}x.$" 13194139534869 17592186045417 true] [17592186441899 1072 #uuid "cc39d04c-8fc6-5458-bd77-d57b514616c4" 13194139534869 17592186045417 true] [17592186441899 1074 "Let's set $u=\\operatorname{ln}⁡(3x).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{3x}\\cdot 3=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{1}{3x\\operatorname{ln}⁡(3x)}\\,\\text{d}x & =\\frac{1}{3}\\int \\frac{1}{\\operatorname{ln}⁡(3x)}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{1}{3}\\int \\frac{1}{u}\\cdot \\text{d}u \\\\  & =\\frac{1}{3}\\int \\frac{1}{u}\\cdot \\text{d}u \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡|u|+C \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡|\\operatorname{ln}⁡(3x)|+C\\end{aligned}\n$$" 13194139534869 17592186045417 true] [17592186441900 1068 #edb/ref 17592186441895 13194139534869 17592186045417 true] [17592186441900 1069 "q-13840" 13194139534869 17592186045417 true] [17592186441900 1070 #edb/ref 17592186045486 13194139534869 17592186045417 true] [17592186441900 1071 "Evaluate the integral ${\\int }_{e}^{{e}^{2}}\\frac{2}{5x\\operatorname{ln}⁡({x}^{2})}\\,\\text{d}x.$" 13194139534869 17592186045417 true] [17592186441900 1072 #uuid "d724ae77-2273-56ab-852e-2415e473e7f8" 13194139534869 17592186045417 true] [17592186441900 1074 "Let's set $u=\\operatorname{ln}⁡({x}^{2}).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{{x}^{2}}\\cdot 2x=\\frac{2}{x}\\,⟹\\,\\frac{1}{2}\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $e$ | ${e}^{2}$ |\n| --- | --- | --- |\n| $u$ | $2$ | $4$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{e}^{{e}^{2}}\\frac{2}{5x\\operatorname{ln}⁡({x}^{2})}\\,\\text{d}x & =\\frac{1}{5}{\\int }_{e}^{{e}^{2}}\\frac{2}{x\\operatorname{ln}⁡({x}^{2})}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{1}{5}{\\int }_{2}^{4}\\frac{2}{u}\\cdot \\frac{1}{2}\\text{d}u \\\\  & =\\frac{1}{5}{\\int }_{2}^{4}\\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{5}(\\operatorname{ln}⁡|u|){|}_{2}^{4} \\\\  & =\\frac{1}{5}(\\operatorname{ln}⁡4-\\operatorname{ln}⁡2) \\\\  & =\\frac{1}{5}(\\operatorname{ln}⁡{2}^{2}-\\operatorname{ln}⁡2) \\\\  & =\\frac{1}{5}(2\\operatorname{ln}⁡2-\\operatorname{ln}⁡2) \\\\  & =\\frac{\\operatorname{ln}⁡2}{5}\\end{aligned}\n$$" 13194139534869 17592186045417 true]] :edb/tempids {"answer-0444227a-dd50-5fbc-9b4c-b746cc7ac5e4" 17592186441874 "answer-0cdc4e41-1390-58a2-bac1-3d5ad6ed32e0" 17592186441875 "answer-13a0a75b-f8ec-54c5-8a7a-c4809a5dfbd1" 17592186441876 "answer-383da31d-fae5-528c-b771-c06390c58c47" 17592186441877 "answer-4403caea-cd74-51a9-b79d-725521c1723f" 17592186441878 "answer-51f5ec9c-cf1f-5d72-a5d8-f8dc65eacd30" 17592186441879 "answer-53d5b4d4-65c5-534f-b5bf-9a4d54b10bf5" 17592186441880 "answer-64a568b0-03ae-50f3-9960-f6a12c2c3edd" 17592186441881 "answer-74dd2751-1a10-5b13-a07e-4a1b5ceee5f6" 17592186441882 "answer-8351c1fb-1f5f-531e-b8d0-f8d53498e7df" 17592186441883 "answer-83e83f58-9225-53a6-8e6a-f42f69406481" 17592186441884 "answer-9773d021-d3dc-5a4f-a413-83c7aabfc9ac" 17592186441885 "answer-9a132687-cf9b-5e12-8918-cb54c98b6670" 17592186441886 "answer-be58a7fb-a086-5860-ad30-dd1c817fbd59" 17592186441887 "answer-d0c5c72a-52a6-527f-9089-d3