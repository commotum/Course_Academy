log}_{5}⁡x}{x}\\,\\text{d}x & =\\int {log}_{5}⁡x\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\int u\\cdot \\operatorname{ln}⁡5\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡5\\int u\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡5\\cdot \\frac{{u}^{2}}{2}+C \\\\  & =\\operatorname{ln}⁡5\\cdot \\frac{{log}_{5}^{2}⁡x}{2}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297532 :knowledge-point/_questions [{:db/id #edb/ref 17592186100818 :knowledge-point/id #uuid "37a7aff6-d1b2-5383-bb26-aa6363594b05" :knowledge-point/title "Evaluating Definite Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c47da02-0de3-57ba-80b0-c125c05b20e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡5}{3}" :db/id #edb/ref 17592186295525} {:answer/id #uuid "4c228dda-3c12-503a-ae76-b6dbd65e3cfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\operatorname{ln}⁡3}{2\\sqrt{5}}" :db/id #edb/ref 17592186295701} {:answer/id #uuid "710ae787-1902-5217-9c26-724daf023aa9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{21\\operatorname{ln}⁡5}{2}" :db/id #edb/ref 17592186295887} {:answer/id #uuid "cb2d8a19-1869-5d11-b6b2-5d7224310807" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{33\\operatorname{ln}⁡5}{\\sqrt{5}}" :db/id #edb/ref 17592186296333} {:answer/id #uuid "fe9d3052-96a7-52e6-88ad-4c8dcf860d47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{31\\operatorname{ln}⁡5}{\\sqrt{5}}" :db/id #edb/ref 17592186296624}] :answer-field/correct {:answer/id #uuid "710ae787-1902-5217-9c26-724daf023aa9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{21\\operatorname{ln}⁡5}{2}" :db/id #edb/ref 17592186295887} :answer-field/id #uuid "d0467277-3365-50ac-9fc9-dd5fec40a456" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297066}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7168c66b-e063-53c6-92aa-cf6372184dec" :question/math-academy-id "q-31669" :question/problem "What is the value of ${\\int }_{1}^{5}\\frac{7{log}_{5}⁡(5x)}{x}\\,\\text{d}x?$" :question/worked-solution "Let $u={log}_{5}⁡(5x).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{5x\\operatorname{ln}⁡5}\\cdot 5=\\frac{1}{x\\operatorname{ln}⁡5}\\,⟹\\,\\operatorname{ln}⁡5\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $1$ | $5$ |\n| --- | --- | --- |\n| $u$ | $1$ | $2$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{5}\\frac{7{log}_{5}⁡(5x)}{x}\\,\\text{d}x & =7{\\int }_{1}^{5}{log}_{5}⁡(5x)\\cdot \\frac{\\text{d}x}{x} \\\\  & =7{\\int }_{1}^{2}u\\cdot \\operatorname{ln}⁡5\\,\\text{d}u \\\\  & =7\\operatorname{ln}⁡5{\\int }_{1}^{2}u\\,\\text{d}u \\\\  & =7\\operatorname{ln}⁡5\\cdot \\frac{{u}^{2}}{2}{|}_{1}^{2} \\\\  & =7\\operatorname{ln}⁡5\\cdot (\\frac{4}{2}-\\frac{1}{2}) \\\\  & =\\frac{21\\operatorname{ln}⁡5}{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186320814 :knowledge-point/_questions [{:db/id #edb/ref 17592186100818 :knowledge-point/id #uuid "37a7aff6-d1b2-5383-bb26-aa6363594b05" :knowledge-point/title "Evaluating Definite Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a8a2fb3-0f4b-5fe7-ab34-cb4b95eae8e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}\\operatorname{ln}3" :db/id #edb/ref 17592186319418} {:answer/id #uuid "0444227a-dd50-5fbc-9b4c-b746cc7ac5e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}\\ln 3" :db/id #edb/ref 17592186441874}] :answer-field/correct {:answer/id #uuid "0444227a-dd50-5fbc-9b4c-b746cc7ac5e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}\\ln 3" :db/id #edb/ref 17592186441874} :answer-field/id #uuid "d8924e9a-12d1-532a-9e9e-b8791083cc33" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320609}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "353ff421-65f8-59eb-b8ea-71a83d1ce946" :question/math-academy-id "q-351287" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{5}^{125}\\frac{8}{3x{log}_{5}⁡({x}^{2})}\\,\\text{d}x=($\n{{field-1}}\n$)\\,\\operatorname{ln}⁡5$" :question/worked-solution "Let $u={log}_{5}⁡({x}^{2}).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{{x}^{2}\\operatorname{ln}⁡5}\\cdot 2x=\\frac{2}{x\\operatorname{ln}⁡5}\\,⟹\\,\\frac{\\operatorname{ln}⁡5}{2}\\cdot \\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $5$ | $125$ |\n| --- | --- | --- |\n| $u$ | $2$ | $6$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{5}^{125}\\frac{8}{3x{log}_{5}⁡({x}^{2})}\\,\\text{d}x & =\\frac{8}{3}{\\int }_{5}^{125}\\frac{1}{{log}_{5}⁡({x}^{2})}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{8}{3}{\\int }_{2}^{6}\\frac{1}{u}\\cdot \\frac{\\operatorname{ln}⁡5}{2}\\,\\text{d}u \\\\  & =\\frac{4\\operatorname{ln}⁡5}{3}{\\int }_{2}^{6}\\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{4\\operatorname{ln}⁡5}{3}(\\operatorname{ln}⁡|u|){|}_{2}^{6} \\\\  & =\\frac{4\\operatorname{ln}⁡5}{3}(\\operatorname{ln}⁡6-\\operatorname{ln}⁡2) \\\\  & =\\frac{4\\operatorname{ln}⁡5}{3}\\operatorname{ln}⁡3 \\\\  & =(\\frac{4}{3}\\operatorname{ln}⁡3)\\operatorname{ln}⁡5\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186101535 :knowledge-point/_questions [{:db/id #edb/ref 17592186100818 :knowledge-point/id #uuid "37a7aff6-d1b2-5383-bb26-aa6363594b05" :knowledge-point/title "Evaluating Definite Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13a0a75b-f8ec-54c5-8a7a-c4809a5dfbd1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{ln}^{2}⁡2" :db/id #edb/ref 17592186441876} {:answer/id #uuid "64a568b0-03ae-50f3-9960-f6a12c2c3edd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡2" :db/id #edb/ref 17592186441881} {:answer/id #uuid "8351c1fb-1f5f-531e-b8d0-f8d53498e7df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{ln}^{2}⁡2}{2}" :db/id #edb/ref 17592186441883} {:answer/id #uuid "9773d021-d3dc-5a4f-a413-83c7aabfc9ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2" :db/id #edb/ref 17592186441885} {:answer/id #uuid "e68587f4-8c6a-5209-a952-e474e449105e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\operatorname{ln}⁡2" :db/id #edb/ref 17592186441892}] :answer-field/correct {:answer/id #uuid "13a0a75b-f8ec-54c5-8a7a-c4809a5dfbd1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{ln}^{2}⁡2" :db/id #edb/ref 17592186441876} :answer-field/id #uuid "ff77337b-c76b-58b6-bf25-fc16e01ca583" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186100371}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d5cc7305-f37c-53f7-a090-f87a05c29da3" :question/math-academy-id "q-73654" :question/problem "What is the value of ${\\int }_{2}^{4}\\frac{4}{x{log}_{2}⁡x}\\,\\text{d}x?$" :question/worked-solution "Let $u={log}_{2}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡2}\\,⟹\\,\\operatorname{ln}⁡2\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $2$ | $4$ |\n| --- | --- | --- |\n| $u$ | $1$ | $2$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{2}^{4}\\frac{4}{x{log}_{2}⁡x}\\,\\text{d}x & =4{\\int }_{2}^{4}\\frac{1}{{log}_{2}⁡x}\\cdot \\frac{\\text{d}x}{x} \\\\  & =4{\\int }_{1}^{2}\\frac{1}{u}\\cdot \\operatorname{ln}⁡2\\,\\text{d}u \\\\  & =4\\operatorname{ln}⁡2{\\int }_{1}^{2}\\frac{1}{u}\\,\\text{d}u \\\\  & =4\\operatorname{ln}⁡2(\\operatorname{ln}⁡|u|){|}_{1}^{2} \\\\  & =4\\operatorname{ln}⁡2\\cdot (\\operatorname{ln}⁡2-\\operatorname{ln}⁡1) \\\\  & =4{ln}^{2}⁡2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186342052 :knowledge-point/_questions [{:db/id #edb/ref 17592186100818 :knowledge-point/id #uuid "37a7aff6-d1b2-5383-bb26-aa6363594b05" :knowledge-point/title "Evaluating Definite Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2eafeb14-c8c5-545b-a26c-84a8ffdb3bb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{\\operatorname{ln}⁡8}" :db/id #edb/ref 17592186339540} {:answer/id #uuid "31f0df20-fa82-5df5-ac98-2f11e0f712be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡8" :db/id #edb/ref 17592186339567} {:answer/id #uuid "453ac55b-b5ef-5bd9-ab47-2d658db0c581" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}\\,\\operatorname{ln}⁡8" :db/id #edb/ref 17592186339742} {:answer/id #uuid "66afc99b-c4df-5906-b1f4-1abfb6ca13c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2(\\sqrt{2}-1)\\operatorname{ln}⁡8" :db/id #edb/ref 17592186340031} {:answer/id #uuid "997973b5-0aa4-5755-be92-64594db4e075" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1-\\sqrt{2})\\operatorname{ln}⁡8" :db/id #edb/ref 17592186340513}] :answer-field/correct {:answer/id #uuid "66afc99b-c4df-5906-b1f4-1abfb6ca13c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2(\\sqrt{2}-1)\\operatorname{ln}⁡8" :db/id #edb/ref 17592186340031} :answer-field/id #uuid "246f92ed-b4b3-5d28-a1bf-1d986ab28138" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341443}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3ddbff7e-d3cb-563f-8731-6916af8ccc56" :question/math-academy-id "q-73656" :question/problem "What is the value of ${\\int }_{8}^{64}\\frac{1}{x\\sqrt{{log}_{8}⁡x}}\\,\\text{d}x?$" :question/worked-solution "Let $u={log}_{8}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡8}\\,⟹\\,\\operatorname{ln}⁡8\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $8$ | $64$ |\n| --- | --- | --- |\n| $u$ | $1$ | $2$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{8}^{64}\\frac{1}{x\\sqrt{{log}_{8}⁡x}}\\,\\text{d}x & ={\\int }_{8}^{64}\\frac{1}{\\sqrt{{log}_{8}⁡x}}\\cdot \\frac{\\text{d}x}{x} \\\\  & ={\\int }_{1}^{2}\\frac{1}{\\sqrt{u}}\\cdot \\operatorname{ln}⁡8\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡8{\\int }_{1}^{2}\\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡8(2\\sqrt{u}){|}_{1}^{2} \\\\  & =2\\operatorname{ln}⁡8(\\sqrt{2}-\\sqrt{1}) \\\\  & =2(\\sqrt{2}-1)\\operatorname{ln}⁡8\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186101536 :knowledge-point/_questions [{:db/id #edb/ref 17592186100817 :knowledge-point/id #uuid "fa28f5c4-135e-576a-baa0-68c41b5139f6" :knowledge-point/title "Integrating Functions Containing Other Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "383be394-a41f-5e0f-b93b-a0ff9878be08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡{x}^{7}\\operatorname{ln}⁡|{log}_{7}⁡(4x)|+C" :db/id #edb/ref 17592186339635} {:answer/id #uuid "750a3dcf-e361-507f-ad62-9dbb75727d78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡4\\operatorname{ln}⁡|{log}_{7}⁡x|+C" :db/id #edb/ref 17592186340176} {:answer/id #uuid "aa31712a-2e4f-527b-a00c-e331135a4450" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡7}{7}\\operatorname{ln}⁡|{log}_{7}⁡(4x)|+C" :db/id #edb/ref 17592186340682} {:answer/id #uuid "dc05d22a-2a20-518f-afa3-1ccc9267a967" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\operatorname{ln}⁡7\\operatorname{ln}⁡|{log}_{7}⁡({x}^{4})|+C" :db/id #edb/ref 17592186341082} {:answer/id #uuid "e0868377-7786-5248-883a-b568427cad5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡7\\operatorname{ln}⁡|{log}_{7}⁡(4x)|+C" :db/id #edb/ref 17592186341122}] :answer-field/correct {:answer/id #uuid "e0868377-7786-5248-883a-b568427cad5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡7\\operatorname{ln}⁡|{log}_{7}⁡(4x)|+C" :db/id #edb/ref 17592186341122} :answer-field/id #uuid "aff887c8-fb12-5cba-942f-5f6c84cf518a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341687}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "15940cb6-48bb-51bb-99eb-a693e64f76c1" :question/math-academy-id "q-73659" :question/problem "$\\int \\frac{1}{x{log}_{7}⁡(4x)}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{7}⁡(4x).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡7}\\,⟹\\,\\operatorname{ln}⁡7\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{1}{x{log}_{7}⁡(4x)}\\,\\text{d}x & =\\int \\frac{1}{{log}_{7}⁡(4x)}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\int \\frac{1}{u}\\cdot \\operatorname{ln}⁡7\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡7\\int \\frac{1}{u}\\cdot \\text{d}u \\\\  & =\\operatorname{ln}⁡7\\operatorname{ln}⁡|u|+C \\\\  & =\\operatorname{ln}⁡7\\operatorname{ln}⁡|{log}_{7}⁡(4x)|+C\\end{aligned}\n$$"}]}
