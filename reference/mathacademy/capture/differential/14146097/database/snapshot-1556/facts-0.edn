045417] [17592186268651 #edb/ref 1075 #edb/ref 17592186266781 #edb/ref 17592186045417] [17592186268651 #edb/ref 1075 #edb/ref 17592186267447 #edb/ref 17592186045417] [17592186268651 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186268651 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186268651 #edb/ref 1078 #edb/ref 17592186266471 #edb/ref 17592186045417] [17592186268651 #edb/ref 1079 #uuid "89bcc82a-73ac-56e2-ab50-09b7c5de2e1c" #edb/ref 17592186045417] [17592186268767 #edb/ref 1075 #edb/ref 17592186266302 #edb/ref 17592186045417] [17592186268767 #edb/ref 1075 #edb/ref 17592186266551 #edb/ref 17592186045417] [17592186268767 #edb/ref 1075 #edb/ref 17592186267474 #edb/ref 17592186045417] [17592186268767 #edb/ref 1075 #edb/ref 17592186267708 #edb/ref 17592186045417] [17592186268767 #edb/ref 1075 #edb/ref 17592186268265 #edb/ref 17592186045417] [17592186268767 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186268767 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186268767 #edb/ref 1078 #edb/ref 17592186268265 #edb/ref 17592186045417] [17592186268767 #edb/ref 1079 #uuid "c87b8c31-bac0-55a7-9f5f-8efffda69a26" #edb/ref 17592186045417] [17592186269163 #edb/ref 1068 #edb/ref 17592186268767 #edb/ref 17592186045417] [17592186269163 #edb/ref 1069 "q-13803" #edb/ref 17592186045417] [17592186269163 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186269163 #edb/ref 1071 "Calculate the integral $\\int \\frac{\\operatorname{ln}⁡x}{2x}\\,\\text{d}x.$" #edb/ref 17592186045417] [17592186269163 #edb/ref 1072 #uuid "b8d94a83-3a6d-514a-949b-8d2d5e661234" #edb/ref 17592186045417] [17592186269163 #edb/ref 1074 "Let's set $u=\\operatorname{ln}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{\\operatorname{ln}⁡x}{2x}\\,\\text{d}x & =\\frac{1}{2}\\int \\operatorname{ln}⁡x\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{1}{2}\\int u\\,\\text{d}u \\\\  & =\\frac{1}{2}\\cdot \\frac{{u}^{2}}{2}+C \\\\  & =\\frac{1}{4}{u}^{2}+C \\\\  & =\\frac{1}{4}{ln}^{2}⁡x+C\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186269169 #edb/ref 1068 #edb/ref 17592186268651 #edb/ref 17592186045417] [17592186269169 #edb/ref 1069 "q-13807" #edb/ref 17592186045417] [17592186269169 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186269169 #edb/ref 1071 "Calculate the integral $\\int \\frac{\\operatorname{ln}⁡({x}^{2})}{3x}\\,\\text{d}x.$" #edb/ref 17592186045417] [17592186269169 #edb/ref 1072 #uuid "6641fae0-7624-5b24-b01b-edaaed427bd0" #edb/ref 17592186045417] [17592186269169 #edb/ref 1074 "Let's set $u=\\operatorname{ln}⁡({x}^{2}).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{{x}^{2}}\\cdot 2x=\\frac{2}{x}\\,⟹\\,\\frac{1}{2}\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{\\operatorname{ln}⁡({x}^{2})}{3x}\\,\\text{d}x & =\\frac{1}{3}\\int \\operatorname{ln}⁡({x}^{2})\\cdot \\frac{\\text{d}x}{x}\\cdot  \\\\  & =\\frac{1}{3}\\int u\\cdot (\\frac{1}{2}\\text{d}u) \\\\  & =\\frac{1}{6}\\int u\\,\\text{d}u \\\\  & =\\frac{1}{6}\\cdot \\frac{{u}^{2}}{2}+C \\\\  & =\\frac{1}{12}{u}^{2}+C \\\\  & =\\frac{1}{12}{ln}^{2}⁡({x}^{2})+C\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186269173 #edb/ref 1068 #edb/ref 17592186268486 #edb/ref 17592186045417] [17592186269173 #edb/ref 1069 "q-13808" #edb/ref 17592186045417] [17592186269173 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186269173 #edb/ref 1071 "Calculate the integral $\\int \\frac{5}{x\\operatorname{ln}⁡({x}^{2})}\\,\\text{d}x.$" #edb/ref 17592186045417] [17592186269173 #edb/ref 1072 #uuid "78bb1805-2714-583b-b597-4f74cc851968" #edb/ref 17592186045417] [17592186269173 #edb/ref 1074 "Let's set $u=\\operatorname{ln}⁡({x}^{2}).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{{x}^{2}}\\cdot 2x=\\frac{2}{x}\\,⟹\\,\\frac{1}{2}\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{5}{x\\operatorname{ln}⁡({x}^{2})}\\,\\text{d}x & =5\\int \\frac{1}{\\operatorname{ln}⁡({x}^{2})}\\cdot \\frac{\\text{d}x}{x} \\\\  & =5\\int \\frac{1}{u}\\cdot (\\frac{1}{2}\\text{d}u) \\\\  & =\\frac{5}{2}\\int \\frac{1}{u}\\cdot \\text{d}u \\\\  & =\\frac{5}{2}\\operatorname{ln}⁡|u|+C \\\\  & =\\frac{5}{2}\\operatorname{ln}⁡|\\operatorname{ln}⁡({x}^{2})|+C\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186288408 #edb/ref 1080 "3\\operatorname{ln}⁡|{log}_{3}⁡(2x)|+C" #edb/ref 17592186045417] [17592186288408 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186288408 #edb/ref 1083 #uuid "3783aaf0-95fe-582e-9b6c-214d1b88d33f" #edb/ref 17592186045417] [17592186288410 #edb/ref 1080 "3\\operatorname{ln}⁡3\\operatorname{ln}⁡|{log}_{3}⁡(2x)|+C" #edb/ref 17592186045417] [17592186288410 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186288410 #edb/ref 1083 #uuid "37ab6ab5-1c0e-58f5-b386-e76cdaa7443e" #edb/ref 17592186045417] [17592186288570 #edb/ref 1080 "2\\operatorname{ln}⁡|{log}_{3}⁡(2x)|+C" #edb/ref 17592186045417] [17592186288570 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186288570 #edb/ref 1083 #uuid "4d666098-aa58-56fe-865c-a47cdc80ed88" #edb/ref 17592186045417] [17592186289286 #edb/ref 1080 "3\\operatorname{ln}⁡3|{log}_{3}⁡(2x)|+C" #edb/ref 17592186045417] [17592186289286 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186289286 #edb/ref 1083 #uuid "be835456-2ece-556e-a15f-dfc8e8723b39" #edb/ref 17592186045417] [17592186289618 #edb/ref 1080 "3\\operatorname{ln}⁡3\\operatorname{ln}⁡|\\operatorname{ln}⁡(3x)|+C" #edb/ref 17592186045417] [17592186289618 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 1759218604