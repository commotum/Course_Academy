e/math} :answer/value "(3,-2)" :db/id #edb/ref 17592186366326} {:answer/id #uuid "529700ce-3041-542b-a47f-8b4d5038e431" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,-4)" :db/id #edb/ref 17592186366327} {:answer/id #uuid "e690d78b-7982-545a-9d99-2af83a064739" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4,1)" :db/id #edb/ref 17592186366328} {:answer/id #uuid "3328dce2-d0a7-58f6-8063-8c0e2808c74d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,4)" :db/id #edb/ref 17592186366329}] :answer-field/correct {:answer/id #uuid "529700ce-3041-542b-a47f-8b4d5038e431" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,-4)" :db/id #edb/ref 17592186366327} :answer-field/id #uuid "ba745298-dd2a-56a7-9fe5-4138626a285a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366324}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "801e2c36-b0ba-5a56-b56f-a1984ab99d04" :question/math-academy-id "q-78862" :question/problem "What is the center of the hyperbola $\\frac{(x-1)^{2}}{3}-\\frac{(y+4)^{2}}{2}=1?$" :question/worked-solution "The equation of a horizontal hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\nNote that the given equation can be rewritten as follows:\n\n$$\n\\frac{(x-1)^{2}}{3}-\\frac{(y-(-4))^{2}}{2}=1\n$$\n\nIn this case, $h=1$ and $k=-4.$\n\nTherefore, the center of the hyperbola is $(1,-4).$"}] [{:db/id #edb/ref 17592186348120 :knowledge-point/_questions [{:db/id #edb/ref 17592186083206 :knowledge-point/id #uuid "345d6df7-2ada-5c2e-8146-7c779afae3af" :knowledge-point/title "Finding the Center of a Vertical Hyperbola Given an Equation in Expanded Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37ecae1f-503f-5d28-b991-def30c6c834c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,3)" :db/id #edb/ref 17592186345831} {:answer/id #uuid "5d4868ba-d697-53e5-9373-5a632592fe8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,-1)" :db/id #edb/ref 17592186346149} {:answer/id #uuid "6a540d93-f7a3-594f-bbdd-251c07da13f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,-2)" :db/id #edb/ref 17592186346272} {:answer/id #uuid "740c5507-984b-59d3-a844-c3d2738d6dcd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,1)" :db/id #edb/ref 17592186346374} {:answer/id #uuid "9b8bc9bb-323d-5fc2-bdb0-1f458e354f7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,-2)" :db/id #edb/ref 17592186346707}] :answer-field/correct {:answer/id #uuid "5d4868ba-d697-53e5-9373-5a632592fe8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,-1)" :db/id #edb/ref 17592186346149} :answer-field/id #uuid "6ce4ebf2-93c2-5d7a-975d-264b63cfbb01" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347801}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a9b997d7-b865-58ce-9db2-0ee1ca090b52" :question/math-academy-id "q-78877" :question/problem "What is the center of the hyperbola \n$-2{x}^{2}+{y}^{2}-8x+2y=13?$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in the above form, we need to group $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}-2{x}^{2}+{y}^{2}-8x+2y & =13 \\\\ {y}^{2}+2y-2{x}^{2}-8x & =13 \\\\ {y}^{2}+2y-2[{x}^{2}+4x] & =13 \\\\ (y+1)^{2}-1-2[(x+2)^{2}-4] & =13 \\\\ (y+1)^{2}-1-2(x+2)^{2}+8 & =13 \\\\ (y+1)^{2}-2(x+2)^{2} & =13+1-8 \\\\ (y+1)^{2}-2(x+2)^{2} & =6 \\\\ \\frac{(y+1)^{2}}{6}-\\frac{(x+2)^{2}}{3} & =1.\\end{aligned}\n$$\n\nHence, the center is $(-2,-1).$"}]}
