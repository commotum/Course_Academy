-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301961}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a38cb36d-c0e0-5001-b269-6ab08e9aaaff" :question/math-academy-id "q-328317" :question/problem "The center of the hyperbola $\\frac{{y}^{2}}{49}-\\frac{(x-3)^{2}}{81}=1$ is$\\,\\,($\n{{field-1}}$,$\n{{field-2}}\n$).$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nNote that the given equation can be rewritten as follows:\n\n$$\n\\frac{{y}^{2}}{{7}^{2}}-\\frac{(x-3)^{2}}{{9}^{2}}=1\n$$\n\nIn this case, we have $h=3$ and $k=0.$\n\nTherefore, the center of the hyperbola is $(\\,3,0\\,).$"}] [{:db/id #edb/ref 17592186506519 :knowledge-point/_questions [{:db/id #edb/ref 17592186083299 :knowledge-point/id #uuid "223e29c9-1bb5-51ee-9ec8-4d5c15363951" :knowledge-point/title "Finding the Center of a Horizontal Hyperbola Given an Equation in Expanded Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "96faa176-ccfe-57bf-bfcf-8b276f20c9b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186506171}] :answer-field/correct {:answer/id #uuid "96faa176-ccfe-57bf-bfcf-8b276f20c9b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186506171} :answer-field/id #uuid "065502a1-574d-5373-972e-9dd301a59a4c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186506380} {:answer-field/choices [{:answer/id #uuid "e2982ec7-0583-500f-aa4a-26911988ff2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186506327}] :answer-field/correct {:answer/id #uuid "e2982ec7-0583-500f-aa4a-26911988ff2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186506327} :answer-field/id #uuid "5f97af8f-a6f7-5f84-8ea4-e2d8f6e9746e" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186506417}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1b9ba30c-75b9-548b-bbd4-b9dfefeaa769" :question/math-academy-id "q-328381" :question/problem "The center of the hyperbola ${x}^{2}-4{y}^{2}+6x+8y=-1$ is$\\,\\,($\n{{field-1}}$,$\n{{field-2}}\n$).$" :question/worked-solution "The equation of a horizontal hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in standard form, we need to group $x$ and $y$ terms and complete the squares as follows:\n\n$$\n\\begin{aligned}{x}^{2}-4{y}^{2}+6x+8y & =-1 \\\\ {x}^{2}+6x\\,-\\,4{y}^{2}+8y & =-1 \\\\ [{x}^{2}+6x]\\,-\\,4[{y}^{2}-2y] & =-1 \\\\ [(x+3)^{2}-9]\\,-\\,4[(y-1)^{2}-1] & =-1 \\\\ (x+3)^{2}-9\\,-\\,4(y-1)^{2}+4 & =-1 \\\\ (x+3)^{2}-4(y-1)^{2} & =-1+9-4 \\\\ (x+3)^{2}-4(y-1)^{2} & =4 \\\\ \\frac{(x-(-3))^{2}}{{2}^{2}}-\\frac{(y-1)^{2}}{{1}^{2}} & =1\\end{aligned}\n$$\n\nHence, the center of the hyperbola is $(\\,-3,1\\,).$"}] [{:db/id #edb/ref 17592186506553 :knowledge-point/_questions [{:db/id #edb/ref 17592186083299 :knowledge-point/id #uuid "223e29c9-1bb5-51ee-9ec8-4d5c15363951" :knowledge-point/title "Finding the Center of a Horizontal Hyperbola Given an Equation in Expanded Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ff9124c7-b114-5a38-abe7-dc0211821f70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186506378}] :answer-field/correct {:answer/id #uuid "ff9124c7-b114-5a38-abe7-dc0211821f70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186506378} :answer-field/id #uuid "98d7e53f-69e5-5fd8-9fe2-42e2ea31cb75" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186506450} {:answer-field/choices [{:answer/id #uuid "4d289631-68ae-5161-bbf9-82623fa351a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186506043}] :answer-field/correct {:answer/id #uuid "4d289631-68ae-5161-bbf9-82623fa351a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186506043} :answer-field/id #uuid "fdfbe9d8-ba4d-594f-9b79-9657cca29157" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186506508}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7859a933-e507-551f-80d6-253f1a99b7af" :question/math-academy-id "q-328386" :question/problem "The center of the hyperbola ${x}^{2}-4{y}^{2}-10x=-1$ is$\\,\\,($\n{{field-1}}$,$\n{{field-2}}\n$).$" :question/worked-solution "The equation of a horizontal hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in standard form, we need to group $x$ and $y$ terms and complete the squares as follows:\n\n$$\n\\begin{aligned}{x}^{2}-4{y}^{2}-10x & =-1 \\\\ {x}^{2}-10x-4{y}^{2} & =-1 \\\\ [{x}^{2}-10x]-4{y}^{2} & =-1 \\\\ [(x-5)^{2}-25]-4{y}^{2} & =-1 \\\\ (x-5)^{2}-25-4{y}^{2} & =-1 \\\\ (x-5)^{2}-4{y}^{2} & =-1+25 \\\\ (x-5)^{2}-4{y}^{2} & =24 \\\\ \\frac{(x-5)^{2}}{24}-\\frac{{y}^{2}}{6} & =1\\end{aligned}\n$$\n\nHence, the center of the hyperbola is $(\\,5,0\\,).$"}] [{:db/id #edb/ref 17592186302444 :knowledge-point/_questions [{:db/id #edb/ref 17592186083206 :knowledge-point/id #uuid "345d6df7-2ada-5c2e-8146-7c779afae3af" :knowledge-point/title "Finding the Center of a Vertical Hyperbola Given an Equation in Expanded Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a5810b4-ca85-5c7e-a9fc-58e4df87a7ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186300243}] :answer-field/correct {:answer/id #uuid "3a5810b4-ca85-5c7e-a9fc-58e4df87a7ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186300243} :answer-field/id #uuid "0f2a5382-ea17-5843-a92f-c7df2fb5dccd" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301274} {:answer-field/choices [{:answer/id #uuid "f2bfcc51-e77e-5489-87c0-5d48b98f06f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186301159}] :answer-field/correct {:answer/id #uuid "f2bfcc51-e77e-5489-87c0-5d48b98f06f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186301159} :answer-field/id #uuid "48e25f6e-a392-562d-9f6e-ba45ff4f97d0" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301473}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "937b8770-6fd6-5e2a-a6a3-e0d265d81c6d" :question/math-academy-id "q-328401" :question/problem "The center of the hyperbola $16{y}^{2}-25{x}^{2}+96y=256$ is$\\,\\,($\n{{field-1}}$,$\n{{field-2}}\n$).$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in the above form, we need to group $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}16{y}^{2}-25{x}^{2}+96y & =256 \\\\ 16{y}^{2}+96y\\,-\\,25{x}^{2} & =256 \\\\ 16[{y}^{2}+6y]\\,-\\,25{x}^{2} & =256 \\\\ 16[(y+3)^{2}-9]\\,-\\,25{x}^{2} & =256 \\\\ 16(y+3)^{2}-144\\,-\\,25{x}^{2} & =256 \\\\ 16(y+3)^{2}-25{x}^{2} & =256+144 \\\\ 16(y+3)^{2}-25{x}^{2} & =400 \\\\ \\frac{(y+3)^{2}}{25}-\\frac{{x}^{2}}{16} & =1 \\\\ \\frac{(y-(-3))^{2}}{25}-\\frac{{x}^{2}}{16} & =1\\end{aligned}\n$$\n\nHence, the center of the hyperbola is $(\\,0,-3\\,).$"}] [{:db/id #edb/ref 17592186083931 :knowledge-point/_questions [{:db/id #edb/ref 17592186083298 :knowledge-point/id #uuid "cdab0134-e416-51cf-89fa-73ad4a2c2eb9" :knowledge-point/title "Finding the Center of a Vertical Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9fa64c84-d1cf-51ed-ab94-685452dba6d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,-3)" :db/id #edb/ref 17592186082518} {:answer/id #uuid "ae2c79a9-150f-5318-8256-6ef4a7ab390b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,-1)" :db/id #edb/ref 17592186082519} {:answer/id #uuid "4061c534-434f-5d4e-a89b-411fc3bb2c51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,3)" :db/id #edb/ref 17592186506018} {:answer/id #uuid "4c05ac38-38db-52dd-b117-c6e319b6b30c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,1)" :db/id #edb/ref 17592186506038} {:answer/id #uuid "f0620820-a206-5f5c-b470-2c90a9777f22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,1)" :db/id #edb/ref 17592186506353}] :answer-field/correct {:answer/id #uuid "4c05ac38-38db-52dd-b117-c6e319b6b30c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,1)" :db/id #edb/ref 17592186506038} :answer-field/id #uuid "a853deee-5932-5d06-a167-17ff4c201b5f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186082517}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "63c515a1-8cef-540f-87b0-5e3d90b41dc1" :question/math-academy-id "q-78251" :question/problem "What is the center of the hyperbola $\\frac{(y-1)^{2}}{16}-\\frac{(x-3)^{2}}{4}=1?$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nIn this case, we have $h=3$ and $k=1.$\n\nTherefore, the center of the hyperbola is $(3,1).$"}] [{:db/id #edb/ref 17592186366323 :knowledge-point/_questions [{:db/id #edb/ref 17592186083297 :knowledge-point/id #uuid "f99d4fec-bc58-5a09-9fac-38b46f233489" :knowledge-point/title "Finding the Center of a Horizontal Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "837f44bb-71a2-5af2-9d97-eaee9f6964c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,2)" :db/id #edb/ref 17592186366325} {:answer/id #uuid "b0afad59-bb43-557d-9a98-d044f5826836" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,-2)" :db/id #edb/ref 17592186366326} {:answer/id #uuid "529700ce-3041-542b-a47f-8b4d5038e431" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,-4)" :db/id #edb/ref 17592186366327} {:answer/id #uuid "e690d78b-7982-545a-9d99-2af83a064739" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4,1)" :db/id #edb/ref 17592186366328} {:answer/id #uuid "3328dce2-d0a7-58f6-8063-8c0e2808c74d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,4)" :db/id #edb/ref 17592186366329}] :answer-field/correct {:answer/id #uuid "529700ce-3041-542b-a4