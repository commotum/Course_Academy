e "(0,3)" :db/id #edb/ref 17592186506307} {:answer/id #uuid "f1651bb5-dc36-5ad7-96ac-589cacf28616" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-3)" :db/id #edb/ref 17592186506357}] :answer-field/correct {:answer/id #uuid "dd1b7408-5650-5154-bbf1-2f364160c73c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,3)" :db/id #edb/ref 17592186506307} :answer-field/id #uuid "11c82927-4137-5188-9368-c9232622cf2c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186506385}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "709ee5be-390b-54a4-bcb8-cf4ff120d569" :question/math-academy-id "q-78865" :question/problem "What is the center of the hyperbola $\\frac{(y-3)^{2}}{2}-\\frac{{x}^{2}}{5}=1?$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nNote that the given equation can be rewritten as follows:\n\n$$\n\\frac{(y-3)^{2}}{2}-\\frac{(x-0)^{2}}{5}=1\n$$\n\nIn this case, we have $h=0$ and $k=3.$\n\nTherefore, the center of the hyperbola is $(0,3).$"}] [{:db/id #edb/ref 17592186506599 :knowledge-point/_questions [{:db/id #edb/ref 17592186083299 :knowledge-point/id #uuid "223e29c9-1bb5-51ee-9ec8-4d5c15363951" :knowledge-point/title "Finding the Center of a Horizontal Hyperbola Given an Equation in Expanded Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "370e8aac-e3dc-52c2-b1b7-d38f7e278727" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4,3)" :db/id #edb/ref 17592186506004} {:answer/id #uuid "b32a329c-7ca4-5dbc-837b-7099d56f60a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-3)" :db/id #edb/ref 17592186506238} {:answer/id #uuid "d0d876fd-eabd-5c2c-9a06-965260b97fca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,3)" :db/id #edb/ref 17592186506285} {:answer/id #uuid "e04af06c-2bd3-5b62-b7a5-0d32a71f3110" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,4)" :db/id #edb/ref 17592186506315} {:answer/id #uuid "fb58d9cd-56b4-50de-819a-a955c7247882" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,0)" :db/id #edb/ref 17592186506373}] :answer-field/correct {:answer/id #uuid "d0d876fd-eabd-5c2c-9a06-965260b97fca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,3)" :db/id #edb/ref 17592186506285} :answer-field/id #uuid "30a0789d-3435-597e-a492-e9d05f715a85" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186506403}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ec84be9a-d1c8-5ef5-8c9c-eaa63d5e60df" :question/math-academy-id "q-78873" :question/problem "What is the center of the hyperbola \n$4{x}^{2}-3{y}^{2}+18y=39?$" :question/worked-solution "The equation of a horizontal hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in the above form, we need to group $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}4{x}^{2}-3{y}^{2}+18y & =39 \\\\ 4{x}^{2}-3[{y}^{2}-6y] & =39 \\\\ 4{x}^{2}-3[(y-3)^{2}-9] & =39 \\\\ 4{x}^{2}-3(y-3)^{2}+27 & =39 \\\\ 4{x}^{2}-3(y-3)^{2} & =12 \\\\ \\frac{{x}^{2}}{3}-\\frac{(y-3)^{2}}{4} & =1.\\end{aligned}\n$$\n\nTherefore, the center is $(0,3).$"}] [{:db/id #edb/ref 17592186348120 :knowledge-point/_questions [{:db/id #edb/ref 17592186083206 :knowledge-point/id #uuid "345d6df7-2ada-5c2e-8146-7c779afae3af" :knowledge-point/title "Finding the Center of a Vertical Hyperbola Given an Equation in Expanded Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37ecae1f-503f-5d28-b991-def30c6c834c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,3)" :db/id #edb/ref 17592186345831} {:answer/id #uuid "5d4868ba-d697-53e5-9373-5a632592fe8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,-1)" :db/id #edb/ref 17592186346149} {:answer/id #uuid "6a540d93-f7a3-594f-bbdd-251c07da13f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,-2)" :db/id #edb/ref 17592186346272} {:answer/id #uuid "740c5507-984b-59d3-a844-c3d2738d6dcd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,1)" :db/id #edb/ref 17592186346374} {:answer/id #uuid "9b8bc9bb-323d-5fc2-bdb0-1f458e354f7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,-2)" :db/id #edb/ref 17592186346707}] :answer-field/correct {:answer/id #uuid "5d4868ba-d697-53e5-9373-5a632592fe8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,-1)" :db/id #edb/ref 17592186346149} :answer-field/id #uuid "6ce4ebf2-93c2-5d7a-975d-264b63cfbb01" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347801}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a9b997d7-b865-58ce-9db2-0ee1ca090b52" :question/math-academy-id "q-78877" :question/problem "What is the center of the hyperbola \n$-2{x}^{2}+{y}^{2}-8x+2y=13?$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in the above form, we need to group $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}-2{x}^{2}+{y}^{2}-8x+2y & =13 \\\\ {y}^{2}+2y-2{x}^{2}-8x & =13 \\\\ {y}^{2}+2y-2[{x}^{2}+4x] & =13 \\\\ (y+1)^{2}-1-2[(x+2)^{2}-4] & =13 \\\\ (y+1)^{2}-1-2(x+2)^{2}+8 & =13 \\\\ (y+1)^{2}-2(x+2)^{2} & =13+1-8 \\\\ (y+1)^{2}-2(x+2)^{2} & =6 \\\\ \\frac{(y+1)^{2}}{6}-\\frac{(x+2)^{2}}{3} & =1.\\end{aligned}\n$$\n\nHence, the center is $(-2,-1).$"}]}
