#{[{:activity/expected-seconds 840.0 :activity/first-step {:db/id #edb/ref 17592186084094} :activity/id #uuid "15e9c3ff-e3fc-5856-aeb2-d263e77782f8" :activity/scope {:db/id #edb/ref 17592186048866 :topic/id #uuid "c7b52193-6d93-5bed-93f0-854df4061118" :topic/math-academy-id 733} :activity/steps [{:db/id #edb/ref 17592186084094 :step/content {:db/id #edb/ref 17592186084441 :tutorial/content "The **general standard equation** of a hyperbola centered at $(h, k)$ has two forms.\n\n- The equation for a horizontal hyperbola is given by\n\n$$\n\\dfrac {(x - h)^2} {a^2} - \\dfrac {(y - k)^2} {b^2} = 1.\n$$\n\n![](images/86/86896528522f859d4809e922a52e03244fb5279248093dddf302d730e9a542e5.png)\n\n- The equation for a vertical hyperbola is given by\n\n$$\n\\dfrac {(y - k)^2} {a^2} - \\dfrac {(x - h)^2} {b^2} = 1.\n$$\n\n![](images/f1/f1b099f7c4bc8b68e55b17dada9038a934c7bad668e0f4de518c603b1ca58f45.png)" :tutorial/id #uuid "d86d9561-74bd-5438-8125-87229308ffb8" :tutorial/math-academy-id 3492 :tutorial/title "Introduction"} :step/id #uuid "46ac143a-d3fe-55bd-a9ec-92a0a60973ef" :step/math-academy-id 19787 :step/next {:db/id #edb/ref 17592186084231}} {:db/id #edb/ref 17592186084095 :step/content {:db/id #edb/ref 17592186083206 :knowledge-point/canonical-example {:db/id #edb/ref 17592186083007 :question/id #uuid "e930a29a-6adf-5aaa-9b44-86dd8d570ae7" :question/math-academy-id "e-5354"} :knowledge-point/id #uuid "345d6df7-2ada-5c2e-8146-7c779afae3af" :knowledge-point/questions [{:db/id #edb/ref 17592186083563} {:db/id #edb/ref 17592186083935} {:db/id #edb/ref 17592186240820} {:db/id #edb/ref 17592186250532} {:db/id #edb/ref 17592186250533} {:db/id #edb/ref 17592186250534} {:db/id #edb/ref 17592186250535} {:db/id #edb/ref 17592186284425} {:db/id #edb/ref 17592186292767} {:db/id #edb/ref 17592186292831} {:db/id #edb/ref 17592186302438} {:db/id #edb/ref 17592186302439} {:db/id #edb/ref 17592186302441} {:db/id #edb/ref 17592186302442} {:db/id #edb/ref 17592186302443} {:db/id #edb/ref 17