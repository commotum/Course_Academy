#{[{:db/id #edb/ref 17592186543557 :knowledge-point/_questions [{:db/id #edb/ref 17592186166746 :knowledge-point/id #uuid "b4b957bc-c1dd-5f7f-820c-8345a3bded2a" :knowledge-point/title "Computing the Variance of a Uniformly Distributed Random Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "063be259-5820-5ee3-a0a9-153a9190b3b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{27}{4}" :db/id #edb/ref 17592186542652} {:answer/id #uuid "168d8c47-f103-5ff2-a22e-8cbcced9dcc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{4}" :db/id #edb/ref 17592186542697} {:answer/id #uuid "49619131-cc7e-5068-b060-d49334625ec4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186542841} {:answer/id #uuid "c3a5cc7a-a7bb-5977-b0ca-f4be409679db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "27" :db/id #edb/ref 17592186543154} {:answer/id #uuid "cc0df2f6-7d00-502e-aec5-aa25d1b1c455" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186543170}] :answer-field/correct {:answer/id #uuid "063be259-5820-5ee3-a0a9-153a9190b3b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{27}{4}" :db/id #edb/ref 17592186542652} :answer-field/id #uuid "48c440fe-ee45-50ad-96dc-aebf71a08eee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543337}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c8776b39-34f7-5d7c-be21-f79bcc825464" :question/math-academy-id "q-130712" :question/problem "Given that $X$ is a random variable such that $X∼U[-8,1],$ find $\\text{Var}[X].$" :question/worked-solution "If the random variable $X$ is distributed uniformly over the interval $[a,b],$ then \n\n$$\n\\text{Var}[X]=\\frac{(b-a)^{2}}{12}.\n$$\n\nIn our case, we have $a=-8$ and $b=1.$ Therefore,\n\n$$\n\\text{Var}[X]=\\frac{(1-(-8))^{2}}{12}=\\frac{81}{12}=\\frac{27}{4}.\n$$"}] [{:db/id #edb/ref 17592186543551 :knowledge-point/_questions [{:db/id #edb/ref 17592186166794 :knowledge-point/id #uuid "edde1bb6-42d9-5b8d-a29b-7fa91711f017" :knowledge-point/title "Computing the Standard Deviation of a Uniformly Distributed Random Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "267ab761-26d7-57dc-8def-97aa5d384c1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.128" :db/id #edb/ref 17592186542738} {:answer/id #uuid "40ad5a30-1983-5ba4-9063-ee1cc2b79f04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.713" :db/id #edb/ref 17592186542815} {:answer/id #uuid "49b53d5f-2296-55f1-9cb6-bf7bb6bfc356" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.581" :db/id #edb/ref 17592186542843} {:answer/id #uuid "55a4d135-b137-503e-9c19-b69e506a0e8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.443" :db/id #edb/ref 17592186542870} {:answer/id #uuid "b372d906-77f5-592d-9cee-5d9413f82f70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.175" :db/id #edb/ref 17592186543107}] :answer-field/correct {:answer/id #uuid "55a4d135-b137-503e-9c19-b69e506a0e8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.443" :db/id #edb/ref 17592186542870} :answer-field/id #uuid "01db84db-d17a-5436-857c-df53b3ee501f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543292}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b5a32830-d248-5fc8-bc7e-b05512cbde4a" :question/math-academy-id "q-130714" :question/problem "Given that $X$ is a random variable such that $X∼U[3,8],$ find $\\text{SD}[X].$ Round your answer to three decimal places." :question/worked-solution "If the random variable $X$ is distributed uniformly over the interval $[a,b],$ then \n\n$$\n\\text{Var}[X]=\\frac{(b-a)^{2}}{12}.\n$$\n\nIn our case, we have $a=3$ and $b=8.$ Therefore,\n\n$$\n\\text{Var}[X]=\\frac{(8-3)^{2}}{12}=\\frac{25}{12}.\n$$\n\nFinally,\n\n$$\n\\text{SD}[X]=\\sqrt{\\frac{25}{12}}=\\frac{5\\sqrt{3}}{6}≈1.443.\n$$"}] [{:db/id #edb/ref 17592186543478 :knowledge-point/_questions [{:db/id #edb/ref 17592186166746 :knowledge-point/id #uuid "b4b957bc-c1dd-5f7f-820c-8345a3bded2a" :knowledge-point/title "Computing the Variance of a Uniformly Distributed Random Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "580b19f4-06cd-5f23-8232-395131ef6d7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186542881} {:answer/id #uuid "8a00859d-461d-5c26-a897-6628f10261bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186543006} {:answer/id #uuid "94db1437-5e1a-57d2-8107-cd2b1bc91e9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186543029} {:answer/id #uuid "a6355efe-d532-5cd4-af35-a010ccf31b0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{12}" :db/id #edb/ref 17592186543075} {:answer/id #uuid "bcc9ba8c-57a5-5728-b63d-c0258bfc7f44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186543134}] :answer-field/correct {:answer/id #uuid "94db1437-5e1a-57d2-8107-cd2b1bc91e9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186543029} :answer-field/id #uuid "3992d953-1244-5557-9945-0b791a18deb7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543329}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0fcd3eab-4854-55ff-b2c1-1082ea396d46" :question/math-academy-id "q-90672" :question/problem "Given that $X$ is a random variable such that $X∼U[-14,-12],$ find $\\text{Var}[X].$" :question/worked-solution "If the random variable $X$ is distributed uniformly over the interval $[a,b],$ then \n\n$$\n\\text{Var}[X]=\\frac{(b-a)^{2}}{12}.\n$$\n\nIn our case, we have $a=-14$ and $b=-12.$ Therefore,\n\n$$\n\\text{Var}[X]=\\frac{(-12-(-14))^{2}}{12}=\\frac{4}{12}=\\frac{1}{3}.\n$$"}] [{:db/id #edb/ref 17592186543565 :knowledge-point/_questions [{:db/id #edb/ref 17592186166794 :knowledge-point/id #uuid "edde1bb6-42d9-5b8d-a29b-7fa91711f017" :knowledge-point/title "Computing the Standard Deviation of a Uniformly Distributed Random Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1585b6e2-429d-51d8-8c0e-3911e7716053" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.737" :db/id #edb/ref 17592186542692} {:answer/id #uuid "494e131c-f649-5ebc-ad15-3ca3db67e9c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.732" :db/id #edb/ref 17592186542840} {:answer/id #uuid "576b71e1-7f62-56c3-a6d4-b905df0183d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.722" :db/id #edb/ref 17592186542877} {:answer/id #uuid "70098b3e-4590-5b38-a9c2-71c3acb1c70b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.237" :db/id #edb/ref 17592186542936} {:answer/id #uuid "c7ed1bc3-120f-5883-a357-b19fb6040732" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.702" :db/id #edb/ref 17592186543161}] :answer-field/correct {:answer/id #uuid "494e131c-f649-5ebc-ad15-3ca3db67e9c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.732" :db/id #edb/ref 17592186542840} :answer-field/id #uuid "27ef2412-e3b2-5d7b-90bb-7eff3b5943a2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543316}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "da016258-0a74-55d6-826a-b4bf1b04b20f" :question/math-academy-id "q-96543" :question/problem "Given that $X$ is a random variable such that $X∼U[-1,5],$ find $\\text{SD}[X].$ Round your answer to three decimal places." :question/worked-solution "If the random variable $X$ is distributed uniformly over the interval $[a,b],$ then \n\n$$\n\\text{Var}[X]=\\frac{(b-a)^{2}}{12}.\n$$\n\nIn our case, we have $a=-1$ and $b=5.$ Therefore,\n\n$$\n\\text{Var}[X]=\\frac{(5-(-1))^{2}}{12}=\\frac{36}{12}=3.\n$$\n\nFinally,\n\n$$\n\\text{SD}[X]=\\sqrt{3}≈1.732.\n$$"}] [{:db/id #edb/ref 17592186543572 :knowledge-point/_questions [{:db/id #edb/ref 17592186166794 :knowledge-point/id #uuid "edde1bb6-42d9-5b8d-a29b-7fa91711f017" :knowledge-point/title "Computing the Standard Deviation of a Uniformly Distributed Random Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1de0e48a-1c15-541b-8c3d-0a796ba76229" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.122" :db/id #edb/ref 17592186542717} {:answer/id #uuid "27fbf980-3763-53bc-b7f2-b9c877a749dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.201" :db/id #edb/ref 17592186542743} {:answer/id #uuid "9bac3d75-a967-5c99-b769-8dad1d46751e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answ