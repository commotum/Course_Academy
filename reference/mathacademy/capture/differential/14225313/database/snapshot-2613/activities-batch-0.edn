#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186167695} :activity/id #uuid "af9e80d3-02e1-5428-b1a2-f26d1300e421" :activity/scope {:db/id #edb/ref 17592186048513 :topic/id #uuid "a5a9450e-27e7-527a-9dc9-ede255310e6c" :topic/math-academy-id 3277} :activity/steps [{:db/id #edb/ref 17592186167571 :step/content {:db/id #edb/ref 17592186166745 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166583 :question/id #uuid "52f0578f-6ac1-5b02-afa0-3df525bb755a" :question/math-academy-id "e-7956"} :knowledge-point/id #uuid "dc6e264d-f845-51a5-acaa-852e5582c9b2" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049239} {:db/id #edb/ref 17592186049801}] :knowledge-point/questions [{:db/id #edb/ref 17592186167320} {:db/id #edb/ref 17592186167322} {:db/id #edb/ref 17592186522717} {:db/id #edb/ref 17592186522733} {:db/id #edb/ref 17592186522754} {:db/id #edb/ref 17592186522758} {:db/id #edb/ref 17592186522810}] :knowledge-point/title "Computing the Expected Value of a Uniformly Distributed Random Variable"} :step/id #uuid "a0d51ad5-eca9-5c25-8c80-53b87f0b66a7" :step/math-academy-id 29664 :step/next {:db/id #edb/ref 17592186167572}} {:db/id #edb/ref 17592186167572 :step/content {:db/id #edb/ref 17592186166746 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166584 :question/id #uuid "c562f2c3-f1e0-5484-bbdf-9f178363d407" :question/math-academy-id "e-7957"} :knowledge-point/id #uuid "b4b957bc-c1dd-5f7f-820c-8345a3bded2a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049786}] :knowledge-point/questions [{:db/id #edb/ref 17592186167321} {:db/id #edb/ref 17592186167323} {:db/id #edb/ref 17592186522698} {:db/id #edb/ref 17592186522726} {:db/id #edb/ref 17592186522764} {:db/id #edb/ref 17592186522779} {:db/id #edb/ref 17592186522783} {:db/id #edb/ref 17592186543478} {:db/id #edb/ref 17592186543557}] :knowledge-point/title "Computing the Variance of a Uniformly Distributed Random Variable"} :step/id #uuid "46b68336-ccb6-54bb-a133-3525ce08a346" :step/math-academy-id 29665 :step/next {:db/id #edb/ref 17592186167629}} {:db/id #edb/ref 17592186167629 :step/content {:db/id #edb/ref 17592186166794 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166632 :question/id #uuid "b0e62d58-c20a-5907-8486-eb9f03611b07" :question/math-academy-id "e-8431"} :knowledge-point/id #uuid "edde1bb6-42d9-5b8d-a29b-7fa91711f017" :knowledge-point/questions [{:db/id #edb/ref 17592186167324} {:db/id #edb/ref 17592186167473} {:db/id #edb/ref 17592186522728} {:db/id #edb/ref 17592186522737} {:db/id #edb/ref 17592186522757} {:db/id #edb/ref 17592186522785} {:db/id #edb/ref 17592186543551} {:db/id #edb/ref 17592186543565} {:db/id #edb/ref 17592186543572}] :knowledge-point/title "Computing the Standard Deviation of a Uniformly Distributed Random Variable"} :step/id #uuid "65e0b47c-66a0-5066-9cab-774c93235386" :step/math-academy-id 31405 :step/next {:db/id #edb/ref 17592186167723}} {:db/id #edb/ref 17592186167695 :step/content {:db/id #edb/ref 17592186168086 :tutorial/content "Recall that if the random variable $X$ is uniformly distributed over the interval $[a,b],$ then $X$ has the following probability density function:\n![](images/af/af2afd72c74a9d7ca810886490baf28610cb743cbe8c8595158cfc2af702b7fa.svg)\n\nIt can be shown that the expected value and variance of $X$ are as follows:\n\n$$\n\\begin{aligned}\\text{E}[X] & =\\frac{a+b}{2} \\\\ \\text{Var}[X] & =\\frac{(b-a)^{2}}{12}\\end{aligned}\n$$\n\nThe result for $\\textrm{E}[X]$ is intuitive as it's simply the midpoint of the interval $[a,b].$ \n\nWe will derive both of these results at the end of the lesson." :tutorial/id #uuid "b5aec157-2481-5e36-90cf-d794324c0d63" :tutorial/math-academy-id 5171 :tutorial/title "Introduction"} :step/id #uuid "e8ea9dc2-f5e8-5bd0-9c42-9bea7f04ec30" :step/math-academy-id 32475 :step/next {:db/id #edb/ref 17592186167571}} {:db/id #edb/ref 17592186167723 :step/content {:db/id #edb/ref 17592186168111 :tutorial/content "If $X\\sim U[a,b],$ then $X$ has the following probability density function:\n![](images/be/be9457e598579e35be37d8fcc86663f4229e6193f02b11c49242d63858406a3b.svg)\n\nWe can compute the formula for $\\textrm E[X]$ using the usual definition:\n\n$$\n\\begin{aligned}\\text{E}[X] & ={\\int }_{a}^{b}xf(x)\\,\\text{d}x \\\\  & ={\\int }_{a}^{b}\\frac{x}{b-a}\\,\\text{d}x \\\\  & =\\frac{1}{b-a}{\\int }_{a}^{b}x\\,\\text{d}x \\\\  & =\\frac{1}{b-a}\\cdot {\\frac{1}{2}{x}^{2}|}_{a}^{b} \\\\  & =\\frac{1}{2(b-a)}\\cdot ({b}^{2}-{a}^{2}) \\\\  & =\\frac{1}{2(b-a)}\\cdot (b-a)(b+a) \\\\  & =\\frac{1}{2\\cancel{(b-a)}}\\cdot \\cancel{(b-a)}(b+a) \\\\  & =\\frac{a+b}{2}\\end{aligned}\n$$" :tutorial/id #uuid "1bdf6fbe-b1ad-56fa-a9f6-e9f99b79f3d0" :tutorial/math-academy-id 5374 :tutorial/title "Deriving the Formula for the Mean"} :step/id #uuid "f3e60acc-a80c-56c2-8829-19a34e9d5154" :step/math-academy-id 33541 :step/next {:db/id #edb/ref 17592186167724}} {:db/id #edb/ref 17592186167724 :step/content {:db/id #edb/ref 17592186168112 :tutorial/content "If $X\\sim U[a,b],$ then $X$ has the following probability density function:\n![](images/57/579372cf7b7880117ff6e7b4e1f063b29e42f886b06e2277e2dcb1f1240ff11d.svg)\n\nTo compute $\\textrm{Var}[X],$ we use the relation\n\n$$\n\\textrm{Var}[X] = \\textrm{E}[X^2] - (\\textrm{E}[X])^2.\n$$\n\nFirst, we compute $\\textrm E[X^2]$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{a}^{b}{x}^{2}f(x)\\,\\text{d}x \\\\  & ={\\int }_{a}^{b}\\frac{{x}^{2}}{b-a}\\,\\text{d}x \\\\  & =\\frac{1}{b-a}{\\int }_{a}^{b}{x}^{2}\\,\\text{d}x \\\\  & =\\frac{1}{b-a}\\cdot {\\frac{1}{3}{x}^{3}|}_{a}^{b} \\\\  & =\\frac{1}{3(b-a)}\\cdot ({b}^{3}-{a}^{3}) \\\\  & =\\frac{1}{3(b-a)}\\cdot (b-a)({b}^{2}+ab+{a}^{2}) \\\\  & =\\frac{1}{3\\cancel{(b-a)}}\\cdot \\cancel{(b-a)}({b}^{2}+ab+{a}^{2}) \\\\  & =\\frac{1}{3}({b}^{2}+ab+{a}^{2})\\end{aligned}\n$$\n\nNow, since $\\textrm E[X] = \\dfrac12(b+a),$ we have\n\n$$\n(\\textrm E[X])^2 = \\dfrac14(b^2+2ab+a^2).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-(\\text{E}[X])^{2} \\\\  & =\\frac{1}{3}({b}^{2}+ab+{a}^{2})-\\frac{1}{4}({b}^{2}+2ab+{a}^{2}) \\\\  & =\\frac{4}{12}({b}^{2}+ab+{a}^{2})-\\frac{3}{12}({b}^{2}+2ab+{a}^{2}) \\\\  & =\\frac{1}{12}(4{b}^{2}+4ab+4{a}^{2})-\\frac{1}{12}(3{b}^{2}+6ab+3{a}^{2}) \\\\  & =\\frac{1}{12}({b}^{2}-2ab+{a}^{2}) \\\\  & =\\frac{1}{12}(b-a)^{2}.\\end{aligned}\n$$" :tutorial/id #uuid "16d85ab9-dd16-51a2-97f0-2ca5ef2e3d08" :tutorial/math-academy-id 5375 :tutorial/title "Deriving the Formula for the Variance"} :step/id #uuid "34dfa270-6714-5186-ac3d-804cefaedb27" :step/math-academy-id 33542}] :activity/title "Mean and Variance of the Continuous Uniform Distribution" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186167040}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186543642} :activity/id #uuid "37696809-a719-5b64-8c6e-1f3b98392d29" :activity/scope {:db/id #edb/ref 17592186048513 :topic/id #uuid "a5a9450e-27e7-527a-9dc9-ede255310e6c" :topic/math-academy-id 3277} :activity/steps [{:db/id #edb/ref 17592186543598 :step/content {:db/id #edb/ref 17592186543551 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "267ab761-26d7-57dc-8def-97aa5d384c1c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.128" :db/id #edb/ref 17592186542738} {:answer/id #uuid "40ad5a30-1983-5ba4-9063-ee1cc2b79f04" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.713" :db/id #edb/ref 17592186542815} {:answer/id #uuid "49b53d5f-2296-55f1-9cb6-bf7bb6bfc356" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3.581" :db/id #edb/ref 17592186542843} {:answer/id #uuid "55a4d135-b137-503e-9c19-b69e506a0e8b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.443" :db/id #edb/ref 17592186542870} {:answer/id #uuid "b372d906-77f5-592d-9cee-5d9413f82f70" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3.175" :db/id #edb/ref 17592186543107}] :answer-field/correct {:db/id #edb/ref 17592186542870} :answer-field/id #uuid "01db84db-d17a-5436-857c-df53b3ee501f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186543292}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b5a32830-d248-5fc8-bc7e-b05512cbde4a" :question/math-academy-id "q-130714" :question/problem "Given that $X$ is a random variable such that $X∼U[3,8],$ find $\\text{SD}[X].$ Round your answer to three decimal places." :question/worked-solution "If the random variable $X$ is distributed uniformly over the interval $[a,b],$ then \n\n$$\n\\text{Var}[X]=\\frac{(b-a)^{2}}{12}.\n$$\n\nIn our case, we have $a=3$ and $b=8.$ Therefore,\n\n$$\n\\text{Var}[X]=\\frac{(8-3)^{2}}{12}=\\frac{25}{12}.\n$$\n\nFinally,\n\n$$\n\\text{SD}[X]=\\sqrt{\\frac{25}{12}}=\\frac{5\\sqrt{3}}{6}≈1.443.\n$$"} :step/id #uuid "0d21c858-7859-5d5f-8350-22cd41647247"} {:db/id #edb/ref 17592186543636 :step/content {:db/id #edb/ref 17592186543557 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "063be259-5820-5ee3-a0a9-153a9190b3b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{27}{4}" :db/id #edb/ref 17592186542652} {:answer/id #uuid "168d8c47-f103-5ff2-a22e-8cbcced9dcc4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{4}" :db/id #edb/ref 17592186542697} {:answer/id #uuid "49619131-cc7e-5068-b060-d49334625ec4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186542841} {:answer/id #uuid "c3a5cc7a-a7bb-5977-b0ca-f4be409679db" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "27" :db/id #edb/ref 17592186543154} {:answer/id #uuid "cc0df2f6-7d00-502e-aec5-aa25d1b1c455" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186543170}] :answer-field/correct {:db/id #edb/ref 17592186542652} :answer-field/id #uuid "48c440fe-ee45-50ad-96dc-aebf71a08eee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186543337}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c8776b39-34f7-5d7c-be21-f79bcc825464" :question/math-academy-id "q-130712" :question/problem "Given that $X$ is a random variable such that $X∼U[-8,1],$ find $\\text{Var}[X].$" :question/worked-solution "If the random variable $X$ is distributed uniformly over the interval $[a,b],$ then \n\n$$\n\\text{Var}[X]=\\frac{(b-a)^{2}}{12}.\n$$\n\nIn our case, we have $a=-8$ and $b=1.$ Therefore,\n\n$$\n\\text{Var}[X]=\\frac{(1-(-8))^{2}}{12}=\\frac{81}{12}=\\frac{27}{4}.\n$$"} :step/id #uuid "60078dca-d182-58f7-bae4-684d5f0ed13f" :step/next {:db/id #edb/ref 17592186543598}} {:db/id #edb/ref 17592186543642 :step/content {:db/id #edb/ref 17592186543478 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "580b19f4-06cd-5f23-8232-395131ef6d7b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186542881} {:answer/id #uuid "8a00859d-461d-5c26-a897-6628f10261bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186543006} {:answer/id #uuid "94db1437-5e1a-57d2-8107-cd2b1bc91e9a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186543029} {:answer/id #uuid "a6355efe-d532-5cd4-af35-a010ccf31b0b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{12}" :db/id #edb/ref 17592186543075} {:answer/id #uuid "bcc9ba8c-57a5-5728-b63d-c0258bfc7f44" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186543134}] :answer-field/correct {:db/id #edb/ref 17592186543029} :answer-field/id #uuid "3992d953-1244-5557-9945-0b791a18deb7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186543329}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0fcd3eab-4854-55ff-b2c1-1082ea396d46" :question/math-academy-id "q-90672" :question/problem "Given that $X$ is a random variable such that $X∼U[-14,-12],$ find $\\text{Var}[X].$" :question/worked-solution "If the random variable $X$ is distributed uniformly over the interval $[a,b],$ then \n\n$$\n\\text{Var}[X]=\\frac{(b-a)^{2}}{12}.\n$$\n\nIn our case, we have $a=-14$ and $b=-12.$ Therefore,\n\n$$\n\\text{Var}[X]=\\frac{(-12-(-14))^{2}}{12}=\\frac{4}{12}=\\frac{1}{3}.\n$$"} :step/id #uuid "71de7932-666c-53c4-972e-6f7a15c2646a" :step/next {:db/id #edb/ref 17592186543643}} {:db/id #edb/ref 17592186543643 :step/content {:db/id #edb/ref 17592186543565 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1585b6e2-429d-51d8-8c0e-3911e7716053" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.737" :db/id #edb/ref 17592186542692} {:answer/id #uuid "494e131c-f649-5ebc-ad15-3ca3db67e9c4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.732" :db/id #edb/ref 17592186542840} {:answer/id #uuid "576b71e1-7f62-56c3-a6d4-b905df0183d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.722" :db/id #edb/ref 17592186542877} {:answer/id #uuid "70098b3e-4590-5b38-a9c2-71c3acb1c70b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2.237" :db/id #edb/ref 17592186542936} {:answer/id #uuid "c7ed1bc3-120f-5883-a357-b19fb6040732" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2.702" :db/id #edb/ref 17592186543161}] :answer-field/correct {:db/id #edb/ref 17592186542840} :answer-field/id #uuid "27ef2412-e3b2-5d7b-90bb-7eff3b5943a2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186543316}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "da016258-0a74-55d6-826a-b4bf1b04b20f" :question/math-academy-id "q-96543" :question/problem "Given that $X$ is a random variable such that $X∼U[-1,5],$ find $\\text{SD}[X].$ Round your answer to three decimal places." :question/worked-solution "If the random variable $X$ is distributed uniformly over the interval $[a,b],$ then \n\n$$\n\\text{Var}[X]=\\frac{(b-a)^{2}}{12}.\n$$\n\nIn our case, we have $a=-1$ and $b=5.$ Therefore,\n\n$$\n\\text{Var}[X]=\\frac{(5-(-1))^{2}}{12}=\\frac{36}{12}=3.\n$$\n\nFinally,\n\n$$\n\\text{SD}[X]=\\sqrt{3}≈1.732.\n$$"} :step/id #uuid "77c27834-eac4-5271-a319-db3788bdb273" :step/next {:db/id #edb/ref 17592186543652}} {:db/id #edb/ref 17592186543652 :step/content {:db/id #edb/ref 17592186543572 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1de0e48a-1c15-541b-8c3d-0a796ba76229" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.122" :db/id #edb/ref 17592186542717} {:answer/id #uuid "27fbf980-3763-53bc-b7f2-b9c877a749dc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2.201" :db/id #edb/ref 17592186542743} {:answer/id #uuid "9bac3d75-a967-5c99-b769-8dad1d46751e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.221" :db/id #edb/ref 17592186543047} {:answer/id #uuid "9d84f3f9-b228-59a5-b0a4-f1927cbf07ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2.022" :db/id #edb/ref 17592186543054} {:answer/id #uuid "e75fd171-e5cc-55b8-910f-afdfe76603ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2.021" :db/id #edb/ref 17592186543229}] :answer-field/correct {:db/id #edb/ref 17592186543229} :answer-field/id #uuid "1df1aa21-3031-5917-aa7a-0e2c69c11c86" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186543306}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e2d806a2-2942-5a78-912e-4a549e08c6e1" :question/math-academy-id "q-96563" :question/problem "Given that $X$ is a random variable such that $X∼U[-15,-8],$ find $\\text{SD}[X].$ Round your answer to three decimal places." :question/worked-solution "If the random variable $X$ is distributed uniformly over the interval $[a,b],$ then \n\n$$\n\\text{Var}[X]=\\frac{(b-a)^{2}}{12}.\n$$\n\nIn our case, we have $a=-15$ and $b=-8.$ Therefore,\n\n$$\n\\text{Var}[X]=\\frac{(-8-(-15))^{2}}{12}=\\frac{49}{12}.\n$$\n\nFinally,\n\n$$\n\\text{SD}[X]=\\sqrt{\\frac{49}{12}}=\\frac{7\\sqrt{3}}{6}≈2.021.\n$$"} :step/id #uuid "a80b71d0-34b6-5f99-b824-40d9c8789bfc" :step/next {:db/id #edb/ref 17592186543636}}] :activity/title "Mean and Variance of the Continuous Uniform Distribution" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186542618}]}
