86045417] [17592186102530 #edb/ref 1075 #edb/ref 17592186479508 #edb/ref 17592186045417] [17592186102530 #edb/ref 1075 #edb/ref 17592186479533 #edb/ref 17592186045417] [17592186102530 #edb/ref 1075 #edb/ref 17592186479661 #edb/ref 17592186045417] [17592186102530 #edb/ref 1075 #edb/ref 17592186479733 #edb/ref 17592186045417] [17592186102530 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186102530 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186102530 #edb/ref 1078 #edb/ref 17592186479508 #edb/ref 17592186045417] [17592186102530 #edb/ref 1079 #uuid "589c07ef-1c36-566e-ab30-36c2c2bba507" #edb/ref 17592186045417] [17592186105588 #edb/ref 1069 "e-4327" #edb/ref 17592186045417] [17592186105588 #edb/ref 1071 "Find the angle between $\\mathbf{a}=\\langle 2,-1,1 \\rangle$ and $\\mathbf{b}=\\langle 1,5,-2 \\rangle$. Round your answer to $1$ decimal place." #edb/ref 17592186045417] [17592186105588 #edb/ref 1072 #uuid "3d38f3e0-4c27-5ac6-ac16-9c8f57e0000e" #edb/ref 17592186045417] [17592186105588 #edb/ref 1074 "Rearranging the dot product formula, we have:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{a\\cdot b}{|\\,a\\,||\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}+{a}_{z}^{2}}\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{2\\cdot 1+(-1)\\cdot 5+1\\cdot (-2)}{\\sqrt{{2}^{2}+(-1)^{2}+{1}^{2}}\\sqrt{{1}^{2}+{5}^{2}+(-2)^{2}}} \\\\  & =\\frac{-5}{\\sqrt{6}\\cdot \\sqrt{30}} \\\\  & =\\frac{-5}{\\sqrt{6}\\cdot \\sqrt{6}\\cdot \\sqrt{5}} \\\\  & =-\\frac{\\sqrt{5}}{6}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta = \\arccos \\left( -\\dfrac{\\sqrt{5}}{6} \\right) \\approx 111.9^\\circ.\n$$" #edb/ref 17592186045417] [17592186105589 #edb/ref 1069 "e-4328" #edb/ref 17592186045417] [17592186105589 #edb/ref 1071 "Find $\\angle BAC$ given the points $A(2,-1,-5)$, $B(-1,0,-4)$, and $C(5,1,1).$ Round your answer to $1$ decimal place." #edb/ref 17592186045417] [17592186105589 #edb/ref 1072 #uuid "d6d1be58-7321-50ca-a47d-5e80d55277c3" #edb/ref 17592186045417] [17592186105589 #edb/ref 1074 "Note that the position vectors of the points $A$, $B$, $C$ are\n\n$$\n\\begin{aligned}a=⟨2,-1,-5⟩,\\,b=⟨-1,0,-4⟩,\\,c=⟨5,1,1⟩.\\end{aligned}\n$$\n\nThe triangle $\\triangle ABC$ is shown (schematically) in the diagram below, where we denote $\\angle BAC = \\theta.$\n\n![](images/28/285b8343208079181ac6036cf9ca16abc974d59b9262878ed40c0da9af5683d0.png)\n\nFirst, we find the components of $\\overrightarrow{AB}$ and $\\overrightarrow{AC}\\mathbin{:}$\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =⟨-1,0,-4⟩-⟨2,-1,-5⟩ \\\\  & =⟨-3,1,1⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =⟨5,1,1⟩-⟨2,-1,-5⟩ \\\\  & =⟨3,2,6⟩\\end{aligned}\n$$\n\nNow, the cosine of the angle between $\\overrightarrow{AB}$ and $\\overrightarrow{AC}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{\\overset{\\to }{AB}\\cdot \\overset{\\to }{AC}}{|\\overset{\\to }{AB}||\\overset{\\to }{AC}|} \\\\  & =\\frac{-3\\cdot 3+1\\cdot 2+1\\cdot 6}{\\sqrt{(-3)^{2}+{1}^{2}+{1}^{2}}\\sqrt{{3}^{2}+{2}^{2}+{6}^{2}}} \\\\  & =\\frac{-1}{\\sqrt{11}\\sqrt{49}} \\\\  & =-\\frac{1}{7\\sqrt{11}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta = \\arccos \\left( -\\dfrac{1}{7\\sqrt{11}} \\right) \\approx 92.5^\\circ.\n$$" #edb/ref 17592186045417] [17592186105606 #edb/ref 1069 "e-5112" #edb/ref 17592186045417] [17592186105606 #edb/ref 1071 "Given that $\\mathbf{a}\\cdot \\mathbf{b}=-4$, find the angle between $\\mathbf{a}=\\langle t, \\, -2 \\rangle$ and $\\mathbf{b}=\\langle 6, \\, t \\rangle$. Round your answer to $1$ decimal place." #edb/ref 17592186045417] [17592186105606 #edb/ref 1072 #uuid "fb2df468-d70d-5300-8860-0cb729cb13c5" #edb/ref 17592186045417] [17592186105606 #edb/ref 1074 "First, since $\\mathbf{a}\\cdot \\mathbf{b}=-4$, we can solve for $t$, as follows:\n\n$$\n\\begin{aligned}a\\cdot b & =-4 \\\\ t\\cdot 6+(-2)\\cdot t & =-4 \\\\ 6t-2t & =-4 \\\\ 4t & =-4 \\\\ t & =-1\\end{aligned}\n$$\n\nSo, \n\n$$\n\\begin{aligned}a=⟨-1,-2⟩,\\,b=⟨6,-1⟩.\\end{aligned}\n$$\n\nNow, the cosine of the angle between $\\mathbf{a}$ and $\\mathbf{b}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{a\\cdot b}{|\\,a\\,||\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}}{\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}}\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}}} \\\\  & =\\frac{-4}{\\sqrt{(-1)^{2}+(-2)^{2}}\\cdot \\sqrt{{6}^{2}+(-1)^{2}}} \\\\  & =-\\frac{4}{\\sqrt{5}\\cdot \\sqrt{37}} \\\\  & =-\\frac{4}{\\sqrt{185}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta = \\arccos \\left( -\\dfrac{4}{\\sqrt{185}} \\right) \\approx 107.1^\\circ.\n$$" #edb/ref 17592186045417] [17592186105730 #edb/ref 1037 #edb/ref 17592186048954 #edb/ref 17592186045417] [17592186105730 #edb/ref 1037 #edb/ref 17592186050071 #edb/ref 17592186045417] [17592186105730 #edb/ref 1037 #edb/ref 17592186051021 #edb/ref 17592186045417] [17592186105730 #edb/ref 1038 #edb/ref 17592186106097 #edb/ref 17592186045417] [17592186105730 #edb/ref 1038 #edb/ref 17592186106106 #edb/ref 17592186045417] [17592186105730 #edb/ref 1038 #edb/ref 17592186235514 #edb/ref 17592186045417] [17592186105730 #edb/ref 1038 #edb/ref 17592186237828 #edb/ref 17592186045417] [17592186105730 #edb/ref 1038 #edb/ref 17592186237829 #edb/ref 17592186045417] [17592186105730 #edb/ref 1038 #edb/ref 17592186237830 #edb/ref 17592186045417] [17592186105730 #edb/ref 1038 #edb/ref 17592186237831 #edb/ref 17592186045417] [17592186105730 #edb/ref 1038 #edb/ref 17592186259735 #edb/ref 17592186045417] [17592186105730 #edb/ref 1038 #edb/ref 17592186287910 #edb/ref 17592186045417] [17592186105730 #edb/ref 1038 #edb/ref 17592186287911 #edb/ref 17592186045417] [17592186105730 #edb/ref 1038 #edb/ref 17592186287913 #edb/ref 17592186045417] [17592186105730 #edb/ref 1038 #edb/ref 17592186287914 #edb/ref 17592186045417] [17592186105730 #edb/ref 1038 #edb/ref 17592186335941 #edb/ref 17592186045417] [17592186105730 #edb/ref 1038 #edb/ref 17592186