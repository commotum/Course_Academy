#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186487447} :activity/id #uuid "3f9712cf-1f13-53f6-99ad-54dc733817ad" :activity/scope {:db/id #edb/ref 17592186050394 :topic/id #uuid "455f5bc8-b430-5c8e-bb46-a11907e59c78" :topic/math-academy-id 1295} :activity/steps [{:db/id #edb/ref 17592186487417 :step/content {:db/id #edb/ref 17592186299663 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fa759f3a-59cf-57f1-9eb4-fe076883ee65" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186298620}] :answer-field/correct {:db/id #edb/ref 17592186298620} :answer-field/id #uuid "415cdd53-3c35-5e12-a9ad-bdb260275079" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186298863}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2940b787-7de0-58e6-a5d9-3477f08d2d69" :question/math-academy-id "q-317944" :question/problem "Let $a=t\\,i-4j+k$ and $b=4i+j.$ Given that the projection of $a$ onto $b$ is the zero vector, find the value of $t.$\n\n$t=$\n{{field-1}}" :question/worked-solution "Since $a$ is a nonzero vector, its projection onto another nonzero vector $b$ equals the zero vector only when the vectors are perpendicular.\n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =t\\cdot 4+(-4)\\cdot 1+1\\cdot 0 \\\\  & =4t-4+0 \\\\  & =4t-4.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ 4t-4 & =0 \\\\ 4t & =4 \\\\ t & =1 \\\\ t & =1.\\end{aligned}\n$$"} :step/id #uuid "333ded1a-53b9-5952-8d65-b4f24b2126f6"} {:db/id #edb/ref 17592186487424 :step/content {:db/id #edb/ref 17592186290296 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "085237b3-7339-507a-81da-41e8838a4e5d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186288096} {:answer/id #uuid "2547952c-6d6d-51dd-84d9-5d6dddcecc24" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186288278} {:answer/id #uuid "348d85f2-eb5b-5146-8401-4763298c0ead" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186288381} {:answer/id #uuid "81de0d68-8b33-5042-b528-9c369770b979" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186288908} {:answer/id #uuid "983ed9cb-19d2-5826-8970-1323081a65d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186289052}] :answer-field/correct {:db/id #edb/ref 17592186289052} :answer-field/id #uuid "5656f1d3-8dfe-58cd-9391-206ef0a86ac4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186289911}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cbcf41af-6f81-5a46-9b85-441a34ac9cb2" :question/math-academy-id "q-212459" :question/problem "Let $a=⟨2,-1,-2⟩$ and $b=⟨x,-4,0⟩.$ Given that the projection of $a$ onto $b$ is the zero vector, find the value of $x.$" :question/worked-solution "Since $a$ is a nonzero vector, its projection onto another nonzero vector $b$ equals the zero vector only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =2\\cdot x+(-1)\\cdot (-4)+(-2)\\cdot 0 \\\\  & =2x+4.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ 2x+4 & =0 \\\\ 2x & =-4 \\\\ x & =-2.\\end{aligned}\n$$"} :step/id #uuid "4f577824-992f-5ecb-84d6-749721d2f2ab" :step/next {:db/id #edb/ref 17592186487441}} {:db/id #edb/ref 17592186487436 :step/content {:db/id #edb/ref 17592186287938 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "333bcad1-e70c-5829-9062-c43fba448878" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨6,-6,6⟩" :db/id #edb/ref 17592186285255} {:answer/id #uuid "567c3699-d085-5a43-943c-ac24a5cb251c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨3,-3,-3⟩" :db/id #edb/ref 17592186285583} {:answer/id #uuid "a2209f52-c5f3-545b-acd4-9063189003cf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-\\frac{1}{\\sqrt{3}},-\\frac{1}{\\sqrt{3}},\\frac{1}{\\sqrt{3}}⟩" :db/id #edb/ref 17592186286273} {:answer/id #uuid "c25020f3-be37-5e8b-a50f-1b4e8f6258eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{6}{\\sqrt{3}},\\frac{6}{\\sqrt{3}},\\frac{6}{\\sqrt{3}}⟩" :db/id #edb/ref 17592186286566} {:answer/id #uuid "c9bb4760-d5c8-5ecf-a28e-d323c63d492e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨2,-2,2⟩" :db/id #edb/ref 17592186286628}] :answer-field/correct {:db/id #edb/ref 17592186286628} :answer-field/id #uuid "04959729-9f39-58a0-94d2-f287c161fe10" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186287151}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "60b66f90-3842-5d62-9e02-b5d4a4919337" :question/math-academy-id "q-19214" :question/problem "Let $p=⟨1,-1,1⟩$ and $q=⟨8,4,2⟩.$ Find the vector projection of $q$ onto $p.$" :question/worked-solution "Using the formula for the vector projection, we obtain \n\n$$\n\\begin{aligned}{\\text{proj}}_{p}\\,q & =\\frac{p\\cdot q}{p\\cdot p}p \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{{p}_{x}^{2}+{p}_{y}^{2}+{p}_{z}^{2}}p \\\\  & =\\frac{1\\cdot 8+(-1)\\cdot 4+1\\cdot 2}{{1}^{2}+(-1)^{2}+{1}^{2}}p \\\\  & =\\frac{6}{3}⟨1,-1,1⟩ \\\\  & =⟨2,-2,2⟩.\\end{aligned}\n$$"} :step/id #uuid "acc822ee-4c60-569f-b9f3-f99814a03662" :step/next {:db/id #edb/ref 17592186487424}} {:db/id #edb/ref 17592186487441 :step/content {:db/id #edb/ref 17592186299659 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f1e74cda-962f-530c-9dc5-da6fa3027618" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186298576}] :answer-field/correct {:db/id #edb/ref 17592186298576} :answer-field/id #uuid "3ebbdb00-7250-5b52-a3d7-5e3a06732032" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186298855} {:answer-field/choices [{:answer/id #uuid "7c9bd58c-c3aa-5aac-8af2-0f2dd4d21cd2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186298091}] :answer-field/correct {:db/id #edb/ref 17592186298091} :answer-field/id #uuid "4ca49e40-42ef-549f-8cba-a8415f643eee" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186298892} {:answer-field/choices [{:answer/id #uuid "26a218fd-1c69-51ca-837a-ec2ac174e881" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186297712}] :answer-field/correct {:db/id #edb/ref 17592186297712} :answer-field/id #uuid "9a211abc-329d-5e8e-a21a-d845d97c0b27" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186299145}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "47bb7ff9-8595-5c3c-8469-6716c5ae622e" :question/math-academy-id "q-317924" :question/problem "Let $u=[\\begin{aligned}1 \\\\ -2 \\\\ 1\\end{aligned}]$ and $v=[\\begin{aligned}2 \\\\ 1 \\\\ 0\\end{aligned}].$ Find the vector projection of $u$ onto $v.$\n\n${\\text{proj}}_{v}\\,u=⟨$\n{{field-1}}$,$\n{{field-2}}$,$\n{{field-3}}\n$⟩$" :question/worked-solution "Using the formula for the vector projection, we obtain\n\n$$\n\\begin{aligned}{\\text{proj}}_{v}\\,u & =\\frac{u\\cdot v}{v\\cdot v}v \\\\  & =\\frac{{u}_{x}{v}_{x}+{u}_{y}{v}_{y}+{u}_{z}{v}_{z}}{{v}_{x}^{2}+{v}_{y}^{2}+{v}_{z}^{2}}v \\\\  & =\\frac{(1)\\cdot 2+(-2)\\cdot 1+(1)\\cdot 0}{{2}^{2}+{1}^{2}+{0}^{2}}v \\\\  & =\\frac{0}{5}v \\\\  & =⟨\\,0,0,0\\,⟩.\\end{aligned}\n$$"} :step/id #uuid "d23f251b-88e1-5993-bf53-204aefc296ce" :step/next {:db/id #edb/ref 17592186487417}} {:db/id #edb/ref 17592186487447 :step/content {:db/id #edb/ref 17592186287935 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00b763df-9c1f-5e4b-9796-546c1233f800" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-\\frac{57}{35},\\frac{19}{14},-\\frac{57}{70}⟩" :db/id #edb/ref 17592186284797} {:answer/id #uuid "2d331e62-52ea-521a-a944-b3adad2ca0d0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-\\frac{57}{35},\\frac{19}{14},-\\frac{57}{35}⟩" :db/id #edb/ref 17592186285189} {:answer/id #uuid "88e9eee0-e73f-5083-b2a8-8bc4aeb6be2c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-\\frac{57}{35},\\frac{19}{35},-\\frac{57}{35}⟩" :db/id #edb/ref 17592186286042} {:answer/id #uuid "ee59770c-2622-5f86-9233-135b35d7ab48" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-\\frac{57}{70},\\frac{19}{14},-\\frac{57}{70}⟩" :db/id #edb/ref 17592186286975} {:answer/id #uuid "fc4b7b0d-d1b4-5b8e-905c-5ff596713058" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨0,0,0⟩" :db/id #edb/ref 17592186287093}] :answer-field/correct {:db/id #edb/ref 17592186284797} :answer-field/id #uuid "083de1e8-d4ce-5ba4-b17a-fccb5cb37b21" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186287162}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d5afb46b-76a8-5264-880d-53ec732db201" :question/math-academy-id "q-19194" :question/problem "Let $a=⟨-2,-1,-4⟩$ and $b=⟨6,-5,3⟩.$ Find the vector projection of $a$ onto $b.$" :question/worked-solution "Using the formula for the vector projection, we obtain \n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,a & =\\frac{a\\cdot b}{b\\cdot b}b \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}b \\\\  & =\\frac{(-2)\\cdot 6+(-1)\\cdot (-5)+(-4)\\cdot 3}{{6}^{2}+(-5)^{2}+{3}^{2}}b \\\\  & =-\\frac{19}{70}⟨6,-5,3⟩ \\\\  & =⟨-\\frac{57}{35},\\frac{19}{14},-\\frac{57}{70}⟩.\\end{aligned}\n$$"} :step/id #uuid "dfe750ff-2971-5ad0-b7d6-11faaf5baa4a" :step/next {:db/id #edb/ref 17592186487436}}] :activity/title "Calculating a Vector Projection" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186486587}]}
