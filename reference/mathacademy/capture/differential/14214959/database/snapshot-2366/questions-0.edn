#{[{:db/id #edb/ref 17592186400240 :knowledge-point/_questions [{:db/id #edb/ref 17592186119944 :knowledge-point/id #uuid "60e28b26-0eb7-51ed-bcf9-2660b98a6028" :knowledge-point/title "Finding a Tangent Line to a Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "606b9a5e-55ed-5e60-92f5-b47ee5f67ecd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-1,0⟩+u⟨0,1⟩" :db/id #edb/ref 17592186400242} {:answer/id #uuid "d6dd58b2-db2a-5f8e-8dd4-53e78bdbc1b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨1,1⟩+u⟨-1,0⟩" :db/id #edb/ref 17592186400243} {:answer/id #uuid "857fe3f7-9574-5a04-bb5d-26945b5b3ac0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-1,0⟩+u⟨-1,1⟩" :db/id #edb/ref 17592186400244} {:answer/id #uuid "d79b2f0b-232c-51be-8226-2f1f3340e84c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-1,0⟩+u⟨-1,0⟩" :db/id #edb/ref 17592186400245} {:answer/id #uuid "34207664-1cc3-511a-9275-7f215d28db11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨1,1⟩+u⟨0,1⟩" :db/id #edb/ref 17592186400246}] :answer-field/correct {:answer/id #uuid "606b9a5e-55ed-5e60-92f5-b47ee5f67ecd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-1,0⟩+u⟨0,1⟩" :db/id #edb/ref 17592186400242} :answer-field/id #uuid "15cc7274-0fbf-5ba4-9530-45869135aca7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400241}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b063a87b-7453-5eed-82c3-d4c7e3cbe51f" :question/math-academy-id "q-126838" :question/problem "Which of the following gives the equation of the tangent to the curve $r(t)=⟨\\operatorname{cos}⁡t,-\\operatorname{sin}⁡t⟩$ at the point where $t=\\pi ,$  valid for all  real values of $u?$" :question/worked-solution "At the point where $t=\\pi ,$ the vector ${r}^{′}(\\pi )$ is tangent to the curve, so the tangent line to the curve at $P$ can be parametrized as\n \n\n$$\nR(u)=r(\\pi )+u{r}^{′}(\\pi ),\\,u\\in (-\\infty ,\\infty )\n$$\n\n \n\nFirst, we find $r(\\pi ):$\n\n$$\n\\begin{aligned}r(\\pi ) & =⟨\\operatorname{cos}⁡\\pi ,-\\operatorname{sin}⁡\\pi ⟩ \\\\  & =⟨-1,0⟩\\end{aligned}\n$$\n\n   \n\nNow, we calculate ${r}^{′}(t):$ \n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(-\\operatorname{sin}⁡t)⟩ \\\\  & =⟨-\\operatorname{sin}⁡t,-\\operatorname{cos}⁡t⟩\\end{aligned}\n$$\n\nThen, we evaluate ${r}^{′}(t)$ at $t=\\pi :$\n\n$$\n\\begin{aligned}{r}^{′}(\\pi ) & =⟨-\\operatorname{sin}⁡\\pi ,-\\operatorname{cos}⁡\\pi ⟩ \\\\  & =⟨0,1⟩\\end{aligned}\n$$\n\nFinally, the tangent line to the given curve at the point where $t=\\pi $ is\n\n$$\nR(u)=⟨-1,0⟩+u⟨0,1⟩,\\,u\\in (-\\infty ,\\infty ).\n$$"}] [{:db/id #edb/ref 17592186120216 :knowledge-point/_questions [{:db/id #edb/ref 17592186119945 :knowledge-point/id #uuid "b4636870-89db-5bf9-8a04-777407957e33" :knowledge-point/title "Finding Points Where a Tangent Vector is Parallel to Another Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b73b04b7-7f81-5da6-b3eb-9ceb86cb6994" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0, 1, 2)$ and $(8, e, 2e)$" :db/id #edb/ref 17592186117458} {:answer/id #uuid "cc024178-9448-5f3b-8037-94e2b89c36c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(1, 1, 2)$ and $(8, e^{2}, 2e^{2})$" :db/id #edb/ref 17592186117459} {:answer/id #uuid "05378c03-7088-58e5-8833-839871a0f537" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0, 1, 1)$ and $(4, e, 2e)$" :db/id #edb/ref 17592186117460} {:answer/id #uuid "34c8f45b-2edd-5e5b-9567-319bcce99dc3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0, 1, 2)$ and $(8, e^{2}, 2e^{2})$" :db/id #edb/ref 17592186117461} {:answer/id #uuid "47f31d44-dbcf-5cb3-8b68-b2659ef75f57" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0, 1, 1)$ and $(8, e^{2}, 2e^{2})$" :db/id #edb/ref 17592186117462}] :answer-field/id #uuid "18987b7e-5379-5dd3-a051-c78ae8fbfe35" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186117457} {:answer-field/choices [{:answer/id #uuid "754f30f6-05c6-5575-a6bd-d8228629df28" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,1,2)$ and $(8,e,2e)$" :db/id #edb/ref 17592186402082} {:answer/id #uuid "9cf74d58-2c01-59d6-a721-6e7f621cea0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,1,1)$ and $(8,{e}^{2},2{e}^{2})$" :db/id #edb/ref 17592186402083} {:answer/id #uuid "31f3d5ba-15f4-5f33-b534-c97e0bf58653" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(1,1,2)$ and $(8,{e}^{2},2{e}^{2})$" :db/id #edb/ref 17592186402084} {:answer/id #uuid "3fbd3fdc-1447-52b4-83b7-2d0d7c8672c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,1,2)$ and $(8,{e}^{2},2{e}^{2})$" :db/id #edb/ref 17592186402085} {:answer/id #uuid "78a43baf-f3b1-5839-b974-cb8da7856e5a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,1,1)$ and $(4,e,2e)$" :db/id #edb/ref 17592186402086}] :answer-field/correct {:answer/id #uuid "3fbd3fdc-1447-52b4-83b7-2d0d7c8672c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,1,2)$ and $(8,{e}^{2},2{e}^{2})$" :db/id #edb/ref 17592186402085} :answer-field/id #uuid "1c2ccd35-074d-50ff-bf17-a0b3922ccfb0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402081}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5e918f3b-d930-5ea5-9b21-8651bb576465" :question/math-academy-id "q-32918" :question/problem "Given the curve $r(t)=⟨2{t}^{2}\\,,\\,{e}^{t}\\,,\\,2{e}^{t}⟩$, find all of the points at which ${r}^{′}(t)$ and $r(t)$ are parallel." :question/worked-solution "First, we calculate the derivative of $r(t):$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(2{t}^{2}),\\,\\frac{\\text{d}}{\\text{d}t}({e}^{t}),\\,\\frac{\\text{d}}{\\text{d}t}(2{e}^{t})⟩ \\\\  & =⟨4t,\\,{e}^{t},\\,2{e}^{t}⟩\\end{aligned}\n$$\n\nThe vectors ${r}^{′}(t)$ and $r(t)$ are parallel for some specific value ${t}_{0}$ of the parameter $t$ if and only if there exists a constant $c$ such that $r({t}_{0})=c\\,{r}^{′}({t}_{0}).$ So, we have\n\n$$\n\\begin{aligned}r(t) & =c\\,{r}^{′}(t) \\\\ ⟨2{t}^{2},\\,{e}^{t},\\,2{e}^{t}⟩ & =c\\,⟨4t,\\,{e}^{t},\\,2{e}^{t}⟩ \\\\ ⟨2{t}^{2},\\,{e}^{t},\\,2{e}^{t}⟩ & =⟨4ct,\\,c{e}^{t},\\,2c{e}^{t}⟩.\\end{aligned}\n$$\n\nEquating the components gives:\n\n$$\n\\left\\{\\begin{aligned}2{t}^{2} &=4ct \\\\ {e}^{t} &=c{e}^{t} \\\\ 2{e}^{t} &=2c{e}^{t}\\end{aligned}\\right.\n$$\n\nFrom the second and third equations, we obtain that $c=1.$ Substituting into the first equation, we get\n\n$$\n\\begin{aligned}2{t}^{2} & =1\\cdot 4t \\\\ {t}^{2} & =2t \\\\ {t}^{2}-2t & =0 \\\\ t(t-2) & =0.\\end{aligned}\n$$\n\nTherefore, $r$ and ${r}^{′}$ are parallel only at the points corresponding to $t=0$ and $2.$\n\nFinally, since\n\n$$\n\\begin{aligned}r(0) & =⟨2(0)^{2},\\,{e}^{0},\\,2{e}^{0}⟩ \\\\  & =⟨0,\\,1,\\,2⟩ \\\\ r(2) & =⟨2(2)^{2},\\,{e}^{2},\\,2{e}^{2}⟩ \\\\  & =⟨8,\\,{e}^{2},\\,2{e}^{2}⟩,\\end{aligned}\n$$\n\nwe conclude that $r(t)$ and ${r}^{′}(t)$ are parallel at the points $(0,1,2)$ and $(8,{e}^{2},2{e}^{2}).$"}] [{:db/id #edb/ref 17592186120253 :knowledge-point/_questions [{:db/id #edb/ref 17592186119946 :knowledge-point/id #uuid "297a4812-a87a-592a-818a-8c8d3d3f7868" :knowledge-point/title "Finding Points Where a Tangent Vector is Perpendicular to Another Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "105d8229-a994-5b36-807f-9fd8bed4cc3b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,1)$, $(2,2)$, and $(-2,2)$" :db/id #edb/ref 17592186305302} {:answer/id #uuid "b9ced6ca-ed8a-55e8-802c-c638a82568ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,1)$ and $(2,3)$" :db/id #edb/ref 17592186306882} {:answer/id #uuid "fb6f4a1f-017a-5dfe-8714-1e9ec615db0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(2,3)$ and $(-2,3)$" :db/id #edb/ref 17592186307480} {:answer/id #uuid "fe8f7fb7-5f34-5aaf-9ed8-be2001039c9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,3)" :db/id #edb/ref 17592186307501} {:answer/id #uuid "ff80ea7f-e447-5afa-b417-7cf9c8a93c28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,1)" :db/id #edb/ref 17592186307508}] :answer-field/correct {:answer/id #uuid "ff80ea7f-e447-5afa-b417-7cf9c8a93c28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,1)" :db/id #edb/ref 17592186307508} :answer-field/id #uuid "8bf13d17-f785-5b34-aded-5a36a27f0bf1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186307960}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e8969d65-ef55-525e-9adb-a40d8a396669" :question/math-academy-id "q-33498" :question/problem "Given the curve $r(t)=t\\,i+(1+\\frac{1}{2}{t}^{2})\\,j$, find all of the points at which ${r}^{′}(t)$ and $r(t)$ are perpendicular." :question/worked-solution "First, we calculate the derivative of $r(t):$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(t)\\,i+\\frac{\\text{d}}{\\text{d}t}(1+\\frac{1}{2}{t}^{2})\\,j \\\\  & =i+t\\,j\\end{aligned}\n$$\n\nThe vectors $r(t)$ and ${r}^{′}(t)$ are perpendicular for some value of the parameter $t$ if and only if $r(t)\\cdot {r}^{′}(t)=0.$ So, we have\n\n$$\n\\begin{aligned}r(t)\\cdot {r}^{′}(t) & =0 \\\\ [t\\,i+(1+\\frac{1}{2}{t}^{2})\\,j]\\cdot (i+t\\,j) & =0 \\\\ t\\cdot 1+(1+\\frac{1}{2}{t}^{2})\\cdot t & =0 \\\\ 2t+\\frac{1}{2}{t}^{3} & =0 \\\\ t(4+{t}^{2}) & =0.\\end{aligned}\n$$\n\nTherefore, the only solution is $t=0$ since $4+{t}^{2}>0$ for any $t.$\n\nFinally, since\n\n$$\n\\begin{aligned}r(0)=0\\,i+(1+\\frac{1}{2}(0)^{2})\\,j=j,\\end{aligned}\n$$\n\n we conclude that $r(t)$ and ${r}^{′}(t)$ are perpendicular at the point $(0,1).$"}] [{:db/id #edb/ref 17592186311545 :knowledge-point/_questions [{:db/id #edb/ref 17592186119945 :knowledge-point/id #uuid "b4636870-89db-5bf9-8a04-777407957e33" :knowledge-point/title "Finding Points Where a Tangent Vector is Parallel to Another Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51220cfe-c354-523d-8523-5451a12da282" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(1,0,{e}^{-1})$ and $(27,{e}^{3},{e}^{2})$" :db/id #edb/ref 17592186309362} {:answer/id #uuid "56d7157a-d5f4-5554-9056-49e6de0bdfaa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,1,0)$ and $(27,{e}^{3},{e}^{2})$" :db/id #edb/ref 17592186309402} {:answer/id #uuid "9a201dcf-b9c6-5100-8e54-377fdd0130e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,1,{e}^{-1})" :db/id #edb/ref 17592186309989} {:answer/id #uuid "a4a7a750-f514-5110-b363-11ca977cedf0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(27,{e}^{3},{e}^{2})" :db/id #edb/ref 17592186310076} {:answer/id #uuid "f5e8ba54-cc30-5aff-919b-5699852c35a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,1,{e}^{-1})$ and $(27,{e}^{3},{e}^{2})$" :db/id #edb/ref 17592186310703}] :answer-field/correct {:answer/id #uuid "f5e8ba54-cc30-5aff-919b-5699852c35a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,1,{e}^{-1})$ and $(27,{e}^{3},{e}^{2})$" :db/id #edb/ref 17592186310703} :answer-field/id #uuid "a7b816a3-6ca8-5bc2-a569-dfe4101abb7a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186311277}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a2edb181-6dbf-5979-80f4-12f00da0e0f3" :question/math-academy-id "q-33517" :question/problem "Given the curve $r(t)=⟨{t}^{3}\\,,\\,{e}^{t}\\,,\\,{e}^{t-1}⟩$, find all points at which ${r}^{′}(t)$ and $r(t)$ are parallel." :question/worked-solution "First, we calculate the derivative of $r(t):$ \n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}({t}^{3}),\\,\\frac{\\text{d}}{\\text{d}t}({e}^{t}),\\,\\frac{\\text{d}}{\\text{d}t}({e}^{t-1})⟩ \\\\  & =⟨3{t}^{2},\\,{e}^{t},\\,{e}^{t-1}⟩\\end{aligned}\n$$\n\nThe vectors ${r}^{′}(t)$ and $r(t)$ are parallel for some specific value ${t}_{0}$ of the parameter $t$ if and only if there exists a constant $c$ such that $r({t}_{0})=c\\,{r}^{′}({t}_{0}).$ So, we have\n\n$$\n\\begin{aligned}r(t) & =c\\,{r}^{′}(t) \\\\ ⟨{t}^{3}\\,,\\,{e}^{t}\\,,\\,{e}^{t-1}⟩ & =c\\,⟨3{t}^{2},\\,{e}^{t},\\,{e}^{t-1}⟩.\\end{aligned}\n$$\n\n  \n\nEquating the components gives:\n\n$$\n\\left\\{\\begin{aligned}{t}^{3} &=c(3{t}^{2}) \\\\ {e}^{t} &=c{e}^{t} \\\\ {e}^{t-1} &=c{e}^{t-1}\\end{aligned}\\right.\n$$\n\nFrom the second and third equations, we obtain that $c=1.$ Substituting $c=1$ into the first equation gives:\n\n$$\n\\begin{aligned}{t}^{3} & =3{t}^{2} \\\\ {t}^{3}-3{t}^{2} & =0 \\\\ {t}^{2}(t-3) & =0\\end{aligned}\n$$\n\n \n\nTherefore, $r$ and ${r}^{′}$ are parallel only at the points corresponding to $t=0$, and $t=3.$\n\nFinally, since\n\n$$\n\\begin{aligned}r(0) & =⟨{0}^{3},\\,{e}^{0},\\,{e}^{0-1}⟩ \\\\  & =⟨0,\\,1,\\,{e}^{-1}⟩ \\\\ r(3) & =⟨{3}^{3},\\,{e}^{3},\\,{e}^{3-1}⟩ \\\\  & =⟨27,\\,{e}^{3},\\,{e}^{2}⟩,\\end{aligned}\n$$\n\n we conclude that $r(t)$ and ${r}^{′}(t)$ are parallel at the points $(0,1,{e}^{-1})$ and $(27,{e}^{3},{e}^{2}).$"}] [{:db/id #edb/ref 17592186120522 :knowledge-point/_questions [{:db/id #edb/ref 17592186119946 :knowledge-point/id #uuid "297a4812-a87a-592a-818a-8c8d3d3f7868" :knowledge-point/title "Finding Points Where a Tangent Vector is Perpendicular to Another Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aa703ceb-74c9-5dee-8e05-e7c86851cc71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{1}{e}, \\sqrt{2})" :db/id #edb/ref 17592186119247} {:answer/id #uuid "d7f9a1f1-2c06-56ec-bd74-830d94218afc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(e, \\sqrt{2})$ and $(\\frac{1}{e}, \\sqrt{2})$" :db/id #edb/ref 17592186119248} {:answer/id #uuid "0d7eb6ff-644a-5129-84c1-90e08a05aaaf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(1, 1)$ and $(\\frac{1}{e}, \\sqrt{2})$" :db/id #edb/ref 17592186119249} {:answer/id #uuid "44fd0cca-6a31-50cf-b3ae-80af5da56481" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1, 1)" :db/id #edb/ref 17592186119250} {:answer/id #uuid "560cd185-92ba-541e-8b98-914d97b7276d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(1, 1)$ and $(e, \\sqrt{2})$" :db/id #edb/ref 17592186119251}] :answer-field/id #uuid "38f2b35d-cdc7-57a8-b086-71abb39f3628" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186119246} {:answer-field/choices [{:answer/id #uuid "77f84ef6-724c-531f-b459-e7fb46313f95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,1)" :db/id #edb/ref 17592186399045} {:answer/id #uuid "5851d6e2-d46e-5f7e-8a20-cfb7107da393" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(e,\\sqrt{2})$ and  $(\\frac{1}{e},\\sqrt{2})$" :db/id #edb/ref 17592186399046} {:answer/id #uuid "3d50a6a9-757b-54ed-a3ea-ef9ca589d5e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(1,1)$ and  $(\\frac{1}{e},\\sqrt{2})$" :db/id #edb/ref 17592186399047} {:answer/id #uuid "97b1304b-b551-5fd9-9ab2-1c990972017a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(1,1)$ and $(e,\\sqrt{2})$" :db/id #edb/ref 17592186399048} {:answer/id #uuid "ee3fd924-6b61-5f7a-b8ee-202868ddd4db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{1}{e},\\sqrt{2})" :db/id #edb/ref 17592186399049}] :answer-field/correct {:answer/id #uuid "77f84ef6-724c-531f-b459-e7fb46313f95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,1)" :db/id #edb/ref 17592186399045} :answer-field/id #uuid "dcae9219-7cb1-51fe-8fd8-6746ddea2ac6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399044}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e1694262-cdf1-5325-9fc5-66702cda46da" :question/math-academy-id "q-75519" :question/problem "Given the curve $r(t)=⟨{e}^{t}\\,,\\,\\sqrt{1+{t}^{2}}⟩,$ find all of the points at which the tangent to the curve is perpendicular to the vector $⟨0\\,,\\,1⟩.$" :question/worked-solution "First, we calculate the derivative of $r(t):$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}{e}^{t}\\,,\\,\\frac{\\text{d}}{\\text{d}t}\\sqrt{1+{t}^{2}}⟩ \\\\  & =⟨{e}^{t}\\,,\\,\\frac{t}{\\sqrt{1+{t}^{2}}}⟩\\end{aligned}\n$$\n\nThe vectors  $⟨0\\,,\\,1⟩$ and ${r}^{′}(t)$ are perpendicular for some value of the parameter $t$ if and only if $⟨0\\,,\\,1⟩\\cdot {r}^{′}(t)=0.$ So, we have\n\n$$\n\\begin{aligned}⟨0\\,,\\,1⟩\\cdot {r}^{′}(t) & =0 \\\\ ⟨0\\,,\\,1⟩\\cdot ⟨{e}^{t}\\,,\\,\\frac{t}{\\sqrt{1+{t}^{2}}}⟩ & =0 \\\\ 0\\cdot {e}^{t}+1\\cdot \\frac{t}{\\sqrt{1+{t}^{2}}} & =0 \\\\ \\frac{t}{\\sqrt{1+{t}^{2}}} & =0 \\\\ t & =0.\\end{aligned}\n$$\n\nTherefore, the only solution is $t=0.$\n\nFinally, since\n\n$$\n\\begin{aligned}r(0) & =⟨{e}^{0}\\,,\\,\\sqrt{1+{0}^{2}}⟩=⟨1\\,,\\,1⟩,\\end{aligned}\n$$\n\nwe conclude that $⟨0\\,,\\,1⟩$ and ${r}^{′}(t)$ are perpendicular at the point $(1,1).$"}]}
