    "q-158585": {
      "dom_id": "step-q158585",
      "name": "Question 2",
      "problem": "Evaluate $z={2}^{-x}+\\frac{1}{y}$ at the point $(2,2).$",
      "worked_solution": "To evaluate our multivariable function at the point $(2,2),$ we substitute $x=2$ and $y=2$ into the function expression:\n\n$$\n\\begin{aligned}z\\,{|}_{(2,2)} & =({2}^{-x}+\\frac{1}{y}){|}_{(2,2)} \\\\  & ={2}^{-2}+\\frac{1}{2} \\\\  & =\\frac{1}{{2}^{2}}+\\frac{1}{2} \\\\  & =\\frac{1}{4}+\\frac{1}{2} \\\\  & =\\frac{3}{4}\\end{aligned}\n$$",
      "calculator_instructions": "",
      "fields": [
        {
          "key": "selection",
          "type": "radio",
          "choices": [
            {
              "option": "a",
              "dom_id": "questionWidget-choiceLetterCircle-158585-a",
              "type": "math",
              "value": "\\frac{1}{2}",
