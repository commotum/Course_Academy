    "q-158553": {
      "dom_id": "step-q158553",
      "name": "Question 6",
      "problem": "Find the domain of the function $f(x,y)=\\frac{1}{2x+y}.$",
      "worked_solution": "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The expression in the denominator is not equal to zero.\n\nAs a result, the points in the domain must satisfy the following inequality:\n\n$$\n2x+y\\ne 0\n$$\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,2x+y\\ne 0\\}.\n$$",
      "calculator_instructions": "",
      "fields": [
        {
          "key": "selection",
          "type": "radio",
          "choices": [
            {
              "option": "a",
              "dom_id": "questionWidget-choiceLetterCircle-158553-a",
              "type": "math",
