><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>2</mn><mo stretchy=\"false\">(</mo><mo>−</mo><mn>2</mn><mo stretchy=\"false\">)</mo><mo>−</mo><mn>2</mn></mrow><mrow><msup><mn>2</mn><mn>3</mn></msup><mo>−</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mn>2</mn><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup><mo>−</mo><mn>4</mn></mrow></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mo>−</mo><mn>4</mn><mo>−</mo><mn>2</mn></mrow><mrow><mn>8</mn><mo>−</mo><mn>4</mn><mo>−</mo><mn>4</mn></mrow></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mo stretchy=\"false\">(</mo><mo>−</mo><mn>6</mn><mo stretchy=\"false\">)</mo></mrow><mn>0</mn></mfrac></mstyle><mo>,</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container>\nwhich is undefined.</p>\n</div></div>",
