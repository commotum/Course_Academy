#{[{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186125620} :activity/id #uuid "38eb3394-b723-5b5e-b0fc-8803e6b62fac" :activity/scope {:db/id #edb/ref 17592186050992 :topic/id #uuid "77b779f9-f0f6-53e5-821f-44c6d9f4ce47" :topic/math-academy-id 1899} :activity/steps [{:db/id #edb/ref 17592186125608 :step/content {:db/id #edb/ref 17592186125865 :tutorial/content "Another way of visualizing a two-variable function is to draw its graph as a **surface** in a three-dimensional coordinate system. \n\nFor example, consider the function\n\n$$\nz = f(x,y) = x^2 +y^2, \\quad (x,y)\\in D\n$$\n\nwhere the (restricted) domain is given by the unit disc \n\n$$\nD = \\big\\{ (x,y)\\in\\mathbb R^2 \\: : \\: x^2+y^2 \\leq 1 \\big\\}.\n$$\n\nThe graph of $f$ is a surface that consists of all the points with coordinates\n\n$$\n(x, \\, y, \\, f(x,y)), \\quad (x,y) \\in D,\n$$\n\nas shown below.\n\n![](images/a3/a3c9c7eca49a0f828e53c0775afac16335033c1a8881367e49098bf7125ee2e6.png)\n\n  \n\nNotice that range of $f$ is represented by the interval $R=[0,1]$ on the vertical $z$-axis. It consists of the possible $z$-coordinates of the points on our surface." :tutorial/id #uuid "9bf49e76-e25e-5191-ad7f-95028f749c37" :tutorial/math-academy-id 6920 :tutorial/title "The Graph of a Two-Variable Function"} :step/id #uuid "fc31f470-ef05-57c5-83e5-74d5c5660924" :step/math-academy-id 41878 :step/next {:db/id #edb/ref 17592186125609}} {:db/id #edb/ref 17592186125609 :step/content {:db/id #edb/ref 17592186124636 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124194 :question/id #uuid "a2c947c7-9873-5137-91ca-4fe0b42e9bb7" :question/math-academy-id "e-11021"} :knowledge-point/id #uuid "0e593685-f5ca-5501-94bf-7cb4d49e935b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050344} {:db/id #edb/ref 17592186050642}] :knowledge-point/questions [{:db/id #edb/ref 17592186124796} {:db/id #edb/ref 17592186124799} {:db/id #edb/ref 17592186275453} {:db/id #edb/ref 17592186278204} {:db/id #edb/ref 17592186278205} {:db/id #edb/ref 17592186278206} {:db/id #edb/ref 17592186278207} {:db/id #edb/ref 17592186278209} {:db/id #edb/ref 17592186378773} {:db/id #edb/ref 17592186378780} {:db/id #edb/ref 17592186378787} {:db/id #edb/ref 17592186435808} {:db/id #edb/ref 17592186435809} {:db/id #edb/ref 17592186564467} {:db/id #edb/ref 17592186564505} {:db/id #edb/ref 17592186564512}] :knowledge-point/title "The Domain of a Function Involving Reciprocals and Radicals"} :step/id #uuid "7be0d289-aa76-565b-b554-0640ab33fae2" :step/math-academy-id 41879 :step/next {:db/id #edb/ref 17592186125614}} {:db/id #edb/ref 17592186125610 :step/content {:db/id #edb/ref 17592186124637 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124195 :question/id #uuid "42cbeba7-685e-5782-9695-9671d16b7f80" :question/math-academy-id "e-11022"} :knowledge-point/id #uuid "9e4fd256-a726-523c-84dc-f62d4e2711cc" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048439}] :knowledge-point/questions [{:db/id #edb/ref 17592186124800} {:db/id #edb/ref 17592186124801} {:db/id #edb/ref 17592186124802} {:db/id #edb/ref 17592186275454} {:db/id #edb/ref 17592186275455} {:db/id #edb/ref 17592186275456} {:db/id #edb/ref 17592186378746} {:db/id #edb/ref 17592186378829} {:db/id #edb/ref 17592186388981} {:db/id #edb/ref 17592186388988} {:db/id #edb/ref 17592186388995} {:db/id #edb/ref 17592186564477} {:db/id #edb/ref 17592186564517} {:db/id #edb/ref 17592186564538}] :knowledge-point/title "Sketching the Domain of a Multivariable Function"} :step/id #uuid "a7e9f458-f87e-5aa2-a10b-9d3c56318005" :step/math-academy-id 41882} {:db/id #edb/ref 17592186125611 :step/content {:db/id #edb/ref 17592186124638 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124196 :question/id #uuid "59fa0287-0562-5cf2-8469-946a69dc8adf" :question/math-academy-id "e-11025"} :knowledge-point/id #uuid "f9289c4d-4f7f-5704-a2cb-272f92d8fef3" :knowledge-point/questions [{:db/id #edb/ref 17592186124803} {:db/id #edb/ref 17592186124804} {:db/id #edb/ref 17592186278211} {:db/id #edb/ref 17592186278213} {:db/id #edb/ref 17592186278215} {:db/id #edb/ref 17592186278216} {:db/id #edb/ref 17592186278217} {:db/id #edb/ref 17592186378801} {:db/id #edb/ref 17592186378822} {:db/id #edb/ref 17592186435810} {:db/id #edb/ref 17592186564508} {:db/id #edb/ref 17592186564511} {:db/id #edb/ref 17592186564520}] :knowledge-point/title "Evaluating a Two-Variable Function"} :step/id #uuid "7cb633e3-6b78-502b-8402-00d3cc9b88b4" :step/math-academy-id 41892 :step/next {:db/id #edb/ref 17592186125621}} {:db/id #edb/ref 17592186125614 :step/content {:db/id #edb/ref 17592186124640 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124198 :question/id #uuid "bdae9fe0-a491-531b-ac36-7a37d2c32f16" :question/math-academy-id "e-11029"} :knowledge-point/id #uuid "88f2bc84-03e8-5921-81e2-683a09195279" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048794} {:db/id #edb/ref 17592186049984} {:db/id #edb/ref 17592186050064} {:db/id #edb/ref 17592186050829}] :knowledge-point/questions [{:db/id #edb/ref 17592186124797} {:db/id #edb/ref 17592186124798} {:db/id #edb/ref 17592186124808} {:db/id #edb/ref 17592186278210} {:db/id #edb/ref 17592186278212} {:db/id #edb/ref 17592186278214} {:db/id #edb/ref 17592186378794} {:db/id #edb/ref 17592186378808} {:db/id #edb/ref 17592186378815} {:db/id #edb/ref 17592186401123} {:db/id #edb/ref 17592186435806} {:db/id #edb/ref 17592186435807} {:db/id #edb/ref 17592186564498} {:db/id #edb/ref 17592186564504} {:db/id #edb/ref 17592186564533} {:db/id #edb/ref 17592186564534}] :knowledge-point/title "The Domain of a Function Containing Exponential, Logarithmic, and Trigonometric Functions"} :step/id #uuid "b55f77a9-8540-5fb3-b460-fd3dba21c5e1" :step/math-academy-id 41906 :step/next {:db/id #edb/ref 17592186125610}} {:db/id #edb/ref 17592186125620 :step/content {:db/id #edb/ref 17592186125868 :tutorial/content "A function $f(x,y)$ of two variables is a rule that maps each pair of numbers $(x,y)\\in D$ to a unique real number. Under this notation, $D\\subseteq \\mathbb R^2$ is the **domain** of $f.$\n\nFor instance, consider the following two-variable function: \n\n$$\nf(x,y) = \\dfrac{\\sin(xy)}{\\sqrt{x-1}}\n$$\n\nWe can evaluate this function by substituting concrete pairs of numbers for $x$ and $y{:}$\n\n- Let's evaluate $f(x,y)$ at the point $(2, \\pi).$ To do that, we substitute $x=2$ and $y=\\pi$ into the function expression: \n\n$$\n\\begin{aligned}f(2,\\pi ) & =\\frac{\\operatorname{sin}⁡(xy)}{\\sqrt{x-1}}{|}_{(2,\\pi )} \\\\  & =\\frac{\\operatorname{sin}⁡(2\\cdot \\pi )}{\\sqrt{2-1}} \\\\  & =\\frac{0}{1} \\\\  & =0\\end{aligned}\n$$\n\nSince $f(2,\\pi)$ returned a unique real number, this means that $(2,\\pi)$ belongs to the domain of $f,$ i.e., $(2,\\pi)\\in D.$\n\n- Let's now try to evaluate $f(x,y)$ at the point $(0, \\pi).$ To do that, we substitute $x=0$ and $y=\\pi$ into the function expression: \n\n$$\n\\begin{aligned}f(0,\\pi ) & =\\frac{\\operatorname{sin}⁡(xy)}{\\sqrt{x-1}}{|}_{(0,\\pi )} \\\\  & =\\frac{\\operatorname{sin}⁡(0\\cdot \\pi )}{\\sqrt{0-1}} \\\\  & =\\frac{0}{\\sqrt{-1}}\\end{aligned}\n$$\n\nwhich is undefined over the real numbers.\n\nSince $f(0,\\pi)$ did not return a unique *real* number, this means that $(0,\\pi)\\notin D.$\n\nWe can also have functions of three variables $f(x,y,z),$ functions of four variables, $f(x_1,x_2,x_3,x_4),$ etc. There is no limit to the number of variables a function can have. Functions with more than one variable are called **multivariable functions.**" :tutorial/id #uuid "8d127fec-12ff-5644-b095-33e9b94a52d1" :tutorial/math-academy-id 7034 :tutorial/title "Introduction"} :step/id #uuid "8bf79d7f-8d55-5330-9913-9bcd94008524" :step/math-academy-id 42402 :step/next {:db/id #edb/ref 17592186125611}} {:db/id #edb/ref 17592186125621 :step/content {:db/id #edb/ref 17592186125869 :tutorial/content "The **domain** of a multivariable function is the set of points where the function is defined. \n\nFor example, consider the function \n\n$$\nz = f(x,y) =  \\sqrt{1 -x^2 -y^2}.\n$$\n\nThe function is well-defined at all points $(x,y)$ for which the expression under the square root is non-negative. As a result, the points in the domain must satisfy the following inequality:\n\n$$\n1 - x^2 - y^2 \\geq 0 \n\\qquad\\Longrightarrow\\qquad\nx^2 + y^2 \\leq 1\n$$\n\nTherefore, the domain is\n\n$$\nD = \\big\\{ (x,y)\\in\\mathbb R^2 \\,:\\, x^2 + y^2 \\leq 1 \\big\\}.\n$$\n\nGeometrically, the domain of our function is a disc of radius $1$ centered at the origin in the $xy$-plane, as shown on the left diagram below.\n\n![](images/86/8642db9fd933ec2f15c6712c713cfaec8fb20052066dcca3915904190d3551fa.png)\n\nEach point in this domain is uniquely mapped to a real number $z.$ Possible values of $z$ can be visualized on a separate axis (depicted by the diagram on the right). \n\nIf $(x,y)$ is allowed to run over the entire domain, the set of points on the $z$-axis where the values of $f(x,y)$ land is called the **range** of the function. For this function, the range is $z\\in [0,1].$\n\nNote the following:\n\n- When discussing a function's domain, we usually refer to the so-called **natural domain**, the largest set of values for which the function is defined.\n\n- We can also *restrict* the domain of a function to a subset of the natural domain. For example, we might restrict the domain of $f$ to all values of $y$ in the upper-half plane. In this case, we'd write\n\n$$\nf(x,y) =  \\sqrt{1 -x^2 -y^2}, \\quad (x,y)\\in D, \\quad D = \\big\\{ (x,y)\\in\\mathbb R^2 \\,:\\, x^2 + y^2 \\leq 1, \\: y\\geq 0 \\big\\}.\n$$\n\nThis gives a domain/range diagram that looks as follows.\n\n![](images/fb/fbab832d984232b0b3b951579e5ee2727e92c9f4bf496d4fffe82f7230cfbb14.png)\n\nIn this case, restricting the domain does not affect the range. However, in general, restricting the domain *will* affect the range." :tutorial/id #uuid "d81a3bfc-ca0f-528c-ad48-e606581c6d6c" :tutorial/math-academy-id 7035 :tutorial/title "The Domain and Range of a Two-Variable Function"} :step/id #uuid "177400d3-2550-582c-ad75-57483a6bbe30" :step/math-academy-id 42403 :step/next {:db/id #edb/ref 17592186125608}}] :activity/title "The Domain of a Multivariable Function" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186124701}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186421873} :activity/id #uuid "b2fb8c6f-93f0-54a5-8f0c-d3aee90f2a9b" :activity/scope {:db/id #edb/ref 17592186050992 :topic/id #uuid "77b779f9-f0f6-53e5-821f-44c6d9f4ce47" :topic/math-academy-id 1899} :activity/steps [{:db/id #edb/ref 17592186421871 :step/content {:db/id #edb/ref 17592186124801 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01afdd60-14a5-5347-97c0-b145df6c08f5" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/93/934de8df0f2c2a0c93d3966a66f1eed69744079f4beee57d7cc46e6ca20fddcb.png" :db/id #edb/ref 17592186121404} {:answer/id #uuid "42fd1e88-b1bd-520d-91af-11e4da73aadd" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/09/09a061a81ca4b3201e9b97ad15354c14003e41d610c2892f5b6ba468761e83b7.png" :db/id #edb/ref 17592186121405} {:answer/id #uuid "52848fa8-e0a8-5d95-b7e3-ee8a85dd9598" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/40/407b19e99e4fe935cc353c18afcd8576bc4a8d6fa10f5d059ff1b4a7005f4f21.png" :db/id #edb/ref 17592186121406} {:answer/id #uuid "6dae1c1d-e85c-5ad2-95d5-247890638d6a" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/80/800cc48a7cbe24b302e3ea0d4ddd156bd33cb1ad45d8dafbbcef20b997c24585.png" :db/id #edb/ref 17592186121407} {:answer/id #uuid "7839d4ad-f7d4-57b2-a944-52dd9c55849d" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/28/280ac039d18c0af132b0a2a85a3b94226c7ff2b310c460a1086d52402bc41865.png" :db/id #edb/ref 17592186121408}] :answer-field/correct {:db/id #edb/ref 17592186121408} :answer-field/id #uuid "51e5d630-8dfa-5699-9375-937c6eb03e4f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186121403}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "036420cb-4253-5cbd-8d56-15a7f64df030" :question/math-academy-id "q-158197" :question/problem "Which of the following shaded regions corresponds to the domain of the function $g(x,y)=\\frac{1}{x-y}?$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The expression in the denominator is not equal to zero.\n\nAs a result, the points in the domain must satisfy the following inequality:\n\n$$\nx-y\\ne 0\\,⟹\\,y\\ne x\n$$\n\nTherefore, the domain is\n\n$$\nD={(x,y)\\in {R}^{2}\\,:\\,y\\ne x}.\n$$\n\nSince the expression involves the $\\ne $ sign, the line is *not* part of the domain. Therefore, we draw the dashed line $y=x$ and shade *above* and *below* the line.\n\nThe resulting domain is as follows:\n\n![](images/69/6953e2f817a786ae5ea52ea224a31b12a40a3ca89999a6bd5b1453eec11f8559.png)"} :step/id #uuid "1967cc1b-8c66-55dd-a6aa-4a116ffa9f8c"} {:db/id #edb/ref 17592186421872 :step/content {:db/id #edb/ref 17592186124798 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7ed55f36-0c59-534d-95e8-07b34cf2dc0d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,-1\\le x-y\\le 1}" :db/id #edb/ref 17592186273476} {:answer/id #uuid "8cbe26d2-a7ea-57c3-b47a-0b429892c77c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,-\\frac{\\pi }{2}\\le x-y\\le \\frac{\\pi }{2}}" :db/id #edb/ref 17592186273604} {:answer/id #uuid "a40eb757-e322-5c5a-ae24-103986e65d27" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,0\\le x-y\\le \\pi }" :db/id #edb/ref 17592186273802} {:answer/id #uuid "b8517e7a-c661-562c-81e8-faa0f8fe98e9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,-1\\le x-y\\le 1,\\,x>0}" :db/id #edb/ref 17592186273983} {:answer/id #uuid "db332580-91a3-58b1-ad8e-07bfc400b3ca" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The domain is the entire $xy$-plane" :db/id #edb/ref 17592186274306}] :answer-field/correct {:db/id #edb/ref 17592186273476} :answer-field/id #uuid "5b7c962d-3d23-53a3-911a-272dffdfe63f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186274793}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "8d83dba6-238e-5ccd-970d-da3225e73ce3" :question/math-academy-id "q-158181" :question/problem "Find the domain of the function  $f(x,y)=\\operatorname{arccos}⁡(x-y).$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The argument of the arccosine has values between $-1$ and $1.$\n\nAs a result, the points in the domain must satisfy the following inequality:\n\n$$\n-1\\le x-y\\le 1\n$$\n\nTherefore, the domain is\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,-1\\le x-y\\le 1}.\n$$"} :step/id #uuid "596527ae-7d3c-5d49-9792-ae1c3070a5b2" :step/next {:db/id #edb/ref 17592186421871}} {:db/id #edb/ref 17592186421873 :step/content {:db/id #edb/ref 17592186275453 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "df3e244c-ae04-56cb-8d2f-103fe2a767ab" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The domain is the entire $xy$-plane" :db/id #edb/ref 17592186274357} {:answer/id #uuid "0401f3db-693c-55a6-a2a6-cdcb8f618641" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}<0\\}" :db/id #edb/ref 17592186563976} {:answer/id #uuid "56d57d91-2728-51bc-b291-e2245cc07a65" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}\\le 1\\}" :db/id #edb/ref 17592186564108} {:answer/id #uuid "b88c88cc-ef4e-5607-aff6-aeedbfce6369" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}>1\\}" :db/id #edb/ref 17592186564254} {:answer/id #uuid "cc963b79-b269-5331-848d-67f4ee353859" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}<1\\}" :db/id #edb/ref 17592186564289}] :answer-field/correct {:db/id #edb/ref 17592186564289} :answer-field/id #uuid "7d3ee636-ed6b-5d29-ac3b-8e818ea5617f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186274851}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8022d60c-ad02-52ea-a2bc-6bcc108f5f02" :question/math-academy-id "q-158179" :question/problem "Find the domain of the function $z=\\frac{1}{\\sqrt{1-{x}^{2}-{y}^{2}}}.$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following conditions are satisfied:\n\n- The expression in the denominator is not equal to zero, and\n\n- the expression under the square root is non-negative.\n\nAs a result, the points in the domain must satisfy the following inequality:\n\n$$\n\\begin{aligned}1-{x}^{2}-{y}^{2}>0\\,⟹\\,{x}^{2}+{y}^{2}<1\\end{aligned}\n$$\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}<1\\}.\n$$"} :step/id #uuid "e9dc22fd-7547-5b94-95b7-ace0ad096377" :step/next {:db/id #edb/ref 17592186421872}}] :activity/title "The Domain of a Multivariable Function" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186421870}]}
