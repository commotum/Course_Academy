ned}\n$$"] ["question-9c34765f-7311-53ab-be9b-191b42487450" :question/difficulty :question.difficulty/easy] ["answer-field-893376bc-f857-5c82-9b7f-472d1ddbccda" :answer-field/id #uuid "893376bc-f857-5c82-9b7f-472d1ddbccda"] ["answer-dbef1e38-02bf-5cd7-beba-116a24ac4bd4" :answer/id #uuid "dbef1e38-02bf-5cd7-beba-116a24ac4bd4"] ["answer-dbef1e38-02bf-5cd7-beba-116a24ac4bd4" :answer/type :answer.type/math] ["answer-dbef1e38-02bf-5cd7-beba-116a24ac4bd4" :answer/value "1"] ["answer-8ca77a3e-9085-58ef-87e4-a39c3ee58fbe" :answer/id #uuid "8ca77a3e-9085-58ef-87e4-a39c3ee58fbe"] ["answer-8ca77a3e-9085-58ef-87e4-a39c3ee58fbe" :answer/type :answer.type/math] ["answer-8ca77a3e-9085-58ef-87e4-a39c3ee58fbe" :answer/value "\\frac{1}{2}"] ["answer-c4a63f4b-3cca-51c6-b369-5d4f828546a4" :answer/id #uuid "c4a63f4b-3cca-51c6-b369-5d4f828546a4"] ["answer-c4a63f4b-3cca-51c6-b369-5d4f828546a4" :answer/type :answer.type/math] ["answer-c4a63f4b-3cca-51c6-b369-5d4f828546a4" :answer/value "\\frac{3}{2}"] ["answer-a69cfe99-5dda-5c7f-a8ae-e9e88f862d43" :answer/id #uuid "a69cfe99-5dda-5c7f-a8ae-e9e88f862d43"] ["answer-a69cfe99-5dda-5c7f-a8ae-e9e88f862d43" :answer/type :answer.type/math] ["answer-a69cfe99-5dda-5c7f-a8ae-e9e88f862d43" :answer/value "\\frac{3}{4}"] ["answer-e866b3d9-12d2-51c5-a482-af43a7c89490" :answer/id #uuid "e866b3d9-12d2-51c5-a482-af43a7c89490"] ["answer-e866b3d9-12d2-51c5-a482-af43a7c89490" :answer/type :answer.type/math] ["answer-e866b3d9-12d2-51c5-a482-af43a7c89490" :answer/value "\\frac{5}{4}"] ["answer-field-893376bc-f857-5c82-9b7f-472d1ddbccda" :answer-field/key "selection"] ["answer-field-893376bc-f857-5c82-9b7f-472d1ddbccda" :answer-field/type :answer-field.type/radio] ["answer-field-893376bc-f857-5c82-9b7f-472d1ddbccda" :answer-field/correct "answer-a69cfe99-5dda-5c7f-a8ae-e9e88f862d43"] ["answer-field-893376bc-f857-5c82-9b7f-472d1ddbccda" :answer-field/choices "answer-dbef1e38-02bf-5cd7-beba-116a24ac4bd4"] ["answer-field-893376bc-f857-5c82-9b7f-472d1ddbccda" :answer-field/choices "answer-8ca77a3e-9085-58ef-87e4-a39c3ee58fbe"] ["answer-field-893376bc-f857-5c82-9b7f-472d1ddbccda" :answer-field/choices "answer-c4a63f4b-3cca-51c6-b369-5d4f828546a4"] ["answer-field-893376bc-f857-5c82-9b7f-472d1ddbccda" :answer-field/choices "answer-a69cfe99-5dda-5c7f-a8ae-e9e88f862d43"] ["answer-field-893376bc-f857-5c82-9b7f-472d1ddbccda" :answer-field/choices "answer-e866b3d9-12d2-51c5-a482-af43a7c89490"] ["question-9c34765f-7311-53ab-be9b-191b42487450" :question/answer-fields "answer-field-893376bc-f857-5c82-9b7f-472d1ddbccda"] [17592186124638 :knowledge-point/questions "question-9c34765f-7311-53ab-be9b-191b42487450"] [17592186124804 :question/problem "Evaluate $z={x}^{2}+xy-5$ at the point $(1,2).$"] [17592186124804 :question/worked-solution "To evaluate our multivariable function at the point $(1,2),$ we substitute $x=1$ and $y=2$ into the function expression:\n\n$$\n\\begin{aligned}z\\,{|}_{(1,2)} & =({x}^{2}+xy-5)\\,{|}_{(1,2)} \\\\  & =(1)^{2}+(1)(2)-5 \\\\  & =-2\\end{aligned}\n$$"] [17592186124804 :question/difficulty :question.difficulty/easy] [17592186121421 :answer-field/correct 17592186121426] ["question-be7cd3c6-b4d8-58fc-a0bb-f9185ad55778" :question/id #uuid "be7cd3c6-b4d8-58fc-a0bb-f9185ad55778"] ["question-be7cd3c6-b4d8-58fc-a0bb-f9185ad55778" :question/math-academy-id "q-158568"] ["question-be7cd3c6-b4d8-58fc-a0bb-f9185ad55778" :question/problem "The function $f(x,y)$ is defined as \n\n$$\nf(x,y)=x\\operatorname{arccos}⁡(y+1).\n$$\n\nEvaluate this function at the point $(-3,1).$"] ["question-be7cd3c6-b4d8-58fc-a0bb-f9185ad55778" :question/worked-solution "To evaluate our multivariable function at the point $(-3,1),$ we substitute $x=-3$ and $y=1$ into the function expression:\n\n$$\n\\begin{aligned}f(-3,1) & =x\\operatorname{arccos}⁡(y+1)\\,{|}_{(-3,1)} \\\\  & =-3\\operatorname{arccos}⁡(1+1) \\\\  & =-3\\operatorname{arccos}⁡2,\\end{aligned}\n$$\n\nwhich is undefined."] ["question-be7cd3c6-b4d8-58fc-a0bb-f9185ad55778" :question/difficulty :question.difficulty/moderate] ["answer-field-10d9af3a-10f7-5e92-bc23-9dd627657054" :answer-field/id #uuid "10d9af3a-10f7-5e92-bc23-9dd627657054"] ["answer-9f3293bb-1f94-5c8d-a23a-3cb06b1be4a9" :answer/id #uuid "9f3293bb-1f94-5c8d-a23a-3cb06b1be4a9"] ["answer-9f3293bb-1f94-5c8d-a23a-3cb06b1be4a9" :answer/type :answer.type/math] ["answer-9f3293bb-1f94-5c8d-a23a-3cb06b1be4a9" :answer/value "-3\\pi "] ["answer-3790236b-105a-5b9e-9ebd-ef017e764624" :answer/id #uuid "3790236b-105a-5b9e-9ebd-ef017e764624"] ["answer-3790236b-105a-5b9e-9ebd-ef017e764624" :answer/type :answer.type/math] ["answer-3790236b-105a-5b9e-9ebd-ef017e764624" :answer/value "-\\frac{3\\pi }{2}"] ["answer-6e1679b6-2cd1-5f54-b5fb-e698dad4fee7" :answer/id #uuid "6e1679b6-2cd1-5f54-b5fb-e698dad4fee7"] ["answer-6e1679b6-2cd1-5f54-b5fb-e698dad4fee7" :answer/type :answer.type/math] ["answer-6e1679b6-2cd1-5f54-b5fb-e698dad4fee7" :answer/value "0"] ["answer-88f4eee4-d9a2-56a3-9cd0-87f68eac7ef2" :answer/id #uuid "88f4eee4-d9a2-56a3-9cd0-87f68eac7ef2"] ["answer-88f4eee4-d9a2-56a3-9cd0-87f68eac7ef2" :answer/type :answer.type/math] ["answer-88f4eee4-d9a2-56a3-9cd0-87f68eac7ef2" :answer/value "\\frac{\\pi }{2}"] ["answer-6348d00d-0685-5ea8-9c47-f047fe568924" :answer/id #uuid "6348d00d-0685-5ea8-9c47-f047fe568924"] ["answer-6348d00d-0685-5ea8-9c47-f047fe568924" :answer/type :answer.type/text] ["answer-6348d00d-0685-5ea8-9c47-f047fe568924" :answer/value "Undefined"] ["answer-field-10d9af3a-10f7-5e92-bc23-9dd627657054" :answer-field/key "selection"] ["answer-field-10d9af3a-10f7-5e92-bc23-9dd627657054" :answer-field/type :answer-field.type/radio] ["answer-field-10d9af3a-10f7-5e92-bc23-9dd627657054" :answer-field/correct "answer-6348d00d-0685-5ea8-9c47-f047fe568924"] ["answer-field-10d9af3a-10f7-5e92-bc23-9dd627657054" :answer-field/choices "answer-9f3293bb-1f94-5c8d-a23a-3cb06b1be4a9"] ["answer-field-10d9af3a-10f7-5e92-bc23-9dd627657054" :answer-field/choices "answer-3790236b-105a-5b9e-9ebd-ef017e764624"] ["answer-field-10d9af3a-10f7-5e92-bc23-9dd627657054" :answer-field/choices "answer-6e1679b6-2cd1-5f54-b5fb-e698dad4fee7"] ["answer-field-10d9af3a-10f7-5e92-bc23-9dd627657054" :answer-field/choices "answer-88f4eee4-d9a2-56a3-9cd0-87f68eac7ef2"] ["answer-field-10d9af3a-10f7-5e92-bc23-9dd627657054" :answer-field/choices "answer-6348d00d-0685-5ea8-9c47-f047fe568924"] ["question-be7cd3c6-b4d8-58fc-a0bb-f9185ad55778" :question/answer-fields "answer-field-10d9af3a-10f7-5e92-bc23-9dd627657054"] [17592186124638 :knowledge-point/questions "question-be7cd3c6-b4d8-58fc-a0bb-f9185ad55778"] [17592186278204 :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The expression in the denominator is not equal to zero.\n\nAs a result, the points in the domain must satisfy the following inequality:\n\n$$\n2x+y\\ne 0\n$$\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,2x+y\\ne 0\\}.\n$$"] ["answer-5f64eacd-5b71-5fb7-a6a8-59aa2ee03f20" :answer/id #uuid "5f64eacd-5b71-5fb7-a6a8-59aa2ee03f20"] ["answer-5f64eacd-5b71-5fb7-a6a8-59aa2ee03f20" :answer/type :answer.type/math] ["answer-5f64eacd-5b71-5fb7-a6a8-59aa2ee03f20" :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,2x+y<1\\}"] ["answer-802c8eca-f606-57bb-ba41-d622b1cfd092" :answer/id #uuid "802c8eca-f606-57bb-ba41-d622b1cfd092"] ["answer-802c8eca-f606-57bb-ba41-d622b1cfd092" :answer/type :answer.type/math] ["answer-802c8eca-f606-57bb-ba41-d622b1cfd092" :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,2x+y>0\\}"] ["answer-d9a97e5b-e0be-5f92-8ef2-8ec7a7cfb42a" :answer/id #uuid "d9a97e5b-e0be-5f92-8ef2-8ec7a7cfb42a"] ["answer-d9a97e5b-e0be-5f92-8ef2-8ec7a7cfb42a" :answer/type :answer.type/math] ["answer-d9a97e5b-e0be-5f92-8ef2-8ec7a7cfb42a" :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,2x+y\\ne -1\\}"] ["answer-3fa5338f-2040-50a2-8215-a65d278835dd" :answer/id #uuid "3fa5338f-2040-50a2-8215-a65d278835dd"] ["answer-3fa5338f-2040-50a2-8215-a65d278835dd" :answer/type :answer.type/math] ["answer-3fa5338f-2040-50a2-8215-a65d278835dd" :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,2x+y\\ne 0\\}"] [17592186278119 :answer-field/correct "answer-3fa5338f-2040-50a2-8215-a65d278835dd"] [17592186278119 :answer-field/choices "answer-5f64eacd-5b71-5fb7-a6a8-59aa2ee03f20"] [17592186278119 :answer-field/choices "answer-802c8eca-f606-57bb-ba41-d622b1cfd092"] [17592186278119 :answer-field/choices "answer-d9a97e5b-e0be-5f92-8ef2-8ec7a7cfb42a"] [17592186278119 :answer-field/choices "answer-3fa5338f-2040-50a2-8215-a65d278835dd"] ["question-8e55ad1f-d84a-5ded-9fca-459293bc995a" :question/id #uuid "8e55ad1f-d84a-5ded-9fca-459293bc995a"] ["question-8e55ad1f-d84a-5ded-9fca-459293bc995a" :question/math-academy-id "q-158549"] ["question-8e55ad1f-d84a-5ded-9fca-459293bc995a" :question/problem "Find the domain of the function $f(x,y)=\\frac{y}{{x}^{2}-1}.$"] ["question-8e55ad1f-d84a-5ded-9fca-459293bc995a" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The expression in the denominator is not equal to zero.\n\nAs a result, the points in the domain must satisfy the following inequality:\n\n$$\n{x}^{2}-1\\ne 0\\,⟹\\,{x}^{2}\\ne 1\n$$\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}\\ne 1\\}.\n$$"] ["question-8e55ad1f-d84a-5ded-9fca-459293bc995a" :question/difficulty :question.difficulty/easy] ["answer-field-90be3a6c-5de3-5d62-b8c6-33fbd612aecb" :answer-field/id #uuid "90be3a6c-5de3-5d62-b8c6-33fbd612aecb"] ["answer-cedcf912-6c17-5453-a419-96804f0a8e01" :answer/id #uuid "cedcf912-6c17-5453-a419-96804f0a8e01"] ["answer-cedcf912-6c17-5453-a419-96804f0a8e01" :answer/type :answer.type/math] ["answer-cedcf912-6c17-5453-a419-96804f0a8e01" :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}=1\\}"] ["answer-766255f4-6ead-5147-a37a-dead8da19ddc" :answer/id #uuid "766255f4-6ead-5147-a37a-dead8da19ddc"] ["answer-766255f4-6ead-5147-a37a-dead8da19ddc" :answer/type :answer.type/math] ["answer-766255f4-6ead-5147-a37a-dead8da19ddc" :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}>0\\}"] ["answer-3795c09d-83a0-5e77-8d46-905638f8cd94" :answer/id #uuid "3795c09d-83a0-5e77-8d46-905638f8cd94"] ["answer-3795c09d-83a0-5e77-8d46-905638f8cd94" :answer/type :answer.type/math] ["answer-3795c09d-83a0-5e77-8d46-905638f8cd94" :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}>1\\}"] ["answer-e1a68aca-012d-5c87-957b-411dd32e2492" :answer/id #uuid "e1a68aca-012d-5c87-957b-411dd32e2492"] ["answer-e1a68aca-012d-5c87-957b-411dd32e2492" :answer/type :answer.type/math] ["answer-e1a68aca-012d-5c87-957b-411dd32e2492" :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}\\ne 1\\}"] ["answer-afd5b1b0-fcf3-5a5d-8da1-bec2e7cc53ad" :answer/id #uuid "afd5b1b0-fcf3-5a5d-8da1-bec2e7cc53ad"] ["answer-afd5b1b0-fcf3-5a5d-8da1-bec2e7cc53ad" :answer/type :answer.type/text] ["answer-afd5b1b0-fcf3-5a5d-8da1-bec2e7cc53ad" :answer/value "The domain is the entire $xy-$plane"] ["answer-field-90be3a6c-5de3-5d62-b8c6-33fbd612aecb" :answer-field/key "selection"] ["answer-field-90be3a6c-5de3-5d62-b8c6-33fbd612aecb" :answer-field/type :answer-field.type/radio] ["answer-field-90be3a6c-5de3-5d62-b8c6-33fbd612aecb" :answer-field/correct "answer-e1a68aca-012d-5c87-957b-411dd32e2492"] ["answer-field-90be3a6c-5de3-5d62-b8c6-33fbd612aecb" :answer-field/choices "answer-cedcf912-6c17-5453-a419-96804f0a8e01"] ["answer-field-90be3a6c-5de3-5d62-b8c6-33fbd612aecb" :answer-field/choices "answer-766255f4-6ead-5147-a37a-dead8da19ddc"] ["answer-field-90be3a6c-5de3-5d62-b8c6-33fbd612aecb" :answer-field/choices "answer-3795c09d-83a0-5e77-8d46-905638f8cd94"] ["answer-field-90be3a6c-5de3-5d62-b8c6-33fbd612aecb" :answer-field/choices "answer-e1a68aca-012d-5c87-957b-411dd32e2492"] ["answer-field-90be3a6c-5de3-5d62-b8c6-33fbd612aecb" :answer-field/choices "answer-afd5b1b0-fcf3-5a5d-8da1-bec2e7cc53ad"] ["question-8e55ad1f-d84a-5ded-9fca-459293bc995a" :question/answer-fields "answer-field-90be3a6c-5de3-5d62-b8c6-33fbd612aecb"] [17592186124636 :knowledge-point/questions "question-8e55ad1f-d84a-5ded-9fca-459293bc995a"] ["question-0f0c6fb0-68b0-537c-ab8d-954592bf8ad5" :question/id #uuid "0f0c6fb0-68b0-537c-ab8d-954592bf8ad5"] ["question-0f0c6fb0-68b0-537c-ab8d-954592bf8ad5" :question/math-academy-id "q-158561"] ["question-0f0c6fb0-68b0-537c-ab8d-954592bf8ad5" :question/problem "Find the domain of the function $z=\\frac{\\sqrt{y-{x}^{2}}}{2x-y}.$"] ["question-0f0c6fb0-68b0-537c-ab8d-954592bf8ad5" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following conditions are satisfied:\n\n- The expression in the denominator is not equal to zero, and\n\n- the expression under the square root is non-negative.\n\nAs a result, the points in the domain must satisfy the following inequalities:\n\n$$\n\\{\\begin{aligned}y-{x}^{2}\\ge 0 \\\\ 2x-y\\ne 0\\end{aligned}\\,⟹\\,\\{\\begin{aligned}y\\ge {x}^{2} \\\\ y\\ne 2x\\end{aligned}\n$$\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,y\\ge {x}^{2},\\,y\\ne 2x\\}.\n$$"] ["question-0f0c6fb0-68b0-537c-ab8d-954592bf8ad5" :question/difficulty :question.difficulty/moderate] ["answer-field-fbec5fcc-3c3a-5ffd-b0f3-92a5d7992122" :answer-field/id #uuid "fbec5fcc-3c3a-5ffd-b0f3-92a5d7992122"] ["answer-aef90284-fc08-5b4f-9e81-9caa92dfe802" :answer/id #uuid "aef90284-fc08-5b4f-9e81-9caa92dfe802"] ["answer-aef90284-fc08-5b4f-9e81-9caa92dfe802" :answer/type :answer.type/math] ["answer-aef90284-fc08-5b4f-9e81-9caa92dfe802" :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,y<{x}^{2},\\,y\\ne 2x\\}"] ["answer-aae1a469-d68e-59c0-a688-35b023ed0b2f" :answer/id #uuid "aae1a469-d68e-59c0-a688-35b023ed0b2f"] ["answer-aae1a469-d68e-59c0-a688-35b023ed0b2f" :answer/type :answer.type/math] ["answer-aae1a469-d68e-59c0-a688-35b023ed0b2f" :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,y={x}^{2},\\,y>2x\\}"] ["answer-b015e9e9-ed69-58a1-bc47-3d84c2927025" :answer/id #uuid "b015e9e9-ed69-58a1-bc47-3d84c2927025"] ["answer-b015e9e9-ed69-58a1-bc47-