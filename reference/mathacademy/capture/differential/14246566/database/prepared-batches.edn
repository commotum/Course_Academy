67f4ee353859" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}<1\\}" :db/ensure [:answer/validate]} {:db/id "answer-b88c88cc-ef4e-5607-aff6-aeedbfce6369" :answer/id #uuid "b88c88cc-ef4e-5607-aff6-aeedbfce6369" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}>1\\}" :db/ensure [:answer/validate]} {:db/id "answer-56d57d91-2728-51bc-b291-e2245cc07a65" :answer/id #uuid "56d57d91-2728-51bc-b291-e2245cc07a65" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}\\le 1\\}" :db/ensure [:answer/validate]} {:db/id 17592186278214 :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following conditions are satisfied:\n\n- The expression under the logarithm is positive, and\n\n- the expression in the denominator is not equal to zero.\n\nAs a result, the points in the domain must satisfy the following inequalities: \n\n$$\n\\{\\begin{aligned}{x}^{2}-{y}^{2}>0 \\\\ \\operatorname{ln}⁡({x}^{2}-{y}^{2})\\ne 0\\end{aligned}\\,⟹\\,\\{\\begin{aligned}{x}^{2}-{y}^{2}>0 \\\\ {x}^{2}-{y}^{2}\\ne 1\\end{aligned}\n$$\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}-{y}^{2}>0,\\,{x}^{2}-{y}^{2}\\ne 1\\}.\n$$" :db/ensure [:question/validate]} {:db/id 17592186277760 :answer-field/correct "answer-c250b76c-84fb-5171-96ad-26f59f4cc182" :answer-field/choices ["answer-c250b76c-84fb-5171-96ad-26f59f4cc182" "answer-afb9bfc6-03a7-5955-a866-f8b80cc14adc" "answer-5a2a0eb0-6434-58f7-9e6c-4792c1123498" "answer-9c51b544-d4a2-5932-8f15-bac18a3bfea1"] :db/ensure [:answer-field/validate]} {:db/id "answer-c250b76c-84fb-5171-96ad-26f59f4cc182" :answer/id #uuid "c250b76c-84fb-5171-96ad-26f59f4cc182" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}-{y}^{2}>0,\\,{x}^{2}-{y}^{2}\\ne 1\\}" :db/ensure [:answer/validate]} {:db/id "answer-afb9bfc6-03a7-5955-a866-f8b80cc14adc" :answer/id #uuid "afb9bfc6-03a7-5955-a866-f8b80cc14adc" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}-{y}^{2}>0\\}" :db/ensure [:answer/validate]} {:db/id "answer-5a2a0eb0-6434-58f7-9e6c-4792c1123498" :answer/id #uuid "5a2a0eb0-6434-58f7-9e6c-4792c1123498" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}-{y}^{2}>1\\}" :db/ensure [:answer/validate]} {:db/id "answer-9c51b544-d4a2-5932-8f15-bac18a3bfea1" :answer/id #uuid "9c51b544-d4a2-5932-8f15-bac18a3bfea1" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}-{y}^{2}\\ne 0,1\\}" :db/ensure [:answer/validate]} {:db/id "question-e70a4727-f486-57b6-aa40-dbf0dba8fb16" :question/id #uuid "e70a4727-f486-57b6-aa40-dbf0dba8fb16" :question/math-academy-id "q-158191" :question/problem "Find the domain of the function $f(x,y)=\\frac{\\operatorname{ln}⁡(1-{x}^{2})}{y}.$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following conditions are satisfied:\n\n- The expression under the logarithm is positive, and\n\n- the expression in the denominator is not equal to zero.\n\nAs a result, the points in the domain must satisfy the following inequalities: \n\n$$\n\\{\\begin{aligned}1-{x}^{2}>0 \\\\ y\\ne 0\\end{aligned}\\,⟹\\,\\{\\begin{aligned}-1<x<1 \\\\ y\\ne 0\\end{aligned}\n$$\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,-1<x<1,\\,y\\ne 0\\}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f1449eb3-c226-5410-a948-814f6bd35c51"] :db/ensure [:question/validate]} {:db/id "answer-field-f1449eb3-c226-5410-a948-814f6bd35c51" :answer-field/id #uuid "f1449eb3-c226-5410-a948-814f6bd35c51" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2d5fb42b-48b0-5faa-b43e-a2cc7b0c3a9f" :answer-field/choices ["answer-d1a17952-6dd7-5e95-8f91-a446078ae611" "answer-2d5fb42b-48b0-5faa-b43e-a2cc7b0c3a9f" "answer-47325857-bade-5abe-940b-58d047f337df" "answer-be3d5d38-7205-5015-a8b8-93d91f6b0ac3" "answer-ac6f7aeb-aa8b-5188-b690-7774d66d49cd"] :db/ensure [:answer-field/validate]} {:db/id "answer-d1a17952-6dd7-5e95-8f91-a446078ae611" :answer/id #uuid "d1a17952-6dd7-5e95-8f91-a446078ae611" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,-1<x<1,\\,y>0\\}" :db/ensure [:answer/validate]} {:db/id "answer-2d5fb42b-48b0-5faa-b43e-a2cc7b0c3a9f" :answer/id #uuid "2d5fb42b-48b0-5faa-b43e-a2cc7b0c3a9f" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,-1<x<1,\\,y\\ne 0\\}" :db/ensure [:answer/validate]} {:db/id "answer-47325857-bade-5abe-940b-58d047f337df" :answer/id #uuid "47325857-bade-5abe-940b-58d047f337df" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,x>0,\\,y\\ne 0\\}" :db/ensure [:answer/validate]} {:db/id "answer-be3d5d38-7205-5015-a8b8-93d91f6b0ac3" :answer/id #uuid "be3d5d38-7205-5015-a8b8-93d91f6b0ac3" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,x\\ne \\pm 1,\\,y\\ne 0\\}" :db/ensure [:answer/validate]} {:db/id "answer-ac6f7aeb-aa8b-5188-b690-7774d66d49cd" :answer/id #uuid "ac6f7aeb-aa8b-5188-b690-7774d66d49cd" :answer/type :answer.type/text :answer/value "The domain is the entire $xy$-plane" :db/ensure [:answer/validate]} {:db/id "question-7a819c67-d4ea-5946-94af-b50fc8d8ad96" :question/id #uuid "7a819c67-d4ea-5946-94af-b50fc8d8ad96" :question/math-academy-id "q-158186" :question/problem "Find the domain of the function $f(x,y)=\\frac{{ln}^{2}⁡y}{{x}^{3}}.$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following conditions are satisfied:\n\n- The expression under the logarithm is positive, and\n\n- the expression in the denominator is not equal to zero.\n\nAs a result, the points in the domain must satisfy the following inequalities: \n\n$$\n\\{\\begin{aligned}y>0 \\\\ {x}^{3}\\ne 0\\end{aligned}\\,⟹\\,\\{\\begin{aligned}y>0 \\\\ x\\ne 0\\end{aligned}\n$$\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,y>0,\\,x\\ne 0\\}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e365395e-e193-5723-b80a-2293c4ae62a0"] :db/ensure [:question/validate]} {:db/id "answer-field-e365395e-e193-5723-b80a-2293c4ae62a0" :answer-field/id #uuid "e365395e-e193-5723-b80a-2293c4ae62a0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-94603c8a-00da-5e0e-8705-b52b7dbbcde4" :answer-field/choices ["answer-94603c8a-00da-5e0e-8705-b52b7dbbcde4" "answer-269efb88-268f-56aa-a516-6833ee078794" "answer-0c3c2367-c89a-5a63-909a-8ab545f01ec6" "answer-fa533f6d-4ad6-5d08-9dfd-22ac37f25112" "answer-d6a12713-af0d-576a-8ce3-2bf1f61336d5"] :db/ensure [:answer-field/validate]} {:db/id "answer-94603c8a-00da-5e0e-8705-b52b7dbbcde4" :answer/id #uuid "94603c8a-00da-5e0e-8705-b52b7dbbcde4" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,y>0,\\,x\\ne 0\\}" :db/ensure [:answer/validate]} {:db/id "answer-269efb88-268f-56aa-a516-6833ee078794" :answer/id #uuid "269efb88-268f-56aa-a516-6833ee078794" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,y>0\\}" :db/ensure [:answer/validate]} {:db/id "answer-0c3c2367-c89a-5a63-909a-8ab545f01ec6" :answer/id #uuid "0c3c2367-c89a-5a63-909a-8ab545f01ec6" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,y\\ge 0,\\,x\\ne 0\\}" :db/ensure [:answer/validate]} {:db/id "answer-fa533f6d-4ad6-5d08-9dfd-22ac37f25112" :answer/id #uuid "fa533f6d-4ad6-5d08-9dfd-22ac37f25112" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,y\\ne 0,\\,x\\ne 0\\}" :db/ensure [:answer/validate]} {:db/id "answer-d6a12713-af0d-576a-8ce3-2bf1f61336d5" :answer/id #uuid "d6a12713-af0d-576a-8ce3-2bf1f61336d5" :answer/type :answer.type/text :answer/value "The domain is the entire $xy$-plane" :db/ensure [:answer/validate]} {:db/id "question-e5fbae1b-fa0a-5638-bec4-5b64d04c9a07" :question/id #uuid "e5fbae1b-fa0a-5638-bec4-5b64d04c9a07" :question/math-academy-id "q-158185" :question/problem "Find the domain of the function $f(x,y)=\\frac{\\operatorname{ln}⁡(x-y)}{{e}^{x}}.$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following conditions are satisfied:\n\n- The expression under the logarithm is positive, and\n\n- the expression in the denominator is not equal to zero.\n\nNotice that ${e}^{x}>0$ for all $x.$ Therefore, the points in the domain must satisfy the following inequality:\n\n$$\n\\begin{aligned}x-y>0\\,⟹\\,x>y\\end{aligned}\n$$\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,x>y\\}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-0495e322-ad63-52d2-84e8-e016c8d6367c"] :db/ensure [:question/validate]} {:db/id "answer-field-0495e322-ad63-52d2-84e8-e016c8d6367c" :answer-field/id #uuid "0495e322-ad63-52d2-84e8-e016c8d6367c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-809ffa9f-fc24-57db-8fe0-6f88da3c8f83" :answer-field/choices ["answer-b0f55a63-715f-589c-a5b9-f12320546593" "answer-809ffa9f-fc24-57db-8fe0-6f88da3c8f83" "answer-2e779e34-e7fe-559c-8a5e-d6acdf7c0dc0" "answer-90267910-6534-5e32-a7b2-2a165379570f" "answer-0c87b3c0-88bd-5bcd-8655-c1b7cc94de43"] :db/ensure [:answer-field/validate]} {:db/id "answer-b0f55a63-715f-589c-a5b9-f12320546593" :answer/id #uuid "b0f55a63-715f-589c-a5b9-f12320546593" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,x>y,\\,x\\ne 0\\}" :db/ensure [:answer/validate]} {:db/id "answer-809ffa9f-fc24-57db-8fe0-6f88da3c8f83" :answer/id #uuid "809ffa9f-fc24-57db-8fe0-6f88da3c8f83" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,x>y\\}" :db/ensure [:answer/validate]} {:db/id "answer-2e779e34-e7fe-559c-8a5e-d6acdf7c0dc0" :answer/id #uuid "2e779e34-e7fe-559c-8a5e-d6acdf7c0dc0" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,x\\ne y,\\,x\\ne 0\\}" :db/ensure [:answer/validate]} {:db/id "answer-90267910-6534-5e32-a7b2-2a165379570f" :answer/id #uuid "90267910-6534-5e32-a7b2-2a165379570f" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,x\\ne y\\}" :db/ensure [:answer/validate]} {:db/id "answer-0c87b3c0-88bd-5bcd-8655-c1b7cc94de43" :answer/id #uuid "0c87b3c0-88bd-5bcd-8655-c1b7cc94de43" :answer/type :answer.type/text :answer/value "The domain is the entire $xy$-plane" :db/ensure [:answer/validate]} {:db/id "question-8a09ec73-a8f5-5e32-98fd-165c3e60bda6" :question/id #uuid "8a09ec73-a8f5-5e32-98fd-165c3e60bda6" :question/math-academy-id "q-158183" :question/problem "Find the domain of the function $f(x,y)=\\frac{1}{\\operatorname{ln}⁡(x-y)}.$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following conditions are satisfied:\n\n- The expression under the logarithm is positive, and\n\n- the expression in the denominator is not equal to zero.\n\nAs a result, the points in the domain must satisfy the following inequalities: \n\n$$\n\\{\\begin{aligned}x-y>0 \\\\ \\operatorname{ln}⁡(x-y)\\ne 0\\end{aligned}\\,⟹\\,\\{\\begin{aligned}x-y>0 \\\\ x-y\\ne 1\\end{aligned}\n$$\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,x-y>0,\\,x-y\\ne 1\\}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-421fe0aa-3a0a-5d77-af83-754300b22259"] :db/ensure [:question/validate]} {:db/id "answer-field-421fe0aa-3a0a-5d77-af83-754300b22259" :answer-field/id #uuid "421fe0aa-3a0a-5d77-af83-754300b22259" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b121cf1a-7dc7-5909-a04d-7262bf0ba8dd" :answer-field/choices ["answer-b121cf1a-7dc7-5909-a04d-7262bf0ba8dd" "answer-c7eee758-44ec-5173-b8d7-7b012b545dcb" "answer-e9d25956-37d7-5565-be7f-161a70ab6752" "answer-d680f939-d4c5-5d9b-a170-a6f596fd8729" "answer-a3e6ed38-eb22-5a68-b4e4-a818bbc05c8c"] :db/ensure [:answer-field/validate]} {:db/id "answer-b121cf1a-7dc7-5909-a04d-7262bf0ba8dd" :answer/id #uuid "b121cf1a-7dc7-5909-a04d-7262bf0ba8dd" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,x-y>0,\\,x-y\\ne 1\\}" :db/ensure [:answer/validate]} {:db/id "answer-c7eee758-44ec-5173-b8d7-7b012b545dcb" :answer/id #uuid "c7eee758-44ec-5173-b8d7-7b012b545dcb" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,x-y>0\\}" :db/ensure [:answer/validate]} {:db/id "answer-e9d25956-37d7-5565-be7f-161a70ab6752" :answer/id #uuid "e9d25956-37d7-5565-be7f-161a70ab6752" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,x-y\\ge 0\\}" :db/ensure [:answer/validate]} {:db/id "answer-d680f939-d4c5-5d9b-a170-a6f596fd8729" :answer/id #uuid "d680f939-d4c5-5d9b-a170-a6f596fd8729" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,x-y\\ne 0,1\\}" :db/ensure [:answer/validate]} {:db/id "answer-a3e6ed38-eb22-5a68-b4e4-a818bbc05c8c" :answer/id #uuid "a3e6ed38-eb22-5a68-b4e4-a818bbc05c8c" :answer/type :answer.type/text :answer/value "The domain is the entire $xy$-plane" :db/ensure [:answer/validate]} {:db/id "question-aca8e51f-98b0-5cbe-9d48-2cf6165eb100" :question/id #uuid "aca8e51f-98b0-5cbe-9d48-2cf6165eb100" :question/math-academy-id "q-158194" :question/problem "Which of the following shaded regions corresponds to the domain of the function $g(x,y)=\\operatorname{ln}⁡(4-{x}^{2}-4{y}^{2})?$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The expression under the logarithm is positive.\n\nAs a result, the points in the domain must satisfy the following inequality:\n\n$$\n4-{x}^{2}-4{y}^{2}>0\\,⟹\\,{x}^{2}+4{y}^{2}<4\\,⟹\\,\\frac{{x}^{2}}{4}+{y}^{2}<1\n$$\n\nTherefore, the domain is\n\n$$\nD=\\{(x,y)\\in {R}^{2}\\,:\\,\\frac{{x}^{2}}{4}+{y}^{2}<1\\}.\n$$\n\nSince the expression involves the $<$ sign, the curve is *not* part of the domain. Therefore, we draw the dashed curve $\\frac{{x}^{2}}{4}+{y}^{2}<1$ and shade the region *inside* the curve.\n\nThe resulting domain is as follows:\n\n![](images/59/59ac983361be7dd9a991e1cf134e7193256891a5587eab6bff5edf906fef3688.png)" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-d7edea41-50a3-50bd-89df-5921c02bca14"] :db/ensure [:question/validate]} {:db/id "answer-field-d7edea41-50a3-50bd-89df-5921c02bca14" :answer-field/id #uuid "d7edea41-50a3-50bd-89df-5921c02bca14" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-921a2c76-2d53-53a6-a4cc-08b4036be5ef" :answer-field/choices ["answer-5d3bfeec-8a70-54e7-b902-621589c010e6" "answer-873bd759-67ad-5785-b300-e95e0d07fa2c" "answer-2b746c30-aae0-5a72-8f59-c56e220b909e" "answer-48fd464b-717b-50cf-9914-97377d2a6891" "answer-921a2c76-2d53-53a6-a4cc-08b4036be5ef"] :db/ensure [:answer-field/validate]} {:db/id "answer-5d3bfeec-8a70-54e7-b902-621589c010e6" :answer/id #uuid "5d3bfeec-8a70-54e7-b902-621589c010e6" :answer/type :answer.type/image :answer/value "images/5b/5b10601e98e7b8f4aea176c5a0eea21e806c61ecc8bf9e09bc231d36c848494b.png" :db/ensure [:answer/validate]} {:db/id "answer-873bd759-67ad-5785-b300-e95e0d07fa2c" :answer/id #uuid "873bd759-67ad-5785-b300-e95e0d07fa2c" :answer/type :answer.type/image :answer/value "images/7b/7b7973136f5add18c648db5589bab6e3f3a8f1f2544473274e37f28ab282b5d6.png" :db/ensure [:answer/validate]} {:db/id "answer-2b746c30-aae0-5a72-8f59-c56e220b909e" :answer/id #uuid "2b746c30-aae0-5a72-8f59-c56e220b909e" :answer/type :answer.type/image :answer/value "images/b1/b18e5383da3d9cd336d8829713127c670449da207ecc9216789747ee55ad3db7.png" :db/ensure [:answer/validate]} {:db/id "answer-48fd464b-717b-50cf-9914-97377d2a6891" :answer/id #uuid "48fd464b-717b-50cf-9914-97377d2a6891" :answer/type :answer.type/image :answer/value "images/c1/c165cffbac8308d93d73db8323f2e89e6231f8661c0c010947861be46f0a0040.png" :db/ensure [:answer/validate]} {:db/id "answer-921a2c76-2d53-53a6-a4cc-08b4036be5ef" :answer/id #uuid "921a2c76-2d53-53a6-a4cc-08b4036be5ef" :answer/type :answer.type/image :answer/value "images/d6/d60f7727323089821783619f48be4d61146e463a5d694f0817276f0e8a0986b1.png" :db/ensure [:answer/validate]} {:db/id 17592186378829 :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The expression in the denominator is not equal to zero.\n\nAs a result, the points in the domain must satisfy the following inequality:\n\n$$\n{x}^{3}+y\\ne 0\\,⟹\\,y\\ne -{x}^{3}\n$$\n\nTherefore, the domain is\n\n$$\nD=\\{(x,y)\\in {R}^{2}\\,:\\,y\\ne -{x}^{3}\\}.\n$$\n\nSince the expression involves the $\\ne $ sign, the line is *not* part of the domain. Therefore, we draw the dashed curve $y=-{x}^{3}$ and shade *above* and *below* the curve.\n\nThe resulting domain is as follows:\n\n![](images/6c/6c85783dc6626a3fea9d06431ee31e202da8c4d88e2eb1c2b6608dccdc2b782e.png)" :db/ensure [:question/validate]} {:db/id 17592186378746 :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The expression under the square root is non-negative.\n\nAs a result, the points in the domain must satisfy the following inequalities:\n\n$$\ny+{x}^{2}\\ge 0\\,⟹\\,y\\ge -{x}^{2}\n$$\n\nTherefore, the domain is\n\n$$\nD=\\{(x,y)\\in {R}^{2}\\,:\\,y\\ge -{x}^{2}\\}.\n$$\n\nSince the inequality involves the $\\ge $ sign, the curve is part of the domain. Therefore, we draw a solid curve $y=-{x}^{2}$ and shade the area *outside* the curve.\n\nThe resulting domain is as follows:\n\n![](images/0b/0b7a6dbbab890b469cf389fa27627e9c1a5f95d8892507fcd4ba5f70541936ea.png)" :db/ensure [:question/validate]} {:db/id "question-28327fac-a614-5756-91bd-3fcab54fcda2" :question/id #uuid "28327fac-a614-5756-91bd-3fcab54fcda2" :question/math-academy-id "q-158199" :question/problem "Which of the following shaded regions corresponds to the domain of the function $g(x,y)=\\frac{1}{\\sqrt{x-y}}?$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The expression under the square root is non-negative, and\n\n- the expression in the denominator is not equal to zero.\n\nAs a result, the points in the domain must satisfy the following inequality:\n\n$$\nx-y>0\\,⟹\\,y<x\n$$\n\nTherefore, the domain is\n\n$$\nD=\\{(x,y)\\in {R}^{2}\\,:\\,y<x\\}.\n$$\n\nSince the inequality involves the $>$ sign, the line is not part of the domain. Therefore, we draw a dashed line $y=x$ and shade the area *below* the line.\n\nThe resulting domain is as follows:\n\n![](images/77/77a1a03d037ee571fb0dc14ec8370c8b01f521b5a54798117c0b131000676599.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d3261e01-b350-524c-a353-a2dfc7e7e037"] :db/ensure [:question/validate]} {:db/id "answer-field-d3261e01-b350-524c-a353-a2dfc7e7e037" :answer-field/id #uuid "d3261e01-b350-524c-a353-a2dfc7e7e037" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a52a1264-daf9-5585-a899-ca4955b26a0c" :answer-field/choices ["answer-24ee07ec-7db5-5819-9326-c35abfd13309" "answer-bb553729-44e6-50a1-8fbf-d734ae3b55c8" "answer-a52a1264-daf9-5585-a899-ca4955b26a0c" "answer-fae94e29-660b-5543-bab0-87e8d67f1ae2" "answer-b2b08043-54bd-579b-a710-49e36d027167"] :db/ensure [:answer-field/validate]} {:db/id "answer-24ee07ec-7db5-5819-9326-c35abfd13309" :answer/id #uuid "24ee07ec-7db5-5819-9326-c35abfd13309" :answer/type :answer.type/image :answer/value "images/02/02c770831bde33820dd4f616df872e22d1a1f9d2de4e49073043cbd4139408e4.png" :db/ensure [:answer/validate]} {:db/id "answer-bb553729-44e6-50a1-8fbf-d734ae3b55c8" :answer/id #uuid "bb553729-44e6-50a1-8fbf-d734ae3b55c8" :answer/type :answer.type/image :answer/value "images/20/2058a5e83362c3a2b823169cab5044ea8c3756c6f99ad9f8d26234e9f3b4421d.png" :db/ensure [:answer/validate]} {:db/id "answer-a52a1264-daf9-5585-a899-ca4955b26a0c" :answer/id #uuid "a52a1264-daf9-5585-a899-ca4955b26a0c" :answer/type :answer.type/image :answer/value "images/8f/8fc352405dfa98fc84dc5fc60a41d111139058b7680b9c3b02ee988079b34fef.png" :db/ensure [:answer/validate]} {:db/id "answer-fae94e29-660b-5543-bab0-87e8d67f1ae2" :answer/id #uuid "fae94e29-660b-5543-bab0-87e8d67f1ae2" :answer/type :answer.type/image :answer/value "images/bb/bbf7c2cd4d8b11cd078f08d7ca31d3e7f40f20db3ee25fbbe95134d051840cc0.png" :db/ensure [:answer/validate]} {:db/id "answer-b2b08043-54bd-579b-a710-49e36d027167" :answer/id #uuid "b2b08043-54bd-579b-a710-49e36d027167" :answer/type :answer.type/image :answer/value "images/ec/ec1f53deac4b4a4c29daf9ad8205b6283b09f9402ce4df20a46c47e268bcd374.png" :db/ensure [:answer/validate]} {:db/id "question-f90f5dc8-4e9d-5e87-800a-708d8b32cd8d" :question/id #uuid "f90f5dc8-4e9d-5e87-800a-708d8b32cd8d" :question/math-academy-id "q-158196" :question/problem "Which of the following shaded regions corresponds to the domain of the function $g(x,y)=\\sqrt{{x}^{2}+{y}^{2}+1}?$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The expression under the square root is non-negative.\n\nAs a result, the points in the domain must satisfy the following inequalities:\n\n$$\n{x}^{2}+{y}^{2}+1\\ge 0\n$$\n\nSince the inequality ${x}^{2}+{y}^{2}+1\\ge 0$ is true for all values of $x$ and $y,$ the domain of the function $f$ is the entire $xy$-plane.\n\nThe resulting domain is as follows:\n\n![](images/40/402d90507403eabf4cd35cde83a45c9fa2d8080347e1debb0e2463be408b489b.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b0c62e6a-7044-5e8e-b3aa-7123ad96f32d"] :db/ensure [:question/validate]} {:db/id "answer-field-b0c62e6a-7044-5e8e-b3aa-7123ad96f32d" :answer-field/id #uuid "b0c62e6a-7044-5e8e-b3aa-7123ad96f32d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-fb69bb38-f4d8-5144-bff4-908369a1e63a" :answer-field/choices ["answer-e69db1ea-c330-5536-8560-08f5b1e80164" "answer-fb69bb38-f4d8-5144-bff4-908369a1e63a" "answer-aeac4431-91c7-5505-8522-2946cd2d43cc" "answer-cdf6bb0c-4f48-5455-b7c2-33db2af70756" "answer-ff779dbe-e82e-5919-99da-f2d26cecb00a"] :db/ensure [:answer-field/validate]} {:db/id "answer-e69db1ea-c330-5536-8560-08f5b1e80164" :answer/id #uuid "e69db1ea-c330-5536-8560-08f5b1e80164" :answer/type :answer.type/image :answer/value "images/33/338809ca0a3fe4d02c3523ec5e34a8d07a00b297d9f468740bbd1800d9675941.png" :db/ensure [:answer/validate]} {:db/id "answer-fb69bb38-f4d8-5144-bff4-908369a1e63a" :answer/id #uuid "fb69bb38-f4d8-5144-bff4-908369a1e63a" :answer/type :answer.type/image :answer/value "images/40/402d90507403eabf4cd35cde83a45c9fa2d8080347e1debb0e2463be408b489b.png" :db/ensure [:answer/validate]} {:db/id "answer-aeac4431-91c7-5505-8522-2946cd2d43cc" :answer/id #uuid "aeac4431-91c7-5505-8522-2946cd2d43cc" :answer/type :answer.type/image :answer/value "images/44/4453ab63ec12361c69cffbf76bd51d63a9ef985b54452f7f84e37ed7dee21c39.png" :db/ensure [:answer/validate]} {:db/id "answer-cdf6bb0c-4f48-5455-b7c2-33db2af70756" :answer/id #uuid "cdf6bb0c-4f48-5455-b7c2-33db2af70756" :answer/type :answer.type/image :answer/value "images/9c/9c2a0516ca58c52ccecadade60e966563b442f3112cce73cb16c1931c2087cd8.png" :db/ensure [:answer/validate]} {:db/id "answer-ff779dbe-e82e-5919-99da-f2d26cecb00a" :answer/id #uuid "ff779dbe-e82e-5919-99da-f2d26cecb00a" :answer/type :answer.type/image :answer/value "images/b8/b8fe923f727ca57a8a2cfc756b93c0ed522bdd9edcc06c8097bead979c8e4b15.png" :db/ensure [:answer/validate]}] "assertions" [["question-911398b5-8165-51fb-be3f-bfee0bb6f77f" :question/id #uuid "911398b5-8165-51fb-be3f-bfee0bb6f77f"] ["question-911398b5-8165-51fb-be3f-bfee0bb6f77f" :question/math-academy-id "q-158571"] ["question-911398b5-8165-51fb-be3f-bfee0bb6f77f" :question/problem "Evaluate $z=\\frac{2y-x}{{x}^{3}-{y}^{2}-4}$ at the point $(2,-2).$"] ["question-911398b5-8165-51fb-be3f-bfee0bb6f77f" :question/worked-solution "To evaluate our multivariable function at the point $(2,-2),$ we substitute $x=2$ and $y=-2$ into the function expression:\n\n$$\n\\begin{aligned}z\\,{|}_{(2,-2)} & =\\frac{2y-x}{{x}^{3}-{y}^{2}-4}\\,{|}_{(2,-2)} \\\\  & =\\frac{2(-2)-2}{{2}^{3}-(-2)^{2}-4} \\\\  & =\\frac{-4-2}{8-4-4} \\\\  & =\\frac{(-6)}{0},\\end{aligned}\n$$\n\nwhich is undefined."] ["question-911398b5-8165-51fb-be3f-bfee0bb6f77f" :question/difficulty :question.difficulty/moderate] ["answer-field-378dd559-16b2-53c2-b64a-808e9c526e35" :answer-field/id #uuid "378dd559-16b2-53c2-b64a-808e9c526e35"] ["answer-4332d078-c596-5ab9-a9fd-b2600b41dcb1" :answer/id #uuid "4332d078-c596-5ab9-a9fd-b2600b41dcb1"] ["answer-4332d078-c596-5ab9-a9fd-b2600b41dcb1" :answer/type :answer.type/math] ["answer-4332d078-c596-5ab9-a9fd-b2600b41dcb1" :answer/value "-6"] ["answer-f1a761eb-6b14-555e-ba52-76a27a6e6871" :answer/id #uuid "f1a761eb-6b14-555e-ba52-76a27a6e6871"] ["answer-f1a761eb-6b14-555e-ba52-76a27a6e6871" :answer/type :answer.type/math] ["answer-f1a761eb-6b14-555e-ba52-76a27a6e6871" :answer/value "-\\frac{3}{2}"] ["answer-529e6e4c-543b-5b5d-91ba-42883dfabf92" :answer/id #uuid "529e6e4c-543b-5b5d-91ba-42883dfabf92"] ["answer-529e6e4c-543b-5b5d-91ba-42883dfabf92" :answer/type :answer.type/math] ["answer-529e6e4c-543b-5b5d-91ba-42883dfabf92" :answer/value "3"] ["answer-ade04a22-b4eb-505b-8eb9-82420c1e8561" :answer/id #uuid "ade04a22-b4eb-505b-8eb9-82420c1e8561"] ["answer-ade04a22-b4eb-505b-8eb9-82420c1e8561" :answer/type :answer.type/math] ["answer-ade04a22-b4eb-505b-8eb9-82420c1e8561" :answer/value "\\frac{6}{5}"] ["answer-c11088d1-89b4-5f2e-9c65-45b33b86af64" :answer/id #uuid "c11088d1-89b4-5f2e-9c65-45b33b86af64"] ["answer-c11088d1-8