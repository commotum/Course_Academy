62e6a-7044-5e8e-b3aa-7123ad96f32d" :answer-field/choices "answer-aeac4431-91c7-5505-8522-2946cd2d43cc"] ["answer-field-b0c62e6a-7044-5e8e-b3aa-7123ad96f32d" :answer-field/choices "answer-cdf6bb0c-4f48-5455-b7c2-33db2af70756"] ["answer-field-b0c62e6a-7044-5e8e-b3aa-7123ad96f32d" :answer-field/choices "answer-ff779dbe-e82e-5919-99da-f2d26cecb00a"] ["question-f90f5dc8-4e9d-5e87-800a-708d8b32cd8d" :question/answer-fields "answer-field-b0c62e6a-7044-5e8e-b3aa-7123ad96f32d"] [17592186124637 :knowledge-point/questions "question-f90f5dc8-4e9d-5e87-800a-708d8b32cd8d"]] "retractions" [[17592186124804 :question/problem "Evaluate $z = x^{2} + xy - 5$ at the point $(1, 2)$."] [17592186278204 :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The expression in the denominator is not equal to zero.\n\nAs a result, the points in the domain must satisfy the following inequality:\n\n$$\n2x+y\\ne 0\n$$\n\nTherefore, the domain is\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,2x+y\\ne 0}.\n$$"] [17592186278119 :answer-field/correct 17592186276194] [17592186278119 :answer-field/choices 17592186276194] [17592186278119 :answer-field/choices 17592186277190] [17592186278119 :answer-field/choices 17592186276424] [17592186278119 :answer-field/choices 17592186276334] [17592186275453 :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following conditions are satisfied:\n\n- The expression in the denominator is not equal to zero, and\n\n- the expression under the square root is non-negative.\n\nAs a result, the points in the domain must satisfy the following inequality:\n\n$$\n\\begin{aligned}1-{x}^{2}-{y}^{2}>0\\,⟹\\,{x}^{2}+{y}^{2}<1\\end{aligned}\n$$\n\nTherefore, the domain is\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}<1}.\n$$"] [17592186274851 :answer-field/correct 17592186274622] [17592186274851 :answer-field/choices 17592186272390] [17592186274851 :answer-field/choices 17592186274424] [17592186274851 :answer-field/choices 17592186274622] [17592186274851 :answer-field/choices 17592186273631] [17592186278214 :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following conditions are satisfied:\n\n- The expression under the logarithm is positive, and\n\n- the expression in the denominator is not equal to zero.\n\nAs a result, the points in the domain must satisfy the following inequalities: \n\n$$\n{\\begin{aligned}{x}^{2}-{y}^{2}>0 \\\\ \\operatorname{ln}⁡({x}^{2}-{y}^{2})\\ne 0\\end{aligned}\\,⟹\\,{\\begin{aligned}{x}^{2}-{y}^{2}>0 \\\\ {x}^{2}-{y}^{2}\\ne 1\\end{aligned}\n$$\n\nTherefore, the domain is\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}-{y}^{2}>0,\\,{x}^{2}-{y}^{2}\\ne 1}.\n$$"] [17592186277760 :answer-field/correct 17592186275904] [17592186277760 :answer-field/choices 17592186275904] [17592186277760 :answer-field/choices 17592186276336] [17592186277760 :answer-field/choices 17592186276056] [17592186277760 :answer-field/choices 17592186275917] [17592186378829 :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The expression in the denominator is not equal to zero.\n\nAs a result, the points in the domain must satisfy the following inequality:\n\n$$\n{x}^{3}+y\\ne 0\\,⟹\\,y\\ne -{x}^{3}\n$$\n\nTherefore, the domain is\n\n$$\nD={(x,y)\\in {R}^{2}\\,:\\,y\\ne -{x}^{3}}.\n$$\n\nSince the expression involves the $\\ne $ sign, the line is *not* part of the domain. Therefore, we draw the dashed curve $y=-{x}^{3}$ and shade *above* and *below* the curve.\n\nThe resulting domain is as follows:\n\n![](images/6c/6c85783dc6626a3fea9d06431ee31e202da8c4d88e2eb1c2b6608dccdc2b782e.png)"] [17592186378746 :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The expression under the square root is non-negative.\n\nAs a result, the points in the domain must satisfy the following inequalities:\n\n$$\ny+{x}^{2}\\ge 0\\,⟹\\,y\\ge -{x}^{2}\n$$\n\nTherefore, the domain is\n\n$$\nD={(x,y)\\in {R}^{2}\\,:\\,y\\ge -{x}^{2}}.\n$$\n\nSince the inequality involves the $\\ge $ sign, the curve is part of the domain. Therefore, we draw a solid curve $y=-{x}^{2}$ and shade the area *outside* the curve.\n\nThe resulting domain is as follows:\n\n![](images/0b/0b7a6dbbab890b469cf389fa27627e9c1a5f95d8892507fcd4ba5f70541936ea.png)"]]}]