  "live_records": {
    "q-72398": {
      "dom_id": "step-q72398",
      "name": "Question 1",
      "problem": "${\\sum }_{j=1}^{3}{\\sum }_{i=1}^{3}\\frac{i}{j}=$",
      "worked_solution": "First, we write out the inner summation by summing over the index $i:$\n\n$$\n\\begin{aligned}{\\sum }_{j=1}^{3}{\\sum }_{i=1}^{3}\\frac{i}{j} & ={\\sum }_{j=1}^{3}[{\\sum }_{i=1}^{3}\\frac{i}{j}] \\\\  & ={\\sum }_{j=1}^{3}(\\frac{1}{j}+\\frac{2}{j}+\\frac{3}{j}) \\\\  & ={\\sum }_{j=1}^{3}\\frac{6}{j}\\end{aligned}\n$$\n\nNext, we sum over the index $j:$\n\n$$\n\\begin{aligned}{\\sum }_{j=1}^{3}\\frac{6}{j} & =\\frac{6}{1}+\\frac{6}{2}+\\frac{6}{3} \\\\  & =6+3+2 \\\\  & =11\\end{aligned}\n$$",
      "calculator_instructions": "",
