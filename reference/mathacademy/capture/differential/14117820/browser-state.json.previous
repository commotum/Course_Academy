display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mtable displaystyle=\"true\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"3pt 0.8em 0.3em\"><mtr><mtd><munderover><mo data-mjx-texclass=\"OP\">∑</mo><mrow data-mjx-texclass=\"ORD\"><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mn>2</mn></munderover><mn>6</mn><mi>j</mi></mtd><mtd><mi></mi><mo>=</mo><mn>6</mn><mo>⋅</mo><mn>1</mn><mo>+</mo><mn>6</mn><mo>⋅</mo><mn>2</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>6</mn><mo>+</mo><mn>12</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>18</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
