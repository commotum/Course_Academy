6 #edb/ref 17592186045417] [17592186338646 #edb/ref 1075 #edb/ref 17592186336820 #edb/ref 17592186045417] [17592186338646 #edb/ref 1075 #edb/ref 17592186337251 #edb/ref 17592186045417] [17592186338646 #edb/ref 1075 #edb/ref 17592186337328 #edb/ref 17592186045417] [17592186338646 #edb/ref 1075 #edb/ref 17592186338084 #edb/ref 17592186045417] [17592186338646 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186338646 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186338646 #edb/ref 1078 #edb/ref 17592186336086 #edb/ref 17592186045417] [17592186338646 #edb/ref 1079 #uuid "d00b4e5a-ff65-56fa-b540-8141b99bade6" #edb/ref 17592186045417] [17592186339105 #edb/ref 1068 #edb/ref 17592186338646 #edb/ref 17592186045417] [17592186339105 #edb/ref 1069 "q-72398" #edb/ref 17592186045417] [17592186339105 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186339105 #edb/ref 1071 "${\\sum }_{j=1}^{3}{\\sum }_{i=1}^{3}\\frac{i}{j}=$" #edb/ref 17592186045417] [17592186339105 #edb/ref 1072 #uuid "84a0ce9f-42da-567f-9eb4-191f3ceeaf0b" #edb/ref 17592186045417] [17592186339105 #edb/ref 1074 "First, we write out the inner summation by summing over the index $i:$\n\n$$\n\\begin{aligned}{\\sum }_{j=1}^{3}{\\sum }_{i=1}^{3}\\frac{i}{j} & ={\\sum }_{j=1}^{3}[{\\sum }_{i=1}^{3}\\frac{i}{j}] \\\\  & ={\\sum }_{j=1}^{3}(\\frac{1}{j}+\\frac{2}{j}+\\frac{3}{j}) \\\\  & ={\\sum }_{j=1}^{3}\\frac{6}{j}\\end{aligned}\n$$\n\nNext, we sum over the index $j:$\n\n$$\n\\begin{aligned}{\\sum }_{j=1}^{3}\\frac{6}{j} & =\\frac{6}{1}+\\frac{6}{2}+\\frac{6}{3} \\\\  & =6+3+2 \\\\  & =11\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186365136 #edb/ref 1068 #edb/ref 17592186365137 #edb/ref 17592186045417] [17592186365136 #edb/ref 1069 "q-149738" #edb/ref 17592186045417] [17592186365136 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186365136 #edb/ref 1071 "Find the value of the double sum\n\n$$\n{\\sum }_{i=1}^{10}{\\sum }_{j=1}^{13}({a}_{i}-2)({b}_{j}-5)\n$$\n\ngiven that\n\n$$\n{\\sum }_{i=1}^{10}{a}_{i}=35,\\,{\\sum }_{j=1}^{13}{b}_{j}=70.\n$$" #edb/ref 17592186045417] [17592186365136 #edb/ref 1072 #uuid "50f28902-c131-5862-a511-9c9ad13508fc" #edb/ref 17592186045417] [17592186365136 #edb/ref 1074 "The product rule for double summations states that\n\n$$\n{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{a}_{i}{b}_{j}={\\sum }_{i=1}^{m}{a}_{i}{\\sum }_{j=1}^{n}{b}_{j}.\n$$\n\nSo, using the product rule for double summations, we get\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{10}{\\sum }_{j=1}^{13}({a}_{i}-2)({b}_{j}-5) & ={\\sum }_{i=1}^{10}({a}_{i}-2){\\sum }_{j=1}^{13}({b}_{j}-5).\\end{aligned}\n$$\n\nNow, using the rules for single summations, we obtain\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{10}({a}_{i}-2){\\sum }_{j=1}^{13}({b}_{j}-5) & =({\\sum }_{i=1}^{10}{a}_{i}-{\\sum }_{i=1}^{10}2)\\cdot ({\\sum }_{j=1}^{13}{b}_{j}-{\\sum }_{j=1}^{13}5) \\\\  & =({\\sum }_{i=1}^{10}{a}_{i}-2{\\sum }_{i=1}^{10}1)\\cdot ({\\sum }_{j=1}^{13}{b}_{j}-5{\\sum }_{j=1}^{13}1) \\\\  & =(35-2\\cdot 10)\\cdot (70-5\\cdot 13) \\\\  & =(35-20)\\cdot (70-65) \\\\  & =(15)\\cdot (5) \\\\  & =75.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186365137 #edb/ref 1075 #edb/ref 17592186365138 #edb/ref 17592186045417] [17592186365137 #edb/ref 1075 #edb/ref 17592186365139 #edb/ref 17592186045417] [17592186365137 #edb/ref 1075 #edb/ref 17592186365140 #edb/ref 17592186045417] [17592186365137 #edb/ref 1075 #edb/ref 17592186365141 #edb/ref 17592186045417] [17592186365137 #edb/ref 1075 #edb/ref 17592186365142 #edb/ref 17592186045417] [17592186365137 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186365137 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186365137 #edb/ref 1078 #edb/ref 17592186365142 #edb/ref 17592186045417] [17592186365137 #edb/ref 1079 #uuid "b944858b-8baa-5d16-beac-cfb6cb20defd" #edb/ref 17592186045417] [17592186365138 #edb/ref 1080 "70" #edb/ref 17592186045417] [17592186365138 #edb/ref 1082 #edb/ref 