48413 #edb/ref 17592186045417] [17592186049348 #edb/ref 1028 #edb/ref 17592186179667 #edb/ref 17592186045417] [17592186049348 #edb/ref 1028 #edb/ref 17592186179668 #edb/ref 17592186045417] [17592186049348 #edb/ref 1028 #edb/ref 17592186179727 #edb/ref 17592186045417] [17592186049348 #edb/ref 1031 "Upper Riemann Sums Over General Rectangular Partitions" #edb/ref 17592186045417] [17592186049348 #edb/ref 1033 3696 #edb/ref 17592186045417] [17592186049348 #edb/ref 1035 #uuid "edd9f2d1-ecae-5cc2-8bee-e8544be84391" #edb/ref 17592186045417] [17592186049359 #edb/ref 1027 #edb/ref 17592186050982 #edb/ref 17592186045417] [17592186049359 #edb/ref 1028 #edb/ref 17592186171994 #edb/ref 17592186045417] [17592186049359 #edb/ref 1028 #edb/ref 17592186171995 #edb/ref 17592186045417] [17592186049359 #edb/ref 1028 #edb/ref 17592186171996 #edb/ref 17592186045417] [17592186049359 #edb/ref 1028 #edb/ref 17592186171997 #edb/ref 17592186045417] [17592186049359 #edb/ref 1031 "One-Factor Within Groups and Between Groups Variation" #edb/ref 17592186045417] [17592186049359 #edb/ref 1033 3315 #edb/ref 17592186045417] [17592186049359 #edb/ref 1035 #uuid "eeaff77f-4bde-5a74-8ee5-1e130ae4e6a7" #edb/ref 17592186045417] [17592186049574 #edb/ref 1027 #edb/ref 17592186048413 #edb/ref 17592186045417] [17592186049574 #edb/ref 1028 #edb/ref 17592186179666 #edb/ref 17592186045417] [17592186049574 #edb/ref 1028 #edb/ref 17592186179722 #edb/ref 17592186045417] [17592186049574 #edb/ref 1031 "Calculating Double Summations Over Partitions" #edb/ref 17592186045417] [17592186049574 #edb/ref 1033 3698 #edb/ref 17592186045417] [17592186049574 #edb/ref 1035 #uuid "013fe07d-ceae-560f-ab6c-cca0e4a46ca0" #edb/ref 17592186045417] [17592186050883 #edb/ref 1027 #edb/ref 17592186048413 #edb/ref 17592186045417] [17592186050883 #edb/ref 1028 #edb/ref 17592186152153 #edb/ref 17592186045417] [17592186050883 #edb/ref 1028 #edb/ref 17592186152154 #edb/ref 17592186045417] [17592186050883 #edb/ref 1028 #edb/ref 17592186152232 #edb/ref 17592186045417] [17592186050883 #edb/ref 1031 "Lower Riemann Sums Over General Rectangular Partitions" #edb/ref 17592186045417] [17592186050883 #edb/ref 1033 2615 #edb/ref 17592186045417] [17592186050883 #edb/ref 1035 #uuid "6e302473-4377-5624-b6bf-63d1436ec9f3" #edb/ref 17592186045417] [17592186050971 #edb/ref 1027 #edb/ref 17592186050502 #edb/ref 17592186045417] [17592186050971 #edb/ref 1028 #edb/ref 17592186162124 #edb/ref 17592186045417] [17592186050971 #edb/ref 1028 #edb/ref 17592186162125 #edb/ref 17592186045417] [17592186050971 #edb/ref 1028 #edb/ref 17592186162130 #edb/ref 17592186045417] [17592186050971 #edb/ref 1028 #edb/ref 17592186162131 #edb/ref 17592186045417] [17592186050971 #edb/ref 1031 "The Joint CDF of Two Discrete Random Variables" #edb/ref 17592186045417] [17592186050971 #edb/ref 1033 3004 #edb/ref 17592186045417] [17592186050971 #edb/ref 1035 #uuid "767f9ccb-0c08-5d76-97c4-5882b4f99cd1" #edb/ref 17592186045417] [17592186128835 #edb/ref 1069 "e-10521" #edb/ref 17592186045417] [17592186128835 #edb/ref 1071 "Find the value of the double sum\n\n$$\n\\displaystyle \\sum_{i=1}^{15} \\sum_{j=1}^{18} (a_{i} - 2)( b_{j}+1)\n$$\n\ngiven that\n\n$$\n\\displaystyle \\sum_{i=1}^{15}a_i = 40, \\qquad \\displaystyle \\sum_{j=1}^{18}b_j =-8 .\n$$" #edb/ref 17592186045417] [17592186128835 #edb/ref 1072 #uuid "d180f745-028b-5859-8cad-4a49b5c20773" #edb/ref 17592186045417] [17592186128835 #edb/ref 1074 "The product rule for double summations states that\n\n$$\n\\displaystyle\\sum_{i=1}^m\\sum_{j=1}^n  a_{i}b_j = \\sum_{i=1}^m a_i \\sum_{j=1}^n b_{j}.\n$$\n\nSo, using the product rule for double summations, we get\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{15}{\\sum }_{j=1}^{18}({a}_{i}-2)({b}_{j}+1) & ={\\sum }_{i=1}^{15}({a}_{i}-2){\\sum }_{j=1}^{18}({b}_{j}+1).\\end{aligned}\n$$\n\nNow, using the rules for single summations, we obtain\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{15}({a}_{i}-2){\\sum }_{j=1}^{18}({b}_{j}+1) & =({\\sum }_{i=1}^{15}{a}_{i}-{\\sum }_{i=1}^{15}2)\\cdot ({\\sum }_{j=1}^{18}{b}_{j}+{\\sum }_{j=1}^{18}1) \\\\  & =({\\sum }_{i=1}^{15}{a}_{i}-2{\\sum }_{i=1}^{15}1)\\cdot ({\\sum }_{j=1}^{18}{b}_{j}+{\\sum }_{j=1}^{18}1) \\\\  & =(40-2\\cdot 15)\\cdot (-8+18) \\\\  & =(10)\\cdot (10) \\\\  & =100.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186128992 #edb/ref 1069 "e-6116" #edb/ref 17592186045417] [17592186128992 #edb/ref 1071 "Evaluate $\\displaystyle \\sum_{j=1}^3\\sum_{i=1}^2 (i+j).$" #edb/ref 17592186045417] [17592186128992 #edb/ref 1072 #uuid "e17f982d-3d3e-5279-b507-d390e4f1970f" #edb/ref 17592186045417] [17592186128992 #edb/ref 1074 "First, we write out the inner summation by summing over the index $i\\mathbin{:}$\n\n$$\n\\begin{aligned}{\\sum }_{j=1}^{3}{\\sum }_{i=1}^{2}(i+j) & ={\\sum }_{j=1}^{3}[{\\sum }_{i=1}^{2}(i+j)] \\\\  & ={\\sum }_{j=1}^{3}[(1+j)+(2+j)] \\\\  & ={\\sum }_{j=1}^{3}(3+2j)\\end{aligned}\n$$\n\nThen, we calculate the sum above by summing over the index $j\\mathbin{:}$\n\n$$\n\\begin{aligned}{\\sum }_{j=1}^{3}(3+2j) & =(3+2\\cdot 1)+(3+2\\cdot 2)+(3+2\\cdot 3) \\\\  & =5+7+9 \\\\  & =21\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186128993 #edb/ref 1069 "e-6118" #edb/ref 17592186045417] [17592186128993 #edb/ref 1071 "Find the value of the double sum\n\n$$\n\\sum_{i=1}^{5} \\sum_{j=1}^{8} (1+2a_{ij}-b_{ij})\n$$\n\ngiven that\n\n$$\n\\sum_{i=1}^{5} \\sum_{j=1}^{8}  a_{ij} = 8, \\qquad\\sum_{i=1}^{5} \\sum_{j=1}^{8}  b_{ij} = 15.\n$$" #edb/ref 17592186045417] [17592186128993 #edb/ref 1072 #uuid "e8f3608f-68f2-5ba9-b618-447887e7f6fb" #edb/ref 17592186045417] [17592186128993 #edb/ref 1074 "The sum and constant multiple rules for double summations state that\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}({a}_{ij}+{b}_{ij}) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{a}_{ij}+{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{b}_{ij}, \\\\ {\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}k{a}_{ij} & =k{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{a}_{ij}.\\end{aligned}\n$$\n\nApplying the sum rule to the given double summation, we have\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{5}{\\sum }_{j=1}^{8}(1+2{a}_{ij}-{b}_{ij}) & ={\\sum }_{i=1}^{5}{\\sum }_{j=1}^{8}1+{\\sum }_{i=1}^{5}{\\sum }_{j=1}^{8}2{a}_{ij}-{\\sum }_{i=1}^{5}{\\sum }_{j=1}^{8}{b}_{ij} \\\\  & =({\\sum }_{i=1}^{5}{\\sum }_{j=1}^{8}1)+2{\\sum }_{i=1}^{5}{\\sum }_{j=1}^{8}{a}_{ij}-{\\sum }_{i=1}^{5}{\\sum }_{j=1}^{8}{b}_{ij} \\\\  & =({\\sum }_{i=1}^{5}{\\sum }_{j=1}^{8}1)+2(8)-15 \\\\  & =({\\sum }_{i=1}^{5}{\\sum }_{j=1}^{8}1)+1.\\end{aligned}\n$$\n\nNow, using the fact that\n\n$$\n\\sum_{i=1}^m\\sum_{j=1}^n 1 = mn,\n$$\n\nwe have\n\n$$\n\\begin{aligned}({\\sum }_{i=1}^{5}{\\sum }_{j=1}^{8}1)+1 & =5\\cdot 8+1 \\\\  & =40+1 \\\\  & =41.\\end{aligned}\n$$\n\nSo, we conclude that\n\n$$\n\\sum_{i=1}^{5} \\sum_{j=1}^{8} (1+2a_{ij}-b_{ij}) = 41.\n$$" #edb/ref 17592186045417] [17592186129173 #edb/ref 1037 #edb/ref 17592186048820 #edb/ref 17592186045417] [17592186129173 #edb/ref 1038 #edb/ref 17592186129850 #edb/ref 17592186045417] [17592186129173 #edb/ref 1038 #edb/ref 17592186129851 #edb/ref 17592186045417] [17592186129173 #edb/ref 1038 #edb/ref 17592186339104 #edb/ref 17592186045417] [17592186129173 #edb/ref 1038 #edb/ref 17592186339105 #edb/ref 17592186045417] [17592186129173 #edb/ref 1038 #edb/ref 17592186339106 #edb/ref 17592186045417] [17592186129173 #edb/ref 1038 #edb/ref 17592186339108 #edb/ref 17592186045417] [17592186129173 #edb/ref 1038 #edb/ref 17592186365115 #edb/ref 17592186045417] [17592186129173 #edb/ref 1038 #edb/ref 17592186366240 #edb/ref 17592186045417] [17592186129173 #edb/ref 1038 #edb/ref 17592186366247 #edb/ref 17592186045417] [17592186129173 #edb/ref 1038 #edb/ref 17592186366254 #edb/ref 17592186045417] [17592186129173 #edb/ref 1039 "Computing a Double Summation" #edb/ref 17592186045417] [17592186129173 #edb/ref 1041 #edb/ref 17592186128992 #edb/ref 17592186045417] [17592186129173 #edb/ref 1042 #uuid "8537cc22-8d18-57c8-9ebf-921bd4d06ae7" #edb/ref 17592186045417] [17592186129174 