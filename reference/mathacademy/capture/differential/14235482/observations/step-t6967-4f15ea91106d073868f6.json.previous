roke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E20-MJMATHI-53\" x=\"0\" y=\"0\"></use>\n<g transform=\"translate(613,-150)\">\n <use transform=\"scale(0.707)\" xlink:href=\"#E20-MJMATHI-78\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E20-MJMATHI-78\" x=\"572\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E20-MJMAIN-3D\" x=\"1800\" y=\"0\"></use>\n<g transform=\"translate(2857,0)\">\n <use xlink:href=\"#E20-MJSZ2-2211\" x=\"0\" y=\"0\"></use>\n<g transform=\"translate(147,-1090)\">\n <use transform=\"scale(0.707)\" xlink:href=\"#E20-MJMATHI-69\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E20-MJMAIN-3D\" x=\"345\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E20-MJMAIN-31\" x=\"1124\" y=\"0\"></use>\n</g>\n <use transform=\"scale(0.707)\" xlink:href=\"#E20-MJMATHI-6E\" x=\"721\" y=\"1627\"></use>\n</g>\n <use xlink:href=\"#E20-MJMAIN-28\" x=\"4301\" y=\"0\"></use>\n<g transform=\"translate(4691,0)\">\n <use xlink:href=\"#E20-MJMATHI-78\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E20-MJMATHI-69\" x=\"809\" y=\"-213\"></use>\n</g>\n <use xlink:href=\"#E20-MJMAIN-2212\" x=\"5830\" y=\"0\"></use>\n<g transform=\"translate(6830,0)\">\n <use xlink:href=\"#E20-MJMATHI-78\" x=\"24\" y=\"0\"></use>\n<g transform=\"translate(0,259)\">\n <use transform=\"scale(0.707)\" xlink:href=\"#E20-MJMAIN-AF\" x=\"-70\" y=\"0\"></use>\n<g transform=\"translate(243.33524654895245,0) scale(0.2427625054254761,1)\">\n <use transform=\"scale(0.707)\" xlink:href=\"#E20-MJMAIN-AF\"></use>\n</g>\n <use transform=\"scale(0.707)\" xlink:href=\"#E20-MJMAIN-AF\" x=\"379\" y=\"0\"></use>\n</g>\n</g>\n<g transform=\"translate(7452,0)\">\n <use xlink:href=\"#E20-MJMAIN-29\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E20-MJMAIN-32\" x=\"550\" y=\"583\"></use>\n</g>\n</g>\n</svg></span></p>\n</li>\n</ul>\n</li>\n</ul>\n<p>The derivati