      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14235482/observations/step-q159581-48c8ddb6d6991f6f607e.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14235482/observations/step-q159581-48c8ddb6d6991f6f607e.png",
      "source_url": "https://mathacademy.com/tasks/14235482/topics/4116/lesson",
      "captured_at": 1792081036.4682767,
      "math_academy_id": "q-159581",
