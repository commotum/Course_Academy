      "assets": [],
      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14235482/observations/step-q159557-0bf0d8e43529df40d8fc.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14235482/observations/step-q159557-0bf0d8e43529df40d8fc.png",
      "source_url": "https://mathacademy.com/tasks/14235482/topics/4116/lesson",
      "captured_at": 1792081013.6417513,
      "math_academy_id": "q-159557",
      "topic_id": "4116",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q159557",
        "placement_id": null,
