ML\" display=\"block\"><msub><mrow data-mjx-texclass=\"ORD\"><mover><mrow><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mi>β</mi></mrow><mo>^</mo></mover></mrow><mn>0</mn></msub><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mo>±</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><msub><mi>t</mi><mrow data-mjx-texclass=\"ORD\"><mi>n</mi><mo>−</mo><mn>2</mn><mo>,</mo><mi>α</mi><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mn>2</mn></mrow></msub><mo>⋅</mo><mtext>SE</mtext><mo stretchy=\"false\">[</mo><msub><mrow data-mjx-texclass=\"ORD\"><mover><mrow><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mi>β</mi></mrow><mo>^</mo></mover></mrow><mn>0</mn></msub><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mo stretchy=\"false\">]</mo><mo>=</mo><mn>0.6</mn><mo>±</mo><mn>1.3</mn></math></mjx-assistive-mml></mjx-container></p>\n</li>\n</ul>\n</div></div>",
