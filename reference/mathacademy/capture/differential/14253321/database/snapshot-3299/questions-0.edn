#{[{:db/id #edb/ref 17592186555786 :knowledge-point/_questions [{:db/id #edb/ref 17592186083188 :knowledge-point/id #uuid "e1ed6e03-7d4f-5606-ab01-3bfdd855348e" :knowledge-point/title "Finding an Unknown Coefficient Given the Axis of Symmetry"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "140d1a26-6c40-56b2-a7aa-06cc13939aeb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186555039} {:answer/id #uuid "2898236d-d376-51b4-b8f7-ddd778295f25" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186555087} {:answer/id #uuid "641005cd-8b3f-5949-aba8-d33285377340" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186555225} {:answer/id #uuid "68c8f4fe-d2ac-57e9-b77c-83c2133b2dfc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186555238} {:answer/id #uuid "eea8ff49-8522-55f7-a1dd-f797ae1ba599" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{8}" :db/id #edb/ref 17592186555586}] :answer-field/correct {:answer/id #uuid "eea8ff49-8522-55f7-a1dd-f797ae1ba599" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{8}" :db/id #edb/ref 17592186555586} :answer-field/id #uuid "8376f657-f588-5dd0-82b6-5a3fe8715894" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555705}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "35646e02-dadb-58eb-b337-8ae59fb6fd33" :question/math-academy-id "q-30392" :question/problem "The axis of symmetry of the parabola $y=k{x}^{2}+3x-15$ is $x=4.$ Find the value of $k.$" :question/worked-solution "First, we will calculate the axis of symmetry in terms of $k.$ Then, we will set our result equal to $4.$ \n\nThe equation of the axis of symmetry of the parabola $y=a{x}^{2}+bx+c$ is given by\n\n$$\nx=-\\frac{b}{2a}.\n$$\n\nSubstituting $a=k$ and $b=3$ into the formula for the axis of symmetry, we get\n\n$$\n\\begin{aligned}x & =-\\frac{3}{2(k)} \\\\  & =-\\frac{3}{2k}.\\end{aligned}\n$$\n\nWe already know that the axis of symmetry is $x=4,$ so we must have\n\n$$\n\\begin{aligned}-\\frac{3}{2k} & =4 \\\\ -3 & =8k \\\\ k & =-\\frac{3}{8}.\\end{aligned}\n$$"}]}
