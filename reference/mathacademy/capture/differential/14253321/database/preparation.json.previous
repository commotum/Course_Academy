        "solution": {
          "status": "ambiguous",
          "reasoning": "The axis of symmetry is x=-b/(2a)=-k/4. Setting -k/4=3/2 gives k=-6. No captured Math Academy answer or grade establishes its stated key.",
          "confidence": 1,
          "answers": [
            {
              "key": "field-1",
              "correct_value": "-6",
              "correct_option": null,
              "value_type": "math",
              "wrong_value": "0",
