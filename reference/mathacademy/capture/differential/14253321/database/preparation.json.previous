              "captured_at": 1792145522.9167855,
              "source_sha256": "837796e7b3b7e2d2b671abf3809ee3d6d6fa974fe792d5b3eacfac071c39617b",
              "source_file": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/browser-originals/837796e7b3b7e2d2b671abf3809ee3d6d6fa974fe792d5b3eacfac071c39617b.html",
