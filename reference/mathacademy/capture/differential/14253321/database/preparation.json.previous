                  "value": "\\frac{3}{8}",
                  "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"false\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>3</mn><mn>8</mn></mfrac></mstyle></math>"
                },
