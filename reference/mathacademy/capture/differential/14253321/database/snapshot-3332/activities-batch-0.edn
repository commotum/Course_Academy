f 17592186540095} {:db/id #edb/ref 17592186540108} {:db/id #edb/ref 17592186555786} {:db/id #edb/ref 17592186560988} {:db/id #edb/ref 17592186561014} {:db/id #edb/ref 17592186561025} {:db/id #edb/ref 17592186561028}] :knowledge-point/title "Finding an Unknown Coefficient Given the Axis of Symmetry"} :step/id #uuid "4ee667dd-7fbf-5534-8753-ffdacf304f5b" :step/math-academy-id 165076}] :activity/title "The Axis of Symmetry of a Parabola" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186083410}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186555939} :activity/id #uuid "2aedf8e5-8934-58a3-922c-e425fd7146f3" :activity/scope {:db/id #edb/ref 17592186048398 :topic/id #uuid "9c16d688-8412-5b64-a180-1b55549f47da" :topic/math-academy-id 704} :activity/steps [{:db/id #edb/ref 17592186555919 :step/content {:db/id #edb/ref 17592186555846 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "010f0520-1f81-5417-8d63-763acd75346e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2,38)" :db/id #edb/ref 17592186555006} {:answer/id #uuid "1f564bb1-e463-51e8-a110-610f5d826505" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-2,-10)" :db/id #edb/ref 17592186555057} {:answer/id #uuid "397d7b39-3eef-5894-9212-13f669b2cb7d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-3,-6)" :db/id #edb/ref 17592186555124} {:answer/id #uuid "9d97b834-effc-5e59-bf27-57494456893b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-3,-12)" :db/id #edb/ref 17592186555378} {:answer/id #uuid "f3d41fac-ad3a-578a-afb8-fec99dac9b73" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3,60)" :db/id #edb/ref 17592186555600}] :answer-field/correct {:db/id #edb/ref 17592186555378} :answer-field/id #uuid "b6b01d69-c2df-5fe3-b016-c551c810194f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186555728}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "aa0495c1-850f-5f82-bb9f-fd1f7fa6ce97" :question/math-academy-id "q-30451" :question/problem "Find the coordinates of the vertex of the parabola $y=2{x}^{2}+12x+6.$" :question/worked-solution "The vertex of the parabola lies on the axis of symmetry, so we will start by computing the axis of symmetry. \n\nThe equation of the axis of symmetry of the parabola $y=a{x}^{2}+bx+c$ is given by\n\n$$\nx=-\\frac{b}{2a}.\n$$\n\nSubstituting $a=2$ and $b=12$ into the formula for the axis of symmetry, we get\n\n$$\n\\begin{aligned}x & =-\\frac{12}{2(2)} \\\\  & =-\\frac{12}{4} \\\\  & =-3.\\end{aligned}\n$$\n\nTherefore, the equation of the axis of symmetry is $x=-3.$ This also represents the $x$-coordinate of the vertex. To find the $y$-coordinate of the vertex, we substitute $x=-3$ into the original equation:\n\n$$\n\\begin{aligned}y & =2{x}^{2}+12x+6 \\\\  & =2(-3)^{2}+12(-3)+6 \\\\  & =18-36+6 \\\\  & =-12\\end{aligned}\n$$\n\nTherefore, the vertex is at $(-3,-12).$"} :step/id #uuid "800c1a08-8dd6-5f55-92e4-df70f0fce894" :step/next {:db/id #edb/ref 17592186555945}} {:db/id #edb/ref 17592186555939 :step/content {:db/id #edb/ref 17592186555786 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "140d1a26-6c40-56b2-a7aa-06cc13939aeb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186555039} {:answer/id #uuid "2898236d-d376-51b4-b8f7-ddd778295f25" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186555087} {:answer/id #uuid "641005cd-8b3f-5949-aba8-d33285377340" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186555225} {:answer/id #uuid "68c8f4fe-d2ac-57e9-b77c-83c2133b2dfc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186555238} {:answer/id #uuid "eea8ff49-8522-55f7-a1dd-f797ae1ba599" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3}{8}" :db/id #edb/ref 17592186555586}] :answer-field/correct {:db/id #edb/ref 17592186555586} :answer-field/id #uuid "8376f657-f588-5dd0-82b6-5a3fe8715894" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186555705}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "35646e02-dadb-58eb-b337-8ae59fb6fd33" :question/math-academy-id "q-30392" :question/problem "The axis of symmetry of the parabola $y=k{x}^{2}+3x-15$ is $x=4.$ Find the value of $k.$" :question/worked-solution "First, we will calculate the axis of symmetry in terms of $k.$ Then, we will set our result equal to $4.$ \n\nThe equation of the axis of symmetry of the parabola $y=a{x}^{2}+bx+c$ is given by\n\n$$\nx=-\\frac{b}{2a}.\n$$\n\nSubstituting $a=k$ and $b=3$ into the formula for the axis of symmetry, we get\n\n$$\n\\begin{aligned}x & =-\\frac{3}{2(k)} \\\\  & =-\\frac{3}{2k}.\\end{aligned}\n$$\n\nWe already know that the axis of symmetry is $x=4,$ so we must have\n\n$$\n\\begin{aligned}-\\frac{3}{2k} & =4 \\\\ -3 & =8k \\\\ k & =-\\frac{3}{8}.\\end{aligned}\n$$"} :step/id #uuid "ce67b857-f176-5873-ba8a-87814b9af6a7" :step/next {:db/id #edb/ref 17592186555919}} {:db/id #edb/ref 17592186555945 :step/content {:db/id #edb/ref 17592186555853 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d9e3163-77a3-5b77-b6dd-5f9cc4183e81" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-1,-4)" :db/id #edb/ref 17592186555102} {:answer/id #uuid "4aaceaf8-31cb-57d9-89f4-40f6fbb0f71e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(1,\\frac{3}{4})" :db/id #edb/ref 17592186555164} {:answer/id #uuid "8720512d-ed7f-54db-9220-6ac8c52ec59f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\frac{1}{4},-\\frac{3}{4})" :db/id #edb/ref 17592186555313} {:answer/id #uuid "d7eb0642-fe00-5e0f-a9ab-9dcbf769b12b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(4,3)" :db/id #edb/ref 17592186555520} {:answer/id #uuid "f60b95e6-696c-5f40-9e72-4690b1e4355c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\frac{1}{4},\\frac{3}{4})" :db/id #edb/ref 17592186555611}] :answer-field/correct {:db/id #edb/ref 17592186555611} :answer-field/id #uuid "a9f334df-9edf-56f6-b904-ca6fc39afbf1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186555722}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c47ad7a3-3c57-54bc-8711-6eebfda1e26f" :question/math-academy-id "q-30452" :question/problem "Find the coordinates of the vertex of the parabola $y=4{x}^{2}-2x+1.$" :question/worked-solution "The vertex of the parabola lies on the axis of symmetry, so we will start by computing the axis of symmetry. \n\nThe equation of the axis of symmetry of the parabola $y=a{x}^{2}+bx+c$ is given by\n\n$$\nx=-\\frac{b}{2a}.\n$$\n\nSubstituting $a=4$ and $b=-2$ into the formula for the axis of symmetry, we get\n\n$$\n\\begin{aligned}x & =-\\frac{-2}{2(4)} \\\\  & =-\\frac{-2}{8} \\\\  & =\\frac{1}{4}.\\end{aligned}\n$$\n\nTherefore, the equation of the axis of symmetry is $x=\\frac{1}{4}.$ This also represents the $x$-coordinate of the vertex. To find the $y$-coordinate of the vertex, we substitute $x=\\frac{1}{4}$ into the original equation:\n\n$$\n\\begin{aligned}y & =4{x}^{2}-2x+1 \\\\  & =4{(\\frac{1}{4})}^{2}-2(\\frac{1}{4})+1 \\\\  & =\\frac{1}{4}-\\frac{1}{2}+1 \\\\  & =\\frac{1}{4}-\\frac{2}{4}+\\frac{4}{4} \\\\  & =\\frac{3}{4}\\end{aligned}\n$$\n\nTherefore, the vertex is at $(\\frac{1}{4},\\frac{3}{4}).$"} :step/id #uuid "d9a1c56e-6c1b-5141-9c3c-939ad62ac505"}] :activity/title "The Axis of Symmetry of a Parabola" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186554990}]}
