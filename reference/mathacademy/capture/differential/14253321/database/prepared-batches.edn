ces "answer-8d6c548b-b225-568b-bdc9-564b778e4bf2"] ["answer-field-7e654e0f-3b40-53d7-a97b-7d2ab9414e1c" :answer-field/choices "answer-e466d8d2-53fc-52b8-86b0-89d7e7f5c76c"] ["answer-field-7e654e0f-3b40-53d7-a97b-7d2ab9414e1c" :answer-field/choices "answer-dc2e517b-908e-5753-87b7-fdab17666b56"] ["answer-field-7e654e0f-3b40-53d7-a97b-7d2ab9414e1c" :answer-field/choices "answer-dc88694f-3439-5d5a-9183-481f111cd2b7"] ["question-c207588d-de7f-557d-a79c-724dc500a5ab" :question/answer-fields "answer-field-7e654e0f-3b40-53d7-a97b-7d2ab9414e1c"] [17592186083186 :knowledge-point/questions "question-c207588d-de7f-557d-a79c-724dc500a5ab"] ["question-921e549a-bfee-5f3e-b0ea-16a68e62a19c" :question/id #uuid "921e549a-bfee-5f3e-b0ea-16a68e62a19c"] ["question-921e549a-bfee-5f3e-b0ea-16a68e62a19c" :question/math-academy-id "q-222090"] ["question-921e549a-bfee-5f3e-b0ea-16a68e62a19c" :question/problem "What are the coordinates of the vertex of the parabola $y=-4{x}^{2}-20x-15?$\n\nThe coordinates of the vertex are\n$($\n{{field-1}}\n,\n{{field-2}}\n$).$"] ["question-921e549a-bfee-5f3e-b0ea-16a68e62a19c" :question/worked-solution "The parabola's vertex lies on the symmetry axis, so we will start by computing the axis of symmetry. \n\nThe equation of the axis of symmetry of the parabola $y=a{x}^{2}+bx+c$ is given by\n\n$$\nx=-\\frac{b}{2a}.\n$$\n\nSubstituting $a=-4$ and $b=-20$ into the formula for the axis of symmetry, we get\n\n$$\n\\begin{aligned}x & =-\\frac{(-20)}{2(-4)} \\\\  & =-\\frac{(-20)}{(-8)} \\\\  & =-\\frac{5}{2}.\\end{aligned}\n$$\n\nTherefore, the equation of the axis of symmetry is $x=-\\frac{5}{2}.$ This also represents the $x$-coordinate of the vertex. To find the $y$-coordinate of the vertex, we substitute $x=-\\frac{5}{2}$ into the original equation:\n\n$$\n\\begin{aligned}y & =-4{x}^{2}-20x-15 \\\\  & =-4{(-\\frac{5}{2})}^{2}-20(-\\frac{5}{2})-15 \\\\  & =-25+50-15 \\\\  & =10\\end{aligned}\n$$\n\nTherefore, the vertex is at $(-\\frac{5}{2},10).$"] ["question-921e549a-bfee-5f3e-b0ea-16a68e62a19c" :question/difficulty :question.difficulty/moderate] ["answer-field-13f920a3-0d4a-551a-8220-e772169b0aaf" :answer-field/id #uuid "13f920a3-0d4a-551a-8220-e772169b0aaf"] ["answer-31db1cd7-0388-50c2-b462-7f35cbf65e87" :answer/id #uuid "31db1cd7-0388-50c2-b462-7f35cbf65e87"] ["answer-31db1cd7-0388-50c2-b462-7f35cbf65e87" :answer/type :answer.type/math] ["answer-31db1cd7-0388-50c2-b462-7f35cbf65e87" :answer/value "-\\frac{5}{2}"] ["answer-field-13f920a3-0d4a-551a-8220-e772169b0aaf" :answer-field/key "field-1"] ["answer-field-13f920a3-0d4a-551a-8220-e772169b0aaf" :answer-field/type :answer-field.type/blank] ["answer-field-13f920a3-0d4a-551a-8220-e772169b0aaf" :answer-field/correct "answer-31db1cd7-0388-50c2-b462-7f35cbf65e87"] ["answer-field-13f920a3-0d4a-551a-8220-e772169b0aaf" :answer-field/choices "answer-31db1cd7-0388-50c2-b462-7f35cbf65e87"] ["answer-field-44e647b3-cb17-50f5-a019-b6672e2e8687" :answer-field/id #uuid "44e647b3-cb17-50f5-a019-b6672e2e8687"] ["answer-8c4f249c-80a1-5293-abb1-c40a523ef755" :answer/id #uuid "8c4f249c-80a1-5293-abb1-c40a523ef755"] ["answer-8c4f249c-80a1-5293-abb1-c40a523ef755" :answer/type :answer.type/math] ["answer-8c4f249c-80a1-5293-abb1-c40a523ef755" :answer/value "10"] ["answer-field-44e647b3-cb17-50f5-a019-b6672e2e8687" :answer-field/key "field-2"] ["answer-field-44e647b3-cb17-50f5-a019-b6672e2e8687" :answer-field/type :answer-field.type/blank] ["answer-field-44e647b3-cb17-50f5-a019-b6672e2e8687" :answer-field/correct "answer-8c4f249c-80a1-5293-abb1-c40a523ef755"] ["answer-field-44e647b3-cb17-50f5-a019-b6672e2e8687" :answer-field/choices "answer-8c4f249c-80a1-5293-abb1-c40a523ef755"] ["question-921e549a-bfee-5f3e-b0ea-16a68e62a19c" :question/answer-fields "answer-field-13f920a3-0d4a-551a-8220-e772169b0aaf"] ["question-921e549a-bfee-5f3e-b0ea-16a68e62a19c" :question/answer-fields "answer-field-44e647b3-cb17-50f5-a019-b6672e2e8687"] [17592186083187 :knowledge-point/questions "question-921e549a-bfee-5f3e-b0ea-16a68e62a19c"] ["question-f4b5f32d-44e0-5a1d-94d9-969e7ec4b9e5" :question/id #uuid "f4b5f32d-44e0-5a1d-94d9-969e7ec4b9e5"] ["question-f4b5f32d-44e0-5a1d-94d9-969e7ec4b9e5" :question/math-academy-id "q-222091"] ["question-f4b5f32d-44e0-5a1d-94d9-969e7ec4b9e5" :question/problem "What are the coordinates of the vertex of the parabola $y=-6{x}^{2}+36x-50?$\n\nThe coordinates of the vertex are\n$($\n{{field-1}}\n,\n{{field-2}}\n$).$"] ["question-f4b5f32d-44e0-5a1d-94d9-969e7ec4b9e5" :question/worked-solution "The parabola's vertex lies on the symmetry axis, so we will start by computing the axis of symmetry. \n\nThe equation of the axis of symmetry of the parabola $y=a{x}^{2}+bx+c$ is given by\n\n$$\nx=-\\frac{b}{2a}.\n$$\n\nSubstituting $a=-6$ and $b=36$ into the formula for the axis of symmetry, we get\n\n$$\n\\begin{aligned}x & =-\\frac{36}{2(-6)} \\\\  & =-\\frac{36}{(-12)} \\\\  & =3.\\end{aligned}\n$$\n\nTherefore, the equation of the axis of symmetry is $x=3.$ This also represents the $x$-coordinate of the vertex. To find the $y$-coordinate of the vertex, we substitute $x=3$ into the original equation:\n\n$$\n\\begin{aligned}y & =-6{x}^{2}+36x-50 \\\\  & =-6(3)^{2}+36(3)-50 \\\\  & =-54+108-50 \\\\  & =4\\end{aligned}\n$$\n\nTherefore, the vertex is at $(3,4).$"] ["question-f4b5f32d-44e0-5a1d-94d9-969e7ec4b9e5" :question/difficulty :question.difficulty/moderate] ["answer-field-cbac6a08-e26c-5408-a819-05f38465fc30" :answer-field/id #uuid "cbac6a08-e26c-5408-a819-05f38465fc30"] ["answer-06ac108c-b471-57d9-80ac-0abd026df00c" :answer/id #uuid "06ac108c-b471-57d9-80ac-0abd026df00c"] ["answer-06ac108c-b471-57d9-80ac-0abd026df00c" :answer/type :answer.type/math] ["answer-06ac108c-b471-57d9-80ac-0abd026df00c" :answer/value "3"] ["answer-field-cbac6a08-e26c-5408-a819-05f38465fc30" :answer-field/key "field-1"] ["answer-field-cbac6a08-e26c-5408-a819-05f38465fc30" :answer-field/type :answer-field.type/blank] ["answer-field-cbac6a08-e26c-5408-a819-05f38465fc30" :answer-field/correct "answer-06ac108c-b471-57d9-80ac-0abd026df00c"] ["answer-field-cbac6a08-e26c-5408-a819-05f38465fc30" :answer-field/choices "answer-06ac108c-b471-57d9-80ac-0abd026df00c"] ["answer-field-2a4a93e8-de2d-5dd6-817c-153f5cd7e72e" :answer-field/id #uuid "2a4a93e8-de2d-5dd6-817c-153f5cd7e72e"] ["answer-7092c657-4358-5214-980c-4ac3dbacdc46" :answer/id #uuid "7092c657-4358-5214-980c-4ac3dbacdc46"] ["answer-7092c657-4358-5214-980c-4ac3dbacdc46" :answer/type :answer.type/math] ["answer-7092c657-4358-5214-980c-4ac3dbacdc46" :answer/value "4"] ["answer-field-2a4a93e8-de2d-5dd6-817c-153f5cd7e72e" :answer-field/key "field-2"] ["answer-field-2a4a93e8-de2d-5dd6-817c-153f5cd7e72e" :answer-field/type :answer-field.type/blank] ["answer-field-2a4a93e8-de2d-5dd6-817c-153f5cd7e72e" :answer-field/correct "answer-7092c657-4358-5214-980c-4ac3dbacdc46"] ["answer-field-2a4a93e8-de2d-5dd6-817c-153f5cd7e72e" :answer-field/choices "answer-7092c657-4358-5214-980c-4ac3dbacdc46"] ["question-f4b5f32d-44e0-5a1d-94d9-969e7ec4b9e5" :question/answer-fields "answer-field-cbac6a08-e26c-5408-a819-05f38465fc30"] ["question-f4b5f32d-44e0-5a1d-94d9-969e7ec4b9e5" :question/answer-fields "answer-field-2a4a93e8-de2d-5dd6-817c-153f5cd7e72e"] [17592186083187 :knowledge-point/questions "question-f4b5f32d-44e0-5a1d-94d9-969e7ec4b9e5"] ["question-d2d178d8-95d3-5b79-a668-502abcb61a00" :question/id #uuid "d2d178d8-95d3-5b79-a668-502abcb61a00"] ["question-d2d178d8-95d3-5b79-a668-502abcb61a00" :question/math-academy-id "q-222099"] ["question-d2d178d8-95d3-5b79-a668-502abcb61a00" :question/problem "The axis of symmetry of the parabola $y=2{x}^{2}+kx-5$ is $x=\\frac{3}{2}.$ Determine the value of $k.$\n\n$k=$\n{{field-1}}"] ["question-d2d178d8-95d3-5b79-a668-502abcb61a00" :question/worked-solution "First, we will calculate the axis of symmetry in terms of $k.$ Then, we will set our result equal to $\\frac{3}{2}.$ \n\nThe equation of the axis of symmetry of the parabola $y=a{x}^{2}+bx+c$ is given by\n\n$$\nx=-\\frac{b}{2a}.\n$$\n\nSubstituting $a=2$ and $b=k$ into the formula for the axis of symmetry, we get\n\n$$\n\\begin{aligned}x & =-\\frac{k}{2(2)} \\\\  & =-\\frac{k}{4}.\\end{aligned}\n$$\n\nWe already know that the axis of symmetry is $x=\\frac{3}{2},$ so we must have\n\n$$\n\\begin{aligned}-\\frac{k}{4} & =\\frac{3}{2} \\\\ -2k & =12 \\\\ k & =-6.\\end{aligned}\n$$"] ["question-d2d178d8-95d3-5b79-a668-502abcb61a00" :question/difficulty :question.difficulty/moderate] ["answer-field-9b79dd02-0c44-507a-872c-6291665d2761" :answer-field/id #uuid "9b79dd02-0c44-507a-872c-6291665d2761"] ["answer-4de27478-f8d7-5730-a9dc-ce87e0ba8be2" :answer/id #uuid "4de27478-f8d7-5730-a9dc-ce87e0ba8be2"] ["answer-4de27478-f8d7-5730-a9dc-ce87e0ba8be2" :answer/type :answer.type/math] ["answer-4de27478-f8d7-5730-a9dc-ce87e0ba8be2" :answer/value "-6"] ["answer-field-9b79dd02-0c44-507a-872c-6291665d2761" :answer-field/key "field-1"] ["answer-field-9b79dd02-0c44-507a-872c-6291665d2761" :answer-field/type :answer-field.type/blank] ["answer-field-9b79dd02-0c44-507a-872c-6291665d2761" :answer-field/correct "answer-4de27478-f8d7-5730-a9dc-ce87e0ba8be2"] ["answer-field-9b79dd02-0c44-507a-872c-6291665d2761" :answer-field/choices "answer-4de27478-f8d7-5730-a9dc-ce87e0ba8be2"] ["question-d2d178d8-95d3-5b79-a668-502abcb61a00" :question/answer-fields "answer-field-9b79dd02-0c44-507a-872c-6291665d2761"] [17592186083188 :knowledge-point/questions "question-d2d178d8-95d3-5b79-a668-502abcb61a00"] ["activity-c8d10b73-e07e-509a-aec1-f2b3a29fb284" :activity/id #uuid "c8d10b73-e07e-509a-aec1-f2b3a29fb284"] ["step-b12389b5-67df-5c44-b210-83742438e421" :step/id #uuid "b12389b5-67df-5c44-b210-83742438e421"] ["step-18d86b3c-4e00-5635-b5c3-fb137426a5ea" :step/id #uuid "18d86b3c-4e00-5635-b5c3-fb137426a5ea"] ["step-89314c6c-64d9-56c7-839f-504067b7131e" :step/id #uuid "89314c6c-64d9-56c7-839f-504067b7131e"] ["step-b55ba22e-1ae6-567d-bd64-6cdbfa865e8d" :step/id #uuid "b55ba22e-1ae6-567d-bd64-6cdbfa865e8d"] ["step-bbde325