del"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6580bac7-1130-5351-893a-e4dcf60069b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "negative linear" :db/id #edb/ref 17592186545393} {:answer/id #uuid "77cabf77-e6c0-5f6f-9a4c-bd41e979cb6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "exponential" :db/id #edb/ref 17592186545423} {:answer/id #uuid "9a36e9ca-93f7-5a9a-a080-5f1b3ec3a340" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "positive linear" :db/id #edb/ref 17592186545477} {:answer/id #uuid "9f8618de-fdcf-5b2b-9940-636b7e597823" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "no correlation" :db/id #edb/ref 17592186545494} {:answer/id #uuid "b4228193-619c-5e23-af9b-e428892ac13b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "quadratic" :db/id #edb/ref 17592186545528}] :answer-field/correct {:answer/id #uuid "b4228193-619c-5e23-af9b-e428892ac13b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "quadratic" :db/id #edb/ref 17592186545528} :answer-field/id #uuid "8a7f6bc7-349d-51b4-a153-e8e0a5b86236" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186545738}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e2b9b16e-f138-5cec-b1bd-3819d0d7a9b5" :question/math-academy-id "q-17640" :question/problem "![](images/18/1862385f45f9082d3100246dbafd020c388c3fe4d83bc38e8c617916f79ab4a0.png)\n\nA drone is flying around some tourist buildings. The scatter plot above shows the correspondence between the drone's height, in meters, and the time, in minutes, since it started its journey. Which of the following is the most appropriate regression model for this data?" :question/worked-solution "As values of $x$ increase, the corresponding values of $y$ first increase and then decrease. It seems like the points on the plot are scattered along a parabola, as shown below.\n\n![](images/0a/0a00ddf1bea18a587a0a960a8965516a1cc3ff9ab9e13f25d6a23c59d51f44fc.png)\n\nTherefore, among the given options, the most appropriate regression model is *quadratic.*"}]}
