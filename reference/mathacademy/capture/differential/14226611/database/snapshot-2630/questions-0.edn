#{[{:db/id #edb/ref 17592186083028 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186083228 :knowledge-point/id #uuid "a1aa6320-1643-5363-9ccc-8b86b48a9609" :knowledge-point/title "Identifying an Appropriate Regression Model"}] :question/id #uuid "0ac76a89-dd8b-5f79-96ee-b73f96d98c87" :question/math-academy-id "e-5718" :question/problem "![](images/ac/ac3704f44a4719bf20040a66410c3ed4c9251a9a2c6775204d61c537ac9eaf83.png)\n\nA country keeps a record of its population growth. The scatter plot above shows the correspondence between the population (in millions) and the time (in years) since records began.\nWhich of the following is the most appropriate regression model for this data?\n\nI. Linear\n\nII. Quadratic\n\nIII. Exponential" :question/worked-solution "As values of $x$ increase, the corresponding values of $y$ increase rapidly. It seems like the points on the plot are scattered along an exponential curve, as shown below.\n\n![](images/4f/4f6a9d4ab36404f6cb0772e5fb537afeeb244ec8e1f59abae54b95e69c904463.png)\n\nTherefore, the most appropriate regression model is *exponential.*"}] [{:db/id #edb/ref 17592186083029 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186083229 :knowledge-point/id #uuid "9100136d-6adb-5138-bab2-55c278876811" :knowledge-point/title "Identifying a Diagram Corresponding to a Model"}] :question/id #uuid "b3c9f5da-2d02-5d4d-b519-818b77320211" :question/math-academy-id "e-5719" :question/problem "Which of the following scatter plots shows a possible exponential dependence between the variables?\n\n![](images/33/33343af118a165da06ca7e361088bad26a7ced2b0039179822fe046d9ffd761b.png)" :question/worked-solution "In the case of exponential dependence, the points on the plot should be scattered along a curve whose $y$-values increase or decrease rapidly.\n\nAmong the given options, the only scatter plot that fits the description is the following:\n\n![](images/fc/fc96819983d673d889cbf8be48e92f4546010640d555d1b41074fd031cf4430d.png)"}] [{:db/id #edb/ref 17592186083477 :knowledge-point/_questions [{:db/id #edb/ref 17592186083229 :knowledge-point/id #uuid "9100136d-6adb-5138-bab2-55c278876811" :knowledge-point/title "Identifying a Diagram Corresponding to a Model"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "944fcc9a-773e-5b66-a967-1ad83e6286e6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/76/7687bdd3945e1ad655a2be00e9d661c0e3916c49424d908ae2a314885e4fcc76.png" :db/id #edb/ref 17592186079758} {:answer/id #uuid "bb2f8d6c-965c-5834-bc4a-dcc3fcf79c43" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c5/c58fc01ee3a7007d8b981902ac680a7b80a4f3b33d8d14b4825b0e3310613509.png" :db/id #edb/ref 17592186079759} {:answer/id #uuid "dc451b6e-f03c-5cc0-8371-3be1bf4da417" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b8/b8cad95a9239325ab09288296374cce28c5ab2ac08a811eee9a6cc29d86b1b59.png" :db/id #edb/ref 17592186079760} {:answer/id #uuid "091ca323-e7c0-56b1-b2aa-c152622bfec7" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/43/437a108f4b202ca0adf9a3669e8b543670edfda7ff91b268c7ae46ca05882a61.png" :db/id #edb/ref 17592186079761} {:answer/id #uuid "422e886a-f840-5a87-9e61-0b5d6c22605e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/79/79fea8c56593a55ce059727546cf199077873d5d82b67a53a2ada8bc541678c7.png" :db/id #edb/ref 17592186079762}] :answer-field/correct {:answer/id #uuid "422e886a-f840-5a87-9e61-0b5d6c22605e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/79/79fea8c56593a55ce059727546cf199077873d5d82b67a53a2ada8bc541678c7.png" :db/id #edb/ref 17592186079762} :answer-field/id #uuid "5810417f-11a1-5df4-814a-3d9c54fbb931" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186