d32969067d4" :step/id #uuid "cdf898f6-45d1-58e0-a005-fd32969067d4" :step/content "question-39ac48e2-8478-529d-91f9-60e771cc4eb9" :step/next "step-ed7a7cf8-ffdb-5b0f-9201-cd08ad8f2b59" :db/ensure [:step/validate]} {:db/id "step-ed7a7cf8-ffdb-5b0f-9201-cd08ad8f2b59" :step/id #uuid "ed7a7cf8-ffdb-5b0f-9201-cd08ad8f2b59" :step/content "question-a946e21d-5a37-5585-a234-01e6acc34eca" :step/next "step-e74a8af4-059f-50bf-807d-00656676699e" :db/ensure [:step/validate]} {:db/id "step-e74a8af4-059f-50bf-807d-00656676699e" :step/id #uuid "e74a8af4-059f-50bf-807d-00656676699e" :step/content "question-acbab80b-b003-5343-8102-3dfe5d2664d2" :db/ensure [:step/validate]}] "assertions" [[17592186192964 :question/problem "The covariance matrix $C$ of some particular observations is shown below. \n\n$$\nC=[\\begin{aligned}9 & 2 \\\\ 2 & 6\\end{aligned}]\n$$\n\nFind the first principal component of the data, given that the eigenvalues of $C$ are $10$ and $5.$"] [17592186192964 :question/worked-solution "Recall that the unit eigenvectors of the covariance matrix $C$ are called the principal components of the data. If \n\n$$\n{\\lambda }_{1}>{\\lambda }_{2}>⋯>{\\lambda }_{n}\n$$\n\nare the eigenvalues of $C$ written in descending order, then: \n\n- the $1$st principal component is the unit eigenvector ${u}_{1}$ corresponding to the $1$st eigenvalue ${\\lambda }_{1},$\n\n- the $2$nd principal component is the unit eigenvector ${u}_{2}$ corresponding to the $2$nd eigenvalue ${\\lambda }_{2},$\n\n- $⋯$\n\nand so on.\n\nIn our case, the eigenvalues of the covariance matrix $C,$ in descending order, are ${\\lambda }_{1}=10$ and ${\\lambda }_{2}=5.$\nSo, we need the unit eigenvector that corresponds to the eigenvalue ${\\lambda }_{1}=10:$\n\n$$\n\\begin{aligned}C-10I & =[\\begin{aligned}9 & 2 \\\\ 2 & 6\\end{aligned}]-10[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}-1 & 2 \\\\ 2 & -4\\end{aligned}]\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(C-10I)x=0$ gives the eigenvector ${v}_{1}=[\\begin{aligned}2 \\\\ 1\\end{aligned}].$ \n\nFinally, dividing ${v}_{1}$ by its norm $‖{v}_{1}‖=\\sqrt{5},$ we get \n\n$$\n{u}_{1}=\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{5}}[\\begin{aligned}2 \\\\ 1\\end{aligned}].\n$$"] [17592186192964 :question/difficulty :question.difficulty/easy] ["answer-293116cd-0210-5cb9-b17d-b36dfb030db8" :answer/id #uuid "293116cd-0210-5cb9-b17d-b36dfb030db8"] ["answer-293116cd-0210-5cb9-b17d-b36dfb030db8" :answer/type :answer.type/math] ["answer-293116cd-0210-5cb9-b17d-b36dfb030db8" :answer/value "[\\begin{aligned}0 \\\\ 1\\end{aligned}]"] ["answer-7d7115fa-f1a5-50b1-8fb7-1bae6211fe0c" :answer/id #uuid "7d7115fa-f1a5-50b1-8fb7-1bae6211fe0c"] ["answer-7d7115fa-f1a5-50b1-8fb7-1bae6211fe0c" :answer/type :answer.type/math] ["answer-7d7115fa-f1a5-50b1-8fb7-1bae6211fe0c" :answer/value "\\frac{1}{\\sqrt{2}}[\\begin{aligned}-1 \\\\ 1\\end{aligned}]"] ["answer-ad077701-5e2a-550b-be10-c54987ab6c1c" :answer/id #uuid "ad077701-5e2a-550b-be10-c54987ab6c1c"] ["answer-ad077701-5e2a-550b-be10-c54987ab6c1c" :answer/type :answer.type/math] ["answer-ad077701-5e2a-550b-be10-c54987ab6c1c" :answer/value "\\frac{1}{\\sqrt{2}}[\\begin{aligned}1 \\\\ 1\\end{aligned}]"] ["answer-c3d6cc6f-6996-5a19-a1b9-8d08475ff929" :answer/id #uuid "c3d6cc6f-6996-5a19-a1b9-8d08475ff929"] ["answer-c3d6cc6f-6996-5a19-a1b9-8d08475ff929" :answer/type :answer.type/math] ["answer-c3d6cc6f-6996-5a19-a1b9-8d08475ff929" :answer/value "\\frac{1}{\\sqrt{5}}[\\begin{aligned}-1 \\\\ 2\\end{aligned}]"] ["answer-0f6ce6b3-e086-5afc-bc5f-380578a38364" :answer/id #uuid "0f6ce6b3-e086-5afc-bc5f-380578a38364"] ["answer-0f6ce6b3-e086-5afc-bc5f-380578a38364" :answer/type :answer.type/math] ["answer-0f6ce6b3-e086-5afc-bc5f-380578a38364" :answer/value "\\frac{1}{\\sqrt{5}}[\\begin{aligned}2 \\\\ 1\\end{aligned}]"] [17592186189670 :answer-field/correct "answer-0f6ce6b3-e086-5afc-bc5f-380578a38364"] [17592186189670 :answer-field/choices "answer-293116cd-0210-5cb9-b17d-b36dfb030db8"] [17592186189670 :answer-field/choices "answer-7d7115fa-f1a5-50b1-8fb7-1bae6211fe0c"] [17592186189670 :answer-field/choices "answer-ad077701-5e2a-550b-be10-c54987ab6c1c"] [17592186189670 :answer-field/choices "answer-c3d6cc6f-6996-5a19-a1b9-8d08475ff929"] [17592186189670 :answer-field/choices "answer-0f6ce6b3-e086-5afc-bc5f-380578a38364"] ["question-43345541-f657-59ff-989d-45d4cfc772b4" :question/id #uuid "43345541-f657-59ff-989d-45d4cfc772b4"] ["question-43345541-f657-59ff-989d-45d4cfc772b4" :question/math-academy-id "q-138506"] ["question-43345541-f657-59ff-989d-45d4cfc772b4" :question/problem "The covariance matrix $C$ of some particular observations is shown below. \n\n$$\nC=[\\begin{aligned}2 & 2 \\\\ 2 & 5\\end{aligned}]\n$$\n\nFind the first principal component of the data, given that the eigenvalues of $C$ are $1$ and $6.$"] ["question-43345541-f657-59ff-989d-45d4cfc772b4" :question/worked-solution "Recall that the unit eigenvectors of the covariance matrix $C$ are called the principal components of the data. If \n\n$$\n{\\lambda }_{1}>{\\lambda }_{2}>⋯>{\\lambda }_{n}\n$$\n\nare the eigenvalues of $C$ written in descending order, then: \n\n- the $1$st principal component is the unit eigenvector ${u}_{1}$ corresponding to the $1$st eigenvalue ${\\lambda }_{1},$\n\n- the $2$nd principal component is the unit eigenvector ${u}_{2}$ corresponding to the $2$nd eigenvalue ${\\lambda }_{2},$\n\n- $⋯$\n\nand so on.\n\nIn our case, the eigenvalues of the covariance matrix $C,$ in descending order, are ${\\lambda }_{1}=6$ and ${\\lambda }_{2}=1.$\nSo, we need the unit eigenvector that corresponds to the eigenvalue ${\\lambda }_{1}=6:$\n\n$$\n\\begin{aligned}C-6I & =[\\begin{aligned}2 & 2 \\\\ 2 & 5\\end{aligned}]-6[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}-4 & 2 \\\\ 2 & -1\\end{aligned}]\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(C-6I)x=0$ gives the eigenvector ${v}_{1}=[\\begin{aligned}1 \\\\ 2\\end{aligned}].$\n\nFinally, dividing ${v}_{1}$ by its norm $‖{v}_{1}‖=\\sqrt{5},$ we get \n\n$$\n\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{5}}[\\begin{aligned}1 \\\\ 2\\end{aligned}].\n$$"] ["question-43345541-f657-59ff-989d-45d4cfc772b4" :question/difficulty :question.difficulty/easy] ["answer-field-44831ce7-23e4-5530-a096-5c88232103b9" :answer-field/id #uuid "44831ce7-23e4-5530-a096-5c88232103b9"] ["answer-af6affa2-ae7d-5319-81fa-de2ad83b73eb" :answer/id #uuid "af6affa2-ae7d-5319-81fa-de2ad83b73eb"] ["answer-af6affa2-ae7d-5319-81fa-de2ad83b73eb" :answer/type :answer.type/math] ["answer-af6affa2-ae7d-5319-81fa-de2ad83b73eb" :answer/value "\\frac{1}{\\sqrt{2}}[\\begin{aligned}1 \\\\ 1\\end{aligned}]"] ["answer-ed501507-7e1b-5c82-a8f9-b2410c792d5f" :answer/id #uuid "ed501507-7e1b-5c82-a8f9-b2410c792d5f"] ["answer-ed501507-7e1b-5c82-a8f9-b2410c792d5f" :answer/type :answer.type/math] ["answer-ed501507-7e1b-5c82-a8f9-b2410c792d5f" :answer/value "\\frac{1}{\\sqrt{3}}[\\begin{aligned}1 \\\\ 2\\end{aligned}]"] ["answer-2c97f85d-47a1-51b6-a9b9-778680ce8fdc" :answer/id #uuid "2c97f85d-47a1-51b6-a9b9-778680ce8fdc"] ["answer-2c97f85d-47a1-51b6-a9b9-778680ce8fdc" :answer/type :answer.type/math] ["answer-2c97f85d-47a1-51b6-a9b9-778680ce8fdc" :answer/value "\\frac{1}{\\sqrt{5}}[\\begin{aligned}1 \\\\ 1\\end{aligned}]"] ["answer-18bbaa38-d421-5746-a3c1-8145fc019ca0" :answer/id #uuid "18bbaa38-d421-5746-a3c1-8145fc019ca0"] ["answer-18bbaa38-d421-5746-a3c1-8145fc019ca0" :answer/type :answer.type/math] ["answer-18bbaa38-d421-5746-a3c1-8145fc019ca0" :answer/value "\\frac{1}{\\sqrt{5}}[\\begin{aligned}1 \\\\ 2\\end{aligned}]"] ["answer-756ee275-5880-5a22-a4a6-9e1067a5ba8a" :answer/id #uuid "756ee275-5880-5a22-a4a6-9e1067a5ba8a"] ["answer-756ee275-5880-5a22-a4a6-9e1067a5ba8a" :answer/type :answer.type/math] ["answer-756ee275-5880-5a22-a4a6-9e1067a5ba8a" :answer/value "\\frac{1}{\\sqrt{5}}[\\begin{aligned}2 \\\\ 1\\end{aligned}]"] ["answer-field-44831ce7-23e4-5530-a096-5c88232103b9" :answer-field/key "selection"] ["answer-field-44831ce7-23e4-5530-a096-5c88232103b9" :answer-field/type :answer-field.type/radio] ["answer-field-44831ce7-23e4-5530-a096-5c88232103b9" :answer-field/correct "answer-18bbaa38-d421-5746-a3c1-8145fc019ca0"] ["answer-field-44831ce7-23e4-5530-a096-5c88232103b9" :answer-field/choices "answer-af6affa2-ae7d-5319-81fa-de2ad83b73eb"] ["answer-field-44831ce7-23e4-5530-a096-5c88232103b9" :answer-field/choices "answer-ed501507-7e1b-5c82-a8f9-b2410c792d5f"] ["answer-field-44831ce7-23e4-5530-a096-5c88232103b9" :answer-field/choices "answer-2c97f85d-47a1-51b6-a9b9-778680ce8fdc"] ["answer-field-44831ce7-23e4-5530-a096-5c88232103b9" :answer-field/choices "answer-18bbaa38-d421-5746-a3c1-8145fc019ca0"] ["answer-field-44831ce7-23e4-5530-a096-5c88232103b9" :answer-field/choices "answer-756ee275-5880-5a22-a4a6-9e1067a5ba8a"] ["question-43345541-f657-59ff-989d-45d4cfc772b4" :question/answer-fields "answer-field-44831ce7-23e4-5530-a096-5c88232103b9"] [17592186192696 :knowledge-point/questions "question-43345541-f657-59ff-989d-45d4cfc772b4"] ["question-39ac48e2-8478-529d-91f9-60e771cc4eb9" :question/id #uuid "39ac48e2-8478-529d-91f9-60e771cc4eb9"] ["question-39ac48e2-8478-529d-91f9-60e771cc4eb9" :question/math-academy-id "q-138510"] ["question-39ac48e2-8478-529d-91f9-60e771cc4eb9" :question/problem "The covariance matrix $C$ of some particular observations is shown below. \n\n$$\nC=[\\begin{aligned}4 & 3 \\\\ 3 & 12\\end{aligned}]\n$$\n\nFind the second principal component of the data, given that the eigenvalues of $C$ are $13$ and $3.$"] ["question-39ac48e2-8478-529d-91f9-60e771cc4eb9" :question/worked-solution "Recall that the unit eigenvectors of the covariance matrix $C$ are called the principal components of the data. If \n\n$$\n{\\lambda }_{1}>{\\lambda }_{2}>⋯>{\\lambda }_{n}\n$$\n\nare the eigenvalues of $C$ written in descending order, then: \n\n- the $1$st principal component is the unit eigenvector ${u}_{1}$ corresponding to the $1$st eigenvalue ${\\lambda }_{1},$\n\n- the $2$nd principal component is the unit eigenvector ${u}_{2}$ corresponding to the $2$nd eigenvalue ${\\lambda }_{2},$\n\n- $⋯$\n\nand so on.\n\nIn our case, the eigenvalues of the covariance matrix $C,$ in descending order, are ${\\lambda }_{1}=13$ and ${\\lambda }_{2}=3.$\nSo, we need the unit eigenvector that corresponds to the eigenvalue ${\\lambda }_{2}=3:$\n\n$$\n\\begin{aligned}C-3I & =[\\begin{aligned}4 & 3 \\\\ 3 & 12\\end{aligned}]-3[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}1 & 3 \\\\ 3 & 9\\end{aligned}]\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(C-3I)x=0$ gives the eigenvector ${v}_{2}=[\\begin{aligned}-3 \\\\ 1\\end{aligned}].$ \n\nFinally, dividing ${v}_{2}$ by its norm $‖{v}_{2}‖=\\sqrt{10},$ we get \n\n$$\n{u}_{2}=\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{10}}[\\begin{aligned}-3 \\\\ 1\\end{aligned}].\n$$"] ["question-39ac48e2-8478-529d-91f9-60e771cc4eb9" :question/difficulty :question.difficulty/moderate] ["answer-field-aa5eccd0-37fc-5413-a3f2-96535a173581" :answer-field/id #uuid "aa5eccd0-37fc-5413-a3f2-96535a173581"] ["answer-b2d2312f-9076-523c-ae85-c86bf3c40aa2" :answer/id #uuid "b2d2312f-9076-523c-ae85-c86bf3c40aa2"] ["answer-b2d2312f-9076-523c-ae85-c86bf3c40aa2" :answer/type :answer.type/math] ["answer-b2d2312f-9076-523c-ae85-c86bf3c40aa2" :answer/value "\\frac{1}{\\sqrt{10}}[\\begin{aligned}-3 \\\\ 1\\end{aligned}]"] ["answer-2252d4c1-be79-5250-8ae4-9fec316b035e" :answer/id #uuid "2252d4c1-be79-5250-8ae4-9fec316b035e"] ["answer-2252d4c1-be79-5250-8ae4-9fec316b035e" :answer/type :answer.type/math] ["answer-2252d4c1-be79-5250-8ae4-9fec316b035e" :answer/value "\\frac{1}{\\sqrt{10}}[\\begin{aligned}1 \\\\ 3\\end{aligned}]"] ["answer-26c057ba-2bda-5aa2-9455-8957654b4964" :answer/id #uuid "26c057ba-2bda-5aa2-9455-8957654b4964"] ["answer-26c057ba-2bda-5aa2-9455-8957654b4964" :answer/type :answer.type/math] ["answer-26c057ba-2bda-5aa2-9455-8957654b4964" :answer/value "\\frac{1}{\\sqrt{13}}[\\begin{aligned}-3 \\\\ 