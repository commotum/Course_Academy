-bca4-86e41c8c6926" #edb/ref 17592186045417] [17592186487361 #edb/ref 1068 #edb/ref 17592186487262 #edb/ref 17592186045417] [17592186487361 #edb/ref 1069 "q-132418" #edb/ref 17592186045417] [17592186487361 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186487361 #edb/ref 1071 "Calculate ${\\int }_{-2}^{2}{\\int }_{0}^{\\sqrt{4-{y}^{2}}}3x\\,dx\\,dy.$" #edb/ref 17592186045417] [17592186487361 #edb/ref 1072 #uuid "a3c08bbb-13dd-5937-9a36-d4dc386d9f8f" #edb/ref 17592186045417] [17592186487361 #edb/ref 1074 "The integral is defined over a type II region.\n\nFirst, we evaluate the inner integral by integrating with respect to $x$, treating $y$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{-2}^{2}{\\int }_{0}^{\\sqrt{4-{y}^{2}}}3x\\,dx\\,dy & ={\\int }_{-2}^{2}[{\\int }_{0}^{\\sqrt{4-{y}^{2}}}3x\\,dx]dy \\\\  & ={\\int }_{-2}^{2}{[\\frac{3}{2}{x}^{2}]}_{0}^{\\sqrt{4-{y}^{2}}}\\,dy \\\\  & ={\\int }_{-2}^{2}\\frac{3}{2}(4-{y}^{2})\\,dy \\\\  & =\\frac{3}{2}{\\int }_{-2}^{2}(4-{y}^{2})\\,dy\\end{aligned}\n$$\n\nThen, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{3}{2}{\\int }_{-2}^{2}(4-{y}^{2})\\,dy & =\\frac{3}{2}\\cdot 2{\\int }_{0}^{2}(4-{y}^{2})\\,dy \\\\  & =3{\\int }_{0}^{2}(4-{y}^{2})\\,dy \\\\  & =3{[4y-\\frac{1}{3}{y}^{3}]}_{0}^{2} \\\\  & =3(8-\\frac{8}{3}) \\\\  & =3(\\frac{16}{3}) \\\\  & =16\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186487382 #edb/ref 1068 #edb/ref 17592186487284 #edb/ref 17592186045417] [17592186487382 #edb/ref 1069 "q-132514" #edb/ref 17592186045417] [17592186487382 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186487382 #edb/ref 1071 "Consider the finite region $D$ in the first quadrant enclosed by the $x$-axis and the curves $y={x}^{2}$ and $y=6-x.$ What is ${∬}_{D}f(x,y)\\,dA\\,$ expressed as a repeated integral?" #edb/ref 17592186045417] [17592186487382 #edb/ref 1072 #uuid "cbaf5fee-0009-5eb1-a042-591a8b53019b" #edb/ref 17592186045417] [17592186487382 #edb/ref 1074 "First, let's make a sketch of our region.\n\n![](images/8c/8c55ebba1610708143086512788e64464e8b50a517257bd63a1c28b89ee7327d.png)\n\nWe need to represent $D$ as a type II region. Writing $y={x}^{2}$ and $y=6-x$ in terms of $y,$ we obtain\n\n$$\n\\begin{aligned}y={x}^{2} & \\,⟹\\,x=\\sqrt{y} \\\\ y=6-x & \\,⟹\\,x=6-y\\end{aligned}\n$$\n\nNow, let's determine the limits of integration.\n\n- To determine the $y$-limits, we need to find the $y$-coordinates of the points at which the curves intersect. So, we set the following equation and solve it for $y:$\n\n$$\n\\begin{aligned}\\sqrt{y} & =6-y \\\\ (\\sqrt{y})^{2} & =(6-y)^{2} \\\\ y & =36-12y+{y}^{2} \\\\ {y}^{2}-13y+36 & =0 \\\\ (y-4)(y-9) & =0\\end{aligned}\n$$\n\nWe discard $y=9$ since it does not satisfy the first equality. Therefore, the $y$-limits are \n$0\\le y\\le 4.$\n\n- To determine the left and right functions, we draw a horizontal arrow from left to right through the region, as usual.\n\n![](images/c9/c9c3e3bdec1a007c47d8d1251b790b970a0d367304a5b1e5244bec014e69580d.png)\n\nAs a result, we get\n\n$$\nD=\\{(x,y)\\,:\\,0\\le y\\le 4,\\,\\sqrt{y}\\le x\\le 6-y\\}.\n$$\n\nTherefore, we can express the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}f(x,y)\\,dA & ={\\int }_{0}^{4}{\\int }_{\\sqrt{y}}^{6-y}f(x,y)\\,dx\\,dy\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186487395 #edb/ref 1068 #edb/ref 17592186487271 #edb/ref 17592186045417] [17592186487395 #edb/ref 1069 "q-89549" #edb/ref 17592186045417] [17592186487395 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186487395 #edb/ref 1071 "Calculate ${∬}_{D}\\frac{\\operatorname{sin}⁡{y}^{3}}{{y}^{2}}\\,dA,$\nwhere $D=\\{(x,y)\\,:\\,1\\le y\\le \\sqrt[3]{\\frac{\\pi }{2}},\\,0\\le x\\le {y}^{4}\\}.$" #edb/ref 17592186045417] [17592186487395 #edb/ref 1072 #uuid "e726e2b9-ad90-5a69-bca6-00fc64c93333" #edb/ref 17592186045417] [17592186487395 #edb/ref 1074 "The integral is defined over a type II region $D=\\{(x,y)\\,:\\,1\\le y\\le \\sqrt[3]{\\frac{\\pi }{2}},\\,0\\le x\\le {y}^{4}\\}.$\n\nSo, we can express the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}\\frac{\\operatorname{sin}⁡{y}^{3}}{{y}^{2}}\\,dA & ={\\int }_{1}^{\\sqrt[3]{\\pi /2}}{\\int }_{0}^{{y}^{4}}\\frac{\\operatorname{sin}⁡{y}^{3}}{{y}^{2}}\\,dx\\,dy\\end{aligned}\n$$\n\nFirst, we evaluate the inner integral by integrating with respect to $x$, treating $y$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{1}^{\\sqrt[3]{\\pi /2}}{\\int }_{0}^{{y}^{4}}\\frac{\\operatorname{sin}⁡{y}^{3}}{{y}^{2}}\\,dx\\,dy & ={\\int }_{1}^{\\sqrt[3]{\\pi /2}}\\frac{\\operatorname{sin}⁡{y}^{3}}{{y}^{2}}[{\\int }_{0}^{{y}^{4}}dx]\\,dy \\\\  & ={\\int }_{1}^{\\sqrt[3]{\\pi /2}}\\frac{\\operatorname{sin}⁡{y}^{3}}{{y}^{2}}[x]_{0}^{{y}^{4}}\\,dy \\\\  & ={\\int }_{1}^{\\sqrt[3]{\\pi /2}}\\frac{\\operatorname{sin}⁡{y}^{3}}{{y}^{2}}({y}^{4}-0)\\,dy \\\\  & ={\\int }_{1}^{\\sqrt[3]{\\pi /2}}{y}^{2}\\,\\operatorname{sin}⁡{y}^{3}\\,dy\\end{aligned}\n$$\n\nThen, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}{\\int }_{1}^{\\sqrt[3]{\\pi /2}}{y}^{2}\\operatorname{sin}⁡{y}^{3}\\,dy & ={[-\\frac{\\operatorname{cos}⁡{y}^{3}}{3}]}_{1}^{\\sqrt[3]{\\pi /2}} \\\\  & =-\\frac{1}{3}(\\operatorname{cos}⁡(\\frac{\\pi }{2})-\\operatorname{cos}⁡(1)) \\\\  & =\\frac{\\operatorname{cos}⁡(1)}{3}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186487407 #edb/ref 1058 #edb/ref 17592186487420 #edb/ref 17592186045417] [17592186487407 #edb/ref 1062 #uuid "02dcebbb-e0ab-58c9-9244-58670d1f8782" #edb/ref 17592186045417] [17592186487407 #edb/ref 1063 #edb/ref 17592186487361 #edb/ref 17592186045417] [17592186487420 #edb/ref 1058 #edb/ref 17592186487451 #edb/ref 17592186045417] [17592186487420 #edb/ref 1062 #uuid "369ae1cd-6bd8-5c9c-993d-8f69974de934" #edb/ref 17592186045417] [17592186487420 #edb/ref 1063 #edb/ref 17592186487382 #edb/ref 17592186045417] [17592186487431 #edb/ref 1058 #edb/ref 17592186487407 #edb/ref 17592186045417] [17592186487431 #edb/ref 1062 #uuid "668cc3f4-24bc-52b7-a6ae-eb045c8d90e0" #edb/ref 17592186045417] [17592186487431 #edb/ref 1063 #edb/ref 17592186487395 #edb/ref 17592186045417] [17592186487443 #edb/ref 1058 #edb/ref 17592186487431 #edb/ref 17592186045417] [17592186487443 #edb/ref 1062 #uuid "d5945b0d-9036-5506-98f2-814b1e016d1b" #edb/ref 17592186045417] [17592186487443 #edb/ref 1063 #edb/ref 17592186134298 #edb/ref 17592186045417] [17592186487451 #edb/ref 1062 #uuid "ef76088b-8705-5bf1-a9f2-8f6662b74350" #edb/ref 17592186045417] [17592186487451 #edb/ref 1063 #edb/ref 17592186268872 #edb/ref 17592186045417]}
