6c07af1afa4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.88" :db/id #edb/ref 17592186495512} {:answer/id #uuid "51759a7d-87c9-562a-8312-f8b6d8fc5142" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.86" :db/id #edb/ref 17592186495695} {:answer/id #uuid "59500d77-cde2-5c82-b94d-9272e1f58b92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.84" :db/id #edb/ref 17592186495712} {:answer/id #uuid "8b96a22a-c2c5-5cc0-ac69-7def23646d93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.87" :db/id #edb/ref 17592186495817} {:answer/id #uuid "95e8df01-f50d-5ef6-8b62-b148b070af96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.89" :db/id #edb/ref 17592186495845}] :answer-field/correct {:answer/id #uuid "51759a7d-87c9-562a-8312-f8b6d8fc5142" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.86" :db/id #edb/ref 17592186495695} :answer-field/id #uuid "c622c6db-0cfb-5314-962b-7b684cde7e09" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186496175}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7e624f6f-227d-5bbb-b9ec-897830d915af" :question/math-academy-id "q-109668" :question/problem "If ${X}_{1}∼N(1,0.4)$ and ${X}_{2}∼N(4,6)$ are independent and $Y=5{X}_{1}+{X}_{2},$ calculate $P(Y<13.4).$ Round your final answer to two decimal places.\n\n*Hint: A table of values of $Φ(z)$ for different values of $z$ is given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $z$ | $\\,0.00\\,$ | $\\,0.01\\,$ | $\\,0.02\\,$ | $\\,0.03\\,$ | $\\,0.04\\,$ |\n| --- | --- | --- | --- | --- | --- |\n| $\\,1.0\\,$ | $\\,0.8413\\,$ | $\\,0.8438\\,$ | $\\,0.8461\\,$ | $\\,0.8485\\,$ | $\\,0.8508\\,$ |\n| $\\,1.1\\,$ | $\\,0.8643\\,$ | $\\,0.8665\\,$ | $\\,0.8686\\,$ | $\\,0.8708\\,$ | $\\,0.8729\\,$ |\n| $\\,1.2\\,$ | $\\,0.8849\\,$ | $\\,0.8869\\,$ | $\\,0.8888\\,$ | $\\,0.8907\\,$ | $\\,0.8925\\,$ |" :question/worked-solution "Recall that if ${X}_{1}$ and ${X}_{2}$ are independent random variables, where ${X}_{1}∼N({\\mu }_{1},{\\sigma }_{1}^{2})$ and ${X}_{2}∼N({\\mu }_{2},{\\sigma }_{2}^{2}),$ and $a$ and $b$ are constants, then \n\n$$\na{X}_{1}+b{X}_{2}∼N(a{\\mu }_{1}+b{\\mu }_{2},{a}^{2}{\\sigma }_{1}^{2}+{b}^{2}{\\sigma }_{2}^{2}).\n$$\n\nSince ${X}_{1}$ and ${X}_{2}$ are independent, the distribution of $Y$ is given by\n\n$$\n\\begin{aligned}Y & =5{X}_{1}+{X}_{2}∼N(5{\\mu }_{1}+{\\mu }_{2},{5}^{2}{\\sigma }_{1}^{2}+{\\sigma }_{2}^{2}) \\\\  & ∼N(5\\cdot 1+4,25\\cdot 0.4+6) \\\\  & ∼N(9,16).\\end{aligned}\n$$\n\nTherefore, $Y$ is normally distributed with mean $\\mu =9$ and standard deviation $\\sigma =\\sqrt{16}=4.$ \n\nWe want to find $P(Y<13.4).$ Thus, we convert $Y$ to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(Y<13.4) & =P(Z<\\frac{13.4-9}{4}) \\\\  & =P(Z<1.1) \\\\  & =Φ(1.1)\\end{aligned}\n$$\n\nUsing the $z$-table, we see that\n\n$$\nΦ(1.1)≈0.8643.\n$$\n\nTherefore,\n\n$$\nP(Y<13.4)≈0.86.\n$$"}] [{:db/id #edb/ref 17592186496267 :knowledge-point/_questions [{:db/id #edb/ref 17592186162060 :knowledge-point/id #uuid "4358607d-b068-5dd9-8b35-46dc6bcecd1a" :knowledge-point/title "Calculating a Probability Involving a Sum or Difference of Normally Distributed Random Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07a44495-46e9-54da-b5fe-e18a8be62591" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.72" :db/id #edb/ref 17592186495531} {:answer/id #uuid "128b1dc4-16b3-5703-ac5a-3c02333f7673" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.68" :db/id #edb/ref 17592186495552} {:answer/id #uuid "257039f0-e2b5-59cd-9386-eac7326bfa18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.69" :db/id #edb/ref 17592186495593} {:answer/id #uuid "5bed3c7f-0907-556f-84d5-c5847e9dc133" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.71" :db/id #edb/ref 17592186495718} {:answer/id #uuid "6279118f-62e8-57d8-aefe-61881c9c418f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.64" :db/id #edb/ref 17592186495729}] :answer-field/correct {:answer/id #uuid "5bed3c7f-0907-556f-84d5-c5847e9dc133" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.71" :db/id #edb/ref 17592186495718} :answer-field/id #uuid "b924a128-0c43-534a-9cba-90b2ae79b1e8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186496166}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "65c490f4-ee79-5c66-84d0-39f33e6e9ec0" :question/math-academy-id "q-109669" :question/problem "If ${X}_{1}∼N(7,1)$ and ${X}_{2}∼N(6,3)$ are independent and $Y={X}_{1}-{X}_{2},$ calculate $P(Y\\le 2.1).$ Round your final answer to two decimal places.\n\n*Hint: A table of values of $Φ(z)$ for different values of $z$ is given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $z$ | $\\,0.05\\,$ | $\\,0.06\\,$ | $\\,0.07\\,$ | $\\,0.08\\,$ | $\\,0.09\\,$ |\n| --- | --- | --- | --- | --- | --- |\n| $\\,0.3\\,$ | $\\,0.6368\\,$ | $\\,0.6406\\,$ | $\\,0.6443\\,$ | $\\,0.6480\\,$ | $\\,0.6517\\,$ |\n| $\\,0.4\\,$ | $\\,0.6736\\,$ | $\\,0.6772\\,$ | $\\,0.6808\\,$ | $\\,0.6844\\,$ | $\\,0.6879\\,$ |\n| $\\,0.5\\,$ | $\\,0.7088\\,$ | $\\,0.7123\\,$ | $\\,0.7157\\,$ | $\\,0.7190\\,$ | $\\,0.7224\\,$ |" :question/worked-solution "Recall that if ${X}_{1}$ and ${X}_{2}$ are independent random variables, where ${X}_{1}∼N({\\mu }_{1},{\\sigma }_{1}^{2})$ and ${X}_{2}∼N({\\mu }_{2},{\\sigma }_{2}^{2})$, and $a$ and $b$ are constants, then \n\n$$\na{X}_{1}+b{X}_{2}∼N(a{\\mu }_{1}+b{\\mu }_{2},{a}^{2}{\\sigma }_{1}^{2}+{b}^{2}{\\sigma }_{2}^{2}).\n$$\n\nSince ${X}_{1}$ and ${X}_{2}$ are independent, the distribution of $Y$ is given by\n\n$$\n\\begin{aligned}Y={X}_{1}-{X}_{2} & ∼N({\\mu }_{1}-{\\mu }_{2},{\\sigma }_{1}^{2}+{\\sigma }_{2}^{2}) \\\\  & ∼N(7-6,1+3) \\\\  & ∼N(1,4).\\end{aligned}\n$$\n\nTherefore, $Y$ is normally distributed with mean $\\mu =1$ and standard deviation $\\sigma =\\sqrt{4}=2.$ \n\nWe want to find $P(Y\\le 2.1).$ Thus, we convert $Y$ to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(Y\\le 2.1) & =P(Z\\le \\frac{2.1-1}{2}) \\\\  & =P(Z\\le 0.55) \\\\  & =Φ(0.55)\\end{aligned}\n$$\n\nUsing the $z$-table, we see that\n\n$$\nΦ(0.55)≈0.7088.\n$$\n\nTherefore,\n\n$$\nP(Y\\le 2.1)≈0.71.\n$$"}] [{:db/id #edb/ref 17592186496332 :knowledge-point/_questions [{:db/id #edb/ref 17592186162060 :knowledge-point/id #uuid "4358607d-b068-5dd9-8b35-46dc6bcecd1a" :knowledge-point/title "Calculating a Probability Involving a Sum or Difference of Normally Distributed Random Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "063e914b-6ae9-5f1f-9506-be4bc66385c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.43" :db/id #edb/ref 17592186495526} {:answer/id #uuid "0be4d607-07b8-5a53-9ef5-3fec0375c06b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.41" :db/id #edb/ref 17592186495540} {:answer/id #uuid "3f6bb991-2e99-5c99-ab85-9ebe58e246e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.39" :db/id #edb/ref 17592186495654} {:answer/id #uuid "c8871607-886d-50a9-b06f-bece754672c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.40" :db/id #edb/ref 17592186495949} {:answer/id #uuid "ca2030c2-fd4a-5c57-9be2-034d8e3da1e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.42" :db/id #edb/ref 17592186495951}] :answer-field/correct {:answer/id #uuid "063e914b-6ae9-5f1f-9506-be4bc66385c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.43" :db/id #edb/ref 17592186495526} :answer-field/id #uuid "6397adad-43cc-59f3-a17a-dddd5e5332c4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186496126}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f962dd14-3b46-5fda-bac4-2a4b37326612" :question/math-academy-id "q-109671" :question/problem "If ${X}_{1}∼N(8,{40}^{2})$ and ${X}_{2}∼N(30,{30}^{2})$ are independent and $Y={X}_{1}-{X}_{2},$ calculate $P(-31\\le Y\\le 31).$ Round your final answer to two decimal places.\n\n*Hint: A table of values of $Φ(z)$ for different values of $z$ is given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n<table align=\"center\">\n<tbody><tr>\n<th>\n<table align=\"center\" cellpadding=\"5\" rules=\"all\">\n<tbody><tr> <th align=\"center\" bgcolor=\"#D6EAF8\" width=\"25%\">$z$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.07\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.08\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.09\\,$</th>\n</tr><tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-0.3\\,$</th><td align=\"center\"> $\\,0.3557\\,$ </td><td align=\"center\"> $\\,0.3520\\,$ </td><td align=\"center\"> $\\,0.3483\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-0.2\\,$</th><td align=\"center\"> $\\,0.3936\\,$ </td><td align=\"center\"> $\\,0.3897\\,$ </td><td align=\"center\"> $\\,0.3859\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-0.1\\,$</th><td align=\"center\"> $\\,0.4325\\,$ </td><td align=\"center\"> $\\,0.4286\\,$ </td><td align=\"center\"> $\\,0.4247\\,$ </td></tr>\n</tbody></table>\n</th>\n<th width=\"5%\"></th>\n<th>\n<table align=\"center\" cellpadding=\"5\" rules=\"all\">\n<tbody><tr> <th align=\"center\" bgcolor=\"#D6EAF8\" width=\"25%\">$z$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.05\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.06\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.07\\,$</th>\n</tr><tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.9\\,$</th><td align=\"center\"> $\\,0.8289\\,$ </td><td align=\"center\"> $\\,0.8315\\,$ </td><td align=\"center\"> $\\,0.8340\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,1.0\\,$</th><td align=\"center\"> $\\,0.8531\\,$ </td><td align=\"center\"> $\\,0.8554\\,$ </td><td align=\"center\"> $\\,0.8577\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,1.1\\,$</th><td align=\"center\"> $\\,0.8749\\,$ </td><td align=\"center\"> $\\,0.8770\\,$ </td><td align=\"center\"> $\\,0.8790\\,$ </td></tr>\n</tbody></table>\n</th>\n</tr>\n</tbody></table>" :question/worked-solution "Recall that if ${X}_{1}$ and ${X}_{2}$ are independent random variables, where ${X}_{1}∼N({\\mu }_{1},{\\sigma }_{1}^{2})$ and ${X}_{2}∼N({\\mu }_{2},{\\sigma }_{2}^{2})$, and $a$ and $b$ are constants, then \n\n$$\na{X}_{1}+b{X}_{2}∼N(a{\\mu }_{1}+b{\\mu }_{2},{a}^{2}{\\sigma }_{1}^{2}+{b}^{2}{\\sigma }_{2}^{2}).\n$$\n\nSince ${X}_{1}$ and ${X}_{2}$ are independent, the distribution of $Y$ is given by\n\n$$\n\\begin{aligned}Y={X}_{1}-{X}_{2} & ∼N({\\mu }_{1}-{\\mu }_{2},{\\sigma }_{1}^{2}+{\\sigma }_{2}^{2}) \\\\  & ∼N(8-30,{40}^{2}+{30}^{2}) \\\\  & ∼N(-22,2500).\\end{aligned}\n$$\n\nTherefore, $Y$ is normally distributed with mean $\\mu =-22$ and standard deviation $\\sigma =\\sqrt{2500}=50.$ \n\nWe want to find $P(-31\\le Y\\le 31).$ Thus, we convert $Y$ to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(-31\\le Y\\le 31) & =P(\\frac{-31-(-22)}{50}\\le Z\\le \\frac{31-(-22)}{50}) \\\\  & =P(-0.18\\le Z\\le 1.06) \\\\  & =P(Z<1.06)-P(Z<-0.18) \\\\  & =Φ(1.06)-Φ(-0.18)\\end{aligned}\n$$\n\nUsing the $z$-table, we see that\n\n$$\n\\begin{aligned}Φ(-0.18) & ≈0.4286 \\\\ Φ(1.06) & ≈0.8554\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(-31\\le Y\\le 31) & =Φ(1.06)-Φ(-0.18) \\\\  & ≈0.8554-0.4286 \\\\  & ≈0.43.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186162290 :knowledge-point/_questions [{:db/id #edb/ref 17592186162060 :knowledge-point/id #uuid "4358607d-b068-5dd9-8b35-46dc6bcecd1a" :knowledge-point/title "Calculating a Probability Involving a Sum or Difference of Normally Distributed Random Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e1136a7b-dec6-5062-8570-f809a052d0b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.3797" :db/id #edb/ref 17592186158943} {:answer/id #uuid "3262d39f-f461-549c-b130-07fd17c359e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.3164" :db/id #edb/ref 17592186158944} {:answer/id #uuid "499c7440-4a36-5cd4-85d7-177fb6a08100" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.2847" :db/id #edb/ref 17592186158945} {:answer/id #uuid "51ba7af4-966d-5c45-a33b-4fe23fda5fbe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.3429" :db/id #edb/ref 17592186158946} {:answer/id #uuid "74bdb0c2-45be-5aa5-beae-289c2acb32ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.4297" :db/id #edb/ref 17592186158947}] :answer-field/correct {:answer/id #uuid "e1136a7b-dec6-5062-8570-f809a052d0b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.3797" :db/id #edb/ref 17592186158943} :answer-field/id #uuid "690e9ce3-dc63-5200-bc5b-f21aade4d3e9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186158942}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4b22c96c-0e71-5945-9f2d-5a0f0b3829f5" :question/math-academy-id "q-109672" :question/problem "If ${X}_{1}∼N(2,7)$ and ${X}_{2}∼N(1,4)$ are independent and $Y=2{X}_{1}-3{X}_{2},$ calculate $P(-4.6<Y<3.48).$ Round your final answer to two decimal places.\n\n*Hint: A table of values of $Φ(z)$ for different values of $z$ is given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n<table align=\"center\">\n<tbody><tr>\n<th>\n<table align=\"center\" cellpadding=\"5\" rules=\"all\">\n<tbody><tr> <th align=\"center\" bgcolor=\"#D6EAF8\" width=\"25%\">$z$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.00\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.01\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.02\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.03\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.04\\,$</th>\n</tr><tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.2\\,$</th><td align=\"center\"> $\\,0.5793\\,$ </td><td align=\"center\"> $\\,0.5832\\,$ </td><td align=\"center\"> $\\,0.5871\\,$ </td><td align=\"center\"> $\\,0.5910\\,$ </td><td align=\"center\"> $\\,0.5948\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.3\\,$</th><td align=\"center\"> $\\,0.6179\\,$ </td><td align=\"center\"> $\\,0.6217\\,$ </td><td align=\"center\"> $\\,0.6255\\,$ </td><td align=\"center\"> $\\,0.6293\\,$ </td><td align=\"center\"> $\\,0.6331\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.4\\,$</th><td align=\"center\"> $\\,0.6554\\,$ </td><td align=\"center\"> $\\,0.6591\\,$ </td><td align=\"center\"> $\\,0.6628\\,$ </td><td align=\"center\"> $\\,0.6664\\,$ </td><td align=\"center\"> $\\,0.6700\\,$ </td></tr>\n</tbody></table>\n</th>\n<th width=\"5%\"></th>\n<th>\n<table align=\"center\" cellpadding=\"5\" rules=\"all\">\n<tbody><tr> <th align=\"center\" bgcolor=\"#D6EAF8\" width=\"25%\">$z$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.00\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.01\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.02\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.03\\,$</th>\n</tr><tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-0.7\\,$</th><td align=\"center\"> $\\,0.2420\\,$ </td><td align=\"center\"> $\\,0.2389\\,$ </td><td align=\"center\"> $\\,0.2358\\,$ </td><td align=\"center\"> $\\,0.2327\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-0.6\\,$</th><td align=\"center\"> $\\,0.2743\\,$ </td><td align=\"center\"> $\\,0.2709\\,$ </td><td align=\"center\"> $\\,0.2676\\,$ </td><td align=\"center\"> $\\,0.2643\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-0.5\\,$</th><td align=\"center\"> $\\,0.3085\\,$ </td><td align=\"center\"> $\\,0.3050\\,$ </td><td align=\"center\"> $\\,0.3015\\,$ </td><td align=\"center\"> $\\,0.2981\\,$ </td></tr>\n</tbody></table>\n</th>\n</tr>\n</tbody></table>" :question/requires-calculator true :question/worked-solution "Recall that if ${X}_{1}$ and ${X}_{2}$ are independent random variables, where ${X}_{1}∼N({\\mu }_{1},{\\sigma }_{1}^{2})$ and ${X}_{2}∼N({\\mu }_{2},{\\sigma }_{2}^{2}),$ and $a$ and $b$ are constants, then \n\n$$\na{X}_{1}+b{X}_{2}∼N(a{\\mu }_{1}+b{\\mu }_{2},{a}^{2}{\\sigma }_{1}^{2}+{b}^{2}{\\sigma }_{2}^{2}).\n$$\n\nSince ${X}_{1}$ and ${X}_{2}$ are independent, the distribution of $Y$ is given by\n\n$$\n\\begin{aligned}Y=2{X}_{1}-3{X}_{2} & ∼N(2{\\mu }_{1}-3{\\mu }_{2},4{\\sigma }_{1}^{2}+9{\\sigma }_{2}^{2}) \\\\  & ∼N(4-3,28+36) \\\\  & ∼N(1,64).\\end{aligned}\n$$\n\nTherefore, $Y$ is normally distributed with mean $\\mu =1$ and standard deviation $\\sigma =\\sqrt{64}=8.$ \n\nWe want to find $P(-4.6<Y<3.48).$ Thus, we convert $Y$ to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(-4.6<Y<3.48) & =P(\\frac{-4.6-1}{8}<Z<\\frac{3.48-1}{8}) \\\\  & =P(-0.70<Z<0.31) \\\\  & =P(Z<0.31)-P(Z<-0.70) \\\\  & =Φ(0.31)-Φ(-0.70)\\end{aligned}\n$$\n\nUsing the $z$-table, we see that\n\n$$\n\\begin{aligned}Φ(0.31) & ≈0.6217 \\\\ Φ(-0.70) & ≈0.2420.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(-4.6<Y<3.48) & ≈Φ(0.31)-Φ(-0.70) \\\\  & ≈0.6217-0.2420 \\\\  & ≈0.3797.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186496316 :knowledge-point/_questions [{:db/id #edb/ref 17592186162060 :knowledge-point/id #uuid "4358607d-b068-5dd9-8b35-46dc6bcecd1a" :knowledge-point/title "Calculating a Probability Involving a Sum or Difference of Normally Distributed Random Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a1cc987-1278-5a2a-b798-8266863a9c41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.59" :db/id #edb/ref 17592186495713} {:answer/id #uuid "82f2592b-71b1-5b3d-9652-be585fa3017f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.51" :db/id #edb/ref 17592186495790} {:answer/id #uuid "85d59656-3537-5457-8d1c-dc85f60a99e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.57" :db/id #edb/ref 17592186495800} {:answer/id #uuid "94e4ccc1-de28-5a71-ba16-9e0997ac651b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.55" :db/id #edb/ref 17592186495840} {:answer/id #uuid "c145152d-0394-5455-96ae-64a0c2183c91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.53" :db/id #edb/ref 17592186495935}] :answer-field/correct {:answer/id #uuid "c145152d-0394-5455-96ae-64a0c2183c91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.53" :db/id #edb/ref 17592186495935} :answer-field/id #uuid "d625ba35-2bd7-5f82-badd-daf45f13bceb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186496189}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e193207c-9362-5624-9544-44b526952e2a" :question/math-academy-id "q-109726" :question/problem "If ${X}_{1}∼N(-14,{20}^{2})$ and ${X}_{2}∼N(-6,{15}^{2})$ are independent and $Y={X}_{1}+{X}_{2},$ calculate $P(-28<Y\\le 12).$ Round your final answer to two decimal places.\n\n*Hint: A table of values of $Φ(z)$ for different values of $z$ is given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n<table align=\"center\">\n<tbody><tr>\n<th>\n<table align=\"center\" cellpadding=\"5\" rules=\"all\">\n<tbody><tr> <th align=\"center\" bgcolor=\"#D6EAF8\" width=\"25%\">$z$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.00\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.01\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.02\\,$</th>\n</tr><tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-0.3\\,$</th><td align=\"center\"> $\\,0.3821\\,$ </td><td align=\"center\"> $\\,0.3783\\,$ </td><td align=\"center\"> $\\,0.3745\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-0.2\\,$</th><td align=\"center\"> $\\,0.4207\\,$ </td><td align=\"center\"> $\\,0.4168\\,$ </td><td align=\"center\"> $\\,0.4129\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-0.1\\,$</th><td align=\"center\"> $\\,0.4602\\,$ </td><td align=\"center\"> $\\,0.4562\\,$ </td><td align=\"center\"> $\\,0.4522\\,$ </td></tr>\n</tbody></table>\n</th>\n<th width=\"5%\"></th>\n<th>\n<table align=\"center\" cellpadding=\"5\" rules=\"all\">\n<tbody><tr> <th align=\"center\" bgcolor=\"#D6EAF8\" width=\"25%\">$z$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.06\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.07\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.08\\,$</th>\n</tr><tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,1.2\\,$</th><td align=\"center\"> $\\,0.8962\\,$ </td><td align=\"center\"> $\\,0.8980\\,$ </td><td align=\"center\"> $\\,0.8997\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,1.3\\,$</th><td align=\"center\"> $\\,0.9131\\,$ </td><td align=\"center\"> $\\,0.9147\\,$ </td><td align=\"center\"> $\\,0.9162\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,1.4\\,$</th><td align=\"center\"> $\\,0.9279\\,$ </td><td align=\"center\"> $\\,0.9292\\,$ </td><td align=\"center\"> $\\,0.9306\\,$ </td></tr>\n</tbody></table>\n</th>\n</tr>\n</tbody></table>" :question/worked-solution "Recall that if ${X}_{1}$ and ${X}_{2}$ are independent random variables, where ${X}_{1}∼N({\\mu }_{1},{\\sigma }_{1}^{2})$ and ${X}_{2}∼N({\\mu }_{2},{\\sigma }_{2}^{2}),$ and $a$ and $b$ are constants, then \n\n$$\na{X}_{1}+b{X}_{2}∼N(a{\\mu }_{1}+b{\\mu }_{2},{a}^{2}{\\sigma }_{1}^{2}+{b}^{2}{\\sigma }_{2}^{2}).\n$$\n\nSince ${X}_{1}$ and ${X}_{2}$ are independent, the distribution of $Y$ is given by\n\n$$\n\\begin{aligned}Y={X}_{1}+{X}_{2} & ∼N({\\mu }_{1}+{\\mu }_{2},{\\sigma }_{1}^{2}+{\\sigma }_{2}^{2}) \\\\  & ∼N(-14-6,400+225) \\\\  & ∼N(-20,625).\\end{aligned}\n$$\n\nTherefore, $Y$ is normally distributed with mean $\\mu =-20$ and standard deviation $\\sigma =\\sqrt{625}=25.$ \n\nWe want to find $P(-28<Y\\le 12).$ Thus, we convert $Y$ to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(-28<Y\\le 12) & =P(\\frac{-28+20}{25}<Z\\le \\frac{12+20}{25}) \\\\  & =P(-0.32\\le Z\\le 1.28) \\\\  & =P(Z<1.28)-P(Z<-0.32) \\\\  & =Φ(1.28)-Φ(-0.32)\\end{aligned}\n$$\n\nUsing the $z$-table, we see that\n\n$$\n\\begin{aligned}Φ(-0.32) & ≈0.3745 \\\\ Φ(1.28) & ≈0.8997.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(-28<Y\\le 12) & =Φ(1.28)-Φ(-0.32) \\\\  & ≈0.8997-0.3745 \\\\  & ≈0.53.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186496268 :knowledge-point/_questions [{:db/id #edb/ref 17592186162061 :knowledge-point/id #uuid "22f7e940-b159-5d68-8ce4-d33f4a2f6907" :knowledge-point/title "Calculating a Probability Involving a Sum or Difference of Normally Distributed Random Variables in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09de9872-6ab1-5e3a-a36a-ad0d1711044d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.3707" :db/id #edb/ref 17592186495534} {:answer/id #uuid "3a56d3b4-a632-5cfa-b0ad-7cecce636e2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.4129" :db/id #edb/ref 17592186495646} {:answer/id #uuid "785ba3d5-a85c-5689-b7d9-75e025455242" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.4207" :db/id #edb/ref 17592186495770} {:answer/id #uuid "a2e85dc2-1f34-5360-b990-3d51b751b711" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.4522" :db/id #edb/ref 17592186495875} {:answer/id #uuid "d0a109a1-7fb3-53b4-9819-0e61d9c1e053" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.3783" :db/id #edb/ref 17592186495965}] :answer-field/correct {:answer/id #uuid "09de9872-6ab1-5e3a-a36a-ad0d1711044d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.3707" :db/id #edb/ref 17592186495534} :answer-field/id #uuid "23eb8fea-b998-548f-a61c-cbabe9a91a03" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186496089}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6718d3e2-fbcd-51c5-808c-744242ca4d81" :question/math-academy-id "q-109754" :question/problem "A Japanese-style table tennis racket is made from a wooden blade covered with rubber on one side.  The weight of a blade is normally distributed with a mean of $80\\,\\text{g}$ and a variance of $31\\,{\\text{g}}^{2}.$ The weight of the rubber is normally distributed with a mean of $45\\,\\text{g}$ grams and a variance of $50\\,{\\text{g}}^{2}.$ If one racket is randomly selected, what is the probability that it weighs more than $128\\,\\text{g}?$ You may assume that the weights are independent.\n\n*Hint: A table of values of $Φ(z)$ for different values of $z$ is given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $z$ | $\\,0.00\\,$ | $\\,0.01\\,$ | $\\,0.02\\,$ | $\\,0.03\\,$ | $\\,0.04\\,$ |\n| --- | --- | --- | --- | --- | --- |\n| $\\,0.1\\,$ | $\\,0.5398\\,$ | $\\,0.5438\\,$ | $\\,0.5478\\,$ | $\\,0.5517\\,$ | $\\,0.5557\\,$ |\n| $\\,0.2\\,$ | $\\,0.5793\\,$ | $\\,0.5832\\,$ | $\\,0.5871\\,$ | $\\,0.5910\\,$ | $\\,0.5948\\,$ |\n| $\\,0.3\\,$ | $\\,0.6179\\,$ | $\\,0.6217\\,$ | $\\,0.6255\\,$ | $\\,0.6293\\,$ | $\\,0.6331\\,$ |" :question/worked-solution "Let $X$ denote the weight of the blade, and let $Y$ denote the weight of the rubber. We want to find \n\n$$\nP(X+Y>128).\n$$\n\nSince $X$ and $Y$ are  independent random variables such that $X∼N(80,31)$ and $Y∼N(45,50),$ then \n\n$$\n\\begin{aligned}X+Y & ∼N(80+45,31+50) \\\\  & ∼N(125,81).\\end{aligned}\n$$\n\nSo, the variable $X+Y$ is normally distributed with mean $\\mu =125$ and standard deviation $\\sigma =\\sqrt{81}=9.$\n\nIn order to find $P(X+Y>128),$ we convert $X+Y$ to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(X+Y>128) & =P(Z>\\frac{128-125}{9}) \\\\  & ≈P(Z>0.33) \\\\  & =1-P(Z\\le 0.33) \\\\  & =Φ(0.33)\\end{aligned}\n$$\n\nUsing the $z$-table, we see that\n\n$$\nΦ(0.33)≈0.6293.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X+Y>128) & ≈1-Φ(0.33) \\\\  & ≈1-0.6293 \\\\  & ≈0.3707.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186496325 :knowledge-point/_questions [{:db/id #edb/ref 17592186162061 :knowledge-point/id #uuid "22f7e940-b159-5d68-8ce4-d33f4a2f6907" :knowledge-point/title "Calculating a Probability Involving a Sum or Difference of Normally Distributed Random Variables in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b27ab74-19c6-52de-9b88-0b5d2b3023d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1949" :db/id #edb/ref 17592186495538} {:answer/id #uuid "3beb759e-3832-5b91-8bb0-5fe04a4c0eb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.2177" :db/id #edb/ref 17592186495648} {:answer/id #uuid "72ce0fe1-3792-56d6-8c38-71a07f2ff7ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1660" :db/id #edb/ref 17592186495762} {:answer/id #uuid "a683289d-1445-55db-90cf-1e6eff679e06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.2266" :db/id #edb/ref 17592186495884} {:answer/id #uuid "cee6069b-3ea8-5bd5-9b1b-39d0ed56f8fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1867" :db/id #edb/ref 17592186495961}] :answer-field/correct {:answer/id #uuid "3beb759e-3832-5b91-8bb0-5fe04a4c0eb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.2177" :db/id #edb/ref 17592186495648} :answer-field/id #uuid "76f631c0-460f-51ec-9363-bfa37aabf5c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186496137}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e7f40d31-3891-595e-9dc0-80e5713161b9" :question/math-academy-id "q-109757" :question/problem "A particular shop sells chickens and turkeys. The weight of a chicken is normally distributed with a mean of $1.5\\,\\text{kg}$ and a standard deviation of $0.1\\,\\text{kg}.$ The weight of a turkey is normally distributed with a mean of $8\\,\\text{kg}$ and a standard deviation of $0.4\\,\\text{kg}.$ If a chicken and a turkey are randomly selected, what is the probability that $5$ times the weight of the chicken is greater than the turkey's weight? You may assume that the weights are independent. \n\n*Hint: A table of values of $Φ(z)$ for different values of $z$ is given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $z$ | $\\,0.05\\,$ | $\\,0.06\\,$ | $\\,0.07\\,$ | $\\,0.08\\,$ | $\\,0.09\\,$ |\n| --- | --- | --- | --- | --- | --- |\n| $\\,0.7\\,$ | $\\,0.7734\\,$ | $\\,0.7764\\,$ | $\\,0.7794\\,$ | $\\,0.7823\\,$ | $\\,0.7852\\,$ |\n| $\\,0.8\\,$ | $\\,0.8023\\,$ | $\\,0.8051\\,$ | $\\,0.8078\\,$ | $\\,0.8106\\,$ | $\\,0.8133\\,$ |\n| $\\,0.9\\,$ | $\\,0.8289\\,$ | $\\,0.8315\\,$ | $\\,0.8340\\,$ | $\\,0.8365\\,$ | $\\,0.8389\\,$ |" :question/worked-solution "Let $X$ denote the weight of a chicken, and let $Y$ denote the weight of a turkey. We want to find \n\n$$\nP(5X>Y)=P(5X-Y>0).\n$$\n\nSince $X$ and $Y$ are independent random variables such that $X∼N(1.5,{0.1}^{2})$ and $Y∼N(8,{0.4}^{2}),$ then \n\n$$\n\\begin{aligned}5X-Y & ∼N(5\\cdot 1.5-8,{5}^{2}\\cdot {0.1}^{2}+{0.4}^{2}) \\\\  & ∼N(-0.5,0.41).\\end{aligned}\n$$\n\nSo, the variable $5X-Y$ is normally distributed with mean $\\mu =-0.5$ and standard deviation $\\sigma =\\sqrt{0.41}.$\n\nTo find $P(5X-Y>0),$ we convert $5X-Y$ to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(5X-Y>0) & =P(Z>\\frac{0-(-0.5)}{\\sqrt{0.41}}) \\\\  & ≈P(Z>0.78) \\\\  & =1-P(Z\\le 0.78) \\\\  & =1-Φ(0.78)\\end{aligned}\n$$\n\nUsing the $z$-table, we see that\n\n$$\nΦ(0.78)≈0.7823.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(5X-Y>0) & ≈1-Φ(0.78) \\\\  & ≈1-0.7823 \\\\  & 0.2177.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186496228 :knowledge-point/_questions [{:db/id #edb/ref 17592186162061 :knowledge-point/id #uuid "22f7e940-b159-5d68-8ce4-d33f4a2f6907" :knowledge-point/title "Calculating a Probability Involving a Sum or Difference of Normally Distributed Random Variables in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24120408-2087-55b0-b11d-72781143b0e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1093" :db/id #edb/ref 17592186495590} {:answer/id #uuid "85c254a0-62c2-59a8-886c-22c3f672d045" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1112" :db/id #edb/ref 17592186495799} {:answer/id #uuid "9eff9744-fffc-5560-b024-8d235dec8231" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1335" :db/id #edb/ref 17592186495866} {:answer/id #uuid "a4b71db8-fce7-543b-b560-c183dd798dc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1357" :db/id #edb/ref 17592186495879} {:answer/id #uuid "bee4b9cc-203d-5c1c-bc20-21d933ffd030" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1587" :db/id #edb/ref 17592186495930}] :answer-field/correct {:answer/id #uuid "bee4b9cc-203d-5c1c-bc20-21d933ffd030" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1587" :db/id #edb/ref 17592186495930} :answer-field/id #uuid "b619dfd9-b2dd-59c0-870d-da366a920039" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186496165}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0c9343e5-40f1-5766-8346-83637c7ee445" :question/math-academy-id "q-109759" :question/problem "In a technical support call center, waiting times are normally distributed with a mean of $15$ minutes and a standard deviation of $3$ minutes. The conversation times are normally distributed with a mean of $10$ minutes and a standard deviation of $4$ minutes. The time to solve a problem is the sum of the waiting time and the conversation time. What is the probability that it took more than $30$ minutes to solve the problem of a randomly selected caller? You may assume that waiting and conversation times are independent.\n\n*Hint: A table of values of $Φ(z)$ for different values of $z$ is given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $z$ | $\\,0.00\\,$ | $\\,0.01\\,$ | $\\,0.02\\,$ | $\\,0.03\\,$ | $\\,0.04\\,$ |\n| --- | --- | --- | --- | --- | --- |\n| $\\,1.0\\,$ | $\\,0.8413\\,$ | $\\,0.8438\\,$ | $\\,0.8461\\,$ | $\\,0.8485\\,$ | $\\,0.8508\\,$ |\n| $\\,1.1\\,$ | $\\,0.8643\\,$ | $\\,0.8665\\,$ | $\\,0.8686\\,$ | $\\,0.8708\\,$ | $\\,0.8729\\,$ |\n| $\\,1.2\\,$ | $\\,0.8849\\,$ | $\\,0.8869\\,$ | $\\,0.8888\\,$ | $\\,0.8907\\,$ | $\\,0.8925\\,$ |" :question/worked-solution "Let $X$ denote the waiting time, and let $Y$ denote the conversation time. We want to find \n\n$$\nP(X+Y>30).\n$$\n\nSince $X$ and $Y$ are independent random variables such that $X∼N(15,{3}^{2})$ and $Y∼N(10,{4}^{2})$, then \n\n$$\n\\begin{aligned}X+Y & ∼N(15+10,{3}^{2}+{4}^{2}) \\\\  & ∼N(25,25).\\end{aligned}\n$$\n\nSo, the variable $X+Y$ is normally distributed with mean $\\mu =25$ and standard deviation $\\sigma =\\sqrt{25}=5.$\n\nIn order to find $P(X+Y>30),$ we convert $X+Y$ to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(X+Y>30) & =P(Z>\\frac{30-25}{5}) \\\\  & ≈P(Z>1) \\\\  & =1-P(Z\\le 1) \\\\  & =1-Φ(1)\\end{aligned}\n$$\n\nUsing the $z$-table, we see that\n\n$$\nΦ(1)≈0.8413.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X+Y>30) & =1-Φ(1) \\\\  & ≈1-0.8413 \\\\  & ≈0.1587.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186162297 :knowledge-point/_questions [{:db/id #edb/ref 17592186162061 :knowledge-point/id #uuid "22f7e940-b159-5d68-8ce4-d33f4a2f6907" :knowledge-point/title "Calculating a Probability Involving a Sum or Difference of Normally Distributed Random Variables in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9b869df3-79ba-56aa-8ced-f8b4ad215428" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9826" :db/id #edb/ref 17592186158985} {:answer/id #uuid "b8003671-7ca0-5043-9de3-be6566db4166" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9783" :db/id #edb/ref 17592186158986} {:answer/id #uuid "bd0e5659-7545-58cd-9efa-736e9883e318" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9713" :db/id #edb/ref 17592186158987} {:answer/id #uuid "08ac1861-7dd0-5294-a3e1-01ada62d50d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9732" :db/id #edb/ref 17592186158988} {:answer/id #uuid "686c79f7-f1c1-5bde-b527-10584fabc17c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9838" :db/id #edb/ref 17592186158989}] :answer-field/correct {:answer/id #uuid "b8003671-7ca0-5043-9de3-be6566db4166" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9783" :db/id #edb/ref 17592186158986} :answer-field/id #uuid "6523aa17-ab8d-5913-92fd-b0f4e669d487" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186158984}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6e40bec4-6131-5212-9aba-bedf95289725" :question/math-academy-id "q-110340" :question/problem "A shop sells spray foam in small and large cans. The volume of liquid in a small can is normally distributed with a mean of $0.3\\,\\text{ltrs}$ and a standard deviation of $0.003\\,\\text{ltrs}.$ The volume of liquid in a large can is normally distributed with a mean of $0.6\\,\\text{ltrs}$ and a standard deviation of $0.008\\,\\text{ltrs}.$\n\nThe foam from a small can expands $40$ times its liquid volume after being sprayed in place, while the foam from a large can expands to $60$ times its liquid volume. \nIf one small and one large can are randomly selected, what is the probability that the total foam volume from both cans after expanding is less than $49\\,\\text{ltrs}?$\n\n*Hint: A table of values of $Φ(z)$ for different values of $z$ is given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $z$ | $\\,0.00\\,$ | $\\,0.01\\,$ | $\\,0.02\\,$ | $\\,0.03\\,$ | $\\,0.04\\,$ |\n| --- | --- | --- | --- | --- | --- |\n| $\\,1.9\\,$ | $\\,0.9713\\,$ | $\\,0.9719\\,$ | $\\,0.9726\\,$ | $\\,0.9732\\,$ | $\\,0.9738\\,$ |\n| $\\,2.0\\,$ | $\\,0.9772\\,$ | $\\,0.9778\\,$ | $\\,0.9783\\,$ | $\\,0.9788\\,$ | $\\,0.9793\\,$ |\n| $\\,2.1\\,$ | $\\,0.9821\\,$ | $\\,0.9826\\,$ | $\\,0.9830\\,$ | $\\,0.9834\\,$ | $\\,0.9838\\,$ |" :question/requires-calculator true :question/worked-solution "Let $X$ denote the volume of liquid in a small can, and let $Y$ denote the volume of liquid in a big can. We want to find \n\n$$\nP(40X+60Y<49).\n$$\n\nSince $X$ and $Y$ are  independent random variables such that $X∼N(0.3,{0.003}^{2})$ and $Y∼N(0.6,{0.008}^{2})$, then \n\n$$\n\\begin{aligned}40X+60Y & ∼N(40\\cdot 0.3+60\\cdot 0.6,{40}^{2}\\cdot {0.003}^{2}+{60}^{2}\\cdot {0.008}^{2}) \\\\  & ∼N(48,0.2448).\\end{aligned}\n$$\n\nSo, the variable $40X+60Y$ is normally distributed with mean $\\mu =48$ and standard deviation $\\sigma =\\sqrt{0.2448}.$\n\nIn order to find $P(40X+60Y<49),$ we convert $40X+60Y$ to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(40X+60Y<49) & =P(Z<\\frac{49-48}{\\sqrt{0.2448}}) \\\\  & ≈P(Z<2.02) \\\\  & =P(Z\\le 2.02) \\\\  & =Φ(2.02)\\end{aligned}\n$$\n\nUsing the $z$-table, we see that\n\n$$\nΦ(2.02)≈0.9783.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(40X+60Y<49) & ≈Φ(2.02) \\\\  & ≈0.9783.\\end{aligned}\n$$\n\nSo, we conclude that the probability that, after expanding, the total volume of foam is less than $49$ liters is $0.9783.$"}] [{:db/id #edb/ref 17592186496254 :knowledge-point/_questions [{:db/id #edb/ref 17592186162059 :knowledge-point/id #uuid "06dabd63-8400-57cb-8978-54f0b4640759" :knowledge-point/title "Finding the Distribution of a Sum or Difference of Scaled Normal Random Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02239e57-129a-53f7-a172-4265393a8913" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "N(3,11)" :db/id #edb/ref 17592186495514} {:answer/id #uuid "1926bf6d-f7ef-5efc-b07f-044d43908ce1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "N(1,7)" :db/id #edb/ref 17592186495558} {:answer/id #uuid "368a3b76-8d4e-5bb0-be28-5e4dcac46395" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "N(1,25)" :db/id #edb/ref 17592186495636} {:answer/id #uuid "7121f759-932c-5b1f-a580-1b9657013932" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Not enough information to determine the answer" :db/id #edb/ref 17592186495758} {:answer/id #uuid "7e5b7ffa-2959-5afb-a10e-286091753cea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "N(1,11)" :db/id #edb/ref 17592186495780}] :answer-field/correct {:answer/id #uuid "7121f759-932c-5b1f-a580-1b9657013932" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Not enough information to determine the answer" :db/id #edb/ref 17592186495758} :answer-field/id #uuid "55357451-ffd7-5250-b963-66261a1d2eab" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186496115}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4ad84c9b-528f-52d5-bcd2-180abda6b74b" :question/math-academy-id "q-175411" :question/problem "If ${X}_{1}∼N(1,3)$ and ${X}_{2}∼N(1,2),$ then what is the distribution of $Y=-{X}_{1}+2{X}_{2}?$" :question/worked-solution "Recall that if ${X}_{1}$ and ${X}_{2}$ are independent random variables, where ${X}_{1}∼N({\\mu }_{1},{\\sigma }_{1}^{2})$ and ${X}_{2}∼N({\\mu }_{2},{\\sigma }_{2}^{2}),$ and $a$ and $b$ are constants, then\n\n$$\na{X}_{1}+b{X}_{2}∼N(a{\\mu }_{1}+b{\\mu }_{2},{a}^{2}{\\sigma }_{1}^{2}+{b}^{2}{\\sigma }_{2}^{2}).\n$$\n\nHowever, in this case, we don't know whether ${X}_{1}$ and ${X}_{2}$ are independent. Therefore, we do not have enough information to determine the answer."}] [{:db/id #edb/ref 17592186496301 :knowledge-point/_questions [{:db/id #edb/ref 17592186162061 :knowledge-point/id #uuid "22f7e940-b159-5d68-8ce4-d33f4a2f6907" :knowledge-point/title "Calculating a Probability Involving a Sum or Difference of Normally Distributed Random Variables in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1709490b-7f5e-5a60-9c40-0d9cf3cceda8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.2776" :db/id #edb/ref 17592186495556} {:answer/id #uuid "6b31c841-227b-52d0-915b-6cf71392b90f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.2843" :db/id #edb/ref 17592186495745} {:answer/id #uuid "f0de7d0f-e915-5b9a-9bba-67dc042d08bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.2514" :db/id #edb/ref 17592186496037} {:answer/id #uuid "fbdd52b6-d064-5b8a-87cc-1efdc1299079" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.2451" :db/id #edb/ref 17592186496066} {:answer/id #uuid "ff64d49e-8bb7-595f-8e20-451c46ffaab2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.2206" :db/id #edb/ref 17592186496071}] :answer-field/correct {:answer/id #uuid "fbdd52b6-d064-5b8a-87cc-1efdc1299079" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.2451" :db/id #edb/ref 17592186496066} :answer-field/id #uuid "dd9b0e70-58cf-5f85-82e2-913249f58302" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186496197}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "bb6e266d-fd9f-5c8c-82b7-fde74e3fe145" :question/math-academy-id "q-175476" :question/problem "A particular shop sells watermelons and melons. The weight of a watermelon is normally distributed with a mean of $10\\,\\text{kg}$ and a standard deviation of $4\\,\\text{kg}.$ The weight of a melon is normally distributed with a mean of $5\\,\\text{kg}$ and a standard deviation of $2\\,\\text{kg}.$ If one watermelon and one melon are randomly selected, what is the probability that the weight of the watermelon is more than $3$ times greater than the weight of the melon? You may assume that the weights are independent.\n\n*Hint: A table of values of $Φ(z)$ for different values of $z$ is given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $z$ | $\\,0.05\\,$ | $\\,0.06\\,$ | $\\,0.07\\,$ | $\\,0.08\\,$ | $\\,0.09\\,$ |\n| --- | --- | --- | --- | --- | --- |\n| $\\,0.5\\,$ | $\\,0.7088\\,$ | $\\,0.7123\\,$ | $\\,0.7157\\,$ | $\\,0.7190\\,$ | $\\,0.7224\\,$ |\n| $\\,0.6\\,$ | $\\,0.7422\\,$ | $\\,0.7454\\,$ | $\\,0.7486\\,$ | $\\,0.7517\\,$ | $\\,0.7549\\,$ |\n| $\\,0.7\\,$ | $\\,0.7734\\,$ | $\\,0.7764\\,$ | $\\,0.7794\\,$ | $\\,0.7823\\,$ | $\\,0.7852\\,$ |" :question/worked-solution "Let $X$ denote the weight of a watermelon, and let $Y$ denote the weight of a melon. We want to find \n\n$$\nP(X>3Y)=P(X-3Y>0).\n$$\n\nSince $X$ and $Y$ are independent random variables such that $X∼N(10,{4}^{2})$ and $Y∼N(5,{2}^{2})$, then \n\n$$\n\\begin{aligned}X-3Y & ∼N(10-3\\cdot 5,16+{3}^{2}\\cdot 4) \\\\  & ∼N(-5,52).\\end{aligned}\n$$\n\nSo, the variable $X-3Y$ is normally distributed with mean $\\mu =-5$ and standard deviation $\\sigma =\\sqrt{52}.$\n\nIn order to find $P(X-3Y>0),$ we convert $X-3Y$ to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(X-3Y>0) & =P(Z>\\frac{0+5}{\\sqrt{52}}) \\\\  & ≈P(Z>0.69) \\\\  & =1-P(Z<0.69) \\\\  & =1-P(Z\\le 0.69) \\\\  & =1-Φ(0.69)\\end{aligned}\n$$\n\nUsing the $z$-table, we see that\n\n$$\nΦ(0.69)≈0.7549.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X-3Y>0) & ≈1-Φ(0.69) \\\\  & ≈1-0.7549 \\\\  & ≈0.2451.\\end{aligned}\n$$\n\nSo, we conclude that the probability that the weight of a watermelon is more than $3$ times greater than the weight of a melon is $0.2451.$"}]}
