2186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474366} {:answer/id #uuid "4999264b-817a-578e-85f5-209e47509eee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474367}] :answer-field/correct {:answer/id #uuid "4999264b-817a-578e-85f5-209e47509eee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474367} :answer-field/id #uuid "25ecf0bb-4395-5d51-99bd-1c0a67d30176" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475109}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "251cfe7e-474d-59b2-8ccf-101401daf068" :question/math-academy-id "q-139978" :question/problem "Consider the following sentence:\n\n*If $A$ is a $5\\times 5$ matrix and $det(A)=0,$ then $\\text{__________}\\,.$*\n\nWhich of the following can be placed into the blank space to make a true statement?\n\nI. $A$ has no inverse\n\nII. $\\text{Null}(A)$ has dimension zero\n\nIII. $A$ has less than $5$ pivot columns\n\nSelect all that apply." :question/worked-solution "The invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,\\{\\,\\begin{aligned} & \\text{Col}(A)={R}^{5} \\\\  & \\text{dim(Col}(A))=5=\\text{rank}(A) \\\\  & \\text{Null}(A)=\\{0\\} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$\n\nWith that in mind, let's examine each of the options separately.\n\n- The following statement is true:\n\n*If $A$ is a $5\\times 5$ matrix and $det(A)=0,$ then $A$ has no inverse.* $\\,✓$ \n\nIndeed, since $det(A)=0,$ the matrix $A$ can't be invertible.\n\n- The following statement is false:\n\n*If $A$ is a $5\\times 5$ matrix and $det(A)=0,$ then $\\text{Null}(A)$ has dimension zero.* $\\,\\times $\n\nSince $A$ is not invertible, then according to the invertible matrix theorem, we have $\\text{Null}(A)\\ne \\{0\\}$ which, in turn,  means that $\\text{Null}(A)$ must have a basis so the dimension must be greater than zero.\n\n- The following statement is true:\n\n*If $A$ is a $5\\times 5$ matrix and $det(A)=0,$ then $A$ has less than $5$ pivot columns.* $\\,✓$\n\nIndeed, since $A$ is not invertible, then according to the invertible matrix theorem, we have $\\text{dim(Col}(A))\\ne 5,$ which means that $A$ has less than $5$ pivot columns.\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186272338 :knowledge-point/_questions [{:db/id #edb/ref 17592186124511 :knowledge-point/id #uuid "084a0a83-5ce6-5184-beb7-8ae7b4f1a799" :knowledge-point/title "Identifying True Statements Using the Invertible Matrix Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07f8d9af-560e-5e04-801f-49c3569ea09a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464240} {:answer/id #uuid "3683cdbb-cea0-5d3a-88ae-46bbf35523a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464241}] :answer-field/correct {:answer/id #uuid "07f8d9af-560e-5e04-801f-49c3569ea09a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464240} :answer-field/id #uuid "7d8b8cb5-e75e-518a-91a0-160dae2c2bc4" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465054} {:answer-field/choices [{:answer/id #uuid "7bba33a3-e841-5573-8abf-90651ed20a6d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464242} {:answer/id #uuid "0c34db9f-4df3-5319-9c26-896a5b27e435" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464243}] :answer-field/correct {:answer/id #uuid "7bba33a3-e841-5573-8abf-90651ed20a6d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464242} :answer-field/id #uuid "05d917c1-327f-5ee0-8aed-ef99e81a107b" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465055} {:answer-field/choices [{:answer/id #uuid "de2f17c6-86e7-560e-b3af-0ab0f7aab9fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464244} {:answer/id #uuid "06de2a3a-d315-52ff-898b-03d434ea28ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464245}] :answer-field/correct {:answer/id #uuid "06de2a3a-d315-52ff-898b-03d434ea28ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464245} :answer-field/id #uuid "4bcd47e5-e550-5069-9017-2362f6f7a623" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465056}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0c320bbb-0961-56b0-99e4-beaa75aa8f10" :question/math-academy-id "q-142358" :question/problem "Which of the following statements are true, given that $A$ is a $5\\times 5$ matrix and \n\n$$\n\\text{Null}(A)={[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ 0 \\\\ 2{x}_{2} \\\\ {x}_{1}\\end{aligned}]\\,|\\,{x}_{1},{x}_{2}\\in R}?\n$$\n- **I.** $\\text{dim(Null}(A))=0$\n- **II.** $A$ is  invertible\n- **III.** $\\text{Col}(A)\\ne {R}^{5}$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Since $A$ is a $5\\times 5$ matrix, the invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,{\\,\\begin{aligned} & \\text{Col}(A)={R}^{5} \\\\  & \\text{dim(Col}(A))=5=\\text{rank}(A) \\\\  & \\text{Null}(A)={0} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. Since \n\n$$\n\\text{Null}(A)={{x}_{1}[\\begin{aligned}1 \\\\ 0 \\\\ 0 \\\\ 0 \\\\ 1\\end{aligned}]+{x}_{2}[\\begin{aligned}0 \\\\ 1 \\\\ 0 \\\\ 2 \\\\ 0\\end{aligned}]\\,|\\,{x}_{1},{x}_{2}\\in R}\n$$\n\nwe conclude that \n\n$$\n\\text{dim(Null}(A))=2\\ne 0.\n$$\n\n- Statement II is false. Since $\\text{dim(Null}(A))\\ne 0,$ then according to the invertible matrix theorem, the matrix $A$ can't be invertible.\n\n- Statement III is true. Since $A$ is not invertible, then by the invertible matrix theorem, we must have $\\text{Col}(A)\\ne {R}^{5}.$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186426076 :knowledge-point/_questions [{:db/id #edb/ref 17592186124511 :knowledge-point/id #uuid "084a0a83-5ce6-5184-beb7-8ae7b4f1a799" :knowledge-point/title "Identifying True Statements Using the Invertible Matrix Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13e3d0a6-c269-5dde-bafd-a91861927c14" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186426036} {:answer/id #uuid "1848f756-51a0-5639-8084-5aa59abdaebf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186426037} {:answer/id #uuid "562361ed-d031-5fb2-9175-4571a3994648" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186426047} {:answer/id #uuid "8a7285e7-4a5d-5073-aa0f-ffd3853ddc65" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "lI only" :db/id #edb/ref 17592186426054} {:answer/id #uuid "f1d58843-37c3-5988-8dac-72db97dcd1cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186426064}] :answer-field/correct {:answer/id #uuid "f1d58843-37c3-5988-8dac-72db97dcd1cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186426064} :answer-field/id #uuid "fec9750c-eaeb-571d-b465-6fa1ab05e88d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186426071}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9fbccd10-1c43-51a4-ad8b-36063e11427d" :question/math-academy-id "q-142367" :question/problem "Which of the following statements are true, given that $A$ is a $4\\times 4$ matrix and $v=[\\begin{aligned}1 \\\\ 0 \\\\ 1 \\\\ -1\\end{aligned}]$ is a solution of the equation $Ax=0?$\n\nI. $\\text{dim(Null}(A))\\ne 0$\n\nII. $A$  is  invertible\n\nIII. $\\text{Col}(A)={R}^{4}$" :question/worked-solution "Since $A$ is a $4\\times 4$ matrix, the invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,\\{\\,\\begin{aligned} & \\text{Col}(A)={R}^{4} \\\\  & \\text{dim(Col}(A))=4=\\text{rank}(A) \\\\  & \\text{Null}(A)=\\{0\\} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$ \n\nWith that in mind, let's examine each statement in turn. \n\n- Statement I is true. Since $v\\ne 0$ and $Av=0,$ \nthen $v\\in \\text{Null}(A)$ and, therefore, $\\text{dim(Null}(A))\\ne 0.$\n\n- Statement II is false. Since $\\text{dim(Null}(A))\\ne 0,$ then according to the invertible matrix theorem, the matrix $A$ can't be invertible.\n\n- Statement III is false. Since $A$ is not invertible, then by the invertible matrix theorem, we must have $\\text{Col}(A)\\ne {R}^{4}.$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186125168 :knowledge-point/_questions [{:db/id #edb/ref 17592186124629 :knowledge-point/id #uuid "bb90e5b9-03fe-51cf-bc16-a293befacebc" :knowledge-point/title "Сompleting a Sentence Using the Invertible Matrix Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06680c4f-a621-5dc3-875e-3896db2af04b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460023} {:answer/id #uuid "5c1cf54f-05d3-5550-8f3d-cdfa3137d5bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460024}] :answer-field/correct {:answer/id #uuid "06680c4f-a621-5dc3-875e-3896db2af04b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460023} :answer-field/id #uuid "e3156979-45c5-5d24-80c1-f665fce48ba8" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460878} {:answer-field/choices [{:answer/id #uuid "88c8b9c9-048e-580b-90b5-0615fcacbfe9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460025} {:answer/id #uuid "5cd76941-0308-57d6-9b7b-3ba6c48171e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460026}] :answer-field/correct {:answer/id #uuid "5cd76941-0308-57d6-9b7b-3ba6c48171e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460026} :answer-field/id #uuid "44325e4a-3b71-5949-9822-a4ed24085c3a" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460879} {:answer-field/choices [{:answer/id #uuid "3989b63d-47f8-5757-bb11-6a685f029eeb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460027} {:answer/id #uuid "16bc9a89-2517-5c10-b196-866970cad27b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460028}] :answer-field/correct {:answer/id #uuid "3989b63d-47f8-5757-bb11-6a685f029eeb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460027} :answer-field/id #uuid "a9665add-7abd-5377-b1f0-9d3eafc436be" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460880}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7f4e1182-d195-5cca-bb1a-601ea1f9c921" :question/math-academy-id "q-47599" :question/problem "Consider the following sentence:\n\n*If $A$ is a $7\\times 7$ matrix and $A$ is invertible,  then $\\text{__________}$ .*\n\nWhich of the following can be placed into the blank space to make a true statement?\n- **I.** $det(A)=0$\n- **II.** $\\text{Col}(A)={R}^{7}$\n- **III.** $A$ has $5$ pivot columns\n\nSelect all that apply." :question/worked-solution "If $A$ is an $7\\times 7$ matrix, the invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,{\\,\\begin{aligned} & \\text{Col}(A)={R}^{7} \\\\  & \\text{dim(Col}(A))=7=\\text{rank}(A) \\\\  & \\text{Null}(A)={0} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$\n\nWith that in mind, let's examine each of the options separately.\n\n- The following statement is false:\n\n*If $A$ is a $7\\times 7$ matrix and $A$ is invertible,  then $det(A)=0$* $\\,\\times $ \n\nSince the matrix $A$ is invertible, it must be  $det(A)\\ne 0.$\n\n- The following statement is true:\n\n*If $A$ is a $7\\times 7$ matrix and $A$ is invertible,  then  $\\text{Col}(A)={R}^{7}.$* $\\,✓$\n\nIndeed, since $A$ is invertible, then according to the invertible matrix theorem,  we have $\\text{Col}(A)={R}^{7}.$\n\n- The following statement is false:\n\n*If $A$ is a $7\\times 7$ matrix and $A$ is invertible,  then $A$ has $5$ pivot columns.* $\\,\\times $ \n\nSince $A$ is invertible, then according to the invertible matrix theorem, we have $\\text{dim(Col}(A))=7,$ which means that $A$ has exactly $7$ pivot columns.\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186435676 :knowledge-point/_questions [{:db/id #edb/ref 17592186124511 :knowledge-point/id #uuid "084a0a83-5ce6-5184-beb7-8ae7b4f1a799" :knowledge-point/title "Identifying True Statements Using the Invertible Matrix Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f2b28520-430a-5247-a200-fd5f414e5ada" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454012} {:answer/id #uuid "f8033251-ab93-5bb9-a145-e5e99be3d388" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454013}] :answer-field/correct {:answer/id #uuid "f2b28520-430a-5247-a200-fd5f414e5ada" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454012} :answer-field/id #uuid "da3c91e0-c158-561e-ab32-6e72b9ba78b5" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454756} {:answer-field/choices [{:answer/id #uuid "647ee441-bfd6-5c35-84c4-0fc1e7479328" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454014} {:answer/id #uuid "f0e66778-9876-5718-a6e2-1e95fc527bdb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454015}] :answer-field/correct {:answer/id #uuid "647ee441-bfd6-5c35-84c4-0fc1e7479328" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454014} :answer-field/id #uuid "030534f1-c9cc-5372-9ff2-bdc749c441e3" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454757} {:answer-field/choices [{:answer/id #uuid "31d47ce5-4beb-5f68-bae7-0d361ea95c62" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454016} {:answer/id #uuid "f6dcdf0f-841a-5b0d-aff9-db735d828b23" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454017}] :answer-field/correct {:answer/id #uuid "f6dcdf0f-841a-5b0d-aff9-db735d828b23" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454017} :answer-field/id #uuid "eced16f4-9e93-50d2-bf88-cdda3960f7ec" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454758}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ea4581af-a083-51da-803f-0f83b3ed2ea6" :question/math-academy-id "q-79349" :question/problem "Which of the following statements are true, given that $A$ is a $5\\times 5$ matrix and  $det(A)=1?$\n\nSelect all that apply.\n\n- **I.** $A$ is not invertible\n\n- **II.** $\\text{rank}(A)=4$\n\n- **III.** $A$ has $5$ pivot columns" :question/worked-solution "Since $A$ is a $5\\times 5$ matrix, the invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,\\{\\,\\begin{aligned} & \\text{Col}(A)={R}^{5} \\\\  & \\text{dim(Col}(A))=5=\\text{rank}(A) \\\\  & \\text{Null}(A)=\\{0\\} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$\n\nWith that in mind, let's examine each statement in turn. \n\n- Statement I is false. Indeed,   a matrix $A$ is invertible if and only if $det(A)\\ne 0.$ Since here we have $det(A)=1\\ne 0,$ our matrix $A$ must be  invertible.\n\n- Statement II is false. Indeed, by the invertible matrix theorem\n$A$ is invertible $\\,⇔\\,\\text{rank}(A)=5.$\n\n- Statement III is true. Since $\\text{rank}(A)=5$,  it must be $\\text{dim(Col}(A))=5$ which, in turn, means that  $A$ has $5$ pivot columns.\n\nTherefore, the correct answer is \"III only.\""}]}
