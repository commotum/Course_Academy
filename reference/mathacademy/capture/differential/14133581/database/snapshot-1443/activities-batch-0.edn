#{[{:activity/expected-seconds 960.0 :activity/first-step {:db/id #edb/ref 17592186092995} :activity/id #uuid "95d8fd9f-fddb-5a11-8670-194ad28cdab0" :activity/scope {:db/id #edb/ref 17592186049392 :topic/id #uuid "f1031f6b-01e9-5ea8-af71-27bacc9d53b8" :topic/math-academy-id 1023} :activity/steps [{:db/id #edb/ref 17592186092995 :step/content {:db/id #edb/ref 17592186093403 :tutorial/content "We know that we can write a system of three linear equations in three variables in the form $A\\mathbf{x}=\\mathbf{b},$ where\n\n- $A$ is the $3\\times 3$ coefficient matrix,\n\n- $\\mathbf{x}$ is the column vector of variables, and\n\n- $\\mathbf{b}$ is the column vector of constants.\n\nIf the $3\\times 3$ matrix $A$ is invertible, then we can find a solution to the system $A\\mathbf{x} = \\mathbf{b}$ by \"pre-multiplying\" both sides of the equation by $A^{-1}{:}$\n\n$$\n\\begin{aligned}Ax & =b \\\\ {A}^{-1}Ax & ={A}^{-1}b \\\\ {I}_{3}x & ={A}^{-1}b \\\\ x & ={A}^{-1}b\\end{aligned}\n$$\n\nSo, to find the solution of $A\\mathbf{x}=\\mathbf{b},$ we simply calculate $\\mathbf{x}= A^{-1}\\mathbf{b}.$\n\nLet's see how this works for a particular system in the next example." :tutorial/id #uuid "4c0fe954-2cf5-5eb6-b58f-c6963f5be7f2" :tutorial/math-academy-id 3054 :tutorial/title "Introduction"} :step/id #uuid "8e9e60d9-ca5d-5380-9aad-e2eb767f920e" :step/math-academy-id 16484 :step/next {:db/id #edb/ref 17592186092996}} {:db/id #edb/ref 17592186092996 :step/content {:db/id #edb/ref 17592186092185 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092025 :question/id #uuid "2737e6bc-5372-50a0-bf2f-59a91f571a57" :question/math-academy-id "e-4520"} :knowledge-point/id #uuid "12637b1d-ca03-568f-b1fc-6a626eec88de" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049151} {:db/id #edb/ref 17592186050825}] :knowledge-point/questions [{:db/id #edb/ref 17592186092817} {:db/id #edb/ref 17592186092818} {:db/id #edb/ref 17592186292892} {:db/id #edb/ref 17592186348080} {:db/id #edb/ref 17592186348093} {:db/id #edb/ref 17592186348094} {:db/id #edb/ref 17592186348095} {:db/id #edb/ref 17592186348096} {:db/id #edb/ref 17592186393877} {:db/id #edb/ref 17592186393884} {:db/id #edb/ref 17592186435149}] :knowledge-point/title "Solving a 3x3 System of Equations Given the Inverse of the Coefficient Matrix"} :step/id #uuid "e317b6ac-3382-5ce2-962a-936c0a5dc928" :step/math-academy-id 16485 :step/next {:db/id #edb/ref 17592186092997}} {:db/id #edb/ref 17592186092997 :step/content {:db/id #edb/ref 17592186092186 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092026 :question/id #uuid "d32f2604-fc3f-5e80-8085-483e6fd9a3ad" :question/math-academy-id "e-4521"} :knowledge-point/id #uuid "4ad1721d-26a4-5459-bc81-297ff0e4d678" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049043}] :knowledge-point/questions [{:db/id #edb/ref 17592186092709} {:db/id #edb/ref 17592186092937} {:db/id #edb/ref 17592186237787} {:db/id #edb/ref 17592186237803} {:db/id #edb/ref 17592186237804} {:db/id #edb/ref 17592186237805} {:db/id #edb/ref 17592186237810} {:db/id #edb/ref 17592186237812} {:db/id #edb/ref 17592186237814} {:db/id #edb/ref 17592186240893} {:db/id #edb/ref 17592186240894} {:db/id #edb/ref 17592186240895} {:db/id #edb/ref 17592186292893} {:db/id #edb/ref 17592186415690} {:db/id #edb/ref 17592186435147}] :knowledge-point/title "Solving a 3x3 System of Equations By Calculating the Inverse of the Coefficient Matrix"} :step/id #uuid "fbf465d4-96d6-52f9-879f-09f247f27b80" :step/math-academy-id 16486 :step/next {:db/id #edb/ref 17592186092999}} {:db/id #edb/ref 17592186092999 :step/content {:db/id #edb/ref 17592186092187 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092027 :question/id #uuid "06a50eb4-4976-55fd-aa44-6509b27eccb9" :question/math-academy-id "e-4604"} :knowledge-point/id #uuid "5d0cda54-4a4b-5255-b375-ce5e7b604dff" :knowledge-point/questions [{:db/id #edb/ref 17592186092813} {:db/id #edb/ref 17592186092819} {:db/id #edb/ref 17592186299656} {:db/id #edb/ref 17592186348097} {:db/id #edb/ref 17592186348098} {:db/id #edb/ref 17592186348099} {:db/id #edb/ref 17592186348100} {:db/id #edb/ref 17592186393856} {:db/id #edb/ref 17592186393891} {:db/id #edb/ref 17592186393898} {:db/id #edb/ref 17592186393905} {:db/id #edb/ref 17592186403947} {:db/id #edb/ref 17592186403954} {:db/id #edb/ref 17592186435148}] :knowledge-point/title "Solving a Matrix Equation Using Algebraic Manipulation"} :step/id #uuid "9a3ebe3d-7f48-57e9-995c-5652343c5b4a" :step/math-academy-id 16759}] :activity/title "Solving Systems of Equations Using Inverse Matrices" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186092406}] [{:activity/course {:db/id #edb/ref 17592186046673} :activity/first-step {:db/id #edb/ref 17592186415691} :activity/id #uuid "19f27baf-34c3-5e03-bcb6-d2509997eb57" :activity/scope {:db/id #edb/ref 17592186049392 :topic/id #uuid "f1031f6b-01e9-5ea8-af71-27bacc9d53b8" :topic/math-academy-id 1023} :activity/steps [{:db/id #edb/ref 17592186415691 :step/content {:db/id #edb/ref 17592186415690 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "546c8e95-b26b-5ff9-83d6-638b399b687a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-\\frac{5}{2},y=9,z=-\\frac{9}{2}" :db/id #edb/ref 17592186415684} {:answer/id #uuid "854c87f7-583e-578a-92c5-d3db59792427" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\frac{5}{2},y=9,z=\\frac{9}{2}" :db/id #edb/ref 17592186415685} {:answer/id #uuid "92176233-f61a-5a1f-a96a-0e59d129daf0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-\\frac{5}{2},y=-9,z=-\\frac{9}{2}" :db/id #edb/ref 17592186415686} {:answer/id #uuid "922397fb-a6df-5cdc-b3c4-40ed001f749e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-5,y=18,z=-9" :db/id #edb/ref 17592186415687} {:answer/id #uuid "d2d344f8-2327-5d63-96e1-0bdf947cb05c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-5,y=-18,z=-9" :db/id #edb/ref 17592186415688}] :answer-field/correct {:db/id #edb/ref 17592186415684} :answer-field/id #uuid "e7180735-62b0-5917-9dd2-0f45d066402b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186415689}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2997dd93-b478-5bad-935c-182c80540138" :question/math-academy-id "q-10091" :question/problem "Solve the following system of linear equations by finding the inverse of the coefficient matrix:\n\n$$\n\\begin{aligned}{\\begin{aligned}y+2z=0 \\\\ x+2y+3z=2 \\\\ 3x+y+z=-3\\end{aligned}\\end{aligned}\n$$" :question/worked-solution "We wish to write this system in the form $Ax=b$, where $A$ is a $3\\times 3$ matrix and $x$ and $b$ are $3\\times 1$ column vectors. We can do this as follows:\n\n$$\n[\\begin{aligned}0 & 1 & 2 \\\\ 1 & 2 & 3 \\\\ 3 & 1 & 1\\end{aligned}][\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}0 \\\\ 2 \\\\ -3\\end{aligned}].\n$$\n\nNow, the solution to $Ax=b$ is given by $x={A}^{-1}b.$ So, we compute ${A}^{-1}$ as follows:\n\n*Step 1:*\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}0 & 1 & 2 \\\\ 1 & 2 & 3 \\\\ 3 & 1 & 1\\end{aligned}| \\\\  & =0|\\begin{aligned}2 & 3 \\\\ 1 & 1\\end{aligned}|-1|\\begin{aligned}1 & 3 \\\\ 3 & 1\\end{aligned}|+2|\\begin{aligned}1 & 2 \\\\ 3 & 1\\end{aligned}| \\\\  & =0-1(1-9)+2(1-6) \\\\  & =+8-10 \\\\  & =-2.\\end{aligned}\n$$\n\n*Step 2:*\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}|\\begin{aligned}2 & 3 \\\\ 1 & 1\\end{aligned}| & |\\begin{aligned}1 & 3 \\\\ 3 & 1\\end{aligned}| & |\\begin{aligned}1 & 2 \\\\ 3 & 1\\end{aligned}| \\\\ |\\begin{aligned}1 & 2 \\\\ 1 & 1\\end{aligned}| & |\\begin{aligned}0 & 2 \\\\ 3 & 1\\end{aligned}| & |\\begin{aligned}0 & 1 \\\\ 3 & 1\\end{aligned}| \\\\ |\\begin{aligned}1 & 2 \\\\ 2 & 3\\end{aligned}| & |\\begin{aligned}0 & 2 \\\\ 1 & 3\\end{aligned}| & |\\begin{aligned}0 & 1 \\\\ 1 & 2\\end{aligned}|\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & -8 & -5 \\\\ -1 & -6 & -3 \\\\ -1 & -2 & -1\\end{aligned}].\\end{aligned}\n$$\n\n*Step 3:*\n\n$$\nC=[\\begin{aligned}-1 & 8 & -5 \\\\ 1 & -6 & 3 \\\\ -1 & 2 & -1\\end{aligned}].\n$$\n\n*Step 4:*\n\n$$\n{C}^{T}=[\\begin{aligned}-1 & 1 & -1 \\\\ 8 & -6 & 2 \\\\ -5 & 3 & -1\\end{aligned}].\n$$\n\n*Step 5:*\n\n$$\n{A}^{-1}=\\frac{1}{det(A)}{C}^{T}=-\\frac{1}{2}[\\begin{aligned}-1 & 1 & -1 \\\\ 8 & -6 & 2 \\\\ -5 & 3 & -1\\end{aligned}]=\\frac{1}{2}[\\begin{aligned}1 & -1 & 1 \\\\ -8 & 6 & -2 \\\\ 5 & -3 & 1\\end{aligned}].\n$$\n\nHence\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{2}[\\begin{aligned}1 & -1 & 1 \\\\ -8 & 6 & -2 \\\\ 5 & -3 & 1\\end{aligned}][\\begin{aligned}0 \\\\ 2 \\\\ -3\\end{aligned}] \\\\  & =[\\begin{aligned}-\\frac{5}{2} \\\\ 9 \\\\ -\\frac{9}{2}\\end{aligned}].\\end{aligned}\n$$\n\nHence the solution is $x=-\\frac{5}{2},y=9,z=-\\frac{9}{2}.$"} :step/id #uuid "100a637e-a49a-5d4a-80d2-e88a9e19ca4c" :step/next {:db/id #edb/ref 17592186415693}} {:db/id #edb/ref 17592186415692 :step/content {:db/id #edb/ref 17592186348099 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6788781d-31d5-5bd7-b27b-68afaa4d9325" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=B\\,d\\,A" :db/id #edb/ref 17592186346254} {:answer/id #uuid "9bded5b5-b83d-570e-9629-cd29113e20b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=B\\,d\\,{A}^{-1}" :db/id #edb/ref 17592186346708} {:answer/id #uuid "a4a497d7-ea8a-5a5f-b4fd-1d8c483ff5a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x={A}^{-1}B\\,d" :db/id #edb/ref 17592186346783} {:answer/id #uuid "b6d2cc68-86a2-5604-8401-931a07c9e6b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=BA\\,d" :db/id #edb/ref 17592186346945} {:answer/id #uuid "e304282a-e8e7-5d48-b8b7-fb2bbc3eab5d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=AB\\,d" :db/id #edb/ref 17592186347347}] :answer-field/correct {:db/id #edb/ref 17592186347347} :answer-field/id #uuid "b4e01459-2873-55b9-8f7c-c4fb473002de" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186347921}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "5f0cd9e3-58c9-5ff5-838e-38f22a6e88cb" :question/math-academy-id "q-78570" :question/problem "Consider a matrix equation ${A}^{-1}\\,x=B\\,d,$ where $A$ and $B$ are $7\\times 7$ non-singular matrices, while $x$ and $d$ are $7\\times 1$ column vectors. Solve the equation for $x.$" :question/worked-solution "Pre-multiplying both sides of the equation ${A}^{-1}\\,x=B\\,d$ by $A,$ we obtain\n\n$$\n\\begin{aligned}{A}^{-1}\\,x & =B\\,d \\\\ A{A}^{-1}\\,x & =AB\\,d \\\\ {I}_{7}\\,x & =AB\\,d \\\\ x & =AB\\,d.\\end{aligned}\n$$"} :step/id #uuid "227ec066-022a-52e9-9829-1a29de29e8db"} {:db/id #edb/ref 17592186415693 :step/content {:db/id #edb/ref 17592186403947 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53d8f566-865b-5d1d-968f-ffc7aeaaf0b3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "${D}^{-1}$ and ${I}_{n}$" :db/id #edb/ref 17592186403949} {:answer/id #uuid "6898f8cf-ef60-599d-b703-aeb35e14e141" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$D$ and ${I}_{n}$" :db/id #edb/ref 17592186403950} {:answer/id #uuid "0329ed6f-dee9-5205-b238-18984ed73972" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "${D}^{-1}$ and $D$" :db/id #edb/ref 17592186403951} {:answer/id #uuid "a15466de-3c65-5970-8e36-5b25e21ca209" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "${D}^{-1}$ and ${D}^{-1}$" :db/id #edb/ref 17592186403952} {:answer/id #uuid "daabc2d4-f4ce-50f8-9f41-a9e7585ac6e4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$D$ and $z$" :db/id #edb/ref 17592186403953}] :answer-field/correct {:db/id #edb/ref 17592186403949} :answer-field/id #uuid "4cf7d7a2-cf8f-5d79-a5a3-2c7fb6abb055" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186403948}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "863bd08e-01cd-5a69-b3ce-bacc176f8b4b" :question/math-academy-id "q-78559" :question/problem "Consider a system of $n$ linear equations in $n$ variables, written in matrix form as $D\\,z=c.$ Here, $D$ is the non-singular coefficient matrix of the system, $z$ is the column vector containing the variables, and $c$ is the column vector containing the constants. The unique solution of the system can be found using the method shown below:\n\n$$\n\\begin{aligned}D\\,z & =c \\\\ {D}^{-1}D\\,z & =\\bbox[2pt,lightgray]{\\color{blue}{\\phantom{{D}^{-1}}}}c \\\\ \\bbox[2pt,lightgray]{\\color{blue}{\\phantom{{I}_{n}}}}z & ={D}^{-1}\\,c \\\\ z & ={D}^{-1}\\,c\\end{aligned}\n$$\n\nFrom top to bottom and right to left, what are the missing parts of the derivation?" :question/worked-solution "Since $D$ is not singular, it must have an inverse ${D}^{-1}.$ Now, pre-multiplying both sides of the equation $D\\,z=c$ by ${D}^{-1},$ we obtain the following:\n\n$$\n\\begin{aligned}D\\,z & =c \\\\ {D}^{-1}D\\,z & ={D}^{-1}c \\\\ {I}_{n}\\,z & ={D}^{-1}\\,c \\\\ z & ={D}^{-1}\\,c\\end{aligned}\n$$\n\nTherefore, the missing parts are ${D}^{-1}$ and ${I}_{n}.$"} :step/id #uuid "42e8894e-d466-5fe7-9f98-3286e55d0c47" :step/next {:db/id #edb/ref 17592186415692}}] :activity/title "Solving Systems of Equations Using Inverse Matrices" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186415683}]}
