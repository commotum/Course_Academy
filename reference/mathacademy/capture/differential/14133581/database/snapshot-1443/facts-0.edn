/ref 17592186045417] [17592186092187 #edb/ref 1038 #edb/ref 17592186393905 #edb/ref 17592186045417] [17592186092187 #edb/ref 1038 #edb/ref 17592186403947 #edb/ref 17592186045417] [17592186092187 #edb/ref 1038 #edb/ref 17592186403954 #edb/ref 17592186045417] [17592186092187 #edb/ref 1038 #edb/ref 17592186435148 #edb/ref 17592186045417] [17592186092187 #edb/ref 1039 "Solving a Matrix Equation Using Algebraic Manipulation" #edb/ref 17592186045417] [17592186092187 #edb/ref 1041 #edb/ref 17592186092027 #edb/ref 17592186045417] [17592186092187 #edb/ref 1042 #uuid "5d0cda54-4a4b-5255-b375-ce5e7b604dff" #edb/ref 17592186045417] [17592186092406 #edb/ref 1043 #edb/ref 17592186092995 #edb/ref 17592186045417] [17592186092406 #edb/ref 1043 #edb/ref 17592186092996 #edb/ref 17592186045417] [17592186092406 #edb/ref 1043 #edb/ref 17592186092997 #edb/ref 17592186045417] [17592186092406 #edb/ref 1043 #edb/ref 17592186092999 #edb/ref 17592186045417] [17592186092406 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186092406 #edb/ref 1045 "Solving Systems of Equations Using Inverse Matrices" #edb/ref 17592186045417] [17592186092406 #edb/ref 1046 #edb/ref 17592186092995 #edb/ref 17592186045417] [17592186092406 #edb/ref 1049 #edb/ref 17592186049392 #edb/ref 17592186045417] [17592186092406 #edb/ref 1050 960.0 #edb/ref 17592186045417] [17592186092406 #edb/ref 1053 #uuid "95d8fd9f-fddb-5a11-8670-194ad28cdab0" #edb/ref 17592186045417] [17592186092995 #edb/ref 1058 #edb/ref 17592186092996 #edb/ref 17592186045417] [17592186092995 #edb/ref 1061 16484 #edb/ref 17592186045417] [17592186092995 #edb/ref 1062 #uuid "8e9e60d9-ca5d-5380-9aad-e2eb767f920e" #edb/ref 17592186045417] [17592186092995 #edb/ref 1063 #edb/ref 17592186093403 #edb/ref 17592186045417] [17592186092996 #edb/ref 1058 #edb/ref 17592186092997 #edb/ref 17592186045417] [17592186092996 #edb/ref 1061 16485 #edb/ref 17592186045417] [17592186092996 #edb/ref 1062 #uuid "e317b6ac-3382-5ce2-962a-936c0a5dc928" #edb/ref 17592186045417] [17592186092996 #edb/ref 1063 #edb/ref 17592186092185 #edb/ref 17592186045417] [17592186092997 #edb/ref 1058 #edb/ref 17592186092999 #edb/ref 17592186045417] [17592186092997 #edb/ref 1061 16486 #edb/ref 17592186045417] [17592186092997 #edb/ref 1062 #uuid "fbf465d4-96d6-52f9-879f-09f247f27b80" #edb/ref 17592186045417] [17592186092997 #edb/ref 1063 #edb/ref 17592186092186 #edb/ref 17592186045417] [17592186092999 #edb/ref 1061 16759 #edb/ref 17592186045417] [17592186092999 #edb/ref 1062 #uuid "9a3ebe3d-7f48-57e9-995c-5652343c5b4a" #edb/ref 17592186045417] [17592186092999 #edb/ref 1063 #edb/ref 17592186092187 #edb/ref 17592186045417] [17592186093403 #edb/ref 1064 "We know that we can write a system of three linear equations in three variables in the form $A\\mathbf{x}=\\mathbf{b},$ where\n\n- $A$ is the $3\\times 3$ coefficient matrix,\n\n- $\\mathbf{x}$ is the column vector of variables, and\n\n- $\\mathbf{b}$ is the column vector of constants.\n\nIf the $3\\times 3$ matrix $A$ is invertible, then we can find a solution to the system $A\\mathbf{x} = \\mathbf{b}$ by \"pre-multiplying\" both sides of the equation by $A^{-1}{:}$\n\n$$\n\\begin{aligned}Ax & =b \\\\ {A}^{-1}Ax & ={A}^{-1}b \\\\ {I}_{3}x & ={A}^{-1}b \\\\ x & ={A}^{-1}b\\end{aligned}\n$$\n\nSo, to find the solution of $A\\mathbf{x}=\\mathbf{b},$ we simply calculate $\\mathbf{x}= A^{-1}\\mathbf{b}.$\n\nLet's see how this works for a particular system in the next example." #edb/ref 17592186045417] [17592186093403 #edb/ref 1065 3054 #edb/ref 17592186045417] [17592186093403 #edb/ref 1066 #uuid "4c0fe954-2cf5-5eb6-b58f-c6963f5be7f2" #edb/ref 17592186045417] [17592186093403 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186236233 #edb/ref 1080 "x=-29,y=-12,z=100" #edb/ref 17592186045417] [17592186236233 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186236233 #edb/ref 1083 #uuid "4128ba71-30f4-5d9f-a1da-f0feb798ee82" #edb/ref 17592186045417] [17592186236294 #edb/ref 1080 "x=-29,y=-12,z=-100" #edb/ref 17592186045417] [17592186236294 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186236294 #edb/ref 1083 #uuid "4a578053-2e19-50df-9af8-8b315860043c" #edb/ref 17592186045417] [17592186236392 #edb/ref 1080 "x=29,y=12,z=100" #edb/ref 17592186045417] [17592186236392 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186236392 #edb/ref 1083 #uuid "5c4620a0-76d3-5e9f-92c3-382dca21ee9c" #edb/ref 17592186045417] [17592186236666 #edb/ref 1080 "x=-25,y=-12,z=100" #edb/ref 17592186045417] [17592186236666 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186236666 #edb/ref 1083 #uuid "88066dff-8cdf-5893-a4d3-81d269f7ee2c" #edb/ref 17592186045417] [17592186236992 #edb/ref 1080 "x=-29,y=-15,z=100" #edb/ref 17592186045417] [17592186236992 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186236992 #edb/ref 1083 #uuid "b8391916-39bd-5633-8b71-eb03b0decc7e" #edb/ref 17592186045417] [17592186237563 #edb/ref 1075 #edb/ref 17592186236233 #edb/ref 17592186045417] [17592186237563 #edb/ref 1075 #edb/ref 17592186236294 #edb/ref 17592186045417] [17592186237563 #edb/ref 1075 #edb/ref 17592186236392 #edb/ref 17592186045417] [17592186237563 #edb/ref 1075 #edb/ref 17592186236666 #edb/ref 17592186045417] [17592186237563 #edb/ref 1075 #edb/ref 17592186236992 #edb/ref 17592186045417] [17592186237563 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186237563 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186237563 #edb/ref 1078 #edb/ref 17592186236233 #edb/ref 17592186045417] [17592186237563 #edb/ref 1079 #uuid "5b7b3d13-f904-586b-ba35-a7c8c21f7369" #edb/ref 17592186045417] [17592186237810 #edb/ref 1068 #edb/ref 17592186237563 #edb/ref 17592186045417] [17592186237810 #edb/ref 1069 "q-10100" #edb/ref 17592186045417] [17592186237810 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186237810 #edb/ref 1071 "Solve the following system of linear equations by finding the inverse of the coefficient matrix:\n\n$$\n\\begin{aligned}\\{\\begin{aligned}2x+3y+z=6 \\\\ 4x+7y+2z=0 \\\\ 3x+y+z=1\\end{aligned}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186237810 #edb/ref 1072 #uuid "c7f748e9-7cb4-573b-a324-159e0e3861ab" #edb/ref 17592186045417] [17592186237810 #edb/ref 1074 "We wish to write this system in the form $Ax=b$, where $A$ is a $3\\times 3$ matrix and $x$ and $b$ are $3\\times 1$ column vectors. We can do this as follows:\n\n$$\n[\\begin{aligned}2 & 3 & 1 \\\\ 4 & 7 & 2 \\\\ 3 & 1 & 1\\end{aligned}][\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}6 \\\\ 0 \\\\ 1\\end{aligned}].\n$$\n\nNow, the solution to $Ax=b$ is given by $x={A}^{-1}b.$ So, we compute ${A}^{-1}$ as follows:\n\n*Step 1:*\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}2 & 3 & 1 \\\\ 4 & 7 & 2 \\\\ 3 & 1 & 1\\end{aligned}| \\\\  & =2|\\begin{aligned}7 & 2 \\\\ 1 & 1\\end{aligned}|-3|\\begin{aligned}4 & 2 \\\\ 3 & 1\\end{aligned}|+1|\\begin{aligned}4 & 7 \\\\ 3 & 1\\end{aligned}| \\\\  & =2(7-2)-3(-2)+1(4-21) \\\\  & =10+6-17 \\\\  & =-1.\\end{aligned}\n$$\n\n*Step 2:*\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}|\\begin{aligned}7 & 2 \\\\ 1 & 1\\end{aligned}| & |\\begin{aligned}4 & 2 \\\\ 3 & 1\\end{aligned}| & |\\begin{aligned}4 & 7 \\\\ 3 & 1\\end{aligned}| \\\\ |\\begin{aligned}3 & 1 \\\\ 1 & 1\\end{aligned}| & |\\begin{aligned}2 & 1 \\\\ 3 & 1\\end{aligned}| & |\\begin{aligned}2 & 3 \\\\ 3 & 1\\end{aligned}| \\\\ |\\begin{aligned}3 & 1 \\\\ 7 & 2\\end{aligned}| & |\\begin{aligned}2 & 1 \\\\ 4 & 2\\end{aligned}| & |\\begin{aligned}2 & 3 \\\\ 4 & 7\\end{aligned}|\\end{aligned}] \\\\  & =[\\begin{aligned}5 & -2 & -17 \\\\ 2 & -1 & -7 \\\\ -1 & 0 & 2\\end{aligned}].\\end{aligned}\n$$\n\n*Step 3:*\n\n$$\nC=[\\begin{aligned}5 & 2 & -17 \\\\ -2 & -1 & 7 \\\\ -1 & 0 & 2\\end{aligned}].\n$$\n\n*Step 4:*\n\n$$\n{C}^{T}=[\\begin{aligned}5 & -2 & -1 \\\\ 2 & -1 & 0 \\\\ -17 & 7 & 2\\end{aligned}].\n$$\n\n*Step 5:*\n\n$$\n{A}^{-1}=\\frac{1}{det(A)}{C}^{T}=-\\frac{1}{1}[\\begin{aligned}5 & -2 & -1 \\\\ 2 & -1 & 0 \\\\ -17 & 7 & 2\\end{aligned}]=[\\begin{aligned}-5 & 2 & 1 \\\\ -2 & 1 & 0 \\\\ 17 & -7 & -2\\end{aligned}].\n$$\n\nHence\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =[\\begin{aligned}-5 & 2 & 1 \\\\ -2 & 1 & 0 \\\\ 17 & -7 & -2\\end{aligned}][\\begin{aligned}6 \\\\ 0 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}-29 \\\\ -12 \\\\ 100\\end{aligned}].\\end{aligned}\n$$\n\nHence the solution is $x=-29,y=-12,z=100.$" #edb/ref 17592186045417] [17592186346254 #edb/ref 1080 "x=B\\,d\\,A" #edb/ref 17592186045417] [17592186346254 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186346254 #edb/ref 1083 #uuid "6788781d-31d5-5bd7-b27b-68afaa4d9325" #edb/ref 17592186045417] [17592186346708 #edb/ref 1080 "x=B\\,d\\,{A}^{-1}" #edb/ref 17592186045417] [17592186346708 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186346708 #edb/ref 1083 #uuid "9bded5b5-b83d-570e-9629-cd29113e20b5" #edb/ref 17592186045417] [17592186346783 #edb/ref 1080 "x={A}^{-1}B\\,d" #edb/ref 17592186045417] [17592186346783 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186346783 #edb/ref 1083 #uuid "a4a497d7-ea8a-5a5f-b4fd-1d8c483ff5a2" #edb/ref 17592186045417] [17592186346945 #edb/ref 1080 "x=BA\\,d" #edb/ref 17592186045417] [17592186346945 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186346945 #edb/ref 1083 #uuid "b6d2cc68-86a2-5604-8401-931a07c9e6b8" #edb/ref 17592186045417] [17592186347347 #edb/ref 1080 "x=AB\\,d" #edb/ref 17592186045417] [17592186347347 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186347347 #edb/ref 1083 #uuid "e304282a-e8e7-5d48-b8b7-fb2bbc3eab5d" #edb/ref 17592186045417] [17592186347921 #edb/ref 1075 #edb/ref 17592186346254 #edb/ref 17592186045417] [17592186347921 #edb/ref 1075 #edb/ref 17592186346708 #edb/ref 17592186045417] [17592186347921 #edb/ref 1075 #edb/ref 17592186346783 #edb/ref