139534755 17592186045417 true] [17592186435144 1079 #uuid "3722cf83-66cd-54b2-a5b1-3a7fa87b1c56" 13194139534755 17592186045417 true] [17592186435145 1075 #edb/ref 17592186435135 13194139534755 17592186045417 true] [17592186435145 1075 #edb/ref 17592186435139 13194139534755 17592186045417 true] [17592186435145 1075 #edb/ref 17592186435140 13194139534755 17592186045417 true] [17592186435145 1075 #edb/ref 17592186435142 13194139534755 17592186045417 true] [17592186435145 1075 #edb/ref 17592186435143 13194139534755 17592186045417 true] [17592186435145 1076 #edb/ref 17592186045493 13194139534755 17592186045417 true] [17592186435145 1077 "selection" 13194139534755 17592186045417 true] [17592186435145 1078 #edb/ref 17592186435142 13194139534755 17592186045417 true] [17592186435145 1079 #uuid "c0e50419-c826-5a89-9337-910bb9a469c2" 13194139534755 17592186045417 true] [17592186435146 1075 #edb/ref 17592186435129 13194139534755 17592186045417 true] [17592186435146 1075 #edb/ref 17592186435130 13194139534755 17592186045417 true] [17592186435146 1075 #edb/ref 17592186435131 13194139534755 17592186045417 true] [17592186435146 1075 #edb/ref 17592186435132 13194139534755 17592186045417 true] [17592186435146 1075 #edb/ref 17592186435134 13194139534755 17592186045417 true] [17592186435146 1076 #edb/ref 17592186045493 13194139534755 17592186045417 true] [17592186435146 1077 "selection" 13194139534755 17592186045417 true] [17592186435146 1078 #edb/ref 17592186435132 13194139534755 17592186045417 true] [17592186435146 1079 #uuid "d554649a-905d-57c6-af27-cc40c4c45a3a" 13194139534755 17592186045417 true] [17592186435147 1068 #edb/ref 17592186435146 13194139534755 17592186045417 true] [17592186435147 1069 "q-104515" 13194139534755 17592186045417 true] [17592186435147 1070 #edb/ref 17592186045486 13194139534755 17592186045417 true] [17592186435147 1071 "Solve the following system of linear equations by finding the inverse of the coefficient matrix:\n\n$$\n\\{\\begin{aligned}2x+y-2z=-1 \\\\ 3x-z=5+3y \\\\ 3z-2y=6-x\\end{aligned}\n$$\n\nFind  $x+y+z.$" 13194139534755 17592186045417 true] [17592186435147 1072 #uuid "0807a9e2-ba3b-5d6e-8562-a580bc61f62a" 13194139534755 17592186045417 true] [17592186435147 1074 "First, let's rewrite the system in the correct order:\n\n$$\n\\{\\begin{aligned}2x+y-2z=-1 \\\\ 3x-3y-z=5 \\\\ x-2y+3z=6\\end{aligned}\n$$\n\nNext, we  write the system in the form $Ax=b$, where $A$ is a $3\\times 3$ matrix and $x$ and $b$ are $3\\times 1$ column vectors. We can do this as follows:\n\n$$\n[\\begin{aligned}2 & 1 & -2 \\\\ 3 & -3 & -1 \\\\ 1 & -2 & 3\\end{aligned}][\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}-1 \\\\ 5 \\\\ 6\\end{aligned}].\n$$\n\nNow, the solution to $Ax=b$ is given by $x={A}^{-1}b.$ So, we compute ${A}^{-1}$ as follows:\n\n*Step 1:*\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}2 & 1 & -2 \\\\ 3 & -3 & -1 \\\\ 1 & -2 & 3\\end{aligned}| \\\\  & =2|\\begin{aligned}-3 & -1 \\\\ -2 & 3\\end{aligned}|-1|\\begin{aligned}3 & -1 \\\\ 1 & 3\\end{aligned}|+(-2)|\\begin{aligned}3 & -3 \\\\ 1 & -2\\end{aligned}| \\\\  & =2(-9-2)-(9+1)-2(-6+3) \\\\  & =-22-10+6 \\\\  & =-26.\\end{aligned}\n$$\n\n*Step 2:*\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}|\\begin{aligned}-3 & -1 \\\\ -2 & 3\\end{aligned}| & |\\begin{aligned}3 & -1 \\\\ 1 & 3\\end{aligned}| & |\\begin{aligned}3 & -3 \\\\ 1 & -2\\end{aligned}| \\\\ |\\begin{aligned}1 & -2 \\\\ -2 & 3\\end{aligned}| & |\\begin{aligned}2 & -2 \\\\ 1 & 3\\end{aligned}| & |\\begin{aligned}2 & 1 \\\\ 1 & -2\\end{aligned}| \\\\ |\\begin{aligned}1 & -2 \\\\ -3 & -1\\end{aligned}| & |\\begin{aligned}2 & -2 \\\\ 3 & -1\\end{aligned}| & |\\begin{aligned}2 & 1 \\\\ 3 & -3\\end{aligned}|\\end{aligned}] \\\\  & =[\\begin{aligned}-11 & 10 & -3 \\\\ -1 & 8 & -5 \\\\ -7 & 4 & -9\\end{aligned}].\\end{aligned}\n$$\n\n*Step 3:*\n\n$$\nC=[\\begin{aligned}-11 & -10 & -3 \\\\ 1 & 8 & 5 \\\\ -7 & -4 & -9\\end{aligned}].\n$$\n\n*Step 4:*\n\n$$\n{C}^{T}=[\\begin{aligned}-11 & 1 & -7 \\\\ -10 & 8 & -4 \\\\ -3 & 5 & -9\\end{aligned}].\n$$\n\n*Step 5:*\n\n$$\n{A}^{-1}=\\frac{1}{det(A)}{C}^{T}=-\\frac{1}{26}[\\begin{aligned}-11 & 1 & -7 \\\\ -10 & 8 & -4 \\\\ -3 & 5 & -9\\end{aligned}].\n$$\n\nFinally, the solution to the given system is\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =-\\frac{1}{26}[\\begin{aligned}-11 & 1 & -7 \\\\ -10 & 8 & -4 \\\\ -3 & 5 & -9\\end{aligned}][\\begin{aligned}-1 \\\\ 5 \\\\ 6\\end{aligned}] \\\\  & =-\\frac{1}{26}[\\begin{aligned}-26 \\\\ 26 \\\\ -26\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, $x+y+z=1-1+1=1.$" 13194139534755 17592186045417 true] [17592186435148 1068 #edb/ref 17592186435144 13194139534755 17592186045417 true] [17592186435148 1069 "q-78565" 13194139534755 17592186045417 true] [17592186435148 1070 #edb/ref 17592186045486 13194139534755 17592186045417 true] [17592186435148 1071 "Consider a matrix equation $B\\,x=A\\,d,$ where $A$ and $B$ are $2\\times 2$ non-singular matrices, while $x$ and $d$ are $2\\times 1$ column vectors. Solve the equation for $x.$" 13194139534755 17592186045417 true] [17592186435148 1072 #uuid "0c58ffa5-e4d4-5bf5-8b35-8a71f48534ba" 13194139534755 17592186045417 true] [17592186435148 1074 "Since $B$ is not singular, it must have an inverse ${B}^{-1}.$ Now, pre-multiplying both sides of the equation $B\\,x=A\\,d$ by ${B}^{-1},$ we obtain\n\n$$\n\\begin{aligned}B\\,x & =A\\,d \\\\ {B}^{-1}B\\,x & ={B}^{-1}A\\,d \\\\ {I}_{2}\\,x & ={B}^{-1}A\\,d \\\\ x & ={B}^{-1}A\\,d.\\end{aligned}\n$$" 13194139534755 17592186045417 true] [17592186435149 1068 #edb/ref 17592186435145 13194139534755 17592186045417 true] [17592186435149 1069 "q-78553" 13194139534755 17592186045417 true] [17592186435149 1070 #edb/ref 17592186045485 13194139534755 17592186045417 true] [17592186435149 1071 "Consider the following system of linear equations:\n\n$$\n\\{\\begin{aligned}3x+2y+z=3 \\\\ x-2y+z=1 \\\\ 2x-y+2z=5\\end{aligned}\n$$\n\nThe system above has the matrix representation $Ax=b.$ Given that $x=⟨x,y,z⟩$ is unique, what is the value of $x+y+z?$ \n\n*Hint: The inverse of the coefficient matrix is given by*\n\n$$\n\\,{A}^{-1}=-\\frac{1}{6}[\\begin{aligned}-3 & -5 & 4 \\\\ 0 & 4 & -2 \\\\ 3 & 7 & -8\\end{aligned}].\n$$" 13194139534755 17592186045417 true] [17592186435149 1072 #uuid "e321af2f-d67a-5dc4-a077-c6060845ea99" 13194139534755 17592186045417 true] [17592186435149 1074 "First, let's write our system in matrix form as follows:\n\n$$\n\\begin{aligned}Ax & =b \\\\ [\\begin{aligned}3 & 2 & 1 \\\\ 1 & -2 & 1 \\\\ 2 & -1 & 2\\end{aligned}][\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}3 \\\\ 1 \\\\ 5\\end{aligned}]\\end{aligned}\n$$\n\nRecall that the solution to $Ax=b$ is given by $x={A}^{-1}b.$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =-\\frac{1}{6}[\\begin{aligned}-3 & -5 & 4 \\\\ 0 & 4 & -2 \\\\ 3 & 7 & -8\\end{aligned}][\\begin{aligned}3 \\\\ 1 \\\\ 5\\end{aligned}] \\\\  & =[\\begin{aligned}-1 \\\\ 1 \\\\ 4\\end{aligned}].\\end{aligned}\n$$\n\nSo, the solution is $x=-1,y=1,z=4.$\n\nFinally, $x+y+z=-1+1+4=4.$" 13194139534755 17592186045417 true]] :edb/tempids {"answer-039d5f33-dfa0-51c2-93be-2b7000137d8a" 17592186435129 "answer-0597b830-4974-5289-8d3c-e5ddb2d894f7" 17592186435130 "answer-274c794a-3cbb-5dc2-bbb2-1f1131f70f1e" 17592186435131 "answer-28126022-8f20-5f62-8417-0685db76f23b" 17592186435132 "answer-3a64a01b-e02d-535d-a027-6746b0121352" 17592186435133 "answer-3b9511ec-b4f9-5c7b-b596-beebd0bcb054" 17592186435134 "answer-4fc306a8-65be-5769-9f23-972df29a47cd" 17592186435135 "answer-7539810a-78b4-56d6-8b1e-ddb5c34343c1" 17592186435136 "answer-8afcf5b9-6023-5abe-9e32-15e5a0353825" 17592186435137 "answer-b14cf1e4-785f-5b17-867e-45e5d7cc5a9f" 17592186435138 "answer-b90c4ae0-c1ef-52b6-b3de-1cbcb9e94c5e" 17592186435139 "answer-d60be700-46fb-5903-a3f8-cfb1794eaf06" 17592186435140 "answer-e12ef937-d966-5968-a2bc-5cb307c85739" 17592186435141 "answer-ed96fe73-3