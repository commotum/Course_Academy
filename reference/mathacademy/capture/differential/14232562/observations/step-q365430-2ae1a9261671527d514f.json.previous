  "html": "<div id=\"step-q365430\" class=\"step questionWidget\" style=\"display: block;\"><div class=\"questionWidget-header\"><div class=\"questionWidget-title\">Question 4</div><div class=\"questionWidget-helpButton\">?</div></div><div class=\"questionWidget-text\"><table rules=\"all\" cellpadding=\"10\" align=\"center\" style=\"border:1px solid black; margin: auto; margin-bottom: 4mm; margin-top: 4mm\">\n<tbody><tr>\n<td width=\"30\" bgcolor=\"#D6EAF8\" style=\"text-align:center\"><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"-1\" ctxtmenu_counter=\"82\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D465 TEX-I\"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math></mjx-assistive-mml></mjx-container></td>\n<td width=\"30\" style=\"text-align:center\"><b><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"-1\" ctxtmenu_counter=\"83\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c33\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn></math></mjx-assistive-mml></mjx-container></b></td>\n<td width=\"30\" style=\"text-align:center\"><b><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"-1\" ctxtmenu_counter=\"84\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c35\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5</mn></math></mjx-assistive-mml></mjx-container></b></td>\n<td width=\"30\" style=\"text-align:center\