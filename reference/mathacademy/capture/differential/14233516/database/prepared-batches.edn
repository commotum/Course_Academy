atio \n\n$$\nr=\\frac{{a}_{n+1}}{{a}_{n}}=2.\n$$\n\nSince $|r|=2>1$, the sequence diverges."] ["question-6b244d67-f2e6-5997-9db2-2abb0586d4be" :question/difficulty :question.difficulty/easy] ["answer-field-4eef3b91-cbf1-5165-b4b4-6db1ea5e763f" :answer-field/id #uuid "4eef3b91-cbf1-5165-b4b4-6db1ea5e763f"] ["answer-f4d729f2-8517-5f08-b3f8-1bda0315fedc" :answer/id #uuid "f4d729f2-8517-5f08-b3f8-1bda0315fedc"] ["answer-f4d729f2-8517-5f08-b3f8-1bda0315fedc" :answer/type :answer.type/text] ["answer-f4d729f2-8517-5f08-b3f8-1bda0315fedc" :answer/value "Converges to $-4$"] ["answer-6cdc885e-37b4-5a68-a0b9-c54691be5651" :answer/id #uuid "6cdc885e-37b4-5a68-a0b9-c54691be5651"] ["answer-6cdc885e-37b4-5a68-a0b9-c54691be5651" :answer/type :answer.type/text] ["answer-6cdc885e-37b4-5a68-a0b9-c54691be5651" :answer/value "Converges to $0$"] ["answer-43955b41-f6e8-5349-9111-56dd4e7126c8" :answer/id #uuid "43955b41-f6e8-5349-9111-56dd4e7126c8"] ["answer-43955b41-f6e8-5349-9111-56dd4e7126c8" :answer/type :answer.type/text] ["answer-43955b41-f6e8-5349-9111-56dd4e7126c8" :answer/value "Converges to $2$"] ["answer-ba63283c-6ba0-5b52-bd92-e677158a64ba" :answer/id #uuid "ba63283c-6ba0-5b52-bd92-e677158a64ba"] ["answer-ba63283c-6ba0-5b52-bd92-e677158a64ba" :answer/type :answer.type/text] ["answer-ba63283c-6ba0-5b52-bd92-e677158a64ba" :answer/value "Converges to $\\frac{1}{2}$"] ["answer-a6fb9534-7b00-51a6-9b6b-3e0661951505" :answer/id #uuid "a6fb9534-7b00-51a6-9b6b-3e0661951505"] ["answer-a6fb9534-7b00-51a6-9b6b-3e0661951505" :answer/type :answer.type/text] ["answer-a6fb9534-7b00-51a6-9b6b-3e0661951505" :answer/value "The sequence diverges"] ["answer-field-4eef3b91-cbf1-5165-b4b4-6db1ea5e763f" :answer-field/key "selection"] ["answer-field-4eef3b91-cbf1-5165-b4b4-6db1ea5e763f" :answer-field/type :answer-field.type/radio] ["answer-field-4eef3b91-cbf1-5165-b4b4-6db1ea5e763f" :answer-field/correct "answer-a6fb9534-7b00-51a6-9b6b-3e0661951505"] ["answer-field-4eef3b91-cbf1-5165-b4b4-6db1ea5e763f"