#{[{:db/id #edb/ref 17592186554583 :knowledge-point/_questions [{:db/id #edb/ref 17592186096744 :knowledge-point/id #uuid "e4380b34-0502-552b-b94f-e121eb855f1d" :knowledge-point/title "Determining Convergence Behavior of Geometric Sequences Written Recursively"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43955b41-f6e8-5349-9111-56dd4e7126c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $2$" :db/id #edb/ref 17592186553994} {:answer/id #uuid "6cdc885e-37b4-5a68-a0b9-c54691be5651" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $0$" :db/id #edb/ref 17592186554082} {:answer/id #uuid "a6fb9534-7b00-51a6-9b6b-3e0661951505" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The sequence diverges" :db/id #edb/ref 17592186554238} {:answer/id #uuid "ba63283c-6ba0-5b52-bd92-e677158a64ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $\\frac{1}{2}$" :db/id #edb/ref 17592186554273} {:answer/id #uuid "f4d729f2-8517-5f08-b3f8-1bda0315fedc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $-4$" :db/id #edb/ref 17592186554399}] :answer-field/correct {:answer/id #uuid "a6fb9534-7b00-51a6-9b6b-3e0661951505" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The sequence diverges" :db/id #edb/ref 17592186554238} :answer-field/id #uuid "4eef3b91-cbf1-5165-b4b4-6db1ea5e763f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554458}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6b244d67-f2e6-5997-9db2-2abb0586d4be" :question/math-academy-id "q-123333" :question/problem "Consider the following geometric sequence:\n\n$$\n{a}_{n+1}=2{a}_{n},\\,{a}_{1}=-4,\\,n\\ge 1\n$$\n\nDetermine whether the sequence is convergent or divergent. If it converges, find the limit." :question/worked-solution "Suppose we have a geometric sequence with the first term ${a}_{1}$ and common ratio $r.$ Then, we have the following convergence properties:\n\n- if $|r|<1,$ the sequence is convergent and converges to $0$\n\n- if $|r|>1,$ the sequence is divergent\n\nMoreover, we have the following edge cases:\n\n- if $r=1,$ the sequence is convergent and converges to ${a}_{1}$\n\n- if $r=-1,$ the sequence is divergent\n\nThe given sequence is a geometric sequence with the common ratio \n\n$$\nr=\\frac{{a}_{n+1}}{{a}_{n}}=2.\n$$\n\nSince $|r|=2>1$, the sequence diverges."}] [{:db/id #edb/ref 17592186554596 :knowledge-point/_questions [{:db/id #edb/ref 17592186096744 :knowledge-point/id #uuid "e4380b34-0502-552b-b94f-e121eb855f1d" :knowledge-point/title "Determining Convergence Behavior of Geometric Sequences Written Recursively"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d1a1119-11c9-535c-a456-e45cc9d7de82" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $0$" :db/id #edb/ref 17592186553896} {:answer/id #uuid "55d44151-35f1-54c2-9d4d-cb890968345b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $-1$" :db/id #edb/ref 17592186554035} {:answer/id #uuid "c9f1522c-e116-5be3-a536-f1ce7ed8e514" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $4$" :db/id #edb/ref 17592186554313} {:answer/id #uuid "e0c72dcf-0cfe-526c-b0ed-899e73f67e02" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The sequence diverges" :db/id #edb/ref 17592186554356} {:answer/id #uuid "f0d2babb-cf96-5a12-b155-7886cd64321e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $-\\frac{1}{4}$" :db/id #edb/ref 17592186554391}] :answer-field/correct {:answer/id #uuid "e0c72dcf-0cfe-526c-b0ed-899e73f67e02" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The sequence diverges" :db/id #edb/ref 17592186554356} :answer-field/id #uuid "77095092-5c7c-58b9-9d24-8f2368d8a83f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554479}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8875866b-8dd0-5b03-ad00-243a32baa5f0" :question/math-academy-id "q-123334" :question/problem "Consider the following geometric sequence:\n\n$$\n{a}_{n+1}=4{a}_{n},\\,{a}_{1}=-\\frac{1}{4},\\,n\\ge 1\n$$\n\nDetermine whether the sequence is convergent or divergent. If it converges, find the limit." :question/worked-solution "Suppose we have a geometric sequence with the first term ${a}_{1}$ and common ratio $r.$ Then, we have the following convergence properties:\n\n- if $|r|<1,$ the sequence is convergent and converges to $0$\n\n- if $|r|>1,$ the sequence is divergent\n\nMoreover, we have the following edge cases:\n\n- if $r=1,$ the sequence is convergent and converges to ${a}_{1}$\n\n- if $r=-1,$ the sequence is divergent\n\nThe given sequence is a geometric sequence with the common ratio \n\n$$\nr=\\frac{{a}_{n+1}}{{a}_{n}}=4.\n$$\n\nSince $|r|=4>1$, the sequence diverges."}] [{:db/id #edb/ref 17592186554601 :knowledge-point/_questions [{:db/id #edb/ref 17592186096796 :knowledge-point/id #uuid "5986f765-9036-5124-a498-bd898119c9c5" :knowledge-point/title "Determining Whether a Geometric Sequence Converges Given the Nth Term"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56ac1be1-fce4-5b14-a773-c0df14c2a9b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $2$" :db/id #edb/ref 17592186554039} {:answer/id #uuid "6417f28a-8f7f-5ecc-be6c-7c8da2415e24" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $\\frac{1}{2}$" :db/id #edb/ref 17592186554064} {:answer/id #uuid "8301edff-e58a-593a-be70-3f68ef33e5f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The sequence diverges" :db/id #edb/ref 17592186554133} {:answer/id #uuid "8435d0e8-40cd-5cd4-89d6-083368872674" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $0.$" :db/id #edb/ref 17592186554139} {:answer/id #uuid "8f866f3c-7689-5311-b7e1-0b559c9e9370" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $4$" :db/id #edb/ref 17592186554176}] :answer-field/correct {:answer/id #uuid "8435d0e8-40cd-5cd4-89d6-083368872674" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $0.$" :db/id #edb/ref 17592186554139} :answer-field/id #uuid "dbf8a36f-7f35-538f-b598-e5154c361dd2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554523}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8f0ee2b9-8191-5f49-b4c7-7195eb067ecb" :question/math-academy-id "q-141404" :question/problem "Does the sequence ${a}_{n}=4{(\\frac{1}{2})}^{n-1}$ for $n\\ge 1$ \nconverge or diverge? If it converges, what is its limit?" :question/worked-solution "Suppose we have a geometric sequence with the first term ${a}_{1}$ and common ratio $r.$ Then, we have the following convergence properties:\n\n- if $|r|<1,$ the sequence is convergent and converges to $0$\n\n- if $|r|>1,$ the sequence is divergent\n\nMoreover, we have the following edge cases:\n\n- if $r=1,$ the sequence is convergent and converges to ${a}_{1}$\n\n- if $r=-1,$ the sequence is divergent\n\nThe given sequence ${a}_{n}=4{(\\frac{1}{2})}^{n-1}$ is a geometric sequence with the common ratio $r=\\frac{1}{2}.$ \n\nSince $|r|<1,$ the sequence converges to $0.$"}] [{:db/id #edb/ref 17592186554567 :knowledge-point/_questions [{:db/id #edb/ref 17592186096796 :knowledge-point/id #uuid "5986f765-9036-5124-a498-bd898119c9c5" :knowledge-point/title "Determining Whether a Geometric Sequence Converges Given the Nth Term"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e72f358-8b3c-5fa0-a87f-b5c3e703b4d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The sequence diverges" :db/id #edb/ref 17592186553923} {:answer/id #uuid "22b7211e-dd6c-5a3e-88e8-d3edd2915633" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $0$" :db/id #edb/ref 17592186553929} {:answer/id #uuid "6d1afbe3-f463-50af-b060-99529ce98d35" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $\\frac{2}{3}$" :db/id #edb/ref 17592186554083} {:answer/id #uuid "909b2006-2b10-5c79-9d1c-af317380a62c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $2$" :db/id #edb/ref 17592186554182} {:answer/id #uuid "9c753113-557c-5b1c-8957-36be50789e48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $\\frac{4}{3}$" :db/id #edb/ref 17592186554212}] :answer-field/correct {:answer/id #uuid "22b7211e-dd6c-5a3e-88e8-d3edd2915633" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $0$" :db/id #edb/ref 17592186553929} :answer-field/id #uuid "5521173e-4fd0-569c-b113-b91da149682d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554462}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "41a5c3bd-58e0-5924-89f4-127ab078d31e" :question/math-academy-id "q-141408" :question/problem "Does the sequence ${a}_{n}=2{(\\frac{2}{3})}^{n}$ for $n\\ge 1$ \nconverge or diverge? If it converges, what is its limit?" :question/worked-solution "Suppose we have a geometric sequence with the first term ${a}_{1}$ and common ratio $r.$ Then, we have the following convergence properties:\n\n- if $|r|<1,$ the sequence is convergent and converges to $0$\n\n- if $|r|>1,$ the sequence is divergent\n\nMoreover, we have the following edge cases:\n\n- if $r=1,$ the sequence is convergent and converges to ${a}_{1}$\n\n- if $r=-1,$ the sequence is divergent\n\nThe given sequence ${a}_{n}=2{(\\frac{2}{3})}^{n}$ is a geometric sequence with the common ratio $r=\\frac{2}{3}.$ \n\nSince $|r|<1,$ the sequence converges to $0.$"}] [{:db/id #edb/ref 17592186097236 :knowledge-point/_questions [{:db/id #edb/ref 17592186096744 :knowledge-point/id #uuid "e4380b34-0502-552b-b94f-e121eb855f1d" :knowledge-point/title "Determining Convergence Behavior of Geometric Sequences Written Recursively"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a4b751e1-2690-566a-8d59-1bf7bcdc09c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $5$" :db/id #edb/ref 17592186095341} {:answer/id #uuid "bf4bd6a7-89b1-58be-92f1-e02d983de0c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $\\frac{2}{3}$" :db/id #edb/ref 17592186095342} {:answer/id #uuid "fe9db267-0789-594f-b053-f9a128344946" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The sequence diverges" :db/id #edb/ref 17592186095343} {:answer/id #uuid "136f2048-5a19-5273-b2d9-93d3126c405d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $0$" :db/id #edb/ref 17592186095344} {:answer/id #uuid "7ff7d36a-2462-5f79-9079-fd54b8c9a26e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $-\\frac{2}{3}$" :db/id #edb/ref 17592186095345}] :answer-field/correct {:answer/id #uuid "136f2048-5a19-5273-b2d9-93d3126c405d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $0$" :db/id #edb/ref 17592186095344} :answer-field/id #uuid "7ccc59c6-df91-53a0-b02a-f0cfa5848876" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186095340}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b6bc5be2-67de-545d-b0ff-52b4105c5d45" :question/math-academy-id "q-40234" :question/problem "Consider the following geometric sequence:\n\n$$\n{a}_{n+1}=-\\frac{2}{3}{a}_{n},\\,{a}_{1}=5,\\,n\\ge 1\n$$\n\nDetermine whether the sequence is convergent or divergent. If it converges, find the limit." :question/worked-solution "Suppose we have a geometric sequence with the first term ${a}_{1}$ and common ratio $r.$ Then, we have the following convergence properties:\n\n- if $|r|<1,$ the sequence is convergent and converges to $0$\n\n- if $|r|>1,$ the sequence is divergent\n\nMoreover, we have the following edge cases:\n\n- if $r=1,$ the sequence is convergent and converges to ${a}_{1}$\n\n- if $r=-1,$ the sequence is divergent\n\nThe given sequence is a geometric sequence with the common ratio \n\n$$\nr=\\frac{{a}_{n+1}}{{a}_{n}}=-\\frac{2}{3}.\n$$\n\nSince $|r|=\\frac{2}{3}<1$, the sequence converges to $0.$"}]}
