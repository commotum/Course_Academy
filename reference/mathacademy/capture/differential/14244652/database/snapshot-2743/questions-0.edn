b/ident :answer-field.type/radio} :db/id #edb/ref 17592186562350}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a24bba0b-6082-5434-98a9-2578424db732" :question/math-academy-id "q-106279" :question/problem "What is the range of the function $f(x)=\\frac{1}{2}(x-8)^{2}-18?$" :question/worked-solution "The parabola is written in vertex form, \n\n$$\ny=a(x-h)^{2}+k,\n$$\n\nwhere $a$ is the leading coefficient and $(h,k)$ is the vertex. \n\n- Since $h=8$ and $k=-18,$ the vertex is $(8,-18).$\n\n- Since $a=\\frac{1}{2}>0,$ the parabola opens upwards.\n\nBecause the parabola opens upwards, there is no maximum output, and the vertex corresponds to the minimum output. \n\nTherefore, the range is $[-18,\\infty ).$\n\nThe corresponding diagram is shown below.\n\n![](images/a1/a115822cf26b79f0b25ed5493f5951c71c02c6ef5a4d576d101b4bc580d5da9f.png)"}] [{:db/id #edb/ref 17592186562403 :knowledge-point/_questions [{:db/id #edb/ref 17592186124659 :knowledge-point/id #uuid "b1bc2396-f949-57a0-be50-d5606abe3372" :knowledge-point/title "Finding the Range of a Parabola Given in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0541d29e-1a3d-5725-a3e8-30e78b5ddec7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[-2,\\infty )" :db/id #edb/ref 17592186561596} {:answer/id #uuid "6e2f1db6-cccc-5d24-9a2d-142ff1ee9a9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\infty ,1]" :db/id #edb/ref 17592186561856} {:answer/id #uuid "9d4e9999-7fc5-563b-b703-5c6492439ade" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[-1,\\infty )" :db/id #edb/ref 17592186561970} {:answer/id #uuid "a1fd0b4a-458f-56d9-a72b-4fcec594a2bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[2,\\infty )" :db/id #edb/ref 17592186561987} {:answer/id #uuid "d93ed979-a31a-5d1a-a93c-591126feb602" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\infty ,-2]" :db/id #edb/ref 17592186562125}] :answer-field/correct {:answer/id #uuid "a1fd0b4a-458f-56d9-a72b-4fcec594a2bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[2,\\infty )" :db/id #edb/ref 17592186561987} :answer-field/id #uuid "fc73fd49-ad93-51ca-81e7-7caa58db6c5f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186562381}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "16afc9a4-390c-580b-b4f5-9f8ca64be1a7" :question/math-academy-id "q-154270" :question/problem "What is the range of the function $f(x)=3{x}^{2}-6x+5?$" :question/worked-solution "The given parabola is written in standard form,\n\n$$\ny=a{x}^{2}+bx+c,\n$$\n\nwith $a=3>0,$ $b=-6,$ and $c=5.$\n\nBecause the leading coefficient is positive, the parabola opens upward. Consequently, there is no maximum output, and the vertex corresponds to the minimum output.\n\nThe $x$-coordinate of the vertex is given by\n\n$$\nx=-\\frac{b}{2a}=-\\frac{(-6)}{2\\cdot 3}=1.\n$$\n\nNow, we substitute $x=1$ back into the function to find the $y$-value of the vertex:\n\n$$\n\\begin{aligned}y & =3{x}^{2}-6x+5 \\\\  & =3(1)^{2}-6(1)+5 \\\\  & =3-6+5 \\\\  & =2\\end{aligned}\n$$\n\nTherefore, the vertex is $(1,2),$ and the range of the function is $[2,\\infty ).$\n\n![](images/91/915c1435f78f8a5f85a104b40d9ee83c54c218f8e81b6ea7fc051367055fc624.png)"}] [{:db/id #edb/ref 17592186562475 :knowledge-point/_questions [{:db/id #edb/ref 17592186124584 :knowledge-point/id #uuid "56d457de-8511-5870-98e3-b81e72e60585" :knowledge-point/title "Finding the Range of a Parabola Given in Vertex Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b0550c3e-d926-5110-81d5-70fdbb769ee0" :answer/type 