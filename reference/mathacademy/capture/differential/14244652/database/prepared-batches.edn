x}_{2}}{2}=\\frac{1+4}{2}=\\frac{5}{2}\\end{aligned}\n$$\n\nThen, we substitute $x=\\frac{5}{2}$ back into the function to find the $y$-value of the vertex:\n\n$$\n\\begin{aligned}y & =-4(x-1)(x-4) \\\\  & =-4(\\frac{5}{2}-1)(\\frac{5}{2}-4) \\\\  & =-4\\cdot \\frac{3}{2}\\cdot (-\\frac{3}{2}) \\\\  & =9\\end{aligned}\n$$\n\nTherefore, the vertex is $(\\frac{5}{2},9),$ and the range of the function is $(-\\infty ,9],$ i.e. $-\\infty <f(x)\\le 9.$\n\n![](images/70/70dc863f5f089c9434d783495c31b77fd7a0ac84a852d2b32222b445f463efe3.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-e7e6e4e4-ba72-5524-86c2-1327a0ed5696" "answer-field-35f138a0-b129-5c92-b044-9a7f9862134f" "answer-field-3cb408db-786a-5b26-a5af-0f25b4b11d35"] :db/ensure [:question/validate]} {:db/id "answer-field-e7e6e4e4-ba72-5524-86c2-1327a0ed5696" :answer-field/id #uuid "e7e6e4e4-ba72-5524-86c2-1327a0ed5696" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-cf0f59aa-7331-50e4-b1d5-d86e0389fe30" :answer-field/choices ["answer-cf0f59aa-7331-50e4-b1d5-d86e0389fe30"] :db/ensure [:answer-field/validate]} {:db/id "answer-cf0f59aa-7331-50e4-b1d5-d86e0389fe30" :answer/id #uuid "cf0f59aa-7331-50e4-b1d5-d86e0389fe30" :answer/type :answer.type/math :answer/value "-\\infty" :db/ensure [:answer/validate]} {:db/id "answer-field-35f138a0-b129-5c92-b044-9a7f9862134f" :answer-field/id #uuid "35f138a0-b129-5c92-b044-9a7f9862134f" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-3c44ff17-61f3-54f4-b363-ea1bd3f109e0" :answer-field/choices ["answer-3c44ff17-61f3-54f4-b363-ea1bd3f109e0"] :db/ensure [:answer-field/validate]} {:db/id "answer-3c44ff17-61f3-54f4-b363-ea1bd3f109e0" :answer/id #uuid "3c44ff17-61f3-54f4-b363-ea1bd3f109e0" :answer/type :answer.type/math :answer/value "<" :db/ensure [:answer/validate]} {:db/id "answer-field-3cb408db-786a-5b26-a5af-0f25b4b11d35" :answer-field/