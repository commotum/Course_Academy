swer.type/math} :answer/value "[1,\\infty )" :db/id #edb/ref 17592186549401} {:answer/id #uuid "3342ac6c-a5ac-505a-9057-009d9aaad1b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[0,\\infty )" :db/id #edb/ref 17592186549425} {:answer/id #uuid "720e13e8-4fcd-54db-bf77-f1e56dad5e3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\infty ,1]" :db/id #edb/ref 17592186549534} {:answer/id #uuid "d04a0586-14b1-51f8-9ee4-74197f142b62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[-1,\\infty )" :db/id #edb/ref 17592186549703} {:answer/id #uuid "f8afb740-92b1-5a27-9a61-bb974a1e4d6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\infty ,0]" :db/id #edb/ref 17592186549784}] :answer-field/correct {:answer/id #uuid "28ae418f-d853-574e-aad6-2711015f76d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[1,\\infty )" :db/id #edb/ref 17592186549401} :answer-field/id #uuid "8696ee0d-200e-5d5f-b4a1-875cd5516de8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186549862}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c749b226-6df0-583d-9d39-da82636ab3b6" :question/math-academy-id "q-90975" :question/problem "What is the range of the function $f(x)={x}^{2}+1?$" :question/worked-solution "The given parabola is written in standard form,\n\n$$\ny=a{x}^{2}+bx+c,\n$$\n\nwith $a=1>0,$ $b=0,$ and $c=1.$\n\nBecause the leading coefficient is positive, the parabola opens upward. Consequently, there is no maximum output, and the vertex corresponds to the minimum output.\n\nThe $x$-coordinate of the vertex is given by\n\n$$\nx=-\\frac{b}{2a}=-\\frac{0}{2\\cdot 1}=0.\n$$\n\nNow, we substitute $x=0$ back into the function to find the $y$-value of the vertex:\n\n$$\n\\begin{aligned}y & ={x}^{2}+1 \\\\  & =(0)^{2}+1 \\\\  & =1\\end{aligned}\n$$\n\nTherefore, the vertex is $(0,1),$ and the range of the function is $[1,\\infty ).$\n\n![](images/0a/0a0bb7cbd5494106b36e85f4b9f2604153d28623883c33f507e1ef36389999c4.png)"}] [{:db/id #edb/ref 17592186561015 :knowledge-point/_questions [{:db/id #edb/ref 17592186124660 :knowledge-point/id #uuid "fb0d6e0e-bf61-5fe9-bf8a-ab15c5846e11" :knowledge-point/title "Finding the Range of a Parabola Given in Factored Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "332e1d80-7be9-5c06-af32-c685cf22b488" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[2,\\infty )" :db/id #edb/ref 17592186560478} {:answer/id #uuid "66edb060-6c48-5d86-bc94-ca07b3f6eff6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\infty ,\\frac{5}{4}]" :db/id #edb/ref 17592186560580} {:answer/id #uuid "7014d6a2-28c0-585c-9c3a-7254efaca4ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\infty ,2]" :db/id #edb/ref 17592186560602} {:answer/id #uuid "9bbe7726-805f-5ecb-9261-1dd23f6ff79a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\infty ,1]" :db/id #edb/ref 17592186560682} {:answer/id #uuid "c24bd33a-9854-52b8-8040-811faade6cfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{5}{4},\\infty )" :db/id #edb/ref 17592186560752}] :answer-field/correct {:answer/id #uuid "66edb060-6c48-5d86-bc94-ca07b3f6eff6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\infty ,\\frac{5}{4}]" :db/id #edb/ref 17592186560580} :answer-field/id #uuid "9e3ba704-088a-57fb-bc54-70440ac77e83" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186560931}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "723435c8-f6c2-5011-8005-6ac70ede7884" :question/math-academy-id "q-90983" :question/problem "What is the range of the function $f(x)=-5(x-1)(x-2)?$" :question/worked-solution "The given parabola is written in factored form,\n\n$$\ny=a(x-{x}_{1})(x-{x}_{2}),\n$$\n\nwith $a=-5<0.$ \n\nBecause the leading coefficient is negative, the parabola opens downward. Consequently, there is no minimum output, and the vertex corresponds to the maximum output.\n\nThe two roots of the parabola are ${x}_{1}=1$ and ${x}_{2}=2,$ and we can find the $x$-coordinate of the vertex by taking the average of the roots:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2}=\\frac{1+2}{2}=\\frac{3}{2}\\end{aligned}\n$$\n\nThen, we substitute $x=\\frac{3}{2}$ back into the function to find the $y$-value of the vertex:\n\n$$\n\\begin{aligned}y & =-5(x-1)(x-2) \\\\  & =-5(\\frac{3}{2}-1)(\\frac{3}{2}-2) \\\\  & =-5\\cdot \\frac{1}{2}\\cdot (-\\frac{1}{2}) \\\\  & =\\frac{5}{4}\\end{aligned}\n$$\n\nTherefore, the vertex is $(\\frac{3}{2},\\frac{5}{4}),$ and the range of the function is $(-\\infty ,\\frac{5}{4}].$\n\n![](images/42/426a8277921ca2c8282567eeb076c3dcf1f0f1c729c4ebd2e5d624f51b78d61e.png)"}]}
