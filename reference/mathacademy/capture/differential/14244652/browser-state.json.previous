"mjx-c34\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\" space=\"2\"><mjx-c class=\"mjx-c2212\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c35\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo stretchy=\"false\">(</mo><mo>−</mo><mn>4</mn><mo>,</mo><mo>−</mo><mn>5</mn><mo stretchy=\"false\">)</mo><mo>,</mo></math></mjx-assistive-mml></mjx-container> and the range of the function is <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"246\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c5B\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2212\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c35\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-n\" space=\"2\"><mjx-c class=\"mjx-c221E\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo stretchy=\"false\">[</mo><mo>−</mo><mn>5</mn><mo>,</mo><mi mathvariant=\"normal\">∞</mi><mo stretchy=\"false\">)</mo><mo>,</mo></math></mjx-assistive-mml></mjx-container> i.e. <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"247\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mstyle style=\"border: 1px solid lightgray;\"><mjx-mpadded><mjx-block style=\"width: 2.078em; margin: 0.4em 0px; position: relative;\"><mjx-rbox style=\"left: 0.4em; top: 0px; max-width: 2.078em;\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2212\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c35\"></mjx-c></mjx-mn></mjx-rbox></mjx-block></mjx-mpadded></mjx-mstyle><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2264\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-i\" space=\"4\"><mjx-c class=\"mjx-c1D453 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D465 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo><mjx-mstyle style=\"border: 1px solid lightgray;\" space=\"4\"><mjx-mpadded><mjx-block style=\"width: 1.578em; margin: 0.4em 0px; position: relative;\"><mjx-rbox style=\"left: 0.4em; top: 0px; max-width: 1.578em;\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c3C\"></mjx-c></mjx-mo></mjx-rbox></mjx-block></mjx-mpadded></mjx-mstyle><mjx-mstyle style=\"border: 1px solid lightgray;\" space=\"4\"><mjx-mpadded><mjx-block style=\"width: 1.8em; margin: 0.4em 0px; position: relative;\"><mjx-rbox style=\"left: 0.4em; top: 0px; max-width: 1.8em;\"><mjx-mi class=\"mjx-n\"><mjx-c class=\"mjx-c221E\"></mjx-c></mjx-mi></mjx-rbox></mjx-block></mjx-mpadded></mjx-mstyle><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mo>−</mo><mn>5</mn></mpadded></mstyle><mo>≤</mo><mi>f</mi><mo stretchy=\"false\">(</mo><mi>x</mi><mo stretchy=\"false\">)</mo><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mo>&lt;</mo></mpadded></mstyle><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mi mathvariant=\"normal\">∞</mi></mpadded></mstyle><mo>.</mo></math></mjx-assistive-mml></mjx-container></p>\n<div id=\"graphic-f772d37d8522e366122eb33efb5da9e6\" class=\"graphic\"><img src=\"/graphics/f772d37d8522e366122eb33efb5da9e6\"></div></div></div>",
