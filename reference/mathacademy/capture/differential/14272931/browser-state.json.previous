    "q-89271": {
      "dom_id": "step-q89271",
      "name": "Question 19",
      "problem": "Which expression form is equivalent to $(Q∨R)∧T?$",
      "worked_solution": "By the commutative law, $Q∨R≡R∨Q.$\n\nTherefore, $(Q∨R)∧T≡(R∨Q)∧T.$",
