    "q-82723": {
      "dom_id": "step-q82723",
      "name": "Question 15",
      "problem": "Simplify the following sentence: \"The marker is black or it is purple, or it is black.\"",
      "worked_solution": "Using the commutative law, we can replace the phrase \"the marker is black or it is purple\" with the phrase \"the marker is purple or it is black.\" The sentence now reads\n\n\"The marker is purple or it is black, or it is black.\"\n\nThen, using the associative law, we can move the comma:\n\n\"The marker is purple, or it is black or it is black.\"\n\nNow, we can simplify the phrase \"it is black or it is black\" to just \"it is black.\" The sentence now reads\n\n\"The marker is purple, or it is black.\"\n\nFinally, we can write the sentence more concisely:\n\n\"The marker is purple or black.\"",
      "calculator_instructions": "",
      "fields": [
        {
          "key": "selection",
          "type": "radio",
          "choices": [
            {
              "option": "a",
              "dom_id": "questionWidget-choiceLetterCircle-82723-a",
              "type": "text",
              "value": "The marker is purple or black.",
              "html": " The marker is purple or black."
            },
            {
              "option": "b",
              "dom_id": "questionWidget-choiceLetterCircle-82723-b",
              "type": "text",
              "value": "The marker is purple.",
              "html": " The marker is purple."
            },
            {
              "option": "c",
              "dom_id": "questionWidget-choiceLetterCircle-82723-c",
              "type": "text",
              "value": "The marker is purple and black.",
              "html": "The marker is purple and black."
            },
            {
              "option": "d",
              "dom_id": "questionWidget-choiceLetterCircle-82723-d",
              "type": "text",
              "value": "The marker is black.",
              "html": " The marker is black."
            },
            {
              "option": "e",
              "dom_id": "questionWidget-choiceLetterCircle-82723-e",
              "type": "text",
              "value": "The marker is black but not purple.",
              "html": " The marker is black but not purple."
            }
          ],
          "choices_complete": true
