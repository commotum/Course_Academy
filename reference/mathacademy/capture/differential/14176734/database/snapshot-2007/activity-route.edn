#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186495207} :activity/id #uuid "13caabb2-fccc-503a-88a9-84f1640d4d82" :activity/steps [{:db/id #edb/ref 17592186495177 :step/content {:db/id #edb/ref 17592186495050 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f14cc015-61de-559e-9d6e-4f7e934ed9c4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ln(2x)+1" :db/id #edb/ref 17592186494890}] :answer-field/correct {:db/id #edb/ref 17592186494890} :answer-field/id #uuid "a47a029c-812d-5ac8-b753-06da557530dc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186494995}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "02602311-35ef-53b7-9d8d-d64db15f3075" :question/math-academy-id "q-341724" :question/problem "Given that $y={(\\frac{1}{2x})}^{x}$, find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=-{(2x)}^{-x}\\cdot ($\n{{field-1}}$)$" :question/worked-solution "We have the function \n\n$$\ny={(\\frac{1}{2x})}^{x}.\n$$\n\nFirst, we take the natural logarithm of both sides:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡({(\\frac{1}{2x})}^{x}) \\\\ \\operatorname{ln}⁡y & =x\\operatorname{ln}⁡(\\frac{1}{2x})\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(x\\operatorname{ln}⁡(\\frac{1}{2x})) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =(x)^{′}\\cdot (\\operatorname{ln}⁡(\\frac{1}{2x}))+(x)\\cdot {(\\operatorname{ln}⁡(\\frac{1}{2x}))}^{′} \\\\ \\frac{1}{y}\\cdot {y}^{′} & =1\\cdot \\operatorname{ln}⁡(\\frac{1}{2x})+x\\cdot ((2x)\\cdot (-\\frac{2}{(2x)^{2}})) \\\\ \\frac{{y}^{′}}{y} & =\\operatorname{ln}⁡(\\frac{1}{2x})-1 \\\\ \\frac{{y}^{′}}{y} & =\\operatorname{ln}⁡1-\\operatorname{ln}⁡(2x)-1 \\\\ \\frac{{y}^{′}}{y} & =-(\\operatorname{ln}⁡(2x)+1)\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =-y(\\operatorname{ln}⁡(2x)+1)\\end{aligned}\n$$\n\nFinally, we substitute $y={(\\frac{1}{2x})}^{x}:$\n\n$$\n\\begin{aligned}{y}^{′} & =-{(\\frac{1}{2x})}^{x}(\\operatorname{ln}⁡(2x)+1) \\\\  & =-{(2x)}^{-x}\\cdot (\\operatorname{ln}⁡(2x)+1)\\end{aligned}\n$$"} :step/id #uuid "0324c12e-b94a-5be1-b1ff-869be8d13ba6" :step/next {:db/id #edb/ref 17592186495241}} {:db/id #edb/ref 17592186495180 :step/content {:db/id #edb/ref 17592186495110 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05f7eac3-f058-5133-9c8a-7faa8e159655" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Cube" :db/id #edb/ref 17592186494330} {:answer/id #uuid "15f20bf7-c743-53d2-a83f-5accca0ed01f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Rectangular pyramid" :db/id #edb/ref 17592186494358} {:answer/id #uuid "563bf08c-2a81-52d3-8917-c5e7faf405b6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Heptagonal pyramid" :db/id #edb/ref 17592186494494} {:answer/id #uuid "aeb1606b-2d4f-5bc5-b01d-187b5a6cb832" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Triangular prism" :db/id #edb/ref 17592186494724} {:answer/id #uuid "d70aba4d-dd6d-5861-888e-94192eb1fd09" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Triangular pyramid" :db/id #edb/ref 17592186494824}] :answer-field/correct {:db/id #edb/ref 17592186494358} :answer-field/id #uuid "48c22ba1-69cb-5865-8357-8ff9ef9b3c3a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186494951}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8bd4a768-e4d0-520a-9786-1699a6b9a16d" :question/math-academy-id "q-117652" :question/problem "![](images/b4/b420afa755a7cd99e427fc7c1aa06ea745f0a177fa83c60dff5a1bcd354c7b79.png)\n\nWhat is the name of the polyhedron shown above?" :question/worked-solution "The solid is a **rectangular pyramid** since it has a rectangular base and the other $4$ triangular faces meet at a single point.   \n\nAlso, notice that:\n\n- The solid is not a cube since not all of its faces are squares.\n\n- The solid is not a triangular prism because it does not have two triangular bases connected by parallel line segments.\n\n- The solid is not a triangular pyramid since its base is not triangular.\n\n- The solid is not a heptagonal pyramid since its base is not a heptagon."} :step/id #uuid "0652bdfd-fa6f-5685-a3ad-64b305fbd4aa"} {:db/id #edb/ref 17592186495183 :step/content {:db/id #edb/ref 17592186338736 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "564a9b9e-aab5-5b0f-93e8-ff25aa13561b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-40" :db/id #edb/ref 17592186336826} {:answer/id #uuid "74d85b4a-b12a-5c0f-b5ed-ff52586806e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "40" :db/id #edb/ref 17592186337084} {:answer/id #uuid "a8927049-3f50-5f32-81d8-ae0adb9041c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-30" :db/id #edb/ref 17592186337555} {:answer/id #uuid "c1b2cb1f-b916-5d6a-83bd-0b171941131c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-20" :db/id #edb/ref 17592186337754} {:answer/id #uuid "f8db2c98-cfca-5e9d-8c6d-040c9d9da0b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "30" :db/id #edb/ref 17592186338212}] :answer-field/correct {:db/id #edb/ref 17592186337555} :answer-field/id #uuid "21e0fd22-373d-5dc1-ac92-23af629fc5c1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186338341}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0e129d90-7991-5aeb-8e6d-b77b70757df7" :question/math-academy-id "q-69982" :question/problem "Find the determinant of the matrix \n$Q=[\\begin{aligned}5 & 2 & 0 & 5 \\\\ 2 & -4 & -4 & 0 \\\\ 0 & 1 & 3 & 0 \\\\ 0 & 0 & 3 & 0\\end{aligned}].$" :question/worked-solution "Notice that the $4$th column contains three zeros. So, using Laplace expansion along the $4$th column, we have\n\n$$\n\\begin{aligned}\\text{det}(Q) & =|\\begin{aligned}5 & 2 & 0 & 5 \\\\ 2 & -4 & -4 & 0 \\\\ 0 & 1 & 3 & 0 \\\\ 0 & 0 & 3 & 0\\end{aligned}| \\\\  & =5\\cdot (-1)^{1+4}|\\begin{aligned}2 & -4 & -4 \\\\ 0 & 1 & 3 \\\\ 0 & 0 & 3\\end{aligned}| \\\\  & =-5\\cdot |\\begin{aligned}2 & -4 & -4 \\\\ 0 & 1 & 3 \\\\ 0 & 0 & 3\\end{aligned}|\\end{aligned}\n$$\n\nThe determinant of a triangular matrix is equal to the product of the entries on the main diagonal. Therefore, we have\n\n$$\n\\begin{aligned}-5\\cdot |\\begin{aligned}2 & -4 & -4 \\\\ 0 & 1 & 3 \\\\ 0 & 0 & 3\\end{aligned}| & =-5\\cdot (2\\cdot 1\\cdot 3)=-30.\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\ndet(Q)=-30.\n$$"} :step/id #uuid "0eb6f0a5-3481-5dd3-8945-85328cc827e4" :step/next {:db/id #edb/ref 17592186495234}} {:db/id #edb/ref 17592186495207 :step/content {:db/id #edb/ref 17592186262854 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "69107280-70c4-5ca4-8b64-1e64450165b8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186448278} {:answer/id #uuid "4a3f6955-4016-59d3-9db9-3955354a9810" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186448279}] :answer-field/correct {:db/id #edb/ref 17592186448279} :answer-field/id #uuid "2ee137d6-1832-58d0-85d5-575e29a0fa26" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186449179} {:answer-field/choices [{:answer/id #uuid "29bde20c-189c-54ef-b19c-9e8950c65826" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186448280} {:answer/id #uuid "5a9158da-7221-5175-b881-fdd36f8f42ea" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186448281}] :answer-field/correct {:db/id #edb/ref 17592186448280} :answer-field/id #uuid "de466e8f-4f63-50c6-b72f-38c520f95211" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186449180} {:answer-field/choices [{:answer/id #uuid "a6c45389-9701-5934-b1ac-2f11edac2800" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186448282} {:answer/id #uuid "f20f2e0e-7487-58ee-9feb-810b44ca227a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186448283}] :answer-field/correct {:db/id #edb/ref 17592186448283} :answer-field/id #uuid "db9964be-6910-5d74-bd0f-7b3cfcffc16d" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186449181}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "364a18ef-2de8-57d7-9e2f-631eb4651446" :question/math-academy-id "q-127931" :question/problem "Let $A=[\\begin{aligned}1 & 3 \\\\ -1 & k\\end{aligned}]$ and $b=[\\begin{aligned}-1 \\\\ 1\\end{aligned}],$ where $k$ is a constant such that $k\\ne -3.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $det(A)\\ne 0$\n- **II.** $Ax=0$ has no solutions\n- **III.** The lines $x+3y=-1$ and $-x+ky=1$  intersect at exactly one point." :question/worked-solution "Recall that given $A=[\\begin{aligned}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{aligned}]$, then according to the invertible matrix theorem the following statements are equivalent:    \n\n- $A$ is invertible.\n\n- The system $Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b.$\n\n- The system $Ax=0$ has the unique zero solution.\n\n- The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.\n\n- $det(A)\\ne 0.$\n\nWith that in mind, let's now check our statements.\n\n- Statement I is true. We have \n\n$$\n\\begin{aligned}det(A) & =det[\\begin{aligned}1 & 3 \\\\ -1 & k\\end{aligned}] \\\\  & =1\\cdot k-(-1)\\cdot 3 \\\\  & =k+3.\\end{aligned}\n$$\n\nNotice that $k+3\\ne 0$ if $k\\ne -3.$\n\nNow, since the fifth part of the invertible matrix theorem is true, all the other parts of the theorem are true too. Therefore, according to the theorem:\n\n- Statement II is false. According to the third part of the invertible matrix theorem, the unique solution to  $Ax=0$ is the trivial one (zero).\n\n- Statement III is true by the fourth part of the invertible matrix theorem.\n\nFinally, only statements I and III are true."} :step/id #uuid "689407d4-8bdf-5693-abd3-42add8c4a1ee" :step/next {:db/id #edb/ref 17592186495183}} {:db/id #edb/ref 17592186495219 :step/content {:db/id #edb/ref 17592186495153 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21da8be1-01fa-5395-a6d1-693fba89579e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x}{-1}=\\frac{z+1}{9},\\,y=-5" :db/id #edb/ref 17592186494385} {:answer/id #uuid "553addc8-18e6-53d9-9334-7c785c7ad81b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x}{1}=\\frac{z-1}{9},\\,y=-5" :db/id #edb/ref 17592186494492} {:answer/id #uuid "6a750839-2164-533a-a44a-d12f1239ee58" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x-1}{1}=\\frac{z+1}{9},\\,y=5" :db/id #edb/ref 17592186494534} {:answer/id #uuid "85c6789f-ffce-5244-91d7-4630e5c1a765" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x}{2}=\\frac{z-1}{-9},\\,y=-5" :db/id #edb/ref 17592186494612} {:answer/id #uuid "a18e13dc-ae24-5ed7-8084-0bc94766af44" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x}{1}=\\frac{z+1}{9},\\,y=5" :db/id #edb/ref 17592186494686}] :answer-field/correct {:db/id #edb/ref 17592186494492} :answer-field/id #uuid "4525723d-b5cd-5648-a3e1-1f8bec32accd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186494947}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "dd432b0a-1c26-5d37-8911-e5b811490135" :question/math-academy-id "q-127462" :question/problem "Find the Cartesian equation for the line with the following vector equation:\n\n$$\nr=[\\begin{aligned}0 \\\\ -5 \\\\ 1\\end{aligned}]+t[\\begin{aligned}1 \\\\ 0 \\\\ 9\\end{aligned}],\\,t\\in (-\\infty ,\\infty )\n$$" :question/worked-solution "Using the usual formula, we get\n\n$$\n\\frac{x-0}{1}=\\frac{y-(-5)}{0}=\\frac{z-1}{9}=t,\\,t\\in (-\\infty ,\\infty ),\n$$\n\nor equivalently\n\n$$\n\\frac{x}{1}=\\frac{y+5}{0}=\\frac{z-1}{9},\n$$\n\nwhich is problematic because $\\frac{y+5}{0}$ involves division by zero.\n\nHowever, notice that in our line, the $y$ component always maintains the constant value of $y=-5:$\n\n$$\nr=[\\begin{aligned}t \\\\ -5 \\\\ 1+9t\\end{aligned}],\\,t\\in (-\\infty ,\\infty )\n$$\n\nSo, in the Cartesian equation, we remove the $\\frac{y+5}{0}$ part and instead write $y=-5,$ as follows:\n\n$$\n\\frac{x}{1}=\\frac{z-1}{9},\\,y=-5\n$$"} :step/id #uuid "810e4f83-f1a8-5169-93a1-8caa5795b4c4" :step/next {:db/id #edb/ref 17592186495177}} {:db/id #edb/ref 17592186495234 :step/content {:db/id #edb/ref 17592186495099 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "68c0ec99-c2fb-58f7-b7f5-fb61baf0c84f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{2}+\\frac{\\pi n}{2}" :db/id #edb/ref 17592186494528} {:answer/id #uuid "7d3756b0-b0a2-556a-be88-863ea77b203d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{4}+\\frac{\\pi n}{2}" :db/id #edb/ref 17592186494588} {:answer/id #uuid "8da11eb5-91be-5bf3-9fcf-acbbb9eaa5a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{2}+\\pi n" :db/id #edb/ref 17592186494639} {:answer/id #uuid "c6b7976b-3f51-5c07-8e0f-1d2e78e5cbc1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi n}{4}" :db/id #edb/ref 17592186494786} {:answer/id #uuid "cdf2e835-db95-5864-affb-01ff7cb2c729" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{4}+\\pi n" :db/id #edb/ref 17592186494807}] :answer-field/correct {:db/id #edb/ref 17592186494807} :answer-field/id #uuid "5e73b358-a22b-50ef-9592-ee78086917fe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186494958}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "743cb560-d24b-5701-9107-2d76831f26b0" :question/math-academy-id "q-162648" :question/problem "The domain of the vector-valued function $f(t)=\\operatorname{sin}⁡t\\,i+(1+t)\\,j+\\operatorname{cot}⁡(t-\\frac{\\pi }{4})\\,k$ is \n\n$$\nt\\in (-\\infty ,\\infty ),\\,t\\ne \\bbox[5pt,border:1pt solid black]{\\phantom{AAAAA}}.\n$$\n\nWhat is the missing expression? You may assume that $n$ is an integer." :question/worked-solution "To find the domain of $f$, we need the intersection of the domains of the individual components.\n\n- The domain of the 1st component $\\operatorname{sin}⁡t$ is $t\\in (-\\infty ,\\infty ).$\n\n- The domain of the 2nd component $1+t$ is $t\\in (-\\infty ,\\infty ).$\n\n- The domain of the 3rd component $\\operatorname{cot}⁡(t-\\frac{\\pi }{4})$ is $t\\in (-\\infty ,\\infty ),$ except for the values of $t$ for which\n\n$$\nt-\\frac{\\pi }{4}=\\pi n\\,⟹\\,t=\\frac{\\pi }{4}+\\pi n,\n$$\n\nwhere $n$ is an integer.\n\nTherefore, the domain of the vector-valued function $f(t)$ is \n\n$$\nt\\in (-\\infty ,\\infty ),\\,t\\ne \\frac{\\pi }{4}+\\pi n,\n$$\n\nwhere $n$ is an integer."} :step/id #uuid "a42c5902-0160-500d-8a18-e256bceaf29d" :step/next {:db/id #edb/ref 17592186495272}} {:db/id #edb/ref 17592186495241 :step/content {:db/id #edb/ref 17592186495152 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "77a2513c-453d-5a29-8fe9-2a67c6dc9c03" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186494577} {:answer/id #uuid "8a34feff-d7af-5be0-bb1e-052359fe25b4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186494627} {:answer/id #uuid "9fbd3cfe-59fd-5bb3-8ca5-8b31a8b5e03c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186494681} {:answer/id #uuid "a457dd93-1e88-5e06-a387-62d51340e2b2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186494692} {:answer/id #uuid "bee15731-1afa-57b9-a681-55ceed3bd405" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-7" :db/id #edb/ref 17592186494764}] :answer-field/correct {:db/id #edb/ref 17592186494692} :answer-field/id #uuid "76b6e9d4-78c1-58c7-893c-a4f2cb9f0a8d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186494968}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "dbb0dde9-c40d-5e25-859f-e2de0b0b8937" :question/math-academy-id "q-75605" :question/problem "An eigenvector of \n$A=[\\begin{aligned}1 & 0 \\\\ 5 & 7\\end{aligned}]$ \ncorresponding to an eigenvalue $\\lambda =3k-2$ is $[\\begin{aligned}-6 \\\\ 5k\\end{aligned}].$ Determine the value of $k.$" :question/worked-solution "Remember that the eigenvectors of $A$ are the non-zero vectors $v$ such that $Av=\\lambda v.$ So, we have\n\n$$\n\\begin{aligned}Av & =\\lambda v \\\\ [\\begin{aligned}1 & 0 \\\\ 5 & 7\\end{aligned}][\\begin{aligned}-6 \\\\ 5k\\end{aligned}] & =(3k-2)[\\begin{aligned}-6 \\\\ 5k\\end{aligned}] \\\\ [\\begin{aligned}-6 \\\\ -30+35k\\end{aligned}] & =[\\begin{aligned}-6(3k-2) \\\\ (5k)(3k-2)\\end{aligned}] \\\\ [\\begin{aligned}-6 \\\\ -30+35k\\end{aligned}] & =[\\begin{aligned}-18k+12 \\\\ 15{k}^{2}-10k\\end{aligned}].\\end{aligned}\n$$\n\nThis gives us the following system of linear equations:\n\n$$\n\\{\\begin{aligned}-6=-18k+12 \\\\ -30+35k=15{k}^{2}-10k\\end{aligned}\n$$\n\nSolving for $k$ in the first equation, we get\n\n$$\n-6=-18k+12\\,⟹\\,k=1.\n$$\n\nNow, substituting $k=1$ into the second equation, we get\n\n$$\n\\begin{aligned}-30+35k & =15{k}^{2}-10k \\\\ -30+35\\cdot 1 & =15\\cdot {1}^{2}-10\\cdot 1 \\\\ 5 & =5,\\end{aligned}\n$$\n\nwhich is a true statement.\n\nTherefore, the solution of the system is $k=1.$"} :step/id #uuid "b31bf352-35ca-5ad9-aed1-d941ecc84518" :step/next {:db/id #edb/ref 17592186495180}} {:db/id #edb/ref 17592186495272 :step/content {:db/id #edb/ref 17592186266023 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13016ec0-8156-589e-b39b-942c97ca1edf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186263181} {:answer/id #uuid "4ace33b3-69d8-5761-a1dd-efead09fb2d8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186263642} {:answer/id #uuid "60dec4b1-c098-5349-b8d9-90a530ef64b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186263835} {:answer/id #uuid "9087593d-b85f-524d-b8a4-0f0def706f8e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186264242} {:answer/id #uuid "b50e48ba-06d3-5a6a-927a-0e46fa9eaae5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186264560}] :answer-field/correct {:db/id #edb/ref 17592186263642} :answer-field/id #uuid "d9aa03e6-7fbd-5806-a04e-b966abc7083c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265623}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "06c2ebc8-9d9b-5ee7-87a8-a42672daac19" :question/math-academy-id "q-130958" :question/problem "Determine the number of pivot columns of the matrix $D,$ given by\n\n$$\nD=[\\begin{aligned}0 & 1 & 0 & 0 & 1 & 2 \\\\ 0 & 0 & -3 & 7 & 0 & 1 \\\\ 0 & 2 & 0 & 0 & -2 & 0\\end{aligned}].\n$$" :question/worked-solution "First, we need to convert $D$ to row echelon form:\n\n$$\n\\begin{aligned}D & =[\\begin{aligned}0 & 1 & 0 & 0 & 1 & 2 \\\\ 0 & 0 & -3 & 7 & 0 & 1 \\\\ 0 & 2 & 0 & 0 & -2 & 0\\end{aligned}] & {R}_{3} & :={R}_{3}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}0 & 1 & 0 & 0 & 1 & 2 \\\\ 0 & 0 & -3 & 7 & 0 & 1 \\\\ 0 & 0 & 0 & 0 & -4 & -4\\end{aligned}]\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $D$ has $3$ pivots, and therefore the number of pivot columns is $3.$"} :step/id #uuid "fc788d17-fd28-5cdd-a50f-5b029168f1aa" :step/next {:db/id #edb/ref 17592186495219}}] :activity/title "Quiz 2" :activity/type {:db/id #edb/ref 17592186045460 :db/ident :activity.type/assessment} :db/id #edb/ref 17592186494300}]}
