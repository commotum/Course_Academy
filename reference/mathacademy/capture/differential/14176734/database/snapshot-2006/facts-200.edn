aligned}-5\\cdot |\\begin{aligned}2 & -4 & -4 \\\\ 0 & 1 & 3 \\\\ 0 & 0 & 3\\end{aligned}| & =-5\\cdot (2\\cdot 1\\cdot 3)=-30.\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\ndet(Q)=-30.\n$$" #edb/ref 17592186045417] [17592186339757 #edb/ref 1080 "4" #edb/ref 17592186045417] [17592186339757 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186339757 #edb/ref 1083 #uuid "470abe29-2542-5865-96c9-702c10206992" #edb/ref 17592186045417] [17592186339984 #edb/ref 1080 "3" #edb/ref 17592186045417] [17592186339984 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186339984 #edb/ref 1083 #uuid "600d14b0-e227-5cd2-baf1-b373cb377c46" #edb/ref 17592186045417] [17592186340211 #edb/ref 1080 "5" #edb/ref 17592186045417] [17592186340211 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186340211 #edb/ref 1083 #uuid "7975c256-a582-594f-915f-ca709cab8f6a" #edb/ref 17592186045417] [17592186340899 #edb/ref 1080 "2" #edb/ref 17592186045417] [17592186340899 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186340899 #edb/ref 1083 #uuid "c7ff069b-8d25-52fc-bb50-e97180724410" #edb/ref 17592186045417] [17592186340939 #edb/ref 1080 "1" #edb/ref 17592186045417] [17592186340939 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186340939 #edb/ref 1083 #uuid "cc96cd99-7932-5285-85c2-b574ef3ae1a2" #edb/ref 17592186045417] [17592186341631 #edb/ref 1075 #edb/ref 17592186339757 #edb/ref 17592186045417] [17592186341631 #edb/ref 1075 #edb/ref 17592186339984 #edb/ref 17592186045417] [17592186341631 #edb/ref 1075 #edb/ref 17592186340211 #edb/ref 17592186045417] [17592186341631 #edb/ref 1075 #edb/ref 17592186340899 #edb/ref 17592186045417] [17592186341631 #edb/ref 1075 #edb/ref 17592186340939 #edb/ref 17592186045417] [17592186341631 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186341631 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186341631 #edb/ref 1078 #edb/ref 1759218633998