\"I and III only.\""} :step/id #uuid "98a2aaad-910d-5774-ad63-69bb719493bb"}] :activity/title "Double Integrals Over Non-Rectangular Domains" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186407276}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186425932} :activity/id #uuid "c1b2bf8a-6e24-5f4d-b8cf-9b6296b332cb" :activity/scope {:db/id #edb/ref 17592186049229 :topic/id #uuid "e52ab899-5fcb-50d2-afee-4830a70f16df" :topic/math-academy-id 2616} :activity/steps [{:db/id #edb/ref 17592186425932 :step/content {:db/id #edb/ref 17592186425930 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c96195d-9858-594d-bb72-8ff337d223f6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186474906} {:answer/id #uuid "ac21b789-f73c-5a27-a558-3259fd8be378" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186474907}] :answer-field/correct {:db/id #edb/ref 17592186474906} :answer-field/id #uuid "aeb5c3d2-18c2-5791-91fb-de36d351c3f3" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186475379} {:answer-field/choices [{:answer/id #uuid "6ab7c8fd-5e59-504d-87ca-07f4eaf0b228" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186474908} {:answer/id #uuid "e456c4ef-ec5d-5bb0-bee8-fd0487478461" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186474909}] :answer-field/correct {:db/id #edb/ref 17592186474909} :answer-field/id #uuid "dc86775b-88dd-5f7c-98f3-98d7a6ccc3be" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186475380} {:answer-field/choices [{:answer/id #uuid "80b9bb14-06f2-5942-afb1-747bedec4368" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186474910} {:answer/id #uuid "6c9391