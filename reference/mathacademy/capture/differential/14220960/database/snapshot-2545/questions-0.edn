#{[{:db/id #edb/ref 17592186396606 :knowledge-point/_questions [{:db/id #edb/ref 17592186184196 :knowledge-point/id #uuid "8d9b62ae-7545-5d65-bcf7-74ab0e8662ec" :knowledge-point/title "Identifying Sets That Are Not Vector Spaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "62b7fc67-e9bb-5a0f-8e80-9dcf56649314" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "addition of functions is not commutative" :db/id #edb/ref 17592186396608} {:answer/id #uuid "7cd140b2-7871-5579-9e98-6ecf9f3f51ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "addition of functions is not associative" :db/id #edb/ref 17592186396609} {:answer/id #uuid "1e058a54-9658-5798-ba7c-a86d9840498e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "addition and scalar multiplication of functions do not satisfy the distributive laws" :db/id #edb/ref 17592186396610} {:answer/id #uuid "d6932b0d-e307-5cc8-971a-38fac820cb2a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1\\cdot f\\ne f$ for some $f\\in I$" :db/id #edb/ref 17592186396611} {:answer/id #uuid "4d629cc1-8c34-5761-b952-696843bcc069" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$I$ does not contain the zero element" :db/id #edb/ref 17592186396612}] :answer-field/correct {:answer/id #uuid "4d629cc1-8c34-5761-b952-696843bcc069" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$I$ does not contain the zero element" :db/id #edb/ref 17592186396612} :answer-field/id #uuid "c7ef701a-1be0-572c-baca-f76e42023271" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396607}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "17d56701-363e-5629-ba43-f0ff54124002" :question/math-academy-id "q-106933" :question/problem "Let $I$ be the set of all functions $f:R\\to R$ of the form $f(x)={2}^{ax},$ where $a\\in R.$ Complete the following sentence:\n\n*$I$ is **not** a vector space (with respect to function addition and scalar multiplication of a function by a real number) because $\\text{_________}\\,.$*" :question/worked-solution "The correct answer is as follows:\n\n*$I$ is **not** a vector space (with respect to function addition and scalar multiplication of a function by a real number) because **$I$ does not contain the zero element.** *\n\nIndeed, $f(x)={2}^{ax}>0$ for all $x\\in R$ for any $a\\in R,$ hence the zero function $z(x)=0\\notin I.$\n\nOn the other hand:\n\n- Addition of real valued functions  is associative. $\\,✓$\n\n- $1\\cdot f=f$ for all $f\\in I.$ $\\,✓$\n\n- Addition and scalar multiplication of polynomials satisfy the distributive laws.\n$\\,✓$\n\n- Addition of real valued functions  is commutative. $\\,✓$"}] [{:db/id #edb/ref 17592186351270 :knowledge-point/_questions [{:db/id #edb/ref 17592186119825 :knowledge-point/id #uuid "e568b6fc-88f0-592b-a24d-e3286cfa5043" :knowledge-point/title "Writing a Vector in a Different Basis Given a Linear Relationship Between Two Bases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29c39ae6-0e61-53a0-82d8-be231d625f40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=\\begin{bmatrix}4 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186348813} {:answer/id #uuid "60f5725c-98e1-5e29-a6a2-1825e7d8a2e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=\\begin{bmatrix}3 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186349332} {:answer/id #uuid "782d0dfd-d78f-5d74-a8ca-fe7e942c1a4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=\\begin{bmatrix}4 \\\\ \\frac{5}{3}\\end{bmatrix}" :db/id #edb/ref 17592186349552} {:answer/id #uuid "97ede4f1-5ddb-5b1a-af4c-7752cd75112f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=\\begin{bmatrix}-3 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186349807} {:answer/id #uuid "fdf6e5d4-325b-5104-8bc5-819d216a3de2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186350680}] :answer-field/correct {:answer/id #uuid "29c39ae6-0e61-53a0-82d8-be231d625f40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=\\begin{bmatrix}4 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186348813} :answer-field/id #uuid "891eb5aa-802e-568e-97fe-54a14a5c4456" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350941}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "20bf5820-0c11-5f18-a8d1-2aa12ca67619" :question/math-academy-id "q-81229" :question/problem "Let $B={{b}_{1},{b}_{2}}$ be a basis of ${R}^{2}$ and $[x]_{B}=\\begin{bmatrix}5 \\\\ 8\\end{bmatrix}.$ What are the coordinates of $x$ relative to the basis $C={{c}_{1},{c}_{2}},$ where ${c}_{1}=2{b}_{2}-{b}_{1}$ and ${c}_{2}=3{b}_{1}?$" :question/worked-solution "We are given that\n\n$$\n\\left\\{\\begin{aligned}{c}_{1} &=2{b}_{2}-{b}_{1} \\\\ {c}_{2} &=3{b}_{1}.\\end{aligned}\\right.\n$$\n\nFirst, we express the $b$'s in terms of $c$'s. From the second equation, we get \n\n$$\n{b}_{1}=\\frac{1}{3}{c}_{2}.\n$$\n\nSubstituting this into the first equation, we obtain\n\n$$\n{c}_{1}=2{b}_{2}-(\\frac{1}{3}{c}_{2})\\,⟹\\,{b}_{2}=\\frac{1}{2}{c}_{1}+\\frac{1}{6}{c}_{2}.\n$$\n\nSince $[x]_{B}=\\begin{bmatrix}5 \\\\ 8\\end{bmatrix}$, we can write the vector $x$ as follows:\n\n$$\n\\begin{aligned}x & =5{b}_{1}+8{b}_{2} \\\\  & =5(\\frac{1}{3}{c}_{2})+8(\\frac{1}{2}{c}_{1}+\\frac{1}{6}{c}_{2}) \\\\  & =\\frac{5}{3}{c}_{2}+4{c}_{1}+\\frac{4}{3}{c}_{2} \\\\  & =4{c}_{1}+3{c}_{2}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=\\begin{bmatrix}4 \\\\ 3\\end{bmatrix}.$"}]}
