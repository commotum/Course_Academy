#{[{:activity/first-step {:db/id #edb/ref 17592186097443} :activity/id #uuid "1ca5c8c5-8ab4-5833-8f2c-b4b4eb385b25" :activity/scope {:db/id #edb/ref 17592186048988 :topic/id #uuid "d152b82b-357d-5dd0-8cd0-d9f05720adc2" :topic/math-academy-id 1042} :activity/steps [{:db/id #edb/ref 17592186097443 :step/content {:db/id #edb/ref 17592186097908 :tutorial/content "Remember that the formula for the left Riemann sum for $y=f(x)$ with a regular step size over the interval $[a,b]$ is\n\n$$\n({\\color{red}{f(x_0)}} + {\\color{red}{f(x_1)}} + \\ldots + {\\color{red}{f(x_{n-1})}}) \\cdot {\\color{blue}{\\Delta x}},\n$$\n\nwhere $n$ is the number of rectangles, $x_0=a$ and $x_{n}=b$ are the endpoints of the interval, and the step size is $\\Delta x = \\dfrac{b-a}{n}.$\n\nThe formula above contains a lot of addition signs. We can simplify this by writing the sum in the **sigma notation**:\n\n$$\n\\sum_{k=0}^{n-1} {\\color{red}f(x_k)}\\,{\\color{blue}\\Delta x},\n$$\n\nwhere $x_k = a+ k\\Delta x$  for  $k=0,1,2,\\ldots ,n-1.$" :tutorial/id #uuid "24aaf571-5125-51e2-baea-075b51bb9415" :tutorial/math-academy-id 751 :tutorial/title "Introduction"} :step/id #uuid "c6c39a44-fae6-59e4-a645-dca1c21bd8e7" :step/math-academy-id 1444 :step/next {:db/id #edb/ref 17592186097444}} {:db/id #edb/ref 17592186097444 :step/content {:db/id #edb/ref 17592186096628 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096428 :question/id #uuid "87747005-ce77-5ec6-9f44-af074633aa98" :question/math-academy-id "e-401"} :knowledge-point/id #uuid "62c34646-f7cf-5ffd-b957-4151bdbb5e44" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048363} {:db/id #edb/ref 17592186048922} {:db/id #edb/ref 17592186049317}] :knowledge-point/questions [{:db/id #edb/ref 17592186097266} {:db/id #edb/ref 17592186097271} {:db/id #edb/ref 17592186233956} {:db/id #edb/ref 17592186233957} {:db/id #edb/ref 17592186233958} {:db/id #edb/ref 17592186234110} {:db/id #edb/ref 17592186234334} {:db/id #edb/ref 17592186234338} {:db/id #edb/ref 17592186234339} {:db/id #edb/ref 17592186297427} {:db/id #edb/ref 17592186297428} {:db/id #edb/ref 17592186317568}] :knowledge-point/title "Expressing a Left Riemann Sum in Sigma Notation"} :step/id #uuid "b882a5bd-1c56-5f3d-8a4f-5365c326314b" :step/math-academy-id 1445 :step/next {:db/id #edb/ref 17592186097445}} {:db/id #edb/ref 17592186097445 :step/content {:db/id #edb/ref 17592186097909 :tutorial/content "Recall that the formula for the right Riemann sum for $y=f(x)$ over the interval $[a,b]$ is\n\n$$\n({\\color{red}f(x_1)} + {\\color{red}f(x_2)}  + \\ldots + {\\color{red}f(x_n)}) \\cdot {\\color{blue}\\Delta x}.\n$$\n\nThis right Riemann sum in sigma notation is\n\n$$\n\\sum_{k=1}^{n} {\\color{red}f(x_k)}{\\color{blue}\\Delta x},\n$$\n\nwhere $x_k=a+k\\Delta x$  and $\\Delta x = \\dfrac{b-a}{n}.$\n\nNotice that this is very similar to the left Riemann sum. The only differences are that the counter starts at $k=1$ instead of $k=0,$ and the counter ends at $k=n$ instead of $k=n-1.$" :tutorial/id #uuid "44b80895-643f-5bed-a338-f7b8d2b8253c" :tutorial/math-academy-id 753 :tutorial/title "Right Riemann Sums in Sigma Notation"} :step/id #uuid "9d832977-00e5-5dd1-b7cb-a3a6c5ce6f37" :step/math-academy-id 1448 :step/next {:db/id #edb/ref 17592186097446}} {:db/id #edb/ref 17592186097446 :step/content {:db/id #edb/ref 17592186096629 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096429 :question/id #uuid "af666c8f-dfb7-548e-a8f1-1922d4c2fdc5" :question/math-academy-id "e-402"} :knowledge-point/id #uuid "8d01d6ed-1c25-5170-a1ad-7a4fa0103db7" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049386}] :knowledge-point/questions [{:db/id #edb/ref 17592186097265} {:db/id #edb/ref 17592186097267} {:db/id #edb/ref 17592186233230} {:db/id #edb/ref 17592186233552} {:db/id #edb/ref 17592186233793} {:db/id #edb/ref 17592186234109} {:db/id #edb/ref 17592186234341} {:db/id #edb/ref 17592186234343} {:db/id #edb/ref 17592186234345} {:db/id #edb/ref 17592186235419} {:db/id #edb/ref 17592186317569} {:db/id #edb/ref 17592186318960} {:db/id #edb/ref 17592186318961} {:db/id #edb/ref 17592186341921}] :knowledge-point/title "Expressing a Right Riemann Sum in Sigma Notation"} :step/id #uuid "6328686b-7515-5dd5-93ff-47fe41a2f7e3" :step/math-academy-id 1449}] :activity/title "Left and Right Riemann Sums in Sigma Notation" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186096850}]}
