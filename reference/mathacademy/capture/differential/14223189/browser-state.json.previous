mathvariant=\"normal\">Δ</mi><mi>x</mi><mo stretchy=\"false\">)</mo><mi mathvariant=\"normal\">Δ</mi><mi>x</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><munderover><mo data-mjx-texclass=\"OP\">∑</mo><mrow data-mjx-texclass=\"ORD\"><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mrow data-mjx-texclass=\"ORD\"><mn>3</mn><mo>−</mo><mn>1</mn></mrow></munderover><mi>f</mi><mo stretchy=\"false\">(</mo><mn>1</mn><mo>+</mo><mi>i</mi><mo>⋅</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mo>⋅</mo><mn>1</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><munderover><mo data-mjx-texclass=\"OP\">∑</mo><mrow data-mjx-texclass=\"ORD\"><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mn>2</mn></munderover><mi>f</mi><mo stretchy=\"false\">(</mo><mi>i</mi><mo>+</mo><mn>1</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><munderover><mo data-mjx-texclass=\"OP\">∑</mo><mrow data-mjx-texclass=\"ORD\"><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mn>2</mn></munderover><msqrt><mi>i</mi><mo>+</mo><mn>1</mn></msqrt><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
