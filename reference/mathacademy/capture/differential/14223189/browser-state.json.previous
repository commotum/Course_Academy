      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14223189/observations/step-q49383-6426d3f69803899f1fea.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14223189/observations/step-q49383-6426d3f69803899f1fea.png",
      "source_url": "https://mathacademy.com/tasks/14223189/topics/1042/lesson",
      "captured_at": 1792034803.4380221,
      "math_academy_id": "q-49383",
      "topic_id": "1042",
      "sequence_position": null,
      "source_step": {
