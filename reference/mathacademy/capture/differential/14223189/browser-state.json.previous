/mi><mo>=</mo><munderover><mo data-mjx-texclass=\"OP\">∑</mo><mrow data-mjx-texclass=\"ORD\"><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow data-mjx-texclass=\"ORD\"><mn>3</mn><mo>−</mo><mn>1</mn></mrow></munderover><mi>f</mi><mo stretchy=\"false\">(</mo><mn>0</mn><mo>+</mo><mi>k</mi><mo>⋅</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mo>⋅</mo><mn>1</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><munderover><mo data-mjx-texclass=\"OP\">∑</mo><mrow data-mjx-texclass=\"ORD\"><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mn>2</mn></munderover><mi>f</mi><mo stretchy=\"false\">(</mo><mi>k</mi><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><munderover><mo data-mjx-texclass=\"OP\">∑</mo><mrow data-mjx-texclass=\"ORD\"><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mn>2</mn></munderover><msqrt><mn>9</mn><mo>−</mo><msup><mi>k</mi><mn>2</mn></msup></msqrt><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container> </p>\n</div></div>",
