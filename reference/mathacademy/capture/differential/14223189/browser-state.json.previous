      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14223189/observations/step-q315710-b3aefd7f292ab85876d6.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14223189/observations/step-q315710-b3aefd7f292ab85876d6.png",
      "source_url": "https://mathacademy.com/tasks/14223189/topics/1042/lesson",
      "captured_at": 1792034854.5267065,
      "math_academy_id": "q-315710",
      "topic_id": "1042",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q315710",
        "placement_id": null,
