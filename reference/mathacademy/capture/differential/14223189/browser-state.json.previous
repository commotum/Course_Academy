          "input_html": "<div id=\"freeResponseTextbox-1\" class=\"matheditor-wrapper-answer\" ;=\"\" style=\"min-width:50px;\n                                        margin-left:2px;\n                                        margin-right:1px;\n                                        background:;\"><div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"1\"><span class=\"mq-non-leaf\" mathquill-command-id=\"3\"><span class=\"mq-scaled mq-sqrt-prefix\" style=\"transform: scale(1, 0.943478);\">√</span><span class=\"mq-non-leaf mq-sqrt-stem\" mathquill-block-id=\"5\"><var mathquill-command-id=\"4\">k</var><span mathquill-command-id=\"6\" class=\"mq-binary-operator\">+</span><span mathquill-command-id=\"8\">1</span></span></span></span></div></div>",
          "rendered_text": "√k+1",
