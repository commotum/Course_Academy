[x]_{C}=[\\begin{aligned}\\frac{32}{3} \\\\ -5\\end{aligned}].$"}] [{:db/id #edb/ref 17592186351266 :knowledge-point/_questions [{:db/id #edb/ref 17592186119823 :knowledge-point/id #uuid "29b27833-e930-5339-89b3-c5651d791dcd" :knowledge-point/title "Writing a Two-Dimensional Vector in a Different Basis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03eb8b88-e7a0-5d96-a04e-e4bc020edded" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{B}=[\\begin{aligned}\\frac{5}{2} \\\\ \\frac{3}{5}\\end{aligned}]" :db/id #edb/ref 17592186348484} {:answer/id #uuid "09383855-bb0c-541d-bae5-47aabdedd839" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{B}=[\\begin{aligned}\\frac{3}{5} \\\\ \\frac{5}{2}\\end{aligned}]" :db/id #edb/ref 17592186348523} {:answer/id #uuid "2a87c25b-946a-53fd-8f22-74db07beb308" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{B}=[\\begin{aligned}-5 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186348824} {:answer/id #uuid "390a7c81-c1d1-5184-9771-a8d16d734797" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{B}=[\\begin{aligned}-\\frac{3}{2} \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186348961} {:answer/id #uuid "526df62d-2834-509c-a3b2-d4010b17502a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{B}=[\\begin{aligned}\\frac{5}{2} \\\\ -\\frac{3}{5}\\end{aligned}]" :db/id #edb/ref 17592186349198}] :answer-field/correct {:answer/id #uuid "03eb8b88-e7a0-5d96-a04e-e4bc020edded" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{B}=[\\begin{aligned}\\frac{5}{2} \\\\ \\frac{3}{5}\\end{aligned}]" :db/id #edb/ref 17592186348484} :answer-field/id #uuid "2852f7b3-2f80-5b7f-b362-28bbc6bff06e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ide