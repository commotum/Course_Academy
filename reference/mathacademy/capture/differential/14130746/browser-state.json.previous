  "live_records": {
    "q-175413": {
      "dom_id": "step-q175413",
      "name": "Question 1",
      "problem": "$\\,$ $x$ is smaller than or equal to $3.$\n\nThe predicate $P(x)$ is given above. Which of following represents $¬P(x)?$",
      "worked_solution": "The symbol \"$¬$\" represents negation. So, our task is to negate the given sentence. \n\nTo negate our plain English sentence, we place the words \"It is not true that\" in front of it. This gives the following:\n\n$\\,$ It is not true that $x$ is smaller than or equal to $3.$\n\nIn other words, $x$ is greater than $3.$ Therefore, $¬P(x)$ means the following:\n\n$\\,$ $x$ is greater than $3.$",
      "calculator_instructions": "",
