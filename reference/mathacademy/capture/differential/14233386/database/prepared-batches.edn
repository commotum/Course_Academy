:step/validate]}] "assertions" [["question-e8cf80bf-23f2-50e5-8be6-fd421cafc0d7" :question/id #uuid "e8cf80bf-23f2-50e5-8be6-fd421cafc0d7"] ["question-e8cf80bf-23f2-50e5-8be6-fd421cafc0d7" :question/math-academy-id "q-346662"] ["question-e8cf80bf-23f2-50e5-8be6-fd421cafc0d7" :question/problem "Let $C=\\{-3,-1,1,3\\}.$ Which of the following is equivalent to ${1}_{C}(-1)?$"] ["question-e8cf80bf-23f2-50e5-8be6-fd421cafc0d7" :question/worked-solution "The indicator function $1[P]$ equals $1$ if the predicate $P$ is true and $0$ if $P$ is false.\n\n$$\n1[P]=\\{\\begin{aligned}1, & \\text{if }P\\text{ is true}, \\\\ 0, & \\text{if }P\\text{ is false}.\\end{aligned}\n$$\n\nRecall that the indicator function ${1}_{C}(x)$ of a set $C$ equals $1$ if $x\\in C$ and $0$ if $x\\notin C.$ This can be written using Iverson bracket notation as\n\n$$\n{1}_{C}(x)=1[x\\in C].\n$$\n\nTherefore, we have\n\n$$\n{1}_{C}(-1)=1[-1\\in C]=1[-1\\in \\{-3,-1,1,3\\}].\n$$"] ["question-e8cf80bf-23f2-50e5-8be6-fd421cafc0d7" :question/difficulty :question.difficulty/easy] ["answer-field-8c55f3e7-608f-546e-9238-bec098222d4f" :answer-field/id #uuid "8c55f3e7-608f-546e-9238-bec098222d4f"] ["answer-7a42e783-06ac-540f-a993-5fee32a5d1a7" :answer/id #uuid "7a42e783-06ac-540f-a993-5fee32a5d1a7"] ["answer-7a42e783-06ac-540f-a993-5fee32a5d1a7" :answer/type :answer.type/math] ["answer-7a42e783-06ac-540f-a993-5fee32a5d1a7" :answer/value "1[-1=C]"] ["answer-c77659db-76b7-535a-9c58-254c1f6de06a" :answer/id #uuid "c77659db-76b7-535a-9c58-254c1f6de06a"] ["answer-c77659db-76b7-535a-9c58-254c1f6de06a" :answer/type :answer.type/math] ["answer-c77659db-76b7-535a-9c58-254c1f6de06a" :answer/value "1[-1\\in \\{-3,-1,1,3\\}]"] ["answer-905baf65-bc02-52ab-a96c-06c275629272" :answer/id #uuid "905baf65-bc02-52ab-a96c-06c275629272"] ["answer-905baf65-bc02-52ab-a96c-06c275629272" :answer/type :answer.type/math] ["answer-905baf65-bc02-52ab-a96c-06c275629272" :answer/value "1[-1\\notin \\{-3,-1,1,3\\}]"] ["answer-c64a4829-6ad8-