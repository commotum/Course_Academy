 xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mtable displaystyle=\"true\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"0.8em 0.8em 0.8em 0.3em\"><mtr><mtd><mi>A</mi><mi>B</mi><mo>+</mo><mi>C</mi><mi>B</mi></mtd><mtd><mi></mi><mo>=</mo><mo stretchy=\"false\">(</mo><mi>A</mi><mo>+</mo><mi>C</mi><mo stretchy=\"false\">)</mo><mi>B</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mn>2</mn><msub><mi>I</mi><mn>3</mn></msub><mi>B</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mn>2</mn><mi>B</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">[</mo><mtable columnalign=\"center\" columnspacing=\"1em\" rowspacing=\"4pt\"><mtr><mtd><mo>−</mo><mn>2</mn><msqrt><mn>2</mn></msqrt></mtd><mtd><mo>−</mo><mn>2</mn></mtd><mtd><mo>−</mo><mn>2</mn><msqrt><mn>3</mn></msqrt></mtd></mtr><mtr><mtd><mo>−</mo><mn>2</mn></mtd><mtd><mo>−</mo><mn>2</mn><msqrt><mn>5</mn></msqrt></mtd><mtd><mo>−</mo><mn>2</mn></mtd></mtr><mtr><mtd><mo>−</mo><mn>2</mn><msqrt><mn>7</mn></msqrt></mtd><mtd><mo>−</mo><mn>2</mn></mtd><mtd><mo>−</mo><mn>2</mn><msqrt><mn>2</mn></msqrt></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
