mtd><mn>3</mn><msqrt><mn>3</mn></msqrt></mtd></mtr><mtr><mtd><mn>6</mn></mtd><mtd><mn>3</mn><msqrt><mn>3</mn></msqrt></mtd><mtd><mn>6</mn></mtd></mtr><mtr><mtd><mn>9</mn></mtd><mtd><mn>6</mn></mtd><mtd><mn>3</mn><msqrt><mn>5</mn></msqrt><mtext>&nbsp;</mtext></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container> </p>\n</div></div>",
