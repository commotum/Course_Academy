f 17592186299815 #edb/ref 17592186045417] [17592186115227 #edb/ref 1038 #edb/ref 17592186326920 #edb/ref 17592186045417] [17592186115227 #edb/ref 1038 #edb/ref 17592186326921 #edb/ref 17592186045417] [17592186115227 #edb/ref 1038 #edb/ref 17592186392448 #edb/ref 17592186045417] [17592186115227 #edb/ref 1038 #edb/ref 17592186392501 #edb/ref 17592186045417] [17592186115227 #edb/ref 1038 #edb/ref 17592186392508 #edb/ref 17592186045417] [17592186115227 #edb/ref 1038 #edb/ref 17592186408070 #edb/ref 17592186045417] [17592186115227 #edb/ref 1038 #edb/ref 17592186485578 #edb/ref 17592186045417] [17592186115227 #edb/ref 1039 "Calculating a Matrix Product Using the Associative Law" #edb/ref 17592186045417] [17592186115227 #edb/ref 1041 #edb/ref 17592186115057 #edb/ref 17592186045417] [17592186115227 #edb/ref 1042 #uuid "8feeacff-b07d-5f98-a765-4d8571674a7a" #edb/ref 17592186045417] [17592186115228 #edb/ref 1038 #edb/ref 17592186115837 #edb/ref 17592186045417] [17592186115228 #edb/ref 1038 #edb/ref 17592186115838 #edb/ref 17592186045417] [17592186115228 #edb/ref 1038 #edb/ref 17592186265906 #edb/ref 17592186045417] [17592186115228 #edb/ref 1038 #edb/ref 17592186265907 #edb/ref 17592186045417] [17592186115228 #edb/ref 1038 #edb/ref 17592186265909 #edb/ref 17592186045417] [17592186115228 #edb/ref 1038 #edb/ref 17592186265913 #edb/ref 17592186045417] [17592186115228 #edb/ref 1038 #edb/ref 17592186265914 #edb/ref 17592186045417] [17592186115228 #edb/ref 1038 #edb/ref 17592186329640 #edb/ref 17592186045417] [17592186115228 #edb/ref 1038 #edb/ref 17592186329641 #edb/ref 17592186045417] [17592186115228 #edb/ref 1038 #edb/ref 17592186345115 #edb/ref 17592186045417] [17592186115228 #edb/ref 1038 #edb/ref 17592186345116 #edb/ref 17592186045417] [17592186115228 #edb/ref 1038 #edb/ref 17592186345117 #edb/ref 17592186045417] [17592186115228 #edb/ref 1038 #edb/ref 17592186485559 #edb/ref 17592186045417] [17592186115228 #edb/ref 1039 "Identifying True Statements Regarding Matrix Multiplication" #edb/ref 17592186045417] [17592186115228 #edb/ref 1041 #edb/ref 17592186115058 #edb/ref 17592186045417] [17592186115228 #edb/ref 1042 #uuid "5a870c4a-daa5-5df2-8968-d8bf9ac0bd75" #edb/ref 17592186045417] [17592186115470 #edb/ref 1043 #edb/ref 17592186116097 #edb/ref 17592186045417] [17592186115470 #edb/ref 1043 #edb/ref 17592186116098 #edb/ref 17592186045417] [17592186115470 #edb/ref 1043 #edb/ref 17592186116099 #edb/ref 17592186045417] [17592186115470 #edb/ref 1043 #edb/ref 17592186116100 #edb/ref 17592186045417] [17592186115470 #edb/ref 1043 #edb/ref 17592186116101 #edb/ref 17592186045417] [17592186115470 #edb/ref 1043 #edb/ref 17592186116119 #edb/ref 17592186045417] [17592186115470 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186115470 #edb/ref 1045 "Properties of Matrix Multiplication" #edb/ref 17592186045417] [17592186115470 #edb/ref 1046 #edb/ref 17592186116097 #edb/ref 17592186045417] [17592186115470 #edb/ref 1049 #edb/ref 17592186050122 #edb/ref 17592186045417] [17592186115470 #edb/ref 1050 900.0 #edb/ref 17592186045417] [17592186115470 #edb/ref 1050 900.0 #edb/ref 17592186045436] [17592186115470 #edb/ref 1053 #uuid "f5bf1856-47b4-5455-be99-90d735981501" #edb/ref 17592186045417] [17592186115836 #edb/ref 1068 #edb/ref 17592186113953 #edb/ref 17592186045417] [17592186115836 #edb/ref 1069 "q-42263" #edb/ref 17592186045417] [17592186115836 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186115836 #edb/ref 1071 "Find $AB+CB$, where\n\n$$\nA=[\\begin{aligned}3 & 2 & 1 \\\\ 1 & -5 & -1 \\\\ -9 & 10 & 11\\end{aligned}],\\,B=[\\begin{aligned}\\sqrt{2} & 1 & \\sqrt{3} \\\\ 1 & \\sqrt{5} & 1 \\\\ \\sqrt{7} & 1 & \\sqrt{2}\\end{aligned}],\\,C=[\\begin{aligned}-5 & -2 & -1 \\\\ -1 & 3 & 1 \\\\ 9 & -10 & -13\\end{aligned}].\n$$" #edb/ref 17592186045417] [17592186115836 #edb/ref 1072 #uuid "008d2c2b-6bdc-5e16-92ee-368e3b3e4390" #edb/ref 17592186045417] [17592186115836 #edb/ref 1074 "We apply the distributive law\n\n$$\nAB+CB=(A+C)B.\n$$\n\nSo, we calculate $A+C$ first:\n\n$$\n\\begin{aligned}A+C & =[\\begin{aligned}3 & 2 & 1 \\\\ 1 & -5 & -1 \\\\ -9 & 10 & 11\\end{aligned}]+[\\begin{aligned}-5 & -2 & -1 \\\\ -1 & 3 & 1 \\\\ 9 & -10 & -13\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & 0 & 0 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & -2\\end{aligned}] \\\\  & =-2{I}_{3}\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}AB+CB & =(A+C)B \\\\  & =-2{I}_{3}B \\\\  & =-2B \\\\  & =[\\begin{aligned}-2\\sqrt{2} & -2 & -2\\sqrt{3} \\\\ -2 & -2\\sqrt{5} & -2 \\\\ -2\\sqrt{7} & -2 & -2\\sqrt{2}\\end{aligned}].\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186115837 #edb/ref 1068 #edb/ref 17592186449356 #edb/ref 17592186045436] [17592186115837 #edb/ref 1068 #edb/ref 17592186449357 #edb/ref 17592186045436] [17592186115837 #edb/ref 1068 #edb/ref 17592186449358 #edb/ref 17592186045436] [17592186115837 #edb/ref 1069 "q-42265" #edb/ref 17592186045417] [17592186115837 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186115837 #edb/ref 1071 "Given that $A,B,$ and $C$ are $4\\times 4$ matrices, which of the following statements are always true?\n\nSelect all that apply.\n\n- **I.** $AB=BA$\n- **II.** $(AB)C=A(BC)$\n- **III.** $AC+BC=(A+B)C$" #edb/ref 17592186045436] [17592186115837 #edb/ref 1072 #uuid "5e648555-87e2-52bf-ac70-24ae7f7d32c1" #edb/ref 17592186045417] [17592186115837 #edb/ref 1074 "Let's consider the statements one by one.\n\n- Statement I is false. Matrix multiplication is not commutative, so $AB\\ne BA$ in general.\n\n- Statement II is true. Matrix multiplication is associative, so $(AB)C=A(BC)$ in general.\n\n- Statement III is true. Matrix multiplication is distributive, so $(A+B)C=AC+BC,$ and $A(B+C)=AB+AC$ in general.\n\nTherefore, only statements II and III are true." #edb/ref 17592186045417] [17592186116097 #edb/ref 1058 #edb/ref 17592186116098 #edb/ref 17592186045417] [17592186116097 #edb/ref 1061 16195 #edb/ref 17592186045417] [17592186116097 #edb/ref 1062 #uuid "0b9aabff-e92b-5507-9327-e103c1c53a12" #edb/ref 17592186045417] [17592186116097 #edb/ref 1063 #edb/ref 17592186116486 #edb/ref 17592186045417] [17592186116098 #edb/ref 1058 #edb/ref 17592186116099 #edb/ref 17592186045417] [17592186116098 #edb/ref 1061 16196 #edb/ref 17592186045417] [17592186116098 #edb/ref 1062 #uuid "5f6895fd-de2c-5b1d-96fd-486f6bcbc9a7" #edb/ref 17592186045417] [17592186116098 #edb/ref 1063 #edb/ref 17592186115226 #edb/ref 17592186045417] [17592186116099 #edb/ref 1058 #edb/ref 17592186116100 #edb/ref 17592186045417] [17592186116099 #edb/ref 1061 16197 #edb/ref 17592186045417] [17592186116099 #edb/ref 1062 #uuid "e49acfe6-644b-55a4-86c6-154201b20646" #edb/ref 17592186045417] [17592186116099 #edb/ref 1063 #edb/ref 17592186116487 #edb/ref 17592186045417] [17592186116100 #edb/ref 1058 #edb/ref 17592186116119 #edb/ref 17592186045417] [17592186116100 #edb/ref 1061 16198 #edb/ref 17592186045417] [17592186116100 #edb/ref 1062 #uuid "31661944-ebfa-574b-9783-47e41b70b808" #edb/ref 17592186045417] [17592186116100 #edb/ref 1063 #edb/ref 17592186115227 #edb/ref 17592186045417] [17592186116101 #edb/ref 1061 16199 #edb/ref 17592186045417] [17592186116101 #edb/ref 1062 #uuid "375c5e0d-680a-5465-afbc-b89498f3e772" #edb/ref 17592186045417] [17592186116101 #edb/ref 1063 #edb/ref 17592186115228 #edb/ref 17592186045417] [17592186116119 #edb/ref 1058 #edb/ref 17592186116101 #edb/ref 17592186045417] [17592186116119 #edb/ref 1061 17045 #edb/ref 17592186045417] [17592186116119 #edb/ref 1062 #uuid "c85ef919-914b-57cc-ab1b-19cb7cd36e6e" #edb/ref 17592186045417] [17592186116119 #edb/ref 1063 #edb/ref 17592186116492 #edb/ref 17592186045417] [17592186116486 #edb/ref 1064 "We have already seen some properties of matrix multiplication. For example, multiplying any $n \\times n$ square matrix $A$ by the identity matrix $I_n$ will leave it unchanged:\n\n$$\nA I_n = I_n A = A.\n$$\n\nAlso, matrix multiplication follows the **distributive laws**:\n\n$$\n\\begin{aligned}(A+B)C & =AC+BC, \\\\ C(A+B) & =CA+CB.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186116486 #edb/ref 1065 2997 #edb/ref 17592186045417] [17592186116486 #edb/ref 1066 #uuid "60b5c83f-3d84-5140-80c7-c4640bea28b0" #edb/ref 17592186045417] [17592186116486 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186116487 #edb/ref 1064 "If $A,$ $B,$ and $C$ are three matrices that are conformable for multiplication, then they follow the **associative law**:\n\n$$\n\\left( AB\\right) C = A\\left( BC\\right)\n$$\n\nSo, when we wish to compute a product $ABC,$ we don't always have to start by multiplying $AB.$ Alternatively, we can start by multiplying $BC,$ and then multiply $A$ by the result. \n\nSometimes rearranging the parentheses might make the computations slightly easier." #edb/ref 17592186045417] [17592186116487 #edb/ref 1065 2998 #edb/ref 17592186045417] [17592186116487 #edb/ref 1066 #uuid "31c195bb-9066-55bf-ae02-9de81da2b7bb" #edb/ref 17592186045417] [17592186116487 #edb/ref 1067 "The Associative Law for Matrix Multiplication" #edb/ref 17592186045417] [17592186116492 #edb/ref 1064 "In general, matrix multiplication is **not** commutative. In other words, given two general matrices $A$ and $B$ that are conformable for multiplication, we have\n\n$$\nAB \\neq BA.\n$$\n\nHowever, some particular matrices may satisfy this property. For instance, $AI = IA$ (where $I$ is the identity matrix)." #edb/ref 17592186045417] [17592186116492 #edb/ref 1065 3129 #edb/ref 17592186045417] [17592186116492 #edb/ref 1066 #uuid "4e92439e-2fc7-59ca-beb8-2ace6a7d3e71" #edb/ref 17592186045417] [17592186116492 #edb/ref 1067 "Matrix Multiplication Is Not Commutative in General" #edb/ref 17592186045417] [17592186263242 #edb/ref 1080 "[\\begin{aligned}3 & 6 & -1 \\\\ 4 & 2 & 1 \\\\ -1 & 2 & 3\\end{aligned}]" #edb/ref 17592186045417] [17592186263242 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186263242 #edb/ref 1083 #uuid "19780864-9003-505a-b598-f3378103858e" #edb/ref 17592186045417] [17592186263268 #edb/ref 1080 "[\\begin{aligned}7 & -7 & -21 \\\\ 3 & -3 & -9 \\\\ -8 & 8 & 24\\end{aligned}]" #edb/ref 17592186045417] [17592186263268 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186263268 #edb/ref 1083 #uuid "1d6518a0-5e35-59b6-b899-07522f46b179" #edb/ref 17592186045417] [17592186263733 #edb/ref 1080 "[\\begin{aligned}-8 & 8 & 24 \\\\ 3 & -3 & -9 \\\\ 7 & -7 & -21\\end{aligned}]" #edb/ref 17592186045417] [17592186263733 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186263733 #edb/ref 1083 #uuid "5517ab5e-f687-5ce4-852d-48dfec575a26" #edb/ref 17592186045417] [17592186263735 #edb/ref 1080 "[\\begin{aligned}3 & -8 & 7 \\\\ -3 & 8 & -7 \\\\ -9 & 24 & -21\\end{aligned}]" #edb/ref 17592186045417] [17592186263735 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186263735 #edb/ref 1083 #uuid "55a69114-638a-51d0-954d-1a1fa82cd27a" #edb/ref 17592186045417] [17592186264802 #edb/ref 1080 "[\\begin{aligned}3 & -3 & -9 \\\\ -8 & 8 & 24 \\\\ 7 & -7 & -21\\end{aligned}]" #edb/ref 17592186045417] [17592186264802 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186264802 #edb/ref 1083 #uuid "ce129b66-be90-56f8-b1fe-b394c797c064" #edb/ref 17592186045417] [17592186265368 #edb/ref 1075 #edb/ref 17592186263242 #edb/ref 17592186045417] [17592186265368 #edb/ref 1075 #edb/ref 17592186263268 #edb/ref 17592186045417] [17592186265368 #edb/ref 1075 #edb/ref 17592186263733 #edb/ref 17592186045417] [17592186265368 #edb/ref 1075 #edb/ref 17592186263735 #edb/ref 17592186045417] [17592186265368 #edb/ref 1075 #edb/ref 17592186264802 #edb/ref 17592186045417] [17592186265368 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186265368 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186265368 #edb/ref 1078 #edb/ref 17592186264802 #edb/ref 17592186045417] [17592186265368 #edb/ref 1079 #uuid "42ab1d01-3d95-5a64-a3f9-0807a0efbbe8" #edb/ref 17592186045417] [17592186265880 #edb/ref 1068 #edb/ref 17592186265368 #edb/ref 17592186045417] [17592186265880 #edb/ref 1069 "q-130313" #edb/ref 17592186045417] [17592186265880 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186265880 #edb/ref 1071 "Calculate $ABC$, where\n\n$$\nA=[\\begin{aligned}3 & 6 \\\\ 4 & 2 \\\\ -1 & 2\\end{aligned}],\\,B=[\\begin{aligned}3 \\\\ -2\\end{aligned}],\\,C=[\\begin{aligned}-1 & 1 & 3\\end{aligned}].\n$$" #edb/ref 17592186045417] [17592186265880 #edb/ref 1072 #uuid "e430effe-7959-580a-be3d-d4b5f50f0d27" #edb/ref 17592186045417] [17592186265880 #edb/ref 1074 "First, recall the associative law\n\n$$\nABC=(AB)C=A(BC).\n$$\n\nNotice that $A$ is a $3\\times 2$ matrix, $B$ is a $2\\times 1$ matrix, and $C$ is a $1\\times 3$ matrix. Therefore, \n\n- multiplying $A$ by $B$, we will obtain a $3\\times 1$ matrix, which will require finding $3$ entries, while\n\n- multiplying $B$ by $C$, we will obtain a $2\\times 3$ matrix, which will require finding $6$ entries.\n\nSo, we find the product $AB$ first:\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}3 & 6 \\\\ 4 & 2 \\\\ -1 & 2\\end{aligned}]\\cdot [\\begin{aligned}3 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}-3 \\\\ 8 \\\\ -7\\end{aligned}]\\end{aligned}\n$$\n\nNow, we multiply $AB$ by $C:$\n\n$$\n\\begin{aligned}ABC & =(AB)C \\\\  & =[\\begin{aligned}-3 \\\\ 8 \\\\ -7\\end{aligned}]\\cdot [\\begin{aligned}-1 & 1 & 3\\end{aligned}] \\\\  & =[\\begin{aligned}3 & -3 & -9 \\\\ -8 & 8 & 24 \\\\ 7 & -7 & -21\\end{aligned}]\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186297589 #edb/ref 1080 "78" #edb/ref 17592186045417] [17592186297589 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186297589 #edb/ref 1083 #uuid "07a31a1b-94aa-5cea-9846-cc139c0dc4ab" #edb/ref 17592186045417] [17592186297722 #edb/ref 1080 "-182" #edb/ref 17592186045417] [17592186297722 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186297722 #edb/ref 1083 #uuid "27f662dc-9756-5