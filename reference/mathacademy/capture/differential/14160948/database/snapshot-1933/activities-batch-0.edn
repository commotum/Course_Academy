#{[{:activity/expected-seconds 900.0 :activity/first-step {:db/id #edb/ref 17592186116097} :activity/id #uuid "f5bf1856-47b4-5455-be99-90d735981501" :activity/scope {:db/id #edb/ref 17592186050122 :topic/id #uuid "2eaec2b9-4c03-5efd-b5aa-8e9655cca4f4" :topic/math-academy-id 1724} :activity/steps [{:db/id #edb/ref 17592186116097 :step/content {:db/id #edb/ref 17592186116486 :tutorial/content "We have already seen some properties of matrix multiplication. For example, multiplying any $n \\times n$ square matrix $A$ by the identity matrix $I_n$ will leave it unchanged:\n\n$$\nA I_n = I_n A = A.\n$$\n\nAlso, matrix multiplication follows the **distributive laws**:\n\n$$\n\\begin{aligned}(A+B)C & =AC+BC, \\\\ C(A+B) & =CA+CB.\\end{aligned}\n$$" :tutorial/id #uuid "60b5c83f-3d84-5140-80c7-c4640bea28b0" :tutorial/math-academy-id 2997 :tutorial/title "Introduction"} :step/id #uuid "0b9aabff-e92b-5507-9327-e103c1c53a12" :step/math-academy-id 16195 :step/next {:db/id #edb/ref 17592186116098}} {:db/id #edb/ref 17592186116098 :step/content {:db/id #edb/ref 17592186115226 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115056 :question/id #uuid "32bd6b27-e95d-5de4-941f-309eb0bc61f1" :question/math-academy-id "e-4411"} :knowledge-point/id #uuid "a7ad52ce-d408-5390-b91f-c855274f39ea" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050407} {:db/id #edb/ref 17592186051079}] :knowledge-point/questions [{:db/id #edb/ref 17592186115829} {:db/id #edb/ref 17592186115836} {:db/id #edb/ref 17592186235392} {:db/id #edb/ref 17592186265870} {:db/id #edb/ref 17592186292858} {:db/id #edb/ref 17592186292859} {:db/id #edb/ref 17592186299802} {:db/id #edb/ref 17592186299803} {:db/id #edb/ref 17592186299807} {:db/id #edb/ref 17592186299808} {:db/id #edb/ref 17592186345111} {:db/id #edb/ref 17592186388090} {:db/id #edb/ref 17592186485535} {:db/id #edb/ref 17592186485538} {:db/id #edb/ref 17592186485543}] :knowledge-point/title "Calculating a Matrix Product Using the Distributive Law"} :step/id #uuid "5f6895fd-de2c-5b1d-96fd-486f6bcbc9a7" :step/math-academy-id 16196 :step/next {:db/id #edb/ref 17592186116099}} {:db/id #edb/ref 17592186116099 :step/content {:db/id #edb/ref 17592186116487 :tutorial/content "If $A,$ $B,$ and $C$ are three matrices that are conformable for multiplication, then they follow the **associative law**:\n\n$$\n\\left( AB\\right) C = A\\left( BC\\right)\n$$\n\nSo, when we wish to compute a product $ABC,$ we don't always have to start by multiplying $AB.$ Alternatively, we can start by multiplying $BC,$ and then multiply $A$ by the result. \n\nSometimes rearranging the parentheses might make the computations slightly easier." :tutorial/id #uuid "31c195bb-9066-55bf-ae02-9de81da2b7bb" :tutorial/math-academy-id 2998 :tutorial/title "The Associative Law for Matrix Multiplication"} :step/id #uuid "e49acfe6-644b-55a4-86c6-154201b20646" :step/math-academy-id 16197 :step/next {:db/id #edb/ref 17592186116100}} {:db/id #edb/ref 17592186116100 :step/content {:db/id #edb/ref 17592186115227 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115057 :question/id #uuid "3b1395b6-49c1-5e0d-ac94-c2d6fc242f6b" :question/math-academy-id "e-4412"} :knowledge-point/id #uuid "8feeacff-b07d-5f98-a765-4d8571674a7a" :knowledge-point/questions [{:db/id #edb/ref 17592186115828} {:db/id #edb/ref 17592186115835} {:db/id #edb/ref 17592186265880} {:db/id #edb/ref 17592186292860} {:db/id #edb/ref 17592186299810} {:db/id #edb/ref 17592186299811} {:db/id #edb/ref 17592186299814} {:db/id #edb/ref 17592186299815} {:db/id #edb/ref 17592186326920} {:db/id #edb/ref 17592186326921} {:db/id #edb/ref 17592186392448} {:db/id #edb/ref 17592186392501} {:db/id #edb/ref 17592186392508} {:db/id #edb/ref 17592186408070} {:db/id #edb/ref 17592186485578}] :knowledge-point/title "Calculating a Matrix Product Using the Associative Law"} :step/id #uuid "31661944-ebfa-574b-9783-47e41b70b808" :step/math-academy-id 16198 :step/next {:db/id #edb/ref 17592186116119}} {:db/id #edb/ref 17592186116101 :step/content {:db/id #edb/ref 17592186115228 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115058 :question/id #uuid "7ab158e6-4222-5cab-88a0-85ce74a7d4b2" :question/math-academy-id "e-4413"} :knowledge-point/id #uuid "5a870c4a-daa5-5df2-8968-d8bf9ac0bd75" :knowledge-point/questions [{:db/id #edb/ref 17592186115837} {:db/id #edb/ref 17592186115838} {:db/id #edb/ref 17592186265906} {:db/id #edb/ref 17592186265907} {:db/id #edb/ref 17592186265909} {:db/id #edb/ref 17592186265913} {:db/id #edb/ref 17592186265914} {:db/id #edb/ref 17592186329640} {:db/id #edb/ref 17592186329641} {:db/id #edb/ref 17592186345115} {:db/id #edb/ref 17592186345116} {:db/id #edb/ref 17592186345117} {:db/id #edb/ref 17592186485559}] :knowledge-point/title "Identifying True Statements Regarding Matrix Multiplication"} :step/id #uuid "375c5e0d-680a-5465-afbc-b89498f3e772" :step/math-academy-id 16199} {:db/id #edb/ref 17592186116119 :step/content {:db/id #edb/ref 17592186116492 :tutorial/content "In general, matrix multiplication is **not** commutative. In other words, given two general matrices $A$ and $B$ that are conformable for multiplication, we have\n\n$$\nAB \\neq BA.\n$$\n\nHowever, some particular matrices may satisfy this property. For instance, $AI = IA$ (where $I$ is the identity matrix)." :tutorial/id #uuid "4e92439e-2fc7-59ca-beb8-2ace6a7d3e71" :tutorial/math-academy-id 3129 :tutorial/title "Matrix Multiplication Is Not Commutative in General"} :step/id #uuid "c85ef919-914b-57cc-ab1b-19cb7cd36e6e" :step/math-academy-id 17045 :step/next {:db/id #edb/ref 17592186116101}}] :activity/title "Properties of Matrix Multiplication" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186115470}]}
