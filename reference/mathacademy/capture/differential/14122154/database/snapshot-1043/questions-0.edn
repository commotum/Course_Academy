95c4-5fdf-9538-cfd90f4a2b3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186158802} {:answer/id #uuid "7d810ec3-fb2e-5820-ae2e-d55f7775e2d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{5}" :db/id #edb/ref 17592186158803}] :answer-field/correct {:answer/id #uuid "2610e250-1e87-5e70-911e-ced87d38d5a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "70" :db/id #edb/ref 17592186158801} :answer-field/id #uuid "fdd49fee-8241-5a92-8763-eb72406aa943" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186158798}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f809e4ca-96d1-5ff3-9f14-e230cdb13096" :question/math-academy-id "q-108945" :question/problem "The probability distribution of the random variable $X$ is given below. Given that $\\text{E}[X]=7,$ calculate $\\text{Var}[5X].$ \n\n| $x$ | $5$ | $6$ | $9$ |\n| --- | --- | --- | --- |\n| $f(x)$ | $\\frac{1}{5}$ | $\\frac{2}{5}$ | $\\frac{2}{5}$ |" :question/requires-calculator true :question/worked-solution "Recall that for any random variable $X$ and constant $a,$ we have\n\n$$\n\\text{Var}[aX]={a}^{2}\\cdot \\text{Var}[X].\n$$\n\nIn our case, $a=5.$ Therefore,\n\n$$\n\\begin{aligned}\\text{Var}[5X] & ={5}^{2}\\cdot \\text{Var}[X] \\\\  & =25\\cdot \\text{Var}[X].\\end{aligned}\n$$\n\nWe can compute the variance of $X$ using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\nAdditionally, we're given that $\\text{E}[X]=7.$ \n\nWe start by computing $\\text{E}[{X}^{2}].$ Summing up the products of each value of ${X}^{2}$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={5}^{2}\\cdot f(5)+{6}^{2}\\cdot f(6)+{9}^{2}\\cdot f(9) \\\\  & =25(\\frac{1}{5})+36(\\frac{2}{5})+81(\\frac{2}{5}) \\\\  & =\\frac{259}{5}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{259}{5}-{7}^{2} \\\\  & =\\frac{259}{5}-49 \\\\  & =\\frac{14}{5}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[5X] & =25\\cdot \\text{Var}[X] \\\\  & =25\\cdot \\frac{14}{5} \\\\  & =14\\cdot 5 \\\\  & =70.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186369036 :knowledge-point/_questions [{:db/id #edb/ref 17592186162056 :knowledge-point/id #uuid "405984cd-1e1b-54c6-bc75-268e127b9812" :knowledge-point/title "Computing the Variance of a Constant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e08939a-2340-514c-bf8b-cdb2914a47a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186369038} {:answer/id #uuid "5dac9740-55fa-5dbd-8ce5-15a441a5aa8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{2}}" :db/id #edb/ref 17592186369039} {:answer/id #uuid "7c0f3aea-cee5-5e5b-8e5c-40d4786c5214" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186369040} {:answer/id #uuid "91d82eb4-e710-5148-a0ad-759b3ce867af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186369041} {:answer/id #uuid "f8b01b05-677a-54b0-804e-81dd859fe06f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186369042}] :answer-field/correct {:answer/id #uuid "f8b01b05-677a-54b0-804e-81dd859fe06f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186369042} :answer-field/id #uuid "fdb10b85-548f-5950-9dff-784e0f0aba51" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/i