ef 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186369075} :answer-field/id #uuid "22255499-f030-5e65-8284-4fb7e947e99e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186369072}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dda2c394-4ef1-5180-a3b3-c0865a6616dd" :question/math-academy-id "q-109077" :question/problem "If $\\text{Var}[X]=\\frac{1}{2},$ calculate $\\text{Var}[-\\sqrt{2}X].$" :question/worked-solution "Recall that for any random variable $X$ and constant $a,$ we have\n\n$$\n\\text{Var}[aX]={a}^{2}\\cdot \\text{Var}[X].\n$$\n\nIn our case, $a=-\\sqrt{2}.$ Therefore,\n\n$$\n\\begin{aligned}\\text{Var}[-\\sqrt{2}X] & ={(-\\sqrt{2})}^{2}\\cdot \\text{Var}[X] \\\\  & =2\\cdot \\frac{1}{2} \\\\  & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186420138 :knowledge-point/_questions [{:db/id #edb/ref 17592186162058 :knowledge-point/id #uuid "85388f7d-b2ee-520b-b711-a7721c6f620c" :knowledge-point/title "Computing the Variance of a Transformed Random Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18fcdc20-d9ce-5918-a799-224704442b0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{15}{8}" :db/id #edb/ref 17592186420107} {:answer/id #uuid "954c32d9-778b-5b43-8961-535d53b7d6f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{8}" :db/id #edb/ref 17592186420118} {:answer/id #uuid "e64a66c3-6dac-5766-9242-dc560f828481" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186420127} {:answer/id #uuid "f1ae131d-893b-5552-852c-ce4ade2b310c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186420129} {:answer/id #uuid "fda015bf-920f-56ce-89d7-ad20ffbb10db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{4}" :db/id #edb/ref 17592186420130}] :answer-field/correct {:answer/id #uuid "954c32d9-778b-5b43-8961-535d53b7d6f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{8}" :db/id #edb/ref 17592186420118} :answer-field/id #uuid "190cfb56-9bd3-537b-9e67-03ec6f08f929" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186420131}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "34f8f239-f24a-50f7-8925-78cd969b209c" :question/math-academy-id "q-109079" :question/problem "The probability distribution of the random variable $X$ is given below. Given that $\\text{E}[X]=\\frac{9}{2},$ calculate $\\text{Var}[3-\\frac{1}{2}X].$ \n\n| $x$ | $0$ | $3$ | $6$ |\n| --- | --- | --- | --- |\n| $f(x)$ | $\\frac{1}{8}$ | $\\frac{1}{4}$ | $\\frac{5}{8}$ |" :question/worked-solution "Recall that for any random variable $X$ and constants $a$ and $b,$ we have\n\n$$\n\\text{Var}[aX+b]={a}^{2}\\cdot \\text{Var}[X].\n$$\n\nIn our case, $a=-\\frac{1}{2}$ and $b=3.$ Therefore,\n\n$$\n\\begin{aligned}\\text{Var}[3-\\frac{1}{2}X] & ={(-\\frac{1}{2})}^{2}\\cdot \\text{Var}[X] \\\\  & =\\frac{1}{4}\\cdot \\text{Var}[X].\\end{aligned}\n$$\n\nWe can compute the variance of $X$ using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\nAdditionally, we're given that $\\text{E}[X]=\\frac{9}{2}.$ \n\nWe start by computing $\\text{E}[{X}^{2}].$ Summing up the products of each value of ${X}^{2}$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={0}^{2}\\cdot f(0)+{3}^{2}\\cdot f(3)+{6}^{2}\\cdot f(6) \\\\  & =9\\cdot \\frac{1}{4}+36\\cdot \\frac{5}{8} \\\\  & =\\frac{99}{4}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{99}{4}-{(\\frac{9}{2})}^{2} \\\\  & =\\frac{9}{2}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[3-\\frac{1}{2}X] & =\\frac{1}{4}\\cdot \\text{Var}[X] \\\\  & =\\frac{1}{4}\\cdot \\frac{9}{2} \\\\  & =\\frac{9}{8}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186369078 :knowledge-point/_questions [{:db/id #edb/ref 17592186162058 :knowledge-point/id #uuid "85388f7d-b2ee-520b-b711-a7721c6f620c" :knowledge-point/title "Computing the Variance of a Transformed Random Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6074b57c-fee0-5942-92a8-495d2e18161d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "70" :db/id #edb/ref 17592186369080} {:answer/id #uuid "3d1482b2-8293-5012-b006-fcb939ed5494" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186369081} {:answer/id #uuid "24bba3b7-3223-5865-a436-d0bc39027f8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-69" :db/id #edb/ref 17592186369082} {:answer/id #uuid "fde06ae9-c489-5c3c-9121-d6f657acdb97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186369083} {:answer/id #uuid "99cc3d48-98f2-5fe6-b0ff-e7d8656d0493" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186369084}] :answer-field/correct {:answer/id #uuid "6074b57c-fee0-5942-92a8-495d2e18161d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "70" :db/id #edb/ref 17592186369080} :answer-field/id #uuid "29bc75fb-29c2-53eb-ab80-1dc006cdc829" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186369079}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "23073627-db67-5e1b-90ec-21216a699151" :question/math-academy-id "q-109089" :question/problem "The probability distribution of the random variable $X$ is given below. Given that $\\text{E}[X]=3,$ calculate $\\text{Var}[1-7X].$ \n\n| $x$ | $1$ | $2$ | $4$ |\n| --- | --- | --- | --- |\n| $f(x)$ | $\\frac{1}{7}$ | $\\frac{2}{7}$ | $\\frac{4}{7}$ |" :question/worked-solution "Recall that for any random variable $X$ and constants $a$ and $b,$ we have\n\n$$\n\\text{Var}[aX+b]={a}^{2}\\cdot \\text{Var}[X].\n$$\n\nIn our case, $a=-7$ and $b=1.$ Therefore,\n\n$$\n\\begin{aligned}\\text{Var}[1-7X] & =(-7)^{2}\\cdot \\text{Var}[X] \\\\  & =49\\cdot \\text{Var}[X].\\end{aligned}\n$$\n\nWe can compute the variance of $X$ using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\nAdditionally, we're given that $\\text{E}[X]=3.$ \n\nWe start by computing $\\text{E}[{X}^{2}].$ Summing up the products of each value of ${X}^{2}$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={1}^{2}\\cdot f(1)+{2}^{2}\\cdot f(2)+{4}^{2}\\cdot f(4) \\\\  & =\\frac{1}{7}+4\\cdot \\frac{2}{7}+16\\cdot \\frac{4}{7} \\\\  & =\\frac{73}{7}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{73}{7}-{3}^{2} \\\\  & =\\frac{10}{7}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[1-7X] & =49\\cdot \\text{Var}[X] \\\\  & =49\\cdot \\frac{10}{7} \\\\  & =70.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186420137 :knowledge-point/_questions [{:db/id #edb/ref 17592186162058 :knowledge-point/id #uuid "85388f7d-b2ee-520b-b711-a7721c6f620c" :knowledge-point/title "Computing the Variance of a Transformed Random Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37f0111e-003f-5538-a3b8-ed1430d08fdc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186420111} {:answer/id #uuid "a0f2c3dd-df0a-57f1-9b19-b251ffe9a72e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186420122} {:answer/id #uuid "bc26c2f9-39d9-5339-a3e8-be5d2e945ea8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{6}" :db/id #edb/ref 17592186420123} {:answer/id #uuid "c6d13b79-c01f-5ddb-888f-f826b5a1451c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186420124} {:answer/id #uuid "e83e0132-215d-5133-98be-6554e8873e9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186420128}] :answer-field/correct {:answer/id #uuid "e83e0132-215d-5133-98be-6554e8873e9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186420128} :answer-field/id #uuid "7d0a832f-24dd-571f-b252-8ec9cfdfbd85" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186420134}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "12feee0e-318a-5930-8eca-dd111ec7b1c2" :question/math-academy-id "q-109091" :question/problem "The probability distribution of the random variable $X$ is given below. Given that $\\text{E}[X]=1,$ calculate $\\text{Var}[\\frac{1}{8}-\\frac{1}{2}X].$ \n\n| $x$ | $0$ | $1$ | $3$ |\n| --- | --- | --- | --- |\n| $f(x)$ | $\\frac{1}{2}$ | $\\frac{1}{4}$ | $\\frac{1}{4}$ |" :question/worked-solution "Recall that for any random variable $X$ and constants $a$ and $b,$ we have\n\n$$\n\\text{Var}[aX+b]={a}^{2}\\cdot \\text{Var}[X].\n$$\n\nIn our case, $a=-\\frac{1}{2}$ and $b=\\frac{1}{8}.$ Therefore,\n\n$$\n\\begin{aligned}\\text{Var}[\\frac{1}{8}-\\frac{1}{2}X] & ={(-\\frac{1}{2})}^{2}\\cdot \\text{Var}[X] \\\\  & =\\frac{1}{4}\\cdot \\text{Var}[X].\\end{aligned}\n$$\n\nWe can compute the variance of $X$ using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\nAdditionally, we're given that $\\text{E}[X]=1.$ \n\nWe start by computing $\\text{E}[{X}^{2}].$ Summing up the products of each value of ${X}^{2}$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={0}^{2}\\cdot f(0)+{1}^{2}\\cdot f(1)+{3}^{2}\\cdot f(3) \\\\  & =1\\cdot \\frac{1}{4}+9\\cdot \\frac{1}{4} \\\\  & =\\frac{5}{2}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{5}{2}-{1}^{2} \\\\  & =\\frac{3}{2}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[\\frac{1}{8}-\\frac{1}{2}X] & =\\frac{1}{4}\\cdot \\text{Var}[X] \\\\  & =\\frac{1}{4}\\cdot \\frac{3}{2} \\\\  & =\\frac{3}{8}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186420139 :knowledge-point/_questions [{:db/id #edb/ref 17592186162056 :knowledge-point/id #uuid "405984cd-1e1b-54c6-bc75-268e127b9812" :knowledge-point/title "Computing the Variance of a Constant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3dcfce52-9f77-594e-abb6-a96da80d166b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.2" :db/id #edb/ref 17592186420112} {:answer/id #uuid "5dae0172-10cc-5060-bf4a-315f77dba9a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186420115} {:answer/id #uuid "6657c628-8660-5023-8ee0-945dab5715e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186420117} {:answer/id #uuid "95c4162c-b36b-54af-9f0c-c093bb7cac5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer