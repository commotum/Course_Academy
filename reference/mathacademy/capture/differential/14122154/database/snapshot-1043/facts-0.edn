92186045417] [17592186162058 #edb/ref 1041 #edb/ref 17592186161858 #edb/ref 17592186045417] [17592186162058 #edb/ref 1042 #uuid "85388f7d-b2ee-520b-b711-a7721c6f620c" #edb/ref 17592186045417] [17592186162181 #edb/ref 1043 #edb/ref 17592186162971 #edb/ref 17592186045417] [17592186162181 #edb/ref 1043 #edb/ref 17592186162972 #edb/ref 17592186045417] [17592186162181 #edb/ref 1043 #edb/ref 17592186162973 #edb/ref 17592186045417] [17592186162181 #edb/ref 1043 #edb/ref 17592186162974 #edb/ref 17592186045417] [17592186162181 #edb/ref 1043 #edb/ref 17592186162975 #edb/ref 17592186045417] [17592186162181 #edb/ref 1043 #edb/ref 17592186162976 #edb/ref 17592186045417] [17592186162181 #edb/ref 1043 #edb/ref 17592186162977 #edb/ref 17592186045417] [17592186162181 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186162181 #edb/ref 1045 "Properties of Variance for Discrete Random Variables" #edb/ref 17592186045417] [17592186162181 #edb/ref 1046 #edb/ref 17592186162974 #edb/ref 17592186045417] [17592186162181 #edb/ref 1049 #edb/ref 17592186048731 #edb/ref 17592186045417] [17592186162181 #edb/ref 1050 420.0 #edb/ref 17592186045417] [17592186162181 #edb/ref 1053 #uuid "9110c851-c32a-57df-a77a-329797a3df41" #edb/ref 17592186045417] [17592186162263 #edb/ref 1068 #edb/ref 17592186369024 #edb/ref 17592186045417] [17592186162263 #edb/ref 1069 "q-108935" #edb/ref 17592186045417] [17592186162263 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186162263 #edb/ref 1071 "Calculate $\\text{Var}[{k}^{2}]$ where $k$ is a constant." #edb/ref 17592186045417] [17592186162263 #edb/ref 1072 #uuid "c62b82e5-3c3b-529e-a343-4b241d2b5c2a" #edb/ref 17592186045417] [17592186162263 #edb/ref 1074 "Recall that for any constant $a,$ we have\n\n$$\n\\text{Var}[a]=0.\n$$\n\nTherefore, since $k$ is a constant, we have\n\n$$\n\\text{Var}[{k}^{2}]=0.\n$$" #edb/ref 17592186045417] [17592186162266 #edb/ref 1068 #edb/ref 17592186158798 #edb/ref 17592186045417] [17592186162266 #edb/ref 1069 "q-108945" #edb/ref 17592186045417] [17592186162266 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186162266 #edb/ref 1071 "The probability distribution of the random variable $X$ is given below. Given that $\\text{E}[X]=7,$ calculate $\\text{Var}[5X].$ \n\n| $x$ | $5$ | $6$ | $9$ |\n| --- | --- | --- | --- |\n| $f(x)$ | $\\frac{1}{5}$ | $\\frac{2}{5}$ | $\\frac{2}{5}$ |" #edb/ref 17592186045417] [17592186162266 #edb/ref 1072 #uuid "f809e4ca-96d1-5ff3-9f14-e230cdb13096" #edb/ref 17592186045417] [17592186162266 #edb/ref 1073 true #edb/ref 17592186045417] [17592186162266 #edb/ref 1074 "Recall that for any random variable $X$ and constant $a,$ we have\n\n$$\n\\text{Var}[aX]={a}^{2}\\cdot \\text{Var}[X].\n$$\n\nIn our case, $a=5.$ Therefore,\n\n$$\n\\begin{aligned}\\text{Var}[5X] & ={5}^{2}\\cdot \\text{Var}[X] \\\\  & =25\\cdot \\text{Var}[X].\\end{aligned}\n$$\n\nWe can compute the variance of $X$ using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\nAdditionally, we're given that $\\text{E}[X]=7.$ \n\nWe start by computing $\\text{E}[{X}^{2}].$ Summing up the products of each value of ${X}^{2}$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={5}^{2}\\cdot f(5)+{6}^{2}\\cdot f(6)+{9}^{2}\\cdot f(9) \\\\  & =25(\\frac{1}{5})+36(\\frac{2}{5})+81(\\frac{2}{5}) \\\\  & =\\frac{259}{5}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{259}{5}-{7}^{2} \\\\  & =\\frac{259}{5}-49 \\\\  & =\\frac{14}{5}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[5X] & =25\\cdot \\text{Var}[X] \\\\  & =25\\cdot \\frac{14}{5} \\\\  & =14\\cdot 5 \\\\  & =70.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186162971 #edb/ref 1058 #edb/ref 17592186162975 #edb/ref 17592186045417] [17592186162971 #edb/ref 1061 33959 #edb/ref 17592186045417] [17592186162971 #edb/ref 1062 #uuid "3174d04a-7e8e-5098-91d3-c55afedd2e39" #edb/ref 17592186045417] [17592186162971 #edb/ref 1063 #edb/ref 17592186162056 #edb/ref 17592186045417] [17592186162972 #edb/ref 1058 #edb/ref 17592186162976 #edb/ref 17592186045417] [17592186162972 #edb/ref 1061 33961 #edb/ref 17592186045417] [17592186162972 #edb/ref 1062 #uuid "fe3d0b73-cb7e-5370-9455-c490da334890" #edb/ref 17592186045417] [17592186162972 #edb/ref 1063 #edb/ref 17592186162057 #edb/ref 17592186045417] [17592186162973 #edb/ref 1058 #edb/ref 17592186162977 #edb/ref 17592186045417] [17592186162973 #edb/ref 1061 33963 #edb/ref 17592186045417] [17592186162973 #edb/ref 1062 #uuid "09f12104-7949-5867-9884-48e422a32857" #edb/ref 17592186045417] [17592186162973 #edb/ref 1063 #edb/ref 17592186162058 #edb/ref 17592186045417] [17592186162974 #edb/ref 1058 #edb/ref 17592186162971 #edb/ref 17592186045417] [17592186162974 #edb/ref 1061 33964 #edb/ref 17592186045417] [17592186162974 #edb/ref 1062 #uuid "65bbda75-37ec-5809-926a-0fb8d31c008d" #edb/ref 17592186045417] [17592186162974 #edb/ref 1063 #edb/ref 17592186163273 #edb/ref 17592186045417] [17592186162975 #edb/ref 1058 #edb/ref 17592186162972 #edb/ref 17592186045417] [17592186162975 #edb/ref 1061 33966 #edb/ref 17592186045417] [17592186162975 #edb/ref 1062 #uuid "55f9fd86-1f4a-5f2c-b7c2-a60113a4a9e8" #edb/ref 17592186045417] [17592186162975 #edb/ref 1063 #edb/ref 17592186163274 #edb/ref 17592186045417] [17592186162976 #edb/ref 1058 #edb/ref 17592186162973 #edb/ref 17592186045417] [17592186162976 #edb/ref 1061 33968 #edb/ref 17592186045417] [17592186162976 #edb/ref 1062 #uuid "e17beec2-91ed-5375-9c58-ab279784f2bf" #edb/ref 17592186045417] [17592186162976 #edb/ref 1063 #edb/ref 17592186163275 #edb/ref 17592186045417] [17592186162977 #edb/ref 1061 33969 #edb/ref 17592186045417] [17592186162977 #edb/ref 1062 #uuid "da23e59c-3020-5db2-8f5b-77675938bf0b" #edb/ref 17592186045417] [17592186162977 #edb/ref 1063 #edb/ref 17592186163276 #edb/ref 17592186045417] [17592186163273 #edb/ref 1064 "There are several important properties of the variance of a random variable that we can use to simplify expressions. \n\nFirstly, the variance of a constant is always zero. That is, for any constant $a,$ we have\n\n$$\n\\textrm{Var}[a] = 0.\n$$\n\nIntuitively, this makes sense. A constant does not vary, so the mean deviation from its expected value should be zero." #edb/ref 17592186045417] [17592186163273 #edb/ref 1065 5458 #edb/ref 17592186045417] [17592186163273 #edb/ref 1066 #uuid "6eb17ec7-1e57-5d75-8a71-9030a420602b" #edb/ref 17592186045417] [17592186163273 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186163274 #edb/ref 1064 "Suppose that $X$ is a random variable and $a$ is a constant. Then,\n\n$$\n\\textrm{Var}[aX] = a^2\\textrm{Var}[X].\n$$\n\nSo, for example, if we know that $\\textrm{Var}[X] = 2,$ then\n\n$$\n\\begin{aligned}\\text{Var}[3X] & ={3}^{2}\\cdot \\text{Var}[X] \\\\  & =9\\cdot \\text{Var}[X] \\\\  & =9\\cdot 2 \\\\  & =18.\\end{aligned}\n$$\n\nSimilarly,\n\n$$\n\\begin{aligned}\\text{Var}[-4X] & =(-4)^{2}\\cdot \\text{Var}[X] \\\\  & =16\\cdot \\text{Var}[X] \\\\  & =16\\cdot 2 \\\\  & =32.\\end{aligned}\n$$\n\n**Note:** To understand why we have to square the constant when we factor it outside the variance, it's helpful to remember that the variance is defined as the expected *squared* deviation from the mean:\n\n$$\n\\textrm{Var}[X] = \\textrm E [ (X - \\textrm E[X])^2 ]\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}\\text{Var}[aX] & =\\text{E}[(aX-\\text{E}[aX])^{2}] \\\\  & =\\text{E}[(aX-a\\text{E}[X])^{2}] \\\\  & =\\text{E}[{a}^{2}(X-\\text{E}[X])^{2}] \\\\  & ={a}^{2}\\text{E}[(X-\\text{E}[X])^{2}] \\\\  & ={a}^{2}\\text{Var}[X].\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186163274 #edb/ref 1065 5459 #edb/ref 17592186045417] [17592186163274 #edb/ref 1066 #uuid "d33b6982-066e-5c82-8138-0283ad8dccbb" #edb/ref 17592186045417] [17592186163274 #edb/ref 1067 "The Variance of a Scaled Random Variable" #edb/ref 17592186045417] [17592186163275 #edb/ref 1064 "Suppose that $X$ is a random variable and $a$ and $b$ are constants. It can be shown that\n\n$$\n\\textrm{Var}[aX+b] = a^2\\textrm{Var}[X].\n$$\n\nA proof of this result is given at the end of this lesson.\n\nTherefore, when a random variable is scaled by a factor of $a$ and shifted by a constant $b\\mathbin{:}$ \n\n- the variance is scaled by a factor of $a^2$ as before, and\n\n- the variance is unaffected by the shift.\n\nThe fact that shifting a random variable leaves the variance unaltered makes intuitive sense. Shifting all values of $X$ by a fixed amount does not change how far apart those values are from each other. \n\nFor example, if we know that $\\textrm{Var}[X] = 3,$ then\n\n$$\n\\begin{aligned}\\text{Var}[2X+1] & ={2}^{2}\\cdot \\text{Var}[X] \\\\  & ={2}^{2}\\cdot 3 \\\\  & =4\\cdot 3 \\\\  & =12.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186163275 #edb/ref 1065 5460 #edb/ref 17592186045417] [17592186163275 #edb/ref 1066 #uuid "1523e51b-84da-5100-809f-09fbcb0d80ba" #edb/ref 17592186045417] [17592186163275 #edb/ref 1067 "The Variance of a Transformed Random Variable" #edb/ref 17592186045417] [17592186163276 #edb/ref 1064 "We wish to prove the following result:\n\n$$\n\\textrm{Var}[aX+b] = a^2\\textrm{Var}[X]\n$$\n\nRecall that, by definition,\n\n$$\n\\textrm{Var}[X] = \\textrm E [ (X - \\textrm E[X])^2 ].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[aX+b] & =\\text{E}[(aX+b-\\text{E}[aX+b])^{2}].\\end{aligned}\n$$\n\nUsing the properties of expected value, we can simplify this as follows:\n\n$$\n\\begin{aligned}\\text{E}[(aX+b-\\text{E}[aX+b])^{2}] & =\\text{E}[(aX+b-a\\text{E}[X]-b)^{2}] \\\\  & =\\text{E}[(aX-a\\text{E}[X])^{2}] \\\\  & =\\text{E}[(a(X-\\text{E}[X]))^{2}] \\\\  & =\\text{E}[{a}^{2}(X-\\text{E}[X])^{2}] \\\\  & ={a}^{2}\\text{E}[(X-\\text{E}[X])^{2}] \\\\  & ={a}^{2}\\text{Var}[X]\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186163276 #edb/ref 1065 5461 #edb/ref 17592186045417] [17592186163276 #edb/ref 1066 #uuid "0372f0de-b6a6-58ee-8195-c04024e8f745" #edb/ref 17592186045417] [17592186163276 #edb/ref 1067 "Proof of the General Formula" #edb/ref 17592186045417] [17592186369024 #edb/ref 1075 #edb/ref 17592186369025 #edb/ref 17592186045417] [17592186369024 #edb/ref 1075 #edb/ref 17592186369026 #edb/ref 17592186045417] [17592186369024 #edb/ref 1075 #edb/ref 17592186369027 #edb/ref 17592186045417] [17592186369024 #edb/ref 1075 #edb/ref 17592186369028 #edb/ref 17592186045417] [17592186369024 #edb/ref 1075 #edb/ref 17592186369029 #edb/ref 17592186045417] [17592186369024 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186369024 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186369024 #edb/ref 1078 #edb/ref 17592186369028 #edb/ref 17592186045417] [17592186369024 #edb/ref 1079 #uuid "4b00d39d-85cd-55a1-8887-a4e8b0256715" #edb/ref 17592186045417] [17592186369025 #edb/ref 1080 "{k}^{2}" #edb/ref 17592186045417] [17592186369025 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369025 #edb/ref 1083 #uuid "33994916-4232-5681-a751-4c386d44f6c8" #edb/ref 17592186045417] [17592186369026 #edb/ref 1080 "1" #edb/ref 17592186045417] [17592186369026 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369026 #edb/ref 1083 #uuid "93325cb3-3cbe-5a46-acc2-fc1973572bf5" #edb/ref 17592186045417] [17592186369027 #edb/ref 1080 "\\frac{1}{{k}^{2}}" #edb/ref 17592186045417] [17592186369027 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369027 #edb/ref 1083 #uuid "4ece8c57-aa36-5399-a6b9-bdd774076d4b" #edb/ref 17592186045417] [17592186369028 #edb/ref 1080 "0" #edb/ref 17592186045417] [17592186369028 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369028 #edb/ref 1083 #uuid "501ab2a2-7b1a-5df1-8bc2-0cf675ae859b" #edb/ref 17592186045417] [17592186369029 #edb/ref 1080 "k" #edb/ref 17592186045417] [17592186369029 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045