7] [17592186369052 #edb/ref 1080 "({c}^{4}-4c)^{2}" #edb/ref 17592186045417] [17592186369052 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369052 #edb/ref 1083 #uuid "d79f1952-bf8a-52b1-872a-a76dbce24aee" #edb/ref 17592186045417] [17592186369053 #edb/ref 1080 "2" #edb/ref 17592186045417] [17592186369053 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369053 #edb/ref 1083 #uuid "839570a9-1ebc-55fb-8dd6-1a97d1617488" #edb/ref 17592186045417] [17592186369054 #edb/ref 1080 "1" #edb/ref 17592186045417] [17592186369054 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369054 #edb/ref 1083 #uuid "f18d9f23-0bbd-5f18-882c-50fb5339764e" #edb/ref 17592186045417] [17592186369055 #edb/ref 1080 "{c}^{4}-4c" #edb/ref 17592186045417] [17592186369055 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369055 #edb/ref 1083 #uuid "62512e18-69cb-57de-9a9b-3c334bf9d2ca" #edb/ref 17592186045417] [17592186369056 #edb/ref 1080 "0" #edb/ref 17592186045417] [17592186369056 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369056 #edb/ref 1083 #uuid "a6df3166-e673-5bd3-8ed1-b5c079ab4d46" #edb/ref 17592186045417] [17592186369071 #edb/ref 1068 #edb/ref 17592186369072 #edb/ref 17592186045417] [17592186369071 #edb/ref 1069 "q-109077" #edb/ref 17592186045417] [17592186369071 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186369071 #edb/ref 1071 "If $\\text{Var}[X]=\\frac{1}{2},$ calculate $\\text{Var}[-\\sqrt{2}X].$" #edb/ref 17592186045417] [17592186369071 #edb/ref 1072 #uuid "dda2c394-4ef1-5180-a3b3-c0865a6616dd" #edb/ref 17592186045417] [17592186369071 #edb/ref 1074 "Recall that for any random variable $X$ and constant $a,$ we have\n\n$$\n\\text{Var}[aX]={a}^{2}\\cdot \\text{Var}[X].\n$$\n\nIn our case, $a=-\\sqrt{2}.$ Therefore,\n\n$$\n\\begin{aligned}\\text{Var}[-\\sqrt{2}X] & ={(-\\sqrt{2})}^{2}\\cdot \\text{Var}[X] \\\\  & =2\\cdot \\frac{1}{2} \\\\  & =1.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186369072 #edb/ref 1075 #edb/ref 17592186369073 #edb/ref 17592186045417] [17592186369072 #edb/ref 1075 #edb/ref 17592186369074 #edb/ref 17592186045417] [17592186369072 #edb/ref 1075 #edb/ref 17592186369075 #edb/ref 17592186045417] [17592186369072 #edb/ref 1075 #edb/ref 17592186369076 #edb/ref 17592186045417] [17592186369072 #edb/ref 1075 #edb/ref 17592186369077 #edb/ref 17592186045417] [17592186369072 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186369072 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186369072 #edb/ref 1078 #edb/ref 17592186369075 #edb/ref 17592186045417] [17592186369072 #edb/ref 1079 #uuid "22255499-f030-5e65-8284-4fb7e947e99e" #edb/ref 17592186045417] [17592186369073 #edb/ref 1080 "-\\frac{\\sqrt{2}}{2}" #edb/ref 17592186045417] [17592186369073 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369073 #edb/ref 1083 #uuid "43beee00-4247-5f18-9c65-d505eb04f986" #edb/ref 17592186045417] [17592186369074 #edb/ref 1080 "\\frac{1}{2}" #edb/ref 17592186045417] [17592186369074 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369074 #edb/ref 1083 #uuid "73696326-cbe5-5fb6-9d65-41e78e12f51a" #edb/ref 17592186045417] [17592186369075 #edb/ref 1080 "1" #edb/ref 17592186045417] [17592186369075 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369075 #edb/ref 1083 #uuid "75d951a0-cd72-553b-a637-977acb232cfc" #edb/ref 17592186045417] [17592186369076 #edb/ref 1080 "\\frac{\\sqrt{2}}{2}" #edb/ref 17592186045417] [17592186369076 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369076 #edb/ref 1083 #uuid "69360083-d0ed-5be1-806f-6cfb272ed0b1" #edb/ref 17592186045417] [17592186369077 #edb/ref 1080 "-1" #edb/ref 17592186045417] [17592186369077 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369077 #edb/ref 1083 #uuid "159e7484-2295-5fd6-bcf0-a066ff4f6830" #edb/ref 17592186045417] [17592186369078 #edb/ref 1068 #edb/ref 17592186369079 #edb/ref 17592186045417] [17592186369078 #edb/ref 1069 "q-109089" #edb/ref 17592186045417] [17592186369078 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186369078 #edb/ref 1071 "The probability distribution of the random variable $X$ is given below. Given that $\\text{E}[X]=3,$ calculate $\\text{Var}[1-7X].$ \n\n| $x$ | $1$ | $2$ | $4$ |\n| --- | --- | --- | --- |\n| $f(x)$ | $\\frac{1}{7}$ | $\\frac{2}{7}$ | $\\frac{4}{7}$ |" #edb/ref 17592186045417] [17592186369078 #edb/ref 1072 #uuid "23073627-db67-5e1b-90ec-21216a699151" #edb/ref 17592186045417] [17592186369078 #edb/ref 1074 "Recall that for any random variable $X$ and constants $a$ and $b,$ we have\n\n$$\n\\text{Var}[aX+b]={a}^{2}\\cdot \\text{Var}[X].\n$$\n\nIn our case, $a=-7$ and $b=1.$ Therefore,\n\n$$\n\\begin{aligned}\\text{Var}[1-7X] & =(-7)^{2}\\cdot \\text{Var}[X] \\\\  & =49\\cdot \\text{Var}[X].\\end{aligned}\n$$\n\nWe can compute the variance of $X$ using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\nAdditionally, we're given that $\\text{E}[X]=3.$ \n\nWe start by computing $\\text{E}[{X}^{2}].$ Summing up the products of each value of ${X}^{2}$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={1}^{2}\\cdot f(1)+{2}^{2}\\cdot f(2)+{4}^{2}\\cdot f(4) \\\\  & =\\frac{1}{7}+4\\cdot \\frac{2}{7}+16\\cdot \\frac{4}{7} \\\\  & =\\frac{73}{7}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{73}{7}-{3}^{2} \\\\  & =\\frac{10}{7}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[1-7X] & =49\\cdot \\text{Var}[X] \\\\  & =49\\cdot \\frac{10}{7} \\\\  & =70.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186369079 #edb/ref 1075 #edb/ref 17592186369080 #edb/ref 17592186045417] [17592186369079 #edb/ref 1075 #edb/ref 17592186369081 #edb/ref 17592186045417] [175921