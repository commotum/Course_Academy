}{2})+1(\\frac{1}{8})+1(\\frac{1}{8})+4(\\frac{1}{4}) \\\\  & =\\frac{13}{4}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{13}{4}-{(-\\frac{1}{2})}^{2} \\\\  & =\\frac{13}{4}-\\frac{1}{4} \\\\  & =3.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[\\frac{1}{\\sqrt{3}}X] & =\\frac{1}{3}\\cdot \\text{Var}[X] \\\\  & =\\frac{1}{3}\\cdot 3 \\\\  & =1.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186369659 #edb/ref 1075 #edb/ref 17592186369660 #edb/ref 17592186045417] [17592186369659 #edb/ref 1075 #edb/ref 17592186369661 #edb/ref 17592186045417] [17592186369659 #edb/ref 1075 #edb/ref 17592186369662 #edb/ref 17592186045417] [17592186369659 #edb/ref 1075 #edb/ref 17592186369663 #edb/ref 17592186045417] [17592186369659 #edb/ref 1075 #edb/ref 17592186369664 #edb/ref 17592186045417] [17592186369659 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186369659 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186369659 #edb/ref 1078 #edb/ref 17592186369663 #edb/ref 17592186045417] [17592186369659 #edb/ref 1079 #uuid "9fedac39-f9a5-56d2-bb87-12bb34c0afda" #edb/ref 17592186045417] [17592186369660 #edb/ref 1080 "9" #edb/ref 17592186045417] [17592186369660 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369660 #edb/ref 1083 #uuid "1202808e-11d0-552c-b1f6-577bc207c5ae" #edb/ref 17592186045417] [17592186369661 #edb/ref 1080 "3" #edb/ref 17592186045417] [17592186369661 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369661 #edb/ref 1083 #uuid "208d9113-94ae-5cd0-b32e-167d16cd85ac" #edb/ref 17592186045417] [17592186369662 #edb/ref 1080 "\\frac{\\sqrt{3}}{3}" #edb/ref 17592186045417] [17592186369662 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369662 #edb/ref 1083 #uuid "317b5473-dac4-5c2d-8b4d-feccc81a4eae" #edb/ref 17592186045417] [17592186369663 #edb/ref 1080 "1" #edb/ref 1759218604541