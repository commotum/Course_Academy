e\">[</mo><mn>0.5</mn><mi>X</mi><mo stretchy=\"false\">]</mo></mtd><mtd><mi></mi><mo>=</mo><msup><mn>0.5</mn><mn>2</mn></msup><mo>⋅</mo><mtext>Var</mtext><mo stretchy=\"false\">[</mo><mi>X</mi><mo stretchy=\"false\">]</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>0.25</mn><mo>⋅</mo><mn>100</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>25.</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
