417] [17592186373142 #edb/ref 1083 #uuid "e0818182-cafe-552e-a4a0-98b0c1314881" #edb/ref 17592186045417] [17592186373143 #edb/ref 1080 "x+1=y-1=z-1" #edb/ref 17592186045417] [17592186373143 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186373143 #edb/ref 1083 #uuid "df5c957f-327c-59b5-a275-854f61c6c1b1" #edb/ref 17592186045417] [17592186373144 #edb/ref 1080 "x+1=y+1=z-1" #edb/ref 17592186045417] [17592186373144 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186373144 #edb/ref 1083 #uuid "4643467a-d570-58d2-ac66-45f1f209b1ac" #edb/ref 17592186045417] [17592186373145 #edb/ref 1080 "x+1=y+1=\\frac{z-1}{-1}" #edb/ref 17592186045417] [17592186373145 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186373145 #edb/ref 1083 #uuid "c777726a-c485-5a89-bead-338bff4761cc" #edb/ref 17592186045417] [17592186383223 #edb/ref 1068 #edb/ref 17592186383224 #edb/ref 17592186045417] [17592186383223 #edb/ref 1069 "q-131117" #edb/ref 17592186045417] [17592186383223 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186383223 #edb/ref 1071 "For the function $f(x,y,z)={x}^{3}yz-xy{z}^{2}$, find a vector that's perpendicular to the level surface that passes through the point where $(x,y,z)=(1,-2,1).$" #edb/ref 17592186045417] [17592186383223 #edb/ref 1072 #uuid "14180128-1a3b-5df5-945e-e4a1d12a6375" #edb/ref 17592186045417] [17592186383223 #edb/ref 1074 "A normal vector to the level surface that passes through the point where $(x,y,z)=(1,-2,1)$ can be found by computing \n$∇f(1,-2,1).$ \n\nSo, we first find the gradient and evaluate it at $(x,y,z)=(1,-1,2):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\text{ }j+{f}_{z}(x,y,z)\\text{ }k \\\\  & =\\frac{∂}{∂x}({x}^{3}yz-xy{z}^{2})\\,i+\\frac{∂}{∂y}({x}^{3}yz-xy{z}^{2})\\,j+\\frac{∂}{∂z}({x}^{3}yz-xy{z}^{2})\\,k \\\\  & =(3{x}^{2}yz-y{z}^{2})\\text{ }i+({x}^{3}z-x{z}^{2})\\text{ }j+({x}^{3}y-2xyz)\\text{ }k \\\\ ∇f(1,-2,1) & =(3(1)^{2}(-2)(1)-(-2)(1)^{2})\\,i+((1)^{3}(1)-(1)(1)^{2})\\,j+((1)^{3}(-2)-2(1)(-2)(1))\\,k \\\\  & =-4\\,i+2\\,k\\end{aligned}\n$$\n\nTherefore, $-4\\,i+2\\,k$ is perpendicular to the level surface that passes through the point where $(x,y,z)=(1,-2,1).$" #edb/ref 17592186045417] [17592186383224 #edb/ref 1075 #edb/ref 17592186383225 #edb/ref 17592186045417] [17592186383224 #edb/ref 1075 #edb/ref 17592186383226 #edb/ref 17592186045417] [17592186383224 #edb/ref 1075 #edb/ref 17592186383227 #edb/ref 17592186045417] [17592186383224 #edb/ref 1075 #edb/ref 17592186383228 #edb/ref 17592186045417] [17592186383224 #edb/ref 1075 #edb/ref 17592186383229 #edb/ref 17592186045417] [17592186383224 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186383224 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186383224 #edb/ref 1078 #edb/ref 17592186383229 #edb/ref 17592186045417] [17592186383224 #edb/ref 1079 #uuid "6d2c4aa2-5988-5483-be94-986ea095a0e4" #edb/ref 17592186045417] [17592186383225 #edb/ref 1080 "-2\\,j+4\\,k" #edb/ref 17592186045417] [17592186383225 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186383225 #edb/ref 1083 #uuid "ed39b029-85c3-5e97-8954-e0c143d2660e" #edb/ref 17592186045417] [17592186383226 #edb/ref 1080 "-4\\,i+2\\,j+2\\,k" #edb/ref 17592186045417] [17592186383226 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186383226 #edb/ref 1083 #uuid "09fedb26-ce0e-5168-aa47-838277d2a8de" #edb/ref 17592186045417] [17592186383227 #edb/ref 1080 "4\\,i-k" #edb/ref 17592186045417] [17592186383227 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186383227 #edb/ref 1083 #uuid "f08ae5ee-40c5-51a6-9971-2dada660033f" #edb/ref 17592186045417] [17592186383228 #edb/ref 1080 "-2\\,i-2\\,j+k" #edb/ref 17592186045417] [17592186383228 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186383228 #edb/ref 1083 #uuid "0e4bca3e-62b0-506e-ab11-64664053f91f" #edb/ref 17592186045417] [17592186383229 #edb/ref 1080 "-4\\,i+2\\,k" #edb/ref 17592186045417] [17592186383229 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186383229 #edb/ref 1083 #uuid "ec84b4f7-88ba-52da-a5bb-02c8fc23e908" #edb/ref 17592186045417] [17592186383230 #edb/ref 1068 #edb/ref 17592186383231 #edb/ref 17592186045417] [17592186383230 #edb/ref 1069 "q-131124" #edb/ref 17592186045417] [17592186383230 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186383230 #edb/ref 1071 "Find a vector equation of the normal line to the surface $4{z}^{2}-4{y}^{2}={x}^{2}-6x+12$ at the point $(2,0,1).$" #edb/ref 17592186045417] [17592186383230 #edb/ref 1072 #uuid "2fb8c052-74b8-5a3f-8748-9c302788bd84" #edb/ref 17592186045417] [17592186383230 #edb/ref 1074 "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}4{z}^{2}-4{y}^{2} & ={x}^{2}-6x \\\\ 4{z}^{2}-4{y}^{2}-{x}^{2}+6x & =12\\end{aligned}\n$$\n\nIf we set $f(x,y,z)=4{z}^{2}-4{y}^{2}-{x}^{2}+6x$, our surface can be viewed as the level surface $f(x,y,z)=12.$ \n\nA normal vector to the level surface that passes through the point $(2,0,1)$ can be found by computing $∇f(2,0,1).$ \n\nSo, we find the gradient and evaluate it at $(2,0,1):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\text{ }j+{f}_{z}(x,y,z)\\text{ }k \\\\  & =\\frac{∂}{∂x}(4{z}^{2}-4{y}^{2}-{x}^{2}+6x)i+\\frac{∂}{∂y}(4{z}^{2}-4{y}^{2}-{x}^{2}+6x)j+\\frac{∂}{∂z}(4{z}^{2}-4{y}^{2}-{x}^{2}+6x)k \\\\  & =(6-2x)\\,i-8y\\,j+8z\\,k \\\\ ∇f(2,0,1) & =(6-2(2))\\,i-8(0)\\text{ }j+8(1)\\,k \\\\  & =2\\,i+8\\,k \\\\  & =⟨2,0,8⟩\\end{aligned}\n$$\n\nFinally, the vector equation of the line that is parallel to $∇f(2,0,1)$ and passes through the point $(2,0,1)$ can be written as\n\n$$\n\\begin{aligned}r & =⟨2,0,1⟩+t\\,∇f(2,0,1)=⟨2,0,1⟩+t\\,⟨2,0,8⟩,\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$" #edb/ref 17592186045417] [17592186383231 #edb/ref 1075 #edb/ref 17592186383232 #edb/ref 17592186045417] [17592186383231 #edb/ref