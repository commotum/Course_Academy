 17592186045417] [17592186338552 #edb/ref 1075 #edb/ref 17592186337674 #edb/ref 17592186045417] [17592186338552 #edb/ref 1075 #edb/ref 17592186337771 #edb/ref 17592186045417] [17592186338552 #edb/ref 1075 #edb/ref 17592186338255 #edb/ref 17592186045417] [17592186338552 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186338552 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186338552 #edb/ref 1078 #edb/ref 17592186338255 #edb/ref 17592186045417] [17592186338552 #edb/ref 1079 #uuid "947eebdf-2bd7-5433-b16d-dbcb38a79114" #edb/ref 17592186045417] [17592186338573 #edb/ref 1075 #edb/ref 17592186337357 #edb/ref 17592186045417] [17592186338573 #edb/ref 1075 #edb/ref 17592186337484 #edb/ref 17592186045417] [17592186338573 #edb/ref 1075 #edb/ref 17592186337500 #edb/ref 17592186045417] [17592186338573 #edb/ref 1075 #edb/ref 17592186338139 #edb/ref 17592186045417] [17592186338573 #edb/ref 1075 #edb/ref 17592186338205 #edb/ref 17592186045417] [17592186338573 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186338573 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186338573 #edb/ref 1078 #edb/ref 17592186337500 #edb/ref 17592186045417] [17592186338573 #edb/ref 1079 #uuid "a093c235-9586-5c2c-a6e1-6f61aa48334d" #edb/ref 17592186045417] [17592186338680 #edb/ref 1075 #edb/ref 17592186336235 #edb/ref 17592186045417] [17592186338680 #edb/ref 1075 #edb/ref 17592186336607 #edb/ref 17592186045417] [17592186338680 #edb/ref 1075 #edb/ref 17592186336735 #edb/ref 17592186045417] [17592186338680 #edb/ref 1075 #edb/ref 17592186337220 #edb/ref 17592186045417] [17592186338680 #edb/ref 1075 #edb/ref 17592186338003 #edb/ref 17592186045417] [17592186338680 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186338680 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186338680 #edb/ref 1078 #edb/ref 17592186336735 #edb/ref 17592186045417] [17592186338680 #edb/ref 1079 #uuid "e48649d2-bf76-55fc-aef9-b0aff8e82c8d" #edb/ref 17592186045417] [17592186338929 #edb/ref 1068 #edb/ref 17592186338680 #edb/ref 17592186045417] [17592186338929 #edb/ref 1069 "q-71370" #edb/ref 17592186045417] [17592186338929 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186338929 #edb/ref 1071 "Find a unit normal vector to the level curve of the function $f(x,y)={x}^{2}+{y}^{2}$ that passes through the point where $(x,y)=(-\\frac{1}{2},\\frac{1}{2}).$" #edb/ref 17592186045417] [17592186338929 #edb/ref 1072 #uuid "22cfc584-e8e6-55e0-a1d3-35d71c5742a0" #edb/ref 17592186045417] [17592186338929 #edb/ref 1074 "A normal vector to the level curve that passes through the point where $(x,y)=(-\\frac{1}{2},\\frac{1}{2})$, can be found by computing $∇f(-\\frac{1}{2},\\frac{1}{2}).$ \n\nSo, we first find the gradient of $f(x,y)$ and evaluate it at $(x,y)=(-\\frac{1}{2},\\frac{1}{2}):$\n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂}{∂x}({x}^{2}+{y}^{2})\\text{ }i+\\frac{∂}{∂y}({x}^{2}+{y}^{2})\\text{ }j \\\\  & =2x\\text{ }i+2y\\text{ }j \\\\ ∇f(-\\frac{1}{2},\\frac{1}{2}) & =2(-\\frac{1}{2})\\text{ }i+2(\\frac{1}{2})\\text{ }j \\\\  & =-i+j\\end{aligned}\n$$\n\nFinally, we normalize $∇f(-\\frac{1}{2},\\frac{1}{2}):$\n\n$$\n\\begin{aligned}\\frac{∇f(-\\frac{1}{2},\\frac{1}{2})}{‖∇f(-\\frac{1}{2},\\frac{1}{2})‖} & =\\frac{-i+j}{\\sqrt{(-1)^{2}+(1)^{2}}} \\\\  & =\\frac{-i+j}{\\sqrt{2}} \\\\  & =-\\frac{\\sqrt{2}}{2}(i-j)\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186338930 #edb/ref 1068 #edb/ref 17592186338445 #edb/ref 17592186045417] [17592186338930 #edb/ref 1069 "q-71374" #edb/ref 17592186045417] [17592186338930 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186338930 #edb/ref 1071 "Find a unit normal vector to the level curve of the function $f(x,y)=x+3y-2xy$ that passes through the point where $(x,y)=(\\frac{3}{2},1).$" #edb/ref 17592186045417] [17592186338930 #edb/ref 1072 #uuid "436e814d-020d-5b28-b909-495bbb1c431a" #edb/ref 17592186045417] [17592186338930 #edb/ref 1074 "A normal vector to the level curve that passes through the point where $(x,y)=(\\frac{3}{2},1)$, can be found by computing $∇f(\\frac{3}{2},1).$ \n\nSo, we first find the gradient of $f(x,y)$ and evaluate it at $(x,y)=(\\frac{3}{2},1):$\n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂}{∂x}(x+3y-2xy)\\text{ }i+\\frac{∂}{∂y}(x+3y-2xy)\\text{ }j \\\\  & =(1-2y)\\text{ }i+(3-2x)\\text{ }j \\\\ ∇f(\\frac{3}{2},1) & =(1-2(1))\\text{ }i+(3-2(\\frac{3}{2}))\\text{ }j \\\\  & =-i\\end{aligned}\n$$\n\nFinally, we normalize $∇f(\\frac{3}{2},1):$\n\n$$\n\\begin{aligned}\\frac{∇f(\\frac{3}{2},1)}{‖∇f(\\frac{3}{2},1)‖} & =\\frac{-i}{1}=-i\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186338931 #edb/ref 1068 #edb/ref 17592186338331 #edb/ref 17592186045417] [17592186338931 #edb/ref 1069 "q-71381" #edb/ref 17592186045417] [17592186338931 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186338931 #edb/ref 1071 "Find a unit normal vector to the level curve of the function $f(x,y)={e}^{x+y}+x+y$ that passes through the point where $(x,y)=(0,0).$" #edb/ref 17592186045417] [17592186338931 #edb/ref 1072 #uuid "1092dcda-9470-51be-bb7f-4be55bcc6069" #edb/ref 17592186045417] [17592186338931 #edb/ref 1074 "A normal vector to the level curve that passes through the point where $(x,y)=(0,0)$, can be found by computing $∇f(0,0).$ \n\nSo, we first find the gradient of $f(x,y)$ and evaluate it at $(x,y)=(0,0):$\n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂}{∂x}({e}^{x+y}+x+y)\\text{ }i+\\frac{∂}{∂y}({e}^{x+y}+x+y)\\text{ }j \\\\  & =({e}^{x+y}+1)\\text{ }i+({e}^{x+y}+1)\\text{ }j \\\\ ∇f(0,0) & =({e}^{0+0}+1)\\text{ }i+({e}^{0+0}+1)\\text{ }j \\\\  & =2i+2j\\end{aligned}\n$$\n\nFinally, we normalize $∇f(0,0):$\n\n$$\n\\begin{aligned}\\frac{∇f(0,0)}{‖∇f(0,0)‖} & =\\frac{2i+2j}{\\sqrt{(2)^{2}+(2)^{2}}} \\\\  & =\\frac{2i+2j}{2\\sqrt{2}} \\\\  & =\\frac{\\sqrt{2}}{2}(i+j)\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186338932 #edb/ref 1068 #edb/ref 17592186338552 #edb/ref 17592186045417] [17592186338932 #edb/ref 1069 "q-71385" #edb/ref 17592186045417] [17592186338932 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186338932 #edb/ref 1071 "Consider the plane curve ${x}^{2}+{y}^{2}=4.$  Find the equation of the normal line to the curve at the point $(2,0).$" #edb/ref 17592186045417] [17592186338932 #edb/ref 1072 #uuid "05c970aa-8c53-5d2c-be67-cb9e3da21e11" #edb/ref 17592186045417] [17592186338932 #edb/ref 1074 "If we set $f(x,y)={x}^{2}+{y}^{2}$, our curve can be viewed as the level curve $f(x,y)=4.$  \n\nA normal vector to the level curve that passes through the point $(2,0)$ can be found by computing $∇f(2,0).$ \n\nSo, we find the gradient and evaluate it at $(2,0):$\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}({x}^{2}+{y}^{2})\\,i+\\frac{∂}{∂y}({x}^{2}+{y}^{2})\\,j \\\\  & =2x\\,i+2y\\,j \\\\ ∇f(2,0) & =2(2)\\,i+2(0)\\,j \\\\  & =4\\,i \\\\  & =⟨4,0⟩\\end{aligned}\n$$\n\nHence, $∇f(2,0)=⟨4,0⟩$ is a normal vector to the curve at $(2,0).$\n\nFinally, the Cartesian equation of the line that is parallel to $v=⟨{v}_{x},{v}_{y}⟩$ and passes through the point $({x}_{0},{y}_{0})$ can be written as:\n\n$$\n\\begin{aligned}(x-{x}_{0}){v}_{y}-(y-{y}_{0}){v}_{x} & =0 \\\\ (x-2)0-(y-0)4 & =0 \\\\ -4y & =0 \\\\ y & =0\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186338934 #edb/ref 1068 #edb/ref 17592186338397 #edb/ref 17592186045417] [17592186338934 #edb/ref 1069 "q-71390" #edb/ref 17592186045417] [17592186338934 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186338934 #edb/ref 1071 "Consider the plane curve ${y}^{2}+3{x}^{2}=4xy.$  Find the equation of the normal line to the curve at the point $(-1,-3).$" #edb/ref 17592186045417] [17592186338934 #edb/ref 1072 #uuid "f1df9544-1831-5471-b207-bb07d395022e" #edb/ref 17592186045417] [17592186338934 #edb/ref 1074 "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}{y}^{2}+3{x}^{2} & =4xy \\\\ {y}^{2}+3{x}^{2}-4xy & =0\\end{aligned}\n$$\n\nIf we set $f(x,y)={y}^{2}+3{x}^{2}-4xy$, our curve can be viewed as the level curve $f(x,y)=0.$  \n\nA normal vector to the level curve that passes through the point $(-1,-3)$ can be found by computing $∇f(-1,-3).$ \n\nSo, we find the gradient and evaluate it at $(-1,-3):$\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}({y}^{2}+3{x}^{2}-4xy)\\,i+\\frac{∂}{∂y}({y}^{2}+3{x}^{2}-4xy)\\,j \\\\  & =(6x-4y)\\,i+(2y-4x)\\,j \\\\ ∇f(-1,-3) & =(6(-1)-4(-3))\\,i+(2(-3)-4(-1))\\,j \\\\  & =6\\,i-2\\,j \\\\  & =⟨6,-2⟩\\end{aligned}\n$$\n\nHence, $∇f(-1,-3)=⟨6,-2⟩$ is a normal vector to the curve at $(-1,-3).$\n\nFinally, the Cartesian equation of the line that is parallel to $v=⟨{v}_{x},{v}_{y}⟩$ and passes through the point $({x}_{0},{y}_{0})$ can be written as:\n\n$$\n\\begin{aligned}\\frac{x-{x}_{0}}{{v}_{x}} & =\\frac{y-{y}_{0}}{{v}_{y}} \\\\ \\frac{x-(-1)}{6} & =\\frac{y-(-3)}{-2} \\\\ (-2)(x+1) & =6(y+3) \\\\ -2x-2 & =6y+18 \\\\ 6y+2x+20 & =0 \\\\ 3y+x+10 & =0\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186338936 #edb/ref 1068 #edb/ref 17592186338573 #edb/ref 17592186045417] [17592186338936 #edb/ref 1069 "q-71393" #edb/ref 17592186045417] [17592186338936 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186338936 #edb/ref 1071 "Consider the plane curve $\\operatorname{ln}⁡(x+y)=2xy.$  Find the equation of the normal line to the curve at the point $(0,1).$" #edb/ref 17592186045417] [17592186338936 #edb/ref 1072 #uuid "47afea57-2ac6-5bfd-8472-520b5199e74f" #edb/ref 17592186045417] [17592186338936 #edb/ref 1074 "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡(x+y) & =2xy \\\\ \\operatorname{ln}⁡(x+y)-2xy & =0\\end{aligned}\n$$\n\nIf we set $f(x,y)=\\operatorname{ln}⁡(x+y)-2xy$, our curve can be viewed as the level curve $f(x,y)=0.$  \n\nA normal vector to the level curve that passes through the point $(0,1)$ can be found by computing $∇f(0,1).$ \n\nSo, we find the gradient and evaluate it at $(0,1):$\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}(\\operatorname{ln}⁡(x+y)-2xy)\\,i+\\frac{∂}{∂y}(\\operatorname{ln}⁡(x+y)-2xy)\\,j \\\\  & =(\\frac{1}{x+y}-2y)\\,i+(\\frac{1}{x+y}-2x)\\,j \\\\ ∇f(0,1) & =(\\frac{1}{0+1}-2(1))\\,i+(\\frac{1}{0+1}-2(0))\\,j \\\\  & =-i+j \\\\  & =⟨-1,1⟩\\end{aligned}\n$$\n\nHence, $∇f(0,1)=⟨-1,1⟩$ is a normal vector to the curve at $(0,1).$\n\nFinally, the Cartesian equation of the line that is parallel to $v=⟨{v}_{x},{v}_{y}⟩$ and passes through the point $({x}_{0},{y}_{0})$ can be written as:\n\n$$\n\\begin{aligned}\\frac{x-{x}_{0}}{{v}_{x}} & =\\frac{y-{y}_{0}}{{v}_{y}} \\\\ \\frac{x-0}{-1} & =\\frac{y-1}{1} \\\\ -x & =y-1 \\\\ x+y-1 & =0\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186373007 #edb/ref 1075 #edb/ref 17592186373008 #edb/ref 17592186045417] [17592186373007 #edb/ref 1075 #edb/ref 17592186373009 #edb/ref 17592186045417] [17592186373007 #edb/ref 1075 #edb/ref 17592186373010 #edb/ref 17592186045417] [17592186373007 #edb/ref 1075 #edb/ref 17592186373011 #edb/ref 17592186045417] [17592186373007 #edb/ref 1075 #edb/ref 17592186373012 #edb/ref 17592186045417] [17592186373007 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186373007 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186373007 #edb/ref 1078 #edb/ref 17592186373010 #edb/ref 17592186045417] [17592186373007 #edb/ref 1079 #uuid "f074ec94-f4ab-59e4-98e4-6833b7d43d47" #edb/ref 17592186045417] [17592186373008 #edb/ref 1080 "\\frac{x-1}{2}=\\frac{y+1}{2}=-z" #edb/ref 17592186045417] [17592186373008 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186373008 #edb/ref 1083 #uuid "9dd151b9-79f9-5a66-8557-365b16a9535a" #edb/ref 17592186045417] [17592186373009 #edb/ref 1080 "x-1=\\frac{y}{2}=-z" #edb/ref 17592186045417] [17592186373009 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186373009 #e