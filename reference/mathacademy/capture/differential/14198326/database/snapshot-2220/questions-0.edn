d}1 \\\\ -3\\end{aligned}]+[\\begin{aligned}0 \\\\ 7\\end{aligned}]) \\\\  & =\\frac{1}{4}[\\begin{aligned}2 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{2} \\\\ 1\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186512864 :knowledge-point/_questions [{:db/id #edb/ref 17592186162094 :knowledge-point/id #uuid "f930dfb2-a688-5dbe-9233-09dbcd2ba383" :knowledge-point/title "Finding the Sample Mean of an Observation Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05e2dfad-4ec8-58fa-bd48-2e3147deaab4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 7\\end{aligned}]" :db/id #edb/ref 17592186512118} {:answer/id #uuid "5f5600c3-c4f7-59ec-bfd6-2e12ca94531d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{5}{4} \\\\ 7\\end{aligned}]" :db/id #edb/ref 17592186512326} {:answer/id #uuid "7d29c3e3-083f-5d63-97b5-7181ca00dde5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 6\\end{aligned}]" :db/id #edb/ref 17592186512394} {:answer/id #uuid "ca74f34a-cd90-530c-855e-6c0fa94d0f14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 \\\\ 7\\end{aligned}]" :db/id #edb/ref 17592186512587} {:answer/id #uuid "d5ccd631-16bb-571b-9fb5-c68392b29f6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{3}{4} \\\\ 6\\end{aligned}]" :db/id #edb/ref 17592186512606}] :answer-field/correct {:answer/id #uuid "d5ccd631-16bb-571b-9fb5-c68392b29f6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{3}{4} \\\\ 6\\end{aligned}]" :db/id #edb/ref 17592186512606} :answer-field/id #uuid "b64e05d2-d26b-59b5-8c83-b59f82b63c05" :answer-field/key "selection" :answer-field/type {:db/id #edb/re