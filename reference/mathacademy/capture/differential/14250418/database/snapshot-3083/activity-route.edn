#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186570832} :activity/id #uuid "5985754e-714a-5c2c-b300-e0ee4263e5d0" :activity/scope {:db/id #edb/ref 17592186049828 :topic/id #uuid "171bc42f-1e67-52f7-92c6-e9af227f8d0f" :topic/math-academy-id 1882} :activity/steps [{:db/id #edb/ref 17592186570806 :step/content {:db/id #edb/ref 17592186570791 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3eeca0e1-b6de-52ef-a755-30e10b649fb4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186570227}] :answer-field/correct {:db/id #edb/ref 17592186570227} :answer-field/id #uuid "16033fcf-6425-52d7-842c-b314f27cbd64" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186570585} {:answer-field/choices [{:answer/id #uuid "991ba2b0-831a-53eb-b183-63a7aa87cc69" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\le" :db/id #edb/ref 17592186570395}] :answer-field/correct {:db/id #edb/ref 17592186570395} :answer-field/id #uuid "24a33357-db32-588d-8f62-a8e54ad0fed1" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186570593} {:answer-field/choices [{:answer/id #uuid "66d81624-7ec5-5cda-a1be-d41d2b795a4a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\infty" :db/id #edb/ref 17592186570304}] :answer-field/correct {:db/id #edb/ref 17592186570304} :answer-field/id #uuid "53804295-71ff-5921-a1f0-85877fe7f459" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186570614}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fb786a48-6efc-557e-bdac-ba3e5bfceb11" :question/math-academy-id "q-250655" :question/problem "Find the range of the function $f(x)=-(x+7)(x+9).$\n\n{{field-1}}\n$<f(x)$\n{{field-2}}{{field-3}}" :question/worked-solution "The given parabola is written in factored form,\n\n$$\ny=a(x-{x}_{1})(x-{x}_{2}),\n$$\n\nwith $a=-1<0.$ \n\nBecause the leading coefficient is negative, the parabola opens downward. Consequently, there is no minimum output, and the vertex corresponds to the maximum output.\n\nThe two roots of the parabola are ${x}_{1}=-9$ and ${x}_{2}=-7,$ and we can find the $x$-coordinate of the vertex by taking the average of the roots:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2}=\\frac{-9-7}{2}=-8\\end{aligned}\n$$\n\nThen, we substitute $x=-8$ back into the function to find the $y$-value of the vertex:\n\n$$\n\\begin{aligned}y & =-(x+7)(x+9) \\\\  & =-(-8+7)(-8+9) \\\\  & =-(-1)\\cdot 1 \\\\  & =1\\end{aligned}\n$$\n\nTherefore, the vertex is $(-8,1),$ and the range of the function is $(-\\infty ,1],$ i.e. $-\\infty <f(x)\\le 1.$\n\n![](images/0c/0cb245de80be7125a1e8874781ed21fc2845f25f7ee8e1e43356819f87fe1b6c.png)"} :step/id #uuid "30cad7c6-2bfe-57a8-8544-4f6a46441b2e"} {:db/id #edb/ref 17592186570827 :step/content {:db/id #edb/ref 17592186570755 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f449186-68af-505d-8ba1-e89490d3588a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\infty ,1]" :db/id #edb/ref 17592186570323} {:answer/id #uuid "812ca881-ad52-5c82-8b1a-ad9ec2c3192f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[-7,\\infty )" :db/id #edb/ref 17592186570353} {:answer/id #uuid "892d7645-442d-5314-b45a-7ea9f816363b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-1,\\infty )" :db/id #edb/ref 17592186570366} {:answer/id #uuid "97d84504-9c16-5ada-9158-d437803d7880" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\infty ,-3]" :db/id #edb/ref 17592186570393} {:answer/id #uuid "dcf18488-82e6-55f7-bc88-70816d80833f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\infty ,-7]" :db/id #edb/ref 17592186570513}] :answer-field/correct {:db/id #edb/ref 17592186570513} :answer-field/id #uuid "e59cc3b3-2d1b-5a47-a0da-cf1c94d9ece9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186570684}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8a71e9cb-8bb6-5c17-8cab-a2b0b8515a29" :question/math-academy-id "q-90979" :question/problem "What is the range of the function $f(x)=-3(x+1)^{2}-7?$" :question/worked-solution "The parabola is written in vertex form, \n\n$$\ny=a(x-h)^{2}+k,\n$$\n\nwhere $a$ is the leading coefficient and $(h,k)$ is the vertex. \n\n- Since $h=-1$ and $k=-7,$ the vertex is $(-1,-7).$\n\n- Since $a=-3<0,$ the parabola opens downwards.\n\nBecause the parabola opens downwards, there is no minimum output, and the vertex corresponds to the maximum output. \n\nTherefore, the range is $(-\\infty ,-7].$\n\nThe corresponding diagram is shown below.\n\n![](images/21/21049fc3aa8d6e2b64c4fd5db723c00e5878473ad8b96f25271c46edc48ed3ea.png)"} :step/id #uuid "665ef093-e5bb-5ba9-9e9a-d396adc7f6c4" :step/next {:db/id #edb/ref 17592186570847}} {:db/id #edb/ref 17592186570832 :step/content {:db/id #edb/ref 17592186124875 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0df9a543-b5df-589d-9923-b17fb9588714" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\frac{4}{3},\\infty )" :db/id #edb/ref 17592186549338} {:answer/id #uuid "3d610a34-2b2c-5b7f-a6ee-1208ff230466" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\infty ,-\\frac{4}{3}]" :db/id #edb/ref 17592186549439} {:answer/id #uuid "5d61e674-449f-5c1e-8470-6d7a912ecbd3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\infty ,\\frac{1}{3}]" :db/id #edb/ref 17592186549503} {:answer/id #uuid "9f1dd293-3094-5184-81d3-8f43b189007b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\infty ,\\frac{4}{3}]" :db/id #edb/ref 17592186549619} {:answer/id #uuid "f1f407d3-59e6-5e5d-8e6f-2e775ce3251f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[-\\frac{4}{3},\\infty )" :db/id #edb/ref 17592186549764}] :answer-field/correct {:db/id #edb/ref 17592186549619} :answer-field/id #uuid "8f8e4aed-0ad7-583b-bf1d-eb2a74efae0c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186121850}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7bfd7586-e0f5-50a2-a9b8-3d8eb173ed99" :question/math-academy-id "q-35155" :question/problem "What is the range of the function $f(x)=-\\frac{1}{3}(x+2)(x-2)?$" :question/worked-solution "The given parabola is written in factored form,\n\n$$\ny=a(x-{x}_{1})(x-{x}_{2}),\n$$\n\nwith $a=-\\frac{1}{3}<0.$ \n\nBecause the leading coefficient is negative, the parabola opens downward. Consequently, there is no minimum output, and the vertex corresponds to the maximum output.\n\nThe two roots of the parabola are ${x}_{1}=-2$ and ${x}_{2}=2,$ and we can find the $x$-coordinate of the vertex by taking the average of the roots:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2}=\\frac{-2+2}{2}=0\\end{aligned}\n$$\n\nThen, we substitute $x=0$ back into the function to find the $y$-value of the vertex:\n\n$$\n\\begin{aligned}y & =-\\frac{1}{3}(x+2)(x-2) \\\\  & =-\\frac{1}{3}(0+2)(0-2) \\\\  & =-\\frac{1}{3}\\cdot 2\\cdot (-2) \\\\  & =\\frac{4}{3}\\end{aligned}\n$$\n\nTherefore, the vertex is $(0,\\frac{4}{3}),$ and the range of the function is $(-\\infty ,\\frac{4}{3}].$\n\n![](images/d9/d9c96e13ab078005333cdf02d8939c96d41fe6802b7f4caf0d4bab041cf8a314.png)"} :step/id #uuid "7095dfca-d543-5340-966b-1a6ee03b8d50" :step/next {:db/id #edb/ref 17592186570851}} {:db/id #edb/ref 17592186570847 :step/content {:db/id #edb/ref 17592186570754 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b63033a-24e2-5903-b295-91cc93bb9990" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\infty ,13]" :db/id #edb/ref 17592186570256} {:answer/id #uuid "9b259075-8cb8-5df3-945a-7a9c6ac033fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\infty ,14]" :db/id #edb/ref 17592186570398} {:answer/id #uuid "dc78e2b3-11f1-573d-b784-24f309474acc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[13,\\infty )" :db/id #edb/ref 17592186570510} {:answer/id #uuid "eaf2fb45-750e-5cdd-afa7-44f40ee5659d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[14,\\infty )" :db/id #edb/ref 17592186570535} {:answer/id #uuid "f1daca14-4c4e-530e-9222-4e3f4ba8d119" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[13,14]" :db/id #edb/ref 17592186570550}] :answer-field/correct {:db/id #edb/ref 17592186570398} :answer-field/id #uuid "27b48aea-ee27-5772-a6cc-4c2cfba244bb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186570595}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "87522f6e-547f-5501-803f-38e69a4ab8bc" :question/math-academy-id "q-106283" :question/problem "What is the range of the function $f(x)=-2(x+13)^{2}+14?$" :question/worked-solution "The parabola is written in vertex form, \n\n$$\ny=a(x-h)^{2}+k,\n$$\n\nwhere $a$ is the leading coefficient and $(h,k)$ is the vertex. \n\n- Since $h=-13$ and $k=14,$ the vertex is $(-13,14).$\n\n- Since $a=-2<0,$ the parabola opens downwards.\n\nBecause the parabola opens downwards, there is no minimum output, and the vertex corresponds to the maximum output. \n\nTherefore, the range is $(-\\infty ,14].$\n\nThe corresponding diagram is shown below.\n\n![](images/08/08b2ebf2fb3ecb8e02eed81d47e349dad22bde0d97e8920fabc75a8e2301da2b.png)"} :step/id #uuid "a0240a55-8160-5d0a-b1e1-609611199c9d" :step/next {:db/id #edb/ref 17592186570806}} {:db/id #edb/ref 17592186570851 :step/content {:db/id #edb/ref 17592186570780 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "403b07c6-f056-5c1e-9ced-36e0c1b0f3fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\infty ,1]" :db/id #edb/ref 17592186570231} {:answer/id #uuid "60cc0af6-8ea4-53b5-b553-6a9490590d4c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\infty ,3]" :db/id #edb/ref 17592186570293} {:answer/id #uuid "6c2b3537-03e7-553c-8206-65bd50cf13a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\infty ,-1]" :db/id #edb/ref 17592186570312} {:answer/id #uuid "cf772beb-dd46-5ca1-b434-51819c40e211" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[1,\\infty )" :db/id #edb/ref 17592186570485} {:answer/id #uuid "fc5e05d0-d612-5386-a5a0-a3bf0dde0b77" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[-3,\\infty )" :db/id #edb/ref 17592186570570}] :answer-field/correct {:db/id #edb/ref 17592186570231} :answer-field/id #uuid "4e87ba1c-6874-5d0a-996a-3c1acc628a9e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186570609}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e645c316-71e4-58c2-8dda-54dfd003d3ee" :question/math-academy-id "q-90968" :question/problem "What is the range of the function $f(x)=-{x}^{2}+6x-8?$" :question/worked-solution "The given parabola is written in standard form,\n\n$$\ny=a{x}^{2}+bx+c,\n$$\n\nwith $a=-1<0,$ $b=6,$ and $c=-8.$\n\nBecause the leading coefficient is negative, the parabola opens downward. Consequently, there is no minimum output, and the vertex corresponds to the maximum output.\n\nThe $x$-coordinate of the vertex is given by\n\n$$\nx=-\\frac{b}{2a}=-\\frac{6}{2\\cdot (-1)}=3.\n$$\n\nNow, we substitute $x=3$ back into the function to find the $y$-value of the vertex:\n\n$$\n\\begin{aligned}y & =-{x}^{2}+6x-8 \\\\  & =-(3)^{2}+6(3)-8 \\\\  & =-9+18-8 \\\\  & =1\\end{aligned}\n$$\n\nTherefore, the vertex is $(3,1),$ and the range of the function is $(-\\infty ,1].$\n\n![](images/36/362626b55b357f91efb0fc89a51361bd8a9be368a6645becd3db07580accaaff.png)"} :step/id #uuid "b221606f-e40b-54aa-b16e-e307f3403f69" :step/next {:db/id #edb/ref 17592186570827}}] :activity/title "Domain and Range 