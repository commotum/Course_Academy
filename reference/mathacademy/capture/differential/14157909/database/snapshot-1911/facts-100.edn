186045417] [17592186350940 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186350940 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186350940 #edb/ref 1078 #edb/ref 17592186349410 #edb/ref 17592186045417] [17592186350940 #edb/ref 1079 #uuid "88fe00de-5ec1-50d2-aa0b-e419400fd37b" #edb/ref 17592186045417] [17592186351336 #edb/ref 1068 #edb/ref 17592186350744 #edb/ref 17592186045417] [17592186351336 #edb/ref 1069 "q-81583" #edb/ref 17592186045417] [17592186351336 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186351336 #edb/ref 1071 "Consider the vector $x$ and the plane $r=sv+tw,$ where $s,t\\in R,$ and\n\n$$\nv=[\\begin{aligned}-3 \\\\ 2 \\\\ 1\\end{aligned}],\\,w=[\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}],\\,\\,x=[\\begin{aligned}-2 \\\\ -2 \\\\ -9\\end{aligned}].\n$$\n\nFind the orthogonal projection of $x$ onto the plane given that $v⊥w.$" #edb/ref 17592186045417] [17592186351336 #edb/ref 1072 #uuid "8e35039b-7bcf-5005-b2b8-d003962fb201" #edb/ref 17592186045417] [17592186351336 #edb/ref 1074 "Since our plane passes through the origin, it defines the subspace $S=\\text{Span}{v,w}$ in ${R}^{3}.$ \nAnd, since the set ${v,w}$ is orthogonal, the orthogonal projection of $x$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x={\\text{proj}}_{v}\\,x+{\\text{proj}}_{w}\\,x.\n$$\n\nSo, we first find the orthogonal projections of $x$ onto $\\text{Span}{{a}_{1}}$ and $\\text{Span}{{a}_{2}}:$\n\n$$\n\\begin{aligned}{\\text{proj}}_{v}\\,x & =\\frac{x\\cdot v}{v\\cdot v}v=\\frac{(-2)\\cdot (-3)+(-2)\\cdot 2+(-9)\\cdot 1}{(-3)^{2}+{2}^{2}+{1}^{2}}v=-\\frac{1}{2}[\\begin{aligned}-3 \\\\ 2 \\\\ 1\\end{aligned}] \\\\ {\\text{proj}}_{w}\\,x & =\\frac{x\\cdot w}{w\\cdot w}w=\\frac{(-2)\\cdot 1+(-2)\\cdot 2+(-9)\\cdot (-1)}{{1}^{2}+{2}^{2}+(-1)^{2}}w=\\frac{1}{2}[\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}]\\end{aligned}\n$$\n\n \n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{v}\\,x+{\\text{proj}}_{w}\\,x \\\\  & =-\\frac{1}{2}[\\begin{aligned}-3 \\\\ 2 \\\\ 1\\end{aligned}]+\\frac{1}{2}[\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}] \\\\  & =\\frac{1}{2}(-[\\begin{aligned}-3 \\\\ 2 \\\\ 1\\end{aligned}]+[\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}]) \\\\  & =[\\begin{aligned}2 \\\\ 0 \\\\ -1\\end{aligned}].\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186351339 #edb/ref 1068 #edb/ref 17592186350934 #edb/ref 17592186045417] [17592186351339 #edb/ref 1069 "q-81601" #edb/ref 17592186045417] [17592186351339 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186351339 #edb/ref 1071 "Consider the vector $x$ and the plane $r=sv+tw,$ where $s,t\\in R,$ and\n\n$$\nv=[\\begin{aligned}3 \\\\ -4 \\\\ 1\\end{aligned}],\\,w=[\\begin{aligned}5 \\\\ 4 \\\\ 1\\end{aligned}],\\,\\,x=[\\begin{aligned}-3 \\\\ -11 \\\\ 17\\end{aligned}].\n$$\n\nFind the orthogonal projection of $x$ onto the plane given that $v⊥w.$" #edb/ref 17592186045417] [17592186351339 #edb/ref 1072 #uuid "061b2c31-4a10-5d46-822a-c45bc18a019d" #edb/ref 17592186045417] [17592186351339 #edb/ref 1074 "Since our plane passes through the origin, it defines the subspace $S=\\text{Span}{v,w}$ in ${R}^{3}.$ \nAnd, since the set ${v,w}$ is orthogonal, the orthogonal projection of $x$ onto the subspace $S$ is given by \n\n$$\n{\\text{proj}}_{S}\\,x={\\text{proj}}_{v}\\,x+{\\text{proj}}_{w}\\,x.\n$$\n\nSo, we first find the orthogonal projections of $x$ onto $\\text{Span}{{a}_{1}}$ and $\\text{Span}{{a}_{2}}:$\n\n$$\n\\begin{aligned}{\\text{proj}}_{v}\\,x & =\\frac{x\\cdot v}{v\\cdot v}v=\\frac{(-3)\\cdot 3+(-11)\\cdot (-4)+17\\cdot 1}{{3}^{2}+(-4)^{2}+{1}^{2}}v=[\\begin{aligned}6 \\\\ -8 \\\\ 2\\end{aligned}] \\\\ {\\text{proj}}_{w}\\,x & =\\frac{x\\cdot w}{w\\cdot w}w=\\frac{(-3)\\cdot 5+(-11)\\cdot 4+17\\cdot 1}{{5}^{2}+{4}^{2}+{1}^{2}}w=[\\begin{aligned}-5 \\\\ -4 \\\\ -1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{v}\\,x+{\\text{proj}}_{w}\\,x \\\\  & =[\\begin{aligned}6 \\\\ -8 \\\\ 2\\end{aligned}]+[\\begin{aligned}-5 \\\\ -4 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ -12 \\\\ 1\\end{aligned}].\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186351473 #edb/ref 1068 #edb/ref 17592186350940 #edb/ref 17592186045417] [17592186351473 #edb/ref 1069 "q-82978" #edb/ref 17592186045417] [17592186351473 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186351473 #edb/ref 1071 "Consider the vector $x$ and the subspace $S=\\text{Span}{{a}_{1},{a}_{2},{a}_{3}}$ where\n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ 0 \\\\ 3 \\\\ -2\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}2 \\\\ 3 \\\\ 0 \\\\ 1\\end{aligned}],\\,{a}_{3}=[\\begin{aligned}0 \\\\ -1 \\\\ 2 \\\\ 3\\end{aligned}],\\,\\,x=[\\begin{aligned}1 \\\\ 7 \\\\ 3 \\\\ -2\\end{aligned}].\n$$\n\nFind the acute angle between $x$ and the subspace $S$ given that the set ${{a}_{1},{a}_{2},{a}_{3}}$ is orthogonal." #edb/ref 17592186045417] [17592186351473 #edb/ref 1072 #uuid "7d244080-c289-59c7-a494-e5da1783db9c" #edb/ref 17592186045417] [17592186351473 #edb/ref 1074 "Since the set ${{a}_{1},{a}_{2},{a}_{3}}$ is orthogonal, the orthogonal projection of $x$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x+{\\text{proj}}_{{a}_{3}}x.\n$$\n\nSo, we first find the orthogonal projections of $x$ onto $\\text{Span}{{a}_{1}},$ $\\text{Span}{{a}_{2}}$ and $\\text{Span}{{a}_{3}}:$\n\n$$\n\\begin{aligned}{\\text{proj}}_{{a}_{1}}x & =\\frac{x\\cdot {a}_{1}}{{a}_{1}\\cdot {a}_{1}}{a}_{1}=\\frac{1\\cdot 1+7\\cdot 0+3\\cdot 3+(-2)\\cdot (-2)}{{1}^{2}+{0}^{2}+{3}^{2}+(-2)^{2}}{a}_{1}=[\\begin{aligned}1 \\\\ 0 \\\\ 3 \\\\ -2\\end{aligned}] \\\\ {\\text{proj}}_{{a}_{2}}x & =\\frac{x\\cdot {a}_{2}}{{a}_{2}\\cdot {a}_{2}}{a}_{2}=\\frac{1\\cdot 2+7\\cdot 3+3\\cdot 0+(-2)\\cdot 1}{{2}^{2}+{3}^{2}+{0}^{2}+{1}^{2}}{a}_{2}=\\frac{3}{2}[\\begin{aligned}2 \\\\ 3 \\\\ 0 \\\\ 1\\end{aligned}] \\\\ {\\text{proj}}_{{a}_{3}}x & =\\frac{x\\cdot {a}_{3}}{{a}_{3}\\cdot {a}_{3}}{a}_{3}=\\frac{1\\cdot 0+7\\cdot (-1)+3\\cdot 2+(-2)\\cdot 3}{{0}^{2}+(-1)^{2}+{2}^{2}+{3}^{2}}{a}_{3}=(-\\frac{1}{2})[\\begin{aligned}0 \\\\ -1 \\\\ 2 \\\\ 3\\end{aligned}]\\end{aligned}\n$$\n\n \n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x+{\\text{proj}}_{{a}_{3}}x \\\\  & =[\\begin{aligned}1 \\\\ 0 \\\\ 3 \\\\ -2\\end{aligned}]+\\frac{3}{2}[\\begin{aligned}2 \\\\ 3 \\\\ 0 \\\\ 1\\end{aligned}]+(-\\frac{1}{2})[\\begin{aligned}0 \\\\ -1 \\\\ 2 \\\\ 3\\end{aligned}] \\\\  & =\\frac{1}{2}([\\begin{aligned}2 \\\\ 0 \\\\ 6 \\\\ -4\\end{aligned}]+3[\\begin{aligned}2 \\\\ 3 \\\\ 0 \\\\ 1\\end{aligned}]+(-1)[\\begin{aligned}0 \\\\ -1 \\\\ 2 \\\\ 3\\end{aligned}]) \\\\  & =\\frac{1}{2}[\\begin{aligned}8 \\\\ 10 \\\\ 4 \\\\ -4\\end{aligned}] \\\\  & =[\\begin{aligned}4 \\\\ 5 \\\\ 2 \\\\ -2\\end{aligned}].\\end{aligned}\n$$\n\n \n\nThe acute angle between $x$ and $S$ is the acute angle between $x$ and ${\\text{proj}}_{S}x$ or any other non-zero vector that is parallel to ${\\text{proj}}_{S}x.$ \n\nComputing the cosine using the dot product, we obtain \n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{x\\cdot {\\text{proj}}_{S}\\,x}{‖x‖\\,‖{\\text{proj}}_{S}\\,x‖} \\\\  & =\\frac{1\\cdot 4+7\\cdot 5+3\\cdot 2+(-2)\\cdot (-2)}{\\sqrt{{1}^{2}+{7}^{2}+{3}^{2}+(-2)^{2}}\\sqrt{{4}^{2}+{5}^{2}+{2}^{2}+(-2)^{2}}} \\\\  & =\\frac{49}{\\sqrt{63}\\sqrt{49}} \\\\  & =\\frac{49}{3\\sqrt{7}\\cdot 7} \\\\  & =\\frac{\\sqrt{7}}{3}.\\end{aligned}\n$$\n\n \n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{\\sqrt{7}}{3})≈{28.13}^{∘},\n$$\n\nwhich is already an acute angle." #edb/ref 17592186045417] [17592186351474 #edb/ref 1068 #edb/ref 17592186350839 #edb/ref 17592186045417] [17592186351474 #edb/ref 1069 "q-82979" #edb/ref 17592186045417] [17592186351474 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186351474 #edb/ref 1071 "Consider the vector $x$ and the subspace $S=\\text{Span}{{a}_{1},{a}_{2},{a}_{3}}$ where\n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ 2 \\\\ -1 \\\\ 0\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}-2 \\\\ 1 \\\\ 0 \\\\ 2\\end{aligned}],\\,{a}_{3}=[\\begin{aligned}1 \\\\ 0 \\\\ 1 \\\\ 1\\end{aligned}],\\,\\,x=[\\begin{aligned}-3 \\\\ 1 \\\\ 5 \\\\ 1\\end{aligned}].\n$$\n\nFind the acute angle between $x$ and the subspace $S$ given that the set ${{a}_{1},{a}_{2},{a}_{3}}$ is orthogonal." #edb/ref 17592186045417] [17592186351474 #edb/ref 1072 #uuid "5be09e3c-1b36-5bfe-b41d-3d8f88facd1a" #edb/ref 17592186045417] [17592186351474 #edb/ref 1074 "Since the set ${{a}_{1},{a}_{2},{a}_{3}}$ is orthogonal, the orthogonal projection of $x$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x+{\\text{proj}}_{{a}_{3}}x.\n$$\n\nSo, we first find the orthogonal projections of $x$ onto $\\text{Span}{{a}_{1}},$ $\\text{Span}{{a}_{2}}$ and $\\text{Span}{{a}_{3}}:$\n\n$$\n\\begin{aligned}{\\text{proj}}_{{a}_{1}}x & =\\frac{x\\cdot {a}_{1}}{{a}_{1}\\cdot {a}_{1}}{a}_{1}=\\frac{(-3)\\cdot 1+1\\cdot 2+5\\cdot (-1)+1\\cdot 0}{{1}^{2}+{2}^{2}+(-1)^{2}+{0}^{2}}{a}_{1}=(-1)[\\begin{aligned}1 \\\\ 2 \\\\ -1 \\\\ 0\\end{aligned}]=[\\begin{aligned}-1 \\\\ -2 \\\\ 1 \\\\ 0\\end{aligned}] \\\\ {\\text{proj}}_{{a}_{2}}x & =\\frac{x\\cdot {a}_{2}}{{a}_{2}\\cdot {a}_{2}}{a}_{2}=\\frac{(-3)\\cdot (-2)+1\\cdot 1+5\\cdot 0+1\\cdot 2}{(-2)^{2}+{1}^{2}+{0}^{2}+{2}^{2}}{a}_{2}=[\\begin{aligned}-2 \\\\ 1 \\\\ 0 \\\\ 2\\end{aligned}] \\\\ {\\text{proj}}_{{a}_{3}}x & =\\frac{x\\cdot {a}_{3}}{{a}_{3}\\cdot {a}_{3}}{a}_{3}=\\frac{(-3)\\cdot 1+1\\cdot 0+5\\cdot 1+1\\cdot 1}{{1}^{2}+{0}^{2}+{1}^{2}+{1}^{2}}{a}_{3}=[\\begin{aligned}1 \\\\ 0 \\\\ 1 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\n \n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x+{\\text{proj}}_{{a}_{3}}x \\\\  & =[\\begin{aligned}-1 \\\\ -2 \\\\ 1 \\\\ 0\\end{aligned}]+[\\begin{aligned}-2 \\\\ 1 \\\\ 0 \\\\ 2\\end{aligned}]+[\\begin{aligned}1 \\\\ 0 \\\\ 1 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}-2 \\\\ -1 \\\\ 2 \\\\ 3\\end{aligned}].\\end{aligned}\n$$\n\n \n\nThe acute angle between $x$ and $S$ is the acute angle between $x$ and ${\\text{proj}}_{S}x$ or any other non-zero vector that is parallel to ${\\text{proj}}_{S}x.$ \n\nComputing the cosine using the dot product, we obtain \n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{x\\cdot {\\text{proj}}_{S}\\,x}{‖x‖\\,‖{\\text{proj}}_{S}\\,x‖} \\\\  & =\\frac{(-3)\\cdot (-2)+1\\cdot (-1)+5\\cdot 2+1\\cdot 3}{\\sqrt{(-3)^{2}+{1}^{2}+{5}^{2}+{1}^{2}}\\sqrt{(-2)^{2}+(-1)^{2}+{2}^{2}+{3}^{2}}} \\\\  & =\\frac{18}{\\sqrt{36}\\sqrt{18}} \\\\  & =\\frac{18}{6\\cdot 3\\sqrt{2}} \\\\  & =\\frac{\\sqrt{2}}{2}.\\end{aligned}\n$$\n\n \n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{\\sqrt{2}}{2})=\\frac{\\pi }{4},\n$$\n\nwhich is already an acute angle." #edb/ref 17592186045417] [17592186373038 #edb/ref 1075 #edb/ref 17592186373039 #edb/ref 17592186045417] [17592186373038 #edb/ref 1075 #edb/ref 17592186373040 #edb/ref 17592186045417] [17592186373038 #edb/ref 1075 #edb/ref 17592186373041 #edb/ref 17592186045417] [17592186373038 #edb/ref 1075 #edb/ref 17592186373042 #edb/ref 17592186045417] [17592186373038 #edb/ref 1075 #edb/ref 17592186373043 #edb/ref 17592186045417] [17592186373038 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186373038 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186373038 #edb/ref 1078 #edb/ref 17592186373043 #edb/ref 17592186045417] [17592186373038 #edb/ref 1079 #uuid "06a5bcdf-7363-5a46-9be0-a09ed9a92fa0" #edb/ref 17592186045417] [17592186373039 #edb/ref 1080 "\\frac{2\\pi }{5}" #edb/ref 17592186045417] [17592186373039 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 175921