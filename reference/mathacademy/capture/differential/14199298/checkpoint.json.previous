      "solution": {
        "status": "ambiguous",
        "reasoning": "Even distribution means each forest's share of plants equals its area share. Forest C has share 1−0.40−0.25=0.35. Thus P(poisonous)=0.40×0.30+0.25×0.20+0.35×0.06=0.120+0.050+0.021=0.191, option b. No Math Academy answer or grade for this question is captured; the worked example concerns a different problem.",
        "confidence": 1,
        "answers": [
          {
            "key": "selection",
            "correct_value": "0.191",
            "correct_option": "b",
            "value_type": "math",
            "wrong_value": "0.233",
            "correct_keys": [],
            "wrong_keys": [],
            "ma_value": null,
            "ma_basis": "none",
            "ma_evidence": "",
