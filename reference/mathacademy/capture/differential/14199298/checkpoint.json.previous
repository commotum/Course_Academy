><mo stretchy=\"false\">)</mo><mo>+</mo><mi>P</mi><mo stretchy=\"false\">(</mo><mi>G</mi><mo>∩</mo><mi>B</mi><mo stretchy=\"false\">)</mo><mo>+</mo><mi>P</mi><mo stretchy=\"false\">(</mo><mi>G</mi><mo>∩</mo><mi>C</mi><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>90</mn><mn>200</mn></mfrac></mstyle></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>20</mn><mn>200</mn></mfrac></mstyle><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>30</mn><mn>200</mn></mfrac></mstyle><mo>+</mo><mi>P</mi><mo stretchy=\"false\">(</mo><mi>G</mi><mo>∩</mo><mi>C</mi><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd><mi>P</mi><mo stretchy=\"false\">(</mo><mi>G</mi><mo>∩</mo><mi>C</mi><mo stretchy=\"false\">)</mo></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>90</mn><mn>200</mn></mfrac></mstyle><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>20</mn><mn>200</mn></mfrac></mstyle><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>30</mn><mn>200</mn></mfrac></mstyle></mtd></mtr><mtr><mtd><mi>P</mi><mo stretchy=\"false\">(</mo><mi>G</mi><mo>∩</mo><mi>C</mi><mo stretchy=\"false\">)</mo></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>40</mn><mn>200</mn></mfrac></mstyle></mtd></mtr><mtr><mtd><mi>P</mi><mo stretchy=\"false\">(</mo><mi>G</mi><mo>∩</mo><mi>C</mi><mo stretchy=\"false\">)</mo></mtd><mtd><mi></mi><mo>=</mo><mn>20</mn><mi mathvariant=\"normal\">%</mi></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container>      </p>\n</div></div>",
