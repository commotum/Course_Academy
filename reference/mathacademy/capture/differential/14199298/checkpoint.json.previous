      "solution": {
        "status": "ambiguous",
        "reasoning": "Each bag is selected with probability 1/3 and contains 20 marbles. Thus P(red)=(1/3)(12/20+14/20+10/20)=36/60=3/5, option c. No Math Academy answer or grade for this question is captured; the worked example concerns a different problem.",
        "confidence": 1,
        "answers": [
          {
            "key": "selection",
            "correct_value": "\\frac{3}{5}",
            "correct_option": "c",
            "value_type": "math",
            "wrong_value": "\\frac{1}{2}",
            "correct_keys": [],
            "wrong_keys": [],
