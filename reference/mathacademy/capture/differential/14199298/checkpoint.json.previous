\"></use>\n <use xlink:href=\"#E5-MJMAIN-2B\" x=\"10354\" y=\"0\"></use>\n <use xlink:href=\"#E5-MJMATHI-50\" x=\"11354\" y=\"0\"></use>\n <use xlink:href=\"#E5-MJMAIN-28\" x=\"12106\" y=\"0\"></use>\n <use xlink:href=\"#E5-MJMATHI-41\" x=\"12495\" y=\"0\"></use>\n <use xlink:href=\"#E5-MJMAIN-7C\" x=\"13246\" y=\"0\"></use>\n<g transform=\"translate(13524,0)\">\n <use xlink:href=\"#E5-MJMATHI-42\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E5-MJMAIN-32\" x=\"1074\" y=\"-213\"></use>\n</g>\n <use xlink:href=\"#E5-MJMAIN-29\" x=\"14738\" y=\"0\"></use>\n <use xlink:href=\"#E5-MJMATHI-50\" x=\"15127\" y=\"0\"></use>\n <use xlink:href=\"#E5-MJMAIN-28\" x=\"15879\" y=\"0\"></use>\n<g transform=\"translate(16268,0)\">\n <use xlink:href=\"#E5-MJMATHI-42\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E5-MJMAIN-32\" x=\"1074\" y=\"-213\"></use>\n</g>\n <use xlink:href=\"#E5-MJMAIN-29\" x=\"17482\" y=\"0\"></use>\n <use xlink:href=\"#E5-MJMAIN-2B\" x=\"18093\" y=\"0\"></use>\n <use xlink:href=\"#E5-MJMATHI-50\" x=\"19094\" y=\"0\"></use>\n <use xlink:href=\"#E5-MJMAIN-28\" x=\"19846\" y=\"0\"></use>\n <use xlink:href=\"#E5-MJMATHI-41\" x=\"20235\" y=\"0\"></use>\n <use xlink:href=\"#E5-MJMAIN-7C\" x=\"20986\" y=\"0\"></use>\n<g transform=\"translate(21264,0)\">\n <use xlink:href=\"#E5-MJMATHI-42\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E5-MJMAIN-33\" x=\"1074\" y=\"-213\"></use>\n</g>\n <use xlink:href=\"#E5-MJMAIN-29\" x=\"22477\" y=\"0\"></use>\n <use xlink:href=\"#E5-MJMATHI-50\" x=\"22867\" y=\"0\"></use>\n <use xlink:href=\"#E5-MJMAIN-28\" x=\"23618\" y=\"0\"></use>\n<g transform=\"translate(24008,0)\">\n <use xlink:href=\"#E5-MJMATHI-42\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E5-MJMAIN-33\" x=\"1074\" y=\"-213\"></use>\n</g>\n <use xlink:href=\"#E5-MJMAIN-29\" x=\"25221\" y=\"0\"></use>\n <use xlink:href=\"#E5-MJMAIN-2E\" x=\"25611\" y=\"0\"></use>\n</g>\n</svg></span></p>\n<p>Let's see an example of how to apply this.</p>\n\n        </div>",
