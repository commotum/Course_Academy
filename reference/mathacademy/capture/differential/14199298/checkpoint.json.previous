        "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14199298/observations/step-t6446-0195ee0a344c3b55a0c7.html",
        "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14199298/observations/step-t6446-0195ee0a344c3b55a0c7.png",
        "source_url": "https://mathacademy.com/tasks/14199298/topics/971/lesson",
        "captured_at": 1791972169.3939795,
