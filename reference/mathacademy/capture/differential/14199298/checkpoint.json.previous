        "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14199298/observations/step-t6295-483b26d426d74ca5afef.html",
        "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14199298/observations/step-t6295-483b26d426d74ca5afef.png",
        "source_url": "https://mathacademy.com/tasks/14199298/topics/971/lesson",
