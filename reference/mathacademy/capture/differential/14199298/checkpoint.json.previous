          "url": "https://mathacademy.com/learn",
          "captured_at": 1791972150.2499323,
          "source_sha256": "38efb6c08b26a7775e270e624ed82ee8737691104fe14f52fe647a38375f711a",
          "source_file": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/browser-originals/38efb6c08b26a7775e270e624ed82ee8737691104fe14f52fe647a38375f711a.html",
