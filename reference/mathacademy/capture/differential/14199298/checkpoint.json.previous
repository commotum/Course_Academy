          "html": "<div class=\"step\" contentid=\"6296\" id=\"step-836334\" stepid=\"836334\" steptype=\"tutorial\" style=\"display: block\">\n<div class=\"stepHeader\">\n<div class=\"stepName\">\n<a class=\"stepAnchor\" id=\"stepAnchor-836334\" name=\"step-6\">The Law of Total Probability in Terms of Conditional Probability</a>\n</div>\n<div class=\"helpButton\" stepid=\"836334\">?</div>\n</div>\n<style type=\"text/css\">\n                            .mjpage .MJX-monospace {\n                            font-family: monospace\n                            }\n\n                            .mjpage .MJX-sans-serif {\n                            font-family: sans-serif\n                            }\n\n                            .mjpage {\n                            display: inline;\n                            font-style: normal;\n                            font-weight: normal;\n                            line-height: normal;\n                            font-size: 100%;\n                            font-size-adjust: none;\n                            text-indent: 0;\n                            text-align: left;\n                            text-transform: none;\n                            letter-spacing: normal;\n                            word-spacing: normal;\n                            word-wrap: normal;\n                            white-space: nowrap;\n                            float: none;\n                            direction: ltr;\n                            max-width: none;\n                            max-height: none;\n                            min-width: 0;\n                            min-height: 0;\n                            border: 0;\n                            padding: 0;\n                            margin: 0\n                            }\n\n                            .mjpage * {\n                            transition: none;\n                            -webkit-transition: none;\n                            -moz-transition: none;