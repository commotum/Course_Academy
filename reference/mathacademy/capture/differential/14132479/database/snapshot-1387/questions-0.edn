r-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186433265}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2b82cd64-97c1-5cdd-8cc8-36a5f17dbd56" :question/math-academy-id "q-143252" :question/problem "If ${X}_{1},{X}_{2},…,{X}_{100}$ is a sample of size $n=100$ drawn from a population with mean $\\mu =35$ and variance ${\\sigma }^{2}=16,$ what is $\\text{E}[\\overset{―}{X}]?$" :question/worked-solution "Suppose ${X}_{1},{X}_{2},…,{X}_{n}$ is a sequence of random variables representing a random sample of size $n$ drawn from a population with population mean $\\mu .$ Then, the sample mean $\\overset{―}{X}$ is given by\n\n$$\n\\overset{―}{X}=\\frac{1}{n}{\\sum }_{i=1}^{n}{X}_{i}.\n$$\n\nSince $\\overset{―}{X}$ is an unbiased estimator of $\\mu ,$ we have\n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu .\n$$\n\nTherefore, since the population mean $\\mu =35,$ we have that $\\text{E}[\\overset{―}{X}]=35.$"}] [{:db/id #edb/ref 17592186433279 :knowledge-point/_questions [{:db/id #edb/ref 17592186157392 :knowledge-point/id #uuid "38455e74-50c2-5581-b9e1-a8dd0c85f826" :knowledge-point/title "The Expected Value of the Sample Mean"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7711b3da-ec81-51bb-a8b1-cc66352671e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.25\\,\\text{cm}" :db/id #edb/ref 17592186433245} {:answer/id #uuid "7a9be8b9-fbb8-5034-a55d-f530a53a0969" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.5\\,\\text{cm}" :db/id #edb/ref 17592186433247} {:answer/id #uuid "cfc00a78-c8ed-5640-8fa8-0a86f580e4cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\,\\text{cm}" :db/id #edb/ref 17592186433255} {:answer/id #uuid "e2541e14-e5d3-5bb3-9765-5c6a45e991aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6.5\\,\\text{cm}" :db/id #edb/ref 17592186433260} {:answer/id #uuid "ec3e6ae7-41da-5e42-94d1-edee1b8cf018" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,\\text{cm}" :db/id #edb/ref 17592186433261}] :answer-field/correct {:answer/id #uuid "ec3e6ae7-41da-5e42-94d1-edee1b8cf018" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,\\text{cm}" :db/id #edb/ref 17592186433261} :answer-field/id #uuid "379b4b8b-013a-5a9b-8bd8-ddcccbd4e2ef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186433266}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bb20853b-4548-57d9-b738-08eff2a48018" :question/math-academy-id "q-143287" :question/problem "A sample ${X}_{1},{X}_{2}$ of two bolts is drawn from a population. The population has bolts of two different lengths, $5\\,\\text{cm}$ and $\\text{8}\\,\\text{cm},$ distributed in the ratio $2:1.$ Calculate $\\text{E}[\\overset{―}{X}].$" :question/worked-solution "Suppose ${X}_{1},{X}_{2},…,{X}_{n}$ is a sequence of random variables representing a random sample of size $n$ drawn from a population with population mean $\\mu .$ Then, the sample mean $\\overset{―}{X}$ is given by\n\n$$\n\\overset{―}{X}=\\frac{1}{n}{\\sum }_{i=1}^{n}{X}_{i}.\n$$\n\nSince $\\overset{―}{X}$ is an unbiased estimator of $\\mu ,$ we have\n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu .\n$$\n\nWe're told that the bolts in the population have lengths $5\\,\\text{cm}$ and $\\text{8}\\,\\text{cm},$ and these are distributed in the ratio $2:1.$ Therefore, to compute the population mean, we can consider a population consisting of $2+1=3$ bolts only with the following lengths:\n\n$$\n5\\,\\text{cm},\\,5\\,\\text{cm},\\,8\\,\\text{cm}.\n$$\n\nTherefore, the population mean is\n\n$$\n\\begin{aligned}\\mu  & =\\frac{1}{3}{\\sum }_{i}{x}_{i} \\\\  & =\\frac{1}{3}(2\\cdot 5+8) \\\\  & =\\frac{1}{3}(10+8) \\\\  & =\\frac{18}{3}. \\\\  & =6\\,\\text{cm}.\\end{aligned}\n$$\n\nFinally, \n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu =6\\,\\text{cm}.\n$$"}] [{:db/id #edb/ref 17592186433276 :knowledge-point/_questions [{:db/id #edb/ref 17592186157355 :knowledge-point/id #uuid "b60ce582-4127-57b8-bba8-04cf17169ca3" :knowledge-point/title "Estimating a Population Mean From the Sample Mean"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02adcd4a-5393-58b0-af0e-a5b18c91534f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14.5" :db/id #edb/ref 17592186433222} {:answer/id #uuid "34cc7ecf-2f4c-5241-9894-f5ea73dcf579" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186433232} {:answer/id #uuid "700c45ef-e183-58ae-8be4-2043b49b7309" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12.5" :db/id #edb/ref 17592186433243} {:answer/id #uuid "98ff96fb-ce0e-5a70-b94c-3e947c6b6136" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186433249} {:answer/id #uuid "dc874edf-13f5-50cb-895a-98aa264eefce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186433258}] :answer-field/correct {:answer/id #uuid "700c45ef-e183-58ae-8be4-2043b49b7309" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12.5" :db/id #edb/ref 17592186433243} :answer-field/id #uuid "f6cab445-bef6-5be3-a473-b44ea983a3a4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186433273}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2cf665ff-9d15-5f41-89fa-cbf6ac797c1c" :question/math-academy-id "q-149730" :question/problem "Suppose the following data is sampled from a population. Compute an estimate for the population mean.\n\n$$\n4,\\,19,\\,24,\\,3,\\,5,\\,20\n$$" :question/worked-solution "Suppose ${X}_{1},{X}_{2},…,{X}_{n}$ is a sequence of random variables representing a random sample of size $n$ drawn from a population with the population mean $\\mu .$ \nThen, the sample mean $\\overset{―}{X}$ is given by\n\n$$\n\\overset{―}{X}=\\frac{1}{n}{\\sum }_{i=1}^{n}{X}_{i}.\n$$\n\nNote that:\n\n- $\\overset{―}{X}$ is the mean value of ${X}_{1},{X}_{2},…,{X}_{n},$ while $\\overset{¯}{x}$ is the mean of a specific sample ${x}_{1},{x}_{2},…,{x}_{n},$\n\n- the sample mean $\\overset{―}{X}$ is an estimator of the population mean $\\mu ,$ and\n\n- the value $\\overset{^}{\\mu }=\\overset{¯}{x}$ is an estimate of the population mean $\\mu .$\n\nTherefore, our estimate for the population mean is\n\n$$\n\\begin{aligned}\\overset{^}{\\mu } & =\\overset{―}{x} \\\\  & =\\frac{1}{n}{\\sum }_{i=1}^{6}{x}_{i} \\\\  & =\\frac{1}{6}(4+19+24+3+5+20) \\\\  & =\\frac{75}{6} \\\\  & =12.5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186433278 :knowledge-point/_questions [{:db/id #edb/ref 17592186157355 :knowledge-point/id #uuid "b60ce582-4127-57b8-bba8-04cf17169ca3" :knowledge-point/title "Estimating a Population Mean From the Sample Mean"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "461b536d-35a4-5eec-8ebc-2f8031802f45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186433235} {:answer/id #uuid "5a404743-c5cf-582c-a1ec-2225f086800a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186433239} {:answer/id #uuid "67117110-e8f8-5b91-b3a3-8be85e5621a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186433241} {:answer/id #uuid "d8554b31-1741-5f0d-a91c-59c30e331d31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186433256} {:answer/id #uuid "fec696b0-3d9d-5445-9e0f-ef42b510bd6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186433264}] :answer-field/correct {:answer/id #uuid "67117110-e8f8-5b91-b3a3-8be85e5621a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186433241} :answer-field/id #uuid "f2cc3650-c81d-58a7-9545-21babf198029" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186433272}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a4c4de41-aa4b-5ba9-8cf4-45e87c95dba0" :question/math-academy-id "q-88945" :question/problem "Suppose the following data is sampled from a population. Compute an estimate for the population mean.\n\n$$\n23,\\,9,\\,19,\\,10,\\,15,\\,14\n$$" :question/worked-solution "Suppose ${X}_{1},{X}_{2},…,{X}_{n}$ is a sequence of random variables representing a random sample of size $n$ drawn from a population with the population mean $\\mu .$ \nThen, the sample mean $\\overset{―}{X}$ is given by\n\n$$\n\\overset{―}{X}=\\frac{1}{n}{\\sum }_{i=1}^{n}{X}_{i}.\n$$\n\nNote that:\n\n- $\\overset{―}{X}$ is the mean value of ${X}_{1},{X}_{2},…,{X}_{n},$ while $\\overset{¯}{x}$ is the mean of a specific sample ${x}_{1},{x}_{2},…,{x}_{n},$\n\n- the sample mean $\\overset{―}{X}$ is an estimator of the population mean $\\mu ,$ and\n\n- the value $\\overset{^}{\\mu }=\\overset{¯}{x}$ is an estimate of the population mean $\\mu .$\n\nTherefore, our estimate for the population mean is\n\n$$\n\\begin{aligned}\\overset{^}{\\mu } & =\\overset{―}{x} \\\\  & =\\frac{1}{n}{\\sum }_{i=1}^{6}{x}_{i} \\\\  & =\\frac{1}{6}(23+9+19+10+15+14) \\\\  & =\\frac{90}{6} \\\\  & =15.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186433277 :knowledge-point/_questions [{:db/id #edb/ref 17592186157355 :knowledge-point/id #uuid "b60ce582-4127-57b8-bba8-04cf17169ca3" :knowledge-point/title "Estimating a Population Mean From the Sample Mean"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f09cf15-103d-541e-82dd-b2f4e5370765" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.6" :db/id #edb/ref 17592186433224} {:answer/id #uuid "299a2542-20f0-5ec9-bb4f-fafa0112f246" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.0" :db/id #edb/ref 17592186433229} {:answer/id #uuid "55ab3159-d3b0-585a-8056-7b3695d96562" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6.0" :db/id #edb/ref 17592186433238} {:answer/id #uuid "bc556c75-d056-5567-a1b4-76f0a0a4f482" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.2" :db/id #edb/ref 17592186433254} {:answer/id #uuid "fc778621-9543-50d5-9816-52c0237f415a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.4" :db/id #edb/ref 17592186433263}] :answer-field/correct {:answer/id #uuid "fc778621-9543-50d5-9816-52c0237f415a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.4" :db/id #edb/ref 17592186433263} :answer-field/id #uuid "ebb0bdf5-b5f8-53d7-a442-39faad4214bf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186433271}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9dd1476b-baa3-50d0-a7b4-7fe6d079ea16" :question/math-academy-id "q-88948" :question/problem "Suppose the following data is sampled from a population. Compute an estimate for the population mean.\n\n$$\n7,\\,-3,\\,-6,\\,9,\\,5\n$$" :question/worked-solution "Suppose ${X}_{1},{X}_{2},…,{X}_{n}$ is a sequence of random variables representing a random sample of size $n$ drawn from a population with the population mean $\\mu .$ \nThen, the sample mean $\\overset{―}{X}$ is given by\n\n$$\n\\overset{―}{X}=\\frac{1}{n}{\\sum }_{i=1}^{n}{X}_{i}.\n$$\n\nNote that:\n\n- $\\overset{―}{X}$ is the mean value of ${X}_{1},{X}_{2},…,{X}_{n},$ while $\\overset{¯}{x}$ is the mean of a specific sample ${x}_{1},{x}_{2},…,{x}_{n},$\n\n- the sample mean $\\overset{―}{X}$ is an estimator of the population mean $\\mu ,$ and\n\n- the value $\\overset{^}{\\mu }=\\overset{¯}{x}$ is an estimate of the population mean $\\mu .$\n\nTherefore, our estimate for the population mean is\n\n$$\n\\begin{aligned}\\overset{^}{\\mu } & =\\overset{―}{x} \\\\  & =\\frac{1}{n}{\\sum }_{i=1}^{5}{x}_{i} \\\\  & =\\frac{1}{5}(7-3-6+9+5) \\\\  & =\\frac{12}{5} \\\\  & =2.4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186433274 :knowledge-point/_questions [{:db/id #edb/ref 17592186157355 :knowledge-point/id #uuid "b60ce582-4127-57b8-bba8-04cf17169ca3" :knowledge-point/title "Estimating a Population Mean From the Sample Mean"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f222beb-d0d3-5b6b-9403-a17b96ad359a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.2" :db/id #edb/ref 17592186433234} {:answer/id #uuid "4ac0821a-b6aa-5317-a297-a9a3dc05a88c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.6" :db/id #edb/ref 17592186433236} {:answer/id #uuid "6251ea59-705b-5847-9012-57b584fac2a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.5" :db/id #edb/ref 17592186433240} {:answer/id #uuid "6ab7f0a0-fe29-5760-8c40-d82548fb38aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.6" :db/id #edb/ref 17592186433242} {:answer/id #uuid "a77cbf44-79a7-59ff-b259-6795d0da283d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.5" :db/id #edb/ref 17592186433252}] :answer-field/correct {:answer/id #uuid "a77cbf44-79a7-59ff-b259-6795d0da283d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.5" :db/id #edb/ref 17592186433252} :answer-field/id #uuid "e42082b2-5441-549c-87bb-3c77d0e96111" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186433270}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "27aa799c-ba85-595b-949d-753bf0289dce" :question/math-academy-id "q-88953" :question/problem "Suppose the following data is sampled from a population. Compute an estimate for the population mean.\n\n$$\n-21,\\,19,\\,-15,\\,31\n$$" :question/worked-solution "Suppose ${X}_{1},{X}_{2},…,{X}_{n}$ is a sequence of random variables representing a random sample of size $n$ drawn from a population with the population mean $\\mu .$ \nThen, the sample mean $\\overset{―}{X}$ is given by\n\n$$\n\\overset{―}{X}=\\frac{1}{n}{\\sum }_{i=1}^{n}{X}_{i}.\n$$\n\nNote that:\n\n- $\\overset{―}{X}$ is the mean value of ${X}_{1},{X}_{2},…,{X}_{n},$ while $\\overset{¯}{x}$ is the mean of a specific sample ${x}_{1},{x}_{2},…,{x}_{n},$\n\n- the sample mean $\\overset{―}{X}$ is an estimator of the population mean $\\mu ,$ and\n\n- the value $\\overset{^}{\\mu }=\\overset{¯}{x}$ is an estimate of the population mean $\\mu .$\n\nTherefore, our estimate for the population mean is\n\n$$\n\\begin{aligned}\\overset{^}{\\mu } & =\\overset{―}{x} \\\\  & =\\frac{1}{n}{\\sum }_{i=1}^{4}{x}_{i} \\\\  & =\\frac{1}{4}(-21+19-15+31) \\\\  & =\\frac{14}{4} \\\\  & =3.5.\\end{aligned}\n$$"}]}
