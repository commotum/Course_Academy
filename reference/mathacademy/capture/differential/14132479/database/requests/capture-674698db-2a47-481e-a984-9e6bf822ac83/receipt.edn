86045417 true] [17592186433279 1070 #edb/ref 17592186045487 13194139534699 17592186045417 true] [17592186433279 1071 "A sample ${X}_{1},{X}_{2}$ of two bolts is drawn from a population. The population has bolts of two different lengths, $5\\,\\text{cm}$ and $\\text{8}\\,\\text{cm},$ distributed in the ratio $2:1.$ Calculate $\\text{E}[\\overset{―}{X}].$" 13194139534699 17592186045417 true] [17592186433279 1072 #uuid "bb20853b-4548-57d9-b738-08eff2a48018" 13194139534699 17592186045417 true] [17592186433279 1074 "Suppose ${X}_{1},{X}_{2},…,{X}_{n}$ is a sequence of random variables representing a random sample of size $n$ drawn from a population with population mean $\\mu .$ Then, the sample mean $\\overset{―}{X}$ is given by\n\n$$\n\\overset{―}{X}=\\frac{1}{n}{\\sum }_{i=1}^{n}{X}_{i}.\n$$\n\nSince $\\overset{―}{X}$ is an unbiased estimator of $\\mu ,$ we have\n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu .\n$$\n\nWe're told that the bolts in the population have lengths $5\\,\\text{cm}$ and $\\text{8}\\,\\text{cm},$ and these are distributed in the ratio $2:1.$ Therefore, to compute the population mean, we can consider a population consisting of $2+1=3$ bolts only with the following lengths:\n\n$$\n5\\,\\text{cm},\\,5\\,\\text{cm},\\,8\\,\\text{cm}.\n$$\n\nTherefore, the population mean is\n\n$$\n\\begin{aligned}\\mu  & =\\frac{1}{3}{\\sum }_{i}{x}_{i} \\\\  & =\\frac{1}{3}(2\\cdot 5+8) \\\\  & =\\frac{1}{3}(10+8) \\\\  & =\\frac{18}{3}. \\\\  & =6\\,\\text{cm}.\\end{aligned}\n$$\n\nFinally, \n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu =6\\,\\text{cm}.\n$$" 13194139534699 17592186045417 true] [17592186433280 1068 #edb/ref 17592186433267 13194139534699 17592186045417 true] [17592186433280 1069 "q-143250" 13194139534699 17592186045417 true] [17592186433280 1070 #edb/ref 17592186045485 13194139534699 17592186045417 true] [17592186433280 1071 "If ${X}_{1},{X}_{2},…,{X}_{80}$ is a sample of size $n=80$ drawn from a population with mean $\\mu =15.5$ and variance ${\\sigma }^{2}=8,$ what is $\\text{E}[\\overset{―}{X}]?$" 13194139534699 17592186045417 true] [17592186433280 1072 #uuid "da2180f8-2611-5385-974d-058bcc233c80" 13194139534699 17592186045417 true] [17592186433280 1074 "Suppose ${X}_{1},{X}_{2},…,{X}_{n}$ is a sequence of random variables representing a random sample of size $n$ drawn from a population with population mean $\\mu .$ Then, the sample mean $\\overset{―}{X}$ is given by\n\n$$\n\\overset{―}{X}=\\frac{1}{n}{\\sum }_{i=1}^{n}{X}_{i}.\n$$\n\nSince $\\overset{―}{X}$ is an unbiased estimator of $\\mu ,$ we have\n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu .\n$$\n\nTherefore, since the population mean $\\mu =15.5,$ we have that $\\text{E}[\\overset{―}{X}]=15.5.$" 13194139534699 17592186045417 true] [17592186433281 1068 #edb/ref 17592186433269 13194139534699 17592186045417 true] [17592186433281 1069 "q-143251" 13194139534699 17592186045417 true] [17592186433281 1070 #edb/ref 17592186045485 13194139534699 17592186045417 true] [17592186433281 1071 "If ${X}_{1},{X}_{2},…,{X}_{30}$ is a sample of size $n=30$ drawn from a population with mean $\\mu =10$ and variance ${\\sigma }^{2}=4,$ what is $\\text{E}[\\overset{―}{X}]?$" 13194139534699 17592186045417 true] [17592186433281 1072 #uuid "ebb176a9-8df7-5364-a45a-43a1450a346c" 13194139534699 17592186045417 true] [17592186433281 1074 "Suppose ${X}_{1},{X}_{2},…,{X}_{n}$ is a sequence of random variables representing a random sample of size $n$ drawn from a population with population mean $\\mu .$ Then, the sample mean $\\overset{―}{X}$ is given by\n\n$$\n\\overset{―}{X}=\\frac{1}{n}{\\sum }_{i=1}^{n}{X}_{i}.\n$$\n\nSince $\\overset{―}{X}$ is an unbiased estimator of $\\mu ,$ we have\n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu .\n$$\n\nTherefore, since the population mean $\\mu =10,$ we have that $\\text{E}[\\overset{―}{X}]=10.$" 13194139534699 17592186045417 true] [17592186433282 1068 #edb/ref 17592186433268 13194139534699 17592186045417 true] [17592186433282 1069 "q-139803" 13194139534699 17592186045417 true] [17592186433282 1070 #edb/ref 17592186045487 13194139534699 17592186045417 true] [17592186433282 1071 "Suppose the following data is sampled from a population. Compute an estimate for the population mean.\n\n$$\n-9,\\,-4,\\,1,\\,7,\\,-3,\\,6,\\,10,\\,12\n$$" 13194139534699 17592186045417 true] [17592186433282 1072 #uuid "fac2f103-d2fc-584f-ab2c-f1bc5b2aaa60" 13194139534699 17592186045417 true] [17592186433282 1074 "Suppose ${X}_{1},{X}_{2},…,{X}_{n}$ is a sequence of random variables representing a random sample of size $n$ drawn from a population with the population mean $\\mu .$ \nThen, the sample mean $\\overset{―}{X}$ is given by\n\n$$\n\\overset{―}{X}=\\frac{1}{n}{\\sum }_{i=1}^{n}{X}_{i}.\n$$\n\nNote that:\n\n- $\\overset{―}{X}$ is the mean value of ${X}_{1},{X}_{2},…,{X}_{n},$ while $\\overset{¯}{x}$ is the mean of a specific sample ${x}_{1},{x}_{2},…,{x}_{n},$\n\n- the sample mean $\\overset{―}{X}$ is an estimator of the population mean $\\mu ,$ and\n\n- the value $\\overset{^}{\\mu }=\\overset{¯}{x}$ is an estimate of the population mean $\\mu .$\n\nTherefore, our estimate for the population mean is\n\n$$\n\\begin{aligned}\\overset{^}{\\mu } & =\\overset{―}{x} \\\\  & =\\frac{1}{n}{\\sum }_{i=1}^{8}{x}_{i} \\\\  & =\\frac{1}{8}(-9-4+1+7-3+6+10+12) \\\\  & =\\frac{20}{8} \\\\  & =2.5.\\end{aligned}\n$$" 13194139534699 17592186045417 true]] :edb/tempids {"answer-00d00815-bcdc-5d4c-8d9c-9110e655684d" 17592186433220 "answer-02643f9d-582b-581f-994d-46c4ac76a48c" 17592186433221 "answer-02adcd4a-5393-58b0-af0e-a5b18c91534f" 17592186433222 "answer-0a29066f-c5c6-5f13-9704-332d81aafa1e" 17592186433223 "answer-0f09cf15-103d-541e-82dd-b2f4e5370765" 17592186433224 "answer-13e0a3d0-6ab2-5b3b-be81-f9ce0222fb6e" 17592186433225 "answer-14e8de67-0e76-51ab-94c6-b148785759f5" 17592186433226 "answer-1e63e961-b7cd-57a7-b177-22138ad08e0f" 17592186433227 "answer-2939ee74-3320-5827-9605-fa3dc1556af8" 17592186433228 "answer-299a2542-20f0-5ec9-bb4f-fafa0112f246" 1759218643322