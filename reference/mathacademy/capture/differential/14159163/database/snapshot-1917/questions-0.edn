#{[{:db/id #edb/ref 17592186268920 :knowledge-point/_questions [{:db/id #edb/ref 17592186124441 :knowledge-point/id #uuid "503a0bfe-7c69-5ad0-ad1d-aa8692dae673" :knowledge-point/title "Computing Expressions Involving Second-Order Partial Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "573ca17f-8b55-50aa-b136-59bd043a6536" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}-\\pi " :db/id #edb/ref 17592186266921} {:answer/id #uuid "5df633bf-d9fe-5623-9aed-bd0cc78f2d1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186266974} {:answer/id #uuid "5fc7ddd0-7d66-560f-b925-d71f0a4f1da7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\sqrt{3}+\\pi )" :db/id #edb/ref 17592186266989} {:answer/id #uuid "75e2d132-79e6-565d-b0a0-3480a84f1042" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\pi -\\sqrt{3})" :db/id #edb/ref 17592186267184} {:answer/id #uuid "aa6cc2bf-6cc9-5989-82ab-f94ca56c41d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\sqrt{3}-\\frac{\\pi }{3})" :db/id #edb/ref 17592186267685}] :answer-field/correct {:answer/id #uuid "5df633bf-d9fe-5623-9aed-bd0cc78f2d1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186266974} :answer-field/id #uuid "0722938f-1bbb-5341-b742-6808aa83c68d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268418}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3aaf83dc-c135-54d5-b395-8dc2f637ad0a" :question/math-academy-id "q-132894" :question/problem "Find ${g}_{xx}(x,y)-{g}_{yy}(x,y)$ at $(\\frac{\\pi }{3},\\frac{\\pi }{3})$ given that ${g}_{x}(x,y)=x\\operatorname{sin}⁡(x+y)-\\operatorname{cos}⁡(x+y)$ and ${g}_{y}(x,y)=x\\operatorname{sin}⁡(x+y).$" :question/worked-solution "To find ${g}_{xx}(x,y)$ we differentiate the given first-order partial derivative ${g}_{x}(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{g}_{xx}(x,y) & =\\frac{∂}{∂x}({g}_{x}(x,y)) \\\\  & =\\frac{∂}{∂x}(x\\operatorname{sin}⁡(x+y)-\\operatorname{cos}⁡(x+y)) \\\\  & =\\operatorname{sin}⁡(x+y)+x\\operatorname{cos}⁡(x+y)+\\operatorname{sin}⁡(x+y) \\\\  & =2\\operatorname{sin}⁡(x+y)+x\\operatorname{cos}⁡(x+y)\\end{aligned}\n$$\n\n \n\nTo find ${g}_{yy}(x,y)$ we differentiate the given first-order partial derivative ${g}_{y}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{g}_{yy}(x,y) & =\\frac{∂}{∂y}({g}_{y}(x,y)) \\\\  & =\\frac{∂}{∂y}(x\\operatorname{sin}⁡(x+y)) \\\\  & =x\\operatorname{cos}⁡(x+y)\\end{aligned}\n$$\n\n \n\nNext, we evaluate ${g}_{xx}(x,y)$ and ${g}_{yy}(x,y)$ at $(\\frac{\\pi }{3},\\frac{\\pi }{3}):$\n\n$$\n\\begin{aligned}{g}_{xx}(\\frac{\\pi }{3},\\frac{\\pi }{3}) & =2\\operatorname{sin}⁡(\\frac{\\pi }{3}+\\frac{\\pi }{3})+\\frac{\\pi }{3}\\operatorname{cos}⁡(\\frac{\\pi }{3}+\\frac{\\pi }{3})=\\sqrt{3}-\\frac{\\pi }{6} \\\\ {g}_{yy}(\\frac{\\pi }{3},\\frac{\\pi }{3}) & =\\frac{\\pi }{3}\\operatorname{cos}⁡(\\frac{\\pi }{3}+\\frac{\\pi }{3})=-\\frac{\\pi }{6}\\end{aligned}\n$$\n\nFinally, we have\n\n$$\n{g}_{xx}(\\frac{\\pi }{3},\\frac{\\pi }{3})-{g}_{yy}(\\frac{\\pi }{3},\\frac{\\pi }{3})=\\sqrt{3}-\\frac{\\pi }{6}-(-\\frac{\\pi }{6})=\\sqrt{3}.\n$$"}] [{:db/id #edb/ref 17592186268923 :knowledge-point/_questions [{:db/id #edb/ref 17592186124442 :knowledge-point/id #uuid "83724b66-0f15-5b94-9576-76e9dfd56d38" :knowledge-point/title "Finding Higher-Order Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00508df2-67fc-5789-9478-c3e2d42771e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{2}" :db/id #edb/ref 17592186266152} {:answer/id #uuid "44da4fc7-1df8-536a-a190-f8c23a3e32f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\pi " :db/id #edb/ref 17592186266758} {:answer/id #uuid "63a9b984-28e7-58d3-8128-0a6d4ca98f26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186267021} {:answer/id #uuid "88f1885b-f866-5cf3-96ea-874e43e6a210" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186267363} {:answer/id #uuid "8ebfbd8f-e225-52f2-af81-73501dcd099d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{4}" :db/id #edb/ref 17592186267416}] :answer-field/correct {:answer/id #uuid "00508df2-67fc-5789-9478-c3e2d42771e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{2}" :db/id #edb/ref 17592186266152} :answer-field/id #uuid "4f17d030-5507-55e9-8f15-4689404588ae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268545}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "01b2f238-4be0-502a-a439-500d85cd72b9" :question/math-academy-id "q-132961" :question/problem "Evaluate ${f}_{xxz}(1,\\frac{1}{2},\\pi )$ for $f(x,y,z)=\\operatorname{sin}⁡(xyz).$" :question/worked-solution "First, we find the first-order derivative ${f}_{x}(x,y,z):$\n\n$$\n\\begin{aligned}{f}_{x}(x,y,z) & =\\frac{∂}{∂x}(\\operatorname{sin}⁡xyz) \\\\  & =\\operatorname{cos}⁡(xyz)\\cdot yz \\\\  & =yz\\operatorname{cos}⁡(xyz)\\end{aligned}\n$$\n\nNow, we find ${f}_{xx}(x,y,z)$ by differentiating ${f}_{x}(x,y,z)$ with respect to $x:$\n\n$$\n\\begin{aligned}{f}_{xx}(x,y,z) & =\\frac{∂}{∂x}({f}_{x}(x,y,z)) \\\\  & =\\frac{∂}{∂x}(yz\\operatorname{cos}⁡(xyz)) \\\\  & =yz\\cdot (-yz\\operatorname{sin}⁡(xyz)) \\\\  & =-{y}^{2}{z}^{2}\\operatorname{sin}⁡(xyz)\\end{aligned}\n$$\n\nNext, we find ${f}_{xxz}(x,y,z)$ by differentiating ${f}_{xx}(x,y,z)$ with respect to $z:$ \n\n$$\n\\begin{aligned}{f}_{xxz}(x,y,z) & =\\frac{∂}{∂z}({f}_{xx}(x,y,z)) \\\\  & =\\frac{∂}{∂z}(-{y}^{2}{z}^{2}\\operatorname{sin}⁡(xyz)) \\\\  & =-{y}^{2}\\frac{∂}{∂z}({z}^{2}\\operatorname{sin}⁡(xyz)) \\\\  & =-{y}^{2}\\cdot (2z\\operatorname{sin}⁡(xyz)+xy{z}^{2}\\operatorname{cos}⁡(xyz)) \\\\  & =-{y}^{2}z(2\\operatorname{sin}⁡(xyz)+xyz\\operatorname{cos}⁡(xyz))\\end{aligned}\n$$\n\n \n\nFinally, we evaluate ${f}_{xxz}(x,y,z)$ at $(1,\\frac{1}{2},\\pi ):$\n\n$$\n\\begin{aligned}{f}_{xxz}(1,\\frac{1}{2},\\pi ) & =-{(\\frac{1}{2})}^{2}\\cdot \\pi \\cdot (2\\operatorname{sin}⁡(1\\cdot \\frac{1}{2}\\cdot \\pi )+1\\cdot \\frac{1}{2}\\cdot \\pi \\cdot \\operatorname{cos}⁡(1\\cdot \\frac{1}{2}\\cdot \\pi )) \\\\  & =-\\frac{\\pi }{4}(2\\operatorname{sin}⁡(\\frac{\\pi }{2})+\\frac{\\pi }{2}\\operatorname{cos}⁡(\\frac{\\pi }{2})) \\\\  & =-\\frac{\\pi }{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186335788 :knowledge-point/_questions [{:db/id #edb/ref 17592186124442 :knowledge-point/id #uuid "83724b66-0f15-5b94-9576-76e9dfd56d38" :knowledge-point/title "Finding Higher-Order Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0548138d-e543-5a54-a872-c6505ae35f31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4y}{{x}^{2}}" :db/id #edb/ref 17592186333031} {:answer/id #uuid "3dd21545-2656-5f34-8899-9e63ce0f1a99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2y}{x}" :db/id #edb/ref 17592186333573} {:answer/id #uuid "56f12986-c08d-5855-9c32-e38ca3128af3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y}{{x}^{2}}" :db/id #edb/ref 17592186333777} {:answer/id #uuid "7279d9a1-e1cd-5962-b045-74040fa8edd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y}{4x}" :db/id #edb/ref 17592186334026} {:answer/id #uuid "810185ca-f52f-5e5b-a85b-df54ad11e6a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4+y}{x}" :db/id #edb/ref 17592186334135}] :answer-field/correct {:answer/id #uuid "0548138d-e543-5a54-a872-c6505ae35f31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4y}{{x}^{2}}" :db/id #edb/ref 17592186333031} :answer-field/id #uuid "c7a6c17f-ff74-5dd2-941a-c73839c7e4a2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335605}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ab0f3803-2840-52ec-8174-767389c2fcc7" :question/math-academy-id "q-65071" :question/problem "Calculate ${f}_{yxx}(x,y)$ given that $f(x,y)={y}^{2}\\operatorname{ln}⁡({x}^{2}).$" :question/worked-solution "First, we find the first-order derivative ${f}_{y}(x,y):$ \n\n$$\n\\begin{aligned}{f}_{y}(x,y) & =\\frac{∂}{∂y}({y}^{2}\\operatorname{ln}⁡({x}^{2})) \\\\  & =\\operatorname{ln}⁡({x}^{2})\\frac{∂}{∂y}({y}^{2}) \\\\  & =2y\\operatorname{ln}⁡({x}^{2})\\end{aligned}\n$$\n\nNext, we find ${f}_{yx}(x,y)$ by differentiating ${f}_{y}(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{f}_{yx}(x,y) & =\\frac{∂}{∂x}({f}_{y}(x,y)) \\\\  & =\\frac{∂}{∂x}(2y\\operatorname{ln}⁡({x}^{2})) \\\\  & =2y\\cdot \\frac{2x}{{x}^{2}} \\\\  & =\\frac{4y}{x}\\end{aligned}\n$$\n\nFinally, we find ${f}_{yxx}(x,y)$ by differentiating ${f}_{yx}(x,y)$ with respect to $x:$ \n\n$$\n\\begin{aligned}{f}_{yxx}(x,y) & =\\frac{∂}{∂x}({f}_{yx}(x,y)) \\\\  & =\\frac{∂}{∂x}(\\frac{4y}{x}) \\\\  & =\\frac{0\\cdot x-4y\\cdot 1}{{x}^{2}} \\\\  & =-\\frac{4y}{{x}^{2}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186382379 :knowledge-point/_questions [{:db/id #edb/ref 17592186124441 :knowledge-point/id #uuid "503a0bfe-7c69-5ad0-ad1d-aa8692dae673" :knowledge-point/title "Computing Expressions Involving Second-Order Partial Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28fd9f48-019d-5f27-baf0-6a1841493cc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}\\operatorname{cos}⁡(2x+{y}^{2})-x\\operatorname{sin}⁡(2x+{y}^{2})" :db/id #edb/ref 17592186382381} {:answer/id #uuid "2ecd2278-324d-5173-a901-03897d9ade19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x\\operatorname{cos}⁡(2x+{y}^{2})-x(y+1)\\operatorname{sin}⁡(2x+{y}^{2})" :db/id #edb/ref 17592186382382} {:answer/id #uuid "1f517a1e-8bfc-56fe-bed2-6c99b6f579a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\operatorname{cos}⁡(2x+{y}^{2})-4{y}^{2}\\operatorname{sin}⁡(2x+{y}^{2})" :db/id #edb/ref 17592186382383} {:answer/id #uuid "fd42600b-5686-573f-98cb-1cd8e2a97d37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(2x+{y}^{2})-(2y+1)\\operatorname{sin}⁡(2x+{y}^{2})" :db/id #edb/ref 17592186382384} {:answer/id #uuid "b86868bc-6931-5551-b2ee-dc760e6b939c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(2x+{y}^{2})-2y(y+1)\\operatorname{sin}⁡(2x+{y}^{2})" :db/id #edb/ref 17592186382385}] :answer-field/correct {:answer/id #uuid "b86868bc-6931-5551-b2ee-dc760e6b939c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(2x+{y}^{2})-2y(y+1)\\operatorname{sin}⁡(2x+{y}^{2})" :db/id #edb/ref 17592186382385} :answer-field/id #uuid "9a514deb-d87a-5e16-bf0c-b2bff11c7a40" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382380}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b4318c10-0a8e-5140-827c-8a0c895809ae" :question/math-academy-id "q-80466" :question/problem "Find ${f}_{yx}(x,y)+{f}_{yy}(x,y)$ given that  ${f}_{y}(x,y)=y\\operatorname{cos}⁡(2x+{y}^{2}).$" :question/worked-solution "To find ${f}_{yx}(x,y)$ we differentiate the given first-order partial derivative ${f}_{y}(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{f}_{yx}(x,y) & =\\frac{∂}{∂x}({f}_{y}(x,y)) \\\\  & =\\frac{∂}{∂x}(y\\operatorname{cos}⁡(2x+{y}^{2})) \\\\  & =y\\cdot (-2\\operatorname{sin}⁡(2x+{y}^{2})) \\\\  & =-2y\\operatorname{sin}⁡(2x+{y}^{2})\\end{aligned}\n$$\n\nTo find ${f}_{yy}(x,y)$ we differentiate the given first-order partial derivative ${f}_{y}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{f}_{yy}(x,y) & =\\frac{∂}{∂y}({f}_{y}(x,y)) \\\\  & =\\frac{∂}{∂y}(y\\operatorname{cos}⁡(2x+{y}^{2})) \\\\  & =\\operatorname{cos}⁡(2x+{y}^{2})-2{y}^{2}\\operatorname{sin}⁡(2x+{y}^{2})\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{f}_{yx}(x,y)+{f}_{yy}(x,y) & =-2y\\operatorname{sin}⁡(2x+{y}^{2})+\\operatorname{cos}⁡(2x+{y}^{2})-2{y}^{2}\\operatorname{sin}⁡(2x+{y}^{2}) \\\\  & =\\operatorname{cos}⁡(2x+{y}^{2})-2y(y+1)\\operatorname{sin}⁡(2x+{y}^{2}).\\end{aligned}\n$$"}]}
