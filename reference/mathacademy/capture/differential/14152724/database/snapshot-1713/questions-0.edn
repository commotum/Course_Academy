#{[{:db/id #edb/ref 17592186371742 :knowledge-point/_questions [{:db/id #edb/ref 17592186124475 :knowledge-point/id #uuid "74f126da-5f3b-5af8-9aee-d6f0a4c61c49" :knowledge-point/title "Determining the Shape of a Level Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f991d876-0326-5c0a-8b2a-21654d5968e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186371744} {:answer/id #uuid "666513c1-30a7-57b3-9697-bfb795bc5ec5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186371745} {:answer/id #uuid "8ed80916-c09b-516a-9fa9-c624724d3990" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186371746} {:answer/id #uuid "43b2e3d7-12f2-5f46-a4a1-44f8a122b428" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186371747} {:answer/id #uuid "c3fa3a72-e885-51c1-841e-7a3be69e37dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186371748}] :answer-field/correct {:answer/id #uuid "43b2e3d7-12f2-5f46-a4a1-44f8a122b428" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186371747} :answer-field/id #uuid "1f4c2c44-ea9c-52ce-a441-c7c1c5f23e29" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186371743}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ee3c74bd-cd07-5dd0-b26f-4b93aa9647b3" :question/math-academy-id "q-129061" :question/problem "The level curves of the function $f(x,y)=\\sqrt{{x}^{2}+{y}^{2}}$ are given by $f(x,y)=c.$ Which of the following statements are true?\n\n- $c=0$ gives the point $(0,0)$\n- $c=1$ gives a circle of radius $1$\n- $c=4$ gives a parabola" :question/worked-solution "Setting $f(x,y)=c$ gives:\n\n$$\n\\begin{aligned}\\sqrt{{x}^{2}+{y}^{2}} & =c \\\\ {x}^{2}+{y}^{2} & ={c}^{2}\\end{aligned}\n$$\n\nTherefore:\n\n- If $c=0,$ the level curve is $x=y=0,$ which gives the point $(0,0).$ So, I is true.\n\n- If $c=1,$ the level curve is ${x}^{2}+{y}^{2}=1,$ which gives a circle of radius $1.$ So, II is true.\n\n- If $c=4,$ the level curve is ${x}^{2}+{y}^{2}=16,$ which gives a circle of radius $4.$ So, III is false.\n\nSo, the correct answer is \"I and II only\"."}] [{:db/id #edb/ref 17592186262944 :knowledge-point/_questions [{:db/id #edb/ref 17592186124476 :knowledge-point/id #uuid "dfd8982d-d859-5eb2-9f35-69af39c04822" :knowledge-point/title "Sketching Level Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f81b229-411e-50ec-868a-e71357c6d344" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b7/b79c75fb4de77313ff9ae17938eeabc8b55cca395e6516c09abf6742f9b6a23b.png" :db/id #edb/ref 17592186260146} {:answer/id #uuid "2e72b69e-de1d-539b-bd7f-b17ba3bb78bc" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/01/0162f31b5dbb35c6d370dff9b54257708df39b6957f6547059842cd31769669b.png" :db/id #edb/ref 17592186260294} {:answer/id #uuid "7d7ac9b2-3db3-5b9c-a04a-a8589af15779" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b4/b4642ea9b585ac066f2ed904b1bee4df7d1ff3449ba2d09afca8364b58f1dcba.png" :db/id #edb/ref 17592186260967} {:answer/id #uuid "867c8bfd-8db7-54f2-837f-8096fc36058e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/7a/7afff53b46a661fc6e0df4df871810dc5514ff7b476294e76c70f60d4e1643f9.png" :db/id #edb/ref 17592186261045} {:answer/id #uuid "bebf2ce8-badd-5f41-86c5-5e5bb4040e73" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f8/f82efe38e48f39aee18cf9e00cdd69f07c37cc414b08b5bc78ebc0a876c02d7e.png" :db/id #edb/ref 17592186261560}] :answer-field/correct {:answer/id #uuid "867c8bfd-8db7-54f2-837f-8096fc36058e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/7a/7afff53b46a661fc6e0df4df871810dc5514ff7b476294e76c70f60d4e1643f9.png" :db/id #edb/ref 17592186261045} :answer-field/id #uuid "12e3878f-62b0-500f-bf38-893dbf70a32f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262158}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7f1a9983-9e78-5286-9a4c-31363bd01bd7" :question/math-academy-id "q-129118" :question/problem "Which of the following represents the level curves of $f(x,y)=-x-y+2?$" :question/worked-solution "The level curves for the function $f(x,y)$ are given by the equations \n\n$$\nf(x,y)=c.\n$$\n\nnotice that the range of $f(x,y)$ is $(-\\infty ,\\infty ).$ So, we will consider $c$-level curves for any real value of $c.$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f(x,y) & =c \\\\ -x-y+2 & =c \\\\ y & =-x+2-c.\\end{aligned}\n$$\n\nThe equation above gives us a family of lines with slope of $-1.$ Therefore, the correct graph is as follows:\n\n![](images/e2/e20175ef9ac473a621a67d524e60cacc6e9a40ba30267fe81b4e6a093c780c28.png)"}] [{:db/id #edb/ref 17592186379766 :knowledge-point/_questions [{:db/id #edb/ref 17592186124475 :knowledge-point/id #uuid "74f126da-5f3b-5af8-9aee-d6f0a4c61c49" :knowledge-point/title "Determining the Shape of a Level Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1aa93218-27b0-5ad5-8222-b7e37e2e20e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186379768} {:answer/id #uuid "870c2e4a-2968-5ad3-9de4-98a3ab8a3888" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186379769} {:answer/id #uuid "3e07e993-4d1b-5f3e-bc88-fb33e5cf4d73" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186379770} {:answer/id #uuid "fa7d4122-ae51-5da7-9538-4f3a5a4e7279" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186379771} {:answer/id #uuid "67511d28-193a-5f98-b1ad-09961ee6f34d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186379772}] :answer-field/correct {:answer/id #uuid "3e07e993-4d1b-5f3e-bc88-fb33e5cf4d73" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186379770} :answer-field/id #uuid "5e2961e2-c4d5-5918-ab70-c6f6a98c5129" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186379767}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "036af2f8-8d3f-5a9f-9714-c21bb558dc15" :question/math-academy-id "q-35538" :question/problem "The level curves of the function $f(x,y)=4x-3y-1$ are given by $f(x,y)=c.$ Which of the following statements are true?\n\n- $c=-1$ gives a line\n- $c=0$ gives the axes $x=0$ and $y=0$\n- $c=2$ gives a parabola" :question/worked-solution "Setting $f(x,y)=c$ gives:\n\n$$\n\\begin{aligned}4x-3y-1 & =c \\\\ 4x-3y-(c+1) & =0 \\\\ y & =\\frac{4}{3}x-\\frac{c+1}{3}\\end{aligned}\n$$\n\nTherefore:\n\n- If $c=-1$ then the level curve is $y=\\frac{4}{3}x,$ which is a line.\n\n- If $c=0$ then the level curve is $y=\\frac{4}{3}x-\\frac{1}{3},$ which is a line different to the axes $x=0$ and $y=0.$\n\n- If $c=2$ then the level curve is $y=\\frac{4}{3}x-1,$ which is not a parabola.\n\nSo, only statement I is true."}] [{:db/id #edb/ref 17592186392877 :knowledge-point/_questions [{:db/id #edb/ref 17592186124476 :knowledge-point/id #uuid "dfd8982d-d859-5eb2-9f35-69af39c04822" :knowledge-point/title "Sketching Level Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c5081b5a-0a05-566f-ac65-b452778b3dff" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a8/a8c4e910e3884ee68518752ab814f491edb14d422b4c25926b7d3ad34720592d.png" :db/id #edb/ref 17592186392879} {:answer/id #uuid "1048cbeb-b7a7-5613-93ec-38f4f470c459" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f6/f6fcb4286cb1d3a0c850e1a5280558ed793b45766359fe796d37e9ff92110300.png" :db/id #edb/ref 17592186392880} {:answer/id #uuid "7aa3bf7c-ba72-5347-9c51-9a74af107731" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f3/f33a74f9c61703628cd53576dc12b8a02d67944dccd70e3ea6d1be88ba3fa5d8.png" :db/id #edb/ref 17592186392881} {:answer/id #uuid "36e0d7fc-bba4-5076-b14a-e8abbe7e10db" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/2c/2c5dda31d349fb26df687cbe59af5ac163380ae7359561c6809737149f4772a3.png" :db/id #edb/ref 17592186392882} {:answer/id #uuid "73047cd2-2772-59bd-ba1e-8f58e56dc0d8" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/40/408a028814088bbb85e20e52e9482a0ddfd0b21fcf70470196049c6b5f37a208.png" :db/id #edb/ref 17592186392883}] :answer-field/correct {:answer/id #uuid "c5081b5a-0a05-566f-ac65-b452778b3dff" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a8/a8c4e910e3884ee68518752ab814f491edb14d422b4c25926b7d3ad34720592d.png" :db/id #edb/ref 17592186392879} :answer-field/id #uuid "a113a983-a1ee-554f-9f6d-a9c10a34e3bd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392878}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c2b2fff3-d401-5946-82c7-5c2974317dd2" :question/math-academy-id "q-64717" :question/problem "![](images/36/36bbd69dec59657a74992dbddced8b87190f953687e0d84aa8f3081e8754789c.png)\n\nWhich of the following could represent the level curves of the surface $z=\\operatorname{cos}⁡y$ shown above?" :question/worked-solution "First, notice that the range of $f(x,y)$ is $[-1,1].$ So, we will consider only $c$-level curves for $c\\in [-1,1].$\n\nThe level curves for the function $f(x,y)$ are given by the equations \n\n$$\nf(x,y)=c\n$$\n\nTherefore, we have:\n\n$$\n\\begin{aligned}f(x,y) & =c \\\\ \\operatorname{cos}⁡y & =c \\\\ y & =\\pm \\operatorname{arccos}⁡c+2\\pi n\\end{aligned}\n$$\n\nwhere $n$ can be any integer. \n\nNotice that in the equations $y=\\pm \\operatorname{arccos}⁡c+2\\pi n$ do not depend on $x.$ So, for a given $c\\in [-1,1]$ and integer $n$, the right-hand side of the equation is constant. As a result, we obtain a family of horizontal lines, as shown below.\n\n$$\n\n$$\n\n![](images/a8/a8c4e910e3884ee68518752ab814f491edb14d422b4c25926b7d3ad34720592d.png)"}]}
