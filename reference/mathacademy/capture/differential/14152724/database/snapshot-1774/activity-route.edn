#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186459326} :activity/id #uuid "050a47c1-467f-5f12-8f61-8827d230183c" :activity/scope {:db/id #edb/ref 17592186049882 :topic/id #uuid "1ad374f3-e4f4-5dcc-ab6d-d6aed0790f3a" :topic/math-academy-id 1900} :activity/steps [{:db/id #edb/ref 17592186459313 :step/content {:db/id #edb/ref 17592186392877 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c5081b5a-0a05-566f-ac65-b452778b3dff" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/a8/a8c4e910e3884ee68518752ab814f491edb14d422b4c25926b7d3ad34720592d.png" :db/id #edb/ref 17592186392879} {:answer/id #uuid "1048cbeb-b7a7-5613-93ec-38f4f470c459" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/f6/f6fcb4286cb1d3a0c850e1a5280558ed793b45766359fe796d37e9ff92110300.png" :db/id #edb/ref 17592186392880} {:answer/id #uuid "7aa3bf7c-ba72-5347-9c51-9a74af107731" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/f3/f33a74f9c61703628cd53576dc12b8a02d67944dccd70e3ea6d1be88ba3fa5d8.png" :db/id #edb/ref 17592186392881} {:answer/id #uuid "36e0d7fc-bba4-5076-b14a-e8abbe7e10db" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/2c/2c5dda31d349fb26df687cbe59af5ac163380ae7359561c6809737149f4772a3.png" :db/id #edb/ref 17592186392882} {:answer/id #uuid "73047cd2-2772-59bd-ba1e-8f58e56dc0d8" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/40/408a028814088bbb85e20e52e9482a0ddfd0b21fcf70470196049c6b5f37a208.png" :db/id #edb/ref 17592186392883}] :answer-field/correct {:db/id #edb/ref 17592186392879} :answer-field/id #uuid "a113a983-a1ee-554f-9f6d-a9c10a34e3bd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186392878}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c2b2fff3-d401-5946-82c7-5c2974317dd2" :question/math-academy-id "q-64717" :question/problem "![](images/36/36bbd69dec59657a74992dbddced8b87190f953687e0d84aa8f3081e8754789c.png)\n\nWhich of the following could represent the level curves of the surface $z=\\operatorname{cos}⁡y$ shown above?" :question/worked-solution "First, notice that the range of $f(x,y)$ is $[-1,1].$ So, we will consider only $c$-level curves for $c\\in [-1,1].$\n\nThe level curves for the function $f(x,y)$ are given by the equations \n\n$$\nf(x,y)=c\n$$\n\nTherefore, we have:\n\n$$\n\\begin{aligned}f(x,y) & =c \\\\ \\operatorname{cos}⁡y & =c \\\\ y & =\\pm \\operatorname{arccos}⁡c+2\\pi n\\end{aligned}\n$$\n\nwhere $n$ can be any integer. \n\nNotice that in the equations $y=\\pm \\operatorname{arccos}⁡c+2\\pi n$ do not depend on $x.$ So, for a given $c\\in [-1,1]$ and integer $n$, the right-hand side of the equation is constant. As a result, we obtain a family of horizontal lines, as shown below.\n\n$$\n\n$$\n\n![](images/a8/a8c4e910e3884ee68518752ab814f491edb14d422b4c25926b7d3ad34720592d.png)"} :step/id #uuid "0c389e51-5208-5b51-8548-4475cba0a511" :step/next {:db/id #edb/ref 17592186459321}} {:db/id #edb/ref 17592186459321 :step/content {:db/id #edb/ref 17592186459278 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "347f9956-ca4d-503b-8dc1-5e2ad6f7baa5" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/d1/d1f74734b0de333c0d10a4118d155414c8ced81975bf1321304eeb5059428010.png" :db/id #edb/ref 17592186458731} {:answer/id #uuid "3c0be70e-cf9a-5c38-bf4d-fa0332e77895" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/2f/2f267c81217b5873f69d332867b6d655ffaca26397fe02e2e0fb8568277da937.png" :db/id #edb/ref 17592186458741} {:answer/id #uuid "9a36a621-d7aa-5f31-9f47-2f486d5af260" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/b8/b809fecaefd763b18eb6bf89942eaeea49d4d69a54d6c748ae501c2f38a3a82f.png" :db/id #edb/ref 17592186458900} {:answer/id #uuid "9aee8bca-b2b1-5ab1-b6c2-2b13877ddde0" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/7a/7ab95ed367277627d5baf535db74994d7d02cd41deae939d76ed08e22799ff40.png" :db/id #edb/ref 17592186458901} {:answer/id #uuid "bff6924d-4d2a-5f8c-8acd-1f03b2ba5c8f" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/dc/dc2dac71b2fc7486e7fee2bc7dcbab8722e9fcbd60369d670e7dfb02009bf2c9.png" :db/id #edb/ref 17592186458973}] :answer-field/correct {:db/id #edb/ref 17592186458901} :answer-field/id #uuid "8e7bf0d5-3d69-5131-80bd-bb7c9041b796" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186459146}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "b6a9287f-9c6d-59af-b885-5fcb5a380cae" :question/math-academy-id "q-64979" :question/problem "![](images/ff/ffef2a7d5f82bf9d46cb99913c9de149f85b948180047ae96d9c03c69f88c181.png)\n\nWhich of the following could represent the level curves of the surface $z=3-2x-3y$ shown above?" :question/worked-solution "First, notice that the range of $f(x,y)$ is $(-\\infty ,\\infty ).$ So, we will consider $c$-level curves for any real value of $c.$\n\nThe level curves for the function $f(x,y)$ are given by the equations \n\n$$\nf(x,y)=c\n$$\n\nTherefore, we have:\n\n$$\n\\begin{aligned}f(x,y) & =c \\\\ 3-2x-3y & =c \\\\ y & =-\\frac{2}{3}x+1-\\frac{c}{3}\\end{aligned}\n$$\n\nSo, for any real value of $c$, the right-hand side of an equation is the equation of a line. As a result, we obtain a family of lines with slope $-\\frac{2}{3}$, as shown below.\n\n$$\n\n$$\n\n![](images/7a/7ab95ed367277627d5baf535db74994d7d02cd41deae939d76ed08e22799ff40.png)"} :step/id #uuid "35fc01ec-2fc9-5d0e-966d-f82bec64afe8" :step/next {:db/id #edb/ref 17592186459330}} {:db/id #edb/ref 17592186459322 :step/content {:db/id #edb/ref 17592186262944 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f81b229-411e-50ec-868a-e71357c6d344" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/b7/b79c75fb4de77313ff9ae17938eeabc8b55cca395e6516c09abf6742f9b6a23b.png" :db/id #edb/ref 17592186260146} {:answer/id #uuid "2e72b69e-de1d-539b-bd7f-b17ba3bb78bc" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/01/0162f31b5dbb35c6d370dff9b54257708df39b6957f6547059842cd31769669b.png" :db/id #edb/ref 17592186260294} {:answer/id #uuid "7d7ac9b2-3db3-5b9c-a04a-a8589af15779" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/b4/b4642ea9b585ac066f2ed904b1bee4df7d1ff3449ba2d09afca8364b58f1dcba.png" :db/id #edb/ref 17592186260967} {:answer/id #uuid "867c8bfd-8db7-54f2-837f-8096fc36058e" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/7a/7afff53b46a661fc6e0df4df871810dc5514ff7b476294e76c70f60d4e1643f9.png" :db/id #edb/ref 17592186261045} {:answer/id #uuid "bebf2ce8-badd-5f41-86c5-5e5bb4040e73" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/f8/f82efe38e48f39aee18cf9e00cdd69f07c37cc414b08b5bc78ebc0a876c02d7e.png" :db/id #edb/ref 17592186261560}] :answer-field/correct {:db/id #edb/ref 17592186261045} :answer-field/id #uuid "12e3878f-62b0-500f-bf38-893dbf70a32f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186262158}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7f1a9983-9e78-5286-9a4c-31363bd01bd7" :question/math-academy-id "q-129118" :question/problem "Which of the following represents the level curves of $f(x,y)=-x-y+2?$" :question/worked-solution "The level curves for the function $f(x,y)$ are given by the equations \n\n$$\nf(x,y)=c.\n$$\n\nnotice that the range of $f(x,y)$ is $(-\\infty ,\\infty ).$ So, we will consider $c$-level curves for any real value of $c.$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f(x,y) & =c \\\\ -x-y+2 & =c \\\\ y & =-x+2-c.\\end{aligned}\n$$\n\nThe equation above gives us a family of lines with slope of $-1.$ Therefore, the correct graph is as follows:\n\n![](images/e2/e20175ef9ac473a621a67d524e60cacc6e9a40ba30267fe81b4e6a093c780c28.png)"} :step/id #uuid "41e20964-1263-5e71-a909-f0f937a95100"} {:db/id #edb/ref 17592186459326 :step/content {:db/id #edb/ref 17592186379766 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1aa93218-27b0-5ad5-8222-b7e37e2e20e4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186379768} {:answer/id #uuid "870c2e4a-2968-5ad3-9de4-98a3ab8a3888" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186379769} {:answer/id #uuid "3e07e993-4d1b-5f3e-bc88-fb33e5cf4d73" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186379770} {:answer/id #uuid "fa7d4122-ae51-5da7-9538-4f3a5a4e7279" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186379771} {:answer/id #uuid "67511d28-193a-5f98-b1ad-09961ee6f34d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186379772}] :answer-field/correct {:db/id #edb/ref 17592186379770} :answer-field/id #uuid "5e2961e2-c4d5-5918-ab70-c6f6a98c5129" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186379767}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "036af2f8-8d3f-5a9f-9714-c21bb558dc15" :question/math-academy-id "q-35538" :question/problem "The level curves of the function $f(x,y)=4x-3y-1$ are given by $f(x,y)=c.$ Which of the following statements are true?\n\nI. $c=-1$ gives a line\n\nII. $c=0$ gives the axes $x=0$ and $y=0$\n\nIII. $c=2$ gives a parabola" :question/worked-solution "Setting $f(x,y)=c$ gives:\n\n$$\n\\begin{aligned}4x-3y-1 & =c \\\\ 4x-3y-(c+1) & =0 \\\\ y & =\\frac{4}{3}x-\\frac{c+1}{3}\\end{aligned}\n$$\n\nTherefore:\n\n- If $c=-1$ then the level curve is $y=\\frac{4}{3}x,$ which is a line.\n\n- If $c=0$ then the level curve is $y=\\frac{4}{3}x-\\frac{1}{3},$ which is a line different to the axes $x=0$ and $y=0.$\n\n- If $c=2$ then the level curve is $y=\\frac{4}{3}x-1,$ which is not a parabola.\n\nSo, only statement I is true."} :step/id #uuid "6f39d2b2-32b1-5292-ba83-1e03f25801e3" :step/next {:db/id #edb/ref 17592186459313}} {:db/id #edb/ref 17592186459330 :step/content {:db/id #edb/ref 17592186371742 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f991d876-0326-5c0a-8b2a-21654d5968e4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II, and III" :db/id #edb/ref 17592186371744} {:answer/id #uuid "666513c1-30a7-57b3-9697-bfb795bc5ec5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186371745} {:answer/id #uuid "8ed80916-c09b-516a-9fa9-c624724d3990" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186371746} {:answer/id #uuid "43b2e3d7-12f2-5f46-a4a1-44f8a122b428" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186371747} {:answer/id #uuid "c3fa3a72-e885-51c1-841e-7a3be69e37dd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "None of those listed" :db/id #edb/ref 17592186371748}] :answer-field/correct {:db/id #edb/ref 17592186371747} :answer-field/id #uuid "1f4c2c44-ea9c-52ce-a441-c7c1c5f23e29" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186371743}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ee3c74bd-cd07-5dd0-b26f-4b93aa9647b3" :question/math-academy-id "q-129061" :question/problem "The level curves of the function $f(x,y)=\\sqrt{{x}^{2}+{y}^{2}}$ are given by $f(x,y)=c.$ Which of the following statements are true?\n\nI. $c=0$ gives the point $(0,0)$\n\nII. $c=1$ gives a circle of radius $1$\n\nIII. $c=4$ gives a parabola" :question/worked-solution "Setting $f(x,y)=c$ gives:\n\n$$\n\\begin{aligned}\\sqrt{{x}^{2}+{y}^{2}} & =c \\\\ {x}^{2}+{y}^{2} & ={c}^{2}\\end{aligned}\n$$\n\nTherefore:\n\n- If $c=0,$ the level curve is $x=y=0,$ which gives the point $(0,0).$ So, I is true.\n\n- If $c=1,$ the level curve is ${x}^{2}+{y}^{2}=1,$ which gives a circle of radius $1.$ So, II is true.\n\n- If $c=4,$ the level curve is ${x}^{2}+{y}^{2}=16,$ which gives a circle of radius $4.$ So, III is false.\n\nSo, the correct answer is \"I and II only\"."} :step/id #uuid "93acc85b-87ab-56b3-b7b9-af08ebc81605" :step/next {:db/id #edb/ref 17592186459322}}] :activity/title "Level Curves" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186458609}]}
