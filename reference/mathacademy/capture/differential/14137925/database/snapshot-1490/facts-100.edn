92186045417] [17592186436602 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186436602 #edb/ref 1078 #edb/ref 17592186436551 #edb/ref 17592186045417] [17592186436602 #edb/ref 1079 #uuid "cf6e9e9d-4e43-54d1-b414-a2a8e2b2fbf9" #edb/ref 17592186045417] [17592186436603 #edb/ref 1075 #edb/ref 17592186436540 #edb/ref 17592186045417] [17592186436603 #edb/ref 1075 #edb/ref 17592186436546 #edb/ref 17592186045417] [17592186436603 #edb/ref 1075 #edb/ref 17592186436552 #edb/ref 17592186045417] [17592186436603 #edb/ref 1075 #edb/ref 17592186436569 #edb/ref 17592186045417] [17592186436603 #edb/ref 1075 #edb/ref 17592186436571 #edb/ref 17592186045417] [17592186436603 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186436603 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186436603 #edb/ref 1078 #edb/ref 17592186436540 #edb/ref 17592186045417] [17592186436603 #edb/ref 1079 #uuid "e47d5957-7c5b-50d5-a6fa-3e6133a8dcdf" #edb/ref 17592186045417] [17592186436604 #edb/ref 1068 #edb/ref 17592186436597 #edb/ref 17592186045417] [17592186436604 #edb/ref 1069 "q-132261" #edb/ref 17592186045417] [17592186436604 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186436604 #edb/ref 1071 "For the function $f(x,y)={cos}^{2}⁡(3x-{y}^{2}),$ evaluate $\\frac{∂f}{∂y}$ at the point $(0,\\sqrt{\\pi }).$" #edb/ref 17592186045417] [17592186436604 #edb/ref 1072 #uuid "0d55bb11-970c-5f1f-831a-44fb97e659c5" #edb/ref 17592186045417] [17592186436604 #edb/ref 1074 "We differentiate the given function with respect to $y,$ treating all other variables as constants. \n\nFirst, we use the chain rule: \n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}({cos}^{2}⁡(3x-{y}^{2})) \\\\  & =2\\operatorname{cos}⁡(3x-{y}^{2})\\cdot \\frac{∂}{∂y}(\\operatorname{cos}⁡(3x-{y}^{2})) \\\\  & =-2\\operatorname{cos}⁡(3x-{y}^{2})\\cdot \\operatorname{sin}⁡(3x-{y}^{2})\\cdot \\frac{∂}{∂y}(3x-{y}^{2})\\end{aligned}\n$$\n\nNow, we use the sum and constant multiple rules for differentiation:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =-2\\operatorname{cos}⁡(3x-{y}^{2})\\operatorname{sin}⁡(3x-{y}^{2})\\cdot (3x\\frac{∂}{∂y}(1)-\\frac{∂}{∂y}({y}^{2})) \\\\  & =-2\\operatorname{cos}⁡(3x-{y}^{2})\\operatorname{sin}⁡(3x-{y}^{2})\\cdot (3x\\cdot 0-2y) \\\\  & =4y\\operatorname{cos}⁡(3x-{y}^{2})\\operatorname{sin}⁡(3x-{y}^{2})\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(0,\\sqrt{\\pi }):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y}{|}_{(0,\\sqrt{\\pi })} & =4(\\sqrt{\\pi })\\operatorname{cos}⁡(3(0)-{(\\sqrt{\\pi })}^{2})\\operatorname{sin}⁡(3(0)-{(\\sqrt{\\pi })}^{2}) \\\\  & =4\\sqrt{\\pi }\\operatorname{cos}⁡(-\\pi )\\operatorname{sin}⁡(-\\pi ) \\\\  & =0\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186436605 #edb/ref 1068 #edb/ref 17592186436593 #edb/ref 17592186045417] [17592186436605 #edb/ref 1069 "q-159696" #edb/ref 17592186045417] [17592186436605 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186436605 #edb/ref 1071 "For the function $f(x,y)=\\frac{3xy-1}{2x-3y},$ evaluate $\\frac{∂f}{∂y}$ at the point $(0,-1).$" #edb/ref 17592186045417] [17592186436605 #edb/ref 1072 #uuid "26e723d1-2e7d-5b20-b4fd-e3325c571238" #edb/ref 17592186045417] [17592186436605 #edb/ref 1074 "We differentiate the given function with respect to $y,$ treating all other variables as constants. \n\nFirst, we use the quotient rule:\n\n$$\n\\begin{aligned}\\frac{∂}{∂y}(\\frac{3xy-1}{2x-3y}) & =\\frac{\\frac{∂}{∂y}(3xy-1)\\cdot (2x-3y)-(3xy-1)\\cdot \\frac{∂}{∂y}(2x-3y)}{(2x-3y)^{2}} \\\\  & =\\frac{3x\\cdot (2x-3y)-(3xy-1)\\cdot (-3)}{(2x-3y)^{2}} \\\\  & =\\frac{6{x}^{2}-9xy+9xy-3}{(2x-3y)^{2}} \\\\  & =\\frac{6{x}^{2}-3}{(2x-3y)^{2}}\\end{aligned}\n$$\n\n \n\nFinally, we evaluate the partial derivative at the point $(0,-1):$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}{|}_{(0,-1)} & =\\frac{6(0)^{2}-3}{(2(0)-3(-1))^{2}} \\\\  & =\\frac{-3}{{3}^{2}} \\\\  & =-\\frac{1}{3}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186436606 #edb/ref 1068 #edb/ref 17592186436602 #edb/ref 17592186045417] [17592186436606 #edb/ref 1069 "q-159720" #edb/ref 17592186045417] [17592186436606 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186436606 #edb/ref 1071 "Consider the function $f(x,y)=\\frac{{e}^{xy}}{xy}.$ The partial derivative of $f$ with respect to $x$ is given by\n\n$$\n\\frac{∂f}{∂x}=\\frac{h(x,y){e}^{xy}}{{x}^{2}y}.\n$$\n\nFind the function $h(x,y).$" #edb/ref 17592186045417] [17592186436606 #edb/ref 1072 #uuid "27e4d0e6-6215-57d4-b123-69cd51f3932f" #edb/ref 17592186045417] [17592186436606 #edb/ref 1074 "We differentiate the given function with respect to $x,$ treating all other variables as constants. \n\nUsing the quotient and chain rules, we have\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(\\frac{{e}^{xy}}{xy}) \\\\  & =\\frac{\\frac{∂}{∂x}({e}^{xy})\\cdot xy-{e}^{xy}\\cdot \\frac{∂}{∂x}(xy)}{(xy)^{2}} \\\\  & =\\frac{{e}^{xy}\\cdot \\frac{∂}{∂x}(xy)\\cdot xy-{e}^{xy}\\cdot y}{{x}^{2}{y}^{2}} \\\\  & =\\frac{{e}^{xy}\\cdot y\\cdot xy-y{e}^{xy}}{{x}^{2}{y}^{2}} \\\\  & =\\frac{y{e}^{xy}(xy-1)}{{x}^{2}{y}^{2}} \\\\  & =\\frac{(xy-1){e}^{xy}}{{x}^{2}y}\\end{aligned}\n$$\n\n \n\nTherefore, we conclude that\n\n$$\nh(x,y)=xy-1.\n$$" #edb/ref 17592186045417] [17592186436607 #edb/ref 1068 #edb/ref 17592186436598 #edb/ref 17592186045417] [17592186436607 #edb/ref 1069 "q-132258" #edb/ref 17592186045417] [17592186436607 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186436607 #edb/ref 1071 "For the function $f(x,y,z)={e}^{4y-x{z}^{4}},$ evaluate $\\frac{∂f}{∂x}$ at the point $(4,1,1).$" #edb/ref 17592186045417] [17592186436607 #edb/ref 1072 #uuid "45d0ef52-763b-56d4-b138-648452f050d7" #edb/ref 17592186045417] [17592186436607 #edb/ref 1074 "We differentiate the given function with respect to $x,$ treating all other variables as constants. \n\nUsing the chain rule, we have\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}({e}^{4y-x{z}^{4}}) \\\\  & ={e}^{4y-x{z}^{4}}\\cdot \\frac{∂}{∂x}(4y-x{z}^{4}).\\end{aligned}\n$$\n\nThen, we use the sum and constant multiple rules:\n\n$$\n\\begin{aligned}{e}^{4y-x{z}^{4}}\\cdot \\frac{∂}{∂x}(4y-x{z}^{4}) & ={e}^{4y-x{z}^{4}}\\cdot (\\frac{∂}{∂x}(4y)-\\frac{∂}{∂x}(x{z}^{4})) \\\\  & ={e}^{4y-x{z}^{4}}\\cdot (0-{z}^{4}\\frac{∂}{∂x}(x)) \\\\  & ={e}^{4y-x{z}^{4}}\\cdot (-{z}^{4})\\cdot 1 \\\\  & =-{z}^{4}{e}^{4y-x{z}^{4}}\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(4,1,1):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂z}{|}_{(4,1,1)} & =-(1)^{4}{e}^{4(1)-4(1)^{4}} \\\\  & =-1\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186436608 #edb/ref 1068 #edb/ref 17592186436595 #edb/ref 17592186045417] [17592186436608 #edb/ref 1069 "q-70029" #edb/ref 17592186045417] [17592186436608 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186436608 #edb/ref 1071 "For the function $f(x,y)=(2y+1)^{2x+1},$ evaluate $\\frac{∂f}{∂y}$ at the point $(2,0).$" #edb/ref 17592186045417] [17592186436608 #edb/ref 1072 #uuid "6c44dfc3-39f6-598a-be48-62e051abdda4" #edb/ref 17592186045417] [17592186436608 #edb/ref 1074 "We differentiate the given function with respect to $y,$ treating all other variables as constants. \n\nFirst, we use the chain rule: \n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}((2y+1)^{2x+1}) \\\\  & =(2x+1)(2y+1)^{2x}\\cdot \\frac{∂}{∂y}((2y+1))\\end{aligned}\n$$\n\nNow, we use the sum and constant multiple rules for differentiation:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =(2x+1)(2y+1)^{2x}\\cdot (2\\frac{∂}{∂y}(y)+\\frac{∂}{∂y}(1)) \\\\  & =(2x+1)(2y+1)^{2x}\\cdot (2\\cdot 1+0) \\\\  & =2(2x+1)(2y+1)^{2x}\\end{aligned}\n$$\n\n \n\nFinally, we evaluate the partial derivative at the point $(2,0):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y}{|}_{(2,0)} & =2\\cdot (2\\cdot 2+1)\\cdot (2\\cdot 0+1)^{2\\cdot 2} \\\\  & =2\\cdot 5\\cdot {1}^{4} \\\\  & =10\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186436609 #edb/ref 1068 #edb/ref 17592186436600 #edb/ref 17592186045417] [17592186436609 #edb/ref 1069 "q-159715" #edb/ref 17592186045417] [17592186436609 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186436609 #edb/ref 1071 "Find ${f}_{x}(x,y)$ for $f(x,y)={x}^{2}{y}^{2}{e}^{{x}^{2}}.$" #edb/ref 17592186045417] [17592186436609 #edb/ref 1072 #uuid "a1fee486-b1a7-59bd-ae9a-400ceeb58414" #edb/ref 17592186045417] [17592186436609 #edb/ref 1074 "We differentiate the given function with respect to $x,$ treating all other variables as constants. \n\nFirst, we use the constant multiple rule:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}({x}^{2}{y}^{2}{e}^{{x}^{2}}) \\\\  & ={y}^{2}\\frac{∂}{∂x}({x}^{2}{e}^{{x}^{2}})\\end{aligned}\n$$\n\nThen, we use the product rule and the chain rule:\n\n$$\n\\begin{aligned}{y}^{2}\\frac{∂}{∂x}({x}^{2}{e}^{{x}^{2}}) & ={y}^{2}(\\frac{∂}{∂x}({x}^{2})\\cdot {e}^{{x}^{2}}+{x}^{2}\\cdot \\frac{∂}{∂x}({e}^{{x}^{2}})) \\\\  & ={y}^{2}((2x)\\cdot {e}^{{x}^{2}}+{x}^{2}\\cdot {e}^{{x}^{2}}\\cdot \\frac{∂}{∂x}({x}^{2})) \\\\  & ={y}^{2}(2x{e}^{{x}^{2}}+{x}^{2}{e}^{{x}^{2}}\\cdot (2x)) \\\\  & ={y}^{2}(2x{e}^{{x}^{2}}+2{x}^{3}{e}^{{x}^{2}}) \\\\  & =2{y}^{2}(x+{x}^{3}){e}^{{x}^{2}}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186436610 #edb/ref 1068 #edb/ref 17592186436594 #edb/ref 17592186045417] [17592186436610 #edb/ref 1069 "q-132251" #edb/ref 17592186045417] [17592186436610 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186436610 #edb/ref 1071 "Find ${f}_{x}(x,y,z)$ for $f(x,y,z)={cos}^{2}⁡(3x-{y}^{2}).$" #edb/ref 17592186045417] [17592186436610 #edb/ref 1072 #uuid "a235487c-a19a-5a88-ae3b-cb08ed11bcd3" #edb/ref 17592186045417] [17592186436610 #edb/ref 1074 "We differentiate the given function with respect to $x,$ treating all other variables as constants. \n\nUsing the chain rule, we have\n\n$$\n\\begin{aligned}{f}_{x}(x,y,z) & =\\frac{∂}{∂x}({cos}^{2}⁡(3x-{y}^{2})) \\\\  & =2\\operatorname{cos}⁡(3x-{y}^{2})\\cdot \\frac{∂}{∂x}(\\operatorname{cos}⁡(3x-{y}^{2})) \\\\  & =2\\operatorname{cos}⁡(3x-{y}^{2})\\cdot (-\\operatorname{sin}⁡(3x-{y}^{2}))\\cdot \\frac{∂}{∂x}(3x-{y}^{2}) \\\\  & =2\\operatorname{cos}⁡(3x-{y}^{2})\\cdot (-\\operatorname{sin}⁡(3x-{y}^{2}))\\cdot 3 \\\\  & =-6\\operatorname{sin}⁡(3x-{y}^{2})\\operatorname{cos}⁡(3x-{y}^{2}).\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186436611 #edb/ref 1068 #edb/ref 17592186436592 #edb/ref 17592186045417] [17592186436611 #edb/ref 1069 "q-159691" #edb/ref 17592186045417] [17592186436611 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186436611 #edb/ref 1071 "Find ${f}_{y}(x,y)$ for $f(x,y)={x}^{2}y\\operatorname{ln}⁡({y}^{4}).$" #edb/ref 17592186045417] [17592186436611 #edb/ref 1072 #uuid "aaa7facc-73c8-58b5-b03f-ad80dd8597f5" #edb/ref 17592186045417] [17592186436611 #edb/ref 1074 "We differentiate the given function with respect to $y,$ treating all other variables as constants. \n\nFirst, we use the constant multiple rule:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂y}({x}^{2}y\\operatorname{ln}⁡({y}^{4})) \\\\  & ={x}^{2}\\cdot \\frac{∂}{∂y}(y\\operatorname{ln}⁡({y}^{4}))\\end{aligned}\n$$\n\nThen, we use the product and the chain rule:\n\n$$\n\\begin{aligned}{x}^{2}\\cdot \\frac{∂}{∂y}(y\\operatorname{ln}⁡({y}^{4})) & ={x}^{2}\\cdot (\\frac{∂}{∂y}(y)\\cdot \\operatorname{ln}⁡({y}^{4})+y\\cdot \\frac{∂}{∂y}(\\operatorname{ln}⁡({y}^{4})) \\\\  & ={x}^{2}\\cdot (1\\cdot \\operatorname{ln}⁡({y}^{4})+y\\cdot \\frac{1}{{y}^{4}}\\cdot \\frac{∂}{∂y}({y}^{4})) \\\\  & ={x}^{2}\\cdot (\\operatorname{ln}⁡({y}^{4})+\\frac{1}{{y}^{3}}\\cdot (4{y}^{3}))) \\\\  & ={x}^{2}(\\operatorname{ln}⁡({y}^{4})+4)\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186436612 #edb/ref 1068 #edb/ref 17592186436599 #edb/ref 17592186045417] [17592186436612 #edb/ref 1069 "q-159653" #edb/ref 17592186045417] [17592186436612 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186436612 #edb/ref 1071 "Find $\\frac{∂f}{∂x}$ for $f(x,y)=\\operatorname{ln}⁡(xy)-xy.$" #edb/ref 17592186045417] [17592186436612 #edb/ref 1072 #uuid "b72fd759-0cb1-5717-8778-6af4e6d7337a" #edb/ref 17592186045417] [17592186436612 #edb/ref 1074 "We differentiate the given function with respect to $x,$ treating all other variables as constants. \n\nFirst, we use the sum rule for differentiation:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(\\operatorname{ln}⁡(xy)-xy) \\\\  & =\\frac{∂}{∂x}(\\operatorname{ln}⁡(xy))-\\frac{∂}{∂x}(yx)\\end{aligned}\n$$\n\nNow, we use the chain rule and the constant multiple rules for differentiation:\n\n$$\n\\begin{aligned}\\frac{∂}{∂x}(\\operatorname{ln}⁡(xy))-\\frac{∂}{∂x}(yx) & =\\frac{1}{xy}\\cdot \\frac{∂}{∂x}(xy)-\\frac{∂}{∂x}(yx) \\\\  & =\\frac{1}{xy}\\cdot y\\cdot \\frac{∂}{∂x}(x)-y\\cdot \\frac{∂}{∂x}(x) \\\\  & =\\frac{1}{xy}\\cdot y\\cdot 1-y\\cdot 1 \\\\  & =\\frac{1}{x}-y\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186436613 #edb/ref 1068 #edb/ref 17592186436596 #edb/ref 17592186045417] [17592186436613 #edb/ref 1069 "q-159702" #edb/ref 17592186045417] [17592186436613 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186436613 #edb/ref 1071 "For the function $f(x,y)=\\frac{{y}^{2}-{x}^{2}}{\\sqrt{y}},$ evaluate $\\frac{∂f}{∂y}$ at the point $(3,1).$" #edb/ref 17592186045417] [17592186436613 #edb/ref 1072 #uuid "f311e12c-1089-5d71-97f6-83e1fd9c3339" #edb/ref 17592186045417] [17592186436613 #edb/ref 1074 "We differentiate the given function with respect to $y,$ treating all other variables as constants. \n\nFirst, we use the quotient rule:\n\n$$\n\\begin{aligned}\\frac{∂}{∂y}(\\frac{{y}^{2}-{x}^{2}}{\\sqrt{y}}) & =\\frac{\\frac{∂}{∂y}({y}^{2}-{x}^{2})\\cdot \\sqrt{y}-({y}^{2}-{x}^{2})\\cdot \\frac{∂}{∂y}(\\sqrt{y})}{{(\\sqrt{y})}^{2}} \\\\  & =\\frac{(2y\\cdot \\sqrt{y}-({y}^{2}-{x}^{2})\\cdot \\frac{1}{2\\sqrt{y}})}{y} \\\\  & =\\frac{(\\frac{4{y}^{2}+{x}^{2}-{y}^{2}}{2\\sqrt{y}})}{y} \\\\  & =\\frac{{x}^{2}+3{y}^{2}}{2y\\sqrt{y}}\\end{aligned}\n$$\n\n \n\nFinally, we evaluate the partial derivative at the point $(3,1):$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}{|}_{(3,1)} & =\\frac{{3}^{2}+3(1)^{2}}{2(1)\\sqrt{1}} \\\\  & =\\frac{9+3}{2} \\\\  & =6\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186436614 #edb/ref 1068 #edb/ref 17592186436601 #edb/ref 17592186045417] [17592186436614 #edb/ref 1069 "q-159721" #edb/ref 17592186045417] [17592186436614 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186436614 #edb/ref 1071 "Consider the function $f(x,y)=\\frac{6x+11y}{\\sqrt{y}}.$ The partial derivative of $f$ with respect to $y$ is given by\n\n$$\n\\frac{∂f}{∂y}=\\frac{h(x,y)}{2y\\sqrt{y}}.\n$$\n\nFind the function $h(x,y).$" #edb/ref 17592186045417] [17592186436614 #edb/ref 1072 #uuid "f88992c6-7672-5688-a790-113b251f1d96" #edb/ref 17592186045417] [17592186436614 #edb/ref 1074 "We differentiate the given function with respect to $y,$ treating all other variables as constants. \n\nUsing the quotient rule, we have\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}(\\frac{6x+11y}{\\sqrt{y}}) \\\\  & =\\frac{\\frac{∂}{∂y}(6x+11y)\\cdot \\sqrt{y}-(6x+11y)\\cdot \\frac{∂}{∂y}(\\sqrt{y})}{{(\\sqrt{y})}^{2}} \\\\  & =\\frac{(11\\cdot \\sqrt{y}-(6x+11y)\\cdot \\frac{1}{2\\sqrt{y}})}{y} \\\\  & =\\frac{(\\frac{22y-(6x+11y)}{2\\sqrt{y}})}{y} \\\\  & =\\frac{11y-6x}{2y\\sqrt{y}}\\end{aligned}\n$$\n\n \n\nTherefore, we conclude that\n\n$$\nh(x,y)=11y-6x.\n$$" #edb/ref 17592186045417] [17592186436615 #edb/ref 1068 #edb/ref 17592186436603 #edb/ref 17592186045417] [17592186436615 #edb/ref 1069 "q-159663" #edb/ref 17592186045417] [17592186436615 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186436615 #edb/ref 1071 "For the function $f(x,y)=\\operatorname{arctan}⁡(x{y}^{2}),$ evaluate $\\frac{∂f}{∂x}$ at the point $(1,3).$" #edb/ref 17592186045417] [17592186436615 #edb/ref 1072 #uuid "fe49ff44-a8f4-5323-af29-4e99b3a5291b" #edb/ref 17592186045417] [17592186436615 #edb/ref 1074 "We differentiate the given function with respect to $x,$ treating all other variables as constants. \n\nFirst, we use the chain rule: \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(\\operatorname{arctan}⁡(x{y}^{2}))) \\\\  & =\\frac{1}{1+{(x{y}^{2})}^{2}}\\cdot \\frac{∂}{∂x}(x{y}^{2}) \\\\  & =\\frac{1}{1+{x}^{2}{y}^{4}}\\cdot \\frac{∂}{∂x}(x{y}^{2})\\end{aligned}\n$$\n\nNow, we use the constant multiple rule for differentiation:\n\n$$\n\\begin{aligned}\\frac{1}{1+{x}^{2}{y}^{4}}\\cdot \\frac{∂}{∂x}(x{y}^{2}) & =\\frac{1}{1+{x}^{2}{y}^{4}}\\cdot {y}^{2}\\cdot \\frac{∂}{∂x}(x) \\\\  & =\\frac{1}{1+{x}^{2}{y}^{4}}\\cdot {y}^{2}\\cdot 1 \\\\  & =\\frac{{y}^{2}}{1+{x}^{2}{y}^{4}}\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(1,3):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y}{|}_{(1,3)} & =\\frac{{3}^{2}}{1+{1}^{2}\\cdot {3}^{4}} \\\\  & =\\frac{9}{1+81} \\\\  & =\\frac{9}{82}\\end{aligned}\n$$" #edb/ref 17592186045417]}
