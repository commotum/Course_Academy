ratorname{ln}⁡({y}^{4}))\\end{aligned}\n$$\n\nThen, we use the product and the chain rule:\n\n$$\n\\begin{aligned}{x}^{2}\\cdot \\frac{∂}{∂y}(y\\operatorname{ln}⁡({y}^{4})) & ={x}^{2}\\cdot (\\frac{∂}{∂y}(y)\\cdot \\operatorname{ln}⁡({y}^{4})+y\\cdot \\frac{∂}{∂y}(\\operatorname{ln}⁡({y}^{4})) \\\\  & ={x}^{2}\\cdot (1\\cdot \\operatorname{ln}⁡({y}^{4})+y\\cdot \\frac{1}{{y}^{4}}\\cdot \\frac{∂}{∂y}({y}^{4})) \\\\  & ={x}^{2}\\cdot (\\operatorname{ln}⁡({y}^{4})+\\frac{1}{{y}^{3}}\\cdot (4{y}^{3}))) \\\\  & ={x}^{2}(\\operatorname{ln}⁡({y}^{4})+4)\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-0fb83488-f3c3-5970-b632-d70d187404f5"] :db/ensure [:question/validate]} {:db/id "answer-field-0fb83488-f3c3-5970-b632-d70d187404f5" :answer-field/id #uuid "0fb83488-f3c3-5970-b632-d70d187404f5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e35b52fb-dc96-5d35-81e4-c054d2cd8c0f" :answer-field/choices ["answer-a92787e6-66cd-5569-b00d-1c269f0cc548" "answer-f3882228-8779-5c90-80d2-5aebfcddf4d7" "answer-738f363f-7faa-5ab8-9897-b5ae98173bef" "answer-f700fd99-e71c-5d3f-aa39-098cd2e2c465" "answer-e35b52fb-dc96-5d35-81e4-c054d2cd8c0f"] :db/ensure [:answer-field/validate]} {:db/id "answer-a92787e6-66cd-5569-b00d-1c269f0cc548" :answer/id #uuid "a92787e6-66cd-5569-b00d-1c269f0cc548" :answer/type :answer.type/math :answer/value "2xy\\operatorname{ln}⁡({y}^{4})" :db/ensure [:answer/validate]} {:db/id "answer-f3882228-8779-5c90-80d2-5aebfcddf4d7" :answer/id #uuid "f3882228-8779-5c90-80d2-5aebfcddf4d7" :answer/type :answer.type/math :answer/value "4{x}^{2}\\operatorname{ln}⁡({y}^{4})" :db/ensure [:answer/validate]} {:db/id "answer-738f363f-7faa-5ab8-9897-b5ae98173bef" :answer/id #uuid "738f363f-7faa-5ab8-9897-b5ae98173bef" :answer/type :answer.type/math :answer/value "x(y\\operatorname{ln}⁡({y}^{4})+4)" :db/ensure [:answer/validate]} {:db/id "answer-f700fd99-e71c-5d3f-aa39-098cd2e2c465" :answer/id #uuid "f700fd99-e71c-5d3f-aa39-098cd2e2c465" :answer/type :answer.type/math :answer/value "{x}^{2}(\\operatorname{ln}⁡({y}^{4})+2y)" :db/ensure [:answer/validate]} {:db/id "answer-e35b52fb-dc96-5d35-81e4-c054d2cd8c0f" :answer/id #uuid "e35b52fb-dc96-5d35-81e4-c054d2cd8c0f" :answer/type :answer.type/math :answer/value "{x}^{2}(\\operatorname{ln}⁡({y}^{4})+4)" :db/ensure [:answer/validate]} {:db/id "question-27e4d0e6-6215-57d4-b123-69cd51f3932f" :question/id #uuid "27e4d0e6-6215-57d4-b123-69cd51f3932f" :question/math-academy-id "q-159720" :question/problem "Consider the function $f(x,y)=\\frac{{e}^{xy}}{xy}.$ The partial derivative of $f$ with respect to $x$ is given by\n\n$$\n\\frac{∂f}{∂x}=\\frac{h(x,y){e}^{xy}}{{x}^{2}y}.\n$$\n\nFind the function $h(x,y).$" :question/worked-solution "We differentiate the given function with respect to $x,$ treating all other variables as constants. \n\nUsing the quotient and chain rules, we have\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(\\frac{{e}^{xy}}{xy}) \\\\  & =\\frac{\\frac{∂}{∂x}({e}^{xy})\\cdot xy-{e}^{xy}\\cdot \\frac{∂}{∂x}(xy)}{(xy)^{2}} \\\\  & =\\frac{{e}^{xy}\\cdot \\frac{∂}{∂x}(xy)\\cdot xy-{e}^{xy}\\cdot y}{{x}^{2}{y}^{2}} \\\\  & =\\frac{{e}^{xy}\\cdot y\\cdot xy-y{e}^{xy}}{{x}^{2}{y}^{2}} \\\\  & =\\frac{y{e}^{xy}(xy-1)}{{x}^{2}{y}^{2}} \\\\  & =\\frac{(xy-1){e}^{xy}}{{x}^{2}y}\\end{aligned}\n$$\n\n \n\nTherefore, we conclude that\n\n$$\nh(x,y)=xy-1.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-cf6e9e9d-4e43-54d1-b414-a2a8e2b2fbf9"] :db/ensure [:question/validate]} {:db/id "answer-field-cf6e9e9d-4e43-54d1-b414-a2a8e2b2fbf9" :answer-field/id #uuid "cf6e9e9d-4e43-54d1-b414-a2a8e2b2fbf9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8397e509-d007-5ca5-ab7f-b6777f6c8813" :answer-field/choices ["answer-898b4cbe-f73a-573e-8210-8119141fd3d5" "answer-3e5aa69d-a57a-53e7-a411-7b8d1e231bc4" 