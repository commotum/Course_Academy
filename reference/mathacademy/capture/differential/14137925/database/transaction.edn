gned}\n$$\n\n \n\nFinally, we evaluate the partial derivative at the point $(3,1):$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}{|}_{(3,1)} & =\\frac{{3}^{2}+3(1)^{2}}{2(1)\\sqrt{1}} \\\\  & =\\frac{9+3}{2} \\\\  & =6\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-3b91fb5a-fb60-5758-b55c-b8f8d909486c"] :db/ensure [:question/validate]} {:db/id "answer-field-3b91fb5a-fb60-5758-b55c-b8f8d909486c" :answer-field/id #uuid "3b91fb5a-fb60-5758-b55c-b8f8d909486c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d25dbf87-9ff4-5222-983d-a08125cb25b8" :answer-field/choices ["answer-d9cd43b3-1131-5c70-bf1e-5c97871cb3df" "answer-f122d57b-621e-5f14-a573-0116c8efb68e" "answer-49517556-0d0e-548e-a3c1-8430dc1612ad" "answer-92355996-2538-5d06-adbb-60fbc547dfd7" "answer-d25dbf87-9ff4-5222-983d-a08125cb25b8"] :db/ensure [:answer-field/validate]} {:db/id "answer-d9cd43b3-1131-5c70-bf1e-5c97871cb3df" :answer/id #uuid "d9cd43b3-1131-5c70-bf1e-5c97871cb3df" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "answer-f122d57b-621e-5f14-a573-0116c8efb68e" :answer/id #uuid "f122d57b-621e-5f14-a573-0116c8efb68e" :answer/type :answer.type/math :answer/value "-8" :db/ensure [:answer/validate]} {:db/id "answer-49517556-0d0e-548e-a3c1-8430dc1612ad" :answer/id #uuid "49517556-0d0e-548e-a3c1-8430dc1612ad" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-92355996-2538-5d06-adbb-60fbc547dfd7" :answer/id #uuid "92355996-2538-5d06-adbb-60fbc547dfd7" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-d25dbf87-9ff4-5222-983d-a08125cb25b8" :answer/id #uuid "d25dbf87-9ff4-5222-983d-a08125cb25b8" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "question-f88992c6-7672-5688-a790-113b251f1d96" :question/id #uuid "f88992c6-7672-5688-a790-113b251f1d96" :question/math-academy-id "q-159721" :question/problem "Consider the function $f(x,y)=\\frac{6x+11y}{\\sqrt{y}}.$ The partial derivative of $f$ with respect to $y$ is given by\n\n$$\n\\frac{∂f}{∂y}=\\frac{h(x,y)}{2y\\sqrt{y}}.\n$$\n\nFind the function $h(x,y).$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants. \n\nUsing the quotient rule, we have\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}(\\frac{6x+11y}{\\sqrt{y}}) \\\\  & =\\frac{\\frac{∂}{∂y}(6x+11y)\\cdot \\sqrt{y}-(6x+11y)\\cdot \\frac{∂}{∂y}(\\sqrt{y})}{{(\\sqrt{y})}^{2}} \\\\  & =\\frac{(11\\cdot \\sqrt{y}-(6x+11y)\\cdot \\frac{1}{2\\sqrt{y}})}{y} \\\\  & =\\frac{(\\frac{22y-(6x+11y)}{2\\sqrt{y}})}{y} \\\\  & =\\frac{11y-6x}{2y\\sqrt{y}}\\end{aligned}\n$$\n\n \n\nTherefore, we conclude that\n\n$$\nh(x,y)=11y-6x.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ba8cfa2f-c627-57d0-923a-8380a85a57e1"] :db/ensure [:question/validate]} {:db/id "answer-field-ba8cfa2f-c627-57d0-923a-8380a85a57e1" :answer-field/id #uuid "ba8cfa2f-c627-57d0-923a-8380a85a57e1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9aa74480-20e7-5b9c-bfdf-57f701ad6150" :answer-field/choices ["answer-9aa74480-20e7-5b9c-bfdf-57f701ad6150" "answer-6a8f703d-08c4-5364-a106-a8206935b823" "answer-f4bd98b7-39d1-5926-929c-4305a2b89c9b" "answer-3cc88c0d-b906-5169-8020-771089d1d342" "answer-8e2c81c3-bd1b-576f-8ea5-5e15ecc6a989"] :db/ensure [:answer-field/validate]} {:db/id "answer-9aa74480-20e7-5b9c-bfdf-57f701ad6150" :answer/id #uuid "9aa74480-20e7-5b9c-bfdf-57f701ad6150" :answer/type :answer.type/math :answer/value "11y-6x" :db/ensure [:answer/validate]} {:db/id "answer-6a8f703d-08c4-5364-a106-a8206935b823" :answer/id #uuid "6a8f703d-08c4-5364-a106-a8206935b823" :answer/type :answer.type/math :answer/value "2x-11y" :db/ensure [:answer/validate]} {:db/id "answer-f4bd98b7-39d1-5926-929c-4305a2b89c9b" :answer/id #uuid "f4bd98b7-39d1-5926-929c-4305a2b89c9b" :answer/type :answer.type/math :answer/value "3x+11y" :db/ensure [:answer/validate]} {:db/id "answer-3cc88c0d-b906-5169-8020-771089d1d342" :answer/id #uuid "3cc88c0d-b906-5169-8020-771089d1d342" :answer/type :answer.type/math :answer/value "3x+7y" :db/ensure [:answer/validate]} {:db/id "answer-8e2c81c3-bd1b-576f-8ea5-5e15ecc6a989" :answer/id #uuid "8e2c81c3-bd1b-576f-8ea5-5e15ecc6a989" :answer/type :answer.type/math :answer/value "6x-22y" :db/ensure [:answer/validate]} {:db/id "question-26e723d1-2e7d-5b20-b4fd-e3325c571238" :question/id #uuid "26e723d1-2e7d-5b20-b4fd-e3325c571238" :question/math-academy-id "q-159696" :question/problem "For the function $f(x,y)=\\frac{3xy-1}{2x-3y},$ evaluate $\\frac{∂f}{∂y}$ at the point $(0,-1).$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants. \n\nFirst, we use the quotient rule:\n\n$$\n\\begin{aligned}\\frac{∂}{∂y}(\\frac{3xy-1}{2x-3y}) & =\\frac{\\frac{∂}{∂y}(3xy-1)\\cdot (2x-3y)-(3xy-1)\\cdot \\frac{∂}{∂y}(2x-3y)}{(2x-3y)^{2}} \\\\  & =\\frac{3x\\cdot (2x-3y)-(3xy-1)\\cdot (-3)}{(2x-3y)^{2}} \\\\  & =\\frac{6{x}^{2}-9xy+9xy-3}{(2x-3y)^{2}} \\\\  & =\\frac{6{x}^{2}-3}{(2x-3y)^{2}}\\end{aligned}\n$$\n\n \n\nFinally, we evaluate the partial derivative at the point $(0,-1):$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}{|}_{(0,-1)} & =\\frac{6(0)^{2}-3}{(2(0)-3(-1))^{2}} \\\\  & =\\frac{-3}{{3}^{2}} \\\\  & =-\\frac{1}{3}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-1990b86b-b897-5e01-b1d1-8c99349fdebe"] :db/ensure [:question/validate]} {:db/id "answer-field-1990b86b-b897-5e01-b1d1-8c99349fdebe" :answer-field/id #uuid "1990b86b-b897-5e01-b1d1-8c99349fdebe" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8dde26e5-909a-5520-b5a4-d567f4f30d3b" :answer-field/choices ["answer-8e6e21a7-d420-5add-b68c-d19db196b561" "answer-8dde26e5-909a-5520-b5a4-d567f4f30d3b" "answer-ab23a96c-3799-57cf-a6c2-1ae6ae0bc1c1" "answer-c12523e2-dee4-5166-961f-0a9b274f76d6" "answer-e1a4e0d8-9189-5dce-8c93-80f07feaa44f"] :db/ensure [:answer-field/validate]} {:db/id "answer-8e6e21a7-d420-5add-b68c-d19db196b561" :answer/id #uuid "8e6e21a7-d420-5add-b68c-d19db196b561" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-8dde26e5-909a-5520-b5a4-d567f4f30d3b" :answer/id #uuid "8dde26e5-909a-5520-b5a4-d567f4f30d3b" :answer/type :answer.type/math :answer/value "-\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-ab23a96c-3799-57cf-a6c2-1ae6ae0bc1c1" :answer/id #uuid "ab23a96c-3799-57cf-a6c2-1ae6ae0bc1c1" :answer/type :answer.type/math :answer/value "-\\frac{1}{9}" :db/ensure [:answer/validate]} {:db/id "answer-c12523e2-dee4-5166-961f-0a9b274f76d6" :answer/id #uuid "c12523e2-dee4-5166-961f-0a9b274f76d6" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-e1a4e0d8-9189-5dce-8c93-80f07feaa44f" :answer/id #uuid "e1a4e0d8-9189-5dce-8c93-80f07feaa44f" :answer/type :answer.type/math :answer/value "\\frac{1}{9}" :db/ensure [:answer/validate]} {:db/id "question-a235487c-a19a-5a88-ae3b-cb08ed11bcd3" :question/id #uuid "a235487c-a19a-5a88-ae3b-cb08ed11bcd3" :question/math-academy-id "q-132251" :question/problem "Find ${f}_{x}(x,y,z)$ for $f(x,y,z)={cos}^{2}⁡(3x-{y}^{2}).$" :question/worked-solution "We differentiate the given function with respect to $x,$ treating all other variables as constants. \n\nUsing the chain rule, we have\n\n$$\n\\begin{aligned}{f}_{x}(x,y,z) & =\\frac{∂}{∂x}({cos}^{2}⁡(3x-{y}^{2})) \\\\  & =2\\operatorname{cos}⁡(3x-{y}^{2})\\cdot \\frac{∂}{∂x}(\\operatorname{cos}⁡(3x-{y}^{2})) \\\\  & =2\\operatorname{cos}⁡(3x-{y}^{2})\\cdot (-\\operatorname{sin}⁡(3x-{y}^{2}))\\cdot \\frac{∂}{∂x}(3x-{y}^{2}) \\\\  & =2\\operatorname{cos}⁡(3x-{y}^{2})\\cdot (-\\operatorname{sin}⁡(3x-{y}^{2}))\\cdot 3 \\\\  & =-6\\operatorname{sin}⁡(3x-{y}^{2})\\operatorname{cos}⁡(3x-{y}^{2}).\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-1f0051c2-f01a-525a-9309-c47735be89a0"] :db/ensure [:question/validate]} {:db/id "answer-field-1f0051c2-f01a-525a-9309-c47735be89a0" :answer-field/id #uuid "1f0051c2-f01a-525a-9309-c47735be89a0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2da9aa45-1bc3-5a50-8a63-b565f85bcbad" :answer-field/choices ["answer-52dadf7c-60d4-59bf-a211-32c2a6e0ff88" "answer-6d9bf8eb-7a93-55c9-a108-2de82f52459e" "answer-2da9aa45-1bc3-5a50-8a63-b565f85bcbad" "answer-a42fffab-44a5-5b6b-b508-53d3e76d2912" "answer-be5d2acc-cc2d-528d-9424-532714fcefa9"] :db/ensure [:answer-field/validate]} {:db/id "answer-52dadf7c-60d4-59bf-a211-32c2a6e0ff88" :answer/id #uuid "52dadf7c-60d4-59bf-a211-32c2a6e0ff88" :answer/type :answer.type/math :answer/value "-2\\operatorname{cos}⁡(3x-{y}^{2})" :db/ensure [:answer/validate]} {:db/id "answer-6d9bf8eb-7a93-55c9-a108-2de82f52459e" :answer/id #uuid "6d9bf8eb-7a93-55c9-a108-2de82f52459e" :answer/type :answer.type/math :answer/value "-3\\operatorname{sin}⁡(3x-{y}^{2})\\operatorname{cos}⁡(3x-{y}^{2})" :db/ensure [:answer/validate]} {:db/id "answer-2da9aa45-1bc3-5a50-8a63-b565f85bcbad" :answer/id #uuid "2da9aa45-1bc3-5a50-8a63-b565f85bcbad" :answer/type :answer.type/math :answer/value "-6\\operatorname{sin}⁡(3x-{y}^{2})\\operatorname{cos}⁡(3x-{y}^{2})" :db/ensure [:answer/validate]} {:db/id "answer-a42fffab-44a5-5b6b-b508-53d3e76d2912" :answer/id #uuid "a42fffab-44a5-5b6b-b508-53d3e76d2912" :answer/type :answer.type/math :answer/value "3\\operatorname{sin}⁡(3x-{y}^{2})" :db/ensure [:answer/validate]} {:db/id "answer-be5d2acc-cc2d-528d-9424-532714fcefa9" :answer/id #uuid "be5d2acc-cc2d-528d-9424-532714fcefa9" :answer/type :answer.type/math :answer/value "4y\\operatorname{sin}⁡(3x-{y}^{2})\\operatorname{cos}⁡(3x-{y}^{2})" :db/ensure [:answer/validate]} {:db/id "question-45d0ef52-763b-56d4-b138-648452f050d7" :question/id #uuid "45d0ef52-763b-56d4-b138-648452f050d7" :question/math-academy-id "q-132258" :question/problem "For the function $f(x,y,z)={e}^{4y-x{z}^{4}},$ evaluate $\\frac{∂f}{∂x}$ at the point $(4,1,1).$" :question/worked-solution "We differentiate the given function with respect to $x,$ treating all other variables as constants. \n\nUsing the chain rule, we have\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}({e}^{4y-x{z}^{4}}) \\\\  & ={e}^{4y-x{z}^{4}}\\cdot \\frac{∂}{∂x}(4y-x{z}^{4}).\\end{aligned}\n$$\n\nThen, we use the sum and constant multiple rules:\n\n$$\n\\begin{aligned}{e}^{4y-x{z}^{4}}\\cdot \\frac{∂}{∂x}(4y-x{z}^{4}) & ={e}^{4y-x{z}^{4}}\\cdot (\\frac{∂}{∂x}(4y)-\\frac{∂}{∂x}(x{z}^{4})) \\\\  & ={e}^{4y-x{z}^{4}}\\cdot (0-{z}^{4}\\frac{∂}{∂x}(x)) \\\\  & ={e}^{4y-x{z}^{4}}\\cdot (-{z}^{4})\\cdot 1 \\\\  & =-{z}^{4}{e}^{4y-x{z}^{4}}\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(4,1,1):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂z}{|}_{(4,1,1)} & =-(1)^{4}{e}^{4(1)-4(1)^{4}} \\\\  & =-1\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-5ff5ffb8-ede5-57b1-913a-ec470f862cc8"] :db/ensure [:question/validate]} {:db/id "answer-field-5ff5ffb8-ede5-57b1-913a-ec470f862cc8" :answer-field/id #uuid "5ff5ffb8-ede5-57b1-913a-ec470f862cc8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2979f6ee-54a4-596c-a00e-b93729a2aa3f" :answer-field/choices ["answer-2979f6ee-54a4-596c-a00e-b93729a2aa3f" "answer-cb9d30be-a6d6-5be3-8d4c-d3456b4912f5" "answer-2ca6a6cc-0e50-532f-b694-62c94e10b39b" "answer-8deb0301-83cb-5ae4-a55a-80df750a6116" "answer-a3a2557a-94f8-59b3-b60d-cf6d567bf8a8"] :db/ensure [:answer-field/validate]} {:db/id "answer-2979f6ee-54a4-596c-a00e-b93729a2aa3f" :answer/id #uuid "2979f6ee-54a4-596c-a00e-b93729a2aa3f" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-cb9d30be-a6d6-5be3-8d4c-d3456b4912f5" :answer/id #uuid "cb9d30be-a6d6-5be3-8d4c-d3456b4912f5" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-2ca6a6cc-0e50-532f-b694-62c94e10b39b" :answer/id #uuid "2ca6a6cc-0e50-532f-b694-62c94e10b39b" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "answer-8deb0301-83cb-5ae4-a55a-80df750a6116" :answer/id #uuid "8deb0301-83cb-5ae4-a55a-80df750a6116" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-a3a2557a-94f8-59b3-b60d-cf6d567bf8a8" :answer/id #uuid "a3a2557a-94f8-59b3-b60d-cf6d567bf8a8" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id 17592186193890 :tutorial/content "We can use the chain, product, and quotient rules to find partial derivatives of multivariable functions. \n\nFor example, consider the following function: \n\n$$\nf(x,y) = \\cos(xy^2) + 3x\n$$\n\nTo compute the partial derivative of $f$ with respect to $x,$ we \"fix\" the variable ${\\color{blue}y}$ (in other words, we treat ${\\color{blue}y}$ as if it were constant). Then, we take the derivative with respect to $x,$ as usual.\n\nFirst, we use the sum rule for differentiation:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(\\operatorname{cos}⁡(x{y}^{2})+3x) \\\\  & =\\frac{∂}{∂x}(\\operatorname{cos}⁡(x{y}^{2}))+\\frac{∂}{∂x}(3x)\\end{aligned}\n$$\n\nNow, we use the chain rule and the constant multiple rules for differentiation:\n\n$$\n\\begin{aligned}\\frac{∂}{∂x}(\\operatorname{cos}⁡(x{y}^{2}))+\\frac{∂}{∂x}(3x) & =-\\operatorname{sin}⁡(x{y}^{2})\\cdot \\frac{∂}{∂x}(x{y}^{2})+\\frac{∂}{∂x}(3x) \\\\  & =-\\operatorname{sin}⁡(x{y}^{2})\\cdot {y}^{2}\\cdot \\frac{∂}{∂x}(x)+3\\cdot \\frac{∂}{∂x}(x) \\\\  & =-\\operatorname{sin}⁡(x{y}^{2})\\cdot {y}^{2}\\cdot 1+3\\cdot 1 \\\\  & =3-{y}^{2}\\operatorname{sin}⁡(x{y}^{2})\\end{aligned}\n$$\n\nTo compute the partial derivative of $f$ with respect to $y,$ we \"fix\" the variable ${\\color{blue}x}$ (in other words, we treat ${\\color{blue}x}$ as if it were constant). Then, we take the derivative with respect to $y,$ as usual.\n\nFirst, we use the sum rule for differentiation:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}(\\operatorname{cos}⁡(x{y}^{2})+3x) \\\\  & =\\frac{∂}{∂y}(\\operatorname{cos}⁡(x{y}^{2}))+\\frac{∂}{∂y}(3x)\\end{aligned}\n$$\n\nNow, we use the chain rule and the constant multiple rules for differentiation:\n\n$$\n\\begin{aligned}\\frac{∂}{∂y}(\\operatorname{cos}⁡(x{y}^{2}))+\\frac{∂}{∂y}(3x) & =-\\operatorname{sin}⁡(x{y}^{2})\\cdot \\frac{∂}{∂y}(x{y}^{2})+\\frac{∂}{∂y}(3x) \\\\  & =-\\operatorname{sin}⁡(x{y}^{2})\\cdot x\\cdot \\frac{∂}{∂y}({y}^{2})+0 \\\\  & =-\\operatorname{sin}⁡(x{y}^{2})\\cdot x\\cdot 2y \\\\  & =-2xy\\operatorname{sin}⁡(x{y}^{2})\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186192923 :activity/expected-seconds 960.0 :db/ensure [:activity/validate]}]
