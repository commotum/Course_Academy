eld-750b8f34-0f9d-56c2-985a-b6e255c43f41"] :db/ensure [:question/validate]} {:db/id "answer-field-750b8f34-0f9d-56c2-985a-b6e255c43f41" :answer-field/id #uuid "750b8f34-0f9d-56c2-985a-b6e255c43f41" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e45462b7-70a5-5766-8cbb-438381842509" :answer-field/choices ["answer-c1e3f11a-2a92-578b-8110-66edfa5a659d" "answer-f705c608-1802-5751-bc1d-6461a3354b31" "answer-e45462b7-70a5-5766-8cbb-438381842509" "answer-a29d2d7f-53ec-597d-89a7-86301ab042db" "answer-b7315fa2-8e78-5d6e-ae0d-d1ac80caf4b4"] :db/ensure [:answer-field/validate]} {:db/id "answer-c1e3f11a-2a92-578b-8110-66edfa5a659d" :answer/id #uuid "c1e3f11a-2a92-578b-8110-66edfa5a659d" :answer/type :answer.type/math :answer/value "\\frac{1}{xy}-x" :db/ensure [:answer/validate]} {:db/id "answer-f705c608-1802-5751-bc1d-6461a3354b31" :answer/id #uuid "f705c608-1802-5751-bc1d-6461a3354b31" :answer/type :answer.type/math :answer/value "\\frac{1}{xy}-y" :db/ensure [:answer/validate]} {:db/id "answer-e45462b7-70a5-5766-8cbb-438381842509" :answer/id #uuid "e45462b7-70a5-5766-8cbb-438381842509" :answer/type :answer.type/math :answer/value "\\frac{1}{x}-y" :db/ensure [:answer/validate]} {:db/id "answer-a29d2d7f-53ec-597d-89a7-86301ab042db" :answer/id #uuid "a29d2d7f-53ec-597d-89a7-86301ab042db" :answer/type :answer.type/math :answer/value "\\frac{1}{y}-x" :db/ensure [:answer/validate]} {:db/id "answer-b7315fa2-8e78-5d6e-ae0d-d1ac80caf4b4" :answer/id #uuid "b7315fa2-8e78-5d6e-ae0d-d1ac80caf4b4" :answer/type :answer.type/math :answer/value "\\frac{y}{x}-1" :db/ensure [:answer/validate]} {:db/id "question-fe49ff44-a8f4-5323-af29-4e99b3a5291b" :question/id #uuid "fe49ff44-a8f4-5323-af29-4e99b3a5291b" :question/math-academy-id "q-159663" :question/problem "For the function $f(x,y)=\\operatorname{arctan}⁡(x{y}^{2}),$ evaluate $\\frac{∂f}{∂x}$ at the point $(1,3).$" :question/worked-solution "We differentiate the given function with respect to $x,$ treating all other variables as constants. \n\nFirst, we use the chain rule: \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(\\operatorname{arctan}⁡(x{y}^{2}))) \\\\  & =\\frac{1}{1+{(x{y}^{2})}^{2}}\\cdot \\frac{∂}{∂x}(x{y}^{2}) \\\\  & =\\frac{1}{1+{x}^{2}{y}^{4}}\\cdot \\frac{∂}{∂x}(x{y}^{2})\\end{aligned}\n$$\n\nNow, we use the constant multiple rule for differentiation:\n\n$$\n\\begin{aligned}\\frac{1}{1+{x}^{2}{y}^{4}}\\cdot \\frac{∂}{∂x}(x{y}^{2}) & =\\frac{1}{1+{x}^{2}{y}^{4}}\\cdot {y}^{2}\\cdot \\frac{∂}{∂x}(x) \\\\  & =\\frac{1}{1+{x}^{2}{y}^{4}}\\cdot {y}^{2}\\cdot 1 \\\\  & =\\frac{{y}^{2}}{1+{x}^{2}{y}^{4}}\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(1,3):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y}{|}_{(1,3)} & =\\frac{{3}^{2}}{1+{1}^{2}\\cdot {3}^{4}} \\\\  & =\\frac{9}{1+81} \\\\  & =\\frac{9}{82}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e47d5957-7c5b-50d5-a6fa-3e6133a8dcdf"] :db/ensure [:question/validate]} {:db/id "answer-field-e47d5957-7c5b-50d5-a6fa-3e6133a8dcdf" :answer-field/id #uuid "e47d5957-7c5b-50d5-a6fa-3e6133a8dcdf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3c938da8-22ab-5a7b-8a0c-e429c22edff1" :answer-field/choices ["answer-b77fca6c-dc77-556b-8294-ff448ec939d8" "answer-618a305e-63e4-5e63-9489-f0e69a8d45f3" "answer-adda18f8-69d7-5871-aba2-4a24c35225f7" "answer-884b828b-42b8-5163-ae82-8d67dc83a64c" "answer-3c938da8-22ab-5a7b-8a0c-e429c22edff1"] :db/ensure [:answer-field/validate]} {:db/id "answer-b77fca6c-dc77-556b-8294-ff448ec939d8" :answer/id #uuid "b77fca6c-dc77-556b-8294-ff448ec939d8" :answer/type :answer.type/math :answer/value "\\frac{1}{28}" :db/ensure [:answer/validate]} {:db/id "answer-618a305e-63e4-5e63-9489-f0e69a8d45f3" :answer/id #uuid "618a305e-63e4-5e63-9489-f0e69a8d45f3" :answer/type :answer.type/math :answer/value "\\frac{3}{25}" :db/ensure [:a