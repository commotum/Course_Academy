}^{2})\\operatorname{sin}⁡(3(0)-{(\\sqrt{\\pi })}^{2}) \\\\  & =4\\sqrt{\\pi }\\operatorname{cos}⁡(-\\pi )\\operatorname{sin}⁡(-\\pi ) \\\\  & =0\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-4182c953-888a-5a78-b08a-c5df63ce2717"] :db/ensure [:question/validate]} {:db/id "answer-field-4182c953-888a-5a78-b08a-c5df63ce2717" :answer-field/id #uuid "4182c953-888a-5a78-b08a-c5df63ce2717" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5cedb0ea-68aa-5297-8739-1c67694130cf" :answer-field/choices ["answer-fe0a7424-1567-5720-902e-f99517a66dc6" "answer-5cedb0ea-68aa-5297-8739-1c67694130cf" "answer-c6f43775-fb77-555a-84a3-313713b28808" "answer-89c32784-67a9-5a3f-9541-f6b61f434ff9" "answer-cef87b38-87f4-5c33-ae55-63daa3d3acae"] :db/ensure [:answer-field/validate]} {:db/id "answer-fe0a7424-1567-5720-902e-f99517a66dc6" :answer/id #uuid "fe0a7424-1567-5720-902e-f99517a66dc6" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "answer-5cedb0ea-68aa-5297-8739-1c67694130cf" :answer/id #uuid "5cedb0ea-68aa-5297-8739-1c67694130cf" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-c6f43775-fb77-555a-84a3-313713b28808" :answer/id #uuid "c6f43775-fb77-555a-84a3-313713b28808" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-89c32784-67a9-5a3f-9541-f6b61f434ff9" :answer/id #uuid "89c32784-67a9-5a3f-9541-f6b61f434ff9" :answer/type :answer.type/math :answer/value "4\\pi " :db/ensure [:answer/validate]} {:db/id "answer-cef87b38-87f4-5c33-ae55-63daa3d3acae" :answer/id #uuid "cef87b38-87f4-5c33-ae55-63daa3d3acae" :answer/type :answer.type/math :answer/value "\\pi " :db/ensure [:answer/validate]} {:db/id "question-6c44dfc3-39f6-598a-be48-62e051abdda4" :question/id #uuid "6c44dfc3-39f6-598a-be48-62e051abdda4" :question/math-academy-id "q-70029" :question/problem "For the function $f(x,y)=(2y+1)^{2x+1},$ evaluate $\\frac{∂f}{∂y}$ at the point $(2,0).$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants. \n\nFirst, we use the chain rule: \n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}((2y+1)^{2x+1}) \\\\  & =(2x+1)(2y+1)^{2x}\\cdot \\frac{∂}{∂y}((2y+1))\\end{aligned}\n$$\n\nNow, we use the sum and constant multiple rules for differentiation:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =(2x+1)(2y+1)^{2x}\\cdot (2\\frac{∂}{∂y}(y)+\\frac{∂}{∂y}(1)) \\\\  & =(2x+1)(2y+1)^{2x}\\cdot (2\\cdot 1+0) \\\\  & =2(2x+1)(2y+1)^{2x}\\end{aligned}\n$$\n\n \n\nFinally, we evaluate the partial derivative at the point $(2,0):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y}{|}_{(2,0)} & =2\\cdot (2\\cdot 2+1)\\cdot (2\\cdot 0+1)^{2\\cdot 2} \\\\  & =2\\cdot 5\\cdot {1}^{4} \\\\  & =10\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-23ccffc7-1099-5214-9516-b32cd1948e7f"] :db/ensure [:question/validate]} {:db/id "answer-field-23ccffc7-1099-5214-9516-b32cd1948e7f" :answer-field/id #uuid "23ccffc7-1099-5214-9516-b32cd1948e7f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e8cb64e1-7f9f-5311-8f6d-68fccffe0505" :answer-field/choices ["answer-e8cb64e1-7f9f-5311-8f6d-68fccffe0505" "answer-07492d45-331a-54bb-8e47-f1b2b223890f" "answer-19558a15-5391-55ca-be3a-0060eedc7548" "answer-e948a45c-9ad5-5281-8231-163c228a69e8" "answer-222c0ad5-80fe-5476-9e00-ff1bd21126b2"] :db/ensure [:answer-field/validate]} {:db/id "answer-e8cb64e1-7f9f-5311-8f6d-68fccffe0505" :answer/id #uuid "e8cb64e1-7f9f-5311-8f6d-68fccffe0505" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-07492d45-331a-54bb-8e47-f1b2b223890f" :answer/id #uuid "07492d45-331a-54bb-8e47-f1b2b223890f" :answer/type :answer.type/math :answer/value "12" :db/ensure [:an