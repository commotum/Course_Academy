1" 13194139534802 17592186045417 true] [17592186436604 1070 #edb/ref 17592186045487 13194139534802 17592186045417 true] [17592186436604 1071 "For the function $f(x,y)={cos}^{2}⁡(3x-{y}^{2}),$ evaluate $\\frac{∂f}{∂y}$ at the point $(0,\\sqrt{\\pi }).$" 13194139534802 17592186045417 true] [17592186436604 1072 #uuid "0d55bb11-970c-5f1f-831a-44fb97e659c5" 13194139534802 17592186045417 true] [17592186436604 1074 "We differentiate the given function with respect to $y,$ treating all other variables as constants. \n\nFirst, we use the chain rule: \n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}({cos}^{2}⁡(3x-{y}^{2})) \\\\  & =2\\operatorname{cos}⁡(3x-{y}^{2})\\cdot \\frac{∂}{∂y}(\\operatorname{cos}⁡(3x-{y}^{2})) \\\\  & =-2\\operatorname{cos}⁡(3x-{y}^{2})\\cdot \\operatorname{sin}⁡(3x-{y}^{2})\\cdot \\frac{∂}{∂y}(3x-{y}^{2})\\end{aligned}\n$$\n\nNow, we use the sum and constant multiple rules for differentiation:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =-2\\operatorname{cos}⁡(3x-{y}^{2})\\operatorname{sin}⁡(3x-{y}^{2})\\cdot (3x\\frac{∂}{∂y}(1)-\\frac{∂}{∂y}({y}^{2})) \\\\  & =-2\\operatorname{cos}⁡(3x-{y}^{2})\\operatorname{sin}⁡(3x-{y}^{2})\\cdot (3x\\cdot 0-2y) \\\\  & =4y\\operatorname{cos}⁡(3x-{y}^{2})\\operatorname{sin}⁡(3x-{y}^{2})\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(0,\\sqrt{\\pi }):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y}{|}_{(0,\\sqrt{\\pi })} & =4(\\sqrt{\\pi })\\operatorname{cos}⁡(3(0)-{(\\sqrt{\\pi })}^{2})\\operatorname{sin}⁡(3(0)-{(\\sqrt{\\pi })}^{2}) \\\\  & =4\\sqrt{\\pi }\\operatorname{cos}⁡(-\\pi )\\operatorname{sin}⁡(-\\pi ) \\\\  & =0\\end{aligned}\n$$" 13194139534802 17592186045417 true] [17592186436605 1068 #edb/ref 17592186436593 13194139534802 17592186045417 true] [17592186436605 1069 "q-159696" 13194139534802 17592186045417 true] [17592186436605 1070 #edb/ref 17592186045487 13194139534802 17592186045417 true] [17592186436605 1071 "For the function $f(x,y)=\\frac{3xy-1}{2x-3y},$ evaluate $\\frac{∂f}{∂y}$ at the point $(0,-1).$" 13194139534802 17592186045417 true] [17592186436605 1072 #uuid "26e723d1-2e7d-5b20-b4fd-e3325c571238" 13194139534802 17592186045417 true] [17592186436605 1074 "We differentiate the given function with respect to $y,$ treating all other variables as constants. \n\nFirst, we use the quotient rule:\n\n$$\n\\begin{aligned}\\frac{∂}{∂y}(\\frac{3xy-1}{2x-3y}) & =\\frac{\\frac{∂}{∂y}(3xy-1)\\cdot (2x-3y)-(3xy-1)\\cdot \\frac{∂}{∂y}(2x-3y)}{(2x-3y)^{2}} \\\\  & =\\frac{3x\\cdot (2x-3y)-(3xy-1)\\cdot (-3)}{(2x-3y)^{2}} \\\\  & =\\frac{6{x}^{2}-9xy+9xy-3}{(2x-3y)^{2}} \\\\  & =\\frac{6{x}^{2}-3}{(2x-3y)^{2}}\\end{aligned}\n$$\n\n \n\nFinally, we evaluate the partial derivative at the point $(0,-1):$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}{|}_{(0,-1)} & =\\frac{6(0)^{2}-3}{(2(0)-3(-1))^{2}} \\\\  & =\\frac{-3}{{3}^{2}} \\\\  & =-\\frac{1}{3}\\end{aligned}\n$$" 13194139534802 17592186045417 true] [17592186436606 1068 #edb/ref 17592186436602 13194139534802 17592186045417 true] [17592186436606 1069 "q-159720" 13194139534802 17592186045417 true] [17592186436606 1070 #edb/ref 17592186045485 13194139534802 17592186045417 true] [17592186436606 1071 "Consider the function $f(x,y)=\\frac{{e}^{xy}}{xy}.$ The partial derivative of $f$ with respect to $x$ is given by\n\n$$\n\\frac{∂f}{∂x}=\\frac{h(x,y){e}^{xy}}{{x}^{2}y}.\n$$\n\nFind the function $h(x,y).$" 13194139534802 17592186045417 true] [17592186436606 1072 #uuid "27e4d0e6-6215-57d4-b123-69cd51f3932f" 13194139534802 17592186045417 true] [17592186436606 1074 "We differentiate the given function with respect to $x,$ treating all other variables as constants. \n\nUsing the quotient and chain rules, we have\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(\\frac{{e}^{xy}}{xy}) \\\\  & =\\frac{\\frac{∂}{∂x}({e}^{xy})\\cdot xy-{e}^{xy}\\cdot \\frac{∂}{∂x}(xy)}{(xy)^{2}} \\\\  & =\\frac{{e}^{xy}\\cdot \\frac{∂}{∂x}(xy)\\cdot xy-{e}^{xy}\\cdot y}{{x}^{2}{y}^{2}} \\\\  & =\\frac{{e}^{xy}\\cdot y\\cdot xy-y{e}^{xy}}{{x}^{2}{y}^{2}} \\\\  & =\\frac{y{e}^{xy}(xy-1)}{{x}^{2}{y}^{2}} \\\\  & =\\frac{(xy-1){e}^{xy}}{{x}^{2}y}\\end{aligned}\n$$\n\n \n\nTherefore, we conclude that\n\n$$\nh(x,y)=xy-1.\n$$" 13194139534802 17592186045417 true] [17592186436607 1068 #edb/ref 17592186436598 13194139534802 17592186045417 true] [17592186436607 1069 "q-132258" 13194139534802 17592186045417 true] [17592186436607 1070 #edb/ref 17592186045486 13194139534802 17592186045417 true] [17592186436607 1071 "For the function $f(x,y,z)={e}^{4y-x{z}^{4}},$ evaluate $\\frac{∂f}{∂x}$ at the point $(4,1,1).$" 13194139534802 17592186045417 true] [17592186436607 1072 #uuid "45d0ef52-763b-56d4-b138-648452f050d7" 13194139534802 17592186045417 true] [17592186436607 1074 "We differentiate the given function with respect to $x,$ treating all other variables as constants. \n\nUsing the chain rule, we have\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}({e}^{4y-x{z}^{4}}) \\\\  & ={e}^{4y-x{z}^{4}}\\cdot \\frac{∂}{∂x}(4y-x{z}^{4}).\\end{aligned}\n$$\n\nThen, we use the sum and constant multiple rules:\n\n$$\n\\begin{aligned}{e}^{4y-x{z}^{4}}\\cdot \\frac{∂}{∂x}(4y-x{z}^{4}) & ={e}^{4y-x{z}^{4}}\\cdot (\\frac{∂}{∂x}(4y)-\\frac{∂}{∂x}(x{z}^{4})) \\\\  & ={e}^{4y-x{z}^{4}}\\cdot (0-{z}^{4}\\frac{∂}{∂x}(x)) \\\\  & ={e}^{4y-x{z}^{4}}\\cdot (-{z}^{4})\\cdot 1 \\\\  & =-{z}^{4}{e}^{4y-x{z}^{4}}\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(4,1,1):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂z}{|}_{(4,1,1)} & =-(1)^{4}{e}^{4(1)-4(1)^{4}} \\\\  & =-1\\end{aligned}\n$$" 13194139534802 17592186045417 true] [17592186436608 1068 #edb/ref 17592186436595 13194139534802 17592186045417 true] [17592186436608 1069 "q-70029" 13194139534802 17592186045417 true] [17592186436608 1070 #edb/ref 17592186045487 13194139534802 17592186045417 true] [17592186436608 1071 "For the function $f(x,y)=(2y+1)^{2x+1},$ evaluate $\\frac{∂f}{∂y}$ at the point $(2,0).$" 13194139534802 17592186045417 true] [17592186436608 1072 #uuid "6c44dfc3-39f6-598a-be48-62e051abdda4" 13194139534802 17592186045417 true] [17592186436608 1074 "We differentiate the given function with respect to $y,$ treating all other variables as constants. \n\nFirst, we use the chain rule: \n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}((2y+1)^{2x+1}) \\\\  & =(2x+1)(2y+1)^{2x}\\cdot \\frac{∂}{∂y}((2y+1))\\end{aligned}\n$$\n\nNow, we use the sum and constant multiple rules for differentiation:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =(2x+1)(2y+1)^{2x}\\cdot (2\\frac{∂}{∂y}(y)+\\frac{∂}{∂y}(1)) \\\\  & =(2x+1)(2y+1)^{2x}\\cdot (2\\cdot 1+0) \\\\  & =2(2x+1)(2y+1)^{2x}\\end{aligned}\n$$\n\n \n\nFinally, we evaluate the partial derivative at the point $(2,0):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y}{|}_{(2,0)} & =2\\cdot (2\\cdot 2+1)\\cdot (2\\cdot 0+1)^{2\\cdot 2} \\\\  & =2\\cdot 5\\cdot {1}^{4} \\\\  & =10\\end{aligned}\n$$" 13194139534802 17592186045417 true] [17592186436609 1068 #edb/ref 17592186436600 13194139534802 17592186045417 true] [17592186436609 1069 "q-159715" 13194139534802 17592186045417 true] [17592186436609 1070 #edb/ref 17592186045485 13194139534802 17592186045417 true] [17592186436609 1071 "Find ${f}_{x}(x,y)$ for $f(x,y)={x}^{2}{y}^{2}{e}^{{x}^{2}}.$" 13194139534802 17592186045417 true] [17592186436609 1072 #uuid "a1fee486-b1a7-59bd-ae9a-400ceeb58414" 13194139534802 17592186045417 true] [17592186436609 1074 "We differentiate the given function with respect to $x,$ treating all other variables as constants. \n\nFirst, we use the constant multiple rule:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}({x}^{2}{y}^{2}{e}^{{x}^{2}}) \\\\  & ={y}^{2}\\frac{∂}{∂x}({x}^{2}{e}^{{x}^{2}})\\end{aligned}\n$$\n\nThen, we use the product rule and the chain rule:\n\n$$\n\\begin{aligned}{y}^{2}\\frac{∂}{∂x}({x}^{2}{e}^{{x}^{2}}) & ={y}^{2}(\\frac{∂}{∂x}({x}^{2})\\cdot {e}^{{x}^{2}}+{x}^{2}\\cdot \\frac{∂}{∂x}({e}^{{x}^{2}})) \\\\  & ={y}^{2}((2x)\\cdot {e}^{{x}^{2}}+{x}^{2}\\cdot {e}^{{x}^{2}}\\cdot \\frac{∂}{∂x}({x}^{2})) \\\\  & ={y}^{2}(2x{e}^{{x}^{2}}+{x}^{2}{e}^{{x}^{2}}\\cdot (2x)) \\\\  & ={y}^{2}(2x{e}^{{x}^{2}}+2{x}^{3}{e}^{{x}^{2}}) \\\\  & =2{y}^{2}(x+{x}^{3}){e}^{{x}^{2}}\\end{aligned}\n$$" 13194139534802 17592186045417 true] [17592186436610 1068 #edb/ref 17592186436594 13194139534802 17592186045417 true] [17592186436610 1069 "q-132251" 13194139534802 17592186045417 true] [17592186436610 1070 #edb/ref 17592186045486 13194139534802 17592186045417 true] [17592186436610 1071 "Find ${f}_{x}(x,y,z)$ for $f(x,y,z)={cos}^{2}⁡(3x-{y}^{2}).$" 13194139534802 17592186045417 true] [17592186436610 1072 #uuid "a235487c-a19a-5a88-ae3b-cb08ed11bcd3" 13194139534802 17592186045417 true] [17592186436610 1074 "We differentiate the given function with respect to $x,$ treating all other variables as constants. \n\nUsing the chain rule, we have\n\n$$\n\\begin{aligned}{f}_{x}(x,y,z) & =\\frac{∂}{∂x}({cos}^{2}⁡(3x-{y}^{2})) \\\\  & =2\\operatorname{cos}⁡(3x-{y}^{2})\\cdot \\frac{∂}{∂x}(\\operatorname{cos}⁡(3x-{y}^{2})) \\\\  & =2\\operatorname{cos}⁡(3x-{y}^{2})\\cdot (-\\operatorname{sin}⁡(3x-{y}^{2}))\\cdot \\frac{∂}{∂x}(3x-{y}^{2}) \\\\  & =2\\operatorname{cos}⁡(3x-{y}^{2})\\cdot (-\\operatorname{sin}⁡(3x-{y}^{2}))\\cdot 3 \\\\  & =-6\\operatorname{sin}⁡(3x-{y}^{2})\\operatorname{cos}⁡(3x-{y}^{2}).\\end{aligned}\n$$" 13194139534802 17592186045417 true] [17592186436611 1068 #edb/ref 17592186436592 13194139534802 17592186045417 true] [17592186436611 1069 "q-159691" 13194139534802 17592186045417 true] [17592186436611 1070 #edb/ref 17592186045485 13194139534802 17592186045417 true] [17592186436611 1071 "Find ${f}_{y}(x,y)$ for $f(x,y)={x}^{2}y\\operatorname{ln}⁡({y}^{4}).$" 13194139534802 17592186045417 true] [17592186436611 1072 #uuid "aaa7facc-73c8-58b5-b03f-ad80dd8597f5" 13194139534802 17592186045417 true] [17592186436611 1074 "We differentiate the given function with respect to $y,$ treating all other variables as constants. \n\nFirst, we use the constant multiple rule:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂y}({x}^{2}y\\operatorname{ln}⁡({y}^{4})) \\\\  & ={x}^{2}\\cdot \\frac{∂}{∂y}(y\\operatorname{ln}⁡({y}^{4}))\\end{aligned}\n$$\n\nThen, we use the product and the chain rule:\n\n$$\n\\begin{aligned}{x}^{2}\\cdot \\frac{∂}{∂y}(y\\operatorname{ln}⁡({y}^{4})) & ={x}^{2}\\cdot (\\frac{∂}{∂y}(y)\\cdot \\operatorname{ln}⁡({y}^{4})+y\\cdot \\frac{∂}{∂y}(\\operatorname{ln}⁡({y}^{4})) \\\\  & ={x}^{2}\\cdot (1\\cdot \\operatorname{ln}⁡({y}^{4})+y\\cdot \\frac{1}{{y}^{4}}\\cdot \\frac{∂}{∂y}({y}^{4})) \\\\  & ={x}^{2}\\cdot (\\operatorname{ln}⁡({y}^{4})+\\frac{1}{{y}^{3}}\\cdot (4{y}^{3}))) \\\\  & ={x}^{2}(\\operatorname{ln}⁡({y}^{4})+4)\\end{aligned}\n$$" 13194139534802 17592186045417 true] [17592186436612 1068 #edb/ref 17592186436599 13194139534802 17592186045417 true] [17592186436612 1069 "q-159653" 13194139534802 17592186045417 true] [17592186436612 1070 #edb/ref 17592186045485 13194139534802 17592186045417 true] [17592186436612 1071 "Find $\\frac{∂f}{∂x}$ for $f(x,y)=\\operatorname{ln}⁡(xy)-xy.$" 13194139534802 17592186045417 true] [17592186436612 1072 #uuid "b72fd759-0cb1-5717-8778-6af4e6d7337a" 13194139534802 17592186045417 true] [17592186436612 1074 "We differentiate the given function with respect to $x,$ treating all other variables as constants. \n\nFirst, we use the sum rule for differentiation:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(\\operatorname{ln}⁡(xy)-xy) \\\\  & =\\frac{∂}{∂x}(\\operatorname{ln}⁡(xy))-\\frac{∂}{∂x}(yx)\\end{aligned}\n$$\n\nNow, we use the chain rule and the constant multiple rules for differentiation:\n\n$$\n\\begin{aligned}\\frac{∂}{∂x}(\\operatorname{ln}⁡(xy))-\\frac{∂}{∂x}(yx) & =\\frac{1}{xy}\\cdot \\frac{∂}{∂x}(xy)-\\frac{∂}{∂x}(yx) \\\\  & =\\frac{1}{xy}\\cdot y\\cdot \\frac{∂}{∂x}(x)-y\\cdot \\frac{∂}{∂x}(x) \\\\  & =\\frac{1}{xy}\\cdot y\\cdot 1-y\\cdot 1 \\\\  & =\\frac{1}{x}-y\\end{aligned}\n$$" 13194139534802 17592186045417 true] [17592186436613 1068 #edb/ref 17592186436596 13194139534802 17592186045417 true] [17592186436613 1069 "q-159702" 13194139534802 17592186045417 true] [17592186436613 1070 #edb/ref 17592186045487 13194139534802 17592186045417 true] [17592186436613 1071 "For the function $f(x,y)=\\frac{{y}^{2}-{x}^{2}}{\\sqrt{y}},$ evaluate $\\frac{∂f}{∂y}$ at the point $(3,1).$" 13194139534802 17592186045417 true] [17592186436613 1072 #uuid "f311e12c-1089-5d71-97f6-83e1fd9c3339" 13194139534802 17592186045417 true] [17592186436613 1074 "We differentiate the given function with respect to $y,$ treating all other variables as constants. \n\nFirst, we use the quotient rule:\n\n$$\n\\begin{aligned}\\frac{∂}{∂y}(\\frac{{y}^{2}-{x}^{2}}{\\sqrt{y}}) & =\\frac{\\frac{∂}{∂y}({y}^{2}-{x}^{2})\\cdot \\sqrt{y}-({y}^{2}-{x}^{2})\\cdot \\frac{∂}{∂y}(\\sqrt{y})}{{(\\sqrt{y})}^{2}} \\\\  & =\\frac{(2y\\cdot \\sqrt{y}-({y}^{2}-{x}^{2})\\cdot \\frac{1}{2\\sqrt{y}})}{y} \\\\  & =\\frac{(\\frac{4{y}^{2}+{x}^{2}-{y}^{2}}{2\\sqrt{y}})}{y} \\\\  & =\\frac{{x}^{2}+3{y}^{2}}{2y\\sqrt{y}}\\end{aligned}\n$$\n\n \n\nFinally, we evaluate the partial derivative at the point $(3,1):$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}{|}_{(3,1)} & =\\frac{{3}^{2}+3(1)^{2}}{2(1)\\sqrt{1}} \\\\  & =\\frac{9+3}{2} \\\\  & =6\\end{aligned}\n$$" 13194139534802 17592186045417 true] [17592186436614 1068 #edb/ref 17592186436601 13194139534802 17592186045417 true] [17592186436614 1069 "q-159721" 13194139534802 17592186045417 true] [17592186436614 1070 #edb/ref 17592186045485 13194139534802 17592186045417 true] [17592186436614 1071 "Consider the function $f(x,y)=\\frac{6x+11y}{\\sqrt{y}}.$ The partial derivative of $f$ with respect to $y$ is given by\n\n$$\n\\frac{∂f}{∂y}=\\frac{h(x,y)}{2y\\sqrt{y}}.\n$$\n\nFind the function $h(x,y).$" 13194139534802 17592186045417 true] [17592186436614 1072 #uuid "f88992c6-7672-5688-a790-113b251f1d96" 13194139534802 17592186045417 true] [17592186436614 1074 "We differentiate the given function with respect to $y,$ treating all other variables as constants. \n\nUsing the quotient rule, we have\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}(\\frac{6x+11y}{\\sqrt{y}}) \\\\  & =\\frac{\\frac{∂}{∂y}(6x+11y)\\cdot \\sqrt{y}-(6x+11y)\\cdot \\frac{∂}{∂y}(\\sqrt{y})}{{(\\sqrt{y})}^{2}} \\\\  & =\\frac{(11\\cdot \\sqrt{y}-(6x+11y)\\cdot \\frac{1}{2\\sqrt{y}})}{y} \\\\  & =\\frac{(\\frac{22y-(6x+11y)}{2\\sqrt{y}})}{y} \\\\  & =\\frac{11y-6x}{2y\\sqrt{y}}\\end{aligned}\n$$\n\n \n\nTherefore, we conclude that\n\n$$\nh(x,y)=11y-6x.\n$$" 13194139534802 17592186045417 true] [17592186436615 1068 #edb/ref 17592186436603 13194139534802 17592186045417 true] [17592186436615 1069 "q-159663" 13194139534802 17592186045417 true] [17592186436615 1070 #edb/ref 17592186045487 13194139534802 17592186045417 true] [17592186436615 1071 "For the function $f(x,y)=\\operatorname{arctan}⁡(x{y}^{2}),$ evaluate $\\frac{∂f}{∂x}$ at the point $(1,3).$" 13194139534802 17592186045417 true] [17592186436615 1072 #uuid "fe49ff44-a8f4-5323-af29-4e99b3a5291b" 13194139534802 17592186045417 true] [17592186436615 1074 "We differentiate the given function with respect to $x,$ treating all other variables as constants. \n\nFirst, we use the chain rule: \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(\\operatorname{arctan}⁡(x{y}^{2}))) \\\\  & =\\frac{1}{1+{(x{y}^{2})}^{2}}\\cdot \\frac{∂}{∂x}(x{y}^{2}) \\\\  & =\\frac{1}{1+{x}^{2}{y}^{4}}\\cdot \\frac{∂}{∂x}(x{y}^{2})\\end{aligned}\n$$\n\nNow, we use the constant multiple rule for differentiation:\n\n$$\n\\begin{aligned}\\frac{1}{1+{x}^{2}{y}^{4}}\\cdot \\frac{∂}{∂x}(x{y}^{2}) & =\\frac{1}{1+{x}^{2}{y}^{4}}\\cdot {y}^{2}\\cdot \\frac{∂}{∂x}(x) \\\\  & =\\frac{1}{1+{x}^{2}{y}^{4}}\\cdot {y}^{2}\\cdot 1 \\\\  & =\\frac{{y}^{2}}{1+{x}^{2}{y}^{4}}\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(1,3):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y}{|}_{(1,3)} & =\\frac{{3}^{2}}{1+{1}^{2}\\cdot {3}^{4}} \\\\  & =\\frac{9}{1+81} \\\\  & =\\frac{9}{82}\\end{aligned}\n$$" 13194139534802 17592186045417 true]] :edb/tempids {"answer-07492d45-331a-54bb-8e47-f1b2b223890f" 17592186436532 "answer-124ea6fa-c270-53e3-9a4a-37fa95f78b09" 17592186436533 "answer-19558a15-5391-55ca-be3a-0060eedc7548" 17592186436534 "answer-222c0ad5-80fe-5476-9e00-ff1bd21126b2" 17592186436535 "answer-2979f6ee-54a4-596c-a00e-b93729a2aa3f" 17592186436536 "answer-2ca6a6cc-0e50-532f-b694-62c94e10b39b" 17592186436537 "answer-2da9aa45-1bc3-5a50-8a63-b565f85bcbad" 17592186436538 "answer-2eb1fcd4-1769-591e-b2b3-2926ae221a55" 17592186436539 "answer-3c938da8-22ab-5a7b-8a0c-e429c22edff1" 17592186436540 "answer-3cc88c0d-b906-5169-8020-771089d1d342" 17592186436541 "answer-3e5aa69d-a57a-53e7-a411-7b8d1e231bc4" 17592186436542 "answer-49517556-0d0e-548e-a3c1-8430dc1612ad" 17592186436543 "answer-52dadf7c-60d4-59bf-a211-32c2a6e0ff88" 17592186436544 "answer-5cedb0ea-68aa-5297-8739-1c67694130cf" 17592186436545 "answer-618a305e-63e4-5e63-9489-f0e69a8d45f3" 17592186436546 "answer-6a8f703d-08c4-5364-a106-a8206935b823" 17592186436547 "answer-6d9bf8eb-7a93-55c9-a108-2de82f52459e" 17592186436548 "answer-7056dc0c-db4a-59ad-96ec-55d08cc43675" 17592186436549 "answer-738f363f-7faa-5ab8-9897-b5ae98173bef" 17592186436550 "answer-8397e509-d007-5ca5-ab7f-b6777f6c8813" 17592186436551 "answer-884b828b-42b8-5163-ae82-8d67dc83a64c" 17592186436552 "answer-898b4cbe-f73a-573e-8210-8119141fd3d5" 17592186436553 "answer-89c32784-67a9-5a3f-9541-f6b61f434ff9" 17592186436554 "answer-8bd16539-0ba2-553c-a354-7862eff2dcad" 17592186436555 "answer-8dde26e5-909a-5520-b5a4-d567f4f30d3b" 17592186436556 "answer-8deb0301-83cb-5ae4-a55a-80df750a6116" 17592186436557 "answer-8e2c81c3-bd1b-576f-8ea5-5e15ecc6a989" 17592186436558 "answer-8e6e21a7-d420-5add-b68c-d19db196b561" 17592186436559 "answer-92355996-2538-5d06-adbb-60fbc547dfd7" 17592186436560 "answer-9aa74480-20e7-5b9c-bfdf-57f701ad6150" 17592186436561 "answer-9b415193-f30e-568c-b97e-366ae0eaaea6" 17592186436562 "answer-9cfa64ff-4036-5039-b10a-3ab9558904ef" 175