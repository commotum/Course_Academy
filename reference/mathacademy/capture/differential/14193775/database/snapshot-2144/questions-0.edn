#{[{:db/id #edb/ref 17592186341904 :knowledge-point/_questions [{:db/id #edb/ref 17592186096806 :knowledge-point/id #uuid "36b05580-d22b-5ac4-b8a3-cd8d9629ef74" :knowledge-point/title "Computing the Derivative of a Product of Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48032645-41e1-5dbf-86cc-6068e1aa769f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186339768} {:answer/id #uuid "5aadb11c-c90c-542c-af66-409a4c6258f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186339952} {:answer/id #uuid "61fec891-91e7-5bba-b874-5cbd3bea799d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186340001} {:answer/id #uuid "8a0997c6-5117-5d49-a566-b66be7e47668" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186340361} {:answer/id #uuid "e4ed339e-9c42-5596-b7c9-b8865d6b534e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186341152}] :answer-field/correct {:answer/id #uuid "8a0997c6-5117-5d49-a566-b66be7e47668" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186340361} :answer-field/id #uuid "b1019304-1602-5d3a-92f7-0735c20c8795" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341693}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "66744c9b-eb26-5db6-8152-9819040359e0" :question/math-academy-id "q-73071" :question/problem "![](images/f8/f8ec0a6a96e74958d1972cea2778b9c974abfad08f2457bc8f2a9f6c3778db15.png)\n\nThe graphs of the functions $y=f(x)$ and $y=h(x)$ are given above. Find ${p}^{′}(-2)$ where $p(x)=f(x)h(x).$" :question/worked-solution "The product rule for derivatives gives\n\n$$\n{p}^{′}(x)={f}^{′}(x)\\cdot h(x)+f(x)\\cdot {h}^{′}(x).\n$$\n\nAs a result, we have that\n\n$$\n{p}^{′}(-2)={f}^{′}(-2)\\cdot h(-2)+f(-2)\\cdot {h}^{′}(-2).\n$$\n\nFrom the graphs above, we obtain that $f(-2)=2$ and $h(-2)=-2.$\n\nAdditionally,\n\n- The slope of $f(x)$ on $x\\in (-3,0)$ equals $-1.$ So, ${f}^{′}(-2)=-1.$\n\n- The slope of $h(x)$ on $x\\in (-2.5,0)$ equals $2.$ So, ${h}^{′}(-2)=2.$\n\nTherefore,\n\n$$\n\\begin{aligned}{p}^{′}(-2) & ={f}^{′}(-2)\\cdot h(-2)+f(-2)\\cdot {h}^{′}(-2) \\\\  & =(-1)\\cdot (-2)+2\\cdot 2 \\\\  & =6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186097344 :knowledge-point/_questions [{:db/id #edb/ref 17592186096806 :knowledge-point/id #uuid "36b05580-d22b-5ac4-b8a3-cd8d9629ef74" :knowledge-point/title "Computing the Derivative of a Product of Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83470de2-4e61-5a1c-b192-79f1df6d4335" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1.5" :db/id #edb/ref 17592186095989} {:answer/id #uuid "95069f73-03b6-5a03-ab67-b16610a1a575" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.5" :db/id #edb/ref 17592186095990} {:answer/id #uuid "b32b8df2-7eab-5d94-a684-c2b38e87a035" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186095991} {:answer/id #uuid "b5942677-2209-5ef1-b68c-d5e736a62a4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-0.5" :db/id #edb/ref 17592186095992} {:answer/id #uuid "26718127-638f-5bd0-a44f-9838ff349877" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186095993}] :answer-field/id #uuid "2deafe62-4ea6-5bd2-b1ab-39cbc06aca34" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186095988}] :question/id #uuid "bba9ad1a-f133-594e-8f67-d3021de105b3" :question/math-academy-id "q-73072" :question/problem "![](images/68/68379dee045e8b5d4f123f91c0f8c953d2cbbe6475c5ca13d4435889343c625d.png)\n\nThe graphs of the functions $y = f(x)$ and $y = g(x)$ are given above. Find $h^{′}(-1.5)$ where $h(x) = f(x)g(x)$."}]}
