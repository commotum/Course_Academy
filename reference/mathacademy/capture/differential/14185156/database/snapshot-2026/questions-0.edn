\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186444049 :knowledge-point/_questions [{:db/id #edb/ref 17592186162110 :knowledge-point/id #uuid "0643d82d-39a0-544e-b4b1-f178d14e4e03" :knowledge-point/title "Calculating a Probability Involving a Sample Mean"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "522b88e5-39fe-5354-9e92-2e011cc734e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.3745" :db/id #edb/ref 17592186444022} {:answer/id #uuid "58c95314-1f8b-5e7c-adb4-6319f68dbc1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.4168" :db/id #edb/ref 17592186444024} {:answer/id #uuid "972153a3-5d92-518b-8c7c-7f399224d098" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.4090" :db/id #edb/ref 17592186444031} {:answer/id #uuid "f0eec853-9d90-50a4-a65b-1dadff4db148" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.4129" :db/id #edb/ref 17592186444036} {:answer/id #uuid "f6cb72ba-9e2c-53af-86f2-0dfc35913a7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.4483" :db/id #edb/ref 17592186444038}] :answer-field/correct {:answer/id #uuid "522b88e5-39fe-5354-9e92-2e011cc734e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.3745" :db/id #edb/ref 17592186444022} :answer-field/id #uuid "0393a2ea-4764-5c90-ab20-be9db64dea06" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186444040}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "befb2dbc-22e5-50b6-b20b-e66d941203a5" :question/math-academy-id "q-143283" :question/problem "Given that ${X}_{1},{X}_{2},…,{X}_{40}∼N(12,{20}^{2})$ is a random sample of size $40$ from a normal population, calculate $P(\\overset{―}{X}<11).$\n\n*Hint: A value table of $Φ(z)$ for different values of $z$ is given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $z$ | $\\,0.01\\,$ | $\\,0.02\\,$ | $\\,0.03\\,$ |\n| --- | --- | --- | --- |\n| $\\,-0.3\\,$ | $\\,0.3783\\,$ | $\\,0.3745\\,$ | $\\,0.3707\\,$ |\n| $\\,-0.2\\,$ | $\\,0.4168\\,$ | $\\,0.4129\\,$ | $\\,0.4090\\,$ |\n| $\\,-0.1\\,$ | $\\,0.4562\\,$ | $\\,0.4522\\,$ | $\\,0.4483\\,$ |" :question/worked-solution "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a random sample of size $n$ from a normal population, where \n\n$$\n{X}_{i}∼N(\\mu ,{\\sigma }^{2}),\\,1\\le i\\le n,\n$$\n\nthen the sample mean $\\overset{―}{X}$ has the distribution\n\n$$\n\\overset{―}{X}∼N(\\mu ,\\frac{{\\sigma }^{2}}{n}).\n$$\n\nTherefore, the distribution of the sample mean $\\overset{―}{X}$ is\n\n$$\n\\begin{aligned}\\overset{―}{X} & ∼N\\,(12,\\frac{{20}^{2}}{40}) \\\\  & ∼N(12,10).\\end{aligned}\n$$\n\nWe're required to find $P(\\overset{―}{X}<11).$\n\nFirst, we transform $X$ into a standard normal random variable $Z$ by $z$-scoring:\n\n$$\n\\begin{aligned}P(\\overset{―}{X}<11) & =P(Z<\\frac{11-12}{\\sqrt{10}}) \\\\  & =P(Z<-0.32) \\\\  & =Φ(-0.32)\\end{aligned}\n$$\n\nFrom the table, we have\n\n$$\n\\begin{aligned}Φ(-0.32)=0.3745.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(\\overset{―}{X}<11) & =Φ(-0.32) \\\\  & =0.3745.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186444048 :knowledge-point/_questions [{:db/id #edb/ref 17592186162110 :knowledge-point/id #uuid "0643d82d-39a0-544e-b4b1-f178d14e4e03" :knowledge-point/title "Calculating a Probability Involving a Sample Mean"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d659c90-71f0-5b00-8a65-403b2d145ad3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.7019" :db/id #edb/ref 17592186444018} {:answer/id #uuid "4d6b56fe-fdc2-56d4-b7f6-9235b0fd6388" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.6664" :db/id #edb/ref 17592186444020} {:answer/id #uuid "57c2e740-aa11-55a6-91c9-6d19dd52de74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.6628" :db/id #edb/ref 17592186444023} {:answer/id #uuid "de3eabca-7292-5160-8a6d-ec04e50a80e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.6700" :db/id #edb/ref 17592186444034} {:answer/id #uuid "f32f6209-a036-5022-95f2-57bcc51bce4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.6293" :db/id #edb/ref 17592186444037}] :answer-field/correct {:answer/id #uuid "4d6b56fe-fdc2-56d4-b7f6-9235b0fd6388" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.6664" :db/id #edb/ref 17592186444020} :answer-field/id #uuid "994729ba-d708-5678-96ba-cc1c965c4255" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186444042}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a7acd22b-bdbb-5367-8608-dbbe55d9e96d" :question/math-academy-id "q-143293" :question/problem "Given that ${X}_{1},{X}_{2},…,{X}_{64}∼N(-14,{16}^{2})$ is a random sample of size $64$ from a normal population, calculate $P(\\overset{―}{X}>-14.86).$\n\n*Hint: A value table of $Φ(z)$ for different values of $z$ is given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $z$ | $\\,0.02\\,$ | $\\,0.03\\,$ | $\\,0.04\\,$ |\n| --- | --- | --- | --- |\n| $\\,-0.5\\,$ | $\\,0.3015\\,$ | $\\,0.2981\\,$ | $\\,0.2946\\,$ |\n| $\\,-0.4\\,$ | $\\,0.3372\\,$ | $\\,0.3336\\,$ | $\\,0.3300\\,$ |\n| $\\,-0.3\\,$ | $\\,0.3745\\,$ | $\\,0.3707\\,$ | $\\,0.3669\\,$ |" :question/worked-solution "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a random sample of size $n$ from a normal population, where \n\n$$\n{X}_{i}∼N(\\mu ,{\\sigma }^{2}),\\,1\\le i\\le n,\n$$\n\nthen the sample mean $\\overset{―}{X}$ has the distribution\n\n$$\n\\overset{―}{X}∼N(\\mu ,\\frac{{\\sigma }^{2}}{n}).\n$$\n\nTherefore, the distribution of the sample mean $\\overset{―}{X}$ is\n\n$$\n\\begin{aligned}\\overset{―}{X} & ∼N\\,(-14,\\frac{{16}^{2}}{64}) \\\\  & ∼N(-14,4).\\end{aligned}\n$$\n\nWe're required to find $P(\\overset{―}{X}>-14.86).$\n\nFirst, we transform $X$ into a standard normal random variable $Z$ by $z$-scoring:\n\n$$\n\\begin{aligned}P(\\overset{―}{X}>-14.86) & =P(Z>\\frac{-14.86-(-14)}{\\sqrt{4}}) \\\\  & =P(Z>-0.43).\\end{aligned}\n$$\n\nUsing the complement of the normal distribution, we have\n\n$$\n\\begin{aligned}P(Z>-0.43) & =1-P(Z\\le -0.43) \\\\  & =1-Φ(-0.43).\\end{aligned}\n$$\n\nFrom the table, we have\n\n$$\n\\begin{aligned}Φ(-0.43)=0.3336.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}P(\\overset{―}{X}>-14.86) & =1-Φ(-0.43) \\\\  & =1-0.3336 \\\\  & =0.6664.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186421850 :knowledge-point/_questions [{:db/id #edb/ref 17592186162110 :knowledge-point/id #uuid "0643d82d-39a0-544e-b4b1-f178d14e4e03" :knowledge-point/title "Calculating a Probability Involving a Sample Mean"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3aa5c52e-8e77-5a89-a2be-c5d48e02d707" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.2394" :db/id #edb/ref 17592186421832} {:answer/id #uuid "3d1645e2-c686-52f4-a67a-bc7ecd062596" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.2671" :db/id #edb/ref 17592186421833} {:answer/id #uuid "cd6ec6ff-8efb-5177-9119-05dcb8065b19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.2617" :db/id #edb/ref 17592186421840} {:answer/id #uuid "d9db63bf-dd9b-5997-b12d-fcd3929e098a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.2089" :db/id #edb/ref 17592186421841} {:answer/id #uuid "ebc99d50-e93c-5e52-936e-cb1d51cb3239" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.2141" :db/id #edb/ref 17592186421843}] :answer-field/correct {:answer/id #uuid "3aa5c52e-8e77-5a89-a2be-c5d48e02d707" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.2394" :db/id #edb/ref 17592186421832} :answer-field/id #uuid "12fb0d15-7794-5d04-99a5-b1fe70075584" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186421846}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "75ff021f-12e0-504a-b1eb-e811b2e15c5c" :question/math-academy-id "q-143300" :question/problem "Given that ${X}_{1},{X}_{2},…,{X}_{36}∼N(4,{18}^{2})$ is a random sample of size $36$ from a normal population, calculate $P(|\\overset{―}{X}|<2.07).$\n\n*Hint: Value tables of $Φ(z)$ for different values of $z$ are given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n<table align=\"center\">\n<tbody><tr>\n<th>\n<table align=\"center\" cellpadding=\"5\" rules=\"all\">\n<tbody><tr> <th align=\"center\" bgcolor=\"#D6EAF8\" width=\"25%\">$z$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.02\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.03\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.04\\,$</th>\n</tr><tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-0.7\\,$</th><td align=\"center\"> $\\,0.2358\\,$ </td><td align=\"center\"> $\\,0.2327\\,$ </td><td align=\"center\"> $\\,0.2296\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-0.6\\,$</th><td align=\"center\"> $\\,0.2676\\,$ </td><td align=\"center\"> $\\,0.2643\\,$ </td><td align=\"center\"> $\\,0.2611\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-0.5\\,$</th><td align=\"center\"> $\\,0.3015\\,$ </td><td align=\"center\"> $\\,0.2981\\,$ </td><td align=\"center\"> $\\,0.2946\\,$ </td></tr>\n</tbody></table>\n<p></p></th>\n<th width=\"5%\"></th>\n<th>\n<table align=\"center\" cellpadding=\"5\" rules=\"all\">\n<tbody><tr> <th align=\"center\" bgcolor=\"#D6EAF8\" width=\"25%\">$z$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.02\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.03\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.04\\,$</th>\n</tr><tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-2.0\\,$</th><td align=\"center\"> $\\,0.0217\\,$ </td><td align=\"center\"> $\\,0.0212\\,$ </td><td align=\"center\"> $\\,0.0207\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-1.9\\,$</th><td align=\"center\"> $\\,0.0274\\,$ </td><td align=\"center\"> $\\,0.0268\\,$ </td><td align=\"center\"> $\\,0.0262\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-1.8\\,$</th><td align=\"center\"> $\\,0.0344\\,$ </td><td align=\"center\"> $\\,0.0336\\,$ </td><td align=\"center\"> $\\,0.0329\\,$ </td></tr>\n</tbody></table>\n<p></p></th>\n</tr>\n</tbody></table>" :question/worked-solution "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a random sample of size $n$ from a normal population, where \n\n$$\n{X}_{i}∼N(\\mu ,{\\sigma }^{2}),\\,1\\le i\\le n,\n$$\n\nthen the sample mean $\\overset{―}{X}$ has the distribution\n\n$$\n\\overset{―}{X}∼N(\\mu ,\\frac{{\\sigma }^{2}}{n}).\n$$\n\nTherefore, the distribution of the sample mean $\\overset{―}{X}$ is\n\n$$\n\\begin{aligned}\\overset{―}{X} & ∼N\\,(4,\\frac{{18}^{2}}{36}) \\\\  & ∼N(4,9).\\end{aligned}\n$$\n\nWe're required to find $P(|\\overset{―}{X}|<2.07).$\n\nFirst, we transform $X$ into a standard normal random variable $Z$ by $z$-scoring:\n\n$$\n\\begin{aligned}P(|\\overset{―}{X}|<2.07) & =P(-2.07<\\overset{―}{X}<2.07) \\\\  & =P(\\frac{-2.07-4}{\\sqrt{9}}<Z<\\frac{2.07-4}{\\sqrt{9}}) \\\\  & =P(-2.02<Z<-0.64) \\\\  & =Φ(-0.64)-Φ(-2.02)\\end{aligned}\n$$\n\nFrom the tables, we have\n\n$$\n\\begin{aligned}Φ(-0.64) & =0.2611, \\\\ Φ(-2.02) & =0.0217.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(|\\overset{―}{X}|<2.07) & =Φ(-0.64)-Φ(-2.02) \\\\  & =0.2611-0.0217 \\\\  & =0.2394.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186421849 :knowledge-point/_questions [{:db/id #edb/ref 17592186162110 :knowledge-point/id #uuid "0643d82d-39a0-544e-b4b1-f178d14e4e03" :knowledge-point/title "Calculating a Probability Involving a Sample Mean"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "211e8525-9c7c-5f08-90b9-8bafbce89824" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9345" :db/id #edb/ref 17592186421831} {:answer/id #uuid "69064a58-7535-5a5d-b74e-eda826922abc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9573" :db/id #edb/ref 17592186421834} {:answer/id #uuid "70ccaa0a-2296-5e47-9485-665082d89a91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9420" :db/id #edb/ref 17592186421836} {:answer/id #uuid "9aced102-4694-5dd6-9412-58caa8ddf4d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.8437" :db/id #edb/ref 17592186421838} {:answer/id #uuid "c8148e07-be44-5483-8044-795aa374f125" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.8807" :db/id #edb/ref 17592186421839}] :answer-field/correct {:answer/id #uuid "211e8525-9c7c-5f08-90b9-8bafbce89824" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9345" :db/id #edb/ref 17592186421831} :answer-field/id #uuid "c4f53ce6-98d9-5812-993e-85598a8a0278" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186421848}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "423b0b62-7d55-5176-ba2c-330867aaba9c" :question/math-academy-id "q-143303" :question/problem "Given that ${X}_{1},{X}_{2},…,{X}_{16}∼N(-3,{8}^{2})$ is a random sample of size $16$ from a normal population, calculate $P(|\\overset{―}{X}|>0.5).$\n\n*Hint: Value tables of $Φ(z)$ for different values of $z$ are given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n<table align=\"center\">\n<tbody><tr>\n<th>\n<table align=\"center\" cellpadding=\"5\" rules=\"all\">\n<tbody><tr> <th align=\"center\" bgcolor=\"#D6EAF8\" width=\"25%\">$z$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.04\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.05\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.06\\,$</th>\n</tr><tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,1.2\\,$</th><td align=\"center\"> $\\,0.8925\\,$ </td><td align=\"center\"> $\\,0.8944\\,$ </td><td align=\"center\"> $\\,0.8962\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,1.3\\,$</th><td align=\"center\"> $\\,0.9099\\,$ </td><td align=\"center\"> $\\,0.9115\\,$ </td><td align=\"center\"> $\\,0.9131\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,1.4\\,$</th><td align=\"center\"> $\\,0.9251\\,$ </td><td align=\"center\"> $\\,0.9265\\,$ </td><td align=\"center\"> $\\,0.9279\\,$ </td></tr>\n</tbody></table>\n<p></p></th>\n<th width=\"5%\"></th>\n<th>\n<table align=\"center\" cellpadding=\"5\" rules=\"all\">\n<tbody><tr> <th align=\"center\" bgcolor=\"#D6EAF8\" width=\"25%\">$z$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.05\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.06\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.07\\,$</th>\n</tr><tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,1.6\\,$</th><td align=\"center\"> $\\,0.9505\\,$ </td><td align=\"center\"> $\\,0.9515\\,$ </td><td align=\"center\"> $\\,0.9525\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,1.7\\,$</th><td align=\"center\"> $\\,0.9599\\,$ </td><td align=\"center\"> $\\,0.9608\\,$ </td><td align=\"center\"> $\\,0.9616\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,1.8\\,$</th><td align=\"center\"> $\\,0.9678\\,$ </td><td align=\"center\"> $\\,0.9686\\,$ </td><td align=\"center\"> $\\,0.9693\\,$ </td></tr>\n</tbody></table>\n<p></p></th>\n</tr>\n</tbody></table>" :question/worked-solution "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a random sample of size $n$ from a normal population, where \n\n$$\n{X}_{i}∼N(\\mu ,{\\sigma }^{2}),\\,1\\le i\\le n,\n$$\n\nthen the sample mean $\\overset{―}{X}$ has the distribution\n\n$$\n\\overset{―}{X}∼N(\\mu ,\\frac{{\\sigma }^{2}}{n}).\n$$\n\nTherefore, the distribution of the sample mean $\\overset{―}{X}$ is\n\n$$\n\\begin{aligned}\\overset{―}{X} & ∼N\\,(-3,\\frac{{8}^{2}}{16}) \\\\  & ∼N(-3,4).\\end{aligned}\n$$\n\nWe're required to find $P(|\\overset{―}{X}|>0.5).$\n\nFirst, we transform $X$ into a standard normal random variable $Z$ by $z$-scoring:\n\n$$\n\\begin{aligned}P(|\\overset{―}{X}|>0.5) & =1-P(|\\overset{―}{X}|<0.5) \\\\  & =1-P(-0.5<\\overset{―}{X}<0.5) \\\\  & =1-P(\\frac{-0.5-(-3)}{\\sqrt{4}}<Z<\\frac{0.5-(-3)}{\\sqrt{4}}) \\\\  & =1-P(1.25<Z<1.75) \\\\  & =1-(Φ(1.75)-Φ(1.25)) \\\\  & =1+Φ(1.25)-Φ(1.75)\\end{aligned}\n$$\n\nFrom the tables, we have\n\n$$\n\\begin{aligned}Φ(1.25) & =0.8944, \\\\ Φ(1.75) & =0.9599.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(|\\overset{―}{X}|>0.5) & =1+Φ(1.25)-Φ(1.75) \\\\  & =1+0.8944-0.9599 \\\\  & =0.9345.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186162387 :knowledge-point/_questions [{:db/id #edb/ref 17592186162111 :knowledge-point/id #uuid "fc5b49c9-5fd8-574b-aed6-4cec9421d3d1" :knowledge-point/title "Calculating a Probability Involving a Sample Mean in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e65d9302-124a-5ef4-aad7-e47fd46dccb0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1628" :db/id #edb/ref 17592186159525} {:answer/id #uuid "f21b8403-84c2-57a1-bdba-5b56eb9efaba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0948" :db/id #edb/ref 17592186159526} {:answer/id #uuid "58c8ddec-5930-574d-9de0-f47b8afd15b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1554" :db/id #edb/ref 17592186159527} {:answer/id #uuid "606dec9f-a0c5-555f-ab17-2ed24e505af5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1331" :db/id #edb/ref 17592186159528} {:answer/id #uuid "69e791a5-7d88-52a4-9b13-a873b75c1241" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1674" :db/id #edb/ref 17592186159529}] :answer-field/id #uuid "b0d6ea39-12ae-527d-86fa-7b4a9098de8d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186159524}] :question/id #uuid "f12fe002-29d2-5bee-a55c-5667fba5ceb3" :question/math-academy-id "q-143411" :question/problem "The weights of a particular breed of geese are normally distributed with a mean of $7kg$ and a standard deviation of $1kg$. Suppose $4$ geese are randomly selected. What is the probability that the mean weight for this sample will be more than $6.8kg$, but less than $7kg$?\n\n*Hint: A table of values of $Φ(z)$ for different values of $z$ is given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution.*\n\n| $z$$0.00$$0.01$$0.02$$-0.4$ $0.3446$ $0.3409$ $0.3372$ $-0.3$ $0.3821$ $0.3783$ $0.3745$ $-0.2$ $0.4207$ $0.4168$ $0.4129$ |  | $z$$0.00$$0.01$$0.02$$-0.1$ $0.4602$ $0.4562$ $0.4522$ $0.0$ $0.5000$ $0.4960$ $0.4920$ $0.1$ $0.5398$ $0.5359$ $0.5319$ |\n| --- | ---: | ---: |\n\n> A scientific calculator is required to answer this question." :question/requires-calculator true}] [{:db/id #edb/ref 17592186444047 :knowledge-point/_questions [{:db/id #edb/ref 17592186162111 :knowledge-point/id #uuid "fc5b49c9-5fd8-574b-aed6-4cec9421d3d1" :knowledge-point/title "Calculating a Probability Involving a Sample Mean in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3bdedd45-1c49-5c6d-a3a7-8ce4ace8dbe2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1894" :db/id #edb/ref 17592186444017} {:answer/id #uuid "5d6841e9-545c-5419-a4ae-d0e21f42b6f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1379" :db/id #edb/ref 17592186444025} {:answer/id #uuid "abb9d9d8-d0b0-5af4-b40c-b51f33c796b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1977" :db/id #edb/ref 17592186444032} {:answer/id #uuid "cf92d9f6-14ae-5b47-a3e7-e8775e868097" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1423" :db/id #edb/ref 17592186444033} {:answer/id #uuid "fe67d84c-9fd9-53cb-a301-d4aa32217ea1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1660" :db/id #edb/ref 17592186444039}] :answer-field/correct {:answer/id #uuid "3bdedd45-1c49-5c6d-a3a7-8ce4ace8dbe2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1894" :db/id #edb/ref 17592186444017} :answer-field/id #uuid "bdb8af73-3022-5020-a1c4-f35480c76e45" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186444043}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "823af782-7946-51f9-98a3-ec3946da49d4" :question/math-academy-id "q-143454" :question/problem "The scores in a standardized math test used for university admissions in a certain country are normally distributed with a mean of $57$ and a standard deviation of $16.$ Suppose $50$ test results are selected at random. What is the probability that the mean score for this sample will be less than $55?$\n\n*Hint: A table of values of $Φ(z)$ for different values of $z$ is given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $z$ | $\\,0.05\\,$ | $\\,0.06\\,$ | $\\,0.07\\,$ | $\\,0.08\\,$ | $\\,0.09\\,$ |\n| --- | --- | --- | --- | --- | --- |\n| $\\,-1.0\\,$ | $\\,0.1469\\,$ | $\\,0.1446\\,$ | $\\,0.1423\\,$ | $\\,0.1401\\,$ | $\\,0.1379\\,$ |\n| $\\,-0.9\\,$ | $\\,0.1711\\,$ | $\\,0.1685\\,$ | $\\,0.1660\\,$ | $\\,0.1635\\,$ | $\\,0.1611\\,$ |\n| $\\,-0.8\\,$ | $\\,0.1977\\,$ | $\\,0.1949\\,$ | $\\,0.1922\\,$ | $\\,0.1894\\,$ | $\\,0.1867\\,$ |" :question/worked-solution "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a random sample of size $n$ from a normal population, where \n\n$$\n{X}_{i}∼N(\\mu ,{\\sigma }^{2}),\\,1\\le i\\le n,\n$$\n\n then the sample mean $\\overset{―}{X}$ has the distribution\n\n$$\n\\overset{―}{X}∼N(\\mu ,\\frac{{\\sigma }^{2}}{n}).\n$$\n\nWe're told that the population mean $\\mu =57$ the population standard deviation $\\sigma =16,$ and that the sample size $n=50.$ Therefore, the distribution of the sample mean $\\overset{―}{X}$ is\n\n$$\n\\begin{aligned}\\overset{―}{X} & ∼N\\,(57,\\frac{{16}^{2}}{50}) \\\\  & ∼N(57,5.12).\\end{aligned}\n$$\n\nWe're required to find $P(\\overset{―}{X}<55).$\n\nFirst, we transform $X$ into a standard normal random variable $Z$ by $z$-scoring:\n\n$$\n\\begin{aligned}P(\\overset{―}{X}<55) & =P(Z<\\frac{55-57}{\\sqrt{5.12}}) \\\\  & ≈P(Z<-0.88) \\\\  & =Φ(-0.88)\\end{aligned}\n$$\n\nFrom the table, we have\n\n$$\nΦ(-0.88)=0.1894.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(\\overset{―}{X}<55) & ≈Φ(-0.88) \\\\  & =0.1894.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186421625 :knowledge-point/_questions [{:db/id #edb/ref 17592186162111 :knowledge-point/id #uuid "fc5b49c9-5fd8-574b-aed6-4cec9421d3d1" :knowledge-point/title "Calculating a Probability Involving a Sample Mean in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29b93163-3800-5868-a242-359dc119945c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.3114" :db/id #edb/ref 17592186421566} {:answer/id #uuid "3dea54d0-2db8-59b8-9dc5-953f303d2910" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.3149" :db/id #edb/ref 17592186421570} {:answer/id #uuid "a5f80de2-ccb1-5c31-bb9b-500194a810d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1645" :db/id #edb/ref 17592186421591} {:answer/id #uuid "dfbda645-8221-50d9-8ee5-4af85fb99e95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.2332" :db/id #edb/ref 17592186421608} {:answer/id #uuid "eefbae61-e1cd-53e6-90f8-1479a9cf5a6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.3075" :db/id #edb/ref 17592186421611}] :answer-field/correct {:answer/id #uuid "29b93163-3800-5868-a242-359dc119945c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.3114" :db/id #edb/ref 17592186421566} :answer-field/id #uuid "a9cdc070-e6cc-5c48-b1ba-ef4e2653c9ae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186421616}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a16286a3-509a-570e-8f6f-6720e9566628" :question/math-academy-id "q-143456" :question/problem "The systolic blood pressure of adults in a given population is normally distributed with a mean of $123.4\\,\\text{mm}\\,\\text{Hg}$ and a standard deviation of $19.5\\,\\text{mm}\\,\\text{Hg}.$ Suppose $10$ adults are randomly selected. What is the probability that the mean systolic blood pressure for this sample will be between $120\\,\\text{mm}\\,\\text{Hg}$ and $125\\,\\text{mm}\\,\\text{Hg}?$ \n\n*Hint: A table of values of $Φ(z)$ for different values of $z$ is given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution. * \n\n<table align=\"center\">\n<tbody><tr>\n<th>\n<table align=\"center\" cellpadding=\"5\" rules=\"all\">\n<tbody><tr>\n<th align=\"center\" bgcolor=\"#D6EAF8\" width=\"25%\">$z$</th>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.04\\,$</th>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.05\\,$</th>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.06\\,$</th>\n</tr>\n<tr>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-0.5\\,$</th>\n<td align=\"center\"> $\\,0.2946\\,$ </td>\n<td align=\"center\"> $\\,0.2912\\,$ </td>\n<td align=\"center\"> $\\,0.2877\\,$ </td>\n</tr>\n<tr>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-0.4\\,$</th>\n<td align=\"center\"> $\\,0.3300\\,$ </td>\n<td align=\"center\"> $\\,0.3264\\,$ </td>\n<td align=\"center\"> $\\,0.3228\\,$ </td>\n</tr>\n<tr>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-0.3\\,$</th>\n<td align=\"center\"> $\\,0.3669\\,$ </td>\n<td align=\"center\"> $\\,0.3632\\,$ </td>\n<td align=\"center\"> $\\,0.3594\\,$ </td>\n</tr>\n</tbody></table>\n<p></p></th>\n<th width=\"5%\"></th>\n<th><p></p>\n<table align=\"center\" cellpadding=\"5\" rules=\"all\">\n<tbody><tr>\n<th align=\"center\" bgcolor=\"#D6EAF8\" width=\"25%\">$z$</th>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.04\\,$</th>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.05\\,$</th>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.06\\,$</th>\n</tr>\n<tr>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.0\\,$</th>\n<td align=\"center\"> $\\,0.5160\\,$ </td>\n<td align=\"center\"> $\\,0.5199\\,$ </td>\n<td align=\"center\"> $\\,0.5239\\,$ </td>\n</tr>\n<tr>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.1\\,$</th>\n<td align=\"center\"> $\\,0.5557\\,$ </td>\n<td align=\"center\"> $\\,0.5596\\,$ </td>\n<td align=\"center\"> $\\,0.5636\\,$ </td>\n</tr>\n<tr>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.2\\,$</th>\n<td align=\"center\"> $\\,0.5948\\,$ </td>\n<td align=\"center\"> $\\,0.5987\\,$ </td>\n<td align=\"center\"> $\\,0.6026\\,$ </td>\n</tr>\n</tbody></table>\n<p></p></th>\n</tr>\n</tbody></table>" :question/worked-solution "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a random sample of size $n$ from a normal population, where \n\n$$\n{X}_{i}∼N(\\mu ,{\\sigma }^{2}),\\,1\\le i\\le n,\n$$\n\n then the sample mean $\\overset{―}{X}$ has the distribution\n\n$$\n\\overset{―}{X}∼N(\\mu ,\\frac{{\\sigma }^{2}}{n}).\n$$\n\nWe're told that the population mean $\\mu =123.4,$ the population standard deviation $\\sigma =19.5,$ and that the sample size $n=10.$ Therefore, the distribution of the sample mean $\\overset{―}{X}$ is\n\n$$\n\\begin{aligned}\\overset{―}{X} & ∼N\\,(123.4,\\frac{{19.5}^{2}}{10}) \\\\  & ∼N(123.4,38.025).\\end{aligned}\n$$\n\nWe're required to find $P(120<\\overset{―}{X}<125).$\n\nFirst, we transform $X$ into a standard normal random variable $Z$ by $z$-scoring:\n\n$$\n\\begin{aligned}P(120<\\overset{―}{X}<125) & =P(\\frac{120-123.4}{\\sqrt{38.025}}<Z<\\frac{125-123.4}{\\sqrt{38.025}}) \\\\  & =P(-0.55<Z<0.26) \\\\  & =Φ(0.26)-Φ(-0.55)\\end{aligned}\n$$\n\nFrom the table, we have\n\n$$\n\\begin{aligned}Φ(-0.55) & =0.2912 \\\\ Φ(0.26) & =0.6026.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(120<\\overset{―}{X}<125) & =Φ(0.26)-Φ(-0.55) \\\\  & ≈0.6026-0.2912 \\\\  & =0.3114.\\end{aligned}\n$$"}]}
