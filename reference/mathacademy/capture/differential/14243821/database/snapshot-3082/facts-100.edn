ef 1072 #uuid "0c6c7b9b-1b7d-58b7-ad39-d5756aa91423" #edb/ref 17592186045417] [17592186383209 #edb/ref 1074 "First, let's figure out what each operation does to the determinant.\n\n- The operation ${R}_{3}:={R}_{3}+(-7){R}_{4}$ involves adding a multiple of one row to another row,  so it does not change the determinant.\n\n- The operation ${R}_{3}:=\\frac{1}{3}{R}_{3}$ involves multiplying a row by $\\frac{1}{3},$ so the determinant is multiplied by $\\frac{1}{3}$ as well.\n\nTherefore, we only have to multiply the determinant by $\\frac{1}{3}.$ Consequently, we get\n\n$$\n\\begin{aligned}det(V) & =\\frac{1}{3}det(U) \\\\  & =\\frac{1}{3}\\cdot 21 \\\\  & =7.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186383210 #edb/ref 1075 #edb/ref 17592186383211 #edb/ref 17592186045417] [17592186383210 #edb/ref 1075 #edb/ref 17592186383212 #edb/ref 17592186045417] [17592186383210 #edb/ref 1075 #edb/ref 17592186383213 #edb/ref 17592186045417] [17592186383210 #edb/ref 1075 #edb/ref 17592186383214 #edb/ref 17592186045417] [17592186383210 #edb/ref 1075 #edb/ref 17592186383215 #edb/ref 17592186045417] [17592186383210 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186383210 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186383210 #edb/ref 1078 #edb/ref 17592186383215 #edb/ref 17592186045417] [17592186383210 #edb/ref 1079 #uuid "dabb27e4-d8e4-566c-8a0e-6e346fcddbfe" #edb/ref 17592186045417] [17592186383211 #edb/ref 1080 "-9" #edb/ref 17592186045417] [17592186383211 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186383211 #edb/ref 1083 #uuid "81d732e7-8e8f-59d0-baa6-b41615da2cbe" #edb/ref 17592186045417] [17592186383212 #edb/ref 1080 "11" #edb/ref 17592186045417] [17592186383212 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186383212 #edb/ref 1083 #uuid "a4dd2ceb-1359-58b5-9a7f-c2b7c0eeba9d" #edb/ref 17592186045417] [17592186383213 #edb/ref 1080 "-5" #edb/ref 17592186045417] [17592186383213 #edb/ref 1082 