answer/id #uuid "b0b05031-46de-5688-a455-e96dab770004" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186383183} {:answer/id #uuid "24272a72-651d-5527-872e-1bbd054048eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186383184} {:answer/id #uuid "86182598-d0ed-54fc-bb0e-ad0d9d3072ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186383185} {:answer/id #uuid "a88007ae-aa92-54fe-8b6f-a828e87edeab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-21" :db/id #edb/ref 17592186383186} {:answer/id #uuid "54736168-6ad1-5a53-a707-3dd8eb0d5dca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186383187}] :answer-field/correct {:answer/id #uuid "24272a72-651d-5527-872e-1bbd054048eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186383184} :answer-field/id #uuid "b4fa9a35-54b0-560c-ba75-0ddbfc721ada" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383182}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3ecc2dd8-459c-57bc-a2ce-f5ea52a64697" :question/math-academy-id "q-130731" :question/problem "Suppose $C$ is a $9\\times 9$ matrix and $det(C)=-93.$ The matrix $D$ is obtained from $C$ by applying the elementary row operation ${R}_{9}:=-\\frac{5}{31}{R}_{9}.$ What is the value of $det(D)?$" :question/worked-solution "The row operation applied to $C$ consists of multiplying a row by the number $-\\frac{5}{31}.$\n\nWhen we do this, the determinant is multiplied by the same number. So, we have\n\n$$\n\\begin{aligned}det(D) & =-\\frac{5}{31}det(C) \\\\  & =-\\frac{5}{31}\\cdot (-93) \\\\  & =15.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186570735 :knowledge-point/_questions [{:db/id #edb/ref 17592186119851 :knowledge-point/id #uuid "272d9a54-ba97-5175-86df-0a78337da7b9" :knowledge-point/title "Calculating a Determinant After Multiplying a Matrix by a Scalar"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ac30f51-6622-5c58-93f3-50a3b53c8c93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-45" :db/id #edb/ref 17592186570141} {:answer/id #uuid "2f953ef4-f453-5c93-9447-a0748ed46ce3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "90" :db/id #edb/ref 17592186570205} {:answer/id #uuid "6704cf6c-18b2-5a39-a197-97fa19920324" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-40" :db/id #edb/ref 17592186570305} {:answer/id #uuid "c2f7f56b-8fbf-56ae-91f8-59f7c3e1a778" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186570465} {:answer/id #uuid "fca72fdf-e0ad-5c57-a47b-0e08014cd557" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-75" :db/id #edb/ref 17592186570572}] :answer-field/correct {:answer/id #uuid "0ac30f51-6622-5c58-93f3-50a3b53c8c93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-45" :db/id #edb/ref 17592186570141} :answer-field/id #uuid "2198884a-3958-5d29-bb71-9b17ea66099a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186570591}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "620b0d62-bee7-51dc-8bf7-49326cfad693" :question/math-academy-id "q-130735" :question/problem "Suppose $B$ is a $2\\times 2$ matrix and $det(B)=-5.$ What is the value of $det(3B)?$" :question/worked-solution "Multiplying a $n\\times n$ matrix by a scalar $k$ is equivalent to multiplying each row by $k,$ and this occurs $n$ times. This leads to the result\n\n$$\n\\begin{aligned}det(k\\cdot B) &={k}^{n}\\cdot det(B).\\end{aligned}\n$$\n\nIn our case, we have $k=3$ and $n=2.$ Therefore,\n\n$$\n\\begin{aligned}det(3B) & ={3}^{2}\\cdot det(B) \\\\  & =9\\cdot (-5) \\\\  & =-45.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186383195 :knowledge-point/_questions [{:db/id #edb/ref 17592186119851 :knowledge-point/id #uuid "272d9a54-ba97-5175-86df-0a78337da7b9" :knowledge-point/title "Calculating a Determinant After Multiplying a Matrix by a Scalar"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "79804d1a-b008-588d-8272-afc2f72f1c76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-40" :db/id #edb/ref 17592186383197} {:answer/id #uuid "8811df6a-286d-5394-8f26-bf824aec436e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186383198} {:answer/id #uuid "7d12e771-1a50-5517-9c82-46494f039f78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-30" :db/id #edb/ref 17592186383199} {:answer/id #uuid "134dd921-8240-5d9b-99f5-7360416a8908" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-80" :db/id #edb/ref 17592186383200} {:answer/id #uuid "bfa975e3-a992-5419-878d-b24ae694468c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "90" :db/id #edb/ref 17592186383201}] :answer-field/correct {:answer/id #uuid "134dd921-8240-5d9b-99f5-7360416a8908" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-80" :db/id #edb/ref 17592186383200} :answer-field/id #uuid "92409d8d-b10d-5c4d-a7d1-a42d1b0cfc78" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383196}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9a5f04aa-dd8a-5322-9e5d-a0849f397bd2" :question/math-academy-id "q-130737" :question/problem "Suppose $C$ is a $4\\times 4$ matrix and $det(C)=-5.$ What is the value of $det(-2C)?$" :question/worked-solution "Multiplying a $n\\times n$ matrix by a scalar $k$ is equivalent to multiplying each row by $k,$ and this occurs $n$ times. This leads to the result\n\n$$\n\\begin{aligned}det(k\\cdot C)={k}^{n}\\cdot det(C).\\end{aligned}\n$$\n\nIn our case, we have $k=-2$ and $n=4.$ Therefore,\n\n$$\n\\begin{aligned}det(-2C) & =(-2)^{4}\\cdot det(C) \\\\  & =16\\cdot (-5) \\\\  & =-80.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186265968 :knowledge-point/_questions [{:db/id #edb/ref 17592186119851 :knowledge-point/id #uuid "272d9a54-ba97-5175-86df-0a78337da7b9" :knowledge-point/title "Calculating a Determinant After Multiplying a Matrix by a Scalar"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48b73141-d30a-51a6-9f59-931d33013ea2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "120" :db/id #edb/ref 17592186263625} {:answer/id #uuid "4dc874e1-0a0a-51b3-b460-40ba95dc7640" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186263673} {:answer/id #uuid "b49f38a2-031f-51dc-8877-a5a624bb1218" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-100" :db/id #edb/ref 17592186264552} {:answer/id #uuid "c7ac9249-0666-5a46-986f-2eafc3fc9b73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-80" :db/id #edb/ref 17592186264745} {:answer/id #uuid "f48bc418-eacd-5a87-a261-84a9526488c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-40" :db/id #edb/ref 17592186265147}] :answer-field/correct {:answer/id #uuid "c7ac9249-0666-5a46-986f-2eafc3fc9b73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-80" :db/id #edb/ref 17592186264745} :answer-field/id #uuid "df63d5a1-1430-5bfe-a708-b9a8006ddea4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265638}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e4056ea9-ab56-5308-af07-58d0dddfaa0c" :question/math-academy-id "q-130741" :question/problem "Suppose $C$ is a $2\\times 2$ matrix and $det(C)=-5,$ What is the value of $det(4C)?$" :question/worked-solution "Multiplying a $n\\times n$ matrix by a scalar $k$ is equivalent to multiplying each row by $k,$ and this occurs $n$ times. This leads to the result\n\n$$\n\\begin{aligned}det(k\\cdot C)={k}^{n}\\cdot det(C).\\end{aligned}\n$$\n\nIn our case, we have $k=4$ and $n=2.$ Therefore,\n\n$$\n\\begin{aligned}det(4C) & ={4}^{2}\\cdot det(C) \\\\  & =16\\cdot (-5) \\\\  & =-80.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186383209 :knowledge-point/_questions [{:db/id #edb/ref 17592186119777 :knowledge-point/id #uuid "24e5e193-5e30-5480-9e5d-b7b8f1d5de87" :knowledge-point/title "Calculating a Determinant After Applying Several Elementary Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81d732e7-8e8f-59d0-baa6-b41615da2cbe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186383211} {:answer/id #uuid "a4dd2ceb-1359-58b5-9a7f-c2b7c0eeba9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186383212} {:answer/id #uuid "e17d1845-191f-56e9-a8be-f287458fefd2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186383213} {:answer/id #uuid "201df9f4-40c1-566c-9902-a0443371a3a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186383214} {:answer/id #uuid "5390ee0e-14be-51ec-9ea4-4ebffe29468f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186383215}] :answer-field/correct {:answer/id #uuid "5390ee0e-14be-51ec-9ea4-4ebffe29468f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186383215} :answer-field/id #uuid "dabb27e4-d8e4-566c-8a0e-6e346fcddbfe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383210}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0c6c7b9b-1b7d-58b7-ad39-d5756aa91423" :question/math-academy-id "q-130743" :question/problem "Suppose $U$ is a $4\\times 4$ matrix and $det(U)=21.$ The matrix $V$ is obtained from $U$ by applying the elementary row operations ${R}_{3}:={R}_{3}+(-7){R}_{4}$ and ${R}_{3}:=\\frac{1}{3}{R}_{3}.$ What is the value of $det(V)?$" :question/worked-solution "First, let's figure out what each operation does to the determinant.\n\n- The operation ${R}_{3}:={R}_{3}+(-7){R}_{4}$ involves adding a multiple of one row to another row,  so it does not change the determinant.\n\n- The operation ${R}_{3}:=\\frac{1}{3}{R}_{3}$ involves multiplying a row by $\\frac{1}{3},$ so the determinant is multiplied by $\\frac{1}{3}$ as well.\n\nTherefore, we only have to multiply the determinant by $\\frac{1}{3}.$ Consequently, we get\n\n$$\n\\begin{aligned}det(V) & =\\frac{1}{3}det(U) \\\\  & =\\frac{1}{3}\\cdot 21 \\\\  & =7.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186498488 :knowledge-point/_questions [{:db/id #edb/ref 17592186119777 :knowledge-point/id #uuid "24e5e193-5e30-5480-9e5d-b7b8f1d5de87" :knowledge-point/title "Calculating a Determinant After Applying Several Elementary Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33b25027-8221-5098-9167-254d753c3213" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186497909} {:answer/id #uuid "4f11998a-ad24-5209-8a9f-c63c403858e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186497989} {:answer/id #uuid "5bda7aff-8f4a-54a5-aebf-3a9be4dd94f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186498017} {:answer/id #uuid "9a175c4f-3333-5a30-a0ee-942d881a95f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186498148} {:answer/id #uuid "cb8dc81a-a234-558b-87aa-921ac69d0c23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186498254}] :answer-field/correct {:answer/id #uuid "5bda7aff-8f4a-54a5-aebf-3a9be4dd94f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186498017} :answer-field/id #uuid "594aa2c5-6ab3-59e0-94ef-12b55bd75a5d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186498398}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "023c52b0-f119-5895-8d3f-31a9468a20b5" :question/math-academy-id "q-130768" :question/problem "Suppose $A$ is a $5\\times 5$ matrix and $det(A)=6.$ The matrix $B$ is obtained from $A$ by applying the elementary row operations ${R}_{2}↔{R}_{3}$ and ${R}_{3}:=4{R}_{3}.$ What is the value of $det(B)?$" :question/worked-solution "First, let's figure out what each operation does to the determinant.\n\n- The operation ${R}_{2}↔{R}_{3}$ involves swapping two rows, so it changes the sign of the determinant to the opposite one.\n\n- The operation ${R}_{3}:=4{R}_{3}$ involves multiplying a row by $4,$ so the determinant is multiplied by $4$ as well.\n\nTherefore, we have to change the sign of the determinant to the opposite one and multiply by $4$ as well. Consequently, we get\n\n$$\n\\begin{aligned}det(B) & =4\\cdot (-det(A)) \\\\  & =-4det(A) \\\\  & =-4\\cdot 6 \\\\  & =-24.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186570763 :knowledge-point/_questions [{:db/id #edb/ref 17592186119777 :knowledge-point/id #uuid "24e5e193-5e30-5480-9e5d-b7b8f1d5de87" :knowledge-point/title "Calculating a Determinant After Applying Several Elementary Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45da5c6a-1bde-5117-8afe-03d361230714" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "33" :db/id #edb/ref 17592186570247} {:answer/id #uuid "68fa8711-c3f3-5012-9d1a-fb731bd236f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-33" :db/id #edb/ref 17592186570309} {:answer/id #uuid "8f6393fe-d927-53da-81a2-0f66da9f7288" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186570375} {:answer/id #uuid "90deae41-5fa1-5e16-8e84-6b13e063a540" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186570378} {:answer/id #uuid "c6b642dc-e552-5c4b-8e91-0e291d1d1b44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186570469}] :answer-field/correct {:answer/id #uuid "45da5c6a-1bde-5117-8afe-03d361230714" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "33" :db/id #edb/ref 17592186570247} :answer-field/id #uuid "711af9c2-1d4a-5a9f-9a30-ae443b985da0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186570630}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a1f0bc2a-d097-538a-b002-360896d3c91f" :question/math-academy-id "q-130769" :question/problem "Suppose $A$ is a $4\\times 4$ matrix and $det(A)=11.$ The matrix $B$ is obtained from $A$ by applying the elementary row operations ${R}_{4}:=3{R}_{4}$ and ${R}_{2}:={R}_{2}+(-5){R}_{1}.$ What is the value of $det(B)?$" :question/worked-solution "First, let's figure out what each operation does to the determinant.\n\n- The operation ${R}_{2}:={R}_{2}+(-5){R}_{1}$ involves adding a multiple of one row to another row,  so it does not change the determinant.\n\n- The operation ${R}_{4}:=3{R}_{4}$ involves multiplying a row by $3,$ so the determinant is multiplied by $3$ as well.\n\nTherefore, we only have to multiply the determinant by $3.$ Consequently, we get\n\n$$\n\\begin{aligned}det(B) & =3det(A) \\\\  & =3\\cdot 11 \\\\  & =33.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186265985 :knowledge-point/_questions [{:db/id #edb/ref 17592186119850 :knowledge-point/id #uuid "9a0ab53e-79ff-5520-bb50-069fd381d29d" :knowledge-point/title "Identifying a Row Operation Given the Connection Between Two Determinants"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36d8f1dd-9c61-582a-91cb-1b1b14e544ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{3}:={R}_{3}+(-2){R}_{1}" :db/id #edb/ref 17592186263489} {:answer/id #uuid "7cfe718c-c4c1-5e05-a605-9f1eeeec4a53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{3}:={R}_{3}+2{R}_{1}" :db/id #edb/ref 17592186264078} {:answer/id #uuid "b62d6a25-1160-5e5d-826d-11092cfa8fd1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+(-2){R}_{1}" :db/id #edb/ref 17592186264579} {:answer/id #uuid "ee61c6e2-7ebd-5d28-8d0e-3007260e4c30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{1}↔{R}_{3}" :db/id #edb/ref 17592186265084} {:answer/id #uuid "f1a2f26a-317b-5119-9e11-1fcf1b2dfd40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{2}:=2{R}_{2}" :db/id #edb/ref 17592186265123}] :answer-field/correct {:answer/id #uuid "36d8f1dd-9c61-582a-91cb-1b1b14e544ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{3}:={R}_{3}+(-2){R}_{1}" :db/id #edb/ref 17592186263489} :answer-field/id #uuid "eab97c28-5a65-571d-9829-1e7bb5397bea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265662}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7d54eadd-5171-5d74-9872-72cd2ba1ef45" :question/math-academy-id "q-130843" :question/problem "Given that $det(A)=det(B),$ which of the following elementary row operations transforms matrix $A$ to matrix $B,$ where\n\n$$\nA=\\begin{bmatrix}1 & 5 & 3 \\\\ 2 & 4 & -2 \\\\ 2 & 8 & -2\\end{bmatrix},\\,B=\\begin{bmatrix}1 & 5 & 3 \\\\ 2 & 4 & -2 \\\\ 0 & -2 & -8\\end{bmatrix}?\n$$" :question/worked-solution "Since $det(A)=det(B)$, the row operation applied to $A$ must be to add or subtract a multiple of one row to another row. In other words, it is of the form \n\n$$\n{R}_{j}:={R}_{j}+(k){R}_{i},\\,i\\ne j.\n$$\n\nBy considering the given row operations that are of the above form, we notice that\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}1 & 5 & 3 \\\\ 2 & 4 & -2 \\\\ 2 & 8 & -2\\end{aligned}| & {R}_{3} & :={R}_{3}+(-2){R}_{1} \\\\  & =|\\begin{aligned}1 & 5 & 3 \\\\ 2 & 4 & -2 \\\\ 0 & -2 & -8\\end{aligned}| \\\\  & =det(B).\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{3}:={R}_{3}+(-2){R}_{1}.\n$$"}] [{:db/id #edb/ref 17592186120420 :knowledge-point/_questions [{:db/id #edb/ref 17592186119850 :knowledge-point/id #uuid "9a0ab53e-79ff-5520-bb50-069fd381d29d" :knowledge-point/title "Identifying a Row Operation Given the Connection Between Two Determinants"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37511006-3cc1-5044-a452-04788f70a6b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{3}:={R}_{3}+2{R}_{2}" :db/id #edb/ref 17592186324422} {:answer/id #uuid "52ff4a1e-e084-5b7a-9da2-3d3878cd71ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{3}↔{R}_{1}" :db/id #edb/ref 17592186324653} {:answer/id #uuid "71e11479-c1c3-5398-9ce8-e2748445bd42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{3}:=\\frac{1}{2}{R}_{3}" :db/id #edb/ref 17592186324913} {:answer/id #uuid "9d025d13-dbb9-5f4d-81e6-a2fb2be38c43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+(-2){R}_{1}" :db/id #edb/ref 17592186325304} {:answer/id #uuid "c5d34638-1f12-5d11-897f-c363aca5a5d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+(-1){R}_{1}" :db/id #edb/ref 17592186325677}] :answer-field/correct {:answer/id #uuid "9d025d13-dbb9-5f4d-81e6-a2fb2be38c43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+(-2){R}_{1}" :db/id #edb/ref 17592186325304} :answer-field/id #uuid "aa554bb6-6241-52a2-a8a6-09b04c9e8078" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326528}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1d4250d6-4c9c-5a2c-ac92-71ea5c8419b4" :question/math-academy-id "q-42076" :question/problem "Given that $det(A)=det(B),$ which of the following elementary row operations transforms matrix $A$ to matrix $B,$ where\n\n$$\nA=\\begin{bmatrix}1 & 2 & 4 \\\\ 2 & 4 & -1 \\\\ 3 & 2 & 1\\end{bmatrix},\\,B=\\begin{bmatrix}1 & 2 & 4 \\\\ 0 & 0 & -9 \\\\ 3 & 2 & 1\\end{bmatrix}?\n$$" :question/worked-solution "Since $det(A)=det(B)$, the row operation applied to $A$ must be to add or subtract a multiple of one row to another row. In other words, it is of the form \n\n$$\n{R}_{j}:={R}_{j}+(k){R}_{i},\\,i\\ne j.\n$$\n\nBy considering the given row operations that are of the above form, we notice that\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}1 & 2 & 4 \\\\ 2 & 4 & -1 \\\\ 3 & 2 & 1\\end{aligned}| & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & =|\\begin{aligned}1 & 2 & 4 \\\\ 0 & 0 & -9 \\\\ 3 & 2 & 1\\end{aligned}| \\\\  & =det(B).\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{2}:={R}_{2}+(-2){R}_{1}.\n$$"}] [{:db/id #edb/ref 17592186329660 :knowledge-point/_questions [{:db/id #edb/ref 17592186119776 :knowledge-point/id #uuid "2f11b223-edd2-59b8-b761-164d56e29746" :knowledge-point/title "Calculating a Determinant After Multiplying a Row by a Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "401f1ce6-7b6e-529f-9714-529e16f1d2b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186327496} {:answer/id #uuid "6cdd9dd0-b592-574b-9ee9-9b4335f8c3cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186327876} {:answer/id #uuid "8ef6c209-6ff6-568b-994a-9d570513837e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186328180} {:answer/id #uuid "bf1d70fd-366f-54a5-af81-aea325ecdc0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186328606} {:answer/id #uuid "f90db089-8c9b-53e3-9f5d-a170c0d21ee2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186329118}] :answer-field/correct {:answer/id #uuid "8ef6c209-6ff6-568b-994a-9d570513837e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186328180} :answer-field/id #uuid "abc88ab4-86f2-5a4b-8e4f-88060e4ebc03" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329483}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2475d475-902a-59fd-8c1f-992bd3a67e4c" :question/math-academy-id "q-42502" :question/problem "Suppose $A$ is a $5\\times 5$ matrix and $det(A)=2.$ The matrix $B$ is obtained from $A$ by applying the elementary row operation ${R}_{3}:=\\frac{3}{2}{R}_{3}.$ What is the value of $det(B)?$" :question/worked-solution "The row operation applied to $A$ consists of multiplying a row by the number $\\frac{3}{2}.$\n\nWhen we do this, the determinant is multiplied by the same number. So, we have\n\n$$\n\\begin{aligned}det(B) & =\\frac{3}{2}det(A) \\\\  & =\\frac{3}{2}\\cdot 2 \\\\  & =3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186570776 :knowledge-point/_questions [{:db/id #edb/ref 17592186119850 :knowledge-point/id #uuid "9a0ab53e-79ff-5520-bb50-069fd381d29d" :knowledge-point/title "Identifying a Row Operation Given the Connection Between Two Determinants"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c95cd97-d991-586e-9d48-4aceab408e83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186570179} {:answer/id #uuid "804d6b51-a8c2-5553-b8eb-99abf73a0c50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186570350} {:answer/id #uuid "9747a53a-fd06-5bad-9209-5355bca6ff7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident 