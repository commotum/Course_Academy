{3}{10}\\cdot 80 \\\\  & =24.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186570789 :knowledge-point/_questions [{:db/id #edb/ref 17592186119851 :knowledge-point/id #uuid "272d9a54-ba97-5175-86df-0a78337da7b9" :knowledge-point/title "Calculating a Determinant After Multiplying a Matrix by a Scalar"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4243c7f8-2743-5826-8ea3-6ef8e115624e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186570236} {:answer/id #uuid "51f3b4fe-201b-5333-b047-b7f366028135" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "405" :db/id #edb/ref 17592186570269} {:answer/id #uuid "745baa5f-b719-5189-ac4b-4648fef6b3c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-405" :db/id #edb/ref 17592186570333} {:answer/id #uuid "a334f1d1-81fc-5956-9a40-05a3431dd1e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-320" :db/id #edb/ref 17592186570413} {:answer/id #uuid "fd773a2d-7538-5011-95fc-7be41b06dcde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "320" :db/id #edb/ref 17592186570574}] :answer-field/correct {:answer/id #uuid "fd773a2d-7538-5011-95fc-7be41b06dcde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "320" :db/id #edb/ref 17592186570574} :answer-field/id #uuid "db33a278-5e86-591a-8a62-14279c3317f5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186570681}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f9fbd8ca-7a83-50db-a6d3-a36d5d6ceb97" :question/math-academy-id "q-72746" :question/problem "Suppose $C$ is a $3\\times 3$ matrix and $det(C)=-5.$ What is the value of $det(-4C)?$" :question/worked-solution "Multiplying a $n\\times n$ matrix by a scalar $k$ is equivalent to multiplying each row by $k,$ and this occurs $n$ times. This leads to the result\n\n$$\n\\begin{aligned}det(k\\cdot C) &={k}^{n}\\cdot det(C).\\end{aligned}\n$$\n\nIn our case, we have $k=-4$ and $n=3.$ Therefore,\n\n$$\n\\begin{aligned}det(-4C) & =(-4)^{3}\\cdot det(C) \\\\  & =(-64)\\cdot (-5) \\\\  & =320.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186409688 :knowledge-point/_questions [{:db/id #edb/ref 17592186119777 :knowledge-point/id #uuid "24e5e193-5e30-5480-9e5d-b7b8f1d5de87" :knowledge-point/title "Calculating a Determinant After Applying Several Elementary Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "403dcee3-3eac-5cf3-a329-0558750fb3b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186409660} {:answer/id #uuid "62a1a85b-a36c-54a7-b3bd-55a36f4cb315" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186409664} {:answer/id #uuid "77636ea6-fba2-560e-a69f-f3d2282f86f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186409669} {:answer/id #uuid "81cdf51b-4eb6-557c-9452-11d65bc919bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186409671} {:answer/id #uuid "ebe826b2-b0aa-57e0-a4ad-251af663d3fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186409678}] :answer-field/correct {:answer/id #uuid "81cdf51b-4eb6-557c-9452-11d65bc919bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186409671} :answer-field/id #uuid "1a00ccd6-15ad-566e-9909-ced57101fb7b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186409684}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4a80ad4c-5529-5931-9d7c-574d40c6f47e" :question/math-academy-id "q-72748" :question/problem "Suppose $B$ is a $3\\times 3$ matrix and $det(B)=-7.$ The matrix $C$ is obtained from $B$ by applying the elementary row operations ${R}_{2}:=2{R}_{2}$ and ${R}_{1}↔{R}_{3}.$ What is the value of $det(C)?$" :question/worked-solution "First, let's figure out what each operation does to the determinant.\n\n- The operation ${R}_{1}↔{R}_{3}$ involves swapping two rows, so it changes the sign of the determinant to the opposite one.\n\n- The operation ${R}_{2}:=2{R}_{2}$ involves multiplying a row by $2,$ so the determinant is multiplied by $2$ as well.\n\nTherefore, we have to change the sign of the determinant to the opposite one and multiply by $2$ as well. Consequently, we get\n\n$$\n\\begin{aligned}det(C) & =2\\cdot (-det(B)) \\\\  & =-2det(B) \\\\  & =-2\\cdot (-7) \\\\  & =14.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186385564 :knowledge-point/_questions [{:db/id #edb/ref 17592186119777 :knowledge-point/id #uuid "24e5e193-5e30-5480-9e5d-b7b8f1d5de87" :knowledge-point/title "Calculating a Determinant After Applying Several Elementary Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "121accbd-ce4d-58b0-8138-51b0d5816729" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186385566} {:answer/id #uuid "c7466e83-a039-5070-9c2b-37cda904fe67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-39" :db/id #edb/ref 17592186385567} {:answer/id #uuid "f2edcb03-c160-5fff-95b4-ab8480ff0250" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-13" :db/id #edb/ref 17592186385568} {:answer/id #uuid "e133af97-e9a4-5f84-9abf-be453370fa60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "39" :db/id #edb/ref 17592186385569} {:answer/id #uuid "92c22aa6-88b0-5c90-b45a-3daa510bbf8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-117" :db/id #edb/ref 17592186385570}] :answer-field/correct {:answer/id #uuid "121accbd-ce4d-58b0-8138-51b0d5816729" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186385566} :answer-field/id #uuid "57c7ba14-561e-5117-b9e5-7f055ee2a4ee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186385565}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3c250701-0a7a-5fa6-bb64-c33343cbfdd2" :question/math-academy-id "q-72749" :question/problem "Suppose $X$ is a $6\\times 6$ matrix and $det(X)=39.$ The matrix $Y$ is obtained from $X$ by applying the elementary row operations ${R}_{4}:=\\frac{1}{3}{R}_{4}$ and ${R}_{5}:={R}_{5}+(-3){R}_{1}.$ What is the value of $det(Y)?$" :question/worked-solution "First, let's figure out what each operation does to the determinant.\n\n- The operation ${R}_{5}:={R}_{5}+(-3){R}_{1}$ involves adding a multiple of one row to another row,  so it does not change the determinant.\n\n- The operation ${R}_{4}:=\\frac{1}{3}{R}_{4}$ involves multiplying a row by $\\frac{1}{3},$ so the determinant is multiplied by $\\frac{1}{3}$ as well.\n\nTherefore, we only have to multiply the determinant by $\\frac{1}{3}.$ Consequently, we get\n\n$$\n\\begin{aligned}det(Y) & =\\frac{1}{3}det(X) \\\\  & =\\frac{1}{3}\\cdot 39 \\\\  & =13.\\end{aligned}\n$$"}]}
