e=\"true\" scriptlevel=\"0\"><mfrac><mn>3</mn><mn>10</mn></mfrac></mstyle><mo>⋅</mo><mn>80</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>24.</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
