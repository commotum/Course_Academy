      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14243821/observations/step-q130731-ff06597a5d6603b1ee57.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14243821/observations/step-q130731-ff06597a5d6603b1ee57.png",
      "source_url": "https://mathacademy.com/tasks/14243821/topics/1772/lesson",
      "captured_at": 1792124840.8008282,
      "math_academy_id": "q-130731",
      "topic_id": "1772",
      "sequence_position": null,
      "source_step": {
