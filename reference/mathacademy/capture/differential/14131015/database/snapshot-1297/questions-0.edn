#{[{:db/id #edb/ref 17592186068457 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068857 :knowledge-point/id #uuid "d59ccd52-63db-5d28-b78b-2df7caf52ad0" :knowledge-point/title "Evaluating a Vector-Valued Function"}] :question/id #uuid "6eea01b2-bc2a-55a8-9bab-6789df00fc42" :question/math-academy-id "e-12450" :question/problem "Given that $\\mathbf r (t) = \\langle 6t, 2t^2-1\\rangle,$ calculate $\\mathbf r (3).$" :question/worked-solution "We substitute $t=3$ into our function, and we get\n\n$$\n\\begin{aligned}r(3) & =⟨6(3),\\,2(3)^{2}-1⟩ \\\\  & =⟨18,\\,17⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186068458 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068858 :knowledge-point/id #uuid "e520dc67-3b63-5ca7-959b-f642d85529d6" :knowledge-point/title "Finding the Magnitude of a Vector-Valued Function"}] :question/id #uuid "86e423e7-db4b-5fdf-a285-bded3bd8161e" :question/math-academy-id "e-12451" :question/problem "Find $\\left|\\mathbf r\\left(4\\right)\\right|$ given that $\\mathbf r(t)  = \\left\\langle 2-t, 2\\sqrt{t}, \\, t-1\\right\\rangle,$" :question/worked-solution "Evaluating the function at $t=4,$ we get\n\n$$\n\\begin{aligned}r(4) & =⟨2-4,\\,2\\sqrt{4},\\,4-1⟩ \\\\  & =⟨-2,\\,4,\\,3⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we obtain\n\n$$\n\\begin{aligned}|r(4)| & =\\sqrt{{(-2)}^{2}+{(4)}^{2}+{(3)}^{2}} \\\\  & =\\sqrt{4+16+9} \\\\  & =\\sqrt{29}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186068459 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068859 :knowledge-point/id #uuid "26571ec1-e645-5f07-ba4e-75c22558394a" :knowledge-point/title "Evaluating a Three-Component Vector-Valued Function"}] :question/id #uuid "ab3899d3-8838-57ad-8a17-b8ac2934c0f9" :question/math-academy-id "e-12452" :question/problem "Find the value of the vector function $\\mathbf f(t) = \\left\\langle \\cos t, \\: \\sin t, \\: t \\right\\rangle$ at $t = \\pi.$" :question/worked-solution "To evaluate, we substitute $t = \\pi$ into the function, as follows:\n\n$$\n\\begin{aligned}f(\\pi ) & =⟨\\operatorname{cos}⁡\\pi ,\\,\\operatorname{sin}⁡\\pi ,\\,\\pi ⟩=⟨-1,0,\\pi \\,⟩\\end{aligned}\n$$\n\nSo, the value of $\\mathbf f (t)$ at $t = \\pi$ is $\\langle -1, 0, \\pi \\rangle.$\n\nWe can also express the answer using $\\mathbf i$-$\\mathbf j$-$\\mathbf k$ notation or square bracket notation, as follows:\n![](images/d9/d9ed4c8dcfbbc0fe7b4bf58e58197598221fc730613005a719252bf88c07d3f4.svg)"}] [{:db/id #edb/ref 17592186427593 :knowledge-point/_questions [{:db/id #edb/ref 17592186068857 :knowledge-point/id #uuid "d59ccd52-63db-5d28-b78b-2df7caf52ad0" :knowledge-point/title "Evaluating a Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "526cac9d-bee9-5e96-9ea8-424944084161" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨5,\\,8⟩" :db/id #edb/ref 17592186427581} {:answer/id #uuid "6abd17a0-d501-55cc-8f71-616667496008" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨6,\\,4⟩" :db/id #edb/ref 17592186427582} {:answer/id #uuid "7ea49735-c879-5e56-98a2-6234975c2ed8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨12,\\,6⟩" :db/id #edb/ref 17592186427583} {:answer/id #uuid "b978f470-a67c-5051-bacf-d5ebee33e3d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨7,\\,6⟩" :db/id #edb/ref 17592186427586} {:answer/id #uuid "f5dd3736-c763-5b87-9410-dfb184b766a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨7,\\,8⟩" :db/id #edb/ref 17592186427587}] :answer-field/correct {:answer/id #uuid "f5dd3736-c763-5b87-9410-dfb184b766a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨7,\\,8⟩" :db/id #edb/ref 17592186427587} :answer-field/id #uuid "ff91b146-326d-518f-b02c-b93f9c2da44f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186427591}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e765d7bb-3916-55f5-973d-5d131400a89f" :question/math-academy-id "q-123191" :question/problem "Given that $r(t)=⟨2t-5,\\,\\frac{4t+24}{t}⟩,$ calculate $r(6).$" :question/worked-solution "We  substitute $t=6$ into our function, and we get\n\n$$\n\\begin{aligned}r(6) & =⟨2\\cdot 6-5,\\,\\frac{4\\cdot 6+24}{6}⟩ \\\\  & =⟨7,\\,8⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278334 :knowledge-point/_questions [{:db/id #edb/ref 17592186068859 :knowledge-point/id #uuid "26571ec1-e645-5f07-ba4e-75c22558394a" :knowledge-point/title "Evaluating a Three-Component Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "017818b3-7eb5-5983-b993-b94ed7bc4f60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "i+j+k" :db/id #edb/ref 17592186275487} {:answer/id #uuid "0baeaf9e-f5d2-51a6-9bd4-e6ff547469a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "i-j+k" :db/id #edb/ref 17592186275573} {:answer/id #uuid "57b95886-7b45-5b76-b146-573d86c52385" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-i-j-k" :db/id #edb/ref 17592186276262} {:answer/id #uuid "7535ebcf-b155-5788-a9e1-0ed34ae0f4eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-i-j+k" :db/id #edb/ref 17592186276539} {:answer/id #uuid "eba0b132-4904-5bf2-8beb-830155e49f3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "i+j-k" :db/id #edb/ref 17592186277537}] :answer-field/correct {:answer/id #uuid "eba0b132-4904-5bf2-8beb-830155e49f3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "i+j-k" :db/id #edb/ref 17592186277537} :answer-field/id #uuid "453f511c-3883-5354-9c37-af56c3a1aaec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277833}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7b01d56e-0cd6-5466-b9de-28d868176a07" :question/math-academy-id "q-160769" :question/problem "What is the value of \n $f(s)=\\operatorname{tan}⁡s\\,i+\\operatorname{cot}⁡s\\,j-\\,k$ at $s=\\frac{\\pi }{4}?$" :question/worked-solution "To evaluate, we substitute at $s=\\frac{\\pi }{4}$  into the function, as follows:\n\n$$\n\\begin{aligned}f(\\frac{\\pi }{4}) & =\\operatorname{tan}⁡(\\frac{\\pi }{4})\\,i+\\operatorname{cot}⁡(\\frac{\\pi }{4})\\,j-k \\\\  & =1\\,i+1\\,j-k \\\\  & =i+j-k\\end{aligned}\n$$\n\nSo, the value of  $f(s)$ at $s=\\frac{\\pi }{4}$  is $i+j-k.$"}] [{:db/id #edb/ref 17592186427592 :knowledge-point/_questions [{:db/id #edb/ref 17592186068859 :knowledge-point/id #uuid "26571ec1-e645-5f07-ba4e-75c22558394a" :knowledge-point/title "Evaluating a Three-Component Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2124c1b9-25d8-5849-a68d-2733cf6f9a90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186427577}] :answer-field/correct {:answer/id #uuid "2124c1b9-25d8-5849-a68d-2733cf6f9a90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186427577} :answer-field/id #uuid "199fbb54-137d-5f97-a7ab-0ecad173160f" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186427588} {:answer-field/choices [{:answer/id #uuid "b53f08c6-fba9-5551-a03d-2091137b0f76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186427585}] :answer-field/correct {:answer/id #uuid "b53f08c6-fba9-5551-a03d-2091137b0f76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186427585} :answer-field/id #uuid "390c3f12-6c37-5beb-baeb-a636a4e68d8b" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186427589} {:answer-field/choices [{:answer/id #uuid "47a373d1-518e-59a4-aefc-060c414c4460" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186427579}] :answer-field/correct {:answer/id #uuid "47a373d1-518e-59a4-aefc-060c414c4460" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186427579} :answer-field/id #uuid "67f37091-9e4a-5732-b99a-7e1b90aa1493" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186427590}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4a54de3d-3f38-521d-8556-42e611899526" :question/math-academy-id "q-348677" :question/problem "What is the value of $p(t)=⟨{log}_{5}⁡({t}^{2}+16),\\,tan\\,(\\frac{\\pi t}{9}),\\,{t}^{3}-6t⟩$ at $t=3?$\n\n$p(3)=⟨$\n{{field-1}} $,\\,$\n{{field-2}} $,\\,$\n{{field-3}} $⟩$" :question/worked-solution "To evaluate, we substitute $t=3$ into the function, as follows:\n\n$$\n\\begin{aligned}p(3) & =⟨{log}_{5}⁡({3}^{2}+16),\\,tan\\,(\\frac{3\\pi }{9}),\\,{3}^{3}-6(3)⟩ \\\\  & =⟨{log}_{5}⁡(25),\\,tan\\,(\\frac{\\pi }{3}),\\,27-18⟩ \\\\  & =⟨2,\\,\\sqrt{3},\\,9⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186319279 :knowledge-point/_questions [{:db/id #edb/ref 17592186068858 :knowledge-point/id #uuid "e520dc67-3b63-5ca7-959b-f642d85529d6" :knowledge-point/title "Finding the Magnitude of a Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "99ccd0c5-c9f5-5a83-9bcb-a6eedad3e8a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186318092}] :answer-field/correct {:answer/id #uuid "99ccd0c5-c9f5-5a83-9bcb-a6eedad3e8a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186318092} :answer-field/id #uuid "b8fba009-9b2f-5de7-983c-3162568cd196" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318824}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "467bbe03-18b4-513c-ba49-7eedf1cc8a92" :question/math-academy-id "q-348690" :question/problem "Given that $r(t)=⟨cos\\,(\\frac{\\pi t}{2}),\\,\\sqrt{{t}^{3}-4},\\,ln\\,(2\\,{e}^{t-2}-1)⟩,$ what is $|r(2)|?$ Do not round the answer.\n\n$|r(2)|=$\n{{field-1}}" :question/worked-solution "Evaluating the function at $t=2,$ we get\n\n$$\n\\begin{aligned}r(2) & =⟨cos\\,(\\frac{2\\pi }{2}),\\,\\sqrt{{2}^{3}-4},\\,ln\\,(2\\,{e}^{0}-1)⟩ \\\\  & =⟨\\operatorname{cos}⁡(\\pi ),\\,\\sqrt{4},\\,\\operatorname{ln}⁡(1)⟩ \\\\  & =⟨-1,\\,2,\\,0⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we get\n\n$$\n\\begin{aligned}|r(2)| & =\\sqrt{(-1)^{2}+{2}^{2}+{0}^{2}} \\\\  & =\\sqrt{1+4+0} \\\\  & =\\sqrt{5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186319281 :knowledge-point/_questions [{:db/id #edb/ref 17592186068858 :knowledge-point/id #uuid "e520dc67-3b63-5ca7-959b-f642d85529d6" :knowledge-point/title "Finding the Magnitude of a Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1134010b-c90c-5364-bdbf-6351f4aead82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186317621}] :answer-field/correct {:answer/id #uuid "1134010b-c90c-5364-bdbf-6351f4aead82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186317621} :answer-field/id #uuid "10ddeb3d-5072-5905-b3e1-be70102a5b65" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318461}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1bd1a588-edf0-5720-9e2d-306abd5f8af7" :question/math-academy-id "q-348693" :question/problem "Given that $r(t)=⟨\\operatorname{cos}⁡(\\pi t),\\,\\sqrt{t+3},\\,t-1⟩,$ what is $|r(1)|?$ Do not round the answer.\n\n$|r(1)|=$\n{{field-1}}" :question/worked-solution "Evaluating the function at $t=1,$ we get\n\n$$\n\\begin{aligned}r(1) & =⟨\\operatorname{cos}⁡(\\pi ),\\,\\sqrt{4},\\,0⟩ \\\\  & =⟨-1,\\,2,\\,0⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we get\n\n$$\n\\begin{aligned}|r(1)| & =\\sqrt{(-1)^{2}+{2}^{2}+{0}^{2}} \\\\  & =\\sqrt{1+4} \\\\  & =\\sqrt{5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186069412 :knowledge-point/_questions [{:db/id #edb/ref 17592186068857 :knowledge-point/id #uuid "d59ccd52-63db-5d28-b78b-2df7caf52ad0" :knowledge-point/title "Evaluating a Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ded48646-180c-5b0b-a6e9-fca073f5a695" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186067645} {:answer/id #uuid "0f6a5f44-7c10-57f2-8e95-6bb68e1b82b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨2,\\,\\frac{1}{2}⟩" :db/id #edb/ref 17592186427576} {:answer/id #uuid "2331cd21-2ed1-5625-a66c-71e5cb90700e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{1}{2},\\,2⟩" :db/id #edb/ref 17592186427578} {:answer/id #uuid "4ac18ed6-58a3-5417-b730-cedc5302f322" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨2,\\,2⟩" :db/id #edb/ref 17592186427580} {:answer/id #uuid "a96be7b9-8d6b-519e-93fb-b0e6acf1e4a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{1}{2},\\,\\frac{1}{2}⟩" :db/id #edb/ref 17592186427584}] :answer-field/correct {:answer/id #uuid "a96be7b9-8d6b-519e-93fb-b0e6acf1e4a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{1}{2},\\,\\frac{1}{2}⟩" :db/id #edb/ref 17592186427584} :answer-field/id #uuid "2aea7a53-b7bf-5584-8696-8766da29f419" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186067642}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2dc454b1-c8a7-57a0-a955-d54808121033" :question/math-academy-id "q-50359" :question/problem "Given that $r(t)=⟨{cos}^{2}⁡t,\\,{sin}^{2}⁡t⟩,$ calculate $r(\\frac{\\pi }{4}).$" :question/worked-solution "We substitute $t=\\frac{\\pi }{4}$ into our function, and we get\n\n$$\n\\begin{aligned}r(\\frac{\\pi }{4}) & =⟨{cos}^{2}⁡(\\frac{\\pi }{4}),\\,{sin}^{2}⁡(\\frac{\\pi }{4})⟩ \\\\  & =⟨{(\\frac{\\sqrt{2}}{2})}^{2},\\,{(\\frac{\\sqrt{2}}{2})}^{2}⟩ \\\\  & =⟨\\frac{1}{2},\\,\\frac{1}{2}⟩.\\end{aligned}\n$$"}]}
