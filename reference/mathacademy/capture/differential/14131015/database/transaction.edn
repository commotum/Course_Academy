er-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-47a373d1-518e-59a4-aefc-060c414c4460" :answer-field/choices ["answer-47a373d1-518e-59a4-aefc-060c414c4460"] :db/ensure [:answer-field/validate]} {:db/id "answer-47a373d1-518e-59a4-aefc-060c414c4460" :answer/id #uuid "47a373d1-518e-59a4-aefc-060c414c4460" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-field-199fbb54-137d-5f97-a7ab-0ecad173160f" :answer-field/id #uuid "199fbb54-137d-5f97-a7ab-0ecad173160f" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-2124c1b9-25d8-5849-a68d-2733cf6f9a90" :answer-field/choices ["answer-2124c1b9-25d8-5849-a68d-2733cf6f9a90"] :db/ensure [:answer-field/validate]} {:db/id "answer-2124c1b9-25d8-5849-a68d-2733cf6f9a90" :answer/id #uuid "2124c1b9-25d8-5849-a68d-2733cf6f9a90" :answer/type :answer.type/math :answer/value "\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "answer-field-390c3f12-6c37-5beb-baeb-a636a4e68d8b" :answer-field/id #uuid "390c3f12-6c37-5beb-baeb-a636a4e68d8b" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-b53f08c6-fba9-5551-a03d-2091137b0f76" :answer-field/choices ["answer-b53f08c6-fba9-5551-a03d-2091137b0f76"] :db/ensure [:answer-field/validate]} {:db/id "answer-b53f08c6-fba9-5551-a03d-2091137b0f76" :answer/id #uuid "b53f08c6-fba9-5551-a03d-2091137b0f76" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id 17592186070011 :tutorial/content "We can also define vector-valued functions with three components. For example,\n\n$$\n\\mathbf{f} (t) = t \\ \\mathbf{i} + 2t^2 \\ \\mathbf{j} + 3t^3 \\ \\mathbf{k}.\n$$\n\nThis particular definition uses the so-called $\\mathbf{i}$-$\\mathbf{j}$-$\\mathbf{k}$ notation.\n\nWe can represent the same function using **angle bracket** notation, as follows:\n\n$$\n\\mathbf f (t) = \\langle t,  \\: 2t^2, \\: 3t^3 \\rangle\n$$\n\nAnother notation that's often convenient is **bracket** notation:\n\n![](images/a9/a95fd21b6ea5e7eae150b516d7d0ad82d283a31c895c9223abbeac81b622bb7d.svg)\n\nIt's important to realize that all three notations represent the same function." :db/ensure [:tutorial/validate]} {:db/id 17592186068999 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]}]
