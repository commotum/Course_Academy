e {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186349189} {:answer/id #uuid "94ed251c-0d5e-5d2d-94e7-1fb28d07bdcb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186349781}] :answer-field/correct {:answer/id #uuid "3066946a-f044-5204-ab77-bef3a2693067" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186348877} :answer-field/id #uuid "cb94e7f6-2fde-5f36-ac5f-9619c1b6e412" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186351061}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "35f8611c-3990-55b5-9e1a-16081db42aa2" :question/math-academy-id "q-81104" :question/problem "Given the orthogonal basis $B$ of ${R}^{2}$ and the vector $x$ below, find the value of $20{x}_{2},$ where ${x}_{2}$ is the second component of $[x]_{B}.$\n\n$$\nB={[\\begin{aligned}4 \\\\ -8\\end{aligned}],[\\begin{aligned}-2 \\\\ -1\\end{aligned}]},\\,x=[\\begin{aligned}-1 \\\\ 1\\end{aligned}]\n$$" :question/worked-solution "Let's denote the vectors of $B$ as ${q}_{1},\\,{q}_{2}.$ \n\nSince $B$ is an orthogonal basis, we have that $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$, where ${x}_{i}=\\frac{x\\cdot {q}_{i}}{{q}_{i}\\cdot {q}_{i}}.$ Computing ${x}_{2},$ we obtain \n\n$$\n\\begin{aligned}{x}_{2} & =\\frac{x\\cdot {q}_{2}}{{q}_{2}\\cdot {q}_{2}} \\\\  & =\\frac{(-1)\\cdot (-2)+1\\cdot (-1)}{(-2)^{2}+(-1)^{2}} \\\\  & =\\frac{2-1}{4+1} \\\\  & =\\frac{1}{5}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n20{x}_{2}=20\\cdot \\frac{1}{5}=4.\n$$"}] [{:db/id #edb/ref 17592186351221 :knowledge-point/_questions [{:db/id #edb/ref 17592186157276 :knowledge-point/id #uuid "15b92bed-c97f-5b87-9811-fbfc5c03314d" :knowledge-point/title "Finding a Component of a Vector With Respect to a Given Orthogonal Basis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19f3bbf1-c0e5-5228-8cff-d59b8275a445" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186348665} {:answer/id #uuid "2e23fd73-4511-51ce-9c9b-a2e85d0d467e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{5}" :db/id #edb/ref 17592186348854} {:answer/id #uuid "3c8ba05b-0fb2-552e-b2c3-c261f851e968" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186348996} {:answer/id #uuid "cae57d69-bc15-563e-b711-8f432ccf3f01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186350233} {:answer/id #uuid "e1b1524a-a35f-5d39-88f2-6978a5dcde2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "27" :db/id #edb/ref 17592186350431}] :answer-field/correct {:answer/id #uuid "3c8ba05b-0fb2-552e-b2c3-c261f851e968" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186348996} :answer-field/id #uuid "f2732aa6-db93-5aa1-a3dd-e5d16456325b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186351132}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d38229d4-d437-56ee-81dd-f6a825ab8d98" :question/math-academy-id "q-81105" :question/problem "Given the orthogonal basis $B$ of ${R}^{2}$ and the vector $x$ below, find the value of $10{x}_{2},$ where ${x}_{2}$ is the second component of $[x]_{B}.$\n\n$$\nB={[\\begin{aligned}-2 \\\\ -6\\end{aligned}],[\\begin{aligned}3 \\\\ -1\\end{aligned}]},\\,x=[\\begin{aligned}5 \\\\ -3\\end{aligned}]\n$$" :question/worked-solution "Let's denote the vectors of $B$ as ${q}_{1},\\,{q}_{2}.$ \n\nSince $B$ is an orthogonal basis, we have that $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$, where ${x}_{i}=\\frac{x\\cdot {q}_{i}}{{q}_{i}\\cdot {q}_{i}}.$ Computing ${x}_{2},$ we obtain \n\n$$\n\\begin{aligned}{x}_{2} & =\\frac{x\\cdot {q}_{2}}{{q}_{2}\\cdot {q}_{2}} \\\\  & =\\frac{5\\cdot 3+(-3)\\cdot (-1)}{{3}^{2}+(-1)^{2}} \\\\  & =\\frac{15+3}{9+1} \\\\  & =\\frac{9}{5}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n10{x}_{2}=10\\cdot \\frac{9}{5}=18.\n$$"}] [{:db/id #edb/ref 17592186351235 :knowledge-point/_questions [{:db/id #edb/ref 17592186157277 :knowledge-point/id #uuid "39b12711-22c8-5cb7-bd61-e128734e7e6f" :knowledge-point/title "Calculating the Components of a Vector With Respect to a Given Orthonormal Basis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0990fd7b-21d6-50c6-a747-173db0842535" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186348524} {:answer/id #uuid "2fce5078-e924-52bf-a081-b822054da6cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186348872} {:answer/id #uuid "39de05b5-020b-5630-834d-7b794db09ff7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186348966} {:answer/id #uuid "4a7f4998-356c-5aea-84e9-57685a5ac81c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{6}" :db/id #edb/ref 17592186349125} {:answer/id #uuid "ee898a3c-4ef1-56c7-b651-7c702754aa39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186350532}] :answer-field/correct {:answer/id #uuid "ee898a3c-4ef1-56c7-b651-7c702754aa39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186350532} :answer-field/id #uuid "f4ea86f5-53be-5b8e-970a-70ed5d02d48e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186351137}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2c7b8cdd-da80-5fc5-a44b-0a5962fa099a" :question/math-academy-id "q-81142" :question/problem "Given the **orthonormal** basis $B$ of ${R}^{3}$ and the vector $x$ below, find the value of $\\sqrt{6}{x}_{2}$, where ${x}_{2}$ is the second component of $[x]_{B}.$\n\n$$\nB={[\\begin{aligned}\\frac{2}{\\sqrt{5}} \\\\ -\\frac{1}{\\sqrt{5}} \\\\ 0\\end{aligned}],[\\begin{aligned}\\frac{1}{\\sqrt{6}} \\\\ \\frac{2}{\\sqrt{6}} \\\\ \\frac{1}{\\sqrt{6}}\\end{aligned}],[\\begin{aligned}\\frac{1}{\\sqrt{30}} \\\\ \\frac{2}{\\sqrt{30}} \\\\ -\\frac{5}{\\sqrt{30}}\\end{aligned}]},\\,x=[\\begin{aligned}4 \\\\ 5 \\\\ -8\\end{aligned}]\n$$" :question/worked-solution "Let's denote the vectors of $B$ as ${q}_{1},\\,{q}_{2},\\,{q}_{3}.$ \n\nSince $B$ is an orthonormal basis, we have that $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]$, where ${x}_{i}=x\\cdot {q}_{i}.$ Computing ${x}_{2},$ we obtain\n\n$$\n\\begin{aligned}{x}_{2} & =x\\cdot {q}_{2} \\\\  & =[\\begin{aligned}4 \\\\ 5 \\\\ -8\\end{aligned}]\\cdot [\\begin{aligned}\\frac{1}{\\sqrt{6}} \\\\ \\frac{2}{\\sqrt{6}} \\\\ \\frac{1}{\\sqrt{6}}\\end{aligned}] \\\\  & =\\frac{4}{\\sqrt{6}}+\\frac{10}{\\sqrt{6}}-\\frac{8}{\\sqrt{6}} \\\\  & =\\frac{6}{\\sqrt{6}} \\\\  & =\\sqrt{6}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\sqrt{6}{x}_{2}=\\sqrt{6}\\cdot \\sqrt{6}=6.\n$$"}]}
