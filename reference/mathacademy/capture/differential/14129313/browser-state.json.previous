 0.8em 0.3em\"><mtr><mtd><msub><mi>f</mi><mi>X</mi></msub><mo stretchy=\"false\">(</mo><mn>3</mn><mo stretchy=\"false\">)</mo></mtd><mtd><mi></mi><mo>=</mo><mi>f</mi><mo stretchy=\"false\">(</mo><mn>3</mn><mo>,</mo><mn>0</mn><mo stretchy=\"false\">)</mo><mo>+</mo><mi>f</mi><mo stretchy=\"false\">(</mo><mn>3</mn><mo>,</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mo>+</mo><mi>f</mi><mo stretchy=\"false\">(</mo><mn>3</mn><mo>,</mo><mn>2</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>0.2</mn><mo>+</mo><mn>0.1</mn><mo>+</mo><mn>0.05</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>0.35</mn><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
