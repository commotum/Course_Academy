  "live_records": {
    "q-143399": {
      "dom_id": "step-q143399",
      "name": "Question 1",
      "problem": "If ${X}_{1},{X}_{2},…,{X}_{30}$ is a sample of size $n=30$ drawn from a population with mean $\\mu =-5$ and variance ${\\sigma }^{2}=9,$ calculate the value of $\\text{Var}[\\overset{―}{X}].$",
      "worked_solution": "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ from a population with population mean $\\mu $ and population variance ${\\sigma }^{2},$ then\n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu ,\\,\\text{Var}[\\overset{―}{X}]=\\frac{{\\sigma }^{2}}{n}.\n$$\n\nSince the population variance ${\\sigma }^{2}=9$ and the sample size $n=30,$ we have that \n\n$$\n\\begin{aligned}\\text{Var}[\\overset{―}{X}] & =\\frac{9}{30} \\\\  & =\\frac{3}{10} \\\\  & =0.3.\\end{aligned}\n$$",
      "calculator_instructions": "",
