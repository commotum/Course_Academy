/validate]} {:db/id "answer-field-95ece8c6-b709-55fd-aec1-dac8fa69933c" :answer-field/id #uuid "95ece8c6-b709-55fd-aec1-dac8fa69933c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0817bb7f-129c-5da6-94a6-8a21129fe1ab" :answer-field/choices ["answer-0817bb7f-129c-5da6-94a6-8a21129fe1ab" "answer-cf72bf32-c5fb-5035-9bac-6d90253affbf" "answer-f788c75b-6288-5270-a9e5-f4402ccef1cd" "answer-f8ea8bce-5714-5cd0-ba22-01b51246f8bd" "answer-615089ef-def0-59e6-8785-6915380e3305"] :db/ensure [:answer-field/validate]} {:db/id "answer-0817bb7f-129c-5da6-94a6-8a21129fe1ab" :answer/id #uuid "0817bb7f-129c-5da6-94a6-8a21129fe1ab" :answer/type :answer.type/math :answer/value "0.25" :db/ensure [:answer/validate]} {:db/id "answer-cf72bf32-c5fb-5035-9bac-6d90253affbf" :answer/id #uuid "cf72bf32-c5fb-5035-9bac-6d90253affbf" :answer/type :answer.type/math :answer/value "0.5" :db/ensure [:answer/validate]} {:db/id "answer-f788c75b-6288-5270-a9e5-f4402ccef1cd" :answer/id #uuid "f788c75b-6288-5270-a9e5-f4402ccef1cd" :answer/type :answer.type/math :answer/value "1.6" :db/ensure [:answer/validate]} {:db/id "answer-f8ea8bce-5714-5cd0-ba22-01b51246f8bd" :answer/id #uuid "f8ea8bce-5714-5cd0-ba22-01b51246f8bd" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "answer-615089ef-def0-59e6-8785-6915380e3305" :answer/id #uuid "615089ef-def0-59e6-8785-6915380e3305" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "question-a4ffdafd-ca0f-5aeb-9afa-3ab07c6f0225" :question/id #uuid "a4ffdafd-ca0f-5aeb-9afa-3ab07c6f0225" :question/math-academy-id "q-143426" :question/problem "If ${X}_{1},{X}_{2},…,{X}_{1000}$ is a sample of size $n=1\\,000$ drawn from a population with mean $\\mu =150$ and variance ${\\sigma }^{2}=25,$ calculate the standard error of $\\overset{―}{X}.$ Round your answer to two decimal places." :question/worked-solution "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ from a population with population mean $\\mu $ and population variance ${\\sigma }^{2},$ then\n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu ,\\,\\text{Var}[\\overset{―}{X}]=\\frac{{\\sigma }^{2}}{n},\n$$\n\nand the standard error is given by\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{\\text{Var}[\\overset{―}{X}]}=\\frac{\\sigma }{\\sqrt{n}}.\n$$\n\nSince the population variance is ${\\sigma }^{2}=25$ and the sample size is $n=1\\,000,$ we have that \n\n$$\n\\begin{aligned}\\text{Var}[\\overset{―}{X}] & =\\frac{25}{1\\,000} \\\\  & =0.025.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{0.025}≈0.16.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f0bec69d-d68a-518d-bb91-2fd951e08467"] :db/ensure [:question/validate]} {:db/id "answer-field-f0bec69d-d68a-518d-bb91-2fd951e08467" :answer-field/id #uuid "f0bec69d-d68a-518d-bb91-2fd951e08467" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f7609979-80a6-5ca8-82ec-72fc4cf0ed29" :answer-field/choices ["answer-5fffa88a-ab60-5e5a-ae9d-85cd50c46069" "answer-3ef092e1-14dd-5d66-a852-0395cd09a641" "answer-f7609979-80a6-5ca8-82ec-72fc4cf0ed29" "answer-39a9b6f2-d460-516e-a343-dad430e857a8" "answer-36470539-f464-546f-ba73-6270b016995f"] :db/ensure [:answer-field/validate]} {:db/id "answer-5fffa88a-ab60-5e5a-ae9d-85cd50c46069" :answer/id #uuid "5fffa88a-ab60-5e5a-ae9d-85cd50c46069" :answer/type :answer.type/math :answer/value "0.03" :db/ensure [:answer/validate]} {:db/id "answer-3ef092e1-14dd-5d66-a852-0395cd09a641" :answer/id #uuid "3ef092e1-14dd-5d66-a852-0395cd09a641" :answer/type :answer.type/math :answer/value "0.14" :db/ensure [:answer/validate]} {:db/id "answer-f7609979-80a6-5ca8-82ec-72fc4cf0ed29" :answer/id #uuid "f7609979-80a6-5ca8-82ec-72fc4cf0ed29" :answer/type :answer.type/math :answer/value "0.16" :db/ensure [:answer/validate]} {:db/id "answer-39a9b6f2-d460-516e-a343-dad430e857a8" :answer/id #uuid "39a9b6f2-d460-516e-a343-dad430e857a8" :answer/type :answer.type/math :answer/value "0.61" :db/ensure [:answer/validate]} {:db/id "answer-36470539-f464-546f-ba73-6270b016995f" :answer/id #uuid "36470539-f464-546f-ba73-6270b016995f" :answer/type :answer.type/math :answer/value "0.62" :db/ensure [:answer/validate]} {:db/id 17592186162383 :question/problem "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ drawn from a population with mean $\\mu =12$ and variance ${\\sigma }^{2}=16,$ determine the smallest sample size required so that the standard error of the mean is less than $0.1.$" :question/worked-solution "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ from a population with population mean $\\mu $ and population variance ${\\sigma }^{2},$ then\n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu ,\\,\\text{Var}[\\overset{―}{X}]=\\frac{{\\sigma }^{2}}{n},\n$$\n\nand the standard error is given by\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{\\text{Var}[\\overset{―}{X}]}=\\frac{\\sigma }{\\sqrt{n}}\n$$\n\nSince the population standard deviation is $\\sigma =\\sqrt{16}=4,$ we have that \n\n$$\n\\text{SE}[\\overset{―}{X}]=\\frac{4}{\\sqrt{n}}.\n$$\n\nWe require that the standard error is less than $0.1.$ Therefore\n\n$$\n\\begin{aligned}\\frac{4}{\\sqrt{n}} & <0.1 \\\\ \\sqrt{n} & >\\frac{4}{0.1} \\\\ \\sqrt{n} & >40 \\\\ n & >{40}^{2} \\\\ n & >1\\,600.\\end{aligned}\n$$\n\nTherefore, the smallest sample size is $n=1\\,601.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186159500 :answer-field/correct "answer-40b32199-db61-50a1-b590-f246ea88373a" :answer-field/choices ["answer-40b32199-db61-50a1-b590-f246ea88373a" "answer-0e26866e-c348-5c85-8477-d41e8ad68bcf"] :db/ensure [:answer-field/validate]} {:db/id "answer-40b32199-db61-50a1-b590-f246ea88373a" :answer/id #uuid "40b32199-db61-50a1-b590-f246ea88373a" :answer/type :answer.type/math :answer/value "1\\,601" :db/ensure [:answer/validate]} {:db/id "answer-0e26866e-