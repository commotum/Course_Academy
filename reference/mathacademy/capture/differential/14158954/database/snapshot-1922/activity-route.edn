#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186484344} :activity/id #uuid "f43dd96a-540d-5f5a-b773-e86347bdd398" :activity/scope {:db/id #edb/ref 17592186049786 :topic/id #uuid "13ff200a-f3dd-575f-8362-6dc70510c750" :topic/math-academy-id 2988} :activity/steps [{:db/id #edb/ref 17592186484305 :step/content {:db/id #edb/ref 17592186484276 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14743a6d-89dc-51f1-be5f-651e9f9685f3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{4}(\\operatorname{ln}⁡3-1)" :db/id #edb/ref 17592186483601} {:answer/id #uuid "b67a9aef-d76c-5bab-8625-14577b91fed1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{4}\\operatorname{ln}⁡3" :db/id #edb/ref 17592186483932} {:answer/id #uuid "b98a4eda-a7fb-5b36-a2ee-9c2bf3e3cb46" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{2}(\\operatorname{ln}⁡3-1)" :db/id #edb/ref 17592186483938} {:answer/id #uuid "c1f044e2-04da-5e9c-8032-d7a4b80cff3a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186483949} {:answer/id #uuid "c3c18450-3d1d-5233-9103-20c6853cd571" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{4}" :db/id #edb/ref 17592186483952}] :answer-field/correct {:db/id #edb/ref 17592186483601} :answer-field/id #uuid "b6f8a025-5440-5c77-830a-6386ff67bfed" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186484173}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ce424fe3-1289-5449-b3af-c9a36901436b" :question/math-academy-id "q-131166" :question/problem "The continuous random variable $X$ has the probability density function $f(x)$ stated below. Given that $\\text{E}[X]=\\frac{3}{2},$ compute $\\text{Var}[X].$\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{9}{4{x}^{3}},\\, & 1<x<3, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the variance using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\n \n\nWe compute $\\text{E}[{X}^{2}],$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{S}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{3}{x}^{2}\\cdot \\frac{9}{4{x}^{3}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{3}\\frac{9}{4x}\\,\\text{d}x \\\\  & ={\\frac{9}{4}\\cdot \\operatorname{ln}⁡x|}_{1}^{3} \\\\  & =\\frac{9\\operatorname{ln}⁡3}{4}\\end{aligned}\n$$\n\nTherefore, the variance is given by\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{9\\operatorname{ln}⁡3}{4}-{(\\frac{3}{2})}^{2} \\\\  & =\\frac{9\\operatorname{ln}⁡3}{4}-\\frac{9}{4} \\\\  & =\\frac{9}{4}(\\operatorname{ln}⁡3-1).\\end{aligned}\n$$"} :step/id #uuid "0ecc0901-9e15-5cf0-8e30-1547d76a2b8f" :step/next {:db/id #edb/ref 17592186484324}} {:db/id #edb/ref 17592186484324 :step/content {:db/id #edb/ref 17592186484272 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c298589-687a-53b7-a2f6-711c8b3fc022" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186483641} {:answer/id #uuid "3ed8eee1-36f5-552c-b95f-65eb970a734a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{49}{64}" :db/id #edb/ref 17592186483685} {:answer/id #uuid "59e03d02-257a-5ba6-b196-538b39c66509" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{63}{64}" :db/id #edb/ref 17592186483734} {:answer/id #uuid "b279e53b-ef58-5c32-bfc7-abaacf3a829d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{8}" :db/id #edb/ref 17592186483923} {:answer/id #uuid "c5398c5f-3701-531a-9962-9d86c1e50901" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{4}" :db/id #edb/ref 17592186483957}] :answer-field/correct {:db/id #edb/ref 17592186483734} :answer-field/id #uuid "cc39d208-b352-55e6-ab15-3fec98ea96ed" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186484178}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c369ac76-b620-5984-a1bf-927bb5bda8e4" :question/math-academy-id "q-131261" :question/problem "The continuous random variable $X$ has the probability density function $f(x)$ stated below. Given that $\\text{E}[X]=\\frac{7}{8},$ compute $\\text{Var}[X].$ \n\n$$\nf(x)=\\{\\begin{aligned}\\frac{3}{4}, & 0<x<1 \\\\ \\frac{3(x-1)}{{x}^{5}},\\, & x\\ge 1 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the variance using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\n \n\nWe compute $\\text{E}[{X}^{2}],$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{0}^{\\infty }{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{x}^{2}\\cdot f(x)\\,\\text{d}x+{\\int }_{1}^{\\infty }{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{x}^{2}\\cdot \\frac{3}{4}\\,\\text{d}x+{\\int }_{1}^{\\infty }{x}^{2}\\cdot \\frac{3(x-1)}{{x}^{5}}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{3{x}^{2}}{4}\\,\\text{d}x+{\\int }_{1}^{\\infty }\\frac{3x-3}{{x}^{3}}\\,\\text{d}x \\\\  & ={\\frac{{x}^{3}}{4}|}_{0}^{1}+(-\\frac{3}{x}+\\frac{3}{2{x}^{2}}){|}_{1}^{\\infty } \\\\  & =\\frac{1}{4}+3-\\frac{3}{2} \\\\  & =\\frac{7}{4}\\end{aligned}\n$$\n\n \n\nTherefore, the variance is given by\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{7}{4}-{(\\frac{7}{8})}^{2} \\\\  & =\\frac{63}{64}.\\end{aligned}\n$$"} :step/id #uuid "5bca35c4-d7e1-599c-85b9-815775171cde"} {:db/id #edb/ref 17592186484338 :step/content {:db/id #edb/ref 17592186484240 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "206cf90d-4f29-55ab-9819-01d8ca172f38" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.74" :db/id #edb/ref 17592186483619} {:answer/id #uuid "3f9e2311-3d05-5655-aec5-752bdfbf86b6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.89" :db/id #edb/ref 17592186483687} {:answer/id #uuid "7099a365-62d4-5172-aafe-41927474df4f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5.50" :db/id #edb/ref 17592186483788} {:answer/id #uuid "cdf20927-1bb6-5558-9a95-f586e071ff7e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2.11" :db/id #edb/ref 17592186483980} {:answer/id #uuid "db3da4ad-81ab-5111-a66e-0ed1cd8ee204" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "30.25" :db/id #edb/ref 17592186484003}] :answer-field/correct {:db/id #edb/ref 17592186483687} :answer-field/id #uuid "ee0bda9f-4431-5acd-981b-83f88e146a0f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186484187}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7ae79777-cfeb-50b2-91fa-571641f41141" :question/math-academy-id "q-90564" :question/problem "The continuous random variable $X$ has the probability density function $f(x)$ stated below. Given that $\\text{E}[X]=1.9,$ compute $\\text{Var}[X].$ Round your answer to $2$ decimal places.\n\n$$\nf(x)=\\{\\begin{aligned}2{x}^{3}, & 0<x<1, \\\\ \\frac{1}{8}, & 1\\le x<5, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the variance using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\n \n\nWe compute $\\text{E}[{X}^{2}],$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{0}^{5}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{x}^{2}\\cdot f(x)\\,\\text{d}x+{\\int }_{1}^{5}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{x}^{2}\\cdot 2{x}^{3}\\,\\text{d}x+{\\int }_{1}^{5}{x}^{2}\\cdot \\frac{1}{8}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}2{x}^{5}\\,\\text{d}x+{\\int }_{1}^{5}\\frac{{x}^{2}}{8}\\,\\text{d}x \\\\  & ={\\frac{{x}^{6}}{3}|}_{0}^{1}+{\\frac{{x}^{3}}{24}|}_{1}^{5} \\\\  & =5.5\\end{aligned}\n$$\n\n \n\nTherefore, the variance is given by\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =5.5-{(1.9)}^{2} \\\\  & =1.89.\\end{aligned}\n$$"} :step/id #uuid "aad7aa7a-b7fb-509a-8115-548c42717537" :step/next {:db/id #edb/ref 17592186484355}} {:db/id #edb/ref 17592186484344 :step/content {:db/id #edb/ref 17592186484200 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "708884fe-c46f-510c-8336-9b1ff8d57dd7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{18}" :db/id #edb/ref 17592186483787} {:answer/id #uuid "916cf1d3-9858-5e7a-bde5-ef0c01dfa40b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{43}{6}" :db/id #edb/ref 17592186483869} {:answer/id #uuid "cc7730f4-2296-5da8-a7ec-104cd0811268" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{4}" :db/id #edb/ref 17592186483977} {:answer/id #uuid "de0ca903-22de-5647-90cb-d355eba5356b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8}{3}" :db/id #edb/ref 17592186484008} {:answer/id #uuid "f2bedab4-4484-581e-8c7f-86e59afba6ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{16}" :db/id #edb/ref 17592186484054}] :answer-field/correct {:db/id #edb/ref 17592186483787} :answer-field/id #uuid "f9a9aeae-7475-58db-b6eb-574c342ffd6f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186484189}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "126e0a3b-1df5-561d-b629-66be47834dfa" :question/math-academy-id "q-90529" :question/problem "Given that $X$ is a continuous random variable with the following probability density function, compute $\\text{Var}[X].$ \n\n$$\nf(x)=\\{\\begin{aligned}2x-4,\\, & 2\\le x\\le 3, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the variance using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\n \n\nFirst, we compute $\\text{E}[X]:$\n\n$$\n\\begin{aligned}\\text{E}[X] & ={\\int }_{2}^{3}x\\cdot (2x-4)\\,\\text{d}x \\\\  & ={\\int }_{2}^{3}(2{x}^{2}-4x)\\,\\text{d}x \\\\  & ={(\\frac{2{x}^{3}}{3}-2{x}^{2})|}_{2}^{3} \\\\  & =\\frac{8}{3}\\end{aligned}\n$$\n\n \n\nThen, we compute $\\text{E}[{X}^{2}]:$\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{2}^{3}{x}^{2}\\cdot (2x-4)\\,\\text{d}x \\\\  & ={\\int }_{2}^{3}(2{x}^{3}-4{x}^{2})\\,\\text{d}x \\\\  & ={(\\frac{{x}^{4}}{2}-\\frac{4{x}^{3}}{3})|}_{2}^{3} \\\\  & =\\frac{43}{6}\\end{aligned}\n$$\n\n \n\nTherefore, the variance is given by\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{43}{6}-{(\\frac{8}{3})}^{2} \\\\  & =\\frac{1}{18}.\\end{aligned}\n$$"} :step/id #uuid "b7f49b20-6bd7-50d7-9326-47e7905139df" :step/next {:db/id #edb/ref 17592186484338}} {:db/id #edb/ref 17592186484355 :step/content {:db/id #edb/ref 17592186484298 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b2b313e-b6a7-568c-a875-f9db4ce39dcb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16" :db/id #edb/ref 17592186483639} {:answer/id #uuid "325fa17b-54bd-5aa0-9e67-721dd15642fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186483656} {:answer/id #uuid "5a881950-5b53-5733-8066-0e2b41f6af6d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{39}{2}" :db/id #edb/ref 17592186483738} {:answer/id #uuid "6d4e985e-cf6f-56bf-aaa1-935086b1d3e4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "39" :db/id #edb/ref 17592186483781} {:answer/id #uuid "f1f6ae5c-8838-54ee-bde6-979554af985b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{31}{2}" :db/id #edb/ref 17592186484050}] :answer-field/correct {:db/id #edb/ref 17592186483656} :answer-field/id #uuid "f6082ae9-a37f-5a6d-98af-d4b226bb7c29" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186484188}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "fe9a9f2d-c658-56d3-a233-bcc579aed36f" :question/math-academy-id "q-107779" :question/problem "The continuous random variable $X$ has the probability density function $f(x)$ stated below. Given that $\\text{E}[X]=4$ compute $\\text{Var}[X].$ \n\n$$\nf(x)=\\{\\begin{aligned}\\frac{2x}{27}, & 0<x<3, \\\\ \\frac{9-x}{27}, & 3\\le x<9, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the variance using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\n \n\nWe compute $\\text{E}[{X}^{2}],$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{0}^{9}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{3}{x}^{2}\\cdot f(x)\\,\\text{d}x+{\\int }_{3}^{9}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{3}{x}^{2}\\cdot \\frac{2x}{27}\\,\\text{d}x+{\\int }_{3}^{9}{x}^{2}\\cdot \\frac{1}{27}(9-x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{3}\\frac{2{x}^{3}}{27}\\,\\text{d}x+{\\int }_{3}^{9}\\frac{1}{27}(9{x}^{2}-{x}^{3})\\,\\text{d}x \\\\  & ={\\frac{{x}^{4}}{54}|}_{0}^{3}+{\\frac{1}{27}(3{x}^{3}-\\frac{{x}^{4}}{4})|}_{3}^{9} \\\\  & =\\frac{3}{2}+\\frac{81}{4}-\\frac{9}{4} \\\\  & =\\frac{39}{2}\\end{aligned}\n$$\n\n \n\nTherefore, the variance is given by\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{39}{2}-{4}^{2} \\\\  & =\\frac{7}{2}.\\end{aligned}\n$$"} :step/id #uuid "dc4fe466-4de3-5c80-8ce7-3c36ce3f07df" :step/next {:db/id #edb/ref 17592186484305}}] :activity/title "Variance of Continuous Random Variables" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186483565}]}
