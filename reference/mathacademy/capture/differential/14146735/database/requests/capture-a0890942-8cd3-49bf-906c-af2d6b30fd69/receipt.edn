6045493 13194139534882 17592186045417 true] [17592186442475 1077 "selection" 13194139534882 17592186045417 true] [17592186442475 1078 #edb/ref 17592186442460 13194139534882 17592186045417 true] [17592186442475 1079 #uuid "e30a14d3-7c0e-5fdd-bd22-94759a75c19a" 13194139534882 17592186045417 true] [17592186442476 1075 #edb/ref 17592186442445 13194139534882 17592186045417 true] [17592186442476 1075 #edb/ref 17592186442447 13194139534882 17592186045417 true] [17592186442476 1075 #edb/ref 17592186442453 13194139534882 17592186045417 true] [17592186442476 1075 #edb/ref 17592186442461 13194139534882 17592186045417 true] [17592186442476 1075 #edb/ref 17592186442466 13194139534882 17592186045417 true] [17592186442476 1076 #edb/ref 17592186045493 13194139534882 17592186045417 true] [17592186442476 1077 "selection" 13194139534882 17592186045417 true] [17592186442476 1078 #edb/ref 17592186442447 13194139534882 17592186045417 true] [17592186442476 1079 #uuid "f0a1bbcd-9f99-5ffd-9c62-c5d07cca7e90" 13194139534882 17592186045417 true] [17592186442477 1068 #edb/ref 17592186442474 13194139534882 17592186045417 true] [17592186442477 1069 "q-73556" 13194139534882 17592186045417 true] [17592186442477 1070 #edb/ref 17592186045485 13194139534882 17592186045417 true] [17592186442477 1071 "Evaluate the repeated integral ${\\int }_{2}^{4}{\\int }_{0}^{1/2}3y{e}^{4x}\\,\\text{d}x\\,\\text{d}y.$" 13194139534882 17592186045417 true] [17592186442477 1072 #uuid "2c3b5fdf-e81f-5835-8ccd-060ca0cabad4" 13194139534882 17592186045417 true] [17592186442477 1074 "First, we evaluate the inner integral by integrating with respect to $x$, treating $y$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{2}^{4}[{\\int }_{0}^{1/2}3y{e}^{4x}\\,\\text{d}x]\\text{d}y & ={\\int }_{2}^{4}3y[{\\int }_{0}^{1/2}{e}^{4x}\\,\\text{d}x]\\text{d}y \\\\  & ={\\int }_{2}^{4}3y{[\\frac{{e}^{4x}}{4}]}_{0}^{1/2}\\,\\text{d}y \\\\  & ={\\int }_{2}^{4}3y(\\frac{{e}^{2}}{4}-\\frac{{e}^{0}}{4})\\text{d}y \\\\  & ={\\int }_{2}^{4}\\frac{3}{4}y({e}^{2}-1)\\,\\text{d}y\\end{aligned}\n$$\n\nThen, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}{\\int }_{2}^{4}\\frac{3}{4}y({e}^{2}-1)\\,\\text{d}y & =\\frac{3}{4}({e}^{2}-1){\\int }_{2}^{4}y\\,\\text{d}y \\\\  & ={[\\frac{3}{4}({e}^{2}-1)\\frac{{y}^{2}}{2}]}_{2}^{4} \\\\  & =\\frac{3}{4}({e}^{2}-1)(\\frac{{4}^{2}}{2}-\\frac{{2}^{2}}{2}) \\\\  & =\\frac{9}{2}({e}^{2}-1)\\end{aligned}\n$$" 13194139534882 17592186045417 true] [17592186442478 1068 #edb/ref 17592186442473 13194139534882 17592186045417 true] [17592186442478 1069 "q-72176" 13194139534882 17592186045417 true] [17592186442478 1070 #edb/ref 17592186045485 13194139534882 17592186045417 true] [17592186442478 1071 "Which of the following equalities are true given that\n$D=\\{(x,y)\\,:\\,0\\le x\\le \\frac{1}{2},\\,0\\le y\\le \\frac{1}{4}\\}.$\n\nI. ${∬}_{D}xy\\sqrt{x+y}\\,\\text{d}A={\\int }_{0}^{1/2}{\\int }_{0}^{1/4}xy\\sqrt{x+y}\\,\\text{d}x\\,\\text{d}y$\n\nII. ${∬}_{D}xy\\sqrt{x+y}\\,\\text{d}A={\\int }_{0}^{1/4}{\\int }_{0}^{1/2}xy\\sqrt{x+y}\\,\\text{d}y\\,\\text{d}x$\n\nIII. ${∬}_{D}xy\\sqrt{x+y}\\,\\text{d}A={\\int }_{0}^{1/4}{\\int }_{0}^{1/2}xy\\sqrt{x+y}\\,\\text{d}x\\,\\text{d}y$" 13194139534882 17592186045417 true] [17592186442478 1072 #uuid "5334bf5b-4c65-5a0d-a9f7-2b79a628b6c8" 13194139534882 17592186045417 true] [17592186442478 1074 "We notice that:    \n\n- the limits for the variable $x$ are from $0$ to $\\frac{1}{2}$, and\n\n- the limits for the variable $y$ are from $0$ to $\\frac{1}{4}.$\n\nTherefore,\n\n$$\n\\begin{aligned}{∬}_{D}xy\\sqrt{x+y}\\,\\text{d}A & ={\\int }_{0}^{1/4}[{\\int }_{0}^{1/2}xy\\sqrt{x+y}\\,\\text{d}x]\\text{d}y.\\end{aligned}\n$$\n\nNow, since the region of integration is rectangular, we can also swap the order of integration. This gives \n\n$$\n{∬}_{D}xy\\sqrt{x+y}\\,\\text{d}A={\\int }_{0}^{1/2}[{\\int }_{0}^{1/4}xy\\sqrt{x+y}\\,\\text{d}y]\\text{d}x.\n$$\n\nSo, the correct answer is \"III only\"." 13194139534882 17592186045417 true] [17592186442479 1068 #edb/ref 17592186442471 13194139534882 17592186045417 true] [17592186442479 1069 "q-129548" 13194139534882 17592186045417 true] [17592186442479 1070 #edb/ref 17592186045485 13194139534882 17592186045417 true] [17592186442479 1071 "${\\int }_{1}^{e}{\\int }_{0}^{\\pi /4}\\frac{1}{y{cos}^{2}⁡x}\\,\\text{d}x\\,\\text{d}y=$" 13194139534882 17592186045417 true] [17592186442479 1072 #uuid "537e39b9-c554-5e1b-a6dd-8e198218680c" 13194139534882 17592186045417 true] [17592186442479 1074 "First, we evaluate the inner integral by integrating with respect to $x$, treating $y$ as a constant: \n\n$$\n\\begin{aligned}{\\int }_{1}^{e}[{\\int }_{0}^{\\pi /4}\\frac{1}{y{cos}^{2}⁡x}\\,\\text{d}x]\\text{d}y & ={\\int }_{1}^{e}\\frac{1}{y}[{\\int }_{0}^{\\pi /4}\\frac{1}{{cos}^{2}⁡x}\\,\\text{d}x]\\text{d}y \\\\  & ={\\int }_{1}^{e}\\frac{1}{y}[{\\int }_{0}^{\\pi /4}{sec}^{2}⁡x\\,\\text{d}x]\\text{d}y \\\\  & ={\\int }_{1}^{e}\\frac{1}{y}[\\operatorname{tan}⁡x]_{0}^{\\pi /4}\\,\\text{d}y \\\\  & ={\\int }_{1}^{e}\\frac{1}{y}(\\operatorname{tan}⁡(\\frac{\\pi }{4})-\\operatorname{tan}⁡0)\\,\\text{d}y \\\\  & ={\\int }_{1}^{e}\\frac{1}{y}\\,\\text{d}y\\end{aligned}\n$$\n\n \n\nThen, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}{\\int }_{1}^{e}\\frac{1}{y}\\,\\text{d}y & =\\operatorname{ln}⁡|y|{|}_{1}^{e} \\\\  & =\\operatorname{ln}⁡e-\\operatorname{ln}⁡1 \\\\  & =1-0 \\\\  & =1\\end{aligned}\n$$" 13194139534882 17592186045417 true] [17592186442480 1068 #edb/ref 17592186442475 13194139534882 17592186045417 true] [17592186442480 1069 "q-37925" 13194139534882 17592186045417 true] [17592186442480 1070 #edb/ref 17592186045487 13194139534882 17592186045417 true] [17592186442480 1071 "${\\int }_{1}^{2}{\\int }_{1}^{2}{e}^{x+y}\\,\\text{d}x\\,\\text{d}y=$" 13194139534882 17592186045417 true] [17592186442480 1072 #uuid "59328584-c57e-5239-919a-177255c910ca" 13194139534882 17592186045417 true] [17592186442480 1074 "First, we evaluate the inner integral by integrating with respect to $x$, treating $y$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}[{\\int }_{1}^{2}{e}^{x+y}\\,\\text{d}x]\\text{d}y & ={\\int }_{1}^{2}[{e}^{x+y}]_{1}^{2}\\,\\text{d}y \\\\  & ={\\int }_{1}^{2}({e}^{y+2}-{e}^{y+1})\\text{d}y\\end{aligned}\n$$\n\nThen, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}({e}^{y+2}-{e}^{y+1})\\text{d}y & =[{e}^{y+2}-{e}^{y+1}]_{1}^{2} \\\\  & ={e}^{4}-{e}^{3}-({e}^{3}-{e}^{2}) \\\\  & ={e}^{4}-2{e}^{3}+{e}^{2}\\end{aligned}\n$$" 13194139534882 17592186045417 true] [17592186442481 1068 #edb/ref 17592186442472 13194139534882 17592186045417 true] [17592186442481 1069 "q-73595" 13194139534882 17592186045417 true] [17592186442481 1070 #edb/ref 17592186045485 13194139534882 17592186045417 true] [17592186442481 1071 "Evaluate the double integral ${∬}_{D}\\frac{2x}{{y}^{4}}\\,\\text{d}A,$ where $D=\\{(x,y)\\,:\\,2\\le x\\le 4,\\,1\\le y\\le 2\\}.$" 13194139534882 17592186045417 true] [17592186442481 1072 #uuid "5a0ea10f-00cc-5f1e-9234-e05424315508" 13194139534882 17592186045417 true] [17592186442481 1074 "First, we express our double integral as a repeated integral:      \n\n$$\n\\begin{aligned}{∬}_{D}\\frac{2x}{{y}^{4}}\\,\\text{d}A & ={\\int }_{1}^{2}[{\\int }_{2}^{4}\\frac{2x}{{y}^{4}}\\,\\text{d}x]\\text{d}y\\end{aligned}\n$$\n\nNow, we evaluate the inner integral by integrating with respect to $x$, treating $y$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}[{\\int }_{2}^{4}\\frac{2x}{{y}^{4}}\\,\\text{d}x]\\text{d}y & ={\\int }_{1}^{2}\\frac{2}{{y}^{4}}[{\\int }_{2}^{4}x\\,\\text{d}x]\\text{d}y \\\\  & ={\\int }_{1}^{2}\\frac{2}{{y}^{4}}{[\\frac{{x}^{2}}{2}]}_{2}^{4}\\text{d}y \\\\  & ={\\int }_{1}^{2}\\frac{2}{{y}^{4}}(\\frac{{4}^{2}}{2}-\\frac{{2}^{2}}{2})\\,\\text{d}y \\\\  & ={\\int }_{1}^{2}\\frac{12}{{y}^{4}}\\,\\text{d}y\\end{aligned}\n$$\n\nFinally, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}\\frac{12}{{y}^{4}}\\,\\text{d}y & ={[-\\frac{4}{{y}^{3}}]}_{1}^{2} \\\\  & =-\\frac{4}{{2}^{3}}+\\frac{4}{{1}^{3}} \\\\  & =\\frac{7}{2}\\end{aligned}\n$$" 13194139534882 17592186045417 true] [17592186442482 1068 #edb/ref 17592186442476 13194139534882 17592186045417 true] [17592186442482 1069 "q-72136" 13194139534882 17592186045417 true] [17592186442482 1070 #edb/ref 17592186045485 13194139534882 17592186045417 true] [17592186442482 1071 "Which of the following equalities are true given that\n$D=\\{(x,y)\\,:\\,0\\le x\\le 2,\\,-1\\le y\\le 1\\}.$\n\nI. ${∬}_{D}\\frac{x-1}{y+2}\\,\\text{d}A={\\int }_{-1}^{1}{\\int }_{0}^{2}\\frac{x-1}{y+2}\\text{d}y\\,\\text{d}x$\n\nII. ${∬}_{D}\\frac{x-1}{y+2}\\,\\text{d}A={\\int }_{0}^{2}{\\int }_{-1}^{1}\\frac{x-1}{y+2}\\text{d}y\\,\\text{d}x$\n\nIII. ${∬}_{D}\\frac{x-1}{y+2}\\,\\text{d}A={\\int }_{0}^{2}{\\int }_{-1}^{1}\\frac{x-1}{y+2}\\text{d}x\\,\\text{d}y$" 13194139534882 17592186045417 true] [17592186442482 1072 #uuid "ec2c5b36-cc64-59b6-941f-e3ef54e2e8b8" 13194139534882 17592186045417 true] [17592186442482 1074 "We notice that:\n\n- the limits for the variable $x$ are from $0$ to $2$, and\n\n- the limits for the variable $y$ are from $-1$ to $1.$\n\nTherefore,\n\n$$\n\\begin{aligned}{∬}_{D}\\frac{x-1}{y+2}\\,\\text{d}A & ={\\int }_{-1}^{1}[{\\int }_{0}^{2}\\frac{x-1}{y+2}\\,\\text{d}x]\\text{d}y.\\end{aligned}\n$$\n\nNow, since the region of integration is rectangular, we can simply swap the order of integration. This gives\n\n$$\n{∬}_{D}\\frac{x-1}{y+2}\\,\\text{d}A={\\int }_{0}^{2}[{\\int }_{-1}^{1}\\frac{x-1}{y+2}\\,\\text{d}y]\\text{d}x.\n$$\n\nSo, the correct answer is \"II only\"." 13194139534882 17592186045417 true]] :edb/tempids {"answer-1c72710f-c2e6-5f98-9934-8c0e10db39f6" 17592186442441 "answer-1f8087da-0be9-5661-8053-ef364f6d08fe" 17592186442442 "answer-258eca96-5244-5ca3-b0df-8541f47f4e9b" 17592186442443 "answer-27ca5ad7-f8d3-561b-9a26-e9c7eb4baa19" 17592186442444 "answer-324de9dd-38ea-5337-bbde-d854373f1914" 17592186442445 "answer-32c82e63-0ba1-5dd4-b1eb-9bb571d4a5f9" 1759