yle=\"width: 0.167em;\"></mjx-mspace></mjx-mstyle><mjx-mtext class=\"mjx-n\"><mjx-c class=\"mjx-c64\"></mjx-c></mjx-mtext><mjx-texatom texclass=\"ORD\"><mjx-mstyle style=\"color: blue;\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D465 TEX-I\"></mjx-c></mjx-mi></mjx-mstyle></mjx-texatom><mjx-mo class=\"mjx-s4\"><mjx-c class=\"mjx-c5D TEX-S4\"></mjx-c></mjx-mo></mjx-mrow><mjx-mtext class=\"mjx-n\"><mjx-c class=\"mjx-c64\"></mjx-c></mjx-mtext><mjx-texatom texclass=\"ORD\"><mjx-mstyle style=\"color: red;\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D466 TEX-I\"></mjx-c></mjx-mi></mjx-mstyle></mjx-texatom><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mo><mjx-tstrut></mjx-tstrut></mjx-mtd></mjx-mtr></mjx-itable></mjx-table></mjx-mtable></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mtable displaystyle=\"true\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"3pt\"><mtr><mtd><munder><mo data-mjx-texclass=\"OP\">∬</mo><mrow data-mjx-texclass=\"ORD\"><mi>D</mi></mrow></munder><mi>x</mi><mi>y</mi><msqrt><mi>x</mi><mo>+</mo><mi>y</mi></msqrt><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>d</mtext><mi>A</mi></mtd><mtd><mi></mi><mo>=</mo><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"red\"><mn>0</mn></mstyle></mrow><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"red\"><mn>1</mn><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mn>4</mn></mstyle></mrow></msubsup><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">[</mo><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"blue\"><mn>0</mn></mstyle></mrow><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"blue\"><mn>1</mn><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mn>2</mn></mstyle></mrow></msubsup><mi>x</mi><mi>y</mi><msqrt><mi>x</mi><mo>+</mo><mi>y</mi></msqrt><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>d</mtext><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"blue\"><mi>x</mi></mstyle></mrow><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow><mtext>d</mtext><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"red\"><mi>y</mi></mstyle></mrow><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>Now, since the region of integration is rectangular, we can also swap the order of integration. This gives </p>\n<p><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" display=\"true\" tabindex=\"0\" ctxtmenu_counter=\"153\" style=\"font-size: 119.4%; position: relative;\"><mjx-math display=\"true\" class=\"MJX-TEX\" aria-hidden=\"true\" style=\"margin-left: 0px; margin-right: 0px;\"><mjx-munder><mjx-row><mjx-base><mjx-mo class=\"mjx-lop\"><mjx-c class=\"mjx-c222C TEX-S2\"></mjx-c></mjx-mo></mjx-base></mjx-row><mjx-row><mjx-under style=\"padding-top: 0.167em; padding-left: 0.152em;\"><mjx-texatom size=\"s\" texclass=\"ORD\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D437 TEX-I\"></mjx-c></mjx-mi></mjx-texatom></mjx-under></mjx-row></mjx-munder><mjx-mi class=\"mjx-i\" space=\"2\"><mjx-c class=\"mjx-c1D465 TEX-I\"></mjx-c></mjx-mi><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D466 TEX-I\"></mjx-c></mjx-mi><mjx-msqrt><mjx-sqrt><mjx-surd><mjx-mo class=\"mjx-sop\"><mjx-c class=\"mjx-c221A TEX-S1\"></mjx-c></mjx-mo></mjx-surd><mjx-box style=\"padding-top: 0.261em;\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D465 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c2B\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-i\" space=\"3\"><mjx-c class=\"mjx-c1D466 TEX-I\"></mjx-c></mjx-mi></mjx-box></mjx-sqrt></mjx-msqrt><mjx-mstyle><mjx-mspace style=\"width: 0.167em;\"></mjx-mspace></mjx-mstyle><mjx-mtext class=\"mjx-n\"><mjx-c class=\"mjx-c64\"></mjx-c></mjx-mtext><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D434 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=