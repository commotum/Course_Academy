ac><mrow><mo stretchy=\"false\">|</mo><mo>−</mo><mn>3</mn><mo>+</mo><mn>12</mn><mo>+</mo><mn>12</mn><mo stretchy=\"false\">|</mo></mrow><msqrt><mn>9</mn><mo>+</mo><mn>36</mn><mo>+</mo><mn>4</mn></msqrt></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mo stretchy=\"false\">|</mo><mn>21</mn><mo stretchy=\"false\">|</mo></mrow><msqrt><mn>49</mn></msqrt></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>21</mn><mn>7</mn></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>3.</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
