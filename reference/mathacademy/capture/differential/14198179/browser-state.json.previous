alse\">(</mo><mn>0.3</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mrow data-mjx-texclass=\"ORD\"><mphantom><mo>=</mo></mphantom></mrow><mo>+</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mn>0.6</mn><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><mn>0.7</mn><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><mn>0.1</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mrow data-mjx-texclass=\"ORD\"><mphantom><mo>=</mo></mphantom></mrow><mo>+</mo><mo stretchy=\"false\">(</mo><mn>0.4</mn><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mn>0.3</mn><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><mn>0.4</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mrow data-mjx-texclass=\"ORD\"><mphantom><mo>=</mo></mphantom></mrow><mo>+</mo><mo stretchy=\"false\">(</mo><mn>0.4</mn><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><mn>0.7</mn><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><mn>0.2</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>0.02</mn><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
