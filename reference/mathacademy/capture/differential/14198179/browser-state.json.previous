m></mrow><mo>+</mo><mo stretchy=\"false\">(</mo><mn>3</mn><mo>−</mo><mn>2</mn><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><mn>2</mn><mo>−</mo><mn>2.6</mn><mo stretchy=\"false\">)</mo><mi>f</mi><mo stretchy=\"false\">(</mo><mn>3</mn><mo>,</mo><mn>2</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mrow data-mjx-texclass=\"ORD\"><mphantom><mo>=</mo></mphantom></mrow><mo>+</mo><mo stretchy=\"false\">(</mo><mn>3</mn><mo>−</mo><mn>2</mn><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><mn>4</mn><mo>−</mo><mn>2.6</mn><mo stretchy=\"false\">)</mo><mi>f</mi><mo stretchy=\"false\">(</mo><mn>3</mn><mo>,</mo><mn>4</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mn>0.6</mn><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><mn>0.5</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mrow data-mjx-texclass=\"ORD\"><mphantom><mo>=</mo></mphantom></mrow><mo>+</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><mn>1.4</mn><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><mn>0</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mrow data-mjx-texclass=\"ORD\"><mphantom><mo>=</mo></mphantom></mrow><mo>+</mo><mo stretchy=\"false\">(</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mn>0.6</mn><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><mn>0.2</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mrow data-mjx-texclass=\"ORD\"><mphantom><mo>=</mo></mphantom></mrow><mo>+</mo><mo stretchy=\"false\">(</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><mn>1.4</mn><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><mn>0.3</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><m