">]</mo><mo>⋅</mo><mtext>E</mtext><mo stretchy=\"false\">[</mo><mi>Y</mi><mo stretchy=\"false\">]</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>2.3</mn><mo>−</mo><mo stretchy=\"false\">(</mo><mn>1.3</mn><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><mn>1.9</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mn>0.17</mn><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
