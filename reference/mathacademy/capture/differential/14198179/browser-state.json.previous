\">]</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>12.2</mn><mo>−</mo><mo stretchy=\"false\">(</mo><mn>3.2</mn><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><mn>3.8</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>0.04</mn><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
