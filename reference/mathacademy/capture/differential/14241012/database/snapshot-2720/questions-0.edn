uid "716d255d-da8a-543a-b7e5-474422b51ccf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ and $R$ only" :db/id #edb/ref 17592186559296} :answer-field/id #uuid "9bc23c46-3bd3-5315-a27d-9984de9363ff" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186559730}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4681538e-2de2-56f3-881c-562aebb342a4" :question/math-academy-id "q-174421" :question/problem "Which of the following are mathematical statements?\n\n- $P:\\{2,3,7\\}\\cap \\{3,5,6\\}=∅$\n\n- $Q:{\\pi }^{2}-\\pi $\n\n- $R:3$ is a prime number." :question/worked-solution "A mathematical statement is a sentence or mathematical expression that is either true or false.\n\nWith that in mind, let's examine the given options: \n\n- $P$ is a statement. This statement is *false* because the intersection of the given sets is the set $\\{3\\}.$\n\n- $Q$ is *not* a statement because it is neither true nor false.\n\n- $R$ is a statement. This statement is *true* since $3$ is indeed a prime number.\n\nTherefore, the correct answer is \"$P$ and $R$ only.\""}] [{:db/id #edb/ref 17592186559799 :knowledge-point/_questions [{:db/id #edb/ref 17592186054820 :knowledge-point/id #uuid "35eba041-5109-5855-b132-174c0271c168" :knowledge-point/title "Identifying Predicates"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01804a80-5ad0-5362-964c-9ececb6d064d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186559018} {:answer/id #uuid "3b8e51e4-40fa-57ba-90ff-180ebb919ccb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186559166} {:answer/id #uuid "725de94a-3ee8-5f32-b2e7-5e74ed4217f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186559301} {:answer/id #uuid "8405f8f8-e192-530e-9104-fc411cda42f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186559346} {:answer/id #uuid "dafd16df-e541-559b-bbe3-f28f607b45b9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186559555}] :answer-field/correct {:answer/id #uuid "dafd16df-e541-559b-bbe3-f28f607b45b9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186559555} :answer-field/id #uuid "99fd9b59-7583-550f-9b77-a9aef65a8d04" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186559729}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3bd80b9b-2655-5bf4-bdf9-f7428c6e7e13" :question/math-academy-id "q-175327" :question/problem "Which of the following are mathematical predicates of one variable?\n\nI. $z$ divided by $10.$\n\nII. $x\\times 3$\n\nIII. $y+3$ is an odd number." :question/worked-solution "A *predicate* of one variable is a sentence that contains the variable defined on some *universal set* and has the property that when we substitute any concrete value of the variable into the predicate, the result becomes a statement that is either true or false.\n\nWith that in mind, let's examine our options. \n\n- Option I is *not* a predicate. Substituting a concrete value for $z$ into the sentence, we do not get a statement that is either true or false.\n\n- Option II is *not* a predicate. Substituting a concrete value for $x$ into the sentence, we do not get a statement that is either true or false.\n\n- Option III is a predicate. Substituting a concrete value for $y$ into the sentence, we get a statement that is either true or false.\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186284735 :knowledge-point/_questions [{:db/id #edb/ref 17592186054820 :knowledge-point/id #uuid "35eba041-5109-5855-b132-174c0271c168" :knowledge-point/title "Identifying Predicates"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ceb5d96-2d44-54fc-8dcc-5572d37a3103" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465633} {:answer/id #uuid "288acd2a-a5b5-58e5-bf10-d8f42d8c37ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465634}] :answer-field/correct {:answer/id #uuid "4ceb5d96-2d44-54fc-8dcc-5572d37a3103" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465633} :answer-field/id #uuid "b3ee974f-92e2-533f-96f0-e2967c52b8fd" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466660} {:answer-field/choices [{:answer/id #uuid "847a3ab5-6fae-5c67-ab51-d34808e1986b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465635} {:answer/id #uuid "b3dce862-dc40-5247-92ef-2f347a340762" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465636}] :answer-field/correct {:answer/id #uuid "b3dce862-dc40-5247-92ef-2f347a340762" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465636} :answer-field/id #uuid "3bb991ad-9e28-5b98-abdc-b8aa360c9214" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466661} {:answer-field/choices [{:answer/id #uuid "7731a299-5478-5a71-93ed-7a3f702c2404" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465637} {:answer/id #uuid "f5750c7c-8f33-5f4c-b6fb-b77c5d95cd63" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465638}] :answer-field/correct {:answer/id #uuid "f5750c7c-8f33-5f4c-b6fb-b77c5d95cd63" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465638} :answer-field/id #uuid "77763d58-3c99-5c78-b4d0-2499457bbaf1" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466662}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "33aeb9a4-e17a-5f7f-8d45-99fe2421efca" :question/math-academy-id "q-175330" :question/problem "Which of the following are mathematical predicates of one variable?\n- **I.** The square root of $x.$\n- **II.** $y$ is a composite number.\n- **III.** $z+3$ is equal to $8.$\n\nSelect all that apply." :question/worked-solution "A *predicate* of one variable is a sentence that contains the variable defined on some *universal set* and has the property that when we substitute any concrete value of the variable into the predicate, the result becomes a statement that is either true or false.\n\nWith that in mind, let's examine our options. \n\n- Option I is *not* a predicate. Substituting a concrete value for $x$ into the sentence, we do not get a statement that is either true or false.\n\n- Option II is a predicate. Substituting a concrete value for $y$ into the sentence, we get a statement that is either true or false.\n\n- Option III is a predicate. Substituting a concrete value for $z$ into the sentence, we get a statement that is either true or false.\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186559884 :knowledge-point/_questions [{:db/id #edb/ref 17592186054820 :knowledge-point/id #uuid "35eba041-5109-5855-b132-174c0271c168" :knowledge-point/title "Identifying Predicates"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3df4871b-4533-56fb-bc7b-dd5a4905e0bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186559176} {:answer/id #uuid "baae5ccd-bb5f-5df3-b5b6-228fe5505245" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186559480} {:answer/id #uuid "ce19c34c-55f0-53bd-90d0-5654a556e400" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186559514} {:answer/id #uuid "d12f7ee4-e6d2-572c-bc6f-c2a4f216d210" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186559527} {:answer/id #uuid "e0274858-530a-5336-a244-3ab577098764" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186559570}] :answer-field/correct {:answer/id #uuid "e0274858-530a-5336-a244-3ab577098764" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186559570} :answer-field/id #uuid "dd1c7fcd-33d6-50f3-a903-c3e604c9e00d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186559755}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f4fa3c45-5e91-57f0-a165-1adda22fdfd5" :question/math-academy-id "q-175340" :question/problem "Which of the following are mathematical predicates of one variable?\n\nI. $P(n):$ ${n}^{2}$ is odd.\n\nII. $Q(x):$ $(x+2)|5$\n\nIII. $R(y):$ $y$ is a multiple of $4.$" :question/worked-solution "A *predicate* of one variable is a sentence that contains the variable defined on some *universal set* and has the property that when we substitute any concrete value of the variable into the predicate, the result becomes a statement that is either true or false.\n\nWith that in mind, let's examine our options. \n\n- Option I is a predicate. Substituting a concrete value for $n$ into the sentence, we get a statement that is either true or false.\n\n- Option II is a predicate. Substituting a concrete value for $x$ into the sentence, we get a statement that is either true or false.\n\n- Option III is a predicate. Substituting a concrete value for $y$ into the sentence, we get a statement that is either true or false.\n\nTherefore, the correct answer is \"I, II, and III.\""}] [{:db/id #edb/ref 17592186284737 :knowledge-point/_questions [{:db/id #edb/ref 17592186054820 :knowledge-point/id #uuid "35eba041-5109-5855-b132-174c0271c168" :knowledge-point/title "Identifying Predicates"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "deab7354-8d59-5651-963c-4faf3b669082" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465645} {:answer/id #uuid "73d28717-f191-5e1e-95bf-5af3698729dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465646}] :answer-field/correct {:answer/id #uuid "deab7354-8d59-5651-963c-4faf3b669082" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465645} :answer-field/id #uuid "decf0e43-3877-5a21-8037-cee318134af1" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466666} {:answer-field/choices [{:answer/id #uuid "a8d510c8-83d1-57f0-a77a-f71e8770f23d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465647} {:answer/id #uuid "edc1cedb-d499-5519-aca9-b2bcfa1986e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465648}] :answer-field/correct {:answer/id #uuid "a8d510c8-83d1-57f0-a77a-f71e8770f23d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465647} :answer-field/id #uuid "a70ef2cf-bda2-5211-b003-aaf9d169b70e" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466667} {:answer-field/choices [{:answer/id #uuid "41027071-b467-56de-b8ac-1199ad53c826" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465649} {:answer/id #uuid "c0df3aa7-4255-5a37-9fd4-accb8b711300" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465650}] :answer-field/correct {:answer/id #uuid "41027071-b467-56de-b8ac-1199ad53c826" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465649} :answer-field/id #uuid "4c201b7e-51e2-56f3-8cb0-77fd8337e314" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466668}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "388254b7-705e-581e-9708-313da2ad5c8e" :question/math-academy-id "q-175342" :question/problem "Which of the following are mathematical predicates of one variable?\n- **I.** $P(z):$ Subtract $8$ from $z.$\n- **II.** $Q(x):$ $x÷2$\n- **III.** $R(n):$ $\\sqrt{n}-\\sqrt{3}$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "A *predicate* of one variable is a sentence that contains the variable defined on some *universal set* and has the property that when we substitute any concrete value of the variable into the predicate, the result becomes a statement that is either true or false.\n\nWith that in mind, let's examine our options. \n\n- Option I is *not* a predicate. Substituting a concrete value for $z$ into the sentence, we do not get a statement that is either true or false. Rather, it will give an instruction.\n\n- Option II is *not* a predicate. Substituting a concrete value for $x$ into the sentence, we do not get a statement that is either true or false.\n\n- Option III is *not* a predicate. Substituting a concrete value for $n$ into the sentence, we do not get a statement that is either true or false.\n\nTherefore, the correct answer is \"None of the given statements.\""}] [{:db/id #edb/ref 17592186354472 :knowledge-point/_questions [{:db/id #edb/ref 17592186054818 :knowledge-point/id #uuid "228b0a63-bf0e-57bf-aa1e-ef5518236462" :knowledge-point/title "Identifying Mathematical Statements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5fa39ce5-4b78-55ec-9f01-4f7bd59537c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\pi $ is an irrational number." :db/id #edb/ref 17592186352417} {:answer/id #uuid "70d9bcf1-e3eb-5236-88ab-e95db6fbda70" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The negative numbers." :db/id #edb/ref 17592186352558} {:answer/id #uuid "8d307d6b-3d62-5aee-bdbf-9bebf76eb0a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The set of the natural numbers." :db/id #edb/ref 17592186352798} {:answer/id #uuid "9d7a6ee3-febb-5d40-9985-6bc10b5e3386" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The height of a triangle." :db/id #edb/ref 17592186352912} {:answer/id #uuid "cca54673-b9a2-585f-a846-9648ba9e245e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Subtract $2$ from $5.$" :db/id #edb/ref 17592186353344}] :answer-field/correct {:answer/id #uuid "5fa39ce5-4b78-55ec-9f01-4f7bd59537c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\pi $ is an irrational number." :db/id #edb/ref 17592186352417} :answer-field/id #uuid "295d4088-ac28-5602-a22f-48b75fc37e32" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186353885}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "87061480-a114-5f8d-a323-725d4db909c5" :question/math-academy-id "q-86473" :question/problem "Which of the following is a mathematical statement?" :question/worked-solution "A mathematical statement is a sentence or mathematical expression that is either true or false. \n\nOf the given sentences, the only sentence that is either true or false is \"$\\pi $ is an irrational number.\" (This sentence is true.)\n\nAll the other sentences are neither true nor false."}] [{:db/id #edb/ref 17592186559852 :knowledge-point/_questions [{:db/id #edb/ref 17592186054818 :knowledge-point/id #uuid "228b0a63-bf0e-57bf-aa1e-ef5518236462" :knowledge-point/title "Identifying Mathematical Statements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3409f4e0-8718-5b95-bbe2-22462e3350dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The set of the odd numbers." :db/id #edb/ref 17592186559146} {:answer/id #uuid "49e9a260-0e94-5cb3-af9e-5bd6c76591c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3$ is a positive number." :db/id #edb/ref 17592186559207} {:answer/id #uuid "8a0bcc08-59f5-51f5-98d4-9305b9e19887" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Why is $2$ an even number?" :db/id #edb/ref 17592186559362} {:answer/id #uuid "a6623cc7-d894-575f-ac65-b336274a6064" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The number $\\pi .$" :db/id #edb/ref 17592186559434} {:answer/id #uuid "d8d95ecb-8d5b-5513-a75e-df53d3116d9c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The hypotenuse of a triangle." :db/id #edb/ref 17592186559547}] :answer-field/correct {:answer/id #uuid "49e9a260-0e94-5cb3-af9e-5bd6c76591c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3$ is a positive number." :db/id #edb/ref 17592186559207} :answer-field/id #uuid "380bc244-a440-547b-ba59-6ef9a824239a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186559673}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c043e0c4-50de-5146-885c-1db3a041b406" :question/math-academy-id "q-86474" :question/problem "Which of the following is a mathematical statement?" :question/worked-solution "A mathematical statement is a sentence or mathematical expression that is either true or false. \n\nOf the given sentences, the only sentence that is either true or false is \"$3$ is a positive number.\" (This sentence is true.)\n\nAll the other sentences are neither true nor false."}]}
