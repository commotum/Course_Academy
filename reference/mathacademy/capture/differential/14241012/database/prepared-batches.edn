d39dbfa-f77c-5216-9581-0acf72d83216"] ["question-d625ae65-2877-56d1-acca-93794ab5d50e" :question/id #uuid "d625ae65-2877-56d1-acca-93794ab5d50e"] ["question-d625ae65-2877-56d1-acca-93794ab5d50e" :question/math-academy-id "q-102854"] ["question-d625ae65-2877-56d1-acca-93794ab5d50e" :question/problem "What is the truth value of the following mathematical statement?\n\n$\\,$ Half of $10$ is $5.$"] ["question-d625ae65-2877-56d1-acca-93794ab5d50e" :question/worked-solution "A mathematical statement is a sentence or mathematical expression that is either true or false.\n\nThis statement is true because the $10÷2=5.$"] ["question-d625ae65-2877-56d1-acca-93794ab5d50e" :question/difficulty :question.difficulty/easy] ["answer-field-e51fec3d-bd4b-5686-8247-2b30b35726ab" :answer-field/id #uuid "e51fec3d-bd4b-5686-8247-2b30b35726ab"] ["answer-d663a7b6-9e41-59ff-bf17-8005c03db3ad" :answer/id #uuid "d663a7b6-9e41-59ff-bf17-8005c03db3ad"] ["answer-d663a7b6-9e41-59ff-bf17-8005c03db3ad" :answer/type :answer.type/text] ["answer-d663a7b6-9e41-59ff-bf17-8005c03db3ad" :answer/value "False"] ["answer-a7c6ca18-152a-52a5-8834-4ecdbd02d08b" :answer/id #uuid "a7c6ca18-152a-52a5-8834-4ecdbd02d08b"] ["answer-a7c6ca18-152a-52a5-8834-4ecdbd02d08b" :answer/type :answer.type/text] ["answer-a7c6ca18-152a-52a5-8834-4ecdbd02d08b" :answer/value "Often"] ["answer-5b8b0d6b-7ed6-501b-94e1-080108062fd7" :answer/id #uuid "5b8b0d6b-7ed6-501b-94e1-080108062fd7"] ["answer-5b8b0d6b-7ed6-501b-94e1-080108062fd7" :answer/type :answer.type/text] ["answer-5b8b0d6b-7ed6-501b-94e1-080108062fd7" :answer/value "Possible"] ["answer-96c1fe5f-0cb0-58bb-adc0-7dcf2f36b957" :answer/id #uuid "96c1fe5f-0cb0-58bb-adc0-7dcf2f36b957"] ["answer-96c1fe5f-0cb0-58bb-adc0-7dcf2f36b957" :answer/type :answer.type/text] ["answer-96c1fe5f-0cb0-58bb-adc0-7dcf2f36b957" :answer/value "Sometimes"] ["answer-28af8068-389d-58ea-af5e-aa10b40c5b88" :answer/id #uuid "28af8068-389d-58ea-af5e-aa10b40c5b88"] ["answer-28af8068-389d-58ea-af5e-aa10b40c5b88" :answer/type :answer.type/text] ["answer-28af8068-389d-58ea-af5e-aa10b40c5b88" :answer/value "True"] ["answer-field-e51fec3d-bd4b-5686-8247-2b30b35726ab" :answer-field/key "selection"] ["answer-field-e51fec3d-bd4b-5686-8247-2b30b35726ab" :answer-field/type :answer-field.type/radio] ["answer-field-e51fec3d-bd4b-5686-8247-2b30b35726ab" :answer-field/correct "answer-28af8068-389d-58ea-af5e-aa10b40c5b88"] ["answer-field-e51fec3d-bd4b-5686-8247-2b30b35726ab" :answer-field/choices "answer-d663a7b6-9e41-59ff-bf17-8005c03db3ad"] ["answer-field-e51fec3d-bd4b-5686-8247-2b30b35726ab" :answer-field/choices "answer-a7c6ca18-152a-52a5-8834-4ecdbd02d08b"] ["answer-field-e51fec3d-bd4b-5686-8247-2b30b35726ab" :answer-field/choices "answer-5b8b0d6b-7ed6-501b-94e1-080108062fd7"] ["answer-field-e51fec3d-bd4b-5686-8247-2b30b35726ab" :answer-field/choices "answer-96c1fe5f-0cb0-58bb-adc0-7dcf2f36b957"] ["answer-field-e51fec3d-bd4b-5686-8247-2b30b35726ab" :answer-field/choices "answer-28af8068-389d-58ea-af5e-aa10b40c5b88"] ["question-d625ae65-2877-56d1-acca-93794ab5d50e" :question/answer-fields "answer-field-e51fec3d-bd4b-5686-8247-2b30b35726ab"] [17592186054817 :knowledge-point/questions "question-d625ae65-2877-56d1-acca-93794ab5d50e"] ["question-0f8c15c2-cbc4-5d0f-bd4c-5f44e2f7b150" :question/id #uuid "0f8c15c2-cbc4-5d0f-bd4c-5f44e2f7b150"] ["question-0f8c15c2-cbc4-5d0f-bd4c-5f44e2f7b150" :question/math-academy-id "q-174324"] ["question-0f8c15c2-cbc4-5d0f-bd4c-5f44e2f7b150" :question/problem "Which of the following statements are true?\n\n- $P:$ A square has exactly four sides.\n\n- $Q:$ $7+2\\ge 10$\n\n- $R:$ $9$ is a prime number."] ["question-0f8c15c2-cbc4-5d0f-bd4c-5f44e2f7b150" :question/worked-solution "A mathematical statement is a sentence or mathematical expression that is either true or false.\n\nWith that in mind, let's evaluate the truth value of each statement:\n\n- Statement $P$ is *true.* Indeed, A square has exactly four sides.\n\n- Statement $Q$ is *false* because $7+2=9≱10.$\n\n- Statement $R$ is *false* because $9$ is not a prime number (it is a composite number).\n\nTherefore, the correct answer is \"$P$ only.\""] ["question-0f8c15c2-cbc4-5d0f-bd4c-5f44e2f7b150" :question/difficulty :question.difficulty/easy] ["answer-field-2855aecd-cdcb-5b2b-9367-17297e8e7af7" :answer-field/id #uuid "2855aecd-cdcb-5b2b-9367-17297e8e7af7"] ["answer-e896aaa9-bb20-52d4-a2ad-2609106f4753" :answer/id #uuid "e896aaa9-bb20-52d4-a2ad-2609106f4753"] ["answer-e896aaa9-bb20-52d4-a2ad-2609106f4753" :answer/type :answer.type/text] ["answer-e896aaa9-bb20-52d4-a2ad-2609106f4753" :answer/value "$P$ and $Q$ only"] ["answer-2c84984b-426d-55e9-965e-6859fe00462e" :answer/id #uuid "2c84984b-426d-55e9-965e-6859fe00462e"] ["answer-2c84984b-426d-55e9-965e-6859fe00462e" :answer/type :answer.type/text] ["answer-2c84984b-426d-55e9-965e-6859fe00462e" :answer/value "$P$ only"] ["answer-262c834d-68ad-51fd-b503-042b9d04a191" :answer/id #uuid "262c834d-68ad-51fd-b503-042b9d04a191"] ["answer-262c834d-68ad-51fd-b503-042b9d04a191" :answer/type :answer.type/text] ["answer-262c834d-68ad-51fd-b503-042b9d04a191" :answer/value "$Q$ and $R$ only"] ["answer-d7ef0b8f-578e-52f9-a537-71e171a1897b" :answer/id #uuid "d7ef0b8f-578e-52f9-a537-71e171a1897b"] ["answer-d7ef0b8f-578e-52f9-a537-71e171a1897b" :answer/type :answer.type/text] ["answer-d7ef0b8f-578e-52f9-a537-71e171a1897b" :answer/value "$R$ only"] ["answer-1c28ed79-d73d-5ea6-bdb8-34895002fb98" :answer/id #uuid "1c28ed79-d73d-5ea6-bdb8-34895002fb98"] ["answer-1c28ed79-d73d-5ea6-bdb8-34895002fb98" :answer/type :answer.type/text] ["answer-1c28ed79-d73d-5ea6-bdb8-34895002fb98" :answer/value "None"] ["answer-field-2855aecd-cdcb-5b2b-9367-17297e8e7af7" :answer-field/key "selection"] ["answer-field-2855aecd-cdcb-5b2b-9367-17297e8e7af7" :answer-field/type :answer-field.type/radio] ["answer-field-2855aecd-cdcb-5b2b-9367-17297e8e7af7" :answer-field/correct "answer-2c84984b-426d-55e9-965e-6859fe00462e"] ["answer-field-2855aecd-cdcb-5b2b-9367-17297e8e7af7" :answer-field/choices "answer-e896aaa9-bb20-52d4-a2ad-2609106f4753"] ["answer-field-2855aecd-cdcb-5b2b-9367-17297e8e7af7" :answer-field/choices "answer-2c84984b-426d-55e9-965e-6859fe00462e"] ["answer-field-2855aecd-cdcb-5b2b-9367-17297e8e7af7" :answer-field/choices "answer-262c834d-68ad-51fd-b503-042b9d04a191"] ["answer-field-2855aecd-cdcb-5b2b-9367-17297e8e7af7" :answer-field/choices "answer-d7ef0b8f-578e-52f9-a537-71e171a1897b"] ["answer-field-2855aecd-cdcb-5b2b-9367-17297e8e7af7" :answer-field/choices "answer-1c28ed79-d73d-5ea6-bdb8-34895002fb98"] ["question-0f8c15c2-cbc4-5d0f-bd4c-5f44e2f7b150" :question/answer-fields "answer-field-2855aecd-cdcb-5b2b-9367-17297e8e7af7"] [17592186054817 :knowledge-point/questions "question-0f8c15c2-cbc4-5d0f-bd4c-5f44e2f7b150"] ["question-ae278ad9-7ac4-5180-982a-a8a5385a7ed1" :question/id #uuid "ae278ad9-7ac4-5180-982a-a8a5385a7ed1"] ["question-ae278ad9-7ac4-5180-982a-a8a5385a7ed1" :question/math-academy-id "q-174322"] ["question-ae278ad9-7ac4-5180-982a-a8a5385a7ed1" :question/problem "Which of the following statements are true?\n\n- $P:$ $2>6$\n\n- $Q:$ $10$ is an integer number.\n\n- $R:$ $7$ is a composite number."] ["question-ae278ad9-7ac4-5180-982a-a8a5385a7ed1" :question/worked-solution "A mathematical statement is a sentence or mathematical expression that is either true or false.\n\nWith that in mind, let's evaluate the truth value of each statement:\n\n- Statement $P$ is *false* because $2≯6.$\n\n- Statement $Q$ is *true.* Indeed, $10$ is an integer number.\n\n- Statement $R$ is *false* because $7$ is not a composite number (it is a prime number).\n\nTherefore, the correct answer is \"$Q$ only.\""] ["question-ae278ad9-7ac4-5180-982a-a8a5385a7ed1" :question/difficulty :question.difficulty/easy] ["answer-field-5486766c-cf45-5b1b-9474-379e0ce541bc" :answer-field/id #uuid "5486766c-cf45-5b1b-9474-379e0ce541bc"] ["answer-36967bc3-fba1-5c19-87b7-c7a780a3ef5c" :answer/id #uuid "36967bc3-fba1-5c19-87b7-c7a780a3ef5