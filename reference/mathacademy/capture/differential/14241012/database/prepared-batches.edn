7f72-5deb-8186-0f592c4c5383" :question/math-academy-id "q-174379"] ["question-0ac2c565-7f72-5deb-8186-0f592c4c5383" :question/problem "Which of the following are mathematical statements?\n\n- $P:$ $0.5$ is a rational number.\n\n- $Q:$ $0.5$ is an irrational number.\n\n- $R:$ Divide $5$ by $10.$"] ["question-0ac2c565-7f72-5deb-8186-0f592c4c5383" :question/worked-solution "A mathematical statement is a sentence or mathematical expression that is either true or false.\n\nWith that in mind, let's examine the given options:\n\n- $P$ is a statement. This statement is *true* because $0.5=\\frac{5}{10},$ so it is a rational number.\n\n- $Q$ is a statement. This statement is *false* because $0.5$ is a rational number.\n\n- $R$ is *not* a statement because it is neither true nor false. Rather, it is an instruction.\n\nTherefore, the correct answer is \"$P$ and $Q$ only.\""] ["question-0ac2c565-7f72-5deb-8186-0f592c4c5383" :question/difficulty :question.difficulty/moderate] ["answer-field-599cb91c-0d63-5d51-9b83-794e5c17ff8e" :answer-field/id #uuid "599cb91c-0d63-5d51-9b83-794e5c17ff8e"] ["answer-1683e4df-7ac1-56de-93fe-3dc1c97b033d" :answer/id #uuid "1683e4df-7ac1-56de-93fe-3dc1c97b033d"] ["answer-1683e4df-7ac1-56de-93fe-3dc1c97b033d" :answer/type :answer.type/text] ["answer-1683e4df-7ac1-56de-93fe-3dc1c97b033d" :answer/value "$P$ and $Q$ only"] ["answer-f94e743c-7b96-5495-994f-6c9dca697862" :answer/id #uuid "f94e743c-7b96-5495-994f-6c9dca697862"] ["answer-f94e743c-7b96-5495-994f-6c9dca697862" :answer/type :answer.type/text] ["answer-f94e743c-7b96-5495-994f-6c9dca697862" :answer/value "$P$ only"] ["answer-d1a4ddc1-38ac-5eaa-ada1-0c765f9e51ce" :answer/id #uuid "d1a4ddc1-38ac-5eaa-ada1-0c765f9e51ce"] ["answer-d1a4ddc1-38ac-5eaa-ada1-0c765f9e51ce" :answer/type :answer.type/text] ["answer-d1a4ddc1-38ac-5eaa-ada1-0c765f9e51ce" :answer/value "$Q$ and $R$ only"] ["answer-00c6db1d-5927-5c6a-9a41-4fbc644fc1e4" :answer/id #uuid "00c6db1d-5927-5c6a-9a41-4fbc644fc1e4"] ["answer-00c6db1d-