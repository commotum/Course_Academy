486766c-cf45-5b1b-9474-379e0ce541bc" :answer-field/choices "answer-473c2134-347a-5352-8a92-c8abb336f0e6"] ["question-ae278ad9-7ac4-5180-982a-a8a5385a7ed1" :question/answer-fields "answer-field-5486766c-cf45-5b1b-9474-379e0ce541bc"] [17592186054817 :knowledge-point/questions "question-ae278ad9-7ac4-5180-982a-a8a5385a7ed1"] ["question-d4bf832a-fa7c-5bf9-96bc-b8972c38ecca" :question/id #uuid "d4bf832a-fa7c-5bf9-96bc-b8972c38ecca"] ["question-d4bf832a-fa7c-5bf9-96bc-b8972c38ecca" :question/math-academy-id "q-173721"] ["question-d4bf832a-fa7c-5bf9-96bc-b8972c38ecca" :question/problem "Which of the following statements are false?\n\n- $P:$ $\\sqrt{5}$ is a real number.\n\n- $Q:$ $10$ is divisible by $3.$\n\n- $R:$ $2+3\\le 1$"] ["question-d4bf832a-fa7c-5bf9-96bc-b8972c38ecca" :question/worked-solution "A mathematical statement is a sentence or mathematical expression that is either true or false.\n\nWith that in mind, let's evaluate the truth value of each statement:\n\n- Statement $P$ is *true.* Indeed, $\\sqrt{5}$ is a real number.\n\n- Statement $Q$ is *false* because $10$ is not divisible by $3.$\n\n- Statement $R$ is *false* because $2+3=5≰1.$\n\nTherefore, the correct answer is \"$Q$ and $R$ only.\""] ["question-d4bf832a-fa7c-5bf9-96bc-b8972c38ecca" :question/difficulty :question.difficulty/moderate] ["answer-field-f65721db-6112-5108-9ea1-45e3d318fab2" :answer-field/id #uuid "f65721db-6112-5108-9ea1-45e3d318fab2"] ["answer-f74b8f84-001c-5bd3-858c-127b607a4caa" :answer/id #uuid "f74b8f84-001c-5bd3-858c-127b607a4caa"] ["answer-f74b8f84-001c-5bd3-858c-127b607a4caa" :answer/type :answer.type/text] ["answer-f74b8f84-001c-5bd3-858c-127b607a4caa" :answer/value "$P$ and $Q$ only"] ["answer-9517b839-199e-5857-8086-d5bd10fd12f9" :answer/id #uuid "9517b839-199e-5857-8086-d5bd10fd12f9"] ["answer-9517b839-199e-5857-8086-d5bd10fd12f9" :answer/type :answer.type/text] ["answer-9517b839-199e-5857-8086-d5bd10fd12f9" :answer/value "$P$ only"] ["answer-6dc17bbe-8dd6-5f5a-9886-4d726f015