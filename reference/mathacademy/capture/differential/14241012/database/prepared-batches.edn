ebb342a4"] ["question-4681538e-2de2-56f3-881c-562aebb342a4" :question/math-academy-id "q-174421"] ["question-4681538e-2de2-56f3-881c-562aebb342a4" :question/problem "Which of the following are mathematical statements?\n\n- $P:\\{2,3,7\\}\\cap \\{3,5,6\\}=∅$\n\n- $Q:{\\pi }^{2}-\\pi $\n\n- $R:3$ is a prime number."] ["question-4681538e-2de2-56f3-881c-562aebb342a4" :question/worked-solution "A mathematical statement is a sentence or mathematical expression that is either true or false.\n\nWith that in mind, let's examine the given options: \n\n- $P$ is a statement. This statement is *false* because the intersection of the given sets is the set $\\{3\\}.$\n\n- $Q$ is *not* a statement because it is neither true nor false.\n\n- $R$ is a statement. This statement is *true* since $3$ is indeed a prime number.\n\nTherefore, the correct answer is \"$P$ and $R$ only.\""] ["question-4681538e-2de2-56f3-881c-562aebb342a4" :question/difficulty :question.difficulty/moderate] ["answer-field-9bc23c46-3bd3-5315-a27d-9984de9363ff" :answer-field/id #uuid "9bc23c46-3bd3-5315-a27d-9984de9363ff"] ["answer-7fa33b89-066a-5994-a5c6-4b947c94af99" :answer/id #uuid "7fa33b89-066a-5994-a5c6-4b947c94af99"] ["answer-7fa33b89-066a-5994-a5c6-4b947c94af99" :answer/type :answer.type/text] ["answer-7fa33b89-066a-5994-a5c6-4b947c94af99" :answer/value "$P$ and $Q$ only"] ["answer-716d255d-da8a-543a-b7e5-474422b51ccf" :answer/id #uuid "716d255d-da8a-543a-b7e5-474422b51ccf"] ["answer-716d255d-da8a-543a-b7e5-474422b51ccf" :answer/type :answer.type/text] ["answer-716d255d-da8a-543a-b7e5-474422b51ccf" :answer/value "$P$ and $R$ only"] ["answer-e22cde76-a74c-500b-b6af-756ccafc7a0f" :answer/id #uuid "e22cde76-a74c-500b-b6af-756ccafc7a0f"] ["answer-e22cde76-a74c-500b-b6af-756ccafc7a0f" :answer/type :answer.type/text] ["answer-e22cde76-a74c-500b-b6af-756ccafc7a0f" :answer/value "$P$ only"] ["answer-c7d3dadc-f62a-5cdf-b969-e5976107e24e" :answer/id #uuid "c7d3dadc-f62a-5cdf-b969-e5976107e24e"] ["answer-c7d3dadc-f6