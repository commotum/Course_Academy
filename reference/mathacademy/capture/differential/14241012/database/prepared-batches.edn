[{"source" ":org/Math-Academy" "forms" [{:db/id 17592186054817 :knowledge-point/questions ["question-dd39dbfa-f77c-5216-9581-0acf72d83216" "question-d625ae65-2877-56d1-acca-93794ab5d50e" "question-0f8c15c2-cbc4-5d0f-bd4c-5f44e2f7b150" "question-ae278ad9-7ac4-5180-982a-a8a5385a7ed1" "question-d4bf832a-fa7c-5bf9-96bc-b8972c38ecca"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186054818 :knowledge-point/questions ["question-0ac2c565-7f72-5deb-8186-0f592c4c5383" "question-ae9ba4f6-2cb2-5711-bd11-5c1b1d70436a" "question-c043e0c4-50de-5146-885c-1db3a041b406"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186054819 :knowledge-point/questions ["question-0a9725fe-5d32-5217-81b5-21b1fce3c258" "question-4681538e-2de2-56f3-881c-562aebb342a4"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186054820 :knowledge-point/questions ["question-3bd80b9b-2655-5bf4-bdf9-f7428c6e7e13" "question-f4fa3c45-5e91-57f0-a165-1adda22fdfd5"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186054451 :question/problem "Which of the following are mathematical predicates of one variable?\n\nI. Subtract $x$ from $10.$\n\nII. $y^2 -2  \\leq 3$\n\nIII. $1+z$ is a perfect square." :db/ensure [:question/validate]} {:db/id "question-dd39dbfa-f77c-5216-9581-0acf72d83216" :question/id #uuid "dd39dbfa-f77c-5216-9581-0acf72d83216" :question/math-academy-id "q-174325" :question/problem "Which of the following statements are false?\n\n- $P:$ $\\sqrt{2}=1$\n\n- $Q:$ ${3}^{2}=9$\n\n- $R:$ $8$ is a composite number." :question/worked-solution "A mathematical statement is a sentence or mathematical expression that is either true or false.\n\nWith that in mind, let's evaluate the truth value of each statement:\n\n- Statement $P$ is *false* because $\\sqrt{2}\\ne 1.$\n\n- Statement $Q$ is *true.* Indeed, ${3}^{2}=9.$\n\n- Statement $R$ is *true.* Indeed, $8$ is a composite number.\n\nTherefore, the correct answer is \"$P$ only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-6ffec692-aff6-5f8a-8ed2-ad2d3be592a8"] :db/ensure [:question/validate]} {:db/id "answer-field-6ffec692-aff6-5f8a-8ed2-ad2d3be592a8" :answer-field/id #uuid "6ffec692-aff6-5f8a-8ed2-ad2d3be592a8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7f396bcf-805d-593a-bc0f-08d9c2160e96" :answer-field/choices ["answer-d9be00a6-31bb-5125-a45a-0d2e2a0dff31" "answer-7f396bcf-805d-593a-bc0f-08d9c2160e96" "answer-5e6e4243-4409-5270-8c34-d2a94fd272b4" "answer-2558bbfc-d47d-5f3f-915e-141d8043b721" "answer-10d4d128-cd47-51ad-8773-aed5b013eb3a"] :db/ensure [:answer-field/validate]} {:db/id "answer-d9be00a6-31bb-5125-a45a-0d2e2a0dff31" :answer/id #uuid "d9be00a6-31bb-5125-a45a-0d2e2a0dff31" :answer/type :answer.type/text :answer/value "$P$ and $Q$ only" :db/ensure [:answer/validate]} {:db/id "answer-7f396bcf-805d-593a-bc0f-08d9c2160e96" :answer/id #uuid "7f396bcf-805d-593a-bc0f-08d9c2160e96" :answer/type :answer.type/text :answer/value "$P$ only" :db/ensure [:answer/validate]} {:db/id "answer-5e6e4243-4409-5270-8c34-d2a94fd272b4" :answer/id #uuid "5e6e4243-4409-5270-8c34-d2a94fd272b4" :answer/type :answer.type/text :answer/value "$Q$ and $R$ only" :db/ensure [:answer/validate]} {:db/id "answer-2558bbfc-d47d-5f3f-915e-141d8043b721" :answer/id #uuid "2558bbfc-d47d-5f3f-915e-141d8043b721" :answer/type :answer.type/text :answer/value "$Q$ only" :db/ensure [:answer/validate]} {:db/id "answer-10d4d128-cd47-51ad-8773-aed5b013eb3a" :answer/id #uuid "10d4d128-cd47-51ad-8773-aed5b013eb3a" :answer/type :answer.type/text :answer/value "None" :db/ensure [:answer/validate]} {:db/id "question-d625ae65-2877-56d1-acca-93794ab5d50e" :question/id #uuid "d625ae65-2877-56d1-acca-93794ab5d50e" :question/math-academy-id "q-102854" :question/problem "What is the truth value of the following mathematical statement?\n\n$\\,$ Half of $10$ is $5.$" :question/worked-solution "A mathematical statement is a sentence or mathematical expression that is either true or false.\n\nThis statement is true because the $10÷2=5.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-e51fec3d-bd4b-5686-8247-2b30b35726ab"] :db/ensure [:question/validate]} {:db/id "answer-field-e51fec3d-bd4b-5686-8247-2b30b35726ab" :answer-field/id #uuid "e51fec3d-bd4b-5686-8247-2b30b35726ab" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-28af8068-389d-58ea-af5e-aa10b40c5b88" :answer-field/choices ["answer-d663a7b6-9e41-59ff-bf17-8005c03db3ad" "answer-a7c6ca18-152a-52a5-8834-4ecdbd02d08b" "answer-5b8b0d6b-7ed6-501b-94e1-080108062fd7" "answer-96c1fe5f-0cb0-58bb-adc0-7dcf2f36b957" "answer-28af8068-389d-58ea-af5e-aa10b40c5b88"] :db/ensure [:answer-field/validate]} {:db/id "answer-d663a7b6-9e41-59ff-bf17-8005c03db3ad" :answer/id #uuid "d663a7b6-9e41-59ff-bf17-8005c03db3ad" :answer/type :answer.type/text :answer/value "False" :db/ensure [:answer/validate]} {:db/id "answer-a7c6ca18-152a-52a5-8834-4ecdbd02d08b" :answer/id #uuid "a7c6ca18-152a-52a5-8834-4ecdbd02d08b" :answer/type :answer.type/text :answer/value "Often" :db/ensure [:answer/validate]} {:db/id "answer-5b8b0d6b-7ed6-501b-94e1-080108062fd7" :answer/id #uuid "5b8b0d6b-7ed6-501b-94e1-080108062fd7" :answer/type :answer.type/text :answer/value "Possible" :db/ensure [:answer/validate]} {:db/id "answer-96c1fe5f-0cb0-58bb-adc0-7dcf2f36b957" :answer/id #uuid "96c1fe5f-0cb0-58bb-adc0-7dcf2f36b957" :answer/type :answer.type/text :answer/value "Sometimes" :db/ensure [:answer/validate]} {:db/id "answer-28af8068-389d-58ea-af5e-aa10b40c5b88" :answer/id #uuid "28af8068-389d-58ea-af5e-aa10b40c5b88" :answer/type :answer.type/text :answer/value "True" :db/ensure [:answer/validate]} {:db/id "question-0f8c15c2-cbc4-5d0f-bd4c-5f44e2f7b150" :question/id #uuid "0f8c15c2-cbc4-5d0f-bd4c-5f44e2f7b150" :question/math-academy-id "q-174324" :question/problem "Which of the following statements are true?\n\n- $P:$ A square has exactly four sides.\n\n- $Q:$ $7+2\\ge 10$\n\n- $R:$ $9$ is a prime number." :question/worked-solution "A mathematical statement is a sentence or mathematical expression that is either true or false.\n\nWith that in mind, let's evaluate the truth value of each statement:\n\n- Statement $P$ is *true.* Indeed, A square has exactly four sides.\n\n- Statement $Q$ is *false* because $7+2=9≱10.$\n\n- Statement $R$ is *false* because $9$ is not a prime number (it is a composite number).\n\nTherefore, the correct answer is \"$P$ only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-2855aecd-cdcb-5b2b-9367-17297e8e7af7"] :db/ensure [:question/validate]} {:db/id "answer-field-2855aecd-cdcb-5b2b-9367-17297e8e7af7" :answer-field/id #uuid "2855aecd-cdcb-5b2b-9367-17297e8e7af7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2c84984b-426d-55e9-965e-6859fe00462e" :answer-field/choices ["answer-e896aaa9-bb20-52d4-a2ad-2609106f4753" "answer-2c84984b-426d-55e9-965e-6859fe00462e" "answer-262c834d-68ad-51fd-b503-042b9d04a191" "answer-d7ef0b8f-578e-52f9-a537-71e171a1897b" "answer-1c28ed79-d73d-5ea6-bdb8-34895002fb98"] :db/ensure [:answer-field/validate]} {:db/id "answer-e896aaa9-bb20-52d4-a2ad-2609106f4753" :answer/id #uuid "e896aaa9-bb20-52d4-a2ad-2609106f4753" :answer/type :answer.type/text :answer/value "$P$ and $Q$ only" :db/ensure [:answer/validate]} {:db/id "answer-2c84984b-426d-55e9-965e-6859fe00462e" :answer/id #uuid "2c84984b-426d-55e9-965e-6859fe00462e" :answer/type :answer.type/text :answer/value "$P$ only" :db/ensure [:answer/validate]} {:db/id "answer-262c834d-68ad-51fd-b503-042b9d04a191" :answer/id #uuid "262c834d-68ad-51fd-b503-042b9d04a191" :answer/type :answer.type/text :answer/value "$Q$ and $R$ only" :db/ensure [:answer/validate]} {:db/id "answer-d7ef0b8f-578e-52f9-a537-71e171a1897b" :answer/id #uuid "d7ef0b8f-578e-52f9-a537-71e171a1897b" :answer/type :answer.type/text :answer/value "$R$ only" :db/ensure [:answer/validate]} {:db/id "answer-1c28ed79-d73d-5ea6-bdb8-34895002fb98" :answer/id #uuid "1c28ed79-d73d-5ea6-bdb8-34895002fb98" :answer/type :answer.type/text :answer/value "None" :db/ensure [:answer/validate]} {:db/id "question-ae278ad9-7ac4-5180-982a-a8a5385a7ed1" :question/id #uuid "ae278ad9-7ac4-5180-982a-a8a5385a7ed1" :question/math-academy-id "q-174322" :question/problem "Which of the following statements are true?\n\n- $P:$ $2>6$\n\n- $Q:$ $10$ is an integer number.\n\n- $R:$ $7$ is a composite number." :question/worked-solution "A mathematical statement is a sentence or mathematical expression that is either true or false.\n\nWith that in mind, let's evaluate the truth value of each statement:\n\n- Statement $P$ is *false* because $2≯6.$\n\n- Statement $Q$ is *true.* Indeed, $10$ is an integer number.\n\n- Statement $R$ is *false* because $7$ is not a composite number (it is a prime number).\n\nTherefore, the correct answer is \"$Q$ only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-5486766c-cf45-5b1b-9474-379e0ce541bc"] :db/ensure [:question/validate]} {:db/id "answer-field-5486766c-cf45-5b1b-9474-379e0ce541bc" :answer-field/id #uuid "5486766c-cf45-5b1b-9474-379e0ce541bc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d58f599c-20dc-5023-ba78-635c62a7f31a" :answer-field/choices ["answer-36967bc3-fba1-5c19-87b7-c7a780a3ef5c" "answer-a1ae0e82-5fd8-5122-b6e2-9044559ff78f" "answer-d58f599c-20dc-5023-ba78-635c62a7f31a" "answer-57fc1f02-0cb6-58ff-a2f3-430b7606eb5a" "answer-473c2134-347a-5352-8a92-c8abb336f0e6"] :db/ensure [:answer-field/validate]} {:db/id "answer-36967bc3-fba1-5c19-87b7-c7a780a3ef5c" :answer/id #uuid "36967bc3-fba1-5c19-87b7-c7a780a3ef5c" :answer/type :answer.type/text :answer/value "$P$ and $Q$ only" :db/ensure [:answer/validate]} {:db/id "answer-a1ae0e82-5fd8-5122-b6e2-9044559ff78f" :answer/id #uuid "a1ae0e82-5fd8-5122-b6e2-9044559ff78f" :answer/type :answer.type/text :answer/value "$P$ and $R$ only" :db/ensure [:answer/validate]} {:db/id "answer-d58f599c-20dc-5023-ba78-635c62a7f31a" :answer/id #uuid "d58f599c-20dc-5023-ba78-635c62a7f31a" :answer/type :answer.type/text :answer/value "$Q$ only" :db/ensure [:answer/validate]} {:db/id "answer-57fc1f02-0cb6-58ff-a2f3-430b7606eb5a" :answer/id #uuid "57fc1f02-0cb6-58ff-a2f3-430b7606eb5a" :answer/type :answer.type/text :answer/value "$R$ only" :db/ensure [:answer/validate]} {:db/id "answer-473c2134-347a-5352-8a92-c8abb336f0e6" :answer/id #uuid "473c2134-347a-5352-8a92-c8abb336f0e6" :answer/type :answer.type/text :answer/value "None" :db/ensure [:answer/validate]} {:db/id "question-d4bf832a-fa7c-5bf9-96bc-b8972c38ecca" :question/id #uuid "d4bf832a-fa7c-5bf9-96bc-b8972c38ecca" :question/math-academy-id "q-173721" :question/problem "Which of the following statements are false?\n\n- $P:$ $\\sqrt{5}$ is a real number.\n\n- $Q:$ $10$ is divisible by $3.$\n\n- $R:$ $2+3\\le 1$" :question/worked-solution "A mathematical statement is a sentence or mathematical expression that is either true or false.\n\nWith that in mind, let's evaluate the truth value of each statement:\n\n- Statement $P$ is *true.* Indeed, $\\sqrt{5}$ is a real number.\n\n- Statement $Q$ is *false* because $10$ is not divisible by $3.$\n\n- Statement $R$ is *false* because $2+3=5≰1.$\n\nTherefore, the correct answer is \"$Q$ and $R$ only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f65721db-6112-5108-9ea1-45e3d318fab2"] :db/ensure [:question/validate]} {:db/id "answer-field-f65721db-6112-5108-9ea1-45e3d318fab2" :answer-field/id #uuid "f65721db-6112-5108-9ea1-45e3d318fab2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3b022a5e-ac82-54c3-b12b-4abc34d6c281" :answer-field/choices ["answer-f74b8f84-001c-5bd3-858c-127b607a4caa" "answer-9517b839-199e-5857-8086-d5bd10fd12f9" "answer-6dc17bbe-8dd6-5f5a-9886-4d726f015772" "answer-3b022a5e-ac82-54c3-b12b-4abc34d6c281" "answer-2303e8fc-c1dc-524c-9411-1f4a00def4c4"] :db/ensure [:answer-field/validate]} {:db/id "answer-f74b8f84-001c-5bd3-858c-127b607a4caa" :answer/id #uuid "f74b8f84-001c-5bd3-858c-127b607a4caa" :answer/type :answer.type/text :answer/value "$P$ and $Q$ only" :db/ensure [:answer/validate]} {:db/id "answer-9517b839-199e-5857-8086-d5bd10fd12f9" :answer/id #uuid "9517b839-199e-5857-8086-d5bd10fd12f9" :answer/type :answer.type/text :answer/value "$P$ only" :db/ensure [:answer/validate]} {:db/id "answer-6dc17bbe-8dd6-5f5a-9886-4d726f015772" :answer/id #uuid "6dc17bbe-8dd6-5f5a-9886-4d726f015772" :answer/type :answer.type/text :answer/value "$P,Q,$ and $R$" :db/ensure [:answer/validate]} {:db/id "answer-3b022a5e-ac82-54c3-b12b-4abc34d6c281" :answer/id #uuid "3b022a5e-ac82-54c3-b12b-4abc34d6c281" :answer/type :answer.type/text :answer/value "$Q$ and $R$ only" :db/ensure [:answer/validate]} {:db/id "answer-2303e8fc-c1dc-524c-9411-1f4a00def4c4" :answer/id #uuid "2303e8fc-c1dc-524c-9411-1f4a00def4c4" :answer/type :answer.type/text :answer/value "$Q$ only" :db/ensure [:answer/validate]} {:db/id "question-0ac2c565-7f72-5deb-8186-0f592c4c5383" :question/id #uuid "0ac2c565-7f72-5deb-8186-0f592c4c5383" :question/math-academy-id "q-174379" :question/problem "Which of the following are mathematical statements?\n\n- $P:$ $0.5$ is a rational number.\n\n- $Q:$ $0.5$ is an irrational number.\n\n- $R:$ Divide $5$ by $10.$" :question/worked-solution "A mathematical statement is a sentence or mathematical expression that is either true or false.\n\nWith that in mind, let's examine the given options:\n\n- $P$ is a statement. This statement is *true* because $0.5=\\frac{5}{10},$ so it is a rational number.\n\n- $Q$ is a statement. This statement is *false* because $0.5$ is a rational number.\n\n- $R$ is *not* a statement because it is neither true nor false. Rather, it is an instruction.\n\nTherefore, the correct answer is \"$P$ and $Q$ only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-599cb91c-0d63-5d51-9b83-794e5c17ff8e"] :db/ensure [:question/validate]} {:db/id "answer-field-599cb91c-0d63-5d51-9b83-794e5c17ff8e" :answer-field/id #uuid "599cb91c-0d63-5d51-9b83-794e5c17ff8e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1683e4df-7ac1-56de-93fe-3dc1c97b033d" :answer-field/choices ["answer-1683e4df-7ac1-56de-93fe-3dc1c97b033d" "answer-f94e743c-7b96-5495-994f-6c9dca697862" "answer-d1a4ddc1-38ac-5eaa-ada1-0c765f9e51ce" "answer-00c6db1d-5927-5c6a-9a41-4fbc644fc1e4" "answer-d9dfa505-d63e-5fd7-9564-b821a3bed62f"] :db/ensure [:answer-field/validate]} {:db/id "answer-1683e4df-7ac1-56de-93fe-3dc1c97b033d" :answer/id #uuid "1683e4df-7ac1-56de-93fe-3dc1c97b033d" :answer/type :answer.type/text :answer/value "$P$ and $Q$ only" :db/ensure [:answer/validate]} {:db/id "answer-f94e743c-7b96-5495-994f-6c9dca697862" :answer/id #uuid "f94e743c-7b96-5495-994f-6c9dca697862" :answer/type :answer.type/text :answer/value "$P$ only" :db/ensure [:answer/validate]} {:db/id "answer-d1a4ddc1-38ac-5eaa-ada1-0c765f9e51ce" :answer/id #uuid "d1a4ddc1-38ac-5eaa-ada1-0c765f9e51ce" :answer/type :answer.type/text :answer/value "$Q$ and $R$ only" :db/ensure [:answer/validate]} {:db/id "answer-00c6db1d-5927-5c6a-9a41-4fbc644fc1e4" :answer/id #uuid "00c6db1d-5927-5c6a-9a41-4fbc644fc1e4" :answer/type :answer.type/text :answer/value "$Q$ only" :db/ensure [:answer/validate]} {:db/id "answer-d9dfa505-d63e-5fd7-9564-b821a3bed62f" :answer/id #uuid "d9dfa505-d63e-5fd7-9564-b821a3bed62f" :answer/type :answer.type/text :answer/value "$R$ only" :db/ensure [:answer/validate]} {:db/id "question-ae9ba4f6-2cb2-5711-bd11-5c1b1d70436a" :question/id #uuid "ae9ba4f6-2cb2-5711-bd11-5c1b1d70436a" :question/math-academy-id "q-102847" :question/problem "Which of the following is a mathematical statement?" :question/worked-solution "A mathematical statement is a sentence or mathematical expression that is either true or false. \n\nOf the given sentences, the only sentence that is either true or false is \"A rectangle has four angles.\" (This sentence is true.)\n\nAll the other sentences are neither true nor false." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a9bbce88-e20f-53a3-b5e8-17d8d8b20865"] :db/ensure [:question/validate]} {:db/id "answer-field-a9bbce88-e20f-53a3-b5e8-17d8d8b20865" :answer-field/id #uuid "a9bbce88-e20f-53a3-b5e8-17d8d8b20865" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-27e7f1a2-0340-57ea-a3ec-6b7f16d5e4b4" :answer-field/choices ["answer-27e7f1a2-0340-57ea-a3ec-6b7f16d5e4b4" "answer-ee24fb1c-29c7-5fc5-9eae-4512b626a3d7" "answer-6b7642cc-29be-5f1a-9a16-ef318c444413" "answer-b67f3de7-0824-5db8-a89a-109dbb1c1bc7" "answer-2a6a5fdc-fdac-5d72-9181-7f0590bf65a9"] :db/ensure [:answer-field/validate]} {:db/id "answer-27e7f1a2-0340-57ea-a3ec-6b7f16d5e4b4" :answer/id #uuid "27e7f1a2-0340-57ea-a3ec-6b7f16d5e4b4" :answer/type :answer.type/text :answer/value "A rectangle has four angles." :db/ensure [:answer/validate]} {:db/id "answer-ee24fb1c-29c7-5fc5-9eae-4512b626a3d7" :answer/id #uuid "ee24fb1c-29c7-5fc5-9eae-4512b626a3d7" :answer/type :answer.type/text :answer/value "How do you find the perimeter of a square?" :db/ensure [:answer/validate]} {:db/id "answer-6b7642cc-29be-5f1a-9a16-ef318c444413" :answer/id #uuid "6b7642cc-29be-5f1a-9a16-ef318c444413" :answer/type :answer.type/text :answer/value "Sum of the measures of the angles in a pentagon." :db/ensure [:answer/validate]} {:db/id "answer-b67f3de7-0824-5db8-a89a-109dbb1c1bc7" :answer/id #uuid "b67f3de7-0824-5db8-a89a-109dbb1c1bc7" :answer/type :answer.type/text :answer/value "The diameter of a circle." :db/ensure [:answer/validate]} {:db/id "answer-2a6a5fdc-fdac-5d72-9181-7f0590bf65a9" :answer/id #uuid "2a6a5fdc-fdac-5d72-9181-7f0590bf65a9" :answer/type :answer.type/text :answer/value "The sides of a triangle." :db/ensure [:answer/validate]} {:db/id "question-c043e0c4-50de-5146-885c-1db3a041b406" :question/id #uuid "c043e0c4-50de-5146-885c-1db3a041b406" :question/math-academy-id "q-86474" :question/problem "Which of the following is a mathematical statement?" :question/worked-solution "A mathematical statement is a sentence or mathematical expression that is either true or false. \n\nOf the given sentences, the only sentence that is either true or false is \"$3$ is a positive number.\" (This sentence is true.)\n\nAll the other sentences are neither true nor false." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-380bc244-a440-547b-ba59-6ef9a824239a"] :db/ensure [:question/validate]} {:db/id "answer-field-380bc244-a440-547b-ba59-6ef9a824239a" :answer-field/id #uuid "380bc244-a440-547b-ba59-6ef9a824239a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-49e9a260-0e94-5cb3-af9e-5bd6c76591c6" :answer-field/choices ["answer-49e9a260-0e94-5cb3-af9e-5bd6c76591c6" "answer-d8d95ecb-8d5b-5513-a75e-df53d3116d9c" "answer-a6623cc7-d894-575f-ac65-b336274a6064" "answer-3409f4e0-8718-5b95-bbe2-22462e3350dc" "answer-8a0bcc08-59f5-51f5-98d4-9305b9e19887"] :db/ensure [:answer-field/validate]} {:db/id "answer-49e9a260-0e94-5cb3-af9e-5bd6c76591c6" :answer/id #uuid "49e9a260-0e94-5cb3-af9e-5bd6c76591c6" :answer/type :answer.type/text :answer/value "$3$ is a positive number." :db/ensure [:answer/validate]} {:db/id "answer-d8d95ecb-8d5b-5513-a75e-df53d3116d9c" :answer/id #uuid "d8d95ecb-8d5b-5513-a75e-df53d3116d9c" :answer/type :answer.type/text :answer/value "The hypotenuse of a triangle." :db/ensure [:answer/validate]} {:db/id "answer-a6623cc7-d894-575f-ac65-b336274a6064" :answer/id #uuid "a6623cc7-d894-575f-ac65-b336274a6064" :answer/type :answer.type/text :answer/value "The number $\\pi .$" :db/ensure [:answer/validate]} {:db/id "answer-3409f4e0-8718-5b95-bbe2-22462e3350dc" :answer/id #uuid "3409f4e0-8718-5b95-bbe2-22462e3350dc" :answer/type :answer.type/text :answer/value "The set of the odd numbers." :db/ensure [:answer/validate]} {:db/id "answer-8a0bcc08-59f5-51f5-98d4-9305b9e19887" :answer/id #uuid "8a0bcc08-59f5-51f5-98d4-9305b9e19887" :answer/type :answer.type/text :answer/value "Why is $2$ an even number?" :db/ensure [:answer/validate]} {:db/id "question-0a9725fe-5d32-5217-81b5-21b1fce3c258" :question/id #uuid "0a9725fe-5d32-5217-81b5-21b1fce3c258" :question/math-academy-id "q-174417" :question/problem "Which of the following are mathematical statements?\n\n- $P:5\\,|\\,9$\n\n- $Q:\\sqrt{2}+0.2$\n\n- $R:\\sqrt{2}\\in R$" :question/worked-solution "A mathematical statement is a sentence or mathematical expression that is either true or false.\n\nWith that in mind, let's examine the given options: \n\n- $P$ is a statement. This statement is *false* because $5$ does not divide $9.$\n\n- $Q$ is *not* a statement because it is neither true nor false.\n\n- $R$ is a statement. This statement is *true* because $\\sqrt{2}$ is a real number.\n\nTherefore, the correct answer is \"$P$ and $R$ only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e60f71c4-9ac3-5f6b-9e7c-eca1c14c1978"] :db/ensure [:question/validate]} {:db/id "answer-field-e60f71c4-9ac3-5f6b-9e7c-eca1c14c1978" :answer-field/id #uuid "e60f71c4-9ac3-5f6b-9e7c-eca1c14c1978" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d1069563-eea1-5f35-b63b-584fe5edde86" :answer-field/choices ["answer-73f80b23-1966-55fe-99ec-3a0c34dff20d" "answer-d1069563-eea1-5f35-b63b-584fe5edde86" "answer-b9bd5ee1-380b-5707-9141-9827a7e72d0b" "answer-4ea61359-4851-516b-b2a3-c6c648515cbf" "answer-c93f27ca-d6ca-5413-98d4-27b595552a02"] :db/ensure [:answer-field/validate]} {:db/id "answer-73f80b23-1966-55fe-99ec-3a0c34dff20d" :answer/id #uuid "73f80b23-1966-55fe-99ec-3a0c34dff20d" :answer/type :answer.type/text :answer/value "$P$  only" :db/ensure [:answer/validate]} {:db/id "answer-d1069563-eea1-5f35-b63b-584fe5edde86" :answer/id #uuid "d1069563-eea1-5f35-b63b-584fe5edde86" :answer/type :answer.type/text :answer/value "$P$ and $R$ only" :db/ensure [:answer/validate]} {:db/id "answer-b9bd5ee1-380b-5707-9141-9827a7e72d0b" :answer/id #uuid "b9bd5ee1-380b-5707-9141-9827a7e72d0b" :answer/type :answer.type/text :answer/value "$Q$ and $R$ only" :db/ensure [:answer/validate]} {:db/id "answer-4ea61359-4851-516b-b2a3-c6c648515cbf" :answer/id #uuid "4ea61359-4851-516b-b2a3-c6c648515cbf" :answer/type :answer.type/text :answer/value "$Q$ only" :db/ensure [:answer/validate]} {:db/id "answer-c93f27ca-d6ca-5413-98d4-27b595552a02" :answer/id #uuid "c93f27ca-d6ca-5413-98d4-27b595552a02" :answer/type :answer.type/text :answer/value "$R$ only" :db/ensure [:answer/validate]} {:db/id "question-4681538e-2de2-56f3-881c-562aebb342a4" :question/id #uuid "4681538e-2de2-56f3-881c-562aebb342a4" :question/math-academy-id "q-174421" :question/problem "Which of the following are mathematical statements?\n\n- $P:\\{2,3,7\\}\\cap \\{3,5,6\\}=∅$\n\n- $Q:{\\pi }^{2}-\\pi $\n\n- $R:3$ is a prime number." :question/worked-solution "A mathematical statement is a sentence or mathematical expression that is either true or false.\n\nWith that in mind, let's examine the given options: \n\n- $P$ is a statement. This statement is *false* because the intersection of the given sets is the set $\\{3\\}.$\n\n- $Q$ is *not* a statement because it is neither true nor false.\n\n- $R$ is a statement. This statement is *true* since $3$ is indeed a prime number.\n\nTherefore, the correct answer is \"$P$ and $R$ only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9bc23c46-3bd3-5315-a27d-9984de9363ff"] :db/ensure [:question/validate]} {:db/id "answer-field-9bc23c46-3bd3-5315-a27d-9984de9363ff" :answer-field/id #uuid "9bc23c46-3bd3-5315-a27d-9984de9363ff" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-716d255d-da8a-543a-b7e5-474422b51ccf" :answer-field/choices ["answer-7fa33b89-066a-5994-a5c6-4b947c94af99" "answer-716d255d-da8a-543a-b7e5-474422b51ccf" "answer-e22cde76-a74c-500b-b6af-756ccafc7a0f" "answer-c7d3dadc-f62a-5cdf-b969-e5976107e24e" "answer-241ec206-34ba-5db3-8740-a7379250c1e3"] :db/ensure [:answer-field/validate]} {:db/id "answer-7fa33b89-066a-5994-a5c6-4b947c94af99" :answer/id #uuid "7fa33b89-066a-5994-a5c6-4b947c94af99" :answer/type :answer.type/text :answer/value "$P$ and $Q$ only" :db/ensure [:answer/validate]} {:db/id "answer-716d255d-da8a-543a-b7e5-474422b51ccf" :answer/id #uuid "716d255d-da8a-543a-b7e5-474422b51ccf" :answer/type :answer.type/text :answer/value "$P$ and $R$ only" :db/ensure [:answer/validate]} {:db/id "answer-e22cde76-a74c-500b-b6af-756ccafc7a0f" :answer/id #uuid "e22cde76-a74c-500b-b6af-756ccafc7a0f" :answer/type :answer.type/text :answer/value "$P$ only" :db/ensure [:answer/validate]} {:db/id "answer-c7d3dadc-f62a-5cdf-b969-e5976107e24e" :answer/id #uuid "c7d3dadc-f62a-5cdf-b969-e5976107e24e" :answer/type :answer.type/text :answer/value "$Q$ and $R$ only" :db/ensure [:answer/validate]} {:db/id "answer-241ec206-34ba-5db3-8740-a7379250c1e3" :answer/id #uuid "241ec206-34ba-5db3-8740-a7379250c1e3" :answer/type :answer.type/text :answer/value "$Q$ only" :db/ensure [:answer/validate]} {:db/id "question-3bd80b9b-2655-5bf4-bdf9-f7428c6e7e13" :question/id #uuid "3bd80b9b-2655-5bf4-bdf9-f7428c6e7e13" :question/math-academy-id "q-175327" :question/problem "Which of the following are mathematical predicates of one variable?\n\nI. $z$ divided by $10.$\n\nII. $x\\times 3$\n\nIII. $y+3$ is an odd number." :question/worked-solution "A *predicate* of one variable is a sentence that contains the variable defined on some *universal set* and has the property that when we substitute any concrete value of the variable into the predicate, the result becomes a statement that is either true or false.\n\nWith that in mind, let's examine our options. \n\n- Option I is *not* a predicate. Substituting a concrete value for $z$ into the sentence, we do not get a statement that is either true or false.\n\n- Option II is *not* a predicate. Substituting a concrete value for $x$ into the sentence, we do not get a statement that is either true or false.\n\n- Option III is a predicate. Substituting a concrete value for $y$ into the sentence, we get a statement that is either true or false.\n\nTherefore, the correct answer is \"III only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-99fd9b59-7583-550f-9b77-a9aef65a8d04"] :db/ensure [:question/validate]} {:db/id "answer-field-99fd9b59-7583-550f-9b77-a9aef65a8d04" :answer-field/id #uuid "99fd9b59-7583-550f-9b77-a9aef65a8d04" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-dafd16df-e541-559b-bbe3-f28f607b45b9" :answer-field/choices ["answer-01804a80-5ad0-5362-964c-9ececb6d064d" "answer-3b8e51e4-40fa-57ba-90ff-180ebb919ccb" "answer-8405f8f8-e192-530e-9104-fc411cda42f6" "answer-725de94a-3ee8-5f32-b2e7-5e74ed4217f0" "answer-dafd16df-e541-559b-bbe3-f28f607b45b9"] :db/ensure [:answer-field/validate]} {:db/id "answer-01804a80-5ad0-5362-964c-9ececb6d064d" :answer/id #uuid "01804a80-5ad0-5362-964c-9ececb6d064d" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-3b8e51e4-40fa-57ba-90ff-180ebb919ccb" :answer/id #uuid "3b8e51e4-40fa-57ba-90ff-180ebb919ccb" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-8405f8f8-e192-530e-9104-fc411cda42f6" :answer/id #uuid "8405f8f8-e192-530e-9104-fc411cda42f6" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "answer-725de94a-3ee8-5f32-b2e7-5e74ed4217f0" :answer/id #uuid "725de94a-3ee8-5f32-b2e7-5e74ed4217f0" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-dafd16df-e541-559b-bbe3-f28f607b45b9" :answer/id #uuid "dafd16df-e541-559b-bbe3-f28f607b45b9" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-f4fa3c45-5e91-57f0-a165-1adda22fdfd5" :question/id #uuid "f4fa3c45-5e91-57f0-a165-1adda22fdfd5" :question/math-academy-id "q-175340" :question/problem "Which of the following are mathematical predicates of one variable?\n\nI. $P(n):$ ${n}^{2}$ is odd.\n\nII. $Q(x):$ $(x+2)|5$\n\nIII. $R(y):$ $y$ is a multiple of $4.$" :question/worked-solution "A *predicate* of one variable is a sentence that contains the variable defined on some *universal set* and has the property that when we substitute any concrete value of the variable into the predicate, the result becomes a statement that is either true or false.\n\nWith that in mind, let's examine our options. \n\n- Option I is a predicate. Substituting a concrete value for $n$ into the sentence, we get a statement that is either true or false.\n\n- Option II is a predicate. Substituting a concrete value for $x$ into the sentence, we get a statement that is either true or false.\n\n- Option III is a predicate. Substituting a concrete value for $y$ into the sentence, we get a statement that is either true or false.\n\nTherefore, the correct answer is \"I, II, and III.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-dd1c7fcd-33d6-50f3-a903-c3e604c9e00d"] :db/ensure [:question/validate]} {:db/id "answer-field-dd1c7fcd-33d6-50f3-a903-c3e604c9e00d" :answer-field/id #uuid "dd1c7fcd-33d6-50f3-a903-c3e604c9e00d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e0274858-530a-5336-a244-3ab577098764" :answer-field/choices ["answer-ce19c34c-55f0-53bd-90d0-5654a556e400" "answer-3df4871b-4533-56fb-bc7b-dd5a4905e0bc" "answer-e0274858-530a-5336-a244-3ab577098764" "answer-baae5ccd-bb5f-5df3-b5b6-228fe5505245" "answer-d12f7ee4-e6d2-572c-bc6f-c2a4f216d210"] :db/ensure [:answer-field/validate]} {:db/id "answer-ce19c34c-55f0-53bd-90d0-5654a556e400" :answer/id #uuid "ce19c34c-55f0-53bd-90d0-5654a556e400" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-3df4871b-4533-56fb-bc7b-dd5a4905e0bc" :answer/id #uuid "3df4871b-4533-56fb-bc7b-dd5a4905e0bc" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-e0274858-530a-5336-a244-3ab577098764" :answer/id #uuid "e0274858-530a-5336-a244-3ab577098764" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "answer-baae5ccd-bb5f-5df3-b5b6-228fe5505245" :answer/id #uuid "baae5ccd-bb5f-5df3-b5b6-228fe5505245" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-d12f7ee4-e6d2-572c-bc6f-c2a4f216d210" :answer/id #uuid "d12f7ee4-e6d2-572c-bc6f-c2a4f216d210" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id 17592186056004 :tutorial/content "A **mathematical statement** is a sentence or mathematical expression that is either **true** or **false**.\n\nFor example:\n\n- The sentence, \"The sum of $1$ and $2$ is $3$\" is a mathematical statement because it is *true.*\n\n- Likewise, \"$2+2=5$\" is a mathematical statement because it is *false.*\n\nThe following examples are *not* mathematical statements:\n\n- \"Find the sum of $1$ and $2$\" is *not* a mathematical statement because it is neither true nor false. It is an instruction.\n\n- \"What is the sum of $1$ and $2?$\" is *not* a mathematical statement because it is neither true nor false. It is a question.\n\n- Similarly, \"$6+9$\" is *not* a mathematical statement because it is neither true nor false.\n\nWe often use upper-case letters such as $P, Q,$ and $R$ to represent statements. For example:\n\n- $P:$ The sum of two even integers is odd.\n\n- $Q: 3 \\in \\mathbb Z$\n\n- $R: \\{2,4,6\\ldots\\}\\cup \\{1,3,5,\\ldots\\} = \\mathbb N$\n\nIn this case, the statements $Q$ and $R$ are true, whereas statement $P$ is false." :db/ensure [:tutorial/validate]} {:db/id 17592186056051 :tutorial/content "A **predicate** (or **open sentence**) of one variable is a sentence that contains a variable defined on some *universal set* and has the property that when we substitute a concrete value of the variable into the predicate, the result becomes a mathematical statement that is either *true* or *false*.\n\nFor example, consider the following predicate:\n\n$x > 1$\n\nThis is a predicate because substituting concrete values for $x$ gives a mathematical statement.\n\nFor instance: \n\n- Substituting $x=2$ gives the *true* statement \"$2 > 1$\"\n\n- Substituting $x=5$ gives the *true* statement \"$5 > 1$\"\n\n- Substituting $x=0$ gives the *false* statement \"$0 > 1$\"\n\nWe denote predicates using capital letters and the corresponding variable in parentheses. In this example, we can write our predicate more formally as follows:\n\n$P(x):$ $x > 1$\n\nAny predicate must be defined with its **universal set,** which is the set from which we are allowed to pull the concrete values of the variable. So, we could state our predicate more formally as\n\n$P(x):$ $x > 1,$ $\\quad$ where $x \\in \\mathbb{R}.$\n\nThe universal set can often be identified from the context and doesn't need to be explicitly stated. For example, if we have the predicate \n\n$n$ is divisible by 5,\n\nwe can assume that $n$ is defined on the set of all integers, i.e., $n \\in \\mathbb{Z}.$\n\nIn math, *any equation or inequality is a predicate*. However, a sentence containing a variable is not necessarily a predicate. For example, the sentence \n\n$\\qquad$ \"What is the sign of $y?$\"\n\nis *not* a predicate because substituting a concrete value for $y$ does not give a mathematical statement. Instead, it gives a question. \n\nSimilarly, \n\n$z^2-5$\n\nis *not* a predicate either. It's just an expression." :db/ensure [:tutorial/validate]} {:db/id 17592186054913 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]}] "assertions" [[17592186054451 :question/problem "Which of the following are mathematical predicates of one variable?\n\nI. Subtract $x$ from $10.$\n\nII. $y^2 -2  \\leq 3$\n\nIII. $1+z$ is a perfect square."] ["question-dd39dbfa-f77c-5216-9581-0acf72d83216" :question/id #uuid "dd39dbfa-f77c-5216-9581-0acf72d83216"] ["question-dd39dbfa-f77c-5216-9581-0acf72d83216" :question/math-academy-id "q-174325"] ["question-dd39dbfa-f77c-5216-9581-0acf72d83216" :question/problem "Which of the following statements are false?\n\n- $P:$ $\\sqrt{2}=1$\n\n- $Q:$ ${3}^{2}=9$\n\n- $R:$ $8$ is a composite number."] ["question-dd39dbfa-f77c-5216-9581-0acf72d83216" :question/worked-solution "A mathematical statement is a sentence or mathematical expression that is either true or false.\n\nWith that in mind, let's evaluate the truth value of each statement:\n\n- Statement $P$ is *false* because $\\sqrt{2}\\ne 1.$\n\n- Statement $Q$ is *true.* Indeed, ${3}^{2}=9.$\n\n- Statement $R$ is *true.* Indeed, $8$ is a composite number.\n\nTherefore, the correct answer is \"$P$ only.\""] ["question-dd39dbfa-f77c-5216-9581-0acf72d83216" :question/difficulty :question.difficulty/moderate] ["answer-field-6ffec692-aff6-5f8a-8ed2-ad2d3be592a8" :answer-field/id #uuid "6ffec692-aff6-5f8a-8ed2-ad2d3be592a8"] ["answer-d9be00a6-31bb-5125-a45a-0d2e2a0dff31" :answer/id #uuid "d9be00a6-31bb-5125-a45a-0d2e2a0dff31"] ["answer-d9be00a6-31bb-5125-a45a-0d2e2a0dff31" :answer/type :answer.type/text] ["answer-d9be00a6-31bb-5125-a45a-0d2e2a0dff31" :answer/value "$P$ and $Q$ only"] ["answer-7f396bcf-805d-593a-bc0f-08d9c2160e96" :answer/id #uuid "7f396bcf-805d-593a-bc0f-08d9c2160e96"] ["answer-7f396bcf-