edb/ref 17592186055044 :knowledge-point/_questions [{:db/id #edb/ref 17592186054820 :knowledge-point/id #uuid "35eba041-5109-5855-b132-174c0271c168" :knowledge-point/title "Identifying Predicates"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88ca2b5c-6791-591f-abda-f27884967edc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459617} {:answer/id #uuid "c56bf6b0-66f4-518a-a6ce-ba874d1a9c55" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459618}] :answer-field/correct {:answer/id #uuid "c56bf6b0-66f4-518a-a6ce-ba874d1a9c55" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459618} :answer-field/id #uuid "24a6ed8a-17b7-51a7-bb49-dcf74e7ade9b" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460675} {:answer-field/choices [{:answer/id #uuid "04cb5f8b-73b3-5617-abfc-6b43148614ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459619} {:answer/id #uuid "6f8f35e0-edab-543a-a110-589cb05bd8d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459620}] :answer-field/correct {:answer/id #uuid "6f8f35e0-edab-543a-a110-589cb05bd8d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459620} :answer-field/id #uuid "96184caa-a44f-51b9-bafe-5eddcc9cb49b" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460676} {:answer-field/choices [{:answer/id #uuid "acb09f9b-41e0-580c-a041-095bbce4770b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459621} {:answer/id #uuid "868a0a7e-8c6e-5345-b4ea-51218d4e274a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459622}] :answer-field/correct {:answer/id #uuid "acb09f9b-41e0-580c-a041-095bbce4770b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459621} :answer-field/id #uuid "42968c23-3a57-5e5b-b613-c57e6362a57d" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460677}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c5327827-bdd3-59f2-8ac3-6f2fcb1af21e" :question/math-academy-id "q-171486" :question/problem "Which of the following are mathematical predicates of one variable?\n- **I.** $P(n):$ $n$ is even.\n- **II.** $Q(x):$ ${x}^{2}-x\\ge 1$\n- **III.** $R(y):$ Draw a line of width $y\\,\\text{cm}.$\n\nSelect all that apply." :question/worked-solution "A *predicate* of one variable is a sentence that contains the variable defined on some *universal set* and has the property that when we substitute any concrete value of the variable into the predicate, the result becomes a statement that is either true or false.\n\nWith that in mind, let's examine our options. \n\n- Option I is a predicate. Substituting a concrete value for $n$ into the sentence, we get a statement that is either true or false.\n\n- Option II is a predicate. Substituting a concrete value for $x$ into the sentence, we get a statement that is either true or false.\n\n- Option III is *not* a predicate. Substituting a concrete value for $y$ into the sentence, we do not get a statement that is either true or false. Rather, it will give an instruction.\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186378988 :knowledge-point/_questions [{:db/