1}}A{v}_{1} \\\\  & =\\frac{1}{5}[\\begin{aligned}2 & -3 \\\\ -3 & 2 \\\\ -2 & -2\\end{aligned}][\\begin{aligned}-\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}] \\\\  & =\\frac{1}{5}[\\begin{aligned}-\\frac{5}{\\sqrt{2}} \\\\ \\frac{5}{\\sqrt{2}} \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}-\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\n- Then, we compute ${u}_{2}:$\n\n$$\n\\begin{aligned}{u}_{2} & =\\frac{1}{{\\sigma }_{2}}A{v}_{2} \\\\  & =\\frac{1}{3}[\\begin{aligned}2 & -3 \\\\ -3 & 2 \\\\ -2 & -2\\end{aligned}][\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}] \\\\  & =\\frac{1}{3}[\\begin{aligned}-\\frac{1}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{2}} \\\\ -\\frac{4}{\\sqrt{2}}\\end{aligned}] \\\\  & =[\\begin{aligned}-\\frac{1}{3\\sqrt{2}} \\\\ -\\frac{1}{3\\sqrt{2}} \\\\ -\\frac{4}{3\\sqrt{2}}\\end{aligned}]\\end{aligned}\n$$\n\nSince we do not have the third singular value, we can't use the same formula to find the third column of $U.$ But we know that $U$ must be orthogonal. Hence, we must find a vector \n\n$$\n{u}_{3}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]\n$$\n\nsuch that \n\n$$\n\\{\\begin{aligned}{u}_{1}\\cdot {u}_{3}=0 \\\\ {u}_{2}\\cdot {u}_{3}=0,\\end{aligned}\\,‖{u}_{3}‖=1.\n$$\n\nSolving this system, which is equivalent to\n\n$$\n\\{\\begin{aligned}-\\frac{1}{\\sqrt{2}}{x}_{1}+\\frac{1}{\\sqrt{2}}{x}_{2}=0 \\\\ -\\frac{1}{3\\sqrt{2}}{x}_{1}-\\frac{1}{3\\sqrt{2}}{x}_{2}-\\frac{4}{3\\sqrt{2}}{x}_{3}=0\\end{aligned}\\,⟹\\,\\{\\begin{aligned}-{x}_{1}+{x}_{2}=0 \\\\ -{x}_{1}-{x}_{2}-4{x}_{3}=0,\\end{aligned}\n$$\n\nwe get the nonzero normalized solution \n\n$$\n{u}_{3}=[\\begin{aligned}-\\frac{2}{3} \\\\ -\\frac{2}{3} \\\\ \\frac{1}{3}\\end{aligned}].\n$$\n\nFinally, we construct the matrix $U:$\n\n$$\nU=[\\begin{aligned}-\\frac{1}{\\sqrt{2}} & -\\frac{1}{3\\sqrt{2}} & -\\frac{2}{3} \\\\ \\frac{1}{\\sqrt{2}} & -\\frac{1}{3\\sqrt{2}} & -\\frac{2}{3} \\\\ 0 & -\\frac{4}{3\\sqrt{2}} & \\frac{1}{3}\\end{aligned}]\n$$" #edb/ref 17592186045417] [17592186408022 #edb/ref 1062 #uuid "e2882521-8d21-5a7b-8813-60683b9344e3" #edb/ref 17592186045417] [17592186408022 #edb/ref 1063 #edb/ref 17592186408019 #edb/ref 17592186045417] [17592186408023 #edb/ref 1058 #edb/ref 17592186408024 #edb/ref 17592186045417] [17592186408023 #edb/ref 1062 #uuid "e4884cf0-a1fa-595d-912e-314992ac2509" #edb/ref 17592186045417] [17592186408023 #edb/ref 1063 #edb/ref 17592186408020 #edb/ref 17592186045417] [17592186408024 #edb/ref 1058 #edb/ref 17592186408022 #edb/ref 17592186045417] [17592186408024 #edb/ref 1062 #uuid "e6c10cae-3311-5de0-80be-f4f348e2b025" #edb/ref 17592186045417] [17592186408024 #edb/ref 1063 #edb/ref 17592186408021 #edb/ref 17592186045417] [17592186423681 #edb/ref 1080 "-{x}_{2}" #edb/ref 17592186045417] [17592186423681 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186423681 #edb/ref 1083 #uuid "090773ee-4399-5d8b-a22d-60096852f053" #edb/ref 17592186045417] [17592186423682 #edb/ref 1080 "-\\frac{4}{3\\sqrt{5}}" #edb/ref 17592186045417] [17592186423682 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186423682 #edb/ref 1083 #uuid "0a42a653-0c61-504f-9112-9be979a720b4" #edb/ref 17592186045417] [17592186423684 #edb/ref 1080 "\\frac{4}{3\\sqrt{5}}" #edb/ref 17592186045417] [17592186423684 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186423684 #edb/ref 1083 #uuid "1069812e-7744-5b02-8689-784dcf2289c4" #edb/ref 17592186045417] [17592186423688 #edb/ref 1080 "-\\frac{1}{\\sqrt{5}}" #edb/ref 17592186045417] [17592186423688 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186423688 #edb/ref 1083 #uuid "1bb23bb5-3483-5614-b88a-de724eaace0f" #edb/ref 17592186045417] [17592186423690 #edb/ref 1080 "-\\frac{5}{3\\sqrt{5}}" #edb/ref 17592186045417] [17592186423690 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186423690 #edb/ref 1083