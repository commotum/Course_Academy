      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14132899/observations/step-q6809-4b1b873a1398a3f14eba.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14132899/observations/step-q6809-4b1b873a1398a3f14eba.png",
