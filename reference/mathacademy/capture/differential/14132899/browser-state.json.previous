mrow><mi>x</mi></mrow></mfrac></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>4</mn><mo>⋅</mo><mn>5</mn></mrow><msup><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">e</mi></mrow><mn>5</mn></msup></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mfrac><mn>20</mn><msup><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">e</mi></mrow><mn>5</mn></msup></mfrac><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
