2} \\\\ (4t+8)^{2} & =0 \\\\ 4t+8 & =0 \\\\ 4t & =-8 \\\\ t & =-2.\\end{aligned}\n$$\n\nNow, we substitute our solutions back into the equations of the line. For $t=-2,$ we have\n\n$$\n\\left\\{\\begin{aligned}x &=4(-2)+8=0 \\\\ y &=-2 \\\\ z &=-2.\\end{aligned}\\right.\n$$\n\nTherefore, the point of intersection is $(0,-2,-2).$" #edb/ref 17592186045443] [17592186375571 #edb/ref 1075 #edb/ref 17592186375572 #edb/ref 17592186045417] [17592186375571 #edb/ref 1075 #edb/ref 17592186375573 #edb/ref 17592186045417] [17592186375571 #edb/ref 1075 #edb/ref 17592186375574 #edb/ref 17592186045417] [17592186375571 #edb/ref 1075 #edb/ref 17592186375575 #edb/ref 17592186045417] [17592186375571 #edb/ref 1075 #edb/ref 17592186375576 #edb/ref 17592186045417] [17592186375571 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186375571 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186375571 #edb/ref 1078 #edb/ref 17592186375573 #edb/ref 17592186045417] [17592186375571 #edb/ref 1079 #uuid "5dd145b8-554f-5187-843c-4effb83714b4" #edb/ref 17592186045417] [17592186375572 #edb/ref 1080 "$(12,1,1)$ and $(4,-1,-1)$" #edb/ref 17592186045417] [17592186375572 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186375572 #edb/ref 1083 #uuid "2c1a8864-0937-5a93-b9ed-6eb831acf7c5" #edb/ref 17592186045417] [17592186375573 #edb/ref 1080 "$(0,-2,-2)$  only" #edb/ref 17592186045417] [17592186375573 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186375573 #edb/ref 1083 #uuid "2a8ad80b-85a9-584c-8568-2b5e5a98f98a" #edb/ref 17592186045417] [17592186375574 #edb/ref 1080 "$(-4,-3,-3)$   only" #edb/ref 17592186045417] [17592186375574 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186375574 #edb/ref 1083 #uuid "02e1c7c6-dccd-53e2-9aec-f9596ed92975" #edb/ref 17592186045417] [17592186375575 #edb/ref 1080 "$(16,2,2)$  and $(0,-2,-2)$" #edb/ref 17592186045417] [17592186375575 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17