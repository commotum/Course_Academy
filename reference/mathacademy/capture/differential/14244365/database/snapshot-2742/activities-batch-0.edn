ee5a-75fc-5e2b-8002-cf62c42bfe1d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240456}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a4963b43-3177-544a-ab68-1ea699a13395" :question/math-academy-id "q-105166" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ -2 \\\\ 3\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}2 \\\\ -3 \\\\ 5\\end{bmatrix},\\,b=\\begin{bmatrix}-3 \\\\ 1 \\\\ -4\\end{bmatrix}.\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=b,$ then what is ${x}_{1}+{x}_{2}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=b$, then we have\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}1 \\\\ -2 \\\\ 3\\end{bmatrix}+{x}_{2}\\begin{bmatrix}2 \\\\ -3 \\\\ 5\\end{bmatrix} & =\\begin{bmatrix}-3 \\\\ 1 \\\\ -4\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1} \\\\ -2{x}_{1} \\\\ 3{x}_{1}\\end{bmatrix}+\\begin{bmatrix}2{x}_{2} \\\\ -3{x}_{2} \\\\ 5{x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-3 \\\\ 1 \\\\ -4\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1}+2{x}_{2} \\\\ -2{x}_{1}-3{x}_{2} \\\\ 3{x}_{1}+5{x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-3 \\\\ 1 \\\\ -4\\end{bmatrix}.\\end{aligned}\n$$\n\n \n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+2{x}_{2} &=-3 \\\\ -2{x}_{1}-3{x}_{2} &=1 \\\\ 3{x}_{1}+5{x}_{2} &=-4\\end{aligned}\\right.\n$$\n\nMultiplying the first equation by $2$ and adding the resulting equations, we obtain \n\n$$\n\\begin{aligned}{x}_{2} & =-5,\\end{aligned}\n$$\n\nwhich we substitute into the second equation to get \n\n$$\n\\begin{aligned}-2{x}_{1}-3{x}_{2}=1 \\\\ -2{x}_{1}-3(-5) & =1 \\\\ -2{x}_{1} & =-14 \\\\ {x}_{1} & =7.\\end{aligned}\n$$\n\nFinally, we substitute ${x}_{1}=7$ and ${x}_{2}=-5$ into the third equation and obtain\n\n$$\n\\begin{aligned}3{x}_{1}+5{x}_{2}=-4 \\\\ 3(7)+5(-5) & =-4 \\\\ -4 & =-4,\\end{aligned}\n$$\n\nwhich gives a true statement. \n\nSo the solution of the system is ${x}_{1}=7$ and ${x}_{2}=-5,$ which means\n\n$$\n7{a}_{1}-5{a}_{2}=b.\n$$\n\nConsequently, \n\n$$\n{x}_{1}+{x}_{2}=7+(-5)=2.\n$$"} :step/id #uuid "130d098a-c26b-57ed-9a17-40b7cc7b707e"} {:db/id #edb/ref 17592186435827 :step/content {:db/id #edb/ref 17592186435824 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b3b3e4e-ca03-5bf0-b918-e879378cf4f9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186435813} {:answer/id #uuid "3e56b548-f823-5efc-89ba-5bfa7fe486df" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11" :db/id #edb/ref 17592186435814} {:answer/id #uuid "62cff3cd-01fc-5c8d-bb73-00c6490598f8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-11" :db/id #edb/ref 17592186435815} {:answer/id #uuid "7f4f8e1e-a357-552c-aea0-48de6f4f316a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-7" :db/id #edb/ref 17592186435817} {:answer/id #uuid "a0c118c7-81b9-5bfc-90ce-dd9634f5f92e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186435820}] :answer-field/correct {:db/id #edb/ref 17592186435814} :answer-field/id #uuid "a66e7a5d-9617-5080-a5e0-b50e86007465" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186435823}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e8bdc664-5423-57fc-a753-871b318d24e0" :question/math-academy-id "q-34598" :question/problem "Find the value of ${x}_{1}-{x}_{2}$ given that  $4a+3x=b$ and\n\n$$\na=\\begin{bmatrix}3 \\\\ 3 \\\\ 3\\end{bmatrix},\\,x=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix},\\,b=\\begin{bmatrix}18 \\\\ -15 \\\\ -9\\end{bmatrix}.\n$$" :question/worked-solution "Using the properties of addition/subtraction and scalar multiplication of vectors to isolate $x,$ we get\n\n$$\n\\begin{aligned}4a+3x & =b \\\\ 3x & =b-4a \\\\ x & =\\frac{1}{3}(b-4a) \\\\ x & =\\frac{1}{3}(\\begin{bmatrix}18 \\\\ -15 \\\\ -9\\end{bmatrix}-4\\begin{bmatrix}3 \\\\ 3 \\\\ 3\\end{bmatrix}) \\\\ x & =\\frac{1}{3}\\begin{bmatrix}6 \\\\ -27 \\\\ -21\\end{bmatrix} \\\\ x & =\\begin{bmatrix}2 \\\\ -9 \\\\ -7\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, ${x}_{1}-{x}_{2}=2-(-9)=11.$"} :step/id #uuid "1ba155e6-7a63-58b8-ae54-fd477a157b3e" :step/next {:db/id #edb/ref 17592186435830}} {:db/id #edb/ref 17592186435828 :step/content {:db/id #edb/ref 17592186342133 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0dd1e2d3-3d25-597c-a847-faa140432c9c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186339255} {:answer/id #uuid "28a2b981-6db8-5f16-b21b-6ae088a23e3d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No solution" :db/id #edb/ref 17592186339484} {:answer/id #uuid "309c51a6-6646-55e5-a9ef-db0cd36bd5b0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186339553} {:answer/id #uuid "732f8930-5de1-53c0-8f9f-0564fc2ea176" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186340149} {:answer/id #uuid "d7a94670-179b-5241-8088-b40d00d22100" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186341041}] :answer-field/correct {:db/id #edb/ref 17592186339553} :answer-field/id #uuid "95f0dc3f-6280-5dbc-ad92-0375cafd9b79" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341644}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "237520c7-3369-5c34-87a7-ba4be3c9b705" :question/math-academy-id "q-74032" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}1 \\\\ -2 \\\\ 2\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}3 \\\\ -11 \\\\ 1\\end{bmatrix},\\,b=\\begin{bmatrix}5 \\\\ -18 \\\\ -1\\end{bmatrix}.\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b,$ then what is ${x}_{1}+{x}_{2}+{x}_{3}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b$, then we have\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}+{x}_{2}\\begin{bmatrix}1 \\\\ -2 \\\\ 2\\end{bmatrix}+{x}_{3}\\begin{bmatrix}3 \\\\ -11 \\\\ 1\\end{bmatrix} & =\\begin{bmatrix}5 \\\\ -18 \\\\ -1\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1} \\\\ 0 \\\\ {x}_{1}\\end{bmatrix}+\\begin{bmatrix}{x}_{2} \\\\ -2{x}_{2} \\\\ 2{x}_{2}\\end{bmatrix}+\\begin{bmatrix}3{x}_{3} \\\\ -11{x}_{3} \\\\ {x}_{3}\\end{bmatrix} & =\\begin{bmatrix}5 \\\\ -18 \\\\ -1\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1}+{x}_{2}+3{x}_{3} \\\\ -2{x}_{2}-11{x}_{3} \\\\ {x}_{1}+2{x}_{2}+{x}_{3}\\end{bmatrix} & =\\begin{bmatrix}5 \\\\ -18 \\\\ -1\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+{x}_{2}+3{x}_{3} &=5 \\\\ -2{x}_{2}-11{x}_{3} &=-18 \\\\ {x}_{1}+2{x}_{2}+{x}_{3} &=-1\\end{aligned}\\right.\n$$\n\nWe will solve this system using Gaussian elimination. First, we write the augmented matrix for this system:\n\n$$\nM=\\begin{bmatrix}1 & 1 & 3 & 5 \\\\ 0 & -2 & -11 & -18 \\\\ 1 & 2 & 1 & -1\\end{bmatrix}.\n$$\n\nRow-reducing the augmented matrix, we get\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 1 & 3 & 5 \\\\ 0 & -2 & -11 & -18 \\\\ 1 & 2 & 1 & -1\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-1){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 1 & 3 & 5 \\\\ 0 & -2 & -11 & -18 \\\\ 0 & 1 & -2 & -6\\end{bmatrix} & {R}_{2} & ↔{R}_{3} \\\\  & ∼\\begin{bmatrix}1 & 1 & 3 & -1 \\\\ 0 & 1 & -2 & -6 \\\\ 0 & -2 & -11 & -18\\end{bmatrix} & {R}_{3} & :={R}_{3}+2{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 1 & 3 & 5 \\\\ 0 & 1 & -2 & -6 \\\\ 0 & 0 & -15 & -30\\end{bmatrix} & {R}_{3} & :=-\\frac{1}{15}{R}_{3} \\\\  & ∼\\begin{bmatrix}1 & 1 & 3 & 5 \\\\ 0 & 1 & -2 & -6 \\\\ 0 & 0 & 1 & 2\\end{bmatrix}.\\end{aligned}\n$$\n\n \n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+{x}_{2}+3{x}_{3} &=5 \\\\ {x}_{2}-2{x}_{3} &=-6 \\\\ {x}_{3} &=2.\\end{aligned}\\right.\n$$\n\n \n\nFrom the third equation, we get ${x}_{3}=2.$ Substituting this value into  the second equation, we get\n\n$$\n{x}_{2}-2(2)=-6\\,⟹\\,{x}_{2}=-2.\n$$\n\n \n\nFinally, by substituting ${x}_{2}=-2$ and ${x}_{3}=2$ into the first equation, we obtain \n\n$$\n\\begin{aligned}{x}_{1}+{x}_{2}+3{x}_{3} & =5 \\\\ {x}_{1}+(-2)+3(2) & =5 \\\\ {x}_{1}+4 & =5 \\\\ {x}_{1} & =1.\\end{aligned}\n$$\n\nSo, the solution of the system is ${x}_{1}=1$, ${x}_{2}=-2$, and ${x}_{3}=2,$ which means \n\n$$\n{a}_{1}-2{a}_{2}+2{a}_{3}=b.\n$$\n\nConsequently, \n\n$$\n{x}_{1}+{x}_{2}+{x}_{3}=1+(-2)+2=1.\n$$"} :step/id #uuid "35ab3d0c-3feb-5eb0-8af0-2d726c5cb861" :step/next {:db/id #edb/ref 17592186435826}} {:db/id #edb/ref 17592186435829 :step/content {:db/id #edb/ref 17592186342130 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ca1e367-7e59-5b69-861b-8c5df685d98a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-12" :db/id #edb/ref 17592186339240} {:answer/id #uuid "70e98200-2ef8-5fee-9135-1a64cdf08565" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186340130} {:answer/id #uuid "a0f91210-c308-5ac5-8b5f-ecea8232309c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14" :db/id #edb/ref 17592186340589} {:answer/id #uuid "cd78319b-964c-5a76-83e0-5cc4ba5b698b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No solution" :db/id #edb/ref 17592186340951} {:answer/id #uuid "d5c0ee9d-d678-5d90-ac70-ae36c44cd666" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-7" :db/id #edb/ref 17592186341020}] :answer-field/correct {:db/id #edb/ref 17592186340951} :answer-field/id #uuid "d6466acd-a8cc-51d2-bb7d-d48bfacf96c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341757}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "ff5142a4-ab7b-5300-baa5-14f6253ed7fa" :question/math-academy-id "q-74006" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}2 \\\\ -1 \\\\ -1\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}0 \\\\ -1 \\\\ -3\\end{bmatrix},\\,b=\\begin{bmatrix}-2 \\\\ 5 \\\\ 1\\end{bmatrix}.\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b,$ then what is ${x}_{1}+{x}_{2}+{x}_{3}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b,$ then   we have\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}+{x}_{2}\\begin{bmatrix}2 \\\\ -1 \\\\ -1\\end{bmatrix}+{x}_{3}\\begin{bmatrix}0 \\\\ -1 \\\\ -3\\end{bmatrix} & =\\begin{bmatrix}-2 \\\\ 5 \\\\ 1\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1} \\\\ 0 \\\\ {x}_{1}\\end{bmatrix}+\\begin{bmatrix}2{x}_{2} \\\\ -{x}_{2} \\\\ -{x}_{2}\\end{bmatrix}+\\begin{bmatrix}0 \\\\ -{x}_{3} \\\\ -3{x}_{3}\\end{bmatrix} & =\\begin{bmatrix}-2 \\\\ 5 \\\\ 1\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1}+2{x}_{2} \\\\ -{x}_{2}-{x}_{3} \\\\ {x}_{1}-{x}_{2}-3{x}_{3}\\end{bmatrix} & =\\begin{bmatrix}-2 \\\\ 5 \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+2{x}_{2} &=-2 \\\\ -{x}_{2}-{x}_{3} &=5 \\\\ {x}_{1}-{x}_{2}-3{x}_{3} &=1\\end{aligned}\\right.\n$$\n\nWe will solve this system using Gaussian elimination. First, we write the augmented matrix for this system:\n\n$$\nM=\\begin{bmatrix}1 & 2 & 0 & -2 \\\\ 0 & -1 & -1 & 5 \\\\ 1 & -1 & -3 & 1\\end{bmatrix}.\n$$\n\nRow-reducing the augmented matrix, we get\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 2 & 0 & -2 \\\\ 0 & -1 & -1 & 5 \\\\ 1 & -1 & -3 & 1\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-1){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & 0 & -2 \\\\ 0 & -1 & -1 & 5 \\\\ 0 & -3 & -3 & 3\\end{bmatrix} & {R}_{2} & :=(-1){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 2 & 0 & -2 \\\\ 0 & 1 & 1 & -5 \\\\ 0 & -3 & -3 & 3\\end{bmatrix} & {R}_{3} & :={R}_{3}+3{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 2 & 0 & -2 \\\\ 0 & 1 & 1 & -5 \\\\ 0 & 0 & 0 & -12\\end{bmatrix}.\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+2{x}_{2} &=-2 \\\\ {x}_{2}+{x}_{3} &=-5 \\\\ 0 &=-12.\\end{aligned}\\right.\n$$\n\nHowever, the final equation $0=-12$  gives a false statement. So the system has no solution."} :step/id #uuid "65c83c6b-907c-5488-b33a-fa5563a73ab2" :step/next {:db/id #edb/ref 17592186435828}} {:db/id #edb/ref 17592186435830 :step/content {:db/id #edb/ref 17592186435825 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fdd8247-3e99-5680-9837-f81ce2e4daa8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186435812} {:answer/id #uuid "6588aecf-5be8-5075-92ab-05e2c0bd205f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No solution" :db/id #edb/ref 17592186435816} {:answer/id #uuid "877b327c-7099-5b51-a1a0-e54f12c801d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186435818} {:answer/id #uuid "9a314fbe-bce0-5c72-becd-d86fdd89cb4c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186435819} {:answer/id #uuid "b6573507-37c6-5328-ab6e-7644606e55a7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186435821}] :answer-field/correct {:db/id #edb/ref 17592186435819} :answer-field/id #uuid "50ab6af3-7838-5baf-b926-7d20ec2e1151" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186435822}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e9e20ff9-23b3-5457-a430-304f98c0d839" :question/math-academy-id "q-73950" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=\\begin{bmatrix}3 \\\\ 4 \\\\ 2\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}-2 \\\\ 3 \\\\ -3\\end{bmatrix},\\,b=\\begin{bmatrix}-11 \\\\ 8 \\\\ -14\\end{bmatrix}.\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=b,$ then what is ${x}_{1}+{x}_{2}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=b$, then we have\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}3 \\\\ 4 \\\\ 2\\end{bmatrix}+{x}_{2}\\begin{bmatrix}-2 \\\\ 3 \\\\ -3\\end{bmatrix} & =\\begin{bmatrix}-11 \\\\ 8 \\\\ -14\\end{bmatrix} \\\\ \\begin{bmatrix}3{x}_{1} \\\\ 4{x}_{1} \\\\ 2{x}_{1}\\end{bmatrix}+\\begin{bmatrix}-2{x}_{2} \\\\ 3{x}_{2} \\\\ -3{x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-11 \\\\ 8 \\\\ -14\\end{bmatrix} \\\\ \\begin{bmatrix}3{x}_{1}-2{x}_{2} \\\\ 4{x}_{1}+3{x}_{2} \\\\ 2{x}_{1}-3{x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-11 \\\\ 8 \\\\ -14\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}3{x}_{1}-2{x}_{2} &=-11 \\\\ 4{x}_{1}+3{x}_{2} &=8 \\\\ 2{x}_{1}-3{x}_{2} &=-14\\end{aligned}\\right.\n$$\n\nAdding the second and the third equations we get \n\n$$\n\\begin{aligned}6{x}_{1} & =-6 \\\\ {x}_{1} & =-1,\\end{aligned}\n$$\n\nwhich we substitute into the second equation to get \n\n$$\n\\begin{aligned}4{x}_{1}+3{x}_{2} & =8 \\\\ 4(-1)+3{x}_{2} & =8 \\\\ 3{x}_{2} & =12 \\\\ {x}_{2} & =4.\\end{aligned}\n$$\n\nFinally, we substitute ${x}_{1}=-1$ and ${x}_{2}=4$ into the first equation to get\n\n$$\n\\begin{aligned}3{x}_{1}-2{x}_{2} & =-11 \\\\ 3(-1)-2(4) & =-11 \\\\ -11 & =-11,\\end{aligned}\n$$\n\nwhich gives a true statement. \n\nSo the solution of the system is ${x}_{1}=-1$ and ${x}_{2}=4,$ which means\n\n$$\n-{a}_{1}+4{a}_{2}=b.\n$$\n\nConsequently, \n\n$$\n{x}_{1}+{x}_{2}=-1+4=3.\n$$"} :step/id #uuid "b586b47f-7e9b-5e1b-a1bb-ec0e1f2e8048" :step/next {:db/id #edb/ref 17592186435829}}] :activity/title "Linear Combinations of Vectors in N-Dimensional Euclidean Space" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186435811}]}
