{:db/id #edb/ref 17592186391790} {:db/id #edb/ref 17592186393376} {:db/id #edb/ref 17592186393383} {:db/id #edb/ref 17592186435824} {:db/id #edb/ref 17592186562449}] :knowledge-point/title "Solving for a Vector in a Linear Combination"} :step/id #uuid "fd939fe8-9699-5d8a-9dce-0e749d48075e" :step/math-academy-id 17460 :step/next {:db/id #edb/ref 17592186120675}} {:db/id #edb/ref 17592186120675 :step/content {:db/id #edb/ref 17592186119807 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119618 :question/id #uuid "13ebde04-8518-5837-9420-c9487debc562" :question/math-academy-id "e-4791"} :knowledge-point/id #uuid "92e5e826-3121-500a-9103-e618cb16c5b2" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048826}] :knowledge-point/question-generator {:db/id #edb/ref 17592186535346} :knowledge-point/questions [{:db/id #edb/ref 17592186120293} {:db/id #edb/ref 17592186120350} {:db/id #edb/ref 17592186240990} {:db/id #edb/ref 17592186240991} {:db/id #edb/ref 17592186317259} {:db/id #edb/ref 17592186342116} {:db/id #edb/ref 17592186342117} {:db/id #edb/ref 17592186342118} {:db/id #edb/ref 17592186342123} {:db/id #edb/ref 17592186435825} {:db/id #edb/ref 17592186562514}] :knowledge-point/title "Solving for Two Coefficients in a Linear Combination"} :step/id #uuid "fd740ffd-227c-5f9c-9418-4c54bf1616ff" :step/math-academy-id 17464 :step/next {:db/id #edb/ref 17592186120748}} {:db/id #edb/ref 17592186120748 :step/content {:db/id #edb/ref 17592186119854 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119669 :question/id #uuid "d9beff9d-db58-540f-811e-a07fb77d3d92" :question/math-academy-id "e-6191"} :knowledge-point/id #uuid "13a44dc8-4699-519f-8cb1-87ad77471ebe" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049058} {:db/id #edb/ref 17592186050178}] :knowledge-point/question-generator {:db/id #edb/ref 17592186538215} :knowledge-point/questions [{:db/id #edb/ref 17592186120309} {:db/id #edb/ref 17592186120349} {:db/id #edb/ref 17592186