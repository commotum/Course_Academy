[{"source" ":org/Math-Academy" "forms" [{:db/id 17592186119805 :knowledge-point/questions ["question-1c4f9063-8349-57ea-b235-d134f5cba639" "question-f6e40000-d3bb-5e63-9aa5-9e060c0e21d3" "question-6154ace2-6af4-581c-9596-72c7ea4a622a"] :db/ensure [:knowledge-point/validate]} {:db/id "question-1c4f9063-8349-57ea-b235-d134f5cba639" :question/id #uuid "1c4f9063-8349-57ea-b235-d134f5cba639" :question/math-academy-id "q-34572" :question/problem "Find $q$, if $2{a}_{1}+q{a}_{2}=b$ and\n\n$$\n{a}_{1}=[\\begin{aligned}2 \\\\ -3\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}7 \\\\ 5\\end{aligned}],\\,b=[\\begin{aligned}18 \\\\ 4\\end{aligned}].\n$$" :question/worked-solution "Using the properties of addition/subtraction and scalar multiplication of vectors to isolate the $q$ term, we get\n\n$$\n\\begin{aligned}2{a}_{1}+q{a}_{2} & =b \\\\ 2[\\begin{aligned}2 \\\\ -3\\end{aligned}]+q[\\begin{aligned}7 \\\\ 5\\end{aligned}] & =[\\begin{aligned}18 \\\\ 4\\end{aligned}] \\\\ q[\\begin{aligned}7 \\\\ 5\\end{aligned}] & =[\\begin{aligned}18 \\\\ 4\\end{aligned}]-2[\\begin{aligned}2 \\\\ -3\\end{aligned}] \\\\ q[\\begin{aligned}7 \\\\ 5\\end{aligned}] & =[\\begin{aligned}14 \\\\ 10\\end{aligned}].\\end{aligned}\n$$\n\nFrom the final equation above, we can tell that $q=2.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-67278fa9-bfc0-5fba-ae59-83c26db20f9a"] :db/ensure [:question/validate]} {:db/id "answer-field-67278fa9-bfc0-5fba-ae59-83c26db20f9a" :answer-field/id #uuid "67278fa9-bfc0-5fba-ae59-83c26db20f9a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c9625aa7-0555-551d-ba77-01777f30c63d" :answer-field/choices ["answer-67535166-0c7e-5160-8989-abee9b724e2f" "answer-c9d8d7ac-e8e5-5005-8c8b-0a4a33651697" "answer-d1b95b72-f366-5e7c-8edc-5448f9b86cda" "answer-c9625aa7-0555-551d-ba77-01777f30c63d" "answer-9420a97a-1b67-58ee-8e48-ea180d4e1322"] :db/ensure [:answer-field/validate]} {:db/id "answer-67535166-0c7e-5160-8989-abee9b724e2f" :answer/id #uuid "67535166-0c7e-5160-8989-abee9b724e2f" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-c9d8d7ac-e8e5-5005-8c8b-0a4a33651697" :answer/id #uuid "c9d8d7ac-e8e5-5005-8c8b-0a4a33651697" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-d1b95b72-f366-5e7c-8edc-5448f9b86cda" :answer/id #uuid "d1b95b72-f366-5e7c-8edc-5448f9b86cda" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "answer-c9625aa7-0555-551d-ba77-01777f30c63d" :answer/id #uuid "c9625aa7-0555-551d-ba77-01777f30c63d" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-9420a97a-1b67-58ee-8e48-ea180d4e1322" :answer/id #uuid "9420a97a-1b67-58ee-8e48-ea180d4e1322" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "question-f6e40000-d3bb-5e63-9aa5-9e060c0e21d3" :question/id #uuid "f6e40000-d3bb-5e63-9aa5-9e060c0e21d3" :question/math-academy-id "q-105153" :question/problem "Find $k$, if $6{a}_{1}+k{a}_{2}=b$ and\n\n$$\n{a}_{1}=[\\begin{aligned}3 \\\\ 1 \\\\ -2\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}5 \\\\ 3 \\\\ -9\\end{aligned}],\\,b=[\\begin{aligned}8 \\\\ 0 \\\\ 6\\end{aligned}].\n$$" :question/worked-solution "Using the properties of addition/subtraction and scalar multiplication of vectors to isolate the $k$ term, we get\n\n$$\n\\begin{aligned}6{a}_{1}+k{a}_{2} & =b \\\\ 6[\\begin{aligned}3 \\\\ 1 \\\\ -2\\end{aligned}]+k[\\begin{aligned}5 \\\\ 3 \\\\ -9\\end{aligned}] & =[\\begin{aligned}8 \\\\ 0 \\\\ 6\\end{aligned}] \\\\ k[\\begin{aligned}5 \\\\ 3 \\\\ -9\\end{aligned}] & =[\\begin{aligned}8 \\\\ 0 \\\\ 6\\end{aligned}]-6[\\begin{aligned}3 \\\\ 1 \\\\ -2\\end{aligned}] \\\\ k[\\begin{aligned}5 \\\\ 3 \\\\ -9\\end{aligned}] & =[\\begin{aligned}-10 \\\\ -6 \\\\ 18\\end{aligned}].\\end{aligned}\n$$\n\nFrom the final equation above, we can tell that $k=-2.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-90a55e28-fe9d-5f4d-b992-64ed7ca312c6"] :db/ensure [:question/validate]} {:db/id "answer-field-90a55e28-fe9d-5f4d-b992-64ed7ca312c6" :answer-field/id #uuid "90a55e28-fe9d-5f4d-b992-64ed7ca312c6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d7582991-42f6-598d-b22f-86bb055d2380" :answer-field/choices ["answer-d7582991-42f6-598d-b22f-86bb055d2380" "answer-2813de20-ae90-5665-b4a2-be2d2da6cfd5" "answer-09a68c36-28bf-56b7-82ce-363a6cd0aec1" "answer-000e2b43-7a32-5785-9d4a-cc0099f8dbd2" "answer-1609e0df-99da-5341-bdc8-02d9d8eee654"] :db/ensure [:answer-field/validate]} {:db/id "answer-d7582991-42f6-598d-b22f-86bb055d2380" :answer/id #uuid "d7582991-42f6-598d-b22f-86bb055d2380" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-2813de20-ae90-5665-b4a2-be2d2da6cfd5" :answer/id #uuid "2813de20-ae90-5665-b4a2-be2d2da6cfd5" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-09a68c36-28bf-56b7-82ce-363a6cd0aec1" :answer/id #uuid "09a68c36-28bf-56b7-82ce-363a6cd0aec1" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-000e2b43-7a32-5785-9d4a-cc0099f8dbd2" :answer/id #uuid "000e2b43-7a32-5785-9d4a-cc0099f8dbd2" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-1609e0df-99da-5341-bdc8-02d9d8eee654" :answer/id #uuid "1609e0df-99da-5341-bdc8-02d9d8eee654" :answer/type :answer.type/text :answer/value "No solution" :db/ensure [:answer/validate]} {:db/id "question-6154ace2-6af4-581c-9596-72c7ea4a622a" :question/id #uuid "6154ace2-6af4-581c-9596-72c7ea4a622a" :question/math-academy-id "q-105156" :question/problem "Find $t$, if $2{a}_{1}+t{a}_{2}=0$ and\n\n$$\n{a}_{1}=[\\begin{aligned}8 \\\\ 1 \\\\ -6\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}-4 \\\\ -1 \\\\ 3\\end{aligned}].\n$$" :question/worked-solution "Using the properties of addition/subtraction and scalar multiplication of vectors to isolate the $t$ term, we get\n\n$$\n\\begin{aligned}2{a}_{1}+t{a}_{2} & =0 \\\\ 2[\\begin{aligned}8 \\\\ 1 \\\\ -6\\end{aligned}]+t[\\begin{aligned}-4 \\\\ -1 \\\\ 3\\end{aligned}] & =[\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}] \\\\ t[\\begin{aligned}-4 \\\\ -1 \\\\ 3\\end{aligned}] & =[\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}]-2[\\begin{aligned}8 \\\\ 1 \\\\ -6\\end{aligned}] \\\\ t[\\begin{aligned}-4 \\\\ -1 \\\\ 3\\end{aligned}] & =[\\begin{aligned}-16 \\\\ -2 \\\\ 12\\end{aligned}].\\end{aligned}\n$$\n\nEquating the first components, we get \n\n$$\n-4t=-16\\,⟹\\,t=4.\n$$\n\nBut then \n\n$$\n\\begin{aligned}4[\\begin{aligned}-4 \\\\ -1 \\\\ 3\\end{aligned}]=[\\begin{aligned}-16 \\\\ -4 \\\\ 12\\end{aligned}]\\ne [\\begin{aligned}-16 \\\\ -2 \\\\ 12\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, there is no $t$ such that \n $2{a}_{1}+t{a}_{2}=0.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-a8913bcd-9ea3-5176-be5c-767230b5bdc3"] :db/ensure [:question/validate]} {:db/id "answer-field-a8913bcd-9ea3-5176-be5c-767230b5bdc3" :answer-field/id #uuid "a8913bcd-9ea3-5176-be5c-767230b5bdc3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7b39a89b-9b8d-52a3-9357-588262651bee" :answer-field/choices ["answer-e217e4b1-a0b0-5f52-9881-b8ba9a5204d2" "answer-c3245f41-6987-5e17-b6c5-0c173f25056e" "answer-91df5346-a42d-5fd9-a5ba-0704fb0cc455" "answer-027b8325-bddf-5f10-927c-27e8a8d93f7f" "answer-7b39a89b-9b8d-52a3-9357-588262651bee"] :db/ensure [:answer-field/validate]} {:db/id "answer-e217e4b1-a0b0-5f52-9881-b8ba9a5204d2" :answer/id #uuid "e217e4b1-a0b0-5f52-9881-b8ba9a5204d2" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-c3245f41-6987-5e17-b6c5-0c173f25056e" :answer/id #uuid "c3245f41-6987-5e17-b6c5-0c173f25056e" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "answer-91df5346-a42d-5fd9-a5ba-0704fb0cc455" :answer/id #uuid "91df5346-a42d-5fd9-a5ba-0704fb0cc455" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-027b8325-bddf-5f10-927c-27e8a8d93f7f" :answer/id #uuid "027b8325-bddf-5f10-927c-27e8a8d93f7f" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-7b39a89b-9b8d-52a3-9357-588262651bee" :answer/id #uuid "7b39a89b-9b8d-52a3-9357-588262651bee" :answer/type :answer.type/text :answer/value "No solution" :db/ensure [:answer/validate]} {:db/id 17592186119806 :knowledge-point/questions ["question-7b8162a3-2a18-5498-a3a6-ab4fdf90d980"] :db/ensure [:knowledge-point/validate]} {:db/id "question-7b8162a3-2a18-5498-a3a6-ab4fdf90d980" :question/id #uuid "7b8162a3-2a18-5498-a3a6-ab4fdf90d980" :question/math-academy-id "q-105158" :question/problem "Find $x$, if $5a-2x=b$ and\n\n$$\na=[\\begin{aligned}2 \\\\ 1 \\\\ 0 \\\\ -2\\end{aligned}],\\,b=[\\begin{aligned}2 \\\\ -1 \\\\ -6 \\\\ -6\\end{aligned}].\n$$" :question/worked-solution "Using the properties of addition/subtraction and scalar multiplication of vectors to isolate $x,$ we get\n\n$$\n\\begin{aligned}5a-2x & =b \\\\ -2x & =b-5a \\\\ x & =-\\frac{1}{2}(b-5a) \\\\ x & =-\\frac{1}{2}([\\begin{aligned}2 \\\\ -1 \\\\ -6 \\\\ -6\\end{aligned}]-5[\\begin{aligned}2 \\\\ 1 \\\\ 0 \\\\ -2\\end{aligned}]) \\\\ x & =-\\frac{1}{2}[\\begin{aligned}-8 \\\\ -6 \\\\ -6 \\\\ 4\\end{aligned}] \\\\ x & =[\\begin{aligned}4 \\\\ 3 \\\\ 3 \\\\ -2\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-167770ed-e7de-54b6-9bfa-73c5e3df3786"] :db/ensure [:question/validate]} {:db/id "answer-field-167770ed-e7de-54b6-9bfa-73c5e3df3786" :answer-field/id #uuid "167770ed-e7de-54b6-9bfa-73c5e3df3786" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-77982fef-cbd9-5b64-9beb-aef93c81e8b7" :answer-field/choices ["answer-e9436cfd-df38-58b3-bdb8-5acac9079d34" "answer-02aca304-7b48-53d3-b89a-9ec1254a925a" "answer-bb24ab63-f2c2-5312-9f4a-1f89c660eb2b" "answer-c9cf2b8d-50b4-5dea-8cdb-f6d96e285ac9" "answer-77982fef-cbd9-5b64-9beb-aef93c81e8b7"] :db/ensure [:answer-field/validate]} {:db/id "answer-e9436cfd-df38-58b3-bdb8-5acac9079d34" :answer/id #uuid "e9436cfd-df38-58b3-bdb8-5acac9079d34" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 \\\\ 4 \\\\ 3 \\\\ -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-02aca304-7b48-53d3-b89a-9ec1254a925a" :answer/id #uuid "02aca304-7b48-53d3-b89a-9ec1254a925a" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-4 \\\\ -3 \\\\ -3 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-bb24ab63-f2c2-5312-9f4a-1f89c660eb2b" :answer/id #uuid "bb24ab63-f2c2-5312-9f4a-1f89c660eb2b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 \\\\ 3 \\\\ -3 \\\\ 4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-c9cf2b8d-50b4-5dea-8cdb-f6d96e285ac9" :answer/id #uuid "c9cf2b8d-50b4-5dea-8cdb-f6d96e285ac9" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 \\\\ 3 \\\\ -3 \\\\ 4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-77982fef-cbd9-5b64-9beb-aef93c81e8b7" :answer/id #uuid "77982fef-cbd9-5b64-9beb-aef93c81e8b7" :answer/type :answer.type/math :answer/value "[\\begin{aligned}4 \\\\ 3 \\\\ 3 \\\\ -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id 17592186119807 :knowledge-point/questions ["question-f9fda870-d2c0-5b67-a720-dd733f4059b5"] :db/ensure [:knowledge-point/validate]} {:db/id "question-f9fda870-d2c0-5b67-a720-dd733f4059b5" :question/id #uuid "f9fda870-d2c0-5b67-a720-dd733f4059b5" :question/math-academy-id "q-105163" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=[\\begin{aligned}5 \\\\ 7 \\\\ -1\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}2 \\\\ 4 \\\\ 3\\end{aligned}],\\,b=[\\begin{aligned}4 \\\\ -1 \\\\ -11\\end{aligned}].\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=b,$ then what is ${x}_{1}+{x}_{2}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=b,$ then we have\n\n$$\n\\begin{aligned}{x}_{1}[\\begin{aligned}5 \\\\ 7 \\\\ -1\\end{aligned}]+{x}_{2}[\\begin{aligned}2 \\\\ 4 \\\\ 3\\end{aligned}] & =[\\begin{aligned}4 \\\\ -1 \\\\ -11\\end{aligned}] \\\\ [\\begin{aligned}5{x}_{1} \\\\ 7{x}_{1} \\\\ -{x}_{1}\\end{aligned}]+[\\begin{aligned}2{x}_{2} \\\\ 4{x}_{2} \\\\ 3{x}_{2}\\end{aligned}] & =[\\begin{aligned}4 \\\\ -1 \\\\ -11\\end{aligned}] \\\\ [\\begin{aligned}5{x}_{1}+2{x}_{2} \\\\ 7{x}_{1}+4{x}_{2} \\\\ -{x}_{1}+3{x}_{2}\\end{aligned}] & =[\\begin{aligned}4 \\\\ -1 \\\\ -11\\end{aligned}].\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\{\\begin{aligned}5{x}_{1}+2{x}_{2}=4 \\\\ 7{x}_{1}+4{x}_{2}=-1 \\\\ -{x}_{1}+3{x}_{2}=-11\\end{aligned}\n$$\n\nMultiplying the first equation by $(-2)$ and adding the result to the second equation, we get\n\n$$\n\\begin{aligned}-3{x}_{1} & =-9\\,⟹\\,{x}_{1}=3.\\end{aligned}\n$$\n\nSubstituting ${x}_{1}=3$ into the first equation, we get\n\n$$\n\\begin{aligned}5(3)+2{x}_{2} & =4\\,⟹\\,{x}_{2}=-\\frac{11}{2}.\\end{aligned}\n$$\n\nFinally, substituting ${x}_{1}=3$ and ${x}_{2}=-\\frac{11}{2}$ into the third equation, we obtain\n\n$$\n\\begin{aligned}-{x}_{1}+3{x}_{2} & =-11 \\\\ -(3)+3(-\\frac{11}{2}) & =-11 \\\\ -\\frac{33}{2} & =-8,\\end{aligned}\n$$\n\nwhich gives a false statement. \n\nSo, the system has no solution." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-036cd528-ad80-51a8-8b57-1c098a2a1799"] :db/ensure [:question/validate]} {:db/id "answer-field-036cd528-ad80-51a8-8b57-1c098a2a1799" :answer-field/id #uuid "036cd528-ad80-51a8-8b57-1c098a2a1799" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a534e8f3-d655-5502-bc89-53c81026a425" :answer-field/choices ["answer-9dfb10a9-8436-5e35-b531-240827bbf3d9" "answer-d28d263f-fd3b-5140-9893-862b22fa936d" "answer-bd9c2754-dc15-56f5-8e26-d514db78cd49" "answer-eb547a3b-90e6-5909-88af-1af5468ae682" "answer-a534e8f3-d655-5502-bc89-53c81026a425"] :db/ensure [:answer-field/validate]} {:db/id "answer-9dfb10a9-8436-5e35-b531-240827bbf3d9" :answer/id #uuid "9dfb10a9-8436-5e35-b531-240827bbf3d9" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-d28d263f-fd3b-5140-9893-862b22fa936d" :answer/id #uuid "d28d263f-fd3b-5140-9893-862b22fa936d" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-bd9c2754-dc15-56f5-8e26-d514db78cd49" :answer/id #uuid "bd9c2754-dc15-56f5-8e26-d514db78cd49" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-eb547a3b-90e6-5909-88af-1af5468ae682" :answer/id #uuid "eb547a3b-90e6-5909-88af-1af5468ae682" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-a534e8f3-d655-5502-bc89-53c81026a425" :answer/id #uuid "a534e8f3-d655-5502-bc89-53c81026a425" :answer/type :answer.type/text :answer/value "No solution" :db/ensure [:answer/validate]} {:db/id 17592186120309 :question/problem "Consider the vectors\n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}],\\,{a}_{3}=[\\begin{aligned}2 \\\\ 0 \\\\ 5\\end{aligned}],\\,b=[\\begin{aligned}2 \\\\ 3 \\\\ -1\\end{aligned}].\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b,$ then what is ${x}_{1}+{x}_{2}+{x}_{3}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b$, then we have  \n\n$$\n\\begin{aligned}{x}_{1}[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}]+{x}_{2}[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}]+{x}_{3}[\\begin{aligned}2 \\\\ 0 \\\\ 5\\end{aligned}] & =[\\begin{aligned}2 \\\\ 3 \\\\ -1\\end{aligned}] \\\\ [\\begin{aligned}{x}_{1} \\\\ 0 \\\\ {x}_{1}\\end{aligned}]+[\\begin{aligned}-{x}_{2} \\\\ {x}_{2} \\\\ {x}_{2}\\end{aligned}]+[\\begin{aligned}2{x}_{3} \\\\ 0 \\\\ 5{x}_{3}\\end{aligned}] & =[\\begin{aligned}2 \\\\ 3 \\\\ -1\\end{aligned}] \\\\ [\\begin{aligned}{x}_{1}-{x}_{2}+2{x}_{3} \\\\ {x}_{2} \\\\ {x}_{1}+{x}_{2}+5{x}_{3}\\end{aligned}] & =[\\begin{aligned}2 \\\\ 3 \\\\ -1\\end{aligned}].\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\{\\begin{aligned}{x}_{1}-{x}_{2}+2{x}_{3}=2 \\\\ {x}_{2}=3 \\\\ {x}_{1}+{x}_{2}+5{x}_{3}=-1\\end{aligned}\n$$\n\nWe will solve this system using Gaussian elimination. First, we write the augmented matrix for this system:\n\n$$\nM=[\\begin{aligned}1 & -1 & 2 & 2 \\\\ 0 & 1 & 0 & 3 \\\\ 1 & 1 & 5 & -1\\end{aligned}]\n$$\n\nRow-reducing the augmented matrix, we get\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & -1 & 2 & 2 \\\\ 0 & 1 & 0 & 3 \\\\ 1 & 1 & 5 & -1\\end{aligned}] & {R}_{3} & :={R}_{3}-{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 & 2 \\\\ 0 & 1 & 0 & 3 \\\\ 0 & 2 & 3 & -3\\end{aligned}] & {R}_{3} & :={R}_{3}-2{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 & 2 \\\\ 0 & 1 & 0 & 3 \\\\ 0 & 0 & 3 & -9\\end{aligned}] & {R}_{3} & :=\\frac{1}{3}{R}_{3} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 & 2 \\\\ 0 & 1 & 0 & 3 \\\\ 0 & 0 & 1 & -3\\end{aligned}].\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\{\\begin{aligned}{x}_{1}-{x}_{2}+2{x}_{3}=2 \\\\ {x}_{2}=3 \\\\ {x}_{3}=-3.\\end{aligned}\n$$\n\nFrom the third equation, we get ${x}_{3}=-3$ and from the second equation we get ${x}_{2}=3.$ Substituting these into the first equation, we obtain\n\n$$\n{x}_{1}-3+2(-3)=2\\,⟹\\,{x}_{1}=11.\n$$\n\nSo, the solution of the system is ${x}_{1}=11$, ${x}_{2}=3$, and ${x}_{3}=-3,$ which means \n\n$$\n11{a}_{1}+3{a}_{2}-3{a}_{3}=b.\n$$\n\nConsequently, \n\n$$\n{x}_{1}+{x}_{2}+{x}_{3}=11+3-3=11.\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186117993 :answer-field/correct 17592186117998 :db/ensure [:answer-field/validate]}] "assertions" [["question-1c4f9063-8349-57ea-b235-d134f5cba639" :question/id #uuid "1c4f9063-8349-57ea-b235-d134f5cba639"] ["question-1c4f9063-8349-57ea-b235-d134f5cba639" :question/math-academy-id "q-34572"] ["question-1c4f9063-8349-57ea-b235-d134f5cba639" :question/problem "Find $q$, if $2{a}_{1}+q{a}_{2}=b$ and\n\n$$\n{a}_{1}=[\\begin{aligned}2 \\\\ -3\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}7 \\\\ 5\\end{aligned}],\\,b=[\\begin{aligned}18 \\\\ 4\\end{aligned}].\n$$"] ["question-1c4f9063-8349-57ea-b235-d134f5cba639" :question/worked-solution "Using the properties of addition/subtraction and scalar multiplication of vectors to isolate the $q$ term, we get\n\n$$\n\\begin{aligned}2{a}_{1}+q{a}_{2} & =b \\\\ 2[\\begin{aligned}2 \\\\ -3\\end{aligned}]+q[\\begin{aligned}7 \\\\ 5\\end{aligned}] & =[\\begin{aligned}18 \\\\ 4\\end{aligned}] \\\\ q[\\begin{aligned}7 \\\\ 5\\end{aligned}] & =[\\begin{aligned}18 \\\\ 4\\end{aligned}]-2[\\begin{aligned}2 \\\\ -3\\end{aligned}] \\\\ q[\\begin{aligned}7 \\\\ 5\\end{aligned}] & =[\\begin{aligned}14 \\\\ 10\\end{aligned}].\\end{aligned}\n$$\n\nFrom the final equation above, we can tell that $q=2.$"] ["question-1c4f9063-8349-57ea-b235-d134f5cba639" :question/difficulty :question.difficulty/easy] ["answer-field-67278fa9-bfc0-5fba-ae59-83c26db20f9a" :answer-field/id #uuid "67278fa9-bfc0-5fba-ae59-83c26db20f9a"] ["answer-67535166-0c7e-5160-8989-abee9b724e2f" :answer/id #uuid "67535166-0c7e-5160-8989-abee9b724e2f"] ["answer-67535166-0c7e-5160-8989-abee9b724e2f" :answer/type :answer.type/math] ["answer-67535166-0c7e-5160-8989-abee9b724e2f" :answer/value "-1"] ["answer-c9d8d7ac-e8e5-5005-8c8b-0a4a33651697" :answer/id #uuid "c9d8d7ac-e8e5-5005-8c8b-0a4a33651697"] ["answer-c9d8d7ac-e8e5-5005-8c8b-0a4a33651697" :answer/type :answer.type/math] ["answer-c9d8d7ac-e8e5-5005-8c8b-0a