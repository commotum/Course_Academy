[{:db/id 17592186119851 :knowledge-point/questions ["question-fc497788-364d-5c29-8657-a4f1556e2704"] :db/ensure [:knowledge-point/validate]} {:db/id "question-fc497788-364d-5c29-8657-a4f1556e2704" :question/id #uuid "fc497788-364d-5c29-8657-a4f1556e2704" :question/math-academy-id "q-72744" :question/problem "Suppose $X$ is a $2\\times 2$ matrix and $det(X)=-3.$ What is the value of $det(7X)?$" :question/worked-solution "Multiplying a $n\\times n$ matrix by a scalar $k$ is equivalent to multiplying each row by $k,$ and this occurs $n$ times. This leads to the result\n\n$$\n\\begin{aligned}det(k\\cdot X)={k}^{n}\\cdot det(X).\\end{aligned}\n$$\n\nIn our case, we have $k=7$ and $n=2.$ Therefore,\n\n$$\n\\begin{aligned}det(7X) & ={7}^{2}\\cdot det(X) \\\\  & =49\\cdot (-3) \\\\  & =-147.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ad94b206-3ccb-5817-8ec1-05230e22359f"] :db/ensure [:question/validate]} {:db/id "answer-field-ad94b206-3ccb-5817-8ec1-05230e22359f" :answer-field/id #uuid "ad94b206-3ccb-5817-8ec1-05230e22359f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8a223201-44a6-5017-aa80-a127d44a8e76" :answer-field/choices ["answer-8a223201-44a6-5017-aa80-a127d44a8e76" "answer-3aad9ad4-b303-5b2b-9d26-6d2c4b559298" "answer-c00986c8-2ab1-5ba7-aed5-8ac51531c5fa" "answer-2c9a3462-424a-5e23-93a1-21351e2c8529" "answer-09a794be-72e1-5850-a9e7-4f09532bb4d8"] :db/ensure [:answer-field/validate]} {:db/id "answer-8a223201-44a6-5017-aa80-a127d44a8e76" :answer/id #uuid "8a223201-44a6-5017-aa80-a127d44a8e76" :answer/type :answer.type/math :answer/value "-147" :db/ensure [:answer/validate]} {:db/id "answer-3aad9ad4-b303-5b2b-9d26-6d2c4b559298" :answer/id #uuid "3aad9ad4-b303-5b2b-9d26-6d2c4b559298" :answer/type :answer.type/math :answer/value "-21" :db/ensure [:answer/validate]} {:db/id "answer-c00986c8-2ab1-5ba7-aed5-8ac51531c5fa" :answer/id #uuid "c00986c8-2ab1-5b