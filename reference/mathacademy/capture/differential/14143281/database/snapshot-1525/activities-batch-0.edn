#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186120625} :activity/id #uuid "faea29b6-21e9-5455-abc1-ad6fe37387f0" :activity/scope {:db/id #edb/ref 17592186048462 :topic/id #uuid "a1bb4ea4-3502-539f-8843-4f544ac297ef" :topic/math-academy-id 1772} :activity/steps [{:db/id #edb/ref 17592186120625 :step/content {:db/id #edb/ref 17592186121020 :tutorial/content "Remember the following three standard elementary row operations: \n\n  I. Swapping two rows\n\n  II. Multiplying a row by a non-zero number\n\n  III. Adding a multiple of one row to another row\n\nOf these three elementary row operations, only III (adding a multiple of one row to another row) *preserves* the determinant. The other two operations, switching two rows or multiplying a row by a non-zero number, *change* the determinant.\n\nTo demonstrate, let's consider the matrix ![](images/fa/fa51d7c585db408c47e8640ae839c1a3bbf94e2b0097e1ade511e5773461f1e8.svg) Taking the determinant, we have\n![](images/bc/bcf5c5dc9f5b7ed3849e719665f802040cf51e3334ae99e25ea7648cbb0f6134.svg)\n\nIf we swap the two rows, we get a different determinant:\n\n$$\n\\begin{aligned}|\\begin{aligned}3 & 4 \\\\ 1 & 2\\end{aligned}| & =3\\cdot 2-1\\cdot 4 \\\\  & =2 \\\\  & \\ne -2\\,\\times \\end{aligned}\n$$\n\nLikewise, if we multiply top row by ${\\color{red}2},$ then we get a different determinant:\n\n$$\n\\begin{aligned}|\\begin{aligned}2\\cdot 1 & 2\\cdot 2 \\\\ 3 & 4\\end{aligned}| & =|\\begin{aligned}2 & 4 \\\\ 3 & 4\\end{aligned}| \\\\  & =2\\cdot 4-3\\cdot 4 \\\\  & =-4 \\\\  & \\ne -2\\,\\times \\end{aligned}\n$$\n\nHowever, if we add twice the top row to the bottom row, then we get the same determinant:\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 2 \\\\ 3+2\\cdot 1 & 4+2\\cdot 2\\end{aligned}| & =|\\begin{aligned}1 & 2 \\\\ 5 & 8\\end{aligned}| \\\\  & =1\\cdot 8-2\\cdot 5 \\\\  & =-2\\,✓\\end{aligned}\n$$" :tutorial/id #uuid "e5ae8e63-4d2c-5491-9908-96fe94243ab9" :tutorial/math-academy-id 3004 :tutorial/title "Introduction"} :step/id #uuid "57d74627-70e0-5830-ba95-6cb026f4de4b" :step/math-academy-id 16213 :step/next {:db/id #edb/ref 17592186120703}} {:db/id #edb/ref 17592186120626 :step/content {:db/id #edb/ref 17592186119775 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119589 :question/id #uuid "596aa514-d598-5ffe-affe-f5580d130bd0" :question/math-academy-id "e-4422"} :knowledge-point/id #uuid "74764043-e1e7-56d6-8f53-9d287a30e538" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049120}] :knowledge-point/questions [{:db/id #edb/ref 17592186120452} {:db/id #edb/ref 17592186120454} {:db/id #edb/ref 17592186265957} {:db/id #edb/ref 17592186265958} {:db/id #edb/ref 17592186341848} {:db/id #edb/ref 17592186341849} {:db/id #edb/ref 17592186385422} {:db/id #edb/ref 17592186385557} {:db/id #edb/ref 17592186411964} {:db/id #edb/ref 17592186411965} {:db/id #edb/ref 17592186411967}] :knowledge-point/title "Calculating a Determinant After Switching Two Rows"} :step/id #uuid "07d38f85-837d-577c-a3fa-ed4adb824e28" :step/math-academy-id 16214 :step/next {:db/id #edb/ref 17592186120704}} {:db/id #edb/ref 17592186120627 :step/content {:db/id #edb/ref 17592186119776 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119590 :question/id #uuid "89152146-8f04-5b4f-8436-15b82431c35d" :question/math-academy-id "e-4423"} :knowledge-point/id #uuid "2f11b223-edd2-59b8-b761-164d56e29746" :knowledge-point/questions [{:db/id #edb/ref 17592186120453} {:db/id #edb/ref 17592186120455} {:db/id #edb/ref 17592186265963} {:db/id #edb/ref 17592186265964} {:db/id #edb/ref 17592186329660} {:db/id #edb/ref 17592186341851} {:db/id #edb/ref 17592186383167} {:db/id #edb/ref 17592186383174} {:db/id #edb/ref 17592186383181} {:db/id #edb/ref 17592186411968} {:db/id #edb/ref 17592186411969} {:db/id #edb/ref 17592186411970} {:db/id #edb/ref 17592186411971}] :knowledge-point/title "Calculating a Determinant After Multiplying a Row by a Number"} :step/id #uuid "b2bed0ab-d12e-5d90-bbf5-94e480bceb4c" :step/math-academy-id 16215 :step/next {:db/id #edb/ref 17592186120743}} {:db/id #edb/ref 17592186120628 :step/content {:db/id #edb/ref 17592186119777 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119591 :question/id #uuid "6d46c442-4675-5e0e-a834-a8b10ad2b86a" :question/math-academy-id "e-4424"} :knowledge-point/id #uuid "24e5e193-5e30-5480-9e5d-b7b8f1d5de87" :knowledge-point/questions [{:db/id #edb/ref 17592186120431} {:db/id #edb/ref 17592186120432} {:db/id #edb/ref 17592186265971} {:db/id #edb/ref 17592186265972} {:db/id #edb/ref 17592186329636} {:db/id #edb/ref 17592186329661} {:db/id #edb/ref 17592186341856} {:db/id #edb/ref 17592186383202} {:db/id #edb/ref 17592186383209} {:db/id #edb/ref 17592186385429} {:db/id #edb/ref 17592186385564} {:db/id #edb/ref 17592186385571} {:db/id #edb/ref 17592186409688} {:db/id #edb/ref 17592186411966} {:db/id #edb/ref 17592186440484}] :knowledge-point/title "Calculating a Determinant After Applying Several Elementary Operations"} :step/id #uuid "9c7f038a-e114-5e98-bc36-49762d4031f6" :step/math-academy-id 16216 :step/next {:db/id #edb/ref 17592186120742}} {:db/id #edb/ref 17592186120629 :step/content {:db/id #edb/ref 17592186121021 :tutorial/content "Since $\\det(A^T)=\\det(A),$ the corresponding elementary column operations on determinants have the same properties as the elementary row ones.\n\n- Swapping two columns changes the sign of the determinant.\n\n- Multiplying a column by a number scales the determinant by that number.\n\n- Adding a multiple of one column to another column does not change the determinant." :tutorial/id #uuid "bac0b72b-b76a-5a06-9312-d2b7b8ac4247" :tutorial/math-academy-id 3005 :tutorial/title "Column Operations on Determinants"} :step/id #uuid "d5da1bd5-0cc1-56fe-a8d7-36aa6576326a" :step/math-academy-id 16217} {:db/id #edb/ref 17592186120703 :step/content {:db/id #edb/ref 17592186121044 :tutorial/content "As we saw, swapping two rows does not preserve the determinant. However, the only difference is the sign of the determinant changes. \n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 2 \\\\ 3 & 4\\end{aligned}| & =1\\cdot 4-2\\cdot 3=-2 \\\\ |\\begin{aligned}3 & 4 \\\\ 1 & 2\\end{aligned}| & =3\\cdot 2-1\\cdot 4=2\\end{aligned}\n$$\n\nSo, in the above example, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 2 \\\\ 3 & 4\\end{aligned}| & =-|\\begin{aligned}3 & 4 \\\\ 1 & 2\\end{aligned}|.\\end{aligned}\n$$\n\nIn general, swapping any two rows of a matrix changes the sign of the determinant to the opposite one. That is to say, \n\n$$\n\\begin{aligned}det[\\begin{aligned}⋮ & ⋮ & … & ⋮ \\\\ ◻ & ◻ & … & ◻ \\\\ ⋮ & ⋮ & … & ⋮ \\\\ △ & △ & … & △ \\\\ ⋮ & ⋮ & … & ⋮\\end{aligned}]=-det[\\begin{aligned}⋮ & ⋮ & … & ⋮ \\\\ △ & △ & … & △ \\\\ ⋮ & ⋮ & … & ⋮ \\\\ ◻ & ◻ & … & ◻ \\\\ ⋮ & ⋮ & … & ⋮\\end{aligned}].\\end{aligned}\n$$" :tutorial/id #uuid "f151b612-1bdb-5723-af50-a48439141fbc" :tutorial/math-academy-id 3236 :tutorial/title "Switching Two Rows Changes the Sign of the Determinant"} :step/id #uuid "1889d210-a2bc-5893-b7e3-879d8fc8961f" :step/math-academy-id 17635 :step/next {:db/id #edb/ref 17592186120626}} {:db/id #edb/ref 17592186120704 :step/content {:db/id #edb/ref 17592186121045 :tutorial/content "As we have seen, multiplying a row by a number does not preserve the determinant. However, it does affect the determinant in a predictable way: multiplying a row by a number scales the determinant by that number as well.\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 2 \\\\ 3 & 4\\end{aligned}| & =1\\cdot 4-2\\cdot 3=-2 \\\\ |\\begin{aligned}2\\cdot 1 & 2\\cdot 2 \\\\ 3 & 4\\end{aligned}|=|\\begin{aligned}2 & 4 \\\\ 3 & 4\\end{aligned}| & =2\\cdot 4-3\\cdot 4=-4\\end{aligned}\n$$\n\nSo, in the above example, we have\n![](images/08/0826c05fe2eabec96065eb2c83228168129b42c309764df4b101f4a520c4a0f9.svg)\n\nIn general, multiplying a row of a matrix by a number multiplies the determinant by that number. That is to say, we can factor out the common multiplier from the row of the determinant:\n\n$$\n\\begin{aligned}det[\\begin{aligned}⋮ & ⋮ & … & ⋮ \\\\ k△ & k△ & … & k△ \\\\ ⋮ & ⋮ & … & ⋮\\end{aligned}]=k\\cdot det[\\begin{aligned}⋮ & ⋮ & … & ⋮ \\\\ △ & △ & … & △ \\\\ ⋮ & ⋮ & … & ⋮\\end{aligned}]\\end{aligned}\n$$" :tutorial/id #uuid "09c28da6-5340-56f9-bbf5-427a824977ee" :tutorial/math-academy-id 3237 :tutorial/title "Multiplying a Row By a Number Scales the Determinant By That Number"} :step/id #uuid "0cc1f27c-f5d8-5b74-9602-32ce4d87b799" :step/math-academy-id 17658 :step/next {:db/id #edb/ref 17592186120627}} {:db/id #edb/ref 17592186120742 :step/content {:db/id #edb/ref 17592186119850 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119665 :question/id #uuid "cbd9b4bc-146a-57f7-a03f-f045f86f3c21" :question/math-academy-id "e-6143"} :knowledge-point/id #uuid "9a0ab53e-79ff-5520-bb50-069fd381d29d" :knowledge-point/questions [{:db/id #edb/ref 17592186120420} {:db/id #edb/ref 17592186120456} {:db/id #edb/ref 17592186265985} {:db/id #edb/ref 17592186265992} {:db/id #edb/ref 17592186265993} {:db/id #edb/ref 17592186265994} {:db/id #edb/ref 17592186329659} {:db/id #edb/ref 17592186329708} {:db/id #edb/ref 17592186378657} {:db/id #edb/ref 17592186383216} {:db/id #edb/ref 17592186385442} {:db/id #edb/ref 17592186409690} {:db/id #edb/ref 17592186411963} {:db/id #edb/ref 17592186424899}] :knowledge-point/title "Identifying a Row Operation Given the Connection Between Two Determinants"} :step/id #uuid "e1ec39b0-859a-5c8a-a8ca-f8a0f6371e76" :step/math-academy-id 22905 :step/next {:db/id #edb/ref 17592186120629}} {:db/id #edb/ref 17592186120743 :step/content {:db/id #edb/ref 17592186121061 :tutorial/content "Let's check what happens if we multiply the entire matrix (not only one row) by a number. For example,\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 2 \\\\ 3 & 4\\end{aligned}| & =1\\cdot 4-2\\cdot 3=-2 \\\\ |\\begin{aligned}3\\cdot 1 & 3\\cdot 2 \\\\ 3\\cdot 3 & 3\\cdot 4\\end{aligned}|=|\\begin{aligned}3 & 6 \\\\ 9 & 12\\end{aligned}| & =3\\cdot 12-6\\cdot 9=-18\\end{aligned}\n$$\n\nSo, in the above example, we have\n\n![](images/fe/fe02091dde43a8a2405f6b588f619bc9fa3f54b31ac8a1ac39d318761f00cc3e.svg)\n\nThe above is equivalent to multiplying both rows of the matrix by $3$. Multiplying the first row scales the determinant by $3$, and then multiplying the second row scales it by $3$ once more.\n\nIn general, multiplying an entire $n \\times n$ matrix by a number multiplies the determinant by that number to the power of $n$. That is to say, we can factor out the common multiplier from the entire matrix, as follows:\n\n$$\n\\begin{aligned}det(k\\cdot A)={k}^{n}\\cdot det(A),\\end{aligned}\n$$\n\nwhere $A$ is an $n \\times n$ matrix." :tutorial/id #uuid "1c99dfd1-b583-5247-9ac5-c2ada47c0ee9" :tutorial/math-academy-id 3880 :tutorial/title "Multiplying a Matrix By a Scalar"} :step/id #uuid "ebb7b384-6a1f-56e3-9927-8911a4ec3563" :step/math-academy-id 22922 :step/next {:db/id #edb/ref 17592186120744}} {:db/id #edb/ref 17592186120744 :step/content {:db/id #edb/ref 17592186119851 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119666 :question/id #uuid "ce910ef2-c3af-5173-84d4-ee2a4c957954" :question/math-academy-id "e-6148"} :knowledge-point/id #uuid "272d9a54-ba97-5175-86df-0a78337da7b9" :knowledge-point/questions [{:db/id #edb/ref 17592186120512} {:db/id #edb/ref 17592186120513} {:db/id #edb/ref 17592186265965} {:db/id #edb/ref 17592186265966} {:db/id #edb/ref 17592186265967} {:db/id #edb/ref 17592186265968} {:db/id #edb/ref 17592186341854} {:db/id #edb/ref 17592186341855} {:db/id #edb/ref 17592186379980} {:db/id #edb/ref 17592186379987} {:db/id #edb/ref 17592186383188} {:db/id #edb/ref 17592186383195} {:db/id #edb/ref 17592186409689} {:db/id #edb/ref 17592186409691} {:db/id #edb/ref 17592186440485}] :knowledge-point/title "Calculating a Determinant After Multiplying a Matrix by a Scalar"} :step/id #uuid "6bb5981c-60d1-56ed-a146-3ef4d9c0f6bb" :step/math-academy-id 22923 :step/next {:db/id #edb/ref 17592186120628}}] :activity/title "Row and Column Operations on Determinants" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186119994}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186409694} :activity/id #uuid "26bcedbd-f502-5256-b322-6d751a0c036d" :activity/scope {:db/id #edb/ref 17592186048462 :topic/id #uuid "a1bb4ea4-3502-539f-8843-4f544ac297ef" :topic/math-academy-id 1772} :activity/steps [{:db/id #edb/ref 17592186409692 :step/content {:db/id #edb/ref 17592186409691 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08098a6b-f06b-51d7-be19-39ddeb566f21" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-256" :db/id #edb/ref 17592186409658} {:answer/id #uuid "4da115ec-321e-53f5-9c9a-06b3818508a4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-24" :db/id #edb/ref 17592186409661} {:answer/id #uuid "7105bb69-b089-5e84-ab20-fd40c1edbdff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-864" :db/id #edb/ref 17592186409667} {:answer/id #uuid "b58e6bc8-29ce-5a41-8721-675b80eb22cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-144" :db/id #edb/ref 17592186409673} {:answer/id #uuid "fcd30542-3cc5-5b61-a9af-49753027f933" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-48" :db/id #edb/ref 17592186409681}] :answer-field/correct {:db/id #edb/ref 17592186409673} :answer-field/id #uuid "04759499-638f-5548-ad9a-51762b698235" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186409683}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fded0a2c-cd1a-5de1-a671-20ea991daecd" :question/math-academy-id "q-72737" :question/problem "Suppose $A$ is a $2\\times 2$ matrix and $det(A)=-4.$ What is the value of $det(6A)?$" :question/worked-solution "Multiplying a $n\\times n$ matrix by a scalar $k$ is equivalent to multiplying each row by $k,$ and this occurs $n$ times. This leads to the result\n\n$$\n\\begin{aligned}det(k\\cdot A)={k}^{n}\\cdot det(A).\\end{aligned}\n$$\n\nIn our case, we have $k=6$ and $n=2.$ Therefore,\n\n$$\n\\begin{aligned}det(6A) & ={6}^{2}\\cdot det(A) \\\\  & =36\\cdot (-4) \\\\  & =-144.\\end{aligned}\n$$"} :step/id #uuid "0f93ad19-15c5-55b8-98ea-d5bcee8f0a3a" :step/next {:db/id #edb/ref 17592186409696}} {:db/id #edb/ref 17592186409693 :step/content {:db/id #edb/ref 17592186409688 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "403dcee3-3eac-5cf3-a329-0558750fb3b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-7" :db/id #edb/ref 17592186409660} {:answer/id #uuid "62a1a85b-a36c-54a7-b3bd-55a36f4cb315" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186409664} {:answer/id #uuid "77636ea6-fba2-560e-a69f-f3d2282f86f0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-14" :db/id #edb/ref 17592186409669} {:answer/id #uuid "81cdf51b-4eb6-557c-9452-11d65bc919bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14" :db/id #edb/ref 17592186409671} {:answer/id #uuid "ebe826b2-b0aa-57e0-a4ad-251af663d3fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "21" :db/id #edb/ref 17592186409678}] :answer-field/correct {:db/id #edb/ref 17592186409671} :answer-field/id #uuid "1a00ccd6-15ad-566e-9909-ced57101fb7b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186409684}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4a80ad4c-5529-5931-9d7c-574d40c6f47e" :question/math-academy-id "q-72748" :question/problem "Suppose $B$ is a $3\\times 3$ matrix and $det(B)=-7.$ The matrix $C$ is obtained from $B$ by applying the elementary row operations ${R}_{2}:=2{R}_{2}$ and ${R}_{1}↔{R}_{3}.$ What is the value of $det(C)?$" :question/worked-solution "First, let's figure out what each operation does to the determinant.\n\n- The operation ${R}_{1}↔{R}_{3}$ involves swapping two rows, so it changes the sign of the determinant to the opposite one.\n\n- The operation ${R}_{2}:=2{R}_{2}$ involves multiplying a row by $2,$ so the determinant is multiplied by $2$ as well.\n\nTherefore, we have to change the sign of the determinant to the opposite one and multiply by $2$ as well. Consequently, we get\n\n$$\n\\begin{aligned}det(C) & =2\\cdot (-det(B)) \\\\  & =-2det(B) \\\\  & =-2\\cdot (-7) \\\\  & =14.\\end{aligned}\n$$"} :step/id #uuid "2aef95ee-e7e9-5cac-b9ad-3b67a53db79f"} {:db/id #edb/ref 17592186409694 :step/content {:db/id #edb/ref 17592186120431 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e01723b-cc89-5e3f-b933-6517b2094770" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186409662} {:answer/id #uuid "91ff05b8-c923-5cbc-9974-2858e86d4877" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186409672} {:answer/id #uuid "b7b3cea5-79ed-5121-8909-27b79eb945a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-24" :db/id #edb/ref 17592186409674} {:answer/id #uuid "b8a98397-80e5-5a87-b4ed-d166d96908c1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-36" :db/id #edb/ref 17592186409675} {:answer/id #uuid "eb7338ba-732f-5bfb-aded-530b4a5f8d7e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-12" :db/id #edb/ref 17592186409677}] :answer-field/correct {:db/id #edb/ref 17592186409677} :answer-field/id #uuid "dc16361c-3306-5054-a003-e31388cab6e6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186409687}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0a9d752b-69e4-5f21-888f-3429a8443f7b" :question/math-academy-id "q-42503" :question/problem "Suppose $A$ is a $4\\times 4$ matrix and $det(A)=12.$ The matrix $B$ is obtained from $A$ by applying the elementary row operations ${R}_{2}↔{R}_{3}$ and ${R}_{1}:={R}_{1}+2{R}_{3}.$ What is the value of $det(B)?$" :question/worked-solution "First, let's figure out what each operation does to the determinant.\n\n- The operation ${R}_{2}↔{R}_{3}$ involves swapping two rows, so it changes the sign of the determinant to the opposite one.\n\n- The operation ${R}_{1}:={R}_{1}+2{R}_{3}$ involves adding a multiple of one row to another row,  so it does not change the determinant.\n\nTherefore, we only have to change the sign of the determinant to the opposite one. Consequently, we get\n\n$$\n\\begin{aligned}det(B) & =-det(A) \\\\  & =-(12) \\\\  & =-12.\\end{aligned}\n$$"} :step/id #uuid "2df25dd7-50b3-560b-9abe-b6b13654a237" :step/next {:db/id #edb/ref 17592186409695}} {:db/id #edb/ref 17592186409695 :step/content {:db/id #edb/ref 17592186409690 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f5903e6-2dfb-5988-91aa-d76353ccd959" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{2}:={R}_{2}+(-2){R}_{1}" :db/id #edb/ref 17592186409659} {:answer/id #uuid "6d3a3be9-dab5-5f7f-8e95-4eab3b47ad8a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{2}↔{R}_{3}" :db/id #edb/ref 17592186409665} {:answer/id #uuid "6d7bf72b-a934-51fa-b417-3e7f04a3f3b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{2}:={R}_{2}+(-1){R}_{3}" :db/id #edb/ref 17592186409666} {:answer/id #uuid "7190fbd3-e0c2-5f59-a1f5-3e49c40c46d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{3}:=2{R}_{3}" :db/id #edb/ref 17592186409668} {:answer/id #uuid "c8afe3f3-a5ef-55a7-b5dd-30e21d2e58fc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{3}:={R}_{3}+(-3){R}_{2}" :db/id #edb/ref 17592186409676}] :answer-field/correct {:db/id #edb/ref 17592186409659} :answer-field/id #uuid "7a779adf-221a-5189-a14f-312c86e15c0d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186409685}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9ac571f6-6f05-5f70-8bcf-34738f544556" :question/math-academy-id "q-43046" :question/problem "Given that $det(A)=det(B),$ which of the following elementary row operations transforms matrix $A$ to matrix $B,$ where\n\n$$\nA=[\\begin{aligned}2 & -3 & -1 \\\\ 5 & -4 & -3 \\\\ 4 & 6 & 1\\end{aligned}],\\,B=[\\begin{aligned}2 & -3 & -1 \\\\ 1 & 2 & -1 \\\\ 4 & 6 & 1\\end{aligned}]?\n$$" :question/worked-solution "Since $det(A)=det(B)$, the row operation applied to $A$ must be to add or subtract a multiple of one row to another row. In other words, it is of the form \n\n$$\n{R}_{j}:={R}_{j}+(k){R}_{i},\\,i\\ne j.\n$$\n\nBy considering the given row operations that are of the above form, we notice that\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}2 & -3 & -1 \\\\ 5 & -4 & -3 \\\\ 4 & 6 & 1\\end{aligned}| & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & =|\\begin{aligned}2 & -3 & -1 \\\\ 1 & 2 & -1 \\\\ 4 & 6 & 1\\end{aligned}| \\\\  & =det(B).\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{2}:={R}_{2}+(-2){R}_{1}.\n$$"} :step/id #uuid "8e6fad07-ec42-5416-85eb-9ef2b0059cbe" :step/next {:db/id #edb/ref 17592186409692}} {:db/id #edb/ref 17592186409696 :step/content {:db/id #edb/ref 17592186409689 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "512abaff-433d-5e4a-864f-f1df10d56d6a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "60" :db/id #edb/ref 17592186409663} {:answer/id #uuid "7a56edfe-4461-57d1-8804-22f3e005401a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186409670} {:answer/id #uuid "f689939f-47fe-5c00-a125-9fe1fc1187ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "180" :db/id #edb/ref 17592186409679} {:answer/id #uuid "face2d4d-2a2b-5eb7-8047-8fb6dbd54d8a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "160" :db/id #edb/ref 17592186409680} {:answer/id #uuid "fcf8031f-e31a-5703-96b3-5a28bec971aa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "320" :db/id #edb/ref 17592186409682}] :answer-field/correct {:db/id #edb/ref 17592186409682} :answer-field/id #uuid "98c176ba-da66-551c-9c0c-0c257e4d9459" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186409686}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "81c5993c-3d71-5869-bbf5-3e36b2df3a7f" :question/math-academy-id "q-72741" :question/problem "Suppose $Y$ is a $6\\times 6$ matrix and $det(Y)=5.$ What is the value of $det(2Y)?$" :question/worked-solution "Multiplying a $n\\times n$ matrix by a scalar $k$ is equivalent to multiplying each row by $k,$ and this occurs $n$ times. This leads to the result\n\n$$\n\\begin{aligned}det(k\\cdot Y)={k}^{n}\\cdot det(Y).\\end{aligned}\n$$\n\nIn our case, we have $k=2$ and $n=6.$ Therefore,\n\n$$\n\\begin{aligned}det(2Y) & ={2}^{6}\\cdot det(Y) \\\\  & =64\\cdot 5 \\\\  & =320.\\end{aligned}\n$$"} :step/id #uuid "d75809ee-199d-50e2-b002-2326810f1174" :step/next {:db/id #edb/ref 17592186409693}}] :activity/title "Row and Column Operations on Determinants" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186409657}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186424902} :activity/id #uuid "11b6f742-f965-5993-a06f-bca8dfba7485" :activity/scope {:db/id #edb/ref 17592186048462 :topic/id #uuid "a1bb4ea4-3502-539f-8843-4f544ac297ef" :topic/math-academy-id 1772} :activity/steps [{:db/id #edb/ref 17592186424900 :step/content {:db/id #edb/ref 17592186265993 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5631a190-3164-5c81-9c22-e6a70c44c09d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186263742} {:answer/id #uuid "74e1b546-dc5d-5c39-8615-b03158b816ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5" :db/id #edb/ref 17592186264014} {:answer/id #uuid "850ef7c7-1f4b-53c9-b078-25bda4009629" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186264145} {:answer/id #uuid "df7141db-3b66-5a7a-b89e-874dcb0bbee8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-15" :db/id #edb/ref 17592186264937} {:answer/id #uuid "e044d557-77d9-53d0-a554-77b04c1a4a41" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-10" :db/id #edb/ref 17592186264947}] :answer-field/correct {:db/id #edb/ref 17592186264014} :answer-field/id #uuid "cf6cdcea-ffe0-5e06-a7c5-0284d3815f01" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265614}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2e099506-9b8a-52ad-a7eb-ff6f42b6d002" :question/math-academy-id "q-130855" :question/problem "Consider the matrices given below. Given that $X$ and $Y$ are row equivalent matrices and $det(X)=5$, find $det(Y).$\n\n$$\nX=[\\begin{aligned}2 & -3 & 1 \\\\ 1 & 1 & -2 \\\\ -3 & 2 & 2\\end{aligned}],\\,Y=[\\begin{aligned}2 & -3 & 1 \\\\ -3 & 2 & 2 \\\\ 1 & 1 & -2\\end{aligned}].\n$$" :question/worked-solution "Notice that $Y$ can be obtained from $X$ by swapping the $2$nd and the $3$rd rows. \n\nThis changes the sign of the determinant to the opposite one.\nTherefore, we obtain\n\n$$\n\\begin{aligned}det(Y) & =-det(X) \\\\  & =-(5) \\\\  & =-5.\\end{aligned}\n$$"} :step/id #uuid "0950983d-5529-5332-ba75-7636f5397a6b"} {:db/id #edb/ref 17592186424901 :step/content {:db/id #edb/ref 17592186265971 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a0f29de-25aa-5107-8046-0dd732f9beb4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "21" :db/id #edb/ref 17592186263097} {:answer/id #uuid "162deb0b-2730-571d-b037-7db47a3aea46" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18" :db/id #edb/ref 17592186263209} {:answer/id #uuid "1b8f75e2-26ce-5967-ac8a-f06080423598" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-21" :db/id #edb/ref 17592186263259} {:answer/id #uuid "66de9e61-f678-5f09-92fa-20666c0a4a57" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "24" :db/id #edb/ref 17592186263891} {:answer/id #uuid "f578aa5a-7ba5-5a91-8942-93f38512c9ee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-14" :db/id #edb/ref 17592186265150}] :answer-field/correct {:db/id #edb/ref 17592186263097} :answer-field/id #uuid "f00b119d-2bbd-5aff-88de-546820f3c832" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265676}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "da7f3dfc-3649-55d6-80af-942a6a83828d" :question/math-academy-id "q-130767" :question/problem "Suppose $X$ is a $6\\times 6$ matrix and $det(X)=28.$ The matrix $Y$ is obtained from $X$ by applying the elementary row operations ${R}_{1}:=\\frac{3}{4}{R}_{1}$ and ${R}_{6}:={R}_{6}+(-7){R}_{2}.$ What is the value of $det(Y)?$" :question/worked-solution "First, let's figure out what each operation does to the determinant.\n\n- The operation ${R}_{6}:={R}_{6}+(-7){R}_{2}$ involves adding a multiple of one row to another row,  so it does not change the determinant.\n\n- The operation ${R}_{1}:=\\frac{3}{4}{R}_{1}$ involves multiplying a row by $\\frac{3}{4},$ so the determinant is multiplied by $\\frac{3}{4}$ as well.\n\nTherefore, we only have to multiply the determinant by $\\frac{3}{4}.$ Consequently, we get\n\n$$\n\\begin{aligned}det(Y) & =\\frac{3}{4}det(X) \\\\  & =\\frac{3}{4}\\cdot 28 \\\\  & =21.\\end{aligned}\n$$"} :step/id #uuid "5a731d48-68b1-58c7-b15e-4a787d1f4b44" :step/next {:db/id #edb/ref 17592186424903}} {:db/id #edb/ref 17592186424902 :step/content {:db/id #edb/ref 17592186329661 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "038f903c-07cf-5804-8ccf-c48c4437fe4a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15" :db/id #edb/ref 17592186326971} {:answer/id #uuid "5e5d0fbb-4c6d-516a-bbe1-bc9a4754768c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-20" :db/id #edb/ref 17592186327766} {:answer/id #uuid "7edb508d-7daa-5a42-80ea-172f811c7a6d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5" :db/id #edb/ref 17592186328025} {:answer/id #uuid "cef987a3-28b5-50d6-be17-23ad82b7d421" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-15" :db/id #edb/ref 17592186328755} {:answer/id #uuid "dce0ee78-0312-5fae-84a0-aea62c27e409" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186328863}] :answer-field/correct {:db/id #edb/ref 17592186328755} :answer-field/id #uuid "91964048-e6f4-5262-9e11-ecd0686eeeaf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186329428}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "44ea0623-3f8f-525c-8344-8d911fbef23b" :question/math-academy-id "q-42504" :question/problem "Suppose $A$ is a $5\\times 5$ matrix and $det(A)=5.$ The matrix $B$ is obtained from $A$ by applying the elementary row operations ${R}_{1}↔{R}_{2}$ and ${R}_{3}:=3{R}_{3}.$ What is the value of $det(B)?$" :question/worked-solution "First, let's figure out what each operation does to the determinant.\n\n- The operation ${R}_{1}↔{R}_{2}$ involves swapping two rows, so it changes the sign of the determinant to the opposite one.\n\n- The operation ${R}_{3}:=3{R}_{3}$ involves multiplying a row by $3,$ so the determinant is multiplied by $3$ as well.\n\nTherefore, we have to change the sign of the determinant to the opposite one and multiply by $3$ as well. Consequently, we get\n\n$$\n\\begin{aligned}det(B) & =3\\cdot (-det(A)) \\\\  & =-3det(A) \\\\  & =-3\\cdot 5 \\\\  & =-15.\\end{aligned}\n$$"} :step/id #uuid "5b098fcf-c1b8-5f75-8b3a-28dc83ab8997" :step/next {:db/id #edb/ref 17592186424904}} {:db/id #edb/ref 17592186424903 :step/content {:db/id #edb/ref 17592186424899 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "171230a8-065f-5312-91ff-166c6fb3df4f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{3}:={R}_{3}+{R}_{1}" :db/id #edb/ref 17592186424893} {:answer/id #uuid "21bc26a0-57ad-5e62-a6e6-621e2ba24583" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{3}:={R}_{3}+(-1){R}_{1}" :db/id #edb/ref 17592186424894} {:answer/id #uuid "54d72f80-7a7b-5b93-a0ec-2d6edad08ac4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{1}:={R}_{1}+(-1){R}_{3}" :db/id #edb/ref 17592186424895} {:answer/id #uuid "6c11e90f-184e-57bd-b3ed-1971d8fb82ed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{2}:=-{R}_{2}" :db/id #edb/ref 17592186424896} {:answer/id #uuid "acde6755-f2db-5c6c-bdc1-ac03bdaa2931" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{1}↔{R}_{3}" :db/id #edb/ref 17592186424897}] :answer-field/correct {:db/id #edb/ref 17592186424894} :answer-field/id #uuid "c75bea69-7db0-5820-97b1-b5dd95b8b845" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186424898}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "200dace6-387b-586f-87ab-a5501c01cbe0" :question/math-academy-id "q-130851" :question/problem "Given that $det(A)=det(B),$ which of the following elementary row operations transforms matrix $A$ to matrix $B,$ where\n\n$$\nA=[\\begin{aligned}2 & -1 & 3 \\\\ 3 & -5 & 6 \\\\ 2 & 3 & 5\\end{aligned}],\\,B=[\\begin{aligned}2 & -1 & 3 \\\\ 3 & -5 & 6 \\\\ 0 & 4 & 2\\end{aligned}]?\n$$" :question/worked-solution "Since $det(A)=det(B)$, the row operation applied to $A$ must be to add or subtract a multiple of one row to another row. In other words, it is of the form \n\n$$\n{R}_{j}:={R}_{j}+(k){R}_{i},\\,i\\ne j.\n$$\n\nBy considering the given row operations that are of the above form, we notice that\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}2 & -1 & 3 \\\\ 3 & -5 & 6 \\\\ 2 & 3 & 5\\end{aligned}| & {R}_{3} & :={R}_{3}+(-1){R}_{1} \\\\  & =|\\begin{aligned}2 & -1 & 3 \\\\ 3 & -5 & 6 \\\\ 0 & 4 & 2\\end{aligned}| \\\\  & =det(B).\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{3}:={R}_{3}+(-1){R}_{1}.\n$$"} :step/id #uuid "796d84ed-30ec-5eef-9c9e-3ecd61007abc" :step/next {:db/id #edb/ref 17592186424900}} {:db/id #edb/ref 17592186424904 :step/content {:db/id #edb/ref 17592186341855 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17922ecf-87f8-5af9-872a-3d5dc6da26af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-36" :db/id #edb/ref 17592186339339} {:answer/id #uuid "3e3f2587-b4ad-5bf0-81b7-1df62ffb7a09" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-243" :db/id #edb/ref 17592186339686} {:answer/id #uuid "a21fdf0b-c950-5ec9-b67b-31a39827c266" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-12" :db/id #edb/ref 17592186340600} {:answer/id #uuid "ae1d7c41-28d1-55a3-9882-2c2b96500495" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-48" :db/id #edb/ref 17592186340714} {:answer/id #uuid "f3da6cbc-6c90-5ed2-9aad-88c3625d3d86" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-192" :db/id #edb/ref 17592186341277}] :answer-field/correct {:db/id #edb/ref 17592186341277} :answer-field/id #uuid "ded707a6-03c1-52cc-8868-8933afddd3df" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341773}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "bce6072f-0fd1-50b6-a305-a94b72b85f4e" :question/math-academy-id "q-72740" :question/problem "Suppose $Y$ is a $3\\times 3$ matrix and $det(Y)=-3.$ What is the value of $det(4Y)?$" :question/worked-solution "Multiplying a $n\\times n$ matrix by a scalar $k$ is equivalent to multiplying each row by $k,$ and this occurs $n$ times. This leads to the result\n\n$$\n\\begin{aligned}det(k\\cdot Y)={k}^{n}\\cdot det(Y).\\end{aligned}\n$$\n\nIn our case, we have $k=4$ and $n=3.$ Therefore,\n\n$$\n\\begin{aligned}det(4Y) & ={4}^{3}\\cdot det(Y) \\\\  & =64\\cdot (-3) \\\\  & =-192.\\end{aligned}\n$$"} :step/id #uuid "9e253f5b-694c-5716-b2be-ec3f736b8398" :step/next {:db/id #edb/ref 17592186424901}}] :activity/title "Row and Column Operations on Determinants" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186424892}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186440490} :activity/id #uuid "f4aebbc3-f038-5073-b26d-b3a33a4479cf" :activity/scope {:db/id #edb/ref 17592186048462 :topic/id #uuid "a1bb4ea4-3502-539f-8843-4f544ac297ef" :topic/math-academy-id 1772} :activity/steps [{:db/id #edb/ref 17592186440486 :step/content {:db/id #edb/ref 17592186378657 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "319beb45-da82-5928-83bf-d29bc52ed19f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186378659} {:answer/id #uuid "a259e746-f501-54ae-be55-fef569b47320" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-14" :db/id #edb/ref 17592186378660} {:answer/id #uuid "21d9eeeb-c150-51f2-9c34-5dfbb8074a06" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186378661} {:answer/id #uuid "ca0902b3-371c-5ed1-bcca-bdf20d2b6da8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186378662} {:answer/id #uuid "6227f8a3-0c1e-5bad-a5c1-bba85528c3cf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14" :db/id #edb/ref 17592186378663}] :answer-field/correct {:db/id #edb/ref 17592186378660} :answer-field/id #uuid "addc5023-5343-5d6e-94d4-459e9803d13f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186378658}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fbcc8a51-42ac-5cb8-a6bc-0647017d9ba5" :question/math-academy-id "q-130858" :question/problem "Consider the matrices given below. Given that $X$ and $Y$ are row equivalent matrices and $det(X)=14$, find $det(Y).$\n\n$$\nX=[\\begin{aligned}2 & -3 & 1 \\\\ 1 & 4 & -2 \\\\ 5 & 3 & -1\\end{aligned}],\\,Y=[\\begin{aligned}2 & -3 & 1 \\\\ 5 & 3 & -1 \\\\ 1 & 4 & -2\\end{aligned}].\n$$" :question/worked-solution "Notice that $Y$ can be obtained from $X$ by swapping the $2$nd and the $3$rd rows. \n\nThis changes the sign of the determinant to the opposite one.\nTherefore, we obtain\n\n$$\n\\begin{aligned}det(Y) & =-det(X) \\\\  & =-(14) \\\\  & =-14.\\end{aligned}\n$$"} :step/id #uuid "0b56b3f3-0eed-5dd2-8e0f-81ffa9b89ff3"} {:db/id #edb/ref 17592186440487 :step/content {:db/id #edb/ref 17592186265972 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c504d34-49a8-5293-9654-9bb371251af7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-90" :db/id #edb/ref 17592186263118} {:answer/id #uuid "668e2da3-ac3d-5bec-b6b1-16504c2d81fe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "90" :db/id #edb/ref 17592186263886} {:answer/id #uuid "7573103e-73e5-56e6-832d-af6582780369" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "40" :db/id #edb/ref 17592186264021} {:answer/id #uuid "90344634-d8cd-51fb-85d7-7f08481a8bde" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "60" :db/id #edb/ref 17592186264236} {:answer/id #uuid "c168c56a-3c78-5c71-873d-48190da505aa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-75" :db/id #edb/ref 17592186264678}] :answer-field/correct {:db/id #edb/ref 17592186264236} :answer-field/id #uuid "37455212-8943-576e-a134-59b320488bd0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265345}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b71bc5d0-3557-578c-8a3d-25da59fcce16" :question/math-academy-id "q-130771" :question/problem "Suppose $B$ is a $6\\times 6$ matrix and $det(B)=-75.$ The matrix $C$ is obtained from $B$ by applying the elementary row operations ${R}_{2}:=\\frac{4}{5}{R}_{2}$ and ${R}_{5}↔{R}_{6}.$ What is the value of $det(C)?$" :question/worked-solution "First, let's figure out what each operation does to the determinant.\n\n- The operation ${R}_{5}↔{R}_{6}$ involves swapping two rows, so it changes the sign of the determinant to the opposite one.\n\n- The operation ${R}_{2}:=\\frac{4}{5}{R}_{2}$ involves multiplying a row by $\\frac{4}{5},$ so the determinant is multiplied by $\\frac{4}{5}$ as well.\n\nTherefore, we have to change the sign of the determinant to the opposite one and multiply by $\\frac{4}{5}$ as well. Consequently, we get\n\n$$\n\\begin{aligned}det(C) & =\\frac{4}{5}\\cdot (-det(B)) \\\\  & =-\\frac{4}{5}det(B) \\\\  & =-\\frac{4}{5}\\cdot (-75) \\\\  & =60.\\end{aligned}\n$$"} :step/id #uuid "1776f775-68f2-5dfe-9a78-5fcd889a28cc" :step/next {:db/id #edb/ref 17592186440488}} {:db/id #edb/ref 17592186440488 :step/content {:db/id #edb/ref 17592186383216 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59b9b5a2-8dd1-5764-aa90-63de7756ab2c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{2}↔{R}_{3}" :db/id #edb/ref 17592186383218} {:answer/id #uuid "bea9ac5f-6965-5feb-9890-9a84bb8fa9c1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{1}:={R}_{1}+3{R}_{3}" :db/id #edb/ref 17592186383219} {:answer/id #uuid "c930d2e4-f0f9-5e23-b593-fbc36215932d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{1}:={R}_{1}+(-3){R}_{3}" :db/id #edb/ref 17592186383220} {:answer/id #uuid "dce12cc1-6fe9-5710-9501-662de6d6ea91" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{3}:=-3{R}_{3}" :db/id #edb/ref 17592186383221} {:answer/id #uuid "5c5d3036-4719-5fd7-ba58-918a06722081" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{2}:={R}_{2}+(-3){R}_{3}" :db/id #edb/ref 17592186383222}] :answer-field/correct {:db/id #edb/ref 17592186383220} :answer-field/id #uuid "d2936d46-0370-550d-9d6e-65ba694a9efd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186383217}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "38a459ba-c9b0-57c4-8ac3-81669bb1022e" :question/math-academy-id "q-130848" :question/problem "Given that $det(A)=det(B),$ which of the following elementary row operations transforms matrix $A$ to matrix $B,$ where\n\n$$\nA=[\\begin{aligned}3 & -2 & 1 \\\\ 2 & -1 & 3 \\\\ 1 & 2 & -3\\end{aligned}],\\,B=[\\begin{aligned}0 & -8 & 10 \\\\ 2 & -1 & 3 \\\\ 1 & 2 & -3\\end{aligned}]?\n$$" :question/worked-solution "Since $det(A)=det(B)$, the row operation applied to $A$ must be to add or subtract a multiple of one row to another row. In other words, it is of the form \n\n$$\n{R}_{j}:={R}_{j}+(k){R}_{i},\\,i\\ne j.\n$$\n\nBy considering the given row operations that are of the above form, we notice that\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}3 & -2 & 1 \\\\ 2 & -1 & 3 \\\\ 1 & 2 & -3\\end{aligned}| & {R}_{1} & :={R}_{1}+(-3){R}_{3} \\\\  & =|\\begin{aligned}0 & -8 & 10 \\\\ 2 & -1 & 3 \\\\ 1 & 2 & -3\\end{aligned}| \\\\  & =det(B).\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{1}:={R}_{1}+(-3){R}_{3}.\n$$"} :step/id #uuid "bc80a516-1dfa-5188-a931-81163ba5b5d8" :step/next {:db/id #edb/ref 17592186440486}} {:db/id #edb/ref 17592186440489 :step/content {:db/id #edb/ref 17592186440484 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "017c23cc-c363-5c6e-87b5-6e7c3ae5e977" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-60" :db/id #edb/ref 17592186440472} {:answer/id #uuid "0d4fda87-7e6e-55cf-a40d-16eb860dbe92" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-75" :db/id #edb/ref 17592186440474} {:answer/id #uuid "81b440ea-43a7-5db4-bd71-d49d81ed4b25" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-30" :db/id #edb/ref 17592186440477} {:answer/id #uuid "b26eabf3-1144-53cd-932b-1525e01f62fe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "90" :db/id #edb/ref 17592186440479} {:answer/id #uuid "fd7979e9-0f01-5714-b611-2b2303ead7b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "75" :db/id #edb/ref 17592186440481}] :answer-field/correct {:db/id #edb/ref 17592186440474} :answer-field/id #uuid "e1483cc5-4c9b-5aca-8098-5a910582cb85" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186440483}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ba8abd45-3c22-5be5-a8a7-0f2c616dbcc7" :question/math-academy-id "q-130770" :question/problem "Suppose $Y$ is a $9\\times 9$ matrix and $det(Y)=75.$ The matrix $Z$ is obtained from $Y$ by applying the elementary row operations ${R}_{8}↔{R}_{9}$ and ${R}_{7}:={R}_{7}+\\frac{2}{5}{R}_{2}.$ What is the value of $det(Z)?$" :question/worked-solution "First, let's figure out what each operation does to the determinant.\n\n- The operation ${R}_{8}↔{R}_{9}$ involves swapping two rows, so it changes the sign of the determinant to the opposite one.\n\n- The operation ${R}_{7}:={R}_{7}+\\frac{2}{5}{R}_{2}$ involves adding a multiple of one row to another row,  so it does not change the determinant.\n\nTherefore, we only have to change the sign of the determinant to the opposite one. Consequently, we get\n\n$$\n\\begin{aligned}det(Z) & =-det(Y) \\\\  & =-(75) \\\\  & =-75.\\end{aligned}\n$$"} :step/id #uuid "dddee882-e3d5-5fc5-bf4f-fc432c1be973" :step/next {:db/id #edb/ref 17592186440487}} {:db/id #edb/ref 17592186440490 :step/content {:db/id #edb/ref 17592186440485 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09a794be-72e1-5850-a9e7-4f09532bb4d8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-42" :db/id #edb/ref 17592186440473} {:answer/id #uuid "2c9a3462-424a-5e23-93a1-21351e2c8529" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-384" :db/id #edb/ref 17592186440475} {:answer/id #uuid "3aad9ad4-b303-5b2b-9d26-6d2c4b559298" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-21" :db/id #edb/ref 17592186440476} {:answer/id #uuid "8a223201-44a6-5017-aa80-a127d44a8e76" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-147" :db/id #edb/ref 17592186440478} {:answer/id #uuid "c00986c8-2ab1-5ba7-aed5-8ac51531c5fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-294" :db/id #edb/ref 17592186440480}] :answer-field/correct {:db/id #edb/ref 17592186440478} :answer-field/id #uuid "ad94b206-3ccb-5817-8ec1-05230e22359f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186440482}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fc497788-364d-5c29-8657-a4f1556e2704" :question/math-academy-id "q-72744" :question/problem "Suppose $X$ is a $2\\times 2$ matrix and $det(X)=-3.$ What is the value of $det(7X)?$" :question/worked-solution "Multiplying a $n\\times n$ matrix by a scalar $k$ is equivalent to multiplying each row by $k,$ and this occurs $n$ times. This leads to the result\n\n$$\n\\begin{aligned}det(k\\cdot X)={k}^{n}\\cdot det(X).\\end{aligned}\n$$\n\nIn our case, we have $k=7$ and $n=2.$ Therefore,\n\n$$\n\\begin{aligned}det(7X) & ={7}^{2}\\cdot det(X) \\\\  & =49\\cdot (-3) \\\\  & =-147.\\end{aligned}\n$$"} :step/id #uuid "ea78220d-d076-5d61-804b-70c264ba0078" :step/next {:db/id #edb/ref 17592186440489}}] :activity/title "Row and Column Operations on Determinants" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186440471}]}
