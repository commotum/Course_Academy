#{[{:db/id #edb/ref 17592186440484 :knowledge-point/_questions [{:db/id #edb/ref 17592186119777 :knowledge-point/id #uuid "24e5e193-5e30-5480-9e5d-b7b8f1d5de87" :knowledge-point/title "Calculating a Determinant After Applying Several Elementary Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "017c23cc-c363-5c6e-87b5-6e7c3ae5e977" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-60" :db/id #edb/ref 17592186440472} {:answer/id #uuid "0d4fda87-7e6e-55cf-a40d-16eb860dbe92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-75" :db/id #edb/ref 17592186440474} {:answer/id #uuid "81b440ea-43a7-5db4-bd71-d49d81ed4b25" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-30" :db/id #edb/ref 17592186440477} {:answer/id #uuid "b26eabf3-1144-53cd-932b-1525e01f62fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "90" :db/id #edb/ref 17592186440479} {:answer/id #uuid "fd7979e9-0f01-5714-b611-2b2303ead7b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "75" :db/id #edb/ref 17592186440481}] :answer-field/correct {:answer/id #uuid "0d4fda87-7e6e-55cf-a40d-16eb860dbe92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-75" :db/id #edb/ref 17592186440474} :answer-field/id #uuid "e1483cc5-4c9b-5aca-8098-5a910582cb85" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186440483}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ba8abd45-3c22-5be5-a8a7-0f2c616dbcc7" :question/math-academy-id "q-130770" :question/problem "Suppose $Y$ is a $9\\times 9$ matrix and $det(Y)=75.$ The matrix $Z$ is obtained from $Y$ by applying the elementary row operations ${R}_{8}↔{R}_{9}$ and ${R}_{7}:={R}_{7}+\\frac{2}{5}{R}_{2}.$ What is the value of $det(Z)?$" :question/worked-solution "First, let's figure out what each operation does to the determinant.\n\n- The operation ${R}_{8}↔{R}_{9}$ involves swapping two rows, so it changes the sign of the determinant to the opposite one.\n\n- The operation ${R}_{7}:={R}_{7}+\\frac{2}{5}{R}_{2}$ involves adding a multiple of one row to another row,  so it does not change the determinant.\n\nTherefore, we only have to change the sign of the determinant to the opposite one. Consequently, we get\n\n$$\n\\begin{aligned}det(Z) & =-det(Y) \\\\  & =-(75) \\\\  & =-75.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186265972 :knowledge-point/_questions [{:db/id #edb/ref 17592186119777 :knowledge-point/id #uuid "24e5e193-5e30-5480-9e5d-b7b8f1d5de87" :knowledge-point/title "Calculating a Determinant After Applying Several Elementary Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c504d34-49a8-5293-9654-9bb371251af7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-90" :db/id #edb/ref 17592186263118} {:answer/id #uuid "668e2da3-ac3d-5bec-b6b1-16504c2d81fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "90" :db/id #edb/ref 17592186263886} {:answer/id #uuid "7573103e-73e5-56e6-832d-af6582780369" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186264021} {:answer/id #uuid "90344634-d8cd-51fb-85d7-7f08481a8bde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186264236} {:answer/id #uuid "c168c56a-3c78-5c71-873d-48190da505aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-75" :db/id #edb/ref 17592186264678}] :answer-field/correct {:answer/id #uuid "90344634-d8cd-51fb-85d7-7f08481a8bde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186264236} :answer-field/id #uuid "37455212-8943-576e-a134-59b320488bd0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265345}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b71bc5d0-3557-578c-8a3d-25da59fcce16" :question/math-academy-id "q-130771" :question/problem "Suppose $B$ is a $6\\times 6$ matrix and $det(B)=-75.$ The matrix $C$ is obtained from $B$ by applying the elementary row operations ${R}_{2}:=\\frac{4}{5}{R}_{2}$ and ${R}_{5}↔{R}_{6}.$ What is the value of $det(C)?$" :question/worked-solution "First, let's figure out what each operation does to the determinant.\n\n- The operation ${R}_{5}↔{R}_{6}$ involves swapping two rows, so it changes the sign of the determinant to the opposite one.\n\n- The operation ${R}_{2}:=\\frac{4}{5}{R}_{2}$ involves multiplying a row by $\\frac{4}{5},$ so the determinant is multiplied by $\\frac{4}{5}$ as well.\n\nTherefore, we have to change the sign of the determinant to the opposite one and multiply by $\\frac{4}{5}$ as well. Consequently, we get\n\n$$\n\\begin{aligned}det(C) & =\\frac{4}{5}\\cdot (-det(B)) \\\\  & =-\\frac{4}{5}det(B) \\\\  & =-\\frac{4}{5}\\cdot (-75) \\\\  & =60.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186383216 :knowledge-point/_questions [{:db/id #edb/ref 17592186119850 :knowledge-point/id #uuid "9a0ab53e-79ff-5520-bb50-069fd381d29d" :knowledge-point/title "Identifying a Row Operation Given the Connection Between Two Determinants"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59b9b5a2-8dd1-5764-aa90-63de7756ab2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{2}↔{R}_{3}" :db/id #edb/ref 17592186383218} {:answer/id #uuid "bea9ac5f-6965-5feb-9890-9a84bb8fa9c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{1}:={R}_{1}+3{R}_{3}" :db/id #edb/ref 17592186383219} {:answer/id #uuid "c930d2e4-f0f9-5e23-b593-fbc36215932d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{1}:={R}_{1}+(-3){R}_{3}" :db/id #edb/ref 17592186383220} {:answer/id #uuid "dce12cc1-6fe9-5710-9501-662de6d6ea91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{3}:=-3{R}_{3}" :db/id #edb/ref 17592186383221} {:answer/id #uuid "5c5d3036-4719-5fd7-ba58-918a06722081" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+(-3){R}_{3}" :db/id #edb/ref 17592186383222}] :answer-field/correct {:answer/id #uuid "c930d2e4-f0f9-5e23-b593-fbc36215932d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{1}:={R}_{1}+(-3){R}_{3}" :db/id #edb/ref 17592186383220} :answer-field/id #uuid "d2936d46-0370-550d-9d6e-65ba694a9efd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383217}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "38a459ba-c9b0-57c4-8ac3-81669bb1022e" :question/math-academy-id "q-130848" :question/problem "Given that $det(A)=det(B),$ which of the following elementary row operations transforms matrix $A$ to matrix $B,$ where\n\n$$\nA=[\\begin{aligned}3 & -2 & 1 \\\\ 2 & -1 & 3 \\\\ 1 & 2 & -3\\end{aligned}],\\,B=[\\begin{aligned}0 & -8 & 10 \\\\ 2 & -1 & 3 \\\\ 1 & 2 & -3\\end{aligned}]?\n$$" :question/worked-solution "Since $det(A)=det(B)$, the row operation applied to $A$ must be to add or subtract a multiple of one row to another row. In other words, it is of the form \n\n$$\n{R}_{j}:={R}_{j}+(k){R}_{i},\\,i\\ne j.\n$$\n\nBy considering the given row operations that are of the above form, we notice that\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}3 & -2 & 1 \\\\ 2 & -1 & 3 \\\\ 1 & 2 & -3\\end{aligned}| & {R}_{1} & :={R}_{1}+(-3){R}_{3} \\\\  & =|\\begin{aligned}0 & -8 & 10 \\\\ 2 & -1 & 3 \\\\ 1 & 2 & -3\\end{aligned}| \\\\  & =det(B).\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{1}:={R}_{1}+(-3){R}_{3}.\n$$"}] [{:db/id #edb/ref 17592186378657 :knowledge-point/_questions [{:db/id #edb/ref 17592186119850 :knowledge-point/id #uuid "9a0ab53e-79ff-5520-bb50-069fd381d29d" :knowledge-point/title "Identifying a Row Operation Given the Connection Between Two Determinants"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "319beb45-da82-5928-83bf-d29bc52ed19f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186378659} {:answer/id #uuid "a259e746-f501-54ae-be55-fef569b47320" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186378660} {:answer/id #uuid "21d9eeeb-c150-51f2-9c34-5dfbb8074a06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186378661} {:answer/id #uuid "ca0902b3-371c-5ed1-bcca-bdf20d2b6da8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186378662} {:answer/id #uuid "6227f8a3-0c1e-5bad-a5c1-bba85528c3cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186378663}] :answer-field/correct {:answer/id #uuid "a259e746-f501-54ae-be55-fef569b47320" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186378660} :answer-field/id #uuid "addc5023-5343-5d6e-94d4-459e9803d13f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378658}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fbcc8a51-42ac-5cb8-a6bc-0647017d9ba5" :question/math-academy-id "q-130858" :question/problem "Consider the matrices given below. Given that $X$ and $Y$ are row equivalent matrices and $det(X)=14$, find $det(Y).$\n\n$$\nX=[\\begin{aligned}2 & -3 & 1 \\\\ 1 & 4 & -2 \\\\ 5 & 3 & -1\\end{aligned}],\\,Y=[\\begin{aligned}2 & -3 & 1 \\\\ 5 & 3 & -1 \\\\ 1 & 4 & -2\\end{aligned}].\n$$" :question/worked-solution "Notice that $Y$ can be obtained from $X$ by swapping the $2$nd and the $3$rd rows. \n\nThis changes the sign of the determinant to the opposite one.\nTherefore, we obtain\n\n$$\n\\begin{aligned}det(Y) & =-det(X) \\\\  & =-(14) \\\\  & =-14.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186440485 :knowledge-point/_questions [{:db/id #edb/ref 17592186119851 :knowledge-point/id #uuid "272d9a54-ba97-5175-86df-0a78337da7b9" :knowledge-point/title "Calculating a Determinant After Multiplying a Matrix by a Scalar"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09a794be-72e1-5850-a9e7-4f09532bb4d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-42" :db/id #edb/ref 17592186440473} {:answer/id #uuid "2c9a3462-424a-5e23-93a1-21351e2c8529" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-384" :db/id #edb/ref 17592186440475} {:answer/id #uuid "3aad9ad4-b303-5b2b-9d26-6d2c4b559298" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-21" :db/id #edb/ref 17592186440476} {:answer/id #uuid "8a223201-44a6-5017-aa80-a127d44a8e76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-147" :db/id #edb/ref 17592186440478} {:answer/id #uuid "c00986c8-2ab1-5ba7-aed5-8ac51531c5fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-294" :db/id #edb/ref 17592186440480}] :answer-field/correct {:answer/id #uuid "8a223201-44a6-5017-aa80-a127d44a8e76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-147" :db/id #edb/ref 17592186440478} :answer-field/id #uuid "ad94b206-3ccb-5817-8ec1-05230e22359f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186440482}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fc497788-364d-5c29-8657-a4f1556e2704" :question/math-academy-id "q-72744" :question/problem "Suppose $X$ is a $2\\times 2$ matrix and $det(X)=-3.$ What is the value of $det(7X)?$" :question/worked-solution "Multiplying a $n\\times n$ matrix by a scalar $k$ is equivalent to multiplying each row by $k,$ and this occurs $n$ times. This leads to the result\n\n$$\n\\begin{aligned}det(k\\cdot X)={k}^{n}\\cdot det(X).\\end{aligned}\n$$\n\nIn our case, we have $k=7$ and $n=2.$ Therefore,\n\n$$\n\\begin{aligned}det(7X) & ={7}^{2}\\cdot det(X) \\\\  & =49\\cdot (-3) \\\\  & =-147.\\end{aligned}\n$$"}]}
