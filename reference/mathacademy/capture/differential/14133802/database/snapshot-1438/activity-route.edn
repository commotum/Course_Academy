#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186435005} :activity/id #uuid "55d163d3-8f28-5869-a65b-cfaaab7569eb" :activity/scope {:db/id #edb/ref 17592186049076 :topic/id #uuid "d8ad0390-dfee-58d8-ac50-00cbfdc660af" :topic/math-academy-id 4393} :activity/steps [{:db/id #edb/ref 17592186435004 :step/content {:db/id #edb/ref 17592186198873 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8858ad30-a1fc-5136-97b2-1c0e818522eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "Q" :db/id #edb/ref 17592186196497} {:answer/id #uuid "0ffd3501-b258-5c11-bccd-bfa4138ce20a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "Z" :db/id #edb/ref 17592186196498} {:answer/id #uuid "68b3b0b4-5207-504a-9560-62f599a49306" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "N" :db/id #edb/ref 17592186196499}] :answer-field/correct {:db/id #edb/ref 17592186196499} :answer-field/id #uuid "9b9bed19-3128-508d-b4d4-f5e8ece817d0" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186196496} {:answer-field/choices [{:answer/id #uuid "1992cc29-bfe9-5821-ab65-85db7c9275d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{5}{2}\\cdot {2}^{n}" :db/id #edb/ref 17592186435000} {:answer/id #uuid "288cc4b2-c914-5214-82ea-49b388ebac4a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{5}\\cdot {2}^{n}" :db/id #edb/ref 17592186435001} {:answer/id #uuid "cde8a085-4109-5cb9-b7e6-882a1aca743e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5\\cdot {2}^{n}" :db/id #edb/ref 17592186435002} {:answer/id #uuid "fbe45b33-5883-51ed-9f7c-2fa52c2e29d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2}\\cdot {5}^{n}" :db/id #edb/ref 17592186435003}] :answer-field/correct {:db/id #edb/ref 17592186435000} :answer-field/id #uuid "66c4793e-1f9c-549e-b450-2f3a6b0a8958" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186196500}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d9cd56d9-afeb-5bee-b832-904b834a28b7" :question/math-academy-id "q-183783" :question/problem "Describe the set $S=\\{-5,-10,-20,-40,...\\}$ using a constructive definition.\n\n$$\nS=\\{{{field-1}}\\,:\\,n\\in {{field-2}}\\}\n$$" :question/worked-solution "Notice that the elements of our set\n\n$$\n-5,\\,-10,\\,-20,\\,-40,\\,…\n$$\n\nform an infinite geometric sequence with a common ratio $r=2:$\n\n$$\n\\begin{aligned}r & =2 \\\\  & =\\frac{-10}{-5} \\\\  & =\\frac{-20}{-10} \\\\  & =\\frac{-40}{-20} \\\\  & =⋯\\end{aligned}\n$$\n\nTherefore, the $n$th term ${a}_{n}$ of our sequence for $n\\in N,$ is given by\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}\\cdot {r}^{n-1} \\\\  & =(-5)\\cdot {2}^{n-1} \\\\  & =(-5)\\cdot {2}^{n}\\cdot {2}^{-1} \\\\  & =-\\frac{5}{2}\\cdot {2}^{n}.\\end{aligned}\n$$\n\nTherefore, we can define our set using a constructive definition as follows:\n\n$$\nS=\\{-\\frac{5}{2}\\cdot {2}^{n}\\,:\\,n\\in N\\}\n$$"} :step/id #uuid "3a19ba88-b779-5826-958c-8abfa367305b" :step/next {:db/id #edb/ref 17592186435007}} {:db/id #edb/ref 17592186435005 :step/content {:db/id #edb/ref 17592186198868 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c9cb22bc-c849-5803-89e4-d98877fc3515" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186196459} {:answer/id #uuid "fbecb70d-8f67-57a2-8caf-e4ec0a4a28ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5" :db/id #edb/ref 17592186196460} {:answer/id #uuid "18e72be2-9522-558c-8485-ee9401f12329" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186196461}] :answer-field/correct {:db/id #edb/ref 17592186196460} :answer-field/id #uuid "a13b1baf-b8d5-5bf0-9e9b-2f7e906968e3" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186196458} {:answer-field/choices [{:answer/id #uuid "cab8b452-d8b6-50b7-ad19-a2d9d3bc61a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "R" :db/id #edb/ref 17592186196463} {:answer/id #uuid "ff276ba3-0303-57aa-a644-69cb68bb40ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "Z" :db/id #edb/ref 17592186196464} {:answer/id #uuid "025ee5da-2082-5ab7-9304-4290cd564fba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "N" :db/id #edb/ref 17592186196465} {:answer/id #uuid "46cadc56-915c-5bf6-ac99-bc2b0dedafdf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "C" :db/id #edb/ref 17592186196466}] :answer-field/correct {:db/id #edb/ref 17592186196464} :answer-field/id #uuid "e4202584-6d20-5da6-a11c-dc8acbfb31d1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186196462}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "420915e5-5c9a-5a4d-98c1-b942b60af8d6" :question/math-academy-id "q-183695" :question/problem "Describe the set $S=\\{-4,-3,-2,-1,0,1,…\\}$ using a conditional definition.\n\n$$\nS=\\{x\\in {{field-1}}\\,:\\,x>{{field-2}}\\}\n$$" :question/worked-solution "The set $S$ contains all integers greater than $-4,$ including $-4.$\n\nIn other words, $S$ contains all integers greater than $-5,$ *excluding* $-5.$ \n\nTherefore, the set can be written as\n\n$$\nS=\\{x\\in Z\\,:\\,x>-5\\}.\n$$\n\n**Note**: This definition is not unique. For example:\n\n- We can write $x\\ge -4.$ This gives\n\n$$\nS=\\{x\\in Z\\,:\\,x\\ge -4\\}.\n$$"} :step/id #uuid "43789ff6-ead3-53a4-9c70-d7e0bdd62fe0" :step/next {:db/id #edb/ref 17592186435006}} {:db/id #edb/ref 17592186435006 :step/content {:db/id #edb/ref 17592186287849 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89b7b5ee-3fb2-52fd-bd01-5d7d26548bb4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186286047}] :answer-field/correct {:db/id #edb/ref 17592186286047} :answer-field/id #uuid "76528791-74c8-5eaf-b63f-209d60da64af" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186287398} {:answer-field/choices [{:answer/id #uuid "4caae365-9f4a-5967-8cd1-ffe0c1113238" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186285503}] :answer-field/correct {:db/id #edb/ref 17592186285503} :answer-field/id #uuid "cfb29df0-619b-574f-9a2b-69bb58650179" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186287574}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "257b25c4-c664-5a50-8385-3bced23d988c" :question/math-academy-id "q-183704" :question/problem "Find the missing coefficients in the conditional definition of the set $\\{-\\frac{1}{2},3\\}$ given below.\n\n$\\{-\\frac{1}{2},3\\}=\\{q\\in Q\\,:\\,4{q}^{2}\\,-$\n{{field-1}}\n$q\\,-$\n{{field-2}}\n$=0\\}$" :question/worked-solution "The given set contains the roots $q\\in Q$ of some quadratic polynomial $p(q).$\n\nSince the quadratic polynomial has roots ${q}_{1}=-\\frac{1}{2}$ and ${q}_{2}=3,$ and the coefficient of the quadratic term is $a=4,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}p(q) & =a(q-{q}_{1})(q-{q}_{2}) \\\\  & =4\\cdot (q-(-\\frac{1}{2}))(q-3) \\\\  & =4(q+\\frac{1}{2})(q-3) \\\\  & =4({q}^{2}-\\frac{5q}{2}-\\frac{3}{2}) \\\\  & =4{q}^{2}-10q-6\\end{aligned}\n$$\n\nTherefore, we can express the given set as follows:\n\n$$\n\\{-\\frac{1}{2},3\\}=\\{q\\in Q\\,:\\,4{q}^{2}-10q-6=0\\}\n$$"} :step/id #uuid "b48819c1-8133-563a-afd7-f37f211bbce6" :step/next {:db/id #edb/ref 17592186435008}} {:db/id #edb/ref 17592186435007 :step/content {:db/id #edb/ref 17592186287864 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f70558b-9b80-5074-a897-55d56cf8c03f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\cdot {(\\frac{1}{2})}^{n}" :db/id #edb/ref 17592186285066} {:answer/id #uuid "4d28ecd1-362a-57b1-9296-f5a249fa03ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}\\cdot {2}^{n}" :db/id #edb/ref 17592186285510} {:answer/id #uuid "95dc22f6-9202-5599-b14c-8c73b8ad403f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}\\cdot {4}^{n}" :db/id #edb/ref 17592186286149} {:answer/id #uuid "e7b13302-fdde-5fca-b646-ae6982ea68fb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\cdot {2}^{n}" :db/id #edb/ref 17592186286910}] :answer-field/correct {:db/id #edb/ref 17592186285066} :answer-field/id #uuid "7ff62c3a-55b1-53ac-a531-74fb73d16788" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186287418} {:answer-field/choices [{:answer/id #uuid "30c607b5-a5c7-59f2-a7f7-9e387733756b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "N" :db/id #edb/ref 17592186285229} {:answer/id #uuid "3ae40c83-330a-5e8f-89eb-c0e99329a338" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "Q" :db/id #edb/ref 17592186285340} {:answer/id #uuid "635190f4-8e04-567e-9b91-4ead034e4c83" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "Z" :db/id #edb/ref 17592186285695}] :answer-field/correct {:db/id #edb/ref 17592186285229} :answer-field/id #uuid "c4514aa9-a19c-542d-9372-4e689994fcb0" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186287548}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "652769f0-9ddf-5075-bef3-a5f8f9537f1b" :question/math-academy-id "q-183792" :question/problem "Describe the set $S=\\{2,1,\\frac{1}{2},\\frac{1}{4},...\\}$ using a constructive definition.\n\n$$\nS=\\{{{field-1}}\\,:\\,n\\in {{field-2}}\\}\n$$" :question/worked-solution "Notice that the elements of our set\n\n$$\n2,\\,1,\\,\\frac{1}{2},\\,\\frac{1}{4},\\,…\n$$\n\nform an infinite geometric sequence with a common ratio $r=\\frac{1}{2}:$\n\n$$\n\\begin{aligned}r & =\\frac{1}{2} \\\\  & =\\frac{\\frac{1}{2}}{1} \\\\  & =\\frac{\\frac{1}{4}}{\\frac{1}{2}} \\\\  & =⋯\\end{aligned}\n$$\n\nTherefore, the $n$th term ${a}_{n}$ of our sequence for $n\\in N,$ is given by\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}\\cdot {r}^{n-1} \\\\  & =2\\cdot {(\\frac{1}{2})}^{n-1} \\\\  & =2\\cdot {(\\frac{1}{2})}^{n}\\cdot {(\\frac{1}{2})}^{-1} \\\\  & =4\\cdot {(\\frac{1}{2})}^{n}.\\end{aligned}\n$$\n\nTherefore, we can define our set using a constructive definition as follows:\n\n$$\nS=\\{4\\cdot {(\\frac{1}{2})}^{n}\\,:\\,n\\in N\\}\n$$"} :step/id #uuid "e1124dcc-a673-55f5-863e-080064a239ce"} {:db/id #edb/ref 17592186435008 :step/content {:db/id #edb/ref 17592186287853 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "803af8dd-6893-5a10-8e26-fc625184e410" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186285969}] :answer-field/correct {:db/id #edb/ref 17592186285969} :answer-field/id #uuid "09db60c0-d257-522a-8121-4ea5cfade2a8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186287164} {:answer-field/choices [{:answer/id #uuid "76be5a3f-914e-5ea4-a758-87e05d62dd77" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186285892}] :answer-field/correct {:db/id #edb/ref 17592186285892} :answer-field/id #uuid "6ea3a667-b850-52d2-977b-fc80803d1e7b" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186287377}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e2b6a6ba-df80-5524-9383-3ef68a2189d1" :question/math-academy-id "q-183730" :question/problem "Find the missing coefficients in the conditional definition of the set $\\{1\\pm \\text{i}\\}$ given below.\n\n$\\{1\\pm \\text{i}\\}=\\{z\\in C\\,:\\,2{z}^{2}\\,-$\n{{field-1}}\n$z\\,+$\n{{field-2}}\n$=0\\}$" :question/worked-solution "The given set contains the roots $z\\in C$ of some quadratic polynomial $p(z).$\n\nSince the quadratic polynomial has roots ${z}_{1}=1-\\text{i}$ and ${z}_{2}=1+\\text{i},$ and the coefficient of the quadratic term is $a=2,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}f(z) & =a(z-{z}_{1})(z-{z}_{2}) \\\\  & =2\\cdot (z-(1-\\text{i}))(z-(1+\\text{i})) \\\\  & =2\\cdot ({z}^{2}-(1-\\text{i})z-(1+\\text{i})z+(1-\\text{i})(1+\\text{i})) \\\\  & =2\\cdot ({z}^{2}-(1-\\text{i}+1+\\text{i})z+((1)^{2}-(\\text{i})^{2})) \\\\  & =2\\cdot ({z}^{2}-(2)z+(1+1)) \\\\  & =2{z}^{2}-4z+4\\end{aligned}\n$$\n\nTherefore, we can express the given set as follows:\n\n$$\n\\{1\\pm \\text{i}\\}=\\{z\\in C\\,:\\,2{z}^{2}-4z+4=0\\}\n$$"} :step/id #uuid "e3ae9ce9-3f42-51dc-87d2-39964c93e221" :step/next {:db/id #edb/ref 17592186435004}}] :activity/title "Describing Sets Using Set-Builder Notation" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186434999}]}
