a24-b106-84d6dda6fd20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186286093} {:answer/id #uuid "9747c6cd-2d20-5bcc-8104-8d6541e63300" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le " :db/id #edb/ref 17592186286164} {:answer/id #uuid "f1133c28-8f6a-5662-9b2f-fcd2b754602d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ne " :db/id #edb/ref 17592186287000}] :answer-field/correct {:answer/id #uuid "9747c6cd-2d20-5bcc-8104-8d6541e63300" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le " :db/id #edb/ref 17592186286164} :answer-field/id #uuid "ad1642c5-900b-5a36-81db-caba15f6c1dc" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186287505}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "53b0ed93-9159-5efa-a2a9-9f30d7664a91" :question/math-academy-id "q-181678" :question/problem "![](images/0f/0f95f6b259237816a5a3da041452cfd9458f0852b1ae717a044738b6f310ab5d.png)\n\nDescribe the shaded region shown above using set-builder notation.\n\n$$\n{(x,y)\\in {{field-1}}\\,:\\,3\\,{{field-2}}\\,y\\,{{field-3}}\\,2x+3}\n$$" :question/worked-solution "The points in our set include all those that lie *above* the line $y=3$ and *below* the line $y=2x+3.$\n\nA point $P(x,y)$ lies *inside* the shaded region if the following conditions are satisfied:\n\n$$\ny>3,\\,y<2x+3.\n$$\n\nCombining this into a single condition, we have\n\n$$\n3<y<2x+3.\n$$\n\nWe must also include the lines $y=3$ and $y=2x+3$ since the boundaries are included in the set (the lines are solid). So, we change the corresponding inequality symbols above as follows:\n\n$$\n3\\le y\\le 2x+3\n$$\n\nMoreover, since we're considering *every* real value in this region, $x\\in R,y\\in R,$ and therefore \n\n$$\n(x,y)\\in R\\times R={R}^{2}.\n$$\n\nTherefore, we can write the set as\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,3\\le y\\le 2x+3}.\n$$"}] [{:db/id #edb/ref 17592186287725 :knowledge-point/_questions [{:db/id #edb/ref 17592186198476 :knowledge-point/id #uuid "5a3df69f-653e-5148-bd46-580097e43362" :knowledge-point/title "Linear Boundaries, Two Conditions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b7a7422-0bcf-5706-ae8f-72c9ece61bc7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ne " :db/id #edb/ref 17592186285166} {:answer/id #uuid "2d166e9a-fcd9-5b6d-89d1-3e838ceada86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le " :db/id #edb/ref 17592186285186} {:answer/id #uuid "626c9538-6fdc-52f9-9f52-20ce738bf7eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186285689} {:answer/id #uuid "9a12840e-a2c3-50de-9e43-87a31770bd26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ge " :db/id #edb/ref 17592186286199} {:answer/id #uuid "cf4b0e6c-806d-5a0b-ae15-ee9ed923b4a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186286671}] :answer-field/correct {:answer/id #uuid "626c9538-6fdc-52f9-9f52-20ce738bf7eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186285689} :answer-field/id #uuid "19da688f-4cba-51c2-8892-be4247f77378" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186287194} {:answer-field/choices [{:answer/id #uuid "0014d307-5e77-586a-b23e-f2aba6c41f38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{2}" :db/id #edb/ref 17592186284789} {:answer/id #uuid "01b659a3-