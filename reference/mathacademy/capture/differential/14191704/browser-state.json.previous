      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14191704/observations/step-q142715-de143cf0d15ffadedc45.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14191704/observations/step-q142715-de143cf0d15ffadedc45.png",
      "source_url": "https://mathacademy.com/tasks/14191704/topics/3300/lesson",
