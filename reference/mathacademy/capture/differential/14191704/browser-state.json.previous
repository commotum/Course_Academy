"></mjx-c><mjx-c class=\"mjx-c35\"></mjx-c></mjx-mn><mjx-tstrut></mjx-tstrut></mjx-mtd></mjx-mtr></mjx-itable></mjx-table></mjx-mtable></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mtable displaystyle=\"true\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"0.8em 0.3em\"><mtr><mtd></mtd><mtd><mn>0</mn><mo>,</mo><mn>68</mn><mo>±</mo><mn>2.576</mn><mo>⋅</mo><msqrt><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>0.68</mn><mo stretchy=\"false\">(</mo><mn>1</mn><mo>−</mo><mn>0.68</mn><mo stretchy=\"false\">)</mo></mrow><mrow><mn>1</mn><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mn>200</mn></mrow></mfrac></mstyle></msqrt></mtd></mtr><mtr><mtd></mtd><mtd><mn>0.68</mn><mo>±</mo><mn>0.035</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container> </p>\n</div></div>",
