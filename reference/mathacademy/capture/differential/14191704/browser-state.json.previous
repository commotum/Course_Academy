      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14191704/observations/step-q225615-eb546860a98357b3f163.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14191704/observations/step-q225615-eb546860a98357b3f163.png",
      "source_url": "https://mathacademy.com/tasks/14191704/topics/3300/lesson",
      "captured_at": 1791936313.8960307,
      "math_academy_id": "q-225615",
      "topic_id": "3300",
      "sequence_position": null,
      "source_step": {
