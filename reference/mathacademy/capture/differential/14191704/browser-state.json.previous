.8em 0.3em\"><mtr><mtd></mtd><mtd><mn>0.65</mn><mo>±</mo><mn>1.96</mn><mo>⋅</mo><msqrt><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>0.65</mn><mo stretchy=\"false\">(</mo><mn>1</mn><mo>−</mo><mn>0.65</mn><mo stretchy=\"false\">)</mo></mrow><mn>100</mn></mfrac></mstyle></msqrt></mtd></mtr><mtr><mtd></mtd><mtd><mn>0.65</mn><mo>±</mo><mn>0.093</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
