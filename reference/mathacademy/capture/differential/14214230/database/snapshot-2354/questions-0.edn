#{[{:db/id #edb/ref 17592186157195 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186157375 :knowledge-point/id #uuid "14a5ffb6-c652-5626-b6c2-bcd5004b6297" :knowledge-point/title "Calculating a Probability in Context"}] :question/id #uuid "6c73f039-2cb9-516e-9fdf-dc1054ca93c4" :question/math-academy-id "e-8305" :question/problem "The duration of a radio program is uniformly distributed between $27$ and $34$ minutes, inclusive. What is the probability that a randomly chosen program lasts less than $30$ minutes?" :question/worked-solution "Let $X$ represent the duration of the radio program. From the problem statement, we know that $X \\sim U[27,34],$ and we wish to compute $P(X < 30).$\n\nIn general, if $X \\sim U[a,b],$ then $X$ has the following probability density function:\n\n![](images/2a/2a615c021abbdd4009eb1debcda9b9c3076f6a9f087c6e1e6fd9454b9334eb17.svg)\n\nSo, for our random variable $X \\sim U[27,34],$ we have the following probability density function:\n\n![](images/93/938214f94631d071b2bcd6b672e3b9b903918a88676da2cdc3b978cd94d891b2.svg)\n\nTherefore,\n\n$$\n\\begin{aligned}P(X<30) & ={\\int }_{27}^{30}f(x)\\,\\text{d}x \\\\  & ={\\int }_{27}^{30}\\frac{1}{7}\\,\\text{d}x \\\\  & ={\\frac{x}{7}|}_{27}^{30} \\\\  & =\\frac{30}{7}-\\frac{27}{7} \\\\  & =\\frac{3}{7}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186157196 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186157376 :knowledge-point/id #uuid "38f8d9f6-9ef8-5cc1-b2d8-38936c08468a" :knowledge-point/title "Calculating an Expected Value in Context"}] :question/id #uuid "70b91fcc-70a7-580d-84b0-b24a7e2643d5" :question/math-academy-id "e-8306" :question/problem "A video game randomly generates an obstacle the player has to avoid. The obstacle's $x$-coordinate is uniformly distributed along a segment whose endpoints have $x$-coordinates of $-6$ and $12.$ What is the mean $x$-coordinate of the obstacle?" :question/worked-solution "Let $X$ represent the $x$-coordinate of a randomly generated obstacle. From the problem statement, we know that $X \\sim U[-6,12],$ and we wish to compute $\\textrm E[X].$\n\nIn general, if $X \\sim U[a,b],$ then $X$ has the following expected value:\n\n$$\n\\textrm E[X] = \\dfrac{a+b}{2}\n$$\n\nSo, for our random variable $X \\sim U[-6,12],$ we have the following expected value:\n\n$$\n\\textrm E[X] = \\dfrac{-6+12}{2} = 3\n$$\n\nTherefore, the mean $x$-coordinate is $3.$"}] [{:db/id #edb/ref 17592186157197 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186157377 :knowledge-point/id #uuid "610bddb6-0731-53d1-9fcf-ab202d4cf151" :knowledge-point/title "Calculating a Variance in Context"}] :question/id #uuid "2ab8efcd-495b-5ed4-a6be-e3d24d046fe1" :question/math-academy-id "e-8307" :question/problem "A museum manager notices that the minimum visiting time of visitors to the museum is $1.5$ hours, whereas the maximum time is $4.5$ hours. If the visiting time is uniformly distributed, what is its variance?" :question/worked-solution "Let $X$ represent the visiting time of a randomly chosen visitor. From the problem statement, we know that $X \\sim U[1.5,4.5],$ and we wish to compute $\\textrm{Var}[X].$\n\nIn general, if $X \\sim U[a,b],$ then $X$ has the following variance:\n\n$$\n\\textrm{Var}[X] = \\dfrac{(b-a)^2}{12}\n$$\n\nSo, for our random variable $X \\sim U[1.5,4.5],$ we have the following variance:\n\n$$\n\\textrm{Var}[X] = \\dfrac{(4.5-1.5)^2}{12} = \\dfrac{9}{12} = \\dfrac{3}{4}\n$$\n\nTherefore, the variance is $\\dfrac{3}{4}\\,\\textrm{hr}^2.$"}] [{:db/id #edb/ref 17592186524995 :knowledge-point/_questions [{:db/id #edb/ref 17592186157375 :knowledge-point/id #uuid "14a5ffb6-c652-5626-b6c2-bcd5004b6297" :knowledge-point/title "Calculating a Probability in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f89f754-b00e-5b7c-b63f-401fe4f471d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186524409} {:answer/id #uuid "694234a6-597f-5e61-b5bf-84fc5b6aa6e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186524554} {:answer/id #uuid "6c3f9669-23d7-5243-84e9-d09de434a07d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{18}" :db/id #edb/ref 17592186524557} {:answer/id #uuid "a7c0d009-d03a-5fb2-a0bd-6539af2c96d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{18}" :db/id #edb/ref 17592186524651} {:answer/id #uuid "ba99982b-5521-5081-812d-09016da48ec3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186524679}] :answer-field/correct {:answer/id #uuid "ba99982b-5521-5081-812d-09016da48ec3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186524679} :answer-field/id #uuid "11562c89-3fe2-5b73-bf46-55642d35bb9e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524847}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "75c2a299-1223-5668-b631-6cae0200f484" :question/math-academy-id "q-170687" :question/problem "In an online poker tournament, the maximum loss is $10$ dollars, and the maximum win is $8$ dollars. Assuming that a player's earnings are uniformly distributed between $-10$ and $8,$ what is the probability that a randomly chosen player loses between $2$ and $8$ dollars?" :question/worked-solution "Let $X$ represent the earnings of a randomly chosen player. From the problem statement, we know that $X∼U[-10,8],$ and we wish to compute $P(-8\\le X\\le -2).$\n\nIn general, if $X∼U[a,b],$ then $X$ has the following probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{b-a}, & a\\le x\\le b \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nSo, for our random variable $X∼U[-10,8],$ we have the following probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{18}, & -10\\le x\\le 8 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(-8\\le X\\le -2) & ={\\int }_{-8}^{-2}f(x)\\,\\text{d}x \\\\  & ={\\int }_{-8}^{-2}\\frac{1}{18}\\,\\text{d}x \\\\  & ={\\frac{x}{18}|}_{-8}^{-2} \\\\  & =-\\frac{2}{18}-(-\\frac{8}{18}) \\\\  & =\\frac{1}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186525022 :knowledge-point/_questions [{:db/id #edb/ref 17592186157376 :knowledge-point/id #uuid "38f8d9f6-9ef8-5cc1-b2d8-38936c08468a" :knowledge-point/title "Calculating an Expected Value in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3be5c8b5-28f2-5645-b875-656ae6aa32d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2.5%" :db/id #edb/ref 17592186524492} {:answer/id #uuid "82c1f078-7b17-5093-a2b1-e9a218c6e391" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5%" :db/id #edb/ref 17592186524585} {:answer/id #uuid "a98338f2-91a3-5fd0-b05b-41b44d5b2088" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.5%" :db/id #edb/ref 17592186524654} {:answer/id #uuid "bafe428e-9edd-5e95-bef2-1daa264b46f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6.25%" :db/id #edb/ref 17592186524680} {:answer/id #uuid "f6815909-1c16-57b5-8a29-b68e399a5fc1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10%" :db/id #edb/ref 17592186524819}] :answer-field/correct {:answer/id #uuid "a98338f2-91a3-5fd0-b05b-41b44d5b2088" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.5%" :db/id #edb/ref 17592186524654} :answer-field/id #uuid "7f1ec29c-42d2-57fd-ab8f-09eebbc31a36" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524898}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a26697c2-b707-5c92-9d4e-fbd65d029113" :question/math-academy-id "q-170689" :question/problem "The return on a risky investment can be negative (meaning that the investor loses money) or positive. Assuming that the return on a particular investment is uniformly distributed between $-7.5%$ and $12.5%$, what is the mean return of this investment?" :question/worked-solution "Let $X$ represent the return on the investment. From the problem statement, we know that $X∼U[-7.5,12.5],$ and we wish to compute $\\text{E}[X].$\n\nIn general, if $X∼U[a,b],$ then $X$ has the following expected value:\n\n$$\n\\text{E}[X]=\\frac{a+b}{2}\n$$\n\nSo, for our random variable $X∼U[-7.5,12.5],$ we have the following expected value:\n\n$$\n\\text{E}[X]=\\frac{-7.5+12.5}{2}=2.5\n$$\n\nTherefore, the mean return on the investment is $2.5%.$"}] [{:db/id #edb/ref 17592186525056 :knowledge-point/_questions [{:db/id #edb/ref 17592186157375 :knowledge-point/id #uuid "14a5ffb6-c652-5626-b6c2-bcd5004b6297" :knowledge-point/title "Calculating a Probability in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1250b344-6a3f-5e22-8259-6b6f4e1fd664" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{7}" :db/id #edb/ref 17592186524415} {:answer/id #uuid "3b42918c-1af0-5846-b7eb-f58a3c71f7d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{7}" :db/id #edb/ref 17592186524490} {:answer/id #uuid "b0fdf54d-8e0d-564f-bace-2883c73dc5d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{7}" :db/id #edb/ref 17592186524667} {:answer/id #uuid "d1883d56-92de-539c-8f2f-861ea03c9e84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186524729} {:answer/id #uuid "f040bfd2-f972-53d7-af55-e0a4c410abc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{4}" :db/id #edb/ref 17592186524804}] :answer-field/correct {:answer/id #uuid "1250b344-6a3f-5e22-8259-6b6f4e1fd664" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{7}" :db/id #edb/ref 17592186524415} :answer-field/id #uuid "cca69172-8d2b-50ee-94f0-4248d1848b28" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524927}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e55c9ea3-689a-5b3d-8e62-79deec4589d4" :question/math-academy-id "q-96738" :question/problem "The duration of a tv program is uniformly distributed between $52$ and $66$ minutes, inclusive. What is the probability that a randomly chosen program lasts $60$ minutes or less?" :question/worked-solution "Let $X$ represent the duration of the tv program. From the problem statement, we know that $X∼U[52,66],$ and we wish to compute $P(X\\le 60).$\n\nIn general, if $X∼U[a,b],$ then $X$ has the following probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{b-a}, & a\\le x\\le b \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nSo, for our random variable $X∼U[52,66],$ we have the following probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{14}, & 52\\le x\\le 66 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X\\le 60) & ={\\int }_{52}^{60}f(x)\\,\\text{d}x \\\\  & ={\\int }_{52}^{60}\\frac{1}{14}\\,\\text{d}x \\\\  & ={\\frac{x}{14}|}_{52}^{60} \\\\  & =\\frac{60}{14}-\\frac{52}{14} \\\\  & =\\frac{4}{7}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186524959 :knowledge-point/_questions [{:db/id #edb/ref 17592186157375 :knowledge-point/id #uuid "14a5ffb6-c652-5626-b6c2-bcd5004b6297" :knowledge-point/title "Calculating a Probability in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bda0597-d4eb-501c-8f78-9cc0d69850ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{13}" :db/id #edb/ref 17592186524460} {:answer/id #uuid "53da8f36-10c8-5cc6-86e4-472caa08a221" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186524526} {:answer/id #uuid "5609f0e7-a55f-54bb-b60f-a7f0957c755b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186524531} {:answer/id #uuid "9816d79b-cb35-5e33-8ecc-f8d36301c91e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{12}" :db/id #edb/ref 17592186524624} {:answer/id #uuid "dfba38fe-2d5e-512c-9841-9b766813abf6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{10}" :db/id #edb/ref 17592186524767}] :answer-field/correct {:answer/id #uuid "53da8f36-10c8-5cc6-86e4-472caa08a221" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186524526} :answer-field/id #uuid "56c85a06-4467-5818-826d-ae5c1ae05ad9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524875}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "04a40517-0aa4-5398-b54b-804112b670f0" :question/math-academy-id "q-96739" :question/problem "The distance covered per game by a particular soccer player is uniformly distributed between $10\\,\\text{km}$\n and $13\\,\\text{km}$ inclusive. What is the probability that this player runs $12\\,\\text{km}$ or more in a randomly selected game?" :question/worked-solution "Let $X$ represent the distance covered by the player. From the problem statement, we know that $X∼U[10,13],$ and we wish to compute $P(X\\ge 12).$\n\nIn general, if $X∼U[a,b],$ then $X$ has the following probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{b-a}, & a\\le x\\le b \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nSo, for our random variable $X∼U[10,13],$ we have the following probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{3}, & 10\\le x\\le 13 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X\\ge 12) & ={\\int }_{12}^{13}f(x)\\,\\text{d}x \\\\  & ={\\int }_{12}^{13}\\frac{1}{3}\\,\\text{d}x \\\\  & ={\\frac{x}{3}|}_{12}^{13} \\\\  & =\\frac{13}{3}-\\frac{12}{3} \\\\  & =\\frac{1}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186525052 :knowledge-point/_questions [{:db/id #edb/ref 17592186157375 :knowledge-point/id #uuid "14a5ffb6-c652-5626-b6c2-bcd5004b6297" :knowledge-point/title "Calculating a Probability in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00062ecf-0f51-5e19-9310-d192161a5246" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{7}" :db/id #edb/ref 17592186524377} {:answer/id #uuid "552517bf-8975-5614-bc42-fbfb2782e608" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{7}" :db/id #edb/ref 17592186524528} {:answer/id #uuid "be80291f-0de3-5c39-a291-04b336487ab4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186524686} {:answer/id #uuid "d80e92db-3cf5-5e65-b11c-1182c3250e87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186524744} {:answer/id #uuid "f6767626-734c-5b0e-a601-dd3d629fe5ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186524818}] :answer-field/correct {:answer/id #uuid "d80e92db-3cf5-5e65-b11c-1182c3250e87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186524744} :answer-field/id #uuid "e761c330-86b4-51d2-b2a4-8c7d84a3cd9a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524941}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e042f50a-1181-570f-8ece-0feac63fb8cc" :question/math-academy-id "q-96859" :question/problem "A computer program is designed so that it can randomly generate a real number between $0$ and $10,$ inclusive. What is the probability that the number generated is between $3$ and $7?$" :question/worked-solution "Let $X$ represent the number generated by the program. From the problem statement, we know that $X∼U[0,10],$ and we wish to compute $P(3<X<7).$\n\nIn general, if $X∼U[a,b],$ then $X$ has the following probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{b-a}, & a\\le x\\le b \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nSo, for our random variable $X∼U[0,10],$ we have the following probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{10}, & 0\\le x\\le 10 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(3<X<7) & ={\\int }_{3}^{7}f(x)\\,\\text{d}x \\\\  & ={\\int }_{3}^{7}\\frac{1}{10}\\,\\text{d}x \\\\  & ={\\frac{x}{10}|}_{3}^{7} \\\\  & =\\frac{7}{10}-\\frac{3}{10} \\\\  & =\\frac{2}{5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186525018 :knowledge-point/_questions [{:db/id #edb/ref 17592186157375 :knowledge-point/id #uuid "14a5ffb6-c652-5626-b6c2-bcd5004b6297" :knowledge-point/title "Calculating a Probability in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51db8527-e691-524a-8d64-0cecd1ce2030" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{20}" :db/id #edb/ref 17592186524523} {:answer/id #uuid "7442854e-4eef-58d2-937e-b8a32847ad0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{14}" :db/id #edb/ref 17592186524569} {:answer/id #uuid "7664a506-7a27-5659-88f7-2a7981b1344c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{20}" :db/id #edb/ref 17592186524571} {:answer/id #uuid "891c8039-b5b1-5884-8dca-6e836ef55867" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{140}" :db/id #edb/ref 17592186524598} {:answer/id #uuid "d6c5dd60-da56-5120-ac2a-e485b14f6897" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{14}" :db/id #edb/ref 17592186524741}] :answer-field/correct {:answer/id #uuid "d6c5dd60-da56-5120-ac2a-e485b14f6897" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{14}" :db/id #edb/ref 17592186524741} :answer-field/id #uuid "91eb2137-924b-5cda-97be-891267d62252" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524905}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9d9e7f8d-7ad5-5408-a4ca-eaab80943f96" :question/math-academy-id "q-96870" :question/problem "The minimum time it takes an electrician to fix a power outage is $20$ minutes, and the maximum time is $160$ minutes. Assuming that the time it takes to fix the power outage is uniformly distributed, what is the probability that a random power outage fix takes more than $30$ minutes but less than $60$ minutes?" :question/worked-solution "Let $X$ represent the time it takes to fix a random power outage. From the problem statement, we know that $X∼U[20,160],$ and we wish to compute $P(30<X<60).$\n\nIn general, if $X∼U[a,b],$ then $X$ has the following probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{b-a}, & a\\le x\\le b \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nSo, for our random variable $X∼U[20,160],$ we have the following probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{140}, & 20\\le x\\le 160 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(30<X<60) & ={\\int }_{30}^{60}f(x)\\,\\text{d}x \\\\  & ={\\int }_{30}^{60}\\frac{1}{140}\\,\\text{d}x \\\\  & ={\\frac{x}{140}|}_{30}^{60} \\\\  & =\\frac{60}{140}-\\frac{30}{140} \\\\  & =\\frac{3}{14}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186524969 :knowledge-point/_questions [{:db/id #edb/ref 17592186157376 :knowledge-point/id #uuid "38f8d9f6-9ef8-5cc1-b2d8-38936c08468a" :knowledge-point/title "Calculating an Expected Value in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6eb9fe59-d227-5978-bc0e-8c3248818cd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30\\,\\text{hrs}" :db/id #edb/ref 17592186524562} {:answer/id #uuid "6fc67d2e-104d-517e-b7ad-3963058d50e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "35\\,\\text{hrs}" :db/id #edb/ref 17592186524563} {:answer/id #uuid "da20904d-6f33-5883-b6a2-506ba44d56ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50\\,\\text{hrs}" :db/id #edb/ref 17592186524746} {:answer/id #uuid "db3e02b0-3400-5f28-9333-791ec7386ccd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25\\,\\text{hrs}" :db/id #edb/ref 17592186524750} {:answer/id #uuid "fdcf88ff-a820-57d4-93f4-c6c1bb73cdc7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20\\,\\text{hrs}" :db/id #edb/ref 17592186524837}] :answer-field/correct {:answer/id #uuid "db3e02b0-3400-5f28-9333-791ec7386ccd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25\\,\\text{hrs}" :db/id #edb/ref 17592186524750} :answer-field/id #uuid "0bdc12ec-cffe-5433-a8cf-eda9a9bc5849" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524845}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1e4d63bb-964b-5518-80b3-c4adef9c4173" :question/math-academy-id "q-96909" :question/problem "The battery duration from a full to an empty charge of a specific smartphone model is uniformly distributed between $20$ and $30$ hours, inclusive.  What is the expected duration of the smartphone battery?" :question/worked-solution "Let $X$ represent the duration of a randomly chosen battery. From the problem statement, we know that $X∼U[20,30],$ and we wish to compute $\\text{E}[X].$\n\nIn general, if $X∼U[a,b],$ then $X$ has the following expected value:\n\n$$\n\\text{E}[X]=\\frac{a+b}{2}\n$$\n\nSo, for our random variable $X∼U[20,30],$ we have the following expected value:\n\n$$\n\\text{E}[X]=\\frac{20+30}{2}=25\n$$\n\nTherefore, the mean battery duration is $25\\,\\text{hrs}.$"}] [{:db/id #edb/ref 17592186524968 :knowledge-point/_questions [{:db/id #edb/ref 17592186157376 :knowledge-point/id #uuid "38f8d9f6-9ef8-5cc1-b2d8-38936c08468a" :knowledge-point/title "Calculating an Expected Value in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "370a6f48-1321-598d-961d-21215c99efae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.2\\,\\text{km}" :db/id #edb/ref 17592186524484} {:answer/id #uuid "3aa9e751-2678-518f-a02f-61128090d944" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.5\\,\\text{km}" :db/id #edb/ref 17592186524487} {:answer/id #uuid "b655adb4-de78-540c-b946-67bc2027201e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\,\\text{km}" :db/id #edb/ref 17592186524673} {:answer/id #uuid "c09a2f15-28c9-5ffe-af6b-aec2c59a2452" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.5\\,\\text{km}" :db/id #edb/ref 17592186524688} {:answer/id #uuid "ed0fd3e2-7218-5a55-b3ea-6212dfbbcea4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.4\\,\\text{km}" :db/id #edb/ref 17592186524799}] :answer-field/correct {:answer/id #uuid "c09a2f15-28c9-5ffe-af6b-aec2c59a2452" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.5\\,\\text{km}" :db/id #edb/ref 17592186524688} :answer-field/id #uuid "c93f235b-793b-55f7-ab41-4624f17dc702" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524925}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1aba9da0-33cd-5e33-a9f2-c4176a10b635" :question/math-academy-id "q-96912" :question/problem "The distance covered by a basketball player in an official match is uniformly distributed between $3$ and $4$ km, inclusive. What is the mean distance covered per match?" :question/worked-solution "Let $X$ represent the distance covered by a randomly chosen basketball player. From the problem statement, we know that $X∼U[3,4],$ and we wish to compute $\\text{E}[X].$\n\nIn general, if $X∼U[a,b],$ then $X$ has the following expected value:\n\n$$\n\\text{E}[X]=\\frac{a+b}{2}\n$$\n\nSo, for our random variable $X∼U[3,4],$ we have the following expected value:\n\n$$\n\\text{E}[X]=\\frac{3+4}{2}=3.5\n$$\n\nTherefore, the mean distance covered is $3.5\\,\\text{km}.$"}] [{:db/id #edb/ref 17592186525049 :knowledge-point/_questions [{:db/id #edb/ref 17592186157376 :knowledge-point/id #uuid "38f8d9f6-9ef8-5cc1-b2d8-38936c08468a" :knowledge-point/title "Calculating an Expected Value in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e690e66-2b08-578a-8669-8a4559b8135b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "155.5\\,\\text{m}" :db/id #edb/ref 17592186524466} {:answer/id #uuid "540a4c2f-1c8b-54a6-871e-f1146cfd3188" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "195\\,\\text{m}" :db/id #edb/ref 17592186524527} {:answer/id #uuid "5881b8aa-fa36-5d7c-81f9-47ae6f95c700" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "120.5\\,\\text{m}" :db/id #edb/ref 17592186524534} {:answer/id #uuid "654974a1-1f54-5eaa-88ed-8f82bc70ce92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "315\\,\\text{m}" :db/id #edb/ref 17592186524547} {:answer/id #uuid "ff61f4a5-fdc7-50ac-8e2e-f37f8b83242a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "157.5\\,\\text{m}" :db/id #edb/ref 17592186524840}] :answer-field/correct {:answer/id #uuid "ff61f4a5-fdc7-50ac-8e2e-f37f8b83242a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "157.5\\,\\text{m}" :db/id #edb/ref 17592186524840} :answer-field/id #uuid "b332393b-467d-57f6-86e8-201567c24b59" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524918}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dde847bc-5ddb-54de-88c5-81b18b2aa0d0" :question/math-academy-id "q-96915" :question/problem "The height of water in a dam is uniformly distributed between $120$ and $195$ meters, inclusive. What is the mean height of the water?" :question/worked-solution "Let $X$ represent the height of water in a random inspection of the dam. From the problem statement, we know that $X∼U[120,195],$ and we wish to compute $\\text{E}[X].$\n\nIn general, if $X∼U[a,b],$ then $X$ has the following expected value:\n\n$$\n\\text{E}[X]=\\frac{a+b}{2}\n$$\n\nSo, for our random variable $X∼U[120,195],$ we have the following expected value:\n\n$$\n\\text{E}[X]=\\frac{120+195}{2}=157.5\n$$\n\nTherefore, the mean height of water in the dam is $157.5\\,\\text{m}.$"}] [{:db/id #edb/ref 17592186524977 :knowledge-point/_questions [{:db/id #edb/ref 17592186157376 :knowledge-point/id #uuid "38f8d9f6-9ef8-5cc1-b2d8-38936c08468a" :knowledge-point/title "Calculating an Expected Value in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04369663-ee6d-5779-b279-d5950bae1b5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "110\\,\\text{min}" :db/id #edb/ref 17592186524383} {:answer/id #uuid "8d155fe7-b1b6-53a9-84dc-0848f037b735" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "140\\,\\text{min}" :db/id #edb/ref 17592186524604} {:answer/id #uuid "91b4c9f3-7029-518f-ba7e-e5cb07c0455c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30\\,\\text{min}" :db/id #edb/ref 17592186524611} {:answer/id #uuid "c007a719-a2a8-5a6d-a919-b4ccf57175e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "70\\,\\text{min}" :db/id #edb/ref 17592186524687} {:answer/id #uuid "df6a5038-8e94-596d-8743-3127d9d275c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "37\\,\\text{min}" :db/id #edb/ref 17592186524765}] :answer-field/correct {:answer/id #uuid "c007a719-a2a8-5a6d-a919-b4ccf57175e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "70\\,\\text{min}" :db/id #edb/ref 17592186524687} :answer-field/id #uuid "f297313b-3683-5d45-a02e-e17a9c10bf9b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524947}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "34de765e-8b52-5fc4-a07d-973bddb6d3ad" :question/math-academy-id "q-96922" :question/problem "The minimum time it takes a plumber to fix a leaky pipe is $30$ minutes, and the maximum time is $110$ minutes.  Assuming that the plumber's time to fix a leaky pipe is uniformly distributed, what is the expected time to fix a pipe?" :question/worked-solution "Let $X$ represent the time to fix a randomly chosen leaky pipe. From the problem statement, we know that $X∼U[30,110],$ and we wish to compute $\\text{E}[X].$\n\nIn general, if $X∼U[a,b],$ then $X$ has the following expected value:\n\n$$\n\\text{E}[X]=\\frac{a+b}{2}\n$$\n\nSo, for our random variable $X∼U[30,110],$ we have the following expected value:\n\n$$\n\\text{E}[X]=\\frac{30+110}{2}=70\n$$\n\nTherefore, the mean time to fix the leaky pipe is $70\\,\\text{min}.$"}] [{:db/id #edb/ref 17592186158009 :knowledge-point/_questions [{:db/id #edb/ref 17592186157377 :knowledge-point/id #uuid "610bddb6-0731-53d1-9fcf-ab202d4cf151" :knowledge-point/title "Calculating a Variance in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05252ab4-17c7-54ff-8a99-a05918ce2b8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\,{\\text{hr}}^{2}" :db/id #edb/ref 17592186524388} {:answer/id #uuid "1971a4b2-550b-5394-b1b5-b2ce91a4486d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}\\,{\\text{hr}}^{2}" :db/id #edb/ref 17592186524429} {:answer/id #uuid "5198a366-384f-526c-a099-9dad65d5986e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{4}\\,{\\text{hr}}^{2}" :db/id #edb/ref 17592186524521} {:answer/id #uuid "9992cae0-ada8-57b8-84ad-c508b7212276" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{13}\\,{\\text{hr}}^{2}" :db/id #edb/ref 17592186524628} {:answer/id #uuid "dd9f857e-b1eb-5a2b-a336-0e4b6cc339b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}\\,{\\text{hr}}^{2}" :db/id #edb/ref 17592186524759}] :answer-field/correct {:answer/id #uuid "1971a4b2-550b-5394-b1b5-b2ce91a4486d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}\\,{\\text{hr}}^{2}" :db/id #edb/ref 17592186524429} :answer-field/id #uuid "5dcb98ae-1119-51fd-82e9-711264df4277" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186156975}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b16fcf14-b902-58e8-beb4-6f1dfce4ba1b" :question/math-academy-id "q-96923" :question/problem "The time it takes a mechanic to repair a car is uniformly distributed with a minimum of $2$ hours and a maximum of $6$ hours. What is the variance of the time it takes to repair a car?" :question/requires-calculator true :question/worked-solution "Let $X$ represent the time it takes to repair a car. From the problem statement, we know that $X∼U[2,6],$ and we wish to compute $\\text{Var}[X].$\n\nIn general, if $X∼U[a,b],$ then $X$ has the following variance:\n\n$$\n\\text{Var}[X]=\\frac{(b-a)^{2}}{12}\n$$\n\nSo, for our random variable $X∼U[2,6],$ we have the following variance:\n\n$$\n\\text{Var}[X]=\\frac{(6-2)^{2}}{12}=\\frac{16}{12}=\\frac{4}{3}\n$$\n\nTherefore, the variance of the time it takes to repair a car is $\\frac{4}{3}\\,{\\text{hr}}^{2}$"}] [{:db/id #edb/ref 17592186525029 :knowledge-point/_questions [{:db/id #edb/ref 17592186157377 :knowledge-point/id #uuid "610bddb6-0731-53d1-9fcf-ab202d4cf151" :knowledge-point/title "Calculating a Variance in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37c899a0-311c-5b6b-9ff3-e7d42dfa323d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,{\\text{hr}}^{2}" :db/id #edb/ref 17592186524485} {:answer/id #uuid "3ec20181-951b-5f69-b8f4-a198ce2328f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6.5\\,{\\text{hr}}^{2}" :db/id #edb/ref 17592186524500} {:answer/id #uuid "e058e338-722a-56b0-801a-88babf877d02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.6\\,{\\text{hr}}^{2}" :db/id #edb/ref 17592186524770} {:answer/id #uuid "e9766f35-9561-5089-93e8-b3efe0163bc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.5\\,{\\text{hr}}^{2}" :db/id #edb/ref 17592186524792} {:answer/id #uuid "f372aa5a-6bd3-5dfe-a21b-5891bbe6d4d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,{\\text{hr}}^{2}" :db/id #edb/ref 17592186524811}] :answer-field/correct {:answer/id #uuid "37c899a0-311c-5b6b-9ff3-e7d42dfa323d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,{\\text{hr}}^{2}" :db/id #edb/ref 17592186524485} :answer-field/id #uuid "a4dcef72-956c-59fb-8c70-71f6c1dcf441" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524912}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b676f753-31e2-5fb5-a7e2-ab7b8253e6c3" :question/math-academy-id "q-96950" :question/problem "A librarian has noticed that the minimum visiting time of a visitor is $0.5$ hours, whereas the maximum time is $6.5$ hours. If the visiting time is uniformly distributed, what is its variance?" :question/worked-solution "Let $X$ represent the visiting time of a randomly chosen visitor. From the problem statement, we know that $X∼U[0.5,6.5],$ and we wish to compute $\\text{Var}[X].$\n\nIn general, if $X∼U[a,b],$ then $X$ has the following variance:\n\n$$\n\\text{Var}[X]=\\frac{(b-a)^{2}}{12}\n$$\n\nSo, for our random variable $X∼U[0.5,6.5],$ we have the following variance:\n\n$$\n\\text{Var}[X]=\\frac{(6.5-0.5)^{2}}{12}=\\frac{36}{12}=3\n$$\n\nTherefore, the variance  is $3\\,{\\text{hr}}^{2}.$"}] [{:db/id #edb/ref 17592186525066 :knowledge-point/_questions [{:db/id #edb/ref 17592186157377 :knowledge-point/id #uuid "610bddb6-0731-53d1-9fcf-ab202d4cf151" :knowledge-point/title "Calculating a Variance in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06fa8f9c-5850-57e0-979a-29fbc9973afa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{13}" :db/id #edb/ref 17592186524393} {:answer/id #uuid "600f499f-c1d3-5ae0-b4a1-160b380ead3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{25}" :db/id #edb/ref 17592186524540} {:answer/id #uuid "60225bce-dd95-55d2-bd3a-e4a05b09a0ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{64}{3}" :db/id #edb/ref 17592186524541} {:answer/id #uuid "7f654726-55d0-5fca-9cdd-7a52ab9a67b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186524583} {:answer/id #uuid "c3be71c0-f54f-59b2-826c-729857d8c48e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{16}{3}" :db/id #edb/ref 17592186524696}] :answer-field/correct {:answer/id #uuid "c3be71c0-f54f-59b2-826c-729857d8c48e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{16}{3}" :db/id #edb/ref 17592186524696} :answer-field/id #uuid "101a0955-c20d-5d60-8f35-d4ac4d90df10" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524846}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fefe1132-ca93-5e93-921e-5c1fd45e5581" :question/math-academy-id "q-96953" :question/problem "A video game randomly generates an obstacle the player has to avoid. The obstacle's $x$-coordinate is uniformly distributed along a segment whose endpoints have $x$-coordinates of $16$ and $24.$ What is the variance of the $x$-coordinate of the obstacle?" :question/worked-solution "Let $X$ represent the randomly generated $x$-coordinate of the obstacle. From the problem statement, we know that $X∼U[16,24],$ and we wish to compute $\\text{Var}[X].$\n\nIn general, if $X∼U[a,b],$ then $X$ has the following variance:\n\n$$\n\\text{Var}[X]=\\frac{(b-a)^{2}}{12}\n$$\n\nSo, for our random variable $X∼U[16,24],$ we have the following variance:\n\n$$\n\\text{Var}[X]=\\frac{(24-16)^{2}}{12}=\\frac{64}{12}=\\frac{16}{3}\n$$\n\nTherefore, the variance of the $x$-coordinate is $\\frac{16}{3}.$"}] [{:db/id #edb/ref 17592186525004 :knowledge-point/_questions [{:db/id #edb/ref 17592186157377 :knowledge-point/id #uuid "610bddb6-0731-53d1-9fcf-ab202d4cf151" :knowledge-point/title "Calculating a Variance in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50116483-a706-5dd6-a017-943ddc486998" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}\\,{\\text{km}}^{2}" :db/id #edb/ref 17592186524518} {:answer/id #uuid "7f0cd53c-7363-5ab5-92fc-590bf229d977" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{4}\\,{\\text{km}}^{2}" :db/id #edb/ref 17592186524581} {:answer/id #uuid "c6ceb90f-a5c7-55b2-90f2-a1d30c0c01a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}\\,{\\text{km}}^{2}" :db/id #edb/ref 17592186524701} {:answer/id #uuid "daa1ca2a-c1b0-5926-8a0e-e922c3c89348" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}\\,{\\text{km}}^{2}" :db/id #edb/ref 17592186524747} {:answer/id #uuid "e063d08e-9e0a-5ed0-ab66-0020ccdffa4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}\\,{\\text{km}}^{2}" :db/id #edb/ref 17592186524771}] :answer-field/correct {:answer/id #uuid "e063d08e-9e0a-5ed0-ab66-0020ccdffa4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}\\,{\\text{km}}^{2}" :db/id #edb/ref 17592186524771} :answer-field/id #uuid "9740dd9c-a42e-5b17-8af5-62f3038a4eb7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524907}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "881664f0-8e9c-5727-bbea-b101cf17a4b3" :question/math-academy-id "q-96956" :question/problem "The distance covered per game by a football player in an official match is uniformly distributed between $9$ km and $12$ km, inclusive. What is the variance in the distance covered by this player?" :question/worked-solution "Let $X$ represent the distance covered by the player. From the problem statement, we know that $X∼U[9,12],$ and we wish to compute $\\text{Var}[X].$\n\nIn general, if $X∼U[a,b],$ then $X$ has the following variance:\n\n$$\n\\text{Var}[X]=\\frac{(b-a)^{2}}{12}\n$$\n\nSo, for our random variable $X∼U[9,12],$ we have the following variance:\n\n$$\n\\text{Var}[X]=\\frac{(12-9)^{2}}{12}=\\frac{9}{12}=\\frac{3}{4}\n$$\n\nTherefore, the variance of the distance covered by the football player is $\\frac{3}{4}\\,{\\text{km}}^{2}.$"}] [{:db/id #edb/ref 17592186525027 :knowledge-point/_questions [{:db/id #edb/ref 17592186157377 :knowledge-point/id #uuid "610bddb6-0731-53d1-9fcf-ab202d4cf151" :knowledge-point/title "Calculating a Variance in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b4b9d86-b8c2-53ab-aeb4-85c153141813" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24\\,{\\text{min}}^{2}" :db/id #edb/ref 17592186524401} {:answer/id #uuid "8879f320-bcc2-587d-aaca-28c7f3bdd676" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "26\\,{\\text{min}}^{2}" :db/id #edb/ref 17592186524595} {:answer/id #uuid "93677d4d-73a3-5753-b99e-accf2ba9f954" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36\\,{\\text{min}}^{2}" :db/id #edb/ref 17592186524616} {:answer/id #uuid "a26a89f6-b7c9-5842-8fd9-8cb26c1f5869" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\,{\\text{min}}^{2}" :db/id #edb/ref 17592186524640} {:answer/id #uuid "c84d385d-e171-5620-9eeb-5a8f85a098a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14\\,{\\text{min}}^{2}" :db/id #edb/ref 17592186524707}] :answer-field/correct {:answer/id #uuid "a26a89f6-b7c9-5842-8fd9-8cb26c1f5869" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\,{\\text{min}}^{2}" :db/id #edb/ref 17592186524640} :answer-field/id #uuid "fa393c5b-69a5-51b3-a77d-1f39127b18dc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524949}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ad59302d-b27c-5dd6-8065-5abc6de41bf0" :question/math-academy-id "q-96961" :question/problem "The duration of a tv program is uniformly distributed between $24$ and $36$ minutes, inclusive. What is the variance of the TV program duration?" :question/worked-solution "Let $X$ represent the duration of a tv program. From the problem statement, we know that $X∼U[24,36],$ and we wish to compute $\\text{Var}[X].$\n\nIn general, if $X∼U[a,b],$ then $X$ has the following variance:\n\n$$\n\\text{Var}[X]=\\frac{(b-a)^{2}}{12}\n$$\n\nSo, for our random variable $X∼U[24,36],$ we have the following variance:\n\n$$\n\\text{Var}[X]=\\frac{(36-24)^{2}}{12}=\\frac{144}{12}=12\n$$\n\nTherefore, the variance of the TV program duration is $12\\,{\\text{min}}^{2}.$"}]}
