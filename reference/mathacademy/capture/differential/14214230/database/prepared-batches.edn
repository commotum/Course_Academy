id "1e4d63bb-964b-5518-80b3-c4adef9c4173"] ["question-1e4d63bb-964b-5518-80b3-c4adef9c4173" :question/math-academy-id "q-96909"] ["question-1e4d63bb-964b-5518-80b3-c4adef9c4173" :question/problem "The battery duration from a full to an empty charge of a specific smartphone model is uniformly distributed between $20$ and $30$ hours, inclusive.  What is the expected duration of the smartphone battery?"] ["question-1e4d63bb-964b-5518-80b3-c4adef9c4173" :question/worked-solution "Let $X$ represent the duration of a randomly chosen battery. From the problem statement, we know that $X∼U[20,30],$ and we wish to compute $\\text{E}[X].$\n\nIn general, if $X∼U[a,b],$ then $X$ has the following expected value:\n\n$$\n\\text{E}[X]=\\frac{a+b}{2}\n$$\n\nSo, for our random variable $X∼U[20,30],$ we have the following expected value:\n\n$$\n\\text{E}[X]=\\frac{20+30}{2}=25\n$$\n\nTherefore, the mean battery duration is $25\\,\\text{hrs}.$"] ["question-1e4d63bb-964b-5518-80b3-c4adef9c4173" :question/difficulty :question.difficulty/easy] ["answer-field-0bdc12ec-cffe-5433-a8cf-eda9a9bc5849" :answer-field/id #uuid "0bdc12ec-cffe-5433-a8cf-eda9a9bc5849"] ["answer-fdcf88ff-a820-57d4-93f4-c6c1bb73cdc7" :answer/id #uuid "fdcf88ff-a820-57d4-93f4-c6c1bb73cdc7"] ["answer-fdcf88ff-a820-57d4-93f4-c6c1bb73cdc7" :answer/type :answer.type/math] ["answer-fdcf88ff-a820-57d4-93f4-c6c1bb73cdc7" :answer/value "20\\,\\text{hrs}"] ["answer-db3e02b0-3400-5f28-9333-791ec7386ccd" :answer/id #uuid "db3e02b0-3400-5f28-9333-791ec7386ccd"] ["answer-db3e02b0-3400-5f28-9333-791ec7386ccd" :answer/type :answer.type/math] ["answer-db3e02b0-3400-5f28-9333-791ec7386ccd" :answer/value "25\\,\\text{hrs}"] ["answer-6eb9fe59-d227-5978-bc0e-8c3248818cd3" :answer/id #uuid "6eb9fe59-d227-5978-bc0e-8c3248818cd3"] ["answer-6eb9fe59-d227-5978-bc0e-8c3248818cd3" :answer/type :answer.type/math] ["answer-6eb9fe59-d227-5978-bc0e-8c3248818cd3" :answer/value "30\\,\\text{hrs}"] ["answer-6fc67d2e-104d-517e-b7ad-3963058d50e7" :answer/