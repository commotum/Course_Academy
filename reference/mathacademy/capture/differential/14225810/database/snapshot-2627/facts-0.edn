92186045417] [17592186198367 #edb/ref 1041 #edb/ref 17592186198241 #edb/ref 17592186045417] [17592186198367 #edb/ref 1042 #uuid "849449fb-bb08-54a3-b8ea-9f33ddd7a3e5" #edb/ref 17592186045417] [17592186198405 #edb/ref 1037 #edb/ref 17592186049390 #edb/ref 17592186045417] [17592186198405 #edb/ref 1038 #edb/ref 17592186198946 #edb/ref 17592186045417] [17592186198405 #edb/ref 1038 #edb/ref 17592186199016 #edb/ref 17592186045417] [17592186198405 #edb/ref 1038 #edb/ref 17592186281548 #edb/ref 17592186045417] [17592186198405 #edb/ref 1038 #edb/ref 17592186281551 #edb/ref 17592186045417] [17592186198405 #edb/ref 1038 #edb/ref 17592186281552 #edb/ref 17592186045417] [17592186198405 #edb/ref 1038 #edb/ref 17592186362346 #edb/ref 17592186045417] [17592186198405 #edb/ref 1038 #edb/ref 17592186362354 #edb/ref 17592186045417] [17592186198405 #edb/ref 1038 #edb/ref 17592186363472 #edb/ref 17592186045417] [17592186198405 #edb/ref 1038 #edb/ref 17592186446811 #edb/ref 17592186045417] [17592186198405 #edb/ref 1038 #edb/ref 17592186446813 #edb/ref 17592186045417] [17592186198405 #edb/ref 1038 #edb/ref 17592186446817 #edb/ref 17592186045417] [17592186198405 #edb/ref 1038 #edb/ref 17592186496295 #edb/ref 17592186045417] [17592186198405 #edb/ref 1039 "Finding Extreme Values: Cases With No Inner Critical Points" #edb/ref 17592186045417] [17592186198405 #edb/ref 1041 #edb/ref 17592186198047 #edb/ref 17592186045417] [17592186198405 #edb/ref 1042 #uuid "9bbc1e6a-c728-5c5a-84f8-06a92c30a023" #edb/ref 17592186045417] [17592186198494 #edb/ref 1043 #edb/ref 17592186199263 #edb/ref 17592186045417] [17592186198494 #edb/ref 1043 #edb/ref 17592186199264 #edb/ref 17592186045417] [17592186198494 #edb/ref 1043 #edb/ref 17592186199326 #edb/ref 17592186045417] [17592186198494 #edb/ref 1043 #edb/ref 17592186199327 #edb/ref 17592186045417] [17592186198494 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186198494 #edb/ref 1045 "Optimizing Multivariable Functions Using Lagrange Multipliers" #edb/ref 17592186045417] [17592186198494 #edb/ref 1046 #edb/ref 17592186199326 #edb/ref 17592186045417] [17592186198494 #edb/ref 1049 #edb/ref 17592186050688 #edb/ref 17592186045417] [17592186198494 #edb/ref 1050 960.0 #edb/ref 17592186045417] [17592186198494 #edb/ref 1053 #uuid "e65e5013-8e69-5be7-a53f-8247c1f26c90" #edb/ref 17592186045417] [17592186199017 #edb/ref 1068 #edb/ref 17592186197972 #edb/ref 17592186045417] [17592186199017 #edb/ref 1069 "q-98103" #edb/ref 17592186045417] [17592186199017 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186199017 #edb/ref 1071 "Use the method of Lagrange multipliers to find the maximum value of the function $f(x,y)={x}^{2}+{y}^{2}-4x-4y$ given that ${x}^{2}+{y}^{2}\\le 18.$" #edb/ref 17592186045417] [17592186199017 #edb/ref 1072 #uuid "ab0253d0-1db9-532d-bb4a-604c88a16da0" #edb/ref 17592186045417] [17592186199017 #edb/ref 1074 "First, we need to find the critical values of the function in the region's interior. We compute the critical points by solving $∇f=0,$ as follows:\n\n$$\n\\begin{aligned}⟨{f}_{x}(x,y),{f}_{y}(x,y)⟩ & =⟨0,0⟩ \\\\ ⟨2x-4,2y-4⟩ & =⟨0,0⟩\\end{aligned}\n$$\n\nThe above equation has the solution $(x,y)=(2,2).$ This point belongs to our region.\n\nNext, we need to find the maximum value of $f(x,y)$ subject to the constraint $g(x,y)={x}^{2}+{y}^{2}=18.$ \n\nSince $f(x,y)$ is continuous and the constraint is closed and bounded, $f(x,y)$ reaches a global maximum and a global minimum on the constraint. \n\nTherefore, by the method of Lagrange multipliers, we must solve the following system:\n\n$$\n∇f(x,y)=\\lambda ∇g(x,y),\\,g(x,y)=18\n$$\n\nWe start by solving the first equation:\n\n$$\n\\begin{aligned}∇f(x,y) & =\\lambda ∇g(x,y,) \\\\ ⟨{f}_{x}(x,y),{f}_{y}(x,y)⟩ & =\\lambda ⟨{g}_{x}(x,y),{g}_{y}(x,y)⟩ \\\\ ⟨2x-4,2y-4⟩ & =\\lambda ⟨2x,2y⟩\\end{aligned}\n$$\n\nNotice that we cannot have $\\lambda =1$ since this leads to a contradiction in the above equation. Therefore, assuming $\\lambda \\ne 1,$ we have the following:\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}2x-4 &=2\\lambda x \\\\ 2y-4 &=2\\lambda y\\end{aligned}\\right.\\,⇒\\,\\left\\{\\begin{aligned}x &=\\frac{2}{1-\\lambda } \\\\ y &=\\frac{2}{1-\\lambda }\\end{aligned}\\right.\\,⇒\\,x=y\\end{aligned}\n$$\n\nSubstituting $y=x$ in the condition $g(x,y)=18,$ we get\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & =18 \\\\ {x}^{2}+{x}^{2} & =18 \\\\ 2{x}^{2} & =18 \\\\ {x}^{2} & =9 \\\\ x & =\\pm 3.\\end{aligned}\n$$\n\nTherefore, $f$ has possible extreme values at the points\n\n$$\n(3,3),\\,(-3,-3),\\,(2,2).\n$$\n\nWe evaluate $f$ at each of these points. These are given in the following table:\n\n| $(x,y)$ | $(3,3)$ | $(-3,-3)$ | $(2,2)$ |\n| --- | --- | --- | --- |\n| $f(x,y)$ | $-6$ | $42$ | $-8$ |\n\nTherefore, the function reaches a maximum value at $(-3,-3),$ and its maximum value is $42.$" #edb/ref 17592186045443] [17592186199263 #edb/ref 1058 #edb/ref 17592186199264 #edb/ref 17592186045417] [17592186199263 #edb/ref 1061 32292 #edb/ref 17592186045417] [17592186199263 #edb/ref 1062 #uuid "c833d29b-43fd-5a3a-83ae-7c9928c184c2" #edb/ref 17592186045417] [17592186199263 #edb/ref 1063 #edb/ref 17592186198366 #edb/ref 17592186045417] [17592186199264 #edb/ref 1061 32293 #edb/ref 17592186045417] [17592186199264 #edb/ref 1062 #uuid "b82b3836-2ed6-522e-8a6b-e9301766e38d" #edb/ref 17592186045417] [17592186199264 #edb/ref 1063 #edb/ref 17592186198367 #edb/ref 17592186045417] [17592186199326 #edb/ref 1058 #edb/ref 17592186199327 #edb/ref 17592186045417] [17592186199326 #edb/ref 1061 44831 #edb/ref 17592186045417] [17592186199326 #edb/ref 1062 #uuid "7bbfb776-26d8-5be7-abb8-cae6bab3294c" #edb/ref 17592186045417] [17592186199326 #edb/ref 1063 #edb/ref 17592186199484 #edb/ref 17592186045417] [17592186199327 #edb/ref 1058 #edb/ref 17592186199263 #edb/ref 17592186045417] [17592186199327 #edb/ref 1061 44833 #edb/ref 17592186045417] [17592186199327 #edb/ref 1062 #uuid "0e5ab67d-1254-5853-868a-8e8a117b0032" #edb/ref 17592186045417] [17592186199327 #edb/ref 1063 #edb/ref 17592186198405 #edb/ref 17592186045417] [17592186199484 #edb/ref 1064 "Suppose we want to find the minimum and maximum values of the function\n\n$$\nf(x,y) = 2x^2+4y^2\n$$\n\nsubject to constraint $g(x,y) = x^2+y^2 \\leq 1.$ In other words, we wish to find the global extrema of $f(x,y)$ defined on the disc of radius $1$ centered at the origin, as shown below.\n\n![](images/5a/5ac34145b3911b19eb3775a915e8f0462c78502be6d6292e7682265c86eafce7.png)\n\n  \n\nTo find the extrema, we proceed as follows:\n\n- First, we find the critical points of $f$ inside the domain $x^2+y^2 < 1.$\n\n- Then, we find the extreme values of $f$ subject to the constraint $x^2+y^2=1$ using the method of Lagrange multipliers.\n\n- Finally, we determine the maximum and minimum values by evaluating $f$ at the candidate points.\n\nRecall that the critical points of a function $f(x,y)$ are the solutions to $\\boldsymbol f'(x,y) = \\mathbf 0^T.$ Now, since the derivative of $f$ is the transpose of its gradient $\\nabla f,$ the critical points are also given by the solutions to $\\nabla f = \\mathbf 0.$\n\nSo, we can find the critical points by solving $\\nabla f = \\mathbf 0,$ as follows:\n\n$$\n\\begin{aligned}⟨{f}_{x}(x,y),{f}_{y}(x,y)⟩ & =⟨0,0⟩ \\\\ ⟨4x,8y⟩ & =⟨0,0⟩\\end{aligned}\n$$\n\nThe above equation has the solution $(x,y)=(0,0).$ Note that this point belongs to our domain.\n\nNext, we need to find the maximum value of $f(x,y)$ subject to the constraint $g(x,y)= x^2 + y^2  = 1.$ Therefore, by the method of Lagrange multipliers, we must solve the following system:\n\n$$\n\\begin{aligned}∇f(x,y) & =\\lambda ∇g(x,y) \\\\ ⟨{f}_{x}(x,y),{f}_{y}(x,y)⟩ & =\\lambda ⟨{g}_{x}(x,y),{g}_{y}(x,y)⟩ \\\\ ⟨4x,8y⟩ & =\\lambda ⟨2x,2y⟩\\end{aligned}\n$$\n\nTherefore, we have the following system of equations:\n\n$$\n\\begin{aligned}\\{\\begin{aligned}4x=2\\lambda x \\\\ 8y=2\\lambda y\\end{aligned}\\,⇒\\,\\{\\begin{aligned}x(2-\\lambda )=0 \\\\ y(4-\\lambda )=0\\end{aligned}\\end{aligned}\n$$\n\nTo solve this system, we break it up into several cases:\n\n- Assuming $x=0$ in the first equation, the constraint condition $x^2+y^2=1$ implies\n\n$$\n\\begin{aligned}{0}^{2}+{y}^{2} & =1\\,⇒\\,y=\\pm 1.\\end{aligned}\n$$\n\nThis gives the critical points $\\left(0,\\pm 1 \\right).$\n\n- Assuming $\\lambda =2$ in the first equation, the second equation of the system implies\n\n$$\n\\begin{aligned}y(4-2)=0\\,⇒\\,y=0.\\end{aligned}\n$$\n\nThen, the constraint condition $x^2+y^2=1$ implies\n\n$$\n\\begin{aligned}{x}^{2}+{0}^{2} & =1\\,⇒\\,x=\\pm 1.\\end{aligned}\n$$\n\nThis gives the critical point $\\left(\\pm 1, 0 \\right).$\n\nTherefore, $f$ has possible extreme values at the points\n\n$$\n(\\pm 1, 0), \\qquad (0, \\pm1), \\qquad (0,0).\n$$\n\nNote that we add the critical point $(0,0)$ to the list of the candidates above.\n\nFinally, we evaluate $f$ at these points: \n\n| $(x,y)$ | $(\\pm 1,0)$ | $(0, \\pm 1)$ | $(0, 0)$ |\n| --- | --- | --- | --- |\n| $f(x,y)$ | $2$ | $4$ | $0$ |\n\nTherefore, the function reaches a minimum of $0$ at the point $(0, 0)$ and a maximum of $4$ at the points $(0, \\pm 1).$" #edb/ref 17592186045417] [17592186199484 #edb/ref 1065 7743 #edb/ref 17592186045417] [17592186199484 #edb/ref 1066 #uuid "7cc22f9f-d1be-570d-acd7-d3f2e0af7a51" #edb/ref 17592186045417] [17592186199484 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186278629 #edb/ref 1080 "-20" #edb/ref 17592186045417] [17592186278629 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186278629 #edb/ref 1083 #uuid "0499cbca-daad-57e1-9934-25522e310898" #edb/ref 17592186045417] [17592186278665 #edb/ref 1080 "-40" #edb/ref 17592186045417] [17592186278665 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186278665 #edb/ref 1083 #uuid "08288e31-44a4-5cbd-b685-8435569179d8" #edb/ref 17592186045417] [17592186278735 #edb/ref 1080 "-4" #edb/ref 17592186045417] [17592186278735 #edb/ref 1082 #edb