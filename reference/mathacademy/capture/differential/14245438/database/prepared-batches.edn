[{"source" ":org/Math-Academy" "forms" [{:db/id 17592186124437 :knowledge-point/questions ["question-4e141666-84d5-5edd-9a4e-a7cb3e788f33"] :db/ensure [:knowledge-point/validate]} {:db/id "question-4e141666-84d5-5edd-9a4e-a7cb3e788f33" :question/id #uuid "4e141666-84d5-5edd-9a4e-a7cb3e788f33" :question/math-academy-id "q-132581" :question/problem "A surface $S$ is defined by $z=f(x,y).$ The curve $C$ is the intersection of $S$ with the plane $x=2.$ Given that the point $P$ with $y$-coordinate $\\frac{\\pi }{4}$ lies on $C$, and that ${f}_{y}=y\\operatorname{sin}⁡(xy-\\frac{\\pi }{3})$, find the slope of the tangent to $C$ at $P.$" :question/worked-solution "The curve $C$ is the intersection of the surface $z=f(x,y)$ with the plane $x=2.$ Hence, the slope of the tangent to the curve $C$ at the point where $y=\\frac{\\pi }{4}$ will be given by the partial derivative ${f}_{y}(2,\\frac{\\pi }{4}).$ \n\nTo get the slope, we evaluate the partial derivative ${f}_{y}(x,y)$ at $(2,\\frac{\\pi }{4}):$ \n\n$$\n\\begin{aligned}{f}_{y}(2,\\frac{\\pi }{4}) & =\\frac{\\pi }{4}\\cdot \\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{4}-\\frac{\\pi }{3}) \\\\  & =\\frac{\\pi }{4}\\operatorname{sin}⁡(\\frac{\\pi }{6}) \\\\  & =\\frac{\\pi }{4}\\cdot \\frac{1}{2} \\\\  & =\\frac{\\pi }{8}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-bd0c0893-97b7-5c87-8979-00978834031e"] :db/ensure [:question/validate]} {:db/id "answer-field-bd0c0893-97b7-5c87-8979-00978834031e" :answer-field/id #uuid "bd0c0893-97b7-5c87-8979-00978834031e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-647eb414-70e2-51df-bace-381aeabfab1b" :answer-field/choices ["answer-5e6dbddc-14bc-525e-8243-43d97f13d5de" "answer-a03c2c09-7f10-51f5-b6e9-049c1b7317c5" "answer-c9bdd2b2-810c-5ef0-84b0-8ece0783d384" "answer-8af33f3e-47b0-5222-adb2-0e369970c083" "answer-647eb414-70e2-51df-bace-381aeabfab1b"] :db/ensure [:answer-field/validate]} {:db/id "answer-5e6dbddc-14bc-525e-8243-43d97f13d5de" :answer/id #uuid "5e6dbddc-14bc-525e-8243-43d97f13d5de" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "answer-a03c2c09-7f10-51f5-b6e9-049c1b7317c5" :answer/id #uuid "a03c2c09-7f10-51f5-b6e9-049c1b7317c5" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{4}+\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-c9bdd2b2-810c-5ef0-84b0-8ece0783d384" :answer/id #uuid "c9bdd2b2-810c-5ef0-84b0-8ece0783d384" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{4}-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-8af33f3e-47b0-5222-adb2-0e369970c083" :answer/id #uuid "8af33f3e-47b0-5222-adb2-0e369970c083" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{6}" :db/ensure [:answer/validate]} {:db/id "answer-647eb414-70e2-51df-bace-381aeabfab1b" :answer/id #uuid "647eb414-70e2-51df-bace-381aeabfab1b" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{8}" :db/ensure [:answer/validate]} {:db/id 17592186124438 :knowledge-point/questions ["question-bd4791a4-a5ea-5e12-b1c8-f45a53372bd0"] :db/ensure [:knowledge-point/validate]} {:db/id "question-bd4791a4-a5ea-5e12-b1c8-f45a53372bd0" :question/id #uuid "bd4791a4-a5ea-5e12-b1c8-f45a53372bd0" :question/math-academy-id "q-71214" :question/problem "The curve $C$ is the intersection of a surface $S,$ defined by $z=f(x,y),$ with the plane $y=\\frac{\\pi }{2}.$ Given that the point $P(1,\\frac{\\pi }{2},0)$ lies on $C$, and that ${f}_{x}=2\\operatorname{sin}⁡(xy)-x\\operatorname{cos}⁡y$, find the equations of the tangent line to $C$ at $P.$" :question/worked-solution "The curve $C$ is the intersection of the surface $z=f(x,y)$ with the plane $y=\\frac{\\pi }{2}.$ Hence, the slope of the tangent to the curve at the point $P(1,\\frac{\\pi }{2},0)$ will be given by the partial derivative $\\frac{∂z}{∂x}{|}_{(1,\\frac{\\pi }{2})}.$\n\nTo get the slope, we evaluate the partial derivative $\\frac{∂z}{∂x}$ at $(1,\\frac{\\pi }{2}):$\n\n$$\n\\begin{aligned}\\frac{∂z}{∂x}{|}_{(1,\\frac{\\pi }{2})} & =2\\operatorname{sin}⁡(1\\cdot \\frac{\\pi }{2})-1\\cdot \\operatorname{cos}⁡\\frac{\\pi }{2} \\\\  & =2\\cdot 1-1\\cdot 0 \\\\  & =2\\end{aligned}\n$$\n\nNow, we use the point-slope form of a straight line:\n\n$$\n\\begin{aligned}z-z{|}_{(1,\\frac{\\pi }{2})} & =\\frac{∂z}{∂x}{|}_{(1,\\frac{\\pi }{2})}(x-1) \\\\ z-0 & =2(x-1) \\\\ z & =2x-2\\end{aligned}\n$$\n\nFinally, the tangent line to the curve $C$ at $P(1,\\frac{\\pi }{2},0)$ can be given as the intersection of two planes, as follows:\n\n$$\n\\{\\begin{aligned}y=\\frac{\\pi }{2} \\\\ z=2x-2\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d2ed29c1-ef21-57a0-9839-78668465edfc"] :db/ensure [:question/validate]} {:db/id "answer-field-d2ed29c1-ef21-57a0-9839-78668465edfc" :answer-field/id #uuid "d2ed29c1-ef21-57a0-9839-78668465edfc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-76b72c1f-3222-52aa-ba57-d8ef2a3b29a2" :answer-field/choices ["answer-1f196182-837a-5bce-a183-aadf810b7f54" "answer-76b72c1f-3222-52aa-ba57-d8ef2a3b29a2" "answer-1df674f5-22d1-57e9-8542-daec656270b9" "answer-4d8b41aa-822d-5816-ad83-338eb5cc1486" "answer-54faae86-df4c-5126-b41f-7bacd23c8482"] :db/ensure [:answer-field/validate]} {:db/id "answer-1f196182-837a-5bce-a183-aadf810b7f54" :answer/id #uuid "1f196182-837a-5bce-a183-aadf810b7f54" :answer/type :answer.type/math :answer/value "\\{\\begin{aligned}y=\\frac{\\pi }{2} \\\\ z=2x-1\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "answer-76b72c1f-3222-52aa-ba57-d8ef2a3b29a2" :answer/id #uuid "76b72c1f-3222-52aa-ba57-d8ef2a3b29a2" :answer/type :answer.type/math :answer/value "\\{\\begin{aligned}y=\\frac{\\pi }{2} \\\\ z=2x-2\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "answer-1df674f5-22d1-57e9-8542-daec656270b9" :answer/id #uuid "1df674f5-22d1-57e9-8542-daec656270b9" :answer/type :answer.type/math :answer/value "\\{\\begin{aligned}y=\\frac{\\pi }{2} \\\\ z=3x-3\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "answer-4d8b41aa-822d-5816-ad83-338eb5cc1486" :answer/id #uuid "4d8b41aa-822d-5816-ad83-338eb5cc1486" :answer/type :answer.type/math :answer/value "\\{\\begin{aligned}y=\\frac{\\pi }{2} \\\\ z=x-1\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "answer-54faae86-df4c-5126-b41f-7bacd23c8482" :answer/id #uuid "54faae86-df4c-5126-b41f-7bacd23c8482" :answer/type :answer.type/math :answer/value "\\{\\begin{aligned}y=\\frac{\\pi }{2} \\\\ z=x-2\\end{aligned}" :db/ensure [:answer/validate]} {:db/id 17592186124439 :knowledge-point/questions ["question-19ce6755-ce5c-5344-86b9-dca6271615dd"] :db/ensure [:knowledge-point/validate]} {:db/id "question-19ce6755-ce5c-5344-86b9-dca6271615dd" :question/id #uuid "19ce6755-ce5c-5344-86b9-dca6271615dd" :question/math-academy-id "q-132608" :question/problem "The curve $C$ is the intersection of a surface $S,$ defined by $z=f(x,y),$ with the plane $y=0.$ Given that the point $P(\\frac{1}{2},0,1)$ lies on $C$, and that ${f}_{x}=(y+1)\\operatorname{cos}⁡(\\pi x)+2x\\operatorname{cos}⁡(\\pi y)\\operatorname{sin}⁡(\\pi x)$, which of the following gives a tangent vector to $C$ at $P?$" :question/worked-solution "The curve $C$ is the intersection of the surface with the plane $y=0.$ Hence, the slope of the tangent to the curve $C$ at the point $P$ will be given by the partial derivative ${f}_{x}(\\frac{1}{2},0).$ \n\nTo get the slope, we evaluate the partial derivative ${f}_{x}(x,y)$ at $(\\frac{1}{2},0):$\n\n$$\n\\begin{aligned}{f}_{x}(\\frac{1}{2},0) & =(0+1)\\operatorname{cos}⁡(\\pi \\cdot \\frac{1}{2})+2(\\frac{1}{2})\\operatorname{cos}⁡(\\pi \\cdot 0)\\operatorname{sin}⁡(\\pi \\cdot \\frac{1}{2}) \\\\  & =\\operatorname{cos}⁡(\\frac{\\pi }{2})+\\operatorname{cos}⁡(0)\\operatorname{sin}⁡(\\frac{\\pi }{2}) \\\\  & =0+1 \\\\  & =1\\end{aligned}\n$$\n\n \n\nNow, we use the point-slope form of a straight line:\n\n$$\n\\begin{aligned}z-f(\\frac{1}{2},0) & ={f}_{x}(\\frac{1}{2},0)(x-\\frac{1}{2}) \\\\ z-1 & =1(x-\\frac{1}{2}) \\\\ z-1 & =x-\\frac{1}{2} \\\\ z & =x+\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, the tangent line to the curve $C$ at $P(\\frac{1}{2},0,1)$ can be given as the intersection of two planes:\n\n$$\n\\{\\begin{aligned}y=0 \\\\ z=x+\\frac{1}{2}\\end{aligned}\n$$\n\nNext, notice that:\n\n- For the plane $y=0,$ a normal vector to the plane is ${n}_{1}=⟨0,1,0⟩.$\n\n- For the plane $z=x+\\frac{1}{2}$ (or $x-z+\\frac{1}{2}=0$), a normal vector to the plane is ${n}_{2}=⟨1,0,-1⟩.$\n\nFinally, to find a direction vector for the tangent line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}{n}_{1}\\times {n}_{2} & =⟨0,1,0⟩\\times ⟨1,0,-1⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 0 & 1 & 0 \\\\ 1 & 0 & -1\\end{aligned}\\right| \\\\  & =-i-k\\end{aligned}\n$$\n\nFinally, since $-i-k$ is parallel to the tangent line, then $-(-i-k)=i+k$ is also parallel to it." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-3db3d25b-6794-5819-bf20-9d7f989372fc"] :db/ensure [:question/validate]} {:db/id "answer-field-3db3d25b-6794-5819-bf20-9d7f989372fc" :answer-field/id #uuid "3db3d25b-6794-5819-bf20-9d7f989372fc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e312bb41-87f9-5deb-9841-5b5f28418294" :answer-field/choices ["answer-fa10a00d-f989-5e31-96e2-3b5966e8e36b" "answer-3a92a5b0-f742-5f72-9fed-2fa17746b3d7" "answer-fc7c1f10-9c81-523f-bfa3-f0d613a444d5" "answer-e312bb41-87f9-5deb-9841-5b5f28418294" "answer-e72b0968-76fc-5d45-85c7-a1f5300ad455"] :db/ensure [:answer-field/validate]} {:db/id "answer-fa10a00d-f989-5e31-96e2-3b5966e8e36b" :answer/id #uuid "fa10a00d-f989-5e31-96e2-3b5966e8e36b" :answer/type :answer.type/math :answer/value "2\\,i+k" :db/ensure [:answer/validate]} {:db/id "answer-3a92a5b0-f742-5f72-9fed-2fa17746b3d7" :answer/id #uuid "3a92a5b0-f742-5f72-9fed-2fa17746b3d7" :answer/type :answer.type/math :answer/value "3\\,i-2\\,k" :db/ensure [:answer/validate]} {:db/id "answer-fc7c1f10-9c81-523f-bfa3-f0d613a444d5" :answer/id #uuid "fc7c1f10-9c81-523f-bfa3-f0d613a444d5" :answer/type :answer.type/math :answer/value "i+2\\,k" :db/ensure [:answer/validate]} {:db/id "answer-e312bb41-87f9-5deb-9841-5b5f28418294" :answer/id #uuid "e312bb41-87f9-5deb-9841-5b5f28418294" :answer/type :answer.type/math :answer/value "i+k" :db/ensure [:answer/validate]} {:db/id "answer-e72b0968-76fc-5d45-85c7-a1f5300ad455" :answer/id #uuid "e72b0968-76fc-5d45-85c7-a1f5300ad455" :answer/type :answer.type/math :answer/value "i-k" :db/ensure [:answer/validate]}] "assertions" [["question-4e141666-84d5-5edd-9a4e-a7cb3e788f33" :question/id #uuid "4e141666-84d5-5edd-9a4e-a7cb3e788f33"] ["question-4e141666-84d5-5edd-9a4e-a7cb3e788f33" :question/math-academy-id "q-132581"] ["question-4e141666-84d5-5edd-9a4e-a7cb3e788f33" :question/problem "A surface $S$ is defined by $z=f(x,y).$ The curve $C$ is the intersection of $S$ with the plane $x=2.$ Given that the point $P$ with $y$-coordinate $\\frac{\\pi }{4}$ lies on $C$, and that ${f}_{y}=y\\operatorname{sin}⁡(xy-\\frac{\\pi }{3})$, find the slope of the tangent to $C$ at $P.$"] ["question-4e141666-84d5-5edd-9a4e-a7cb3e788f33" :question/worked-solution "The curve $C$ is the intersection of the surface $z=f(x,y)$ with the plane $x=2.$ Hence, the slope of the tangent to the curve $C$ at the point where $y=\\frac{\\pi }{4}$ will be given by the partial derivative ${f}_{y}(2,\\frac{\\pi }{4}).$ \n\nTo get the slope, we evaluate the partial derivative ${f}_{y}(x,y)$ at $(2,\\frac{\\pi }{4}):$ \n\n$$\n\\begin{aligned}{f}_{y}(2,\\frac{\\pi }{4}) & =\\frac{\\pi }{4}\\cdot \\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{4}-\\frac{\\pi }{3}) \\\\  & =\\frac{\\pi }{4}\\operatorname{sin}⁡(\\frac{\\pi }{6}) \\\\  & =\\frac{\\pi }{4}\\cdot \\frac{1}{2} \\\\  & =\\frac{\\pi }{8}\\end{aligned}\n$$"] ["question-4e141666-84d5-5edd-9a4e-a7cb3e788f33" :question/difficulty :question.difficulty/easy] ["answer-field-bd0c0893-97b7-5c87-8979-00978834031e" :answer-field/id #uuid "bd0c0893-97b7-5c87-8979-00978834031e"] ["answer-5e6dbddc-14bc-525e-8243-43d97f13d5de" :answer/id #uuid "5e6dbddc-14bc-525e-8243-43d97f13d5de"] ["answer-5e6dbddc-14bc-525e-8243-43d97f13d5de" :answer/type :answer.type/math] ["answer-5e6dbddc-14bc-525e-8243-43d97f13d5de" :answer/value "\\frac{\\pi }{2}"] ["answer-a03c2c09-7f10-51f5-b6e9-049c1b7317c5" :answer/id #uuid "a03c2c09-7f10-51f5-b6e9-049c1b7317c5"] ["answer-a03c2c09-7f10-51f5-b6e9-049c1b7317c5" :answer/type :answer.type/math] ["answer-a03c2c09-7f10-51f5-b6e9-049c1b7317c5" :answer/value "\\frac{\\pi }{4}+\\frac{1}{2}"] ["answer-c9bdd2b2-810c-5ef0-84b0-8ece0783d384" :answer/id #uuid "c9bdd2b2-810c-5ef0-84b0-8ece0783d384"] ["answer-c9bdd2b2-810c-5ef0-84b0-8ece0783d384" :answer/type :answer.type/math] ["answer-c9bdd2b2-810c-5ef0-84b0-8ece0783d384" :answer/value "\\frac{\\pi }{4}-\\frac{1}{2}"] ["answer-8af33f3e-47b0-5222-adb2-0e369970c083" :answer/id #uuid "8af33f3e-47b0-5222-adb2-0e369970c083"] ["answer-8af33f3e-47b0-5222-adb2-0e369970c083" :answer/type :answer.type/math] ["answer-8af33f3e-47b0-5222-adb2-0e369970c083" :answer/value "\\frac{\\pi }{6}"] ["answer-647eb414-70e2-51df-bace-381aeabfab1b" :answer/id #uuid "647eb414-70e2-51df-bace-381aeabfab1b"] ["answer-647eb414-70e2-51df-bace-381aeabfab1b" :answer/type :answer.type/math] ["answer-647eb414-70e2-51df-bace-381aeabfab1b" :answer/value "\\frac{\\pi }{8}"] ["answer-field-bd0c0893-97b7-5c87-8979-00978834031e" :answer-field/key "selection"] ["answer-field-bd0c0893-97b7-5c87-8979-00978834031e" :answer-field/type :answer-field.type/radio] ["answer-field-bd0c0893-97b7-5c87-8979-00978834031e" :answer-field/correct "answer-647eb414-70e2-51df-bace-381aeabfab1b"] ["answer-field-bd0c0893-97b7-5c87-8979-00978834031e" :answer-field/choices "answer-5e6dbddc-14bc-525e-8243-43d97f13d5de"] ["answer-field-bd0c0893-97b7-5c87-8979-00978834031e" :answer-field/choices "answer-a03c2c09-7f10-51f5-b6e9-049c1b7317c5"] ["answer-field-bd0c0893-97b7-5c87-8979-00978834031e" :answer-field/choices "answer-c9bdd2b2-810c-5ef0-84b0-8ece0783d384"] ["answer-field-bd0c0893-97b7-5c87-8979-00978834031e" :answer-field/choices "answer-8af33f3e-47b0-5222-adb2-0e369970c083"] ["answer-field-bd0c0893-97b7-5c87-8979-00978834031e" :answer-field/choices "answer-647eb414-70e2-51df-bace-381aeabfab1b"] ["question-4e141666-84d5-5edd-9a4e-a7cb3e788f33" :question/answer-fields "answer-field-bd0c0893-97b7-5c87-8979-00978834031e"] [17592186124437 :knowledge-point/questions "question-4e141666-84d5-5edd-9a4e-a7cb3e788f33"] ["question-bd4791a4-a5ea-5e12-b1c8-f45a53372bd0" :question/id #uuid "bd4791a4-a5ea-5e12-b1c8-f45a53372bd0"] ["question-bd4791a4-a5ea-5e12-b1c8-f45a53372bd0" :question/math-academy-id "q-71214"] ["question-bd4791a4-a5ea-5e12-b1c8-f45a53372bd0" :question/problem "The curve $C$ is the intersection of a surface $S,$ defined by $z=f(x,y),$ with the plane $y=\\frac{\\pi }{2}.$ Given that the point $P(1,\\frac{\\pi }{2},0)$ lies on $C$, and that ${f}_{x}=2\\operatorname{sin}⁡(xy)-x\\operatorname{cos}⁡y$, find the equations of the tangent line to $C$ at $P.$"] ["question-bd4791a4-a5ea-5e12-b1c8-f45a53372bd0" :question/worked-solution "The curve $C$ is the intersection of the surface $z=f(x,y)$ with the plane $y=\\frac{\\pi }{2}.$ Hence, the slope of the tangent to the curve at the point $P(1,\\frac{\\pi }{2},0)$ will be given by the partial derivative $\\frac{∂z}{∂x}{|}_{(1,\\frac{\\pi }{2})}.$\n\nTo get the slope, we evaluate the partial derivative $\\frac{∂z}{∂x}$ at $(1,\\frac{\\pi }{2}):$\n\n$$\n\\begin{aligned}\\frac{∂z}{∂x}{|}_{(1,\\frac{\\pi }{2})} & =2\\operatorname{sin}⁡(1\\cdot \\frac{\\pi }{2})-1\\cdot \\operatorname{cos}⁡\\frac{\\pi }{2} \\\\  & =2\\cdot 1-1\\cdot 0 \\\\  & =2\\end{aligned}\n$$\n\nNow, we use the point-slope form of a straight line:\n\n$$\n\\begin{aligned}z-z{|}_{(1,\\frac{\\pi }{2})} & =\\frac{∂z}{∂x}{|}_{(1,\\frac{\\pi }{2})}(x-1) \\\\ z-0 & =2(x-1) \\\\ z & =2x-2\\end{aligned}\n$$\n\nFinally, the tangent line to the curve $C$ at $P(1,\\frac{\\pi }{2},0)$ can be given as the intersection of two planes, as follows:\n\n$$\n\\{\\begin{aligned}y=\\frac{\\pi }{2} \\\\ z=2x-2\\end{aligned}\n$$"] ["question-bd4791a4-a5ea-5e12-b1c8-f45a53372bd0" :question/difficulty :question.difficulty/moderate] ["answer-field-d2ed29c1-ef21-57a0-9839-78668465edfc" :answer-field/id #uuid "d2ed29c1-ef21-57a0-9839-78668465edfc"] ["answer-1f196182-837a-5bce-a183-aadf810b7f54" :answer/id #uuid "1f196182-837a-5bce-a183-aadf810b7f54"] ["answer-1f196182-837a-5bce-a183-aadf810b7f54" :answer/type :answer.type/math] ["answer-1f196182-837a-5bce-a183-aadf810b7f54" :answer/value "\\{\\begin{aligned}y=\\frac{\\pi }{2} \\\\ z=2x-1\\end{aligned}"] ["answer-76b72c1f-3222-52aa-ba57-d8ef2a3b29a2" :answer/id #uuid "76b72c1f-3222-52aa-ba57-d8ef2a3b29a2"] ["answer-76b72c1f-3222-52aa-ba57-d8ef2a3b29a2" :answer/type :answer.type/math] ["answer-76b72c1f-3222-52aa-ba57-d8ef2a3b29a2" :answer/value "\\{\\begin{aligned}y=\\frac{\\pi }{2} \\\\ z=2x-2\\end{aligned}"] ["answer-1df674f5-22d1-57e9-8542-daec656270b9" :answer/id #uuid "1df674f5-22d1-57e9-8542-daec656270b9"] ["answer-1df674f5-22d1-57e9-8542-daec656270b9" :answer/type :answer.type/math] ["answer-1df674f5-22d1-57e9-8542-daec656270b9" :answer/value "\\{\\begin{aligned}y=\\frac{\\pi }{2} \\\\ z=3x-3\\end{aligned}"] ["answer-4d8b41aa-822d-5816-ad83-338eb5cc1486" :answer/id #uuid "4d8b41aa-822d-5816-ad83-338eb5cc1486"] ["answer-4d8b41aa-822d-5816-ad83-338eb5cc1486" :answer/type :answer.type/math] ["answer-4d8b41aa-822d-5816-ad83-338eb5cc1486" :answer/value "\\{\\begin{aligned}y=\\frac{\\pi }{2} \\\\ z=x-1\\end{aligned}"] ["answer-54faae86-df4c-5126-b41f-7bacd23c8482" :answer/id #uuid "54faae86-df4c-5126-b41f-7bacd23c8482"] ["answer-54faae86-df4c-5126-b41f-7bacd23c8482" :answer/type :answer.type/math] ["answer-54faae86-df4c-5126-b41f-7bacd23c8482" :answer/value "\\{\\begin{aligned}y=\\frac{\\pi }{2} \\\\ z=x-2\\end{aligned}"] ["answer-field-d2ed29c1-ef21-57a0-9839-78668465edfc" :answer-field/key "selection"] ["answer-field-d2ed29c1-ef21-57a0-9839-78668465edfc" :answer-field/type :answer-field.type/radio] ["answer-field-d2ed29c1-ef21-57a0-9839-78668465edfc" :answer-field/correct "answer-76b72c1f-3222-52aa-ba57-d8ef2a3b29a2"] ["answer-field-d2ed29c1-ef21-57a0-9839-78668465edfc" :answer-field/choices "answer-1f196182-837a-5bce-a183-aadf810b7f54"] ["answer-field-d2ed29c1-ef21-57a0-9839-78668465edfc" :answer-field/choices "answer-76b72c1f-3222-52aa-ba57-d8ef2a3b29a2"] ["answer-field-d2ed29c1-ef21-57a0-9839-78668465edfc" :answer-field/choices "answer-1df674f5-22d1-57e9-8542-daec656270b9"] ["answer-field-d2ed29c1-ef21-57a0-9839-78668465edfc" :answer-field/choices "answer-4d8b41aa-822d-5816-ad83-338eb5cc1486"] ["answer-field-d2ed29c1-ef21-57a0-9839-78668465edfc" :answer-field/choices "answer-54faae86-df4c-5126-b41f-7bacd23c8482"] ["question-bd4791a4-a5ea-5e12-b1c8-f45a53372bd0" :question/answer-fields "answer-field-d2ed29c1-ef21-57a0-9839-78668465edfc"] [17592186124438 :knowledge-point/questions "question-bd4791a4-a5ea-5e12-b1c8-f45a53372bd0"] ["question-19ce6755-ce5c-5344-86b9-dca6271615dd" :question/id #uuid "19ce6755-ce5c-5344-86b9-dca6271615dd"] ["question-19ce6755-ce5c-5344-86b9-dca6271615dd" :question/math-academy-id "q-132608"] ["question-19ce6755-ce5c-5344-86b9-dca6271615dd" :question/problem "The curve $C$ is the intersection of a surface $S,$ defined by $z=f(x,y),$ with the plane $y=0.$ Given that the point $P(\\frac{1}{2},0,1)$ lies on $C$, and that ${f}_{x}=(y+1)\\operatorname{cos}⁡(\\pi x)+2x\\operatorname{cos}⁡(\\pi y)\\operatorname{sin}⁡(\\pi x)$, which of the following gives a tangent vector to $C$ at $P?$"] ["question-19ce6755-ce5c-5344-86b9-dca6271615dd" :question/worked-solution "The curve $C$ is the intersection of the surface with the plane $y=0.$ Hence, the slope of the tangent to the curve $C$ at the point $P$ will be given by the partial derivative ${f}_{x}(\\frac{1}{2},0).$ \n\nTo get the slope, we evaluate the partial derivative ${f}_{x}(x,y)$ at $(\\frac{1}{2},0):$\n\n$$\n\\begin{aligned}{f}_{x}(\\frac{1}{2},0) & =(0+1)\\operatorname{cos}⁡(\\pi \\cdot \\frac{1}{2})+2(\\frac{1}{2})\\operatorname{cos}⁡(\\pi \\cdot 0)\\operatorname{sin}⁡(\\pi \\cdot \\frac{1}{2}) \\\\  & =\\operatorname{cos}⁡(\\frac{\\pi }{2})+\\operatorname{cos}⁡(0)\\operatorname{sin}⁡(\\frac{\\pi }{2}) \\\\  & =0+1 \\\\  & =1\\end{aligned}\n$$\n\n \n\nNow, we use the point-slope form of a straight line:\n\n$$\n\\begin{aligned}z-f(\\frac{1}{2},0) & ={f}_{x}(\\frac{1}{2},0)(x-\\frac{1}{2}) \\\\ z-1 & =1(x-\\frac{1}{2}) \\\\ z-1 & =x-\\frac{1}{2} \\\\ z & =x+\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, the tangent line to the curve $C$ at $P(\\frac{1}{2},0,1)$ can be given as the intersection of two planes:\n\n$$\n\\{\\begin{aligned}y=0 \\\\ z=x+\\frac{1}{2}\\end{aligned}\n$$\n\nNext, notice that:\n\n- For the plane $y=0,$ a normal vector to the plane is ${n}_{1}=⟨0,1,0⟩.$\n\n- For the plane $z=x+\\frac{1}{2}$ (or $x-z+\\frac{1}{2}=0$), a normal vector to the plane is ${n}_{2}=⟨1,0,-1⟩.$\n\nFinally, to find a direction vector for the tangent line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}{n}_{1}\\times {n}_{2} & =⟨0,1,0⟩\\times ⟨1,0,-1⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 0 & 1 & 0 \\\\ 1 & 0 & -1\\end{aligned}\\right| \\\\  & =-i-k\\end{aligned}\n$$\n\nFinally, since $-i-k$ is parallel to the tangent line, then $-(-i-k)=i+k$ is also parallel to it."] ["question-19ce6755-ce5c-5344-86b9-dca6271615dd" :question/difficulty :question.difficulty/hard] ["answer-field-3db3d25b-6794-5819-bf20-9d7f989372fc" :answer-field/id #uuid "3db3d25b-6794-5819-bf20-9d7f989372fc"] ["answer-fa10a00d-f989-5e31-96e2-3b5966e8e36b" :answer/id #uuid "fa10a00d-f989-5e31-96e2-3b5966e8e36b"] ["answer-fa10a00d-f989-5e31-96e2-3b5966e8e36b" :answer/type :answer.type/math] ["answer-fa10a00d-f989-5e31-96e2-3b5966e8e36b" :answer/value "2\\,i+k"] ["answer-3a92a5b0-f742-5f72-9fed-2fa17746b3d7" :answer/id #uuid "3a92a5b0-f742-5f72-9fed-2fa17746b3d7"] ["answer-3a92a5b0-f742-5f72-9fed-2fa17746b3d7" :answer/type :answer.type/math] ["answer-3a92a5b0-f742-5f72-9fed-2fa17746b3d7" :answer/value "3\\,i-2\\,k"] ["answer-fc7c1f10-9c81-523f-bfa3-f0d613a444d5" :answer/id #uuid "fc7c1f10-9c81-523f-bfa3-f0d613a444d5"] ["answer-fc7c1f10-9c81-523f-bfa3-f0d613a444d5" :answer/type :answer.type/math] ["answer-fc7c1f10-9c81-523f-bfa3-f0d613a444d5" :answer/value "i+2\\,k"] ["answer-e312bb41-87f9-5deb-9841-5b5f28418294" :answer/id #uuid "e312bb41-87f9-5deb-9841-5b5f28418294"] ["answer-e312bb41-87f9-5deb-9841-5b5f28418294" :answer/type :answer.type/math] ["answer-e312bb41-87f9-5deb-9841-5b5f28418294" :answer/value "i+k"] ["answer-e72b0968-76fc-5d45-85c7-a1f5300ad455" :answer/id #uuid "e72b0968-76fc-5d45-85c7-a1f5300ad455"] ["answer-e72b0968-76fc-5d45-85c7-a1f5300ad455" :answer/type :answer.type/math] ["answer-e72b0968-76fc-5d45-85c7-a1f5300ad455" :answer/value "i-k"] ["answer-field-3db3d25b-6794-5819-bf20-9d7f989372fc" :answer-field/key "selection"] ["answer-field-3db3d25b-6794-5819-bf20-9d7f989372fc" :answer-field/type :answer-field.type/radio] ["answer-field-3db3d25b-6794-5819-bf20-9d7f989372fc" :answer-field/correct "answer-e312bb41-87f9-5deb-9841-5b5f28418294"] ["answer-field-3db3d25b-6794-5819-bf20-9d7f989372fc" :answer-field/choices "answer-fa10a00d-f989-5e31-96e2-3b5966e8e36b"] ["answer-field-3db3d25b-6794-5819-bf20-9d7f989372fc" :answer-field/choices "answer-3a92a5b0-f742-5f72-9fed-2fa17746b3d7"] ["answer-field-3db3d25b-6794-5819-bf20-9d7f989372fc" :answer-field/choices "answer-fc7c1f10-9c81-523f-bfa3-f0d613a444d5"] ["answer-field-3db3d25b-6794-5819-bf20-9d7f989372fc" :answer-field/choices "answer-e312bb41-87f9-5deb-9841-5b5f28418294"] ["answer-field-3db3d25b-6794-5819-bf20-9d7f989372fc" :answer-field/choices "answer-e72b0968-76fc-5d45-85c7-a1f5300ad455"] ["question-19ce6755-ce5c-5344-86b9-dca6271615dd" :question/answer-fields "answer-field-3db3d25b-6794-5819-bf20-9d7f989372fc"] [17592186124439 :knowledge-point/questions "question-19ce6755-ce5c-5344-86b9-dca6271615dd"]] "retractions" []}]