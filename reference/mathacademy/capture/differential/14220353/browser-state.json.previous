      "extraction_error_parts": {},
      "assets": [],
      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14220353/observations/step-q132421-601b5d0796da75f8cfdd.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14220353/observations/step-q132421-601b5d0796da75f8cfdd.png",
      "source_url": "https://mathacademy.com/tasks/14220353/topics/2152/review",
      "captured_at": 1792026186.4062755,
      "math_academy_id": "q-132421",
      "topic_id": "2152",
