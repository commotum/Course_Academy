#{[{:db/id #edb/ref 17592186284461 :knowledge-point/_questions [{:db/id #edb/ref 17592186124505 :knowledge-point/id #uuid "e9078ab1-37a4-5e96-ae12-a83d5cd8804e" :knowledge-point/title "Identifying Properties of a Hyperbolic Paraboloid"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0775503d-b603-529a-9cc7-104772d13fc0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(7,0,0)$ only" :db/id #edb/ref 17592186281756} {:answer/id #uuid "3938f9bf-b9b1-50d8-9803-8ddddd2d20f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(5,0,0)$ only" :db/id #edb/ref 17592186282193} {:answer/id #uuid "be42c312-a9b8-592e-b8f0-129f5c3797cc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-3,0,0)$ and $(2,0,0)$" :db/id #edb/ref 17592186283342} {:answer/id #uuid "cc606197-6d13-5b13-b0dd-1767448acef7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-2,0,0)$ and $(2,0,0)$" :db/id #edb/ref 17592186283475} {:answer/id #uuid "ff00bc5a-be90-58c4-a32d-54ae93a95ef2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(3,0,0)$ and $(7,0,0)$" :db/id #edb/ref 17592186283928}] :answer-field/correct {:answer/id #uuid "ff00bc5a-be90-58c4-a32d-54ae93a95ef2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(3,0,0)$ and $(7,0,0)$" :db/id #edb/ref 17592186283928} :answer-field/id #uuid "b21dfeaa-7f24-50eb-ab46-ba0b9a81c643" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284243}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1c4e75ca-d0de-5c84-afaa-4eb1e04c61e1" :question/math-academy-id "q-164276" :question/problem "Given the hyperbolic paraboloid $2(x-5)^{2}-3(y-1)^{2}=z+5$, find its intercepts with the $x$-axis." :question/worked-solution "To find the $x$-intercepts of the paraboloid, we substitute $y=0$ and $z=0$ in the equation of the paraboloid:\n\n$$\n\\begin{aligned}2(x-5)^{2}-3(0-1)^{2} & =0+5 \\\\ 2(x-5)^{2}-3 & =5 \\\\ 2(x-5)^{2} & =8 \\\\ (x-5)^{2} & =4 \\\\ x-5 & =\\pm 2 \\\\ x & =5\\pm 2\\end{aligned}\n$$\n\nThis gives the solutions $x=3$ and $x=7.$\n\nTherefore, the intercepts with the $x$-axis are $(3,0,0)$ and $(7,0,0).$"}] [{:db/id #edb/ref 17592186284465 :knowledge-point/_questions [{:db/id #edb/ref 17592186124556 :knowledge-point/id #uuid "dff86a8b-7966-53f7-a7bc-287990fb611d" :knowledge-point/title "Finding Traces of Paraboloids"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "297fea90-37a9-5380-b47a-81c1e6d84465" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\sqrt{3}$ and $1$" :db/id #edb/ref 17592186282051} {:answer/id #uuid "3704ecec-4aab-5a7a-bf09-0c5c3fc66880" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2\\sqrt{2}$ and $1$" :db/id #edb/ref 17592186282178} {:answer/id #uuid "8c4ec860-b6b0-5930-9174-508c8b04299f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$9$ and $4$" :db/id #edb/ref 17592186282903} {:answer/id #uuid "8dd3abf6-da14-5f2d-a3c4-85c8c1e8823a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\sqrt{3}$ and $\\sqrt{2}$" :db/id #edb/ref 17592186282918} {:answer/id #uuid "ccccbae0-09b3-5285-928f-468dfef6fcee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3$ and $2$" :db/id #edb/ref 17592186283478}] :answer-field/correct {:answer/id #uuid "8dd3abf6-da14-5f2d-a3c4-85c8c1e8823a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\sqrt{3}$ and $\\sqrt{2}$" :db/id #edb/ref 17592186282918} :answer-field/id #uuid "858af6d8-4d33-5e09-9265-e6425c3e36a2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284161}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c4fbc092-8a05-5e53-ba3e-bf69c3dd36b6" :question/math-academy-id "q-164282" :question/problem "The projection of the intersection between the elliptic paraboloid $4(x-5)^{2}+6(y+4)^{2}=z+8$ and the plane \n$z=4$  onto the $xy$-plane is an ellipse. What are the lengths of the semi-axes of the ellipse?" :question/worked-solution "To find the intersection of the paraboloid and the plane $z=4$, we substitute $z=4$ into the equation of the paraboloid, and simplify:\n\n$$\n\\begin{aligned}4(x-5)^{2}+6(y+4)^{2}=z+8 \\\\ 4(x-5)^{2}+6(y+4)^{2}=4+8 \\\\ 4(x-5)^{2}+6(y+4)^{2}=12 \\\\ \\frac{(x-5)^{2}}{3}+\\frac{(y+4)^{2}}{2} & =1 \\\\ \\frac{(x-5)^{2}}{(\\sqrt{3})^{2}}+\\frac{(y+4)^{2}}{(\\sqrt{2})^{2}} & =1\\end{aligned}\n$$\n\nThis gives us the equation of an ellipse with semi-axes of lengths $\\sqrt{3}$ and $\\sqrt{2}.$"}] [{:db/id #edb/ref 17592186381910 :knowledge-point/_questions [{:db/id #edb/ref 17592186124556 :knowledge-point/id #uuid "dff86a8b-7966-53f7-a7bc-287990fb611d" :knowledge-point/title "Finding Traces of Paraboloids"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7e1b2516-5b9d-54b2-9786-41329153ae8c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(3,0)$ in the $xy$-plane" :db/id #edb/ref 17592186381912} {:answer/id #uuid "d1813045-0bb5-53cf-8edc-34c167bfd332" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,3)$ in the $xy$-plane" :db/id #edb/ref 17592186381913} {:answer/id #uuid "04b2f73e-e03c-565b-8715-7ef4230fb83d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0)$ in the $xy$-plane" :db/id #edb/ref 17592186381914} {:answer/id #uuid "c4e25ada-9587-5c88-95f7-c2125d31bd32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-3,0)$ in the $xy$-plane" :db/id #edb/ref 17592186381915} {:answer/id #uuid "0c60e3a9-dbfb-5ffa-a938-398f77fd1216" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,-3)$ in the $xy$-plane" :db/id #edb/ref 17592186381916}] :answer-field/correct {:answer/id #uuid "0c60e3a9-dbfb-5ffa-a938-398f77fd1216" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,-3)$ in the $xy$-plane" :db/id #edb/ref 17592186381916} :answer-field/id #uuid "8b417048-4247-5915-bf66-26eaced21af1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381911}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7cda8e94-4e6a-5db6-8cda-91d1dbc62834" :question/math-academy-id "q-35702" :question/problem "The projection of the intersection between the hyperbolic paraboloid $z=-9{x}^{2}+(y+3)^{2}$, and the plane $z=4$ onto the $xy$-plane is a hyperbola. Find the center of this hyperbola." :question/worked-solution "To find the intersection of the paraboloid and the plane $z=4$, we substitute $z=4$ into the equation of the paraboloid, and simplify:\n\n$$\n\\begin{aligned}-9{x}^{2}+(y+3)^{2} & =z \\\\ -9{x}^{2}+(y+3)^{2} & =4 \\\\ -\\frac{9{x}^{2}}{4}+\\frac{(y+3)^{2}}{4} & =1 \\\\ -\\frac{{x}^{2}}{4/9}+\\frac{(y+3)^{2}}{4} & =1\\end{aligned}\n$$\n\nThis gives us the equation of a hyperbola in the $xy$-plane that has its center at $(0,-3).$"}] [{:db/id #edb/ref 17592186342099 :knowledge-point/_questions [{:db/id #edb/ref 17592186124505 :knowledge-point/id #uuid "e9078ab1-37a4-5e96-ae12-a83d5cd8804e" :knowledge-point/title "Identifying Properties of a Hyperbolic Paraboloid"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05979749-7b02-5737-b992-42c5ea07512a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-9,-8)" :db/id #edb/ref 17592186339172} {:answer/id #uuid "1641bc5f-b110-54e8-947e-34361a794b87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-3,8)" :db/id #edb/ref 17592186339323} {:answer/id #uuid "cd01c16b-8ca9-5b1a-a5a7-d4a8818eb3a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-3,-8)" :db/id #edb/ref 17592186340944} {:answer/id #uuid "ec7ba85c-1bcf-578b-9307-8f32f0c08777" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,-9,-8)" :db/id #edb/ref 17592186341212} {:answer/id #uuid "f5a8447f-a95f-5391-a5d5-d3b1963e5621" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,9,8)" :db/id #edb/ref 17592186341295}] :answer-field/correct {:answer/id #uuid "05979749-7b02-5737-b992-42c5ea07512a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-9,-8)" :db/id #edb/ref 17592186339172} :answer-field/id #uuid "3e6eedd1-e02a-5ecb-a97b-b5bd45ee9bcc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341489}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "60f0667a-58e4-5e3e-ac71-292417e67feb" :question/math-academy-id "q-73864" :question/problem "Find the saddle point of the hyperbolic paraboloid $z+8={x}^{2}-(y+9)^{2}.$" :question/worked-solution "The general equation of a hyperbolic paraboloid with a saddle point at $({x}_{0},{y}_{0},{z}_{0})$ is \n\n$$\nz-{z}_{0}=\\frac{(x-{x}_{0})^{2}}{{a}^{2}}-\\frac{(y-{y}_{0})^{2}}{{b}^{2}}.\n$$\n\nTo find the saddle point, we rewrite our equation as follows:\n\n$$\n\\begin{aligned}z+8 & ={x}^{2}-(y+9)^{2} \\\\ z-(-8) & =\\frac{(x-0)^{2}}{1}-\\frac{(y-(-9))^{2}}{1}\\end{aligned}\n$$\n\nThis gives us the equation of a hyperbolic paraboloid with a saddle point at $(0,-9,-8).$"}]}
