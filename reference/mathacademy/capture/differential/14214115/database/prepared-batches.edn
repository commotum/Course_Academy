[{"source" ":org/Math-Academy" "forms" [{:db/id 17592186124505 :knowledge-point/questions ["question-cb8dda76-cb23-5b23-b067-bd505ebd9a72"] :db/ensure [:knowledge-point/validate]} {:db/id "question-cb8dda76-cb23-5b23-b067-bd505ebd9a72" :question/id #uuid "cb8dda76-cb23-5b23-b067-bd505ebd9a72" :question/math-academy-id "q-73861" :question/problem "Given the hyperbolic paraboloid $(x-4)^{2}-\\frac{(y+1)^{2}}{7}=z-12$, find its intercepts with the $y$-axis." :question/worked-solution "To find the $y$-intercepts of the paraboloid, we substitute $x=0$ and $z=0$ in the equation of the paraboloid:\n\n$$\n\\begin{aligned}(0-4)^{2}-\\frac{(y+1)^{2}}{7} & =0-12 \\\\ 16-\\frac{(y+1)^{2}}{7} & =-12 \\\\ \\frac{(y+1)^{2}}{7} & =28 \\\\ (y+1)^{2} & =196 \\\\ y+1 & =\\pm 14 \\\\ y & =-1\\pm 14\\end{aligned}\n$$\n\nThis gives the solutions $y=-15$ and $y=13.$\n\nTherefore, the intercepts with the $y$-axis are $(0,-15,0)$ and $(0,13,0).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-3925c411-60a1-5817-a407-541f7c2a0413"] :db/ensure [:question/validate]} {:db/id "answer-field-3925c411-60a1-5817-a407-541f7c2a0413" :answer-field/id #uuid "3925c411-60a1-5817-a407-541f7c2a0413" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-daa884be-dd4f-502c-ad7e-8f18e4feeeb2" :answer-field/choices ["answer-daa884be-dd4f-502c-ad7e-8f18e4feeeb2" "answer-ea74f780-c5a4-51a5-8a9e-88c3509c0e76" "answer-df704459-6416-5914-ac68-faa71d081a15" "answer-27aec271-8375-514d-93f8-b0fd659cac22" "answer-c76196c7-5bd8-564e-ab0c-1aa19bb1b301"] :db/ensure [:answer-field/validate]} {:db/id "answer-daa884be-dd4f-502c-ad7e-8f18e4feeeb2" :answer/id #uuid "daa884be-dd4f-502c-ad7e-8f18e4feeeb2" :answer/type :answer.type/text :answer/value "$(0,-15,0)$ and $(0,13,0)$" :db/ensure [:answer/validate]} {:db/id "answer-ea74f780-c5a4-51a5-8a9e-88c3509c0e76" :answer/id #uuid "ea74f780-c5a4-51a5-8a9e-88c3509c0e76" :answer/type :answer.t