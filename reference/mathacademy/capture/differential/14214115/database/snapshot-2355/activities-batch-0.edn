#{[{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186125377} :activity/id #uuid "c72df862-0af9-5865-8585-d7236cb48cda" :activity/scope {:db/id #edb/ref 17592186048510 :topic/id #uuid "a58e9ae3-7402-5272-b80f-f01ca3bb8c44" :topic/math-academy-id 1893} :activity/steps [{:db/id #edb/ref 17592186125377 :step/content {:db/id #edb/ref 17592186125774 :tutorial/content "Consider the quadric surface with the equation\n\n$$\nz = x^2 + y^2\n$$\n\nwhose graph is shown below.\n\n![](images/14/14e8d23a4bc649257c2f7351e0d2c1d62e39a8cd8eed1467e65853ee121b836e.png)\n\n \n\nThis surface is an example of an **elliptic paraboloid.**\n\n The **vertex** of this elliptic paraboloid is located at the origin, and its **axis of symmetry** is the $z$-axis. Note that the axis of symmetry is the vertical line that passes through the vertex.\n\nMore generally, the equation of an elliptic paraboloid oriented along the $z$-axis whose vertex is at the point $(x_0,y_0,z_0)$ is given by\n\n$$\nz - z_0 = \\dfrac{(x-x_0)^2}{a^2} + \\dfrac{(y-y_0)^2}{b^2},\n$$\n\nwhere $a$ and $b$ are constants.\n\nThese surfaces are called *elliptic* *paraboloids* because their traces in the $xy$-plane are *ellipses*, while their traces in the $yz$- and $xz$-planes are *parabolas*. We'll discuss the traces of this surface in more detail shortly." :tutorial/id #uuid "d5da7d20-bcec-546d-8cd6-178215fc2096" :tutorial/math-academy-id 3439 :tutorial/title "Introduction"} :step/id #uuid "0155d173-f619-5729-9721-6203bf768219" :step/math-academy-id 19459 :step/next {:db/id #edb/ref 17592186125378}} {:db/id #edb/ref 17592186125378 :step/content {:db/id #edb/ref 17592186124504 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124313 :question/id #uuid "945f684f-9707-5a0a-b5d7-0753f11b4385" :question/math-academy-id "e-5266"} :knowledge-point/id #uuid "ddf82ff9-ea7c-5f7f-ac18-07f8e75b717e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048350} {:db/id #edb/ref 17592186049336} {:db/id #edb/ref 17592186050991}] :knowledge-point/questions [{:db/id #edb/ref 17592186124896} {:db/id #edb/ref 17592186124931} {:db/id #edb/ref 17592186125218} {:db/id #edb/ref 17592186284456} {:db/id #edb/ref 17592186284457} {:db/id #edb/ref 17592186284458} {:db/id #edb/ref 17592186339072} {:db/id #edb/ref 17592186381300} {:db/id #edb/ref 17592186508076} {:db/id #edb/ref 17592186508102} {:db/id #edb/ref 17592186508110}] :knowledge-point/title "Identifying Properties of an Elliptic Paraboloid"} :step/id #uuid "32ea6077-6c22-5a3f-bce8-05b8b28c4283" :step/math-academy-id 19461 :step/next {:db/id #edb/ref 17592186125380}} {:db/id #edb/ref 17592186125380 :step/content {:db/id #edb/ref 17592186125776 :tutorial/content "Now consider the graph of the quadric surface\n\n$$\nz = x^2 -y^2\n$$\n\nwhose graph is shown below.\n\n![](images/5f/5f02c207742c737d00cdeabbd2cbba93a88a42521c41a2cc1e9f19d27ff55f20.png)\n\n \n\nThis surface is an example of a **hyperbolic paraboloid** whose **saddle point** is at the origin.\n\nMore generally, a hyperbolic paraboloid whose saddle point is at $(x_0,y_0,z_0)$ has the general equation\n\n$$\nz - z_0 = \\dfrac{(x-x_0)^2}{a^2}- \\dfrac{(y-y_0)^2}{b^2}\n$$\n\nwhere $a$ and $b$ constants. \n\nThis surface is called *hyperbolic* *paraboloid* because its traces in the $xy$-plane are *hyperbolas*, while its traces in the $yz$- and $xz$-planes are *parabolas*. We'll discuss the traces of this surface in more detail shortly.\n\nAnother property is that this surface mirrors itself across the planes $x=0$ and $y=0.$ Since these planes meet along the $z$-axis, that axis serves as the **axis of symmetry** of the hyperbolic paraboloid." :tutorial/id #uuid "15370709-5e87-5dcb-8a1f-ff66b0bf86e0" :tutorial/math-academy-id 3442 :tutorial/title "Hyperbolic Paraboloids"} :step/id #uuid "68121b3e-5396-564e-baa5-4f10972910c1" :step/math-academy-id 19465 :step/next {:db/id #edb/ref 17592186125381}} {:db/id #edb/ref 17592186125381 :step/content {:db/id #edb/ref 17592186124505 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124314 :question/id #uuid "7e876c7b-849f-59ce-a654-881ec9464475" :question/math-academy-id "e-5269"} :knowledge-point/id #uuid "e9078ab1-37a4-5e96-ae12-a83d5cd8804e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048866} {:db/id #edb/ref 17592186051028}] :knowledge-point/questions [{:db/id #edb/ref 17592186124891} {:db/id #edb/ref 17592186124898} {:db/id #edb/ref 17592186284459} {:db/id #edb/ref 17592186284461} {:db/id #edb/ref 17592186339086} {:db/id #edb/ref 17592186339087} {:db/id #edb/ref 17592186339088} {:db/id #edb/ref 17592186342098} {:db/id #edb/ref 17592186342099} {:db/id #edb/ref 17592186366233} {:db/id #edb/ref 17592186382249} {:db/id #edb/ref 17592186525044}] :knowledge-point/title "Identifying Properties of a Hyperbolic Paraboloid"} :step/id #uuid "74d8bc9d-43f4-50df-82fd-204384b7d677" :step/math-academy-id 19466 :step/next {:db/id #edb/ref 17592186125461}} {:db/id #edb/ref 17592186125460 :step/content {:db/id #edb/ref 17592186124556 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124365 :question/id #uuid "5ce5b329-ac5d-5581-b396-eadd569b9bec" :question/math-academy-id "e-6087"} :knowledge-point/id #uuid "dff86a8b-7966-53f7-a7bc-287990fb611d" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049118} {:db/id #edb/ref 17592186049699}] :knowledge-point/questions [{:db/id #edb/ref 17592186124897} {:db/id #edb/ref 17592186124923} {:db/id #edb/ref 17592186284464} {:db/id #edb/ref 17592186284465} {:db/id #edb/ref 17592186323729} {:db/id #edb/ref 17592186323730} {:db/id #edb/ref 17592186381910} {:db/id #edb/ref 17592186381935} {:db/id #edb/ref 17592186402441} {:db/id #edb/ref 17592186402475} {:db/id #edb/ref 17592186418046} {:db/id #edb/ref 17592186508116}] :knowledge-point/title "Finding Traces of Paraboloids"} :step/id #uuid "d6a4a4b3-6632-5593-890e-334f7d6d897e" :step/math-academy-id 22414} {:db/id #edb/ref 17592186125461 :step/content {:db/id #edb/ref 17592186125805 :tutorial/content "So far, we've encountered elliptic paraboloids whose axes of symmetry are parallel to the $z$-axis. \nLet's now consider the cases when an elliptic paraboloid is oriented along the $x$- or the $y$-axes.\n\nFor an elliptic paraboloid, the other two cases are as follows.\n\n- When the vertex is at the origin and the $y$ term is linear, the axis of symmetry is the $y$-axis:\n\n$$\ny = \\dfrac{x^2}{a^2} + \\dfrac{z^2}{c^2}\n$$\n\n![](images/da/da37415ddd27764a719fecc5780ee91e6e8ad3f5ce877101b81d1a955c57eb6f.png)\n\n- When the vertex is at the origin and the $x$ term is linear, the axis of symmetry is the $x$-axis:\n\n$$\nx = \\dfrac{y^2}{b^2} + \\dfrac{z^2}{c^2}\n$$\n\n![](images/d1/d1488d9f4767312795a84ce6441f64dd567223d1de4da66adbd6e39de9612a53.png)\n\nLikewise, for a hyperbolic paraboloid, the other two cases are as follows:\n\n- When the saddle point is at the origin and the $y$ term is linear, the axis of symmetry is the $y$-axis. The two corresponding equations are\n\n$$\ny = \\dfrac{x^2}{a^2} - \\dfrac{z^2}{c^2}\n\\qquad\\text{and}\\qquad\ny = \\dfrac{z^2}{c^2} - \\dfrac{x^2}{a^2}.\n$$\n\n- When the saddle point is at the origin and the $x$ term is linear, the axis of symmetry is the $x$-axis. The two corresponding equations are\n\n$$\nx = \\dfrac{z^2}{c^2} - \\dfrac{y^2}{b^2}\n\\qquad\\text{and}\\qquad\nx = \\dfrac{y^2}{b^2} - \\dfrac{z^2}{c^2}.\n$$" :tutorial/id #uuid "7f53539f-e8db-5205-b9d0-3919805097ae" :tutorial/math-academy-id 3851 :tutorial/title "Alternative Orientations of the Axis of Symmetry"} :step/id #uuid "26ce593b-6eaa-5a9c-a0cc-f0cf3649224d" :step/math-academy-id 22415 :step/next {:db/id #edb/ref 17592186125638}} {:db/id #edb/ref 17592186125638 :step/content {:db/id #edb/ref 17592186125880 :tutorial/content "The traces of an elliptic paraboloid are either ellipses, parabolas, a single point, or the empty set.\n\nFor example, let's find the traces with the coordinate planes for the elliptic paraboloid given by\n\n$$\nz=x^2+y^2.\n$$\n\n- The trace of this surface in the $xy$-plane (when $z=0$) is given by the equation\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & =0,\\end{aligned}\n$$\n\nwhich corresponds to the origin $(0,0,0).$\n\n![](images/02/021dd988863021f564a0e85fb3db93030740059f2a50ade6504b3e12a5665372.png)\n\n \n\n- The trace of this surface in the $xz$-plane (when $y=0$) is given by the equation\n\n$$\n\\begin{aligned}{x}^{2}+{0}^{2} & =z \\\\ {x}^{2} & =z,\\end{aligned}\n$$\n\nwhich is a parabola in the $xz$-plane that has its vertex at the origin.\n\n![](images/9f/9f6cd0703b5d7b2458cbfd688d91f08a79752fa1ccd3616e5975f5c017aa7b42.png)\n\n \n\n- The trace of this surface in the $yz$-plane (when $x=0$) is given by the equation\n\n$$\n\\begin{aligned}{0}^{2}+{y}^{2} & =z \\\\ {y}^{2} & =z,\\end{aligned}\n$$\n\nwhich is a parabola in the $yz$-plane that has its vertex at the origin.\n\n![](images/89/89be283ed121d3e30b1913e4412b8d3556ed611ef2a9a9bfd686d0594409f5c9.png)\n\nThere are a few other cases we should note:\n\n- The trace of our surface with the plane $z=-k$ for $k > 0$ is the empty set. This is because $z\\geq 0$ everywhere on the elliptic paraboloid.\n\n- The trace of our surface with the plane $z=k$ for $k > 0$ is an ellipse:\n\n$$\nx^2+y^2 = k\n$$\n\n![](images/f1/f15e925431b0d2ccfd4afa703cad1bcb37b65a75e96fbeabcf4823703bf184e5.png)" :tutorial/id #uuid "0ea2e49f-f5aa-57b1-9b67-de6947a0e6e5" :tutorial/math-academy-id 7839 :tutorial/title "Traces of Elliptic Paraboloids"} :step/id #uuid "587634e3-d3a5-57e5-bd78-93b3ed921e5b" :step/math-academy-id 45282 :step/next {:db/id #edb/ref 17592186125639}} {:db/id #edb/ref 17592186125639 :step/content {:db/id #edb/ref 17592186125881 :tutorial/content "The traces of a hyperbolic paraboloid are either hyperbolas, parabolas, or intersecting lines.\n\nFor example, let's find the traces with the coordinate planes for the hyperbolic paraboloid given by\n\n$$\nz=x^2-y^2.\n$$\n\n- The trace of this surface in the $xy$-plane (when $z=0$) is given by the equation\n\n$$\n\\begin{aligned}{x}^{2}-{y}^{2} & =0 \\\\ {y}^{2} & ={x}^{2} \\\\ y & =\\pm x\\end{aligned}\n$$\n\nwhich corresponds to two intersecting lines in the $xy$-plane.\n\n![](images/9b/9b3fbb9d8945c5d9208a59d404e489e4a339082c602c18154010e3e53083b220.png)\n\n \n\n- The trace of this surface in the $xz$-plane (when $y=0$) is given by the equation\n\n$$\n\\begin{aligned}{x}^{2}-{0}^{2} & =z \\\\ z & ={x}^{2},\\end{aligned}\n$$\n\nwhich corresponds to the parabola in the $xz$-plane that has its vertex at the origin.\n\n![](images/e8/e8e2b6306052e781fd149e4eebb04da79eddb44b5261b05b129f208ad523b70b.png)\n\n \n\n- The trace of this surface in the $yz$-plane (when $x=0$) is given by the equation\n\n$$\n\\begin{aligned}{0}^{2}-{y}^{2} & =z \\\\ z & =-{y}^{2},\\end{aligned}\n$$\n\nwhich corresponds to the parabola in the $yz$-plane that has its vertex at the origin.\n\n![](images/70/7010e4c26af60c6c27f66c93b805a2bac1e191c1646b5aac3a77f5dd3dadc64f.png)\n\n \n\nIn this particular case, the **saddle point** is at the origin. It is a minimum point for the trace in the $xz$-plane but a maximum point for the trace in the $yz$-plane.\n\nFinally, note that the trace of our surface with the plane $z=k\\neq 0$ is a hyperbola:\n\n$$\nx^2-y^2 = k\n$$\n\n![](images/b9/b9c1baab2f9d85c2c415cae91908d5c908aa0b1cef1eb8b5901f7f3b78bf66b2.png)" :tutorial/id #uuid "c2467f92-856a-5690-bd8d-1c593268396a" :tutorial/math-academy-id 7840 :tutorial/title "Traces of Hyperbolic Paraboloids"} :step/id #uuid "d9e46e54-59aa-5284-ac11-65d16e6bca74" :step/math-academy-id 45283 :step/next {:db/id #edb/ref 17592186125460}}] :activity/title "Paraboloids" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186124696}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186418049} :activity/id #uuid "58642185-16fa-5318-8c89-f9d4ccf0c829" :activity/scope {:db/id #edb/ref 17592186048510 :topic/id #uuid "a58e9ae3-7402-5272-b80f-f01ca3bb8c44" :topic/math-academy-id 1893} :activity/steps [{:db/id #edb/ref 17592186418047 :step/content {:db/id #edb/ref 17592186284465 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "297fea90-37a9-5380-b47a-81c1e6d84465" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\sqrt{3}$ and $1$" :db/id #edb/ref 17592186282051} {:answer/id #uuid "3704ecec-4aab-5a7a-bf09-0c5c3fc66880" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$2\\sqrt{2}$ and $1$" :db/id #edb/ref 17592186282178} {:answer/id #uuid "8c4ec860-b6b0-5930-9174-508c8b04299f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$9$ and $4$" :db/id #edb/ref 17592186282903} {:answer/id #uuid "8dd3abf6-da14-5f2d-a3c4-85c8c1e8823a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\sqrt{3}$ and $\\sqrt{2}$" :db/id #edb/ref 17592186282918} {:answer/id #uuid "ccccbae0-09b3-5285-928f-468dfef6fcee" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$3$ and $2$" :db/id #edb/ref 17592186283478}] :answer-field/correct {:db/id #edb/ref 17592186282918} :answer-field/id #uuid "858af6d8-4d33-5e09-9265-e6425c3e36a2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186284161}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c4fbc092-8a05-5e53-ba3e-bf69c3dd36b6" :question/math-academy-id "q-164282" :question/problem "The projection of the intersection between the elliptic paraboloid $4(x-5)^{2}+6(y+4)^{2}=z+8$ and the plane \n$z=4$  onto the $xy$-plane is an ellipse. What are the lengths of the semi-axes of the ellipse?" :question/worked-solution "To find the intersection of the paraboloid and the plane $z=4$, we substitute $z=4$ into the equation of the paraboloid, and simplify:\n\n$$\n\\begin{aligned}4(x-5)^{2}+6(y+4)^{2}=z+8 \\\\ 4(x-5)^{2}+6(y+4)^{2}=4+8 \\\\ 4(x-5)^{2}+6(y+4)^{2}=12 \\\\ \\frac{(x-5)^{2}}{3}+\\frac{(y+4)^{2}}{2} & =1 \\\\ \\frac{(x-5)^{2}}{(\\sqrt{3})^{2}}+\\frac{(y+4)^{2}}{(\\sqrt{2})^{2}} & =1\\end{aligned}\n$$\n\nThis gives us the equation of an ellipse with semi-axes of lengths $\\sqrt{3}$ and $\\sqrt{2}.$"} :step/id #uuid "af8eee1b-35b6-51ee-8480-e799f2ebb8d2"} {:db/id #edb/ref 17592186418048 :step/content {:db/id #edb/ref 17592186339088 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c67b3b1-ca17-50d9-826b-aa84c548da4d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(-7,0,0)$ and $(1,0,0)$" :db/id #edb/ref 17592186336743} {:answer/id #uuid "767a3d83-a217-545e-829c-803f0a2e5f93" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(1,0,0)" :db/id #edb/ref 17592186337098} {:answer/id #uuid "7d9dcfbc-5db8-52dc-aa70-3ce3548a031a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(-7,0,0)$ and $(-1,0,0)$" :db/id #edb/ref 17592186337168} {:answer/id #uuid "cd3c3792-dfb7-53e4-8d4f-f13a6930b54d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(-7,0,0)$ only" :db/id #edb/ref 17592186337832} {:answer/id #uuid "fb10441f-5dc2-53c4-8a56-253eb94e9ba8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(-1,0,0)$ and $(7,0,0)$" :db/id #edb/ref 17592186338235}] :answer-field/correct {:db/id #edb/ref 17592186336743} :answer-field/id #uuid "5a0d88c8-d602-5247-ade9-89205172c789" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186338432}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0b363aae-9a1a-5bd8-a7ce-6affaf56df43" :question/math-academy-id "q-72305" :question/problem "Given the hyperbolic paraboloid $(x+3)^{2}-2(y-3)^{2}=z-2$, find its intercepts with the $x$-axis." :question/worked-solution "To find the $x$-intercepts of the paraboloid, we substitute $y=0$ and $z=0$ in the equation of the paraboloid:\n\n$$\n\\begin{aligned}(x+3)^{2}-2(0-3)^{2} & =0-2 \\\\ (x+3)^{2}-18 & =-2 \\\\ (x+3)^{2} & =16 \\\\ x+3 & =\\pm 4 \\\\ x & =-3\\pm 4\\end{aligned}\n$$\n\nThis gives the solutions $x=-7$ and $x=1.$\n\nTherefore, the intercepts with the $x$-axis are $(-7,0,0)$ and $(1,0,0).$"} :step/id #uuid "b0e9f4df-c7d1-5c3e-9d66-792c898f4bac" :step/next {:db/id #edb/ref 17592186418047}} {:db/id #edb/ref 17592186418049 :step/content {:db/id #edb/ref 17592186418046 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "019726e7-4913-502a-a919-de71561128cf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\sqrt{3}$ and $\\sqrt{2}$" :db/id #edb/ref 17592186418040} {:answer/id #uuid "31103cb3-8db8-5966-8f8f-150d81076c20" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$3$ and $4$" :db/id #edb/ref 17592186418041} {:answer/id #uuid "3a2b823c-f5c0-585b-b3ff-0eec4bcfc2e2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\sqrt{3}$ and $2$" :db/id #edb/ref 17592186418042} {:answer/id #uuid "9e786335-093c-5020-9d1b-5216151e0ab3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$3$ and $2$" :db/id #edb/ref 17592186418043} {:answer/id #uuid "ce083963-6a81-5daf-90c1-ac994c70d5be" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\sqrt{3}$ and $4$" :db/id #edb/ref 17592186418044}] :answer-field/correct {:db/id #edb/ref 17592186418042} :answer-field/id #uuid "8a4ae1c8-63c4-5962-bc3f-7d5f1634e01e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186418045}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5ea54c52-c613-575d-9b4a-ae98c73f35ea" :question/math-academy-id "q-35926" :question/problem "The projection of the intersection between the hyperbolic paraboloid $12z=4(x+2)^{2}-3{y}^{2}$ and the plane \n$z=1$  onto the $xy$-plane is a hyperbola. What are the lengths of the semi-axes of the hyperbola?" :question/worked-solution "To find the intersection of the paraboloid and the plane $z=1$, we substitute $z=1$ into the equation of the paraboloid, and simplify:\n\n$$\n\\begin{aligned}12z & =4(x+2)^{2}-3{y}^{2} \\\\ 12(1) & =4(x+2)^{2}-3{y}^{2} \\\\ 12 & =4(x+2)^{2}-3{y}^{2} \\\\ 1 & =\\frac{(x+2)^{2}}{3}-\\frac{{y}^{2}}{4} \\\\ 1 & =\\frac{(x+2)^{2}}{(\\sqrt{3})^{2}}-\\frac{{y}^{2}}{{2}^{2}}\\end{aligned}\n$$\n\nThis gives us the equation of a hyperbola with semi-axes of lengths $\\sqrt{3}$ and $2.$"} :step/id #uuid "bbc73c40-2938-59e4-adf6-e2670e949f1e" :step/next {:db/id #edb/ref 17592186418051}} {:db/id #edb/ref 17592186418050 :step/content {:db/id #edb/ref 17592186366233 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7b4441e7-9ebc-5545-9efa-2ee1440fa1b2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(0,0,0)$ and $(0,4,0)$" :db/id #edb/ref 17592186366235} {:answer/id #uuid "6bc6b114-2ad4-5286-98ef-bab6af5d1a58" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,0,0)" :db/id #edb/ref 17592186366236} {:answer/id #uuid "2b746e61-be9d-59cb-8bf8-3b68b34626f3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(0,-4,0)$ and $(0,0,0)$" :db/id #edb/ref 17592186366237} {:answer/id #uuid "e590b348-2055-5203-8c91-c618c41626da" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(0,-4,0)$ only" :db/id #edb/ref 17592186366238} {:answer/id #uuid "84bf4e2c-448d-5b40-8003-6a09149d5ddd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(0,-2,0)$ and $(0,0,0)$" :db/id #edb/ref 17592186366239}] :answer-field/correct {:db/id #edb/ref 17592186366237} :answer-field/id #uuid "98778e41-d388-55c7-822d-6a1e70584ae6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186366234}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "16658c9e-8fa3-5c30-87d5-30c0a6e7db83" :question/math-academy-id "q-72302" :question/problem "Given the hyperbolic paraboloid $(x-6)^{2}-8(y+2)^{2}=z+4$, find its intercepts with the $y$-axis." :question/worked-solution "To find the $y$-intercepts of the paraboloid, we substitute $x=0$ and $z=0$ in the equation of the paraboloid:\n\n$$\n\\begin{aligned}(0-6)^{2}-8(y+2)^{2} & =0+4 \\\\ 36-8(y+2)^{2} & =4 \\\\ 32 & =8(y+2)^{2} \\\\ (y+2)^{2} & =4 \\\\ y+2 & =\\pm 2 \\\\ y & =-2\\pm 2\\end{aligned}\n$$\n\nThis gives the solutions $y=-4$ and $y=0.$\n\nTherefore, the intercepts with the $y$-axis are $(0,-4,0)$ and $(0,0,0).$"} :step/id #uuid "c8e375d5-a259-54e0-ae9f-f99977167c51" :step/next {:db/id #edb/ref 17592186418048}} {:db/id #edb/ref 17592186418051 :step/content {:db/id #edb/ref 17592186323729 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "205d1a65-04f6-59a3-a974-5b778afaa91e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(0,0)$ in the $xy$-plane" :db/id #edb/ref 17592186321391} {:answer/id #uuid "4dcfa493-b877-5976-8c32-70d3d57ac828" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(-2,3)$ in the $xy$-plane" :db/id #edb/ref 17592186321760} {:answer/id #uuid "5f6e9f3f-adaa-5df3-bb70-cd9f70742907" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(-2,-3)$ in the $xy$-plane" :db/id #edb/ref 17592186321898} {:answer/id #uuid "e24be124-29de-5243-8c6e-8306d6f59e5b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(2,-3)$ in the $xy$-plane" :db/id #edb/ref 17592186322915} {:answer/id #uuid "eccdcbac-973f-5f39-80bc-76abea742d02" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(2,3)$ in the $xy$-plane" :db/id #edb/ref 17592186323016}] :answer-field/correct {:db/id #edb/ref 17592186321898} :answer-field/id #uuid "e2f3b7e6-356f-5e12-ac50-e4c8413a78be" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186323618}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "04c0f5ae-99dd-5b51-8d08-843351e49a3d" :question/math-academy-id "q-35930" :question/problem "The projection of the intersection between the elliptic paraboloid $5(x+2)^{2}+3(y+3)^{2}=z$ and the plane $z=2$  onto the $xy$-plane is an ellipse. Find the center of this ellipse." :question/worked-solution "To find the intersection of the paraboloid and the plane $z=2$, we substitute $z=2$ into the equation of the paraboloid, and simplify:\n\n$$\n\\begin{aligned}5(x+2)^{2}+3(y+3)^{2} & =z \\\\ 5(x+2)^{2}+3(y+3)^{2} & =2 \\\\ \\frac{(x+2)^{2}}{2/5}+\\frac{(y+3)^{2}}{2/3} & =1\\end{aligned}\n$$\n\nThis gives us the equation of an ellipse in the $xy$-plane that has its center at $(-2,-3).$"} :step/id #uuid "f747c054-c600-575d-8af5-3ac0554fc78c" :step/next {:db/id #edb/ref 17592186418050}}] :activity/title "Paraboloids" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186418039}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186525128} :activity/id #uuid "391423b8-8e38-5e8d-89bc-42780e5b8cc3" :activity/scope {:db/id #edb/ref 17592186048510 :topic/id #uuid "a58e9ae3-7402-5272-b80f-f01ca3bb8c44" :topic/math-academy-id 1893} :activity/steps [{:db/id #edb/ref 17592186525074 :step/content {:db/id #edb/ref 17592186284461 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0775503d-b603-529a-9cc7-104772d13fc0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(7,0,0)$ only" :db/id #edb/ref 17592186281756} {:answer/id #uuid "3938f9bf-b9b1-50d8-9803-8ddddd2d20f4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(5,0,0)$ only" :db/id #edb/ref 17592186282193} {:answer/id #uuid "be42c312-a9b8-592e-b8f0-129f5c3797cc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(-3,0,0)$ and $(2,0,0)$" :db/id #edb/ref 17592186283342} {:answer/id #uuid "cc606197-6d13-5b13-b0dd-1767448acef7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(-2,0,0)$ and $(2,0,0)$" :db/id #edb/ref 17592186283475} {:answer/id #uuid "ff00bc5a-be90-58c4-a32d-54ae93a95ef2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(3,0,0)$ and $(7,0,0)$" :db/id #edb/ref 17592186283928}] :answer-field/correct {:db/id #edb/ref 17592186283928} :answer-field/id #uuid "b21dfeaa-7f24-50eb-ab46-ba0b9a81c643" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186284243}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1c4e75ca-d0de-5c84-afaa-4eb1e04c61e1" :question/math-academy-id "q-164276" :question/problem "Given the hyperbolic paraboloid $2(x-5)^{2}-3(y-1)^{2}=z+5$, find its intercepts with the $x$-axis." :question/worked-solution "To find the $x$-intercepts of the paraboloid, we substitute $y=0$ and $z=0$ in the equation of the paraboloid:\n\n$$\n\\begin{aligned}2(x-5)^{2}-3(0-1)^{2} & =0+5 \\\\ 2(x-5)^{2}-3 & =5 \\\\ 2(x-5)^{2} & =8 \\\\ (x-5)^{2} & =4 \\\\ x-5 & =\\pm 2 \\\\ x & =5\\pm 2\\end{aligned}\n$$\n\nThis gives the solutions $x=3$ and $x=7.$\n\nTherefore, the intercepts with the $x$-axis are $(3,0,0)$ and $(7,0,0).$"} :step/id #uuid "170e1b48-2597-50cf-8dee-08d57238b8da" :step/next {:db/id #edb/ref 17592186525102}} {:db/id #edb/ref 17592186525082 :step/content {:db/id #edb/ref 17592186342099 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05979749-7b02-5737-b992-42c5ea07512a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,-9,-8)" :db/id #edb/ref 17592186339172} {:answer/id #uuid "1641bc5f-b110-54e8-947e-34361a794b87" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,-3,8)" :db/id #edb/ref 17592186339323} {:answer/id #uuid "cd01c16b-8ca9-5b1a-a5a7-d4a8818eb3a9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,-3,-8)" :db/id #edb/ref 17592186340944} {:answer/id #uuid "ec7ba85c-1bcf-578b-9307-8f32f0c08777" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(1,-9,-8)" :db/id #edb/ref 17592186341212} {:answer/id #uuid "f5a8447f-a95f-5391-a5d5-d3b1963e5621" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(1,9,8)" :db/id #edb/ref 17592186341295}] :answer-field/correct {:db/id #edb/ref 17592186339172} :answer-field/id #uuid "3e6eedd1-e02a-5ecb-a97b-b5bd45ee9bcc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341489}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "60f0667a-58e4-5e3e-ac71-292417e67feb" :question/math-academy-id "q-73864" :question/problem "Find the saddle point of the hyperbolic paraboloid $z+8={x}^{2}-(y+9)^{2}.$" :question/worked-solution "The general equation of a hyperbolic paraboloid with a saddle point at $({x}_{0},{y}_{0},{z}_{0})$ is \n\n$$\nz-{z}_{0}=\\frac{(x-{x}_{0})^{2}}{{a}^{2}}-\\frac{(y-{y}_{0})^{2}}{{b}^{2}}.\n$$\n\nTo find the saddle point, we rewrite our equation as follows:\n\n$$\n\\begin{aligned}z+8 & ={x}^{2}-(y+9)^{2} \\\\ z-(-8) & =\\frac{(x-0)^{2}}{1}-\\frac{(y-(-9))^{2}}{1}\\end{aligned}\n$$\n\nThis gives us the equation of a hyperbolic paraboloid with a saddle point at $(0,-9,-8).$"} :step/id #uuid "2c17976b-4b0a-57a1-bc65-e6a517f58326" :step/next {:db/id #edb/ref 17592186525074}} {:db/id #edb/ref 17592186525102 :step/content {:db/id #edb/ref 17592186284465 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "297fea90-37a9-5380-b47a-81c1e6d84465" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\sqrt{3}$ and $1$" :db/id #edb/ref 17592186282051} {:answer/id #uuid "3704ecec-4aab-5a7a-bf09-0c5c3fc66880" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$2\\sqrt{2}$ and $1$" :db/id #edb/ref 17592186282178} {:answer/id #uuid "8c4ec860-b6b0-5930-9174-508c8b04299f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$9$ and $4$" :db/id #edb/ref 17592186282903} {:answer/id #uuid "8dd3abf6-da14-5f2d-a3c4-85c8c1e8823a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\sqrt{3}$ and $\\sqrt{2}$" :db/id #edb/ref 17592186282918} {:answer/id #uuid "ccccbae0-09b3-5285-928f-468dfef6fcee" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$3$ and $2$" :db/id #edb/ref 17592186283478}] :answer-field/correct {:db/id #edb/ref 17592186282918} :answer-field/id #uuid "858af6d8-4d33-5e09-9265-e6425c3e36a2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186284161}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c4fbc092-8a05-5e53-ba3e-bf69c3dd36b6" :question/math-academy-id "q-164282" :question/problem "The projection of the intersection between the elliptic paraboloid $4(x-5)^{2}+6(y+4)^{2}=z+8$ and the plane \n$z=4$  onto the $xy$-plane is an ellipse. What are the lengths of the semi-axes of the ellipse?" :question/worked-solution "To find the intersection of the paraboloid and the plane $z=4$, we substitute $z=4$ into the equation of the paraboloid, and simplify:\n\n$$\n\\begin{aligned}4(x-5)^{2}+6(y+4)^{2}=z+8 \\\\ 4(x-5)^{2}+6(y+4)^{2}=4+8 \\\\ 4(x-5)^{2}+6(y+4)^{2}=12 \\\\ \\frac{(x-5)^{2}}{3}+\\frac{(y+4)^{2}}{2} & =1 \\\\ \\frac{(x-5)^{2}}{(\\sqrt{3})^{2}}+\\frac{(y+4)^{2}}{(\\sqrt{2})^{2}} & =1\\end{aligned}\n$$\n\nThis gives us the equation of an ellipse with semi-axes of lengths $\\sqrt{3}$ and $\\sqrt{2}.$"} :step/id #uuid "6e69c83b-f889-52ac-b9ce-28e3b44e9656"} {:db/id #edb/ref 17592186525128 :step/content {:db/id #edb/ref 17592186381910 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7e1b2516-5b9d-54b2-9786-41329153ae8c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(3,0)$ in the $xy$-plane" :db/id #edb/ref 17592186381912} {:answer/id #uuid "d1813045-0bb5-53cf-8edc-34c167bfd332" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(0,3)$ in the $xy$-plane" :db/id #edb/ref 17592186381913} {:answer/id #uuid "04b2f73e-e03c-565b-8715-7ef4230fb83d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(0,0)$ in the $xy$-plane" :db/id #edb/ref 17592186381914} {:answer/id #uuid "c4e25ada-9587-5c88-95f7-c2125d31bd32" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(-3,0)$ in the $xy$-plane" :db/id #edb/ref 17592186381915} {:answer/id #uuid "0c60e3a9-dbfb-5ffa-a938-398f77fd1216" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(0,-3)$ in the $xy$-plane" :db/id #edb/ref 17592186381916}] :answer-field/correct {:db/id #edb/ref 17592186381916} :answer-field/id #uuid "8b417048-4247-5915-bf66-26eaced21af1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186381911}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7cda8e94-4e6a-5db6-8cda-91d1dbc62834" :question/math-academy-id "q-35702" :question/problem "The projection of the intersection between the hyperbolic paraboloid $z=-9{x}^{2}+(y+3)^{2}$, and the plane $z=4$ onto the $xy$-plane is a hyperbola. Find the center of this hyperbola." :question/worked-solution "To find the intersection of the paraboloid and the plane $z=4$, we substitute $z=4$ into the equation of the paraboloid, and simplify:\n\n$$\n\\begin{aligned}-9{x}^{2}+(y+3)^{2} & =z \\\\ -9{x}^{2}+(y+3)^{2} & =4 \\\\ -\\frac{9{x}^{2}}{4}+\\frac{(y+3)^{2}}{4} & =1 \\\\ -\\frac{{x}^{2}}{4/9}+\\frac{(y+3)^{2}}{4} & =1\\end{aligned}\n$$\n\nThis gives us the equation of a hyperbola in the $xy$-plane that has its center at $(0,-3).$"} :step/id #uuid "c7546549-9970-5f28-9b36-0561773b63db" :step/next {:db/id #edb/ref 17592186525134}} {:db/id #edb/ref 17592186525134 :step/content {:db/id #edb/ref 17592186525044 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27aec271-8375-514d-93f8-b0fd659cac22" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(0,1,0)$ only" :db/id #edb/ref 17592186524456} {:answer/id #uuid "c76196c7-5bd8-564e-ab0c-1aa19bb1b301" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(0,13,0)$ only" :db/id #edb/ref 17592186524704} {:answer/id #uuid "daa884be-dd4f-502c-ad7e-8f18e4feeeb2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(0,-15,0)$ and $(0,13,0)$" :db/id #edb/ref 17592186524748} {:answer/id #uuid "df704459-6416-5914-ac68-faa71d081a15" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(0,1,0)$ and $(0,3,0)$" :db/id #edb/ref 17592186524766} {:answer/id #uuid "ea74f780-c5a4-51a5-8a9e-88c3509c0e76" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(0,-15,0)$ only" :db/id #edb/ref 17592186524795}] :answer-field/correct {:db/id #edb/ref 17592186524748} :answer-field/id #uuid "3925c411-60a1-5817-a407-541f7c2a0413" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186524865}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cb8dda76-cb23-5b23-b067-bd505ebd9a72" :question/math-academy-id "q-73861" :question/problem "Given the hyperbolic paraboloid $(x-4)^{2}-\\frac{(y+1)^{2}}{7}=z-12$, find its intercepts with the $y$-axis." :question/worked-solution "To find the $y$-intercepts of the paraboloid, we substitute $x=0$ and $z=0$ in the equation of the paraboloid:\n\n$$\n\\begin{aligned}(0-4)^{2}-\\frac{(y+1)^{2}}{7} & =0-12 \\\\ 16-\\frac{(y+1)^{2}}{7} & =-12 \\\\ \\frac{(y+1)^{2}}{7} & =28 \\\\ (y+1)^{2} & =196 \\\\ y+1 & =\\pm 14 \\\\ y & =-1\\pm 14\\end{aligned}\n$$\n\nThis gives the solutions $y=-15$ and $y=13.$\n\nTherefore, the intercepts with the $y$-axis are $(0,-15,0)$ and $(0,13,0).$"} :step/id #uuid "dc262a63-5e8d-5514-8ffc-08ac56ed1b39" :step/next {:db/id #edb/ref 17592186525082}}] :activity/title "Paraboloids" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186524365}]}
