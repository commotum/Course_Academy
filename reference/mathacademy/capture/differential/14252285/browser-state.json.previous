mstyle mathcolor=\"blue\"><mn>0</mn></mstyle></mrow></mtd></mtr><mtr><mtd><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"red\"><mn>113</mn></mstyle></mrow></mtd><mtd><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"red\"><mn>210</mn></mstyle></mrow></mtd><mtd><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"red\"><mn>198</mn></mstyle></mrow></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">|</mo></mrow></mtd><mtd><mi></mi><mo>=</mo><mn>0</mn><mo>+</mo><mn>1</mn><mo stretchy=\"false\">(</mo><mo>−</mo><mn>1</mn><msup><mo stretchy=\"false\">)</mo><mrow data-mjx-texclass=\"ORD\"><mn>2</mn><mo>+</mo><mn>1</mn></mrow></msup><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">|</mo><mtable columnalign=\"center\" columnspacing=\"1em\" rowspacing=\"4pt\"><mtr><mtd><mn>4</mn></mtd><mtd><mn>2</mn></mtd></mtr><mtr><mtd><mn>210</mn></mtd><mtd><mn>198</mn></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">|</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mo stretchy=\"false\">(</mo><mn>4</mn><mo>⋅</mo><mn>198</mn><mo>−</mo><mn>2</mn><mo>⋅</mo><mn>210</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mo stretchy=\"false\">(</mo><mn>792</mn><mo>−</mo><mn>420</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mn>372</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container> </p>\n</div></div>",
