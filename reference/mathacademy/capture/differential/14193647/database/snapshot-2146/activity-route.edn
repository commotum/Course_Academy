#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186508148} :activity/id #uuid "3d4cf227-5451-5675-a3d0-310e1e202b0c" :activity/scope {:db/id #edb/ref 17592186048747 :topic/id #uuid "bac6604a-5262-5144-8ceb-19f17d508317" :topic/math-academy-id 2987} :activity/steps [{:db/id #edb/ref 17592186508118 :step/content {:db/id #edb/ref 17592186434426 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d8146a1-89ab-5805-b0d1-3cb41fad7d9b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{e}^{8}-1}{8}" :db/id #edb/ref 17592186434401} {:answer/id #uuid "77b5e97e-bc6c-5d70-b0ab-61c62f43eefe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{e}^{4}-1}{4}" :db/id #edb/ref 17592186434406} {:answer/id #uuid "b2c4a89b-c4d2-5db7-98e5-df1b9a18f200" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8e-1" :db/id #edb/ref 17592186434414} {:answer/id #uuid "bcd85839-7391-5b9a-80bf-f734af24df0a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{e}^{2}-1" :db/id #edb/ref 17592186434415} {:answer/id #uuid "c0834f80-0b5a-5af1-a67a-b29a8e35f4d8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{e}^{2}-1}{2}" :db/id #edb/ref 17592186434416}] :answer-field/correct {:db/id #edb/ref 17592186434401} :answer-field/id #uuid "29094946-ea57-508c-a265-54b76fd27fdf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186434422}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1a18a122-3ad0-51db-8855-5d861bdec3e8" :question/math-academy-id "q-152917" :question/problem "A continuous random variable $X$ has the probability density function \n\n$$\nf(x)=\\frac{1}{2x},\\,1\\le x\\le {e}^{2}.\n$$\n\nCalculate $\\text{E}[{X}^{4}].$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ the $n$th raw moment of $X$ is given by\n\n$$\n\\text{E}[{X}^{n}]={\\int }_{S}{x}^{n}\\cdot f(x)\\,\\text{d}x.\n$$\n\nSo, we compute the fourth raw moment of $X$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{4}] & ={\\int }_{1}^{{e}^{2}}{x}^{4}\\cdot \\frac{1}{2x}\\,\\text{d}x \\\\  & =\\frac{1}{2}{\\int }_{1}^{{e}^{2}}{x}^{3}\\,\\text{d}x \\\\  & =\\frac{1}{8}\\,{x}^{4}\\,{|}_{1}^{{e}^{2}} \\\\  & =\\frac{1}{8}({e}^{8}-1) \\\\  & =\\frac{{e}^{8}-1}{8}\\end{aligned}\n$$"} :step/id #uuid "0aef0e95-7b36-56cc-a917-a6909d024646"} {:db/id #edb/ref 17592186508137 :step/content {:db/id #edb/ref 17592186479115 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85e8f87d-a86b-5e5a-9b4c-520af1d67778" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186478767} {:answer/id #uuid "8a5de172-0879-5846-8775-50301538400b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186478775} {:answer/id #uuid "8c404e33-978f-5492-8afd-92388f08864c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{11}{8}" :db/id #edb/ref 17592186478781} {:answer/id #uuid "92a6058f-3718-55b4-83a2-afc873b42494" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{6}{5}" :db/id #edb/ref 17592186478797} {:answer/id #uuid "a7862d49-f18d-5362-98d3-095ce5b8964a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{13}{5}" :db/id #edb/ref 17592186478832}] :answer-field/correct {:db/id #edb/ref 17592186478832} :answer-field/id #uuid "63b35dd5-9730-5404-b881-f84b63c0e854" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186478998}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ac78b028-e0aa-5c92-b54a-b1ba1527a82f" :question/math-academy-id "q-152915" :question/problem "A continuous random variable $X$ has the probability density function \n\n$$\nf(x)=\\frac{1}{4}(1-x),\\,-2\\le x\\le 0.\n$$\n\nCalculate $\\text{E}[{X}^{3}].$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ the $n$th raw moment of $X$ is given by\n\n$$\n\\text{E}[{X}^{n}]={\\int }_{S}{x}^{n}\\cdot f(x)\\,\\text{d}x.\n$$\n\nSo, we compute the third raw moment of $X$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{3}] & ={\\int }_{-2}^{0}{x}^{3}\\cdot \\frac{1}{4}(1-x)\\,\\text{d}x \\\\  & =\\frac{1}{4}{\\int }_{-2}^{0}({x}^{3}-{x}^{4})\\text{d}x \\\\  & =\\frac{1}{4}(\\frac{1}{4}{x}^{4}-\\frac{1}{5}{x}^{5}){|}_{-2}^{0} \\\\  & =\\frac{1}{4}(0-[4+\\frac{32}{5}]) \\\\  & =\\frac{1}{4}(-\\frac{52}{5}) \\\\  & =-\\frac{13}{5}\\end{aligned}\n$$"} :step/id #uuid "62dbfd8d-d6c8-5022-be2b-1ea1fd60fadf" :step/next {:db/id #edb/ref 17592186508118}} {:db/id #edb/ref 17592186508141 :step/content {:db/id #edb/ref 17592186508093 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b2368f6-3f68-54b0-9d32-a27cbf3895be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{2}+e-2" :db/id #edb/ref 17592186507648} {:answer/id #uuid "b02c68e4-e61b-5654-9879-70de70a8fe6d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{2}-2e+3" :db/id #edb/ref 17592186507843} {:answer/id #uuid "b269375e-588f-5e5f-9ae9-591c8a3221c9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{e}^{2}-e" :db/id #edb/ref 17592186507845} {:answer/id #uuid "bfd68903-0ef9-5e2a-88ed-3677ac3ae07b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{2}-e" :db/id #edb/ref 17592186507864} {:answer/id #uuid "c01cb739-f7ab-5ebb-8e34-daf477537efd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{e}^{2}-5e+3" :db/id #edb/ref 17592186507865}] :answer-field/correct {:db/id #edb/ref 17592186507864} :answer-field/id #uuid "440eb13c-81c4-5c5d-9faa-611d1e590780" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186507967}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b8f3b4b6-eb37-510a-a5f6-48850ac9d684" :question/math-academy-id "q-131140" :question/problem "The continuous random variable $X$ has the following probability density function:\n\n$$\nf(x)=\\frac{1}{x},\\,1<x<e\n$$\n\nGiven that $\\text{E}[X]=e-1,$ compute $\\text{E}[2{X}^{2}-X].$\n\n*Hint: You may assume that $\\text{E}[aX+bY]=a\\text{E}[X]+b\\text{E}[Y]$ for any random variables $X$ and $Y$ and constants $a$ and $b.$*" :question/worked-solution "First, we simplify using the hint and the properties of expected value:\n\n$$\n\\text{E}[2{X}^{2}-X]=2\\text{E}[{X}^{2}]-\\text{E}[X]\n$$\n\nFor a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ the $n$th raw moment of $X$ is given by\n\n$$\n\\text{E}[{X}^{n}]={\\int }_{S}{x}^{n}\\cdot f(x)\\,\\text{d}x.\n$$\n\nWe already know $\\text{E}[X].$ So, we compute the second raw moment of $X$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{S}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{e}{x}^{2}\\cdot \\frac{1}{x}\\,\\text{d}x \\\\  & ={\\int }_{1}^{e}x\\,\\text{d}x \\\\  & ={\\frac{{x}^{2}}{2}\\,|}_{1}^{e} \\\\  & =\\frac{{e}^{2}-1}{2}\\end{aligned}\n$$\n\nSubstituting $\\text{E}[X]=e-1$ and $\\text{E}[{X}^{2}]=\\frac{{e}^{2}-1}{2}$ into the simplified expression, we conclude that\n\n$$\n\\begin{aligned}\\text{E}[2{X}^{2}-X] & =2\\text{E}[{X}^{2}]-\\text{E}[X] \\\\  & =2\\cdot \\frac{{e}^{2}-1}{2}-(e-1) \\\\  & ={e}^{2}-1-e+1 \\\\  & ={e}^{2}-e.\\end{aligned}\n$$"} :step/id #uuid "81573813-f419-5bab-b167-8255dfe1a85b" :step/next {:db/id #edb/ref 17592186508152}} {:db/id #edb/ref 17592186508148 :step/content {:db/id #edb/ref 17592186508043 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13ed44a6-241d-5838-9fc9-af9b6f83e61d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186507622} {:answer/id #uuid "1578c936-8ad1-508e-aa56-b4990c519451" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186507624} {:answer/id #uuid "67abf3a2-af43-5891-a4b8-887a1c46a81b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186507751} {:answer/id #uuid "7e517eaa-0474-52ae-938e-84dbfaa53de5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186507784} {:answer/id #uuid "8dda24db-7965-57a0-84c8-bf571ddd300c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186507800}] :answer-field/correct {:db/id #edb/ref 17592186507624} :answer-field/id #uuid "f5d3c470-c959-5590-9ddc-7ea57ee65776" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186508029}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "0cddfc6e-37ce-5b87-9aa0-8b3fda1d2938" :question/math-academy-id "q-90392" :question/problem "The continuous random variable $X$ has the following probability density function:\n\n$$\nf(x)=\\frac{3}{{x}^{4}},\\,x>1\n$$\n\nGiven that $\\text{E}[X]=\\frac{3}{2},$ compute $\\text{E}[{X}^{2}+2X-1].$\n\n*Hint: You may assume that $\\text{E}[aX+bY]=a\\text{E}[X]+b\\text{E}[Y]$ for any random variables $X$ and $Y$ and constants $a$ and $b.$*" :question/worked-solution "First, we simplify using the hint and the properties of expected value:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}+2X-1] & =\\text{E}[{X}^{2}]+2\\text{E}[X]-\\text{E}[1] \\\\  & =\\text{E}[{X}^{2}]+2\\text{E}[X]-1\\end{aligned}\n$$\n\nFor a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ the $n$th raw moment of $X$ is given by\n\n$$\n\\text{E}[{X}^{n}]={\\int }_{S}{x}^{n}\\cdot f(x)\\,\\text{d}x.\n$$\n\nWe already know $\\text{E}[X].$ So, we compute the second raw moment of $X$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{S}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }{x}^{2}\\cdot \\frac{3}{{x}^{4}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{3}{{x}^{2}}\\,\\text{d}x \\\\  & ={lim}_{a\\to \\infty }{\\int }_{1}^{a}\\frac{3}{{x}^{2}}\\,\\text{d}x \\\\  & ={lim}_{a\\to \\infty }{(-\\frac{3}{x})|}_{1}^{a} \\\\  & ={lim}_{a\\to \\infty }(3-\\frac{3}{a}) \\\\  & =3\\end{aligned}\n$$\n\nSubstituting $\\text{E}[X]=\\frac{3}{2}$ and $\\text{E}[{X}^{2}]=3$ into the simplified expression, we conclude that\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}+2X-1] & =\\text{E}[{X}^{2}]+2\\text{E}[X]-1 \\\\  & =3+2\\cdot \\frac{3}{2}-1 \\\\  & =3+3-1 \\\\  & =5.\\end{aligned}\n$$"} :step/id #uuid "a28c654f-55ef-5916-869c-70e534152c19" :step/next {:db/id #edb/ref 17592186508141}} {:db/id #edb/ref 17592186508152 :step/content {:db/id #edb/ref 17592186434427 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7b58a9e1-f2e5-5bab-86c3-1dc62a5bf1dc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186434407} {:answer/id #uuid "83994b5b-dec3-525b-9473-71abebd50a27" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186434408} {:answer/id #uuid "908f1924-a4cc-5cae-83ec-6a4c7872904f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186434410} {:answer/id #uuid "93d5d0a4-79ad-5a4d-854e-315f284a4eac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186434411} {:answer/id #uuid "a25f9bac-857f-5e6a-8fee-76b7ccf2820e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186434412}] :answer-field/correct {:db/id #edb/ref 17592186434408} :answer-field/id #uuid "9c9c34c2-a686-5dff-8116-1e613117e2fd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186434424}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cf5c8a43-29b3-589c-9d23-ef6cc2a81919" :question/math-academy-id "q-131142" :question/problem "The continuous random variable $X$ has the following probability density function:\n\n$$\nf(x)=\\frac{1}{2},\\,1<x<3\n$$\n\nGiven that $\\text{E}[X]=2,$ compute $\\text{E}[5X-3{X}^{2}].$\n\n*Hint: You may assume that $\\text{E}[aX+bY]=a\\text{E}[X]+b\\text{E}[Y]$ for any random variables $X$ and $Y$ and constants $a$ and $b.$*" :question/worked-solution "First, we simplify using the hint and the properties of expected value:\n\n$$\n\\text{E}[5X-3{X}^{2}]=5\\text{E}[X]-3\\text{E}[{X}^{2}]\n$$\n\nFor a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ the $n$th raw moment of $X$ is given by\n\n$$\n\\text{E}[{X}^{n}]={\\int }_{S}{x}^{n}\\cdot f(x)\\,\\text{d}x.\n$$\n\nWe already know $\\text{E}[X].$ So, we compute the second raw moment of $X$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{S}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{3}{x}^{2}\\cdot \\frac{1}{2}\\,\\text{d}x \\\\  & ={\\int }_{1}^{3}\\frac{{x}^{2}}{2}\\,\\text{d}x \\\\  & ={\\frac{{x}^{3}}{6}\\,|}_{1}^{3} \\\\  & =\\frac{13}{3}\\end{aligned}\n$$\n\nSubstituting $\\text{E}[X]=2$ and $\\text{E}[{X}^{2}]=\\frac{13}{3}$ into the simplified expression, we conclude that\n\n$$\n\\begin{aligned}\\text{E}[5X-3{X}^{2}] & =5\\text{E}[X]-3\\text{E}[{X}^{2}] \\\\  & =5\\cdot 2-3\\cdot \\frac{13}{3} \\\\  & =10-13 \\\\  & =-3.\\end{aligned}\n$$"} :step/id #uuid "b234828c-5807-5de4-a2a5-5f231ccf4ede" :step/next {:db/id #edb/ref 17592186508137}}] :activity/title "Moments of Continuous Random Variables" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186507600}]}
