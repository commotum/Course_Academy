\\\  & =\\frac{1}{4}(\\frac{1}{4}{x}^{4}-\\frac{1}{5}{x}^{5}){|}_{-2}^{0} \\\\  & =\\frac{1}{4}(0-[4+\\frac{32}{5}]) \\\\  & =\\frac{1}{4}(-\\frac{52}{5}) \\\\  & =-\\frac{13}{5}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186479149 #edb/ref 1058 #edb/ref 17592186479157 #edb/ref 17592186045417] [17592186479149 #edb/ref 1062 #uuid "121da9a3-a27d-57e3-b7b6-52d9b4081634" #edb/ref 17592186045417] [17592186479149 #edb/ref 1063 #edb/ref 17592186479115 #edb/ref 17592186045417] [17592186479151 #edb/ref 1058 #edb/ref 17592186479152 #edb/ref 17592186045417] [17592186479151 #edb/ref 1062 #uuid "1ec8cc12-b2a4-5daf-96fd-1e378052ed2d" #edb/ref 17592186045417] [17592186479151 #edb/ref 1063 #edb/ref 17592186427364 #edb/ref 17592186045417] [17592186479152 #edb/ref 1058 #edb/ref 17592186479153 #edb/ref 17592186045417] [17592186479152 #edb/ref 1062 #uuid "46c499f6-0d50-5bd9-9f52-26ed8cb8ebb6" #edb/ref 17592186045417] [17592186479152 #edb/ref 1063 #edb/ref 17592186479144 #edb/ref 17592186045417] [17592186479153 #edb/ref 1058 #edb/ref 17592186479149 #edb/ref 17592186045417] [17592186479153 #edb/ref 1062 #uuid "473a0974-6e51-5843-94d7-0cf17d7cd776" #edb/ref 17592186045417] [17592186479153 #edb/ref 1063 #edb/ref 17592186157606 #edb/ref 17592186045417] [17592186479157 #edb/ref 1062 #uuid "b0bf133b-cce4-5d5c-905a-ed7bcb9e9bdc" #edb/ref 17592186045417] [17592186479157 #edb/ref 1063 #edb/ref 17592186479070 #edb/ref 17592186045417] [17592186507600 #edb/ref 1043 #edb/ref 17592186508118 #edb/ref 17592186045417] [17592186507600 #edb/ref 1043 #edb/ref 17592186508137 #edb/ref 17592186045417] [17592186507600 #edb/ref 1043 #edb/ref 17592186508141 #edb/ref 17592186045417] [17592186507600 #edb/ref 1043 #edb/ref 17592186508148 #edb/ref 17592186045417] [17592186507600 #edb/ref 1043 #edb/ref 17592186508152 #edb/ref 17592186045417] [17592186507600 #edb/ref 1044 #edb/ref 17592186045464 #edb/ref 17592186045417] [17592186507600 #edb/ref 1045 "Moments of Continuous Random Variables" #edb/ref 175921860454