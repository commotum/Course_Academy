-5654-9879-70de70a8fe6d" #edb/ref 17592186045417] [17592186507845 #edb/ref 1080 "2{e}^{2}-e" #edb/ref 17592186045417] [17592186507845 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186507845 #edb/ref 1083 #uuid "b269375e-588f-5e5f-9ae9-591c8a3221c9" #edb/ref 17592186045417] [17592186507864 #edb/ref 1080 "{e}^{2}-e" #edb/ref 17592186045417] [17592186507864 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186507864 #edb/ref 1083 #uuid "bfd68903-0ef9-5e2a-88ed-3677ac3ae07b" #edb/ref 17592186045417] [17592186507865 #edb/ref 1080 "2{e}^{2}-5e+3" #edb/ref 17592186045417] [17592186507865 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186507865 #edb/ref 1083 #uuid "c01cb739-f7ab-5ebb-8e34-daf477537efd" #edb/ref 17592186045417] [17592186507967 #edb/ref 1075 #edb/ref 17592186507648 #edb/ref 17592186045417] [17592186507967 #edb/ref 1075 #edb/ref 17592186507843 #edb/ref 17592186045417] [17592186507967 #edb/ref 1075 #edb/ref 17592186507845 #edb/ref 17592186045417] [17592186507967 #edb/ref 1075 #edb/ref 17592186507864 #edb/ref 17592186045417] [17592186507967 #edb/ref 1075 #edb/ref 17592186507865 #edb/ref 17592186045417] [17592186507967 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186507967 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186507967 #edb/ref 1078 #edb/ref 17592186507864 #edb/ref 17592186045417] [17592186507967 #edb/ref 1079 #uuid "440eb13c-81c4-5c5d-9faa-611d1e590780" #edb/ref 17592186045417] [17592186508029 #edb/ref 1075 #edb/ref 17592186507622 #edb/ref 17592186045417] [17592186508029 #edb/ref 1075 #edb/ref 17592186507624 #edb/ref 17592186045417] [17592186508029 #edb/ref 1075 #edb/ref 17592186507751 #edb/ref 17592186045417] [17592186508029 #edb/ref 1075 #edb/ref 17592186507784 #edb/ref 17592186045417] [17592186508029 #edb/ref 1075 #edb/ref 17592186507800 #edb/ref 17592186045417] [17592186508029 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186508029 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186508029 #edb/ref 1078 #edb/ref 17592186507624 #edb/ref 17592186045417] [17592186508029 #edb/ref 1079 #uuid "f5d3c470-c959-5590-9ddc-7ea57ee65776" #edb/ref 17592186045417] [17592186508043 #edb/ref 1068 #edb/ref 17592186508029 #edb/ref 17592186045417] [17592186508043 #edb/ref 1069 "q-90392" #edb/ref 17592186045417] [17592186508043 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186508043 #edb/ref 1071 "The continuous random variable $X$ has the following probability density function:\n\n$$\nf(x)=\\frac{3}{{x}^{4}},\\,x>1\n$$\n\nGiven that $\\text{E}[X]=\\frac{3}{2},$ compute $\\text{E}[{X}^{2}+2X-1].$\n\n*Hint: You may assume that $\\text{E}[aX+bY]=a\\text{E}[X]+b\\text{E}[Y]$ for any random variables $X$ and $Y$ and constants $a$ and $b.$*" #edb/ref 17592186045417] [17592186508043 #edb/ref 1072 #uuid "0cddfc6e-37ce-5b87-9aa0-8b3fda1d2938" #edb/ref 17592186045417] [17592186508043 #edb/ref 1074 "First, we simplify using the hint and the properties of expected value:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}+2X-1] & =\\text{E}[{X}^{2}]+2\\text{E}[X]-\\text{E}[1] \\\\  & =\\text{E}[{X}^{2}]+2\\text{E}[X]-1\\end{aligned}\n$$\n\nFor a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ the $n$th raw moment of $X$ is given by\n\n$$\n\\text{E}[{X}^{n}]={\\int }_{S}{x}^{n}\\cdot f(x)\\,\\text{d}x.\n$$\n\nWe already know $\\text{E}[X].$ So, we compute the second raw moment of $X$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{S}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }{x}^{2}\\cdot \\frac{3}{{x}^{4}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{3}{{x}^{2}}\\,\\text{d}x \\\\  & ={lim}_{a\\to \\infty }{\\int }_{1}^{a}\\frac{3}{{x}^{2}}\\,\\text{d}x \\\\  & ={lim}_{a\\to \\infty }{(-\\frac{3}{x})|}_{1}^{a} \\\\  & ={lim}_{a\\to \\infty }(3-\\frac{3}{a}) \\\\  & =3\\end{aligned}\n$$\n\nSubstituting $\\text{E}[X]=\\frac{3}{2}$ and $\\text{E}[{X}^{2}]=3$ into the simplified expression, we conclude that\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}+2X-1] & =\\text{E}[{X}^{2}]+2\\text{E}[X]-1 \\\\  & =3+2\\cdot \\frac{3}{2}-1 \\\\  & =3+3-1 \\\\  & =5.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186508093 #edb/ref 1068 #edb/ref 17592186507967 #edb/ref 17592186045417] [17592186508093 #edb/ref 1069 "q-131140" #edb/ref 17592186045417] [17592186508093 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186508093 #edb/ref 1071 "The continuous random variable $X$ has the following probability density function:\n\n$$\nf(x)=\\frac{1}{x},\\,1<x<e\n$$\n\nGiven that $\\text{E}[X]=e-1,$ compute $\\text{E}[2{X}^{2}-X].$\n\n*Hint: You may assume that $\\text{E}[aX+bY]=a\\text{E}[X]+b\\text{E}[Y]$ for any random variables $X$ and $Y$ and constants $a$ and $b.$*" #edb/ref 17592186045417] [17592186508093 #edb/ref 1072 #uuid "b8f3b4b6-eb37-510a-a5f6-48850ac9d684" #edb/ref 17592186045417] [17592186508093 #edb/ref 1074 "First, we simplify using the hint and the properties of expected value:\n\n$$\n\\text{E}[2{X}^{2}-X]=2\\text{E}[{X}^{2}]-\\text{E}[X]\n$$\n\nFor a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ the $n$th raw moment of $X$ is given by\n\n$$\n\\text{E}[{X}^{n}]={\\int }_{S}{x}^{n}\\cdot f(x)\\,\\text{d}x.\n$$\n\nWe already know $\\text{E}[X].$ So, we compute the second raw moment of $X$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{S}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{e}{x}^{2}\\cdot \\frac{1}{x}\\,\\text{d}x \\\\  & ={\\int }_{1}^{e}x\\,\\text{d}x \\\\  & ={\\frac{{x}^{2}}{2}\\,|}_{1}^{e} \\\\  & =\\frac{{e}^{2}-1}{2}\\end{aligned}\n$$\n\nSubstituting $\\text{E}[X]=e-1$ and $\\text{E}[{X}^{2}]=\\frac{{e}^{2}-1}{2}$ into the simplified expression, we conclude that\n\n$$\n\\begin{aligned}\\text{E}[2{X}^{2}-X] & =2\\text{E}[{X}^{2}]-\\text{E}[X] \\\\  & =2\\cdot \\frac{{e}^{2}-1}{2}-(e-1) \\\\  & ={e}^{2}-1-e+1 \\\\  & ={e}^{2}-e.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186508118 #edb/ref 1062 #uuid "0aef0e95-7b36-56cc-a917-a6909d024646" #edb/ref 17592186045417] [17592186508118 #edb/ref 1063 #edb/ref 17592186434426 #edb/ref 17592186045417] [17592186508137 #edb/ref 1058 #edb/ref 17592186508118 #edb/ref 17592186045417] [17592186508137 #edb/ref 1062 #uuid "62dbfd8d-d6c8-5022-be2b-1ea1fd60fadf" #edb/ref 17592186045417] [17592186508137 #edb/ref 1063 #edb/ref 17592186479115 #edb/ref 17592186045417] [17592186508141 #edb/ref 1058 #edb/ref 17592186508152 #edb/ref 17592186045417] [17592186508141 #edb/ref 1062 #uuid "81573813-f419-5bab-b167-8255dfe1a85b" #edb/ref 17592186045417] [17592186508141 #edb/ref 1063 #edb/ref 17592186508093 #edb/ref 17592186045417] [17592186508148 #edb/ref 1058 #edb/ref 17592186508141 #edb/ref 17592186045417] [17592186508148 #edb/ref 1062 #uuid "a28c654f-55ef-5916-869c-70e534152c19" #edb/ref 17592186045417] [17592186508148 #edb/ref 1063 #edb/ref 17592186508043 #edb/ref 17592186045417] [17592186508152 #edb/ref 1058 #edb/ref 17592186508137 #edb/ref 17592186045417] [17592186508152 #edb/ref 1062 #uuid "b234828c-5807-5de4-a2a5-5f231ccf4ede" #edb/ref 17592186045417] [17592186508152 #edb/ref 1063 #edb/ref 17592186434427 #edb/ref 17592186045417]}
