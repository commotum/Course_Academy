          "input_html": "<div id=\"freeResponseTextbox-1\" class=\"matheditor-wrapper-answer\" ;=\"\" style=\"min-width:50px;\n                                        margin-left:2px;\n                                        margin-right:5px;\n                                        background:;\"><div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"21\"><span class=\"mq-fraction mq-non-leaf\" mathquill-command-id=\"23\"><span class=\"mq-numerator\" mathquill-block-id=\"25\"><span mathquill-command-id=\"24\">1</span></span><span class=\"mq-denominator\" mathquill-block-id=\"27\"><span mathquill-command-id=\"26\">2</span></span><span style=\"display:inline-block;width:0\">​</span></span></span></div></div>",
