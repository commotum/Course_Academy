</mn></mrow><mn>2</mn></msubsup><mtext>d</mtext><mi>x</mi></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><mo>−</mo><mi>x</mi><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><msubsup><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"2.470em\" maxsize=\"2.470em\">|</mo></mrow><mrow data-mjx-texclass=\"ORD\"><mn>1</mn></mrow><mn>2</mn></msubsup></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><mo>−</mo><mo stretchy=\"false\">(</mo><mn>2</mn><mo>−</mo><mn>1</mn><mo stretchy=\"false\">)</mo></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><mo>−</mo><mn>1</mn></mtd><mtd><mi></mi><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
