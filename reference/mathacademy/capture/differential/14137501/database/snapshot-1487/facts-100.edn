43182-7831-5a84-81e5-3228bf7e7dcc" #edb/ref 17592186045417] [17592186436434 #edb/ref 1075 #edb/ref 17592186436399 #edb/ref 17592186045417] [17592186436434 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186436434 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186436434 #edb/ref 1078 #edb/ref 17592186436399 #edb/ref 17592186045417] [17592186436434 #edb/ref 1079 #uuid "e099fb0b-5d08-54ae-a545-4841ad9b09ce" #edb/ref 17592186045417] [17592186436435 #edb/ref 1075 #edb/ref 17592186436398 #edb/ref 17592186045417] [17592186436435 #edb/ref 1075 #edb/ref 17592186436405 #edb/ref 17592186045417] [17592186436435 #edb/ref 1075 #edb/ref 17592186436407 #edb/ref 17592186045417] [17592186436435 #edb/ref 1075 #edb/ref 17592186436414 #edb/ref 17592186045417] [17592186436435 #edb/ref 1075 #edb/ref 17592186436419 #edb/ref 17592186045417] [17592186436435 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186436435 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186436435 #edb/ref 1078 #edb/ref 17592186436419 #edb/ref 17592186045417] [17592186436435 #edb/ref 1079 #uuid "fde1e6aa-3904-5bc7-8bc1-4efe5c7c9097" #edb/ref 17592186045417] [17592186436436 #edb/ref 1068 #edb/ref 17592186436428 #edb/ref 17592186045417] [17592186436436 #edb/ref 1069 "q-73517" #edb/ref 17592186045417] [17592186436436 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186436436 #edb/ref 1071 "$\\int ({x}^{2}+5{cot}^{2}⁡x+5)\\text{d}x=$" #edb/ref 17592186045417] [17592186436436 #edb/ref 1072 #uuid "2ab531ef-b57e-5769-8250-354ac0b4cc1b" #edb/ref 17592186045417] [17592186436436 #edb/ref 1074 "In this case, we have to use the identity  $1+{cot}^{2}⁡x={csc}^{2}⁡x.$ Substituting this into our integral gives\n\n$$\n\\begin{aligned}\\int ({x}^{2}+5{cot}^{2}⁡x+5)\\text{d}x & =\\int ({x}^{2}+5({cot}^{2}⁡x+1))\\text{d}x \\\\  & =\\int ({x}^{2}+5{csc}^{2}⁡x)\\text{d}x \\\\  & =\\frac{{x}^{3}}{3}-5\\operatorname{cot}⁡x+C\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186436437 #edb/ref 1068 #edb/ref 17592186436429 #edb/ref 17592186045417] [17592186436437 #edb/ref 1069 "q-352622" #edb/ref 17592186045417] [17592186436437 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186436437 #edb/ref 1071 "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{{e}^{4}-1}\\frac{1}{{sin}^{2}⁡x+{cos}^{2}⁡x+x}\\,\\text{d}x=$\n{{field-1}}" #edb/ref 17592186045417] [17592186436437 #edb/ref 1072 #uuid "395c9bcf-c73e-5ebd-b5f5-5752cb5f3e44" #edb/ref 17592186045417] [17592186436437 #edb/ref 1074 "We use the Pythagorean identity:\n\n$$\n{sin}^{2}⁡x+{cos}^{2}⁡x=1\n$$\n\nUsing the above, we compute the given integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{{e}^{4}-1}\\frac{1}{{sin}^{2}⁡x+{cos}^{2}⁡x+x}\\,\\text{d}x & ={\\int }_{0}^{{e}^{4}-1}\\frac{1}{1+x}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡(1+x)\\,{|}_{0}^{{e}^{4}-1} \\\\  & =\\operatorname{ln}⁡[1+({e}^{4}-1)]-\\operatorname{ln}⁡(1+0) \\\\  & =\\operatorname{ln}⁡({e}^{4})-\\operatorname{ln}⁡(1) \\\\  & =4-0 \\\\  & =4\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186436438 #edb/ref 1068 #edb/ref 17592186436434 #edb/ref 17592186045417] [17592186436438 #edb/ref 1069 "q-352630" #edb/ref 17592186045417] [17592186436438 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186436438 #edb/ref 1071 "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{2}^{7}\\frac{1}{4\\sqrt{2{sin}^{2}⁡x+x+2{cos}^{2}⁡x}}\\,\\text{d}x=$\n{{field-1}}" #edb/ref 17592186045417] [17592186436438 #edb/ref 1072 #uuid "4611fa95-3984-5432-82fc-4aa1ab6a6967" #edb/ref 17592186045417] [17592186436438 #edb/ref 1074 "We use the Pythagorean identity:\n\n$$\n{sin}^{2}⁡x+{cos}^{2}⁡x=1\n$$\n\nUsing the above, we compute the given integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{2}^{7}\\frac{1}{4\\sqrt{2{sin}^{2}⁡x+x+2{cos}^{2}⁡x}}\\,\\text{d}x & =\\frac{1}{4}{\\int }_{2}^{7}\\frac{1}{\\sqrt{x+2({sin}^{2}⁡x+{cos}^{2}⁡x)}}\\,\\text{d}x \\\\  & =\\frac{1}{4}{\\int }_{2}^{7}\\frac{1}{\\sqrt{x+2\\cdot 1}}\\,\\text{d}x \\\\  & =\\frac{1}{4}{\\int }_{2}^{7}\\frac{1}{\\sqrt{x+2}}\\,\\text{d}x \\\\  & =\\frac{1}{2}\\sqrt{x+2}\\,{|}_{2}^{7} \\\\  & =\\frac{1}{2}(\\sqrt{7+2}-\\sqrt{2+2}) \\\\  & =\\frac{1}{2}(\\sqrt{9}-\\sqrt{4}) \\\\  & =\\frac{1}{2}(3-2) \\\\  & =\\frac{1}{2}\\cdot 1 \\\\  & =\\frac{1}{2}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186436439 #edb/ref 1068 #edb/ref 17592186436435 #edb/ref 17592186045417] [17592186436439 #edb/ref 1069 "q-49323" #edb/ref 17592186045417] [17592186436439 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186436439 #edb/ref 1071 "Calculate $\\int \\frac{{cos}^{3}⁡(x+\\frac{\\pi }{6})}{{sin}^{2}⁡(x+\\frac{\\pi }{6})-1}\\,\\text{d}x.$" #edb/ref 17592186045417] [17592186436439 #edb/ref 1072 #uuid "4a652b8e-bfd2-5735-84e4-910c649c4ba7" #edb/ref 17592186045417] [17592186436439 #edb/ref 1074 "From the identity  ${cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1$ with $\\theta =x+\\frac{\\pi }{6},$ we get \n\n$$\n\\begin{aligned}{cos}^{2}⁡(x+\\frac{\\pi }{6})+{sin}^{2}⁡(x+\\frac{\\pi }{6}) & =1 \\\\ {sin}^{2}⁡(x+\\frac{\\pi }{6})-1 & =-{cos}^{2}⁡(x+\\frac{\\pi }{6}).\\end{aligned}\n$$\n\nSubstituting the above into our integral gives\n\n$$\n\\begin{aligned}\\int \\frac{{cos}^{3}⁡(x+\\frac{\\pi }{6})}{{sin}^{2}⁡(x+\\frac{\\pi }{6})-1}\\,\\text{d}x & =\\int \\frac{{cos}^{3}⁡(x+\\frac{\\pi }{6})}{-{cos}^{2}⁡(x+\\frac{\\pi }{6})}\\,\\text{d}x \\\\  & =-\\int \\operatorname{cos}⁡(x+\\frac{\\pi }{6})\\,\\text{d}x \\\\  & =-\\operatorname{sin}⁡(x+\\frac{\\pi }{6})+C.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186436440 #edb/ref 1068 #edb/ref 17592186436427 #edb/ref 17592186045417] [17592186436440 #edb/ref 1069 "q-73529" #edb/ref 17592186045417] [17592186436440 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186436440 #edb/ref 1071 "${\\int }_{\\pi /2}^{3\\pi /4}(1-{cot}^{2}⁡(x-\\frac{\\pi }{4}))\\text{d}x=$" #edb/ref 17592186045417] [17592186436440 #edb/ref 1072 #uuid "5e890818-44b2-5fa4-a0b6-4c9a2cfbfd6f" #edb/ref 17592186045417] [17592186436440 #edb/ref 1074 "From the identity $1+{cot}^{2}⁡\\theta ={csc}^{2}⁡\\theta $ with $\\theta =x-\\frac{\\pi }{4},$ we get \n\n$$\n\\begin{aligned}1+{cot}^{2}⁡(x-\\frac{\\pi }{4}) & ={csc}^{2}⁡(x-\\frac{\\pi }{4}) \\\\ {cot}^{2}⁡(x-\\frac{\\pi }{4}) & ={csc}^{2}⁡(x-\\frac{\\pi }{4})-1.\\end{aligned}\n$$\n\nSubstituting the above into our integral gives\n\n$$\n\\begin{aligned}{\\int }_{\\pi /2}^{3\\pi /4}(1-{cot}^{2}⁡(x-\\frac{\\pi }{4}))\\,\\text{d}x & ={\\int }_{\\pi /2}^{3\\pi /4}(1-{csc}^{2}⁡(x-\\frac{\\pi }{4})+1)\\,\\text{d}x \\\\  & ={\\int }_{\\pi /2}^{3\\pi /4}(2-{csc}^{2}⁡(x-\\frac{\\pi }{4}))\\,\\text{d}x \\\\  & ={\\int }_{\\pi /2}^{3\\pi /4}2\\,\\text{d}x-{\\int }_{\\pi /2}^{3\\pi /4}{csc}^{2}⁡(x-\\frac{\\pi }{4})\\,\\text{d}x \\\\  & =2x{|}_{\\pi /2}^{3\\pi /4}+\\operatorname{cot}⁡(x-\\frac{\\pi }{4}){|}_{\\pi /2}^{3\\pi /4} \\\\  & =2(\\frac{3\\pi }{4}-\\frac{\\pi }{2})+\\operatorname{cot}⁡(\\frac{3\\pi }{4}-\\frac{\\pi }{4})-\\operatorname{cot}⁡(\\frac{\\pi }{2}-\\frac{\\pi }{4}) \\\\  & =2(\\frac{\\pi }{4})+\\operatorname{cot}⁡(\\frac{\\pi }{2})-\\operatorname{cot}⁡(\\frac{\\pi }{4}) \\\\  & =\\frac{\\pi }{2}+0-1 \\\\  & =\\frac{\\pi }{2}-1.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186436441 #edb/ref 1068 #edb/ref 17592186436432 #edb/ref 17592186045417] [17592186436441 #edb/ref 1069 "q-352629" #edb/ref 17592186045417] [17592186436441 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186436441 #edb/ref 1071 "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{\\pi /6}^{\\pi /4}\\frac{2{sin}^{3}⁡x}{1-{cos}^{2}⁡x}\\,\\text{d}x=$\n{{field-1}}" #edb/ref 17592186045417] [17592186436441 #edb/ref 1072 #uuid "601c3d78-5b89-5552-acb7-b5618e1d28f8" #edb/ref 17592186045417] [17592186436441 #edb/ref 1074 "We use the Pythagorean identity:\n\n$$\n{sin}^{2}⁡x+{cos}^{2}⁡x=1\\,⟹\\,1-{cos}^{2}⁡x={sin}^{2}⁡x\n$$\n\nUsing the above, we compute the given integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{\\pi /6}^{\\pi /4}\\frac{2{sin}^{3}⁡x}{1-{cos}^{2}⁡x}\\,\\text{d}x & =2{\\int }_{\\pi /6}^{\\pi /4}\\frac{{sin}^{3}⁡x}{{sin}^{2}⁡x}\\,\\text{d}x \\\\  & =2{\\int }_{\\pi /6}^{\\pi /4}\\operatorname{sin}⁡x\\,\\text{d}x \\\\  & =2(-\\operatorname{cos}⁡x)\\,{|}_{\\pi /6}^{\\pi /4} \\\\  & =-2[\\operatorname{cos}⁡(\\frac{\\pi }{4})-\\operatorname{cos}⁡(\\frac{\\pi }{6})] \\\\  & =-2\\cdot (\\frac{\\sqrt{2}}{2}-\\frac{\\sqrt{3}}{2}) \\\\  & =\\sqrt{3}-\\sqrt{2}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186436442 #edb/ref 1068 #edb/ref 17592186436426 #edb/ref 17592186045417] [17592186436442 #edb/ref 1069 "q-114468" #edb/ref 17592186045417] [17592186436442 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186436442 #edb/ref 1071 "Calculate ${\\int }_{1}^{2}(2{sin}^{2}⁡(\\frac{x}{3}-1)-3+2{cos}^{2}⁡(\\frac{x}{3}-1))\\text{d}x.$" #edb/ref 17592186045417] [17592186436442 #edb/ref 1072 #uuid "67ca50b0-637c-5544-b80a-0086acfa0a59" #edb/ref 17592186045417] [17592186436442 #edb/ref 1074 "From the identity ${sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta =1,$ with $\\theta =\\frac{x}{3}-1,$ we get \n\n$$\n\\begin{aligned}{sin}^{2}⁡(\\frac{x}{3}-1)+{cos}^{2}⁡(\\frac{x}{3}-1)=1.\\end{aligned}\n$$\n\nSubstituting the above into our integral gives\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}(2{sin}^{2}⁡(\\frac{x}{3}-1)-3+2{cos}^{2}⁡(\\frac{x}{3}-1))\\text{d}x & = \\\\ {\\int }_{1}^{2}(2[{sin}^{2}⁡(\\frac{x}{3}-1)+{cos}^{2}⁡(\\frac{x}{3}-1)]-3)\\text{d}x & = \\\\ {\\int }_{1}^{2}(2(1)-3)\\text{d}x & = \\\\ -{\\int }_{1}^{2}\\text{d}x & = \\\\ -x\\,{|}_{1}^{2} & = \\\\ -(2-1) & = \\\\ -1 & .\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186436443 #edb/ref 1068 #edb/ref 17592186436433 #edb/ref 17592186045417] [17592186436443 #edb/ref 1069 "q-352651" #edb/ref 17592186045417] [17592186436443 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186436443 #edb/ref 1071 "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\pi /4}x(1+{tan}^{2}⁡x){cos}^{2}⁡x\\,\\text{d}x=$\n{{field-1}}" #edb/ref 17592186045417] [17592186436443 #edb/ref 1072 #uuid "7bc6f22d-8d3d-514a-8037-cf0e1ab0434e" #edb/ref 17592186045417] [17592186436443 #edb/ref 1074 "In this case, we have to use the identity  $1+{tan}^{2}⁡x={sec}^{2}⁡x.$ Substituting this into our integral gives\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /4}x(1+{tan}^{2}⁡x){cos}^{2}⁡x\\,\\text{d}x & ={\\int }_{0}^{\\pi /4}x{sec}^{2}⁡x{cos}^{2}⁡x\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /4}x\\cdot \\frac{1}{{cos}^{2}⁡x}\\cdot {cos}^{2}⁡x\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /4}x\\,\\text{d}x \\\\  & =\\frac{1}{2}{x}^{2}\\,{|}_{0}^{\\pi /4} \\\\  & =\\frac{1}{2}(\\frac{{\\pi }^{2}}{16}-0) \\\\  & =\\frac{{\\pi }^{2}}{32}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186436444 #edb/ref 1068 #edb/ref 17592186436430 #edb/ref 17592186045417] [17592186436444 #edb/ref 1069 "q-362798" #edb/ref 17592186045417] [17592186436444 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186436444 #edb/ref 1071 "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{\\pi /6}^{\\pi /4}\\frac{{sec}^{2}⁡x}{\\operatorname{sin}⁡x({tan}^{3}⁡x+\\operatorname{tan}⁡x)}\\,\\text{d}x=$\n{{field-1}}" #edb/ref 17592186045417] [17592186436444 #edb/ref 1072 #uuid "abe2124c-7cb3-538b-9274-4eab950d2782" #edb/ref 17592186045417] [17592186436444 #edb/ref 1074 "First, we select the identity that contains a ${tan}^{2}⁡x$ term. So, we can use the identity \n\n$$\n1+{tan}^{2}⁡x={sec}^{2}⁡x.\n$$\n\nUsing the above, we compute the given integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{\\pi /6}^{\\pi /4}\\frac{{sec}^{2}⁡x}{\\operatorname{sin}⁡x({tan}^{3}⁡x+\\operatorname{tan}⁡x)}\\,\\text{d}x & ={\\int }_{\\pi /6}^{\\pi /4}\\frac{{sec}^{2}⁡x}{\\operatorname{sin}⁡x\\cdot \\operatorname{tan}⁡x({tan}^{2}⁡x+1)}\\,\\text{d}x \\\\  & ={\\int }_{\\pi /6}^{\\pi /4}\\frac{{sec}^{2}⁡x}{\\operatorname{sin}⁡x\\cdot \\operatorname{tan}⁡x\\cdot {sec}^{2}⁡x}\\,\\text{d}x \\\\  & ={\\int }_{\\pi /6}^{\\pi /4}\\frac{1}{\\operatorname{sin}⁡x\\cdot \\operatorname{tan}⁡x}\\,\\text{d}x \\\\  & ={\\int }_{\\pi /6}^{\\pi /4}\\operatorname{csc}⁡x\\operatorname{cot}⁡x\\,\\text{d}x \\\\  & =-\\operatorname{csc}⁡x\\,{|}_{\\pi /6}^{\\pi /4} \\\\  & =-\\operatorname{csc}⁡(\\frac{\\pi }{4})-(-\\operatorname{csc}⁡(\\frac{\\pi }{6})) \\\\  & =-\\sqrt{2}-(-2) \\\\  & =2-\\sqrt{2}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186436445 #edb/ref 1068 #edb/ref 17592186436431 #edb/ref 17592186045417] [17592186436445 #edb/ref 1069 "q-73527" #edb/ref 17592186045417] [17592186436445 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186436445 #edb/ref 1071 "Calculate $\\int (8{x}^{3}-2{tan}^{2}⁡x-2)\\,\\text{d}x.$" #edb/ref 17592186045417] [17592186436445 #edb/ref 1072 #uuid "cfd5d01f-68da-5044-a541-b2046cbc9096" #edb/ref 17592186045417] [17592186436445 #edb/ref 1074 "First, we select the identity that contains a ${tan}^{2}⁡x$ term. So we can use the identity \n\n$$\n{tan}^{2}⁡x+1={sec}^{2}⁡x.\n$$\n\nUsing the above, we compute the given integral as follows:\n\n$$\n\\begin{aligned}\\int (8{x}^{3}-2{tan}^{2}⁡x-2)\\,\\text{d}x & =\\int (8{x}^{3}-2({tan}^{2}⁡x+1))\\,\\text{d}x \\\\  & =\\int (8{x}^{3}-2{sec}^{2}⁡x)\\,\\text{d}x \\\\  & =2{x}^{4}-2\\operatorname{tan}⁡x+C.\\end{aligned}\n$$" #edb/ref 17592186045417]}
