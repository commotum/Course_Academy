5417] [17592186342000 #edb/ref 1072 #uuid "99972d7b-41c2-573c-8100-907314a5a411" #edb/ref 17592186045417] [17592186342000 #edb/ref 1074 "Reducing $M$ to echelon form, we have\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}4 & -16 & 8 \\\\ -3 & 12 & -6\\end{aligned}] & {R}_{1} & :=\\frac{1}{4}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -4 & 2 \\\\ -3 & 12 & -6\\end{aligned}] & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -4 & 2 \\\\ 0 & 0 & 0\\end{aligned}].\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186342074 #edb/ref 1068 #edb/ref 17592186341601 #edb/ref 17592186045417] [17592186342074 #edb/ref 1069 "q-73743" #edb/ref 17592186045417] [17592186342074 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186342074 #edb/ref 1071 "Consider the augmented matrix $M$ given by \n\n$$\nM=[\\begin{aligned}3 & -2 & 1 \\\\ 6 & -4 & 2\\end{aligned}].\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form." #edb/ref 17592186045417] [17592186342074 #edb/ref 1072 #uuid "f7492471-0301-5306-8f40-5431247eb08f" #edb/ref 17592186045417] [17592186342074 #edb/ref 1074 "Reducing $M$ to echelon form, we have\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}3 & -2 & 1 \\\\ 6 & -4 & 2\\end{aligned}] & {R}_{1} & :=\\frac{1}{3}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -\\frac{2}{3} & \\frac{1}{3} \\\\ 6 & -4 & 2\\end{aligned}] & {R}_{2} & :={R}_{2}-6{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -\\frac{2}{3} & \\frac{1}{3} \\\\ 0 & 0 & 0\\end{aligned}].\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186379994 #edb/ref 1068 #edb/ref 17592186379995 #edb/ref 17592186045417] [17592186379994 #edb/ref 1069 "q-73749" #edb/ref 17592186045417] [17592186379994 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186379994 #edb/ref 1071 "Consider the system of linear equations\n\n$$\n{\\begin{aligned}x+3y=1 \\\\ 2x+6y=3.\\end{aligned}\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form, and then find the general solution of the linear system." #edb/ref 17592186045417] [17592186379994 #edb/ref 1072 #uuid "a9a9e509-4293-5590-b2bf-432eea2f6134" #edb/ref 17592186045417] [17592186379994 #edb/ref 1074 "First, we set up the augmented matrix for the system:\n\n$$\nM=[\\begin{aligned}1 & 3 & 1 \\\\ 2 & 6 & 3\\end{aligned}]\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 3 & 1 \\\\ 2 & 6 & 3\\end{aligned}] & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 3 & 1 \\\\ 0 & 0 & 1\\end{aligned}].\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n{\\begin{aligned}x+3y=1 \\\\ 0x+0y=1.\\end{aligned}\n$$\n\nHowever, the final equation $0x+0y=1$ has no solution. It simplifies to $0=1,$ which is a false statement.\n\nSo, there is no pair $x,y$ that satisfies both equations in the system. Consequently, the overall system has no solution." #edb/ref 17592186045417] [17592186379995 #edb/ref 1075 #edb/ref 17592186379996 #edb/ref 17592186045417] [17592186379995 #edb/ref 1075 #edb/ref 17592186379997 #edb/ref 17592186045417] [17592186379995 #edb/ref 1075 #edb/ref 17592186379998 #edb/ref 17592186045417] [17592186379995 #edb/ref 1075 #edb/ref 17592186379999 #edb/ref 17592186045417] [17592186379995 #edb/ref 1075 #edb/ref 17592186380000 #edb/ref 17592186045417] [17592186379995 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186379995 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186379995 #edb/ref 1078 #edb/ref 17592186379998 #edb/ref 17592186045417] [17592186379995 #edb/ref 1079 #uuid "ec8ab221-6d21-5288-b1eb-292d7d2b813f" #edb/ref 17592186045417] [17592186379996 #edb/ref 1080 "[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-1+3y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )" #edb/ref 17592186045417] [17592186379996 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186379996 #edb/ref 1083 #uuid "e2ab0020-3a9c-5eac-8f36-de8c7e