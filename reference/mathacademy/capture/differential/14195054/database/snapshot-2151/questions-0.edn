#{[{:db/id #edb/ref 17592186124396 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186124585 :knowledge-point/id #uuid "2e0b4012-403b-5739-8f33-3c79111129fd" :knowledge-point/title "Identifying Properties of Elliptic Cones"}] :question/id #uuid "c351fdde-ce68-5fa1-97e1-7678211a3963" :question/math-academy-id "e-8216" :question/problem "Given the elliptic cone $\\dfrac{(x-2)^2}{4} + \\dfrac{(y-2)^2}{2} = \\dfrac{(z+1)^2}{3},$ find its intercepts with the $z$-axis." :question/worked-solution "To find the $z$-intercepts of the elliptic cone, we plug $x=0$ and $y=0$ into the equation and solve for $z\\mathbin{:}$\n\n$$\n\\begin{aligned}\\frac{(0-2)^{2}}{4}+\\frac{(0-2)^{2}}{2} & =\\frac{(z+1)^{2}}{3} \\\\ \\frac{4}{4}+\\frac{4}{2} & =\\frac{(z+1)^{2}}{3} \\\\ 1+2 & =\\frac{(z+1)^{2}}{3} \\\\ 3 & =\\frac{(z+1)^{2}}{3} \\\\ 9 & =(z+1)^{2} \\\\ z+1 & =\\pm 3 \\\\ z & =-1\\pm 3 \\\\ z & =-4,2\\end{aligned}\n$$\n\nTherefore, the intercepts with the $z$-axis are $(0,0,-4)$ and $(0,0,2).$"}] [{:db/id #edb/ref 17592186124397 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186124586 :knowledge-point/id #uuid "fb7148a2-58cc-5023-845c-435b47e31c83" :knowledge-point/title "Finding Traces of Elliptic Cones"}] :question/id #uuid "89ae8962-7ad4-5860-b070-8df4d92128ed" :question/math-academy-id "e-8217" :question/problem "What is the trace in the $xz$-plane of the elliptic cone $3x^2 +  4y ^2=12(z+3)^2\\: ?$" :question/worked-solution "To find the trace in the $xz$-plane, we substitute $y=0$ into the equation of the elliptic cone, as follows:\n\n$$\n\\begin{aligned}3{x}^{2}+4\\cdot {0}^{2} & =12(z+3)^{2} \\\\ 3{x}^{2} & =12(z+3)^{2} \\\\ {x}^{2} & =4(z+3)^{2} \\\\ \\pm x & =2(z+3) \\\\ \\pm \\frac{x}{2} & =z+3 \\\\ z & =\\pm \\frac{x}{2}-3\\end{aligned}\n$$\n\nThis gives us two lines in the $xz$-plane with equations $z = \\pm\\dfrac{x}{2}-3.$"}] [{:db/id #edb/ref 17592186284746 :knowledge-point/_questions [{:db/id #edb/ref 17592186124585 :knowledge-point/id #uuid "2e0b4012-403b-5739-8f33-3c79111129fd" :knowledge-point/title "Identifying Properties of Elliptic Cones"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11956820-87e5-59f7-9a01-587e112f1f0a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,-8,0)$ only" :db/id #edb/ref 17592186281855} {:answer/id #uuid "187b372f-12c8-5b94-b30e-c60e9d7967cc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,-8,0)$ and $(0,-2,0)$" :db/id #edb/ref 17592186281909} {:answer/id #uuid "3e0589bc-5681-5f2e-a140-09e251104353" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,-8,0)$ and $(0,7,0)$" :db/id #edb/ref 17592186282230} {:answer/id #uuid "767e5e0e-9067-5c62-b815-f338c0ec4581" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,-2,0)$ only" :db/id #edb/ref 17592186282703} {:answer/id #uuid "86fc7800-f4b4-55ec-9a55-aab7e674de5b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,-8,0)$ and $(0,2,0)$" :db/id #edb/ref 17592186282854}] :answer-field/correct {:answer/id #uuid "187b372f-12c8-5b94-b30e-c60e9d7967cc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,-8,0)$ and $(0,-2,0)$" :db/id #edb/ref 17592186281909} :answer-field/id #uuid "b2c4aa53-f578-528f-b782-49fe2162ccf0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284245}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "235b5226-9bea-5c1e-801c-25a2ec82bb10" :question/math-academy-id "q-176833" :question/problem "Given the elliptic cone $\\frac{(x+8)^{2}}{16}+\\frac{(y+5)^{2}}{3}=\\frac{(z-7)^{2}}{7},$ find its intercepts with the $y$-axis." :question/worked-solution "To find the $y$-intercepts of the elliptic cone, we plug $x=0$ and $z=0$ into the equation and solve for $y:$\n\n$$\n\\begin{aligned}\\frac{(0+8)^{2}}{16}+\\frac{(y+5)^{2}}{3} & =\\frac{(0-7)^{2}}{7} \\\\ \\frac{64}{16}+\\frac{(y+5)^{2}}{3} & =\\frac{49}{7} \\\\ 4+\\frac{(y+5)^{2}}{6} & =7 \\\\ \\frac{(y+5)^{2}}{3} & =3 \\\\ (y+5)^{2} & =9 \\\\ y+5 & =\\pm 3 \\\\ y & =-5\\pm 3 \\\\ y & =-8,-2\\end{aligned}\n$$\n\nTherefore, the intercepts with the $y$-axis are $(0,-8,0)$ and $(0,-2,0).$"}] [{:db/id #edb/ref 17592186284747 :knowledge-point/_questions [{:db/id #edb/ref 17592186124586 :knowledge-point/id #uuid "fb7148a2-58cc-5023-845c-435b47e31c83" :knowledge-point/title "Finding Traces of Elliptic Cones"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1451ba15-6566-5085-9e0b-ef6f6d77f7f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186281880} {:answer/id #uuid "3063bb6b-93ae-58fc-87f3-0367fab1c670" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186282117} {:answer/id #uuid "71a8465f-bb0b-559f-98ac-0c12856b902a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186282661} {:answer/id #uuid "8bb653b9-298d-5248-b2b6-d34110522d1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186282897} {:answer/id #uuid "fc7e7291-2544-5ff2-8bdc-d7c677dfff07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186283901}] :answer-field/correct {:answer/id #uuid "71a8465f-bb0b-559f-98ac-0c12856b902a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186282661} :answer-field/id #uuid "ae110007-f697-5fc7-ac5d-1ec61fa80379" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284236}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e552ce94-8cbc-51a4-8c04-3b8e44dddcc5" :question/math-academy-id "q-176835" :question/problem "Given that the intersection of the elliptic cone $4(x+3)^{2}+8(y-1)^{2}=(z+7)^{2}$ and the plane $z=-3$ is an ellipse, what is the length of its major axis?" :question/worked-solution "To find the intersection of the elliptic cone and the plane $z=-3,$ we substitute $z=-3$ into the equation of the elliptic cone, and simplify:\n\n$$\n\\begin{aligned}4(x+3)^{2}+8(y-1)^{2} & =(-3+7)^{2} \\\\ 4(x+3)^{2}+8(y-1)^{2} & ={4}^{2} \\\\ 4(x+3)^{2}+8(y-1)^{2} & =16 \\\\ \\frac{(x+3)^{2}}{4}+\\frac{(y-1)^{2}}{2} & =1 \\\\ \\frac{(x+3)^{2}}{(2)^{2}}+\\frac{(y-1)^{2}}{(\\sqrt{2})^{2}} & =1\\end{aligned}\n$$\n\nThis gives us the equation of an ellipse with a semi-major axis of length $a=2.$ Therefore, the major axis has length $2a=4.$"}] [{:db/id #edb/ref 17592186381903 :knowledge-point/_questions [{:db/id #edb/ref 17592186124586 :knowledge-point/id #uuid "fb7148a2-58cc-5023-845c-435b47e31c83" :knowledge-point/title "Finding Traces of Elliptic Cones"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c7c7baf-2af7-5778-a178-ee26e7ab310e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\sqrt{2}" :db/id #edb/ref 17592186381905} {:answer/id #uuid "348c2dc5-e846-5787-8fe3-f2f58d451f78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186381906} {:answer/id #uuid "84cd3c09-7140-5d22-ab4b-8de0bb1f2245" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186381907} {:answer/id #uuid "2e7dacb9-bf6b-5580-9907-3dc8fa338664" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186381908} {:answer/id #uuid "bbc209e6-8980-5ac6-ad04-17486246efb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186381909}] :answer-field/correct {:answer/id #uuid "348c2dc5-e846-5787-8fe3-f2f58d451f78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186381906} :answer-field/id #uuid "5b5b73d9-d33d-503d-b72a-d3c35ccecc6d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381904}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4e599e36-3b40-5e2d-af38-60f8a4820d9c" :question/math-academy-id "q-35594" :question/problem "Given that the intersection of the elliptic cone $\\frac{(x+4)^{2}}{16}+\\frac{{y}^{2}}{8}={z}^{2}$ and the plane $z=-1$ is an ellipse, what is the length of its major axis?" :question/worked-solution "To find the intersection of the elliptic cone and the plane $z=-1,$ we substitute $z=-1$ into the equation of the elliptic cone, and simplify:\n\n$$\n\\begin{aligned}\\frac{(x+4)^{2}}{16}+\\frac{{y}^{2}}{8} & ={z}^{2} \\\\ \\frac{(x+4)^{2}}{16}+\\frac{{y}^{2}}{8} & =(-1)^{2} \\\\ \\frac{(x+4)^{2}}{16}+\\frac{{y}^{2}}{8} & =1 \\\\ \\frac{(x+4)^{2}}{{4}^{2}}+\\frac{{y}^{2}}{(2\\sqrt{2})^{2}} & =1\\end{aligned}\n$$\n\nThis gives us the equation of an ellipse with a semi-major axis of length $a=4.$ Therefore, the major axis has length $2a=8.$"}] [{:db/id #edb/ref 17592186124893 :knowledge-point/_questions [{:db/id #edb/ref 17592186124586 :knowledge-point/id #uuid "fb7148a2-58cc-5023-845c-435b47e31c83" :knowledge-point/title "Finding Traces of Elliptic Cones"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "017fcc37-c2d0-5500-9a5f-b01854dc146f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\pm \\frac{y}{\\sqrt{2}}+2" :db/id #edb/ref 17592186321164} {:answer/id #uuid "176e33d4-5410-5dbc-96aa-1bfcb9c5f28b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\pm \\frac{y}{2}+4" :db/id #edb/ref 17592186321337} {:answer/id #uuid "5506ca77-5946-585d-8637-f06abe1550da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\pm \\frac{y}{2}+2" :db/id #edb/ref 17592186321817} {:answer/id #uuid "79098c71-7e0b-5ace-8183-3c89ca4a3a0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=-\\frac{y}{2}+4" :db/id #edb/ref 17592186322098} {:answer/id #uuid "e788157c-be6f-5c4e-ae29-30c092db13f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\frac{y}{2}+2" :db/id #edb/ref 17592186322961}] :answer-field/correct {:answer/id #uuid "176e33d4-5410-5dbc-96aa-1bfcb9c5f28b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\pm \\frac{y}{2}+4" :db/id #edb/ref 17592186321337} :answer-field/id #uuid "33e09110-aafb-56be-9df5-5fae19c7cfea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323275}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8fafc510-161c-5c1c-82ac-429f0c08613a" :question/math-academy-id "q-35596" :question/problem "What is the trace in the $yz$-plane of the elliptic cone $\\frac{{x}^{2}}{8}+\\frac{{y}^{2}}{4}=(z-4)^{2}\\,?$" :question/worked-solution "To find the trace in the $yz$-plane, we substitute $x=0$ into the equation of the elliptic cone, as follows:\n\n$$\n\\begin{aligned}\\frac{{0}^{2}}{8}+\\frac{{y}^{2}}{4} & =(z-4)^{2} \\\\ \\frac{{y}^{2}}{2} & =(z-4)^{2} \\\\ \\pm \\frac{y}{2} & =z-4 \\\\ z & =\\pm \\frac{y}{2}+4\\end{aligned}\n$$\n\nThis gives us two lines in the $yz$-plane with equations $z=\\pm \\frac{y}{2}+4.$"}] [{:db/id #edb/ref 17592186125238 :knowledge-point/_questions [{:db/id #edb/ref 17592186124585 :knowledge-point/id #uuid "2e0b4012-403b-5739-8f33-3c79111129fd" :knowledge-point/title "Identifying Properties of Elliptic Cones"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "332e3fdd-c5ab-5567-a7df-8d90823d6a1a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-2,0,0)$ only" :db/id #edb/ref 17592186404633} {:answer/id #uuid "9fe302de-3bb5-5c7a-b989-c8e19404a6c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(2,0,0)$ and $(4,0,0)$" :db/id #edb/ref 17592186404634} {:answer/id #uuid "67a0f9e2-02bc-5268-8186-7f072105781d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-2,0,0)$ and $(6,0,0)$" :db/id #edb/ref 17592186404635} {:answer/id #uuid "6f1fac1f-d4fb-5122-bceb-8b8e8ae46732" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-4,0,0)$ and $(4,0,0)$" :db/id #edb/ref 17592186404636} {:answer/id #uuid "73cf50ce-277e-5c94-9a9d-dfc2fc91bcef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(4,0,0)$ only" :db/id #edb/ref 17592186404637}] :answer-field/correct {:answer/id #uuid "67a0f9e2-02bc-5268-8186-7f072105781d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-2,0,0)$ and $(6,0,0)$" :db/id #edb/ref 17592186404635} :answer-field/id #uuid "d1c20ea0-f41d-5667-aeb9-8dd4fb8d87da" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186404632}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f0cabaaa-77b2-5df5-b276-82aad1e2675a" :question/math-academy-id "q-94081" :question/problem "Given the elliptic cone $\\frac{(x-2)^{2}}{2}+\\frac{(y+2)^{2}}{4}=(z+3)^{2},$ find its intercepts with the $x$-axis." :question/worked-solution "To find the $x$-intercepts of the elliptic cone, we plug $y=0$ and $z=0$ into the equation and solve for $x:$\n\n$$\n\\begin{aligned}\\frac{(x-2)^{2}}{2}+\\frac{(0+2)^{2}}{4} & =(0+3)^{2} \\\\ \\frac{(x-2)^{2}}{2}+\\frac{4}{4} & =9 \\\\ \\frac{(x-2)^{2}}{2}+1 & =9 \\\\ \\frac{(x-2)^{2}}{2} & =8 \\\\ (x-2)^{2} & =16 \\\\ x-2 & =\\pm 4 \\\\ x & =2\\pm 4 \\\\ x & =-2,6\\end{aligned}\n$$\n\nTherefore, the intercepts with the $x$-axis are $(-2,0,0)$ and $(6,0,0).$"}] [{:db/id #edb/ref 17592186357749 :knowledge-point/_questions [{:db/id #edb/ref 17592186124586 :knowledge-point/id #uuid "fb7148a2-58cc-5023-845c-435b47e31c83" :knowledge-point/title "Finding Traces of Elliptic Cones"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "096807f4-6104-5c9d-9a4f-3cc078997926" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=-\\frac{y}{3}\\pm 1" :db/id #edb/ref 17592186354752} {:answer/id #uuid "45b089cf-4cd4-5955-98fe-9f0ff803df9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\pm \\frac{y}{9}+1" :db/id #edb/ref 17592186355284} {:answer/id #uuid "78a27687-7772-5319-a40c-aef31e7c2570" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\pm \\frac{y}{3}" :db/id #edb/ref 17592186355718} {:answer/id #uuid "7fd6a87d-0609-5bbe-9ab6-30cf1a7bcfa3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=-\\frac{y}{3}" :db/id #edb/ref 17592186355784} {:answer/id #uuid "97dcd38b-595a-5837-97a8-ed1062f9f32b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\pm \\frac{y}{9}" :db/id #edb/ref 17592186356003}] :answer-field/correct {:answer/id #uuid "78a27687-7772-5319-a40c-aef31e7c2570" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\pm \\frac{y}{3}" :db/id #edb/ref 17592186355718} :answer-field/id #uuid "0000aeb3-77f2-52e8-8fd1-917fe7c0e597" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186356907}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1057b215-35c6-5a51-b1d3-2145bec593cc" :question/math-academy-id "q-94486" :question/problem "What is the trace in the $yz$-plane of the elliptic cone $\\frac{3{x}^{2}}{4}+\\frac{{y}^{2}}{9}={z}^{2}\\,?$" :question/worked-solution "To find the trace in the $yz$-plane, we substitute $x=0$ into the equation of the elliptic cone, as follows:\n\n$$\n\\begin{aligned}\\frac{{0}^{2}}{4}+\\frac{{y}^{2}}{9} & ={z}^{2} \\\\ \\frac{{y}^{2}}{9} & ={z}^{2} \\\\ z & =\\pm \\frac{y}{3}\\end{aligned}\n$$\n\nThis gives us two lines in the $yz$-plane with equations $z=\\pm \\frac{y}{3}.$"}] [{:db/id #edb/ref 17592186357750 :knowledge-point/_questions [{:db/id #edb/ref 17592186124586 :knowledge-point/id #uuid "fb7148a2-58cc-5023-845c-435b47e31c83" :knowledge-point/title "Finding Traces of Elliptic Cones"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ce7b760-ac96-5c6d-9d59-ad94d7b1ce78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\pm x-2" :db/id #edb/ref 17592186354912} {:answer/id #uuid "2f93e9f8-62b3-5167-b15a-922e763c3dbe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$z=-x,\\,$ $z=x+2$" :db/id #edb/ref 17592186355077} {:answer/id #uuid "5a769d40-eec9-5abc-ae65-98394407661f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=-x" :db/id #edb/ref 17592186355461} {:answer/id #uuid "ad81a7d0-3fa6-5930-8574-5ad3aaf18059" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$z=-x-2,\\,$ $z=-x$" :db/id #edb/ref 17592186356196} {:answer/id #uuid "fd3196f4-9f0a-50e5-8738-0e19f5747fe7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\pm x+1" :db/id #edb/ref 17592186356886}] :answer-field/correct {:answer/id #uuid "2f93e9f8-62b3-5167-b15a-922e763c3dbe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$z=-x,\\,$ $z=x+2$" :db/id #edb/ref 17592186355077} :answer-field/id #uuid "bb55d072-0c6d-5428-9174-60f52b3eddba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357256}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "53e2613b-949d-5eed-990d-1e01e33b5e77" :question/math-academy-id "q-94490" :question/problem "What is the trace in the $xz$-plane of the elliptic cone $(x+1)^{2}+\\frac{{y}^{2}}{6}=(z-1)^{2}\\,?$" :question/worked-solution "To find the trace in the $xz$-plane, we substitute $y=0$ into the equation of the elliptic cone, as follows:\n\n$$\n\\begin{aligned}(x+1)^{2}+\\frac{{0}^{2}}{6} & =(z-1)^{2} \\\\ (x+1)^{2} & =(z-1)^{2} \\\\ \\pm (x+1) & =z-1 \\\\ z & =\\pm (x+1)+1\\end{aligned}\n$$\n\nThis gives us two lines in the $xz$-plane with equations $z=-x$ and $z=x+2.$"}] [{:db/id #edb/ref 17592186360458 :knowledge-point/_questions [{:db/id #edb/ref 17592186124585 :knowledge-point/id #uuid "2e0b4012-403b-5739-8f33-3c79111129fd" :knowledge-point/title "Identifying Properties of Elliptic Cones"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14c5f76f-0051-5652-b48e-b8ff67efd071" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0,0)$ only" :db/id #edb/ref 17592186357934} {:answer/id #uuid "89a2c827-79ca-5602-af08-71555ec771ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0,1)$ only" :db/id #edb/ref 17592186358954} {:answer/id #uuid "8d3a393e-37f0-5c2b-aa03-b8be18fcc898" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0,0)$ and $(0,0,3)$" :db/id #edb/ref 17592186358981} {:answer/id #uuid "976b94c2-5e24-5e66-90ba-b591b2155b49" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0,3)$ only" :db/id #edb/ref 17592186359078} {:answer/id #uuid "c5b2f211-6a10-5399-a99b-c813f6681ba8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0,1)$ and $(0,0,9)$" :db/id #edb/ref 17592186359487}] :answer-field/correct {:answer/id #uuid "14c5f76f-0051-5652-b48e-b8ff67efd071" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0,0)$ only" :db/id #edb/ref 17592186357934} :answer-field/id #uuid "5141b358-1995-5144-a4ba-ba1b2ec27fb6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360121}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9922d0a8-63a6-5f94-b280-3937a6da1add" :question/math-academy-id "q-94605" :question/problem "Given the elliptic cone $\\frac{{x}^{2}}{2}+\\frac{{y}^{2}}{9}={z}^{2},$ find its intercept with the $z$-axis." :question/worked-solution "To find the $z$-intercept of the elliptic cone, we plug $x=0$ and $y=0$ into the equation and solve for $z:$\n\n$$\n\\begin{aligned}\\frac{{0}^{2}}{2}+\\frac{{0}^{2}}{9} & ={z}^{2} \\\\ 0+0 & ={z}^{2} \\\\ {z}^{2} & =0 \\\\ z & =0\\end{aligned}\n$$\n\nTherefore, the intercept with the $z$-axis is $(0,0,0)$ only."}] [{:db/id #edb/ref 17592186399275 :knowledge-point/_questions [{:db/id #edb/ref 17592186124585 :knowledge-point/id #uuid "2e0b4012-403b-5739-8f33-3c79111129fd" :knowledge-point/title "Identifying Properties of Elliptic Cones"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "067751b8-d9b0-5947-868e-d67de8882ded" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(10,4,0)" :db/id #edb/ref 17592186399277} {:answer/id #uuid "4dbc0f20-e5f6-5a52-a355-67a35255c6ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,4,0)" :db/id #edb/ref 17592186399278} {:answer/id #uuid "a552dd66-26cc-5d78-8f7f-b71e1309952a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,5,0)" :db/id #edb/ref 17592186399279} {:answer/id #uuid "49d58c58-ca20-5f66-a319-cbbd744cd1bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,10,1)" :db/id #edb/ref 17592186399280} {:answer/id #uuid "6429d9be-dd6f-5794-a79d-50e42b99b671" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,2,0)" :db/id #edb/ref 17592186399281}] :answer-field/correct {:answer/id #uuid "4dbc0f20-e5f6-5a52-a355-67a35255c6ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,4,0)" :db/id #edb/ref 17592186399278} :answer-field/id #uuid "27aca539-4253-563c-9949-e198ffdfa1f2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399276}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8ed2d339-1669-5c85-b00e-540acdbbec95" :question/math-academy-id "q-94609" :question/problem "Find the center of the elliptic cone $4(x-1)^{2}+10(y-4)^{2}={z}^{2}.$" :question/worked-solution "The general equation of an elliptic cone with center at the point $({x}_{0},{y}_{0},{z}_{0})$ is\n\n$$\n\\frac{(x-{x}_{0})^{2}}{{a}^{2}}+\\frac{(y-{y}_{0})^{2}}{{b}^{2}}=\\frac{(z-{z}_{0})^{2}}{{c}^{2}}.\n$$\n\nTo find the center, we rewrite our equation in standard form, as follows:\n\n$$\n\\begin{aligned}4(x-1)^{2}+10(y-4)^{2} & =(z-0)^{2} \\\\ \\frac{(x-1)^{2}}{1/4}+\\frac{(y-4)^{2}}{1/10} & =(z-0)^{2}\\end{aligned}\n$$\n\nThis gives us the equation of an elliptic cone that has its center at $(1,4,0).$"}] [{:db/id #edb/ref 17592186360474 :knowledge-point/_questions [{:db/id #edb/ref 17592186124585 :knowledge-point/id #uuid "2e0b4012-403b-5739-8f33-3c79111129fd" :knowledge-point/title "Identifying Properties of Elliptic Cones"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1914ab91-6a75-5d7b-ac54-c6c5c609204a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-9,-4,0)" :db/id #edb/ref 17592186357972} {:answer/id #uuid "a736b48f-c47a-5bdf-8f73-2d263ed74aa5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,2,0)" :db/id #edb/ref 17592186359196} {:answer/id #uuid "d6789eb3-66d3-5840-a659-9de53369a8a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,-2,0)" :db/id #edb/ref 17592186359630} {:answer/id #uuid "f733234b-c9da-5b3f-9864-e12cb8775305" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,9,0)" :db/id #edb/ref 17592186359940} {:answer/id #uuid "fba28296-1cb3-5a3a-ad8a-09bf2b4a82bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(9,4,1)" :db/id #edb/ref 17592186359976}] :answer-field/correct {:answer/id #uuid "d6789eb3-66d3-5840-a659-9de53369a8a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,-2,0)" :db/id #edb/ref 17592186359630} :answer-field/id #uuid "76cb8fa1-c82a-51d3-bd4d-937f448d66c1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360188}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b8a937fd-a8d7-55e4-aa58-5b69cf851776" :question/math-academy-id "q-94698" :question/problem "Find the center of the elliptic cone $9(x+3)^{2}+4(y+2)^{2}={z}^{2}.$" :question/worked-solution "The general equation of an elliptic cone with center at the point $({x}_{0},{y}_{0},{z}_{0})$ is\n\n$$\n\\frac{(x-{x}_{0})^{2}}{{a}^{2}}+\\frac{(y-{y}_{0})^{2}}{{b}^{2}}=\\frac{(z-{z}_{0})^{2}}{{c}^{2}}.\n$$\n\nTo find the center, we rewrite our equation in standard form, as follows:\n\n$$\n\\begin{aligned}9(x+3)^{2}+4(y+2)^{2} & =(z-0)^{2} \\\\ \\frac{(x+3)^{2}}{1/9}+\\frac{(y+2)^{2}}{1/4} & =(z-0)^{2} \\\\ \\frac{(x-(-3))^{2}}{1/9}+\\frac{(y-(-2))^{2}}{1/4} & =(z-0)^{2}\\end{aligned}\n$$\n\nThis gives us the equation of an elliptic cone that has its center at $(-3,-2,0).$"}]}
