-5f5a-8c75-137feef51656" #edb/ref 17592186045417] [17592186344663 #edb/ref 1075 #edb/ref 17592186343404 #edb/ref 17592186045417] [17592186344663 #edb/ref 1075 #edb/ref 17592186343453 #edb/ref 17592186045417] [17592186344663 #edb/ref 1075 #edb/ref 17592186343537 #edb/ref 17592186045417] [17592186344663 #edb/ref 1075 #edb/ref 17592186343882 #edb/ref 17592186045417] [17592186344663 #edb/ref 1075 #edb/ref 17592186344027 #edb/ref 17592186045417] [17592186344663 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186344663 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186344663 #edb/ref 1078 #edb/ref 17592186343882 #edb/ref 17592186045417] [17592186344663 #edb/ref 1079 #uuid "64b9b0ff-fd08-5eb8-b6af-63a9135b0943" #edb/ref 17592186045417] [17592186345041 #edb/ref 1068 #edb/ref 17592186344663 #edb/ref 17592186045417] [17592186345041 #edb/ref 1069 "q-75186" #edb/ref 17592186045417] [17592186345041 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186345041 #edb/ref 1071 "Let $R=[3,5]\\times [1,3]$ be a region in the $xy$-plane, and let $f(x,y)={x}^{2}+3{y}^{2}-2.$\nFurther, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{3,4,5\\},\\,{P}_{2}=\\{1,2,3\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nCalculate the upper Riemann sum $U(f,P).$" #edb/ref 17592186045417] [17592186345041 #edb/ref 1072 #uuid "ac66a4bf-23ac-55ea-9e60-f731c8811568" #edb/ref 17592186045417] [17592186345041 #edb/ref 1074 "First, let's draw the region $R$ and the partition $P.$\n\n![](images/ed/ed8a998b543cb951a12599de55004c9220a53ac252a9eea66577475e2b8b6093.png)\n\nThe upper sum $U(f,P)$ is given by\n\n$$\nU(f,P)={M}_{11}\\cdot \\text{Area}({R}_{11})+{M}_{21}\\cdot \\text{Area}({R}_{21})+{M}_{12}\\cdot \\text{Area}({R}_{12})+{M}_{22}\\cdot \\text{Area}({R}_{22}),\n$$\n\nwhere ${M}_{ij}$ is the *maximum* value of $f$ in each subregion ${R}_{ij}.$ We pick the *maximum* value of $f$ because we're finding the *upper* sum.\n\nTaking into account the fact that $\\text{Area}({R}_{ij})=1$ for all $4$ subregions, the formula for $U(f,P)$ reduces to\n\n$$\nU(f,P)={M}_{11}+{M}_{21}+{M}_{12}+{M}_{22}.\n$$\n\nNow, notice that\n\n- $f(x,y)={x}^{2}+3{y}^{2}-2$ increases as $x$ increases, and\n\n- $f(x,y)={x}^{2}+3{y}^{2}-2$ increases as $y$ increases.\n\n![](images/a0/a0033237f985416771125780a3d9b68bdfd8c6c33b9a4b0f2a32fa7af4c59bca.png)\n\nAs a result, the *maximum* value of $f$ in each subregion is attained when we have the *largest* possible $x$ and the *largest* possible $y.$ This is the value at the *top right corner* of each subregion.\n\n![](images/26/26cae8b6e2c69c2c0c66d78eb64c5d02fc500d10a970e54b09f6ee72bc145b74.png)\n\nHence:\n\n$$\n\\begin{aligned}{M}_{11} & =f(4,2)=26 \\\\ {M}_{21} & =f(5,2)=35 \\\\ {M}_{12} & =f(4,3)=41 \\\\ {M}_{22} & =f(5,3)=50\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}U(f,P) & =26+35+41+50 \\\\  & =152.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186345052 #edb/ref 1068 #edb/ref 17592186344572 #edb/ref 17592186045417] [17592186345052 #edb/ref 1069 "q-75232" #edb/ref 17592186045417] [17592186345052 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186345052 #edb/ref 1071 "Let $R=[1,3]\\times [2,4]$ be a region in the $xy$-plane, and let $f(x,y)=30-{x}^{2}-{y}^{2}.$\nFurther, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{1,2,3\\},\\,{P}_{2}=\\{2,3,4\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nCalculate the upper Riemann sum $U(f,P).$" #edb/ref 17592186045417] [17592186345052 #edb/ref 1072 #uuid "0513b4b6-45e5-5932-9fea-20a970dbf3e2" #edb/ref 17592186045417] [17592186345052 #edb/ref 1074 "First, let's draw the region $R$ and the partition $P.$\n\n![](images/b7/b7581f31a2031181aeb31bbdf8a3da6beff69b50ee41d5d73babbe198997fe15.png)\n\nThe upper sum $U(f,P)$ is given by\n\n$$\nU(f,P)={M}_{11}\\cdot \\text{Area}({R}_{11})+{M}_{21}\\cdot \\text{Area}({R}_{21})+{M}_{12}\\cdot \\text{Area}({R}_{12})+{M}_{22}\\cdot \\text{Area}({R}_{22}),\n$$\n\nwhere ${M}_{ij}$ is the *maximum* value of $f$ in each subregion ${R}_{ij}.$ We pick the *maximum* value of $f$ because we're finding the *upper* sum.\n\nTaking into account the fact that $\\text{Area}({R}_{ij})=1$ for all $4$ subregions, the formula for $U(f,P)$ reduces to\n\n$$\nU(f,P)={M}_{11}+{M}_{21}+{M}_{12}+{M}_{22}.\n$$\n\nNow, notice that\n\n- $f(x,y)=30-{x}^{2}-{y}^{2}$ decreases as $x$ increases, and\n\n- $f(x,y)=30-{x}^{2}-{y}^{2}$ decreases as $y$ increases.\n\n![](images/df/dfed66710976869aa4507aea2e171c09ac248d4b8b4ca083972dbd10952af6b7.png)\n\nAs a result, the *maximum* value of $f$in each subregion is attained when we have the *smallest* possible $x$ and the *smallest* possible $y.$ This is the value at the *bottom left corner* of each subregion.\n\n![](images/a6/a6366799e116eb35e8d3cb5401f0abc161ad183cd8f634bdaf2ce387f64d6c5c.png)\n\nHence,\n\n$$\n\\begin{aligned}{M}_{11} & =f(1,2)=25 \\\\ {M}_{21} & =f(2,2)=22 \\\\ {M}_{12} & =f(1,3)=20 \\\\ {M}_{22} & =f(2,3)=17\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}U(f,P) & =25+22+20+17 \\\\  & =84.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186542637 #edb/ref 1080 "6{M}_{11}+{M}_{21}+{M}_{12}+6{M}_{22}" #edb/ref 17592186045417] [17592186542637 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186542637 #edb/ref 1083 #uuid "00ec49a8-4c66-57e0-837c-295202d2c300" #edb/ref 17592186045417] [17592186542680 #edb/ref 1080 "3{M}_{11}+{M}_{21}+{M}_{12}+{M}_{22}" #edb/ref 17592186045417] [17592186542680 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186542680 #edb/ref 1083 #uuid "11523a51-2013-50cb-87e8-a988018c32d1" #edb/ref 17592186045417] [17592186542687 #edb/ref 1080 "2{M}_{11}+2{M}_{21}+3{M}_{12}+3{M}_{22}" #edb/ref 17592186045417] [17592186542687 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186542687 #edb/ref 1083 #uuid "12cae175-9eb8-52ec-b5ee-cca018af75f3" #edb/ref 17592186045417] [17592186542698 #ed