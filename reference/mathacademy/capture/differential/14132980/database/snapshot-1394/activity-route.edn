db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186287476} {:answer-field/choices [{:answer/id #uuid "45d487e7-1742-53ae-be21-469aa4bff9b6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{C}^{2}" :db/id #edb/ref 17592186285425} {:answer/id #uuid "87cc8c11-27f3-5e7e-b5d2-386af787bfd2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "N" :db/id #edb/ref 17592186286032} {:answer/id #uuid "b7fc55ab-1062-5f39-acf4-d76d7e532407" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "C" :db/id #edb/ref 17592186286466} {:answer/id #uuid "e3eb8bec-05bd-58b9-bdef-af8fc2e351ba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "R" :db/id #edb/ref 17592186286869} {:answer/id #uuid "f15842a0-05a0-5a30-b462-379a40b3881c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}^{2}" :db/id #edb/ref 17592186287003}] :answer-field/correct {:db/id #edb/ref 17592186287003} :answer-field/id #uuid "c0109b88-cf7d-55d0-b4c5-b83e47d2bf41" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186287542}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b635e983-fa39-5831-8b68-a64de13e9b19" :question/math-academy-id "q-181679" :question/problem "![](images/71/718ee39f4a0b2e9cca18ed4de77271a90139b13e8b71990611c1e13357245713.png)\n\nDescribe the shaded region shown above using set-builder notation.\n\n$$\n\\{(x,y)\\in {{field-1}}\\,:\\,y\\,{{field-2}}\\,-x+5,\\,y\\,{{field-3}}\\,x+3\\}\n$$" :question/worked-solution "The points in our set include all those that lie *below* the line $y=-x+5$ and *below* the line $y=x+3.$\n\nA point $P(x,y)$ lies *inside* the shaded region if the following conditions are satisfied:\n\n$$\ny<-x+5,\\,y<x+3.\n$$\n\nSince the boundary is not included in the set (the lines are dashed), the inequalities are strict.\n\nMoreover, since we're considering *every* real value in this region, $x\\in R,y\\in R,$ and therefore \n\n$$\n(x,y)\\in R\\times R={R}^{2}.\n$$\n\nTherefore, we can write the set as\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,y<-x+5,\\,y<x+3\\}.\n$$"} :step/id #uuid "e6e88b64-a83f-57fe-835a-1fb9edfecbe0" :step/next {:db/id #edb/ref 17592186433495}}] :activity/title "Describing Planar Regions Using Set-Builder Notation" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186433479}]}
