#{[{:db/id #edb/ref 17592186398347 :knowledge-point/_questions [{:db/id #edb/ref 17592186119935 :knowledge-point/id #uuid "3061cb06-f57f-57c8-8821-dbd962b1e78e" :knowledge-point/title "Finding the Parametric Equation of the Plane Parallel To Two Lines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c55c069-4c02-5970-a366-2d87c0faefc8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨1,5,13⟩+s⟨4,4,1⟩+t⟨5,5,-3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186398349} {:answer/id #uuid "e1c9d880-a1e1-5be5-8507-819f78ea66e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨1,8,11⟩+s⟨-3,4,1⟩+t⟨2,3,-3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186398350} {:answer/id #uuid "ee62040f-08f9-5abf-8ec9-6681c3d75424" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨1,5,13⟩+s⟨4,-2,1⟩+t⟨3,5,-2⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186398351} {:answer/id #uuid "fd9a749a-2d90-567b-9b9e-9eea1e14d989" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨1,5,13⟩+s⟨-2,4,1⟩+t⟨2,5,-3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186398352} {:answer/id #uuid "3fbcf038-f3dc-5a71-b0c2-b0f15532c018" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨1,5,11⟩+s⟨2,4,1⟩+t⟨2,3,-5⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186398353}] :answer-field/correct {:answer/id #uuid "fd9a749a-2d90-567b-9b9e-9eea1e14d989" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨1,5,13⟩+s⟨-2,4,1⟩+t⟨2,5,-3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186398352} :answer-field/id #uuid "f112cd0f-0678-5784-90d3-7e1ee7077df9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398348}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0fce542a-476c-5ad1-ad5a-b30b8a4bb006" :question/math-academy-id "q-128499" :question/problem "Find a parametric equation of the plane that passes through the point $B(1,5,13)$ and is parallel to the lines $r=⟨-7,12,5⟩+s⟨-2,4,1⟩$ and $r=⟨-9,21,2⟩+t⟨2,5,-3⟩.$" :question/worked-solution "The direction vectors of the lines are ${v}_{1}=⟨-2,4,1⟩$ and ${v}_{2}=⟨2,5,-3⟩$, respectively. These vectors are parallel to the plane but not to each other.\n\nWe also know that the point $B(1,5,13)$ lies on the plane and its position vector is $b=⟨1,5,13⟩.$  \n\nSo, the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =b+s{v}_{1}+t{v}_{2} \\\\ r & =⟨1,5,13⟩+s⟨-2,4,1⟩+t⟨2,5,-3⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$\n\n$$\n\n$$"}] [{:db/id #edb/ref 17592186120219 :knowledge-point/_questions [{:db/id #edb/ref 17592186119936 :knowledge-point/id #uuid "d11f13f0-1cfa-59ec-a04a-9483d942b1aa" :knowledge-point/title "Finding the Parametric Equation of the Plane Passing Through Three Given Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e39cb606-c863-581e-9ff9-2728265a795f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The plane is undefined" :db/id #edb/ref 17592186117477} {:answer/id #uuid "54e5a00f-239b-539d-9f9b-5957f11c633b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨6,0,2⟩+s⟨3,1,-2⟩+t⟨6,0,2⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186489715} {:answer/id #uuid "6842561b-d1ec-5753-b48f-a0a96c8d26d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨6,0,2⟩+s⟨6,0,2⟩+t⟨1,1,3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186489762} {:answer/id #uuid "6ea6b719-d65e-5d67-8999-88b13c999f44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨6,0,2⟩+s⟨3,1,-2⟩+t⟨1,1,3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186489776} {:answer/id #uuid "e994da9e-a986-53ac-b530-86db42005ecc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨6,0,2⟩+s⟨3,1,-2⟩+t⟨-5,1,1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186490021}] :answer-field/correct {:answer/id #uuid "e994da9e-a986-53ac-b530-86db42005ecc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨6,0,2⟩+s⟨3,1,-2⟩+t⟨-5,1,1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186490021} :answer-field/id #uuid "54de0330-8cb1-5db4-9316-aaffcc0d2f4f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186117475}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "71d2a1f8-b97c-598b-abe7-896238f620c0" :question/math-academy-id "q-32989" :question/problem "Find a parametric equation of the plane that passes through the points $A(6,0,2)$ and $B(1,1,3)$, and is parallel to the vector $v=⟨3,1,-2⟩.$" :question/worked-solution "First, we need to find two vectors that are parallel to the plane (but not to each other). We already have one vector $v=⟨3,1,-2⟩.$ Let's also use the displacement vector $\\overset{\\to }{AB}$, as follows:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =⟨1,1,3⟩-⟨6,0,2⟩ \\\\  & =⟨-5,1,1⟩\\end{aligned}\n$$\n\nNow, if we consider the position vector $a=⟨6,0,2⟩$ of the point $A,$ then the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =a+sv+t\\overset{\\to }{AB} \\\\ r & =⟨6,0,2⟩+s⟨3,1,-2⟩+t⟨-5,1,1⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186311921 :knowledge-point/_questions [{:db/id #edb/ref 17592186119934 :knowledge-point/id #uuid "62196ae9-df2e-5a3a-bc0a-1c0f4c40af3e" :knowledge-point/title "Finding a Normal Vector To a Plane Given by Parametric Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3999a87b-f882-5ca7-9260-d448846a37d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-3,5,4⟩" :db/id #edb/ref 17592186309187} {:answer/id #uuid "39a5a717-471c-5a17-834f-af512678a057" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-13,33,-14⟩" :db/id #edb/ref 17592186309188} {:answer/id #uuid "7600e36d-9294-520d-95e5-38e4fd4ac988" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-12,21,-4⟩" :db/id #edb/ref 17592186309669} {:answer/id #uuid "9bc1f13f-1145-50d7-80ea-c9565ed86989" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-33,13,-41⟩" :db/id #edb/ref 17592186310008} {:answer/id #uuid "fe53bf4d-a431-5742-8703-83bd73a22ce3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨4,7,-1⟩" :db/id #edb/ref 17592186310782}] :answer-field/correct {:answer/id #uuid "9bc1f13f-1145-50d7-80ea-c9565ed86989" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-33,13,-41⟩" :db/id #edb/ref 17592186310008} :answer-field/id #uuid "86549ea0-3e13-5e9e-9d1d-fbd94e79de20" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186311169}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8c5d0e74-0671-5cb7-b3b8-23383905b037" :question/math-academy-id "q-33819" :question/problem "Find a normal vector to the plane\n\n$$\nr=[\\begin{aligned}-2 \\\\ 23 \\\\ 14\\end{aligned}]+t[\\begin{aligned}-3 \\\\ 5 \\\\ 4\\end{aligned}]+s[\\begin{aligned}4 \\\\ 7 \\\\ -1\\end{aligned}],\\,t,\\,s\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "From the parametric equation, we have that $v=⟨-3,5,4⟩$ and $w=⟨4,7,-1⟩$ are parallel to the plane.\n\nNow, we need to find a normal vector of the plane. To do that, we use the cross product of $v$ and $w$ as follows:\n\n$$\n\\begin{aligned}n & =v\\times w \\\\  & =[\\begin{aligned}-3 \\\\ 5 \\\\ 4\\end{aligned}]\\times [\\begin{aligned}4 \\\\ 7 \\\\ -1\\end{aligned}] \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ -3 & 5 & 4 \\\\ 4 & 7 & -1\\end{aligned}\\right| \\\\  & =-33i+13j-41k \\\\  & =⟨-33,13,-41⟩.\\end{aligned}\n$$\n\nTherefore, a normal vector to the plane is $n=⟨-33,13,-41⟩.$"}] [{:db/id #edb/ref 17592186490266 :knowledge-point/_questions [{:db/id #edb/ref 17592186119934 :knowledge-point/id #uuid "62196ae9-df2e-5a3a-bc0a-1c0f4c40af3e" :knowledge-point/title "Finding a Normal Vector To a Plane Given by Parametric Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "426d2f86-6e44-5b72-8222-a1d8c826de45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-3,-5,7⟩" :db/id #edb/ref 17592186489666} {:answer/id #uuid "5ee143c1-2d22-5a6b-8226-53337f0c9aa5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-1,1,7⟩" :db/id #edb/ref 17592186489742} {:answer/id #uuid "81af70fa-ea19-54cc-83e0-b0a21fab95e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-34,-22,8⟩" :db/id #edb/ref 17592186489809} {:answer/id #uuid "87ba8eac-d335-511b-94ef-29242597cc39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨3,-5,1⟩" :db/id #edb/ref 17592186489824} {:answer/id #uuid "a52411c7-786b-5482-9881-e7a8a452b864" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨36,22,2⟩" :db/id #edb/ref 17592186489882}] :answer-field/correct {:answer/id #uuid "a52411c7-786b-5482-9881-e7a8a452b864" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨36,22,2⟩" :db/id #edb/ref 17592186489882} :answer-field/id #uuid "8bf0e22c-7173-584a-ae1b-a7c0bd01e586" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490153}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7340caf5-7f57-5ed9-b918-72cd124f498f" :question/math-academy-id "q-70975" :question/problem "Find a normal vector to the plane\n\n$$\nr=⟨0,8,-1⟩+t⟨-1,1,7⟩+s⟨3,-5,1⟩,\\,t,\\,s\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "From the parametric equation, we have that $v=⟨-1,1,7⟩$ and $w=⟨3,-5,1⟩$ are parallel to the plane.\n\nNow, we need to find a normal vector of the plane. To do that, we use the cross product of $v$ and $w$ as follows:\n\n$$\n\\begin{aligned}n & =v\\times w \\\\  & =[\\begin{aligned}-1 \\\\ 1 \\\\ 7\\end{aligned}]\\times [\\begin{aligned}3 \\\\ -5 \\\\ 1\\end{aligned}] \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ -1 & 1 & 7 \\\\ 3 & -5 & 1\\end{aligned}\\right| \\\\  & =36i+22j+2k \\\\  & =⟨36,22,2⟩.\\end{aligned}\n$$\n\nTherefore, a normal vector to the plane is $n=⟨36,22,2⟩.$"}] [{:db/id #edb/ref 17592186393064 :knowledge-point/_questions [{:db/id #edb/ref 17592186119936 :knowledge-point/id #uuid "d11f13f0-1cfa-59ec-a04a-9483d942b1aa" :knowledge-point/title "Finding the Parametric Equation of the Plane Passing Through Three Given Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11fe6c60-77f7-596d-b73e-0a2b1a46b507" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨3,6,2⟩+s⟨-1,-15,-2⟩+t⟨2,-9,0⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186393066} {:answer/id #uuid "18c27f61-10ac-5e9a-9262-ba682e6d266e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The plane is undefined" :db/id #edb/ref 17592186393067} {:answer/id #uuid "a673c983-c8f1-5b15-8abb-116913587299" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨3,6,2⟩+s⟨-1,-15,-2⟩+t⟨0,-6,-1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186393068} {:answer/id #uuid "f377602b-aa7b-52c3-8d62-a25cd478c050" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨3,6,2⟩+s⟨0,-6,-1⟩+t⟨3,0,1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186393069} {:answer/id #uuid "37a16cbe-c7b9-5d98-99c1-895ad8adbfef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨3,6,2⟩+s⟨2,-9,0⟩+t⟨3,0,1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186393070}] :answer-field/correct {:answer/id #uuid "a673c983-c8f1-5b15-8abb-116913587299" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨3,6,2⟩+s⟨-1,-15,-2⟩+t⟨0,-6,-1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186393068} :answer-field/id #uuid "141932d6-a6f5-58b4-ba12-7fe47a40ab43" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393065}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "901f1360-df93-5e5e-ac60-c5607de4f628" :question/math-academy-id "q-71036" :question/problem "Find a parametric equation of the plane that passes through the points $P(3,6,2),\\,Q(2,-9,0)$, and $R(3,0,1).$" :question/worked-solution "First, we need to find two vectors that are parallel to the plane (but not to each other). Let's use the displacement vectors $\\overset{\\to }{PQ}$ and $\\overset{\\to }{PR},$ as follows:\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨2,-9,0⟩-⟨3,6,2⟩ \\\\  & =⟨-1,-15,-2⟩ \\\\ \\overset{\\to }{PR} & =⟨3,0,1⟩-⟨3,6,2⟩ \\\\  & =⟨0,-6,-1⟩\\end{aligned}\n$$\n\nNow, if we consider the position vector $p=⟨3,6,2⟩$ of the point $P,$ then the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =p+s\\overset{\\to }{PQ}+t\\overset{\\to }{PR} \\\\ r & =⟨3,6,2⟩+s⟨-1,-15,-2⟩+t⟨0,-6,-1⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}]}
