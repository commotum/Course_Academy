#{[{:db/id #edb/ref 17592186332750 :knowledge-point/_questions [{:db/id #edb/ref 17592186100818 :knowledge-point/id #uuid "37a7aff6-d1b2-5383-bb26-aa6363594b05" :knowledge-point/title "Evaluating Definite Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f292278-673c-5eba-880c-7cda055f8171" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}\\operatorname{ln}⁡3}{3}" :db/id #edb/ref 17592186330511} {:answer/id #uuid "5dac8132-bf52-5344-825a-5d6616a1cdd2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{ln}⁡3}{2}" :db/id #edb/ref 17592186330784} {:answer/id #uuid "83aeb76a-c46c-5da9-b6b1-d3b2c07f5e3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\operatorname{ln}⁡3}{3}" :db/id #edb/ref 17592186331119} {:answer/id #uuid "884a0de8-2fb3-540c-834e-7021c6f3a3b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\operatorname{ln}⁡3}{2}" :db/id #edb/ref 17592186331163} {:answer/id #uuid "dc4580e3-6e2d-5fe8-9d8c-28fc47a327cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{ln}⁡2}{3}" :db/id #edb/ref 17592186331902}] :answer-field/correct {:answer/id #uuid "5dac8132-bf52-5344-825a-5d6616a1cdd2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{ln}⁡3}{2}" :db/id #edb/ref 17592186330784} :answer-field/id #uuid "d90e8da3-8c2b-5ff0-aa8c-d768bd2f0c85" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332582}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "06ae8c49-a573-55e1-8d24-c78494f9b5b0" :question/math-academy-id "q-49606" :question/problem "What is the value of ${\\int }_{e}^{{e}^{3}}\\frac{\\sqrt{3}}{2x\\operatorname{ln}⁡x}\\,\\text{d}x?$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $e$ | ${e}^{3}$ |\n| --- | --- | --- |\n| $u$ | $1$ | $3$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{e}^{{e}^{3}}\\frac{\\sqrt{3}}{2x\\operatorname{ln}⁡x}\\,\\text{d}x & =\\frac{\\sqrt{3}}{2}{\\int }_{e}^{{e}^{3}}\\frac{1}{\\operatorname{ln}⁡x}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{\\sqrt{3}}{2}{\\int }_{1}^{3}\\frac{1}{u}\\cdot \\text{d}u \\\\  & =\\frac{\\sqrt{3}}{2}(\\operatorname{ln}⁡|u|){|}_{1}^{3} \\\\  & =\\frac{\\sqrt{3}}{2}(\\operatorname{ln}⁡3-\\operatorname{ln}⁡1) \\\\  & =\\frac{\\sqrt{3}\\operatorname{ln}⁡3}{2}\\end{aligned}\\end{aligned}\n$$"}]}
