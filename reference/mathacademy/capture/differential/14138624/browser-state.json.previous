      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14138624/observations/step-q361712-f82186160a7d4f1ffc0b.png",
      "source_url": "https://mathacademy.com/tasks/14138624/topics/1038/lesson",
      "captured_at": 1791818479.0329533,
      "math_academy_id": "q-361712",
