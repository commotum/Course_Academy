le><mo data-mjx-texclass=\"CLOSE\">|</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">|</mo><mtable columnalign=\"center\" columnspacing=\"1em\" rowspacing=\"4pt\"><mtr><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>2</mn><mrow><mn>2</mn><mi>u</mi><mo>+</mo><mi>v</mi></mrow></mfrac></mstyle></mtd><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mrow><mn>2</mn><mi>u</mi><mo>+</mo><mi>v</mi></mrow></mfrac></mstyle></mtd></mtr><mtr><mtd><mstyle scriptlevel=\"0\"><mspace width=\"1em\"></mspace></mstyle><mtext>&nbsp;</mtext><mi>v</mi><mstyle scriptlevel=\"0\"><mspace width=\"1em\"></mspace></mstyle></mtd><mtd><mstyle scriptlevel=\"0\"><mspace width=\"1em\"></mspace></mstyle><mtext>&nbsp;</mtext><mi>u</mi></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">|</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>2</mn><mrow><mn>2</mn><mi>u</mi><mo>+</mo><mi>v</mi></mrow></mfrac></mstyle><mo>⋅</mo><mi>u</mi><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mrow><mn>2</mn><mi>u</mi><mo>+</mo><mi>v</mi></mrow></mfrac></mstyle><mo>⋅</mo><mi>v</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mfrac><mrow><mn>2</mn><mi>u</mi><mo>−</mo><mi>v</mi></mrow><mrow><mn>2</mn><mi>u</mi><mo>+</mo><mi>v</mi></mrow></mfrac><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
