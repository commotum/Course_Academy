#{[{:db/id #edb/ref 17592186129503 :knowledge-point/_questions [{:db/id #edb/ref 17592186129283 :knowledge-point/id #uuid "091b8235-56d8-5a08-bc95-08c99772cfd8" :knowledge-point/title "Finding Regions Where a Transformation is Orientation-Preserving or Reversing"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "061056bc-bfce-5ff4-8595-a2d484ecafcd" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/09/09f7f36ecc2197cc95e1878fa22ac22367978809a5241f09886a7eb2fab071f3.png" :db/id #edb/ref 17592186275531} {:answer/id #uuid "16f3a484-24df-5d26-8a99-6de6aa5fdb49" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/15/154f70201a5a00737d8df61952f5600ff91a2373df07b0b54680fe84e048402c.png" :db/id #edb/ref 17592186275690} {:answer/id #uuid "5d63b3ec-601c-5feb-8242-cbcc9d6062a7" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d4/d477a9f312fc2fb0a5a4c2d13164c96118aa70b53cf23db80be9ec698151e6fd.png" :db/id #edb/ref 17592186276310} {:answer/id #uuid "9cb5eb91-0daf-521c-91f4-9877e03fe3e3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/30/3033f0ae73e3f484fc5d3d65e388062feba1824fb3da9971d560cf2f518f49bb.png" :db/id #edb/ref 17592186276885} {:answer/id #uuid "ff869b8f-3276-5ccb-a221-37224323880c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/fe/fe7bb422a3f992ea88a900e63b2c55df99bce3a785929901c248abadfadf23f1.png" :db/id #edb/ref 17592186277723}] :answer-field/correct {:answer/id #uuid "061056bc-bfce-5ff4-8595-a2d484ecafcd" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/09/09f7f36ecc2197cc95e1878fa22ac22367978809a5241f09886a7eb2fab071f3.png" :db/id #edb/ref 17592186275531} :answer-field/id #uuid "cd317045-c8ee-5fc6-a8f1-218f77e90e7e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278085}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f5ab6f10-630f-5f61-bd52-33e1fa95452d" :question/math-academy-id "q-160341" :question/problem "Which of the following shows the region in the $uv$-plane where the transformation $T,$ given by \n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}{u}^{2}-2{v}^{2} \\\\ u-v\\end{bmatrix},\n$$\n\nis (locally) orientation-reversing?" :question/worked-solution "Recall that a transformation is (locally) orientation-reversing at the points where the Jacobian determinant is negative:\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}<0\n$$\n\nWe have\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}{u}^{2}-2{v}^{2} \\\\ u-v\\end{bmatrix}.\n$$\n\nComputing the corresponding Jacobian determinant, we obtain \n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{vmatrix} \\\\  & =\\begin{vmatrix}2u & -4v \\\\ 1 & -1\\end{vmatrix} \\\\  & =2u\\cdot (-1)-(-4v)\\cdot 1 \\\\  & =-2u+4v.\\end{aligned}\n$$\n\nTo find the required regions, we solve the following inequality:\n\n$$\n\\begin{aligned}-2u+4v & <0 \\\\ 4v & <2u \\\\ v & <\\frac{1}{2}u\\end{aligned}\n$$\n\n \n\nNotice that the equation \n\n$$\nv=\\frac{1}{2}u\n$$\n\ndefines a straight line, and the coordinates of, say, $(1,-1)$ satisfy the inequality. \n\nTherefore, the region where the transformation is (locally) orientation-reversing must be the following:\n\n![](images/09/09f7f36ecc2197cc95e1878fa22ac22367978809a5241f09886a7eb2fab071f3.png)"}] [{:db/id #edb/ref 17592186278288 :knowledge-point/_questions [{:db/id #edb/ref 17592186129263 :knowledge-point/id #uuid "ab643519-92a4-5ccf-b826-fb2a68b36534" :knowledge-point/title "Evaluating a Jacobian Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27184dd5-9306-5151-ba71-71c0184555b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186275833} {:answer/id #uuid "921684d8-1a85-53da-b8a7-23bd356d4d8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186276799} {:answer/id #uuid "a6b6ecd9-7efa-5fbf-99f4-87cf3cf2fc2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186276980} {:answer/id #uuid "a9f4d180-9148-56f8-af89-c87393729376" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186277007} {:answer/id #uuid "bc4ef6cf-c02f-531a-934f-84c5afac9290" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186277153}] :answer-field/correct {:answer/id #uuid "921684d8-1a85-53da-b8a7-23bd356d4d8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186276799} :answer-field/id #uuid "3f823688-c59b-5a64-9e51-9b7c368087e1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277821}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2b1f8f7b-fd82-5c84-a276-7fa2fd9b071a" :question/math-academy-id "q-160383" :question/problem "For the transformation $T,$ defined as \n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}uv \\\\ \\frac{v}{u}\\end{bmatrix}\n$$\n\n \n\ncompute the value of the Jacobian determinant at the point where $\\begin{bmatrix}u \\\\ v\\end{bmatrix}=\\begin{bmatrix}-2 \\\\ 3\\end{bmatrix}.$" :question/worked-solution "Given a transformation \n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}\\to \\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix},\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y)}{∂(u,v)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{vmatrix}.\\end{aligned}\n$$\n\nHere, we have $x=uv$ and $y=\\frac{v}{u}.$ \n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & =v & \\,\\frac{∂x}{∂v} & =u \\\\ \\frac{∂y}{∂u} & =-\\frac{v}{{u}^{2}} & \\,\\frac{∂y}{∂v} & =\\frac{1}{u}\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{vmatrix} \\\\  & =\\begin{vmatrix}v & u \\\\ -\\frac{v}{{u}^{2}}\\, & \\frac{1}{u}\\end{vmatrix} \\\\  & =v\\cdot \\frac{1}{u}\\text{ }-u\\cdot (-\\frac{v}{{u}^{2}}) \\\\  & =\\frac{2v}{u}.\\end{aligned}\n$$\n\nFinally, when $\\begin{bmatrix}u \\\\ v\\end{bmatrix}=\\begin{bmatrix}-2 \\\\ 3\\end{bmatrix},$ the value of our Jacobian determinant is\n\n$$\n{\\frac{∂(x,y)}{∂(u,v)}|}_{(-2,3)}=\\frac{2(3)}{-2}=-3.\n$$"}] [{:db/id #edb/ref 17592186278300 :knowledge-point/_questions [{:db/id #edb/ref 17592186129263 :knowledge-point/id #uuid "ab643519-92a4-5ccf-b826-fb2a68b36534" :knowledge-point/title "Evaluating a Jacobian Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "201b5adb-fe9e-56a4-a103-cfa7fd40fca9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186275775} {:answer/id #uuid "6b7b2609-013a-5fdd-ad02-4411dd975fa7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186276441} {:answer/id #uuid "7c015757-c6cd-5661-8772-840f2ddff2cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186276607} {:answer/id #uuid "803b5ba9-187d-5e4c-a266-d33068d508bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186276640} {:answer/id #uuid "af79779a-7d08-51aa-a7a1-413703ca604d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186277048}] :answer-field/correct {:answer/id #uuid "af79779a-7d08-51aa-a7a1-413703ca604d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186277048} :answer-field/id #uuid "ed0e005f-2ede-5db6-90a3-c44e813e721d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278140}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4f68c62f-9f11-5647-83b4-1238f13388b9" :question/math-academy-id "q-160440" :question/problem "For the transformation $T,$ defined as\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}\\operatorname{cos}⁡u \\\\ \\operatorname{sin}⁡v\\end{bmatrix}\n$$\n\ncompute the value of the Jacobian determinant at the point where $\\begin{bmatrix}u \\\\ v\\end{bmatrix}=\\begin{bmatrix}\\pi /6 \\\\ 0\\end{bmatrix}.$" :question/worked-solution "Given a transformation \n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}\\to \\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix},\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y)}{∂(u,v)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{vmatrix}.\\end{aligned}\n$$\n\nHere, we have $x(u,v)=\\operatorname{cos}⁡u$ and $y(u,v)=\\operatorname{sin}⁡v.$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & =-\\operatorname{sin}⁡u & \\,\\frac{∂x}{∂v} & =0 \\\\ \\frac{∂y}{∂u} & =0 & \\,\\frac{∂y}{∂v} & =\\operatorname{cos}⁡v\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{vmatrix} \\\\  & =\\begin{vmatrix}-\\operatorname{sin}⁡u & 0 \\\\ 0 & \\operatorname{cos}⁡v\\end{vmatrix} \\\\  & =(-\\operatorname{sin}⁡u)\\cdot \\operatorname{cos}⁡v-0\\cdot 0 \\\\  & =-\\operatorname{sin}⁡u\\operatorname{cos}⁡v.\\end{aligned}\n$$\n\nFinally, when $\\begin{bmatrix}u \\\\ v\\end{bmatrix}=\\begin{bmatrix}\\pi /6 \\\\ 0\\end{bmatrix},$ the value of our Jacobian determinant is\n\n$$\n{\\frac{∂(x,y)}{∂(u,v)}|}_{(\\frac{\\pi }{6},0)}=-\\operatorname{sin}⁡(\\frac{\\pi }{6})\\operatorname{cos}⁡(0)=-\\frac{1}{2}.\n$$"}] [{:db/id #edb/ref 17592186383568 :knowledge-point/_questions [{:db/id #edb/ref 17592186129282 :knowledge-point/id #uuid "6d82be73-0720-5267-8698-427641b0e66e" :knowledge-point/title "Identifying the Local Area Scale Factor of a Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f94640a-439d-5450-b89c-214d6351fa55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\,\\delta A" :db/id #edb/ref 17592186383570} {:answer/id #uuid "22b7af57-2308-539f-b4dc-7bf734738b88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,\\delta A" :db/id #edb/ref 17592186383571} {:answer/id #uuid "305c7067-b121-52de-832b-2cd582abe378" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,\\delta A" :db/id #edb/ref 17592186383572} {:answer/id #uuid "0e57c966-7e8f-5c20-b14e-3fff17deba68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,\\delta A" :db/id #edb/ref 17592186383573} {:answer/id #uuid "c14d8db9-1f54-501a-a0d4-dbdd47484709" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\delta A" :db/id #edb/ref 17592186383574}] :answer-field/correct {:answer/id #uuid "305c7067-b121-52de-832b-2cd582abe378" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,\\delta A" :db/id #edb/ref 17592186383572} :answer-field/id #uuid "1fd0ed70-8ad1-5612-8701-9b382b52743e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383569}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6f0941ca-edd5-5538-8a0c-b3d25f8e41f5" :question/math-academy-id "q-161877" :question/problem "Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(2,1)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $T,$ given by\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}\\operatorname{ln}⁡(u-v) \\\\ v-{u}^{2}\\end{bmatrix}?\n$$" :question/worked-solution "Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\n\n$$\n\\text{Area}(T(Δ))≈|\\frac{∂(x,y)}{∂(u,v)}|\\cdot {{\\text{Area}(Δ)}_{⏟}}_{\\delta A}\n$$\n\n \n\nComputing the corresponding Jacobian determinant, we obtain the following:\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}\\frac{1}{u-v} & -\\frac{1}{u-v} \\\\ -2u & 1\\end{aligned}| \\\\  & =\\frac{1}{u-v}\\cdot 1-(-2u)\\cdot (-\\frac{1}{u-v}) \\\\  & =\\frac{1-2u}{u-v} \\\\ {\\frac{∂(x,y)}{∂(u,v)}|}_{(2,1)} & ={(\\frac{1-2u}{u-v})\\,|}_{u=2\\,v=1} \\\\  & =\\frac{1-2(2)}{2-1} \\\\  & =-3\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\text{Area}(T(Δ)) & ≈|-3|\\cdot \\delta A \\\\  & =3\\,\\delta A.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186129634 :knowledge-point/_questions [{:db/id #edb/ref 17592186129187 :knowledge-point/id #uuid "d56cec4a-6121-5988-aaea-478fb6048a6d" :knowledge-point/title "Finding the Jacobian Determinant of a Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e3546fa-15a2-5d61-96f6-97559389e16b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{u - v}{2u + v}" :db/id #edb/ref 17592186127286} {:answer/id #uuid "afa8e959-c8de-5e85-aad5-1bf66bc06c9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{u + v}{2u + v}" :db/id #edb/ref 17592186127287} {:answer/id #uuid "b0a56a0a-029e-5b5a-9aa1-2c4c31c0afe4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2v - u}{2u + v}" :db/id #edb/ref 17592186127288} {:answer/id #uuid "b78db8b2-468f-5a35-935d-4b2d118c364f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186127289} {:answer/id #uuid "f889ffb2-5bf9-552c-b436-d9bad4eb9156" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2u - v}{2u + v}" :db/id #edb/ref 17592186127290}] :answer-field/id #uuid "8ce1f8a3-a444-5060-b21b-88d7f97c6039" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186127285}] :question/id #uuid "11d6f504-95b5-5c56-b8f4-c98216f1e26b" :question/math-academy-id "q-38244" :question/problem "Find the Jacobian determinant of the transformation $T(\\begin{bmatrix}u \\\\ v\\end{bmatrix}) = \\begin{bmatrix}\\ln (2u + v) \\\\ uv\\end{bmatrix}$."}]}
