n/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "70db0eed-102a-5697-8d3f-891b9c2d06b3" :question/math-academy-id "q-49189" :question/problem "What is ${\\int }_{1}^{2}{x}^{2}\\,\\text{d}x$ expressed as the limit of a left Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a left Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{l=0}^{n-1}f({x}_{l})\\cdot Δx,\n$$\n\n    \n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{l}=a+lΔx.$\n\nIn the definite integral\n\n$$\n{\\int }_{1}^{2}{x}^{2}\\text{d}x,\n$$\n\nthe function is $f(x)={x}^{2},$ the lower bound is $a=1,$ and the upper bound is $b=2.$ So, we have\n\n$$\nΔx=\\frac{2-1}{n}=\\frac{1}{n},\n$$\n\nand therefore\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}{x}^{2}\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{l=0}^{n-1}f({x}_{l})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{l=0}^{n-1}[f(1+l\\cdot \\frac{1}{n})\\cdot \\frac{1}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{l=0}^{n-1}[f(1+\\frac{l}{n})\\cdot \\frac{1}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{l=0}^{n-1}[{(1+\\frac{l}{n})}^{2}\\cdot \\frac{1}{n}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186332681 :knowledge-point/_questions [{:db/id #edb/ref 17592186096632 :knowledge-point/id #uuid "4f663b0b-9b5e-512c-92bb-0ea84d5baac5" :knowledge-point/title "Expressing the Limit of a Left Riemann Sum as a Definite Integral"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1520edf6-93bb-5db6-9128-f81756520d8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(x)=\\operatorname{ln}⁡(x+e)$ and $b={e}^{2}$" :db/id #edb/ref 17592186330118} {:answer/id #uuid "34612814-166e-5d51-b2d8-255a56c01f3f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(x)=\\operatorname{ln}⁡x$ and $b={e}^{2}$" :db/id #edb/ref 17592186330413} {:answer/id #uuid "5a4d58cd-e443-52da-913e-f6feabf466de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(x)=\\operatorname{ln}⁡(x+e)$ and $b=2e$" :db/id #edb/ref 17592186330759} {:answer/id #uuid "90479fe6-a4ca-56f9-9289-46966e3a10b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(x)=\\operatorname{ln}⁡(x+e)$ and $b=e+1$" :db/id #edb/ref 17592186331234} {:answer/id #uuid "eafb8eca-ec9c-5930-b366-56e28ce03054" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(x)=\\operatorname{ln}⁡x$ and $b=2e$" :db/id #edb/ref 17592186332011}] :answer-field/correct {:answer/id #uuid "eafb8eca-ec9c-5930-b366-56e28ce03054" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(x)=\\operatorname{ln}⁡x$ and $b=2e$" :db/id #edb/ref 17592186332011} :answer-field/id #uuid "2c43ef92-1fe4-5da5-ae81-e8c45f540023" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332271}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "be4620a0-c65c-5bd5-aaf3-d3285dc13e62" :question/math-academy-id "q-49235" :question/problem "Find the function $f(x)$ and the value of $b,$ given that ${\\int }_{e}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[\\operatorname{ln}⁡(e+\\frac{ie}{n})\\cdot \\frac{e}{n}].$" :question/worked-solution "A definite integral can be defined as the limit of a left Riemann sum as follows:\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx\n$$\n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{i}=a+iΔx.$\n\nNotice that we're given that the lower limit $a=e.$ \n\nComparing the given summation with the general expression above, we see that $Δx=\\frac{e}{n}.$ Therefore, \n\n$$\n\\frac{e}{n}=\\frac{b-e}{n}\\,⟹\\,b=2e.\n$$\n\nConsequently,  ${x}_{i}=e+\\frac{ie}{n}$ and $f({x}_{i})=\\operatorname{ln}⁡{x}_{i}.$\n\nHence,\n\n$$\n{\\int }_{e}^{2e}\\operatorname{ln}⁡x\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[\\operatorname{ln}⁡(e+\\frac{ie}{n})\\cdot \\frac{e}{n}].\n$$\n\nTherefore, the correct answer is $f(x)=\\operatorname{ln}⁡x$ and $b=2e.$"}] [{:db/id #edb/ref 17592186536852 :knowledge-point/_questions [{:db/id #edb/ref 17592186096631 :knowledge-point/id #uuid "cdc82e49-5df6-5096-a8fd-e00017fb1e3a" :knowledge-point/title "Expressing a Definite Integral as the Limit of a Left Riemann Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48caa462-32f1-501c-83c0-0379aaf59677" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}[2{(\\frac{3j}{n})}^{1/3}\\cdot \\frac{3}{n}]" :db/id #edb/ref 17592186536396} {:answer/id #uuid "6c04b536-8c47-5b60-84d0-ad4f649d58d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}[{(3+\\frac{3j}{n})}^{1/3}\\cdot \\frac{3}{n}]" :db/id #edb/ref 17592186536465} {:answer/id #uuid "7d93b2a2-ea70-5d27-a06b-2eb1b0c174f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}[2{(2+\\frac{3j}{n})}^{1/3}\\cdot \\frac{3}{n}]" :db/id #edb/ref 17592186536493} {:answer/id #uuid "cc660814-0552-58be-a5ff-bf43da8972f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}[2{(2+\\frac{2j}{n})}^{1/3}\\cdot \\frac{2}{n}]" :db/id #edb/ref 17592186536607} {:answer/id #uuid "ecacd70a-0d41-5ace-a88e-64b07dd6c585" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}[2(2+\\frac{3j}{n})\\cdot \\frac{3}{n}]" :db/id #edb/ref 17592186536659}] :answer-field/correct {:answer/id #uuid "7d93b2a2-ea70-5d27-a06b-2eb1b0c174f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}[2{(2+\\frac{3j}{n})}^{1/3}\\cdot \\frac{3}{n}]" :db/id #edb/ref 17592186536493} :answer-field/id #uuid "057a26a6-55af-55a3-897b-914138a1eb9b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186536699}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8aa630f2-bd34-5568-baf8-ea73abca85e8" :question/math-academy-id "q-73155" :question/problem "What is ${\\int }_{2}^{5}2{x}^{1/3}\\,\\text{d}x$ expressed as the limit of a left Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a left Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}f({x}_{j})\\cdot Δx,\n$$\n\n    \n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{j}=a+jΔx.$\n\nIn the definite integral\n\n$$\n{\\int }_{2}^{5}2{x}^{1/3}\\,\\text{d}x,\n$$\n\nthe function is $f(x)=2{x}^{1/3},$ the lower bound is $a=2,$ and the upper bound is $b=5.$ So, we have\n\n$$\nΔx=\\frac{5-2}{n}=\\frac{3}{n},\n$$\n\nand therefore\n\n$$\n\\begin{aligned}{\\int }_{2}^{5}2{x}^{1/3}\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}f({x}_{j})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}[f(2+j\\cdot \\frac{3}{n})\\cdot \\frac{3}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}[f(2+\\frac{3j}{n})\\cdot \\frac{3}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}[2{(2+\\frac{3j}{n})}^{1/3}\\cdot \\frac{3}{n}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393264 :knowledge-point/_questions [{:db/id #edb/ref 17592186096633 :knowledge-point/id #uuid "29b136d3-69bc-51ef-a262-dbee8af377d2" :knowledge-point/title "Expressing a Definite Integral as the Limit of a Right Riemann Sum"}] :question/answer-fiel