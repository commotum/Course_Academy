-mjx-texclass=\"ORD\"><mn mathvariant=\"bold\">1</mn></mrow><mo stretchy=\"false\">[</mo><msub><mi>x</mi><mi>i</mi></msub><mo>&gt;</mo><mn>0</mn><mo stretchy=\"false\">]</mo><mo>⋅</mo><msub><mi>x</mi><mi>i</mi></msub></mtd><mtd><mi></mi><mo>=</mo><mn>0</mn><mo>⋅</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mn>3</mn><mo stretchy=\"false\">)</mo><mo>+</mo><mn>1</mn><mo>⋅</mo><mn>6</mn><mo>+</mo><mn>0</mn><mo>⋅</mo><mn>0</mn><mo>+</mo><mn>1</mn><mo>⋅</mo><mn>2</mn><mo>+</mo><mn>0</mn><mo>⋅</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mn>1</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>0</mn><mo>+</mo><mn>6</mn><mo>+</mo><mn>0</mn><mo>+</mo><mn>2</mn><mo>+</mo><mn>0</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle style=\"border: 1px solid gainsboro\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mn>8</mn></mpadded></mstyle><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
