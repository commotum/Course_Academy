answer/id #uuid "0f4a985f-3936-524c-82ce-bdfd2fbe60dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186520795} {:answer/id #uuid "58bc2a60-b948-5166-8f01-81acd078e26e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186520965} {:answer/id #uuid "658c5b15-f998-5d5b-b0eb-fbf5256cc2f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186520994} {:answer/id #uuid "80f4e595-5afd-5165-81f6-3d6bfb064b7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186521059} {:answer/id #uuid "96579d5d-d100-5de9-abd5-fadb1b5e1af9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186521108}] :answer-field/correct {:answer/id #uuid "96579d5d-d100-5de9-abd5-fadb1b5e1af9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186521108} :answer-field/id #uuid "eadd2994-f16f-5d36-915c-42776a4f7ea5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186521445}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "77a3c45c-df66-5438-9ce6-8791cf4f16da" :question/math-academy-id "q-346656" :question/problem "Evaluate the indicator function\n$1[3\\in \\{1,3,6,8\\}].$" :question/worked-solution "The indicator function $1[P]$ equals $1$ if the predicate $P$ is true and $0$ if $P$ is false.\n\n$$\n1[P]=\\{\\begin{aligned}1, & \\text{if }P\\text{ is true}, \\\\ 0, & \\text{if }P\\text{ is false}.\\end{aligned}\n$$\n\nHere, the predicate is $3\\in \\{1,3,6,8\\}.$ Since $3$ is an element of the set $\\{1,3,6,8\\},$ the predicate is true. Therefore,\n\n$$\n1[3\\in \\{1,3,6,8\\}]=1.\n$$"}] [{:db/id #edb/ref 17592186521461 :knowledge-point/_questions [{:db/id #edb/ref 17592186166967 :knowledge-point/id #uuid "144f097c-0080-5857-b992-8996f194ca22" :knowledge-point/title "Using Indicator Functions to Check Predicates"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24907d49-66d4-50cb-a4c8-3543263283e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186520840} {:answer/id #uuid "4323438d-d075-5cf2-8dc1-6b1709d1a612" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186520916} {:answer/id #uuid "6913e577-51fe-515b-8665-cfebf3c44f81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186521001} {:answer/id #uuid "7e48777f-ff2d-592c-b304-61e39dd2f866" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186521053} {:answer/id #uuid "8fd3549b-2060-5e8f-9079-20bc1ec9c8cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186521090}] :answer-field/correct {:answer/id #uuid "8fd3549b-2060-5e8f-9079-20bc1ec9c8cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186521090} :answer-field/id #uuid "74f1f48a-399d-5f1e-8444-768471429caf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186521378}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1501d1dd-a30a-5622-a170-02307bfe9a8b" :question/math-academy-id "q-346657" :question/problem "Evaluate the indicator function\n$1[7\\in \\{2,4,6,10\\}].$" :question/worked-solution "The indicator function $1[P]$ equals $1$ if the predicate $P$ is true and $0$ if $P$ is false.\n\n$$\n1[P]=\\{\\begin{aligned}1, & \\text{if }P\\text{ is true}, \\\\ 0, & \\text{if }P\\text{ is false}.\\end{aligned}\n$$\n\nHere, the predicate is $7\\in \\{2,4,6,10\\}.$ Since $7$ is not an element of the set $\\{2,4,6,10\\},$ the predicate is false. Therefore,\n\n$$\n1[7\\in \\{2,4,6,10\\}]=0.\n$$"}] [{:db/id #edb/ref 17592186521478 :knowledge-point/_questions [{:db/id #edb/ref 17592186166967 :knowledge-point/id #uuid "144f097c-0080-5857-b992-8996f194ca22" :knowledge-point/title "Using Indicator Functions to Check Predicates"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "375e6424-d095-5ddd-9530-7065ad6f75a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186520884} {:answer/id #uuid "5d553bf8-8c0c-58a6-8637-fdd966562bbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186520973} {:answer/id #uuid "61f08d86-aa99-5e5f-83f4-65e893563765" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186520987} {:answer/id #uuid "a654912f-2a18-507b-a9d6-7aa55d6b5063" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186521136} {:answer/id #uuid "ceb14721-f32c-59f1-8405-04c815375294" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186521229}] :answer-field/correct {:answer/id #uuid "a654912f-2a18-507b-a9d6-7aa55d6b5063" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186521136} :answer-field/id #uuid "bfad7e9d-4e2c-535c-b3a5-b71dee44a203" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186521425}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "30559f45-859e-514a-9084-78b866aea583" :question/math-academy-id "q-346659" :question/problem "Evaluate the indicator function\n$1[9\\in \\{1,2,3,5\\}].$" :question/worked-solution "The indicator function $1[P]$ equals $1$ if the predicate $P$ is true and $0$ if $P$ is false.\n\n$$\n1[P]=\\{\\begin{aligned}1, & \\text{if }P\\text{ is true}, \\\\ 0, & \\text{if }P\\text{ is false}.\\end{aligned}\n$$\n\nHere, the predicate is $9\\in \\{1,2,3,5\\}.$ Since $9$ is not an element of the set $\\{1,2,3,5\\},$ the predicate is false. Therefore,\n\n$$\n1[9\\in \\{1,2,3,5\\}]=0.\n$$"}] [{:db/id #edb/ref 17592186521491 :knowledge-point/_questions [{:db/id #edb/ref 17592186166968 :knowledge-point/id #uuid "6e434dbd-b33c-5997-b3ba-043233cfbc89" :knowledge-point/title "Converting Indicator Notations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "476fea80-a151-5a7d-8ed4-0f75973ec718" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1[\\{2,4,6,8\\}\\in 4]" :db/id #edb/ref 17592186520924} {:answer/id #uuid "4f7a6f0e-6445-5701-a9d9-31d89e8a87a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1[4=B]" :db/id #edb/ref 17592186520946} {:answer/id #uuid "694ef196-0766-5926-a457-4750f88d8632" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1[4\\in \\{2,4,6,8\\}]" :db/id #edb/ref 17592186521003} {:answer/id #uuid "abd78e39-0094-50c0-bfb3-a65b9260681f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1[B\\in \\{2,4,6,8\\}]" :db/id #edb/ref 17592186521147} {:answer/id #uuid "cbcdc340-fc9e-5215-9bcb-fb66512e975c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1[4\\notin \\{2,4,6,8\\}]" :db/id #edb/ref 17592186521220}] :answer-field/correct {:answer/id #uuid "694ef196-0766-5926-a457-4750f88d8632" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1[4\\in \\{2,4,6,8\\}]" :db/id #edb/ref 17592186521003} :answer-field/id #uuid "2e157aa0-f544-5502-acc6-0625ed40b4c1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186521351}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "45172067-6fd8-53b2-8b3e-3767eb3b99d5" :question/math-academy-id "q-346661" :question/problem "Let $B=\\{2,4,6,8\\}.$ Which of the following is equivalent to ${1}_{B}(4)?$" :question/worked-solution "The indicator function $1[P]$ equals $1$ if the predicate $P$ is true and $0$ if $P$ is false.\n\n$$\n1[P]=\\{\\begin{aligned}1, & \\text{if }P\\text{ is true}, \\\\ 0, & \\text{if }P\\text{ is false}.\\end{aligned}\n$$\n\nRecall that the indicator function ${1}_{B}(x)$ of a set $B$ equals $1$ if $x\\in B$ and $0$ if $x\\notin B.$ This can be written using Iverson bracket notation as\n\n$$\n{1}_{B}(x)=1[x\\in B].\n$$\n\nTherefore, we have\n\n$$\n{1}_{B}(4)=1[4\\in B]=1[4\\in \\{2,4,6,8\\}].\n$$"}] [{:db/id #edb/ref 17592186521492 :knowledge-point/_questions [{:db/id #edb/ref 17592186166968 :knowledge-point/id #uuid "6e434dbd-b33c-5997-b3ba-043233cfbc89" :knowledge-point/title "Converting Indicator Notations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a58bef4-93d4-522c-a87f-49921e906d27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1[9\\in \\{1,4,9\\}]" :db/id #edb/ref 17592186521005} {:answer/id #uuid "95e7e21b-2045-5591-bb93-0129146c3083" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1[\\{1,4,9\\}\\in 9]" :db/id #edb/ref 17592186521105} {:answer/id #uuid "ac497d10-6ba2-5055-b7db-ce4bc1ac8d86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1[9=E]" :db/id #edb/ref 17592186521148} {:answer/id #uuid "dd3caf27-76bf-5eb7-b4a6-c97e14006602" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1[9\\notin \\{1,4,9\\}]" :db/id #edb/ref 17592186521260} {:answer/id #uuid "fd817330-5cc3-53c0-959a-052ddfc3d829" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1[E\\in \\{1,4,9\\}]" :db/id #edb/ref 17592186521322}] :answer-field/correct {:answer/id #uuid "6a58bef4-93d4-522c-a87f-49921e906d27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1[9\\in \\{1,4,9\\}]" :db/id #edb/ref 17592186521005} :answer-field/id #uuid "ae3cbd01-def2-5c98-9377-4568488434a0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186521413}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4946e8ca-eef4-5bca-ab77-2e318993cb3a" :question/math-academy-id "q-346664" :question/problem "Let $E=\\{1,4,9\\}.$ Which of the following is equivalent to ${1}_{E}(9)?$" :question/worked-solution "The indicator function $1[P]$ equals $1$ if the predicate $P$ is true and $0$ if $P$ is false.\n\n$$\n1[P]=\\{\\begin{aligned}1, & \\text{if }P\\text{ is true}, \\\\ 0, & \\text{if }P\\text{ is false}.\\end{aligned}\n$$\n\nRecall that the indicator function ${1}_{E}(x)$ of a set $E$ equals $1$ if $x\\in E$ and $0$ if $x\\notin E.$ This can be written using Iverson bracket notation as\n\n$$\n{1}_{E}(x)=1[x\\in E].\n$$\n\nTherefore, we have\n\n$$\n{1}_{E}(9)=1[9\\in E]=1[9\\in \\{1,4,9\\}].\n$$"}] [{:db/id #edb/ref 17592186521550 :knowledge-point/_questions [{:db/id #edb/ref 17592186166969 :knowledge-point/id #uuid "1900018f-1bac-5623-b45f-e3d9c89f5d74" :knowledge-point/title "Using Indicator Functions in Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "80a200ec-9e32-5842-a3a1-191293b65d99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186521058}] :answer-field/correct {:answer/id #uuid "80a200ec-9e32-5842-a3a1-191293b65d99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186521058} :answer-field/id #uuid "51fa0505-47ca-5c35-ba62-02fa3db61539" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186521363}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ce2c0db9-ad0b-5196-91d2-2f4a888aa062" :question/math-academy-id "q-346669" :question/problem "$$\n{x}_{1}=-3,\\,{x}_{2}=6,\\,{x}_{3}=0,\\,{x}_{4}=2,\\,{x}_{5}=-1\n$$\n\nGiven the values ${x}_{1},\\,{x}_{2},\\,{x}_{3},\\,{x}_{4},\\,{x}_{5}$ above, we have\n\n${\\sum }_{i=1}^{5}1[{x}_{i}>0]\\cdot {x}_{i}=$ {{field-1}}." :question/worked-solution "The indicator function $1[P]$ equals $1$ if the predicate $P$ is true and $0$ if $P$ is false.\n\n$$\n1[P]=\\{\\begin{aligned}1, & \\text{if }P\\text{ is true}, \\\\ 0, & \\text{if }P\\text{ is false}.\\end{aligned}\n$$\n\nThe expression $1[{x}_{i}>0]\\cdot {x}_{i}$ equals ${x}_{i}$ when ${x}_{i}>0$ and equals $0$ otherwise. Thus, the sum \n\n$$\n{\\sum }_{i=1}^{5}1[{x}_{i}>0]\\cdot {x}_{i}\n$$\n\nadds up only the positive values.\n\nWe evaluate the indicator function for each ${x}_{i}:$\n\n- $1[{x}_{1}>0]=1[-3>0]=0$\n\n- $1[{x}_{2}>0]=1[6>0]=1$\n\n- $1[{x}_{3}>0]=1[0>0]=0$\n\n- $1[{x}_{4}>0]=1[2>0]=1$\n\n- $1[{x}_{5}>0]=1[-1>0]=0$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{5}1[{x}_{i}>0]\\cdot {x}_{i} & =0\\cdot (-3)+1\\cdot 6+0\\cdot 0+1\\cdot 2+0\\cdot (-1) \\\\  & =0+6+0+2+0 \\\\  & =8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186521570 :knowledge-point/_questions [{:db/id #edb/ref 17592186166969 :knowledge-point/id #uuid "1900018f-1bac-5623-b45f-e3d9c89f5d74" :knowledge-point/title "Using Indicator Functions in Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1374ccaf-10b6-5249-9706-254726bc070c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186520809}] :answer-field/correct {:answer/id #uuid "1374ccaf-10b6-5249-9706-254726bc070c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186520809} :answer-field/id #uuid "0394d37a-0a43-5dc1-accb-790c982f5ce9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186521327}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f9506abb-49a9-5357-8f1d-b8154670131b" :question/math-academy-id "q-346673" :question/problem "$$\n{x}_{1}=0,\\,{x}_{2}=-7,\\,{x}_{3}=8,\\,{x}_{4}=9,\\,{x}_{5}=-2\n$$\n\nGiven the values ${x}_{1},\\,{x}_{2},\\,{x}_{3},\\,{x}_{4},\\,{x}_{5}$ above, we have\n\n${\\sum }_{i=1}^{5}1[{x}_{i}>0]\\cdot {x}_{i}=$ {{field-1}}." :question/worked-solution "The indicator function $1[P]$ equals $1$ if the predicate $P$ is true and $0$ if $P$ is false.\n\n$$\n1[P]=\\{\\begin{aligned}1, & \\text{if }P\\text{ is true}, \\\\ 0, & \\text{if }P\\text{ is false}.\\end{aligned}\n$$\n\nThe expression $1[{x}_{i}>0]\\cdot {x}_{i}$ equals ${x}_{i}$ when ${x}_{i}>0$ and equals $0$ otherwise. Thus, the sum \n\n$$\n{\\sum }_{i=1}^{5}1[{x}_{i}>0]\\cdot {x}_{i}\n$$\n\nadds up only the positive values.\n\nWe evaluate the indicator function for each ${x}_{i}:$\n\n- $1[{x}_{1}>0]=1[0>0]=0$\n\n- $1[{x}_{2}>0]=1[-7>0]=0$\n\n- $1[{x}_{3}>0]=1[8>0]=1$\n\n- $1[{x}_{4}>0]=1[9>0]=1$\n\n- $1[{x}_{5}>0]=1[-2>0]=0$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{5}1[{x}_{i}>0]\\cdot {x}_{i} & =0\\cdot 0+0\\cdot (-7)+1\\cdot 8+1\\cdot 9+0\\cdot (-2) \\\\  & =0+0+8+9+0 \\\\  & =17.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186521559 :knowledge-point/_questions [{:db/id #edb/ref 17592186166969 :knowledge-point/id #uuid "1900018f-1bac-5623-b45f-e3d9c89f5d74" :knowledge-point/title "Using Indicator Functions in Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21d85309-3a31-5b9c-abc2-4783d8a10ad3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186520834} {:answer/id #uuid "4927cc7c-73e9-5c12-8f55-724aa84b4cf9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186520928} {:answer/id #uuid "601ff206-5a9b-55e2-8466-b8841840c228" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186520981} {:answer/id #uuid "e0203717-1849-5686-90b7-0f7457dd17db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186521265} {:answer/id #uuid "f617a0e6-381f-5f77-b895-286ad10d9598" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186521303}] :answer-field/correct {:answer/id #uuid "21d85309-3a31-5b9c-abc2-4783d8a10ad3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186520834} :answer-field/id #uuid "1414c5ad-3d2c-5faf-add7-3444b17c5202" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186521334}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e022df96-ab83-5f54-81a6-300069e7bfc3" :question/math-academy-id "q-346680" :question/problem "Consider the function\n\n$$\nf(x)=1[x\\ge -1]\\cdot {x}^{2}+1[x<-1]\\cdot (-x).\n$$\n\nWhat is $f(-3)?$" :question/worked-solution "The indicator function $1[P]$ equals $1$ if the predicate $P$ is true and $0$ if $P$ is false.\n\n$$\n1[P]=\\{\\begin{aligned}1, & \\text{if }P\\text{ is true}, \\\\ 0, & \\text{if }P\\text{ is false}.\\end{aligned}\n$$\n\nFor $x=-3,$ we evaluate each indicator function:\n\n- $1[x\\ge -1]=1[-3\\ge -1]=0$ (since $-3\\ge -1$ is false)\n\n- $1[x<-1]=1[-3<-1]=1$ (since $-3<-1$ is true)\n\nSubstituting into the expression for $f(x),$ we get\n\n$$\n\\begin{aligned}f(-3) & =1[-3\\ge -1]\\cdot (-3)^{2}+1[-3<-1]\\cdot (-(-3)) \\\\  & =0\\cdot 9+1\\cdot 3 \\\\  & =3.\\end{aligned}\n$$\n\nNote that the indicator functions act as a \"switch\": since $x=-3<-1,$ the first term vanishes and only the second term contributes to the result."}] [{:db/id #edb/ref 17592186521549 :knowledge-point/_questions [{:db/id #edb/ref 17592186166969 :knowledge-point/id #uuid "1900018f-1bac-5623-b45f-e3d9c89f5d74" :knowledge-point/title "Using Indicator Functions in Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c4892a0-601e-5c51-a5e8-9fd4960aaa8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186520785} {:answer/id #uuid "416c3487-0d24-54c0-856d-6739a365455d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186520911} {:answer/id #uuid "63138a2e-fdf7-5c34-beef-1de60acea7ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186520989} {:answer/id #uuid "6eade6bb-146e-5007-a93b-9a3431df2347" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186521015} {:answer/id #uuid "e2e3d5db-939c-5344-9198-4a4955c50e69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186521273}] :answer-field/correct {:answer/id #uuid "63138a2e-fdf7-5c34-beef-1de60acea7ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186520989} :answer-field/id #uuid "987d0b6b-2b30-5c02-8d2b-78ee1f2cb652" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186521401}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cde00f71-de2d-5ff7-ae71-1ddcfa0a1b1f" :question/math-academy-id "q-347433" :question/problem "Consider the function\n\n$$\ng(x)=1[x\\ge 2]\\cdot (x-2)^{2}+1[-1\\le x<2]\\cdot 1+1[x<-1]\\cdot (-x).\n$$\n\nWhat is $g(-3)?$" :question/worked-solution "The indicator function $1[P]$ equals $1$ if the predicate $P$ is true and $0$ if $P$ is false.\n\n$$\n1[P]=\\{\\begin{aligned}1, & \\text{if }P\\text{ is true}, \\\\ 0, & \\text{if }P\\text{ is false}.\\end{aligned}\n$$\n\nFor $x=-3,$ we evaluate each indicator function:\n\n- $1[x\\ge 2]=1[-3\\ge 2]=0$ (since $-3\\ge 2$ is false)\n\n- $1[-1\\le x<2]=1[-1\\le -3<2]=0$ (since $-1\\le -3$ is false)\n\n- $1[x<-1]=1[-3<-1]=1$ (since $-3<-1$ is true)\n\nSubstituting into the expression for $g(x),$ we get\n\n$$\n\\begin{aligned}g(-3) & =1[-3\\ge 2]\\cdot (-5)^{2}+1[-1\\le -3<2]\\cdot 1+1[-3<-1]\\cdot (-(-3)) \\\\  & =0\\cdot 25+0\\cdot 1+1\\cdot 3 \\\\  & =3.\\end{aligned}\n$$\n\nNote that the indicator functions act as a \"switch\": since $x=-3<-1,$ only the third term contributes to the result."}] [{:db/id #edb/ref 17592186521515 :knowledge-point/_questions [{:db/id #edb/ref 17592186166969 :knowledge-point/id #uuid "1900018f-1bac-5623-b45f-e3d9c89f5d74" :knowledge-point/title "Using Indicator Functions in Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50fd8bc5-cefc-5845-bbed-5233a3393494" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186520948}] :answer-field/correct {:answer/id #uuid "50fd8bc5-cefc-5845-bbed-5233a3393494" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186520948} :answer-field/id #uuid "8470a13f-71f6-57ad-8421-53498bc36c05" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186521388}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7ce60c02-eb25-536f-a376-c9d5685f21ea" :question/math-academy-id "q-347932" :question/problem "$$\n{x}_{1}=-3,\\,{x}_{2}=1,\\,{x}_{3}=6,\\,{x}_{4}=-2,\\,{x}_{5}=0\n$$\n\nGiven the values ${x}_{1},\\,{x}_{2},\\,{x}_{3},\\,{x}_{4},\\,{x}_{5}$ above, we have\n\n${\\sum }_{i=1}^{5}1[{x}_{i}\\ge 0]\\cdot ({x}_{i}-1)+1[{x}_{i}<0]\\cdot 2=$ {{field-1}}." :question/worked-solution "The indicator function $1[P]$ equals $1$ if the predicate $P$ is true and $0$ if $P$ is false.\n\n$$\n1[P]=\\{\\begin{aligned}1, & \\text{if }P\\text{ is true}, \\\\ 0, & \\text{if }P\\text{ is false}.\\end{aligned}\n$$\n\nThe expression $1[{x}_{i}\\ge 0]\\cdot ({x}_{i}-1)+1[{x}_{i}<0]\\cdot 2$ equals ${x}_{i}-1$ when ${x}_{i}\\ge 0$ and equals $2$ when ${x}_{i}<0.$ Thus, the sum\n\n$$\n{\\sum }_{i=1}^{5}1[{x}_{i}\\ge 0]\\cdot ({x}_{i}-1)+1[{x}_{i}<0]\\cdot 2\n$$\n\nadds ${x}_{i}-1$ for nonnegative values and $2$ for negative values.\n\nWe evaluate the indicator function for each ${x}_{i}:$\n\n- $1[{x}_{1}\\ge 0]=1[-3\\ge 0]=0,$ $1[{x}_{1}<0]=1$\n\n- $1[{x}_{2}\\ge 0]=1[1\\ge 0]=1,$ $1[{x}_{2}<0]=0$\n\n- $1[{x}_{3}\\ge 0]=1[6\\ge 0]=1,$ $1[{x}_{3}<0]=0$\n\n- $1[{x}_{4}\\ge 0]=1[-2\\ge 0]=0,$ $1[{x}_{4}<0]=1$\n\n- $1[{x}_{5}\\ge 0]=1[0\\ge 0]=1,$ $1[{x}_{5}<0]=0$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{5}1[{x}_{i}\\ge 0]\\cdot ({x}_{i}-1)+1[{x}_{i}<0]\\cdot 2 & =2+(1-1)+(6-1)+2+(0-1) \\\\  & =2+0+5+2-1 \\\\  & =8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186521551 :knowledge-point/_questions [{:db/id #edb/ref 17592186166968 :knowledge-point/id #uuid "6e434dbd-b33c-5997-b3ba-043233cfbc89" :knowledge-point/title "Converting Indicator Notations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01e2b004-c1e0-5ea3-8c85-931b530092a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{1}_{\\{1,3,7,9\\}}(C)" :db/id #edb/ref 17592186520767} {:answer/id #uuid "72e680b9-d1e0-5ace-914f-85201a54e8c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{1}_{C}(4)" :db/id #edb/ref 17592186521021} {:answer/id #uuid "96328b68-99be-544f-acc5-512aa00ccca7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{1}_{C}(3)" :db/id #edb/ref 17592186521107} {:answer/id #uuid "a188e1ba-6c69-51b2-b51a-8bfb5787bc58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{1}_{4}(1)" :db/id #edb/ref 17592186521125} {:answer/id #uuid "e8f566a8-2d46-514e-a5f1-e7a99bb09834" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{1}_{4}(C)" :db/id #edb/ref 17592186521283}] :answer-field/correct {:answer/id #uuid "72e680b9-d1e0-5ace-914f-85201a54e8c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{1}_{C}(4)" :db/id #edb/ref 17592186521021} :answer-field/id #uuid "471ddc6c-eb77-5611-9970-f361d660ca90" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186521360}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d217e754-13bb-55c1-bf52-1609c0455dd0" :question/math-academy-id "q-351127" :question/problem "Let $C=\\{1,3,7,9\\}.$ Which of the following is equivalent to $1[4\\in C]?$" :question/worked-solution "The indicator function $1[P]$ equals $1$ if the predicate $P$ is true and $0$ if $P$ is false.\n\n$$\n1[P]=\\{\\begin{aligned}1, & \\text{if }P\\text{ is true}, \\\\ 0, & \\text{if }P\\text{ is false}.\\end{aligned}\n$$\n\nRecall that the indicator function ${1}_{A}(x)$ of a set $A$ equals $1$ if $x\\in A$ and $0$ if $x\\notin A.$ This can be written using Iverson bracket notation as\n\n$$\n{1}_{A}(x)=1[x\\in A].\n$$\n\nHere, the Iverson bracket expression $1[4\\in C]$ has $x=4$ and $A=C.$ Therefore, converting back to set indicator notation, we have\n\n$$\n1[4\\in C]={1}_{C}(4).\n$$"}] [{:db/id #edb/ref 17592186521566 :knowledge-point/_questions [{:db/id #edb/ref 17592186166968 :knowledge-point/id #uuid "6e434dbd-b33c-5997-b3ba-043233cfbc89" :knowledge-point/title "Converting Indicator Notations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b433f0e-c20a-56a6-be38-54b150ce736d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{1}_{E}(10)" :db/id #edb/ref 17592186520824} {:answer/id #uuid "63e3e50d-5a21-5132-9d32-2e33146bdd1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{1}_{10}(0)" :db/id #edb/ref 17592186520991} {:answer/id #uuid "6d2b534e-ad9a-51c7-9f08-07e0e3f70ca9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{1}_{\\{0,4,8,12\\}}(E)" :db/id #edb/ref 17592186521013} {:answer/id #uuid "9e322a5e-ed05-52c1-a8dd-53596804e29d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{1}_{10}(E)" :db/id #edb/ref 17592186521121} {:answer/id #uuid "ddb2ddd0-6040-5f09-a90c-68bb2cebbdc8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{1}_{E}(12)" :db/id #edb/ref 17592186521262}] :answer-field/correct {:answer/id #uuid "1b433f0e-c20a-56a6-be38-54b150ce736d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{1}_{E}(10)" :db/id #edb/ref 17592186520824} :answer-field/id #uuid "9ac89a69-ed84-581a-8ccb-a1473c225f7f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186521403}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ee0e20b3-c728-5a30-b95b-8f191603cec6" :question/math-academy-id "q-351129" :question/problem "Let $E=\\{0,4,8,12\\}.$ Which of the following is equivalent to $1[10\\in E]?$" :question/worked-solution "The indicator function $1[P]$ equals $1$ if the predicate $P$ is true and $0$ if $P$ is false.\n\n$$\n1[P]=\\{\\begin{aligned}1, & \\text{if }P\\text{ is true}, \\\\ 0, & \\text{if }P\\text{ is false}.\\end{aligned}\n$$\n\nRecall that the indicator function ${1}_{A}(x)$ of a set $A$ equals $1$ if $x\\in A$ and $0$ if $x\\notin A.$ This can be written using Iverson bracket notation as\n\n$$\n{1}_{A}(x)=1[x\\in A].\n$$\n\nHere, the Iverson bracket expression $1[10\\in E]$ has $x=10$ and $A=E.$ Therefore, converting back to set indicator notation, we have\n\n$$\n1[10\\in E]={1}_{E}(10).\n$$"}] [{:db/id #edb/ref 17592186521564 :knowledge-point/_questions [{:db/id #edb/ref 17592186166968 :knowledge-point/id #uuid "6e434dbd-b33c-5997-b3ba-043233cfbc89" :knowledge-point/title "Converting Indicator Notations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ff7af79-af6a-589c-83bc-31b1f2537a0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{1}_{8}(3)" :db/id #edb/ref 17592186520908} {:answer/id #uuid "751f9b9d-dbac-59f8-b97c-bcd1603ca54b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{1}_{F}(9)" :db/id #edb/ref 17592186521024} {:answer/id #uuid "87303cb1-c8d0-5d76-a401-9cedcc41f16e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{1}_{F}(8)" :db/id #edb/ref 17592186521072} {:answer/id #uuid "9c7df1cd-d583-5a6c-a0a7-f474f880891c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{1}_{8}(F)" :db/id #edb/ref 17592186521118} {:answer/id #uuid "fbf4a1e8-9831-57ae-8964-3db5ebe5c88e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{1}_{\\{3,6,9,15\\}}(F)" :db/id #edb/ref 17592186521315}] :answer-field/correct {:answer/id #uuid "87303cb1-c8d0-5d76-a401-9cedcc41f16e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{1}_{F}(8)" :db/id #edb/ref 17592186521072} :answer-field/id #uuid "5deb40af-8214-55ff-b3c7-13090d23cf93" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186521370}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e8d6c64e-e665-50e4-b8dc-09f085134af3" :question/math-academy-id "q-351130" :question/problem "Let $F=\\{3,6,9,15\\}.$ Which of the following is equivalent to $1[8\\in F]?$" :question/worked-solution "The indicator function $1[P]$ equals $1$ if the predicate $P$ is true and $0$ if $P$ is false.\n\n$$\n1[P]=\\{\\begin{aligned}1, & \\text{if }P\\text{ is true}, \\\\ 0, & \\text{if }P\\text{ is false}.\\end{aligned}\n$$\n\nRecall that the indicator function ${1}_{A}(x)$ of a set $A$ equals $1$ if $x\\in A$ and $0$ if $x\\notin A.$ This can be written using Iverson bracket notation as\n\n$$\n{1}_{A}(x)=1[x\\in A].\n$$\n\nHere, the Iverson bracket expression $1[8\\in F]$ has $x=8$ and $A=F.$ Therefore, converting back to set indicator notation, we have\n\n$$\n1[8\\in F]={1}_{F}(8).\n$$"}]}
