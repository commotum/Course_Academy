)</mo><mo>+</mo><mn>3</mn></mtd><mtd><mi></mi><mo>=</mo><mn>8</mn></mtd></mtr><mtr><mtd><mtext>rank</mtext><mo stretchy=\"false\">(</mo><mi>A</mi><mo stretchy=\"false\">)</mo></mtd><mtd><mi></mi><mo>=</mo><mn>8</mn><mo>−</mo><mn>3</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>5.</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
