            },
            {
              "option": "b",
              "dom_id": "questionWidget-choiceLetterCircle-142542-b",
              "type": "text",
              "value": "II and  III only",
              "html": "II and  III only "
            },
            {
              "option": "c",
              "dom_id": "questionWidget-choiceLetterCircle-142542-c",
              "type": "text",
              "value": "I and II only",
              "html": "I and II only "
            },
