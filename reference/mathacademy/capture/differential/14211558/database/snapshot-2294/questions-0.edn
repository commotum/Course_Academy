b/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453404} {:answer/id #uuid "adeaa133-0730-51b1-8b37-ab1eabd66c91" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453405}] :answer-field/correct {:answer/id #uuid "adeaa133-0730-51b1-8b37-ab1eabd66c91" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453405} :answer-field/id #uuid "f8f82a48-c4e0-5658-a295-60736c7e5166" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454452} {:answer-field/choices [{:answer/id #uuid "88d7d24f-3606-50eb-9098-a34319240958" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453406} {:answer/id #uuid "535a174d-2f6e-5ab0-99bb-3ccad768cc35" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453407}] :answer-field/correct {:answer/id #uuid "88d7d24f-3606-50eb-9098-a34319240958" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453406} :answer-field/id #uuid "59aa5f02-f270-5643-aeca-3ee7824a7629" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454453} {:answer-field/choices [{:answer/id #uuid "99558d31-6961-52e7-b662-299510c283b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453408} {:answer/id #uuid "688a37cc-bcaf-529c-a80d-90d43dc9aa3f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453409}] :answer-field/correct {:answer/id #uuid "99558d31-6961-52e7-b662-299510c283b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453408} :answer-field/id #uuid "4f387ba8-880e-5912-8b03-6a51150d10c2" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454454}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "017db163-2592-561e-a975-d762dc265a45" :question/math-academy-id "q-142542" :question/problem "Which of the following statements are true, given that $A$ is a $5\\times 5$ matrix and \n\n$$\n\\text{Null}(A)=\\text{Span}{\\begin{bmatrix}1 \\\\ -2 \\\\ 0 \\\\ 0 \\\\ 1\\end{bmatrix},\\,\\begin{bmatrix}3 \\\\ 0 \\\\ -1 \\\\ 0 \\\\ 2\\end{bmatrix}}?\n$$\n\nSelect all that apply.\n\n- **I.** $\\text{rank}(A)=3$\n- **II.** $\\text{Col}(A)={R}^{5}$\n- **III.** $A$ is  invertible" :question/worked-solution "Since $A$ is a $5\\times 5$ matrix, the invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,{\\,\\begin{aligned} & \\text{Col}(A)={R}^{5} \\\\  & \\text{dim(Col}(A))=5=\\text{rank}(A) \\\\  & \\text{Null}(A)={0} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$\n\nAlso, according to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Indeed, since\n\n$$\n\\text{Null}(A)=\\text{Span}{\\begin{bmatrix}1 \\\\ -2 \\\\ 0 \\\\ 0 \\\\ 1\\end{bmatrix},\\,\\begin{bmatrix}3 \\\\ 0 \\\\ -1 \\\\ 0 \\\\ 2\\end{bmatrix}}\n$$\n\n \nwe have that $\\text{nullity}(A)=2.$\n\nNow,  for the matrix $A,$ the number of columns is $n=5,$ so according to the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ \\text{rank}(A)+2 & =5 \\\\ \\text{rank}(A) & =5-2 \\\\  & =3.\\end{aligned}\n$$\n\n- Statement II is false. Since $\\text{nullity}(A)=2\\ne 0,$ then by the invertible matrix theorem, we have $\\text{Col}(A)\\ne {R}^{5}.$\n\n- Statement III is false. Since $\\text{rank}(A)=3\\ne 5$, according to the  invertible matrix theorem $A$ can't be an invertible matrix.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186184754 :knowledge-point/_questions [{:db/id #edb/ref 17592186184219 :knowledge-point/id #uuid "fcbc10c0-4e6b-5dac-ad87-f0175e4a53d2" :knowledge-point/title "Finding the Rank or Nullity of a Matrix Using the Rank-Nullity Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "961371f2-f71a-573d-9b98-504222de4a10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186183134} {:answer/id #uuid "9a9bdf09-8484-50e4-907e-eeceb6bf01c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186183135} {:answer/id #uuid "a9063a2f-983f-511b-8320-eb5479f9dbd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186183136} {:answer/id #uuid "37b465af-8d04-53f5-a8eb-c31f56a99ea6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186183137} {:answer/id #uuid "781325c3-e9c6-5691-9247-c29a5c79d34c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186183138}] :answer-field/correct {:answer/id #uuid "a9063a2f-983f-511b-8320-eb5479f9dbd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186183136} :answer-field/id #uuid "8ef2d522-f80e-5da1-ba53-1027339ce406" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186183133}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a05d1874-f484-5b03-a7ba-b2697b84a74b" :question/math-academy-id "q-34833" :question/problem "Consider a $5\\times 8$ matrix $A.$ If $\\text{dim(Null(}A))=3,$ then $\\text{rank}(A)=$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=8.$ Therefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ \\text{rank}(A)+3 & =8 \\\\ \\text{rank}(A) & =8-3 \\\\  & =5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186184757 :knowledge-point/_questions [{:db/id #edb/ref 17592186184172 :knowledge-point/id #uuid "5e145cb2-806a-579d-8299-8a91a6feaad1" :knowledge-point/title "Identifying True Statements Using the Invertible Matrix Theorem and the Rank-Nullity Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "148c103f-607d-5f86-b626-7f905a9009be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186183152} {:answer/id #uuid "1a5566c6-f36e-5fa6-963f-ff29a059239e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186183153} {:answer/id #uuid "1eee22c0-aaee-5c76-b935-89d9e34d716f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186183154} {:answer/id #uuid "21dd967c-ba0d-5081-815f-e4707b87b16d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186183155} {:answer/id #uuid "6a680598-5a75-5f51-afed-93c0cd66c558" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186183156}] :answer-field/correct {:answer/id #uuid "1a5566c6-f36e-5fa6-963f-ff29a059239e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186183153} :answer-field/id #uuid "2c0659d5-6754-5a2c-b59d-a8d4e248b40e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186183151}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "50dd3dbf-46fe-5a60-971b-ec20882fc4a4" :question/math-academy-id "q-34934" :question/problem "Which of the following statements are true given that $A$ is a $4\\times 4$ matrix with $3$ pivot columns?\n\nI. $\\text{rank}(A)=3$\n\nII. $A$ is invertible\n\nIII. $\\text{nullity}(A)=1$" :question/worked-solution "Since $A$ is a $4\\times 4$ matrix, the invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,\\{\\,\\begin{aligned} & \\text{Col}(A)={R}^{4} \\\\  & \\text{dim(Col}(A))=4=\\text{rank}(A) \\\\  & \\text{Null}(A)=\\{0\\} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$\n\nAlso, according to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Indeed, since $A$ has $3$ pivot columns, we have $\\text{rank}(A)=3.$\n\n- Statement II is false. For the matrix $A,$ the number of the columns is $n=4.$ Now, since $\\text{rank}(A)\\ne 4,$ then by the invertible matrix theorem, we have that $A$ is not invertible.\n\n- Statement III is true. According to  the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ 3+\\text{nullity}(A) & =4 \\\\ \\text{nullity}(A) & =4-3 \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186522781 :knowledge-point/_questions [{:db/id #edb/ref 17592186184172 :knowledge-point/id #uuid "5e145cb2-806a-579d-8299-8a91a6feaad1" :knowledge-point/title "Identifying True Statements Using the Invertible Matrix Theorem and the Rank-Nullity Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09f279b3-ea5e-5d31-9dcd-0a3e8e1b3a8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186522038} {:answer/id #uuid "2c39de95-065d-5909-a31e-8aec18fcaa30" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186522120} {:answer/id #uuid "5c15ec5b-b014-5f4f-aedd-7a3ee80c6e43" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186522210} {:answer/id #uuid "c65ee4e2-e412-5286-95cc-2961eb9dd28d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186522434} {:answer/id #uuid "daf23a31-b6e9-551f-8960-6733a9da0c3b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186522473}] :answer-field/correct {:answer/id #uuid "09f279b3-ea5e-5d31-9dcd-0a3e8e1b3a8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186522038} :answer-field/id #uuid "cf7368f2-5a45-59f1-9769-661d58ae07d3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186522656}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c579df31-38e7-5faa-a719-e9a3badf209e" :question/math-academy-id "q-35435" :question/problem "Which of the following statements are true, given that $A$ is a $4\\times 4$ matrix and $\\text{Null}(A)=\\{[\\begin{aligned}{x}_{1} \\\\ 2{x}_{1} \\\\ -3{x}_{1} \\\\ -4{x}_{1}\\end{aligned}]\\,|\\,{x}_{1}\\in R\\}?$ \n\nI. $\\text{rank}(A)=3$\n\nII. $\\text{Col}(A)={R}^{4}$\n\nIII. $A$ is not invertible" :question/worked-solution "Since $A$ is a $4\\times 4$ matrix, the invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,\\{\\,\\begin{aligned} & \\text{Col}(A)={R}^{4} \\\\  & \\text{dim(Col}(A))=4=\\text{rank}(A) \\\\  & \\text{Null}(A)=\\{0\\} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$\n\nAlso, according to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Indeed, since \n\n$$\n\\text{Null}(A)=\\{[\\begin{aligned}{x}_{1} \\\\ 2{x}_{1} \\\\ -3{x}_{1} \\\\ -4{x}_{1}\\end{aligned}]\\,|\\,{x}_{1}\\in R\\}=\\text{Span}\\{\\,[\\begin{aligned}1 \\\\ 2 \\\\ -3 \\\\ -4\\end{aligned}]\\}\n$$\n\n \nwe have that $\\text{nullity}(A)=1.$\n\nNow,  for the matrix $A,$ the number of columns is $n=4,$ so according to the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ \\text{rank}(A)+1 & =4 \\\\ \\text{rank}(A) & =4-1 \\\\  & =3.\\end{aligned}\n$$\n\n- Statement II is false. Since $\\text{rank}(A)=3\\ne 4,$ then, by the invertible matrix theorem, we have $\\text{Col}(A)\\ne {R}^{4}.$\n\n- Statement III is true. Indeed, since $\\text{rank}(A)=3\\ne 4$, according to the  invertible matrix theorem $A$ can't be an invertible matrix.\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186377756 :knowledge-point/_questions [{:db/id #edb/ref 17592186184171 :knowledge-point/id #uuid "d562ea0c-94f3-5fe6-ba82-c651a51d0bbe" :knowledge-point/title "Finding the Rank or Nullity of a Matrix Given a Description of the Column or Null Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aca86402-c665-55ad-96e2-e7faee870cc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186377758} {:answer/id #uuid "701ec281-64bf-55a9-a13a-9af209eaff5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186377759} {:answer/id #uuid "93249bda-5da5-5cfd-8d15-56c91976394d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186377760} {:answer/id #uuid "60b2f467-bf50-5ae6-993c-21e4a93659ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186377761} {:answer/id #uuid "cfdd441a-d8f0-5c12-b7bc-0bc161b02d98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186377762}] :answer-field/correct {:answer/id #uuid "93249bda-5da5-5cfd-8d15-56c91976394d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186377760} :answer-field/id #uuid "0ef6c019-6203-53f2-a536-cc2b8d76a9fb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186377757}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0131f756-450c-5ffd-bd43-d0c24b54342a" :question/math-academy-id "q-79352" :question/problem "Find $\\text{rank}(A)$ given that $\\text{Null}(A)=\\{\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3} \\\\ 0\\end{bmatrix}\\,|\\,\\,{x}_{1},{x}_{2},{x}_{3}\\in R\\}.$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=4,$ since this is the number of components in each of the vectors of the null space. \n\nAlso, since \n\n$$\n\\text{Null}(A)=\\{{x}_{1}\\begin{bmatrix}1 \\\\ 0 \\\\ 0 \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}0 \\\\ 1 \\\\ 0 \\\\ 0\\end{bmatrix}+{x}_{3}\\begin{bmatrix}0 \\\\ 0 \\\\ 1 \\\\ 0\\end{bmatrix}\\,|\\,\\,{x}_{1},{x}_{2},{x}_{3}\\in R\\}\n$$\n\nwe conclude that $\\text{nullity}(A)=3.$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ \\text{rank}(A)+3 & =4 \\\\ \\text{rank}(A) & =4-3 \\\\  & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186348222 :knowledge-point/_questions [{:db/id #edb/ref 17592186184172 :knowledge-point/id #uuid "5e145cb2-806a-579d-8299-8a91a6feaad1" :knowledge-point/title "Identifying True Statements Using the Invertible Matrix Theorem and the Rank-Nullity Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c56bbd1f-d979-5241-8dc4-a8e64037e678" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451747} {:answer/id #uuid "b5789825-466e-5d22-9f09-42c97e0435a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451748}] :answer-field/correct {:answer/id #uuid "c56bbd1f-d979-5241-8dc4-a8e64037e678" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451747} :answer-field/id #uuid "3cc17da3-e4d0-5047-880f-6b1aaa55e9cb" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452721} {:answer-field/choices [{:answer/id #uuid "e85400e8-1b39-5381-89d4-9456a7b1822c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451749} {:answer/id #uuid "a330ce1f-b4c7-5d2b-9114-283fa3e27999" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451750}] :answer-field/correct {:answer/id #uuid "a330ce1f-b4c7-5d2b-9114-283fa3e27999" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451750} :answer-field/id #uuid "3fca603b-0e04-57c7-b9ac-a845c8d3054f" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452722} {:answer-field/choices [{:answer/id #uuid "47f7bb58-5fc7-50bf-bcf6-b8a2a3b9a52d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451751} {:answer/id #uuid "927e07de-2922-5088-8e17-5260e4060177" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451752}] :answer-field/correct {:answer/id #uuid "927e07de-2922-5088-8e17-5260e4060177" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451752} :answer-field/id #uuid "6904f830-30a3-5787-9c3c-630ff0631353" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452723}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "251cb9e2-c851-5082-b166-e39206cbabf3" :question/math-academy-id "q-79420" :question/problem "Which of the following statements are true given that $A$ is a $4\\times 4$ matrix with only  $1$ pivot column?\n\nSelect all that apply.\n\n- **I.** $\\text{rank}(A)=3$\n- **II.** $A$ is not  invertible\n- **III.** $\\text{nullity}(A)=3$" :question/worked-solution "Since $A$ is a $4\\times 4$ matrix, the invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,{\\,\\begin{aligned} & \\text{Col}(A)={R}^{4} \\\\  & \\text{dim(Col}(A))=4=\\text{rank}(A) \\\\  & \\text{Null}(A)={0} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$\n\nAlso, according to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. Since $A$ has just $1$ pivot column, we have $\\text{rank}(A)=1.$\n\n- Statement II is true. Indeed, for the matrix $A,$ the number of the columns is $n=4.$ Now, since $\\text{rank}(A)\\ne 4,$ then by the invertible matrix theorem,  $A$ can't be an invertible matrix.\n\n- Statement III is true. According to  the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ 1+\\text{nullity}(A) & =4 \\\\ \\text{nullity}(A) & =4-1 \\\\  & =3.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"II and III only.\""}]}
