2</mn></msup><mo>−</mo><mn>8</mn><mi>s</mi><mi>t</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>8</mn><mi>s</mi><mi>t</mi><mo stretchy=\"false\">(</mo><mi>t</mi><mo>−</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
