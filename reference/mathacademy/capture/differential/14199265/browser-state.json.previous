riptlevel=\"0\"><mfrac><mn>1</mn><mrow><mi>x</mi><mo>+</mo><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mn>2</mn><mi>x</mi></mrow></msup></mrow></mfrac></mstyle><mo>⋅</mo><mn>2</mn><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mn>2</mn><mi>x</mi></mrow></msup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mrow><mi>x</mi><mo>+</mo><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mn>2</mn><mi>x</mi></mrow></msup></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>2</mn><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mn>2</mn><mi>x</mi></mrow></msup></mrow><mrow><mi>x</mi><mo>+</mo><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mn>2</mn><mi>x</mi></mrow></msup></mrow></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>1</mn><mo>+</mo><mn>2</mn><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mn>2</mn><mi>x</mi></mrow></msup></mrow><mrow><mi>x</mi><mo>+</mo><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mn>2</mn><mi>x</mi></mrow></msup></mrow></mfrac></mstyle><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
