#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186512983} :activity/id #uuid "27d0ee72-208c-5c09-ba82-7aa73065e9b0" :activity/scope {:db/id #edb/ref 17592186048382 :topic/id #uuid "9aa3613b-2082-5f1b-a095-b04ef602af6c" :topic/math-academy-id 3859} :activity/steps [{:db/id #edb/ref 17592186512960 :step/content {:db/id #edb/ref 17592186188560 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a034f7f5-667f-5d78-89ec-33445bb17e28" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.5910" :db/id #edb/ref 17592186185641} {:answer/id #uuid "e0f44b2f-6940-595b-8c91-9baf2d59cd3c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.5832" :db/id #edb/ref 17592186185642} {:answer/id #uuid "e1b69bf7-a884-521d-b233-367aca9e42ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.6293" :db/id #edb/ref 17592186185643} {:answer/id #uuid "e9f57c3d-c47a-5507-84a1-788aa176ded2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.5478" :db/id #edb/ref 17592186185644} {:answer/id #uuid "6a1a1df8-d850-5bfb-852c-5cc90445cac3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.5438" :db/id #edb/ref 17592186185645}] :answer-field/correct {:db/id #edb/ref 17592186185645} :answer-field/id #uuid "7ef066c8-5867-57df-9cd2-7f2cacd6cc82" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186185640}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "45de5135-ee01-5bcd-b1d8-57abf5216ebd" :question/math-academy-id "q-143258" :question/problem "Given that ${X}_{1},{X}_{2},…,{X}_{20}$ are I.I.D random variables, where\n\n$$\n{X}_{i}∼N(1,{2}^{2}),\\,1\\le i\\le 20,\n$$\n\ncalculate $P(Y\\le 21),$ where  $Y={X}_{1}+{X}_{2}+⋯+{X}_{20}.$\n\n*Hint: A table of values of $Φ(z)$ for different values of $z$ is given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $z$ | $\\,0.00\\,$ | $\\,0.01\\,$ | $\\,0.02\\,$ | $\\,0.03\\,$ |\n| --- | --- | --- | --- | --- |\n| $\\,0.1\\,$ | $\\,0.5398\\,$ | $\\,0.5438\\,$ | $\\,0.5478\\,$ | $\\,0.5517\\,$ |\n| $\\,0.2\\,$ | $\\,0.5793\\,$ | $\\,0.5832\\,$ | $\\,0.5871\\,$ | $\\,0.5910\\,$ |\n| $\\,0.3\\,$ | $\\,0.6179\\,$ | $\\,0.6217\\,$ | $\\,0.6255\\,$ | $\\,0.6293\\,$ |" :question/requires-calculator true :question/worked-solution "Recall that if ${X}_{1},{X}_{2},…,{X}_{20}$ are independent and identically distributed (I.I.D) normal random variables, where \n\n$$\n{X}_{i}∼N(\\mu ,{\\sigma }^{2}),\\,1\\le i\\le n,\n$$\n\nthen \n\n$$\nY={X}_{1}+{X}_{2}+⋯+{X}_{n}∼N(n\\mu ,\\,n{\\sigma }^{2}).\n$$\n\nTherefore, since ${X}_{1},{X}_{2},…,{X}_{20}$ are independent and identically distributed, we have \n\n$$\n\\begin{aligned}Y={X}_{1}+{X}_{2}+⋯+{X}_{20} & ∼N(20\\cdot 1,\\,20\\cdot {2}^{2}) \\\\  & ∼N(20\\cdot 1,\\,20\\cdot 4) \\\\  & =N(20,80).\\end{aligned}\n$$\n\nWe wish to compute the probability $P(Y\\le 21).$ We first convert $Y$ into a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(Y\\le 21) & =P(Z\\le \\frac{21-20}{\\sqrt{80}}) \\\\  & =P(Z\\le \\frac{1}{\\sqrt{80}}) \\\\  & =P(Z\\le 0.11) \\\\  & =Φ(0.11)\\end{aligned}\n$$\n\nFrom the $z$-table, we have\n\n$$\nΦ(0.11)=0.5438.\n$$\n\nTherefore,\n\n$$\nP(Y\\le 21)=Φ(0.11)=0.5438.\n$$"} :step/id #uuid "04354192-e8c2-529d-a53b-555b1aaafd7d" :step/next {:db/id #edb/ref 17592186512972}} {:db/id #edb/ref 17592186512972 :step/content {:db/id #edb/ref 17592186512913 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17949f3a-e1f1-5fa7-8148-b9750780d3b2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.4656" :db/id #edb/ref 17592186512153} {:answer/id #uuid "25630579-f260-5b6b-b01f-0c206dde9b22" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.4564" :db/id #edb/ref 17592186512180} {:answer/id #uuid "79702301-2460-524d-aca3-8152b4171769" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.4726" :db/id #edb/ref 17592186512385} {:answer/id #uuid "9756be1e-a09c-5697-a99e-d25af2662f83" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.4554" :db/id #edb/ref 17592186512456} {:answer/id #uuid "a48296a2-de5e-5ceb-9972-e4e36140f4b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.4719" :db/id #edb/ref 17592186512486}] :answer-field/correct {:db/id #edb/ref 17592186512385} :answer-field/id #uuid "31e87839-a244-5651-ab20-8782a2fd6c04" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186512752}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "989181af-177e-5503-a508-c854844640ac" :question/math-academy-id "q-152019" :question/problem "In a particular shop, cables are sold in coils. The length of the cable in a coil is normally distributed with a mean of $50\\,\\text{m}$ and a standard deviation of $0.7\\,\\text{m}.$ If John bought $5$ coils, what is the probability that the total length of the cables he bought is greater than $250\\,\\text{m}$ and less than $253\\,m?$ You may assume that the lengths of the cable in the coils are mutually independent.\n\n*Hint: A table of values of $Φ(z)$ for different values of $z$ is given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution.*\n\n| $z$ | $\\,0.00\\,$ | $\\,0.01\\,$ | $\\,0.02\\,$ | $\\,0.03\\,$ |\n| --- | --- | --- | --- | --- |\n| $\\,1.7\\,$ | $\\,0.9554\\,$ | $\\,0.9564\\,$ | $\\,0.9573\\,$ | $\\,0.9582\\,$ |\n| $\\,1.8\\,$ | $\\,0.9641\\,$ | $\\,0.9649\\,$ | $\\,0.9656\\,$ | $\\,0.9664\\,$ |\n| $\\,1.9\\,$ | $\\,0.9713\\,$ | $\\,0.9719\\,$ | $\\,0.9726\\,$ | $\\,0.9732\\,$ |" :question/worked-solution "Let ${X}_{i}$ denote the length of cable in the $i$th coil. Then, we have\n\n$$\n{X}_{i}∼N(50,{0.7}^{2}),\\,1\\le i\\le 5.\n$$\n\nLet the random variable $L$ denote the total length of the cables in $5$ randomly selected coils. Then, since\n\n$$\nL={X}_{1}+{X}_{2}+⋯+{X}_{5},\n$$\n\nwe have that $L$ is normally distributed, where\n\n$$\n\\begin{aligned}\\text{E}[L] & =5\\cdot 50 \\\\  & =250, \\\\ \\text{Var}[L] & =5\\cdot {0.7}^{2} \\\\  & =2.45.\\end{aligned}\n$$\n\nTherefore,\n\n$$\nL∼N(250,2.45).\n$$\n\nIn order to find $P(250<L<253),$ we convert $L$ to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(250<L<253) & =P(\\frac{250-250}{\\sqrt{2.45}}<Z<\\frac{253-250}{\\sqrt{2.45}}) \\\\  & ≈P(0<Z<1.92) \\\\  & =Φ(1.92)-Φ(0) \\\\  & =Φ(1.92)-0.5\\end{aligned}\n$$\n\nUsing the $z$-table, we see that\n\n$$\nΦ(1.92)≈0.9726.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(250<L<253) & ≈Φ(0.95)-0.5 \\\\  & ≈0.4726.\\end{aligned}\n$$"} :step/id #uuid "2b2730d2-89fd-53dd-b1f9-3ac5795fc863" :step/next {:db/id #edb/ref 17592186512987}} {:db/id #edb/ref 17592186512983 :step/content {:db/id #edb/ref 17592186512937 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ec85ad5-7ebb-57fe-b54b-9f5f21beff93" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.7673" :db/id #edb/ref 17592186512127} {:answer/id #uuid "10502504-65e5-552d-8583-e710377ff51e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.2266" :db/id #edb/ref 17592186512132} {:answer/id #uuid "6b9307e2-adf7-5f81-ab85-5654801c0e6b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.2327" :db/id #edb/ref 17592186512355} {:answer/id #uuid "be94cbff-4f1f-52e7-8aca-b344e58fdc42" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.7995" :db/id #edb/ref 17592186512557} {:answer/id #uuid "f1b89101-b002-5379-99aa-15ff76a8e86e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.7734" :db/id #edb/ref 17592186512683}] :answer-field/correct {:db/id #edb/ref 17592186512127} :answer-field/id #uuid "160c9e56-fbfc-5c34-9ac0-b74ec90271f9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186512736}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c6ec9582-211a-54f7-b78a-6175feef090c" :question/math-academy-id "q-110256" :question/problem "A seller delivers bricks on pallets. One pallet contains $500$ bricks. The weight of a brick is normally distributed with a mean of $3\\,\\text{lb}$ and a standard deviation of $0.25\\,\\text{lb},$ while the weight of a pallet is normally distributed with a mean of $40\\,\\text{lb}$ and a standard deviation of $4\\,\\text{lb}.$ If one pallet with bricks is randomly selected, what is the probability that it weighs less than $1\\,545\\,\\text{lb}?$ You may assume that the weights are independent.\n\n*Hint: A table of values of $Φ(z)$ for different values of $z$ is given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $z$ | $\\,0.02\\,$ | $\\,0.03\\,$ | $\\,0.04\\,$ | $\\,0.05\\,$ |\n| --- | --- | --- | --- | --- |\n| $\\,0.6\\,$ | $\\,0.7324\\,$ | $\\,0.7357\\,$ | $\\,0.7389\\,$ | $\\,0.7422\\,$ |\n| $\\,0.7\\,$ | $\\,0.7642\\,$ | $\\,0.7673\\,$ | $\\,0.7704\\,$ | $\\,0.7734\\,$ |\n| $\\,0.8\\,$ | $\\,0.7939\\,$ | $\\,0.7967\\,$ | $\\,0.7995\\,$ | $\\,0.8023\\,$ |" :question/worked-solution "Let ${X}_{i}$ denote the weight of the $i$th brick, and let $Y$ denote the weight of a pallet. Then, we have\n\n$$\n{X}_{i}∼N(3,{0.25}^{2}),\\,1\\le i\\le 500,\n$$\n\nand\n\n$$\nY∼N(40,{4}^{2}).\n$$\n\nLet the random variable $W$ denote the weight of a randomly selected pallet with bricks. Then, since\n\n$$\nW={X}_{1}+{X}_{2}+⋯+{X}_{500}+Y,\n$$\n\nwe have that $W$ is normally distributed, where\n\n$$\n\\begin{aligned}\\text{E}[W] & =500\\cdot 3+40 \\\\  & =1\\,540, \\\\ \\text{Var}[W] & =500\\cdot {0.25}^{2}+{4}^{2} \\\\  & =47.25.\\end{aligned}\n$$\n\nTherefore,\n\n$$\nW∼N(1\\,540,47.25).\n$$\n\nIn order to find $P(W<1\\,545),$ we convert $W$ to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(W<1\\,545) & =P(Z<\\frac{1\\,545-1\\,540}{\\sqrt{47.25}}) \\\\  & ≈P(Z<0.73) \\\\  & =Φ(0.73)\\end{aligned}\n$$\n\nUsing the $z$-table, we see that\n\n$$\nΦ(0.73)≈0.7673.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(W<1\\,545) & ≈Φ(0.73) \\\\  & ≈0.7673.\\end{aligned}\n$$"} :step/id #uuid "502f1960-fa25-50be-8c53-84accf0f2fb6" :step/next {:db/id #edb/ref 17592186513015}} {:db/id #edb/ref 17592186512987 :step/content {:db/id #edb/ref 17592186512875 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "013c0744-9228-52be-a7b5-6457edce0d29" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.3925" :db/id #edb/ref 17592186512100} {:answer/id #uuid "39b93a6a-bc02-50a9-a873-0a2689de3fe8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.3531" :db/id #edb/ref 17592186512226} {:answer/id #uuid "57d360fe-135c-5e2f-b5ac-5b495990fb44" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.3508" :db/id #edb/ref 17592186512298} {:answer/id #uuid "7b822a13-ca96-5490-99e8-f8267cac2050" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.3485" :db/id #edb/ref 17592186512391} {:answer/id #uuid "e8ef5f62-ade0-52c3-b720-4570930c7d3d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.3708" :db/id #edb/ref 17592186512657}] :answer-field/correct {:db/id #edb/ref 17592186512226} :answer-field/id #uuid "65f1e10a-d8c8-58e5-b10d-6e1e77a5ab90" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186512783}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "141fc269-b2bd-5ee7-86fd-0b448fecc7f6" :question/math-academy-id "q-152022" :question/problem "Fred picked $10$ watermelons from his vegetable garden. The weight of watermelons he grows is normally distributed with a mean of $11\\,\\text{kg}$ and a standard deviation of $3\\,\\text{kg}.$ What is the probability that the total weight of the watermelons Fred picked is greater than $100\\,\\text{kg}$ and less than $110\\,\\text{kg}?$ You may assume that the weights of the watermelons are mutually independent.\n\n*Hint: A table of values of $Φ(z)$ for different values of $z$ is given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution.*\n\n| $z$ | $\\,0.02\\,$ | $\\,0.03\\,$ | $\\,0.04\\,$ | $\\,0.05\\,$ |\n| --- | --- | --- | --- | --- |\n| $\\,1.0\\,$ | $\\,0.8461\\,$ | $\\,0.8485\\,$ | $\\,0.8508\\,$ | $\\,0.8531\\,$ |\n| $\\,1.1\\,$ | $\\,0.8686\\,$ | $\\,0.8708\\,$ | $\\,0.8729\\,$ | $\\,0.8749\\,$ |\n| $\\,1.2\\,$ | $\\,0.8888\\,$ | $\\,0.8907\\,$ | $\\,0.8925\\,$ | $\\,0.8944\\,$ |" :question/worked-solution "Let ${X}_{i}$ denote the weight of the $i$th watermelon. Then, we have\n\n$$\n{X}_{i}∼N(11,{3}^{2}),\\,1\\le i\\le 10.\n$$\n\nLet the random variable $W$ denotes the total weight of the $10$ watermelons. Then, since\n\n$$\nW={X}_{1}+{X}_{2}+⋯+{X}_{10},\n$$\n\nwe have that $W$ is normally distributed, where\n\n$$\n\\begin{aligned}\\text{E}[W] & =10\\cdot 11 \\\\  & =110, \\\\ \\text{Var}[W] & =10\\cdot {3}^{2} \\\\  & =90.\\end{aligned}\n$$\n\nTherefore,\n\n$$\nW∼N(110,90).\n$$\n\nIn order to find $P(100<W<110),$ we convert $W$ to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(100<W<110) & =P(\\frac{100-110}{\\sqrt{90}}<Z<\\frac{110-110}{\\sqrt{90}}) \\\\  & ≈P(-1.05<Z<0) \\\\  & =Φ(0)-Φ(-1.05) \\\\  & =Φ(0)-(1-Φ(1.05)) \\\\  & =0.5-(1-Φ(1.05)) \\\\  & =Φ(1.05)-0.5\\end{aligned}\n$$\n\nUsing the $z$-table, we see that\n\n$$\nΦ(1.05)≈0.8531.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(100<W<110) & ≈Φ(1.05)-0.5 \\\\  & ≈0.3531.\\end{aligned}\n$$"} :step/id #uuid "56dfdf28-b75e-51a6-9103-e7c4a4c58570"} {:db/id #edb/ref 17592186513015 :step/content {:db/id #edb/ref 17592186188559 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2abc9490-9339-5c9e-986a-5e945e4cb8ca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "Y∼N(20,1600)" :db/id #edb/ref 17592186512199} {:answer/id #uuid "6a8a87c2-8fa4-5c79-9bbb-69e4fccb6e51" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "Y∼N(20,400)" :db/id #edb/ref 17592186512354} {:answer/id #uuid "afdde64d-2ea7-5d46-8675-d296e7768222" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "Y∼N(20,80)" :db/id #edb/ref 17592186512512} {:answer/id #uuid "bf303566-e2e4-5512-bed7-eae7c312cb55" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "Y∼N(1,1600)" :db/id #edb/ref 17592186512559} {:answer/id #uuid "cd7cabdf-c24e-5682-a89a-fff839a0da01" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "Y∼N(1,80)" :db/id #edb/ref 17592186512592}] :answer-field/correct {:db/id #edb/ref 17592186512512} :answer-field/id #uuid "71c7e79b-2744-5b90-a18e-a13773a527c1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186185634}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "96c4f612-b1f3-5692-9774-d57bde6c42ad" :question/math-academy-id "q-142859" :question/problem "Given that ${X}_{1},{X}_{2},…,{X}_{20}$ are I.I.D random variables, where\n\n$$\n{X}_{i}∼N(1,{2}^{2}),\\,1\\le i\\le 20,\n$$\n\nwhat is the distribution of $Y={X}_{1}+{X}_{2}+⋯+{X}_{20}?$" :question/requires-calculator true :question/worked-solution "Recall that if ${X}_{1},{X}_{2},…,{X}_{20}$ are independent and identically distributed (I.I.D) normal random variables, where \n\n$$\n{X}_{i}∼N(\\mu ,{\\sigma }^{2}),\\,1\\le i\\le n,\n$$\n\nthen \n\n$$\nY={X}_{1}+{X}_{2}+⋯+{X}_{n}∼N(n\\mu ,\\,n{\\sigma }^{2}).\n$$\n\nTherefore, since ${X}_{1},{X}_{2},…,{X}_{20}$ are mutually independent, we have \n\n$$\n\\begin{aligned}Y={X}_{1}+{X}_{2}+⋯+{X}_{20} & ∼N(20\\cdot 1,\\,20\\cdot {2}^{2}) \\\\  & ∼N(20\\cdot 1,\\,20\\cdot 4) \\\\  & =N(20,80).\\end{aligned}\n$$"} :step/id #uuid "b77ef207-4e3c-52e8-8d17-85be88f14843" :step/next {:db/id #edb/ref 17592186512960}}] :activity/title "I.I.D Normal Random Variables" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186512084}]}
