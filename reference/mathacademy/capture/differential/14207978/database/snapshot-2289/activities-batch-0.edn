nswer-field/id #uuid "7ba7a927-c65d-53d2-a68e-2a711452828e" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186454567} {:answer-field/choices [{:answer/id #uuid "d8c84692-3840-51b5-880d-3386d31c4f51" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186453636} {:answer/id #uuid "8dc1d84f-0a08-51e1-9122-944928bd54c0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186453637}] :answer-field/correct {:db/id #edb/ref 17592186453637} :answer-field/id #uuid "91aa8150-4bc8-561c-9c32-8cfddb99b464" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186454568} {:answer-field/choices [{:answer/id #uuid "4f8ce0ad-e15d-5071-aae6-6ebf6f10905b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186453638} {:answer/id #uuid "34bd4c0a-6891-5927-8f43-1900cd830078" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186453639}] :answer-field/correct {:db/id #edb/ref 17592186453638} :answer-field/id #uuid "728d40e4-2d8b-5727-be86-396f6263ab1f" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186454569}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "1308109d-5efe-51ad-bfa1-4050522344dd" :question/math-academy-id "q-182506" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $A⇒¬B≡¬(A∧B)$\n- **II.** $¬(A⇒¬B)≡A∧B$\n- **III.** $¬(A⇒¬B)≡¬A∧B$" :question/worked-solution "Let's examine each of our statements:\n\n- Statement I is true. Indeed, $A⇒¬B$ is logically equivalent to the disjunction $¬A∨¬B,$ which by De Morgan's law is equivalent to $¬(A∧B).$\n\n- Statement II is true, while statement III is false. From part I, we have the following equivalence:\n\n$$\nA⇒¬B≡¬(A∧B)\n$$\n\nBy negating this statement, we get\n\n$$\n¬(A⇒¬B)≡¬(¬(A∧B)).\n$$\n\nCanceling out double negation, we reach\n\n$$\nA∧B.\n$$\n\nSo, $¬(A⇒¬B)$ is equivalent to $A∧B.$\n\nTherefore, the correct answer is \"I and II only.\""} :step/id #uuid "7e76a699-413c-5c79-9a86-67728b6bb289"} {:db/id #edb/ref 17592186409588 :step/content {:db/id #edb/ref 17592186409586 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "191c421c-bbe9-5286-9beb-03027543bcc3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "B∨¬C" :db/id #edb/ref 17592186409566} {:answer/id #uuid "33e9615f-fd80-5202-949f-ebfef4f3e8b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬B∨C" :db/id #edb/ref 17592186409569} {:answer/id #uuid "35dc661b-8042-5dd9-ae2c-1ddb0493316b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "B∧¬C" :db/id #edb/ref 17592186409570} {:answer/id #uuid "442d26c2-04f3-57d7-adf7-53465469c631" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬B∧C" :db/id #edb/ref 17592186409572} {:answer/id #uuid "4c2b2d55-0e4e-5769-9706-03ec9ecc763c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "B∨C" :db/id #edb/ref 17592186409573}] :answer-field/correct {:db/id #edb/ref 17592186409566} :answer-field/id #uuid "eea492f1-156d-5834-96c0-8454fc274282" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186409583}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c7953127-b916-5d8d-98b4-eeece8a2e1ec" :question/math-academy-id "q-81892" :question/problem "Simplify the statement $(¬B∧C)⇒(B∨¬C).$" :question/worked-solution "First, note that\n\n$$\n(¬B∧C)⇒(B∨¬C)≡¬(¬B∧C)∨(B∨¬C).\n$$\n\nWe can distribute the negation over the disjunction using De Morgan's law:\n\n$$\n¬(¬B∧C)∨(B∨¬C)≡(¬(¬B)∨¬C)∨(B∨¬C)\n$$\n\nCanceling out double negations, we reach\n\n$$\n(¬(¬B)∨¬C)∨(B∨¬C)≡(B∨¬C)∨(B∨¬C).\n$$\n\nFinally, we simplify the disjunction of a statement with itself:\n\n$$\n(B∨¬C)∨(B∨¬C)≡B∨¬C\n$$\n\nSo the given statement is equivalent to $B∨¬C.$"} :step/id #uuid "b1214e01-49e9-573c-a4c8-4d572ee5620a" :step/next {:db/id #edb/ref 17592186409589}} {:db/id #edb/ref 17592186409589 :step/content {:db/id #edb/ref 17592186409585 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b57f374-7974-5938-b11d-cfd731887fe8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬X∨¬Y" :db/id #edb/ref 17592186409567} {:answer/id #uuid "33e6f69b-ceb9-546e-bc81-3a178a362d67" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬Y∨X" :db/id #edb/ref 17592186409568} {:answer/id #uuid "42a65b2d-e5f8-5a76-b55d-46a8613eea7f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬Y∧X" :db/id #edb/ref 17592186409571} {:answer/id #uuid "a433720c-898a-5e82-b529-c83bbf9df930" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬X∧Y" :db/id #edb/ref 17592186409577} {:answer/id #uuid "d0b85a9a-afc4-5057-b50b-a3fabfd591bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬X∨Y" :db/id #edb/ref 17592186409579}] :answer-field/correct {:db/id #edb/ref 17592186409568} :answer-field/id #uuid "bc790e07-5a28-514e-aa55-ed9af585fbba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186409582}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6b7c7494-65e2-5888-808a-8604d9b7cfa1" :question/math-academy-id "q-182492" :question/problem "$Y⇒X\\,≡$" :question/worked-solution "The conditional statement $P⇒Q$ is logically equivalent to the disjunction $¬P∨Q:$\n\nSo, in this case, we have the following equivalence:\n\n$$\nY⇒X\\,≡\\,¬Y∨X\n$$"} :step/id #uuid "ede73126-39fd-544c-9a47-ac55caf10274" :step/next {:db/id #edb/ref 17592186409587}}] :activity/title "Logical Equivalence with Conditional Statements" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186409565}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186422172} :activity/id #uuid "ad31faf4-6ba4-59e5-b6eb-0f068c9137a4" :activity/scope {:db/id #edb/ref 17592186049805 :topic/id #uuid "155403ed-fbfa-59a9-b928-e762a73145ef" :topic/math-academy-id 247} :activity/steps [{:db/id #edb/ref 17592186422172 :step/content {:db/id #edb/ref 17592186378712 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "98d0148c-06ef-5117-bace-03063dd6360d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "A∨B" :db/id #edb/ref 17592186378714} {:answer/id #uuid "f9df4014-2df2-5124-bf2b-638e928d7002" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬B∨A" :db/id #edb/ref 17592186378715} {:answer/id #uuid "39a579bf-496b-548c-bd9f-6607183041f4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬B∧A" :db/id #edb/ref 17592186378716} {:answer/id #uuid "c70b7f6e-bb66-5469-8638-e480696d51ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬A∧B" :db/id #edb/ref 17592186378717} {:answer/id #uuid "469bc761-0a98-5c2a-9f58-31c271c74501" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "A∨¬B" :db/id #edb/ref 17592186378718}] :answer-field/correct {:db/id #edb/ref 17592186378714} :answer-field/id #uuid "bef1e854-dcf0-5bf2-bce1-3c3b1e51137e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186378713}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fe611b4a-33af-5b80-a6da-077998756db6" :question/math-academy-id "q-1469" :question/problem "Simplify the statement $¬A⇒B.$" :question/worked-solution "The conditional statement $P⇒Q$ is logically equivalent to the disjunction $¬P∨Q:$\n\nSo, in this case, we have the following equivalence:\n\n$$\n¬A⇒B≡¬(¬A)∨B\n$$\n\nCanceling out double negations, we reach\n\n$$\n¬(¬A)∨B≡A∨B.\n$$\n\nSo the given statement is equivalent to $A∨B.$"} :step/id #uuid "12d4c7cd-cbe3-5cf6-98ac-5ef2b58306b0" :step/next {:db/id #edb/ref 17592186422174}} {:db/id #edb/ref 1759218642217