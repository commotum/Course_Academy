#{[{:db/id #edb/ref 17592186522776 :knowledge-point/_questions [{:db/id #edb/ref 17592186172064 :knowledge-point/id #uuid "59f9abf1-17db-5717-8660-a531ef00b15c" :knowledge-point/title "Evaluating the Gamma Function for a Positive Integer"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f7becfe-c77c-5473-a232-b3c3bddf775b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186522049} {:answer/id #uuid "520ca065-870d-59a7-8783-348ca06299c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "120" :db/id #edb/ref 17592186522195} {:answer/id #uuid "83d4f54f-5c61-5a9f-9835-20e838e22f36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186522283} {:answer/id #uuid "bb5d6295-ffd0-5d13-aba8-b47dc0731864" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186522406} {:answer/id #uuid "c1555d56-be4a-56a8-8306-6e2f3a8f54c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186522420}] :answer-field/correct {:answer/id #uuid "83d4f54f-5c61-5a9f-9835-20e838e22f36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186522283} :answer-field/id #uuid "b8ea08a8-5cc9-5269-9ef3-7f0f35e299e2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186522649}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bb7be639-e4f8-5a73-903b-c5d7e3e570a1" :question/math-academy-id "q-107847" :question/problem "Evaluate $Γ(4).$" :question/worked-solution "For any natural number $n\\ge 1,$ we have\n\n$$\nΓ(n)=(n-1)!.\n$$\n\nTherefore, \n\n$$\nΓ(4)=3!=6.\n$$"}] [{:db/id #edb/ref 17592186162282 :knowledge-point/_questions [{:db/id #edb/ref 17592186162074 :knowledge-point/id #uuid "e247e2c9-3e47-5cf4-be8d-f1f22bb30b39" :knowledge-point/title "Calculating a Joint Probability Containing Inequalities From a Table"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fd153f7-654f-5ed4-b9fe-3b1731a70ce3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.75" :db/id #edb/ref 17592186241460} {:answer/id #uuid "5fa1370c-c82b-5fe3-ad6e-a777ec65e824" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.35" :db/id #edb/ref 17592186242039} {:answer/id #uuid "a54e62bf-fa8c-5810-a8eb-8f31624180ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.2" :db/id #edb/ref 17592186242635} {:answer/id #uuid "c272c385-4c5e-5735-b854-1a68b031613e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.5" :db/id #edb/ref 17592186242885} {:answer/id #uuid "fc8dd4bf-32b3-55ab-8c67-2219401fd8d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.15" :db/id #edb/ref 17592186243407}] :answer-field/correct {:answer/id #uuid "a54e62bf-fa8c-5810-a8eb-8f31624180ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.2" :db/id #edb/ref 17592186242635} :answer-field/id #uuid "5497cc27-067a-5c7c-b637-6c6d86e6b1e8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243606}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "10ef8c30-25b6-5a94-b4c4-25e4aa370204" :question/math-academy-id "q-109336" :question/problem "|  | $Y=2$ | $Y=4$ | $Y=6$ |\n| --- | --- | --- | --- |\n| $X=1$ | $0.1$ | $0.25$ | $0.25$ |\n| $X=2$ | $0.05$ | $0.15$ | $0.2$ |\n\nCompute $P(X=2\\,\\,\\text{and}\\,\\,Y\\le 4)$ given that the random variables $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above." :question/worked-solution "Using the values in the table, we have\n\n$$\n\\begin{aligned}P(X=2\\,\\,\\text{and}\\,\\,Y\\le 4) & =P((X,Y)\\in \\{(2,2),(2,4)\\}) \\\\  & =P((X,Y)=(2,2))+P((X,Y)=(2,4)) \\\\  & =f(2,2)+f(2,4) \\\\  & =0.05+0.15 \\\\  & =0.2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186522744 :knowledge-point/_questions [{:db/id #edb/ref 17592186162027 :knowledge-point/id #uuid "5d691e3a-f9c5-5c9d-863c-533abdebb948" :knowledge-point/title "Approximating a Probability Involving a Discrete Random Variable Over an Unbounded Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d40fb48-4dea-5d06-a910-9006779ab03a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P(Y\\ge -16)" :db/id #edb/ref 17592186522150} {:answer/id #uuid "3ed83c1f-5a9f-560a-a762-8184a97c9761" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P(Y\\ge -14.5)" :db/id #edb/ref 17592186522155} {:answer/id #uuid "7aec1610-f32b-556c-b482-f635fe19aa56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P(Y\\ge -15.5)" :db/id #edb/ref 17592186522259} {:answer/id #uuid "c3694caa-c68e-5886-8c0d-a19316f7a7de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P(Y\\ge -14)" :db/id #edb/ref 17592186522429} {:answer/id #uuid "c6552524-5207-54e7-8a47-0c0b03470697" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P(Y\\ge -15)" :db/id #edb/ref 17592186522433}] :answer-field/correct {:answer/id #uuid "3ed83c1f-5a9f-560a-a762-8184a97c9761" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P(Y\\ge -14.5)" :db/id #edb/ref 17592186522155} :answer-field/id #uuid "9929ea60-f2ba-517d-b3c7-b4dfdfd82083" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186522634}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7e38227f-eac1-53c7-9471-76f90491bdeb" :question/math-academy-id "q-132238" :question/problem "The discrete random variable $X\\in Z$ can be approximated by the continuous random variable $Y.$ By applying an appropriate continuity correction, $P(X>-15)$ can be approximated as" :question/worked-solution "To apply the appropriate continuity correction, we first rewrite the strict inequality as follows:\n\n$$\nP(X>-15)=P(X\\ge -14)\n$$\n\nThen, we extend the endpoint of the interval $X\\ge -14$ by $0.5:$\n\n$$\n\\begin{aligned}P(X\\ge -14) & ≈P(Y\\ge -14-0.5) \\\\  & =P(Y\\ge -14.5)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186378808 :knowledge-point/_questions [{:db/id #edb/ref 17592186124640 :knowledge-point/id #uuid "88f2bc84-03e8-5921-81e2-683a09195279" :knowledge-point/title "The Domain of a Function Containing Exponential, Logarithmic, and Trigonometric Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "efc28527-d0de-5b59-8702-a8737af4a6d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The domain is the entire $xy$-plane" :db/id #edb/ref 17592186378813} {:answer/id #uuid "13e63be7-9355-5eee-9e74-140ed6390af3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,-1\\le {x}^{2}+y\\le 1\\}" :db/id #edb/ref 17592186522061} {:answer/id #uuid "14f0584a-9240-56c8-aa2d-c06627e2221a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,0\\le {x}^{2}+y\\le \\pi \\}" :db/id #edb/ref 17592186522063} {:answer/id #uuid "3193a2f2-7514-5cab-9591-123a6a9c3f7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,-\\pi \\le {x}^{2}+y\\le \\pi \\}" :db/id #edb/ref 17592186522128} {:answer/id #uuid "8e00f2bc-edde-5501-b5c2-40b782c1b70d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,-\\frac{\\pi }{2}\\le {x}^{2}+y\\le \\frac{\\pi }{2}\\}" :db/id #edb/ref 17592186522307}] :answer-field/correct {:answer/id #uuid "13e63be7-9355-5eee-9e74-140ed6390af3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,-1\\le {x}^{2}+y\\le 1\\}" :db/id #edb/ref 17592186522061} :answer-field/id #uuid "95142d01-c18d-55cb-b4fa-42e081005dc2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378809}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "55a4348e-da3e-51ea-bc50-dd5e0f2b136a" :question/math-academy-id "q-158580" :question/problem "Find the domain of the function  $f(x,y)=\\operatorname{arcsin}⁡({x}^{2}+y).$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The argument of the arcsine has values between $-1$ and $1.$\n\nAs a result, the points in the domain must satisfy the following inequality:\n\n$$\n-1\\le {x}^{2}+y\\le 1\n$$\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,-1\\le {x}^{2}+y\\le 1\\}.\n$$"}] [{:db/id #edb/ref 17592186522709 :knowledge-point/_questions [{:db/id #edb/ref 17592186176062 :knowledge-point/id #uuid "2a2eb2ca-a19a-591e-810a-c028a17be252" :knowledge-point/title "Likelihood Functions for Binomial Random Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b3494d6-0de7-5038-b54c-792db85a0c85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "C\\,{\\theta }^{63}(1-\\theta )^{13}" :db/id #edb/ref 17592186522082} {:answer/id #uuid "47c9e21b-e0a4-58d7-b5f7-88d77b0829d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "C\\,{\\theta }^{50}(1-\\theta )^{50}" :db/id #edb/ref 17592186522172} {:answer/id #uuid "757bc2d3-ea55-5779-a853-74ca7cc5ecfd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "C\\,{\\theta }^{50}(1-\\theta )^{13}" :db/id #edb/ref 17592186522251} {:answer/id #uuid "d8a0f4bd-6540-5548-8698-5b59c0979895" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "C\\,{\\theta }^{13}(1-\\theta )^{63}" :db/id #edb/ref 17592186522468} {:answer/id #uuid "fa759598-3ac0-5792-98c5-3cd26ff647da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "C\\,{\\theta }^{13}(1-\\theta )^{50}" :db/id #edb/ref 17592186522551}] :answer-field/correct {:answer/id #uuid "fa759598-3ac0-5792-98c5-3cd26ff647da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "C\\,{\\theta }^{13}(1-\\theta )^{50}" :db/id #edb/ref 17592186522551} :answer-field/id #uuid "1d9998e2-ef7e-5722-9f5e-802dd357bfa9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186522565}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2ab1da93-7453-5e0d-90e1-e09775711415" :question/math-academy-id "q-159820" :question/problem "Suppose ${X}_{1},{X}_{2},…,{X}_{9}$ is an I.I.D random sample with ${X}_{i}∼B(7,\\theta )$ and unknown probability of success $\\theta .$ For a particular sample ${x}_{1},{x}_{2},…,{x}_{9},$ you're given that \n\n$$\n{\\sum }_{i=1}^{9}{x}_{i}=13.\n$$\n\nFind the likelihood function of the sample up to a constant $C.$\n\n*Hint: The probability mass function for a binomial random variable is given by*\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){\\theta }^{x}(1-\\theta )^{n-x},\\,x=0,1,2,…,n.\n$$" :question/worked-solution "Recall that if ${X}_{1},{X}_{2},…,{X}_{n}$ are independent and identically distributed discrete random variables with probability mass function $f(x;\\theta ),$ where $\\theta $ is an unknown parameter, then the likelihood function of a random sample ${x}_{1},{x}_{2},…,{x}_{n}$ is\n\n$$\nL(\\theta )=P({X}_{1}={x}_{1},{X}_{2}={x}_{2},…,{X}_{n}={x}_{n})={\\prod }_{i=1}^{n}f({x}_{i};\\,\\theta ).\n$$\n\nIn our case, we are given a sample of $n=9$ independent binomial random variables with unknown probability of success $\\theta $ and $N=7$ trials, for which the probability mass function is\n\n$$\n\\begin{aligned}f(x;\\theta )=(\\genfrac{}{}{0pt}{}{7}{x}){\\theta }^{x}(1-\\theta )^{7-x}, & \\,x=0,1,2,…,7.\\end{aligned}\n$$\n\nWe can calculate the likelihood function as follows:\n\n$$\n\\begin{aligned}L(\\theta ) & ={\\prod }_{i=1}^{n}f({x}_{i};\\theta ) \\\\  & ={\\prod }_{i=1}^{n}(\\genfrac{}{}{0pt}{}{7}{{x}_{i}}){\\theta }^{{x}_{i}}(1-\\theta )^{7-{x}_{i}} \\\\  & =((\\genfrac{}{}{0pt}{}{7}{{x}_{1}}){\\theta }^{{x}_{1}}(1-\\theta )^{7-{x}_{1}})\\cdot ((\\genfrac{}{}{0pt}{}{7}{{x}_{2}}){\\theta }^{{x}_{2}}(1-\\theta )^{7-{x}_{2}})⋯((\\genfrac{}{}{0pt}{}{7}{{x}_{n}}){\\theta }^{{x}_{n}}(1-\\theta )^{7-{x}_{n}}) \\\\  & =C\\,{\\theta }^{\\,\\sum {x}_{i}}(1-\\theta )^{\\,\\sum (7-{x}_{i})} \\\\  & =C\\,{\\theta }^{\\,\\sum {x}_{i}}(1-\\theta )^{\\,7n-\\sum {x}_{i}} \\\\  & =C\\,{\\theta }^{S}(1-\\theta )^{7n-S}\\end{aligned}\n$$\n\nwhere $C={\\prod }_{i=1}^{n}(\\genfrac{}{}{0pt}{}{7}{{x}_{i}})$ is a constant and $S={\\sum }_{i=1}^{n}{x}_{i}.$\n\nWe are told that $S={\\sum }_{i=1}^{n}{x}_{i}=13$ and $n=9.$ Therefore,\n\n$$\n\\begin{aligned}L(\\theta ) & =C\\,{\\theta }^{13}(1-\\theta )^{7(9)-13} \\\\  & =C\\,{\\theta }^{13}(1-\\theta )^{50}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186522706 :knowledge-point/_questions [{:db/id #edb/ref 17592186059688 :knowledge-point/id #uuid "0936217d-66d2-5360-b88b-a30683720415" :knowledge-point/title "Expressing Disjunctive Statements as Conditionals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c041953-eb86-5d4b-9d51-b723fdae2307" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you don't go to the movies, then you can watch a film at home." :db/id #edb/ref 17592186522042} {:answer/id #uuid "19a60f87-60ae-5b22-a9c7-4b5028011c8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you don't go to the movies, then you cannot watch a film at home." :db/id #edb/ref 17592186522077} {:answer/id #uuid "5be1fb9b-993a-5931-a734-0cfebdf60e5d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you go to the movies, then you cannot watch a film at home." :db/id #edb/ref 17592186522208} {:answer/id #uuid "6bc99ccb-8cfd-5769-b5b3-a63cda6beaba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Go to the movies, and you cannot watch a film at home." :db/id #edb/ref 17592186522236} {:answer/id #uuid "ab1b5de4-4369-5666-a699-73e8c327e027" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you go to the movies, then you can watch a film at home." :db/id #edb/ref 17592186522378}] :answer-field/correct {:answer/id #uuid "0c041953-eb86-5d4b-9d51-b723fdae2307" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you don't go to the movies, then you can watch a film at home." :db/id #edb/ref 17592186522042} :answer-field/id #uuid "dc293ee1-edd2-5c82-9086-24fd0f998be3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186522663}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "22695eb6-0581-5f84-9a76-e047ac8b10b4" :question/math-academy-id "q-182594" :question/problem "$\\,$ Either go to the movies, or you can watch a film at home.\n\nWhich conditional statement is logically equivalent to the disjunctive statement above?" :question/worked-solution "Let's denote by $A$ and $B$ the following statements:\n\n- $A:$ Go to the movies.\n\n- $B:$ You can watch a film at home.\n\nThen, our initial statement can be written as $A∨B,$ which is logically equivalent to \n\n$$\n¬A⇒B.\n$$\n\nThe negation of $A$ can be written as\n\n- $¬A:$ You don't go to the movies.\n\nTherefore, the given statement is logically equivalent to the following:\n\n$\\,$ If you don't go to the movies, then you can watch a film at home.\n\n**Note**: \n\nUsing the word \"Either\" helps clarify that the sentence structure presents two alternatives and is particularly useful when employing the disjunctive form $(¬P∨Q)$ in conversational or formal English. So, the phrase effectively conveys that one of the two stated conditions will hold true."}] [{:db/id #edb/ref 17592186321063 :knowledge-point/_questions [{:db/id #edb/ref 17592186119846 :knowledge-point/id #uuid "004c4177-ca0e-586c-962a-1220b4b64f47" :knowledge-point/title "Finding the Dimension of a Span Using Row Reduction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ab403f1-37e8-5537-b482-1b497f41b6de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186319614} {:answer/id #uuid "7defa742-522c-5545-9656-199144eab8fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186319768} {:answer/id #uuid "8ebdd4c7-2b1d-5b85-aec1-f2e0254b78bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186319818} {:answer/id #uuid "d4ae9ea2-f7af-5bb3-9254-c194f6f8817e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186320039} {:answer/id #uuid "eebdfceb-9ba4-5843-ba91-acb1afc553e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186320107}] :answer-field/correct {:answer/id #uuid "eebdfceb-9ba4-5843-ba91-acb1afc553e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186320107} :answer-field/id #uuid "bab218b2-bffd-5950-8dc4-5254fdc0b910" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186320547}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9e1095e2-b747-574e-a018-9f92abb5fb55" :question/math-academy-id "q-35299" :question/problem "Determine the dimension of\n$\\text{Span}{\\begin{bmatrix}2 \\\\ 0 \\\\ -1\\end{bmatrix},\\begin{bmatrix}-3 \\\\ 5 \\\\ 3\\end{bmatrix},\\begin{bmatrix}-1 \\\\ 5 \\\\ -2\\end{bmatrix}}.$" :question/worked-solution "We start by creating a matrix whose columns are made up of our vectors, and then we reduce the matrix to row echelon form:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}2 & -3 & -1 \\\\ 0 & 5 & 5 \\\\ -1 & 3 & -2\\end{bmatrix} & {R}_{3} & :={R}_{3}+\\frac{1}{2}{R}_{1} \\\\  & ∼\\begin{bmatrix}2 & -3 & -1 \\\\ 0 & 5 & 5 \\\\ 0 & \\frac{3}{2} & -\\frac{5}{2}\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-\\frac{3}{10}){R}_{2} \\\\  & ∼\\begin{bmatrix}2 & -3 & -1 \\\\ 0 & 5 & 5 \\\\ 0 & 0 & -4\\end{bmatrix}\\end{aligned}\n$$\n\nThe pivot columns correspond to basis vectors, while the non-pivot columns correspond to linearly dependent vectors that can be removed. Here, the reduced matrix has $3$ pivot columns (or alternatively, it has exactly $3$ non-zero rows). \n\nTherefore, the dimension of the span is $3.$"}] [{:db/id #edb/ref 17592186134280 :knowledge-point/_questions [{:db/id #edb/ref 17592186133782 :knowledge-point/id #uuid "26f8f84c-bb94-5f3c-a78e-343f9c0c1b1a" :knowledge-point/title "Extending a Set to Form an Orthogonal Basis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6180973b-2ca2-50de-9a9e-68ad998f74d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186324784} {:answer/id #uuid "cabb893b-4474-531c-9b52-e7bfa197b717" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186325728} {:answer/id #uuid "cd9d258f-269f-5822-ae1d-93b483d1fe47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186325757} {:answer/id #uuid "eca5b0f1-ed13-5a6c-9570-cfbdc1e122b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186326054} {:answer/id #uuid "ecba0e97-34e3-516d-bbc5-8223fa2b6610" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{7}" :db/id #edb/ref 17592186326056}] :answer-field/correct {:answer/id #uuid "eca5b0f1-ed13-5a6c-9570-cfbdc1e122b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186326054} :answer-field/id #uuid "bfce3a6b-16cb-5cbf-9f62-1141d301a3f3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326564}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "455820f5-9352-535f-a3b2-e3fbc55031b5" :question/math-academy-id "q-40297" :question/problem "Consider the orthogonal set $U$ below. By adding a new vector $x=[{x}_{1},\\,{x}_{2},\\,{x}_{3}]^{T},$ extend the set so that it forms an orthogonal basis of ${R}^{3}.$ What is the value of $\\frac{{x}_{1}}{{x}_{2}}?$\n\n$$\nU={\\begin{bmatrix}1 \\\\ 2 \\\\ 1\\end{bmatrix},\\begin{bmatrix}0 \\\\ -3 \\\\ 6\\end{bmatrix}}\n$$" :question/worked-solution "Let's denote the vectors of $U$ as ${u}_{1},\\,{u}_{2}.$ To extend the given set to an orthogonal basis of ${R}^{3}$, we need to find a third vector $x=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}$ such that\n\n$$\n{\\begin{aligned}{u}_{1}\\cdot x=0 \\\\ {u}_{2}\\cdot x=0\\end{aligned}\\,⟹\\,{\\begin{aligned}{x}_{1}+2{x}_{2}+{x}_{3}=0 \\\\ -3{x}_{2}+6{x}_{3}=0.\\end{aligned}\n$$\n\nNow, we consider the augmented matrix $M$ of the system above, which is already in row echelon form:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 2 & 1 & 0 \\\\ 0 & -3 & 6 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nIn the reduced matrix above, there are two pivot columns ($1$st and $2$nd). Thus, ${x}_{3}$ is a free variable. From the second equation, we get ${x}_{2}=2{x}_{3}.$ Substituting this into the first equation, we obtain\n\n$$\n\\begin{aligned}{x}_{1}+2(2{x}_{3})+{x}_{3}=0\\,⟹\\,{x}_{1}=-5{x}_{3}.\\end{aligned}\n$$\n\nSo, the general solution is\n\n$$\n\\begin{bmatrix}-5{x}_{3} \\\\ 2{x}_{3} \\\\ {x}_{3}\\end{bmatrix},\\,{x}_{3}\\in R.\n$$\n\nSetting ${x}_{3}=1,$ we obtain the vector \n\n$$\nx=\\begin{bmatrix}-5 \\\\ 2 \\\\ 1\\end{bmatrix}.\n$$\n\nTherefore, an orthogonal basis of ${R}^{3}$ is\n\n$$\n{\\begin{bmatrix}1 \\\\ 2 \\\\ 1\\end{bmatrix},\\begin{bmatrix}0 \\\\ -3 \\\\ 6\\end{bmatrix},\\begin{bmatrix}-5 \\\\ 2 \\\\ 1\\end{bmatrix}}.\n$$\n\nFinally, $\\frac{{x}_{1}}{{x}_{2}}=\\frac{-5}{2}=-\\frac{5}{2}.$"}] [{:db/id #edb/ref 17592186522724 :knowledge-point/_questions [{:db/id #edb/ref 17592186166838 :knowledge-point/id #uuid "e0e2ce6a-ee66-50a0-88b4-47dc0189ff51" :knowledge-point/title "Modeling a Situation in Context With the Discrete Uniform Distribution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "137d4e44-9828-5ee0-89ba-c9b7c0edfcda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186522058} {:answer/id #uuid "1ae489c7-a3c1-592f-874f-9ab522ff716b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186522080} {:answer/id #uuid "64c12a31-677b-51ab-9671-a72788d101d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186522227} {:answer/id #uuid "db12f085-011d-52fa-9f1f-43b64008b1a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186522474} {:answer/id #uuid "e1fffc80-b079-59ff-bdcc-87333dd7015a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{18}" :db/id #edb/ref 17592186522500}] :answer-field/correct {:answer/id #uuid "137d4e44-9828-5ee0-89ba-c9b7c0edfcda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186522058} :answer-field/id #uuid "8ebfc676-fdb1-53ab-b889-b6b98a229798" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186522631}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4b4a8271-3af9-5314-8310-6943f2c7643d" :question/math-academy-id "q-97679" :question/problem "In winter, the maximum daily temperature of a certain mountain location (rounded to the nearest degree) varies between $-{15}^{∘}C$ and ${2}^{∘}C,$ inclusive. Assuming that for a given winter day, each maximum temperature value between $-{15}^{∘}C$ and ${2}^{∘}C$ has an equal probability of occurring, what is the probability that the maximum daily temperature will reach at least ${0}^{∘}C$ on a randomly selected day?" :question/worked-solution "Let $X$ represent the maximum daily temperature (rounded to the nearest degree Celsius). From the problem statement, we know that $X∼U\\{-15,-14,…,2\\},$ and we wish to compute $P(X\\ge 0).$\n\nIn general, if $X$ follows a discrete uniform distribution over a set $S,$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{|S|}, & x\\in S \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, we have $X∼U\\{-15,-14,…,2\\},$ and the set $S=\\{-15,-14,…,2\\}$ has $|S|=2-(-15)+1=18$ items. So, we have\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{18}, & x=-15,-14,…,2 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nIn $S,$ the items that satisfy $X\\ge 0$ are $0,1,2.$ There are $3$ of these elements. Therefore,\n\n$$\nP(X\\ge 0)=3\\cdot \\frac{1}{18}=\\frac{1}{6}.\n$$"}]}
