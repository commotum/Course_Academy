#{[{:db/id #edb/ref 17592186436629 :knowledge-point/_questions [{:db/id #edb/ref 17592186059690 :knowledge-point/id #uuid "eec6cf11-74cc-5b3a-b2fe-bd4285fe4a88" :knowledge-point/title "Rewriting Conditional Statement Using the Associative, Commutative, and Absorption Laws"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6fc52a1a-3940-5732-a868-a532984c3e32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P∧¬Q" :db/id #edb/ref 17592186436623} {:answer/id #uuid "8bd4cd09-8cbb-5ab2-9eee-c2ef187bad59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Q∨P" :db/id #edb/ref 17592186436624} {:answer/id #uuid "9bcc4291-0a68-5242-920b-da5bf575f0b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Q∨¬P" :db/id #edb/ref 17592186436625} {:answer/id #uuid "baf71b07-e263-5232-88b3-0e6cfa44ae4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P∨¬Q" :db/id #edb/ref 17592186436626} {:answer/id #uuid "ec239135-a191-53fd-ab45-832fc11ac4d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬P∧¬Q" :db/id #edb/ref 17592186436627}] :answer-field/correct {:answer/id #uuid "6fc52a1a-3940-5732-a868-a532984c3e32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P∧¬Q" :db/id #edb/ref 17592186436623} :answer-field/id #uuid "0b770ae3-a6bf-565c-b1f8-035f0cda7d32" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186436628}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a1135e70-c8a0-50ee-ba8b-a60797a22c04" :question/math-academy-id "q-1477" :question/problem "Simplify the statement $¬(P⇒Q).$" :question/worked-solution "First, note that\n\n$$\n¬(P⇒Q)≡¬(¬P∨Q).\n$$\n\nWe can distribute the negation over the disjunction using De Morgan's law:\n\n$$\n¬(¬P∨Q)≡¬(¬P)∧¬Q.\n$$\n\nFinally, canceling out double negations, we reach\n\n$$\n¬(¬P)∧¬Q≡P∧¬Q.\n$$\n\nSo the given statement is equivalent to $P∧¬Q.$"}] [{:db/id #edb/ref 17592186389677 :knowledge-point/_questions [{:db/id #edb/ref 17592186059689 :knowledge-point/id #uuid "0d56b033-a2c8-57c7-adde-e574d726ec78" :knowledge-point/title "Rewriting Symbolic Conditional Statements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "de943075-23ed-550c-9348-3beb6a4a1c62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬X∧Y" :db/id #edb/ref 17592186389679} {:answer/id #uuid "8b02c54e-2d06-5289-a555-a7919b41a546" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬X∨Y" :db/id #edb/ref 17592186389680} {:answer/id #uuid "b98c7d3c-5c1d-57c7-bf18-b70064ffde0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "X∨¬Y" :db/id #edb/ref 17592186389681} {:answer/id #uuid "5c092ed6-6792-5c60-919a-67c8b2cefe42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "X∧¬Y" :db/id #edb/ref 17592186389682} {:answer/id #uuid "3560a2b5-61fc-59ef-b588-2de0e12fe534" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬X∧¬Y" :db/id #edb/ref 17592186389683}] :answer-field/correct {:answer/id #uuid "8b02c54e-2d06-5289-a555-a7919b41a546" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬X∨Y" :db/id #edb/ref 17592186389680} :answer-field/id #uuid "566667e2-62c5-546d-bc15-bcb677d80fec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389678}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6ab5fd68-e114-5907-8def-2141c3cce14d" :question/math-academy-id "q-171257" :question/problem "$X⇒Y\\,≡$" :question/worked-solution "The conditional statement $P⇒Q$ is logically equivalent to the disjunction $¬P∨Q:$\n\nSo, in this case, we have the following equivalence:\n\n$$\nX⇒Y\\,≡\\,¬X∨Y\n$$"}] [{:db/id #edb/ref 17592186379167 :knowledge-point/_questions [{:db/id #edb/ref 17592186059689 :knowledge-point/id #uuid "0d56b033-a2c8-57c7-adde-e574d726ec78" :knowledge-point/title "Rewriting Symbolic Conditional Statements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ed0ada9a-ae18-56dc-945c-e726b9629412" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R∧¬S" :db/id #edb/ref 17592186379169} {:answer/id #uuid "cad24836-75dd-516c-a038-882a63b33d22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R∨S" :db/id #edb/ref 17592186379170} {:answer/id #uuid "4f308980-10ba-5049-a065-4747bca1db7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬R∧S" :db/id #edb/ref 17592186379171} {:answer/id #uuid "6b5eca90-785e-51eb-908c-bca925c96fa1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R∧S" :db/id #edb/ref 17592186379172} {:answer/id #uuid "0171c62e-9fde-5f60-8d20-351bf3c0fc89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬R∨¬S" :db/id #edb/ref 17592186379173}] :answer-field/correct {:answer/id #uuid "6b5eca90-785e-51eb-908c-bca925c96fa1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R∧S" :db/id #edb/ref 17592186379172} :answer-field/id #uuid "ac9cb155-d3eb-5181-abad-27d716b8bac4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186379168}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fbe33c35-e591-5f89-871d-e169a25c3483" :question/math-academy-id "q-182498" :question/problem "Simplify the statement $¬(R⇒¬S).$" :question/worked-solution "The conditional statement $P⇒Q$ is logically equivalent to the disjunction $¬P∨Q:$\n\nSo, in this case, we have the following equivalence:\n\n$$\n¬(R⇒¬S)≡¬(¬R∨¬S)\n$$\n\nDistributing the negation over the disjunction using De Morgan's law, we have\n\n$$\n¬(¬R∨¬S)≡¬(¬R)∧¬(¬S).\n$$\n\nCanceling out double negation, we reach\n\n$$\nR∧S.\n$$\n\nSo the given statement is equivalent to $R∧S.$"}] [{:db/id #edb/ref 17592186060149 :knowledge-point/_questions [{:db/id #edb/ref 17592186059688 :knowledge-point/id #uuid "0936217d-66d2-5360-b88b-a30683720415" :knowledge-point/title "Expressing Disjunctive Statements as Conditionals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ba978700-923a-5354-858c-a21e380e4180" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you don’t pay the bill, then your power won't be shut off." :db/id #edb/ref 17592186057278} {:answer/id #uuid "e4a78960-7dba-518a-b058-7c5f72b56d21" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you don’t pay the bill, then your power will be shut off." :db/id #edb/ref 17592186057279} {:answer/id #uuid "1ee08dff-f4b5-5a3f-a9c2-d1fdd107e7ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you pay the bill, then your power won't be shut off." :db/id #edb/ref 17592186057280} {:answer/id #uuid "4b852cf1-37a3-5032-9617-33b57eb2c017" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you pay the bill, then your power will be shut off." :db/id #edb/ref 17592186057281} {:answer/id #uuid "541fca0b-9881-50b2-8e11-90eb3ddc0a6c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Pay the bill, and your power won't be shut off." :db/id #edb/ref 17592186057282}] :answer-field/correct {:answer/id #uuid "e4a78960-7dba-518a-b058-7c5f72b56d21" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you don’t pay the bill, then your power will be shut off." :db/id #edb/ref 17592186057279} :answer-field/id #uuid "0c7a8262-d702-5814-a615-315b3eeb2cc2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186057277}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "443b6ab8-c574-5d6b-85ea-335ba45a30ef" :question/math-academy-id "q-182591" :question/problem "$\\,$ Pay the bill, or your power will be shut off.\n\nWhich conditional statement is logically equivalent to the disjunctive statement above?" :question/worked-solution "Let's denote by $A$ and $B$ the following statements:\n\n- $A:$ Pay the bill.\n\n- $B:$ Your power will be shut off.\n\nThen, our initial statement can be written as $A∨B,$ which is logically equivalent to \n\n$$\n¬A⇒B.\n$$\n\nThe negation of $A$ can be written as\n\n- $¬A:$ You don't pay the bill.\n\nTherefore, the given statement is logically equivalent to the following:\n\n$\\,$ If you don't pay the bill, then your power will be shut off."}] [{:db/id #edb/ref 17592186401736 :knowledge-point/_questions [{:db/id #edb/ref 17592186059688 :knowledge-point/id #uuid "0936217d-66d2-5360-b88b-a30683720415" :knowledge-point/title "Expressing Disjunctive Statements as Conditionals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "048fd58d-6161-542c-aca0-9aa3830ec64a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Wear a jacket, and you won't get cold." :db/id #edb/ref 17592186401738} {:answer/id #uuid "2c28a06a-e16c-5c23-a019-7042d53b30bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you wear a jacket, then you will get cold." :db/id #edb/ref 17592186401739} {:answer/id #uuid "1568255d-6e74-51c6-b213-0baccfa15504" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you don’t wear a jacket, then you won't get cold." :db/id #edb/ref 17592186401740} {:answer/id #uuid "4f1a52bd-b4c3-59f6-aa7e-00e77fc5e146" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you don’t wear a jacket, then you will get cold." :db/id #edb/ref 17592186401741} {:answer/id #uuid "7703df10-5599-5c0e-b2b9-a7aaaab873cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you wear a jacket, then you won't get cold." :db/id #edb/ref 17592186401742}] :answer-field/correct {:answer/id #uuid "4f1a52bd-b4c3-59f6-aa7e-00e77fc5e146" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you don’t wear a jacket, then you will get cold." :db/id #edb/ref 17592186401741} :answer-field/id #uuid "970b9ff4-c62f-56de-9540-47a07451659c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401737}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "98ecba05-28ef-5ea8-9d45-86a0357f6077" :question/math-academy-id "q-182592" :question/problem "$\\,$ Wear a jacket, or you will get cold.\n\nWhich conditional statement is logically equivalent to the disjunctive statement above?" :question/worked-solution "Let's denote by $A$ and $B$ the following statements:\n\n- $A:$ Wear a jacket.\n\n- $B:$ You will get cold.\n\nThen, our initial statement can be written as $A∨B,$ which is logically equivalent to \n\n$$\n¬A⇒B.\n$$\n\nThe negation of $A$ can be written as\n\n- $¬A:$ You don't wear a jacket.\n\nTherefore, the given statement is logically equivalent to the following:\n\n$\\,$ If you don't wear a jacket, then you will get cold."}]}
