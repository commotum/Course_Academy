/id #edb/ref 17592186045498} :answer/value "A∨¬B" :db/id #edb/ref 17592186378718}] :answer-field/correct {:db/id #edb/ref 17592186378714} :answer-field/id #uuid "bef1e854-dcf0-5bf2-bce1-3c3b1e51137e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186378713}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fe611b4a-33af-5b80-a6da-077998756db6" :question/math-academy-id "q-1469" :question/problem "Simplify the statement $¬A⇒B.$" :question/worked-solution "The conditional statement $P⇒Q$ is logically equivalent to the disjunction $¬P∨Q:$\n\nSo, in this case, we have the following equivalence:\n\n$$\n¬A⇒B≡¬(¬A)∨B\n$$\n\nCanceling out double negations, we reach\n\n$$\n¬(¬A)∨B≡A∨B.\n$$\n\nSo the given statement is equivalent to $A∨B.$"} :step/id #uuid "12d4c7cd-cbe3-5cf6-98ac-5ef2b58306b0" :step/next {:db/id #edb/ref 17592186422174}} {:db/id #edb/ref 17592186422173 :step/content {:db/id #edb/ref 17592186409585 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b57f374-7974-5938-b11d-cfd731887fe8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬X∨¬Y" :db/id #edb/ref 17592186409567} {:answer/id #uuid "33e6f69b-ceb9-546e-bc81-3a178a362d67" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬Y∨X" :db/id #edb/ref 17592186409568} {:answer/id #uuid "42a65b2d-e5f8-5a76-b55d-46a8613eea7f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬Y∧X" :db/id #edb/ref 17592186409571} {:answer/id #uuid "a433720c-898a-5e82-b529-c83bbf9df930" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬X∧Y" :db/id #edb/ref 17592186409577} {:answer/id #uuid "d0b85a9a-afc4-5057-b50b-a3fabfd591bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬X∨Y" :db/id #edb/ref 17592186409579}] :answer-field/correct {:db/id #edb/ref 17592186409568} :answer-field/id #uuid "bc790e07-5a28-514e-aa55-ed9af585fbba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186409582}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6b7c7494-65e2-5888-808a-8604d9b7cfa1" :question/math-academy-id "q-182492" :question/problem "$Y⇒X\\,≡$" :question/worked-solution "The conditional statement $P⇒Q$ is logically equivalent to the disjunction $¬P∨Q:$\n\nSo, in this case, we have the following equivalence:\n\n$$\nY⇒X\\,≡\\,¬Y∨X\n$$"} :step/id #uuid "992a12e5-4030-5d06-bfe4-99bff662d13d" :step/next {:db/id #edb/ref 17592186422176}} {:db/id #edb/ref 17592186422174 :step/content {:db/id #edb/ref 17592186060412 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "911a45b8-ba13-5065-bb06-c450effaabf2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "X∨Y" :db/id #edb/ref 17592186394326} {:answer/id #uuid "95480722-7569-5083-8b58-56b83301d195" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "X∧Y" :db/id #edb/ref 17592186394327} {:answer/id #uuid "8476685e-e104-531e-86f2-c09e6663f600" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬X∨Y" :db/id #edb/ref 17592186394328} {:answer/id #uuid "eee8dbbe-fc4d-5c20-9c21-6ae1d839c1fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "Y" :db/id #edb/ref 17592186394329} {:answer/id #uuid "77a3543d-dc9d-5f25-b6e9-2b5f550e3919" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "X∧¬Y" :db/id #edb/ref 17592186394330}] :answer-field/correct {:db/id #edb/ref 17592186394329} :answer-field/id #uuid "b6f0c2ff-63c9-5651-8370-33bd7ba743eb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186394325}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0467eb40-db5b-5041-af5a-7039ef1e5d68" :question/math-academy-id "q-81891" :question/problem "Simplify the statement $¬(X∧Y)⇒Y.$" :question/worked-solution "First, note that\n\n$$\n¬(X∧Y)⇒Y≡¬(¬(X∧Y))∨Y.\n$$\n\nCanceling out double negations, we reach\n\n$$\n¬(¬(X∧Y))∨Y≡(X∧Y)∨Y.\n$$\n\nFinally, by the absorption law, we have\n\n$$\n(X∧Y)∨Y≡Y.\n$$\n\nSo the given statement is equivalent to $Y.$"} :step/id #uuid "a4bf2a7e-915f-5aaa-9350-9113ac1d5a6e" :step/next {:db/id #edb/ref 17592186422175}} {:db/id #edb/ref 17592186422175 :step/content {:db/id #edb/ref 17592186422170 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "173a22f9-03eb-5f52-84a2-64add79bb270" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "P∧(Q∧R)" :db/id #edb/ref 17592186422158} {:answer/id #uuid "2655898f-0ab3-55b9-b970-24883e6a1310" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "P∨(Q∨R)" :db/id #edb/ref 17592186422159} {:answer/id #uuid "666720f8-ee5e-5a0c-9eff-9b28566b29c6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "P∧(Q∨¬R)" :db/id #edb/ref 17592186422161} {:answer/id #uuid "be278a98-7931-527b-9249-5fe023ad7c54" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "P∧(Q∨R)" :db/id #edb/ref 17592186422166} {:answer/id #uuid "d2702799-977f-5026-b7cd-3d37fe168a4b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬P∧(Q∨R)" :db/id #edb/ref 17592186422167}] :answer-field/correct {:db/id #edb/ref 17592186422166} :answer-field/id #uuid "f19fca36-2b89-53ba-85fc-7765f2211e66" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186422169}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2bdcd5e4-a0e7-512a-97bb-f847c06388f4" :question/math-academy-id "q-82451" :question/problem "Simplify the statement $¬(P∧Q)⇒(P∧R).$" :question/worked-solution "First, note that\n\n$$\n¬(P∧Q)⇒(P∧R)≡¬(¬(P∧Q))∨(P∧R).\n$$\n\nCanceling out double negations, we reach\n\n$$\n¬(¬(P∧Q))∨(P∧R)≡(P∧Q)∨(P∧R).\n$$\n\nFinally, by the distributive laws, we have\n\n$$\n(P∧Q)∨(P∧R)≡P∧(Q∨R).\n$$\n\nSo the given statement is equivalent to $P∧(Q∨R).$"} :step/id #uuid "b4e7f46a-d2bb-5a13-8fe3-d393ec767bb7" :step/next {:db/id #edb/ref 17592186422173}} {:db/id #edb/ref 17592186422176 :step/content {:db/id #edb/ref 17592186422171 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38c9c24e-3b55-56ca-86a7-b2ce01e8f281" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "If you don't apologize, then she won't forgive you." :db/id #edb/ref 17592186422160} {:answer/id #uuid "719cf9b3-0ac6-54a8-b955-880ab8843c40" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "If you apologize, then she will forgive you." :db/id #edb/ref 17592186422162} {:answer/id #uuid "8213100f-0dc7-5d4d-b8fd-6e029e273dc5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "If you apologize, then she won't forgive you." :db/id #edb/ref 17592186422163} {:answer/id #uuid "a2794c58-1f77-5658-9986-016411aec9fd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "If you don't apologize, then she will forgive you." :db/id #edb/ref 17592186422164} {:answer/id #uuid "a2993367-1981-5e54-b3ef-99b9be03f44e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Apologize, and she will forgive you." :db/id #edb/ref 17592186422165}] :answer-field/correct {:db/id #edb/ref 17592186422160} :answer-field/id #uuid "e83d217a-41be-555a-a16a-343371ec8880" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186422168}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c4482556-1279-5932-bd2e-cbe957830200" :question/math-academy-id "q-182574" :question/problem "$\\,$ Either apologize, or she won't forgive you.\n\nWhich conditional statement is logically equivalent to the disjunctive statement above?" :question/worked-solution "Let's denote by $A$ and $B$ the following statements:\n\n- $A:$ Apologize.\n\n- $B:$ She won't forgive you.\n\nThen, our initial statement can be written as $A∨B,$ which is logically equivalent to \n\n$$\n¬A⇒B.\n$$\n\nThe negation of $A$ can be written as\n\n- $¬A:$ You don't apologize.\n\nTherefore, the given statement is logically equivalent to the following:\n\n$\\,$ If you don't apologize, then she won't forgive you.\n\n**Note**: \n\nUsing the word \"Either\" helps clarify that the sentence structure presents two alternatives and is particularly useful when employing the disjunctive form $(¬P∨Q)$ in conversational or formal English. So, the phrase effectively conveys that one of the two stated conditions will hold true."} :step/id #uuid "ec1c4e29-ed0c-5082-8077-e13084a4137b"}] :activity/title "Logical Equivalence with Conditional Statements" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186422157}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186436634} :activity/id #uuid "fdb480fb-7595-51de-b205-79626369178f" :activity/scope {:db/id #edb/ref 17592186049805 :topic/id #uuid "155403ed-fbfa-59a9-b928-e762a73145ef" :topic/math-academy-id 247} :activity/steps [{:db/id #edb/ref 17592186436630 :step/content {:db/id #edb/ref 17592186379167 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ed0ada9a-ae18-56dc-945c-e726b9629412" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "R∧¬S" :db/id #edb/ref 17592186379169} {:answer/id #uuid "cad24836-75dd-516c-a038-882a63b33d22" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "R∨S" :db/id #edb/ref 17592186379170} {:answer/id #uuid "4f308980-10ba-5049-a065-4747bca1db7c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬R∧S" :db/id #edb/ref 17592186379171} {:answer/id #uuid "6b5eca90-785e-51eb-908c-bca925c96fa1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "R∧S" :db/id #edb/ref 17592186379172} {:answer/id #uuid "0171c62e-9fde-5f60-8d20-351bf3c0fc89" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬R∨¬S" :db/id #edb/ref 17592186379173}] :answer-field/correct {:db/id #edb/ref 17592186379172} :answer-field/id #uuid "ac9cb155-d3eb-5181-abad-27d716b8bac4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186379168}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "fbe33c35-e591-5f89-871d-e169a25c3483" :question/math-academy-id "q-182498" :question/problem "Simplify the statement $¬(R⇒¬S).$" :question/worked-solution "The conditional statement $P⇒Q$ is logically equivalent to the disjunction $¬P∨Q:$\n\nSo, in this case, we have the following equivalence:\n\n$$\n¬(R⇒¬S)≡¬(¬R∨¬S)\n$$\n\nDistributing the negation over the disjunction using De Morgan's law, we have\n\n$$\n¬(¬R∨¬S)≡¬(¬R)∧¬(¬S).\n$$\n\nCanceling out double negation, we reach\n\n$$\nR∧S.\n$$\n\nSo the given statement is equivalent to $R∧S.$"} :step/id #uuid "8b066a8e-899d-55a1-8411-df8d5e53b232" :step/next {:db/id #edb/ref 17592186436632}} {:db/id #edb/ref 17592186436631 :step/content {:db/id #edb/ref 17592186401736 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "048fd58d-6161-542c-aca0-9aa3830ec64a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Wear a jacket, and you won't get cold." :db/id #edb/ref 17592186401738} {:answer/id #uuid "2c28a06a-e16c-5c23-a019-7042d53b30bf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "If you wear a jacket, then you will get cold." :db/id #edb/ref 17592186401739} {:answer/id #uuid "1568255d-6e74-51c6-b213-0baccfa15504" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "If you don’t wear a jacket, then you won't get cold." :db/id #edb/ref 17592186401740} {:answer/id #uuid "4f1a52bd-b4c3-59f6-aa7e-00e77fc5e146" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "If you don’t wear a jacket, then you will get cold." :db/id #edb/ref 17592186401741} {:answer/id #uuid "7703df10-5599-5c0e-b2b9-a7aaaab873cf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "If you wear a jacket, then you won't get cold." :db/id #edb/ref 17592186401742}] :answer-field/correct {:db/id #edb/ref 17592186401741} :answer-field/id #uuid "970b9ff4-c62f-56de-9540-47a07451659c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186401737}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "98ecba05-28ef-5ea8-9d45-86a0357f6077" :question/math-academy-id "q-182592" :question/problem "$\\,$ Wear a jacket, or you will get cold.\n\nWhich conditional statement is logically equivalent to the disjunctive statement above?" :question/worked-solution "Let's denote by $A$ and $B$ the following statements:\n\n- $A:$ Wear a jacket.\n\n- $B:$ You will get cold.\n\nThen, our initial statement can be written as $A∨B,$ which is logically equivalent to \n\n$$\n¬A⇒B.\n$$\n\nThe negation of $A$ can be written as\n\n- $¬A:$ You don't wear a jacket.\n\nTherefore, the given statement is logically equivalent to the following:\n\n$\\,$ If you don't wear a jacket, then you will get cold."} :step/id #uuid "b746c91b-d837-5aea-9df8-0783cb162ef2"} {:db/id #edb/ref 17592186436632 :step/content {:db/id #edb/ref 17592186060149 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ba978700-923a-5354-858c-a21e380e4180" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "If you don’t pay the bill, then your power won't be shut off." :db/id #edb/ref 17592186057278} {:answer/id #uuid "e4a78960-7dba-518a-b058-7c5f72b56d21" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "If you don’t pay the bill, then your power will be shut off." :db/id #edb/ref 17592186057279} {:answer/id #uuid "1ee08dff-f4b5-5a3f-a9c2-d1fdd107e7ba" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "If you pay the bill, then your power won't be shut off." :db/id #edb/ref 17592186057280} {:answer/id #uuid "4b852cf1-37a3-5032-9617-33b57eb2c017" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "If you pay the bill, then your power will be shut off." :db/id #edb/ref 17592186057281} {:answer/id #uuid "541fca0b-9881-50b2-8e11-90eb3ddc0a6c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Pay the bill, and your power won't be shut off." :db/id #edb/ref 17592186057282}] :answer-field/correct {:db/id #edb/ref 17592186057279} :answer-field/id #uuid "0c7a8262-d702-5814-a615-315b3eeb2cc2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186057277}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "443b6ab8-c574-5d6b-85ea-335ba45a30ef" :question/math-academy-id "q-182591" :question/problem "$\\,$ Pay the bill, or your power will be shut off.\n\nWhich conditional statement is logically equivalent to the disjunctive statement above?" :question/worked-solution "Let's denote by $A$ and $B$ the following statements:\n\n- $A:$ Pay the bill.\n\n- $B:$ Your power will be shut off.\n\nThen, our initial statement can be written as $A∨B,$ which is logically equivalent to \n\n$$\n¬A⇒B.\n$$\n\nThe negation of $A$ can be written as\n\n- $¬A:$ You don't pay the bill.\n\nTherefore, the given statement is logically equivalent to the following:\n\n$\\,$ If you don't pay the bill, then your power will be shut off."} :step/id #uuid "c7860837-e731-5c21-a8c2-238981203349" :step/next {:db/id #edb/ref 17592186436631}} {:db/id #edb/ref 17592186436633 :step/content {:db/id #edb/ref 17592186389677 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "de943075-23ed-550c-9348-3beb6a4a1c62" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬X∧Y" :db/id #edb/ref 17592186389679} {:answer/id #uuid "8b02c54e-2d06-5289-a555-a7919b41a546" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬X∨Y" :db/id #edb/ref 17592186389680} {:answer/id #uuid "b98c7d3c-5c1d-57c7-bf18-b70064ffde0a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "X∨¬Y" :db/id #edb/ref 17592186389681} {:answer/id #uuid "5c092ed6-6792-5c60-919a-67c8b2cefe42" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "X∧¬Y" :db/id #edb/ref 17592186389682} {:answer/id #uuid "3560a2b5-61fc-59ef-b588-2de0e12fe534" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬X∧¬Y" :db/id #edb/ref 17592186389683}] :answer-field/correct {:db/id #edb/ref 17592186389680} :answer-field/id #uuid "566667e2-62c5-546d-bc15-bcb677d80fec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186389678}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6ab5fd68-e114-5907-8def-2141c3cce14d" :question/math-academy-id "q-171257" :question/problem "$X⇒Y\\,≡$" :question/worked-solution "The conditional statement $P⇒Q$ is logically equivalent to the disjunction $¬P∨Q:$\n\nSo, in this case, we have the following equivalence:\n\n$$\nX⇒Y\\,≡\\,¬X∨Y\n$$"} :step/id #uuid "d47622de-c52c-55f3-b089-ee15881a00d2" :step/next {:db/id #edb/ref 17592186436630}} {:db/id #edb/ref 17592186436634 :step/content {:db/id #edb/ref 17592186436629 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6fc52a1a-3940-5732-a868-a532984c3e32" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "P∧¬Q" :db/id #edb/ref 17592186436623} {:answer/id #uuid "8bd4cd09-8cbb-5ab2-9eee-c2ef187bad59" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "Q∨P" :db/id #edb/ref 17592186436624} {:answer/id #uuid "9bcc4291-0a68-5242-920b-da5bf575f0b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "Q∨¬P" :db/id #edb/ref 17592186436625} {:answer/id #uuid "baf71b07-e263-5232-88b3-0e6cfa44ae4e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "P∨¬Q" :db/id #edb/ref 17592186436626} {:answer/id #uuid "ec239135-a191-53fd-ab45-832fc11ac4d9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬P∧¬Q" :db/id #edb/ref 17592186436627}] :answer-field/correct {:db/id #edb/ref 17592186436623} :answer-field/id #uuid "0b770ae3-a6bf-565c-b1f8-035f0cda7d32" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186436628}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a1135e70-c8a0-50ee-ba8b-a60797a22c04" :question/math-academy-id "q-1477" :question/problem "Simplify the statement $¬(P⇒Q).$" :question/worked-solution "First, note that\n\n$$\n¬(P⇒Q)≡¬(¬P∨Q).\n$$\n\nWe can distribute the negation over the disjunction using De Morgan's law:\n\n$$\n¬(¬P∨Q)≡¬(¬P)∧¬Q.\n$$\n\nFinally, canceling out double negations, we reach\n\n$$\n¬(¬P)∧¬Q≡P∧¬Q.\n$$\n\nSo the given statement is equivalent to $P∧¬Q.$"} :step/id #uuid "fa95311a-452f-53c8-b4cc-be5bc9963eec" :step/next {:db/id #edb/ref 17592186436633}}] :activity/title "Logical Equivalence with Conditional Statements" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186436622}]}
