#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186573333} :activity/id #uuid "6a7e87a4-1f44-5991-b6ac-4821416eb17f" :activity/scope {:db/id #edb/ref 17592186049723 :topic/id #uuid "0e15397e-6c32-508c-b6ea-90f1a9e5a237" :topic/math-academy-id 1904} :activity/steps [{:db/id #edb/ref 17592186573333 :step/content {:db/id #edb/ref 17592186124880 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f29001e-1914-5f99-b0d4-2b79d02e6047" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$3$rd only" :db/id #edb/ref 17592186368477} {:answer/id #uuid "64624a3d-dfdd-5307-b92c-12954ac9ef44" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$1$st and $3$rd only" :db/id #edb/ref 17592186368478} {:answer/id #uuid "4b55be80-4783-555a-ab11-127f769351b6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$3$rd and $4$th only" :db/id #edb/ref 17592186368479} {:answer/id #uuid "c1d1676f-4ae2-5d22-a783-84704327b1ca" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$5$th only" :db/id #edb/ref 17592186368480} {:answer/id #uuid "13f58a79-b05a-5fe7-afc8-12e30d537ea9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$2$nd only" :db/id #edb/ref 17592186368481}] :answer-field/correct {:db/id #edb/ref 17592186368477} :answer-field/id #uuid "0ea66d08-2ce2-54bc-b37d-f9e1be771b2d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186368476}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "bfb0514f-33ea-5674-8071-994ec564a12b" :question/math-academy-id "q-35391" :question/problem "The row echelon form matrix $B$ is given below. What are its **non**-pivot columns?\n\n$$\nB=\\begin{bmatrix}3 & 4 & 3 & 0 & -5 \\\\ 0 & 2 & 0 & -4 & 1 \\\\ 0 & 0 & 0 & 3 & 0 \\\\ 0 & 0 & 0 & 0 & 1\\end{bmatrix}\n$$" :question/worked-solution "Remember that the pivots of a matrix in row echelon form are the first non-zero entries in each row of the matrix.\n\nWe can see that $B$ has $4$ pivots in the $1$st, $2$nd, $4$th, and $5$th columns:\n\n$$\nB=\\begin{bmatrix}3 & 4 & 3 & 0 & -5 \\\\ 0 & 2 & 0 & -4 & 1 \\\\ 0 & 0 & 0 & 3 & 0 \\\\ 0 & 0 & 0 & 0 & 1\\end{bmatrix}\n$$\n\nTherefore, the only non-pivot column is the $3$rd column."} :step/id #uuid "1b52500c-21bc-5f99-a291-e2b84ac9eab2" :step/next {:db/id #edb/ref 17592186573356}} {:db/id #edb/ref 17592186573341 :step/content {:db/id #edb/ref 17592186573261 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "023cc2f5-0dc4-57b8-83da-cab850c0da1f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$1$st and $3$rd only" :db/id #edb/ref 17592186572829} {:answer/id #uuid "294e94d5-45b0-5fea-8eb3-7cbc5ccb9acb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$1$st and $4$th only" :db/id #edb/ref 17592186572873} {:answer/id #uuid "43f5998d-2db6-5652-b314-092fcba29772" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$4$th only" :db/id #edb/ref 17592186572908} {:answer/id #uuid "8a19af7a-70b9-503e-80be-9feeab7ec744" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$1$st, $2$nd, $3$rd and $4$th" :db/id #edb/ref 17592186573002} {:answer/id #uuid "9c64bb76-0eee-5a58-8335-3ca14cce1cc3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$1$st, $3$rd, and $4$th only" :db/id #edb/ref 17592186573026}] :answer-field/correct {:db/id #edb/ref 17592186573026} :answer-field/id #uuid "06426327-a841-5962-9ad3-ae8e7d73820a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186573150}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0dd8f23a-a284-5af7-a370-b6877f8aea89" :question/math-academy-id "q-73637" :question/problem "What are the pivot columns of the matrix $P,$ given by\n\n$$\nP=\\begin{bmatrix}2 & 0 & -1 & 0 \\\\ 0 & 0 & 0 & 5 \\\\ 0 & 0 & 1 & -2\\end{bmatrix}?\n$$" :question/worked-solution "First, we need to convert $P$ to row echelon form:\n\n$$\n\\begin{aligned}P & =\\begin{bmatrix}2 & 0 & -1 & 0 \\\\ 0 & 0 & 0 & 5 \\\\ 0 & 0 & 1 & -2\\end{bmatrix} & {R}_{2} & ↔{R}_{3} \\\\  & ∼\\begin{bmatrix}2 & 0 & -1 & 0 \\\\ 0 & 0 & 1 & -2 \\\\ 0 & 0 & 0 & 5\\end{bmatrix}\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $P$ has $3$ pivots. In particular, the pivot columns are the $1$st, $3$rd, and $4$th columns."} :step/id #uuid "2fa9c88c-b6e4-5611-a708-8e19640dbe01" :step/next {:db/id #edb/ref 17592186573353}} {:db/id #edb/ref 17592186573352 :step/content {:db/id #edb/ref 17592186400590 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35bc5be3-2fe5-58fc-b85a-64fce1c7784d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$1$st and $2$nd only" :db/id #edb/ref 17592186400592} {:answer/id #uuid "7ee4be77-eda8-5477-a3be-58be37102e14" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$1$st and $4$th only" :db/id #edb/ref 17592186400593} {:answer/id #uuid "8e4d6b54-8a7a-519d-b637-e37bde3dbb2d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$1$st, $3$rd, and $4$th only" :db/id #edb/ref 17592186400594} {:answer/id #uuid "df41476c-0271-5fb9-ba37-452038f9f479" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$1$st, $2$nd, and $3$rd only" :db/id #edb/ref 17592186400595} {:answer/id #uuid "643510db-e574-5619-acbb-62a64f7e0730" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$1$st, $2$nd, and $4$th only" :db/id #edb/ref 17592186400596}] :answer-field/correct {:db/id #edb/ref 17592186400596} :answer-field/id #uuid "e34b1c74-ee10-528c-9c1b-188a96803527" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186400591}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "190c1f09-7ea5-53d8-a079-57d65ed02079" :question/math-academy-id "q-131302" :question/problem "What are the pivot columns of the matrix $P,$ given by\n\n$$\nP=\\begin{bmatrix}7 & 2 & 5 & 0 \\\\ 0 & -2 & -1 & 0 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 6\\end{bmatrix}?\n$$" :question/worked-solution "First, we need to convert $P$ to row echelon form:\n\n$$\n\\begin{aligned}P & =\\begin{bmatrix}7 & 2 & 5 & 0 \\\\ 0 & -2 & -1 & 0 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 6\\end{bmatrix} & {R}_{3} & ↔{R}_{4} \\\\  & ∼\\begin{bmatrix}7 & 2 & 5 & 0 \\\\ 0 & -2 & -1 & 0 \\\\ 0 & 0 & 0 & 6 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $P$ has $3$ pivots. In particular, the pivot columns are the $1$st, $2$nd, and $4$th columns."} :step/id #uuid "887149e4-2501-5d36-ab37-f2b093acd38b"} {:db/id #edb/ref 17592186573353 :step/content {:db/id #edb/ref 17592186410771 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d3d7552-73fd-5a30-adca-213fce95daf3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$1$st and $3$rd only" :db/id #edb/ref 17592186410765} {:answer/id #uuid "2c231bf1-1c62-5bb0-a5af-80fd235dc05d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$1$st only" :db/id #edb/ref 17592186410766} {:answer/id #uuid "88eecdfd-f245-5138-93d4-a347d38063c5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$3$rd only" :db/id #edb/ref 17592186410767} {:answer/id #uuid "a582f1d6-9082-5ca9-8a15-8892198e09a8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$1$st and $2$nd only" :db/id #edb/ref 17592186410768} {:answer/id #uuid "ab2f5437-3869-5765-88a5-9a58e75de19b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$2$nd, $4$th, and $5$th only" :db/id #edb/ref 17592186410769}] :answer-field/correct {:db/id #edb/ref 17592186410765} :answer-field/id #uuid "0ec2a6fc-f001-5e94-83d4-c400fba8593b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186410770}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "bcd1cb26-1c44-5d74-aa8e-2093ab435f98" :question/math-academy-id "q-130950" :question/problem "The row echelon form matrix $A$ is given below. What are its **non**-pivot columns?\n\n$$\nA=\\begin{bmatrix}0 & -4 & 3 & -3 & 5 \\\\ 0 & 0 & 0 & 2 & -6 \\\\ 0 & 0 & 0 & 0 & -3\\end{bmatrix}\n$$" :question/worked-solution "Remember that the pivots of a matrix in row echelon form are the first non-zero entries in each row of the matrix.\n\nWe can see that $A$ has $3$ pivots in the $2$nd, $4$th and $5$th columns:\n\n$$\nA=\\begin{bmatrix}0 & -4 & 3 & -3 & 5 \\\\ 0 & 0 & 0 & 2 & -6 \\\\ 0 & 0 & 0 & 0 & -3\\end{bmatrix}\n$$\n\nTherefore, the only non-pivot columns are the $1$st and $3$rd columns."} :step/id #uuid "9239f6d7-6799-56eb-8b1c-f9961bb1ed31" :step/next {:db/id #edb/ref 17592186573352}} {:db/id #edb/ref 17592186573356 :step/content {:db/id #edb/ref 17592186323677 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f6819e4-8455-5b92-950f-ef80d03e3a6f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186321384} {:answer/id #uuid "22d20878-4616-551d-9c51-c3ab339f7c02" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186321411} {:answer/id #uuid "3c1f36d6-2f31-5193-baa9-352cb4ec2d30" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186321613} {:answer/id #uuid "e42fdf84-b6d0-5da0-bf66-8b251052d501" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186322934} {:answer/id #uuid "e52ea9bd-c2ff-5f62-8bce-c9950d05029d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186322941}] :answer-field/correct {:db/id #edb/ref 17592186321411} :answer-field/id #uuid "0d8d06a1-5f1a-5dd9-a91d-202d54fedda4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186323192}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9f943d34-2384-5dae-913e-74d32b4a024f" :question/math-academy-id "q-35453" :question/problem "Determine the number of pivot columns of the matrix $B,$ given by\n\n$$\nB=\\begin{bmatrix}-2 & 0 & 0 & 0 & 0 \\\\ 0 & 1 & 4 & -2 & 0 \\\\ 0 & -3 & -6 & 4 & 2 \\\\ 0 & 0 & -3 & 1 & -1\\end{bmatrix}.\n$$" :question/worked-solution "First, we need to convert $B$ to row echelon form:\n\n$$\n\\begin{aligned}B & =\\begin{bmatrix}-2 & 0 & 0 & 0 & 0 \\\\ 0 & 1 & 4 & -2 & 0 \\\\ 0 & -3 & -6 & 4 & 2 \\\\ 0 & 0 & -3 & 1 & -1\\end{bmatrix} & {R}_{3} & :={R}_{3}+3{R}_{2} \\\\  & ∼\\begin{bmatrix}-2 & 0 & 0 & 0 & 0 \\\\ 0 & 1 & 4 & -2 & 0 \\\\ 0 & 0 & 6 & -2 & 2 \\\\ 0 & 0 & -3 & 1 & -1\\end{bmatrix} & {R}_{4} & :={R}_{4}+\\frac{1}{2}{R}_{3} \\\\  & ∼\\begin{bmatrix}-2 & 0 & 0 & 0 & 0 \\\\ 0 & 1 & 4 & -2 & 0 \\\\ 0 & 0 & 6 & -2 & 2 \\\\ 0 & 0 & 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $B$ has $3$ pivots, and therefore the number of pivot columns is $3.$"} :step/id #uuid "a40a64e5-a473-5166-a321-aeb74fa92cf3" :step/next {:db/id #edb/ref 17592186573341}}] :activity/title "Identifying the Pivot Columns of a Matrix" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186572820}]}
