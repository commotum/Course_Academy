#{[{:db/id #edb/ref 17592186410771 :knowledge-point/_questions [{:db/id #edb/ref 17592186124478 :knowledge-point/id #uuid "a5f0d2e9-1cf6-5fe4-85cc-f401382f39b2" :knowledge-point/title "Finding the Non-Pivot Columns of a Matrix in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d3d7552-73fd-5a30-adca-213fce95daf3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st and $3$rd only" :db/id #edb/ref 17592186410765} {:answer/id #uuid "2c231bf1-1c62-5bb0-a5af-80fd235dc05d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st only" :db/id #edb/ref 17592186410766} {:answer/id #uuid "88eecdfd-f245-5138-93d4-a347d38063c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3$rd only" :db/id #edb/ref 17592186410767} {:answer/id #uuid "a582f1d6-9082-5ca9-8a15-8892198e09a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st and $2$nd only" :db/id #edb/ref 17592186410768} {:answer/id #uuid "ab2f5437-3869-5765-88a5-9a58e75de19b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$nd, $4$th, and $5$th only" :db/id #edb/ref 17592186410769}] :answer-field/correct {:answer/id #uuid "1d3d7552-73fd-5a30-adca-213fce95daf3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st and $3$rd only" :db/id #edb/ref 17592186410765} :answer-field/id #uuid "0ec2a6fc-f001-5e94-83d4-c400fba8593b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186410770}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bcd1cb26-1c44-5d74-aa8e-2093ab435f98" :question/math-academy-id "q-130950" :question/problem "The row echelon form matrix $A$ is given below. What are its **non**-pivot columns?\n\n$$\nA=\\begin{bmatrix}0 & -4 & 3 & -3 & 5 \\\\ 0 & 0 & 0 & 2 & -6 \\\\ 0 & 0 & 0 & 0 & -3\\end{bmatrix}\n$$" :question/worked-solution "Remember that the pivots of a matrix in row echelon form are the first non-zero entries in each row of the matrix.\n\nWe can see that $A$ has $3$ pivots in the $2$nd, $4$th and $5$th columns:\n\n$$\nA=\\begin{bmatrix}0 & -4 & 3 & -3 & 5 \\\\ 0 & 0 & 0 & 2 & -6 \\\\ 0 & 0 & 0 & 0 & -3\\end{bmatrix}\n$$\n\nTherefore, the only non-pivot columns are the $1$st and $3$rd columns."}] [{:db/id #edb/ref 17592186400590 :knowledge-point/_questions [{:db/id #edb/ref 17592186124480 :knowledge-point/id #uuid "b1a557d6-52f3-5df3-8088-5b875296e72e" :knowledge-point/title "Finding the Pivot Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35bc5be3-2fe5-58fc-b85a-64fce1c7784d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st and $2$nd only" :db/id #edb/ref 17592186400592} {:answer/id #uuid "7ee4be77-eda8-5477-a3be-58be37102e14" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st and $4$th only" :db/id #edb/ref 17592186400593} {:answer/id #uuid "8e4d6b54-8a7a-519d-b637-e37bde3dbb2d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st, $3$rd, and $4$th only" :db/id #edb/ref 17592186400594} {:answer/id #uuid "df41476c-0271-5fb9-ba37-452038f9f479" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st, $2$nd, and $3$rd only" :db/id #edb/ref 17592186400595} {:answer/id #uuid "643510db-e574-5619-acbb-62a64f7e0730" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st, $2$nd, and $4$th only" :db/id #edb/ref 17592186400596}] :answer-field/correct {:answer/id #uuid "643510db-e574-5619-acbb-62a64f7e0730" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st, $2$nd, and $4$th only" :db/id #edb/ref 17592186400596} :answer-field/id #uuid "e34b1c74-ee10-528c-9c1b-188a96803527" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400591}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "190c1f09-7ea5-53d8-a079-57d65ed02079" :question/math-academy-id "q-131302" :question/problem "What are the pivot columns of the matrix $P,$ given by\n\n$$\nP=\\begin{bmatrix}7 & 2 & 5 & 0 \\\\ 0 & -2 & -1 & 0 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 6\\end{bmatrix}?\n$$" :question/worked-solution "First, we need to convert $P$ to row echelon form:\n\n$$\n\\begin{aligned}P & =\\begin{bmatrix}7 & 2 & 5 & 0 \\\\ 0 & -2 & -1 & 0 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 6\\end{bmatrix} & {R}_{3} & ↔{R}_{4} \\\\  & ∼\\begin{bmatrix}7 & 2 & 5 & 0 \\\\ 0 & -2 & -1 & 0 \\\\ 0 & 0 & 0 & 6 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $P$ has $3$ pivots. In particular, the pivot columns are the $1$st, $2$nd, and $4$th columns."}] [{:db/id #edb/ref 17592186124880 :knowledge-point/_questions [{:db/id #edb/ref 17592186124478 :knowledge-point/id #uuid "a5f0d2e9-1cf6-5fe4-85cc-f401382f39b2" :knowledge-point/title "Finding the Non-Pivot Columns of a Matrix in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f29001e-1914-5f99-b0d4-2b79d02e6047" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3$rd only" :db/id #edb/ref 17592186368477} {:answer/id #uuid "64624a3d-dfdd-5307-b92c-12954ac9ef44" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st and $3$rd only" :db/id #edb/ref 17592186368478} {:answer/id #uuid "4b55be80-4783-555a-ab11-127f769351b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3$rd and $4$th only" :db/id #edb/ref 17592186368479} {:answer/id #uuid "c1d1676f-4ae2-5d22-a783-84704327b1ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5$th only" :db/id #edb/ref 17592186368480} {:answer/id #uuid "13f58a79-b05a-5fe7-afc8-12e30d537ea9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$nd only" :db/id #edb/ref 17592186368481}] :answer-field/correct {:answer/id #uuid "5f29001e-1914-5f99-b0d4-2b79d02e6047" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3$rd only" :db/id #edb/ref 17592186368477} :answer-field/id #uuid "0ea66d08-2ce2-54bc-b37d-f9e1be771b2d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186368476}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bfb0514f-33ea-5674-8071-994ec564a12b" :question/math-academy-id "q-35391" :question/problem "The row echelon form matrix $B$ is given below. What are its **non**-pivot columns?\n\n$$\nB=\\begin{bmatrix}3 & 4 & 3 & 0 & -5 \\\\ 0 & 2 & 0 & -4 & 1 \\\\ 0 & 0 & 0 & 3 & 0 \\\\ 0 & 0 & 0 & 0 & 1\\end{bmatrix}\n$$" :question/worked-solution "Remember that the pivots of a matrix in row echelon form are the first non-zero entries in each row of the matrix.\n\nWe can see that $B$ has $4$ pivots in the $1$st, $2$nd, $4$th, and $5$th columns:\n\n$$\nB=\\begin{bmatrix}3 & 4 & 3 & 0 & -5 \\\\ 0 & 2 & 0 & -4 & 1 \\\\ 0 & 0 & 0 & 3 & 0 \\\\ 0 & 0 & 0 & 0 & 1\\end{bmatrix}\n$$\n\nTherefore, the only non-pivot column is the $3$rd column."}] [{:db/id #edb/ref 17592186323677 :knowledge-point/_questions [{:db/id #edb/ref 17592186124479 :knowledge-point/id #uuid "1073953e-7e0a-5237-8533-8882b7772741" :knowledge-point/title "Finding the Number of Pivot Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f6819e4-8455-5b92-950f-ef80d03e3a6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186321384} {:answer/id #uuid "22d20878-4616-551d-9c51-c3ab339f7c02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186321411} {:answer/id #uuid "3c1f36d6-2f31-5193-baa9-352cb4ec2d30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186321613} {:answer/id #uuid "e42fdf84-b6d0-5da0-bf66-8b251052d501" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186322934} {:answer/id #uuid "e52ea9bd-c2ff-5f62-8bce-c9950d05029d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186322941}] :answer-field/correct {:answer/id #uuid "22d20878-4616-551d-9c51-c3ab339f7c02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186321411} :answer-field/id #uuid "0d8d06a1-5f1a-5dd9-a91d-202d54fedda4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323192}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9f943d34-2384-5dae-913e-74d32b4a024f" :question/math-academy-id "q-35453" :question/problem "Determine the number of pivot columns of the matrix $B,$ given by\n\n$$\nB=\\begin{bmatrix}-2 & 0 & 0 & 0 & 0 \\\\ 0 & 1 & 4 & -2 & 0 \\\\ 0 & -3 & -6 & 4 & 2 \\\\ 0 & 0 & -3 & 1 & -1\\end{bmatrix}.\n$$" :question/worked-solution "First, we need to convert $B$ to row echelon form:\n\n$$\n\\begin{aligned}B & =\\begin{bmatrix}-2 & 0 & 0 & 0 & 0 \\\\ 0 & 1 & 4 & -2 & 0 \\\\ 0 & -3 & -6 & 4 & 2 \\\\ 0 & 0 & -3 & 1 & -1\\end{bmatrix} & {R}_{3} & :={R}_{3}+3{R}_{2} \\\\  & ∼\\begin{bmatrix}-2 & 0 & 0 & 0 & 0 \\\\ 0 & 1 & 4 & -2 & 0 \\\\ 0 & 0 & 6 & -2 & 2 \\\\ 0 & 0 & -3 & 1 & -1\\end{bmatrix} & {R}_{4} & :={R}_{4}+\\frac{1}{2}{R}_{3} \\\\  & ∼\\begin{bmatrix}-2 & 0 & 0 & 0 & 0 \\\\ 0 & 1 & 4 & -2 & 0 \\\\ 0 & 0 & 6 & -2 & 2 \\\\ 0 & 0 & 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $B$ has $3$ pivots, and therefore the number of pivot columns is $3.$"}]}
