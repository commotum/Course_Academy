/ref 17592186045417] [17592186184176 #edb/ref 1038 #edb/ref 17592186354522 #edb/ref 17592186045417] [17592186184176 #edb/ref 1038 #edb/ref 17592186369727 #edb/ref 17592186045417] [17592186184176 #edb/ref 1038 #edb/ref 17592186392361 #edb/ref 17592186045417] [17592186184176 #edb/ref 1038 #edb/ref 17592186394168 #edb/ref 17592186045417] [17592186184176 #edb/ref 1038 #edb/ref 17592186394525 #edb/ref 17592186045417] [17592186184176 #edb/ref 1038 #edb/ref 17592186394752 #edb/ref 17592186045417] [17592186184176 #edb/ref 1038 #edb/ref 17592186416357 #edb/ref 17592186045417] [17592186184176 #edb/ref 1039 "Finding the Orthogonal Projection of a Vector Onto the Solution Space of a Linear System" #edb/ref 17592186045417] [17592186184176 #edb/ref 1041 #edb/ref 17592186184075 #edb/ref 17592186045417] [17592186184176 #edb/ref 1042 #uuid "26b41192-9680-55c3-930c-52ff235e1800" #edb/ref 17592186045417] [17592186184207 #edb/ref 1037 #edb/ref 17592186049045 #edb/ref 17592186045417] [17592186184207 #edb/ref 1038 #edb/ref 17592186184779 #edb/ref 17592186045417] [17592186184207 #edb/ref 1038 #edb/ref 17592186184854 #edb/ref 17592186045417] [17592186184207 #edb/ref 1038 #edb/ref 17592186269227 #edb/ref 17592186045417] [17592186184207 #edb/ref 1038 #edb/ref 17592186269228 #edb/ref 17592186045417] [17592186184207 #edb/ref 1038 #edb/ref 17592186269229 #edb/ref 17592186045417] [17592186184207 #edb/ref 1038 #edb/ref 17592186269233 #edb/ref 17592186045417] [17592186184207 #edb/ref 1038 #edb/ref 17592186269234 #edb/ref 17592186045417] [17592186184207 #edb/ref 1038 #edb/ref 17592186326788 #edb/ref 17592186045417] [17592186184207 #edb/ref 1038 #edb/ref 17592186354518 #edb/ref 17592186045417] [17592186184207 #edb/ref 1038 #edb/ref 17592186369720 #edb/ref 17592186045417] [17592186184207 #edb/ref 1038 #edb/ref 17592186416356 #edb/ref 17592186045417] [17592186184207 #edb/ref 1038 #edb/ref 17592186416359 #edb/ref 17592186045417] [17592186184207 #edb/ref 1039 "Calculating the Acute Angle Between a Vector and a Subspace" #edb/ref 17592186045417] [17592186184207 #edb/ref 1041 #edb/ref 17592186184111 #edb/ref 17592186045417] [17592186184207 #edb/ref 1042 #uuid "1224e2dd-96bc-5c24-aacf-3c36a7c3a1e1" #edb/ref 17592186045417] [17592186184403 #edb/ref 1043 #edb/ref 17592186184942 #edb/ref 17592186045417] [17592186184403 #edb/ref 1043 #edb/ref 17592186184943 #edb/ref 17592186045417] [17592186184403 #edb/ref 1043 #edb/ref 17592186184985 #edb/ref 17592186045417] [17592186184403 #edb/ref 1043 #edb/ref 17592186184986 #edb/ref 17592186045417] [17592186184403 #edb/ref 1043 #edb/ref 17592186184987 #edb/ref 17592186045417] [17592186184403 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186184403 #edb/ref 1045 "Projecting Vectors Onto Subspaces in Euclidean Spaces (Arbitrary Bases): Applications" #edb/ref 17592186045417] [17592186184403 #edb/ref 1046 #edb/ref 17592186184985 #edb/ref 17592186045417] [17592186184403 #edb/ref 1049 #edb/ref 17592186048506 #edb/ref 17592186045417] [17592186184403 #edb/ref 1050 1260.0 #edb/ref 17592186045417] [17592186184403 #edb/ref 1053 #uuid "74cb5e70-9a9a-5b7d-b148-f583f043d560" #edb/ref 17592186045417] [17592186184779 #edb/ref 1068 #edb/ref 17592186370907 #edb/ref 17592186045417] [17592186184779 #edb/ref 1069 "q-40578" #edb/ref 17592186045417] [17592186184779 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186184779 #edb/ref 1071 "Find the acute angle between the vector $x$ and the subspace spanned by the linearly independent vectors ${{a}_{1},{a}_{2}},$ where\n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ 1 \\\\ 1\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}1 \\\\ 1 \\\\ -1\\end{aligned}],\\,x=[\\begin{aligned}2 \\\\ -1 \\\\ 1\\end{aligned}].\n$$" #edb/ref 17592186045417] [17592186184779 #edb/ref 1072 #uuid "f6fed417-1aa3-54f6-b260-a0764f066874" #edb/ref 17592186045417] [17592186184779 #edb/ref 1073 true #edb/ref 17592186045417] [17592186184779 #edb/ref 1074 "The orthogonal projection of $x$ onto the subspace spanned by the columns of a matrix $A$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x=A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x.\n$$\n\nIn our case, we have\n\n$$\nA=[\\begin{aligned}| & | \\\\ {a}_{1} & {a}_{2} \\\\ | & |\\end{aligned}]=[\\begin{aligned}1 & 1 \\\\ 1 & 1 \\\\ 1 & -1\\end{aligned}]\\,⟹\\,{A}^{T}=[\\begin{aligned}1 & 1 & 1 \\\\ 1 & 1 & -1\\end{aligned}].\n$$\n\nTherefore, we get the following projection:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =[\\begin{aligned}1 & 1 \\\\ 1 & 1 \\\\ 1 & -1\\end{aligned}]\\cdot {([\\begin{aligned}1 & 1 & 1 \\\\ 1 & 1 & -1\\end{aligned}]\\cdot [\\begin{aligned}1 & 1 \\\\ 1 & 1 \\\\ 1 & -1\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}1 & 1 & 1 \\\\ 1 & 1 & -1\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ -1 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 1 \\\\ 1 & 1 \\\\ 1 & -1\\end{aligned}]\\cdot {[\\begin{aligned}3 & 1 \\\\ 1 & 3\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}2 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 1 \\\\ 1 & 1 \\\\ 1 & -1\\end{aligned}]\\cdot \\frac{1}{8}[\\begin{aligned}3 & -1 \\\\ -1 & 3\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 1 \\\\ 1 & 1 \\\\ 1 & -1\\end{aligned}]\\cdot \\frac{1}{4}[\\begin{aligned}3 \\\\ -1\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}1 \\\\ 1 \\\\ 2\\end{aligned}]\\end{aligned}\n$$\n\nThe acute angle between $x$ and $S$ is the acute angle between $x$ and ${\\text{proj}}_{S}x.$ Equivalently, it is the acute angle between $x$ and any non-zero vector that is parallel to ${\\text{proj}}_{S}x.$ So, to make calculations easier, we can find the angle between the vectors\n\n$\\,$ $x=[\\begin{aligned}2 \\\\ -1 \\\\ 1\\end{aligned}]\\,$ and $\\,2\\,{\\text{proj}}_{S}x=[\\begin{aligned}1 \\\\ 1 \\\\ 2\\end{aligned}].$\n\nComputing the cosine using the dot product, we obtain\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{2\\cdot 1+(-1)\\cdot 1+1\\cdot 2}{\\sqrt{{2}^{2}+(-1)^{2}+{1}^{2}}\\sqrt{{1}^{2}+{1}^{2}+{2}^{2}}} \\\\  & =\\frac{3}{\\sqrt{6}\\sqrt{6}} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{1}{2})=\\frac{\\pi }{3},\n$$\n\nwhich is already an acute angle." #edb/ref 17592186045417] [17592186184942 #edb/ref 1058 #edb/ref 17592186184987 #edb/ref 17592186045417] [17592186184942 #edb/ref 1061 21956 #edb/ref 17592186045417] [17592186184942 #edb/ref 1062 #uuid "b3f00d8e-e0e0-5507-a417-bc0bae247d7f" #edb/ref 17592186045417] [17592186184942 #edb/ref 1063 #edb/ref 17592186184175 #edb/ref 17592186045417] [17592186184943 #edb/ref 1061 21957 #edb/ref 17592186045417] [17592186184943 #edb/ref 1062 #uuid "1b0aff21-5c4b-587f-a636-9265b1edc074" #edb/ref 17592186045417] [17592186184943 #edb/ref 1063 #edb/ref 17592186184176 #edb/ref 17592186045417] [17592186184985 #edb/ref 1058 #edb/ref 17592186184942 #edb/ref 17592186045417] [17592186184985 #edb/ref 1061 37246 #edb/ref 17592186045417] [17592186184985 #edb/ref 1062 #uuid "290e4663-8f35-58a4-8aae-e48323b5562f" #edb/ref 17592186045417] [17592186184985 #edb/ref 1063 #edb/ref 17592186185333 #edb/ref 17592186045417] [17592186184986 #edb/ref 1058 #edb/ref 17592186184943 #edb/ref 17592186045417] [17592186184986 #edb/ref 1061 37247 #edb/ref 17592186045417] [17592186184986 #edb/ref 1062 #uuid "176d8f71-b7e6-5f7f-ace6-c9db9b253e57" #edb/ref 17592186045417] [17592186184986 #edb/ref 1063 #edb/ref 17592186184207 #edb/ref 17592186045417] [17592186184987 #edb/ref 1058 #edb/ref 17592186184986 #edb/ref 17592186045417] [17592186184987 #edb/ref 1061 37248 #edb/ref 17592186045417] [17592186184987 #edb/ref 1062 #uuid "53d452ce-ad18-557e-8201-0b1f1d4b9e5a" #edb/ref 17592186045417] [17592186184987 #edb/ref 1063 #edb/ref 17592186185334 #edb/ref 17592186045417] [17592186185333 #edb/ref 1064 "One use for finding the orthogonal projection of a vector onto a subspace is to find the shortest distance between the vector and the subspace.\n\nGiven a vector $\\mathbf{x}$ and a subspace $S = \\textrm{Span}\\{ \\mathbf{a}_1, \\mathbf{a}_2 \\},$ the **distance between $\\mathbf{x}$ and $S$** is given by \n\n$$\n\\Vert \\mathbf{x} - \\textrm{proj}_{S}\\mathbf{x} \\Vert\n$$\n\nas shown in the diagram below.\n\n![](images/d1/d10fd1778529183deb6912cebe9d2b7ad405091fe21a261c464d3d22c6d0860b.png)\n\nLet's find the distance between the vector $\\mathbf{x}$ and the subspace spanned by the linearly independent vectors $\\{\\mathbf{a}_1,\\mathbf{a}_2 \\},$ where\n\n![](images/83/83f52159171e736c7ee9edbd0593442d2282572db667eca483e5a77d0b73c9f7.svg)\n\nThe orthogonal projection of $\\mathbf{x}$ onto the subspace spanned by the columns of a matrix $A$ is given by\n\n$$\n\\textrm{proj}_{S} \\: \\mathbf{x} = A(A^T\\!A)^{-1}\\!A^T\\,\\mathbf{x}.\n$$\n\nIn this case, we have \n![](images/9e/9eca38b4b340e44108b073e3f939ce29ae96345b9c1870b9e2cc57a98f9cb077.svg)\nTherefore, we get the following projection: \n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =[\\begin{aligned}1 & 2 \\\\ 0 & -1 \\\\ -1 & -2\\end{aligned}]\\cdot {([\\begin{aligned}1 & 0 & -1 \\\\ 2 & -1 & -2\\end{aligned}]\\cdot [\\begin{aligned}1 & 2 \\\\ 0 & -1 \\\\ -1 & -2\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}1 & 0 & -1 \\\\ 2 & -1 & -2\\end{aligned}]\\cdot [\\begin{aligned}0 \\\\ 2 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 2 \\\\ 0 & -1 \\\\ -1 & -2\\end{aligned}]\\cdot {[\\begin{aligned}2 & 4 \\\\ 4 & 9\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}-4 \\\\ -10\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 2 \\\\ 0 & -1 \\\\ -1 & -2\\end{aligned}]\\cdot \\frac{1}{2}[\\begin{aligned}9 & -4 \\\\ -4 & 2\\end{aligned}]\\cdot [\\begin{aligned}-4 \\\\ -10\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 2 \\\\ 0 & -1 \\\\ -1 & -2\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}-2 \\\\ 2 \\\\ 2\\end{aligned}]=\\overset{^}{x}\\end{aligned}\n$$\n\n \n\nFinally, using the distance formula, the distance between $\\mathbf{x}$ and the subspace $S$ is given by\n\n$$\n\\begin{aligned}d(x,\\overset{^}{x}) & =‖x-\\overset{^}{x}‖ \\\\  & =\\sqrt{({x}_{1}-{\\overset{^}{x}}_{1})^{2}+({x}_{2}-{\\overset{^}{x}}_{2})^{2}+({x}_{3}-{\\overset{^}{x}}_{3})^{2}} \\\\  & =\\sqrt{(0-(-2))^{2}+(2-2)^{2}+(4-2)^{2}} \\\\  & =\\sqrt{4+0+4} \\\\  & =\\sqrt{8} \\\\  & =2\\sqrt{2}.\\end{aligned}\n$$\n\n**Note:** Recall that the vector $\\textbf{x}-\\textrm{proj}_{S}\\,\\mathbf{x},$ whose norm $\\| \\textbf{x}-\\textrm{proj}_{S}\\,\\mathbf{x} \\|$ represents the distance from $\\mathbf{x}$ to $S,$ is sometimes called the **vector rejection of $\\mathbf{x}$ from $S.$**" #edb/ref 17592186045417] [17592186185333 #edb/ref 1065 6131 #edb/ref 17592186045417] [17592186185333 #edb/ref 1066 #uuid "97ecd7fd-ac4d-5cca-86c7-db064dd69609" #edb/ref 17592186045417] [17592186185333 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186185334 #edb/ref 1064 "As well as finding the distance between a vector and a subspace, we can also use the vector's orthogonal projection onto the subspace to find the angle between the vector and the subspace.\n\nGiven a vector $\\mathbf{x}$ and a subspace $S = \\textrm{Span}\\{ \\mathbf{a}_1, \\mathbf{a}_2 \\},$ the **acute angle between $\\mathbf{x}$ and $S$** is the acute angle formed by $\\mathbf{x}$ and its orthogonal projection $\\textrm{proj}_S \\mathbf{x},$ as shown below:\n\n![](images/1c/1c9fd00ab46691fefc65ffa6478ed589fbad1df6bfd19b913c6a4a94ae0358a0.png)\n\nLet's return to our previous example, where we had\n\n![](images/3c/3c881ed55614722cf3cfe5c969c8c05a0c093e87cf1d2aa1221dbfc741455b92.svg)\n\nPreviously, we found that the orthogonal projection of $\\mathbf{x}$ into the subspace spanned by $\\{ \\mathbf{a}_1, \\mathbf{a}_2 \\}$ is\n\n![](images/6a/6a060f96f72ece67567be5d0deb70042fa50ba2f005a1539c67383f6de3e1426.svg)\n\nWe can compute the cosine of the angle between $\\mathbf x$ and $\\textrm{proj}_S \\mathbf x$ using the dot product:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{x\\cdot {\\text{proj}}_{S}x}{||x||\\cdot ||{\\text{proj}}_{S}x||} \\\\  & =\\frac{0\\cdot (-2)+2\\cdot 2+4\\cdot 2}{\\sqrt{{0}^{2}+{2}^{2}+{4}^{2}}\\sqrt{(-2)^{2}+{2}^{2}+{2}^{2}}} \\\\  & =\\frac{12}{\\sqrt{20}\\sqrt{12}} \\\\  & =\\frac{2\\cdot 2\\cdot 3}{2\\sqrt{5}\\cdot 2\\sqrt{3}} \\\\  & =\\frac{\\sqrt{3}}{\\sqrt{5}}\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\theta = \\arccos\\left(  \\dfrac{\\sqrt3}{\\sqrt5}\\right) \\approx 39.23^{\\circ},\n$$\n\nwhich is already an acute angle." #edb/ref 17592186045417] [17592186185334 #edb/ref 1065 6132 #edb/ref 17592186045417] [17592186185334 #edb/ref 1066 #uuid "4c19ec4b-3bdc-50e9-aac0-193e2ab2c298" #edb/ref 17592186045417] [17592186185334 #edb/ref 1067 "Angle Between a Vector and a Subspace" #edb/ref 17592186045417] [17592186266234 #edb/ref 1080 "{21.83}^{∘}" #edb/ref 17592186045417] [17592186266234 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186266234 #edb/ref 1083 #uuid "0a09b02d-8bbe-5d10-a4f9-370bef55e764" #edb/ref 17592186045417] [17592186266999 #edb/ref 1080 "{20.02}^{∘}" #edb/ref 17592186045417] [17592186266999 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186266999 #edb/ref 1083 #uuid "60cc524b-fcb3-5eda-a2ef-972dc00b4dd9" #edb/ref 17592186045417] [17592186268005 #edb/ref 1080 "{19.47}^{∘}" #edb/ref 17592186045417] [17592186268005 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186268005 #edb/ref 1083 #uuid "d0230632-643e-5176-9cfd-33172a36de8a" #edb/ref 17592186045417] [17592186268164 #edb/ref 1080 "{17.36}^{∘}" #edb/ref 17592186045417] [17592186268164 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186268164 #edb/ref 1083 #uuid "e4a14d53-aae0-5887-9f9d-89614f80206d" #edb/ref 17592186045417] [17592186268192 #edb/ref 1080 "{18.88}^{∘}" #edb/ref 17592186045417] [17592186268192 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186268192 #edb/ref 1083 #uuid "e6ffd20f-b627-5d13-90b1-7aab917e72f5" #edb/ref 17592186045417] [17592186268829 #edb/ref 107