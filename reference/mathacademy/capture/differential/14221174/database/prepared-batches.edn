end{aligned}]\\cdot [\\begin{aligned}1 & 5\\end{aligned}])=3([\\begin{aligned}2 & 10 \\\\ -1 & -5 \\\\ 3 & 15\\end{aligned}])=[\\begin{aligned}6 & 30 \\\\ -3 & -15 \\\\ 9 & 45\\end{aligned}].\n$$"] ["question-26793c1a-40f5-5bd2-9877-7d31b77eb2ea" :question/difficulty :question.difficulty/easy] ["answer-field-843e0ee2-2793-547f-b5b3-9f47090c1d93" :answer-field/id #uuid "843e0ee2-2793-547f-b5b3-9f47090c1d93"] ["answer-4cadc966-a1c1-5a9a-b852-d767b4eda976" :answer/id #uuid "4cadc966-a1c1-5a9a-b852-d767b4eda976"] ["answer-4cadc966-a1c1-5a9a-b852-d767b4eda976" :answer/type :answer.type/math] ["answer-4cadc966-a1c1-5a9a-b852-d767b4eda976" :answer/value "[\\begin{aligned}2 & 10 & -1 \\\\ -5 & 3 & 15\\end{aligned}]"] ["answer-46954ab0-964a-57ab-8fa8-0e59d5360640" :answer/id #uuid "46954ab0-964a-57ab-8fa8-0e59d5360640"] ["answer-46954ab0-964a-57ab-8fa8-0e59d5360640" :answer/type :answer.type/math] ["answer-46954ab0-964a-57ab-8fa8-0e59d5360640" :answer/value "[\\begin{aligned}2 & 10 \\\\ -1 & -5 \\\\ 3 & 15\\end{aligned}]"] ["answer-965ed177-569f-5e7f-8162-88c02d3a166d" :answer/id #uuid "965ed177-569f-5e7f-8162-88c02d3a166d"] ["answer-965ed177-569f-5e7f-8162-88c02d3a166d" :answer/type :answer.type/math] ["answer-965ed177-569f-5e7f-8162-88c02d3a166d" :answer/value "[\\begin{aligned}36 \\\\ -18 \\\\ 44\\end{aligned}]"] ["answer-61598bc1-09c8-541d-a2bc-495d7aa9e5da" :answer/id #uuid "61598bc1-09c8-541d-a2bc-495d7aa9e5da"] ["answer-61598bc1-09c8-541d-a2bc-495d7aa9e5da" :answer/type :answer.type/math] ["answer-61598bc1-09c8-541d-a2bc-495d7aa9e5da" :answer/value "[\\begin{aligned}6 & 30 \\\\ -3 & -15 \\\\ 9 & 45\\end{aligned}]"] ["answer-a0550c2c-46e7-5b33-8b4a-ff7f9477e256" :answer/id #uuid "a0550c2c-46e7-5b33-8b4a-ff7f9477e256"] ["answer-a0550c2c-46e7-5b33-8b4a-ff7f9477e256" :answer/type :answer.type/math] ["answer-a0550c2c-46e7-5b33-8b4a-ff7f9477e256" :answer/value "[\\begin{aligned}6 & 30 \\\\ 3 & 15 \\\\ 9 & 45\\end{aligned}]"] ["answer-field-843e0ee2-2793-547f-b5b3-9f47090c1d