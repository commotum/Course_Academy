sy] ["answer-field-ddeae402-d1d8-5be0-a7f2-3f0d5107eef1" :answer-field/id #uuid "ddeae402-d1d8-5be0-a7f2-3f0d5107eef1"] ["answer-7af10c05-dd89-5b9c-85e8-ac267c31a704" :answer/id #uuid "7af10c05-dd89-5b9c-85e8-ac267c31a704"] ["answer-7af10c05-dd89-5b9c-85e8-ac267c31a704" :answer/type :answer.type/math] ["answer-7af10c05-dd89-5b9c-85e8-ac267c31a704" :answer/value "[\\begin{aligned}-30 & 6\\end{aligned}]"] ["answer-d8c303b2-7786-51c5-872c-00f11a1d607b" :answer/id #uuid "d8c303b2-7786-51c5-872c-00f11a1d607b"] ["answer-d8c303b2-7786-51c5-872c-00f11a1d607b" :answer/type :answer.type/math] ["answer-d8c303b2-7786-51c5-872c-00f11a1d607b" :answer/value "[\\begin{aligned}-40 & 10 \\\\ 8 & -2\\end{aligned}]"] ["answer-86291e0b-5df9-5de7-8b90-d677970284b7" :answer/id #uuid "86291e0b-5df9-5de7-8b90-d677970284b7"] ["answer-86291e0b-5df9-5de7-8b90-d677970284b7" :answer/type :answer.type/math] ["answer-86291e0b-5df9-5de7-8b90-d677970284b7" :answer/value "[\\begin{aligned}-40 & 8 \\\\ 10 & -2\\end{aligned}]"] ["answer-56eeb979-bf72-5af2-b0de-d329747584af" :answer/id #uuid "56eeb979-bf72-5af2-b0de-d329747584af"] ["answer-56eeb979-bf72-5af2-b0de-d329747584af" :answer/type :answer.type/math] ["answer-56eeb979-bf72-5af2-b0de-d329747584af" :answer/value "[\\begin{aligned}-40 \\\\ 8\\end{aligned}]"] ["answer-d9de97b5-0e49-5c08-b7c8-bee6dcc4b8c5" :answer/id #uuid "d9de97b5-0e49-5c08-b7c8-bee6dcc4b8c5"] ["answer-d9de97b5-0e49-5c08-b7c8-bee6dcc4b8c5" :answer/type :answer.type/math] ["answer-d9de97b5-0e49-5c08-b7c8-bee6dcc4b8c5" :answer/value "[\\begin{aligned}8 & -2 \\\\ -40 & 10\\end{aligned}]"] ["answer-field-ddeae402-d1d8-5be0-a7f2-3f0d5107eef1" :answer-field/key "selection"] ["answer-field-ddeae402-d1d8-5be0-a7f2-3f0d5107eef1" :answer-field/type :answer-field.type/radio] ["answer-field-ddeae402-d1d8-5be0-a7f2-3f0d5107eef1" :answer-field/correct "answer-d8c303b2-7786-51c5-872c-00f11a1d607b"] ["answer-field-ddeae402-d1d8-5be0-a7f2-3f0d5107eef1" :answer-field/choices "answer-7af10c05-dd89-5b