#{[{:db/id #edb/ref 17592186105478 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105701 :knowledge-point/id #uuid "7c9317eb-d1ce-5f42-b69b-a37e643b865b" :knowledge-point/title "Calculating a Vector Projection Using Angle and Magnitude"}] :question/id #uuid "3278333b-a29e-54c5-bc94-b5525bc6f751" :question/math-academy-id "e-14617" :question/problem "Suppose that $|\\,\\mathbf{a}\\,|=8,|\\,\\mathbf{b}\\,|=4$ and that the angle between the vectors is $\\theta = \\dfrac{5\\pi}{6}.$ Find the vector projection of $\\mathbf{a}$ onto $\\mathbf{b}$ in terms of the vector $\\mathbf{b}.$" :question/worked-solution "First, we find the scalar projection as follows:\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =|\\,a\\,|\\operatorname{cos}⁡\\theta  \\\\  & =8\\operatorname{cos}⁡(\\frac{5\\pi }{6}) \\\\  & =8\\cdot (-\\frac{\\sqrt{3}}{2}) \\\\  & =-4\\sqrt{3}\\end{aligned}\n$$\n\nNow, we find the unit vector that is parallel to $\\mathbf{b}\\mathbin{:}$\n\n$$\n\\mathbf{u} = \\dfrac{\\mathbf{b}}{|\\,\\mathbf{b}\\,|} = \\dfrac{\\mathbf{b}}{4} = \\dfrac{1}{4} \\mathbf{b}\n$$\n\nFinally, we compute the vector projection as follows:\n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,a & ={\\text{comp}}_{b}\\,a\\cdot u \\\\  & =-4\\sqrt{3}\\cdot \\frac{1}{4}b \\\\  & =-\\sqrt{3}b\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186105479 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105702 :knowledge-point/id #uuid "c0670172-77cb-5e88-b78d-e5136c06095f" :knowledge-point/title "Calculating a Vector Projection Using Components"}] :question/id #uuid "58b2269d-f998-5ba5-9df8-54ea422c43aa" :question/math-academy-id "e-14618" :question/problem "Let $\\mathbf{a}=\\langle 1,-3,5 \\rangle$ and $\\mathbf{b}=\\langle 5,-4,0 \\rangle$. Find the vector projection of $\\mathbf{a}$ onto $\\mathbf{b}$." :question/worked-solution "Using the formula for the vector projection, we obtain\n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,a & =\\frac{a\\cdot b}{b\\cdot b}b \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}b \\\\  & =\\frac{1\\cdot 5+(-3)\\cdot (-4)+5\\cdot 0}{{5}^{2}+(-4)^{2}+{0}^{2}}b \\\\  & =\\frac{17}{41}⟨5,-4,0⟩ \\\\  & =⟨\\frac{85}{41},-\\frac{68}{41},0⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186105480 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105703 :knowledge-point/id #uuid "84c96375-27d5-5ada-a952-34e09b3e92bf" :knowledge-point/title "Perpendicular Vectors"}] :question/id #uuid "663f3f5e-56cf-5517-ba1e-d1a355767e0b" :question/math-academy-id "e-14619" :question/problem "Let ![](images/98/984a6c85f7337efcad03af6e6b7af44340243770ade690e383c286154ca9024c.svg) and ![](images/82/825255386c414868f28d139cdc3e50a2b8252fc0c6ad09de579119092afadb9c.svg). Find the vector projection of $\\mathbf{a}$ onto $\\mathbf{b}$." :question/worked-solution "Using the formula for the vector projection, we obtain\n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,a & =\\frac{a\\cdot b}{b\\cdot b}b \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}b \\\\  & =\\frac{1\\cdot 1+0\\cdot 5+1\\cdot (-1)}{{1}^{2}+{5}^{2}+(-1)^{2}}b \\\\  & =\\frac{0}{{1}^{2}+{5}^{2}+(-1)^{2}}b \\\\  & =⟨0,0,0⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287856 :knowledge-point/_questions [{:db/id #edb/ref 17592186105701 :knowledge-point/id #uuid "7c9317eb-d1ce-5f42-b69b-a37e643b865b" :knowledge-point/title "Calculating a Vector Projection Using Angle and Magnitude"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f6cbc3e-b82a-553d-94d8-401e33dd49b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}b" :db/id #edb/ref 17592186285065} {:answer/id #uuid "4fb8bf5b-050e-5e75-85d0-83b6dae01c70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}b" :db/id #edb/ref 17592186285527} {:answer/id #uuid "5cb6e38b-710d-5de4-abb7-71c05b3ce733" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}b" :db/id #edb/ref 17592186285637} {:answer/id #uuid "a3c338a5-5519-5b53-bc1d-5094de9107cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b" :db/id #edb/ref 17592186286289} {:answer/id #uuid "d8038cdc-eff0-5338-8acc-7fb1e7013597" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}b" :db/id #edb/ref 17592186286753}] :answer-field/correct {:answer/id #uuid "5cb6e38b-710d-5de4-abb7-71c05b3ce733" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}b" :db/id #edb/ref 17592186285637} :answer-field/id #uuid "7eabd843-47b3-5007-8b44-629b9704f5fe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287414}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3e9c6ca5-7b6e-53f7-acac-676b213b8413" :question/math-academy-id "q-18375" :question/problem "Suppose that $|\\,a\\,|=6$, $|\\,b\\,|=2$ and that the angle between the vectors is $\\theta =\\frac{\\pi }{3}.$ Find the vector projection of $a$ onto $b$ in terms of the vector $b.$" :question/worked-solution "First, we find the scalar projection as follows:\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =|\\,a\\,|\\operatorname{cos}⁡\\theta  \\\\  & =6\\operatorname{cos}⁡(\\frac{\\pi }{3}) \\\\  & =6\\cdot \\frac{1}{2} \\\\  & =3\\end{aligned}\n$$\n\nNow, we find the unit vector that is parallel to $b:$\n\n$$\nu=\\frac{b}{|\\,b\\,|}=\\frac{b}{2}=\\frac{1}{2}b\n$$\n\nFinally, we compute the vector projection as follows:\n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,a & ={\\text{comp}}_{b}\\,a\\cdot u \\\\  & =3\\cdot \\frac{1}{2}b \\\\  & =\\frac{3}{2}b\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290294 :knowledge-point/_questions [{:db/id #edb/ref 17592186105703 :knowledge-point/id #uuid "84c96375-27d5-5ada-a952-34e09b3e92bf" :knowledge-point/title "Perpendicular Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05f5cec0-bb91-5c28-a043-4592ab711f53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186288076} {:answer/id #uuid "5aa80b1b-8d9e-53e5-b4ff-3afd65b4f60b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186288664} {:answer/id #uuid "69174e17-b083-51ab-a263-552d37887450" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186288772} {:answer/id #uuid "7f12c795-1d8e-5fc7-8db2-9ce3db4be399" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186288894} {:answer/id #uuid "a9b8268e-e1e9-5fc0-968f-daa50516ca35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186289158}] :answer-field/correct {:answer/id #uuid "5aa80b1b-8d9e-53e5-b4ff-3afd65b4f60b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186288664} :answer-field/id #uuid "9dafe033-6f62-51c0-aef0-ed6ade7a0953" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290079}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ff2e4ed3-b952-5f49-9d70-f52c7f12daca" :question/math-academy-id "q-212457" :question/problem "Let $a=⟨0,1,-5⟩$ and $b=⟨6,x,-2⟩.$ Given that the projection of $a$ onto $b$ is the zero vector, find the value of $x.$" :question/worked-solution "Since $a$ is a nonzero vector, its projection onto another nonzero vector $b$ equals the zero vector only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =0\\cdot 6+1\\cdot x+(-5)\\cdot (-2) \\\\  & =x+10.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ x+10 & =0 \\\\ x & =-10.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186374538 :knowledge-point/_questions [{:db/id #edb/ref 17592186105703 :knowledge-point/id #uuid "84c96375-27d5-5ada-a952-34e09b3e92bf" :knowledge-point/title "Perpendicular Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10a6363d-50b7-53ee-9211-bf98b3b730c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186374540} {:answer/id #uuid "6d50033c-ac1e-5bc6-84ee-1d4b187400c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186374541} {:answer/id #uuid "2c9d11de-00b2-5f81-bbb0-9e2cfe2d24d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186374542} {:answer/id #uuid "4f93f9db-ba0a-508a-846f-8f31e1eda3c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186374543} {:answer/id #uuid "4bade5c1-6626-584d-87f1-ee5499c60e01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186374544}] :answer-field/correct {:answer/id #uuid "4f93f9db-ba0a-508a-846f-8f31e1eda3c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186374543} :answer-field/id #uuid "af73e53b-f8ec-53d4-ad2f-688f3fcd26ab" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374539}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cfdc0ea6-159a-5bd6-ad02-2e0fd2db5b29" :question/math-academy-id "q-212464" :question/problem "Let $a=\\begin{bmatrix}-6 \\\\ -3 \\\\ 0\\end{bmatrix}$ and $b=\\begin{bmatrix}-2 \\\\ x \\\\ -3\\end{bmatrix}.$ Given that the projection of $a$ onto $b$ is the zero vector, find the value of $x.$" :question/worked-solution "Since $a$ is a nonzero vector, its projection onto another nonzero vector $b$ equals the zero vector only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =-6\\cdot (-2)+(-3)\\cdot x+0\\cdot (-3) \\\\  & =12-3x.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ 12-3x & =0 \\\\ -3x & =-12 \\\\ x & =4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186441585 :knowledge-point/_questions [{:db/id #edb/ref 17592186105701 :knowledge-point/id #uuid "7c9317eb-d1ce-5f42-b69b-a37e643b865b" :knowledge-point/title "Calculating a Vector Projection Using Angle and Magnitude"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a7d4837-c858-547a-810b-4a932bb463f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186441542}] :answer-field/correct {:answer/id #uuid "3a7d4837-c858-547a-810b-4a932bb463f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186441542} :answer-field/id #uuid "d497f000-d7bf-588c-ad25-93aa61c11659" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186441577}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8e5a64ce-22c5-5e8c-997a-c2e3826ce849" :question/math-academy-id "q-275227" :question/problem "Suppose that $|\\,a\\,|=16$, $|\\,b\\,|=2$ and that the angle between the vectors is $\\theta =\\frac{2\\pi }{3}.$ Find the vector projection of $a$ onto $b$ in terms of the vector $b.$\n\n${\\text{proj}}_{b}\\,a=$\n{{field-1}}\n$b$" :question/worked-solution "First, we find the scalar projection as follows:\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =|\\,a\\,|\\operatorname{cos}⁡\\theta  \\\\  & =16\\operatorname{cos}⁡(\\frac{2\\pi }{3}) \\\\  & =16\\cdot (-\\frac{1}{2}) \\\\  & =-8\\end{aligned}\n$$\n\nNow, we find the unit vector that is parallel to $b:$\n\n$$\nu=\\frac{b}{|\\,b\\,|}=\\frac{b}{2}=\\frac{1}{2}b\n$$\n\nFinally, we compute the vector projection as follows:\n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,a & ={\\text{comp}}_{b}\\,a\\cdot u \\\\  & =-8\\cdot \\frac{1}{2}b \\\\  & =-4\\,b.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186292818 :knowledge-point/_questions [{:db/id #edb/ref 17592186105701 :knowledge-point/id #uuid "7c9317eb-d1ce-5f42-b69b-a37e643b865b" :knowledge-point/title "Calculating a Vector Projection Using Angle and Magnitude"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09b627b4-e32f-5ff8-8c64-024fcbaa8a5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{3}" :db/id #edb/ref 17592186290682}] :answer-field/correct {:answer/id #uuid "09b627b4-e32f-5ff8-8c64-024fcbaa8a5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{3}" :db/id #edb/ref 17592186290682} :answer-field/id #uuid "b7b378af-a83f-5fb2-a674-06ec9fbb5b52" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292299}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e880cc2c-2aac-5a52-870b-d18697e1514b" :question/math-academy-id "q-275228" :question/problem "Suppose that $|\\,p\\,|=6$, $|\\,q\\,|=12$ and that the angle between the vectors is $\\theta ={150}^{∘}.$ Find the vector projection of $q$ onto $p$ in terms of the vector $p.$\n\n${\\text{proj}}_{p}\\,q=$\n{{field-1}}\n$p$" :question/worked-solution "First, we find the scalar projection as follows:\n\n$$\n\\begin{aligned}{\\text{comp}}_{p}\\,q & =|\\,q\\,|\\operatorname{cos}⁡\\theta  \\\\  & =12\\operatorname{cos}⁡({150}^{∘}) \\\\  & =12\\cdot (-\\frac{\\sqrt{3}}{2}) \\\\  & =-6\\sqrt{3}\\end{aligned}\n$$\n\nNow, we find the unit vector that is parallel to $p:$\n\n$$\nu=\\frac{p}{|\\,p\\,|}=\\frac{p}{6}=\\frac{1}{6}p\n$$\n\nFinally, we compute the vector projection as follows:\n\n$$\n\\begin{aligned}{\\text{proj}}_{p}\\,q & ={\\text{comp}}_{p}\\,q\\cdot u \\\\  & =-6\\sqrt{3}\\cdot \\frac{1}{6}p \\\\  & =-\\sqrt{3}\\,p\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186292819 :knowledge-point/_questions [{:db/id #edb/ref 17592186105702 :knowledge-point/id #uuid "c0670172-77cb-5e88-b78d-e5136c06095f" :knowledge-point/title "Calculating a Vector Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fa3959e7-ca33-5acf-a6cf-f267cb63475e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{35}{6}" :db/id #edb/ref 17592186291690}] :answer-field/correct {:answer/id #uuid "fa3959e7-ca33-5acf-a6cf-f267cb63475e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{35}{6}" :db/id #edb/ref 17592186291690} :answer-field/id #uuid "9b113c34-2311-54bb-bf1f-11b551f7aa45" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292223} {:answer-field/choices [{:answer/id #uuid "ac755772-1947-55d1-bc7c-3b4a2e53867f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186291381}] :answer-field/correct {:answer/id #uuid "ac755772-1947-55d1-bc7c-3b4a2e53867f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186291381} :answer-field/id #uuid "da2a0174-d88a-56f7-b6e0-339f231e7e5c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292404} {:answer-field/choices [{:answer/id #uuid "18f781fd-078c-5a13-9573-4167cc2f14db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{6}" :db/id #edb/ref 17592186290736}] :answer-field/correct {:answer/id #uuid "18f781fd-078c-5a13-9573-4167cc2f14db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{6}" :db/id #edb/ref 17592186290736} :answer-field/id #uuid "e4557e04-739e-5823-b70d-ae16ef1fc898" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292447}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8ee08ada-f17a-5d9d-bb05-4496819bf14c" :question/math-academy-id "q-275230" :question/problem "Let $c=⟨2,-1,6⟩$ and $d=⟨4,-2,10⟩.$ Find the vector projection of $c$ onto $d.$\n\n${\\text{proj}}_{d}\\,c=⟨$\n{{field-1}}$,$\n{{field-2}}$,$\n{{field-3}}\n$⟩$" :question/worked-solution "Using the formula for the vector projection, we obtain \n\n$$\n\\begin{aligned}{\\text{proj}}_{d}\\,c & =\\frac{c\\cdot d}{d\\cdot d}d \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{{d}_{x}^{2}+{d}_{y}^{2}+{d}_{z}^{2}}d \\\\  & =\\frac{2\\cdot 4+(-1)\\cdot (-2)+6\\cdot 10}{{4}^{2}+(-2)^{2}+{10}^{2}}d \\\\  & =\\frac{70}{120}⟨4,-2,10⟩ \\\\  & =\\frac{7}{12}⟨4,-2,10⟩ \\\\  & =⟨\\,\\frac{7}{3},-\\frac{7}{6},\\frac{35}{6}\\,⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186292820 :knowledge-point/_questions [{:db/id #edb/ref 17592186105702 :knowledge-point/id #uuid "c0670172-77cb-5e88-b78d-e5136c06095f" :knowledge-point/title "Calculating a Vector Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d029c569-b520-5b3c-a72a-fb4ef4d1fea0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186291516}] :answer-field/correct {:answer/id #uuid "d029c569-b520-5b3c-a72a-fb4ef4d1fea0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186291516} :answer-field/id #uuid "0d66a8c4-9342-5870-88b3-245cb66f33ff" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291782} {:answer-field/choices [{:answer/id #uuid "f06e4169-e64b-5f9b-8b62-9dc8a75a2ac5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186291639}] :answer-field/correct {:answer/id #uuid "f06e4169-e64b-5f9b-8b62-9dc8a75a2ac5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186291639} :answer-field/id #uuid "329d55a6-d9be-5643-871f-62ecefd59610" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291904} {:answer-field/choices [{:answer/id #uuid "44e3a3d6-7689-5f57-9959-a554afb84e93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186290916}] :answer-field/correct {:answer/id #uuid "44e3a3d6-7689-5f57-9959-a554afb84e93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186290916} :answer-field/id #uuid "3a8e08a3-ed4a-5cce-adbf-982c383621fc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291928}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "80af0a0d-1b5c-5754-8cc0-c3ba2a8239c6" :question/math-academy-id "q-275231" :question/problem "Let $c=\\begin{bmatrix}-2 \\\\ 8 \\\\ -1\\end{bmatrix}$ and $d=\\begin{bmatrix}-1 \\\\ 3 \\\\ -2\\end{bmatrix}.$ Find the vector projection of $c$ onto $d.$\n\n${\\text{proj}}_{d}\\,c=⟨$  \n\n{{field-1}},\n\n{{field-2}},\n\n{{field-3}}\n\n$⟩$" :question/worked-solution "Using the formula for the vector projection, we obtain\n\n$$\n\\begin{aligned}{\\text{proj}}_{d}\\,c & =\\frac{c\\cdot d}{d\\cdot d}d \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{{d}_{x}^{2}+{d}_{y}^{2}+{d}_{z}^{2}}d \\\\  & =\\frac{(-2)\\cdot (-1)+8\\cdot 3+(-1)\\cdot (-2)}{(-1)^{2}+{3}^{2}+(-2)^{2}}d \\\\  & =\\frac{28}{14}⟨-1,3,-2⟩ \\\\  & =2⟨-1,3,-2⟩ \\\\  & =⟨-2,6,-4⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297480 :knowledge-point/_questions [{:db/id #edb/ref 17592186105701 :knowledge-point/id #uuid "7c9317eb-d1ce-5f42-b69b-a37e643b865b" :knowledge-point/title "Calculating a Vector Projection Using Angle and Magnitude"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "563dad36-6b94-5115-a57a-7ed69e7beda4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186295767}] :answer-field/correct {:answer/id #uuid "563dad36-6b94-5115-a57a-7ed69e7beda4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186295767} :answer-field/id #uuid "fcb2fd8e-6775-59e6-84bb-a5fbb95d6899" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186297152}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7177af1c-e318-563b-be13-170617488953" :question/math-academy-id "q-316441" :question/problem "Suppose that $|\\,a\\,|=4$, $|\\,b\\,|=8\\sqrt{2}$ and that the angle between the vectors is $\\theta =\\frac{\\pi }{4}.$ Find the vector projection of $b$ onto $a$ in terms of the vector $a.$\n\n${\\text{proj}}_{a}\\,b=$\n{{field-1}}\n$a$" :question/worked-solution "First, we find the scalar projection as follows:\n\n$$\n\\begin{aligned}{\\text{comp}}_{a}\\,b & =|\\,b\\,|\\operatorname{cos}⁡\\theta  \\\\  & =8\\sqrt{2}\\operatorname{cos}⁡(\\frac{\\pi }{4}) \\\\  & =8\\sqrt{2}\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =8\\end{aligned}\n$$\n\nNow, we find the unit vector that is parallel to $a:$\n\n$$\nu=\\frac{a}{|\\,a\\,|}=\\frac{a}{4}=\\frac{1}{4}a\n$$\n\nFinally, we compute the vector projection as follows:\n\n$$\n\\begin{aligned}{\\text{proj}}_{a}\\,b & ={\\text{comp}}_{a}\\,b\\cdot u \\\\  & =8\\cdot \\frac{1}{4}a \\\\  & =2\\,a\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186374631 :knowledge-point/_questions [{:db/id #edb/ref 17592186105702 :knowledge-point/id #uuid "c0670172-77cb-5e88-b78d-e5136c06095f" :knowledge-point/title "Calculating a Vector Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8f333a3f-92b4-531b-a615-97055df65ca7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{6}" :db/id #edb/ref 17592186374633}] :answer-field/correct {:answer/id #uuid "8f333a3f-92b4-531b-a615-97055df65ca7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{6}" :db/id #edb/ref 17592186374633} :answer-field/id #uuid "defc6efe-7076-53c8-8492-a9e006d24954" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186374632} {:answer-field/choices [{:answer/id #uuid "48a814b4-77b9-5721-a3d0-e270d4f1412f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186374635}] :answer-field/correct {:answer/id #uuid "48a814b4-77b9-5721-a3d0-e270d4f1412f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186374635} :answer-field/id #uuid "7b46cd57-06c8-5ecc-91ce-971c22dd4862" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186374634} {:answer-field/choices [{:answer/id #uuid "5c065116-a584-5b96-86fa-4d407d495463" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186374637}] :answer-field/correct {:answer/id #uuid "5c065116-a584-5b96-86fa-4d407d495463" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186374637} :answer-field/id #uuid "e93e7207-d328-5919-b73b-1633d8842ab5" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186374636}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2164a799-31ad-56a9-8be4-781b4e5fe20f" :question/math-academy-id "q-316467" :question/problem "Let $c=\\begin{bmatrix}-1 \\\\ 2 \\\\ 5\\end{bmatrix}$ and $d=\\begin{bmatrix}4 \\\\ -3 \\\\ 1\\end{bmatrix}.$ Find the vector projection of $d$ onto $c.$\n\n${\\text{proj}}_{c}\\,d=⟨$  \n\n{{field-1}},\n\n{{field-2}},\n\n{{field-3}}\n\n$⟩$" :question/worked-solution "Using the formula for the vector projection, we obtain \n\n$$\n\\begin{aligned}{\\text{proj}}_{c}\\,d & =\\frac{c\\cdot d}{c\\cdot c}c \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{{c}_{x}^{2}+{c}_{y}^{2}+{c}_{z}^{2}}c \\\\  & =\\frac{(-1)\\cdot 4+2\\cdot (-3)+5\\cdot 1}{(-1)^{2}+{2}^{2}+{5}^{2}}c \\\\  & =\\frac{-4-6+5}{1+4+25}\\,c \\\\  & =-\\frac{5}{30}\\,⟨-1,2,5⟩ \\\\  & =-\\frac{1}{6}\\,⟨-1,2,5⟩ \\\\  & =⟨\\frac{1}{6},-\\frac{1}{3},-\\frac{5}{6}⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299498 :knowledge-point/_questions [{:db/id #edb/ref 17592186105703 :knowledge-point/id #uuid "84c96375-27d5-5ada-a952-34e09b3e92bf" :knowledge-point/title "Perpendicular Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "99bf556e-d7ab-58f2-949b-3b3c7bcf3e17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17}{4}" :db/id #edb/ref 17592186298220}] :answer-field/correct {:answer/id #uuid "99bf556e-d7ab-58f2-949b-3b3c7bcf3e17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17}{4}" :db/id #edb/ref 17592186298220} :answer-field/id #uuid "707541dd-c3d5-53b5-934d-a2bb4e38c66f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299020}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "acca1529-0a90-530c-a184-87524d0fa39b" :question/math-academy-id "q-316777" :question/problem "Let $u=\\begin{bmatrix}4 \\\\ 2 \\\\ -3\\end{bmatrix}$ and $v=\\begin{bmatrix}k \\\\ -1 \\\\ 5\\end{bmatrix}.$ Given that the projection of $u$ onto $v$ is the zero vector, find the value of $k.$\n\n$k=$\n{{field-1}}" :question/worked-solution "Since $u$ is a nonzero vector, its projection onto another nonzero vector $v$ equals the zero vector only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\nu⊥v\\,⟹\\,u\\cdot v=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}u\\cdot v & ={u}_{x}\\cdot {v}_{x}+{u}_{y}\\cdot {v}_{y}+{u}_{z}\\cdot {v}_{z} \\\\  & =4\\cdot k+2\\cdot (-1)+(-3)\\cdot 5 \\\\  & =4k-2-15 \\\\  & =4k-17.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}u\\cdot v & =0 \\\\ 4k-17 & =0 \\\\ 4k & =17 \\\\ k & =\\frac{17}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299635 :knowledge-point/_questions [{:db/id #edb/ref 17592186105702 :knowledge-point/id #uuid "c0670172-77cb-5e88-b78d-e5136c06095f" :knowledge-point/title "Calculating a Vector Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93889542-cdb7-5205-b40e-5de012a35041" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{7}" :db/id #edb/ref 17592186298189}] :answer-field/correct {:answer/id #uuid "93889542-cdb7-5205-b40e-5de012a35041" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{7}" :db/id #edb/ref 17592186298189} :answer-field/id #uuid "2c7d00bc-c7b8-56f2-a2ed-8537aea7acf0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298790} {:answer-field/choices [{:answer/id #uuid "0a47dbd1-9413-50ea-9bd4-8fbefb0c711a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{14}" :db/id #edb/ref 17592186297605}] :answer-field/correct {:answer/id #uuid "0a47dbd1-9413-50ea-9bd4-8fbefb0c711a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{14}" :db/id #edb/ref 17592186297605} :answer-field/id #uuid "5ce79871-b6bd-5948-884a-1ece9351e7e8" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298954} {:answer-field/choices [{:answer/id #uuid "81df3b98-83b4-583c-96b0-c8ced3f78bc0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9}{14}" :db/id #edb/ref 17592186298112}] :answer-field/correct {:answer/id #uuid "81df3b98-83b4-583c-96b0-c8ced3f78bc0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9}{14}" :db/id #edb/ref 17592186298112} :answer-field/id #uuid "d96c6a63-c019-5f74-921c-56bb4cbb21bd" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299377}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "785e36b9-0bdd-5b31-a4f6-b44338195a89" :question/math-academy-id "q-317656" :question/problem "Let $r=⟨2,-1,3⟩$ and $s=⟨5,1,-4⟩.$ Find the vector projection of $s$ onto $r.$\n\n${\\text{proj}}_{r}\\,s=⟨$\n{{field-1}}$,$\n{{field-2}}$,$\n{{field-3}}\n$⟩$" :question/worked-solution "Using the formula for the vector projection, we obtain \n\n$$\n\\begin{aligned}{\\text{proj}}_{r}\\,s & =\\frac{r\\cdot s}{r\\cdot r}r \\\\  & =\\frac{{r}_{x}{s}_{x}+{r}_{y}{s}_{y}+{r}_{z}{s}_{z}}{{r}_{x}^{2}+{r}_{y}^{2}+{r}_{z}^{2}}r \\\\  & =\\frac{2\\cdot 5+(-1)\\cdot 1+3\\cdot (-4)}{{2}^{2}+(-1)^{2}+{3}^{2}}r \\\\  & =\\frac{10-1-12}{4+1+9}⟨2,-1,3⟩ \\\\  & =\\frac{-3}{14}⟨2,-1,3⟩ \\\\  & =⟨\\,-\\frac{3}{7},\\frac{3}{14},-\\frac{9}{14}\\,⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186106479 :knowledge-point/_questions [{:db/id #edb/ref 17592186105703 :knowledge-point/id #uuid "84c96375-27d5-5ada-a952-34e09b3e92bf" :knowledge-point/title "Perpendicular Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "248a72dd-a402-5c0f-8e48-2ce3b6040eef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186336374} {:answer/id #uuid "2e922997-bd25-5e03-a466-fbd72fb6abb0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{3}{\\sqrt{5}},-\\frac{1}{\\sqrt{5}},-\\frac{1}{\\sqrt{5}}⟩" :db/id #edb/ref 17592186336479} {:answer/id #uuid "2e92ca4e-06fe-59d3-ad72-150fe68f9ab5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{3}{\\sqrt{30}},-\\frac{1}{\\sqrt{30}},-\\frac{1}{\\sqrt{30}}⟩" :db/id #edb/ref 17592186336480} {:answer/id #uuid "48c48d4f-0e9a-5529-b0e7-b2c77f2b71ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{1}{\\sqrt{5}},-\\frac{2}{\\sqrt{5}},\\sqrt{5}⟩" :db/id #edb/ref 17592186336708} {:answer/id #uuid "8b95e9ca-1b13-591a-bc9b-fd7becfb5380" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,0,0⟩" :db/id #edb/ref 17592186337296}] :answer-field/correct {:answer/id #uuid "8b95e9ca-1b13-591a-bc9b-fd7becfb5380" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,0,0⟩" :db/id #edb/ref 17592186337296} :answer-field/id #uuid "ad63f8e0-0c7b-5dce-8be2-b42ad65107a0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338597}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ab29d467-5294-537a-b48f-a1d1aefe0cab" :question/math-academy-id "q-71668" :question/problem "Let $a=⟨1,-2,5⟩$ and $b=⟨3,-1,-1⟩.$ Find the vector projection of $a$ onto $b.$" :question/worked-solution "Using the formula for the vector projection, we obtain\n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,a & =\\frac{a\\cdot b}{b\\cdot b}b \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}b \\\\  & =\\frac{1\\cdot 3+(-2)\\cdot (-1)+5\\cdot (-1)}{{3}^{2}+(-1)^{2}+(-1)^{2}}b \\\\  & =\\frac{0}{{3}^{2}+(-1)^{2}+(-1)^{2}}b \\\\  & =⟨0,0,0⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338999 :knowledge-point/_questions [{:db/id #edb/ref 17592186105702 :knowledge-point/id #uuid "c0670172-77cb-5e88-b78d-e5136c06095f" :knowledge-point/title "Calculating a Vector Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10609a14-c18f-5c8f-8f44-594930f12d05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-6,-2,4⟩" :db/id #edb/ref 17592186336187} {:answer/id #uuid "220feec2-e6a3-5fae-babb-bc10abe5fb93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-2,-1,3⟩" :db/id #edb/ref 17592186336351} {:answer/id #uuid "376223b3-4ac9-52de-bb93-20f6dc09e52a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-1,-2,3⟩" :db/id #edb/ref 17592186336548} {:answer/id #uuid "3c3a67a7-de54-58bf-82f6-c6a9783c2cc5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-4,-2,6⟩" :db/id #edb/ref 17592186336600} {:answer/id #uuid "f3a155af-3651-5ac4-b319-902a9d92d4fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-3,-1,2⟩" :db/id #edb/ref 17592186338161}] :answer-field/correct {:answer/id #uuid "220feec2-e6a3-5fae-babb-bc10abe5fb93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-2,-1,3⟩" :db/id #edb/ref 17592186336351} :answer-field/id #uuid "57cfdc56-0116-581a-87da-dd2aa2739049" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338426}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "92cd8b39-bfaa-5790-9494-d4fc7e9f80b8" :question/math-academy-id "q-71834" :question/problem "Let $c=\\begin{bmatrix}2 \\\\ 1 \\\\ -3\\end{bmatrix}$ and $d=\\begin{bmatrix}2 \\\\ -3 \\\\ 5\\end{bmatrix}.$ Find the vector projection of $d$ onto $c.$" :question/worked-solution "Using the formula for the vector projection, we obtain \n\n$$\n\\begin{aligned}{\\text{proj}}_{c}\\,d & =\\frac{c\\cdot d}{c\\cdot c}c \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{{c}_{x}^{2}+{c}_{y}^{2}+{c}_{z}^{2}}c \\\\  & =\\frac{2\\cdot 2+1\\cdot (-3)+(-3)\\cdot 5}{{2}^{2}+{1}^{2}+(-3)^{2}}c \\\\  & =-\\frac{14}{14}⟨2,1,-3⟩ \\\\  & =⟨-2,-1,3⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186106480 :knowledge-point/_questions [{:db/id #edb/ref 17592186105701 :knowledge-point/id #uuid "7c9317eb-d1ce-5f42-b69b-a37e643b865b" :knowledge-point/title "Calculating a Vector Projection Using Angle and Magnitude"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9c46506b-71f4-5dd4-8073-f478001468d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4c" :db/id #edb/ref 17592186105029} {:answer/id #uuid "aa28895b-01c4-5a6a-8497-a8805ff0c18e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}c" :db/id #edb/ref 17592186105030} {:answer/id #uuid "0bd413b9-0ccc-5243-898a-0e04480488f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}c" :db/id #edb/ref 17592186105031} {:answer/id #uuid "371bec7c-71dd-546e-8bff-407c6e758672" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{4}c" :db/id #edb/ref 17592186105032} {:answer/id #uuid "7c124655-5867-56b0-ab0d-79de478b24e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4c" :db/id #edb/ref 17592186105033}] :answer-field/correct {:answer/id #uuid "0bd413b9-0ccc-5243-898a-0e04480488f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}c" :db/id #edb/ref 17592186105031} :answer-field/id #uuid "295493ed-d510-566e-997d-2641481e7989" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186105028}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e48c0a41-451d-5386-8afe-32a1dfe30bdb" :question/math-academy-id "q-71836" :question/problem "Suppose that $|\\,c\\,|=12$, $|\\,d\\,|=6$ and that the angle between the vectors is $\\theta =\\frac{2\\pi }{3}.$ Find the vector projection of $d$ onto $c$ in terms of the vector $c.$" :question/worked-solution "First, we find the scalar projection as follows:\n\n$$\n\\begin{aligned}{\\text{comp}}_{c}\\,d & =|\\,d\\,|\\operatorname{cos}⁡\\theta  \\\\  & =6\\operatorname{cos}⁡(\\frac{2\\pi }{3}) \\\\  & =6\\cdot (-\\frac{1}{2}) \\\\  & =-3\\end{aligned}\n$$\n\nNow, we find the unit vector that is parallel to $c:$\n\n$$\nu=\\frac{c}{|\\,c\\,|}=\\frac{c}{12}=\\frac{1}{12}c\n$$\n\nFinally, we compute the vector projection as follows:\n\n$$\n\\begin{aligned}{\\text{proj}}_{c}\\,d & ={\\text{comp}}_{c}\\,d\\cdot u \\\\  & =(-3)\\cdot \\frac{1}{12}c \\\\  & =-\\frac{1}{4}c\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339003 :knowledge-point/_questions [{:db/id #edb/ref 17592186105703 :knowledge-point/id #uuid "84c96375-27d5-5ada-a952-34e09b3e92bf" :knowledge-point/title "Perpendicular Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13bfd873-a61b-5155-b431-8c1b14ea4c36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186336221} {:answer/id #uuid "412e42a1-2db6-5501-ad19-fcbe27fd4fdc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨6,-6,0⟩" :db/id #edb/ref 17592186336643} {:answer/id #uuid "51e7ab1c-411b-59a1-8a52-3a9ce51542ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,0,0⟩" :db/id #edb/ref 17592186336784} {:answer/id #uuid "5e6152bd-f18c-572a-91e4-d7b32361e50f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{3}{4},-\\frac{3}{4},0⟩" :db/id #edb/ref 17592186336889} {:answer/id #uuid "6ee21505-4187-569d-9cf9-a54bb48141dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-\\frac{3}{2},\\frac{3}{2},0⟩" :db/id #edb/ref 17592186337014}] :answer-field/correct {:answer/id #uuid "51e7ab1c-411b-59a1-8a52-3a9ce51542ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,0,0⟩" :db/id #edb/ref 17592186336784} :answer-field/id #uuid "6a0a4abb-ffe2-5f6f-aa9c-7e45f15fefff" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338463}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3f68a7de-ad0e-5879-b8e6-639b0fddd307" :question/math-academy-id "q-71847" :question/problem "Let $a=-2i-2j+4k$ and $b=2i-2j.$ Find the vector projection of $a$ onto $b.$" :question/worked-solution "Using the formula for the vector projection, we obtain\n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,a & =\\frac{a\\cdot b}{b\\cdot b}b \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}b \\\\  & =\\frac{(-2)\\cdot 2+(-2)\\cdot (-2)+4\\cdot 0}{{2}^{2}+(-2)^{2}+{0}^{2}}b \\\\  & =\\frac{0}{{2}^{2}+(-2)^{2}+{0}^{2}}b \\\\  & =⟨0,0,0⟩.\\end{aligned}\n$$"}]}
