45417] [17592186338999 #edb/ref 1074 "Using the formula for the vector projection, we obtain \n\n$$\n\\begin{aligned}{\\text{proj}}_{c}\\,d & =\\frac{c\\cdot d}{c\\cdot c}c \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{{c}_{x}^{2}+{c}_{y}^{2}+{c}_{z}^{2}}c \\\\  & =\\frac{2\\cdot 2+1\\cdot (-3)+(-3)\\cdot 5}{{2}^{2}+{1}^{2}+(-3)^{2}}c \\\\  & =-\\frac{14}{14}⟨2,1,-3⟩ \\\\  & =⟨-2,-1,3⟩.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186339003 #edb/ref 1068 #edb/ref 17592186338463 #edb/ref 17592186045417] [17592186339003 #edb/ref 1069 "q-71847" #edb/ref 17592186045417] [17592186339003 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186339003 #edb/ref 1071 "Let $a=-2i-2j+4k$ and $b=2i-2j.$ Find the vector projection of $a$ onto $b.$" #edb/ref 17592186045417] [17592186339003 #edb/ref 1072 #uuid "3f68a7de-ad0e-5879-b8e6-639b0fddd307" #edb/ref 17592186045417] [17592186339003 #edb/ref 1074 "Using the formula for the vector projection, we obtain\n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,a & =\\frac{a\\cdot b}{b\\cdot b}b \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}b \\\\  & =\\frac{(-2)\\cdot 2+(-2)\\cdot (-2)+4\\cdot 0}{{2}^{2}+(-2)^{2}+{0}^{2}}b \\\\  & =\\frac{0}{{2}^{2}+(-2)^{2}+{0}^{2}}b \\\\  & =⟨0,0,0⟩.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186374538 #edb/ref 1068 #edb/ref 17592186374539 #edb/ref 17592186045417] [17592186374538 #edb/ref 1069 "q-212464" #edb/ref 17592186045417] [17592186374538 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186374538 #edb/ref 1071 "Let $a=\\begin{bmatrix}-6 \\\\ -3 \\\\ 0\\end{bmatrix}$ and $b=\\begin{bmatrix}-2 \\\\ x \\\\ -3\\end{bmatrix}.$ Given that the projection of $a$ onto $b$ is the zero vector, find the value of $x.$" #edb/ref 17592186045443] [17592186374538 #edb/ref 1072 #uuid "cfdc0ea6-159a-5bd6-ad02-2e0fd2db5b29" #edb/ref 17592186045417] [17592186374538 #edb/ref 1074 "Since $a$ is a nonzero vector, its projection onto another nonzero vector $b$ equals the zero vector only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =-6\\cdot (-2)+(-3)\\cdot x+0\\cdot (-3) \\\\  & =12-3x.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ 12-3x & =0 \\\\ -3x & =-12 \\\\ x & =4.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186374539 #edb/ref 1075 #edb/ref 17592186374540 #edb/ref 17592186045417] [17592186374539 #edb/ref 1075 #edb/ref 17592186374541 #edb/ref 17592186045417] [17592186374539 #edb/ref 1075 #edb/ref 17592186374542 #edb/ref 17592186045417] [17592186374539 #edb/ref 1075 #edb/ref 17592186374543 #edb/ref 17592186045417] [17592186374539 #edb/ref 1075 #edb/ref 17592186374544 #edb/ref 17592186045417] [17592186374539 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186374539 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186374539 #edb/ref 1078 #edb/ref 17592186374543 #edb/ref 17592186045417] [17592186374539 #edb/ref 1079 #uuid "af73e53b-f8ec-53d4-ad2f-688f3fcd26ab" #edb/ref 17592186045417] [17592186374540 #edb/ref 1080 "3" #edb/ref 17592186045417] [17592186374540 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186374540 #edb/ref 1083 #uuid "10a6363d-50b7-53ee-9211-bf98b3b730c4" #edb/ref 17592186045417] [17592186374541 #edb/ref 1080 "2" #edb/ref 17592186045417] [17592186374541 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186374541 #edb/ref 1083 #uuid "6d50033c-ac1e-5bc6-84ee-1d4b187400c2" #edb/ref 17592186045417] [17592186374542 #edb/ref 1080 "1" #edb/ref 17592186045417] [17592186374542 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186374542 #edb/ref 1083 #uuid "2c9d11de-00b2-5f81-bbb0-9e2cfe2d24d2" #edb/ref 175921860454