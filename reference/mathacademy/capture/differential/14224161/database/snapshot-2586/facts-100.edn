5417] [17592186538917 #edb/ref 1075 #edb/ref 17592186538774 #edb/ref 17592186045417] [17592186538917 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186538917 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186538917 #edb/ref 1078 #edb/ref 17592186538298 #edb/ref 17592186045417] [17592186538917 #edb/ref 1079 #uuid "f312c34a-9866-5b7f-a9d8-bf68bba44d49" #edb/ref 17592186045417] [17592186538921 #edb/ref 1075 #edb/ref 17592186538236 #edb/ref 17592186045417] [17592186538921 #edb/ref 1075 #edb/ref 17592186538355 #edb/ref 17592186045417] [17592186538921 #edb/ref 1075 #edb/ref 17592186538474 #edb/ref 17592186045417] [17592186538921 #edb/ref 1075 #edb/ref 17592186538541 #edb/ref 17592186045417] [17592186538921 #edb/ref 1075 #edb/ref 17592186538565 #edb/ref 17592186045417] [17592186538921 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186538921 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186538921 #edb/ref 1078 #edb/ref 17592186538474 #edb/ref 17592186045417] [17592186538921 #edb/ref 1079 #uuid "fc51f3bc-520a-5e97-9ed8-5e68d0470efe" #edb/ref 17592186045417] [17592186538932 #edb/ref 1068 #edb/ref 17592186538863 #edb/ref 17592186045417] [17592186538932 #edb/ref 1069 "q-27743" #edb/ref 17592186045417] [17592186538932 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186538932 #edb/ref 1071 "Given that $\\operatorname{ln}⁡(7x-4)=\\operatorname{ln}⁡(5x+2),$ what is the value of $x?$" #edb/ref 17592186045417] [17592186538932 #edb/ref 1072 #uuid "1e549fe4-3be0-5aa2-9b34-f060b6793b1c" #edb/ref 17592186045417] [17592186538932 #edb/ref 1074 "Since the logarithms on both sides of the equation have the same base, we can equate the arguments. This gives\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡(7x-4) & =\\operatorname{ln}⁡(5x+2) \\\\ 7x-4 & =5x+2 \\\\ 2x & =6 \\\\ x & =3.\\end{aligned}\n$$\n\nLet's now check for extraneous solutions by substituting back into the original equation: \n\n- Substituting $x=3$ back into the original equation, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡(7(3)-4) & \\overset{?}{=}\\operatorname{ln}⁡(5(3)+2) \\\\ \\operatorname{ln}⁡(17) & =\\operatorname{ln}⁡(17)\\,✓\\end{aligned}\n$$\n\nTherefore, $x=3$ is a valid solution." #edb/ref 17592186045417] [17592186538942 #edb/ref 1068 #edb/ref 17592186538921 #edb/ref 17592186045417] [17592186538942 #edb/ref 1069 "q-79872" #edb/ref 17592186045417] [17592186538942 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186538942 #edb/ref 1071 "Solve the equation $\\operatorname{ln}⁡({x}^{2}-2)=\\operatorname{ln}⁡(-x+4).$" #edb/ref 17592186045417] [17592186538942 #edb/ref 1072 #uuid "325f155d-1090-569d-9381-79bbdc699aa8" #edb/ref 17592186045417] [17592186538942 #edb/ref 1074 "Since the logarithms on both sides of the equation have the same base, we can equate the arguments. This gives\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({x}^{2}-2) & =\\operatorname{ln}⁡(-x+4) \\\\ {x}^{2}-2 & =-x+4 \\\\ {x}^{2}+x-6 & =0 \\\\ (x+3)(x-2) & =0 \\\\ x & =-3,2.\\end{aligned}\n$$\n\nLet's now check for extraneous solutions by substituting back into the original equation:\n\n- Substituting $x=-3$ back into the original equation, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({x}^{2}-2) & \\overset{?}{=}\\operatorname{ln}⁡(-x+4) \\\\ \\operatorname{ln}⁡((-3)^{2}-2) & \\overset{?}{=}\\operatorname{ln}⁡(-(-3)+4) \\\\ \\operatorname{ln}⁡(7) & =\\operatorname{ln}⁡(7).\\,✓\\end{aligned}\n$$\n\nTherefore, $x=-3$ is a valid solution.\n\n- Substituting $x=2$ back into the original equation, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({x}^{2}-2) & \\overset{?}{=}\\operatorname{ln}⁡(-x+4) \\\\ \\operatorname{ln}⁡((2)^{2}-2) & \\overset{?}{=}\\operatorname{ln}⁡(-(2)+4) \\\\ \\operatorname{ln}⁡(2) & =\\operatorname{ln}⁡(2).\\,✓\\end{aligned}\n$$\n\nTherefore, $x=2$ is a valid solution.\n\nTherefore, the correct answer is $x=-3,2.$" #edb/ref 17592186045417] [17592186538951 #edb/ref 1068 #edb/ref 17592186538894 #edb/ref 17592186045417] [17592186538951 #edb/ref 1069 "q-27725" #edb/ref 17592186045417] [17592186538951 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186538951 #edb/ref 1071 "Solve $\\operatorname{log}⁡(2x-1)=\\operatorname{log}⁡(6x+9)$ for $x.$" #edb/ref 17592186045417] [17592186538951 #edb/ref 1072 #uuid "41f4ba90-bf6f-5f13-ae98-77405268cba9" #edb/ref 17592186045417] [17592186538951 #edb/ref 1074 "Since the logarithms on both sides of the equation have the same base, we can equate the arguments. This gives\n\n$$\n\\begin{aligned}\\operatorname{log}⁡(2x-1) & =\\operatorname{log}⁡(6x+9) \\\\ 2x-1 & =6x+9 \\\\ 4x & =-10 \\\\ x & =-\\frac{5}{2}.\\end{aligned}\n$$\n\nLet's now check for extraneous solutions by substituting back into the original equation: \n\n- Substituting $x=-\\frac{5}{2}$ back into the original equation, we get\n\n$$\n\\begin{aligned}\\operatorname{log}⁡(2(-\\frac{5}{2})-1) & \\overset{?}{=}\\operatorname{log}⁡(6(-\\frac{5}{2})+9) \\\\ \\operatorname{log}⁡(-6) & \\overset{?}{=}\\operatorname{log}⁡(-6)\\end{aligned}\n$$\n\nHowever, $\\operatorname{log}⁡(-6)$ is not a real number.\n\nTherefore, we conclude that the equation has no real solutions." #edb/ref 17592186045417] [17592186538956 #edb/ref 1068 #edb/ref 17592186538903 #edb/ref 17592186045417] [17592186538956 #edb/ref 1069 "q-100710" #edb/ref 17592186045417] [17592186538956 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186538956 #edb/ref 1071 "If $\\operatorname{ln}⁡({x}^{2}-52)=\\operatorname{ln}⁡(12),$ then what is the value of $x?$" #edb/ref 17592186045417] [17592186538956 #edb/ref 1072 #uuid "5004d37a-89b2-53f7-9b0b-a8e11a406464" #edb/ref 17592186045417] [17592186538956 #edb/ref 1074 "Since the logarithms on both sides of the equation have the same base, we can equate the arguments. This gives\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({x}^{2}-52) & =\\operatorname{ln}⁡(12) \\\\ {x}^{2}-52 & =12 \\\\ {x}^{2} & =64 \\\\ x & =\\pm 8.\\end{aligned}\n$$\n\n \n\nLet's now check for extraneous solutions by substituting back into the original equation: \n\n- Substituting $x=8$ back into the original equation, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({x}^{2}-52) & =\\operatorname{ln}⁡({8}^{2}-52) \\\\  & =\\operatorname{ln}⁡(64-52) \\\\  & =\\operatorname{ln}⁡(12).\\,✓\\end{aligned}\n$$\n\nTherefore, $x=8$ is a valid solution.\n\n- Substituting $x=-8$ back into the original equation, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({x}^{2}-52) & =\\operatorname{ln}⁡((-8)^{2}-52) \\\\  & =\\operatorname{ln}⁡(64-52) \\\\  & =\\operatorname{ln}⁡(12).\\,✓\\end{aligned}\n$$\n\nTherefore, $x=-8$ is a valid solution.\n\nFinally, the correct answer is \"$x=\\pm 8.$\"" #edb/ref 17592186045417] [17592186538984 #edb/ref 1068 #edb/ref 17592186538893 #edb/ref 17592186045417] [17592186538984 #edb/ref 1069 "q-1131" #edb/ref 17592186045417] [17592186538984 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186538984 #edb/ref 1071 "Solve the equation ${log}_{12}⁡({v}^{2}+35)={log}_{12}⁡(-12v-1).$" #edb/ref 17592186045417] [17592186538984 #edb/ref 1072 #uuid "98df2a56-4669-5921-84a6-4e54451b6791" #edb/ref 17592186045417] [17592186538984 #edb/ref 1074 "Since the logarithms on both sides of the equation have the same base, we can equate the arguments. This gives\n\n$$\n\\begin{aligned}{log}_{12}⁡({v}^{2}+35) & ={log}_{12}⁡(-12v-1) \\\\ {v}^{2}+35 & =-12v-1 \\\\ {v}^{2}+12v+36 & =0 \\\\ (v+6)^{2} & =0 \\\\ v & =-6.\\end{aligned}\n$$\n\nLet's now check for extraneous solutions by substituting back into the original equation:\n\n- Substituting $v=-6$ back into the original equation, we get\n\n$$\n\\begin{aligned}{log}_{12}⁡({v}^{2}+35) & \\overset{?}{=}{log}_{12}⁡(-12v-1) \\\\ {log}_{12}⁡((-6)^{2}+35) & \\overset{?}{=}{log}_{12}⁡(-12(-6)-1) \\\\ {log}_{12}⁡(71) & ={log}_{12}⁡(71).\\,✓\\end{aligned}\n$$\n\nTherefore, $v=-6$ is a valid solution." #edb/ref 17592186045417] [17592186538985 #edb/ref 1068 #edb/ref 17592186538910 #edb/ref 17592186045417] [17592186538985 #edb/ref 1069 "q-79867" #edb/ref 17592186045417] [17592186538985 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186538985 #edb/ref 1071 "Solve the equation ${log}_{3}⁡(x+4)=\\frac{1}{2}{log}_{3}⁡(25).$" #edb/ref 17592186045417] [17592186538985 #edb/ref 1072 #uuid "9b0b21ed-9399-541e-870b-dc048c3a5954" #edb/ref 17592186045417] [17592186538985 #edb/ref 1074 "First, we use the power rule to simplify the right-hand side. This gives\n\n$$\n\\begin{aligned}{log}_{3}⁡(x+4) & =\\frac{1}{2}{log}_{3}⁡(25) \\\\ {log}_{3}⁡(x+4) & ={log}_{3}⁡({25}^{1/2}) \\\\ {log}_{3}⁡(x+4) & ={log}_{3}⁡(5).\\end{aligned}\n$$\n\nSince the logarithms on both sides of the equation have the same base, we can equate the arguments. This gives\n\n$$\n\\begin{aligned}{log}_{3}⁡(x+4) & ={log}_{3}⁡(5) \\\\ x+4 & =5 \\\\ x & =1.\\end{aligned}\n$$\n\nLet's now check for extraneous solutions by substituting back into the original equation: \n\n- Substituting $x=1$ back into the original equation, we get\n\n$$\n\\begin{aligned}{log}_{3}⁡(x+4) & ={log}_{3}⁡(1+4) \\\\  & ={log}_{3}⁡(5) \\\\  & =\\frac{1}{2}{log}_{3}⁡(25).\\,✓\\end{aligned}\n$$\n\nTherefore, $x=1$ is a valid solution." #edb/ref 17592186045417] [17592186539000 #edb/ref 1068 #edb/ref 17592186538848 #edb/ref 17592186045417] [17592186539000 #edb/ref 1069 "q-27729" #edb/ref 17592186045417] [17592186539000 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186539000 #edb/ref 1071 "Solve the equation ${log}_{8}⁡({x}^{2}+19x)={log}_{8}⁡(10x-8).$" #edb/ref 17592186045417] [17592186539000 #edb/ref 1072 #uuid "b409a03d-9253-56f1-9515-c6248febada5" #edb/ref 17592186045417] [17592186539000 #edb/ref 1074 "Since the logarithms on both sides of the equation have the same base, we can equate the arguments. This gives\n\n$$\n\\begin{aligned}{log}_{8}⁡({x}^{2}+19x) & ={log}_{8}⁡(10x-8) \\\\ {x}^{2}+19x & =10x-8 \\\\ {x}^{2}+9x+8 & =0 \\\\ (x+1)(x+8) & =0 \\\\ x & =-1,-8.\\end{aligned}\n$$\n\nLet's now check for extraneous solutions by substituting back into the original equation: \n\n- Substituting $x=-1$ back into the original equation, we get\n\n$$\n\\begin{aligned}{log}_{8}⁡({x}^{2}+19x) & \\overset{?}{=}{log}_{8}⁡(10x-8) \\\\ {log}_{8}⁡((-1)^{2}+19(-1)) & \\overset{?}{=}{log}_{8}⁡(10(-1)-8) \\\\ {log}_{8}⁡(-18) & \\overset{?}{=}{log}_{8}⁡(-18)\\,\\times \\end{aligned}\n$$\n\nwhich is not valid because ${log}_{8}⁡(-18)$ is undefined. Therefore, $x=-1$ is not a valid solution.\n\n- Substituting $x=-8$ back into the original equation, we get\n\n$$\n\\begin{aligned}{log}_{8}⁡({x}^{2}+19x) & \\overset{?}{=}{log}_{8}⁡(10x-8) \\\\ {log}_{8}⁡((-8)^{2}+19(-8)) & \\overset{?}{=}{log}_{8}⁡(10(-8)-8) \\\\ {log}_{8}⁡(-88) & \\overset{?}{=}{log}_{8}⁡(-88)\\,\\times \\end{aligned}\n$$\n\nwhich is not valid because ${log}_{8}⁡(-88)$ is undefined. Therefore, $x=-8$ is not a valid solution.\n\nTherefore, the correct answer is \"No solutions.\"" #edb/ref 17592186045417] [17592186539009 #edb/ref 1068 #edb/ref 17592186538890 #edb/ref 17592186045417] [17592186539009 #edb/ref 1069 "q-100713" #edb/ref 17592186045417] [17592186539009 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186539009 #edb/ref 1071 "If $\\operatorname{ln}⁡({x}^{2}-56)=\\operatorname{ln}⁡(65),$ then what is the value of $x?$" #edb/ref 17592186045417] [17592186539009 #edb/ref 1072 #uuid "c6d686ab-e99a-50e7-9f05-fa963ea40c5a" #edb/ref 17592186045417] [17592186539009 #edb/ref 1074 "Since the logarithms on both sides of the equation have the same base, we can equate the arguments. This gives\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({x}^{2}-56) & =\\operatorname{ln}⁡(65) \\\\ {x}^{2}-56 & =65 \\\\ {x}^{2} & =121 \\\\ x & =\\pm 11\\end{aligned}\n$$\n\n \n\nLet's now check for extraneous solutions by substituting back into the original equation: \n\n- Substituting $x=11$ back into the original equation, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({x}^{2}-56) & =\\operatorname{ln}⁡({11}^{2}-56) \\\\  & =\\operatorname{ln}⁡(121-56) \\\\  & =\\operatorname{ln}⁡(65).\\,✓\\end{aligned}\n$$\n\nTherefore, $x=11$ is a valid solution.\n\n- Substituting $x=-11$ back into the original equation, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({x}^{2}-56) & =\\operatorname{ln}⁡((-11)^{2}-56) \\\\  & =\\operatorname{ln}⁡(121-56) \\\\  & =\\operatorname{ln}⁡(65).\\,✓\\end{aligned}\n$$\n\nTherefore, $x=-11$ is a valid solution.\n\nFinally, the correct answer is \"$x=\\pm 11.$\"" #edb/ref 17592186045417] [17592186539022 #edb/ref 1068 #edb/ref 17592186538896 #edb/ref 17592186045417] [17592186539022 #edb/ref 1069 "q-100773" #edb/ref 17592186045417] [17592186539022 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186539022 #edb/ref 1071 "Solve the equation ${log}_{2}⁡({x}^{2}+7)={log}_{2}⁡(2{x}^{2}+8).$" #edb/ref 17592186045417] [17592186539022 #edb/ref 1072 #uuid "ecdce78b-6ad1-5fcc-9999-f701ae74931a" #edb/ref 17592186045417] [17592186539022 #edb/ref 1074 "Since the logarithms on both sides of the equation have the same base, we can equate the arguments. This gives\n\n$$\n\\begin{aligned}{log}_{2}⁡({x}^{2}+7) & ={log}_{2}⁡(2{x}^{2}+8) \\\\ {x}^{2}+7 & =2{x}^{2}+8 \\\\ {x}^{2} & =-1.\\end{aligned}\n$$\n\nThe equation ${x}^{2}=-1$ has no real solutions. Therefore, our original logarithmic equation has no solutions either." #edb/ref 17592186045417]}
