}A,\\,$ where $R=[-2,2]\\times [-3,3]$\n\nIII. ${∬}_{D}x\\operatorname{sin}⁡y\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\\,$ where $R=[-1,1]\\times [-2,2]$\n\nSelect all that apply." :question/worked-solution "Notice that if $R$ covers $D$ completely and we define \n\n$$\nf(x,y)=\\{\\begin{aligned}x\\operatorname{sin}⁡y, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\nwe obtain\n\n$$\n{∬}_{D}x\\operatorname{sin}⁡y\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given statements.\n\n- Statement I is false. The integrals have not been stated correctly with respect to the domains $R$ and $D$ (they have been swapped).\n\n- Statement II is true. The rectangle $R$ covers the region $D$ completely.\n\n- Statement III is false. The rectangle $R$ does not cover the region $D.$\n\nTherefore, the correct answer is \"II only.\""} :step/id #uuid "4e98cf8b-1d7c-55a2-90e4-587c132c726b" :step/next {:db/id #edb/ref 17592186425934}} {:db/id #edb/ref 17592186425933 :step/content {:db/id #edb/ref 17592186354533 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b6df4441-21a2-5303-8fb5-58f8fecb14ae" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186469446} {:answer/id #uuid "ee618263-9395-5352-9720-a6eec6d6ed5d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186469447}] :answer-field/correct {:db/id #edb/ref 17592186469447} :answer-field/id #uuid "4a0c311d-a059-5cd2-bbd6-64c976dac562" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186470335} {:answer-field/choices [{:answer/id #uuid "7bc24ece-33bb-5946-a1eb-10980a715793" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186469448} {:answer/id #uuid "304554bf-f809-5b6e-b9f7-a303c9a307fe" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186469449}] :answer-field/correct {:db/id #edb/ref 17592186469449} :answer-field/id #uuid "31ed207a-f15c-5448-a440-49246efdf212" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186470336} {:answer-field/choices [{:answer/id #uuid "e440f0a5-215d-5ce7-9d8c-a7d55e01e51a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186469450} {:answer/id #uuid "edbee4f2-6785-5059-828c-aec5fd26b060" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186469451}] :answer-field/correct {:db/id #edb/ref 17592186469450} :answer-field/id #uuid "d9570c66-92e3-5a9c-83b5-c9049f7f004a" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186470337}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "fa4fe275-03b1-57bc-8327-4434c307d887" :question/math-academy-id "q-86899" :question/problem "Let $D$ be a finite region enclosed by the curves $y=-|x|+2$ and $y=|x|.$ If $R=[-1,1]\\times [0,2],$ and\n\n$$\n{∬}_{D}({x}^{5}-{y}^{2})\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\n$$\n\nwhich of the following could be the definition of $f(x,y)?$\n\nI. $\\{\\begin{aligned}{x}^{5}-{y}^{2}, & (x,y)\\in D \\\\ 0, & (x,y)\\notin D\\end{aligned}$\n\nII. $\\{\\begin{aligned}{x}^{5}-{y}^{2}, & (x,y)\\in D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}$\n\nIII. $\\{\\begin{aligned}{x}^{5}-{y}^{2}, & (x,y)\\in R \\\\ 0, & (x,y)\\notin R\\end{aligned}$\n\nSelect all that apply." :question/worked-solution "First, let's draw our region $D$ and rectangle $R:$\n\n![](images/f3/f3ffc82025f80c357c06e28fcb091c701d53d84821bebd9d2886cf4972b77028.png)\n\nNotice that the rectangle $R$ contains the region $D$ completely. \n\nNow, if we define $f(x,y)$ to be equal ${x}^{5}-{y}^{2}$ on $D$ and to be equal $0$ outside $D,$ we obtain  \n\n$$\n{∬}_{D}({x}^{5}-{y}^{2})\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\n \n\nWith that in mind, let's examine each of the given functions.\n\n- Functions I and II equal ${x}^{5}-{y}^{2}$ on $D$ and equal $0$ outside $D.$\n\n- We cannot use function III. The function is not identically zero for all points in $R\\,∖D.$ For example, $(x,y)=(1,0)\\in R\\,∖\\,D,$ but the function is nonzero at this point.\n\nTherefore, the correct answer is \"I and II only.\""} :step/id #uuid "65ccb889-1cb9-5b78-a946-1218d327ccf7" :step/next {:db/id #edb/ref 17592186425936}} {:db/id #edb/ref 17592186425934 :step/content {:db/id #edb/ref 17592186425929 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0775b041-2fcc-5161-beb5-80cd60e4af23" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186474960} {:answer/id #uuid "f695d431-d46b-54df-b510-3aea6bbccfdd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186474961}] :answer-field/correct {:db/id #edb/ref 17592186474960} :answer-field/id #uuid "0b9ce56f-633d-52a6-9fe3-5e31c2ec3104" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186475406} {:answer-field/choices [{:answer/id #uuid "2e2c39ea-ff23-5ab6-97b2-01c12343ec12" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186474962} {:answer/id #uuid "7d0dbf92-3cec-57d5-bf09-b54ff477f7e7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186474963}] :answer-field/correct {:db/id #edb/ref 17592186474962} :answer-field/id #uuid "1cfbefaa-3aac-5745-9c77-f042b1776296" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186475407} {:answer-field/choices [{:answer/id #uuid "787b4942-1ca4-5050-825d-4ac096b82f5f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186474964} {:answer/id #uuid "b98f4c53-ec17-539a-b8eb-fcaada4b3fa7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186474965}] :answer-field/correct {:db/id #edb/ref 17592186474965} :answer-field/id #uuid "2f93c2fb-74eb-51e3-8d97-e03de7254f93" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186475408}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1654ded7-c0bc-579c-a9e9-6daa6a1243e7" :question/math-academy-id "q-86894" :question/problem "![](images/5d/5d8f57afa16e99c13e6e36c5544a7c7594da13321bd3d01692a5a296a20953d7.png)\n\nConsider the region $D$ shown above. If $R=[-2,2]\\times [-2,2],$ and\n\n$$\n{∬}_{D}x{e}^{y}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\n$$\n\nwhich of the following could be the definition of $f(x,y)?$\n\nI. $\\{\\begin{aligned}x{e}^{y}, & (x,y)\\in R∖D \\\\ 0, & (x,y)\\in D∖R\\end{aligned}$\n\nII. $\\{\\begin{aligned}x{e}^{y}, & (x,y)\\in R \\\\ 0, & (x,y)\\notin R\\end{aligned}$\n\nIII. $\\{\\begin{aligned}0, & (x,y)\\in R∖D \\\\ x{e}^{y}, & (x,y)\\in D\\end{aligned}$\n\nSelect all that apply." :question/worked-solution "First, let's draw our region $D$ and the rectangle $R:$\n\n![](images/ce/ce9b9f3435a94b3f9f87b195e5b1591c80281b23cfb76ceb8e79cdeec3ae66b0.png)\n\nNotice that the rectangle $R$ contains the region $D$ completely. \n\nNow, if we define $f(x,y)$ to be equal $x{e}^{y}$ on $D$ and to be equal $0$ outside $D,$ we obtain \n\n$$\n{∬}_{D}x{e}^{y}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given functions.\n\n- We cannot use functions I and II. Both of these functions are not identically zero for all points in $R\\,∖D.$ For example, $(x,y)=(2,2)\\in R\\,∖\\,D,$ but the functions are nonzero at this point.\n\n- Function III equals $x{e}^{y}$ on $D$ and equals $0$ outside $D.$\n\nTherefore, the correct answer is \"III only.\""} :step/id #uuid "669eeb99-fe93-5bc0-a8ac-52fd38d35e53" :step/next {:db/id #edb/ref 17592186425935}} {:db/id #edb/ref 17592186425935 :step/content {:db/id #edb/ref 17592186354532 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f4d320e0-ae6e-50fb-9499-96141d8d23cd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186469440} {:answer/id #uuid "13df0eb3-71ad-51e9-9129-0b147ebcf52a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186469441}] :answer-field/correct {:db/id #edb/ref 17592186469441} :answer-field/id #uuid "27947ac9-7b94-54bc-b68f-70dbc5d1a0f7" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186470332} {:answer-field/choices [{:answer/id #uuid "ba2ef83f-94cb-52a9-97c1-2a2dd65d32b0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186469442} {:answer/id #uuid "6e09612b-3ac0-58d8-9cbd-02412a7ecd6f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186469443}] :answer-field/correct {:db/id #edb/ref 17592186469443} :answer-field/id #uuid "597be7b9-557b-5a03-b098-582e28fbabba" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186470333} {:answer-field/choices [{:answer/id #uuid "8546fa73-dcec-50dc-974d-858421123cff" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186469444} {:answer/id #uuid "0bbd1552-1f4e-52a4-a141-e1fb530579a5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186469445}] :answer-field/correct {:db/id #edb/ref 17592186469444} :answer-field/id #uuid "00caafb1-473f-5b30-8fec-fff060993a90" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186470334}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "0b045a52-4215-5bdb-9dcf-5641984e3591" :question/math-academy-id "q-86898" :question/problem "Let $D$ be a finite region enclosed by the curves $y={x}^{2}-1$ and $y=|x|.$ If $R=[-2,2]\\times [-1,2],$ and\n\n$$\n{∬}_{D}\\frac{y}{{x}^{2}+1}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\n$$\n\nwhich of the following could be the definition of $f(x,y)?$\n\nI. $\\{\\begin{aligned}\\frac{y}{{x}^{2}+1}, & (x,y)\\in D \\\\ 0, & (x,y)\\notin D\\end{aligned}$\n\nII. $\\{\\begin{aligned}\\frac{y}{{x}^{2}+1}, & (x,y)\\in D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}$\n\nIII. $\\{\\begin{aligned}\\frac{y}{{x}^{2}+1}, & (x,y)\\in R \\\\ 0, & (x,y)\\notin R\\end{aligned}$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "First, let's draw our region $D$ and rectangle $R:$\n\n![](images/23/23f31619eda46f1e8604695c4056d4c0c5bb8ee1e186b1316151762d5b5c8e59.png)\n\nNotice that the rectangle $R$ contains the region $D$ completely. \n\nNow, if we define $f(x,y)$ to be equal $\\frac{y}{{x}^{2}+1}$ on $D$ and to be equal $0$ outside $D,$ we obtain \n\n$$\n{∬}_{D}\\frac{y}{{x}^{2}+1}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given functions.\n\n- Functions I and II equal $\\frac{y}{{x}^{2}+1}$ on $D$ and equal $0$ outside $D.$\n\n- We cannot use function III. The function is not identically zero for all points in $R\\,∖D.$ For example, $(x,y)=(0,1)\\in R\\,∖\\,D,$ but the function is nonzero at this point.\n\nTherefore, the correct answer is \"I and II only.\""} :step/id #uuid "eedab041-fe80-5aa7-8ce9-3144bd5d6aa6" :step/next {:db/id #edb/ref 17592186425933}} {:db/id #edb/ref 17592186425936 :step/content {:db/id #edb/ref 17592186425931 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e6eef2f-1705-5a9c-bd6f-ce326ab994cb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186453350} {:answer/id #uuid "1a1148f9-565b-5ed6-a20a-300c09389e6d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186453351}] :answer-field/correct {:db/id #edb/ref 17592186453350} :answer-field/id #uuid "2e444938-dc10-56c1-872a-deebe68ed5da" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186454425} {:answer-field/choices [{:answer/id #uuid "988b7db4-ebf6-5468-8780-b1beeb8ee195" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186453352} {:answer/id #uuid "02fb2d7a-770f-5219-9a76-41ff9f0fb874" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186453353}] :answer-field/correct {:db/id #edb/ref 17592186453353} :answer-field/id #uuid "39570068-589a-5da0-8fe4-5a34775ee0bb" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186454426} {:answer-field/choices [{:answer/id #uuid "f7e357a2-e551-5cf6-8fcf-5ea5e81ecbbf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186453354} {:answer/id #uuid "4f50774f-f918-5ee5-90e6-3807acef4736" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186453355}] :answer-field/correct {:db/id #edb/ref 17592186453354} :answer-field/id #uuid "0f26f489-8e77-5de8-9048-273b50f7f444" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186454427}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1c04d4c5-9913-59ea-a83f-46d8bb7c02cf" :question/math-academy-id "q-129893" :question/problem "Let $D$ be a finite region enclosed between the curve $y=-{x}^{2}+2$ and the $x$-axis. If \n\n$$\nf(x,y)=\\{\\begin{aligned}{x}^{2}+3y, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\n \nwhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** ${∬}_{D}({x}^{2}+3y)\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\\,$ where $R=[-1,1]\\times [-1,3]$\n\n- **II.** ${∬}_{D}({x}^{2}+3y)\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\\,$ where $R=[-2,2]\\times [0,2]$\n\n- **III.** ${∬}_{R}({x}^{2}+3y)\\,\\text{d}A={∬}_{D}f(x,y)\\,\\text{d}A,\\,$ where $R=[-3,3]\\times [-4,4]$" :question/worked-solution "First, let's draw our region $D:$\n\n![](images/3b/3bfc135232008824ae0522bcc8454c5f97c2dfd13fb6e333e146a040ccbc1f22.png)\n\nNotice that if $R$ covers $D$ completely and we define \n\n$$\nf(x,y)=\\{\\begin{aligned}({x}^{2}+3y), & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\nwe obtain\n\n$$\n{∬}_{D}({x}^{2}+3y)\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given statements.\n\n- Statements I is false. The rectangle $R$ does not cover the region $D.$\n\n- Statements II is true. The rectangle $R$ covers the region $D$ completely.\n\n- Statement III is false. The integrals have not been stated correctly with respect to the domains $R$ and $D$ (they have been swapped).\n\nTherefore, the correct answer is \"II only.\""} :step/id #uuid "f7de3cb3-0140-51ce-a3e4-58a349b9b853"}] :activity/title "Double Integrals Over Non-Rectangular Domains" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186425910}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186436044} :activity/id #uuid "e225bb36-aed4-51b2-b84b-6230033e0f20" :activity/scope {:db/id #edb/ref 17592186049229 :topic/id #uuid "e52ab899-5fcb-50d2-afee-4830a70f16df" :topic/math-academy-id 2616} :activity/steps [{:db/id #edb/ref 17592186436044 :step/content {:db/id #edb/ref 17592186436042 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26487309-9e4e-5dbd-9e57-01234eabfc31" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186474900} {:answer/id #uuid "68aae1b6-04ef-572e-b9c5-96c3f5e9179c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186474901}] :answer-field/correct {:db/id #edb/ref 17592186474901} :answer-field/id #uuid "bf2d6ce8-aeb5-5176-a8c7-136c08c13913" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186475376} {:answer-field/choices [{:answer/id #uuid "2c5675c8-cac0-545b-a345-f619aa2183f6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186474902} {:answer/id #uuid "9b1747c5-e1de-5207-9ed9-86152c215062" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186474903}] :answer-field/correct {:db/id #edb/ref 17592186474902} :answer-field/id #uuid "db57e0b2-294e-58a2-9b61-4120e9a17ed3" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186475377} {:answer-field/choices [{:answer/id #uuid "a4b1232c-f5a4-5bed-9b25-f23d7be68e84" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186474904} {:answer/id #uuid "c0e4d82f-21a7-54e9-a607-71112812ab73" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186474905}] :answer-field/correct {:db/id #edb/ref 17592186474905} :answer-field/id #uuid "6ced5831-8921-5e8c-977b-762463a84003" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186475378}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "34094a62-379f-5750-81e2-774654924818" :question/math-academy-id "q-80505" :question/problem "Let $D$ be a finite region enclosed by the curve ${x}^{2}+{y}^{2}=1.$ If \n\n$$\nf(x,y)=\\{\\begin{aligned}\\operatorname{sin}⁡(x+y), & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}\\,\\text{and}\\,{∬}_{D}\\operatorname{sin}⁡(x+y)\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\n$$\n\nwhich of the following could be the definition of the rectangular domain $R?$\n\nI. $R=[-1,1]\\times [-1,1]$\n\nII. $R=[-1,1]\\times [0,1]$\n\nIII. $R=[-2,2]\\times [-2,2]$\n\nSelect all that apply." :question/worked-solution "First, let's draw our region $D:$\n\n![](images/c5/c50e0e01d432b1db736fad09dd5f5b82286e981d88586e848d9b57c8a9910eb0.png)\n\nNotice that if $R$ covers $D$ completely and we define \n\n$$\nf(x,y)=\\{\\begin{aligned}\\operatorname{sin}⁡(x+y), & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\nwe obtain\n\n$$\n{∬}_{D}\\operatorname{sin}⁡(x+y)\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given rectangles.\n\n- Rectangle II does not cover the region $D.$\n\n- Rectangles I and III covers the region $D$ completely.\n\nTherefore, the correct answer is \"I and III only.\""} :step/id #uuid "151f4abe-23c3-58b1-8e53-69be8020bff5" :step/next {:db/id #edb/ref 17592186436045}} {:db/id #edb/ref 17592186436045 :step/content {:db/id #edb/ref 17592186348410 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ed782008-d4bb-582f-8807-d4b2a836e6be" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186469182} {:answer/id #uuid "3c54d1e7-ad86-5f47-bd24-54748f29d4fe" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186469183}] :answer-field/correct {:db/id #edb/ref 17592186469183} :answer-field/id #uuid "64ff9acc-15fa-5b35-b5c4-b8f3bf78db99" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186470203} {:answer-field/choices [{:answer/id #uuid "50e43c3e-49bc-5747-bc7d-86c7f947be32" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186469184} {:answer/id #uuid "fb0c42e5-292e-59b3-96a8-e42c0ec855e3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186469185}] :answer-field/correct {:db/id #edb/ref 17592186469184} :answer-field/id #uuid "5bb45f02-d2af-5280-a109-2bf63fa0482d" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186470204} {:answer-field/choices [{:answer/id #uuid "89749230-2ffe-51eb-8434-4cccec8af5aa" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186469186} {:answer/id #uuid "95c596d5-e2a4-574b-bae8-8587629e2bba" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186469187}] :answer-field/correct {:db/id #edb/ref 17592186469187} :answer-field/id #uuid "07159f59-7f7d-59a7-b2fb-4d5e3b43d7d4" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186470205}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3b7813ca-41d9-58f5-aaf1-c07ba10ad235" :question/math-academy-id "q-80540" :question/problem "![](images/50/506a298041a875549ec60c5cf99ebdbeb5ca4b5717037083fa6ca196fce27279.png)\n\nConsider the region $D$ shown above. If $R=[-2,2]\\times [0,3],$ and\n\n$$\n{∬}_{D}\\frac{2x+y}{y}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\n$$\n\nwhich of the following could be the definition of $f(x,y)?$\n\nI. $\\{\\begin{aligned}\\frac{2x+y}{y}, & (x,y)\\in D \\\\ 0, & (x,y)\\notin D\\end{aligned}$\n\nII. $\\{\\begin{aligned}0, & (x,y)\\in R \\\\ \\frac{2x+y}{y}, & (x,y)\\in D∖R\\end{aligned}$\n\nIII. $\\{\\begin{aligned}\\frac{2x+y}{y}, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}$\n\nSelect all that apply." :question/worked-solution "First, let's draw our region $D$ and rectangle $R:$\n\n![](images/d2/d2b5c55b15f594680e8f299899d690cd1d92baa1ebef31ce5c79af52afec631e.png)\n\nNotice that the rectangle $R$ contains the region $D$ completely. \n\nNow, if we define $f(x,y)$ to be equal $\\frac{2x+y}{y}$ on $D$ and to be equal $0$ outside $D,$ we obtain\n\n$$\n{∬}_{D}\\frac{2x+y}{y}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given functions.\n\n- We cannot use function II. Since $D∖R$ is empty, the function $f(x,y)$ will be identical to zero for all points in $R,$ including $D.$ But $\\frac{2x+y}{y}$ is not zero, for example, at $(x,y)=(0,2)\\in D.$\n\n- Functions I and III equals $\\frac{2x+y}{y}$ on $D$ and equals $0$ outside $D.$\n\nTherefore, the correct answer is \"I and III only.\""} :step/id #uuid "36b5039d-7687-54cd-9c71-0a7c40931970" :step/next {:db/id #edb/ref 17592186436046}} {:db/id #edb/ref 17592186436046 :step/content {:db/id #edb/ref 17592186436043 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f989fd68-acf4-556b-8204-a65874853b0e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186474954} {:answer/id #uuid "61629148-80cc-5f27-9e85-9aef3674ddb5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186474955}] :answer-field/correct {:db/id #edb/ref 17592186474954} :answer-field/id #uuid "88f9ef63-a2d3-5377-8a45-034749a64a60" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186475403} {:answer-field/choices [{:answer/id #uuid "287515a8-f582-5ab7-b753-5427943347a0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186474956} {:answer/id #uuid "f0506c84-e3a0-5e51-8551-816cb0bfb600" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186474957}] :answer-field/correct {:db/id #edb/ref 17592186474957} :answer-field/id #uuid "9792e7d3-778a-5703-9384-b40fab189daf" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186475404} {:answer-field/choices [{:answer/id #uuid "48c73456-60c2-5847-b039-d9f5820e7f93" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186474958} {:answer/id #uuid "e3c1d1ec-df43-5584-85d8-8a2f435d0d68" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186474959}] :answer-field/correct {:db/id #edb/ref 17592186474958} :answer-field/id #uuid "ab8930af-c48d-56c7-b380-3a5e38859878" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186475405}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f7e910b3-a1a9-5ea8-8009-6cb31a154137" :question/math-academy-id "q-86864" :question/problem "![](images/bb/bbc1bc7b3bb910ffbd13571283bbfa305404d13eb2cb3b5ab423a1c02e46ab86.png)\n\nConsider the region $D$ shown above. If \n\n$$\nf(x,y)=\\{\\begin{aligned}y({x}^{2}-{y}^{2}) & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\n \nwhich of the following statements are true? \n\nI. ${∬}_{R}y({x}^{2}-{y}^{2})\\,\\text{d}A={∬}_{D}f(x,y)\\,\\text{d}A,\\,$ where $R=[-1,1]\\times [0,2]$\n\nII. ${∬}_{D}y({x}^{2}-{y}^{2})\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\\,$ where $R=[-2,2]\\times [-3,2]$\n\nIII. ${∬}_{D}y({x}^{2}-{y}^{2})\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\\,$ where $R=[-1,2]\\times [-2,2]$\n\nSelect all that apply." :question/worked-solution "Notice that if $R$ covers $D$ completely and we define \n\n$$\nf(x,y)=\\{\\begin{aligned}y({x}^{2}-{y}^{2}), & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\nwe obtain\n\n$$\n{∬}_{D}y({x}^{2}-{y}^{2})\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given statements.\n\n- Statement I is false. The integrals have not been stated correctly with respect to the domains $R$ and $D$ (they have been swapped).\n\n- Statement II is true. The rectangle $R$ covers the region $D$ completely.\n\n- Statement III is false. The rectangle $R$ does not cover the region $D.$\n\nTherefore, the correct answer is \"II only.\""} :step/id #uuid "8d37cf97-1bdd-5ae3-a97c-0f1ffc62d78b"}] :activity/title "Double Integrals Over Non-Rectangular Domains" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186436029}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186482626} :activity/id #uuid "0c2621c9-fca8-5e71-80e1-32bcc7c2b629" :activity/scope {:db/id #edb/ref 17592186049229 :topic/id #uuid "e52ab899-5fcb-50d2-afee-4830a70f16df" :topic/math-academy-id 2616} :activity/steps [{:db/id #edb/ref 17592186482625 :step/content {:db/id #edb/ref 17592186482597 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "040b0f42-7c9b-56eb-b6be-621b67822865" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186481778} {:answer/id #uuid "0e4b6a27-3956-5728-98e5-4951488d4928" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186481806} {:answer/id #uuid "16817ae5-5f38-5dd6-a4f9-252084ee3df2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186481837} {:answer/id #uuid "2cb42234-9f6f-50f6-b70b-14633db426c1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186481888} {:answer/id #uuid "d093b965-6d59-5136-ba07-f06c5e2040b5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186482273}] :answer-field/correct {:db/id #edb/ref 17592186481837} :answer-field/id #uuid "6e63f712-8c7c-524e-90a0-bc57875864f3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186482435}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d267d682-18e1-5263-9cb3-12f52098c9f0" :question/math-academy-id "q-86895" :question/problem "![](images/f5/f5f6dae762414eb327b9eae9e5445ef1916e9efc0e17c1316339bbeb416ec94e.png)\n\nConsider the region $D$ shown above. If $R=[-2,2]\\times [-2,2],$ and\n\n$$\n{∬}_{D}(y-x)\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\n$$\n\nwhich of the following could be the definition of $f(x,y)?$\n\nI. $\\{\\begin{aligned}y-x, & (x,y)\\in R \\\\ 0, & (x,y)\\notin R\\end{aligned}$\n\nII. $\\{\\begin{aligned}0, & (x,y)\\in R∖D \\\\ y-x, & (x,y)\\in D\\end{aligned}$\n\nIII. $\\{\\begin{aligned}y-x, & (x,y)\\in R∖D, \\\\ 0, & (x,y)\\in D∖R\\end{aligned}$" :question/worked-solution "First, let's draw our region $D$ and the rectangle $R:$\n\n![](images/97/976dc1b0a7298c5cf0a331acb00594c8e4c74a14b6df3fc18f7e7997db2956c4.png)\n\nNotice that the rectangle $R$ contains the region $D$ completely. \n\nNow, if we define $f(x,y)$ to be equal $y-x$ on $D$ and to be equal $0$ outside $D,$ we obtain\n\n$$\n{∬}_{D}(y-x)\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given functions.\n\n- We cannot use functions I and III. Both of these functions are not identically zero for all points in $R\\,∖D.$ For example, $(x,y)=(2,0)\\in R\\,∖\\,D,$ but the functions are nonzero at this point.\n\n- Function II equals $y-x$ on $D$ and equals $0$ outside $D.$\n\nTherefore, the correct answer is \"II only.\""} :step/id #uuid "186a0fbc-5b23-5be4-8814-746a9a9a5c7c"} {:db/id #edb/ref 17592186482626 :step/content {:db/id #edb/ref 17592186482584 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "082aacc4-affa-5540-8731-03749c801007" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186481787} {:answer/id #uuid "418a7860-4a6f-515d-a959-667a76f75c87" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186481936} {:answer/id #uuid "95d04760-a4c8-5276-a4e8-6b9eb0e6763a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186482127} {:answer/id #uuid "e34df759-bc0a-51b2-ad62-1b6a95b769d5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186482314} {:answer/id #uuid "f7a0c571-503d-5fe4-884d-519e3a27a77e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186482361}] :answer-field/correct {:db/id #edb/ref 17592186482314} :answer-field/id #uuid "af4d3735-879f-5545-9728-93257a5ef240" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186482470}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "b79622ff-7b5d-5073-9074-7493234a4c4c" :question/math-academy-id "q-80541" :question/problem "Let $D$ be a finite region enclosed by the curves $y=2{x}^{2}+1$ and $y=3.$ If $R=[-1,1]\\times [1,3],$ and\n\n$$\n{∬}_{D}(\\operatorname{cos}⁡x-\\operatorname{sin}⁡y)\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\n$$\n\nwhich of the following could be the definition of $f(x,y)?$\n\nI. $\\{\\begin{aligned}\\operatorname{cos}⁡x-\\operatorname{sin}⁡y, & (x,y)\\in D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}$\n\nII. $\\{\\begin{aligned}\\operatorname{cos}⁡x-\\operatorname{sin}⁡y, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}$\n\nIII. $\\{\\begin{aligned}\\operatorname{cos}⁡x-\\operatorname{sin}⁡y, & (x,y)\\in R∖D \\\\ 0, & (x,y)\\in D\\end{aligned}$" :question/worked-solution "First, let's draw our region $D$ and rectangle $R:$\n\n![](images/1c/1ca0b430b798a6dc85fd2b731a93690f79bb2c45b33bbe6f31a5618a2ce0888a.png)\n\nNotice that the rectangle $R$ contains the region $D$ completely. \n\nNow, if we define $f(x,y)$ to be equal $\\operatorname{cos}⁡x-\\operatorname{sin}⁡y$ on $D$ and to be equal $0$ outside $D,$ we obtain\n\n$$\n{∬}_{D}(\\operatorname{cos}⁡x-\\operatorname{sin}⁡y)\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given functions.\n\n- Functions I and II equal $\\operatorname{cos}⁡x-\\operatorname{sin}⁡y$ on $D$ and equal $0$ outside $D.$\n\n- We cannot use function III. The function is not identically zero for all points in $R\\,∖D.$ For example, $(x,y)=(1,1)\\in R\\,∖\\,D,$ but the function is nonzero at this point.\n\nTherefore, the correct answer is \"I and II only.\""} :step/id #uuid "1b5af6dc-d98b-5c64-b233-11f3ee5e3995" :step/next {:db/id #edb/ref 17592186482634}} {:db/id #edb/ref 17592186482631 :step/content {:db/id #edb/ref 17592186425929 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0775b041-2fcc-5161-beb5-80cd60e4af23" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186474960} {:answer/id #uuid "f695d431-d46b-54df-b510-3aea6bbccfdd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186474961}] :answer-field/correct {:db/id #edb/ref 17592186474960} :answer-field/id #uuid "0b9ce56f-633d-52a6-9fe3-5e31c2ec3104" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186475406} {:answer-field/choices [{:answer/id #uuid "2e2c39ea-ff23-5ab6-97b2-01c12343ec12" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186474962} {:answer/id #uuid "7d0dbf92-3cec-57d5-bf09-b54ff477f7e7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186474963}] :answer-field/correct {:db/id #edb/ref 17592186474962} :answer-field/id #uuid "1cfbefaa-3aac-5745-9c77-f042b1776296" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186475407} {:answer-field/choices [{:answer/id #uuid "787b4942-1ca4-5050-825d-4ac096b82f5f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186474964} {:answer/id #uuid "b98f4c53-ec17-539a-b8eb-fcaada4b3fa7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186474965}] :answer-field/correct {:db/id #edb/ref 17592186474965} :answer-field/id #uuid "2f93c2fb-74eb-51e3-8d97-e03de7254f93" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186475408}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1654ded7-c0bc-579c-a9e9-6daa6a1243e7" :question/math-academy-id "q-86894" :question/problem "![](images/5d/5d8f57afa16e99c13e6e36c5544a7c7594da13321bd3d01692a5a296a20953d7.png)\n\nConsider the region $D$ shown above. If $R=[-2,2]\\times [-2,2],$ and\n\n$$\n{∬}_{D}x{e}^{y}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\n$$\n\nwhich of the following could be the definition of $f(x,y)?$\n\nI. $\\{\\begin{aligned}x{e}^{y}, & (x,y)\\in R∖D \\\\ 0, & (x,y)\\in D∖R\\end{aligned}$\n\nII. $\\{\\begin{aligned}x{e}^{y}, & (x,y)\\in R \\\\ 0, & (x,y)\\notin R\\end{aligned}$\n\nIII. $\\{\\begin{aligned}0, & (x,y)\\in R∖D \\\\ x{e}^{y}, & (x,y)\\in D\\end{aligned}$\n\nSelect all that apply." :question/worked-solution "First, let's draw our region $D$ and the rectangle $R:$\n\n![](images/ce/ce9b9f3435a94b3f9f87b195e5b1591c80281b23cfb76ceb8e79cdeec3ae66b0.png)\n\nNotice that the rectangle $R$ contains the region $D$ completely. \n\nNow, if we define $f(x,y)$ to be equal $x{e}^{y}$ on $D$ and to be equal $0$ outside $D,$ we obtain \n\n$$\n{∬}_{D}x{e}^{y}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given functions.\n\n- We cannot use functions I and II. Both of these functions are not identically zero for all points in $R\\,∖D.$ For example, $(x,y)=(2,2)\\in R\\,∖\\,D,$ but the functions are nonzero at this point.\n\n- Function III equals $x{e}^{y}$ on $D$ and equals $0$ outside $D.$\n\nTherefore, the correct answer is \"III only.\""} :step/id #uuid "3cccf520-8b64-5626-8769-b89d045f3205" :step/next {:db/id #edb/ref 17592186482625}} {:db/id #edb/ref 17592186482634 :step/content {:db/id #edb/ref 17592186348413 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9cac20f8-0c6e-5c22-96f1-a90b74e7288e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186451783} {:answer/id #uuid "af9d918d-056c-5cbe-8563-756d169831c4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186451784}] :answer-field/correct {:db/id #edb/ref 17592186451784} :answer-field/id #uuid "a1801346-2b7f-5c0e-bf2e-14d91b77c360" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186452739} {:answer-field/choices [{:answer/id #uuid "20c1183a-c815-569d-9d59-4ac828f44466" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186451785} {:answer/id #uuid "230098a1-56a8-5b70-85a0-677dd17b3b9d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186451786}] :answer-field/correct {:db/id #edb/ref 17592186451785} :answer-field/id #uuid "850131e8-3e45-5741-ab52-00ec54ad3707" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186452740} {:answer-field/choices [{:answer/id #uuid "76bb12c3-fa36-50ea-a3b0-43561a75e8d6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186451787} {:answer/id #uuid "7b2a906b-4563-5dbb-9794-82a69e0005c1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186451788}] :answer-field/correct {:db/id #edb/ref 17592186451788} :answer-field/id #uuid "32afa441-a36d-5b70-a78f-f611e0661706" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186452741}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "87eecbfe-e80e-5243-96ba-7676172d9f04" :question/math-academy-id "q-80567" :question/problem "Let $D$ be a finite region enclosed between the curve $y={x}^{2}-4$ and the $x$-axis. If \n\n$$\nf(x,y)={\\begin{aligned}3x-y, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\n \nwhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** ${∬}_{D}(3x-y)\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\\,$ where $R=[-3,2]\\times [-4,1]$\n- **II.** ${∬}_{R}(3x-y)\\,\\text{d}A={∬}_{D}f(x,y)\\,\\text{d}A,\\,$ where $R=[-3,3]\\times [-4,4]$\n- **III.** ${∬}_{D}(3x-y)\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\\,$ where $R=[-2,2]\\times [-4,0]$" :question/worked-solution "First, let's draw our region $D:$\n\n![](images/a7/a7af801fa9975dda6ce3b12b2cde2c328721cd5e0affd16f1a14ab26cfa21bdd.png)\n\nNotice that if $R$ covers $D$ completely and we define \n\n$$\nf(x,y)={\\begin{aligned}(3x-y), & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\nwe obtain\n\n$$\n{∬}_{D}(3x-y)\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given statements.\n\n- Statements I is true. The rectangle $R$ covers the region $D$ completely.\n\n- Statement II is false. The integrals have not been stated correctly with respect to the domains $R$ and $D$ (they have been swapped).\n\n- Statements III is true. The rectangle $R$ covers the region $D$ completely.\n\nTherefore, the correct answer is \"I and III only.\""} :step/id #uuid "62090604-96b8-5d41-8a4a-a6c72e1082c9" :step/next {:db/id #edb/ref 17592186482631}}] :activity/title "Double Integrals Over Non-Rectangular Domains" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186481765}]}
