 \\\\ -1 & 4\\end{aligned}][\\begin{aligned}5 & 0 \\\\ 0 & -3\\end{aligned}]{[\\begin{aligned}1 & -3 \\\\ -1 & 4\\end{aligned}]}^{-1}.\n$$\n\n \n\nIn conclusion, we get  $a=5,$ $b=1,$ and $c=-1.$" #edb/ref 17592186045417] [17592186404101 #edb/ref 1075 #edb/ref 17592186404102 #edb/ref 17592186045417] [17592186404101 #edb/ref 1075 #edb/ref 17592186404103 #edb/ref 17592186045417] [17592186404101 #edb/ref 1075 #edb/ref 17592186404104 #edb/ref 17592186045417] [17592186404101 #edb/ref 1075 #edb/ref 17592186404105 #edb/ref 17592186045417] [17592186404101 #edb/ref 1075 #edb/ref 17592186404106 #edb/ref 17592186045417] [17592186404101 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186404101 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186404101 #edb/ref 1078 #edb/ref 17592186404102 #edb/ref 17592186045417] [17592186404101 #edb/ref 1079 #uuid "b352245b-eaa4-5fde-aea9-5afac2d00b93" #edb/ref 17592186045417] [17592186404102 #edb/ref 1080 "$a=5,$ $b=1,$ and $c=-1$" #edb/ref 17592186045417] [17592186404102 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186404102 #edb/ref 1083 #uuid "639780ae-1398-50d7-b815-e2a195a0e73d" #edb/ref 17592186045417] [17592186404103 #edb/ref 1080 "$a=1,$ $b=-5,$ and $c=-1$" #edb/ref 17592186045417] [17592186404103 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186404103 #edb/ref 1083 #uuid "c73ad559-0eae-5f15-bdf7-739e613b69ee" #edb/ref 17592186045417] [17592186404104 #edb/ref 1080 "$a=1,$ $b=5,$ and $c=-1$" #edb/ref 17592186045417] [17592186404104 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186404104 #edb/ref 1083 #uuid "d0038efe-a96a-5281-ad36-c4af7f9c03a2" #edb/ref 17592186045417] [17592186404105 #edb/ref 1080 "$a=5,$ $b=1,$ and $c=1$" #edb/ref 17592186045417] [17592186404105 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186404105 #edb/ref 1083 #uuid "c0406221-3155-5859-8236-e58b9f481700" #edb/ref 17592186045417] [1759218640410