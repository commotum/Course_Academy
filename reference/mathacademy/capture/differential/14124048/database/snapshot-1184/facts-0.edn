27 #edb/ref 17592186048742 #edb/ref 17592186045417] [17592186050178 #edb/ref 1028 #edb/ref 17592186105747 #edb/ref 17592186045417] [17592186050178 #edb/ref 1028 #edb/ref 17592186105748 #edb/ref 17592186045417] [17592186050178 #edb/ref 1028 #edb/ref 17592186105809 #edb/ref 17592186045417] [17592186050178 #edb/ref 1031 "Solving 3x3 Singular Systems of Equations Using Gaussian Elimination" #edb/ref 17592186045417] [17592186050178 #edb/ref 1033 1374 #edb/ref 17592186045417] [17592186050178 #edb/ref 1035 #uuid "340f0f9d-19b0-5cff-abb5-75d2e7e75aa9" #edb/ref 17592186045417] [17592186050267 #edb/ref 1027 #edb/ref 17592186049088 #edb/ref 17592186045417] [17592186050267 #edb/ref 1027 #edb/ref 17592186049370 #edb/ref 17592186045417] [17592186050267 #edb/ref 1027 #edb/ref 17592186049422 #edb/ref 17592186045417] [17592186050267 #edb/ref 1027 #edb/ref 17592186049445 #edb/ref 17592186045417] [17592186050267 #edb/ref 1028 #edb/ref 17592186096669 #edb/ref 17592186045417] [17592186050267 #edb/ref 1028 #edb/ref 17592186096670 #edb/ref 17592186045417] [17592186050267 #edb/ref 1028 #edb/ref 17592186096671 #edb/ref 17592186045417] [17592186050267 #edb/ref 1031 "Solving Systems of Equations Using Back Substitution" #edb/ref 17592186045417] [17592186050267 #edb/ref 1033 1047 #edb/ref 17592186045417] [17592186050267 #edb/ref 1035 #uuid "3afe28a0-5051-52a1-a085-a06727c301b8" #edb/ref 17592186045417] [17592186050426 #edb/ref 1027 #edb/ref 17592186048257 #edb/ref 17592186045417] [17592186050426 #edb/ref 1027 #edb/ref 17592186049222 #edb/ref 17592186045417] [17592186050426 #edb/ref 1028 #edb/ref 17592186119923 #edb/ref 17592186045417] [17592186050426 #edb/ref 1028 #edb/ref 17592186119924 #edb/ref 17592186045417] [17592186050426 #edb/ref 1028 #edb/ref 17592186119925 #edb/ref 17592186045417] [17592186050426 #edb/ref 1031 "Linear Dependence and Independence" #edb/ref 17592186045417] [17592186050426 #edb/ref 1033 1861 #edb/ref 17592186045417] [17592186050426 #edb/ref 1035 #uuid "47f4b767-dd8b-5a07-a614-8ff85185d0eb" #edb/ref 17592186045417] [17592186117088 #edb/ref 1075 #edb/ref 17592186117089 #edb/ref 17592186045417] [17592186117088 #edb/ref 1075 #edb/ref 17592186117090 #edb/ref 17592186045417] [17592186117088 #edb/ref 1075 #edb/ref 17592186117091 #edb/ref 17592186045417] [17592186117088 #edb/ref 1075 #edb/ref 17592186117092 #edb/ref 17592186045417] [17592186117088 #edb/ref 1075 #edb/ref 17592186117093 #edb/ref 17592186045417] [17592186117088 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186117088 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186117088 #edb/ref 1078 #edb/ref 17592186117091 #edb/ref 17592186045417] [17592186117088 #edb/ref 1079 #uuid "01b88459-f835-5654-8214-92ece439c385" #edb/ref 17592186045417] [17592186117089 #edb/ref 1080 "II only" #edb/ref 17592186045417] [17592186117089 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186117089 #edb/ref 1083 #uuid "cf6dca7d-0ce4-5e8e-b9b2-3303fd96d94e" #edb/ref 17592186045417] [17592186117090 #edb/ref 1080 "I only" #edb/ref 17592186045417] [17592186117090 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186117090 #edb/ref 1083 #uuid "d51a6c38-bbb9-53c8-9e8d-d08531e3e2fa" #edb/ref 17592186045417] [17592186117091 #edb/ref 1080 "II and III only" #edb/ref 17592186045417] [17592186117091 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186117091 #edb/ref 1083 #uuid "e90efca0-0287-5643-adc8-6e36ca3d9e73" #edb/ref 17592186045417] [17592186117092 #edb/ref 1080 "I and III only" #edb/ref 17592186045417] [17592186117092 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186117092 #edb/ref 1083 #uuid "3f5fc17f-c8a6-5808-8a11-b0ae8b5d686d" #edb/ref 17592186045417] [17592186117093 #edb/ref 1080 "III only" #edb/ref 17592186045417] [17592186117093 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186117093 #edb/ref 1083 #uuid "669cbbfb-8d77-5f7b-a387-18e5ffbd5163" #edb/ref 17592186045417] [17592186119497 #edb/ref 1069 "e-10906" #edb/ref 17592186045417] [17592186119497 #edb/ref 1071 "The set $\\{ \\mathbf{a_1},\\mathbf{a_2} \\}$ is linearly dependent. Which of the following vectors could be $\\mathbf{a}_2$ if\n![](images/be/beca665c362fba7b33cbdbe09ea81072e359a3f94a22d01138ed52acdb0ffa09.svg)\n\n![](images/cb/cb9d68b769a637dc9d8e39ad4006dafe8cfa7c1cdbb8b2b48ba91f3ddc62568f.svg)" #edb/ref 17592186045417] [17592186119497 #edb/ref 1072 #uuid "cbabcd64-6a33-552d-9f2f-704a9df44d1e" #edb/ref 17592186045417] [17592186119497 #edb/ref 1074 "We say that two vectors $\\mathbf{v}_1$ and $\\mathbf{v}_2$ are *linearly independent* if the only solution to the equation\n\n$$\nx_1 \\mathbf{v}_1 + x_2 \\mathbf{v}_2 = \\mathbf{0}\n$$\n\nis $x_1 = x_2 = 0.$ Otherwise, the vectors are *linearly dependent*.\n\nA set containing *only two* vectors is linearly *dependent* if and only if the two vectors are parallel.\n\nFrom the given options, the correct answer is\n![](images/53/53707f60f3888da139fde8caa9c8310c1cb1c5884f3ffe39669d768f26a87a71.svg)\nTo see why, notice that \n![](images/92/9235ccd66098682ac98b70ab41c270a7a88d2d9ef8baa6eb27a395f7771374c1.svg)\nIn other words, the vectors $\\mathbf a_1$ and $\\mathbf a_2$ are parallel.\n\nTo see why this means that $\\mathbf a_1$ and $\\mathbf a_2$ are linearly dependent, notice that\n\n$$\n\\begin{aligned}\\frac{1}{3}{a}_{1}-{a}_{2} & =0.\\end{aligned}\n$$\n\nSo, the equation\n\n$$\nx_1 \\mathbf{a}_1  +x_2  \\mathbf{a}_2 = \\mathbf{0}\n$$\n\nhas the solution $x_1=\\dfrac 1 3$ and $x_2=-1,$ which is different from $x_1=x_2=0.$ Therefore, the set is linearly dependent." #edb/ref 17592186045417] [17592186119498 #edb/ref 1069 "e-10907" #edb/ref 17592186045417] [17592186119498 #edb/ref 1071 "Consider the following vectors:\n\n![](images/a1/a1275962afa7cdb43c691eaeb65656491c546b6272571a91924f4e8ac15fd96d.svg)\n\nWhich of the following statements are true?\n\nI. $\\mathbf{a}_1 - \\mathbf{a}_2 -2 \\mathbf{a}_3 = \\mathbf{0}.$\n\nII. $x_1\\mathbf{a}_1 + x_2\\mathbf{a}_2 + x_3\\mathbf{a}_3  = \\mathbf{0}$ only if $x_1=x_2=x_3 = 0.$\n\nIII. The set $\\{\\mathbf{a}_1, \\mathbf{a}_2, \\mathbf{a}_3\\}$ is linearly independent." #edb/ref 17592186045417] [17592186119498 #edb/ref 1072 #uuid "7b28b42f-0ac4-543e-baeb-51534aaad480" #edb/ref 17592186045417] [17592186119498 #edb/ref 1074 "We say that three vectors $\\mathbf{v}_1, \\mathbf{v}_2$ and $\\mathbf{v}_3$ are *linearly independent* if the only solution to the equation\n\n$$\nx_1 \\mathbf{v}_1 + x_2 \\mathbf{v}_2 + x_3\\mathbf{v}_3= \\mathbf{0}\n$$\n\nis $x_1 = x_2 = x_3 = 0.$ Otherwise, the vectors are *linearly dependent*.\n\nWith that in mind, let's look at each statement in turn.\n\n- Statement I is false. Indeed:\n\n$$\n\\begin{aligned}{a}_{1}-{a}_{2}-2{a}_{3} & =[\\begin{aligned}4 \\\\ -1 \\\\ 0\\end{aligned}]-[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]-2[\\begin{aligned}2 \\\\ -1 \\\\ 7\\end{aligned}] \\\\  & =[\\begin{aligned}4 \\\\ -1 \\\\ 0\\end{aligned}]+[\\begin{aligned}0 \\\\ -1 \\\\ 0\\end{aligned}]+[\\begin{aligned}-4 \\\\ 2 \\\\ -14\\end{aligned}] \\\\  & =[\\begin{aligned}4+0-4 \\\\ -1-1+2 \\\\ 0+0-14\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 0 \\\\ -14\\end{aligned}] \\\\  & \\ne 0\\end{aligned}\n$$\n\n- Statement II is true. The equation $x_1\\mathbf{a}_1 + x_2\\mathbf{a}_2 + x_3\\mathbf{a}_3 = \\mathbf{0}$ corresponds to the system\n\n$$\n\\{\\begin{aligned}4{x}_{1}+2{x}_{3}=0 \\\\ -{x}_{1}+{x}_{2}-{x}_{3}=0 \\\\ 7{x}_{3}=0.\\end{aligned}\n$$\n\nNotice that we can reorder the equations in this system as follows:\n\n$$\n\\{\\begin{aligned}-{x}_{1}+{x}_{2}-{x}_{3}=0 \\\\ 4{x}_{1}+2{x}_{3}=0 \\\\ 7{x}_{3}=0\\end{aligned}\n$$\n\nSolving this system using back substitution, we find that the solution is $x_1 = x_2 = x_3 = 0.$\n\n- Statement III is true. Since statement II is true, the set $\\{\\mathbf{a}_1, \\mathbf{a}_2, \\mathbf{a}_3 \\}$ is linearly independent.\n\nTherefore, the correct answer is \"II and III only.\"" #edb/ref 17592186045417] [17592186119499 #edb/ref 1069 "e-10908" #edb/ref 17592186045417] [17592186119499 #edb/ref 1071 "Consider the following vectors:\n\n![](images/ae/ae2f35f46132153c89cbfe418d1a316586e623e0ff9819ac50535fc3e3fd95db.svg)\n\nAssume that $x_1,x_2,$ and $x_3$ are real numbers. Which of the following statements are true?\n\nI. The equation $x_1\\mathbf{a}_1+x_2\\mathbf{a}_2+x_3\\mathbf{a}_3=\\mathbf{0}$ has an infinite number of nonzero solutions.\n\nII. The vectors $\\mathbf{a}_1,\\mathbf{a}_2,$ and $\\mathbf{a}_3$ are linearly independent.\n\nIII. The vectors $\\mathbf{a}_1,\\mathbf{a}_2,$ and $\\mathbf{a}_3$ are linearly dependent." #edb/ref 17592186045417] [17592186119499 #edb/ref 1072 #uuid "3843dc13-0908-5d4c-adfe-836a928a1410" #edb/ref 17592186045417] [17592186119499 #edb/ref 1074 "We say that three vectors $\\mathbf{v}_1, \\mathbf{v}_2,$ and $\\mathbf{v}_3$ are *linearly independent* if the only solution to the equation\n\n$$\nx_1 \\mathbf{v}_1 + x_2 \\mathbf{v}_2 + x_3 \\mathbf{v}_3 = \\mathbf{0}\n$$\n\nis $x_1 = x_2 = x_3 = 0.$ Otherwise, the vectors are *linearly dependent*.\n\nWith that in mind, let's examine our statements.\n\nThe equation $x_1\\mathbf{a}_1+x_2\\mathbf{a}_2+x_3\\mathbf{a}_3=\\mathbf{0}$ corresponds to the system\n\n$$\n\\{\\begin{aligned}2{x}_{1}-{x}_{2}+2{x}_{3}=0 \\\\ 4{x}_{1}+4{x}_{2}+5{x}_{3}=0 \\\\ 6{x}_{2}+{x}_{3}=0.\\end{aligned}\n$$\n\nTo solve the system, we create its augmented matrix and reduce it using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}2 & -1 & 2 & 0 \\\\ 4 & 4 & 5 & 0 \\\\ 0 & 6 & 1 & 0\\end{aligned}] & {R}_{2}:={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}2 & -1 & 2 & 0 \\\\ 0 & 6 & 1 & 0 \\\\ 0 & 6 & 1 & 0\\end{aligned}] & {R}_{3}:={R}_{3}+(-1){R}_{2} \\\\  & ∼[\\begin{aligned}2 & -1 & 2 & 0 \\\\ 0 & 6 & 1 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nFrom the matrix above, we conclude that the basic variables are $x_1$ and $x_2,$ while $x_3$ is the free variable. \n\nSince there is one free variable, the equation $x_1\\mathbf{a}_1+x_2\\mathbf{a}_2+x_3\\mathbf{a}_3=\\mathbf{0}$ has an infinite number of nonzero solutions, which means that the vectors are linearly dependent. \n\nTherefore, statements II is false, while statements I and III are true." #edb/ref 17592186045417] [17592186119923 #edb/ref 1037 #edb/ref 17592186048315 #edb/ref 17592186045417] [17592186119923 #edb/ref 1038 #edb/ref 17592186120320 #edb/ref 17592186045417] [17592186119923 #edb/ref 1038 #edb/ref 17592186120321 #edb/ref 17592186045417] [17592186119923 #edb/ref 1038 #edb/ref 17592186241026 #edb/ref 17592186045417] [17592186119923 #edb/ref 1038 #edb/ref 17592186241027 #edb/ref 17592186045417] [17592186119923 #edb/ref 1038 #edb/ref 17592186241028 #edb/ref 17592186045417] [17592186119923 #edb/ref 1038 #edb/ref 17592186315094 #edb/ref 17592186045417] [17592186119923 #edb/ref 1038 #edb/ref 17592186317317 #edb/ref 17592186045417] [17592186119923 #edb/ref 1038 #edb/ref 17592186396585 #edb/ref 17592186045417] [17592186119923 #edb/ref 1038 #edb/ref 17592186396694 #edb/ref 17592186045417] [17592186119923 #edb/ref 1038 #edb/ref 17592186396701 #edb/ref 17592186045417] [17592186119923 #edb/ref 1038 #edb/ref 17592186423131 #edb/ref 17592186045417] [17592186119923 #edb/ref 1039 "Finding a Vector That Makes a Set Linearly Dependent" #edb/ref 17592186045417] [17592186119923 #edb/ref 1041 #edb/ref 17592186119497 #edb/ref 17592186045417] [17592186119923 #edb/ref 1042 #uuid "5130f54d-2a53-5373-81a6-355921ea7523" #edb/ref 17592186045417] [17592186119924 #edb/ref 1037 #edb/ref 17592186050267 #edb/ref 17592186045417] [17592186119924 #edb/ref 1038 #edb/ref 17592186120147 #edb/ref 17592186045417] [17592186119924 #edb/ref 1038 #edb/ref 17592186120148 #edb/ref 17592186045417] [17592186119924 #edb/ref 1038 #edb/ref 17592186120149 #edb/ref 17592186045417] [17592186119924 #edb/ref 1038 #edb/ref 17592186275376 #edb/ref 17592186045417] [17592186119924 #edb/ref 1038 #edb/ref 17592186275381 #