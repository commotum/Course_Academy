g a Probability on a Bounded Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a450533-8c93-5f65-b086-433237dedd04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{17}" :db/id #edb/ref 17592186423906} {:answer/id #uuid "16d2517e-9185-5017-857d-9ebe5b8407f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{16}" :db/id #edb/ref 17592186423907} {:answer/id #uuid "35e889ba-9472-5ac8-a25c-ed6d2ba99992" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{18}" :db/id #edb/ref 17592186423909} {:answer/id #uuid "9c17240f-6dc3-5a02-ad81-bc045176e81b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{17}" :db/id #edb/ref 17592186423922} {:answer/id #uuid "de19a84f-848b-52ac-9d4f-56ab8e8d674a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186423932}] :answer-field/correct {:answer/id #uuid "9c17240f-6dc3-5a02-ad81-bc045176e81b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{17}" :db/id #edb/ref 17592186423922} :answer-field/id #uuid "6928beb7-6d1c-5fe0-9c89-497534fd649e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186423938}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a7e41369-c44a-5b84-b7fc-e764205aba15" :question/math-academy-id "q-96839" :question/problem "Given $X∼U\\{1,2,3,…,17\\},$ compute $P(2\\le X<9).$" :question/worked-solution "If $X$ follows a discrete uniform distribution over a set $S,$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{|S|}, & x\\in S \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, we have $X∼U\\{1,2,3,…,17\\},$ and the set $S=\\{1,2,3,…,17\\}$ has $|S|=17-1+1=17$ items. So, we have\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{17}, & x=1,2,3,…,17 \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nIn $S,$ there are $7$ items $(2,3,4,5,6,7,8)$ that satisfy $2\\le X<9.$ Therefore,\n\n$$\nP(2\\le X<9)=7\\cdot \\frac{1}{17}=\\frac{7}{17}.\n$$"}]}
