#{[{:db/id #edb/ref 17592186161812 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186162020 :knowledge-point/id #uuid "9c029623-354f-5800-ac1b-05681ed7ff2f" :knowledge-point/title "Computing a Probability at a Single Point"}] :question/id #uuid "0a247025-c5ec-5b0d-a741-4eaceee20b57" :question/math-academy-id "e-8462" :question/problem "Given that $X \\sim U \\left\\lbrace 7, 8, 9, \\ldots, 21 \\right\\rbrace,$ compute $P(X = 18).$" :question/worked-solution "If $X$ follows a discrete uniform distribution over a set $S,$ then $X$ has the following probability mass function:\n\n![](images/bd/bdbe38e4c652e888c4eea890738bccb4d70804cd2b7c23058f72dd2c8996d717.svg)\n\nHere, we have $X \\sim U \\left\\lbrace 7, 8, 9, \\ldots, 21 \\right\\rbrace,$ and the set $S = \\left\\lbrace 7, 8, 9, \\ldots, 21 \\right\\rbrace$ has $|S|=21 - 7 + 1 = 15$ items. So, we have\n\n![](images/47/4757730008d9d00bdd406065d1aaad881d6b2a95bb65dc9a021982b00cbd9059.svg)\n\nTherefore,\n\n$$\nP(X = 18) = f(18) = \\dfrac{1}{15}.\n$$"}] [{:db/id #edb/ref 17592186161813 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186162021 :knowledge-point/id #uuid "adf7ba0e-5e16-52c3-af7d-b51a311b11fa" :knowledge-point/title "Computing a Probability on a Bounded Interval"}] :question/id #uuid "884ee1a6-a5e3-5e50-b975-71167ebd923e" :question/math-academy-id "e-8463" :question/problem "Given $X \\sim U \\left\\lbrace 7, 8, 9, \\ldots, 16\\right\\rbrace,$ compute $P(8 \\leq          X < 13).$" :question/worked-solution "If $X$ follows a discrete uniform distribution over a set $S,$ then $X$ has the following probability mass function:\n\n![](images/cf/cf4a1e915e224fdbbbe53116e848c661f93acad19f5637ec09b704a949a4dd05.svg)\n\nHere, we have $X \\sim U \\left\\lbrace 7, 8, 9, \\ldots, 16 \\right\\rbrace,$ and the set $S = \\left\\lbrace 7, 8, 9, \\ldots, 16 \\right\\rbrace$ has $|S|=16 - 7 + 1 = 10$ items. So, we have\n\n![](images/04/048e928b8243c02a895c03b17473898770d6e2738b21bb61a92d86a6e3d52bfc.svg)\n\nIn $S,$ there are $5$ items $(8, 9, 10, 11, 12)$ that satisfy $8 \\leq  X < 13.$ Therefore,\n\n$$\nP(8 \\leq  X < 13) = 5 \\cdot \\dfrac{1}{10} = \\dfrac{1}{2}.\n$$"}] [{:db/id #edb/ref 17592186161829 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186162036 :knowledge-point/id #uuid "3148b483-52f4-5740-bd82-194aab44f89a" :knowledge-point/title "Computing a Probability on an Unbounded Interval"}] :question/id #uuid "36688142-f65d-50a0-8454-fe6315617283" :question/math-academy-id "e-8565" :question/problem "Given $X \\sim U \\left\\lbrace 5, 6, 7, \\ldots, 14 \\right\\rbrace,$ compute $P(X \\geq 9).$" :question/worked-solution "If $X$ follows a discrete uniform distribution over a set $S,$ then $X$ has the following probability mass function:\n\n![](images/a3/a35341e15b714d4d0682b7a254e26cc141f0d4a0f5a5c4b951f91e7da095512d.svg)\n\nHere, we have $X \\sim U \\left\\lbrace 5, 6, 7, \\ldots, 14 \\right\\rbrace,$ and the set $S = \\left\\lbrace 5, 6, 7, \\ldots, 14 \\right\\rbrace$ has $|S|=14 - 5 + 1 = 10$ items. So, we have\n\n![](images/52/526312cdbaa5f0462aafcea89d4719a4a2f058445f367d720b852dbad0048aaa.svg)\n\nIn $S,$ the items that satisfy $X \\geq 9$ are $9, 10, 11, \\ldots , 14.$ There are $14 - 9 + 1 = 6$ of these items. Therefore,\n\n$$\nP(X \\geq 9) = 6 \\cdot \\dfrac{1}{10} = \\dfrac{3}{5}.\n$$"}] [{:db/id #edb/ref 17592186423942 :knowledge-point/_questions [{:db/id #edb/ref 17592186162036 :knowledge-point/id #uuid "3148b483-52f4-5740-bd82-194aab44f89a" :knowledge-point/title "Computing a Probability on an Unbounded Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "947b312e-ee99-59a7-af09-a903fd2e1d0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186423919} {:answer/id #uuid "abcc5b71-338b-577c-85eb-afb6840553f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186423923} {:answer/id #uuid "ad0f1713-2b05-514d-a10e-779d012891f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186423924} {:answer/id #uuid "b948344f-4402-5976-9213-69a3217d38b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186423926} {:answer/id #uuid "f8739b76-a0ab-5c98-9470-0410c9781bfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186423935}] :answer-field/correct {:answer/id #uuid "b948344f-4402-5976-9213-69a3217d38b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186423926} :answer-field/id #uuid "df10270c-afeb-5cba-9cb6-73907dc215c8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186423940}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0437d140-6528-59da-a359-aaf4bce3a4ae" :question/math-academy-id "q-164160" :question/problem "Given $X∼U\\{0,1,2,3,4,5\\},$ compute $P(X<2).$" :question/worked-solution "If $X$ follows a discrete uniform distribution over a set $S,$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{|S|}, & x\\in S \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, we have $X∼U\\{0,1,2,3,4,5\\},$ and the set $S=\\{0,1,2,3,4,5\\}$ has $|S|=6$ items. So, we have\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{6}, & x=0,1,2,3,4,5 \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nIn $S,$ there are $2$ items $(0,1)$ that satisfy $X<2.$ Therefore,\n\n$$\nP(X<2)=2\\cdot \\frac{1}{6}=\\frac{1}{3}.\n$$"}] [{:db/id #edb/ref 17592186423943 :knowledge-point/_questions [{:db/id #edb/ref 17592186162020 :knowledge-point/id #uuid "9c029623-354f-5800-ac1b-05681ed7ff2f" :knowledge-point/title "Computing a Probability at a Single Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42bd1876-65cb-5fd8-a63d-6a5b4ed622b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186423910} {:answer/id #uuid "647f830c-4930-5419-a92d-35fb9d117c48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186423912} {:answer/id #uuid "65710dca-584a-5538-8392-0c75db50947c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186423913} {:answer/id #uuid "9a3ca409-a4c3-54ba-b34a-0eaab0215bcf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186423921} {:answer/id #uuid "d00c4e38-efbb-57f3-bf1e-8cd2dd37778d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186423930}] :answer-field/correct {:answer/id #uuid "9a3ca409-a4c3-54ba-b34a-0eaab0215bcf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186423921} :answer-field/id #uuid "17dd14c1-f0a6-5f73-9ff5-1250112c1e2d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186423936}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3fa88aaf-70b9-5b39-b375-a1ff9fc14a4f" :question/math-academy-id "q-96778" :question/problem "Given that $X∼U\\{3,7,9,10\\},$ compute $P(X=9).$" :question/worked-solution "If $X$ follows a discrete uniform distribution over a set $S,$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{|S|}, & x\\in S \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, we have $X∼U\\{3,7,9,10\\},$ and the set $S=\\{3,7,9,10\\}$ has $|S|=4$ items. So, we have\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{4}, & x=3,7,9,10 \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(X=9)=f(9)=\\frac{1}{4}.\n$$"}] [{:db/id #edb/ref 17592186423947 :knowledge-point/_questions [{:db/id #edb/ref 17592186162020 :knowledge-point/id #uuid "9c029623-354f-5800-ac1b-05681ed7ff2f" :knowledge-point/title "Computing a Probability at a Single Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a09e155-68e9-5775-88e9-0c0dd6011287" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186423914} {:answer/id #uuid "af474fa2-5b82-5e5b-919d-49bf9a3d89c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186423925} {:answer/id #uuid "be11ebe4-c5f0-5452-93cf-c1171aabffec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{14}" :db/id #edb/ref 17592186423927} {:answer/id #uuid "d0318c22-f087-5f8c-bdd5-bca3ec896998" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{7}" :db/id #edb/ref 17592186423931} {:answer/id #uuid "e1a79c61-b7dd-5a80-b81d-55f14b24abc5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186423933}] :answer-field/correct {:answer/id #uuid "6a09e155-68e9-5775-88e9-0c0dd6011287" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186423914} :answer-field/id #uuid "f32b7f4b-707c-5946-80d1-f757bb8e4cf5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186423941}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c83e57db-b20b-5f69-af71-6e6e6a8e413f" :question/math-academy-id "q-96780" :question/problem "Given that $X∼U\\{13,14,18\\},$ compute $P(X=14).$" :question/worked-solution "If $X$ follows a discrete uniform distribution over a set $S,$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{|S|}, & x\\in S \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, we have $X∼U\\{13,14,18\\},$ and the set $S=\\{13,14,18\\}$ has $|S|=3$ items. So, we have\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{3}, & x=13,14,18 \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(X=14)=f(14)=\\frac{1}{3}.\n$$"}] [{:db/id #edb/ref 17592186423944 :knowledge-point/_questions [{:db/id #edb/ref 17592186162036 :knowledge-point/id #uuid "3148b483-52f4-5740-bd82-194aab44f89a" :knowledge-point/title "Computing a Probability on an Unbounded Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26cab201-dd5a-5522-a7c5-25241811d134" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186423908} {:answer/id #uuid "5b6c4c06-c4a6-59a0-90bc-5dba036d765a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{9}" :db/id #edb/ref 17592186423911} {:answer/id #uuid "771bbc36-1481-5967-acf3-99e3381b2049" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186423915} {:answer/id #uuid "867fb739-bcef-5db1-ad21-be3d3d6e70e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186423917} {:answer/id #uuid "e4aa368d-d1cf-529c-b6c7-9e7448c03be7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{9}" :db/id #edb/ref 17592186423934}] :answer-field/correct {:answer/id #uuid "867fb739-bcef-5db1-ad21-be3d3d6e70e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186423917} :answer-field/id #uuid "ac586fbc-baee-5b6b-94a9-3c6e6210f9e1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186423939}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "49e5ad2d-03f1-55be-ada8-dbc0284264c6" :question/math-academy-id "q-96810" :question/problem "Given $X∼U\\{9,10,11,…,17\\},$ compute $P(X<12).$" :question/worked-solution "If $X$ follows a discrete uniform distribution over a set $S,$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{|S|}, & x\\in S \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, we have $X∼U\\{9,10,11,…,17\\},$ and the set $S=\\{9,10,11,…,17\\}$ has $|S|=17-9+1=9$ items. So, we have\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{9}, & x=9,10,11,…,17 \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nIn $S,$ the items that satisfy $X<12$ are $9,10,11.$ There are $3$ of these items. Therefore,\n\n$$\nP(X<12)=3\\cdot \\frac{1}{9}=\\frac{1}{3}.\n$$"}] [{:db/id #edb/ref 17592186423946 :knowledge-point/_questions [{:db/id #edb/ref 17592186162021 :knowledge-point/id #uuid "adf7ba0e-5e16-52c3-af7d-b51a311b11fa" :knowledge-point/title "Computing a Probability on a Bounded Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7bf42ba7-f2a3-55cc-af79-9f295ed44f49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186423916} {:answer/id #uuid "8959248e-670f-5708-9f80-641e8f900f4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186423918} {:answer/id #uuid "9875fe05-05a7-53d3-ada2-9e8fce9c093c" :answer/type {:db/id