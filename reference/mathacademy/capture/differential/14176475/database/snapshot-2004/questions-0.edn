#{[{:db/id #edb/ref 17592186371583 :knowledge-point/_questions [{:db/id #edb/ref 17592186087833 :knowledge-point/id #uuid "57e19ee3-db9a-58d7-8ca3-4e8801aee656" :knowledge-point/title "Determining the Equation of a Tall Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "af2bad0e-9dc9-5968-88dc-a1e321f073c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{2}+\\frac{(y+4)^{2}}{3}=1" :db/id #edb/ref 17592186371585} {:answer/id #uuid "8c7b4737-1592-5599-866c-fb9337333c5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{4}+\\frac{(y+4)^{2}}{9}=1" :db/id #edb/ref 17592186371586} {:answer/id #uuid "bcfa9944-4565-597f-8530-0793ce6c6f94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{9}+\\frac{(y+4)^{2}}{4}=1" :db/id #edb/ref 17592186371587} {:answer/id #uuid "9afb9836-3f0b-5f92-8cd5-a659d33b2905" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-4)^{2}}{4}+\\frac{{y}^{2}}{9}=1" :db/id #edb/ref 17592186371588} {:answer/id #uuid "d60530b3-3e54-5d62-bffa-836a75315c2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{4}+\\frac{(y+4)^{2}}{6}=1" :db/id #edb/ref 17592186371589}] :answer-field/correct {:answer/id #uuid "8c7b4737-1592-5599-866c-fb9337333c5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{4}+\\frac{(y+4)^{2}}{9}=1" :db/id #edb/ref 17592186371586} :answer-field/id #uuid "ba0a6189-0e52-5212-859c-9ea6a09989b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186371584}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7d5d4f0a-0454-5deb-bf0e-354930b4e862" :question/math-academy-id "q-115303" :question/problem "![](images/16/160ce22bf1c4bd47fbe3e2ec1391bd212a376d93b4c3a640821d28d1e0cc518f.png)\n\nWhat is the equation of the ellipse given above?" :question/worked-solution "Remember that the general equation of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the ellipse is centered at $(0,-4),$ the horizontal radius has length $a=2,$ and the vertical radius has length $b=3.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}} & =1 \\\\ \\frac{(x-0)^{2}}{{2}^{2}}+\\frac{(y-(-4))^{2}}{{3}^{2}} & =1 \\\\ \\frac{{x}^{2}}{4}+\\frac{(y+4)^{2}}{9} & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250390 :knowledge-point/_questions [{:db/id #edb/ref 17592186087834 :knowledge-point/id #uuid "a5028940-be34-56b7-8947-6129252f06a7" :knowledge-point/title "Determining the Center and Lengths of the Major and Minor Axes Given the Equation of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1dc8d6fa-6312-5332-b890-b96f8ba86d34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,2)" :db/id #edb/ref 17592186247690} {:answer/id #uuid "2f504533-dba5-5a4f-8e8e-d571f324bc13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,-2)" :db/id #edb/ref 17592186247849} {:answer/id #uuid "5337ac8c-87dc-5ed1-9732-75915073f600" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,-3)" :db/id #edb/ref 17592186248174} {:answer/id #uuid "6a7cb839-e5f3-5581-9fe8-bb0945fd74b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,3)" :db/id #edb/ref 17592186248373} {:answer/id #uuid "7f7020d4-fe3f-50f8-bd90-be3c6e4d9e72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,3)" :db/id #edb/ref 17592186248543}] :answer-field/correct {:answer/id #uuid "7f7020d4-fe3f-50f8-bd90-be3c6e4d9e72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,3)" :db/id #edb/ref 17592186248543} :answer-field/id #uuid "54c42180-98c9-5c11-b93b-3fa148651bca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249826}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1dd86485-ed9c-5475-8932-90607bb9958e" :question/math-academy-id "q-115308" :question/problem "What is the center of the ellipse $\\frac{(x+2)^{2}}{3}+\\frac{(y-3)^{2}}{9}=1?$" :question/worked-solution "Remember that the general equation of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nIn the given equation, we have $h=-2$ and $k=3,$ so the center is located at $(-2,3).$"}] [{:db/id #edb/ref 17592186284551 :knowledge-point/_questions [{:db/id #edb/ref 17592186087834 :knowledge-point/id #uuid "a5028940-be34-56b7-8947-6129252f06a7" :knowledge-point/title "Determining the Center and Lengths of the Major and Minor Axes Given the Equation of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04caccb7-eef9-5a5c-86ac-6fc9f5df760f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\sqrt{5}$ and $\\sqrt{2}$" :db/id #edb/ref 17592186281732} {:answer/id #uuid "3f5630e8-42d8-5fbc-bbb2-d2547199f715" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2\\sqrt{5}$ and $\\sqrt{2}$" :db/id #edb/ref 17592186282235} {:answer/id #uuid "c77b4445-1f49-5da2-a2e1-28109b02e623" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2\\sqrt{5}$ and $2\\sqrt{2}$" :db/id #edb/ref 17592186283427} {:answer/id #uuid "d4101354-7aae-5778-9e95-d50cf75fdaa9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2\\sqrt{5}$ and $2$" :db/id #edb/ref 17592186283537} {:answer/id #uuid "e670b928-5e0a-5b67-b85c-2f546978547c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$ and $\\sqrt{2}$" :db/id #edb/ref 17592186283696}] :answer-field/correct {:answer/id #uuid "c77b4445-1f49-5da2-a2e1-28109b02e623" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2\\sqrt{5}$ and $2\\sqrt{2}$" :db/id #edb/ref 17592186283427} :answer-field/id #uuid "045a8b1f-a6f7-5f1f-be6c-69beee3bb2c0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186283940}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4ac4adf2-972b-5792-b6e6-5844a5be5de5" :question/math-academy-id "q-16548" :question/problem "For the ellipse \n$\\frac{(x+4)^{2}}{5}+\\frac{(y-3)^{2}}{2}=1$, find the lengths of its major and minor axes." :question/worked-solution "Remember that the general equation of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nIn the given equation, we have $h=-4$ and $k=3,$ so the center is located at $(-4,3).$\n\nIn the given equation, we also have ${a}^{2}=5$ and ${b}^{2}=2.$\n\n- Since ${a}^{2}=5,$ the length of the horizontal radius must be $a=\\sqrt{5}.$\n\n- Since ${b}^{2}=2,$ the length of the vertical radius must be $b=\\sqrt{2}.$\n\nSo the semi-major axis has length $a=\\sqrt{5},$ and the semi-minor axis has length $b=\\sqrt{2}.$\n\nTherefore, the major axis has length $2a=2\\cdot \\sqrt{5}=2\\sqrt{5},$ and the minor axis has length $2b=2\\cdot \\sqrt{2}=2\\sqrt{2}.$"}]}
