773d-2167-5300-a067-9d49b7868481" #edb/ref 17592186045417] [17592186117111 #edb/ref 1080 "II and III only" #edb/ref 17592186045417] [17592186117111 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186117111 #edb/ref 1083 #uuid "6accb1a9-ced4-5c3e-a301-638457731ee9" #edb/ref 17592186045417] [17592186117112 #edb/ref 1075 #edb/ref 17592186117113 #edb/ref 17592186045417] [17592186117112 #edb/ref 1075 #edb/ref 17592186117114 #edb/ref 17592186045417] [17592186117112 #edb/ref 1075 #edb/ref 17592186117115 #edb/ref 17592186045417] [17592186117112 #edb/ref 1075 #edb/ref 17592186117116 #edb/ref 17592186045417] [17592186117112 #edb/ref 1075 #edb/ref 17592186117117 #edb/ref 17592186045417] [17592186117112 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186117112 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186117112 #edb/ref 1079 #uuid "31049367-7414-532a-a16c-7bb86f43ed8a" #edb/ref 17592186045417] [17592186117113 #edb/ref 1080 "I and III only" #edb/ref 17592186045417] [17592186117113 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186117113 #edb/ref 1083 #uuid "f5e04d4b-4cb5-59f1-a5bd-9a3230d31192" #edb/ref 17592186045417] [17592186117114 #edb/ref 1080 "I, II, and III only" #edb/ref 17592186045417] [17592186117114 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186117114 #edb/ref 1083 #uuid "0290aa7a-33b9-580a-9b19-d6d2621e8443" #edb/ref 17592186045417] [17592186117115 #edb/ref 1080 "III only" #edb/ref 17592186045417] [17592186117115 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186117115 #edb/ref 1083 #uuid "2c76ebd2-35c6-5e9f-9bc1-7d03bf4b8266" #edb/ref 17592186045417] [17592186117116 #edb/ref 1080 "II and IV only" #edb/ref 17592186045417] [17592186117116 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186117116 #edb/ref 1083 #uuid "2f23947e-5d65-5d20-8a42-4bb7a3ffcd1c" #edb/ref 17592186045417] [17592186117117 #edb/ref 1080 "IV only" #edb/ref 17592186045417] [17592186117117 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186117117 #edb/ref 1083 #uuid "4e347f4e-9e28-5725-a196-8d1f7b4eb6b9" #edb/ref 17592186045417] [17592186119500 #edb/ref 1069 "e-10974" #edb/ref 17592186045417] [17592186119500 #edb/ref 1071 "Let $L$ be the line with equation $y=5+3x$ in $\\mathbb{R}^2.$ Which of the following statements are true?\n\n- $L$ contains the zero-vector\n\n- $L$ is closed under vector addition\n\n- $L$ is closed under scalar multiplication\n\n- $L$ is **not** a subspace of $\\mathbb{R}^2$" #edb/ref 17592186045417] [17592186119500 #edb/ref 1072 #uuid "d2cb7f5f-ad04-5e04-b2da-0f9b555442a3" #edb/ref 17592186045417] [17592186119500 #edb/ref 1074 "Recall the following two facts about subspaces: \n\n- A set of vectors in a vector space is a *subspace* if it is closed under vector addition and scalar multiplication.\n\n- If a non-empty set is closed under scalar multiplication, then this set must contain the zero-vector (because $0 \\cdot \\mathbf{v} = \\mathbf{0}$ for any vector $\\mathbf{v}$). So, if a set does not contain the zero vector, then this set is not closed under scalar multiplication.\n\nNotice that $L$ contains vectors of the form \n\n![](images/8a/8a5ed52cd0a1f16d2284a101a757e57156f76aa24e11a1d15cbfacaa7e5c77b6.png)\n\nWith that in mind, let's examine our statements. \n\n- Statement I is false. The coordinates of the zero-vector do not satisfy the equation $y=5+3x{:}$\n\n$$\n\\begin{aligned}y & =5+3x \\\\ (0) & =5+3(0) \\\\ 0 & =5\\,\\times \\end{aligned}\n$$\n\n- Statement II is false. Let, for example, ![](images/94/9468a26323576c7ab92150c53c8cbc27cc719f91d096547f55d698643cf15658.png) and ![](images/51/513426187d03c0ee2d650b57432c6370e74aa81ec87cdfe92490aec2780aa9cb.png) from $L.$ Then,\n\n$$\n\\begin{aligned}a+b & =[\\begin{aligned}0 \\\\ 5\\end{aligned}]+[\\begin{aligned}-1 \\\\ 2\\end{aligned}]=[\\begin{aligned}0+(-1) \\\\ 5+2\\end{aligned}]=[\\begin{aligned}-1 \\\\ 7\\end{aligned}].\\end{aligned}\n$$\n\n \nHowever, ![](images/38/38aed9478a8cb36691b5f05dbfe1fd0f9d8555ea43b94a21ee43e265d5a2afe1.png) since substituting the coordinates into the equation $y=5+3x$ gives the following: \n\n$$\n\\begin{aligned}y & =5+3x \\\\ 7 & =5+3(-1) \\\\ 7 & =2\\,\\times \\end{aligned}\n$$\n\n- Statement III is false. Since $\\mathbf{0} \\not\\in L,$ this set is not closed under scalar multiplication.\n\n- Statement IV is true. Since statements II and III are false, $L$ is *not* a subspace of $\\mathbb{R}^2.$\n\nTherefore, the correct answer is \"IV only.\"" #edb/ref 17592186045417] [17592186119501 #edb/ref 1069 "e-10977" #edb/ref 17592186045417] [17592186119501 #edb/ref 1071 "Let $L$ be the line in $\\mathbb{R}^3$ that passes through the points $(1,2,2)$ and $(2,1,1).$ Which of the following statements are true?\n\n- $L$ contains the zero-vector\n\n- $L$ is closed under vector addition\n\n- $L$ is closed under scalar multiplication\n\n- $L$ is **not** a subspace of $\\mathbb{R}^3$" #edb/ref 17592186045417] [17592186119501 #edb/ref 1072 #uuid "d0d76105-c49e-5cf8-af57-bd74989e895b" #edb/ref 17592186045417] [17592186119501 #edb/ref 1074 "Recall the following two facts about subspaces: \n\n- A set of vectors in a vector space is a *subspace* if it is closed under vector addition and scalar multiplication.\n\n- If a non-empty set is closed under scalar multiplication, then this set must contain the zero-vector (because $0 \\cdot \\mathbf{v} = \\mathbf{0}$ for any vector $\\mathbf{v}$). So, if a set does not contain the zero vector, then this set is not closed under scalar multiplication.\n\nWith that in mind, let's examine our statements. \n\n- Statement I is false. The direction vector of the line $L$ is \n![](images/10/10865a16bf90e96dc3d6fb4897751a84b0db7a12c55843c73767f77e8817bc0f.png)\nThis means that the vector equation of the line is\n\n$$\n\\begin{aligned}r & =[\\begin{aligned}1 \\\\ 2 \\\\ 2\\end{aligned}]+t[\\begin{aligned}1 \\\\ -1 \\\\ -1\\end{aligned}]\\end{aligned}\n$$\n\nfor $t\\in\\mathbb R,$ and the corresponding Cartesian equation is \n\n$$\n{x-1}=\\dfrac{y-2}{-1}=\\dfrac{z-2}{-1}.\n$$\n\nBut this line does not pass through the origin since \n\n$$\n{(0)-1}\\neq\\dfrac{(0)-2}{-1}=\\dfrac{(0)-2}{-1}.  \\quad {\\color{red}\\times}\n$$\n\n- Statement II is false. Let's consider the vectors $[\\begin{aligned}1 \\\\ 2 \\\\ 2\\end{aligned}]$ and $[\\begin{aligned}2 \\\\ 1 \\\\ 1\\end{aligned}]$ from $L$ (the position vectors of the given points). Then,\n![](images/f5/f55d965d26e9f36702c88b259e7f60c84762894dccf7a72c9429fe84727fd922.png)\nHowever, the point $(3,3,3)$ does not belong to $L$ since\n\n$$\n{(3)-1}\\neq\\dfrac{(3)-2}{-1}=\\dfrac{(3)-2}{-1}. \\quad {\\color{red}\\times}\n$$\n\n- Statement III is false. Since $\\mathbf{0} \\not\\in L,$ this set is not closed under scalar multiplication.\n\n- Statement IV is true. Since statements II and III are false, $L$ is *not* a subspace of $\\mathbb{R}^3.$\n\nTherefore, the correct answer is \"IV only.\"" #edb/ref 17592186045417] [17592186119502 #edb/ref 1069 "e-10980" #edb/ref 17592186045417] [17592186119502 #edb/ref 1071 "Let $\\Pi$ be the plane with equation $x+4y-3z=2$ in $\\mathbb{R}^3.$ Which of the following statements are true? \n\n- $\\Pi$ contains the zero-vector\n\n- $\\Pi$ is closed under vector addition\n\n- $\\Pi$ is closed under scalar multiplication\n\n- $\\Pi$ is **not** a subspace of $\\mathbb{R}^3$" #edb/ref 17592186045417] [17592186119502 #edb/ref 1072 #uuid "d2199de1-4bfe-5589-95dd-f9bb7c339437" #edb/ref 17592186045417] [17592186119502 #edb/ref 1074 "Recall the following two facts about subspaces: \n\n- A set of vectors in a vector space is a *subspace* if it is closed under vector addition and scalar multiplication.\n\n- If a non-empty set is closed under scalar multiplication, then this set must contain the zero-vector (because $0 \\cdot \\mathbf{v} = \\mathbf{0}$ for any vector $\\mathbf{v}$). So, if a set does not contain the zero vector, then this set is not closed under scalar multiplication.\n\nNotice that $\\Pi$ contains vectors of the form \n\n![](images/d6/d64a36f48b3ad9b9c4fb1426260daa832254ec37abea4b1b33fafeb793aa1798.png)\n\nWith that in mind, let's examine our statements. \n\n- Statement I is false. The plane does not pass through the origin since\n\n$$\n\\begin{aligned}x+4y-3z & =2 \\\\ (0)+4(0)-3(0) & =2 \\\\ 0 & =2\\,\\times \\end{aligned}\n$$\n\n- Statement II is false. Let's consider ![](images/2e/2e5c2dab37c97d3f13e1ce3c981a31d51d46a64daa6f21e2102747afbc84d015.png) and ![](images/19/19be68b7d6cf1b05832601c75bb456ec66a9f15f56188c89bf9ba98ad83d937d.png) Then \n\n$$\n\\begin{aligned}a+b & =[\\begin{aligned}2 \\\\ 0 \\\\ 0\\end{aligned}]+[\\begin{aligned}1 \\\\ 1 \\\\ 1\\end{aligned}]=[\\begin{aligned}2+1 \\\\ 0+1 \\\\ 0+1\\end{aligned}]=[\\begin{aligned}3 \\\\ 1 \\\\ 1\\end{aligned}],\\end{aligned}\n$$\n\nHowever, $[\\begin{aligned}3 \\\\ 1 \\\\ 1\\end{aligned}]$ does not belong to $\\Pi$ since \n\n$$\n\\begin{aligned}x+4y-3z & =2 \\\\ (3)+4(1)-3(1) & =2 \\\\ 4 & =2\\,\\times \\end{aligned}\n$$\n\n- Statement III is false. Since $\\mathbf{0} \\not\\in \\Pi,$ this set is not closed under scalar multiplication.\n\n- Statement IV is true. Since statements II and III are false, $\\Pi$ is *not* a subspace of $\\mathbb{R}^3.$\n\nTherefore, the correct answer is \"IV only.\"" #edb/ref 17592186045417] [17592186119926 #edb/ref 1037 #edb/ref 17592186048499 #edb/ref 17592186045417] [17592186119926 #edb/ref 1037 #edb/ref 17592186049716 #edb/ref 17592186045417] [17592186119926 #edb/ref 1037 #edb/ref 17592186050367 #edb/ref 17592186045417] [17592186119926 #edb/ref 1038 #edb/ref 17592186120145 #edb/ref 17592186045417] [17592186119926 #edb/ref 1038 #edb/ref 17592186120150 #edb/ref 17592186045417] [17592186119926 #edb/ref 1038 #edb/ref 17592186275357 #edb/ref 17592186045417] [17592186119926 #edb/ref 1038 #edb/ref 17592186275358 #edb/ref 17592186045417] [17592186119926 #edb/ref 1038 #edb/ref 17592186275