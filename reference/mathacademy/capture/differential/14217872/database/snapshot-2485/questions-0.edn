 :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$a$ is odd" :db/id #edb/ref 17592186414593} :answer-field/id #uuid "ade18156-9e6a-57e2-adc8-e6d739d87723" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186414630}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "078171ae-79c8-5810-aaf2-bebda0bbeadd" :question/math-academy-id "q-175329" :question/problem "$\\,$ $a$ is even or $b$ is odd.\n\nThe negation of the composite predicate above is the following:\n\n$\\,$ \n{{field-1}}{{field-2}}{{field-3}}" :question/worked-solution "De Morgan's law for disjunctions states that\n\n$$\n¬(A∨B)=¬A∧¬B.\n$$\n\nSo, the negation of \"$a$ is even or $b$ is odd\" is\n\n$$\n\\begin{aligned}¬(a\\text{ is even or }b\\text{ is odd }) & ≡¬(a\\text{ is even }∨b\\text{ is odd }) \\\\  & ≡¬(a\\text{ is even })∧¬(b\\text{ is odd }) \\\\  & ≡a\\text{ is odd }∧b\\text{ is even } \\\\  & ≡a\\text{ is odd and }b\\text{ is even}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186198728 :knowledge-point/_questions [{:db/id #edb/ref 17592186198258 :knowledge-point/id #uuid "c65d0713-5b7a-5559-bef7-7b238edc29ab" :knowledge-point/title "Negating a Disjunction Using De Morgan's Law"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b12d2dd-8dc6-55fb-8e66-a00ac6c57725" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b\\ge 1" :db/id #edb/ref 17592186528556} {:answer/id #uuid "ca832330-171e-58bb-a493-1390498a85a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b\\le 1" :db/id #edb/ref 17592186528797} {:answer/id #uuid "f00a78e4-0e9d-5edf-bcca-ea6dde5bfb38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b>1" :db/id #edb/ref 17592186528892}] :answer-field/correct {:answer/id #uuid "f00a78e4-0e9d-5edf-bcca-ea6dde5bfb38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b>1" :db/id #edb/ref 17592186528892} :answer-field/id #uuid "143a1d71-d773-5457-b1f2-3156084212ab" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186195006} {:answer-field/choices [{:answer/id #uuid "a2fbfe43-27c6-5d11-9108-6a228dd37822" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "or" :db/id #edb/ref 17592186195011} {:answer/id #uuid "3cf02772-3d95-5c50-a0c0-b9125b8110ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "and" :db/id #edb/ref 17592186195012}] :answer-field/correct {:answer/id #uuid "3cf02772-3d95-5c50-a0c0-b9125b8110ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "and" :db/id #edb/ref 17592186195012} :answer-field/id #uuid "53d6330f-59e6-5be0-b020-2923b8d7e01a" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186195010} {:answer-field/choices [{:answer/id #uuid "1f970bb1-7ffa-53f0-9e31-f4f6cc12d5e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a>2" :db/id #edb/ref 17592186528383} {:answer/id #uuid "84b08898-bd44-58fe-b86f-c014bc7e7723" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a<2" :db/id #edb/ref 17592186528615} {:answer/id #uuid "f7382072-6b13-5399-9ac8-5b7dc7b9ef69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a\\ge 2" :db/id #edb/ref 17592186528911}] :answer-field/correct {:answer/id #uuid "f7382072-6b13-5399-9ac8-5b7dc7b9ef69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a\\ge 2" :db/id #edb/ref 17592186528911} :answer-field/id #uuid "a323f4fc-fa80-5f84-a5c3-0b79be1b160f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186195013}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e4569a89-5769-5a01-b0e6-91edf3c2b7e1" :question/math-academy-id "q-175331" :question/problem "$\\,$ $a<2\\text{ or }b\\le 1.$\n\nThe negation of the composite predicate above is the following:\n\n$\\,$ \n{{field-1}}{{field-2}}{{field-3}}" :question/worked-solution "De Morgan's law for disjunctions states that\n\n$$\n¬(A∨B)=¬A∧¬B.\n$$\n\nSo, the negation of \"$a<2\\text{ or }b\\le 1$\" is\n\n$$\n\\begin{aligned}¬(a<2\\text{ or }b\\le 1) & ≡¬(a<2∨b\\le 1) \\\\  & ≡¬(a<2)∧¬(b\\le 1) \\\\  & ≡a\\ge 2∧b>1 \\\\  & ≡a\\ge 2\\text{ and }b>1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186529092 :knowledge-point/_questions [{:db/id #edb/ref 17592186198256 :knowledge-point/id #uuid "391d581f-9a2a-5de6-afbe-897917a9f6e3" :knowledge-point/title "Expressing a Predicate in Symbolic Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01c43c1c-f187-5d74-8aed-81f34a717110" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬(P∨Q)" :db/id #edb/ref 17592186528301} {:answer/id #uuid "0e709e59-fc9b-581a-9a73-d928809c39b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬(P∧Q)" :db/id #edb/ref 17592186528333} {:answer/id #uuid "7c0da829-aa4d-5367-b177-bd093d8b5659" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬P∧Q" :db/id #edb/ref 17592186528594} {:answer/id #uuid "bf3adcd5-7b76-552c-9ca5-e6e32e82024c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬(P∨¬Q)" :db/id #edb/ref 17592186528767} {:answer/id #uuid "e6fc7a57-5c7e-5edc-a302-39b709d7283c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P∧¬Q" :db/id #edb/ref 17592186528870}] :answer-field/correct {:answer/id #uuid "0e709e59-fc9b-581a-9a73-d928809c39b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬(P∧Q)" :db/id #edb/ref 17592186528333} :answer-field/id #uuid "c1655ff9-41d1-5d75-8e39-7f09e632c123" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186529043}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "12705253-40c6-5f3d-bde2-d9b9b3c2a300" :question/math-academy-id "q-183269" :question/problem "$\\,$ $x$ is not both a multiple of $5$ and a multiple of $9.$\n\nExpress the compound predicate above in symbolic form given the following predicates:\n\n- $P(x):$ $x$ is a multiple of $5$\n\n- $Q(x):$ $x$ is a multiple of $9$" :question/worked-solution "The given sentence is the negation of the following sentence: \n\n$\\,$ $x$ is both a multiple of $5$ and a multiple of $9.$\n\nThe sentence above can be expressed symbolically as $P∧Q,$ and we can negate this sentence using the symbol \"$¬$\".\n\nTherefore, the given sentence is expressed symbolically as\n\n$$\n¬(P∧Q).\n$$"}] [{:db/id #edb/ref 17592186414637 :knowledge-point/_questions [{:db/id #edb/ref 17592186198256 :knowledge-point/id #uuid "391d581f-9a2a-5de6-afbe-897917a9f6e3" :knowledge-point/title "Expressing a Predicate in Symbolic Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0dd55b5a-0ce9-56da-98e7-46a8c78ba018" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬Y∨¬Z" :db/id #edb/ref 17592186414561} {:answer/id #uuid "19a32f64-e897-5ff0-bfbe-9b03678c932e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Y∨Z" :db/id #edb/ref 17592186414563} {:answer/id #uuid "401f8719-763f-554f-921a-8133a92d935a" :answer/type {:db/id #edb/ref 175