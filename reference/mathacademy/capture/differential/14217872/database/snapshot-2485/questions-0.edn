#{[{:db/id #edb/ref 17592186198105 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186198257 :knowledge-point/id #uuid "28cb0c9e-bf5a-5cab-9147-77e827e21bb2" :knowledge-point/title "Negating a Conjunction Using De Morgan's Law"}] :question/id #uuid "5b1d6912-85f0-5ac1-affb-6809d4525f29" :question/math-academy-id "e-12734" :question/problem "$\\qquad$ $x$ is prime and $y$ divides $12$.\n\nWhat is the negation of the composite predicate above?" :question/worked-solution "De Morgan's law for conjunctions states that\n\n$$\n\\neg ( A \\land B) = \\neg A \\lor \\neg B.\n$$\n\nSo, the negation of \"$x$ is prime and $y$ divides $12$\" is\n\n$$\n\\begin{aligned}¬(x\\text{ is prime and }y\\text{ divides }12) & ≡¬(x\\text{ is prime}∧y\\text{ divides }12) \\\\  & ≡¬(x\\text{ is prime})∨¬(y\\text{ divides }12) \\\\  & ≡x\\text{ is not prime}∨y\\text{ does not divide }12 \\\\  & ≡x\\text{ is not prime}\\text{ or }y\\text{ does not divide }12.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186198113 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186198256 :knowledge-point/id #uuid "391d581f-9a2a-5de6-afbe-897917a9f6e3" :knowledge-point/title "Expressing a Predicate in Symbolic Form"}] :question/id #uuid "4402b53e-3c80-5788-b727-20941348c03f" :question/math-academy-id "e-12885" :question/problem "$\\qquad$ $x$ is greater than $4,$ or $x$ is irrational.\n\nExpress the compound predicate above in symbolic form given the following predicates:\n\n- $P(x):$ $x$ is greater than $4$\n\n- $Q(x):$ $x$ is rational" :question/worked-solution "The sentence\n\n$\\qquad$ $x$ is irrational\n\ncan be expressed in symbolic form as $\\lnot Q.$\n\nTherefore, the given sentence is expressed symbolically as \n\n$$\nP\\lor \\lnot Q.\n$$"}] [{:db/id #edb/ref 17592186198114 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186198258 :knowledge-point/id #uuid "c65d0713-5b7a-5559-bef7-7b238edc29ab" :knowledge-point/title "Negating a Disjunction Using De Morgan's Law"}] :question/id #uuid "ed229458-dba0-5d6b-b32a-b70b253bc1f4" :question/math-academy-id "e-12886" :question/problem "$\\qquad$ $x$ is a multiple of $5$ or $y$ divides $24$.\n\nWhat is the negation of the composite predicate above?" :question/worked-solution "De Morgan's law for disjunctions states that\n\n$$\n\\neg ( A \\lor B) = \\neg A \\land \\neg B.\n$$\n\nSo, the negation of \"$x$ is a multiple of $5$ or $y$ divides $24$\" is\n\n$$\n\\begin{aligned}¬(x\\text{ is a multiple of [math]5[/math] or }y\\text{ divides }24) & ≡¬(x\\text{ is a multiple of }5∨y\\text{ divides }24) \\\\  & ≡¬(x\\text{ is a multiple of }5)∧¬(y\\text{ divides }24) \\\\  & ≡x\\text{ is not a multiple of }5∧y\\text{ does not divide }24 \\\\  & ≡x\\text{ is not a multiple of }5\\text{ and }y\\text{ does not divide }24.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186198695 :knowledge-point/_questions [{:db/id #edb/ref 17592186198256 :knowledge-point/id #uuid "391d581f-9a2a-5de6-afbe-897917a9f6e3" :knowledge-point/title "Expressing a Predicate in Symbolic Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9761cddb-30b9-544c-902e-cd671ef7f4ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬S∧¬T" :db/id #edb/ref 17592186194797} {:answer/id #uuid "c9701e00-5817-50f8-99bd-76c2ed9d46aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬S∨¬T" :db/id #edb/ref 17592186194798} {:answer/id #uuid "1381a825-3588-566c-9738-47a9fd0e1858" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬S∧T" :db/id #edb/ref 17592186194799} {:answer/id #uuid "2c8827e0-322a-56a7-a5a5-bf1ea9c3d854" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "S∨¬T" :db/id #edb/ref 17592186194800} {:answer/id #uuid "7d7a82fc-5bb3-5772-bb01-ff3789114acc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬(S∧T)" :db/id #edb/ref 17592186194801}] :answer-field/correct {:answer/id #uuid "9761cddb-30b9-544c-902e-cd671ef7f4ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬S∧¬T" :db/id #edb/ref 17592186194797} :answer-field/id #uuid "ef409d9d-3c3e-5c95-8186-831ec7db1deb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186194796}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0ea9f330-973c-5d11-ab95-880720294ee8" :question/math-academy-id "q-170804" :question/problem "$\\,$ $x$ is neither irrational nor complex.\n\nExpress the compound predicate above in symbolic form given the following predicates:\n\n- $S(x):$ $x$ is irrational\n\n- $T(x):$ $x$ is complex" :question/worked-solution "The given sentence is equivalent to the following sentence: \n\n$\\,$ $x$ is not irrational, and $x$ is not complex.\n\nLet's break our sentence down into individual statements:\n\n- The statement \"$x$ is not irrational\" can be expressed symbolically as $¬S.$\n\n- The statement \"$x$ is not complex\" can be expressed symbolically as $¬T.$\n\nTherefore, the given sentence is expressed symbolically as\n\n$$\n¬S∧¬T.\n$$"}] [{:db/id #edb/ref 17592186414638 :knowledge-point/_questions [{:db/id #edb/ref 17592186198256 :knowledge-point/id #uuid "391d581f-9a2a-5de6-afbe-897917a9f6e3" :knowledge-point/title "Expressing a Predicate in Symbolic Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09946243-c028-5e7f-8b25-514f9c2e0d6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬P∧Q" :db/id #edb/ref 17592186414560} {:answer/id #uuid "36d9c635-98f4-50a7-9084-b27fd1cd7dc1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P∨¬Q" :db/id #edb/ref 17592186414569} {:answer/id #uuid "57e8b608-4f57-559c-8a1f-1675bb5ddfdf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬P∧¬Q" :db/id #edb/ref 17592186414577} {:answer/id #uuid "a171cab7-9fa1-55d4-8110-13c644e481ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬P∨¬Q" :db/id #edb/ref 17592186414592} {:answer/id #uuid "b0f29d7c-315f-5a24-a266-158da11791c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬P∨Q" :db/id #edb/ref 17592186414596}] :answer-field/correct {:answer/id #uuid "a171cab7-9fa1-55d4-8110-13c644e481ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬P∨¬Q" :db/id #edb/ref 17592186414592} :answer-field/id #uuid "341144b3-1818-536c-9899-1d2d9f504f70" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186414622}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "389aeeff-ffb8-5897-88a3-b12029287eb6" :question/math-academy-id "q-170808" :question/problem "$\\,$ $x$ is not positive, or $x$ is not odd.\n\nExpress the compound predicate above in symbolic form given the following predicates:\n\n- $P(x):$ $x$ is positive\n\n- $Q(x):$ $x$ is odd" :question/worked-solution "Let's break our sentence down into individual statements:\n\n- The sentence \"$x$ is not positive\" can be expressed symbolically as $¬P.$\n\n- The sentence \"$x$ is not odd\" can be expressed symbolically as $¬Q.$\n\nTherefore, the given sentence is expressed symbolically as \n\n$$\n¬P∨¬Q.\n$$"}] [{:db/id #edb/ref 17592186198727 :knowledge-point/_questions [{:db/id #edb/ref 17592186198258 :knowledge-point/id #uuid "c65d0713-5b7a-5559-bef7-7b238edc29ab" :knowledge-point/title "Negating a Disjunction Using De Morgan's Law"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33932fee-9b84-5ac2-80a4-e379807a1d82" :answer/type {:db/id #edb/ref 1759218