17592186045417] [17592186195006 #edb/ref 1075 #edb/ref 17592186528797 #edb/ref 17592186045417] [17592186195006 #edb/ref 1075 #edb/ref 17592186528892 #edb/ref 17592186045417] [17592186195006 #edb/ref 1076 #edb/ref 17592186045494 #edb/ref 17592186045417] [17592186195006 #edb/ref 1077 "field-3" #edb/ref 17592186045417] [17592186195006 #edb/ref 1078 #edb/ref 17592186528892 #edb/ref 17592186045417] [17592186195006 #edb/ref 1079 #uuid "143a1d71-d773-5457-b1f2-3156084212ab" #edb/ref 17592186045417] [17592186195010 #edb/ref 1075 #edb/ref 17592186195011 #edb/ref 17592186045417] [17592186195010 #edb/ref 1075 #edb/ref 17592186195012 #edb/ref 17592186045417] [17592186195010 #edb/ref 1076 #edb/ref 17592186045494 #edb/ref 17592186045417] [17592186195010 #edb/ref 1077 "field-2" #edb/ref 17592186045417] [17592186195010 #edb/ref 1078 #edb/ref 17592186195012 #edb/ref 17592186045417] [17592186195010 #edb/ref 1079 #uuid "53d6330f-59e6-5be0-b020-2923b8d7e01a" #edb/ref 17592186045417] [17592186195011 #edb/ref 1080 "or" #edb/ref 17592186045417] [17592186195011 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186195011 #edb/ref 1083 #uuid "a2fbfe43-27c6-5d11-9108-6a228dd37822" #edb/ref 17592186045417] [17592186195012 #edb/ref 1080 "and" #edb/ref 17592186045417] [17592186195012 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186195012 #edb/ref 1083 #uuid "3cf02772-3d95-5c50-a0c0-b9125b8110ea" #edb/ref 17592186045417] [17592186195013 #edb/ref 1075 #edb/ref 17592186528383 #edb/ref 17592186045417] [17592186195013 #edb/ref 1075 #edb/ref 17592186528615 #edb/ref 17592186045417] [17592186195013 #edb/ref 1075 #edb/ref 17592186528911 #edb/ref 17592186045417] [17592186195013 #edb/ref 1076 #edb/ref 17592186045494 #edb/ref 17592186045417] [17592186195013 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186195013 #edb/ref 1078 #edb/ref 17592186528911 #edb/ref 17592186045417] [17592186195013 #edb/ref 1079 #uuid "a323f4fc-fa80-5f84-a5c3-0b79be1b160f" #edb/ref 17592186045417] [17592186198105 #edb/ref 1069 "e-12734" #edb/ref 17592186045417] [17592186198105 #edb/ref 1071 "$\\qquad$ $x$ is prime and $y$ divides $12$.\n\nWhat is the negation of the composite predicate above?" #edb/ref 17592186045417] [17592186198105 #edb/ref 1072 #uuid "5b1d6912-85f0-5ac1-affb-6809d4525f29" #edb/ref 17592186045417] [17592186198105 #edb/ref 1074 "De Morgan's law for conjunctions states that\n\n$$\n\\neg ( A \\land B) = \\neg A \\lor \\neg B.\n$$\n\nSo, the negation of \"$x$ is prime and $y$ divides $12$\" is\n\n$$\n\\begin{aligned}¬(x\\text{ is prime and }y\\text{ divides }12) & ≡¬(x\\text{ is prime}∧y\\text{ divides }12) \\\\  & ≡¬(x\\text{ is prime})∨¬(y\\text{ divides }12) \\\\  & ≡x\\text{ is not prime}∨y\\text{ does not divide }12 \\\\  & ≡x\\text{ is not prime}\\text{ or }y\\text{ does not divide }12.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186198113 #edb/ref 1069 "e-12885" #edb/ref 17592186045417] [17592186198113 #edb/ref 1071 "$\\qquad$ $x$ is greater than $4,$ or $x$ is irrational.\n\nExpress the compound predicate above in symbolic form given the following predicates:\n\n- $P(x):$ $x$ is greater than $4$\n\n- $Q(x):$ $x$ is rational" #edb/ref 17592186045417] [17592186198113 #edb/ref 1072 #uuid "4402b53e-3c80-5788-b727-20941348c03f" #edb/ref 17592186045417] [17592186198113 #edb/ref 1074 "The sentence\n\n$\\qquad$ $x$ is irrational\n\ncan be expressed in symbolic form as $\\lnot Q.$\n\nTherefore, the given sentence is expressed symbolically as \n\n$$\nP\\lor \\lnot Q.\n$$" #edb/ref 17592186045417] [17592186198114 #edb/ref 1069 "e-12886" #edb/ref 17592186045417] [17592186198114 #edb/ref 1071 "$\\qquad$ $x$ is a multiple of $5$ or $y$ divides $24$.\n\nWhat is the negation of the composite predicate above?" #edb/ref 17592186045417] [17592186198114 #edb/ref 1072 #uuid "ed229458-dba0-5d6b-b32a-b70b253bc1f4" #edb/ref 17592186045417] [17592186198114 #edb/ref 1074 "De Morgan's law for disjunctions states that\n\n$$\n\\neg ( A \\lor B) = \\neg A \\land \\neg B.\n$$\n\nSo, the negation of \"$x$ is a multiple of $5$ or $y$ divides $24$\" is\n\n$$\n\\begin{aligned}¬(x\\text{ is a multiple of [math]5[/math] or }y\\text{ divides }24) & ≡¬(x\\text{ is a multiple of }5∨y\\text{ divides }24) \\\\  & ≡¬(x\\text{ is a multiple of }5)∧¬(y\\text{ divides }24) \\\\  & ≡x\\text{ is not a multiple of }5∧y\\text{ does not divide }24 \\\\  & ≡x\\text{ is not a multiple of }5\\text{ and }y\\text{ does not divide }24.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186198256 #edb/ref 1037 #edb/ref 17592186048378 #edb/ref 17592186045417] [17592186198256 #edb/ref 1037 #edb/ref 17592186049170 #edb/ref 17592186045417] [17592186198256 #edb/ref 1037 #edb/ref 17592186049546 #edb/ref 17592186045417] [17592186198256 #edb/ref 1038 #edb/ref 17592186198695 #edb/ref 17592186045417] [17592186198256 #edb/ref 1038 #edb/ref 17592186198696 #edb/ref 17592186045417] [17592186198256 #edb/ref 1038 #edb/ref 17592186414636 #edb/ref 17592186045417] [17592186198256 #edb/ref 1038 #edb/ref 17592186414637 #edb/ref 17592186045417] [17592186198256 #edb/ref 1038 #edb/ref 17592186414638 #edb/ref 17592186045417] [17592186198256 #edb/ref 1038 #edb/ref 17592186414642 #edb/ref 17592186045417] [17592186198256 #edb/ref 1038 #edb/ref 17592186529092 #edb/ref 17592186045417] [17592186198256 #edb/ref 1038 #edb/ref 17592186529187 #edb/ref 17592186045417] [17592186198256 #edb/ref 1039 "Expressing a Predicate in Symbolic Form" #edb/ref 17592186045417] [17592186198256 #edb/ref 1041 #edb/ref 17592186198113 #edb/ref 17592186045417] [17592186198256 #edb/ref 1042 #uuid "391d581f-9a2a-5de6-afbe-897917a9f6e3" #edb/ref 17592186045417] [17592186198257 #edb/ref 1038 #edb/ref 17592186198725 #edb/ref 17592186045417] [17592186198257 #edb/ref 1038 #edb/ref 17592186198726 #edb/ref 17592186045417] [17592186198257 #edb/ref 1038 #edb/ref 17592186414639 #edb/ref 17592186045417] [17592186198257 #edb/ref 1038 #edb/ref 17592186414641 #edb/ref 17592186045417] [17592186198257 #edb/ref 1038 #edb/ref 17592186529094 #edb/ref 17592186045417] [17592186198257 #edb/ref 1038 #edb/ref 17592186529099 #edb/ref 17592186045417] [17592186198257 #edb/ref 1038 #edb/ref 17592186529120 #edb/ref 17592186045417] [17592186198257 #edb/ref 1038 #edb/ref 17592186529161 #edb/ref 17592186045417] [17592186198257 #edb/ref 1038 #edb/ref 17592186529171 #edb/ref 17592186045417] [17592186198257 #edb/ref 1039 "Negating a Conjunction Using De Morgan's Law" #edb/ref 17592186045417] [17592186198257 #edb/ref 1041 #edb/ref 17592186198105 #edb/ref 17592186045417] [17592186198257 #edb/ref 1042 #uuid "28cb0c9e-bf5a-5cab-9147-77e827e21bb2" #edb/ref 17592186045417] [17592186198258 #edb/ref 1038 #edb/ref 17592186198727 #edb/ref 17592186045417] [17592186198258 #edb/ref 1038 #edb/ref 17592186198728 #edb/ref 17592186045417] [17592186198258 #edb/ref 1038 #edb/ref 17592186414635 #edb/ref 17592186045417] [17592186198258 #edb/ref 1038 #edb/ref 17592186414640 #edb/ref 17592186045417] [17592186198258 #edb/ref 1038 #edb/ref 17592186529121 #edb/ref 17592186045417] [17592186198258 #edb/ref 1038 #edb/ref 17592186529128 #edb/ref 17592186045417] [17592186198258 #edb/ref 1038 #edb/ref 17592186529195 #edb/ref 17592186045417] [17592186198258 #edb/ref 1039 "Negating a Disjunction Using De Morgan's Law" #edb/ref 17592186045417] [17592186198258 #edb/ref 1041 #edb/ref 17592186198114 #edb/ref 17592186045417] [17592186198258 #edb/ref 1042 #uuid "c65d0713-5b7a-5559-bef7-7b238edc29ab" #edb/ref 17592186045417] [17592186198518 #edb/ref 1043 #edb/ref 17592186199047 #edb/ref 17592186045417] [17592186198518 #edb/ref 1043 #edb/ref 17592186199048 #edb/ref 17592186045417] [17592186198518 #edb/ref 1043 #edb/ref 17592186199049 #edb/ref 17592186045417] [17592186198518 #edb/ref 1043 #edb/ref 17592186199050 #edb/ref 17592186045417] [17592186198518 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186198518 #edb/ref 1045 "Simplifying Predicate Expressions Using De Morgan's Laws" #edb/ref 17592186045417] [17592186198518 #edb/ref 1046 #edb/ref 17592186199047 #edb/ref 17592186045417] [17592186198518 #edb/ref 1049 #edb/ref 17592186050747 #edb/ref 17592186045417] [17592186198518 #edb/ref 1050 420.0 #edb/ref 17592186045417] [17592186198518 #edb/ref 1053 #uuid "f34a1f9e-dc25-5a56-b69f-2cc175647229" #edb/ref 17592186045417] [17592186198695 #edb/ref 1068 #edb/ref 17592186194796 #edb/ref 17592186045417] [17592186198695 #edb/ref 1069 "q-170804" #edb/ref 17592186045417] [17592186198695 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186198695 #edb/ref 1071 "$\\,$ $x$ is neither irrational nor complex.\n\nExpress the compound predicate above in symbolic form given the following predicates:\n\n- $S(x):$ $x$ is irrational\n\n- $T(x):$ $x$ is complex" #edb/ref 17592186045417] [17592186198695 #edb/ref 1072 #uuid "0ea9f330-973c-5d11-ab95-880720294ee8" #edb/ref 17592186045417] [17592186198695 #edb/ref 1074 "The given sentence is equivalent to the following sentence: \n\n$\\,$ $x$ is not irrational, and $x$ is not complex.\n\nLet's break our sentence down into individual statements:\n\n- The statement \"$x$ is not irrational\" can be expressed symbolically as $¬S.$\n\n- The statement \"$x$ is not complex\" can be expressed symbolically as $¬T.$\n\nTherefore, the given sentence is expressed symbolically as\n\n$$\n¬S∧¬T.\n$$" #edb/ref 17592186045417] [17592186198727 #edb/ref 1068 #edb/ref 17592186414623 #edb/ref 17592186045417] [17592186198727 #edb/ref 1068 #edb/ref 17592186414628 #edb/ref 17592186045417] [17592186198727 #edb/ref 1068 #edb/ref 17592186414630 #edb/ref 17592186045417] [17592186198727 #edb/ref 1069 "q-175329" #edb/ref 17592186045417] [17592186198727 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186198727 #edb/ref 1071 "$\\,$ $a$ is even or $b$ is odd.\n\nThe negation of the composite predicate above is the following:\n\n$\\,$ \n{{field-1}}{{field-2}}{{field-3}}" #edb/ref 17592186045417] [17592186198727 #edb/ref 1072 #uuid "078171ae-79c8-5810-aaf2-bebda0bbeadd" #edb/ref 17592186045417] [17592186198727 #edb/ref 1074 "De Morgan's law for disjunctions states that\n\n$$\n¬(A∨B)=¬A∧¬B.\n$$\n\nSo, the negation of \"$a$ is even or $b$ is odd\" is\n\n$$\n\\begin{aligned}¬(a\\text{ is even or }b\\text{ is odd }) & ≡¬(a\\text{ is even }∨b\\text{ is odd }) \\\\  & ≡¬(a\\text{ is even })∧¬(b\\text{ is odd }) \\\\  & ≡a\\text{ is odd }∧b\\text{ is even } \\\\  & ≡a\\text{ is odd and }b\\text{ is even}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186198728 #edb/ref 1068 #edb/ref 17592186195006 #edb/ref 17592186045417] [17592186198728 #edb/ref 1068 #edb/ref 17592186195010 #edb/ref 17592186045417] [17592186198728 #edb/ref 1068 #edb/ref 17592186195013 #edb/ref 17592186045417] [17592186198728 #edb/ref 1069 "q-175331" #edb/ref 17592186045417] [17592186198728 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186198728 #edb/ref 1071 "$\\,$ $a<2\\text{ or }b\\le 1.$\n\nThe negation of the composite predicate above is the following:\n\n$\\,$ \n{{field-1}}{{field-2}}{{field-3}}" #edb/ref 17592186045417] [17592186198728 #edb/ref 1072 #uuid "e4569a89-5769-5a01-b0e6-91edf3c2b7e1" #edb/ref 17592186045417] [17592186198728 #edb/ref 1074 "De Morgan's law for disjunctions states that\n\n$$\n¬(A∨B)=¬A∧¬B.\n$$\n\nSo, the negation of \"$a<2\\text{ or }b\\le 1$\" is\n\n$$\n\\begin{aligned}¬(a<2\\text{ or }b\\le 1) & ≡¬(a<2∨b\\le 1) \\\\  & ≡¬(a<2)∧¬(b\\le 1) \\\\  & ≡a\\ge 2∧b>1 \\\\  & ≡a\\ge 2\\text{ and }b>1.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186199047 #edb/ref 1058 #edb/ref 17592186199048 #edb/ref 17592186045417] [17592186199047 #edb/ref 1061 143820 #edb/ref 17592186045417] [17592186199047 #edb/ref 1062 #uuid "d42da4d8-71de-5617-a193-de6538fc1c98" #edb/ref 17592186045417] [17592186199047 #edb/ref 1063 #edb/ref 17592186199524 #edb/ref 17592186045417] [17592186199048 #edb/ref 1058 #edb/ref 17592186199049 #edb/ref 17592186045417] [17592186199048 #edb/ref 1061 143821 #edb/ref 17592186045417] [17592186199048 #edb/ref 1062 #uuid "039cf98e-03ec-569f-b5a1-bd97dbc07419" #edb/ref 17592186045417] [17592186199048 #edb/ref 1063 #edb/ref 17592186198256 #edb/ref 17592186045417] [17592186199049 #edb/ref 1058 #edb/ref 17592186199050 #edb/ref 17592186045417] [17592186199049 #edb/ref 1061 143824 #edb/ref 17592186045417] [17592186199049 #edb/ref 1062 #uuid "c2a6fe5e-56b3-5f92-9b04-22194ce9fabd" #edb/ref 17592186045417] [17592186199049 #edb/ref 1063 #edb/ref 17592186198257 #edb/ref 17592186045417] [17592186199050 #edb/ref 1061 143827 #edb/ref 17592186045417] [17592186199050 #edb/ref 1062 #uuid "1c572864-399d-5930-9178-c0590397d869" #edb/ref 17592186045417] [17592186199050 #edb/ref 1063 #edb/ref 17592186198258 #edb/ref 17592186045417] [17592186199524 #edb/ref 1064 "Logical operations with predicates generalize the corresponding operations on statements. As a result, all the properties of these operations are held.\n\nIn particular, for predicates $P(x_1,x_2\\ldots,x_n)$ and $Q(y_1,y_2\\ldots,y_m),$ De Morgan's laws state the following:\n\n$$\n\\begin{aligned}¬(P∧Q) & ≡¬P∨¬Q \\\\ ¬(P∨Q) & ≡¬P∧¬Q\\end{aligned}\n$$\n\nThese can be used to negate open sentences containing conjunctions and disjunctions. For example, let's negate the following:\n\n$$\nn \\ge 0 \\:\\textbf{ or }\\: 2 \\mid m\n$$\n\nApplying De Morgan's law for disjunctions, we obtain\n\n$$\n\\begin{aligned}¬(n\\ge 0\\,\\text{ or }\\,2∣m) & ≡¬(n\\ge 0∨2∣m) \\\\  & ≡¬(n\\ge 0)∧¬(2∣m) \\\\  & ≡n<0∧2∤m \\\\  & ≡n<0\\,\\text{ and }\\,2∤m.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186199524 #edb/ref 1065 7990 #edb/ref 17592186045417] [17592186199524 #edb/ref 1066 #uuid "476f8b41-cb95-5623-94e3-dc7a863c3df5" #edb/ref 17592186045417] [17592186199524 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186414560 #edb/ref 1080 "¬P∧Q" #edb/ref 17592186045417] [17592186414560 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186414560 #edb/ref 1083 #uuid "09946243-c028-5e7f-8b25-514f