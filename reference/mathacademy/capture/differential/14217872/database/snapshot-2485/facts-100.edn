f 1069 "q-183300" #edb/ref 17592186045417] [17592186529094 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186529094 #edb/ref 1071 "$\\,$ $a<8$ and $a>2.$\n\nThe negation of the composite predicate above is the following:\n\n$\\,$ \n{{field-1}}{{field-2}}{{field-3}}" #edb/ref 17592186045417] [17592186529094 #edb/ref 1072 #uuid "16975edf-5610-5167-bf92-0dd71021b831" #edb/ref 17592186045417] [17592186529094 #edb/ref 1074 "De Morgan's law for conjunctions states that\n\n$$\n¬(A∧B)=¬A∨¬B.\n$$\n\nSo, the negation of \"$a<8$ and $a>2$ \" is\n\n$$\n\\begin{aligned}¬(a<8\\text{ and }a>2) & ≡¬(a<8∧a>2) \\\\  & ≡¬(a<8)∨¬(a>2) \\\\  & ≡a\\ge 8∨a\\le 2 \\\\  & ≡a\\ge 8\\text{ or }a\\le 2.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186529099 #edb/ref 1068 #edb/ref 17592186528962 #edb/ref 17592186045417] [17592186529099 #edb/ref 1068 #edb/ref 17592186529011 #edb/ref 17592186045417] [17592186529099 #edb/ref 1068 #edb/ref 17592186529084 #edb/ref 17592186045417] [17592186529099 #edb/ref 1069 "q-183297" #edb/ref 17592186045417] [17592186529099 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186529099 #edb/ref 1071 "$\\,$ $x\\le 0\\text{ and }y$ is odd.\n\nThe negation of the composite predicate above is the following:\n\n$\\,$ \n{{field-1}}{{field-2}}{{field-3}}" #edb/ref 17592186045417] [17592186529099 #edb/ref 1072 #uuid "1e781df2-007a-5016-ba10-713cbfb69f20" #edb/ref 17592186045417] [17592186529099 #edb/ref 1074 "De Morgan's law for conjunctions states that\n\n$$\n¬(A∧B)=¬A∨¬B.\n$$\n\nSo, the negation of \"$x\\le 0\\text{ and }y$ is odd\" is\n\n$$\n\\begin{aligned}¬(x\\le 0\\text{ and }y\\text{ is odd}) & ≡¬(x\\le 0∧y\\text{ is odd}) \\\\  & ≡¬(x\\le 0)∨¬(y\\text{ is odd}) \\\\  & ≡x>0∨y\\text{ is even} \\\\  & ≡x>0\\text{ or }y\\text{ is even}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186529120 #edb/ref 1068 #edb/ref 17592186529012 #edb/ref 17592186045417] [17592186529120 #edb/ref 1068 #edb/ref 17592186529024 #edb/ref 17592186045417] [17592186529120 #edb/ref 1068 #edb/ref 17592186529085 #edb/ref 17592186045417] [17592186529120 #edb/ref 1069 "q-183299" #edb/ref 17592186045417] [17592186529120 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186529120 #edb/ref 1071 "$\\,$ $x\\le \\frac{1}{3}\\text{ and }y>\\frac{1}{2}.$\n\nThe negation of the composite predicate above is the following:\n\n$\\,$ \n{{field-1}}{{field-2}}{{field-3}}" #edb/ref 17592186045417] [17592186529120 #edb/ref 1072 #uuid "4e83f3e0-1564-59fb-a764-5da5f052add0" #edb/ref 17592186045417] [17592186529120 #edb/ref 1074 "De Morgan's law for conjunctions states that\n\n$$\n¬(A∧B)=¬A∨¬B.\n$$\n\nSo, the negation of \"$x\\le \\frac{1}{3}\\text{ and }y>\\frac{1}{2}$\" is\n\n$$\n\\begin{aligned}¬(x\\le \\frac{1}{3}\\text{ and }y>\\frac{1}{2}) & ≡¬(x\\le \\frac{1}{3}∧y>\\frac{1}{2}) \\\\  & ≡¬(x\\le \\frac{1}{3})∨¬(y>\\frac{1}{2}) \\\\  & ≡x>\\frac{1}{3}∨y\\le \\frac{1}{2} \\\\  & ≡x>\\frac{1}{3}\\text{ or }y\\le \\frac{1}{2}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186529121 #edb/ref 1068 #edb/ref 17592186528988 #edb/ref 17592186045417] [17592186529121 #edb/ref 1068 #edb/ref 17592186529030 #edb/ref 17592186045417] [17592186529121 #edb/ref 1068 #edb/ref 17592186529053 #edb/ref 17592186045417] [17592186529121 #edb/ref 1069 "q-183346" #edb/ref 17592186045417] [17592186529121 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186529121 #edb/ref 1071 "$\\,$ $x=2$ or $y\\ne -2.$\n\nThe negation of the composite predicate above is the following:\n\n$\\,$ \n{{field-1}}{{field-2}}{{field-3}}" #edb/ref 17592186045417] [17592186529121 #edb/ref 1072 #uuid "502d8fb9-af55-51a0-accb-d73687bf175c" #edb/ref 17592186045417] [17592186529121 #edb/ref 1074 "De Morgan's law for disjunctions states that\n\n$$\n¬(A∨B)=¬A∧¬B.\n$$\n\nSo, the negation of \"$x=2$ or $y\\ne -2$\" is\n\n$$\n\\begin{aligned}¬(x=2\\text{ or }y\\ne -2) & ≡¬(x=2∨y\\ne -2) \\\\  & ≡¬(x=2)∧¬(y\\ne -2) \\\\  & ≡x\\ne 2∧y=-2 \\\\  & ≡x\\ne 2\\text{ and }y=-2.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186529128 #edb/ref 1068 #edb/ref 17592186529005 #edb/ref 17592186045417] [17592186529128 #edb/ref 1068 #edb/ref 17592186529036 #edb/ref 17592186045417] [17592186529128 #edb/ref 1068 #edb/ref 17592186529051 #edb/ref 17592186045417] [17592186529128 #edb/ref 1069 "q-183313" #edb/ref 17592186045417] [17592186529128 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186529128 #edb/ref 1071 "$\\,$ $n<0\\text{ or }m>-5.$\n\nThe negation of the composite predicate above is the following:\n\n$\\,$ \n{{field-1}}{{field-2}}{{field-3}}" #edb/ref 17592186045417] [17592186529128 #edb/ref 1072 #uuid "5a6263d9-7a39-5199-9f93-7ac1161cd5e5" #edb/ref 17592186045417] [17592186529128 #edb/ref 1074 "De Morgan's law for disjunctions states that\n\n$$\n¬(A∨B)=¬A∧¬B.\n$$\n\nSo, the negation of \"$n<0\\text{ or }m>-5$\" is\n\n$$\n\\begin{aligned}¬(n<0\\text{ or }m>-5) & ≡¬(n<0∨m>-5) \\\\  & ≡¬(n<0)∧¬(m>-5) \\\\  & ≡n\\ge 0∧m\\le -5 \\\\  & ≡n\\ge 0\\text{ and }m\\le -5.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186529161 #edb/ref 1068 #edb/ref 17592186528975 #edb/ref 17592186045417] [17592186529161 #edb/ref 1068 #edb/ref 17592186528980 #edb/ref 17592186045417] [17592186529161 #edb/ref 1068 #edb/ref 17592186529069 #edb/ref 17592186045417] [17592186529161 #edb/ref 1069 "q-183293" #edb/ref 17592186045417] [17592186529161 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186529161 #edb/ref 1071 "$\\,$ $a$ is odd and $b$ is odd.\n\nThe negation of the composite predicate above is the following:\n\n$\\,$ \n{{field-1}}{{field-2}}{{field-3}}" #edb/ref 17592186045417] [17592186529161 #edb/ref 1072 #uuid "af2842e6-dea4-50ab-b263-09b224915c23" #edb/ref 17592186045417] [17592186529161 #edb/ref 1074 "De Morgan's law for conjunctions states that\n\n$$\n¬(A∧B)=¬A∨¬B.\n$$\n\nSo, the negation of \"$a$ is odd and $b$ is odd\" is\n\n$$\n\\begin{aligned}¬(a\\text{ is odd and }b\\text{ is odd}) & ≡¬(a\\text{ is odd}∧b\\text{ is odd}) \\\\  & ≡¬(a\\text{ is odd})∨¬(b\\text{ is odd}) \\\\  & ≡a\\text{ is even}∨b\\text{ is even} \\\\  & ≡a\\text{ is even or }b\\text{ is even}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186529171 #edb/ref 1068 #edb/ref 17592186528943 #edb/ref 17592186045417] [17592186529171 #edb/ref 1068 #edb/ref 17592186528957 #edb/ref 17592186045417] [17592186529171 #edb/ref 1068 #edb/ref 17592186529004 #edb/ref 17592186045417] [17592186529171 #edb/ref 1069 "q-183283" #edb/ref 17592186045417] [17592186529171 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186529171 #edb/ref 1071 "$\\,$ $x$  is even and $y$ is prime.\n\nThe negation of the composite predicate above is the following:\n\n$\\,$ \n{{field-1}}{{field-2}}{{field-3}}" #edb/ref 17592186045417] [17592186529171 #edb/ref 1072 #uuid "cd5faa7d-a0da-5855-abab-cb9f9cd47a6c" #edb/ref 17592186045417] [17592186529171 #edb/ref 1074 "De Morgan's law for conjunctions states that\n\n$$\n¬(A∧B)=¬A∨¬B.\n$$\n\nSo, the negation of \"$x$  is even and $y$ is prime\" is\n\n$$\n\\begin{aligned}¬(x\\text{ is even and }y\\text{ is prime}) & ≡¬(x\\text{ is even}∧y\\text{ is prime}) \\\\  & ≡¬(x\\text{ is even})∨¬(y\\text{ is prime}) \\\\  & ≡x\\text{ is odd}∨y\\text{ is not prime} \\\\  & ≡x\\text{ is odd or }y\\text{ is not prime}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186529187 #edb/ref 1068 #edb/ref 17592186529066 #edb/ref 17592186045417] [17592186529187 #edb/ref 1069 "q-183280" #edb/ref 17592186045417] [17592186529187 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186529187 #edb/ref 1071 "$\\,$ $x$ is not an even integer, and $x$ divides $50.$\n\nExpress the compound predicate above in symbolic form given the following:\n\n- $C(x):$ $x$ is an even integer\n\n- $D(x):$ $x$ divides $50$" #edb/ref 17592186045417] [17592186529187 #edb/ref 1072 #uuid "e78ca7a7-d4e4-5c94-b10c-7178217e2c2b" #edb/ref 17592186045417] [17592186529187 #edb/ref 1074 "The sentence \n\n$\\,$ $x$ is not an even integer.\n\ncan be expressed symbolically as $¬C.$\n\nTherefore, the given sentence is expressed symbolically as \n\n$$\n¬C∧D.\n$$" #edb/ref 17592186045417] [17592186529195 #edb/ref 1068 #edb/ref 17592186528989 #edb/ref 17592186045417] [17592186529195 #edb/ref 1068 #edb/ref 17592186528996 #edb/ref 17592186045417] [17592186529195 #edb/ref 1068 #edb/ref 17592186529044 #edb/ref 17592186045417] [17592186529195 #edb/ref 1069 "q-183306" #edb/ref 17592186045417] [17592186529195 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186529195 #edb/ref 1071 "$\\,$ $n$ is positive or $m$ is negative.\n\nThe negation of the composite predicate above is the following:\n\n$\\,$ \n{{field-1}}{{field-2}}{{field-3}}" #edb/ref 17592186045417] [17592186529195 #edb/ref 1072 #uuid "fbeaf179-7e47-5b15-8eb5-f5fa351b4082" #edb/ref 17592186045417] [17592186529195 #edb/ref 1074 "De Morgan's law for disjunctions states that\n\n$$\n¬(A∨B)=¬A∧¬B.\n$$\n\nSo, the negation of \"$n$ is positive or $m$ is negative\" is\n\n$$\n\\begin{aligned}¬(n\\text{ is positive or }m\\text{ is negative }) & ≡¬(n\\text{ is positive}∨m\\text{ is negative }) \\\\  & ≡¬(n\\text{ is positive})∧¬(m\\text{ is negative }) \\\\  & ≡n\\text{ is not positive}∧m\\text{ is not negative} \\\\  & ≡n\\text{ is not positive and }m\\text{ is not negative}.\\end{aligned}\n$$" #edb/ref 17592186045417]}
