ariant=\"normal\">¬</mi><mo stretchy=\"false\">(</mo><mi>y</mi><mtext>&nbsp;is prime</mtext><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>≡</mo><mi>x</mi><mtext>&nbsp;is odd</mtext><mo>∨</mo><mi>y</mi><mtext>&nbsp;is not prime</mtext></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>≡</mo><mi>x</mi><mtext>&nbsp;is odd or&nbsp;</mtext><mi>y</mi><mtext>&nbsp;is not prime</mtext><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
