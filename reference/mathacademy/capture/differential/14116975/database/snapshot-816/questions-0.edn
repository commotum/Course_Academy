#{[{:db/id #edb/ref 17592186119612 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186119801 :knowledge-point/id #uuid "1ce19559-0f08-5ef7-9ce4-58e8e14094ab" :knowledge-point/title "Calculating a Multiple of a Vector"}] :question/id #uuid "13fa2a8c-de7c-59ee-a838-2997494edc56" :question/math-academy-id "e-4782" :question/problem "Let $[\\begin{aligned}-4 \\\\ 6 \\\\ 3 \\\\ 0\\end{aligned}]$ Find $\\dfrac{1}{2} \\mathbf{a}.$" :question/worked-solution "Multiplying each component of $\\mathbf{a}$ by $\\dfrac{1}{2},$ we get\n\n$$\n\\begin{aligned}\\frac{1}{2}a & =\\frac{1}{2}[\\begin{aligned}-4 \\\\ 6 \\\\ 3 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{2}\\cdot (-4) \\\\ \\frac{1}{2}\\cdot 6 \\\\ \\frac{1}{2}\\cdot 3 \\\\ \\frac{1}{2}\\cdot 0\\end{aligned}] \\\\  & =[\\begin{aligned}-2 \\\\ 3 \\\\ \\frac{3}{2} \\\\ 0\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186119613 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186119802 :knowledge-point/id #uuid "ab0d2c2f-e7a4-51bb-a20a-f28c2f7ded8b" :knowledge-point/title "Adding Multiples of Vectors"}] :question/id #uuid "1e82713d-4063-5bcd-bc2e-1d35c831ab34" :question/math-academy-id "e-4783" :question/problem "Let $[\\begin{aligned}-3 \\\\ 6 \\\\ 12 \\\\ -9 \\\\ 3\\end{aligned}]$ and $[\\begin{aligned}-4 \\\\ -6 \\\\ 2 \\\\ -8 \\\\ 10\\end{aligned}]$ Find $\\dfrac{1}{3}\\mathbf{a}+\\dfrac{1}{2}\\mathbf{b}.$" :question/worked-solution "First, we multiply each component of $\\mathbf{a}$ by $\\dfrac{1}{3}$ and each component of $\\mathbf{b}$ by $\\dfrac{1}{2}.$ Then, we add the vectors:\n\n$$\n\\begin{aligned}\\frac{1}{3}a+\\frac{1}{2}b & =\\frac{1}{3}\\cdot [\\begin{aligned}-3 \\\\ 6 \\\\ 12 \\\\ -9 \\\\ 3\\end{aligned}]+\\frac{1}{2}\\cdot [\\begin{aligned}-4 \\\\ -6 \\\\ 2 \\\\ -8 \\\\ 10\\end{aligned}] \\\\  & =[\\begin{aligned}-1 \\\\ 2 \\\\ 4 \\\\ -3 \\\\ 1\\end{aligned}]+[\\begin{aligned}-2 \\\\ -3 \\\\ 1 \\\\ -4 \\\\ 5\\end{aligned}] \\\\  & =[\\begin{aligned}-1-2 \\\\ 2-3 \\\\ 4+1 \\\\ -3-4 \\\\ 1+5\\end{aligned}] \\\\  & =[\\begin{aligned}-3 \\\\ -1 \\\\ 5 \\\\ -7 \\\\ 6\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186119614 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186119803 :knowledge-point/id #uuid "ec386a91-fc52-56d8-8531-7e78a8464380" :knowledge-point/title "Calculating the Dot Product of Two Vectors"}] :question/id #uuid "ba38ff28-b4f3-59b8-b18a-a278db26294d" :question/math-academy-id "e-4784" :question/problem "If $[\\begin{aligned}-1 \\\\ 4 \\\\ 3 \\\\ -5\\end{aligned}]$ and $[\\begin{aligned}-2 \\\\ 3 \\\\ -4 \\\\ 6\\end{aligned}]$ then what is $\\mathbf{u} \\cdot \\mathbf{v}?$" :question/worked-solution "To compute the dot product, we add up the products of corresponding components:\n\n$$\n\\begin{aligned}u\\cdot v & ={u}_{1}\\cdot {v}_{1}+{u}_{2}\\cdot {v}_{2}+{u}_{3}\\cdot {v}_{3}+{u}_{4}\\cdot {v}_{4} \\\\  & =(-1)\\cdot (-2)+4\\cdot 3+3\\cdot (-4)+(-5)\\cdot 6 \\\\  & =2+12-12-30 \\\\  & =-28\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186119615 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186119804 :knowledge-point/id #uuid "94f8e0e5-8d8a-516a-8f46-d76e94305df4" :knowledge-point/title "Finding the Value of an Unknown Quantity in an Expression Involving the Dot Product"}] :question/id #uuid "3ec5f9d5-327b-59e5-8df7-fb37d4054021" :question/math-academy-id "e-4785" :question/problem "Let be $[\\begin{aligned}10 \\\\ x \\\\ 0 \\\\ 5\\end{aligned}]$ and $[\\begin{aligned}x \\\\ x \\\\ 8 \\\\ 5\\end{aligned}]$ If $\\mathbf{a}\\cdot \\mathbf{b}=0,$ find the value of $x.$" :question/worked-solution "Starting from the equation $\\mathbf{a} \\cdot \\mathbf{b}=0,$ we compute the dot product in terms of $x$ and then solve for $x$ in the resulting equation:\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ 10\\cdot x+x\\cdot x+0\\cdot 8+5\\cdot 5 & =0 \\\\ 10x+{x}^{2}+25 & =0 \\\\ {x}^{2}+10x+25 & =0 \\\\ (x+5)^{2} & =0 \\\\ x & =-5\\end{aligned}\n$$\n\nTherefore, we conclude that $x=-5.$"}] [{:db/id #edb/ref 17592186240981 :knowledge-point/_questions [{:db/id #edb/ref 17592186119804 :knowledge-point/id #uuid "94f8e0e5-8d8a-516a-8f46-d76e94305df4" :knowledge-point/title "Finding the Value of an Unknown Quantity in an Expression Involving the Dot Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "54e58be2-4e32-5258-bd0c-01ba1157ee0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186238790} {:answer/id #uuid "b131cb64-b68b-5ca8-980d-6e034b5c073b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186239599} {:answer/id #uuid "b1f5df45-32d5-5280-bed5-22ab6e49e949" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186239609} {:answer/id #uuid "cbc7bb04-50b6-56c9-b0a1-e0166da12814" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186239843} {:answer/id #uuid "cf09e1dc-012c-5dd4-b758-810b8fd23f0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186239870}] :answer-field/correct {:answer/id #uuid "b131cb64-b68b-5ca8-980d-6e034b5c073b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186239599} :answer-field/id #uuid "5983a6d6-b5cf-57c3-906e-db2469649f2e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240497}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6e7f4244-4c14-5e9e-9a61-e81225c2df8e" :question/math-academy-id "q-105110" :question/problem "Let\n$p=[\\begin{aligned}9 \\\\ y-3 \\\\ 3 \\\\ 4\\end{aligned}]$ and $q=[\\begin{aligned}0 \\\\ 1 \\\\ -4 \\\\ y\\end{aligned}].$\nIf $p\\cdot q=0$, find the value of $y.$" :question/worked-solution "Starting from the equation $p\\cdot q=0,$ we compute the dot product in terms of $y$ and then solve for $y$ in the resulting equation:\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 9\\cdot 0+(y-3)\\cdot 1+3\\cdot (-4)+4\\cdot y & =0 \\\\ y-3-12+4y & =0 \\\\ 5y & =15 \\\\ y & =3\\end{aligned}\n$$\n\nTherefore, we conclude that $y=3.$"}] [{:db/id #edb/ref 17592186240982 :knowledge-point/_questions [{:db/id #edb/ref 17592186119804 :knowledge-point/id #uuid "94f8e0e5-8d8a-516a-8f46-d76e94305df4" :knowledge-point/title "Finding the Value of an Unknown Quantity in an Expression Involving the Dot Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19f9ee1e-f2c2-5303-b8dc-9cdfa7731d92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186238270} {:answer/id #uuid "5bc8db62-8e48-544b-a11b-42d29b1acec0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186238855} {:answer/id #uuid "a091ffe0-e463-5a4d-b6c4-c8708086574d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186239456} {:answer/id #uuid "e603a7f6-ed0f-5e41-953d-aee4342f9b0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186240075} {:answer/id #uuid "f44ca4d2-9778-58c2-b8d0-b4294e16408d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186240210}] :answer-field/correct {:answer/id #uuid "e603a7f6-ed0f-5e41-953d-aee4342f9b0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186240075} :answer-field/id #uuid "b4d76763-6087-50d8-9faf-b8766baee879" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240645}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "867e51c8-e30e-5507-8d8a-5cfe942a4fb9" :question/math-academy-id "q-105113" :question/problem "Let $u=[\\begin{aligned}7 \\\\ 9 \\\\ 3t \\\\ 1 \\\\ -1\\end{aligned}]$ and $v=[\\begin{aligned}t \\\\ 2 \\\\ -5 \\\\ {t}^{2} \\\\ 5\\end{aligned}].$\nIf $u\\cdot v=-2$ and $t>3$, find the value of $t.$" :question/worked-solution "Starting from the equation $u\\cdot v=-2,$ we compute the dot product in terms of $t$ and then solve for $t$ in the resulting equation:\n\n$$\n\\begin{aligned}u\\cdot v & =-2 \\\\ 7\\cdot t+9\\cdot 2+3t\\cdot (-5)+1\\cdot {t}^{2}+(-1)\\cdot 5 & =-2 \\\\ 7t+18-15t+{t}^{2}-5 & =-2 \\\\ {t}^{2}-8t+15 & =0 \\\\ (t-3)(t-5) & =0\\end{aligned}\n$$\n\nWe get two solutions, ${t}_{1}=3$ and ${t}_{2}=5.$ Since we need $t>3$, our final answer is $t=5$ only."}] [{:db/id #edb/ref 17592186391769 :knowledge-point/_questions [{:db/id #edb/ref 17592186119802 :knowledge-point/id #uuid "ab0d2c2f-e7a4-51bb-a20a-f28c2f7ded8b" :knowledge-point/title "Adding Multiples of Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "96fe8ea5-6816-5080-896c-06099a363468" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-5 \\\\ 2 \\\\ 4 \\\\ 11\\end{aligned}]" :db/id #edb/ref 17592186391771} {:answer/id #uuid "3a2e0c2f-6803-55a5-a5f2-e054623d8ce1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-5 \\\\ 4 \\\\ 2 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186391772} {:answer/id #uuid "29c4b51b-0698-508e-a6f7-8d02ca0c1eee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 \\\\ 2 \\\\ 6 \\\\ -3\\end{aligned}]" :db/id #edb/ref 17592186391773} {:answer/id #uuid "daf1ae0f-726d-57c8-8c92-a3fce61a6349" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :ans