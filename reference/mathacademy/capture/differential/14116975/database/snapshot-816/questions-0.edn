\cdot 0 \\\\ -\\frac{1}{2}\\cdot (-2) \\\\ -\\frac{1}{2}\\cdot 6\\end{aligned}] \\\\  & =[\\begin{aligned}-4 \\\\ 0 \\\\ 1 \\\\ -3\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186317166 :knowledge-point/_questions [{:db/id #edb/ref 17592186119803 :knowledge-point/id #uuid "ec386a91-fc52-56d8-8531-7e78a8464380" :knowledge-point/title "Calculating the Dot Product of Two Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0373b669-29cd-5c16-8bc6-f02ee7222dbd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186315137} {:answer/id #uuid "1010c872-1dbe-5ad7-aa5e-04bf801caf2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186315215} {:answer/id #uuid "5bcc56b2-3f31-58e4-b7df-97c4e5d7ba00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-28" :db/id #edb/ref 17592186315641} {:answer/id #uuid "fca4573c-fd77-51c7-a278-367a2a4368b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-37" :db/id #edb/ref 17592186316531} {:answer/id #uuid "fd8d6616-4916-5fe9-887f-0c8f19cd70f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186316536}] :answer-field/correct {:answer/id #uuid "fca4573c-fd77-51c7-a278-367a2a4368b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-37" :db/id #edb/ref 17592186316531} :answer-field/id #uuid "491bf6ee-6889-5481-aa4d-ef6f66809b5c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186316715}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4c73928d-449b-56dc-94fe-ffe1e5cb8e3f" :question/math-academy-id "q-34166" :question/problem "If $p=[\\begin{aligned}-5 \\\\ 4 \\\\ -1 \\\\ 3 \\\\ -2\\end{aligned}]$ and $q=[\\begin{aligned}2 \\\\ -1 \\\\ 4 \\\\ -3 \\\\ 5\\end{aligned}]$, then $p\\cdot q=$" :question/worked-solution "To compute the dot product, we add up the products of corresponding components:\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{1}\\cdot {q}_{1}+{p}_{2}\\cdot {q}_{2}+{p}_{3}\\cdot {q}_{3}+{p}_{4}\\cdot {q}_{4}+{p}_{5}\\cdot {q}_{5} \\\\  & =(-5)\\cdot 2+4\\cdot (-1)+(-1)\\cdot 4+3\\cdot (-3)+(-2)\\cdot 5 \\\\  & =-10-4-4-9-10 \\\\  & =-37\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186120372 :knowledge-point/_questions [{:db/id #edb/ref 17592186119804 :knowledge-point/id #uuid "94f8e0e5-8d8a-516a-8f46-d76e94305df4" :knowledge-point/title "Finding the Value of an Unknown Quantity in an Expression Involving the Dot Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "92b53cbe-b5af-5034-a126-cfbfca29707d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186118347} {:answer/id #uuid "b4a806a7-9529-56c1-8c67-4ab4857ca525" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186118348} {:answer/id #uuid "bdbe0989-213f-55e4-ae08-d02d9bd55bcf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186118349} {:answer/id #uuid "d12c5a86-8db9-540f-90d4-5ce76014ab37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186118350} {:answer/id #uuid "77f2cabf-1052-58eb-b63c-6e9d57ec7105" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186118351}] :answer-field/id #uuid "91352f3d-cea9-5480-8d2d-9602aa489ee2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186118346}] :question/id #uuid "5c9313c3-2433-57