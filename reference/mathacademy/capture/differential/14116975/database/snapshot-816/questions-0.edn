difficulty/easy} :question/id #uuid "e4f125d7-bde6-5bbc-b86e-a1dc22a6397f" :question/math-academy-id "q-73929" :question/problem "If $w=[\\begin{aligned}1 \\\\ -1 \\\\ 3 \\\\ -4\\end{aligned}]$, then $5w=$" :question/worked-solution "Multiplying each component of $w$ by $5,$ we get\n\n$$\n\\begin{aligned}5w & =5[\\begin{aligned}1 \\\\ -1 \\\\ 3 \\\\ -4\\end{aligned}] \\\\  & =[\\begin{aligned}5\\cdot 1 \\\\ 5\\cdot (-1) \\\\ 5\\cdot 3 \\\\ 5\\cdot (-4)\\end{aligned}] \\\\  & =[\\begin{aligned}5 \\\\ -5 \\\\ 15 \\\\ -20\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186342113 :knowledge-point/_questions [{:db/id #edb/ref 17592186119803 :knowledge-point/id #uuid "ec386a91-fc52-56d8-8531-7e78a8464380" :knowledge-point/title "Calculating the Dot Product of Two Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4cee0a15-8f95-5c67-b97f-2df7a4828b00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186339827} {:answer/id #uuid "5092076e-a330-582e-8b58-64e3bc1ee4d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-21" :db/id #edb/ref 17592186339863} {:answer/id #uuid "54d19515-e8b8-55f6-bf08-b21031ad3105" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186339907} {:answer/id #uuid "7b87dc60-ad14-50ea-8dac-947d0ec933d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186340236} {:answer/id #uuid "e7ea377d-b28a-5fa3-afc4-d6ddc8b76c2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186341174}] :answer-field/correct {:answer/id #uuid "7b87dc60-ad14-50ea-8dac-947d0ec933d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186340236} :answer-field/id #uuid "c1082f34-5826-58d8-94b2-6eabf9e12ef6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341715}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9d756465-9173-5daf-942c-7abdf0168d3c" :question/math-academy-id "q-73941" :question/problem "Let $c=[\\begin{aligned}0 \\\\ -6 \\\\ 12 \\\\ 9 \\\\ 3\\end{aligned}]$ and $d=[\\begin{aligned}9 \\\\ 4 \\\\ -2 \\\\ 1 \\\\ 6\\end{aligned}].$ What is $(-\\frac{1}{3}c)\\cdot d?$" :question/worked-solution "First, multiplying each component of $c$ by $-\\frac{1}{3}$, we get\n\n$$\n\\begin{aligned}-\\frac{1}{3}c & =-\\frac{1}{3}[\\begin{aligned}0 \\\\ -6 \\\\ 12 \\\\ 9 \\\\ 3\\end{aligned}]=[\\begin{aligned}0 \\\\ 2 \\\\ -4 \\\\ -3 \\\\ -1\\end{aligned}]\\,.\\end{aligned}\n$$\n\nTo compute the dot product, we add up the products of corresponding components:\n\n$$\n\\begin{aligned}(-\\frac{1}{3}c)\\cdot d & =0\\cdot 9+2\\cdot 4+(-4)\\cdot (-2)+(-3)\\cdot 1+(-1)\\cdot 6 \\\\  & =0+8+8-3-6 \\\\  & =7\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186342114 :knowledge-point/_questions [{:db/id #edb/ref 17592186119804 :knowledge-point/id #uuid "94f8e0e5-8d8a-516a-8f46-d76e94305df4" :knowledge-point/title "Finding the Value of an Unknown Quantity in an Expression Involving the Dot Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5b05a743-0bc4-5712-84ed-0da6442c97a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186339958} {:answer/id #uuid "866ae864-002f-535a-ba7d-88f2a4bebafa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186340336} {:answer/id #uuid "8db5af6c-cf95-529a-8f4d-2e820009f178" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186340402} {:answer/id #uuid "b4c799ed-4085-5b8e-8ad8-3e38d8f798a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186340768} {:answer/id #uuid "cf423d8b-51d9-5633-86ea-e86786ef3cf1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186340971}] :answer-field/correct {:answer/id #uuid "866ae864-002f-535a-ba7d-88f2a4bebafa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186340336} :answer-field/id #uuid "2c128dfd-4307-5e43-a63b-f8aa0d49e374" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341455}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e030b11b-7d8c-5bb3-95d3-2268959b30a1" :question/math-academy-id "q-73948" :question/problem "Let $v=[\\begin{aligned}x \\\\ 2x \\\\ 4 \\\\ -5\\end{aligned}]$ and $w=[\\begin{aligned}3x \\\\ -3 \\\\ x \\\\ 2\\end{aligned}].$\nIf $v\\cdot w=-2$ and $x>0$, find the value of $x.$" :question/worked-solution "Starting from the equation $v\\cdot w=-2,$ we compute the dot product in terms of $x$ and then solve for $x$ in the resulting equation:\n\n$$\n\\begin{aligned}v\\cdot w & =-2 \\\\ x\\cdot 3x+2x\\cdot (-3)+4\\cdot x+(-5)\\cdot 2 & =-2 \\\\ 3{x}^{2}-6x+4x-10 & =-2 \\\\ 3{x}^{2}-2x-8 & =0\\end{aligned}\n$$\n\nNow, using the quadratic formula, we obtain\n\n$$\n\\begin{aligned}x & =\\frac{-(-2)\\pm \\sqrt{(-2)^{2}-4(3)(-8)}}{2(3)} \\\\  & =\\frac{2\\pm \\sqrt{100}}{6} \\\\  & =\\frac{2\\pm 10}{6} \\\\  & =\\frac{1\\pm 5}{3}.\\end{aligned}\n$$\n\nSo, we get two solutions, ${x}_{1}=-\\frac{4}{3}$ and ${x}_{2}=2.$ Since we need $x>0$, our final answer is $x=2$ only."}] [{:db/id #edb/ref 17592186342115 :knowledge-point/_questions [{:db/id #edb/ref 17592186119804 :knowledge-point/id #uuid "94f8e0e5-8d8a-516a-8f46-d76e94305df4" :knowledge-point/title "Finding the Value of an Unknown Quantity in an Expression Involving the Dot Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e6d2d84-09cc-54f0-8421-d83f6ddef14d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186339259} {:answer/id #uuid "4ff10e4f-a950-5386-bebb-cd13c7ed95cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186339856} {:answer/id #uuid "7409f5a7-2d41-5eb1-89ec-5e541d8fad83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186340156} {:answer/id #uuid "9f8ec39e-0abf-580d-96bb-85070bd2da2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186340571} {:answer/id #uuid "bfea793d-91a0-5f45-ad3f-c1a205bf1dd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186340840}] :answer-field/correct {:answer/id #uuid "9f8ec39e-0abf-580d-96bb-85070bd2da2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186340571} :answer-field/id #uuid "add42bb3-f82f-527d-bf73-b41e64fbfe31" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341683}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "64baab11-7178-5faa-a751-966ea0fbee6f" :question/math-academy-id "q-73949" :question/problem "Let $l=[\\begin{aligned}5 \\\\ x \\\\ 2 \\\\ x \\\\ 2x\\end{aligned}]$ and $m=[\\begin{aligned}1 \\\\ x \\\\ 4 \\\\ -1 \\\\ -3\\end{aligned}].$\nIf $l\\cdot m=3$ and $x>3$, find the value of $x.$" :question/worked-solution "Starting from the equation $l\\cdot m=3,$ we compute the dot product in terms of $x$ and then solve for $x$ in the resulting equation:\n\n$$\n\\begin{aligned}l\\cdot m & =3 \\\\ 5\\cdot 1+x\\cdot x+2\\cdot 4+x\\cdot (-1)+2x\\cdot (-3) & =3 \\\\ 5+{x}^{2}+8-x-6x & =3 \\\\ {x}^{2}-7x+13 & =3 \\\\ {x}^{2}-7x+10 & =0 \\\\ (x-5)(x-2) & =0\\end{aligned}\n$$\n\nWe get two solutions, ${x}_{1}=5$ and ${x}_{2}=2.$ Since we need $x>3$, our final answer is $x=5$ only."}]}
