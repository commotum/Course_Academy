 \\\\ 4 \\\\ 6 \\\\ 8\\end{aligned}]\\,.\\end{aligned}\n$$\n\nTo compute the dot product, we add up the products of corresponding components:\n\n$$\n\\begin{aligned}(2v)\\cdot w & =14\\cdot 1+4\\cdot (-5)+6\\cdot 4+8\\cdot (-5) \\\\  & =14-20+24-40 \\\\  & =-22\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-44445a49-0a6e-5ad0-9ac8-d8b6292a9f9c"] :db/ensure [:question/validate]} {:db/id "answer-field-44445a49-0a6e-5ad0-9ac8-d8b6292a9f9c" :answer-field/id #uuid "44445a49-0a6e-5ad0-9ac8-d8b6292a9f9c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6fad7444-0378-5902-b324-186df811114e" :answer-field/choices ["answer-aede447b-d581-5f0d-965c-4a10d72d89f9" "answer-adb284e4-ddba-507c-a606-ff692335b187" "answer-6fad7444-0378-5902-b324-186df811114e" "answer-e81e9587-09f0-55b5-8010-2c85e7724a34" "answer-578a4fb0-5d29-543a-b363-7d74eb7f4b45"] :db/ensure [:answer-field/validate]} {:db/id "answer-aede447b-d581-5f0d-965c-4a10d72d89f9" :answer/id #uuid "aede447b-d581-5f0d-965c-4a10d72d89f9" :answer/type :answer.type/math :answer/value "-12" :db/ensure [:answer/validate]} {:db/id "answer-adb284e4-ddba-507c-a606-ff692335b187" :answer/id #uuid "adb284e4-ddba-507c-a606-ff692335b187" :answer/type :answer.type/math :answer/value "-16" :db/ensure [:answer/validate]} {:db/id "answer-6fad7444-0378-5902-b324-186df811114e" :answer/id #uuid "6fad7444-0378-5902-b324-186df811114e" :answer/type :answer.type/math :answer/value "-22" :db/ensure [:answer/validate]} {:db/id "answer-e81e9587-09f0-55b5-8010-2c85e7724a34" :answer/id #uuid "e81e9587-09f0-55b5-8010-2c85e7724a34" :answer/type :answer.type/math :answer/value "-32" :db/ensure [:answer/validate]} {:db/id "answer-578a4fb0-5d29-543a-b363-7d74eb7f4b45" :answer/id #uuid "578a4fb0-5d29-543a-b363-7d74eb7f4b45" :answer/type :answer.type/math :answer/value "-40" :db/ensure [:answer/validate]} {:db/id "question-5a2c3118-2e96-5ebd-b1cc-