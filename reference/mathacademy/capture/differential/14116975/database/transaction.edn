a68957bf1" :answer/type :answer.type/math :answer/value "-30" :db/ensure [:answer/validate]} {:db/id "answer-1957423a-442f-5ef4-a823-2167288015d7" :answer/id #uuid "1957423a-442f-5ef4-a823-2167288015d7" :answer/type :answer.type/math :answer/value "-45" :db/ensure [:answer/validate]} {:db/id "answer-8a79b117-eb2d-5fb8-a211-0feb3de3deb8" :answer/id #uuid "8a79b117-eb2d-5fb8-a211-0feb3de3deb8" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "question-535d2613-b3a1-5204-b804-20416fe47ef7" :question/id #uuid "535d2613-b3a1-5204-b804-20416fe47ef7" :question/math-academy-id "q-34163" :question/problem "If $b=[\\begin{aligned}-3 \\\\ 2 \\\\ 1 \\\\ 4\\end{aligned}]$ and $c=[\\begin{aligned}-4 \\\\ -2 \\\\ 3 \\\\ 1\\end{aligned}]$, then $b\\cdot c=$" :question/worked-solution "To compute the dot product, we add up the products of corresponding components:\n\n$$\n\\begin{aligned}b\\cdot c & ={b}_{1}\\cdot {c}_{1}+{b}_{2}\\cdot {c}_{2}+{b}_{3}\\cdot {c}_{3}+{b}_{4}\\cdot {c}_{4} \\\\  & =(-3)\\cdot (-4)+2\\cdot (-2)+1\\cdot 3+4\\cdot 1 \\\\  & =12-4+3+4 \\\\  & =15\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-087bc630-46e1-553d-8ba3-2ea92bda14ea"] :db/ensure [:question/validate]} {:db/id "answer-field-087bc630-46e1-553d-8ba3-2ea92bda14ea" :answer-field/id #uuid "087bc630-46e1-553d-8ba3-2ea92bda14ea" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1b653e39-5941-5255-8685-46ecb7bc2d61" :answer-field/choices ["answer-1b653e39-5941-5255-8685-46ecb7bc2d61" "answer-d81e9aab-3b35-5081-8c51-759cad294b1a" "answer-088821a4-3897-5498-993d-4363e322c0fb" "answer-6b6af0a1-bada-5b9e-9046-ff9033b19308" "answer-48177a2f-a337-559d-8d5c-0df94de6cbfa"] :db/ensure [:answer-field/validate]} {:db/id "answer-1b653e39-5941-5255-8685-46ecb7bc2d61" :answer/id #uuid "1b653e39-5941-5255-8685-46ecb7bc2d61" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "answer-d81e9aab-3b35-5081-8c51-759cad294b1a" :answer/id #uuid "d81e9aab-3b35-5081-8c51-759cad294b1a" :answer/type :answer.type/math :answer/value "19" :db/ensure [:answer/validate]} {:db/id "answer-088821a4-3897-5498-993d-4363e322c0fb" :answer/id #uuid "088821a4-3897-5498-993d-4363e322c0fb" :answer/type :answer.type/math :answer/value "23" :db/ensure [:answer/validate]} {:db/id "answer-6b6af0a1-bada-5b9e-9046-ff9033b19308" :answer/id #uuid "6b6af0a1-bada-5b9e-9046-ff9033b19308" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "answer-48177a2f-a337-559d-8d5c-0df94de6cbfa" :answer/id #uuid "48177a2f-a337-559d-8d5c-0df94de6cbfa" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id 17592186120372 :question/problem "Let\n$a=[\\begin{aligned}5 \\\\ 0 \\\\ p \\\\ 1\\end{aligned}]$ and $b=[\\begin{aligned}p \\\\ -3 \\\\ 7 \\\\ -4\\end{aligned}].$\nIf $a\\cdot b=8$, find the value of $p.$" :question/worked-solution "Starting from the equation $a\\cdot b=8,$ we compute the dot product in terms of $p$ and then solve for $p$ in the resulting equation:\n\n$$\n\\begin{aligned}a\\cdot b & =8 \\\\ 5\\cdot p+0\\cdot (-3)+p\\cdot 7+1\\cdot (-4) & =8 \\\\ 5p+7p-4 & =8 \\\\ 12p & =12 \\\\ p & =1\\end{aligned}\n$$\n\nTherefore, we conclude that $p=1.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-146d2282-b3c3-51c4-a040-01b6b777627e"] :db/ensure [:question/validate]} {:db/id "answer-field-146d2282-b3c3-51c4-a040-01b6b777627e" :answer-field/id #uuid "146d2282-b3c3-51c4-a040-01b6b777627e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d298adbc-2459-5205-b26e-bae5030bd794" :answer-field/choices ["answer-f2d3286d-460d-594b-a654-7960991941b8" "answer-13a4ee8b-559e-5e77-9422-085f02cafe83" "answer-d298adbc-2459-5205-b26e-bae5030bd794" "answer-fed82051-c308-5ab8-a57d-71d1e9f17b02" "answer-854cec98-1727-5fc7-bb93-ee8180ba2e49"] :db/ensure [:answer-field/validate]} {:db/id "answer-f2d3286d-460d-594b-a654-7960991941b8" :answer/id #uuid "f2d3286d-460d-594b-a654-7960991941b8" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-13a4ee8b-559e-5e77-9422-085f02cafe83" :answer/id #uuid "13a4ee8b-559e-5e77-9422-085f02cafe83" :answer/type :answer.type/math :answer/value "-8" :db/ensure [:answer/validate]} {:db/id "answer-d298adbc-2459-5205-b26e-bae5030bd794" :answer/id #uuid "d298adbc-2459-5205-b26e-bae5030bd794" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-fed82051-c308-5ab8-a57d-71d1e9f17b02" :answer/id #uuid "fed82051-c308-5ab8-a57d-71d1e9f17b02" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-854cec98-1727-5fc7-bb93-ee8180ba2e49" :answer/id #uuid "854cec98-1727-5fc7-bb93-ee8180ba2e49" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id 17592186121032 :tutorial/content "The **real coordinate space** (of dimension $n$) is the set of all possible column vectors of height $n,$ whose components are real numbers. Symbolically, we represent the real coordinate space of dimension $n$ as $\\mathbb{R}^n.$\n\nFor example, the following vectors are in $\\mathbb{R}, \\mathbb{R}^2,$ $\\mathbb{R}^3,$ and $\\mathbb{R}^5,$ respectively: \n\n![](images/20/20e0adb04d7a8711cad4a9ee7ad26755d52176fc9549d7809fe10665a8118945.svg)\n\nWe've already encountered several operations on vectors in $\\mathbb{R}^2$ or $\\mathbb{R}^3,$ namely, vector addition and subtraction, scalar multiplication, and the dot product. All of these operations work the same way in $\\mathbb{R}^n.$" :db/ensure [:tutorial/validate]} {:db/id 17592186121062 :tutorial/content "To add two vectors in $\\mathbb{R}^n,$ we just need to add their corresponding components. To illustrate, consider the vectors $\\mathbf{a},\\mathbf{b} \\in \\mathbb{R}^4,$ given by\n\n![](images/1f/1f1b79f2e61fccbb27944284cbdd217a311a7f795100cfbb56340a457814b407.svg)\n\nTo compute $\\mathbf{a} + \\mathbf{b},$ all we have to do is to add each component of the vector $\\mathbf{a}$ with the corresponding component of $\\mathbf{b}.$ Doing this, we get\n\n$$\n\\begin{aligned}a+b & =[\\begin{aligned}5 \\\\ 1 \\\\ -3 \\\\ 6\\end{aligned}]+[\\begin{aligned}-5 \\\\ 3 \\\\ 1 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}5+(-5) \\\\ 1+3 \\\\ -3+1 \\\\ 6+0\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 4 \\\\ -2 \\\\ 6\\end{aligned}].\\end{aligned}\n$$\n\nWe can only compute the sum, difference, or dot product of two vectors if both vectors have the same number of components. For example, we can't find the following sum, so we say it's *undefined*:\n![](images/6c/6c377966aa9fa1d581c0f9e3ba16bceb4020471914d5c4fb61118ff7cd709466.svg)" :db/ensure [:tutorial/validate]} {:db/id 17592186121033 :tutorial/content "In general, if we have two vectors $\\mathbf{u},\\mathbf{v}\\in\\mathbb{R}^n$ and a scalar $\\lambda\\in\\mathbb{R},$ then our vector operations are defined as follows:\n\n- The **sum/difference** of the two vectors is defined as\n![](images/fc/fc78b2f4e9262108a217e57fec67e096b8b8b18e1486bec8e51df60b8afdfdfa.svg)\n\n- **Scalar multiplication** of a vector is defined as\n![](images/e7/e78025f3481423365b2e924b6f8ba4e59f41e0c644ced7d2263238b219cba27a.svg)\n\n- The **dot product** of two vectors is defined as\n\n$$\n\\quad \\mathbf{u}\\cdot\\mathbf{v} = \\underbrace{u_1 \\cdot v_1 + u_2 \\cdot v_2 + \\cdots + u_n \\cdot v_n}_{\\Large{n} \\,\\textrm{-terms}} = \\sum_{i=1}^n u_i v_i.\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186120043 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]}]
