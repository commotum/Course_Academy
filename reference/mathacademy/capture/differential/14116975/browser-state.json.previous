    "q-34158": {
      "dom_id": "step-q34158",
      "name": "Question 9",
      "problem": "Let $c=[\\begin{aligned}-2 \\\\ 0 \\\\ -1 \\\\ 4\\end{aligned}]$ and $d=[\\begin{aligned}-3 \\\\ 2 \\\\ 5 \\\\ 7\\end{aligned}].$ Find $c+d.$",
      "worked_solution": "We add the vectors:\n\n$$\n\\begin{aligned}c+d & =[\\begin{aligned}-2 \\\\ 0 \\\\ -1 \\\\ 4\\end{aligned}]+[\\begin{aligned}-3 \\\\ 2 \\\\ 5 \\\\ 7\\end{aligned}] \\\\  & =[\\begin{aligned}-2-3 \\\\ 0+2 \\\\ -1+5 \\\\ 4+7\\end{aligned}] \\\\  & =[\\begin{aligned}-5 \\\\ 2 \\\\ 4 \\\\ 11\\end{aligned}]\\end{aligned}\n$$",
      "calculator_instructions": "",
