    "q-73926": {
      "dom_id": "step-q73926",
      "name": "Question 3",
      "problem": "Let $r=[\\begin{aligned}-9 \\\\ 1 \\\\ 0 \\\\ 3 \\\\ -1\\end{aligned}].$ Find $\\frac{2}{3}r.$",
      "worked_solution": "Multiplying each component of $r$ by $\\frac{2}{3},$ we get\n\n$$\n\\begin{aligned}\\frac{2}{3}r & =\\frac{2}{3}[\\begin{aligned}-9 \\\\ 1 \\\\ 0 \\\\ 3 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{2}{3}\\cdot (-9) \\\\ \\frac{2}{3}\\cdot 1 \\\\ \\frac{2}{3}\\cdot 0 \\\\ \\frac{2}{3}\\cdot 3 \\\\ \\frac{2}{3}\\cdot (-1)\\end{aligned}] \\\\  & =[\\begin{aligned}-6 \\\\ \\frac{2}{3} \\\\ 0 \\\\ 2 \\\\ -\\frac{2}{3}\\end{aligned}].\\end{aligned}\n$$",
      "calculator_instructions": "",
