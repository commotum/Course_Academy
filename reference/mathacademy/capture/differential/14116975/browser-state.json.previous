    "q-73930": {
      "dom_id": "step-q73930",
      "name": "Question 4",
      "problem": "Let $w=[\\begin{aligned}2 \\\\ -5 \\\\ 3 \\\\ 10 \\\\ 0\\end{aligned}].$ Find $\\frac{1}{5}w.$",
      "worked_solution": "Multiplying each component of $w$ by $\\frac{1}{5},$ we get\n\n$$\n\\begin{aligned}\\frac{1}{5}w & =\\frac{1}{5}[\\begin{aligned}2 \\\\ -5 \\\\ 3 \\\\ 10 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{5}\\cdot 2 \\\\ \\frac{1}{5}\\cdot (-5) \\\\ \\frac{1}{5}\\cdot 3 \\\\ \\frac{1}{5}\\cdot 10 \\\\ \\frac{1}{5}\\cdot 0\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{2}{5} \\\\ -1 \\\\ \\frac{3}{5} \\\\ 2 \\\\ 0\\end{aligned}].\\end{aligned}\n$$",
      "calculator_instructions": "",
