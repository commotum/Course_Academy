ae-2b02-5df2-9480-36d57f4806a3" :question/difficulty :question.difficulty/easy] ["answer-field-d797f9f7-f609-5c5e-ba78-717e24c03bac" :answer-field/id #uuid "d797f9f7-f609-5c5e-ba78-717e24c03bac"] ["answer-6b5b6e8f-5bc3-560d-8885-95ce43bf6cca" :answer/id #uuid "6b5b6e8f-5bc3-560d-8885-95ce43bf6cca"] ["answer-6b5b6e8f-5bc3-560d-8885-95ce43bf6cca" :answer/type :answer.type/math] ["answer-6b5b6e8f-5bc3-560d-8885-95ce43bf6cca" :answer/value "\\frac{11}{8}"] ["answer-e8d75129-0300-58cb-992b-b2f66d1dd767" :answer/id #uuid "e8d75129-0300-58cb-992b-b2f66d1dd767"] ["answer-e8d75129-0300-58cb-992b-b2f66d1dd767" :answer/type :answer.type/math] ["answer-e8d75129-0300-58cb-992b-b2f66d1dd767" :answer/value "\\frac{19}{16}"] ["answer-b17dce6c-5de4-5ce6-8c5a-0647d6a9d350" :answer/id #uuid "b17dce6c-5de4-5ce6-8c5a-0647d6a9d350"] ["answer-b17dce6c-5de4-5ce6-8c5a-0647d6a9d350" :answer/type :answer.type/math] ["answer-b17dce6c-5de4-5ce6-8c5a-0647d6a9d350" :answer/value "\\frac{3}{2}"] ["answer-d00ac744-2b33-547b-8327-668720b71a82" :answer/id #uuid "d00ac744-2b33-547b-8327-668720b71a82"] ["answer-d00ac744-2b33-547b-8327-668720b71a82" :answer/type :answer.type/math] ["answer-d00ac744-2b33-547b-8327-668720b71a82" :answer/value "\\frac{5}{4}"] ["answer-f787f52b-7c28-5038-948b-07653cdbb173" :answer/id #uuid "f787f52b-7c28-5038-948b-07653cdbb173"] ["answer-f787f52b-7c28-5038-948b-07653cdbb173" :answer/type :answer.type/math] ["answer-f787f52b-7c28-5038-948b-07653cdbb173" :answer/value "\\frac{9}{8}"] ["answer-field-d797f9f7-f609-5c5e-ba78-717e24c03bac" :answer-field/key "selection"] ["answer-field-d797f9f7-f609-5c5e-ba78-717e24c03bac" :answer-field/type :answer-field.type/radio] ["answer-field-d797f9f7-f609-5c5e-ba78-717e24c03bac" :answer-field/correct "answer-b17dce6c-5de4-5ce6-8c5a-0647d6a9d350"] ["answer-field-d797f9f7-f609-5c5e-ba78-717e24c03bac" :answer-field/choices "answer-6b5b6e8f-5bc3-560d-8885-95ce43bf6cca"] ["answer-field-d797f9f7-f609-5c5e-ba78-717e24c03bac" :answer-field/choices 