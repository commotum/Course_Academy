/validate]} {:db/id "answer-c4b45f6f-0aca-5265-a86f-dc576861c0d9" :answer/id #uuid "c4b45f6f-0aca-5265-a86f-dc576861c0d9" :answer/type :answer.type/math :answer/value "25" :db/ensure [:answer/validate]} {:db/id "answer-11b0f9e8-5bed-5e28-8aa4-8891548dbee5" :answer/id #uuid "11b0f9e8-5bed-5e28-8aa4-8891548dbee5" :answer/type :answer.type/math :answer/value "27" :db/ensure [:answer/validate]} {:db/id "answer-e9f45a7c-cd89-5de7-919f-40df36a8e57e" :answer/id #uuid "e9f45a7c-cd89-5de7-919f-40df36a8e57e" :answer/type :answer.type/math :answer/value "30" :db/ensure [:answer/validate]} {:db/id "answer-fb52047a-64f1-55c6-bcdc-b7d871b74bba" :answer/id #uuid "fb52047a-64f1-55c6-bcdc-b7d871b74bba" :answer/type :answer.type/math :answer/value "32" :db/ensure [:answer/validate]} {:db/id "answer-25c6b3fe-797b-5c3b-b5d3-ad2fbd9060da" :answer/id #uuid "25c6b3fe-797b-5c3b-b5d3-ad2fbd9060da" :answer/type :answer.type/math :answer/value "36" :db/ensure [:answer/validate]} {:db/id "question-d139a777-1244-5988-9682-4e7da954d933" :question/id #uuid "d139a777-1244-5988-9682-4e7da954d933" :question/math-academy-id "q-148329" :question/problem "For two random variables $X$ and $Y,$ we have $\\text{Var}[X]=3,$ $\\text{Var}[Y]=5,$ and $\\text{Cov}[X,Y]=1.$ Find $\\text{Var}[3X-4Y].$" :question/worked-solution "Recall that if $X$ and $Y$ are random variables, and $a$ and $b$ are constants, then\n\n$$\n\\text{Var}[aX+bY]={a}^{2}\\text{Var}[X]+{b}^{2}\\text{Var}[Y]+2ab\\,\\text{Cov}[X,Y].\n$$\n\nSubstituting the given data into the formula above, we obtain\n\n$$\n\\begin{aligned}\\text{Var}[3X-4Y] & ={3}^{2}\\cdot 3+(-4)^{2}\\cdot 5+2\\cdot 3\\cdot (-4)\\cdot 1 \\\\  & =27+80-24 \\\\  & =83.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-44a50128-f069-562c-b225-44f83d8c3770"] :db/ensure [:question/validate]} {:db/id "answer-field-44a50128-f069-562c-b225-44f83d8c3770" :answer-field/id #uuid "44a50128-f069-562c-b225-44f83d8c3770" :answer