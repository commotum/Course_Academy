$.\n\n> A scientific calculator is required to answer this question." :question/requires-calculator true}] [{:db/id #edb/ref 17592186188784 :knowledge-point/_questions [{:db/id #edb/ref 17592186188361 :knowledge-point/id #uuid "f512d235-f663-502f-bd8c-6b3b6748913b" :knowledge-point/title "Calculating the Variance of a Sum of Three Random Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cd1f23c2-6747-51ae-9f60-02581263b363" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "205" :db/id #edb/ref 17592186186985} {:answer/id #uuid "dc18f794-d6f6-5049-812e-926da1a335e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "175" :db/id #edb/ref 17592186186986} {:answer/id #uuid "56d68d7b-ded6-520a-aade-538a0d2bca4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "185" :db/id #edb/ref 17592186186987} {:answer/id #uuid "57b2e6c4-761b-5a3d-93ce-e1293de5f8ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "165" :db/id #edb/ref 17592186186988} {:answer/id #uuid "5b1dcffa-fe6e-51b1-8c80-ed9e58cbe8ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "195" :db/id #edb/ref 17592186186989}] :answer-field/id #uuid "35c634ce-1efc-5440-bac3-81ca5c4d1a4a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186186984}] :question/id #uuid "b4c20916-66f7-5f38-b102-b5a620d22dbb" :question/math-academy-id "q-148160" :question/problem "For three random variables $X_{1}, X_{2}$, and $X_{3}$, we have the following variances and covariances:\n\n$Var[X_{1}] = 5, Var[X_{2}] = 4, Var[X_{3}] = 2$\n\n$Cov[X_{1}, X_{2}] = 3, Cov[X_{1}, X_{3}] = 1, Cov[X_{2}, X_{3}] = 2$\n\nFind $Var[3X_{1} + 2X_{2} + 4X_{3}]$.\n\n> A scientific calculator is required to answer this question." :question/requires-calculator true}] [{:db/id #edb/ref 17592186188786 :knowledge-point/_questions [{:db/id #edb/ref 17592186188360 :knowledge-point/id #uuid "39efc83e-6658-5b7a-979b-dbc35af5dd98" :knowledge-point/title "Calculating a Combined Variance Given Some Moments"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8f0a5ae0-3d3b-5b19-894e-01a395a7908b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "80" :db/id #edb/ref 17592186186997} {:answer/id #uuid "00611cca-0cb0-545e-9550-a63764016e3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "64" :db/id #edb/ref 17592186186998} {:answer/id #uuid "3f554486-3123-5996-85ee-1e07917d7202" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "75" :db/id #edb/ref 17592186186999} {:answer/id #uuid "6ded9c5e-2336-5d95-b9c6-ace0e17aad0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "72" :db/id #edb/ref 17592186187000} {:answer/id #uuid "7bd0bd3f-7b73-5f7c-8613-cdf6a15724c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "92" :db/id #edb/ref 17592186187001}] :answer-field/id #uuid "449f3f8d-204c-5706-983a-90f6e3af463d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186186996}] :question/id #uuid "bf786f34-fcab-562f-85da-9ff62292e23b" :question/math-academy-id "q-148162" :question/problem "Consider two random variables $X$ and $Y$ with expectations $E[X] = 2$, $E[Y] = 4$, mixed moment $E[XY] = 10$, and second raw moments $E[X^{2}] = 9$ and $E[Y^{2}] = 20$. Find the variance of $2X - 5Y$.\n\n> A scientific calculator is required to answer this question." :question/requires-calculator true}] [{:db/id #edb/ref 17592186188787 :knowledge-point/_questions [{:db/id #edb/ref 17592186188360 :knowledge-point/id #uuid "39efc83e-6658-5b7a-979b-dbc35af