lay=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mtable displaystyle=\"true\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"0.6em 0.6em 0.3em\"><mtr><mtd><mtext>Var</mtext><mo stretchy=\"false\">[</mo><mn>3</mn><mi>X</mi><mo>−</mo><mi>Y</mi><mo stretchy=\"false\">]</mo></mtd><mtd><mi></mi><mo>=</mo><msup><mn>3</mn><mn>2</mn></msup><mo>⋅</mo><mn>0.84</mn><mo>+</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mn>1</mn><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup><mo>⋅</mo><mn>0.25</mn><mo>+</mo><mn>2</mn><mo>⋅</mo><mn>3</mn><mo>⋅</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mo>⋅</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mn>0.1</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>7.56</mn><mo>+</mo><mn>0.25</mn><mo>+</mo><mn>0.6</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>8.41</mn><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
