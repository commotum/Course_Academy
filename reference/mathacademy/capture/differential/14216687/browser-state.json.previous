<mtr><mtd><mtext>Var</mtext><mo stretchy=\"false\">[</mo><mn>2</mn><mi>X</mi><mo>+</mo><mn>3</mn><mi>Y</mi><mo stretchy=\"false\">]</mo></mtd><mtd><mi></mi><mo>=</mo><msup><mn>2</mn><mn>2</mn></msup><mo>⋅</mo><mn>0.16</mn><mo>+</mo><msup><mn>3</mn><mn>2</mn></msup><mo>⋅</mo><mn>0.24</mn><mo>+</mo><mn>2</mn><mo>⋅</mo><mn>2</mn><mo>⋅</mo><mn>3</mn><mo>⋅</mo><mn>0.02</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>0.64</mn><mo>+</mo><mn>2.16</mn><mo>+</mo><mn>0.24</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>3.04</mn><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
