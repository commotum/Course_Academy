\"><mtable displaystyle=\"true\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"0.8em 0.8em 0.3em\"><mtr><mtd><mtext>Var</mtext><mo stretchy=\"false\">[</mo><mn>2</mn><mi>X</mi><mo>−</mo><mn>8</mn><mi>Y</mi><mo stretchy=\"false\">]</mo></mtd><mtd><mi></mi><mo>=</mo><msup><mn>2</mn><mn>2</mn></msup><mo>⋅</mo><mn>0.24</mn><mo>+</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mn>8</mn><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup><mo>⋅</mo><mn>0.06</mn><mo>+</mo><mn>2</mn><mo>⋅</mo><mn>2</mn><mo>⋅</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mn>8</mn><mo stretchy=\"false\">)</mo><mo>⋅</mo><mn>0.08</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>0.96</mn><mo>+</mo><mn>3.84</mn><mo>−</mo><mn>2.56</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>2.24</mn><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
