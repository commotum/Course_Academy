4</mn><mo>⋅</mo><mn>6</mn><mo>⋅</mo><mn>4</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>3</mn><mo>+</mo><mn>8</mn><mo>+</mo><mn>54</mn><mo>−</mo><mn>6</mn><mo>−</mo><mn>42</mn><mo>+</mo><mn>192</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>209.</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
