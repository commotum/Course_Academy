#{[{:db/id #edb/ref 17592186367240 :knowledge-point/_questions [{:db/id #edb/ref 17592186119828 :knowledge-point/id #uuid "cbc74baa-313b-51e7-8ae1-5e9fe0761256" :knowledge-point/title "Finding the Cartesian Equation of a Line Given Two Points on the Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3103b7b1-e08e-5891-bfbe-c1ec2af0dff4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-1}{3}=\\frac{z+5}{4},\\,y=2" :db/id #edb/ref 17592186367242} {:answer/id #uuid "baaea110-f65c-5409-b3a2-13194827514b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+1}{3}=\\frac{z+5}{4},\\,y=-2" :db/id #edb/ref 17592186367243} {:answer/id #uuid "6d279abb-4007-52c2-895b-d690c7f724e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+1}{3}=\\frac{z-5}{4},\\,y=2" :db/id #edb/ref 17592186367244} {:answer/id #uuid "cbd346df-59be-5375-8f4c-15f188fbded5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-1}{3}=\\frac{z-5}{4},\\,y=-2" :db/id #edb/ref 17592186367245} {:answer/id #uuid "ffcdbe32-6592-5f2a-9fd5-bb2a8ba04aa1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-1}{3}=\\frac{z-5}{-4},\\,y=2" :db/id #edb/ref 17592186367246}] :answer-field/correct {:answer/id #uuid "6d279abb-4007-52c2-895b-d690c7f724e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+1}{3}=\\frac{z-5}{4},\\,y=2" :db/id #edb/ref 17592186367244} :answer-field/id #uuid "b609bda9-e776-5fe4-a812-e5bedc6b3f93" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186367241}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "26ccf3a9-18a6-5810-b58b-63343e2dbccc" :question/math-academy-id "q-127534" :question/problem "![](images/f6/f65a9806a2d6736a9eed283253225f6e5405d3e272f25e9c6a763651a19d0a31.png)\n\nFind a Cartesian equation of the line shown in the figure above." :question/worked-solution "We know that the line passes through the points $P(-1,2,5)$ and $Q(2,2,9).$ Now, we need to find a vector parallel to the given line. Let's consider the vector $\\overset{\\to }{PQ}$ which is given by\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨2,2,9⟩-⟨-1,2,5⟩ \\\\  & =⟨3,0,4⟩.\\end{aligned}\n$$\n\nUsing the point $P$ and the vector $\\overset{\\to }{PQ}$, we have that the Cartesian (canonical) equation of the given line is given by\n\n$$\n\\frac{x-(-1)}{3}=\\frac{y-2}{0}=\\frac{z-5}{4}=t,\\,t\\in (-\\infty ,\\infty ),\n$$\n\nor equivalently\n\n$$\n\\frac{x+1}{3}=\\frac{y-2}{0}=\\frac{z-5}{4}.\n$$\n\nBut the above equation is problematic because $\\frac{y-2}{0}$ involves division by zero.\n\nHowever, in our line, the $y$ component always maintains the constant value of $y=2.$ For example, our two points $P(-1,2,5)$ and $Q(2,2,9)$ both have $y$-coordinates of $y=2.$\n\nSo, in the Cartesian equation, we remove the $\\frac{y-2}{0}$ part and instead write $y=2,$ as follows:\n\n$$\n\\frac{x+1}{3}=\\frac{z-5}{4},\\,y=2\n$$"}] [{:db/id #edb/ref 17592186120506 :knowledge-point/_questions [{:db/id #edb/ref 17592186119842 :knowledge-point/id #uuid "07c209a4-5c69-561e-9015-28b0f6e436e5" :knowledge-point/title "Finding the Cartesian Equation of a Line When a Component of the Direction Vector is Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8a901e00-4252-5cf9-b50c-8893fcb829e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186119151} {:answer/id #uuid "abbd4785-c8dc-50a2-be07-f1eb6893222e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-x = \\frac{y - 2}{1}, z =-1" :db/id #edb/ref 17592186119152} {:answer/id #uuid "e119e113-a4c0-584f-9f11-17fe5d0b1a7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x = \\frac{y - 1}{2} =-z" :db/id #edb/ref 17592186119153} {:answer/id #uuid "71528ca6-7a70-59a0-9b5d-8a8f4816dab0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y - 1}{2} =-z, x =-1" :db/id #edb/ref 17592186119154} {:answer/id #uuid "7a38b494-2053-5910-85da-23542283aa10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x + 1 = \\frac{y - 1}{2} =-z" :db/id #edb/ref 17592186119155}] :answer-field/id #uuid "2f354396-1623-5d78-92fe-a7def331ac1f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186119150} {:answer-field/choices [{:answer/id #uuid "f348ab2b-70ba-5d55-a038-1c2b971bae5b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186368670} {:answer/id #uuid "4b489027-ff1d-5463-ab8c-dd167ba0d700" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-x=\\frac{y-2}{1},\\,z=-1" :db/id #edb/ref 17592186368671} {:answer/id #uuid "610d18c7-3941-5814-b7ec-e0be41696393" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y-1}{2}=-z,\\,x=-1" :db/id #edb/ref 17592186368672} {:answer/id #uuid "7c80d818-a51e-5a06-9a27-142460430c64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+1=\\frac{y-1}{2}=-z" :db/id #edb/ref 17592186368673} {:answer/id #uuid "4405ea39-6ccf-5364-9088-7dbb9d9a5f38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{y-1}{2}=-z" :db/id #edb/ref 17592186368674}] :answer-field/correct {:answer/id #uuid "610d18c7-3941-5814-b7ec-e0be41696393" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y-1}{2}=-z,\\,x=-1" :db/id #edb/ref 17592186368672} :answer-field/id #uuid "adf6930c-774a-5b1f-b8be-4a33d604e6b6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186368669}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9ba33a02-c52b-5c65-80c6-40fc93de31d0" :question/math-academy-id "q-70641" :question/problem "Find the Cartesian equation for the line with the following vector equation:\n\n$$\nr=\\begin{bmatrix}-1 \\\\ 1 \\\\ 0\\end{bmatrix}+t\\begin{bmatrix}0 \\\\ 2 \\\\ -1\\end{bmatrix},\\,t\\in (-\\infty ,\\infty )\n$$" :question/worked-solution "Using the usual formula, we get\n\n$$\n\\frac{x-(-1)}{0}=\\frac{y-1}{2}=\\frac{z-0}{-1}=t,\\,t\\in (-\\infty ,\\infty ),\n$$\n\nor equivalently\n\n$$\n\\frac{x+1}{0}=\\frac{y-1}{2}=-z,\n$$\n\nwhich is problematic because $\\frac{x+1}{0}$ involves division by zero.\n\nHowever, notice that in our line, the $x$ component always maintains the constant value of $x=-1:$\n\n$$\nr=\\begin{bmatrix}-1 \\\\ 1+2t \\\\ -t\\end{bmatrix},\\,t\\in (-\\infty ,\\infty )\n$$\n\nSo, in the Cartesian equation, we remove the $\\frac{x+1}{0}$ part and instead write $x=-1,$ as follows:\n\n$$\n\\frac{y-1}{2}=-z,\\,x=-1\n$$"}] [{:db/id #edb/ref 17592186338877 :knowledge-point/_questions [{:db/id #edb/ref 17592186119827 :knowledge-point/id #uuid "d44cf726-a4a6-5ac9-a63c-7464fe5566c5" :knowledge-point/title "Finding the Cartesian Equation of a Line Given in Parametric or Vector Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19e64b37-3c7a-5132-a82c-36330fe10f58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+3}{4}=\\frac{y+4}{6}=\\frac{z-5}{9}" :db/id #edb/ref 17592186336271} {:answer/id #uuid "8a752ea7-fe86-5478-aae7-722d6e7a29af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+4}{3}=\\frac{y+6}{4}=\\frac{z+9}{-5}" :db/id #edb/ref 17592186337279} {:answer/id #uuid "a048d6c7-d4d3-50d9-b51c-8fa355607987" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-3}{4}=\\frac{y-4}{6}=\\frac{z+5}{9}" :db/id #edb/ref 17592186337480} {:answer/id #uuid "bf30416c-dc68-5dc0-91dd-21e3d89ecdd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-4}{3}=\\frac{y-6}{4}=\\frac{z-9}{-5}" :db/id #edb/ref 17592186337731} {:answer/id #uuid "df728bc5-3bdf-5b55-bb17-24b6ef4f6f21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{4}=\\frac{y}{6}=\\frac{z}{9}" :db/id #edb/ref 17592186337982}] :answer-field/correct {:answer/id #uuid "a048d6c7-d4d3-50d9-b51c-8fa355607987" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-3}{4}=\\frac{y-4}{6}=\\frac{z+5}{9}" :db/id #edb/ref 17592186337480} :answer-field/id #uuid "32bcf106-ea5d-53fa-a139-89e099b59c67" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338373}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "db08ec21-5e10-5fa9-a587-34ff723a0e65" :question/math-academy-id "q-71029" :question/problem "Consider the straight line with the vector equation\n\n$$\nr=\\begin{bmatrix}3 \\\\ 4 \\\\ -5\\end{bmatrix}+t\\begin{bmatrix}4 \\\\ 6 \\\\ 9\\end{bmatrix}\n$$\n\nfor $t\\in (-\\infty ,\\infty ).$ Find the Cartesian equation of this line." :question/worked-solution "We have the vector equation \n\n$$\nr=\\begin{bmatrix}3 \\\\ 4 \\\\ -5\\end{bmatrix}+t\\begin{bmatrix}4 \\\\ 6 \\\\ 9\\end{bmatrix},\\,t\\in (-\\infty ,\\infty ).\n$$\n\nThis implies that the straight line passes through the point $P(3,4,-5)$ and is parallel to the vector $v=⟨4,6,9⟩.$ So, its Cartesian (canonical) equation is given by\n\n$$\n\\frac{x-3}{4}=\\frac{y-4}{6}=\\frac{z-(-5)}{9}=t,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nSimplifying, we reach\n\n$$\n\\frac{x-3}{4}=\\frac{y-4}{6}=\\frac{z+5}{9}.\n$$"}]}
