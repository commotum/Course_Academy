db/ref 17592186572539 #edb/ref 17592186045417] [17592186572595 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186572595 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186572595 #edb/ref 1078 #edb/ref 17592186572468 #edb/ref 17592186045417] [17592186572595 #edb/ref 1079 #uuid "19df2e81-2346-53c6-b28c-0f1afc312307" #edb/ref 17592186045417] [17592186572639 #edb/ref 1075 #edb/ref 17592186572362 #edb/ref 17592186045417] [17592186572639 #edb/ref 1075 #edb/ref 17592186572470 #edb/ref 17592186045417] [17592186572639 #edb/ref 1075 #edb/ref 17592186572488 #edb/ref 17592186045417] [17592186572639 #edb/ref 1075 #edb/ref 17592186572496 #edb/ref 17592186045417] [17592186572639 #edb/ref 1075 #edb/ref 17592186572574 #edb/ref 17592186045417] [17592186572639 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186572639 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186572639 #edb/ref 1078 #edb/ref 17592186572488 #edb/ref 17592186045417] [17592186572639 #edb/ref 1079 #uuid "b7fb6b07-3aa3-5e0b-beb1-701386482c7a" #edb/ref 17592186045417] [17592186572687 #edb/ref 1068 #edb/ref 17592186572639 #edb/ref 17592186045417] [17592186572687 #edb/ref 1069 "q-127457" #edb/ref 17592186045417] [17592186572687 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186572687 #edb/ref 1071 "Find the Cartesian equation for the line with the following vector equation:\n\n$$\nr=\\begin{bmatrix}-1 \\\\ 2 \\\\ 4\\end{bmatrix}+t\\begin{bmatrix}0 \\\\ 5 \\\\ 7\\end{bmatrix},\\,t\\in (-\\infty ,\\infty )\n$$" #edb/ref 17592186045417] [17592186572687 #edb/ref 1072 #uuid "3f6ecd28-8af0-5770-801c-e2211846f047" #edb/ref 17592186045417] [17592186572687 #edb/ref 1074 "Using the usual formula, we get\n\n$$\n\\frac{x-(-1)}{0}=\\frac{y-2}{5}=\\frac{z-4}{7}=t,\\,t\\in (-\\infty ,\\infty ),\n$$\n\nor equivalently\n\n$$\n\\frac{x+1}{0}=\\frac{y-2}{5}=\\frac{z-4}{7},\n$$\n\nwhich is problematic because $\\frac{x+1}{0}$ involves division by zero.\n\nHowever, notice that in our line, the $x$ component always maintains the constant value of $x=-1:$\n\n$$\nr=\\begin{bmatrix}-1 \\\\ 2+5t \\\\ 4+7t\\end{bmatrix},\\,t\\in (-\\infty ,\\infty )\n$$\n\nSo, in the Cartesian equation, we remove the $\\frac{x+1}{0}$ part and instead write $x=-1$, as follows:\n\n$$\n\\frac{y-2}{5}=\\frac{z-4}{7},\\,x=-1\n$$" #edb/ref 17592186045417] [17592186572698 #edb/ref 1068 #edb/ref 17592186572595 #edb/ref 17592186045417] [17592186572698 #edb/ref 1069 "q-71022" #edb/ref 17592186045417] [17592186572698 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186572698 #edb/ref 1071 "Consider the straight line with the parametric equations\n\n$$\n\\left\\{\\begin{aligned}x &=-t \\\\ y &=-3-2t \\\\ z &=4+7t\\end{aligned}\\right.\n$$\n\nfor $t\\in (-\\infty ,\\infty ).$ Find the Cartesian equation of this line." #edb/ref 17592186045417] [17592186572698 #edb/ref 1072 #uuid "7e38002f-06be-5b6a-8718-39abfb36add8" #edb/ref 17592186045417] [17592186572698 #edb/ref 1074 "First, let's find the corresponding vector equation as follows:\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}-t \\\\ -3-2t \\\\ 4+7t\\end{bmatrix} \\\\ \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}0 \\\\ -3 \\\\ 4\\end{bmatrix}+\\begin{bmatrix}-t \\\\ -2t \\\\ 7t\\end{bmatrix} \\\\ \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}0 \\\\ -3 \\\\ 4\\end{bmatrix}+t\\begin{bmatrix}-1 \\\\ -2 \\\\ 7\\end{bmatrix} \\\\ r & =\\begin{bmatrix}0 \\\\ -3 \\\\ 4\\end{bmatrix}+t\\begin{bmatrix}-1 \\\\ -2 \\\\ 7\\end{bmatrix},\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$\n\nThis implies that the given line passes through the point $P(0,-3,4)$ and is parallel to the vector $v=⟨-1,-2,7⟩.$ So, its Cartesian (canonical) equation is given by\n\n$$\n\\frac{x-0}{-1}=\\frac{y-(-3)}{-2}=\\frac{z-4}{7}=t,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nSimplifying, we reach\n\n$$\n\\frac{x}{-1}=\\frac{y+3}{-2}=\\frac{z-4}{7}.\n$$" #edb/ref 17592186045417] [17592186572736 #edb/ref 1062 #uuid "145ce8df-01ec-57e3-b39c-1ec76660f5ed" #edb/ref 17592186045417] [17592186572736 #edb/ref 1063 #edb/ref 17592186367240 #edb/ref 17592186045417] [17592186572758 #edb/ref 1058 #edb/ref 17592186572766 #edb/ref 17592186045417] [17592186572758 #edb/ref 1062 #uuid "40a8a766-a5ff-53c3-a1e8-af197b8d2a13" #edb/ref 17592186045417] [17592186572758 #edb/ref 1063 #edb/ref 17592186338877 #edb/ref 17592186045417] [17592186572766 #edb/ref 1058 #edb/ref 17592186572736 #edb/ref 17592186045417] [17592186572766 #edb/ref 1062 #uuid "57929708-6e1f-5624-b944-a9831f7009b2" #edb/ref 17592186045417] [17592186572766 #edb/ref 1063 #edb/ref 17592186572687 #edb/ref 17592186045417] [17592186572771 #edb/ref 1058 #edb/ref 17592186572793 #edb/ref 17592186045417] [17592186572771 #edb/ref 1062 #uuid "72290fe9-7f75-5e81-8a56-0f0853a90f24" #edb/ref 17592186045417] [17592186572771 #edb/ref 1063 #edb/ref 17592186120506 #edb/ref 17592186045417] [17592186572793 #edb/ref 1058 #edb/ref 17592186572758 #edb/ref 17592186045417] [17592186572793 #edb/ref 1062 #uuid "be45a931-3267-5e9b-af10-acc0bc85bcf2" #edb/ref 17592186045417] [17592186572793 #edb/ref 1063 #edb/ref 17592186572698 #edb/ref 17592186045417]}
