#{[{:db/id #edb/ref 17592186540069 :knowledge-point/_questions [{:db/id #edb/ref 17592186208846 :knowledge-point/id #uuid "9fe0d364-ef22-5138-9ee5-e473bd909447" :knowledge-point/title "Computing Gradient of a Quadratic Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "110945c0-e65b-5532-b050-4bd230c8fb1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186539510} {:answer/id #uuid "1e5de0f5-f94e-561a-ac4c-228d4c9f8358" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ -4\\end{aligned}]" :db/id #edb/ref 17592186539539} {:answer/id #uuid "70ee273e-1adf-5b0b-9c25-84a6f752229b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186539669} {:answer/id #uuid "778742bb-372b-5ab3-9144-d2501865782a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & -2 \\\\ -2 & 2\\end{aligned}]" :db/id #edb/ref 17592186539679} {:answer/id #uuid "a4929fc1-3e70-5bff-a80f-2be44c2ad920" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186539756}] :answer-field/correct {:answer/id #uuid "a4929fc1-3e70-5bff-a80f-2be44c2ad920" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186539756} :answer-field/id #uuid "81f5b530-9e0f-51b8-82ba-e6d74b6b4686" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186539967}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8ea8eb91-918f-5aeb-b452-a90611b4dd2a" :question/math-academy-id "q-265760" :question/problem "Compute the gradient of the function $f:{R}^{2}\\to R$ defined by \n\n$$\nf(x)={x}^{T}[\\begin{aligned}1 & -1 \\\\ -1 & 1\\end{aligned}]x\n$$\n\n with respect to $x$ at $x=[\\begin{aligned}0 \\\\ 2\\end{aligned}].$" :question/worked-solution "Writing $A=[\\begin{aligned}1 & -1 \\\\ -1 & 1\\end{aligned}]$, we have\n\n$$\nf(x)={x}^{T}Ax.\n$$\n\nFor a symmetric matrix $A$, the gradient of the function $f(x)={x}^{T}Ax$ with respect to $x\\in {R}^{n}$ is\n\n$$\n{∇}_{x}f(x)=2Ax.\n$$\n\nTherefore, since $A$ is symmetric, we get\n\n$$\n{∇}_{x}f(x)=2[\\begin{aligned}1 & -1 \\\\ -1 & 1\\end{aligned}][\\begin{aligned}0 \\\\ 2\\end{aligned}]=[\\begin{aligned}-4 \\\\ 4\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186208930 :knowledge-point/_questions [{:db/id #edb/ref 17592186208848 :knowledge-point/id #uuid "0c77271f-3d21-5193-a1ad-5c0264e337f0" :knowledge-point/title "Applying the Chain Rule to Gradients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0288d1c8-90da-55c4-98e8-5a5eabefe8cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 \\\\ 22\\end{aligned}]" :db/id #edb/ref 17592186539481} {:answer/id #uuid "86d96929-a573-5ba1-a568-15337e2bcf56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-7 & -29\\end{aligned}]" :db/id #edb/ref 17592186539703} {:answer/id #uuid "cc83261d-2254-5227-8497-098b5fbcaed7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-7 \\\\ -29\\end{aligned}]" :db/id #edb/ref 17592186539828} {:answer/id #uuid "e136544d-ec3c-563b-b13e-653feae14454" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 22\\end{aligned}]" :db/id #edb/ref 17592186539864} {:answer/id #uuid "ff114911-6bea-5d83-a4a0-4820ac877a2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}25 \\\\ -11\\end{aligned}]" :db/id #edb/ref 17592186539914}] :answer-field/correct {:answer/id #uuid "cc83261d-2254-5227-8497-098b5fbcaed7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-7 \\\\ -29\\end{aligned}]" :db/id #edb/ref 17592186539828} :answer-field/id #uuid "6839df18-40b0-55d8-b0ee-244e7c3bdebb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186205341}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8b2d453b-0edb-52e1-a8ad-599845d2374a" :question/math-academy-id "q-269515" :question/problem "Consider the function $L:{R}^{2}\\to R$ defined by $L(x)=\\frac{1}{2}(Ax-b)^{T}(Ax-b)$ where \n\n$$\nA=[\\begin{aligned}3 & 1 \\\\ 2 & 4 \\\\ 5 & 0\\end{aligned}],\\,b=[\\begin{aligned}6 \\\\ 7 \\\\ 8\\end{aligned}].\n$$\n\nWhat is ${∇}_{x}L(x)$ at $x=[\\begin{aligned}2 \\\\ -1\\end{aligned}]?$" :question/worked-solution "We can solve this problem by applying the chain rule for gradients.\n\nLet $y=Ax-b.$ Then, $L(x)=\\frac{1}{2}{y}^{T}y,$ and\n\n$$\n{∇}_{x}L={(\\frac{\\text{d}L}{\\text{d}x})}^{T}={(\\frac{\\text{d}y}{\\text{d}x})}^{T}\\cdot {(\\frac{\\text{d}L}{\\text{d}y})}^{T}.\n$$\n\nNow, since \n\n$$\n\\frac{\\text{d}}{\\text{d}y}(\\frac{1}{2}{y}^{T}y)={y}^{T}\\,\\text{and}\\,\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}}{\\text{d}x}(Ax-b)=A,\n$$\n\nwe have that \n\n$$\n\\begin{aligned}{∇}_{x}L & ={(\\frac{\\text{d}y}{\\text{d}x})}^{T}\\cdot {(\\frac{\\text{d}L}{\\text{d}y})}^{T} \\\\  & ={A}^{T}\\cdot y.\\end{aligned}\n$$\n\nEvaluating at $x=[\\begin{aligned}2 \\\\ -1\\end{aligned}]$, we get\n\n$$\n\\begin{aligned}{∇}_{x}L & ={A}^{T}\\cdot y \\\\  & ={A}^{T}(Ax-b) \\\\  & ={[\\begin{aligned}3 & 1 \\\\ 2 & 4 \\\\ 5 & 0\\end{aligned}]}^{T}([\\begin{aligned}3 & 1 \\\\ 2 & 4 \\\\ 5 & 0\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ -1\\end{aligned}]-[\\begin{aligned}6 \\\\ 7 \\\\ 8\\end{aligned}]) \\\\  & =[\\begin{aligned}3 & 2 & 5 \\\\ 1 & 4 & 0\\end{aligned}]([\\begin{aligned}5 \\\\ 0 \\\\ 10\\end{aligned}]-[\\begin{aligned}6 \\\\ 7 \\\\ 8\\end{aligned}]) \\\\  & =[\\begin{aligned}3 & 2 & 5 \\\\ 1 & 4 & 0\\end{aligned}][\\begin{aligned}-1 \\\\ -7 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}-7 \\\\ -29\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186540048 :knowledge-point/_questions [{:db/id #edb/ref 17592186208848 :knowledge-point/id #uuid "0c77271f-3d21-5193-a1ad-5c0264e337f0" :knowledge-point/title "Applying the Chain Rule to Gradients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "263e9c79-2b5d-5fc6-ae10-bec804651dad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}30 \\\\ 42\\end{aligned}]" :db/id #edb/ref 17592186539553} {:answer/id #uuid "5e6bef22-fee1-53f1-8d0f-2529ad295f2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}30 & 42\\end{aligned}]" :db/id #edb/ref 17592186539639} {:answer/id #uuid "85ee42d0-6b46-5068-8546-0b6d45122f68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}21 \\\\ 15\\end{aligned}]" :db/id #edb/ref 17592186539700} {:answer/id #uuid "a2df55cc-4d93-55a0-9838-4a5a0b419174" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}58 & 26\\end{aligned}]" :db/id #edb/ref 17592186539752} {:answer/id #uuid "ae374fd7-8d71-5715-bb99-e0fa0ee5417f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}58 \\\\ 26\\end{aligned}]" :db/id #edb/ref 17592186539776}] :answer-field/correct {:answer/id #uuid "ae374fd7-8d71-5715-bb99-e0fa0ee5417f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}58 \\\\ 26\\end{aligned}]" :db/id #edb/ref 17592186539776} :answer-field/id #uuid "a4ae1559-7267-51e9-bbdf-d599082e8f60" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186539977}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3f634cb0-d91f-55a0-8036-9bf4e6795f5f" :question/math-academy-id "q-269525" :question/problem "Consider the function $L:{R}^{2}\\to R$ defined by $L(x)=(Ax-2b)^{T}(Ax-2b)$ where \n\n$$\nA=[\\begin{aligned}3 & 2 \\\\ -1 & 1 \\\\ 1 & 2\\end{aligned}],\\,b=[\\begin{aligned}1 \\\\ 3 \\\\ 5\\end{aligned}].\n$$\n\nWhat is ${∇}_{x}L(x)$ at $x=[\\begin{aligned}1 \\\\ 4\\end{aligned}]?$" :question/worked-solution "We can solve this problem by applying the chain rule for gradients.\n\nLet $y=Ax-2b.$ Then, $L(x)={y}^{T}y,$ and\n\n$$\n{∇}_{x}L={(\\frac{\\text{d}L}{\\text{d}x})}^{T}={(\\frac{\\text{d}y}{\\text{d}x})}^{T}\\cdot {(\\frac{\\text{d}L}{\\text{d}y})}^{T}.\n$$\n\nNow, since \n\n$$\n\\frac{\\text{d}}{\\text{d}y}({y}^{T}y)=2{y}^{T}\\,\\text{and}\\,\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}}{\\text{d}x}(Ax-2b)=A,\n$$\n\nwe have that \n\n$$\n\\begin{aligned}{∇}_{x}L & ={(\\frac{\\text{d}y}{\\text{d}x})}^{T}\\cdot {(\\frac{\\text{d}L}{\\text{d}y})}^{T} \\\\  & ={A}^{T}\\cdot 2y.\\end{aligned}\n$$\n\nEvaluating at $x=[\\begin{aligned}1 \\\\ 4\\end{aligned}]$, we get\n\n$$\n\\begin{aligned}{∇}_{x}L & ={A}^{T}\\cdot 2y \\\\  & =2\\cdot {A}^{T}(Ax-2b) \\\\  & =2\\cdot {[\\begin{aligned}3 & 2 \\\\ -1 & 1 \\\\ 1 & 2\\end{aligned}]}^{T}([\\begin{aligned}3 & 2 \\\\ -1 & 1 \\\\ 1 & 2\\end{aligned}]\\cdot [\\begin{aligned}1 \\\\ 4\\end{aligned}]-2\\cdot [\\begin{aligned}1 \\\\ 3 \\\\ 5\\end{aligned}]) \\\\  & =2\\cdot [\\begin{aligned}3 & -1 & 1 \\\\ 2 & 1 & 2\\end{aligned}]([\\begin{aligned}11 \\\\ 3 \\\\ 9\\end{aligned}]-[\\begin{aligned}2 \\\\ 6 \\\\ 10\\end{aligned}]) \\\\  & =[\\begin{aligned}6 & -2 & 2 \\\\ 4 & 2 & 4\\end{aligned}][\\begin{aligned}9 \\\\ -3 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}58 \\\\ 26\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186540057 :knowledge-point/_questions [{:db/id #edb/ref 17592186208847 :knowledge-point/id #uuid "2198cf08-3a99-5e5d-80af-bbe722b51647" :knowledge-point/title "Computing Gradient of a Quadratic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45292744-8b9c-5c5e-b27f-372a2cae9e71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186539608}] :answer-field/correct {:answer/id #uuid "45292744-8b9c-5c5e-b27f-372a2cae9e71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186539608} :answer-field/id #uuid "5f8172f4-c9fe-5e8d-b6a6-b70f7a350883" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186539959} {:answer-field/choices [{:answer/id #uuid "85a4f0d1-a936-5ab3-bd96-2206322e6e46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186539699}] :answer-field/correct {:answer/id #uuid "85a4f0d1-a936-5ab3-bd96-2206322e6e46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186539699} :answer-field/id #uuid "c4950606-28b0-554b-95e7-9a39d66b5c16" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186539994}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6d939167-bbdf-5642-a79d-3234f69c9c09" :question/math-academy-id "q-276043" :question/problem "Compute the gradient of the function $f:{R}^{2}\\to R$ defined by\n\n$$\nf(x)={x}^{T}[\\begin{aligned}1 & 0 \\\\ -2 & 2\\end{aligned}]x\n$$\n\nwith respect to $x$ at  $x={[\\begin{aligned}0 & -1\\end{aligned}]}^{T}.$\n\n<table cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"70px\" rowspan=\"3\" width=\"30px\">$\\,{∇}_{x}f=\\,\\,$</td>\n<td align=\"center\" height=\"35px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Defining the matrix $A$ as\n\n$$\nA=[\\begin{aligned}1 & 0 \\\\ -2 & 2\\end{aligned}],\n$$\n\nwe have $f(x)={x}^{T}Ax.$\n\nSince $A$ is not symmetric, we use the more general formula for the gradient of a quadratic function:\n\n$$\n{∇}_{x}f(x)=({A}^{T}+A)x\n$$\n\nFirst, we compute\n\n$$\n{A}^{T}=[\\begin{aligned}1 & -2 \\\\ 0 & 2\\end{aligned}],\n$$\n\nwhich gives\n\n$$\n\\begin{aligned}{A}^{T}+A & =[\\begin{aligned}1 & -2 \\\\ 0 & 2\\end{aligned}]+[\\begin{aligned}1 & 0 \\\\ -2 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -2 \\\\ -2 & 4\\end{aligned}].\\end{aligned}\n$$\n\nNow, compute the gradient at $x=[\\begin{aligned}0 \\\\ -1\\end{aligned}]:$\n\n$$\n\\begin{aligned}{∇}_{x}f(x) & =({A}^{T}+A)x \\\\  & =[\\begin{aligned}2 & -2 \\\\ -2 & 4\\end{aligned}][\\begin{aligned}0 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}0+2 \\\\ 0-4\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ -4\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186540068 :knowledge-point/_questions [{:db/id #edb/ref 17592186208847 :knowledge-point/id #uuid "2198cf08-3a99-5e5d-80af-bbe722b51647" :knowledge-point/title "Computing Gradient of a Quadratic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "abd7469e-6019-5f0b-8db1-f38b3d8887b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186539770}] :answer-field/correct {:answer/id #uuid "abd7469e-6019-5f0b-8db1-f38b3d8887b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186539770} :answer-field/id #uuid "e1453ef1-7ffc-594f-a954-83c62ec2f697" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186540003} {:answer-field/choices [{:answer/id #uuid "fbd51744-3817-5b56-83ea-b6c1a15c1145" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186539904}] :answer-field/correct {:answer/id #uuid "fbd51744-3817-5b56-83ea-b6c1a15c1145" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186539904} :answer-field/id #uuid "e69fbcb6-2b3e-5e04-95d1-2af8c246cb30" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186540006}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8b961be3-a61d-5fd5-a33f-daa3b859082d" :question/math-academy-id "q-276044" :question/problem "Compute the gradient of the function $f:{R}^{2}\\to R$ defined by\n\n$$\nf(x)={x}^{T}[\\begin{aligned}4 & 5 \\\\ -4 & -5\\end{aligned}]x\n$$\n\nwith respect to $x$ at  $x={[\\begin{aligned}0 & 1\\end{aligned}]}^{T}.$\n\n<table cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"70px\" rowspan=\"3\" width=\"30px\">$\\,{∇}_{x}f=\\,\\,$</td>\n<td align=\"center\" height=\"35px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Defining the matrix $A$ as\n\n$$\nA=[\\begin{aligned}4 & 5 \\\\ -4 & -5\\end{aligned}],\n$$\n\nwe have $f(x)={x}^{T}Ax.$\n\nSince $A$ is not symmetric, we use the more general formula for the gradient of a quadratic function:\n\n$$\n{∇}_{x}f(x)=({A}^{T}+A)x\n$$\n\nFirst, we compute\n\n$$\n{A}^{T}=[\\begin{aligned}4 & -4 \\\\ 5 & -5\\end{aligned}],\n$$\n\nwhich gives\n\n$$\n\\begin{aligned}{A}^{T}+A & =[\\begin{aligned}4 & -4 \\\\ 5 & -5\\end{aligned}]+[\\begin{aligned}4 & 5 \\\\ -4 & -5\\end{aligned}] \\\\  & =[\\begin{aligned}8 & 1 \\\\ 1 & -10\\end{aligned}].\\end{aligned}\n$$\n\nNow, compute the gradient at $x=[\\begin{aligned}0 \\\\ 1\\end{aligned}]:$\n\n$$\n\\begin{aligned}{∇}_{x}f(x) & =({A}^{T}+A)x \\\\  & =[\\begin{aligned}8 & 1 \\\\ 1 & -10\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}0+1 \\\\ 0-10\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ -10\\end{aligned}]\\end{aligned}\n$$"}]}
