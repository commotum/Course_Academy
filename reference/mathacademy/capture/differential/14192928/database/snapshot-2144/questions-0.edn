6a0-ae7c-5a95-aa4f-2d1fe9ef0547" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,\\pm \\frac{1}{2})" :db/id #edb/ref 17592186346502} {:answer/id #uuid "a6a2d8bf-48bf-5da5-90a2-7008bec13e2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,\\pm \\frac{1}{5})" :db/id #edb/ref 17592186346805} {:answer/id #uuid "c7fdc1b0-3c2a-5e5b-b9d1-70dff0f84be3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There are no  points of intersection" :db/id #edb/ref 17592186347090} {:answer/id #uuid "d6004c18-0136-5b7b-be01-c5b790748a8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,\\pm 1)" :db/id #edb/ref 17592186347233} {:answer/id #uuid "f01841ca-b9ae-5d4e-a206-2c0542af7f44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,\\pm 2)" :db/id #edb/ref 17592186347469}] :answer-field/correct {:answer/id #uuid "c7fdc1b0-3c2a-5e5b-b9d1-70dff0f84be3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There are no  points of intersection" :db/id #edb/ref 17592186347090} :answer-field/id #uuid "41dba670-c743-5a3f-8192-b17aade23c5c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347716}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5288b026-c904-5dff-a79f-36c3720bde84" :question/math-academy-id "q-8011" :question/problem "Calculate the points where the hyperbola \n$25{x}^{2}-{y}^{2}=26$\nintersects the line $x=1.$" :question/worked-solution "To find the points where the hyperbola intersects the line $x=1,$ we substitute $x=1$ into the equation of the hyperbola and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}25{x}^{2}-{y}^{2} & =26 \\\\ 25(1)^{2}-{y}^{2} & =26 \\\\ -{y}^{2} & =26-25 \\\\ -{y}^{2} & =1 \\\\ {y}^{2} & =-1\\end{aligned}\n$$\n\nWe cannot take the square root of a negative number. Therefore, the equation has no real solutions. \nSo, the hyperbola does not intersect the vertical line $x=1.$"}] [{:db/id #edb/ref 17592186354281 :knowledge-point/_questions [{:db/id #edb/ref 17592186087835 :knowledge-point/id #uuid "2de185a6-24a0-55aa-905d-8893a555e331" :knowledge-point/title "Finding the X-Intercepts of a Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0261d69a-d0b1-5b42-a14c-72a8e3ef4636" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There are no $x$-intercepts" :db/id #edb/ref 17592186351586} {:answer/id #uuid "3743079e-514f-55fc-a216-d53dd2934fa9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\pm 3,0)" :db/id #edb/ref 17592186352082} {:answer/id #uuid "61514553-2988-55db-833d-8c08bbe7e57f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,0)" :db/id #edb/ref 17592186352434} {:answer/id #uuid "bca4c387-c08a-5ba3-9323-ea7b3ec29bbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\pm 2,0)" :db/id #edb/ref 17592186353174} {:answer/id #uuid "ef297abd-a599-5f50-810f-1054aeb7923a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,0)" :db/id #edb/ref 17592186353650}] :answer-field/correct {:answer/id #uuid "61514553-2988-55db-833d-8c08bbe7e57f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,0)" :db/id #edb/ref 17592186352434} :answer-field/id #uuid "7276433c-4ede-5bac-8495-aa87bf4de9ab" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354030}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d3887d86-f3f7-5655-a347-83374fa0d7ec" :question/math-academy-id "q-84035" :question/problem "Calculate the $x$-intercepts of the hyperbola $\\frac{(y-2)^{2}}{4}-\\frac{(x+2)^{2}}{9}=1.$" :question/worked-solution "To find the $x$-intercepts of the hyperbola, we substitute $y=0$ into the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}\\frac{(y-2)^{2}}{4}-\\frac{(x+2)^{2}}{9} & =1 \\\\ \\frac{(0-2)^{2}}{4}-\\frac{(x+2)^{2}}{9} & =1 \\\\ 1-\\frac{(x+2)^{2}}{9} & =1 \\\\ \\frac{(x+2)^{2}}{9} & =0 \\\\ (x+2)^{2} & =0 \\\\ x+2 & =0 \\\\ x & =-2\\end{aligned}\n$$\n\nTherefore, the $x$-intercept is $(-2,0).$"}]}
