/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "38e098ba-2563-5c51-8af3-272acb29f55b" :question/math-academy-id "q-277800" :question/problem "From **left to right,** the $x$-intercepts of the hyperbola $9{x}^{2}-16{y}^{2}=144$ are\n\n$($\n{{field-1}}, \n{{field-2}} $)\\,$\nand \n$\\,($\n{{field-3}}, \n{{field-4}} $).$" :question/worked-solution "To find the $x$-intercepts of the hyperbola, we substitute $y=0$ into the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}9{x}^{2}-16{y}^{2} & =144 \\\\ 9{x}^{2}-16(0)^{2} & =144 \\\\ 9{x}^{2} & =144 \\\\ {x}^{2} & =16 \\\\ x & =\\pm 4\\end{aligned}\n$$\n\nTherefore, from left to right, the $x$-intercepts are $(-4,0)$ and $(4,0).$"}] [{:db/id #edb/ref 17592186294916 :knowledge-point/_questions [{:db/id #edb/ref 17592186087835 :knowledge-point/id #uuid "2de185a6-24a0-55aa-905d-8893a555e331" :knowledge-point/title "Finding the X-Intercepts of a Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b4cb53a8-6f93-5bf1-b116-85fd37cbf40a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186293638}] :answer-field/correct {:answer/id #uuid "b4cb53a8-6f93-5bf1-b116-85fd37cbf40a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186293638} :answer-field/id #uuid "2ae36ae8-659e-5d9a-9e34-2622936215db" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294075} {:answer-field/choices [{:answer/id #uuid "e1e07c1f-4e9e-5461-b224-88d5bf548f7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186293817}] :answer-field/correct {:answer/id #uuid "e1e07c1f-4e9e-5461-b224-88d5bf548f7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186293817} :answer-field/id #uuid "6031b2f3-7476-556d-8ab1-a0481f8e46b5" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294273}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "de2dc34f-1c0d-5c73-aef7-be1610303590" :question/math-academy-id "q-277801" :question/problem "The $x$-intercept of the hyperbola $\\frac{(y-3)^{2}}{9}-\\frac{(x-1)^{2}}{16}=1$ is$\\,(${{field-1}},\n{{field-2}}$).$" :question/worked-solution "To find the $x$-intercepts of the hyperbola, we substitute $y=0$ into the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}\\frac{(y-3)^{2}}{9}-\\frac{(x-1)^{2}}{16} & =1 \\\\ \\frac{(0-3)^{2}}{9}-\\frac{(x-1)^{2}}{16} & =1 \\\\ 1-\\frac{(x-1)^{2}}{16} & =1 \\\\ \\frac{(x-1)^{2}}{16} & =0 \\\\ (x-1)^{2} & =0 \\\\ x-1 & =0 \\\\ x & =1\\end{aligned}\n$$\n\nTherefore, the $x$-intercept is $(1,0).$"}] [{:db/id #edb/ref 17592186372494 :knowledge-point/_questions [{:db/id #edb/ref 17592186087835 :knowledge-point/id #uuid "2de185a6-24a0-55aa-905d-8893a555e331" :knowledge-point/title "Finding the X-Intercepts of a Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f6f004bf-99d3-5475-8626-29edc769a4e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186372496}] :answer-field/correct {:answer/id #uuid "f6f004bf-99d3-5475-8626-29edc769a4e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186372496} :answer-field/id #uuid "7e09f84e-759d-5b62-84b8-b0ecc65fd2db" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186372495} {:answer-field/choices [{:answer/id #uuid "5bbe119f-ff42-539e-89e6-84be5f6e18d6" :answer/type {:db/id 