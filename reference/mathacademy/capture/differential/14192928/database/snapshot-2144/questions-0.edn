 17592186294482} {:answer-field/choices [{:answer/id #uuid "a7d41a87-a266-54df-89d1-59640505e03b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{5}" :db/id #edb/ref 17592186293595}] :answer-field/correct {:answer/id #uuid "a7d41a87-a266-54df-89d1-59640505e03b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{5}" :db/id #edb/ref 17592186293595} :answer-field/id #uuid "d742873e-1ed0-5f6a-9522-c46caf7a67b3" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294690}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "caf63029-110c-5e5e-ab8d-bb58a2ab4f5f" :question/math-academy-id "q-278363" :question/problem "From **top to bottom,** the $y$-intercepts of the hyperbola $6{y}^{2}-5{x}^{2}=30$ are\n\n$($\n{{field-1}}, \n{{field-2}} $)\\,$\nand\n$\\,($\n{{field-3}}, \n{{field-4}} $).$" :question/worked-solution "To find the $y$-intercepts of the hyperbola, we substitute $x=0$ into the equation of the hyperbola and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}6{y}^{2}-5{x}^{2} & =30 \\\\ 6{y}^{2}-5(0)^{2} & =30 \\\\ 6{y}^{2} & =30 \\\\ {y}^{2} & =5 \\\\ y & =\\pm \\sqrt{5}\\end{aligned}\n$$\n\nSo, from top to bottom, the $y$-intercepts are $(0,\\sqrt{5})$ and $(0,-\\sqrt{5}).$"}] [{:db/id #edb/ref 17592186294988 :knowledge-point/_questions [{:db/id #edb/ref 17592186087836 :knowledge-point/id #uuid "c249cf3a-7864-5132-80fa-c18a3ea915c2" :knowledge-point/title "Finding the Y-Intercepts of a Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7ad6fe0f-c565-5684-91ad-9e21267630ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186293424}] :answer-field/correct {:answer/id #uuid "7ad6fe0f-c565-5684-91ad-9e21267630ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186293424} :answer-field/id #uuid "3d73d485-821e-52d1-b8b1-44722cdc845d" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294140} {:answer-field/choices [{:answer/id #uuid "60cc30e5-01eb-5ab9-9fe9-1a991f3d74c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186293325}] :answer-field/correct {:answer/id #uuid "60cc30e5-01eb-5ab9-9fe9-1a991f3d74c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186293325} :answer-field/id #uuid "4ea13570-d4e6-5a89-9ffb-6fe4d9708580" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294208} {:answer-field/choices [{:answer/id #uuid "3a8b4fc2-9b2a-5aca-9399-f02af8dda9e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186293173}] :answer-field/correct {:answer/id #uuid "3a8b4fc2-9b2a-5aca-9399-f02af8dda9e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186293173} :answer-field/id #uuid "7fb1da56-2a3b-5e69-8f30-5bf8eadfb19d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294380} {:answer-field/choices [{:answer/id #uuid "fa351968-4358-5e73-9ca3-74a268c124ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186293917}] :answer-field/correct {:answer/id #uuid "fa351968-4358-5e73-9ca3-74a268c124ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186293917} :answer-field/id #uuid "fa02b35d-22df-54f3-98bc-a4a4f0ca160c" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294809}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "80180fd4-af04-50e1-bba0-8e167a16e61a" :question/math-academy-id "q-278364" :question/problem "From **top to bottom,** the $y$-intercepts of the hyperbola $\\frac{(y-5)^{2}}{9}-\\frac{{x}^{2}}{8}=1$ are\n\n$($\n{{field-1}}, \n{{field-2}} $)\\,$\nand\n$\\,($\n{{field-3}}, \n{{field-4}} $).$" :question/worked-solution "To find the $y$-intercepts of the hyperbola, we substitute $x=0$ into the equation of the hyperbola and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}\\frac{(y-5)^{2}}{9}-\\frac{{x}^{2}}{8} & =1 \\\\ \\frac{(y-5)^{2}}{9}-\\frac{(0)^{2}}{8} & =1 \\\\ \\frac{(y-5)^{2}}{9} & =1 \\\\ (y-5)^{2} & =9 \\\\ y-5 & =\\pm 3 \\\\ y & =5\\pm 3\\end{aligned}\n$$\n\nSo, from top to bottom, the $y$-intercepts are $(0,8)$ and $(0,2).$"}] [{:db/id #edb/ref 17592186294992 :knowledge-point/_questions [{:db/id #edb/ref 17592186087837 :knowledge-point/id #uuid "395f435d-473f-5dae-b215-2986556d5793" :knowledge-point/title "Finding the Points of Intersection of a Hyperbola and a Horizontal or Vertical Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7159a2b3-ad0a-59ed-849d-be658c1a6563" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186293401}] :answer-field/correct {:answer/id #uuid "7159a2b3-ad0a-59ed-849d-be658c1a6563" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186293401} :answer-field/id #uuid "429d20fc-5af0-5428-ad4f-df96b44e2114" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294163} {:answer-field/choices [{:answer/id #uuid "e9dc6d16-e696-5e7a-9e0e-bf90481d8fb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186293843}] :answer-field/correct {:answer/id #uuid "e9dc6d16-e696-5e7a-9e0e-bf90481d8fb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186293843} :answer-field/id #uuid "8f631fbb-665c-526a-bee1-d771fc94e806" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294447}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0135d9ff-5368-56ef-b879-e7fafdfd541f" :question/math-academy-id "q-278371" :question/problem "The hyperbola $\\frac{{x}^{2}}{9}-\\frac{{y}^{2}}{25}=1$ intersects the line $x=-3$ at\n\n$($\n{{field-1}}, \n{{field-2}} $).$" :question/worked-solution "To find the points where the hyperbola intersects the line $x=-3,$ we substitute $x=-3$ into the equation of the hyperbola and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{9}-\\frac{{y}^{2}}{25} & =1 \\\\ \\frac{(-3)^{2}}{9}-\\frac{{y}^{2}}{25} & =1 \\\\ 1-\\frac{{y}^{2}}{25} & =1 \\\\ -{y}^{2} & =0 \\\\ y & =0\\end{aligned}\n$$\n\nTherefore, the hyperbola intersects the horizontal line $x=-3$ at $(-3,0).$"}] [{:db/id #edb/ref 17592186294995 :knowledge-point/_questions [{:db/id #edb/ref 17592186087838 :knowledge-point/id #uuid "55a53010-eddc-5115-8c70-0f32d0144384" :knowledge-point/title "Finding the Points of Intersection of a Hyperbola and a Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26181e7b-f5aa-57d3-a34f-76e4d8b3089c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186293099}] :answer-field/correct {:answer/id #uuid "26181e7b-f5aa-57d3-a34f-76e4d8b3089c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186293099} :answer-field/id #uuid "0b96a7b5-cf7b-5442-966e-fee8f1d8ebc3" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186293962} {:answer-field/choices [{:answer/id #uuid "6f40daa7-838a-53bf-ae73-bbe6573f9db8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186293397}] :answer-field/correct {:answer/id #uuid "6f40daa7-838a-53bf-ae73-bbe6573f9db8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186293397} :answer-field/id #uuid "3f8d1b04-52a4-5ca6-ac6c-dc34a02883a2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294148}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "61ece0da-9c0b-5643-afdc-8f35ca2ac1ce" :question/math-academy-id "q-278374" :question/problem "In **ascending order,** the $x$-coordinates of the points where the hyperbola $\\frac{{y}^{2}}{3}-\\frac{{x}^{2}}{12}=1$ intersects the line $y=x$ are\n\n$\\,x=$\n{{field-1}}$\\,$ and $\\,x=$\n{{field-2}}." :question/worked-solution "To find the points where the hyperbola intersects the line $y=x,$ we first replace $y$ with $x$ in the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}\\frac{{y}^{2}}{3}-\\frac{{x}^{2}}{12} & =1 \\\\ \\frac{{x}^{2}}{3}-\\frac{{x}^{2}}{12} & =1 \\\\ \\frac{12{x}^{2}}{36}-\\frac{3{x}^{2}}{36} & =1 \\\\ \\frac{9{x}^{2}}{36} & =1 \\\\ {x}^{2} & =4 \\\\ x & =\\pm 2\\end{aligned}\n$$\n\nSo, in ascending order, the $x$-coordinates of the points of intersection are\n$x=-2$ and $x=2.$"}] [{:db/id #edb/ref 17592186294998 :knowledge-point/_questions [{:db/id #edb/ref 17592186087838 :knowledge-point/id #uuid "55a53010-eddc-5115-8c70-0f32d0144384" :knowledge-point/title "Finding the Points of Intersection of a Hyperbola and a Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "da06eb4e-6f49-5647-af1e-5a3bde668648" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186293777}] :answer-field/correct {:answer/id #uuid "da06eb4e-6f49-5647-af1e-5a3bde668648" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186293777} :answer-field/id #uuid "2ba31c1e-0066-58c0-a59b-bf7229f96f23" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294077} {:answer-field/choices [{:answer/id #uuid "6a91ca0b-9ab7-55f2-be30-68f4ce1f7072" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{5}" :db/id #edb/ref 17592186293375}] :answer-field/correct {:answer/id #uuid "6a91ca0b-9ab7-55f2-be30-68f4ce1f7072" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{5}" :db/id #edb/ref 17592186293375} :answer-field/id #uuid "503ad216-b136-5c03-8014-8da49bdaac89" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294215}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e3924c5a-e5b9-5636-819e-461c9a4e5ffe" :question/math-academy-id "q-278379" :question/problem "In **ascending order,** the $x$-coordinates of the points where the hyperbola ${y}^{2}-{x}^{2}=20$ intersects the line $y=\\sqrt{5}x$ are\n\n$\\,x=$\n{{field-1}}$\\,$ and $\\,x=$\n{{field-2}}." :question/worked-solution "To find the points where the hyperbola intersects the line $y=\\sqrt{5}x,$ we first replace $y$ with $\\sqrt{5}x$ in the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}{y}^{2}-{x}^{2} & =20 \\\\ (\\sqrt{5}x)^{2}-{x}^{2} & =20 \\\\ 5{x}^{2}-{x}^{2} & =20 \\\\ 4{x}^{2} & =20 \\\\ {x}^{2} & =5 \\\\ x & =\\pm \\sqrt{5}\\end{aligned}\n$$\n\nSo, in ascending order, the $x$-coordinates of the points of intersection are\n$x=-\\sqrt{5}$ and $x=\\sqrt{5}.$"}] [{:db/id #edb/ref 17592186295001 :knowledge-point/_questions [{:db/id #edb/ref 17592186087837 :knowledge-point/id #uuid "395f435d-473f-5dae-b215-2986556d5793" :knowledge-point/title "Finding the Points of Intersection of a Hyperbola and a Horizontal or Vertical Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d9410843-121f-5f55-912f-3aacd994b6d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.5" :db/id #edb/ref 17592186293773}] :answer-field/correct {:answer/id #uuid "d9410843-121f-5f55-912f-3aacd994b6d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.5" :db/id #edb/ref 17592186293773} :answer-field/id #uuid "24aff086-04c0-550a-8a20-aa2ae3b74632" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294048} {:answer-field/choices [{:answer/id #uuid "ed867299-e832-552d-b6fe-ffc7df8b0c60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186293856}] :answer-field/correct {:answer/id #uuid "ed867299-e832-552d-b6fe-ffc7df8b0c60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186293856} :answer-field/id #uuid "27119b04-9a34-576e-b322-eea659f96587" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294053} {:answer-field/choices [{:answer/id #uuid "b2f1480f-5152-5f08-9e16-597d090a5275" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186293633}] :answer-field/correct {:answer/id #uuid "b2f1480f-5152-5f08-9e16-597d090a5275" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186293633} :answer-field/id #uuid "3fdc21ad-6cb6-57dc-80db-0cae760683a8" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294150} {:answer-field/choices [{:answer/id #uuid "f17287c2-b55e-5a91-9e75-c538da6eddb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.5" :db/id #edb/ref 17592186293870}] :answer-field/correct {:answer/id #uuid "f17287c2-b55e-5a91-9e75-c538da6eddb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.5" :db/id #edb/ref 17592186293870} :answer-field/id #uuid "878e9971-90b6-539e-84dc-c87b3778cc46" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294413}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7096e183-2bac-525e-a16f-e109d122f25b" :question/math-academy-id "q-278384" :question/problem "From **left to right**, the points where the hyperbola $4{y}^{2}-{x}^{2}=16$ intersects the line $y=2.5$ are\n\n$($\n{{field-1}}, \n{{field-2}} $)\\,$\nand\n$\\,($\n{{field-3}}, \n{{field-4}} $).$" :question/worked-solution "To find the points where the hyperbola intersects the line $y=2.5,$ we substitute $y=2.5$ into the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}4{y}^{2}-{x}^{2} & =16 \\\\ 4(2.5)^{2}-{x}^{2} & =16 \\\\ 25-{x}^{2} & =16 \\\\ -{x}^{2} & =16-25 \\\\ -{x}^{2} & =-9 \\\\ {x}^{2} & =9 \\\\ x & =\\pm 3\\end{aligned}\n$$\n\nTherefore, from left to right, the hyperbola intersects the vertical line $y=2.5$  at the points $(-3,2.5)$ and $(3,2.5).$"}] [{:db/id #edb/ref 17592186295003 :knowledge-point/_questions [{:db/id #edb/ref 17592186087837 :knowledge-point/id #uuid "395f435d-473f-5dae-b215-2986556d5793" :knowledge-point/title "Finding the Points of Intersection of a Hyperbola and a Horizontal or Vertical Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6854631d-b1aa-54b7-a904-1858e89a5d92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186293365}] :answer-field/correct {:answer/id #uuid "6854631d-b1aa-54b7-a904-1858e89a5d92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186293365} :answer-field/id #uuid "acef4a2a-5171-5f64-b8b4-7681b58142d6" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294553} {:answer-field/choices [{:answer/id #uuid "c820166d-133f-5435-b8a2-e50c3964ddbe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186293708}] :answer-field/correct {:answer/id #uuid "c820166d-133f-5435-b8a2-e50c3964ddbe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186293708} :answer-field/id #uuid "fcc00e0b-6565-5a83-880f-674f914bedf0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294816}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c767294f-ea32-5b5b-87be-45853c02b18d" :question/math-academy-id "q-278387" :question/problem "The hyperbola ${x}^{2}-\\frac{{y}^{2}}{9}=1$ intersects the line $x=1$ at\n\n$($\n{{field-1}}, \n{{field-2}} $).$" :question/worked-solution "To find the points where the hyperbola intersects the line $x=1,$ we substitute $x=1$ into the equation of the hyperbola and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}{x}^{2}-\\frac{{y}^{2}}{9} & =1 \\\\ (1)^{2}-\\frac{{y}^{2}}{9} & =1 \\\\ 1-\\frac{{y}^{2}}{9} & =1 \\\\ -{y}^{2} & =0 \\\\ y & =0\\end{aligned}\n$$\n\nTherefore, the hyperbola intersects the vertical line $x=1$  at $(1,0).$"}] [{:db/id #edb/ref 17592186506539 :knowledge-point/_questions [{:db/id #edb/ref 17592186087838 :knowledge-point/id #uuid "55a53010-eddc-5115-8c70-0f32d0144384" :knowledge-point/title "Finding the Points of Intersection of a Hyperbola and a Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86e76208-c265-5c81-91a9-9d7bd1fd5306" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pm 1" :db/id #edb/ref 17592186506145} {:answer/id #uuid "9675fe85-7975-59d8-9664-3302a77207ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pm 2" :db/id #edb/ref 17592186506170} {:answer/id #uuid "a51488ec-452c-5575-a1eb-84e336de74f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-4,2" :db/id #edb/ref 17592186506212} {:answer/id #uuid "aa7d0d43-7a8c-5962-b8b5-4c3c06669448" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pm 4" :db/id #edb/ref 17592186506222} {:answer/id #uuid "aed3b00a-d039-5940-8d0c-0362d91e6fc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-2,4" :db/id #edb/ref 17592186506230}] :answer-field/correct {:answer/id #uuid "aa7d0d43-7a8c-5962-b8b5-4c3c06669448" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pm 4" :db/id #edb/ref 17592186506222} :answer-field/id #uuid "8104f5d8-0918-5967-b703-49d7f0e9eadd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186506438}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "48e55e9e-f8d4-5cc0-b60c-cb504ca3f4b2" :question/math-academy-id "q-8002" :question/problem "Calculate the $x$-coordinates of the points where the hyperbola $5{x}^{2}-4{y}^{2}=16$ intersects the line $y=x.$" :question/worked-solution "To find the points where the hyperbola intersects the line $y=x,$ we first replace $y$ with $x$ in the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}5{x}^{2}-4{y}^{2} & =16 \\\\ 5{x}^{2}-4{x}^{2} & =16 \\\\ {x}^{2} & =16 \\\\ x & =\\pm 4\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186348326 :knowledge-point/_questions [{:db/id #edb/ref 17592186087837 :knowledge-point/id #uuid "395f435d-473f-5dae-b215-2986556d5793" :knowledge-point/title "Finding the Points of Intersection of a Hyperbola and a Horizontal or Vertical Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02663bbe-2654-5af5-9b5b-4e8c4e1916cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\pm 3,1)" :db/id #edb/ref 17592186345369} {:answer/id #uuid "2c8a94e6-9604-515d-86fc-d1c348b467d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\pm 1,1)" :db/id #edb/ref 17592186345749} {:answer/id #uuid "3a56a2bb-8115-5c70-ac47-863f5a1b19b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-6,1)$ and $(2,1)$" :db/id #edb/ref 17592186345851} {:answer/id #uuid "6a8a58ca-7ff3-535a-805c-0eea1646f6c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\pm 2,1)" :db/id #edb/ref 17592186346274} {:answer/id #uuid "6f2db012-5162-544b-a35a-b2c61a955eb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\pm 6,1)" :db/id #edb/ref 17592186346324}] :answer-field/correct {:answer/id #uuid "02663bbe-2654-5af5-9b5b-4e8c4e1916cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\pm 3,1)" :db/id #edb/ref 17592186345369} :answer-field/id #uuid "ebdacf6a-0495-5e9a-8dad-4bfebbc2c674" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186348022}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "da37c5c2-1cf7-558e-986b-281da0d2eca6" :question/math-academy-id "q-8008" :question/problem "Calculate the points where the hyperbola \n$\\frac{{x}^{2}}{6}-\\frac{{y}^{2}}{2}=1$\nintersects the line $y=1.$" :question/worked-solution "To find the points where the hyperbola intersects the line $y=1,$ we substitute $y=1$ into the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{6}-\\frac{{y}^{2}}{2} & =1 \\\\ \\frac{{x}^{2}}{6}-\\frac{(1)^{2}}{2} & =1 \\\\ \\frac{{x}^{2}}{6}-\\frac{1}{2} & =1 \\\\ \\frac{{x}^{2}}{6} & =\\frac{3}{2} \\\\ {x}^{2} & =9 \\\\ x & =\\pm 3\\end{aligned}\n$$\n\nTherefore, the hyperbola intersects the horizontal line $y=1$ at the points $(\\pm 3,1).$"}] [{:db/id #edb/ref 17592186506585 :knowledge-point/_questions [{:db/id #edb/ref 17592186087838 :knowledge-point/id #uuid "55a53010-eddc-5115-8c70-0f32d0144384" :knowledge-point/title "Finding the Points of Intersection of a Hyperbola and a Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "202f1ef1-7013-51df-9e16-c9120bd4144f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pm 3" :db/id #edb/ref 17592186505965} {:answer/id #uuid "5e31ff2b-eed8-54a4-9c63-1385779eeb3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pm 1" :db/id #edb/ref 17592186506077} {:answer/id #uuid "838261f2-b5a9-5711-a5d7-9938944a3fc7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There are no points of intersection" :db/id #edb/ref 17592186506140} {:answer/id #uuid "a3e52d3b-1bd1-5