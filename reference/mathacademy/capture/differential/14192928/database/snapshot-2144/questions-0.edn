#{[{:db/id #edb/ref 17592186087552 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186087835 :knowledge-point/id #uuid "2de185a6-24a0-55aa-905d-8893a555e331" :knowledge-point/title "Finding the X-Intercepts of a Hyperbola"}] :question/id #uuid "03bb8d2d-55c5-5511-94c5-73e73db9ccf8" :question/math-academy-id "e-5361" :question/problem "Calculate the $x$-intercepts of the hyperbola $\\dfrac{(x+1)^2}{10} - \\dfrac{y^2}{25} = 1.$" :question/worked-solution "To find the $x$-intercepts of the hyperbola, we substitute $y=0$ into the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}\\frac{(x+1)^{2}}{10}-\\frac{{y}^{2}}{25} & =1 \\\\ \\frac{(x+1)^{2}}{10}-\\frac{{0}^{2}}{25} & =1 \\\\ \\frac{(x+1)^{2}}{10} & =1 \\\\ (x+1)^{2} & =10 \\\\ x+1 & =\\pm \\sqrt{10} \\\\ x & =-1\\pm \\sqrt{10}\\end{aligned}\n$$\n\nTherefore, the $x$-intercepts are $\\left(-1\\pm \\sqrt{10},0\\right).$"}] [{:db/id #edb/ref 17592186087553 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186087837 :knowledge-point/id #uuid "395f435d-473f-5dae-b215-2986556d5793" :knowledge-point/title "Finding the Points of Intersection of a Hyperbola and a Horizontal or Vertical Line"}] :question/id #uuid "b3eac4e2-5e85-5669-8dfb-c7fe4e5a47ae" :question/math-academy-id "e-5362" :question/problem "Calculate the points where the hyperbola \n$\\dfrac{x^2}{10}-\\dfrac{y^2}{15}=1$\nintersects the line $y=-3.$" :question/worked-solution "To find the points where the hyperbola intersects the line $y=-3,$ we substitute $y=-3$ into the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{10}-\\frac{{y}^{2}}{15} & =1 \\\\ \\frac{{x}^{2}}{10}-\\frac{(-3)^{2}}{15} & =1 \\\\ \\frac{{x}^{2}}{10}-\\frac{9}{15} & =1 \\\\ \\frac{{x}^{2}}{10}-\\frac{3}{5} & =1 \\\\ {x}^{2}-6 & =10 \\\\ {x}^{2} & =16 \\\\ x & =\\pm 4\\end{aligned}\n$$\n\nTherefore, the hyperbola intersects the horizontal line $y=-3$ at the points $(\\pm 4, -3).$"}] [{:db/id #edb/ref 17592186087625 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186087836 :knowledge-point/id #uuid "c249cf3a-7864-5132-80fa-c18a3ea915c2" :knowledge-point/title "Finding the Y-Intercepts of a Hyperbola"}] :question/id #uuid "bb09b5f0-832f-5008-970c-87c6dfaf076f" :question/math-academy-id "e-7424" :question/problem "Calculate the $y$-intercepts of the hyperbola $7y^2 -5x^2 = 28.$" :question/worked-solution "To find the $y$-intercepts of the hyperbola, we substitute $x=0$ into the equation of the hyperbola and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}7{y}^{2}-5{x}^{2} & =28 \\\\ 7{y}^{2}-5(0)^{2} & =28 \\\\ 7{y}^{2} & =28 \\\\ {y}^{2} & =4 \\\\ y & =\\pm 2\\end{aligned}\n$$\n\nTherefore, the $y$-intercepts are $(0,\\pm 2).$"}] [{:db/id #edb/ref 17592186087626 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186087838 :knowledge-point/id #uuid "55a53010-eddc-5115-8c70-0f32d0144384" :knowledge-point/title "Finding the Points of Intersection of a Hyperbola and a Line"}] :question/id #uuid "0704ee42-bc8c-5d98-b6f2-ad952ab41560" :question/math-academy-id "e-7425" :question/problem "![](images/c8/c8d69cebc1c7388bb9bc8ac73152a9b2941156188917ee6b680f6758a3d777de.png)\n\nCalculate the $x$-coordinates of the points where the hyperbola $\\dfrac{x^2}{9} - \\dfrac{y^2}{25}=1$ intersects the line $y = x.$" :question/worked-solution "To find the points where the hyperbola intersects the line $y=x,$ we first replace $y$ with $x$ in the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{9}-\\frac{{y}^{2}}{25} & =1 \\\\ \\frac{{x}^{2}}{9}-\\frac{{x}^{2}}{25} & =1 \\\\ \\frac{16{x}^{2}}{225} & =1 \\\\ {x}^{2} & =\\frac{225}{16} \\\\ x & =\\pm \\frac{15}{4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186087977 :knowledge-point/_questions [{:db/id #edb/ref 17592186087836 :knowledge-point/id #uuid "c249cf3a-7864-5132-80fa-c18a3ea915c2" :knowledge-point/title "Finding the Y-Intercepts of a Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e2b5f68-4936-51d3-a8b2-ec31db3c12c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,-3)$ and $(0,2)$" :db/id #edb/ref 17592186505962} {:answer/id #uuid "6d3ff4c2-b1b9-5057-be7e-101bc3d7ddcb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,\\pm 9)" :db/id #edb/ref 17592186506102} {:answer/id #uuid "73b25063-1e07-516a-8a8e-3b366b4d0aa1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,-2)$ and $(0,3)$" :db/id #edb/ref 17592186506119} {:answer/id #uuid "75c21824-a155-50ad-8c06-d0ffc9cfcfad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,\\pm 2)" :db/id #edb/ref 17592186506122} {:answer/id #uuid "acf64965-e02c-505f-870b-4d186b665498" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,\\pm 4)" :db/id #edb/ref 17592186506227}] :answer-field/correct {:answer/id #uuid "75c21824-a155-50ad-8c06-d0ffc9cfcfad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,\\pm 2)" :db/id #edb/ref 17592186506122} :answer-field/id #uuid "b17529aa-a803-5b7b-98c3-559a7e331a4a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186084596}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bb5b26cc-aa49-5ffc-81f1-0bc5ef548212" :question/math-academy-id "q-10483" :question/problem "Calculate the $y$-intercepts of the hyperbola $\\frac{{y}^{2}}{4}-\\frac{{x}^{2}}{9}=1.$" :question/worked-solution "To find the $y$-intercepts of the hyperbola, we substitute $x=0$ into the equation of the hyperbola and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}\\frac{{y}^{2}}{4}-\\frac{{x}^{2}}{9} & =1 \\\\ \\frac{{y}^{2}}{4}-\\frac{{0}^{2}}{9} & =1 \\\\ \\frac{{y}^{2}}{4} & =1 \\\\ {y}^{2} & =4 \\\\ y & =\\pm 2\\end{aligned}\n$$\n\nTherefore, the $y$-intercepts are $(0,\\pm 2).$"}] [{:db/id #edb/ref 17592186087978 :knowledge-point/_questions [{:db/id #edb/ref 17592186087838 :knowledge-point/id #uuid "55a53010-eddc-5115-8c70-0f32d0144384" :knowledge-point/title "Finding the Points of Intersection of a Hyperbola and a Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12eb6448-58f5-581e-959d-f17cde36cd92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pm \\frac{5}{2}" :db/id #edb/ref 17592186505948} {:answer/id #uuid "541d981c-7fbc-51ce-b15c-7e8dd89db6d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pm \\frac{3}{2}" :db/id #edb/ref 17592186506054} {:answer/id #uuid "94612396-a7c1-55fe-874a-205c9c5d8ab8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pm 2" :db/id #edb/ref 17592186506164} {:answer/id #uuid "b8ad00fb-6034-5322-aab0-27d30d905179" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pm 3" :db/id #edb/ref 17592186506246} {:answer/id #uuid "fad994f1-9bf4-5359-add7-d0d13eee0c8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pm \\frac{7}{2}" :db/id #edb/ref 17592186506372}] :answer-field/correct {:answer/id #uuid "12eb6448-58f5-581e-959d-f17cde36cd92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pm \\frac{5}{2}" :db/id #edb/ref 17592186505948} :answer-field/id #uuid "ea07bafb-2d7f-5981-a637-e7561976b69f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186084602}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "05138260-0471-5e01-b040-ffc1ad6ce57f" :question/math-academy-id "q-10489" :question/problem "Calculate the $x$-coordinates of the points where the hyperbola $\\frac{{y}^{2}}{5}-\\frac{{x}^{2}}{25}=1$ intersects the line $y=-x.$" :question/worked-solution "To find the points where the hyperbola intersects the line $y=-x,$ we first replace $y$ with $-x$ in the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}\\frac{{y}^{2}}{5}-\\frac{{x}^{2}}{25} & =1 \\\\ \\frac{(-x)^{2}}{5}-\\frac{{x}^{2}}{25} & =1 \\\\ \\frac{{x}^{2}}{5}-\\frac{{x}^{2}}{25} & =1 \\\\ \\frac{5{x}^{2}}{25}-\\frac{{x}^{2}}{25} & =1 \\\\ \\frac{4{x}^{2}}{25} & =1 \\\\ {x}^{2} & =\\frac{25}{4} \\\\ x & =\\pm \\frac{5}{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186372363 :knowledge-point/_questions [{:db/id #edb/ref 17592186087836 :knowledge-point/id #uuid "c249cf3a-7864-5132-80fa-c18a3ea915c2" :knowledge-point/title "Finding the Y-Intercepts of a Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7625f8c6-161c-52fc-aaa1-209681e826d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,\\pm \\frac{1}{5})" :db/id #edb/ref 17592186372365} {:answer/id #uuid "c23309d7-ce49-5954-9985-dc6726cdbfdd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,\\pm 5)" :db/id #edb/ref 17592186372366} {:answer/id #uuid "f5d01c94-d2f1-5473-9ab5-a82dd47cadb0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,\\pm 4)" :db/id #edb/ref 17592186372367} {:answer/id #uuid "51d6d840-b502-5dc6-988c-1e8cf1b58844" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There are no $y$-intercepts" :db/id #edb/ref 17592186372368} {:answer/id #uuid "e2c9f122-c1a3-5a21-b66e-f5cf3c06931e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,\\pm \\frac{1}{4})" :db/id #edb/ref 17592186372369}] :answer-field/correct {:answer/id #uuid "51d6d840-b502-5dc6-988c-1e8cf1b58844" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There are no $y$-intercepts" :db/id #edb/ref 17592186372368} :answer-field/id #uuid "4b195795-2ddb-57bf-ab90-a6b5dbc7af6b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186372364}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cb98a0f4-3a47-5a3f-8676-25371977fac8" :question/math-academy-id "q-170554" :question/problem "Calculate the $y$-intercepts of the hyperbola $\\frac{{x}^{2}}{16}-\\frac{{y}^{2}}{25}=1.$" :question/worked-solution "To find the $y$-intercepts of the hyperbola, we substitute $x=0$ into the equation of the hyperbola and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{16}-\\frac{{y}^{2}}{25} & =1 \\\\ \\frac{{0}^{2}}{16}-\\frac{{y}^{2}}{25} & =1 \\\\ 0-\\frac{{y}^{2}}{25} & =1 \\\\ -\\frac{{y}^{2}}{25} & =1 \\\\ \\frac{{y}^{2}}{25} & =-1 \\\\ {y}^{2} & =-25\\end{aligned}\n$$\n\nWe cannot take the square root of a negative number. Therefore, the equation has no real solutions. So, there are no $y$-intercepts."}] [{:db/id #edb/ref 17592186506536 :knowledge-point/_questions [{:db/id #edb/ref 17592186087835 :knowledge-point/id #uuid "2de185a6-24a0-55aa-905d-8893a555e331" :knowledge-point/title "Finding the X-Intercepts of a Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "872ca58d-51f5-5476-bd9b-c65086ba14e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186506146}] :answer-field/correct {:answer/id #uuid "872ca58d-51f5-5476-bd9b-c65086ba14e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186506146} :answer-field/id #uuid "1fcf8298-71f1-5277-a670-52f4b959a58d" :answer-field/key "field-1"