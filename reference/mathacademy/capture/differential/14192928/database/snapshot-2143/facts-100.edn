75 #edb/ref 17592186346324 #edb/ref 17592186045417] [17592186348022 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186348022 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186348022 #edb/ref 1078 #edb/ref 17592186345369 #edb/ref 17592186045417] [17592186348022 #edb/ref 1079 #uuid "ebdacf6a-0495-5e9a-8dad-4bfebbc2c674" #edb/ref 17592186045417] [17592186348326 #edb/ref 1068 #edb/ref 17592186348022 #edb/ref 17592186045417] [17592186348326 #edb/ref 1069 "q-8008" #edb/ref 17592186045417] [17592186348326 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186348326 #edb/ref 1071 "Calculate the points where the hyperbola \n$\\frac{{x}^{2}}{6}-\\frac{{y}^{2}}{2}=1$\nintersects the line $y=1.$" #edb/ref 17592186045417] [17592186348326 #edb/ref 1072 #uuid "da37c5c2-1cf7-558e-986b-281da0d2eca6" #edb/ref 17592186045417] [17592186348326 #edb/ref 1074 "To find the points where the hyperbola intersects the line $y=1,$ we substitute $y=1$ into the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{6}-\\frac{{y}^{2}}{2} & =1 \\\\ \\frac{{x}^{2}}{6}-\\frac{(1)^{2}}{2} & =1 \\\\ \\frac{{x}^{2}}{6}-\\frac{1}{2} & =1 \\\\ \\frac{{x}^{2}}{6} & =\\frac{3}{2} \\\\ {x}^{2} & =9 \\\\ x & =\\pm 3\\end{aligned}\n$$\n\nTherefore, the hyperbola intersects the horizontal line $y=1$ at the points $(\\pm 3,1).$" #edb/ref 17592186045417] [17592186348329 #edb/ref 1068 #edb/ref 17592186347716 #edb/ref 17592186045417] [17592186348329 #edb/ref 1069 "q-8011" #edb/ref 17592186045417] [17592186348329 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186348329 #edb/ref 1071 "Calculate the points where the hyperbola \n$25{x}^{2}-{y}^{2}=26$\nintersects the line $x=1.$" #edb/ref 17592186045417] [17592186348329 #edb/ref 1072 #uuid "5288b026-c904-5dff-a79f-36c3720bde84" #edb/ref 17592186045417] [17592186348329 #edb/ref 1074 "To find the points where the hyperbola intersects the line $x=1,$ we substitute $x=1$ into the equation of the hyperbola and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}25{x}^{2}-{y}^{2} & =26 \\\\ 25(1)^{2}-{y}^{2} & =26 \\\\ -{y}^{2} & =26-25 \\\\ -{y}^{2} & =1 \\\\ {y}^{2} & =-1\\end{aligned}\n$$\n\nWe cannot take the square root of a negative number. Therefore, the equation has no real solutions. \nSo, the hyperbola does not intersect the vertical line $x=1.$" #edb/ref 17592186045417] [17592186351586 #edb/ref 1080 "There are no $x$-intercepts" #edb/ref 17592186045417] [17592186351586 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186351586 #edb/ref 1083 #uuid "0261d69a-d0b1-5b42-a14c-72a8e3ef4636" #edb/ref 17592186045417] [17592186352082 #edb/ref 1080 "(\\pm 3,0)" #edb/ref 17592186045417] [17592186352082 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186352082 #edb/ref 1083 #uuid "3743079e-514f-55fc-a216-d53dd2934fa9" #edb/ref 17592186045417] [17592186352434 #edb/ref 1080 "(-2,0)" #edb/ref 17592186045417] [17592186352434 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186352434 #edb/ref 1083 #uuid "61514553-2988-55db-833d-8c08bbe7e57f" #edb/ref 17592186045417] [17592186353174 #edb/ref 1080 "(\\pm 2,0)" #edb/ref 17592186045417] [17592186353174 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186353174 #edb/ref 1083 #uuid "bca4c387-c08a-5ba3-9323-ea7b3ec29bbc" #edb/ref 17592186045417] [17592186353650 #edb/ref 1080 "(3,0)" #edb/ref 17592186045417] [17592186353650 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186353650 #edb/ref 1083 #uuid "ef297abd-a599-5f50-810f-1054aeb7923a" #edb/ref 17592186045417] [17592186354030 #edb/ref 1075 #edb/ref 17592186351586 #edb/ref 17592186045417] [17592186354030 #edb/ref 1075 #edb/ref 17592186352082 #edb/ref 17592186045417] [17592186354030 #edb/ref 1075 #edb/ref 17592186352434 #edb/ref 17592186045417] [17592186354030 #edb/ref 1075 #edb/ref 17592186353174 #edb/ref 17592186045417] [17592186354030 #edb/ref 1075 #edb/ref 17592186353650 #edb/ref 17592186045417] [17592186354030 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186354030 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186354030 #edb/ref 1078 #edb/ref 17592186352434 #edb/ref 17592186045417] [17592186354030 #edb/ref 1079 #uuid "7276433c-4ede-5bac-8495-aa87bf4de9ab" #edb/ref 17592186045417] [17592186354281 #edb/ref 1068 #edb/ref 17592186354030 #edb/ref 17592186045417] [17592186354281 #edb/ref 1069 "q-84035" #edb/ref 17592186045417] [17592186354281 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186354281 #edb/ref 1071 "Calculate the $x$-intercepts of the hyperbola $\\frac{(y-2)^{2}}{4}-\\frac{(x+2)^{2}}{9}=1.$" #edb/ref 17592186045417] [17592186354281 #edb/ref 1072 #uuid "d3887d86-f3f7-5655-a347-83374fa0d7ec" #edb/ref 17592186045417] [17592186354281 #edb/ref 1074 "To find the $x$-intercepts of the hyperbola, we substitute $y=0$ into the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}\\frac{(y-2)^{2}}{4}-\\frac{(x+2)^{2}}{9} & =1 \\\\ \\frac{(0-2)^{2}}{4}-\\frac{(x+2)^{2}}{9} & =1 \\\\ 1-\\frac{(x+2)^{2}}{9} & =1 \\\\ \\frac{(x+2)^{2}}{9} & =0 \\\\ (x+2)^{2} & =0 \\\\ x+2 & =0 \\\\ x & =-2\\end{aligned}\n$$\n\nTherefore, the $x$-intercept is $(-2,0).$" #edb/ref 17592186045417] [17592186372363 #edb/ref 1068 #edb/ref 17592186372364 #edb/ref 17592186045417] [17592186372363 #edb/ref 1069 "q-170554" #edb/ref 17592186045417] [17592186372363 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186372363 #edb/ref 1071 "Calculate the $y$-intercepts of the hyperbola $\\frac{{x}^{2}}{16}-\\frac{{y}^{2}}{25}=1.$" #edb/ref 17592186045417] [17592186372363 #edb/ref 1072 #uuid "cb98a0f4-3a47-5a3f-8676-25371977fac8" #edb/ref 17592186045417] [17592186372363 #edb/ref 1074 "To find the $y$-intercepts of the hyperbola, we substitute $x=0$ into the equation of the hyperbola and solve for $y,$ as follows:\n\n$$\n\\begin{aligned