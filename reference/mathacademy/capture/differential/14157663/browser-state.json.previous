      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14157663/observations/step-q41036-b066db249e8712ebc59f.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14157663/observations/step-q41036-b066db249e8712ebc59f.png",
      "source_url": "https://mathacademy.com/tasks/14157663/topics/2127/lesson",
      "captured_at": 1791864786.1417034,
      "math_academy_id": "q-41036",
