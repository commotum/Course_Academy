}^{2}+{3}^{2}}{v}_{1} \\\\  & =[\\begin{aligned}5 \\\\ 5 \\\\ 4\\end{aligned}]-\\frac{1}{2}[\\begin{aligned}-2 \\\\ 1 \\\\ 3\\end{aligned}] \\\\  & =[\\begin{aligned}6 \\\\ \\frac{9}{2} \\\\ \\frac{5}{2}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, $B=\\{{v}_{1},{v}_{2}\\}=\\{[\\begin{aligned}-2 \\\\ 1 \\\\ 3\\end{aligned}],[\\begin{aligned}6 \\\\ \\frac{9}{2} \\\\ \\frac{5}{2}\\end{aligned}]\\}$ is an orthogonal basis for $\\text{Col}(A).$\n\nFinally, $a=6,$ $b=\\frac{9}{2},$ and  \n\n$$\n\\frac{a}{b}=\\frac{(6)}{(\\frac{9}{2})}=\\frac{4}{3}.\n$$"}] [{:db/id #edb/ref 17592186351265 :knowledge-point/_questions [{:db/id #edb/ref 17592186133795 :knowledge-point/id #uuid "ccdefb8e-1bb5-52e9-812d-d2a5bffff731" :knowledge-point/title "Finding an Orthonormal Basis of a Vector Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37f0253b-1dab-5d9b-aaa4-a0f6e33907b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11\\sqrt{41}}{41}" :db/id #edb/ref 17592186348953} {:answer/id #uuid "7da4cb52-1ecd-56c5-b36e-4a4b8b357eb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4\\sqrt{41}}{41}" :db/id #edb/ref 17592186349597} {:answer/id #uuid "c58cf034-d19c-5859-ab44-e2c5de7c5c67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7\\sqrt{41}}{41}" :db/id #edb/ref 17592186350190} {:answer/id #uuid "d1d4c644-3f20-550e-88cf-339c436ad7b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13\\sqrt{41}}{41}" :db/id #edb/ref 17592186350289} {:answer/id #uuid "e1b9fcf1-cbdc-56f8-acf3-51e37fcfb3ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{41}}{41}" :db/id #edb/ref 17592186350432}] :answer-field/correct {:answer/id #uuid "37f0253b-1dab-5d9b-aaa4-a0f6e33907b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11\\sqrt{41}}{41}" :db/id #edb/ref 17592186348953} :answer-field/id #uuid "988f703f-a2a5-5ea3-a946-97f106e096b2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350968}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7227055f-a157-5b07-9750-9fc3718cf77c" :question/math-academy-id "q-81216" :question/problem "$$\nV=\\text{Span}\\{[\\begin{aligned}4 \\\\ 0 \\\\ 3\\end{aligned}],[\\begin{aligned}5 \\\\ -4 \\\\ 10\\end{aligned}]\\},\\,B=\\{[\\begin{aligned}\\frac{4}{5} \\\\ 0 \\\\ \\frac{3}{5}\\end{aligned}],[\\begin{aligned}a \\\\ b \\\\ c\\end{aligned}]\\}\n$$\n\nConsider the subspace $V$ and an **orthonormal** basis $B$ of $V,$ given above. Given that $B$ is derived from $V$ using the Gram-Schmidt process, what is the value of $|a|+|b|+|c|?$" :question/worked-solution "First, let's denote\n\n$\\,$ ${a}_{1}=[\\begin{aligned}4 \\\\ 0 \\\\ 3\\end{aligned}]\\,$ and $\\,{a}_{2}=[\\begin{aligned}5 \\\\ -4 \\\\ 10\\end{aligned}].$ \n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=[\\begin{aligned}4 \\\\ 0 \\\\ 3\\end{aligned}].$\n\n**Step 2**: Next, we find ${v}_{2}$, by using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{5\\cdot 4+(-4)\\cdot 0+10\\cdot 3}{{4}^{2}+{0}^{2}+{3}^{2}}{v}_{1} \\\\  & =[\\begin{aligned}5 \\\\ -4 \\\\ 10\\end{aligned}]-2[\\begin{aligned}4 \\\\ 0 \\\\ 3\\end{aligned}] \\\\  & =[\\begin{aligned}-3 \\\\ -4 \\\\ 4\\end{aligned}].\\end{aligned}\n$$\n\nNow, we normalize each vector to get an orthonormal basis:\n\n- ${u}_{1}=\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{{4}^{2}+{0}^{2}+{3}^{2}}}[\\begin{aligned}4 \\\\ 0 \\\\ 3\\end{aligned}]=[\\begin{aligned}\\frac{4}{5} \\\\ 0 \\\\ \\frac{3}{5}\\end{aligned}].$\n\n- ${u}_{2}=\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{(-3)^{2}+(-4)^{2}+{4}^{2}}}[\\begin{aligned}-3 \\\\ -4 \\\\ 4\\end{aligned}]=[\\begin{aligned}-\\frac{3\\sqrt{41}}{41} \\\\ -\\frac{4\\sqrt{41}}{41} \\\\ \\frac{4\\sqrt{41}}{41}\\end{aligned}].$\n\nTherefore, $B=\\{{u}_{1},{u}_{2}\\}=\\{[\\begin{aligned}\\frac{4}{5} \\\\ 0 \\\\ \\frac{3}{5}\\end{aligned}],[\\begin{aligned}-\\frac{3\\sqrt{41}}{41} \\\\ -\\frac{4\\sqrt{41}}{41} \\\\ \\frac{4\\sqrt{41}}{41}\\end{aligned}]\\}$ is an orthonormal basis of $V.$\n\nFinally, $a=-\\frac{3\\sqrt{41}}{41},$ $b=-\\frac{4\\sqrt{41}}{41},$ $c=\\frac{4\\sqrt{41}}{41}$ and  \n\n$$\n|a|+|b|+|c|=|-\\frac{3\\sqrt{41}}{41}|+|-\\frac{4\\sqrt{41}}{41}|+|\\frac{4\\sqrt{41}}{41}|=\\frac{11\\sqrt{41}}{41}.\n$$"}] [{:db/id #edb/ref 17592186366386 :knowledge-point/_questions [{:db/id #edb/ref 17592186133795 :knowledge-point/id #uuid "ccdefb8e-1bb5-52e9-812d-d2a5bffff731" :knowledge-point/title "Finding an Orthonormal Basis of a Vector Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12e68ae2-6f20-5f22-9e11-7854555f74fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4\\sqrt{11}}{11}" :db/id #edb/ref 17592186366388} {:answer/id #uuid "c1a11db1-bae2-52e7-811d-20ef1fad8346" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{11}}{11}" :db/id #edb/ref 17592186366389} {:answer/id #uuid "de669c8e-e811-5a2b-9b66-1c36f490d3b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{11}}{11}" :db/id #edb/ref 17592186366390} {:answer/id #uuid "c1d4b876-b26a-5733-a2f4-643f5becd337" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{11}}{11}" :db/id #edb/ref 17592186366391} {:answer/id #uuid "d1b24c44-7f6c-58d5-9683-7ddab49f66ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{11}}{11}" :db/id #edb/ref 17592186366392}] :answer-field/correct {:answer/id #uuid "c1d4b876-b26a-5733-a2f4-643f5becd337" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{11}}{11}" :db/id #edb/ref 17592186366391} :answer-field/id #uuid "80455565-0f85-5273-bf0d-80a5895b80d9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366387}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "53c1ecb7-2754-5e47-8ad1-b58baa6eef4e" :question/math-academy-id "q-81217" :question/problem "$$\nV=\\text{Span}\\{[\\begin{aligned}-4 \\\\ 1 \\\\ 1\\end{aligned}],[\\begin{aligned}-3 \\\\ 2 \\\\ 4\\end{aligned}]\\},\\,B=\\{[\\begin{aligned}-\\frac{2\\sqrt{2}}{3} \\\\ \\frac{\\sqrt{2}}{6} \\\\ \\frac{\\sqrt{2}}{6}\\end{aligned}],[\\begin{aligned}a \\\\ b \\\\ c\\end{aligned}]\\}\n$$\n\nConsider the subspace $V$ and an **orthonormal** basis $B$ of $V,$ given above. Given that $B$ is derived from $V$ using the Gram-Schmidt process, what is the value of $|a|+|b|+|c|?$" :question/worked-solution "First, let's denote\n\n$\\,$ ${a}_{1}=[\\begin{aligned}-4 \\\\ 1 \\\\ 1\\end{aligned}]\\,$ and $\\,{a}_{2}=[\\begin{aligned}-3 \\\\ 2 \\\\ 4\\end{aligned}].$ \n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=[\\begin{aligned}-4 \\\\ 1 \\\\ 1\\end{aligned}].$\n\n**Step 2**: Next, we find ${v}_{2}$, by using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{(-3)\\cdot (-4)+2\\cdot 1+4\\cdot 1}{(-4)^{2}+{1}^{2}+{1}^{2}}{v}_{1} \\\\  & =[\\begin{aligned}-3 \\\\ 2 \\\\ 4\\end{aligned}]-[\\begin{aligned}-4 \\\\ 1 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 1 \\\\ 3\\end{aligned}].\\end{aligned}\n$$\n\nNow, we normalize each vector to get an orthonormal basis:\n\n- ${u}_{1}=\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{(-4)^{2}+{1}^{2}+{1}^{2}}}[\\begin{aligned}-4 \\\\ 1 \\\\ 1\\end{aligned}]=[\\begin{aligned}-\\frac{2\\sqrt{2}}{3} \\\\ \\frac{\\sqrt{2}}{6} \\\\ \\frac{\\sqrt{2}}{6}\\end{aligned}].$\n\n- ${u}_{2}=\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{{1}^{2}+{1}^{2}+{3}^{2}}}[\\begin{aligned}1 \\\\ 1 \\\\ 3\\end{aligned}]=[\\begin{aligned}\\frac{\\sqrt{11}}{11} \\\\ \\frac{\\sqrt{11}}{11} \\\\ \\frac{3\\sqrt{11}}{11}\\end{aligned}].$\n\nTherefore, $B=\\{{u}_{1},{u}_{2}\\}=\\{[\\begin{aligned}\\frac{-2\\sqrt{2}}{3} \\\\ \\frac{\\sqrt{2}}{6} \\\\ \\frac{\\sqrt{2}}{6}\\end{aligned}],[\\begin{aligned}\\frac{\\sqrt{11}}{11} \\\\ \\frac{\\sqrt{11}}{11} \\\\ \\frac{3\\sqrt{11}}{11}\\end{aligned}]\\}$ is an orthonormal basis of $V.$\n\nFinally, $a=\\frac{\\sqrt{11}}{11},$ $b=\\frac{\\sqrt{11}}{11},$ $c=\\frac{3\\sqrt{11}}{11}$ and  \n\n$$\n|a|+|b|+|c|=|\\frac{\\sqrt{11}}{11}|+|\\frac{\\sqrt{11}}{11}|+|\\frac{3\\sqrt{11}}{11}|=\\frac{5\\sqrt{11}}{11}.\n$$"}] [{:db/id #edb/ref 17592186481363 :knowledge-point/_questions [{:db/id #edb/ref 17592186133793 :knowledge-point/id #uuid "16e43d27-ffaf-58ea-bb6e-664b70770003" :knowledge-point/title "Finding an Orthogonal Basis For the Span of Two Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16f8819e-1e45-5b70-843f-9474e62016e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186480782} {:answer/id #uuid "2dcb854a-8359-5e93-87cf-89bffc23af38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186480823} {:answer/id #uuid "30e0bd06-5ba4-5322-8aaa-c8efbd6bb22c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186480832} {:answer/id #uuid "54604561-d490-5cf0-8396-166d4506693f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186480890} {:answer/id #uuid "8567ab33-79b0-5c93-ab46-2e6895393cb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186480994}] :answer-field/correct {:answer/id #uuid "16f8819e-1e45-5b70-843f-9474e62016e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186480782} :answer-field/id #uuid "f1c3af90-4b4e-5817-986c-ad8b162022f4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186481335}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4b9728bb-13e5-5813-917f-2ed0c37ac7bc" :question/math-academy-id "q-86847" :question/problem "$$\nV=\\text{Span}\\{[\\begin{aligned}-3 \\\\ 1 \\\\ 2\\end{aligned}],[\\begin{aligned}-1 \\\\ 0 \\\\ 2\\end{aligned}]\\},\\,B=\\{[\\begin{aligned}-3 \\\\ 1 \\\\ 2\\end{aligned}],[\\begin{aligned}a \\\\ b \\\\ c\\end{aligned}]\\}\n$$\n\nConsider the subspace $V$ and an orthogonal basis $B$ of $V,$ given above. Given that $B$ is derived from $V$ using the Gram-Schmidt process, what is the value of $\\frac{c}{a}?$" :question/worked-solution "First, let's denote \n\n$\\,$ ${a}_{1}=[\\begin{aligned}-3 \\\\ 1 \\\\ 2\\end{aligned}]\\,$ and $\\,{a}_{2}=[\\begin{aligned}-1 \\\\ 0 \\\\ 2\\end{aligned}].$ \n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=[\\begin{aligned}-3 \\\\ 1 \\\\ 2\\end{aligned}].$\n\n**Step 2**: Next, we find ${v}_{2}$, by using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{(-1)\\cdot (-3)+0\\cdot 1+2\\cdot 2}{(-3)^{2}+{1}^{2}+{2}^{2}}{v}_{1} \\\\  & =[\\begin{aligned}-1 \\\\ 0 \\\\ 2\\end{aligned}]-\\frac{1}{2}[\\begin{aligned}-3 \\\\ 1 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{2} \\\\ -\\frac{1}{2} \\\\ 1\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, $B=\\{{v}_{1},{v}_{2}\\}=\\{[\\begin{aligned}-3 \\\\ 1 \\\\ 2\\end{aligned}],[\\begin{aligned}\\frac{1}{2} \\\\ -\\frac{1}{2} \\\\ 1\\end{aligned}]\\}$ is an orthogonal basis for $V.$\n\nFinally, we have $a=\\frac{1}{2},$ $c=1,$ and \n\n$$\n\\frac{c}{a}=\\frac{1}{(\\frac{1}{2})}=2.\n$$"}] [{:db/id #edb/ref 17592186354525 :knowledge-point/_questions [{:db/id #edb/ref 17592186133794 :knowledge-point/id #uuid "b15719b6-0ce4-5fb8-80be-abcaf9344a10" :knowledge-point/title "Finding an Orthogonal Basis For the Column Space of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ed1f367-805e-51b8-972f-815787ea47d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{13}{3}" :db/id #edb/ref 17592186351997} {:answer/id #uuid "a5ac3605-0fd4-5df6-9853-a92d4a898200" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-13" :db/id #edb/ref 17592186352978} {:answer/id #uuid "effea68f-2892-53fe-93d5-5e13785f636d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{13}" :db/id #edb/ref 17592186353656} {:answer/id #uuid "f0448b58-c033-592d-91f7-d47664767da5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{3}" :db/id #edb/ref 17592186353659} {:answer/id #uuid "f738d98b-cf0e-56d9-9087-d61d035edfb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{13}" :db/id #edb/ref 17592186353721}] :answer-field/correct {:answer/id #uuid "effea68f-2892-53fe-93d5-5e13785f636d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{13}" :db/id #edb/ref 17592186353656} :answer-field/id #uuid "7bd98553-e82e-5a0f-8a7a-ad85bb9bcc48" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354044}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "32ca7514-6be2-5643-9bb9-256990a44ecc" :question/math-academy-id "q-86850" :question/problem "$$\nA=[\\begin{aligned}\\sqrt{2} & 0 \\\\ 1 & -5 \\\\ -3 & 1\\end{aligned}],\\,B=\\{[\\begin{aligned}\\sqrt{2} \\\\ 1 \\\\ -3\\end{aligned}],[\\begin{aligned}a \\\\ b \\\\ c\\end{aligned}]\\}\n$$\n\nConsider the subspace $\\text{Col}(A)$ and an orthogonal basis $B$ of $\\text{Col}(A),$ where $A$ and $B$ are given above. Given that $B$ is derived from $\\text{Col}(A)$ using the Gram-Schmidt process, what is the value of $\\frac{c}{b}?$" :question/worked-solution "Recall that $\\text{Col}(A)$ is the span of the columns of $A.$ \n\nFirst, let's denote\n\n$\\,$ ${a}_{1}=[\\begin{aligned}\\sqrt{2} \\\\ 1 \\\\ -3\\end{aligned}]\\,$ and $\\,{a}_{2}=[\\begin{aligned}0 \\\\ -5 \\\\ 1\\end{aligned}].$ \n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=[\\begin{aligned}\\sqrt{2} \\\\ 1 \\\\ -3\\end{aligned}].$\n\n**Step 2**: Next, we find ${v}_{2}$, by using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{0\\cdot \\sqrt{2}+(-5)\\cdot 1+1\\cdot (-3)}{(\\sqrt{2})^{2}+{1}^{2}+(-3)^{2}}{v}_{1} \\\\  & =[\\begin{aligned}0 \\\\ -5 \\\\ 1\\end{aligned}]+\\frac{2}{3}[\\begin{aligned}\\sqrt{2} \\\\ 1 \\\\ -3\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{2\\sqrt{2}}{3} \\\\ -\\frac{13}{3} \\\\ -1\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, $B=\\{{v}_{1},{v}_{2}\\}=\\{[\\begin{aligned}\\sqrt{2} \\\\ 1 \\\\ -3\\end{aligned}],[\\begin{aligned}\\frac{2\\sqrt{2}}{3} \\\\ -\\frac{13}{3} \\\\ -1\\end{aligned}]\\}$ is an orthogonal basis for $\\text{Col}(A).$\n\nFinally, $b=-\\frac{13}{3},$ $c=-1,$ and  \n\n$$\n\\frac{c}{b}=\\frac{-1}{(-\\frac{13}{3})}=\\frac{3}{13}.\n$$"}] [{:db/id #edb/ref 17592186481433 :knowledge-point/_questions [{:db/id #edb/ref 17592186133795 :knowledge-point/id #uuid "ccdefb8e-1bb5-52e9-812d-d2a5bffff731" :knowledge-point/title "Finding an Orthonormal Basis of a Vector Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7f1f7ef1-8ffa-5d79-89f5-0f699ae92a81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{46}}{23}" :db/id #edb/ref 17592186480979} {:answer/id #uuid "85a5f849-bfe1-54f4-a472-2f3b1a9f7def" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{46}}{46}" :db/id #edb/ref 17592186480996} {:answer/id #uuid "a891591d-a9eb-53fe-8982-96c9b063fffc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{46}}{23}" :db/id #edb/ref 17592186481058} {:answer/id #uuid "b8569b62-9dc0-5a84-afdd-7c7913cb7cbd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{46}}{46}" :db/id #edb/ref 17592186481091} {:answer/id #uuid "c2214cfa-1da7-5079-9e10-7f06971759ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10\\sqrt{46}}{23}" :db/id #edb/ref 17592186481110}] :answer-field/correct {:answer/id #uuid "a891591d-a9eb-53fe-8982-96c9b063fffc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{46}}{23}" :db/id #edb/ref 17592186481058} :answer-field/id #uuid "7d04279b-ec75-5254-bd55-34cd8f8839e1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186481281}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ed119e3d-d405-5ea0-ae9c-40defc91b776" :question/math-academy-id "q-86852" :question/problem "$$\nV=\\text{Span}\\{[\\begin{aligned}-1 \\\\ 1 \\\\ 3\\end{aligned}],[\\begin{aligned}2 \\\\ 7 \\\\ 2\\end{aligned}]\\},\\,B=\\{[\\begin{aligned}-\\frac{\\sqrt{11}}{11} \\\\ \\frac{\\sqrt{11}}{11} \\\\ \\frac{3\\sqrt{11}}{11}\\end{aligned}],[\\begin{aligned}a \\\\ b \\\\ c\\end{aligned}]\\}\n$$\n\nConsider the subspace $V$ and an **orthonormal** basis $B$ of $V,$ given above. Given that $B$ is derived from $V$ using the Gram-Schmidt process, what is the value of $|a|+|b|+|c|?$" :question/worked-solution "First, let's denote\n\n$\\,$ ${a}_{1}=[\\begin{aligned}-1 \\\\ 1 \\\\ 3\\end{aligned}]\\,$ and $\\,{a}_{2}=[\\begin{aligned}2 \\\\ 7 \\\\ 2\\end{aligned}].$ \n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=[\\begin{aligned}-1 \\\\ 1 \\\\ 3\\end{aligned}].$\n\n**Step 2**: Next, we find ${v}_{2}$, by using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{2\\cdot (-1)+7\\cdot 1+2\\cdot 3}{(-1)^{2}+{1}^{2}+{3}^{2}}{v}_{1} \\\\  & =[\\begin{aligned}2 \\\\ 7 \\\\ 2\\end{aligned}]-[\\begin{aligned}-1 \\\\ 1 \\\\ 3\\end{aligned}] \\\\  & =[\\begin{aligned}3 \\\\ 6 \\\\ -1\\end{aligned}].\\end{aligned}\n$$\n\nNow, we normalize each vector to get an orthonormal basis:\n\n- ${u}_{1}=\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{(-1)^{2}+{1}^{2}+{3}^{2}}}[\\begin{aligned}-1 \\\\ 1 \\\\ 3\\end{aligned}]=[\\begin{aligned}\\frac{-\\sqrt{11}}{11} \\\\ \\frac{\\sqrt{11}}{11} \\\\ \\frac{3\\sqrt{11}}{11}\\end{aligned}].$\n\n- ${u}_{2}=\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{{3}^{2}+{6}^{2}+(-1)^{2}}}[\\begin{aligned}3 \\\\ 6 \\\\ -1\\end{aligned}]=[\\begin{aligned}\\frac{3\\sqrt{46}}{46} \\\\ \\frac{3\\sqrt{46}}{23} \\\\ -\\frac{\\sqrt{46}}{46}\\end{aligned}].$\n\nTherefore, $B=\\{{u}_{1},{u}_{2}\\}=\\{[\\begin{aligned}\\frac{-\\sqrt{11}}{11} \\\\ \\frac{\\sqrt{11}}{11} \\\\ \\frac{3\\sqrt{11}}{11}\\end{aligned}],[\\begin{aligned}\\frac{3\\sqrt{46}}{46} \\\\ \\frac{3\\sqrt{46}}{23} \\\\ -\\frac{\\sqrt{46}}{46}\\end{aligned}]\\}$ is an orthonormal basis of $V.$\n\nFinally, $a=\\frac{3\\sqrt{46}}{46},$ $b=\\frac{3\\sqrt{46}}{23},$ $c=-\\frac{\\sqrt{46}}{46}$ and  \n\n$$\n|a|+|b|+|c|=|\\frac{3\\sqrt{46}}{46}|+|\\frac{3\\sqrt{46}}{23}|+|-\\frac{\\sqrt{46}}{46}|=\\frac{5\\sqrt{46}}{23}.\n$$"}]}
