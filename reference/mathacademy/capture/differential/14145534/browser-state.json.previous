      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14145534/observations/step-q181602-736173f2ff7e18838835.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14145534/observations/step-q181602-736173f2ff7e18838835.png",
      "source_url": "https://mathacademy.com/tasks/14145534/topics/4392/review",
      "captured_at": 1791828300.5365129,
      "math_academy_id": "q-181602",
