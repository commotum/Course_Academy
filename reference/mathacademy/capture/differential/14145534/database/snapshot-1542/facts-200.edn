99b-5f38-9497-09ddea8e7e4d" #edb/ref 17592186045417] [17592186287656 #edb/ref 1075 #edb/ref 17592186285522 #edb/ref 17592186045417] [17592186287656 #edb/ref 1075 #edb/ref 17592186285888 #edb/ref 17592186045417] [17592186287656 #edb/ref 1075 #edb/ref 17592186286124 #edb/ref 17592186045417] [17592186287656 #edb/ref 1075 #edb/ref 17592186287102 #edb/ref 17592186045417] [17592186287656 #edb/ref 1075 #edb/ref 17592186287126 #edb/ref 17592186045417] [17592186287656 #edb/ref 1076 #edb/ref 17592186045494 #edb/ref 17592186045417] [17592186287656 #edb/ref 1077 "field-2" #edb/ref 17592186045417] [17592186287656 #edb/ref 1078 #edb/ref 17592186286124 #edb/ref 17592186045417] [17592186287656 #edb/ref 1079 #uuid "fb288b6a-0ce0-5325-bbb2-0ee9ec1811d7" #edb/ref 17592186045417] [17592186287727 #edb/ref 1068 #edb/ref 17592186287153 #edb/ref 17592186045417] [17592186287727 #edb/ref 1068 #edb/ref 17592186287396 #edb/ref 17592186045417] [17592186287727 #edb/ref 1069 "q-181691" #edb/ref 17592186045417] [17592186287727 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186287727 #edb/ref 1071 "![](images/6a/6affe267a93d1dab16de3dc153fddbdb165bab831790f7387dcbd29354ebb63a.png)\n\nUse set builder notation to describe the shaded region given in the diagram above:\n\n$$\n{(x,y)\\in {{field-1}}\\,:\\,y\\,{{field-2}}\\,-\\frac{1}{2}{x}^{2}}\n$$" #edb/ref 17592186045417] [17592186287727 #edb/ref 1072 #uuid "e71b9628-b280-5047-9c68-527f1ea3edca" #edb/ref 17592186045417] [17592186287727 #edb/ref 1074 "The points in our set include all those that lie *below* the curve $y=-\\frac{1}{2}{x}^{2}.$\n\nTherefore, a point $P(x,y)$ lies *inside* the shaded region if the following condition is satisfied:\n\n$$\ny<-\\frac{1}{2}{x}^{2}\n$$\n\nSince the boundary is not included in the set (the curve is dashed), the inequality is strict.\n\nMoreover, since we're considering *every* real value in this region, $x\\in R,y\\in R,$ and therefore \n\n$$\n(x,y)\\in R\\times R={R}^{2}.\n$$\n\nTherefore, we can write the set as\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,y<-\\frac{1}{2}{x}^{2}}.\n$$" #edb/ref 17592186045417] [17592186287729 #edb/ref 1068 #edb/ref 17592186287190 #edb/ref 17592186045417] [17592186287729 #edb/ref 1068 #edb/ref 17592186287553 #edb/ref 17592186045417] [17592186287729 #edb/ref 1068 #edb/ref 17592186287562 #edb/ref 17592186045417] [17592186287729 #edb/ref 1069 "q-181694" #edb/ref 17592186045417] [17592186287729 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186287729 #edb/ref 1071 "![](images/c6/c670ed592fc32716596aae470911923627d1c6861a75a1c885659d09005e0a84.png)\n\nUse set builder notation to describe the shaded region given in the diagram above:\n\n${(x,y)\\in {R}^{2}\\,:\\,$\n{{field-1}}\n${x}^{2}\\,+\\,$\n{{field-2}}\n${y}^{2}$\n{{field-3}}\n\n$36$\n\n$}$" #edb/ref 17592186045417] [17592186287729 #edb/ref 1072 #uuid "1cd9f8d0-368b-57f9-99c0-0235eafbffc0" #edb/ref 17592186045417] [17592186287729 #edb/ref 1074 "The equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the elliptical boundary of our region has horizontal radius $a=2$ and vertical radius $b=3.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{9} & =1,\\end{aligned}\n$$\n\nwhich we can write as\n\n$$\n9{x}^{2}+4{y}^{2}=36.\n$$\n\nWe're interested in describing all points that lie *inside* the ellipse. So, let's pick any point inside the region, say, $(0,0).$ Substituting its coordinates into the equation of the boundary, we obtain\n\n$$\n9(0)^{2}+4(0)^{2}\\,<\\,36.\n$$\n\nAs a result, the points $P(x,y)$ in our region are any real numbers that satisfy the condition\n\n$$\n9{x}^{2}+4{y}^{2}<36.\n$$\n\nWe must also include the curve $9{x}^{2}+4{y}^{2}=36$ since the boundary is included in the set (the curve is solid). So, we change the inequality symbol above as follows:\n\n$$\n9{x}^{2}+4{y}^{2}\\le 36.\n$$\n\nTherefore, we can write the set as\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,9{x}^{2}+4{y}^{2}\\le 36}.\n$$" #edb/ref 17592186045417] [17592186287779 #edb/ref 1068 #edb/ref 17592186287563 #edb/ref 17592186045417] [17592186287779 #edb/ref 1068 #edb/ref 17592186287586 #edb/ref 17592186045417] [17592186287779 #edb/ref 1069 "q-181970" #edb/ref 17592186045417] [17592186287779 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186287779 #edb/ref 1071 "![](images/01/010d4befaa2bd2142cf63010f79f071df331bb6394eb65e4f883752cb04a2cb4.png)\n\nDescribe the shaded region shown above using set-builder notation.\n\n$$\n{(x,y)\\in {{field-1}}\\,:\\,y\\,{{field-2}}\\,-x+1}\n$$" #edb/ref 17592186045417] [17592186287779 #edb/ref 1072 #uuid "adce9191-abcc-50fc-a56f-a2f330169645" #edb/ref 17592186045417] [17592186287779 #edb/ref 1074 "Since all points $P(x,y)$ in our set lie at integer values of $x$ and $y,$ we have $x\\in Z,y\\in Z,$ and therefore \n\n$$\n(x,y)\\in Z\\times Z={Z}^{2}.\n$$\n\nThe points in our set include all those that lie *above* the line $y=-x+1.$ For those points, the following condition is satisfied:\n\n$$\ny>-x+1\n$$\n\nAlso, notice that some points in our set lie *on* the line. We include these points by changing the inequality symbol above as follows:\n\n$$\ny\\ge -x+1\n$$\n\nTherefore, we can write the set as follows:\n\n$$\n{(x,y)\\in {Z}^{2}\\,:\\,y\\ge -x+1}\n$$" #edb/ref 17592186045417] [17592186374407 #edb/ref 1068 #edb/ref 17592186374408 #edb/ref 17592186045417] [17592186374407 #edb/ref 1068 #edb/ref 17592186374414 #edb/ref 17592186045417] [17592186374407 #edb/ref 1069 "q-181602" #edb/ref 17592186045417] [17592186374407 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186374407 #edb/ref 1071 "![](images/79/79df94546a6fafcd66f8733622e8e9d8c37d29c24cb99378eba141610a8fdc8a.png)\n\nDescribe the shaded region shown above using set-builder notation.\n\n$$\n{(x,y)\\in {{field-1}}\\,:\\,y\\,{{field-2}}\\,x-1}\n$$" #edb/ref 17592186045417] [17592186374407 #edb/ref 1072 #uuid "adb62f2e-918d-5d56-973b-da3bc299a8de" #edb/ref 17592186045417] [17592186374407 #edb/ref 1074 "Since all points $P(x,y)$ in our set lie at integer values of $x$ and $y,$ we have $x\\in Z,y\\in Z,$ and therefore \n\n$$\n(x,y)\\in Z\\times Z={Z}^{2}.\n$$\n\nThe points in our set include all those that lie *below* the line $y=x-1.$ For those points, the following condition is satisfied:\n\n$$\ny<x-1\n$$\n\nAlso, notice that some points in our set lie *on* the line. We include these points by changing the inequality symbol above as follows:\n\n$$\ny\\le x-1\n$$\n\nTherefore, we can write the set as follows:\n\n$$\n{(x,y)\\in {Z}^{2}\\,:\\,y\\le x-1}\n$$" #edb/ref 17592186045417] [17592186374408 #edb/ref 1075 #edb/ref 17592186374409 #edb/ref 17592186045417] [17592186374408 #edb/ref 1075 #edb/ref 17592186374410 #edb/ref 17592186045417] [17592186374408 #edb/ref 1075 #edb/ref 17592186374411 #edb/ref 17592186045417] [17592186374408 #edb/ref 1075 #edb/ref 17592186374412 #edb/ref 17592186045417] [17592186374408 #edb/ref 1075 #edb/ref 17592186374413 #edb/ref 17592186045417] [17592186374408 #edb/ref 1076 #edb/ref 17592186045494 #edb/ref 17592186045417] [17592186374408 #edb/ref 1077 "field-2" #edb/ref 17592186045417] [17592186374408 #edb/ref 1078 #edb/ref 17592186374411 #edb/ref 17592186045417] [17592186374408 #edb/ref 1079 #uuid "6b97a150-262f-5dd7-9bc4-87966d429ca7" #edb/ref 17592186045417] [17592186374409 #edb/ref 1080 ">" #edb/ref 17592186045417] [17592186374409 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186374409 #edb/ref 1083 #uuid "c7daca75-cb84-525d-be2f-9604ebcf32dd" #edb/ref 17592186045417] [17592186374410 #edb/ref 1080 "\\ne " #edb/ref 17592186045417] [17592186374410 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186374410 #edb/ref 1083 #uuid "7e791571-9546-5009-bc38-25e83877079d" #edb/ref 17592186045417] [17592186374411 #edb/ref 1