 17592186045498} :answer/value ">" :db/id #edb/ref 17592186383647} {:answer/id #uuid "6a012830-1859-5376-b78c-b5ce93fc2b6d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ne " :db/id #edb/ref 17592186383648} {:answer/id #uuid "d7ef4af6-694c-5da8-b4a7-045385e71bd0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\le " :db/id #edb/ref 17592186383649} {:answer/id #uuid "7c8c9e4b-6ad1-5568-8838-c14f8064fb2c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ge " :db/id #edb/ref 17592186383650} {:answer/id #uuid "318d1154-0e6f-5b9b-9567-fa06e0f161e0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "<" :db/id #edb/ref 17592186383651}] :answer-field/correct {:db/id #edb/ref 17592186383649} :answer-field/id #uuid "e1c14e5c-4f2d-5c9e-8b56-99780514402e" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186383646}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "dc6d9b64-fae9-5e89-abfa-9eb8e573a546" :question/math-academy-id "q-181683" :question/problem "![](images/e2/e2591e9da960008980cf96184975ef19713735814183a97ca8c8f784536fced5.png)\n\nDescribe the shaded region shown above using set-builder notation.\n\n$$\n\\{(x,y)\\in {{field-1}}\\,:\\,-x-3\\,{{field-2}}\\,y\\,{{field-3}}\\,x+4\\}\n$$" :question/worked-solution "The points in our set include all those that lie *above* the line $y=-x-3$ and *below* the line $y=x+4.$\n\nA point $P(x,y)$ lies *inside* the shaded region if the following conditions are satisfied:\n\n$$\ny>-x-3,\\,y<x+4.\n$$\n\n \n\nCombining this into a single condition, we have\n\n$$\n-x-3<y<x+4.\n$$\n\nWe must also include the lines $y=-x-3$ and $y=x+4$ since the boundaries are included in the set (the lines are solid). So, we change the corresponding inequality symbols above as follows:\n\n$$\n-x-3\\le y\\le x+4\n$$\n\nMoreover, since we're considering *every* real value in this region, $x\\in R,y\\in R,$ and therefore \n\n$$\n(x,y)\\in R\\times R={R}^{2}.\n$$\n\nTherefore, we can write the set as\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,-x-3\\le y\\le x+4\\}.\n$$"} :step/id #uuid "9354686a-acc6-5fa4-8bd7-5f500db8971a" :step/next {:db/id #edb/ref 17592186441155}} {:db/id #edb/ref 17592186441154 :step/content {:db/id #edb/ref 17592186287779 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2666c468-fc33-52d6-93bd-f0a88838de22" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "N" :db/id #edb/ref 17592186285124} {:answer/id #uuid "2f302289-5d3d-5452-ac1d-b0d0209c7eb2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{N}^{2}" :db/id #edb/ref 17592186285211} {:answer/id #uuid "ab7053c1-4e09-5eb1-aae0-531352d7433d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "R" :db/id #edb/ref 17592186286351} {:answer/id #uuid "b1a04b58-793e-5385-b844-aa6a268bc195" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}^{2}" :db/id #edb/ref 17592186286412} {:answer/id #uuid "cda16ec3-f60f-5e8b-9c7e-22dc379fb758" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "Z" :db/id #edb/ref 17592186286659} {:answer/id #uuid "f1cffe97-e550-512e-aef6-d7dec7520efe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{Z}^{2}" :db/id #edb/ref 17592186287008}] :answer-field/correct {:db/id #edb/ref 17592186287008} :answer-field/id #uuid "ca0914f5-bd5c-521e-bb5b-366f025a00b8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186287563} {:answer-field/choices [{:answer/id #uuid "921b11d4-9aa5-5e97-bd70-adda69224b3c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ge " :db/id #edb/ref 17592186286115} {:answer/id #uuid "a415e744-75b0-5e33-b9e0-218a15e914f6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "<" :db/id #edb/ref 17592186286291} {:answer/id #uuid "b8c8b26e-2480-5dfb-90cd-78218b99a523" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\le " :db/id #edb/ref 17592186286472} {:answer/id #uuid "cb4aea1f-ca2d-5d8f-ab12-687e454476e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ne " :db/id #edb/ref 17592186286642} {:answer/id #uuid "f3ee8853-59b1-5bf9-9ddf-f2b8e9267954" :answer/type {:db/id #edb/ref 17592186045498} :answer/value ">" :db/id #edb/ref 17592186287021}] :answer-field/correct {:db/id #edb/ref 17592186286115} :answer-field/id #uuid "d6b4acb6-bdd9-55f0-b57b-14458546f71d" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186287586}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "adce9191-abcc-50fc-a56f-a2f330169645" :question/math-academy-id "q-181970" :question/problem "![](images/01/010d4befaa2bd2142cf63010f79f071df331bb6394eb65e4f883752cb04a2cb4.png)\n\nDescribe the shaded region shown above using set-builder notation.\n\n$$\n\\{(x,y)\\in {{field-1}}\\,:\\,y\\,{{field-2}}\\,-x+1\\}\n$$" :question/worked-solution "Since all points $P(x,y)$ in our set lie at integer values of $x$ and $y,$ we have $x\\in Z,y\\in Z,$ and therefore \n\n$$\n(x,y)\\in Z\\times Z={Z}^{2}.\n$$\n\nThe points in our set include all those that lie *above* the line $y=-x+1.$ For those points, the following condition is satisfied:\n\n$$\ny>-x+1\n$$\n\nAlso, notice that some points in our set lie *on* the line. We include these points by changing the inequality symbol above as follows:\n\n$$\ny\\ge -x+1\n$$\n\nTherefore, we can write the set as follows:\n\n$$\n\\{(x,y)\\in {Z}^{2}\\,:\\,y\\ge -x+1\\}\n$$"} :step/id #uuid "99cbd0ca-b0f9-5db2-8595-6cf285bf96fb"} {:db/id #edb/ref 17592186441155 :step/content {:db/id #edb/ref 17592186287727 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00dd7aff-bfda-5343-80b2-b9d8a212688c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "<" :db/id #edb/ref 17592186284798} {:answer/id #uuid "40fe20cf-eb94-56ec-b101-6d9e772648d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\le " :db/id #edb/ref 17592186285393} {:answer/id #uuid "9a1dbdc7-e20c-51b5-a1af-b363f5f360ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value ">" :db/id #edb/ref 17592186286200} {:answer/id #uuid "9b86519b-9739-5214-b3eb-1c6713326737" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ne " :db/id #edb/ref 17592186286215} {:answer/id #uuid "ec094cca-380b-5c2d-8597-8376933da0c6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ge " :db/id #edb/ref 17592186286953}] :answer-field/correct {:db/id #edb/ref 17592186284798} :answer-field/id #uuid "053b43c3-dca6-5e97-8ea6-906172bd2e2e" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186287153} {:answer-field/choices [{:answer/id #uuid "1d98047c-fc8d-5044-9c7f-2dc676b7d6a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{Z}^{2}" :db/id #edb/ref 17592186285055} {:answer/id #uuid "2205f098-6512-5ee8-af24-e180e25ac21c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "Z" :db/id #edb/ref 17592186285092} {:answer/id #uuid "b1b9278c-2f3d-5280-9562-fa7aab619fab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "R" :db/id #edb/ref 17592186286414} {:answer/id #uuid "c2792ffe-1548-55d4-9064-609e1cbeee26" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}^{2}" :db/id #edb/ref 17592186286569}] :answer-field/correct {:db/id #edb/ref 17592186286569} :answer-field/id #uuid "753ed7a8-971a-54ec-9759-19387309d9ca" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186287396}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e71b9628-b280-5047-9c68-527f1ea3edca" :question/math-academy-id "q-181691" :question/problem "![](images/6a/6affe267a93d1dab16de3dc153fddbdb165bab831790f7387dcbd29354ebb63a.png)\n\nUse set builder notation to describe the shaded region given in the diagram above:\n\n$$\n\\{(x,y)\\in {{field-1}}\\,:\\,y\\,{{field-2}}\\,-\\frac{1}{2}{x}^{2}\\}\n$$" :question/worked-solution "The points in our set include all those that lie *below* the curve $y=-\\frac{1}{2}{x}^{2}.$\n\nTherefore, a point $P(x,y)$ lies *inside* the shaded region if the following condition is satisfied:\n\n$$\ny<-\\frac{1}{2}{x}^{2}\n$$\n\nSince the boundary is not included in the set (the curve is dashed), the inequality is strict.\n\nMoreover, since we're considering *every* real value in this region, $x\\in R,y\\in R,$ and therefore \n\n$$\n(x,y)\\in R\\times R={R}^{2}.\n$$\n\nTherefore, we can write the set as\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,y<-\\frac{1}{2}{x}^{2}\\}.\n$$"} :step/id #uuid "f5432599-bb88-543b-8395-a965094cbe30" :step/next {:db/id #edb/ref 17592186441156}} {:db/id #edb/ref 17592186441156 :step/content {:db/id #edb/ref 17592186287729 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cb0cc2b7-5028-5580-b791-3c2bb161871e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\le " :db/id #edb/ref 17592186286639} {:answer/id #uuid "54412ad1-cdc0-5927-bece-9ef714771a8b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\le" :db/id #edb/ref 17592186441151}] :answer-field/correct {:db/id #edb/ref 17592186441151} :answer-field/id #uuid "17bb627f-470f-5a44-992b-f5d2f8cb41f4" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186287190} {:answer-field/choices [{:answer/id #uuid "3e2dc877-a8aa-50eb-b8d7-a1ad98be87fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186285375}] :answer-field/correct {:db/id #edb/ref 17592186285375} :answer-field/id #uuid "c639d85f-7bcc-51d1-869b-a487ebe80531" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186287553} {:answer-field/choices [{:answer/id #uuid "0cb6eafb-1834-5b69-9bec-5c81fb2f0d6b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186284892}] :answer-field/correct {:db/id #edb/ref 17592186284892} :answer-field/id #uuid "c8c5f6c3-a99e-5ef2-8db4-e541bfa3f671" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186287562}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1cd9f8d0-368b-57f9-99c0-0235eafbffc0" :question/math-academy-id "q-181694" :question/problem "![](images/c6/c670ed592fc32716596aae470911923627d1c6861a75a1c885659d09005e0a84.png)\n\nUse set builder notation to describe the shaded region given in the diagram above:\n\n$\\{(x,y)\\in {R}^{2}\\,:\\,$\n{{field-1}}\n${x}^{2}\\,+\\,$\n{{field-2}}\n${y}^{2}$\n{{field-3}}\n\n$36$\n\n$\\}$" :question/worked-solution "The equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the elliptical boundary of our region has horizontal radius $a=2$ and vertical radius $b=3.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{9} & =1,\\end{aligned}\n$$\n\nwhich we can write as\n\n$$\n9{x}^{2}+4{y}^{2}=36.\n$$\n\nWe're interested in describing all points that lie *inside* the ellipse. So, let's pick any point inside the region, say, $(0,0).$ Substituting its coordinates into the equation of the boundary, we obtain\n\n$$\n9(0)^{2}+4(0)^{2}\\,<\\,36.\n$$\n\nAs a result, the points $P(x,y)$ in our region are any real numbers that satisfy the condition\n\n$$\n9{x}^{2}+4{y}^{2}<36.\n$$\n\nWe must also include the curve $9{x}^{2}+4{y}^{2}=36$ since the boundary is included in the set (the curve is solid). So, we change the inequality symbol above as follows:\n\n$$\n9{x}^{2}+4{y}^{2}\\le 36.\n$$\n\nTherefore, we can write the set as\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,9{x}^{2}+4{y}^{2}\\le 36\\}.\n$$"} :step/id #uuid "fcf0ef42-6ecb-558a-9e0e-218f1cbed866" :step/next {:db/id #edb/ref 17592186441154}}] :activity/title "Describing Planar Regions Using Set-Builder Notation" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186441150}]}
