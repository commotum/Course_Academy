#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186441152} :activity/id #uuid "cc2eec70-1647-5419-a327-f6c1951358dd" :activity/scope {:db/id #edb/ref 17592186051063 :topic/id #uuid "7df685b7-b3c7-5f49-ba38-fa8edde1bc9a" :topic/math-academy-id 4392} :activity/steps [{:db/id #edb/ref 17592186441152 :step/content {:db/id #edb/ref 17592186374407 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c7daca75-cb84-525d-be2f-9604ebcf32dd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value ">" :db/id #edb/ref 17592186374409} {:answer/id #uuid "7e791571-9546-5009-bc38-25e83877079d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ne " :db/id #edb/ref 17592186374410} {:answer/id #uuid "295b2100-f334-53be-b9fe-d1932f85c458" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\le " :db/id #edb/ref 17592186374411} {:answer/id #uuid "9164fb18-2d76-5826-96dc-3909bc2e3f16" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ge " :db/id #edb/ref 17592186374412} {:answer/id #uuid "ead3d9c5-e428-5d92-b348-e8ea96d980e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "<" :db/id #edb/ref 17592186374413}] :answer-field/correct {:db/id #edb/ref 17592186374411} :answer-field/id #uuid "6b97a150-262f-5dd7-9bc4-87966d429ca7" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186374408} {:answer-field/choices [{:answer/id #uuid "be5a308a-017f-5314-a9a1-5ab8ff323996" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}^{2}" :db/id #edb/ref 17592186374415} {:answer/id #uuid "68a128eb-22d1-54c2-b694-1d04f74d6d6e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "N" :db/id #edb/ref 17592186374416} {:answer/id #uuid "fbac01d2-efa9-526d-8100-5ae2a3b1e3e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "Z" :db/id #edb/ref 17592186374417} {:answer/id #uuid "c1785e0b-d077-5a1f-94a3-7d98789e90fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{Z}^{2}" :db/id #edb/ref 17592186374418} {:answer/id #uuid "c0a04e0f-2460-5291-9568-7c9e8794d0fe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "R" :db/id #edb/ref 17592186374419} {:answer/id #uuid "b6d9c0de-0c34-5547-8c21-d8b4a8f9c80a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{N}^{2}" :db/id #edb/ref 17592186374420}] :answer-field/correct {:db/id #edb/ref 17592186374418} :answer-field/id #uuid "1454ce89-d759-58c7-a98b-a5b287aac190" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186374414}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "adb62f2e-918d-5d56-973b-da3bc299a8de" :question/math-academy-id "q-181602" :question/problem "![](images/79/79df94546a6fafcd66f8733622e8e9d8c37d29c24cb99378eba141610a8fdc8a.png)\n\nDescribe the shaded region shown above using set-builder notation.\n\n$$\n\\{(x,y)\\in {{field-1}}\\,:\\,y\\,{{field-2}}\\,x-1\\}\n$$" :question/worked-solution "Since all points $P(x,y)$ in our set lie at integer values of $x$ and $y,$ we have $x\\in Z,y\\in Z,$ and therefore \n\n$$\n(x,y)\\in Z\\times Z={Z}^{2}.\n$$\n\nThe points in our set include all those that lie *below* the line $y=x-1.$ For those points, the following condition is satisfied:\n\n$$\ny<x-1\n$$\n\nAlso, notice that some points in our set lie *on* the line. We include these points by changing the inequality symbol above as follows:\n\n$$\ny\\le x-1\n$$\n\nTherefore, we can write the set as follows:\n\n$$\n\\{(x,y)\\in {Z}^{2}\\,:\\,y\\le x-1\\}\n$$"} :step/id #uuid "1cdff818-5e0c-5b45-b6f2-7455eaaf1808" :step/next {:db/id #edb/ref 17592186441153}} {:db/id #edb/ref 17592186441153 :step/content {:db/id #edb/ref 17592186383633 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89059596-c90e-5800-b5c8-67b3cfc816fb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value ">" :db/id #edb/ref 17592186383