ef 1079 #uuid "5a46153c-e7f9-5a37-81cc-90b7f7320e59" #edb/ref 17592186045417] [17592186481283 #edb/ref 1075 #edb/ref 17592186480817 #edb/ref 17592186045417] [17592186481283 #edb/ref 1075 #edb/ref 17592186480937 #edb/ref 17592186045417] [17592186481283 #edb/ref 1075 #edb/ref 17592186481082 #edb/ref 17592186045417] [17592186481283 #edb/ref 1075 #edb/ref 17592186481121 #edb/ref 17592186045417] [17592186481283 #edb/ref 1075 #edb/ref 17592186481174 #edb/ref 17592186045417] [17592186481283 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186481283 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186481283 #edb/ref 1078 #edb/ref 17592186480817 #edb/ref 17592186045417] [17592186481283 #edb/ref 1079 #uuid "7f12123e-d897-5bb5-a021-652c5ffc786d" #edb/ref 17592186045417] [17592186481356 #edb/ref 1068 #edb/ref 17592186481283 #edb/ref 17592186045417] [17592186481356 #edb/ref 1069 "q-110978" #edb/ref 17592186045417] [17592186481356 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186481356 #edb/ref 1071 "Consider the matrix given by $A=[\\begin{aligned}-2 & 1 \\\\ 1 & 1 \\\\ 0 & 5\\end{aligned}].$ Determine the value of $k$ for which the vector $b=[\\begin{aligned}-3 \\\\ 12 \\\\ k+30\\end{aligned}]$ belongs to $\\text{Col}(A).$" #edb/ref 17592186045417] [17592186481356 #edb/ref 1072 #uuid "379e6627-cf03-580e-9f81-1437be9f7987" #edb/ref 17592186045417] [17592186481356 #edb/ref 1074 "If $b$ lies in $\\text{Col}(A),$ then the equation $Ax=b$ must be consistent. So, let's find the row echelon form of the augmented matrix $[A\\,|\\,b]$ as follows:\n\n$$\n\\begin{aligned}[A\\,|\\,b] & =[\\begin{aligned}-2 & 1 & -3 \\\\ 1 & 1 & 12 \\\\ 0 & 5 & k+30\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 1 & 12 \\\\ -2 & 1 & -3 \\\\ 0 & 5 & k+30\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & 12 \\\\ 0 & 3 & 21 \\\\ 0 & 5 & k+30\\end{aligned}] & {R}_{2} & :=(\\frac{1}{3}){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 1 & 12 \\\\ 0 & 1 & 7 \\\\ 0 & 5 & k+30\\end{aligned}] & {R}_{3} & :={R}_{3}-5{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 1 & 12 \\\\ 0 & 1 & 7 \\\\ 0 & 0 & k-5\\end{aligned}]\\end{aligned}\n$$\n\nSo, we have the system\n\n$$\n\\{\\begin{aligned}{x}_{1}+{x}_{2}=12 \\\\ {x}_{2}=7 \\\\ 0=k-5.\\end{aligned}\n$$\n\nIn order for this system to be consistent, we require $0=k-5,$ which means that $k=5.$" #edb/ref 17592186045417] [17592186481379 #edb/ref 1068 #edb/ref 17592186481270 #edb/ref 17592186045417] [17592186481379 #edb/ref 1069 "q-74210" #edb/ref 17592186045417] [17592186481379 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186481379 #edb/ref 1071 "Consider the matrix given by $C=[\\begin{aligned}1 & -3 \\\\ -3 & 5 \\\\ 2 & -4\\end{aligned}].$ Determine the value of $k$ for which the vector $b=[\\begin{aligned}2 \\\\ 0 \\\\ k\\end{aligned}]$ belongs to $\\text{Col}(C).$" #edb/ref 17592186045417] [17592186481379 #edb/ref 1072 #uuid "66f9559c-8f7e-590d-8f2d-e6935f863326" #edb/ref 17592186045417] [17592186481379 #edb/ref 1074 "If $b$ lies in $\\text{Col}(C),$ then the equation $Cx=b$ must be consistent. So, let's find the row echelon form of the augmented matrix $[C\\,|\\,b]$ as follows:\n\n$$\n\\begin{aligned}[C\\,|\\,b] & =[\\begin{aligned}1 & -3 & 2 \\\\ -3 & 5 & 0 \\\\ 2 & -4 & k\\end{aligned}] & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 2 \\\\ 0 & -4 & 6 \\\\ 2 & -4 & k\\end{aligned}] & {R}_{3} & :={R}_{3}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 2 \\\\ 0 & -4 & 6 \\\\ 0 & 2 & k-4\\end{aligned}] & {R}_{3} & :={R}_{3}+\\frac{1}{2}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -3 & 2 \\\\ 0 & -4 & 6 \\\\ 0 & 0 & k-1\\end{aligned}]\\end{aligned}\n$$\n\nSo, we have the system\n\n$$\n\\{\\begin{aligned}{x}_{1}-3{x}_{2}=2 \\\\ -4{x}_{2}=6 \\\\ 0=k-1.\\end{aligned}\n$$\n\nIn order for this system to be consistent, we require $0=k-1,$ which means that $k=1.$" #edb/ref 17592186045417] [17592186481445 #edb/ref 1058 #edb/ref 17592186481475 #edb/ref 17592186045417] [17592186481445 #edb/ref 1062 #uuid "18815fe1-7a23-50e9-b4e6-4a08c8787198" #edb/ref 17592186045417] [17592186481445 #edb/ref 1063 #edb/ref 17592186323698 #edb/ref 17592186045417] [17592186481449 #edb/ref 1062 #uuid "34d92445-9658-5baa-b2e8-ecaa236d882b" #edb/ref 17592186045417] [17592186481449 #edb/ref 1063 #edb/ref 17592186408162 #edb/ref 17592186045417] [17592186481460 #edb/ref 1058 #edb/ref 17592186481445 #edb/ref 17592186045417] [17592186481460 #edb/ref 1062 #uuid "86ec8e45-63d4-5d25-a4e3-e63dc0aaaa33" #edb/ref 17592186045417] [17592186481460 #edb/ref 1063 #edb/ref 17592186317416 #edb/ref 17592186045417] [17592186481461 #edb/ref 1058 #edb/ref 17592186481449 #edb/ref 17592186045417] [17592186481461 #edb/ref 1062 #uuid "8889818c-a946-5d8d-bda5-8076c4a7ea11" #edb/ref 17592186045417] [17592186481461 #edb/ref 1063 #edb/ref 17592186481356 #edb/ref 17592186045417] [17592186481475 #edb/ref 1058 #edb/ref 17592186481461 #edb/ref 17592186045417] [17592186481475 #edb/ref 1062 #uuid "ffca9ec5-be0b-5330-9fd1-5e439c5ad7d1" #edb/ref 17592186045417] [17592186481475 #edb/ref 1063 #edb/ref 17592186481379 #edb/ref 17592186045417]}
