#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186481460} :activity/id #uuid "4195ab3a-5a74-5c79-a379-9f09ccd21301" :activity/scope {:db/id #edb/ref 17592186050656 :topic/id #uuid "5ce2b050-dd59-54b3-bb85-3a4f08ea0365" :topic/math-academy-id 1850} :activity/steps [{:db/id #edb/ref 17592186481445 :step/content {:db/id #edb/ref 17592186323698 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a289e23-c521-5e54-87e0-23820eb4b3e6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186321350} {:answer/id #uuid "204a0a89-e831-51e4-93db-e70840ed8600" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5" :db/id #edb/ref 17592186321388} {:answer/id #uuid "377c432d-decc-5e5a-9367-f7380ee1dac6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186321568} {:answer/id #uuid "b1ae17d4-a96f-5105-94cd-190c9f5d420f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186322538} {:answer/id #uuid "ea3e4ad3-76a0-55d7-9ad3-a2a4b892bc0c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186322980}] :answer-field/correct {:db/id #edb/ref 17592186321388} :answer-field/id #uuid "366ee9e6-9261-50c5-be6e-dbdc9c1112d9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186323276}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "dfc6c6aa-ca5b-5544-805f-85d28c983b53" :question/math-academy-id "q-35562" :question/problem "Consider the matrix given by $A=[\\begin{aligned}2 & -7 \\\\ 1 & -4 \\\\ 3 & 5\\end{aligned}].$ Determine the value of $k$ for which the vector $b=[\\begin{aligned}7 \\\\ 4 \\\\ k\\end{aligned}]$ belongs to $\\text{Col}(A).$" :question/worked-solution "If $b$ lies in $\\text{Col}(A),$ then the equation $Ax=b$ must be consistent. So, let's find the row echelon form of the augmented matrix $[A\\,|\\,b]$ as follows:\n\n$$\n\\begin{aligned}[A\\,|\\,b] & =[\\begin{aligned}2 & -7 & 7 \\\\ 1 & -4 & 4 \\\\ 3 & 5 & k\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -4 & 4 \\\\ 2 & -7 & 7 \\\\ 3 & 5 & k\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & -4 & 4 \\\\ 0 & 1 & -1 \\\\ 3 & 5 & k\\end{aligned}] & {R}_{3} & :={R}_{3}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & -4 & 4 \\\\ 0 & 1 & -1 \\\\ 0 & 17 & k-12\\end{aligned}] & {R}_{3} & :={R}_{3}+(-17){R}_{2} \\\\  & ∼[\\begin{aligned}1 & -4 & 4 \\\\ 0 & 1 & -1 \\\\ 0 & 0 & k+5\\end{aligned}]\\end{aligned}\n$$\n\nSo, we have the system\n\n$$\n\\{\\begin{aligned}{x}_{1}-4{x}_{2}=4 \\\\ {x}_{2}=-1 \\\\ 0=k+5.\\end{aligned}\n$$\n\nIn order for this system to be consistent, we require $0=k+5,$ which means that $k=-5.$"} :step/id #uuid "18815fe1-7a23-50e9-b4e6-4a08c8787198" :step/next {:db/id #edb/ref 17592186481475}} {:db/id #edb/ref 17592186481449 :step/content {:db/id #edb/ref 17592186408162 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "78645ea0-f8bd-5f81-bf27-fac8caad6e9c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "b\\notin \\text{Col}(D)" :db/id #edb/ref 17592186408146} {:answer/id #uuid "7acd09aa-e693-553d-8659-2bccadf0cd4f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "36" :db/id #edb/ref 17592186408147} {:answer/id #uuid "a9c33b38-1f8c-54fe-a1a1-31dc93958a1a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15" :db/id #edb/ref 17592186408148} {:answer/id #uuid "af5fd598-f27a-56c8-bd28-250a38b55ee9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186408149} {:answer/id #uuid "b263cee4-a3ad-5f42-875f-5cc9d7a2c77d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "24" :db/id #edb/ref 17592186408150}] :answer-field/correct {:db/id #edb/ref 17592186408146} :answer-field/id #uuid "9a398de2-1cab-5e15-93f0-5e8dde00197f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186408160}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "06040e86-0928-550a-a9a4-3db2bc9e2e31" :question/math-academy-id "q-111046" :question/problem "The matrix $D$ and the vector $b$ are given below.\nDetermine if $b\\in \\text{Col}(D).$ \nIn the affirmative case, find the value of ${x}_{1}+{x}_{2}+{x}_{3}+{x}_{4}$, where ${x}_{1}$, ${x}_{2}$, ${x}_{3}$, and ${x}_{4}$ are real numbers such that $b={x}_{1}{d}_{1}+{x}_{2}{d}_{2}+{x}_{3}{d}_{3}+{x}_{4}{d}_{4},$ and ${d}_{1}$, ${d}_{2}$, ${d}_{3}$, and ${d}_{4}$ are respective columns of $D.$\n\n$$\nD=[\\begin{aligned}1 & 1 & -3 & -2 \\\\ -2 & -2 & 6 & 4 \\\\ 2 & 2 & 1 & 1 \\\\ 1 & 6 & 5 & -1\\end{aligned}],\\,b=[\\begin{aligned}1 \\\\ 4 \\\\ 8 \\\\ 6\\end{aligned}]\n$$" :question/worked-solution "In order to determine whether $b$ lies in $\\text{Col}(D),$ we need to check if the equation $Dx=b$ is consistent. So, let's find the row echelon form of the augmented matrix $[D\\,|\\,b]$ as follows:\n\n$$\n\\begin{aligned}[D\\,|\\,b] & =[\\begin{aligned}1 & 1 & -3 & -2 & 1 \\\\ -2 & -2 & 6 & 4 & 4 \\\\ 2 & 2 & 1 & 1 & 8 \\\\ 1 & 6 & 5 & -1 & 6\\end{aligned}] & {R}_{3} & :={R}_{3}+2{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 1 & -3 & -2 & 1 \\\\ 0 & 0 & 0 & 0 & 6 \\\\ 2 & 2 & 1 & 1 & 8 \\\\ 1 & 6 & 5 & -1 & 6\\end{aligned}]\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n\\{\\begin{aligned}{x}_{1}+{x}_{2}-3{x}_{3}-2{x}_{4}=1 \\\\ 0=6 \\\\ 2{x}_{1}+2{x}_{2}+{x}_{3}+{x}_{4}=-8 \\\\ {x}_{1}+6{x}_{2}+5{x}_{3}-{x}_{4}=6.\\end{aligned}\n$$\n\nFrom the  second equation, we get a false statement $0=6.$ Therefore, the system is inconsistent, and we conclude that $b\\notin \\text{Col}(D).$"} :step/id #uuid "34d92445-9658-5baa-b2e8-ecaa236d882b"} {:db/id #edb/ref 17592186481460 :step/content {:db/id #edb/ref 17592186317416 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0137f4f1-683a-5532-86ac-a58609ac6c5a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186315122} {:answer/id #uuid "36dddeda-f4aa-5342-a56d-21d473781fec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "b\\notin \\text{Col}(E)" :db/id #edb/ref 17592186315436} {:answer/id #uuid "40a90e71-399a-5c76-8a51-5bf7d89f38b6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186315490} {:answer/id #uuid "5eed2d17-3d66-58ef-b9ca-d14343adcf9f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18" :db/id #edb/ref 17592186315652} {:answer/id #uuid "fe5e2b84-4825-5e40-b36f-66a99eaaf9f8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186316542}] :answer-field/correct {:db/id #edb/ref 17592186315436} :answer-field/id #uuid "4285fcd0-9fe1-5d74-91ff-bd01e5c9f93a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186316697}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "d2325a17-fb51-5bea-98a4-12b407e10918" :question/math-academy-id "q-34364" :question/problem "The matrix $E$ and the vector $b$ are given below.\nDetermine if $b\\in \\text{Col}(E).$ \nIn the affirmative case, find the value of ${x}_{1}\\cdot {x}_{2}\\cdot {x}_{3}\\cdot {x}_{4}$, where ${x}_{1}$, ${x}_{2}$, ${x}_{3}$, and ${x}_{4}$ are real numbers such that $b={x}_{1}{e}_{1}+{x}_{2}{e}_{2}+{x}_{3}{e}_{3}+{x}_{4}{e}_{4},$ and ${e}_{1}$, ${e}_{2}$, ${e}_{3}$, and ${e}_{4}$ are respective columns of $E.$\n\n$$\nE=[\\begin{aligned}8 & -2 & 5 & 1 \\\\ 16 & -4 & 10 & 2 \\\\ 11 & -3 & 0 & -1\\end{aligned}],\\,b=[\\begin{aligned}4 \\\\ -1 \\\\ 0\\end{aligned}]\n$$" :question/worked-solution "In order to determine whether $b$ lies in $\\text{Col}(E),$ we need to check if the equation $Ex=b$ is consistent. So, let's find the row echelon form of the augmented matrix $[E\\,|\\,b]$ as follows:\n\n$$\n\\begin{aligned}[E\\,|\\,b] & =[\\begin{aligned}8 & -2 & 5 & 1 & 4 \\\\ 16 & -4 & 10 & 2 & -1 \\\\ 11 & -3 & 0 & -1 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}8 & -2 & 5 & 1 & 4 \\\\ 0 & 0 & 0 & 0 & -9 \\\\ 11 & -3 & 0 & -1 & 0\\end{aligned}]\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n\\{\\begin{aligned}8{x}_{1}-2{x}_{2}+5{x}_{3}+{x}_{4}=4 \\\\ 0=-9 \\\\ 11{x}_{1}-3{x}_{2}-{x}_{4}=0.\\end{aligned}\n$$\n\nFrom the second equation, we get a false statement $0=-9.$ Therefore, the system is inconsistent, and we conclude that $b\\notin \\text{Col}(E).$"} :step/id #uuid "86ec8e45-63d4-5d25-a4e3-e63dc0aaaa33" :step/next {:db/id #edb/ref 17592186481445}} {:db/id #edb/ref 17592186481461 :step/content {:db/id #edb/ref 17592186481356 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2af634ac-2adf-5266-9d5e-f4ec6782ebb9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186480817} {:answer/id #uuid "6a7caeaf-072f-52ba-8fa7-2bd619dc7e84" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15" :db/id #edb/ref 17592186480937} {:answer/id #uuid "b3cc978a-23f8-5e0c-a899-6cecd8ec9666" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "35" :db/id #edb/ref 17592186481082} {:answer/id #uuid "c9ba0f1e-64d5-5b98-bd5a-3378ee864a41" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-15" :db/id #edb/ref 17592186481121} {:answer/id #uuid "e4fc9398-1cd8-5d45-bef7-2d3eb160e0af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186481174}] :answer-field/correct {:db/id #edb/ref 17592186480817} :answer-field/id #uuid "7f12123e-d897-5bb5-a021-652c5ffc786d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186481283}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "379e6627-cf03-580e-9f81-1437be9f7987" :question/math-academy-id "q-110978" :question/problem "Consider the matrix given by $A=[\\begin{aligned}-2 & 1 \\\\ 1 & 1 \\\\ 0 & 5\\end{aligned}].$ Determine the value of $k$ for which the vector $b=[\\begin{aligned}-3 \\\\ 12 \\\\ k+30\\end{aligned}]$ belongs to $\\text{Col}(A).$" :question/worked-solution "If $b$ lies in $\\text{Col}(A),$ then the equation $Ax=b$ must be consistent. So, let's find the row echelon form of the augmented matrix $[A\\,|\\,b]$ as follows:\n\n$$\n\\begin{aligned}[A\\,|\\,b] & =[\\begin{aligned}-2 & 1 & -3 \\\\ 1 & 1 & 12 \\\\ 0 & 5 & k+30\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 1 & 12 \\\\ -2 & 1 & -3 \\\\ 0 & 5 & k+30\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & 12 \\\\ 0 & 3 & 21 \\\\ 0 & 5 & k+30\\end{aligned}] & {R}_{2} & :=(\\frac{1}{3}){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 1 & 12 \\\\ 0 & 1 & 7 \\\\ 0 & 5 & k+30\\end{aligned}] & {R}_{3} & :={R}_{3}-5{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 1 & 12 \\\\ 0 & 1 & 7 \\\\ 0 & 0 & k-5\\end{aligned}]\\end{aligned}\n$$\n\nSo, we have the system\n\n$$\n\\{\\begin{aligned}{x}_{1}+{x}_{2}=12 \\\\ {x}_{2}=7 \\\\ 0=k-5.\\end{aligned}\n$$\n\nIn order for this system to be consistent, we require $0=k-5,$ which means that $k=5.$"} :step/id #uuid "8889818c-a946-5d8d-bda5-8076c4a7ea11" :step/next {:db/id #edb/ref 17592186481449}} {:db/id #edb/ref 17592186481475 :step/content {:db/id #edb/ref 17592186481379 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "191150d3-af6c-5369-8a94-a6bfdd39b6f0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186480790} {:answer/id #uuid "95981581-0e25-501f-b8a4-5a0f6cf1319e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186481023} {:answer/id #uuid "ad84d374-04e9-548c-b3e0-df1326473bde" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186481064} {:answer/id #uuid "d3299a9a-dd1e-5fcf-906a-3fe1e9c9e612" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186481134} {:answer/id #uuid "db545c16-037d-5d5e-bd83-57a3b42fa7ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186481152}] :answer-field/correct {:db/id #edb/ref 17592186481064} :answer-field/id #uuid "5a46153c-e7f9-5a37-81cc-90b7f7320e59" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186481270}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "66f9559c-8f7e-590d-8f2d-e6935f863326" :question/math-academy-id "q-74210" :question/problem "Consider the matrix given by $C=[\\begin{aligned}1 & -3 \\\\ -3 & 5 \\\\ 2 & -4\\end{aligned}].$ Determine the value of $k$ for which the vector $b=[\\begin{aligned}2 \\\\ 0 \\\\ k\\end{aligned}]$ belongs to $\\text{Col}(C).$" :question/worked-solution "If $b$ lies in $\\text{Col}(C),$ then the equation $Cx=b$ must be consistent. So, let's find the row echelon form of the augmented matrix $[C\\,|\\,b]$ as follows:\n\n$$\n\\begin{aligned}[C\\,|\\,b] & =[\\begin{aligned}1 & -3 & 2 \\\\ -3 & 5 & 0 \\\\ 2 & -4 & k\\end{aligned}] & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 2 \\\\ 0 & -4 & 6 \\\\ 2 & -4 & k\\end{aligned}] & {R}_{3} & :={R}_{3}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 2 \\\\ 0 & -4 & 6 \\\\ 0 & 2 & k-4\\end{aligned}] & {R}_{3} & :={R}_{3}+\\frac{1}{2}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -3 & 2 \\\\ 0 & -4 & 6 \\\\ 0 & 0 & k-1\\end{aligned}]\\end{aligned}\n$$\n\nSo, we have the system\n\n$$\n\\{\\begin{aligned}{x}_{1}-3{x}_{2}=2 \\\\ -4{x}_{2}=6 \\\\ 0=k-1.\\end{aligned}\n$$\n\nIn order for this system to be consistent, we require $0=k-1,$ which means that $k=1.$"} :step/id #uuid "ffca9ec5-be0b-5330-9fd1-5e439c5ad7d1" :step/next {:db/id #edb/ref 17592186481461}}] :activity/title "The Column Space of a Matrix" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186480732}]}
