#{[{:db/id #edb/ref 17592186244108 :knowledge-point/_questions [{:db/id #edb/ref 17592186105770 :knowledge-point/id #uuid "b7f5608f-a9f5-5e6a-b308-540ed8b29259" :knowledge-point/title "Determining the Value of an Unknown Given an Eigenvalue and Eigenvector of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "273e62f3-6609-56a7-9f9c-2f828cee49de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186241518} {:answer/id #uuid "635e199a-7df1-555e-ad95-cd8ebeff5844" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186242075} {:answer/id #uuid "9e018857-7a03-58b2-a2e8-2b369d545876" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186242563} {:answer/id #uuid "bd0396fb-d3c0-599c-b302-05a3a09b022b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186242840} {:answer/id #uuid "fa286430-0097-5d28-a925-5681e6764598" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186243384}] :answer-field/correct {:answer/id #uuid "bd0396fb-d3c0-599c-b302-05a3a09b022b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186242840} :answer-field/id #uuid "b0a27bf4-3dfa-5e87-8e01-d2eefbd768d7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243757}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "242d3574-f624-5b15-a035-897cf33da567" :question/math-academy-id "q-107842" :question/problem "The eigenvector of $A=[\\begin{aligned}1 & -8+k \\\\ 3 & 5k\\end{aligned}]$ corresponding to the eigenvalue $\\lambda =2k$ is  $[\\begin{aligned}-2 \\\\ 1\\end{aligned}].$ Determine the value of $k.$" :question/worked-solution "Remember that the eigenvectors of $A$ are the non-zero vectors $v$ such that $Av=\\lambda v.$ So, we have\n\n$$\n\\begin{aligned}Av & =\\lambda v \\\\ [\\begin{aligned}1 & -8+k \\\\ 3 & 5k\\end{aligned}][\\begin{aligned}-2 \\\\ 1\\end{aligned}] & =2k[\\begin{aligned}-2 \\\\ 1\\end{aligned}] \\\\ [\\begin{aligned}k-10 \\\\ -6+5k\\end{aligned}] & =[\\begin{aligned}-4k \\\\ 2k\\end{aligned}].\\end{aligned}\n$$\n\nThis gives us the following system of linear equations:\n\n$$\n\\{\\begin{aligned}k-10=-4k, \\\\ -6+5k=2k\\end{aligned}\n$$\n\nSolving for $k$ in the first equation, we get\n\n$$\nk-10=-4k\\,⟹\\,k=2.\n$$\n\nNow, substituting $k=2$ into the second equation, we get\n\n$$\n\\begin{aligned}-6+5k & =2k \\\\ -6+5(2) & =2(2) \\\\ 4 & =4,\\end{aligned}\n$$\n\nwhich is a true statement.\n\nTherefore, the solution of the system is $k=2.$"}] [{:db/id #edb/ref 17592186262922 :knowledge-point/_questions [{:db/id #edb/ref 17592186119935 :knowledge-point/id #uuid "3061cb06-f57f-57c8-8821-dbd962b1e78e" :knowledge-point/title "Finding the Parametric Equation of the Plane Parallel To Two Lines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "259294bf-42a6-5b1f-a914-2eeba4786e4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨-3,12,-7⟩+s⟨1,3,-5⟩+t⟨1,6,5⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186260203} {:answer/id #uuid "3660d937-cc87-5a73-a31f-13375df8d401" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨-7,12,-3⟩+s⟨-5,3,1⟩+t⟨1,5,6⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186260360} {:answer/id #uuid "586437d1-d3c1-5c04-82a5-9e97897d0755" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨-7,-3,12⟩+s⟨-3,4,2⟩+t⟨1,5,5⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186260630} {:answer/id #uuid "5a80a400-edf2-5ed4-95ef-bc093dec6a28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨-7,-3,12⟩+s⟨3,3,1⟩+t⟨1,5,7⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186260648} {:answer/id #uuid "a8a3a0fb-37c8-5001-bfec-42aa7883b3d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨-7,12,-3⟩+s⟨-3,5,1⟩+t⟨1,6,5⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186261347}] :answer-field/correct {:answer/id #uuid "3660d937-cc87-5a73-a31f-13375df8d401" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨-7,12,-3⟩+s⟨-5,3,1⟩+t⟨1,5,6⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186260360} :answer-field/id #uuid "991622fb-4bb5-597a-a633-df7720b54e4a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262397}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "75465043-c7d7-54b7-b914-8b78a961bb97" :question/math-academy-id "q-128536" :question/problem "Find a parametric equation of the plane that passes through the point $B(-7,12,-3)$ and is parallel to the lines $r=⟨-7,2,4⟩+s⟨-5,3,1⟩$ and $r=⟨-22,17,13⟩+t⟨1,5,6⟩.$" :question/worked-solution "The direction vectors of the lines are ${v}_{1}=⟨-5,3,1⟩$ and ${v}_{2}=⟨1,5,6⟩$, respectively. These vectors are parallel to the plane but not to each other.\n\nWe also know that the point $B(-7,12,-3)$ lies on the plane and its position vector is $b=⟨-7,12,-3⟩.$  \n\nSo, the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =b+s{v}_{1}+t{v}_{2} \\\\ r & =⟨-7,12,-3⟩+s⟨-5,3,1⟩+t⟨1,5,6⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$\n\n$$\n\n$$"}] [{:db/id #edb/ref 17592186388355 :knowledge-point/_questions [{:db/id #edb/ref 17592186054697 :knowledge-point/id #uuid "6affd858-749d-5a94-854e-ddadd790ae45" :knowledge-point/title "Inverting a Permutation Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c586833d-f519-5db2-986f-97a6e2667402" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & 0 & 0 \\\\ 0 & -1 & 0 \\\\ 0 & 0 & -1\\end{aligned}]" :db/id #edb/ref 17592186388357} {:answer/id #uuid "ee43d0e8-4c86-502d-abfd-84b12cc35959" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186388358} {:answer/id #uuid "2271aec9-a2b4-5a0a-a941-63ed32717332" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 & -1 \\\\ 0 & -1 & 0 \\\\ -1 & 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186388359} {:answer/id #uuid "3ebb0741-3775-5ad3-9a33-06de8b3bb023" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -1\\end{aligned}]" :db/id #edb/ref 17592186388360} {:answer/id #uuid "14150974-642c-58c2-9a04-41aa467ace14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186388361}] :answer-field/correct {:answer/id #uuid "ee43d0e8-4c86-502d-abfd-84b12cc35959" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186388358} :answer-field/id #uuid "d12a4dde-d3e7-5f26-82ea-8ff8d75d25e7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388356}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ab7ab5ac-cf9c-5408-a789-f3b32435589c" :question/math-academy-id "q-135373" :question/problem "Find the inverse of the following matrix:\n\n$$\nA=[\\begin{aligned}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{aligned}]\n$$" :question/worked-solution "The given matrix can be obtained from the identity matrix by permuting its columns. Therefore, $A$ is a permutation matrix.\n\nThe inverse of a permutation matrix can be found as follows: \n\n$$\n{P}^{-1}={P}^{T}\n$$\n\nIn our case, we obtain\n\n$$\n\\begin{aligned}{A}^{-1}={[\\begin{aligned}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{aligned}]}^{-1}={[\\begin{aligned}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{aligned}]}^{T}=[\\begin{aligned}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186060142 :knowledge-point/_questions [{:db/id #edb/ref 17592186059689 :knowledge-point/id #uuid "0d56b033-a2c8-57c7-adde-e574d726ec78" :knowledge-point/title "Rewriting Symbolic Conditional Statements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9c8d5ea2-5c8e-5863-b634-8172a1da8c33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬A∧¬B" :db/id #edb/ref 17592186057219} {:answer/id #uuid "ab9b69c3-6af3-523b-a894-d20f75430af4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A∧¬B" :db/id #edb/ref 17592186057220} {:answer/id #uuid "4aa812d0-26e4-513f-bf92-5131225f1ad1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$t$ (tautology)" :db/id #edb/ref 17592186057221} {:answer/id #uuid "5238cd11-e5bb-5305-b6e9-b0b21b2429d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A∨B" :db/id #edb/ref 17592186057222} {:answer/id #uuid "692cf23e-315d-592d-8ca9-2929fd245e90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬A∧B" :db/id #edb/ref 17592186057223}] :answer-field/correct {:answer/id #uuid "ab9b69c3-6af3-523b-a894-d20f75430af4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A∧¬B" :db/id #edb/ref 17592186057220} :answer-field/id #uuid "5d3318c5-0318-518c-b129-a1623899826b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186057218}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "199ef1bf-29a7-5792-bf23-b4a22e87950a" :question/math-academy-id "q-182469" :question/problem "Simplify the statement $¬(A⇒B).$" :question/worked-solution "The conditional statement $P⇒Q$ is logically equivalent to the disjunction $¬P∨Q:$\n\nSo, in this case, we have the following equivalence:\n\n$$\n¬(A⇒B)≡¬(¬A∨B)\n$$\n\nDistributing the negation over the disjunction using De Morgan's law, we have\n\n$$\n¬(¬A∨B)≡¬(¬A)∧¬B.\n$$\n\nCanceling out double negation, we reach\n\n$$\nA∧¬B.\n$$\n\nSo the given statement is equivalent to $A∧¬B.$"}] [{:db/id #edb/ref 17592186490249 :knowledge-point/_questions [{:db/id #edb/ref 17592186105826 :knowledge-point/id #uuid "ce428740-1268-5071-9a45-69cdc07aea64" :knowledge-point/title "Computing the Probability of a Binomial Random Variable Over an Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b95860c-921b-57fb-b5ec-46baec795536" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.813" :db/id #edb/ref 17592186489540}] :answer-field/correct {:answer/id #uuid "0b95860c-921b-57fb-b5ec-46baec795536" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.813" :db/id #edb/ref 17592186489540} :answer-field/id #uuid "b9607223-8ad8-5973-98c0-43e17bad1ef9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186490175}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "510156d7-b5c0-5e8b-8cd5-32b7f7e0537d" :question/math-academy-id "q-331503" :question/problem "A fair coin is flipped $5$ times. Rounded to $3$ decimal places, what is the probability that the coin lands on heads at most $3$ times?\n\nRounded to $3$ decimal places, the probability is\n{{field-1}}." :question/worked-solution "Let the random variable $X$ be equal to the number of times the coin lands on heads.\n\nHere, we have the following information:\n\n- There are $n=5$ flips.\n\n- The probability of landing heads is $p=\\frac{1}{2}.$\n\nSo, $X$ follows a binomial distribution, where $X∼B(5,\\frac{1}{2}).$\n\nThe number of successes of a binomial random variable has the probability mass function\n\n$$\nP(X=x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x},\n$$\n\nwhere $n$ is the number of experiments, and $p$ is the probability of success on each experiment.\n\nSubstituting the above information into the formula for the probability mass function, we get\n\n$$\n\\begin{aligned}P(X=x) & =(\\genfrac{}{}{0pt}{}{5}{x}){(\\frac{1}{2})}^{x}{(1-\\frac{1}{2})}^{5-x} \\\\  & =(\\genfrac{}{}{0pt}{}{5}{x}){(\\frac{1}{2})}^{x}{(\\frac{1}{2})}^{5-x}.\\end{aligned}\n$$\n\nWe want to find the probability that at most $3$ of the $5$ flips are heads. So, we compute\n\n$$\n\\begin{aligned}P(X\\le 3) & =P(X=0)+P(X=1)+P(X=2)+P(X=3) \\\\  & =(\\genfrac{}{}{0pt}{}{5}{0}){(\\frac{1}{2})}^{0}{(\\frac{1}{2})}^{5}+(\\genfrac{}{}{0pt}{}{5}{1}){(\\frac{1}{2})}^{1}{(\\frac{1}{2})}^{4} \\\\  & \\,+(\\genfrac{}{}{0pt}{}{5}{2}){(\\frac{1}{2})}^{2}{(\\frac{1}{2})}^{3}+(\\genfrac{}{}{0pt}{}{5}{3}){(\\frac{1}{2})}^{3}{(\\frac{1}{2})}^{2} \\\\  & =(1+5+10+10)\\cdot {(\\frac{1}{2})}^{5} \\\\  & =26\\cdot \\frac{1}{32} \\\\  & =0.813,\\end{aligned}\n$$\n\nrounded to $3$ decimal places."}] [{:db/id #edb/ref 17592186490284 :knowledge-point/_questions [{:db/id #edb/ref 17592186119802 :knowledge-point/id #uuid "ab0d2c2f-e7a4-51bb-a20a-f28c2f7ded8b" :knowledge-point/title "Adding Multiples of Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29e67aff-720a-5267-bf31-39e69fb8ece0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 8 \\\\ 7 \\\\ 10\\end{aligned}]" :db/id #edb/ref 17592186489610} {:answer/id #uuid "99975d59-e39c-52da-aa07-1f7f91d44f57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 7 \\\\ 10 \\\\ 8\\end{aligned}]" :db/id #edb/ref 17592186489856} {:answer/id #uuid "b3ff84af-5a99-5d13-ba4f-d0c92cc0f1ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 \\\\ 5 \\\\ 0 \\\\ 6\\end{aligned}]" :db/id #edb/ref 17592186489909} {:answer/id #uuid "e5e52666-64b5-5697-9e5e-fcded35b39e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 \\\\ 1 \\\\ 8 \\\\ 10\\end{aligned}]" :db/id #edb/ref 17592186490014} {:answer/id #uuid "e86c3aac-878d-529e-a568-e3a364649363" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 7 \\\\ 8 \\\\ 10\\end{aligned}]" :db/id #edb/ref 17592186490018}] :answer-field/correct {:answer/id #uuid "e86c3aac-878d-529e-a568-e3a364649363" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 7 \\\\ 8 \\\\ 10\\end{aligned}]" :db/id #edb/ref 17592186490018} :answer-field/id #uuid "11c37918-e510-58d2-94fc-f2b5cad62a09" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490082}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a325c3ab-0a0f-53da-bbb5-9670c5e960cd" :question/math-academy-id "q-34159" :question/problem "Let $u=[\\begin{aligned}-1 \\\\ 3 \\\\ 2 \\\\ 4\\end{aligned}]$ and $v=[\\begin{aligned}3 \\\\ 1 \\\\ 4 \\\\ 2\\end{aligned}].$ Find $2u+v.$" :question/worked-solution "First, we multiply each component of $u$ by $2.$ Then, we add the vectors:\n\n$$\n\\begin{aligned}2u+v & =2\\cdot [\\begin{aligned}-1 \\\\ 3 \\\\ 2 \\\\ 4\\end{aligned}]+[\\begin{aligned}3 \\\\ 1 \\\\ 4 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}-2 \\\\ 6 \\\\ 4 \\\\ 8\\end{aligned}]+[\\begin{aligned}3 \\\\ 1 \\\\ 4 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}-2+3 \\\\ 6+1 \\\\ 4+4 \\\\ 8+2\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 7 \\\\ 8 \\\\ 10\\end{aligned}]\\end{aligned}\n$$"}]}
