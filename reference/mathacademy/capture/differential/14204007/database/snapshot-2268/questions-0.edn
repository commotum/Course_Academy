#{[{:db/id #edb/ref 17592186124828 :knowledge-point/_questions [{:db/id #edb/ref 17592186124587 :knowledge-point/id #uuid "36c5224a-eccc-5ea9-8719-2b0dc2ddb44d" :knowledge-point/title "The Domain of a Cylinder"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22a180bc-4ecc-573a-b333-06c7019b8383" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbola centered at $(-1,4)$" :db/id #edb/ref 17592186281994} {:answer/id #uuid "550bfaec-6a11-5ddf-b1d5-67ca92888f0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{2}" :db/id #edb/ref 17592186282411} {:answer/id #uuid "69c0eb79-271f-5145-af46-cb71d19281ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}:\\text{ }x\\ge 0}" :db/id #edb/ref 17592186282595} {:answer/id #uuid "96935a61-eb89-5cc2-aba4-b8ddd8b9b387" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbola centered at $(1,-4)$" :db/id #edb/ref 17592186282993} {:answer/id #uuid "d95e04a0-a388-5b35-98e8-1dca8adf8519" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A parabola centered at $(1,-4)$" :db/id #edb/ref 17592186283582}] :answer-field/correct {:answer/id #uuid "22a180bc-4ecc-573a-b333-06c7019b8383" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbola centered at $(-1,4)$" :db/id #edb/ref 17592186281994} :answer-field/id #uuid "bd914ec5-f35f-57ed-80b7-7031ea7255e0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284273}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9d23f0c9-2a90-5ec1-8032-cee754302a30" :question/math-academy-id "q-164350" :question/problem "What is the domain in the $xy$-plane of the hyperbolic cylinder $\\frac{(x+1)^{2}}{4}-\\frac{(y-4)^{2}}{2}=1?$" :question/worked-solution "The full expression describing all points on our hyperbolic cylinder is\n\n$$\n\\frac{(x+1)^{2}}{4}-\\frac{(y-4)^{2}}{2}=1,\\,z=k\n$$\n\nwhere $k\\in R$ can vary arbitrarily. \n\nThe domain of any cylinder in the $xy$-plane is its base curve. Hence, in this case, the domain is\n\n$$\n{(x,y)\\in {R}^{2}:\\text{ }\\frac{(x+1)^{2}}{4}-\\frac{(y-4)^{2}}{2}=1}.\n$$\n\nThis is a hyperbola centered at $(-1,4).$"}] [{:db/id #edb/ref 17592186401467 :knowledge-point/_questions [{:db/id #edb/ref 17592186124588 :knowledge-point/id #uuid "abbeda26-2fc0-5195-be26-ae79c72fc7bf" :knowledge-point/title "Traces of Cylinders"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ff45c2a2-3a41-5311-99ca-5e68d6a5cab4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The parabola $(x+3)^{2}=6z$" :db/id #edb/ref 17592186401469} {:answer/id #uuid "de23290b-1126-571c-a0e8-9a9fda87468d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The line $y=3$" :db/id #edb/ref 17592186401470} {:answer/id #uuid "86e5f373-6dc5-578d-9dab-a014632c2480" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The parabola ${x}^{2}=6(z-3)$" :db/id #edb/ref 17592186401471} {:answer/id #uuid "017e8e93-5da0-5960-ba95-563c27bee3c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The line $y=\\frac{3}{2}$" :db/id #edb/ref 17592186401472} {:answer/id #uuid "defd7bf9-9f21-5237-ad4c-3feffa02e09e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The lines $y=-3$ and $y=15$" :db/id #edb/ref 17592186401473}] :answer-field/correct {:answer/id #uuid "017e8e93-5da0-5960-ba95-563c27bee3c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The line $y=\\frac{3}{2}$" :db/id #edb/ref 17592186401472} :answer-field/id #uuid "770068c0-e321-5534-9c7a-f0ff2132d3c7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401468}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7c06a8e8-6e3d-50f3-ae2e-200f38471a76" :question/math-academy-id "q-164400" :question/problem "What is the trace in the $yz$-plane of the parabolic cylinder $(x+3)^{2}=6y?$" :question/worked-solution "To find the trace in the $yz$-plane, we substitute $x=0$ into the equation of the cylinder, and simplify:\n\n$$\n\\begin{aligned}(0+3)^{2} & =6y \\\\ 9 & =6y \\\\ y & =\\frac{9}{6} \\\\ y & =\\frac{3}{2}\\end{aligned}\n$$\n\nThis gives us the equation of a line in the $yz$-plane."}] [{:db/id #edb/ref 17592186284484 :knowledge-point/_questions [{:db/id #edb/ref 17592186124588 :knowledge-point/id #uuid "abbeda26-2fc0-5195-be26-ae79c72fc7bf" :knowledge-point/title "Traces of Cylinders"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1522ccf7-1c73-5e25-98bf-6dd263d5fbc1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$ and $\\sqrt{2}$" :db/id #edb/ref 17592186281885} {:answer/id #uuid "232eb0b2-7a6d-5519-9997-a1bbea983428" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4$ and $2$" :db/id #edb/ref 17592186281999} {:answer/id #uuid "7722e953-dab7-5d05-9b9d-08f6b6e9c8b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2\\sqrt{2}$ and $\\sqrt{2}$" :db/id #edb/ref 17592186282708} {:answer/id #uuid "a699d037-d2fd-5764-b359-7de78454706f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4$ and $1$" :db/id #edb/ref 17592186283139} {:answer/id #uuid "d65c612a-abbc-596c-905a-f106ddd0bb00" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$ and $1$" :db/id #edb/ref 17592186283555}] :answer-field/correct {:answer/id #uuid "1522ccf7-1c73-5e25-98bf-6dd263d5fbc1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$ and $\\sqrt{2}$" :db/id #edb/ref 17592186281885} :answer-field/id #uuid "3c165dc7-12d5-543c-bcd2-a61bd8d77a7f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284035}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a62eeaa1-08b2-5837-81a7-678acd38fe82" :question/math-academy-id "q-164411" :question/problem "The projection of the intersection between the hyperbolic cylinder $3(x+1)^{2}-6(z-2)^{2}=12$ and the plane $y=1$ onto the $xz$-plane is a hyperbola. What are the lengths of the semi-axes of the hyperbola?" :question/worked-solution "To find the intersection of the cylinder and the plane $y=1,$ we substitute $y=1$ into the equation of the cylinder. However, since the equation has no (explicit) $y$ term, we get\n\n$$\n\\begin{aligned}3(x+1)^{2}-6(z-2)^{2} & =12 \\\\ \\frac{(x+1)^{2}}{4}-\\frac{(z-2)^{2}}{2} & =1 \\\\ \\frac{(x+1)^{2}}{(2)^{2}}-\\frac{(z-2)^{2}}{(\\sqrt{2})^{2}} & =1.\\end{aligned}\n$$\n\nThis gives us the equation of a hyperbola with semi-axes of lengths $2$ and $\\sqrt{2}.$"}] [{:db/id #edb/ref 17592186476898 :knowledge-point/_questions [{:db/id #edb/ref 17592186124587 :knowledge-point/id #uuid "36c5224a-eccc-5ea9-8719-2b0dc2ddb44d" :knowledge-point/title "The Domain of a Cylinder"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27c5aab8-0a81-5132-a7be-619ec038e1a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A leftward-opening parabola with a vertex at $(-2,0)$" :db/id #edb/ref 17592186476292} {:answer/id #uuid "2c4674c7-f259-581e-8614-736a3cb60f3d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A downward-opening parabola with a vertex at $(-2,0)$" :db/id #edb/ref 17592186476303} {:answer/id #uuid "5d59a046-342f-501f-ac16-73130a0b65f9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A leftward-opening parabola with a vertex at $(0,-2)$" :db/id #edb/ref 17592186476412} {:answer/id #uuid "850ca197-95db-57a6-9657-7a8c734bb035" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{2}" :db/id #edb/ref 17592186476493} {:answer/id #uuid "b3492ae0-c5c3-5f74-a048-e9fe9d78ac1a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A downward-opening parabola with a vertex at $(0,-2)$" :db/id #edb/ref 17592186476609}] :answer-field/correct {:answer/id #uuid "5d59a046-342f-501f-ac16-73130a0b65f9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A leftward-opening parabola with a vertex at $(0,-2)$" :db/id #edb/ref 17592186476412} :answer-field/id #uuid "85d8478a-9dda-5ec1-b44a-27ba892935a0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186476815}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "52ee82cc-593c-5df5-9ddf-f0c4aabcb195" :question/math-academy-id "q-164421" :question/problem "What is the domain in the $xy$-plane of the parabolic cylinder $(y+2)^{2}=-4x?$" :question/worked-solution "The full expression describing all points on our parabolic cylinder is\n\n$$\n(y+2)^{2}=-4x,\\,z=k\n$$\n\nwhere $k\\in R$ can vary arbitrarily. \n\nThe domain of any cylinder in the $xy$-plane is its base curve. Hence, in this case, the domain is\n\n$$\n\\{(x,y)\\in {R}^{2}:(y+2)^{2}=-4x\\}.\n$$\n\nThis is a leftward-opening parabola with a vertex at $(0,-2).$"}] [{:db/id #edb/ref 17592186124879 :knowledge-point/_questions [{:db/id #edb/ref 17592186124588 :knowledge-point/id #uuid "abbeda26-2fc0-5195-be26-ae79c72fc7bf" :knowledge-point/title "Traces of Cylinders"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9039fbb0-0427-5260-9819-2bc08ae0459b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\sqrt{2}$ and $4$" :db/id #edb/ref 17592186402397} {:answer/id #uuid "f1c93b02-8df2-5914-a21e-f47c872f2f7e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\sqrt{2}$ and $3$" :db/id #edb/ref 17592186402398} {:answer/id #uuid "ed44325a-1253-529b-97fa-5240ff07dcf9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4$ and $3$" :db/id #edb/ref 17592186402399} {:answer/id #uuid "061693b6-a3c5-5e80-8fdd-66ff86213ad8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$ and $6$" :db/id #edb/ref 17592186402400} {:answer/id #uuid "e63ce889-a7da-51d5-ba30-855cbdeb579a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2\\sqrt{2}$ and $6$" :db/id #edb/ref 17592186402401}] :answer-field/correct {:answer/id #uuid "f1c93b02-8df2-5914-a21e-f47c872f2f7e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\sqrt{2}$ and $3$" :db/id #edb/ref 17592186402398} :answer-field/id #uuid "d2749579-8262-5164-918f-9718b15dd845" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402396}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4fb4b9c0-1e83-54e2-ab98-0137b703d096" :question/math-academy-id "q-35363" :question/problem "The projection of the intersection between the elliptic cylinder $9{x}^{2}+2(y-1)^{2}=18$ and the plane $z=1$ onto the $xy$-plane is an ellipse. What are the lengths of the semi-axes of the ellipse?" :question/worked-solution "To find the intersection of the cylinder and the plane $z=1,$ we substitute $z=1$ into the equation of the cylinder. However, since the equation has no (explicit) $z$ term, we get\n\n$$\n\\begin{aligned}9{x}^{2}+2(y-1)^{2} & =18 \\\\ \\frac{{x}^{2}}{2}+\\frac{(y-1)^{2}}{9} & =1 \\\\ \\frac{{x}^{2}}{(\\sqrt{2})^{2}}+\\frac{(y-1)^{2}}{(3)^{2}} & =1.\\end{aligned}\n$$\n\nThis gives us the equation of an ellipse with semi-axes of lengths $\\sqrt{2}$ and $3.$"}]}
