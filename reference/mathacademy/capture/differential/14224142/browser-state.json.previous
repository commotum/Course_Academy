      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14224142/observations/step-q159642-e27344e4b554f17b694d.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14224142/observations/step-q159642-e27344e4b554f17b694d.png",
      "source_url": "https://mathacademy.com/tasks/14224142/topics/3298/review",
      "captured_at": 1792042229.163994,
      "math_academy_id": "q-159642",
      "topic_id": "3298",
      "sequence_position": null,
