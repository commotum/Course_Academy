      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14224142/observations/step-q159641-59ccea9ba92fadbf82d1.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14224142/observations/step-q159641-59ccea9ba92fadbf82d1.png",
      "source_url": "https://mathacademy.com/tasks/14224142/topics/3298/review",
      "captured_at": 1792042206.9483,
      "math_academy_id": "q-159641",
      "topic_id": "3298",
      "sequence_position": null,
      "source_step": {
