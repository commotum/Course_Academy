      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14198769/observations/step-q344087-4e159c8f76db7e92e93f.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14198769/observations/step-q344087-4e159c8f76db7e92e93f.png",
      "source_url": "https://mathacademy.com/tasks/14198769/topics/3775/lesson",
      "captured_at": 1791968491.134378,
      "math_academy_id": "q-344087",
