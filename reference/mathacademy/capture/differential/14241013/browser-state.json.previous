mn></mfrac></mstyle><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mo>+</mo><mn>10</mn><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>4</mn><mn>9</mn></mfrac></mstyle><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mo>+</mo><mn>20</mn><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>3</mn><mn>9</mn></mfrac></mstyle><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>10</mn><mn>9</mn></mfrac></mstyle><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>40</mn><mn>9</mn></mfrac></mstyle><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>60</mn><mn>9</mn></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>10</mn><mo>+</mo><mn>40</mn><mo>+</mo><mn>60</mn></mrow><mn>9</mn></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>110</mn><mn>9</mn></mfrac></mstyle><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
