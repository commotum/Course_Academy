#{[{:activity/expected-seconds 960.0 :activity/first-step {:db/id #edb/ref 17592186084191} :activity/id #uuid "e40e1898-52bd-590d-8c30-6678bae371ba" :activity/scope {:db/id #edb/ref 17592186048317 :topic/id #uuid "9438800f-fe1e-5478-b0c5-e3b869cf359e" :topic/math-academy-id 730} :activity/steps [{:db/id #edb/ref 17592186084191 :step/content {:db/id #edb/ref 17592186084464 :tutorial/content "The **expected value** (also known as the **expectation** or **mean**) of a discrete random variable is the average value we'd expect to get if we observed the random variable many times.\n\nFor a discrete random variable $X$ with probability mass function $f(x)$ defined over a set $S,$ we can calculate the expected value using the following formula:\n\n$$\n\\textrm E[X] = \\sum\\limits_{x \\in S} x \\cdot f(x)\n$$\n\nIn other words, the expected value is the sum of products of each value of $X$ and its associated probability, taken over all possible values of $X.$" :tutorial/id #uuid "e1cdabf3-eea2-5288-b192-5ba380e68539" :tutorial/math-academy-id 3849 :tutorial/title "Introduction"} :step/id #uuid "dc31fde7-31d0-506e-8116-119fcccac42d" :step/math-academy-id 22375 :step/next {:db/id #edb/ref 17592186084192}} {:db/id #edb/ref 17592186084192 :step/content {:db/id #edb/ref 17592186083272 :knowledge-point/canonical-example {:db/id #edb/ref 17592186083065 :question/id #uuid "27a80de6-49d0-557b-8444-ebab046e795b" :question/math-academy-id "e-6074"} :knowledge-point/id #uuid "332fefd8-7de7-5a84-81e2-a2aa97be9b73" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048368}] :knowledge-point/questions [{:db/id #edb/ref 17592186083820} {:db/id #edb/ref 17592186083943} {:db/id #edb/ref 17592186262652} {:db/id #edb/ref 17592186311726} {:db/id #edb/ref 17592186311727} {:db/id #edb/ref 17592186311736} {:db/id #edb/ref 17592186332941} {:db/id #edb/ref 17592186332942} {:db/id #edb/ref 17592186357383} {:db/id #edb/ref 17592186357384} {:db/id #edb/ref 17592186400303} {:db/id #edb/ref 175