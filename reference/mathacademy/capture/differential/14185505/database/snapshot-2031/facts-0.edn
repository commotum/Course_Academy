45417] [17592186427622 #edb/ref 1075 #edb/ref 17592186427602 #edb/ref 17592186045417] [17592186427622 #edb/ref 1075 #edb/ref 17592186427603 #edb/ref 17592186045417] [17592186427622 #edb/ref 1075 #edb/ref 17592186427609 #edb/ref 17592186045417] [17592186427622 #edb/ref 1075 #edb/ref 17592186427615 #edb/ref 17592186045417] [17592186427622 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186427622 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186427622 #edb/ref 1078 #edb/ref 17592186427594 #edb/ref 17592186045417] [17592186427622 #edb/ref 1079 #uuid "35ea2e92-a991-5ad0-b8a0-bbf114233843" #edb/ref 17592186045417] [17592186427623 #edb/ref 1075 #edb/ref 17592186427597 #edb/ref 17592186045417] [17592186427623 #edb/ref 1075 #edb/ref 17592186427598 #edb/ref 17592186045417] [17592186427623 #edb/ref 1075 #edb/ref 17592186427607 #edb/ref 17592186045417] [17592186427623 #edb/ref 1075 #edb/ref 17592186427612 #edb/ref 17592186045417] [17592186427623 #edb/ref 1075 #edb/ref 17592186427618 #edb/ref 17592186045417] [17592186427623 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186427623 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186427623 #edb/ref 1078 #edb/ref 17592186427618 #edb/ref 17592186045417] [17592186427623 #edb/ref 1079 #uuid "fc244713-be51-5b8e-ae8f-e2996c1041c8" #edb/ref 17592186045417] [17592186427625 #edb/ref 1068 #edb/ref 17592186427619 #edb/ref 17592186045417] [17592186427625 #edb/ref 1069 "q-143477" #edb/ref 17592186045417] [17592186427625 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186427625 #edb/ref 1071 "Let ${X}_{1},{X}_{2},…,{X}_{80}$ be a random sample of size $n=80$ from a population with a population mean $\\mu =150$ and population standard deviation $\\sigma =40.$ Find an approximation for the probability that the sample mean is between $140$ and $148.$\n\n*Hint: Two tables of values of $Φ(z)$ for different values of $z$ are given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n<table align=\"center\">\n<tbody><tr>\n<th>\n<table align=\"center\" cellpadding=\"5\" rules=\"all\">\n<tbody><tr> <th align=\"center\" bgcolor=\"#D6EAF8\" width=\"25%\">$z$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.03\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.04\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.05\\,$</th>\n</tr><tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-2.3\\,$</th><td align=\"center\"> $\\,0.0099\\,$ </td><td align=\"center\"> $\\,0.0096\\,$ </td><td align=\"center\"> $\\,0.0094\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-2.2\\,$</th><td align=\"center\"> $\\,0.0129\\,$ </td><td align=\"center\"> $\\,0.0125\\,$ </td><td align=\"center\"> $\\,0.0122\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-2.1\\,$</th><td align=\"center\"> $\\,0.0166\\,$ </td><td align=\"center\"> $\\,0.0162\\,$ </td><td align=\"center\"> $\\,0.0158\\,$ </td></tr>\n</tbody></table>\n<p></p></th>\n<th width=\"5%\"></th>\n<th>\n<table align=\"center\" cellpadding=\"5\" rules=\"all\">\n<tbody><tr> <th align=\"center\" bgcolor=\"#D6EAF8\" width=\"25%\">$z$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.04\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.05\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.06\\,$</th>\n</tr><tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-0.4\\,$</th><td align=\"center\"> $\\,0.3300\\,$ </td><td align=\"center\"> $\\,0.3264\\,$ </td><td align=\"center\"> $\\,0.3228\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-0.3\\,$</th><td align=\"center\"> $\\,0.3669\\,$ </td><td align=\"center\"> $\\,0.3632\\,$ </td><td align=\"center\"> $\\,0.3594\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-0.2\\,$</th><td align=\"center\"> $\\,0.4052\\,$ </td><td align=\"center\"> $\\,0.4013\\,$ </td><td align=\"center\"> $\\,0.3974\\,$ </td></tr>\n</tbody></table>\n<p></p></th>\n</tr>\n</tbody></table>" #edb/ref 17592186045417] [17592186427625 #edb/ref 1072 #uuid "2018fd9e-8c42-521e-ad4e-587cc76c6390" #edb/ref 17592186045417] [17592186427625 #edb/ref 1074 "Suppose that ${X}_{1},{X}_{2},…,{X}_{n}$ is a random sample of size $n$ from a population with a population mean $\\mu $ and population standard deviation $\\sigma .$ The central limit theorem (or CLT) states that for sufficiently large $n,$ the distribution of the sample mean $\\overset{―}{X}$ can be approximated as \n\n$$\n\\overset{―}{X}∼N\\,(\\mu ,\\frac{{\\sigma }^{2}}{n}).\n$$\n\nIn our case, we have\n\n$$\nn=80,\\,\\mu =150,\\,\\sigma =40.\n$$\n\nTherefore, by the CLT, we have that the distribution of the sample mean can be approximated as\n\n$$\n\\begin{aligned}\\overset{―}{X} & ∼N\\,(\\mu ,\\frac{{\\sigma }^{2}}{n}) \\\\  & ∼N\\,(150,\\frac{{40}^{2}}{80}) \\\\  & ∼N(150,20).\\end{aligned}\n$$\n\nWe want to find $P(140<\\overset{―}{X}<148).$ So, we convert $\\overset{―}{X}$ to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(140<\\overset{―}{X}<148) & =P(\\frac{140-150}{\\sqrt{20}}<Z<\\frac{148-150}{\\sqrt{20}}) \\\\  & =P(-\\sqrt{5}<Z<-\\frac{1}{\\sqrt{5}}) \\\\  & ≈P(-2.24<Z<-0.45) \\\\  & =P(Z<-0.45)-P(Z<-2.24) \\\\  & =Φ(-0.45)-Φ(-2.24)\\end{aligned}\n$$\n\nFrom the tables, we have\n\n$$\n\\begin{aligned}Φ(-2.24)=0.0125, \\\\ Φ(-0.45)=0.3264.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(140<\\overset{―}{X}<148) & =Φ(-0.45)-Φ(-2.24) \\\\  & =0.3264-0.0125 \\\\  & =0.3139.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186427627 #edb/ref 1068 #edb/ref 17592186427622 #edb/ref 17592186045417] [17592186427627 #edb/ref 1069 "q-263597" #edb/ref 17592186045417] [17592186427627 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186427627 #edb/ref 1071 "Let ${X}_{1},{X}_{2},…,{X}_{30}$ be a random sample of size $n=30$ from a population with probability density function \n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{2}, & 0\\le x\\le 2, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nGiven that the population variance ${\\sigma }^{2}=0.33,$ calculate $P(\\overset{―}{X}<1.07).$\n\n*Hint: A table of values of $Φ(z)$ for different values of $z$ is given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $z$ | $\\,0.05\\,$ | $\\,0.06\\,$ | $\\,0.07\\,$ |\n| --- | --- | --- | --- |\n| $\\,0.5\\,$ | $\\,0.7088\\,$ | $\\,0.7123\\,$ | $\\,0.7157\\,$ |\n| $\\,0.6\\,$ | $\\,0.7422\\,$ | $\\,0.7454\\,$ | $\\,0.7486\\,$ |\n| $\\,0.7\\,$ | $\\,0.7734\\,$ | $\\,0.7764\\,$ | $\\,0.7794\\,$ |" #edb/ref 17592186045417] [17592186427627 #edb/ref 1072 #uuid "cf3d34cb-ae06-547f-b3ac-ac68c79a89fb" #edb/ref 17592186045417] [17592186427627 #edb/ref 1074 "Suppose that ${X}_{1},{X}_{2},…,{X}_{n}$ is a random sample of size $n$ from a population with population mean $\\mu $ and population standard deviation $\\sigma .$ The central limit theorem (or CLT) states that for sufficiently large $n,$ the distribution of the sample mean $\\overset{―}{X}$ can be approximated as \n\n$$\n\\overset{―}{X}∼N\\,(\\mu ,\\frac{{\\sigma }^{2}}{n}).\n$$\n\nIn our case:\n\n- the sample size is\n\n$$\n\\begin{aligned}n & =30,\\end{aligned}\n$$\n\n- the population mean is\n\n$$\n\\begin{aligned}\\mu  & =\\text{E}[X] \\\\  & ={\\int }_{-\\infty }^{\\infty }x\\,f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}x\\cdot \\frac{1}{2}\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}\\frac{x}{2}\\,\\text{d}x \\\\  & ={[\\frac{{x}^{2}}{4}]}_{0}^{2} \\\\  & =\\frac{4}{4}-0 \\\\  & =1,\\end{aligned}\n$$\n\n- the population variance is ${\\sigma }^{2}=0.33.$\n\nTherefore, by the CLT, we have that the distribution of the sample mean can be approximated as\n\n$$\n\\begin{aligned}\\overset{―}{X} & ∼N\\,(\\mu ,\\frac{{\\sigma }^{2}}{n}) \\\\  & ∼N\\,(1,\\frac{0.33}{30}) \\\\  & ∼N(1,0.011).\\end{aligned}\n$$\n\nWe want to find $P(\\overset{―}{X}<1.07).$ So, we convert $\\overset{―}{X}$ to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(\\overset{―}{X}<1.07) & =P(Z<\\frac{1.07-1}{\\sqrt{0.011}}) \\\\  & ≈P(Z<0.67) \\\\  & =Φ(0.67)\\end{aligned}\n$$\n\nFrom the table, we have\n\n$$\nΦ(0.67)=0.7486.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(\\overset{―}{X}<1.07) & =Φ(1.07) \\\\  & =0.7486.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186427628 #edb/ref 1068 #edb/ref 17592186427623 #edb/ref 17592186045417] [17592186427628 #edb/ref 1069 "q-143520" #edb/ref 17592186045417] [17592186427628 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186427628 #edb/ref 1071 "| $x$ | $0$ | $2$ | $4$ | $6$ |\n| --- | --- | --- | --- | --- |\n| $f(x)$ | $0.25$ | $0.3$ | $0.25$ | $0.2$ |\n\nLet ${X}_{1},{X}_{2},…,{X}_{96}$ be a random sample of size $n=96$ from a population with the probability mass function given above.  Find an approximation for the probability that the sample mean is greater than $3.$\n\n*Hint: Two tables of values of $Φ(z)$ for different values of $z$ are given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution. * \n\n| $z$ | $\\,0.00\\,$ | $\\,0.01\\,$ | $\\,0.02\\,$ | $\\,0.03\\,$ | $\\,0.04\\,$ |\n| --- | --- | --- | --- | --- | --- |\n| $\\,0.7\\,$ | $\\,0.7580\\,$ | $\\,0.7611\\,$ | $\\,0.7642\\,$ | $\\,0.7673\\,$ | $\\,0.7704\\,$ |\n| $\\,0.8\\,$ | $\\,0.7881\\,$ | $\\,0.7910\\,$ | $\\,0.7939\\,$ | $\\,0.7967\\,$ | $\\,0.7995\\,$ |\n| $\\,0.9\\,$ | $\\,0.8159\\,$ | $\\,0.8186\\,$ | $\\,0.8212\\,$ | $\\,0.8238\\,$ | $\\,0.8264\\,$ |" #edb/ref 17592186045417] [17592186427628 #edb/ref 1072 #uuid "fb6b8004-feea-510b-a748-e31da1b3ac36" #edb/ref 17592186045417] [17592186427628 #edb/ref 1074 "Suppose that ${X}_{1},{X}_{2},…,{X}_{n}$ is a random sample of size $n$ from a population with population mean $\\mu $ and population standard deviation $\\sigma .$ The central limit theorem (or CLT) states that for sufficiently large $n,$ the distribution of the sample mean $\\overset{―}{X}$ can be approximated as \n\n$$\n\\overset{―}{X}∼N\\,(\\mu ,\\frac{{\\sigma }^{2}}{n}).\n$$\n\nIn our case:\n\n- the sample size is \n\n$$\nn=96,\n$$\n\n- the population mean is\n\n$$\n\\begin{aligned}\\mu  & =\\text{E}[X] \\\\  & ={\\sum }_{i=1}^{n}{x}_{i}f({x}_{i}) \\\\  & =0\\cdot 0.25+2\\cdot 0.3+4\\cdot 0.25+6\\cdot 0.2 \\\\  & =0+0.6+1+1.2 \\\\  & =2.8,\\end{aligned}\n$$\n\n- the population variance is\n\n$$\n\\begin{aligned}{\\sigma }^{2} & =\\text{Var}[X] \\\\  & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =({0}^{2}\\cdot 0.25+{2}^{2}\\cdot 0.3+{4}^{2}\\cdot 0.25+{6}^{2}\\cdot 0.2)-{2.8}^{2} \\\\  & =(0+1.2+4+7.2)-7.84 \\\\  & =4.56.\\end{aligned}\n$$\n\nTherefore, by the CLT, we have that the distribution of the sample mean can be approximated as\n\n$$\n\\begin{aligned}\\overset{―}{X} & ∼N\\,(\\mu ,\\frac{{\\sigma }^{2}}{n}) \\\\  & ∼N\\,(2.8,\\frac{4.56}{96}) \\\\  & ∼N(2.8,0.0475).\\end{aligned}\n$$\n\nWe want to find $P(\\overset{―}{X}>3).$ So, we convert $\\overset{―}{X}$ to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(\\overset{―}{X}>3) & ≈P(Z>\\frac{3-2.8}{\\sqrt{0.0475}}) \\\\  & =P(Z>0.92) \\\\  & =1-P(Z<0.92) \\\\  & =1-Φ(0.92).\\end{aligned}\n$$\n\nFrom the table, we have\n\n$$\n\\begin{aligned}Φ(0.92)=0.8212.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(\\overset{―}{X}>3) & =1-Φ(0.92) \\\\  & =1-0.8212 \\\\  & =0.1788.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186441357 #edb/ref 1043 #edb/ref 17592186441386 #edb/ref 17592186045417] [17592186441357 #edb/ref 1043 #edb/ref 17592186441387 #edb/ref 17592186045417] [17592186441357 #edb/ref 1043 #edb/ref 17592186441388 #edb/ref 17592186045417] [17592186441357 #edb/ref 1043 #edb/ref 17592186441389 #edb/ref 17592186045417] [17592186441357 #edb/ref 1043 #edb/ref 17592186441390 #edb/ref 17592186045417] [17592186441357 #edb/ref 1044 #edb/ref 17592186045464 #edb/ref 17592186045417] [17592186441357 #edb/ref 1045 "The Central Limit Theorem" #edb/ref 17592186045