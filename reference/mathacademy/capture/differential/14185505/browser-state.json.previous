c2E\"></mjx-c></mjx-mo><mjx-tstrut></mjx-tstrut></mjx-mtd></mjx-mtr></mjx-itable></mjx-table></mjx-mtable></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mtable displaystyle=\"true\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"0.8em 0.8em 0.8em 0.8em 0.3em\"><mtr><mtd><msup><mi>σ</mi><mn>2</mn></msup></mtd><mtd><mi></mi><mo>=</mo><mtext>Var</mtext><mo stretchy=\"false\">[</mo><mi>X</mi><mo stretchy=\"false\">]</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mtext>E</mtext><mo stretchy=\"false\">[</mo><msup><mi>X</mi><mn>2</mn></msup><mo stretchy=\"false\">]</mo><mo>−</mo><mtext>E</mtext><mo stretchy=\"false\">[</mo><mi>X</mi><msup><mo stretchy=\"false\">]</mo><mn>2</mn></msup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"1.2em\" maxsize=\"1.2em\">(</mo></mrow><msup><mn>0</mn><mn>2</mn></msup><mo>⋅</mo><mn>0.25</mn><mo>+</mo><msup><mn>2</mn><mn>2</mn></msup><mo>⋅</mo><mn>0.3</mn><mo>+</mo><msup><mn>4</mn><mn>2</mn></msup><mo>⋅</mo><mn>0.25</mn><mo>+</mo><msup><mn>6</mn><mn>2</mn></msup><mo>⋅</mo><mn>0.2</mn><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"1.2em\" maxsize=\"1.2em\">)</mo></mrow><mo>−</mo><msup><mn>2.8</mn><mn>2</mn></msup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"1.2em\" maxsize=\"1.2em\">(</mo></mrow><mn>0</mn><mo>+</mo><mn>1.2</mn><mo>+</mo><mn>4</mn><mo>+</mo><mn>7.2</mn><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"1.2em\" maxsize=\"1.2em\">)</mo></mrow><mo>−</mo><mn>7.84</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>4.56</mn><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</li>\n</ul>\n<p>Therefore, by the CLT, we have that the distribution of the sample mean can be approximated as</p>\n<p><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" display=\"true\" tabindex=\"