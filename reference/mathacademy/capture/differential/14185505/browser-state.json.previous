      "assets": [],
      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14185505/observations/step-q143513-a67f043472fad90291c9.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14185505/observations/step-q143513-a67f043472fad90291c9.png",
      "source_url": "https://mathacademy.com/tasks/14185505/topics/359/lesson",
      "captured_at": 1791921157.6671836,
      "math_academy_id": "q-143513",
