0 #edb/ref 17592186045417] [17592186198436 #edb/ref 1038 #edb/ref 17592186284531 #edb/ref 17592186045417] [17592186198436 #edb/ref 1038 #edb/ref 17592186367901 #edb/ref 17592186045417] [17592186198436 #edb/ref 1038 #edb/ref 17592186367908 #edb/ref 17592186045417] [17592186198436 #edb/ref 1038 #edb/ref 17592186432371 #edb/ref 17592186045417] [17592186198436 #edb/ref 1038 #edb/ref 17592186432373 #edb/ref 17592186045417] [17592186198436 #edb/ref 1039 "Approximating a Multivariable Function at a Point Using a Quadratic Taylor Polynomial" #edb/ref 17592186045417] [17592186198436 #edb/ref 1041 #edb/ref 17592186198078 #edb/ref 17592186045417] [17592186198436 #edb/ref 1042 #uuid "b19cc766-bdc5-5ab2-aa4d-ebddf8311116" #edb/ref 17592186045417] [17592186198498 #edb/ref 1043 #edb/ref 17592186199372 #edb/ref 17592186045417] [17592186198498 #edb/ref 1043 #edb/ref 17592186199373 #edb/ref 17592186045417] [17592186198498 #edb/ref 1043 #edb/ref 17592186199374 #edb/ref 17592186045417] [17592186198498 #edb/ref 1043 #edb/ref 17592186199375 #edb/ref 17592186045417] [17592186198498 #edb/ref 1043 #edb/ref 17592186199376 #edb/ref 17592186045417] [17592186198498 #edb/ref 1043 #edb/ref 17592186199377 #edb/ref 17592186045417] [17592186198498 #edb/ref 1043 #edb/ref 17592186199378 #edb/ref 17592186045417] [17592186198498 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186198498 #edb/ref 1045 "Second-Degree Taylor Polynomials of Multivariable Functions" #edb/ref 17592186045417] [17592186198498 #edb/ref 1046 #edb/ref 17592186199372 #edb/ref 17592186045417] [17592186198498 #edb/ref 1049 #edb/ref 17592186048786 #edb/ref 17592186045417] [17592186198498 #edb/ref 1050 1260.0 #edb/ref 17592186045417] [17592186198498 #edb/ref 1053 #uuid "c6311230-e135-5677-8edf-6ab9b7341bf2" #edb/ref 17592186045417] [17592186198645 #edb/ref 1068 #edb/ref 17592186281146 #edb/ref 17592186045417] [17592186198645 #edb/ref 1069 "q-162992" #edb/ref 17592186045417] [17592186198645 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186198645 #edb/ref 1071 "For the function of two variables \n$f(x,y)={e}^{x-2y},$\nthe quadratic Taylor polynomial of $f$ about $(0,0)$ is given by\n\n$$\nf(x,y)=1+x+a\\,y+\\frac{1}{2}{x}^{2}+bxy+c{y}^{2}.\n$$\n\nFind the value of $a+b+c.$" #edb/ref 17592186045417] [17592186198645 #edb/ref 1072 #uuid "3a23d317-8ce9-5c6e-8d7d-b18f5386617b" #edb/ref 17592186045417] [17592186198645 #edb/ref 1074 "If the function $f(x,y)$ is twice differentiable at $(x,y)=(0,0),$ then the quadratic Taylor polynomial of $f$ about $(0,0)$ is given by\n\n$$\n\\begin{aligned}f(x,y) & ≈\\overset{\\text{Linear approximation}}{\\overset{⏞}{f(0,0)+{f}_{x}(0,0)\\cdot x+{f}_{y}(0,0)\\cdot y}} \\\\  & \\,\\,+{{\\frac{1}{2}({f}_{xx}(0,0)\\cdot {x}^{2}+2{f}_{xy}(0,0)\\cdot xy+{f}_{yy}(0,0)\\cdot {y}^{2})}_{⏟}}_{\\text{Quadratic part}}.\\end{aligned}\n$$\n\nNow, we compute the terms of our Taylor polynomial.\n\n- Calculating the value of the function, we have\n\n$$\n\\begin{aligned}f(0,0) & =1.\\end{aligned}\n$$\n\n- Calculating the first derivatives, we have the following:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & ={e}^{x-2y}, & \\,{f}_{y}(x,y) & =-2{e}^{x-2y} \\\\ {f}_{x}(0,0) & =1, & \\,{f}_{y}(0,0) & =-2\\end{aligned}\n$$\n\n- Calculating the second derivatives, we have the following:\n\n$$\n\\begin{aligned}{f}_{xx}(x,y) & ={e}^{x-2y}, & \\,{f}_{xx}(0,0) & =1 \\\\ {f}_{xy}(x,y) & =-2{e}^{x-2y}, & \\,{f}_{xy}(0,0) & =-2 \\\\ {f}_{yy}(x,y) & =4{e}^{x-2y}, & \\,{f}_{yy}(0,0) & =4\\end{aligned}\n$$\n\nTherefore, the second-degree Taylor polynomial is given by\n\n$$\n\\begin{aligned}f(x,y) & ≈1+1\\cdot x+(-2)\\cdot y+\\frac{1}{2}(1\\cdot {x}^{2}+2(-2)\\cdot xy+4\\cdot {y}^{2}) \\\\  & =1+x+(-2)y+\\frac{1}{2}{x}^{2}+(-2)xy+2{y}^{2}.\\end{aligned}\n$$\n\nFinally,\n\n$$\na+b+c=(-2)+(-2)+2=-2.\n$$" #edb/ref 17592186045417] [17592186198679 #edb/ref 1068 #edb/ref 17592186194705 #edb/ref 17592186045417] [17592186198679 #edb/ref 1068 #edb/ref 17592186367895 #edb/ref 17592186045417] [17592186198679 #edb/ref 1069 "q-164809" #edb/ref 17592186045417] [17592186198679 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186198679 #edb/ref 1071 "For the twice-differentiable function $f:{R}^{3}\\to R,$ we have the following data:\n\n$$\n\\begin{aligned}f(1,0,1) & =2, & \\,{f}^{′}(1,0,1) & =\\begin{bmatrix}2 & 0 & 1\\end{bmatrix}, & \\,{f}^{″}(1,0,1) & =\\begin{bmatrix}2 & 1 & -1 \\\\ 1 & 0 & 0 \\\\ -1 & 0 & 1\\end{bmatrix}\\end{aligned}\n$$\n\nUse the quadratic Taylor polynomial of $f$ about $a=\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}$ to approximate the value of $f(0,1,1).$" #edb/ref 17592186045443] [17592186198679 #edb/ref 1072 #uuid "7fcb7ddf-9df6-5eb3-88f6-02683fa452c3" #edb/ref 17592186045417] [17592186198679 #edb/ref 1074 "Suppose that the function $f:{R}^{n}\\to R$ is defined by \n\n$$\nf:\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{bmatrix}⟶z\n$$\n\n \n\nand is twice differentiable at $x=a.$ Then, the quadratic Taylor polynomial of $f$ about $a$ is given by\n\n$$\n\\begin{aligned}f(x) & ≈f(a)+{f}^{′}(a)(x-a)+\\frac{1}{2}(x-a)^{T}{f}^{″}(a)(x-a),\\end{aligned}\n$$\n\nwhere\n\n$$\n{f}^{′}(a)={\\begin{bmatrix}\\frac{∂f}{∂{x}_{1}} & \\frac{∂f}{∂{x}_{2}} & ⋯ & \\frac{∂f}{∂{x}_{n}}\\end{bmatrix}|}_{x=a}\n$$\n\nand\n\n$$\n{f}^{″}(a)={\\begin{bmatrix}\\frac{{∂}^{2}f}{∂{x}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{n}} \\\\ \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{2}^{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{n}^{2}}\\end{bmatrix}}_{x=a}\n$$\n\nIn this case, we have $a=\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix},$ and the following data:\n\n$$\n\\begin{aligned}f(a) & =2, & \\,{f}^{′}(a) & =\\begin{bmatrix}2 & 0 & 1\\end{bmatrix}, & \\,{f}^{″}(a) & =\\begin{bmatrix}2 & 1 & -1 \\\\ 1 & 0 & 0 \\\\ -1 & 0 & 1\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, the second-degree Taylor polynomial is given by\n\n$$\nf(x)≈2+\\begin{bmatrix}2 & 0 & 1\\end{bmatrix}\\begin{bmatrix}x-1 \\\\ y \\\\ z-1\\end{bmatrix}+\\frac{1}{2}{\\begin{bmatrix}x-1 \\\\ y \\\\ z-1\\end{bmatrix}}^{T}\\begin{bmatrix}2 & 1 & -1 \\\\ 1 & 0 & 0 \\\\ -1 & 0 & 1\\end{bmatrix}\\begin{bmatrix}x-1 \\\\ y \\\\ z-1\\end{bmatrix}\n$$\n\nFinally, evaluating the polynomial at $x=\\begin{bmatrix}0 \\\\ 1 \\\\ 1\\end{bmatrix},$ we obtain\n\n$$\n\\begin{aligned}f(0,1,1) & ≈2+\\begin{bmatrix}2 & 0 & 1\\end{bmatrix}\\begin{bmatrix}0-1 \\\\ 1 \\\\ 1-1\\end{bmatrix}+\\frac{1}{2}{\\begin{bmatrix}0-1 \\\\ 1 \\\\ 1-1\\end{bmatrix}}^{T}\\begin{bmatrix}2 & 1 & -1 \\\\ 1 & 0 & 0 \\\\ -1 & 0 & 1\\end{bmatrix}\\begin{bmatrix}0-1 \\\\ 1 \\\\ 1-1\\end{bmatrix} \\\\  & =2+\\begin{bmatrix}2 & 0 & 1\\end{bmatrix}\\begin{bmatrix}-1 \\\\ 1 \\\\ 0\\end{bmatrix}+\\frac{1}{2}{\\begin{bmatrix}-1 \\\\ 1 \\\\ 0\\end{bmatrix}}^{T}\\begin{bmatrix}2 & 1 & -1 \\\\ 1 & 0 & 0 \\\\ -1 & 0 & 1\\end{bmatrix}\\begin{bmatrix}-1 \\\\ 1 \\\\ 0\\end{bmatrix} \\\\  & =2+(-2)+\\frac{1}{2}\\begin{bmatrix}-1 & 1 & 0\\end{bmatrix}\\begin{bmatrix}-1 \\\\ -1 \\\\ 1\\end{bmatrix} \\\\  & =\\frac{1}{2}(0) \\\\  & =0.\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186199372 #edb/ref 1058 #edb/ref 17592186199373 #edb/ref 17592186045417] [17592186199372 #edb/ref 1061 45308 #edb/ref 17592186045417] [17592186199372 #edb/ref 1062 #uuid "0b4dea87-c57c-5435-9e3b-1027840f045c" #edb/ref 17592186045417] [17592186199372 #edb/ref 1063 #edb/ref 17592186199501 #edb/ref 17592186045417] [17592186199373 #edb/ref 1058 #edb/ref 17592186199374 #edb/ref 17592186045417] [17592186199373 #edb/ref 1061 45309 #edb/ref 17592186045417] [17592186199373 #edb/ref 1062 #uuid "b898729c-517e-588b-8fc2-30ad336c09b1" #edb/ref 17592186045417] [17592186199373 #edb/ref 1063 #edb/ref 17592186198434 #edb/ref 17592186045417] [17592186199374 #edb/ref 1058 #edb/ref 17592186199375 #edb/ref 17592186045417] [17592186199374 #edb/ref 1061 45312 #edb/ref 17592186045417] [17592186199374 #edb/ref 1062 #uuid "3baad2a8-726c-5a26-b651-c058c266b286" #edb/ref 17592186045417] [17592186199374 #edb/ref 1063 #edb/ref 17592186199502 #edb/ref 17592186045417] [17592186199375 #edb/ref 1058 #edb/ref 17592186199376 #edb/ref 17592186045417] [17592186199375 #edb/ref 1061 45313 #edb/ref 17592186045417] [17592186199375 #edb/ref 1062 #uuid "3af1e2e0-59c9-5db1-ae9b-2ec6c9cd91fb" #edb/ref 17592186045417] [17592186199375 #edb/ref 1063 #edb/ref 17592186199503 #edb/ref 17592186045417] [17592186199376 #edb/ref 1058 #edb/ref 17592186199378 #edb/ref 17592186045417] [17592186199376 #edb/ref 1061 45314 #edb/ref 17592186045417] [17592186199376 #edb/ref 1062 #uuid "37ed5f21-d5e5-5cba-a75e-2083bfa15f8a" #edb/ref 17592186045417] [17592186199376 #edb/ref 1063 #edb/ref 17592186198435 #edb/ref 17592186045417] [17592186199377 #edb/ref 1061 45339 #edb/ref 17592186045417] [17592186199377 #edb/ref 1062 #uuid "b64ce030-6e67-5cb0-926b-59488cada120" #edb/ref 17592186045417] [17592186199377 #edb/ref 1063 #edb/ref 17592186199504 #edb/ref 17592186045417] [17592186199378 #edb/ref 1058 #edb/ref 17592186199377 #edb/ref 17592186045417] [17592186199378 #edb/ref 1061 45340 #edb/ref 17592186045417] [17592186199378 #edb/ref 1062 #uuid "ac6cf855-2b6f-5681-9ea0-41408d0715ca" #edb/ref 17592186045417] [17592186199378 #edb/ref 1063 #edb/ref 17592186198436 #edb/ref 17592186045417] [17592186199501 #edb/ref 1064 "Recall that the quadratic Taylor polynomial of a function $f(x)$ at the point $x=a$ is given by\n\n$$\nf(x) \\approx  \\overbrace{f(a) + f'(a)(x-a)}^{\\text{Linear approximation}} + \\underbrace{\\dfrac{1}{2}f''(a)(x-a)^2}_{\\textrm{Quadratic part}}.\n$$\n\nWe can extend the concept of Taylor polynomials to multivariable functions. \n\nGiven a twice-differentiable function $f(x,y),$ the **quadratic Taylor polynomial** of $f$ about the point $(a,b)$ is given by \n\n$$\n\\begin{aligned}f(x,y) & ≈\\overset{\\text{Linear approximation}}{\\overset{⏞}{f(a,b)+{f}_{x}(a,b)\\cdot (x-a)+{f}_{y}(a,b)\\cdot (y-b)}} \\\\  & \\,\\,+{{\\frac{1}{2}({f}_{xx}(a,b)\\cdot (x-a)^{2}+2{f}_{xy}(a,b)\\cdot (x-a)(y-b)+{f}_{yy}(a,b)\\cdot (y-b)^{2})}_{⏟}}_{\\text{Quadratic part}}.\\end{aligned}\n$$\n\nIn particular, the quadratic Taylor polynomial of $f(x,y)$ about the origin $O$ is\n\n$$\n\\begin{aligned}f(x,y) & ≈f(0,0)+{f}_{x}(0,0)\\cdot x+{f}_{y}(0,0)\\cdot y \\\\  & \\,\\,+\\frac{1}{2}({f}_{xx}(0,0)\\cdot {x}^{2}+2{f}_{xy}(0,0)\\cdot xy+{f}_{yy}(0,0)\\cdot {y}^{2}).\\end{aligned}\n$$\n\nLater in the lesson, we will develop some intuition for why the quadratic part looks the way it does. But before we do that, let's get some practice working with this formula." #edb/ref 17592186045417] [17592186199501 #edb/ref 1065 7846 #edb/ref 17592186045417] [17592186199501 #edb/ref 1066 #uuid "31dda75b-f239-5680-b7b4-0dce1ba5e51f" #edb/ref 17592186045417] [17592186199501 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186199502 #edb/ref 1064 "It's possible to derive Taylor polynomials for functions of more than two variables. However, increasing the number of variables significantly increases the number of terms in the Taylor polynomial. \n\nIdeally, we'd like a compact expression for the quadratic Taylor polynomial that works for all twice-differentiable functions $f:\\mathbb R^n\\to\\mathbb R.$ This can be achieved using matrix notation. \n\nTo see how, let's consider the quadratic Taylor polynomial of $f(x,y)$ about $(a,b){:}$\n\n$$\n\\begin{aligned}f(x,y) & ≈\\overset{\\text{Linear approximation}}{\\overset{⏞}{f(a,b)+{f}_{x}(a,b)\\cdot (x-a)+{f}_{y}(a,b)\\cdot (y-b)}} \\\\  & \\,\\,+{{\\frac{1}{2}({f}_{xx}(a,b)\\cdot (x-a)^{2}+2{f}_{xy}(a,b)\\cdot (x-a)(y-b)+{f}_{yy}(a,b)\\cdot (y-b)^{2})}_{⏟}}_{\\text{Quadratic part}}.\\end{aligned}\n$$\n\nIf we denote ![](images/6f/6fe1832d2f4ae2b36446386e5d0ec7c41f898f4e575af9238695c37f7c427250.svg) and ![](images/49/496eacb98651e3fab4c0d0a7b44ab283fadad1c07243da485aeb0c4a059d5712.svg) then the total derivative of $f(x,y)=f(\\mathbf{x})$ at $(a,b)=\\mathbf{a}$ is given by\n\n![](images/d6/d696700e295d9f43111ac53602b936a991b7766af654cedaa5afdae21b088a59.svg)\n\nWith that in mind, we can rewrite the linear part of the approximation as follows:\n\n$$\n\\begin{aligned}\\text{Linear approximation} & =f(a,b)+{f}_{x}(a,b)\\cdot (x-a)+{f}_{y}(a,b)\\cdot (y-b) \\\\  & =f(a)+\\begin{bmatrix}{f}_{x}(a,b) & {f}_{y}(a,b)\\end{bmatrix}\\cdot \\begin{bmatrix}x-a \\\\ y-b\\end{bmatrix} \\\\  & =f(a)+\\begin{bmatrix}{f}_{x}(a,b) & {f}_{y}(a,b)\\end{bmatrix}\\cdot (\\begin{bmatrix}x \\\\ y\\end{bmatrix}-\\begin{bmatrix}a \\\\ b\\end{bmatrix}) \\\\  & =f(a)+{f}^{′}(a)(x-a)\\end{aligned}\n$$\n\nNotice that this is just our usual linear approximation of a function $f.$\n\nThe second derivative of $f$ at $\\mathbf x = \\mathbf a$ is given by\n\n![](images/de/de2a75a6681e1e393b21b60de9d7aeee748a8e6d04010ab713b40f0f41f239cf.svg)\n\nTherefore, using the fact that $f_{xy} = f_{yx},$ we can rewrite the quadratic part of the approximation using matrix multiplication as follows:\n\n$$\n\\begin{aligned}\\text{Quadratic part} & =\\frac{1}{2}({f}_{xx}(a,b)\\cdot (x-a)^{2}+2{f}_{xy}(a,b)\\cdot (x-a)(y-b)+{f}_{yy}(a,b)\\cdot (y-b)^{2}) \\\\  & =\\frac{1}{2}\\begin{bmatrix}x-a & y-b\\end{bmatrix}\\cdot \\begin{bmatrix}{f}_{xx}(a) & {f}_{xy}(a) \\\\ {f}_{yx}(a) & {f}_{yy}(a)\\end{bmatrix}\\cdot \\begin{bmatrix}x-a \\\\ y-b\\end{bmatrix} \\\\  & =\\frac{1}{2}(\\begin{bmatrix}x & y\\end{bmatrix}-\\begin{bmatrix}a & b\\end{bmatrix})\\cdot \\begin{bmatrix}{f}_{xx}(a) & {f}_{xy}(a) \\\\ {f}_{yx}(a) & {f}_{yy}(a)\\end{bmatrix}\\cdot (\\begin{bmatrix}x \\\\ y\\end{bmatrix}-\\begin{bmatrix}a \\\\ b\\end{bmatrix}) \\\\  & =\\frac{1}{2}(x-a)^{T}{f}^{″}(a)(x-a)\\end{aligned}\n$$\n\nTherefore, our quadratic Taylor polynomial can be written as \n\n$$\n\\begin{aligned}f(x) & ≈\\overset{\\text{Linear approximation}}{\\overset{⏞}{f(a)+{f}^{′}(a)(x-a)}}+{{\\frac{1}{2}(x-a)^{T}{f}^{″}(a)(x-a)}_{⏟}}_{\\text{Quadratic part}}.\\end{aligned}\n$$\n\nNotice that this formula is more compact and has clear similarity with the corresponding formula for functions with one variable:\n\n$$\nf(x) \\approx  \\overbrace{f(a) + f'(a)(x-a)}^{\\text{Linear approximation}} + \\underbrace{\\dfrac{1}{2}f''(a)(x-a)^2}_{\\textrm{Quadratic part}}\n$$" #edb/ref 17592186045443] [17592186199502 #edb/ref 1065 7847 #edb/ref 17592186045417] [17592186199502 #edb/ref 1066 #uuid "81df7b3f-d26d-54e0-baa0-de20a949b348" #edb/ref 17592186045417] [17592186199502 #edb/ref 1067 "The Quadratic Taylor Polynomial in Matrix Form" #edb/ref 17592186045417] [17592186199503 #edb/ref 1064 "The formula derived earlier works for multivariable functions with a finite number of variables. \n\nSuppose that the function $f:\\mathbb R^n\\to\\mathbb R$ is defined by \n\n![](images/2e/2eaa4da1b90a317a7570670566b2a81bb636701680d6a2ca2224b5ef60e80230.svg) \n\nand is twice differentiable at $\\mathbf x = \\mathbf a.$ Then, the quadratic Taylor approximation of $f$ about $\\mathbf a$ is given by\n\n$$\n\\begin{aligned}f(x) & ≈f(a)+{f}^{′}(a)(x-a)+\\frac{1}{2}(x-a)^{T}{f}^{″}(a)(x-a),\\end{aligned}\n$$\n\nwhere the first derivative is \n\n![](images/08/08b2f366456caf4c7c8db85d08a8494e50c3098f148eb9c9075da748801cb574.svg)\n\nand the second derivative is\n\n![](images/19/194e1d24c17ff07b1eb8e4036e13f30dee99cba17df11d5bada1a4d33d40b2a4.svg)" #edb/ref 17592186045417] [17592186199503 #edb/ref 1065 7848 #edb/ref 17592186045417] [17592186199503 #edb/ref 1066 #uuid "9075c096-fb26-52c7-ba1b-f03ecebd24e6" #edb/ref 17592186045417] [17592186199503 #edb/ref 1067 "General Formula For the Quadratic Taylor Polynomial in Matrix Form" #edb/ref 17592186045417] [17592186199504 #edb/ref 1064 "Here, we derive the formula for the second-degree Taylor polynomial of a multivariable function in vector form.\n\nSuppose that the function $f : \\mathbb{R}^n \\to \\mathbb{R}$ is defined by\n\n![](images/df/dfa82e503eeaa38943edddc7d6982cf4893c73fd2f6d075dd390f51cd0450091.svg)\n\nand is twice differentiable at $\\mathbf{x} = \\mathbf{a}.$\nBy restricting $\\mathbf x$ to a line through $\\mathbf{a},$ we can consider $f$ as a function of one variable. Then, we'll use the second-degree Taylor polynomial of a single-variable function to derive the formula.\n\nLet $\\mathbf{x}_0$ be a constant vector in $\\mathbb{R}^n.$ Then, the line through $\\mathbf{a}$ and $\\mathbf{x}_0$ is given by\n\n$$\n\\mathbf{x}(t) = \\mathbf{a} + t(\\mathbf{x}_0 - \\mathbf{a}), \\qquad t \\in (-\\infty, \\infty),\n$$\n\nwhere $\\mathbf{x}(0) = \\mathbf{a}$ and $\\mathbf{x}(1) = \\mathbf{x}_0.$\n\nNow, we define a function $F: \\mathbb{R} \\to \\mathbb{R}$ by restricting the domain of $f$ to this line:\n\n$$\nF(t)\n= f(\\mathbf{x}(t))\n%= f(\\mathbf{a} + t(\\mathbf{x}_0 - \\mathbf{a}))\n$$\n\nThe second-degree Taylor polynomial of this single-variable function about $t=0$ is given by\n\n$$\nF(t) \\approx F(0) + F'(0)t + \\dfrac12F''(0)t^2.\n$$\n\nWe can find the first derivative of $F$ using the chain rule:\n\n$$\n\\begin{aligned}\\frac{\\text{d}F}{\\text{d}t} & =\\frac{\\text{d}f}{\\text{d}x}\\cdot \\frac{\\text{d}x}{\\text{d}t} \\\\  & =\\frac{\\text{d}f}{\\text{d}x}\\cdot \\frac{\\text{d}}{\\text{d}t}(a+t({x}_{0}-a)) \\\\  & =\\frac{\\text{d}f}{\\text{d}x}\\cdot ({x}_{0}-a)\\end{aligned}\n$$\n\nSince $\\dfrac{\\textrm{d}f}{\\textrm{d}\\mathbf{x}}$ is a row vector and $(\\mathbf{x}_0 - \\mathbf{a})$ is a column vector, this is a scalar quantity and, hence, equal to its transpose:\n\n$$\n\\begin{aligned}\\frac{\\text{d}F}{\\text{d}t} & =\\frac{\\text{d}f}{\\text{d}x}\\cdot ({x}_{0}-a) \\\\  & ={(\\frac{\\text{d}f}{\\text{d}x}\\cdot ({x}_{0}-a))}^{T} \\\\  & =({x}_{0}-a)^{T}{(\\frac{\\text{d}f}{\\text{d}x})}^{T}\\end{aligned}\n$$\n\nWith this, we can find the second derivative of $F{:}$\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}F}{\\text{d}{t}^{2}} & =\\frac{\\text{d}}{\\text{d}t}(\\frac{\\text{d}F}{\\text{d}t}) \\\\  & =\\frac{\\text{d}}{\\text{d}t}(({x}_{0}-a)^{T}{(\\frac{\\text{d}f}{\\text{d}x})}^{T}) \\\\  & =({x}_{0}-a)^{T}\\frac{\\text{d}}{\\text{d}t}{(\\frac{\\text{d}f}{\\text{d}x})}^{T} \\\\  & =({x}_{0}-a)^{T}\\frac{\\text{d}}{\\text{d}x}{(\\frac{\\text{d}f}{\\text{d}x})}^{T}\\cdot \\frac{\\text{d}x}{\\text{d}t} \\\\  & =({x}_{0}-a)^{T}\\frac{{\\text{d}}^{2}f}{\\text{d}{x}^{2}}({x}_{0}-a)\\end{aligned}\n$$\n\nTherefore, the first and second derivatives are given by\n\n$$\n\\{\\begin{aligned}{F}^{′}(t)={f}^{′}(x(t))({x}_{0}-a) \\\\ {F}^{″}(t)=({x}_{0}-a)^{T}{f}^{″}(x(t))({x}_{0}-a).\\end{aligned}\n$$\n\nEvaluating the function and its derivatives at $t=0$ and using the fact that $\\mathbf{x}(0) = \\mathbf{a},$ we have\n\n![](images/ba/ba4825ec7e9bb46e08df09c8b46b941c36a69ffd6e72081d09cd1ef6134a54d8.svg)\n\nPutting these values into the second-degree Taylor polynomial of a single-variable function about $t=0,$ we get\n\n$$\n\\begin{aligned}F(t) & ≈F(0)+{F}^{′}(0)t+\\frac{1}{2}{F}^{″}(0){t}^{2} \\\\  & ≈f(a)+{f}^{′}(a)({x}_{0}-a)t+\\frac{1}{2}({x}_{0}-a)^{T}{f}^{″}(a)({x}_{0}-a){t}^{2}\\end{aligned}\n$$\n\nFinally, using this polynomial to approximate the value of $F(1),$ and the fact that $F(1) = f(\\mathbf{x}(1)) = f(\\mathbf{x}_0),$ we conclude that\n\n$$\n\\begin{aligned}F(1) & ≈f(a)+{f}^{′}(a)({x}_{0}-a)\\cdot 1+\\frac{1}{2}({x}_{0}-a)^{T}{f}^{″}(a)({x}_{0}-a)\\cdot {1}^{2} \\\\ f({x}_{0}) & ≈f(a)+{f}^{′}(a)({x}_{0}-a)+\\frac{1}{2}({x}_{0}-a)^{T}{f}^{″}(a)({x}_{0}-a).\\end{aligned}\n$$\n\nHowever, $\\mathbf{x}_0 \\in \\mathbb{R}^n$ is an arbitrary constant. Therefore, we can relax the assumption that $\\mathbf{x}_0$ is fixed and replace it with a general point $\\mathbf{x} \\in \\mathbb{R}^n$ near $\\mathbf{a}$ to obtain the formula for the second-degree Taylor polynomial of a multivariable function in vector form:\n\n$$\nf(\\mathbf{x}) \\approx f(\\mathbf{a}) + \\boldsymbol{f}'(\\mathbf{a})(\\mathbf{x} - \\mathbf{a}) + \\dfrac{1}{2} (\\mathbf{x} - \\mathbf{a})^T \\boldsymbol{f}''(\\mat