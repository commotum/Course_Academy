#{[{:db/id #edb/ref 17592186068457 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068857 :knowledge-point/id #uuid "d59ccd52-63db-5d28-b78b-2df7caf52ad0" :knowledge-point/title "Evaluating a Vector-Valued Function"}] :question/id #uuid "6eea01b2-bc2a-55a8-9bab-6789df00fc42" :question/math-academy-id "e-12450" :question/problem "Given that $\\mathbf r (t) = \\langle 6t, 2t^2-1\\rangle,$ calculate $\\mathbf r (3).$" :question/worked-solution "We substitute $t=3$ into our function, and we get\n\n$$\n\\begin{aligned}r(3) & =⟨6(3),\\,2(3)^{2}-1⟩ \\\\  & =⟨18,\\,17⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186068458 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068858 :knowledge-point/id #uuid "e520dc67-3b63-5ca7-959b-f642d85529d6" :knowledge-point/title "Finding the Magnitude of a Vector-Valued Function"}] :question/id #uuid "86e423e7-db4b-5fdf-a285-bded3bd8161e" :question/math-academy-id "e-12451" :question/problem "Find $\\left|\\mathbf r\\left(4\\right)\\right|$ given that $\\mathbf r(t)  = \\left\\langle 2-t, 2\\sqrt{t}, \\, t-1\\right\\rangle,$" :question/worked-solution "Evaluating the function at $t=4,$ we get\n\n$$\n\\begin{aligned}r(4) & =⟨2-4,\\,2\\sqrt{4},\\,4-1⟩ \\\\  & =⟨-2,\\,4,\\,3⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we obtain\n\n$$\n\\begin{aligned}|r(4)| & =\\sqrt{{(-2)}^{2}+{(4)}^{2}+{(3)}^{2}} \\\\  & =\\sqrt{4+16+9} \\\\  & =\\sqrt{29}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186068459 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068859 :knowledge-point/id #uuid "26571ec1-e645-5f07-ba4e-75c22558394a" :knowledge-point/title "Evaluating a Three-Component Vector-Valued Function"}] :question/id #uuid "ab3899d3-8838-57ad-8a17-b8ac2934c0f9" :question/math-academy-id "e-12452" :question/problem "Find the value of the vector function $\\mathbf f(t) = \\left\\langle \\cos t, \\: \\sin t, \\: t \\right\\rangle$ at $t = \\pi.$" :question/worked-solution "To evaluate, we substitute $t = \\pi$ into the function, as follows:\n\n$$\n\\begin{aligned}f(\\pi ) & =⟨\\operatorname{cos}⁡\\pi ,\\,\\operatorname{sin}⁡\\pi ,\\,\\pi ⟩=⟨-1,0,\\pi \\,⟩\\end{aligned}\n$$\n\nSo, the value of $\\mathbf f (t)$ at $t = \\pi$ is $\\langle -1, 0, \\pi \\rangle.$\n\nWe can also express the answer using $\\mathbf i$-$\\mathbf j$-$\\mathbf k$ notation or square bracket notation, as follows:\n![](images/d9/d9ed4c8dcfbbc0fe7b4bf58e58197598221fc730613005a719252bf88c07d3f4.svg)"}] [{:db/id #edb/ref 17592186259505 :knowledge-point/_questions [{:db/id #edb/ref 17592186068858 :knowledge-point/id #uuid "e520dc67-3b63-5ca7-959b-f642d85529d6" :knowledge-point/title "Finding the Magnitude of a Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e4d2e24-4022-547b-b5b6-6add54b37d8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186257193} {:answer/id #uuid "3ad77a2c-49f2-5511-924d-4faa1c57848d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186257303} {:answer/id #uuid "4fcc1fe8-6924-5242-8003-92db046c49f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186257466} {:answer/id #uuid "77ee4e3f-3119-5178-9cc9-6c6fad461078" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186257844} {:answer/id #uuid "fbd4d0c6-5832-5ee3-b5ee-c611a5b10f72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186258985}] :answer-field/correct {:answer/id #uuid "2e4d2e24-4022-547b-b5b6-6add54b37d8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186257193} :answer-field/id #uuid "cf0b12ff-4caf-5d30-beb4-b81232a60432" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259398}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "20f2240f-dd6d-5b3d-ad54-350df9ad6212" :question/math-academy-id "q-123284" :question/problem "Given that $r(t)=⟨\\operatorname{sin}⁡4t,\\,\\operatorname{cos}⁡4t⟩,$ $|r(\\frac{\\pi }{3})|=$" :question/worked-solution "Evaluating the function at $t=\\frac{\\pi }{3},$ we get\n\n$$\n\\begin{aligned}r(\\frac{\\pi }{3}) & =⟨\\operatorname{sin}⁡(4\\cdot \\frac{\\pi }{3}),\\,\\operatorname{cos}⁡(4\\cdot \\frac{\\pi }{3})⟩ \\\\  & =⟨-\\frac{\\sqrt{3}}{2},\\,-\\frac{1}{2}⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we get\n\n$$\n\\begin{aligned}|r(\\frac{\\pi }{3})| & =\\sqrt{{(-\\frac{\\sqrt{3}}{2})}^{2}+{(-\\frac{1}{2})}^{2}} \\\\  & =\\sqrt{\\frac{3}{4}+\\frac{1}{4}} \\\\  & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186575618 :knowledge-point/_questions [{:db/id #edb/ref 17592186068858 :knowledge-point/id #uuid "e520dc67-3b63-5ca7-959b-f642d85529d6" :knowledge-point/title "Finding the Magnitude of a Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31837ee6-10ca-577f-944f-bdb787e80bd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\sqrt{2}" :db/id #edb/ref 17592186575034} {:answer/id #uuid "637850e7-5b69-5e11-8f07-9bcea38d6888" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186575129} {:answer/id #uuid "9200df3f-c132-5c9d-b7e0-d5ed27923967" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186575202} {:answer/id #uuid "988fc287-3433-562c-bd45-9cb784417c65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{15}" :db/id #edb/ref 17592186575209} {:answer/id #uuid "b7701537-72c1-5510-bb99-fa0372ec42ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{5}" :db/id #edb/ref 17592186575276}] :answer-field/correct {:answer/id #uuid "31837ee6-10ca-577f-944f-bdb787e80bd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\sqrt{2}" :db/id #edb/ref 17592186575034} :answer-field/id #uuid "03372984-3b6a-52fd-b939-f99920dffdff" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186575408}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ed1928c0-77ed-571b-8c4d-3959f2119041" :question/math-academy-id "q-123288" :question/problem "Find $|r(1)|$ given that $r(t)=⟨8{t}^{2}-5,\\,2t+2,\\,5t⟩.$" :question/worked-solution "Evaluating the function at $t=1,$ we get\n\n$$\n\\begin{aligned}r(1) & =⟨8({1}^{2})-5,\\,2(1)+2,\\,5(1)⟩ \\\\  & =⟨3,\\,4,\\,5⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we get\n\n$$\n\\begin{aligned}|r(1)| & =\\sqrt{{(3)}^{2}+{(4)}^{2}+(5)^{2}} \\\\  & =\\sqrt{9+16+25} \\\\  & =\\sqrt{50} \\\\  & =5\\sqrt{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186575623 :knowledge-point/_questions [{:db/id #edb/ref 17592186068859 :knowledge-point/id #uuid "26571ec1-e645-5f07-ba4e-75c22558394a" :knowledge-point/title "Evaluating a Three-Component Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48c1ce60-2b0d-57ed-93c9-2c44ea8c8499" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-1,-1,-1⟩" :db/id #edb/ref 17592186575073} {:answer/id #uuid "696c269f-d224-59e2-8641-29de25014cf5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-1,1,-1⟩" :db/id #edb/ref 17592186575137} {:answer/id #uuid "6bd30911-f54e-5de1-885c-7eb77b6d9f1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨1,1,-1⟩" :db/id #edb/ref 17592186575144} {:answer/id #uuid "c5b8f200-b728-5605-9aff-7d960603ed99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨1,-1,-1⟩" :db/id #edb/ref 17592186575300} {:answer/id #uuid "ebcf05f5-066d-5d9a-b201-2e8b780e8878" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-1,-1,1⟩" :db/id #edb/ref 17592186575365}] :answer-field/correct {:answer/id #uuid "6bd30911-f54e-5de1-885c-7eb77b6d9f1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨1,1,-1⟩" :db/id #edb/ref 17592186575144} :answer-field/id #uuid "241b5b77-18a0-5d73-90a0-a56c2517100f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186575427}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "fa3121c1-bbfa-5933-8aaf-25e82847d915" :question/math-academy-id "q-160783" :question/problem "What is the value of $f(s)=⟨{s}^{2},\\,3s-2,\\,-s⟩$ at $s=1?$" :question/worked-solution "To evaluate, we substitute $s=1$ into the function, as follows:\n\n$$\n\\begin{aligned}f(1) & =⟨{1}^{2},\\,3\\cdot 1-2,\\,-1⟩ \\\\  & =⟨1,1,-1⟩\\end{aligned}\n$$\n\nSo, the value of $f(s)$ at $s=1$ is the vector $⟨1,1,-1⟩.$"}] [{:db/id #edb/ref 17592186069089 :knowledge-point/_questions [{:db/id #edb/ref 17592186068859 :knowledge-point/id #uuid "26571ec1-e645-5f07-ba4e-75c22558394a" :knowledge-point/title "Evaluating a Three-Component Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "90cf6d0d-22e9-573a-8e6c-99b01e940538" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{5} \\\\ \\ln 5 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186065968} {:answer/id #uuid "c1c316a6-91b0-5ef2-a122-563a286b4d4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 0 \\\\ \\sqrt{3}\\end{bmatrix}" :db/id #edb/ref 17592186065969} {:answer/id #uuid "d7ffdc65-1540-5f47-9527-4662799e4709" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ 0 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186065970} {:answer/id #uuid "0d070fd0-ee28-5aae-9b06-3677f53b9fd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ 0 \\\\ \\sqrt{3}\\end{bmatrix}" :db/id #edb/ref 17592186065971} {:answer/id #uuid "43b27a57-5e6c-58c9-9aee-977fb1bb6433" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{5} \\\\ \\ln 5 \\\\ \\sqrt{3}\\end{bmatrix}" :db/id #edb/ref 17592186065972}] :answer-field/id #uuid "e662384e-37a3-5da7-9acb-cdcf23400390" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186065967}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f5446f97-cf0e-5424-bd18-e4436e7ec738" :question/math-academy-id "q-160790" :question/problem "What is the value of $f(t) = \\begin{bmatrix}\\frac{1}{t + 3} \\\\ \\ln (t + 3) \\\\ \\sqrt{t^{2} - 1}\\end{bmatrix}$ at $t =-2$?"}] [{:db/id #edb/ref 17592186575620 :knowledge-point/_questions [{:db/id #edb/ref 17592186068859 :knowledge-point/id #uuid "26571ec1-e645-5f07-ba4e-75c22558394a" :knowledge-point/title "Evaluating a Three-Component Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e550028-3605-535d-afc4-0b67b596e1d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ -1 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186574997} {:answer/id #uuid "5dd5b5cd-005e-5343-bec2-584e99c95568" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ -1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186575117} {:answer/id #uuid "6969e4a1-4a1e-5a38-83f0-7effe12a76ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ -1 \\\\ \\frac{\\sqrt{2}}{2}\\end{bmatrix}" :db/id #edb/ref 17592186575136} {:answer/id #uuid "cef7cdb8-1750-586d-9b65-5c0a924fd3ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ \\sqrt{2} \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186575315} {:answer/id #uuid "f6712659-f7f2-5848-8213-91e6b729c7c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ \\frac{1}{2} \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186575385}] :answer-field/correct {:answer/id #uuid "1e550028-3605-535d-afc4-0b67b596e1d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ -1 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186574997} :answer-field/id #uuid "760957fd-b385-5f58-b025-bc8ecf6a9ef0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186575466}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f479be92-cf45-5de7-9956-484ec8fcce81" :question/math-academy-id "q-161508" :question/problem "What is the value of $f(t)=\\begin{bmatrix}\\operatorname{sin}⁡2t \\\\ \\operatorname{cos}⁡(2t+\\frac{\\pi }{2}) \\\\ \\operatorname{tan}⁡t\\end{bmatrix}$ at $t=\\frac{\\pi }{4}?$" :question/worked-solution "To evaluate, we substitute $t=\\frac{\\pi }{4}$ into the function, as follows:\n\n$$\n\\begin{aligned}f(\\frac{\\pi }{4}) & =\\begin{bmatrix}\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{4}) \\\\ \\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{4}+\\frac{\\pi }{2}) \\\\ \\operatorname{tan}⁡(\\frac{\\pi }{4})\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\operatorname{sin}⁡(\\frac{\\pi }{2}) \\\\ \\operatorname{cos}⁡\\pi  \\\\ \\operatorname{tan}⁡(\\frac{\\pi }{4})\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ -1 \\\\ 1\\end{bmatrix}\\end{aligned}\n$$\n\nSo the value of $f(t)$ at $t=\\frac{\\pi }{4}$ is the vector $\\begin{bmatrix}1 \\\\ -1 \\\\ 1\\end{bmatrix}.$"}] [{:db/id #edb/ref 17592186575583 :knowledge-point/_questions [{:db/id #edb/ref 17592186068857 :knowledge-point/id #uuid "d59ccd52-63db-5d28-b78b-2df7caf52ad0" :knowledge-point/title "Evaluating a Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f0c61ea1-4333-5b13-9cb7-3582d2854949" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{22}" :db/id #edb/ref 17592186575373}] :answer-field/correct {:answer/id #uuid "f0c61ea1-4333-5b13-9cb7-3582d2854949" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{22}" :db/id #edb/ref 17592186575373} :answer-field/id #uuid "c924a8a3-dc61-57d1-8c62-8746f205215f" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186575499} {:answer-field/choices [{:answer/id #uuid "87bfc9d6-7188-5f19-9be2-32c52f0d153f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186575189}] :answer-field/correct {:answer/id #uuid "87bfc9d6-7188-5f19-9be2-32c52f0d153f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186575189} :answer-field/id #uuid "e0f8d604-f325-5c36-a83b-915ff5c554ba" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186575513}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a52558c8-d1b8-5f58-a439-fc5376186768" :question/math-academy-id "q-348638" :question/problem "Given that $r(t)=⟨{t}^{2}-4,\\,\\sqrt{3t+7}⟩,$ calculate $r(5).$ Do not round the answer.\n\n$r(5)=⟨$\n{{field-1}} $,$\n\n{{field-2}}$⟩$" :question/worked-solution "We substitute $t=5$ into our function, and we get\n\n$$\n\\begin{aligned}r(5) & =⟨{5}^{2}-4,\\,\\sqrt{3\\cdot 5+7}⟩ \\\\  & =⟨21,\\,\\sqrt{22}⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186575581 :knowledge-point/_questions [{:db/id #edb/ref 17592186068859 :knowledge-point/id #uuid "26571ec1-e645-5f07-ba4e-75c22558394a" :knowledge-point/title "Evaluating a Three-Component Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09e0561f-7808-53e1-943e-fda0d375b0fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186574965}] :answer-field/correct {:answer/id #uuid "09e0561f-7808-53e1-943e-fda0d375b0fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186574965} :answer-field/id #uuid "5226de93-b02a-5675-8114-df9cb62aa845" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186575454} {:answer-field/choices [{:answer/id #uuid "c55e24a0-4fa8-5f96-90c9-43fc090e610e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186575299}] :answer-field/correct {:answer/id #uuid "c55e24a0-4fa8-5f96-90c9-43fc090e610e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186575299} :answer-field/id #uuid "ca938a16-0a70-51f0-a38c-c526ac7bf7d8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186575500} {:answer-field/choices [{:answer/id #uuid