d #uuid "d59ccd52-63db-5d28-b78b-2df7caf52ad0" :knowledge-point/title "Evaluating a Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11850e34-ad7d-55a5-87a6-38b9e7e49c44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨26,\\,34⟩" :db/id #edb/ref 17592186342391} {:answer/id #uuid "68dbfc82-3357-53d3-9edd-11ad4af50bd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨32,\\,26⟩" :db/id #edb/ref 17592186343135} {:answer/id #uuid "867d1acf-5891-5c10-9f0d-41012662f7ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨35,\\,25⟩" :db/id #edb/ref 17592186343395} {:answer/id #uuid "b1913533-b751-57db-ab92-1e70323fefe8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨35,\\,26⟩" :db/id #edb/ref 17592186343794} {:answer/id #uuid "ec72bbf4-23ee-58bb-b498-90cbdf219724" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨33,\\,20⟩" :db/id #edb/ref 17592186344315}] :answer-field/correct {:answer/id #uuid "b1913533-b751-57db-ab92-1e70323fefe8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨35,\\,26⟩" :db/id #edb/ref 17592186343794} :answer-field/id #uuid "8505c328-ed58-5e49-99d1-b94a3008686b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344729}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "094e4a1a-4cb3-52e8-b6b6-17ae1afe8e68" :question/math-academy-id "q-74994" :question/problem "Given that $r(t)=⟨2{t}^{2}+3,\\,5t+6⟩,$ calculate $r(4).$" :question/worked-solution "We  substitute $t=4$ into our function, and we get\n\n$$\n\\begin{aligned}r(4) & =⟨2(4)^{2}+3,\\,5(4)+6⟩ \\\\  & =⟨35,\\,26⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186234368 :knowledge-point/_questions [{:db/id #edb/ref 17592186068858 :knowledge-point/id #uuid "e520dc67-3b63-5ca7-959b-f642d85529d6" :knowledge-point/title "Finding the Magnitude of a Vector-Valued Function"}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "21cf0b12-845b-524d-bc78-3bc9f234746f" :question/math-academy-id "q-75001" :question/problem "Find $|r(\\frac{\\pi }{3})|$ given that $r(t)=⟨2\\operatorname{cos}t,\\,4\\operatorname{sin}t,\\,6⟩.$" :question/worked-solution "Evaluating the function at $t=\\frac{\\pi }{3},$ we get\n\n$$\n\\begin{aligned}r(\\frac{\\pi }{3}) & =⟨2\\operatorname{cos}(\\frac{\\pi }{3}),\\,4\\operatorname{sin}(\\frac{\\pi }{3}),\\,6⟩ \\\\  & =⟨2\\cdot \\frac{1}{2},\\,4\\cdot \\frac{\\sqrt{3}}{2},\\,6⟩ \\\\  & =⟨1,\\,2\\sqrt{3},\\,6⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we get\n\n$$\n\\begin{aligned}|r(\\frac{\\pi }{3})| & =\\sqrt{{(1)}^{2}+{(2\\sqrt{3})}^{2}+(6)^{2}} \\\\  & =\\sqrt{1+12+36} \\\\  & =\\sqrt{49} \\\\  & =7.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186345017 :knowledge-point/_questions [{:db/id #edb/ref 17592186068858 :knowledge-point/id #uuid "e520dc67-3b63-5ca7-959b-f642d85529d6" :knowledge-point/title "Finding the Magnitude of a Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30d51eff-42f3-5193-bd0c-3c492f1889cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186342647} {:answer/id #uuid "c6ea8410-50de-52e4-bf00-07b5d70c1277" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{7}" :db/id #edb/ref 17592186343982} {:answer/id #uuid "c75b2667-0486-53a7-8e38-5c65e9869b1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186343989} {:answer/id #uuid "f3400453-fecb-5d78-a600-08d4156638cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186344377} {:answer/id #uuid "fba50e80-e32c-507d-8ba1-4e2e2dae9f8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186344452}] :answer-field/correct {:answer/id #uuid "fba50e80-e32c-507d-8ba1-4e2e2dae9f8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186344452} :answer-field/id #uuid "9a3f47ed-f3d1-5b98-929b-48ad74186cdf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344758}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c0a3f35d-905e-58d7-b70f-a757375e6c6f" :question/math-academy-id "q-75004" :question/problem "Given that $r(t)=⟨\\sqrt{t},\\,t-3⟩,$ $|r(5)|=$" :question/worked-solution "Evaluating the function at $t=5,$ we get\n\n$$\n\\begin{aligned}r(5) & =⟨\\sqrt{5},\\,5-3⟩ \\\\  & =⟨\\sqrt{5},\\,2⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we get\n\n$$\n\\begin{aligned}|r(5)| & =\\sqrt{{(\\sqrt{5})}^{2}+{(2)}^{2}} \\\\  & =\\sqrt{5+4} \\\\  & =3.\\end{aligned}\n$$"}]}
