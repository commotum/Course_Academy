#{[{:db/id #edb/ref 17592186068457 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068857 :knowledge-point/id #uuid "d59ccd52-63db-5d28-b78b-2df7caf52ad0" :knowledge-point/title "Evaluating a Vector-Valued Function"}] :question/id #uuid "6eea01b2-bc2a-55a8-9bab-6789df00fc42" :question/math-academy-id "e-12450" :question/problem "Given that $\\mathbf r (t) = \\langle 6t, 2t^2-1\\rangle,$ calculate $\\mathbf r (3).$" :question/worked-solution "We substitute $t=3$ into our function, and we get\n\n$$\n\\begin{aligned}r(3) & =⟨6(3),\\,2(3)^{2}-1⟩ \\\\  & =⟨18,\\,17⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186068458 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068858 :knowledge-point/id #uuid "e520dc67-3b63-5ca7-959b-f642d85529d6" :knowledge-point/title "Finding the Magnitude of a Vector-Valued Function"}] :question/id #uuid "86e423e7-db4b-5fdf-a285-bded3bd8161e" :question/math-academy-id "e-12451" :question/problem "Find $\\left|\\mathbf r\\left(4\\right)\\right|$ given that $\\mathbf r(t)  = \\left\\langle 2-t, 2\\sqrt{t}, \\, t-1\\right\\rangle,$" :question/worked-solution "Evaluating the function at $t=4,$ we get\n\n$$\n\\begin{aligned}r(4) & =⟨2-4,\\,2\\sqrt{4},\\,4-1⟩ \\\\  & =⟨-2,\\,4,\\,3⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we obtain\n\n$$\n\\begin{aligned}|r(4)| & =\\sqrt{{(-2)}^{2}+{(4)}^{2}+{(3)}^{2}} \\\\  & =\\sqrt{4+16+9} \\\\  & =\\sqrt{29}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186068459 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068859 :knowledge-point/id #uuid "26571ec1-e645-5f07-ba4e-75c22558394a" :knowledge-point/title "Evaluating a Three-Component Vector-Valued Function"}] :question/id #uuid "ab3899d3-8838-57ad-8a17-b8ac2934c0f9" :question/math-academy-id "e-12452" :question/problem "Find the value of the vector function $\\mathbf f(t) = \\left\\langle \\cos t, \\: \\sin t, \\: t \\right\\rangle$ at $t = \\pi.$" :question/worked-solution "To evaluate, we substitute $t = \\pi$ into the function, as follows:\n\n$$\n\\begin{aligned}f(\\pi ) & =⟨\\operatorname{cos}⁡\\pi ,\\,\\operatorname{sin}⁡\\pi ,\\,\\pi ⟩=⟨-1,0,\\pi \\,⟩\\end{aligned}\n$$\n\nSo, the value of $\\mathbf f (t)$ at $t = \\pi$ is $\\langle -1, 0, \\pi \\rangle.$\n\nWe can also express the answer using $\\mathbf i$-$\\mathbf j$-$\\mathbf k$ notation or square bracket notation, as follows:\n![](images/d9/d9ed4c8dcfbbc0fe7b4bf58e58197598221fc730613005a719252bf88c07d3f4.svg)"}] [{:db/id #edb/ref 17592186259505 :knowledge-point/_questions [{:db/id #edb/ref 17592186068858 :knowledge-point/id #uuid "e520dc67-3b63-5ca7-959b-f642d85529d6" :knowledge-point/title "Finding the Magnitude of a Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e4d2e24-4022-547b-b5b6-6add54b37d8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186257193} {:answer/id #uuid "3ad77a2c-49f2-5511-924d-4faa1c57848d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186257303} {:answer/id #uuid "4fcc1fe8-6924-5242-8003-92db046c49f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186257466} {:answer/id #uuid "77ee4e3f-3119-5178-9cc9-6c6fad461078" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186257844} {:answer/id #uuid "fbd4d0c6-5832-5ee3-b5ee-c611a5b10f72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186258985}] :answer-field/correct {:answer/id #uuid "2e4d2e24-4022-547b-b5b6-6add54b37d8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186257193} :answer-field/id #uuid "cf0b12ff-4caf-5d30-beb4-b81232a60432" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259398}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "20f2240f-dd6d-5b3d-ad54-350df9ad6212" :question/math-academy-id "q-123284" :question/problem "Given that $r(t)=⟨\\operatorname{sin}⁡4t,\\,\\operatorname{cos}⁡4t⟩,$ $|r(\\frac{\\pi }{3})|=$" :question/worked-solution "Evaluating the function at $t=\\frac{\\pi }{3},$ we get\n\n$$\n\\begin{aligned}r(\\frac{\\pi }{3}) & =⟨\\operatorname{sin}⁡(4\\cdot \\frac{\\pi }{3}),\\,\\operatorname{cos}⁡(4\\cdot \\frac{\\pi }{3})⟩ \\\\  & =⟨-\\frac{\\sqrt{3}}{2},\\,-\\frac{1}{2}⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we get\n\n$$\n\\begin{aligned}|r(\\frac{\\pi }{3})| & =\\sqrt{{(-\\frac{\\sqrt{3}}{2})}^{2}+{(-\\frac{1}{2})}^{2}} \\\\  & =\\sqrt{\\frac{3}{4}+\\frac{1}{4}} \\\\  & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186069089 :knowledge-point/_questions [{:db/id #edb/ref 17592186068859 :knowledge-point/id #uuid "26571ec1-e645-5f07-ba4e-75c22558394a" :knowledge-point/title "Evaluating a Three-Component Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "90cf6d0d-22e9-573a-8e6c-99b01e940538" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{5} \\\\ \\ln 5 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186065968} {:answer/id #uuid "c1c316a6-91b0-5ef2-a122-563a286b4d4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 0 \\\\ \\sqrt{3}\\end{bmatrix}" :db/id #edb/ref 17592186065969} {:answer/id #uuid "d7ffdc65-1540-5f47-9527-4662799e4709" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ 0 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186065970} {:answer/id #uuid "0d070fd0-ee28-5aae-9b06-3677f53b9fd0" :answer/type {:d