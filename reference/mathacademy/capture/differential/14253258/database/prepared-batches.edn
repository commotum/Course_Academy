[{"source" ":org/Math-Academy" "forms" [{:db/id 17592186068857 :knowledge-point/questions ["question-bab955aa-96ab-5495-ba71-684f1eacabcc" "question-a52558c8-d1b8-5f58-a439-fc5376186768" "question-d0d01a34-dbf9-5949-a688-edf940f34604"] :db/ensure [:knowledge-point/validate]} {:db/id "question-bab955aa-96ab-5495-ba71-684f1eacabcc" :question/id #uuid "bab955aa-96ab-5495-ba71-684f1eacabcc" :question/math-academy-id "q-50357" :question/problem "Given that $r(t)=⟨2t-1,\\,\\sqrt{t+1}⟩,$ calculate $r(3).$" :question/worked-solution "We  substitute $t=3$ into our function, and we get\n\n$$\n\\begin{aligned}r(3) & =⟨2(3)-1,\\,\\sqrt{3+1}⟩ \\\\  & =⟨5,\\,2⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-37064e83-22d2-5af2-90cd-ce0aafb53bfe"] :db/ensure [:question/validate]} {:db/id "answer-field-37064e83-22d2-5af2-90cd-ce0aafb53bfe" :answer-field/id #uuid "37064e83-22d2-5af2-90cd-ce0aafb53bfe" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d7b490f2-afe6-512e-b6ce-74740631151e" :answer-field/choices ["answer-90d72d9f-8d5a-559d-8d59-78ef6a9aac96" "answer-7fe7df7f-74b2-5ff0-bd42-8c4112ac6775" "answer-d7b490f2-afe6-512e-b6ce-74740631151e" "answer-f57541bd-110d-50ed-8ce2-ed3aca5d7033" "answer-72103240-286b-5cea-bf02-8e88e020134e"] :db/ensure [:answer-field/validate]} {:db/id "answer-90d72d9f-8d5a-559d-8d59-78ef6a9aac96" :answer/id #uuid "90d72d9f-8d5a-559d-8d59-78ef6a9aac96" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "answer-7fe7df7f-74b2-5ff0-bd42-8c4112ac6775" :answer/id #uuid "7fe7df7f-74b2-5ff0-bd42-8c4112ac6775" :answer/type :answer.type/math :answer/value "⟨5,\\,1⟩" :db/ensure [:answer/validate]} {:db/id "answer-d7b490f2-afe6-512e-b6ce-74740631151e" :answer/id #uuid "d7b490f2-afe6-512e-b6ce-74740631151e" :answer/type :answer.type/math :answer/value "⟨5,\\,2⟩" :db/ensure [:answer/validate]} {:db/id "answer-f57541bd-11