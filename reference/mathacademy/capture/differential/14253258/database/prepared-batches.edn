121c1-bbfa-5933-8aaf-25e82847d915"] [17592186069089 :question/difficulty :question.difficulty/moderate] ["question-e8bf0613-dc2d-57fb-b4e9-45d51faad202" :question/id #uuid "e8bf0613-dc2d-57fb-b4e9-45d51faad202"] ["question-e8bf0613-dc2d-57fb-b4e9-45d51faad202" :question/math-academy-id "q-348682"] ["question-e8bf0613-dc2d-57fb-b4e9-45d51faad202" :question/problem "Given that $r(t)=⟨cos\\,(\\frac{\\pi t}{2}),\\,\\frac{4}{t-1}⟩,$ what is $|r(3)|?$\n\n$|r(3)|=$\n{{field-1}}"] ["question-e8bf0613-dc2d-57fb-b4e9-45d51faad202" :question/worked-solution "Evaluating the function at $t=3,$ we get\n\n$$\n\\begin{aligned}r(3) & =⟨cos\\,(\\frac{3\\pi }{2}),\\,\\frac{4}{3-1}⟩ \\\\  & =⟨0,\\,2⟩\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we obtain\n\n$$\n\\begin{aligned}|r(3)| & =\\sqrt{{0}^{2}+{2}^{2}} \\\\  & =\\sqrt{4} \\\\  & =2\\end{aligned}\n$$"] ["question-e8bf0613-dc2d-57fb-b4e9-45d51faad202" :question/difficulty :question.difficulty/easy] ["answer-field-b8dd47c6-0daf-57eb-b7fa-e36f8f40c1d7" :answer-field/id #uuid "b8dd47c6-0daf-57eb-b7fa-e36f8f40c1d7"] ["answer-30dfc837-d5c1-5761-8aca-09d8e183f2c6" :answer/id #uuid "30dfc837-d5c1-5761-8aca-09d8e183f2c6"] ["answer-30dfc837-d5c1-5761-8aca-09d8e183f2c6" :answer/type :answer.type/math] ["answer-30dfc837-d5c1-5761-8aca-09d8e183f2c6" :answer/value "2"] ["answer-field-b8dd47c6-0daf-57eb-b7fa-e36f8f40c1d7" :answer-field/key "field-1"] ["answer-field-b8dd47c6-0daf-57eb-b7fa-e36f8f40c1d7" :answer-field/type :answer-field.type/blank] ["answer-field-b8dd47c6-0daf-57eb-b7fa-e36f8f40c1d7" :answer-field/correct "answer-30dfc837-d5c1-5761-8aca-09d8e183f2c6"] ["answer-field-b8dd47c6-0daf-57eb-b7fa-e36f8f40c1d7" :answer-field/choices "answer-30dfc837-d5c1-5761-8aca-09d8e183f2c6"] ["question-e8bf0613-dc2d-57fb-b4e9-45d51faad202" :question/answer-fields "answer-field-b8dd47c6-0daf-57eb-b7fa-e36f8f40c1d7"] [17592186068858 :knowledge-point/questions "question-e8bf0613-dc2d-57fb-b4e9-45d51faad202"] ["question-ed1928c0-77ed-571b-8c4d-3959f2119041" :question/id #uuid "ed1928c0-77ed-571b-8c4d-3959f2119041"] ["question-ed1928c0-77ed-571b-8c4d-3959f2119041" :question/math-academy-id "q-123288"] ["question-ed1928c0-77ed-571b-8c4d-3959f2119041" :question/problem "Find $|r(1)|$ given that $r(t)=⟨8{t}^{2}-5,\\,2t+2,\\,5t⟩.$"] ["question-ed1928c0-77ed-571b-8c4d-3959f2119041" :question/worked-solution "Evaluating the function at $t=1,$ we get\n\n$$\n\\begin{aligned}r(1) & =⟨8({1}^{2})-5,\\,2(1)+2,\\,5(1)⟩ \\\\  & =⟨3,\\,4,\\,5⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we get\n\n$$\n\\begin{aligned}|r(1)| & =\\sqrt{{(3)}^{2}+{(4)}^{2}+(5)^{2}} \\\\  & =\\sqrt{9+16+25} \\\\  & =\\sqrt{50} \\\\  & =5\\sqrt{2}.\\end{aligned}\n$$"] ["question-ed1928c0-77ed-571b-8c4d-3959f2119041" :question/difficulty :question.difficulty/moderate] ["answer-field-03372984-3b6a-52fd-b939-f99920dffdff" :answer-field/id #uuid "03372984-3b6a-52fd-b939-f99920dffdff"] ["answer-9200df3f-c132-5c9d-b7e0-d5ed27923967" :answer/id #uuid "9200df3f-c132-5c9d-b7e0-d5ed27923967"] ["answer-9200df3f-c132-5c9d-b7e0-d5ed27923967" :answer/type :answer.type/math] ["answer-9200df3f-c132-5c9d-b7e0-d5ed27923967" :answer/value "10"] ["answer-b7701537-72c1-5510-bb99-fa0372ec42ec" :answer/id #uuid "b7701537-72c1-5510-bb99-fa0372ec42ec"] ["answer-b7701537-72c1-5510-bb99-fa0372ec42ec" :answer/type :answer.type/math] ["answer-b7701537-72c1-5510-bb99-fa0372ec42ec" :answer/value "4\\sqrt{5}"] ["answer-637850e7-5b69-5e11-8f07-9bcea38d6888" :answer/id #uuid "637850e7-5b69-5e11-8f07-9bcea38d6888"] ["answer-637850e7-5b69-5e11-8f07-9bcea38d6888" :answer/type :answer.type/math] ["answer-637850e7-5b69-5e11-8f07-9bcea38d6888" :answer/value "5"] ["answer-31837ee6-10ca-577f-944f-bdb787e80bd6" :answer/id #uuid "31837ee6-10ca-577f-944f-bdb787e80bd6"] ["answer-31837ee6-10ca-577f-944f-bdb787e80bd6" :answer/type :answer.type/math] ["answer-31837ee6-10ca-577f-944f-bdb787e80bd6" :answer/value "5\\sqrt{2}"] ["answer-988fc287-3433-562c-bd45-9cb784417c