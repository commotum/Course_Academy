ue "3" :db/ensure [:answer/validate]} {:db/id 17592186068859 :knowledge-point/questions ["question-cc70b07d-530b-5e77-9200-c7de006703f0" "question-f479be92-cf45-5de7-9956-484ec8fcce81" "question-a3f0d323-4472-593b-894f-b4448dff1085" "question-fa3121c1-bbfa-5933-8aaf-25e82847d915"] :db/ensure [:knowledge-point/validate]} {:db/id "question-cc70b07d-530b-5e77-9200-c7de006703f0" :question/id #uuid "cc70b07d-530b-5e77-9200-c7de006703f0" :question/math-academy-id "q-348662" :question/problem "What is the value of $g(t)=⟨{3}^{\\,t-1},\\,{log}_{3}⁡({t}^{2}+2t),\\,{sec}^{2}\\,(\\frac{\\pi t}{4})-1⟩$ at $t=1?$\n\n$g(1)=⟨$\n{{field-1}} $,\\,$\n{{field-2}} $,\\,$\n{{field-3}} $⟩$" :question/worked-solution "To evaluate, we substitute $t=1$ into the function, as follows:\n\n$$\n\\begin{aligned}g(1) & =⟨{3}^{1-1},\\,{log}_{3}⁡({1}^{2}+2(1)),\\,{sec}^{2}\\,(\\frac{\\pi }{4})-1⟩ \\\\  & =⟨1,\\,{log}_{3}⁡(3),\\,{(\\sqrt{2})}^{2}-1⟩ \\\\  & =⟨1,\\,1,\\,1⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-2627111a-37e8-5d2c-8a5b-4d5136c68472" "answer-field-2c8d376b-9f7b-5064-964a-ded341c098b6" "answer-field-54256760-b370-56e1-8f9d-274cd9ac9901"] :db/ensure [:question/validate]} {:db/id "answer-field-2627111a-37e8-5d2c-8a5b-4d5136c68472" :answer-field/id #uuid "2627111a-37e8-5d2c-8a5b-4d5136c68472" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-c481408a-4444-530b-b268-67fbe75e182d" :answer-field/choices ["answer-c481408a-4444-530b-b268-67fbe75e182d"] :db/ensure [:answer-field/validate]} {:db/id "answer-c481408a-4444-530b-b268-67fbe75e182d" :answer/id #uuid "c481408a-4444-530b-b268-67fbe75e182d" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-field-2c8d376b-9f7b-5064-964a-ded341c098b6" :answer-field/id #uuid "2c8d376b-9f7b-5064-964a-ded341c098b6" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-8324fe7b-ac3f-57ba-80f6-ed595d15ca83" :answer-field/choices ["answer-8324fe7b-ac3f-57ba-80f6-ed595d15ca83"] :db/ensure [:answer-field/validate]} {:db/id "answer-8324fe7b-ac3f-57ba-80f6-ed595d15ca83" :answer/id #uuid "8324fe7b-ac3f-57ba-80f6-ed595d15ca83" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-field-54256760-b370-56e1-8f9d-274cd9ac9901" :answer-field/id #uuid "54256760-b370-56e1-8f9d-274cd9ac9901" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-354b471b-f02d-5a8f-b605-c9b1d7cfa995" :answer-field/choices ["answer-354b471b-f02d-5a8f-b605-c9b1d7cfa995"] :db/ensure [:answer-field/validate]} {:db/id "answer-354b471b-f02d-5a8f-b605-c9b1d7cfa995" :answer/id #uuid "354b471b-f02d-5a8f-b605-c9b1d7cfa995" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "question-f479be92-cf45-5de7-9956-484ec8fcce81" :question/id #uuid "f479be92-cf45-5de7-9956-484ec8fcce81" :question/math-academy-id "q-161508" :question/problem "What is the value of $f(t)=\\begin{bmatrix}\\operatorname{sin}⁡2t \\\\ \\operatorname{cos}⁡(2t+\\frac{\\pi }{2}) \\\\ \\operatorname{tan}⁡t\\end{bmatrix}$ at $t=\\frac{\\pi }{4}?$" :question/worked-solution "To evaluate, we substitute $t=\\frac{\\pi }{4}$ into the function, as follows:\n\n$$\n\\begin{aligned}f(\\frac{\\pi }{4}) & =\\begin{bmatrix}\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{4}) \\\\ \\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{4}+\\frac{\\pi }{2}) \\\\ \\operatorname{tan}⁡(\\frac{\\pi }{4})\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\operatorname{sin}⁡(\\frac{\\pi }{2}) \\\\ \\operatorname{cos}⁡\\pi  \\\\ \\operatorname{tan}⁡(\\frac{\\pi }{4})\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ -1 \\\\ 1\\end{bmatrix}\\end{aligned}\n$$\n\nSo the value of $f(t)$ at $t=\\frac{\\pi }{4}$ is the vector $\\begin{bmatrix}1 \\\\ -1 \\\\ 1\\end{bmatrix}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-760957fd-b385-5f58-b025-bc8ecf6a9ef0"] :db/ensure [:question/validate]} {:db/id "answer-field-760957fd-b385-5f58-b025-bc8ecf6a9ef0" :answer-field/id #uuid "760957fd-b385-5f58-b025-bc8ecf6a9ef0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1e550028-3605-535d-afc4-0b67b596e1d7" :answer-field/choices ["answer-6969e4a1-4a1e-5a38-83f0-7effe12a76ef" "answer-f6712659-f7f2-5848-8213-91e6b729c7c3" "answer-cef7cdb8-1750-586d-9b65-5c0a924fd3ab" "answer-5dd5b5cd-005e-5343-bec2-584e99c95568" "answer-1e550028-3605-535d-afc4-0b67b596e1d7"] :db/ensure [:answer-field/validate]} {:db/id "answer-6969e4a1-4a1e-5a38-83f0-7effe12a76ef" :answer/id #uuid "6969e4a1-4a1e-5a38-83f0-7effe12a76ef" :answer/type :answer.type/math :answer/value "\\begin{bmatrix}-1 \\\\ -1 \\\\ \\frac{\\sqrt{2}}{2}\\end{bmatrix}" :db/ensure [:answer/validate]} {:db/id "answer-f6712659-f7f2-5848-8213-91e6b729c7c3" :answer/id #uuid "f6712659-f7f2-5848-8213-91e6b729c7c3" :answer/type :answer.type/math :answer/value "\\begin{bmatrix}0 \\\\ \\frac{1}{2} \\\\ 1\\end{bmatrix}" :db/ensure [:answer/validate]} {:db/id "answer-cef7cdb8-1750-586d-9b65-5c0a924fd3ab" :answer/id #uuid "cef7cdb8-1750-586d-9b65-5c0a924fd3ab" :answer/type :answer.type/math :answer/value "\\begin{bmatrix}0 \\\\ \\sqrt{2} \\\\ 1\\end{bmatrix}" :db/ensure [:answer/validate]} {:db/id "answer-5dd5b5cd-005e-5343-bec2-584e99c95568" :answer/id #uuid "5dd5b5cd-005e-5343-bec2-584e99c95568" :answer/type :answer.type/math :answer/value "\\begin{bmatrix}1 \\\\ -1 \\\\ 0\\end{bmatrix}" :db/ensure [:answer/validate]} {:db/id "answer-1e550028-3605-535d-afc4-0b67b596e1d7" :answer/id #uuid "1e550028-3605-535d-afc4-0b67b596e1d7" :answer/type :answer.type/math :answer/value "\\begin{bmatrix}1 \\\\ -1 \\\\ 1\\end{bmatrix}" :db/ensure [:answer/validate]} {:db/id "question-a3f0d323-4472-593b-894f-b4448dff1085" :question/id #uuid "a3f0d323-4472-593b-894f-b4448dff1085" :question/math-academy-id "q-348650" :question/problem "What is the value of $q(t)=\\sqrt{t-3}\\,i+ln\\,({t}^{2})\\,j+\\frac{5}{t+1}\\operatorname{sin}⁡(\\pi t)\\,k$ at $t=4?$\n\n$q(4)=$\n{{field-1}} $i\\,+\\,$\n\n{{field-2}} $j\\,+\\,$\n\n{{field-3}} $k$" :question/worked-solution "To evaluate, we substitute $t=4$ into the function, as follows:\n\n$$\n\\begin{aligned}q(4) & =\\sqrt{4-3}\\,i+ln\\,({4}^{2})\\,j+\\frac{5}{4+1}\\operatorname{sin}⁡(4\\pi )\\,k \\\\  & =\\sqrt{1}\\,i+\\operatorname{ln}⁡(16)\\,j+\\frac{5}{5}\\cdot 0\\,k \\\\  & =1\\,i+\\operatorname{ln}⁡(16)\\,j+0\\,k\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ca938a16-0a70-51f0-a38c-c526ac7bf7d8" "answer-field-ce022f64-1926-5855-b59b-cbb659564deb" "answer-field-5226de93-b02a-5675-8114-df9cb62aa845"] :db/ensure [:question/validate]} {:db/id "answer-field-ca938a16-0a70-51f0-a38c-c526ac7bf7d8" :answer-field/id #uuid "ca938a16-0a70-51f0-a38c-c526ac7bf7d8" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-c55e24a0-4fa8-5f96-90c9-43fc090e610e" :answer-field/choices ["answer-c55e24a0-4fa8-5f96-90c9-43fc090e610e"] :db/ensure [:answer-field/validate]} {:db/id "answer-c55e24a0-4fa8-5f96-90c9-43fc090e610e" :answer/id #uuid "c55e24a0-4fa8-5f96-90c9-43fc090e610e" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-field-ce022f64-1926-5855-b59b-cbb659564deb" :answer-field/id #uuid "ce022f64-1926-5855-b59b-cbb659564deb" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-cf767b13-484b-5211-88e0-118a601e941c" :answer-field/choices ["answer-cf767b13-484b-5211-88e0-118a601e941c"] :db/ensure [:answer-field/validate]} {:db/id "answer-cf767b13-484b-5211-88e0-118a601e941c" :answer/id #uuid "cf767b13-484b-5211-88e0-118a601e941c" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(16)" :db/ensure [:answer/validate]} {:db/