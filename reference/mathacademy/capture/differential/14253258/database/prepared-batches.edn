cc70b07d-530b-5e77-9200-c7de006703f0" :question/difficulty :question.difficulty/hard] ["answer-field-2627111a-37e8-5d2c-8a5b-4d5136c68472" :answer-field/id #uuid "2627111a-37e8-5d2c-8a5b-4d5136c68472"] ["answer-c481408a-4444-530b-b268-67fbe75e182d" :answer/id #uuid "c481408a-4444-530b-b268-67fbe75e182d"] ["answer-c481408a-4444-530b-b268-67fbe75e182d" :answer/type :answer.type/math] ["answer-c481408a-4444-530b-b268-67fbe75e182d" :answer/value "1"] ["answer-field-2627111a-37e8-5d2c-8a5b-4d5136c68472" :answer-field/key "field-1"] ["answer-field-2627111a-37e8-5d2c-8a5b-4d5136c68472" :answer-field/type :answer-field.type/blank] ["answer-field-2627111a-37e8-5d2c-8a5b-4d5136c68472" :answer-field/correct "answer-c481408a-4444-530b-b268-67fbe75e182d"] ["answer-field-2627111a-37e8-5d2c-8a5b-4d5136c68472" :answer-field/choices "answer-c481408a-4444-530b-b268-67fbe75e182d"] ["answer-field-2c8d376b-9f7b-5064-964a-ded341c098b6" :answer-field/id #uuid "2c8d376b-9f7b-5064-964a-ded341c098b6"] ["answer-8324fe7b-ac3f-57ba-80f6-ed595d15ca83" :answer/id #uuid "8324fe7b-ac3f-57ba-80f6-ed595d15ca83"] ["answer-8324fe7b-ac3f-57ba-80f6-ed595d15ca83" :answer/type :answer.type/math] ["answer-8324fe7b-ac3f-57ba-80f6-ed595d15ca83" :answer/value "1"] ["answer-field-2c8d376b-9f7b-5064-964a-ded341c098b6" :answer-field/key "field-2"] ["answer-field-2c8d376b-9f7b-5064-964a-ded341c098b6" :answer-field/type :answer-field.type/blank] ["answer-field-2c8d376b-9f7b-5064-964a-ded341c098b6" :answer-field/correct "answer-8324fe7b-ac3f-57ba-80f6-ed595d15ca83"] ["answer-field-2c8d376b-9f7b-5064-964a-ded341c098b6" :answer-field/choices "answer-8324fe7b-ac3f-57ba-80f6-ed595d15ca83"] ["answer-field-54256760-b370-56e1-8f9d-274cd9ac9901" :answer-field/id #uuid "54256760-b370-56e1-8f9d-274cd9ac9901"] ["answer-354b471b-f02d-5a8f-b605-c9b1d7cfa995" :answer/id #uuid "354b471b-f02d-5a8f-b605-c9b1d7cfa995"] ["answer-354b471b-f02d-5a8f-b605-c9b1d7cfa995" :answer/type :answer.type/math] ["answer-354b471b-f02d-5a8f-b605-c9b1