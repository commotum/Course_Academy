e of $f(t)$ at $t=\\frac{\\pi }{4}$ is the vector $\\begin{bmatrix}1 \\\\ -1 \\\\ 1\\end{bmatrix}.$"] ["question-f479be92-cf45-5de7-9956-484ec8fcce81" :question/difficulty :question.difficulty/moderate] ["answer-field-760957fd-b385-5f58-b025-bc8ecf6a9ef0" :answer-field/id #uuid "760957fd-b385-5f58-b025-bc8ecf6a9ef0"] ["answer-6969e4a1-4a1e-5a38-83f0-7effe12a76ef" :answer/id #uuid "6969e4a1-4a1e-5a38-83f0-7effe12a76ef"] ["answer-6969e4a1-4a1e-5a38-83f0-7effe12a76ef" :answer/type :answer.type/math] ["answer-6969e4a1-4a1e-5a38-83f0-7effe12a76ef" :answer/value "\\begin{bmatrix}-1 \\\\ -1 \\\\ \\frac{\\sqrt{2}}{2}\\end{bmatrix}"] ["answer-f6712659-f7f2-5848-8213-91e6b729c7c3" :answer/id #uuid "f6712659-f7f2-5848-8213-91e6b729c7c3"] ["answer-f6712659-f7f2-5848-8213-91e6b729c7c3" :answer/type :answer.type/math] ["answer-f6712659-f7f2-5848-8213-91e6b729c7c3" :answer/value "\\begin{bmatrix}0 \\\\ \\frac{1}{2} \\\\ 1\\end{bmatrix}"] ["answer-cef7cdb8-1750-586d-9b65-5c0a924fd3ab" :answer/id #uuid "cef7cdb8-1750-586d-9b65-5c0a924fd3ab"] ["answer-cef7cdb8-1750-586d-9b65-5c0a924fd3ab" :answer/type :answer.type/math] ["answer-cef7cdb8-1750-586d-9b65-5c0a924fd3ab" :answer/value "\\begin{bmatrix}0 \\\\ \\sqrt{2} \\\\ 1\\end{bmatrix}"] ["answer-5dd5b5cd-005e-5343-bec2-584e99c95568" :answer/id #uuid "5dd5b5cd-005e-5343-bec2-584e99c95568"] ["answer-5dd5b5cd-005e-5343-bec2-584e99c95568" :answer/type :answer.type/math] ["answer-5dd5b5cd-005e-5343-bec2-584e99c95568" :answer/value "\\begin{bmatrix}1 \\\\ -1 \\\\ 0\\end{bmatrix}"] ["answer-1e550028-3605-535d-afc4-0b67b596e1d7" :answer/id #uuid "1e550028-3605-535d-afc4-0b67b596e1d7"] ["answer-1e550028-3605-535d-afc4-0b67b596e1d7" :answer/type :answer.type/math] ["answer-1e550028-3605-535d-afc4-0b67b596e1d7" :answer/value "\\begin{bmatrix}1 \\\\ -1 \\\\ 1\\end{bmatrix}"] ["answer-field-760957fd-b385-5f58-b025-bc8ecf6a9ef0" :answer-field/key "selection"] ["answer-field-760957fd-b385-5f58-b025-bc8ecf6a9ef0" :answer-field/type :answer-field.type