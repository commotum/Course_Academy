#{[{:activity/expected-seconds 1080.0 :activity/first-step {:db/id #edb/ref 17592186125361} :activity/id #uuid "e6e3df9f-205d-5b79-a182-6a881367dca2" :activity/scope {:db/id #edb/ref 17592186048769 :topic/id #uuid "bd333eb5-72e6-5eaa-be12-c6bf36306b90" :topic/math-academy-id 1910} :activity/steps [{:db/id #edb/ref 17592186125361 :step/content {:db/id #edb/ref 17592186125768 :tutorial/content "Suppose that $\\mathbf x \\in V$ for some vector space $V,$ and that $\\mathcal B$ and $\\mathcal C$ are two bases of $V.$ \n\nTo find the coordinates of $\\mathbf{x}$ relative to $\\mathcal{C}$ given its coordinates relative to $\\mathcal B,$ we can use the **change-of-basis formula**\n\n$$\n\\begin{aligned}[\\,x\\,]_{C}={P}_{B\\to C}\\cdot [\\,x\\,]_{B},\\end{aligned}\n$$\n\nwhere we recall that\n\n- $[\\,\\mathbf x\\,]_{\\color{blue}\\mathcal{B}}$ and $[\\,\\mathbf x\\,]_{\\color{red}\\mathcal{C}}$ are the coordinates of $\\mathbf{x}$ relative to the bases $\\color{blue}\\mathcal{B}$ and ${\\color{red}\\mathcal{C}},$ respectively, and\n\n- $P_{\\small{\\color{blue}\\mathcal{B}}\\to{\\color{red}\\mathcal{C}}}$ is the change-of-coordinates matrix from $\\color{blue}\\mathcal{B}$ to ${\\color{red}\\mathcal{C}},$ whose columns are the coordinates of vectors of the basis $\\color{blue}\\mathcal{B}$ relative to the basis ${\\color{red}\\mathcal{C}}.$\n\nAs an example, suppose we are given two bases $\\mathcal{B}=\\left\\{ \\mathbf{b}_1, \\mathbf{b}_2 \\right\\}$ and $\\mathcal{C}=\\left\\{ \\mathbf{c}_1, \\mathbf{c}_2 \\right\\}$ of a vector space $V,$ and we already know that the change-of-coordinates matrix from $\\mathcal{B}$ to $\\mathcal{C}$ is given by\n![](images/d9/d9388f46f84cc0c6b1d7e5cf43ee973085366ae4f44cfe74515c59bfc1994662.svg)\n\nLet $\\mathbf{v} \\in V$ and ![](images/f9/f99f37621c20057077eb7c6e23690a45159cfe1b665c6b88b4a604f8687728bf.svg) Then we can easily find $[\\,\\mathbf{v}\\,]_{\\mathcal{C}},$ as follows:\n\n$$\n\\begin{aligned}[\\,v\\,]_{C} & =\\overset{{P}_{B\\to C}}{\\overset{⏞}{[\\begin{aligned}-1 & 2 \\\\ 2 & 1\\end{aligned}]}}\\cdot \\overset{[v]_{B}}{\\overset{⏞}{[\\begin{aligned}2 \\\\ 2\\end{aligned}]}} \\\\  & =[\\begin{aligned}2 \\\\ 6\\end{aligned}]\\end{aligned}\n$$" :tutorial/id #uuid "827e9581-9fde-5941-ad91-2c364796e5b1" :tutorial/math-academy-id 3217 :tutorial/title "Introduction"} :step/id #uuid "910841a1-0516-546a-8aac-f188c965b763" :step/math-academy-id 17537 :step/next {:db/id #edb/ref 17592186125500}} {:db/id #edb/ref 17592186125362 :step/content {:db/id #edb/ref 17592186124495 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124308 :question/id #uuid "922b0f79-2c87-56f9-bf8a-18711a2a09d7" :question/math-academy-id "e-4838"} :knowledge-point/id #uuid "5e2a1713-45a0-5ac9-812e-efe047dbc9eb" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050008} {:db/id #edb/ref 17592186050825}] :knowledge-point/questions [{:db/id #edb/ref 17592186124968} {:db/id #edb/ref 17592186124991} {:db/id #edb/ref 17592186247372} {:db/id #edb/ref 17592186247373} {:db/id #edb/ref 17592186323887} {:db/id #edb/ref 17592186394394} {:db/id #edb/ref 17592186394435} {:db/id #edb/ref 17592186417186} {:db/id #edb/ref 17592186417187} {:db/id #edb/ref 17592186417190} {:db/id #edb/ref 17592186440462} {:db/id #edb/ref 17592186440466}] :knowledge-point/title "Finding the Coordinates of a Vector in a New Basis Given the Change-of-Coordinates Matrix"} :step/id #uuid "ad493885-054b-5d5e-a186-80a2c3801b8b" :step/math-academy-id 17538 :step/next {:db/id #edb/ref 17592186125363}} {:db/id #edb/ref 17592186125363 :step/content {:db/id #edb/ref 17592186124496 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124309 :question/id #uuid "a3911ca2-a357-5f37-8abc-e01e5518f24b" :question/math-academy-id "e-4840"} :knowledge-point/id #uuid "5ee52fd3-6c79-5016-ade5-46e7bfbb557a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049548}] :knowledge-point/questions [{:db/id #edb/ref 17592186124994} {:db/id #edb/ref 17592186125034} {:db/id #edb/ref 17592186323807} {:db/id #edb/ref 17592186351438} {:db/id #edb/ref 17592186351452} {:db/id #edb/ref 17592186386696} {:db/id #edb/ref 17592186394442} {:db/id #edb/ref 17592186417185} {:db/id #edb/ref 17592186417192} {:db/id #edb/ref 17592186440464} {:db/id #edb/ref 17592186440465} {:db/id #edb/ref 17592186440469} {:db/id #edb/ref 17592186486427} {:db/id #edb/ref 17592186486444}] :knowledge-point/title "Finding the Coordinates of a Vector in a New Basis Given the Inverse Change-of-Coordinates Matrix"} :step/id #uuid "45243fec-9ed2-54d8-b6ef-0d2c0a1e7087" :step/math-academy-id 17541 :step/next {:db/id #edb/ref 17592186125364}} {:db/id #edb/ref 17592186125364 :step/content {:db/id #edb/ref 17592186124497 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124310 :question/id #uuid "a2d3629f-5b7c-5b65-998f-8754ff11e7b7" :question/math-academy-id "e-4841"} :knowledge-point/id #uuid "7f58bd46-07f7-54a5-8499-5e4e3515b610" :knowledge-point/questions [{:db/id #edb/ref 17592186124993} {:db/id #edb/ref 17592186125036} {:db/id #edb/ref 17592186247377} {:db/id #edb/ref 17592186247379} {:db/id #edb/ref 17592186351453} {:db/id #edb/ref 17592186394414} {:db/id #edb/ref 17592186394421} {:db/id #edb/ref 17592186417184} {:db/id #edb/ref 17592186436248} {:db/id #edb/ref 17592186440470} {:db/id #edb/ref 17592186486397}] :knowledge-point/title "Finding the Coordinates of a Vector in a New Basis Given Its Coordinates in the Standard Basis"} :step/id #uuid "9fa2d20c-055f-5364-a1f7-12e38362db0d" :step/math-academy-id 17542 :step/next {:db/id #edb/ref 17592186125667}} {:db/id #edb/ref 17592186125498 :step/content {:db/id #edb/ref 17592186124577 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124384 :question/id #uuid "f04f55d3-40ec-52a8-a762-d8ac7090b8b8" :question/math-academy-id "e-7276"} :knowledge-point/id #uuid "36f8f02f-acbd-5930-bd0c-8675ac868577" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048920}] :knowledge-point/questions [{:db/id #edb/ref 17592186124992} {:db/id #edb/ref 17592186125041} {:db/id #edb/ref 17592186247393} {:db/id #edb/ref 17592186247395} {:db/id #edb/ref 17592186351440} {:db/id #edb/ref 17592186351443} {:db/id #edb/ref 17592186351454} {:db/id #edb/ref 17592186386703} {:db/id #edb/ref 17592186394449} {:db/id #edb/ref 17592186417188} {:db/id #edb/ref 17592186417189} {:db/id #edb/ref 17592186417191} {:db/id #edb/ref 17592186436249} {:db/id #edb/ref 17592186440463} {:db/id #edb/ref 17592186440467} {:db/id #edb/ref 17592186440468}] :knowledge-point/title "Finding the Coordinates of a Vector in a New Basis Given Its Coordinates in Another Basis"} :step/id #uuid "2c41659c-3fb0-58d9-904f-2296e677eb6c" :step/math-academy-id 26946} {:db/id #edb/ref 17592186125500 :step/content {:db/id #edb/ref 17592186125822 :tutorial/content "We've seen that to find the coordinates of a vector $\\mathbf{x}$ relative to a basis $\\mathcal{C}$ given its coordinates relative to a basis $\\mathcal B,$ we can use the formula\n\n$$\n\\begin{aligned}[\\,x\\,]_{C}={P}_{B\\to C}\\cdot [\\,x\\,]_{B}.\\end{aligned}\n$$\n\nIn expanded form, the formula looks as follows:\n![](images/89/890f34433211786e2cb8aa71057de40bdf3b12678c2bbb5a79ef5e680555937f.svg)\n\nAlso, remember that the change-of-coordinates matrix from $\\color{blue}\\mathcal{B}$ to $\\color{red}\\mathcal{C}$ and from $\\color{red}\\mathcal{C}$ to $\\color{blue}\\mathcal{B}$ are the inverses of each other:\n\n$$\nP_{\\small{\\color{red}\\mathcal{C}}\\to{\\color{blue}\\mathcal{B}}} = P_{\\small{\\color{blue}\\mathcal{B}}\\to{\\color{red}\\mathcal{C}}}^{-1}\n\t\\quad\\textrm{and}\\quad\n\tP_{\\small{\\color{blue}\\mathcal{B}}\\to{\\color{red}\\mathcal{C}}} = P_{\\small{\\color{red}\\mathcal{C}}\\to{\\color{blue}\\mathcal{B}}}^{-1}\n$$" :tutorial/id #uuid "cfffdf8e-9e9f-5304-8249-54a094cc7c11" :tutorial/math-academy-id 4435 :tutorial/title "The Change-of-Basis Formula in Expanded Form"} :step/id #uuid "4c4259ae-ebd7-5d31-ae41-72156cefc066" :step/math-academy-id 27272 :step/next {:db/id #edb/ref 17592186125362}} {:db/id #edb/ref 17592186125667 :step/content {:db/id #edb/ref 17592186125708 :tutorial/content "Let $\\mathcal{B}=\\{ \\mathbf{b}_1,\\mathbf{b}_2 \\}$ and $\\mathcal{C}=\\{ \\mathbf{c}_1,\\mathbf{c}_2 \\}$ be bases of $\\mathbb{R}^2.$ Now, suppose we would like to find the coordinates of $\\mathbf{b}_1$ and $\\mathbf{b}_2$ relative to the basis $\\mathcal{C}.$ \n\n- We first need to find $x_1$ and $x_2$ such that \n\n$$\nx_1 \\mathbf{c}_1+x_2 \\mathbf{c}_2 = \\mathbf{b}_1,\n$$\n\nwhich is equivalent to solving the system with the augmented matrix\n![](images/58/58010a2a5206e3fc27e3d924de70cf32dcc92c3578bdb2821ace7278fbb223cf.svg)\n\n- Similarly, we need to find $y_1$ and $y_2$ such that \n\n$$\ny_1 \\mathbf{c}_1+y_2 \\mathbf{c}_2 = \\mathbf{b}_2,\n$$\n\nwhich is equivalent to solving the system with the augmented matrix\n![](images/68/68788aa3e388c5cba14662a947c1b7afaacb95f611c256d11a7a6d7614c352b9.svg)\n\nWe can solve both systems using Gaussian elimination. However, we can do that simultaneously by considering the matrix\n![](images/4b/4b00a4cbd7831f6da6acd06a087d5453bd455a89eb81f6b3036b1b572bb064d1.svg)\n\nReducing the left-hand side to reduced row-echelon form using Gaussian elimination, we get a matrix of the form\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}1 & 0 & {x}_{1} & {y}_{1} \\\\ 0 & 1 & {x}_{2} & {y}_{2}\\end{aligned}],\\end{aligned}\n$$\n\nwhere the required coefficients will be stored in the columns on the right-hand side." :tutorial/id #uuid "d42ee304-2e1f-5cc2-b334-65d083ea7323" :tutorial/math-academy-id 13287 :tutorial/title "Using Gaussian Elimination to Find the Coordinates of a Vector in a New Basis"} :step/id #uuid "184b8c31-de1a-5e34-ad87-2f626c830182" :step/math-academy-id 462199 :step/next {:db/id #edb/ref 17592186125498}}] :activity/title "Changing a Basis Using the Change-of-Coordinates Matrix" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186124710}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186436253} :activity/id #uuid "3b5b7055-d6b7-5899-a741-daa60aef491a" :activity/scope {:db/id #edb/ref 17592186048769 :topic/id #uuid "bd333eb5-72e6-5eaa-be12-c6bf36306b90" :topic/math-academy-id 1910} :activity/steps [{:db/id #edb/ref 17592186436250 :step/content {:db/id #edb/ref 17592186386696 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ef569771-c4e7-5291-a02a-eccb98516f64" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}16 \\\\ 42\\end{aligned}]" :db/id #edb/ref 17592186386698} {:answer/id #uuid "19f40148-c027-5e57-83ca-f9ce5e2e487f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}8 \\\\ 13\\end{aligned}]" :db/id #edb/ref 17592186386699} {:answer/id #uuid "f2dbac90-d79d-5e74-a3e8-3e28846fd99d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}-4 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186386700} {:answer/id #uuid "8aadec7c-66e6-5275-836d-0b2d825fbd7b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}28 \\\\ 18\\end{aligned}]" :db/id #edb/ref 17592186386701} {:answer/id #uuid "54154bb7-e3f6-55f0-b690-aed92908791b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}-16 \\\\ 26\\end{aligned}]" :db/id #edb/ref 17592186386702}] :answer-field/correct {:db/id #edb/ref 17592186386701} :answer-field/id #uuid "30675a92-d5d0-5d0c-a77d-9c525c8b8db4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186386697}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6ed39867-0f3e-5f3d-ab65-536828c9ba67" :question/math-academy-id "q-113573" :question/problem "The change-of-coordinates matrix from $B=\\{{b}_{1},{b}_{2}\\}$ to $C=\\{{c}_{1},{c}_{2}\\}$ is given below. Find $[x]_{B}$ given that $x=2{c}_{1}-4{c}_{2}.$\n\n$$\n{P}_{B\\to C}=[\\begin{aligned}2 & -3 \\\\ 5 & -8\\end{aligned}]\n$$" :question/worked-solution "We will use the change-of-coordinates formula in the form\n\n$$\n[\\,x\\,]_{B}={P}_{C\\to B}[\\,x\\,]_{C}.\n$$\n\nFirst, we need to find the change-of-coordinates matrix ${P}_{C\\to B}$ from $C$ to $B.$ To do that, we compute the inverse of ${P}_{B\\to C}:$\n\n$$\n\\begin{aligned}{P}_{C\\to B} & ={P}_{B\\to C}^{-1} \\\\  & ={[\\begin{aligned}2 & -3 \\\\ 5 & -8\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{2\\cdot (-8)-(-3)\\cdot 5}[\\begin{aligned}-8 & 3 \\\\ -5 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}8 & -3 \\\\ 5 & -2\\end{aligned}]\\end{aligned}\n$$\n\nNotice that since $x=2{c}_{1}-4{c}_{2},$ we obtain\n\n$$\n[x]_{C}=[\\begin{aligned}2 \\\\ -4\\end{aligned}].\n$$\n\nNow, we compute $[\\,x\\,]_{B}:$\n\n$$\n\\begin{aligned}[\\,x\\,]_{B} & ={P}_{C\\to B}[\\,x\\,]_{C} \\\\  & =[\\begin{aligned}8 & -3 \\\\ 5 & -2\\end{aligned}][\\begin{aligned}2 \\\\ -4\\end{aligned}] \\\\  & =[\\begin{aligned}28 \\\\ 18\\end{aligned}]\\end{aligned}\n$$"} :step/id #uuid "4de2c56b-39c0-5e14-a7fb-e708db903e6f" :step/next {:db/id #edb/ref 17592186436251}} {:db/id #edb/ref 17592186436251 :step/content {:db/id #edb/ref 17592186436248 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "426822c2-147e-581d-8735-96a3bffe8321" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}-12 \\\\ 6\\end{aligned}]" :db/id #edb/ref 17592186436236} {:answer/id #uuid "5c39bc95-ae02-5c17-9a57-15db094b94c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}-2 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186436238} {:answer/id #uuid "89f6cf40-819f-5c6b-aeaf-667b443a0b60" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}2 \\\\ 11\\end{aligned}]" :db/id #edb/ref 17592186436240} {:answer/id #uuid "e55ca324-fff5-5f74-ad7a-3c6af6f7f1cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}36 \\\\ 13\\end{aligned}]" :db/id #edb/ref 17592186436244} {:answer/id #uuid "ef9b888d-cda8-5e1c-bef9-2a98c4f74288" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}-22 \\\\ 27\\end{aligned}]" :db/id #edb/ref 17592186436245}] :answer-field/correct {:db/id #edb/ref 17592186436238} :answer-field/id #uuid "c1014636-1510-50f6-b488-e3fe8d24c13d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186436247}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0e4c9378-b054-5da6-b199-f46a138a46d3" :question/math-academy-id "q-113603" :question/problem "$$\nB=\\{[\\begin{aligned}5 \\\\ 3\\end{aligned}],[\\begin{aligned}6 \\\\ 4\\end{aligned}]\\},\\,[x]_{S}=[\\begin{aligned}8 \\\\ 6\\end{aligned}]\n$$\n\nThe basis $B$ of ${R}^{2}$ and the coordinates of the vector $x$ relative to the standard basis $S$ are given above. Find $[x]_{B}.$" :question/worked-solution "We will use the change-of-coordinates formula in the form\n\n$$\n[\\,x\\,]_{B}={P}_{S\\to B}[\\,x\\,]_{S}.\n$$\n\nFirst, recall that the change-of-coordinates matrix from $B$ to $S$ is the matrix whose columns are the vectors of $B$ relative to the standard basis $S.$ As a result, we have\n\n$$\n{P}_{B\\to S}=[\\begin{aligned}5 & 6 \\\\ 3 & 4\\end{aligned}].\n$$\n\nNow, we need to find the change-of-coordinates matrix ${P}_{S\\to B}$ from $S$ to $B.$ To do that, we compute the inverse of ${P}_{B\\to S}:$\n\n$$\n\\begin{aligned}{P}_{S\\to B} & ={P}_{B\\to S}^{-1} \\\\  & ={[\\begin{aligned}5 & 6 \\\\ 3 & 4\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{5\\cdot 4-6\\cdot 3}[\\begin{aligned}4 & -6 \\\\ -3 & 5\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -3 \\\\ -\\frac{3}{2} & \\frac{5}{2}\\end{aligned}]\\end{aligned}\n$$\n\nFinally, we compute $[\\,x\\,]_{B}:$\n\n$$\n\\begin{aligned}[\\,x\\,]_{B} & ={P}_{S\\to B}[\\,x\\,]_{S} \\\\  & =[\\begin{aligned}2 & -3 \\\\ -\\frac{3}{2} & \\frac{5}{2}\\end{aligned}][\\begin{aligned}8 \\\\ 6\\end{aligned}] \\\\  & =[\\begin{aligned}-2 \\\\ 3\\end{aligned}]\\end{aligned}\n$$"} :step/id #uuid "4f40a8b0-4293-52f4-8c95-85c75998d506" :step/next {:db/id #edb/ref 17592186436252}} {:db/id #edb/ref 17592186436252 :step/content {:db/id #edb/ref 17592186247379 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05662116-9ed5-51f3-a508-b1ed64f2e349" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}5 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186244359} {:answer/id #uuid "33a9596f-e4e0-5e92-b079-84b8cbdda157" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}-6 \\\\ -11\\end{aligned}]" :db/id #edb/ref 17592186244776} {:answer/id #uuid "7294001d-9a70-5e64-8833-bfc2b3f3c0db" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}25 \\\\ 6\\end{aligned}]" :db/id #edb/ref 17592186245337} {:answer/id #uuid "b6b79f00-6365-55a2-9673-e57f0f1960c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}16 \\\\ 21\\end{aligned}]" :db/id #edb/ref 17592186245947} {:answer/id #uuid "f5b08e24-4041-566d-9201-1f4cbd15de31" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}19 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186246483}] :answer-field/correct {:db/id #edb/ref 17592186244359} :answer-field/id #uuid "12b31fac-75a2-50ec-9978-bbb512fe8ff1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186246582}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "162a4f62-2177-5623-998d-5746dbddde07" :question/math-academy-id "q-113606" :question/problem "$$\nB=\\{[\\begin{aligned}5 \\\\ -3\\end{aligned}],[\\begin{aligned}-7 \\\\ 6\\end{aligned}]\\},\\,[x]_{S}=[\\begin{aligned}18 \\\\ -9\\end{aligned}]\n$$\n\nThe basis $B$ of ${R}^{2}$ and the coordinates of the vector $x$ relative to the standard basis $S$ are given above. Find $[x]_{B}.$" :question/worked-solution "We will use the change-of-coordinates formula in the form\n\n$$\n[\\,x\\,]_{B}={P}_{S\\to B}[\\,x\\,]_{S}.\n$$\n\nFirst, recall that the change-of-coordinates matrix from $B$ to $S$ is the matrix whose columns are the vectors of $B$ relative to the standard basis $S.$ As a result, we have\n\n$$\n{P}_{B\\to S}=[\\begin{aligned}5 & -7 \\\\ -3 & 6\\end{aligned}].\n$$\n\nNow, we need to find the change-of-coordinates matrix ${P}_{S\\to B}$ from $S$ to $B.$ To do that, we compute the inverse of ${P}_{B\\to S}:$\n\n$$\n\\begin{aligned}{P}_{S\\to B} & ={P}_{B\\to S}^{-1} \\\\  & ={[\\begin{aligned}5 & -7 \\\\ -3 & 6\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{5\\cdot 6-(-7)\\cdot (-3)}[\\begin{aligned}6 & 7 \\\\ 3 & 5\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{2}{3} & \\frac{7}{9} \\\\ \\frac{1}{3} & \\frac{5}{9}\\end{aligned}]\\end{aligned}\n$$\n\nFinally, we compute $[\\,x\\,]_{B}:$\n\n$$\n\\begin{aligned}[\\,x\\,]_{B} & ={P}_{S\\to B}[\\,x\\,]_{S} \\\\  & =[\\begin{aligned}\\frac{2}{3} & \\frac{7}{9} \\\\ \\frac{1}{3} & \\frac{5}{9}\\end{aligned}][\\begin{aligned}18 \\\\ -9\\end{aligned}] \\\\  & =[\\begin{aligned}5 \\\\ 1\\end{aligned}]\\end{aligned}\n$$"} :step/id #uuid "77dfbfe9-ef7f-5713-be40-7bce1749b9a7" :step/next {:db/id #edb/ref 17592186436254}} {:db/id #edb/ref 17592186436253 :step/content {:db/id #edb/ref 17592186323807 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e412cca-3de6-5980-bb99-cf3bccf43fec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}6 \\\\ -4\\end{aligned}]" :db/id #edb/ref 17592186321257} {:answer/id #uuid "137c55e3-1ce7-52fa-871f-4778b481186a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}-2 \\\\ 5\\end{aligned}]" :db/id #edb/ref 17592186321301} {:answer/id #uuid "930eac4b-99c1-548d-911a-4f0dbf0771a4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}5 \\\\ -6\\end{aligned}]" :db/id #edb/ref 17592186322310} {:answer/id #uuid "9dd98043-a25b-5027-a9f0-593fb49217d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}6 \\\\ 5\\end{aligned}]" :db/id #edb/ref 17592186322391} {:answer/id #uuid "d2cab1f4-06ce-5d69-9f7d-a3f736d395e9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}-5 \\\\ 6\\end{aligned}]" :db/id #edb/ref 17592186322794}] :answer-field/correct {:db/id #edb/ref 17592186322391} :answer-field/id #uuid "3e47d3d8-0d42-5d02-8f6a-ceceea2fa24c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186323291}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "76994fe0-8052-50ba-9dfa-9fe567d9b172" :question/math-academy-id "q-36485" :question/problem "The change-of-coordinates matrix from $B$ to $C$ and the coordinates of the vector $x$ relative to the basis $C$ are given below. What is $[x]_{B}?$ \n\n$$\n{P}_{B\\to C}=[\\begin{aligned}-2 & 3 \\\\ 3 & -4\\end{aligned}],\\,[x]_{C}=[\\begin{aligned}3 \\\\ -2\\end{aligned}]\n$$" :question/worked-solution "We will use the change-of-coordinates formula in the form\n\n$$\n[\\,x\\,]_{B}={P}_{C\\to B}[\\,x\\,]_{C}.\n$$\n\nFirst, we need to find the change-of-coordinates matrix ${P}_{C\\to B}$ from $C$ to $B.$ To do that, we compute the inverse of ${P}_{B\\to C}:$\n\n$$\n\\begin{aligned}{P}_{C\\to B} & ={P}_{B\\to C}^{-1} \\\\  & ={[\\begin{aligned}-2 & 3 \\\\ 3 & -4\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{(-2)\\cdot (-4)-3\\cdot 3}[\\begin{aligned}-4 & -3 \\\\ -3 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}4 & 3 \\\\ 3 & 2\\end{aligned}]\\end{aligned}\n$$\n\nNow, we compute $[\\,x\\,]_{B}:$\n\n$$\n\\begin{aligned}[\\,x\\,]_{B} & ={P}_{C\\to B}[\\,x\\,]_{C} \\\\  & =[\\begin{aligned}4 & 3 \\\\ 3 & 2\\end{aligned}][\\begin{aligned}3 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}6 \\\\ 5\\end{aligned}]\\end{aligned}\n$$"} :step/id #uuid "a2ad54ea-289c-5268-9e48-3009985055d0" :step/next {:db/id #edb/ref 17592186436250}} {:db/id #edb/ref 17592186436254 :step/content {:db/id #edb/ref 17592186436249 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ef4749a-0f85-5a2d-a5e3-df28976db7b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}-3 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186436237} {:answer/id #uuid "75556eec-854e-532d-9072-0581f7715993" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}11 \\\\ -4\\end{aligned}]" :db/id #edb/ref 17592186436239} {:answer/id #uuid "a95465bd-ca1b-539b-b564-dc5450e2c673" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}-1 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186436241} {:answer/id #uuid "d0811b3a-bd66-51ab-9df6-b54f8983cb5f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}13 \\\\ 6\\end{aligned}]" :db/id #edb/ref 17592186436242} {:answer/id #uuid "d3c4b9b8-c843-5d6e-98b0-ea1b8a725222" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}4 \\\\ -5\\end{aligned}]" :db/id #edb/ref 17592186436243}] :answer-field/correct {:db/id #edb/ref 17592186436237} :answer-field/id #uuid "54566980-7132-5fea-9868-d89904943d38" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186436246}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "8d0458bf-0ded-5bc5-82a5-015d07a4533d" :question/math-academy-id "q-113615" :question/problem "$$\nB=\\{[\\begin{aligned}2 \\\\ 2\\end{aligned}],[\\begin{aligned}3 \\\\ 4\\end{aligned}]\\},\\,C=\\{[\\begin{aligned}2 \\\\ 3\\end{aligned}],[\\begin{aligned}1 \\\\ 4\\end{aligned}]\\},\\,[x]_{C}=[\\begin{aligned}-2 \\\\ 1\\end{aligned}]\n$$\n\nThe bases $B$ and $C$ of ${R}^{2}$ and the coordinates of the vector $x$ relative to the basis $C$ are given above. Find $[x]_{B}.$" :question/worked-solution "Let's denote the vectors of $B$ and $C$ as $\\{{b}_{1},{b}_{2}\\}$ and $\\{{c}_{1},{c}_{2}\\}$, respectively.\n\nThe change-of-coordinates matrix from $C$ to $B$ is a matrix whose columns are the vectors of $C$ relative to the basis $B.$\n\nHence, we need to find the coordinates of ${c}_{1}$ and ${c}_{2}$ relative to the basis $B.$ We can do this simultaneously by considering the matrix\n\n$$\nM=[\\begin{aligned}| & | & | & | \\\\ {b}_{1} & {b}_{2} & {c}_{1} & {c}_{2} \\\\ | & | & | & |\\end{aligned}].\n$$\n\nNow, we simply reduce the left-hand side to reduced row-echelon form using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}2 & 3 & 2 & 1 \\\\ 2 & 4 & 3 & 4\\end{aligned}] & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\  & ∼[\\begin{aligned}2 & 3 & 2 & 1 \\\\ 0 & 1 & 1 & 3\\end{aligned}] & {R}_{1} & :={R}_{1}+(-3){R}_{2} \\\\  & ∼[\\begin{aligned}2 & 0 & -1 & -8 \\\\ 0 & 1 & 1 & 3\\end{aligned}] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & -\\frac{1}{2} & -4 \\\\ 0 & 1 & 1 & 3\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the change-of-coordinates matrix ${P}_{C\\to B}$ is\n\n$$\n{P}_{C\\to B}=[\\begin{aligned}-\\frac{1}{2} & -4 \\\\ 1 & 3\\end{aligned}].\n$$\n\nFinally, we compute $[\\,x\\,]_{B}:$\n\n$$\n\\begin{aligned}[\\,x\\,]_{B} & ={P}_{C\\to B}[\\,x\\,]_{C} \\\\  & =[\\begin{aligned}-\\frac{1}{2} & -4 \\\\ 1 & 3\\end{aligned}][\\begin{aligned}-2 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}-3 \\\\ 1\\end{aligned}]\\end{aligned}\n$$"} :step/id #uuid "f5e3b29d-0add-527d-a99b-25156b6317ea"}] :activity/title "Changing a Basis Using the Change-of-Coordinates Matrix" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186436235}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186486512} :activity/id #uuid "123b57a8-59a0-5d9a-805f-fed4b8283678" :activity/scope {:db/id #edb/ref 17592186048769 :topic/id #uuid "bd333eb5-72e6-5eaa-be12-c6bf36306b90" :topic/math-academy-id 1910} :activity/steps [{:db/id #edb/ref 17592186486482 :step/content {:db/id #edb/ref 17592186486397 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e5944a2-6f72-5f21-8b24-e64767793229" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}4 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186486018} {:answer/id #uuid "9f66dc53-0b31-5237-969a-2397bba21b1b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}-1 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186486050} {:answer/id #uuid "ae2979c6-49e8-5225-824c-1a6f38548151" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}1 \\\\ -4\\end{aligned}]" :db/id #edb/ref 17592186486078} {:answer/id #uuid "b1ffe2c5-8479-52b3-b64d-d795dd8a896a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}-1 \\\\ -2\\end{aligned}]" :db/id #edb/ref 17592186486084} {:answer/id #uuid "c6cc0c71-6572-5be7-b79e-f4264330ac2c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}1 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186486124}] :answer-field/correct {:db/id #edb/ref 17592186486018} :answer-field/id #uuid "d71b80ef-6d4c-597c-814a-17f8214907ee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186486325}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "72bf6680-369b-5d8c-9e49-1546d6428898" :question/math-academy-id "q-113598" :question/problem "$$\nB=\\{[\\begin{aligned}3 \\\\ 1\\end{aligned}],[\\begin{aligned}4 \\\\ 2\\end{aligned}]\\},\\,[x]_{S}=[\\begin{aligned}8 \\\\ 2\\end{aligned}]\n$$\n\nThe basis $B$ of ${R}^{2}$ and the coordinates of the vector $x$ relative to the standard basis $S$ are given above. Find $[x]_{B}.$" :question/worked-solution "We will use the change-of-coordinates formula in the form\n\n$$\n[\\,x\\,]_{B}={P}_{S\\to B}[\\,x\\,]_{S}.\n$$\n\nFirst, recall that the change-of-coordinates matrix from $B$ to $S$ is the matrix whose columns are the vectors of $B$ relative to the standard basis $S.$ As a result, we have\n\n$$\n{P}_{B\\to S}=[\\begin{aligned}3 & 4 \\\\ 1 & 2\\end{aligned}].\n$$\n\nNow, we need to find the change-of-coordinates matrix ${P}_{S\\to B}$ from $S$ to $B.$ To do that, we compute the inverse of ${P}_{B\\to S}:$\n\n$$\n\\begin{aligned}{P}_{S\\to B} & ={P}_{B\\to S}^{-1} \\\\  & ={[\\begin{aligned}3 & 4 \\\\ 1 & 2\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{3\\cdot 2-4\\cdot 1}[\\begin{aligned}2 & -4 \\\\ -1 & 3\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -2 \\\\ -\\frac{1}{2} & \\frac{3}{2}\\end{aligned}]\\end{aligned}\n$$\n\nFinally, we compute $[\\,x\\,]_{B}:$\n\n$$\n\\begin{aligned}[\\,x\\,]_{B} & ={P}_{S\\to B}[\\,x\\,]_{S} \\\\  & =[\\begin{aligned}1 & -2 \\\\ -\\frac{1}{2} & \\frac{3}{2}\\end{aligned}][\\begin{aligned}8 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}4 \\\\ -1\\end{aligned}]\\end{aligned}\n$$"} :step/id #uuid "50c856b2-5de1-5fc6-b8b6-216f5affc71d"} {:db/id #edb/ref 17592186486506 :step/content {:db/id #edb/ref 17592186351454 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "277d51c6-ba77-5bde-a9da-6f2d8333899a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}4 \\\\ 5\\end{aligned}]" :db/id #edb/ref 17592186348786} {:answer/id #uuid "36849b8b-2c62-5eb1-bb53-ebb31890e317" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}6 \\\\ -9\\end{aligned}]" :db/id #edb/ref 17592186348938} {:answer/id #uuid "526976b5-686a-54a2-a200-041c5d48d668" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}8 \\\\ -9\\end{aligned}]" :db/id #edb/ref 17592186349197} {:answer/id #uuid "8056b724-3039-56ac-ac48-651200dd450e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}1 \\\\ -7\\end{aligned}]" :db/id #edb/ref 17592186349623} {:answer/id #uuid "9abeb6bd-73c2-5d7d-9344-2f69c899f0c9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}-3 \\\\ 6\\end{aligned}]" :db/id #edb/ref 17592186349825}] :answer-field/correct {:db/id #edb/ref 17592186348938} :answer-field/id #uuid "a8cbbee3-2e8a-56b1-9089-55eda08012bc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186350995}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "49aa77db-aeb3-5225-bb69-221318751e9a" :question/math-academy-id "q-82718" :question/problem "$$\nB=\\{[\\begin{aligned}0 \\\\ 1\\end{aligned}],[\\begin{aligned}-6 \\\\ 1\\end{aligned}]\\},\\,C=\\{[\\begin{aligned}3 \\\\ 2\\end{aligned}],[\\begin{aligned}0 \\\\ 1\\end{aligned}]\\},\\,[x]_{B}=[\\begin{aligned}6 \\\\ -3\\end{aligned}].\n$$\n\n \n\nThe bases $B$ and $C$ of ${R}^{2}$ and the coordinates of the vector $x$ relative to the basis $B$ are given above. Find $[x]_{C}.$" :question/worked-solution "Let's denote the vectors of $B$ and $C$ as $\\{{b}_{1},{b}_{2}\\}$ and $\\{{c}_{1},{c}_{2}\\}$, respectively.\n\nThe change-of-coordinates matrix from $B$ to $C$ is a matrix whose columns are the vectors of $B$ relative to the basis $C.$\n\nHence, we need to find the coordinates of ${b}_{1}$ and ${b}_{2}$ relative to the basis $C.$ We can do this simultaneously by considering the matrix\n\n$$\nM=[\\begin{aligned}| & | & | & | \\\\ {c}_{1} & {c}_{2} & {b}_{1} & {b}_{2} \\\\ | & | & | & |\\end{aligned}].\n$$\n\nNow, we simply reduce the left-hand side to reduced row-echelon form using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}3 & 0 & 0 & -6 \\\\ 2 & 1 & 1 & 1\\end{aligned}] & {R}_{1} & :=\\frac{1}{3}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & -2 \\\\ 2 & 1 & 1 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & -2 \\\\ 0 & 1 & 1 & 5\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the change-of-coordinates matrix ${P}_{B\\to C}$ is\n\n$$\n{P}_{B\\to C}=[\\begin{aligned}0 & -2 \\\\ 1 & 5\\end{aligned}].\n$$\n\nFinally, we compute $[\\,x\\,]_{C}:$\n\n$$\n\\begin{aligned}[\\,x\\,]_{C} & ={P}_{B\\to C}[\\,x\\,]_{B} \\\\  & =[\\begin{aligned}0 & -2 \\\\ 1 & 5\\end{aligned}][\\begin{aligned}6 \\\\ -3\\end{aligned}] \\\\  & =[\\begin{aligned}6 \\\\ -9\\end{aligned}]\\end{aligned}\n$$"} :step/id #uuid "b02f895b-b4b9-567f-99da-8866008266c1" :step/next {:db/id #edb/ref 17592186486517}} {:db/id #edb/ref 17592186486510 :step/content {:db/id #edb/ref 17592186125036 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7b3fc777-c87e-5494-9361-753fc99b8a92" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}-5 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186417145} {:answer/id #uuid "af2e1656-5790-518b-ae95-17ddec42b6bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}3 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186417157} {:answer/id #uuid "c820d187-6507-5a27-8119-ca85d381bd74" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}-3 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186417165} {:answer/id #uuid "d1949552-5c2a-51ed-85be-630d9f8df6a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}-3 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186417166} {:answer/id #uuid "fc368894-a420-5e78-a8ce-445dfc038e7c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}3 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186417173}] :answer-field/correct {:db/id #edb/ref 17592186417166} :answer-field/id #uuid "77968fba-758e-5c47-b717-abe8d60fbc59" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186417179}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "618e1711-d591-5872-b815-9d14ad33b674" :question/math-academy-id "q-37160" :question/problem "$$\nB=\\{[\\begin{aligned}1 \\\\ 3\\end{aligned}],[\\begin{aligned}5 \\\\ 16\\end{aligned}]\\},\\,[x]_{S}=[\\begin{aligned}2 \\\\ 7\\end{aligned}]\n$$\n\nThe basis $B$ of ${R}^{2}$ and the coordinates of the vector $x$ relative to the standard basis $S$ are given above. Find $[x]_{B}.$" :question/worked-solution "We will use the change-of-coordinates formula in the form\n\n$$\n[\\,x\\,]_{B}={P}_{S\\to B}[\\,x\\,]_{S}.\n$$\n\nFirst, recall that the change-of-coordinates matrix from $B$ to $S$ is the matrix whose columns are the vectors of $B$ relative to the standard basis $S.$ As a result, we have\n\n$$\n{P}_{B\\to S}=[\\begin{aligned}1 & 5 \\\\ 3 & 16\\end{aligned}].\n$$\n\nNow, we need to find the change-of-coordinates matrix ${P}_{S\\to B}$ from $S$ to $B.$ To do that, we compute the inverse of ${P}_{B\\to S}:$\n\n$$\n\\begin{aligned}{P}_{S\\to B} & ={P}_{B\\to S}^{-1} \\\\  & ={[\\begin{aligned}1 & 5 \\\\ 3 & 16\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{1\\cdot 16-3\\cdot 5}[\\begin{aligned}16 & -5 \\\\ -3 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}16 & -5 \\\\ -3 & 1\\end{aligned}]\\end{aligned}\n$$\n\nFinally, we compute $[\\,x\\,]_{B}:$\n\n$$\n\\begin{aligned}[\\,x\\,]_{B} & ={P}_{S\\to B}[\\,x\\,]_{S} \\\\  & =[\\begin{aligned}16 & -5 \\\\ -3 & 1\\end{aligned}][\\begin{aligned}2 \\\\ 7\\end{aligned}] \\\\  & =[\\begin{aligned}-3 \\\\ 1\\end{aligned}]\\end{aligned}\n$$"} :step/id #uuid "cea4b00d-cc11-568c-8bd2-36b2db4582ec" :step/next {:db/id #edb/ref 17592186486506}} {:db/id #edb/ref 17592186486512 :step/content {:db/id #edb/ref 17592186486427 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1696c49c-b8ba-5c9f-a1e2-a234d7a12381" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}5 \\\\ -5\\end{aligned}]" :db/id #edb/ref 17592186485804} {:answer/id #uuid "33eeaaae-80c9-51a7-944e-f618a820b3bb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}1 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186485862} {:answer/id #uuid "35031deb-a4ba-5495-89d6-18fe7aca9f79" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}-2 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186485864} {:answer/id #uuid "bb2528e3-8cd1-5c53-9f19-daeb351a37d2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}-1 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186486101} {:answer/id #uuid "e673df76-6d49-52f2-85e7-cffc12218f67" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}2 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186486189}] :answer-field/correct {:db/id #edb/ref 17592186486101} :answer-field/id #uuid "d0731c0a-4746-54da-b38a-46b9b2e964b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186486320}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ae7fdbe5-ac31-5cc5-8e79-33235643a822" :question/math-academy-id "q-36502" :question/problem "The change-of-coordinates matrix from $B=\\{{b}_{1},{b}_{2}\\}$ to $C=\\{{c}_{1},{c}_{2}\\}$ is given below. Find $[x]_{B}$ given that $x={c}_{1}+4{c}_{2}.$\n\n$$\n{P}_{B\\to C}=[\\begin{aligned}2 & 3 \\\\ 6 & 10\\end{aligned}]\n$$" :question/worked-solution "We will use the change-of-coordinates formula in the form\n\n$$\n[\\,x\\,]_{B}={P}_{C\\to B}[\\,x\\,]_{C}.\n$$\n\nFirst, we need to find the change-of-coordinates matrix ${P}_{C\\to B}$ from $C$ to $B.$ To do that, we compute the inverse of ${P}_{B\\to C}:$\n\n$$\n\\begin{aligned}{P}_{C\\to B} & ={P}_{B\\to C}^{-1} \\\\  & ={[\\begin{aligned}2 & 3 \\\\ 6 & 10\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{2\\cdot 10-6\\cdot 3}[\\begin{aligned}10 & -3 \\\\ -6 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}5 & -\\frac{3}{2} \\\\ -3 & 1\\end{aligned}]\\end{aligned}\n$$\n\nNotice that since $x={c}_{1}+4{c}_{2},$ we obtain\n\n$$\n[x]_{C}=[\\begin{aligned}1 \\\\ 4\\end{aligned}].\n$$\n\nNow, we compute $[\\,x\\,]_{B}:$\n\n$$\n\\begin{aligned}[\\,x\\,]_{B} & ={P}_{C\\to B}[\\,x\\,]_{C} \\\\  & =[\\begin{aligned}5 & -\\frac{3}{2} \\\\ -3 & 1\\end{aligned}][\\begin{aligned}1 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}-1 \\\\ 1\\end{aligned}]\\end{aligned}\n$$"} :step/id #uuid "d7f877e0-9517-58da-83be-55a89211a009" :step/next {:db/id #edb/ref 17592186486510}} {:db/id #edb/ref 17592186486517 :step/content {:db/id #edb/ref 17592186486444 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15690e8b-c556-578a-a848-9e2012319066" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}-2 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186485801} {:answer/id #uuid "2ce04a03-a227-57a9-bb1f-9d7b6996fb5a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}-3 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186485848} {:answer/id #uuid "972d0aed-9872-5a09-9680-0c04b590dfee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}3 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186486037} {:answer/id #uuid "b85661ff-f141-5e76-a9a5-e29f75d6b6b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}3 \\\\ -2\\end{aligned}]" :db/id #edb/ref 17592186486097} {:answer/id #uuid "d2bcf6bc-21ea-5ab1-b19b-a0bda85a2f8c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}2 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186486151}] :answer-field/correct {:db/id #edb/ref 17592186486097} :answer-field/id #uuid "f917e741-700b-51ed-9e8c-db10a05c79b2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186486345}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cd3d1f8f-1ec9-5277-bd94-fc774bb919de" :question/math-academy-id "q-113595" :question/problem "The change-of-coordinates matrix from $B=\\{{b}_{1},{b}_{2}\\}$ to $C=\\{{c}_{1},{c}_{2}\\}$ is given below. Find $[x]_{B}$ given that $x=2{c}_{1}-{c}_{2}.$\n\n$$\n{P}_{B\\to C}=[\\begin{aligned}4 & 5 \\\\ 3 & 5\\end{aligned}]\n$$" :question/worked-solution "We will use the change-of-coordinates formula in the form\n\n$$\n[\\,x\\,]_{B}={P}_{C\\to B}[\\,x\\,]_{C}.\n$$\n\nFirst, we need to find the change-of-coordinates matrix ${P}_{C\\to B}$ from $C$ to $B.$ To do that, we compute the inverse of ${P}_{B\\to C}:$\n\n$$\n\\begin{aligned}{P}_{C\\to B} & ={P}_{B\\to C}^{-1} \\\\  & ={[\\begin{aligned}4 & 5 \\\\ 3 & 5\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{4\\cdot 5-5\\cdot 3}[\\begin{aligned}5 & -5 \\\\ -3 & 4\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -1 \\\\ -\\frac{3}{5} & \\frac{4}{5}\\end{aligned}]\\end{aligned}\n$$\n\nNotice that since $x=2{c}_{1}-{c}_{2},$ we obtain \n\n$$\n[x]_{C}=[\\begin{aligned}2 \\\\ -1\\end{aligned}].\n$$\n\n \n\nNow, we compute $[\\,x\\,]_{B}:$\n\n$$\n\\begin{aligned}[\\,x\\,]_{B} & ={P}_{C\\to B}[\\,x\\,]_{C} \\\\  & =[\\begin{aligned}1 & -1 \\\\ -\\frac{3}{5} & \\frac{4}{5}\\end{aligned}][\\begin{aligned}2 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}3 \\\\ -2\\end{aligned}]\\end{aligned}\n$$"} :step/id #uuid "e7ff6d11-7ab8-5df7-ab96-cc2f9b5a933c" :step/next {:db/id #edb/ref 17592186486482}}] :activity/title "Changing a Basis Using the Change-of-Coordinates Matrix" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186485749}]}
