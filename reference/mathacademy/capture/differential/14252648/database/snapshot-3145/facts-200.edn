6045417] [17592186573845 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186573845 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186573845 #edb/ref 1078 #edb/ref 17592186573717 #edb/ref 17592186045417] [17592186573845 #edb/ref 1079 #uuid "ccf85ad2-68ea-542a-9e96-be9081261312" #edb/ref 17592186045417] [17592186573869 #edb/ref 1068 #edb/ref 17592186573845 #edb/ref 17592186045417] [17592186573869 #edb/ref 1069 "q-127950" #edb/ref 17592186045417] [17592186573869 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186573869 #edb/ref 1071 "Find $∇f(x,y,z),$  given that $f(x,y,z)=\\frac{1}{({x}^{2}+{y}^{2}+{z}^{2})^{1/2}}.$" #edb/ref 17592186045417] [17592186573869 #edb/ref 1072 #uuid "0d01726f-52af-5592-8eb9-d6abaee05cc0" #edb/ref 17592186045417] [17592186573869 #edb/ref 1074 "First, we find the partial derivatives: \n\n$$\n\\begin{aligned}{f}_{x}(x,y,z) & =\\frac{∂}{∂x}(\\frac{1}{\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}}) \\\\  & =-\\frac{x}{({x}^{2}+{y}^{2}+{z}^{2})^{3/2}} \\\\ {f}_{y}(x,y,z) & =\\frac{∂}{∂y}(\\frac{1}{\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}}) \\\\  & =-\\frac{y}{({x}^{2}+{y}^{2}+{z}^{2})^{3/2}} \\\\ {f}_{z}(x,y,z) & =\\frac{∂}{∂z}(\\frac{1}{\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}}) \\\\  & =-\\frac{z}{({x}^{2}+{y}^{2}+{z}^{2})^{3/2}}.\\end{aligned}\n$$\n\nHence, the gradient is\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\text{ }i+{f}_{y}(x,y,z)\\text{ }j+{f}_{z}(x,y,z)\\text{ }k \\\\  & =(-\\frac{x}{({x}^{2}+{y}^{2}+{z}^{2})^{3/2}})i+(-\\frac{y}{({x}^{2}+{y}^{2}+{z}^{2})^{3/2}})j+(-\\frac{z}{({x}^{2}+{y}^{2}+{z}^{2})^{3/2}})k \\\\  & =-\\frac{1}{({x}^{2}+{y}^{2}+{z}^{2})^{3/2}}(x\\,i+y\\,j+z\\,k)\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186573871 #edb/ref 1068 #edb/ref 17592186573831 #edb/ref 17592186045417] [17592186573871 #edb/ref 1069 "q-127649" #edb/ref 17592186045417] [17592186573871 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186573871 #edb/ref 1071 "If $f(x,y)=\\frac{y}{x}{e}^{x/y},$ find $∇f(x,y).$" #edb/ref 17592186045417] [17592186573871 #edb/ref 1072 #uuid "11d17df4-8621-5dfb-b614-0130a53b1042" #edb/ref 17592186045417] [17592186573871 #edb/ref 1074 "First, we find the partial derivatives: \n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}(\\frac{y}{x}{e}^{x/y}) \\\\  & =(-\\frac{y}{{x}^{2}}+\\frac{y}{x}\\cdot \\frac{1}{y}){e}^{x/y} \\\\  & =\\frac{x-y}{{x}^{2}}{e}^{x/y} \\\\ {f}_{y}(x,y) & =\\frac{∂}{∂y}(\\frac{y}{x}{e}^{x/y}) \\\\  & =(\\frac{1}{x}-\\frac{y}{x}\\cdot \\frac{x}{{y}^{2}}){e}^{x/y} \\\\  & =\\frac{y-x}{xy}{e}^{x/y}\\end{aligned}\n$$\n\nHence, the gradient is\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\text{ }i+{f}_{y}(x,y)\\text{ }j \\\\  & =\\frac{x-y}{{x}^{2}}{e}^{x/y}\\text{ }i+\\frac{y-x}{xy}{e}^{x/y}\\text{ }j.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186573893 #edb/ref 1068 #edb/ref 17592186573821 #edb/ref 17592186045417] [17592186573893 #edb/ref 1069 "q-37341" #edb/ref 17592186045417] [17592186573893 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186573893 #edb/ref 1071 "Evaluate the gradient of $g(x,y)$ at the point $({e}^{2},1)$ if $g(x,y)=(x+y)(\\operatorname{ln}⁡x-{y}^{2}).$" #edb/ref 17592186045417] [17592186573893 #edb/ref 1072 #uuid "6b4c3f21-cba5-5b1e-bb44-0204d0b1fcfa" #edb/ref 17592186045417] [17592186573893 #edb/ref 1074 "First, we find the partial derivatives\n\n$$\n\\begin{aligned}{g}_{x}(x,y) & =\\frac{∂}{∂x}((x+y)(\\operatorname{ln}⁡x-{y}^{2})) \\\\  & =1\\cdot (\\operatorname{ln}⁡x-{y}^{2})+(x+y)\\cdot \\frac{1}{x} \\\\  & =\\operatorname{ln}⁡x-{y}^{2}+1+\\frac{y}{x} \\\\ {g}_{y}(x,y) & =\\frac{∂}{∂y}((x+y)(\\operatorname{ln}⁡x-{y}^{2})) \\\\  & =1\\cdot (\\operatorname{ln}⁡x-{y}^{2})+(x+y)\\cdot (-2y) \\\\  & =\\operatorname{ln}⁡x-{y}^{2}-2xy-2{y}^{2} \\\\  & =\\operatorname{ln}⁡x-3{y}^{2}-2xy\\end{aligned}\n$$\n\nHence, the gradient is \n\n$$\n\\begin{aligned}∇g(x,y) & =⟨{g}_{x}(x,y),\\,{g}_{y}(x,y)⟩ \\\\  & =⟨\\operatorname{ln}⁡x-{y}^{2}+1+\\frac{y}{x},\\,\\operatorname{ln}⁡x-3{y}^{2}-2xy⟩ \\\\ ∇g({e}^{2},1) & =⟨\\operatorname{ln}⁡({e}^{2})-{1}^{2}+1+\\frac{1}{{e}^{2}},\\,\\operatorname{ln}⁡({e}^{2})-3\\cdot {1}^{2}-2\\cdot {e}^{2}\\cdot 1⟩ \\\\  & =⟨2+{e}^{-2},-1-2{e}^{2}⟩\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186573901 #edb/ref 1068 #edb/ref 17592186573786 #edb/ref 17592186045417] [17592186573901 #edb/ref 1069 "q-128524" #edb/ref 17592186045417] [17592186573901 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186573901 #edb/ref 1071 "What is the gradient of the product $f(x,y,z)h(x,y,z)$ if $f(x,y,z)=xyz$ and $h(x,y,z)=\\operatorname{ln}⁡(xyz)?$" #edb/ref 17592186045417] [17592186573901 #edb/ref 1072 #uuid "7f1d01a7-3767-50a6-8161-9fa62992d18d" #edb/ref 17592186045417] [17592186573901 #edb/ref 1074 "The gradient of the product of two functions $f(x,y)$ and $h(x,y)$ is given by\n\n$$\n∇[fh]=f∇h+h∇f.\n$$\n\nNow, we calculate the partial derivatives of $f(x,y,z):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(xyz)=yz \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}(xyz)=xz \\\\ \\frac{∂f}{∂z} & =\\frac{∂}{∂z}(xyz)=xy\\end{aligned}\n$$\n\nHence, \n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\frac{∂f}{∂x}\\text{ }i+\\frac{∂f}{∂y}\\text{ }j+\\frac{∂f}{∂z}\\text{ }k=yz\\text{ }i+xz\\text{ }j+xy\\text{ }k.\\end{aligned}\n$$\n\nNext, we calculate the partial derivatives of $h(x,y,z):$\n\n$$\n\\begin{aligned}\\frac{∂h}{∂x} & =\\frac{∂}{∂x}(\\operatorname{ln}⁡(xyz))=\\frac{1}{x} \\\\ \\frac{∂h}{∂y} & =\\frac{∂}{∂y}(\\operatorname{ln}⁡(xyz))=\\frac{1}{y} \\\\ \\frac{∂h}{∂z} & =\\frac{∂}{∂z}(\\operatorname{ln}⁡(xyz))=\\frac{1}{z}\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}∇h(x,y,z) & =\\frac{∂h}{∂x}\\text{ }i+\\frac{∂h}{∂y}\\text{ }j+\\frac{∂h}{∂z}\\text{ }k \\\\  & =\\frac{1}{x}\\text{ }i+\\frac{1}{y}\\text{ }j+\\frac{1}{z}\\text{ }k.\\end{aligned}\n$$\n\nFinally, using the product rule, we obtain\n\n$$\n\\begin{aligned}∇[f(x,y,z)h(x,y,z)] & =f(x,y,z)∇h(x,y,z)+h(x,y,z)∇f(x,y,z) \\\\  & =xyz(\\frac{1}{x}\\text{ }i+\\frac{1}{y}\\text{ }j+\\frac{1}{z}\\text{ }k)+\\operatorname{ln}⁡(xyz)(yz\\text{ }i+xz\\text{ }j+xy\\text{ }k) \\\\  & =\\frac{xyz}{x}\\text{ }i+\\frac{xyz}{y}\\text{ }j+\\frac{xyz}{z}\\text{ }k+\\operatorname{ln}⁡(xyz)(yz\\text{ }i+xz\\text{ }j+xy\\text{ }k) \\\\  & =yz\\text{ }i+xz\\text{ }j+xy\\text{ }k+\\operatorname{ln}⁡(xyz)(yz\\text{ }i+xz\\text{ }j+xy\\text{ }k) \\\\  & =(1+\\operatorname{ln}⁡(xyz))(yz\\text{ }i+xz\\text{ }j+xy\\text{ }k).\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186573903 #edb/ref 1068 #edb/ref 17592186573833 #edb/ref 17592186045417] [17592186573903 #edb/ref 1069 "q-65135" #edb/ref 17592186045417] [17592186573903 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186573903 #edb/ref 1071 "What is the gradient of the product $f(x,y)g(x,y)$ if $f(x,y)={e}^{x+y}$ and $g(x,y)={x}^{2}+{y}^{2}?$" #edb/ref 17592186045417] [17592186573903 #edb/ref 1072 #uuid "807b4074-7dcc-59b6-a5c1-37bc5db08161" #edb/ref 17592186045417] [17592186573903 #edb/ref 1074 "The gradient of the product of two functions $f(x,y)$ and $g(x,y)$ is given by:\n\n$$\n∇[fg]=f\\,∇\\,g+g\\,∇\\,f\n$$\n\nFirst, we calculate the first order partial derivatives of $f(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}({e}^{x+y})={e}^{x+y} \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}({e}^{x+y})={e}^{x+y}\\end{aligned}\n$$\n\nHence, \n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂f}{∂x}\\text{ }i+\\frac{∂f}{∂y}\\text{ }j={e}^{x+y}\\text{ }i+{e}^{x+y}\\text{ }j.\\end{aligned}\n$$\n\nNext, we calculate the partial derivatives of $g(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}({x}^{2}+{y}^{2})=2x \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}({x}^{2}+{y}^{2})=2y\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}∇g(x,y) & =\\frac{∂g}{∂x}\\text{ }i+\\frac{∂g}{∂y}\\text{ }j=2x\\text{ }i+2y\\text{ }j.\\end{aligned}\n$$\n\nFinally, using the product rule, we obtain:\n\n$$\n\\begin{aligned}∇[f(x,y)g(x,y)] & =({e}^{x+y})(2x\\text{ }i+2y\\text{ }j)+({x}^{2}+{y}^{2})({e}^{x+y}\\text{ }i+{e}^{x+y}\\text{ }j) \\\\  & =2x{e}^{x+y}\\text{ }i+2y{e}^{x+y}\\text{ }j+({x}^{2}+{y}^{2}){e}^{x+y}\\text{ }i+({x}^{2}+{y}^{2}){e}^{x+y}\\text{ }j \\\\  & =({x}^{2}+2x+{y}^{2}){e}^{x+y}\\text{ }i+({x}^{2}+2y+{y}^{2}){e}^{x+y}\\text{ }j\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186573928 #edb/ref 1068 #edb/ref 17592186573819 #edb/ref 17592186045417] [17592186573928 #edb/ref 1069 "q-128528" #edb/ref 17592186045417] [17592186573928 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186573928 #edb/ref 1071 "Find the gradient of the product $f(x,y)h(x,y),$ given that \n\n$$\n\\begin{aligned}f(x,y) & =\\operatorname{arctan}⁡(\\frac{x}{y}),\\, &  & ∇f(x,y)=\\frac{y}{{x}^{2}+{y}^{2}}\\,i-\\frac{x}{{x}^{2}+{y}^{2}}\\,j, &  &  \\\\ h(x,y) & =\\sqrt{{x}^{2}+{y}^{2}},\\, &  & ∇h(x,y)=\\frac{x}{\\sqrt{{x}^{2}+{y}^{2}}}\\,i+\\frac{y}{\\sqrt{{x}^{2}+{y}^{2}}}\\,j. &  & \\end{aligned}\n$$" #edb/ref 17592186045417] [17592186573928 #edb/ref 1072 #uuid "ce288280-35f0-55c7-872a-791cfea323e8" #edb/ref 17592186045417] [17592186573928 #edb/ref 1074 "The gradient of the product of two functions $f(x,y)$ and $h(x,y)$ is given by\n\n$$\n∇[fh]=h∇f+f∇h.\n$$\n\nUsing the product rule, we obtain\n\n$$\n\\begin{aligned}∇[f(x,y)h(x,y)] & =h(x,y)∇f(x,y)+f(x,y)∇h(x,y) \\\\  & =\\sqrt{{x}^{2}+{y}^{2}}(\\frac{y}{{x}^{2}+{y}^{2}}\\,i-\\frac{x}{{x}^{2}+{y}^{2}}\\,j)+\\operatorname{arctan}⁡(\\frac{x}{y})(\\frac{x}{\\sqrt{{x}^{2}+{y}^{2}}}\\,i+\\frac{y}{\\sqrt{{x}^{2}+{y}^{2}}}\\,j) \\\\  & =\\frac{y\\sqrt{{x}^{2}+{y}^{2}}}{{x}^{2}+{y}^{2}}\\,i-\\frac{x\\sqrt{{x}^{2}+{y}^{2}}}{{x}^{2}+{y}^{2}}\\,j+\\frac{x\\operatorname{arctan}⁡(\\frac{x}{y})}{\\sqrt{{x}^{2}+{y}^{2}}}\\,i+\\frac{y\\operatorname{arctan}⁡(\\frac{x}{y})}{\\sqrt{{x}^{2}+{y}^{2}}}\\,j \\\\  & =\\frac{y}{\\sqrt{{x}^{2}+{y}^{2}}}\\,i-\\frac{x}{\\sqrt{{x}^{2}+{y}^{2}}}\\,j+\\frac{x\\operatorname{arctan}⁡(\\frac{x}{y})}{\\sqrt{{x}^{2}+{y}^{2}}}\\,i+\\frac{y\\operatorname{arctan}⁡(\\frac{x}{y})}{\\sqrt{{x}^{2}+{y}^{2}}}\\,j \\\\  & =\\frac{y+x\\operatorname{arctan}⁡(\\frac{x}{y})}{\\sqrt{{x}^{2}+{y}^{2}}}\\,i+\\frac{y\\operatorname{arctan}⁡(\\frac{x}{y})-x}{\\sqrt{{x}^{2}+{y}^{2}}}\\,j \\\\  & =\\frac{1}{\\sqrt{{x}^{2}+{y}^{2}}}((y+x\\operatorname{arctan}⁡(\\frac{x}{y}))i+(y\\operatorname{arctan}⁡(\\frac{x}{y})-x)j).\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186573938 #edb/ref 1068 #edb/ref 17592186573818 #edb/ref 17592186045417] [17592186573938 #edb/ref 1069 "q-128518" #edb/ref 17592186045417] [17592186573938 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186573938 #edb/ref 1071 "Given that $h(x,y)=({x}^{2}-{y}^{2}){e}^{x}$, find the points $(x,y)$ where $∇h(x,y)=0.$" #edb/ref 17592186045417] [17592186573938 #edb/ref 1072 #uuid "e83d5b90-8fee-5f1e-85b9-d81d6b0e4f2a" #edb/ref 17592186045417] [17592186573938 #edb/ref 1074 "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂h}{∂x} & =\\frac{∂}{∂x}(({x}^{2}-{y}^{2}){e}^{x}) \\\\  & =2x{e}^{x}+({x}^{2}-{y}^{2}){e}^{x} \\\\  & =({x}^{2}+2x-{y}^{2}){e}^{x} \\\\ \\frac{∂h}{∂y} & =\\frac{∂}{∂y}(({x}^{2}-{y}^{2}){e}^{x}) \\\\  & =-2y{e}^{x}\\end{aligned}\n$$\n\nHence, $∇h(x,y)=({x}^{2}+2x-{y}^{2}){e}^{x}\\,i-2y{e}^{x}\\,j.$\n\nNow, we solve $∇h(x,y)=0:$\n\n$$\n({x}^{2}+2x-{y}^{2}){e}^{x}\\,i-2y{e}^{x}\\,j=0\\text{ }i+0\\text{ }j\n$$\n\nSo, by equating the coefficients of $i$ and $j,$ we obtain\n\n$$\n\\left\\{\\begin{aligned}({x}^{2}+2x-{y}^{2}){e}^{x} &=0, \\\\ -2y{e}^{x} &=0.\\end{aligned}\\right.\n$$\n\nFrom the second equation, we get $y=0.$ Substituting this into the first equation, we obtain\n\n$$\n\\begin{aligned}({x}^{2}+2x-{0}^{2}){e}^{x} & =0 \\\\ x(x+2){e}^{x} & =0 \\\\ x & =-2,\\,0.\\end{aligned}\n$$\n\nTherefore, $∇h(x,y)=0$ at two points: $(-2,0)$ and $(0,0).$" #edb/ref 17592186045417] [17592186573946 #edb/ref 1068 #edb/ref 17592186573776 #edb/ref 17592186045417] [17592186573946 #edb/ref 1069 "q-71477" #edb/ref 17592186045417] [17592186573946 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186573946 #edb/ref 1071 "Find the gradient of the product $f(x,y)g(x,y),$ given that \n\n$$\n\\begin{aligned}f(x,y) & =x+y,\\, &  & ∇f(x,y)=\\text{ }i+\\text{ }j, &  &  \\\\ g(x,y) & =\\operatorname{ln}⁡(x+y),\\, &  & ∇g(x,y)=\\frac{1}{x+y}\\text{ }i+\\frac{1}{x+y}\\text{ }j. &  & \\end{aligned}\n$$" #edb/ref 17592186045417] [17592186573946 #edb/ref 1072 #uuid "f7be3188-95a1-5bd7-a100-6bc1c7138029" #edb/ref 17592186045417] [17592186573946 #edb/ref 1074 "The gradient of the product of two functions $f(x,y)$ and $g(x,y)$ is given by:\n\n$$\n∇[fg]=g\\,∇\\,f+f\\,∇\\,g\n$$\n\nSo, using this product rule we obtain: \n\n$$\n\\begin{aligned}∇[f(x,y)g(x,y)] & =g(x,y)∇f(x,y)+f(x,y)∇g(x,y) \\\\  & =\\operatorname{ln}⁡(x+y)(\\text{ }i+\\text{ }j)+(x+y)(\\frac{1}{x+y}\\text{ }i+\\frac{1}{x+y}\\text{ }j) \\\\  & =\\operatorname{ln}⁡(x+y)\\text{ }i+\\operatorname{ln}⁡(x+y)\\text{ }j+\\frac{x+y}{x+y}\\text{ }i+\\frac{x+y}{x+y}\\text{ }j \\\\  & =(\\operatorname{ln}⁡(x+y)\\text{ }i+\\text{ }i)+(\\operatorname{ln}⁡(x+y)\\text{ }j+1\\text{ }j) \\\\  & =(\\operatorname{ln}⁡(x+y)+1)\\text{ }i+(\\operatorname{ln}⁡(x+y)+1)\\text{ }j\\end{aligned}\n$$" #edb/ref 17592186045417]}
