7592186045436] [17592186440315 #edb/ref 1079 #uuid "47cda995-fd9f-589a-85d9-cfbd97013861" #edb/ref 17592186045436] [17592186440316 #edb/ref 1075 #edb/ref 17592186439917 #edb/ref 17592186045436] [17592186440316 #edb/ref 1075 #edb/ref 17592186439918 #edb/ref 17592186045436] [17592186440316 #edb/ref 1076 #edb/ref 17592186408166 #edb/ref 17592186045436] [17592186440316 #edb/ref 1077 "V" #edb/ref 17592186045436] [17592186440316 #edb/ref 1078 #edb/ref 17592186439917 #edb/ref 17592186045436] [17592186440316 #edb/ref 1079 #uuid "84892d33-55b9-54ef-a343-3de68b52e47d" #edb/ref 17592186045436] [17592186440317 #edb/ref 1075 #edb/ref 17592186439919 #edb/ref 17592186045436] [17592186440317 #edb/ref 1075 #edb/ref 17592186439920 #edb/ref 17592186045436] [17592186440317 #edb/ref 1076 #edb/ref 17592186408166 #edb/ref 17592186045436] [17592186440317 #edb/ref 1077 "VI" #edb/ref 17592186045436] [17592186440317 #edb/ref 1078 #edb/ref 17592186439919 #edb/ref 17592186045436] [17592186440317 #edb/ref 1079 #uuid "71df9b88-565a-50cb-b76e-a7999233dce6" #edb/ref 17592186045436] [17592186524155 #edb/ref 1068 #edb/ref 17592186524185 #edb/ref 17592186045443] [17592186524155 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045443] [17592186524155 #edb/ref 1071 "Find the gradient of the product $f(x,y)g(x,y),$ given that \n\n$$\n\\begin{aligned}f(x,y) & =4 x + 3 y,\\quad ∇f(x,y)=(4)\\,i+(3)\\,j \\\\ g(x,y) & =4 x - 2 y,\\quad ∇g(x,y)=(4)\\,i+(-2)\\,j\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186524155 #edb/ref 1072 #uuid "56dccd14-220e-5139-aad6-1c3d9263c553" #edb/ref 17592186045443] [17592186524155 #edb/ref 1074 "The gradient of the product of two functions $f(x,y)$ and $g(x,y)$ is given by\n\n$$\n∇[fg]=g∇f+f∇g.\n$$\n\nUsing the product rule, we obtain\n\n$$\n\\begin{aligned}∇[f(x,y)g(x,y)] & =g(x,y)∇f(x,y)+f(x,y)∇g(x,y) \\\\  & =(4 x - 2 y)((4)\\,i+(3)\\,j)+(4 x + 3 y)((4)\\,i+(-2)\\,j) \\\\  & =(4 x - 2 y)(4)i+(4 x - 2 y)(3)j+(4 x + 3 y)(4)i+(4 x + 3 y)(-2)j \\\\  & =(16 x - 8 y)i+(12 x - 6 y)j+(16 x + 12 y)i+(- 8 x - 6 y)j \\\\  & =(32 x + 4 y)\\,i+(4 x - 12 y)\\,j\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186524157 #edb/ref 1068 #edb/ref 17592186524152 #edb/ref 17592186045443] [17592186524157 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045443] [17592186524157 #edb/ref 1071 "Find the gradient of the product $f(x,y)g(x,y),$ given that \n\n$$\n\\begin{aligned}f(x,y) & =2 x - 2 y,\\quad ∇f(x,y)=(2)\\,i+(-2)\\,j \\\\ g(x,y) & =- 3 x - y,\\quad ∇g(x,y)=(-3)\\,i+(-1)\\,j\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186524157 #edb/ref 1072 #uuid "617022f3-6d62-5e70-ba01-a98523aa95af" #edb/ref 17592186045443] [17592186524157 #edb/ref 1074 "The gradient of the product of two functions $f(x,y)$ and $g(x,y)$ is given by\n\n$$\n∇[fg]=g∇f+f∇g.\n$$\n\nUsing the product rule, we obtain\n\n$$\n\\begin{aligned}∇[f(x,y)g(x,y)] & =g(x,y)∇f(x,y)+f(x,y)∇g(x,y) \\\\  & =(- 3 x - y)((2)\\,i+(-2)\\,j)+(2 x - 2 y)((-3)\\,i+(-1)\\,j) \\\\  & =(- 3 x - y)(2)i+(- 3 x - y)(-2)j+(2 x - 2 y)(-3)i+(2 x - 2 y)(-1)j \\\\  & =(- 6 x - 2 y)i+(6 x + 2 y)j+(- 6 x + 6 y)i+(- 2 x + 2 y)j \\\\  & =(- 12 x + 4 y)\\,i+(4 x + 4 y)\\,j\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186524174 #edb/ref 1068 #edb/ref 17592186524160 #edb/ref 17592186045443] [17592186524174 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045443] [17592186524174 #edb/ref 1071 "What is the gradient of the product $f(x,y)h(x,y)$ if $f(x,y)=(x-3){e}^{(y+4)}$ and $h(x,y)=(y+4){e}^{(x-3)}?$" #edb/ref 17592186045443] [17592186524174 #edb/ref 1072 #uuid "a18b5f63-dc6e-5c60-bea1-6d3675dd37d9" #edb/ref 17592186045443] [17592186524174 #edb/ref 1074 "The gradient of the product of two functions $f(x,y)$ and $h(x,y)$ is given by:\n\n$$\n∇[fh]=f\\,∇\\,h+h\\,∇\\,f\\,\\,\n$$\n\nNow, we calculate the partial derivatives of $f(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}((x-3){e}^{(y+4)})={e}^{(y+4)} \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}((x-3){e}^{(y+4)})=(x-3){e}^{(y+4)}\\end{aligned}\n$$\n\nHence, \n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂f}{∂x}\\text{ }i+\\frac{∂f}{∂y}\\text{ }j={e}^{(y+4)}\\text{ }i+(x-3){e}^{(y+4)}\\text{ }j.\\end{aligned}\n$$\n\nNext, we calculate the partial derivatives of $h(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂h}{∂x} & =\\frac{∂}{∂x}((y+4){e}^{(x-3)})=(y+4){e}^{(x-3)} \\\\ \\frac{∂h}{∂y} & =\\frac{∂}{∂y}((y+4){e}^{(x-3)})={e}^{(x-3)}\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}∇h(x,y) & =\\frac{∂h}{∂x}\\text{ }i+\\frac{∂h}{∂y}\\text{ }j=(y+4){e}^{(x-3)}\\text{ }i+{e}^{(x-3)}\\text{ }j.\\end{aligned}\n$$\n\nFinally, using the product rule, we obtain:\n\n$$\n\\begin{aligned}∇[f(x,y)h(x,y)] & =(x-3){e}^{(y+4)}((y+4){e}^{(x-3)}\\text{ }i+{e}^{(x-3)}\\text{ }j)+(y+4){e}^{(x-3)}({e}^{(y+4)}\\text{ }i+(x-3){e}^{(y+4)}\\text{ }j) \\\\  & =(x-3)(y+4){e}^{(x-3)+(y+4)}\\text{ }i+(x-3){e}^{(x-3)+(y+4)}\\text{ }j+(y+4){e}^{(x-3)+(y+4)}\\text{ }i+(x-3)(y+4){e}^{(x-3)+(y+4)}\\text{ }j \\\\  & =((x-3)+1)(y+4){e}^{(x-3)+(y+4)}\\text{ }i+(x-3)(1+(y+4)){e}^{(x-3)+(y+4)}\\text{ }j\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186524177 #edb/ref 1068 #edb/ref 17592186524147 #edb/ref 17592186045443] [17592186524177 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045443] [17592186524177 #edb/ref 1071 "Find the gradient of the product $f(x,y,z)g(x,y,z),$ given that $f(x,y,z)=x^{2} y^{3} z - x y z^{3}$ and $g(x,y,z)=\\frac{1}{x y z}.$" #edb/ref 17592186045443] [17592186524177 #edb/ref 1072 #uuid "af2e4ace-5861-5b18-b355-92218c8fda1e" #edb/ref 17592186045443] [17592186524177 #edb/ref 1074 "The gradient of the product of two functions $f(x,y,z)$ and $g(x,y,z)$ is given by\n\n$$\n∇[fg]=g∇f+f∇g.\n$$\n\nNow, we calculate the partial derivatives of $f(x,y,z):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(x^{2} y^{3} z - x y z^{3})=2 x y^{3} z - y z^{3} \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}(x^{2} y^{3} z - x y z^{3})=3 x^{2} y^{2} z - x z^{3} \\\\ \\frac{∂f}{∂z} & =\\frac{∂}{∂z}(x^{2} y^{3} z - x y z^{3})=x^{2} y^{3} - 3 x y z^{2}\\end{aligned}\n$$\n\nHence,\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\frac{∂f}{∂x}i+\\frac{∂f}{∂y}j+\\frac{∂f}{∂z}k=(2 x y^{3} z - y z^{3})\\,i+(3 x^{2} y^{2} z - x z^{3})\\,j+(x^{2} y^{3} - 3 x y z^{2})\\,k\\end{aligned}\n$$\n\nNow, we calculate the partial derivatives of $g(x,y,z):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}(\\frac{1}{x y z})=- \\frac{1}{x^{2} y z} \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}(\\frac{1}{x y z})=- \\frac{1}{x y^{2} z} \\\\ \\frac{∂g}{∂z} & =\\frac{∂}{∂z}(\\frac{1}{x y z})=- \\frac{1}{x y z^{2}}\\end{aligned}\n$$\n\nHence,\n\n$$\n\\begin{aligned}∇g(x,y,z) & =\\frac{∂g}{∂x}i+\\frac{∂g}{∂y}j+\\frac{∂g}{∂z}k=(- \\frac{1}{x^{2} y z})\\,i+(- \\frac{1}{x y^{2} z})\\,j+(- \\frac{1}{x y z^{2}})\\,k\\end{aligned}\n$$\n\nUsing the product rule, we obtain\n\n$$\n\\begin{aligned}∇[f(x,y,z)g(x,y,z)] & =g(x,y,z)∇f(x,y,z)+f(x,y,z)∇g(x,y,z) \\\\  & =(\\frac{1}{x y z})((2 x y^{3} z - y z^{3})\\,i+(3 x^{2} y^{2} z - x z^{3})\\,j+(x^{2} y^{3} - 3 x y z^{2})\\,k)+(x^{2} y^{3} z - x y z^{3})((- \\frac{1}{x^{2} y z})\\,i+(- \\frac{1}{x y^{2} z})\\,j+(- \\frac{1}{x y z^{2}})\\,k) \\\\  & =(\\frac{1}{x y z})(2 x y^{3} z - y z^{3})i+(\\frac{1}{x y z})(3 x^{2} y^{2} z - x z^{3})j+(\\frac{1}{x y z})(x^{2} y^{3} - 3 x y z^{2})k+(x^{2} y^{3} z - x y z^{3})(- \\frac{1}{x^{2} y z})i+(x^{2} y^{3} z - x y z^{3})(- \\frac{1}{x y^{2} z})j+(x^{2} y^{3} z - x y z^{3})(- \\frac{1}{x y z^{2}})k \\\\  & =(2 y^{2} - \\frac{z^{2}}{x})i+(3 x y - \\frac{z^{2}}{y})j+(\\frac{x y^{2}}{z} - 3 z)k+(- y^{2} + \\frac{z^{2}}{x})i+(- x y + \\frac{z^{2}}{y})j+(- \\frac{x y^{2}}{z} + z)k \\\\  & =(y^{2})\\,i+(2 x y)\\,j+(- 2 z)\\,k\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186524179 #edb/ref 1068 #edb/ref 17592186524151 #edb/ref 17592186045443] [17592186524179 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045443] [17592186524179 #edb/ref 1071 "Find the gradient of the product $f(x,y)g(x,y),$ given that \n\n$$\n\\begin{aligned}f(x,y) & =- 2 x + 2 y,\