20efc3da4346" #edb/ref 17592186045417] [17592186569837 #edb/ref 1080 "II only" #edb/ref 17592186045417] [17592186569837 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186569837 #edb/ref 1083 #uuid "faf5e9ca-69be-5548-8107-7d06c638adcc" #edb/ref 17592186045417] [17592186569889 #edb/ref 1075 #edb/ref 17592186569613 #edb/ref 17592186045417] [17592186569889 #edb/ref 1075 #edb/ref 17592186569671 #edb/ref 17592186045417] [17592186569889 #edb/ref 1075 #edb/ref 17592186569792 #edb/ref 17592186045417] [17592186569889 #edb/ref 1075 #edb/ref 17592186569799 #edb/ref 17592186045417] [17592186569889 #edb/ref 1075 #edb/ref 17592186569837 #edb/ref 17592186045417] [17592186569889 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186569889 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186569889 #edb/ref 1078 #edb/ref 17592186569613 #edb/ref 17592186045417] [17592186569889 #edb/ref 1079 #uuid "73207714-b850-5ffd-8c57-6fa10d88caae" #edb/ref 17592186045417] [17592186569968 #edb/ref 1068 #edb/ref 17592186569889 #edb/ref 17592186045417] [17592186569968 #edb/ref 1069 "q-132751" #edb/ref 17592186045417] [17592186569968 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186569968 #edb/ref 1071 "Which of the following statements are true about the function $f(x,y,z)=\\sqrt{z+y-{x}^{2}}?$\n\nI. The partial derivative with respect to $x$ is defined at $(0,0,1)$\n\nII. ${f}_{y}(1,2,0)$ is defined\n\nIII. ${f}_{z}(1,1,0)$ is defined" #edb/ref 17592186045417] [17592186569968 #edb/ref 1072 #uuid "244be0b4-aca1-5c1c-abe2-94099e0fbbe5" #edb/ref 17592186045417] [17592186569968 #edb/ref 1074 "First, we compute the partial derivatives of $f(x,y,z):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =-\\frac{x}{\\sqrt{z+y-{x}^{2}}} \\\\ \\frac{∂f}{∂y} & =\\frac{1}{2\\sqrt{z+y-{x}^{2}}} \\\\ \\frac{∂f}{∂z} & =\\frac{1}{2\\sqrt{z+y-{x}^{2}}}\\end{aligned}\n$$\n\nNow, let's examine the statements one-by-one.\n\n- Statement I is true. Indeed, the function $f$ is defined at $(0,0,1)$, where we have \n\n$$\nf(0,0,1)=\\sqrt{1+0-{0}^{2}}=1,\n$$\n\nand ${f}_{x}$ is also defined at $(0,0,1):$\n\n$$\n\\begin{aligned}{f}_{x}(0,0,1) & =-\\frac{0}{\\sqrt{1+0-{0}^{2}}}=0.\\end{aligned}\n$$\n\n- Statement II is true. Indeed, the function $f$ is defined at $(1,2,0)$, where we have \n\n$$\nf(1,2,0)=\\sqrt{0+2-{1}^{2}}=1,\n$$\n\nand ${f}_{y}$ is also defined at $(1,2,0):$\n\n$$\n\\begin{aligned}{f}_{y}(1,2,0) & =\\frac{1}{2\\sqrt{0+2-{1}^{2}}}=\\frac{1}{2}.\\end{aligned}\n$$\n\n- Statement III is false. If we substitute $(1,1,0)$ into ${f}_{z}$, we get\n\n$$\n{f}_{z}(1,1,0)=\\frac{1}{2\\sqrt{0+1-{1}^{2}}}=\\frac{1}{0},\n$$\n\nwhich is undefined since we have division by zero.\n\nTherefore, the correct answer is 'I and II only'." #edb/ref 17592186045417] [17592186570048 #edb/ref 1058 #edb/ref 17592186570067 #edb/ref 17592186045417] [17592186570048 #edb/ref 1062 #uuid "2842369f-1f4f-58be-953d-3f713b247f9b" #edb/ref 17592186045417] [17592186570048 #edb/ref 1063 #edb/ref 17592186323840 #edb/ref 17592186045417] [17592186570052 #edb/ref 1062 #uuid "33af0b6f-ae95-578f-99a9-1e3131763eb2" #edb/ref 17592186045417] [17592186570052 #edb/ref 1063 #edb/ref 17592186569968 #edb/ref 17592186045417] [17592186570067 #edb/ref 1058 #edb/ref 17592186570080 #edb/ref 17592186045417] [17592186570067 #edb/ref 1062 #uuid "6bba2763-669c-58c3-a3e6-5843dc68f94f" #edb/ref 17592186045417] [17592186570067 #edb/ref 1063 #edb/ref 17592186125193 #edb/ref 17592186045417] [17592186570079 #edb/ref 1058 #edb/ref 17592186570052 #edb/ref 17592186045417] [17592186570079 #edb/ref 1062 #uuid "a90d8bfb-8461-5668-8e11-2111cb68de7c" #edb/ref 17592186045417] [17592186570079 #edb/ref 1063 #edb/ref 17592186381041 #edb/ref 17592186045417] [17592186570080 #edb/ref 1058 #edb/ref 17592186570079 #edb/ref 17592186045417] [17592186570080 #edb/ref 1062 #uuid "ad4fbff0-775d-5cc6-a06c-c04820df7660" #edb/ref 17592186045417] [17592186570080 #edb/ref 1063 #edb/ref 17592186339041 #edb/ref