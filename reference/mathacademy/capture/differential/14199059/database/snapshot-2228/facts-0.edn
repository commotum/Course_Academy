b/ref 17592186264441 #edb/ref 17592186045417] [17592186265600 #edb/ref 1075 #edb/ref 17592186264971 #edb/ref 17592186045417] [17592186265600 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186265600 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186265600 #edb/ref 1078 #edb/ref 17592186264441 #edb/ref 17592186045417] [17592186265600 #edb/ref 1079 #uuid "c90461b1-1149-54d3-9d43-9942adac1495" #edb/ref 17592186045417] [17592186265605 #edb/ref 1075 #edb/ref 17592186263068 #edb/ref 17592186045417] [17592186265605 #edb/ref 1075 #edb/ref 17592186263257 #edb/ref 17592186045417] [17592186265605 #edb/ref 1075 #edb/ref 17592186264362 #edb/ref 17592186045417] [17592186265605 #edb/ref 1075 #edb/ref 17592186264813 #edb/ref 17592186045417] [17592186265605 #edb/ref 1075 #edb/ref 17592186264850 #edb/ref 17592186045417] [17592186265605 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186265605 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186265605 #edb/ref 1078 #edb/ref 17592186264362 #edb/ref 17592186045417] [17592186265605 #edb/ref 1079 #uuid "cb7e101e-fe81-5db4-a578-c892744685d7" #edb/ref 17592186045417] [17592186265960 #edb/ref 1068 #edb/ref 17592186265605 #edb/ref 17592186045417] [17592186265960 #edb/ref 1069 "q-130718" #edb/ref 17592186045417] [17592186265960 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186265960 #edb/ref 1071 "Consider the plane curve ${x}^{2}-3{y}^{2}=6.$  Find the equation of the normal line to the curve at the point $(3,1).$" #edb/ref 17592186045417] [17592186265960 #edb/ref 1072 #uuid "c80428ab-daca-506e-aca7-d4e40b0d604c" #edb/ref 17592186045417] [17592186265960 #edb/ref 1074 "If we set $f(x,y)={x}^{2}-3{y}^{2},$ our curve can be viewed as the level curve $f(x,y)=6.$  \n\nA normal vector to the level curve that passes through the point $(3,1)$ can be found by computing $∇f(3,1).$ \n\nSo, we find the gradient and evaluate it at $(3,1):$\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}({x}^{2}-3{y}^{2})\\,i+\\frac{∂}{∂y}({x}^{2}-3{y}^{2})\\,j \\\\  & =2x\\,i-6y\\,j \\\\ ∇f(3,1) & =2(3)\\,i-6(1)\\,j \\\\  & =6\\,i-6\\,j \\\\  & =⟨6,-6⟩\\end{aligned}\n$$\n\nHence, $∇f(3,1)=⟨6,-6⟩$ is a normal vector to the curve at $(3,1).$\n\nFinally, the Cartesian equation of the line that is parallel to $v=⟨{v}_{x},{v}_{y}⟩$ and passes through the point $({x}_{0},{y}_{0})$ can be written as:\n\n$$\n\\begin{aligned}\\frac{x-{x}_{0}}{{v}_{x}} & =\\frac{y-{y}_{0}}{{v}_{y}} \\\\ \\frac{x-3}{6} & =\\frac{y-1}{(-6)} \\\\ -6(x-3) & =6(y-1) \\\\ -(x-3) & =y-1 \\\\ -x+3 & =y-1 \\\\ x+y-4 & =0\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186266053 #edb/ref 1068 #edb/ref 17592186265357 #edb/ref 17592186045417] [17592186266053 #edb/ref 1069 "q-131130" #edb/ref 17592186045417] [17592186266053 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186266053 #edb/ref 1071 "Find the equation of the normal line to the surface $x={y}^{2}-{z}^{2}$ at the point $(3,2,1).$" #edb/ref 17592186045417] [17592186266053 #edb/ref 1072 #uuid "46c7ac33-5b38-5319-85fa-4f19aa20d07b" #edb/ref 17592186045417] [17592186266053 #edb/ref 1074 "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}x & ={y}^{2}-{z}^{2} \\\\ {y}^{2}-{z}^{2}-x & =0\\end{aligned}\n$$\n\nIf we set $f(x,y,z)={y}^{2}-{z}^{2}-x$, our surface can be viewed as the level surface $f(x,y,z)=0.$ \n\nA normal vector to the level surface that passes through the point $(3,2,1)$ can be found by computing $∇f(3,2,1).$ \n\nSo, we find the gradient and evaluate it at $(3,2,1):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\text{ }j+{f}_{z}(x,y,z)\\text{ }k \\\\  & =\\frac{∂}{∂x}({y}^{2}-{z}^{2}-x)i+\\frac{∂}{∂y}({y}^{2}-{z}^{2}-x)j+\\frac{∂}{∂z}({y}^{2}-{z}^{2}-x)k \\\\  & =-i+2y\\,j-2z\\,k \\\\ ∇f(3,2,1) & =-i+2(2)\\,j-2(1)\\,k \\\\  & =-i+4\\,j-2\\,k \\\\  & =⟨-1,4,-2⟩\\end{aligned}\n$$\n\nFinally, the Cartesian equation of the line that is parallel to $v=⟨{v}_{x},{v}_{y},{v}_{z}⟩$ and passes through the point $({x}_{0},{y}_{0},{z}_{0})$ can be written as:\n\n$$\n\\begin{aligned}\\frac{x-{x}_{0}}{{v}_{x}}=\\frac{y-{y}_{0}}{{v}_{y}}=\\frac{z-{z}_{0}}{{v}_{z}} \\\\ \\frac{x-3}{(-1)}=\\frac{y-2}{4}=\\frac{z-1}{(-2)} \\\\ \\frac{x-3}{1}=\\frac{y-2}{-4}=\\frac{z-1}{2} \\\\ x-3=\\frac{2-y}{4}=\\frac{z-1}{2}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186336252 #edb/ref 1080 "\\frac{4}{5}\\,i+\\frac{3}{5}\\,j" #edb/ref 17592186045417] [17592186336252 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186336252 #edb/ref 1083 #uuid "17754529-babb-5cf0-8d95-1b9cc9537939" #edb/ref 17592186045417] [17592186336332 #edb/ref 1080 "\\frac{3}{5}\\,i+\\frac{4}{5}\\,j+\\frac{1}{5}\\,k" #edb/ref 17592186045417] [17592186336332 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186336332 #edb/ref 1083 #uuid "2027b715-6614-5f66-82b2-1f71af6cb775" #edb/ref 17592186045417] [17592186336538 #edb/ref 1080 "i+j" #edb/ref 17592186045417] [17592186336538 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186336538 #edb/ref 1083 #uuid "36a67130-4f88-5f7d-9e66-e328e09a4789" #edb/ref 17592186045417] [17592186336798 #edb/ref 1080 "\\frac{3}{5}\\,i+\\frac{4}{5}\\,j+k" #edb/ref 17592186045417] [17592186336798 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186336798 #edb/ref 1083 #uuid "530705a9-532d-591f-bbf7-492c24eb6728" #edb/ref 17592186045417] [17592186337280 #edb/ref 1080 "\\frac{3}{5}\\,i+\\frac{4}{5}\\,j" #edb/ref 17592186045417] [17592186337280 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186337280 #edb/ref 1083 #uuid "8a797477-b113-50ff-8e91-509061d9a654" #edb/ref 17592186045417] [17592186338378 #edb/ref 1075 #edb/ref 17592186336252 #edb/ref 17592186045417] [17592186338378 #edb/ref 1075 #edb/ref 17592186336332 #edb/ref 17592186045417] [17592186338378 #edb/ref 1075 #edb/ref 17592186336538 #edb/ref 175921860454