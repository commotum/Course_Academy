45417] [17592186445481 #edb/ref 1075 #edb/ref 17592186445470 #edb/ref 17592186045417] [17592186445481 #edb/ref 1075 #edb/ref 17592186445473 #edb/ref 17592186045417] [17592186445481 #edb/ref 1075 #edb/ref 17592186445474 #edb/ref 17592186045417] [17592186445481 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186445481 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186445481 #edb/ref 1078 #edb/ref 17592186445474 #edb/ref 17592186045417] [17592186445481 #edb/ref 1079 #uuid "d8602de3-643b-512d-8235-9d9217ba8f38" #edb/ref 17592186045417] [17592186445482 #edb/ref 1075 #edb/ref 17592186445447 #edb/ref 17592186045417] [17592186445482 #edb/ref 1075 #edb/ref 17592186445448 #edb/ref 17592186045417] [17592186445482 #edb/ref 1075 #edb/ref 17592186445457 #edb/ref 17592186045417] [17592186445482 #edb/ref 1075 #edb/ref 17592186445464 #edb/ref 17592186045417] [17592186445482 #edb/ref 1075 #edb/ref 17592186445467 #edb/ref 17592186045417] [17592186445482 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186445482 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186445482 #edb/ref 1078 #edb/ref 17592186445448 #edb/ref 17592186045417] [17592186445482 #edb/ref 1079 #uuid "d9a8646d-83af-52fd-a349-459e6460b606" #edb/ref 17592186045417] [17592186445483 #edb/ref 1068 #edb/ref 17592186445479 #edb/ref 17592186045417] [17592186445483 #edb/ref 1069 "q-80662" #edb/ref 17592186045417] [17592186445483 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186445483 #edb/ref 1071 "Let the function $f(x,y)$ be defined as\n\n$$\nf(x,y)=\\{\\begin{aligned}{x}^{2}-{y}^{2},\\, & \\text{if}\\,0<x<1,\\,0<y<1, \\\\ {e}^{(x-y)},\\, & \\text{if}\\,1<x<2,\\,0<y<1.\\end{aligned}\n$$\n\nThen,\n\n$$\n{∬}_{(0,2)\\times (0,1)}f(x,y)\\text{ }\\text{d}A=\n$$" #edb/ref 17592186045417] [17592186445483 #edb/ref 1072 #uuid "1f7e7929-7b85-5acd-be84-f40a79eeb887" #edb/ref 17592186045417] [17592186445483 #edb/ref 1074 "First, notice that the rectangle $R$ can be represented as a union of two smaller rectangles, as follows:\n\n$$\n\\begin{aligned}R & =((0,1)\\cup (1,2))\\times (0,1) \\\\  & =((0,1)\\times (0,1))\\cup ((1,2)\\times (0,1)).\\end{aligned}\n$$\n\nSo, we can write\n\n$$\n\\begin{aligned}{∬}_{R}f(x,y)\\,\\text{d}A & ={∬}_{(0,1)\\times (0,1)}f(x,y)\\,\\text{d}A+{∬}_{(1,2)\\times (0,1)}f(x,y)\\,\\text{d}A \\\\  & ={∬}_{(0,1)\\times (0,1)}({x}^{2}-{y}^{2})\\,\\text{d}A+{∬}_{(1,2)\\times (0,1)}{e}^{(x-y)}\\,\\text{d}A.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186445484 #edb/ref 1068 #edb/ref 17592186445477 #edb/ref 17592186045417] [17592186445484 #edb/ref 1069 "q-80510" #edb/ref 17592186045417] [17592186445484 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186445484 #edb/ref 1071 "Evaluate the double integral ${∬}_{R}{y}^{2}{csc}^{2}⁡x\\,\\text{d}A$ over the rectangle $R=[\\frac{\\pi }{4},\\frac{\\pi }{2}]\\times [0,3].$" #edb/ref 17592186045417] [17592186445484 #edb/ref 1072 #uuid "68e39739-c077-5ff6-83ad-f603767a81a6" #edb/ref 17592186045417] [17592186445484 #edb/ref 1074 "We apply the multiplicative property of double integrals and then evaluate each of the integrals separately:\n\n$$\n\\begin{aligned}{∬}_{R}{y}^{2}{csc}^{2}⁡x\\,\\text{d}A & ={∬}_{R}({csc}^{2}⁡x)({y}^{2})\\text{d}A \\\\  & =({\\int }_{\\pi /4}^{\\pi /2}{csc}^{2}⁡x\\,\\text{d}x)({\\int }_{0}^{3}{y}^{2}\\,\\text{d}y) \\\\  & =[-\\operatorname{cot}⁡x]_{\\pi /4}^{\\pi /2}\\cdot {[\\frac{{y}^{3}}{3}]}_{0}^{3} \\\\  & =(-\\operatorname{cot}⁡(\\frac{\\pi }{2})+\\operatorname{cot}⁡(\\frac{\\pi }{4}))\\cdot (\\frac{{3}^{3}}{3}-\\frac{{0}^{3}}{3}) \\\\  & =(0+1)\\cdot (9-0) \\\\  & =9\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186445485 #edb/ref 1068 #edb/ref 17592186445481 #edb/ref 17592186045417] [17592186445485 #edb/ref 1069 "q-130019" #edb/ref 17592186045417] [17592186445485 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186445485 #edb/ref 1071 "Given that $C$ and $D$ are finite, non-overlapping regions and that\n\n$$\n{∬}_{C}f(x,y)\\text{ }\\text{d}A=-3,\\,{∬}_{D}f(x,y)\\text{ }\\text{d}A=11,\n$$\n\nfind the value of \n\n$$\n{∬}_{C\\cup D}\\frac{1}{4}f(x,y)\\text{ }\\text{d}A.\n$$" #edb/ref 17592186045417] [17592186445485 #edb/ref 1072 #uuid "9794b451-1881-5349-8cf7-09e2d5dcd1d3" #edb/ref 17592186045417] [17592186445485 #edb/ref 1074 "Using the linearity and additivity of double integrals, we get the following:\n\n$$\n\\begin{aligned}{∬}_{C\\cup D}\\frac{1}{4}f(x,y)\\text{ }\\text{d}A & =\\frac{1}{4}{∬}_{C\\cup D}f(x,y)\\text{ }\\text{d}A \\\\  & =\\frac{1}{4}({∬}_{C}f(x,y)\\text{ }\\text{d}A+{∬}_{D}f(x,y)\\text{ }\\text{d}A) \\\\  & =\\frac{1}{4}(-3+11) \\\\  & =2\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186445486 #edb/ref 1068 #edb/ref 17592186445480 #edb/ref 17592186045417] [17592186445486 #edb/ref 1069 "q-81251" #edb/ref 17592186045417] [17592186445486 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186445486 #edb/ref 1071 "Let the function $f(x,y)$ be defined as\n\n$$\nf(x,y)=\\{\\begin{aligned}\\sqrt{{x}^{2}+y},\\, & \\text{if}\\,-1<x<1,\\,0<y<1, \\\\ x\\operatorname{ln}⁡y,\\, & \\text{if}\\,-1<x<1,\\,1<y<2.\\end{aligned}\n$$\n\nThen,\n\n$$\n{∬}_{(-1,1)\\times (0,2)}f(x,y)\\text{ }\\text{d}A=\n$$" #edb/ref 17592186045417] [17592186445486 #edb/ref 1072 #uuid "b71bb968-9c3f-5d3e-ba1d-d7915e2cf55e" #edb/ref 17592186045417] [17592186445486 #edb/ref 1074 "First, notice that the rectangle $R$ can be represented as a union of two smaller rectangles, as follows:\n\n$$\n\\begin{aligned}R & =(-1,1)\\times ((0,1)\\cup (1,2)) \\\\  & =((-1,1)\\times (0,1))\\cup ((-1,1)\\times (1,2)).\\end{aligned}\n$$\n\nSo, we can write\n\n$$\n\\begin{aligned}{∬}_{R}f(x,y)\\,\\text{d}A & ={∬}_{(-1,1)\\times (0,1)}f(x,y)\\,\\text{d}A+{∬}_{(-1,1)\\times (1,2)}f(x,y)\\,\\text{d}A \\\\  & ={∬}_{(-1,1)\\times (0,1)}\\sqrt{{x}^{2}+y}\\text{ }\\text{d}A+{∬}_{(-1,1)\\times (1,2)}x\\operatorname{ln}⁡y\\,\\text{d}A.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186445487 #edb/ref 1068 #edb/ref 17592186445478 #edb/ref 17592186045417] [17592186445487 #edb/ref 1069 "q-81247" #edb/ref 17592186045417] [17592186445487 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186445487 #edb/ref 1071 "![](images/bc/bcc2eb6cd27450375016677390700675e9733c03dfd2c0100622e6f8c7d18e78.png)\n\nConsider the region $R$ shown above. Let the function $f(x,y)$ be defined as\n\n$$\nf(x,y)=\\{\\begin{aligned}0, & (x,y)\\in S, \\\\ \\operatorname{cos}⁡x+\\operatorname{cos}⁡y, & (x,y)\\in T, \\\\ \\operatorname{sin}⁡x\\operatorname{sin}⁡y, & (x,y)\\in U.\\end{aligned}\n$$\n\nThen,\n\n$$\n{∬}_{R}f(x,y)\\text{ }\\text{d}A=\n$$" #edb/ref 17592186045417] [17592186445487 #edb/ref 1072 #uuid "c07dad32-9851-5aba-9075-fbf7d573fb0f" #edb/ref 17592186045417] [17592186445487 #edb/ref 1074 "First, notice that the domain $D$ can be represented as a union of three sub-domains, as follows:\n\n$$\n\\begin{aligned}R & =S\\cup T\\cup U.\\end{aligned}\n$$\n\nSo, we can write\n\n$$\n\\begin{aligned}{∬}_{R}f(x,y)\\,\\text{d}A & ={∬}_{S}f(x,y)\\,\\text{d}A+{∬}_{T}f(x,y)\\,\\text{d}A+{∬}_{U}f(x,y)\\,\\text{d}A \\\\  & ={∬}_{S}0\\,\\text{d}A+{∬}_{T}(\\operatorname{cos}⁡x+\\operatorname{cos}⁡y)\\,\\text{d}A+{∬}_{U}\\operatorname{sin}⁡x\\operatorname{sin}⁡y\\text{ }\\text{d}A \\\\  & ={∬}_{T}(\\operatorname{cos}⁡x+\\operatorname{cos}⁡y)\\,\\text{d}A+{∬}_{U}\\operatorname{sin}⁡x\\operatorname{sin}⁡y\\text{ }\\text{d}A.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186445488 #edb/ref 1068 #edb/ref 17592186445482 #edb/ref 17592186045417] [17592186445488 #edb/ref 1069 "q-129955" #edb/ref 17592186045417] [17592186445488 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186445488 #edb/ref 1071 "Evaluate the double integral ${∬}_{R}\\frac{6+{x}^{2}{y}^{2}}{{y}^{2}}\\,\\text{d}A$,  where $R=[0,3]\\times [1,2].$" #edb/ref 17592186045417] [17592186445488 #edb/ref 1072 #uuid "c4bacfe6-30e7-5d9e-a1c2-df77375c3f7b" #edb/ref 17592186045417] [17592186445488 #edb/ref 1074 "Using the linearity property of double integrals, we get\n\n$$\n\\begin{aligned}{∬}_{R}\\frac{6+{x}^{2}{y}^{2}}{{y}^{2}}\\,\\text{d}A & ={∬}_{R}(\\frac{6}{{y}^{2}}+{x}^{2})\\,\\text{d}A \\\\  & ={∬}_{R}\\frac{6}{{y}^{2}}\\text{ }\\text{d}A+{∬}_{R}{x}^{2}\\,\\text{d}A.\\end{aligned}\n$$\n\nThe function under the first integral is independent of $x.$ So, we have \n\n$$\n\\begin{aligned}{∬}_{R}\\frac{6}{{y}^{2}}\\text{ }\\text{d}A & =(3-0){\\int }_{1}^{2}\\frac{6}{{y}^{2}}\\,\\text{d}y \\\\  & =3\\cdot (-\\frac{6}{y}{|}_{1}^{2}) \\\\  & =-18(\\frac{1}{2}-1) \\\\  & =9.\\end{aligned}\n$$\n\nThe function under the second integral is independent of $y.$ So, we have \n\n$$\n\\begin{aligned}{∬}_{R}{x}^{2}\\,\\text{d}A & =(2-1){\\int }_{0}^{3}{x}^{2}\\,\\text{d}x \\\\  & =\\frac{{x}^{3}}{3}{|}_{0}^{3} \\\\  & =\\frac{{3}^{3}}{3}-0 \\\\  & =9.\\end{aligned}\n$$\n\nFinally, combining our results, we obtain \n\n$$\n\\begin{aligned}{∬}_{R}\\frac{6+{x}^{2}{y}^{2}}{{y}^{2}}\\,\\text{d}A=9+9=18.\\end{aligned}\n$$" #edb/ref 17592186045417]}
