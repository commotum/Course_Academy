[[:db/retract 17592186128557 :answer-field/choices 17592186128560] [:db/retract 17592186128557 :answer-field/choices 17592186128561] [:db/retract 17592186128557 :answer-field/choices 17592186128562] [:db/retract 17592186128557 :answer-field/choices 17592186128558] [:db/retract 17592186128557 :answer-field/choices 17592186128559] {:db/id 17592186129170 :knowledge-point/questions ["question-68e39739-c077-5ff6-83ad-f603767a81a6"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186129171 :knowledge-point/questions ["question-c4bacfe6-30e7-5d9e-a1c2-df77375c3f7b"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186129188 :knowledge-point/questions ["question-c07dad32-9851-5aba-9075-fbf7d573fb0f" "question-9794b451-1881-5349-8cf7-09e2d5dcd1d3"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186129846 :question/problem "Which of the following gives the value of the double integral ${∬}_{R}y\\sqrt{xy}\\text{ }\\text{d}A$ over the rectangle $R=[1,4]\\times [0,1]?$" :question/worked-solution "We apply the multiplicative property of double integrals, as follows:\n\n$$\n\\begin{aligned}{∬}_{R}y\\sqrt{xy}\\text{ }\\text{d}A & ={∬}_{R}y\\,{x}^{1/2}\\,{y}^{1/2}\\,\\text{d}A \\\\  & ={∬}_{R}({x}^{1/2})\\text{ }({y}^{3/2})\\,\\text{d}A \\\\  & =({\\int }_{1}^{4}\\sqrt{x}\\,\\text{d}x)({\\int }_{0}^{1}y\\sqrt{y}\\,\\text{d}y)\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186128557 :answer-field/correct "answer-18dd8f5f-c7eb-5382-bc1d-0f430199a813" :answer-field/choices ["answer-0737a4d6-7922-501a-85e2-cdcacd965620" "answer-3b3a5306-0d77-5431-97ec-aee41d4fd86f" "answer-18dd8f5f-c7eb-5382-bc1d-0f430199a813" "answer-9a0c2114-11bc-5668-ad0f-23cafddd72c3" "answer-1afa2a07-066e-5cde-b4a1-d851ce37e441"] :db/ensure [:answer-field/validate]} {:db/id "answer-0737a4d6-7922-501a-85e2-cdcacd965620" :answer/id #uuid "0737a4d6-7922-501a-85e2-cdcacd965620" :answer/type :answer.type/math :answer/value "({\\int }_{0}^{1}\\sqrt{x}\\,\\text{d}x)({\\int }_{1}^{4}y\\sqrt{y}\\,\\text{d}y)" :db/ensure [:answer/validate]} {:db/id "answer-3b3a5306-0d77-5431-97ec-aee41d4fd86f" :answer/id #uuid "3b3a5306-0d77-5431-97ec-aee41d4fd86f" :answer/type :answer.type/math :answer/value "({\\int }_{0}^{1}y\\,\\text{d}x)({\\int }_{1}^{4}y\\sqrt{x}\\,\\text{d}y)" :db/ensure [:answer/validate]} {:db/id "answer-18dd8f5f-c7eb-5382-bc1d-0f430199a813" :answer/id #uuid "18dd8f5f-c7eb-5382-bc1d-0f430199a813" :answer/type :answer.type/math :answer/value "({\\int }_{1}^{4}\\sqrt{x}\\,\\text{d}x)({\\int }_{0}^{1}y\\sqrt{y}\\,\\text{d}y)" :db/ensure [:answer/validate]} {:db/id "answer-9a0c2114-11bc-5668-ad0f-23cafddd72c3" :answer/id #uuid "9a0c2114-11bc-5668-ad0f-23cafddd72c3" :answer/type :answer.type/math :answer/value "({\\int }_{1}^{4}y\\,\\text{d}x)({\\int }_{0}^{1}y\\sqrt{x}\\,\\text{d}y)" :db/ensure [:answer/validate]} {:db/id "answer-1afa2a07-066e-5cde-b4a1-d851ce37e441" :answer/id #uuid "1afa2a07-066e-5cde-b4a1-d851ce37e441" :answer/type :answer.type/math :answer/value "({\\int }_{1}^{4}y\\sqrt{xy}\\,\\text{d}x)({\\int }_{0}^{1}y\\sqrt{xy}\\,\\text{d}y)" :db/ensure [:answer/validate]} {:db/id "question-68e39739-c077-5ff6-83ad-f603767a81a6" :question/id #uuid "68e39739-c077-5ff6-83ad-f603767a81a6" :question/math-academy-id "q-80510" :question/problem "Evaluate the double integral ${∬}_{R}{y}^{2}{csc}^{2}⁡x\\,\\text{d}A$ over the rectangle $R=[\\frac{\\pi }{4},\\frac{\\pi }{2}]\\times [0,3].$" :question/worked-solution "We apply the multiplicative property of double integrals and then evaluate each of the integrals separately:\n\n$$\n\\begin{aligned}{∬}_{R}{y}^{2}{csc}^{2}⁡x\\,\\text{d}A & ={∬}_{R}({csc}^{2}⁡x)({y}^{2})\\text{d}A \\\\  & =({\\int }_{\\pi /4}^{\\pi /2}{csc}^{2}⁡x\\,\\text{d}x)({\\int }_{0}^{3}{y}^{2}\\,\\text{d}y) \\\\  & =[-\\operatorname{cot}⁡x]_{\\pi /4}^{\\pi /2}\\cdot {[\\frac{{y}^{3}}{3}]}_{0}^{3} \\\\  & =(-\\operatorname{cot}⁡(\\frac{\\pi }{2})+\\operatorname{cot}⁡(\\frac{\\pi }{4}))\\cdot (\\frac{{3}^{3}}{3}-\\frac{{0}^{3}}{3}) \\\\  & =(0+1)\\cdot (9-0) \\\\  & =9\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-2b4c1a25-c7e8-5e0a-820b-a6b872059bec"] :db/ensure [:question/validate]} {:db/id "answer-field-2b4c1a25-c7e8-5e0a-820b-a6b872059bec" :answer-field/id #uuid "2b4c1a25-c7e8-5e0a-820b-a6b872059bec" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-81d3eef9-452b-5246-977a-3d6437685e16" :answer-field/choices ["answer-9b6ba610-9741-52ca-9ca3-ad5ada7c05b9" "answer-ff4624ca-0d05-58ce-acd8-870bbeb876b6" "answer-36c96f45-849b-5559-9bf5-b2baa5552f82" "answer-b33e5d43-cfa1-503d-a04e-f819581e6ff9" "answer-81d3eef9-452b-5246-977a-3d6437685e16"] :db/ensure [:answer-field/validate]} {:db/id "answer-9b6ba610-9741-52ca-9ca3-ad5ada7c05b9" :answer/id #uuid "9b6ba610-9741-52ca-9ca3-ad5ada7c05b9" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-ff4624ca-0d05-58ce-acd8-870bbeb876b6" :answer/id #uuid "ff4624ca-0d05-58ce-acd8-870bbeb876b6" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-36c96f45-849b-5559-9bf5-b2baa5552f82" :answer/id #uuid "36c96f45-849b-5559-9bf5-b2baa5552f82" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-b33e5d43-cfa1-503d-a04e-f819581e6ff9" :answer/id #uuid "b33e5d43-cfa1-503d-a04e-f819581e6ff9" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "answer-81d3eef9-452b-5246-977a-3d6437685e16" :answer/id #uuid "81d3eef9-452b-5246-977a-3d6437685e16" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "question-c4bacfe6-30e7-5d9e-a1c2-df77375c3f7b" :question/id #uuid "c4bacfe6-30e7-5d9e-a1c2-df77375c3f7b" :question/math-academy-id "q-129955" :question/problem "Evaluate the double integral ${∬}_{R}\\frac{6+{x}^{2}{y}^{2}}{{y}^{2}}\\,\\text{d}A$,  where $R=[0,3]\\times [1,2].$" :question/worked-solution "Using the linearity property of double integrals, we get\n\n$$\n\\begin{aligned}{∬}_{R}\\frac{6+{x}^{2}{y}^{2}}{{y}^{2}}\\,\\text{d}A & ={∬}_{R}(\\frac{6}{{y}^{2}}+{x}^{2})\\,\\text{d}A \\\\  & ={∬}_{R}\\frac{6}{{y}^{2}}\\text{ }\\text{d}A+{∬}_{R}{x}^{2}\\,\\text{d}A.\\end{aligned}\n$$\n\nThe function under the first integral is independent of $x.$ So, we have \n\n$$\n\\begin{aligned}{∬}_{R}\\frac{6}{{y}^{2}}\\text{ }\\text{d}A & =(3-0){\\int }_{1}^{2}\\frac{6}{{y}^{2}}\\,\\text{d}y \\\\  & =3\\cdot (-\\frac{6}{y}{|}_{1}^{2}) \\\\  & =-18(\\frac{1}{2}-1) \\\\  & =9.\\end{aligned}\n$$\n\nThe function under the second integral is independent of $y.$ So, we have \n\n$$\n\\begin{aligned}{∬}_{R}{x}^{2}\\,\\text{d}A & =(2-1){\\int }_{0}^{3}{x}^{2}\\,\\text{d}x \\\\  & =\\frac{{x}^{3}}{3}{|}_{0}^{3} \\\\  & =\\frac{{3}^{3}}{3}-0 \\\\  & =9.\\end{aligned}\n$$\n\nFinally, combining our results, we obtain \n\n$$\n\\begin{aligned}{∬}_{R}\\frac{6+{x}^{2}{y}^{2}}{{y}^{2}}\\,\\text{d}A=9+9=18.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d9a8646d-83af-52fd-a349-459e6460b606"] :db/ensure [:question/validate]} {:db/id "answer-field-d9a8646d-83af-52fd-a349-459e6460b606" :answer-field/id #uuid "d9a8646d-83af-52fd-a349-459e6460b606" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-22bea2a1-3640-54bb-b37a-5be01206ddd7" :answer-field/choices ["answer-4a778fe7-65d5-579b-bbd4-ac73193b8148" "answer-22bea2a1-3640-54bb-b37a-5be01206ddd7" "answer-842cd6fa-cc72-5447-a959-3164db0ba831" "answer-948fb597-3610-520a-bb28-3ef09776ffb8" "answer-1f7f1c17-e012-579b-b10d-42979ace1885"] :db/ensure [:answer-field/validate]} {:db/id "answer-4a778fe7-65d5-579b-bbd4-ac73193b8148" :answer/id #uuid "4a778fe7-65d5-579b-bbd4-ac73193b8148" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "answer-22bea2a1-3640-54bb-b37a-5be01206ddd7" :answer/id #uuid "22bea2a1-3640-54bb-b37a-5be01206ddd7" :answer/type :answer.type/math :answer/value "18" :db/ensure [:answer/validate]} {:db/id "answer-842cd6fa-cc72-5447-a959-3164db0ba831" :answer/id #uuid "842cd6fa-cc72-5447-a959-3164db0ba831" :answer/type :answer.type/math :answer/value "24" :db/ensure [:answer/validate]} {:db/id "answer-948fb597-3610-520a-bb28-3ef09776ffb8" :answer/id #uuid "948fb597-3610-520a-bb28-3ef09776ffb8" :answer/type :answer.type/math :answer/value "36" :db/ensure [:answer/validate]} {:db/id "answer-1f7f1c17-e012-579b-b10d-42979ace1885" :answer/id #uuid "1f7f1c17-e012-579b-b10d-42979ace1885" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "question-c07dad32-9851-5aba-9075-fbf7d573fb0f" :question/id #uuid "c07dad32-9851-5aba-9075-fbf7d573fb0f" :question/math-academy-id "q-81247" :question/problem "![](images/bc/bcc2eb6cd27450375016677390700675e9733c03dfd2c0100622e6f8c7d18e78.png)\n\nConsider the region $R$ shown above. Let the function $f(x,y)$ be defined as\n\n$$\nf(x,y)=\\{\\begin{aligned}0, & (x,y)\\in S, \\\\ \\operatorname{cos}⁡x+\\operatorname{cos}⁡y, & (x,y)\\in T, \\\\ \\operatorname{sin}⁡x\\operatorname{sin}⁡y, & (x,y)\\in U.\\end{aligned}\n$$\n\nThen,\n\n$$\n{∬}_{R}f(x,y)\\text{ }\\text{d}A=\n$$" :question/worked-solution "First, notice that the domain $D$ can be represented as a union of three sub-domains, as follows:\n\n$$\n\\begin{aligned}R & =S\\cup T\\cup U.\\end{aligned}\n$$\n\nSo, we can write\n\n$$\n\\begin{aligned}{∬}_{R}f(x,y)\\,\\text{d}A & ={∬}_{S}f(x,y)\\,\\text{d}A+{∬}_{T}f(x,y)\\,\\text{d}A+{∬}_{U}f(x,y)\\,\\text{d}A \\\\  & ={∬}_{S}0\\,\\text{d}A+{∬}_{T}(\\operatorname{cos}⁡x+\\operatorname{cos}⁡y)\\,\\text{d}A+{∬}_{U}\\operatorname{sin}⁡x\\operatorname{sin}⁡y\\text{ }\\text{d}A \\\\  & ={∬}_{T}(\\operatorname{cos}⁡x+\\operatorname{cos}⁡y)\\,\\text{d}A+{∬}_{U}\\operatorname{sin}⁡x\\operatorname{sin}⁡y\\text{ }\\text{d}A.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-48a4b43a-bc8c-5a55-9d9f-8d40124bc6f2"] :db/ensure [:question/validate]} {:db/id "answer-field-48a4b43a-bc8c-5a55-9d9f-8d40124bc6f2" :answer-field/id #uuid "48a4b43a-bc8c-5a55-9d9f-8d40124bc6f2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4462f986-7acc-5f17-a7aa-2ecb6de29a48" :answer-field/choices ["answer-239b5809-9ce8-5dea-8734-26328a32ffea" "answer-c134de05-6a5a-5052-989b-8f259ce1ac90" "answer-7943674e-8350-5027-ab62-6e0d1956e933" "answer-0dd10fb2-a06b-597a-9fc7-9460e0a38b79" "answer-4462f986-7acc-5f17-a7aa-2ecb6de29a48"] :db/ensure [:answer-field/validate]} {:db/id "answer-239b5809-9ce8-5dea-8734-26328a32ffea" :answer/id #uuid "239b5809-9ce8-5dea-8734-26328a32ffea" :answer/type :answer.type/math :answer/value "{∬}_{S}(\\operatorname{cos}⁡x+\\operatorname{cos}⁡y)\\,\\text{d}A+{∬}_{T}\\operatorname{sin}⁡x\\operatorname{sin}⁡y\\text{ }\\text{d}A" :db/ensure [:answer/validate]} {:db/id "answer-c134de05-6a5a-5052-989b-8f259ce1ac90" :answer/id #uuid "c134de05-6a5a-5052-989b-8f259ce1ac90" :answer/type :answer.type/math :answer/value "{∬}_{S}(\\operatorname{cos}⁡x+\\operatorname{cos}⁡y)\\,\\text{d}A+{∬}_{U}\\operatorname{sin}⁡x\\operatorname{sin}⁡y\\text{ }\\text{d}A" :db/ensure [:answer/validate]} {:db/id "answer-7943674e-8350-5027-ab62-6e0d1956e933" :answer/id #uuid "7943674e-8350-5027-ab62-6e0d1956e933" :answer/type :answer.type/math :answer/value "{∬}_{S}\\operatorname{cos}⁡x\\,\\text{d}A+{∬}_{T}\\operatorname{cos}⁡y\\,\\text{d}A+{∬}_{U}\\operatorname{sin}⁡x\\operatorname{sin}⁡y\\text{ }\\text{d}A" :db/ensure [:answer/validate]} {:db/id "answer-0dd10fb2-a06b-597a-9fc7-9460e0a38b79" :answer/id #uuid "0dd10fb2-a06b-597a-9fc7-9460e0a38b79" :answer/type :answer.type/math :answer/value "{∬}_{S}\\operatorname{cos}⁡y\\,\\text{d}A+{∬}_{T}\\operatorname{cos}⁡x\\,\\text{d}A+{∬}_{U}\\operatorname{sin}⁡x\\operatorname{sin}⁡y\\text{ }\\text{d}A" :db/ensure [:answer/validate]} {:db/id "answer-4462f986-7acc-5f17-a7aa-2ecb6de29a48" :answer/id #uuid "4462f986-7acc-5f17-a7aa-2ecb6de29a48" :answer/type :answer.type/math :answer/value "{∬}_{T}(\\operatorname{cos}⁡x+\\operatorname{cos}⁡y)\\,\\text{d}A+{∬}_{U}\\operatorname{sin}⁡x\\operatorname{sin}⁡y\\text{ }\\text{d}A" :db/ensure [:answer/validate]} {:db/id "question-9794b451-1881-5349-8cf7-09e2d5dcd1d3" :question/id #uuid "9794b451-1881-5349-8cf7-09e2d5dcd1d3" :question/math-academy-id "q-130019" :question/problem "Given that $C$ and $D$ are finite, non-overlapping regions and that\n\n$$\n{∬}_{C}f(x,y)\\text{ }\\text{d}A=-3,\\,{∬}_{D}f(x,y)\\text{ }\\text{d}A=11,\n$$\n\nfind the value of \n\n$$\n{∬}_{C\\cup D}\\frac{1}{4}f(x,y)\\text{ }\\text{d}A.\n$$" :question/worked-solution "Using the linearity and additivity of double integrals, we get the following:\n\n$$\n\\begin{aligned}{∬}_{C\\cup D}\\frac{1}{4}f(x,y)\\text{ }\\text{d}A & =\\frac{1}{4}{∬}_{C\\cup D}f(x,y)\\text{ }\\text{d}A \\\\  & =\\frac{1}{4}({∬}_{C}f(x,y)\\text{ }\\text{d}A+{∬}_{D}f(x,y)\\text{ }\\text{d}A) \\\\  & =\\frac{1}{4}(-3+11) \\\\  & =2\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d8602de3-643b-512d-8235-9d9217ba8f38"] :db/ensure [:question/validate]} {:db/id "answer-field-d8602de3-643b-512d-8235-9d9217ba8f38" :answer-field/id #uuid "d8602de3-643b-512d-8235-9d9217ba8f38" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-cbdb1160-1c9e-5a17-94d0-e98a44eb4815" :answer-field/choices ["answer-24d7484c-3ae5-5063-8b35-977a513d4bd6" "answer-7724f8f2-18ad-546b-9e22-590fc275f5e3" "answer-cbdb1160-1c9e-5a17-94d0-e98a44eb4815" "answer-c4559e50-3f4e-5b00-af09-75d0e5472202" "answer-af701f69-f74a-509d-94be-0d22341fdc2d"] :db/ensure [:answer-field/validate]} {:db/id "answer-24d7484c-3ae5-5063-8b35-977a513d4bd6" :answer/id #uuid "24d7484c-3ae5-5063-8b35-977a513