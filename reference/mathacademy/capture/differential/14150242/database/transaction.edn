0, & (x,y)\\in T, \\\\ {x}^{2}+{y}^{2}, & (x,y)\\in U.\\end{aligned}\n$$\n\nThen,\n\n$$\n{∬}_{R}f(x,y)\\text{ }\\text{d}A=\n$$" :db/ensure [:question/validate]} {:db/id 17592186129172 :knowledge-point/questions ["question-1f7e7929-7b85-5acd-be84-f40a79eeb887" "question-b71bb968-9c3f-5d3e-ba1d-d7915e2cf55e"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186265807 :question/problem "Evaluate the double integral ${∬}_{R}f(x,y)\\,\\text{d}A$, where\n\n$$\nf(x,y)=\\{\\begin{aligned}x{y}^{2},\\, & \\text{if}\\,-2<x<0,\\,0<y<2, \\\\ 2x,\\, & \\text{if}\\,0<x<1,\\,0<y<2,\\end{aligned}\n$$\n\nand  $R$ is the domain of $f.$" :db/ensure [:question/validate]} {:db/id "question-1f7e7929-7b85-5acd-be84-f40a79eeb887" :question/id #uuid "1f7e7929-7b85-5acd-be84-f40a79eeb887" :question/math-academy-id "q-80662" :question/problem "Let the function $f(x,y)$ be defined as\n\n$$\nf(x,y)=\\{\\begin{aligned}{x}^{2}-{y}^{2},\\, & \\text{if}\\,0<x<1,\\,0<y<1, \\\\ {e}^{(x-y)},\\, & \\text{if}\\,1<x<2,\\,0<y<1.\\end{aligned}\n$$\n\nThen,\n\n$$\n{∬}_{(0,2)\\times (0,1)}f(x,y)\\text{ }\\text{d}A=\n$$" :question/worked-solution "First, notice that the rectangle $R$ can be represented as a union of two smaller rectangles, as follows:\n\n$$\n\\begin{aligned}R & =((0,1)\\cup (1,2))\\times (0,1) \\\\  & =((0,1)\\times (0,1))\\cup ((1,2)\\times (0,1)).\\end{aligned}\n$$\n\nSo, we can write\n\n$$\n\\begin{aligned}{∬}_{R}f(x,y)\\,\\text{d}A & ={∬}_{(0,1)\\times (0,1)}f(x,y)\\,\\text{d}A+{∬}_{(1,2)\\times (0,1)}f(x,y)\\,\\text{d}A \\\\  & ={∬}_{(0,1)\\times (0,1)}({x}^{2}-{y}^{2})\\,\\text{d}A+{∬}_{(1,2)\\times (0,1)}{e}^{(x-y)}\\,\\text{d}A.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-715fd868-4860-5d80-b1ca-fd540ecc3dd6"] :db/ensure [:question/validate]} {:db/id "answer-field-715fd868-4860-5d80-b1ca-fd540ecc3dd6" :answer-field/id #uuid "715fd868-4860-5d80-b1ca-fd540ecc3dd6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0b57a437-d5b0-5a5d-b1ff-35d38a6dde20" :answer-field/choices ["answer-0b57a437-d5b0-5a5d-b1ff-35d38a6dde20" "answer-6476986e-34b1-5256-b5dd-66cd4a918d16" "answer-934ab2fb-0ff6-58be-abfc-b6ac610f4406" "answer-4420423b-4450-5202-b0cc-f36730793a82" "answer-8af31339-6b09-525f-b717-5f12cc5c4fcd"] :db/ensure [:answer-field/validate]} {:db/id "answer-0b57a437-d5b0-5a5d-b1ff-35d38a6dde20" :answer/id #uuid "0b57a437-d5b0-5a5d-b1ff-35d38a6dde20" :answer/type :answer.type/math :answer/value "{∬}_{(0,1)\\times (0,1)}({x}^{2}-{y}^{2})\\,\\text{d}A\\text{ }+{∬}_{(1,2)\\times (0,1)}{e}^{(x-y)}\\,\\text{d}A" :db/ensure [:answer/validate]} {:db/id "answer-6476986e-34b1-5256-b5dd-66cd4a918d16" :answer/id #uuid "6476986e-34b1-5256-b5dd-66cd4a918d16" :answer/type :answer.type/math :answer/value "{∬}_{(0,1)\\times (0,1)}{e}^{(x+y)}\\,\\text{d}A\\text{ }+{∬}_{(0,1)\\times (0,1)}({x}^{2}-{y}^{2})\\,\\text{d}A" :db/ensure [:answer/validate]} {:db/id "answer-934ab2fb-0ff6-58be-abfc-b6ac610f4406" :answer/id #uuid "934ab2fb-0ff6-58be-abfc-b6ac610f4406" :answer/type :answer.type/math :answer/value "{∬}_{(0,1)\\times (0,1)}{e}^{(x+y)}\\,\\text{d}A\\text{ }+{∬}_{(0,2)\\times (0,1)}({x}^{2}-{y}^{2})\\,\\text{d}A" :db/ensure [:answer/validate]} {:db/id "answer-4420423b-4450-5202-b0cc-f36730793a82" :answer/id #uuid "4420423b-4450-5202-b0cc-f36730793a82" :answer/type :answer.type/math :answer/value "{∬}_{(0,1)\\times (0,1)}{e}^{(x-y)}\\,\\text{d}A\\text{ }+{∬}_{(1,2)\\times (0,1)}(x-y)\\,\\text{d}A" :db/ensure [:answer/validate]} {:db/id "answer-8af31339-6b09-525f-b717-5f12cc5c4fcd" :answer/id #uuid "8af31339-6b09-525f-b717-5f12cc5c4fcd" :answer/type :answer.type/math :answer/value "{∬}_{(0,1)\\times (0,1)}{e}^{(x-y)}\\,\\text{d}A\\text{ }+{∬}_{(1,2)\\times (0,1)}({x}^{2}-{y}^{2})\\,\\text{d}A" :db/ensure [:answer/validate]} {:db/id "question-b71bb968-9c3f-5d3e-ba1d-d7915e2cf55e" :question/id #uuid "b71bb968-9c3f-5d3e-ba1d-d7915e2cf55e" :question/math-academy-id "q-81251" :question/problem "Let the function $f(x,y)$ be defined as\n\n$$\nf(x,y)=\\{\\begin{aligned}\\sqrt{{x}^{2}+y},\\, & \\text{if}\\,-1<x<1,\\,0<y<1, \\\\ x\\operatorname{ln}⁡y,\\, & \\text{if}\\,-1<x<1,\\,1<y<2.\\end{aligned}\n$$\n\nThen,\n\n$$\n{∬}_{(-1,1)\\times (0,2)}f(x,y)\\text{ }\\text{d}A=\n$$" :question/worked-solution "First, notice that the rectangle $R$ can be represented as a union of two smaller rectangles, as follows:\n\n$$\n\\begin{aligned}R & =(-1,1)\\times ((0,1)\\cup (1,2)) \\\\  & =((-1,1)\\times (0,1))\\cup ((-1,1)\\times (1,2)).\\end{aligned}\n$$\n\nSo, we can write\n\n$$\n\\begin{aligned}{∬}_{R}f(x,y)\\,\\text{d}A & ={∬}_{(-1,1)\\times (0,1)}f(x,y)\\,\\text{d}A+{∬}_{(-1,1)\\times (1,2)}f(x,y)\\,\\text{d}A \\\\  & ={∬}_{(-1,1)\\times (0,1)}\\sqrt{{x}^{2}+y}\\text{ }\\text{d}A+{∬}_{(-1,1)\\times (1,2)}x\\operatorname{ln}⁡y\\,\\text{d}A.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c116b0e2-e431-5aed-b05a-a7ba568545f7"] :db/ensure [:question/validate]} {:db/id "answer-field-c116b0e2-e431-5aed-b05a-a7ba568545f7" :answer-field/id #uuid "c116b0e2-e431-5aed-b05a-a7ba568545f7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7adbe63b-2db0-59cf-9b4f-f2e0611fddb5" :answer-field/choices ["answer-421d54ba-8758-5066-8e3e-38909ec2e2da" "answer-7adbe63b-2db0-59cf-9b4f-f2e0611fddb5" "answer-3c07a49b-7df9-594b-b205-67f90501842d" "answer-7e0faed7-4a17-5ff4-8621-3575f43df76e" "answer-f172a015-8a01-5667-8b61-667a981d09c3"] :db/ensure [:answer-field/validate]} {:db/id "answer-421d54ba-8758-5066-8e3e-38909ec2e2da" :answer/id #uuid "421d54ba-8758-5066-8e3e-38909ec2e2da" :answer/type :answer.type/math :answer/value "{∬}_{(-1,0)\\times (0,2)}\\sqrt{{x}^{2}+y}\\text{ }\\text{d}A+{∬}_{(0,1)\\times (0,2)}x\\operatorname{ln}⁡y\\,\\text{d}A" :db/ensure [:answer/validate]} {:db/id "answer-7adbe63b-2db0-59cf-9b4f-f2e0611fddb5" :answer/id #uuid "7adbe