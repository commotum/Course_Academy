"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cbfee9e-4466-5d01-855a-e21d7841909e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186522046} {:answer/id #uuid "774b6252-ac79-5295-9696-c5b38934b2f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186522254} {:answer/id #uuid "d6fc054d-f432-5e48-80e0-9883d69b2ca1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186522463} {:answer/id #uuid "d9ecc8b6-74da-5721-98a4-2a91bf3b2732" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186522472} {:answer/id #uuid "ea604d9c-3b99-5d23-bed8-d1c3b72ae418" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186522519}] :answer-field/correct {:answer/id #uuid "d6fc054d-f432-5e48-80e0-9883d69b2ca1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186522463} :answer-field/id #uuid "2aa6d75d-d150-5ead-9241-1669c7a06d65" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186522572}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c3347265-887a-5de9-9351-68357744a4ce" :question/math-academy-id "q-96520" :question/problem "Given that $X$ is a random variable such that $X∼U[-4,8],$ find $\\text{Var}[X].$" :question/worked-solution "If the random variable $X$ is distributed uniformly over the interval $[a,b],$ then \n\n$$\n\\text{Var}[X]=\\frac{(b-a)^{2}}{12}.\n$$\n\nIn our case, we have $a=-4$ and $b=8.$ Therefore,\n\n$$\n\\text{Var}[X]=\\frac{(8-(-4))^{2}}{12}=\\frac{144}{12}=12.\n$$"}] [{:db/id #edb/ref 17592186522785 :knowledge-point/_questions [{:db/id #edb/ref 17592186166794 :knowledge-point/id #uuid "edde1bb6-42d9-5b8d-a29b-7fa91711f017" :knowledge-point/title "Computing the Standard Deviation of a Uniformly Distributed Random Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29463e7b-c8c0-51d7-93d6-7774a9c54d55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.887" :db/id #edb/ref 17592186522113} {:answer/id #uuid "2990c4d8-929c-564c-b712-68cdba4a013c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.888" :db/id #edb/ref 17592186522114} {:answer/id #uuid "2ea0ee42-9ae3-51d3-a1f6-a75e3d8f47f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.787" :db/id #edb/ref 17592186522123} {:answer/id #uuid "90492895-f69d-5f5c-a7e5-e943a4b6a388" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.807" :db/id #edb/ref 17592186522313} {:answer/id #uuid "aa5f63f6-ba7b-5514-aaf1-1936a49abd0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.087" :db/id #edb/ref 17592186522377}] :answer-field/correct {:answer/id #uuid "29463e7b-c8c0-51d7-93d6-7774a9c54d55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.887" :db/id #edb/ref 17592186522113} :answer-field/id #uuid "3e5b1be4-b223-5353-b1fb-c40e1ba25b64" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186522589}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d1619c3f-d3f5-5de9-b2f1-3d2eb5956079" :question/math-academy-id "q-96559" :question/problem "Given that $X$ is a random variable such that $X∼U[-7,3],$ find $\\text{SD}[X].$ Round your answer to three decimal places." :question/worked-solution "If the random variable $X$ is distributed uniformly over the interval $[a,b],$ then \n\n$$\n\\text{Var}[X]=\\frac{(b-a)^{2}}{12}.\n$$\n\nIn our case, we have $a=-7$ and $b=3.$ Therefore,\n\n$$\n\\text{Var}[X]=\\frac{(3-(-7))^{2}}{12}=\\frac{100}{12}=\\frac{25}{3}.\n$$\n\nFinally,\n\n$$\n\\text{SD}[X]=\\sqrt{\\frac{25}{3}}=\\frac{5\\sqrt{3}}{3}≈2.887.\n$$"}]}
