#{[{:db/id #edb/ref 17592186166583 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186166745 :knowledge-point/id #uuid "dc6e264d-f845-51a5-acaa-852e5582c9b2" :knowledge-point/title "Computing the Expected Value of a Uniformly Distributed Random Variable"}] :question/id #uuid "52f0578f-6ac1-5b02-afa0-3df525bb755a" :question/math-academy-id "e-7956" :question/problem "Given that $X$ is a random variable such that $X\\sim U[2,8],$ find $\\textrm{E}[X].$" :question/worked-solution "If the random variable $X$ is distributed uniformly over the interval $[a,b],$ then \n\n$$\n\\textrm{E}[X] = \\dfrac{a+b}{2}.\n$$\n\nIn our case, we have $a=2$ and $b=8.$ Therefore,\n\n$$\n\\textrm{E}[X] = \\dfrac{2+8}{2} =5.\n$$"}] [{:db/id #edb/ref 17592186166584 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186166746 :knowledge-point/id #uuid "b4b957bc-c1dd-5f7f-820c-8345a3bded2a" :knowledge-point/title "Computing the Variance of a Uniformly Distributed Random Variable"}] :question/id #uuid "c562f2c3-f1e0-5484-bbdf-9f178363d407" :question/math-academy-id "e-7957" :question/problem "Given that $X$ is a random variable such that $X\\sim U[2,10],$ find $\\textrm{Var}[X].$" :question/worked-solution "If the random variable $X$ is distributed uniformly over the interval $[a,b],$ then \n\n$$\n\\textrm{Var}[X] = \\dfrac{(b-a)^2}{12}.\n$$\n\nIn our case, we have $a=2$ and $b=10.$ Therefore,\n\n$$\n\\textrm{Var}[X] = \\dfrac{(10-2)^2}{12} = \\dfrac{64}{12} = \\dfrac{16}{3}.\n$$"}] [{:db/id #edb/ref 17592186166632 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186166794 :knowledge-point/id #uuid "edde1bb6-42d9-5b8d-a29b-7fa91711f017" :knowledge-point/title "Computing the Standard Deviation of a Uniformly Distributed Random Variable"}] :question/id #uuid "b0e62d58-c20a-5907-8486-eb9f03611b07" :question/math-academy-id "e-8431" :question/problem "Given that $X$ is a random variable such that $X\\sim U[-9,-3],$ find $\\textrm{SD}[X].$ Round your answer to three decimal places." :question/worked-solution "If the random variable $X$ is distributed uniformly over the interval $[a,b],$ then \n\n$$\n\\textrm{Var}[X] = \\dfrac{(b-a)^2}{12}.\n$$\n\nIn our case, we have $a=-9$ and $b=-3.$ Therefore,\n\n$$\n\\textrm{Var}[X] = \\dfrac{(-3-(-9))^2}{12} = \\dfrac{36}{12} = 3.\n$$\n\nFinally,\n\n$$\n\\textrm{SD}[X] = \\sqrt{3} \\approx 1.732.\n$$"}] [{:db/id #edb/ref 17592186522733 :knowledge-point/_questions [{:db/id #edb/ref 17592186166745 :knowledge-point/id #uuid "dc6e264d-f845-51a5-acaa-852e5582c9b2" :knowledge-point/title "Computing the Expected Value of a Uniformly Distributed Random Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e7221d7-4519-5f7d-8b8a-ba1e3d9d4615" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "55" :db/id #edb/ref 17592186522215} {:answer/id #uuid "834eb32a-81bd-598a-8d65-499839ac3bd2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186522281} {:answer/id #uuid "a1c91350-8bea-5b16-899d-ccfff6ea5e81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186522358} {:answer/id #uuid "ba17c72b-8895-548d-bd44-11f9810cc5cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186522405} {:answer/id #uuid "e671608b-856d-5b5f-94b4-e0f8046392f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186522512}] :answer-field/correct {:answer/id #uuid "ba17c72b-8895-548d-bd44-11f9810cc5cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186522405} :answer-field/id #uuid "745ff0ef-d77a-5de5-93bb-c47c12d5a667" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592