#{[{:db/id #edb/ref 17592186166583 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186166745 :knowledge-point/id #uuid "dc6e264d-f845-51a5-acaa-852e5582c9b2" :knowledge-point/title "Computing the Expected Value of a Uniformly Distributed Random Variable"}] :question/id #uuid "52f0578f-6ac1-5b02-afa0-3df525bb755a" :question/math-academy-id "e-7956" :question/problem "Given that $X$ is a random variable such that $X\\sim U[2,8]$, find $\\textrm{E}[X]$." :question/worked-solution "If the random variable $X$ is distributed uniformly over the interval $[a,b]$, then\n\n$$\n\\textrm{E}[X] = \\dfrac{a+b}{2}\n$$\n\nIn our case, we have $a=2$ and $b=8$. Therefore,\n\n$$\n\\textrm{E}[X] = \\dfrac{2+8}{2} =5\n$$"}] [{:db/id #edb/ref 17592186166584 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186166746 :knowledge-point/id #uuid "b4b957bc-c1dd-5f7f-820c-8345a3bded2a" :knowledge-point/title "Computing the Variance of a Uniformly Distributed Random Variable"}] :question/id #uuid "c562f2c3-f1e0-5484-bbdf-9f178363d407" :question/math-academy-id "e-7957" :question/problem "Given that $X$ is a random variable such that $X\\sim U[2,10]$, find $\\textrm{Var}[X]$." :question/worked-solution "If the random variable $X$ is distributed uniformly over the interval $[a,b]$, then\n\n$$\n\\textrm{Var}[X] = \\dfrac{(b-a)^2}{12}\n$$\n\nIn our case, we have $a=2$ and $b=10$. Therefore,\n\n$$\n\\textrm{Var}[X] = \\dfrac{(10-2)^2}{12} = \\dfrac{64}{12} = \\dfrac{16}{3}\n$$"}] [{:db/id #edb/ref 17592186166632 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186166794 :knowledge-point/id #uuid "edde1bb6-42d9-5b8d-a29b-7fa91711f017" :knowledge-point/title "Computing the Standard Deviation of a Uniformly Distributed Random Variable"}] :question/id #uuid "b0e62d58-c20a-5907-8486-eb9f03611b07" :question/math-academy-id "e-8431" :question/problem "Given that $X$ is a random variable such that $X\\sim U[-9,-3]$, find $\\textrm{SD}[X]$. Round your answer to three decimal places." :question/worked-solution "If the random variable $X$ is distributed uniformly over the interval $[a,b]$, then\n\n$$\n\\textrm{Var}[X] = \\dfrac{(b-a)^2}{12}\n$$\n\nIn our case, we have $a=-9$ and $b=-3$. Therefore,\n\n$$\n\\textrm{Var}[X] = \\dfrac{(-3-(-9))^2}{12} = \\dfrac{36}{12} = 3\n$$\n\nFinally,\n\n$$\n\\textrm{SD}[X] = \\sqrt{3} \\approx 1.732\n$$"}] [{:db/id #edb/ref 17592186167324 :knowledge-point/_questions [{:db/id #edb/ref 17592186166794 :knowledge-point/id #uuid "edde1bb6-42d9-5b8d-a29b-7fa91711f017" :knowledge-point/title "Computing the Standard Deviation of a Uniformly Distributed Random Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86fd5e6f-a7c7-571a-93e4-e98201a5e1f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.691" :db/id #edb/ref 17592186165154} {:answer/id #uuid "9672016e-7fb5-5455-b76c-37595c938151" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.889" :db/id #edb/ref 17592186165155} {:answer/id #uuid "a2af44f5-664e-5cd1-b0ad-d4846cedd453" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.598" :db/id #edb/ref 17592186165156} {:answer/id #uuid "3b972906-6727-543c-bea6-077be6648f8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.632" :db/id #edb/ref 17592186165157} {:answer/id #uuid "4dce9b9d-d5bc-5c9f-8eb8-c6bb258180c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.452" :db/id #edb/ref 17592186165158}] :answer-field/id #uuid "ffb109c8-2e70-5b05-a65b-94cf4d9aab95" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186165153}] :question/id #uuid "5a48c156-c9c3-5e89-bbfe-cc6cc76b44a6" :question/math-academy-id "q-90669" :question/problem "Given that $X$ is a random variable such that $X∼U[- 5, 4]$, find $SD[