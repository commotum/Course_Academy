#{[{:db/id #edb/ref 17592186287975 :knowledge-point/_questions [{:db/id #edb/ref 17592186105737 :knowledge-point/id #uuid "3e0b4d33-7699-5068-90f1-663534cd662d" :knowledge-point/title "Calculating Scalar Triple Products Using Its Properties"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "343abe13-b014-58c0-913d-2fc9f7a11d8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186285270} {:answer/id #uuid "4c3b1e45-a9c8-5b28-b558-ec4bc793eb4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186285496} {:answer/id #uuid "a878dcad-4ddf-585b-a29e-6f1bfa1aa273" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186286324} {:answer/id #uuid "c9e6bcc3-f1d7-59c6-953b-c03961aeaf47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186286630} {:answer/id #uuid "fbedc400-7438-5567-8dfa-d1cfcb39be79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186287087}] :answer-field/correct {:answer/id #uuid "fbedc400-7438-5567-8dfa-d1cfcb39be79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186287087} :answer-field/id #uuid "42a770db-2d9f-5df9-858e-0db4cb77fe94" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287293}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ae812812-92a4-5aa7-85f9-50adcd0043cf" :question/math-academy-id "q-20059" :question/problem "Find $c\\cdot (a\\times b)$, if $3a\\cdot (\\sqrt{2}b\\times 3c)=18\\sqrt{2}.$" :question/worked-solution "First, we factor out the constants and get\n\n$$\n\\begin{aligned}3a\\cdot (\\sqrt{2}b\\times 3c) & =18\\sqrt{2} \\\\ 3\\cdot \\sqrt{2}\\cdot 3\\cdot [a\\cdot (b\\times c)] & =18\\sqrt{2} \\\\ a\\cdot (b\\times c) & =2.\\end{aligned}\n$$\n\nThen, we swap $c$ and $b$ to get\n\n$$\n\\begin{aligned}a\\cdot (c\\times b) & =-2,\\end{aligned}\n$$\n\nand again we swap $c$ and $a$ to get\n\n$$\n\\begin{aligned}c\\cdot (a\\times b) & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341980 :knowledge-point/_questions [{:db/id #edb/ref 17592186105736 :knowledge-point/id #uuid "ff317cd2-0896-5134-b3a3-4e9f84e22b68" :knowledge-point/title "Calculating the Scalar Triple Product Using a Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05a8d4cf-2a52-5eb3-932c-de54f969d498" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186339176} {:answer/id #uuid "3c2029a1-5daa-5d17-915b-5cb3db9d0a31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186339665} {:answer/id #uuid "7364ef2c-a924-50d5-ae40-c9a6106f8bfa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-30" :db/id #edb/ref 17592186340152} {:answer/id #uuid "84d38775-5cfe-5497-a2ea-945dc01057b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-33" :db/id #edb/ref 17592186340321} {:answer/id #uuid "a0f005ac-dfb9-5a8e-9f29-140e8e17a482" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186340588}] :answer-field/correct {:answer/id #uuid "84d38775-5cfe-5497-a2ea-945dc01057b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-33" :db/id #edb/ref 17592186340321} :answer-field/id #uuid "50438105-46e0-54c5-8329-966f684eb5e4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341522}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fc420fe9-802f-5344-9de7-9b53d8435b37" :question/math-academy-id "q-73462" :question/problem "Let $p=⟨3,1,2⟩$, $q=⟨1,-2,1⟩$ and $r=⟨4,1,-2⟩.$ Find $r\\cdot (q\\times p).$" :question/worked-solution "Remember that the scalar triple product $r\\cdot (q\\times p)$ is just the determinant of the matrix whose rows are given by $r,$ $q,$ and $p.$\n\nSo, we have\n\n$$\n\\begin{aligned}r\\cdot (q\\times p) & =|\\begin{aligned}4 & 1 & -2 \\\\ 1 & -2 & 1 \\\\ 3 & 1 & 2\\end{aligned}| \\\\  & =4\\cdot |\\begin{aligned}-2 & 1 \\\\ 1 & 2\\end{aligned}|-1\\cdot |\\begin{aligned}1 & 1 \\\\ 3 & 2\\end{aligned}|+(-2)\\cdot |\\begin{aligned}1 & -2 \\\\ 3 & 1\\end{aligned}| \\\\  & =4((-2)\\cdot 2-1\\cdot 1)-(1\\cdot 2-1\\cdot 3)-2(1\\cdot 1-(-2)\\cdot 3) \\\\  & =-20+1-14 \\\\  & =-33.\\end{aligned}\n$$"}]}
