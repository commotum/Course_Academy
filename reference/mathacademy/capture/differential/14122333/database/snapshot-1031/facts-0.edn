6287666 #edb/ref 1078 #edb/ref 17592186286495 #edb/ref 17592186045417] [17592186287666 #edb/ref 1079 #uuid "ffd48eaf-9d9e-5aaf-ad75-c7d452ae0613" #edb/ref 17592186045417] [17592186287975 #edb/ref 1068 #edb/ref 17592186287293 #edb/ref 17592186045417] [17592186287975 #edb/ref 1069 "q-20059" #edb/ref 17592186045417] [17592186287975 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186287975 #edb/ref 1071 "Find $c\\cdot (a\\times b)$, if $3a\\cdot (\\sqrt{2}b\\times 3c)=18\\sqrt{2}.$" #edb/ref 17592186045417] [17592186287975 #edb/ref 1072 #uuid "ae812812-92a4-5aa7-85f9-50adcd0043cf" #edb/ref 17592186045417] [17592186287975 #edb/ref 1074 "First, we factor out the constants and get\n\n$$\n\\begin{aligned}3a\\cdot (\\sqrt{2}b\\times 3c) & =18\\sqrt{2} \\\\ 3\\cdot \\sqrt{2}\\cdot 3\\cdot [a\\cdot (b\\times c)] & =18\\sqrt{2} \\\\ a\\cdot (b\\times c) & =2.\\end{aligned}\n$$\n\nThen, we swap $c$ and $b$ to get\n\n$$\n\\begin{aligned}a\\cdot (c\\times b) & =-2,\\end{aligned}\n$$\n\nand again we swap $c$ and $a$ to get\n\n$$\n\\begin{aligned}c\\cdot (a\\times b) & =2.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186339176 #edb/ref 1080 "-14" #edb/ref 17592186045417] [17592186339176 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186339176 #edb/ref 1083 #uuid "05a8d4cf-2a52-5eb3-932c-de54f969d498" #edb/ref 17592186045417] [17592186339665 #edb/ref 1080 "10" #edb/ref 17592186045417] [17592186339665 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186339665 #edb/ref 1083 #uuid "3c2029a1-5daa-5d17-915b-5cb3db9d0a31" #edb/ref 17592186045417] [17592186340152 #edb/ref 1080 "-30" #edb/ref 17592186045417] [17592186340152 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186340152 #edb/ref 1083 #uuid "7364ef2c-a924-50d5-ae40-c9a6106f8bfa" #edb/ref 17592186045417] [17592186340321 #edb/ref 1080 "-33" #edb/ref 17592186045417] [17592186340321 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17