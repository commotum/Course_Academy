aligned}| \\\\  & =4((-2)\\cdot 2-1\\cdot 1)-(1\\cdot 2-1\\cdot 3)-2(1\\cdot 1-(-2)\\cdot 3) \\\\  & =-20+1-14 \\\\  & =-33.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186408102 #edb/ref 1043 #edb/ref 17592186408113 #edb/ref 17592186045417] [17592186408102 #edb/ref 1043 #edb/ref 17592186408114 #edb/ref 17592186045417] [17592186408102 #edb/ref 1043 #edb/ref 17592186408115 #edb/ref 17592186045417] [17592186408102 #edb/ref 1043 #edb/ref 17592186408116 #edb/ref 17592186045417] [17592186408102 #edb/ref 1043 #edb/ref 17592186408117 #edb/ref 17592186045417] [17592186408102 #edb/ref 1044 #edb/ref 17592186045464 #edb/ref 17592186045417] [17592186408102 #edb/ref 1045 "The Scalar Triple Product" #edb/ref 17592186045417] [17592186408102 #edb/ref 1046 #edb/ref 17592186408114 #edb/ref 17592186045417] [17592186408102 #edb/ref 1048 #edb/ref 17592186046673 #edb/ref 17592186045417] [17592186408102 #edb/ref 1049 #edb/ref 17592186050356 #edb/ref 17592186045417] [17592186408102 #edb/ref 1053 #uuid "541e0bf9-d38c-5752-a23f-c4c9f0e075e8" #edb/ref 17592186045417] [17592186408103 #edb/ref 1080 "-6" #edb/ref 17592186045417] [17592186408103 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186408103 #edb/ref 1083 #uuid "56ef0874-008a-597f-b2cb-02be44cd3944" #edb/ref 17592186045417] [17592186408104 #edb/ref 1080 "8" #edb/ref 17592186045417] [17592186408104 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186408104 #edb/ref 1083 #uuid "6d8dcecd-d942-5c7a-b18e-cb5a2602acc6" #edb/ref 17592186045417] [17592186408105 #edb/ref 1080 "-10" #edb/ref 17592186045417] [17592186408105 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186408105 #edb/ref 1083 #uuid "9cf98593-9506-526d-9be6-5176a031c0ec" #edb/ref 17592186045417] [17592186408106 #edb/ref 1080 "6" #edb/ref 17592186045417] [17592186408106 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186408106 #edb/ref 1083 #uuid "a019b149-6685-5c94-9ead-07affcb89def" #edb/re