#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186419792} :activity/id #uuid "e3670cc4-3e0e-52dd-b203-84b0f2da8c90" :activity/scope {:db/id #edb/ref 17592186050356 :topic/id #uuid "421dabda-4549-5ad6-b909-e9e0b37e1c41" :topic/math-academy-id 1286} :activity/steps [{:db/id #edb/ref 17592186419788 :step/content {:db/id #edb/ref 17592186341980 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05a8d4cf-2a52-5eb3-932c-de54f969d498" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-14" :db/id #edb/ref 17592186339176} {:answer/id #uuid "3c2029a1-5daa-5d17-915b-5cb3db9d0a31" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186339665} {:answer/id #uuid "7364ef2c-a924-50d5-ae40-c9a6106f8bfa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-30" :db/id #edb/ref 17592186340152} {:answer/id #uuid "84d38775-5cfe-5497-a2ea-945dc01057b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-33" :db/id #edb/ref 17592186340321} {:answer/id #uuid "a0f005ac-dfb9-5a8e-9f29-140e8e17a482" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-20" :db/id #edb/ref 17592186340588}] :answer-field/correct {:db/id #edb/ref 17592186340321} :answer-field/id #uuid "50438105-46e0-54c5-8329-966f684eb5e4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341522}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "fc420fe9-802f-5344-9de7-9b53d8435b37" :question/math-academy-id "q-73462" :question/problem "Let $p=⟨3,1,2⟩$, $q=⟨1,-2,1⟩$ and $r=⟨4,1,-2⟩.$ Find $r\\cdot (q\\times p).$" :question/worked-solution "Remember that the scalar triple product $r\\cdot (q\\times p)$ is just the determinant of the matrix whose rows are given by $r,$ $q,$ and $p.$\n\nSo, we have\n\n$$\n\\begin{aligned}r\\cdot (q\\times p) & =|\\begin{aligned}4 & 1 & -2 \\\\ 1 & -2 & 1 \\\\ 3 & 1 & 2\\end{aligned}| \\\\  & =4\\cdot |\\begin{aligned}-2 & 1 \\\\ 1 & 2\\end{aligned}|-1\\cdot |\\begin{aligned}1 & 1 \\\\ 3 & 2\\end{aligned}|+(-2)\\cdot |\\begin{aligned}1 & -2 \\\\ 3 & 1\\end{aligned}| \\\\  & =4((-2)\\cdot 2-1\\cdot 1)-(1\\cdot 2-1\\cdot 3)-2(1\\cdot 1-(-2)\\cdot 3) \\\\  & =-20+1-14 \\\\  & =-33.\\end{aligned}\n$$"} :step/id #uuid "2145564f-b143-5694-829e-a9e30f5dc092" :step/next {:db/id #edb/ref 17592186419790}} {:db/id #edb/ref 17592186419789 :step/content {:db/id #edb/ref 17592186419786 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "069decae-ea7d-53a6-9d7f-6cd1604d5e45" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186419779}] :answer-field/correct {:db/id #edb/ref 17592186419779} :answer-field/id #uuid "0082553f-6022-5a48-bc6b-791b1c483f07" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186419782}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "944d3b7e-a470-59f8-92c4-a8abf2a8b72b" :question/math-academy-id "q-317329" :question/problem "Find $b\\cdot (c\\times a)$, if $-5a\\cdot ((6b)\\times (4c))=120.$\n\n$b\\cdot (c\\times a)=$\n{{field-1}}" :question/worked-solution "First, we factor out the constants and get\n\n$$\n\\begin{aligned}-5a\\cdot ((6b)\\times (4c)) & =120 \\\\ (-5)\\cdot 6\\cdot 4\\cdot [a\\cdot (b\\times c)] & =120 \\\\ (-120)[a\\cdot (b\\times c)] & =120 \\\\ a\\cdot (b\\times c) & =-1.\\end{aligned}\n$$\n\nThen, we swap $a$ and $b$ to get\n\n$$\n\\begin{aligned}b\\cdot (a\\times c) & =1,\\end{aligned}\n$$\n\nand again we swap $a$ and $c$ to get\n\n$$\n\\begin{aligned}b\\cdot (c\\times a) & =-1.\\end{aligned}\n$$"} :step/id #uuid "69f520c8-2f68-5cc8-8bb4-1d0fcdb03028"} {:db/id #edb/ref 17592186419790 :step/content {:db/id #edb/ref 17592186419785 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aadbe221-860c-5e54-a0de-bd7fb0bef36e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16" :db/id #edb/ref 17592186419781}] :answer-field/correct {:db/id #edb/ref 17592186419781} :answer-field/id #uuid "cea71914-4f17-5f64-8016-140e481b698d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186419784}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "20209d26-6af3-5176-8409-17df2aefc0b9" :question/math-academy-id "q-317313" :question/problem "Let $a=⟨1,-3,0⟩$, $b=⟨-2,2,0⟩$ and $c=⟨2,0,-4⟩.$ Find $a\\cdot (b\\times c)$ using a determinant.\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" :question/worked-solution "Remember that the scalar triple product $a\\cdot (b\\times c)$ is just the determinant of the matrix whose rows are given by $a,$ $b,$ and $c.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}1 & -3 & 0 \\\\ -2 & 2 & 0 \\\\ 2 & 0 & -4\\end{aligned}| \\\\  & =1\\cdot |\\begin{aligned}2 & 0 \\\\ 0 & -4\\end{aligned}|\\,-\\,(-3)\\cdot |\\begin{aligned}-2 & 0 \\\\ 2 & -4\\end{aligned}|\\,+\\,0\\cdot |\\begin{aligned}-2 & 2 \\\\ 2 & 0\\end{aligned}| \\\\  & =1\\,(2\\cdot (-4)-0\\cdot 0)\\,-\\,(-3)\\,((-2)\\cdot (-4)-0\\cdot 2)\\,+\\,0\\,((-2)\\cdot 0-2\\cdot 2) \\\\  & =1\\,(-8)\\,-\\,(-3)\\,(8)\\,+\\,0\\,(-4) \\\\  & =-8+24+0 \\\\  & =16.\\end{aligned}\n$$"} :step/id #uuid "7ce27cb2-7851-562f-a805-9613dfe990e5" :step/next {:db/id #edb/ref 17592186419791}} {:db/id #edb/ref 17592186419791 :step/content {:db/id #edb/ref 17592186419787 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f56b9f8-00ca-5814-abb9-6c5a7caba35e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-31" :db/id #edb/ref 17592186419780}] :answer-field/correct {:db/id #edb/ref 17592186419780} :answer-field/id #uuid "7dd14090-bb12-5afc-8250-d9460b7c0f27" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186419783}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f15d30b5-fe4a-5207-9935-fd7503715554" :question/math-academy-id "q-317326" :question/problem "Let $a=⟨-2,0,-1⟩$, $b=⟨-3,-1,4⟩$ and $c=⟨5,-2,-2⟩.$ Find $a\\cdot (b\\times c)$ using a determinant.\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" :question/worked-solution "Remember that the scalar triple product $a\\cdot (b\\times c)$ is just the determinant of the matrix whose rows are given by $a,$ $b,$ and $c.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}-2 & 0 & -1 \\\\ -3 & -1 & 4 \\\\ 5 & -2 & -2\\end{aligned}| \\\\  & =(-2)\\cdot |\\begin{aligned}-1 & 4 \\\\ -2 & -2\\end{aligned}|\\,-\\,0\\cdot |\\begin{aligned}-3 & 4 \\\\ 5 & -2\\end{aligned}|\\,+\\,(-1)\\cdot |\\begin{aligned}-3 & -1 \\\\ 5 & -2\\end{aligned}| \\\\  & =(-2)\\,((-1)(-2)-4\\cdot (-2))\\,-\\,0\\,((-3)\\cdot (-2)-4\\cdot 5)\\,+\\,(-1)\\,((-3)\\cdot (-2)-(-1)\\cdot 5) \\\\  & =(-2)\\,(10)\\,-\\,0\\,(-14)\\,+\\,(-1)\\,(11) \\\\  & =-20+0-11 \\\\  & =-31.\\end{aligned}\n$$"} :step/id #uuid "85680ae8-e720-54c1-a502-614781ce6410" :step/next {:db/id #edb/ref 17592186419789}} {:db/id #edb/ref 17592186419792 :step/content {:db/id #edb/ref 17592186287975 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "343abe13-b014-58c0-913d-2fc9f7a11d8e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186285270} {:answer/id #uuid "4c3b1e45-a9c8-5b28-b558-ec4bc793eb4e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186285496} {:answer/id #uuid "a878dcad-4ddf-585b-a29e-6f1bfa1aa273" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186286324} {:answer/id #uuid "c9e6bcc3-f1d7-59c6-953b-c03961aeaf47" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186286630} {:answer/id #uuid "fbedc400-7438-5567-8dfa-d1cfcb39be79" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186287087}] :answer-field/correct {:db/id #edb/ref 17592186287087} :answer-field/id #uuid "42a770db-2d9f-5df9-858e-0db4cb77fe94" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186287293}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ae812812-92a4-5aa7-85f9-50adcd0043cf" :question/math-academy-id "q-20059" :question/problem "Find $c\\cdot (a\\times b)$, if $3a\\cdot (\\sqrt{2}b\\times 3c)=18\\sqrt{2}.$" :question/worked-solution "First, we factor out the constants and get\n\n$$\n\\begin{aligned}3a\\cdot (\\sqrt{2}b\\times 3c) & =18\\sqrt{2} \\\\ 3\\cdot \\sqrt{2}\\cdot 3\\cdot [a\\cdot (b\\times c)] & =18\\sqrt{2} \\\\ a\\cdot (b\\times c) & =2.\\end{aligned}\n$$\n\nThen, we swap $c$ and $b$ to get\n\n$$\n\\begin{aligned}a\\cdot (c\\times b) & =-2,\\end{aligned}\n$$\n\nand again we swap $c$ and $a$ to get\n\n$$\n\\begin{aligned}c\\cdot (a\\times b) & =2.\\end{aligned}\n$$"} :step/id #uuid "d94231c6-3192-5dc5-bd63-54e41758bbbe" :step/next {:db/id #edb/ref 17592186419788}}] :activity/title "The Scalar Triple Product" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186419778}]}
