[{:db/id 17592186105737 :knowledge-point/questions ["question-944d3b7e-a470-59f8-92c4-a8abf2a8b72b"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186105736 :knowledge-point/questions ["question-20209d26-6af3-5176-8409-17df2aefc0b9" "question-f15d30b5-fe4a-5207-9935-fd7503715554"] :db/ensure [:knowledge-point/validate]} {:db/id "question-20209d26-6af3-5176-8409-17df2aefc0b9" :question/id #uuid "20209d26-6af3-5176-8409-17df2aefc0b9" :question/math-academy-id "q-317313" :question/problem "Let $a=⟨1,-3,0⟩$, $b=⟨-2,2,0⟩$ and $c=⟨2,0,-4⟩.$ Find $a\\cdot (b\\times c)$ using a determinant.\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" :question/worked-solution "Remember that the scalar triple product $a\\cdot (b\\times c)$ is just the determinant of the matrix whose rows are given by $a,$ $b,$ and $c.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}1 & -3 & 0 \\\\ -2 & 2 & 0 \\\\ 2 & 0 & -4\\end{aligned}| \\\\  & =1\\cdot |\\begin{aligned}2 & 0 \\\\ 0 & -4\\end{aligned}|\\,-\\,(-3)\\cdot |\\begin{aligned}-2 & 0 \\\\ 2 & -4\\end{aligned}|\\,+\\,0\\cdot |\\begin{aligned}-2 & 2 \\\\ 2 & 0\\end{aligned}| \\\\  & =1\\,(2\\cdot (-4)-0\\cdot 0)\\,-\\,(-3)\\,((-2)\\cdot (-4)-0\\cdot 2)\\,+\\,0\\,((-2)\\cdot 0-2\\cdot 2) \\\\  & =1\\,(-8)\\,-\\,(-3)\\,(8)\\,+\\,0\\,(-4) \\\\  & =-8+24+0 \\\\  & =16.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-cea71914-4f17-5f64-8016-140e481b698d"] :db/ensure [:question/validate]} {:db/id "answer-field-cea71914-4f17-5f64-8016-140e481b698d" :answer-field/id #uuid "cea71914-4f17-5f64-8016-140e481b698d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-aadbe221-860c-5e54-a0de-bd7fb0bef36e" :answer-field/choices ["answer-aadbe221-860c-5e54-a0de-bd7fb0bef36e"] :db/ensure [:answer-field/validate]} {:db/id "answer-aadbe221-860c-5e54-a0de-bd7fb0bef36e" :answer/id #uuid "aadbe221-860c-5e54-a0de-bd7fb0bef36e" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "question-f15d30b5-fe4a-5207-9935-fd7503715554" :question/id #uuid "f15d30b5-fe4a-5207-9935-fd7503715554" :question/math-academy-id "q-317326" :question/problem "Let $a=⟨-2,0,-1⟩$, $b=⟨-3,-1,4⟩$ and $c=⟨5,-2,-2⟩.$ Find $a\\cdot (b\\times c)$ using a determinant.\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" :question/worked-solution "Remember that the scalar triple product $a\\cdot (b\\times c)$ is just the determinant of the matrix whose rows are given by $a,$ $b,$ and $c.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}-2 & 0 & -1 \\\\ -3 & -1 & 4 \\\\ 5 & -2 & -2\\end{aligned}| \\\\  & =(-2)\\cdot |\\begin{aligned}-1 & 4 \\\\ -2 & -2\\end{aligned}|\\,-\\,0\\cdot |\\begin{aligned}-3 & 4 \\\\ 5 & -2\\end{aligned}|\\,+\\,(-1)\\cdot |\\begin{aligned}-3 & -1 \\\\ 5 & -2\\end{aligned}| \\\\  & =(-2)\\,((-1)(-2)-4\\cdot (-2))\\,-\\,0\\,((-3)\\cdot (-2)-4\\cdot 5)\\,+\\,(-1)\\,((-3)\\cdot (-2)-(-1)\\cdot 5) \\\\  & =(-2)\\,(10)\\,-\\,0\\,(-14)\\,+\\,(-1)\\,(11) \\\\  & =-20+0-11 \\\\  & =-31.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-7dd14090-bb12-5afc-8250-d9460b7c0f27"] :db/ensure [:question/validate]} {:db/id "answer-field-7dd14090-bb12-5afc-8250-d9460b7c0f27" :answer-field/id #uuid "7dd14090-bb12-5afc-8250-d9460b7c0f27" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-3f56b9f8-00ca-5814-abb9-6c5a7caba35e" :answer-field/choices ["answer-3f56b9f8-00ca-5814-abb9-6c5a7caba35e"] :db/ensure [:answer-field/validate]} {:db/id "answer-3f56b9f8-00ca-5814-abb9-6c5a7caba35e" :answer/id #uuid "3f56b9f8-00ca-5814-abb9-6c5a7caba35e" :answer/type :answer.type/math :answer/value "-31" :db/ensure [:answer/validate]} {:db/id "question-944d3b7e-a470-59f8-92c4-a8abf2a8b72b" :question/id #uuid "944d3b7e-a470-59f8-92c4-a8abf2a8b72b" :question/math-academy-id "q-317329" :question/problem "Find $b\\cdot (c\\times a)$, if $-5a\\cdot ((6b)\\times (4c))=120.$\n\n$b\\cdot (c\\times a)=$\n{{field-1}}" :question/worked-solution "First, we factor out the constants and get\n\n$$\n\\begin{aligned}-5a\\cdot ((6b)\\times (4c)) & =120 \\\\ (-5)\\cdot 6\\cdot 4\\cdot [a\\cdot (b\\times c)] & =120 \\\\ (-120)[a\\cdot (b\\times c)] & =120 \\\\ a\\cdot (b\\times c) & =-1.\\end{aligned}\n$$\n\nThen, we swap $a$ and $b$ to get\n\n$$\n\\begin{aligned}b\\cdot (a\\times c) & =1,\\end{aligned}\n$$\n\nand again we swap $a$ and $c$ to get\n\n$$\n\\begin{aligned}b\\cdot (c\\times a) & =-1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-0082553f-6022-5a48-bc6b-791b1c483f07"] :db/ensure [:question/validate]} {:db/id "answer-field-0082553f-6022-5a48-bc6b-791b1c483f07" :answer-field/id #uuid "0082553f-6022-5a48-bc6b-791b1c483f07" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-069decae-ea7d-53a6-9d7f-6cd1604d5e45" :answer-field/choices ["answer-069decae-ea7d-53a6-9d7f-6cd1604d5e45"] :db/ensure [:answer-field/validate]} {:db/id "answer-069decae-ea7d-53a6-9d7f-6cd1604d5e45" :answer/id #uuid "069decae-ea7d-53a6-9d7f-6cd1604d5e45" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "activity-e3670cc4-3e0e-52dd-b203-84b0f2da8c90" :activity/id #uuid "e3670cc4-3e0e-52dd-b203-84b0f2da8c90" :activity/title "The Scalar Triple Product" :activity/type :activity.type/review :activity/scope 17592186050356 :activity/course 17592186046658 :activity/steps ["step-d94231c6-3192-5dc5-bd63-54e41758bbbe" "step-2145564f-b143-5694-829e-a9e30f5dc092" "step-7ce27cb2-7851-562f-a805-9613dfe990e5" "step-85680ae8-e720-54c1-a502-614781ce6410" "step-69f520c8-2f68-5cc8-8bb4-1d0fcdb03028"] :activity/first-step "step-d94231c6-3192-5dc5-bd63-54e41758bbbe" :db/ensure [:activity/validate]} {:db/id "step-d94231c6-3192-5dc5-bd63-54e41758bb