36e" 13194139534344 17592186045417 true] [17592186419782 1075 #edb/ref 17592186419779 13194139534344 17592186045417 true] [17592186419782 1076 #edb/ref 17592186045492 13194139534344 17592186045417 true] [17592186419782 1077 "field-1" 13194139534344 17592186045417 true] [17592186419782 1078 #edb/ref 17592186419779 13194139534344 17592186045417 true] [17592186419782 1079 #uuid "0082553f-6022-5a48-bc6b-791b1c483f07" 13194139534344 17592186045417 true] [17592186419783 1075 #edb/ref 17592186419780 13194139534344 17592186045417 true] [17592186419783 1076 #edb/ref 17592186045492 13194139534344 17592186045417 true] [17592186419783 1077 "field-1" 13194139534344 17592186045417 true] [17592186419783 1078 #edb/ref 17592186419780 13194139534344 17592186045417 true] [17592186419783 1079 #uuid "7dd14090-bb12-5afc-8250-d9460b7c0f27" 13194139534344 17592186045417 true] [17592186419784 1075 #edb/ref 17592186419781 13194139534344 17592186045417 true] [17592186419784 1076 #edb/ref 17592186045492 13194139534344 17592186045417 true] [17592186419784 1077 "field-1" 13194139534344 17592186045417 true] [17592186419784 1078 #edb/ref 17592186419781 13194139534344 17592186045417 true] [17592186419784 1079 #uuid "cea71914-4f17-5f64-8016-140e481b698d" 13194139534344 17592186045417 true] [17592186419785 1068 #edb/ref 17592186419784 13194139534344 17592186045417 true] [17592186419785 1069 "q-317313" 13194139534344 17592186045417 true] [17592186419785 1070 #edb/ref 17592186045487 13194139534344 17592186045417 true] [17592186419785 1071 "Let $a=⟨1,-3,0⟩$, $b=⟨-2,2,0⟩$ and $c=⟨2,0,-4⟩.$ Find $a\\cdot (b\\times c)$ using a determinant.\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" 13194139534344 17592186045417 true] [17592186419785 1072 #uuid "20209d26-6af3-5176-8409-17df2aefc0b9" 13194139534344 17592186045417 true] [17592186419785 1074 "Remember that the scalar triple product $a\\cdot (b\\times c)$ is just the determinant of the matrix whose rows are given by $a,$ $b,$ and $c.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}1 & -3 & 0 \\\\ -2 & 2 & 0 \\\\ 2 & 0 & -4\\end{aligned}| \\\\  & =1\\cdot |\\begin{aligned}2 & 0 \\\\ 0 & -4\\end{aligned}|\\,-\\,(-3)\\cdot |\\begin{aligned}-2 & 0 \\\\ 2 & -4\\end{aligned}|\\,+\\,0\\cdot |\\begin{aligned}-2 & 2 \\\\ 2 & 0\\end{aligned}| \\\\  & =1\\,(2\\cdot (-4)-0\\cdot 0)\\,-\\,(-3)\\,((-2)\\cdot (-4)-0\\cdot 2)\\,+\\,0\\,((-2)\\cdot 0-2\\cdot 2) \\\\  & =1\\,(-8)\\,-\\,(-3)\\,(8)\\,+\\,0\\,(-4) \\\\  & =-8+24+0 \\\\  & =16.\\end{aligned}\n$$" 13194139534344 17592186045417 true] [17592186419786 1068 #edb/ref 17592186419782 13194139534344 17592186045417 true] [17592186419786 1069 "q-317329" 13194139534344 17592186045417 true] [17592186419786 1070 #edb/ref 17592186045487 13194139534344 17592186045417 true] [17592186419786 1071 "Find $b\\cdot (c\\times a)$, if $-5a\\cdot ((6b)\\times (4c))=120.$\n\n$b\\cdot (c\\times a)=$\n{{field-1}}" 13194139534344 17592186045417 true] [17592186419786 1072 #uuid "944d3b7e-a470-59f8-92c4-a8abf2a8b72b" 13194139534344 17592186045417 true] [17592186419786 1074 "First, we factor out the constants and get\n\n$$\n\\begin{aligned}-5a\\cdot ((6b)\\times (4c)) & =120 \\\\ (-5)\\cdot 6\\cdot 4\\cdot [a\\cdot (b\\times c)] & =120 \\\\ (-120)[a\\cdot (b\\times c)] & =120 \\\\ a\\cdot (b\\times c) & =-1.\\end{aligned}\n$$\n\nThen, we swap $a$ and $b$ to get\n\n$$\n\\begin{aligned}b\\cdot (a\\times c) & =1,\\end{aligned}\n$$\n\nand again we swap $a$ and $c$ to get\n\n$$\n\\begin{aligned}b\\cdot (c\\times a) & =-1.\\end{aligned}\n$$" 13194139534344 17592186045417 true] [17592186419787 1068 #edb/ref 17592186419783 13194139534344 17592186045417 true] [17592186419787 1069 "q-317326" 13194139534344 17592186045417 true] [17592186419787 1070 #edb/ref 17592186045487 13194139534344 17592186045417 true] [17592186419787 1071 "Let $a=⟨-2,0,-1⟩$, $b=⟨-3,-1,4⟩$ and $c=⟨5,-2,-2⟩.$ Find $a\\cdot (b\\times c)$ using a determinant.\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" 13194139534344 17592186045417 true] [17592186419787 1072 #uuid "f15d30b5-fe4a-5207-9935-fd7503715554" 13194139534344 17592186045417 true] [17592186419787 1074 "Remember that the scalar triple product $a\\cdot (b\\times c)$ is just the determinant of the matrix whose rows are given by $a,$ $b,$ and $c.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}-2 & 0 & -1 \\\\ -3 & -1 & 4 \\\\ 5 & -2 & -2\\end{aligned}| \\\\  & =(-2)\\cdot |\\begin{aligned}-1 & 4 \\\\ -2 & -2\\end{aligned}|\\,-\\,0\\cdot |\\begin{aligned}-3 & 4 \\\\ 5 & -2\\end{aligned}|\\,+\\,(-1)\\cdot |\\begin{aligned}-3 & -1 \\\\ 5 & -2\\end{aligned}| \\\\  & =(-2)\\,((-1)(-2)-4\\cdot (-2))\\,-\\,0\\,((-3)\\cdot (-2)-4\\cdot 5)\\,+\\,(-1)\\,((-3)\\cdot (-2)-(-1)\\cdot 5) \\\\  & =(-2)\\,(10)\\,-\\,0\\,(-14)\\,+\\,(-1)\\,(11) \\\\  & =-20+0-11 \\\\  & =-31.\\end{aligned}\n$$" 13194139534344 17592186045417 true] [17592186419788 1058 #edb/ref 17592186419790 13194139534344 17592186045417 true] [17592186419788 1062 #uuid "2145564f-b143-5694-829e-a9e30f5dc092" 13194139534344 17592186045417 true] [17592186419788 1063 #edb/ref 17592186341980 13194139534344 17592186045417 true] [17592186419789 1062 #uuid "69f520c8-2f68-5cc8-8bb4-1d0fcdb03028" 13194139534344 17592186045417 true] [17592186419789 1063 #edb/ref 17592186419786 13194139534344 17592186045417 true] [17592186419790 1058 #edb/ref 17592186419791 13194139534344 17592186045417 true] [17592186419790 1062 #uuid "7ce27cb2-7851-562f-a805-9613dfe990e5" 13194139534344 17592186045417 true] [17592186419790 1063 #edb/ref 17592186419785 13194139534344 17592186045417 true] [17592186419791 1058 #edb/ref 17592186419789 13194139534344 17592186045417 true] [17592186419791 1062 #uuid "85680ae8-e720-54c1-a502-614781ce6410" 13194139534344 17592186045417 true] [17592186419791 1063 #edb/ref 17592186419787 13194139534344 17592186045417 true] [17592186419792 1058 #edb/ref 17592186419788 13194139534344 17592186045417 true] [17592186419792 1062 #uuid "d94231c6-3192-5dc5-bd63-