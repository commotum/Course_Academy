#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186516976} :activity/id #uuid "95da094c-cb37-530d-9171-267dcdd5dd88" :activity/scope {:db/id #edb/ref 17592186048527 :topic/id #uuid "a715d0ff-c3bf-59f0-8f15-f8770c11ebac" :topic/math-academy-id 1892} :activity/steps [{:db/id #edb/ref 17592186516876 :step/content {:db/id #edb/ref 17592186408095 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e08b4887-48da-5258-b769-f2c5686179db" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The entire $xy$-plane" :db/id #edb/ref 17592186408090} {:answer/id #uuid "172e525a-825d-5e3f-b466-60fd613e7f14" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{(x,y)\\,:\\,\\frac{(x-2)^{2}}{4}+(y-1)^{2}\\le 1\\}" :db/id #edb/ref 17592186516158} {:answer/id #uuid "17558800-ef18-55b3-ad7e-9cffc30e4b03" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{(x,y)\\,:\\,\\frac{(x-2)^{2}}{4}+(y-1)^{2}\\ge 1\\}" :db/id #edb/ref 17592186516159} {:answer/id #uuid "530f0720-d51a-5a62-b99e-18a15d0fb434" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{(x,y)\\,:\\,\\frac{{x}^{2}}{2}+(y-1)^{2}\\le 1\\}" :db/id #edb/ref 17592186516286} {:answer/id #uuid "82e3a295-901e-5dba-be99-3c91dbacf4cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{(x,y)\\,:\\,\\frac{(x-2)^{2}}{4}+{y}^{2}\\ge 1\\}" :db/id #edb/ref 17592186516389}] :answer-field/correct {:db/id #edb/ref 17592186516159} :answer-field/id #uuid "e4502bac-b95a-55f0-b8aa-e4531b3d53f1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186408094}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1fec2431-d065-5bba-8c18-02d476e1dc33" :question/math-academy-id "q-74014" :question/problem "Given the hyperboloid of one sheet $\\frac{(x-2)^{2}}{4}+(y-1)^{2}-\\frac{{z}^{2}}{16}=1$, find the domain of $z=z(x,y).$" :question/worked-solution "From the hyperboloid equation, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}\\frac{(x-2)^{2}}{4}+(y-1)^{2}-\\frac{{z}^{2}}{16} & =1 \\\\ \\frac{(x-2)^{2}}{4}+(y-1)^{2}-1 & =\\frac{{z}^{2}}{16}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}{z}^{2} & =16(\\frac{(x-2)^{2}}{4}+(y-1)^{2}-1) \\\\ z & =\\pm 4\\sqrt{\\frac{(x-2)^{2}}{4}+(y-1)^{2}-1}\\end{aligned}\n$$\n\nSince the square root is defined only for non-negative arguments, we have:\n\n$$\n\\begin{aligned}\\frac{(x-2)^{2}}{4}+(y-1)^{2}-1 & \\ge 0 \\\\ \\frac{(x-2)^{2}}{4}+(y-1)^{2} & \\ge 1\\end{aligned}\n$$\n\nwhich gives the exterior of the ellipse $\\frac{(x-2)^{2}}{4}+(y-1)^{2}=1,$ which includes the boundary.\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\,:\\,\\frac{(x-2)^{2}}{4}+(y-1)^{2}\\ge 1\\}.\n$$"} :step/id #uuid "045330c4-8b5b-55b5-b71b-fe9403aa1a72"} {:db/id #edb/ref 17592186516908 :step/content {:db/id #edb/ref 17592186339004 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27163c60-302f-5873-ad00-05f9fc6cf2b2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{(x,y)\\,:\\,\\frac{{x}^{2}}{4}-\\frac{(y-2)^{2}}{8}>0\\}" :db/id #edb/ref 17592186516192} {:answer/id #uuid "2e168002-1ed1-57b4-8e6b-f6204db8e27b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{(x,y)\\,:\\,\\frac{{x}^{2}}{4}-\\frac{(y-2)^{2}}{8}<0\\}" :db/id #edb/ref 17592186516208} {:answer/id #uuid "844c12cc-6c29-5811-8962-30dc8d6a532a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{(x,y)\\,:\\,\\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8}\\ge 1\\}" :db/id #edb/ref 17592186516393} {:answer/id #uuid "bea4c84f-b068-5e60-82b9-448a2bf9137c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{(x,y)\\,:\\,\\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8}<1\\}" :db/id #edb/ref 17592186516516} {:answer/id #uuid "f56fd478-739e-5168-a707-21a2be18cb60" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{(x,y)\\,:\\,\\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8}\\le 1\\}" :db/id #edb/ref 17592186516621}] :answer-field/correct {:db/id #edb/ref 17592186516393} :answer-field/id #uuid "24b11784-26f9-538f-8ba3-52d50b1c6d87" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186338348}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7a7a1c0f-0f8c-51ee-845c-3e87e142c085" :question/math-academy-id "q-71859" :question/problem "Given the hyperboloid of one sheet  $\\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8}-\\frac{(z-1)^{2}}{5}=1$, find the domain of $z=z(x,y).$" :question/worked-solution "From the hyperboloid equation, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8}-\\frac{(z-1)^{2}}{5} & =1 \\\\ \\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8}-1 & =\\frac{(z-1)^{2}}{5} \\\\ (z-1)^{2} & =5(\\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8}-1) \\\\ (z-1) & =\\pm \\sqrt{5(\\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8}-1)}\\end{aligned}\n$$\n\n  \n\nSince the square root is defined only for non-negative arguments, we have:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8}-1 & \\ge 0 \\\\ \\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8} & \\ge 1\\end{aligned}\n$$\n\nwhich gives the exterior of the ellipse $\\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8}=1$, including its boundary.\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\,:\\,\\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8}\\ge 1\\}.\n$$"} :step/id #uuid "5a386b7d-1c57-5048-9724-e307c6b38500" :step/next {:db/id #edb/ref 17592186516954}} {:db/id #edb/ref 17592186516954 :step/content {:db/id #edb/ref 17592186516790 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cdbf0ca-75db-5f90-8955-64242b699cd1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$2$ and $4$" :db/id #edb/ref 17592186516139} {:answer/id #uuid "2d6b1552-a10c-5a67-a222-9a99ec23f185" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$2$ and $5$" :db/id #edb/ref 17592186516205} {:answer/id #uuid "9b2cfb5a-966e-5a34-9f6a-912523db2991" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$1$ and $2$" :db/id #edb/ref 17592186516430} {:answer/id #uuid "b228c86f-d810-5b29-9d46-f26a62956d15" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$1$ and $\\sqrt{2}$" :db/id #edb/ref 17592186516481} {:answer/id #uuid "ce7489bd-6451-5b1e-97b4-a9223f471ec3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$1$ and $2\\sqrt{2}$" :db/id #edb/ref 17592186516549}] :answer-field/correct {:db/id #edb/ref 17592186516430} :answer-field/id #uuid "0955de35-ea37-5ad6-adbf-c21830b3db59" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186516653}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "30e8d5c3-bff2-59db-90d6-3878e212499e" :question/math-academy-id "q-71962" :question/problem "The projection of the intersection between the hyperboloid of two sheets $\\frac{5(x-1)^{2}}{4}-\\frac{5(y-2)^{2}}{16}+\\frac{(z-3)^{2}}{4}=-1$ and the plane $z=2$ onto the $xy$-plane is a hyperbola. What are the lengths of the semi-axes of the hyperbola?" :question/worked-solution "To find the intersection of the hyperboloid and the plane $z=2$, we substitute $z=2$ into the equation of the hyperboloid:\n\n$$\n\\begin{aligned}\\frac{5(x-1)^{2}}{4}-\\frac{5(y-2)^{2}}{16}+\\frac{(2-3)^{2}}{4} & =-1 \\\\ \\frac{5(x-1)^{2}}{4}-\\frac{5(y-2)^{2}}{16}+\\frac{1}{4} & =-1 \\\\ \\frac{5(x-1)^{2}}{4}-\\frac{5(y-2)^{2}}{16} & =-1-\\frac{1}{4} \\\\ \\frac{5(x-1)^{2}}{4}-\\frac{5(y-2)^{2}}{16} & =-\\frac{5}{4} \\\\ -(x-1)^{2}+\\frac{(y-2)^{2}}{4} & =1 \\\\ -\\frac{(x-1)^{2}}{{1}^{2}}+\\frac{(y-2)^{2}}{{2}^{2}} & =1\\end{aligned}\n$$\n\nThis gives us the equation of a hyperbola with semi-axes of lengths $1$ and $2.$"} :step/id #uuid "b7b019dc-5193-51bb-bdb4-64a14504da05" :step/next {:db/id #edb/ref 17592186516965}} {:db/id #edb/ref 17592186516965 :step/content {:db/id #edb/ref 17592186339027 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1367a913-bd30-5d46-b192-55918d608fb8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Two parallel lines: $y=2x\\pm 2$" :db/id #edb/ref 17592186336215} {:answer/id #uuid "21b8d9e0-4b1f-50b9-9504-2d80b0e4177d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An ellipse: $\\frac{(x-2)^{2}}{4}+\\frac{{y}^{2}}{8}=1$" :db/id #edb/ref 17592186336346} {:answer/id #uuid "5a1cf904-9470-5d6d-bd73-91765fe6eab5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Two intersecting lines: $y=\\pm 2(x-2)$" :db/id #edb/ref 17592186336852} {:answer/id #uuid "9ef4b176-d408-5e50-bc9d-8a80f42c2948" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperbola: $\\frac{(x-2)^{2}}{4}-\\frac{{y}^{2}}{8}=-1$" :db/id #edb/ref 17592186337468} {:answer/id #uuid "ddad069b-ab04-5be6-931f-973051696d79" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperbola: $\\frac{(x-2)^{2}}{4}-\\frac{{y}^{2}}{8}=1$" :db/id #edb/ref 17592186337960}] :answer-field/correct {:db/id #edb/ref 17592186336852} :answer-field/id #uuid "1567f6f6-2047-5c07-9a81-179bf8b695ea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186338313}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5e51ba70-807e-5821-b5e3-3514d515c2b6" :question/math-academy-id "q-71966" :question/problem "What is the projection of the intersection between the hyperboloid of one sheet $\\frac{(x-2)^{2}}{2}-\\frac{{y}^{2}}{8}+{z}^{2}=1$ and the plane $z=1$ onto the $xy$-plane?" :question/worked-solution "To find the intersection of the hyperboloid and the plane $z=1$, we substitute $z=1$ into the equation of the hyperboloid:\n\n$$\n\\begin{aligned}\\frac{(x-2)^{2}}{2}-\\frac{{y}^{2}}{8}+{1}^{2} & =1 \\\\ \\frac{(x-2)^{2}}{2}-\\frac{{y}^{2}}{8}+1 & =1 \\\\ \\frac{(x-2)^{2}}{2}-\\frac{{y}^{2}}{8} & =0 \\\\ {y}^{2} & =4(x-2)^{2} \\\\ y & =\\pm 2(x-2)\\end{aligned}\n$$\n\nThis gives us two intersecting lines: $y=2(x-2)$ and $y=-2(x-2).$"} :step/id #uuid "c7c29bd2-52a7-58da-bab6-7c5edcb62364" :step/next {:db/id #edb/ref 17592186516876}} {:db/id #edb/ref 17592186516976 :step/content {:db/id #edb/ref 17592186391951 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b38fc56c-0b29-550e-b109-d771f89562da" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperbola: $\\frac{{y}^{2}}{4}-\\frac{{z}^{2}}{8}=-1$" :db/id #edb/ref 17592186391953} {:answer/id #uuid "8b0c9da7-de70-5aea-8bf7-5c9b4d287b28" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperbola: $-\\frac{(x-2)^{2}}{4}+\\frac{{z}^{2}}{16}=1$" :db/id #edb/ref 17592186391954} {:answer/id #uuid "003b79b6-3c82-5aed-b7a9-37fc9aef1484" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperbola: $\\frac{(x-2)^{2}}{2}-\\frac{{z}^{2}}{8}=1$" :db/id #edb/ref 17592186391955} {:answer/id #uuid "8fa71829-34e0-581f-aa98-5fcdef3852dc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Two parallel lines: $z=2x\\pm 4$" :db/id #edb/ref 17592186391956} {:answer/id #uuid "f376e4eb-51f9-5938-9cba-d55cb6cf1e60" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An ellipse: $\\frac{(x-2)^{2}}{2}+\\frac{{z}^{2}}{8}=1$" :db/id #edb/ref 17592186391957}] :answer-field/correct {:db/id #edb/ref 17592186391954} :answer-field/id #uuid "8d57934b-d5eb-5a5a-8448-b8cae29a9df0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186391952}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "fcfedd1b-1d6b-51cf-8ffc-3860006da14a" :question/math-academy-id "q-36288" :question/problem "What is the projection of the intersection between the hyperboloid of two sheets $\\frac{(x-2)^{2}}{2}+\\frac{{y}^{2}}{4}-\\frac{{z}^{2}}{8}=-1$ and the plane $y=2$ onto the $xz$-plane?" :question/worked-solution "To find the intersection of the hyperboloid and the plane $y=2$, we substitute $y=2$ into the equation of the hyperboloid:\n\n$$\n\\begin{aligned}\\frac{(x-2)^{2}}{2}+\\frac{(2)^{2}}{4}-\\frac{{z}^{2}}{8} & =-1 \\\\ \\frac{(x-2)^{2}}{2}+1-\\frac{{z}^{2}}{8} & =-1 \\\\ \\frac{(x-2)^{2}}{2}-\\frac{{z}^{2}}{8} & =-2 \\\\ -\\frac{(x-2)^{2}}{4}+\\frac{{z}^{2}}{16} & =1\\end{aligned}\n$$\n\nSo, we get the hyperbola: $-\\frac{(x-2)^{2}}{4}+\\frac{{z}^{2}}{16}=1.$"} :step/id #uuid "e804d623-c83b-5e42-aa9d-2d4da33cd8cf" :step/next {:db/id #edb/ref 17592186516908}}] :activity/title "Hyperboloids" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186516104}]}
