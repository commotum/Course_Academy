#{[{:db/id #edb/ref 17592186391951 :knowledge-point/_questions [{:db/id #edb/ref 17592186124555 :knowledge-point/id #uuid "d28eda1a-a90b-57e9-969a-eb36552e413e" :knowledge-point/title "Finding Traces of Hyperboloids"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b38fc56c-0b29-550e-b109-d771f89562da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbola: $\\frac{{y}^{2}}{4}-\\frac{{z}^{2}}{8}=-1$" :db/id #edb/ref 17592186391953} {:answer/id #uuid "8b0c9da7-de70-5aea-8bf7-5c9b4d287b28" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbola: $-\\frac{(x-2)^{2}}{4}+\\frac{{z}^{2}}{16}=1$" :db/id #edb/ref 17592186391954} {:answer/id #uuid "003b79b6-3c82-5aed-b7a9-37fc9aef1484" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbola: $\\frac{(x-2)^{2}}{2}-\\frac{{z}^{2}}{8}=1$" :db/id #edb/ref 17592186391955} {:answer/id #uuid "8fa71829-34e0-581f-aa98-5fcdef3852dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Two parallel lines: $z=2x\\pm 4$" :db/id #edb/ref 17592186391956} {:answer/id #uuid "f376e4eb-51f9-5938-9cba-d55cb6cf1e60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An ellipse: $\\frac{(x-2)^{2}}{2}+\\frac{{z}^{2}}{8}=1$" :db/id #edb/ref 17592186391957}] :answer-field/correct {:answer/id #uuid "8b0c9da7-de70-5aea-8bf7-5c9b4d287b28" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbola: $-\\frac{(x-2)^{2}}{4}+\\frac{{z}^{2}}{16}=1$" :db/id #edb/ref 17592186391954} :answer-field/id #uuid "8d57934b-d5eb-5a5a-8448-b8cae29a9df0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186391952}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fcfedd1b-1d6b-51cf-8ffc-3860006da14a" :question/math-academy-id "q-36288" :question/problem "What is the projection of the intersection between the hyperboloid of two sheets $\\frac{(x-2)^{2}}{2}+\\frac{{y}^{2}}{4}-\\frac{{z}^{2}}{8}=-1$ and the plane $y=2$ onto the $xz$-plane?" :question/worked-solution "To find the intersection of the hyperboloid and the plane $y=2$, we substitute $y=2$ into the equation of the hyperboloid:\n\n$$\n\\begin{aligned}\\frac{(x-2)^{2}}{2}+\\frac{(2)^{2}}{4}-\\frac{{z}^{2}}{8} & =-1 \\\\ \\frac{(x-2)^{2}}{2}+1-\\frac{{z}^{2}}{8} & =-1 \\\\ \\frac{(x-2)^{2}}{2}-\\frac{{z}^{2}}{8} & =-2 \\\\ -\\frac{(x-2)^{2}}{4}+\\frac{{z}^{2}}{16} & =1\\end{aligned}\n$$\n\nSo, we get the hyperbola: $-\\frac{(x-2)^{2}}{4}+\\frac{{z}^{2}}{16}=1.$"}] [{:db/id #edb/ref 17592186339004 :knowledge-point/_questions [{:db/id #edb/ref 17592186124503 :knowledge-point/id #uuid "b079a5ff-e73a-592f-b16c-8740682538f3" :knowledge-point/title "Identifying the Domain of a Hyperboloid"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "507ac2a9-3b0e-5c7b-b78e-371cccee0df9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,\\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8}<1}" :db/id #edb/ref 17592186336769} {:answer/id #uuid "7fe929d8-027d-58ce-8906-283ad4c4d0cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,\\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8}\\le 1}" :db/id #edb/ref 17592186337192} {:answer/id #uuid "81a6b839-0f42-5458-9519-196a25be7bf6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,\\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8}\\ge 1}" :db/id #edb/ref 17592186337210} {:answer/id #uuid "8c3ec9f0-7d15-540a-82aa-5bcb9f9fc350" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,\\frac{{x}^{2}}{4}-\\frac{(y-2)^{2}}{8}>0}" :db/id #edb/ref 17592186337303} {:answer/id #uuid "d37ab812-9c7e-5778-85ba-d6913220f638" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,\\frac{{x}^{2}}{4}-\\frac{(y-2)^{2}}{8}<0}" :db/id #edb/ref 17592186337881}] :answer-field/correct {:answer/id #uuid "81a6b839-0f42-5458-9519-196a25be7bf6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,\\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8}\\ge 1}" :db/id #edb/ref 17592186337210} :answer-field/id #uuid "24b11784-26f9-538f-8ba3-52d50b1c6d87" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338348}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7a7a1c0f-0f8c-51ee-845c-3e87e142c085" :question/math-academy-id "q-71859" :question/problem "Given the hyperboloid of one sheet  $\\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8}-\\frac{(z-1)^{2}}{5}=1$, find the domain of $z=z(x,y).$" :question/worked-solution "From the hyperboloid equation, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8}-\\frac{(z-1)^{2}}{5} & =1 \\\\ \\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8}-1 & =\\frac{(z-1)^{2}}{5} \\\\ (z-1)^{2} & =5(\\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8}-1) \\\\ (z-1) & =\\pm \\sqrt{5(\\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8}-1)}\\end{aligned}\n$$\n\n  \n\nSince the square root is defined only for non-negative arguments, we have:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8}-1 & \\ge 0 \\\\ \\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8} & \\ge 1\\end{aligned}\n$$\n\nwhich gives the exterior of the ellipse $\\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8}=1$, including its boundary.\n\nTherefore, the domain is\n\n$$\n{(x,y)\\,:\\,\\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8}\\ge 1}.\n$$"}] [{:db/id #edb/ref 17592186339027 :knowledge-point/_questions [{:db/id #edb/ref 17592186124555 :knowledge-point/id #uuid "d28eda1a-a90b-57e9-969a-eb36552e413e" :knowledge-point/title "Finding Traces of Hyperboloids"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1367a913-bd30-5d46-b192-55918d608fb8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Two parallel lines: $y=2x\\pm 2$" :db/id #edb/ref 17592186336215} {:answer/id #uuid "21b8d9e0-4b1f-50b9-9504-2d80b0e4177d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An ellipse: $\\frac{(x-2)^{2}}{4}+\\frac{{y}^{2}}{8}=1$" :db/id #edb/ref 17592186336346} {:answer/id #uuid "5a1cf904-9470-5d6d-bd73-91765fe6eab5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Two intersecting lines: $y=\\pm 2(x-2)$" :db/id #edb/ref 17592186336852} {:answer/id #uuid "9ef4b176-d408-5e50-bc9d-8a80f42c2948" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbola: $\\frac{(x-2)^{2}}{4}-\\frac{{y}^{2}}{8}=-1$" :db/id #edb/ref 17592186337468} {:answer/id #uuid "ddad069b-ab04-5be6-931f-973051696d79" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbola: $\\frac{(x-2)^{2}}{4}-\\frac{{y}^{2}}{8}=1$" :db/id #edb/ref 17592186337960}] :answer-field/correct {:answer/id #uuid "5a1cf904-9470-5d6d-bd73-91765fe6eab5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Two intersecting lines: $y=\\pm 2(x-2)$" :db/id #edb/ref 17592186336852} :answer-field/id #uuid "1567f6f6-2047-5c07-9a81-179bf8b695ea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338313}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5e51ba70-807e-5821-b5e3-3514d515c2b6" :question/math-academy-id "q-71966" :question/problem "What is the projection of the intersection between the hyperboloid of one sheet $\\frac{(x-2)^{2}}{2}-\\frac{{y}^{2}}{8}+{z}^{2}=1$ and the plane $z=1$ onto the $xy$-plane?" :question/worked-solution "To find the intersection of the hyperboloid and the plane $z=1$, we substitute $z=1$ into the equation of the hyperboloid:\n\n$$\n\\begin{aligned}\\frac{(x-2)^{2}}{2}-\\frac{{y}^{2}}{8}+{1}^{2} & =1 \\\\ \\frac{(x-2)^{2}}{2}-\\frac{{y}^{2}}{8}+1 & =1 \\\\ \\frac{(x-2)^{2}}{2}-\\frac{{y}^{2}}{8} & =0 \\\\ {y}^{2} & =4(x-2)^{2} \\\\ y & =\\pm 2(x-2)\\end{aligned}\n$$\n\nThis gives us two intersecting lines: $y=2(x-2)$ and $y=-2(x-2).$"}] [{:db/id #edb/ref 17592186408095 :knowledge-point/_questions [{:db/id #edb/ref 17592186124503 :knowledge-point/id #uuid "b079a5ff-e73a-592f-b16c-8740682538f3" :knowledge-point/title "Identifying the Domain of a Hyperboloid"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "647d79bc-f910-5f37-9518-15b28a26a365" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,\\frac{{x}^{2}}{2}+(y-1)^{2}\\le 1}" :db/id #edb/ref 17592186408085} {:answer/id #uuid "6664498a-b8f5-59ab-b882-7ea3cc1260a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,\\frac{(x-2)^{2}}{4}+{y}^{2}\\ge 1}" :db/id #edb/ref 17592186408086} {:answer/id #uuid "c970f5ab-4e4d-5836-a7ea-bb38ca163641" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,\\frac{(x-2)^{2}}{4}+(y-1)^{2}\\le 1}" :db/id #edb/ref 17592186408088} {:answer/id #uuid "e08b4887-48da-5258-b769-f2c5686179db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The entire $xy$-plane" :db/id #edb/ref 17592186408090} {:answer/id #uuid "ed3fc56b-37c5-55d4-9d7e-18c3f48790c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,\\frac{(x-2)^{2}}{4}+(y-1)^{2}\\ge 1}" :db/id #edb/ref 17592186408091}] :answer-field/correct {:answer/id #uuid "ed3fc56b-37c5-55d4-9d7e-18c3f48790c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,\\frac{(x-2)^{2}}{4}+(y-1)^{2}\\ge 1}" :db/id #edb/ref 17592186408091} :answer-field/id #uuid "e4502bac-b95a-55f0-b8aa-e4531b3d53f1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186408094}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1fec2431-d065-5bba-8c18-02d476e1dc33" :question/math-academy-id "q-74014" :question/problem "Given the hyperboloid of one sheet $\\frac{(x-2)^{2}}{4}+(y-1)^{2}-\\frac{{z}^{2}}{16}=1$, find the domain of $z=z(x,y).$" :question/worked-solution "From the hyperboloid equation, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}\\frac{(x-2)^{2}}{4}+(y-1)^{2}-\\frac{{z}^{2}}{16} & =1 \\\\ \\frac{(x-2)^{2}}{4}+(y-1)^{2}-1 & =\\frac{{z}^{2}}{16}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}{z}^{2} & =16(\\frac{(x-2)^{2}}{4}+(y-1)^{2}-1) \\\\ z & =\\pm 4\\sqrt{\\frac{(x-2)^{2}}{4}+(y-1)^{2}-1}\\end{aligned}\n$$\n\nSince the square root is defined only for non-negative arguments, we have:\n\n$$\n\\begin{aligned}\\frac{(x-2)^{2}}{4}+(y-1)^{2}-1 & \\ge 0 \\\\ \\frac{(x-2)^{2}}{4}+(y-1)^{2} & \\ge 1\\end{aligned}\n$$\n\nwhich gives the exterior of the ellipse $\\frac{(x-2)^{2}}{4}+(y-1)^{2}=1,$ which includes the boundary.\n\nTherefore, the domain is\n\n$$\n{(x,y)\\,:\\,\\frac{(x-2)^{2}}{4}+(y-1)^{2}\\ge 1}.\n$$"}]}
