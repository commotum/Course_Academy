#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186162916} :activity/id #uuid "402c5791-a328-536f-b52e-96d65b27ede7" :activity/scope {:db/id #edb/ref 17592186049815 :topic/id #uuid "15e1a0d1-d9d9-5488-943d-228c2ac29ecd" :topic/math-academy-id 3062} :activity/steps [{:db/id #edb/ref 17592186162916 :step/content {:db/id #edb/ref 17592186163250 :tutorial/content "If $X$ and $Y$ are *independent* random variables, then\n\n$$\n\\textrm{Var}{[X+Y]} = \\textrm{Var}[X]+ \\textrm{Var}[Y] ,\n$$\n\nand\n\n$$\n\\textrm{Var}{[X-Y]} = \\textrm{Var}[X] + \\textrm{Var}[Y]  .\n$$\n\n**Watch out!** When computing the variance of a *difference* of independent random variables, we *add* the variances!" :tutorial/id #uuid "3c595d74-9638-52f2-a4af-79dfe2ded69c" :tutorial/math-academy-id 5023 :tutorial/title "Introduction"} :step/id #uuid "85c48a68-bb08-5e36-af92-8eb493ace0d1" :step/math-academy-id 31412 :step/next {:db/id #edb/ref 17592186162994}} {:db/id #edb/ref 17592186162981 :step/content {:db/id #edb/ref 17592186162062 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161862 :question/id #uuid "1df04c71-caae-5a7e-83ac-4dd578b7f766" :question/math-academy-id "e-9122"} :knowledge-point/id #uuid "52596d3a-a7af-55a0-97a8-8a6158b65638" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048731}] :knowledge-point/questions [{:db/id #edb/ref 17592186162275} {:db/id #edb/ref 17592186162293} {:db/id #edb/ref 17592186427840} {:db/id #edb/ref 17592186427842} {:db/id #edb/ref 17592186427845} {:db/id #edb/ref 17592186427849} {:db/id #edb/ref 17592186427850}] :knowledge-point/title "Calculating the Variance of a Sum of Scaled Random Variables"} :step/id #uuid "0a0041f4-e6ca-5360-9d1e-8b7a07a7bccd" :step/math-academy-id 33995 :step/next {:db/id #edb/ref 17592186162992}} {:db/id #edb/ref 17592186162992 :step/content {:db/id #edb/ref 17592186162067 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161867 :question/id #uuid "0c3690cd-f90e-5d82-ba7b-09d52de47b80" :question/math-academy-id "e-9143"} :knowledge-point/id #uuid "0df88138-7309-5a09-9a96-5e26029f0186" :knowledge-point/questions [{:db/id #edb/ref 17592186162276} {:db/id #edb/ref 17592186162277} {:db/id #edb/ref 17592186427837} {:db/id #edb/ref 17592186427839} {:db/id #edb/ref 17592186427846} {:db/id #edb/ref 17592186427847} {:db/id #edb/ref 17592186427848}] :knowledge-point/title "Calculating a Combined Variance Given Some Raw Moments"} :step/id #uuid "24790bde-943d-5850-8dad-fcae56637f85" :step/math-academy-id 34081} {:db/id #edb/ref 17592186162994 :step/content {:db/id #edb/ref 17592186162068 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161868 :question/id #uuid "70881840-32f1-5bab-947d-00d77f0ff71e" :question/math-academy-id "e-9181"} :knowledge-point/id #uuid "0e3dad37-612c-56f1-a571-360fafe336b4" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050835}] :knowledge-point/questions [{:db/id #edb/ref 17592186162295} {:db/id #edb/ref 17592186162296} {:db/id #edb/ref 17592186427838} {:db/id #edb/ref 17592186427841} {:db/id #edb/ref 17592186427843} {:db/id #edb/ref 17592186427844}] :knowledge-point/title "Calculating the Variance of a Sum or Difference of Independent Random Variables"} :step/id #uuid "d8885fb1-6c97-579e-9795-07aef731fb3e" :step/math-academy-id 34246 :step/next {:db/id #edb/ref 17592186163002}} {:db/id #edb/ref 17592186163002 :step/content {:db/id #edb/ref 17592186163284 :tutorial/content "We have been using the fact that if $X$ and $Y$ are independent, then\n\n$$\n\\textrm{Var}{[X+Y]} = \\textrm{Var}[X]+ \\textrm{Var}[Y]  .\n$$\n\nUsing the property that $\\textrm{Var}[aX] = a^2\\textrm{Var}[X],$ we can show that if $X$ and $Y$ are independent, then\n\n$$\n\\textrm{Var}{[aX+bY]} = a^2\\textrm{Var}[X]+ b^2\\textrm{Var}[Y] ,\n$$\n\nwhere $a$ and $b$ are constants.\n\nFor example, for two independent random variables $X$ and $Y$, we have \n\n$$\n\\begin{aligned}\\text{Var}[4X+3Y] & ={4}^{2}\\text{Var}[X]+{3}^{2}\\text{Var}[Y] \\\\  & =16\\text{Var}[X]+9\\text{Var}[Y]\\end{aligned}\n$$\n\nOnce again, we need to show caution when considering a difference. For example,\n\n$$\n\\begin{aligned}\\text{Var}[4X-3Y] & =\\text{Var}[4X+(-3)Y] \\\\  & ={4}^{2}\\text{Var}[X]+(-3)^{2}\\text{Var}[Y] \\\\  & =16\\text{Var}[X]+9\\text{Var}[Y].\\end{aligned}\n$$\n\nMore generally, if the random variables $X_1, X_2,\\ldots, X_n,$ are *mutually independent*, then\n\n$$\n\\textrm{Var}\\left[\\sum_{i=1}^n a_i X_i\\right] = \\sum_{i=1}^n a_i^2\\textrm{Var}[X_i].\n$$" :tutorial/id #uuid "d56df0e7-9547-5cad-8697-f7c9d96ff12a" :tutorial/math-academy-id 5514 :tutorial/title "The Variance of a Sum of Scaled Random Variables"} :step/id #uuid "bcaba5d6-1140-5eb4-b9e1-ea74caf408c7" :step/math-academy-id 34354 :step/next {:db/id #edb/ref 17592186162981}}] :activity/title "Variance of Sums of Independent Random Variables" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186162196}]}
