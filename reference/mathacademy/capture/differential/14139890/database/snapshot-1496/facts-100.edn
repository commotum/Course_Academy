5417] [17592186436745 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186436745 #edb/ref 1078 #edb/ref 17592186436740 #edb/ref 17592186045417] [17592186436745 #edb/ref 1079 #uuid "e3372d42-969f-5366-b1e8-185b07d6ec65" #edb/ref 17592186045417] [17592186436746 #edb/ref 1075 #edb/ref 17592186436708 #edb/ref 17592186045417] [17592186436746 #edb/ref 1075 #edb/ref 17592186436711 #edb/ref 17592186045417] [17592186436746 #edb/ref 1075 #edb/ref 17592186436722 #edb/ref 17592186045417] [17592186436746 #edb/ref 1075 #edb/ref 17592186436736 #edb/ref 17592186045417] [17592186436746 #edb/ref 1075 #edb/ref 17592186436739 #edb/ref 17592186045417] [17592186436746 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186436746 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186436746 #edb/ref 1078 #edb/ref 17592186436708 #edb/ref 17592186045417] [17592186436746 #edb/ref 1079 #uuid "f0abe695-c967-560e-ae04-c016647dc51d" #edb/ref 17592186045417] [17592186436747 #edb/ref 1068 #edb/ref 17592186436744 #edb/ref 17592186045417] [17592186436747 #edb/ref 1069 "q-132642" #edb/ref 17592186045417] [17592186436747 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186436747 #edb/ref 1071 "Given that $f(x,y)=\\operatorname{ln}⁡\\sqrt{2x+y},$ find the set of values $(x,y)$ on which $\\frac{∂f}{∂x}$ exists." #edb/ref 17592186045417] [17592186436747 #edb/ref 1072 #uuid "5c311fab-0276-5890-a0ca-a5fc54209d6b" #edb/ref 17592186045417] [17592186436747 #edb/ref 1074 "First, notice that $f(x,y)$ is defined only when \n\n$$\n2x+y>0.\n$$\n\nSo, the domain of $f$ is \n\n$$\n{D}_{f}=\\{(x,y)\\,:\\,2x+y>0\\}.\n$$\n\nNow, we compute the partial derivatives of $f(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}(\\operatorname{ln}⁡\\sqrt{2x+y}) \\\\  & =\\frac{1}{\\sqrt{2x+y}}\\cdot \\frac{2}{2\\sqrt{2x+y}} \\\\  & =\\frac{1}{2x+y}\\end{aligned}\n$$\n\nThe function ${f}_{x}(x,y)$ is defined only for \n\n$$\n\\begin{aligned}2x+y & \\ne 0.\\end{aligned}\n$$\n\n So, the domain of ${f}_{x}$ is\n\n$$\n{D}_{{f}_{x}}=\\{(x,y)\\,:\\,2x+y\\ne 0\\}.\n$$\n\nFinally, we conclude that the partial derivative of $f$ with respect to $x$ exists on the set\n\n$$\n\\begin{aligned}{D}_{f}\\cap {D}_{{f}_{x}} & =\\{(x,y)\\,:\\,2x+y>0\\}\\cap \\{(x,y)\\,:\\,2x+y\\ne 0\\} \\\\  & =\\{(x,y)\\,:\\,2x+y>0\\}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186436748 #edb/ref 1068 #edb/ref 17592186436746 #edb/ref 17592186045417] [17592186436748 #edb/ref 1069 "q-132636" #edb/ref 17592186045417] [17592186436748 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186436748 #edb/ref 1071 "Given that $f(x,y)=\\operatorname{arccos}⁡({x}^{2}+{y}^{2}),$ find the set of values $(x,y)$ on which $\\frac{∂f}{∂x}$ exists." #edb/ref 17592186045417] [17592186436748 #edb/ref 1072 #uuid "731abdd2-94a2-5d28-a3ea-af480d79c77c" #edb/ref 17592186045417] [17592186436748 #edb/ref 1074 "First, notice that $f(x,y)$ is defined when ${x}^{2}+{y}^{2}\\le 1.$ So, the domain of $f$ is \n\n$$\n{D}_{f}=\\{(x,y)\\,:\\,{x}^{2}+{y}^{2}\\le 1\\}.\n$$\n\nNow, we compute the partial derivatives of $f(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}(\\operatorname{arccos}⁡({x}^{2}+{y}^{2})) \\\\  & =-\\frac{1}{\\sqrt{1-{({x}^{2}+{y}^{2})}^{2}}}\\cdot 2x \\\\  & =-\\frac{2x}{\\sqrt{1-{({x}^{2}+{y}^{2})}^{2}}}\\end{aligned}\n$$\n\nThe function ${f}_{x}(x,y)$ is defined only for \n\n$$\n\\begin{aligned}1-{({x}^{2}+{y}^{2})}^{2} & >0 \\\\ {({x}^{2}+{y}^{2})}^{2} & <1 \\\\ {x}^{2}+{y}^{2} & <1.\\end{aligned}\n$$\n\n So, the domain of ${f}_{x}$ is\n\n$$\n{D}_{{f}_{x}}=\\{(x,y)\\,:\\,{x}^{2}+{y}^{2}<1\\}.\n$$\n\nFinally, we conclude that the partial derivative of $f$ with respect to $x$ exists on the set\n\n$$\n\\begin{aligned}{D}_{f}\\cap {D}_{{f}_{x}} & =\\{(x,y)\\,:\\,{x}^{2}+{y}^{2}\\le 1\\}\\cap \\{(x,y)\\,:\\,{x}^{2}+{y}^{2}<1\\} \\\\  & =\\{(x,y)\\,:\\,{x}^{2}+{y}^{2}<1\\}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186436749 #edb/ref 1068 #edb/ref 17592186436741 #edb/ref 17592186045417] [17592186436749 #edb/ref 1069 "q-132660" #edb/ref 17592186045417] [17592186436749 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186436749 #edb/ref 1071 "Given that $f(x,y)=\\operatorname{ln}⁡(2x-y)$ and\n\n$$\n\\frac{∂f}{∂x}=\\frac{2}{2x-y},\\,\\frac{∂f}{∂y}=-\\frac{1}{2x-y},\n$$\n\nfind the set of values $(x,y)$ where all partial derivatives of $f$ exist." #edb/ref 17592186045417] [17592186436749 #edb/ref 1072 #uuid "9a747118-95ab-56ac-85bf-8bf99184999c" #edb/ref 17592186045417] [17592186436749 #edb/ref 1074 "First, notice that $f(x,y)=\\operatorname{ln}⁡(2x-y)$ is defined only when $2x-y>0.$ So, the domain of $f$ is \n\n$$\n{D}_{f}=\\{(x,y)\\,:\\,2x-y>0\\}.\n$$\n\nAs for the partial derivatives, we have the following.\n\n- The function ${f}_{x}(x,y)=\\frac{2}{2x-y}$ is defined only when $2x-y\\ne 0.$ So, the domain of ${f}_{x}$ is \n\n$$\n{D}_{{f}_{x}}=\\{(x,y)\\,:\\,2x-y\\ne 0\\}.\n$$\n\n- The function ${f}_{y}(x,y)=-\\frac{1}{2x-y}$ is defined only when $2x-y\\ne 0.$ So, the domain of ${f}_{y}$ is \n\n$$\n{D}_{{f}_{y}}=\\{(x,y)\\,:\\,2x-y\\ne 0\\}.\n$$\n\nFinally, we conclude that the partials of $f$ exist on the set\n\n$$\n\\begin{aligned}{D}_{f}\\cap {D}_{{f}_{x}}\\cap {D}_{{f}_{y}} & =\\{(x,y)\\,:\\,2x-y>0\\}\\cap \\{(x,y)\\,:\\,2x-y\\ne 0\\}\\cap \\{(x,y)\\,:\\,2x-y\\ne 0\\} \\\\  & =\\{(x,y)\\,:\\,2x-y>0\\}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186436750 #edb/ref 1068 #edb/ref 17592186436743 #edb/ref 17592186045417] [17592186436750 #edb/ref 1069 "q-36625" #edb/ref 17592186045417] [17592186436750 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186436750 #edb/ref 1071 "Given that $f(x,y,z)=\\frac{y}{xz},$ find the set of values $(x,y,z)$ on which $\\frac{∂f}{∂z}$ exists." #edb/ref 17592186045417] [17592186436750 #edb/ref 1072 #uuid "a2765af0-b76f-50a6-a22d-2203197bac13" #edb/ref 17592186045417] [17592186436750 #edb/ref 1074 "First, notice that $f(x,y,z)$ is defined only when $xz\\ne 0.$ So, the domain of $f$ is \n\n$$\n{D}_{f}=\\{(x,y,z)\\,:\\,xz\\ne 0\\}.\n$$\n\nNow, we compute the partial derivative of $f(x,y,z)$ with respect to $z:$\n\n$$\n\\begin{aligned}{f}_{z}(x,y,z) & =\\frac{∂}{∂z}(\\frac{y}{xz}) \\\\  & =-\\frac{y}{x{z}^{2}}\\end{aligned}\n$$\n\nThe function ${f}_{z}(x,y,z)$ is defined only for \n\n$$\n\\begin{aligned}x{z}^{2} & \\ne 0 \\\\ xz & \\ne 0.\\end{aligned}\n$$\n\nSo, the domain of ${f}_{z}$ is\n\n$$\n{D}_{{f}_{z}}=\\{(x,y,z)\\,:\\,xz\\ne 0\\}.\n$$\n\nFinally, we conclude that the partial derivative of $f$ with respect to $z$ exists on the set\n\n$$\n\\begin{aligned}{D}_{f}\\cap {D}_{{f}_{z}} & =\\{(x,y,z)\\,:\\,xz\\ne 0\\}\\cap \\{(x,y,z)\\,:\\,xz\\ne 0\\} \\\\  & =\\{(x,y,z)\\,:\\,xz\\ne 0\\}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186436751 #edb/ref 1068 #edb/ref 17592186436742 #edb/ref 17592186045417] [17592186436751 #edb/ref 1069 "q-72026" #edb/ref 17592186045417] [17592186436751 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186436751 #edb/ref 1071 "Given that $g(x,y)=\\operatorname{arctan}⁡(\\frac{x}{y})$ and\n\n$$\n\\frac{∂g}{∂x}=\\frac{y}{{x}^{2}+{y}^{2}},\\,\\frac{∂g}{∂y}=-\\frac{x}{{x}^{2}+{y}^{2}},\n$$\n\nfind the set of values $(x,y)$ on which all partial derivatives of $g$ exist." #edb/ref 17592186045417] [17592186436751 #edb/ref 1072 #uuid "ab5cb657-b1a4-53bf-b28c-dfde9b8dddbc" #edb/ref 17592186045417] [17592186436751 #edb/ref 1074 "First, notice that $g(x,y)=\\operatorname{arctan}⁡(\\frac{x}{y})$ is defined only when $y\\ne 0.$ So, the domain of $g$ is \n\n$$\n{D}_{g}=\\{(x,y)\\,:\\,y\\ne 0\\}.\n$$\n\nAs for the partial derivatives, we have the following.\n\n- The function $\\frac{∂g}{∂x}=\\frac{y}{{x}^{2}+{y}^{2}}$ is defined only when ${x}^{2}+{y}^{2}>0.$ So, the domain of ${g}_{x}$ is \n\n$$\n{D}_{{g}_{x}}=\\{(x,y)\\,:\\,{x}^{2}+{y}^{2}\\ne 0\\}.\n$$\n\n- Similarly, the domains of $\\frac{∂g}{∂y}$ is the same:\n\n$$\n{D}_{{g}_{y}}=\\{(x,y)\\,:\\,{x}^{2}+{y}^{2}\\ne 0\\}.\n$$\n\nFinally, we conclude that the partial derivatives of $g$ exist on the set\n\n$$\n\\begin{aligned}{D}_{g}\\cap {D}_{{g}_{x}}\\cap {D}_{{g}_{y}} & ={D}_{g}\\cap {D}_{{g}_{x}} \\\\  & =\\{(x,y)\\,:\\,y\\ne 0\\}\\cap \\{(x,y)\\,:\\,{x}^{2}+{y}^{2}\\ne 0\\} \\\\  & =\\{(x,y)\\,:\\,y\\ne 0\\}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186436752 #edb/ref 1068 #edb/ref 17592186436745 #edb/ref 17592186045417] [17592186436752 #edb/ref 1069 "q-132672" #edb/ref 17592186045417] [17592186436752 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186436752 #edb/ref 1071 "Which of the following statements are true about the function $f(x,y)=\\sqrt{x}\\,{e}^{x/y}?$\n\nI. Both partial derivatives exist at the point $(1,1)$\n\nII. ${f}_{x}(0,1)$ is defined\n\nIII. ${f}_{y}(0,1)$ is defined" #edb/ref 17592186045417] [17592186436752 #edb/ref 1072 #uuid "efd3e6cc-b29d-5cd4-ba97-6a3820c7c7c6" #edb/ref 17592186045417] [17592186436752 #edb/ref 1074 "First, we compute the partial derivatives of $f(x,y):$\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}\\sqrt{x}\\,{e}^{x/y} \\\\  & ={e}^{x/y}\\cdot \\frac{∂}{∂x}(\\sqrt{x})+\\sqrt{x}\\cdot \\frac{∂}{∂x}({e}^{x/y}) \\\\  & ={e}^{x/y}\\cdot \\frac{1}{2\\sqrt{x}}+\\sqrt{x}\\cdot \\frac{{e}^{x/y}}{y} \\\\  & =\\frac{{e}^{x/y}(2x+y)}{2y\\sqrt{x}} \\\\ {f}_{y}(x,y) & =\\frac{∂}{∂y}\\sqrt{x}\\,{e}^{x/y} \\\\  & =\\sqrt{x}\\cdot \\frac{∂}{∂y}({e}^{x/y}) \\\\  & =\\sqrt{x}\\cdot {e}^{x/y}\\cdot (-\\frac{x}{{y}^{2}}) \\\\  & =-\\frac{\\sqrt{{x}^{3}}\\,{e}^{x/y}}{{y}^{2}}\\end{aligned}\n$$\n\nNow, let's examine the statements one-by-one.\n\n- Statement I is true. Indeed, the function $f$ is defined at $(1,1)$, where we have \n\n$$\nf(1,1)=\\sqrt{1}\\,{e}^{1/1}=e,\n$$\n\nand both partial derivatives are also defined at $(1,1):$\n\n$$\n\\begin{aligned}{f}_{x}(1,1) & =\\frac{{e}^{1/1}(2(1)+1)}{2(1)\\sqrt{1}}=\\frac{3e}{2} \\\\ {f}_{y}(1,1) & =-\\frac{\\sqrt{{1}^{3}}\\,{e}^{1/1}}{{1}^{2}}=-e\\end{aligned}\n$$\n\n- Statement II is false. If we substitute $(0,1)$ into ${f}_{x}$, we get\n\n$$\n{f}_{x}(0,1)=\\frac{{e}^{0/1}(2(0)+1)}{2(1)\\sqrt{0}}=\\frac{1}{0},\n$$\n\nwhich is undefined since we have division by zero.\n\n- Statement III is true. Indeed, the function $f$ itself is defined at $(0,1)$, where we have \n\n$$\nf(0,1)=\\sqrt{0}\\,{e}^{0/1}=0,\n$$\n\nand ${f}_{y}$ is also defined at $(0,1):$\n\n$$\n\\begin{aligned}{f}_{y}(0,1)=-\\frac{\\sqrt{{0}^{3}}\\,{e}^{0/1}}{{1}^{2}}=0.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I and III only\"." #edb/ref 17592186045417]}
