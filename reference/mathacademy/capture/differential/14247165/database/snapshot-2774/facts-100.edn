690 #edb/ref 17592186045417] [17592186378942 #edb/ref 1075 #edb/ref 17592186524702 #edb/ref 17592186045417] [17592186378942 #edb/ref 1075 #edb/ref 17592186524769 #edb/ref 17592186045417] [17592186378942 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186378942 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186378942 #edb/ref 1078 #edb/ref 17592186524690 #edb/ref 17592186045417] [17592186378942 #edb/ref 1079 #uuid "b03fdffd-f573-5a99-b226-1770ea3e8102" #edb/ref 17592186045417] [17592186378948 #edb/ref 1068 #edb/ref 17592186378949 #edb/ref 17592186045417] [17592186378948 #edb/ref 1069 "q-164402" #edb/ref 17592186045417] [17592186378948 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186378948 #edb/ref 1071 "Given the sphere $(x+1)^{2}+(y-3)^{2}+(z+3)^{2}=3,$ what is the domain of $z=z(x,y)?$" #edb/ref 17592186045417] [17592186378948 #edb/ref 1072 #uuid "6423dc93-7d2d-540e-980c-bc6677e7ca75" #edb/ref 17592186045417] [17592186378948 #edb/ref 1074 "From the equation of the sphere, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}(x+1)^{2}+(y-3)^{2}+(z+3)^{2} & =3 \\\\ (z+3)^{2} & =3-((x+1)^{2}+(y-3)^{2}) \\\\ z+3 & =\\pm \\sqrt{3-((x+1)^{2}+(y-3)^{2})} \\\\ z & =-3\\pm \\sqrt{3-((x+1)^{2}+(y-3)^{2})}\\end{aligned}\n$$\n\nSince the square root is defined only for non-negative arguments, we have the following:\n\n$$\n\\begin{aligned}3-((x+1)^{2}+(y-3)^{2})\\ge 0 \\\\ (x+1)^{2}+(y-3)^{2}\\le 3\\end{aligned}\n$$\n\nThis inequality describes the interior and boundary of the circle \n\n$$\n(x+1)^{2}+(y-3)^{2}=3\n$$\n\nwhich is a circle of radius $\\sqrt{3}$ centered at $(-1,3)$ in the $xy$-plane." #edb/ref 17592186045417] [17592186378949 #edb/ref 1075 #edb/ref 17592186378950 #edb/ref 17592186045417] [17592186378949 #edb/ref 1075 #edb/ref 17592186378951 #edb/ref 17592186045417] [17592186378949 #edb/ref 1075 #edb/ref 17592186378952 #edb/ref 17592186045417] [17592186378949 #edb/ref 1075 #edb/ref 17592186378953 #edb/ref