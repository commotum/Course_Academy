db/ref 17592186045417] [17592186565408 #edb/ref 1075 #edb/ref 17592186565161 #edb/ref 17592186045417] [17592186565408 #edb/ref 1075 #edb/ref 17592186565162 #edb/ref 17592186045417] [17592186565408 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186565408 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186565408 #edb/ref 1078 #edb/ref 17592186564999 #edb/ref 17592186045417] [17592186565408 #edb/ref 1079 #uuid "f4183e30-864f-59d2-a111-26fabe8674fe" #edb/ref 17592186045417] [17592186565414 #edb/ref 1068 #edb/ref 17592186565348 #edb/ref 17592186045417] [17592186565414 #edb/ref 1069 "q-73216" #edb/ref 17592186045417] [17592186565414 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186565414 #edb/ref 1071 "What is the trace in the $yz$-plane of the ellipsoid $\\frac{{x}^{2}}{8}+\\frac{(y+1)^{2}}{6}+\\frac{(z-1)^{2}}{12}=1?$" #edb/ref 17592186045417] [17592186565414 #edb/ref 1072 #uuid "15b3432d-8b0c-5d62-a84d-7dadd72f7ac7" #edb/ref 17592186045417] [17592186565414 #edb/ref 1074 "To find the trace in the $yz$-plane, we substitute $x=0$ into the equation of the ellipsoid:\n\n$$\n\\begin{aligned}\\frac{{0}^{2}}{8}+\\frac{(y+1)^{2}}{6}+\\frac{(z-1)^{2}}{12}=1 \\\\ \\frac{(y+1)^{2}}{6}+\\frac{(z-1)^{2}}{12}=1 \\\\ \\frac{(y+1)^{2}}{(\\sqrt{6})^{2}}+\\frac{(z-1)^{2}}{(2\\sqrt{3})^{2}}=1\\end{aligned}\n$$\n\nThis gives us the equation of the ellipse with semi-axes $\\sqrt{6}$ and $2\\sqrt{3},$ centered at $(-1,1)$ in the $yz$-plane." #edb/ref 17592186045417] [17592186565458 #edb/ref 1068 #edb/ref 17592186565374 #edb/ref 17592186045417] [17592186565458 #edb/ref 1069 "q-70487" #edb/ref 17592186045417] [17592186565458 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186565458 #edb/ref 1071 "What is the trace in the $xz$-plane of the sphere ${x}^{2}+{y}^{2}+(z-1)^{2}=2?$" #edb/ref 17592186045417] [17592186565458 #edb/ref 1072 #uuid "b46dd9b0-6a80-5531-9884-f4687e775cb2" #edb/ref 17592186045417] [17592186565458 #edb/ref 1074 "To find the trace in the $xz$-plane, we substitute $y=0$ into the equation of the sphere:\n\n$$\n\\begin{aligned}{x}^{2}+(0)^{2}+(z-1)^{2}=2 \\\\ {x}^{2}+(z-1)^{2}=2\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186565460 #edb/ref 1068 #edb/ref 17592186565408 #edb/ref 17592186045417] [17592186565460 #edb/ref 1069 "q-64729" #edb/ref 17592186045417] [17592186565460 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186565460 #edb/ref 1071 "Given the ellipse $\\frac{(x-2)^{2}}{10}+\\frac{(y+1)^{2}}{10}+\\frac{(z-1)^{2}}{2}=1$, find its intercepts with the $y$-axis." #edb/ref 17592186045417] [17592186565460 #edb/ref 1072 #uuid "be1595d6-b16a-5715-995c-d3645afe8a1e" #edb/ref 17592186045417] [17592186565460 #edb/ref 1074 "To find the $y$-intercepts, we plug $x=0$ and $z=0$ into the equation:\n\n$$\n\\begin{aligned}\\frac{(0-2)^{2}}{10}+\\frac{(y+1)^{2}}{10}+\\frac{(0-1)^{2}}{2} & =1 \\\\ \\frac{2}{5}+\\frac{(y+1)^{2}}{10}+\\frac{1}{2} & =1 \\\\ \\frac{(y+1)^{2}}{10} & =\\frac{1}{10} \\\\ (y+1)^{2} & =1 \\\\ y+1 & =\\pm 1 \\\\ y & =-1\\pm 1\\end{aligned}\n$$\n\nHence, we get the solutions $y=-2$ and $y=0.$\n\nTherefore, the intercepts with the $y$-axis are $(0,-2,0)$ and $(0,0,0).$" #edb/ref 17592186045417] [17592186565475 #edb/ref 1068 #edb/ref 17592186565330 #edb/ref 17592186045417] [17592186565475 #edb/ref 1069 "q-71945" #edb/ref 17592186045417] [17592186565475 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186565475 #edb/ref 1071 "What is the radius of the sphere ${x}^{2}-6x+{y}^{2}+{z}^{2}=17?$" #edb/ref 17592186045417] [17592186565475 #edb/ref 1072 #uuid "e09cfecd-e23b-5baa-8f4c-7e2b5c69c1a9" #edb/ref 17592186045417] [17592186565475 #edb/ref 1074 "Remember that the equation of a sphere centered at $({x}_{0},{y}_{0},{z}_{0})$ with radius $r>0$ is given by\n\n$$\n(x-{x}_{0})^{2}+(y-{y}_{0})^{2}+(z-{z}_{0})^{2}={r}^{2}.\n$$\n\nBy completing the square for the variable $x$, we have:\n\n$$\n\\begin{aligned}{x}^{2}-6x+{y}^{2}+{z}^{2} & =17 \\\\ ({x}^{2}-6x+9)+{y}^{2}+{z}^{2} & =17+9 \\\\ (x-3)^{2}+{y}^{2}+{z}^{2} & =26\\end{aligned}\n$$\n\nNow, we can write our equation as\n\n$$\n(x-3)^{2}+{y}^{2}+{z}^{2}=(\\sqrt{26})^{2},\n$$\n\nwhich gives us a radius of $\\sqrt{26}.$" #edb/ref 17592186045417]}
