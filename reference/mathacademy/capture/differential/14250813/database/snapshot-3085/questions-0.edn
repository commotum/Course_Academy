#{[{:db/id #edb/ref 17592186124396 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186124585 :knowledge-point/id #uuid "2e0b4012-403b-5739-8f33-3c79111129fd" :knowledge-point/title "Identifying Properties of Elliptic Cones"}] :question/id #uuid "c351fdde-ce68-5fa1-97e1-7678211a3963" :question/math-academy-id "e-8216" :question/problem "Given the elliptic cone $\\dfrac{(x-2)^2}{4} + \\dfrac{(y-2)^2}{2} = \\dfrac{(z+1)^2}{3},$ find its intercepts with the $z$-axis." :question/worked-solution "To find the $z$-intercepts of the elliptic cone, we plug $x=0$ and $y=0$ into the equation and solve for $z\\mathbin{:}$\n\n$$\n\\begin{aligned}\\frac{(0-2)^{2}}{4}+\\frac{(0-2)^{2}}{2} & =\\frac{(z+1)^{2}}{3} \\\\ \\frac{4}{4}+\\frac{4}{2} & =\\frac{(z+1)^{2}}{3} \\\\ 1+2 & =\\frac{(z+1)^{2}}{3} \\\\ 3 & =\\frac{(z+1)^{2}}{3} \\\\ 9 & =(z+1)^{2} \\\\ z+1 & =\\pm 3 \\\\ z & =-1\\pm 3 \\\\ z & =-4,2\\end{aligned}\n$$\n\nTherefore, the intercepts with the $z$-axis are $(0,0,-4)$ and $(0,0,2).$"}] [{:db/id #edb/ref 17592186124397 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186124586 :knowledge-point/id #uuid "fb7148a2-58cc-5023-845c-435b47e31c83" :knowledge-point/title "Finding Traces of Elliptic Cones"}] :question/id #uuid "89ae8962-7ad4-5860-b070-8df4d92128ed" :question/math-academy-id "e-8217" :question/problem "What is the trace in the $xz$-plane of the elliptic cone $3x^2 +  4y ^2=12(z+3)^2\\: ?$" :question/worked-solution "To find the trace in the $xz$-plane, we substitute $y=0$ into the equation of the elliptic cone, as follows:\n\n$$\n\\begin{aligned}3{x}^{2}+4\\cdot {0}^{2} & =12(z+3)^{2} \\\\ 3{x}^{2} & =12(z+3)^{2} \\\\ {x}^{2} & =4(z+3)^{2} \\\\ \\pm x & =2(z+3) \\\\ \\pm \\frac{x}{2} & =z+3 \\\\ z & =\\pm \\frac{x}{2}-3\\end{aligned}\n$$\n\nThis gives us two lines in the $xz$-plane with equations $z = \\pm\\dfrac{x}{2}-3.$"}] [{:db/id #edb/ref 17592186381890 :knowledge-point/_questions [{:db/id #edb/ref 17592186124586 :knowledge-point/id #uuid "fb7148a2-58cc-5023-845c-435b47e31c83" :knowledge-point/title "Finding Traces of Elliptic Cones"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b32caa62-88f6-5d6a-8bf1-858542076ec3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186381892} {:answer/id #uuid "99572036-f894-5f42-90cf-74ad1933ff78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\sqrt{3}" :db/id #edb/ref 17592186381893} {:answer/id #uuid "bdc1b184-54da-5ed8-8ba3-cbeb21476b1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186381894} {:answer/id #uuid "a443b391-3cc4-5520-8541-4f1fe409e104" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186381895} {:answer/id #uuid "bb3b5e8d-f711-53e5-80e6-ab131f8c3eee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186381896}] :answer-field/correct {:answer/id #uuid "99572036-f894-5f42-90cf-74ad1933ff78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\sqrt{3}" :db/id #edb/ref 17592186381893} :answer-field/id #uuid "66f7cc27-507e-538b-9461-36cbd01fe66d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381891}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "567f06ad-7dd7-54b0-b743-ae083d4d749f" :question/math-academy-id "q-35265" :question/problem "Given that the intersection of the elliptic cone $\\frac{(x+2)^{2}}{9}+\\frac{(y-5)^{2}}{3}={z}^{2}$ and the plane $z=3$ is an ellipse, what is the length of its minor axis?" :question/worked-solution "To find the intersection of the elliptic cone and the plane $z=3,$ we substitute $z=3$ into the equation of the elliptic cone, and simplify:\n\n$$\n\\begin{aligned}\\frac{(x+2)^{2}}{9}+\\frac{(y-5)^{2}}{3}={z}^{2} \\\\ \\frac{(x+2)^{2}}{9}+\\frac{(y-5)^{2}}{3} & ={3}^{2} \\\\ \\frac{(x+2)^{2}}{9}+\\frac{(y-5)^{2}}{3} & =9 \\\\ \\frac{(x+2)^{2}}{81}+\\frac{(y-5)^{2}}{27} & =1 \\\\ \\frac{(x+2)^{2}}{{9}^{2}}+\\frac{(y-5)^{2}}{(3\\sqrt{3})^{2}} & =1\\end{aligned}\n$$\n\nThis gives us the equation of an ellipse with a semi-minor axis of length $b=3\\sqrt{3}.$ Therefore, the minor axis has length $2b=6\\sqrt{3}.$"}] [{:db/id #edb/ref 17592186571441 :knowledge-point/_questions [{:db/id #edb/ref 17592186124586 :knowledge-point/id #uuid "fb7148a2-58cc-5023-845c-435b47e31c83" :knowledge-point/title "Finding Traces of Elliptic Cones"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13ca2f9b-6c44-5a4e-beec-32fdb4df9802" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186570917} {:answer/id #uuid "250bda17-487f-57f0-bcb3-52f5fbad9a8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186570946} {:answer/id #uuid "82a88085-5486-58b7-bdfa-63ca22cbfffd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186571092} {:answer/id #uuid "a0339904-5de8-55ff-83b8-87ea2be53875" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186571139} {:answer/id #uuid "a4970e8a-f5ab-5019-b4e7-8c9714e1713e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186571150}] :answer-field/correct {:answer/id #uuid "250bda17-487f-57f0-bcb3-52f5fbad9a8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186570946} :answer-field/id #uuid "3af3fb6c-c3bc-546f-9289-9615c47438aa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186571304}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d5b24ae7-b9a6-5e75-88d0-42797741c3b6" :question/math-academy-id "q-35309" :question/problem "Given that the intersection of the elliptic cone  ${x}^{2}+2(y-1)^{2}={z}^{2}$ and the plane $z=2$ is an ellipse, what is the length of its minor axis?" :question/worked-solution "To find the intersection of the elliptic cone and the plane $z=2,$ we substitute $z=2$ into the equation of the elliptic cone, and simplify:\n\n$$\n\\begin{aligned}{x}^{2}+2(y-1)^{2} & ={z}^{2} \\\\ {x}^{2}+2(y-1)^{2} & ={2}^{2} \\\\ {x}^{2}+2(y-1)^{2} & =4 \\\\ \\frac{{x}^{2}}{4}+\\frac{(y-1)^{2}}{2} & =1 \\\\ \\frac{{x}^{2}}{{2}^{2}}+\\frac{(y-1)^{2}}{(\\sqrt{2})^{2}} & =1\\end{aligned}\n$$\n\nThis gives us the equation of an ellipse with a semi-minor axis of length $b=\\sqrt{2}.$ Therefore, the minor axis has length $2b=2\\sqrt{2}.$"}] [{:db/id #edb/ref 17592186124894 :knowledge-point/_questions [{:db/id #edb/ref 17592186124586 :knowledge-point/id #uuid "fb7148a2-58cc-5023-845c-435b47e31c83" :knowledge-point/title "Finding Traces of Elliptic Cones"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fc3f777a-8154-5f8e-82e8-5a1f5a53f9a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186121965} {:answer/id #uuid "07c9aea4-325f-592d-9e7a-9d6c5d16fea9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186121966} {:answer/id #uuid "1c8bdaf3-6ae4-5b1c-869a-03c7d439d0e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186121967} {:answer/id #uuid "2c7939b2-7ea7-5e6c-9ca3-e6c556ab2691" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186121968} {:answer/id #uuid "6cc1deed-cc2f-55a7-94c6-10734889c712" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186121969}] :answer-field/id #uuid "d4de7975-5011-59e8-9c71-cc5dcb39301b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186121964} {:answer-field/choices [{:answer/id #uuid "564e7b44-c378-5cdf-9c4c-165ec0111b77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186395833} {:answer/id #uuid "bd24e831-d137-57fd-a292-6b2a20eb4818" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186395834} {:answer/id #uuid "38c627b5-7c19-582a-89bd-cde1528dcc8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186395835} {:answer/id #uuid "35f49549-32d6-5426-8139-bf824bd1fff4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186395836} {:answer/id #uuid "af5fb198-e44a-5637-90bf-bc1687e13b6e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186395837}] :answer-field/correct {:answer/id #uuid "38c627b5-7c19-582a-89bd-cde1528dcc8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186395835} :answer-field/id #uuid "35207db3-b5ad-5f76-82f1-ffe1835635a9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395832}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "65b5aaee-5eaf-5370-809f-ff7bd458f787" :question/math-academy-id "q-35620" :question/problem "Given that the intersection of the elliptic cone $3(x+4)^{2}+8{y}^{2}=12{z}^{2}$ and the plane $z=-2$ is an ellipse, what is the length of its major axis?" :question/worked-solution "To find the intersection of the elliptic cone and the plane $z=-2,$ we substitute $z=-2$ into the equation of the elliptic cone, and simplify:\n\n$$\n\\begin{aligned}3(x+4)^{2}+8{y}^{2} & =12{z}^{2} \\\\ 3(x+4)^{2}+8{y}^{2} & =12(-2)^{2} \\\\ 3(x+4)^{2}+8{y}^{2} & =48 \\\\ \\frac{(x+4)^{2}}{16}+\\frac{{y}^{2}}{6} & =1 \\\\ \\frac{(x+4)^{2}}{{4}^{2}}+\\frac{{y}^{2}}{(\\sqrt{6})^{2}} & =1\\end{aligned}\n$$\n\nThis gives us the equation of an ellipse with a semi-major axis of length $a=4.$ Therefore, the major axis has length $2a=8.$"}] [{:db/id #edb/ref 17592186125239 :knowledge-point/_questions [{:db/id #edb/ref 17592186124585 :knowledge-point/id #uuid "2e0b4012-403b-5739-8f33-3c79111129fd" :knowledge-point/title "Identifying Properties of Elliptic Cones"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "431915b2-15e4-559a-9ff5-a1abef76b999" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,-1,0)" :db/id #edb/ref 17592186355262} {:answer/id #uuid "69b4bd2c-81f2-5ad5-b932-fc660accbada" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,1,0)" :db/id #edb/ref 17592186355596} {:answer/id #uuid "976223ef-b049-5a60-8175-d7ccdf55f16f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,-1,0)" :db/id #edb/ref 17592186355995} {:answer/id #uuid "a7cb07b7-3acf-5d59-ba6d-f563d82a166a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,0,0)" :db/id #edb/ref 17592186356150} {:answer/id #uuid "eb3da815-6277-5b7a-9d14-81d8eb8cfaf1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,1,0)" :db/id #edb/ref 17592186356718}] :answer-field/correct {:answer/id #uuid "eb3da815-6277-5b7a-9d14-81d8eb8cfaf1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,1,0)" :db/id #edb/ref 17592186356718} :answer-field/id #uuid "b2daa040-b350-5a0f-89d7-1814b47a133e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357242}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6dbbc8b0-b994-5e7b-854a-3bf51bb1a258" :question/math-academy-id "q-94082" :question/problem "Find the center of the elliptic cone $2(x+2)^{2}+3(y-1)^{2}={z}^{2}.$" :question/worked-solution "The general equation of an elliptic cone with center at the point $({x}_{0},{y}_{0},{z}_{0})$ is\n\n$$\n\\frac{(x-{x}_{0})^{2}}{{a}^{2}}+\\frac{(y-{y}_{0})^{2}}{{b}^{2}}=\\frac{(z-{z}_{0})^{2}}{{c}^{2}}.\n$$\n\nTo find the center, we rewrite our equation in standard form, as follows:\n\n$$\n\\begin{aligned}2(x+2)^{2}+3(y-1)^{2} & =(z-0)^{2} \\\\ \\frac{(x+2)^{2}}{1/2}+\\frac{(y-1)^{2}}{1/3} & =(z-0)^{2} \\\\ \\frac{(x-(-2))^{2}}{1/2}+\\frac{(y-1)^{2}}{1/3} & =(z-0)^{2}\\end{aligned}\n$$\n\nThis gives us the equation of an elliptic cone that has its center at $(-2,1,0).$"}] [{:db/id #edb/ref 17592186382601 :knowledge-point/_questions [{:db/id #edb/ref 17592186124586 :knowledge-point/id #uuid "fb7148a2-58cc-5023-845c-435b47e31c83" :knowledge-point/title "Finding Traces of Elliptic Cones"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27e40fd8-0f3b-571d-8a89-e0919ffcb765" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\pm x" :db/id #edb/ref 17592186382603} {:answer/id #uuid "623908e6-919c-5b70-9d85-fe8f76808d9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\pm \\frac{x}{4}-1" :db/id #edb/ref 17592186382604} {:answer/id #uuid "7dcd5eb7-3aca-54dd-a811-7dbb69aba53d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\pm \\frac{x}{2}" :db/id #edb/ref 17592186382605} {:answer/id #uuid "19e3fd61-0a2f-5604-888f-4440aa9a5bd2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\pm \\frac{x}{4}" :db/id #edb/ref 17592186382606} {:answer/id #uuid "ae2ecc97-db26-5b47-a036-e1edfa4e737f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\pm \\frac{x}{2}-1" :db/id #edb/ref 17592186382607}] :answer-field/correct {:answer/id #uuid "7dcd5eb7-3aca-54dd-a811-7dbb69aba53d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\pm \\frac{x}{2}" :db/id #edb/ref 17592186382605} :answer-field/id #uuid "20bac5b2-1ae4-5ea2-9ab6-50a2f3c5a347" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382602}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "25ced7bd-f765-5db6-9282-9e6cc6408eec" :question/math-academy-id "q-94484" :question/problem "What is the trace in the $xz$-plane of the elliptic cone ${x}^{2}+4{y}^{2}=4{z}^{2}\\,?$" :question/worked-solution "To find the trace in the $xz$-plane, we substitute $y=0$ into the equation of the elliptic cone, as follows:\n\n$$\n\\begin{aligned}{x}^{2}+4(0)^{2} & =4{z}^{2} \\\\ {x}^{2} & =4{z}^{2} \\\\ \\pm x & =2z \\\\ z & =\\pm \\frac{x}{2}\\end{aligned}\n$$\n\nThis gives us two lines in the $xz$-plane with equations $z=\\pm \\frac{x}{2}.$"}] [{:db/id #edb/ref 17592186357748 :knowledge-point/_questions [{:db/id #edb/ref 17592186124585 :knowledge-point/id #uuid "2e0b4012-403b-5739-8f33-3c79111129fd" :knowledge-point/title "Identifying Properties of Elliptic Cones"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1246f2e9-6f9b-5ebc-bba3-7743e4e4f09a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0,0)$ and $(0,8,0)$" :db/id #edb/ref 17592186354831} {:answer/id #uuid "47a1041e-6ba4-5a9b-b459-e894299ac0aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,4,0)$ only" :db/id #edb/ref 17592186355297} {:answer/id #uuid "5d65342c-25a8-5b60-be25-bc71de71fd47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0,0)$ only" :db/id #edb/ref 17592186355491} {:answer/id #uuid "75a07dc2-16ab-5d16-bc3e-b37d40fec987" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,4,0)$ and $(0,16,0)$" :db/id #edb/ref 17592186355697} {:answer/id #uuid "a33fa89c-5ff7-5088-b245-06cd4023f92e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,2,0)$ and $(0,8,0)$" :db/id #edb/ref 17592186356111}] :answer-field/correct {:answer/id #uuid "1246f2e9-6f9b-5ebc-bba3-7743e4e4f09a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0,0)$ and $(0,8,0)$" :db/id #edb/ref 17592186354831} :answer-field/id #uuid "247353bc-f317-50f9-9e63-69a83a776596" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186356978}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0eddc295-4ccf-5f85-867d-2e883adc8a98" :question/math-academy-id "q-94485" :question/problem "Given the elliptic cone $\\frac{(x-6)^{2}}{9}+\\frac{(y-4)^{2}}{8}=\\frac{(z+6)^{2}}{6},$ find its intercepts with the $y$-axis." :question/worked-solution "To find the $y$-intercepts of the elliptic cone, we plug $x=0$ and $z=0$ into the equation and solve for $y:$\n\n$$\n\\begin{aligned}\\frac{(0-6)^{2}}{9}+\\frac{(y-4)^{2}}{8} & =\\frac{(0+6)^{2}}{6} \\\\ \\frac{36}{9}+\\frac{(y-4)^{2}}{8} & =\\frac{36}{6} \\\\ 4+\\frac{(y-4)^{2}}{8} & =6 \\\\ \\frac{(y-4)^{2}}{8} & =2 \\\\ (y-4)^{2} & =16 \\\\ y-4 & =\\pm 4 \\\\ y & =4\\pm 4 \\\\ y & =0,8\\end{aligned}\n$$\n\nTherefore, the intercepts with the $y$-axis are $(0,0,0)$ and $(0,8,0).$"}] [{:db/id #edb/ref 17592186357751 :knowledge-point/_questions [{:db/id #edb/ref 17592186124586 :knowledge-point/id #uuid "fb7148a2-58cc-5023-845c-435b47e31c83" :knowledge-point/title "Finding Traces of Elliptic Cones"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "497c9287-8527-5f28-9070-29d5455ff937" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,0,0)" :db/id #edb/ref 17592186355315} {:answer/id #uuid "8935fc20-662f-5493-8895-2ff5e7873ee9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\pm 3x-5" :db/id #edb/ref 17592186355877} {:answer/id #uuid "8cd8d2b3-1b54-51b9-aa4b-86e2141de38d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\pm \\frac{x}{3}+2" :db/id #edb/ref 17592186355907} {:answer/id #uuid "97966c4c-9e1f-5c8e-b01d-facfe4e419d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(9,2,0)" :db/id #edb/ref 17592186356000} {:answer/id #uuid "b6f64f22-7913-52f4-86c8-f51e90ac0c11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\pm \\frac{2x}{3}+18" :db/id #edb/ref 17592186356269}] :answer-field/correct {:answer/id #uuid "497c9287-8527-5f28-9070-29d5455ff937" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,0,0)" :db/id #edb/ref 17592186355315} :answer-field/id #uuid "8196235b-25ca-50fc-919f-d7ee8e52fb0e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357148}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d2cfd332-5d5c-5209-92ee-4f9962118084" :question/math-academy-id "q-94496" :question/problem "What is the trace in the $xy$-plane of the elliptic cone $9(x-2)^{2}+2{y}^{2}=18{z}^{2}\\,?$" :question/worked-solution "To find the trace in the $xy$-plane, we substitute $z=0$ into the equation of the elliptic cone, as follows:\n\n$$\n\\begin{aligned}9(x-2)^{2}+2{y}^{2}=18(0)^{2} \\\\ 9(x-2)^{2}+2{y}^{2}=0\\end{aligned}\n$$\n\nThis gives in the $xy$-plane the point $(2,0,0).$"}] [{:db/id #edb/ref 17592186360456 :knowledge-point/_questions [{:db/id #edb/ref 17592186124585 :knowledge-point/id #uuid "2e0b4012-403b-5739-8f33-3c79111129fd" :knowledge-point/title "Identifying Properties of Elliptic Cones"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0650a61f-1833-551f-963e-0f0360ef7024" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,7,1)" :db/id #edb/ref 17592186357806} {:answer/id #uuid "0fbf3827-6366-5026-b723-9a3bbaf8563f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,0,0)" :db/id #edb/ref 17592186357881} {:answer/id #uuid "1a32a1ce-802a-5a3a-b770-1b70ac55a3f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-7,-3,-21)" :db/id #edb/ref 17592186357981} {:answer/id #uuid "26fe963f-b933-5144-8db1-04ff60094da5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(7,3,21)" :db/id #edb/ref 17592186358105} {:answer/id #uuid "df3e37bf-7d9b-545e-ad23-1182091e4d75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,0,1)" :db/id #edb/ref 17592186359711}] :answer-field/correct {:answer/id #uuid "0fbf3827-6366-5026-b723-9a3bbaf8563f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,0,0)" :db/id #edb/ref 17592186357881} :answer-field/id #uuid "994f6764-7a7f-5a80-abf3-8dbc68be7534" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360258}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1a38f092-f79f-5bb1-8542-be84baf6acc6" :question/math-academy-id "q-94602" :question/problem "Find the center of the elliptic cone $7{x}^{2}+3{y}^{2}=21{z}^{2}.$" :question/worked-solution "The general equation of an elliptic cone with center at the point $({x}_{0},{y}_{0},{z}_{0})$ is\n\n$$\n\\frac{(x-{x}_{0})^{2}}{{a}^{2}}+\\frac{(y-{y}_{0})^{2}}{{b}^{2}}=\\frac{(z-{z}_{0})^{2}}{{c}^{2}}.\n$$\n\nTo find the center, we rewrite our equation in standard form, as follows:\n\n$$\n\\begin{aligned}7(x-0)^{2}+3(y-0)^{2} & =21(z-0)^{2} \\\\ \\frac{(x-0)^{2}}{1/7}+\\frac{(y-0)^{2}}{1/3} & =\\frac{(z-0)^{2}}{1/21}\\end{aligned}\n$$\n\nThis gives us the equation of an elliptic cone that has its center at $(0,0,0).$"}] [{:db/id #edb/ref 17592186360457 :knowledge-point/_questions [{:db/id #edb/ref 17592186124585 :knowledge-point/id #uuid "2e0b4012-403b-5739-8f33-3c79111129fd" :knowledge-point/title "Identifying Properties of Elliptic Cones"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40ff87ce-824f-5a36-bdfa-307092e26a8a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,2,0)$ only" :db/id #edb/ref 17592186358303} {:answer/id #uuid "461c8e18-6ee1-5d38-a759-3123cd1cf73d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,1.5,0)$ and $(0,4,0)$" :db/id #edb/ref 17592186358351} {:answer/id #uuid "549f0371-debb-5978-8769-a4f572178f99" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0,0)$ only" :db/id #edb/ref 17592186358482} {:answer/id #uuid "772bab8b-e6d1-5916-9adc-43faec42f169" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0,0)$ and $(0,4,0)$" :db/id #edb/ref 17592186358778} {:answer/id #uuid "d5482924-f2e8-5ef9-bece-62dcf6378eea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,1.5,0)$ only" :db/id #edb/ref 17592186359621}] :answer-field/correct {:answer/id #uuid "549f0371-debb-5978-8769-a4f572178f99" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0,0)$ only" :db/id #edb/ref 17592186358482} :answer-field/id #uuid "d22e66f5-154d-5bf3-8923-4635e1cff385" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360354}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "31a259dc-025a-58e8-9817-a723f9ec881c" :question/math-academy-id "q-94603" :question/problem "Given the elliptic cone $\\frac{{x}^{2}}{8}+\\frac{{y}^{2}}{4}=\\frac{{z}^{2}}{2},$ find its intercepts with the $y$-axis." :question/worked-solution "To find the $y$-intercepts of the elliptic cone, we plug $x=0$ and $z=0$ into the equation and solve for $y:$\n\n$$\n\\begin{aligned}\\frac{{0}^{2}}{8}+\\frac{{y}^{2}}{4} & =\\frac{{0}^{2}}{2} \\\\ 0+\\frac{{y}^{2}}{4} & =0 \\\\ \\frac{{y}^{2}}{4} & =0 \\\\ {y}^{2} & =0 \\\\ y & =0\\end{aligned}\n$$\n\nTherefore, the intercept with the $y$-axis is $(0,0,0)$ only."}] [{:db/id #edb/ref 17592186416614 :knowledge-point/_questions [{:db/id #edb/ref 17592186124585 :knowledge-point/id #uuid "2e0b4012-403b-5739-8f33-3c79111129fd" :knowledge-point/title "Identifying Properties of Elliptic Cones"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "045932cb-4e7d-5eeb-a1bd-fd8a8b320228" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,3,-1)" :db/id #edb/ref 17592186416608} {:answer/id #uuid "3565bdc3-f252-59de-885d-0bb85488a4eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(8,12,4)" :db/id #edb/ref 17592186416609} {:answer/id #uuid "57c975a4-5dc8-50d2-a81e-558a7189251f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-6,-4,2)" :db/id #edb/ref 17592186416610} {:answer/id #uuid "6ea0ec23-f682-53e7-88fb-7469662cfac6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(6,4,-2)" :db/id #edb/ref 17592186416611} {:answer/id #uuid "fdc3119d-6815-5c0c-a167-9b6d25d35a4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,-3,1)" :db/id #edb/ref 17592186416612}] :answer-field/correct {:answer/id #uuid "6ea0ec23-f682-53e7-88fb-7469662cfac6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(6,4,-2)" :db/id #edb/ref 17592186416611} :answer-field/id #uuid "90f98d7f-bc9e-5d73-8a9b-c9601cd09a5c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186416613}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e365d16e-a317-5782-a1fd-f9a127eeaeee" :question/math-academy-id "q-94699" :question/problem "Find the center of the elliptic cone $8(x-6)^{2}+12(y-4)^{2}=4(z+2)^{2}.$" :question/worked-solution "The general equation of an elliptic cone with center at the point $({x}_{0},{y}_{0},{z}_{0})$ is\n\n$$\n\\frac{(x-{x}_{0})^{2}}{{a}^{2}}+\\frac{(y-{y}_{0})^{2}}{{b}^{2}}=\\frac{(z-{z}_{0})^{2}}{{c}^{2}}.\n$$\n\nTo find the center, we rewrite our equation in standard form, as follows:\n\n$$\n\\begin{aligned}8(x-6)^{2}+12(y-4)^{2} & =4(z+2)^{2} \\\\ \\frac{(x-6)^{2}}{1/8}+\\frac{(y-4)^{2}}{1/12} & =\\frac{(z+2)^{2}}{1/4} \\\\ \\frac{(x-6)^{2}}{1/8}+\\frac{(y-4)^{2}}{1/12} & =\\frac{(z-(-2))^{2}}{1/4}\\end{aligned}\n$$\n\nThis gives us the equation of an elliptic cone that has its center at $(6,4,-2).$"}]}
