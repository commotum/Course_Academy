,\\,x=0,1.\n$$\n\nWe can calculate the log-likelihood function as follows:\n\n$$\n\\begin{aligned}l(\\theta ) & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡({\\theta }^{{x}_{i}}(1-\\theta )^{1-{x}_{i}}) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡({\\theta }^{{x}_{i}})+\\operatorname{ln}⁡((1-\\theta )^{1-{x}_{i}}) \\\\  & ={\\sum }_{i=1}^{n}{x}_{i}\\operatorname{ln}⁡\\theta +(1-{x}_{i})\\operatorname{ln}⁡(1-\\theta ) \\\\  & =\\operatorname{ln}⁡\\theta {\\sum }_{i=1}^{n}{x}_{i}+\\operatorname{ln}⁡(1-\\theta ){\\sum }_{i=1}^{n}(1-{x}_{i}) \\\\  & =S\\operatorname{ln}⁡\\theta +(n-S)\\operatorname{ln}⁡(1-\\theta )\\end{aligned}\n$$\n\nwhere $S={\\sum }_{i=1}^{n}{x}_{i}$ is the number of successes in the sample.\n\nFinally, since there are $2$ successes in the sample, we have \n\n$$\n\\begin{aligned}l(\\theta ) & =2\\operatorname{ln}⁡\\theta +(5-2)\\operatorname{ln}⁡(1-\\theta ) \\\\  & =2\\operatorname{ln}⁡\\theta +3\\operatorname{ln}⁡(1-\\theta ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186443710 :knowledge-point/_questions [{:db/id #edb/ref 17592186192795 :knowledge-point/id #uuid "50df0342-4c06-5c50-90ae-812403a69cee" :knowledge-point/title "Log-Likelihood Functions for Binomial Random Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00ba373d-cc1a-530b-a296-6e2025248701" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "400" :db/id #edb/ref 17592186443619} {:answer/id #uuid "07e14f65-82c6-59d4-91a0-6cec2c90bfff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "385" :db/id #edb/ref 17592186443621} {:answer/id #uuid "32e49543-5cf5-59b5-be50-40b7d827aa2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "420" :db/id #edb/ref 17592186443638} {:answer/id #uuid "89d6e489-adf5-5cf8-b171-9aee8a4dc3fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "380" :db/id #edb/ref 17592186443660} {:answer/id #uuid "e7ef90ce-0ff4-5e3c-b910-fda65e0f5c04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "415" :db/id #edb/ref 17592186443690}] :answer-field/correct {:answer/id #uuid "00ba373d-cc1a-530b-a296-6e2025248701" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "400" :db/id #edb/ref 17592186443619} :answer-field/id #uuid "cb00ed38-5141-52cf-9136-8d37b807205f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186443707}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "39034469-ded2-572d-9811-0121a992e366" :question/math-academy-id "q-159890" :question/problem "Suppose ${X}_{1},{X}_{2},{X}_{3},{X}_{4}$ is an I.I.D random sample with ${X}_{i}∼B(4,\\theta )$ with unknown probability of success $\\theta .$ You're given the particular sample \n\n$$\n{x}_{1}=1,\\,{x}_{2}=2,\\,{x}_{3}=1,\\,{x}_{4}=3.\n$$\n\nThe log-likelihood function of the sample is given by\n\n$$\nl(\\theta )=\\operatorname{ln}⁡a+b\\operatorname{ln}⁡\\theta +c\\operatorname{ln}⁡(1-\\theta ).\n$$\n\nFind the value of $a+b+c.$\n\n*Hint: The probability mass function for a binomial random variable is given by*\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{4}{x}){\\theta }^{x}(1-\\theta )^{4-x},\\,x=0,1,2,3,4.\n$$" :question/worked-solution "Recall that if ${X}_{1},{X}_{2},…,{X}_{n}$ are independent and identically distributed discrete random variables with probability mass function $f(x;\\theta ),$ where $\\theta $ is an unknown parameter, then the log-likelihood function of a random sample ${x}_{1},{x}_{2},…,{x}_{n}$ is\n\n$$\n\\begin{aligned}l(\\theta ) & =\\operatorname{ln}⁡L(\\theta ) \\\\  & =\\operatorname{ln}⁡({\\prod }_{i=1}^{n}f({x}_{i},\\theta )) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(f({x}_{i},\\theta )).\\end{aligned}\n$$\n\nIn our case, we are given a sample of $n=4$ independent binomial random variables with an unknown probability of success $\\theta $ and $N=4$ as the number of trials. Therefore, the probability mass function is\n\n$$\n\\begin{aligned}f(x,\\theta ) & =(\\genfrac{}{}{0pt}{}{N}{x}){\\theta }^{x}(1-\\theta )^{N-x},\\,x=0,1,…,N \\\\  & =(\\genfrac{}{}{0pt}{}{4}{x}){\\theta }^{x}(1-\\theta )^{4-x},\\,x=0,1,2,3,4.\\end{aligned}\n$$\n\nWe can calculate the log-likelihood function as follows:\n\n$$\n\\begin{aligned}l(\\theta ) & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡((\\genfrac{}{}{0pt}{}{4}{{x}_{i}}){\\theta }^{{x}_{i}}(1-\\theta )^{4-{x}_{i}}) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{4}{{x}_{i}})+\\operatorname{ln}⁡({\\theta }^{{x}_{i}})+\\operatorname{ln}⁡((1-\\theta )^{4-{x}_{i}}) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{4}{{x}_{i}})+{\\sum }_{i=1}^{n}{x}_{i}\\operatorname{ln}⁡\\theta +{\\sum }_{i=1}^{n}(4-{x}_{i})\\operatorname{ln}⁡(1-\\theta ) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{4}{{x}_{i}})+\\operatorname{ln}⁡\\theta {\\sum }_{i=1}^{n}{x}_{i}+\\operatorname{ln}⁡(1-\\theta ){\\sum }_{i=1}^{n}(4-{x}_{i}) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{4}{{x}_{i}})+S\\operatorname{ln}⁡\\theta +(4n-S)\\operatorname{ln}⁡(1-\\theta )\\end{aligned}\n$$\n\nwhere $S={\\sum }_{i=1}^{n}{x}_{i}.$\n\nNow, note that\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{n}\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{4}{{x}_{i}}) & =\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{4}{{x}_{1}})+\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{4}{{x}_{2}})+\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{4}{{x}_{3}})+\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{4}{{x}_{4}}) \\\\  & =\\operatorname{ln}⁡({\\prod }_{i=1}^{n}(\\genfrac{}{}{0pt}{}{4}{{x}_{i}})).\\end{aligned}\n$$\n\nSo, our expression for $l(\\theta )$ becomes\n\n$$\nl(\\theta )=\\operatorname{ln}⁡({\\prod }_{i=1}^{n}(\\genfrac{}{}{0pt}{}{4}{{x}_{i}}))+S\\operatorname{ln}⁡\\theta +(4n-S)\\operatorname{ln}⁡(1-\\theta ).\n$$\n\nNow, using the sample data with $n=4,$ we have\n\n$$\n\\begin{aligned}{\\prod }_{i=1}^{n}(\\genfrac{}{}{0pt}{}{4}{{x}_{i}}) & =(\\genfrac{}{}{0pt}{}{4}{1})\\cdot (\\genfrac{}{}{0pt}{}{4}{2})\\cdot (\\genfrac{}{}{0pt}{}{4}{1})\\cdot (\\genfrac{}{}{0pt}{}{4}{3}) \\\\  & =4\\cdot 6\\cdot 4\\cdot 4 \\\\  & =384,\\end{aligned}\n$$\n\nand\n\n$$\nS=1+2+1+3=7.\n$$\n\nSubstituting the above values into our expression for $l(\\theta )$, we get\n\n$$\n\\begin{aligned}l(\\theta ) & =\\operatorname{ln}⁡(384)+7\\operatorname{ln}⁡\\theta +(4\\cdot 4-7)\\operatorname{ln}⁡(1-\\theta ) \\\\  & =\\operatorname{ln}⁡384+7\\operatorname{ln}⁡\\theta +9\\operatorname{ln}⁡(1-\\theta ).\\end{aligned}\n$$\n\nFinally,\n\n$$\na+b+c=384+7+9=400.\n$$"}] [{:db/id #edb/ref 17592186443718 :knowledge-point/_questions [{:db/id #edb/ref 17592186192795 :knowledge-point/id #uuid "50df0342-4c06-5c50-90ae-812403a69cee" :knowledge-point/title "Log-Likelihood Functions for Binomial Random Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a98c440-68b6-575b-8ef4-c721edded79e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,084" :db/id #edb/ref 17592186443641} {:answer/id #uuid "4f5a331b-060a-5a16-8b03-42447e8324e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,029" :db/id #edb/ref 17592186443647} {:answer/id #uuid "625d8f89-a7c7-5092-a6ad-ea8f0b72889f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,057" :db/id #edb/ref 17592186443653} {:answer/id #uuid "93637c4f-d62c-514b-a779-eb0ef0e60eb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "982" :db/id #edb/ref 17592186443663} {:answer/id #uuid "94519370-0c28-59dc-bc52-6f17306f1892" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "948" :db/id #edb/ref 17592186443664}] :answer-field/correct {:answer/id #uuid "625d8f89-a7c7-5092-a6ad-ea8f0b72889f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,057" :db/id #edb/ref 17592186443653} :answer-field/id #uuid "a5ebfda0-c699-5d31-9e1a-8c1a1852116a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186443705}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a772fd34-b53c-57c2-a042-bacdd3f39061" :question/math-academy-id "q-159893" :question/problem "Suppose ${X}_{1},{X}_{2},{X}_{3},{X}_{4}$ is an I.I.D random sample with ${X}_{i}∼B(7,\\theta )$ with unknown probability of success $\\theta .$ You're given the particular sample \n\n$$\n{x}_{1}=6,\\,{x}_{2}=1,\\,{x}_{3}=2,\\,{x}_{4}=7.\n$$\n\nThe log-likelihood function of the sample is given by\n\n$$\nl(\\theta )=\\operatorname{ln}⁡a+b\\operatorname{ln}⁡\\theta +c\\operatorname{ln}⁡(1-\\theta ).\n$$\n\nFind the value of $a+b+c.$\n\n*Hint: The probability mass function for a binomial random variable is given by*\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{7}{x}){\\theta }^{x}(1-\\theta )^{7-x},\\,x=0,1,…,7.\n$$" :question/worked-solution "Recall that if ${X}_{1},{X}_{2},…,{X}_{n}$ are independent and identically distributed discrete random variables with probability mass function $f(x;\\theta ),$ where $\\theta $ is an unknown parameter, then the log-likelihood function of a random sample ${x}_{1},{x}_{2},…,{x}_{n}$ is\n\n$$\n\\begin{aligned}l(\\theta ) & =\\operatorname{ln}⁡L(\\theta ) \\\\  & =\\operatorname{ln}⁡({\\prod }_{i=1}^{n}f({x}_{i},\\theta )) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(f({x}_{i},\\theta )).\\end{aligned}\n$$\n\nIn our case, we are given a sample of $n=4$ independent binomial random variables with an unknown probability of success $\\theta $ and $N=7$ as the number of trials. Therefore, the probability mass function is\n\n$$\n\\begin{aligned}f(x,\\theta ) & =(\\genfrac{}{}{0pt}{}{N}{x}){\\theta }^{x}(1-\\theta )^{N-x},\\,x=0,1,…,N \\\\  & =(\\genfrac{}{}{0pt}{}{7}{x}){\\theta }^{x}(1-\\theta )^{7-x},\\,x=0,1,…,7.\\end{aligned}\n$$\n\nWe can calculate the log-likelihood function as follows:\n\n$$\n\\begin{aligned}l(\\theta ) & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡((\\genfrac{}{}{0pt}{}{7}{{x}_{i}}){\\theta }^{{x}_{i}}(1-\\theta )^{7-{x}_{i}}) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{7}{{x}_{i}})+\\operatorname{ln}⁡({\\theta }^{{x}_{i}})+\\operatorname{ln}⁡((1-\\theta )^{7-{x}_{i}}) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{7}{{x}_{i}})+{\\sum }_{i=1}^{n}{x}_{i}\\operatorname{ln}⁡\\theta +{\\sum }_{i=1}^{n}(7-{x}_{i})\\operatorname{ln}⁡(1-\\theta ) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{7}{{x}_{i}})+\\operatorname{ln}⁡\\theta {\\sum }_{i=1}^{n}{x}_{i}+\\operatorname{ln}⁡(1-\\theta ){\\sum }_{i=1}^{n}(7-{x}_{i}) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{7}{{x}_{i}})+S\\operatorname{ln}⁡\\theta +(7n-S)\\operatorname{ln}⁡(1-\\theta )\\end{aligned}\n$$\n\nwhere $S={\\sum }_{i=1}^{n}{x}_{i}.$\n\nNow, note that\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{n}\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{7}{{x}_{i}}) & =\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{7}{{x}_{1}})+\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{7}{{x}_{2}})+\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{7}{{x}_{3}})+\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{7}{{x}_{4}}) \\\\  & =\\operatorname{ln}⁡({\\prod }_{i=1}^{n}(\\genfrac{}{}{0pt}{}{7}{{x}_{i}})).\\end{aligned}\n$$\n\nSo, our expression for $l(\\theta )$ becomes\n\n$$\nl(\\theta )=\\operatorname{ln}⁡({\\prod }_{i=1}^{n}(\\genfrac{}{}{0pt}{}{7}{{x}_{i}}))+S\\operatorname{ln}⁡\\theta +(7n-S)\\operatorname{ln}⁡(1-\\theta ).\n$$\n\nNow, using the sample data with $n=4,$ we have\n\n$$\n\\begin{aligned}{\\prod }_{i=1}^{n}(\\genfrac{}{}{0pt}{}{7}{{x}_{i}}) & =(\\genfrac{}{}{0pt}{}{7}{6})\\cdot (\\genfrac{}{}{0pt}{}{7}{1})\\cdot (\\genfrac{}{}{0pt}{}{7}{2})\\cdot (\\genfrac{}{}{0pt}{}{7}{7}) \\\\  & =7\\cdot 7\\cdot 21\\cdot 1 \\\\  & =1\\,029,\\end{aligned}\n$$\n\nand\n\n$$\nS=6+1+2+7=16.\n$$\n\nSubstituting the above values into our expression for $l(\\theta )$, we get\n\n$$\n\\begin{aligned}l(\\theta ) & =\\operatorname{ln}⁡(1\\,029)+16\\operatorname{ln}⁡\\theta +(7\\cdot 4-16)\\operatorname{ln}⁡(1-\\theta ) \\\\  & =\\operatorname{ln}⁡1\\,029+16\\operatorname{ln}⁡\\theta +12\\operatorname{ln}⁡(1-\\theta ).\\end{aligned}\n$$\n\nFinally,\n\n$$\na+b+c=1\\,029+16+12=1\\,057.\n$$"}] [{:db/id #edb/ref 17592186443721 :knowledge-point/_questions [{:db/id #edb/ref 17592186192795 :knowledge-point/id #uuid "50df0342-4c06-5c50-90ae-812403a69cee" :knowledge-point/title "Log-Likelihood Functions for Binomial Random Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02fad1fd-00fb-56f2-aaac-9305fb048262" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "392" :db/id #edb/ref 17592186443620} {:answer/id #uuid "34a2d95b-db4c-582b-b047-b5d2003afc20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "386" :db/id #edb/ref 17592186443639} {:answer/id #uuid "8d3c56d8-29ac-57f4-99fd-0dd9de89d063" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "412" :db/id #edb/ref 17592186443661} {:answer/id #uuid "97d020dd-5432-5417-b614-39723c95696e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "404" :db/id #edb/ref 17592186443666} {:answer/id #uuid "c5fd872d-6b2f-555e-a4c0-ca31c54f4840" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "408" :db/id #edb/ref 17592186443681}] :answer-field/correct {:answer/id #uuid "c5fd872d-6b2f-555e-a4c0-ca31c54f4840" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "408" :db/id #edb/ref 17592186443681} :answer-field/id #uuid "99390f67-0220-5a26-b39c-6b99ee5db62a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186443702}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ca066a36-cc0e-5545-b489-303cc36ed2ab" :question/math-academy-id "q-159896" :question/problem "Suppose ${X}_{1},{X}_{2},…,{X}_{6}$ is an I.I.D random sample with ${X}_{i}∼B(4,\\theta )$ with unknown probability of success $\\theta .$ You're given the particular sample \n\n$$\n{x}_{1}=1,\\,{x}_{2}=2,\\,{x}_{3}=3,\\,{x}_{4}=4,\\,{x}_{5}=4,\\,{x}_{6}=3.\n$$\n\nThe log-likelihood function of the sample is given by\n\n$$\nl(\\theta )=\\operatorname{ln}⁡a+b\\operatorname{ln}⁡\\theta +c\\operatorname{ln}⁡(1-\\theta ).\n$$\n\nFind the value of $a+b+c.$" :question/worked-solution "Recall that if ${X}_{1},{X}_{2},…,{X}_{n}$ are independent and identically distributed discrete random variables with probability mass function $f(x;\\theta ),$ where $\\theta $ is an unknown parameter, then the log-likelihood function of a random sample ${x}_{1},{x}_{2},…,{x}_{n}$ is\n\n$$\n\\begin{aligned}l(\\theta ) & =\\operatorname{ln}⁡L(\\theta ) \\\\  & =\\operatorname{ln}⁡({\\prod }_{i=1}^{n}f({x}_{i},\\theta )) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(f({x}_{i},\\theta )).\\end{aligned}\n$$\n\nIn our case, we are given a sample of $n=6$ independent binomial random variables with an unknown probability of success $\\theta $ and $N=4$ as the number of trials. Therefore, the probability mass function is\n\n$$\n\\begin{aligned}f(x,\\theta ) & =(\\genfrac{}{}{0pt}{}{N}{x}){\\theta }^{x}(1-\\theta )^{N-x},\\,x=0,1,…,N \\\\  & =(\\genfrac{}{}{0pt}{}{4}{x}){\\theta }^{x}(1-\\theta )^{4-x},\\,x=0,1,…,4.\\end{aligned}\n$$\n\nWe can calculate the log-likelihood function as follows:\n\n$$\n\\begin{aligned}l(\\theta ) & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡((\\genfrac{}{}{0pt}{}{4}{{x}_{i}}){\\theta }^{{x}_{i}}(1-\\theta )^{4-{x}_{i}}) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{4}{{x}_{i}})+\\operatorname{ln}⁡({\\theta }^{{x}_{i}})+\\operatorname{ln}⁡((1-\\theta )^{4-{x}_{i}}) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{4}{{x}_{i}})+{\\sum }_{i=1}^{n}{x}_{i}\\operatorname{ln}⁡\\theta +{\\sum }_{i=1}^{n}(4-{x}_{i})\\operatorname{ln}⁡(1-\\theta ) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{4}{{x}_{i}})+\\operatorname{ln}⁡\\theta {\\sum }_{i=1}^{n}{x}_{i}+\\operatorname{ln}⁡(1-\\theta ){\\sum }_{i=1}^{n}(4-{x}_{i}) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{4}{{x}_{i}})+S\\operatorname{ln}⁡\\theta +(4n-S)\\operatorname{ln}⁡(1-\\theta )\\end{aligned}\n$$\n\nwhere $S={\\sum }_{i=1}^{n}{x}_{i}.$\n\nNow, note that\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{n}\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{4}{{x}_{i}}) & =\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{4}{{x}_{1}})+\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{4}{{x}_{2}})+\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{4}{{x}_{3}})+\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{4}{{x}_{4}})+\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{4}{{x}_{5}})+\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{4}{{x}_{6}}) \\\\  & =\\operatorname{ln}⁡({\\prod }_{i=1}^{n}(\\genfrac{}{}{0pt}{}{4}{{x}_{i}})).\\end{aligned}\n$$\n\nSo, our expression for $l(\\theta )$ becomes\n\n$$\nl(\\theta )=\\operatorname{ln}⁡({\\prod }_{i=1}^{n}(\\genfrac{}{}{0pt}{}{4}{{x}_{i}}))+S\\operatorname{ln}⁡\\theta +(4n-S)\\operatorname{ln}⁡(1-\\theta ).\n$$\n\nNow, using the sample data with $n=6,$ we have\n\n$$\n\\begin{aligned}{\\prod }_{i=1}^{n}(\\genfrac{}{}{0pt}{}{4}{{x}_{i}}) & =(\\genfrac{}{}{0pt}{}{4}{1})\\cdot (\\genfrac{}{}{0pt}{}{4}{2})\\cdot (\\genfrac{}{}{0pt}{}{4}{3})\\cdot (\\genfrac{}{}{0pt}{}{4}{4})\\cdot (\\genfrac{}{}{0pt}{}{4}{4})\\cdot (\\genfrac{}{}{0pt}{}{4}{3}) \\\\  & =4\\cdot 6\\cdot 4\\cdot 1\\cdot 1\\cdot 4 \\\\  & =384,\\end{aligned}\n$$\n\nand\n\n$$\nS=1+2+3+4+4+3=17.\n$$\n\nSubstituting the above values into our expression for $l(\\theta )$, we get\n\n$$\n\\begin{aligned}l(\\theta ) & =\\operatorname{ln}⁡(384)+17\\operatorname{ln}⁡\\theta +(4\\cdot 6-17)\\operatorname{ln}⁡(1-\\theta ) \\\\  & =\\operatorname{ln}⁡(384)+17\\operatorname{ln}⁡\\theta +7\\operatorname{ln}⁡(1-\\theta ).\\end{aligned}\n$$\n\nFinally,\n\n$$\na+b+c=384+17+7=408.\n$$"}] [{:db/id #edb/ref 17592186443712 :knowledge-point/_questions [{:db/id #edb/ref 17592186192795 :knowledge-point/id #uuid "50df0342-4c06-5c50-90ae-812403a69cee" :knowledge-point/title "Log-Likelihood Functions for Binomial Random Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19bf218d-db13-510f-87f9-55163f8181f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "89" :db/id #edb/ref 17592186443628} {:answer/id #uuid "a4dc0644-cb20-5de3-8060-1da6759e8d4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "97" :db/id #edb/ref 17592186443670} {:answer/id #uuid "b134442c-59be-5c1f-b114-5798cbec57bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "111" :db/id #edb/ref 17592186443677} {:answer/id #uuid "d83abe2d-fdfb-5fae-8a4e-a8d17936fe98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "108" :db/id #edb/ref 17592186443687} {:answer/id #uuid "f1441d25-5e60-5d9d-86dc-8d65cd6ea506" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "94" :db/id #edb/ref 17592186443691}] :answer-field/correct {:answer/id #uuid "d83abe2d-fdfb-5fae-8a4e-a8d17936fe98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "108" :db/id #edb/ref 17592186443687} :answer-field/id #uuid "f05c59ec-e7dc-5ed7-9912-91abcb45f958" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186443708}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4f0ef3b3-16ee-5e79-a46a-c889944b927a" :question/math-academy-id "q-159899" :question/problem "Suppose ${X}_{1},{X}_{2},{X}_{3}$ is an I.I.D random sample with ${X}_{i}∼B(6,\\theta )$ with unknown probability of success $\\theta .$ You're given the particular sample \n\n$$\n{x}_{1}=2,\\,{x}_{2}=5,\\,{x}_{3}=6.\n$$\n\nThe log-likelihood function of the sample is given by\n\n$$\nl(\\theta )=\\operatorname{ln}⁡a+b\\operatorname{ln}⁡\\theta +c\\operatorname{ln}⁡(1-\\theta ).\n$$\n\nFind the value of $a+b+c.$" :question/worked-solution "Recall that if ${X}_{1},{X}_{2},…,{X}_{n}$ are independent and identically distributed discrete random variables with probability mass function $f(x;\\theta ),$ where $\\theta $ is an unknown parameter, then the log-likelihood function of a random sample ${x}_{1},{x}_{2},…,{x}_{n}$ is\n\n$$\n\\begin{aligned}l(\\theta ) & =\\operatorname{ln}⁡L(\\theta ) \\\\  & =\\operatorname{ln}⁡({\\prod }_{i=1}^{n}f({x}_{i},\\theta )) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(f({x}_{i},\\theta )).\\end{aligned}\n$$\n\nIn our case, we are given a sample of $n=3$ independent binomial random variables with an unknown probability of success $\\theta $ and $N=6$ as the number of trials. Therefore, the probability mass function is\n\n$$\n\\begin{aligned}f(x,\\theta ) & =(\\genfrac{}{}{0pt}{}{N}{x}){\\theta }^{x}(1-\\theta )^{N-x},\\,x=0,1,…,N \\\\  & =(\\genfrac{}{}{0pt}{}{6}{x}){\\theta }^{x}(1-\\theta )^{6-x},\\,x=0,1,…,6.\\end{aligned}\n$$\n\nWe can calculate the log-likelihood function as follows:\n\n$$\n\\begin{aligned}l(\\theta ) & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡((\\genfrac{}{}{0pt}{}{6}{{x}_{i}}){\\theta }^{{x}_{i}}(1-\\theta )^{6-{x}_{i}}) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{6}{{x}_{i}})+\\operatorname{ln}⁡({\\theta }^{{x}_{i}})+\\operatorname{ln}⁡((1-\\theta )^{6-{x}_{i}}) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{6}{{x}_{i}})+{\\sum }_{i=1}^{n}{x}_{i}\\operatorname{ln}⁡\\theta +{\\sum }_{i=1}^{n}(6-{x}_{i})\\operatorname{ln}⁡(1-\\theta ) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{6}{{x}_{i}})+\\operatorname{ln}⁡\\theta {\\sum }_{i=1}^{n}{x}_{i}+\\operatorname{ln}⁡(1-\\theta ){\\sum }_{i=1}^{n}(6-{x}_{i}) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{6}{{x}_{i}})+S\\operatorname{ln}⁡\\theta +(6n-S)\\operatorname{ln}⁡(1-\\theta )\\end{aligned}\n$$\n\nwhere $S={\\sum }_{i=1}^{n}{x}_{i}.$\n\nNow, note that\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{n}\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{6}{{x}_{i}}) & =\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{6}{{x}_{1}})+\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{6}{{x}_{2}})+\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{6}{{x}_{3}}) \\\\  & =\\operatorname{ln}⁡({\\prod }_{i=1}^{n}(\\genfrac{}{}{0pt}{}{6}{{x}_{i}})).\\end{aligned}\n$$\n\nSo, our expression for $l(\\theta )$ becomes\n\n$$\nl(\\theta )=\\operatorname{ln}⁡({\\prod }_{i=1}^{n}(\\genfrac{}{}{0pt}{}{6}{{x}_{i}}))+S\\operatorname{ln}⁡\\theta +(6n-S)\\operatorname{ln}⁡(1-\\theta ).\n$$\n\nNow, using the sample data with $n=3,$ we have\n\n$$\n\\begin{aligned}{\\prod }_{i=1}^{n}(\\genfrac{}{}{0pt}{}{6}{{x}_{i}}) & =(\\genfrac{}{}{0pt}{}{6}{2})\\cdot (\\genfrac{}{}{0pt}{}{6}{5})\\cdot (\\genfrac{}{}{0pt}{}{6}{6}) \\\\  & =15\\cdot 6\\cdot 1 \\\\  & =90,\\end{aligned}\n$$\n\nand\n\n$$\nS=2+5+6=13.\n$$\n\nSubstituting the above values into our expression for $l(\\theta )$, we get\n\n$$\n\\begin{aligned}l(\\theta ) & =\\operatorname{ln}⁡(90)+13\\operatorname{ln}⁡\\theta +(6\\cdot 3-13)\\operatorname{ln}⁡(1-\\theta ) \\\\  & =\\operatorname{ln}⁡(90)+13\\operatorname{ln}⁡\\theta +5\\operatorname{ln}⁡(1-\\theta ).\\end{aligned}\n$$\n\nFinally,\n\n$$\na+b+c=90+13+5=108.\n$$"}] [{:db/id #edb/ref 17592186443719 :knowledge-point/_questions [{:db/id #edb/ref 17592186192795 :knowledge-point/id #uuid "50df0342-4c06-5c50-90ae-812403a69cee" :knowledge-point/title "Log-Likelihood Functions for Binomial Random Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2894825b-6a43-5769-8dc0-c8fc5328c196" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "128" :db/id #edb/ref 17592186443634} {:answer/id #uuid "41537903-4d50-5d6d-bc3d-e57fd2c9c872" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "137" :db/id #edb/ref 17592186443643} {:answer/id #uuid "a6ced6e0-f97e-5c2c-9cc2-8f7ae6c7d108" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "115" :db/id #edb/ref 17592186443671} {:answer/id #uuid "a8020f1a-ca93-54d7-ad54-028ee4af07b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "105" :db/id #edb/ref 17592186443672} {:answer/id #uuid "d0478cc5-b8ff-5c81-a9e5-c9721f21e934" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "120" :db/id #edb/ref 17592186443685}] :answer-field/correct {:answer/id #uuid "a6ced6e0-f97e-5c2c-9cc2-8f7ae6c7d108" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "115" :db/id #edb/ref 17592186443671} :answer-field/id #uuid "33039f95-3064-5de3-9d9f-d7b2dc9361eb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186443697}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "aac7d9dd-e1f6-55a0-8d3e-a363440ea2a6" :question/math-academy-id "q-159902" :question/problem "Suppose ${X}_{1},{X}_{2},{X}_{3}$ is an I.I.D random sample with ${X}_{i}∼B(5,\\theta )$ with unknown probability of success $\\theta .$ You're given the particular sample \n\n$$\n{x}_{1}=5,\\,{x}_{2}=3,\\,{x}_{3}=2.\n$$\n\nThe log-likelihood function of the sample is given by\n\n$$\nl(\\theta )=\\operatorname{ln}⁡a+b\\operatorname{ln}⁡\\theta +c\\operatorname{ln}⁡(1-\\theta ).\n$$\n\nFind the value of $a+b+c.$" :question/worked-solution "Recall that if ${X}_{1},{X}_{2},…,{X}_{n}$ are independent and identically distributed discrete random variables with probability mass function $f(x;\\theta ),$ where $\\theta $ is an unknown parameter, then the log-likelihood function of a random sample ${x}_{1},{x}_{2},…,{x}_{n}$ is\n\n$$\n\\begin{aligned}l(\\theta ) & =\\operatorname{ln}⁡L(\\theta ) \\\\  & =\\operatorname{ln}⁡({\\prod }_{i=1}^{n}f({x}_{i},\\theta )) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(f({x}_{i},\\theta )).\\end{aligned}\n$$\n\nIn our case, we are given a sample of $n=3$ independent binomial random variables with an unknown probability of success $\\theta $ and $N=5$ as the number of trials. Therefore, the probability mass function is\n\n$$\n\\begin{aligned}f(x,\\theta ) & =(\\genfrac{}{}{0pt}{}{N}{x}){\\theta }^{x}(1-\\theta )^{N-x},\\,x=0,1,…,N \\\\  & =(\\genfrac{}{}{0pt}{}{5}{x}){\\theta }^{x}(1-\\theta )^{5-x},\\,x=0,1,…,5.\\end{aligned}\n$$\n\nWe can calculate the log-likelihood function as follows:\n\n$$\n\\begin{aligned}l(\\theta ) & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡((\\genfrac{}{}{0pt}{}{5}{{x}_{i}}){\\theta }^{{x}_{i}}(1-\\theta )^{5-{x}_{i}}) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{5}{{x}_{i}})+\\operatorname{ln}⁡({\\theta }^{{x}_{i}})+\\operatorname{ln}⁡((1-\\theta )^{5-{x}_{i}}) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{5}{{x}_{i}})+{\\sum }_{i=1}^{n}{x}_{i}\\operatorname{ln}⁡\\theta +{\\sum }_{i=1}^{n}(5-{x}_{i})\\operatorname{ln}⁡(1-\\theta ) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{5}{{x}_{i}})+\\operatorname{ln}⁡\\theta {\\sum }_{i=1}^{n}{x}_{i}+\\operatorname{ln}⁡(1-\\theta ){\\sum }_{i=1}^{n}(5-{x}_{i}) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{5}{{x}_{i}})+S\\operatorname{ln}⁡\\theta +(5n-S)\\operatorname{ln}⁡(1-\\theta )\\end{aligned}\n$$\n\nwhere $S={\\sum }_{i=1}^{n}{x}_{i}.$\n\nNow, note that\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{n}\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{5}{{x}_{i}}) & =\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{5}{{x}_{1}})+\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{5}{{x}_{2}})+\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{5}{{x}_{3}}) \\\\  & =\\operatorname{ln}⁡({\\prod }_{i=1}^{n}(\\genfrac{}{}{0pt}{}{5}{{x}_{i}})).\\end{aligned}\n$$\n\nSo, our expression for $l(\\theta )$ becomes\n\n$$\nl(\\theta )=\\operatorname{ln}⁡({\\prod }_{i=1}^{n}(\\genfrac{}{}{0pt}{}{5}{{x}_{i}}))+S\\operatorname{ln}⁡\\theta +(5n-S)\\operatorname{ln}⁡(1-\\theta ).\n$$\n\nNow, using the sample data with $n=3,$ we have\n\n$$\n\\begin{aligned}{\\prod }_{i=1}^{n}(\\genfrac{}{}{0pt}{}{5}{{x}_{i}}) & =(\\genfrac{}{}{0pt}{}{5}{5})\\cdot (\\genfrac{}{}{0pt}{}{5}{3})\\cdot (\\genfrac{}{}{0pt}{}{5}{2}) \\\\  & =1\\cdot 10\\cdot 10 \\\\  & =100,\\end{aligned}\n$$\n\nand\n\n$$\nS=5+3+2=10.\n$$\n\nSubstituting the above values into our expression for $l(\\theta )$, we get\n\n$$\n\\begin{aligned}l(\\theta ) & =\\operatorname{ln}⁡(100)+10\\operatorname{ln}⁡\\theta +(5\\cdot 3-10)\\operatorname{ln}⁡(1-\\theta ) \\\\  & =\\operatorname{ln}⁡(100)+10\\operatorname{ln}⁡\\theta +5\\operatorname{ln}⁡(1-\\theta ).\\end{aligned}\n$$\n\nFinally,\n\n$$\na+b+c=100+10+5=115.\n$$"}]}
