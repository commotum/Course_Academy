/ref 17592186162599 :knowledge-point/_questions [{:db/id #edb/ref 17592186161988 :knowledge-point/id #uuid "611af093-6621-5224-af2a-f769c7c0e691" :knowledge-point/title "Orthogonally Diagonalizing a 3x3 Matrix With Distinct Eigenvalues"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9f359230-5dd7-543c-9ebc-cf61d94d8b14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2}{3} \\\\ \\frac{1}{3} \\\\ \\frac{2}{3}\\end{bmatrix}" :db/id #edb/ref 17592186160887} {:answer/id #uuid "abcb9ae3-896b-55d1-a8ac-7623e85914c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{\\sqrt{2}}{2} \\\\ 0 \\\\ \\frac{\\sqrt{2}}{2}\\end{bmatrix}" :db/id #edb/ref 17592186160888} {:answer/id #uuid "b25fd612-fef8-5461-9980-7b2abafe1fa2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186160889} {:answer/id #uuid "d18208a6-ec23-5f48-9a3c-fefa095db12f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{\\sqrt{3}}{3} \\\\ \\frac{\\sqrt{3}}{3} \\\\ \\frac{\\sqrt{3}}{3}\\end{bmatrix}" :db/id #edb/ref 17592186160890} {:answer/id #uuid "567f9934-f45c-5a0c-9ecb-99fba8d3afd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{\\sqrt{3}}{3} \\\\ \\frac{\\sqrt{3}}{3} \\\\ -\\frac{\\sqrt{3}}{3}\\end{bmatrix}" :db/id #edb/ref 17592186160891}] :answer-field/id #uuid "7b62c2ac-065d-54c9-abdd-bbf6c6966cb2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186160886}] :question/id #uuid "474fce27-4b23-5be8-8b2d-389558be5e18" :question/math-academy-id "q-93727" :question/problem "$A = \\begin{bmatrix}-2 & 1 & 1 \\\\ 1 & -2 & 1 \\\\ 1 & 1 & -2\\end{bmatr