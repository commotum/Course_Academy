#{[{:db/id #edb/ref 17592186124398 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186124587 :knowledge-point/id #uuid "36c5224a-eccc-5ea9-8719-2b0dc2ddb44d" :knowledge-point/title "The Domain of a Cylinder"}] :question/id #uuid "0cb849bd-8a9f-5305-b086-62da1a10e54f" :question/math-academy-id "e-8226" :question/problem "What is the domain in the $xy$-plane of the elliptic cylinder $\\dfrac{x^2}{9} + (y+1)^2 = 1?$" :question/worked-solution "The full expression describing all points on our elliptic cylinder is\n\n$$\n\\dfrac{x^2}{9} + (y+1)^2 = 1, \\qquad z=k\n$$\n\nwhere $k \\in \\mathbb{R}$ can vary arbitrarily. \n\nThe domain of any cylinder in the $xy$-plane is its base curve. Hence, in this case, the domain is\n\n$$\n\\left\\{(x,y) \\in \\mathbb{R}^2 : \\dfrac{x^2}{9} + (y+1)^2 = 1\\right\\}\n$$\n\nwhich can be written as\n\n$$\n\\left\\{ (x,y) \\in \\mathbb{R}^2 : \\dfrac{x^2}{3^2} + \\dfrac{(y+1)^2}{1^2} = 1\\right\\}.\n$$\n\nThis is an ellipse centered at $(0,-1)$ with semi-axes of lengths $3$ and $1.$"}] [{:db/id #edb/ref 17592186124399 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186124588 :knowledge-point/id #uuid "abbeda26-2fc0-5195-be26-ae79c72fc7bf" :knowledge-point/title "Traces of Cylinders"}] :question/id #uuid "64fc4653-a2ba-5013-8c70-1f4f14e5f8be" :question/math-academy-id "e-8227" :question/problem "What is the trace in the $yz$-plane of the elliptic cylinder $\\dfrac {x^2} 2 +  \\dfrac {(y-2)^2}4  = 1?$" :question/worked-solution "To find the trace in the $yz$-plane, we substitute $x=0$ into the equation of the cylinder, and simplify:\n\n$$\n\\begin{aligned}\\frac{{0}^{2}}{2}+\\frac{(y-2)^{2}}{4} & =1 \\\\ (y-2)^{2} & =4 \\\\ y-2 & =\\pm 2 \\\\ y & =2\\pm 2 \\\\ y & =0,4\\end{aligned}\n$$\n\nThis gives us the equation of two lines $y=0$ and $y=4$ in the $yz$-plane."}] [{:db/id #edb/ref 17592186284480 :knowledge-point/_questions [{:db/id #edb/ref 17592186124588 :knowledge-point/id #uuid "abbeda26-2fc0-5195-be26-ae79c72fc7bf" :knowledge-point/title "Traces of Cylinders"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b87c134-c3ab-5cd7-a71d-942f9023b590" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The lines $y=-8$ and $y=6$" :db/id #edb/ref 17592186281941} {:answer/id #uuid "410fe8c9-71a3-56d8-b265-a64661bc0db7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The ellipse $\\frac{(y+1)^{2}}{7}+\\frac{{z}^{2}}{2}=1$" :db/id #edb/ref 17592186282247} {:answer/id #uuid "4c8cded8-bf1b-5f03-9688-f13988f0f873" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The line $y=6$" :db/id #edb/ref 17592186282348} {:answer/id #uuid "77204589-c1c4-55d0-8d32-6cfd9a45831b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The line $y=-1$" :db/id #edb/ref 17592186282707} {:answer/id #uuid "e17bb4b8-9c0d-50f2-9571-afc2e352cee6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The hyperbola $\\frac{(y+1)^{2}}{7}-{z}^{2}=1$" :db/id #edb/ref 17592186283653}] :answer-field/correct {:answer/id #uuid "1b87c134-c3ab-5cd7-a71d-942f9023b590" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The lines $y=-8$ and $y=6$" :db/id #edb/ref 17592186281941} :answer-field/id #uuid "ac12174a-0b6d-57cc-893b-380288b573c4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284233}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ed51767d-9824-5d39-b6b6-e61b0eec9664" :question/math-academy-id "q-164397" :question/problem "What is the trace in the $yz$-plane of the hyperbolic cylinder $\\frac{(x-4)^{2}}{2}-\\frac{(y+1)^{2}}{7}=1?$" :question/worked-solution "To find the trace in the $yz$-plane, we substitute $x=0$ into the equation of the cylinder, and simplify:\n\n$$\n\\begin{aligned}\\frac{(0-4)^{2}}{2}-\\frac{(y+1)^{2}}{7} & =1 \\\\ 8-\\frac{(y+1)^{2}}{7} & =1 \\\\ \\frac{(y+1)^{2}}{7} & =7 \\\\ (y+1)^{2} & =49 \\\\ y+1 & =\\pm 7 \\\\ y & =-1\\pm 7 \\\\ y & =-8,6\\end{aligned}\n$$\n\nThis gives us the equation of two lines $y=-8$ and $y=6$ in the $yz$-plane."}] [{:db/id #edb/ref 17592186401474 :knowledge-point/_questions [{:db/id #edb/ref 17592186124588 :knowledge-point/id #uuid "abbeda26-2fc0-5195-be26-ae79c72fc7bf" :knowledge-point/title "Traces of Cylinders"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ddfe34f7-e006-5620-84fe-1db6fc963651" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The line $x=4$" :db/id #edb/ref 17592186401476} {:answer/id #uuid "b838d302-7461-5223-8e33-c740bbf20ff9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The line $x=6$" :db/id #edb/ref 17592186401477} {:answer/id #uuid "161fe7ca-7c93-5282-b813-a0a45f65d7ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The lines $x=2$ and $x=6$" :db/id #edb/ref 17592186401478} {:answer/id #uuid "2cfcfb48-24ef-595a-a479-2f2b1a35f56d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The ellipse $\\frac{(x-4)^{2}}{8}+\\frac{{z}^{2}}{2}=1$" :db/id #edb/ref 17592186401479} {:answer/id #uuid "b309b4aa-316e-5e47-b444-65898ffba0f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The hyperbola $\\frac{{x}^{2}}{8}-\\frac{(z-1)^{2}}{2}=1$" :db/id #edb/ref 17592186401480}] :answer-field/correct {:answer/id #uuid "161fe7ca-7c93-5282-b813-a0a45f65d7ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The lines $x=2$ and $x=6$" :db/id #edb/ref 17592186401478} :answer-field/id #uuid "53177c21-6f8b-5255-86cb-d89db3a9a51a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401475}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "98ad452f-818a-5095-bf60-3f83ccbaae0f" :question/math-academy-id "q-164401" :question/problem "What is the trace in the $xz$-plane of the elliptic cylinder $\\frac{(x-4)^{2}}{8}+\\frac{(y-1)^{2}}{2}=1?$" :question/worked-solution "To find the trace in the $xz$-plane, we substitute $y=0$ into the equation of the cylinder, and simplify:\n\n$$\n\\begin{aligned}\\frac{(x-4)^{2}}{8}+\\frac{(0-1)^{2}}{2} & =1 \\\\ \\frac{(x-4)^{2}}{8}+\\frac{1}{2} & =1 \\\\ \\frac{(x-4)^{2}}{8} & =\\frac{1}{2} \\\\ (x-4)^{2} & =4 \\\\ x-4 & =\\pm 2 \\\\ x & =4\\pm 2 \\\\ x & =2,6\\end{aligned}\n$$\n\nThis gives us the equation of two lines $x=2$ and $x=6$ in the $xz$-plane."}] [{:db/id #edb/ref 17592186508975 :knowledge-point/_questions [{:db/id #edb/ref 17592186124588 :knowledge-point/id #uuid "abbeda26-2fc0-5195-be26-ae79c72fc7bf" :knowledge-point/title "Traces of Cylinders"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e5ab69b-2ab8-5b94-86d2-1d106a5722a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The parabola ${y}^{2}=x+4$" :db/id #edb/ref 17592186508505} {:answer/id #uuid "65bb6a4d-bacc-573d-8ac9-de1124e3b120" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The line $y=5$" :db/id #edb/ref 17592186508541} {:answer/id #uuid "6ea2ecb9-d2a8-5867-bf21-c375717be587" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The lines $y=3$ and $y=5$" :db/id #edb/ref 17592186508556} {:answer/id #uuid "a7da925a-f55d-52ac-9d41-103de4c6c2d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The line $y=4$" :db/id #edb/ref 17592186508642} {:answer/id #uuid "d573fd0d-d62b-50c0-9361-ac2dddd6713c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The parabola $(y-4)^{2}=x+1$" :db/id #edb/ref 17592186508734}] :answer-field/correct {:answer/id #uuid "6ea2ecb9-d2a8-5867-bf21-c375717be587" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The lines $y=3$ and $y=5$" :db/id #edb/ref 17592186508556} :answer-field/id #uuid "9738db51-6bb6-5a1e-9a88-9854819dcf8d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186508861}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c57b9d4a-351a-58d6-893f-d761a9a6ee5e" :question/math-academy-id "q-164404" :question/problem "What is the trace in the $xy$-plane of the parabolic cylinder $(y-4)^{2}=z+1?$" :question/worked-solution "To find the trace in the $xy$-plane, we substitute $z=0$ into the equation of the cylinder, and simplify:\n\n$$\n\\begin{aligned}(y-4)^{2} & =0+1 \\\\ (y-4)^{2} & =1 \\\\ y-4 & =\\pm 1 \\\\ y & =4\\pm 1 \\\\ y & =3,5\\end{aligned}\n$$\n\nThis gives us the equation of two lines $y=3$ and $y=5$ in the $xy$-plane."}] [{:db/id #edb/ref 17592186284486 :knowledge-point/_questions [{:db/id #edb/ref 17592186124588 :knowledge-point/id #uuid "abbeda26-2fc0-5195-be26-ae79c72fc7bf" :knowledge-point/title "Traces of Cylinders"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06aca35d-1fab-59c5-89b9-f81bb55faa18" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5$ and $2$" :db/id #edb/ref 17592186281747} {:answer/id #uuid "09e4bc6e-ba33-5a4d-bf41-1971cbd5c6c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\sqrt{5}$ and $\\sqrt{2}$" :db/id #edb/ref 17592186281775} {:answer/id #uuid "b51b3183-d38a-5aea-9cd0-99a00e1cc59d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\sqrt{2}$ and $1$" :db/id #edb/ref 17592186283260} {:answer/id #uuid "c671246d-6749-522c-9b8c-064aabc2cb6b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ and $5$" :db/id #edb/ref 17592186283417} {:answer/id #uuid "da682b70-f2d6-543d-ba02-567ab2dc0cb9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\sqrt{10}$ and $\\sqrt{5}$" :db/id #edb/ref 17592186283594}] :answer-field/correct {:answer/id #uuid "09e4bc6e-ba33-5a4d-bf41-1971cbd5c6c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\sqrt{5}$ and $\\sqrt{2}$" :db/id #edb/ref 17592186281775} :answer-field/id #uuid "d537aae5-2a22-587e-b62f-7a17ec56d1f5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284304}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f9fe7c1c-a0c0-5194-ad34-b26b4e46d994" :question/math-academy-id "q-164415" :question/problem "The projection of the intersection between the hyperbolic cylinder $2(x+6)^{2}-5{y}^{2}=10$ and the plane $z=5$ onto the $xy$-plane is a hyperbola. What are the lengths of the semi-axes of the hyperbola?" :question/worked-solution "To find the intersection of the cylinder and the plane $z=5,$ we substitute $z=5$ into the equation of the cylinder. However, since the equation has no (explicit) $z$ term, we get\n\n$$\n\\begin{aligned}2(x+6)^{2}-5{y}^{2} & =10 \\\\ \\frac{(x+6)^{2}}{5}-\\frac{{y}^{2}}{2} & =1 \\\\ \\frac{(x+6)^{2}}{(\\sqrt{5})^{2}}-\\frac{{y}^{2}}{(\\sqrt{2})^{2}} & =1.\\end{aligned}\n$$\n\nThis gives us the equation of a hyperbola with semi-axes of lengths $\\sqrt{5}$ and $\\sqrt{2}.$"}] [{:db/id #edb/ref 17592186401488 :knowledge-point/_questions [{:db/id #edb/ref 17592186124587 :knowledge-point/id #uuid "36c5224a-eccc-5ea9-8719-2b0dc2ddb44d" :knowledge-point/title "The Domain of a Cylinder"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9bf04dd9-c165-5182-ac9b-5676db24ff34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{2}" :db/id #edb/ref 17592186401490} {:answer/id #uuid "c793d63c-12e4-5933-97de-c7ed09f6bb6c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbola centered at $(0,-1)$" :db/id #edb/ref 17592186401491} {:answer/id #uuid "cb19e2aa-343d-50f8-8950-85499a932e8a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbola centered at $(1,0)$" :db/id #edb/ref 17592186401493} {:answer/id #uuid "011e26cf-a2f4-5e6c-9930-618f8d6227cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbola centered at $(0,1)$" :db/id #edb/ref 17592186401494} {:answer/id #uuid "e5818807-d65a-5f49-aebe-5e5a28895c19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}:\\text{ }x-y>12\\}" :db/id #edb/ref 17592186508755}] :answer-field/correct {:answer/id #uuid "c793d63c-12e4-5933-97de-c7ed09f6bb6c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbola centered at $(0,-1)$" :db/id #edb/ref 17592186401491} :answer-field/id #uuid "5199bacc-b680-59e5-9422-f0c044740659" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401489}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "57563ddb-cece-5702-b61c-95f3f8e1ba05" :question/math-academy-id "q-164416" :question/problem "What is the domain in the $xy$-plane of the hyperbolic cylinder $\\frac{{x}^{2}}{3}-\\frac{(y+1)^{2}}{4}=1?$" :question/worked-solution "The full expression describing all points on our hyperbolic cylinder is\n\n$$\n\\frac{{x}^{2}}{3}-\\frac{(y+1)^{2}}{4}=1,\\,z=k\n$$\n\nwhere $k\\in R$ can vary arbitrarily. \n\nThe domain of any cylinder in the $xy$-plane is its base curve. Hence, in this case, the domain is\n\n$$\n\\{(x,y)\\in {R}^{2}:\\text{ }\\frac{{x}^{2}}{3}-\\frac{(y+1)^{2}}{4}=1\\}.\n$$\n\nThis is a hyperbola centered at $(0,-1).$"}] [{:db/id #edb/ref 17592186284487 :knowledge-point/_questions [{:db/id #edb/ref 17592186124587 :knowledge-point/id #uuid "36c5224a-eccc-5ea9-8719-2b0dc2ddb44d" :knowledge-point/title "The Domain of a Cylinder"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c013777-4d72-514c-a0fd-8d90a0782594" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbola centered at $(3,-6)$" :db/id #edb/ref 17592186282468} {:answer/id #uuid "74edffe9-d8bb-5056-aa1d-1ac3715e44c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{2}" :db/id #edb/ref 17592186282687} {:answer/id #uuid "75f2c440-54b1-51d2-85c2-70e561fb7407" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbola centered at $(1,2\\sqrt{2})$" :db/id #edb/ref 17592186282697} {:answer/id #uuid "a9b2c646-22bd-5cc8-8627-13790f57f4b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbola centered at $(-3,6)$" :db/id #edb/ref 17592186283159} {:answer/id #uuid "b9fb8e6f-6307-55e5-aa75-c8d34607dc84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(x,y)\\in {R}^{2}:x\\ge 3\\}" :db/id #edb/ref 17592186508670}] :answer-field/correct {:answer/id #uuid "5c013777-4d72-514c-a0fd-8d90a0782594" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbola centered at $(3,-6)$" :db/id #edb/ref 17592186282468} :answer-field/id #uuid "1edea798-7d0a-5c0f-a8c5-3e109f5b6d60" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186283994}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9ff5d288-247e-5774-82fd-1ca9271248d5" :question/math-academy-id "q-164418" :question/problem "What is the domain in the $xy$-plane of the hyperbolic cylinder $(x-3)^{2}-\\frac{(y+6)^{2}}{8}=1?$" :question/worked-solution "The full expression describing all points on our hyperbolic cylinder is\n\n$$\n(x-3)^{2}-\\frac{(y+6)^{2}}{8}=1,\\,z=k\n$$\n\nwhere $k\\in R$ can vary arbitrarily. \n\nThe domain of any cylinder in the $xy$-plane is its base curve. Hence, in this case, the domain is\n\n$$\n\\{(x,y)\\in {R}^{2}:\\text{ }(x-3)^{2}-\\frac{(y+6)^{2}}{8}=1\\}.\n$$\n\nThis is a hyperbola centered at $(3,-6).$"}] [{:db/id #edb/ref 17592186284488 :knowledge-point/_questions [{:db/id #edb/ref 17592186124587 :knowledge-point/id #uuid "36c5224a-eccc-5ea9-8719-2b0dc2ddb44d" :knowledge-point/title "The Domain of a Cylinder"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "033490d3-3a24-528a-ab3a-a8df80b8e0d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A rightward-opening parabola with a vertex at $(-1,0)$" :db/id #edb/ref 17592186281716} {:answer/id #uuid "288c9cee-9542-57eb-93f4-861d368e8ca3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A rightward-opening parabola with a vertex at $(1,0)$" :db/id #edb/ref 17592186282038} {:answer/id #uuid "4ad95782-91f4-5683-a635-ddafc36ccbd6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An upward-opening parabola with a vertex at $(1,0)$" :db/id #edb/ref 17592186282329} {:answer/id #uuid "6a23755b-b090-5e2f-9c1e-c1787bf827f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An upward-opening parabola with a vertex at $(-1,0)$" :db/id #edb/ref 17592186282600} {:answer/id