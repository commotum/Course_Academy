wer/id #uuid "43c6f92f-1b36-52ea-b7c3-2e35ea75890c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A leftward-opening parabola with a vertex at $(-1,0)$" :db/id #edb/ref 17592186381317} {:answer/id #uuid "fbe00de2-f75b-5f2a-ab61-7592eed8c497" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A leftward-opening parabola with a vertex at $(0,-1)$" :db/id #edb/ref 17592186381318} {:answer/id #uuid "a17b4a90-54ba-50bb-a642-8c5cc8127c6b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A downward-opening parabola with a vertex at $(-1,0)$" :db/id #edb/ref 17592186381319}] :answer-field/correct {:answer/id #uuid "f724f560-550d-52b8-a48c-940028a47093" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A downward-opening parabola with a vertex at $(0,-1)$" :db/id #edb/ref 17592186381316} :answer-field/id #uuid "bf59e5e4-dcbf-5636-bbbc-ff671a689fc8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381314}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "03805214-fe94-5c04-8985-2f3688ecf0b9" :question/math-academy-id "q-164420" :question/problem "What is the domain in the $xy$-plane of the parabolic cylinder ${x}^{2}=-5(y+1)?$" :question/worked-solution "The full expression describing all points on our parabolic cylinder is\n\n$$\n{x}^{2}=-5(y+1),\\,z=k\n$$\n\nwhere $k\\in R$ can vary arbitrarily. \n\nThe domain of any cylinder in the $xy$-plane is its base curve. Hence, in this case, the domain is\n\n$$\n\\{(x,y)\\in {R}^{2}:{x}^{2}=-5(y+1)\\}.\n$$\n\nThis is a downward-opening parabola with a vertex at $(0,-1).$"}] [{:db/id #edb/ref 17592186508918 :knowledge-point/_questions [{:db/id #edb/ref 17592186124587 :knowledge-point/id #uuid "36c5224a-eccc-5ea9-8719-2b0dc2ddb44d" :knowledge-point/title "The Domain of a Cylinder"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1af26990-37d6-5c3a-9040-4ef6f6b239f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An ellipse centered at $(3,0)$ with semi-axes of lengths $1$ and $25.$" :db/id #edb/ref 17592186508435} {:answer/id #uuid "5022fcc6-150a-5502-aae7-0c36cf0e8742" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The interior and boundary of an ellipse centered at $(-3,0)$ with semi-axes of lengths $1$ and $5.$" :db/id #edb/ref 17592186508508} {:answer/id #uuid "c127f29f-052a-5794-b5b2-3be574c6f2dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The interior and boundary of an ellipse centered at $(3,0)$ with semi-axes of lengths $1$ and $25.$" :db/id #edb/ref 17592186508686} {:answer/id #uuid "d208bca8-3704-5c6a-88be-21b04308174b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An ellipse centered at $(-3,0)$ with semi-axes of lengths $1$ and $5.$" :db/id #edb/ref 17592186508728} {:answer/id #uuid "f3b0ef1b-8d1b-5903-bf0c-073528025c0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An ellipse centered at $(-3,0)$ with semi-axes of lengths $1$ and $\\sqrt{5}.$" :db/id #edb/ref 17592186508785}] :answer-field/correct {:answer/id #uuid "d208bca8-3704-5c6a-88be-21b04308174b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An ellipse centered at $(-3,0)$ with semi-axes of lengths $1$ and $5.$" :db/id #edb/ref 17592186508728} :answer-field/id #uuid "61868b69-fdbd-5aff-bb91-accdf71cfa90" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186508842}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2ff3c43f-106f-5820-9db0-287d2d56d9d9" :question/math-academy-id "q-164423" :question/problem "What is the domain in the $xy$-plane of the elliptic cylinder $(x+3)^{2}+\\frac{{y}^{2}}{25}=1?$" :question/worked-solution "The full expression describing all points on our elliptic cylinder is\n\n$$\n(x+3)^{2}+\\frac{{y}^{2}}{25}=1,\\,z=k\n$$\n\nwhere $k\\in R$ can vary arbitrarily. \n\nThe domain of any cylinder in the $xy$-plane is its base curve. Hence, in this case, the domain is\n\n$$\n\\{(x,y)\\in {R}^{2}:(x+3)^{2}+\\frac{{y}^{2}}{25}=1\\}\n$$\n\nwhich can be written as\n\n$$\n\\{(x,y)\\in {R}^{2}:\\frac{(x+3)^{2}}{{1}^{2}}+\\frac{{y}^{2}}{{5}^{2}}=1\\}.\n$$\n\nThis is an ellipse centered at $(-3,0)$ with semi-axes of lengths $1$ and $5.$"}] [{:db/id #edb/ref 17592186124878 :knowledge-point/_questions [{:db/id #edb/ref 17592186124588 :knowledge-point/id #uuid "abbeda26-2fc0-5195-be26-ae79c72fc7bf" :knowledge-point/title "Traces of Cylinders"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3548e042-9d44-5988-beaa-28039d252432" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The hyperbola $\\frac{(x-1)^{2}}{8}-\\frac{{z}^{2}}{4}=1$" :db/id #edb/ref 17592186381898} {:answer/id #uuid "fd7ff268-86e6-5a22-94ff-2bd9c4000793" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The line $x=1-2\\sqrt{2}$" :db/id #edb/ref 17592186381899} {:answer/id #uuid "1efdacb4-f30c-5c7d-856d-ea5f48a4646e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The lines $x=1\\pm 2\\sqrt{2}$" :db/id #edb/ref 17592186381900} {:answer/id #uuid "c3cb7def-60a5-5d16-8a74-e984ade4ead2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The line $x=1+2\\sqrt{2}$" :db/id #edb/ref 17592186381901} {:answer/id #uuid "24e8148f-fd60-5d4e-ab0c-f0836d70be30" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The ellipse $\\frac{(x-1)^{2}}{4}+{z}^{2}=1$" :db/id #edb/ref 17592186381902}] :answer-field/correct {:answer/id #uuid "1efdacb4-f30c-5c7d-856d-ea5f48a4646e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The lines $x=1\\pm 2\\sqrt{2}$" :db/id #edb/ref 17592186381900} :answer-field/id #uuid "210e1b89-0754-553e-a321-3aa11e43ef1a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381897}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c7438eb4-e489-54ec-8b8b-08e4fa9d7883" :question/math-academy-id "q-35355" :question/problem "What is the trace in the $xz$-plane of the hyperbolic cylinder $\\frac{(x-1)^{2}}{8}-\\frac{{y}^{2}}{4}=1?$" :question/worked-solution "To find the trace in the $xz$-plane, we substitute $y=0$ into the equation of the cylinder, and simplify:\n\n$$\n\\begin{aligned}\\frac{(x-1)^{2}}{8}-\\frac{(0)^{2}}{4} & =1 \\\\ \\frac{(x-1)^{2}}{8} & =1 \\\\ (x-1)^{2} & =8 \\\\ x-1 & =\\pm 2\\sqrt{2} \\\\ x & =1\\pm 2\\sqrt{2}\\end{aligned}\n$$\n\nThis gives us the equation of two lines in the $xz$-plane."}]}
