5417] [17592186050005 #edb/ref 1027 #edb/ref 17592186048175 #edb/ref 17592186045417] [17592186050005 #edb/ref 1027 #edb/ref 17592186049530 #edb/ref 17592186045417] [17592186050005 #edb/ref 1027 #edb/ref 17592186050045 #edb/ref 17592186045417] [17592186050005 #edb/ref 1027 #edb/ref 17592186050816 #edb/ref 17592186045417] [17592186050005 #edb/ref 1028 #edb/ref 17592186124597 #edb/ref 17592186045417] [17592186050005 #edb/ref 1028 #edb/ref 17592186124651 #edb/ref 17592186045417] [17592186050005 #edb/ref 1028 #edb/ref 17592186124652 #edb/ref 17592186045417] [17592186050005 #edb/ref 1031 "Identifying Quadric Surfaces" #edb/ref 17592186045417] [17592186050005 #edb/ref 1033 1898 #edb/ref 17592186045417] [17592186050005 #edb/ref 1034 1.177909453874124 #edb/ref 17592186045436] [17592186050005 #edb/ref 1035 #uuid "25b1fb2e-aa54-5955-88cd-263118f65faa" #edb/ref 17592186045417] [17592186050123 #edb/ref 1027 #edb/ref 17592186049482 #edb/ref 17592186045417] [17592186050123 #edb/ref 1027 #edb/ref 17592186050005 #edb/ref 17592186045417] [17592186050123 #edb/ref 1027 #edb/ref 17592186050851 #edb/ref 17592186045417] [17592186050123 #edb/ref 1028 #edb/ref 17592186124587 #edb/ref 17592186045417] [17592186050123 #edb/ref 1028 #edb/ref 17592186124588 #edb/ref 17592186045417] [17592186050123 #edb/ref 1031 "Cylinders" #edb/ref 17592186045417] [17592186050123 #edb/ref 1033 1895 #edb/ref 17592186045417] [17592186050123 #edb/ref 1034 1.0 #edb/ref 17592186045436] [17592186050123 #edb/ref 1035 #uuid "2eaffcb9-29e5-5903-a02d-080ab3e7a821" #edb/ref 17592186045417] [17592186050851 #edb/ref 1027 #edb/ref 17592186048972 #edb/ref 17592186045417] [17592186050851 #edb/ref 1028 #edb/ref 17592186198349 #edb/ref 17592186045417] [17592186050851 #edb/ref 1028 #edb/ref 17592186198354 #edb/ref 17592186045417] [17592186050851 #edb/ref 1028 #edb/ref 17592186198433 #edb/ref 17592186045417] [17592186050851 #edb/ref 1031 "Intersections of Lines and Planes With Surfaces" #edb/ref 17592186045417] [17592186050851 #edb/ref 1033 4208 #edb/ref 17592186045417] [17592186050851 #edb/ref 1035 #uuid "6bf185a6-38f8-583f-b073-169dac3d7fe6" #edb/ref 17592186045417] [17592186124398 #edb/ref 1069 "e-8226" #edb/ref 17592186045417] [17592186124398 #edb/ref 1071 "What is the domain in the $xy$-plane of the elliptic cylinder $\\dfrac{x^2}{9} + (y+1)^2 = 1?$" #edb/ref 17592186045417] [17592186124398 #edb/ref 1072 #uuid "0cb849bd-8a9f-5305-b086-62da1a10e54f" #edb/ref 17592186045417] [17592186124398 #edb/ref 1074 "The full expression describing all points on our elliptic cylinder is\n\n$$\n\\dfrac{x^2}{9} + (y+1)^2 = 1, \\qquad z=k\n$$\n\nwhere $k \\in \\mathbb{R}$ can vary arbitrarily. \n\nThe domain of any cylinder in the $xy$-plane is its base curve. Hence, in this case, the domain is\n\n$$\n\\left\\{(x,y) \\in \\mathbb{R}^2 : \\dfrac{x^2}{9} + (y+1)^2 = 1\\right\\}\n$$\n\nwhich can be written as\n\n$$\n\\left\\{ (x,y) \\in \\mathbb{R}^2 : \\dfrac{x^2}{3^2} + \\dfrac{(y+1)^2}{1^2} = 1\\right\\}.\n$$\n\nThis is an ellipse centered at $(0,-1)$ with semi-axes of lengths $3$ and $1.$" #edb/ref 17592186045417] [17592186124399 #edb/ref 1069 "e-8227" #edb/ref 17592186045417] [17592186124399 #edb/ref 1071 "What is the trace in the $yz$-plane of the elliptic cylinder $\\dfrac {x^2} 2 +  \\dfrac {(y-2)^2}4  = 1?$" #edb/ref 17592186045417] [17592186124399 #edb/ref 1072 #uuid "64fc4653-a2ba-5013-8c70-1f4f14e5f8be" #edb/ref 17592186045417] [17592186124399 #edb/ref 1074 "To find the trace in the $yz$-plane, we substitute $x=0$ into the equation of the cylinder, and simplify:\n\n$$\n\\begin{aligned}\\frac{{0}^{2}}{2}+\\frac{(y-2)^{2}}{4} & =1 \\\\ (y-2)^{2} & =4 \\\\ y-2 & =\\pm 2 \\\\ y & =2\\pm 2 \\\\ y & =0,4\\end{aligned}\n$$\n\nThis gives us the equation of two lines $y=0$ and $y=4$ in the $yz$-plane." #edb/ref 17592186045417] [17592186124587 #edb/ref 1037 #edb/ref 17592186048366 #edb/ref 17592186045417] [17592186124587 #edb/ref 1037 #edb/ref 17592186048866 #edb/ref 17592186045417] [17592186124587 #edb/ref 1037 #edb/ref 17592186049118 #edb/ref 17592186045417] [17592186124587 #edb/ref 1037 #edb/ref 17592186049477 #edb/ref 17592186045417] [17592186124587 #edb/ref 1037 #edb/ref 17592186049699 #edb/ref 17592186045417] [17592186124587 #edb/ref 1038 #edb/ref 17592186124828 #edb/ref 17592186045417] [17592186124587 #edb/ref 1038 #edb/ref 17592186124892 #edb/ref 17592186045417] [17592186124587 #edb/ref 1038 #edb/ref 17592186284487 #edb/ref 17592186045417] [17592186124587 #edb/ref 1038 #edb/ref 17592186284488 #edb/ref 17592186045417] [17592186124587 #edb/ref 1038 #edb/ref 17592186284489 #edb/ref 17592186045417] [17592186124587 #edb/ref 1038 #edb/ref 17592186381313 #edb/ref 17592186045417] [17592186124587 #edb/ref 1038 #edb/ref 17592186381320 #edb/ref 17592186045417] [17592186124587 #edb/ref 1038 #edb/ref 17592186401488 #edb/ref 17592186045417] [17592186124587 #edb/ref 1038 #edb/ref 17592186401495 #edb/ref 17592186045417] [17592186124587 #edb/ref 1038 #edb/ref 17592186410158 #edb/ref 17592186045417] [17592186124587 #edb/ref 1038 #edb/ref 17592186476898 #edb/ref 17592186045417] [17592186124587 #edb/ref 1038 #edb/ref 17592186508918 #edb/ref 17592186045417] [17592186124587 #edb/ref 1039 "The Domain of a Cylinder" #edb/ref 17592186045417] [17592186124587 #edb/ref 1041 #edb/ref 17592186124398 #edb/ref 17592186045417] [17592186124587 #edb/ref 1042 #uuid "36c5224a-eccc-5ea9-8719-2b0dc2ddb44d" #edb/ref 17592186045417] [17592186124588 #edb/ref 1038 #edb/ref 17592186124878 #edb/ref 17592186045417] [17592186124588 #edb/ref 1038 #edb/ref 17592186124879 #edb/ref 17592186045417] [17592186124588 #edb/ref 1038 #edb/ref 17592186284480 #edb/ref 17592186045417] [17592186124588 #edb/ref 1038 #edb/ref 17592186284481 #edb/ref 17592186045417] [17592186124588 #edb/ref 1038 #edb/ref 17592186284484 #edb/ref 17592186045417] [17592186124588 #edb/ref 1038 #edb/ref 17592186284485 #edb/ref 17592186045417] [17592186124588 #edb/ref 1038 #edb/ref 17592186284486 #edb/ref 17592186045417] [17592186124588 #edb/ref 1038 #edb/ref 17592186398597 #edb/ref 17592186045417] [17592186124588 #edb/ref 1038 #edb/ref 17592186401467 #edb/ref 17592186045417] [17592186124588 #edb/ref 1038 #edb/ref 17592186401474 #edb/ref 17592186045417] [17592186124588 #edb/ref 1038 #edb/ref 17592186508975 #edb/ref 17592186045417] [17592186124588 #edb/ref 1039 "Traces of Cylinders" #edb/ref 17592186045417] [17592186124588 #edb/ref 1041 #edb/ref 17592186124399 #edb/ref 17592186045417] [17592186124588 #edb/ref 1042 #uuid "abbeda26-2fc0-5195-be26-ae79c72fc7bf" #edb/ref 17592186045417] [17592186124698 #edb/ref 1043 #edb/ref 17592186125517 #edb/ref 17592186045417] [17592186124698 #edb/ref 1043 #edb/ref 17592186125518 #edb/ref 17592186045417] [17592186124698 #edb/ref 1043 #edb/ref 17592186125519 #edb/ref 17592186045417] [17592186124698 #edb/ref 1043 #edb/ref 17592186125520 #edb/ref 17592186045417] [17592186124698 #edb/ref 1043 #edb/ref 17592186125526 #edb/ref 17592186045417] [17592186124698 #edb/ref 1043 #edb/ref 17592186125644 #edb/ref 17592186045417] [17592186124698 #edb/ref 1043 #edb/ref 17592186125646 #edb/ref 17592186045417] [17592186124698 #edb/ref 1043 #edb/ref 17592186125647 #edb/ref 17592186045417] [17592186124698 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186124698 #edb/ref 1045 "Cylinders" #edb/ref 17592186045417] [17592186124698 #edb/ref 1046 #edb/ref 17592186125517 #edb/ref 17592186045417] [17592186124698 #edb/ref 1049 #edb/ref 17592186050123 #edb/ref 17592186045417] [17592186124698 #edb/ref 1050 420.0 #edb/ref 17592186045417] [17592186124698 #edb/ref 1050 420.0 #edb/ref 17592186045436] [17592186124698 #edb/ref 1053 #uuid "59fb40d7-580f-58af-a644-746cbf4df4bb" #edb/ref 17592186045417] [17592186124878 #edb/ref 1068 #edb/ref 17592186381897 #edb/ref 17592186045417] [17592186124878 #edb/ref 1069 "q-35355" #edb/ref 17592186045417] [17592186124878 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186124878 #edb/ref 1071 "What is the trace in the $xz$-plane of the hyperbolic cylinder $\\frac{(x-1)^{2}}{8}-\\frac{{y}^{2}}{4}=1?$" #edb/ref 17592186045417] [17592186124878 #edb/ref 1072 #uuid "c7438eb4-e489-54ec-8b8b-08e4fa9d7883" #edb/ref 17592186045417] [17592186124878 #edb/ref 1074 "To find the trace in the $xz$-plane, we substitute $y=0$ into the equation of the cylinder, and simplify:\n\n$$\n\\begin{aligned}\\frac{(x-1)^{2}}{8}-\\frac{(0)^{2}}{4} & =1 \\\\ \\frac{(x-1)^{2}}{8} & =1 \\\\ (x-1)^{2} & =8 \\\\ x-1 & =\\pm 2\\sqrt{2} \\\\ x & =1\\pm 2\\sqrt{2}\\end{aligned}\n$$\n\nThis gives us the equation of two lines in the $xz$-plane." #edb/ref 17592186045417] [17592186125517 #edb/ref 1058 #edb/ref 17592186125519 #edb/ref 17592186045417] [17592186125517 #edb/ref 1061 30776 #edb/ref 17592186045417] [17592186125517 #edb/ref 1062 #uuid "21ce271d-74a1-526d-a3bb-1e1dc0da83ed" #edb/ref 17592186045417] [17592186125517 #edb/ref 1063 #edb/ref 17592186125830 #edb/ref 17592186045417] [17592186125518 #edb/ref 1058 #edb/ref 17592186125644 #edb/ref 17592186045417] [17592186125518 #edb/ref 1061 30778 #edb/ref 17592186045417] [17592186125518 #edb/ref 1062 #uuid "6b214232-840a-58b5-8946-bbbc69c878d7" #edb/ref 17592186045417] [17592186125518 #edb/ref 1063 #edb/ref 17592186124587 #edb/ref 17592186045417] [17592186125519 #edb/ref 1058 #edb/ref 17592186125526 #edb/ref 17592186045417] [17592186125519 #edb/ref 1061 30779 #edb/ref 17592186045417] [17592186125519 #edb/ref 1062 #uuid "0e4c9032-faa3-5e93-a91c-a0a7db82838a" #edb/ref 17592186045417] [17592186125519 #edb/ref 1063 #edb/ref 17592186125831 #edb/ref 17592186045417] [17592186125520 #edb/ref 1061 30781 #edb/ref 17592186045417] [17592186125520 #edb/ref 1062 #uuid "595c41f8-1c2f-5e89-b663-e36a44f691ac" #edb/ref 17592186045417] [17592186125520 #edb/ref 1063 #edb/ref 17592186124588 #edb/ref 17592186045417] [17592186125526 #edb/ref 1058 #edb/ref 17592186125518 #edb/ref 17592186045417] [17592186125526 #edb/ref 1061 30810 #edb/ref 17592186045417] [17592186125526 #edb/ref 1062 #uuid "3f461a0c-aa8c-58dd-b9c4-e57ae5d51a3b" #edb/ref 17592186045417] [17592186125526 #edb/ref 1063 #edb/ref 17592186125834 #edb/ref 17592186045417] [17592186125644 #edb/ref 1058 #edb/ref 17592186125646 #edb/ref 17592186045417] [17592186125644 #edb/ref 1061 45321 #edb/ref 17592186045417] [17592186125644 #edb/ref 1062 #uuid "2800e74a-ab30-5499-809e-31fb6deb9785" #edb/ref 17592186045417] [17592186125644 #edb/ref 1063 #edb/ref 17592186125884 #edb/ref 17592186045417] [17592186125646 #edb/ref 1058 #edb/ref 17592186125647 #edb/ref 17592186045417] [17592186125646 #edb/ref 1061 45325 #edb/ref 17592186045417] [17592186125646 #edb/ref 1062 #uuid "8fa4a35a-4cb0-5fd5-99f4-903b12b2986b" #edb/ref 17592186045417] [17592186125646 #edb/ref 1063 #edb/ref 17592186125886 #edb/ref 17592186045417] [17592186125647 #edb/ref 1058 #edb/ref 17592186125520 #edb/ref 17592186045417] [17592186125647 #edb/ref 1061 45326 #edb/ref 17592186045417] [17592186125647 #edb/ref 1062 #uuid "85399770-a72b-521d-b90e-0e8d27d7e807" #edb/ref 17592186045417] [17592186125647 #edb/ref 1063 #edb/ref 17592186125887 #edb/ref 17592186045417] [17592186125830 #edb/ref 1064 "A **cylinder** is a surface made by the set of lines that pass through a plane curve $C$ in the $xy$-plane and are perpendicular to this plane. The curve $C$ is called the **base curve**.\n\nThe familiar two-dimensional conic sections (circles, ellipses, parabolas, and hyperbolas) can be used to describe cylinders. In this lesson, we'll explore these shapes.\n\nAn **elliptic cylinder** is a cylinder whose base curve $C$ is an ellipse. If the ellipse lies in the $xy$-plane and is centered at $(x_0,y_0,0)$, then the equation of our elliptic cylinder is given by\n\n$$\n\\dfrac{(x-x_0)^2}{a^2} + \\dfrac{(y-y_0)^2}{b^2} = 1,\n$$\n\nwhere $a$ and $b$ are the semi-axes of the ellipse $C.$ In particular, if $a=b$, we get a **circular cylinder.**\n\n**Watch out!** This may look like the equation of a regular ellipse. However, since we're now describing a surface in three-dimensional space, we assume that the $z$-coordinate is arbitrary. Thus, if we want $z$ to feature in our equations explicitly, we would write\n\n$$\n\\dfrac{(x-x_0)^2}{a^2} + \\dfrac{(y-y_0)^2}{b^2} = 1, \\qquad z=k\n$$\n\nwhere $k\\in \\mathbb R.$ \n\nFor example, the graph of the elliptic cylinder\n\n$$\n\\dfrac{x^2}{4} + y^2 = 1\n$$\n\nis shown below. The center of its base ellipse $C$ is at the origin, and the **axis** of the elliptic cylinder (the line through the center of the cylinder) is the $z$-axis.\n\n![](images/50/504e609e134654d258378226d90f5faa8b9f6d12313a4fcac4a23d0bfe6bea52.png)\n\nLet's describe some properties of this elliptic cylinder:\n\n- The trace of this surface in the $xy$-plane (when $z=0$) is given by the equation\n\n$$\n\\dfrac{x^2}{4} + y^2 = 1,\n$$\n\nwhich is the base ellipse $C$ centered at the origin $(0,0,0)$ with semi-major and semi-minor axes of lengths $2$ and $1,$ respectively.\n\n![](images/d0/d0e4c0630b0da60c4324330211ab1bf8090ebec067d9ebc2ac2a03056c500bd6.png)\n\n- The trace of this surface in the $xz$-plane (when $y=0$) is given by the equation\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{4}+{0}^{2} & =1 \\\\ {x}^{2} & =4 \\\\ x & =\\pm 2,\\end{aligned}\n$$\n\nwhich corresponds to two lines in the $xz$-plane.\n\n![](images/38/3813a5f43319056be03ddd8b3353ef3a8166b7495b32397c91066f40d0b33cd5.png)\n\n- The trace of this surface in the $yz$-plane (when $x=0$) is given by the equation\n\n$$\n\\begin{aligned}\\frac{{0}^{2}}{4}+{y}^{2} & =1 \\\\ {y}^{2} & =1 \\\\ y & =\\pm 1,\\end{aligned}\n$$\n\nwhich corresponds to two lines in the $yz$-plane.\n\n![](images/a0/a0d928060ad18d3ba677f5dd184777b833d3abf03226c04c21292e455bcd0518.png)" #edb/ref 17592186045417] [17592186125830 #edb/ref 1065 4931 #edb/ref 17592186045417] [17592186125830 #edb/ref 1066 #uuid "f8f004e2-d43f-5628-bbbe-4b3c7918a9f5" #edb/ref 17592186045417] [17592186125830 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186125831 #edb/ref 1064 "A **parabolic cylinder** is a cylinder whose base curve $C$ is a parabola.\n\nIf the parabola $C$ opens upward or downward when viewed from the $xy$-plane and its vertex is at $(x_0,y_0,0)$, then the equation of the parabolic cylinder is given by\n\n$$\n(x-x_0)^2 = 4p(y-y_0),\n$$\n\nwhere $p$ is a constant.\n\nFor example, the graph of the parabolic cylinder\n\n$$\nx^2 = y\n$$\n\nis shown below. Its base curve is an upward-opening parabola in the $xy$-plane with its vertex at the origin. The **axis** of the cylinder is the $z$-axis.\n\n![](images/03/03ab0a28802900d8076fdd5f555bdad6582c449441c46f1de74260013cc55119.png)\n\nThe trace of this parabolic cylinder can be either a parabola or a set of lines.\n\n- The trace of this surface in the $xy$-plane (when $z=0$) is given by the equation\n\n$$\nx^2 = y,\n$$\n\nwhich corresponds to the base parabola $C$ with its vertex at the origin $(0,0,0).$\n\n![](images/98/98124890d921c73d0cda54428ac803221d5f393384e14db2909b0138fda0fb93.png)\n\n- The trace of this surface in the $xz$-plane (when $y=0$) is given by the equation\n\n$$\n\\begin{aligned}{x}^{2} & =0 \\\\ x & =0,\\end{aligned}\n$$\n\nwhich corresponds to a line in the $xz$-plane.\n\n![](images/f8/f87dbd180911db28a515dfe11da99d5d9d06da74e7ef117ea0a6df88018e95a2.png)\n\n- The trace of this surface in the $yz$-plane (when $x=0$) is given by the equation\n\n$$\n\\begin{aligned}{0}^{2} & =y \\\\ y & =0,\\end{aligned}\n$$\n\nwhich corresponds to a line in the $yz$-plane.\n\n![](images/f8/f87dbd180911db28a515dfe11da99d5d9d06da74e7ef117ea0a6df88018e95a2.png)\n\nOn the other hand, if the base parabola $C$ is left-opening or right-opening when viewed from the $xy$-plane and its vertex is at $(x_0,y_0,0)$, then the equation of the parabolic cylinder is given by\n\n$$\n(y-y_0)^2 = 4p(x-x_0),\n$$\n\nwhere $p$ is a constant.\n\nFor example, the graph of the parabolic cylinder\n\n$$\ny^2 = x\n$$\n\nis shown below. Its base curve is a right-opening parabola in the $xy$-plane with its vertex at the origin. The cylinder's axis is the $z$-axis.\n\n  \n\n![](images/a8/a87267dbd77b1561c047c6228ba0c70b08e5a48228d7e0b6a161463045d5e22b.png)" #edb/ref 17592186045417] [17592186125831 #edb/ref 1065 4932 #edb/ref 17592186045417] [17592186125831 #edb/ref 1066 #uuid "4026d216-b14f-558d-a7a4-cf39aa550b45" #edb/ref 17592186045417] [17592186125831 #edb/ref 1067 "Parabolic Cylinders" #edb/ref 17592186045417] [17592186125834 #edb/ref 1064 "A **hyperbolic cylinder** is a cylinder whose base curve $C$ is a hyperbola.\n\nIf the hyperbola $C$ is horizontal in the $xy$-plane and is centered at $(x_0,y_0,0)$, then the equation of the hyperbolic cylinder is given by\n\n$$\n\\dfrac{(x-x_0)^2}{a^2} - \\dfrac{(y-y_0)^2}{b^2} = 1,\n$$\n\nwhere $a$ and $b$ are constants.\n\n For example, the graph of the hyperbola cylinder\n\n$$\nx^2 - y^2 = 1\n$$\n\nis shown below. Its base curve is a horizontal hyperbola in the $xy$-plane centered at the origin. The **axis** of the cylinder is the $z$-axis.\n\n![](images/e3/e3c921cc7d6a1edbb182ecf158d7b84eb0d203fd20924d07cf57ca8f8ffdc107.png)\n\nThe trace of this surface can be either a hyperbola, a set of lines, or the empty set.\n\n- The trace of this surface in the $xy$-plane (when $z=0$) is given by the equation\n\n$$\nx^2 - y^2 = 1,\n$$\n\nwhich is the base hyperbola $C$ centered at the origin $(0,0,0).$\n\n![](images/19/19e02f27f625dd75d12333de3b82a7a012e4f6370c729eef5cd38a633c2c8689.png)\n\n- The trace of this surface in the $xz$-plane (when $y=0$) is given by the equation\n\n$$\n\\begin{aligned}{x}^{2}-{0}^{2} & =1 \\\\ {x}^{2} & =1 \\\\ x & =\\pm 1,\\end{aligned}\n$$\n\nwhich corresponds to a pair of lines in the $xz$-plane.\n\n![](images/56/5679b53433493d8b6e92d5aa5273be30bbf67a9db51993a925423d8514571f05.png)\n\n- The trace of this surface in the $yz$-plane (when $x=0$) is the empty set.\n\nOn the other hand, if the base hyperbola $C$ is vertical when viewed from the $xy$-plane and is centered at $(x_0,y_0,0)$, then the equation of the hyperbolic cylinder is given by\n\n$$\n\\dfrac{(y-y_0)^2}{b^2} - \\dfrac{(x-x_0)^2}{a^2} = 1,\n$$\n\nwhere $a$ and $b$ are constants.\n\nFor example, the graph of the hyperbola cylinder\n\n$$\ny^2 - x^2 = 1\n$$\n\nis shown below. Its base curve is a vertical hyperbola in the $xy$-plane centered at the origin, and the cylinder's axis is the $z$-axis.\n\n  \n\n![](images/d6/d690bca9515389bb403d0f205861af3294bc3a961df6691a5adb86de01421cff.png)\n\nNote that for all of the cylinders discussed so far, the *domain* of each cylinder in the $xy$-plane is simply the base curve $C.$" #edb/ref 17592186045417] [17592186125834 #edb/ref 1065 4939 #edb/ref 17592186045417] [17592186125834 #edb/ref 1066 #uuid "7260540c-2b7c-555f-9aa0-6f3dd490079b" #edb/ref 17592186045417] [17592186125834 #edb/ref 1067 "Hyperbolic Cylinders" #edb/ref 17592186045417] [17592186125884 #edb/ref 1064 "So far, we've encountered cylinders whose axes are parallel to the $z$-axis. However, we can also define cylinders whose axes are parallel to the $x$- or $y$-axes. To do this, we simply need to describe a base curve in either the $yz$-plane or the $xz$-plane. \n\nFor an elliptic cylinder whose base ellipse $C$ is centered at the origin, the other two cases are as follows:\n\n- Consider the elliptic cylinder $C$ whose base curve lies in the $xz$-plane.\n\n$$\n\\dfrac{x^2}{a^2} + \\dfrac{z^2}{c^2} = 1\n$$\n\nIn this case, the axis of the elliptic cylinder is the $y$-axis, as shown below.\n\n![](images/f3/f32db327a6e1f54d5b346af4ea2f9b0bcfce7f82c1b6e44375f398705acd4f63.png)\n\n- Consider the elliptic cylinder $C$ whose base curve lies in the $yz$-plane.\n\n$$\n\\dfrac{y^2}{b^2} + \\dfrac{z^2}{c^2} = 1\n$$\n\nIn this case, the axis of the elliptic cylinder is the $x$-axis, as shown below.\n\n![](images/53/5395c07f7646db4d4091e4bf176ae8d13c9c6753c322b8325dee2542480efdd4.png)" #edb/ref 17592186045417] [17592186125884 #edb/ref 1065 7851 #edb/ref 17592186045417] [17592186125884 #edb/ref 1066 #uuid "12af86a6-3212-596e-a78e-92fb9ba06344" #edb/ref 17592186045417] [17592186125884 #edb/ref 1067 "Elliptic Cylinders With Alternative Central Axes" #edb/ref 17592186045417] [17592186125886 #edb/ref 1064 "For a parabolic cylinder whose base parabola $C$ has its vertex at the origin, the other four cases are as follows:\n\n- When $C$ is in the $xz$-plane and $p>0,$ the axis is the $y$-axis.\n\n![](images/79/79d1fdd86e7f615597125f5ac43e55ecd59bc298387575707348784d2d48acd0.png)\n\nNote that if $p < 0,$ we get a reflection in the $xy$-plane or $yz$-plane of the parabolic cylinders shown above.\n\n- When $C$ is in the $yz$-plane and $p>0,$ the axis is the $x$-axis.\n\n![](images/73/730dccdd02e06d5f2de834f7b42c9121246aacda7595d2c5f760ae2f4c3bb5c9.png)\n\nNote that if $p<0,$ we get a reflection in the $xy$-plane or $xz$-plane of the parabolic cylinders shown above." #edb/ref 17592186045417] [17592186125886 #edb/ref 1065 7855 #edb/ref 17592186045417] [17592186125886 #edb/ref 1066 #uuid "049a63bf-b3e2-52e8-80c1-82042790f8f2" #edb/ref 17592186045417] [17592186125886 #edb/ref 1067 "Parabolic Cylinders With Alternative Central Axes" #edb/ref 17592186045417] [17592186125887 #edb/ref 1064 "For a hyperbolic cylinder whose base hyperbola $C$ has its vertex at the origin, the other four cases are as follows:\n\n- When $C$ is in the $xz$-plane, the axis of the hyperbolic cylinder is the $y$-axis.\n\n![](images/28/28f79c28aa6dfaa28b7b8ddd6d196bcb21db18411454c655a3365be52e8c6bc7.png)\n\n- When $C$ is in the $yz$-plane, the axis of the hyperbolic cylinder is the $x$-axis.\n\n![](images/57/5763cb9b167c2e1e9d17c9778bf569a0efafb4fe36f97e05e8e2173fb29fc998.png)" #edb/ref 17592186045417] [17592186125887 #edb/ref 1065 7856 #edb/ref 17592186045417] [17592186125887 #edb/ref 1066 #uuid "dba66b44-ad67-5d83-b191-e1d2f8b59ff8" #edb/ref 17592186045417] [17592186125887 #edb/ref 1067 "Hyperbolic Cylinders With Alternative Central Axes" #edb/ref 17592186045417] [17592186281716 #edb/ref 1080 "A rightward-opening parabola with a vertex at $(-1,0)$" #edb/ref 17592186045417] [17592186281716 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186281716 #edb/ref 1083 #uuid "033490d3-3a24-528a-ab3a-a8df80b8e0d3" #edb/ref 17592186045417] [17592186281747 #edb/ref 1080 "$5$ and $2$" #edb/ref 17592186045417] [17592186281747 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186281747 #edb/ref 1083 #uuid "06aca35d-1fab-59c5-89b9-f81bb55faa18" #edb/ref 17592186045417] [17592186281754 #edb/ref 1080 "(-3,1)" #edb/ref 17592186045417] [17592186281754 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186281754 #edb/ref 1083 #uuid "071d3bcc-39b3-5c99-93b6-62cd8ae9cf5a" #edb/ref 17592186045417] [17592186281775 #edb/ref 1080 "$\\sqrt{5}$ and $\\sqrt{2}$" #edb/ref 17592186045417] [17592186281775 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186281775 #edb/ref 1083 #uuid "09e4bc6e-ba33-5a4d-bf41-1971cbd5c6c1" #edb/ref 17592186045417] [17592186281941 #edb/ref 1080 "The lines $y=-8$ and $y=6$" #edb/ref 17592186045417] [17592186281941 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186281941 #edb/ref 1083 #uuid "1b87c134-c3ab-5cd7-a71d-942f9023b590" #edb/ref 17592186045417] [17592186281948 #edb/ref 1080 "(2,-1)" #edb/ref 17592186045417] [17592186281948 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186281948 #edb/ref 1083 #uuid "1c8a33f3-7a1b-50fa-a541-ab34e0431905" #edb/ref 17592186045417] [17592186282038 #edb/ref 1080 "A rightward-opening parabola with a vertex at $(1,0)$" #edb/ref 17592186045417] [17592186282038 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186282038 #edb/ref 1083 #uuid "288c9cee-9542-57eb-93f4-861d368e8ca3" #edb/ref 17592186045417] [17592186282183 #edb/ref 1080 "(3,1)" #edb/ref 17592186045417] [17592186282183 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186282183 #edb/ref 1083 #uuid "37a95c20-f2fe-5c07-ada4-469f21d936aa" #edb/ref 17592186045417] [175921862