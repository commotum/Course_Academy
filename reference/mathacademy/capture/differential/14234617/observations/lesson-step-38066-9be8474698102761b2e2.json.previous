\n<g transform=\"translate(7515,0)\">\n <use xlink:href=\"#E1-MJMAIN-31\"></use>\n <use xlink:href=\"#E1-MJMAIN-2E\" x=\"500\" y=\"0\"></use>\n <use xlink:href=\"#E1-MJMAIN-36\" x=\"779\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E1-MJMAIN-2B\" x=\"9017\" y=\"0\"></use>\n<g transform=\"translate(10018,0)\">\n <use xlink:href=\"#E1-MJMAIN-30\"></use>\n <use xlink:href=\"#E1-MJMAIN-2E\" x=\"500\" y=\"0\"></use>\n <use xlink:href=\"#E1-MJMAIN-37\" x=\"779\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E1-MJMATHI-78\" x=\"11297\" y=\"0\"></use>\n</g>\n</svg></span> be the regression line fitted using a sample <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"21.052ex\" height=\"2.843ex\" style=\"vertical-align: -0.838ex;\" viewBox=\"0 -863.1 9063.9 1223.9\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-2-Title\">\n<title id=\"MathJax-SVG-2-Title\">(x_1,y_1), \\: \\ldots, \\: (x_{8},y_{8})</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E2-MJMAIN-28\" d=\"M94 250Q94 319 104 381T127 488T164 576T202 643T244 695T277 729T302 750H315H319Q333 750 333 741Q333 738 316 720T275 667T226 581T184 443T167 250T184 58T225 -81T274 -167T316 -220T333 -241Q333 -250 318 -250H315H302L274 -226Q180 -141 137 -14T94 250Z\"></path>\n<path stroke-width=\"1\" id=\"E2-MJMATHI-78\" d=\"M52 289Q59 331 106 386T222 442Q257 442 286 424T329 379Q371 442 430 442Q467 442 494 420T522 361Q522 332 508 314T481 292T458 288Q439 288 427 299T415 328Q415 374 465 391Q454 404 425 404Q412 404 406 402Q368 386 350 336Q290 115 290 78Q290 50 306 38T341 26Q378 26 414 59T463 140Q466 150 469 151T485 153H489Q504 153 504 145Q504 144 502 134Q486 77 440 33T333 -11Q263 -11 227 52Q186 -10 133 -10H127Q78 -10 57 16T35 71Q35 103 54 123T99 143Q142 143 142 101Q142 81 130 66T107 46T94 41L91 40Q91 39 97 36T113 29T132 26Q168 26 194 71Q203 87 217 139T245 247T261 313Q266 340 266 352Q266 380 251 392T217 404Q177 404 142 372T93 290Q91 281 88 280T