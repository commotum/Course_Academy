9 471 550 475Q550 478 551 494T553 520Q553 554 544 579T526 616T501 641Q465 662 419 662Q362 662 313 616T263 510Q263 480 278 458T319 427Q323 425 389 408T456 390Q490 379 522 342T554 242Q554 216 546 186Q541 164 528 137T492 78T426 18T332 -20Q320 -22 298 -22Q199 -22 144 33L134 44L106 13Q83 -14 78 -18T65 -22Q52 -22 52 -14Q52 -11 110 221Q112 227 130 227H143Q149 221 149 216Q149 214 148 207T144 186T142 153Q144 114 160 87T203 47T255 29T308 24Z\"></path>\n<path stroke-width=\"1\" id=\"E1-MJMATHI-78\" d=\"M52 289Q59 331 106 386T222 442Q257 442 286 424T329 379Q371 442 430 442Q467 442 494 420T522 361Q522 332 508 314T481 292T458 288Q439 288 427 299T415 328Q415 374 465 391Q454 404 425 404Q412 404 406 402Q368 386 350 336Q290 115 290 78Q290 50 306 38T341 26Q378 26 414 59T463 140Q466 150 469 151T485 153H489Q504 153 504 145Q504 144 502 134Q486 77 440 33T333 -11Q263 -11 227 52Q186 -10 133 -10H127Q78 -10 57 16T35 71Q35 103 54 123T99 143Q142 143 142 101Q142 81 130 66T107 46T94 41L91 40Q91 39 97 36T113 29T132 26Q168 26 194 71Q203 87 217 139T245 247T261 313Q266 340 266 352Q266 380 251 392T217 404Q177 404 142 372T93 290Q91 281 88 280T72 278H58Q52 284 52 289Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E1-MJMAIN-45\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E1-MJMAIN-5B\" x=\"681\" y=\"0\"></use>\n<g transform=\"translate(960,0)\">\n <use xlink:href=\"#E1-MJMATHI-3B2\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E1-MJSZ1-2C6\" x=\"96\" y=\"236\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E1-MJMAIN-31\" x=\"923\" y=\"-326\"></use>\n</g>\n <use xlink:href=\"#E1-MJMAIN-5D\" x=\"2066\" y=\"0\"></use>\n <use xlink:href=\"#E1-MJMAIN-3D\" x=\"2623\" y=\"0\"></use>\n<g transform=\"translate(3679,0)\">\n <use xlink:href=\"#E1-MJMATHI-3B2\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E1-MJMAIN-31\" x=\"801\" y=\"-213\"></use>\n</g>\n <use xlink:href=\"#E1-MJMAIN-2C\" x=\"4699\" y=\"0\"></use>\n<g transform=\"translate(7144,0)\">\n <use xlink:href=\"#E1-MJMAIN-56\"></use>\n <use xlink:href=\"#E1-MJMAIN-61\" x=\"750\" y=\"0\"></use>\n <use xlink:href=\"#E1-MJMAIN-72\" x=\"1251\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E1-MJMAIN-5B\" x=\"8788\" y=\"0\"></use>\n<g transform=\"translate(9066,0)\">\n <use xlink:href=\"#E1-MJMATHI-3B2\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E1-MJMAIN-31\" x=\"801\" y=\"-213\"></use>\n <use xlink:href=\"#E1-MJSZ2-2C6\" x=\"9\" y=\"222\"></use>\n</g>\n <use xlink:href=\"#E1-MJMAIN-5D\" x=\"10087\" y=\"0\"></use>\n <use xlink:href=\"#E1-MJMAIN-3D\" x=\"10643\" y=\"0\"></use>\n<g transform=\"translate(11699,0)\">\n<g transform=\"translate(120,0)\">\n<rect stroke=\"none\" width=\"1643\" height=\"60\" x=\"0\" y=\"220\"></rect>\n<g transform=\"translate(308,676)\">\n <use xlink:href=\"#E1-MJMATHI-3C3\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E1-MJMAIN-32\" x=\"810\" y=\"513\"></use>\n</g>\n<g transform=\"translate(60,-686)\">\n <use xlink:href=\"#E1-MJMATHI-53\" x=\"0\" y=\"0\"></use>\n<g transform=\"translate(613,-150)\">\n <use transform=\"scale(0.707)\" xlink:href=\"#E1-MJMATHI-78\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E1-MJMATHI-78\" x=\"572\" y=\"0\"></use>\n</g>\n</g>\n</g>\n</g>\n</g>\n</svg></span></p>\n<p>Let's now derive these. First, we will show that</p>\n<p><span class=\"mjpage mjpage__block\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"20.677ex\" height=\"6.884ex\" style=\"vertical-align: -3.005ex;\" viewBox=\"0 -1670.4 8902.7 2964.1\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-2-Title\">\n<title id=\"MathJax-SVG-2-Title\">\nS_{xy} = \\sum_{i=1}^n (x_i-\\overline{x})y_i.\n</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E2-MJMATHI-53\" d=\"M308 24Q367 24 416 76T466 197Q466 260 414 28