#{[{:db/id #edb/ref 17592186510389 :knowledge-point/_questions [{:db/id #edb/ref 17592186198354 :knowledge-point/id #uuid "58427e6a-8e77-5c01-a578-a7dc4b8f8812" :knowledge-point/title "Finding the Projection of the Intersection of a Surface and a Tilted Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01030459-2127-5845-a022-909ed458b20a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-4{y}^{2}=-2" :db/id #edb/ref 17592186509696} {:answer/id #uuid "077958e9-019b-52b4-a194-2e3d1e6e8a31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-4{y}^{2}=2" :db/id #edb/ref 17592186509708} {:answer/id #uuid "143f96a1-49b9-5c94-8498-9b59fb558656" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-2{y}^{2}=1" :db/id #edb/ref 17592186509723} {:answer/id #uuid "203cf6b6-970b-533e-8eff-91d74ba85161" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-2{y}^{2}=-2" :db/id #edb/ref 17592186509751} {:answer/id #uuid "fb60e82e-e2d6-5601-ad2a-ed678e54b305" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+2{y}^{2}=-1" :db/id #edb/ref 17592186510228}] :answer-field/correct {:answer/id #uuid "01030459-2127-5845-a022-909ed458b20a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-4{y}^{2}=-2" :db/id #edb/ref 17592186509696} :answer-field/id #uuid "d9278757-a57e-52ac-9515-43ca861ad9fc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186510347}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4aa33ace-7f3a-5239-9095-80fa2dcc03c8" :question/math-academy-id "q-35493" :question/problem "Find the projection of the intersection between the hyperboloid of two sheets \n$\\frac{{x}^{2}}{2}+{y}^{2}-\\frac{(z+2)^{2}}{3}=-1$\nand the plane $3y+z=-2$  onto the\n$xy$-plane." :question/worked-solution "Since we want to find the projection onto the $xy$-plane, we need to eliminate the variable $z.$ First, we solve the equation of the plane for $z$, as follows:\n\n$$\n3y+z=-2\\,⟹\\,z=-2-3y\n$$\n\nSubstituting the expression for $z$ into the equation of the hyperboloid, we obtain: \n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{2}+{y}^{2}-\\frac{((-2-3y)+2)^{2}}{3} & =-1 \\\\ \\frac{{x}^{2}}{2}+{y}^{2}-\\frac{9{y}^{2}}{3} & =-1 \\\\ \\frac{{x}^{2}}{2}-2{y}^{2} & =-1 \\\\ {x}^{2}-4{y}^{2} & =-2\\end{aligned}\n$$\n\nTherefore, the projection of the intersection is the hyperbola ${x}^{2}-4{y}^{2}=-2.$"}] [{:db/id #edb/ref 17592186510376 :knowledge-point/_questions [{:db/id #edb/ref 17592186198433 :knowledge-point/id #uuid "b5329867-1956-5f36-8614-26d483c36efe" :knowledge-point/title "Finding the Intersection of a Surface and a Line Given in Cartesian Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49d7a3f7-5a7c-529b-8365-112a6e047f3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-1,-1,2)$ only" :db/id #edb/ref 17592186509838} {:answer/id #uuid "4b015270-c477-5154-96e4-6cc157ae07cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No points of intersection" :db/id #edb/ref 17592186509840} {:answer/id #uuid "58893bd2-e6a6-54b6-a356-759f3915936a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(1,-2,1)$ and $(-1,-1,2)$" :db/id #edb/ref 17592186509872} {:answer/id #uuid "a7ffed4d-2482-5099-8b82-bd20e8d364c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,-1,2)$ and $(-1,-2,0)$" :db/id #edb/ref 17592186510044} {:answer/id #uuid "dc3d4c3e-b241-54c6-acec-d0f88c27e4bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,-1,2)$ only" :db/id #edb/ref 17592186510157}] :answer-field/correct {:answer/id #uuid "a7ffed4d-2482-5099-8b82-bd20e8d364c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,-1,2)$ and $(-1,-2,0)$" :db/id #edb/ref 17592186510044} :answer-field/id #uuid "6a536d68-bf2d-5dad-99bc-e23331bfdfe7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186510296}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2fc9ea0f-3211-5796-852b-f82127f7f8bc" :question/math-academy-id "q-70492" :question/problem "Find the point(s) of the intersection of the sphere ${x}^{2}+(y+4)^{2}+(z-2)^{2}=9$ and the line $x=y+1=\\frac{z-2}{2}.$" :question/worked-solution "First, we write the equation of our line in parametric form:\n\n$$\n\\frac{x}{1}=\\frac{y+1}{1}=\\frac{z-2}{2}=t\\,⟹\\,\\left\\{\\begin{aligned}x &=t \\\\ y &=t-1 \\\\ z &=2t+2,\\end{aligned}\\right.\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$\n\nSubstituting the above expressions for $x$, $y$, and $z$ into the equation of the sphere, we obtain:\n\n$$\n\\begin{aligned}{x}^{2}+(y+4)^{2}+(z-2)^{2} & =9 \\\\ (t)^{2}+((t-1)+4)^{2}+((2t+2)-2)^{2} & =9 \\\\ (t)^{2}+(t+3)^{2}+(2t)^{2} & =9 \\\\ {t}^{2}+({t}^{2}+6t+9)+4{t}^{2} & =9 \\\\ 6{t}^{2}+6t+9 & =9 \\\\ 6{t}^{2}+6t & =0 \\\\ t(t+1) & =0\\end{aligned}\n$$\n\nHence, we get the solutions $t=0$ and $t=-1.$ \n\nNow, we substitute our solutions back into the equations of the line.\n\n- For $t=0$, we have\n\n$$\n\\left\\{\\begin{aligned}x &=(0)=0 \\\\ y &=(0)-1=-1 \\\\ z &=2(0)+2=2,\\end{aligned}\\right.\n$$\n\nso the first point is $(0,-1,2).$\n\n- For $t=-1$, we have\n\n$$\n\\left\\{\\begin{aligned}x &=(-1)=-1 \\\\ y &=(-1)-1=-2 \\\\ z &=2(-1)+2=0,\\end{aligned}\\right.\n$$\n\nso the second point is $(-1,-2,0).$\n\nTherefore, the points of intersection are $(0,-1,2)$ and $(-1,-2,0).$"}] [{:db/id #edb/ref 17592186360496 :knowledge-point/_questions [{:db/id #edb/ref 17592186198433 :knowledge-point/id #uuid "b5329867-1956-5f36-8614-26d483c36efe" :knowledge-point/title "Finding the Intersection of a Surface and a Line Given in Cartesian Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b903bea-51f1-51ea-a693-5a0c97f98bf4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(2,2,-4)$ only" :db/id #edb/ref 17592186358144} {:answer/id #uuid "2c022eed-8303-5bbd-919a-71ab3a6c95a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-1,-1,-10)$  only" :db/id #edb/ref 17592186358146} {:answer/id #uuid "95eebd9a-0f31-5806-8042-2e3bfb8f6155" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-2,-2,-12)$   only" :db/id #edb/ref 17592186359064} {:answer/id #uuid "d0b68df9-17b2-54d1-b813-125cb95bf18e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(1,1,-6)$  and $(2,2,-4)$" :db/id #edb/ref 17592186359578} {:answer/id #uuid "e0f3ad4f-cc75-5a06-aee9-ee2d0acfd6e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(3,3,-2)$  and $(-1,-1,-10)$" :db/id #edb/ref 17592186359732}] :answer-field/correct {:answer/id #uuid "2b903bea-51f1-51ea-a693-5a0c97f98bf4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(2,2,-4)$ only" :db/id #edb/ref 17592186358144} :answer-field/id #uuid "1d1cf090-377c-5859-8dd5-5396d17112eb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360043}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e5c485dc-7f99-51a9-8d40-81cda196a56c" :question/math-academy-id "q-94784" :question/problem "Find the point of the intersection of the elliptic cone $2{x}^{2}+2{y}^{2}={z}^{2}$ and the line $x=y=\\frac{z+8}{2}.$" :question/worked-solution "First, we write the equation of our line in parametric form:\n\n$$\nx=y=\\frac{z+8}{2}=t\\,⟹\\,\\left\\{\\begin{aligned}x &=t \\\\ y &=t \\\\ z &=2t-8,\\end{aligned}\\right.\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$\n\nSubstituting the above expressions for $x,$ $y,$ and $z$ into the equation of the elliptic cone, we obtain\n\n$$\n\\begin{aligned}2{x}^{2}+2{y}^{2} & ={z}^{2} \\\\ 2{t}^{2}+2{t}^{2} & =(2t-8)^{2} \\\\ 4{t}^{2} & =4{t}^{2}-32t+64 \\\\ 32t & =64 \\\\ t & =2.\\end{aligned}\n$$\n\nNow, we substitute our solution back into the equations of the line. For $t=2,$ we have\n\n$$\n\\left\\{\\begin{aligned}x &=2 \\\\ y &=2 \\\\ z &=2(2)-8=-4.\\end{aligned}\\right.\n$$\n\nTherefore, the point of intersection is $(2,2,-4).$"}]}
