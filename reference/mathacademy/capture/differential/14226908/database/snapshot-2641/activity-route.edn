#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186548132} :activity/id #uuid "cbb61bd9-de45-5df1-ad03-960918640c73" :activity/scope {:db/id #edb/ref 17592186050851 :topic/id #uuid "6bf185a6-38f8-583f-b073-169dac3d7fe6" :topic/math-academy-id 4208} :activity/steps [{:db/id #edb/ref 17592186548082 :step/content {:db/id #edb/ref 17592186510376 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49d7a3f7-5a7c-529b-8365-112a6e047f3c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(-1,-1,2)$ only" :db/id #edb/ref 17592186509838} {:answer/id #uuid "4b015270-c477-5154-96e4-6cc157ae07cf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No points of intersection" :db/id #edb/ref 17592186509840} {:answer/id #uuid "58893bd2-e6a6-54b6-a356-759f3915936a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(1,-2,1)$ and $(-1,-1,2)$" :db/id #edb/ref 17592186509872} {:answer/id #uuid "a7ffed4d-2482-5099-8b82-bd20e8d364c7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(0,-1,2)$ and $(-1,-2,0)$" :db/id #edb/ref 17592186510044} {:answer/id #uuid "dc3d4c3e-b241-54c6-acec-d0f88c27e4bd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(0,-1,2)$ only" :db/id #edb/ref 17592186510157}] :answer-field/correct {:db/id #edb/ref 17592186510044} :answer-field/id #uuid "6a536d68-bf2d-5dad-99bc-e23331bfdfe7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186510296}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2fc9ea0f-3211-5796-852b-f82127f7f8bc" :question/math-academy-id "q-70492" :question/problem "Find the point(s) of the intersection of the sphere ${x}^{2}+(y+4)^{2}+(z-2)^{2}=9$ and the line $x=y+1=\\frac{z-2}{2}.$" :question/worked-solution "First, we write the equation of our line in parametric form:\n\n$$\n\\frac{x}{1}=\\frac{y+1}{1}=\\frac{z-2}{2}=t\\,⟹\\,\\left\\{\\begin{aligned}x &=t \\\\ y &=t-1 \\\\ z &=2t+2,\\end{aligned}\\right.\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$\n\nSubstituting the above expressions for $x$, $y$, and $z$ into the equation of the sphere, we obtain:\n\n$$\n\\begin{aligned}{x}^{2}+(y+4)^{2}+(z-2)^{2} & =9 \\\\ (t)^{2}+((t-1)+4)^{2}+((2t+2)-2)^{2} & =9 \\\\ (t)^{2}+(t+3)^{2}+(2t)^{2} & =9 \\\\ {t}^{2}+({t}^{2}+6t+9)+4{t}^{2} & =9 \\\\ 6{t}^{2}+6t+9 & =9 \\\\ 6{t}^{2}+6t & =0 \\\\ t(t+1) & =0\\end{aligned}\n$$\n\nHence, we get the solutions $t=0$ and $t=-1.$ \n\nNow, we substitute our solutions back into the equations of the line.\n\n- For $t=0$, we have\n\n$$\n\\left\\{\\begin{aligned}x &=(0)=0 \\\\ y &=(0)-1=-1 \\\\ z &=2(0)+2=2,\\end{aligned}\\right.\n$$\n\nso the first point is $(0,-1,2).$\n\n- For $t=-1$, we have\n\n$$\n\\left\\{\\begin{aligned}x &=(-1)=-1 \\\\ y &=(-1)-1=-2 \\\\ z &=2(-1)+2=0,\\end{aligned}\\right.\n$$\n\nso the second point is $(-1,-2,0).$\n\nTherefore, the points of intersection are $(0,-1,2)$ and $(-1,-2,0).$"} :step/id #uuid "00bf7e71-a2f6-5d03-9ce5-51e605b39bdf" :step/next {:db/id #edb/ref 17592186548112}} {:db/id #edb/ref 17592186548090 :step/content {:db/id #edb/ref 17592186510389 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01030459-2127-5845-a022-909ed458b20a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{2}-4{y}^{2}=-2" :db/id #edb/ref 17592186509696} {:answer/id #uuid "077958e9-019b-52b4-a194-2e3d1e6e8a31" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{2}-4{y}^{2}=2" :db/id #edb/ref 17592186509708} {:answer/id #uuid "143f96a1-49b9-5c94-8498-9b59fb558656" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{2}-2{y}^{2}=1" :db/id #edb/ref 17592186509723} {:answer/id #uuid "203cf6b6-970b-533e-8eff-91d74ba85161" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{2}-2{y}^{2}=-2" :db/id #edb/ref 17592186509751} {:answer/id #uuid "fb60e82e-e2d6-5601-ad2a-ed678e54b305" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{2}+2{y}^{2}=-1" :db/id #edb/ref 17592186510228}] :answer-field/correct {:db/id #edb/ref 17592186509696} :answer-field/id #uuid "d9278757-a57e-52ac-9515-43ca861ad9fc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186510347}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4aa33ace-7f3a-5239-9095-80fa2dcc03c8" :question/math-academy-id "q-35493" :question/problem "Find the projection of the intersection between the hyperboloid of two sheets \n$\\frac{{x}^{2}}{2}+{y}^{2}-\\frac{(z+2)^{2}}{3}=-1$\nand the plane $3y+z=-2$  onto the\n$xy$-plane." :question/worked-solution "Since we want to find the projection onto the $xy$-plane, we need to eliminate the variable $z.$ First, we solve the equation of the plane for $z$, as follows:\n\n$$\n3y+z=-2\\,⟹\\,z=-2-3y\n$$\n\nSubstituting the expression for $z$ into the equation of the hyperboloid, we obtain: \n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{2}+{y}^{2}-\\frac{((-2-3y)+2)^{2}}{3} & =-1 \\\\ \\frac{{x}^{2}}{2}+{y}^{2}-\\frac{9{y}^{2}}{3} & =-1 \\\\ \\frac{{x}^{2}}{2}-2{y}^{2} & =-1 \\\\ {x}^{2}-4{y}^{2} & =-2\\end{aligned}\n$$\n\nTherefore, the projection of the intersection is the hyperbola ${x}^{2}-4{y}^{2}=-2.$"} :step/id #uuid "1f2dfb02-7449-57f0-8474-7ab8cc23d410" :step/next {:db/id #edb/ref 17592186548082}} {:db/id #edb/ref 17592186548112 :step/content {:db/id #edb/ref 17592186360496 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b903bea-51f1-51ea-a693-5a0c97f98bf4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(2,2,-4)$ only" :db/id #edb/ref 17592186358144} {:answer/id #uuid "2c022eed-8303-5bbd-919a-71ab3a6c95a1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(-1,-1,-10)$  only" :db/id #edb/ref 17592186358146} {:answer/id #uuid "95eebd9a-0f31-5806-8042-2e3bfb8f6155" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(-2,-2,-12)$   only" :db/id #edb/ref 17592186359064} {:answer/id #uuid "d0b68df9-17b2-54d1-b813-125cb95bf18e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(1,1,-6)$  and $(2,2,-4)$" :db/id #edb/ref 17592186359578} {:answer/id #uuid "e0f3ad4f-cc75-5a06-aee9-ee2d0acfd6e4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(3,3,-2)$  and $(-1,-1,-10)$" :db/id #edb/ref 17592186359732}] :answer-field/correct {:db/id #edb/ref 17592186358144} :answer-field/id #uuid "1d1cf090-377c-5859-8dd5-5396d17112eb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186360043}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e5c485dc-7f99-51a9-8d40-81cda196a56c" :question/math-academy-id "q-94784" :question/problem "Find the point of the intersection of the elliptic cone $2{x}^{2}+2{y}^{2}={z}^{2}$ and the line $x=y=\\frac{z+8}{2}.$" :question/worked-solution "First, we write the equation of our line in parametric form:\n\n$$\nx=y=\\frac{z+8}{2}=t\\,⟹\\,\\left\\{\\begin{aligned}x &=t \\\\ y &=t \\\\ z &=2t-8,\\end{aligned}\\right.\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$\n\nSubstituting the above expressions for $x,$ $y,$ and $z$ into the equation of the elliptic cone, we obtain\n\n$$\n\\begin{aligned}2{x}^{2}+2{y}^{2} & ={z}^{2} \\\\ 2{t}^{2}+2{t}^{2} & =(2t-8)^{2} \\\\ 4{t}^{2} & =4{t}^{2}-32t+64 \\\\ 32t & =64 \\\\ t & =2.\\end{aligned}\n$$\n\nNow, we substitute our solution back into the equations of the line. For $t=2,$ we have\n\n$$\n\\left\\{\\begin{aligned}x &=2 \\\\ y &=2 \\\\ z &=2(2)-8=-4.\\end{aligned}\\right.\n$$\n\nTherefore, the point of intersection is $(2,2,-4).$"} :step/id #uuid "6213e43a-b8e6-5090-8550-09bf102c1d90" :step/next {:db/id #edb/ref 17592186548170}} {:db/id #edb/ref 17592186548132 :step/content {:db/id #edb/ref 17592186548041 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45708bae-dc50-5c9d-9e5d-04417b00fc2e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A parabola centered at $(-\\frac{2}{5},0)$" :db/id #edb/ref 17592186547470} {:answer/id #uuid "6b4a85ba-f52f-5884-8c16-83695d5c66ee" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An ellipse centered at $(\\frac{2}{5},0)$" :db/id #edb/ref 17592186547555} {:answer/id #uuid "97e12641-e027-541c-99c1-6366461603f4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An ellipse centered at $(-\\frac{1}{5},1)$" :db/id #edb/ref 17592186547647} {:answer/id #uuid "d8394f66-6c5c-5f76-a6ef-29a7574673c4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperbola centered at $(\\frac{2}{5},0)$" :db/id #edb/ref 17592186547774} {:answer/id #uuid "efefd15d-7892-53ae-9529-407152a306e3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperbola centered at $(0,-\\frac{2}{5})$" :db/id #edb/ref 17592186547809}] :answer-field/correct {:db/id #edb/ref 17592186547774} :answer-field/id #uuid "7b399ec8-7eac-5c54-a396-185538576377" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186547903}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "aad779ca-b824-50cb-b4dc-f0dd2ba06356" :question/math-academy-id "q-35267" :question/problem "Which of the following best describes the projection of the intersection between the elliptic cone ${x}^{2}+(y-1)^{2}={z}^{2}$ and the plane $2x-y=0$ onto the $xz$-plane?" :question/worked-solution "Since we want to find the projection onto the $xz$-plane, we need to eliminate the variable $y.$ First, we solve the equation of the plane for $y,$ as follows:\n\n$$\n2x-y=0\\,⟹\\,y=2x\n$$\n\nSubstituting the expression for $y$ into the equation of the elliptic cone, we obtain\n\n$$\n\\begin{aligned}{x}^{2}+(2x-1)^{2} & ={z}^{2} \\\\ {x}^{2}+4{x}^{2}-4x+1 & ={z}^{2} \\\\ {z}^{2}-5{x}^{2}+4x & =1 \\\\ {z}^{2}-5({x}^{2}-\\frac{4}{5}x+\\frac{4}{25})+\\frac{4}{5} & =1 \\\\ {z}^{2}-5{({x}^{2}-\\frac{2}{5})}^{2} & =\\frac{1}{5} \\\\ 5{z}^{2}-25{(x-\\frac{2}{5})}^{2} & =1.\\end{aligned}\n$$\n\nThis is the equation of a hyperbola centered at $(\\frac{2}{5},0)$ in the $xz$-plane."} :step/id #uuid "8c9533a8-c4e9-53e0-b90e-2bcd5caf0a45" :step/next {:db/id #edb/ref 17592186548090}} {:db/id #edb/ref 17592186548170 :step/content {:db/id #edb/ref 17592186547984 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "081e5bee-d384-5542-a478-5de37b09d87f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperbola centered at $(0,1)$" :db/id #edb/ref 17592186547334} {:answer/id #uuid "148376ac-e85f-5126-89dc-5cb422a0ba9a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A parabola centered at $(1,0)$" :db/id #edb/ref 17592186547359} {:answer/id #uuid "216b9c4e-e1e1-55e6-9308-db110453b59c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperbola centered at $(-1,0)$" :db/id #edb/ref 17592186547384} {:answer/id #uuid "b11f7f45-cfd1-5e21-bf78-fbf84e1b0907" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An ellipse centered at $(-1,0)$" :db/id #edb/ref 17592186547702} {:answer/id #uuid "f88af9e5-dc7f-5ff6-82b4-4257cd328c5c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An ellipse centered at $(0,1)$" :db/id #edb/ref 17592186547822}] :answer-field/correct {:db/id #edb/ref 17592186547702} :answer-field/id #uuid "a3b78ce5-61ca-5b12-8256-45eaecfa1b9e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186547920}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1c9e9df7-050b-54af-a7dc-34ce03f716ac" :question/math-academy-id "q-94941" :question/problem "Which of the following best describes the projection of the intersection between the elliptic cone ${x}^{2}+3{y}^{2}=2{z}^{2}$ and the plane $2z-x+1=0$ onto the $xy$-plane?" :question/worked-solution "Since we want to find the projection onto the $xy$-plane, we need to eliminate the variable $z.$ First, we solve the equation of the plane for $z,$ as follows:\n\n$$\n2z-x+1=0\\,⟹\\,z=\\frac{x}{2}-\\frac{1}{2}\n$$\n\nSubstituting the expression for $z$ into the equation of the elliptic cone, we obtain\n\n$$\n\\begin{aligned}{x}^{2}+3{y}^{2} & =2{(\\frac{x}{2}-\\frac{1}{2})}^{2} \\\\ {x}^{2}+3{y}^{2} & =2(\\frac{{x}^{2}}{4}-\\frac{x}{2}+\\frac{1}{4}) \\\\ {x}^{2}+3{y}^{2} & =\\frac{{x}^{2}}{2}-x+\\frac{1}{2} \\\\ \\frac{{x}^{2}}{2}+x+3{y}^{2} & =\\frac{1}{2} \\\\ \\frac{1}{2}(x+1)^{2}-\\frac{1}{2}+3{y}^{2} & =\\frac{1}{2} \\\\ \\frac{(x+1)^{2}}{2}+3{y}^{2} & =1.\\end{aligned}\n$$\n\nThis is the equation of an ellipse centered at $(-1,0)$ in the $xy$-plane."} :step/id #uuid "d0d18cff-ebd0-51fc-8898-369edfc897b7"}] :activity/title "Intersections of Lines and Planes With Surfaces" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186547308}]}
