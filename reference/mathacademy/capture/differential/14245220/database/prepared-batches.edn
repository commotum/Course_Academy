5742b568cea0"] ["answer-field-707a53ec-3f89-531c-a47b-914f51a9c97c" :answer-field/choices "answer-f8844c5c-08d4-51a1-8c11-9ac8c49c3885"] ["question-da0e0865-56b2-565d-ac33-deaee1268cf4" :question/answer-fields "answer-field-707a53ec-3f89-531c-a47b-914f51a9c97c"] [17592186110726 :knowledge-point/questions "question-da0e0865-56b2-565d-ac33-deaee1268cf4"] ["question-7a1b4ade-6b6f-5b17-86f4-ce0cd6af2275" :question/id #uuid "7a1b4ade-6b6f-5b17-86f4-ce0cd6af2275"] ["question-7a1b4ade-6b6f-5b17-86f4-ce0cd6af2275" :question/math-academy-id "q-106153"] ["question-7a1b4ade-6b6f-5b17-86f4-ce0cd6af2275" :question/problem "Find the axis of symmetry of the parabola $y=(x+1)(x+5).$"] ["question-7a1b4ade-6b6f-5b17-86f4-ce0cd6af2275" :question/worked-solution "From the equation $y=(x+1)(x+5),$ we can tell that the roots of the parabola are ${x}_{1}=-1$ and ${x}_{2}=-5.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2} \\\\  & =\\frac{{x}_{1}+{x}_{2}}{2} \\\\  & =\\frac{(-1)+(-5)}{2} \\\\  & =-3\\end{aligned}\n$$\n\nTherefore, the axis of symmetry is $x=-3.$"] ["question-7a1b4ade-6b6f-5b17-86f4-ce0cd6af2275" :question/difficulty :question.difficulty/easy] ["answer-field-0ffa1566-4612-5862-8fdf-ac5382f57169" :answer-field/id #uuid "0ffa1566-4612-5862-8fdf-ac5382f57169"] ["answer-df1b1902-78e7-5bd8-b4d4-f1c766ecff16" :answer/id #uuid "df1b1902-78e7-5bd8-b4d4-f1c766ecff16"] ["answer-df1b1902-78e7-5bd8-b4d4-f1c766ecff16" :answer/type :answer.type/math] ["answer-df1b1902-78e7-5bd8-b4d4-f1c766ecff16" :answer/value "x=-1"] ["answer-68e7c17d-7e12-5d3e-afd5-011a186ee008" :answer/id #uuid "68e7c17d-7e12-5d3e-afd5-011a186ee008"] ["answer-68e7c17d-7e12-5d3e-afd5-011a186ee008" :answer/type :answer.type/math] ["answer-68e7c17d-7e12-5d3e-afd5-011a186ee008" :answer/value "x=-2"] ["answer-91189e9e-756c-5779-950e-f011041ff2b8" :answer/id #uuid "91189e9e-756c-5779-950e-f011041ff2b8"] ["answer-91189e9e-756c-5779-950e-f