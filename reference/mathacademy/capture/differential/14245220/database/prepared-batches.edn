[{"source" ":org/Math-Academy" "forms" [{:db/id 17592186110725 :knowledge-point/questions ["question-a9694bfd-2888-58c6-a0ef-19d3c4d9b6a1" "question-f8e7577e-52b0-551a-a683-aebcdeb0ba63" "question-6e6642fc-4b0f-571e-8c66-e87cc2512b11"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186110726 :knowledge-point/questions ["question-da0e0865-56b2-565d-ac33-deaee1268cf4" "question-7a1b4ade-6b6f-5b17-86f4-ce0cd6af2275" "question-4cf4852d-d3c2-5b9a-829d-615cf17e0f68" "question-cd5e69ab-4017-5036-a080-1d135b13f5a0"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186110727 :knowledge-point/questions ["question-684d163d-4d1e-51cd-8879-d5e5b2f089b6" "question-143580a6-1bb7-5c0f-bc9f-072a4a4b0e12" "question-4c9070fc-7290-592a-a3f4-9617ce57a8a0" "question-04b365f6-2d57-5574-aec1-e0a7c1397133"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186110728 :knowledge-point/questions ["question-d3719257-12a3-5f28-b262-f0a159519b77" "question-d2b05f92-b206-55b0-8a81-97fed9a6e7ee" "question-bac157c9-805d-56d0-9e89-ae7a2f0ad4e6" "question-29e68a84-4d10-52b0-a908-447f3d997c55" "question-14e0eb8a-dac7-5f73-9945-6c6e124a2b27"] :db/ensure [:knowledge-point/validate]} {:db/id "question-a9694bfd-2888-58c6-a0ef-19d3c4d9b6a1" :question/id #uuid "a9694bfd-2888-58c6-a0ef-19d3c4d9b6a1" :question/math-academy-id "q-84895" :question/problem "![](images/ce/ce468433e58a99da31fb305428ff478ddb4c91ec6fa260ab1a951979e83ec63c.png)\n\nFind the axis of symmetry for the parabola sketched above." :question/worked-solution "From the graph, we deduce that the roots are ${x}_{1}=-4$ and ${x}_{2}=3.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2}=\\frac{(-4)+3}{2}=-\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the axis of symmetry is $x=-\\frac{1}{2}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d992778b-a9e3-5c64-9ebe-4a79b06c6533"] :db/ensure [:question/validate]} {:db/id "answer-field-d992778b-a9e3-5c64-9ebe-4a79b06c6533" :answer-field/id #uuid "d992778b-a9e3-5c64-9ebe-4a79b06c6533" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d7d96b22-da80-52f9-b2f6-8c6bc1bb1aca" :answer-field/choices ["answer-d7d96b22-da80-52f9-b2f6-8c6bc1bb1aca" "answer-15eb53f7-fe67-57d6-a2b0-7d5a7be0aef3" "answer-383662d8-7c53-56e6-b7ee-0d5555963c70" "answer-a718f457-e6e2-5d83-99f8-1f151c1c909b" "answer-efc78a1d-c863-5959-83d0-6a25a98b5920"] :db/ensure [:answer-field/validate]} {:db/id "answer-d7d96b22-da80-52f9-b2f6-8c6bc1bb1aca" :answer/id #uuid "d7d96b22-da80-52f9-b2f6-8c6bc1bb1aca" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-15eb53f7-fe67-57d6-a2b0-7d5a7be0aef3" :answer/id #uuid "15eb53f7-fe67-57d6-a2b0-7d5a7be0aef3" :answer/type :answer.type/math :answer/value "-\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-383662d8-7c53-56e6-b7ee-0d5555963c70" :answer/id #uuid "383662d8-7c53-56e6-b7ee-0d5555963c70" :answer/type :answer.type/math :answer/value "-\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "answer-a718f457-e6e2-5d83-99f8-1f151c1c909b" :answer/id #uuid "a718f457-e6e2-5d83-99f8-1f151c1c909b" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-efc78a1d-c863-5959-83d0-6a25a98b5920" :answer/id #uuid "efc78a1d-c863-5959-83d0-6a25a98b5920" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "question-f8e7577e-52b0-551a-a683-aebcdeb0ba63" :question/id #uuid "f8e7577e-52b0-551a-a683-aebcdeb0ba63" :question/math-academy-id "q-30510" :question/problem "![](images/6e/6ecca5e6b96cd7e0de0510abf26b3fe80c6f33322460b9bf4448f4b9c3eb8442.png)\n\nFind the axis of symmetry for the parabola sketched above." :question/worked-solution "From the graph, we deduce that the roots are ${x}_{1}=-1$ and ${x}_{2}=2.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2}=\\frac{(-1)+2}{2}=\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the axis of symmetry is $x=\\frac{1}{2}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-1123def6-8dc6-58e4-8f1b-899f255bbcc1"] :db/ensure [:question/validate]} {:db/id "answer-field-1123def6-8dc6-58e4-8f1b-899f255bbcc1" :answer-field/id #uuid "1123def6-8dc6-58e4-8f1b-899f255bbcc1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-14015542-fee2-5fec-96da-f18d0ae334d4" :answer-field/choices ["answer-e4bcb35f-829f-5234-a877-ca4c41be4fee" "answer-3f931ccf-9536-5f59-b52c-f7140f39f8f3" "answer-c46a3c63-7ce2-5171-80e2-c72b810d3bbb" "answer-4f0dd0eb-fb35-581b-aab9-f1d675a126de" "answer-14015542-fee2-5fec-96da-f18d0ae334d4"] :db/ensure [:answer-field/validate]} {:db/id "answer-e4bcb35f-829f-5234-a877-ca4c41be4fee" :answer/id #uuid "e4bcb35f-829f-5234-a877-ca4c41be4fee" :answer/type :answer.type/math :answer/value "x=-1" :db/ensure [:answer/validate]} {:db/id "answer-3f931ccf-9536-5f59-b52c-f7140f39f8f3" :answer/id #uuid "3f931ccf-9536-5f59-b52c-f7140f39f8f3" :answer/type :answer.type/math :answer/value "x=-2" :db/ensure [:answer/validate]} {:db/id "answer-c46a3c63-7ce2-5171-80e2-c72b810d3bbb" :answer/id #uuid "c46a3c63-7ce2-5171-80e2-c72b810d3bbb" :answer/type :answer.type/math :answer/value "x=-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-4f0dd0eb-fb35-581b-aab9-f1d675a126de" :answer/id #uuid "4f0dd0eb-fb35-581b-aab9-f1d675a126de" :answer/type :answer.type/math :answer/value "x=1" :db/ensure [:answer/validate]} {:db/id "answer-14015542-fee2-5fec-96da-f18d0ae334d4" :answer/id #uuid "14015542-fee2-5fec-96da-f18d0ae334d4" :answer/type :answer.type/math :answer/value "x=\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "question-6e6642fc-4b0f-571e-8c66-e87cc2512b11" :question/id #uuid "6e6642fc-4b0f-571e-8c66-e87cc2512b11" :question/math-academy-id "q-220354" :question/problem "![](images/bd/bd46cb7a3139ccb19b7f65bab927ef8c56ba075520262649d6fa196cdab8cc81.png)\n\nThe graph above shows a parabola. The $x$-coordinates of $A$ and $B$ are $-\\frac{16}{5}$ and $\\frac{5}{2},$ respectively.  Find the axis of symmetry of the parabola.\n\nThe axis of symmetry is $x=$\n{{field-1}}." :question/worked-solution "We're given that the roots of the parabola are \n ${x}_{1}=-\\frac{16}{5}$ and ${x}_{2}=\\frac{5}{2}.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2} \\\\  & =\\frac{(-\\frac{16}{5}+\\frac{5}{2})}{2} \\\\  & =\\frac{(-\\frac{32}{10}+\\frac{25}{10})}{2} \\\\  & =\\frac{(-\\frac{7}{10})}{2} \\\\  & =-\\frac{7}{20}.\\end{aligned}\n$$\n\nTherefore, the axis of symmetry is $x=-\\frac{7}{20}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-79bc61fa-11bd-5db1-aa6e-3d865e60342d"] :db/ensure [:question/validate]} {:db/id "answer-field-79bc61fa-11bd-5db1-aa6e-3d865e60342d" :answer-field/id #uuid "79bc61fa-11bd-5db1-aa6e-3d865e60342d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-5ebf46c9-f938-50a8-9cc1-97df4784c6aa" :answer-field/choices ["answer-5ebf46c9-f938-50a8-9cc1-97df4784c6aa"] :db/ensure [:answer-field/validate]} {:db/id "answer-5ebf46c9-f938-50a8-9cc1-97df4784c6aa" :answer/id #uuid "5ebf46c9-f938-50a8-9cc1-97df4784c6aa" :answer/type :answer.type/math :answer/value "-\\frac{7}{20}" :db/ensure [:answer/validate]} {:db/id "question-da0e0865-56b2-565d-ac33-deaee1268cf4" :question/id #uuid "da0e0865-56b2-565d-ac33-deaee1268cf4" :question/math-academy-id "q-84903" :question/problem "Find the axis of symmetry of the parabola $y=(7-5x)(x+1).$" :question/worked-solution "From the equation $y=(7-5x)(x+1),$ we find that the roots of the parabola are ${x}_{1}=\\frac{7}{5}$ and ${x}_{2}=-1.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2} \\\\  & =\\frac{(\\frac{7}{5}-1)}{2} \\\\  & =\\frac{(\\frac{7}{5}-\\frac{5}{5})}{2} \\\\  & =\\frac{(\\frac{2}{5})}{2} \\\\  & =\\frac{1}{5}\\end{aligned}\n$$\n\nTherefore, the axis of symmetry is $x=\\frac{1}{5}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-707a53ec-3f89-531c-a47b-914f51a9c97c"] :db/ensure [:question/validate]} {:db/id "answer-field-707a53ec-3f89-531c-a47b-914f51a9c97c" :answer-field/id #uuid "707a53ec-3f89-531c-a47b-914f51a9c97c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-05ed7714-762b-563c-aa6e-395fc6bb299a" :answer-field/choices ["answer-12226c0d-85bd-508b-82d8-13bf97d8f83b" "answer-3bd14c1c-2112-52ab-bcdc-5d7b174123b0" "answer-05ed7714-762b-563c-aa6e-395fc6bb299a" "answer-55af48ee-55a1-5c40-847d-5742b568cea0" "answer-f8844c5c-08d4-51a1-8c11-9ac8c49c3885"] :db/ensure [:answer-field/validate]} {:db/id "answer-12226c0d-85bd-508b-82d8-13bf97d8f83b" :answer/id #uuid "12226c0d-85bd-508b-82d8-13bf97d8f83b" :answer/type :answer.type/math :answer/value "x=-\\frac{1}{5}" :db/ensure [:answer/validate]} {:db/id "answer-3bd14c1c-2112-52ab-bcdc-5d7b174123b0" :answer/id #uuid "3bd14c1c-2112-52ab-bcdc-5d7b174123b0" :answer/type :answer.type/math :answer/value "x=-\\frac{3}{5}" :db/ensure [:answer/validate]} {:db/id "answer-05ed7714-762b-563c-aa6e-395fc6bb299a" :answer/id #uuid "05ed7714-762b-563c-aa6e-395fc6bb299a" :answer/type :answer.type/math :answer/value "x=\\frac{1}{5}" :db/ensure [:answer/validate]} {:db/id "answer-55af48ee-55a1-5c40-847d-5742b568cea0" :answer/id #uuid "55af48ee-55a1-5c40-847d-5742b568cea0" :answer/type :answer.type/math :answer/value "x=\\frac{2}{5}" :db/ensure [:answer/validate]} {:db/id "answer-f8844c5c-08d4-51a1-8c11-9ac8c49c3885" :answer/id #uuid "f8844c5c-08d4-51a1-8c11-9ac8c49c3885" :answer/type :answer.type/math :answer/value "x=\\frac{3}{5}" :db/ensure [:answer/validate]} {:db/id "question-7a1b4ade-6b6f-5b17-86f4-ce0cd6af2275" :question/id #uuid "7a1b4ade-6b6f-5b17-86f4-ce0cd6af2275" :question/math-academy-id "q-106153" :question/problem "Find the axis of symmetry of the parabola $y=(x+1)(x+5).$" :question/worked-solution "From the equation $y=(x+1)(x+5),$ we can tell that the roots of the parabola are ${x}_{1}=-1$ and ${x}_{2}=-5.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2} \\\\  & =\\frac{{x}_{1}+{x}_{2}}{2} \\\\  & =\\frac{(-1)+(-5)}{2} \\\\  & =-3\\end{aligned}\n$$\n\nTherefore, the axis of symmetry is $x=-3.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-0ffa1566-4612-5862-8fdf-ac5382f57169"] :db/ensure [:question/validate]} {:db/id "answer-field-0ffa1566-4612-5862-8fdf-ac5382f57169" :answer-field/id #uuid "0ffa1566-4612-5862-8fdf-ac5382f57169" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-91189e9e-756c-5779-950e-f011041ff2b8" :answer-field/choices ["answer-df1b1902-78e7-5bd8-b4d4-f1c766ecff16" "answer-68e7c17d-7e12-5d3e-afd5-011a186ee008" "answer-91189e9e-756c-5779-950e-f011041ff2b8" "answer-a3f22b06-7510-59cb-af7d-fe434eed0c69" "answer-db18c12c-2087-5905-9c74-6abb04f1a1d8"] :db/ensure [:answer-field/validate]} {:db/id "answer-df1b1902-78e7-5bd8-b4d4-f1c766ecff16" :answer/id #uuid "df1b1902-78e7-5bd8-b4d4-f1c766ecff16" :answer/type :answer.type/math :answer/value "x=-1" :db/ensure [:answer/validate]} {:db/id "answer-68e7c17d-7e12-5d3e-afd5-011a186ee008" :answer/id #uuid "68e7c17d-7e12-5d3e-afd5-011a186ee008" :answer/type :answer.type/math :answer/value "x=-2" :db/ensure [:answer/validate]} {:db/id "answer-91189e9e-756c-5779-950e-f011041ff2b8" :answer/id #uuid "91189e9e-756c-5779-950e-f011041ff2b8" :answer/type :answer.type/math :answer/value "x=-3" :db/ensure [:answer/validate]} {:db/id "answer-a3f22b06-7510-59cb-af7d-fe434eed0c69" :answer/id #uuid "a3f22b06-7510-59cb-af7d-fe434eed0c69" :answer/type :answer.type/math :answer/value "x=2" :db/ensure [:answer/validate]} {:db/id "answer-db18c12c-2087-5905-9c74-6abb04f1a1d8" :answer/id #uuid "db18c12c-2087-5905-9c74-6abb04f1a1d8" :answer/type :answer.type/math :answer/value "x=3" :db/ensure [:answer/validate]} {:db/id "question-4cf4852d-d3c2-5b9a-829d-615cf17e0f68" :question/id #uuid "4cf4852d-d3c2-5b9a-829d-615cf17e0f68" :question/math-academy-id "q-223668" :question/problem "The axis of symmetry of the parabola $y=-(x+6)(x-4)$ is $x=${{field-1}}." :question/worked-solution "From the equation $y=-(x+6)(x-4),$ we can tell that the roots of the parabola are ${x}_{1}=-6$ and ${x}_{2}=4.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2} \\\\  & =\\frac{-6+4}{2} \\\\  & =\\frac{(-2)}{2} \\\\  & =-1\\end{aligned}\n$$\n\nTherefore, the axis of symmetry is $x=-1.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b93cd0f2-3775-53e1-8100-fdd69419df85"] :db/ensure [:question/validate]} {:db/id "answer-field-b93cd0f2-3775-53e1-8100-fdd69419df85" :answer-field/id #uuid "b93cd0f2-3775-53e1-8100-fdd69419df85" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-9e880c63-17e5-55ec-9752-a08e206ebf91" :answer-field/choices ["answer-9e880c63-17e5-55ec-9752-a08e206ebf91"] :db/ensure [:answer-field/validate]} {:db/id "answer-9e880c63-17e5-55ec-9752-a08e206ebf91" :answer/id #uuid "9e880c63-17e5-55ec-9752-a08e206ebf91" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "question-cd5e69ab-4017-5036-a080-1d135b13f5a0" :question/id #uuid "cd5e69ab-4017-5036-a080-1d135b13f5a0" :question/math-academy-id "q-84902" :question/problem "Find the axis of symmetry of the parabola $y=(6x-1)(3x+1).$" :question/worked-solution "From the equation $y=(6x-1)(3x+1),$ we find that the roots of the parabola are ${x}_{1}=\\frac{1}{6}$ and ${x}_{2}=-\\frac{1}{3}.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2} \\\\  & =\\frac{(\\frac{1}{6}-\\frac{1}{3})}{2} \\\\  & =\\frac{(\\frac{1}{6}-\\frac{2}{6})}{2} \\\\  & =\\frac{(-\\frac{1}{6})}{2} \\\\  & =-\\frac{1}{12}\\end{aligned}\n$$\n\nTherefore, the axis of symmetry is $x=-\\frac{1}{12}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-329e691a-a395-50ed-b83a-cc3c4efd7434"] :db/ensure [:question/validate]} {:db/id "answer-field-329e691a-a395-50ed-b83a-cc3c4efd7434" :answer-field/id #uuid "329e691a-a395-50ed-b83a-cc3c4efd7434" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-142bb8d7-2c5b-5aff-a641-87db92de52c0" :answer-field/choices ["answer-142bb8d7-2c5b-5aff-a641-87db92de52c0" "answer-80b7f6d3-2e98-5ccb-856a-d66a6512df21" "answer-404a6d55-06c7-5863-9890-05c5ef448ad1" "answer-169d9c2b-ed8e-5399-9665-91d1666641d3" "answer-29e329a9-3422-59f4-82ad-91d038159e57"] :db/ensure [:answer-field/validate]} {:db/id "answer-142bb8d7-2c5b-5aff-a641-87db92de52c0" :answer/id #uuid "142bb8d7-2c5b-5aff-a641-87db92de52c0" :answer/type :answer.type/math :answer/value "x=-\\frac{1}{12}" :db/ensure [:answer/validate]} {:db/id "answer-80b7f6d3-2e98-5ccb-856a-d66a6512df21" :answer/id #uuid "80b7f6d3-2e98-5ccb-856a-d66a6512df21" :answer/type :answer.type/math :answer/value "x=-\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "answer-404a6d55-06c7-5863-9890-05c5ef448ad1" :answer/id #uuid "404a6d55-06c7-5863-9890-05c5ef448ad1" :answer/type :answer.type/math :answer/value "x=-\\frac{1}{6}" :db/ensure [:answer/validate]} {:db/id "answer-169d9c2b-ed8e-5399-9665-91d1666641d3" :answer/id #uuid "169d9c2b-ed8e-5399-9665-91d1666641d3" :answer/type :answer.type/math :answer/value "x=\\frac{1}{12}" :db/ensure [:answer/validate]} {:db/id "answer-29e329a9-3422-59f4-82ad-91d038159e57" :answer/id #uuid "29e329a9-3422-59f4-82ad-91d038159e57" :answer/type :answer.type/math :answer/value "x=\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "question-684d163d-4d1e-51cd-8879-d5e5b2f089b6" :question/id #uuid "684d163d-4d1e-51cd-8879-d5e5b2f089b6" :question/math-academy-id "q-84906" :question/problem "The axis of symmetry of the parabola $y=-(3x+4)(6x-k)$ is $x=-\\frac{1}{3}.$ The value of $k=$" :question/worked-solution "First, we will calculate the axis of symmetry in terms of $k.$ Then, since we know that the axis of symmetry is $x=-\\frac{1}{3},$ we will set our result equal to $-\\frac{1}{3}.$ \n\nFrom the equation $y=-(3x+4)(6x-k),$ we find that the roots of the parabola are ${x}_{1}=-\\frac{4}{3}$ and ${x}_{2}=\\frac{k}{6}.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2} \\\\  & =\\frac{(-\\frac{4}{3}+\\frac{k}{6})}{2} \\\\  & =\\frac{(-\\frac{8}{6}+\\frac{k}{6})}{2} \\\\  & =\\frac{k-8}{12}\\end{aligned}\n$$\n\nWe know that the axis of symmetry is $x=-\\frac{1}{3}.$ Therefore, we have\n\n$$\n\\begin{aligned}\\frac{k-8}{12} & =-\\frac{1}{3} \\\\ k-8 & =-4 \\\\ k & =-4+8 \\\\ k & =4.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-6a445e9b-2feb-5651-8789-3201593291a8"] :db/ensure [:question/validate]} {:db/id "answer-field-6a445e9b-2feb-5651-8789-3201593291a8" :answer-field/id #uuid "6a445e9b-2feb-5651-8789-3201593291a8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f26ad368-7367-5130-8843-f17ee8749540" :answer-field/choices ["answer-1c7dd35c-387e-5c8f-8d52-8df49f54ba91" "answer-f26ad368-7367-5130-8843-f17ee8749540" "answer-2231137b-d7d1-5097-a668-5b88fce4d605" "answer-96e7ced7-ae8e-524c-9f9a-e5c32bd8d7a4" "answer-8240c150-e4cb-507a-8888-b6ef07b60c64"] :db/ensure [:answer-field/validate]} {:db/id "answer-1c7dd35c-387e-5c8f-8d52-8df49f54ba91" :answer/id #uuid "1c7dd35c-387e-5c8f-8d52-8df49f54ba91" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-f26ad368-7367-5130-8843-f17ee8749540" :answer/id #uuid "f26ad368-7367-5130-8843-f17ee8749540" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-2231137b-d7d1-5097-a668-5b88fce4d605" :answer/id #uuid "2231137b-d7d1-5097-a668-5b88fce4d605" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-96e7ced7-ae8e-524c-9f9a-e5c32bd8d7a4" :answer/id #uuid "96e7ced7-ae8e-524c-9f9a-e5c32bd8d7a4" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "answer-8240c150-e4cb-507a-8888-b6ef07b60c64" :answer/id #uuid "8240c150-e4cb-507a-8888-b6ef07b60c64" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "question-143580a6-1bb7-5c0f-bc9f-072a4a4b0e12" :question/id #uuid "143580a6-1bb7-5c0f-bc9f-072a4a4b0e12" :question/math-academy-id "q-106169" :question/problem "The axis of symmetry of $y=(x-2k)(x+3k)$ is $x=-2.$ The value of $k=$" :question/worked-solution "First, we calculate the axis of symmetry in terms of $k.$ Then, since we know that the axis of symmetry is $x=-2,$ we will set our result equal to $-2.$ \n\nFrom the equation $y=(x-2k)(x+3k),$ we find that the roots of the parabola are ${x}_{1}=2k$ and ${x}_{2}=-3k.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2} \\\\  & =\\frac{2k+(-3k)}{2} \\\\  & =\\frac{-k}{2}.\\end{aligned}\n$$\n\nWe know that the axis of symmetry is $x=-2.$ Therefore, we have\n\n$$\n\\begin{aligned}\\frac{-k}{2} & =-2 \\\\ k & =4.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-70fe4864-23f4-51f6-9ec6-6f3333ce7d23"] :db/ensure [:question/validate]} {:db/id "answer-field-70fe4864-23f4-51f6-9ec6-6f3333ce7d23" :answer-field/id #uuid "70fe4864-23f4-51f6-9ec6-6f3333ce7d23" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b7e4b322-e190-5f51-8844-56c6bf60ae9b" :answer-field/choices ["answer-39ae4953-ea9c-5671-8840-4018a5578e01" "answer-6669511f-d4ef-5505-b173-a7475fbc1511" "answer-c9f335a4-a3ee-545c-8578-89d25b02d49d" "answer-b7e4b322-e190-5f51-8844-56c6bf60ae9b" "answer-9e91fbe8-a391-5c1a-b5f5-c38ffbd44c43"] :db/ensure [:answer-field/validate]} {:db/id "answer-39ae4953-ea9c-5671-8840-4018a5578e01" :answer/id #uuid "39ae4953-ea9c-5671-8840-4018a5578e01" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-6669511f-d4ef-5505-b173-a7475fbc1511" :answer/id #uuid "6669511f-d4ef-5505-b173-a7475fbc1511" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-c9f335a4-a3ee-545c-8578-89d25b02d49d" :answer/id #uuid "c9f335a4-a3ee-545c-8578-89d25b02d49d" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-b7e4b322-e190-5f51-8844-56c6bf60ae9b" :answer/id #uuid "b7e4b322-e190-5f51-8844-56c6bf60ae9b" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-9e91fbe8-a391-5c1a-b5f5-c38ffbd44c43" :answer/id #uuid "9e91fbe8-a391-5c1a-b5f5-c38ffbd44c43" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "question-4c9070fc-7290-592a-a3f4-9617ce57a8a0" :question/id #uuid "4c9070fc-7290-592a-a3f4-9617ce57a8a0" :question/math-academy-id "q-223686" :question/problem "The axis of symmetry of the parabola $y=(2x+3)(x-k)$ is $x=\\frac{5}{4}.$ Find the value of $k.$\n\n$k=$\n{{field-1}}" :question/worked-solution "First, we will calculate the axis of symmetry in terms of $k.$ Then, since we know that the axis of symmetry is $x=\\frac{5}{4},$ we will set our result equal to $\\frac{5}{4}.$ \n\nFrom the equation $y=(2x+3)(x-k),$ we find that the roots of the parabola are ${x}_{1}=-\\frac{3}{2}$ and ${x}_{2}=k.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2} \\\\  & =\\frac{(-\\frac{3}{2}+k)}{2} \\\\  & =\\frac{(-\\frac{3}{2}+\\frac{2k}{2})}{2} \\\\  & =\\frac{2k-3}{4}\\end{aligned}\n$$\n\nWe know that the axis of symmetry is $x=\\frac{5}{4}.$ Therefore, we have\n\n$$\n\\begin{aligned}\\frac{2k-3}{4} & =\\frac{5}{4} \\\\ 2k-3 & =5 \\\\ 2k & =8 \\\\ k & =4.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e93e9559-4f79-5c63-a36b-5702454dc549"] :db/ensure [:question/validate]} {:db/id "answer-field-e93e9559-4f79-5c63-a36b-5702454dc549" :answer-field/id #uuid "e93e9559-4f79-5c63-a36b-5702454dc549" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-e752a1c1-0510-5a2c-adb0-f4320d6d7556" :answer-field/choices ["answer-e752a1c1-0510-5a2c-adb0-f4320d6d7556"] :db/ensure [:answer-field/validate]} {:db/id "answer-e752a1c1-0510-5a2c-adb0-f4320d6d7556" :answer/id #uuid "e752a1c1-0510-5a2c-adb0-f4320d6d7556" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id 17592186110978 :question/problem "The axis of symmetry of the parabola $y=-(x+5k)(3x-4k)$ is $x=-\\frac{1}{8}.$ Find the value of $k.$\n\n$k=$\n\n{{field-1}}" :question/worked-solution "First, we will calculate the axis of symmetry in terms of $k.$ Then, since we know that the axis of symmetry is $x=-\\frac{1}{8},$ we will set our result equal to $\\frac{1}{8}.$ \n\nFrom the equation $y=-(x+5k)(3x-4k),$ we find that the roots of the parabola are ${x}_{1}=-5k$ and ${x}_{2}=\\frac{4k}{3}.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2} \\\\  & =\\frac{(-5k+\\frac{4k}{3})}{2} \\\\  & =-\\frac{(-\\frac{11k}{3})}{2} \\\\  & =-\\frac{11k}{6}\\end{aligned}\n$$\n\nWe know that the axis of symmetry is $x=-\\frac{1}{8}.$ Therefore, we have\n\n$$\n\\begin{aligned}-\\frac{11k}{6} & =-\\frac{1}{8} \\\\ -11k & =-\\frac{6}{8} \\\\ -11k & =-\\frac{3}{4} \\\\ k & =\\frac{3}{44}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186107606 :answer-field/correct "answer-663b6d29-5f25-5ddf-b688-280f85dc55f5" :answer-field/choices ["answer-663b6d29-5f25-5ddf-b688-280f85dc55f5"] :db/ensure [:answer-field/validate]} {:db/id "answer-663b6d29-5f25-5ddf-b688-280f85dc55f5" :answer/id #uuid "663b6d29-5f25-5ddf-b688-280f85dc55f5" :answer/type :answer.type/math :answer/value "\\frac{3}{44}" :db/ensure [:answer/validate]} {:db/id "question-04b365f6-2d57-5574-aec1-e0a7c1397133" :question/id #uuid "04b365f6-2d57-5574-aec1-e0a7c1397133" :question/math-academy-id "q-84911" :question/problem "The axis of symmetry of $y=\\frac{1}{3}(k-x)(5x+3k)$ is $x=\\frac{1}{10}.$ The value of $k=$" :question/worked-solution "First, we calculate the axis of symmetry in terms of $k.$ Then, since we know that the axis of symmetry is $x=\\frac{1}{10},$ we will set our result equal to $\\frac{1}{10}.$ \n\nFrom the equation $y=\\frac{1}{3}(k-x)(5x+3k),$ we find that the roots of the parabola are ${x}_{1}=k$ and ${x}_{2}=-\\frac{3k}{5}.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2} \\\\  & =\\frac{(k-\\frac{3k}{5})}{2} \\\\  & =\\frac{(\\frac{5k}{5}-\\frac{3k}{5})}{2} \\\\  & =\\frac{(\\frac{2k}{5})}{2} \\\\  & =\\frac{k}{5}.\\end{aligned}\n$$\n\nWe know that the axis of symmetry is $x=\\frac{1}{10}.$ Therefore, we have\n\n$$\n\\begin{aligned}\\frac{k}{5} & =\\frac{1}{10} \\\\ k & =\\frac{1}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-cfed377d-f55c-58f7-a40b-072a8729a585"] :db/ensure [:question/validate]} {:db/id "answer-field-cfed377d-f55c-58f7-a40b-072a8729a585" :answer-field/id #uuid "cfed377d-f55c-58f7-a40b-072a8729a585" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-45670d3d-36e3-540d-bd5e-bd76637818f6" :answer-field/choices ["answer-193c9dde-df02-57fb-9a38-2e3ada1317a7" "answer-a475de87-e762-598f-af2f-5e440020dd19" "answer-ff07e237-c85a-5da5-b75b-ecc1a90cc0ca" "answer-7f53d534-d2c5-55c9-bc0b-0b43335f20b3" "answer-45670d3d-36e3-540d-bd5e-bd76637818f6"] :db/ensure [:answer-field/validate]} {:db/id "answer-193c9dde-df02-57fb-9a38-2e3ada1317a7" :answer/id #uuid "193c9dde-df02-57fb-9a38-2e3ada1317a7" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-a475de87-e762-598f-af2f-5e440020dd19" :answer/id #uuid "a475de87-e762-598f-af2f-5e440020dd19" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-ff07e237-c85a-5da5-b75b-ecc1a90cc0ca" :answer/id #uuid "ff07e237-c85a-5da5-b75b-ecc1a90cc0ca" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-7f53d534-d2c5-55c9-bc0b-0b43335f20b3" :answer/id #uuid "7f53d534-d2c5-55c9-bc0b-0b43335f20b3" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-45670d3d-36e3-540d-bd5e-bd76637818f6" :answer/id #uuid "45670d3d-36e3-540d-bd5e-bd76637818f6" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "question-d3719257-12a3-5f28-b262-f0a159519b77" :question/id #uuid "d3719257-12a3-5f28-b262-f0a159519b77" :question/math-academy-id "q-311977" :question/problem "| **$x$** | $22$ | $25$ | $29$ |\n| --- | --- | --- | --- |\n| **$f(x)$** | $7$ | $7$ | $1$ |\n\nThe graph of a parabola $y=f(x)$ passes through the points given by their $(x,y)$-coordinates in the table above. What is the $x$-coordinate of the parabola's vertex?\n\nThe $x$-coordinate of the vertex is\n{{field-1}}." :question/worked-solution "Notice that the values of $f(x)$ at the points $x=22$ and $x=25$ are equal.\n\n$$\nf(22)=f(25)=7\n$$\n\nTherefore, the parabola's axis of symmetry must be equidistant from the lines $x=22$ and $x=25.$ We can find this by taking the average of these two values.\n\nIf the parabola's vertex is $(h,k),$ then we must have\n\n$$\n\\begin{aligned}h & =\\frac{22+25}{2} \\\\  & =\\frac{47}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-20ab70eb-5491-5082-8e0c-fff7c3142ccb"] :db/ensure [:question/validate]} {:db/id "answer-field-20ab70eb-5491-5082-8e0c-fff7c3142ccb" :answer-field/id #uuid "20ab70eb-5491-5082-8e0c-fff7c3142ccb" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-3dc01742-5f11-5892-91d4-ffa50ff7e871" :answer-field/choices ["answer-3dc01742-5f11-5892-91d4-ffa50ff7e871"] :db/ensure [:answer-field/validate]} {:db/id "answer-3dc01742-5f11-5892-91d4-ffa50ff7e871" :answer/id #uuid "3dc01742-5f11-5892-91d4-ffa50ff7e871" :answer/type :answer.type/math :answer/value "\\frac{47}{2}" :db/ensure [:answer/validate]} {:db/id "question-d2b05f92-b206-55b0-8a81-97fed9a6e7ee" :question/id #uuid "d2b05f92-b206-55b0-8a81-97fed9a6e7ee" :question/math-academy-id "q-311956" :question/problem "| **$x$** | $-9$ | $-6$ | $-3$ |\n| --- | --- | --- | --- |\n| **$f(x)$** | $-10$ | $0$ | $0$ |\n\nThe graph of a parabola $y=f(x)$ passes through the points given by their $(x,y)$-coordinates in the table above. The parabola opens downward. What is the $x$-coordinate of the parabola's vertex?\n\nThe $x$-coordinate of the vertex is\n{{field-1}}." :question/worked-solution "Notice that the roots of the parabola are given. They are \n\n$$\nx=-6\\,\\text{and}\\,x=-3.\n$$\n\nIf the coordinates of the vertex are $(h,k),$ then by the average of the roots formula, $h$ is simply the average of the two roots. Therefore, we have\n\n$$\n\\begin{aligned}h & =\\frac{-6+(-3)}{2} \\\\  & =-\\frac{9}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-19978621-b8ff-589b-9021-591fe866d6ca"] :db/ensure [:question/validate]} {:db/id "answer-field-19978621-b8ff-589b-9021-591fe866d6ca" :answer-field/id #uuid "19978621-b8ff-589b-9021-591fe866d6ca" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-dc91623b-454e-5462-b697-e8c2c15d7728" :answer-field/choices ["answer-dc91623b-454e-5462-b697-e8c2c15d7728"] :db/ensure [:answer-field/validate]} {:db/id "answer-dc91623b-454e-5462-b697-e8c2c15d7728" :answer/id #uuid "dc91623b-454e-5462-b697-e8c2c15d7728" :answer/type :answer.type/math :answer/value "-\\frac{9}{2}" :db/ensure [:answer/validate]} {:db/id "question-bac157c9-805d-56d0-9e89-ae7a2f0ad4e6" :question/id #uuid "bac157c9-805d-56d0-9e89-ae7a2f0ad4e6" :question/math-academy-id "q-311909" :question/problem "| **$x$** | $8$ | $10$ | $16$ |\n| --- | --- | --- | --- |\n| **$f(x)$** | $18$ | $12$ | $12$ |\n\nThe graph of a parabola $y=f(x)$ passes through the points given by their $(x,y)$-coordinates in the table above. What is the $x$-coordinate of the parabola's vertex?\n\nThe $x$-coordinate of the vertex is\n{{field-1}}." :question/worked-solution "Notice that the values of $f(x)$ at the points $x=10$ and $x=16$ are equal.\n\n$$\nf(10)=f(16)=12\n$$\n\nTherefore, the parabola's axis of symmetry must be equidistant from the lines $x=10$ and $x=16.$ We can find this by taking the average of these two values.\n\nIf the parabola's vertex is $(h,k),$ then we must have\n\n$$\n\\begin{aligned}h & =\\frac{10+16}{2} \\\\  & =\\frac{26}{2} \\\\  & =13.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-7345a46e-2929-54cc-8c14-7f0c18a62404"] :db/ensure [:question/validate]} {:db/id "answer-field-7345a46e-2929-54cc-8c14-7f0c18a62404" :answer-field/id #uuid "7345a46e-2929-54cc-8c14-7f0c18a62404" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-cb729667-f5e4-54c6-abc0-13882c8347c3" :answer-field/choices ["answer-cb729667-f5e4-54c6-abc0-13882c8347c3"] :db/ensure [:answer-field/validate]} {:db/id "answer-cb729667-f5e4-54c6-abc0-13882c8347c3" :answer/id #uuid "cb729667-f5e4-54c6-abc0-13882c8347c3" :answer/type :answer.type/math :answer/value "13" :db/ensure [:answer/validate]} {:db/id "question-29e68a84-4d10-52b0-a908-447f3d997c55" :question/id #uuid "29e68a84-4d10-52b0-a908-447f3d997c55" :question/math-academy-id "q-311952" :question/problem "| **$x$** | $-4$ | $-1$ | $3$ |\n| --- | --- | --- | --- |\n| **$f(x)$** | $0$ | $-12$ | $0$ |\n\nThe graph of a parabola $y=f(x)$ passes through the points given by their $(x,y)$-coordinates in the table above. What is the $x$-coordinate of the parabola's vertex?\n\nThe $x$-coordinate of the vertex is\n{{field-1}}." :question/worked-solution "Notice that the roots of the parabola are given. They are \n\n$$\nx=-4\\,\\text{and}\\,x=3.\n$$\n\nIf the coordinates of the vertex are $(h,k),$ then by the average of the roots formula, $h$ is simply the average of the two roots. Therefore, we have\n\n$$\n\\begin{aligned}h & =\\frac{-4+3}{2} \\\\  & =-\\frac{1}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b4b013ca-10cd-512b-b1f4-5961f1844f21"] :db/ensure [:question/validate]} {:db/id "answer-field-b4b013ca-10cd-512b-b1f4-5961f1844f21" :answer-field/id #uuid "b4b013ca-10cd-512b-b1f4-5961f1844f21" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-bea0d085-6adf-5a1a-8c0f-b45523b9a881" :answer-field/choices ["answer-bea0d085-6adf-5a1a-8c0f-b45523b9a881"] :db/ensure [:answer-field/validate]} {:db/id "answer-bea0d085-6adf-5a1a-8c0f-b45523b9a881" :answer/id #uuid "bea0d085-6adf-5a1a-8c0f-b45523b9a881" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "question-14e0eb8a-dac7-5f73-9945-6c6e124a2b27" :question/id #uuid "14e0eb8a-dac7-5f73-9945-6c6e124a2b27" :question/math-academy-id "q-311955" :question/problem "| **$x$** | $2$ | $4$ | $8$ |\n| --- | --- | --- | --- |\n| **$f(x)$** | $0$ | $8$ | $0$ |\n\nThe graph of a parabola $y=f(x)$ passes through the points given by their $(x,y)$-coordinates in the table above. The parabola opens downward. What is the $x$-coordinate of the parabola's vertex?\n\nThe $x$-coordinate of the vertex is\n{{field-1}}." :question/worked-solution "Notice that the roots of the parabola are given. They are \n\n$$\nx=2\\,\\text{and}\\,x=8.\n$$\n\nIf the coordinates of the vertex are $(h,k),$ then by the average of the roots formula, $h$ is simply the average of the two roots. Therefore, we have\n\n$$\n\\begin{aligned}h & =\\frac{2+8}{2} \\\\  & =5.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-97705bf0-0c11-56a9-ac7d-d495a513d0f7"] :db/ensure [:question/validate]} {:db/id "answer-field-97705bf0-0c11-56a9-ac7d-d495a513d0f7" :answer-field/id #uuid "97705bf0-0c11-56a9-ac7d-d495a513d0f7" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-0b6917b5-0f23-513d-868b-341a9a33bf03" :answer-field/choices ["answer-0b6917b5-0f23-513d-868b-341a9a33bf03"] :db/ensure [:answer-field/validate]} {:db/id "answer-0b6917b5-0f23-513d-868b-341a9a33bf03" :answer/id #uuid "0b6917b5-0f23-513d-868b-341a9a33bf03" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]}] "assertions" [["question-a9694bfd-2888-58c6-a0ef-19d3c4d9b6a1" :question/id #uuid "a9694bfd-2888-58c6-a0ef-19d3c4d9b6a1"] ["question-a9694bfd-2888-58c6-a0ef-19d3c4d9b6a1" :question/math-academy-id "q-84895"] ["question-a9694bfd-2888-58c6-a0ef-19d3c4d9b6a1" :question/problem "![](images/ce/ce468433e58a99da31fb305428ff478ddb4c91ec6fa260ab1a951979e83ec63c.png)\n\nFind the axis of symmetry for the parabola sketched above."] ["question-a9694bfd-2888-58c6-a0ef-19d3c4d9b6a1" :question/worked-solution "From the graph, we deduce that the roots are ${x}_{1}=-4$ and ${x}_{2}=3.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2}=\\frac{(-4)+3}{2}=-\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the axis of symmetry is $x=-\\frac{1}{2}.$"] ["question-a9694bfd-2888-58c6-a0ef-19d3c4d9b6a1" :question/difficulty :question.difficulty/easy] ["answer-field-d992778b-a9e3-5c64-9ebe-4a79b06c6533" :answer-field/id #uuid "d992778b-a9e3-5c64-9ebe-4a79b06c6533"] ["answer-d7d96b22-da80-52f9-b2f6-8c6bc1bb1aca" :answer/id #uuid "d7d96b22-da80-52f9-b2f6-8c6bc1bb1aca"] ["answer-d7d96b22-da80-52f9-b2f6-8c6bc1bb1aca" :answer/type :answer.type/math] ["answer-d7d96b22-da80-52f9-b2f6-8c6bc1bb1aca" :answer/value "-\\frac{1}{2}"] ["answer-15eb53f7-fe67-57d6-a2b0-7d5a7be0aef3" :answer/id #uuid "15eb53f7-fe67-57d6-a2b0-7d5a7be0aef3"] ["answer-15eb53f7-fe67-57d6-a2b0-7d5a7be0aef3" :answer/type :answer.type/math] ["answer-15eb53f7-fe67-57d6-a2b0-7d5a7be0aef3" :answer/value "-\\frac{1}{3}"] ["answer-383662d8-7c53-56e6-b7ee-0d5555963c70" :answer/id #uuid "383662d8-7c53-56e6-b7ee-0d5555963c70"] ["answer-383662d8-7c53-56e6-b7ee-0d5555963c70" :answer/type :answer.type/math] ["answer-383662d8-7c53-56e6-b7ee-0d5555963c70" :answer/value "-\\frac{2}{3}"] ["answer-a718f457-e6e2-5d83-99f8-1f151c1c909b" :answer/id #uuid "a718f457-e6e2-5d83-99f8-1f151c1c909b"] ["answer-a718f457-e6e2-5d83-99f8-1f151c1c909b" :answer/type :answer.type/math] ["answer-a718f457-e6e2-5d83-99f8-1f151c1c909b" :answer/value "\\frac{1}{2}"] ["answer-efc78a1d-c863-5959-83d0-6a25a98b5920" :answer/id #uuid "efc78a1d-c863-5959-83d0-6a25a98b5920"] ["answer-efc78a1d-c863-5959-83d0-6a25a98b5920" :answer/type :answer.type/math] ["answer-efc78a1d-c863-5959-83d0-6a25a98b5920" :answer/value "\\frac{1}{3}"] ["answer-field-d992778b-a9e3-5c64-9ebe-4a79b06c6533" :answer-field/key "selection"] ["answer-field-d992778b-a9e3-5c64-9ebe-4a79b06c6533" :answer-field/type :answer-field.type/radio] ["answer-field-d992778b-a9e3-5c64-9ebe-4a79b06c6533" :answer-field/correct "answer-d7d96b22-da80-52f9-b2f6-8c6bc1bb1aca"] ["answer-field-d992778b-a9e3-5c64-9ebe-4a79b06c6533" :answer-field/choices "answer-d7d96b22-da80-52f9-b2f6-8c6bc1bb1aca"] ["answer-field-d992778b-a9e3-5c64-9ebe-4a79b06c6533" :answer-field/choices "answer-15eb53f7-fe67-57d6-a2b0-7d5a7be0aef3"] ["answer-field-d992778b-a9e3-5c64-9ebe-4a79b06c6533" :answer-field/choices "answer-383662d8-7c53-56e6-b7ee-0d5555963c70"] ["answer-field-d992778b-a9e3-5c64-9ebe-4a79b06c6533" :answer-field/choices "answer-a718f457-e6e2-5d83-99f8-1f151c1c909b"] ["answer-field-d992778b-a9e3-5c64-9ebe-4a79b06c6533" :answer-field/choices "answer-efc78a1d-c863-5959-83d0-6a25a98b5920"] ["question-a9694bfd-2888-58c6-a0ef-19d3c4d9b6a1" :question/answer-fields "answer-field-d992778b-a9e3-5c64-9ebe-4a79b06c6533"] [17592186110725 :knowledge-point/questions "question-a9694bfd-2888-58c6-a0ef-19d3c4d9b6a1"] ["question-f8e7577e-52b0-551a-a683-aebcdeb0ba63" :question/id #uuid "f8e7577e-52b0-551a-a683-aebcdeb0ba63"] ["question-f8e7577e-52b0-551a-a683-aebcdeb0ba63" :question/math-academy-id "q-30510"] ["question-f8e7577e-52b0-551a-a683-aebcdeb0ba63" :question/problem "![](images/6e/6ecca5e6b96cd7e0de0510abf26b3fe80c6f33322460b9bf4448f4b9c3eb8442.png)\n\nFind the axis of symmetry for the parabola sketched above."] ["question-f8e7577e-52b0-551a-a683-aebcdeb0ba63" :question/worked-solution "From the graph, we deduce that the roots are ${x}_{1}=-1$ and ${x}_{2}=2.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2}=\\frac{(-1)+2}{2}=\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the axis of symmetry is $x=\\frac{1}{2}.$"] ["question-f8e7577e-52b0-551a-a683-aebcdeb0ba63" :question/difficulty :question.difficulty/easy] ["answer-field-1123def6-8dc6-58e4-8f1b-899f255bbcc1" :answer-field/id #uuid "1123def6-8dc6-58e4-8f1b-899f255bbcc1"] ["answer-e4bcb35f-829f-5234-a877-ca4c41be4fee" :answer/id #uuid "e4bcb35f-829f-5234-a877-ca4c41be4fee"] ["answer-e4bcb35f-829f-5234-a877-ca4c41be4fee" :answer/type :answer.type/math] ["answer-e4bcb35f-829f-5234-a877-ca4c41be4fee" :answer/value "x=-1"] ["answer-3f931ccf-9536-5f59-b52c-f7140f39f8f3" :answer/id #uuid "3f931ccf-9536-5f59-b52c-f7140f39f8f3"] ["answer-3f931ccf-9536-5f59-b52c-f7140f39f8f3" :answer/type :answer.type/math] ["answer-3f931ccf-9536-5f59-b52c-f7140f39f8f3" :answer/value "x=-2"] ["answer-c46a3c63-7ce2-5171-80e2-c72b810d3bbb" :answer/id #uuid "c46a3c63-7ce2-5171-80e2-c72b810d3bbb"] ["answer-c46a3c63-7ce2-5171-80e2-c72b810d3bbb" :answer/type :answer.type/math] ["answer-c46a3c63-7ce2-5171-80e2-c72b810d3bbb" :answer/value "x=-\\frac{1}{2}"] ["answer-4f0dd0eb-fb35-581b-aab9-f1d675a126de" :answer/id #uuid "4f0dd0eb-fb35-581b-aab9-f1d675a126de"] ["answer-4f0dd0eb-fb35-581b-aab9-f1d675a126de" :answer/type :answer.type/math] ["answer-4f0dd0eb-fb35-581b-aab9-f1d675a126de" :answer/value "x=1"] ["answer-14015542-fee2-5fec-96da-f18d0ae334d4" :answer/id #uuid "14015542-fee2-5fec-96da-f18d0ae334d4"] ["answer-14015542-fee2-5fec-96da-f18d0ae334d4" :answer/type :answer.type/math] ["answer-14015542-fee2-5fec-96da-f18d0ae334d4" :answer/value "x=\\frac{1}{2}"] ["answer-field-1123def6-8dc6-58e4-8f1b-899f255bbcc1" :answer-field/key "selection"] ["answer-field-1123def6-8dc6-58e4-8f1b-899f255bbcc1" :answer-field/type :answer-field.type/radio] ["answer-field-1123def6-8dc6-58e4-8f1b-899f255bbcc1" :answer-field/correct "answer-14015542-fee2-5fec-96da-f18d0ae334d4"] ["answer-field-1123def6-8dc6-58e4-8f1b-899f255bbcc1" :answer-field/choices "answer-e4bcb35f-829f-5234-a877-ca4c41be4fee"] ["answer-field-1123def6-8dc6-58e4-8f1b-899f255bbcc1" :answer-field/choices "answer-3f931ccf-9536-5f59-b52c-f7140f39f8f3"] ["answer-field-1123def6-8dc6-58e4-8f1b-899f255bbcc1" :answer-field/choices "answer-c46a3c63-7ce2-5171-80e2-c72b810d3bbb"] ["answer-field-1123def6-8dc6-58e4-8f1b-899f255bbcc1" :answer-field/choices "answer-4f0dd0eb-fb35-581b-aab9-f1d675a126de"] ["answer-field-1123def6-8dc6-58e4-8f1b-899f255bbcc1" :answer-field/choices "answer-14015542-fee2-5fec-96da-f18d0ae334d4"] ["question-f8e7577e-52b0-551a-a683-aebcdeb0ba63" :question/answer-fields "answer-field-1123def6-8dc6-58e4-8f1b-899f255bbcc1"] [17592186110725 :knowledge-point/questions "question-f8e7577e-52b0-551a-a683-aebcdeb0ba63"] ["question-6e6642fc-4b0f-571e-8c66-e87cc2512b11" :question/id #uuid "6e6642fc-4b0f-571e-8c66-e87cc2512b11"] ["question-6e6642fc-4b0f-571e-8c66-e87cc2512b11" :question/math-academy-id "q-220354"] ["question-6e6642fc-4b0f-571e-8c66-e87cc2512b11" :question/problem "![](images/bd/bd46cb7a3139ccb19b7f65bab927ef8c56ba075520262649d6fa196cdab8cc81.png)\n\nThe graph above shows a parabola. The $x$-coordinates of $A$ and $B$ are $-\\frac{16}{5}$ and $\\frac{5}{2},$ respectively.  Find the axis of symmetry of the parabola.\n\nThe axis of symmetry is $x=$\n{{field-1}}."] ["question-6e6642fc-4b0f-571e-8c66-e87cc2512b11" :question/worked-solution "We're given that the roots of the parabola are \n ${x}_{1}=-\\frac{16}{5}$ and ${x}_{2}=\\frac{5}{2}.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2} \\\\  & =\\frac{(-\\frac{16}{5}+\\frac{5}{2})}{2} \\\\  & =\\frac{(-\\frac{32}{10}+\\frac{25}{10})}{2} \\\\  & =\\frac{(-\\frac{7}{10})}{2} \\\\  & =-\\frac{7}{20}.\\end{aligned}\n$$\n\nTherefore, the axis of symmetry is $x=-\\frac{7}{20}.$"] ["question-6e6642fc-4b0f-571e-8c66-e87cc2512b11" :question/difficulty :question.difficulty/hard] ["answer-field-79bc61fa-11bd-5db1-aa6e-3d865e60342d" :answer-field/id #uuid "79bc61fa-11bd-5db1-aa6e-3d865e60342d"] ["answer-5ebf46c9-f938-50a8-9cc1-97df4784c6aa" :answer/id #uuid "5ebf46c9-f938-50a8-9cc1-97df4784c6aa"] ["answer-5ebf46c9-f938-50a8-9cc1-97df4784c6aa" :answer/type :answer.type/math] ["answer-5ebf46c9-f938-50a8-9cc1-97df4784c6aa" :answer/value "-\\frac{7}{20}"] ["answer-field-79bc61fa-11bd-5db1-aa6e-3d865e60342d" :answer-field/key "field-1"] ["answer-field-79bc61fa-11bd-5db1-aa6e-3d865e60342d" :answer-field/type :answer-field.type/blank] ["answer-field-79bc61fa-11bd-5db1-aa6e-3d865e60342d" :answer-field/correct "answer-5ebf46c9-f938-50a8-9cc1-97df4784c6aa"] ["answer-field-79bc61fa-11bd-5db1-aa6e-3d865e60342d" :answer-field/choices "answer-5ebf46c9-f938-50a8-9cc1-97df4784c6aa"] ["question-6e6642fc-4b0f-571e-8c66-e87cc2512b11" :question/answer-fields "answer-field-79bc61fa-11bd-5db1-aa6e-3d865e60342d"] [17592186110725 :knowledge-point/questions "question-6e6642fc-4b0f-571e-8c66-e87cc2512b11"] ["question-da0e0865-56b2-565d-ac33-deaee1268cf4" :question/id #uuid "da0e0865-56b2-565d-ac33-deaee1268cf4"] ["question-da0e0865-56b2-565d-ac33-deaee1268cf4" :question/math-academy-id "q-84903"] ["question-da0e0865-56b2-565d-ac33-deaee1268cf4" :question/problem "Find the axis of symmetry of the parabola $y=(7-5x)(x+1).$"] ["question-da0e0865-56b2-565d-ac33-deaee1268cf4" :question/worked-solution "From the equation $y=(7-5x)(x+1),$ we find that the roots of the parabola are ${x}_{1}=\\frac{7}{5}$ and ${x}_{2}=-1.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2} \\\\  & =\\frac{(\\frac{7}{5}-1)}{2} \\\\  & =\\frac{(\\frac{7}{5}-\\frac{5}{5})}{2} \\\\  & =\\frac{(\\frac{2}{5})}{2} \\\\  & =\\frac{1}{5}\\end{aligned}\n$$\n\nTherefore, the axis of symmetry is $x=\\frac{1}{5}.$"] ["question-da0e0865-56b2-565d-ac33-deaee1268cf4" :question/difficulty :question.difficulty/moderate] ["answer-field-707a53ec-3f89-531c-a47b-914f51a9c97c" :answer-field/id #uuid "707a53ec-3f89-531c-a47b-914f51a9c97c"] ["answer-12226c0d-85bd-508b-82d8-13bf97d8f83b" :answer/id #uuid "12226c0d-85bd-508b-82d8-