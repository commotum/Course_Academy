#{[{:db/id #edb/ref 17592186389804 :knowledge-point/_questions [{:db/id #edb/ref 17592186198274 :knowledge-point/id #uuid "6290e701-b4ea-5a86-ab7e-7371c5bdc11e" :knowledge-point/title "Visualizing Unions of Uncountable Families of Indexed Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b35462e3-d90d-5229-9bb7-a180bdbea833" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/aa/aaa04c2578557d03dd144c27e6a5c223126830ba2a3f8288adc9239daf604e55.png" :db/id #edb/ref 17592186389806} {:answer/id #uuid "32da30c7-4f73-5968-bd10-234d5aa6eb9d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/98/98077ef737a2487f9e480b7ffd42376785c5681e2651b98e7b71abb4e645d876.png" :db/id #edb/ref 17592186389807} {:answer/id #uuid "94b8b364-2f47-562b-be4f-8d6d5b53993c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/36/36b36ac05cb1054e198f2e40a2d0ffdd40e952abaa8ddf5c946a38fde946adc8.png" :db/id #edb/ref 17592186389808} {:answer/id #uuid "1da4c351-345b-51fc-b9bc-106b693a793a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/4a/4a81de1a698eedf6a636d66b68a7c62efa69d1d026a961ae97ab5ecc2ef9828d.png" :db/id #edb/ref 17592186389809} {:answer/id #uuid "f684dbe0-2990-5f82-837b-23d70335f3f3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/74/749f4fb3a6416147cdd69c08bf806c28e2112929453bb8ae405c48452d82126b.png" :db/id #edb/ref 17592186389810}] :answer-field/correct {:answer/id #uuid "1da4c351-345b-51fc-b9bc-106b693a793a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/4a/4a81de1a698eedf6a636d66b68a7c62efa69d1d026a961ae97ab5ecc2ef9828d.png" :db/id #edb/ref 17592186389809} :answer-field/id #uuid "6a3b75ec-dbba-566e-adfa-fb7b15c6d5b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389805}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "62556693-fd48-5895-851c-d4aab5200ee0" :question/math-academy-id "q-177650" :question/problem "Let $I=[0,1]⊂R$ and ${X}_{i}=[0,i]\\times \\{i\\}.$ Which of the following represents ${⋃}_{i\\in I}{X}_{i}?$" :question/worked-solution "Recall that the union of a family of indexed sets consists of those elements that belong to *at least one* set:\n\n$$\n{⋃}_{i\\in I}{A}_{i}=\\{x\\,:\\,x\\in {A}_{k}\\,\\,\\text{for at least one}\\,\\,k\\in I\\}\n$$\n\nLet's now write down one of our indexed sets. For example, if $i=0.5,$ we have \n\n$$\n{X}_{0.5}=[0,0.5]\\times \\{0.5\\}=\\{(k,0.5)\\,:\\,k\\in [0,0.5]\\}.\n$$\n\nThis represents a horizontal line segment from the point $(0,0.5)$ to the point $(0.5,0.5)$ in the coordinate plane, as shown below.\n\n![](images/75/7587daeaea45c5ef3449ecb676133c60bbedb7819308783bac835f3ae9c6883c.png)\n\nIn general,\n\n$$\n{X}_{i}=[0,i]\\times \\{i\\}=\\{(k,i)\\,:\\,k\\in [0,i]\\}\n$$\n\nis the horizontal line segment from the point $(0,i)$ to the point $(i,i).$ \n\n![](images/b9/b926204a3d58b25889f1c79dd0f65c1ea990c67bc88e869004396a77970e8dd4.png)\n\nAs $i$ runs over $I,$ these line segments sweep the following triangle that represents the union ${⋃}_{i\\in I}{X}_{i}:$\n\n![](images/4a/4a81de1a698eedf6a636d66b68a7c62efa69d1d026a961ae97ab5ecc2ef9828d.png)"}] [{:db/id #edb/ref 17592186389895 :knowledge-point/_questions [{:db/id #edb/ref 17592186198272 :knowledge-point/id #uuid "c3a2b291-c6dd-58c8-a10f-d851511d7bfc" :knowledge-point/title "Sketching Cartesian Products in the Coordinate Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "63212b76-4dd2-5413-b5ba-4e9195ab76e3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/82/82f9ecf98b8b2b4e5f75b3130e8483354c93922dc3a942e271562ac1ad17438e.png" :db/id #edb/ref 17592186389897} {:answer/id #uuid "4a858bfb-ee22-5b56-9050-fa66d28f0274" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e0/e0fa3e717af02a353db77ae8b357dc338c975166fb5fbe6c5c1309d1c1f511f2.png" :db/id #edb/ref 17592186389898} {:answer/id #uuid "7442f1d4-b621-53b9-a885-39076816c0b2" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c2/c28ba6b0da8364f4e7f157b58827384f9e138a2c0fc53558ce7ab2df2f646747.png" :db/id #edb/ref 17592186389899} {:answer/id #uuid "281cc561-5401-5252-9068-734db096e5bd" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/07/075454dae9ed36967a70537cdf3a3f59931cdd81671ff4059658d2e0df438898.png" :db/id #edb/ref 17592186389900} {:answer/id #uuid "b42501d9-b115-5c79-8921-c1756b26a1c9" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/29/2922ff5e3a32e01fbc292898c88c1d8eca8d933897d4b9d3c1694b6f5cbeb2a2.png" :db/id #edb/ref 17592186389901}] :answer-field/correct {:answer/id #uuid "281cc561-5401-5252-9068-734db096e5bd" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/07/075454dae9ed36967a70537cdf3a3f59931cdd81671ff4059658d2e0df438898.png" :db/id #edb/ref 17592186389900} :answer-field/id #uuid "9f377c8c-6598-5676-856c-726dc4aca072" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389896}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "734eb671-4f30-5ac2-952a-94e297467ed9" :question/math-academy-id "q-181306" :question/problem "Which of the following is a representation of the set $S=[-1,1]\\times \\{-1,1\\}$ in the Cartesian plane?" :question/worked-solution "The Cartesian product $A\\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\n$$\nA\\times B=\\{(a,b)\\,:\\,a\\in A,\\,b\\in B\\}\n$$\n\nIn this case, the set \n\n$$\nS=[-1,1]\\times \\{-1,1\\}\n$$\n\ncontains every point in ${R}^{2}$ whose $x$-coordinate is any real number in the interval $[-1,1]$ and whose $y$-coordinate is either $-1$ or $1.$\n\n$$\nS=\\{(x,y)\\,:\\,x\\in [-1,1],\\,y\\in \\{-1,1\\}\\}.\n$$\n\nTo visualize $S$, consider ${S}_{1}⊂S$ containing all points whose $x$-coordinate is any real number in the interval $[-1,1]$ and whose $y$-coordinate equals $-1$\n\n$$\n{S}_{1}=\\{(x,-1)\\,:\\,x\\in [-1,1]\\}\n$$\n\nThis set is represented by the line segment shown below.\n\n![](images/3e/3ed05ffc58aad1a6c75e7862c1175f497fb14870e6650cc6c4ce01c3df091d8b.png)\n\nNext, consider ${S}_{2}⊂S$ containing all points whose $x$-coordinate is any real number in the interval $[-1,1]$ and whose $y$-coordinate equals $1$\n\n$$\n{S}_{2}=\\{(x,1)\\,:\\,x\\in [-1,1]\\}.\n$$\n\nThis set is represented by the line segment shown below.\n\n![](images/0f/0f57920b2532177b0d64ac3dc95feb6a476bb385112d736d702895862e7de2b2.png)\n\nOur Cartesian product is the *union* of these subsets:\n\n$$\nS={S}_{1}\\cup {S}_{2}\n$$\n\nTherefore, $S$ can be represented by the two line segments shown below.\n\n![](images/07/075454dae9ed36967a70537cdf3a3f59931cdd81671ff4059658d2e0df438898.png)"}] [{:db/id #edb/ref 17592186287749 :knowledge-point/_questions [{:db/id #edb/ref 17592186198273 :knowledge-point/id #uuid "e2aee319-68d6-54f7-8023-b24d32610bc4" :knowledge-point/title "Sketching Cartesian Products of Special Sets in the Coordinate Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f001f66-21ad-5810-9a24-3727a01a58d3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/95/95c7144f229cc34fcb98b1c1fa8bda8af8ca9dff68c7ae466e388ce3e525bc85.png" :db/id #edb/ref 17592186285523} {:answer/id #uuid "5829deab-1ed2-5ddf-959a-31d73972126d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ec/eceb9c773d52b8bae73837252a885258b5a9b735cf3f24954b8755049d7cf07d.png" :db/id #edb/ref 17592186285596} {:answer/id #uuid "64ba1242-9f38-5065-b2a2-156c1dffa463" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/89/89ac9e71d8152097657f0c01daecf2b894dc142db4ba27fbfadcb8ded6e9cb19.png" :db/id #edb/ref 17592186285703} {:answer/id #uuid "6e22185e-2dca-5e48-a97a-c408b9904280" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/45/4535a7c6aa7fe8f358d3463b4654c735e53df373d1001916dc035290ca54f969.png" :db/id #edb/ref 17592186285800} {:answer/id #uuid "97b4fd05-3101-5cc2-857b-8c7b3c842a34" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/43/43f665cebf4c3af1f1178d94b4ceec5d60bcfd4e61ebf955ed43cb603f8232b2.png" :db/id #edb/ref 17592186286171}] :answer-field/correct {:answer/id #uuid "6e22185e-2dca-5e48-a97a-c408b9904280" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/45/4535a7c6aa7fe8f358d3463b4654c735e53df373d1001916dc035290ca54f969.png" :db/id #edb/ref 17592186285800} :answer-field/id #uuid "0ea3661b-4d1c-56cf-956a-8769e8d2e497" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287173}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5558c8b0-025f-54bf-b54a-ad58d686884f" :question/math-academy-id "q-181770" :question/problem "Which of the following is a representation of the set $S=Z\\times R$ in the Cartesian plane?" :question/worked-solution "The Cartesian product $A\\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\n$$\nA\\times B=\\{(a,b)\\,:\\,a\\in A,\\,b\\in B\\}\n$$\n\nIn this case, the set \n\n$$\nS=Z\\times R\n$$\n\n \ncontains every point in ${R}^{2}$ whose $x$-coordinate is an integer number and whose $y$-coordinate is any real number.\n\n$$\nS=\\{(x,y)\\,:\\,x\\in Z,\\,y\\in R\\}\n$$\n\nTo visualize $S,$ consider ${S}_{-1}⊂S$ containing all points whose $x$-coordinate equals $-1$ and whose $y$-coordinate is any real number.\n\n$$\n{S}_{-1}=\\{(-1,y)\\,:\\,y\\in R\\}\n$$\n\nWe can represent ${S}_{-1}$ in the plane as follows:\n\n![](images/3f/3fdfed680e3fb46adbe8a70aac86682aacb85d43e0675923f87658635fc89a1e.png)\n\nNext, consider ${S}_{1}⊂S$ containing all points whose $x$-coordinate equals $1$ and whose $y$-coordinate is any real number.\n\n$$\n{S}_{1}=\\{(1,y)\\,:\\,y\\in R\\}.\n$$\n\nWe can represent ${S}_{1}$ in the plane as follows:\n\n![](images/7f/7fbda500ecca7e18c9db9939ad78d4dcc6bf488bc7fc4de1137e764ce21a0254.png)\n\nWe can create the subsets $…,{S}_{-3},{S}_{-2},{S}_{0},{S}_{2},{S}_{3},…$ similarly. Our Cartesian product consists of the *union* of these subsets:\n\n$$\n\\begin{aligned}R\\times N & =…{S}_{-2}\\cup {S}_{-1}\\cup {S}_{0}\\cup {S}_{1}\\cup {S}_{2}… \\\\  & ={⋃}_{i\\in Z}{S}_{i}\\end{aligned}\n$$\n\nTherefore, we can visualize $Z\\times R$ as the set of vertical lines shown in the diagram below.\n\n![](images/45/4535a7c6aa7fe8f358d3463b4654c735e53df373d1001916dc035290ca54f969.png)"}] [{:db/id #edb/ref 17592186287752 :knowledge-point/_questions [{:db/id #edb/ref 17592186198273 :knowledge-point/id #uuid "e2aee319-68d6-54f7-8023-b24d32610bc4" :knowledge-point/title "Sketching Cartesian Products of Special Sets in the Coordinate Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "146d8845-efd5-5bc8-9da2-601d9879cc45" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/66/664f327f59e76cb22e1b9bd0a83f84c24e75ad6a0d176532437f629bf80bfc29.png" :db/id #edb/ref 17592186284969} {:answer/id #uuid "a2618d61-fba9-5cd1-88a1-8d9652f5d74a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/89/89ac9e71d8152097657f0c01daecf2b894dc142db4ba27fbfadcb8ded6e9cb19.png" :db/id #edb/ref 17592186286277} {:answer/id #uuid "a2f95c53-3e3f-565a-9a4b-ea11c7c260f5" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/4d/4ddec65745de14217112f6365d9dd372df5a24a13ef8bedc8db592c9ee18cab1.png" :db/id #edb/ref 17592186286281} {:answer/id #uuid "a3e480ca-6b20-5449-ba68-f8ceac3b823c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/05/05323cccad18bb4664fe74112ff312f53ef3e12016be6f7b30ca9146f2ba6119.png" :db/id #edb/ref 17592186286290} {:answer/id #uuid "df934188-ff40-536d-b7a9-b50cdf29ebbf" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/45/4535a7c6aa7fe8f358d3463b4654c735e53df373d1001916dc035290ca54f969.png" :db/id #edb/ref 17592186286828}] :answer-field/correct {:answer/id #uuid "a2618d61-fba9-5cd1-88a1-8d9652f5d74a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/89/89ac9e71d8152097657f0c01daecf2b894dc142db4ba27fbfadcb8ded6e9cb19.png" :db/id #edb/ref 17592186286277} :answer-field/id #uuid "0402905b-109e-5a9b-b5e8-b00b20ff4037" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287145}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a66eead9-d6a1-5d8c-a676-bee7fbbe7fc5" :question/math-academy-id "q-181777" :question/problem "Which of the following is a representation of the set $S=R\\times Z$ in the Cartesian plane?" :question/worked-solution "The Cartesian product $A\\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\n$$\nA\\times B=\\{(a,b)\\,:\\,a\\in A,\\,b\\in B\\}\n$$\n\nIn this case, the set \n\n$$\nS=R\\times Z\n$$\n\n \ncontains every point in ${R}^{2}$ whose $x$-coordinate is a real number and whose $y$-coordinate is an integer number.\n\n$$\nS=\\{(x,y)\\,:\\,x\\in R,\\,y\\in Z\\}\n$$\n\nTo visualize $S,$ consider ${S}_{-1}⊂S$ containing all points whose $x$-coordinate is any real number and whose $y$-coordinate equals $-1.$\n\n$$\n{S}_{-1}=\\{(x,-1)\\,:\\,x\\in R\\}\n$$\n\nWe can represent ${S}_{-1}$ in the plane as follows:\n\n![](images/8e/8e677c814756c4818c25da450d789c974787df60cf4bb18017a96593d3ecc180.png)\n\nNext, consider ${S}_{1}⊂S$ containing all points whose $x$-coordinate is any real number and whose $y$-coordinate equals $1.$\n\n$$\n{S}_{1}=\\{(x,1)\\,:\\,x\\in R\\}.\n$$\n\nWe can represent ${S}_{1}$ in the plane as follows:\n\n![](images/f9/f99beeb00c070048ee4ee7c1b6c9e077d7d4e0f3fd9e63aa12b5b58588e14dbb.png)\n\nWe can create the subsets $…{S}_{-3},{S}_{-2},{S}_{0},{S}_{2},{S}_{3},…$ similarly. Our Cartesian product consists of the *union* of these subsets:\n\n$$\n\\begin{aligned}R\\times Z & =…{S}_{-2}\\cup {S}_{-1}\\cup {S}_{0}\\cup {S}_{1}\\cup {S}_{2}\\cup … \\\\  & ={⋃}_{i\\in Z}{S}_{i}\\end{aligned}\n$$\n\nTherefore, we can visualize $R\\times Z$ as the set of horizontal lines shown in the diagram below.\n\n![](images/89/89ac9e71d8152097657f0c01daecf2b894dc142db4ba27fbfadcb8ded6e9cb19.png)"}] [{:db/id #edb/ref 17592186287875 :knowledge-point/_questions [{:db/id #edb/ref 17592186198275 :knowledge-point/id #uuid "5793f07d-e0de-5707-a5e1-32d657244e0b" :knowledge-point/title "Visualizing Intersections of Uncountable Families of Indexed Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06ad6e0a-c6f3-535a-b438-cd7ef33e552e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/47/47ee12b24246473a45e057d4da6dac5190a4eab23e18bb37bef494bf07627daa.png" :db/id #edb/ref 17592186284841} {:answer/id #uuid "67a76b1b-677d-5667-b8f6-e17c0a0eb5ea" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/23/236d10f31265b400036e1ddeafa122991bcae1ea878af8b300003fb11acfa85b.png" :db/id #edb/ref 17592186285734} {:answer/id #uuid "7eb39817-73c5-556d-a591-eb6ab10a7c54" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ef/efb6d92ea0dc70fa0cbd9d82ea838b41a4eaab6ee2fc32c6fada9258a4154680.png" :db/id #edb/ref 17592186285956} {:answer/id #uuid "f569f51b-ab90-59de-bd38-4bd9ff476d5f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/37/37de777f63941a62b003a4c600a40df648b3d39ce3c1dfc753c6f406fe230330.png" :db/id #edb/ref 17592186287035} {:answer/id #uuid "fa732ef5-7dfb-5052-8ef8-ad4126c8c625" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/5e/5e474959f4172f2a3dc7d104a5b7e27a8eece4fc1f13421fefdfdfc2e139c139.png" :db/id #edb/ref 17592186287074}] :answer-field/correct {:answer/id #uuid "67a76b1b-677d-5667-b8f6-e17c0a0eb5ea" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/23/236d10f31265b400036e1ddeafa122991bcae1ea878af8b300003fb11acfa85b.png" :db/id #edb/ref 17592186285734} :answer-field/id #uuid "053ceb7f-15f7-5209-b489-364d6abf0a9b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287154}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "673cc09b-aa8d-5b71-ab95-ac8a33662caf" :question/math-academy-id "q-184507" :question/problem "Let $I=[0,1]⊂R$ and ${X}_{i}=[0,2]\\times [-i,0].$ Which of the following represents ${⋂}_{i\\in I}{X}_{i}?$" :question/worked-solution "Recall that the intersection of a family of indexed sets consists of those elements that belong to *all* the sets:\n\n$$\n{⋂}_{i\\in I}{A}_{i}=\\{x\\,:\\,x\\in {A}_{k}\\,\\,\\text{for all}\\,\\,k\\in I\\}\n$$\n\nLet's now write down one of our indexed sets. For example, if $i=0.5,$ we have \n\n$$\n{X}_{0.5}=[0,2]\\times [-0.5,0]=\\{(a,b)\\,:\\,a\\in [0,2],b\\in [-0.5,0]\\}.\n$$\n\nThis represents a rectangle whose vertices are at $(0,0),$ $(2,0),$ $(2,-0.5),$ and $(0,-0.5)$ in the coordinate plane, as shown below.\n\n![](images/58/5837864bfcc40e680cf62b43c0e3d145ba05b1f25e1ccae2f4788902d030d927.png)\n\nIn general,\n\n$$\n{X}_{i}=[0,2]\\times [-i,0]=\\{(a,b)\\,:\\,a\\in [0,2],b\\in [-i,0]\\}\n$$\n\nis the rectangle whose vertices are at $(0,0),$ $(2,0),$ $(2,-i),$ and $(0,-i).$\n\n![](images/f0/f0c20436f03db4b0003d087827cefbd76506af423da3f0a3042082b5afeb4b58.png)\n\nThe intersection of all these rectangles is the line segment $[0,2]\\times \\{0\\}:$\n\n![](images/23/236d10f31265b400036e1ddeafa122991bcae1ea878af8b300003fb11acfa85b.png)"}]}
