#{[{:db/id #edb/ref 17592186204445 :knowledge-point/_questions [{:db/id #edb/ref 17592186204011 :knowledge-point/id #uuid "83df73fc-c0cc-5605-9b39-453de0c37cc7" :knowledge-point/title "Calculating S(x,y) Using the Shortcut Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e208d22-eade-509b-b9cd-26f67b90dab5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "975" :db/id #edb/ref 17592186539565}] :answer-field/correct {:answer/id #uuid "2e208d22-eade-509b-b9cd-26f67b90dab5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "975" :db/id #edb/ref 17592186539565} :answer-field/id #uuid "dfeb687f-763d-54c4-aef3-8444a3902349" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186202606}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d5e13c72-a4ef-5310-a416-6c1b8d1065c7" :question/math-academy-id "q-251491" :question/problem "Consider two sets of $25$ paired observations ${x}_{1},{x}_{2},…,{x}_{25},$ and ${y}_{1},{y}_{2},…,{y}_{25}.$ You are given that\n\n$$\n\\begin{aligned} & {\\sum }_{i=1}^{25}{x}_{i}=250, \\\\  & {\\sum }_{i=1}^{25}{y}_{i}=265, \\\\  & {\\sum }_{i=1}^{25}{x}_{i}{y}_{i}=3\\,625.\\end{aligned}\n$$\n\nThen, ${S}_{xy}=$\n{{field-1}}." :question/worked-solution "Given a set of $n$ paired observations ${x}_{1},{x}_{2},…,{x}_{n}$ and ${y}_{1},{y}_{2},…,{y}_{n},$ the statistic ${S}_{xy}$ be calculated as follows:\n\n$$\n\\begin{aligned}{S}_{xy} & ={\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & ={\\sum }_{i=1}^{n}{x}_{i}{y}_{i}-\\frac{1}{n}({\\sum }_{i=1}^{n}{x}_{i})({\\sum }_{i=1}^{n}{y}_{i}).\\end{aligned}\n$$\n\nSubstituting the given statistics in the above formula, we get\n\n$$\n\\begin{aligned}{S}_{xy} & =3\\,625-\\frac{1}{25}(250)(265) \\\\  & =3\\,625-2\\,650 \\\\  & =975.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186540115 :knowledge-point/_questions [{:db/id #edb/ref 17592186204011 :knowledge-point/id #uuid "83df73fc-c0cc-5605-9b39-453de0c37cc7" :knowledge-point/title "Calculating S(x,y) Using the Shortcut Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "386c5691-b5b0-5909-a9d6-cd57208e04fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "186" :db/id #edb/ref 17592186539582}] :answer-field/correct {:answer/id #uuid "386c5691-b5b0-5909-a9d6-cd57208e04fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "186" :db/id #edb/ref 17592186539582} :answer-field/id #uuid "73feca10-d97d-5b59-8725-6847129335cf" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186539965}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fe1475b2-e88a-5639-9c34-aefc361e0ff5" :question/math-academy-id "q-251794" :question/problem "Consider two sets of $14$ paired observations ${x}_{1},{x}_{2},…,{x}_{14},$ and ${y}_{1},{y}_{2},…,{y}_{14}.$ You are given that\n\n$$\n\\begin{aligned} & {\\sum }_{i=1}^{14}{x}_{i}=157, \\\\  & {\\sum }_{i=1}^{14}{y}_{i}=182, \\\\  & {\\sum }_{i=1}^{14}{x}_{i}{y}_{i}=2\\,227.\\end{aligned}\n$$\n\nThen, ${S}_{xy}=$\n{{field-1}}." :question/worked-solution "Given a set of $n$ paired observations ${x}_{1},{x}_{2},…,{x}_{n}$ and ${y}_{1},{y}_{2},…,{y}_{n},$ the statistic ${S}_{xy}$ be calculated as follows:\n\n$$\n\\begin{aligned}{S}_{xy} & ={\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & ={\\sum }_{i=1}^{n}{x}_{i}{y}_{i}-\\frac{1}{n}({\\sum }_{i=1}^{n}{x}_{i})({\\sum }_{i=1}^{n}{y}_{i}).\\end{aligned}\n$$\n\nSubstituting the given statistics in the above formula, we get\n\n$$\n\\begin{aligned}{S}_{xy} & =2\\,227-\\frac{1}{14}(157)(182) \\\\  & =2\\,227-2\\,041 \\\\  & =186.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186536838 :knowledge-point/_questions [{:db/id #edb/ref 17592186204010 :knowledge-point/id #uuid "1f0ed04b-f011-5818-952d-425a19e0cd5c" :knowledge-point/title "Calculating Sums of Squares Using the Shortcut Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e22bc458-30f2-56c5-a752-2720115543c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1250" :db/id #edb/ref 17592186536636}] :answer-field/correct {:answer/id #uuid "e22bc458-30f2-56c5-a752-2720115543c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1250" :db/id #edb/ref 17592186536636} :answer-field/id #uuid "0ae99c74-d6dc-56f1-8e0e-a0b4df319323" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186536704}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5cbb4944-93ba-5c18-a003-1720623144e5" :question/math-academy-id "q-251837" :question/problem "Consider two sets of $27$ paired observations ${x}_{1},{x}_{2},…,{x}_{27},$ and ${y}_{1},{y}_{2},…,{y}_{27}.$ You are given that\n\n$$\n\\begin{aligned} & {\\sum }_{i=1}^{27}{x}_{i}=540,\\,{\\sum }_{i=1}^{27}{y}_{i}=567, \\\\  & {\\sum }_{i=1}^{27}{x}_{i}^{2}=12\\,050,\\,{\\sum }_{i=1}^{27}{y}_{i}^{2}=14\\,107.\\end{aligned}\n$$\n\nCalculate the sum of the squared deviations from the mean for the points ${x}_{i}.$\n\n${S}_{xx}=$\n{{field-1}}" :question/worked-solution "Given a set of $n$ paired observations ${x}_{1},{x}_{2},…,{x}_{n}$ and ${y}_{1},{y}_{2},…,{y}_{n},$ the sum of squared deviations from the mean for the data ${x}_{i}$ can be calculated as follows:\n\n$$\n\\begin{aligned}{S}_{xx} & ={\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})^{2} \\\\  & ={\\sum }_{i=1}^{n}{x}_{i}^{2}-\\frac{1}{n}{({\\sum }_{i=1}^{n}{x}_{i})}^{2}\\end{aligned}\n$$\n\nSubstituting the given statistics in the above formula, we get\n\n$$\n\\begin{aligned}{S}_{xx} & =12\\,050-\\frac{1}{27}(540)^{2} \\\\  & =12\\,050-10\\,800 \\\\  & =1\\,250.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186540110 :knowledge-point/_questions [{:db/id #edb/ref 17592186204009 :knowledge-point/id #uuid "714000f9-caea-57a3-a8cb-6b8ec99960d1" :knowledge-point/title "Calculating Variance and Covariance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16428388-adc9-5bc3-a420-1ca62578bc67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186539525}] :answer-field/correct {:answer/id #uuid "16428388-adc9-5bc3-a420-1ca62578bc67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186539525} :answer-field/id #uuid "9daa41b5-a3c9-591b-8bf6-1fa87f56a85e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186539974}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f9b76f6d-a314-5376-893f-3c9706a4c31e" :question/math-academy-id "q-251858" :question/problem "Consider two sets of $39$ paired observations ${x}_{1},{x}_{2},…,{x}_{39},$ and ${y}_{1},{y}_{2},…,{y}_{39}.$ You are given that\n\n$$\n\\begin{aligned}{S}_{xx}=663,\\,{S}_{yy}=1\\,092,\\,{S}_{xy}=975.\\end{aligned}\n$$\n\nThen, $Cov(x,y)=$\n{{field-1}}." :question/worked-solution "Given a set of $n$ paired observations ${x}_{1},{x}_{2},…,{x}_{n}$ and ${y}_{1},{y}_{2},…,{y}_{n},$ their covariance can be calculated as follows:\n\n$$\n\\begin{aligned}Cov(x,y) & =\\frac{{S}_{xy}}{n},\\end{aligned}\n$$\n\nwhere ${S}_{xy}$ is the sum of products of the deviations of ${x}_{i}$ and ${y}_{i}$ from their means.\n\nWe are given that ${S}_{xy}=975.$ Substituting the given statistic in the above formula, we get\n\n$$\n\\begin{aligned}Cov(x,y) & =\\frac{975}{39} \\\\  & =25.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186540059 :knowledge-point/_questions [{:db/id #edb/ref 17592186204010 :knowledge-point/id #uuid "1f0ed04b-f011-5818-952d-425a19e0cd5c" :knowledge-point/title "Calculating Sums of Squares Using the Shortcut Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e2c88d9-7183-503f-8f87-d5f2453b6ce6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{S}_{xx}=26" :db/id #edb/ref 17592186539538} {:answer/id #uuid "24b92e1b-6dac-56bd-afde-abf287b17941" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{S}_{xx}=48" :db/id #edb/ref 17592186539550} {:answer/id #uuid "55462a77-e788-50b5-b111-e635b1fd0381" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{S}_{xx}=122" :db/id #edb/ref 17592186539626} {:answer/id #uuid "d64241a1-b9bd-5245-9d38-1c834a4c5c12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{S}_{xx}=87.2" :db/id #edb/ref 17592186539844} {:answer/id #uuid "debcb05c-cb0f-5de9-87ca-767431d038bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{S}_{xx}=119" :db/id #edb/ref 17592186539862}] :answer-field/correct {:answer/id #uuid "24b92e1b-6dac-56bd-afde-abf287b17941" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{S}_{xx}=48" :db/id #edb/ref 17592186539550} :answer-field/id #uuid "273080ef-8c7f-5a88-9950-91456455d22a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186539933}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "72d27b98-5424-5f73-97fc-8f2eaa4b8548" :question/math-academy-id "q-251896" :question/problem "Consider the two sets of $7$ paired observations shown in the table below.\n\n| **$\\,{x}_{i}\\,$** | $12$ | $14$ | $9$ | $17$ | $15$ | $10$ | $14$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| **$\\,{y}_{i}\\,$** | $15$ | $18$ | $11$ | $10$ | $20$ | $15$ | $16$ |\n\nGiven that ${\\sum }_{i=1}^{7}{x}_{i}^{2}=1\\,231,$ calculate ${S}_{xx}.$" :question/worked-solution "Given a set of $n$ paired observations ${x}_{1},{x}_{2},…,{x}_{n}$ and ${y}_{1},{y}_{2},…,{y}_{n},$ the sum of squared deviations from the mean for the data ${x}_{i}$ can be calculated as follows:\n\n$$\n\\begin{aligned}{S}_{xx} & ={\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})^{2} \\\\  & ={\\sum }_{i=1}^{n}{x}_{i}^{2}-\\frac{1}{n}{({\\sum }_{i=1}^{n}{x}_{i})}^{2}.\\end{aligned}\n$$\n\nFirst, we calculate the sum of the ${x}_{i}$ data:\n\n$$\n{\\sum }_{i=1}^{7}{x}_{i}=12+\\,14+\\,9+\\,17+\\,15+\\,10+\\,14=91.\n$$\n\nWe are given that ${\\sum }_{i=1}^{7}{x}_{i}^{2}=1\\,231.$\n\nFinally, by substituting into the above formula, we get\n\n$$\n{S}_{xx}=1\\,231-\\frac{1}{7}(91)^{2}=1231-1\\,183=48.\n$$"}]}
