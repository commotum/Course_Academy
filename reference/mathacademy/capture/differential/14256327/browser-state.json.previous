rac><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mi>u</mi></mrow></msup><mn>5</mn></mfrac></mstyle><mo>⋅</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mn>5</mn></mfrac></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>d</mtext><mi>u</mi></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mn>25</mn></mfrac></mstyle><mo data-mjx-texclass=\"OP\">∫</mo><msup><mi>e</mi><mi>u</mi></msup><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>d</mtext><mi>u</mi></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mn>25</mn></mfrac></mstyle><mo>⋅</mo><msup><mi>e</mi><mi>u</mi></msup><mo>+</mo><mi>C</mi></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mn>5</mn><mi>x</mi><mo>+</mo><mn>2</mn></mrow></msup><mn>25</mn></mfrac></mstyle><mo>+</mo><mi>C</mi></mtd></mtr></mtable></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
