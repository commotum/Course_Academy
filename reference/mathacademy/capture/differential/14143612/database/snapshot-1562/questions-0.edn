e-point/title "Determining Whether a Geometric Sequence Converges"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06ca375c-8414-505f-b03b-e2ad96d6a4bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The sequence diverges" :db/id #edb/ref 17592186442122} {:answer/id #uuid "95a49f94-9a69-5e32-8835-0539ba13a16a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $2$" :db/id #edb/ref 17592186442156} {:answer/id #uuid "abece899-5af6-5470-8a01-7a13d0c08bd7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $0$" :db/id #edb/ref 17592186442160} {:answer/id #uuid "bab2d42b-a688-5e12-8f3d-8464d696a67f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $\\frac{1}{2}$" :db/id #edb/ref 17592186442162} {:answer/id #uuid "bc2229a7-b68c-5343-b328-c4dbf64c4e23" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $\\frac{1}{4}$" :db/id #edb/ref 17592186442163}] :answer-field/correct {:answer/id #uuid "06ca375c-8414-505f-b03b-e2ad96d6a4bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The sequence diverges" :db/id #edb/ref 17592186442122} :answer-field/id #uuid "09c472b9-666d-5d9f-8fa9-0885922e96cd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186442185}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "45ac4819-8cd9-51ec-b2a8-2a52c6be8c3d" :question/math-academy-id "q-141391" :question/problem "Consider the following geometric sequence:\n\n$$\n2,\\,8,\\,32,\\,128,\\,…\n$$\n\nDetermine whether the sequence is convergent or divergent. If it converges, find the limit." :question/worked-solution "Suppose we have a geometric sequence with the first term ${a}_{1}$ and common ratio $r.$ Then, we have the following convergence properties:\n\n- if $|r|<1,$ the sequence is convergent and converges to $0$\n\n- if $|r|>1,$ the sequence is divergent\n\nMoreover, we have the following edge cases:\n\n- if $r=1,$ the sequence is convergent and converges to ${a}_{1}$\n\n- if $r=-1,$ the sequence is divergent\n\nThe  given sequence is a geometric sequence with the common ratio \n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{8}{2}=4.\n$$\n\nSince $|r|=4>1,$ the sequence diverges."}] [{:db/id #edb/ref 17592186442208 :knowledge-point/_questions [{:db/id #edb/ref 17592186096795 :knowledge-point/id #uuid "a850ba4f-dbb5-5a09-afb0-3dc3db709420" :knowledge-point/title "Determining Whether a Geometric Sequence Converges"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04a18138-a02a-5b17-94c0-3b9cbaeac8b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $\\frac{1}{3}$" :db/id #edb/ref 17592186442120} {:answer/id #uuid "796d7024-a1e9-58ff-90eb-873b43bcd4c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $-2$" :db/id #edb/ref 17592186442151} {:answer/id #uuid "e27c1c3a-a8e7-5417-8efc-7c5425ee69bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $-\\frac{1}{2}$" :db/id #edb/ref 17592186442176} {:answer/id #uuid "f3b59ff3-992c-5bee-97c7-f5563634ac94" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The sequence diverges" :db/id #edb/ref 17592186442180} {:answer/id #uuid "fcb40ea8-b891-50c3-9d14-e793bcc911b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $0$" :db/id #edb/ref 17592186442182}] :answer-field/correct {:answer/id #uuid "f3b59ff3-992c-5bee-97c7-f5563634ac94" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The sequence diverges" :db/id #edb/ref 17592186442180} :answer-field/id #uuid "1c1316c7-31d9-554c-8efa-84778111277c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186442188}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ecbf1f26-9acd-560e-9d67-c86b72436e88" :question/math-academy-id "q-141392" :question/problem "Consider the following geometric sequence:\n\n$$\n-3,\\,6,\\,-12,\\,24,\\,…\n$$\n\nDetermine whether the sequence is convergent or divergent. If it converges, find the limit." :question/worked-solution "Suppose we have a geometric sequence with the first term ${a}_{1}$ and common ratio $r.$ Then, we have the following convergence properties:\n\n- if $|r|<1,$ the sequence is convergent and converges to $0$\n\n- if $|r|>1,$ the sequence is divergent\n\nMoreover, we have the following edge cases:\n\n- if $r=1,$ the sequence is convergent and converges to ${a}_{1}$\n\n- if $r=-1,$ the sequence is divergent\n\nThe  given sequence is a geometric sequence with the common ratio \n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{6}{(-3)}=-2.\n$$\n\nSince $|r|=2>1,$ the sequence diverges."}] [{:db/id #edb/ref 17592186442205 :knowledge-point/_questions [{:db/id #edb/ref 17592186096795 :knowledge-point/id #uuid "a850ba4f-dbb5-5a09-afb0-3dc3db709420" :knowledge-point/title "Determining Whether a Geometric Sequence Converges"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b509215-bc4b-5867-9d72-f3a07315a945" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The sequence diverges" :db/id #edb/ref 17592186442124} {:answer/id #uuid "227c9f2d-5f48-5e53-b201-ffea5668ea23" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $\\frac{2}{5}$" :db/id #edb/ref 17592186442129} {:answer/id #uuid "6abef644-5ea5-5c64-879a-d7838c957bfb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $0$" :db/id #edb/ref 17592186442146} {:answer/id #uuid "c0da4df6-9e56-5258-90c7-b4c9aed9e2d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $\\frac{1}{5}$" :db/id #edb/ref 17592186442164} {:answer/id #uuid "ffcc356c-b412-5227-abb8-fe43326ed66d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $5$" :db/id #edb/ref 17592186442184}] :answer-field/correct {:answer/id #uuid "6abef644-5ea5-5c64-879a-d7838c957bfb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $0$" :db/id #edb/ref 17592186442146} :answer-field/id #uuid "0e4a19b8-958e-5dff-be75-386c1c3b76d5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186442186}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "998e5982-d7a4-5c3c-80a4-fa9e89a83e69" :question/math-academy-id "q-141399" :question/problem "Consider the following geometric sequence:\n\n$$\n10,\\,2,\\,\\frac{2}{5},\\,\\frac{2}{25},\\,…\n$$\n\nDetermine whether the sequence is convergent or divergent. If it converges, find the limit." :question/worked-solution "Suppose we have a geometric sequence with the first term ${a}_{1}$ and common ratio $r.$ Then, we have the following convergence properties:\n\n- if $|r|<1,$ the sequence is convergent and converges to $0$\n\n- if $|r|>1,$ the sequence is divergent\n\nMoreover, we have the following edge cases:\n\n- if $r=1,$ the sequence is convergent and converges to ${a}_{1}$\n\n- if $r=-1,$ the sequence is divergent\n\nThe  given sequence is a geometric sequence with the common ratio \n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{2}{10}=\\frac{1}{5}.\n$$\n\nSince $|r|=\\frac{1}{5}<1,$ the sequence converges to $0.$"}] [{:db/id #edb/ref 17592186442206 :knowledge-point/_questions [{:db/id #edb/ref 17592186096795 :knowledge-point/id #uuid "a850ba4f-dbb5-5a09-afb0-3dc3db709420" :knowledge-point/title "Determining Whether a Geometric Sequence Converges"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6762f035-51d1-5181-849a-a23f543f682d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $4$" :db/id #edb/ref 17592186442145} {:answer/id #uuid "c224abce-12d0-565b-9938-798152f266f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $-4$" :db/id #edb/ref 17592186442165} {:answer/id #uuid "c3d1b847-2910-57db-b0b5-a0f6bad643bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The sequence diverges" :db/id #edb/ref 17592186442166} {:answer/id #uuid "d0046bb4-9279-5694-ac3f-b84d3fb522dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $\\frac{1}{4}$" :db/id #edb/ref 17592186442171} {:answer/id #uuid "efc1a9f2-79b6-5ef4-b66d-ce625c4e0c40" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $0$" :db/id #edb/ref 17592186442179}] :answer-field/correct {:answer/id #uuid "6762f035-51d1-5181-849a-a23f543f682d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $4$" :db/id #edb/ref 17592186442145} :answer-field/id #uuid "e30e6f9b-a485-59d3-ad42-8469332526d2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186442196}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "affca196-0a76-5ce7-a774-751bad763eba" :question/math-academy-id "q-141402" :question/problem "Consider the following geometric sequence:\n\n$$\n4,\\,4,\\,4,\\,4,\\,…\n$$\n\nDetermine whether the sequence is convergent or divergent. If it converges, find the limit." :question/worked-solution "Suppose we have a geometric sequence with the first term ${a}_{1}$ and common ratio $r.$ Then, we have the following convergence properties:\n\n- if $|r|<1,$ the sequence is convergent and converges to $0$\n\n- if $|r|>1,$ the sequence is divergent\n\nMoreover, we have the following edge cases:\n\n- if $r=1,$ the sequence is convergent and converges to ${a}_{1}$\n\n- if $r=-1,$ the sequence is divergent\n\nThe  given sequence is a geometric sequence with the common ratio \n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{4}{4}=1.\n$$\n\nSince $r=1,$ i.e., the sequence converges and converges to $4.$"}] [{:db/id #edb/ref 17592186442203 :knowledge-point/_questions [{:db/id #edb/ref 17592186096796 :knowledge-point/id #uuid "5986f765-9036-5124-a498-bd898119c9c5" :knowledge-point/title "Determining Whether a Geometric Sequence Converges Given the Nth Term"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c6e08b8-ccaf-5256-be6a-93ceb34ec36a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $1$" :db/id #edb/ref 17592186442131} {:answer/id #uuid "4bbaf891-abe6-54c4-b9a8-5d86095d3a45" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $3$" :db/id #edb/ref 17592186442139} {:answer/id #uuid "725f7229-bc83-59f0-9b41-7846721dfd28" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The sequence diverges" :db/id #edb/ref 17592186442150} {:answer/id #uuid "cd83315e-ba73-5338-9aa1-c16f38e856e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $0$" :db/id #edb/ref 17592186442169} {:answer/id #uuid "ea0f102a-f568-5f21-8f98-d2ea088768c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $\\frac{1}{3}$" :db/id #edb/ref 17592186442177}] :answer-field/correct {:answer/id #uuid "725f7229-bc83-59f0-9b41-7846721dfd28" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The sequence diverges" :db/id #edb/ref 17592186442150} :answer-field/id #uuid "e64615e5-cb1c-5f5a-bd1f-6f3a7be46034" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186442197}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9262426c-0414-546e-b699-b0af1ea969b4" :question/math-academy-id "q-141406" :question/problem "Does the sequence ${a}_{n}={3}^{n}$ for $n\\ge 1$ \nconverge or diverge? If it converges, what is its limit?" :question/worked-solution "Suppose we have a geometric sequence with the first term ${a}_{1}$ and common ratio $r.$ Then, we have the following convergence properties:\n\n- if $|r|<1,$ the sequence is convergent and converges to $0$\n\n- if $|r|>1,$ the sequence is divergent\n\nMoreover, we have the following edge cases:\n\n- if $r=1,$ the sequence is convergent and converges to ${a}_{1}$\n\n- if $|r|=-1,$ the sequence is divergent\n\nThe given sequence ${a}_{n}={3}^{n}$ is a geometric sequence with the common ratio $r=3.$ \n\nSince $|r|>1,$ the sequence diverges."}] [{:db/id #edb/ref 17592186442207 :knowledge-point/_questions [{:db/id #edb/ref 17592186096796 :knowledge-point/id #uuid "5986f765-9036-5124-a498-bd898119c9c5" :knowledge-point/title "Determining Whether a Geometric Sequence Converges Given the Nth Term"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "139046b8-242e-5136-8f58-ce582787d8d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The sequence diverges" :db/id #edb/ref 17592186442126} {:answer/id #uuid "895025a9-4b50-59d5-a1b6-4f633f50cc6d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/