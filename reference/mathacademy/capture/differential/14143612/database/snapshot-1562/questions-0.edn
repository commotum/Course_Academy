#{[{:db/id #edb/ref 17592186096551 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186096744 :knowledge-point/id #uuid "e4380b34-0502-552b-b94f-e121eb855f1d" :knowledge-point/title "Determining Convergence Behavior of Geometric Sequences Written Recursively"}] :question/id #uuid "bc0f8f02-ba1c-59c7-ba27-cb2148f2a9f8" :question/math-academy-id "e-646" :question/problem "Consider the following sequence: \n\n$$\na_{n+1} = -2a_n, \\qquad a_1 = -4, \\qquad n\\geq 1.\n$$\n\nDetermine whether the sequence is convergent or divergent. If it converges, find the limit." :question/worked-solution "Suppose we have a geometric sequence with the first term $a_1$ and common ratio $r.$ Then, we have the following convergence properties:\n\n- if $|r| <      1,$ the sequence is convergent and converges to $0$\n\n- if $|r| > 1,$ the sequence is divergent\n\nMoreover, we have the following edge cases:\n\n- if $r=1,$ the sequence is convergent and converges to $a_1$\n\n- if $r= -1,$ the sequence is divergent\n\nThe given sequence is a geometric sequence with the common ratio \n\n$$\nr=\\dfrac{a_{n+1}}{a_n}= -2.\n$$\n\nSince $|r| >1$, the sequence diverges."}] [{:db/id #edb/ref 17592186096604 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186096795 :knowledge-point/id #uuid "a850ba4f-dbb5-5a09-afb0-3dc3db709420" :knowledge-point/title "Determining Whether a Geometric Sequence Converges"}] :question/id #uuid "90ed1cce-a831-58b0-942a-d8b9a17583cc" :question/math-academy-id "e-9964" :question/problem "Consider the following geometric sequence:\n\n$$\n6, \\quad -2, \\quad \\dfrac{2}{3}, \\quad -\\dfrac{2}{9}, \\quad \\ldots\n$$\n\nDetermine whether the sequence is convergent or divergent. If it converges, find the limit." :question/worked-solution "Suppose we have a geometric sequence with the first term $a_1$ and common ratio $r.$ Then, we have the following convergence properties:\n\n- if $|r| <    1,$ the sequence is convergent and converges to $0$\n\n- if $|r| > 1,$ the sequence is divergent\n\nMoreover, we have the following edge cases:\n\n- if $r=1,$ the sequence is convergent and converges to $a_1$\n\n- if $r = -1,$ the sequence is divergent\n\nThe  given sequence is a geometric sequence with the common ratio \n\n$$\nr=\\dfrac{a_2}{a_1}=\\dfrac{(-2)}{6}= -\\dfrac{1}{3}.\n$$\n\nSince $|r| = \\dfrac{1}{3} <      1,$ the sequence converges to $0.$"}] [{:db/id #edb/ref 17592186096605 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186096796 :knowledge-point/id #uuid "5986f765-9036-5124-a498-bd898119c9c5" :knowledge-point/title "Determining Whether a Geometric Sequence Converges Given the Nth Term"}] :question/id #uuid "0bbb71a2-ff71-5f25-80bc-e56bbed9ac1f" :question/math-academy-id "e-9989" :question/problem "Does the sequence $a_n=\\left( \\dfrac{5}{3}\\right)^{n-1}$ for $n\\geq  1$ \nconverge or diverge? If it converges, what is its limit?" :question/worked-solution "Suppose we have a geometric sequence with the first term $a_1$ and common ratio $r.$ Then, we have the following convergence properties:\n\n- if $|r| <      1,$ the sequence is convergent and converges to $0$\n\n- if $|r| > 1,$ the sequence is divergent\n\nMoreover, we have the following edge cases:\n\n- if $r=1,$ the sequence is convergent and converges to $a_1$\n\n- if $r = -1,$ the sequence is divergent\n\nThe given sequence $a_n=\\left( \\dfrac{5}{3}\\right)^{n-1}$ is a geometric sequence with the common ratio $r =\\dfrac{5}{3}.$ \n\nSince $|r| >   1,$ the sequence is divergent."}] [{:db/id #edb/ref 17592186442210 :knowledge-point/_questions [{:db/id #edb/ref 17592186096744 :knowledge-point/id #uuid "e4380b34-0502-552b-b94f-e121eb855f1d" :knowledge-point/title "Determining Convergence Behavior of Geometric Sequences Written Recursively"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2cc1cf93-167d-5783-bcb1-79268c0ccdc2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $-\\frac{1}{4}$" :db/id #edb/ref 17592186442133} {:answer/id #uuid "407d1168-eacc-588f-9049-58098b4d1e7e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $-\\frac{3}{4}$" :db/id #edb/ref 17592186442137} {:answer/id #uuid "64dd538a-2481-525a-b75e-3e09d1f69d00" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $0$" :db/id #edb/ref 17592186442144} {:answer/id #uuid "82eb318a-b526-5c90-b554-5a099c0a65ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The sequence diverges" :db/id #edb/ref 17592186442153} {:answer/id #uuid "b89b895e-b917-5f3f-a449-e19f5273ce65" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $\\frac{1}{3}$" :db/id #edb/ref 17592186442161}] :answer-field/correct {:answer/id #uuid "64dd538a-2481-525a-b75e-3e09d1f69d00" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $0$" :db/id #edb/ref 17592186442144} :answer-field/id #uuid "805dcb69-9779-5164-a339-8471bc094e31" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186442193}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f1a23838-d1bb-516b-9ae9-359aec1587f6" :question/math-academy-id "q-123336" :question/problem "Consider the following geometric sequence:\n\n$$\n{a}_{n+1}=-\\frac{1}{3}{a}_{n},\\,{a}_{1}=-\\frac{3}{4},\\,n\\ge 1\n$$\n\nDetermine whether the sequence is convergent or divergent. If it converges, find the limit." :question/worked-solution "Suppose we have a geometric sequence with the first term ${a}_{1}$ and common ratio $r.$ Then, we have the following convergence properties:\n\n- if $|r|<1,$ the sequence is convergent and converges to $0$\n\n- if $|r|>1,$ the sequence is divergent\n\nMoreover, we have the following edge cases:\n\n- if $r=1,$ the sequence is convergent and converges to ${a}_{1}$\n\n- if $r=-1,$ the sequence is divergent\n\nThe given sequence is a geometric sequence with the common ratio \n\n$$\nr=\\frac{{a}_{n+1}}{{a}_{n}}=-\\frac{1}{3}.\n$$\n\nSince $|r|=\\frac{1}{3}<1$, the sequence converges to $0.$"}] [{:db/id #edb/ref 17592186442201 :knowledge-point/_questions [{:db/id #edb/ref 17592186096744 :knowledge-point/id #uuid "e4380b34-0502-552b-b94f-e121eb855f1d" :knowledge-point/title "Determining Convergence Behavior of Geometric Sequences Written Recursively"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "070a3e55-b73d-5028-afef-baa76ead329f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $0$" :db/id #edb/ref 17592186442123} {:answer/id #uuid "4939afa2-aa64-50f4-9cba-1c80993c3641" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $-2$" :db/id #edb/ref 17592186442138} {:answer/id #uuid "530139a6-b857-5a38-aedf-d49d0b86e8a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The sequence diverges" :db/id #edb/ref 17592186442141} {:answer/id #uuid "7d409d09-a0a2-5af4-a2e1-a0549ca199ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $-\\frac{1}{4}$" :db/id #edb/ref 17592186442152} {:answer/id #uuid "fee9e19e-8a29-5ea0-bb37-baf0dfd06704" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $2$" :db/id #edb/ref 17592186442183}] :answer-field/correct {:answer/id #uuid "070a3e55-b73d-5028-afef-baa76ead329f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $0$" :db/id #edb/ref 17592186442123} :answer-field/id #uuid "34b585ba-0fd6-572b-8c6b-6fd101f4ec8b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186442190}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6fc6aa47-4c64-51fa-b318-3ae3f17b8883" :question/math-academy-id "q-123338" :question/problem "Consider the following sequence: \n\n$$\n{a}_{n+1}=-\\frac{1}{4}{a}_{n},\\,{a}_{1}=2,\\,n\\ge 1.\n$$\n\nDetermine whether the sequence is convergent or divergent. If it converges, find the limit." :question/worked-solution "Suppose we have a geometric sequence with the first term ${a}_{1}$ and common ratio $r.$ Then, we have the following convergence properties:\n\n- if $|r|<1,$ the sequence is convergent and converges to $0$\n\n- if $|r|>1,$ the sequence is divergent\n\nMoreover, we have the following edge cases:\n\n- if $r=1,$ the sequence is convergent and converges to ${a}_{1}$\n\n- if $r=-1,$ the sequence is divergent\n\nThe given sequence is a geometric sequence with the common ratio \n\n$$\nr=\\frac{{a}_{n+1}}{{a}_{n}}=-\\frac{1}{4}.\n$$\n\nSince $|r|<1$, the sequence converges to $0.$"}] [{:db/id #edb/ref 17592186097110 :knowledge-point/_questions [{:db/id #edb/ref 17592186096795 :knowledge-point/id #uuid "a850ba4f-dbb5-5a09-afb0-3dc3db709420" :knowledge-point/title "Determining Whether a Geometric Sequence Converges"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b81fa50f-a724-5266-b274-84bffb668003" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The sequence diverges" :db/id #edb/ref 17592186094634} {:answer/id #uuid "ecad287d-1026-5114-8121-702cfae736de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $-5$" :db/id #edb/ref 17592186094635} {:answer/id #uuid "0c40607b-5e3f-5ec1-ac16-bce014d0d11a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $0$" :db/id #edb/ref 17592186094636} {:answer/id #uuid "125e9160-b12c-5