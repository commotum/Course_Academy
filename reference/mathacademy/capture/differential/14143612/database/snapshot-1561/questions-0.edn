#{[{:db/id #edb/ref 17592186096551 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186096744 :knowledge-point/id #uuid "e4380b34-0502-552b-b94f-e121eb855f1d" :knowledge-point/title "Determining Convergence Behavior of Geometric Sequences Written Recursively"}] :question/id #uuid "bc0f8f02-ba1c-59c7-ba27-cb2148f2a9f8" :question/math-academy-id "e-646" :question/problem "Consider the following sequence:\n\n$a_{n+1} = -2a_n, \\qquad a_1 = -4, \\qquad n\\geq 1$.\n\nDetermine whether the sequence is convergent or divergent. If it converges, find the limit." :question/worked-solution "Suppose we have a geometric sequence with the first term $a_1$ and common ratio $r$. Then, we have the following convergence properties:\n\n- if $\\mid r \\mid < 1$, the sequence is convergent and converges to $0$\n- if $\\mid r \\mid > 1$, the sequence is divergent\n\nMoreover, we have the following edge cases:\n\n- if $r=1$, the sequence is convergent and converges to $a_1$\n- if $r= -1$, the sequence is divergent\n\nThe given sequence is a geometric sequence with the common ratio\n\n$$\nr=\\dfrac{a_{n+1}}{a_n}= -2\n$$\n\nSince $\\mid r \\mid >1$, the sequence diverges."}] [{:db/id #edb/ref 17592186096604 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186096795 :knowledge-point/id #uuid "a850ba4f-dbb5-5a09-afb0-3dc3db709420" :knowledge-point/title "Determining Whether a Geometric Sequence Converges"}] :question/id #uuid "90ed1cce-a831-58b0-942a-d8b9a17583cc" :question/math-academy-id "e-9964" :question/problem "Consider the following geometric sequence:\n$6, \\quad -2, \\quad \\dfrac{2}{3}, \\quad -\\dfrac{2}{9}, \\quad \\ldots$\n\nDetermine whether the sequence is convergent or divergent. If it converges, find the limit." :question/worked-solution "Suppose we have a geometric sequence with the first term $a_1$ and common ratio $r$. Then, we have the following convergence properties:\n\n- if $\\mid r \\mid < 1$, the sequence is convergent and converges to $0$\n- if $\\mid r \\mid > 1$, the sequence is divergent\n\nMoreover, we have the following edge cases:\n\n- if $r=1$, the sequence is convergent and converges to $a_1$\n- if $r = -1$, the sequence is divergent\n\nThe given sequence is a geometric sequence with the common ratio\n\n$$\nr=\\dfrac{a_2}{a_1}=\\dfrac{(-2)}{6}= -\\dfrac{1}{3}\n$$\n\nSince\n\n$$\n\\mid r \\mid = \\dfrac{1}{3} < 1\n$$\n\nthe sequence converges to $0$."}] [{:db/id #edb/ref 17592186096605 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186096796 :knowledge-point/id #uuid "5986f765-9036-5124-a498-bd898119c9c5" :knowledge-point/title "Determining Whether a Geometric Sequence Converges Given the Nth Term"}] :question/id #uuid "0bbb71a2-ff71-5f25-80bc-e56bbed9ac1f" :question/math-academy-id "e-9989" :question/problem "Does the sequence $a_n=\\left(\\dfrac{5}{3}\\right)^{n-1}$ for $n\\geq 1$\nconverge or diverge? If it converges, what is its limit?" :question/worked-solution "Suppose we have a geometric sequence with the first term $a_1$ and common ratio $r$. Then, we have the following convergence properties:\n\n- if $\\mid r \\mid < 1$, the sequence is convergent and converges to $0$\n- if $\\mid r \\mid > 1$, the sequence is divergent\n\nMoreover, we have the following edge cases:\n\n- if $r=1$, the sequence is convergent and converges to $a_1$\n- if $r = -1$, the sequence is divergent\n\nThe given sequence\n\n$$\na_n=\\left(\\dfrac{5}{3}\\right)^{n-1}\n$$\n\nis a geometric sequence with the common ratio\n\n$$\nr =\\dfrac{5}{3}\n$$\n\nSince $\\mid r \\mid > 1$, the sequence is divergent."}] [{:db/id #edb/ref 17592186097110 :knowledge-point/_questions [{:db/id #edb/ref 17592186096795 :knowledge-point/id #uuid "a850ba4f-dbb5-5a09-afb0-3dc3db709420" :knowledge-point/title "Determining Whether a Geometric Sequence Converges"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b81fa50f-a724-5266-b274-84bffb668003" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The sequence diverges" :db/id #edb/ref 17592186094634} {:answer/id #uuid "ecad287d-1026-5114-8121-702cfae736de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $-5$" :db/id #edb/ref 17592186094635} {:answer/id #uuid "0c40607b-5e3f-5ec1-ac16-bce014d0d11a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $0$" :db/id #edb/ref 17592186094636} {:answer/id #uuid "125e9160-b12c-5e8d-87f9-276d4ba09d35" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $1$" :db/id #edb/ref 17592186094637} {:answer/id #uuid "3bf0dd01-8f2d-5745-976a-0a5b230ee1eb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $5$" :db/id #edb/ref 17592186094638}] :answer-field/id #uuid "e5d795bb-4c09-5992-8351-fceea48bddbb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186094633}] :question/id #uuid "82bb8ea1-ba68-51b6-8a34-cf19b0c03567" :question/math-academy-id "q-140783" :question/problem "Consider the following geometric sequence:\n\n$5,-5, 5,-5, …$\nDetermine whether the sequence is convergent or divergent. If it converges, find the limit."}] [{:db/id #edb/ref 17592186097357 :knowledge-point/_questions [{:db/id #edb/ref 17592186096744 :knowledge-point/id #uuid "e4380b34-0502-552b-b94f-e121eb855f1d" :knowledge-point/title "Determining Convergence Behavior of Geometric Sequences Written Recursively"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7500bac-b575-52ad-8907-174f8c109b30" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $-\\frac{1}{3}$" :db/id #edb/ref 17592186096067} {:answer/id #uuid "286abb1f-a152-57f6-97d8-2e647406c7a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $0$" :db/id #edb/ref 17592186096068} {:answer/id #uuid "41371bcc-9720-52ee-964f-785229f9c88c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $-3$" :db/id #edb/ref 17592186096069} {:answer/id #uuid "4c47b773-49e9-590f-8580-f995e2dca36d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $1$" :db/id #edb/ref 17592186096070} {:answer/id #uuid "57a855bb-1f85-5ab6-93a6-841887543ac6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The sequence diverges" :db/id #edb/ref 17592186096071}] :answer-field/id #uuid "649fa9d9-0edf-58d6-9be6-e7bee9af21a7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186096066}] :question/id #uuid "efad956a-2bd6-5ffc-b24d-be1495badddd" :question/math-academy-id "q-74624" :question/problem "Consider the following sequence:\n\n$a_{n + 1} = a_{n}, a_{1} =-3, n \\ge 1$.\n\nDetermine whether the sequence is convergent or divergent. If it converges, find the limit."}]}
