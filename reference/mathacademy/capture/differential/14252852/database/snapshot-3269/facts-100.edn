}{2}\\text{ }k \\\\ ∇f(0,0,2) & =2(0)\\text{ }i+\\frac{2(0)}{9}\\text{ }j+\\frac{(2)}{2}\\text{ }k \\\\  & =k \\\\  & =⟨0,0,1⟩\\end{aligned}\n$$\n\n \n\nFinally, the vector form of the equation of the line that is parallel to $∇f(0,0,2)$ and passes through the point $(0,0,2)$ can be written as\n\n$$\n\\begin{aligned}r & =⟨0,\\,0,\\,2⟩+t\\,∇f(0,0,2)=⟨0,\\,0,\\,2⟩+t\\,⟨0,\\,0,\\,1⟩\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$" #edb/ref 17592186045417] [17592186405133 #edb/ref 1075 #edb/ref 17592186405134 #edb/ref 17592186045417] [17592186405133 #edb/ref 1075 #edb/ref 17592186405135 #edb/ref 17592186045417] [17592186405133 #edb/ref 1075 #edb/ref 17592186405136 #edb/ref 17592186045417] [17592186405133 #edb/ref 1075 #edb/ref 17592186405137 #edb/ref 17592186045417] [17592186405133 #edb/ref 1075 #edb/ref 17592186405138 #edb/ref 17592186045417] [17592186405133 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186405133 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186405133 #edb/ref 1078 #edb/ref 17592186405135 #edb/ref 17592186045417] [17592186405133 #edb/ref 1079 #uuid "fa0a835b-df77-526f-b20f-c5410f491aab" #edb/ref 17592186045417] [17592186405134 #edb/ref 1080 "⟨0,\\,0,\\,1⟩+t\\,⟨0,\\,0,\\,1⟩,\\,t\\in (-\\infty ,\\infty )" #edb/ref 17592186045417] [17592186405134 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186405134 #edb/ref 1083 #uuid "124556c0-f467-5318-900e-7da585d6554e" #edb/ref 17592186045417] [17592186405135 #edb/ref 1080 "⟨0,\\,0,\\,2⟩+t\\,⟨0,\\,0,\\,1⟩,\\,t\\in (-\\infty ,\\infty )" #edb/ref 17592186045417] [17592186405135 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186405135 #edb/ref 1083 #uuid "5a7a1b1e-b535-5117-9c36-e366c14a4377" #edb/ref 17592186045417] [17592186405136 #edb/ref 1080 "⟨0,\\,0,\\,1⟩+t\\,⟨0,\\,0,\\,2⟩,\\,t\\in (-\\infty ,\\infty )" #edb/ref 17592186045417] [17592186405136 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186405136 #edb