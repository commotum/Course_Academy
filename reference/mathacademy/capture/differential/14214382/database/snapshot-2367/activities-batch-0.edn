}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{2\\cdot 1+1\\cdot 2+2\\cdot (-1)}{{1}^{2}+{2}^{2}+(-1)^{2}}{v}_{1} \\\\  & =\\begin{bmatrix}2 \\\\ 1 \\\\ 2\\end{bmatrix}-\\frac{1}{3}\\begin{bmatrix}1 \\\\ 2 \\\\ -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{5}{3} \\\\ \\frac{1}{3} \\\\ \\frac{7}{3}\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, $B=\\{{v}_{1},{v}_{2}\\}=\\{\\begin{bmatrix}1 \\\\ 2 \\\\ -1\\end{bmatrix},\\begin{bmatrix}\\frac{5}{3} \\\\ \\frac{1}{3} \\\\ \\frac{7}{3}\\end{bmatrix}\\}$ is an orthogonal basis for $\\text{Col}(A).$\n\nFinally, $a=\\frac{5}{3},$ $b=\\frac{1}{3},$ and  \n\n$$\n\\frac{a}{b}=\\frac{(\\frac{5}{3})}{(\\frac{1}{3})}=5.\n$$"} :step/id #uuid "515565f3-dbe0-5771-aba6-dfe3cfe75b5d" :step/next {:db/id #edb/ref 17592186488296}} {:db/id #edb/ref 17592186488314 :step/content {:db/id #edb/ref 17592186134312 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02a9e964-e971-5a63-8ddf-d35611c16d45" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5" :db/id #edb/ref 17592186323997} {:answer/id #uuid "3b6569f2-157f-59bd-b487-d77abba9f8d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186324450} {:answer/id #uuid "4ee6004c-940f-594a-9082-a66d246e0808" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186324618} {:answer/id #uuid "7e307e2d-eb04-5931-a49e-da669978c621" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186325033} {:answer/id #uuid "c2a72c2b-2e25-5ac5-9983-7b64eb42b19a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186325644}] :answer-field/correct {:db/id #edb/ref 17592186324618} :answer-field/id #uuid "67bfe10d-3e1e-5ac4-80e9-14d87bdcdeaa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186