 17592186045499 #edb/ref 17592186045417] [17592186359716 #edb/ref 1083 #uuid "dfc91c67-3097-5283-8f8b-3b8fe97cd689" #edb/ref 17592186045417] [17592186359948 #edb/ref 1080 "$(-2,0)$ and $(2,0)$" #edb/ref 17592186045417] [17592186359948 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186359948 #edb/ref 1083 #uuid "f7eb0e02-023c-58bb-aac4-2dac5752d4d4" #edb/ref 17592186045417] [17592186360123 #edb/ref 1075 #edb/ref 17592186358650 #edb/ref 17592186045417] [17592186360123 #edb/ref 1075 #edb/ref 17592186358798 #edb/ref 17592186045417] [17592186360123 #edb/ref 1075 #edb/ref 17592186359101 #edb/ref 17592186045417] [17592186360123 #edb/ref 1075 #edb/ref 17592186359522 #edb/ref 17592186045417] [17592186360123 #edb/ref 1075 #edb/ref 17592186359716 #edb/ref 17592186045417] [17592186360123 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186360123 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186360123 #edb/ref 1078 #edb/ref 17592186359716 #edb/ref 17592186045417] [17592186360123 #edb/ref 1079 #uuid "5382299d-1f65-5550-87e1-91bfe7eccdd1" #edb/ref 17592186045417] [17592186360327 #edb/ref 1075 #edb/ref 17592186358299 #edb/ref 17592186045417] [17592186360327 #edb/ref 1075 #edb/ref 17592186358694 #edb/ref 17592186045417] [17592186360327 #edb/ref 1075 #edb/ref 17592186358728 #edb/ref 17592186045417] [17592186360327 #edb/ref 1075 #edb/ref 17592186359131 #edb/ref 17592186045417] [17592186360327 #edb/ref 1075 #edb/ref 17592186359948 #edb/ref 17592186045417] [17592186360327 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186360327 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186360327 #edb/ref 1078 #edb/ref 17592186358694 #edb/ref 17592186045417] [17592186360327 #edb/ref 1079 #uuid "c08fea00-5325-54f1-8a55-fe63ff389dc6" #edb/ref 17592186045417] [17592186360472 #edb/ref 1068 #edb/ref 17592186360123 #edb/ref 17592186045417] [17592186360472 #edb/ref 1069 "q-9468" #edb/ref 17592186045417] [17592186360472 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186360472 #edb/ref 1071 "Determine the point where the ellipse ${x}^{2}+6{y}^{2}-8x+24y+28=0$ intercepts the $y$-axis." #edb/ref 17592186045417] [17592186360472 #edb/ref 1072 #uuid "81870e2c-d547-5f03-aff7-b63f30c1daff" #edb/ref 17592186045417] [17592186360472 #edb/ref 1074 "To calculate the $y$-intercepts, we need to substitute $x=0$ in the equation of the ellipse and try to solve the resulting equation for $y.$ We do this and solve the resulting equation by completing the square:\n\n$$\n\\begin{aligned}{x}^{2}+6{y}^{2}-8x+24y+28 & =0 \\\\ {0}^{2}+6{y}^{2}-8\\cdot 0+24y+28 & =0 \\\\ 6{y}^{2}+24y+28 & =0 \\\\ 6[{y}^{2}+4y]+28 & =0 \\\\ 6[(y+2)^{2}-4]+28 & =0 \\\\ 6(y+2)^{2}-24+28 & =0 \\\\ 6(y+2)^{2}+4 & =0 \\\\ 6(y+2)^{2} & =-4.\\end{aligned}\n$$\n\nSince $6(y+2)^{2}\\ge 0$, there is no $y$ such that $6(y+2)^{2}=-4.$ Therefore, the ellipse has no $y$-intercepts, meaning that it does not intercept the $y$-axis at any point." #edb/ref 17592186045417] [17592186372335 #edb/ref 1068 #edb/ref 17592186372336 #edb/ref 17592186045417] [17592186372335 #edb/ref 1069 "q-16644" #edb/ref 17592186045417] [17592186372335 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186372335 #edb/ref 1071 "Calculate the point where the ellipse $\\frac{(x-2)^{2}}{4}+\\frac{(y+6)^{2}}{36}=1$ intercepts the $x$-axis." #edb/ref 17592186045417] [17592186372335 #edb/ref 1072 #uuid "68f04bff-7cba-5650-a634-33f4c34b4531" #edb/ref 17592186045417] [17592186372335 #edb/ref 1074 "To calculate the $x$-intercept, we need to substitute $y=0$ into the equation of the ellipse and solve the resulting equation for $x.$ Doing this, we get\n\n$$\n\\begin{aligned}\\frac{(x-2)^{2}}{4}+\\frac{(y+6)^{2}}{36} & =1 \\\\ \\frac{(x-2)^{2}}{4}+\\frac{(0+6)^{2}}{36} & =1 \\\\ \\frac{(x-2)^{2}}{4}+\\frac{36}{36} & =1 \\\\ \\frac{(x-2)^{2}}{4}+1 & =1 \\\\ \\frac{(x-2)^{2}}{4} & =0 \\\\ (x-2)^{2} & =0 \\\\ x-2 & =0 \\\\ x & =2.\\end{aligned}\n$$\n\nTherefore, the ellipse intercepts the $x$-axis at the point $(2,0).$" #edb/ref 17592186045417] [17592186372336 #edb/ref 1075 #edb/ref 17592186372337 #edb/ref 17592186045417] [17592186372336 #edb/ref 1075 #edb/ref 17592186372338 #edb/ref 17592186045417] [17592186372336 #edb/ref 1075 #edb/ref 17592186372339 #edb/ref 17592186045417] [17592186372336 #edb/ref 1075 #edb/ref 17592186372340 #edb/ref 17592186045417] [17592186372336 #edb/ref 1075 #edb/ref 17592186372341 #edb/ref 17592186045417] [17592186372336 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186372336 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186372336 #edb/ref 1078 #edb/ref 17592186372339 #edb/ref 17592186045417] [17592186372336 #edb/ref 1079 #uuid "9a0cdef4-0076-5a2c-b898-5a1451899734" #edb/ref 17592186045417] [17592186372337 #edb/ref 1080 "There is no $x$-intercept" #edb/ref 17592186045417] [17592186372337 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186372337 #edb/ref 1083 #uuid "dba08ba5-1b57-5a4c-bb76-40299b820f5c" #edb/ref 17592186045417] [17592186372338 #edb/ref 1080 "(4,0)" #edb/ref 17592186045417] [17592186372338 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186372338 #edb/ref 1083 #uuid "8cd7657d-8eec-59e8-a2b1-4e41b9cc76c7" #edb/ref 17592186045417] [17592186372339 #edb/ref 1080 "(2,0)" #edb/ref 17592186045417] [17592186372339 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186372339 #edb/ref 1083 #uuid "5adca319-de25-5651-a851-4419686ce657" #edb/ref 17592186045417] [17592186372340 #edb/ref 1080 "(-4,0)" #edb/ref 17592186045417] [17592186372340 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186372340 #edb/ref 1083 #uuid "369f2c60-e233-559d-9ba8-bc96d6ced966" #edb/ref 17592186045417] [17592186372341 #edb/ref 1080 "(-2,0)" #edb/ref 17592186045417] [17592186372341 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186372341 #edb/ref 1083 #uuid "ad0770ec-1ac5-55a8-a993-81d5c375b952" #edb/ref 17592186045417] [17592186372582 #edb/ref 1068 #edb/ref 17592186372583 #edb/ref 17592186045417] [17592186372582 #edb/ref 1068 #edb/ref 17592186372585 #edb/ref 17592186045417] [17592186372582 #edb/ref 1068 #edb/ref 17592186372587 #edb/ref 17592186045417] [17592186372582 #edb/ref 1068 #edb/ref 17592186372589 #edb/ref 17592186045417] [17592186372582 #edb/ref 1069 "q-326055" #edb/ref 17592186045417] [17592186372582 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186372582 #edb/ref 1071 "From **left to right**, the ellipse $3{x}^{2}+2{y}^{2}+18x+6y=24$ intercepts the $x$-axis at the points $A$ and $B.$ Find the coordinates of these points.\n\n$A($\n{{field-1}}\n$,$\n{{field-2}}$)\\,$\n\nand \n\n$\\,B($\n{{field-3}}$,$\n{{field-4}}\n$)$" #edb/ref 17592186045417] [17592186372582 #edb/ref 1072 #uuid "ddb3faa2-9933-5296-a456-8bba17403f00" #edb/ref 17592186045417] [17592186372582 #edb/ref 1074 "To calculate the $x$-intercepts, we need to substitute $y=0$ into the equation of the ellipse and solve the resulting equation for $x.$ We do this and solve the resulting equation by completing the square:\n\n$$\n\\begin{aligned}3{x}^{2}+2{y}^{2}+18x+6y & =24 \\\\ 3{x}^{2}+2\\cdot {0}^{2}+18x+6\\cdot 0 & =24 \\\\ 3{x}^{2}+18x & =24 \\\\ {x}^{2}+6x & =8 \\\\ ({x}^{2}+6x+9)-9 & =8 \\\\ (x+3)^{2}-9 & =8 \\\\ (x+3)^{2} & =17 \\\\ x+3 & =\\pm \\sqrt{17} \\\\ x & =-3\\pm \\sqrt{17}\\end{aligned}\n$$\n\nTherefore, from left to right, the $x$-intercepts are\n\n$$\nA(-3-\\sqrt{17},0)\\,\\text{and}\\,B(-3+\\sqrt{17},0).\n$$" #edb/ref 17592186045417] [17592186372583 #edb/ref 1075 #edb/ref 17592186372584 #edb/ref 17592186045417] [17592186372583 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186372583 #edb/ref 1077 "field-3" #edb/ref 17592186045417] [17592186372583 #edb/ref 1078 #edb/ref 17592186372584 #edb/ref 17592186045417] [17592186372583 #edb/ref 1079 #uuid "a906b0e6-1a6c-57d9-984d-d0c2cbf7af7d" #edb/ref 1759218604