f843541a-9614-5f09-bac2-fce7637a0932" #edb/ref 17592186045417] [17592186049668 #edb/ref 1027 #edb/ref 17592186049426 #edb/ref 17592186045417] [17592186049668 #edb/ref 1027 #edb/ref 17592186050465 #edb/ref 17592186045417] [17592186049668 #edb/ref 1027 #edb/ref 17592186051081 #edb/ref 17592186045417] [17592186049668 #edb/ref 1028 #edb/ref 17592186110612 #edb/ref 17592186045417] [17592186049668 #edb/ref 1028 #edb/ref 17592186110613 #edb/ref 17592186045417] [17592186049668 #edb/ref 1028 #edb/ref 17592186110614 #edb/ref 17592186045417] [17592186049668 #edb/ref 1028 #edb/ref 17592186110615 #edb/ref 17592186045417] [17592186049668 #edb/ref 1031 "Perfect Square Quadratic Equations with One or No Solutions" #edb/ref 17592186045417] [17592186049668 #edb/ref 1033 1425 #edb/ref 17592186045417] [17592186049668 #edb/ref 1035 #uuid "094d9698-9cc9-5916-96dd-6106a9f252e9" #edb/ref 17592186045417] [17592186050044 #edb/ref 1027 #edb/ref 17592186048293 #edb/ref 17592186045417] [17592186050044 #edb/ref 1027 #edb/ref 17592186048385 #edb/ref 17592186045417] [17592186050044 #edb/ref 1027 #edb/ref 17592186048436 #edb/ref 17592186045417] [17592186050044 #edb/ref 1027 #edb/ref 17592186051078 #edb/ref 17592186045417] [17592186050044 #edb/ref 1028 #edb/ref 17592186184168 #edb/ref 17592186045417] [17592186050044 #edb/ref 1028 #edb/ref 17592186184169 #edb/ref 17592186045417] [17592186050044 #edb/ref 1028 #edb/ref 17592186184170 #edb/ref 17592186045417] [17592186050044 #edb/ref 1031 "Completing the Square With Odd Linear Terms" #edb/ref 17592186045417] [17592186050044 #edb/ref 1033 3842 #edb/ref 17592186045417] [17592186050044 #edb/ref 1034 1.0599362345313645 #edb/ref 17592186045436] [17592186050044 #edb/ref 1035 #uuid "283fdb1d-4be7-5644-aaf9-820e24ebcdcb" #edb/ref 17592186045417] [17592186051078 #edb/ref 1027 #edb/ref 17592186048167 #edb/ref 17592186045417] [17592186051078 #edb/ref 1027 #edb/ref 17592186048287 #edb/ref 17592186045417] [17592186051078 #edb/ref 1027 #edb/ref 17592186048551 #edb/ref 17592186045417] [17592186051078 #edb/ref 1027 #edb/ref 17592186048866 #edb/ref 17592186045417] [17592186051078 #edb/ref 1027 #edb/ref 17592186049761 #edb/ref 17592186045417] [17592186051078 #edb/ref 1027 #edb/ref 17592186050142 #edb/ref 17592186045417] [17592186051078 #edb/ref 1027 #edb/ref 17592186050222 #edb/ref 17592186045417] [17592186051078 #edb/ref 1027 #edb/ref 17592186050583 #edb/ref 17592186045417] [17592186051078 #edb/ref 1027 #edb/ref 17592186050760 #edb/ref 17592186045417] [17592186051078 #edb/ref 1027 #edb/ref 17592186050980 #edb/ref 17592186045417] [17592186051078 #edb/ref 1028 #edb/ref 17592186184211 #edb/ref 17592186045417] [17592186051078 #edb/ref 1028 #edb/ref 17592186184212 #edb/ref 17592186045417] [17592186051078 #edb/ref 1028 #edb/ref 17592186184322 #edb/ref 17592186045417] [17592186051078 #edb/ref 1028 #edb/ref 17592186184323 #edb/ref 17592186045417] [17592186051078 #edb/ref 1029 #edb/ref 17592186429233 #edb/ref 17592186045436] [17592186051078 #edb/ref 1031 "Completing the Square With Leading Coefficients" #edb/ref 17592186045417] [17592186051078 #edb/ref 1033 3824 #edb/ref 17592186045417] [17592186051078 #edb/ref 1034 1.20001426448432 #edb/ref 17592186045436] [17592186051078 #edb/ref 1035 #uuid "7f1179a4-dcfa-50b2-b12b-655dfefa3ff3" #edb/ref 17592186045417] [17592186051081 #edb/ref 1027 #edb/ref 17592186049477 #edb/ref 17592186045417] [17592186051081 #edb/ref 1028 #edb/ref 17592186087724 #edb/ref 17592186045417] [17592186051081 #edb/ref 1028 #edb/ref 17592186087725 #edb/ref 17592186045417] [17592186051081 #edb/ref 1028 #edb/ref 17592186087728 #edb/ref 17592186045417] [17592186051081 #edb/ref 1028 #edb/ref 17592186087729 #edb/ref 17592186045417] [17592186051081 #edb/ref 1029 #edb/ref 17592186429653 #edb/ref 17592186045436] [17592186051081 #edb/ref 1029 #edb/ref 17592186429654 #edb/ref 17592186045436] [17592186051081 #edb/ref 1031 "Finding Intercepts of Ellipses" #edb/ref 17592186045417] [17592186051081 #edb/ref 1033 850 #edb/ref 17592186045417] [17592186051081 #edb/ref 1034 1.2655324105615433 #edb/ref 17592186045436] [17592186051081 #edb/ref 1035 #uuid "7fa30ad3-9041-5912-9f1e-90bd24bebbe8" #edb/ref 17592186045417] [17592186087525 #edb/ref 1069 "e-5213" #edb/ref 17592186045417] [17592186087525 #edb/ref 1071 "![](images/45/4527514f6b522bf5922bcba4b77a1574b29f65c238c8b3dd976d6af6bb6c01ae.png)\n\nCalculate the points where the ellipse $x^2 + 3y^2 - 4x -  6y = 2$ (shown above) intercepts the $x$-axis." #edb/ref 17592186045417] [17592186087525 #edb/ref 1072 #uuid "58d92951-d993-50ec-806c-802c627ada96" #edb/ref 17592186045417] [17592186087525 #edb/ref 1074 "To calculate the $x$-intercepts, we need to substitute $y = 0$ into the equation of the ellipse and solve the resulting equation for $x.$ We do this and solve the resulting equation by completing the square:\n\n$$\n\\begin{aligned}{x}^{2}+3{y}^{2}-4x-6y & =2 \\\\ {x}^{2}+3\\cdot {0}^{2}-4x-6\\cdot 0 & =2 \\\\ {x}^{2}-4x & =2 \\\\ ({x}^{2}-4x+4)-4 & =2 \\\\ (x-2)^{2}-4 & =2 \\\\ (x-2)^{2} & =6 \\\\ x-2 & =\\pm \\sqrt{6} \\\\ x & =2\\pm \\sqrt{6}\\end{aligned}\n$$\n\nTherefore, the ellipse intercepts the $x$-axis at $(2-\\sqrt{6},0)$ and $(2+\\sqrt{6},0).$" #edb/ref 17592186045417] [17592186087526 #edb/ref 1069 "e-5214" #edb/ref 17592186045417] [17592186087526 #edb/ref 1071 "Calculate the point where the ellipse $(x-2)^2 + \\dfrac{(y-2)^2}{4} = 1$ intercepts the $x$-axis." #edb/ref 17592186045417] [17592186087526 #edb/ref 1072 #uuid "a7fe6697-669c-57e2-8415-4bd40cf76dac" #edb/ref 17592186045417] [17592186087526 #edb/ref 1074 "To calculate the $x$-intercept, we need to substitute $y = 0$ into the equation of the ellipse and solve the resulting equation for $x.$ Doing this, we get\n\n$$\n\\begin{aligned}(x-2)^{2}+\\frac{(y-2)^{2}}{4} & =1 \\\\ (x-2)^{2}+\\frac{(0-2)^{2}}{4} & =1 \\\\ (x-2)^{2}+1 & =1 \\\\ (x-2)^{2} & =0 \\\\ x-2 & =0 \\\\ x & =2.\\end{aligned}\n$$\n\nTherefore, the ellipse intercepts the $x$-axis at the point $(2,0).$\n\n![](images/db/db1ffc11b3321e87f7c5d2cb490d0381f4b950dfcfd64be00f49c07577f797c0.png)" #edb/ref 17592186045417] [17592186087530 #edb/ref 1069 "e-5220" #edb/ref 17592186045417] [17592186087530 #edb/ref 1071 "Calculate the point where the ellipse $\\dfrac{(x-1)^2}{4}+\\dfrac{(y-3)^2}{16}=1$ intercepts the $y$-axis." #edb/ref 17592186045417] [17592186087530 #edb/ref 1072 #uuid "85e115e3-4f55-53e6-9d3b-decb3dc02267" #edb/ref 17592186045417] [17592186087530 #edb/ref 1074 "To calculate the $y$-intercept, we need to substitute $x = 0$ in the equation of the ellipse and solve the resulting equation for $y.$ Doing this, we get\n\n$$\n\\begin{aligned}\\frac{(x-1)^{2}}{4}+\\frac{(y-3)^{2}}{16} & =1 \\\\ \\frac{(0-1)^{2}}{4}+\\frac{(y-3)^{2}}{16} & =1 \\\\ \\frac{1}{4}+\\frac{(y-3)^{2}}{16} & =1 \\\\ \\frac{(y-3)^{2}}{16} & =\\frac{3}{4} \\\\ (y-3)^{2} & =12 \\\\ y-3 & =\\pm \\sqrt{12} \\\\ y-3 & =2\\sqrt{3} \\\\ y & =3\\pm 2\\sqrt{3}.\\end{aligned}\n$$\n\nTherefore, the ellipse intercepts the $y$-axis at the points $(0,3 -2\\sqrt{3})$ and $(0,3 +2\\sqrt{3}).$\n\n![](images/c0/c090d0410cca8d00f0f93641a4f8bfbfa66c3b586894797e5c5c89291d11126d.png)" #edb/ref 17592186045417] [17592186087531 #edb/ref 1069 "e-5221" #edb/ref 17592186045417] [17592186087531 #edb/ref 1071 "Calculate the points where the ellipse $5x^2 + 2y^2 - 20x - 8y + 13 = 0$ intercepts the $y$-axis." #edb/ref 17592186045417] [17592186087531 #edb/ref 1072 #uuid "5cbcffa6-eb3d-5438-ba08-4b47cbbf76ce" #edb/ref 17592186045417] [17592186087531 #edb/ref 1074 "To calculate the $y$-intercepts, we need to substitute $x = 0$ in the equation of the ellipse and try to solve the resulting equation for $y.$ We do this and solve the resulting equation by completing the square:\n\n$$\n\\begin{aligned}5{x}^{2}+2{y}^{2}-20x-8y+13 & =0 \\\\ 5\\cdot {0}^{2}+2{y}^{2}-20\\cdot 0-8y+13 & =0 \\\\ 2{y}^{2}-8y+13 & =0 \\\\ 2({y}^{2}-4y)+13 & =0 \\\\ 2[{y}^{2}-4y+4-4]+13 & =0 \\\\ 2[(y-2)^{2}-4]+13 & =0 \\\\ 2{(y-2)}^{2}+5 & =0 \\\\ (y-2)^{2} & =-\\frac{5}{2}\\end{aligned}\n$$\n\nSince $(y-2)^2 \\geq 0$, there is no $y$ such that $(y-2)^2 = -\\dfrac{5}{2}.$ Therefore, the ellipse has no $y$-intercepts, meaning that it does not intercept the $y$-axis at any point.\n\n![](images/dc/dc56aec7e7c16c4fcfee77f7126f53351c1513c4bfb5e64ac41834ed30ee5782.png)" #edb/ref 17592186045417] [17592186087724 #edb/ref 1037 #edb/ref 17592186049250 #edb/ref 17592186045417] [17592186087724 #edb/ref 1038 #edb/ref 17592186088334 #edb/ref 17592186045417] [17592186087724 #edb/ref 1038 #edb/ref 17592186088456 #edb/ref 17592186045417] [17592186087724 #edb/ref 1038 #edb/ref 17592186284650 #edb/ref 17592186045417] [17592186087724 #edb/ref 1038 #edb/ref 17592186292736 #edb/ref 17592186045417] [17592186087724 #edb/ref 1038 #edb/ref 17592186292737 #edb/ref 17592186045417] [17592186087724 #edb/ref 1038 #edb/ref 17592186302259 #edb/ref 17592186045417] [17592186087724 #edb/ref 1038 #edb/ref 17592186302260 #edb/ref 17592186045417] [17592186087724 #edb/ref 1038 #edb/ref 17592186302325 #edb/ref 17592186045417] [17592186087724 #edb/ref 1038 #edb/ref 17592186304776 #edb/ref 17592186045417] [17592186087724 #edb/ref 1038 #edb/ref 17592186341886 #edb/ref 17592186045417] [17592186087724 #edb/ref 1038 #edb/ref 17592186360455 #edb/ref 17592186045417] [17592186087724 #edb/ref 1038 #edb/ref 17592186372572 #edb/ref 17592186045417] [17592186087724 #edb/ref 1038 #edb/ref 17592186372577 #edb/ref 17592186045417] [17592186087724 #edb/ref 1038 #edb/ref 17592186372582 #edb/ref 17592186045417] [17592186087724 #edb/ref 1038 #edb/ref 17592186373400 #edb/ref 17592186045417] [17592186087724 #edb/ref 1038 #edb/ref 17592186403342 #edb/ref 17592186045417] [17592186087724 #edb/ref 1038 #edb/ref 17592186403599 #edb/ref 17592186045417] [17592186087724 #edb/ref 1038 #edb/ref 17592186403850 #edb/ref 17592186045417] [17592186087724 #edb/ref 1038 #edb/ref 17592186404713 #edb/ref 17592186045417] [17592186087724 #edb/ref 1039 "Calculating the x-Intercepts of an Ellipse By Completing the Square" #edb/r