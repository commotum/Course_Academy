t/id #uuid "a57ec9ff-99fd-5a3d-9a89-e76ded9d01cb" :knowledge-point/questions [{:db/id #edb/ref 17592186088044} {:db/id #edb/ref 17592186088045} {:db/id #edb/ref 17592186284574} {:db/id #edb/ref 17592186292739} {:db/id #edb/ref 17592186302279} {:db/id #edb/ref 17592186304780} {:db/id #edb/ref 17592186304781} {:db/id #edb/ref 17592186304782} {:db/id #edb/ref 17592186360470} {:db/id #edb/ref 17592186372342} {:db/id #edb/ref 17592186372591} {:db/id #edb/ref 17592186372608} {:db/id #edb/ref 17592186373407} {:db/id #edb/ref 17592186395964} {:db/id #edb/ref 17592186396148} {:db/id #edb/ref 17592186396230} {:db/id #edb/ref 17592186403843}] :knowledge-point/title "Calculating the y-Intercepts of an Ellipse"} :step/id #uuid "248bc4f4-7b1d-5e3d-a1d2-9254f6321d1b" :step/math-academy-id 19227 :step/next {:db/id #edb/ref 17592186088576}} {:db/id #edb/ref 17592186088576 :step/content {:db/id #edb/ref 17592186087729 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087531 :question/id #uuid "5cbcffa6-eb3d-5438-ba08-4b47cbbf76ce" :question/math-academy-id "e-5221"} :knowledge-point/id #uuid "fea426db-a854-5efc-a0cd-7d52019a7cc6" :knowledge-point/questions [{:db/id #edb/ref 17592186088457} {:db/id #edb/ref 17592186088458} {:db/id #edb/ref 17592186292740} {:db/id #edb/ref 17592186292743} {:db/id #edb/ref 17592186302320} {:db/id #edb/ref 17592186302321} {:db/id #edb/ref 17592186302322} {:db/id #edb/ref 17592186302323} {:db/id #edb/ref 17592186304778} {:db/id #edb/ref 17592186341887} {:db/id #edb/ref 17592186360472} {:db/id #edb/ref 17592186372356} {:db/id #edb/ref 17592186372596} {:db/id #edb/ref 17592186373414} {:db/id #edb/ref 17592186403349} {:db/id #edb/ref 17592186403857}] :knowledge-point/title "Calculating the y-Intercepts of an Ellipse By Completing the Square"} :step/id #uuid "4d77cb04-2793-57de-8295-d5d5ed5ec03a" :step/math-academy-id 19229} {:db/id #edb/ref 17592186088583 :step/content {:db/id #edb/ref 17592186088918 :tutorial/content "Some ellipses have no $x$-intercepts. For example, consider the ellipse given by the equation \n\n$$\n\\dfrac{(x-3)^2}{4} + (y-2)^2 = 1.\n$$\n\nAs we can see in the graph below, this ellipse does not intercept the $x$-axis.\n\n![](images/f1/f112a9054947dfd03d5b4d6c370fa56e651ea29779480c8cc40e592c89fd6823.png)\n\nAlgebraically, we can tell that an ellipse has no $x$-intercepts if there are no solutions when we substitute $y=0$ into the equation.\n\nFor example, substituting $y=0$ into the equation of the ellipse given above, we find no solutions:\n\n$$\n\\begin{aligned}\\frac{(x-3)^{2}}{4}+(y-2)^{2} & =1 \\\\ \\frac{(x-3)^{2}}{4}+(0-2)^{2} & =1 \\\\ \\frac{(x-3)^{2}}{4}+4 & =1 \\\\ \\frac{(x-3)^{2}}{4} & =-3 \\\\ (x-3)^{2} & =-12\\end{aligned}\n$$\n\nSince $(x-3)^2 \\geq 0$, there is no $x$ such that $(x-3)^2 = -12.$ Therefore, the ellipse has no $x$-intercepts, meaning that it does not intercept the $x$-axis at any point." :tutorial/id #uuid "5f5dc1af-29bc-5b89-9d88-afd2a4ea52c4" :tutorial/math-academy-id 3435 :tutorial/title "Ellipses with No x-Intercepts"} :step/id #uuid "8a35e05f-7d8b-5119-a490-40ffe2a5513d" :step/math-academy-id 19443 :step/next {:db/id #edb/ref 17592186088570}} {:db/id #edb/ref 17592186088584 :step/content {:db/id #edb/ref 17592186088919 :tutorial/content "Again, some ellipses have no $y$-intercepts. For example, consider the ellipse given by the equation\n\n$$\n(x-2)^2 + \\dfrac{(y-3)^2}{4} = 1.\n$$\n\nAs we can see in the graph below, this ellipse does not intercept the $y$-axis.\n\n![](images/64/64e23ef486d53706055b78e2bcd4746d735c9fcf18c5462cf9da5718100574bf.png)\n\nAlgebraically, we can tell that an ellipse has no $y$-intercepts if there are no solutions when we substitute $x=0$ into the equation.\n\nFor example, substituting $x=0$ into the equation of the ellipse given above, we find no solutions:\n\n$$\n\\begin{aligned}(x-2)^{2}+\\frac{(y-3)^{2}}{4} & =1 \\\\ (0-2)^{2}+\\frac{(y-3)^{2}}{4} & =1 \\\\ 4+\\frac{(y-3)^{2}}{4} & =1 \\\\ \\frac{(y-3)^{2}}{4} & =-3 \\\\ (y-3)^{2} & =-12.\\end{aligned}\n$$\n\nSince $(y-3)^2 \\geq 0$, there is no $y$ such that $(y-3)^2 = -12.$ Therefore, the ellipse has no $y$-intercepts, meaning that it does not intercept the $y$-axis at any point." :tutorial/id #uuid "01941859-2f9f-5be9-adf7-d10e754dd7e5" :tutorial/math-academy-id 3436 :tutorial/title "Ellipses with No y-Intercepts"} :step/id #uuid "2d70d9e6-42fa-5815-b0c7-6f8c1a7c0486" :step/math-academy-id 19444 :step/next {:db/id #edb/ref 17592186088575}}] :activity/title "Finding Intercepts of Ellipses" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186087921}]}
