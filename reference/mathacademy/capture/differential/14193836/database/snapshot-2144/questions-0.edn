 17592186292323} {:answer-field/choices [{:answer/id #uuid "876ce42f-4d4b-5ff4-9bba-e69a11cf3a9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186291210}] :answer-field/correct {:answer/id #uuid "876ce42f-4d4b-5ff4-9bba-e69a11cf3a9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186291210} :answer-field/id #uuid "d69c407e-70fa-5ef3-8e50-88f4c38a8c89" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292388}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ea93f497-bb1a-5f28-9ba2-bcebd270406b" :question/math-academy-id "q-274483" :question/problem "From **left to right**, the ellipse $25{x}^{2}+14{y}^{2}-50x-11y=29$ intercepts the $x$-axis at the points $A$ and $B.$ Find the coordinates of these points.\n\n$A($\n{{field-1}}\n$,$\n{{field-2}}$)\\,$\n\nand \n\n$\\,B($\n{{field-3}}$,$\n{{field-4}}\n$)$" :question/worked-solution "To calculate the $x$-intercepts, we need to substitute $y=0$ into the equation of the ellipse and solve the resulting equation for $x.$ We do this and solve the resulting equation by completing the square:\n\n$$\n\\begin{aligned}25{x}^{2}+14{y}^{2}-50x-11y & =29 \\\\ 25{x}^{2}+14(0)^{2}-50x-11(0) & =29 \\\\ 25{x}^{2}-50x & =29 \\\\ {x}^{2}-2x & =\\frac{29}{25} \\\\ (x-1)^{2}-{1}^{2} & =\\frac{29}{25} \\\\ (x-1)^{2} & =\\frac{29}{25}+1 \\\\ (x-1)^{2} & =\\frac{29}{25}+\\frac{25}{25} \\\\ (x-1)^{2} & =\\frac{54}{25} \\\\ x-1 & =\\pm \\frac{3\\sqrt{6}}{5} \\\\ x & =1\\pm \\frac{3\\sqrt{6}}{5}\\end{aligned}\n$$\n\nTherefore, from left to right, the $x$-intercepts are\n\n$$\nA(1-\\frac{3\\sqrt{6}}{5},0)\\,\\text{and}\\,B(1+\\frac{3\\sqrt{6}}{5},0).\n$$"}] [{:db/id #edb/ref 17592186302227 :knowledge-point/_questions [{:db/id #edb/ref 17592186087725 :knowledge-point/id #uuid "74a508c1-2379-590f-85f5-386a1990f137" :knowledge-point/title "Calculating the x-Intercepts of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d245bd1-16b6-5012-a8d9-04904c36e4c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186300098}] :answer-field/correct {:answer/id #uuid "1d245bd1-16b6-5012-a8d9-04904c36e4c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186300098} :answer-field/id #uuid "68e33511-4f81-5c80-923e-e15b804a92f3" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301559} {:answer-field/choices [{:answer/id #uuid "4b9ad17a-08c5-549d-bdca-ef656f5b4921" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186300355}] :answer-field/correct {:answer/id #uuid "4b9ad17a-08c5-549d-bdca-ef656f5b4921" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186300355} :answer-field/id #uuid "77a6ead7-3faa-53ce-955a-2c79a8fa6193" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301597}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6faabf38-ea7b-5072-9ed7-46de60d9b5e2" :question/math-academy-id "q-325860" :question/problem "Calculate the point where the ellipse $\\frac{(x+3)^{2}}{9}+\\frac{(y-6)^{2}}{36}=1$ intercepts the $x$-axis.\n\nThe $x$-intercept is $($\n{{field-1}}\n,\n{{field-2}}$).$" :question/worked-solution "To calculate the $x$-intercept, we need to substitute $y=0$ into the equation of the ellipse and solve the resulting equation for $x.$ Doing this, we get\n\n$$\n\\begin{aligned}\\frac{(x+3)^{2}}{9}+\\frac{(y-6)^{2}}{36} & =1 \\\\ \\frac{(x+3)^{2}}{9}+\\frac{(0-6)^{2}}{36} & =1 \\\\ \\frac{(x+3)^{2}}{9}+\\frac{36}{36} & =1 \\\\ \\frac{(x+3)^{2}}{9}+1 & =1 \\\\ \\frac{(x+3)^{2}}{9} & =0 \\\\ (x+3)^{2} & =0 \\\\ x+3 & =0 \\\\ x & =-3.\\end{aligned}\n$$\n\nTherefore, the ellipse intercepts the $x$-axis at the point $(-3,0).$\n\n![](images/5a/5a1377fa0ff46ff7a7e4b685d38852ad67abd8c0adfc432fc22d7c1d57b7a57f.png)"}] [{:db/id #edb/ref 17592186302260 :knowledge-point/_questions [{:db/id #edb/ref 17592186087724 :knowledge-point/id #uuid "6381faa4-5dfd-58fa-ace7-411fd2a97e98" :knowledge-point/title "Calculating the x-Intercepts of an Ellipse By Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b42abee5-d9b5-5350-b275-d5c52870eead" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186300858}] :answer-field/correct {:answer/id #uuid "b42abee5-d9b5-5350-b275-d5c52870eead" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186300858} :answer-field/id #uuid "ae584667-f653-502a-8a6d-e9a67817154d" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301793} {:answer-field/choices [{:answer/id #uuid "7c506244-23a8-501d-b5b4-52708d2ca4b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186300581}] :answer-field/correct {:answer/id #uuid "7c506244-23a8-501d-b5b4-52708d2ca4b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186300581} :answer-field/id #uuid "c2a331de-b101-5cb3-b886-0857e82653de" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301861}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "99df4a96-1be0-51fa-912f-796019bd7b76" :question/math-academy-id "q-326043" :question/problem "Calculate the point where the ellipse  $9{x}^{2}+8{y}^{2}+18x+32y+9=0$ intercepts the $x$-axis.\n\nThe $x$-intercept is $($\n{{field-1}}\n,\n{{field-2}}$).$" :question/worked-solution "To calculate the $x$-intercepts, we need to substitute $y=0$ into the equation of the ellipse and solve the resulting equation for $x.$ We do this and solve the resulting equation by completing the square:\n\n$$\n\\begin{aligned}9{x}^{2}+8{y}^{2}+18x+32y+9 & =0 \\\\ 9{x}^{2}+8\\cdot {0}^{2}+18x+32\\cdot 0+9 & =0 \\\\ 9{x}^{2}+18x+9 & =0 \\\\ 9\\,[{x}^{2}+2x]+9 & =0 \\\\ 9[(x+1)^{2}-1]+9 & =0 \\\\ 9(x+1)^{2}-9+9 & =0 \\\\ 9(x+1)^{2} & =0 \\\\ x+1 & =0 \\\\ x & =-1\\end{aligned}\n$$\n\nTherefore, the ellipse intercepts the $x$-axis at  $(-1,0).$"}] [{:db/id #edb/ref 17592186372582 :knowledge-point/_questions [{:db/id #edb/ref 17592186087724 :knowledge-point/id #uuid "6381faa4-5dfd-58fa-ace7-411fd2a97e98" :knowledge-point/title "Calculating the x-Intercepts of an Ellipse By Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9b4f9c13-25d7-51ba-91a1-c09aa2e884a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3+\\sqrt{17}" :db/id #edb/ref 17592186372584}] :answer-field/correct {:answer/id #uuid "9b4f9c13-25d7-51ba-91a1-c09aa2e884a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3+\\sqrt{17}" :db/id #edb/ref 17592186372584} :answer-field/id #uuid "a906b0e6-1a6c-57d9-984d-d0c2cbf7af7d" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186372583} {:answer-field/choices [{:answer/id #uuid "bed9274f-c07b-50c4-ab00-dd9acdb7ebe2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186372586}] :answer-fie