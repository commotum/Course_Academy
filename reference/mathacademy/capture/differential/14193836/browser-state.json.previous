        margin-left:2px;\n                                        margin-right:-1px;\n                                        background:;\"><div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"99\"><span mathquill-command-id=\"105\">3</span><span mathquill-command-id=\"107\" class=\"mq-binary-operator\">−</span><span class=\"mq-fraction mq-non-leaf\" mathquill-command-id=\"109\"><span class=\"mq-numerator\" mathquill-block-id=\"111\"><span mathquill-command-id=\"110\">2</span><span class=\"mq-non-leaf\" mathquill-command-id=\"112\"><span class=\"mq-scaled mq-sqrt-prefix\" style=\"transform: scale(1, 0.995008);\">√</span><span class=\"mq-non-leaf mq-sqrt-stem\" mathquill-block-id=\"114\"><span mathquill-command-id=\"113\">1</span><span mathquill-command-id=\"115\">4</span></span></span></span><span class=\"mq-denominator\" mathquill-block-id=\"119\"><span mathquill-command-id=\"118\">3</span></span><span style=\"display:inline-block;width:0\">​</span></span></span></div></div>\n<mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"-1\" ctxtmenu_counter=\"174\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-texatom texclass=\"ORD\"><mjx-mo class=\"mjx-s4\"><mjx-c class=\"mjx-c29 TEX-S4\"></mjx-c></mjx-mo></mjx-texatom></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"2.470em\" maxsize=\"2.470em\">)</mo></mrow></math></mjx-assistive-mml></mjx-container></div></div><div class=\"questionWidget-buttonBar\"><div class=\"questionWidget-submitButton disabledButton\" style=\"display: none;\">Submit</div></d