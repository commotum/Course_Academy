} \\\\ 1 & 1 & 0\\end{bmatrix}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{A}^{+} & =V\\,{Σ}^{+}\\,{U}^{T} \\\\  & =\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 & -1 \\\\ 1 & 1\\end{bmatrix}\\cdot \\frac{1}{2}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\cdot \\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 & -1 & 0 \\\\ 0 & 0 & \\sqrt{2} \\\\ 1 & 1 & 0\\end{bmatrix} \\\\  & =\\frac{1}{4}\\begin{bmatrix}1 & -1 \\\\ 1 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}1 & -1 & 0 \\\\ 0 & 0 & \\sqrt{2} \\\\ 1 & 1 & 0\\end{bmatrix} \\\\  & =\\frac{1}{4}\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 0 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}1 & -1 & 0 \\\\ 0 & 0 & \\sqrt{2} \\\\ 1 & 1 & 0\\end{bmatrix} \\\\  & =\\frac{1}{4}\\begin{bmatrix}1 & -1 & 0 \\\\ 1 & -1 & 0\\end{bmatrix}.\\end{aligned}\n$$"} :step/id #uuid "496634e4-0c10-57c6-bff9-c049f1451287" :step/next {:db/id #edb/ref 17592186444701}} {:db/id #edb/ref 17592186444700 :step/content {:db/id #edb/ref 17592186371783 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a66a064-024a-502e-9b04-347d649103a7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{20}\\begin{bmatrix}2 & 2 \\\\ 1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186371785} {:answer/id #uuid "9647bbdf-fcf2-5bad-a3b3-3e9694fc3084" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}\\begin{bmatrix}4 & 2 \\\\ 2 & 1\\end{bmatrix}" :db/id #edb/ref 17592186371786} {:answer/id #uuid "2921dae6-65c8-54c1-bbee-1a5cf4f1be1b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{20}\\begin{bmatrix}2 & -2 \\\\ 1 & -1\\end{bmatrix}" :db/id #edb/ref 17592186371787} {:answer/id #uuid "c1649e67-dae8-577c-9013-fb4d1dfa9a7a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{10}\\begin{bmatrix}2 & -2 \\\\ -1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186371788} {:answer/id #uuid "f92721bb-f509-5c05-9e8a-6cddb7eeedbc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{10}\\begin{bmatrix}4 & 2 \\\\ 2 & 1\\end{bmatrix}" :db/id #edb/ref 17592186371789}] :answer-field/correct {:db/id #edb/ref 17592186371785} :answer-field/id #uuid "90c3d92d-95b1-5446-b383-5a0f0a13437f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186371784}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "730701f6-1ca8-5b40-956c-c0113bda87d0" :question/math-academy-id "q-138495" :question/problem "$$\nU=\\begin{bmatrix}\\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix},\\,Σ=\\begin{bmatrix}2\\sqrt{10} & 0 \\\\ 0 & 0\\end{bmatrix},\\,V=\\begin{bmatrix}\\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}}\\end{bmatrix}\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ find the pseudoinverse ${A}^{+}.$" :question/worked-solution "If $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ then the pseudoinverse of $A$ is given by\n\n$$\nV\\,{Σ}^{+}\\,{U}^{T},\n$$\n\nwhere ${Σ}^{+}$ is the pseudoinverse of $Σ.$\n\nFirst, notice that\n\n$$\nV=\\frac{1}{\\sqrt{5}}\\begin{bmatrix}2 & -1 \\\\ 1 & 2\\end{bmatrix},\\,{Σ}^{+}=\\frac{1}{2\\sqrt{10}}\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix},\\,{U}^{T}=\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 & 1 \\\\ -1 & 1\\end{bmatrix}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{A}^{+} & =V\\,{Σ}^{+}\\,{U}^{T} \\\\  & =\\frac{1}{\\sqrt{5}}\\begin{bmatrix}2 & -1 \\\\ 1 & 2\\end{bmatrix}\\cdot \\frac{1}{2\\sqrt{10}}\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix}\\cdot \\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 & 1 \\\\ -1 & 1\\end{bmatrix} \\\\  & =\\frac{1}{20}\\begin{bmatrix}2 & -1 \\\\ 1 & 2\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 1 \\\\ -1 & 1\\end{bmatrix} \\\\  & =\\frac{1}{20}\\begin{bmatrix}2 & 0 \\\\ 1 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 1 \\\\ -1 & 1\\end{bmatrix} \\\\  & =\\frac{1}{20}\\begin{bmatrix}2 & 2 \\\\ 1 & 1\\end{bmatrix}.\\end{aligned}\n$$"} :step/id #uuid "5fcbaade-02b2-5101-81de-250a75d829da" :step/next {:db/id #edb/ref 17592186444699}} {:db/id #edb/ref 17592186444701 :step/content {:db/id #edb/ref 17592186420790 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1243f8e9-7cde-50e1-b4da-69c3c09e0244" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{50}\\begin{bmatrix}1 & 2 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186420760} {:answer/id #uuid "396c503f-4112-5172-aabe-628ff629a730" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}\\begin{bmatrix}4 & -3 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186420766} {:answer/id #uuid "71ce3c99-faa6-5850-9bb1-6d482034baca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}\\begin{bmatrix}2 & 3 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186420771} {:answer/id #uuid "75a82642-78cf-5946-8735-5f599b8bb673" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{10}\\begin{bmatrix}3 & 4 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186420773} {:answer/id #uuid "d93a36d9-9b8f-5c2d-b424-076056039fbf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{25}\\begin{bmatrix}4 & 3 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186420780}] :answer-field/correct {:db/id #edb/ref 17592186420780} :answer-field/id #uuid "d3fa58d8-221b-5878-a7cd-de5fff20b644" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186420787}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "83e058d9-31bd-5eef-83c8-b6f7c1427845" :question/math-academy-id "q-138579" :question/problem "$$\n{U}_{r}=\\begin{bmatrix}\\frac{4}{5} \\\\ \\frac{3}{5} \\\\ 0\\end{bmatrix},\\,{Σ}_{r}=\\begin{bmatrix}5\\end{bmatrix},\\,{V}_{r}=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}\n$$\n\nConsider the matrices shown above. Given that $A={U}_{r}{Σ}_{r}{V}_{r}^{T}$ is a reduced singular value decomposition of $A,$ find the pseudoinverse ${A}^{+}.$" :question/worked-solution "If $A={U}_{r}{Σ}_{r}{V}_{r}^{T}$ is a reduced singular value decomposition of $A,$ then the pseudoinverse of $A$ is given by\n\n$$\n{V}_{r}\\,{Σ}_{r}^{+}\\,{U}_{r}^{T},\n$$\n\nwhere ${Σ}_{r}^{+}$ is the pseudoinverse of ${Σ}_{r}.$\n\nFirst, notice that\n\n$$\n{Σ}_{r}^{+}=\\frac{1}{5}\\begin{bmatrix}1\\end{bmatrix},\\,{U}_{r}^{T}=\\frac{1}{5}\\begin{bmatrix}4 & 3 & 0\\end{bmatrix}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{A}^{+} & ={V}_{r}\\,{Σ}_{r}^{+}\\,{U}_{r}^{T} \\\\  & =\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}\\cdot \\frac{1}{5}\\begin{bmatrix}1\\end{bmatrix}\\cdot \\frac{1}{5}\\begin{bmatrix}4 & 3 & 0\\end{bmatrix} \\\\  & =\\frac{1}{25}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}\\cdot \\begin{bmatrix}1\\end{bmatrix}\\cdot \\begin{bmatrix}4 & 3 & 0\\end{bmatrix} \\\\  & =\\frac{1}{25}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}\\cdot \\begin{bmatrix}4 & 3 & 0\\end{bmatrix} \\\\  & =\\frac{1}{25}\\begin{bmatrix}4 & 3 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}.\\end{aligned}\n$$"} :step/id #uuid "94166d57-4bd4-519e-8eab-62cc36e1b49c" :step/next {:db/id #edb/ref 17592186444703}} {:db/id #edb/ref 17592186444702 :step/content {:db/id #edb/ref 17592186162345 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b31a3213-6d62-5519-ac95-346c2bef5b5d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{50}\\begin{bmatrix}-3 & 4 \\\\ 4 & -3\\end{bmatrix}" :db/id #edb/ref 17592186388494} {:answer/id #uuid "f79a1708-92c0-594d-97af-70797d07c647" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{50}\\begin{bmatrix}-4 & 4 \\\\ 3 & -3\\end{bmatrix}" :db/id #edb/ref 17592186388495} {:answer/id #uuid "22e67faa-26c8-5a3f-8ac2-2e70e7163f7b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{50}\\begin{bmatrix}3 & -3 \\\\ -4 & 4\\end{bmatrix}" :db/id #edb/ref 17592186388496} {:answer/id #uuid "e40c9722-c036-5e6f-b81f-4c1388f000ee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{25}\\begin{bmatrix}-3 & 4 \\\\ 4 & -3\\end{bmatrix}" :db/id #edb/ref 17592186388497} {:answer/id #uuid "0f190784-d3ea-5b28-a3a5-404a8ae0d16b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{25}\\begin{bmatrix}3 & -3 \\\\ -4 & 4\\end{bmatrix}" :db/id #edb/ref 17592186388498}] :answer-field/correct {:db/id #edb/ref 17592186388496} :answer-field/id #uuid "053ac9c2-65bd-5970-b100-18b05cb5c7be" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186388493}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "44a4660e-d3b5-5880-9cf8-ce9a4c5ec070" :question/math-academy-id "q-136973" :question/problem "$$\nU=\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix},\\,Σ=\\begin{bmatrix}5\\sqrt{2} & 0 \\\\ 0 & 0\\end{bmatrix},\\,V=\\begin{bmatrix}-\\frac{3}{5} & \\frac{4}{5} \\\\ \\frac{4}{5} & \\frac{3}{5}\\end{bmatrix}\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ find the pseudoinverse ${A}^{+}.$" :question/worked-solution "If $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ then the pseudoinverse of $A$ is given by\n\n$$\nV\\,{Σ}^{+}\\,{U}^{T},\n$$\n\nwhere ${Σ}^{+}$ is the pseudoinverse of $Σ.$\n\nFirst, notice that\n\n$$\nV=\\frac{1}{5}\\begin{bmatrix}-3 & 4 \\\\ 4 & 3\\end{bmatrix},\\,{Σ}^{+}=\\frac{1}{5\\sqrt{2}}\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix},\\,{U}^{T}=\\frac{1}{\\sqrt{2}}\\begin{bmatrix}-1 & 1 \\\\ 1 & 1\\end{bmatrix}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{A}^{+} & =V\\,{Σ}^{+}\\,{U}^{T} \\\\  & =\\frac{1}{5}\\begin{bmatrix}-3 & 4 \\\\ 4 & 3\\end{bmatrix}\\cdot \\frac{1}{5\\sqrt{2}}\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix}\\cdot \\frac{1}{\\sqrt{2}}\\begin{bmatrix}-1 & 1 \\\\ 1 & 1\\end{bmatrix} \\\\  & =\\frac{1}{50}\\begin{bmatrix}-3 & 4 \\\\ 4 & 3\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}-1 & 1 \\\\ 1 & 1\\end{bmatrix} \\\\  & =\\frac{1}{50}\\begin{bmatrix}-3 & 0 \\\\ 4 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}-1 & 1 \\\\ 1 & 1\\end{bmatrix} \\\\  & =\\frac{1}{50}\\begin{bmatrix}3 & -3 \\\\ -4 & 4\\end{bmatrix}.\\end{aligned}\n$$"} :step/id #uuid "d63bb2f1-4002-576c-8baa-85ec6da4c842" :step/next {:db/id #edb/ref 17592186444700}} {:db/id #edb/ref 17592186444703 :step/content {:db/id #edb/ref 17592186388566 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e4372203-9216-542b-970e-8cec151b32b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}\\begin{bmatrix}2 & 0 & 1 \\\\ 2 & 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186388568} {:answer/id #uuid "25f946f1-f189-517c-8d4f-b7f6d74888cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{50}\\begin{bmatrix}2 & 0 & 2 \\\\ 3 & 0 & 3\\end{bmatrix}" :db/id #edb/ref 17592186388569} {:answer/id #uuid "a3e8a4db-a98e-5764-a4cd-a07ee633c5e7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{15}\\begin{bmatrix}1 & 0 & -1 \\\\ 2 & 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186388570} {:answer/id #uuid "71d51881-84bd-5ffd-b315-fb3f57f85778" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{20}\\begin{bmatrix}1 & 0 & -2 \\\\ 1 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186388571} {:answer/id #uuid "82ca2f2f-9b22-51bd-ac91-e35d0267268a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{30}\\begin{bmatrix}2 & 0 & -1 \\\\ 2 & 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186388572}] :answer-field/correct {:db/id #edb/ref 17592186388572} :answer-field/id #uuid "519e599e-557f-5219-8bbb-718b79623ca0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186388567}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "4e5b5ecc-a097-5151-8920-89607e5df059" :question/math-academy-id "q-138669" :question/problem "$$\n{U}_{r}=\\begin{bmatrix}\\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}} \\\\ 0 & 0 \\\\ -\\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}}\\end{bmatrix},\\,{Σ}_{r}=\\begin{bmatrix}15 & 0 \\\\ 0 & 10\\end{bmatrix},\\,{V}_{r}=\\begin{bmatrix}\\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}} \\\\ -\\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}}\\end{bmatrix}\n$$\n\nConsider the matrices shown above. Given that $A={U}_{r}{Σ}_{r}{V}_{r}^{T}$ is a reduced singular value decomposition of $A,$ find the pseudoinverse ${A}^{+}.$" :question/worked-solution "If $A={U}_{r}{Σ}_{r}{V}_{r}^{T}$ is a reduced singular value decomposition of $A,$ then the pseudoinverse of $A$ is given by\n\n$$\n{V}_{r}\\,{Σ}_{r}^{+}\\,{U}_{r}^{T},\n$$\n\nwhere ${Σ}_{r}^{+}$ is the pseudoinverse of ${Σ}_{r}.$\n\nFirst, notice that\n\n$$\n{V}_{r}=\\frac{1}{\\sqrt{5}}\\begin{bmatrix}2 & 1 \\\\ -1 & 2\\end{bmatrix},\\,{Σ}_{r}^{+}=\\frac{1}{30}\\begin{bmatrix}2 & 0 \\\\ 0 & 3\\end{bmatrix},\\,{U}_{r}^{T}=\\frac{1}{\\sqrt{5}}\\begin{bmatrix}1 & 0 & -2 \\\\ 2 & 0 & 1\\end{bmatrix}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{A}^{+} & ={V}_{r}\\,{Σ}_{r}^{+}\\,{U}_{r}^{T} \\\\  & =\\frac{1}{\\sqrt{5}}\\begin{bmatrix}2 & 1 \\\\ -1 & 2\\end{bmatrix}\\cdot \\frac{1}{30}\\begin{bmatrix}2 & 0 \\\\ 0 & 3\\end{bmatrix}\\cdot \\frac{1}{\\sqrt{5}}\\begin{bmatrix}1 & 0 & -2 \\\\ 2 & 0 & 1\\end{bmatrix} \\\\  & =\\frac{1}{150}\\begin{bmatrix}2 & 1 \\\\ -1 & 2\\end{bmatrix}\\cdot \\begin{bmatrix}2 & 0 \\\\ 0 & 3\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 & -2 \\\\ 2 & 0 & 1\\end{bmatrix} \\\\  & =\\frac{1}{150}\\begin{bmatrix}4 & 3 \\\\ -2 & 6\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 & -2 \\\\ 2 & 0 & 1\\end{bmatrix} \\\\  & =\\frac{1}{150}\\begin{bmatrix}10 & 0 & -5 \\\\ 10 & 0 & 10\\end{bmatrix} \\\\  & =\\frac{1}{30}\\begin{bmatrix}2 & 0 & -1 \\\\ 2 & 0 & 2\\end{bmatrix}.\\end{aligned}\n$$"} :step/id #uuid "eb3412d5-16df-507f-9b06-15b54daa4c47"}] :activity/title "Singular Value Decomposition and the Pseudoinverse Matrix" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186444698}] [{:activity/course {:db/id #edb/ref 17592186046644} :activity/first-step {:db/id #edb/ref 17592186511662} :activity/id #uuid "b5254e07-5277-5044-88b8-8db457aafdb3" :activity/scope {:db/id #edb/ref 17592186049503 :topic/id #uuid "fa18866e-f310-5b54-8bcb-21e9073c9cde" :topic/math-academy-id 3134} :activity/steps [{:db/id #edb/ref 17592186511591 :step/content {:db/id #edb/ref 17592186511514 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03c592a0-a31a-5768-80a4-19414e8114d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{10}[\\begin{aligned}1 & -1 \\\\ 2 & -2 \\\\ 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186510785} {:answer/id #uuid "3ca7b07c-b688-5430-bb51-a1a02662d23f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{10}[\\begin{aligned}2 & -1 & 0 \\\\ 2 & 1 & 0\\end{aligned}]" :db/id #edb/ref 17592186510921} {:answer/id #uuid "503b74e3-9bce-5949-8ad7-9b878630cf87" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{10}[\\begin{aligned}0 & 0 \\\\ 2 & -2 \\\\ 1 & -1\\end{aligned}]" :db/id #edb/ref 17592186510953} {:answer/id #uuid "ad9aa926-113d-59e6-8eab-0e2641ef958e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{10}[\\begin{aligned}1 & -1 & 0 \\\\ 2 & -2 & 0\\end{aligned}]" :db/id #edb/ref 17592186511144} {:answer/id #uuid "caa6eda2-e6f0-5988-9e38-f7cffa0af3f4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{10}[\\begin{aligned}0 & -1 & 1 \\\\ 0 & -2 & 2\\end{aligned}]" :db/id #edb/ref 17592186511202}] :answer-field/correct {:db/id #edb/ref 17592186511144} :answer-field/id #uuid "29dc167c-c1ad-5d54-8910-071c51c74e87" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186511334}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "80fca04e-db43-5719-819a-d2aec209a00e" :question/math-academy-id "q-138536" :question/problem "$$\nU=[\\begin{aligned}\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} & 0 \\\\ -\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} & 0 \\\\ 0 & 0 & 1\\end{aligned}],\\,Σ=[\\begin{aligned}\\sqrt{10} & 0 \\\\ 0 & 0 \\\\ 0 & 0\\end{aligned}],\\,V=[\\begin{aligned}\\frac{1}{\\sqrt{5}} & -\\frac{2}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}}\\end{aligned}]\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ find the pseudoinverse ${A}^{+}.$" :question/worked-solution "If $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ then the pseudoinverse of $A$ is given by\n\n$$\nV\\,{Σ}^{+}\\,{U}^{T},\n$$\n\nwhere ${Σ}^{+}$ is the pseudoinverse of $Σ.$\n\nFirst, notice that\n\n$$\nV=\\frac{1}{\\sqrt{5}}[\\begin{aligned}1 & -2 \\\\ 2 & 1\\end{aligned}],\\,{Σ}^{+}=\\frac{1}{\\sqrt{10}}[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}],\\,{U}^{T}=\\frac{1}{\\sqrt{2}}[\\begin{aligned}1 & -1 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & \\sqrt{2}\\end{aligned}].\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{A}^{+} & =V\\,{Σ}^{+}\\,{U}^{T} \\\\  & =\\frac{1}{\\sqrt{5}}[\\begin{aligned}1 & -2 \\\\ 2 & 1\\end{aligned}]\\cdot \\frac{1}{\\sqrt{10}}[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\cdot \\frac{1}{\\sqrt{2}}[\\begin{aligned}1 & -1 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & \\sqrt{2}\\end{aligned}] \\\\  & =\\frac{1}{10}[\\begin{aligned}1 & -2 \\\\ 2 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\cdot [\\begin{aligned}1 & -1 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & \\sqrt{2}\\end{aligned}] \\\\  & =\\frac{1}{10}[\\begin{aligned}1 & 0 & 0 \\\\ 2 & 0 & 0\\end{aligned}]\\cdot [\\begin{aligned}1 & 