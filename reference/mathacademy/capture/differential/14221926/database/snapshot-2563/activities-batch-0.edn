 \\\\ -1 & 1\\end{bmatrix} \\\\  & =\\frac{1}{20}\\begin{bmatrix}1 & 0 \\\\ 3 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 1 \\\\ -1 & 1\\end{bmatrix} \\\\  & =\\frac{1}{20}\\begin{bmatrix}1 & 1 \\\\ 3 & 3\\end{bmatrix}.\\end{aligned}\n$$"} :step/id #uuid "cdba1b8c-84f0-595a-bbc8-675a1ff04aff" :step/next {:db/id #edb/ref 17592186511595}} {:db/id #edb/ref 17592186511665 :step/content {:db/id #edb/ref 17592186511568 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ae11b85-45e6-5dd7-8b03-2d6388de4723" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{12}[\\begin{aligned}1 & 0 & 5 \\\\ 5 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186510973} {:answer/id #uuid "673fceb3-6f45-5623-8b71-9c0dfa70f9da" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{12}[\\begin{aligned}0 & 0 \\\\ 5 & 1 \\\\ 1 & 5\\end{aligned}]" :db/id #edb/ref 17592186510999} {:answer/id #uuid "682473a8-ddf4-51d7-92e8-835c0c7d6bf1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{12}[\\begin{aligned}1 & 5 & 0 \\\\ 5 & 1 & 0\\end{aligned}]" :db/id #edb/ref 17592186511003} {:answer/id #uuid "97c1d397-ce2a-566d-87b1-9841a83b5ce6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{12}[\\begin{aligned}0 & 5 & 1 \\\\ 0 & 1 & 5\\end{aligned}]" :db/id #edb/ref 17592186511097} {:answer/id #uuid "e27eae27-fef7-5f3f-9694-1cc984a96420" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{12}[\\begin{aligned}1 & 5 \\\\ 0 & 0 \\\\ 5 & 1\\end{aligned}]" :db/id #edb/ref 17592186511252}] :answer-field/correct {:db/id #edb/ref 17592186510973} :answer-field/id #uuid "06233fbd-739a-5715-82d1-f750ac787a62" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186511311}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e15227a9-4593-50e7-a6e9-0ebad0f88648" :question/math-academy-id "q-138617" :question/problem "$$\n{U}_{r}=[\\begin{aligned}-\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ 0 & 0 \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{aligned}],\\,{Σ}_{r}=[\\begin{aligned}3 & 0 \\\\ 0 & 2\\end{aligned}],\\,{V}_{r}=[\\begin{aligned}\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{aligned}]\n$$\n\nConsider the matrices shown above. Given that $A={U}_{r}{Σ}_{r}{V}_{r}^{T}$ is a reduced singular value decomposition of $A,$ find the pseudoinverse ${A}^{+}.$" :question/worked-solution "If $A={U}_{r}{Σ}_{r}{V}_{r}^{T}$ is a reduced singular value decomposition of $A,$ then the pseudoinverse of $A$ is given by\n\n$$\n{V}_{r}\\,{Σ}_{r}^{+}\\,{U}_{r}^{T},\n$$\n\nwhere ${Σ}_{r}^{+}$ is the pseudoinverse of ${Σ}_{r}.$\n\nFirst, notice that\n\n$$\n{V}_{r}=\\frac{1}{\\sqrt{2}}[\\begin{aligned}1 & 1 \\\\ -1 & 1\\end{aligned}],\\,{Σ}_{r}^{+}=\\frac{1}{6}[\\begin{aligned}2 & 0 \\\\ 0 & 3\\end{aligned}],\\,{U}_{r}^{T}=\\frac{1}{\\sqrt{2}}[\\begin{aligned}-1 & 0 & 1 \\\\ 1 & 0 & 1\\end{aligned}].\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{A}^{+} & ={V}_{r}\\,{Σ}_{r}^{+}\\,{U}_{r}^{T} \\\\  & =\\frac{1}{\\sqrt{2}}[\\begin{aligned}1 & 1 \\\\ -1 & 1\\end{aligned}]\\cdot \\frac{1}{6}[\\begin{aligned}2 & 0 \\\\ 0 & 3\\end{aligned}]\\cdot \\frac{1}{\\sqrt{2}}[\\begin{aligned}-1 & 0 & 1 \\\\ 1 & 0 & 1\\end{aligned}] \\\\  & =\\frac{1}{12}[\\begin{aligned}1 & 1 \\\\ -1 & 1\\end{aligned}]\\cdot [\\begin{aligned}2 & 0 \\\\ 0 & 3\\end{aligned}]\\cdot [\\begin{aligned}-1 & 0 & 1 \\\\ 1 & 0 & 1\\end{aligned}] \\\\  & =\\frac{1}{12}[\\begin{aligned}2 & 3 \\\\ -2 & 3\\end{aligned}]\\cdot [\\begin{aligned}-1 & 0 & 1 \\\\ 1 & 0 & 1\\end{aligned}] \\\\  & =\\frac{1}{12}[\\begin{aligned}1 & 0 & 5 \\\\ 5 & 0 & 1\\end{aligned}].\\end{aligned}\n$$"} :step/id #uuid "d166b145-57b4-5cbe-9caf-70939c1de8e3" :step/next {:db/id #edb/ref 17592186511594}}] :activity/title "Singular Value Decomposition and the Pseudoinverse Matrix" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186510765}]}
