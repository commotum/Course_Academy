#{[{:db/id #edb/ref 17592186162345 :knowledge-point/_questions [{:db/id #edb/ref 17592186162089 :knowledge-point/id #uuid "e82e8b16-51a8-59c8-9ed1-51619335de97" :knowledge-point/title "Finding the Pseudoinverse of a Matrix Given Its Singular Value Decomposition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b31a3213-6d62-5519-ac95-346c2bef5b5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{50}\\begin{bmatrix}-3 & 4 \\\\ 4 & -3\\end{bmatrix}" :db/id #edb/ref 17592186388494} {:answer/id #uuid "f79a1708-92c0-594d-97af-70797d07c647" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{50}\\begin{bmatrix}-4 & 4 \\\\ 3 & -3\\end{bmatrix}" :db/id #edb/ref 17592186388495} {:answer/id #uuid "22e67faa-26c8-5a3f-8ac2-2e70e7163f7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{50}\\begin{bmatrix}3 & -3 \\\\ -4 & 4\\end{bmatrix}" :db/id #edb/ref 17592186388496} {:answer/id #uuid "e40c9722-c036-5e6f-b81f-4c1388f000ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{25}\\begin{bmatrix}-3 & 4 \\\\ 4 & -3\\end{bmatrix}" :db/id #edb/ref 17592186388497} {:answer/id #uuid "0f190784-d3ea-5b28-a3a5-404a8ae0d16b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{25}\\begin{bmatrix}3 & -3 \\\\ -4 & 4\\end{bmatrix}" :db/id #edb/ref 17592186388498}] :answer-field/correct {:answer/id #uuid "22e67faa-26c8-5a3f-8ac2-2e70e7163f7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{50}\\begin{bmatrix}3 & -3 \\\\ -4 & 4\\end{bmatrix}" :db/id #edb/ref 17592186388496} :answer-field/id #uuid "053ac9c2-65bd-5970-b100-18b05cb5c7be" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388493}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "44a4660e-d3b5-5880-9cf8-ce9a4c5ec070" :question/math-academy-id "q-136973" :question/problem "$$\nU=\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix},\\,Σ=\\begin{bmatrix}5\\sqrt{2} & 0 \\\\ 0 & 0\\end{bmatrix},\\,V=\\begin{bmatrix}-\\frac{3}{5} & \\frac{4}{5} \\\\ \\frac{4}{5} & \\frac{3}{5}\\end{bmatrix}\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ find the pseudoinverse ${A}^{+}.$" :question/worked-solution "If $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ then the pseudoinverse of $A$ is given by\n\n$$\nV\\,{Σ}^{+}\\,{U}^{T},\n$$\n\nwhere ${Σ}^{+}$ is the pseudoinverse of $Σ.$\n\nFirst, notice that\n\n$$\nV=\\frac{1}{5}\\begin{bmatrix}-3 & 4 \\\\ 4 & 3\\end{bmatrix},\\,{Σ}^{+}=\\frac{1}{5\\sqrt{2}}\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix},\\,{U}^{T}=\\frac{1}{\\sqrt{2}}\\begin{bmatrix}-1 & 1 \\\\ 1 & 1\\end{bmatrix}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{A}^{+} & =V\\,{Σ}^{+}\\,{U}^{T} \\\\  & =\\frac{1}{5}\\begin{bmatrix}-3 & 4 \\\\ 4 & 3\\end{bmatrix}\\cdot \\frac{1}{5\\sqrt{2}}\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix}\\cdot \\frac{1}{\\sqrt{2}}\\begin{bmatrix}-1 & 1 \\\\ 1 & 1\\end{bmatrix} \\\\  & =\\frac{1}{50}\\begin{bmatrix}-3 & 4 \\\\ 4 & 3\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}-1 & 1 \\\\ 1 & 1\\end{bmatrix} \\\\  & =\\frac{1}{50}\\begin{bmatrix}-3 & 0 \\\\ 4 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}-1 & 1 \\\\ 1 & 1\\end{bmatrix} \\\\  & =\\frac{1}{50}\\begin{bmatrix}3 & -3 \\\\ -4 & 4\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186162348 :knowledge-point/_questions [{:db/id #edb/ref 17592186162091 :knowledge-point/id #uuid "ff858037-da99-53e9-acdc-e4963e7d765e" :knowledge-point/title "Finding the Pseudoinverse of a Matrix Given Its Reduced Singular Value Decomposition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e62f475-a411-5471-9109-4f0776a4b27e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{144}\\begin{bmatrix}5 & 6 & -13 \\\\ -13 & 6 & 5\\end{bmatrix}" :db/id #edb/ref 17592186371757} {:answer/id #uuid "574d747d-2aa6-5905-8aa7-23b220e6387d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{72}\\begin{bmatrix}-11 & 8 & 7 \\\\ 7 & 8 & -11\\end{bmatrix}" :db/id #edb/ref 17592186371758} {:answer/id #uuid "03f17a11-c9e6-5b87-859e-5ff94559f3f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{72}\\begin{bmatrix}-11 & 7 \\\\ 8 & 8 \\\\ 7 & -11\\end{bmatrix}" :db/id #edb/ref 17592186371759} {:answer/id #uuid "8cffa160-d3a3-5a20-bf3c-7361ce0636c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{72}\\begin{bmatrix}7 & 8 & -11 \\\\ -11 & 8 & 7\\end{bmatrix}" :db/id #edb/ref 17592186371760} {:answer/id #uuid "41bc4d94-8584-56fc-a285-e1f7e9c02900" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{144}\\begin{bmatrix}5 & -13 \\\\ 6 & 6 \\\\ -13 & 5\\end{bmatrix}" :db/id #edb/ref 17592186371761}] :answer-field/correct {:answer/id #uuid "8cffa160-d3a3-5a20-bf3c-7361ce0636c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{72}\\begin{bmatrix}7 & 8 & -11 \\\\ -11 & 8 & 7\\end{bmatrix}" :db/id #edb/ref 17592186371760} :answer-field/id #uuid "ef734dd1-af99-5319-9529-058b09954f82" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186371756}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e9a9aba1-e21b-5ed5-95bf-a323e7389c16" :question/math-academy-id "q-136992" :question/problem "$$\n{U}_{r}=\\begin{bmatrix}-\\frac{1}{3\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ \\frac{4}{3\\sqrt{2}} & 0 \\\\ -\\frac{1}{3\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix},\\,{Σ}_{r}=\\begin{bmatrix}6 & 0 \\\\ 0 & 4\\end{bmatrix},\\,{V}_{r}=\\begin{bmatrix}\\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}\n$$\n\nConsider the matrices shown above. Given that $A={U}_{r}{Σ}_{r}{V}_{r}^{T}$ is a reduced singular value decomposition of $A,$ find the pseudoinverse ${A}^{+}.$" :question/worked-solution "If $A={U}_{r}{Σ}_{r}{V}_{r}^{T}$ is a reduced singular value decomposition of $A,$ then the pseudoinverse of $A$ is given by\n\n$$\n{V}_{r}\\,{Σ}_{r}^{+}\\,{U}_{r}^{T},\n$$\n\nwhere ${Σ}_{r}^{+}$ is the pseudoinverse of ${Σ}_{r}.$\n\nFirst, notice that\n\n$$\n{V}_{r}=\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 & -1 \\\\ 1 & 1\\end{bmatrix},\\,{Σ}_{r}^{+}=\\frac{1}{24}\\begin{bmatrix}4 & 0 \\\\ 0 & 6\\end{bmatrix},\\,{U}_{r}^{T}=\\frac{1}{3\\sqrt{2}}\\begin{bmatrix}-1 & 4 & -1 \\\\ -3 & 0 & 3\\end{bmatrix}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{A}^{+} & ={V}_{r}\\,{Σ}_{r}^{+}\\,{U}_{r}^{T} \\\\  & =\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 & -1 \\\\ 1 & 1\\end{bmatrix}\\cdot \\frac{1}{24}\\begin{bmatrix}4 & 0 \\\\ 0 & 6\\end{bmatrix}\\cdot \\frac{1}{3\\sqrt{2}}\\begin{bmatrix}-1 & 4 & -1 \\\\ -3 & 0 & 3\\end{bmatrix} \\\\  & =\\frac{1}{144}\\begin{bmatrix}1 & -1 \\\\ 1 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}4 & 0 \\\\ 0 & 6\\end{bmatrix}\\cdot \\begin{bmatrix}-1 & 4 & -1 \\\\ -3 & 0 & 3\\end{bmatrix} \\\\  & =\\frac{1}{144}\\begin{bmatrix}4 & -6 \\\\ 4 & 6\\end{bmatrix}\\cdot \\begin{bmatrix}-1 & 4 & -1 \\\\ -3 & 0 & 3\\end{bmatrix} \\\\  & =\\frac{1}{144}\\begin{bmatrix}14 & 16 & -22 \\\\ -22 & 16 & 14\\end{bmatrix} \\\\  & =\\frac{1}{72}\\begin{bmatrix}7 & 8 & -11 \\\\ -11 & 8 & 7\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186371790 :knowledge-point/_questions [{:db/id #edb/ref 17592186162089 :knowledge-point/id #uuid "e82e8b16-51a8-59c8-9ed1-51619335de97" :knowledge-point/title "Finding the Pseudoinverse of a Matrix Given Its Singular Value Decomposition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9b4a3be8-df10-5faf-b317-36ff32669597" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{20}\\begin{bmatrix}-1 & 1 \\\\ -3 & 3\\end{bmatrix}" :db/id #edb/ref 17592186371792} {:answer/id #uuid "d3753217-52ac-503e-a3b9-b9c996fbce84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{20}\\begin{bmatrix}1 & 1 \\\\ 3 & 3\\end{bmatrix}" :db/id #edb/ref 17592186371793} {:answer/id #uuid "57f72ceb-0f4d-5765-9c5f-222b4acb12bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{10}\\begin{bmatrix}1 & -1 \\\\ 3 & -3\\end{bmatrix}" :db/id #edb/ref 17592186371794} {:answer/id #uuid "aa40830a-cf56-5825-8289-12a0609ab711" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\begin{bmatrix}1 & 2 \\\\ 3 & 6\\end{bmatrix}" :db/id #edb/ref 17592186371795} {:answer/id #uuid "1626cc32-b3e1-51e6-9c3b-cf5ddc6a9040" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{10}\\begin{bmatrix}1 & 1 \\\\ 5 & 5\\end{bmatrix}" :db/id #edb/ref 17592186371796}] :answer-field/correct {:answer/id #uuid "d3753217-52ac-503e-a3b9-b9c996fbce84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{20}\\begin{bmatrix}1 & 1 \\\\ 3 & 3\\end{bmatrix}" :db/id #edb/ref 17592186371793} :answer-field/id #uuid "a85e91e9-8965-591e-9ea0-966d0f58979b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186371791}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "acee5e61-29a9-5109-9401-92b3f77d7707" :question/math-academy-id "q-138518" :question/problem "$$\nU=\\begin{bmatrix}\\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix},\\,Σ=\\begin{bmatrix}2\\sqrt{5} & 0 \\\\ 0 & 0\\end{bmatrix},\\,V=\\begin{bmatrix}\\frac{1}{\\sqrt{10}} & -\\frac{3}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}}\\end{bmatrix}\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ find the pseudoinverse ${A}^{+}.$" :question/worked-solution "If $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ then the pseudoinverse of $A$ is given by\n\n$$\nV\\,{Σ}^{+}\\,{U}^{T},\n$$\n\nwhere ${Σ}^{+}$ is the pseudoinverse of $Σ.$\n\nFirst, notice that\n\n$$\nV=\\frac{1}{\\sqrt{10}}\\begin{bmatrix}1 & -3 \\\\ 3 & 1\\end{bmatrix},\\,{Σ}^{+}=\\frac{1}{2\\sqrt{5}}\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix},\\,{U}^{T}=\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 & 1 \\\\ -1 & 1\\end{bmatrix}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{A}^{+} & =V\\,{Σ}^{+}\\,{U}^{T} \\\\  & =\\frac{1}{\\sqrt{10}}\\begin{bmatrix}1 & -3 \\\\ 3 & 1\\end{bmatrix}\\cdot \\frac{1}{2\\sqrt{5}}\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix}\\cdot \\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 & 1 \\\\ -1 & 1\\end{bmatrix} \\\\  & =\\frac{1}{20}\\begin{bmatrix}1 & -3 \\\\ 3 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 1 \\\\ -1 & 1\\end{bmatrix} \\\\  & =\\frac{1}{20}\\begin{bmatrix}1 & 0 \\\\ 3 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 1 \\\\ -1 & 1\\end{bmatrix} \\\\  & =\\frac{1}{20}\\begin{bmatrix}1 & 1 \\\\ 3 & 3\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186420791 :knowledge-point/_questions [{:db/id #edb/ref 17592186162091 :knowledge-point/id #uuid "ff858037-da99-53e9-acdc-e4963e7d765e" :knowledge-point/title "Finding the Pseudoinverse of a Matrix Given Its Reduced Singular Value Decomposition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32c5eab7-61e5-58ba-983c-a7f55e21301d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{20}\\begin{bmatrix}0 & 3 & 1 \\\\ 0 & 2 & -6\\end{bmatrix}" :db/id #edb/ref 17592186420765} {:answer/id #uuid "3c1203aa-43a1-5ff4-889a-1439cc8945c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{20}\\begin{bmatrix}0 & 1 & 3 \\\\ 0 & -6 & 2\\end{bmatrix}" :db/id #edb/ref 17592186420767} {:answer/id #uuid "73f62c7b-39b6-567c-8e60-5bf5c983d0c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{20}\\begin{bmatrix}3 & 1 & 0 \\\\ 2 & -6 & 0\\end{bmatrix}" :db/id #edb/ref 17592186420772} {:answer/id #uuid "7e01a274-8738-5cf2-a673-1055c4c67b97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{20}\\begin{bmatrix}0 & 1 \\\\ 3 & 0 \\\\ -6 & 2\\end{bmatrix}" :db/id #edb/ref 17592186420775} {:answer/id #uuid "fb51fb6a-1738-5259-951f-347a4793bbda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{20}\\begin{bmatrix}1 & 0 \\\\ 3 & 0 \\\\ -2 & 6\\end{bmatrix}" :db/id #edb/ref 17592186420783}] :answer-field/correct {:answer/id #uuid "3c1203aa-43a1-5ff4-889a-1439cc8945c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{20}\\begin{bmatrix}0 & 1 & 3 \\\\ 0 & -6 & 2\\end{bmatrix}" :db/id #edb/ref 17592186420767} :answer-field/id #uuid "a01449e0-fee7-54b8-bc93-a094ffce75c1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186420786}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a18b0561-3c55-5481-a95c-144e99d62fb8" :question/math-academy-id "q-138620" :question/problem "$$\n{U}_{r}=\\begin{bmatrix}0 & 0 \\\\ \\frac{1}{\\sqrt{10}} & -\\frac{3}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}}\\end{bmatrix},\\,{Σ}_{r}=\\begin{bmatrix}2\\sqrt{10} & 0 \\\\ 0 & \\sqrt{10}\\end{bmatrix},\\,{V}_{r}=\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}\n$$\n\nConsider the matrices shown above. Given that $A={U}_{r}{Σ}_{r}{V}_{r}^{T}$ is a reduced singular value decomposition of $A,$ find the pseudoinverse ${A}^{+}.$" :question/worked-solution "If $A={U}_{r}{Σ}_{r}{V}_{r}^{T}$ is a reduced singular value decomposition of $A,$ then the pseudoinverse of $A$ is given by\n\n$$\n{V}_{r}\\,{Σ}_{r}^{+}\\,{U}_{r}^{T},\n$$\n\nwhere ${Σ}_{r}^{+}$ is the pseudoinverse of ${Σ}_{r}.$\n\nFirst, notice that\n\n$$\n{Σ}_{r}^{+}=\\frac{1}{2\\sqrt{10}}\\begin{bmatrix}1 & 0 \\\\ 0 & 2\\end{bmatrix},\\,{U}_{r}^{T}=\\frac{1}{\\sqrt{10}}\\begin{bmatrix}0 & 1 & 3 \\\\ 0 & -3 & 1\\end{bmatrix}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{A}^{+} & ={V}_{r}\\,{Σ}_{r}^{+}\\,{U}_{r}^{T} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot \\frac{1}{2\\sqrt{10}}\\begin{bmatrix}1 & 0 \\\\ 0 & 2\\end{bmatrix}\\cdot \\frac{1}{\\sqrt{10}}\\begin{bmatrix}0 & 1 & 3 \\\\ 0 & -3 & 1\\end{bmatrix} \\\\  & =\\frac{1}{20}\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 \\\\ 0 & 2\\end{bmatrix}\\cdot \\begin{bmatrix}0 & 1 & 3 \\\\ 0 & -3 & 1\\end{bmatrix} \\\\  & =\\frac{1}{20}\\begin{bmatrix}1 & 0 \\\\ 0 & 2\\end{bmatrix}\\cdot \\begin{bmatrix}0 & 1 & 3 \\\\ 0 & -3 & 1\\end{bmatrix} \\\\  & =\\frac{1}{20}\\begin{bmatrix}0 & 1 & 3 \\\\ 0 & -6 & 2\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186420792 :knowledge-point/_questions [{:db/id #edb/ref 17592186162091 :knowledge-point/id #uuid "ff858037-da99-53e9-acdc-e4963e7d765e" :knowledge-point/title "Finding the Pseudoinverse of a Matrix Given Its Reduced Singular Value Decomposition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e553566-a4fb-554e-8652-c4ff524a08ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{20}\\begin{bmatrix}1 & -1 \\\\ 3 & -3\\end{bmatrix}" :db/id #edb/ref 17592186420763} {:answer/id #uuid "4fcafdf4-daf9-5fb3-9853-a3d9f99769a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{20}\\begin{bmatrix}3 & 3 \\\\ 2 & 2\\end{bmatrix}" :db/id #edb/ref 17592186420769} {:answer/id #uuid "7ba8d035-4562-532b-b4de-8633397e74bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{30}\\begin{bmatrix}2 & 3 \\\\ 2 & 3\\end{bmatrix}" :db/id #edb/ref 17592186420774} {:answer/id #uuid "ac6598fd-20cd-597a-8708-3c1fffbbe65f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{10}\\begin{bmatrix}1 & 1 \\\\ 2 & 2\\end{bmatrix}" :db/id #edb/ref 17592186420778} {:answer/id #uuid "efe97a60-f805-5797-98cb-412041423fd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{10}\\begin{bmatrix}1 & -1 \\\\ 3 & -3\\end{bmatrix}" :db/id #edb/ref 17592186420781}] :answer-field/correct {:answer/id #uuid "2e553566-a4fb-554e-8652-c4ff524a08ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{20}\\begin{bmatrix}1 & -1 \\\\ 3 & -3\\end{bmatrix}" :db/id #edb/ref 17592186420763} :answer-field/id #uuid "3d63e1b9-0a9f-5b44-a041-bc2d944d4dee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186420785}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f2315875-6b0f-5492-8e9e-75741c68b770" :question/math-academy-id "q-138658" :question/problem "$$\n{U}_{r}=\\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{2}}\\end{bmatrix},\\,{Σ}_{r}=\\begin{bmatrix}2\\sqrt{5}\\end{bmatrix},\\,{V}_{r}=\\begin{bmatrix}\\frac{1}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}}\\end{bmatrix}\n$$\n\nConsider the matrices shown above. Given that $A={U}_{r}{Σ}_{r}{V}_{r}^{T}$ is a reduced singular value decomposition of $A,$ find the pseudoinverse ${A}^{+}.$" :question/worked-solution "If $A={U}_{r}{Σ}_{r}{V}_{r}^{T}$ is a reduced singular value decomposition of $A,$ then the pseudoinverse of $A$ is given by\n\n$$\n{V}_{r}\\,{Σ}_{r}^{+}\\,{U}_{r}^{T},\n$$\n\nwhere ${Σ}_{r}^{+}$ is the pseudoinverse of ${Σ}_{r}.$\n\nFirst, notice that\n\n$$\n{V}_{r}=\\frac{1}{\\sqrt{10}}\\begin{bmatrix}1 \\\\ 3\\end{bmatrix},\\,{Σ}_{r}^{+}=\\frac{1}{2\\sqrt{5}}\\begin{bmatrix}1\\end{bmatrix},\\,{U}_{r}^{T}=\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 & -1\\end{bmatrix}.\n$$\n\n \n\nTherefore, we have\n\n$$\n\\begin{aligned}{A}^{+} & ={V}_{r}\\,{Σ}_{r}^{+}\\,{U}_{r}^{T} \\\\  & =\\frac{1}{\\sqrt{10}}\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}\\cdot \\frac{1}{2\\sqrt{5}}\\begin{bmatrix}1\\end{bmatrix}\\cdot \\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 & -1\\end{bmatrix} \\\\  & =\\frac{1}{20}\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}\\cdot \\begin{bmatrix}1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & -1\\end{bmatrix} \\\\  & =\\frac{1}{20}\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}\\cdot \\begin{bmatrix}1 & -1\\end{bmatrix} \\\\  & =\\frac{1}{20}\\begin{bmatrix}1 & -1 \\\\ 3 & -3\\end{bmatrix}.\\end{aligned}\n$$"}]}
