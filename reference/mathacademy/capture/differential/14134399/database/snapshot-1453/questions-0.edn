 length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the ellipse is centered at $(-2,-2),$ the horizontal radius has length $a=4,$ and the vertical radius has length $b=2.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}} & =1 \\\\ \\frac{(x-(-2))^{2}}{{4}^{2}}+\\frac{(y-(-2))^{2}}{{2}^{2}} & =1 \\\\ \\frac{(x+2)^{2}}{16}+\\frac{(y+2)^{2}}{4} & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186373181 :knowledge-point/_questions [{:db/id #edb/ref 17592186087833 :knowledge-point/id #uuid "57e19ee3-db9a-58d7-8ca3-4e8801aee656" :knowledge-point/title "Determining the Equation of a Tall Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6805f839-3bcd-57e0-afc7-fccf7bbdeae6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-3)^{2}}{4}+\\frac{(y+2)^{2}}{25}=1" :db/id #edb/ref 17592186373183} {:answer/id #uuid "2365b4a0-4a4e-5c09-8c6f-06c3940e1f92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x+3)^{2}}{4}+\\frac{(y-2)^{2}}{25}=1" :db/id #edb/ref 17592186373184} {:answer/id #uuid "1389bd33-3c64-5352-8c10-4e2a1ccf402e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-2)^{2}}{4}+\\frac{(y+3)^{2}}{10}=1" :db/id #edb/ref 17592186373185} {:answer/id #uuid "50ed5beb-40df-5cbb-b518-b7088703743f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-2)^{2}}{10}+\\frac{(y+3)^{2}}{4}=1" :db/id #edb/ref 17592186373186} {:answer/id #uuid "a7318fc4-07ec-5dda-9f48-5c543101ca23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x+3)^{2}}{25}+\\frac{(y-2)^{2}}{4}=1" :db/id #edb/ref 17592186373187}] :answer-field/correct {:answer/id #uuid "2365b4a0-4a4e-5c09-8c6f-06c3940e1f92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x+3)^{2}}{4}+\\frac{(y-2)^{2}}{25}=1" :db/id #edb/ref 17592186373184} :answer-field/id #uuid "630a029c-6e06-5fd5-84a7-4a8213f014cb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373182}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f15691a7-e2ba-5a41-93ce-4813f75267cf" :question/math-academy-id "q-72251" :question/problem "![](images/82/8289d16711c1ce0a97e056b44acd949908ed97ce6ae2e4c68d1e5b9022846d01.png)\n\nWhat is the equation of the ellipse given above?" :question/worked-solution "Remember that the general equation of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the ellipse is centered at $(-3,2),$ the horizontal radius has length $a=2,$ and the vertical radius has length $b=5.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}} & =1 \\\\ \\frac{(x-(-3))^{2}}{{2}^{2}}+\\frac{(y-2)^{2}}{{5}^{2}} & =1 \\\\ \\frac{(x+3)^{2}}{4}+\\frac{(y-2)^{2}}{25} & =1.\\end{aligned}\n$$"}]}
