a-f41c27f35abf" #edb/ref 17592186045417] [17592186105809 #edb/ref 1038 #edb/ref 17592186106026 #edb/ref 17592186045417] [17592186105809 #edb/ref 1038 #edb/ref 17592186106027 #edb/ref 17592186045417] [17592186105809 #edb/ref 1038 #edb/ref 17592186266096 #edb/ref 17592186045417] [17592186105809 #edb/ref 1038 #edb/ref 17592186266098 #edb/ref 17592186045417] [17592186105809 #edb/ref 1038 #edb/ref 17592186323937 #edb/ref 17592186045417] [17592186105809 #edb/ref 1038 #edb/ref 17592186342119 #edb/ref 17592186045417] [17592186105809 #edb/ref 1038 #edb/ref 17592186342120 #edb/ref 17592186045417] [17592186105809 #edb/ref 1038 #edb/ref 17592186342121 #edb/ref 17592186045417] [17592186105809 #edb/ref 1038 #edb/ref 17592186342122 #edb/ref 17592186045417] [17592186105809 #edb/ref 1038 #edb/ref 17592186395978 #edb/ref 17592186045417] [17592186105809 #edb/ref 1038 #edb/ref 17592186403731 #edb/ref 17592186045417] [17592186105809 #edb/ref 1039 "Identifying a Singular 3x3 System of Equations That Has No Solution" #edb/ref 17592186045417] [17592186105809 #edb/ref 1041 #edb/ref 17592186105645 #edb/ref 17592186045417] [17592186105809 #edb/ref 1042 #uuid "f2f6a868-46fe-5529-a464-b6f3e0243d30" #edb/ref 17592186045417] [17592186106001 #edb/ref 1043 #edb/ref 17592186106639 #edb/ref 17592186045417] [17592186106001 #edb/ref 1043 #edb/ref 17592186106640 #edb/ref 17592186045417] [17592186106001 #edb/ref 1043 #edb/ref 17592186106641 #edb/ref 17592186045417] [17592186106001 #edb/ref 1043 #edb/ref 17592186106745 #edb/ref 17592186045417] [17592186106001 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186106001 #edb/ref 1045 "Solving 3x3 Singular Systems of Equations Using Gaussian Elimination" #edb/ref 17592186045417] [17592186106001 #edb/ref 1046 #edb/ref 17592186106639 #edb/ref 17592186045417] [17592186106001 #edb/ref 1049 #edb/ref 17592186050178 #edb/ref 17592186045417] [17592186106001 #edb/ref 1050 840.0 #edb/ref 17592186045417] [17592186106001 #edb/ref 1053 #uuid "4aeb9a17-64c0-5bc4-aa52-e694d7a3e9f1" #edb/ref 17592186045417] [17592186106027 #edb/ref 1068 #edb/ref 17592186386223 #edb/ref 17592186045417] [17592186106027 #edb/ref 1069 "q-10680" #edb/ref 17592186045417] [17592186106027 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186106027 #edb/ref 1071 "Consider the system\n\n$$\n{\\begin{aligned}2x+6y+8z=12 \\\\ y-z=-1 \\\\ 4x+4y+24z=7.\\end{aligned}\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form." #edb/ref 17592186045417] [17592186106027 #edb/ref 1072 #uuid "112f0f25-38f3-5ec1-a0f6-3a87947c53d9" #edb/ref 17592186045417] [17592186106027 #edb/ref 1074 "The augmented matrix for the system is\n\n$$\nM=[\\begin{aligned}2 & 6 & 8 & 12 \\\\ 0 & 1 & -1 & -1 \\\\ 4 & 4 & 24 & 7\\end{aligned}].\n$$\n\nReducing $M$ to echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}2 & 6 & 8 & 12 \\\\ 0 & 1 & -1 & -1 \\\\ 4 & 4 & 24 & 7\\end{aligned}] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 3 & 4 & 6 \\\\ 0 & 1 & -1 & -1 \\\\ 4 & 4 & 24 & 7\\end{aligned}] & {R}_{3} & :={R}_{3}-4{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 3 & 4 & 6 \\\\ 0 & 1 & -1 & -1 \\\\ 0 & -8 & 8 & -17\\end{aligned}] & {R}_{3} & :={R}_{3}+8{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 3 & 4 & 6 \\\\ 0 & 1 & -1 & -1 \\\\ 0 & 0 & 0 & -25\\end{aligned}].\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186106484 #edb/ref 1068 #edb/ref 17592186414555 #edb/ref 17592186045417] [17592186106484 #edb/ref 1069 "q-73398" #edb/ref 17592186045417] [17592186106484 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186106484 #edb/ref 1071 "Consider the augmented matrix $M$ given by \n\n$$\nM=[\\begin{aligned}1 & 3 & -2 & 4 \\\\ 4 & 12 & -8 & 16 \\\\ -2 & -6 & 4 & -8\\end{aligned}].\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form, and then find the general solution of the linear system represented by the matrix." #edb/ref 17592186045417] [17592186106484 #edb/ref 1072 #uuid "b781b123-fbe5-5448-9abb-e1e37d5856e0" #edb/ref 17592186045417] [17592186106484 #edb/ref 1074 "Reducing $M$ to echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}1 & 3 & -2 & 4 \\\\ 4 & 12 & -8 & 16 \\\\ -2 & -6 & 4 & -8\\end{aligned}] & {R}_{2} & :={R}_{2}+(-4){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 3 & -2 & 4 \\\\ 0 & 0 & 0 & 0 \\\\ -2 & -6 & 4 & -8\\end{aligned}] & {R}_{3} & :={R}_{3}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 3 & -2 & 4 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}].\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n{\\begin{aligned}x+3y-2z=4 \\\\ 0x+0y+0z=0 \\\\ 0x+0y+0z=0.\\end{aligned}\n$$\n\nSince any numbers $x,y,z$ form a solution of the final two equations $0x+0y+0z=0,$ we can remove these equations from the system. So, our system now consists of just a single equation:\n\n$$\nx+3y-2z=4\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x$, and we have two free variables $y$ and $z.$ That means we need to find $x$ in terms of $y,z.$ Doing this, we get\n\n$$\nx=4-3y+2z.\n$$\n\nTherefore, the general solution is\n\n$$\n{\\begin{aligned}x=4-3y+2z \\\\ y=y \\\\ z=z\\end{aligned}\n$$\n\nwhere $y,z$ (the free variables) are arbitrary numbers.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}4-3y+2z \\\\ y \\\\ z\\end{aligned}],\\,y,z\\in (-\\infty ,\\infty ).\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186106639 #edb/ref 1058 #edb/ref 17592186106640 #edb/ref 17592186045417] [17592186106639 #edb/ref 1061 17206 #edb/ref 17592186045417] [17592186106639 #edb/ref 1062 #uuid "1f1588ba-e038-5ac2-b2f0-cd6b05552c88" #edb/ref 17592186045417] [17592186106639 #edb/ref 1063 #edb/ref 17592186107082 #edb/ref 17592186045417] [17592186106640 #edb/ref 1058 #edb/ref 17592186106641 #edb/ref 17592186045417] [17592186106640 #edb/ref 1061 17207 #edb/ref 17592186045417] [17592186106640 #edb/ref 1062 #uuid "a034e288-f201-529a-8654-d39e76a6c29d" #edb/ref 17592186045417] [17592186106640 #edb/ref 1063 #edb/ref 17592186105747 #edb/ref 17592186045417] [17592186106641 #edb/ref 1058 #edb/ref 17592186106745 #edb/ref 17592186045417] [17592186106641 #edb/ref 1061 17208 #edb/ref 17592186045417] [17592186106641 #edb/ref 1062 #uuid "f7ed1c9e-e1c6-5316-a15f-2af80c8133da" #edb/ref 17592186045417] [17592186106641 #edb/ref 1063 #edb/ref 17592186105748 #edb/ref 17592186045417] [17592186106745 #edb/ref 1061 23204 #edb/ref 17592186045417] [17592186106745 #edb/ref 1062 #uuid "d9f860aa-5447-57ca-9c2e-9e25b9afa207" #edb/ref 17592186045417] [17592186106745 #edb/ref 1063 #edb/ref 17592186105809 #edb/ref 17592186045417] [17592186107082 #edb/ref 1064 "Let's consider a system of linear equations where the corresponding coefficient matrix is singular. For example, consider the following system and its associated augmented matrix:\n![](images/1a/1ac826685473beeb7a7c0ee90465db019d0d5b70b1af562aa3469ae4f0a54007.svg)\n\nTo solve the system, we can reduce $M$ to row echelon form using Gaussian elimination, as usual. We have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}1 & -1 & 1 & 2 \\\\ 2 & -1 & -1 & -1 \\\\ 0 & 2 & -6 & -10\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & 1 & 2 \\\\ 0 & 1 & -3 & -5 \\\\ 0 & 2 & -6 & -10\\end{aligned}] & {R}_{3} & :={R}_{3}+(-2){R}_{2} \\\\  & ∼[\\begin{aligned}1 & -1 & 1 & 2 \\\\ 0 & 1 & -3 & -5 \\\\ 0 & 0 & 0 & 0\\end{aligned}].\\end{aligned}\n$$\n\nThe corresponding system is now\n![](images/17/176e4c49ef19bb92d63190dc6674b66ee55b2fdb306293bae65b7f2b2935701d.svg)\n\nSince any numbers $x,y,z$ form a solution of the final equation $0x+0y+0z = 0,$ we can remove this equation from the system. So, our system now consists of just two equations:\n\n![](images/a9/a9dd77f0f2ac0f7bd04b5e70fdca3b126d4eb34b0c929caca48c60f138bc644d.svg)\n\nThe **basic variables** are the variables of our system whose coefficients are the pivots of the row echelon form matrix. Let's illustrate the pivots of $M\\mathbin{:}$\n\n![](images/1b/1b776faa6c69553ce04fbddc4e1aa45e18d7390a32ce34d9e0317b2fa83b8752.svg)\n\nThe pivots are\n\n- $m_{11}=1,$ which is the coefficient of $x,$ and\n\n- $m_{22}=1,$ which is the coefficient of $y.$\n\nTherefore, the basic variables are $x$ and $y.$\n\nThe remaining variables are called the **free variables**. We have only one free variable in our system, which is $z$.\n\nFinally, we can describe the **general solution** by finding equations for the basic variables in terms of the free variables. In our case, this means we need to find $x$ and $y$ in terms of $z$.\n\nTo do this, we apply the back substitution. From the second equation, we obtain\n\n$$\ny - 3z = -5\n\t\\qquad\\Longrightarrow\\qquad\n\ty = -5+3z.\n$$\n\nSubstituting this into the first equation, we get\n\n$$\n\\begin{aligned}x-(-5+3z)+z=2\\,⟹\\, & x=-3+2z.\\end{aligned}\n$$\n\nTherefore, the general solution is\n![](images/e2/e21bb2b83534152d6bf3d1c43efbd301b42717b975f1f9ebaa28ee4bc3ef31bd.svg)\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n![](images/de/de7a613bbbde25e555608ebc419106701d47875e238832eab7533bf87b0f1ce8.svg)\n\nGeometrically, this is the vector equation of a line, and any point on the line is a solution to our original system.\n\nIf we want to find some **particular solution** of the system, we simply choose some particular value of $z$ and find the corresponding values of $x$ and $y$ on the line. For example, if we choose $z=0,$ then the corresponding values are $x=-3$ and $y=-5$ and the particular solution is $x=-3,$ $y=-5,$ $z=0.$" #edb/ref 17592186045417] [17592186107082 #edb/ref 1065 3159 #edb/ref 17592186045417] [17592186107082 #edb/ref 1066 #uuid "3f5fe61d-1298-5fad-8678-6cd961832dde" #edb/ref 17592186045417] [17592186107082 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186340025 #edb/ref 1080 "[\\begin{aligned}16+12y-6z \\\\ 1-2z \\\\ z\\end{aligned}],\\,z\\in (-\\infty ,\\infty )" #edb/ref 17592186045417] [17592186340025 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186340025 #edb/ref 1083 #uuid "654f4e4b-68e6-5e19-a8a6-7b5f7780eaac" #edb/ref 17592186045417] [17592186340077 #edb/ref 1080 "[\\begin{aligned}12y-6z \\\\ 1-2z \\\\ z\\end{aligned}],\\,z\\in (-\\infty ,\\infty )" #edb/ref 17592186045417] [17592186340077 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186340077 #edb/ref 1083 #uuid "6b34b618-b3bb-583e-b711-31492585e9f9" #edb/ref 17592186045417] [17592186340865 #edb/ref 1080 "[\\begin{aligned}12-2y-6z \\\\ 4-z \\\\ z\\end{aligned}],\\,z\\in (-\\infty ,\\infty )" #edb/ref 17592186045417] [17592186340865 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186340865 #edb/ref 1083 #uuid "c3416e61-0a0a-5f9f-ab68-f08f001a0304" #edb/ref 17592186045417] [17592186341134 #edb/ref 1080 "[\\begin{aligned}16+6z \\\\ 12-2z \\\\ z\\end{aligned}],\\,z\\in (-\\infty ,\\infty )" #edb/ref 17592186045417] [17592186341134 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186341134 #edb/ref 1083 #uuid "e288ca76-fc0b-506e-9fe5-8dad8ba5432c" #edb/ref 17592186045417] [17592186341153 #edb/ref 1080 "No solution" #edb/ref 17592186045417] [17592186341153 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186341153 #edb/ref 1083 #uuid "e512aed6-7ac8-5860-956d-1b0619e54cb8" #edb/ref 17592186045417] [17592186341662 #edb/ref 1075 #edb/ref 17592186340025 #edb/ref 17592186045417] [17592186341662 #edb/ref 1075 #edb/ref 17592186340077 #edb/ref 17592186045417] [17592186341662 #edb/ref 1075 #edb/ref 17592186340865 #edb/ref 17592186045417] [17592186341662 #edb/ref 1075 #edb/ref 17592186341134 #edb/ref 17592186045417] [17592186341662 #edb/ref 1075 #edb/ref 17592186341153 #edb/ref 17592186045417] [17592186341662 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186341662 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186341662 #edb/ref 1078 #edb/ref 17592186341153 #edb/ref 17592186045417] [17592186341662 #edb/ref 1079 #uuid "9f2d14f8-14f9-5480-8110-243c4955270e" #edb/ref 17592186045417] [17592186342122 #edb/ref 1068 #edb/ref 17592186341662 #edb/ref 17592186045417] [17592186342122 #edb/ref 1069 "q-73960" #edb/ref 17592186045417] [17592186342122 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186342122 #edb/ref 1071 "Consider the augmented matrix $M$ given by \n\n$$\nM=[\\begin{aligned}1 & -12 & -6 & 16 \\\\ \\frac{1}{2} & -2 & 5 & 12 \\\\ 2 & -20 & -4 & 25\\end{aligned}].\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form, and then find the general solution of the linear system represented by the matrix." #edb/ref 17592186045417] [17592186342122 #edb/ref 1072 #uuid "2553c2bd-9198-50b3-b6db-dc189cb3e196" #edb/ref 17592186045417] [17592186342122 #edb/ref 1074 "Reducing $M$ to echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}1 & -12 & -6 & 16 \\\\ \\frac{1}{2} & -2 & 5 & 12 \\\\ 2 & -20 & -4 & 25\\end{aligned}] & {R}_{2} & :={R}_{2}-\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -12 & -6 & 16 \\\\ 0 & 4 & 8 & 4 \\\\ 2 & -20 & -4 & 25\\end{aligned}] & {R}_{3} & :={R}_{3}-2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -12 & -6 & 16 \\\\ 0 & 4 & 8 & 4 \\\\ 0 & 4 & 8 & -7\\end{aligned}] & {R}_{2} & :=\\frac{1}{4}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -12 & -6 & 16 \\\\ 0 & 1 & 2 & 1 \\\\ 0 & 4 & 8 & -7\\end{aligned}] & {R}_{3} & :={R}_{3}-4{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -12 & -6 & 16 \\\\ 0 & 1 & 2 & 1 \\\\ 0 & 0 & 0 & -11\\end{aligned}].\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n{\\begin{aligned}x-12y-6z=16 \\\\ 0x+y+2z=1 \\\\ 0x+0y+0z=-11\\end{aligned}\n$$\n\nSince there are no such numbers $x,y,z$ that form a solution of the final equation $0x+0y+0z=-11,$ we can conclude that our system has no solution." #edb/ref 17592186045417] [17592186364344 #edb/ref 1068 #edb/ref 17592186364345 #edb/ref 17592186045417] [17592186364344 #edb/ref 1069 "q-73914" #edb/ref 17592186045417] [17592186364344 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186364344 #edb/ref 1071 "Consider the augmented matrix $M$ given by \n\n$$\nM=[\\begin{aligned}1 & 2 & -4 & 3 \\\\ -3 & -6 & 12 & -9 \\\\ 2 & 4 & -8 & 6\\end{aligned}].\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form, and then find the general solution of the linear system represented by the matrix." #edb/ref 17592186045417] [17592186364344 #edb/ref 1072 #uuid "5f569855-d257-5ea3-9d07-8247dc046d5d" #edb/ref 17592186045417] [17592186364344 #edb/ref 1074 "Reducing $M$ to echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}1 & 2 & -4 & 3 \\\\ -3 & -6 & 12 & -9 \\\\ 2 & 4 & -8 & 6\\end{aligned}] & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & -4 & 3 \\\\ 0 & 0 & 0 & 0 \\\\ 2 & 4 & -8 & 6\\end{aligned}] & {R}_{3} & :={R}_{3}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & -4 & 3 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}].\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n{\\begin{aligned}x+2y-4z=3 \\\\ 0x+0y+0z=0 \\\\ 0x+0y+0z=0.\\end{aligned}\n$$\n\nSince any numbers $x,y,z$ form a solution of the final two equations $0x+0y+0z=0,$ we can remove these equations from the system. So, our system now consists of just a single equation:\n\n$$\nx+2y-4z=3\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x$, and we have two free variables $y$ and $z.$ That means we need to find $x$ in terms of $y,z.$ Doing this, we get\n\n$$\nx=3-2y+4z.\n$$\n\nTherefore, the general solution is\n\n$$\n{\\begin{aligned}x=3-2y+4z \\\\ y=y \\\\ z=z\\end{aligned}\n$$\n\nwhere $y,z$ (the free variables) are arbitrary numbers.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}3-2y+4z \\\\ y \\\\ z\\end{aligned}],\\,y,z\\in (-\\infty ,\\infty ).\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186364345 #edb/ref 1075 #edb/ref 17592186364346 #edb/ref 17592186045417] [17592186364345 #edb/ref 1075 #edb/ref 17592186364347 #edb/ref 17592186045417] [17592186364345 #edb/ref 1075 #edb/ref 17592186364348 #edb/ref 17592186045417] [17592186364345 #edb/ref 1075 #edb/ref 17592186364349 #edb/ref 17592186045417] [17592186364345 #edb/ref 1075 #edb/ref 17592186364350 #edb/ref 17592186045417] [17592186364345 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186364345 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186364345 #edb/ref 1078 #edb/ref 17592186364350 #edb/ref 17592186045417] [17592186364345 #edb/ref 1079 #uuid "9615cffd-ab8b-596e-89a9-eab03c7aa9d7" #edb/ref 17592186045417] [17592186364346 #edb/ref 1080 "[\\begin{aligned}3-4y+2z \\\\ y \\\\ z\\end{aligned}],\\,y,z\\in (-\\infty ,\\infty )" #edb/ref 17592186045417] [17592186364346 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186364346 #edb/ref 1083 #uuid "8d434ad9-8516-5f67-a1c8-b8fb37dbe476" #edb/ref 17592186045417] [17592186364347 #edb/ref 1080 "[\\begin{aligned}3+2y-4z \\\\ y \\\\ z\\end{aligned}],\\,y,z\\in (-\\infty ,\\infty )" #edb/ref 17592186045417] [17592186364347 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186364347 #edb/ref 1083 #uuid "e3736c0c-8456-559a-8dcc-35d30f71662a" #edb/ref 17592186045417] [17592186364348 #edb/ref 1080 "[\\begin{aligned}2-3y+4z \\\\ y \\\\ z\\end{aligned}],\\,y,z\\in (-\\infty ,\\infty )" #edb/ref 17592186045417] [17592186364348 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186364348 #edb/ref 1083 #uuid "0ddbfea5-412d-5c3e-9b96-6f20638d2e6c" #edb/ref 17592186045417] [17592186364349 #edb/ref 1080 "No solution" #edb/ref 17592186045417] [17592186364349 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17