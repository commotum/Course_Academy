#{[{:db/id #edb/ref 17592186555810 :knowledge-point/_questions [{:db/id #edb/ref 17592186162139 :knowledge-point/id #uuid "e7e5587a-5a45-59b6-ae59-df68ed33e0fb" :knowledge-point/title "Properties of Sums of Bernoulli Random Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22684d1d-b0b3-54ef-b3ee-48b2d6c88f60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Bernoulli}(0.72)" :db/id #edb/ref 17592186555067} {:answer/id #uuid "9a32f7fa-6742-56e1-bf1a-cf1c58e74768" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B(80,0.72)" :db/id #edb/ref 17592186555373} {:answer/id #uuid "9e5f5792-ce54-5a1b-9b50-cfc7b9f8870e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Bernoulli}(0.28)" :db/id #edb/ref 17592186555382} {:answer/id #uuid "ac7ce6d1-961d-56fe-aded-0106ed9f05c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B(58,0.72)" :db/id #edb/ref 17592186555415} {:answer/id #uuid "d72a2b1b-9ea0-537e-a5f6-1f5385cf75a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B(80,0.28)" :db/id #edb/ref 17592186555517}] :answer-field/correct {:answer/id #uuid "9a32f7fa-6742-56e1-bf1a-cf1c58e74768" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B(80,0.72)" :db/id #edb/ref 17592186555373} :answer-field/id #uuid "282e375f-1850-5399-9599-cb2c5ef898b6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555658}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "59f1c663-db33-5cbd-a122-ef9383054d3e" :question/math-academy-id "q-146398" :question/problem "Suppose we have a random sample of size $n=80$ from a population where $72%$ of the population has a particular characteristic. Let the random variable ${X}_{i}$ be equal to\n\n$$\n{X}_{i}=\\{\\begin{aligned}1,\\,i\\text{th member of the sample has the characteristic} \\\\ 0,\\,\\text{otherwise}\\end{aligned}\n$$\n\nwhere $i=1,…,80.$ Find an approximate sampling distribution of the statistic $X={\\sum }_{i=1}^{80}{X}_{i}.$\n\n*Hint: You may assume that the population size is significantly larger than the sample size.*" :question/worked-solution "Suppose we have a random sample of size $n$ from a population of size $N,$ and we define the sequence of random variables ${X}_{i}$ as follows:\n\n$$\n{X}_{i}=\\{\\begin{aligned}1,\\,i\\text{th member of the sample has the characteristic} \\\\ 0,\\,\\text{otherwise}\\end{aligned}\n$$\n\nNow, provided that $N≫n,$ the random variables ${X}_{i}$ can be considered independent and identically distributed. Under this assumption, we have\n\n$$\n{X}_{i}∼\\text{Bernoulli}(p)\\,1\\le i\\le n\n$$\n\nwhere $p$ is the proportion of the population that has the characteristic.\n\nTherefore, the random variable $X,$ defined as \n\n$$\nX={\\sum }_{i=1}^{n}{X}_{i}\n$$\n\ncan be approximated as a binomial random variable $X≈B(n,p).$ \n\nIn our case, we're told that the population size is significantly larger than the sample size. Moreover, we have \n\n$$\np=72%=0.72,\\,n=80.\n$$\n\nTherefore,\n\n$$\nX≈B(80,0.72).\n$$"}] [{:db/id #edb/ref 17592186555799 :knowledge-point/_questions [{:db/id #edb/ref 17592186162139 :knowledge-point/id #uuid "e7e5587a-5a45-59b6-ae59-df68ed33e0fb" :knowledge-point/title "Properties of Sums of Bernoulli Random Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "760d68c2-bf69-5092-a28f-9f206e7da7bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B(120,0.6)" :db/id #edb/ref 17592186555268} {:answer/id #uuid "7678dea6-b13b-5668-b51b-7fa42acc8ac1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Bernoulli}(0.4)" :db/id #edb/ref 17592186555270} {:answer/id #uuid "8a13d411-f193-59df-a60d-691d14b62d42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B(200,0.6)" :db/id #edb/ref 17592186555324} {:answer/id #uuid "a7ac58e6-6890-59aa-86e5-021020ca205b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B(200,0.4)" :db/id #edb/ref 17592186555402} {:answer/id #uuid "c1b1149b-27d1-5022-b30e-bdf734dc8801" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Bernoulli}(0.6)" :db/id #edb/ref 17592186555468}] :answer-field/correct {:answer/id #uuid "8a13d411-f193-59df-a60d-691d14b62d42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B(200,0.6)" :db/id #edb/ref 17592186555324} :answer-field/id #uuid "9c2d22b3-82ab-571f-9d82-01f972b998da" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555720}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "490b7df2-1c00-5889-8265-81d6b29b18f3" :question/math-academy-id "q-146401" :question/problem "Suppose we have a random sample of size $n=200$ from a population where $60%$ of the population has a particular characteristic. Let the random variable ${X}_{i}$ be equal to\n\n$$\n{X}_{i}=\\{\\begin{aligned}1,\\,i\\text{th member of the sample has the characteristic} \\\\ 0,\\,\\text{otherwise}\\end{aligned}\n$$\n\nwhere $i=1,…,200.$ Find an approximate sampling distribution of the statistic $X={\\sum }_{i=1}^{200}{X}_{i}.$\n\n*Hint: You may assume that the population size is significantly larger than the sample size.*" :question/worked-solution "Suppose we have a random sample of size $n$ from a population of size $N,$ and we define the sequence of random variables ${X}_{i}$ as follows:\n\n$$\n{X}_{i}=\\{\\begin{aligned}1,\\,i\\text{th member of the sample has the characteristic} \\\\ 0,\\,\\text{otherwise}\\end{aligned}\n$$\n\nNow, provided that $N≫n,$ the random variables ${X}_{i}$ can be considered independent and identically distributed. Under this assumption, we have\n\n$$\n{X}_{i}∼\\text{Bernoulli}(p)\\,1\\le i\\le n\n$$\n\nwhere $p$ is the proportion of the population that has the characteristic.\n\nTherefore, the random variable $X,$ defined as \n\n$$\nX={\\sum }_{i=1}^{n}{X}_{i}\n$$\n\ncan be approximated as a binomial random variable $X≈B(n,p).$ \n\nIn our case, we're told that the population size is significantly larger than the sample size. Moreover, we have \n\n$$\np=60%=0.6,\\,n=200.\n$$\n\nTherefore,\n\n$$\nX≈B(200,0.6).\n$$"}] [{:db/id #edb/ref 17592186555835 :knowledge-point/_questions [{:db/id #edb/ref 17592186162139 :knowledge-point/id #uuid "e7e5587a-5a45-59b6-ae59-df68ed33e0fb" :knowledge-point/title "Properties of Sums of Bernoulli Random Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1524fb62-acc2-536e-a99c-e6d653124ea2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{E}[X]=8,\\,\\text{Var}[X]=5.7" :db/id #edb/ref 17592186555041} {:answer/id #uuid "669f46f9-7fe9-57c8-b15c-822e2852fd28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{E}[X]=6,\\,\\text{Var}[X]=5.7" :db/id #edb/ref 17592186555232} {:answer/id #uuid "6986251f-e45f-59ee-9667-7b37f30a8e1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{E}[X]=6,\\,\\text{Var}[X]=6.2" :db/id #edb/ref 17592186555240} {:answer/id #uuid "7f7af2aa-2e28-5c1f-abd9-a7f96818713e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{E}[X]=6,\\,\\text{Var}[X]=5.0" :db/id #edb/ref 17592186555294} {:answer/id #uuid "a0857c8a-f9dd-50e3-a78d-bf44e5e33721" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{E}[X]=8,\\,\\text{Var}[X]=5.0" :db/id #edb/ref 17592186555387}] :answer-field/correct {:answer/id #uuid "669f46f9-7fe9-57c8-b15c-822e2852fd28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{E}[X]=6,\\,\\text{Var}[X]=5.7" :db/id #edb/ref 17592186555232} :answer-field/id #uuid "620b9567-454a-5a74-9979-8ed7be2affd8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555686}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "94f8387a-ce74-5bb3-92d4-c497c3ceea9c" :question/math-academy-id "q-146405" :question/problem "Suppose we have a random sample of size $n=120$ from a population where $5%$ of the population has a particular characteristic. Let the random variable ${X}_{i}$ be equal to\n\n$$\n{X}_{i}=\\{\\begin{aligned}1,\\,i\\text{th member of the sample has the characteristic} \\\\ 0,\\,\\text{otherwise}\\end{aligned}\n$$\n\nwhere $i=1,…,120.$ If the statistic $X$ is defined as\n\n$$\nX={\\sum }_{i=1}^{120}{X}_{i}\n$$\n\nfind approximate values of $\\text{E}[X]$ and $\\text{Var}[X].$\n\n*Hint: You may assume that the population size is significantly larger than the sample size.*" :question/worked-solution "Suppose we have a random sample of size $n$ from a population of size $N,$ and we define the sequence of random variables ${X}_{i}$ as follows:\n\n$$\n{X}_{i}=\\{\\begin{aligned}1,\\,i\\text{th member of the sample has the characteristic} \\\\ 0,\\,\\text{otherwise}\\end{aligned}\n$$\n\nNow, provided that $N≫n,$ the random variables ${X}_{i}$ can be considered independent and identically distributed. Under this assumption, we have\n\n$$\n{X}_{i}∼\\text{Bernoulli}(p)\\,1\\le i\\le n\n$$\n\nwhere $p$ is the proportion of the population that has the characteristic.\n\nTherefore, the random variable $X,$ defined as \n\n$$\nX={\\sum }_{i=1}^{n}{X}_{i}\n$$\n\ncan be approximated as a binomial random variable $X≈B(n,p),$ where\n\n$$\n\\text{E}[X]=np,\\,\\text{Var}[X]=np(1-p).\n$$\n\nIn our case, we're told that the population size is significantly larger than the sample size. Moreover, we have \n\n$$\np=5%=0.05,\\,n=120.\n$$\n\nTherefore,\n\n$$\nX≈B(120,0.05)\n$$\n\nand we have the following results for the mean and variance:\n\n$$\n\\begin{aligned}\\text{E}[X] & =np \\\\  & =120\\cdot 0.05 \\\\  & =6 \\\\ \\text{Var}[X] & =np(1-p) \\\\  & =120\\cdot 0.05\\cdot (1-0.05) \\\\  & =5.7\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186555845 :knowledge-point/_questions [{:db/id #edb/ref 17592186162137 :knowledge-point/id #uuid "1c6e806b-288e-5ff8-b54d-4b19c16cd2f7" :knowledge-point/title "Mean and Variance of Sample Proportions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "164226e5-15d4-5658-89e3-bcd50cd4659c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{E}[\\overset{^}{\\,p}]=0.38,\\,\\text{Var}[\\overset{^}{\\,p}]=0.011" :db/id #edb/ref 17592186555043} {:answer/id #uuid "68be19d6-216b-577d-b2f8-7073e6ae0ba3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{E}[\\overset{^}{\\,p}]=0.38,\\,\\text{Var}[\\overset{^}{\\,p}]=0.006" :db/id #edb/ref 17592186555237} {:answer/id #uuid "7fa95346-6c40-5885-9b17-5047d823cbf8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{E}[\\overset{^}{\\,p}]=0.62,\\,\\text{Var}[\\overset{^}{\\,p}]=0.008" :db/id #edb/ref 17592186555295} {:answer/id #uuid "9b61f479-1547-598f-8162-e8595d51c610" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{E}[\\overset{^}{\\,p}]=0.62,\\,\\text{Var}[\\overset{^}{\\,p}]=0.011" :db/id #edb/ref 17592186555375} {:answer/id #uuid "bfbebd0d-2330-54dc-9da4-4269e0fa7655" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{E}[\\overset{^}{\\,p}]=0.38,\\,\\text{Var}[\\overset{^}{\\,p}]=0.008" :db/id #edb/ref 17592186555460}] :answer-field/correct {:answer/id #uuid "bfbebd0d-2330-54dc-9da4-4269e0fa7655" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{E}[\\overset{^}{\\,p}]=0.38,\\,\\text{Var}[\\overset{^}{\\,p}]=0.008" :db/id #edb/ref 17592186555460} :answer-field/id #uuid "b9340764-7d20-536c-8af6-aa8f9dc6fc8a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555730}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a90f2432-beab-5d93-b930-00f3398843bd" :question/math-academy-id "q-146445" :question/problem "Suppose that $38%$ of a city's adult population like romance movies. A random sample of $n=30$ adults is taken from the population and asked about their favorite movie genre.\n\nWhat is the mean and variance of $\\overset{^}{\\,p},$ the proportion of people in the sample who like romance movies? Round your answers to $3$ decimal places where appropriate.\n\n*Hint: You may assume that the population size is significantly larger than the sample size.*" :question/worked-solution "Suppose we have a random sample of size $n$ from a population of size $N,$ and we define the sequence of random variables ${X}_{i}$ as follows:\n\n$$\n{X}_{i}=\\{\\begin{aligned}1,\\,i\\text{th member of the sample has the characteristic}, \\\\ 0,\\,\\text{otherwise}.\\end{aligned}\n$$\n\nNow, provided that $N≫n,$ we have that\n\n$$\nX={\\sum }_{i=1}^{n}{X}_{i}≈B(n,p)\n$$\n\nwhere $p$ is the proportion of the population that have the characteristic, and \n\n$$\n\\text{E}[X]=np,\\,\\text{Var}[X]=np(1-p).\n$$\n\nThe sample proportion $\\overset{^}{\\,p}$ is given by\n\n$$\n\\overset{^}{\\,p}=\\overset{―}{X}=\\frac{X}{n}.\n$$\n\nUsing the properties of expectation and variance, it is straightforward to show that\n\n$$\n\\text{E}[\\overset{^}{\\,p}]=p,\\,\\text{Var}[\\overset{^}{\\,p}]=\\frac{p(1-p)}{n}.\n$$\n\nIn our case, we have $p=38%=0.38,$ and $n=30.$ Therefore,\n\n$$\n\\begin{aligned}\\text{E}[\\overset{^}{\\,p}] & =38%=0.38, \\\\ \\text{Var}[\\overset{^}{\\,p}] & =\\frac{0.38(1-0.38)}{30} \\\\  & ≈0.008\\end{aligned}\n$$\n\nrounded to $3$ decimal places."}] [{:db/id #edb/ref 17592186162439 :knowledge-point/_questions [{:db/id #edb/ref 17592186162137 :knowledge-point/id #uuid "1c6e806b-288e-5ff8-b54d-4b19c16cd2f7" :knowledge-point/title "Mean and Variance of Sample Proportions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "083a6222-5a52-5710-852c-3e97ebe97c55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{E}[\\overset{^}{\\,p}]=0.15,\\,\\text{Var}[\\overset{^}{\\,p}]=0.0021" :db/id #edb/ref 17592186555015} {:answer/id #uuid "2c027381-40ea-5799-9ee6-5c1914e36adb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{E}[\\overset{^}{\\,p}]=0.15,\\,\\text{Var}[\\overset{^}{\\,p}]=0.0025" :db/id #edb/ref 17592186555098} {:answer/id #uuid "d70aa7b2-f393-5544-ab75-58709dc4953c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{E}[\\overset{^}{\\,p}]=0.85,\\,\\text{Var}[\\overset{^}{\\,p}]=0.0036" :db/id #edb/ref 17592186555513} {:answer/id #uuid "e788456d-4b2f-5a3b-9773-97044c05216e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{E}[\\overset{^}{\\,p}]=0.15,\\,\\text{Var}[\\overset{^}{\\,p}]=0.0036" :db/id #edb/ref 17592186555568} {:answer/id #uuid "fa98449f-940e-591b-be82-68f3da8ba744" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{E}[\\overset{^}{\\,p}]=0.85,\\,\\text{Var}[\\overset{^}{\\,p}]=0.0021" :db/id #edb/ref 17592186555618}] :answer-field/correct {:answer/id #uuid "083a6222-5a52-5710-852c-3e97ebe97c55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{E}[\\overset{^}{\\,p}]=0.15,\\,\\text{Var}[\\overset{^}{\\,p}]=0.0021" :db/id #edb/ref 17592186555015} :answer-field/id #uuid "d4ebb605-8da3-5343-bd47-314118a290ba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186159836}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "010791ef-9757-53ad-8c05-5eece41ad7e4" :question/math-academy-id "q-146454" :question/problem "It is known that $15%$ of a particular teenage population ride bicycles for exercise. A random sample of $n=60$ teenagers is taken from the population and asked whether they ride a bicycle for exercise.\n\nWhat is the mean and variance of $\\overset{^}{\\,p},$ the proportion of teenagers in the sample who ride bicycles? Round your answers to $4$ decimal places where appropriate.\n\n*Hint: You may assume that the population size is significantly larger than the sample size.*" :question/requires-calculator true :question/worked-solution "Suppose we have a random sample of size $n$ from a population of size $N,$ and we define the sequence of random variables ${X}_{i}$ as follows:\n\n$$\n{X}_{i}=\\{\\begin{aligned}1,\\,i\\text{th member of the sample has the characteristic}, \\\\ 0,\\,\\text{otherwise}.\\end{aligned}\n$$\n\nNow, provided that $N≫n,$ we have that\n\n$$\nX={\\sum }_{i=1}^{n}{X}_{i}≈B(n,p)\n$$\n\nwhere $p$ is the proportion of the population that have the characteristic, and \n\n$$\n\\text{E}[X]=np,\\,\\text{Var}[X]=np(1-p).\n$$\n\nThe sample proportion $\\overset{^}{\\,p}$ is given by\n\n$$\n\\overset{^}{\\,p}=\\overset{―}{X}=\\frac{X}{n}.\n$$\n\nUsing the properties of expectation and variance, it is straightforward to show that\n\n$$\n\\text{E}[\\overset{^}{\\,p}]=p,\\,\\text{Var}[\\overset{^}{\\,p}]=\\frac{p(1-p)}{n}.\n$$\n\nIn our case, we have $p=15%=0.15,$ and $n=60.$ Therefore,\n\n$$\n\\begin{aligned}\\text{E}[\\overset{^}{\\,p}] & =15%=0.15, \\\\ \\text{Var}[\\overset{^}{\\,p}] & =\\frac{0.15(1-0.15)}{60} \\\\  & ≈0.0021\\end{aligned}\n$$\n\nrounded to $4$ decimal places."}]}
