#{[{:activity/expected-seconds 1020.0 :activity/first-step {:db/id #edb/ref 17592186189179} :activity/id #uuid "831069d2-736b-52d1-a2bb-6631187686b5" :activity/scope {:db/id #edb/ref 17592186049908 :topic/id #uuid "1dc40382-49d1-5d5b-a59d-1be47c4f903d" :topic/math-academy-id 3929} :activity/steps [{:db/id #edb/ref 17592186189179 :step/content {:db/id #edb/ref 17592186189404 :tutorial/content "Suppose $X$ and $Y$ are continuous random variables, where the conditional expected value of $X$ given $Y=y$ is given by $\\mu_{X|y}.$ In other words,\n\n$$\n\\textrm{E}[X\\,|\\,Y=y] = \\mu_{X|y}.\n$$\n\nThe **conditional variance of $X$ given $Y=y$** is defined as\n\n$$\n\\textrm{Var}[X\\,|\\,Y] = \\textrm{E}\\big[(X - \\mu_{X|y} \\big)^2 \\,|\\, Y=y].\n$$\n\nAs with the discrete case, this definition can be written as\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=y] & =\\text{E}[{X}^{2}\\,|\\,Y=y]-{\\mu }_{X|y}^{2}\\end{aligned}\n$$\n\nwhere \n\n$$\n\\displaystyle \\textrm{E}\\big[X^2 \\,| \\, Y=y \\big] = \\int_{-\\infty}^{\\infty} x^2 \\, f_{X|Y}(x \\,|\\, y) \\: \\textrm{d}x,\n$$\n\n \n\nand $f_{X|Y}(x \\,|\\, y)$ is the conditional probability density function of $X$ given $Y=y.$ Note that these formulas are analogous to those for $\\textrm{Var}[X]$ for continuous $X.$\n\nWhen we select a particular value of $y,$ the conditional variance of $X$ given $Y=y$ returns a real number. However, if $y$ is not specified, then $\\textrm {Var}[X | Y = y]$ gives us a *function* of $y.$\n\nWe have an analogous definition for the **conditional variance of $Y$ given  $X=x{:}$**\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=x] & =\\text{E}[(Y-{\\mu }_{Y|x})^{2}\\,|\\,X=x] \\\\  & =\\text{E}[{Y}^{2}\\,|\\,X=x]-{\\mu }_{Y|x}^{2}\\end{aligned}\n$$\n\nwhere \n\n- $\\mu_{Y|x} = \\textrm{E}\\big[Y \\,| \\, X=x \\big]$ is the conditional expected value of $Y$ given  $X=x,$\n\n- $\\displaystyle \\textrm{E}\\big[Y^2 \\,| \\, X=x \\big] = \\int_{-\\infty}^{\\infty} y^2 \\, f_{Y|X}(y \\,|\\, x) \\: \\textrm{d}y,$ and\n\n- $f_{Y|X}(y \\,|\\, x)$ is the conditional probability density function of $Y$ given $X=x.$" :tutorial/id #uuid "cc60678b-fd8c-537f-99be-cee66503c859" :tutorial/math-academy-id 6444 :tutorial/title "Introduction"} :step/id #uuid "90a5c594-6537-5336-90c2-6eca3c31d58b" :step/math-academy-id 38946 :step/next {:db/id #edb/ref 17592186189203}} {:db/id #edb/ref 17592186189180 :step/content {:db/id #edb/ref 17592186188336 :knowledge-point/canonical-example {:db/id #edb/ref 17592186188043 :question/id #uuid "ea6a79c4-09fc-5ae9-9e92-e7bacd4939d9" :question/math-academy-id "e-10340"} :knowledge-point/id #uuid "29e185b1-7bd3-5441-b502-3049a253cf3e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049871} {:db/id #edb/ref 17592186050965}] :knowledge-point/questions [{:db/id #edb/ref 17592186188655} {:db/id #edb/ref 17592186188721} {:db/id #edb/ref 17592186530440} {:db/id #edb/ref 17592186530445} {:db/id #edb/ref 17592186530459} {:db/id #edb/ref 17592186530488} {:db/id #edb/ref 17592186530502}] :knowledge-point/title "Calculating a Conditional Variance Given a Conditional PDF"} :step/id #uuid "53d73871-be25-53a5-8455-4cf04e078787" :step/math-academy-id 38947 :step/next {:db/id #edb/ref 17592186189181}} {:db/id #edb/ref 17592186189181 :step/content {:db/id #edb/ref 17592186188337 :knowledge-point/canonical-example {:db/id #edb/ref 17592186188044 :question/id #uuid "fef21fcb-bab6-5f33-a792-280e28a97f81" :question/math-academy-id "e-10341"} :knowledge-point/id #uuid "aadf2ac8-bfb4-5371-97c3-1ae194c9479f" :knowledge-point/questions [{:db/id #edb/ref 17592186188722} {:db/id #edb/ref 17592186188724} {:db/id #edb/ref 17592186530417} {:db/id #edb/ref 17592186530464} {:db/id #edb/ref 17592186530494} {:db/id #edb/ref 17592186530508}] :knowledge-point/title "Calculating a Conditional Variance Given a Conditional PDF Using Improper Integrals"} :step/id #uuid "7bbe5d6f-436a-56b7-b6c3-4b50cf86ea46" :step/math-academy-id 38948 :step/next {:db/id #edb/ref 17592