i>x</mi><mn>2</mn></msub><mo>−</mo><mn>2</mn><msubsup><mi>x</mi><mn>2</mn><mn>2</mn></msubsup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo stretchy=\"false\">(</mo><mo>−</mo><msub><mi>y</mi><mn>2</mn></msub><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup><mo>+</mo><mo stretchy=\"false\">(</mo><mo>−</mo><msub><mi>y</mi><mn>2</mn></msub><mo stretchy=\"false\">)</mo><msub><mi>y</mi><mn>1</mn></msub><mo>−</mo><mn>2</mn><msubsup><mi>y</mi><mn>1</mn><mn>2</mn></msubsup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msubsup><mi>y</mi><mn>2</mn><mn>2</mn></msubsup><mo>−</mo><msub><mi>y</mi><mn>2</mn></msub><msub><mi>y</mi><mn>1</mn></msub><mo>−</mo><mn>2</mn><msubsup><mi>y</mi><mn>1</mn><mn>2</mn></msubsup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mn>2</mn><msubsup><mi>y</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msub><mi>y</mi><mn>1</mn></msub><msub><mi>y</mi><mn>2</mn></msub><mo>+</mo><msubsup><mi>y</mi><mn>2</mn><mn>2</mn></msubsup></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
