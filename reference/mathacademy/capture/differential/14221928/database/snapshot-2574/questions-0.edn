#{[{:db/id #edb/ref 17592186536882 :knowledge-point/_questions [{:db/id #edb/ref 17592186096743 :knowledge-point/id #uuid "46630d98-f27d-5426-aaad-0c390078e9b9" :knowledge-point/title "Finding the Limit of a Factored Rational Sequence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1084ac63-ef9b-56cc-bcb8-ef50cf2a751e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The sequence diverges" :db/id #edb/ref 17592186536310} {:answer/id #uuid "1a58b002-6268-59f9-8d62-d5780db00a57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186536322} {:answer/id #uuid "78d710b0-36b9-5af3-afee-6ec469874bb2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186536484} {:answer/id #uuid "975f8bf1-29e1-5e24-8470-e16a6bceb947" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186536527} {:answer/id #uuid "e2169256-da89-5b10-b1ae-084da0651fe3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186536635}] :answer-field/correct {:answer/id #uuid "78d710b0-36b9-5af3-afee-6ec469874bb2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186536484} :answer-field/id #uuid "5d7987cd-9189-59ea-8be9-6b86123a7745" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186536741}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d26b4fec-f259-5757-943d-c92ed32d5a4b" :question/math-academy-id "q-10859" :question/problem "What is the limit of the sequence ${a}_{n}=\\frac{(2{n}^{2}+3)(2{n}^{2}-3)}{2n(5{n}^{3}-1)}$ for $n\\ge 1?$" :question/worked-solution "First, we multiply out the numerator and denominator of the sequence and get\n\n$$\n{a}_{n}=\\frac{(2{n}^{2}+3)(2{n}^{2}-3)}{2n(5{n}^{3}-1)}=\\frac{4{n}^{4}-9}{10{n}^{4}-2n}.\n$$\n\nSo to find the limit, we will need to compute\n\n$$\n{lim}_{n\\to \\infty }{a}_{n}={lim}_{n\\to \\infty }\\frac{4{n}^{4}-9}{10{n}^{4}-2n}.\n$$\n\nThe dominant term in the denominator is $10{n}^{4},$ so we divide the numerator and the denominator by ${n}^{4}$ and get\n\n$$\n\\begin{aligned}{lim}_{n\\to \\infty }\\frac{4{n}^{4}-9}{10{n}^{4}-2n} & ={lim}_{n\\to \\infty }\\frac{(\\frac{4{n}^{4}}{{n}^{4}}-\\frac{9}{{n}^{4}})}{(\\frac{10{n}^{4}}{{n}^{4}}-\\frac{2n}{{n}^{4}})} \\\\  & ={lim}_{n\\to \\infty }\\frac{(4-\\frac{9}{{n}^{4}})}{(10-\\frac{2}{{n}^{3}})} \\\\  & =\\frac{4-0}{10-0} \\\\  & =\\frac{2}{5}.\\end{aligned}\n$$\n\nConsequently, the sequence converges and its limit is $\\frac{2}{5}.$"}] [{:db/id #edb/ref 17592186416142 :knowledge-point/_questions [{:db/id #edb/ref 17592186096740 :knowledge-point/id #uuid "1d14dbef-9a16-537e-a182-87fd6853e543" :knowledge-point/title "Identifying Divergent Sequences"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1681bc35-74bf-5ed7-994f-d82cdfe4629f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The sequence diverges" :db/id #edb/ref 17592186416119} {:answer/id #uuid "3a87c5f5-44c3-56a6-a6fa-8cd86e03ebdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186416122} {:answer/id #uuid "77ec0913-8676-5f43-a3a7-7943ade84d65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186416127} {:answer/id #uuid "9d2a465d-1d42-541a-80d1-54c5e6fa2f69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186416130} {:answer/id #uuid "c3243c58-ceb6-5a63-b7c1-b8d475631b39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186416132}] :answer-field/correct {:answer/id #uuid "1681bc35-74bf-5ed7-994f-d82cdfe4629f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The sequence diverges" :db/id #edb/ref 17592186416119} :answer-field/id #uuid "948e6f63-9900-5fe4-96c0-f19eefe39172" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186416136}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ca246561-cc0c-5bbd-b5ce-66fdd530c3a1" :question/math-academy-id "q-11153" :question/problem "What is the limit of the sequence ${a}_{n}=\\frac{8{n}^{5}-2n}{8{n}^{4}-2}$ for $n\\ge 1?$" :question/worked-solution "The dominant term in the denominator is $8{n}^{4},$ so we divide the numerator and the denominator by ${n}^{4}$ and get\n\n$$\n\\begin{aligned}{lim}_{n\\to \\infty }\\frac{8{n}^{5}-2n}{8{n}^{4}-2} & ={lim}_{n\\to \\infty }\\frac{(\\frac{8{n}^{5}}{{n}^{4}}-\\frac{2n}{{n}^{4}})}{(\\frac{8{n}^{4}}{{n}^{4}}-\\frac{2}{{n}^{4}})} \\\\  & ={lim}_{n\\to \\infty }\\frac{(8n-\\frac{2}{{n}^{3}})}{(8-\\frac{2}{{n}^{4}})} \\\\  & ={lim}_{n\\to \\infty }\\frac{8n-0}{8-0} \\\\  & ={lim}_{n\\to \\infty }n \\\\  & =\\infty .\\end{aligned}\n$$\n\nThe limit does not exist, so the sequence diverges."}] [{:db/id #edb/ref 17592186247229 :knowledge-point/_questions [{:db/id #edb/ref 17592186096740 :knowledge-point/id #uuid "1d14dbef-9a16-537e-a182-87fd6853e543" :knowledge-point/title "Identifying Divergent Sequences"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a1a2f3e-8475-560a-b8a7-0025d119dab4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186244402} {:answer/id #uuid "1f22c190-b1dc-5230-96e0-dee751aa9360" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186244584} {:answer/id #uuid "2b1db421-5534-597a-ab13-0763da69f2f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186244700} {:answer/id #uuid "3b0a5be4-c65c-580b-ba8d-9f426cfeaf95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186244833} {:answer/id #uuid "c5935ca4-3a6c-56d1-953f-6e0cb43527ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The sequence diverges." :db/id #edb/ref 17592186246065}] :answer-field/correct {:answer/id #uuid "c5935ca4-3a6c-56d1-953f-6e0cb43527ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The sequence diverges." :db/id #edb/ref 17592186246065} :answer-field/id #uuid "a8ccd7f6-0c9f-5d24-99bf-6f5bd0a90d5f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246847}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0cf1b903-1513-5e37-b092-1ae17c7691a5" :question/math-academy-id "q-11154" :question/problem "What is the limit of the sequence ${a}_{n}=\\frac{1-{n}^{4}}{3{n}^{2}+5}$ for $n\\ge 1?$" :question/worked-solution "The dominant term  in the denominator is $3{n}^{2}$, so we divide the numerator and the denominator by ${n}^{2}$ and get\n\n$$\n\\begin{aligned}{lim}_{n\\to \\infty }{a}_{n} & ={lim}_{n\\to \\infty }\\frac{1-{n}^{4}}{3{n}^{2}+5} \\\\  & ={lim}_{n\\to \\infty }\\frac{(\\frac{1}{{n}^{2}}-\\frac{{n}^{4}}{{n}^{2}})}{(\\frac{3{n}^{2}}{{n}^{2}}+\\frac{5}{{n}^{2}})} \\\\  & ={lim}_{n\\to \\infty }\\frac{(\\frac{1}{{n}^{2}}-{n}^{2})}{(3+\\frac{5}{{n}^{2}})} \\\\  & ={lim}_{n\\to \\infty }\\frac{0-{n}^{2}}{3+0} \\\\  & ={lim}_{n\\to \\infty }(-\\frac{{n}^{2}}{3}) \\\\  & =-\\infty .\\end{aligned}\n$$\n\nThe limit does not exist, so the sequence diverges."}] [{:db/id #edb/ref 17592186536898 :knowledge-point/_questions [{:db/id #edb/ref 17592186096743 :knowledge-point/id #uuid "46630d98-f27d-5426-aaad-0c390078e9b9" :knowledge-point/title "Finding the Limit of a Factored Rational Sequence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ca0fb74-d0d3-5f86-be12-a821fb96b41e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{9}" :db/id #edb/ref 17592186536445} {:answer/id #uuid "973d5ba1-9f1d-5d54-a5a6-681dae8dfc0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186536526} {:answer/id #uuid "ba2648e8-3c45-5b47-8bbc-61b0f969add5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186536578} {:answer/id #uuid "ddcaa7ca-0c0c-5d03-adf8-e0d7f6832969" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186536628} {:answer/id #uuid "fa7ed841-cc61-56c4-b2ed-0e53c44c292c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The sequence diverges" :db/id #edb/ref 17592186536684}] :answer-field/correct {:answer/id #uuid "ddcaa7ca-0c0c-5d03-adf8-e0d7f6832969" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186536628} :answer-field/id #uuid "0759db57-b8ce-5f50-b46e-8b442e52ee62" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186536702}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f593ac8e-7a29-5f43-82ff-aea84a5ba69c" :question/math-academy-id "q-123332" :question/problem "What is the limit of the sequence ${a}_{n}=\\frac{(3n-2)(3n+2)}{n(1-9n)}$ for $n\\ge 1?$" :question/worked-solution "First, we multiply out the numerator and denominator of the sequence and get\n\n$$\n{a}_{n}=\\frac{(3n-2)(3n+2)}{n(1-9n)}=\\frac{9{n}^{2}-4}{n-9{n}^{2}}.\n$$\n\nSo to find the limit, we will need to compute\n\n$$\n{lim}_{n\\to \\infty }{a}_{n}={lim}_{n\\to \\infty }\\frac{9{n}^{2}-4}{n-9{n}^{2}}.\n$$\n\nThe dominant term in the denominator is $-9{n}^{2},$ so we divide the numerator and the denominator by ${n}^{2}$ and get\n\n$$\n\\begin{aligned}{lim}_{n\\to \\infty }\\frac{9{n}^{2}-4}{n-9{n}^{2}} & ={lim}_{n\\to \\infty }\\frac{(\\frac{9{n}^{2}}{{n}^{2}}-\\frac{4}{{n}^{2}})}{(\\frac{n}{{n}^{2}}-\\frac{9{n}^{2}}{{n}^{2}})} \\\\  & ={lim}_{n\\to \\infty }\\frac{(9-\\frac{4}{{n}^{2}})}{(\\frac{1}{n}-9)} \\\\  & =\\frac{9-0}{0-9} \\\\  & =-1.\\end{aligned}\n$$\n\nConsequently, the sequence converges and its limit is $-1.$"}] [{:db/id #edb/ref 17592186536833 :knowledge-point/_questions [{:db/id #edb/ref 17592186096741 :knowledge-point/id #uuid "4bec57d9-3abf-58cb-87cb-1449224e6c2e" :knowledge-point/title "Determining the Limit of a Convergent Rational Sequence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ea68bf8b-4deb-5b99-92c1-18ea456b7de6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186536652}] :answer-field/correct {:answer/id #uuid "ea68bf8b-4deb-5b99-92c1-18ea456b7de6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186536652} :answer-field/id #uuid "c43acc61-3f4b-58f8-9442-6e3ef8f460f7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186536784}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "548006ed-ff60-5fe8-9b17-af5147ac7aae" :question/math-academy-id "q-347972" :question/problem "What is the limit of the sequence ${a}_{n}=\\frac{12n+1}{3n}$ for $n\\ge 1?$\n\n${lim}_{n\\to \\infty }{a}_{n}=$\n{{field-1}}" :question/worked-solution "To determine whether the sequence converges or diverges, we need to determine the limit of the sequence as $n$ approaches infinity:\n\n$$\n{lim}_{n\\to \\infty }{a}_{n}={lim}_{n\\to \\infty }\\frac{12n+1}{3n}.\n$$\n\nThe dominant term in the denominator is $3n,$ so we divide the numerator and the denominator by $n$ and get\n\n$$\n\\begin{aligned}{lim}_{n\\to \\infty }{a}_{n} & ={lim}_{n\\to \\infty }\\frac{12n+1}{3n} \\\\  & ={lim}_{n\\to \\infty }\\frac{(\\frac{12n}{n}+\\frac{1}{n})}{\\frac{3n}{n}} \\\\  & ={lim}_{n\\to \\infty }\\frac{12+\\frac{1}{n}}{3} \\\\  & =\\frac{12+0}{3} \\\\  & =4.\\end{aligned}\n$$\n\nConsequently, the sequence converges, and its limit is $4.$"}]}
