#{[{:db/id #edb/ref 17592186416142 :knowledge-point/_questions [{:db/id #edb/ref 17592186096740 :knowledge-point/id #uuid "1d14dbef-9a16-537e-a182-87fd6853e543" :knowledge-point/title "Identifying Divergent Sequences"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1681bc35-74bf-5ed7-994f-d82cdfe4629f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The sequence diverges" :db/id #edb/ref 17592186416119} {:answer/id #uuid "3a87c5f5-44c3-56a6-a6fa-8cd86e03ebdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186416122} {:answer/id #uuid "77ec0913-8676-5f43-a3a7-7943ade84d65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186416127} {:answer/id #uuid "9d2a465d-1d42-541a-80d1-54c5e6fa2f69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186416130} {:answer/id #uuid "c3243c58-ceb6-5a63-b7c1-b8d475631b39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186416132}] :answer-field/correct {:answer/id #uuid "1681bc35-74bf-5ed7-994f-d82cdfe4629f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The sequence diverges" :db/id #edb/ref 17592186416119} :answer-field/id #uuid "948e6f63-9900-5fe4-96c0-f19eefe39172" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186416136}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ca246561-cc0c-5bbd-b5ce-66fdd530c3a1" :question/math-academy-id "q-11153" :question/problem "What is the limit of the sequence ${a}_{n}=\\frac{8{n}^{5}-2n}{8{n}^{4}-2}$ for $n\\ge 1?$" :question/worked-solution "The dominant term in the denominator is $8{n}^{4},$ so we divide the numerator and the denominator by ${n}^{4}$ and get\n\n$$\n\\begin{aligned}{lim}_{n\\to \\infty }\\frac{8{n}^{5}-2n}{8{n}^{4}-2} & ={lim}_{n\\to \\infty }\\frac{(\\frac{8{n}^{5}}{{n}^{4}}-\\frac{2n}{{n}^{4}})}{(\\frac{8{n}^{4}}{{n}^{4}}-\\frac{2}{{n}^{4}})} \\\\  & ={lim}_{n\\to \\infty }\\frac{(8n-\\frac{2}{{n}^{3}})}{(8-\\frac{2}{{n}^{4}})} \\\\  & ={lim}_{n\\to \\infty }\\frac{8n-0}{8-0} \\\\  & ={lim}_{n\\to \\infty }n \\\\  & =\\infty .\\end{aligned}\n$$\n\nThe limit does not exist, so the sequence diverges."}] [{:db/id #edb/ref 17592186247229 :knowledge-point/_questions [{:db/id #edb/ref 17592186096740 :knowledge-point/id #uuid "1d14dbef-9a16-537e-a182-87fd6853e543" :knowledge-point/title "Identifying Divergent Sequences"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a1a2f3e-8475-560a-b8a7-0025d119dab4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186244402} {:answer/id #uuid "1f22c190-b1dc-5230-96e0-dee751aa9360" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186244584} {:answer/id #uuid "2b1db421-5534-597a-ab13-0763da69f2f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186244700} {:answer/id #uuid "3b0a5be4-c65c-580b-ba8d-9f426cfeaf95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186244833} {:answer/id #uuid "c5935ca4-3a6c-56d1-953f-6e0cb43527ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The sequence diverges." :db/id #edb/ref 17592186246065}] :answer-field/correct {:answer/id #uuid "c5935ca4-3a6c-56d1-953f-6e0cb43527ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The sequence diverges." :db/id #edb/ref 17592186246065} :answer-field/id #uuid "a8ccd7f6-0c9f-5d24-99bf-6f5bd0a90d5f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246847}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0cf1b903-1513-5e37-b092-1ae17c7691a5" :question/math-academy-id "q-11154" :question/problem "What is the limit of the sequence ${a}_{n}=\\frac{1-{n}^{4}}{3{n}^{2}+5}$ for $n\\ge 1?$" :question/worked-solution "The dominant term  in the denominator is $3{n}^{2}$, so we divide the numerator and the denominator by ${n}^{2}$ and get\n\n$$\n\\begin{aligned}{lim}_{n\\to \\infty }{a}_{n} & ={lim}_{n\\to \\infty }\\frac{1-{n}^{4}}{3{n}^{2}+5} \\\\  & ={lim}_{n\\to \\infty }\\frac{(\\frac{1}{{n}^{2}}-\\frac{{n}^{4}}{{n}^{2}})}{(\\frac{3{n}^{2}}{{n}^{2}}+\\frac{5}{{n}^{2}})} \\\\  & ={lim}_{n\\to \\infty }\\frac{(\\frac{1}{{n}^{2}}-{n}^{2})}{(3+\\frac{5}{{n}^{2}})} \\\\  & ={lim}_{n\\to \\infty }\\frac{0-{n}^{2}}{3+0} \\\\  & ={lim}_{n\\to \\infty }(-\\frac{{n}^{2}}{3}) \\\\  & =-\\infty .\\end{aligned}\n$$\n\nThe limit does not exist, so the sequence diverges."}]}
