#{[{:db/id #edb/ref 17592186272090 :knowledge-point/_questions [{:db/id #edb/ref 17592186133774 :knowledge-point/id #uuid "6bde92b0-4e98-5c2e-848e-7a5febc848ae" :knowledge-point/title "Finding the Acute Angle Between Two Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13324668-ce20-5ef2-a468-80b0d3559702" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{86.22}^{∘}" :db/id #edb/ref 17592186269438} {:answer/id #uuid "20612eaf-6f72-5c17-b500-3e91c9c59bec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{75.28}^{∘}" :db/id #edb/ref 17592186269540} {:answer/id #uuid "6c956be0-6107-50ca-9fbb-b6a515d4b585" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{83.01}^{∘}" :db/id #edb/ref 17592186270232} {:answer/id #uuid "ddd29c40-21e0-51ac-bccc-b59d130e6b0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{65.86}^{∘}" :db/id #edb/ref 17592186271217} {:answer/id #uuid "e24ab0a8-78b8-52e7-9bfc-1c0a57398dec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{72.45}^{∘}" :db/id #edb/ref 17592186271258}] :answer-field/correct {:answer/id #uuid "6c956be0-6107-50ca-9fbb-b6a515d4b585" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{83.01}^{∘}" :db/id #edb/ref 17592186270232} :answer-field/id #uuid "53995c65-618d-55f5-ae00-77480a6ad442" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271663}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a7c02465-0f29-5382-84ca-baeafb02cecc" :question/math-academy-id "q-140444" :question/problem "Rounded to two decimal places, what is the acute angle between the vectors $v=[\\begin{aligned}-1 \\\\ 2 \\\\ 0 \\\\ 5\\end{aligned}]$ and $w=[\\begin{aligned}4 \\\\ 4 \\\\ -2 \\\\ 0\\end{aligned}]?$" :question/worked-solution "Using the formula\n\n$$\n\\operatorname{cos}⁡\\theta =\\frac{v\\cdot w}{‖v‖\\,‖w‖},\n$$\n\nwe have the following:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{{v}_{1}{w}_{1}+{v}_{2}{w}_{2}+{v}_{3}{w}_{3}+{v}_{4}{w}_{4}}{\\sqrt{{v}_{1}^{2}+{v}_{2}^{2}+{v}_{3}^{2}+{v}_{4}^{2}}\\,\\sqrt{{w}_{1}^{2}+{w}_{2}^{2}+{w}_{3}^{2}+{w}_{4}^{2}}} \\\\  & =\\frac{(-1)\\cdot 4+2\\cdot 4+0\\cdot (-2)+5\\cdot 0}{\\sqrt{{1}^{2}+(-2)^{2}+{0}^{2}+{5}^{2}}\\,\\sqrt{{4}^{2}+{4}^{2}+(-2)^{2}+{0}^{2}}} \\\\  & =\\frac{4}{\\sqrt{30}\\cdot \\sqrt{36}} \\\\  & =\\frac{4}{6\\sqrt{30}} \\\\  & =\\frac{2}{3\\sqrt{30}}\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{2}{3\\sqrt{30}})≈{83.01}^{∘}.\n$$"}] [{:db/id #edb/ref 17592186326850 :knowledge-point/_questions [{:db/id #edb/ref 17592186133774 :knowledge-point/id #uuid "6bde92b0-4e98-5c2e-848e-7a5febc848ae" :knowledge-point/title "Finding the Acute Angle Between Two Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05aa2b74-3473-50db-a3d9-fefeb5b23a74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{87.24}^{∘}" :db/id #edb/ref 17592186324023} {:answer/id #uuid "816f4158-b74f-583e-9a6d-e44c27a2e626" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{85.35}^{∘}" :db/id #edb/ref 17592186325054} {:answer/id #uuid "82d52b5b-2b69-5058-a805-f742853d81d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{83.24}^{∘}" :db/id #edb/ref 17592186325072} {:answer/id #uuid "a3b306f2-05b0-566f-b4bb-3365478423d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{87.27}^{∘}" :db/id #edb/ref 17592186325360} {:answer/id #uuid "a719e046-f4eb-571e-9d73-55b635635972" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{84.32}^{∘}" :db/id #edb/ref 17592186325397}] :answer-field/correct {:answer/id #uuid "a3b306f2-05b0-566f-b4bb-3365478423d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{87.27}^{∘}" :db/id #edb/ref 17592186325360} :answer-field/id #uuid "114ad25d-2d18-5a8b-98d7-ea7680bff2b8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326252}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "473a85e8-59ee-5be1-849d-d7a1fd3382ad" :question/math-academy-id "q-40562" :question/problem "Rounded to two decimal places, what is the acute angle between the vectors $v=[\\begin{aligned}1 \\\\ \\sqrt{8} \\\\ -2 \\\\ -3\\end{aligned}]$ and $w=[\\begin{aligned}4 \\\\ 1 \\\\ \\sqrt{2} \\\\ 1\\end{aligned}]?$" :question/worked-solution "Using the formula\n\n$$\n\\operatorname{cos}⁡\\theta =\\frac{v\\cdot w}{‖v‖\\,‖w‖},\n$$\n\nwe have the following:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{{v}_{1}{w}_{1}+{v}_{2}{w}_{2}+{v}_{3}{w}_{3}+{v}_{4}{w}_{4}}{\\sqrt{{v}_{1}^{2}+{v}_{2}^{2}+{v}_{3}^{2}+{v}_{4}^{2}}\\sqrt{{w}_{1}^{2}+{w}_{2}^{2}+{w}_{3}^{2}+{w}_{4}^{2}}} \\\\  & =\\frac{(1)(4)+(\\sqrt{8})(1)+(-2)(\\sqrt{2})+(-3)(1)}{\\sqrt{{1}^{2}+(\\sqrt{8})^{2}+(-2)^{2}+(-3)^{2}}\\sqrt{(4)^{2}+{1}^{2}+(\\sqrt{2})^{2}+{1}^{2}}} \\\\  & =\\frac{1}{\\sqrt{22}\\sqrt{20}} \\\\  & =\\frac{1}{2\\sqrt{110}} \\\\  & =\\frac{\\sqrt{110}}{220}\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{\\sqrt{110}}{220})≈{87.27}^{∘}.\n$$"}] [{:db/id #edb/ref 17592186134328 :knowledge-point/_questions [{:db/id #edb/ref 17592186133816 :knowledge-point/id #uuid "7b56b45b-94dd-5ba1-aae6-6b17cffaf532" :knowledge-point/title "Calculating the Cosine of an Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40bf9200-1ded-5747-9100-fdedc6dbc312" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{27}{\\sqrt{87}}" :db/id #edb/ref 17592186324492} {:answer/id #uuid "661ac123-d77e-5c6e-8d2c-7670eee85acd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17}{\\sqrt{7}}" :db/id #edb/ref 17592186324820} {:answer/id #uuid "a42362a6-32c2-5609-85a5-a68ce5cce8c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{7}" :db/id #edb/ref 17592186325365} {:answer/id #uuid "d8a8d4bc-4399-5de0-8a90-b2bb3fb89a57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{41}" :db/id #edb/ref 17592186325856} {:answer/id #uuid "fd0988c8-ca2f-56e1-b886-bad29e42c487" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186326200}] :answer-field/correct {:answer/id #uuid "fd0988c8-ca2f-56e1-b886-bad29e42c487" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186326200} :answer-field/id #uuid "9d381a9f-7e00-5a40-aefb-bf456bb7a19b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326503}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f556bfd7-df7c-5f35-9d10-55d46797ea31" :question/math-academy-id "q-40886" :question/problem "Let $A(1,-1,2,0)$, $B(1,0,0,-1)$, and $C(0,1,1,0).$ Find the cosine of the angle $∠BAC.$" :question/worked-solution "Let $v=\\overset{\\to }{AB}$ and $w=\\overset{\\to }{AC}.$ Then we have\n\n$$\n\\begin{aligned}v & =b-a \\\\  & =[\\begin{aligned}1 \\\\ 0 \\\\ 0 \\\\ -1\\end{aligned}]-[\\begin{aligned}1 \\\\ -1 \\\\ 2 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 1 \\\\ -2 \\\\ -1\\end{aligned}]\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}w & =c-a \\\\  & =[\\begin{aligned}0 \\\\ 1 \\\\ 1 \\\\ 0\\end{aligned}]-[\\begin{aligned}1 \\\\ -1 \\\\ 2 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}-1 \\\\ 2 \\\\ -1 \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\nLet $\\theta =m∠BAC$ be the angle between the vectors $v$ and $w.$ Then, we can find $\\operatorname{cos}⁡\\theta $ using the following formula:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{v\\cdot w}{‖v‖\\,‖w‖} \\\\  & =\\frac{{v}_{1}{w}_{1}+{v}_{2}{w}_{2}+{v}_{3}{w}_{3}+{v}_{4}{w}_{4}}{\\sqrt{{v}_{1}^{2}+{v}_{2}^{2}+{v}_{3}^{2}+{v}_{4}^{2}}\\,\\sqrt{{w}_{1}^{2}+{w}_{2}^{2}+{w}_{3}^{2}+{w}_{4}^{2}}} \\\\  & =\\frac{0\\cdot (-1)+1\\cdot 2+(-2)\\cdot (-1)+(-1)\\cdot 0}{\\sqrt{{0}^{2}+{1}^{2}+(-2)^{2}+(-1)^{2}}\\,\\sqrt{(-1)^{2}+{2}^{2}+(-1)^{2}+{0}^{2}}} \\\\  & =\\frac{4}{\\sqrt{6}\\cdot \\sqrt{6}} \\\\  & =\\frac{4}{6} \\\\  & =\\frac{2}{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186134331 :knowledge-point/_questions [{:db/id #edb/ref 17592186133816 :knowledge-point/id #uuid "7b56b45b-94dd-5ba1-aae6-6b17cffaf532" :knowledge-point/title "Calculating the Cosine of an Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "002742f3-7284-5ac0-8779-30b804e92705" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{\\sqrt{131}}" :db/id #edb/ref 17592186414644} {:answer/id #uuid "7d06f1ec-30ff-53f8-9943-6ae3b36ce40d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{\\sqrt{266}}" :db/id #edb/ref 17592186414650} {:answer/id #uuid "bcaffc6f-0a85-5982-a4c7-707c5cbc1a65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{15}{\\sqrt{131}}" :db/id #edb/ref 17592186414653} {:answer/id #uuid "bd84ff6d-55f1-5a15-aef5-c63480bc1877" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{\\sqrt{266}}" :db/id #edb/ref 17592186414654} {:answer/id #uuid "bf2d35a4-2976-51e9-ab5e-f0e748e55003" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{18}{\\sqrt{266}}" :db/id #edb/ref 17592186414655}] :answer-field/correct {:answer/id #uuid "7d06f1ec-30ff-53f8-9943-6ae3b36ce40d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{\\sqrt{266}}" :db/id #edb/ref 17592186414650} :answer-field/id #uuid "c90a5531-3cd5-5504-b1c0-5278d3ea6ed7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186414660}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3dd6a25a-12e9-5ca9-91cb-a545462d6da3" :question/math-academy-id "q-40902" :question/problem "Let $A(-2,1,0,-3)$ and $B(1,-1,1,-4).$ Find the cosine of the angle $∠AOB$, where $O(0,0,0,0)$ is the origin." :question/worked-solution "First, let\n\n$$\n\\begin{aligned}a=\\overset{\\to }{OA}=[\\begin{aligned}-2 \\\\ 1 \\\\ 0 \\\\ -3\\end{aligned}],\\,b=\\overset{\\to }{OB}=[\\begin{aligned}1 \\\\ -1 \\\\ 1 \\\\ -4\\end{aligned}].\\end{aligned}\n$$\n\nAlso, let $\\theta =m∠AOB$ be the angle between the vectors $a$ and $b.$ Then, we can find $\\operatorname{cos}⁡\\theta $ using the following formula:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{a\\cdot b}{‖a‖\\,‖b‖} \\\\  & =\\frac{{a}_{1}{b}_{1}+{a}_{2}{b}_{2}+{a}_{3}{b}_{3}+{a}_{4}{b}_{4}}{\\sqrt{{a}_{1}^{2}+{a}_{2}^{2}+{a}_{3}^{2}+{a}_{4}^{2}}\\,\\sqrt{{b}_{1}^{2}+{b}_{2}^{2}+{b}_{3}^{2}+{b}_{4}^{2}}} \\\\  & =\\frac{(-2)\\cdot 1+1\\cdot (-1)+0\\cdot 1+(-3)\\cdot (-4)}{\\sqrt{(-2)^{2}+{1}^{2}+{0}^{2}+(-3)^{2}}\\,\\sqrt{{1}^{2}+(-1)^{2}+{1}^{2}+(-4)^{2}}} \\\\  & =\\frac{9}{\\sqrt{14}\\cdot \\sqrt{19}} \\\\  & =\\frac{9}{\\sqrt{266}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186492825 :knowledge-point/_questions [{:db/id #edb/ref 17592186133816 :knowledge-point/id #uuid "7b56b45b-94dd-5ba1-aae6-6b17cffaf532" :knowledge-point/title "Calculating the Cosine of an Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01ff0db7-bee8-5c22-bcf6-717f10c873bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186492227} {:answer/id #uuid "179642be-505d-5e1b-bb2a-b937afe83962" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{5}" :db/id #edb/ref 17592186492262} {:answer/id #uuid "afb5358c-3022-5993-afeb-0b8224de5160" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186492569} {:answer/id #uuid "e12cb031-4be0-5534-ad8a-2cad6c375052" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186492654} {:answer/id #uuid "e2349564-7be1-546c-b905-c0f5302320e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{6}" :db/id #edb/ref 17592186492658}] :answer-field/correct {:answer/id #uuid "e2349564-7be1-546c-b905-c0f5302320e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{6}" :db/id #edb/ref 17592186492658} :answer-field/id #uuid "396e31d7-971b-5c45-b7d7-da00f7454c2c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186492728}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0a4aeef2-6579-5805-af59-33b7dcd85283" :question/math-academy-id "q-74111" :question/problem "Let $A(1,0,1,0)$ and $B(-1,4,0,-1).$ Find the cosine of the angle $∠AOB$, where $O(0,0,0,0)$ is the origin." :question/worked-solution "First, let\n\n$$\n\\begin{aligned}a=\\overset{\\to }{OA}=[\\begin{aligned}1 \\\\ 0 \\\\ 1 \\\\ 0\\end{aligned}],\\,b=\\overset{\\to }{OB}=[\\begin{aligned}-1 \\\\ 4 \\\\ 0 \\\\ -1\\end{aligned}].\\end{aligned}\n$$\n\nAlso, let $\\theta =m∠AOB$ be the angle between the vectors $a$ and $b.$ Then, we can find $\\operatorname{cos}⁡\\theta $ using the following formula:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{a\\cdot b}{‖a‖\\,‖b‖} \\\\  & =\\frac{{a}_{1}{b}_{1}+{a}_{2}{b}_{2}+{a}_{3}{b}_{3}+{a}_{4}{b}_{4}}{\\sqrt{{a}_{1}^{2}+{a}_{2}^{2}+{a}_{3}^{2}+{a}_{4}^{2}}\\,\\sqrt{{b}_{1}^{2}+{b}_{2}^{2}+{b}_{3}^{2}+{b}_{4}^{2}}} \\\\  & =\\frac{1\\cdot (-1)+0\\cdot 4+1\\cdot 0+0\\cdot (-1)}{\\sqrt{{1}^{2}+{0}^{2}+{1}^{2}+{0}^{2}}\\,\\sqrt{(-1)^{2}+{4}^{2}+{0}^{2}+(-1)^{2}}} \\\\  & =\\frac{-1}{\\sqrt{2}\\cdot \\sqrt{18}} \\\\  & =\\frac{-1}{\\sqrt{36}} \\\\  & =-\\frac{1}{6}\\end{aligned}\n$$"}]}
