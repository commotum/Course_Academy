-texclass=\"OPEN\">(</mo><mn>4</mn><mo>,</mo><mn>1</mn><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mo>+</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mn>2</mn><mo>⋅</mo><msqrt><mn>4</mn></msqrt><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mo>⋅</mo><mi>f</mi><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mn>4</mn><mo>,</mo><mn>2</mn><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>1</mn><mo>⋅</mo><mi>f</mi><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mo>+</mo><mn>2</mn><mo>⋅</mo><mi>f</mi><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mn>1</mn><mo>,</mo><mn>2</mn><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mo>+</mo><mn>2</mn><mo>⋅</mo><mi>f</mi><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mn>4</mn><mo>,</mo><mn>1</mn><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mo>+</mo><mn>4</mn><mo>⋅</mo><mi>f</mi><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mn>4</mn><mo>,</mo><mn>2</mn><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>1</mn><mo>⋅</mo><mn>0.1</mn><mo>+</mo><mn>2</mn><mo>⋅</mo><mn>0.5</mn><mo>+</mo><mn>2</mn><mo>⋅</mo><mn>0.2</mn><mo>+</mo><mn>4</mn><mo>⋅</mo><mn>0.2</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>0.1</mn><mo>+</mo><mn>1</mn><mo>+</mo><mn>0.4</mn><mo>+</mo><mn>0.8</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>2.3</mn><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
