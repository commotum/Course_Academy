#{[17592186481231 #edb/ref 1080 "0.09" #edb/ref 17592186045417] [17592186481231 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186481231 #edb/ref 1083 #uuid "fe0f133d-d936-51dc-8dad-167e59ac346b" #edb/ref 17592186045417] [17592186481240 #edb/ref 1075 #edb/ref 17592186480812 #edb/ref 17592186045417] [17592186481240 #edb/ref 1075 #edb/ref 17592186480865 #edb/ref 17592186045417] [17592186481240 #edb/ref 1075 #edb/ref 17592186480907 #edb/ref 17592186045417] [17592186481240 #edb/ref 1075 #edb/ref 17592186480974 #edb/ref 17592186045417] [17592186481240 #edb/ref 1075 #edb/ref 17592186481020 #edb/ref 17592186045417] [17592186481240 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186481240 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186481240 #edb/ref 1078 #edb/ref 17592186481020 #edb/ref 17592186045417] [17592186481240 #edb/ref 1079 #uuid "04cedd67-eefd-5664-9e79-71d0a4cd5a23" #edb/ref 17592186045417] [17592186481241 #edb/ref 1075 #edb/ref 17592186480822 #edb/ref 17592186045417] [17592186481241 #edb/ref 1075 #edb/ref 17592186480873 #edb/ref 17592186045417] [17592186481241 #edb/ref 1075 #edb/ref 17592186480909 #edb/ref 17592186045417] [17592186481241 #edb/ref 1075 #edb/ref 17592186480923 #edb/ref 17592186045417] [17592186481241 #edb/ref 1075 #edb/ref 17592186481156 #edb/ref 17592186045417] [17592186481241 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186481241 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186481241 #edb/ref 1078 #edb/ref 17592186480873 #edb/ref 17592186045417] [17592186481241 #edb/ref 1079 #uuid "04e92015-0288-5022-836f-fa11f4607dd5" #edb/ref 17592186045417] [17592186481242 #edb/ref 1075 #edb/ref 17592186480748 #edb/ref 17592186045417] [17592186481242 #edb/ref 1075 #edb/ref 17592186480997 #edb/ref 17592186045417] [17592186481242 #edb/ref 1075 #edb/ref 17592186481166 #edb/ref 17592186045417] [17592186481242 #edb/ref 1075 #edb/ref 17592186481190 #edb/ref 17592186045417] [