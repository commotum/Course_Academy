2</mn></msup></mrow><mn>2</mn></mfrac></mstyle></mtd></mtr><mtr><mtd><mo stretchy=\"false\">(</mo><mi>y</mi><mo>+</mo><mn>1</mn><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mn>2</mn><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mi>z</mi><mo>−</mo><mn>1</mn><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container> </p>\n<p>This gives us the equation of the parabola in <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"216\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D466 TEX-I\"></mjx-c></mjx-mi><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D467 TEX-I\"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mi>z</mi></math></mjx-assistive-mml></mjx-container>-plane.</p>\n</div></div>",
