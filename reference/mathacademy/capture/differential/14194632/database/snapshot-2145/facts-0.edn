db/ref 17592186124314 #edb/ref 17592186045417] [17592186124505 #edb/ref 1042 #uuid "e9078ab1-37a4-5e96-ae12-a83d5cd8804e" #edb/ref 17592186045417] [17592186124556 #edb/ref 1037 #edb/ref 17592186049118 #edb/ref 17592186045417] [17592186124556 #edb/ref 1037 #edb/ref 17592186049699 #edb/ref 17592186045417] [17592186124556 #edb/ref 1038 #edb/ref 17592186124897 #edb/ref 17592186045417] [17592186124556 #edb/ref 1038 #edb/ref 17592186124923 #edb/ref 17592186045417] [17592186124556 #edb/ref 1038 #edb/ref 17592186284464 #edb/ref 17592186045417] [17592186124556 #edb/ref 1038 #edb/ref 17592186284465 #edb/ref 17592186045417] [17592186124556 #edb/ref 1038 #edb/ref 17592186323729 #edb/ref 17592186045417] [17592186124556 #edb/ref 1038 #edb/ref 17592186323730 #edb/ref 17592186045417] [17592186124556 #edb/ref 1038 #edb/ref 17592186381910 #edb/ref 17592186045417] [17592186124556 #edb/ref 1038 #edb/ref 17592186381935 #edb/ref 17592186045417] [17592186124556 #edb/ref 1038 #edb/ref 17592186402441 #edb/ref 17592186045417] [17592186124556 #edb/ref 1038 #edb/ref 17592186402475 #edb/ref 17592186045417] [17592186124556 #edb/ref 1038 #edb/ref 17592186418046 #edb/ref 17592186045417] [17592186124556 #edb/ref 1039 "Finding Traces of Paraboloids" #edb/ref 17592186045417] [17592186124556 #edb/ref 1041 #edb/ref 17592186124365 #edb/ref 17592186045417] [17592186124556 #edb/ref 1042 #uuid "dff86a8b-7966-53f7-a7bc-287990fb611d" #edb/ref 17592186045417] [17592186124696 #edb/ref 1043 #edb/ref 17592186125377 #edb/ref 17592186045417] [17592186124696 #edb/ref 1043 #edb/ref 17592186125378 #edb/ref 17592186045417] [17592186124696 #edb/ref 1043 #edb/ref 17592186125380 #edb/ref 17592186045417] [17592186124696 #edb/ref 1043 #edb/ref 17592186125381 #edb/ref 17592186045417] [17592186124696 #edb/ref 1043 #edb/ref 17592186125460 #edb/ref 17592186045417] [17592186124696 #edb/ref 1043 #edb/ref 17592186125461 #edb/ref 17592186045417] [17592186124696 #edb/ref 1043 #edb/ref 17592186125638 #edb/ref 17592186045417] [17592186124696 #edb/ref 1043 #edb/ref 17592186125639 #edb/ref 17592186045417] [17592186124696 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186124696 #edb/ref 1045 "Paraboloids" #edb/ref 17592186045417] [17592186124696 #edb/ref 1046 #edb/ref 17592186125377 #edb/ref 17592186045417] [17592186124696 #edb/ref 1049 #edb/ref 17592186048510 #edb/ref 17592186045417] [17592186124696 #edb/ref 1050 540.0 #edb/ref 17592186045436] [17592186124696 #edb/ref 1053 #uuid "c72df862-0af9-5865-8585-d7236cb48cda" #edb/ref 17592186045417] [17592186124891 #edb/ref 1068 #edb/ref 17592186121946 #edb/ref 17592186045417] [17592186124891 #edb/ref 1069 "q-35557" #edb/ref 17592186045417] [17592186124891 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186124891 #edb/ref 1071 "Find the saddle point of the hyperbolic paraboloid $z+1=\\frac{(x+3)^{2}}{2}-\\frac{{y}^{2}}{4}.$" #edb/ref 17592186045417] [17592186124891 #edb/ref 1072 #uuid "46ec68bc-6534-5a9b-ab9f-a1364685c87b" #edb/ref 17592186045417] [17592186124891 #edb/ref 1074 "The general equation of a hyperbolic paraboloid with a saddle point at $({x}_{0},{y}_{0},{z}_{0})$ is \n\n$$\nz-{z}_{0}=\\frac{(x-{x}_{0})^{2}}{{a}^{2}}-\\frac{(y-{y}_{0})^{2}}{{b}^{2}}.\n$$\n\nTo find the saddle point, we rewrite our equation as follows:\n\n$$\n\\begin{aligned}z+1 & =\\frac{(x+3)^{2}}{2}-\\frac{{y}^{2}}{4} \\\\ z-(-1) & =\\frac{(x-(-3))^{2}}{2}-\\frac{(y-0)^{2}}{4}\\end{aligned}\n$$\n\nThis gives us the equation of a hyperbolic paraboloid with a saddle point at $(-3,0,-1).$" #edb/ref 17592186045417] [17592186124897 #edb/ref 1068 #edb/ref 17592186121982 #edb/ref 17592186045417] [17592186124897 #edb/ref 1069 "q-35703" #edb/ref 17592186045417] [17592186124897 #edb/ref 1071 "The projection of the intersection between the elliptic paraboloid $4(x - 1)^{2} + 25(y + 1)^{2} = 100(z - 2)$ and the plane\n$z = 7$ onto the $xy$-plane is an ellipse. What are the lengths of the semi-axes of the ellipse?" #edb/ref 17592186045417] [17592186124897 #edb/ref 1072 #uuid "5f9b5701-5a46-5b44-acab-e449b1e6d7a0" #edb/ref 17592186045417] [17592186125377 #edb/ref 1058 #edb/ref 17592186125378 #edb/ref 17592186045417] [17592186125377 #edb/ref 1061 19459 #edb/ref 17592186045417] [17592186125377 #edb/ref 1062 #uuid "0155d173-f619-5729-9721-6203bf768219" #edb/ref 17592186045417] [17592186125377 #edb/ref 1063 #edb/ref 17592186125774 #edb/ref 17592186045417] [17592186125378 #edb/ref 1058 #edb/ref 17592186125380 #edb/ref 17592186045417] [17592186125378 #edb/ref 1061 19461 #edb/ref 17592186045417] [17592186125378 #edb/ref 1062 #uuid "32ea6077-6c22-5a3f-bce8-05b8b28c4283" #edb/ref 17592186045417] [17592186125378 #edb/ref 1063 #edb/ref 17592186124504 #edb/ref 17592186045417] [17592186125380 #edb/ref 1058 #edb/ref 17592186125381 #edb/ref 17592186045417] [17592186125380 #edb/ref 1061 19465 #edb/ref 17592186045417] [17592186125380 #edb/ref 1062 #uuid "68121b3e-5396-564e-baa5-4f10972910c1" #edb/ref 17592186045417] [17592186125380 #edb/ref 1063 #edb/ref 17592186125776 #edb/ref 17592186045417] [17592186125381 #edb/ref 1058 #edb/ref 17592186125461 #edb/ref 17592186045417] [17592186125381 #edb/ref 1061 19466 #edb/ref 17592186045417] [17592186125381 #edb/ref 1062 #uuid "74d8bc9d-43f4-50df-82fd-204384b7d677" #edb/ref 17592186045417] [17592186125381 #edb/ref 1063 #edb/ref 17592186124505 #edb/ref 17592186045417] [17592186125460 #edb/ref 1061 22414 #edb/ref 17592186045417] [17592186125460 #edb/ref 1062 #uuid "d6a4a4b3-6632-5593-890e-334f7d6d897e" #edb/ref 17592186045417] [17592186125460 #edb/ref 1063 #edb/ref 17592186124556 #edb/ref 17592186045417] [17592186125461 #edb/ref 1058 #edb/ref 17592186125638 #edb/ref 17592186045417] [17592186125461 #edb/ref 1061 22415 #edb/ref 17592186045417] [17592186125461 #edb/ref 1062 #uuid "26ce593b-6eaa-5a9c-a0cc-f0cf3649224d" #edb/ref 17592186045417] [17592186125461 #edb/ref 1063 #edb/ref 17592186125805 #edb/ref 17592186045417] [17592186125638 #edb/ref 1058 #edb/ref 17592186125639 #edb/ref 17592186045417] [17592186125638 #edb/ref 1061 45282 #edb/ref 17592186045417] [17592186125638 #edb/ref 1062 #uuid "587634e3-d3a5-57e5-bd78-93b3ed921e5b" #edb/ref 17592186045417] [17592186125638 #edb/ref 1063 #edb/ref 17592186125880 #edb/ref 17592186045417] [17592186125639 #edb/ref 1058 #edb/ref 17592186125460 #edb/ref 17592186045417] [17592186125639 #edb/ref 1061 45283 #edb/ref 17592186045417] [17592186125639 #edb/ref 1062 #uuid "d9e46e54-59aa-5284-ac11-65d16e6bca74" #edb/ref 17592186045417] [17592186125639 #edb/ref 1063 #edb/ref 17592186125881 #edb/ref 17592186045417] [17592186125774 #edb/ref 1064 "Consider the quadric surface with the equation\n\n$$z = x^2 + y^2$$\n\nwhose graph is shown below.\n\n![](images/14/14e8d23a4bc649257c2f7351e0d2c1d62e39a8cd8eed1467e65853ee121b836e.png)\n\nThis surface is an example of an **elliptic paraboloid.**\n\nThe **vertex** of this elliptic paraboloid is located at the origin, and its **axis of symmetry** is the $z$-axis. Note that the axis of symmetry is the vertical line that passes through the vertex.\n\nMore generally, the equation of an elliptic paraboloid oriented along the $z$-axis whose vertex is at the point $(x_0,y_0,z_0)$ is given by\n\n$$z - z_0 = \\dfrac{(x-x_0)^2}{a^2} + \\dfrac{(y-y_0)^2}{b^2},$$\n\nwhere $a$ and $b$ are constants.\n\nThese surfaces are called *elliptic* *paraboloids* because their traces in the $xy$-plane are *ellipses*, while their traces in the $yz$- and $xz$-planes are *parabolas*. We'll discuss the traces of this surface in more detail shortly." #edb/ref 17592186045417] [17592186125774 #edb/ref 1065 3439 #edb/ref 17592186045417] [17592186125774 #edb/ref 1066 #uuid "d5da7d20-bcec-546d-8cd6-178215fc2096" #edb/ref 17592186045417] [17592186125774 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186125776 #edb/ref 1064 "Now consider the graph of the quadric surface\n\n$$z = x^2 -y^2$$\n\nwhose graph is shown below.\n\n![](images/5f/5f02c207742c737d00cdeabbd2cbba93a88a42521c41a2cc1e9f19d27ff55f20.png)\n\nThis surface is an example of a **hyperbolic paraboloid** whose **saddle point** is at the origin.\n\nMore generally, a hyperbolic paraboloid whose saddle point is at $(x_0,y_0,z_0)$ has the general equation $$z - z_0 = \\dfrac{(x-x_0)^2}{a^2}- \\dfrac{(y-y_0)^2}{b^2}$$\n\nwhere $a$ and $b$ constants.\n\nThis surface is called *hyperbolic* *paraboloid* because its traces in the $xy$-plane are *hyperbolas*, while its traces in the $yz$- and $xz$-planes are *parabolas*. We'll discuss the traces of this surface in more detail shortly.\n\nAnother property is that this surface mirrors itself across the planes $x=0$ and $y=0.$ Since these planes meet along the $z$-axis, that axis serves as the **axis of symmetry** of the hyperbolic paraboloid." #edb/ref 17592186045417] [17592186125776 #edb/ref 1065 3442 #edb/ref 17592186045417] [17592186125776 #edb/ref 1066 #uuid "15370709-5e87-5dcb-8a1f-ff66b0bf86e0" #edb/ref 17592186045417] [17592186125776 #edb/ref 1067 "Hyperbolic Paraboloids" #edb/ref 17592186045417] [17592186125805 #edb/ref 1064 "So far, we've encountered elliptic paraboloids whose axes of symmetry are parallel to the $z$-axis. Let's now consider the cases when an elliptic paraboloid is oriented along the $x$- or the $y$-axes.\n\nFor an elliptic paraboloid, the other two cases are as follows.\n\n- When the vertex is at the origin and the $y$ term is linear, the axis of symmetry is the $y$-axis: $$y = \\dfrac{x^2}{a^2} + \\dfrac{z^2}{c^2}$$\n\n![](images/da/da37415ddd27764a719fecc5780ee91e6e8ad3f5ce877101b81d1a955c57eb6f.png)\n- When the vertex is at the origin and the $x$ term is linear, the axis of symmetry is the $x$-axis: $$x = \\dfrac{y^2}{b^2} + \\dfrac{z^2}{c^2}$$\n\n![](images/d1/d1488d9f4767312795a84ce6441f64dd567223d1de4da66adbd6e39de9612a53.png)\n\nLikewise, for a hyperbolic paraboloid, the other two cases are as follows:\n\n- When the saddle point is at the origin and the $y$ term is linear, the axis of symmetry is the $y$-axis. The two corresponding equations are $$y = \\dfrac{x^2}{a^2} - \\dfrac{z^2}{c^2} \\qquad\\text{and}\\qquad y = \\dfrac{z^2}{c^2} - \\dfrac{x^2}{a^2}.$$\n- When the saddle point is at the origin and the $x$ term is linear, the axis of symmetry is the $x$-axis. The two corresponding equations are $$x = \\dfrac{z^2}{c^2} - \\dfrac{y^2}{b^2} \\qquad\\text{and}\\qquad x = \\dfrac{y^2}{b^2} - \\dfrac{z^2}{c^2}.$$" #edb/ref 17592186045417] [17592186125805 #edb/ref 1065 3851 #edb/ref 17592186045417] [17592186125805 #edb/ref 1066 #uuid "7f53539f-e8db-5205-b9d0-3919805097ae" #edb/ref 17592186045417] [17592186125805 #edb/ref 1067 "Alternative Orientations of the Axis of Symmetry" #edb/ref 17592186045417] [17592186125880 #edb/ref 1064 "The traces of an elliptic paraboloid are either ellipses, parabolas, a single point, or the empty set.\n\nFor example, let's find the traces with the coordinate planes for the elliptic paraboloid given by\n\n$$z=x^2+y^2.$$\n\n- The trace of this surface in the $xy$-plane (when $z=0$) is given by the equation $$\\begin{aligned}{x}^{2}+{y}^{2} & =0,\\end{aligned}$$ which corresponds to the origin $(0,0,0).$\n\n![](images/02/021dd988863021f564a0e85fb3db93030740059f2a50ade6504b3e12a5665372.png)\n\n- The trace of this surface in the $xz$-plane (when $y=0$) is given by the equation $$\\begin{aligned}{x}^{2}+{0}^{2} & =z \\\\ {x}^{2} & =z,\\end{aligned}$$ which is a parabola in the $xz$-plane that has its vertex at the origin.\n\n![](images/9f/9f6cd0703b5d7b2458cbfd688d91f08a79752fa1ccd3616e5975f5c017aa7b42.png)\n\n- The trace of this surface in the $yz$-plane (when $x=0$) is given by the equation $$\\begin{aligned}{0}^{2}+{y}^{2} & =z \\\\ {y}^{2} & =z,\\end{aligned}$$ which is a parabola in the $yz$-plane that has its vertex at the origin.\n\n![](images/89/89be283ed121d3e30b1913e4412b8d3556ed611ef2a9a9bfd686d0594409f5c9.png)\n\nThere are a few other cases we should note:\n\n- The trace of our surface with the plane $z=-k$ for $k > 0$ is the empty set. This is because $z\\geq 0$ everywhere on the elliptic paraboloid.\n- The trace of our surface with the plane $z=k$ for $k > 0$ is an ellipse: $$x^2+y^2 = k$$\n\n![](images/f1/f15e925431b0d2ccfd4afa703cad1bcb37b65a75e96fbeabcf4823703bf184e5.png)" #edb/ref 17592186045417] [17592186125880 #edb/ref 1065 7839 #edb/ref 17592186045417] [17592186125880 #edb/ref 1066 #uuid "0ea2e49f-f5aa-57b1-9b67-de6947a0e6e5" #edb/ref 17592186045417] [17592186125880 #edb/ref 1067 "Traces of Elliptic Paraboloids" #edb/ref 17592186045417] [17592186125881 #edb/ref 1064 "The traces of a hyperbolic paraboloid are either hyperbolas, parabolas, or intersecting lines.\n\nFor example, let's find the traces with the coordinate planes for the hyperbolic paraboloid given by\n\n$$z=x^2-y^2.$$\n\n- The trace of this surface in the $xy$-plane (when $z=0$) is given by the equation $$\\begin{aligned}{x}^{2}-{y}^{2} & =0 \\\\ {y}^{2} & ={x}^{2} \\\\ y & =\\pm x\\end{aligned}$$ which corresponds to two intersecting lines in the $xy$-plane.\n\n![](images/9b/9b3fbb9d8945c5d9208a59d404e489e4a339082c602c18154010e3e53083b220.png)\n\n- The trace of this surface in the $xz$-plane (when $y=0$) is given by the equation $$\\begin{aligned}{x}^{2}-{0}^{2} & =z \\\\ z & ={x}^{2},\\end{aligned}$$ which corresponds to the parabola in the $xz$-plane that has its vertex at the origin.\n\n![](images/e8/e8e2b6306052e781fd149e4eebb04da79eddb44b5261b05b129f208ad523b70b.png)\n\n- The trace of this surface in the $yz$-plane (when $x=0$) is given by the equation $$\\begin{aligned}{0}^{2}-{y}^{2} & =z \\\\ z & =-{y}^{2},\\end{aligned}$$ which corresponds to the parabola in the $yz$-plane that has its vertex at the origin.\n\n![](images/70/7010e4c26af60c6c27f66c93b805a2bac1e191c1646b5aac3a77f5dd3dadc64f.png)\n\nIn this particular case, the **saddle point** is at the origin. It is a minimum point for the trace in the $xz$-plane but a maximum point for the trace in the $yz$-plane.\n\nFinally, note that the trace of our surface with the plane $z=k\\neq 0$ is a hyperbola: $$x^2-y^2 = k$$\n\n![](images/b9/b9c1baab2f9d85c2c415cae91908d5c908aa0b1cef1eb8b5901f7f3b78bf66b2.png)" #edb/ref 17592186045417] [17592186125881 #edb/ref 1065 7840 #edb/ref 17592186045417] [17592186125881 #edb/ref 1066 #uuid "c2467f92-856a-5690-bd8d-1c593268396a" #edb/ref 17592186045417] [17592186125881 #edb/ref 1067 "Traces of Hyperbolic Paraboloids" #edb/ref 17592186045417] [17592186282051 #edb/ref 1080 "$\\sqrt{3}$ and $1$" #edb/ref 17592186045417] [17592186282051 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186282051 #edb/ref 1083 #uuid "297fea90-37a9-5380-b47a-81c1e6d84465" #edb/ref 17592186045417] [17592186282178 #edb/ref 1080 "$2\\sqrt{2}$ and $1$" #edb/ref 17592186045417] [17592186282178 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186282178 #edb/ref 1083 #uuid "3704ecec-4aab-5a7a-bf09-0c5c3fc66880" #edb/ref 17592186045417] [17592186282674 #edb/ref 1080 "(1,-3,-4)" #edb/ref 17592186045417] [17592186282674 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186282674 #edb/ref 1083 #uuid "73016fa2-ecca-594b-9202-2f6021575d7a" #edb/ref 17592186045417] [17592186282903 #edb/ref 1080 "$9$ and $4$" #edb/ref 17592186045417] [17592186282903 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186282903 #edb/ref 1083 #uuid "8c4ec860-b6b0-5930-9174-508c8b04299f" #edb/ref 17592186045417] [17592186282918 #edb/ref 1080 "$\\sqrt{3}$ and $\\sqrt{2}$" #edb/ref 17592186045417] [17592186282918 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186282918 #edb/ref 1083 #uuid "8dd3abf6-da14-5f2d-a3c4-85c8c1e8823a" #edb/ref 17592186045417] [17592186282939 #edb/ref 1080 "(3,4,-1)" #edb/ref 17592186045417] [17592186282939 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186282939 #edb/ref 1083 #uuid "9090c86c-b4ff-5fce-87cc-c598e3bbe682" #edb/ref 17592186045417] [17592186283409 #edb/ref 1080 "(4,3,-1)" #edb/ref 17592186045417] [17592186283409 #edb/r