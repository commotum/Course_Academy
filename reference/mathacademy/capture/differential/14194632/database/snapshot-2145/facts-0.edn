86045417] [17592186284202 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186284202 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186284202 #edb/ref 1078 #edb/ref 17592186283447 #edb/ref 17592186045417] [17592186284202 #edb/ref 1079 #uuid "9bb3e580-657b-5cc5-854e-3f005e11ce16" #edb/ref 17592186045417] [17592186284459 #edb/ref 1068 #edb/ref 17592186284202 #edb/ref 17592186045417] [17592186284459 #edb/ref 1069 "q-164273" #edb/ref 17592186045417] [17592186284459 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186284459 #edb/ref 1071 "Find the saddle point of the hyperbolic paraboloid $z+4=\\frac{(x-3)^{2}}{2}-\\frac{(y+1)^{2}}{3}.$" #edb/ref 17592186045417] [17592186284459 #edb/ref 1072 #uuid "4f605c5a-bdb8-58e6-a4e2-fd64274d89f4" #edb/ref 17592186045417] [17592186284459 #edb/ref 1074 "The general equation of a hyperbolic paraboloid with a saddle point at $({x}_{0},{y}_{0},{z}_{0})$ is \n\n$$\nz-{z}_{0}=\\frac{(x-{x}_{0})^{2}}{{a}^{2}}-\\frac{(y-{y}_{0})^{2}}{{b}^{2}}.\n$$\n\nTo find the saddle point, we rewrite our equation as follows:\n\n$$\n\\begin{aligned}z+4 & =\\frac{(x-3)^{2}}{2}-\\frac{(y+1)^{2}}{3} \\\\ z-(-4) & =\\frac{(x-3)^{2}}{2}-\\frac{(y-(-1))^{2}}{4}\\end{aligned}\n$$\n\nThis gives us the equation of a hyperbolic paraboloid with a saddle point at $(3,-1,-4).$" #edb/ref 17592186045417] [17592186321391 #edb/ref 1080 "$(0,0)$ in the $xy$-plane" #edb/ref 17592186045417] [17592186321391 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186321391 #edb/ref 1083 #uuid "205d1a65-04f6-59a3-a974-5b778afaa91e" #edb/ref 17592186045417] [17592186321760 #edb/ref 1080 "$(-2,3)$ in the $xy$-plane" #edb/ref 17592186045417] [17592186321760 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186321760 #edb/ref 1083 #uuid "4dcfa493-b877-5976-8c32-70d3d57ac828" #edb/ref 17592186045417] [17592186321898 #edb/ref 1080 "$(-2,-3)$ in the $xy$-plane" #edb/ref 17592186045417] [17592186321898 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186321898 #edb/ref 1083 #uuid "5f6e9f3f-adaa-5df3-bb70-cd9f70742907" #edb/ref 17592186045417] [17592186322915 #edb/ref 1080 "$(2,-3)$ in the $xy$-plane" #edb/ref 17592186045417] [17592186322915 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186322915 #edb/ref 1083 #uuid "e24be124-29de-5243-8c6e-8306d6f59e5b" #edb/ref 17592186045417] [17592186323016 #edb/ref 1080 "$(2,3)$ in the $xy$-plane" #edb/ref 17592186045417] [17592186323016 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186323016 #edb/ref 1083 #uuid "eccdcbac-973f-5f39-80bc-76abea742d02" #edb/ref 17592186045417] [17592186323618 #edb/ref 1075 #edb/ref 17592186321391 #edb/ref 17592186045417] [17592186323618 #edb/ref 1075 #edb/ref 17592186321760 #edb/ref 17592186045417] [17592186323618 #edb/ref 1075 #edb/ref 17592186321898 #edb/ref 17592186045417] [17592186323618 #edb/ref 1075 #edb/ref 17592186322915 #edb/ref 17592186045417] [17592186323618 #edb/ref 1075 #edb/ref 17592186323016 #edb/ref 17592186045417] [17592186323618 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186323618 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186323618 #edb/ref 1078 #edb/ref 17592186321898 #edb/ref 17592186045417] [17592186323618 #edb/ref 1079 #uuid "e2f3b7e6-356f-5e12-ac50-e4c8413a78be" #edb/ref 17592186045417] [17592186323729 #edb/ref 1068 #edb/ref 17592186323618 #edb/ref 17592186045417] [17592186323729 #edb/ref 1069 "q-35930" #edb/ref 17592186045417] [17592186323729 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186323729 #edb/ref 1071 "The projection of the intersection between the elliptic paraboloid $5(x+2)^{2}+3(y+3)^{2}=z$ and the plane $z=2$  onto the $xy$-plane is an ellipse. Find the center of this ellipse." #edb/ref 17592186045417] [17592186323729 #edb/ref 1072 #uuid "04c0f5ae-99dd-5b51-8d08-843351e49a3d" #edb/ref 17592186045417] [17592186323729 #edb/ref 1074 "T