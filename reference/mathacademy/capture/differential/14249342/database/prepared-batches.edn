56-a06af878d726"] [17592186096762 :knowledge-point/questions "question-288339ac-4de2-5c41-bc2e-90c16e62e9fb"] ["question-e7d54a09-b694-5b89-8845-bc7803f20047" :question/id #uuid "e7d54a09-b694-5b89-8845-bc7803f20047"] ["question-e7d54a09-b694-5b89-8845-bc7803f20047" :question/math-academy-id "q-115899"] ["question-e7d54a09-b694-5b89-8845-bc7803f20047" :question/problem "What are the coordinates of the vertex of the parabola ${x}^{2}=8y?$"] ["question-e7d54a09-b694-5b89-8845-bc7803f20047" :question/worked-solution "The standard equation of an upward- or downward-opening parabola that has its vertex at the origin is\n\n$$\n{x}^{2}=4py,\n$$\n\nwhere $p$ is a constant.\n\nWe can rewrite the given equation as \n\n$$\n{x}^{2}=4(2)y.\n$$\n\nIt is now clear that our equation is of the standard type with $p=2.$ Therefore, our parabola has its vertex at $(0,0).$"] ["question-e7d54a09-b694-5b89-8845-bc7803f20047" :question/difficulty :question.difficulty/easy] ["answer-field-534da900-1fbe-51e4-99fb-8533ecb549b3" :answer-field/id #uuid "534da900-1fbe-51e4-99fb-8533ecb549b3"] ["answer-4d9d96ab-7956-54d4-b87d-c67431ae3cdd" :answer/id #uuid "4d9d96ab-7956-54d4-b87d-c67431ae3cdd"] ["answer-4d9d96ab-7956-54d4-b87d-c67431ae3cdd" :answer/type :answer.type/math] ["answer-4d9d96ab-7956-54d4-b87d-c67431ae3cdd" :answer/value "(0,0)"] ["answer-25577b79-20d0-5f6d-ac86-3c6642a884ef" :answer/id #uuid "25577b79-20d0-5f6d-ac86-3c6642a884ef"] ["answer-25577b79-20d0-5f6d-ac86-3c6642a884ef" :answer/type :answer.type/math] ["answer-25577b79-20d0-5f6d-ac86-3c6642a884ef" :answer/value "(0,2)"] ["answer-5cca508d-ea68-5f55-8f2d-867e6ecf6d51" :answer/id #uuid "5cca508d-ea68-5f55-8f2d-867e6ecf6d51"] ["answer-5cca508d-ea68-5f55-8f2d-867e6ecf6d51" :answer/type :answer.type/math] ["answer-5cca508d-ea68-5f55-8f2d-867e6ecf6d51" :answer/value "(0,8)"] ["answer-2a1d2d6a-4812-5cc2-8283-c1f0849d4a82" :answer/id #uuid "2a1d2d6a-4812-5cc2-8283-c1f0849d4a82"] ["answer-2a1d2d6a-4812-5cc2-8283-c1f0849d4a82" :answer/ty