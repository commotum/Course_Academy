-54cc-9ffe-bac51b895587" "answer-406c2ea3-2d53-54d0-8b54-ee986e38b7e0" "answer-dd3a08ea-21fd-5000-b8a1-a944e3f82dcf" "answer-21e21adf-8388-5eb9-9be5-b1e66c6a42be" "answer-b6636b71-c496-5f64-9118-ecd49e20ef49"] :db/ensure [:answer-field/validate]} {:db/id "answer-9a9962f6-4409-54cc-9ffe-bac51b895587" :answer/id #uuid "9a9962f6-4409-54cc-9ffe-bac51b895587" :answer/type :answer.type/math :answer/value "(0,-32)" :db/ensure [:answer/validate]} {:db/id "answer-406c2ea3-2d53-54d0-8b54-ee986e38b7e0" :answer/id #uuid "406c2ea3-2d53-54d0-8b54-ee986e38b7e0" :answer/type :answer.type/math :answer/value "(0,-8)" :db/ensure [:answer/validate]} {:db/id "answer-dd3a08ea-21fd-5000-b8a1-a944e3f82dcf" :answer/id #uuid "dd3a08ea-21fd-5000-b8a1-a944e3f82dcf" :answer/type :answer.type/math :answer/value "(0,0)" :db/ensure [:answer/validate]} {:db/id "answer-21e21adf-8388-5eb9-9be5-b1e66c6a42be" :answer/id #uuid "21e21adf-8388-5eb9-9be5-b1e66c6a42be" :answer/type :answer.type/math :answer/value "(32,0)" :db/ensure [:answer/validate]} {:db/id "answer-b6636b71-c496-5f64-9118-ecd49e20ef49" :answer/id #uuid "b6636b71-c496-5f64-9118-ecd49e20ef49" :answer/type :answer.type/math :answer/value "(8,0)" :db/ensure [:answer/validate]} {:db/id "question-e7d54a09-b694-5b89-8845-bc7803f20047" :question/id #uuid "e7d54a09-b694-5b89-8845-bc7803f20047" :question/math-academy-id "q-115899" :question/problem "What are the coordinates of the vertex of the parabola ${x}^{2}=8y?$" :question/worked-solution "The standard equation of an upward- or downward-opening parabola that has its vertex at the origin is\n\n$$\n{x}^{2}=4py,\n$$\n\nwhere $p$ is a constant.\n\nWe can rewrite the given equation as \n\n$$\n{x}^{2}=4(2)y.\n$$\n\nIt is now clear that our equation is of the standard type with $p=2.$ Therefore, our parabola has its vertex at $(0,0).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-534da900-1fbe-51e4-99fb-8533ecb549b3"] :db/ensure [:question/validate]} {:db/id 