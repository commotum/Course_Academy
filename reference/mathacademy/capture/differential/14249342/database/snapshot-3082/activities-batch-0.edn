#edb/ref 17592186375776} {:db/id #edb/ref 17592186377948} {:db/id #edb/ref 17592186394606} {:db/id #edb/ref 17592186555838} {:db/id #edb/ref 17592186555848} {:db/id #edb/ref 17592186569973} {:db/id #edb/ref 17592186570037}] :knowledge-point/title "Stating the Vertex of a Vertical Parabola Given Its Equation in Standard Form"} :step/id #uuid "b4e927c0-c142-5449-90e2-dad539818e5e" :step/math-academy-id 27755 :step/next {:db/id #edb/ref 17592186097658}} {:db/id #edb/ref 17592186097658 :step/content {:db/id #edb/ref 17592186096763 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096568 :question/id #uuid "258f64db-05c1-5314-a6d8-aa2f604f5c95" :question/math-academy-id "e-7476"} :knowledge-point/id #uuid "9e302810-8b14-5c8c-8bbb-245386a66b7c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049118}] :knowledge-point/questions [{:db/id #edb/ref 17592186097381} {:db/id #edb/ref 17592186097382} {:db/id #edb/ref 17592186250505} {:db/id #edb/ref 17592186250506} {:db/id #edb/ref 17592186250507} {:db/id #edb/ref 17592186250508} {:db/id #edb/ref 17592186354375} {:db/id #edb/ref 17592186354376} {:db/id #edb/ref 17592186377955} {:db/id #edb/ref 17592186377962} {:db/id #edb/ref 17592186394613} {:db/id #edb/ref 17592186398130} {:db/id #edb/ref 17592186440817} {:db/id #edb/ref 17592186440819} {:db/id #edb/ref 17592186555772} {:db/id #edb/ref 17592186555839} {:db/id #edb/ref 17592186570020}] :knowledge-point/title "Stating the Vertex of a Horizontal Parabola Given Its Equation in Standard Form"} :step/id #uuid "a14605b3-0857-56c3-8d01-cd9415a4c5dd" :step/math-academy-id 27756} {:db/id #edb/ref 17592186097661 :step/content {:db/id #edb/ref 17592186097876 :tutorial/content "The standard equation of a left-opening or right-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(y-k)^2 = 4p(x-h).\n$$\n\nThe standard equation of an upward-opening or downward-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(x-h)^2 = 4p(y-k).\n$$\n\nIn either case, we can immediately retrieve the parabola's vertex if we're given an equation in either of these two forms.\n\n**Note:** You might wonder why there is a $4$ in the $4p$ term. It turns out that the $4p$ term is necessary to represent a particular geometric property of the parabola, which we will learn about in the future. In this lesson, we won't do much with the value of $p,$ but it will become relevant in the future." :tutorial/id #uuid "41e07eb0-e473-5751-a42d-759ae09cbfcc" :tutorial/math-academy-id 4581 :tutorial/title "The Standard Equation of a Parabola"} :step/id #uuid "8d77ee2d-8edc-5264-aacd-0369dc3583d2" :step/math-academy-id 28200 :step/next {:db/id #edb/ref 17592186097657}}] :activity/title "The Vertex of a Parabola" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186096900}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186555897} :activity/id #uuid "0cad29d4-752e-5cc0-8c92-569e4d3b7028" :activity/scope {:db/id #edb/ref 17592186049336 :topic/id #uuid "ecb9de68-369a-5f6c-b0fd-aed6ffa5f121" :topic/math-academy-id 1128} :activity/steps [{:db/id #edb/ref 17592186555878 :step/content {:db/id #edb/ref 17592186555848 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11ba3512-eaa8-5321-aa96-abe2a946d071" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-6,-5)" :db/id #edb/ref 17592186555034} {:answer/id #uuid "81efdfb9-02a6-5ea4-a9eb-5456a31d6ea3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-5,4)" :db/id #edb/ref 17592186555299} {:answer/id #uuid "8406d667-63ff-58a4-a718-2dd90e66256a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(4,5)" :db/id #edb/ref 17592186555304} {:answer/id #uuid "95dd750a-51eb-54bf-b675-b53b71df0478" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(4,-6)" :db/id #edb/ref 17592186555359} {:answer/id #uuid "d5a81445-6e86-5d1f-baeb-5cb9f1dca3d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(4,-5)" :db/id #edb/ref 17592186555508}] :answer-field/correct {:db/id #edb/ref 17592186555508} :answer-field/id #uuid "d580fbee-d419-5754-8c6e-c8cdde3856be" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186555743}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b28f59d7-76e7-504d-aaab-0c27b75b3222" :question/math-academy-id "q-115904" :question/problem "What are the coordinates of the vertex of the parabola $(x-4)^{2}=-24(y+5)?$" :question/worked-solution "The standard equation of an upward- or downward-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(x-h)^{2}=4p(y-k),\n$$\n\nwhere $p$ is constant.\n\nWe can rewrite the given equation as\n\n$$\n\\begin{aligned}(x-4)^{2} & =4(-6)(y+5).\\end{aligned}\n$$\n\nIt is now clear that our equation is of the standard type with $p=-6.$\n\nComparing our equation with the standard equation, we can see that we have $h=4$ and $k=-5.$ Therefore, the coordinates of the vertex of the parabola are $(4,-5).$"} :step/id #uuid "0e9037ca-ed1b-570a-8dcc-c8bad6548089" :step/next {:db/id #edb/ref 17592186555930}} {:db/id #edb/ref 17592186555884 :step/content {:db/id #edb/ref 17592186250503 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35fbba24-bc01-5958-b02f-8f1663289ca1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(4,6)" :db/id #edb/ref 17592186247911} {:answer/id #uuid "4e3d3b0f-8051-53f7-b5ac-f484a6297cac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(6,5)" :db/id #edb/ref 17592186248126} {:answer/id #uuid "7c7e11fc-0af2-5c2b-ab26-1b324495451e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(6,3)" :db/id #edb/ref 17592186248519} {:answer/id #uuid "c8ed6b6d-3540-5393-931a-68ed0bdcf26a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(7,4)" :db/id #edb/ref 17592186249209} {:answer/id #uuid "db27b5fe-7899-5f10-bb52-7c3224211490" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(6,4)" :db/id #edb/ref 17592186249359}] :answer-field/correct {:db/id #edb/ref 17592186249359} :answer-field/id #uuid "9240feec-4ee5-50f4-99a5-f52ff5eb95a4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186249931}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5ec60edb-0bc5-56ff-8c1e-21f9f1162a2d" :question/math-academy-id "q-115891" :question/problem "![](images/bc/bc32c3b428a2e649c5e9ff4f9425c40cdb41ba65972953c2e1a419526878dde6.png)\n\nWhat is the vertex of the parabola shown above?" :question/worked-solution "The vertex of a right-opening parabola is the left-most point of the parabola.\n\n![](images/cd/cd9376f67191ac00f58fa74a066d69008b2d43e6743af62ee6577911374ff5eb.png)\n\nTherefore, the coordinates of the vertex are $(6,4).$"} :step/id #uuid "1de71a91-5927-5d94-a614-8888a06224ab" :step/next {:db/id #edb/ref 17592186555878}} {:db/id #edb/ref 17592186555897 :step/content {:db/id #edb/ref 17592186555838 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b92942c-8aba-5aa1-868e-af6ff0b747b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-5,6)" :db/id #edb/ref 17592186555050} {:answer/id #uuid "6332f8e1-70e3-52dc-ba10-2ad158c200d7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(5,-6)" :db/id #edb/ref 17592186555219} {:answer/id #uuid "6de35bfe-a94a-5f6f-a2a7-be882652597a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-3,-6)" :db/id #edb/ref 17592186555251} {:answer/id #uuid "98125233-946f-554a-8efb-6031235b27b4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(6,-5)" :db/id #edb/ref 17592186555364} {:answer/id #uuid "f833dfc3-dd27-5cc6-a187-eb5f1348d40e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(5,-3)" :db/id #edb/ref 17592186555615}] :answer-field/correct {:db/id #edb/ref 17592186555050} :answer-field/id #uuid "eada811c-d053-5120-a961-fe8ffd045312" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186555752}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9b1a0e36-dce4-509e-90b0-4f68fe84ad7d" :question/math-academy-id "q-84968" :question/problem "What are the coordinates of the vertex of the parabola $(x+5)^{2}=-3(y-6)?$" :question/worked-solution "The standard equation of an upward- or downward-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(x-h)^{2}=4p(y-k),\n$$\n\nwhere $p$ is constant.\n\nWe can rewrite the given equation as\n\n$$\n\\begin{aligned}(x+5)^{2} & =4(-\\frac{3}{4})(y-6).\\end{aligned}\n$$\n\nIt is now clear that our equation is of the standard type with $p=-\\frac{3}{4}.$\n\nComparing our equation with the standard equation, we can see that we have $h=-5$ and $k=6.$ Therefore, the coordinates of the vertex of the parabola are $(-5,6).$"} :step/id #uuid "3ea97b63-e85c-5154-a3c9-5557381da863" :step/next {:db/id #edb/ref 17592186555933}} {:db/id #edb/ref 17592186555930 :step/content {:db/id #edb/ref 17592186555839 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e170e66-986b-586b-aa37-931b2ef7939d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,4)" :db/id #edb/ref 17592186555252} {:answer/id #uuid "87865efc-4d97-556d-b25c-84be8a361ad0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,0)" :db/id #edb/ref 17592186555314} {:answer/id #uuid "8a02ee2b-c276-5b3b-b415-d7b395c5780c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-4,0)" :db/id #edb/ref 17592186555321} {:answer/id #uuid "90e56bb0-d61e-5cde-bde8-277de6795d05" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,-16)" :db/id #edb/ref 17592186555340} {:answer/id #uuid "f5c30631-442c-5970-930d-6fbc7ef97378" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(16,0)" :db/id #edb/ref 17592186555608}] :answer-field/correct {:db/id #edb/ref 17592186555314} :answer-field/id #uuid "38d93762-7c0b-561a-b5d6-707d86a75a3a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186555666}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9b2b25e3-0202-54b4-aedb-ceb8981dd37f" :question/math-academy-id "q-115907" :question/problem "What are the coordinates of the vertex of the parabola ${y}^{2}=16x?$" :question/worked-solution "The standard equation of a left- or right-opening parabola that has its vertex at the origin is\n\n$$\n{y}^{2}=4px,\n$$\n\nwhere $p$ is a constant.\n\nWe can rewrite the given equation as \n\n$$\n{y}^{2}=4(4)x.\n$$\n\nIt is now clear that our equation is of the standard type with $p=4.$ Therefore, our parabola has its vertex at $(0,0).$"} :step/id #uuid "c004f194-0740-5260-a541-251ce197b566"} {:db/id #edb/ref 17592186555933 :step/content {:db/id #edb/ref 17592186555772 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20e4a15a-eda1-52a1-8baa-9cdce6bed32e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-1,-\\frac{1}{2})" :db/id #edb/ref 17592186555063} {:answer/id #uuid "2718af2e-0e58-5f94-b179-4b6122d8bbc8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(1,0)" :db/id #edb/ref 17592186555083} {:answer/id #uuid "84737793-7f74-5db9-b6ff-72f64548ee3c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-2,0)" :db/id #edb/ref 17592186555306} {:answer/id #uuid "959f0371-d54d-54ee-88dc-a7c52e86bcd9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\frac{1}{2},1)" :db/id #edb/ref 17592186555355} {:answer/id #uuid "e5f0f01f-aa87-552e-8444-03f833352b21" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,-1)" :db/id #edb/ref 17592186555565}] :answer-field/correct {:db/id #edb/ref 17592186555083} :answer-field/id #uuid "8abcfe54-e8c7-5c1d-9465-cff1e4813088" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186555709}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "206046fc-72eb-5e7e-8330-c7dfc01fc134" :question/math-academy-id "q-84976" :question/problem "What are the coordinates of the vertex of the parabola ${y}^{2}=-2(x-1)?$" :question/worked-solution "The standard equation of a left- or right-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(y-k)^{2}=4p(x-h),\n$$\n\nwhere $p$ is constant.\n\nWe can rewrite the given equation as \n\n$$\n(y-0)^{2}=4(-\\frac{2}{4})(x-1),\n$$\n\nwhich simplifies to\n\n$$\n(y-0)^{2}=4(-\\frac{1}{2})(x-1).\n$$\n\nIt is now clear that our equation is of the standard type with $p=-\\frac{1}{2}.$ \n\nComparing our equation with the standard equation, we can see that we have $h=1$ and $k=0.$ Therefore, the coordinates of the vertex of the parabola are $(1,0).$"} :step/id #uuid "c7de61d8-86cc-5e37-ae5a-5f91aacc8f90" :step/next {:db/id #edb/ref 17592186555884}}] :activity/title "The Vertex of a Parabola" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186554986}]}
