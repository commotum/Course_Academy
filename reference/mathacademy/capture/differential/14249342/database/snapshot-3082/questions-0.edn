ef 17592186569823}] :answer-field/correct {:answer/id #uuid "b173c4e6-d3a3-5998-84d4-1bcdb40cef0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,2)" :db/id #edb/ref 17592186569721} :answer-field/id #uuid "e5c471f1-7322-5546-9274-391fcdaf58fb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569940}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b967fd96-33d4-527f-b0fa-13d15459432d" :question/math-academy-id "q-84973" :question/problem "What are the coordinates of the vertex of the parabola $(y-2)^{2}=24x?$" :question/worked-solution "The standard equation of a left- or right-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(y-k)^{2}=4p(x-h),\n$$\n\nwhere $p$ is constant.\n\nWe can rewrite the given equation as \n\n$$\n(y-2)^{2}=4(6)(x-0).\n$$\n\nIt is now clear that our equation is of the standard type with $p=6.$ \n\nComparing our equation with the standard equation, we can see that we have $h=0$ and $k=2.$ Therefore, the coordinates of the vertex of the parabola are $(0,2).$"}] [{:db/id #edb/ref 17592186394613 :knowledge-point/_questions [{:db/id #edb/ref 17592186096763 :knowledge-point/id #uuid "9e302810-8b14-5c8c-8bbb-245386a66b7c" :knowledge-point/title "Stating the Vertex of a Horizontal Parabola Given Its Equation in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dc4323e-c33f-535a-afd4-6c18fb62876c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{1}{4},-2)" :db/id #edb/ref 17592186394615} {:answer/id #uuid "2c600d3d-c6b3-5497-b45a-7300868b4cbd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,-2)" :db/id #edb/ref 17592186394616} {:answer/id #uuid "e2b5c9f8-a768-5571-978b-75dd487db682" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\frac{1}{4},-5)" :db/id #edb/ref 17592186394617} {:answer/id #uuid "22da317e-ddf5-5200-804d-bd894039dd72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,-\\frac{1}{4})" :db/id #edb/ref 17592186394618} {:answer/id #uuid "272006fd-58b0-5a2a-a77c-5f9c24478703" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,-5)" :db/id #edb/ref 17592186394619}] :answer-field/correct {:answer/id #uuid "272006fd-58b0-5a2a-a77c-5f9c24478703" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,-5)" :db/id #edb/ref 17592186394619} :answer-field/id #uuid "e066a708-3818-5b25-a57a-0121fdb30598" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394614}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4a1a945b-79bd-54e9-8bd1-4a820e9e7516" :question/math-academy-id "q-84974" :question/problem "What are the coordinates of the vertex of the parabola $(y+5)^{2}=-(x-2)?$" :question/worked-solution "The standard equation of a left- or right-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(y-k)^{2}=4p(x-h),\n$$\n\nwhere $p$ is constant.\n\nWe can rewrite the given equation as \n\n$$\n(y+5)^{2}=4(-\\frac{1}{4})(x-2).\n$$\n\nIt is now clear that our equation is of the standard type with $p=-\\frac{1}{4}.$ \n\nComparing our equation with the standard equation, we can see that we have $h=2$ and $k=-5.$ Therefore, the coordinates of the vertex of the parabola are $(2,-5).$"}]}
