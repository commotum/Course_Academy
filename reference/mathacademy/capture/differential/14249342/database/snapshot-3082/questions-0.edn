roblem "What are the coordinates of the vertex of the parabola ${x}^{2}=5y?$" :question/worked-solution "The standard equation of an upward- or downward-opening parabola that has its vertex at the origin is\n\n$$\n{x}^{2}=4py,\n$$\n\nwhere $p$ is a constant.\n\nWe can rewrite the given equation as \n\n$$\n{x}^{2}=4(\\frac{5}{4})y.\n$$\n\nIt is now clear that our equation is of the standard type with $p=\\frac{5}{4}.$ Therefore, our parabola has its vertex at $(0,0).$"}] [{:db/id #edb/ref 17592186377955 :knowledge-point/_questions [{:db/id #edb/ref 17592186096763 :knowledge-point/id #uuid "9e302810-8b14-5c8c-8bbb-245386a66b7c" :knowledge-point/title "Stating the Vertex of a Horizontal Parabola Given Its Equation in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "96d7183f-59e1-5f0a-8060-10be3ed37a99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186377957} {:answer/id #uuid "7a7b2f7e-cfce-5d77-891b-c98d47616293" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,1)" :db/id #edb/ref 17592186377958} {:answer/id #uuid "fb0e02ed-6634-5dfc-a53d-7f6150513d7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,0)" :db/id #edb/ref 17592186377959} {:answer/id #uuid "e5b6b0ce-bea0-5795-816e-7bcb94f04d91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,4)" :db/id #edb/ref 17592186377960} {:answer/id #uuid "a374c961-0c90-5422-8602-a632f6bdf2f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,0)" :db/id #edb/ref 17592186377961}] :answer-field/correct {:answer/id #uuid "96d7183f-59e1-5f0a-8060-10be3ed37a99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186377957} :answer-field/id #uuid "59d01746-016a-568e-88fb-2f44bf46def1" :answer-field/k