:db/id #edb/ref 17592186569875}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e7d54a09-b694-5b89-8845-bc7803f20047" :question/math-academy-id "q-115899" :question/problem "What are the coordinates of the vertex of the parabola ${x}^{2}=8y?$" :question/worked-solution "The standard equation of an upward- or downward-opening parabola that has its vertex at the origin is\n\n$$\n{x}^{2}=4py,\n$$\n\nwhere $p$ is a constant.\n\nWe can rewrite the given equation as \n\n$$\n{x}^{2}=4(2)y.\n$$\n\nIt is now clear that our equation is of the standard type with $p=2.$ Therefore, our parabola has its vertex at $(0,0).$"}] [{:db/id #edb/ref 17592186569973 :knowledge-point/_questions [{:db/id #edb/ref 17592186096762 :knowledge-point/id #uuid "67455965-c9d3-5ae8-8b56-2a58af95df0a" :knowledge-point/title "Stating the Vertex of a Vertical Parabola Given Its Equation in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21e21adf-8388-5eb9-9be5-b1e66c6a42be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(32,0)" :db/id #edb/ref 17592186569490} {:answer/id #uuid "406c2ea3-2d53-54d0-8b54-ee986e38b7e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-8)" :db/id #edb/ref 17592186569530} {:answer/id #uuid "9a9962f6-4409-54cc-9ffe-bac51b895587" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-32)" :db/id #edb/ref 17592186569690} {:answer/id #uuid "b6636b71-c496-5f64-9118-ecd49e20ef49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(8,0)" :db/id #edb/ref 17592186569734} {:answer/id #uuid "dd3a08ea-21fd-5000-b8a1-a944e3f82dcf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186569796}] :answer-field/correct {:answer/id #uuid "dd3a08ea-21fd-5000-b8a1-a944e3f82d