rd equation, we can see that we have $h=-7$ and $k=1.$ Therefore, the coordinates of the vertex of the parabola are $(-7,1).$"}] [{:db/id #edb/ref 17592186253482 :knowledge-point/_questions [{:db/id #edb/ref 17592186096711 :knowledge-point/id #uuid "61861939-69d4-5b1e-a0f0-6a1b383b775b" :knowledge-point/title "Identifying the Vertex of a Horizontal Parabola Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ed39256-683e-5ef6-a893-2ffd1ac7cfd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,0)" :db/id #edb/ref 17592186250952} {:answer/id #uuid "3bcffef7-c4e0-5618-a54c-3d0b1bd5feba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,2)" :db/id #edb/ref 17592186251053} {:answer/id #uuid "5a24d0d7-0cee-5b3c-8d59-814969cbbcad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186251294} {:answer/id #uuid "b9016ea9-a887-53a4-97d6-743534d4d445" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,0)" :db/id #edb/ref 17592186252181} {:answer/id #uuid "e8a06d70-c6d7-5b07-b5fa-a43959fc8051" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,1)" :db/id #edb/ref 17592186252588}] :answer-field/correct {:answer/id #uuid "b9016ea9-a887-53a4-97d6-743534d4d445" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,0)" :db/id #edb/ref 17592186252181} :answer-field/id #uuid "736e577a-1579-5c66-a73e-dca1bc5214d5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253011}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "054b33c1-48d0-5971-9cd6-626efbf760f9" :question/math-academy-id "q-11854" :question/problem "![](images/af/af896b