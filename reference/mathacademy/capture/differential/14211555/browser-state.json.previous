      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14211555/observations/step-q97661-cd9d755689bdb1dd9594.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/differential/14211555/observations/step-q97661-cd9d755689bdb1dd9594.png",
      "source_url": "https://mathacademy.com/tasks/14211555/topics/3402/lesson",
      "captured_at": 1792002689.9553764,
      "math_academy_id": "q-97661",
      "topic_id": "3402",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q97661",
        "placement_id": null,
