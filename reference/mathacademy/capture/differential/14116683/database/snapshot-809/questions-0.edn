:question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11324ca5-7a25-5995-b9c1-d166f76813ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨16,-1,3⟩+s⟨9,-7,2⟩+t⟨15,2,-3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186336194} {:answer/id #uuid "29c0e30f-01b0-544b-ab04-24cf15557b50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨16,-1,3⟩+s⟨5,1,-2⟩+t⟨1,11,3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186336418} {:answer/id #uuid "38aecd63-d022-58e1-a3f2-d592b96f91b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨5,1,-2⟩+s⟨16,-1,3⟩+t⟨1,11,3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186336560} {:answer/id #uuid "5e4e05a5-2028-58b3-8745-b9f305c2a037" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The plane is undefined" :db/id #edb/ref 17592186336888} {:answer/id #uuid "f37cbbb1-9cfd-5d0b-8790-c75dd0b9d27b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨1,11,3⟩+s⟨5,1,-2⟩+t⟨16,-1,3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186338159}] :answer-field/correct {:answer/id #uuid "29c0e30f-01b0-544b-ab04-24cf15557b50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨16,-1,3⟩+s⟨5,1,-2⟩+t⟨1,11,3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186336418} :answer-field/id #uuid "6e9c1f6e-eb56-5021-8bc2-47b86fdac3a7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338467}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cc807ce5-aee1-5714-82d8-8391abd01453" :question/math-academy-id "q-70978" :question/problem "Find a parametric equation of the plane that passes through the point $E(16,-1,3)$ and is parallel to the lines $r=⟨9,-7,2⟩+s⟨5,1,-2⟩$ and $r=⟨15,2,-3⟩+t⟨1,11,3⟩.$" :question/worked-solution "The direction vectors of the lines are ${v}_{1}=⟨5,1,-2⟩$ and ${v}_{2}=⟨1,11,3⟩$, respectively. These vectors are parallel to the plane but not to each other.\n\nWe also know that the point $E(16,-1,3)$ lies on the plane and its position vector is $e=⟨16,-1,3⟩.$  \n\nSo, the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =e+s{v}_{1}+t{v}_{2} \\\\ r & =⟨16,-1,3⟩+s⟨5,1,-2⟩+t⟨1,11,3⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393057 :knowledge-point/_questions [{:db/id #edb/ref 17592186119935 :knowledge-point/id #uuid "3061cb06-f57f-57c8-8821-dbd962b1e78e" :knowledge-point/title "Finding the Parametric Equation of the Plane Parallel To Two Lines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "840901d2-388a-56b4-b2ed-4aa835792fb2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨2,1,-\\frac{1}{5}⟩+s⟨-3,0,1⟩+t⟨-3,2,7⟩,\\,s,t\\in (-\\infty ,\\infty )." :db/id #edb/ref 17592186393059} {:answer/id #uuid "3a999e63-69bc-5b5b-ba4a-b3d5b35bdaf5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨-3,2,7⟩+s⟨-3,0,1⟩+t⟨2,1,-\\frac{1}{5}⟩,\\,s,t\\in (-\\infty ,\\infty )." :db/id #edb/ref 17592186393060} {:answer/id #uuid "a9567360-7eeb-5790-a68a-54789a38c8f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The plane is undefined" :db/id #edb/ref 17592186393061} {:answer/id #uuid "0abc7499-ef02-5049-b4d5-92446ade1dde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨-3,2,7⟩+s⟨3,-1,20⟩+t⟨0,3,-4⟩,\\,s,t\\in (-\\infty ,\\infty )." :db/id #edb/ref 17592186393062} {:answer/id #uuid "d56ba868-cc5e-5eb8-8190-756b44636c16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨-3,0,1⟩+s⟨-3,2,7⟩+t⟨2,1,-\\frac{1}{5}⟩,\\,s,t\\in (-\\infty ,\\infty )." :db/id #edb/ref 17592186393063}] :answer-field/correct {:answer/id #uuid "3a999e63-69bc-5b5b-ba4a-b3d5b35bdaf5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨-3,2,7⟩+s⟨-3,0,1⟩+t⟨2,1,-\\frac{1}{5}⟩,\\,s,t\\in (-\\infty ,\\infty )." :db/id #edb/ref 17592186393060} :answer-field/id #uuid "74bd7e12-82f3-5b83-88f9-1acb2c12ad74" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393058}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a1e3ae2d-0bf0-5679-8209-36898e366f4e" :question/math-academy-id "q-70981" :question/problem "Find a parametric equation of the plane that passes through the point $H(-3,2,7)$ and is parallel to the lines $r=⟨3,-1,20⟩+s⟨-3,0,1⟩$ and $r=⟨0,3,-4⟩+t⟨2,1,-\\frac{1}{5}⟩.$" :question/worked-solution "The direction vectors of the lines are ${v}_{1}=⟨-3,0,1⟩$ and ${v}_{2}=⟨2,1,-\\frac{1}{5}⟩$, respectively. These vectors are parallel to the plane but not to each other.\n\nWe also know that the point $H(-3,2,7)$ lies on the plane and its position vector is $h=⟨-3,2,7⟩.$  \n\nSo, the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =h+s{v}_{1}+t{v}_{2} \\\\ r & =⟨-3,2,7⟩+s⟨-3,0,1⟩+t⟨2,1,-\\frac{1}{5}⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}]}
