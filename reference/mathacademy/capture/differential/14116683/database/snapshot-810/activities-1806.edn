#{[{:activity/expected-seconds 660.0 :activity/first-step {:db/id #edb/ref 17592186120897} :activity/id #uuid "4a64e93c-7c38-5a2c-bcd0-c1efea32558e" :activity/scope {:db/id #edb/ref 17592186050308 :topic/id #uuid "3ec7e468-923a-5188-be34-311799abe7bd" :topic/math-academy-id 1806} :activity/steps [{:db/id #edb/ref 17592186120897 :step/content {:db/id #edb/ref 17592186121051 :tutorial/content "Any plane can be uniquely determined by a point and two non-parallel direction vectors. For example, let $\\Pi$ be the plane that passes through the point $P(1,0,2)$ and is parallel to the vectors $\\mathbf{b}= \\langle 0,3,0 \\rangle$  and $\\mathbf{c}= \\langle -1,1,1 \\rangle.$\n\n![](images/ea/ea4ce822abec2b68d2471a2787f4e045493ca43c1c6795a7e0069de80cb5adee.png)\n\nUsing the vectors $\\mathbf{b}$ and $\\mathbf{c},$ we can construct a **parametric equation** of the plane.\n\nFirst, let $R$ be any general point in the plane, with position vector $\\mathbf{r}.$ Notice that we can get from $P$ to $R$ using a linear combination of $\\mathbf{b}$ and $\\mathbf{c}$ with some (unknown for us) coefficients $s$ and $t$, as shown below.\n\n![](images/b4/b40f91c3d75f092c7b29f19770364e7518d37b64ba594a311a762ad79a950e4f.png)\n\nSo, we can write the **parametric equation** of the plane as\n\n$$\n{\\color{red}\\mathbf{r}} = \\mathbf{p}+s{\\color{blue}\\,\\mathbf{b}}+t\\,{\\color{blue}\\mathbf{c}},\n\t\\qquad s,t \\in (-\\infty,\\infty).\n$$\n\nThis formula works whenever $\\mathbf{b}$ and $\\mathbf{c}$ are not parallel.\n\nIn our case, $\\mathbf{b}$ and $\\mathbf{c}$ are indeed not parallel to each other. So, using column vector notation, the parametric equation for the plane $\\Pi$ is given by\n![](images/0d/0d40f8f87e1ed3f3bf5040e925e545169f5528f32cf8dd0052375aa560cc1381.svg)" :tutorial/id #uuid "2828346e-3bca-51a8-a6ef-a86ca7034a62" :tutorial/math-academy-id 3257 :tutorial/title "Introduction"} :step/id #uuid "9e58d46a-ae91-5ee2-88e7-83dddd91cd81" :step/math-academy-id 421992 :step/next {:db/id #edb/ref 17592186120898}} {:db/id #edb/ref 17592186120898 :step/content {:db/id #edb/ref 17592186119933 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119647 :question/id #uuid "a6fded96-287a-53ee-8b1c-dd618562b2c2" :question/math-academy-id "e-4940"} :knowledge-point/id #uuid "b02f02f1-f270-55e0-a7a9-0b729c4d82c0" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049485}] :knowledge-point/questions [{:db/id #edb/ref 17592186120234} {:db/id #edb/ref 17592186120235} {:db/id #edb/ref 17592186262902} {:db/id #edb/ref 17592186262903} {:db/id #edb/ref 17592186262904} {:db/id #edb/ref 17592186304903} {:db/id #edb/ref 17592186338858} {:db/id #edb/ref 17592186338859} {:db/id #edb/ref 17592186338860} {:db/id #edb/ref 17592186338861} {:db/id #edb/ref 17592186410898} {:db/id #edb/ref 17592186410901} {:db/id #edb/ref 17592186410902}] :knowledge-point/title "Finding the Parametric Equation of the Plane Parallel To Two Given Vectors"} :step/id #uuid "9f747cb6-7704-53df-bc68-9a201f538aa3" :step/math-academy-id 421993 :step/next {:db/id #edb/ref 17592186120899}} {:db/id #edb/ref 17592186120899 :step/content {:db/id #edb/ref 17592186119934 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119664 :question/id #uuid "b86eace4-01cb-5601-8e9b-2658e81fc656" :question/math-academy-id "e-5884"} :knowledge-point/id #uuid "62196ae9-df2e-5a3a-bc0a-1c0f4c40af3e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049132}] :knowledge-point/questions [{:db/id #edb/ref 17592186120277} {:db/id #edb/ref 17592186120278} {:db/id #edb/ref 17592186262915} {:db/id #edb/ref 17592186262916} {:db/id #edb/ref 17592186311921} {:db/id #edb/ref 17592186311922} {:db/id #edb/ref 17592186311923} {:db/id #edb/ref 17592186338862} {:db/id #edb/ref 17592186338863} {:db/id #edb/ref 17592186391682} {:db/id #edb/ref 17592186410899}] :knowledge-point/title "Finding a Normal Vector To a Plane Given by Parametric Equation"} :step/id #uuid "aa340a23-a5f7-53c0-a279-cfaa2cb34f68" :step/math-academy-id 421996 :step/next {:db/id #edb/ref 17592186120900}} {:db/id #edb/ref 17592186120900 :step/content {:db/id #edb/ref 17592186119935 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119648 :question/id #uuid "297bda8f-6e33-5cc2-a2e1-5ab6186fa9d0" :question/math-academy-id "e-4941"} :knowledge-point/id #uuid "3061cb06-f57f-57c8-8821-dbd962b1e78e" :knowledge-point/questions [{:db/id #edb/ref 17592186120225} {:db/id #edb/ref 17592186120236} {:db/id #edb/ref 17592186262922} {:db/id #edb/ref 17592186338864} {:db/id #edb/ref 17592186338865} {:db/id #edb/ref 17592186338866} {:db/id #edb/ref 17592186364961} {:db/id #edb/ref 17592186387887} {:db/id #edb/ref 17592186393057} {:db/id #edb/ref 17592186398347}] :knowledge-point/title "Finding the Parametric Equation of the Plane Parallel To Two Lines"} :step/id #uuid "0b7d4f28-8841-5518-ad36-74e1aa0d9163" :step/math-academy-id 421999 :step/next {:db/id #edb/ref 17592186120901}} {:db/id #edb/ref 17592186120901 :step/content {:db/id #edb/ref 17592186121052 :tutorial/content "Any plane can be uniquely determined by three non-collinear points. \n\n![](images/08/08e65c4e3465a4bf155dfed6bc0dc2a35bf2eb9326d9bff0c0aa75b86e97d76b.png)\n\nTo write down a parametric equation of the plane, the trick is to use the three non-collinear points to construct two displacement vectors that are parallel to the plane.\n\n![](images/16/1613ea9df76b637b93e0e4b38b70b87892140398eaa7aaccb74f2a5642124dfd.png)\n\nThen we can proceed as usual to find the equation of the plane. Let's practice this technique in the following example." :tutorial/id #uuid "e32f2dc4-38f6-541d-9dc6-9cfd1ac079eb" :tutorial/math-academy-id 3258 :tutorial/title "Finding the Equation of a Plane Passing Through Three Points"} :step/id #uuid "43769a60-5b42-5a2c-82fa-0054a159b437" :step/math-academy-id 422002 :step/next {:db/id #edb/ref 17592186120902}} {:db/id #edb/ref 17592186120902 :step/content {:db/id #edb/ref 17592186119936 :knowledge-point/canonica