4}[\\frac{16}{2}-0] \\\\  & =2.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186520463 #edb/ref 1068 #edb/ref 17592186520406 #edb/ref 17592186045417] [17592186520463 #edb/ref 1069 "q-146254" #edb/ref 17592186045417] [17592186520463 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186520463 #edb/ref 1071 "$$\n\\begin{aligned}f(x,y)=\\{\\begin{aligned}2-x-y, & 0\\le x\\le 1,\\,0\\le y\\le 1, \\\\ 0, & \\text{otherwise}\\end{aligned}\\,{f}_{Y}(y)=\\{\\begin{aligned}\\frac{3}{2}-y, & 0\\le y\\le 1, \\\\ 0, & \\text{otherwise}\\end{aligned}\\end{aligned}\n$$\n\nLet $X$ and $Y$  be continuous random variables. Their joint probability density function and the marginal probability density function of $Y$ are shown above. Find the conditional expected value $\\text{E}[X\\,|\\,Y=1].$" #edb/ref 17592186045417] [17592186520463 #edb/ref 1072 #uuid "4aa42e03-e8d1-5333-8d07-d9074e34a91f" #edb/ref 17592186045417] [17592186520463 #edb/ref 1074 "Recall that the conditional expected value of $X$ given $Y=y$ is defined by\n\n$$\n\\text{E}[X\\,|\\,Y=y]={\\int }_{-\\infty }^{\\infty }x\\,{f}_{X|Y}(x\\,|\\,y)\\,\\text{d}x.\n$$\n\nNote that $\\text{E}[X\\,|\\,Y=y]$ is a function of $y.$ \n\nThe conditional density function of $X$ given $Y=y$ can be computed as \n\n$$\n\\begin{aligned}{f}_{X|Y}(x\\,|\\,y) & =\\frac{f(x,y)}{{f}_{Y}(y)} \\\\  & =\\frac{(2-x-y)}{(\\frac{3}{2}-y)} \\\\  & =\\frac{4-2x-2y}{3-2y},\\end{aligned}\n$$\n\nwhere $0\\le x\\le 1,\\,0\\le y\\le 1.$ Outside this domain, we have ${f}_{X|Y}(x\\,|\\,y)=0.$\n\nNow, substituting $y=1$ into the expression for ${f}_{X|Y}(x\\,|\\,y),$ we get\n\n$$\n{f}_{X|Y}(x\\,|\\,1)=\\frac{4-2x-2\\cdot 1}{3-2\\cdot 1}=\\frac{4-2x-2}{3-2}=2-2x.\n$$\n\nTherefore, using the definition of the conditional expectation above, we obtain \n\n$$\n\\begin{aligned}\\text{E}[X\\,|\\,Y=1] & ={\\int }_{-\\infty }^{\\infty }x\\,{f}_{X|Y}(x\\,|\\,1)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}x(2-2x)\\text{d}x \\\\  & ={\\int }_{0}^{1}(2x-2{x}^{2})\\text{d}x \\\\  & ={[{x}^{2}-\\frac{2{x}^{3}}{3}]}_{0}^{1} \\\\  & =(1-\\frac{2}{3})-0 \\\\  & =\\frac{1}{3}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186520464 #edb/ref 1068 #edb/ref 17592186520384 #edb/ref 17592186045417] [17592186520464 #edb/ref 1069 "q-146520" #edb/ref 17592186045417] [17592186520464 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186520464 #edb/ref 1071 "$$\n\\begin{aligned}f(x,y)=\\{\\begin{aligned}\\frac{6{x}^{2}+6y}{5}, & \\,0\\le x\\le 1,\\,0<y<1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\\,{f}_{Y}(y)=\\{\\begin{aligned}\\frac{6y+2}{5}, & 0\\le y\\le 1 \\\\ 0, & \\text{otherwise}\\end{aligned}\\end{aligned}\n$$\n\nLet $X$ and $Y$  be continuous random variables. Their joint probability density function and the marginal probability density function of $Y$ are shown above. Find the expression for the conditional expected value $\\text{E}[X\\,|\\,Y=y]$ for $0<y<1.$" #edb/ref 17592186045417] [17592186520464 #edb/ref 1072 #uuid "4c1f6156-411f-54e4-bb68-bbf84af25120" #edb/ref 17592186045417] [17592186520464 #edb/ref 1074 "Recall that the conditional expected value of $X$ given $Y=y$ is defined by\n\n$$\n\\text{E}[X\\,|\\,Y=y]={\\int }_{-\\infty }^{\\infty }x\\,{f}_{X|Y}(x\\,|\\,y)\\,\\text{d}x.\n$$\n\nNote that $\\text{E}[X\\,|\\,Y=y]$ is a function of $y.$ \n\nThe conditional density function of $X$ given $X=x$ can be computed as \n\n$$\n\\begin{aligned}{f}_{X|Y}(x\\,|\\,y) & =\\frac{f(x,y)}{{f}_{Y}(y)} \\\\  & =\\frac{(\\frac{6{x}^{2}+6y}{5})}{(\\frac{6y+2}{5})} \\\\  & =\\frac{6{x}^{2}+6y}{6y+2},\\end{aligned}\n$$\n\nwhere $0\\le x\\le 1,\\,0\\le y\\le 1.$ Outside this domain, we have ${f}_{Y|X}(y\\,|\\,x)=0.$ \n\nTherefore, using the definition of the conditional expectation above, we obtain \n\n$$\n\\begin{aligned}\\text{E}[X\\,|\\,Y=y] & ={\\int }_{-\\infty }^{\\infty }x\\,{f}_{X|Y}(x\\,|\\,y)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}x\\cdot \\,\\frac{6{x}^{2}+6y}{6y+2}\\,\\text{d}x \\\\  & =\\frac{6}{6y+2}{\\int }_{0}^{1}({x}^{3}+xy)\\,\\text{d}x \\\\  & =\\frac{6}{6y+2}{[\\frac{{x}^{4}}{4}+\\frac{{x}^{2}y}{2}]}_{0}^{1} \\\\  & =\\frac{6}{6y+2}[\\frac{1}{4}+\\frac{y}{2}-0] \\\\  & =\\frac{6}{6y+2}\\cdot \\frac{1+2y}{4} \\\\  & =\\frac{6}{2(3y+1)}\\cdot \\frac{(1+2y)}{4} \\\\  & =\\frac{3(1+2y)}{4(3y+1)}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186520466 #edb/ref 1068 #edb/ref 17592186520435 #edb/ref 17592186045417] [17592186520466 #edb/ref 1069 "q-146538" #edb/ref 17592186045417] [17592186520466 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186520466 #edb/ref 1071 "$$\n\\begin{aligned}f(x,y)=\\{\\begin{aligned}\\frac{2(x+2y)}{3}, & \\,0\\le x\\le 1,\\,0\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\\,{f}_{Y}(y)=\\{\\begin{aligned}\\frac{1+4y}{3}, & 0\\le y\\le 1 \\\\ 0, & \\text{otherwise}\\end{aligned}\\end{aligned}\n$$\n\nLet $X$ and $Y$  be continuous random variables. Their joint probability density function and the marginal probability density function of $Y$ are shown above. Find the expression for the conditional expected value $\\text{E}[X\\,|\\,Y=y]$ for $0\\le y\\le 1.$" #edb/ref 17592186045417] [17592186520466 #edb/ref 1072 #uuid "5142c769-0ab4-5c62-90f2-d5f937ec0c66" #edb/ref 17592186045417] [17592186520466 #edb/ref 1074 "Recall that the conditional expected value of $X$ given $Y=y$ is defined by\n\n$$\n\\text{E}[X\\,|\\,Y=y]={\\int }_{-\\infty }^{\\infty }x\\,{f}_{X|Y}(x\\,|\\,y)\\,\\text{d}x.\n$$\n\nNote that $\\text{E}[X\\,|\\,Y=y]$ is a function of $y.$ \n\nThe conditional density function of $X$ given $X=x$ can be computed as \n\n$$\n\\begin{aligned}{f}_{X|Y}(x\\,|\\,y) & =\\frac{f(x,y)}{{f}_{Y}(y)} \\\\  & =\\frac{(\\frac{2(x+2y)}{3})}{(\\frac{1+4y}{3})} \\\\  & =\\frac{2(x+2y)}{1+4y},\\end{aligned}\n$$\n\nwhere $0\\le x\\le 1,\\,0\\le y\\le 1.$ Outside this domain, we have ${f}_{Y|X}(y\\,|\\,x)=0.$ \n\nTherefore, using the definition of the conditional expectation above, we obtain \n\n$$\n\\begin{aligned}\\text{E}[X\\,|\\,Y=y] & ={\\int }_{-\\infty }^{\\infty }x\\,{f}_{X|Y}(x\\,|\\,y)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}x\\cdot \\,\\frac{2(x+2y)}{1+4y}\\,\\text{d}x \\\\  & =\\frac{2}{1+4y}{\\int }_{0}^{1}({x}^{2}+2yx)\\,\\text{d}x \\\\  & =\\frac{2}{1+4y}{[\\frac{{x}^{3}}{3}+y{x}^{2}]}_{0}^{1} \\\\  & =\\frac{2}{1+4y}\\cdot [\\frac{1}{3}+y-0] \\\\  & =\\frac{2}{1+4y}\\cdot \\frac{1+3y}{3} \\\\  & =\\frac{2(1+3y)}{3(1+4y)}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186520474 #edb/ref 1068 #edb/ref 17592186520381 #edb/ref 17592186045417] [17592186520474 #edb/ref 1069 "q-146397" #edb/ref 17592186045417] [17592186520474 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186520474 #edb/ref 1071 "$$\n\\begin{aligned}f(x,y)=\\{\\begin{aligned}\\frac{3x{y}^{2}}{4}, & 0\\le y\\le 2,\\,0<x<1 \\\\ 0, & \\text{otherwise}\\end{aligned}\\,{f}_{X}(x)=\\{\\begin{aligned}2x, & 0<x<1 \\\\ 0, & \\text{otherwise}\\end{aligned}\\end{aligned}\n$$\n\nLet $X$ and $Y$  be continuous random variables. Their joint probability density function and the marginal probability density function of $X$ are shown above. Find the expression for the conditional expected value $\\text{E}[Y\\,|\\,X=x]$ for $0<x<1.$" #edb/ref 17592186045417] [17592186520474 #edb/ref 1072 #uuid "7abac60c-426c-5228-9bff-bdb217864577" #edb/ref 17592186045417] [17592186520474 #edb/ref 1074 "Recall that the conditional expected value of $Y$ given $X=x$ is defined by\n\n$$\n\\text{E}[Y\\,|\\,X=x]={\\int }_{-\\infty }^{\\infty }y\\,{f}_{Y|X}(y\\,|\\,x)\\,\\text{d}y.\n$$\n\nNote that $\\text{E}[Y\\,|\\,X=x]$ is a function of $x.$ \n\nThe conditional density function of $Y$ given $X=x$ can be computed as \n\n$$\n\\begin{aligned}{f}_{Y|X}(y\\,|\\,x) & =\\frac{f(x,y)}{{f}_{X}(x)} \\\\  & =\\frac{(\\frac{3x{y}^{2}}{4})}{2x} \\\\  & =\\frac{3{y}^{2}}{8},\\end{aligned}\n$$\n\nwhere $0\\le y\\le 2,\\,0<x<1.$ Outside this domain, we have ${f}_{Y|X}(y\\,|\\,x)=0.$ \n\nTherefore, using the definition of the conditional expectation above, we obtain \n\n$$\n\\begin{aligned}\\text{E}[Y\\,|\\,X=x] & ={\\int }_{-\\infty }^{\\infty }y\\,{f}_{Y|X}(y\\,|\\,x)\\,\\text{d}y \\\\  & ={\\int }_{0}^{2}y\\cdot \\,\\frac{3{y}^{2}}{8}\\,\\text{d}y \\\\  & =\\frac{3}{8}{\\int }_{0}^{2}{y}^{3}\\,\\text{d}y \\\\  & =\\frac{3}{8}{[\\frac{{y}^{4}}{4}]}_{0}^{2} \\\\  & =\\frac{3}{8}[4-0] \\\\  & =\\frac{3}{8}\\cdot 4 \\\\  & =\\frac{3}{2}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186520489 #edb/ref 1068 #edb/ref 17592186520421 #edb/ref 17592186045417] [17592186520489 #edb/ref 1069 "q-146177" #edb/ref 17592186045417] [17592186520489 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186520489 #edb/ref 1071 "$$\n{f}_{X\\,|\\,Y}(x\\,|\\,3)=\\{\\begin{aligned}\\frac{3{x}^{2}}{8}, & \\,\\,0\\le x\\le 2 \\\\ 0, & \\,\\,\\text{otherwise}\\end{aligned}\n$$\n\n \n\nLet $X$ and $Y$ be continuous random variables. \nFind the conditional expected value $\\text{E}[X\\,|\\,Y=3]$ given that the conditional probability density function ${f}_{X|Y}(x\\,|\\,3)$ is shown above." #edb/ref 17592186045417] [17592186520489 #edb/ref 1072 #uuid "a3d747d1-36eb-5ac7-aecf-ff0858227dfd" #edb/ref 17592186045417] [17592186520489 #edb/ref 1074 "Recall that the conditional expected value of $X$ given $Y=y$ is defined by\n\n$$\n\\text{E}[X\\,|\\,Y=y]={\\int }_{-\\infty }^{\\infty }x\\,{f}_{X|Y}(x\\,|\\,y)\\,\\text{d}x.\n$$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}\\text{E}[X\\,|\\,Y=3] & ={\\int }_{-\\infty }^{\\infty }x\\,{f}_{X|Y}(x\\,|\\,3)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}x\\cdot \\frac{3{x}^{2}}{8}\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}\\frac{3{x}^{3}}{8}\\,\\text{d}x \\\\  & ={[\\frac{3{x}^{4}}{32}]}_{0}^{2} \\\\  & =\\frac{48}{32}-\\frac{0}{32} \\\\  & =\\frac{3}{2}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186520491 #edb/ref 1068 #edb/ref 17592186520429 #edb/ref 17592186045417] [17592186520491 #edb/ref 1069 "q-146253" #edb/ref 17592186045417] [17592186520491 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186520491 #edb/ref 1071 "$$\n\\begin{aligned}f(x,y)=\\{\\begin{aligned}\\frac{2x+3y}{12}, & 1\\le x\\le 2,\\,0\\le y\\le 2, \\\\ 0, & \\text{otherwise}\\end{aligned}\\,{f}_{Y}(y)=\\{\\begin{aligned}\\frac{y+1}{4}, & 0\\le y\\le 2, \\\\ 0, & \\text{otherwise}\\end{aligned}\\end{aligned}\n$$\n\nLet $X$ and $Y$  be continuous random variables. Their joint probability density function and the marginal probability density function of $Y$ are shown above. Find the conditional expected value $\\text{E}[X\\,|\\,Y=1].$" #edb/ref 17592186045417] [17592186520491 #edb/ref 1072 #uuid "b25c780b-4145-5bfa-8e04-0856e9d67d3a" #edb/ref 17592186045417] [17592186520491 #edb/ref 1074 "Recall that the conditional expected value of $X$ given $Y=y$ is defined by\n\n$$\n\\text{E}[X\\,|\\,Y=y]={\\int }_{-\\infty }^{\\infty }x\\,{f}_{X|Y}(x\\,|\\,y)\\,\\text{d}x.\n$$\n\nNote that $\\text{E}[X\\,|\\,Y=y]$ is a function of $y.$ \n\nThe conditional density function of $X$ given $Y=y$ can be computed as \n\n$$\n\\begin{aligned}{f}_{X|Y}(x\\,|\\,y) & =\\frac{f(x,y)}{{f}_{Y}(y)} \\\\  & =\\frac{(\\frac{2x+3y}{12})}{(\\frac{y+1}{4})} \\\\  & =\\frac{2x+3y}{3y+3},\\end{aligned}\n$$\n\nwhere $1\\le x\\le 2,\\,0\\le y\\le 2.$ Outside this domain, we have ${f}_{X|Y}(x\\,|\\,y)=0.$\n\nNow, substituting $y=1$ into the expression for ${f}_{X|Y}(x\\,|\\,y),$ we get\n\n$$\n{f}_{X|Y}(x\\,|\\,1)=\\frac{2x+3\\cdot 1}{3\\cdot 1+3}=\\frac{2x+3}{6}.\n$$\n\nTherefore, using the definition of the conditional expectation above, we obtain \n\n$$\n\\begin{aligned}\\text{E}[X\\,|\\,Y=1] & ={\\int }_{-\\infty }^{\\infty }x\\,{f}_{X|Y}(x\\,|\\,1)\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}x\\cdot \\frac{2x+3}{6}\\text{d}x \\\\  & =\\frac{1}{6}{\\int }_{1}^{2}(2{x}^{2}+3x)\\text{d}x \\\\  & =\\frac{1}{6}{[\\frac{2{x}^{3}}{3}+\\frac{3{x}^{2}}{2}]}_{1}^{2} \\\\  & =\\frac{1}{6}((\\frac{16}{3}+6)-(\\frac{2}{3}+\\frac{3}{2})) \\\\  & =\\frac{55}{36}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186520492 #edb/ref 1068 #edb/ref 17592186520443 #edb/ref 17592186045417] [17592186520492 #edb/ref 1069 "q-146360" #edb/ref 17592186045417] [17592186520492 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186520492 #edb/ref 1071 "$$\n\\begin{aligned}f(x,y)=\\{\\begin{aligned}8xy, & 0<x\\le 1,\\,\\,0\\le y\\le x, \\\\ 0, & \\text{otherwise}\\end{aligned}\\,{f}_{X}(x)=\\{\\begin{aligned}4{x}^{3}, & 0<x\\le 1 \\\\ 0, & \\text{otherwise}\\end{aligned}\\end{aligned}\n$$\n\nLet $X$ and $Y$  be continuous random variables. Their joint probability density function and the marginal probability density function of $X$ are shown above. Find the conditional expected value $\\text{E}[Y\\,|\\,X=1].$" #edb/ref 17592186045417] [17592186520492 #edb/ref 1072 #uuid "b86ab1d5-8833-598a-9757-b29ccf7f9acc" #edb/ref 17592186045417] [17592186520492 #edb/ref 1074 "Recall that the conditional expected value of $Y$ given $X=x$ is defined by\n\n$$\n\\text{E}[Y\\,|\\,X=x]={\\int }_{-\\infty }^{\\infty }y\\,{f}_{Y|X}(y\\,|\\,x)\\,\\text{d}y.\n$$\n\nNote that $\\text{E}[Y\\,|\\,X=x]$ is a function of $x.$ \n\nThe conditional density function of $Y$ given $X=x$ can be computed as \n\n$$\n\\begin{aligned}{f}_{Y|X}(y\\,|\\,x) & =\\frac{f(x,y)}{{f}_{X}(x)} \\\\  & =\\frac{8xy}{4{x}^{3}} \\\\  & =\\frac{2y}{{x}^{2}},\\end{aligned}\n$$\n\n \n\nwhere $0<x\\le 1,\\,0<y\\le x.$ Outside this domain, we have ${f}_{Y|X}(y\\,|\\,x)=0.$    \n\nNow, substituting $x=1$ into the expression for ${f}_{Y|X}(y\\,|\\,x),$ we get\n\n$$\n{f}_{Y|X}(y\\,|1\\,)=2y.\n$$\n\nTherefore, using the definition of the conditional expectation above, we obtain \n\n$$\n\\begin{aligned}\\text{E}[Y\\,|\\,X=1] & ={\\int }_{-\\infty }^{\\infty }y\\,{f}_{Y|X}(y\\,|\\,1)\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}y\\cdot (2y)\\text{d}y \\\\  & ={\\int }_{0}^{1}(2{y}^{2})\\text{d}y \\\\  & ={[\\frac{2{y}^{3}}{3}]}_{0}^{1} \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186520503 #edb/ref 1068 #edb/ref 17592186520400 #edb/ref 17592186045417] [17592186520503 #edb/ref 1069 "q-146180" #edb/ref 17592186045417] [17592186520503 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186520503 #edb/ref 1071 "$$\n{f}_{Y\\,|\\,X}(y\\,|\\,1)=\\{\\begin{aligned}\\frac{1+{y}^{2}}{12}, & \\,\\,0\\le y\\le 3 \\\\ 0, & \\,\\,\\text{otherwise}\\end{aligned}\n$$\n\n \n\nLet $X$ and $Y$ be continuous random variables. \nFind the conditional expected value $\\text{E}[Y\\,|\\,X=1]$ given that the conditional probability density function ${f}_{Y|X}(y\\,|\\,1)$ is shown above." #edb/ref 17592186045417] [17592186520503 #edb/ref 1072 #uuid "db6164d4-0ab9-5b8d-a944-50886d9aea3b" #edb/ref 17592186045417] [17592186520503 #edb/ref 1074 "Recall that the conditional expected value of $Y$ given $X=x$ is defined by\n\n$$\n\\text{E}[Y\\,|\\,X=x]={\\int }_{-\\infty }^{\\infty }y\\,{f}_{Y|X}(y\\,|\\,x)\\,\\text{d}y.\n$$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}\\text{E}[Y\\,|\\,X=1] & ={\\int }_{-\\infty }^{\\infty }y\\,{f}_{Y|X}(y\\,|\\,1)\\,\\text{d}y \\\\  & ={\\int }_{0}^{3}y\\cdot \\frac{1+{y}^{2}}{12}\\,\\text{d}y \\\\  & =\\frac{1}{12}{\\int }_{0}^{3}(y+{y}^{3})\\,\\text{d}y \\\\  & =\\frac{1}{12}{[\\frac{{y}^{2}}{2}+\\frac{{y}^{4}}{4}]}_{0}^{3} \\\\  & =\\frac{1}{48}(99-0) \\\\  & =\\frac{33}{16}.\\end{aligned}\n$$" #edb/ref 17592186045417]}
