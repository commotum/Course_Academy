#{[{:activity/first-step {:db/id #edb/ref 17592186163099} :activity/id #uuid "5ae71148-97b7-53da-9878-67b3a9acb4b2" :activity/scope {:db/id #edb/ref 17592186050965 :topic/id #uuid "7619e09a-ee66-5b0d-b62b-731fbe484a0a" :topic/math-academy-id 3057} :activity/steps [{:db/id #edb/ref 17592186163099 :step/content {:db/id #edb/ref 17592186163340 :tutorial/content "For continuous random variables $X$ and $Y$, the **conditional expectation of $X$ given $Y=y$** is defined as\n\n$$\n\\textrm E\\begin{bmatrix}X & Y = y\\end{bmatrix} =\\int\\limits_{\\mathbb R} x \\, f_{X\\mid Y}(x \\mid y)\\;\\textrm dx\n$$\n\nwhere $f_{X\\mid Y}(x \\mid y)$ is the conditional probability density function of $X$ given $Y$.\n\nThis definition is similar to that of $\\textrm{E}[X]$. However, we now use the conditional PDF $f_{X\\mid Y}(x \\mid y)$ instead of the marginal PDF $f_X(x)$ in our integral.\n\nNote the following:\n\n- When we select a particular value of $y$, the conditional expected value of $X$ given $Y=y$ returns a real number. However, if $y$ is not specified, i.e., $\\textrm{E}\\begin{bmatrix}X & Y = y\\end{bmatrix}$ *depends* on $y$, we have that $\\textrm{E}\\begin{bmatrix}X & Y = y\\end{bmatrix}$ gives us a *function* of $y$.\n- If $X$ and $Y$ are independent, then $\\textrm E\\begin{bmatrix}X & Y = y\\end{bmatrix} = \\textrm E[X]$ for all $y$.\n- We sometimes use the notation $\\mu_{X \\mid y}$ to denote $E\\begin{bmatrix}X & Y = y\\end{bmatrix}$.\n- We have an analogous definition for $\\textrm E\\begin{bmatrix}Y & X = x\\end{bmatrix}$:\n$\\textrm E\\begin{bmatrix}Y & X = x\\end{bmatrix} =\\displaystyle \\int\\limits_{\\mathbb R} y \\, f_{Y\\mid X}(y \\mid x)\\;\\textrm dy$,\nwhere $f_{Y\\mid X}(y \\mid x)$ is the conditional probability density function of $Y$ given $X$." :tutorial/id #uuid "9640f2b9-e8e6-51dd-8c81-c7f1a9f45362" :tutorial/math-academy-id 6428 :tutorial/title "Introduction"} :step/id #uuid "282b0aa7-ba2b-5cf7-a3e4-71b3c23149c6" :step/math-academy-id 38822 :step/next {:db/id #edb/ref 17592186163127}} {:db/id #edb/ref 17592186163105 :step/content {:db/id #edb/ref 17592186162127 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161693 :question/id #uuid "2eda20ae-ff4f-5c78-abaa-2c176968e908" :question/math-academy-id "e-10311"} :knowledge-point/id #uuid "56c44f33-e6d3-5e34-9d9d-ded24576b82e" :knowledge-point/questions [{:db/id #edb/ref 17592186162416} {:db/id #edb/ref 17592186162435}] :knowledge-point/title "Calculating Conditional Expectations Given Joint and Marginal PDFs"} :step/id #uuid "a1982d74-327b-5c93-bb74-783cbc9372a2" :step/math-academy-id 38861 :step/next {:db/id #edb/ref 17592186163106}} {:db/id #edb/ref 17592186163106 :step/content {:db/id #edb/ref 17592186162128 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161694 :question/id #uuid "3de4a4e5-824f-504b-ad7c-f088dd7569fd" :question/math-academy-id "e-10315"} :knowledge-point/id #uuid "ea596df6-f52e-5347-afdd-78521b40525e" :knowledge-point/questions [{:db/id #edb/ref 17592186162414} {:db/id #edb/ref 17592186162438}] :knowledge-point/title "Conditional Expectation as a Function"} :step/id #uuid "850d0de4-ea82-55a1-8a30-8ac3203528ea" :step/math-academy-id 38877} {:db/id #edb/ref 17592186163107 :step/content {:db/id #edb/ref 17592186162129 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161695 :question/id #uuid "52bad65a-5481-5529-8e25-2763f57b755a" :question/math-academy-id "e-10316"} :knowledge-point/id #uuid "fcf85ec6-b20d-5540-a709-9ff28bc82ca6" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048872} {:db/id #edb/ref 17592186049801} {:db/id #edb/ref 17592186050535}] :knowledge-point/questions [{:db/id #edb/ref 17592186162417} {:db/id #edb/ref 17592186162427}] :knowledge-point/title "Calculating a Conditional Expectation From a Conditional PDF"} :step/id #uuid "b8bd50e9-6e43-51c0-981c-5d228ed06948" :step/math-academy-id 38880 :step/next {:db/id #edb/ref 17592186163105}} {:db/id #edb/ref 17592186163127 :step/content {:db/id #edb/ref 17592186163348 :tutorial/content "Let's find the conditional expectation\n\n$$\n\\textrm{E}\\big\\begin{bmatrix}X \\, & \\, Y=1\\big\\end{bmatrix}\n$$\n\ngiven that the conditional probability density function $f_{X\\mid Y}(x \\, \\mid \\, 1)$ is given by\n\n$$\n{2(x - 1),\\begin{vmatrix}1 \\le x \\le 2 \\\\ 0,\\end{vmatrix}otherwise\n$$\n\nApplying the formula for the conditional expectation of $X$ given $Y=y$, we have\n\n$$\n\\begin{aligned}\nE\\begin{bmatrix}X & Y = 1\\end{bmatrix} &= \\int_{- ∞}^{∞}xf_{X\\mid Y}(x \\mid 1)dx \\\\\n&= \\int_{1}^{2}x \\cdot 2(x - 1)dx \\\\\n&= \\int_{1}^{2}2x(x - 1)dx \\\\\n&= \\int_{1}^{2}2x^{2} - 2xdx \\\\\n&= [\\frac{2x^{3}}{3} - x^{2}]_{1}^{2} \\\\\n&= [(2(2)^{3})/(3) - (2)^{2}] - [(2(1)^{3})/(3) - (1)^{2}] \\\\\n&= [\\frac{16}{3} - 4] - [\\frac{2}{3} - 1] \\\\\n&= [\\frac{16}{3} - \\frac{12}{3}] - [\\frac{2}{3} - \\frac{3}{3}] \\\\\n&= \\frac{4}{3} - (-\\frac{1}{3}) \\\\\n&= \\frac{5}{3}\n\\end{aligned}\n$$" :tutorial/id #uuid "8c2314f8-7929-53f2-9261-e2cc145337ae" :tutorial/math-academy-id 6481 :tutorial/title "A Worked Example"} :step/id #uuid "d7f16db2-fef5-5e1e-9727-5f6164e5f735" :step/math-academy-id 39220 :step/next {:db/id #edb/ref 17592186163107}}] :activity/title "Conditional Expectation for Continuous Random Variables" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186162193}]}
