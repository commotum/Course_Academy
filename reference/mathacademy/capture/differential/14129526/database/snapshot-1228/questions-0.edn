b/ident :answer-field.type/select} :db/id #edb/ref 17592186287554} {:answer-field/choices [{:answer/id #uuid "5ff8e0f3-186e-5b12-bf3a-8a8f15fef9fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le " :db/id #edb/ref 17592186285668} {:answer/id #uuid "7acaf994-2b2c-5a5c-b08e-017ef4750ef2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186285922}] :answer-field/correct {:answer/id #uuid "7acaf994-2b2c-5a5c-b08e-017ef4750ef2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186285922} :answer-field/id #uuid "e69002f9-65bd-5fe4-9e71-e80796938792" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186287624}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c447c7d2-83cd-503b-b04b-0c9b2bcb0661" :question/math-academy-id "q-181806" :question/problem "![](images/a6/a659e2d14a645036488833cd920e6bb3e3d7a7716724dba63814be6df4066fe9.png)\n\nDescribe the shaded region shown above using set-builder notation.\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,3\\,{{field-1}}\\,x\\,{{field-2}}\\,6,\\,-1\\,{{field-3}}\\,y\\,{{field-4}}\\,4\\}\n$$" :question/worked-solution "A point $P(x,y)$ lies *inside* the rectangle if the following conditions are satisfied:\n\n$$\n\\begin{aligned}3<x<6,\\,-1<y<4\\end{aligned}\n$$\n\nNotice that we also need to *include* the left edge ($x=3$).\n\nTherefore, we change the corresponding inequality symbol to non-strict, as follows:\n\n$$\n\\begin{aligned}3\\le x<6,\\,-1<y<4\\end{aligned}\n$$\n\nMoreover, since *every* real value in these intervals is included, $x\\in R,y\\in R,$ and therefore \n\n$$\n(x,y)\\in R\\times R={R}^{2}.\n$$\n\nTherefore, we can write our set as follows:\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,3\\le x<6,\\,-1<y<4\\}\n$$"}] [{:db/id #edb/ref 17592186287785 :knowledge-point/_questions [{:db/id #edb/ref 17592186198475 :knowledge-point/id #uuid "e694b201-5ec6-5cc3-a608-2447d1cc1ed3" :knowledge-point/title "Linear Boundaries, One Condition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "67c5354f-f81a-5735-b30c-8d374200da33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186285737} {:answer/id #uuid "7ba8f101-0df2-5e90-b767-a42f8a80224f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ne " :db/id #edb/ref 17592186285930} {:answer/id #uuid "96f6a92a-ed14-528c-9d56-6c9f3d1b4591" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ge " :db/id #edb/ref 17592186286161} {:answer/id #uuid "fbaa6a44-10da-5359-8169-9a712531f657" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186287085} {:answer/id #uuid "fef103a7-a0fd-5d78-9b96-0fa21cb3ba83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le " :db/id #edb/ref 17592186287125}] :answer-field/correct {:answer/id #uuid "fbaa6a44-10da-5359-8169-9a712531f657" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186287085} :answer-field/id #uuid "b681dfc3-5ddb-5fe1-91dd-a44d58b2ca04" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186287528} {:answer-field/choices [{:answer/id #uuid "11cedf92-5a30-5459-bcac-1b702d7ca58a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R" :db/id #edb/ref 17592186284944} {:answer/id #uuid "160a7c27-3f04-5e91-920b-d142d778d2fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Z" :db/id #edb/ref 17592186284986} {:answer/id #uuid "6b1276ff-201c-5efa-8f55-37cad7561288" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{2}" :db/id #edb/ref 17592186285769} {:answer/id #uuid "bff1414a-7373-5b39-b4de-9d4bbad9f3ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{N}^{2}" :db/id #edb/ref 17592186286544} {:answer/id #uuid "e2c21149-b51b-5c5a-a0e0-3d426aa0c537" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "N" :db/id #edb/ref 17592186286852} {:answer/id #uuid "ee3658c3-81e8-5ecc-aea4-f0acc0e2855c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{Z}^{2}" :db/id #edb/ref 17592186286972}] :answer-field/correct {:answer/id #uuid "ee3658c3-81e8-5ecc-aea4-f0acc0e2855c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{Z}^{2}" :db/id #edb/ref 17592186286972} :answer-field/id #uuid "fec77e96-3956-5e7b-8e39-d6e53fb9e67a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186287664}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dfc3e0f0-9ab6-551c-8d47-c8fca0b2295d" :question/math-academy-id "q-181988" :question/problem "![](images/34/34f5bb40fdcd4f71967ef2b1cc15328cf8d4d02cdd54b19a406273fae6c88ad4.png)\n\nDescribe the shaded region shown above using set-builder notation.\n\n$$\n\\{(x,y)\\in {{field-1}}\\,:\\,y\\,{{field-2}}\\,-x-1\\}\n$$" :question/worked-solution "Since all points $P(x,y)$ in our set lie at integer values of $x$ and $y,$ we have $x\\in Z,y\\in Z,$ and therefore \n\n$$\n(x,y)\\in Z\\times Z={Z}^{2}.\n$$\n\nThe points in our set include all those that lie *above* the line $y=-x-1.$ For those points, the following condition is satisfied:\n\n$$\ny>-x-1\n$$\n\nSince the boundary is *not* included in the set (the curve is *not* solid),  no further action must be taken, so we have\n\n$$\ny>-x-1.\n$$\n\nTherefore, we can write the set as follows:\n\n$$\n\\{(x,y)\\in {Z}^{2}\\,:\\,y>-x-1\\}\n$$"}] [{:db/id #edb/ref 17592186287790 :knowledge-point/_questions [{:db/id #edb/ref 17592186198475 :knowledge-point/id #uuid "e694b201-5ec6-5cc3-a608-2447d1cc1ed3" :knowledge-point/title "Linear Boundaries, One Condition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d32fcf7-f956-579e-bd12-582e2a8e1218" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ne " :db/id #edb/ref 17592186285188} {:answer/id #uuid "8380f9b1-920d-5146-839d-4b75e2f43ca2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186285996} {:answer/id #uuid "d3d0529c-dab6-51e3-9c14-4b29bf91f5fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186286714} {:answer/id #uuid "e6cb933e-eef2-5fbf-b5cf-aa05874b4c95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le " :db/id #edb/ref 17592186286899} {:answer/id #uuid "e92e2838-a3f7-5ff3-a899-3e77a31053e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ge " :db/id #edb/ref 17592186286920}] :answer-field/correct {:answer/id #uuid "e92e2838-a3f7-5ff3-a899-3e77a31053e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ge " :db/id #edb/ref 17592186286920} :answer-field/id #uuid "b1c12478-b402-5f5d-b4da-66a564ce341e" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186287517} {:answer-field/choices [{:answer/id #uuid "38812c8c-b3a5-564b-b650-983576d4442a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{2}" :db/id #edb/ref 17592186285315} {:answer/id #uuid "66d676e1-0e6e-5f12-b840-c7214f77aef8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R" :db/id #edb/ref 17592186285723} {:answer/id #uuid "d06de7c4-b859-548f-af13-4ddc486c2944" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "C" :db/id #edb/ref 17592186286685} {:answer/id #uuid "dca2758b-df2c-54f7-9ccf-9a8e5f9528f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{C}^{2}" :db/id #edb/ref 17592186286797}] :answer-field/correct {:answer/id #uuid "38812c8c-b3a5-564b-b650-983576d4442a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{2}" :db/id #edb/ref 17592186285315} :answer-field/id #uuid "dbc6ba57-bdbf-5460-a5b9-e829e1bd1802" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186287597}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "49192157-aea0-5727-927f-dcfccbbb5607" :question/math-academy-id "q-182013" :question/problem "![](images/77/7703b8c621b268a9fcbb412cd3a0617045145d475024dc91cecfa09a18fc8712.png)\n\nDescribe the shaded region shown above using set-builder notation.\n\n$$\n\\{(x,y)\\in {{field-1}}\\,:\\,x\\,{{field-2}}\\,-2\\}\n$$" :question/worked-solution "The points in our set include all those that lie *right* the line $x=-2.$\n\nTherefore, a point $P(x,y)$ lies *inside* the shaded region if the following condition is satisfied:\n\n$$\nx>-2\n$$\n\nWe must also include the line $x=-2$ since the boundary is included in the set (the curve is solid). So, we change the inequality symbol above as follows:\n\n$$\nx\\ge -2\n$$\n\nMoreover, since we're considering *every* real value in this region, $x\\in R,y\\in R,$ and therefore \n\n$$\n(x,y)\\in R\\times R={R}^{2}.\n$$\n\nTherefore, we can write the set as\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,x\\ge -2\\}.\n$$"}]