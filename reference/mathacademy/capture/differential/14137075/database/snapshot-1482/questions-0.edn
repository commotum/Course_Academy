#{[{:db/id #edb/ref 17592186124197 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186124639 :knowledge-point/id #uuid "53c5d5d7-40d4-5210-8794-428cffc1f3f9" :knowledge-point/title "Finding Partial Derivatives of Two-Variable Functions"}] :question/id #uuid "35a664b8-a895-5c52-a92f-b62c75b44744" :question/math-academy-id "e-11026" :question/problem "Find $\\dfrac{\\partial f}{\\partial y}$ given that $f(x,y) = 3x\\ln y + 2ye^x.$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants.\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}(3x\\operatorname{ln}⁡y+2y{e}^{x}) \\\\  & =\\frac{∂}{∂y}(3x\\operatorname{ln}⁡y)+\\frac{∂}{∂y}(2y{e}^{x}) \\\\  & =3x\\cdot \\frac{∂}{∂y}(\\operatorname{ln}⁡y)+2{e}^{x}\\cdot \\frac{∂}{∂y}(y) \\\\  & =3x\\cdot \\frac{1}{y}+2{e}^{x}\\cdot 1 \\\\  & =\\frac{3x}{y}+2{e}^{x}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186124201 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186124643 :knowledge-point/id #uuid "59c3f441-0499-575c-af10-b597d61e6e35" :knowledge-point/title "Partial Derivatives as Limits of Difference Quotients"}] :question/id #uuid "a14d53ae-1922-531d-bb2a-bda9b4829f6e" :question/math-academy-id "e-11045" :question/problem "Given that $f(x,y) = y^2\\ln{x},$ express $\\dfrac{\\partial f}{\\partial x}$ as the limit of a difference quotient." :question/worked-solution "The partial derivative of $f$ with respect to $x$ is given by the limit \n\n$$\n\\dfrac{\\partial f}{\\partial x} = \\lim_{h \\to 0} \\left(\\dfrac{f(x+h,y)-f(x,y)}{h}\\right).\n$$\n\nSince $f(x) = y^2 \\ln{x},$  we have that \n\n$$\nf(x+h,y) = y^2\\ln(x+h).\n$$\n\nTherefore,\n\n$$\n\\displaystyle \\dfrac{\\partial f}{\\partial x} = \\lim_{h \\to 0}\\left( \\dfrac{y^2\\ln(x+h) -y^2\\ln{x} }{h}\\right).\n$$"}] [{:db/id #edb/ref 17592186124202 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186124644 :knowledge-point/id #uuid "facdd9e7-8fcb-5ad1-b9c1-82c0f753df1a" :knowledge-point/title "Evaluating a Partial Derivative at a Point"}] :question/id #uuid "ee2294e1-1e9a-5be5-be47-4c2e295b640a" :question/math-academy-id "e-11049" :question/problem "For the function $f(x,y) = x^2y^2+\\sin{x}\\cos{y},$ evaluate $\\dfrac{\\partial f}{\\partial x}$ at the point $(\\pi,2\\pi).$" :question/worked-solution "We differentiate the given function with respect to $x,$ treating all other variables as constants:\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}({x}^{2}{y}^{2}+\\operatorname{sin}⁡x\\operatorname{cos}⁡y) \\\\  & =\\frac{∂}{∂x}({x}^{2}{y}^{2})+\\frac{∂}{∂x}(\\operatorname{sin}⁡x\\operatorname{cos}⁡y) \\\\  & ={y}^{2}\\cdot \\frac{∂}{∂x}({x}^{2})+\\operatorname{cos}⁡y\\cdot \\frac{∂}{∂x}(\\operatorname{sin}⁡x) \\\\  & ={y}^{2}\\cdot (2x)+\\operatorname{cos}⁡y\\cdot (\\operatorname{cos}⁡x) \\\\  & =2x{y}^{2}+\\operatorname{cos}⁡x\\operatorname{cos}⁡y\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(\\pi,2\\pi)\\mathbin{:}$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}{|}_{(\\pi ,2\\pi )} & =2\\cdot \\pi \\cdot (2\\pi )^{2}+\\operatorname{cos}⁡\\pi \\cdot \\operatorname{cos}⁡2\\pi  \\\\  & =2\\pi \\cdot 4{\\pi }^{2}+(-1)\\cdot 1 \\\\  & =8{\\pi }^{3}-1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186124806 :knowledge-point/_questions [{:db/id #edb/ref 17592186124643 :knowledge-point/id #uuid "59c3f441-0499-575c-af10-b597d61e6e35" :knowledge-point/title "Partial Derivatives as Limits of Difference Quotients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b2567d63-d63b-58e8-95d8-459258f5081d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "lim_(h → 0)((3x^{2}y - 3x^{2}(y + h))/(h))" :db/id #edb/ref 17592186121434} {:answer/id #uuid "be8b2e72-fa55-5417-b47f-f71a59cb053f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "lim_(h → 0)((3(x + h)^{2}y + 3x^{2}y)/(h))" :db/id #edb/ref 17592186121435} {:answer/id #uuid "e63154ca-6f71-55e5-8bc5-19567054108f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "lim_(h → 0)((3x^{2}(y + h) - 3x^{2}y)/(h))" :db/id #edb/ref 17592186121436} {:answer/id #uuid "6806a102-b8f5-5172-beec-397464a9c946" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "lim_(h → 0)((3x^{2}(y + h) + 3x^{2}y)/(h))" :db/id #edb/ref 17592186121437} {:answer/id #uuid "6a4b645f-99ee-52ff-8098-24866f4013c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "lim_(h → 0)((3(x + h)^{2}y - 3x^{2}y)/(h))" :db/id #edb/ref 17592186121438}] :answer-field/id #uuid "55b7ddca-7b00-5c43-89e9-90f57dc02219" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186121433}] :question/id #uuid "b1789afc-331e-5614-8cc9-89f93ec40167" :question/math-academy-id "q-158412" :question/problem "Given that $f(x, y) = 3x^{2}y$, then $\\frac{∂f}{∂x} =$"}] [{:db/id #edb/ref 17592186278231 :knowledge-point/_questions [{:db/id #edb/ref 17592186124644 :knowledge-point/id #uuid "facdd9e7-8fcb-5ad1-b9c1-82c0f753df1a" :knowledge-point/title "Evaluating a Partial Derivative at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f7787dd-304e-5594-887b-b0172efaf02d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi +1" :db/id #edb/ref 17592186276029} {:answer/id #uuid "565547a1-4ccd-54dc-a9ff-90ea2d921c44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\pi " :db/id #edb/ref 17592186276246} {:answer/id #uuid "abd54eb7-1086-539a-8add-746e03dd04ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\pi -1" :db/id #edb/ref 17592186277021} {:answer/id #uuid "be3c2156-2c5d-51d6-a50e-e4aace745738" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\pi }^{2}+1" :db/id #edb/ref 17592186277176} {:answer/id #uuid "e8c6955b-9352-573f-ba2b-3ad0a48e017e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-{\\pi }^{2}" :db/id #edb/ref 17592186277514}] :answer-field/correct {:answer/id #uuid "abd54eb7-1086-539a-8add-746e03dd04ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\pi -1" :db/id #edb/ref 17592186277021} :answer-field/id #uuid "c006b05b-e312-5e14-bc62-bb96f8a28156" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278066}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e406b09c-bfce-50a6-b8a5-dd556a32ecbf" :question/math-academy-id "q-159585" :question/problem "For the function $f(x,y)=\\operatorname{sin}⁡x\\operatorname{cos}⁡y-xy,$ evaluate ${f}_{x}(0,\\pi ).$" :question/worked-solution "We differentiate the given function with respect to $x,$ treating all other variables as constants:\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}(\\operatorname{sin}⁡x\\operatorname{cos}⁡y-xy) \\\\  & =\\frac{∂}{∂x}(\\operatorname{sin}⁡x\\operatorname{cos}⁡y)-\\frac{∂}{∂x}(xy) \\\\  & =\\operatorname{cos}⁡y\\cdot \\frac{∂}{∂x}(\\operatorname{sin}⁡x)-y\\cdot \\frac{∂}{∂x}(x) \\\\  & =\\operatorname{cos}⁡y\\cdot (\\operatorname{cos}⁡x)-y\\cdot (1) \\\\  & =\\operatorname{cos}⁡y\\operatorname{cos}⁡x-y\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(0,\\pi ):$\n\n$$\n\\begin{aligned}{f}_{x}(0,\\pi ) & =\\operatorname{cos}⁡\\pi \\operatorname{cos}⁡0-\\pi  \\\\  & =(-1)\\cdot 1-\\pi  \\\\  & =-\\pi -1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186381181 :knowledge-point/_questions [{:db/id #edb/ref 17592186124644 :knowledge-point/id #uuid "facdd9e7-8fcb-5ad1-b9c1-82c0f753df1a" :knowledge-point/title "Evaluating a Partial Derivative at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2383a34d-6e32-5f0f-87b8-e7ec3d81fb75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186381183} {:answer/id #uuid "f18943a3-6ebe-57f1-9bae-7fc754040e67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186381184} {:answer/id #uuid "062115ff-ad39-57f6-a416-c53bab27effc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186381185} {:answer/id #uuid "b69cec9b-5a43-5293-af5f-d7b292e1fc03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186381186} {:answer/id #uuid "5f7541dc-dac5-5424-9421-52ce964411eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186381187}] :answer-field/correct {:answer/id #uuid "b69cec9b-5a43-5293-af5f-d7b292e1fc03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186381186} :answer-field/id #uuid "7d6eafe7-491c-520d-9960-7135619c340c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381182}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "83c38041-fc9b-546f-afa6-2d3c332d1b5a" :question/math-academy-id "q-159587" :question/problem "For the function $f(x,y)={y}^{2}\\sqrt{x}+\\frac{x}{y},$ evaluate $\\frac{∂f}{∂y}$ at the point $(4,2).$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants:\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}({y}^{2}\\sqrt{x}+\\frac{x}{y}) \\\\  & =\\frac{∂}{∂y}({y}^{2}\\sqrt{x}+x{y}^{-1}) \\\\  & =\\frac{∂}{∂y}({y}^{2}\\sqrt{x})+\\frac{∂}{∂y}(x{y}^{-1}) \\\\  & =\\sqrt{x}\\cdot \\frac{∂}{∂y}({y}^{2})+x\\cdot \\frac{∂}{∂y}({y}^{-1}) \\\\  & =\\sqrt{x}\\cdot (2y)+x\\cdot (-{y}^{-2}) \\\\  & =2y\\sqrt{x}-x{y}^{-2}\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(4,2):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y}{|}_{(4,2)} & =2\\cdot 2\\cdot \\sqrt{4}-4\\cdot {2}^{-2} \\\\  & =8-1 \\\\  & =7\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278234 :knowledge-point/_questions [{:db/id #edb/ref 17592186124643 :knowledge-point/id #uuid "59c3f441-0499-575c-af10-b597d61e6e35" :knowledge-point/title "Partial Derivatives as Limits of Difference Quotients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a7ffcb1-b787-5688-a29a-b14cbb4f5d13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{\\sqrt[3]{{x}^{2}-yh}+\\sqrt[3]{{x}^{2}-y}}{h})" :db/id #edb/ref 17592186275865} {:answer/id #uuid "387f4d00-3ca9-5bc5-88ef-bdb211870301" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{h\\sqrt[3]{{x}^{2}-y}-\\sqrt[3]{{x}^{2}-y}}{h})" :db/id #edb/ref 17592186275977} {:answer/id #uuid "60dd8e6e-8fb3-5403-b935-b1d6062ef077" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{\\sqrt[3]{{x}^{2}-(y-h)}+\\sqrt[3]{{x}^{2}-y}}{h})" :db/id #edb/ref 17592186276350} {:answer/id #uuid "b8904d3e-ea3f-58de-a7d5-6645fe9d0a85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{\\sqrt[3]{{x}^{2}-yh}-\\sqrt[3]{{x}^{2}-y}}{h})" :db/id #edb/ref 17592186277113} {:answer/id #uuid "e436179e-0aae-5046-8432-58d235c36750" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{\\sqrt[3]{{x}^{2}-(y+h)}-\\sqrt[3]{{x}^{2}-y}}{h})" :db/id #edb/ref 17592186277469}] :answer-field/correct {:answer/id #uuid "e436179e-0aae-5046-8432-58d235c36750" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{\\sqrt[3]{{x}^{2}-(y+h)}-\\sqrt[3]{{x}^{2}-y}}{h})" :db/id #edb/ref 17592186277469} :answer-field/id #uuid "8be9e607-3ca8-5c79-b594-28cdaa505ea7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277975}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "53daed36-1f31-5b2b-8966-96a4d35c598d" :question/math-academy-id "q-159594" :question/problem "Given that $f(x,y)=\\sqrt[3]{{x}^{2}-y},$ then $\\frac{∂f}{∂y}=$" :question/worked-solution "The derivative of $f$ with respect to $y$ is given by the limit \n\n$$\n\\frac{∂f}{∂y}={lim}_{h\\to 0}(\\frac{f(x,y+h)-f(x,y)}{h}).\n$$\n\nSince $f(x)=\\sqrt[3]{{x}^{2}-y},$  we have that \n\n$$\nf(x,y+h)=\\sqrt[3]{{x}^{2}-(y+h)}.\n$$\n\nTherefore,\n\n$$\n\\frac{∂f}{∂y}={lim}_{h\\to 0}(\\frac{\\sqrt[3]{{x}^{2}-(y+h)}-\\sqrt[3]{{x}^{2}-y}}{h}).\n$$"}] [{:db/id #edb/ref 17592186278236 :knowledge-point/_questions [{:db/id #edb/ref 17592186124644 :knowledge-point/id #uuid "facdd9e7-8fcb-5ad1-b9c1-82c0f753df1a" :knowledge-point/title "Evaluating a Partial Derivative at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32674586-4e3a-5879-b109-f0eb8a8c0450" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2}+1" :db/id #edb/ref 17592186275924} {:answer/id #uuid "3bd21982-4f35-584b-905b-d8f52b1c2efd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e+1" :db/id #edb/ref 17592186276001} {:answer/id #uuid "a7c2cdb1-d291-595f-9c08-8200c680205a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e+1" :db/id #edb/ref 17592186276990} {:answer/id #uuid "cfe844ab-c3d2-5244-a7bf-3826f1851815" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}e+1" :db/id #edb/ref 17592186277319} {:answer/id #uuid "edeb7583-0cc3-58db-a0ea-b3a8684a62fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e" :db/id #edb/ref 17592186277568}] :answer-field/correct {:answer/id #uuid "3bd21982-4f35-584b-905b-d8f52b1c2efd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e+1" :db/id #edb/ref 17592186276001} :answer-field/id #uuid "64f03706-d8ba-5c00-9d36-3018e3c877be" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277905}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4d7d1dc5-2124-525b-9cc9-fe9b2cf1012d" :question/math-academy-id "q-159599" :question/problem "For the function $f(x,y)={e}^{x}\\operatorname{ln}⁡y+{x}^{7}y,$ evaluate $\\frac{∂f}{∂y}$ at the point $(1,\\frac{1}{2}).$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants:\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}({e}^{x}\\operatorname{ln}⁡y+{x}^{7}y) \\\\  & =\\frac{∂}{∂y}({e}^{x}\\operatorname{ln}⁡y)+\\frac{∂}{∂y}({x}^{7}y) \\\\  & ={e}^{x}\\cdot \\frac{∂}{∂y}(\\operatorname{ln}⁡y)+{x}^{7}\\cdot \\frac{∂}{∂y}(y) \\\\  & ={e}^{x}\\cdot (\\frac{1}{y})+{x}^{7}\\cdot (1) \\\\  & =\\frac{{e}^{x}}{y}+{x}^{7}\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(1,\\frac{1}{2}):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y}{|}_{(1,1/2)} & =\\frac{{e}^{1}}{(\\frac{1}{2})}+{1}^{7} \\\\  & =2e+1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186381209 :knowledge-point/_questions [{:db/id #edb/ref 17592186124644 :knowledge-point/id #uuid "facdd9e7-8fcb-5ad1-b9c1-82c0f753df1a" :knowledge-point/title "Evaluating a Partial Derivative at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d0ef6ef-d5c2-5f7d-b007-5d1f8bcb76dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\pi " :db/id #edb/ref 17592186381211} {:answer/id #uuid "d2d3c50a-be40-5168-9b60-89cddf3610ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+\\pi " :db/id #edb/ref 17592186381212} {:answer/id #uuid "885ea363-dc99-5baa-bdb0-83b42d304c47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\pi " :db/id #edb/ref 17592186381213} {:answer/id #uuid "7e4f7612-4c6b-5535-81d9-f5903c791c1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1-\\pi " :db/id #edb/ref 17592186381214} {:answer/id #uuid "f9925be6-c2b3-5b22-8f0f-b02e6fe00ac0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-2\\pi " :db/id #edb/ref 17592186381215}] :answer-field/correct {:answer/id #uuid "7e4f7612-4c6b-5535-81d9-f5903c791c1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1-\\pi " :db/id #edb/ref 17592186381214} :answer-field/id #uuid "47162c79-8d31-5bc6-a2b7-3b78e065d6f5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381210}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4e2a2cf2-39c7-5aaf-aba5-b368c09836a4" :question/math-academy-id "q-159606" :question/problem "For the function $f(x,y)={y}^{3}\\operatorname{cot}⁡x-{x}^{2}{y}^{2},$ evaluate ${f}_{x}(\\frac{\\pi }{2},1).$" :question/worked-solution "We differentiate the given function with respect to $x,$ treating all other variables as constants:\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}({y}^{3}\\operatorname{cot}⁡x-{x}^{2}{y}^{2}) \\\\  & =\\frac{∂}{∂x}({y}^{3}\\operatorname{cot}⁡x)-\\frac{∂}{∂x}({x}^{2}{y}^{2}) \\\\  & ={y}^{3}\\cdot \\frac{∂}{∂x}(\\operatorname{cot}⁡x)-{y}^{2}\\cdot \\frac{∂}{∂x}({x}^{2}) \\\\  & ={y}^{3}\\cdot (-{csc}^{2}⁡x)-{y}^{2}\\cdot (2x) \\\\  & =-{y}^{3}{csc}^{2}⁡x-2x{y}^{2}\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(\\frac{\\pi }{2},1):$\n\n$$\n\\begin{aligned}{f}_{x}(\\frac{\\pi }{2},1) & =-(1)^{3}\\cdot {csc}^{2}⁡(\\frac{\\pi }{2})-2\\cdot \\frac{\\pi }{2}\\cdot {1}^{2} \\\\  & =-1\\cdot 1-\\pi  \\\\  & =-1-\\pi \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186381216 :knowledge-point/_questions [{:db/id #edb/ref 17592186124639 :knowledge-point/id #uuid "53c5d5d7-40d4-5210-8794-428cffc1f3f9" :knowledge-point/title "Finding Partial Derivatives of Two-Variable Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "051af5b2-726e-5b49-a969-9796e797ae3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}{sec}^{2}⁡y-{3}^{x+y}" :db/id #edb/ref 17592186381218} {:answer/id #uuid "ecde6fb6-675d-59f3-9850-531e953ba33d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{2}\\operatorname{tan}⁡y-{3}^{x+y}\\operatorname{ln}⁡3" :db/id #edb/ref 17592186381219} {:answer/id #uuid "20ae591f-fa16-5672-9d61-61d8a2e3a05d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}{sec}^{2}⁡y-{3}^{x+y}\\operatorname{ln}⁡3" :db/id #edb/ref 17592186381220} {:answer/id #uuid "a24feefe-3cbe-5e42-b271-0ac95ae87b92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}{csc}^{2}⁡y-{3}^{x+y}\\operatorname{ln}⁡3" :db/id #edb/ref 17592186381221} {:answer/id #uuid "faa81e86-4ae1-53c8-8b77-4618058650b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{2}\\operatorname{tan}⁡y-{3}^{x+y}" :db/id #edb/ref 17592186381222}] :answer-field/correct {:answer/id #uuid "20ae591f-fa16-5672-9d61-61d8a2e3a05d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}{sec}^{2}⁡y-{3}^{x+y}\\operatorname{ln}⁡3" :db/id #edb/ref 17592186381220} :answer-field/id #uuid "e9775693-9681-5414-8d66-ab2776e2f417" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381217}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "26ca0866-34da-5a8a-8819-c0314d3abbb7" :question/math-academy-id "q-159611" :question/problem "Find $\\frac{∂f}{∂y}$ given that $f(x,y)={x}^{3}\\operatorname{tan}⁡y-{3}^{x+y}.$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants.\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}({x}^{3}\\operatorname{tan}⁡y-{3}^{x+y}) \\\\  & =\\frac{∂}{∂y}({x}^{3}\\operatorname{tan}⁡y)-\\frac{∂}{∂y}({3}^{x}\\cdot {3}^{y}) \\\\  & ={x}^{3}\\cdot \\frac{∂}{∂y}(\\operatorname{tan}⁡y)-{3}^{x}\\cdot \\frac{∂}{∂y}({3}^{y}) \\\\  & ={x}^{3}\\cdot {sec}^{2}⁡y-{3}^{x}\\cdot {3}^{y}\\operatorname{ln}⁡3 \\\\  & ={x}^{3}{sec}^{2}⁡y-{3}^{x+y}\\operatorname{ln}⁡3\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278241 :knowledge-point/_questions [{:db/id #edb/ref 17592186124639 :knowledge-point/id #uuid "53c5d5d7-40d4-5210-8794-428cffc1f3f9" :knowledge-point/title "Finding Partial Derivatives of Two-Variable Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06f139b4-7520-5359-86c4-cc976c2a0da2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186275545} {:answer/id #uuid "2959b683-8721-5d47-ae28-bfdae8458730" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y}{\\sqrt{1-{x}^{2}}}-16y" :db/id #edb/ref 17592186275851} {:answer/id #uuid "8368ea87-f533-59c5-8779-19322eca007e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{arcsin}⁡x-16y" :db/id #edb/ref 17592186276659} {:answer/id #uuid "bd6ef288-08fc-5b25-a851-71488d467d63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186277165} {:answer/id #uuid "ecc63446-669b-52c7-a4ab-fb4eec89773e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\operatorname{arcsin}⁡x" :db/id #edb/ref 17592186277553}] :answer-field/correct {:answer/id #uuid "06f139b4-7520-5359-86c4-cc976c2a0da2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186275545} :answer-field/id #uuid "ad8d61fd-1884-5c25-bcf8-efd036093e2d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278023}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8fe04cdb-3f03-5a9d-a32d-3dd7d276f6a2" :question/math-academy-id "q-159619" :question/problem "Find ${f}_{x}(x,y)$ for $f(x,y)=y\\operatorname{arcsin}⁡x-8{y}^{2}.$" :question/worked-solution "The notation ${f}_{x}$ denotes the partial derivative of $f$ with respect to $x.$\n\nWe differentiate the given function with respect to $x,$ treating all other variables as constants.\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}(y\\operatorname{arcsin}⁡x-8{y}^{2}) \\\\  & =\\frac{∂}{∂x}(y\\operatorname{arcsin}⁡x)-\\frac{∂}{∂x}(8{y}^{2}) \\\\  & =y\\cdot \\frac{∂}{∂x}(\\operatorname{arcsin}⁡x)-8{y}^{2}\\frac{∂}{∂x}(1) \\\\  & =y\\cdot \\frac{1}{\\sqrt{1-{x}^{2}}}-0 \\\\  & =\\frac{y}{\\sqrt{1-{x}^{2}}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186381237 :knowledge-point/_questions [{:db/id #edb/ref 17592186124639 :knowledge-point/id #uuid "53c5d5d7-40d4-5210-8794-428cffc1f3f9" :knowledge-point/title "Finding Partial Derivatives of Two-Variable Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b6f0ef5-d53d-5837-98c8-631186129434" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32{y}^{3}-\\frac{24y}{{x}^{5}}" :db/id #edb/ref 17592186381239} {:answer/id #uuid "cd8e251a-8b10-5e05-b8e9-664d5a11015b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32x{y}^{3}+\\frac{6y}{{x}^{4}}" :db/id #edb/ref 17592186381240} {:answer/id #uuid "b39b7828-0e78-591c-b643-6a8cdf575bd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32x{y}^{3}-\\frac{12{y}^{2}}{{x}^{5}}" :db/id #edb/ref 17592186381241} {:answer/id #uuid "20a23aa3-24e9-590f-adc4-61e10bc87a84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{y}^{4}-\\frac{12{y}^{2}}{{x}^{5}}" :db/id #edb/ref 17592186381242} {:answer/id #uuid "4b9203e9-d678-558b-b50c-6a4193709f98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{y}^{4}+\\frac{6y}{{x}^{4}}" :db/id #edb/ref 17592186381243}] :answer-field/correct {:answer/id #uuid "20a23aa3-24e9-590f-adc4-61e10bc87a84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{y}^{4}-\\frac{12{y}^{2}}{{x}^{5}}" :db/id #edb/ref 17592186381242} :answer-field/id #uuid "3225480b-17a3-5de3-a894-3b9c909ffb27" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381238}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "54a3e289-7644-5884-8f3d-09b4adcf7d3d" :question/math-academy-id "q-159621" :question/problem "Find ${f}_{x}(x,y)$ for $f(x,y)=8x{y}^{4}+\\frac{3{y}^{2}}{{x}^{4}}.$" :question/worked-solution "The notation ${f}_{x}$ denotes the partial derivative of $f$ with respect to $x.$\n\nWe differentiate the given function with respect to $x,$ treating all other variables as constants.\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}(8x{y}^{4}+\\frac{3{y}^{2}}{{x}^{4}}) \\\\  & =\\frac{∂}{∂x}(8x{y}^{4})+\\frac{∂}{∂x}(\\frac{3{y}^{2}}{{x}^{4}}) \\\\  & =8{y}^{4}\\cdot \\frac{∂}{∂x}(x)+3{y}^{2}\\cdot \\frac{∂}{∂x}(\\frac{1}{{x}^{4}}) \\\\  & =8{y}^{4}\\cdot 1+3{y}^{2}\\cdot (-\\frac{4}{{x}^{5}}) \\\\  & =8{y}^{4}-\\frac{12{y}^{2}}{{x}^{5}}\\end{aligned}\n$$"}]}
