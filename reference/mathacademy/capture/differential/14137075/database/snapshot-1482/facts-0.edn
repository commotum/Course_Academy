17] [17592186050675 #edb/ref 1029 #edb/ref 17592186428831 #edb/ref 17592186045436] [17592186050675 #edb/ref 1031 "Differentiating Inverse Trigonometric Functions" #edb/ref 17592186045417] [17592186050675 #edb/ref 1033 303 #edb/ref 17592186045417] [17592186050675 #edb/ref 1035 #uuid "5e05a47e-5905-5eee-b6ea-48c720a8d288" #edb/ref 17592186045417] [17592186050690 #edb/ref 1027 #edb/ref 17592186048434 #edb/ref 17592186045417] [17592186050690 #edb/ref 1027 #edb/ref 17592186048813 #edb/ref 17592186045417] [17592186050690 #edb/ref 1027 #edb/ref 17592186049332 #edb/ref 17592186045417] [17592186050690 #edb/ref 1027 #edb/ref 17592186049443 #edb/ref 17592186045417] [17592186050690 #edb/ref 1027 #edb/ref 17592186050902 #edb/ref 17592186045417] [17592186050690 #edb/ref 1028 #edb/ref 17592186096613 #edb/ref 17592186045417] [17592186050690 #edb/ref 1028 #edb/ref 17592186096614 #edb/ref 17592186045417] [17592186050690 #edb/ref 1028 #edb/ref 17592186096615 #edb/ref 17592186045417] [17592186050690 #edb/ref 1028 #edb/ref 17592186096616 #edb/ref 17592186045417] [17592186050690 #edb/ref 1029 #edb/ref 17592186428108 #edb/ref 17592186045436] [17592186050690 #edb/ref 1031 "Differentiating Logarithmic Functions" #edb/ref 17592186045417] [17592186050690 #edb/ref 1033 1116 #edb/ref 17592186045417] [17592186050690 #edb/ref 1035 #uuid "5f59a4ad-6d31-5757-be65-f24e070b2c60" #edb/ref 17592186045417] [17592186121433 #edb/ref 1075 #edb/ref 17592186121434 #edb/ref 17592186045417] [17592186121433 #edb/ref 1075 #edb/ref 17592186121435 #edb/ref 17592186045417] [17592186121433 #edb/ref 1075 #edb/ref 17592186121436 #edb/ref 17592186045417] [17592186121433 #edb/ref 1075 #edb/ref 17592186121437 #edb/ref 17592186045417] [17592186121433 #edb/ref 1075 #edb/ref 17592186121438 #edb/ref 17592186045417] [17592186121433 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186121433 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186121433 #edb/ref 1079 #uuid "55b7ddca-7b00-5c43-89e9-90f57dc02219" #edb/ref 17592186045417] [17592186121434 #edb/ref 1080 "lim_(h → 0)((3x^{2}y - 3x^{2}(y + h))/(h))" #edb/ref 17592186045417] [17592186121434 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186121434 #edb/ref 1083 #uuid "b2567d63-d63b-58e8-95d8-459258f5081d" #edb/ref 17592186045417] [17592186121435 #edb/ref 1080 "lim_(h → 0)((3(x + h)^{2}y + 3x^{2}y)/(h))" #edb/ref 17592186045417] [17592186121435 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186121435 #edb/ref 1083 #uuid "be8b2e72-fa55-5417-b47f-f71a59cb053f" #edb/ref 17592186045417] [17592186121436 #edb/ref 1080 "lim_(h → 0)((3x^{2}(y + h) - 3x^{2}y)/(h))" #edb/ref 17592186045417] [17592186121436 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186121436 #edb/ref 1083 #uuid "e63154ca-6f71-55e5-8bc5-19567054108f" #edb/ref 17592186045417] [17592186121437 #edb/ref 1080 "lim_(h → 0)((3x^{2}(y + h) + 3x^{2}y)/(h))" #edb/ref 17592186045417] [17592186121437 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186121437 #edb/ref 1083 #uuid "6806a102-b8f5-5172-beec-397464a9c946" #edb/ref 17592186045417] [17592186121438 #edb/ref 1080 "lim_(h → 0)((3(x + h)^{2}y - 3x^{2}y)/(h))" #edb/ref 17592186045417] [17592186121438 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186121438 #edb/ref 1083 #uuid "6a4b645f-99ee-52ff-8098-24866f4013c7" #edb/ref 17592186045417] [17592186124197 #edb/ref 1069 "e-11026" #edb/ref 17592186045417] [17592186124197 #edb/ref 1071 "Find $\\dfrac{\\partial f}{\\partial y}$ given that $f(x,y) = 3x\\ln y + 2ye^x.$" #edb/ref 17592186045417] [17592186124197 #edb/ref 1072 #uuid "35a664b8-a895-5c52-a92f-b62c75b44744" #edb/ref 17592186045417] [17592186124197 #edb/ref 1074 "We differentiate the given function with respect to $y,$ treating all other variables as constants.\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}(3x\\operatorname{ln}⁡y+2y{e}^{x}) \\\\  & =\\frac{∂}{∂y}(3x\\operatorname{ln}⁡y)+\\frac{∂}{∂y}(2y{e}^{x}) \\\\  & =3x\\cdot \\frac{∂}{∂y}(\\operatorname{ln}⁡y)+2{e}^{x}\\cdot \\frac{∂}{∂y}(y) \\\\  & =3x\\cdot \\frac{1}{y}+2{e}^{x}\\cdot 1 \\\\  & =\\frac{3x}{y}+2{e}^{x}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186124201 #edb/ref 1069 "e-11045" #edb/ref 17592186045417] [17592186124201 #edb/ref 1071 "Given that $f(x,y) = y^2\\ln{x},$ express $\\dfrac{\\partial f}{\\partial x}$ as the limit of a difference quotient." #edb/ref 17592186045417] [17592186124201 #edb/ref 1072 #uuid "a14d53ae-1922-531d-bb2a-bda9b4829f6e" #edb/ref 17592186045417] [17592186124201 #edb/ref 1074 "The partial derivative of $f$ with respect to $x$ is given by the limit \n\n$$\n\\dfrac{\\partial f}{\\partial x} = \\lim_{h \\to 0} \\left(\\dfrac{f(x+h,y)-f(x,y)}{h}\\right).\n$$\n\nSince $f(x) = y^2 \\ln{x},$  we have that \n\n$$\nf(x+h,y) = y^2\\ln(x+h).\n$$\n\nTherefore,\n\n$$\n\\displaystyle \\dfrac{\\partial f}{\\partial x} = \\lim_{h \\to 0}\\left( \\dfrac{y^2\\ln(x+h) -y^2\\ln{x} }{h}\\right).\n$$" #edb/ref 17592186045417] [17592186124202 #edb/ref 1069 "e-11049" #edb/ref 17592186045417] [17592186124202 #edb/ref 1071 "For the function $f(x,y) = x^2y^2+\\sin{x}\\cos{y},$ evaluate $\\dfrac{\\partial f}{\\partial x}$ at the point $(\\pi,2\\pi).$" #edb/ref 17592186045417] [17592186124202 #edb/ref 1072 #uuid "ee2294e1-1e9a-5be5-be47-4c2e295b640a" #edb/ref 17592186045417] [17592186124202 #edb/ref 1074 "We differentiate the given function with respect to $x,$ treating all other variables as constants:\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}({x}^{2}{y}^{2}+\\operatorname{sin}⁡x\\operatorname{cos}⁡y) \\\\  & =\\frac{∂}{∂x}({x}^{2}{y}^{2})+\\frac{∂}{∂x}(\\operatorname{sin}⁡x\\operatorname{cos}⁡y) \\\\  & ={y}^{2}\\cdot \\frac{∂}{∂x}({x}^{2})+\\operatorname{cos}⁡y\\cdot \\frac{∂}{∂x}(\\operatorname{sin}⁡x) \\\\  & ={y}^{2}\\cdot (2x)+\\operatorname{cos}⁡y\\cdot (\\operatorname{cos}⁡x) \\\\  & =2x{y}^{2}+\\operatorname{cos}⁡x\\operatorname{cos}⁡y\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(\\pi,2\\pi)\\mathbin{:}$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}{|}_{(\\pi ,2\\pi )} & =2\\cdot \\pi \\cdot (2\\pi )^{2}+\\operatorname{cos}⁡\\pi \\cdot \\operatorname{cos}⁡2\\pi  \\\\  & =2\\pi \\cdot 4{\\pi }^{2}+(-1)\\cdot 1 \\\\  & =8{\\pi }^{3}-1\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186124639 #edb/ref 1037 #edb/ref 17592186048749 #edb/ref 17592186045417] [17592186124639 #edb/ref 1037 #edb/ref 17592186050420 #edb/ref 17592186045417] [17592186124639 #edb/ref 1037 #edb/ref 17592186050675 #edb/ref 17592186045417] [17592186124639 #edb/ref 1037 #edb/ref 17592186050690 #edb/ref 17592186045417] [17592186124639 #edb/ref 1038 #edb/ref 17592186124786 #edb/ref 17592186045417] [17592186124639 #edb/ref 1038 #edb/ref 17592186124901 #edb/ref 17592186045417] [17592186124639 #edb/ref 1038 #edb/ref 17592186278239 #edb/ref 17592186045417] [17592186124639 #edb/ref 1038 #edb/ref 17592186278240 #edb/ref 17592186045417] [17592186124639 #edb/ref 1038 #edb/ref 17592186278241 #edb/ref 17592186045417] [17592186124639 #edb/ref 1038 #edb/ref 17592186278242 #edb/ref 17592186045417] [17592186124639 #edb/ref 1038 #edb/ref 17592186381216 #edb/ref 17592186045417] [17592186124639 #edb/ref 1038 #edb/ref 17592186381223 #edb/ref 17592186045417] [17592186124639 #edb/ref 1038 #edb/ref 17592186381230 #edb/ref 17592186045417] [17592186124639 #edb/ref 1038 #edb/ref 17592186381237 #edb/ref 17592186045417] [17592186124639 #edb/ref 1039 "Finding Partial Derivatives of Two-Variable Functions" #edb/ref 17592186045417] [17592186124639 #edb/ref 1041 #edb/ref 17592186124197 #edb/ref 17592186045417] [17592186124639 #edb/ref 1042 #uuid "53c5d5d7-40d4-5210-8794-428cffc1f3f9" #edb/ref 17592186045417] [17592186124643 #edb/ref 1037 #edb/ref 17592186048449 #edb/re