#{[{:db/id #edb/ref 17592186124197 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186124639 :knowledge-point/id #uuid "53c5d5d7-40d4-5210-8794-428cffc1f3f9" :knowledge-point/title "Finding Partial Derivatives of Two-Variable Functions"}] :question/id #uuid "35a664b8-a895-5c52-a92f-b62c75b44744" :question/math-academy-id "e-11026" :question/problem "Find $\\dfrac{\\partial f}{\\partial y}$ given that $f(x,y) = 3x\\ln y + 2ye^x.$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants.\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}(3x\\operatorname{ln}⁡y+2y{e}^{x}) \\\\  & =\\frac{∂}{∂y}(3x\\operatorname{ln}⁡y)+\\frac{∂}{∂y}(2y{e}^{x}) \\\\  & =3x\\cdot \\frac{∂}{∂y}(\\operatorname{ln}⁡y)+2{e}^{x}\\cdot \\frac{∂}{∂y}(y) \\\\  & =3x\\cdot \\frac{1}{y}+2{e}^{x}\\cdot 1 \\\\  & =\\frac{3x}{y}+2{e}^{x}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186124201 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186124643 :knowledge-point/id #uuid "59c3f441-0499-575c-af10-b597d61e6e35" :knowledge-point/title "Partial Derivatives as Limits of Difference Quotients"}] :question/id #uuid "a14d53ae-1922-531d-bb2a-bda9b4829f6e" :question/math-academy-id "e-11045" :question/problem "Given that $f(x,y) = y^2\\ln{x},$ express $\\dfrac{\\partial f}{\\partial x}$ as the limit of a difference quotient." :question/worked-solution "The partial derivative of $f$ with respect to $x$ is given by the limit \n\n$$\n\\dfrac{\\partial f}{\\partial x} = \\lim_{h \\to 0} \\left(\\dfrac{f(x+h,y)-f(x,y)}{h}\\right).\n$$\n\nSince $f(x) = y^2 \\ln{x},$  we have that \n\n$$\nf(x+h,y) = y^2\\ln(x+h).\n$$\n\nTherefore,\n\n$$\n\\displaystyle \\dfrac{\\partial f}{\\partial x} = \\lim_{h \\to 0}\\left( \\dfrac{y^2\\ln(x+h) -y^2\\ln{x} }{h}\\right).\n$$"}] [{:db/id #edb/ref 17592186124202 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186124644 :knowledge-point/id #uuid "facdd9e7-8fcb-5ad1-b9c1-82c0f753df1a" :knowledge-point/title "Evaluating a Partial Derivative at a Point"}] :question/id #uuid "ee2294e1-1e9a-5be5-be47-4c2e295b640a" :question/math-academy-id "e-11049" :question/problem "For the function $f(x,y) = x^2y^2+\\sin{x}\\cos{y},$ evaluate $\\dfrac{\\partial f}{\\partial x}$ at the point $(\\pi,2\\pi).$" :question/worked-solution "We differentiate the given function with respect to $x,$ treating all other variables as constants:\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}({x}^{2}{y}^{2}+\\operatorname{sin}⁡x\\operatorname{cos}⁡y) \\\\  & =\\frac{∂}{∂x}({x}^{2}{y}^{2})+\\frac{∂}{∂x}(\\operatorname{sin}⁡x\\operatorname{cos}⁡y) \\\\  & ={y}^{2}\\cdot \\frac{∂}{∂x}({x}^{2})+\\operatorname{cos}⁡y\\cdot \\frac{∂}{∂x}(\\operatorname{sin}⁡x) \\\\  & ={y}^{2}\\cdot (2x)+\\operatorname{cos}⁡y\\cdot (\\operatorname{cos}⁡x) \\\\  & =2x{y}^{2}+\\operatorname{cos}⁡x\\operatorname{cos}⁡y\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(\\pi,2\\pi)\\mathbin{:}$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}{|}_{(\\pi ,2\\pi )} & =2\\cdot \\pi \\cdot (2\\pi )^{2}+\\operatorname{cos}⁡\\pi \\cdot \\operatorname{cos}⁡2\\pi  \\\\  & =2\\pi \\cdot 4{\\pi }^{2}+(-1)\\cdot 1 \\\\  & =8{\\pi }^{3}-1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186124806 :knowledge-point/_questions [{:db/id #edb/ref 17592186124643 :knowledge-point/id #uuid "59c3f441-0499-575c-af10-b597d61e6e35" :knowledge-point/title "Partial Derivatives as Limits of Difference Quotients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a982a06-37f5-5503-bfa9-cb1dd6d38914" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{3(x+h)^{2}y-3{x}^{2}y}{h})" :db/id #edb/ref 17592186436294} {:answer/id #uuid "a0c460cb-67db-5572-99a9-ee900ea57026" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{3{x}^{2}y-3{x}^{2}(y+h)}{h})" :db/id #edb/ref 17592186436309} {:answer/id #uuid "cf081fa8-128f-5e46-8325-e879a6351185" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{3{x}^{2}(y+h)+3{x}^{2}y}{h})" :db/id #edb/ref 17592186436315} {:answer/id #uuid "d91afb82-9ea2-57cb-beea-4efb7de3116e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{3(x+h)^{2}y+3{x}^{2}y}{h})" :db/id #edb/ref 17592186436316} {:answer/id #uuid "e544a325-ec37-5b38-a930-60dd700bae41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{3{x}^{2}(y+h)-3{x}^{2}y}{h})" :db/id #edb/ref 17592186436321}] :answer-field/correct {:answer/id #uuid "2a982a06-37f5-5503-bfa9-cb1dd6d38914" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{3(x+h)^{2}y-3{x}^{2}y}{h})" :db/id #edb/ref 17592186436294} :answer-field/id #uuid "55b7ddca-7b00-5c43-89e9-90f57dc02219" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186121433}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b1789afc-331e-5614-8cc9-89f93ec40167" :question/math-academy-id "q-158412" :question/problem "Given that $f(x,y)=3{x}^{2}y,$ then $\\frac{∂f}{∂x}=$" :question/worked-solution "The partial derivative of $f$ with respect to $x$ is given by the limit \n\n$$\n\\frac{∂f}{∂x}={lim}_{h\\to 0}(\\frac{f(x+h,y)-f(x,y)}{h}).\n$$\n\nSince $f(x)=3{x}^{2}y$,  we have that \n\n$$\nf(x+h,y)=3(x+h)^{2}y.\n$$\n\nTherefore,\n\n$$\n\\frac{∂f}{∂x}={lim}_{h\\to 0}(\\frac{3(x+h)^{2}y-3{x}^{2}y}{h}).\n$$"}] [{:db/id #edb/ref 17592186436335 :knowledge-point/_questions [{:db/id #edb/ref 17592186124643 :knowledge-point/id #uuid "59c3f441-0499-575c-af10-b597d61e6e35" :knowledge-point/title "Partial Derivatives as Limits of Difference Quotients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0966d4fd-1004-5375-90cf-1757ff705f99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{\\operatorname{sin}⁡((x+h)(y+h))-\\operatorname{sin}⁡(xy)}{h})" :db/id #edb/ref 17592186436290} {:answer/id #uuid "6c6f24d2-f9ef-5de6-894b-96a6e11cae68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{\\operatorname{sin}⁡(xy+h)-\\operatorname{sin}⁡(xy)}{h})" :db/id #edb/ref 17592186436303} {:answer/id #uuid "b4733487-8f20-5482-b97a-b62fc0d6cb76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{\\operatorname{sin}⁡(xy+h)+\\operatorname{sin}⁡(xy)}{h})" :db/id #edb/ref 17592186436314} {:answer/id #uuid "dd8fe9b0-2dfe-5cce-8bde-270fb503d4de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{\\operatorname{sin}⁡((x+h)y)-\\operatorname{sin}⁡(xy)}{h})" :db/id #edb/ref 17592186436318} {:answer/id #uuid "e34026d0-8c07-5e65-85c3-9dc96c50dbd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{\\operatorname{sin}⁡(x(y+h))-\\operatorname{sin}⁡(xy)}{h})" :db/id #edb/ref 17592186436320}] :answer-field/correct {:answer/id #uuid "dd8fe9b0-2dfe-5cce-8bde-270fb503d4de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{\\operatorname{sin}⁡((x+h)y)-\\operatorname{sin}⁡(xy)}{h})" :db/id #edb/ref 17592186436318} :answer-field/id #uuid "fb776df8-d18c-56c6-b0af-71e18ee9b2ff" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186436329}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fab082ec-08e1-574d-8102-367e3c718114" :question/math-academy-id "q-159572" :question/problem "Given that $f(x,y)=\\operatorname{sin}⁡(xy),$ then $\\frac{∂f}{∂x}=$" :question/worked-solution "The partial derivative of $f$ with respect to $x$ is given by the limit \n\n$$\n\\frac{∂f}{∂x}={lim}_{h\\to 0}(\\frac{f(x+h,y)-f(x,y)}{h}).\n$$\n\nSince $f(x)=\\operatorname{sin}⁡(xy),$  we have that \n\n$$\nf(x+h,y)=\\operatorname{sin}⁡((x+h)y).\n$$\n\nTherefore,\n\n$$\n\\frac{∂f}{∂x}={lim}_{h\\to 0}(\\frac{\\operatorname{sin}⁡((x+h)y)-\\operatorname{sin}⁡(xy)}{h}).\n$$"}] [{:db/id #edb/ref 17592186436332 :knowledge-point/_questions [{:db/id #edb/ref 17592186124643 :knowledge-point/id #uuid "59c3f441-0499-575c-af10-b597d61e6e35" :knowledge-point/title "Partial Derivatives as Limits of Difference Quotients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19821da5-f0d9-5231-b6e6-57d05a583c98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{(x+h)^{y}+{x}^{y}}{h})" :db/id #edb/ref 17592186436292} {:answer/id #uuid "31ac6394-634c-5df7-8435-c91eb48acad5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{(x+h)^{y}-{x}^{y}}{h})" :db/id #edb/ref 17592186436295} {:answer/id #uuid "3ca1bb65-4836-5031-98cd-687ce371b497" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{{x}^{y+h}-{x}^{y}}{h})" :db/id #edb/ref 17592186436296} {:answer/id #uuid "88c4c69c-b8ec-5afa-8545-f80894277b0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{(x+h)^{y+h}-{x}^{y}}{h})" :db/id #edb/ref 17592186436305} {:answer/id #uuid "dd81c589-9abe-5852-882a-90489739a54c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{{x}^{y+h}+{x}^{y}}{h})" :db/id #edb/ref 17592186436317}] :answer-field/correct {:answer/id #uuid "31ac6394-634c-5df7-8435-c91eb48acad5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{(x+h)^{y}-{x}^{y}}{h})" :db/id #edb/ref 17592186436295} :answer-field/id #uuid "76655532-0bc3-55d8-ba79-572397ad3e3c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186436326}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9785714b-27e4-57d0-bac5-65edf8d118a2" :question/math-academy-id "q-159575" :question/problem "Given that $f(x,y)={x}^{y},$ then $\\frac{∂f}{∂x}=$" :question/worked-solution "The partial derivative of $f$ with respect to $x$ is given by the limit \n\n$$\n\\frac{∂f}{∂x}={lim}_{h\\to 0}(\\frac{f(x+h,y)-f(x,y)}{h}).\n$$\n\nSince $f(x)={x}^{y},$  we have that \n\n$$\nf(x+h,y)=(x+h)^{y}.\n$$\n\nTherefore,\n\n$$\n\\frac{∂f}{∂x}={lim}_{h\\to 0}(\\frac{(x+h)^{y}-{x}^{y}}{h}).\n$$"}] [{:db/id #edb/ref 17592186436334 :knowledge-point/_questions [{:db/id #edb/ref 17592186124643 :knowledge-point/id #uuid "59c3f441-0499-575c-af10-b597d61e6e35" :knowledge-point/title "Partial Derivatives as Limits of Difference Quotients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04fd8c41-938d-5896-af76-a08ef933364a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{\\operatorname{cos}⁡(x+h-{y}^{2})-\\operatorname{cos}⁡(x-{y}^{2})}{h})" :db/id #edb/ref 17592186436289} {:answer/id #uuid "14ea137a-7846-516f-9915-09b5b41d82fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{\\operatorname{cos}⁡(xh-{y}^{2})-\\operatorname{cos}⁡(x-{y}^{2})}{h})" :db/id #edb/ref 1