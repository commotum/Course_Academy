ata-mjx-texclass=\"CLOSE\">]</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">[</mo><mtable columnalign=\"center\" columnspacing=\"1em\" rowspacing=\"4pt\"><mtr><mtd><mn>4</mn><mo>+</mo><mn>0</mn><mo>−</mo><mn>3</mn></mtd></mtr><mtr><mtd><mo>−</mo><mn>3</mn><mo>+</mo><mn>0</mn><mo>+</mo><mn>2</mn></mtd></mtr><mtr><mtd><mo>−</mo><mn>3</mn><mo>+</mo><mn>0</mn><mo>+</mo><mn>4</mn></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">[</mo><mtable columnalign=\"center\" columnspacing=\"1em\" rowspacing=\"4pt\"><mtr><mtd><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mrow data-mjx-texclass=\"ORD\"><mn>1</mn></mrow></mpadded></mstyle></mtd></mtr><mtr><mtd><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>1</mn></mrow></mpadded></mstyle></mtd></mtr><mtr><mtd><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mrow data-mjx-texclass=\"ORD\"><mn>1</mn></mrow></mpadded></mstyle></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
