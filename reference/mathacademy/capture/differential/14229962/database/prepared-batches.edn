9b6bb-a27d-584f-935a-b35adacb11c6" :step/next "step-1d52e92a-c60f-53ce-b6fa-3a5a9d253411" :db/ensure [:step/validate]} {:db/id "step-1d52e92a-c60f-53ce-b6fa-3a5a9d253411" :step/id #uuid "1d52e92a-c60f-53ce-b6fa-3a5a9d253411" :step/content "question-47594296-da7d-5903-b008-c5f5265a8817" :step/next "step-96a34648-e1ed-5f17-886a-1b36c08e876b" :db/ensure [:step/validate]} {:db/id "step-96a34648-e1ed-5f17-886a-1b36c08e876b" :step/id #uuid "96a34648-e1ed-5f17-886a-1b36c08e876b" :step/content 17592186208956 :step/next "step-bb0a810a-de11-5a10-9c67-4ea3706facd1" :db/ensure [:step/validate]} {:db/id "step-bb0a810a-de11-5a10-9c67-4ea3706facd1" :step/id #uuid "bb0a810a-de11-5a10-9c67-4ea3706facd1" :step/content "question-a5918743-e3c0-5f81-afbc-29edc571e474" :step/next "step-c01795f1-6dd3-5dc6-bcdb-1c362f706315" :db/ensure [:step/validate]} {:db/id "step-c01795f1-6dd3-5dc6-bcdb-1c362f706315" :step/id #uuid "c01795f1-6dd3-5dc6-bcdb-1c362f706315" :step/content "question-c1ab528e-b16d-505b-916d-2fee71d7c43b" :db/ensure [:step/validate]}] "assertions" [["question-9669b6bb-a27d-584f-935a-b35adacb11c6" :question/id #uuid "9669b6bb-a27d-584f-935a-b35adacb11c6"] ["question-9669b6bb-a27d-584f-935a-b35adacb11c6" :question/math-academy-id "q-269476"] ["question-9669b6bb-a27d-584f-935a-b35adacb11c6" :question/problem "Consider the function $L:{R}^{2}\\to R$ defined by $L(x)=(Ax-b)^{T}(Ax-b)$ where \n\n$$\nA=[\\begin{aligned}1 & 2 \\\\ 4 & 0\\end{aligned}],\\,b=[\\begin{aligned}3 \\\\ 5\\end{aligned}].\n$$\n\nWhat is ${∇}_{x}L(x)$ at $x=[\\begin{aligned}3 \\\\ -1\\end{aligned}]?$"] ["question-9669b6bb-a27d-584f-935a-b35adacb11c6" :question/worked-solution "We can solve this problem by applying the chain rule for gradients.\n\nLet $y=Ax-b.$ Then, $L(x)={y}^{T}y,$ and\n\n$$\n{∇}_{x}L={(\\frac{\\text{d}L}{\\text{d}x})}^{T}={(\\frac{\\text{d}y}{\\text{d}x})}^{T}\\cdot {(\\frac{\\text{d}L}{\\text{d}y})}^{T}.\n$$\n\nNow, since \n\n$$\n\\frac{\\text{d}}{\\text{d}y}({y}^{T}y)=2{y}^{T}\\,\\text{and}\\,\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}}{\\text{d}x}(Ax-b)=A,\n$$\n\nwe have that \n\n$$\n\\begin{aligned}{∇}_{x}L & ={(\\frac{\\text{d}y}{\\text{d}x})}^{T}\\cdot {(\\frac{\\text{d}L}{\\text{d}y})}^{T} \\\\  & ={A}^{T}\\cdot 2y.\\end{aligned}\n$$\n\nEvaluating at $x=[\\begin{aligned}3 \\\\ -1\\end{aligned}]$, we get\n\n$$\n\\begin{aligned}{∇}_{x}L & ={A}^{T}\\cdot 2y \\\\  & =2\\cdot {A}^{T}(Ax-b) \\\\  & =2\\cdot {[\\begin{aligned}1 & 2 \\\\ 4 & 0\\end{aligned}]}^{T}([\\begin{aligned}1 & 2 \\\\ 4 & 0\\end{aligned}]\\cdot [\\begin{aligned}3 \\\\ -1\\end{aligned}]-[\\begin{aligned}3 \\\\ 5\\end{aligned}]) \\\\  & =2\\cdot [\\begin{aligned}1 & 4 \\\\ 2 & 0\\end{aligned}]([\\begin{aligned}1 \\\\ 12\\end{aligned}]-[\\begin{aligned}3 \\\\ 5\\end{aligned}]) \\\\  & =[\\begin{aligned}2 & 8 \\\\ 4 & 0\\end{aligned}][\\begin{aligned}-2 \\\\ 7\\end{aligned}] \\\\  & =[\\begin{aligned}52 \\\\ -8\\end{aligned}].\\end{aligned}\n$$"] ["question-9669b6bb-a27d-584f-935a-b35adacb11c6" :question/difficulty :question.difficulty/easy] ["answer-field-6730a75f-f272-5493-a8bf-085f7b4def46" :answer-field/id #uuid "6730a75f-f272-5493-a8bf-085f7b4def46"] ["answer-d8c321cc-baeb-5602-885c-ed6669f5d604" :answer/id #uuid "d8c321cc-baeb-5602-885c-ed6669f5d604"] ["answer-d8c321cc-baeb-5602-885c-ed6669f5d604" :answer/type :answer.type/math] ["answer-d8c321cc-baeb-5602-885c-ed6669f5d604" :answer/value "[\\begin{aligned}-2 & 7\\end{aligned}]"] ["answer-30da5234-4042-5fab-bc17-28a88bfb9de4" :answer/id #uuid "30da5234-4042-5fab-bc17-28a88bfb9de4"] ["answer-30da5234-4042-5fab-bc17-28a88bfb9de4" :answer/type :answer.type/math] ["answer-30da5234-4042-5fab-bc17-28a88bfb9de4" :answer/value "[\\begin{aligned}-26 \\\\ 4\\end{aligned}]"] ["answer-868cbcd3-651b-5e03-a865-b0dfaf92d893" :answer/id #uuid "868cbcd3-651b-5e03-a865-b0dfaf92d893"] ["answer-868cbcd3-651b-5e03-a865-b0dfaf92d893" :answer/type :answer.type/math] ["answer-868cbcd3-651b-5e03-a865-b0dfaf92d893" :answer/value "[\\begin{aligned}13 \\\\ 32\\end{aligned}]"] ["answer-37e4fbe8-c0f7-58ed-9b71-06218e634007" :answer/id #uuid "37e4fbe8-c0f7-58ed-9b71-06218e634007"] ["answer-37e4fbe8-c0f7-58ed-9b71-06218e634007" :answer/type :answer.type/math] ["answer-37e4fbe8-c0f7-58ed-9b71-06218e634007" :answer/value "[\\begin{aligned}28 & -16\\end{aligned}]"] ["answer-d0501560-e02a-5299-a647-3098cd11d592" :answer/id #uuid "d0501560-e02a-5299-a647-3098cd11d592"] ["answer-d0501560-e02a-5299-a647-3098cd11d592" :answer/type :answer.type/math] ["answer-d0501560-e02a-5299-a647-3098cd11d592" :answer/value "[\\begin{aligned}52 \\\\ -8\\end{aligned}]"] ["answer-field-6730a75f-f272-5493-a8bf-085f7b4def46" :answer-field/key "selection"] ["answer-field-6730a75f-f272-5493-a8bf-085f7b4def46" :answer-field/type :answer-field.type/radio] ["answer-field-6730a75f-f272-5493-a8bf-085f7b4def46" :answer-field/correct "answer-d0501560-e02a-5299-a647-3098cd11d592"] ["answer-field-6730a75f-f272-5493-a8bf-085f7b4def46" :answer-field/choices "answer-d8c321cc-baeb-5602-885c-ed6669f5d604"] ["answer-field-6730a75f-f272-5493-a8bf-085f7b4def46" :answer-field/choices "answer-30da5234-4042-5fab-bc17-28a88bfb9de4"] ["answer-field-6730a75f-f272-5493-a8bf-085f7b4def46" :answer-field/choices "answer-868cbcd3-651b-5e03-a865-b0dfaf92d893"] ["answer-field-6730a75f-f272-5493-a8bf-085f7b4def46" :answer-field/choices "answer-37e4fbe8-c0f7-58ed-9b71-06218e634007"] ["answer-field-6730a75f-f272-5493-a8bf-085f7b4def46" :answer-field/choices "answer-d0501560-e02a-5299-a647-3098cd11d592"] ["question-9669b6bb-a27d-584f-935a-b35adacb11c6" :question/answer-fields "answer-field-6730a75f-f272-5493-a8bf-085f7b4def46"] [17592186208848 :knowledge-point/questions "question-9669b6bb-a27d-584f-935a-b35adacb11c6"] ["question-47594296-da7d-5903-b008-c5f5265a8817" :question/id #uuid "47594296-da7d-5903-b008-c5f5265a8817"] ["question-47594296-da7d-5903-b008-c5f5265a8817" :question/math-academy-id "q-269489"] ["question-47594296-da7d-5903-b008-c5f5265a8817" :question/problem "Consider the function $L:{R}^{2}\\to R$ defined by $L(x)={(\\frac{1}{2}Ax-b)}^{T}(\\frac{1}{2}Ax-b)$ where \n\n$$\nA=[\\begin{aligned}2 & 1 \\\\ 4 & 3\\end{aligned}],\\,b=[\\begin{aligned}5 \\\\ 3\\end{aligned}].\n$$\n\nWhat is ${∇}_{x}L(x)$ at $x=[\\begin{aligned}7 \\\\ 2\\end{aligned}]?$"] ["question-47594296-da7d-5903-b008-c5f5265a8817" :question/worked-solution "We can solve this problem by applying the chain rule for gradients.\n\nLet $y=\\frac{1}{2}Ax-b.$ Then, $L(x)={y}^{T}y,$ and\n\n$$\n{∇}_{x}L={(\\frac{\\text{d}L}{\\text{d}x})}^{T}={(\\frac{\\text{d}y}{\\text{d}x})}^{T}\\cdot {(\\frac{\\text{d}L}{\\text{d}y})}^{T}.\n$$\n\nNow, since \n\n$$\n\\frac{\\text{d}}{\\text{d}y}({y}^{T}y)=2{y}^{T}\\,\\text{and}\\,\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}Ax-b)=\\frac{1}{2}A,\n$$\n\nwe have that \n\n$$\n\\begin{aligned}{∇}_{x}L & ={(\\frac{\\text{d}y}{\\text{d}x})}^{T}\\cdot {(\\frac{\\text{d}L}{\\text{d}y})}^{T} \\\\  & ={(\\frac{1}{2}A)}^{T}\\cdot 2y.\\end{aligned}\n$$\n\nEvaluating at $x=[\\begin{aligned}7 \\\\ 2\\end{aligned}]$, we get\n\n$$\n\\begin{aligned}{∇}_{x}L & ={(\\frac{1}{2}A)}^{T}\\cdot 2y \\\\  & ={A}^{T}(\\frac{1}{2}Ax-b) \\\\  & ={[\\begin{aligned}2 & 1 \\\\ 4 & 3\\end{aligned}]}^{T}(\\frac{1}{2}\\cdot [\\begin{aligned}2 & 1 \\\\ 4 & 3\\end{aligned}]\\cdot [\\begin{aligned}7 \\\\ 2\\end{aligned}]-[\\begin{aligned}5 \\\\ 3\\end{aligned}]) \\\\  & =[\\begin{aligned}2 & 4 \\\\ 1 & 3\\end{aligned}](\\frac{1}{2}\\cdot [\\begin{aligned}16 \\\\ 34\\end{aligned}]-[\\begin{aligned}5 \\\\ 3\\end{aligned}]) \\\\  & =[\\begin{aligned}2 & 4 \\\\ 1 & 3\\end{aligned}]([\\begin{aligned}8 \\\\ 17\\end{aligned}]-[\\begin{aligned}5 \\\\ 3\\end{aligned}]) \\\\  & =[\\begin{aligned}2 & 4 \\\\ 1 & 3\\end{aligned}][\\begin{aligned}3 \\\\ 14\\end{aligned}] \\\\  & =[\\begin{aligned}62 \\\\ 45\\end{aligned}].\\end{aligned}\n$$"] ["question-47594296-da7d-5903-b008-c5f5265a8817" :question/difficulty :question.difficulty/easy] ["answer-field-560cd508-cebe-5335-8021-8a9e70cdc673" :answer-field/id #uuid "560cd508-cebe-5335-8021-8a9e70cdc673"] ["answer-f9195545-d1e3-513f-91e6-f5228e90b375" :answer/id #uuid "f9195545-d1e3-513f-91e6-f5228e90b375"] ["answer-f9195545-d1e3-513f-91e6-f5228e90b375" :answer/type :answer.type/math] ["answer-f9195545-d1e3-513f-91e6-f5228e90b375" :answer/value "[\\begin{aligned}15 & 31\\end{aligned}]"] ["answer-b3b3471b-58e2-538a-96d3-b94d24b16af3" :answer/id #uuid "b3b3471b-58e2-538a-96d3-b94d24b16af3"] ["answer-b3b3471b-58e2-538a-96d3-b94d24b16af3" :answer/type :answer.type/math] ["answer-b3b3471b-58e2-538a-96d3-b94d24b16af3" :answer/value "[\\begin{aligned}15 \\\\ 31\\end{aligned}]"] ["answer-0a31093c-3bc1-5604-8b68-60bb29456071" :answer/id #uuid "0a31093c-3bc1-5604-8b68-60bb29456071"] ["answer-0a31093c-3bc1-5604-8b68-60bb29456071" :answer/type :answer.type/math] ["answer-0a31093c-3bc1-5604-8b68-60bb29456071" :answer/value "[\\begin{aligned}21 \\\\ 25\\end{aligned}]"] ["answer-55bb8ae9-83ab-5bd6-b3fa-7323cb3b3ab7" :answer/id #uuid "55bb8ae9-83ab-5bd6-b3fa-7323cb3b3ab7"] ["answer-55bb8ae9-83ab-5bd6-b3fa-7323cb3b3ab7" :answer/type :answer.type/math] ["answer-55bb8ae9-83ab-5bd6-b3fa-7323cb3b3ab7" :answer/value "[\\begin{aligned}62 & 45\\end{aligned}]"] ["answer-1c236ae5-4aa5-5314-b3d7-d9f14364f42d" :answer/id #uuid "1c236ae5-4aa5-5314-b3d7-d9f14364f42d"] ["answer-1c236ae5-4aa5-5314-b3d7-d9f14364f42d" :answer/type :answer.type/math] ["answer-1c236ae5-4aa5-5314-b3d7-d9f14364f42d" :answer/value "[\\begin{aligned}62 \\\\ 45\\end{aligned}]"] ["answer-field-560cd508-cebe-5335-8021-8a9e70cdc673" :answer-field/key "selection"] ["answer-field-560cd508-cebe-5335-8021-8a9e70cdc673" :answer-field/type :answer-field.type/radio] ["answer-field-560cd508-cebe-5335-8021-8a9e70cdc673" :answer-field/correct "answer-1c236ae5-4aa5-5314-b3d7-d9f14364f42d"] ["answer-field-560cd508-cebe-5335-8021-8a9e70cdc673" :answer-field/choices "answer-f9195545-d1e3-513f-91e6-f5228e90b375"] ["answer-field-560cd508-cebe-5335-8021-8a9e70cdc673" :answer-field/choices "answer-b3b3471b-58e2-538a-96d3-b94d24b16af3"] ["answer-field-560cd508-cebe-5335-8021-8a9e70cdc673" :answer-field/choices "answer-0a31093c-3bc1-5604-8b68-60bb29456071"] ["answer-field-560cd508-cebe-5335-8021-8a9e70cdc673" :answer-field/choices "answer-55bb8ae9-83ab-5bd6-b3fa-7323cb3b3ab7"] ["answer-field-560cd508-cebe-5335-8021-8a9e70cdc673" :answer-field/choices "answer-1c236ae5-4aa5-5314-b3d7-d9f14364f42d"] ["question-47594296-da7d-5903-b008-c5f5265a8817" :question/answer-fields "answer-field-560cd508-cebe-5335-8021-8a9e70cdc673"] [17592186208848 :knowledge-point/questions "question-47594296-da7d-5903-b008-c5f5265a8817"] [17592186208956 :question/problem "Compute the gradient of the function $f:{R}^{3}\\to R$ defined by\n\n$$\nf(x)={x}^{T}[\\begin{aligned}1 & 2 & 0 \\\\ 0 & -1 & 1 \\\\ 2 & 1 & 3\\end{aligned}]x\n$$\n\nwith respect to $x$ at  $x={[\\begin{aligned}1 & 0 & -1\\end{aligned}]}^{T}.$\n\n<table cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"70px\" rowspan=\"3\" width=\"30px\">$\\,{∇}_{x}f=\\,\\,$</td>\n<td align=\"center\" height=\"35px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>"] [17592186208956 :question/worked-solution "Defining the matrix $A$ as\n\n$$\nA=[\\begin{aligned}1 & 2 & 0 \\\\ 0 & -1 & 1 \\\\ 2 & 1 & 3\\end{aligned}],\n$$\n\nwe have $f(x)={x}^{T}Ax.$\n\nSince $A$ is not symmetric, we use the more general formula for the gradient of a quadratic function:\n\n$$\n{∇}_{x}f(x)=({A}^{T}+A)x\n$$\n\nFirst, we compute\n\n$$\n{A}^{T}=[\\begin{aligned}1 & 0 & 2 \\\\ 2 & -1 & 1 \\\\ 0 & 1 & 3\\end{aligned}],\n$$\n\nwhich gives\n\n$$\n\\begin{aligned}{A}^{T}+A & =[\\begin{aligned}1 & 0 & 2 \\\\ 2 & -1 & 1 \\\\ 0 & 1 & 3\\end{aligned}]+[\\begin{aligned}1 & 2 & 0 \\\\ 0 & -1 & 1 \\\\ 2 & 1 & 3\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 2 & 2 \\\\ 2 & -2 & 2 \\\\ 2 & 2 & 6\\end{aligned}].\\end{aligned}\n$$\n\nNow, compute the gradient at $x=[\\begin{aligned}1 \\\\ 0 \\\\ -1\\end{aligned}]:$\n\n$$\n\\begin{aligned}{∇}_{x}f(x) & =({A}^{T}+A)x \\\\  & =[\\begin{aligned}2 & 2 & 2 \\\\ 2 & -2 & 2 \\\\ 2 & 2 & 6\\end{aligned}][\\begin{aligned}1 \\\\ 0 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}2-2 \\\\ 2-2 \\\\ 2-6\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 0 \\\\ -4\\end{aligned}]\\end{aligned}\n$$"] [17592186208956 :question/difficulty :question.difficulty/moderate] ["answer-5c297385-0d1a-5107-874a-c1a917db787a" :answer/id #uuid "5c297385-0d1a-5107-874a-c1a917db787a"] ["answer-5c297385-0d1a-5107-874a-c1a917db787a" :answer/type :answer.type/math] ["answer-5c297385-0d1a-5107-874a-c1a917db787a" :answer/value "0"] [17592186205483 :answer-field/correct "answer-5c297385-0d1a-5107-874a-c1a917db787a"] [17592186205483 :answer-field/choices "answer-5c297385-0d1a-5107-874a-c1a917db787a"] ["answer-e894abe3-5313-5592-b411-4e2a239ad1f5" :answer/id #uuid "e894abe3-5313-5592-b411-4e2a239ad1f5"] ["answer-e894abe3-5313-5592-b411-4e2a239ad1f5" :answer/type :answer.type/math] ["answer-e894abe3-5313-5592-b411-4e2a239ad1f5" :answer/value "0"] [17592186205484 :answer-field/correct "answer-e894abe3-5313-5592-b411-4e2a239ad1f5"] [17592186205484 :answer-field/choices "answer-e894abe3-5313-5592-b411-4e2a239ad1f5"] ["answer-98db11c5-6460-500c-9ec8-23a74a1cf7f1" :answer/id #uuid "98db11c5-6460-500c-9ec8-23a74a1cf7f1"] ["answer-98db11c5-6460-500c-9ec8-23a74a1cf7f1" :answer/type :answer.type/math] ["answer-98db11c5-6460-500c-9ec8-23a74a1cf7f1" :answer/value "-4"] [17592186205482 :answer-field/correct "answer-98db11c5-6460-500c-9ec8-23a74a1cf7f1"] [17592186205482 :answer-field/choices "answer-98db11c5-6460-500c-9ec8-23a74a1cf7f1"] ["question-a5918743-e3c0-5f81-afbc-29edc571e474" :question/id #uuid "a5918743-e3c0-5f81-afbc-29edc571e474"] ["question-a5918743-e3c0-5f81-afbc-29edc571e474" :question/math-academy-id "q-276048"] ["question-a5918743-e3c0-5f81-afbc-29edc571e474" :question/problem "Compute the gradient of the function $f:{R}^{3}\\to R$ defined by\n\n$$\nf(x)={x}^{T}[\\begin{aligned}2 & -4 & 1 \\\\ 1 & 2 & 1 \\\\ -4 & 1 & 2\\end{aligned}]x\n$$\n\nwith respect to $x$ at  $x={[\\begin{aligned}1 & 0 & 1\\end{aligned}]}^{T}.$\n\n<table cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"70px\" rowspan=\"3\" width=\"30px\">$\\,{∇}_{x}f=\\,\\,$</td>\n<td align=\"center\" height=\"35px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>"] ["question-a5918743-e3c0-5f81-afbc-29edc571e474" :question/worked-solution "Defining the matrix $A$ as\n\n$$\nA=[\\begin{aligned}2 & -4 & 1 \\\\ 1 & 2 & 1 \\\\ -4 & 1 & 2\\end{aligned}],\n$$\n\nwe have $f(x)={x}^{T}Ax.$\n\nSince $A$ is not symmetric, we use the more general formula for the gradient of a quadratic function:\n\n$$\n{∇}_{x}f(x)=({A}^{T}+A)x\n$$\n\nFirst, we compute\n\n$$\n{A}^{T}=[\\begin{aligned}2 & 1 & -4 \\\\ -4 & 2 & 1 \\\\ 1 & 1 & 2\\end{aligned}],\n$$\n\nwhich gives\n\n$$\n\\begin{aligned}{A}^{T}+A & =[\\begin{aligned}2 & 1 & -4 \\\\ -4 & 2 & 1 \\\\ 1 & 1 & 2\\end{aligned}]+[\\begin{aligned}2 & -4 & 1 \\\\ 1 & 2 & 1 \\\\ -4 & 1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}4 & -3 & -3 \\\\ -3 & 4 & 2 \\\\ -3 & 2 & 4\\end{aligned}].\\end{aligned}\n$$\n\nNow, compute the gradient at $x=[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}]:$\n\n$$\n\\begin{aligned}{∇}_{x}f(x) & =({A}^{T}+A)x \\\\  & =[\\begin{aligned}4 & -3 & -3 \\\\ -3 & 4 & 2 \\\\ -3 & 2 & 4\\end{aligned}][\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}4+0-3 \\\\ -3+0+2 \\\\ -3+0+4\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}]\\end{aligned}\n$$"] ["question-a5918743-e3c0-5f81-afbc-29edc571e474" :question/difficulty :question.difficulty/moderate] ["answer-field-2bf6b302-f637-57b2-adae-46550fb30727" :answer-field/id #uuid "2bf6b302-f637-57b2-adae-46550fb30727"] ["answer-2fb6d754-9286-52ab-915e-9127fde342e4" :answer/id #uuid "2fb6d754-9286-52ab-915e-9127fde342e4"] ["answer-2fb6d754-9286-52ab-915e-9127fde342e4" :answer/type :answer.type/math] ["answer-2fb6d754-9286-52ab-915e-9127fde342e4" :answer/value "1"] ["answer-field-2bf6b302-f637-57b2-adae-46550fb30727" :answer-field/key "field-1"] ["answer-field-2bf6b302-f637-57b2-adae-46550fb30727" :answer-field/type :answer-field.type/blank] ["answer-field-2bf6b302-f637-57b2-adae-46550fb30727" :answer-field/correct "answer-2fb6d754-9286-52ab-915e-9127fde342e4"] ["answer-field-2bf6b302-f637-57b2-adae-46550fb30727" :answer-field/choices "answer-2fb6d754-9286-52ab-915e-9127fde342e4"] ["answer-field-f1e236be-702b-5322-84e4-5f890b250c18" :answer-field/id #uuid "f1e236be-702b-5322-84e4-5f890b250c18"] ["answer-e5e26d13-ce9d-5624-97e1-8731144ac5ec" :answer/id #uuid "e5e26d13-ce9d-5624-97e1-8731144ac5ec"] ["answer-e5e26d13-ce9d-5624-97e1-8731144ac5ec" :answer/type :answer.type/math] ["answer-e5e26d13-ce9d-5624-97e1-8731144ac5ec" :answer/value "-1"] ["answer-field-f1e236be-702b-5322-84e4-5f890b250c18" :answer-field/key "field-2"] ["answer-field-f1e236be-702b-5322-84e4-5f890b250c18" :answer-field/type :answer-field.type/blank] ["answer-field-f1e236be-702b-5322-84e4-5f890b250c18" :answer-field/correct "answer-e5e26d13-ce9d-5624-97e1-8731144ac5ec"] ["answer-field-f1e236be-702b-5322-84e4-5f890b250c18" :answer-field/choices "answer-e5e26d13-ce9d-5624-97e1-8731144ac5ec"] ["answer-field-de9698c5-7299-5ef3-a8c