#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186524075} :activity/id #uuid "eb21dc6b-2d80-592a-b7a0-6c3fee156a8e" :activity/scope {:db/id #edb/ref 17592186050205 :topic/id #uuid "36128875-8025-5e37-8397-54d8247d47c9" :topic/math-academy-id 3131} :activity/steps [{:db/id #edb/ref 17592186524058 :step/content {:db/id #edb/ref 17592186412767 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "540c0dc8-bcd9-54af-927a-97418f253efe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186412761} {:answer/id #uuid "5a97219a-abbc-57e2-b1d2-b514ebfcc818" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11" :db/id #edb/ref 17592186412762} {:answer/id #uuid "679d7be2-afd4-56e4-a222-6d038f0fed97" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\sqrt{2}" :db/id #edb/ref 17592186412763} {:answer/id #uuid "7ae8a743-3acf-5070-9428-27ae75be7fae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186412764} {:answer/id #uuid "ddda3679-2b94-54f4-b126-2775a43b783a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{11}" :db/id #edb/ref 17592186412765}] :answer-field/correct {:db/id #edb/ref 17592186412765} :answer-field/id #uuid "31f990c5-9445-506b-958c-e6c3b52764dd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186412766}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d906fadc-a9c3-53a2-ad5f-49a5ac38ab8d" :question/math-academy-id "q-139532" :question/problem "A $2\\times 2$ matrix $A$ maps the unit circle $\\{x\\,|\\,‖x‖=1\\}$ from ${R}^{2}$ onto an ellipse in ${R}^{2}.$ Given that the eigenvalues of ${A}^{T}A$ are $11$ and $4,$ find the length of the ellipse's semi-major axis." :question/worked-solution "The matrix $A$ maps the unit circle $\\{x\\,|\\,‖x‖=1\\}$ from ${R}^{2}$ onto the ellipse $\\{Ax\\,|\\,‖x‖=1\\}$ in ${R}^{2}.$\n\nFirst, let's re-write the squared distance from the origin to the point $Ax$ on our ellipse, as follows:\n\n$$\n\\begin{aligned}‖Ax{‖}^{2} & =(Ax)^{T}(Ax) \\\\  & =({x}^{T}\\,{A}^{T})(Ax) \\\\  & ={x}^{T}\\,({A}^{T}\\,A)x,\\end{aligned}\n$$\n\n  \n\nwhere ${x}^{T}({A}^{T}A)x$ is the quadratic form with the matrix ${A}^{T}A.$ \n\nThe maximum value of this quadratic form, when $‖x‖=1,$ is equal to the largest eigenvalue of the matrix ${A}^{T}A.$\n\nSince the largest eigenvalue of ${A}^{T}A$ is $11,$ we obtain\n\n$$\n{max}_{‖x‖=1}\\{‖Ax{‖}^{2}\\}=11\\,⟹\\,{max}_{‖x‖=1}\\{‖Ax‖\\}=\\sqrt{11}.\n$$\n\n \n\nTherefore, the semi-major axis of our ellipse is $\\sqrt{11}.$"} :step/id #uuid "4b60e7be-0a56-5bba-9861-738aac8f8ee4" :step/next {:db/id #edb/ref 17592186524080}} {:db/id #edb/ref 17592186524075 :step/content {:db/id #edb/ref 17592186162360 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5884f354-e5d3-5445-b252-6177d7fb10d2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186266935} {:answer/id #uuid "59a2b792-bce2-5ab3-8129-3ed501c97fa1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186266941} {:answer/id #uuid "66a53c17-6cca-59e9-b3a7-10509d1e6f05" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186267055} {:answer/id #uuid "7ed785dc-de4a-56df-9005-91dc3382836b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186267261} {:answer/id #uuid "c268b638-dc68-5720-86dc-4bdf86ac9c78" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186267877}] :answer-field/correct {:db/id #edb/ref 17592186266941} :answer-field/id #uuid "71f2e673-2942-5733-b153-c9e00dd002b8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186268619}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b2e59ffd-322c-5739-bff6-4abbfbcffef1" :question/math-academy-id "q-139415" :question/problem "A $2\\times 3$ matrix $A$ maps the unit sphere $\\{x\\,|\\,‖x‖=1\\}$ from ${R}^{3}$ onto an ellipse in ${R}^{2}.$ Given that the eigenvalues of ${A}^{T}A$ are $5,$ $3,$ and $0,$ find the length of the ellipse's semi-major axis." :question/worked-solution "The matrix $A$ maps the unit sphere $\\{x\\,|\\,‖x‖=1\\}$ from ${R}^{3}$ onto the ellipse $\\{Ax\\,|\\,‖x‖=1\\}$ in ${R}^{2}.$\n\nFirst, let's re-write the squared distance from the origin to the point $Ax$ on our ellipse, as follows:\n\n$$\n\\begin{aligned}‖Ax{‖}^{2} & =(Ax)^{T}(Ax) \\\\  & =({x}^{T}\\,{A}^{T})(Ax) \\\\  & ={x}^{T}\\,({A}^{T}\\,A)x,\\end{aligned}\n$$\n\n  \n\nwhere ${x}^{T}({A}^{T}A)x$ is the quadratic form with the matrix ${A}^{T}A.$ \n\nThe maximum value of this quadratic form, when $‖x‖=1,$ is equal to the largest eigenvalue of the matrix ${A}^{T}A.$\n\nSince the largest eigenvalue of ${A}^{T}A$ is $5,$ we obtain\n\n$$\n{max}_{‖x‖=1}\\{‖Ax{‖}^{2}\\}=5\\,⟹\\,{max}_{‖x‖=1}\\{‖Ax‖\\}=\\sqrt{5}.\n$$\n\n \n\nTherefore, the semi-major axis of our ellipse is $\\sqrt{5}.$"} :step/id #uuid "8e86f3d8-3c6b-5dfb-8619-654db11074d9" :step/next {:db/id #edb/ref 17592186524058}} {:db/id #edb/ref 17592186524078 :step/content {:db/id #edb/ref 17592186269244 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2380798b-79b8-5bc8-8153-92b706b0d629" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$5$ and $\\sqrt{5}$" :db/id #edb/ref 17592186266470} {:answer/id #uuid "aa5c7d7d-7d57-554b-8590-31cd03b7bf50" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$8$ and $5$" :db/id #edb/ref 17592186267684} {:answer/id #uuid "bd57370c-6b04-52dc-acbe-5e2a687609ed" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$16$ and $\\sqrt{5}$" :db/id #edb/ref 17592186267839} {:answer/id #uuid "cca90f51-cb57-5f81-bcb5-412e125542b9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "${v}_{1}$ and ${v}_{1}$" :db/id #edb/ref 17592186267976} {:answer/id #uuid "f862619f-07c7-5287-9b92-80801fdc6ea1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$8{v}_{1}$ and $5{v}_{1}$" :db/id #edb/ref 17592186268344}] :answer-field/correct {:db/id #edb/ref 17592186267684} :answer-field/id #uuid "7c9e107d-8a8c-55a2-9d3c-26e1ff04f4aa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186268633}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f71d275b-8f83-5bf3-90f9-5e8ed34d76ff" :question/math-academy-id "q-139547" :question/problem "![](images/d4/d4947e37239d2ac2950b536d7afc2d0810ea713c437b7095a43e123d50ff2b34.png)\n\nA $2\\times 3$ matrix $A$ maps the unit sphere $\\{x\\,|\\,‖x‖=1\\}$ from ${R}^{3}$ onto an ellipse in ${R}^{2}.$ The corresponding ellipse and its principal axes are depicted in the diagram above. Given that ${v}_{1}$ and ${v}_{2}$ are unit eigenvectors of ${A}^{T}A,$ what are the nonzero singular values of $A?$" :question/worked-solution "Suppose $A$ is an $m\\times n$ matrix. Let \n\n$$\n\\{{v}_{1},{v}_{2}\\,…,{v}_{n}\\}\n$$\n\nbe an *orthonormal* basis of ${R}^{n}$ consisting of the eigenvectors of ${A}^{T}A$ with corresponding eigenvalues \n\n$$\n{\\lambda }_{1}\\ge {\\lambda }_{2}\\ge …\\ge {\\lambda }_{n}.\n$$\n\nThen,\n\n- ${\\sigma }_{1}=\\sqrt{{\\lambda }_{1}}$ is the length of $A{v}_{1},$\n\n- ${\\sigma }_{2}=\\sqrt{{\\lambda }_{2}}$ is the length of $A{v}_{2},$\n\n- $⋯$\n\nIn our example, we see that\n\n- $||A{v}_{1}||=8={\\sigma }_{1},$ and\n\n- $||A{v}_{2}||=5={\\sigma }_{2}.$\n\nTherefore, the nonzero singular values of $A$ are ${\\sigma }_{1}=8$ and ${\\sigma }_{2}=5.$"} :step/id #uuid "9127aacb-30a9-55a4-8d76-24d419b593cf" :step/next {:db/id #edb/ref 17592186524093}} {:db/id #edb/ref 17592186524080 :step/content {:db/id #edb/ref 17592186369741 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07e2bd31-1a71-5fa9-80bb-5391989330e7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{5}" :db/id #edb/ref 17592186369743} {:answer/id #uuid "f61dae6c-bf45-5d4f-8713-28f56aef6853" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186369744} {:answer/id #uuid "8563b272-2537-5a12-ba5d-b5eebc0e5b79" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186369745} {:answer/id #uuid "9e80d123-7a67-5ff4-beb6-4b523e939500" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186369746} {:answer/id #uuid "d9f5cee2-8204-52ac-a8d9-4f4e81a7c0ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186369747}] :answer-field/correct {:db/id #edb/ref 17592186369745} :answer-field/id #uuid "0b618b69-53f8-5721-89d5-02c9360f4137" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186369742}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "dd29d329-0104-5ef8-b69c-cd8c21549714" :question/math-academy-id "q-139544" :question/problem "A $2\\times 3$ matrix $A$ maps the unit sphere $\\{x\\,|\\,‖x‖=1\\}$ from ${R}^{3}$ onto an ellipse in ${R}^{2}.$ Given that the singular values of $A$ are ${\\sigma }_{1}=8,$ ${\\sigma }_{2}=2\\sqrt{5},$ and ${\\sigma }_{3}=0,$ find the length of the semi-major axis of the ellipse." :question/worked-solution "The matrix $A$ maps the unit sphere $\\{x\\,|\\,‖x‖=1\\}$ from ${R}^{3}$ onto the ellipse $\\{Ax\\,|\\,‖x‖=1\\}$ in ${R}^{2}.$\n\nFirst, let's re-write the squared distance from the origin to the point $Ax$ on our ellipse, as follows:\n\n$$\n\\begin{aligned}‖Ax{‖}^{2} & =(Ax)^{T}(Ax) \\\\  & =({x}^{T}\\,{A}^{T})(Ax) \\\\  & ={x}^{T}\\,({A}^{T}\\,A)x,\\end{aligned}\n$$\n\n  \n\nwhere ${x}^{T}({A}^{T}A)x$ is the quadratic form with the symmetric matrix ${A}^{T}A.$ \n\nThe maximum value of this quadratic form, when $‖x‖=1,$ is equal to the largest eigenvalue of the matrix ${A}^{T}A.$ \n\nThe square roots of the eigenvalues of ${A}^{T}A$ are called the *singular values* of $A.$ Since the largest singular value of $A$ is ${\\sigma }_{1}=8,$ the largest eigenvalue of ${A}^{T}A$ must be ${\\lambda }_{1}={\\sigma }_{1}^{2}={8}^{2}.$ So, we obtain that\n\n$$\n{max}_{‖x‖=1}\\{‖Ax{‖}^{2}\\}={8}^{2}\\,⟹\\,{max}_{‖x‖=1}\\{‖Ax‖\\}=8.\n$$\n\n \n\nTherefore, the semi-major axis of our ellipse is ${\\sigma }_{1}=8.$"} :step/id #uuid "9ba70a3c-71a0-5cb6-a4db-f475dda224da" :step/next {:db/id #edb/ref 17592186524078}} {:db/id #edb/ref 17592186524093 :step/content {:db/id #edb/ref 17592186383431 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be3ba996-d9c0-57d3-95cc-5f43b21decb6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{v}_{1}" :db/id #edb/ref 17592186383433} {:answer/id #uuid "4bbea375-60a4-5dc4-b6be-dd9b80d209fb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{v}_{2}" :db/id #edb/ref 17592186383434} {:answer/id #uuid "85175ea8-b77f-56c3-83e4-10dd48da9dc3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "A{v}_{2}" :db/id #edb/ref 17592186383435} {:answer/id #uuid "98ae820c-445e-5ef8-bf8b-2b43811699d7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "A{v}_{1}" :db/id #edb/ref 17592186383436} {:answer/id #uuid "0a9af6f2-c869-5f00-9c07-d01d9bfe39e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "A{A}^{T}{v}_{1}" :db/id #edb/ref 17592186383437}] :answer-field/correct {:db/id #edb/ref 17592186383434} :answer-field/id #uuid "5c7c6fc9-8fb7-527f-ae85-2cdf815c3fbb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186383432}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "caf843b3-f2a1-5bdc-8d57-74ed37aa0fe2" :question/math-academy-id "q-139554" :question/problem "![](images/63/63d5de8c08559ecc88b4fd7e2184204a1e6ea2f8a9e8ca6af7959e2354876e3f.png)\n\nA $2\\times 2$ matrix $A$ maps the unit circle $\\{x\\,|\\,‖x‖=1\\}$ from ${R}^{2}$ onto an ellipse in ${R}^{2}.$ The corresponding ellipse and its principal axes are depicted in the diagram above. Given that ${v}_{1}$ and ${v}_{2}$ are unit eigenvectors of ${A}^{T}A,$ which of the following is an eigenvector corresponding to the eigenvalue $9$ of ${A}^{T}A?$" :question/worked-solution "Suppose $A$ is an $m\\times n$ matrix. Let \n\n$$\n\\{{v}_{1},{v}_{2}\\,…,{v}_{n}\\}\n$$\n\nbe an *orthonormal* basis of ${R}^{n}$ consisting of the eigenvectors of ${A}^{T}A$ with corresponding eigenvalues \n\n$$\n{\\lambda }_{1}\\ge {\\lambda }_{2}\\ge …\\ge {\\lambda }_{n}.\n$$\n\nThen,\n\n- ${\\sigma }_{1}=\\sqrt{{\\lambda }_{1}}$ is the length of $A{v}_{1},$\n\n- ${\\sigma }_{2}=\\sqrt{{\\lambda }_{2}}$ is the length of $A{v}_{2},$\n\n- $⋯$\n\nIn our example, we see that\n\n- $||A{v}_{1}||=5={\\sigma }_{1},$ which means that ${\\lambda }_{1}={5}^{2}=25,$ and\n\n- $||A{v}_{2}||=3={\\sigma }_{2},$ which means that ${\\lambda }_{2}={3}^{2}=9.$\n\nTherefore, an eigenvector corresponding to the eigenvalue ${\\lambda }_{2}=9$ of ${A}^{T}A$ is ${v}_{2}.$"} :step/id #uuid "c2b79e93-d3ce-53a6-844f-76207ef1c04e"}] :activity/title "The Singular Values of a Matrix" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186523246}]}
