#{[{:activity/expected-seconds 1500.0 :activity/first-step {:db/id #edb/ref 17592186097768} :activity/id #uuid "bcf1f74b-d9ee-56e5-90da-da3ec708d940" :activity/scope {:db/id #edb/ref 17592186048717 :topic/id #uuid "b8283a8a-2315-51fe-893d-3a6a1ab2b69b" :topic/math-academy-id 1037} :activity/steps [{:db/id #edb/ref 17592186097768 :step/content {:db/id #edb/ref 17592186097920 :tutorial/content "How can we calculate  $\\displaystyle{\\int} \\left(3\\sin^2 x + 3\\cos^2 x\\right ) \\, \\textrm{d}x?$\n\nWe can compute integrals like this using the Pythagorean trigonometric identity, \n\n$$\n\\sin^2 x + \\cos^2 x=1.\n$$\n\nSo, we evaluate our integral as follows: \n\n$$\n\\eqalign{\n\t\t\\int \\left(3\\sin^2 x+  3\\cos^2 x\\right ) \\, \\textrm{d}x  &=  \\int 3(\\underbrace{\\sin^2 x +\\cos^2 x }_1 )\\, \\textrm{d}x\\\n\t\t\t\t                                                                &=\\int 3(1) \\, \\textrm{d}x\\\n\t\t\t\t                                                                &=\\int 3  \\, \\textrm{d}x\\\n\t\t\t\t                                                                &=3x+C\n}\n$$\n\nLet's look at some more examples." :tutorial/id #uuid "3171a2df-43af-5bd4-9c34-07f328040063" :tutorial/math-academy-id 872 :tutorial/title "Introduction"} :step/id #uuid "4c6fbc0f-c349-5550-8676-2ff5b5b984a7" :step/math-academy-id 642639 :step/next {:db/id #edb/ref 17592186097769}} {:db/id #edb/ref 17592186097769 :step/content {:db/id #edb/ref 17592186096830 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096467 :question/id #uuid "a30b523c-d689-520a-a708-f3b5190eaf9d" :question/math-academy-id "e-477"} :knowledge-point/id #uuid "19a857ac-d36b-5753-a532-4f2a75612d85" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050783} {:db/id #edb/ref 17592186050932}] :knowledge-point/questions [{:db/id #edb/ref 17592186097279} {:db/id #edb/ref 17592186097313} {:db/id #edb/ref 17592186250251} {:db/id #edb/ref 17592186250252} {:db/id #edb/ref 17592186319116} {:db/id #edb/ref 17592186319117} {:db/id #edb/ref 17592186321013} {:db/id #edb/ref 17592186332716} {:db/id #edb/ref 17592186436437} {:db/id #edb/ref 17592186436438} {:db/id #edb/ref 17592186436441}] :knowledge-point/title "Integrating Using the Pythagorean Trigonometric Identity"} :step/id #uuid "2b957cfa-6b5d-5df2-89ac-644ed3f5b42a" :step/math-academy-id 642640 :step/next {:db/id #edb/ref 17592186097770}} {:db/id #edb/ref 17592186097770 :step/content {:db/id #edb/ref 17592186097921 :tutorial/content "The identities \n\n$$\n1+\\tan ^{2}x =\\sec ^{2}x\n$$\n\nand\n\n$$\n1+\\cot ^{2}x =\\csc ^{2}x\n$$\n\nare also called Pythagorean trigonometric identities. They can be used to solve certain integrals involving the expressions \n$\\tan^2 x$ or  $\\csc^2 x.$ Let's see their application in action!" :tutorial/id #uuid "9ef6112e-50d0-5806-b79e-1e7dfc7ff29f" :tutorial/math-academy-id 874 :tutorial/title "Calculating Integrals Using Related Identities"} :step/id #uuid "5081318f-440b-5b62-953a-57b481e1e408" :step/math-academy-id 642643 :step/next {:db/id #edb/ref 17592186097771}} {:db/id #edb/ref 17592186097771 :step/content {:db/id #edb/ref 17592186096831 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096468 :question/id #uuid "872b9d99-ea39-540f-af2e-acbfa28186b4" :question/math-academy-id "e-478"} :knowledge-point/id #uuid "9934a8da-2378-5019-a3a3-7cd66cbeeaa7" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048836}] :knowledge-point/questions [{:db/id #edb/ref 17592186096936} {:db/id #edb/ref 17592186097275} {:db/id #edb/ref 17592186241102} {:db/id #edb/ref 17592186250264} {:db/id #edb/ref 17592186250265} {:db/id #edb/ref 17592186250266} {:db/id #edb/ref 17592186250267} {:db/id #edb/ref 17592186250268} {:db/id #edb/ref 17592186321015} {:db/id #edb/ref 17592186321024} {:db/id #edb/ref 17592186321025} {:db/id #edb/ref 17592186323773} {:db/id #edb/ref 17592186332701} {:db/id #edb/ref 17592186342001} {:db/id #edb/ref 17592186342002} {:db/id #edb/re