#{[{:activity/expected-seconds 1500.0 :activity/first-step {:db/id #edb/ref 17592186097768} :activity/id #uuid "bcf1f74b-d9ee-56e5-90da-da3ec708d940" :activity/scope {:db/id #edb/ref 17592186048717 :topic/id #uuid "b8283a8a-2315-51fe-893d-3a6a1ab2b69b" :topic/math-academy-id 1037} :activity/steps [{:db/id #edb/ref 17592186097768 :step/content {:db/id #edb/ref 17592186097920 :tutorial/content "How can we calculate  $\\displaystyle{\\int} \\left(3\\sin^2 x + 3\\cos^2 x\\right ) \\, \\textrm{d}x?$\n\nWe can compute integrals like this using the Pythagorean trigonometric identity, \n\n$$\n\\sin^2 x + \\cos^2 x=1.\n$$\n\nSo, we evaluate our integral as follows: \n\n$$\n\\eqalign{\n\t\t\\int \\left(3\\sin^2 x+  3\\cos^2 x\\right ) \\, \\textrm{d}x  &=  \\int 3(\\underbrace{\\sin^2 x +\\cos^2 x }_1 )\\, \\textrm{d}x\\\n\t\t\t\t                                                                &=\\int 3(1) \\, \\textrm{d}x\\\n\t\t\t\t                                                                &=\\int 3  \\, \\textrm{d}x\\\n\t\t\t\t                                                                &=3x+C\n}\n$$\n\nLet's look at some more examples." :tutorial/id #uuid "3171a2df-43af-5bd4-9c34-07f328040063" :tutorial/math-academy-id 872 :tutorial/title "Introduction"} :step/id #uuid "4c6fbc0f-c349-5550-8676-2ff5b5b984a7" :step/math-academy-id 642639 :step/next {:db/id #edb/ref 17592186097769}} {:db/id #edb/ref 17592186097769 :step/content {:db/id #edb/ref 17592186096830 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096467 :question/id #uuid "a30b523c-d689-520a-a708-f3b5190eaf9d" :question/math-academy-id "e-477"} :knowledge-point/id #uuid "19a857ac-d36b-5753-a532-4f2a75612d85" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050783} {:db/id #edb/ref 17592186050932}] :knowledge-point/questions [{:db/id #edb/ref 17592186097279} {:db/id #edb/ref 17592186097313} {:db/id #edb/ref 17592186250251} {:db/id #edb/ref 17592186250252} {:db/id #edb/ref 17592186319116} {:db/id #edb/ref 17592186319117} {:db/id #edb/ref 17592186321013} {:db/id #edb/ref 17592186332716} {:db/id #edb/ref 17592186436437} {:db/id #edb/ref 17592186436438} {:db/id #edb/ref 17592186436441}] :knowledge-point/title "Integrating Using the Pythagorean Trigonometric Identity"} :step/id #uuid "2b957cfa-6b5d-5df2-89ac-644ed3f5b42a" :step/math-academy-id 642640 :step/next {:db/id #edb/ref 17592186097770}} {:db/id #edb/ref 17592186097770 :step/content {:db/id #edb/ref 17592186097921 :tutorial/content "The identities \n\n$$\n1+\\tan ^{2}x =\\sec ^{2}x\n$$\n\nand\n\n$$\n1+\\cot ^{2}x =\\csc ^{2}x\n$$\n\nare also called Pythagorean trigonometric identities. They can be used to solve certain integrals involving the expressions \n$\\tan^2 x$ or  $\\csc^2 x.$ Let's see their application in action!" :tutorial/id #uuid "9ef6112e-50d0-5806-b79e-1e7dfc7ff29f" :tutorial/math-academy-id 874 :tutorial/title "Calculating Integrals Using Related Identities"} :step/id #uuid "5081318f-440b-5b62-953a-57b481e1e408" :step/math-academy-id 642643 :step/next {:db/id #edb/ref 17592186097771}} {:db/id #edb/ref 17592186097771 :step/content {:db/id #edb/ref 17592186096831 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096468 :question/id #uuid "872b9d99-ea39-540f-af2e-acbfa28186b4" :question/math-academy-id "e-478"} :knowledge-point/id #uuid "9934a8da-2378-5019-a3a3-7cd66cbeeaa7" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048836}] :knowledge-point/questions [{:db/id #edb/ref 17592186096936} {:db/id #edb/ref 17592186097275} {:db/id #edb/ref 17592186241102} {:db/id #edb/ref 17592186250264} {:db/id #edb/ref 17592186250265} {:db/id #edb/ref 17592186250266} {:db/id #edb/ref 17592186250267} {:db/id #edb/ref 17592186250268} {:db/id #edb/ref 17592186321015} {:db/id #edb/ref 17592186321024} {:db/id #edb/ref 17592186321025} {:db/id #edb/ref 17592186323773} {:db/id #edb/ref 17592186332701} {:db/id #edb/ref 17592186342001} {:db/id #edb/ref 17592186342002} {:db/id #edb/ref 17592186436443} {:db/id #edb/ref 17592186436444} {:db/id #edb/ref 17592186436445} {:db/id #edb/ref 17592186493919} {:db/id #edb/ref 17592186493961}] :knowledge-point/title "Integrating Using the Secant-Tangent Identity"} :step/id #uuid "b8d0cb51-c01d-5216-97d7-3bae7eb4ce3f" :step/math-academy-id 642644 :step/next {:db/id #edb/ref 17592186097772}} {:db/id #edb/ref 17592186097772 :step/content {:db/id #edb/ref 17592186096832 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096469 :question/id #uuid "d7c09fca-2f4b-5a0a-b687-938527b44d62" :question/math-academy-id "e-479"} :knowledge-point/id #uuid "d0ba6d15-a20e-5f16-b324-0bbead5458ca" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050107}] :knowledge-point/questions [{:db/id #edb/ref 17592186096935} {:db/id #edb/ref 17592186097277} {:db/id #edb/ref 17592186241085} {:db/id #edb/ref 17592186241095} {:db/id #edb/ref 17592186250269} {:db/id #edb/ref 17592186250270} {:db/id #edb/ref 17592186250271} {:db/id #edb/ref 17592186250272} {:db/id #edb/ref 17592186321026} {:db/id #edb/ref 17592186321029} {:db/id #edb/ref 17592186323774} {:db/id #edb/ref 17592186323775} {:db/id #edb/ref 17592186323787} {:db/id #edb/ref 17592186323788} {:db/id #edb/ref 17592186332702} {:db/id #edb/ref 17592186341998} {:db/id #edb/ref 17592186341999} {:db/id #edb/ref 17592186364866} {:db/id #edb/ref 17592186436436}] :knowledge-point/title "Integrating Using the Cosecant-Cotangent Identity"} :step/id #uuid "c4d88508-3193-5834-945f-ea6d8fe36f65" :step/math-academy-id 642647 :step/next {:db/id #edb/ref 17592186097773}} {:db/id #edb/ref 17592186097773 :step/content {:db/id #edb/ref 17592186096833 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096470 :question/id #uuid "14ab2251-66fc-5f94-9821-f14fcc2c03e1" :question/math-academy-id "e-480"} :knowledge-point/id #uuid "fe5822b4-c5d4-59a8-bd72-a41d3074e4e6" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050489}] :knowledge-point/questions [{:db/id #edb/ref 17592186097272} {:db/id #edb/ref 17592186097276} {:db/id #edb/ref 17592186241109} {:db/id #edb/ref 17592186241112} {:db/id #edb/ref 17592186250273} {:db/id #edb/ref 17592186250274} {:db/id #edb/ref 17592186250275} {:db/id #edb/ref 17592186250277} {:db/id #edb/ref 17592186319121} {:db/id #edb/ref 17592186321031} {:db/id #edb/ref 17592186321036} {:db/id #edb/ref 17592186321037} {:db/id #edb/ref 17592186321038} {:db/id #edb/ref 17592186321039} {:db/id #edb/ref 17592186323789} {:db/id #edb/ref 17592186436439} {:db/id #edb/ref 17592186436440} {:db/id #edb/ref 17592186436442}] :knowledge-point/title "Integrating Trigonometric Expressions With Linear Arguments Using the Pythagorean Identities"} :step/id #uuid "fe29d081-db19-5a27-a1bc-c2c8c7893760" :step/math-academy-id 642650}] :activity/title "Integration Using the Pythagorean Identities" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186096846}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186494021} :activity/id #uuid "90eec35c-ddf7-5ea5-a497-a880f0806d02" :activity/scope {:db/id #edb/ref 17592186048717 :topic/id #uuid "b8283a8a-2315-51fe-893d-3a6a1ab2b69b" :topic/math-academy-id 1037} :activity/steps [{:db/id #edb/ref 17592186493988 :step/content {:db/id #edb/ref 17592186250269 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a05c2fc-f94d-5489-955e-6e93003cb216" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4(\\pi -2)" :db/id #edb/ref 17592186247662} {:answer/id #uuid "a3dc3121-d85d-555d-95fa-e1f130a553c4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{2}-1" :db/id #edb/ref 17592186248887} {:answer/id #uuid "a75bb911-b1a2-59de-ac5b-2d5b63e7d0b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-\\frac{\\pi }{4}" :db/id #edb/ref 17592186248911} {:answer/id #uuid "c53da061-88b8-5d38-9620-69fbe5f388d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi -3" :db/id #edb/ref 17592186249176} {:answer/id #uuid "e1bfdf52-8608-5e41-81ac-9c0e93199b37" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4-\\pi " :db/id #edb/ref 17592186249423}] :answer-field/correct {:db/id #edb/ref 17592186248911} :answer-field/id #uuid "a980c72c-15a0-5296-ad73-7e85baf7f354" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186249970}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3841fdbd-8341-5e24-9f59-0d6b99ab3106" :question/math-academy-id "q-114441" :question/problem "${\\int }_{\\pi /4}^{\\pi /2}{cot}^{2}⁡x\\,\\text{d}x=$" :question/worked-solution "In this case, we have to use the identity  $1+{cot}^{2}⁡x={csc}^{2}⁡x.$ Rearranging this gives\n\n$$\n{cot}^{2}⁡x={csc}^{2}⁡x-1.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{\\int }_{\\pi /4}^{\\pi /2}{cot}^{2}⁡x\\,\\text{d}x & ={\\int }_{\\pi /4}^{\\pi /2}({csc}^{2}⁡x-1)\\text{d}x \\\\  & =(-\\operatorname{cot}⁡x-x){|}_{\\pi /4}^{\\pi /2} \\\\  & =[-\\operatorname{cot}⁡(\\frac{\\pi }{2})-\\frac{\\pi }{2}]-[-\\operatorname{cot}⁡(\\frac{\\pi }{4})-\\frac{\\pi }{4}] \\\\  & =[-0-\\frac{\\pi }{2}]-[-1-\\frac{\\pi }{4}] \\\\  & =-\\frac{\\pi }{2}+1+\\frac{\\pi }{4} \\\\  & =1-\\frac{\\pi }{4}\\end{aligned}\n$$"} :step/id #uuid "31f912e5-8a70-534e-ac44-c11588546e18" :step/next {:db/id #edb/ref 17592186494063}} {:db/id #edb/ref 17592186493989 :step/content {:db/id #edb/ref 17592186493919 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b1be8b56-e0bc-581a-9ccb-692511badae8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{19}{8}" :db/id #edb/ref 17592186493679}] :answer-field/correct {:db/id #edb/ref 17592186493679} :answer-field/id #uuid "f5f4070c-c95c-5ed1-901f-4528153978ca" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186493886}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "43534459-b512-57ce-a24a-a07661c93918" :question/math-academy-id "q-352679" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1}^{3/2}\\frac{3{x}^{2}{tan}^{2}⁡x}{{sec}^{2}⁡x-1}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "First, we select the identity that contains a ${tan}^{2}⁡x$ term. So, we can use the identity \n\n$$\n1+{tan}^{2}⁡x={sec}^{2}⁡x.\n$$\n\nRearranging the above identity gives\n\n$$\n{sec}^{2}⁡x-1={tan}^{2}⁡x.\n$$\n\nUsing the above, we compute the given integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{3/2}\\frac{3{x}^{2}{tan}^{2}⁡x}{{sec}^{2}⁡x-1}\\,\\text{d}x & ={\\int }_{1}^{3/2}\\frac{3{x}^{2}{tan}^{2}⁡x}{{tan}^{2}⁡x}\\,\\text{d}x \\\\  & ={\\int }_{1}^{3/2}3{x}^{2}\\,\\text{d}x \\\\  & ={x}^{3}\\,{|}_{1}^{3/2} \\\\  & ={(\\frac{3}{2})}^{\\,3}-{1}^{3} \\\\  & =\\frac{27}{8}-1 \\\\  & =\\frac{19}{8}\\end{aligned}\n$$"} :step/id #uuid "32479e06-331d-52b3-9dbf-e9c2865786c4" :step/next {:db/id #edb/ref 17592186494020}} {:db/id #edb/ref 17592186494020 :step/content {:db/id #edb/ref 17592186321026 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8074fac7-a6e0-56cc-9165-137d0dae6a7c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186319780}] :answer-field/correct {:db/id #edb/ref 17592186319780} :answer-field/id #uuid "22e00bd0-c773-50bc-8df3-96880e42e321" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186320243}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "05d804be-1aa4-52f7-ac45-dafba61557ef" :question/math-academy-id "q-352697" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{\\pi /4}^{\\pi /2}(1+{cot}^{2}⁡x)\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "We use the cosecant-cotangent identity:\n\n$$\n1+{cot}^{2}⁡x={csc}^{2}⁡x.\n$$\n\nUsing the above, we compute the given integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{\\pi /4}^{\\pi /2}(1+{cot}^{2}⁡x)\\,\\text{d}x & ={\\int }_{\\pi /4}^{\\pi /2}{csc}^{2}⁡x\\,\\text{d}x \\\\  & =-\\operatorname{cot}⁡x\\,{|}_{\\pi /4}^{\\pi /2} \\\\  & =-\\operatorname{cot}⁡(\\frac{\\pi }{2})-(-\\operatorname{cot}⁡(\\frac{\\pi }{4})) \\\\  & =-0-(-1) \\\\  & =1\\end{aligned}\n$$"} :step/id #uuid "7c4b1db8-dd3d-50f2-843b-a8e34b2a05de"} {:db/id #edb/ref 17592186494021 :step/content {:db/id #edb/ref 17592186097276 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "120a969c-c232-5a6a-9ebc-f3876756aa9d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cot}⁡(\\frac{\\pi }{2}-x)+x+C" :db/id #edb/ref 17592186493422} {:answer/id #uuid "2f1ecc2b-8f38-5a56-b452-79a084abe981" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cot}⁡(\\frac{\\pi }{2}-x)-x+C" :db/id #edb/ref 17592186493470} {:answer/id #uuid "381e7704-3610-52d0-943d-11d2f5db4582" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{cot}⁡(\\frac{\\pi }{2}-x)+x+C" :db/id #edb/ref 17592186493483} {:answer/id #uuid "741642b8-40a1-5ddc-a062-46c687fc6284" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{cot}⁡(\\frac{\\pi }{2}-x)-x+C" :db/id #edb/ref 17592186493563} {:answer/id #uuid "da75dca0-cf1f-53aa-85b2-c756cac65ae8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}\\operatorname{cot}⁡(\\frac{\\pi }{2}-x)-x+C" :db/id #edb/ref 17592186493734}] :answer-field/correct {:db/id #edb/ref 17592186493470} :answer-field/id #uuid "d8ea9791-475d-59e1-8890-18149e61f29c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186095580}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e657762c-92c8-5c88-91d7-fe5813627920" :question/math-academy-id "q-49327" :question/problem "$\\int {cot}^{2}⁡(\\frac{\\pi }{2}-x)\\text{d}x=$" :question/worked-solution "From the identity $1+{cot}^{2}⁡\\theta ={csc}^{2}⁡\\theta $ with $\\theta =\\frac{\\pi }{2}-x,$ we get \n\n$$\n\\begin{aligned}1+{cot}^{2}⁡(\\frac{\\pi }{2}-x) & ={csc}^{2}⁡(\\frac{\\pi }{2}-x) \\\\ {cot}^{2}⁡(\\frac{\\pi }{2}-x) & ={csc}^{2}⁡(\\frac{\\pi }{2}-x)-1.\\end{aligned}\n$$\n\nSubstituting the above into our integral gives\n\n$$\n\\begin{aligned}\\int {cot}^{2}⁡(\\frac{\\pi }{2}-x)\\text{d}x & =\\int ({csc}^{2}⁡(\\frac{\\pi }{2}-x)-1)\\text{d}x \\\\  & =\\int {csc}^{2}⁡(\\frac{\\pi }{2}-x)\\text{d}x-\\int 1\\cdot \\text{d}x \\\\  & =\\operatorname{cot}⁡(\\frac{\\pi }{2}-x)-x+C.\\end{aligned}\n$$"} :step/id #uuid "7d91831c-a36e-5666-be56-1ca4b1240a11" :step/next {:db/id #edb/ref 17592186493988}} {:db/id #edb/ref 17592186494063 :step/content {:db/id #edb/ref 17592186493961 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d681392-0578-56c7-9fe2-42e3d7339e02" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186493615}] :answer-field/correct {:db/id #edb/ref 17592186493615} :answer-field/id #uuid "c2d075a9-50ba-561b-90ab-b8b2901e72d8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186493872}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d59d88c8-9c62-51d9-bd12-48f5c362cc67" :question/math-academy-id "q-352652" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\pi /3}\\frac{{tan}^{2}⁡x+1}{{sec}^{3}⁡x}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "In this case, we have to use the identity  $1+{tan}^{2}⁡x={sec}^{2}⁡x.$ Substituting this into our integral gives\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /3}\\frac{{tan}^{2}⁡x+1}{{sec}^{3}⁡x}\\,\\text{d}x & ={\\int }_{0}^{\\pi /3}\\frac{{sec}^{2}⁡x}{{sec}^{3}⁡x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /3}\\frac{1}{\\operatorname{sec}⁡x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /3}\\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =\\operatorname{sin}⁡x\\,{|}_{0}^{\\pi /3} \\\\  & =\\operatorname{sin}⁡(\\frac{\\pi }{3})-\\operatorname{sin}⁡0 \\\\  & =\\frac{\\sqrt{3}}{2}-0 \\\\  & =\\frac{\\sqrt{3}}{2}.\\end{aligned}\n$$"} :step/id #uuid "eb2c7d86-1bd5-50b3-96ee-f7bfe6f66eba" :step/next {:db/id #edb/ref 17592186493989}}] :activity/title "Integration Using the Pythagorean Identities" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186493380}]}
