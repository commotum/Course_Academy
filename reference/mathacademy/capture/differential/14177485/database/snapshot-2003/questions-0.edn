#{[{:db/id #edb/ref 17592186250269 :knowledge-point/_questions [{:db/id #edb/ref 17592186096832 :knowledge-point/id #uuid "d0ba6d15-a20e-5f16-b324-0bbead5458ca" :knowledge-point/title "Integrating Using the Cosecant-Cotangent Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a05c2fc-f94d-5489-955e-6e93003cb216" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4(\\pi -2)" :db/id #edb/ref 17592186247662} {:answer/id #uuid "a3dc3121-d85d-555d-95fa-e1f130a553c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}-1" :db/id #edb/ref 17592186248887} {:answer/id #uuid "a75bb911-b1a2-59de-ac5b-2d5b63e7d0b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\frac{\\pi }{4}" :db/id #edb/ref 17592186248911} {:answer/id #uuid "c53da061-88b8-5d38-9620-69fbe5f388d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi -3" :db/id #edb/ref 17592186249176} {:answer/id #uuid "e1bfdf52-8608-5e41-81ac-9c0e93199b37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4-\\pi " :db/id #edb/ref 17592186249423}] :answer-field/correct {:answer/id #uuid "a75bb911-b1a2-59de-ac5b-2d5b63e7d0b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\frac{\\pi }{4}" :db/id #edb/ref 17592186248911} :answer-field/id #uuid "a980c72c-15a0-5296-ad73-7e85baf7f354" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249970}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3841fdbd-8341-5e24-9f59-0d6b99ab3106" :question/math-academy-id "q-114441" :question/problem "${\\int }_{\\pi /4}^{\\pi /2}{cot}^{2}⁡x\\,\\text{d}x=$" :question/worked-solution "In this case, we have to use the identity  $1+{cot}^{2}⁡x={csc}^{2}⁡x.$ Rearranging this gives\n\n$$\n{cot}^{2}⁡x={csc}^{2}⁡x-1.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{\\int }_{\\pi /4}^{\\pi /2}{cot}^{2}⁡x\\,\\text{d}x & ={\\int }_{\\pi /4}^{\\pi /2}({csc}^{2}⁡x-1)\\text{d}x \\\\  & =(-\\operatorname{cot}⁡x-x){|}_{\\pi /4}^{\\pi /2} \\\\  & =[-\\operatorname{cot}⁡(\\frac{\\pi }{2})-\\frac{\\pi }{2}]-[-\\operatorname{cot}⁡(\\frac{\\pi }{4})-\\frac{\\pi }{4}] \\\\  & =[-0-\\frac{\\pi }{2}]-[-1-\\frac{\\pi }{4}] \\\\  & =-\\frac{\\pi }{2}+1+\\frac{\\pi }{4} \\\\  & =1-\\frac{\\pi }{4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186493961 :knowledge-point/_questions [{:db/id #edb/ref 17592186096831 :knowledge-point/id #uuid "9934a8da-2378-5019-a3a3-7cd66cbeeaa7" :knowledge-point/title "Integrating Using the Secant-Tangent Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d681392-0578-56c7-9fe2-42e3d7339e02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186493615}] :answer-field/correct {:answer/id #uuid "8d681392-0578-56c7-9fe2-42e3d7339e02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186493615} :answer-field/id #uuid "c2d075a9-50ba-561b-90ab-b8b2901e72d8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493872}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d59d88c8-9c62-51d9-bd12-48f5c362cc67" :question/math-academy-id "q-352652" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\pi /3}\\frac{{tan}^{2}⁡x+1}{{sec}^{3}⁡x}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "In this case, we have to use the identity  $1+{tan}^{2}⁡x={sec}^{2}⁡x.$ Substituting this into our integral gives\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /3}\\frac{{tan}^{2}⁡x+1}{{sec}^{3}⁡x}\\,\\text{d}x & ={\\int }_{0}^{\\pi /3}\\frac{{sec}^{2}⁡x}{{sec}^{3}⁡x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /3}\\frac{1}{\\operatorname{sec}⁡x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /3}\\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =\\operatorname{sin}⁡x\\,{|}_{0}^{\\pi /3} \\\\  & =\\operatorname{sin}⁡(\\frac{\\pi }{3})-\\operatorname{sin}⁡0 \\\\  & =\\frac{\\sqrt{3}}{2}-0 \\\\  & =\\frac{\\sqrt{3}}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186493919 :knowledge-point/_questions [{:db/id #edb/ref 17592186096831 :knowledge-point/id #uuid "9934a8da-2378-5019-a3a3-7cd66cbeeaa7" :knowledge-point/title "Integrating Using the Secant-Tangent Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b1be8b56-e0bc-581a-9ccb-692511badae8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{19}{8}" :db/id #edb/ref 17592186493679}] :answer-field/correct {:answer/id #uuid "b1be8b56-e0bc-581a-9ccb-692511badae8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{19}{8}" :db/id #edb/ref 17592186493679} :answer-field/id #uuid "f5f4070c-c95c-5ed1-901f-4528153978ca" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493886}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "43534459-b512-57ce-a24a-a07661c93918" :question/math-academy-id "q-352679" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1}^{3/2}\\frac{3{x}^{2}{tan}^{2}⁡x}{{sec}^{2}⁡x-1}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "First, we select the identity that contains a ${tan}^{2}⁡x$ term. So, we can use the identity \n\n$$\n1+{tan}^{2}⁡x={sec}^{2}⁡x.\n$$\n\nRearranging the above identity gives\n\n$$\n{sec}^{2}⁡x-1={tan}^{2}⁡x.\n$$\n\nUsing the above, we compute the given integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{3/2}\\frac{3{x}^{2}{tan}^{2}⁡x}{{sec}^{2}⁡x-1}\\,\\text{d}x & ={\\int }_{1}^{3/2}\\frac{3{x}^{2}{tan}^{2}⁡x}{{tan}^{2}⁡x}\\,\\text{d}x \\\\  & ={\\int }_{1}^{3/2}3{x}^{2}\\,\\text{d}x \\\\  & ={x}^{3}\\,{|}_{1}^{3/2} \\\\  & ={(\\frac{3}{2})}^{\\,3}-{1}^{3} \\\\  & =\\frac{27}{8}-1 \\\\  & =\\frac{19}{8}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186321026 :knowledge-point/_questions [{:db/id #edb/ref 17592186096832 :knowledge-point/id #uuid "d0ba6d15-a20e-5f16-b324-0bbead5458ca" :knowledge-point/title "Integrating Using the Cosecant-Cotangent Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8074fac7-a6e0-56cc-9165-137d0dae6a7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186319780}] :answer-field/correct {:answer/id #uuid "8074fac7-a6e0-56cc-9165-137d0dae6a7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186319780} :answer-field/id #uuid "22e00bd0-c773-50bc-8df3-96880e42e321" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320243}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "05d804be-1aa4-52f7-ac45-dafba61557ef" :question/math-academy-id "q-352697" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{\\pi /4}^{\\pi /2}(1+{cot}^{2}⁡x)\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "We use the cosecant-cotangent identity:\n\n$$\n1+{cot}^{2}⁡x={csc}^{2}⁡x.\n$$\n\nUsing the above, we compute the given integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{\\pi /4}^{\\pi /2}(1+{cot}^{2}⁡x)\\,\\text{d}x & ={\\int }_{\\pi /4}^{\\pi /2}{csc}^{2}⁡x\\,\\text{d}x \\\\  & =-\\operatorname{cot}⁡x\\,{|}_{\\pi /4}^{\\pi /2} \\\\  & =-\\operatorname{cot}⁡(\\frac{\\pi }{2})-(-\\operatorname{cot}⁡(\\frac{\\pi }{4})) \\\\  & =-0-(-1) \\\\  & =1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186097276 :knowledge-point/_questions [{:db/id #edb/ref 17592186096833 :knowledge-point/id #uuid "fe5822b4-c5d4-59a8-bd72-a41d3074e4e6" :knowledge-point/title "Integrating Trigonometric Expressions With Linear Arguments Using the Pythagorean Identities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "120a969c-c232-5a6a-9ebc-f3876756aa9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡(\\frac{\\pi }{2}-x)+x+C" :db/id #edb/ref 17592186493422} {:answer/id #uuid "2f1ecc2b-8f38-5a56-b452-79a084abe981" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡(\\frac{\\pi }{2}-x)-x+C" :db/id #edb/ref 17592186493470} {:answer/id #uuid "381e7704-3610-52d0-943d-11d2f5db4582" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{cot}⁡(\\frac{\\pi }{2}-x)+x+C" :db/id #edb/ref 17592186493483} {:answer/id #uuid "741642b8-40a1-5ddc-a062-46c687fc6284" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{cot}⁡(\\frac{\\pi }{2}-x)-x+C" :db/id #edb/ref 17592186493563} {:answer/id #uuid "da75dca0-cf1f-53aa-85b2-c756cac65ae8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{cot}⁡(\\frac{\\pi }{2}-x)-x+C" :db/id #edb/ref 17592186493734}] :answer-field/correct {:answer/id #uuid "2f1ecc2b-8f38-5a56-b452-79a084abe981" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡(\\frac{\\pi }{2}-x)-x+C" :db/id #edb/ref 17592186493470} :answer-field/id #uuid "d8ea9791-475d-59e1-8890-18149e61f29c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186095580}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e657762c-92c8-5c88-91d7-fe5813627920" :question/math-academy-id "q-49327" :question/problem "$\\int {cot}^{2}⁡(\\frac{\\pi }{2}-x)\\text{d}x=$" :question/worked-solution "From the identity $1+{cot}^{2}⁡\\theta ={csc}^{2}⁡\\theta $ with $\\theta =\\frac{\\pi }{2}-x,$ we get \n\n$$\n\\begin{aligned}1+{cot}^{2}⁡(\\frac{\\pi }{2}-x) & ={csc}^{2}⁡(\\frac{\\pi }{2}-x) \\\\ {cot}^{2}⁡(\\frac{\\pi }{2}-x) & ={csc}^{2}⁡(\\frac{\\pi }{2}-x)-1.\\end{aligned}\n$$\n\nSubstituting the above into our integral gives\n\n$$\n\\begin{aligned}\\int {cot}^{2}⁡(\\frac{\\pi }{2}-x)\\text{d}x & =\\int ({csc}^{2}⁡(\\frac{\\pi }{2}-x)-1)\\text{d}x \\\\  & =\\int {csc}^{2}⁡(\\frac{\\pi }{2}-x)\\text{d}x-\\int 1\\cdot \\text{d}x \\\\  & =\\operatorname{cot}⁡(\\frac{\\pi }{2}-x)-x+C.\\end{aligned}\n$$"}]}
