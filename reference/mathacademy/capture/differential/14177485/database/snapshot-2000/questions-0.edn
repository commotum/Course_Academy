#{[{:db/id #edb/ref 17592186250269 :knowledge-point/_questions [{:db/id #edb/ref 17592186096832 :knowledge-point/id #uuid "d0ba6d15-a20e-5f16-b324-0bbead5458ca" :knowledge-point/title "Integrating Using the Cosecant-Cotangent Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a05c2fc-f94d-5489-955e-6e93003cb216" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4(\\pi -2)" :db/id #edb/ref 17592186247662} {:answer/id #uuid "a3dc3121-d85d-555d-95fa-e1f130a553c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}-1" :db/id #edb/ref 17592186248887} {:answer/id #uuid "a75bb911-b1a2-59de-ac5b-2d5b63e7d0b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\frac{\\pi }{4}" :db/id #edb/ref 17592186248911} {:answer/id #uuid "c53da061-88b8-5d38-9620-69fbe5f388d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi -3" :db/id #edb/ref 17592186249176} {:answer/id #uuid "e1bfdf52-8608-5e41-81ac-9c0e93199b37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4-\\pi " :db/id #edb/ref 17592186249423}] :answer-field/correct {:answer/id #uuid "a75bb911-b1a2-59de-ac5b-2d5b63e7d0b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\frac{\\pi }{4}" :db/id #edb/ref 17592186248911} :answer-field/id #uuid "a980c72c-15a0-5296-ad73-7e85baf7f354" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249970}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3841fdbd-8341-5e24-9f59-0d6b99ab3106" :question/math-academy-id "q-114441" :question/problem "${\\int }_{\\pi /4}^{\\pi /2}{cot}^{2}⁡x\\,\\text{d}x=$" :question/worked-solution "In this case, we have to use the identity  $1+{cot}^{2}⁡x={csc}^{2}⁡x.$ Rearranging this gives\n\n$$\n{cot}^{2}⁡x={csc}^{2}⁡x-1.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{\\int }_{\\pi /4}^{\\pi /2}{cot}^{2}⁡x\\,\\text{d}x & ={\\int }_{\\pi /4}^{\\pi /2}({csc}^{2}⁡x-1)\\text{d}x \\\\  & =(-\\operatorname{cot}⁡x-x){|}_{\\pi /4}^{\\pi /2} \\\\  & =[-\\operatorname{cot}⁡(\\frac{\\pi }{2})-\\frac{\\pi }{2}]-[-\\operatorname{cot}⁡(\\frac{\\pi }{4})-\\frac{\\pi }{4}] \\\\  & =[-0-\\frac{\\pi }{2}]-[-1-\\frac{\\pi }{4}] \\\\  & =-\\frac{\\pi }{2}+1+\\frac{\\pi }{4} \\\\  & =1-\\frac{\\pi }{4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186321026 :knowledge-point/_questions [{:db/id #edb/ref 17592186096832 :knowledge-point/id #uuid "d0ba6d15-a20e-5f16-b324-0bbead5458ca" :knowledge-point/title "Integrating Using the Cosecant-Cotangent Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8074fac7-a6e0-56cc-9165-137d0dae6a7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186319780}] :answer-field/correct {:answer/id #uuid "8074fac7-a6e0-56cc-9165-137d0dae6a7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186319780} :answer-field/id #uuid "22e00bd0-c773-50bc-8df3-96880e42e321" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320243}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "05d804be-1aa4-52f7-ac45-dafba61557ef" :question/math-academy-id "q-352697" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{\\pi /4}^{\\pi /2}(1+{cot}^{2}⁡x)\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "We use the cosecant-cotangent identity:\n\n$$\n1+{cot}^{2}⁡x={csc}^{2}⁡x.\n$$\n\nUsing the above, we compute the given integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{\\pi /4}^{\\pi /2}(1+{cot}^{2}⁡x)\\,\\text{d}x & ={\\int }_{\\pi /4}^{\\pi /2}{csc}^{2}⁡x\\,\\text{d}x \\\\  & =-\\operatorname{cot}⁡x\\,{|}_{\\pi /4}^{\\pi /2} \\\\  & =-\\operatorname{cot}⁡(\\frac{\\pi }{2})-(-\\operatorname{cot}⁡(\\frac{\\pi }{4})) \\\\  & =-0-(-1) \\\\  & =1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186097276 :knowledge-point/_questions [{:db/id #edb/ref 17592186096833 :knowledge-point/id #uuid "fe5822b4-c5d4-59a8-bd72-a41d3074e4e6" :knowledge-point/title "Integrating Trigonometric Expressions With Linear Arguments Using the Pythagorean Identities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d2344e0-c026-522f-ab01-1101df67b7f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\cot (\\frac{π}{2} - x) - x + C" :db/id #edb/ref 17592186095581} {:answer/id #uuid "afdc71ac-2b9e-5dd2-b892-39ec43411ee4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\cot (\\frac{π}{2} - x) - x + C" :db/id #edb/ref 17592186095582} {:answer/id #uuid "c63215de-ed96-5709-9e24-56fe0b648751" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\cot (\\frac{π}{2} - x) - x + C" :db/id #edb/ref 17592186095583} {:answer/id #uuid "dc6df70d-c45c-5e35-8e01-60f0aa31ac19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\cot (\\frac{π}{2} - x) + x + C" :db/id #edb/ref 17592186095584} {:answer/id #uuid "1fdd1a4c-b3a4-5c1c-817b-348b77878d4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\cot (\\frac{π}{2} - x) + x + C" :db/id #edb/ref 17592186095585}] :answer-field/id #uuid "d8ea9791-475d-59e1-8890-18149e61f29c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186095580}] :question/id #uuid "e657762c-92c8-5c88-91d7-fe5813627920" :question