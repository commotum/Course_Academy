[{"source" ":org/Math-Academy" "forms" [{:db/id 17592186124477 :knowledge-point/questions ["question-29b4d870-1dc8-5b15-b7e0-9a157e214c86" "question-389b06ef-bd0c-5b5c-b775-c400f3aed0c2"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124478 :knowledge-point/questions ["question-75f69126-c110-5545-9efd-4ceeba235a0c"] :db/ensure [:knowledge-point/validate]} {:db/id "question-29b4d870-1dc8-5b15-b7e0-9a157e214c86" :question/id #uuid "29b4d870-1dc8-5b15-b7e0-9a157e214c86" :question/math-academy-id "q-73605" :question/problem "The row echelon form matrix $B$ is given below. What are the pivot columns of $B?$\n\n$$\nB=[\\begin{aligned}-1 & 1 & 5 & -2 \\\\ 0 & 0 & -3 & 1 \\\\ 0 & 0 & 0 & 1\\end{aligned}]\n$$" :question/worked-solution "Remember that the pivots of a matrix in row echelon form are the first non-zero entries in each row of the matrix.\n\nWe can see that $B$ has $3$ pivots in the $1$st, $3$rd, and $4$th columns:\n\n$$\nB=[\\begin{aligned}-1 & 1 & 5 & -2 \\\\ 0 & 0 & -3 & 1 \\\\ 0 & 0 & 0 & 1\\end{aligned}]\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-071abeb6-b166-58f5-98b9-047a56887f09"] :db/ensure [:question/validate]} {:db/id "answer-field-071abeb6-b166-58f5-98b9-047a56887f09" :answer-field/id #uuid "071abeb6-b166-58f5-98b9-047a56887f09" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ad262205-ce1f-5784-abf9-0b421298aba5" :answer-field/choices ["answer-7657acbc-7f7c-5baa-a900-65a74791d07e" "answer-28592cef-ef21-550a-af03-88ded5116553" "answer-ce5d1621-6704-561c-9037-9d2a059c4145" "answer-36c481a9-c678-52df-af3c-ea2c5f3761cb" "answer-ad262205-ce1f-5784-abf9-0b421298aba5"] :db/ensure [:answer-field/validate]} {:db/id "answer-7657acbc-7f7c-5baa-a900-65a74791d07e" :answer/id #uuid "7657acbc-7f7c-5baa-a900-65a74791d07e" :answer/type :answer.type/text :answer/value "$1$st and $3$rd only" :db/ensure [:answer/validate]} {:db/id "answer-28592cef-ef21-550a-a