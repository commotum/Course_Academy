5-5e27-bb55-f4f252a3ded6" "answer-daa29215-92c3-5dd2-8358-debeb68ff5b2" "answer-b15b01c1-60d3-5417-887c-9a621f4562d7" "answer-e1bb84ea-40f8-5e22-bcd6-49f3c09b85e6" "answer-a9143ba9-c209-51a8-a25f-6540f99e1eba"] :db/ensure [:answer-field/validate]} {:db/id "answer-471f28dc-0f25-5e27-bb55-f4f252a3ded6" :answer/id #uuid "471f28dc-0f25-5e27-bb55-f4f252a3ded6" :answer/type :answer.type/text :answer/value "$1$st, $2$nd, $3$rd and $5$th only" :db/ensure [:answer/validate]} {:db/id "answer-daa29215-92c3-5dd2-8358-debeb68ff5b2" :answer/id #uuid "daa29215-92c3-5dd2-8358-debeb68ff5b2" :answer/type :answer.type/text :answer/value "$1$st, $2$nd, and $3$rd only" :db/ensure [:answer/validate]} {:db/id "answer-b15b01c1-60d3-5417-887c-9a621f4562d7" :answer/id #uuid "b15b01c1-60d3-5417-887c-9a621f4562d7" :answer/type :answer.type/text :answer/value "$1$st, $3$rd, and $5$th only" :db/ensure [:answer/validate]} {:db/id "answer-e1bb84ea-40f8-5e22-bcd6-49f3c09b85e6" :answer/id #uuid "e1bb84ea-40f8-5e22-bcd6-49f3c09b85e6" :answer/type :answer.type/text :answer/value "$3$rd and $5$th only" :db/ensure [:answer/validate]} {:db/id "answer-a9143ba9-c209-51a8-a25f-6540f99e1eba" :answer/id #uuid "a9143ba9-c209-51a8-a25f-6540f99e1eba" :answer/type :answer.type/text :answer/value "All the columns are pivot" :db/ensure [:answer/validate]} {:db/id "question-75f69126-c110-5545-9efd-4ceeba235a0c" :question/id #uuid "75f69126-c110-5545-9efd-4ceeba235a0c" :question/math-academy-id "q-73615" :question/problem "The row echelon form matrix $A$ is given below. What are its **non**-pivot columns?\n\n$$\nA=[\\begin{aligned}1 & 3 & 5 & 0 \\\\ 0 & 2 & 1 & -2 \\\\ 0 & 0 & 0 & -1\\end{aligned}]\n$$" :question/worked-solution "Remember that the pivots of a matrix in row echelon form are the first non-zero entries in each row of the matrix.\n\nWe can see that $A$ has $3$ pivots in the $1$st, $2$nd and $4$th columns:\n\n$$\nA=[\\begin{aligned}1 & 3 & 5 & 0 \\\\ 0 & 2 & 1 & -2 \\\\ 0 & 0 & 0 & -1\\end{aligned}]\n$$\n\nTherefore, the only non-pivot column is the $3$rd column." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-9e5f4d81-f91b-55ef-9252-1ab82323e853"] :db/ensure [:question/validate]} {:db/id "answer-field-9e5f4d81-f91b-55ef-9252-1ab82323e853" :answer-field/id #uuid "9e5f4d81-f91b-55ef-9252-1ab82323e853" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-384525a8-6bc7-511c-89ba-ed88a8ddda66" :answer-field/choices ["answer-e0608257-5e3b-5666-af66-4b0ccd77c69a" "answer-68cc9e55-2409-512a-ac2e-c70b873bffd3" "answer-4ed2e27a-0bf7-5dd2-b5c6-be0e98115df1" "answer-384525a8-6bc7-511c-89ba-ed88a8ddda66" "answer-0b45315b-a5c2-53a7-b6d0-069454aca98b"] :db/ensure [:answer-field/validate]} {:db/id "answer-e0608257-5e3b-5666-af66-4b0ccd77c69a" :answer/id #uuid "e0608257-5e3b-5666-af66-4b0ccd77c69a" :answer/type :answer.type/text :answer/value "$2$nd and $3$rd only" :db/ensure [:answer/validate]} {:db/id "answer-68cc9e55-2409-512a-ac2e-c70b873bffd3" :answer/id #uuid "68cc9e55-2409-512a-ac2e-c70b873bffd3" :answer/type :answer.type/text :answer/value "$2$nd only" :db/ensure [:answer/validate]} {:db/id "answer-4ed2e27a-0bf7-5dd2-b5c6-be0e98115df1" :answer/id #uuid "4ed2e27a-0bf7-5dd2-b5c6-be0e98115df1" :answer/type :answer.type/text :answer/value "$3$rd and $4$th only" :db/ensure [:answer/validate]} {:db/id "answer-384525a8-6bc7-511c-89ba-ed88a8ddda66" :answer/id #uuid "384525a8-6bc7-511c-89ba-ed88a8ddda66" :answer/type :answer.type/text :answer/value "$3$rd only" :db/ensure [:answer/validate]} {:db/id "answer-0b45315b-a5c2-53a7-b6d0-069454aca98b" :answer/id #uuid "0b45315b-a5c2-53a7-b6d0-069454aca98b" :answer/type :answer.type/text :answer/value "$4$th only" :db/ensure [:answer/validate]} {:db/id 17592186124885 :question/problem "Determine the number of pivot columns of the matrix $D,$ given by\n\n$$\nD=[\\begin{aligned}1 & 0 & 0 & 0 & 0 \\\\ 0 & -3 & 0 & 0 & 0 \\\\ 0 & 0 & 4 & 2 & 0 \\\\ 0 & 0 & -2 & -8 & 7 \\\\ 0 & 0 & 0 & 2 & -1\\end{aligned}].\n$$" :question/worked-solution "First, we need to convert $D$ to row echelon form:\n\n$$\n\\begin{aligned}D & =[\\begin{aligned}1 & 0 & 0 & 0 & 0 \\\\ 0 & -3 & 0 & 0 & 0 \\\\ 0 & 0 & 4 & 2 & 0 \\\\ 0 & 0 & -2 & -8 & 7 \\\\ 0 & 0 & 0 & 2 & -1\\end{aligned}] & {R}_{4} & :={R}_{4}+(\\frac{1}{2}){R}_{3} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & 0 & 0 \\\\ 0 & -3 & 0 & 0 & 0 \\\\ 0 & 0 & 4 & 2 & 0 \\\\ 0 & 0 & 0 & -7 & 7 \\\\ 0 & 0 & 0 & 2 & -1\\end{aligned}] & {R}_{4} & :={R}_{4}+(\\frac{2}{7}){R}_{3} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & 0 & 0 \\\\ 0 & -3 & 0 & 0 & 0 \\\\ 0 & 0 & 4 & 2 & 0 \\\\ 0 & 0 & 0 & -7 & 7 \\\\ 0 & 0 & 0 & 0 & -1\\end{aligned}]\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $D$ has $5$ pivots, and therefore the number of pivot columns is $5.$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186121910 :answer-field/correct 17592186121911 :db/ensure [:answer-field/validate]}] "assertions" [["question-29b4d870-1dc8-5b15-b7e0-9a157e214c86" :question/id #uuid "29b4d870-1dc8-5b15-b7e0-9a157e214c86"] ["question-29b4d870-1dc8-5b15-b7e0-9a157e214c86" :question/math-academy-id "q-73605"] ["question-29b4d870-1dc8-5b15-b7e0-9a157e214c86" :question/problem "The row echelon form matrix $B$ is given below. What are the pivot columns of $B?$\n\n$$\nB=[\\begin{aligned}-1 & 1 & 5 & -2 \\\\ 0 & 0 & -3 & 1 \\\\ 0 & 0 & 0 & 1\\end{aligned}]\n$$"] ["question-29b4d870-1dc8-5b15-b7e0-9a157e214c86" :question/worked-solution "Remember that the pivots of a matrix in row echelon form are the first non-zero entries in each row of the matrix.\n\nWe can see that $B$ has $3$ pivots in the $1$st, $3$rd, and $4$th columns:\n\n$$\nB=[\\begin{aligned}-1 & 1 & 5 & -2 \\\\ 0 & 0 & -3 & 1 \\\\ 0 & 0 & 0 & 1\\end{aligned}]\n$$"] ["question-29b4d870-1dc8-5b15-b7e0-9a157e214c86" :question/difficulty :question.difficulty/easy] ["answer-field-071abeb6-b166-58f5-98b9-047a568