wer-field-8d2264ad-851d-5a59-a57c-aace10c2d8bf"] [17592186124477 :knowledge-point/questions "question-389b06ef-bd0c-5b5c-b775-c400f3aed0c2"] ["question-75f69126-c110-5545-9efd-4ceeba235a0c" :question/id #uuid "75f69126-c110-5545-9efd-4ceeba235a0c"] ["question-75f69126-c110-5545-9efd-4ceeba235a0c" :question/math-academy-id "q-73615"] ["question-75f69126-c110-5545-9efd-4ceeba235a0c" :question/problem "The row echelon form matrix $A$ is given below. What are its **non**-pivot columns?\n\n$$\nA=[\\begin{aligned}1 & 3 & 5 & 0 \\\\ 0 & 2 & 1 & -2 \\\\ 0 & 0 & 0 & -1\\end{aligned}]\n$$"] ["question-75f69126-c110-5545-9efd-4ceeba235a0c" :question/worked-solution "Remember that the pivots of a matrix in row echelon form are the first non-zero entries in each row of the matrix.\n\nWe can see that $A$ has $3$ pivots in the $1$st, $2$nd and $4$th columns:\n\n$$\nA=[\\begin{aligned}1 & 3 & 5 & 0 \\\\ 0 & 2 & 1 & -2 \\\\ 0 & 0 & 0 & -1\\end{aligned}]\n$$\n\nTherefore, the only non-pivot column is the $3$rd column."] ["question-75f69126-c110-5545-9efd-4ceeba235a0c" :question/difficulty :question.difficulty/easy] ["answer-field-9e5f4d81-f91b-55ef-9252-1ab82323e853" :answer-field/id #uuid "9e5f4d81-f91b-55ef-9252-1ab82323e853"] ["answer-e0608257-5e3b-5666-af66-4b0ccd77c69a" :answer/id #uuid "e0608257-5e3b-5666-af66-4b0ccd77c69a"] ["answer-e0608257-5e3b-5666-af66-4b0ccd77c69a" :answer/type :answer.type/text] ["answer-e0608257-5e3b-5666-af66-4b0ccd77c69a" :answer/value "$2$nd and $3$rd only"] ["answer-68cc9e55-2409-512a-ac2e-c70b873bffd3" :answer/id #uuid "68cc9e55-2409-512a-ac2e-c70b873bffd3"] ["answer-68cc9e55-2409-512a-ac2e-c70b873bffd3" :answer/type :answer.type/text] ["answer-68cc9e55-2409-512a-ac2e-c70b873bffd3" :answer/value "$2$nd only"] ["answer-4ed2e27a-0bf7-5dd2-b5c6-be0e98115df1" :answer/id #uuid "4ed2e27a-0bf7-5dd2-b5c6-be0e98115df1"] ["answer-4ed2e27a-0bf7-5dd2-b5c6-be0e98115df1" :answer/type :answer.type/text] ["answer-4ed2e27a-0bf7-5dd2-b5c6-be0e98115df1" :answer/value