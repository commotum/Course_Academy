edge-point/id #uuid "1073953e-7e0a-5237-8533-8882b7772741" :knowledge-point/title "Finding the Number of Pivot Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "483f76a2-c658-590b-b0c8-339dbf488e67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186339772} {:answer/id #uuid "7d96a1fc-c32f-5705-9c33-3f7b775fcf9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186340261} {:answer/id #uuid "89525704-89b5-5924-ae95-b2e4e00cc538" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186340353} {:answer/id #uuid "bacd7256-ac8c-5b32-ae2e-12bfdd5f2539" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186340803} {:answer/id #uuid "d2029d2d-b485-57b3-8a1c-d2297c1d7152" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186340991}] :answer-field/correct {:answer/id #uuid "d2029d2d-b485-57b3-8a1c-d2297c1d7152" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186340991} :answer-field/id #uuid "324fb24a-0b34-5d44-8ba7-82c48df3b212" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341470}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d2b8524b-7ecd-587d-9654-16754c1816e2" :question/math-academy-id "q-73635" :question/problem "Determine the number of pivot columns of the matrix $Q,$ given by\n\n$$\nQ=\\begin{bmatrix}-2 & 1 & 1 & 0 & 3 \\\\ 0 & 2 & -1 & 1 & 4 \\\\ 0 & 0 & 0 & 8 & -12 \\\\ 0 & 0 & 0 & -2 & 1 \\\\ 0 & 0 & 0 & 0 & 0\\end{bmatrix}.\n$$" :question/worked-solution "First, we need to convert $Q$ to row echelon form:\n\n$$\n\\begin{aligned}Q & =\\begin{bmatrix}-2 & 1 & 1 & 0 & 3 \\\\ 0 & 2 & -1 & 1 & 4 \\\\ 0 & 0 & 0 & 8 & -12 \\\\ 0 & 0 & 0 & -2 & 1 \\\\ 0 & 0 & 0 & 0 & 0\\end{bmatrix} & {R}_{4} & :={R}_{4}+\\frac{1}{4}{R}_{3} \\\\  & ∼\\begin{bmatrix}-2 & 1 & 1 & 0 & 3 \\\\ 0 & 2 & -1 & 1 & 4 \\\\ 0 & 0 & 0 & 8 & -12 \\\\ 0 & 0 & 0 & 0 & -2 \\\\ 0 & 0 & 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $Q$ has $4$ pivots, and therefore the number of pivot columns is $4.$"}] [{:db/id #edb/ref 17592186342046 :knowledge-point/_questions [{:db/id #edb/ref 17592186124480 :knowledge-point/id #uuid "b1a557d6-52f3-5df3-8088-5b875296e72e" :knowledge-point/title "Finding the Pivot Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a9158a1e-ec92-5a85-91c0-20a1ac46a48d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$nd only" :db/id #edb/ref 17592186340666} {:answer/id #uuid "b2728011-3f39-5c0e-80c4-f7db4bfbdeeb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$nd, $3$rd, and $6$th only" :db/id #edb/ref 17592186340750} {:answer/id #uuid "bd9e67c6-6e81-5e3b-be7d-db793cd3b0e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$nd, $3$rd, $5$th, and $6$th only" :db/id #edb/ref 17592186340820} {:answer/id #uuid "d96d7546-90a3-580f-9f5a-249f3f3451e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st, $2$nd, $3$rd, $5$th, and $6$th only" :db/id #edb/ref 17592186341057} {:answer/id #uuid "da721718-1f5a-5297-b2fc-1ff9bfdec092" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st and $6$th only" :db/id #edb/ref 17592186341068}] :answer-field/correct {:answer/id #uuid "bd9e67c6-6e81-5e3b-be7d-db793cd3b0e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$nd, $3$rd, $5$th, and $6$th only" :db/id #edb/ref 17592186340820} :answer-field/id #uuid "31d2b7f2-9d9e-5f2d-9a1c-eeaf7743cd2d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341467}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1b6c62c9-235a-5e15-9835-d3716c4119bd" :question/math-academy-id "q-73639" :question/problem "What are the pivot columns of the matrix $P,$ given by\n\n$$\nP=\\begin{bmatrix}0 & 1 & 0 & 2 & 0 & 3 \\\\ 0 & 0 & 3 & 0 & 6 & 0 \\\\ 0 & 0 & -6 & 0 & -4 & -1 \\\\ 0 & 0 & 0 & 0 & -8 & 0\\end{bmatrix}?\n$$" :question/worked-solution "First, we need to convert $P$ to row echelon form:\n\n$$\n\\begin{aligned}P & =\\begin{bmatrix}0 & 1 & 0 & 2 & 0 & 3 \\\\ 0 & 0 & 3 & 0 & 6 & 0 \\\\ 0 & 0 & -6 & 0 & -4 & -1 \\\\ 0 & 0 & 0 & 0 & -8 & 0\\end{bmatrix} & {R}_{3} & :={R}_{3}+2{R}_{2} \\\\  & ∼\\begin{bmatrix}0 & 1 & 0 & 2 & 0 & 3 \\\\ 0 & 0 & 3 & 0 & 6 & 0 \\\\ 0 & 0 & 0 & 0 & 8 & -1 \\\\ 0 & 0 & 0 & 0 & -8 & 0\\end{bmatrix} & {R}_{4} & :={R}_{4}+{R}_{3} \\\\  & ∼\\begin{bmatrix}0 & 1 & 0 & 2 & 0 & 3 \\\\ 0 & 0 & 3 & 0 & 6 & 0 \\\\ 0 & 0 & 0 & 0 & 8 & -1 \\\\ 0 & 0 & 0 & 0 & 0 & -1\\end{bmatrix}\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $P$ has $4$ pivots. In particular, the pivot columns are the $2$nd, $3$rd, $5$th and $6$th columns."}]}
