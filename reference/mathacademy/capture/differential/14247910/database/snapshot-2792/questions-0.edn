r-field/correct {:answer/id #uuid "cfb7ff38-9563-586d-bffb-05e9abf08eb0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186340977} :answer-field/id #uuid "9ffc366a-bd4e-5c19-870e-392f4fcf5367" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341665}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "420559bf-600d-5c66-bd70-411e67d4681b" :question/math-academy-id "q-73628" :question/problem "Determine the number of pivot columns of the matrix $B,$ given by\n\n$$\nB=\\begin{bmatrix}-2 & 0 & 1 & -1 & -2 \\\\ 0 & 1 & 1 & 4 & -5 \\\\ 4 & 0 & 3 & -6 & 1 \\\\ 0 & 0 & 0 & 7 & 0\\end{bmatrix}.\n$$" :question/worked-solution "First, we need to convert $B$ to row echelon form:\n\n$$\n\\begin{aligned}B & =\\begin{bmatrix}-2 & 0 & 1 & -1 & -2 \\\\ 0 & 1 & 1 & 4 & -5 \\\\ 4 & 0 & 3 & -6 & 1 \\\\ 0 & 0 & 0 & 7 & 0\\end{bmatrix} & {R}_{3} & :={R}_{3}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}-2 & 0 & 1 & -1 & -2 \\\\ 0 & 1 & 1 & 4 & -5 \\\\ 0 & 0 & 5 & -8 & -3 \\\\ 0 & 0 & 0 & 7 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $B$ has $4$ pivots, and therefore the number of pivot columns is $4.$"}] [{:db/id #edb/ref 17592186342041 :knowledge-point/_questions [{:db/id #edb/ref 17592186124479 :knowledge-point/id #uuid "1073953e-7e0a-5237-8533-8882b7772741" :knowledge-point/title "Finding the Number of Pivot Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "056df0c6-b936-541b-8bfe-1a07142ee194" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186339169} {:answer/id #uuid "2a1fada3-aa41-57ba-979c-d47aae10a6ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186339499} {:answ