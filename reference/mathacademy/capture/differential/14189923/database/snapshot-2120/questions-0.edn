#{[{:db/id #edb/ref 17592186269164 :knowledge-point/_questions [{:db/id #edb/ref 17592186166891 :knowledge-point/id #uuid "33f7fa4d-9ac0-552a-9f3e-9e09c2ed0286" :knowledge-point/title "Finding the Minimum Value Given a Canonical Form on the Unit Sphere"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fddd54e-2f69-5317-9273-59acf0420171" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186266424} {:answer/id #uuid "488b4f03-ec81-5e5e-88ac-1e1b03de77fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186266792} {:answer/id #uuid "6c2ad35c-a214-5c83-bfd9-e7a6a53c9023" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186267099} {:answer/id #uuid "c18a481a-15ba-5133-9b96-62027df826c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186267872} {:answer/id #uuid "ff581e6d-531a-50a8-93f1-45b62be1bbc0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186268394}] :answer-field/correct {:answer/id #uuid "c18a481a-15ba-5133-9b96-62027df826c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186267872} :answer-field/id #uuid "a2163251-a2b2-5338-af76-79765630ea17" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268695}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d2bb923d-a428-53a1-96e5-4cae59c3d2d8" :question/math-academy-id "q-138064" :question/problem "Find the minimum value of $Q(x)=4{x}_{1}^{2}-{x}_{2}^{2}-2{x}_{3}^{2}$ given that $‖x‖=1.$" :question/worked-solution "First, notice that ${x}_{1}^{2}\\ge 0$ and ${x}_{2}^{2}\\ge 0.$ So, we have that\n\n$$\n4{x}_{1}^{2}\\ge -2{x}_{1}^{2},\\,-{x}_{2}^{2}\\ge -2{x}_{2}^{2}.\n$$\n\nAs a result, \n\n$$\n\\begin{aligned}Q(x) & =4{x}_{1}^{2}-{x}_{2}^{2}-2{x}_{3}^{2} \\\\  & \\ge -2{x}_{1}^{2}-2{x}_{2}^{2}-2{x}_{3}^{2} \\\\  & =-2({x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2}).\\end{aligned}\n$$\n\nNow, recall that $‖x‖=1$ is equivalent to ${x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2}=1.$ So, \n\n$$\n\\begin{aligned}-2({x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2})=-2(1)=-2.\\end{aligned}\n$$\n\nand, in turn, $Q(x)\\ge -2.$ \n\nSo, the value of $Q(x)$ can be no smaller than $-2.$ But before we conclude that $-2$ is the minimum, we need to find a vector such that $Q(x)=-2.$\n\nNotice that when $x={[\\begin{aligned}0 & 0 & 1\\end{aligned}]}^{T},$ we get\n\n$$\n\\begin{aligned}Q(x) & =4{x}_{1}^{2}-{x}_{2}^{2}-2{x}_{3}^{2} \\\\  & =4(0)^{2}-(0)^{2}-2(1)^{2} \\\\  & =-2.\\end{aligned}\n$$\n\nTherefore, given that $‖x‖=1,$ the minimum value of $Q(x)$ is equal to $-2.$"}] [{:db/id #edb/ref 17592186278200 :knowledge-point/_questions [{:db/id #edb/ref 17592186166891 :knowledge-point/id #uuid "33f7fa4d-9ac0-552a-9f3e-9e09c2ed0286" :knowledge-point/title "Finding the Minimum Value Given a Canonical Form on the Unit Sphere"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "018c99a3-0395-5f65-a414-0b527b9b1fb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186275490} {:answer/id #uuid "2418fd71-994a-57d9-8058-e7d13fe938ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186275795} {:answer/id #uuid "724c24fe-2a6a-593e-84fa-821ecbbea055" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186276512} {:answer/id #uuid "adf63806-8714-5759-974a-7ebb5953e7da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186277040} {:answer/id #uuid "c1115abc-a234-5591-8bd4-08bbcb550a6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186277193}] :answer-field/correct {:answer/id #uuid "2418fd71-994a-57d9-8058-e7d13fe938ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186275795} :answer-field/id #uuid "b5356da2-3693-5794-9588-7fc99e91ebda" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278045}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7a98e5a2-f222-532b-be08-4de02d1187ab" :question/math-academy-id "q-158533" :question/problem "Find the minimum value of $Q(x)=3{x}_{1}^{2}+6{x}_{2}^{2}+4{x}_{3}^{2}$ given that $‖x‖=1.$" :question/worked-solution "First, notice that ${x}_{2}^{2}\\ge 0$ and ${x}_{3}^{2}\\ge 0.$ So, we have that\n\n$$\n6{x}_{2}^{2}\\ge 3{x}_{2}^{2},\\,4{x}_{3}^{2}\\ge 3{x}_{3}^{2}.\n$$\n\nAs a result, \n\n$$\n\\begin{aligned}Q(x) & =3{x}_{1}^{2}+6{x}_{2}^{2}+4{x}_{3}^{2} \\\\  & \\ge 3{x}_{1}^{2}+3{x}_{2}^{2}+3{x}_{3}^{2} \\\\  & =3({x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2}).\\end{aligned}\n$$\n\nNow, recall that $‖x‖=1$ is equivalent to ${x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2}=1.$ So, \n\n$$\n\\begin{aligned}3({x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2})=3(1)=3.\\end{aligned}\n$$\n\nand, in turn, $Q(x)\\ge 3.$\n\nSo, the value of $Q(x)$ can be no smaller than $3.$ But before we conclude that $3$ is the minimum, we need to find a vector such that $Q(x)=3.$\n\nNotice that when  $x={[\\begin{aligned}1 & 0 & 0\\end{aligned}]}^{T},$ we get\n\n$$\n\\begin{aligned}Q(x) & =3{x}_{1}^{2}+6{x}_{2}^{2}+4{x}_{3}^{2} \\\\  & =3(1)^{2}+6(0)^{2}+4(0)^{2} \\\\  & =3.\\end{aligned}\n$$\n\nTherefore, given that $‖x‖=1,$ the minimum value of $Q(x)$ is equal to $3.$"}]}
