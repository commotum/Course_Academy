#{[{:activity/expected-seconds 780.0 :activity/first-step {:db/id #edb/ref 17592186193689} :activity/id #uuid "1ee2078f-2d7b-5d91-844b-dd810c5980c9" :activity/scope {:db/id #edb/ref 17592186049417 :topic/id #uuid "f3354023-39f0-527c-b9e3-f3dced711198" :topic/math-academy-id 4125} :activity/steps [{:db/id #edb/ref 17592186193507 :step/content {:db/id #edb/ref 17592186192686 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192391 :question/id #uuid "19e7744e-9d87-5ad1-9648-029e7dc8e565" :question/math-academy-id "e-10113"} :knowledge-point/id #uuid "a9d0e7a8-77d1-58d7-b7f7-a820942ece69" :knowledge-point/questions [{:db/id #edb/ref 17592186192984} {:db/id #edb/ref 17592186193198} {:db/id #edb/ref 17592186526023} {:db/id #edb/ref 17592186526065} {:db/id #edb/ref 17592186526076} {:db/id #edb/ref 17592186526094} {:db/id #edb/ref 17592186526098} {:db/id #edb/ref 17592186543496} {:db/id #edb/ref 17592186543505} {:db/id #edb/ref 17592186543544}] :knowledge-point/title "Log-Likelihood Functions for Normal Random Variables"} :step/id #uuid "5e40004b-0de5-5409-b9f6-66d7010235cf" :step/math-academy-id 38135} {:db/id #edb/ref 17592186193686 :step/content {:db/id #edb/ref 17592186192798 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192522 :question/id #uuid "f2a062b5-e42e-5c05-9bc1-cbbe7a10baac" :question/math-academy-id "e-11122"} :knowledge-point/id #uuid "7981ed99-ef47-5b86-9f92-bce4d45d9767" :knowledge-point/questions [{:db/id #edb/ref 17592186193199} {:db/id #edb/ref 17592186193200} {:db/id #edb/ref 17592186526000} {:db/id #edb/ref 17592186526006} {:db/id #edb/ref 17592186526087} {:db/id #edb/ref 17592186526089} {:db/id #edb/ref 17592186543530}] :knowledge-point/title "Log-Likelihood Functions for Exponential Random Variables"} :step/id #uuid "cd1280e1-8556-53f3-b24b-45e447786baf" :step/math-academy-id 42290 :step/next {:db/id #edb/ref 17592186193507}} {:db/id #edb/ref 17592186193688 :step/content {:db/id #edb/ref 17592186192800 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192524 :question/id #uuid "ac9e9734-fb34-59e4-bbe2-a2e55196f0c1" :question/math-academy-id "e-11124"} :knowledge-point/id #uuid "cce53189-83e8-5ab9-9abc-cb159f761f55" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048346} {:db/id #edb/ref 17592186049217}] :knowledge-point/questions [{:db/id #edb/ref 17592186193202} {:db/id #edb/ref 17592186193203} {:db/id #edb/ref 17592186526007} {:db/id #edb/ref 17592186526029} {:db/id #edb/ref 17592186526051} {:db/id #edb/ref 17592186526063} {:db/id #edb/ref 17592186526071}] :knowledge-point/title "Log-Likelihood Functions for Continuous Random Variables"} :step/id #uuid "d277bc8e-9565-50d6-8915-76af5cc26d62" :step/math-academy-id 42304 :step/next {:db/id #edb/ref 17592186193686}} {:db/id #edb/ref 17592186193689 :step/content {:db/id #edb/ref 17592186193899 :tutorial/content "Recall that if $X_1, X_2, \\ldots, X_{n}$ are independent and identically distributed *continuous* random variables with probability density function $f(x; \\theta),$ then the likelihood function $L(\\theta)$ of a random sample $x_1, x_2, \\ldots, x_n$ is given by\n\n$$\nL(\\theta) = \\displaystyle\\prod_{i=1}^n f(x_i;\\,\\theta)\n$$\n\nwhere $f(x;\\theta)$ is the probability density function of $X_i$ for $i=1,2,\\ldots, n,$ and $\\theta$ is an unknown parameter.\n\nSimilar to the case of discrete random variables, the **log-likelihood function** is given by\n\n$$\n\\begin{aligned}l(\\theta ) & =\\operatorname{ln}⁡(L(\\theta )) \\\\  & =\\operatorname{ln}⁡({\\prod }_{i=1}^{n}f({x}_{i};\\,\\theta )) \\\\  & =\\operatorname{ln}⁡(f({x}_{1};\\,\\theta )\\cdot f({x}_{2};\\,\\theta )⋯f({x}_{n};\\,\\theta )) \\\\  & =\\operatorname{ln}⁡(f({x}_{1};\\,\\theta ))+\\operatorname{ln}⁡(f({x}_{2};\\,\\theta ))+⋯+\\operatorname{ln}⁡(f({x}_{n};\\,\\theta )) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(f({x}_{i};\\,\\theta )).\\end{aligned}\n$$\n\nLet's get some practice at calculating log-likelihood functions for some continuous random variables." :tutorial/id #uuid "c0170775-4a1b-50a6-8f90-446fcc21a159" :tutorial/math-academy-id 7005 :tutorial/title "Introduction"} :step/id #uuid "4f38c06c-0588-54af-b61c-d056d9ae479e" :step/math-academy-id 42305 :step/next {:db/id #edb/ref 17592186193688}}] :activity/title "Log-Likelihood Functions for Continuous Probability Distributions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186192934}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186543658} :activity/id #uuid "e3eeaafd-261d-5d3a-b382-2db7d6832fa1" :activity/scope {:db/id #edb/ref 17592186049417 :topic/id #uuid "f3354023-39f0-527c-b9e3-f3dced711198" :topic/math-academy-id 4125} :activity/steps [{:db/id #edb/ref 17592186543606 :step/content {:db/id #edb/ref 17592186543496 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dbd9de5-ffb6-5a92-af24-1a190f516d4b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "52.5" :db/id #edb/ref 17592186542760} {:answer/id #uuid "42f17b6e-adee-5418-8a80-24659c92c3a5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-57.3" :db/id #edb/ref 17592186542820} {:answer/id #uuid "48337ab4-cd65-553e-b93c-57c20fa8194e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-55.1" :db/id #edb/ref 17592186542836} {:answer/id #uuid "a31bea97-b4ca-5c19-a543-03494bd16286" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "53.8" :db/id #edb/ref 17592186543071} {:answer/id #uuid "ebf9a326-b0aa-5098-aa51-d8aa62a227d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-51.4" :db/id #edb/ref 17592186543235}] :answer-field/correct {:db/id #edb/ref 17592186542836} :answer-field/id #uuid "689ba3cb-114a-56ff-8abb-81f20075f5f3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186543355}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "47a49d65-e85d-5b9b-a8c6-e21bc37526ef" :question/math-academy-id "q-159947" :question/problem "Suppose ${X}_{1},{X}_{2},…,{X}_{10}$ is an I.I.D random sample with ${X}_{i}∼N(\\theta ,{1}^{2}),$ where $\\theta $ is an unknown mean. For a particular sample ${x}_{1},{x}_{2},…,{x}_{10},$ you're given that \n\n$$\n{\\sum }_{i=1}^{10}{x}_{i}=41.2,\\,{\\sum }_{i=1}^{10}{x}_{i}^{2}=182.6.\n$$\n\n \nGiven that the log-likelihood function of the sample is\n\n$$\nl(\\theta )=-5\\operatorname{ln}⁡(2\\pi )+a+b\\theta +c{\\theta }^{2},\n$$\n\nwhat is the value of $a+b+c?$\n\n*Hint: The probability density function for a normal random variable with mean $\\theta $ and standard deviation $1$ is given by* \n\n$$\nf(x)=\\frac{1}{\\sqrt{2\\pi }}{e}^{-(x-\\theta )^{2}/2},\\,x\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "Recall that if ${X}_{1},{X}_{2},…,{X}_{n}$ are independent and identically distributed continuous random variables with probability density function $f(x;\\theta ),$ where $\\theta $ is an unknown parameter, then the log-likelihood function of a random sample ${x}_{1},{x}_{2},…,{x}_{n}$ is\n\n$$\n\\begin{aligned}l(\\theta ) & =\\operatorname{ln}⁡L(\\theta ) \\\\  & =\\operatorname{ln}⁡({\\prod }_{i=1}^{n}f({x}_{i};\\theta )) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(f({x}_{i};\\theta )).\\end{aligned}\n$$\n\nIn our case, we are given a sample of $n=10$ independent normal random variables with unknown mean $\\theta $ and variance ${\\sigma }^{2}=1,$ for which the probability density function is\n\n$$\nf(x,\\theta )=\\frac{1}{\\sqrt{2\\pi }}{e}^{-(x-\\theta )^{2}/2},\\,x\\in (-\\infty ,\\infty ).\n$$\n\nNext, we write down the log-density function:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡f(x,\\theta ) & =\\operatorname{ln}⁡(\\frac{1}{\\sqrt{2\\pi }}{e}^{-(x-\\theta )^{2}/2}) \\\\  & =\\operatorname{ln}⁡(\\frac{1}{\\sqrt{2\\pi }})+\\operatorname{ln}⁡({e}^{-(x-\\theta )^{2}/2}) \\\\  & =-\\frac{1}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{(x-\\theta )^{2}}{2}.\\end{aligned}\n$$\n\nNow, we can calculate the log-likelihood function as follows:\n\n$$\n\\begin{aligned}l(\\theta ) & ={\\sum }_{i=1}^{n}(-\\frac{1}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{({x}_{i}-\\theta )^{2}}{2}) \\\\  & =-\\frac{n}{2}\\operatorname{ln}⁡(2\\pi )-{\\sum }_{i=1}^{n}\\frac{({x}_{i}-\\theta )^{2}}{2} \\\\  & =-\\frac{n}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{1}{2}({\\sum }_{i=1}^{n}{x}_{i}^{2}-2\\theta {\\sum }_{i=1}^{n}{x}_{i}+n{\\theta }^{2})\\end{aligned}\n$$\n\nWe are told that ${\\sum }_{i=1}^{10}{x}_{i}=41.2,$ ${\\sum }_{i=1}^{10}{x}_{i}^{2}=182.6,$ and $n=10.$ Therefore, \n\n$$\n\\begin{aligned}l(\\theta ) & =-\\frac{10}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{1}{2}(182.6-2\\theta \\cdot 41.2+10{\\theta }^{2}) \\\\  & =-5\\operatorname{ln}⁡(2\\pi )+(-91.3)+41.2\\theta +(-5){\\theta }^{2}.\\end{aligned}\n$$\n\nFinally, \n\n$$\na+b+c=(-91.3)+41.2+(-5)=-55.1.\n$$"} :step/id #uuid "19ee89b5-e5c0-5578-ad68-47b6d34875da" :step/next {:db/id #edb/ref 17592186543614}} {:db/id #edb/ref 17592186543614 :step/content {:db/id #edb/ref 17592186543505 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f7bf1e4-9398-55b3-bd2b-8515162867e4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4.14" :db/id #edb/ref 17592186542897} {:answer/id #uuid "94e0befa-4705-51e9-9630-de948e992209" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4.18" :db/id #edb/ref 17592186543030} {:answer/id #uuid "a8ba97b2-62e5-5ad9-99a5-29d92dd18008" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4.54" :db/id #edb/ref 17592186543086} {:answer/id #uuid "e5189590-8a2a-5040-af84-68d2107b8f6b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4.39" :db/id #edb/ref 17592186543222} {:answer/id #uuid "f57a279b-4104-5ca5-8808-72ea4b362832" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4.99" :db/id #edb/ref 17592186543269}] :answer-field/correct {:db/id #edb/ref 17592186543222} :answer-field/id #uuid "32c3ae4e-5559-5bc7-8d50-9bcf40432395" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186543321}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "5c4c55fe-2946-5795-a8c6-76c349270710" :question/math-academy-id "q-159960" :question/problem "Suppose ${X}_{1},{X}_{2},{X}_{3}$ is an I.I.D random sample with ${X}_{i}∼N(\\theta ,{1}^{2}),$ where $\\theta $ is an unknown mean. The log-likelihood function of the sample $0.5,\\,-0.8,\\,-1.3$ is\n\n$$\nl(\\theta )=-1.5\\operatorname{ln}⁡(2\\pi )+a+b\\theta +c{\\theta }^{2}\n$$\n\nWhat is the value of $a+b+c?$" :question/worked-solution "Recall that if ${X}_{1},{X}_{2},…,{X}_{n}$ are independent and identically distributed continuous random variables with probability density function $f(x;\\theta ),$ where $\\theta $ is an unknown parameter, then the log-likelihood function of a random sample ${x}_{1},{x}_{2},…,{x}_{n}$ is\n\n$$\n\\begin{aligned}l(\\theta ) & =\\operatorname{ln}⁡L(\\theta ) \\\\  & =\\operatorname{ln}⁡({\\prod }_{i=1}^{n}f({x}_{i};\\theta )) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(f({x}_{i};\\theta )).\\end{aligned}\n$$\n\nIn our case, we are given a sample of $n=3$ independent normal random variables with unknown mean $\\theta $ and variance ${\\sigma }^{2}=1,$ for which the probability density function is\n\n$$\nf(x,\\theta )=\\frac{1}{\\sigma \\sqrt{2\\pi }}{e}^{-\\frac{1}{2}{(\\frac{x-\\theta }{\\sigma })}^{2}}=\\frac{1}{\\sqrt{2\\pi }}{e}^{-(x-\\theta )^{2}/2},\\,x\\in (-\\infty ,\\infty ).\n$$\n\nNext, we write down the log-density function:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡f(x,\\theta ) & =\\operatorname{ln}⁡(\\frac{1}{\\sqrt{2\\pi }}{e}^{-(x-\\theta )^{2}/2}) \\\\  & =\\operatorname{ln}⁡(\\frac{1}{\\sqrt{2\\pi }})+\\operatorname{ln}⁡({e}^{-(x-\\theta )^{2}/2}) \\\\  & =-\\frac{1}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{(x-\\theta )^{2}}{2}.\\end{aligned}\n$$\n\nNow, we can calculate the log-likelihood function as follows:\n\n$$\n\\begin{aligned}l(\\theta ) & ={\\sum }_{i=1}^{n}(-\\frac{1}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{({x}_{i}-\\theta )^{2}}{2}) \\\\  & =-\\frac{n}{2}\\operatorname{ln}⁡(2\\pi )-{\\sum }_{i=1}^{n}\\frac{({x}_{i}-\\theta )^{2}}{2} \\\\  & =-\\frac{n}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{1}{2}({\\sum }_{i=1}^{n}{x}_{i}^{2}-2\\theta {\\sum }_{i=1}^{n}{x}_{i}+n{\\theta }^{2})\\end{aligned}\n$$\n\nFor our sample, we have that\n\n$$\n\\begin{aligned}S & ={\\sum }_{i=1}^{n}{x}_{i} \\\\  & =0.5+(-0.8)+(-1.3) \\\\  & =-1.6 \\\\ C & ={\\sum }_{i=1}^{n}{x}_{i}^{2} \\\\  & =(0.5)^{2}+(-0.8)^{2}+(-1.3)^{2} \\\\  & =2.58\\end{aligned}\n$$\n\nand $n=3.$ Therefore,  \n\n$$\n\\begin{aligned}l(\\theta ) & =-\\frac{3}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{1}{2}(2.58-2\\theta \\cdot (-1.6)+3{\\theta }^{2}) \\\\  & =-1.5\\operatorname{ln}⁡(2\\pi )+(-1.29)+(-1.6)\\theta +(-1.5){\\theta }^{2}.\\end{aligned}\n$$\n\nFinally, \n\n$$\na+b+c=-1.29+(-1.6)+(-1.5)=-4.39.\n$$"} :step/id #uuid "2d2f87b7-e858-5638-87e1-255173ffd6fc" :step/next {:db/id #edb/ref 17592186543639}} {:db/id #edb/ref 17592186543639 :step/content {:db/id #edb/ref 17592186543544 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47698303-8d61-5840-8827-86edae5c0ca9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3.1" :db/id #edb/ref 17592186542834} {:answer/id #uuid "48989a49-93e8-5124-b600-ec90d999d72c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3.3" :db/id #edb/ref 17592186542838} {:answer/id #uuid "7eef2b9f-e7ca-51a3-b197-a936d17dd502" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3.7" :db/id #edb/ref 17592186542981} {:answer/id #uuid "cc28b179-5541-543f-9559-8ecc8381e121" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3.5" :db/id #edb/ref 17592186543171} {:answer/id #uuid "e5647be5-c113-5d6c-87be-376b749ccd3e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3.9" :db/id #edb/ref 17592186543223}] :answer-field/correct {:db/id #edb/ref 17592186542981} :answer-field/id #uuid "2253fa4d-3bff-5c5d-817e-be26b444097e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186543313}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "aaf34c24-70f2-59f0-ad3e-3eb728abaa5d" :question/math-academy-id "q-159961" :question/problem "Suppose ${X}_{1},{X}_{2},{X}_{3},{X}_{4},{X}_{5}$ is an I.I.D random sample with ${X}_{i}∼N(\\theta ,{1}^{2}),$ where $\\theta $ is an unknown mean. The log-likelihood function of the sample $0.7,\\,0.6,\\,-0.5,\\,1.7,\\,-1.1$ is\n\n$$\nl(\\theta )=-2.5\\operatorname{ln}⁡(2\\pi )+a+b\\theta +c{\\theta }^{2}\n$$\n\nWhat is the value of $a+b+c?$" :question/worked-solution "Recall that if ${X}_{1},{X}_{2},…,{X}_{n}$ are independent and identically distributed continuous random variables with probability density function $f(x;\\theta ),$ where $\\theta $ is an unknown parameter, then the log-likelihood function of a random sample ${x}_{1},{x}_{2},…,{x}_{n}$ is\n\n$$\n\\begin{aligned}l(\\theta ) & =\\operatorname{ln}⁡L(\\theta ) \\\\  & =\\operatorname{ln}⁡({\\prod }_{i=1}^{n}f({x}_{i};\\theta )) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(f({x}_{i};\\theta )).\\end{aligned}\n$$\n\nIn our case, we are given a sample of $n=5$ independent normal random variables with unknown mean $\\theta $ and variance ${\\sigma }^{2}=1,$ for which the probability density function is\n\n$$\nf(x,\\theta )=\\frac{1}{\\sigma \\sqrt{2\\pi }}{e}^{-\\frac{1}{2}{(\\frac{x-\\theta }{\\sigma })}^{2}}=\\frac{1}{\\sqrt{2\\pi }}{e}^{-(x-\\theta )^{2}/2},\\,x\\in (-\\infty ,\\infty ).\n$$\n\nNext, we write down the log-density function:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡f(x,\\theta ) & =\\operatorname{ln}⁡(\\frac{1}{\\sqrt{2\\pi }}{e}^{-(x-\\theta )^{2}/2}) \\\\  & =\\operatorname{ln}⁡(\\frac{1}{\\sqrt{2\\pi }})+\\operatorname{ln}⁡({e}^{-(x-\\theta )^{2}/2}) \\\\  & =-\\frac{1}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{(x-\\theta )^{2}}{2}.\\end{aligned}\n$$\n\nNow, we can calculate the log-likelihood function as follows:\n\n$$\n\\begin{aligned}l(\\theta ) & ={\\sum }_{i=1}^{n}(-\\frac{1}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{({x}_{i}-\\theta )^{2}}{2}) \\\\  & =-\\frac{n}{2}\\operatorname{ln}⁡(2\\pi )-{\\sum }_{i=1}^{n}\\frac{({x}_{i}-\\theta )^{2}}{2} \\\\  & =-\\frac{n}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{1}{2}({\\sum }_{i=1}^{n}{x}_{i}^{2}-2\\theta {\\sum }_{i=1}^{n}{x}_{i}+n{\\theta }^{2})\\end{aligned}\n$$\n\nFor our sample, we have that\n\n$$\n\\begin{aligned}S & ={\\sum }_{i=1}^{n}{x}_{i} \\\\  & =0.7+0.6+(-0.5)+1.7+(-1.1) \\\\  & =1.4 \\\\ C & ={\\sum }_{i=1}^{n}{x}_{i}^{2} \\\\  & =(0.7)^{2}+(0.6)^{2}+(-0.5)^{2}+(1.7)^{2}+(-1.1)^{2} \\\\  & =5.2\\end{aligned}\n$$\n\nand $n=5.$ Therefore,  \n\n$$\n\\begin{aligned}l(\\theta ) & =-\\frac{5}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{1}{2}(5.2-2\\theta \\cdot (1.4)+5{\\theta }^{2}) \\\\  & =-2.5\\operatorname{ln}⁡(2\\pi )+(-2.6)+(1.4)\\theta +(-2.5){\\theta }^{2}.\\end{aligned}\n$$\n\nFinally, \n\n$$\na+b+c=-2.6+(1.4)+(-2.5)=-3.7.\n$$"} :step/id #uuid "6431c930-d07c-5012-83c3-a683117b63b6"} {:db/id #edb/ref 17592186543645 :step/content {:db/id #edb/ref 17592186543530 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46dd295d-b967-55be-baa9-615ef8947546" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-22" :db/id #edb/ref 17592186542831} {:answer/id #uuid "616179b8-6d31-545d-bd85-a8cbe1eea178" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-15" :db/id #edb/ref 17592186542903} {:answer/id #uuid "7880c273-b9f0-5ba3-92a1-bf42d3b1a839" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-18" :db/id #edb/ref 17592186542959} {:answer/id #uuid "b20ab84a-f38e-5407-8c0a-21d8ce7f5813" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "25" :db/id #edb/ref 17592186543103} {:answer/id #uuid "ef86d244-000d-57e4-bdb0-98870d062829" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "20" :db/id #edb/ref 17592186543251}] :answer-field/correct {:db/id #edb/ref 17592186542831} :answer-field/id #uuid "afd91053-3ad7-5610-9011-77c03294ee47" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186543420}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9473cd62-7434-5b05-96e0-e08528b86ef4" :question/math-academy-id "q-159926" :question/problem "Suppose ${X}_{1},{X}_{2},{X}_{3},{X}_{4}$ is an I.I.D random sample with ${X}_{i}∼\\text{Exp}(\\theta )$ and unknown rate parameter $\\theta .$ The log-likelihood function of the sample $8,\\,3,\\,5,\\,10$ is\n\n$$\nl(\\theta )=a\\operatorname{ln}⁡\\theta +b\\theta .\n$$\n\nWhat is the value of $a+b?$" :question/worked-solution "Recall that if ${X}_{1},{X}_{2},…,{X}_{n}$ are independent and identically distributed continuous random variables with probability density function $f(x;\\theta ),$ where $\\theta $ is an unknown parameter, then the log-likelihood function of a random sample ${x}_{1},{x}_{2},…,{x}_{n}$ is\n\n$$\n\\begin{aligned}l(\\theta ) & =\\operatorname{ln}⁡L(\\theta ) \\\\  & =\\operatorname{ln}⁡({\\prod }_{i=1}^{n}f({x}_{i};\\theta )) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(f({x}_{i};\\theta )).\\end{aligned}\n$$\n\nIn our case, we are given a sample of $n=4$ independent exponential random variables with unknown parameter $\\theta ,$ for which the probability density function is\n\n$$\nf(x,\\theta )=\\theta {e}^{-\\theta x},\\,x\\ge 0.\n$$\n\nNext, we write down the log-density function:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡f(x,\\theta ) & =\\operatorname{ln}⁡(\\theta {e}^{-\\theta x}) \\\\  & =\\operatorname{ln}⁡\\theta +\\operatorname{ln}⁡({e}^{-\\theta x}) \\\\  & =\\operatorname{ln}⁡\\theta -\\theta x.\\end{aligned}\n$$\n\nNow, we can calculate the log-likelihood function as follows:\n\n$$\n\\begin{aligned}l(\\theta ) & ={\\sum }_{i=1}^{n}(\\operatorname{ln}⁡\\theta -\\theta {x}_{i}) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡\\theta -\\theta {\\sum }_{i=1}^{n}{x}_{i} \\\\  & =n\\operatorname{ln}⁡\\theta -\\theta {\\sum }_{i=1}^{n}{x}_{i}\\end{aligned}\n$$\n\nFor our sample, we have that\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{n}{x}_{i} & =8+3+5+10=26\\end{aligned}\n$$\n\nand $n=4.$ Therefore,  \n\n$$\n\\begin{aligned}l(\\theta ) & =4\\operatorname{ln}⁡\\theta -\\theta \\cdot 26 \\\\  & =4\\operatorname{ln}⁡\\theta +(-26)\\theta .\\end{aligned}\n$$\n\nFinally, \n\n$$\na+b=4+(-26)=-22.\n$$"} :step/id #uuid "8181d357-c830-5d4e-876f-952449aa0c43" :step/next {:db/id #edb/ref 17592186543606}} {:db/id #edb/ref 17592186543658 :step/content {:db/id #edb/ref 17592186193200 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86ebb00f-65fb-5520-87a5-bc3fdfadb0d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-14.2" :db/id #edb/ref 17592186191087} {:answer/id #uuid "c857b9bd-0543-51d8-955f-4496a4008c20" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15.6" :db/id #edb/ref 17592186191088} {:answer/id #uuid "ef1d2869-103e-5146-9610-e2c16bed7582" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-12.6" :db/id #edb/ref 17592186191089} {:answer/id #uuid "f8933789-af2a-5567-9e36-f94314c93185" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-10.8" :db/id #edb/ref 17592186191090} {:answer/id #uuid "5d3ec56b-7dfc-5976-856a-8e5444a59fe2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10.4" :db/id #edb/ref 17592186191091}] :answer-field/correct {:db/id #edb/ref 17592186191089} :answer-field/id #uuid "6282a85e-8dae-5d3f-846e-ea59c64b0397" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186191086}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b7dcf32e-5721-58b3-a00b-d1865bbf3e18" :question/math-academy-id "q-159835" :question/problem "Suppose ${X}_{1},{X}_{2},{X}_{3}$ is an I.I.D random sample with ${X}_{i}∼\\text{Exp}(\\theta )$ and unknown rate parameter $\\theta .$ The log-likelihood function of the sample $5.1,\\,4.2,\\,6.3$ is\n\n$$\nl(\\theta )=a\\operatorname{ln}⁡\\theta +b\\theta .\n$$\n\nWhat is the value of $a+b?$" :question/requires-calculator true :question/worked-solution "Recall that if ${X}_{1},{X}_{2},…,{X}_{n}$ are independent and identically distributed continuous random variables with probability density function $f(x;\\theta ),$ where $\\theta $ is an unknown parameter, then the log-likelihood function of a random sample ${x}_{1},{x}_{2},…,{x}_{n}$ is\n\n$$\n\\begin{aligned}l(\\theta ) & =\\operatorname{ln}⁡L(\\theta ) \\\\  & =\\operatorname{ln}⁡({\\prod }_{i=1}^{n}f({x}_{i};\\theta )) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(f({x}_{i};\\theta )).\\end{aligned}\n$$\n\nIn our case, we are given a sample of $n=3$ independent exponential random variables with unknown parameter $\\theta ,$ for which the probability density function is\n\n$$\nf(x,\\theta )=\\theta {e}^{-\\theta x},\\,x\\ge 0.\n$$\n\nNext, we write down the log-density function:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡f(x,\\theta ) & =\\operatorname{ln}⁡(\\theta {e}^{-\\theta x}) \\\\  & =\\operatorname{ln}⁡\\theta +\\operatorname{ln}⁡({e}^{-\\theta x}) \\\\  & =\\operatorname{ln}⁡\\theta -\\theta x.\\end{aligned}\n$$\n\nNow, we can calculate the log-likelihood function as follows:\n\n$$\n\\begin{aligned}l(\\theta ) & ={\\sum }_{i=1}^{n}(\\operatorname{ln}⁡\\theta -\\theta {x}_{i}) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡\\theta -\\theta {\\sum }_{i=1}^{n}{x}_{i} \\\\  & =n\\operatorname{ln}⁡\\theta -\\theta {\\sum }_{i=1}^{n}{x}_{i}\\end{aligned}\n$$\n\nFor our sample, we have that\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{n}{x}_{i} & =5.1+4.2+6.3=15.6\\end{aligned}\n$$\n\nand $n=3.$ Therefore,  \n\n$$\n\\begin{aligned}l(\\theta ) & =3\\operatorname{ln}⁡\\theta -\\theta \\cdot 15.6 \\\\  & =3\\operatorname{ln}⁡\\theta +(-15.6)\\theta .\\end{aligned}\n$$\n\nFinally, \n\n$$\na+b=3+(-15.6)=-12.6.\n$$"} :step/id #uuid "b8626d06-e8cc-5e08-8191-4195c906b582" :step/next {:db/id #edb/ref 17592186543645}}] :activity/title "Log-Likelihood Functions for Continuous Probability Distributions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186542630}]}
