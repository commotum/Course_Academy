5417] [17592186493884 #edb/ref 1075 #edb/ref 17592186493660 #edb/ref 17592186045417] [17592186493884 #edb/ref 1075 #edb/ref 17592186493666 #edb/ref 17592186045417] [17592186493884 #edb/ref 1075 #edb/ref 17592186493759 #edb/ref 17592186045417] [17592186493884 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186493884 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186493884 #edb/ref 1078 #edb/ref 17592186493759 #edb/ref 17592186045417] [17592186493884 #edb/ref 1079 #uuid "eeb06b96-cbcf-5cb8-b34d-617abe9e3c88" #edb/ref 17592186045417] [17592186493972 #edb/ref 1068 #edb/ref 17592186493884 #edb/ref 17592186045417] [17592186493972 #edb/ref 1069 "q-162830" #edb/ref 17592186045417] [17592186493972 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186493972 #edb/ref 1071 "Use the method of Lagrange multipliers to find the maximum value of the function $f(x,y,z)=4x+2y-z$ on the intersection of the plane $x-y-z=2$ and the cylinder ${x}^{2}+{y}^{2}=2.$" #edb/ref 17592186045417] [17592186493972 #edb/ref 1072 #uuid "e3b568f7-cd27-5a4c-97e4-f5b7033e39b7" #edb/ref 17592186045417] [17592186493972 #edb/ref 1074 "We need to find the maximum value of \n\n$$\nf(x,y,z)=4x+2y-z\n$$\n\nsubject to the constraints \n\n$$\ng(x,y,z)=x-y-z=2,\\,h(x,y,z)={x}^{2}+{y}^{2}=2.\n$$\n\nSince $f(x,y,z)$ is continuous and the constraint is closed and bounded, $f(x,y,z)$ reaches a global maximum and a global minimum on the constraint. \n\nTherefore, by the method of Lagrange multipliers, we must solve the following system:\n\n$$\n\\left\\{\\begin{aligned}∇f(x,y,z) &=\\lambda ∇g(x,y,z)+\\mu ∇h(x,y,z) \\\\ g(x,y,z) &=2 \\\\ h(x,y,z) &=2\\end{aligned}\\right.\n$$\n\nWe start by expanding the first equation:\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\lambda ∇g(x,y,z)+\\mu ∇h(x,y,z) \\\\ ⟨{f}_{x},{f}_{y},{f}_{z}⟩ & =\\lambda ⟨{g}_{x},{g}_{y},{g}_{z}⟩+\\mu ⟨{h}_{x},{h}_{y},{h}_{z}⟩ \\\\ ⟨4,2,-1⟩ & =\\lambda ⟨1,-1,-1⟩+\\mu ⟨2x,2y,0⟩\\end{aligned}\n$$\n\n \n\nTherefore, we have the following system:\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}4 &=\\lambda +2\\mu x \\\\ 2 &=-\\lambda +2\\mu y \\\\ -1 &=-\\lambda\\end{aligned}\\right.\\,⇒\\,\\left\\{\\begin{aligned}x &=\\frac{3}{2\\mu } \\\\ y &=\\frac{3}{2\\mu } \\\\ \\lambda &=1\\end{aligned}\\right.\\end{aligned}\n$$\n\nNotice that $\\mu $ can't be zero since this leads to a contradiction.\n\nNext, we substitute our expressions for $x$ and $y$ into the second constraint:\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & =2 \\\\ \\frac{9}{4{\\mu }^{2}}+\\frac{9}{4{\\mu }^{2}} & =2 \\\\ \\frac{9}{2{\\mu }^{2}} & =2 \\\\ {\\mu }^{2} & =\\frac{9}{4} \\\\ \\mu  & =\\pm \\frac{3}{2}\\end{aligned}\n$$\n\nAs a result, since $x=y,$ we have\n\n$$\n(x,y)=(1,1)\\,\\text{or}\\,(x,y)=(-1,-1).\n$$\n\nFinally, we substitute $x$ and $y$ into the first constraint:\n\n- If $x=1$ and $y=1,$ we have\n\n$$\n\\begin{aligned}x-y-z & =2 \\\\ 1-1-z & =2 \\\\ z & =-2.\\end{aligned}\n$$\n\n- If $x=-1$ and $y=-1,$ we have\n\n$$\n\\begin{aligned}x-y-z & =2 \\\\ -1-(-1)-z & =2 \\\\ -1+1-z & =2 \\\\ z & =-2.\\end{aligned}\n$$\n\nTherefore, $f$ has possible extreme values at the points\n\n$$\n(1,1,-2),\\,(-1,-1,-2).\n$$\n\nWe evaluate $f$ at each of these points. These are given in the following table:\n\n| $(x,y,z)$ | $(1,1,-2)$ | $(-1,-1,-2)$ |\n| --- | --- | --- |\n| $f(x,y,z)$ | $8$ | $-4$ |\n\nTherefore, the function reaches a maximum value at $(1,1,-2),$ and its maximum value is $8.$" #edb/ref 17592186045443] [17592186512088 #edb/ref 1043 #edb/ref 17592186512970 #edb/ref 17592186045417] [17592186512088 #edb/ref 1043 #edb/ref 17592186512985 #edb/ref 17592186045417] [17592186512088 #edb/ref 1043 #edb/ref 17592186512994 #edb/ref 17592186045417] [17592186512088 #edb/ref 1043 #edb/ref 17592186512997 #edb/ref 17592186045417] [17592186512088 #edb/ref 1043 #edb/ref 17592186513026 #edb/ref 17592186045417] [17592186512088 #edb/ref 1044 #edb/ref 17592186045464 #edb/ref 17592186045417] [17592186512088 #edb/ref 1045 "Lagra