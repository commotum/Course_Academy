[{:db/id 17592186184245 :knowledge-point/questions ["question-299e84c3-302e-59ca-a6bf-7ea338b3c989" "question-24c0a70a-b19b-5dcb-b295-bcc9d3116966"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186183967 :question/problem "Complete the missing values in the truth table below.\n\n| $x_1$ | $x_2$ | $x_1 \\Rightarrow x_2$ |\n| --- | --- | --- |\n| $0$ | $0$ | $\\bbox[3pt,border:solid 1pt]{\\phantom{\\textrm{odd}}}$ |\n| $0$ | $1$ | $\\bbox[3pt,border:solid 1pt]{\\phantom{\\textrm{odd}}}$ |\n| $1$ | $0$ | $\\bbox[3pt,border:solid 1pt]{\\phantom{\\textrm{odd}}}$ |\n| $1$ | $1$ | $\\bbox[3pt,border:solid 1pt]{\\phantom{\\textrm{odd}}}$ |" :question/worked-solution "Recall that $\\textrm{True}=1$ and $\\textrm{False}=0.$ \n\nAlso, the implication $x_1 \\Rightarrow x_2$ is false if and only if $x_1$ is true ($1$) and $x_2$ is false ($0$).\n\nTherefore, the corresponding Boolean function is the following: \n\n| $x_1$ | $x_2$ | $x_1 \\Rightarrow x_2$ |\n| --- | --- | --- |\n| $0$ | $0$ | $\\bbox[3pt,Gainsboro]{\\color{blue}1}$ |\n| $0$ | $1$ | $\\bbox[3pt,Gainsboro]{\\color{blue}1}$ |\n| $1$ | $0$ | $\\bbox[3pt,Gainsboro]{\\color{blue}0}$ |\n| $1$ | $1$ | $\\bbox[3pt,Gainsboro]{\\color{blue}1}$ |" :db/ensure [:question/validate]} {:db/id 17592186184246 :knowledge-point/questions ["question-631faf9c-753c-5ce4-9bb0-18a7cee7c5e3" "question-3d8e760a-4507-5257-baf9-6866d2de62ab"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186184030 :question/problem "Complete the missing values in the truth table below.\n\n| $x_1$ | $x_2$ | $x_1 \\downarrow x_2$ |\n| --- | --- | --- |\n| $0$ | $0$ | $\\bbox[3pt,border:solid 1pt]{\\phantom{\\textrm{odd}}}$ |\n| $0$ | $1$ | $\\bbox[3pt,border:solid 1pt]{\\phantom{\\textrm{odd}}}$ |\n| $1$ | $0$ | $\\bbox[3pt,border:solid 1pt]{\\phantom{\\textrm{odd}}}$ |\n| $1$ | $1$ | $\\bbox[3pt,border:solid 1pt]{\\phantom{\\textrm{odd}}}$ |" :question/worked-solution "Recall that $\\textrm{True}=1$ and $\\textrm{False}=0.$ \n\nAlso, the Peirce arrow $x_1 \\downarrow x_2$ is true if and only if both $x_1$ and $x_2$ are false ($0$).\n\nTherefore, the corresponding Boolean function is the following: \n\n| $x_1$ | $x_2$ | $x_1 \\downarrow x_2$ |\n| --- | --- | --- |\n| $0$ | $0$ | $\\bbox[3pt,Gainsboro]{\\color{blue}1}$ |\n| $0$ | $1$ | $\\bbox[3pt,Gainsboro]{\\color{blue}0}$ |\n| $1$ | $0$ | $\\bbox[3pt,Gainsboro]{\\color{blue}0}$ |\n| $1$ | $1$ | $\\bbox[3pt,Gainsboro]{\\color{blue}0}$ |" :db/ensure [:question/validate]} {:db/id 17592186184247 :knowledge-point/questions ["question-28597957-c6bc-59f0-b600-9f61df7bfe65" "question-0fc91ddf-0818-5746-94d1-3b167ae593f9"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186183969 :question/problem "| ![](images/8c/8c33e6564649c3beca9591e67622629ffab451061b8a92931451ef854d188bcd.svg) | ![](images/f0/f00d200f2d3cb70131b5990167a1e3f765685450dd1dab8297988295f54be427.svg) | ![](images/df/df64c774b369d5808d97397198b45579ec882812d59bf5092abdfa6267fcd4d3.svg) |\n| --- | --- | --- |\n| ![](images/15/156b31ede73de5301befe67f02745a0202f1806a62f9fdecc6fc9ee3f21117ba.svg) | ![](images/15/156b31ede73de5301befe67f02745a0202f1806a62f9fdecc6fc9ee3f21117ba.svg) | ![](images/95/95836ae470c61ab15bfb67d6f0c92d2ad8d03d400b04473e81e58de3ee44bf32.svg) |\n| ![](images/15/156b31ede73de5301befe67f02745a0202f1806a62f9fdecc6fc9ee3f21117ba.svg) | ![](images/95/95836ae470c61ab15bfb67d6f0c92d2ad8d03d400b04473e81e58de3ee44bf32.svg) | ![](images/95/95836ae470c61ab15bfb67d6f0c92d2ad8d03d400b04473e81e58de3ee44bf32.svg) |\n| ![](images/95/95836ae470c61ab15bfb67d6f0c92d2ad8d03d400b04473e81e58de3ee44bf32.svg) | ![](images/15/156b31ede73de5301befe67f02745a0202f1806a62f9fdecc6fc9ee3f21117ba.svg) | ![](images/15/156b31ede73de5301befe67f02745a0202f1806a62f9fdecc6fc9ee3f21117ba.svg) |\n| ![](images/95/95836ae470c61ab15bfb67d6f0c92d2ad8d03d400b04473e81e58de3ee44bf32.svg) | ![](images/95/95836ae470c61ab15bfb67d6f0c92d2ad8d03d400b04473e81e58de3ee44bf32.svg) | ![](images/95/95836ae470c61ab15bfb67d6f0c92d2ad