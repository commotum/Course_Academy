#{[{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186492978} :activity/id #uuid "455ca42c-7c76-5300-91b9-ae6aa04f859f" :activity/scope {:db/id #edb/ref 17592186049375 :topic/id #uuid "eff38647-ee17-5513-ad67-94525b17bd40" :topic/math-academy-id 621} :activity/steps [{:db/id #edb/ref 17592186492932 :step/content {:db/id #edb/ref 17592186492912 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b421bb4d-d57d-58c5-91d5-941ee935054f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8.2" :db/id #edb/ref 17592186492577}] :answer-field/correct {:db/id #edb/ref 17592186492577} :answer-field/id #uuid "5a49ba44-a18c-572f-9889-3ebe1220fd5c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186492740}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d382317e-adb1-5580-86d4-be3a012ea508" :question/math-academy-id "q-346053" :question/problem "Let $f$ be a function such that ${f}^{′}(x)=3{x}^{2}-2x$ and $f(2)=5.$ Use the tangent line approximation of $f(x)$ at $x=2$ to estimate the value of $f(2.4).$ Do not round the answer.\n\n$f(2.4)≈$\n{{field-1}}" :question/worked-solution "The tangent line approximation of $f(x)$ at the point $a=2$ is\n\n$$\n\\begin{aligned}L(x) & =f(a)+{f}^{′}(a)(x-a) \\\\  & =f(2)+{f}^{′}(2)(x-2).\\end{aligned}\n$$\n\nWe're told that $f(2)=5,$ and since ${f}^{′}(x)=3{x}^{2}-2x,$ we have\n\n$$\n{f}^{′}(2)=3(2)^{2}-2(2)=12-4=8.\n$$\n\nSo, the tangent line approximation is given by\n\n$$\nL(x)=5+8(x-2).\n$$\n\nNow, we can approximate $f(2.4)$ by evaluating the tangent line approximation at $x=2.4.$ We get\n\n$$\n\\begin{aligned}f(2.4) & ≈L(2.4) \\\\  & =5+8(2.4-2) \\\\  & =5+8(0.4) \\\\  & =5+3.2 \\\\  & =8.2.\\end{aligned}\n$$"} :step/id #uuid "0d9ad38c-433d-50ba-89b8-79d1f4ef9ffa" :step/next {:db/id #edb/ref 17592186492955}} {:db/id #edb/ref 17592186492955 :step/content {:db/id #edb/ref 17592186492906 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1be0819e-e32e-5ef6-97d4-15b2e23dacdf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.9" :db/id #edb/ref 17592186492269} {:answer/id #uuid "6ecca4ab-9aea-5781-96bb-820669fd7e72" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.7" :db/id #edb/ref 17592186492436} {:answer/id #uuid "8500dd81-e29c-5504-be31-e4e0a9a0eb2b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.4" :db/id #edb/ref 17592186492484} {:answer/id #uuid "95cb96a6-c568-5bb0-952f-972cc891d363" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.1" :db/id #edb/ref 17592186492505} {:answer/id #uuid "ceca9693-3483-5422-9145-bd8fbfe73fda" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.3" :db/id #edb/ref 17592186492626}] :answer-field/correct {:db/id #edb/ref 17592186492436} :answer-field/id #uuid "59fa50a0-4d01-5c7c-859f-4dbcf823f9f3" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186492738} {:answer-field/choices [{:answer/id #uuid "14f2a850-012a-5580-b8a7-57dc089f382e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "underestimate" :db/id #edb/ref 17592186492256} {:answer/id #uuid "999c6a53-0e3f-57e7-ab55-c9f41de35cba" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "overestimate" :db/id #edb/ref 17592186492516}] :answer-field/correct {:db/id #edb/ref 17592186492256} :answer-field/id #uuid "e6a25890-8790-51f7-a94b-8b42c7efdcea" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186492805}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "bfc00702-2e19-5641-9f78-a3bfcfb36d0e" :question/math-academy-id "q-346717" :question/problem "The graph of the function $y=f(x)$ passes through $(0,1)$ and is concave up on the interval $(-1,2).$ If ${f}^{′}(0)=1,$ estimate the value of $f(-0.3)$ using the tangent line approximation of $f(x)$ at $x=0$ and determine whether the approximation is an underestimate or overestimate.\n\n$\\,f(-0.3)≈$ {{field-1}} and the approximation is an {{field-2}}." :question/worked-solution "The tangent line approximation of $f(x)$ at the point $a=0$ is \n\n$$\n\\begin{aligned}L(x) & =f(a)+{f}^{′}(a)(x-a) \\\\  & =f(0)+{f}^{′}(0)(x-0).\\end{aligned}\n$$\n\nThe graph of the function passes through the point $(0,1),$ so we have $f(0)=1.$ Also, we're told that ${f}^{′}(0)=1.$ So, we obtain\n\n$$\n\\begin{aligned}L(x) & =1+1(x-0) \\\\  & =1+x.\\end{aligned}\n$$\n\nNow, we can approximate $f(-0.3)$ by evaluating the tangent line approximation at $x=-0.3.$ We get\n\n$$\n\\begin{aligned}f(-0.3) & ≈L(-0.3) \\\\  & =1+(-0.3) \\\\  & =0.7.\\end{aligned}\n$$\n\nFinally, since the function is concave up on the interval $(-1,2),$ the linear approximation $L(x)$ is below the graph near $x=0,$ and therefore we have an $\\text{underestimate}.$"} :step/id #uuid "6b42d425-4cde-5eb5-be9e-2e8616d2acbb"} {:db/id #edb/ref 17592186492969 :step/content {:db/id #edb/ref 17592186492845 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a547162-cfa3-59b2-bf37-5f807c2a4ca9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$f(x)$ is concave down in the neighborhood of $x=3$" :db/id #edb/ref 17592186492303} {:answer/id #uuid "3920e40c-6417-5dae-af53-10980d572249" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$f(x)$ has a local minimum at $x=3$" :db/id #edb/ref 17592186492339} {:answer/id #uuid "64cdcc2c-abc6-529e-a57a-d38b505a0e19" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$f(x)$ has an inflection point at $x=3$" :db/id #edb/ref 17592186492418} {:answer/id #uuid "7478861d-f3b8-551f-87de-db08ec6d1ea1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$f(x)$ is concave up in the neighborhood of $x=3$" :db/id #edb/ref 17592186492450} {:answer/id #uuid "75b59e00-4955-5185-9a45-7fe9f929117b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$f(x)$ is increasing in the neighborhood of $x=3$" :db/id #edb/ref 17592186492453}] :answer-field/correct {:db/id #edb/ref 17592186492450} :answer-field/id #uuid "a316d6e9-3769-5f80-845f-4a7c1ae14f3f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186492771}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2fd9627c-83fd-577e-93d9-1dea3b352d6e" :question/math-academy-id "q-48045" :question/problem "Given that the tangent line approximation to the function $f(x)$ at $x=3$ underestimates the function in the neighborhood of $x=3,$ which of the following must be true?" :question/worked-solution "Since the tangent line approximation of $f(x)$ at $x=3$ underestimates the values of this function in the neighborhood of $x=3$, we have\n\n$$\nL(x)<f(x),\n$$\n\nfor all $x$ close to (but not equal to) $x=3.$ In other words, the line $L(x)$ must be *below* the graph of $f(x)$ near the point  $x=3.$\n\nTherefore, the function must be concave up in the neighborhood of $x=3.$"} :step/id #uuid "8fe411e2-028a-531d-ad89-3fff08a9c9f5" :step/next {:db/id #edb/ref 17592186492982}} {:db/id #edb/ref 17592186492978 :step/content {:db/id #edb/ref 17592186364226 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45fe17a1-d11e-5ef2-a485-5fbcd2100bcc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5.5" :db/id #edb/ref 17592186364228} {:answer/id #uuid "d516aced-a928-5914-9082-f564a782a28b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186364229} {:answer/id #uuid "f4ba16b8-0f05-5dd7-b702-a0bd9e5f4c67" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186364230} {:answer/id #uuid "34896b00-823a-5083-8e9e-bc2fc0d9d7c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3.5" :db/id #edb/ref 17592186364231} {:answer/id #uuid "effc20e5-6c6d-58bc-9b08-56dab08a74ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186364232}] :answer-field/correct {:db/id #edb/ref 17592186364230} :answer-field/id #uuid "496c5022-25df-547f-b02e-e179117a549f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186364227}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7c05a076-435e-50b5-bc51-d3ae092e8ee4" :question/math-academy-id "q-4814" :question/problem "Let $f$ be a function such that ${f}^{′}(x)=12{x}^{2}-6$ and $f(1)=-2.$ Use the tangent line approximation of $f(x)$ at $x=1$ to estimate the value of $f(2).$" :question/worked-solution "The tangent line approximation of $f(x)$ at the point $a=1$ is\n\n$$\n\\begin{aligned}L(x) & =f(a)+{f}^{′}(a)(x-a) \\\\  & =f(1)+{f}^{′}(1)(x-1).\\end{aligned}\n$$\n\nWe're told that $f(1)=-2,$ and since ${f}^{′}(x)=12{x}^{2}-6,$ then ${f}^{′}(1)=12(1)^{2}-6=6.$ So, the tangent line approximation is given by\n\n$$\nL(x)=-2+6(x-1).\n$$\n\nNow, we can approximate $f(2)$ by evaluating the tangent line approximation at $x=2.$ We get\n\n$$\n\\begin{aligned}f(2) & ≈L(2) \\\\  & =-2+6(2-1) \\\\  & =-2+6(1) \\\\  & =-2+6 \\\\  & =4.\\end{aligned}\n$$"} :step/id #uuid "a5424259-87b3-5634-8eb1-23ea6d96d73b" :step/next {:db/id #edb/ref 17592186492969}} {:db/id #edb/ref 17592186492982 :step/content {:db/id #edb/ref 17592186399878 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d0f6466d-f440-58c1-8723-cde1e85101c0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$f(\\sqrt{2})≈5,$ an underestimate" :db/id #edb/ref 17592186399880} {:answer/id #uuid "1906a013-62f9-568e-95ae-98c68b274de9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$f(\\sqrt{2})≈6,$ an underestimate" :db/id #edb/ref 17592186399881} {:answer/id #uuid "261b2021-339d-51c1-a9b8-1c77073b9824" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$f(\\sqrt{2})≈6,$ an overestimate" :db/id #edb/ref 17592186399882} {:answer/id #uuid "d631bbed-d22a-5f68-8054-c6e4993d2296" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$f(\\sqrt{2})≈\\frac{1}{2\\sqrt{2}},$ an overestimate" :db/id #edb/ref 17592186399883} {:answer/id #uuid "87b365d2-efb1-55b5-ba28-a027ed309d15" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$f(\\sqrt{2})≈5,$ an overestimate" :db/id #edb/ref 17592186399884}] :answer-field/correct {:db/id #edb/ref 17592186399882} :answer-field/id #uuid "4547a518-52cd-55fa-a5a7-64752ebe189c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186399879}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a7b7e632-32b9-5dd9-98c7-3b49b8d1e749" :question/math-academy-id "q-115348" :question/problem "The graph of the function $y=f(x)$ passes through $(0,5)$ and is concave down on the interval $(-\\pi ,\\pi ).$ If ${f}^{′}(0)=\\frac{1}{\\sqrt{2}},$ estimate the value of $f(\\sqrt{2})$ using the tangent line approximation of $f(x)$ at $x=0$ and determine whether the approximation is an underestimate or overestimate." :question/worked-solution "The tangent line approximation of $f(x)$ at the point $a=0$ is \n\n$$\n\\begin{aligned}L(x) & =f(a)+{f}^{′}(a)(x-a) \\\\  & =f(0)+{f}^{′}(0)(x-0).\\end{aligned}\n$$\n\nThe function passes through the point $(0,5),$ so we have $f(0)=5.$ Also, we're told that ${f}^{′}(0)=\\frac{1}{\\sqrt{2}},$ so we get\n\n$$\n\\begin{aligned}L(x) & =5+\\frac{1}{\\sqrt{2}}(x-0) \\\\  & =5+\\frac{x}{\\sqrt{2}}.\\end{aligned}\n$$\n\nWe can approximate $f(\\sqrt{2})$ by evaluating the tangent line approximation at $x=\\sqrt{2}.$ We get\n\n$$\n\\begin{aligned}f(\\sqrt{2}) & ≈L(\\sqrt{2}) \\\\  & =5+\\frac{\\sqrt{2}}{\\sqrt{2}} \\\\  & =5+1 \\\\  & =6.\\end{aligned}\n$$\n\nFinally, since the function is concave down on the interval $(-\\pi ,\\pi ),$ the linear approximation $L(x)$ is above the graph near $x=0,$ and therefore we have an overestimate."} :step/id #uuid "a66bdb1b-7763-515f-9f1c-bbad66d3c6ef" :step/next {:db/id #edb/ref 17592186492932}}] :activity/title "Approximating Functions Using Local Linearity and Linearization" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186492208}]}
