#{[{:db/id #edb/ref 17592186399878 :knowledge-point/_questions [{:db/id #edb/ref 17592186078568 :knowledge-point/id #uuid "9f542453-9758-55e6-93c6-6bfd2139ec45" :knowledge-point/title "Computing a Tangent Line Approximation and Classifying it as an Underestimate or Overestimate"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d0f6466d-f440-58c1-8723-cde1e85101c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(\\sqrt{2})≈5,$ an underestimate" :db/id #edb/ref 17592186399880} {:answer/id #uuid "1906a013-62f9-568e-95ae-98c68b274de9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(\\sqrt{2})≈6,$ an underestimate" :db/id #edb/ref 17592186399881} {:answer/id #uuid "261b2021-339d-51c1-a9b8-1c77073b9824" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(\\sqrt{2})≈6,$ an overestimate" :db/id #edb/ref 17592186399882} {:answer/id #uuid "d631bbed-d22a-5f68-8054-c6e4993d2296" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(\\sqrt{2})≈\\frac{1}{2\\sqrt{2}},$ an overestimate" :db/id #edb/ref 17592186399883} {:answer/id #uuid "87b365d2-efb1-55b5-ba28-a027ed309d15" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(\\sqrt{2})≈5,$ an overestimate" :db/id #edb/ref 17592186399884}] :answer-field/correct {:answer/id #uuid "261b2021-339d-51c1-a9b8-1c77073b9824" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(\\sqrt{2})≈6,$ an overestimate" :db/id #edb/ref 17592186399882} :answer-field/id #uuid "4547a518-52cd-55fa-a5a7-64752ebe189c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399879}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a7b7e632-32b9-5dd9-98c7-3b49b8d1e749" :question/math-academy-id "q-115348" :question/problem "The graph of the function $y=f(x)$ passes through $(0,5)$ and is concave down on the interval $(-\\pi ,\\pi ).$ If ${f}^{′}(0)=\\frac{1}{\\sqrt{2}},$ estimate the value of $f(\\sqrt{2})$ using the tangent line approximation of $f(x)$ at $x=0$ and determine whether the approximation is an underestimate or overestimate." :question/worked-solution "The tangent line approximation of $f(x)$ at the point $a=0$ is \n\n$$\n\\begin{aligned}L(x) & =f(a)+{f}^{′}(a)(x-a) \\\\  & =f(0)+{f}^{′}(0)(x-0).\\end{aligned}\n$$\n\nThe function passes through the point $(0,5),$ so we have $f(0)=5.$ Also, we're told that ${f}^{′}(0)=\\frac{1}{\\sqrt{2}},$ so we get\n\n$$\n\\begin{aligned}L(x) & =5+\\frac{1}{\\sqrt{2}}(x-0) \\\\  & =5+\\frac{x}{\\sqrt{2}}.\\end{aligned}\n$$\n\nWe can approximate $f(\\sqrt{2})$ by evaluating the tangent line approximation at $x=\\sqrt{2}.$ We get\n\n$$\n\\begin{aligned}f(\\sqrt{2}) & ≈L(\\sqrt{2}) \\\\  & =5+\\frac{\\sqrt{2}}{\\sqrt{2}} \\\\  & =5+1 \\\\  & =6.\\end{aligned}\n$$\n\nFinally, since the function is concave down on the interval $(-\\pi ,\\pi ),$ the linear approximation $L(x)$ is above the graph near $x=0,$ and therefore we have an overestimate."}] [{:db/id #edb/ref 17592186364226 :knowledge-point/_questions [{:db/id #edb/ref 17592186078567 :knowledge-point/id #uuid "1b0dd714-5bf1-573f-9ff9-11802622ce92" :knowledge-point/title "Estimating the Value of a Function at a Point Given its Derivative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45fe17a1-d11e-5ef2-a485-5fbcd2100bcc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.5" :db/id #edb/ref 17592186364228} {:answer/id #uuid "d516aced-a928-5914-9082-f564a782a28b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186364229} {:answer/id #uuid "f4ba16b8-0f05-5dd7-b702-a0bd9e5f4c67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186364230} {:answer/id #uuid "34896b00-823a-5083-8e9e-bc2fc0d9d7c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.5" :db/id #edb/ref 17592186364231} {:answer/id #uuid "effc20e5-6c6d-58bc-9b08-56dab08a74ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186364232}] :answer-field/correct {:answer/id #uuid "f4ba16b8-0f05-5dd7-b702-a0bd9e5f4c67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186364230} :answer-field/id #uuid "496c5022-25df-547f-b02e-e179117a549f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186364227}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7c05a076-435e-50b5-bc51-d3ae092e8ee4" :question/math-academy-id "q-4814" :question/problem "Let $f$ be a function such that ${f}^{′}(x)=12{x}^{2}-6$ and $f(1)=-2.$ Use the tangent line approximation of $f(x)$ at $x=1$ to estimate the value of $f(2).$" :question/worked-solution "The tangent line approximation of $f(x)$ at the point $a=1$ is\n\n$$\n\\begin{aligned}L(x) & =f(a)+{f}^{′}(a)(x-a) \\\\  & =f(1)+{f}^{′}(1)(x-1).\\end{aligned}\n$$\n\nWe're told that $f(1)=-2,$ and since ${f}^{′}(x)=12{x}^{2}-6,$ then ${f}^{′}(1)=12(1)^{2}-6=6.$ So, the tangent line approximation is given by\n\n$$\nL(x)=-2+6(x-1).\n$$\n\nNow, we can approximate $f(2)$ by evaluating the tangent line approximation at $x=2.$ We get\n\n$$\n\\begin{aligned}f(2) & ≈L(2) \\\\  & =-2+6(2-1) \\\\  & =-2+6(1) \\\\  & =-2+6 \\\\  & =4.\\end{aligned}\n$$"}]}
