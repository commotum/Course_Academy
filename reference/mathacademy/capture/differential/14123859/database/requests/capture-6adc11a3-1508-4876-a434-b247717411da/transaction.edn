[{:db/id 17592186087840 :knowledge-point/questions ["question-05225557-6476-5115-9d07-1e8467a995db"] :db/ensure [:knowledge-point/validate]} {:db/id "question-05225557-6476-5115-9d07-1e8467a995db" :question/id #uuid "05225557-6476-5115-9d07-1e8467a995db" :question/math-academy-id "q-73631" :question/problem "![](images/39/3989e71a908c5536d97732e253effe16fadb6382a90610db0a8693eec8161393.png)\n\nWhat is the equation of the ellipse given above?" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the horizontal radius has length $a=5$ and the vertical radius has length $b=7.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}} & =1 \\\\ \\frac{{x}^{2}}{{5}^{2}}+\\frac{{y}^{2}}{{7}^{2}} & =1 \\\\ \\frac{{x}^{2}}{25}+\\frac{{y}^{2}}{49} & =1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a872ab99-4b04-549f-a3e0-8010a8cc8418"] :db/ensure [:question/validate]} {:db/id "answer-field-a872ab99-4b04-549f-a3e0-8010a8cc8418" :answer-field/id #uuid "a872ab99-4b04-549f-a3e0-8010a8cc8418" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3c37fde0-293d-5fff-8b41-8792f1c3b2d4" :answer-field/choices ["answer-60162dda-59fc-569f-9bbc-f89a1da9b64e" "answer-3c37fde0-293d-5fff-8b41-8792f1c3b2d4" "answer-7a4b634a-7190-518b-8a3e-0e64b953f99a" "answer-650d25a5-3c4b-5948-9c9f-4ca92962040c" "answer-f7ee88ea-070f-5d68-aaa9-8fb89bd88756"] :db/ensure [:answer-field/validate]} {:db/id "answer-60162dda-59fc-569f-9bbc-f89a1da9b64e" :answer/id #uuid "60162dda-59fc-569f-9bbc-f89a1da9b64e" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{16}+\\frac{{y}^{2}}{49}=1" :db/ensure [:answer/validate]} {:db/id "answer-3c37fde0-293d-5fff-8b41-8792f1c3b2d4" :answer/id #uuid "3c37fde0-293d-5fff-8b41-8792f1c3b2d4" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{25}+\\frac{{y}^{2}}{49}=1" :db/ensure [:answer/validate]} {:db/id "answer-7a4b634a-7190-518b-8a3e-0e64b953f99a" :answer/id #uuid "7a4b634a-7190-518b-8a3e-0e64b953f99a" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{49}+\\frac{{y}^{2}}{25}=1" :db/ensure [:answer/validate]} {:db/id "answer-650d25a5-3c4b-5948-9c9f-4ca92962040c" :answer/id #uuid "650d25a5-3c4b-5948-9c9f-4ca92962040c" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{5}+\\frac{{y}^{2}}{7}=1" :db/ensure [:answer/validate]} {:db/id "answer-f7ee88ea-070f-5d68-aaa9-8fb89bd88756" :answer/id #uuid "f7ee88ea-070f-5d68-aaa9-8fb89bd88756" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{7}+\\frac{{y}^{2}}{5}=1" :db/ensure [:answer/validate]} {:db/id "activity-f98781fb-0e3e-56a0-8fd8-a889cb513084" :activity/id #uuid "f98781fb-0e3e-56a0-8fd8-a889cb513084" :activity/title "Equations of Ellipses Centered at the Origin" :activity/type :activity.type/review :activity/scope 17592186049456 :activity/course 17592186046658 :activity/steps ["step-05a824a1-fef7-52fd-b42e-f37a8a9561f2" "step-9002f488-6289-5d99-b35a-dbc5df691ad1" "step-047f66db-66e3-5f7a-9815-4fd47c15afae" "step-343e00c9-2c9c-5130-85cb-9db7d2b119ce" "step-ba407b04-0f45-5fb8-bef8-bfffcd4599ad"] :activity/first-step "step-05a824a1-fef7-52fd-b42e-f37a8a9561f2" :db/ensure [:activity/validate]} {:db/id "step-05a824a1-fef7-52fd-b42e-f37a8a9561f2" :step/id #uuid "05a824a1-fef7-52fd-b42e-f37a8a9561f2" :step/content 17592186335983 :step/next "step-9002f488-6289-5d99-b35a-dbc5df691ad1" :db/ensure [:step/validate]} {:db/id "step-9002f488-6289-5d99-b35a-dbc5df691ad1" :step/id #uuid "9002f488-6289-5d99-b35a-dbc5df691ad1" :step/content "question-05225557-6476-5115-9d07-1e8467a995db" :step/next "step-047f66db-66e3-5f7a-9815-4fd47c15afae" :db/ensure [:step/validate]} {:db/id "step-047f66db-