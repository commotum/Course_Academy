#{[{:db/id #edb/ref 17592186399850 :knowledge-point/_questions [{:db/id #edb/ref 17592186087841 :knowledge-point/id #uuid "4e43e393-8752-58bc-b87c-b72f679cbfd9" :knowledge-point/title "Determining the Lengths of the Major and Minor Axes Given the Equation of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d4ffa0ff-df0b-5bc5-b896-3f6772a35019" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$28$ and $24$" :db/id #edb/ref 17592186399852} {:answer/id #uuid "e8f1177f-3e11-593f-ad9c-dda3299fba50" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$24.5$ and $18$" :db/id #edb/ref 17592186399853} {:answer/id #uuid "e59ee665-26a4-5d2e-8c55-26143f2480d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$14$ and $12$" :db/id #edb/ref 17592186399854} {:answer/id #uuid "ee829b75-97f1-545e-8cf4-3704340f4ba1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$49$ and $36$" :db/id #edb/ref 17592186399855} {:answer/id #uuid "f8e390e1-9f85-5321-a954-3f147b97e82b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$7$ and $6$" :db/id #edb/ref 17592186399856}] :answer-field/correct {:answer/id #uuid "e59ee665-26a4-5d2e-8c55-26143f2480d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$14$ and $12$" :db/id #edb/ref 17592186399854} :answer-field/id #uuid "44102d96-20a4-51fc-add2-7a7a026df6ba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399851}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3113828e-6ca6-530b-804d-2cdc91aade73" :question/math-academy-id "q-115134" :question/problem "What are the lengths of the major and minor axes of an ellipse with equation \n$\\frac{{x}^{2}}{49}+\\frac{{y}^{2}}{36}=1?$" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nIn the given equation, we have ${a}^{2}=49$ and ${b}^{2}=36.$\n\n- Since ${a}^{2}=49,$ the length of the horizontal radius must be $a=\\sqrt{49}=7.$\n\n- Since ${b}^{2}=36,$ the length of the vertical radius must be $b=\\sqrt{36}=6.$\n\nThus, the semi-major axis has length $a=7,$ and the semi-minor axis has length $b=6.$\n\nTherefore, the major axis has length $2a=2\\cdot 7=14,$ and the minor axis has length $2b=2\\cdot 6=12.$"}] [{:db/id #edb/ref 17592186294935 :knowledge-point/_questions [{:db/id #edb/ref 17592186087840 :knowledge-point/id #uuid "de557d1d-5f27-50e3-bcba-22b21f83267f" :knowledge-point/title "Determining the Equation of a Tall Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "92fade62-72f5-5c55-aa78-c2d0dbaf2b44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{49}" :db/id #edb/ref 17592186293509}] :answer-field/correct {:answer/id #uuid "92fade62-72f5-5c55-aa78-c2d0dbaf2b44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{49}" :db/id #edb/ref 17592186293509} :answer-field/id #uuid "a9711613-beb2-54c9-ab19-cae6c7783280" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294539}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5ee547bf-f7e1-51f3-bed2-e58fc1c418f5" :question/math-academy-id "q-277921" :question/problem "![](images/ab/ab3d1fefcefa12133ec4ea7e3e6ce744c88f5a9b25029c950254706097cb4c4d.png)\n\nWhat is the equation of the ellipse given above?\n\n{{field-1}}$=1$" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the horizontal radius has length $a=2$ and the vertical radius has length $b=7.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}} & =1 \\\\ \\frac{{x}^{2}}{{2}^{2}}+\\frac{{y}^{2}}{{7}^{2}} & =1 \\\\ \\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{49} & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186295049 :knowledge-point/_questions [{:db/id #edb/ref 17592186087841 :knowledge-point/id #uuid "4e43e393-8752-58bc-b87c-b72f679cbfd9" :knowledge-point/title "Determining the Lengths of the Major and Minor Axes Given the Equation of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ee64a24f-4e3c-5796-94b8-769faa4d203e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186293859}] :answer-field/correct {:answer/id #uuid "ee64a24f-4e3c-5796-94b8-769faa4d203e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186293859} :answer-field/id #uuid "4d433ad7-9ca0-5240-8e86-ff3b484b7323" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294199} {:answer-field/choices [{:answer/id #uuid "c1efda85-532c-5456-9085-146b731f4efb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186293689}] :answer-field/correct {:answer/id #uuid "c1efda85-532c-5456-9085-146b731f4efb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186293689} :answer-field/id #uuid "eb9daf9a-554c-59f2-8703-ec452d9cbcc0" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294757}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c976c0d3-2975-5e8a-a067-1b42fba6644e" :question/math-academy-id "q-279169" :question/problem "For the ellipse $\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{25}=1,$ find the lengths of its major and minor axes.\n\n$\\,$ The length of the major axis is \n{{field-1}}.\n\n$\\,$ The length of the minor axis is \n{{field-2}}." :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nIn the given equation, we have ${a}^{2}=4$ and ${b}^{2}=25.$\n\n- Since ${a}^{2}=4,$ the length of the horizontal radius must be $a=\\sqrt{4}=2.$\n\n- Since ${b}^{2}=25,$ the length of the vertical radius must be $b=\\sqrt{25}=5.$\n\nThus, the semi-major axis has length $b=5,$ and the semi-minor axis has length $a=2.$\n\nTherefore, the major axis has length $2b=2\\cdot 5=10,$ and the minor axis has length $2a=2\\cdot 2=4.$"}] [{:db/id #edb/ref 17592186335983 :knowledge-point/_questions [{:db/id #edb/ref 17592186087841 :knowledge-point/id #uuid "4e43e393-8752-58bc-b87c-b72f679cbfd9" :knowledge-point/title "Determining the Lengths of the Major and Minor Axes Given the Equation of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "447870c5-0e16-591a-8300-97b1a1b53090" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$14$ and $4$" :db/id #edb/ref 17592186333622} {:answer/id #uuid "548b03ca-4238-5b00-9cb4-91def2cc07cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$14\\sqrt{2}$ and $4\\sqrt{2}$" :db/id #edb/ref 17592186333761} {:answer/id #uuid "68381630-1c58-5c47-b731-887a1f1decb0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$7$ and $4$" :db/id #edb/ref 17592186333945} {:answer/id #uuid "6aa132ec-2b5e-506f-9009-d06c05f62c18" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$7$ and $2$" :db/id #edb/ref 17592186333966} {:answer/id #uuid "f94f55ce-3720-511d-baaa-529e5639ba46" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$7\\sqrt{2}$ and $2\\sqrt{2}$" :db/id #edb/ref 17592186335173}] :answer-field/correct {:answer/id #uuid "447870c5-0e16-591a-8300-97b1a1b53090" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$14$ and $4$" :db/id #edb/ref 17592186333622} :answer-field/id #uuid "c27addb0-e02b-555b-8abb-615b89631ce7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335594}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "50aac069-cc6f-51ae-b729-84e72b0989dd" :question/math-academy-id "q-69563" :question/problem "What are the lengths of the major and minor axes of an ellipse with equation \n$\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{49}=1?$" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nIn the given equation, we have ${a}^{2}=4$ and ${b}^{2}=49.$\n\n- Since ${a}^{2}=4,$ the length of the horizontal radius must be $a=\\sqrt{4}=2.$\n\n- Since ${b}^{2}=49,$ the length of the vertical radius must be $b=\\sqrt{49}=7.$\n\nSo the semi-major axis has length $b=7,$ and the semi-minor axis has length $a=2.$\n\nTherefore, the major axis has length $2b=2\\cdot 7=14,$ and the minor axis has length $2a=2\\cdot 2=4.$"}]}
