#{[{:activity/first-step {:db/id #edb/ref 17592186088758} :activity/id #uuid "fb7a132a-7adf-51d5-b01a-ed19474e4867" :activity/scope {:db/id #edb/ref 17592186049456 :topic/id #uuid "f6e279fc-81eb-5f98-9ec1-265f25361906" :topic/math-academy-id 848} :activity/steps [{:db/id #edb/ref 17592186088758 :step/content {:db/id #edb/ref 17592186088902 :tutorial/content "The equation of an ellipse centered at the origin with a horizontal radius of length $\\color{red}a$ and a vertical radius of length $\\color{blue}b$ is given by\n\n$$\n\\dfrac{x^2}{{\\color{red}a}^2}+\\dfrac{y^2}{{\\color{blue}b}^2}=1.\n$$\n\n \n\n![](images/92/9227839bbf9a01312c3014d336a88176eecd73aa934fcd4741c11271b1e0bea6.png)\n\nTo demonstrate, let's determine the equation of the following ellipse. The horizontal radius has length $\\color{red}a=3$ and the vertical radius has length $\\color{blue}b=2.$\n\n![](images/fe/fe7dff90438e9571ae599a446e355776fbd36ed4746dd76e6633f3848e1f6bbc.png)\n\nTherefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{{3}^{2}}+\\frac{{y}^{2}}{{2}^{2}} & =1 \\\\ \\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{4} & =1.\\end{aligned}\n$$" :tutorial/id #uuid "dfd31765-db4b-5a8f-a4f9-3cd31b487aea" :tutorial/math-academy-id 3347 :tutorial/title "Introduction"} :step/id #uuid "36e8b9ee-bc84-580d-871e-f8f79a6f06fa" :step/math-academy-id 464704 :step/next {:db/id #edb/ref 17592186088759}} {:db/id #edb/ref 17592186088759 :step/content {:db/id #edb/ref 17592186087839 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087515 :question/id #uuid "446ea007-1ff4-5023-8e3f-7f00eb0fb2d0" :question/math-academy-id "e-5071"} :knowledge-point/id #uuid "f88c1deb-cd11-5b68-b90b-2d8edfae2469" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048432} {:db/id #edb/ref 17592186048811}] :knowledge-point/questions [{:db/id #edb/ref 17592186088323} {:db/id #edb/ref 17592186088324} {:db/id #edb/ref 17592186295041} {:db/id #edb/ref 17592186295042} {:db/id #edb/ref 17592186295043} {:db/id #edb/ref 17592186295044} {:db/id #edb/ref 17592186336013} {:db/id #edb/ref 17592186342034} {:db/id #edb/ref 17592186369182} {:db/id #edb/ref 17592186369999} {:db/id #edb/ref 17592186370002} {:db/id #edb/ref 17592186370993}] :knowledge-point/title "Determining the Equation of a Wide Ellipse"} :step/id #uuid "170ade24-159a-5d44-8c0e-76b19230035f" :step/math-academy-id 464705 :step/next {:db/id #edb/ref 17592186088760}} {:db/id #edb/ref 17592186088760 :step/content {:db/id #edb/ref 17592186087840 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087516 :question/id #uuid "af56117c-65e0-5f12-9780-7a95e6be829e" :question/math-academy-id "e-5072"} :knowledge-point/id #uuid "de557d1d-5f27-50e3-bcba-22b21f83267f" :knowledge-point/questions [{:db/id #edb/ref 17592186088122} {:db/id #edb/ref 17592186088325} {:db/id #edb/ref 17592186250346} {:db/id #edb/ref 17592186250347} {:db/id #edb/ref 17592186250348} {:db/id #edb/ref 17592186250349} {:db/id #edb/ref 17592186284499} {:db/id #edb/ref 17592186294935} {:db/id #edb/ref 17592186295045} {:db/id #edb/ref 17592186295046} {:db/id #edb/ref 17592186336014} {:db/id #edb/ref 17592186336015} {:db/id #edb/ref 17592186342039} {:db/id #edb/ref 17592186345158} {:db/id #edb/ref 17592186345178} {:db/id #edb/ref 17592186370005} {:db/id #edb/ref 17592186370008} {:db/id #edb/ref 17592186370011} {:db/id #edb/ref 17592186370014} {:db/id #edb/ref 17592186370017}] :knowledge-point/title "Determining the Equation of a Tall Ellipse"} :step/id #uuid "4f0c0c1a-1d65-50f3-8ad6-64c8261515cf" :step/math-academy-id 464708 :step/next {:db/id #edb/ref 17592186088761}} {:db/id #edb/ref 17592186088761 :step/content {:db/id #edb/ref 17592186088903 :tutorial/content "The **axes** of an ellipse are the horizontal and vertical diameters of the ellipse.\n\n- The **major axis** of an ellipse is the *larger* of the horizontal and vertical diameters.\n\n- The **minor axis** of an ellipse is the *shorter* of the horizontal and vertical diameters.\n\nFor example, the ellipse below has a major axis of $6$ and a minor axis of $4.$\n\n![](images/42/426ef9412a96730e50d78437fce2f1d45d7be4d4c175e3a230f4a696e0811189.png)\n\nThe **semi-axes** of an ellipse are the horizontal and vertical radii of the ellipse.\n\n- The **semi-major axis** of an ellipse is the *larger* of the horizontal and vertical radii. In other words, it is half the length of the major axis.\n\n- The **semi-minor axis** of an ellipse is the *shorter* of the horizontal and vertical radii. In other words, it is half the length of the minor axis.\n\nFor example, the ellipse below has a semi-major axis of length $3$ and a semi-minor axis of length $2.$\n\n![](images/b0/b031900464b03a9c2c2a7a9fe4cfaf40932f8d0c76b9d952cebf64d82a6261bc.png)" :tutorial/id #uuid "fd403f68-d6b8-5336-b699-87bcfaeadef8" :tutorial/math-academy-id 3348 :tutorial/title "Major and Minor Axes"} :step/id #uuid "bacaca5a-c3a9-5061-9de7-c982a78a225f" :step/math-academy-id 464711 :step/next {:db/id #edb/ref 17592186088762}} {:db/id #edb/ref 17592186088762 :step/content {:db/id #edb/ref 17592186087841 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087517 :question/id #uuid "b7c94673-f847-5977-9b9f-8d235ea42eb2" :question/math-academy-id "e-5073"} :knowledge-point/id #uuid "4e43e393-8752-58bc-b87c-b72f679cbfd9" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049923}] :knowledge-point/questions [{:db/id #edb/ref 17592186088321} {:db/id #edb/ref 17592186088322} {:db/id #edb/ref 17592186250350} {:db/id #edb/ref 17592186250351} {:db/id #edb/ref 17592186284503} {:db/id #edb/ref 17592186284508} {:db/id #edb/ref 17592186294936} {:db/id #edb/ref 17592186295047} {:db/id #edb/ref 17592186295048} {:db/id #edb/ref 17592186295049} {:db/id #edb/ref 17592186295050} {:db/id #edb/ref 17592186295051} {:db/id #edb/ref 17592186295052} {:db/id #edb/ref 17592186335983} {:db/id #edb/ref 17592186345141} {:db/id #edb/ref 17592186345157} {:db/id #edb/ref 17592186370020} {:db/id #edb/ref 17592186396120} {:db/id #edb/ref 17592186396127} {:db/id #edb/ref 17592186399850} {:db/id #edb/ref 17592186401537}] :knowledge-point/title "Determining the Lengths of the Major and Minor Axes Given the Equation of an Ellipse"} :step/id #uuid "c6b41627-794b-5ac3-b0e8-df5ed175150e" :step/math-academy-id 464712}] :activity/title "Equations of Ellipses Centered at the Origin" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186087919}]}
