 1 & -4\\end{aligned}]\\end{aligned}\n$$\n\nFrom the RREF matrix above, we see that the pivot columns are the $1$st and $2$nd columns. So,  $B$ is indeed a basis of $\\text{Span}\\{{a}_{1},{a}_{2},{a}_{3}\\}.$\nAlso, the matrix tells us that ${x}_{1}=-2$ and ${x}_{2}=-4,$ meaning that\n\n$$\n(-2)\\cdot {{[\\begin{aligned}1 \\\\ 1\\end{aligned}]}_{⏟}}_{{a}_{1}}+(-4)\\cdot {{[\\begin{aligned}1 \\\\ 2\\end{aligned}]}_{⏟}}_{{a}_{2}}={{[\\begin{aligned}-6 \\\\ -10\\end{aligned}]}_{⏟}}_{{a}_{3}}.\n$$\n\nTherefore, ${x}_{1}\\cdot {x}_{2}=(-2)\\cdot (-4)=8.$" 13194139534621 17592186045417 true] [17592186345207 1074 "We want to determine if $B$ is indeed a basis of $\\text{Span}{{a}_{1},{a}_{2},{a}_{3}}.$ So, we want to find ${x}_{1},{x}_{2}\\in R$ such that \n\n$$\n{x}_{1}{{[\\begin{aligned}1 \\\\ 1\\end{aligned}]}_{⏟}}_{{a}_{1}}+{x}_{2}{{[\\begin{aligned}1 \\\\ 2\\end{aligned}]}_{⏟}}_{{a}_{2}}={{[\\begin{aligned}-6 \\\\ -10\\end{aligned}]}_{⏟}}_{{a}_{3}}.\n$$\n\nThis equation is equivalent to the system\n\n$$\n{\\begin{aligned}{x}_{1}+{x}_{2}=-6 \\\\ {x}_{1}+2{x}_{2}=-10\\end{aligned}\n$$\n\nNow, we reduce the augmented matrix of the system to reduced row echelon form (RREF):\n\n$$\n\\begin{aligned} & \\,\\,[\\begin{aligned}1 & 1 & -6 \\\\ 1 & 2 & -10\\end{aligned}] & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & -6 \\\\ 0 & 1 & -4\\end{aligned}] & {R}_{1} & :={R}_{1}+(-1){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & -2 \\\\ 0 & 1 & -4\\end{aligned}]\\end{aligned}\n$$\n\nFrom the RREF matrix above, we see that the pivot columns are the $1$st and $2$nd columns. So,  $B$ is indeed a basis of $\\text{Span}{{a}_{1},{a}_{2},{a}_{3}}.$\nAlso, the matrix tells us that ${x}_{1}=-2$ and ${x}_{2}=-4,$ meaning that\n\n$$\n(-2)\\cdot {{[\\begin{aligned}1 \\\\ 1\\end{aligned}]}_{⏟}}_{{a}_{1}}+(-4)\\cdot {{[\\begin{aligned}1 \\\\ 2\\end{aligned}]}_{⏟}}_{{a}_{2}}={{[\\begin{aligned}-6 \\\\ -10\\end{aligned}]}_{⏟}}_{{a}_{3}}.\n$$\n\nTherefore, ${x}_{1}\\cdot {x}_{2}=(-2)\\