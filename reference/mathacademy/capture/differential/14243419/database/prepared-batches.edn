9d8ecc11d" :answer-field/choices "answer-1a137401-bd57-566e-9d85-d212c9ba2e04"] ["answer-field-a4d9a73c-49d9-5fa1-8da6-76c9d8ecc11d" :answer-field/choices "answer-16b90e9b-90ed-511a-9ae3-962fa6391abf"] ["question-2ea1e232-4156-584c-babd-20b14e2a349e" :question/answer-fields "answer-field-a4d9a73c-49d9-5fa1-8da6-76c9d8ecc11d"] [17592186083188 :knowledge-point/questions "question-2ea1e232-4156-584c-babd-20b14e2a349e"] ["question-8de5ec05-717f-57d0-aca0-bdf66baf299d" :question/id #uuid "8de5ec05-717f-57d0-aca0-bdf66baf299d"] ["question-8de5ec05-717f-57d0-aca0-bdf66baf299d" :question/math-academy-id "q-52259"] ["question-8de5ec05-717f-57d0-aca0-bdf66baf299d" :question/problem "![](images/5c/5cb63eb200d809aa94800fc7990c9a621ad2aca32d86cb1aeb39c844eb9c8205.png)\n\nFind the value of $k$ for the parabola $y=k{x}^{2}+12x-6,$ shown above."] ["question-8de5ec05-717f-57d0-aca0-bdf66baf299d" :question/worked-solution "First, we will calculate the axis of symmetry in terms of $k.$ Then, since the graph tells us that the axis of symmetry is $x=-3,$ we will set our result equal to $-3.$ \n\nThe equation of the axis of symmetry of the parabola $y=a{x}^{2}+bx+c$ is given by\n\n$$\nx=-\\frac{b}{2a}.\n$$\n\nSubstituting $a=k$ and $b=12$ into the formula for the axis of symmetry, we get\n\n$$\n\\begin{aligned}x & =-\\frac{12}{2(k)} \\\\  & =-\\frac{12}{2k} \\\\  & =-\\frac{6}{k}.\\end{aligned}\n$$\n\nWe already know that the axis of symmetry is $x=-3,$ so we must have\n\n$$\n\\begin{aligned}-\\frac{6}{k} & =-3 \\\\ -6 & =-3k \\\\ k & =2.\\end{aligned}\n$$"] ["question-8de5ec05-717f-57d0-aca0-bdf66baf299d" :question/difficulty :question.difficulty/easy] ["answer-field-08b63179-28da-5781-a56a-19cfea55072a" :answer-field/id #uuid "08b63179-28da-5781-a56a-19cfea55072a"] ["answer-98059165-843e-5163-a0dc-8950574baeac" :answer/id #uuid "98059165-843e-5163-a0dc-8950574baeac"] ["answer-98059165-843e-5163-a0dc-8950574baeac" :answer/type :answer.type/math] ["answer-98059165-843e-5163-a0dc-8950574b