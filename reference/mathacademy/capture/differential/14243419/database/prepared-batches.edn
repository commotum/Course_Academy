37-8deb-926f506792fc"] ["question-0b6f37ac-511e-531f-9fd9-0e1aa3bfef93" :question/answer-fields "answer-field-dca6600a-f1ed-5820-b07a-a9d181dedbc7"] [17592186083187 :knowledge-point/questions "question-0b6f37ac-511e-531f-9fd9-0e1aa3bfef93"] ["question-621c054c-a8ee-5e21-b7c5-55a43d66b230" :question/id #uuid "621c054c-a8ee-5e21-b7c5-55a43d66b230"] ["question-621c054c-a8ee-5e21-b7c5-55a43d66b230" :question/math-academy-id "q-222082"] ["question-621c054c-a8ee-5e21-b7c5-55a43d66b230" :question/problem "What are the coordinates of the vertex of the parabola $y={x}^{2}-6x+7?$\n\nThe coordinates of the vertex are\n$($\n{{field-1}}\n,\n{{field-2}}\n$).$"] ["question-621c054c-a8ee-5e21-b7c5-55a43d66b230" :question/worked-solution "The parabola's vertex lies on the symmetry axis, so we will start by computing the axis of symmetry. \n\nThe equation of the axis of symmetry of the parabola $y=a{x}^{2}+bx+c$ is given by\n\n$$\nx=-\\frac{b}{2a}.\n$$\n\nSubstituting $a=1$ and $b=-6$ into the formula for the axis of symmetry, we get\n\n$$\n\\begin{aligned}x & =-\\frac{(-6)}{2(1)} \\\\  & =-\\frac{(-6)}{2} \\\\  & =3.\\end{aligned}\n$$\n\nTherefore, the equation of the axis of symmetry is $x=3.$ This also represents the $x$-coordinate of the vertex. To find the $y$-coordinate of the vertex, we substitute $x=3$ into the original equation:\n\n$$\n\\begin{aligned}y & ={x}^{2}-6x+7 \\\\  & ={3}^{2}-6(3)+7 \\\\  & =9-18+7 \\\\  & =-2\\end{aligned}\n$$\n\nTherefore, the vertex is at $(3,-2).$"] ["question-621c054c-a8ee-5e21-b7c5-55a43d66b230" :question/difficulty :question.difficulty/easy] ["answer-field-bca17f37-d098-5fee-a7b9-8d476bb24f52" :answer-field/id #uuid "bca17f37-d098-5fee-a7b9-8d476bb24f52"] ["answer-980f0782-9bf6-5d75-917f-90617c2af852" :answer/id #uuid "980f0782-9bf6-5d75-917f-90617c2af852"] ["answer-980f0782-9bf6-5d75-917f-90617c2af852" :answer/type :answer.type/math] ["answer-980f0782-9bf6-5d75-917f-90617c2af852" :answer/value "3"] ["answer-field-bca17f37-d098-5fee-a7b9-8d476bb24f52" :answer-field/key "field-1"] ["answer-field-bca17f37-d098-5fee-a7b9-8d476bb24f52" :answer-field/type :answer-field.type/blank] ["answer-field-bca17f37-d098-5fee-a7b9-8d476bb24f52" :answer-field/correct "answer-980f0782-9bf6-5d75-917f-90617c2af852"] ["answer-field-bca17f37-d098-5fee-a7b9-8d476bb24f52" :answer-field/choices "answer-980f0782-9bf6-5d75-917f-90617c2af852"] ["answer-field-cab4b1dd-416a-506b-9085-7936c937e72b" :answer-field/id #uuid "cab4b1dd-416a-506b-9085-7936c937e72b"] ["answer-d25cb9d3-ae1c-5d4b-aad5-470049340353" :answer/id #uuid "d25cb9d3-ae1c-5d4b-aad5-470049340353"] ["answer-d25cb9d3-ae1c-5d4b-aad5-470049340353" :answer/type :answer.type/math] ["answer-d25cb9d3-ae1c-5d4b-aad5-470049340353" :answer/value "-2"] ["answer-field-cab4b1dd-416a-506b-9085-7936c937e72b" :answer-field/key "field-2"] ["answer-field-cab4b1dd-416a-506b-9085-7936c937e72b" :answer-field/type :answer-field.type/blank] ["answer-field-cab4b1dd-416a-506b-9085-7936c937e72b" :answer-field/correct "answer-d25cb9d3-ae1c-5d4b-aad5-470049340353"] ["answer-field-cab4b1dd-416a-506b-9085-7936c937e72b" :answer-field/choices "answer-d25cb9d3-ae1c-5d4b-aad5-470049340353"] ["question-621c054c-a8ee-5e21-b7c5-55a43d66b230" :question/answer-fields "answer-field-bca17f37-d098-5fee-a7b9-8d476bb24f52"] ["question-621c054c-a8ee-5e21-b7c5-55a43d66b230" :question/answer-fields "answer-field-cab4b1dd-416a-506b-9085-7936c937e72b"] [17592186083187 :knowledge-point/questions "question-621c054c-a8ee-5e21-b7c5-55a43d66b230"] ["question-9df948ff-fcd8-5687-95bb-a0bdf3f05629" :question/id #uuid "9df948ff-fcd8-5687-95bb-a0bdf3f05629"] ["question-9df948ff-fcd8-5687-95bb-a0bdf3f05629" :question/math-academy-id "q-13386"] ["question-9df948ff-fcd8-5687-95bb-a0bdf3f05629" :question/problem "Find the coordinates of the vertex of the parabola $y=3{x}^{2}+36x+6.$"] ["question-9df948ff-fcd8-5687-95bb-a0bdf3f05629" :question/worked-solution "The vertex of the parabola lies on the axis of symmetry, so we will start by computing the axis of symmetry. \n\nThe equation of the axis of symmetry of the parabola $y=a{x}^{2}+bx+c$ is given by\n\n$$\nx=-\\frac{b}{2a}.\n$$\n\nSubstituting $a=3$ and $b=36$ into the formula for the axis of symmetry, we get\n\n$$\n\\begin{aligned}x & =-\\frac{36}{2(3)} \\\\  & =-\\frac{36}{6} \\\\  & =-6.\\end{aligned}\n$$\n\nTherefore, the equation of the axis of symmetry is $x=-6.$ This also represents the $x$-coordinate of the vertex. To find the $y$-coordinate of the vertex, we substitute $x=-6$ into the original equation:\n\n$$\n\\begin{aligned}y & =3{x}^{2}+36x+6 \\\\  & =3(-6)^{2}+36(-6)+6 \\\\  & =108-216+6 \\\\  & =-102\\end{aligned}\n$$\n\nTherefore, the vertex is at $(-6,-102).$"] ["question-9df948ff-fcd8-5687-95bb-a0bdf3f05629" :question/difficulty :question.difficulty/easy] ["answer-field-2aca8f67-fa9a-544b-9a5d-d25691fbc92b" :answer-field/id #uuid "2aca8f67-fa9a-544b-9a5d-d25691fbc92b"] ["answer-62899510-a87d-5d7f-9a3f-4c33314df94a" :answer/id #uuid "62899510-a87d-5d7f-9a3f-4c33314df94a"] ["answer-62899510-a87d-5d7f-9a3f-4c33314df94a" :answer/type :answer.type/math] ["answer-62899510-a87d-5d7f-9a3f-4c33314df94a" :answer/value "(-3,-75)"] ["answer-f256a5f1-0204-5b93-af96-9f80b697b4bd" :answer/id #uuid "f256a5f1-0204-5b93-af96-9f80b697b4bd"] ["answer-f256a5f1-0204-5b93-af96-9f80b697b4bd" :answer/type :answer.type/math] ["answer-f256a5f1-0204-5b93-af96-9f80b697b4bd" :answer/value "(-6,-102)"] ["answer-30b8d0fd-6c5a-5866-938e-4356bd69904e" :answer/id #uuid "30b8d0fd-6c5a-5866-938e-4356bd69904e"] ["answer-30b8d0fd-6c5a-5866-938e-4356bd69904e" :answer/type :answer.type/math] ["answer-30b8d0fd-6c5a-5866-938e-4356bd69904e" :answer/value "(-6,54)"] ["answer-85daedbc-1998-5aa5-95d2-c689b6aecb21" :answer/id #uuid "85daedbc-1998-5aa5-95d2-c689b6aecb21"] ["answer-85daedbc-1998-5aa5-95d2-c689b6aecb21" :answer/type :answer.type/math] ["answer-85daedbc-1998-5aa5-95d2-c689b6aecb21" :answer/value "(3,50)"] ["answer-5f89c0ba-747e-5424-b392-8ae56dd31ab5" :answer/id #uuid "5f89c0ba-747e-5424-b392-8ae56dd31ab5"] ["answer-5f89c0ba-747e-5424-b392-8ae56dd31ab5" :answer/type :answer.type/math] ["answer-5f89c0ba-747e-5424-b392-8ae56dd31ab5" :answer/value "(6,48)"] ["answer-field-2aca8f67-fa9a-544b-9a5d-d25691fbc92b" :answer-field/key "selection"] ["answer-field-2aca8f67-fa9a-544b-9a5d-d25691fbc92b" :answer-field/type :answer-field.type/radio] ["answer-field-2aca8f67-fa9a-544b-9a5d-d25691fbc92b" :answer-field/correct "answer-f256a5f1-0204-5b93-af96-9f80b697b4bd"] ["answer-field-2aca8f67-fa9a-544b-9a5d-d25691fbc92b" :answer-field/choices "answer-62899510-a87d-5d7f-9a3f-4c33314df94a"] ["answer-field-2aca8f67-fa9a-544b-9a5d-d25691fbc92b" :answer-field/choices "answer-f256a5f1-0204-5b93-af96-9f80b697b4bd"] ["answer-field-2aca8f67-fa9a-544b-9a5d-d25691fbc92b" :answer-field/choices "answer-30b8d0fd-6c5a-5866-938e-4356bd69904e"] ["answer-field-2aca8f67-fa9a-544b-9a5d-d25691fbc92b" :answer-field/choices "answer-85daedbc-1998-5aa5-95d2-c689b6aecb21"] ["answer-field-2aca8f67-fa9a-544b-9a5d-d25691fbc92b" :answer-field/choices "answer-5f89c0ba-747e-5424-b392-8ae56dd31ab5"] ["question-9df948ff-fcd8-5687-95bb-a0bdf3f05629" :question/answer-fields "answer-field-2aca8f67-fa9a-544b-9a5d-d25691fbc92b"] [17592186083187 :knowledge-point/questions "question-9df948ff-fcd8-5687-95bb-a0bdf3f05629"] ["question-b4514a54-7bd5-5a89-8cc0-e28359cd784d" :question/id #uuid "b4514a54-7bd5-5a89-8cc0-e28359cd784d"] ["question-b4514a54-7bd5-5a89-8cc0-e28359cd784d" :question/math-academy-id "q-10324"] ["question-b4514a54-7bd5-5a89-8cc0-e28359cd784d" :question/problem "Find the coordinates of the vertex of the parabola $y=-5{x}^{2}+30x+2.$"] ["question-b4514a54-7bd5-5a89-8cc0-e28359cd784d" :question/worked-solution "The vertex of the parabola lies on the axis of symmetry, so we will start by computing the axis of symmetry. \n\nThe equation of the axis of symmetry of the parabola $y=a{x}^{2}+bx+c$ is given by\n\n$$\nx=-\\frac{b}{2a}.\n$$\n\nSubstituting $a=-5$ and $b=30$ into the formula for the axis of symmetry, we get\n\n$$\n\\begin{aligned}x & =-\\frac{30}{2(-5)} \\\\  & =-\\frac{30}{(-10)} \\\\  & =3.\\end{aligned}\n$$\n\nTherefore, the equation of the axis of symmetry is $x=3.$ This also represents the $x$-coordinate of the vertex. To find the $y$-coordinate of the vertex, we substitute $x=3$ into the original equation:\n\n$$\n\\begin{aligned}y & =-5{x}^{2}+30x+2 \\\\  & =-5(3)^{2}+30(3)+2 \\\\  & =-45+90+2 \\\\  & =47\\end{aligned}\n$$\n\nTherefore, the vertex is at $(3,47).$"] ["question-b4514a54-7bd5-5a89-8cc0-e28359cd784d" :question/difficulty :question.difficulty/moderate] ["answer-field-1b5e1f01-10ee-5e1a-99dc-d1ce7db0a46a" :answer-field/id #uuid "1b5e1f01-10ee-5e1a-99dc-d1ce7db0a46a"] ["answer-cf7569b9-f881-53b5-8879-4445f0b56f86" :answer/id #uuid "cf7569b9-f881-53b5-8879-4445f0b56f86"] ["answer-cf7569b9-f881-53b5-8879-4445f0b56f86" :answer/type :answer.type/math] ["answer-cf7569b9-f881-53b5-8879-4445f0b56f86" :answer/value "(-3,-133)"] ["answer-0b7f23c9-0bd5-5ec8-8fd7-e875fc1806da" :answer/id #uuid "0b7f23c9-0bd5-5ec8-8fd7-e875fc1806da"] ["answer-0b7f23c9-0bd5-5ec8-8fd7-e875fc1806da" :answer/type :answer.type/math] ["answer-0b7f23c9-0bd5-5ec8-8fd7-e875fc1806da" :answer/value "(-3,47)"] ["answer-bfe77f59-59d1-5211-8384-6829442bb7a3" :answer/id #uuid "bfe77f59-59d1-5211-8384-6829442bb7a3"] ["answer-bfe77f59-59d1-5211-8384-6829442bb7a3" :answer/type :answer.type/math] ["answer-bfe77f59-59d1-5211-8384-6829442bb7a3" :answer/value "(1,27)"] ["answer-6e9465f1-3630-5899-98a2-9ffd8b1c2a56" :answer/id #uuid "6e9465f1-3630-5899-98a2-9ffd8b1c2a56"] ["answer-6e9465f1-3630-5899-98a2-9ffd8b1c2a56" :answer/type :answer.type/math] ["answer-6e9465f1-3630-5899-98a2-9ffd8b1c2a56" :answer/value "(3,47)"] ["answer-317b6ffc-ad6b-5f25-a9ae-7a7a14382ea6" :answer/id #uuid "317b6ffc-ad6b-5f25-a9ae-7a7a14382ea6"] ["answer-317b6ffc-ad6b-5f25-a9ae-7a7a14382ea6" :answer/type :answer.type/math] ["answer-317b6ffc-ad6b-5f25-a9ae-7a7a14382ea6" :answer/value "(3,54)"] ["answer-field-1b5e1f01-10ee-5e1a-99dc-d1ce7db0a46a" :answer-field/key "selection"] ["answer-field-1b5e1f01-10ee-5e1a-99dc-d1ce7db0a46a" :answer-field/type :answer-field.type/radio] ["answer-field-1b5e1f01-10ee-5e1a-99dc-d1ce7db0a46a" :answer-field/correct "answer-6e9465f1-3630-5899-98a2-9ffd8b1c2a56"] ["answer-field-1b5e1f01-10ee-5e1a-99dc-d1ce7db0a46a" :answer-field/choices "answer-cf7569b9-f881-53b5-8879-4445f0b56f86"] ["answer-field-1b5e1f01-10ee-5e1a-99dc-d1ce7db0a46a" :answer-field/choices "answer-0b7f23c9-0bd5-5ec8-8fd7-e875fc1806da"] ["answer-field-1b5e1f01-10ee-5e1a-99dc-d1ce7db0a46a" :answer-field/choices "answer-bfe77f59-59d1-5211-8384-6829442bb7a3"] ["answer-field-1b5e1f01-10ee-5e1a-99dc-d1ce7db0a46a" :answer-field/choices "answer-6e9465f1-3630-5899-98a2-9ffd8b1c2a56"] ["answer-field-1b5e1f01-10ee-5e1a-99dc-d1ce7db0a46a" :answer-field/choices "answer-317b6ffc-ad6b-5f25-a9ae-7a7a14382ea6"] ["question-b4514a54-7bd5-5a89-8cc0-e28359cd784d" :question/answer-fields "answer-field-1b5e1f01-10ee-5e1a-99dc-d1ce7db0a46a"] [17592186083187 :knowledge-point/questions "question-b4514a54-7bd5-5a89-8cc0-e28359cd784d"] ["question-8a434264-115c-5e23-9940-79d2727ed021" :question/id #uuid "8a434264-115c-5e23-9940-79d2727ed021"] ["question-8a434264-115c-5e23-9940-79d2727ed021" :question/math-academy-id "q-52326"] ["question-8a434264-115c-5e23-9940-79d2727ed021" :question/problem "The axis of symmetry of the parabola $y=4{x}^{2}+kx-2$ is $x=-1.$ Find the value of $k.$"] ["question-8a434264-115c-5e23-9940-79d2727ed021" :question/worked-solution "First, we will calculate the axis of symmetry in terms of $k.$ Then, we will set our result equal to $-1.$ \n\nThe equation of the axis of symmetry of the parabola $y=a{x}^{2}+bx+c$ is given by\n\n$$\nx=-\\frac{b}{2a}.\n$$\n\nSubstituting $a=4$ and $b=k$ into the formula for the axis of symmetry, we get\n\n$$\n\\begin{aligned}x & =-\\frac{k}{2(4)} \\\\  & =-\\frac{k}{8}.\\end{aligned}\n$$\n\nWe already know that the axis of symmetry is $x=-1,$ so we must have\n\n$$\n\\begin{aligned}-\\frac{k}{8} & =-1 \\\\ -k & =-8 \\\\ k & =8.\\end{aligned}\n$$"] ["question-8a434264-115c-5e23-9940-79d2727ed021" :question/difficulty :question.difficulty/moderate] ["answer-field-0f668b4d-53cc-57b3-995b-4df60daafa74" :answer-field/id #uuid "0f668b4d-53cc-57b3-995b-4df60daafa74"] ["answer-a1424b21-9207-5fc2-931a-208860cb0e04" :answer/id #uuid "a1424b21-9207-5fc2-931a-208860cb0e04"] ["answer-a1424b21-9207-5fc2-931a-208860cb0e04" :answer/type :answer.type/math] ["answer-a1424b21-9207-5fc2-931a-208860cb0e04" :answer/value "10"] ["answer-3bb42019-06df-5498-9d29-49a2aeb6de50" :answer/id #uuid "3bb42019-06df-5498-9d29-49a2aeb6de50"] ["answer-3bb42019-06df-5498-9d29-49a2aeb6de50" :answer/type :answer.type/math] ["answer-3bb42019-06df-5498-9d29-49a2aeb6de50" :answer/value "2"] ["answer-2c78fe61-cf74-5dcb-97a3-cd26f9cf105f" :answer/id #uuid "2c78fe61-cf74-5dcb-97a3-cd26f9cf105f"] ["answer-2c78fe61-cf74-5dcb-97a3-cd26f9cf105f" :answer/type :answer.type/math] ["answer-2c78fe61-cf74-5dcb-97a3-cd26f9cf105f" :answer/value "4"] ["answer-0d47cbe0-a293-5059-81ae-ce84f00371dd" :answer/id #uuid "0d47cbe0-a293-5059-81ae-ce84f00371dd"] ["answer-0d47cbe0-a293-5059-81ae-ce84f00371dd" :answer/type :answer.type/math] ["answer-0d47cbe0-a293-5059-81ae-ce84f00371dd" :answer/value "6"] ["answer-8af2d063-d5b4-5386-9515-7976cb518a55" :answer/id #uuid "8af2d063-d5b4-5386-9515-7976cb518a55"] ["answer-8af2d063-d5b4-5386-9515-7976cb518a55" :answer/type :answer.type/math] ["answer-8af2d063-d5b4-5386-9515-7976cb518a55" :answer/value "8"] ["answer-field-0f668b4d-53cc-57b3-995b-4df60daafa74" :answer-field/key "selection"] ["answer-field-0f668b4d-53cc-57b3-995b-4df60daafa74" :answer-field/type :answer-field.type/radio] ["answer-field-0f668b4d-53cc-57b3-995b-4df60daafa74" :answer-field/correct "answer-8af2d063-d5b4-5386-9515-7976cb518a55"] ["answer-field-0f668b4d-53cc-57b3-995b-4df60daafa74" :answer-field/choices "answer-a1424b21-9207-5fc2-931a-208860cb0e04"] ["answer-field-0f668b4d-53cc-57b3-995b-4df60daafa74" :answer-field/choices "answer-3bb42019-06df-5498-9d29-49a2aeb6de50"] ["answer-field-0f668b4d-53cc-57b3-995b-4df60daafa74" :answer-field/choices "answer-2c78fe61-cf74-5dcb-97a3-cd26f9cf105f"] ["answer-field-0f668b4d-53cc-57b3-995b-4df60daafa74" :answer-field/choices "answer-0d47cbe0-a293-5059-81ae-ce84f00371dd"] ["answer-field-0f668b4d-53cc-57b3-995b-4df60daafa74" :answer-field/choices "answer-8af2d063-d5b4-5386-9515-7976cb518a55"] ["question-8a434264-115c-5e23-9940-79d2727ed021" :question/answer-fields "answer-field-0f668b4d-53cc-57b3-995b-4df60daafa74"] [17592186083188 :knowledge-point/questions "question-8a434264-115c-5e23-9940-79d2727ed021"] ["question-2ea1e232-4156-584c-babd-20b14e2a349e" :question/id #uuid "2ea1e232-4156-584c-babd-20b14e2a349e"] ["question-2ea1e232-4156-584c-babd-20b14e2a349e" :question/math-academy-id "q-52329"] ["question-2ea1e232-4156-584c-babd-20b14e2a349e" :question/problem "![](images/5f/5f76e31fbf6e2d7b1398eaafc97e634e955b3314697d650d5f645555c1df289e.png)\n\nFind the value of $k$ for the parabola $y=3{x}^{2}+kx+2$ shown above."] ["question-2ea1e232-4156-584c-babd-20b14e2a349e" :question/worked-solution "First, we will calculate the axis of symmetry in terms of $k.$ Then, since the graph tells us that the axis of symmetry is $x=2,$ we will set our result equal to $2.$ \n\nThe equation of the axis of symmetry of the parabola $y=a{x}^{2}+bx+c$ is given by\n\n$$\nx=-\\frac{b}{2a}.\n$$\n\nSubstituting $a=3$ and $b=k$ into the formula for the axis of symmetry, we get\n\n$$\n\\begin{aligned}x & =-\\frac{k}{2(3)} \\\\  & =-\\frac{k}{6}.\\end{aligned}\n$$\n\nWe already know that the axis of symmetry is $x=2,$ so we must have\n\n$$\n\\begin{aligned}-\\frac{k}{6} & =2 \\\\ k & =-12.\\end{aligned}\n$$"] ["question-2ea1e232-4156-584c-babd-20b14e2a349e" :question/difficulty :question.difficulty/easy] ["answer-field-a4d9a73c-49d9-5fa1-8da6-76c9d8ecc11d" :answer-field/id #uuid "a