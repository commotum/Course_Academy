[{"source" ":org/Math-Academy" "forms" [{:db/id 17592186083186 :knowledge-point/questions ["question-89d5541c-c810-5b48-ae7e-160f63479682" "question-ff16fd72-aa33-5ed0-9859-414065a202fe" "question-7a249418-3166-5952-aa2e-ffdd779176d1" "question-3f0e7d2f-2da0-5cf5-aa62-0f9950fe080c"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186083187 :knowledge-point/questions ["question-0b6f37ac-511e-531f-9fd9-0e1aa3bfef93" "question-621c054c-a8ee-5e21-b7c5-55a43d66b230" "question-9df948ff-fcd8-5687-95bb-a0bdf3f05629" "question-b4514a54-7bd5-5a89-8cc0-e28359cd784d"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186083188 :knowledge-point/questions ["question-8a434264-115c-5e23-9940-79d2727ed021" "question-2ea1e232-4156-584c-babd-20b14e2a349e" "question-8de5ec05-717f-57d0-aca0-bdf66baf299d" "question-7198fc6e-53bf-58ce-9c21-b096160c3a27"] :db/ensure [:knowledge-point/validate]} {:db/id "question-89d5541c-c810-5b48-ae7e-160f63479682" :question/id #uuid "89d5541c-c810-5b48-ae7e-160f63479682" :question/math-academy-id "q-106536" :question/problem "Find the axis of symmetry for the parabola $y={x}^{2}-4x-7.$" :question/worked-solution "The equation of the axis of symmetry of the parabola $y=a{x}^{2}+bx+c$ is given by\n\n$$\nx=-\\frac{b}{2a}.\n$$\n\nWe substitute $a=1$ and $b=-4$ into the formula for the axis of symmetry. This gives\n\n$$\n\\begin{aligned}x & =-\\frac{(-4)}{2(1)} \\\\  & =\\frac{4}{2} \\\\  & =2.\\end{aligned}\n$$\n\nTherefore, the equation of the axis of symmetry is $x=2.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b8715ddf-30dc-5432-a1c8-2e10c7592a01"] :db/ensure [:question/validate]} {:db/id "answer-field-b8715ddf-30dc-5432-a1c8-2e10c7592a01" :answer-field/id #uuid "b8715ddf-30dc-5432-a1c8-2e10c7592a01" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f0daa7f1-cb33-52de-945c-35ad2167e1bf" :answer-field/choices ["answer-76d2dbf4-b89b-5c6a-a455-711686772052" "answer-ebedb26e-db16-51dd-97c1-c3b3ae7d081d" "answer-f0daa7f1-cb33-52de-945c-35ad2167e1bf" "answer-047eec8e-f012-55e2-ac80-1810d95bc41d" "answer-12dd1ab4-1788-5577-a5e5-6ac8740fa1a6"] :db/ensure [:answer-field/validate]} {:db/id "answer-76d2dbf4-b89b-5c6a-a455-711686772052" :answer/id #uuid "76d2dbf4-b89b-5c6a-a455-711686772052" :answer/type :answer.type/math :answer/value "x=-2" :db/ensure [:answer/validate]} {:db/id "answer-ebedb26e-db16-51dd-97c1-c3b3ae7d081d" :answer/id #uuid "ebedb26e-db16-51dd-97c1-c3b3ae7d081d" :answer/type :answer.type/math :answer/value "x=-\\frac{1}{8}" :db/ensure [:answer/validate]} {:db/id "answer-f0daa7f1-cb33-52de-945c-35ad2167e1bf" :answer/id #uuid "f0daa7f1-cb33-52de-945c-35ad2167e1bf" :answer/type :answer.type/math :answer/value "x=2" :db/ensure [:answer/validate]} {:db/id "answer-047eec8e-f012-55e2-ac80-1810d95bc41d" :answer/id #uuid "047eec8e-f012-55e2-ac80-1810d95bc41d" :answer/type :answer.type/math :answer/value "x=4" :db/ensure [:answer/validate]} {:db/id "answer-12dd1ab4-1788-5577-a5e5-6ac8740fa1a6" :answer/id #uuid "12dd1ab4-1788-5577-a5e5-6ac8740fa1a6" :answer/type :answer.type/math :answer/value "x=\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "question-ff16fd72-aa33-5ed0-9859-414065a202fe" :question/id #uuid "ff16fd72-aa33-5ed0-9859-414065a202fe" :question/math-academy-id "q-222076" :question/problem "The axis of symmetry of the parabola $y=4{x}^{2}+3x+2$ is $x=${{field-1}}." :question/worked-solution "The equation of the axis of symmetry of the parabola $y=a{x}^{2}+bx+c$ is given by\n\n$$\nx=-\\frac{b}{2a}.\n$$\n\nWe substitute $a=4$ and $b=3$ into the formula for the axis of symmetry. This gives\n\n$$\n\\begin{aligned}x & =-\\frac{3}{2(4)} \\\\  & =-\\frac{3}{8}.\\end{aligned}\n$$\n\nTherefore, the equation of the axis of symmetry is $x=-\\frac{3}{8}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-0ac0919c-bc03-5eb1-b683-8e74321045e2"] :db/ensure [:question/validate]} {:db/id "answer-field-0ac0919c-bc03-5eb1-b683-8e74321045e2" :answer-field/id #uuid "0ac0919c-bc03-5eb1-b683-8e74321045e2" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-4295ee61-6048-53f9-9797-3fb92b43b5bd" :answer-field/choices ["answer-4295ee61-6048-53f9-9797-3fb92b43b5bd"] :db/ensure [:answer-field/validate]} {:db/id "answer-4295ee61-6048-53f9-9797-3fb92b43b5bd" :answer/id #uuid "4295ee61-6048-53f9-9797-3fb92b43b5bd" :answer/type :answer.type/math :answer/value "-\\frac{3}{8}" :db/ensure [:answer/validate]} {:db/id "question-7a249418-3166-5952-aa2e-ffdd779176d1" :question/id #uuid "7a249418-3166-5952-aa2e-ffdd779176d1" :question/math-academy-id "q-106539" :question/problem "Find the axis of symmetry for the parabola $y=2{x}^{2}+8x-3.$" :question/worked-solution "The equation of the axis of symmetry of the parabola $y=a{x}^{2}+bx+c$ is given by\n\n$$\nx=-\\frac{b}{2a}.\n$$\n\nWe substitute $a=2$ and $b=8$ into the formula for the axis of symmetry. This gives\n\n$$\n\\begin{aligned}x & =-\\frac{8}{2(2)} \\\\  & =-\\frac{8}{4} \\\\  & =-2.\\end{aligned}\n$$\n\nTherefore, the equation of the axis of symmetry is $x=-2.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-58080bed-1ac2-5652-ab76-b460fa71e917"] :db/ensure [:question/validate]} {:db/id "answer-field-58080bed-1ac2-5652-ab76-b460fa71e917" :answer-field/id #uuid "58080bed-1ac2-5652-ab76-b460fa71e917" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-df7c299f-a11e-5927-ad5b-bcd08a02bd4e" :answer-field/choices ["answer-df7c299f-a11e-5927-ad5b-bcd08a02bd4e" "answer-dace083e-ae80-5311-9205-e754e34dc1f4" "answer-b1fbd0b0-1be4-52eb-a17b-70d994f0ef95" "answer-366f61ee-82b5-511f-9834-78fe121c414a" "answer-404b7834-6467-595c-8689-798a9dd0ba2b"] :db/ensure [:answer-field/validate]} {:db/id "answer-df7c299f-a11e-5927-ad5b-bcd08a02bd4e" :answer/id #uuid "df7c299f-a11e-5927-ad5