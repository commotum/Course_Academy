5a7-580c-976d-0f5f94cccf47" :answer-field/choices "answer-6c7d6dad-f969-5f91-a45e-3d713c825d49"] ["answer-field-367bd5f7-e5a7-580c-976d-0f5f94cccf47" :answer-field/choices "answer-0c3f92cf-9ad6-5ac6-bcf8-367dd8ea8269"] ["question-3f0e7d2f-2da0-5cf5-aa62-0f9950fe080c" :question/answer-fields "answer-field-367bd5f7-e5a7-580c-976d-0f5f94cccf47"] [17592186083186 :knowledge-point/questions "question-3f0e7d2f-2da0-5cf5-aa62-0f9950fe080c"] ["question-0b6f37ac-511e-531f-9fd9-0e1aa3bfef93" :question/id #uuid "0b6f37ac-511e-531f-9fd9-0e1aa3bfef93"] ["question-0b6f37ac-511e-531f-9fd9-0e1aa3bfef93" :question/math-academy-id "q-106543"] ["question-0b6f37ac-511e-531f-9fd9-0e1aa3bfef93" :question/problem "Find the coordinates of the vertex of the parabola $y={x}^{2}+4x-11.$"] ["question-0b6f37ac-511e-531f-9fd9-0e1aa3bfef93" :question/worked-solution "The vertex of the parabola lies on the axis of symmetry, so we will start by computing the axis of symmetry. \n\nThe equation of the axis of symmetry of the parabola $y=a{x}^{2}+bx+c$ is given by\n\n$$\nx=-\\frac{b}{2a}.\n$$\n\nSubstituting $a=1$ and $b=4$ into the formula for the axis of symmetry, we get\n\n$$\n\\begin{aligned}x & =-\\frac{4}{2(1)} \\\\  & =-\\frac{4}{2} \\\\  & =-2.\\end{aligned}\n$$\n\nTherefore, the equation of the axis of symmetry is $x=-2.$ This also represents the $x$-coordinate of the vertex. To find the $y$-coordinate of the vertex, we substitute $x=-2$ into the original equation:\n\n$$\n\\begin{aligned}y & ={x}^{2}+4x-11 \\\\  & =(-2)^{2}+4(-2)-11 \\\\  & =4-8-11 \\\\  & =-15\\end{aligned}\n$$\n\nTherefore, the vertex is at $(-2,-15).$"] ["question-0b6f37ac-511e-531f-9fd9-0e1aa3bfef93" :question/difficulty :question.difficulty/easy] ["answer-field-dca6600a-f1ed-5820-b07a-a9d181dedbc7" :answer-field/id #uuid "dca6600a-f1ed-5820-b07a-a9d181dedbc7"] ["answer-c93d9d5d-d91f-5a40-a5af-007efceb3232" :answer/id #uuid "c93d9d5d-d91f-5a40-a5af-007efceb3232"] ["answer-c93d9d5d-d91f-5a40-a5af-007efceb3232" :answer/type 