51bc-8802-582169729c0f" "answer-b38332e4-d6a6-57fc-ab73-bece0af7380c" "answer-b6f6c486-0a93-53b2-b1e7-f096d03aa4fe" "answer-6c7d6dad-f969-5f91-a45e-3d713c825d49" "answer-0c3f92cf-9ad6-5ac6-bcf8-367dd8ea8269"] :db/ensure [:answer-field/validate]} {:db/id "answer-037caabe-2f41-51bc-8802-582169729c0f" :answer/id #uuid "037caabe-2f41-51bc-8802-582169729c0f" :answer/type :answer.type/math :answer/value "x=-2" :db/ensure [:answer/validate]} {:db/id "answer-b38332e4-d6a6-57fc-ab73-bece0af7380c" :answer/id #uuid "b38332e4-d6a6-57fc-ab73-bece0af7380c" :answer/type :answer.type/math :answer/value "x=-3" :db/ensure [:answer/validate]} {:db/id "answer-b6f6c486-0a93-53b2-b1e7-f096d03aa4fe" :answer/id #uuid "b6f6c486-0a93-53b2-b1e7-f096d03aa4fe" :answer/type :answer.type/math :answer/value "x=-\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-6c7d6dad-f969-5f91-a45e-3d713c825d49" :answer/id #uuid "6c7d6dad-f969-5f91-a45e-3d713c825d49" :answer/type :answer.type/math :answer/value "x=6" :db/ensure [:answer/validate]} {:db/id "answer-0c3f92cf-9ad6-5ac6-bcf8-367dd8ea8269" :answer/id #uuid "0c3f92cf-9ad6-5ac6-bcf8-367dd8ea8269" :answer/type :answer.type/math :answer/value "x=\\frac{1}{6}" :db/ensure [:answer/validate]} {:db/id "question-0b6f37ac-511e-531f-9fd9-0e1aa3bfef93" :question/id #uuid "0b6f37ac-511e-531f-9fd9-0e1aa3bfef93" :question/math-academy-id "q-106543" :question/problem "Find the coordinates of the vertex of the parabola $y={x}^{2}+4x-11.$" :question/worked-solution "The vertex of the parabola lies on the axis of symmetry, so we will start by computing the axis of symmetry. \n\nThe equation of the axis of symmetry of the parabola $y=a{x}^{2}+bx+c$ is given by\n\n$$\nx=-\\frac{b}{2a}.\n$$\n\nSubstituting $a=1$ and $b=4$ into the formula for the axis of symmetry, we get\n\n$$\n\\begin{aligned}x & =-\\frac{4}{2(1)} \\\\  & =-\\frac{4}{2} \\\\  & =-2.\\end{aligned}\n$$\n\nTherefore, the equation of the axis of symmetry is $x=-2.$ This also represents the $x$-coordinate of the vertex. To find the $y$-coordinate of the vertex, we substitute $x=-2$ into the original equation:\n\n$$\n\\begin{aligned}y & ={x}^{2}+4x-11 \\\\  & =(-2)^{2}+4(-2)-11 \\\\  & =4-8-11 \\\\  & =-15\\end{aligned}\n$$\n\nTherefore, the vertex is at $(-2,-15).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-dca6600a-f1ed-5820-b07a-a9d181dedbc7"] :db/ensure [:question/validate]} {:db/id "answer-field-dca6600a-f1ed-5820-b07a-a9d181dedbc7" :answer-field/id #uuid "dca6600a-f1ed-5820-b07a-a9d181dedbc7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c93d9d5d-d91f-5a40-a5af-007efceb3232" :answer-field/choices ["answer-c93d9d5d-d91f-5a40-a5af-007efceb3232" "answer-682195de-3e85-5753-851c-879da28ac8bb" "answer-1e4b65c0-3183-57d2-a3ff-e8e9a1c3a05f" "answer-5fab28f4-6451-5564-a2e7-ae3bed8d311e" "answer-01b71aec-b8b3-5037-8deb-926f506792fc"] :db/ensure [:answer-field/validate]} {:db/id "answer-c93d9d5d-d91f-5a40-a5af-007efceb3232" :answer/id #uuid "c93d9d5d-d91f-5a40-a5af-007efceb3232" :answer/type :answer.type/math :answer/value "(-2,-15)" :db/ensure [:answer/validate]} {:db/id "answer-682195de-3e85-5753-851c-879da28ac8bb" :answer/id #uuid "682195de-3e85-5753-851c-879da28ac8bb" :answer/type :answer.type/math :answer/value "(-2,1)" :db/ensure [:answer/validate]} {:db/id "answer-1e4b65c0-3183-57d2-a3ff-e8e9a1c3a05f" :answer/id #uuid "1e4b65c0-3183-57d2-a3ff-e8e9a1c3a05f" :answer/type :answer.type/math :answer/value "(-4,-11)" :db/ensure [:answer/validate]} {:db/id "answer-5fab28f4-6451-5564-a2e7-ae3bed8d311e" :answer/id #uuid "5fab28f4-6451-5564-a2e7-ae3bed8d311e" :answer/type :answer.type/math :answer/value "(2,1)" :db/ensure [:answer/validate]} {:db/id "answer-01b71aec-b8b3-5037-8deb-926f506792fc" :answer/id #uuid "01b71aec-b8b3-5037-8deb-926f506792fc" :answer/type :answer.type/math :answer/value "(2,15)" :db/ensure [:answer/validate]} {:db/id "question-621c054c-a8ee-5e21-b7c5-55a43d66b230" :question/id #uuid "621c054c-a8ee-5e21-b7c5-55a43d66b230" :question/math-academy-id "q-222082" :question/problem "What are the coordinates of the vertex of the parabola $y={x}^{2}-6x+7?$\n\nThe coordinates of the vertex are\n$($\n{{field-1}}\n,\n{{field-2}}\n$).$" :question/worked-solution "The parabola's vertex lies on the symmetry axis, so we will start by computing the axis of symmetry. \n\nThe equation of the axis of symmetry of the parabola $y=a{x}^{2}+bx+c$ is given by\n\n$$\nx=-\\frac{b}{2a}.\n$$\n\nSubstituting $a=1$ and $b=-6$ into the formula for the axis of symmetry, we get\n\n$$\n\\begin{aligned}x & =-\\frac{(-6)}{2(1)} \\\\  & =-\\frac{(-6)}{2} \\\\  & =3.\\end{aligned}\n$$\n\nTherefore, the equation of the axis of symmetry is $x=3.$ This also represents the $x$-coordinate of the vertex. To find the $y$-coordinate of the vertex, we substitute $x=3$ into the original equation:\n\n$$\n\\begin{aligned}y & ={x}^{2}-6x+7 \\\\  & ={3}^{2}-6(3)+7 \\\\  & =9-18+7 \\\\  & =-2\\end{aligned}\n$$\n\nTherefore, the vertex is at $(3,-2).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-bca17f37-d098-5fee-a7b9-8d476bb24f52" "answer-field-cab4b1dd-416a-506b-9085-7936c937e72b"] :db/ensure [:question/validate]} {:db/id "answer-field-bca17f37-d098-5fee-a7b9-8d476bb24f52" :answer-field/id #uuid "bca17f37-d098-5fee-a7b9-8d476bb24f52" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-980f0782-9bf6-5d75-917f-90617c2af852" :answer-field/choices ["answer-980f0782-9bf6-5d75-917f-90617c2af852"] :db/ensure [:answer-field/validate]} {:db/id "answer-980f0782-9bf6-5d75-917f-90617c2af852" :answer/id #uuid "980f0782-9bf6-5d75-917f-90617c2af852" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-field-cab4b1dd-416a-506b-9085-7936c937e72b" :answer-field/id #uuid "cab4b1dd-416a-506b-9085-7936c937e72b" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-d25cb9d3-ae1c-5d4b-aad5-470049340353" :answer-field/choices ["answer-d25cb9d3-ae1c-5d4b-aad5-470049340353"] :db/ensure [:answer-field/validate]} {:db/id "answer-d25cb9d3-ae1c-5d4b-aad5-470049340353" :answer/id #uuid "d25cb9d3-ae1c-5d4b-aad5-470049340353" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "question-9df948ff-fcd8-5687-95bb-a0bdf3f05629" :question/id #uuid "9df948ff-fcd8-5687-95bb-a0bdf3f05629" :question/math-academy-id "q-13386" :question/problem "Find the coordinates of the vertex of the parabola $y=3{x}^{2}+36x+6.$" :question/worked-solution "The vertex of the parabola lies on the axis of symmetry, so we will start by computing the axis of symmetry. \n\nThe equation of the axis of symmetry of the parabola $y=a{x}^{2}+bx+c$ is given by\n\n$$\nx=-\\frac{b}{2a}.\n$$\n\nSubstituting $a=3$ and $b=36$ into the formula for the axis of symmetry, we get\n\n$$\n\\begin{aligned}x & =-\\frac{36}{2(3)} \\\\  & =-\\frac{36}{6} \\\\  & =-6.\\end{aligned}\n$$\n\nTherefore, the equation of the axis of symmetry is $x=-6.$ This also represents the $x$-coordinate of the vertex. To find the $y$-coordinate of the vertex, we substitute $x=-6$ into the original equation:\n\n$$\n\\begin{aligned}y & =3{x}^{2}+36x+6 \\\\  & =3(-6)^{2}+36(-6)+6 \\\\  & =108-216+6 \\\\  & =-102\\end{aligned}\n$$\n\nTherefore, the vertex is at $(-6,-102).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-2aca8f67-fa9a-544b-9a5d-d25691fbc92b"] :db/ensure [:question/validate]} {:db/id "answer-field-2aca8f67-fa9a-544b-9a5d-d25691fbc92b" :answer-field/id #uuid "2aca8f67-fa9a-544b-9a5d-d25691fbc92b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f256a5f1-0204-5b93-af96-9f80b697b4bd" :answer-field/choices ["answer-62899510-a87d-5d7f-9a3f-4c33314df94a" "answer-f256a5f1-0204-5b93-af96-9f80b697b4bd" "answer-30b8d0fd-6c5a-5866-938e-4356bd69904e" "answer-85daedbc-1998-5aa5-95d2-c689b6aecb21" "answer-5f89c0ba-747e-5424-b392-8ae56dd31ab5"] :db/ensure [:answer-field/validate]} {:db/id "answer-62899510-a87d-5d7f-9a3f-4c33314df94a" :answer/id #uuid "62899510-a87d-5d7f-9a3f-4c33314df94a" :answer/type :answer.type/math :answer/value "(-3,-75)" :db/ensure [:answer/validate]} {:db/id "answer-f256a5f1-0204-5b93-af96-9f80b697b4bd" :answer/id #uuid "f256a5f1-0204-5b93-af96-9f80b697b4bd" :answer/type :answer.type/math :answer/value "(-6,-102)" :db/ensure [:answer/validate]} {:db/id "answer-30b8d0fd-6c5a-5866-938e-4356bd69904e" :answer/id #uuid "30b8d0fd-6c5a-5866-938e-4356bd69904e" :answer/type :answer.type/math :answer/value "(-6,54)" :db/ensure [:answer/validate]} {:db/id "answer-85daedbc-1998-5aa5-95d2-c689b6aecb21" :answer/id #uuid "85daedbc-1998-5aa5-95d2-c689b6aecb21" :answer/type :answer.type/math :answer/value "(3,50)" :db/ensure [:answer/validate]} {:db/id "answer-5f89c0ba-747e-5424-b392-8ae56dd31ab5" :answer/id #uuid "5f89c0ba-747e-5424-b392-8ae56dd31ab5" :answer/type :answer.type/math :answer/value "(6,48)" :db/ensure [:answer/validate]} {:db/id "question-b4514a54-7bd5-5a89-8cc0-e28359cd784d" :question/id #uuid "b4514a54-7bd5-5a89-8cc0-e28359cd784d" :question/math-academy-id "q-10324" :question/problem "Find the coordinates of the vertex of the parabola $y=-5{x}^{2}+30x+2.$" :question/worked-solution "The vertex of the parabola lies on the axis of symmetry, so we will start by computing the axis of symmetry. \n\nThe equation of the axis of symmetry of the parabola $y=a{x}^{2}+bx+c$ is given by\n\n$$\nx=-\\frac{b}{2a}.\n$$\n\nSubstituting $a=-5$ and $b=30$ into the formula for the axis of symmetry, we get\n\n$$\n\\begin{aligned}x & =-\\frac{30}{2(-5)} \\\\  & =-\\frac{30}{(-10)} \\\\  & =3.\\end{aligned}\n$$\n\nTherefore, the equation of the axis of symmetry is $x=3.$ This also represents the $x$-coordinate of the vertex. To find the $y$-coordinate of the vertex, we substitute $x=3$ into the original equation:\n\n$$\n\\begin{aligned}y & =-5{x}^{2}+30x+2 \\\\  & =-5(3)^{2}+30(3)+2 \\\\  & =-45+90+2 \\\\  & =47\\end{aligned}\n$$\n\nTherefore, the vertex is at $(3,47).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-1b5e1f01-10ee-5e1a-99dc-d1ce7db0a46a"] :db/ensure [:question/validate]} {:db/id "answer-field-1b5e1f01-10ee-5e1a-99dc-d1ce7db0a46a" :answer-field/id #uuid "1b5e1f01-10ee-5e1a-99dc-d1ce7db0a46a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6e9465f1-3630-5899-98a2-9ffd8b1c2a56" :answer-field/choices ["answer-cf7569b9-f881-53b5-8879-4445f0b56f86" "answer-0b7f23c9-0bd5-5ec8-8fd7-e875fc1806da" "answer-bfe77f59-59d1-5211-8384-6829442bb7a3" "answer-6e9465f1-3630-5899-98a2-9ffd8b1c2a56" "answer-317b6ffc-ad6b-5f25-a9ae-7a7a14382ea6"] :db/ensure [:answer-field/validate]} {:db/id "answer-cf7569b9-f881-53b5-8879-4445f0b56f86" :answer/id #uuid "cf7569b9-f881-53b5-8879-4445f0b56f86" :answer/type :answer.type/math :answer/value "(-3,-133)" :db/ensure [:answer/validate]} {:db/id "answer-0b7f23c9-0bd5-5ec8-8fd7-e875fc1806da" :answer/id #uuid "0b7f23c9-0bd5-5ec8-8fd7-e875fc1806da" :answer/type :answer.type/math :answer/value "(-3,47)" :db/ensure [:answer/validate]} {:db/id "answer-bfe77f59-59d1-5211-8384-6829442bb7a3" :answer/id #uuid "bfe77f59-59d1-5211-8384-6829442bb7a3" :answer/type :answer.type/math :answer/value "(1,27)" :db/ensure [:answer/validate]} {:db/id "answer-6e9465f1-3630-5899-98a2-9ffd8b1c2a56" :answer/id #uuid "6e9465f1-3630-5899-98a2-9ffd8b1c2a56" :answer/type :answer.type/math :answer/value "(3,47)" :db/ensure [:answer/validate]} {:db/id "answer-317b6ffc-ad6b-5f25-a9ae-7a7a14382ea6" :answer/id #uuid "317b6ffc-ad6b-5f25-a9ae-7a7a14382ea6" :answer/type :answer.type/math :answer/value "(3,54)" :db/ensure [:answer/validate]} {:db/id "question-8a434264-115c-5e23-9940-79d2727ed021" :question/id #uuid "8a434264-115c-5e23-9940-79d2727ed021" :question/math-academy-id "q-52326" :question/problem "The axis of symmetry of the parabola $y=4{x}^{2}+kx-2$ is $x=-1.$ Find the value of $k.$" :question/worked-solution "First, we will calculate the axis of symmetry in terms of $k.$ Then, we will set our result equal to $-1.$ \n\nThe equation of the axis of symmetry of the parabola $y=a{x}^{2}+bx+c$ is given by\n\n$$\nx=-\\frac{b}{2a}.\n$$\n\nSubstituting $a=4$ and $b=k$ into the formula for the axis of symmetry, we get\n\n$$\n\\begin{aligned}x & =-\\frac{k}{2(4)} \\\\  & =-\\frac{k}{8}.\\end{aligned}\n$$\n\nWe already know that the axis of symmetry is $x=-1,$ so we must have\n\n$$\n\\begin{aligned}-\\frac{k}{8} & =-1 \\\\ -k & =-8 \\\\ k & =8.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-0f668b4d-53cc-57b3-995b-4df60daafa74"] :db/ensure [:question/validate]} {:db/id "answer-field-0f668b4d-53cc-57b3-995b-4df60daafa74" :answer-field/id #uuid "0f668b4d-53cc-57b3-995b-4df60daafa74" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8af2d063-d5b4-5386-9515-7976cb518a55" :answer-field/choices ["answer-a1424b21-9207-5fc2-931a-208860cb0e04" "answer-3bb42019-06df-5498-9d29-49a2aeb6de50" "answer-2c78fe61-cf74-5dcb-97a3-cd26f9cf105f" "answer-0d47cbe0-a293-5059-81ae-ce84f00371dd" "answer-8af2d063-d5b4-5386-9515-7976cb518a55"] :db/ensure [:answer-field/validate]} {:db/id "answer-a1424b21-9207-5fc2-931a-208860cb0e04" :answer/id #uuid "a1424b21-9207-5fc2-931a-208860cb0e04" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-3bb42019-06df-5498-9d29-49a2aeb6de50" :answer/id #uuid "3bb42019-06df-5498-9d29-49a2aeb6de50" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-2c78fe61-cf74-5dcb-97a3-cd26f9cf105f" :answer/id #uuid "2c78fe61-cf74-5dcb-97a3-cd26f9cf105f" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-0d47cbe0-a293-5059-81ae-ce84f00371dd" :answer/id #uuid "0d47cbe0-a293-5059-81ae-ce84f00371dd" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-8af2d063-d5b4-5386-9515-7976cb518a55" :answer/id #uuid "8af2d063-d5b4-5386-9515-7976cb518a55" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "question-2ea1e232-4156-584c-babd-20b14e2a349e" :question/id #uuid "2ea1e232-4156-584c-babd-20b14e2a349e" :question/math-academy-id "q-52329" :question/problem "![](images/5f/5f76e31fbf6e2d7b1398eaafc97e634e955b3314697d650d5f645555c1df289e.png)\n\nFind the value of $k$ for the parabola $y=3{x}^{2}+kx+2$ shown above." :question/worked-solution "First, we will calculate the axis of symmetry in terms of $k.$ Then, since the graph tells us that the axis of symmetry is $x=2,$ we will set our result equal to $2.$ \n\nThe equation of the axis of symmetry of the parabola $y=a{x}^{2}+bx+c$ is given by\n\n$$\nx=-\\frac{b}{2a}.\n$$\n\nSubstituting $a=3$ and $b=k$ into the formula for the axis of symmetry, we get\n\n$$\n\\begin{aligned}x & =-\\frac{k}{2(3)} \\\\  & =-\\frac{k}{6}.\\end{aligned}\n$$\n\nWe already know that the axis of symmetry is $x=2,$ so we must have\n\n$$\n\\begin{aligned}-\\frac{k}{6} & =2 \\\\ k & =-12.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a4d9a73c-49d9-5fa1-8da6-76c9d8ecc11d"] :db/ensure [:question/validate]} {:db/id "answer-field-a4d9a73c-49d9-5fa1-8da6-76c9d8ecc11d" :answer-field/id #uuid "a4d9a73c-49d9-5fa1-8da6-76c9d8ecc11d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-341d0c0d-a5c9-573a-a052-820eab9de3db" :answer-field/choices ["answer-341d0c0d-a5c9-573a-a052-820eab9de3db" "answer-f1eca14e-bba3-56a3-8702-d07045257425" "answer-351bc5d9-a80f-513f-9a55-d9d78db6d7ed" "answer-1a137401-bd57-566e-9d85-d212c9ba2e04" "answer-16b90e9