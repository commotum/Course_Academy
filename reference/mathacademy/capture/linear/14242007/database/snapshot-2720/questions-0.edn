#{[{:db/id #edb/ref 17592186559886 :knowledge-point/_questions [{:db/id #edb/ref 17592186176014 :knowledge-point/id #uuid "31bf2725-d2ba-53a8-bbdf-0fd7cd643aca" :knowledge-point/title "Modeling with Inverse Square Laws"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7837106-1589-57d2-b906-4c9c68e0e446" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "I=\\frac{525}{{d}^{2}}" :db/id #edb/ref 17592186559438} {:answer/id #uuid "d1c463c3-c064-5991-b54e-dd3508c5031c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "I=\\frac{526}{{d}^{2}}" :db/id #edb/ref 17592186559531} {:answer/id #uuid "f1b921b1-ed1b-5178-8c66-9eaae69ad95c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "I=\\frac{572}{{d}^{2}}" :db/id #edb/ref 17592186559605} {:answer/id #uuid "f3366ca9-4710-56bf-af0a-6fb29a726281" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "I=\\frac{539}{{d}^{2}}" :db/id #edb/ref 17592186559608} {:answer/id #uuid "f5e5ce6b-2d1b-5bed-83b2-dcc16add4837" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "I=\\frac{576}{{d}^{2}}" :db/id #edb/ref 17592186559621}] :answer-field/correct {:answer/id #uuid "f5e5ce6b-2d1b-5bed-83b2-dcc16add4837" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "I=\\frac{576}{{d}^{2}}" :db/id #edb/ref 17592186559621} :answer-field/id #uuid "9d87431e-d6a3-5dbb-a0b5-cd9dae356e8a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186559732}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f5ab26d2-91d7-599f-b642-d61eec8ddc94" :question/math-academy-id "q-116315" :question/problem "The intensity $I$ of light, measured in $\\text{lux},$ is inversely proportional to the **square** of the distance $d,$ measured in meters, between the light source and the object being illuminated. A device that measures the light intensity is $12$ meters away from the light source and registers $4$ $\\text{lux}.$  What equation gives the relationship between $I$ and $d?$" :question/worked-solution "Since the intensity $I$ is inversely proportional to the square of the distance $d,$ we must have\n\n$$\nI=\\frac{k}{{d}^{2}},\n$$\n\nwhere $k$ is the constant of variation.\n\nWe are told that $I=4\\,\\text{lux}$ when $d=12\\,\\text{m}.$ We can use this information to solve for $k,$ as follows:\n\n$$\n\\begin{aligned}4 & =\\frac{k}{{12}^{2}} \\\\ 4 & =\\frac{k}{144} \\\\ 4\\cdot 144 & =k \\\\ 576 & =k\\end{aligned}\n$$\n\nTherefore, our inverse variation equation is\n\n$$\nI=\\frac{576}{{d}^{2}}.\n$$"}] [{:db/id #edb/ref 17592186559774 :knowledge-point/_questions [{:db/id #edb/ref 17592186176014 :knowledge-point/id #uuid "31bf2725-d2ba-53a8-bbdf-0fd7cd643aca" :knowledge-point/title "Modeling with Inverse Square Laws"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f8017c5-3642-5551-85b5-caf0dc92835a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "I=\\frac{5.4}{{r}^{2}}" :db/id #edb/ref 17592186559138} {:answer/id #uuid "4847e4fc-ab7b-5fed-acce-013c3bfb352e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "I=\\frac{6.7}{{r}^{2}}" :db/id #edb/ref 17592186559204} {:answer/id #uuid "84571adf-8d7e-51a8-aab6-154b6d0b6347" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "I=\\frac{6.3}{{r}^{2}}" :db/id #edb/ref 17592186559348} {:answer/id #uuid "c9aa16ec-6b8c-5aca-9762-25ee61f4aec4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "I=\\frac{5.8}{{r}^{2}}" :db/id #edb/ref 17592186559508} {:answer/id #uuid "efc38971-1f12-5920-bd35-8861d39777a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "I=\\frac{4.8}{{r}^{2}}" :db/id #edb/ref 17592186559597}] :answer-field/correct {:answer/id #uuid "2f8017c5-3642-5551-85b5-caf0dc92835a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "I=\\frac{5.4}{{r}^{2}}" :db/id #edb/ref 17592186559138} :answer-field/id #uuid "bbbea0b5-e068-501a-85b9-14ebd116cadd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186559742}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "04117d3f-552c-54f2-b117-fd9ff4546b57" :question/math-academy-id "q-116321" :question/problem "The irradiance $I,$ in $W/{m}^{2},$ of a lamp placed in the center of a spherical chamber varies inversely with the **square** of the radius $r$ of the spherical chamber, measured in meters. It is known that the irradiance is $0.6\\,W/{m}^{2}$ when the radius of the chamber is $3\\,m.$ What equation gives the relationship between $I$ and $r?$" :question/worked-solution "Since the irradiance $I$ is inversely proportional to the square of the radius of the spherical chamber, $r$, we must have\n\n$$\nI=\\frac{k}{{r}^{2}},\n$$\n\nwhere $k$ is the constant of variation.\n\nWe are told that $I=0.6\\,W/{m}^{2}$ when $r=3\\,\\text{m}.$ We can use this information to solve for $k,$ as follows:\n\n$$\n\\begin{aligned}0.6 & =\\frac{k}{{3}^{2}} \\\\ 0.6 & =\\frac{k}{9} \\\\ 0.6\\cdot 9 & =k \\\\ 5.4 & =k\\end{aligned}\n$$\n\nTherefore, our inverse variation equation is\n\n$$\nI=\\frac{5.4}{{r}^{2}}.\n$$"}] [{:db/id #edb/ref 17592186559783 :knowledge-point/_questions [{:db/id #edb/ref 17592186176014 :knowledge-point/id #uuid "31bf2725-d2ba-53a8-bbdf-0fd7cd643aca" :knowledge-point/title "Modeling with Inverse Square Laws"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55d8ec15-bec9-5145-b56e-63807063355c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "I=\\frac{2\\,850}{{d}^{2}}" :db/id #edb/ref 17592186559236} {:answer/id #uuid "57c4c63f-2fb5-5791-a8d2-3e2f8df27b27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "I=\\frac{2\\,050}{{d}^{2}}" :db/id #edb/ref 17592186559243} {:answer/id #uuid "9060ad28-322c-5fd6-a579-21223cdc86b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "I=\\frac{2\\,350}{{d}^{2}}" :db/id #edb/ref 17592186559375} {:answer/id #uuid "eeb4a91f-d653-5fd6-98e4-36fe04cd33cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "I=\\frac{1\\,630}{{d}^{2}}" :db/id #edb/ref 17592186559593} {:answer/id #uuid "fa966bfa-a7f5-5c04-be74-6a02a6f44a11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "I=\\frac{1\\,850}{{d}^{2}}" :db/id #edb/ref 17592186559632}] :answer-field/correct {:answer/id #uuid "57c4c63f-2fb5-5791-a8d2-3e2f8df27b27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "I=\\frac{2\\,050}{{d}^{2}}" :db/id #edb/ref 17592186559243} :answer-field/id #uuid "247bcca9-98a8-5db3-bb40-72912974c475" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186559661}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1ed2e1e9-66f4-55a8-9c62-03d8b636c4ac" :question/math-academy-id "q-116337" :question/problem "The intensity of radiation $I,$ in milliroentgen/hour ($\\text{mR}/\\text{h}$), spreading out from an X-ray device is inversely proportional to the **square** of the distance $d,$ measured in meters, between the device and the object being radiated. If a device that measures the radiation intensity registers $82\\,\\text{mR}/\\text{h}$ at a distance of $5\\,\\text{m}.$ What equation gives the relationship between $I$ and $d?$" :question/worked-solution "Since the intensity $I$ is inversely proportional to the square of the distance $d,$ we must have\n\n$$\nI=\\frac{k}{{d}^{2}},\n$$\n\nwhere $k$ is the constant of variation.\n\nWe are told that $82\\,\\text{mR}/\\text{h}$ when $d=5\\,\\text{m}.$ We can use this information to solve for $k,$ as follows:\n\n$$\n\\begin{aligned}82 & =\\frac{k}{{5}^{2}} \\\\ 82 & =\\frac{k}{25} \\\\ 82\\cdot 25 & =k \\\\ 2\\,050 & =k\\end{aligned}\n$$\n\nTherefore, our inverse variation equation is\n\n$$\nI=\\frac{2\\,050}{{d}^{2}}.\n$$"}] [{:db/id #edb/ref 17592186559835 :knowledge-point/_questions [{:db/id #edb/ref 17592186176078 :knowledge-point/id #uuid "91394e22-dc2a-5304-b9aa-80302de38fb1" :knowledge-point/title "Modeling With Inverse Variation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f96646a-20b2-54f6-ac4d-afa9fbd983c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30\\,min" :db/id #edb/ref 17592186559049} {:answer/id #uuid "331be38b-9e6c-5e90-9477-39943ce1f0a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13\\,min" :db/id #edb/ref 17592186559145} {:answer/id #uuid "65a769b0-ef43-5a92-8d94-9f93a82f87e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20\\,min" :db/id #edb/ref 17592186559267} {:answer/id #uuid "dfdce043-b80d-5e59-9eaf-4eed1add27d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25\\,min" :db/id #edb/ref 17592186559568} {:answer/id #uuid "ef253e76-101f-5feb-aebb-cc60e77dcb17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15\\,min" :db/id #edb/ref 17592186559595}] :answer-field/correct {:answer/id #uuid "ef253e76-101f-5feb-aebb-cc60e77dcb17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15\\,min" :db/id #edb/ref 17592186559595} :answer-field/id #uuid "fb3d5956-200b-5c5c-9bbb-4da333869f74" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186559769}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "99714685-f61c-5dfd-b220-40d2fda79ac5" :question/math-academy-id "q-120409" :question/problem "The time $t$, in minutes ($min$), it takes for an ice cream to melt is inversely proportional to the environment's temperature $T,$ in degrees Celsius (${}^{∘}C$). If it takes $10\\,min$ for an ice cream to melt at  ${30}^{∘}C,$ how much time it takes for the ice cream to melt at ${20}^{∘}C?$" :question/worked-solution "The time of melting $t$ is inversely proportional to the temperature $T,$ so we have\n\n$$\nt=\\frac{k}{T},\n$$\n\nwhere $k$ is the constant of variation.\n\nWe are told that it takes $10\\,min$ for an ice cream to melt at ${30}^{∘}C.$ We can use this information to solve for $k$ as follows:\n\n$$\n\\begin{aligned}10 & =\\frac{k}{30} \\\\ 10\\cdot 30 & =k \\\\ 300 & =k\\end{aligned}\n$$\n\nWe now have the equation\n\n$$\nt=\\frac{300}{T}.\n$$\n\nWe can use this equation to find the time it takes for the ice cream to melt at ${20}^{∘}C,$ as follows:\n\n$$\nt=\\frac{300}{20}=15\n$$\n\nTherefore, the time it takes for the ice cream to melt when $T={20}^{∘}C$ is $t=15\\,min.$"}] [{:db/id #edb/ref 17592186559859 :knowledge-point/_questions [{:db/id #edb/ref 17592186176078 :knowledge-point/id #uuid "91394e22-dc2a-5304-b9aa-80302de38fb1" :knowledge-point/title "Modeling With Inverse Variation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "361e105c-8058-5ba1-9a25-7614fd9ff325" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,\\text{MPa}" :db/id #edb/ref 17592186559151} {:answer/id #uuid "56b0dd7b-330f-52d2-a1ec-732c410bb6b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.8\\,\\text{MPa}" :db/id #edb/ref 17592186559238} {:answer/id #uuid "ad0ab94e-ac52-57ec-8d6d-3a909eaf246b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,\\text{MPa}" :db/id #edb/ref 17592186559450} {:answer/id #uuid "bf7be9cd-c53f-5c97-8fcf-87c050464c14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.5\\,\\text{MPa}" :db/id #edb/ref 17592186559487} {:answer/id #uuid "d0d2f2e3-319f-50d1-9b74-972ccee98498" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.8\\,\\text{MPa}" :db/id #edb/ref 17592186559523}] :answer-field/correct {:answer/id #uuid "361e105c-8058-5ba1-9a25-7614fd9ff325" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,\\text{MPa}" :db/id #edb/ref 17592186559151} :answer-field/id #uuid "877db9e7-19c4-5bae-a15a-39d1105acc5d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186559721}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cb89cc75-091f-5263-a465-e0004e0e6c85" :question/math-academy-id "q-52004" :question/problem "For a fixed temperature, the pressure $P$ of a gas varies inversely with the volume $V$ that it occupies. When $V=3\\,{\\text{m}}^{3},$ the pressure is $P=2$ megapascal ($\\text{MPa}$). What will be the pressure if the gas is compressed to a container with volume $V=2\\,{\\text{m}}^{3}?$" :question/worked-solution "The pressure $P$ is inversely proportional to the volume $V,$ so we have\n\n$$\nP=\\frac{k}{V},\n$$\n\nwhere $k$ is the constant of variation.\n\nWe are told that when the volume is $V=3\\,{\\text{m}}^{3},$ the pressure is $P=2$ megapascal ($\\text{MPa}$). We can use this information to solve for $k$ as follows:\n\n$$\n\\begin{aligned}2 & =\\frac{k}{3} \\\\ 2\\cdot 3 & =k \\\\ 6 & =k\\end{aligned}\n$$\n\nWe now have the equation\n\n$$\nP=\\frac{6}{V}.\n$$\n\nWe can use this equation to find the pressure when the volume is $V=2\\,{\\text{m}}^{3},$ as follows:\n\n$$\nP=\\frac{6}{2}=3\n$$\n\nTherefore, the pressure of the gas when $V=2\\,{\\text{m}}^{3}$ is $3\\,\\text{MPa}.$"}]}
