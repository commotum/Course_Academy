ng=\"0em\" rowspacing=\"0.6em 0.6em 0.6em 0.6em 0.3em\"><mtr><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mtext>d</mtext><mrow><mtext>d</mtext><mi>x</mi></mrow></mfrac></mstyle><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>5</mn><msup><mi>x</mi><mrow data-mjx-texclass=\"ORD\"><mn>12</mn><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mn>5</mn></mrow></msup></mrow><mn>12</mn></mfrac></mstyle><mo>+</mo><mi>C</mi><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mtext>d</mtext><mrow><mtext>d</mtext><mi>x</mi></mrow></mfrac></mstyle><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>5</mn><msup><mi>x</mi><mrow data-mjx-texclass=\"ORD\"><mn>12</mn><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mn>5</mn></mrow></msup></mrow><mn>12</mn></mfrac></mstyle><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mtext>d</mtext><mrow><mtext>d</mtext><mi>x</mi></mrow></mfrac></mstyle><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mi>C</mi><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>5</mn><mn>12</mn></mfrac></mstyle><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mtext>d</mtext><mrow><mtext>d</mtext><mi>x</mi></mrow></mfrac></mstyle><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><msup><mi>x</mi><mrow data-mjx-texclass=\"ORD\"><mn>12</mn><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mn>5</mn></mrow></msup><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mo>+</mo><mn>0</mn></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>5</mn><mn>12</mn></mfrac></mstyle><mo>⋅</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>12</mn><mn>5</mn></mfrac></mstyle><msup><mi>x</mi><mrow data-mjx-texclass=\"ORD\"><mn>12</mn><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mn>5</mn><mo>−</mo><mn>1</mn></mrow></msup></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><msup><mi>x</mi><mrow data-mjx-texclass=\"ORD\"><mn>7</mn><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mn>5</mn></mrow></msup><mstyle scriptlevel=\"0\"><mspace width=\"1em\"></mspace></mstyle><mstyle mathcolor=\"green\"><mrow data-mjx-texclass=\"ORD\"><mi>✓</mi></mrow></mstyle></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
