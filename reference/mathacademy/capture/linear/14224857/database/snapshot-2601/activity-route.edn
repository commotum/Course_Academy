#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186541197} :activity/id #uuid "914f9819-f327-5e6a-85cc-1bd162c1bdb7" :activity/scope {:db/id #edb/ref 17592186049481 :topic/id #uuid "f8a6d16e-1a41-5d40-8c3d-467ebdcc3782" :topic/math-academy-id 308} :activity/steps [{:db/id #edb/ref 17592186541169 :step/content {:db/id #edb/ref 17592186541115 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29b5785c-9c86-58fa-8702-7b20eaf94717" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{9/5}}{5}+C" :db/id #edb/ref 17592186540600} {:answer/id #uuid "a6d02e90-1b24-51db-a87e-21fe5d5fa85e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{7/5}}{7}+C" :db/id #edb/ref 17592186540804} {:answer/id #uuid "da8619fc-53ce-586e-8d07-73efa17d3b93" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5{x}^{7/5}}{7}+C" :db/id #edb/ref 17592186540896} {:answer/id #uuid "de3f6a49-2e44-56e2-9f7d-ad3b02678d8f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5{x}^{9/5}}{9}+C" :db/id #edb/ref 17592186540906} {:answer/id #uuid "f746d0ee-4d45-5138-a444-dd8fb7c426b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4{x}^{9/5}}{9}+C" :db/id #edb/ref 17592186540933}] :answer-field/correct {:db/id #edb/ref 17592186540906} :answer-field/id #uuid "fa476148-4520-535e-8de8-c555998b437f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186541051}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9e0b25f6-0e44-56a6-a167-f47173302a18" :question/math-academy-id "q-113672" :question/problem "Find the antiderivative of ${x}^{4/5}.$" :question/worked-solution "We can apply the power rule with $n=\\frac{4}{5}$ and get\n\n$$\n\\begin{aligned}\\int {x}^{4/5}\\,\\text{d}x & =\\frac{{x}^{4/5+1}}{(\\frac{4}{5}+1)}+C \\\\  & =\\frac{{x}^{9/5}}{(\\frac{9}{5})}+C \\\\  & =\\frac{5{x}^{9/5}}{9}+C.\\end{aligned}\n$$\n\nAgain, let's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{5{x}^{9/5}}{9}+C) & = \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{5{x}^{9/5}}{9})+\\frac{\\text{d}}{\\text{d}x}(C) & = \\\\ \\frac{5}{9}\\frac{\\text{d}}{\\text{d}x}({x}^{9/5})+0 & = \\\\ \\frac{5}{9}\\cdot \\frac{9}{5}{x}^{9/5-1} & = \\\\ {x}^{4/5}\\,✓\\end{aligned}\n$$"} :step/id #uuid "2ca8b32d-49c3-5daf-9d51-00d019841719"} {:db/id #edb/ref 17592186541197 :step/content {:db/id #edb/ref 17592186541140 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c33caad-bb2f-5503-bf90-b0887fffc7de" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{4{x}^{4}}+C" :db/id #edb/ref 17592186540549} {:answer/id #uuid "395b2c98-0606-52cd-ad1e-4a590c5bc289" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4{x}^{4}}+C" :db/id #edb/ref 17592186540620} {:answer/id #uuid "58bcf515-bc8d-5c7f-a87c-e1d6836d3944" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{4{x}^{5}}+C" :db/id #edb/ref 17592186540678} {:answer/id #uuid "720da65f-7b8d-5025-8be5-6124aff10c66" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{{x}^{4}}{4}+C" :db/id #edb/ref 17592186540724} {:answer/id #uuid "9358fcee-68fe-5474-97b4-702d3a35e3e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{{x}^{4}}+C" :db/id #edb/ref 17592186540774}] :answer-field/correct {:db/id #edb/ref 17592186540549} :answer-field/id #uuid "df1e8bd8-c60e-5022-8cc3-6497fe7a88f5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186541041}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "daa61eb1-b03b-51c0-8270-14c708ae1e5c" :question/math-academy-id "q-29643" :question/problem "$\\int \\frac{1}{{x}^{5}}\\,\\text{d}x=$" :question/worked-solution "Note that $\\frac{1}{{x}^{5}}={x}^{-5}.$ So, we can use the power rule with $n=-5$ and get\n\n$$\n\\begin{aligned}\\int \\frac{1}{{x}^{5}}\\,\\text{d}x & =\\int {x}^{-5}\\,\\text{d}x \\\\  & =\\frac{{x}^{-5+1}}{-5+1}+C \\\\  & =\\frac{{x}^{-4}}{-4}+C \\\\  & =-\\frac{1}{4{x}^{4}}+C.\\end{aligned}\n$$"} :step/id #uuid "8710f1ed-7ac6-5f59-9036-f5fd5d25704b" :step/next {:db/id #edb/ref 17592186541221}} {:db/id #edb/ref 17592186541221 :step/content {:db/id #edb/ref 17592186541073 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "63c2faca-0edb-5ef8-8326-5900825078b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3\\cdot {6}^{3/5}}{2}{x}^{11/5}+C" :db/id #edb/ref 17592186540697} {:answer/id #uuid "73e207b9-91a9-5b1a-8a15-f29313c6b433" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5{x}^{12/5}}{12}+C" :db/id #edb/ref 17592186540727} {:answer/id #uuid "da7a61db-d353-5a53-b318-1be353f60fe6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{31}^{2/5}}{32}{x}^{7/5}+C" :db/id #edb/ref 17592186540895} {:answer/id #uuid "ed9e9b62-8e00-5346-a13f-699ec44a7450" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{7}^{2/5}}{2}{x}^{7/5}+C" :db/id #edb/ref 17592186540927} {:answer/id #uuid "fbfa7707-765d-5937-8a04-fb11b50efc05" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{36}^{2/5}}{72}{x}^{12/5}+C" :db/id #edb/ref 17592186540936}] :answer-field/correct {:db/id #edb/ref 17592186540727} :answer-field/id #uuid "05367c1f-7c48-5001-bd7f-8cd94f9a1ee7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186540944}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "31f8bbd7-44e6-58a8-9f8d-def7c80fe8a8" :question/math-academy-id "q-29652" :question/problem "What is the antiderivative of $\\sqrt[5]{{x}^{7}}?$" :question/worked-solution "We start by writing the root as a rational power, $\\sqrt[5]{{x}^{7}}={x}^{7/5}.$ So, we can apply the power rule with $n=\\frac{7}{5}$ and get\n\n$$\n\\begin{aligned}\\int \\sqrt[5]{{x}^{7}}\\,\\text{d}x & =\\int {x}^{7/5}\\,\\text{d}x \\\\  & =\\frac{{x}^{7/5+1}}{(\\frac{7}{5}+1)}+C \\\\  & =\\frac{{x}^{12/5}}{(\\frac{12}{5})}+C \\\\  & =\\frac{5{x}^{12/5}}{12}+C.\\end{aligned}\n$$\n\nAgain, let's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{5{x}^{12/5}}{12}+C) & = \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{5{x}^{12/5}}{12})+\\frac{\\text{d}}{\\text{d}x}(C) & = \\\\ \\frac{5}{12}\\frac{\\text{d}}{\\text{d}x}({x}^{12/5})+0 & = \\\\ \\frac{5}{12}\\cdot \\frac{12}{5}{x}^{12/5-1} & = \\\\ {x}^{7/5}\\,✓\\end{aligned}\n$$"} :step/id #uuid "d31b98f2-92d7-5a95-b4b5-20b07dc55a06" :step/next {:db/id #edb/ref 17592186541169}}] :activity/title "The Antiderivative" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186540520}]}
