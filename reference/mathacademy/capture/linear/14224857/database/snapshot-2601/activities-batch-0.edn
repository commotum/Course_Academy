#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186065001} :activity/id #uuid "b866a7ca-c501-50dd-8117-0d7904f47708" :activity/scope {:db/id #edb/ref 17592186049481 :topic/id #uuid "f8a6d16e-1a41-5d40-8c3d-467ebdcc3782" :topic/math-academy-id 308} :activity/steps [{:db/id #edb/ref 17592186065001 :step/content {:db/id #edb/ref 17592186065405 :tutorial/content "An **antiderivative** is the *opposite* of a derivative. For example:\n\n- Using the power rule, we know that the *derivative* of $\\color{blue}x^2$ is ${\\color{red}2x}.$\n\n- Going in the *opposite* direction, we say that an **antiderivative** of $\\color{red}2x$ is ${\\color{blue}x^2}.$\n\nFor any given function, there are infinitely many antiderivatives. For example:\n\n- The derivative of $\\color{blue}x^2$ is ${\\color{red}2x},$ so an *antiderivative* of $\\color{red}2x$ is ${\\color{blue}x^2}.$\n\n- The derivative of $\\color{blue}x^2+1$ is ${\\color{red}2x},$ so another *antiderivative* of $\\color{red}2x$ is ${\\color{blue}x^2+1}.$\n\n- The derivative of $\\color{blue}x^2+2$ is ${\\color{red}2x},$ so another *antiderivative* of $\\color{red}2x$ is ${\\color{blue}x^2+2}.$\n\n- ...\n\nIn general, all the antiderivatives of $\\color{red}2x$ can be written in the form ${\\color{blue}x^2+C},$ where $C$ is a constant.\n\nTo represent the antiderivative symbolically, we use a special symbol $\\displaystyle \\int$ called the **integral** symbol. So, using **integral notation**, we can write\n\n$$\n\\int 2x \\, \\textrm d x = x^2 + C\n$$\n\nwhere $C$ represents an arbitrary constant and is called the **constant of integration**.\n\nIn words, $\\displaystyle \\int 2x \\, \\textrm d x$ is said as “the integral of $2x$ with respect to $x$” or “the antiderivative of $2x$.” Integrals like this are called **indefinite integrals**, and the function being **integrated** ($2x$ in this case) is called the **integrand**." :tutorial/id #uuid "a31b3485-463c-59da-8118-836cf7949efc" :tutorial/math-academy-id 691 :tutorial/title "Introduction"} :step/id #uuid "f0dbef4a-a56e-5a50-8bc9-1025436cef8f" :step/math-academy-id 1334 :step/next {:db/id #edb/ref 17592186065154}} {:db/id #edb/ref 17592186065002 :step/content {:db/id #edb/ref 17592186064167 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064038 :question/id #uuid "368cbbae-4eff-5eff-a8f3-d3e8359447a9" :question/math-academy-id "e-364"} :knowledge-point/id #uuid "f2a4550c-7ed7-58aa-8928-23dd1cfd0cd7" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048593}] :knowledge-point/question-generator {:db/id #edb/ref 17592186503877} :knowledge-point/questions [{:db/id #edb/ref 17592186064554} {:db/id #edb/ref 17592186064556} {:db/id #edb/ref 17592186233174} {:db/id #edb/ref 17592186233175} {:db/id #edb/ref 17592186234186} {:db/id #edb/ref 17592186234300} {:db/id #edb/ref 17592186503848} {:db/id #edb/ref 17592186503851} {:db/id #edb/ref 17592186503854} {:db/id #edb/ref 17592186503860} {:db/id #edb/ref 17592186503871} {:db/id #edb/ref 17592186514428} {:db/id #edb/ref 17592186514446}] :knowledge-point/title "Finding the Antiderivative of a Monomial"} :step/id #uuid "b3f1b3df-cb38-57b6-910a-fee8cf6a6174" :step/math-academy-id 1335 :step/next {:db/id #edb/ref 17592186065003}} {:db/id #edb/ref 17592186065003 :step/content {:db/id #edb/ref 17592186064168 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064039 :question/id #uuid "818f4fbe-e251-57bd-90ae-b6517c6f2f89" :question/math-academy-id "e-367"} :knowledge-point/id #uuid "85af4ca3-5e66-522a-9e5a-6efb1c7114ba" :knowledge-point/question-generator {:db/id #edb/ref 17592186503917} :knowledge-point/questions [{:db/id #edb/ref 17592186064557} {:db/id #edb/ref 17592186064713} {:db/id #edb/ref 17592186233176} {:db/id #edb/ref 17592186233177} {:db/id #edb/ref 17592186233178} {:db/id #edb/ref 17592186233472} {:db/id #edb/ref 17592186234298} {:db/id #edb/ref 17592186235444} {:db/id #edb/ref 17592186503879} {:db/id #edb/ref 17592186503882} {:db/id #edb/ref 17592186503887} {:db/id #edb/ref 17592186503893} {:db/id #edb/ref 17592186503894} {:db/id #edb/ref 17592186503896} {:db/id #edb/ref 17592186503897} {:db/id #edb/ref 17592186503900} {:db/id #edb/ref 17592186503902} {:db/id #edb/ref 17592186503904} {:db/id #edb/ref 17592186503906} {:db/id #edb/ref 17592186503913} {:db/id #edb/ref 17592186503914} {:db/id #edb/ref 17592186514388} {:db/id #edb/ref 17592186514390} {:db/id #edb/ref 17592186541073} {:db/id #edb/ref 17592186541115}] :knowledge-point/title "Finding the Antiderivative of a Radical Function"} :step/id #uuid "88a6a7a2-ceb7-5c77-9490-120d96325eb0" :step/math-academy-id 1341 :step/next {:db/id #edb/ref 17592186065004}} {:db/id #edb/ref 17592186065004 :step/content {:db/id #edb/ref 17592186064169 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064040 :question/id #uuid "c25e6037-3900-5314-b9a9-262fef07061c" :question/math-academy-id "e-368"} :knowledge-point/id #uuid "3174cae9-484e-5ca3-8e5c-3c9cddc86145" :knowledge-point/question-generator {:db/id #edb/ref 17592186502964} :knowledge-point/questions [{:db/id #edb/ref 17592186064722} {:db/id #edb/ref 17592186064723} {:db/id #edb/ref 17592186233179} {:db/id #edb/ref 17592186233751} {:db/id #edb/ref 17592186233752} {:db/id #edb/ref 17592186234299} {:db/id #edb/ref 17592186502863} {:db/id #edb/ref 17592186502872} {:db/id #edb/ref 17592186502876} {:db/id #edb/ref 17592186502879} {:db/id #edb/ref 17592186502887} {:db/id #edb/ref 17592186502891} {:db/id #edb/ref 17592186502900} {:db/id #edb/ref 17592186502914} {:db/id #edb/ref 17592186502920} {:db/id #edb/ref 17592186502921} {:db/id #edb/ref 17592186502927} {:db/id #edb/ref 17592186502931} {:db/id #edb/ref 17592186502938} {:db/id #edb/ref 17592186502948} {:db/id #edb/ref 17592186502954} {:db/id #edb/ref 17592186514383} {:db/id #edb/ref 17592186514391} {:db/id #edb/ref 17592186541140}] :knowledge-point/title "Finding the Antiderivative of a Reciprocal Function"} :step/id #uuid "f0993d66-6693-5a4b-b2b7-aea4337779d6" :step/math-academy-id 1343 :step/next {:db/id #edb/ref 17592186065005}} {:db/id #edb/ref 17592186065005 :step/content {:db/id #edb/ref 17592186065406 :tutorial/content "Let's recap the main points:\n\n- Integrals like $\\displaystyle \\int x^3\\,\\textrm d x$ are called **indefinite integrals**.\n\n- Whenever we calculate an indefinite integral, we must always remember to add an **arbitrary constant** $+C.$\n\n- To integrate power functions, we can use the **power rule for integration**, which states that\n\n$$\n\\int x^n\\,\\textrm d x = \\dfrac{x^{n+1}}{n+1} + C,\n$$\n\nprovided that $n \\neq -1.$ To emphasize, the power rule does *not* work when $n=-1.$ So we cannot use the above formula to work out $\\displaystyle \\int \\dfrac{1}{x}\\,\\textrm d x.$ Integrals like this need to be handled differently, and you'll find out how soon." :tutorial/id #uuid "a0806909-50b1-5a35-9ff6-fa9e18aa5c23" :tutorial/math-academy-id 697 :tutorial/title "Some Final Notes on Indefinite Integrals and Constants"} :step/id #uuid "82e795fa-0845-54a7-af6d-ea30b52689f7" :step/math-academy-id 1345} {:db/id #edb/ref 17592186065154 :step/content {:db/id #edb/ref 17592186065372 :tutorial/content "To compute the integral of any power function $x^n,$ where $n \\neq -1,$ we can use the **power rule for integration**. The power rule for integration states that\n\n$$\n\\int x^n\\, \\textrm{d}x = \\dfrac {x^{n + 1}}{n + 1} + C,\n$$\n\nwhere $C$ is any constant and $n\\neq -1.$ For example, in the case of $n=3,$ we have\n\n$$\n\\begin{aligned}\\int {x}^{3}\\,\\text{d}x & =\\frac{{x}^{3+1}}{3+1}+C \\\\  & =\\frac{{x}^{4}}{4}+C.\\end{aligned}\n$$\n\nSo the **antiderivative** of $f'(x) = x^3$ is $f(x) = \\dfrac {x^{4}}{4}+C .$ \n\nWe can check that this is the correct answer by taking the derivative of $f(x)$ and seeing that it is indeed equal to $x^3\\mathbin{:}$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{4}}{4}+C) & = \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{4}}{4})+\\frac{\\text{d}}{\\text{d}x}(C) & = \\\\ \\frac{1}{4}(\\frac{\\text{d}}{\\text{d}x}{x}^{4})+0 & = \\\\ \\frac{1}{4}\\cdot 4{x}^{4-1} & = \\\\ {x}^{3}\\,✓\\end{aligned}\n$$\n\nNotice that the constant $C$ disappeared when we differentiated because the derivative of any constant is zero. We always add $+C$ whenever we find the antiderivative of a function because we know that it will disappear when we differentiate.\n\n**Note:** The power rule for integration is just the power rule for differentiation in reverse!\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x} \\left( x^{n+1} \\right) = (n+1)x^n \\quad \\Leftrightarrow \\quad \\displaystyle \\int x^n \\, \\textrm dx = \\dfrac{x^{n+1}}{n+1}\n$$" :tutorial/id #uuid "9f08a264-7a79-50c1-afb0-903bb2a256f1" :tutorial/math-academy-id 3852 :tutorial/title "The Power Rule for Integration"} :step/id #uuid "13ecc906-0901-5139-9a2c-d3436202e3b4" :step/math-academy-id 22577 :step/next {:db/id #edb/ref 17592186065002}}] :activity/title "The Antiderivative" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186064406}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186541197} :activity/id #uuid "914f9819-f327-5e6a-85cc-1bd162c1bdb7" :activity/scope {:db/id #edb/ref 17592186049481 :topic/id #uuid "f8a6d16e-1a41-5d40-8c3d-467ebdcc3782" :topic/math-academy-id 308} :activity/steps [{:db/id #edb/ref 17592186541169 :step/content {:db/id #edb/ref 17592186541115 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29b5785c-9c86-58fa-8702-7b20eaf94717" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{9/5}}{5}+C" :db/id #edb/ref 17592186540600} {:answer/id #uuid "a6d02e90-1b24-51db-a87e-21fe5d5fa85e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{7/5}}{7}+C" :db/id #edb/ref 17592186540804} {:answer/id #uuid "da8619fc-53ce-586e-8d07-73efa17d3b93" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5{x}^{7/5}}{7}+C" :db/id #edb/ref 17592186540896} {:answer/id #uuid "de3f6a49-2e44-56e2-9f7d-ad3b02678d8f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5{x}^{9/5}}{9}+C" :db/id #edb/ref 17592186540906} {:answer/id #uuid "f746d0ee-4d45-5138-a444-dd8fb7c426b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4{x}^{9/5}}{9}+C" :db/id #edb/ref 17592186540933}] :answer-field/correct {:db/id #edb/ref 17592186540906} :answer-field/id #uuid "fa476148-4520-535e-8de8-c555998b437f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186541051}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9e0b25f6-0e44-56a6-a167-f47173302a18" :question/math-academy-id "q-113672" :question/problem "Find the antiderivative of ${x}^{4/5}.$" :question/worked-solution "We can apply the power rule with $n=\\frac{4}{5}$ and get\n\n$$\n\\begin{aligned}\\int {x}^{4/5}\\,\\text{d}x & =\\frac{{x}^{4/5+1}}{(\\frac{4}{5}+1)}+C \\\\  & =\\frac{{x}^{9/5}}{(\\frac{9}{5})}+C \\\\  & =\\frac{5{x}^{9/5}}{9}+C.\\end{aligned}\n$$\n\nAgain, let's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{5{x}^{9/5}}{9}+C) & = \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{5{x}^{9/5}}{9})+\\frac{\\text{d}}{\\text{d}x}(C) & = \\\\ \\frac{5}{9}\\frac{\\text{d}}{\\text{d}x}({x}^{9/5})+0 & = \\\\ \\frac{5}{9}\\cdot \\frac{9}{5}{x}^{9/5-1} & = \\\\ {x}^{4/5}\\,✓\\end{aligned}\n$$"} :step/id #uuid "2ca8b32d-49c3-5daf-9d51-00d019841719"} {:db/id #edb/ref 17592186541197 :step/content {:db/id #edb/ref 17592186541140 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c33caad-bb2f-5503-bf90-b0887fffc7de" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{4{x}^{4}}+C" :db/id #edb/ref 17592186540549} {:answer/id #uuid "395b2c98-0606-52cd-ad1e-4a590c5bc289" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4{x}^{4}}+C" :db/id #edb/ref 17592186540620} {:answer/id #uuid "58bcf515-bc8d-5c7f-a87c-e1d6836d3944" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{4{x}^{5}}+C" :db/id #edb/ref 17592186540678} {:answer/id #uuid "720da65f-7b8d-5025-8be5-6124aff10c66" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{{x}^{4}}{4}+C" :db/id #edb/ref 17592186540724} {:answer/id #uuid "9358fcee-68fe-5474-97b4-702d3a35e3e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{{x}^{4}}+C" :db/id #edb/ref 17592186540774}] :answer-field/correct {:db/id #edb/ref 17592186540549} :answer-field/id #uuid "df1e8bd8-c60e-5022-8cc3-6497fe7a88f5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186541041}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "daa61eb1-b03b-51c0-8270-14c708ae1e5c" :question/math-academy-id "q-29643" :question/problem "$\\int \\frac{1}{{x}^{5}}\\,\\text{d}x=$" :question/worked-solution "Note that $\\frac{1}{{x}^{5}}={x}^{-5}.$ So, we can use the power rule with $n=-5$ and get\n\n$$\n\\begin{aligned}\\int \\frac{1}{{x}^{5}}\\,\\text{d}x & =\\int {x}^{-5}\\,\\text{d}x \\\\  & =\\frac{{x}^{-5+1}}{-5+1}+C \\\\  & =\\frac{{x}^{-4}}{-4}+C \\\\  & =-\\frac{1}{4{x}^{4}}+C.\\end{aligned}\n$$"} :step/id #uuid "8710f1ed-7ac6-5f59-9036-f5fd5d25704b" :step/next {:db/id #edb/ref 17592186541221}} {:db/id #edb/ref 17592186541221 :step/content {:db/id #edb/ref 17592186541073 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "63c2faca-0edb-5ef8-8326-5900825078b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3\\cdot {6}^{3/5}}{2}{x}^{11/5}+C" :db/id #edb/ref 17592186540697} {:answer/id #uuid "73e207b9-91a9-5b1a-8a15-f29313c6b433" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5{x}^{12/5}}{12}+C" :db/id #edb/ref 17592186540727} {:answer/id #uuid "da7a61db-d353-5a53-b318-1be353f60fe6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{31}^{2/5}}{32}{x}^{7/5}+C" :db/id #edb/ref 17592186540895} {:answer/id #uuid "ed9e9b62-8e00-5346-a13f-699ec44a7450" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{7}^{2/5}}{2}{x}^{7/5}+C" :db/id #edb/ref 17592186540927} {:answer/id #uuid "fbfa7707-765d-5937-8a04-fb11b50efc05" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{36}^{2/5}}{72}{x}^{12/5}+C" :db/id #edb/ref 17592186540936}] :answer-field/correct {:db/id #edb/ref 17592186540727} :answer-field/id #uuid "05367c1f-7c48-5001-bd7f-8cd94f9a1ee7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186540944}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "31f8bbd7-44e6-58a8-9f8d-def7c80fe8a8" :question/math-academy-id "q-29652" :question/problem "What is the antiderivative of $\\sqrt[5]{{x}^{7}}?$" :question/worked-solution "We start by writing the root as a rational power, $\\sqrt[5]{{x}^{7}}={x}^{7/5}.$ So, we can apply the power rule with $n=\\frac{7}{5}$ and get\n\n$$\n\\begin{aligned}\\int \\sqrt[5]{{x}^{7}}\\,\\text{d}x & =\\int {x}^{7/5}\\,\\text{d}x \\\\  & =\\frac{{x}^{7/5+1}}{(\\frac{7}{5}+1)}+C \\\\  & =\\frac{{x}^{12/5}}{(\\frac{12}{5})}+C \\\\  & =\\frac{5{x}^{12/5}}{12}+C.\\end{aligned}\n$$\n\nAgain, let's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{5{x}^{12/5}}{12}+C) & = \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{5{x}^{12/5}}{12})+\\frac{\\text{d}}{\\text{d}x}(C) & = \\\\ \\frac{5}{12}\\frac{\\text{d}}{\\text{d}x}({x}^{12/5})+0 & = \\\\ \\frac{5}{12}\\cdot \\frac{12}{5}{x}^{12/5-1} & = \\\\ {x}^{7/5}\\,✓\\end{aligned}\n$$"} :step/id #uuid "d31b98f2-92d7-5a95-b4b5-20b07dc55a06" :step/next {:db/id #edb/ref 17592186541169}}] :activity/title "The Antiderivative" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186540520}]}
