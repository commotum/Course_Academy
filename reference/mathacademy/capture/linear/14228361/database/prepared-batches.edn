[{"source" ":org/Math-Academy" "forms" [{:db/id 17592186083161 :knowledge-point/questions ["question-cce239c3-8163-5489-bdbb-7f61254813de" "question-f87f1803-048f-5856-842f-f5c9814dfee5"] :db/ensure [:knowledge-point/validate]} {:db/id "question-cce239c3-8163-5489-bdbb-7f61254813de" :question/id #uuid "cce239c3-8163-5489-bdbb-7f61254813de" :question/math-academy-id "q-35169" :question/problem "Given that the function $f(x)$ has an inverse ${f}^{-1}(x)$, and the point $(2,-1)$ lies on the graph $y=f(x),$ which point must lie on the graph of $y={f}^{-1}(x)?$" :question/worked-solution "The function $y={f}^{-1}(x)$ is a reflection of $y=f(x)$ in the line $y=x.$ Therefore, each point $(a,b)$ on $y=f(x)$ has a corresponding point $(b,a)$ on $y={f}^{-1}(x)$ (the $x$ and $y$ coordinates swap).\n\nSince the point $(2,-1)$ lies on $y=f(x),$ the point $(-1,2)$ lies on $y={f}^{-1}(x).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f9fdc229-414d-527d-9afc-4f509a46dc39"] :db/ensure [:question/validate]} {:db/id "answer-field-f9fdc229-414d-527d-9afc-4f509a46dc39" :answer-field/id #uuid "f9fdc229-414d-527d-9afc-4f509a46dc39" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ec0a0939-f953-5c16-bd75-6d602754382b" :answer-field/choices ["answer-ec0a0939-f953-5c16-bd75-6d602754382b" "answer-6ac1f1cf-ecb0-509a-86f9-eca96f40ff42" "answer-9edbdb72-7744-54a7-ac70-88a496419317" "answer-1123f718-f438-501b-844b-142ecc377851" "answer-2a52576a-3d42-53b2-90ae-e2b56123d640"] :db/ensure [:answer-field/validate]} {:db/id "answer-ec0a0939-f953-5c16-bd75-6d602754382b" :answer/id #uuid "ec0a0939-f953-5c16-bd75-6d602754382b" :answer/type :answer.type/math :answer/value "(-1,2)" :db/ensure [:answer/validate]} {:db/id "answer-6ac1f1cf-ecb0-509a-86f9-eca96f40ff42" :answer/id #uuid "6ac1f1cf-ecb0-509a-86f9-eca96f40ff42" :answer/type :answer.type/math :answer/value "(1,-2)" :db/ensure [:answer/validate]} {:db/id "answer-9edbdb72-7744-54a7-ac70-88a496419317" :answer/id #uuid "9edbdb72-7744-54a7-ac70-88a496419317" :answer/type :answer.type/math :answer/value "(1,2)" :db/ensure [:answer/validate]} {:db/id "answer-1123f718-f438-501b-844b-142ecc377851" :answer/id #uuid "1123f718-f438-501b-844b-142ecc377851" :answer/type :answer.type/math :answer/value "(2,-1)" :db/ensure [:answer/validate]} {:db/id "answer-2a52576a-3d42-53b2-90ae-e2b56123d640" :answer/id #uuid "2a52576a-3d42-53b2-90ae-e2b56123d640" :answer/type :answer.type/math :answer/value "(2,1)" :db/ensure [:answer/validate]} {:db/id 17592186083664 :question/problem "![](images/22/2280a258ec2cf548a5393772e497bece3ecbb61549c0d7260bad2146a9f3a094.png)\n\nThe graph of $f(x)$ is given above. Which of the following could be the graph of ${f}^{-1}(x)?$" :question/worked-solution "The function $y={f}^{-1}(x)$ is a reflection of $y=f(x)$ in the line $y=x.$ Of the given options, the only graph satisfying this condition is the one shown below.\n\n![](images/b2/b2f729211c24879686601523f74935332dccbd6bf2e89b63af794b70dc721b1d.png)\n\nNotice that the points on $y=f(x)$ have corresponding points on $y={f}^{-1}(x)$ with the coordinates swapped.\n\n$$\n\\begin{aligned}(1,3) & ⟶(3,1) \\\\ (\\sqrt{3},9) & ⟶(9,\\sqrt{3})\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186080915 :answer-field/correct 17592186080918 :db/ensure [:answer-field/validate]} {:db/id "question-f87f1803-048f-5856-842f-f5c9814dfee5" :question/id #uuid "f87f1803-048f-5856-842f-f5c9814dfee5" :question/math-academy-id "q-66618" :question/problem "Given that the function $f(x)$ has an inverse ${f}^{-1}(x)$, and the point $(-\\frac{3}{2},-3)$ lies on the graph $y=f(x),$ which point must lie on the graph of $y={f}^{-1}(x)?$" :question/worked-solution "The function $y={f}^{-1}(x)$ is a reflection of $y=f(x)$ in the line $y=x.$ Therefore, each point $(a,b)$ on $y=f(x)$ has a corresponding point $(b,a)$ on $y={f}^{-1}(x)$ (the $x$ and $y$ coordinates swap).\n\nSince the point $(-\\frac{3}{2},-3)$ lies on $y=f(x),$ the point $(-3,-\\frac{3}{2})$ lies on $y={f}^{-1}(x).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-1a4cf3dc-effc-5483-9e24-4a6b9e856a01"] :db/ensure [:question/validate]} {:db/id "answer-field-1a4cf3dc-effc-5483-9e24-4a6b9e856a01" :answer-field/id #uuid "1a4cf3dc-effc-5483-9e24-4a6b9e856a01" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c6ef62b6-0019-51f3-8c7e-c96d6e5b27b4" :answer-field/choices ["answer-c6ef62b6-0019-51f3-8c7e-c96d6e5b27b4" "answer-0bf2d17b-61f8-5662-9b42-7ffe37131310" "answer-cc20a915-f28b-54bb-bb0d-d60458badfae" "answer-38ae4ee3-69b7-5477-99d6-69d092b66df5" "answer-dc172cf5-2436-5034-b7e9-eac317215744"] :db/ensure [:answer-field/validate]} {:db/id "answer-c6ef62b6-0019-51f3-8c7e-c96d6e5b27b4" :answer/id #uuid "c6ef62b6-0019-51f3-8c7e-c96d6e5b27b4" :answer/type :answer.type/math :answer/value "(-3,-\\frac{3}{2})" :db/ensure [:answer/validate]} {:db/id "answer-0bf2d17b-61f8-5662-9b42-7ffe37131310" :answer/id #uuid "0bf2d17b-61f8-5662-9b42-7ffe37131310" :answer/type :answer.type/math :answer/value "(-3,\\frac{3}{2})" :db/ensure [:answer/validate]} {:db/id "answer-cc20a915-f28b-54bb-bb0d-d60458badfae" :answer/id #uuid "cc20a915-f28b-54bb-bb0d-d60458badfae" :answer/type :answer.type/math :answer/value "(3,-\\frac{3}{2})" :db/ensure [:answer/validate]} {:db/id "answer-38ae4ee3-69b7-5477-99d6-69d092b66df5" :answer/id #uuid "38ae4ee3-69b7-5477-99d6-69d092b66df5" :answer/type :answer.type/math :answer/value "(3,\\frac{3}{2})" :db/ensure [:answer/validate]} {:db/id "answer-dc172cf5-2436-5034-b7e9-eac317215744" :answer/id #uuid "dc172cf5-2436-5034-b7e9-eac317215744" :answer/type :answer.type/math :answer/value "(\\frac{3}{2},3)" :db/ensure [:answer/validate]} {:db/id "activity-58d401b1-323f-56e8-8092-f299d6ef1cd2" :activity/id #uuid "58d401b1-323f-56e8-8092-