#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186084010} :activity/id #uuid "e7e95ebe-a6d4-54ce-af5e-ef12ac0f54c1" :activity/scope {:db/id #edb/ref 17592186048686 :topic/id #uuid "b4b6e87b-d6e5-55d8-9ea3-9ee51851e02a" :topic/math-academy-id 756} :activity/steps [{:db/id #edb/ref 17592186084010 :step/content {:db/id #edb/ref 17592186084421 :tutorial/content "Consider the function \n\n$$\n{\\color{black}f(x)} = 4x-2,\n$$\n\ndefined over the entire real line, and its inverse function \n\n$$\n{\\color{black}f^{-1}(x)} = \\dfrac{1}{4}(x+2).\n$$\n\nIf we plot both ${\\color{blue}y=f(x)}$ and ${\\color{red}y=f^{-1}(x)}$ on the same diagram, we can see that the graph of ${\\color{red}y=f^{-1}(x)}$ is a **reflection** of ${\\color{blue}y=f(x)}$ in the line $y=x.$ \n\n![](images/ec/ec501e8c71fdcc1cfdd78e47ed81542bbba44aa8ac50084cc6ddfeb7eff011ff.png)\n\nEach point $(a,b)$ on the graph of ${\\color{blue}y=f(x)}$ has a corresponding point $(b,a)$ on the graph of the inverse function ${\\color{red}y=f^{-1}(x)}.$ That is to say, the $x$ and $y$ coordinates swap.\n\nFor example, notice that the point $A(2,6)$ on ${\\color{blue}y=f(x)}$ has the corresponding point $A'(6,2)$ on ${\\color{red}y=f^{-1}(x)}.$" :tutorial/id #uuid "e6b66591-b35b-5dff-9df3-0030f51e2811" :tutorial/math-academy-id 2764 :tutorial/title "Introduction"} :step/id #uuid "0f462406-aa92-557b-8726-d65ca3ece754" :step/math-academy-id 13792 :step/next {:db/id #edb/ref 17592186084012}} {:db/id #edb/ref 17592186084011 :step/content {:db/id #edb/ref 17592186083160 :knowledge-point/canonical-example {:db/id #edb/ref 17592186082977 :question/id #uuid "ad4ecf44-6f6e-51a8-9c37-57483f958c72" :question/math-academy-id "e-3947"} :knowledge-point/id #uuid "321d88fd-fca2-5907-8a16-809b3795c640" :knowledge-point/questions [{:db/id #edb/ref 17592186083664} {:db/id #edb/ref 17592186083666} {:db/id #edb/ref 17592186521500}] :knowledge-point/title "Identifying the Graph of an Inverse Function"} :step/id #uuid "c915c7b8-4ebd-5772-a1b7-fe38b1c8862e" :step/math-academy-id 13795} {:db/id #edb/ref 17592186084012 :step/content {:db/id #edb/ref 17592186083161 :knowledge-point/canonical-example {:db/id #edb/ref 17592186082978 :question/id #uuid "31a829fb-738f-579d-9232-7313c531733a" :question/math-academy-id "e-3948"} :knowledge-point/id #uuid "64cd9663-3e98-5508-9279-9af971ab13b2" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050867}] :knowledge-point/questions [{:db/id #edb/ref 17592186083667} {:db/id #edb/ref 17592186083668} {:db/id #edb/ref 17592186521525} {:db/id #edb/ref 17592186550000} {:db/id #edb/ref 17592186550018}] :knowledge-point/title "Identifying Points That Lie on the Graph on an Inverse Function"} :step/id #uuid "292083a0-53fe-58ee-833c-f83407811012" :step/math-academy-id 13801 :step/next {:db/id #edb/ref 17592186084011}}] :activity/title "Graphs of Inverse Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186083446}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186550088} :activity/id #uuid "58d401b1-323f-56e8-8092-f299d6ef1cd2" :activity/scope {:db/id #edb/ref 17592186048686 :topic/id #uuid "b4b6e87b-d6e5-55d8-9ea3-9ee51851e02a" :topic/math-academy-id 756} :activity/steps [{:db/id #edb/ref 17592186550088 :step/content {:db/id #edb/ref 17592186550000 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1123f718-f438-501b-844b-142ecc377851" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2,-1)" :db/id #edb/ref 17592186549344} {:answer/id #uuid "2a52576a-3d42-53b2-90ae-e2b56123d640" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2,1)" :db/id #edb/ref 17592186549410} {:answer/id #uuid "6ac1f1cf-ecb0-509a-86f9-eca96f40ff42" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(1,-2)" :db/id #edb/ref 17592186549519} {:answer/id #uuid "9edbdb72-7744-54a7-ac70-88a496419317" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(1,2)" :db/id #edb/ref 17592186549618} {:answer/id #uuid "ec0a0939-f953-5c16-bd75-6d602754382b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-1,2)" :db/id #edb/ref 17592186549749}] :answer-field/correct {:db/id #edb/ref 17592186549749} :answer-field/id #uuid "f9fdc229-414d-527d-9afc-4f509a46dc39" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186549919}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cce239c3-8163-5489-bdbb-7f61254813de" :question/math-academy-id "q-35169" :question/problem "Given that the function $f(x)$ has an inverse ${f}^{-1}(x)$, and the point $(2,-1)$ lies on the graph $y=f(x),$ which point must lie on the graph of $y={f}^{-1}(x)?$" :question/worked-solution "The function $y={f}^{-1}(x)$ is a reflection of $y=f(x)$ in the line $y=x.$ Therefore, each point $(a,b)$ on $y=f(x)$ has a corresponding point $(b,a)$ on $y={f}^{-1}(x)$ (the $x$ and $y$ coordinates swap).\n\nSince the point $(2,-1)$ lies on $y=f(x),$ the point $(-1,2)$ lies on $y={f}^{-1}(x).$"} :step/id #uuid "ae600ad6-5cdb-57a9-bb57-ebc5860ddaa6" :step/next {:db/id #edb/ref 17592186550102}} {:db/id #edb/ref 17592186550090 :step/content {:db/id #edb/ref 17592186550018 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bf2d17b-61f8-5662-9b42-7ffe37131310" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-3,\\frac{3}{2})" :db/id #edb/ref 17592186549336} {:answer/id #uuid "38ae4ee3-69b7-5477-99d6-69d092b66df5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3,\\frac{3}{2})" :db/id #edb/ref 17592186549430} {:answer/id #uuid "c6ef62b6-0019-51f3-8c7e-c96d6e5b27b4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-3,-\\frac{3}{2})" :db/id #edb/ref 17592186549687} {:answer/id #uuid "cc20a915-f28b-54bb-bb0d-d60458badfae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3,-\\frac{3}{2})" :db/id #edb/ref 17592186549699} {:answer/id #uuid "dc172cf5-2436-5034-b7e9-eac317215744" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\frac{3}{2},3)" :db/id #edb/ref 17592186549723}] :answer-field/correct {:db/id #edb/ref 17592186549687} :answer-field/id #uuid "1a4cf3dc-effc-5483-9e24-4a6b9e856a01" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186549806}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f87f1803-048f-5856-842f-f5c9814dfee5" :question/math-academy-id "q-66618" :question/problem "Given that the function $f(x)$ has an inverse ${f}^{-1}(x)$, and the point $(-\\frac{3}{2},-3)$ lies on the graph $y=f(x),$ which point must lie on the graph of $y={f}^{-1}(x)?$" :question/worked-solution "The function $y={f}^{-1}(x)$ is a reflection of $y=f(x)$ in the line $y=x.$ Therefore, each point $(a,b)$ on $y=f(x)$ has a corresponding point $(b,a)$ on $y={f}^{-1}(x)$ (the $x$ and $y$ coordinates swap).\n\nSince the point $(-\\frac{3}{2},-3)$ lies on $y=f(x),$ the point $(-3,-\\frac{3}{2})$ lies on $y={f}^{-1}(x).$"} :step/id #uuid "b0a29cb4-7b38-502f-99b6-f57e2ce5c1e6"} {:db/id #edb/ref 17592186550102 :step/content {:db/id #edb/ref 17592186083664 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8fd1719c-f296-5669-ab61-af85ae83dce2" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/4f/4f016342723cfb8c3dbaae736e7d43e0783b11030a8cee916075041b0c444b8b.png" :db/id #edb/ref 17592186080916} {:answer/id #uuid "df9695a8-d58e-5d75-9ae1-67b55317ee03" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/15/1577623b46b2ff1d63b76892de3795ba5e8aa7dd7876117d50f8ed15c32c9963.png" :db/id #edb/ref 17592186080917} {:answer/id #uuid "f0e5daf4-34b6-5289-b29c-a207833a1d19" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/09/09709351dc7bbfdeb22cd0076dc2e42fc663f3fd4ca99dc7e6f5748d0752cf56.png" :db/id #edb/ref 17592186080918} {:answer/id #uuid "33dbd3ee-514e-5219-911e-373e8d2d34da" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/db/db6912514294f44ffdaa8633319fd7c9ef0841423357817943ead62de5ce5a01.png" :db/id #edb/ref 17592186080919} {:answer/id #uuid "73002db5-b03b-5aa0-b9b6-c0cf4a628358" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/7e/7e83af628d9be5a9d3c720c063b17c4ea63707d7073f46719ea2801529aa939b.png" :db/id #edb/ref 17592186080920}] :answer-field/correct {:db/id #edb/ref 17592186080918} :answer-field/id #uuid "58d192e6-f519-53b6-99ac-9aa68d4d38bf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186080915}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "233e73f1-eb95-5caa-bf5c-54b6f11e4095" :question/math-academy-id "q-35178" :question/problem "![](images/22/2280a258ec2cf548a5393772e497bece3ecbb61549c0d7260bad2146a9f3a094.png)\n\nThe graph of $f(x)$ is given above. Which of the following could be the graph of ${f}^{-1}(x)?$" :question/worked-solution "The function $y={f}^{-1}(x)$ is a reflection of $y=f(x)$ in the line $y=x.$ Of the given options, the only graph satisfying this condition is the one shown below.\n\n![](images/b2/b2f729211c24879686601523f74935332dccbd6bf2e89b63af794b70dc721b1d.png)\n\nNotice that the points on $y=f(x)$ have corresponding points on $y={f}^{-1}(x)$ with the coordinates swapped.\n\n$$\n\\begin{aligned}(1,3) & ⟶(3,1) \\\\ (\\sqrt{3},9) & ⟶(9,\\sqrt{3})\\end{aligned}\n$$"} :step/id #uuid "ceb432f0-d081-559d-bec1-57c991f96e15" :step/next {:db/id #edb/ref 17592186550090}}] :activity/title "Graphs of Inverse Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186549304}]}
