#{[{:activity/first-step {:db/id #edb/ref 17592186116269} :activity/id #uuid "4e5fdcac-beed-5892-9efc-a06702cb9554" :activity/scope {:db/id #edb/ref 17592186049573 :topic/id #uuid "0121d20c-296f-54b7-b81e-a0ffc6a703bc" :topic/math-academy-id 1628} :activity/steps [{:db/id #edb/ref 17592186116269 :step/content {:db/id #edb/ref 17592186116429 :tutorial/content "A function $f(x)$ is **strictly increasing** if its $y$-value always rises as we increase the $x$-value. No section of the graph is allowed to be flat.\n\n![](images/ff/ffd868f19387999e329288fd1d492c071d3f0e12c4e9b474e092bc913791d013.png)\n\nOn the other hand, a function $f(x)$ is **increasing** if its $y$-value *never falls* as we increase the $x$-value.\n\n**Watch Out!** Increasing functions, like the one below, are allowed to have flat sections.\n\n![](images/39/39cf4a0a64391114e7b79eed6f039ea4fd0f0772ba2cfb8d4b36c4ab0a5d53b2.png)" :tutorial/id #uuid "75e3de1d-9fd6-536a-b21e-7d6434297ce7" :tutorial/math-academy-id 1500 :tutorial/title "Introduction"} :step/id #uuid "19fed9b9-c6e2-5a36-8640-f67f71f20577" :step/math-academy-id 3655 :step/next {:db/id #edb/ref 17592186116270}} {:db/id #edb/ref 17592186116270 :step/content {:db/id #edb/ref 17592186115337 :knowledge-point/canonical-example {:db/id #edb/ref 17592186114915 :question/id #uuid "514bbf6e-7eb5-5158-ac3f-5cb1f88d72d4" :question/math-academy-id "e-1122"} :knowledge-point/id #uuid "b898eab7-cbfc-5ce5-b03a-ed59d875416a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048652} {:db/id #edb/ref 17592186049162}] :knowledge-point/questions [{:db/id #edb/ref 17592186115651} {:db/id #edb/ref 17592186115656}] :knowledge-point/title "Identifying Intervals on Which a Function is Increasing"} :step/id #uuid "878c51c5-4761-5147-9a81-447753be3f73" :step/math-academy-id 3656 :step/next {:db/id #edb/ref 17592186116271}} {:db/id #edb/ref 17592186116271 :step/content {:db/id #edb/ref 17592186116430 :tutorial/content "A function $f(x)$ is **strictly decreasing** if its $y$-value always *falls* as we increase the $x$-value. No section of the graph is allowed to be flat.\n\n![](images/b8/b8a2d54cedc84f159a61bfccc11bdab9adc73eb54b694dd1167802998f4d39d3.png)\n\nOn the other hand, a function $f(x)$ is **decreasing** if its $y$-value *never rises* as we increase the $x$-value. Decreasing functions are allowed to have flat sections.\n\n![](images/4f/4f91b34a57ac42ba82e937c78c74bcb26677e1d6fbf8ed40865f6db73b1cf613.png)" :tutorial/id #uuid "81ea8002-60eb-5227-bbdd-bc329f9f3f89" :tutorial/math-academy-id 1501 :tutorial/title "Decreasing and Strictly Decreasing Functions"} :step/id #uuid "16a2910f-29b2-5b2e-9ad5-d70273d4a38d" :step/math-academy-id 3660 :step/next {:db/id #edb/ref 17592186116272}} {:db/id #edb/ref 17592186116272 :step/content {:db/id #edb/ref 17592186115338 :knowledge-point/canonical-example {:db/id #edb/ref 17592186114916 :question/id #uuid "35bfc06f-0bc4-55b4-a037-49166721c3d5" :question/math-academy-id "e-1123"} :knowledge-point/id #uuid "badbc067-8e47-51ed-9a8c-40725fec2b49" :knowledge-point/questions [{:db/id #edb/ref 17592186115652} {:db/id #edb/ref 17592186115657}] :knowledge-point/title "Identifying Intervals on Which a Function is Decreasing"} :step/id #uuid "7450e4ef-df70-5ca4-8c6d-12844e5fe1ad" :step/math-academy-id 3661}] :activity/title "Increasing and Decreasing Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186115437}]}
