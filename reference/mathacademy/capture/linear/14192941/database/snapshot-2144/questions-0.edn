#{[{:db/id #edb/ref 17592186114915 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186115337 :knowledge-point/id #uuid "b898eab7-cbfc-5ce5-b03a-ed59d875416a" :knowledge-point/title "Identifying Intervals on Which a Function is Increasing"}] :question/id #uuid "514bbf6e-7eb5-5158-ac3f-5cb1f88d72d4" :question/math-academy-id "e-1122" :question/problem "In which intervals is the function $y=f(x)$ (plotted below) strictly increasing? In which intervals is it increasing?\n\n![](images/cf/cfe907d96b0b9ee70fa48922b398baee66fe4bfded024134604bfb3a15c7c013.png)" :question/worked-solution "If we follow the graph from left to right, we can see that: \n\n- For $x\\in(-2,2)$ the graph rises\n\n- For $x\\in(2,5)$ the graph falls\n\n- For $x\\in(5,7)$ the graph is flat\n\n- For $x\\in(7,9)$ the graph rises\n\nTherefore, we conclude that:\n\n- The function is *strictly increasing* on the intervals where it always rises: $(-2,2)$ and $(7,9).$\n\n- The function is *increasing* on the intervals where it never falls: $(-2,2)$ and $(5,9).$"}] [{:db/id #edb/ref 17592186114916 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186115338 :knowledge-point/id #uuid "badbc067-8e47-51ed-9a8c-40725fec2b49" :knowledge-point/title "Identifying Intervals on Which a Function is Decreasing"}] :question/id #uuid "35bfc06f-0bc4-55b4-a037-49166721c3d5" :question/math-academy-id "e-1123" :question/problem "In which intervals is the function $y=f(x)$ (plotted below) strictly decreasing? On which intervals is it decreasing?\n\n![](images/d5/d5b32a598d6a0f4b8067ee98189d730e22042d87d38c96660191a7b7ecb9505c.png)" :question/worked-solution "If we follow the graph from left to right, we can see that: \n\n- For $x\\in (-4,-3)$ the graph rises\n\n- For $x\\in (-3,0)$ the graph falls\n\n- For $x\\in (0,2)$ the graph rises\n\n- For $x\\in (2,4)$ the graph is flat\n\n- For $x\\in (4,5)$ the graph falls\n\nTherefore, we can conclude that:\n\n- The graph is *strictly decreasing* on the intervals where it always falls: $(-3,0)$ and $(4,5).$\n\n- The graph is *decreasing* on the intervals where it never rises: $(-3,0)$ and $(2,5).$"}] [{:db/id #edb/ref 17592186506560 :knowledge-point/_questions [{:db/id #edb/ref 17592186115337 :knowledge-point/id #uuid "b898eab7-cbfc-5ce5-b03a-ed59d875416a" :knowledge-point/title "Identifying Intervals on Which a Function is Increasing"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9658c700-bec9-550b-bdbf-ee8f31c9523c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\infty ,-2)" :db/id #edb/ref 17592186506169} {:answer/id #uuid "9e257b9b-b145-5a50-8cc8-d2b04799983a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,\\infty )" :db/id #edb/ref 17592186506191} {:answer/id #uuid "bd43085b-e350-5dbd-b67f-57e26b0018cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,\\infty )" :db/id #edb/ref 17592186506251} {:answer/id #uuid "bf65e757-4442-5a0f-86c5-79e9ccf99b0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,2)" :db/id #edb/ref 17592186506257} {:answer/id #uuid "d0f2d9ff-380c-593d-88b2-f03bfb6c454b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,2)" :db/id #edb/ref 17592186506286}] :answer-field/correct {:answer/id #uuid "d0f2d9ff-380c-593d-88b2-f03bfb6c454b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,2)" :db/id #edb/ref 17592186506286} :answer-field/id #uuid "08e81c03-c105-508e-82e4-cc768050b45c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186506381}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "86a019fb-a0e8-5be0-aaf0-3d6271255b32" :question/math-academy-id "q-159878" :question/problem 