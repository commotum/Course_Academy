#{[{:db/id #edb/ref 17592186059523 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186059710 :knowledge-point/id #uuid "d63a46dd-b963-5ecc-a96d-e0204ca480a9" :knowledge-point/title "Addition and Scalar Multiplication of Vectors in Component Form"}] :question/id #uuid "1d2717f9-b905-59eb-85d7-6db4f9c9dc7f" :question/math-academy-id "e-4292" :question/problem "Find $\\mathbf{a}-2\\mathbf{b}$ if $\\mathbf{a}=-4\\mathbf{i}+6\\mathbf{j}$ and $\\mathbf{b}=12\\mathbf{i}$." :question/worked-solution "To compute $\\mathbf{a}-2\\mathbf{b}$, we just need to compute all of the $\\mathbf{i}$'s and $\\mathbf{j}$'s, as follows:\n\n$$\n\\begin{aligned}\na - 2b &= (-4i + 6j) - 2(12i) \\\\\n&=-4i + 6j - 24i \\\\\n&= (-4i - 24i) + 6j \\\\\n&=-28i + 6j\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186059524 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186059711 :knowledge-point/id #uuid "1735c445-9c97-5aa7-83d6-7dee23993153" :knowledge-point/title "Calculating Sums and Scalar Multiplication of Vectors Using Angle Bracket Notation"}] :question/id #uuid "2cb63c87-320a-5cb4-b413-8c6bf9723641" :question/math-academy-id "e-4293" :question/problem "Let $\\mathbf{a}=\\langle -7, 15 \\rangle$ and $\\mathbf{b}=\\langle 14, -11 \\rangle$. Find $\\mathbf{a}-3\\mathbf{b}$." :question/worked-solution "To compute $\\mathbf{a}-3\\mathbf{b}$, we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}\na - 3b &= ⟨ - 7, 15⟩ - 3 \\cdot ⟨14,-11⟩ \\\\\n&= ⟨ - 7, 15⟩ - ⟨42,-33⟩ \\\\\n&= ⟨ - 7 - 42, 15 - (-33)⟩ \\\\\n&= ⟨ - 49, 48⟩\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186059525 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186059712 :knowledge-point/id #uuid "8a21360f-af5f-5730-85b2-b617de30eaf6" :knowledge-point/title "Calculating Sums and Scalar Multiplication of Column Vectors"}] :question/id #uuid "43cfef07-255d-5167-b815-267883918993" :question/math-academy-id "e-4294" :question/problem "Let $\\begin{bmatrix}1 \\\\ -5\\end{bmatrix}$ $\\begin{bmatrix}2 \\\\ 4\\end{bmatrix}$ and $\\begin{bmatrix}-3 \\\\ 7\\end{bmatrix}$ Find $2\\mathbf{a}-(\\mathbf{b}-5\\mathbf{c})$." :question/worked-solution "To compute the result, we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}\n2a - (b - 5c) &= 2 \\cdot \\begin{bmatrix}1 \\\\ -5\\end{bmatrix} - (\\begin{bmatrix}2 \\\\ 4\\end{bmatrix} - 5 \\cdot \\begin{bmatrix}-3 \\\\ 7\\end{bmatrix}) \\\\\n&= \\begin{bmatrix}2 \\\\ -10\\end{bmatrix} - (\\begin{bmatrix}2 \\\\ 4\\end{bmatrix} - \\begin{bmatrix}-15 \\\\ 35\\end{bmatrix}) \\\\\n&= \\begin{bmatrix}2 \\\\ -10\\end{bmatrix} - \\begin{bmatrix}17 \\\\ -31\\end{bmatrix} \\\\\n&= \\begin{bmatrix}-15 \\\\ 21\\end{bmatrix}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186059526 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186059713 :knowledge-point/id #uuid "fc55e44b-82d0-5145-8a24-d43bc60dc594" :knowledge-point/title "Calculating Sums and Scalar Multiplication of Vectors Given in Alternative Notation"}] :question/id #uuid "0adf8fad-9a6f-5eb1-970f-11633ba98ca1" :question/math-academy-id "e-4295" :question/problem "The vectors $\\vec{a}$ and $\\vec{b}$ are given in the picture below. Find the coordinates of $\\vec{a}+6\\vec{b}$.\n\n![](images/56/56b10e759084da6fb21c8421bc9ff6d74aac2602df28f6c8e478bd874d7d6e9f.png)" :question/worked-solution "From the picture, we obtain\n\n$$\n\\vec{a}=\\langle -3,2 \\rangle\n$$\n\nand\n\n$$\n\\vec{b}=\\langle 4,5 \\rangle\n$$\n\nTherefore, to compute the result, we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}\na^(→) + 6b^(→) &= ⟨ - 3, 2⟩ + 6 \\cdot ⟨4, 5⟩ \\\\\n&= ⟨ - 3, 2⟩ + ⟨6 \\cdot 4, 6 \\cdot 5⟩ \\\\\n&= ⟨ - 3, 2⟩ + ⟨24, 30⟩ \\\\\n&= ⟨21, 32⟩\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186060041 :knowledge-point/_questions [{:db/id #edb/ref 17592186059713 :knowledge-point/id #uuid "fc55e44b-82d0-5145-8a24-d43bc60dc594" :knowledge-point/title "Calculating Sums and Scalar Multiplication of Vectors Given in Alternative Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e97a75c-a837-567a-8756-67dfad176334" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨ - 11, 4⟩" :db/id #edb/ref 17592186056605} {:answer/id #uuid "a370905b-4205-5438-b194-1750e2fd465f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨ - 24,-21⟩" :db/id #edb/ref 17592186056606} {:answer/id #uuid "c1e2d804-4fde-5234-8f14-04d7c065242f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨ - 24, 21⟩" :db/id #edb/ref 17592186056607} {:answer/id #uuid "f8601e90-71b0-596f-8f7a-24048ce102a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨11,-4⟩" :db/id #edb/ref 17592186056608} {:answer/id #uuid "66b9ccc9-0bcc-51d3-b695-fcb59bdbbb7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨24,-21⟩" :db/id #edb/ref 17592186056609}] :answer-field/id #uuid "2fd4b126-00ce-5715-a19e-17e93432620d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186056604}] :question/id #uuid "a46b9579-0f65-55f3-9e73-31c91369d46c" :question/math-academy-id "q-1386" :question/problem "If $v^(→) = ⟨8,-7⟩$, then $3v^(→) =$"}]}
