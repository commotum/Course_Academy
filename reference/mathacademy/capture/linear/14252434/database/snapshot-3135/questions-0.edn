#{[{:db/id #edb/ref 17592186059523 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186059710 :knowledge-point/id #uuid "d63a46dd-b963-5ecc-a96d-e0204ca480a9" :knowledge-point/title "Addition and Scalar Multiplication of Vectors in Component Form"}] :question/id #uuid "1d2717f9-b905-59eb-85d7-6db4f9c9dc7f" :question/math-academy-id "e-4292" :question/problem "Find $\\mathbf{a}-2\\mathbf{b}$ if $\\mathbf{a}=-4\\mathbf{i}+6\\mathbf{j}$ and $\\mathbf{b}=12\\mathbf{i}$." :question/worked-solution "To compute $\\mathbf{a}-2\\mathbf{b}$, we just need to compute all of the $\\mathbf{i}$'s and $\\mathbf{j}$'s, as follows:\n\n$$\n\\begin{aligned}\na - 2b &= (-4i + 6j) - 2(12i) \\\\\n&=-4i + 6j - 24i \\\\\n&= (-4i - 24i) + 6j \\\\\n&=-28i + 6j\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186059524 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186059711 :knowledge-point/id #uuid "1735c445-9c97-5aa7-83d6-7dee23993153" :knowledge-point/title "Calculating Sums and Scalar Multiplication of Vectors Using Angle Bracket Notation"}] :question/id #uuid "2cb63c87-320a-5cb4-b413-8c6bf9723641" :question/math-academy-id "e-4293" :question/problem "Let $\\mathbf{a}=\\langle -7, 15 \\rangle$ and $\\mathbf{b}=\\langle 14, -11 \\rangle$. Find $\\mathbf{a}-3\\mathbf{b}$." :question/worked-solution "To compute $\\mathbf{a}-3\\mathbf{b}$, we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}\na - 3b &= ⟨ - 7, 15⟩ - 3 \\cdot ⟨14,-11⟩ \\\\\n&= ⟨ - 7, 15⟩ - ⟨42,-33⟩ \\\\\n&= ⟨ - 7 - 42, 15 - (-33)⟩ \\\\\n&= ⟨ - 49, 48⟩\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186059525 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186059712 :knowledge-point/id #uuid "8a21360f-af5f-5730-85b2-b617de30eaf6" :knowledge-point/title "Calculating Sums and Scalar Multiplication of Column Vectors"}] :question/id #uuid "43cfef07-255d-5167-b815-267883918993" :question/math-academy-id "e-4294" :question/problem "Let $\\begin{bmatrix}1 \\\\ -5\\end{bmatrix}$ $\\begin{bmatrix}2 \\\\ 4\\end{bmatrix}$ and $\\begin{bmatrix}-3 \\\\ 7\\end{bmatrix}$ Find $2\\mathbf{a}-(\\mathbf{b}-5\\mathbf{c})$." :question/worked-solution "To compute the result, we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}\n2a - (b - 5c) &= 2 \\cdot \\begin{bmatrix}1 \\\\ -5\\end{bmatrix} - (\\begin{bmatrix}2 \\\\ 4\\end{bmatrix} - 5 \\cdot \\begin{bmatrix}-3 \\\\ 7\\end{bmatrix}) \\\\\n&= \\begin{bmatrix}2 \\\\ -10\\end{bmatrix} - (\\begin{bmatrix}2 \\\\ 4\\end{bmatrix} - \\begin{bmatrix}-15 \\\\ 35\\end{bmatrix}) \\\\\n&= \\begin{bmatrix}2 \\\\ -10\\end{bmatrix} - \\begin{bmatrix}17 \\\\ -31\\end{bmatrix} \\\\\n&= \\begin{bmatrix}-15 \\\\ 21\\end{bmatrix}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186059526 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186059713 :knowledge-point/id #uuid "fc55e44b-82d0-5145-8a24-d43bc60dc594" :knowledge-point/title "Calculating Sums and Scalar Multiplication of Vectors Given in Alternative Notation"}] :question/id #uuid "0adf8fad-9a6f-5eb1-970f-11633ba98ca1" :question/math-academy-id "e-4295" :question/problem "The vectors $\\vec{a}$ and $\\vec{b}$ are given in the picture below. Find the coordinates of $\\vec{a}+6\\vec{b}$.\n\n![](images/56/56b10e759084da6fb21c8421bc9ff6d74aac2602df28f6c8e478bd874d7d6e9f.png)" :question/worked-solution "From the picture, we obtain\n\n$$\n\\vec{a}=\\langle -3,2 \\rangle\n$$\n\nand\n\n$$\n\\vec{b}=\\langle 4,5 \\rangle\n$$\n\nTherefore, to compute the result, we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}\na^(→) + 6b^(→) &= ⟨ - 3, 2⟩ + 6 \\cdot ⟨4, 5⟩ \\\\\n&= ⟨ - 3, 2⟩ + ⟨6 \\cdot 4, 6 \\cdot 5⟩ \\\\\n&= ⟨ - 3, 2⟩ + ⟨24, 30⟩ \\\\\n&= ⟨21, 32⟩\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186573310 :knowledge-point/_questions [{:db/id #edb/ref 17592186059713 :knowledge-point/id #uuid "fc55e44b-82d0-5145-8a24-d43bc60dc594" :knowledge-point/title "Calculating Sums and Scalar Multiplication of Vectors Given in Alternative Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "564f131c-8153-5250-b192-4b9c01928dac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-7,4⟩" :db/id #edb/ref 17592186572924} {:answer/id #uuid "6a83b317-aff4-5937-af17-51947b81c9ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨6,-2⟩" :db/id #edb/ref 17592186572955} {:answer/id #uuid "9583fb5a-80a8-59d4-8f69-e42a4c690518" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨9,-6⟩" :db/id #edb/ref 17592186573020} {:answer/id #uuid "b3488a28-3a50-53c3-80e7-a44957ccecfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨7,-4⟩" :db/id #edb/ref 17592186573053} {:answer/id #uuid "e7674bcd-8b37-50a7-9442-93d15edfb14d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨6,-6⟩" :db/id #edb/ref 17592186573120}] :answer-field/correct {:answer/id #uuid "b3488a28-3a50-53c3-80e7-a44957ccecfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨7,-4⟩" :db/id #edb/ref 17592186573053} :answer-field/id #uuid "dbdfce8f-abfe-53cb-9705-5a4369c47f42" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573233}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d424dcb1-177c-5053-898f-bbc5de5cd766" :question/math-academy-id "q-125100" :question/problem "If $\\overset{\\to }{u}=⟨4,-3⟩$ and $\\overset{\\to }{v}=⟨-1,2⟩$, then $2\\overset{\\to }{u}+\\overset{\\to }{v}=$" :question/worked-solution "To compute the result, we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}2\\overset{\\to }{u}+\\overset{\\to }{v} & =2\\cdot ⟨4,-3⟩+⟨-1,2⟩ \\\\  & =⟨8,-6⟩+⟨-1,2⟩ \\\\  & =⟨8+(-1),-6+2⟩ \\\\  & =⟨8-1,-6+2⟩ \\\\  & =⟨7,-4⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186573294 :knowledge-point/_questions [{:db/id #edb/ref 17592186059711 :knowledge-point/id #uuid "1735c445-9c97-5aa7-83d6-7dee23993153" :knowledge-point/title "Calculating Sums and Scalar Multiplication of Vectors Using Angle Bracket Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10326701-ee4b-51a6-8ce9-48cbe25e1578" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨3,-5⟩" :db/id #edb/ref 17592186572840} {:answer/id #uuid "76463159-aa6c-56a7-a471-cfc66caff22b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-23,-19⟩" :db/id #edb/ref 17592186572974} {:answer/id #uuid "9ac6e0db-a67c-576a-a180-138ad75d03a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨23,19⟩" :db/id #edb/ref 17592186573023} {:answer/id #uuid "aa6cc5f9-0aba-5c98-8504-611e160dc1c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-5,3⟩" :db/id #edb/ref 17592186573041} {:answer/id #uuid "d899705a-127e-504e-8dad-21ff7c08410d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨5,3⟩" :db/id #edb/ref 17592186573098}] :answer-field/correct {:answer/id #uuid "aa6cc5f9-0aba-5c98-8504-611e160dc1c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-5,3⟩" :db/id #edb/ref 17592186573041} :answer-field/id #uuid "c2fe659b-d757-5bbe-a2bd-14f2ff748642" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573221}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "933d30fa-71c5-533c-a1e8-a19050253145" :question/math-academy-id "q-1306" :question/problem "Let $u=⟨7,4⟩$ and $v=⟨9,11⟩.$ Find $-2u+v.$" :question/worked-solution "To compute $-2u+v,$ we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}-2u+v & =-2\\cdot ⟨7,4⟩+⟨9,11⟩ \\\\  & =⟨-14,-8⟩+⟨9,11⟩ \\\\  & =⟨-5,3⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186060041 :knowledge-point/_questions [{:db/id #edb/ref 17592186059713 :knowledge-point/id #uuid "fc55e44b-82d0-5145-8a24-d43bc60dc594" :knowledge-point/title "Calculating Sums and Scalar Multiplication of Vectors Given in Alternative Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e97a75c-a837-567a-8756-67dfad176334" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨ - 11, 4⟩" :db/id #edb/ref 17592186056605} {:answer/id #uuid "a370905b-4205-5438-b194-1750e2fd465f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨ - 24,-21⟩" :db/id #edb/ref 17592186056606} {:answer/id #uuid "c1e2d804-4fde-5234-8f14-04d7c065242f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨ - 24, 21⟩" :db/id #edb/ref 17592186056607} {:answer/id #uuid "f8601e90-71b0-596f-8f7a-24048ce102a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨11,-4⟩" :db/id #edb/ref 17592186056608} {:answer/id #uuid "66b9ccc9-0bcc-51d3-b695-fcb59bdbbb7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨24,-21⟩" :db/id #edb/ref 17592186056609}] :answer-field/id #uuid "2fd4b126-00ce-5715-a19e-17e93432620d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186056604}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a46b9579-0f65-55f3-9e73-31c91369d46c" :question/math-academy-id "q-1386" :question/problem "If $v^(→) = ⟨8,-7⟩$, then $3v^(→) =$"}] [{:db/id #edb/ref 17592186573284 :knowledge-point/_questions [{:db/id #edb/ref 17592186059711 :knowledge-point/id #uuid "1735c445-9c97-5aa7-83d6-7dee23993153" :knowledge-point/title "Calculating Sums and Scalar Multiplication of Vectors Using Angle Bracket Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a3589f1-ac93-5952-859b-8f591ed12f8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨4,-3⟩" :db/id #edb/ref 17592186572852} {:answer/id #uuid "217df582-1766-5708-befa-cca7ca604227" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-4,6⟩" :db/id #edb/ref 17592186572864} {:answer/id #uuid "22a814b0-3197-565e-b644-6bb531bb40ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-4,-6⟩" :db/id #edb/ref 17592186572867} {:answer/id #uuid "b78a4790-38b5-51fd-90db-551fbc2d1b6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-4,3⟩" :db/id #edb/ref 17592186573057} {:answer/id #uuid "dc199364-014d-525d-b0f2-b1fef9e454e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨4,6⟩" :db/id #edb/ref 17592186573102}] :answer-field/correct {:answer/id #uuid "217df582-1766-5708-befa-cca7ca604227" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-4,6⟩" :db/id #edb/ref 17592186572864} :answer-field/id #uuid "37eefbb8-760d-5cd5-a2f6-73f262b42f48" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573170}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "71659674-1123-5b9b-95e7-0ead2ac9950c" :question/math-academy-id "q-1390" :question/problem "If $\\overset{\\to }{c}=⟨12,-18⟩$, then $-\\frac{1}{3}\\overset{\\to }{c}=$" :question/worked-solution "To compute $-\\frac{1}{3}\\overset{\\to }{c},$ we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}-\\frac{1}{3}\\overset{\\to }{c} & =-\\frac{1}{3}\\cdot ⟨12,-18⟩ \\\\  & =⟨(-\\frac{1}{3})\\cdot 12,(-\\frac{1}{3})\\cdot (-18)⟩ \\\\  & =⟨-4,6⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186573298 :knowledge-point/_questions [{:db/id #edb/ref 17592186059710 :knowledge-point/id #uuid "d63a46dd-b963-5ecc-a96d-e0204ca480a9" :knowledge-point/title "Addition and Scalar Multiplication of Vectors in Component Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "acdcaad1-cc0b-58a8-82d4-aa66a6ebf9bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186573045}] :answer-field/correct {:answer/id #uuid "acdcaad1-cc0b-58a8-82d4-aa66a6ebf9bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186573045} :answer-field/id #uuid "1753a53f-eb17-530d-95c3-5ae8d2f8195b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186573156} {:answer-field/choices [{:answer/id #uuid "73c16677-4499-5cbc-a3fd-06c9e7712966" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186572969}] :answer-field/correct {:answer/id #uuid "73c16677-4499-5cbc-a3fd-06c9e7712966" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186572969} :answer-field/id #uuid "17f70e66-7ffa-5b97-ae83-7c4b0c657938" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186573157}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "aa045c10-f709-5818-81e4-f02ca81ca31a" :question/math-academy-id "q-275319" :question/problem "If $a=5i-3j$ and $b=-i+5j,$ then $a+b=${{field-1}}$i\\,\\,+$\n{{field-2}}$j.$" :question/worked-solution "To compute $a+b,$ we just need to compute all of the $i$'s and $j$'s, as follows:\n\n$$\n\\begin{aligned}a+b & =(5i-3j)+(-i+5j) \\\\  & =5i-3j-i+5j \\\\  & =(5i-i)+(-3j+5j) \\\\  & =4i+2j\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186573262 :knowledge-point/_questions [{:db/id #edb/ref 17592186059710 :knowledge-point/id #uuid "d63a46dd-b963-5ecc-a96d-e0204ca480a9" :knowledge-point/title "Addition and Scalar Multiplication of Vectors in Component Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88aef948-a3e2-5b2a-a0db-15016ea2ff80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186573000}] :answer-field/correct {:answer/id #uuid "88aef948-a3e2-5b2a-a0db-15016ea2ff80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186573000} :answer-field/id #uuid "22e5c6b4-ff57-5524-b47e-5c643c0d161c" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186573162} {:answer-field/choices [{:answer/id #uuid "6a9dc5ff-4edd-506a-a106-6d4ea74be127" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186572956}] :answer-field/correct {:answer/id #uuid "6a9dc5ff-4edd-506a-a106-6d4ea74be127" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186572956} :answer-field/id #uuid "7151b114-fe10-5f5b-a6b1-fb98bfff8174" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186573188}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0e7fd5bf-cb04-57ce-b6b4-49eeaabcc873" :question/math-academy-id "q-318003" :question/problem "If $a=3i-5j$ and $b=-4i+7j,$ then $a-b=${{field-1}} $i\\,\\,-$\n{{field-2}} $j.$" :question/worked-solution "To compute $a-b,$ we just need to compute all of the $i$'s and $j$'s, as follows:\n\n$$\n\\begin{aligned}a-b & =(3i-5j)-(-4i+7j) \\\\  & =3i-5j+4i-7j \\\\  & =(3i+4i)+(-5j-7j) \\\\  & =7i-12j\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186573264 :knowledge-point/_questions [{:db/id #edb/ref 17592186059711 :knowledge-point/id #uuid "1735c445-9c97-5aa7-83d6-7dee23993153" :knowledge-point/title "Calculating Sums and Scalar Multiplication of Vectors Using Angle Bracket Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "64131e9b-78e1-584b-be20-2856bcd03c50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186572945}] :answer-field/correct {:answer/id #uuid "64131e9b-78e1-584b-be20-2856bcd03c50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186572945} :answer-field/id #uuid "0469267a-4bb8-524c-9174-68f0ba866a1d" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186573149} {:answer-field/choices [{:answer/id #uuid "377b7ebd-c62e-5588-bc60-ad23a6f3d1a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186572879}] :answer-field/correct {:answer/id #uuid "377b7ebd-c62e-5588-bc60-ad23a6f3d1a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186572879} :answer-field/id #uuid "a5d9a0c8-ed77-516c-8de9-5b17e144d342" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186573208}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "149252a8-4a85-5fa3-b726-083b4624a5d8" :question/math-academy-id "q-318122" :question/problem "If $a=⟨2,-1⟩$ and $b=⟨-1,2⟩$, then $a-b=$$\\,⟨$\n{{field-1}}$\\,,$\n{{field-2}}$⟩.$" :question/worked-solution "To compute $a-b,$ we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}a-b & =⟨2,-1⟩-⟨-1,2⟩ \\\\  & =⟨2-(-1),-1-2⟩ \\\\  & =⟨3,-3⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186573319 :knowledge-point/_questions [{:db/id #edb/ref 17592186059711 :knowledge-point/id #uuid "1735c445-9c97-5aa7-83d6-7dee23993153" :knowledge-point/title "Calculating Sums and Scalar Multiplication of Vectors Using Angle Bracket Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3290ffd6-cd8a-5db9-a4bc-56849cc44a54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186572878}] :answer-field/correct {:answer/id #uuid "3290ffd6-cd8a-5db9-a4bc-56849cc44a54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186572878} :answer-field/id #uuid "4c125323-8ab4-59de-9fc3-25accadfde30" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186573177} {:answer-field/choices [{:answer/id #uuid "47784222-c406-5602-89f9-166ab8dbf072" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186572912}] :answer-field/correct {:answer/id #uuid "47784222-c406-5602-89f9-166ab8dbf072" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186572912} :answer-field/id #uuid "84c301b6-7fb7-52a7-ae5e-3c748146d665" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186573198}] :question/difficulty {:db/id #edb/