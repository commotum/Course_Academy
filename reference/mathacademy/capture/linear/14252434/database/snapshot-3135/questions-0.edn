stion/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5042d60d-1d74-5a97-ae4c-6f45b8b23e98" :question/math-academy-id "q-318151" :question/problem "Let $a=\\begin{bmatrix}-4 \\\\ 1\\end{bmatrix}$, $b=\\begin{bmatrix}3 \\\\ -2\\end{bmatrix}$ and $c=\\begin{bmatrix}-2 \\\\ 7\\end{bmatrix}.$ Find $2b+(-3a+c).$\n\n<table align=\"center\" cellpadding=\"1\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" rowspan=\"2\" width=\"25\">$2b+(-3a+c)=\\,\\,$</td>\n<td align=\"center\" height=\"25\" width=\"2\"></td>\n<td align=\"center\" height=\"25\" width=\"25\">{{field-1}}\n</td>\n<td align=\"center\" height=\"25\" width=\"2\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"25\" width=\"2\"></td>\n<td align=\"center\" height=\"25\" width=\"25\">{{field-2}}\n</td>\n<td align=\"center\" height=\"25\" width=\"2\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "To compute the result, we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}2b+(-3a+c) & =2\\,\\begin{bmatrix}3 \\\\ -2\\end{bmatrix}+(-3\\,\\begin{bmatrix}-4 \\\\ 1\\end{bmatrix}+\\begin{bmatrix}-2 \\\\ 7\\end{bmatrix}) \\\\  & =\\begin{bmatrix}6 \\\\ -4\\end{bmatrix}+(\\begin{bmatrix}12 \\\\ -3\\end{bmatrix}+\\begin{bmatrix}-2 \\\\ 7\\end{bmatrix}) \\\\  & =\\begin{bmatrix}6 \\\\ -4\\end{bmatrix}+\\begin{bmatrix}10 \\\\ 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}16 \\\\ 0\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186573312 :knowledge-point/_questions [{:db/id #edb/ref 17592186059712 :knowledge-point/id #uuid "8a21360f-af5f-5730-85b2-b617de30eaf6" :knowledge-point/title "Calculating Sums and Scalar Multiplication of Column Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56b0dd0c-9d63-5a70-95a6-dd376b0a0954" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186572926}] :answer-field/correct {:answer/id #uuid "56b0dd0c-9d63-5a70-95a6-dd376b0a0954" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186572926} :answer-field/id #uuid "b37d9201-7dcf-5a89-a52b-32dccf01ca00" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186573214} {:answer-field/choices [{:answer/id #uuid "83567ae1-8427-57f7-8486-981e82916dd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-28" :db/id #edb/ref 17592186572994}] :answer-field/correct {:answer/id #uuid "83567ae1-8427-57f7-8486-981e82916dd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-28" :db/id #edb/ref 17592186572994} :answer-field/id #uuid "beab0d67-6115-58a0-9692-4c292e4251e6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186573218}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "df07f0e4-b8c0-55c8-a0ad-afd25f375b3a" :question/math-academy-id "q-318154" :question/problem "Let $a=\\begin{bmatrix}-5 \\\\ 3\\end{bmatrix}$, $b=\\begin{bmatrix}2 \\\\ -4\\end{bmatrix}$ and $c=\\begin{bmatrix}-1 \\\\ 6\\end{bmatrix}.$ Find $\\,4a-(3b-2c).$\n\n<table align=\"center\" cellpadding=\"1\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" rowspan=\"2\" width=\"25\">$4a-(3b-2c)=\\,\\,$</td>\n<td align=\"center\" height=\"25\" width=\"2\"></td>\n<td align=\"center\" height=\"25\" width=\"25\">{{field-1}}\n</td>\n<td align=\"center\" height=\"25\" width=\"2\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"25\" width=\"2\"></td>\n<td align=\"center\" height=\"25\" width=\"25\">{{field-2}}\n</td>\n<td align=\"center\" height=\"25\" width=\"2\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "To compute the result, we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}4a-(3b-2c) & =4\\,\\begin{bmatrix}-5 \\\\ 3\\end{bmatrix}-(3\\,\\begin{bmatrix}2 \\\\ -4\\end{bmatrix}-2\\,\\begin{bmatrix}-1 \\\\ 6\\end{bmatrix}) \\\\  & =\\begin{bmatrix}-20 \\\\ 12\\end{bmatrix}-(\\begin{bmatrix}6 \\\\ -12\\end{bmatrix}-\\begin{bmatrix}-2 \\\\ 12\\end{bmatrix}) \\\\  & =\\begin{bmatrix}-20 \\\\ 12\\end{bmatrix}-\\begin{bmatrix}8 \\\\ -24\\end{bmatrix} \\\\  & =\\begin{bmatrix}-28 \\\\ 36\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186573315 :knowledge-point/_questions [{:db/id #edb/ref 17592186059713 :knowledge-point/id #uuid "fc55e44b-82d0-5145-8a24-d43bc60dc594" :knowledge-point/title "Calculating Sums and Scalar Multiplication of Vectors Given in Alternative Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43933ff3-b395-51e7-8924-620a4c146889" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186572907}] :answer-field/correct {:answer/id #uuid "43933ff3-b395-51e7-8924-620a4c146889" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186572907} :answer-field/id #uuid "b1fda064-c5be-50c8-a2f2-f2d149b07722" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186573212} {:answer-field/choices [{:answer/id #uuid "9c8fa3e0-6c1a-5d67-b34a-c41929e26ae1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186573027}] :answer-field/correct {:answer/id #uuid "9c8fa3e0-6c1a-5d67-b34a-c41929e26ae1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186573027} :answer-field/id #uuid "dbc685a7-f84f-5c19-84d2-5848ae5fa567" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :an