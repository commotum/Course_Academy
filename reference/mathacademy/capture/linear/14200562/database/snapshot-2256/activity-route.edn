#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186518253} :activity/id #uuid "013fe3a7-9b4e-5fe1-9bf4-78ad7af81a4d" :activity/scope {:db/id #edb/ref 17592186048134 :topic/id #uuid "8238e088-d8cf-5b16-b7de-d1a376704040" :topic/math-academy-id 6092} :activity/steps [{:db/id #edb/ref 17592186518253 :step/content {:db/id #edb/ref 17592186213439 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e9100f91-fc1e-5c98-a41b-4ed3a7acfa72" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186210532} {:answer/id #uuid "ed823b62-086b-52e2-9169-be2b4891c218" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186210533} {:answer/id #uuid "f302cf8a-2800-5e54-a999-ea8d52aa8520" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "24" :db/id #edb/ref 17592186210534} {:answer/id #uuid "2d33a223-1b57-5f84-a71f-c47693561011" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14" :db/id #edb/ref 17592186210535} {:answer/id #uuid "6a23987b-c061-59bf-85c0-0f6fd3a3635e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "34" :db/id #edb/ref 17592186210536}] :answer-field/correct {:db/id #edb/ref 17592186210536} :answer-field/id #uuid "4fd7528a-eee1-5d01-b7fb-cfa05b48f0f7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186210531}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6b5a718a-0e39-5107-8c8d-d7ed4a7ca3e6" :question/math-academy-id "q-288053" :question/problem "The equation \n\n$$\n{x}^{2}+ax+b={x}^{2}+10x+24\n$$\n\nis true for all values of $x,$ where $a$ and $b$ are constants. What is the value of $a+b?$" :question/worked-solution "Since the equation is true for all values of $x,$ the expressions on both sides must be exactly the same. That means the coefficients of the matching powers of $x$ must be equal.\n\nLet's compare the coefficients:\n\n- The coefficient of $x$ on the left-hand side is $a,$ and on the right-hand side it is $10.$ So, we have \n\n$$\na=10.\n$$\n\n- The constant term on the left-hand side is $b,$ and on the right-hand side it is $24.$ So, we have \n\n$$\nb=24.\n$$\n\nNow, we compute the sum:\n\n$$\n\\begin{aligned}a+b & =10+24 \\\\  & =34\\end{aligned}\n$$"} :step/id #uuid "4e57b915-7c23-5742-9100-719d0b89ea07" :step/next {:db/id #edb/ref 17592186518315}} {:db/id #edb/ref 17592186518312 :step/content {:db/id #edb/ref 17592186518105 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "190cbee0-7af2-576e-98ad-a582cb732f98" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186517534} {:answer/id #uuid "1bdf64b3-5ded-5be3-9039-ad4566118032" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186517539} {:answer/id #uuid "7a1157a8-572c-5cf4-86f8-7272bd09d639" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186517719} {:answer/id #uuid "924ee794-d6a4-593d-a93d-b2c314a2846d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186517764} {:answer/id #uuid "a181b8a1-35c7-56bc-a5a7-f50443574e45" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186517792}] :answer-field/correct {:db/id #edb/ref 17592186517764} :answer-field/id #uuid "825ec111-8fef-5db1-a9c2-27ab6f1d4b42" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186518032}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "090c9908-d9d1-5e59-8b6d-0af06c1b251a" :question/math-academy-id "q-288455" :question/problem "The equation\n\n$$\n{x}^{2}+ux+v={x}^{2}-x+1\n$$\n\nis true for all values of $x,$ where $u$ and $v$ are constants. What is the value of $u+v?$" :question/worked-solution "Since the equation is true for all values of $x,$ the expressions on both sides must be exactly the same. That means the coefficients of the matching powers of $x$ must be equal.\n\nLet's compare the coefficients:\n\n- The coefficient of $x$ on the left-hand side is $u,$ and on the right-hand side it is $-1.$ So, we have \n\n$$\nu=-1.\n$$\n\n- The constant term on the left-hand side is $v,$ and on the right-hand side it is $1.$ So, we have \n\n$$\nv=1.\n$$\n\nNow, we compute the sum:\n\n$$\n\\begin{aligned}u+v & =-1+1 \\\\  & =0\\end{aligned}\n$$"} :step/id #uuid "eb0762a1-82e2-5ea9-ba93-22a0ea8c9976"} {:db/id #edb/ref 17592186518315 :step/content {:db/id #edb/ref 17592186297188 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33a0ec0e-0617-53dc-ab33-c0b23c91fb6f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-10" :db/id #edb/ref 17592186295559} {:answer/id #uuid "78d3896b-7cc7-55d9-93d6-eb6dd98142c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186295927} {:answer/id #uuid "b29faf52-a539-5828-8e4c-ae2fdf02df18" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186296209} {:answer/id #uuid "b806ba99-6dbd-5acb-9131-b1acf13afbcb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186296231} {:answer/id #uuid "ea97feea-c170-5169-adc6-b127b06a5058" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186296513}] :answer-field/correct {:db/id #edb/ref 17592186296231} :answer-field/id #uuid "bd28e05e-209e-5653-9366-8140063b7d1c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186297026}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ffcc7b45-1246-5e48-a7e0-93379ccd5076" :question/math-academy-id "q-288451" :question/problem "The equation \n\n$$\n{x}^{2}+mx+c={x}^{2}+7x-5\n$$\n\nis true for all values of $x,$ where $m$ and $c$ are constants. What is the value of $m+c?$" :question/worked-solution "Since the equation is true for all values of $x,$ the expressions on both sides must be exactly the same. That means the coefficients of the matching powers of $x$ must be equal.\n\nLet's compare the coefficients:\n\n- The coefficient of $x$ on the left-hand side is $m,$ and on the right-hand side it is $7.$ So, we have \n\n$$\nm=7.\n$$\n\n- The constant term on the left-hand side is $c,$ and on the right-hand side it is $-5.$ So, we have \n\n$$\nc=-5.\n$$\n\nNow, we compute the sum:\n\n$$\n\\begin{aligned}m+c & =7+(-5) \\\\  & =2\\end{aligned}\n$$"} :step/id #uuid "f3b2b462-1f6b-56b5-930b-3e10e7711b0c" :step/next {:db/id #edb/ref 17592186518312}}] :activity/title "Equating Polynomial Coefficients" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186517475}]}
