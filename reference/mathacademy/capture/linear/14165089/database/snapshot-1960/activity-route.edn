#{[{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186489327} :activity/id #uuid "60936641-355a-54ca-910d-83aee7c18376" :activity/scope {:db/id #edb/ref 17592186048594 :topic/id #uuid "acd6ee8f-99a9-566d-947a-0a7133b158e6" :topic/math-academy-id 121} :activity/steps [{:db/id #edb/ref 17592186489297 :step/content {:db/id #edb/ref 17592186489213 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16272320-c6ad-5fc2-84e3-d7dcf4eeabd8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186488519} {:answer/id #uuid "6dbec972-4ca4-5309-baad-353d47f0c0b4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186488685} {:answer/id #uuid "bbb71dd0-6c77-5513-a284-fd4648420655" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-9" :db/id #edb/ref 17592186488847} {:answer/id #uuid "bce6cc9a-4320-5572-bbb9-66f3fdcad111" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186488853} {:answer/id #uuid "e7b1499b-0be4-535d-b32e-31dd5753c545" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3}{32}" :db/id #edb/ref 17592186488954}] :answer-field/correct {:db/id #edb/ref 17592186488847} :answer-field/id #uuid "82dc6c2e-5b62-5fbc-aec5-c5800d42bb69" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186489087}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4b607318-28df-51c2-9737-62f37f3092a8" :question/math-academy-id "q-68934" :question/problem "Evaluate $(-3)\\times ((-8)^{2}\\times \\frac{3}{64}).$" :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nFirst, consider the expression inside the parentheses:\n\n$$\n\\begin{aligned}(-8)^{2}\\times \\frac{3}{64}\\end{aligned}\n$$\n\nApplying PEMDAS to this expression, we obtain:\n\n$$\n\\begin{aligned}(-8)^{2}\\times \\frac{3}{64} & = \\\\ 64\\times \\frac{3}{64} & = \\\\ \\frac{64}{1}\\times \\frac{3}{64} & = \\\\ \\frac{64\\times 3}{1\\times 64} & = \\\\ \\frac{\\cancel{64}\\times 3}{1\\times \\cancel{64}} & = \\\\ 3\\end{aligned}\n$$\n\nTherefore:\n\n$$\n\\begin{aligned}(-3)\\times ((-8)^{2}\\times \\frac{3}{64}) & = \\\\ (-3)\\times 3 & = \\\\ -9\\end{aligned}\n$$"} :step/id #uuid "03c2edcd-575d-58ce-886d-f19883074feb" :step/next {:db/id #edb/ref 17592186489348}} {:db/id #edb/ref 17592186489299 :step/content {:db/id #edb/ref 17592186489199 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a21ccfb8-977e-519c-b897-7af24b809a54" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "64" :db/id #edb/ref 17592186488789}] :answer-field/correct {:db/id #edb/ref 17592186488789} :answer-field/id #uuid "b9b18399-62b8-5129-8be3-3c30ac27453f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186489120}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2d3046f2-721a-5576-97d9-83326a5bfbf0" :question/math-academy-id "q-184056" :question/problem "$(32+(-4)\\times 7)^{3}=${{field-1}}" :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nWe begin by performing the operations inside the parentheses. So, first we multiply $(-4)$ by $7$:\n\n$$\n\\begin{aligned}(32+(-4)\\times 7)^{3} & =(32+(-28))^{3}\\end{aligned}\n$$\n\n \n\nThen, we add the numbers inside the parentheses: \n\n$$\n\\begin{aligned}(32+(-28))^{3} & ={4}^{3}\\end{aligned}\n$$\n\nFinally, we compute the exponent:\n\n$$\n\\begin{aligned}{4}^{3}=64\\end{aligned}\n$$"} :step/id #uuid "11b7515f-341c-51bb-9088-1fd8218d06f4"} {:db/id #edb/ref 17592186489327 :step/content {:db/id #edb/ref 17592186489218 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a709506-d82a-59b7-a2b1-cc2efb6ccd0c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{6}{5}" :db/id #edb/ref 17592186488527} {:answer/id #uuid "27225eb8-4e94-5553-b530-1190a04b98a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{5}{6}" :db/id #edb/ref 17592186488552} {:answer/id #uuid "5b6eb62b-0638-56b2-a12d-831896cfe037" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186488646} {:answer/id #uuid "b2519c59-5675-54f8-9c49-fb9bd709992d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-120" :db/id #edb/ref 17592186488827} {:answer/id #uuid "fb6ce3ab-bbde-5378-b4f8-47c8bd713822" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{120}" :db/id #edb/ref 17592186489005}] :answer-field/correct {:db/id #edb/ref 17592186488552} :answer-field/id #uuid "eb165dbd-4e64-57b9-b591-6886c0a643cc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186489153}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "50989de1-e6f3-5831-87a9-51e32375a2a1" :question/math-academy-id "q-68926" :question/problem "Calculate $(\\frac{2}{5}\\times {(-5)}^{2})÷({(-2)}^{5}-(-20)).$" :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nFirst, we consider the expressions inside each of the parentheses. The first one is.\n\n$$\n\\begin{aligned}\\frac{2}{5}\\times {(-5)}^{2}.\\end{aligned}\n$$\n\nApplying PEMDAS to this expression, we obtain:\n\n$$\n\\begin{aligned}\\frac{2}{5}\\times {(-5)}^{2} & = \\\\ \\frac{2}{5}\\times 25 & = \\\\ \\frac{2}{5}\\times \\frac{25}{1} & = \\\\ \\frac{2\\times 25}{5\\times 1} & = \\\\ \\frac{50}{5} & = \\\\ 10\\end{aligned}\n$$\n\nThe expression inside the second parentheses is.\n\n$$\n\\begin{aligned}{(-2)}^{5}-(-20).\\end{aligned}\n$$\n\nApplying PEMDAS to this expression, we obtain:\n\n$$\n\\begin{aligned}{(-2)}^{5}-(-20) & = \\\\ (-32)+20 & = \\\\ -12\\end{aligned}\n$$\n\nTherefore:\n\n$$\n\\begin{aligned}(\\frac{2}{5}\\times {(-5)}^{2})÷({(-2)}^{5}-(-20)) & = \\\\ 10÷(-12) & = \\\\ \\frac{10}{(-12)} & = \\\\ -\\frac{10}{12} & = \\\\ -\\frac{5}{6}\\end{aligned}\n$$"} :step/id #uuid "721cbfa0-5e23-5864-b656-268c3fc3ca8a" :step/next {:db/id #edb/ref 17592186489297}} {:db/id #edb/ref 17592186489348 :step/content {:db/id #edb/ref 17592186489277 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "042bf7aa-f453-554b-8c1c-4d25f3ca6aa5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "26" :db/id #edb/ref 17592186488477} {:answer/id #uuid "1b0bb6ea-6daf-5ae5-9f0e-14955e246f6c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "13" :db/id #edb/ref 17592186488530} {:answer/id #uuid "9a1ba0f8-6ded-5608-9ea4-cca507a00bf1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "84" :db/id #edb/ref 17592186488779} {:answer/id #uuid "c3d17bdb-b305-55ba-bee9-78cc57d72ba3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "36" :db/id #edb/ref 17592186488866} {:answer/id #uuid "ebc3ccd7-e674-5b7b-9d26-1f88b6ffce11" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "28" :db/id #edb/ref 17592186488966}] :answer-field/correct {:db/id #edb/ref 17592186488966} :answer-field/id #uuid "0bc44f8c-0d27-582d-86af-3b517235127d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186489026}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "dff097a9-6d33-544e-9f71-468162e0a004" :question/math-academy-id "q-100137" :question/problem "Find the value of $3+(-2+7)^{2}.$" :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nWe begin by performing the operations inside the parentheses. So, first we add $(-2)$ to $7$:\n\n$$\n\\begin{aligned}3+(-2+7)^{2} & =3+{5}^{2}\\end{aligned}\n$$\n\n \n\nThen, we compute the exponent:\n\n$$\n\\begin{aligned}3+{5}^{2} & =3+25\\end{aligned}\n$$\n\nFinally, we add the numbers: \n\n$$\n\\begin{aligned}3+25=28\\end{aligned}\n$$"} :step/id #uuid "9e957131-4874-5e4b-ad84-6fb1f2a5f82c" :step/next {:db/id #edb/ref 17592186489299}}] :