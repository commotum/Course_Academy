    "q-134504": {
      "dom_id": "step-q134504",
      "name": "Question 7",
      "problem": "Simplify $\\sqrt[3]{p}+4\\sqrt{p}-6\\sqrt[3]{p}.$",
      "worked_solution": "We can combine the two $\\sqrt[3]{p}$ terms together, but we cannot combine $\\sqrt[3]{p}$ and $\\sqrt{p}$ terms:\n\n$$\n\\begin{aligned}\\sqrt[3]{p}+4\\sqrt{p}-6\\sqrt[3]{p} & = \\\\ 4\\sqrt{p}+\\sqrt[3]{p}-6\\sqrt[3]{p} & = \\\\ 4\\sqrt{p}+(1-6)\\sqrt[3]{p} & = \\\\ 4\\sqrt{p}-5\\sqrt[3]{p} & \\end{aligned}\n$$",
      "calculator_instructions": "",
