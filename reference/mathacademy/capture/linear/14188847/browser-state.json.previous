.8em 0.8em 0.3em\"><mtr><mtd><mn>2</mn><mi>p</mi><msqrt><mi>y</mi></msqrt><mo>−</mo><mi>q</mi><msqrt><mi>y</mi></msqrt></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><mn>2</mn><mi>p</mi><mo>⋅</mo><msqrt><mi>y</mi></msqrt><mo>−</mo><mi>q</mi><mo>⋅</mo><msqrt><mi>y</mi></msqrt></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><mo stretchy=\"false\">(</mo><mn>2</mn><mi>p</mi><mo>−</mo><mi>q</mi><mo stretchy=\"false\">)</mo><msqrt><mi>y</mi></msqrt></mtd><mtd></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
