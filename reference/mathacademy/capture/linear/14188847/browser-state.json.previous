    "q-52394": {
      "dom_id": "step-q52394",
      "name": "Question 1",
      "problem": "$p\\sqrt{x}+q\\sqrt{x}=$",
      "worked_solution": "We can combine the two $\\sqrt{x}$ terms together, as follows:\n\n$$\n\\begin{aligned}p\\sqrt{x}+q\\sqrt{x} & = \\\\ p\\cdot \\sqrt{x}+q\\cdot \\sqrt{x} & = \\\\ (p+q)\\sqrt{x} & \\end{aligned}\n$$",
