3)\\sqrt[3]{a} & = \\\\ 8\\sqrt{a}+12\\sqrt[3]{a} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186180180 :knowledge-point/_questions [{:db/id #edb/ref 17592186179764 :knowledge-point/id #uuid "35580c97-b64e-55a3-b71e-9190dbcac10b" :knowledge-point/title "Simplifying Sums of Radicals Using the Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f829370c-4dbd-5a86-aadf-e393a88dd583" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186178626} {:answer/id #uuid "73a9386c-4b96-529c-8a82-c7219e61ceea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x\\sqrt{5x}" :db/id #edb/ref 17592186178629} {:answer/id #uuid "2aab4d00-4a59-532b-ae36-4832335d301e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4x\\sqrt{5}+x\\sqrt{x}" :db/id #edb/ref 17592186500550} {:answer/id #uuid "51a2289a-f9a9-5068-84bc-9c5f85953461" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8x\\sqrt{5}+x\\sqrt{x}" :db/id #edb/ref 17592186500634} {:answer/id #uuid "8cd0a3f0-00f1-520b-9c34-359a3e5fdad5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x\\sqrt{45}+x\\sqrt{x}-2x\\sqrt{5}" :db/id #edb/ref 17592186500761}] :answer-field/correct {:answer/id #uuid "2aab4d00-4a59-532b-ae36-4832335d301e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4x\\sqrt{5}+x\\sqrt{x}" :db/id #edb/ref 17592186500550} :answer-field/id #uuid "32d1a6c3-5fc3-52c1-b24b-bcb67ac33ee0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186178624}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "93852038-6a90-54a4-b5b0-75d906c1e893" :question/math-academy-id "q-4060" :question/problem "$2x\\sqrt{45}+x\\sqrt{x}-2x\\sqrt{5}=$" :question/worked-solution "We simplify each of the radical terms using the product rule:\n\n$$\n\\begin{aligned}2x\\sqrt{45}+x\\sqrt{x}-2x\\sqrt{5} & = \\\\ 2x\\sqrt{9\\cdot 5}+x\\sqrt{x}-2x\\sqrt{5} & = \\\\ 2x\\sqrt{9}\\cdot \\sqrt{5}+x\\sqrt{x}-2x\\sqrt{5} & = \\\\ 2x\\cdot 3\\sqrt{5}+x\\sqrt{x}-2x\\sqrt{5} & = \\\\ 6x\\sqrt{5}+x\\sqrt{x}-2x\\sqrt{5}\\end{aligned}\n$$\n\nFinally, we combine the like terms:\n\n$$\n\\begin{aligned}6x\\sqrt{5}+x\\sqrt{x}-2x\\sqrt{5} & = \\\\ (6x-2x)\\sqrt{5}+x\\sqrt{x} & = \\\\ 4x\\sqrt{5}+x\\sqrt{x}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186501220 :knowledge-point/_questions [{:db/id #edb/ref 17592186179764 :knowledge-point/id #uuid "35580c97-b64e-55a3-b71e-9190dbcac10b" :knowledge-point/title "Simplifying Sums of Radicals Using the Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09b27bcd-d69a-57ab-86dc-d75b13132e84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21\\sqrt{5b}" :db/id #edb/ref 17592186500485} {:answer/id #uuid "1f89ef35-2105-591f-b568-8c349c6c6c9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\sqrt{57b}" :db/id #edb/ref 17592186500532} {:answer/id #uuid "9f5db809-d03e-58da-aed3-c6e305d1dda2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\sqrt{2b}+12\\sqrt{3b}" :db/id #edb/ref 17592186500792} {:answer/id #uuid "ac618e26-1e71-53d5-a4e7-3fc20e2dddd1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\sqrt{3b}+12\\sqrt{2b}" :db/id #edb/ref 17592186500821} {:answer/id #uuid "e4655460-2e07-5417-ac02-40b55cc4b8d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{2b}+5\\sqrt{3b}" :db/id #edb/ref 17592186500952}] :answer-field/correct {:answer/id #uuid "9f5db809-d03e-58da-aed3-c6e305d1dda2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\sqrt{2b}+12\\sqrt{3b}" :db/id #edb/ref 17592186500792} :answer-field/id #uuid "f67f46d2-fe1c-5104-9d61-69319280e867" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501128}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bcc2a2a2-83b1-5938-a74c-5f79d37321a4" :question/math-academy-id "q-4062" :question/problem "$3\\sqrt{18b}+3\\sqrt{12b}+2\\sqrt{27b}=$" :question/worked-solution "We simplify each of the radical terms using the product rule:\n\n$$\n\\begin{aligned}3\\sqrt{18b}+3\\sqrt{12b}+2\\sqrt{27b} & = \\\\ 3\\sqrt{9\\cdot 2b}+3\\sqrt{4\\cdot 3b}+2\\sqrt{9\\cdot 3b} & = \\\\ 3\\sqrt{9}\\cdot \\sqrt{2b}+3\\sqrt{4}\\cdot \\sqrt{3b}+2\\sqrt{9}\\cdot \\sqrt{3b} & = \\\\ 3\\cdot 3\\cdot \\sqrt{2b}+3\\cdot 2\\cdot \\sqrt{3b}+2\\cdot 3\\cdot \\sqrt{3b} & = \\\\ 9\\sqrt{2b}+6\\sqrt{3b}+6\\sqrt{3b} & \\end{aligned}\n$$\n\nFinally, we combine the like terms:\n\n$$\n\\begin{aligned}9\\sqrt{2b}+6\\sqrt{3b}+6\\sqrt{3b} & = \\\\ 9\\sqrt{2b}+(6+6)\\sqrt{3b} & = \\\\ 9\\sqrt{2b}+12\\sqrt{3b} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186501137 :knowledge-point/_questions [{:db/id #edb/ref 17592186179763 :knowledge-point/id #uuid "477301de-0888-5f46-84cc-5b2939516e7b" :knowledge-point/title "Simplifying Expressions Containing Radicals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25d10642-3f32-5349-83fc-e6491cc2d7d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q" :db/id #edb/ref 17592186500541} {:answer/id #uuid "a45a06ff-3e53-5c5d-9d54-bac4613fd44b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(p+q)x" :db/id #edb/ref 17592186500798} {:answer/id #uuid "a596a05b-b96c-562c-ac17-a124fcdf385a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.typ