#{[{:db/id #edb/ref 17592186179463 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186179763 :knowledge-point/id #uuid "477301de-0888-5f46-84cc-5b2939516e7b" :knowledge-point/title "Simplifying Expressions Containing Radicals"}] :question/id #uuid "13f8fdac-32c2-5f2a-a818-cde14e59299e" :question/math-academy-id "e-1373" :question/problem "Simplify $9\\sqrt{p - 4} - 7\\sqrt{p - 4} .$" :question/worked-solution "We can combine the two $\\sqrt{p - 4}$ terms together, as follows:\n\n$$\n\\begin{aligned}9\\sqrt{p-4}-7\\sqrt{p-4} & = \\\\ (9-7)\\sqrt{p-4} & = \\\\ 2\\sqrt{p-4} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186179464 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186179764 :knowledge-point/id #uuid "35580c97-b64e-55a3-b71e-9190dbcac10b" :knowledge-point/title "Simplifying Sums of Radicals Using the Product Rule"}] :question/id #uuid "eb35e7da-e6d0-5811-a2ee-92390f71c5f7" :question/math-academy-id "e-1374" :question/problem "Simplify $\\sqrt{12x}-\\sqrt{27x}.$" :question/worked-solution "We simplify each of the radical terms using the product rule:\n\n$$\n\\begin{aligned}\\sqrt{12x}-\\sqrt{27x} & = \\\\ \\sqrt{4\\cdot 3x}-\\sqrt{9\\cdot 3x} & = \\\\ \\sqrt{4}\\cdot \\sqrt{3x}-\\sqrt{9}\\cdot \\sqrt{3x} & = \\\\ 2\\cdot \\sqrt{3x}-3\\cdot \\sqrt{3x} & = \\\\ 2\\sqrt{3x}-3\\sqrt{3x}\\end{aligned}\n$$\n\nFinally, we combine like terms:\n\n$$\n\\begin{aligned}2\\sqrt{3x}-3\\sqrt{3x} & = \\\\ (2-3)\\cdot \\sqrt{3x} & = \\\\ (-1)\\cdot \\sqrt{3x} & = \\\\ -\\sqrt{3x}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186179619 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186179751 :knowledge-point/id #uuid "79a1c2e0-4183-58c6-ac88-0a4856b751a2" :knowledge-point/title "Simplifying Sums of Radicals with Cube Roots"}] :question/id #uuid "213ad0ee-813b-5a4b-8926-5fbd1aed4906" :question/math-academy-id "e-9723" :question/problem "Simplify $10\\sqrt[3]{y} + 2\\sqrt[3]{y} - 7\\sqrt{y}.$" :question/worked-solution "We can combine the two $\\sqrt[3]{y}$ terms together, but we cannot combine the $\\sqrt[3]{y}$ and $\\sqrt{y}$ terms:\n\n$$\n\\eqalign{\n\t\t10\\sqrt[3]{y} + 2\\sqrt[3]{y} - 7\\sqrt{y} &= \\[5pt]\n\t\t(10 + 2)\\sqrt[3]{y} - 7\\sqrt{y} &= \\[5pt]\n\t\t12\\sqrt[3]{y}-7\\sqrt{y} &\n\t}\n$$"}] [{:db/id #edb/ref 17592186501140 :knowledge-point/_questions [{:db/id #edb/ref 17592186179751 :knowledge-point/id #uuid "79a1c2e0-4183-58c6-ac88-0a4856b751a2" :knowledge-point/title "Simplifying Sums of Radicals with Cube Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fee27c5-65e3-596c-92c8-4162ad079fb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{p}-5\\sqrt[3]{p}" :db/id #edb/ref 17592186500501} {:answer/id #uuid "2c27b2f1-36dd-5430-a493-ff6a014ae9b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt[3]{p}" :db/id #edb/ref 17592186500558} {:answer/id #uuid "3a1a81c7-f1e5-5830-91a9-9aede4bd40aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{p}+6\\sqrt[3]{p}" :db/id #edb/ref 17592186500583} {:answer/id #uuid "5bc8c704-d1c4-59fd-a6c2-bf73a1a9ea59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{p}" :db/id #edb/ref 17592186500656} {:answer/id #uuid "61e5f9d5-ceea-58e8-8b94-2e31f14539f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\sqrt{p}-6\\sqrt[3]{p}" :db/id #edb/ref 17592186500670}] :answer-field/correct {:answer/id #uuid "0fee27c5-65e3-596c-92c8-4162ad079fb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{p}-5\\sqrt[3]{p}" :db/id #edb/ref 17592186500501} :answer-field/id #uuid "f877f913-f3d5-5963-b845-f4d71f87b43c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501130}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "09941e60-aba3-5a69-ab9a-c50e221cd8d0" :question/math-academy-id "q-134504" :question/problem "Simplify $\\sqrt[3]{p}+4\\sqrt{p}-6\\sqrt[3]{p}.$" :question/worked-solution "We can combine the two $\\sqrt[3]{p}$ terms together, but we cannot combine $\\sqrt[3]{p}$ and $\\sqrt{p}$ terms:\n\n$$\n\\begin{aligned}\\sqrt[3]{p}+4\\sqrt{p}-6\\sqrt[3]{p} & = \\\\ 4\\sqrt{p}+\\sqrt[3]{p}-6\\sqrt[3]{p} & = \\\\ 4\\sqrt{p}+(1-6)\\sqrt[3]{p} & = \\\\ 4\\sqrt{p}-5\\sqrt[3]{p} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186501203 :knowledge-point/_questions [{:db/id #edb/ref 17592186179751 :knowledge-point/id #uuid "79a1c2e0-4183-58c6-ac88-0a4856b751a2" :knowledge-point/title "Simplifying Sums of Radicals with Cube Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b2b8404-6210-5633-8b09-63f13a00d71b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{q}" :db/id #edb/ref 17592186500552} {:answer/id #uuid "528ae977-d06b-5c6e-9c5a-f9b69e895a8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt[3]{q}" :db/id #edb/ref 17592186500637} {:answer/id #uuid "a63a6e70-5841-5920-be18-141632aa45e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\sqrt[3]{q}-2\\sqrt{q}" :db/id #edb/ref 17592186500810} {:answer/id #uuid "e0a4d7e2-717f-59ea-b8b6-591fcebb1d42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt[3]{q}+4\\sqrt{q}" :db/id #edb/ref 17592186500942} {:answer/id #uuid "e4335664-d920-5a4b-a640-c4944143fa22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt[3]{q}+2\\sqrt{q}" :db/id #edb/ref 17592186500951}] :answer-field/correct {:answer/id #uuid "a63a6e70-5841-5920-be18-141632aa45e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\sqrt[3]{q}-2\\sqrt{q}" :db/id #edb/ref 17592186500810} :answer-field/id #uuid "c53cc0e1-da9e-551f-a889-af2f14ce3458" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501108}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a6334648-97e7-5622-8a2d-3ac7b05ed9c2" :question/math-academy-id "q-134505" :question/problem "$3\\sqrt[3]{q}-4\\sqrt{q}+2\\sqrt[3]{q}+2\\sqrt{q}=$" :question/worked-solution "We can combine the two $\\sqrt[3]{q}$ terms together, and the two $\\sqrt{q}$ terms together:\n\n$$\n\\begin{aligned}3\\sqrt[3]{q}-4\\sqrt{q}+2\\sqrt[3]{q}+2\\sqrt{q} & = \\\\ 3\\sqrt[3]{q}+2\\sqrt[3]{q}-4\\sqrt{q}+2\\sqrt{q} & = \\\\ (3+2)\\sqrt[3]{q}+(-4+2)\\sqrt{q} & = \\\\ 5\\sqrt[3]{q}-2\\sqrt{q} & \\end{aligned}\n$$\n\nNotice that we cannot combine the $\\sqrt[3]{q}$ and $\\sqrt{q}$ terms."}] [{:db/id #edb/ref 17592186501180 :knowledge-point/_questions [{:db/id #edb/ref 17592186179751 :knowledge-point/id #uuid "79a1c2e0-4183-58c6-ac88-0a4856b751a2" :knowledge-point/title "Simplifying Sums of Radicals with Cube Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6578d9db-a288-52f9-a467-0b0d762ddb26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5t\\sqrt[3]{2{t}^{2}}" :db/id #edb/ref 17592186500679} {:answer/id #uuid "9e49f226-05e2-5fa3-9a9a-fc0c384b82cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t(t+2)\\sqrt[3]{2{t}^{2}}" :db/id #edb/ref 17592186500788} {:answer/id #uuid "dbf1a99b-f93a-5240-a156-32a1ef9fc430" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2t+3)\\sqrt[3]{2{t}^{2}}" :db/id #edb/ref 17592186500936} {:answer/id #uuid "f3172cb9-844c-5b93-8c38-158577da8e24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.t