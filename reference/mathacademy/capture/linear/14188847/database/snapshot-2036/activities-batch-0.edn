#{[{:activity/expected-seconds 480.0 :activity/first-step {:db/id #edb/ref 17592186180522} :activity/id #uuid "847ae41b-99e9-5c25-94db-a091578bf000" :activity/scope {:db/id #edb/ref 17592186048138 :topic/id #uuid "8277b645-964a-5702-acc5-193fe49612d2" :topic/math-academy-id 3756} :activity/steps [{:db/id #edb/ref 17592186180522 :step/content {:db/id #edb/ref 17592186180739 :tutorial/content "When dealing with sums or differences of square roots, we can combine any terms with the same algebraic expression under the square root symbol $\\sqrt{\\phantom 0}.$ This is similar to collecting like terms in a linear expression.\n\nFor example, consider the following expression:\n\n$$\n5\\sqrt{x} - 3\\sqrt{x}\n$$\n\nWe can simplify our expression by combining the two radicals, as follows:\n\n$$\n\\begin{aligned}5\\sqrt{x}-3\\sqrt{x} & = \\\\ (5-3)\\sqrt{x} & = \\\\ 2\\sqrt{x} & \\end{aligned}\n$$\n\nWe *cannot* combine terms when the expressions under the radical are different. For example, the expression\n\n$$\n5\\sqrt{x} - 3\\sqrt{y}\n$$\n\ncannot be simplified because there is no way of combining $\\sqrt x$ and $\\sqrt y.$" :tutorial/id #uuid "deda60a8-4b35-50ac-a71c-d3f884aa8e1d" :tutorial/math-academy-id 5971 :tutorial/title "Introduction"} :step/id #uuid "9e6999c1-79fe-5006-91df-3c25468791e3" :step/math-academy-id 36452 :step/next {:db/id #edb/ref 17592186180549}} {:db/id #edb/ref 17592186180523 :step/content {:db/id #edb/ref 17592186179751 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179619 :question/id #uuid "213ad0ee-813b-5a4b-8926-5fbd1aed4906" :question/math-academy-id "e-9723"} :knowledge-point/id #uuid "79a1c2e0-4183-58c6-ac88-0a4856b751a2" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048170}] :knowledge-point/questions [{:db/id #edb/ref 17592186180162} {:db/id #edb/ref 17592186180179} {:db/id #edb/ref 17592186501140} {:db/id #edb/ref 17592186501154} {:db/id #edb/ref 17592186501180} {:db/id #edb/ref 17592186501203}] :knowledge-point/title "Simplifying Sums of Radicals with Cube Roots"} :step/id #uuid "145c40ab-6bce-539c-acfa-6819834eff82" :step/math-academy-id 36453} {:db/id #edb/ref 17592186180536 :step/content {:db/id #edb/ref 17592186180749 :tutorial/content "Recall that the product rule for radicals states that\n\n$$\n\\sqrt{a\\cdot b} = \\sqrt{a}\\cdot \\sqrt{b}\n$$\n\nwhere $a$ and $b$ are nonnegative.\n\nWe can use the product rule for radicals to simplify some expressions. Let's see an example." :tutorial/id #uuid "30549c94-702e-5e00-8cdc-4a050a34243f" :tutorial/math-academy-id 6012 :tutorial/title "The Product Rule for Radicals"} :step/id #uuid "e61e6895-553c-5528-9f47-4ce31a87b2fc" :step/math-academy-id 36694 :step/next {:db/id #edb/ref 17592186180550}} {:db/id #edb/ref 17592186180537 :step/content {:db/id #edb/ref 17592186180750 :tutorial/content "We can simplify cube root expressions in the same way as with square roots.\n\nFor example, consider the following expression:\n\n$$\n4\\sqrt[3]x - 2\\sqrt[3] x\n$$\n\nWe can simplify our expression by combining the two radicals, as follows:\n\n$$\n\\begin{aligned}4\\sqrt[3]{x}-2\\sqrt[3]{x} & = \\\\ (4-2)\\sqrt[3]{x} & = \\\\ 2\\sqrt[3]{x} & \\end{aligned}\n$$\n\n \n\nAs with square roots, we *cannot* combine terms when the expressions under the radical are different. For example, the expression\n\n$$\n\\sqrt[3]{x-1} + \\sqrt[3]{x+1}\n$$\n\ncannot be simplified because there is no way of combining $\\sqrt[3]{x-1}$ and $\\sqrt[3]{x+1}.$\n\nFinally, it is not possible to combine square root and cube root terms, even if the numbers under the radical symbol are the same! For example, the expression\n\n$$\n2\\sqrt x + \\sqrt[3] x\n$$\n\ncannot be simplified because there is no way of combining $\\sqrt x$ and $\\sqrt[3] x.$" :tutorial/id #uuid "a4a25921-e2bd-5bf7-99ed-3a8dd852fb70" :tutorial/math-academy-id 6013 :tutorial/title "Simplifying Expressions with Cube Roots"} :step/id #uuid "9ed96a02-bacb-559e-9bf4-ebf7f568ed2f" :step/math-academy-id 36695 :step/next {:db/id #edb/ref 17592186180523}} {:db/id #edb/ref 17592186180549 :step/content {:db/id #edb/ref 17592186179763 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179463 :question/id #uuid "13f8fdac-32c2-5f2a-a818-cde14e59299e" :question/math-academy-id "e-1373"} :knowledge-point/id #uuid "477301de-0888-5f46-84cc-5b2939516e7b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050341} {:db/id #edb/ref 17592186050452}] :knowledge-point/questions [{:db/id #edb/ref 17592186180214} {:db/id #edb/ref 17592186180215} {:db/id #edb/ref 17592186501137} {:db/id #edb/ref 17592186501209}] :knowledge-point/title "Simplifying Expressions Containing Radicals"} :step/id #uuid "402d2fd6-c005-5674-be33-360f1b1762d7" :step/math-academy-id 4334 :step/next {:db/id #edb/ref 17592186180536}} {:db/id #edb/ref 17592186180550 :step/content {:db/id #edb/ref 17592186179764 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179464 :question/id #uuid "eb35e7da-e6d0-5811-a2ee-92390f71c5f7" :question/math-academy-id "e-1374"} :knowledge-point/id #uuid "35580c97-b64e-55a3-b71e-9190dbcac10b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050496}] :knowledge-point/questions [{:db/id #edb/ref 17592186179916} {:db/id #edb/ref 17592186180180} {:db/id #edb/ref 17592186501220}] :knowledge-point/title "Simplifying Sums of Radicals Using the Product Rule"} :step/id #uuid "e9871c72-8aa0-5596-948e-55a61792f893" :step/math-academy-id 4336 :step/next {:db/id #edb/ref 17592186180537}}] :activity/title "Adding and Subtracting Radical Expressions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186179899}]}
