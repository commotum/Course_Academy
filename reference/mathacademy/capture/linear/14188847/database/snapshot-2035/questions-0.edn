#{[{:db/id #edb/ref 17592186179463 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186179763 :knowledge-point/id #uuid "477301de-0888-5f46-84cc-5b2939516e7b" :knowledge-point/title "Simplifying Expressions Containing Radicals"}] :question/id #uuid "13f8fdac-32c2-5f2a-a818-cde14e59299e" :question/math-academy-id "e-1373" :question/problem "Simplify $9\\sqrt{p - 4} - 7\\sqrt{p - 4}$." :question/worked-solution "We can combine the two $\\sqrt{p - 4}$ terms together, as follows:\n\n$$\n\\begin{aligned}\n9\\sqrt{p - 4} - 7\\sqrt{p - 4} &=  \\\\\n(9 - 7)\\sqrt{p - 4} &=  \\\\\n&= 2\\sqrt{p - 4}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186179464 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186179764 :knowledge-point/id #uuid "35580c97-b64e-55a3-b71e-9190dbcac10b" :knowledge-point/title "Simplifying Sums of Radicals Using the Product Rule"}] :question/id #uuid "eb35e7da-e6d0-5811-a2ee-92390f71c5f7" :question/math-academy-id "e-1374" :question/problem "Simplify $\\sqrt{12x}-\\sqrt{27x}$." :question/worked-solution "We simplify each of the radical terms using the product rule:\n\n$$\n\\begin{aligned}\n\\sqrt{12x} - \\sqrt{27x} &=  \\\\\n\\sqrt{4 \\cdot 3x} - \\sqrt{9 \\cdot 3x} &=  \\\\\n\\sqrt{4} \\cdot \\sqrt{3x} - \\sqrt{9} \\cdot \\sqrt{3x} &=  \\\\\n2 \\cdot \\sqrt{3x} - 3 \\cdot \\sqrt{3x} &=  \\\\\n&= 2\\sqrt{3x} - 3\\sqrt{3x}\n\\end{aligned}\n$$\n\nFinally, we combine like terms:\n\n$$\n\\begin{aligned}\n2\\sqrt{3x} - 3\\sqrt{3x} &=  \\\\\n(2 - 3) \\cdot \\sqrt{3x} &=  \\\\\n(-1) \\cdot \\sqrt{3x} &=  \\\\\n&= - \\sqrt{3x}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186179619 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186179751 :knowledge-point/id #uuid "79a1c2e0-4183-58c6-ac88-0a4856b751a2" :knowledge-point/title "Simplifying Sums of Radicals with Cube Roots"}] :question/id #uuid "213ad0ee-813b-5a4b-8926-5fbd1aed4906" :question/math-academy-id "e-9723" :question/problem "Simplify $10\\sqrt[3]{y} + 2\\sqrt[3]{y} - 7\\sqrt{y}$." :question/worked-solution "We can combine the two $\\sqrt[3]{y}$ terms together, but we cannot combine the $\\sqrt[3]{y}$ and $\\sqrt{y}$ terms:\n\n$$\n\\begin{aligned} 10\\sqrt[3]{y} + 2\\sqrt[3]{y} - 7\\sqrt{y} \\\\[5pt] &= (10 + 2)\\sqrt[3]{y} - 7\\sqrt{y} \\\\[5pt] &= 12\\sqrt[3]{y}-7\\sqrt{y} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186180180 :knowledge-point/_questions [{:db/id #edb/ref 17592186179764 :knowledge-point/id #uuid "35580c97-b64e-55a3-b71e-9190dbcac10b" :knowledge-point/title "Simplifying Sums of Radicals Using the Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "955375ad-805e-5f5b-a0d4-a29d95894328" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8x\\sqrt{5} + x\\sqrt{x}" :db/id #edb/ref 17592186178625} {:answer/id #uuid "f829370c-4dbd-5a86-aadf-e393a88dd583" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186178626} {:answer/id #uuid "1b5c281c-87c3-589f-9c1a-8520299df1ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4x\\sqrt{5} + x\\sqrt{x}" :db/id #edb/ref 17592186178627} {:answer/id #uuid "6bbc83a2-3a42-525f-880a-f186e0c5a66f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x\\sqrt{45} + x\\sqrt{x} - 2x\\sqrt{5}" :db/id #edb/ref 17592186178628} {:answer/id #uuid "73a9386c-4b96-529c-8a82-c7219e61ceea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x\\sqrt{5x}" :db/id #edb/ref 17592186178629}] :answer-field/id #uuid "32d1a6c3-5fc3-52c1-b24b-bcb67ac33ee0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186178624}] :question/id #uuid "93852038-6a90-54a4-b5b0-75d906c1e893" :question/math-academy-id "q-4060" :question/problem "What is $2x\\sqrt{45} + x\\sqrt{x} - 2x\\sqrt{5}$?"}]}
