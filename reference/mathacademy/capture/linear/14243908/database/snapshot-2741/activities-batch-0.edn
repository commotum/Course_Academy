able Coefficients"} :step/id #uuid "ea96e969-a594-52d8-a7bc-fe570264819e" :step/math-academy-id 464649}] :activity/title "The Magnitude of a Complex Number" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186054896}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186515664} :activity/id #uuid "f464d2cc-f0ba-5134-8a71-a42676f27b5c" :activity/scope {:db/id #edb/ref 17592186049831 :topic/id #uuid "1726eb44-d776-5df6-8797-69b129ad3167" :topic/math-academy-id 34} :activity/steps [{:db/id #edb/ref 17592186515664 :step/content {:db/id #edb/ref 17592186515604 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4240242c-ccfc-5919-bcd1-23f365cf0d9c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-13" :db/id #edb/ref 17592186515012} {:answer/id #uuid "5fc877af-90aa-504b-aeaa-80f58a1269ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\sqrt{13}" :db/id #edb/ref 17592186515080} {:answer/id #uuid "81fce244-4b65-5986-bf17-3c08a29adf62" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{13}" :db/id #edb/ref 17592186515142} {:answer/id #uuid "9313ceb2-8065-5a51-8891-b63edaff61bb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "13" :db/id #edb/ref 17592186515181} {:answer/id #uuid "e910e0d2-e229-5e15-aa4e-2cbc5871b5be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{-13}" :db/id #edb/ref 17592186515363}] :answer-field/correct {:db/id #edb/ref 17592186515181} :answer-field/id #uuid "fea1f402-87f7-543c-a08b-8028f822c3a1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186515515}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d1878d53-723f-5989-b8bc-003976423212" :question/math-academy-id "q-70258" :question/problem "What is the magnitude of the number $z=-13\\text{i}?$" :question/worked-solution "The imaginary number $-13\\text{i}$ is equivalent to the complex number $z=0-13\\text{i}.$\n\nWe know that for a complex number $z=a+b\\text{i},$ the magnitude of $z$ is given by\n\n$$\n|z|=\\sqrt{{a}^{2}+{b}^{2}}.\n$$\n\nSo, the magnitude of $z=0-13\\text{i}$ is given by\n\n$$\n\\begin{aligned}|z| & =\\sqrt{{a}^{2}+{b}^{2}} \\\\  & =\\sqrt{(0)^{2}+(-13)^{2}} \\\\  & =13.\\end{aligned}\n$$"} :step/id #uuid "7220f931-8523-5f49-b4d1-5a8977c89c7b" :step/next {:db/id #edb/ref 17592186515678}} {:db/id #edb/ref 17592186515678 :step/content {:db/id #edb/ref 17592186515521 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "336f253c-9736-520b-8fb7-d41987f37473" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{x}^{2}+4{c}^{2}" :db/id #edb/ref 17592186514987} {:answer/id #uuid "58e24837-7d55-5cdf-a839-e3afda08636c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{4{x}^{2}-16{c}^{2}}" :db/id #edb/ref 17592186515072} {:answer/id #uuid "7989544f-7ea6-5b3b-8e3c-3231d82c6955" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{4{x}^{2}+16{c}^{2}}" :db/id #edb/ref 17592186515125} {:answer/id #uuid "8b810d0d-88c0-5a8f-aeca-ac3055abcc67" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2{x}^{2}+4{c}^{2}}" :db/id #edb/ref 17592186515165} {:answer/id #uuid "d4f229fc-d9e2-5832-9150-33c974b452ba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2{x}^{2}-4{c}^{2}}" :db/id #edb/ref 17592186515317}] :answer-field/correct {:db/id #edb/ref 17592186515125} :answer-field/id #uuid "17b8dedc-9dc9-5851-973e-6ace85b1c419" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186515415}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "08d92dcc-49dd-5acf-9195-6229900ba610" :question/math-academy-id "q-79466" :question/problem "Find $|z|$ if $z=2x+4c\\text{i},$ where $x$ and $c$ are real numbers." :question/worked-solution "For a complex number $z=a+b\\text{i},$ the magnitude of $z$ is given by\n\n$$\n|z|=\\sqrt{{a}^{2}+{b}^{2}}.\n$$\n\nFor the complex number $z=2x+4c\\text{i},$ we have $a=2x$ and $b=4c.$ So, the magnitude is given by\n\n$$\n\\begin{aligned}\\begin{aligned}|2x+4c\\text{i}| & =\\sqrt{(2x)^{2}+(4c)^{2}} \\\\  & =\\sqrt{4{x}^{2}+16{c}^{2}}.\\end{aligned}\\end{aligned}\n$$"} :step/id #uuid "a5133add-db8f-51c9-ba6d-cd7cde437126" :step/next {:db/id #edb/ref 17592186515680}} {:db/id #edb/ref 17592186515680 :step/content {:db/id #edb/ref 17592186515596 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "008a9322-bc09-5270-b395-42f5ae02f992" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186514873} {:answer/id #uuid "2370feff-0720-50c4-8b43-d0d1aab5431b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186514956} {:answer/id #uuid "8ef6c697-69ee-5d21-b15c-a353586495fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186515175} {:answer/id #uuid "ab0f6764-317d-5061-9f80-de4f98c14068" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186515231} {:answer/id #uuid "eb76ce3d-4469-58f1-ae4b-06566734b7f8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186515369}] :answer-field/correct {:db/id #edb/ref 17592186515231} :answer-field/id #uuid "35aa10d9-d0b5-5bf2-a319-9f587b8c0a83" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186515429}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c3ed3524-1800-5472-a34a-a2b28ed462d4" :question/math-academy-id "q-160277" :question/problem "What is the magnitude of the number $z=2\\text{i}?$" :question/worked-solution "The imaginary number $2\\text{i}$ is equivalent to the complex number $z=0+2\\text{i}.$\n\nWe know that for a complex number $z=a+b\\text{i},$ the magnitude of $z$ is given by\n\n$$\n|z|=\\sqrt{{a}^{2}+{b}^{2}}.\n$$\n\nSo, the magnitude of $z=0+2\\text{i}$ is given by\n\n$$\n\\begin{aligned}|z| & =\\sqrt{{a}^{2}+{b}^{2}} \\\\  & =\\sqrt{(0)^{2}+(2)^{2}} \\\\  & =2.\\end{aligned}\n$$"} :step/id #uuid "a94f0ad1-2aea-563c-ab9b-921184c576f7"}] :activity/title "The Magnitude of a Complex Number" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186514868}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186544926} :activity/id #uuid "582cf0be-b649-5c80-ab83-11d8d6de800e" :activity/scope {:db/id #edb/ref 17592186049831 :topic/id #uuid "1726eb44-d776-5df6-8797-69b129ad3167" :topic/math-academy-id 34} :activity/steps [{:db/id #edb/ref 17592186544926 :step/content {:db/id #edb/ref 17592186055513 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15acad6a-1588-50dc-884b-0bc494d8457f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{{c}^{2}+{d}^{2}}" :db/id #edb/ref 17592186544132} {:answer/id #uuid "854035a8-ed0e-5bd3-9e72-e2d04380d94d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{{c}^{2}-{d}^{2}}" :db/id #edb/ref 17592186544375} {:answer/id #uuid "98affaef-6797-5eee-a74c-fa5d61288f53" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{c-d}" :db/id #edb/ref 17592186544419} {:answer/id #uuid "b58e593b-db73-5134-8433-9704c2af763a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{c+d}" :db/id #edb/ref 17592186544470} {:answer/id #uuid "dd2ae299-d491-5962-8c63-b8d3103f30bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{{c}^{2}}\\sqrt{{d}^{2}}" :db/id #edb/ref 17592186544563}] :answer-field/correct {:db/id #edb/ref 17592186544132} :answer-field/id #uuid "3986505e-1ad4-514c-9a76-d29a84124f71" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186054315}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1234cf5e-bc44-54a6-aa08-551f55b5254e" :question/math-academy-id "q-904" :question/problem "Find $|z|$ if $z=-c-d\\text{i},$ where $c$ and $d$ are real numbers." :question/worked-solution "For a complex number $z=a+b\\text{i},$ the magnitude of $z$ is given by\n\n$$\n|z|=\\sqrt{{a}^{2}+{b}^{2}}.\n$$\n\nFor the complex number $z=-c-d\\text{i},$ we have $a=-c$ and $b=-d.$ So, the magnitude is given by\n\n$$\n\\begin{aligned}\\begin{aligned}|-c-d\\text{i}| & =\\sqrt{(-c)^{2}+(-d)^{2}} \\\\  & =\\sqrt{{c}^{2}+{d}^{2}}.\\end{aligned}\\end{aligned}\n$$"} :step/id #uuid "4e4d1882-3af3-542b-a0de-5d934be9d250" :step/next {:db/id #edb/ref 17592186544967}} {:db/id #edb/ref 17592186544967 :step/content {:db/id #edb/ref 17592186544810 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20fcdb42-91ca-575f-b2d7-0e66f5434d4c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186544162} {:answer/id #uuid "57c8a3b4-8173-5938-b698-2abfcad48518" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186544281} {:answer/id #uuid "803a45f2-870d-54d9-83cb-ae54be25ca4f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18" :db/id #edb/ref 17592186544368} {:answer/id #uuid "901f0f8f-ae86-5446-bb09-058c84094a71" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186544403} {:answer/id #uuid "baa275e2-b6b5-5efe-92e8-68e43ce68a9f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3\\sqrt{2}" :db/id #edb/ref 17592186544485}] :answer-field/correct {:db/id #edb/ref 17592186544281} :answer-field/id #uuid "700c44b0-518b-5383-9cc4-49a4e33ab23a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186544705}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "407ccba6-df92-5ced-bae5-a0584a2e9a9b" :question/math-academy-id "q-70259" :question/problem "What is the magnitude of the number $z=3\\sqrt{2}\\,\\text{i}?$" :question/worked-solution "The imaginary number $3\\sqrt{2}\\,\\text{i}$ is equivalent to the complex number $z=0+3\\sqrt{2}\\,\\text{i}.$\n\nWe know that for a complex number $z=a+b\\text{i},$ the magnitude of $z$ is given by\n\n$$\n|z|=\\sqrt{{a}^{2}+{b}^{2}}.\n$$\n\nSo, the magnitude of $z=0+3\\sqrt{2}\\,\\text{i}$ is given by\n\n$$\n\\begin{aligned}|z| & =\\sqrt{{a}^{2}+{b}^{2}} \\\\  & =\\sqrt{(0)^{2}+(3\\sqrt{2})^{2}} \\\\  & =3\\sqrt{2}.\\end{aligned}\n$$"} :step/id #uuid "bf91d901-c429-5294-8b90-ff69ad18fb15" :step/next {:db/id #edb/ref 17592186544971}} {:db/id #edb/ref 17592186544971 :step/content {:db/id #edb/ref 17592186544890 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "297edda3-9036-5d3f-841d-95794066b68e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186544182} {:answer/id #uuid "6fdb107c-f069-5a3f-b408-4442f17dca80" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3\\sqrt{3}" :db/id #edb/ref 17592186544336} {:answer/id #uuid "d488e77f-965b-5239-a2f4-9c5c6fd27700" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-9" :db/id #edb/ref 17592186544539} {:answer/id #uuid "f69636d0-b0c4-52be-8443-48117c693451" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\sqrt{3}" :db/id #edb/ref 17592186544625} {:answer/id #uuid "fa74a01a-75f7-5f19-9147-121c4a1a9617" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186544633}] :answer-field/correct {:db/id #edb/ref 17592186544182} :answer-field/id #uuid "82433c6e-f90d-5505-9496-d2c147d30d79" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186544712}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e440f356-fb13-5144-832e-aba59bbee006" :question/math-academy-id "q-160280" :question/problem "What is the magnitude of the number $z=-9\\text{i}?$" :question/worked-solution "The imaginary number $-9\\text{i}$ is equivalent to the complex number $z=0-9\\text{i}.$\n\nWe know that for a complex number $z=a+b\\text{i},$ the magnitude of $z$ is given by\n\n$$\n|z|=\\sqrt{{a}^{2}+{b}^{2}}.\n$$\n\nSo, the magnitude of $z=0-9\\text{i}$ is given by\n\n$$\n\\begin{aligned}|z| & =\\sqrt{{a}^{2}+{b}^{2}} \\\\  & =\\sqrt{(0)^{2}+(-9)^{2}} \\\\  & =\\sqrt{81} \\\\  & =9.\\end{aligned}\n$$"} :step/id #uuid "c5102343-0d92-5737-bfce-0a300f842184"}] :activity/title "The Magnitude of a Complex Number" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186544077}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186555936} :activity/id #uuid "f83222ca-111d-52ca-ac32-cdf2501208e6" :activity/scope {:db/id #edb/ref 17592186049831 :topic/id #uuid "1726eb44-d776-5df6-8797-69b129ad3167" :topic/math-academy-id 34} :activity/steps [{:db/id #edb/ref 17592186555906 :step/content {:db/id #edb/ref 17592186555830 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "73992287-adf4-5d20-bc99-b1db86b5dacc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7\\sqrt{7}" :db/id #edb/ref 17592186555260} {:answer/id #uuid "7f00bf42-08f2-5516-afe2-e1a78689766e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14" :db/id #edb/ref 17592186555292} {:answer/id #uuid "ab296d37-af25-552d-b19d-d93fbfe91b3b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{7}" :db/id #edb/ref 17592186555411} {:answer/id #uuid "c7531847-0d45-560c-8932-2293b0d779c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186555479} {:answer/id #uuid "fd4f0b9c-20c0-5f4b-b54b-8d7b7392c9a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{7}" :db/id #edb/ref 17592186555631}] :answer-field/correct {:db/id #edb/ref 17592186555411} :answer-field/id #uuid "ca1efa44-0d37-5e8b-93b6-53f162d055b9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186555737}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "855d3f5e-247d-532b-b8b2-b14ad8b71bc3" :question/math-academy-id "q-160278" :question/problem "What is the magnitude of the number $z=\\sqrt{7}\\,\\text{i}?$" :question/worked-solution "The imaginary number $\\sqrt{7}\\,\\text{i}$ is equivalent to the complex number $z=0+\\sqrt{7}\\,\\text{i}.$\n\nWe know that for a complex number $z=a+b\\text{i},$ the magnitude of $z$ is given by\n\n$$\n|z|=\\sqrt{{a}^{2}+{b}^{2}}.\n$$\n\nSo, the magnitude of $z=0+\\sqrt{7}\\,\\text{i}$ is given by\n\n$$\n\\begin{aligned}|z| & =\\sqrt{{a}^{2}+{b}^{2}} \\\\  & =\\sqrt{(0)^{2}+(\\sqrt{7})^{2}} \\\\  & =\\sqrt{0+7} \\\\  & =\\sqrt{7}.\\end{aligned}\n$$"} :step/id #uuid "54b8c62c-9e30-5ba1-a31d-ce297b16c0c6" :step/next {:db/id #edb/ref 17592186555951}} {:db/id #edb/ref 17592186555936 :step/content {:db/id #edb/ref 17592186555863 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d46a9e2-7e89-5bdc-802a-37b7219e826b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2{c}^{2}-15{d}^{2}}" :db/id #edb/ref 17592186555131} {:answer/id #uuid "444fc648-9e08-5355-afa7-719ab52a2a9c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{5{c}^{2}-25{d}^{2}}" :db/id #edb/ref 17592186555146} {:answer/id #uuid "6ca319f1-0cbf-5b45-8e0e-96b1d6eac97f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{4{c}^{2}+25{d}^{2}}" :db/id #edb/ref 17592186555248} {:answer/id #uuid "8f412f49-11e0-5cb4-a1a4-380193cd889c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{{c}^{2}-{d}^{2}}" :db/id #edb/ref 17592186555336} {:answer/id #uuid "d34111e3-843d-501c-b945-9583c3a25a72" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{8{c}^{2}+10{d}^{2}}" :db/id #edb/ref 17592186555500}] :answer-field/correct {:db/id #edb/ref 17592186555248} :answer-field/id #uuid "cc6afa9a-e364-5ab4-bcd5-a1f3970571e7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186555738}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "df8c7ab8-3861-5c49-964d-3d49c4f6daab" :question/math-academy-id "q-16851" :question/problem "Find $|z|$ if $z=2c-5d\\text{i},$ where $c$ and $d$ are real numbers." :question/worked-solution "For a complex number $z=a+b\\text{i},$ the magnitude of $z$ is given by\n\n$$\n|z|=\\sqrt{{a}^{2}+{b}^{2}}.\n$$\n\nFor the complex number $z=2c-5d\\text{i},$ we have $a=2c$ and $b=-5d.$ So, the magnitude is given by\n\n$$\n\\begin{aligned}\\begin{aligned}|2c-5d\\text{i}| & =\\sqrt{(2c)^{2}+(-5d)^{2}} \\\\  & =\\sqrt{4{c}^{2}+25{d}^{2}}.\\end{aligned}\\end{aligned}\n$$"} :step/id #uuid "cc00d91b-1329-56e0-ad28-628ed46c9309" :step/next {:db/id #edb/ref 17592186555906}} {:db/id #edb/ref 17592186555951 :step/content {:db/id #edb/ref 17592186555849 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35dda891-930d-5283-82ec-3c522747ecc6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{k+4m}" :db/id #edb/ref 17592186555114} {:answer/id #uuid "3f013632-20cc-5e44-a90c-d7a4e95be4cc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{k+2m}" :db/id #edb/ref 17592186555136} {:answer/id #uuid "6dd996c1-44f7-5e17-bab6-39b9a9f028d4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{{k}^{2}+4{m}^{2}}" :db/id #edb/ref 17592186555250} {:answer/id #uuid "787da0a7-0cb6-5f2f-9aa4-3e823fbbc1d8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{{k}^{2}+2{m}^{2}}" :db/id #edb/ref 17592186555278} {:answer/id #uuid "d529f2ea-4dcf-50f9-9391-157032c832e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{-k-2m}" :db/id #edb/ref 17592186555506}] :answer-field/correct {:db/id #edb/ref 17592186555250} :answer-field/id #uuid "d995544c-fa38-5062-a61b-6bdf50c77156" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186555746}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b2ac4656-c00e-5c47-8021-7036e619bd8c" :question/math-academy-id "q-160292" :question/problem "Find $|z|$ if $z=-k-2m\\text{i},$ where $k$ and $m$ are real numbers." :question/worked-solution "For a complex number $z=a+b\\text{i},$ the magnitude of $z$ is given by\n\n$$\n|z|=\\sqrt{{a}^{2}+{b}^{2}}.\n$$\n\nFor the complex number $z=-k-2m\\text{i},$ we have $a=-k$ and $b=-2m.$ So, the magnitude is given by\n\n$$\n\\begin{aligned}\\begin{aligned}|-k-2m\\text{i}| & =\\sqrt{(-k)^{2}+(-2m)^{2}} \\\\  & =\\sqrt{{k}^{2}+4{m}^{2}}.\\end{aligned}\\end{aligned}\n$$"} :step/id #uuid "e31b65a3-7c3f-5528-960e-2ed9bc704565"}] :activity/title "The Magnitude of a Complex Number" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186555003}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186129992} :activity/id #uuid "cd58f06a-5b4f-56c5-8d9b-8947482d94cb" :activity/scope {:db/id #edb/ref 17592186050046 :topic/id #uuid "288ef1bc-9e03-59cc-957a-e1edeebef5c3" :topic/math-academy-id 2050} :activity/steps [{:db/id #edb/ref 17592186129992 :step/content {:db/id #edb/ref 17592186130362 :tutorial/content "The **end behavior of a function** refers to what the function does when the input value $x$ is very large (either positive or negative).\n\nFor example, consider the polynomial $p(x)=x^2+2x+1.$ We can understand its behavior for very large $x$ by looking at its graph. \n\n![](images/61/61c2c4cd7efd64af7474bb8854b6d18878f5f5d932103f477d3048f806f83890.png)\n\nLet's inspect the graph as $x$ becomes very large.\n\n- As $x$ becomes very large in the *positive* direction, the polynomial $p(x)$ grows very large in the positive direction as well. So, we say that \"the polynomial $p(x)$ approaches positive infinity as $x$ approaches positive infinity,\" and we write\n\n$$\np(x) \\rightarrow +\\infty \\quad \\text{as} \\quad x \\rightarrow + \\infty.\n$$\n\n- As $x$ becomes very large in the *negative* direction, the polynomial $p(x)$ again grows very large in the positive direction. So, we say that \"the polynomial $p(x)$ approaches positive infinity as $x$ approaches negative infinity,\" and we write\n\n$$\np(x) \\rightarrow +\\infty \\quad \\text{as} \\quad x \\rightarrow - \\infty.\n$$\n\nWe can confirm this by evaluating the function at large values of $x.$\n\n- For large *positive* inputs, the values of $p(x)$ get larger.\n\n$$\n\\begin{aligned} & p(100)={100}^{2}+2(100)+1=10\\,000+200+1=10\\,201 \\\\  & p(1\\,000)=1\\,{000}^{2}+2(1\\,000)+1=1\\,000\\,000+2\\,000+1=1\\,002\\,001\\end{aligned}\n$$\n\n- For large *negative* inputs, the values of $p(x)$ again get larger.\n\n$$\n\\begin{aligned} & p(-100)=(-100)^{2}+2(-100)+1=10\\,000-200+1=9\\,801 \\\\  & p(-1\\,000)=(-1\\,000)^{2}+2(-1\\,000)+1=1\\,000\\,000-2\\,000+1=998\\,001\\end{aligned}\n$$\n\nAs you can see from the above computations, it is the leading term that \"decides\" the behavior of the function at infinity. \n\nIn general, to determine the end behavior of a polynomial, all we have to do is look at the leading term. Let's see how to do this.\n\n**Note:** The \"$+$\" sign is often dropped from the notation for positive infinity. Whenever you see an infinity symbol without a sign in front of it $(\\infty),$ it means positive infinity $(+\\infty).$" :tutorial/id #uuid "52110345-2f36-5b82-bbec-fd2652974cdd" :tutorial/math-academy-id 3754 :tutorial/title "Introduction"} :step/id #uuid "c7aeb535-c560-542f-99a4-d820ea0fb077" :step/math-academy-id 21034 :step/next {:db/id #edb/ref 17592186130066}} {:db/id #edb/ref 17592186129993 :step/content {:db/id #edb/ref 17592186129142 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128958 :question/id #uuid "e6a96fc8-6ce5-5f47-8c20-709754ed7bc9" :question/math-academy-id "e-5811"} :knowledge-point/id #uuid "5dce1c69-c79d-541a-b479-8fc127352c2a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050294}] :knowledge-point/questions [{:db/id #edb/ref 17592186129672} {:db/id #edb/ref 17592186129678} {:db/id #edb/ref 17592186247239} {:db/id #edb/ref 17592186326700} {:db/id #edb/ref 17592186326701} {:db/id #edb/ref 17592186348327} {:db/id #edb/ref 17592186348328} {:db/id #edb/ref 17592186348330} {:db/id #edb/ref 17592186561002}] :knowledge-point/title "Identifying the Graph of a Polynomial"} :step/id #uuid "45634997-3461-5304-ba13-8e6c45c7966b" :step/math-academy-id 21036 :step/next {:db/id #edb/ref 17592186129996}} {:db/id #edb/ref 17592186129996 :step/content {:db/id #edb/ref 17592186130365 :tutorial/content "If you can't remember all the different cases, there's a trick you can use to determine the sign of infinity:\n\n- Substitute $+1$ and $-1$ into the leading term of your polynomial and check the sign of the result.\n\n- The sign of the result corresponds to the sign of infinity approached by the function for $x\\rightarrow +\\infty$ and $x\\rightarrow -\\infty,$ respectively.\n\nTo illustrate, consider the following polynomial:\n\n$$\nP(x) = 2x^3 -6 x^2 + 8\n$$\n\nHere, the leading term is $2x^3.$ Applying the trick, we have that\n\n- $2(+1)^3 = {\\color{blue}\\mathbf+2},$ which indicates that $P(x) \\rightarrow  {\\color{blue}\\mathbf +\\infty}$ as $x \\rightarrow +\\infty.$\n\n- $2(-1)^3 ={\\color{red}\\mathbf-2},$ which indicates that  $P(x) \\rightarrow {\\color{red}\\mathbf-\\infty}$ as $x \\rightarrow -\\infty.$" :tutorial/id #uuid "a7432afa-735c-57a7-b142-14f04ddc4606" :tutorial/math-academy-id 3758 :tutorial/title "A Mnemonic Trick for Remembering the End Behavior Rules"} :step/id #uuid "6662a6a5-d337-5f20-831c-ac489c0a2202" :step/math-academy-id 21039 :step/next {:db/id #edb/ref 17592186129997}} {:db/id #edb/ref 17592186129997 :step/content {:db/id #edb/ref 17592186129144 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128961 :question/id #uuid "7098a9a5-23ea-5496-a492-191c9c1a0690" :question/math-academy-id "e-5815"} :knowledge-point/id #uuid "ef7cf112-ab08-5e7a-855d-91bb69ec7f76" :knowledge-point/questions [{:db/id #edb/ref 17592186129669} {:db/id #edb/ref 17592186129680} {:db/id #edb/ref 17592186247241} {:db/id #edb/ref 17592186247242} {:db/id #edb/ref 17592186326703} {:db/id #edb/ref 17592186348349} {:db/id #edb/ref 17592186560985} {:db/id #edb/ref 17592186561010}] :knowledge-point/title "Identifying the Polynomial Given its Graph"} :step/id #uuid "22c9c4e6-e813-537b-b868-7519b78fd1af" :step/math-academy-id 21041 :step/next {:db/id #edb/ref 17592186130001}} {:db/id #edb/ref 17592186130001 :step/content {:db/id #edb/ref 17592186129148 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128962 :question/id #uuid "fdba6918-c9be-5a77-b79c-4a5cf39bf6e4" :question/math-academy-id "e-5817"} :knowledge-point/id #uuid "34aa8f4e-20f1-5dda-ac53-6eb411543897" :knowledge-point/questions [{:db/id #edb/ref 17592186129671} {:db/id #edb/ref 17592186129679} {:db/id #edb/ref 17592186247243} {:db/id #edb/ref 17592186326693} {:db/id #edb/ref 17592186326712} {:db/id #edb/ref 17592186402649} {:db/id #edb/ref 17592186561060}] :knowledge-point/title "Identifying True Statements Regarding the Graph of a Polynomial"} :step/id #uuid "f4fa3201-26b5-5053-8910-004a345d5b15" :step/math-academy-id 21047} {:db/id #edb/ref 17592186130066 :step/content {:db/id #edb/ref 17592186130395 :tutorial/content "In general, if we have a polynomial\n\n$$\nf(x) = a_nx^n+a_{n-1}x^{n-1}+...+a_{1}x + a_0\n$$\n\nwith leading coefficient $a_n\\neq 0,$ the end behavior of the polynomial is always\n\n$$\nf(x) \\rightarrow +\\infty \\quad \\text{or} \\quad f(x) \\rightarrow -\\infty\n$$\n\nas $x \\rightarrow \\pm \\infty.$ The sign of infinity depends on whether the leading exponent is even or odd, and on the sign of the leading coefficient. \n\n- If the leading coefficient is *positive*, then $f(x) \\to +\\infty$ as $x \\to +\\infty.$ Otherwise, if the leading coefficient is *negative*, then $f(x) \\to -\\infty$ as $x \\to +\\infty.$\n\n- If the leading exponent is *even*, then the end behavior as $x \\to +\\infty$ is the *same* as the end behavior as $x \\to -\\infty.$ Otherwise, if the leading exponent is *odd*, then the end behavior as $x \\to +\\infty$ is *opposite* the end behavior as $x \\to -\\infty.$\n\nThe different cases are summarized in the table below.\n\n<table align=\"center\" border=\"1\" cellpadding=\"10\" cellspacing=\"0\" width=\"60%\">\n<tbody><tr>\n<th align=\"center\" width=\"30%\"> $n$</th>\n<th align=\"center\" width=\"40%\"> $a_n$</th>\n<th align=\"center\" width=\"10%\"> $x  \\rightarrow -\\infty$ </th>\n<th align=\"center\" width=\"10%\"> $x  \\rightarrow +\\infty$</th>\n<th align=\"center\" width=\"10%\"> Sketch</th>\n</tr>\n<tr>\n<td rowspan=\"2\">Even </td>\n<td>  $>0$ </td>\n<td>  $f(x)  \\rightarrow +\\infty$ </td>\n<td>  $f(x)  \\rightarrow +\\infty$ </td>\n<td>\n<img alt=\"\" src=\"images/f4/f45aadee45a2a07e4cd050b4c9942118c250e73c011b7d00fff09d70a76c3319.png\"/>\n</td>\n</tr>\n<tr>\n<td>  $<0$ </td>\n<td>  $f(x)  \\rightarrow -\\infty$ </td>\n<td>  $f(x)  \\rightarrow -\\infty$ </td>\n<td>\n<img alt=\"\" src=\"images/b6/b61d6aa8182bda07e62ff6b8cc433f10a41aaaad0bde2bf4c3e8783415327b22.png\"/>\n</td>\n</tr>\n<tr>\n<td rowspan=\"2\"> Odd </td>\n<td>  $>0$ </td>\n<td>  $f(x)  \\rightarrow -\\infty$ </td>\n<td>  $f(x)  \\rightarrow +\\infty$ </td>\n<td>\n<img alt=\"\" src=\"images/06/064b94a21052ed2e20c20a69fe7649d8e0015c20c5840ad76440dbf2b7867bf5.png\"/>\n</td>\n</tr>\n<tr>\n<td>  $<0$ </td>\n<td>  $f(x)  \\rightarrow +\\infty$ </td>\n<td>  $f(x)  \\rightarrow -\\infty$ </td>\n<td>\n<img alt=\"\" src=\"images/c4/c4863580d9d7aa01a94cabb918d70203e57993bb7872a7abb186ac06760945ec.png\"/>\n</td>\n</tr>\n</tbody></table>" :tutorial/id #uuid "66b1382d-cadd-5e01-80ed-5045b894a0fa" :tutorial/math-academy-id 4227 :tutorial/title "The End Behavior of a General Polynomial"} :step/id #uuid "27a79609-0d8e-5bf3-a9a6-98d819ae4b76" :step/math-academy-id 25616 :step/next {:db/id #edb/ref 17592186129993}}] :activity/title "End Behavior of Polynomials" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186129383}]}
