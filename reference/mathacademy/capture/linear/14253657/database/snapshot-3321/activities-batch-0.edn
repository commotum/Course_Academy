fields [{:answer-field/choices [{:answer/id #uuid "3a676b7a-83f4-580e-bc68-198c1d310014" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{10{z}^{5}}+C" :db/id #edb/ref 17592186534376} {:answer/id #uuid "524c97c6-03f8-598a-8c7c-ea2d3d324912" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{12{z}^{3}}+C" :db/id #edb/ref 17592186534428} {:answer/id #uuid "763e5a13-a335-5cdf-a259-7426bf657fec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3}{{z}^{3}}+C" :db/id #edb/ref 17592186534519} {:answer/id #uuid "c1384251-11ce-53fe-90e4-87749a27be70" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{5{z}^{5}}+C" :db/id #edb/ref 17592186534696} {:answer/id #uuid "ddebe549-4054-5e6e-aaa8-0ecca6bb1cbc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{4}{3{z}^{3}}+C" :db/id #edb/ref 17592186534760}] :answer-field/correct {:db/id #edb/ref 17592186534760} :answer-field/id #uuid "986e5def-75c9-5fb2-b0cd-ce6e4f5db7e6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186534914}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8a064553-8bcb-586c-b022-5e4a307bf7cb" :question/math-academy-id "q-113732" :question/problem "Calculate $\\int \\frac{4}{{z}^{4}}\\,\\text{d}z.$" :question/worked-solution "We can just take the constant factor out of the integral, and then apply the power rule:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{4}{{z}^{4}}\\,\\text{d}z & =4\\int {z}^{-4}\\,\\text{d}z \\\\  & =4\\cdot (\\frac{{z}^{-4+1}}{-4+1})+C \\\\  & =4\\cdot (\\frac{{z}^{-3}}{-3})+C \\\\  & =-\\frac{4}{3}\\cdot {z}^{-3}+C \\\\  & =-\\frac{4}{3{z}^{3}}+C\\end{aligned}\\end{aligned}\n$$"} :step/id #uuid "06beea17-9258-5f04-8cd8-47ee4a7a192b" :step/next {:db/id #edb/ref 17592186535141}} {:db/id #edb/ref 17592186535100 :step/content {:db/id #edb/ref 17592186535088 :question/answer-fields [{:answer-field/choices [{