86045498} :answer/value "-\\frac{1}{15{x}^{5}}+C" :db/id #edb/ref 17592186534496} {:answer/id #uuid "867ff7cf-a3a9-5f4e-9f81-a86ed899e17f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{5}{3{x}^{5}}+C" :db/id #edb/ref 17592186534556} {:answer/id #uuid "86db9c05-054a-512f-9076-5d6601562ba3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{21{x}^{7}}+C" :db/id #edb/ref 17592186534557} {:answer/id #uuid "aa104223-6a26-5471-ac67-5cfc91cda9db" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{7}{3{x}^{7}}+C" :db/id #edb/ref 17592186534646} {:answer/id #uuid "ed5eb29d-e2f7-5502-9cac-86d15c20177a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{5{x}^{5}}+C" :db/id #edb/ref 17592186534792}] :answer-field/correct {:db/id #edb/ref 17592186534496} :answer-field/id #uuid "491fcc02-859b-58ab-a165-365def78f7fd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186534870}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "fe44f85b-e8b3-5b91-9050-93c115ce76be" :question/math-academy-id "q-113733" :question/problem "Calculate $\\int \\frac{1}{3{x}^{6}}\\,\\text{d}x.$" :question/worked-solution "We can just take the constant factor out of the integral, and then apply the power rule:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{3{x}^{6}}\\,\\text{d}x & =\\frac{1}{3}\\int {x}^{-6}\\,\\text{d}x \\\\  & =\\frac{1}{3}\\cdot (\\frac{{x}^{-6+1}}{-6+1})+C \\\\  & =\\frac{1}{3}\\cdot (\\frac{{x}^{-5}}{-5})+C \\\\  & =-\\frac{1}{15}\\cdot {x}^{-5}+C \\\\  & =-\\frac{1}{15{x}^{5}}+C\\end{aligned}\\end{aligned}\n$$"} :step/id #uuid "eeeddcb7-22b7-580c-afdf-9066f264a46d"}] :activity/title "The Constant Multiple Rule for Indefinite Integrals" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186534256}]}
