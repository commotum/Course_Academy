3b75d-32af-5225-9bcc-e72ef5253840" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{x}^{6}}{12}+C" :db/id #edb/ref 17592186337648} {:answer/id #uuid "ee0ea1f9-08f7-5950-8c1a-c412188e036f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{6}}{4}+C" :db/id #edb/ref 17592186338113} {:answer/id #uuid "f5d3daa8-503d-543b-91dd-745b2a60d6b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12{x}^{6}+C" :db/id #edb/ref 17592186338183}] :answer-field/correct {:answer/id #uuid "ee0ea1f9-08f7-5950-8c1a-c412188e036f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{6}}{4}+C" :db/id #edb/ref 17592186338113} :answer-field/id #uuid "a4f2b542-6f34-56ff-ab94-00255931de9b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338584}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "83815382-7a50-585c-99ac-149a3085c008" :question/math-academy-id "q-71164" :question/problem "Calculate $\\int \\frac{3}{2}{x}^{5}\\,\\text{d}x.$" :question/worked-solution "We can just take the constant factor out of the integral, and then apply the power rule:\n\n$$\n\\begin{aligned}\\int \\frac{3}{2}{x}^{5}\\,\\text{d}x & =\\frac{3}{2}\\int {x}^{5}\\,\\text{d}x \\\\  & =\\frac{3}{2}(\\frac{{x}^{5+1}}{5+1})+C \\\\  & =\\frac{3}{2}\\cdot \\frac{{x}^{6}}{6}+C \\\\  & =\\frac{{x}^{6}}{4}+C\\end{aligned}\n$$"}]}
