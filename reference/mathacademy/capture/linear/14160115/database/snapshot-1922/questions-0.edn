#{[{:db/id #edb/ref 17592186484273 :knowledge-point/_questions [{:db/id #edb/ref 17592186054775 :knowledge-point/id #uuid "aa0b0b8a-3d45-5602-a842-a1b7f50ffcea" :knowledge-point/title "Subtracting Polynomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7bb8c115-71c8-52fc-b134-d94686e4b9e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{v}^{5}-5{v}^{4}-5{v}^{3}" :db/id #edb/ref 17592186483816} {:answer/id #uuid "93e1a070-0be2-5ba6-acb7-6112439ed3d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{v}^{5}-5{v}^{4}-7" :db/id #edb/ref 17592186483872} {:answer/id #uuid "97882e12-c84e-5545-b61c-5cf076b14de5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{v}^{5}-5{v}^{3}-7" :db/id #edb/ref 17592186483878} {:answer/id #uuid "e68ebbcb-b8dd-5936-97df-68e5e5d343b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{v}^{4}-5{v}^{3}-5{v}^{2}-7" :db/id #edb/ref 17592186484022} {:answer/id #uuid "ead2d76a-2ace-5594-bd49-b9029b20e0a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{v}^{5}-5{v}^{4}-5{v}^{3}-7" :db/id #edb/ref 17592186484031}] :answer-field/correct {:answer/id #uuid "ead2d76a-2ace-5594-bd49-b9029b20e0a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{v}^{5}-5{v}^{4}-5{v}^{3}-7" :db/id #edb/ref 17592186484031} :answer-field/id #uuid "ba315b4a-2ca2-5618-87fb-ec19567b9bbd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186484174}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c4fbb5a3-d0b3-5e9d-9d9e-30b9caacb035" :question/math-academy-id "q-111161" :question/problem "Subtract $5{v}^{4}+6{v}^{3}+9$ from $2{v}^{5}+{v}^{3}+2.$" :question/worked-solution "We put a minus sign between the two polynomials, distribute it over the second polynomial, collect like terms, and then simplify:\n\n$$\n\\begin{aligned}(2{v}^{5}+{v}^{3}+2)-(5{v}^{4}+6{v}^{3}+9) & = \\\\ 2{v}^{5}+{v}^{3}+2-5{v}^{4}-6{v}^{3}-9 & = \\\\ 2{v}^{5}-5{v}^{4}+(1-6){v}^{3}+(2-9) & = \\\\ 2{v}^{5}-5{v}^{4}-5{v}^{3}-7 & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186484207 :knowledge-point/_questions [{:db/id #edb/ref 17592186054774 :knowledge-point/id #uuid "ad65c6c8-d57c-520e-9e2d-c1dc59979e19" :knowledge-point/title "Adding Polynomials Expressed as Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c2c0111b-77f9-5dd6-b35b-60f59cc17ed0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y^{4}+5y^{2}-4" :db/id #edb/ref 17592186483951}] :answer-field/correct {:answer/id #uuid "c2c0111b-77f9-5dd6-b35b-60f59cc17ed0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y^{4}+5y^{2}-4" :db/id #edb/ref 17592186483951} :answer-field/id #uuid "a8ce49c6-f3b3-587c-9376-29dad2462846" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186484166}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3049a347-62dd-59fc-b924-9cdaded3eea2" :question/math-academy-id "q-236407" :question/problem "Given that $f(y)={y}^{4}+3{y}^{2}-1$ and $g(y)=2{y}^{2}-3,$ write $f(y)+g(y)$ in **standard form**.\n\n$f(y)+g(y)=$\n{{field-1}}" :question/worked-solution "We put a plus sign between the two polynomials, collect like terms, and then simplify:\n\n$$\n\\begin{aligned}f(y)+g(y) & = \\\\ ({y}^{4}+3{y}^{2}-1)+(2{y}^{2}-3) & = \\\\ {y}^{4}+3{y}^{2}-1+2{y}^{2}-3 & = \\\\ {y}^{4}+(3+2){y}^{2}+(-1-3) & = \\\\ {y}^{4}+5{y}^{2}-4\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186484257 :knowledge-point/_questions [{:db/id #edb/ref 17592186054774 :knowledge-point/id #uuid "ad65c6c8-d57c-520e-9e2d-c1dc59979e19" :knowledge-point/title "Adding Polynomials Expressed as Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e5d516a-08ba-570d-8dc1-5319b30942d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}-2x" :db/id #edb/ref 17592186483863} {:answer/id #uuid "c5101782-6ba9-51e4-a135-77437e019f9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}+x-1" :db/id #edb/ref 17592186483956} {:answer/id #uuid "ce9eb22e-586f-5330-b915-b57b472e6c22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}-x" :db/id #edb/ref 17592186483983} {:answer/id #uuid "d4bbd9a1-0041-563d-a914-532f0f7cd1d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}+x" :db/id #edb/ref 17592186483992} {:answer/id #uuid "eb97ed63-c199-57e5-8df5-f83c4126e6c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}-2x-1" :db/id #edb/ref 17592186484032}] :answer-field/correct {:answer/id #uuid "d4bbd9a1-0041-563d-a914-532f0f7cd1d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}+x" :db/id #edb/ref 17592186483992} :answer-field/id #uuid "8a7113b0-a58d-57b5-a47a-af43596f7853" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186484152}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a1334155-0338-53af-b4b4-aaee0097bc49" :question/math-academy-id "q-52149" :question/problem "If  $f(x)={x}^{2}+2x-1$ and $g(x)={x}^{2}-x+1,$ then $f(x)+g(x)=$" :question/worked-solution "We put a plus sign between the two polynomials, collect like terms, and then simplify:\n\n$$\n\\begin{aligned}f(x)+g(x) & = \\\\ ({x}^{2}+2x-1)+({x}^{2}-x+1) & = \\\\ {x}^{2}+2x-1+{x}^{2}-x+1 & = \\\\ (1+1){x}^{2}+(2-1)x+(-1+1) & = \\\\ 2{x}^{2}+x\\end{aligned}\n$$"}]}
