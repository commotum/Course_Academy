#{[{:activity/first-step {:db/id #edb/ref 17592186055787} :activity/id #uuid "c92749c4-4aff-5706-a8e8-46b1a5867d8f" :activity/scope {:db/id #edb/ref 17592186048524 :topic/id #uuid "a6b1981e-1258-53df-8262-f14fa4fe97b1" :topic/math-academy-id 81} :activity/steps [{:db/id #edb/ref 17592186055787 :step/content {:db/id #edb/ref 17592186056067 :tutorial/content "Suppose that we have the two polynomials $6x^2 + x +1$ and $2x^2 - 3x + 6$, and we want to add them. To do that, we put a plus sign between the two, collect like terms, and then simplify:\n\n$$\n\\begin{aligned}\n(6x^{2} + x + 1) + (2x^{2} - 3x + 6) &=  \\\\\n6x^{2} + x + 1 + 2x^{2} - 3x + 6 &=  \\\\\n6x^{2} + 2x^{2}_(⏟)_(x^{2}terms) + x - 3x^(⏞)^(xterms) + 1 + 6_(⏟)_(constants) &=  \\\\\n(6 + 2)x^{2} + (1 - 3)x + 7 &=  \\\\\n&= 8x^{2} - 2x + 7\n\\end{aligned}\n$$" :tutorial/id #uuid "f6745611-70da-526a-9a6c-143b072c13c2" :tutorial/math-academy-id 8873 :tutorial/title "Introduction"} :step/id #uuid "7baea5d5-f521-54dc-aa2f-ff6e04e9e58c" :step/math-academy-id 521385 :step/next {:db/id #edb/ref 17592186055788}} {:db/id #edb/ref 17592186055788 :step/content {:db/id #edb/ref 17592186054773 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054472 :question/id #uuid "c14b3658-bbe4-53f8-a0b6-377b2586f099" :question/math-academy-id "e-14305"} :knowledge-point/id #uuid "e4a8dbbc-4d43-53de-97fa-59eb5c78d8b7" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049538}] :knowledge-point/questions [{:db/id #edb/ref 17592186054962} {:db/id #edb/ref 17592186055146} {:db/id #edb/ref 17592186055299}] :knowledge-point/title "Adding Polynomials"} :step/id #uuid "46ff7c1c-0ad5-5a99-a07f-4743ea906700" :step/math-academy-id 521386 :step/next {:db/id #edb/ref 17592186055789}} {:db/id #edb/ref 17592186055789 :step/content {:db/id #edb/ref 17592186054774 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054473 :question/id #uuid "c2e54fec-23da-515b-994b-8fa0601b5a9d" :question/math-academy-id "e-14307"} :knowledge-point/id #uuid "ad65c6c8-d57c-520e-9e2d-c1dc59979e19" :knowledge-point/questions [{:db/id #edb/ref 17592186055106} {:db/id #edb/ref 17592186055111} {:db/id #edb/ref 17592186055441}] :knowledge-point/title "Adding Polynomials Expressed as Functions"} :step/id #uuid "d2d2808c-5375-5c39-8d76-ed44abc7a434" :step/math-academy-id 521390 :step/next {:db/id #edb/ref 17592186055790}} {:db/id #edb/ref 17592186055790 :step/content {:db/id #edb/ref 17592186056068 :tutorial/content "Suppose that we want to *subtract* the polynomial $2x^2 + x$ from the polynomial $6x^2 - 3x +1$. To do that, we start by putting a minus sign between the two:\n\n$$\n(6x^2 - 3x +1) - (2x^2 + x)\n$$\n\nHere, we need to remember to distribute the minus sign. Once we've done that, we can collect like terms and then simplify as usual:\n\n$$\n\\begin{aligned}\n(6x^{2} - 3x + 1) - (2x^{2} + x) &=  \\\\\n6x^{2} - 3x + 1 - 2x^{2} - x &=  \\\\\n6x^{2} - 2x^{2} - 3x - x + 1 &=  \\\\\n(6 - 2)x^{2} + (-3 - 1)x + 1 &=  \\\\\n&= 4x^{2} - 4x + 1\n\\end{aligned}\n$$" :tutorial/id #uuid "90da9a1a-3727-51e9-ad38-7db8b7ed3e20" :tutorial/math-academy-id 8875 :tutorial/title "The Difference of Two Polynomials"} :step/id #uuid "a0375f2a-c27c-50dc-b2aa-7d86343e6e08" :step/math-academy-id 521394 :step/next {:db/id #edb/ref 17592186055791}} {:db/id #edb/ref 17592186055791 :step/content {:db/id #edb/ref 17592186054775 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054474 :question/id #uuid "4d680b83-1789-5786-92a5-313073b253c4" :question/math-academy-id "e-14310"} :knowledge-point/id #uuid "aa0b0b8a-3d45-5602-a842-a1b7f50ffcea" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049939}] :knowledge-point/questions [{:db/id #edb/ref 17592186055112} {:db/id #edb/ref 17592186055472} {:db/id #edb/ref 17592186055485} {:db/id #edb/ref 17592186459268} {:db/id #edb/ref 17592186480638}] :knowledge-point/title "Subtracting Polynomials"} :step/id #uuid "015841f6-ea30-5123-b4ff-814780c357f9" :step/math-academy-id 521395 :step/next {:db/id #edb/ref 17592186055792}} {:db/id #edb/ref 17592186055792 :step/content {:db/id #edb/ref 17592186054776 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054475 :question/id #uuid "4c4aa55e-a77c-58c5-a3f7-74a7cf57eb48" :question/math-academy-id "e-14315"} :knowledge-point/id #uuid "abd67412-213b-5019-94ca-c4fb8bb39fc1" :knowledge-point/questions [{:db/id #edb/ref 17592186054963} {:db/id #edb/ref 17592186055107} {:db/id #edb/ref 17592186055147}] :knowledge-point/title "Subtracting Polynomials Expressed as Functions"} :step/id #uuid "7c7ca7d9-ecb0-5c71-a008-51cd9a46b417" :step/math-academy-id 521399}] :activity/title "Adding and Subtracting Polynomials" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186054925}]}
