#{[{:db/id #edb/ref 17592186493966 :knowledge-point/_questions [{:db/id #edb/ref 17592186192636 :knowledge-point/id #uuid "15f03573-42ee-50d4-acdf-e2ee05d3e7e4" :knowledge-point/title "Rearranging and Solving an Absolute Value Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b21a6eb-0eb6-506f-bd93-3ef9b95b88e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=3,\\frac{7}{2}" :db/id #edb/ref 17592186493437} {:answer/id #uuid "aff73d6c-ddcc-5140-9177-17ad84cce051" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{3}{2},\\frac{7}{2}" :db/id #edb/ref 17592186493672} {:answer/id #uuid "affdc6a4-65f8-5318-8a1f-de4178ca2934" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{3}{2},\\frac{7}{2}" :db/id #edb/ref 17592186493673} {:answer/id #uuid "bb371206-32f6-5ce9-b43b-759d66c0fc02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{7}{2},\\frac{2}{3}" :db/id #edb/ref 17592186493697} {:answer/id #uuid "cd145d96-8415-53a5-bbc1-52861eca7892" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{3}{2},7" :db/id #edb/ref 17592186493720}] :answer-field/correct {:answer/id #uuid "aff73d6c-ddcc-5140-9177-17ad84cce051" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{3}{2},\\frac{7}{2}" :db/id #edb/ref 17592186493672} :answer-field/id #uuid "4c98fed7-20db-50af-9e49-c1f0c73826db" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186493820}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ddcdce51-4bc7-55a4-81e7-a74a7a6b3b12" :question/math-academy-id "q-112321" :question/problem "If $7|2x-5|+1=15,$ then $x=$" :question/worked-solution "First, we isolate the absolute value on the left side of the equation:\n\n$$\n\\begin{aligned}7|2x-5|+1 & =15 \\\\ 7|2x-5| & =14 \\\\ |2x-5| & =2\\end{aligned}\n$$\n\nNow, we have the following two cases:\n\n- If $|2x-5|=2x-5,$ we obtain:\n\n$$\n\\begin{aligned}|2x-5| & =2 \\\\ 2x-5 & =2 \\\\ 2x & =7 \\\\ x & =\\frac{7}{2}\\end{aligned}\n$$\n\n- If $|2x-5|=-(2x-5),$ we obtain:\n\n$$\n\\begin{aligned}|2x-5| & =2 \\\\ -(2x-5) & =2 \\\\ -2x+5 & =2 \\\\ -2x & =-3 \\\\ x & =\\frac{3}{2}\\end{aligned}\n$$\n\nTherefore, the solutions are $x=\\frac{3}{2}$ and $x=\\frac{7}{2}.$"}] [{:db/id #edb/ref 17592186493952 :knowledge-point/_questions [{:db/id #edb/ref 17592186192636 :knowledge-point/id #uuid "15f03573-42ee-50d4-acdf-e2ee05d3e7e4" :knowledge-point/title "Rearranging and Solving an Absolute Value Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a298de8-fcdb-50a2-a4f1-108440d7dce0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=1,4" :db/id #edb/ref 17592186493407} {:answer/id #uuid "1a8ff519-a9c2-54ab-887f-1979423b6e33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-1,4" :db/id #edb/ref 17592186493436} {:answer/id #uuid "339b4405-4f1c-5518-8af3-9771ff47c479" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No solutions exist" :db/id #edb/ref 17592186493478} {:answer/id #uuid "783c039e-76a4-5d62-ae61-0594245c1c1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-4,1" :db/id #edb/ref 17592186493573} {:answer/id #uuid "b9568ea7-ed57-5f55-98df-37b6253df3dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-4,-1" :db/id #edb/ref 17592186493695}] :answer-field/correct {:answer/id #uuid "339b4405-4f1c-5518-8af3-9771ff47c479" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No solutions exist" :db/id #edb/ref 17592186493478} :answer-field/id #uuid "a1189cdb-d12a-5c98-a111-701599799875" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186493856}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "baeaa0a7-bfc7-5111-9e74-1fdaefb89ea5" :question/math-academy-id "q-153975" :question/problem "If $3|2x-5|+13=4,$ then $x=$" :question/worked-solution "First, we isolate the absolute value on the left side of the equation:\n\n$$\n\\begin{aligned}3|2x-5|+13 & =4 \\\\ 3|2x-5| & =-9 \\\\ |2x-5| & =-3\\end{aligned}\n$$\n\nNow, notice that the right-hand side is negative. Therefore, the equation has no solutions."}] [{:db/id #edb/ref 17592186493910 :knowledge-point/_questions [{:db/id #edb/ref 17592186192635 :knowledge-point/id #uuid "94d6a2aa-4288-51dc-8944-cf9490812ad2" :knowledge-point/title "Absolute Value Equations With No Solution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a80c8ae-ff2e-5357-9292-0da8b013d1ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186493490} {:answer/id #uuid "74f22dec-1b1b-5ef1-9c84-1d364998af3d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186493564} {:answer/id #uuid "7a8b64d5-61ee-523a-aa6a-0686a98ce1a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186493577} {:answer/id #uuid "a785c005-45dd-5940-8127-a83f51ea5976" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186493655} {:answer/id #uuid "dfbb0dd3-b661-558a-85dd-839040af8d8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186493744}] :answer-field/correct {:answer/id #uuid "dfbb0dd3-b661-558a-85dd-839040af8d8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186493744} :answer-field/id #uuid "09294ff2-d9d6-52b7-9077-c43a5e430b15" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186493805}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2e7c0ce7-7ffd-571f-9543-de7ea37af680" :question/math-academy-id "q-154664" :question/problem "Which of the following equations has *no* solution?\n\nI. $|5z+1|=5$\n\nII. $|5z+1|-3=-1$\n\nIII. $|5z+1|=-6$" :question/worked-solution "An absolute value equation has no solution if, when the absolute value is isolated on the left side, the right-hand side is negative.\n\nWith that in mind, let's look at each equation in turn:\n\n- Equation I has a solution. The absolute value is already isolated on the left-hand side, and the right-hand side is non-negative.\n\n- Equation II has a solution. To see this, we first isolate the absolute value on the left-hand side as follows:\n\n$$\n\\begin{aligned}|5z+1|-3 & =-1 \\\\ |5z+1| & =2\\end{aligned}\n$$\n\nSince the right-hand side is non-negative, this equation has a solution.\n\n- Equation III *has no solution*. The absolute value is already isolated on the left-hand side, and the right-hand side is *negative*.\n\nTherefore, the answer is \"III only.\""}]}
