#{[{:db/id #edb/ref 17592186111207 :knowledge-point/_questions [{:db/id #edb/ref 17592186110625 :knowledge-point/id #uuid "affac6f0-da94-5545-a49c-e1e306bcd918" :knowledge-point/title "Creating an Exponential Growth Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "75587b10-3e3b-50f3-878a-02e1543f20c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\cdot 4\\,{000}^{3}" :db/id #edb/ref 17592186555265} {:answer/id #uuid "859e2913-17e3-525b-9278-80be19f14031" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2\\cdot 4\\,000)^{3}" :db/id #edb/ref 17592186555308} {:answer/id #uuid "932a8a67-07d6-529f-b6fb-4e505a7bfc06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\cdot 3\\cdot 4\\,000" :db/id #edb/ref 17592186555347} {:answer/id #uuid "a9d71347-d0ac-57df-822a-564d3f81155f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{2}^{4}\\cdot 4\\,000" :db/id #edb/ref 17592186555405} {:answer/id #uuid "d007a8b5-2170-5d21-b10b-72e88b23f82b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,000\\cdot {2}^{3}" :db/id #edb/ref 17592186555495}] :answer-field/correct {:answer/id #uuid "d007a8b5-2170-5d21-b10b-72e88b23f82b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,000\\cdot {2}^{3}" :db/id #edb/ref 17592186555495} :answer-field/id #uuid "aec95bc2-644d-5263-b4f2-458972c3d8ca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186108967}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e84b8561-bf3c-52d8-8533-88bb8eb9ad86" :question/math-academy-id "q-45632" :question/problem "At the beginning of a study, a beehive had $4\\,000$ bees. The study showed that the number of bees in the hive doubles every week. How many bees will be in the hive after $3$ weeks?" :question/worked-solution "The hive starts with $4,000$ and then doubles every week. \n\nTherefore, we have:\n\n- After $1$ week, there are $4\\,000\\cdot 2$ bees.\n\n- After $2$ weeks, there are $4\\,000\\cdot {2}^{2}$ bees.\n\n- After $3$ weeks, there are $4\\,000\\cdot {2}^{3}$ bees.\n\nSo the correct expression for the number of bees after $3$ weeks is $4\\,000\\cdot {2}^{3}.$"}] [{:db/id #edb/ref 17592186555868 :knowledge-point/_questions [{:db/id #edb/ref 17592186110626 :knowledge-point/id #uuid "dcd3e634-d64c-57dc-9d4c-8f7f67c731ab" :knowledge-point/title "Creating an Exponential Growth Expression Using Percentage Growth"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25bfa7fe-6bbc-5bba-8456-d285f71fb72d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$13\\,430$" :db/id #edb/ref 17592186555077} {:answer/id #uuid "3aec392f-ba73-525c-8b12-dfcceda07e38" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$15\\,660$" :db/id #edb/ref 17592186555127} {:answer/id #uuid "4a58dba6-5ed5-5633-95b8-7e88afe39c63" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$14\\,050$" :db/id #edb/ref 17592186555161} {:answer/id #uuid "bd58d7b9-4b69-5345-98e8-c2b4988aeceb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$15\\,970$" :db/id #edb/ref 17592186555450} {:answer/id #uuid "ce20cd5b-5a77-5b24-a7f2-4481ecd81f4c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$14\\,830$" :db/id #edb/ref 17592186555492}] :answer-field/correct {:answer/id #uuid "4a58dba6-5ed5-5633-95b8-7e88afe39c63" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$14\\,050$" :db/id #edb/ref 17592186555161} :answer-field/id #uuid "04d9141d-29ea-5c02-a238-48a843d162a1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555641}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ebeb4e55-43ec-53a6-b8e8-b7cfc99f6520" :question/math-academy-id "q-61650" :question/problem "Rose's initial salary was $$10\\,000$, and her salary increased by $12%$ per year. To the nearest $$10$, what was Rose's salary $3$ years later?" :question/worked-solution "Rose received $$10\\,000$ initially, and this amount increased by $12%$ each year.\n\n$12%$ as a decimal is $0.12.$ Therefore, an increase of $12%$ corresponds to multiplication by a factor of\n\n$$\n1+0.12=1.12.\n$$\n\nTherefore, we have:\n\n- After $1$ year, Rose received $10\\,000\\cdot (1.12)$ dollars.\n\n- After $2$ years, Rose received $10\\,000\\cdot (1.12)^{2}$ dollars.\n\n- After $3$ years, Rose received $10\\,000\\cdot (1.12)^{3}$ dollars.\n\nEvaluating the expression for the amount of money received after $3$ years, we get\n\n$$\n10\\,000\\cdot (1.12)^{3}≈14\\,050.\n$$\n\nAfter $3$ years, Rose received approximately $14\\,050$ dollars."}] [{:db/id #edb/ref 17592186555825 :knowledge-point/_questions [{:db/id #edb/ref 17592186110625 :knowledge-point/id #uuid "affac6f0-da94-5545-a49c-e1e306bcd918" :knowledge-point/title "Creating an Exponential Growth Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09ac0039-4090-5467-a2a3-64bb72608f51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40\\cdot {4}^{2}" :db/id #edb/ref 17592186555018} {:answer/id #uuid "0a3652a9-19a0-57cd-8ad1-d828e5b3ffad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(40\\cdot 4)^{2}" :db/id #edb/ref 17592186555019} {:answer/id #uuid "3342e9e2-c937-5e04-bfee-4d4d83519f3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40\\cdot 2\\cdot 4" :db/id #edb/ref 17592186555108} {:answer/id #uuid "4dde1711-99e2-58fb-89e6-decf4b78c670" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40\\cdot {2}^{4}" :db/id #edb/ref 17592186555175} {:answer/id #uuid "c387e36d-a0c7-5230-a0e8-64529a3cc938" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(40\\cdot 2)^{4}" :db/id #edb/ref 17592186555474}] :answer-field/correct {:answer/id #uuid "4dde1711-99e2-58fb-89e6-decf4b78c670" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40\\cdot {2}^{4}" :db/id #edb/ref 17592186555175} :answer-field/id #uuid "0c4f58b6-58c2-5e54-bc66-efc59367c283" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555643}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7c172a4f-97f6-5647-a1db-039307497883" :question/math-academy-id "q-61834" :question/problem "One month, a greengrocer sold $40$ kilograms of watermelon. If the number of kilograms of sold watermelon doubles each month, how many kilograms of watermelon will the greengrocer sell after $4$ months?" :question/worked-solution "In a particular month, the greengrocer sold $40$ kilograms of watermelon, and then this amount doubles every month.\n\nTherefore, we have:\n\n- After $1$ month, the greengrocer will sell $40\\cdot 2$ kilograms of watermelon.\n\n- After $2$ months, the greengrocer will sell $40\\cdot {2}^{2}$ kilograms of watermelon.\n\n- After $3$ months, the greengrocer will sell $40\\cdot {2}^{3}$ kilograms of watermelon.\n\n- After $4$ months, the greengrocer will sell $40\\cdot {2}^{4}$ kilograms of watermelon.\n\nSo the correct expression is $40\\cdot {2}^{4}.$"}]}
