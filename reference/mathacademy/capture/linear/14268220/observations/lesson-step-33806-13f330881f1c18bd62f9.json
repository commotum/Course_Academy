  "html": "<div id=\"step-33806\" class=\"step\" style=\"display: block\" stepid=\"33806\" steptype=\"example\" contentid=\"9060\">\n            <div class=\"stepHeader\">\n                <div class=\"stepName\">\n                    Example: \n                    <a id=\"stepAnchor-33806\" class=\"stepAnchor\" style=\"font-weight: normal;\" name=\"step-2\">Visually Identifying Convex Polyhedra</a> \n                </div>      \n                <div class=\"helpButton\" stepid=\"33806\">?</div>\n            </div>\n            \n            <div class=\"exampleQuestion\">\n                <p>Which of the polyhedra below are convex?</p>\n<div id=\"graphic-b1c9a4f79a35e4bdba743daaaebfacd9\" class=\"graphic\"><img src=\"/graphics/b1c9a4f79a35e4bdba743daaaebfacd9\"></div>\n            </div>     \n\n            <div class=\"explanationHeader\">EXPLANATION</div>\n\n            <div class=\"exampleExplanation\">\n                <style type=\"text/css\">\n                            .mjpage .MJX-monospace {\n                            font-family: monospace\n                            }\n\n                            .mjpage .MJX-sans-serif {\n                            font-family: sans-serif\n                            }\n\n                            .mjpage {\n                            display: inline;\n                            font-style: normal;\n                            font-weight: normal;\n                            line-height: normal;\n                            font-size: 100%;\n                            font-size-adjust: none;\n                            text-indent: 0;\n                            text-align: left;\n                            text-transform: none;\n                            letter-spacing: normal;\n                            word-spacing: normal;\n                            word-wrap: normal;\n                            white-space: nowrap;\n                            float: none;\n                            direct