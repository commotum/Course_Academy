#{[{:activity/first-step {:db/id #edb/ref 17592186153254} :activity/id #uuid "a59e2561-e0dc-5240-8024-effab456d18a" :activity/scope {:db/id #edb/ref 17592186049141 :topic/id #uuid "de04f42d-8248-5b77-8683-487f694fba77" :topic/math-academy-id 2554} :activity/steps [{:db/id #edb/ref 17592186153254 :step/content {:db/id #edb/ref 17592186153437 :tutorial/content "Recall that two variables, $x$ and $y$, are said to have a proportional relationship if their ratio is constant. The constant of proportionality $k$ is given by\n\n$$\nk = \\dfrac{y}{x}\n$$\n\nWe can rearrange the equation above as follows:\n\n$$\ny = kx\n$$\n\nThe following statements are all equivalent:\n\n- $y = kx$\n- $y$ **varies directly** with $x$\n- $y$ is **directly proportional** to $x$\n- $y \\propto x$\n\nProportional relationships frequently occur in real-world problems. Let's see an example." :tutorial/id #uuid "cd20b689-18a3-54cb-97a9-7fa52d610ec1" :tutorial/math-academy-id 8191 :tutorial/title "Introduction"} :step/id #uuid "d67d1aae-88f2-5c83-9e8b-9cb74a319475" :step/math-academy-id 54183 :step/next {:db/id #edb/ref 17592186153255}} {:db/id #edb/ref 17592186153255 :step/content {:db/id #edb/ref 17592186152270 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151824 :question/id #uuid "e85107d6-ecdf-526d-a7ce-091d028039eb" :question/math-academy-id "e-13098"} :knowledge-point/id #uuid "8d510b2f-df38-5fbe-a420-4ea79135488c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049405}] :knowledge-point/questions [{:db/id #edb/ref 17592186152664} {:db/id #edb/ref 17592186152665}] :knowledge-point/title "Computing a Constant of Proportionality"} :step/id #uuid "2b45a9cd-8289-51d2-8e4f-c06b2b089b8c" :step/math-academy-id 54184 :step/next {:db/id #edb/ref 17592186153256}} {:db/id #edb/ref 17592186153256 :step/content {:db/id #edb/ref 17592186152271 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151825 :question/id #uuid "15f20ecd-503f-5748-b004-680b5fc127c1" :question/math-academy-id "e-13099"} :knowledge-point/id #uuid "2a9d0449-2b61-5979-bd5c-94c33c8899c2" :knowledge-point/questions [{:db/id #edb/ref 17592186152607} {:db/id #edb/ref 17592186152666}] :knowledge-point/title "Identifying the Equation of a Proportional Relationship"} :step/id #uuid "db6fedfb-85d0-5eb6-a2b9-f9df621ac942" :step/math-academy-id 54187 :step/next {:db/id #edb/ref 17592186153257}} {:db/id #edb/ref 17592186153257 :step/content {:db/id #edb/ref 17592186152272 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151826 :question/id #uuid "6b17572d-a8f7-523f-9697-ae16f3d84398" :question/math-academy-id "e-13100"} :knowledge-point/id #uuid "3f29a835-91e3-51e3-a016-e13d296b7654" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050613}] :knowledge-point/questions [{:db/id #edb/ref 17592186152608} {:db/id #edb/ref 17592186152667}] :knowledge-point/title "Solving for an Unknown Amount"} :step/id #uuid "8a87b9ba-c67e-5da1-b438-76dadef85d15" :step/math-academy-id 54190}] :activity/title "Understanding Proportional Relationships From Descriptions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186152312}]}
